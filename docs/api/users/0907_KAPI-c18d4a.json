c21/uploads/origins/a00e2652-cd8f-4922-8541-a86f5390cbc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7574347710b1baca03c4726a3680b79a 2x, https://si.imgix.net/92b89c21/uploads/origins/a00e2652-cd8f-4922-8541-a86f5390cbc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b4304bc38e29c4e5e0c30764c7e2c89 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@0907_KAPI/works/42", "thumbnail_src": "https://si.imgix.net/418bf1cf/uploads/origins/9ac2196b-15aa-4eea-bb6a-711bf4bf3b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dce148f9b4771a8eecc29727663e754", "thumbnail_srcset": "https://si.imgix.net/418bf1cf/uploads/origins/9ac2196b-15aa-4eea-bb6a-711bf4bf3b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dce148f9b4771a8eecc29727663e754, https://si.imgix.net/418bf1cf/uploads/origins/9ac2196b-15aa-4eea-bb6a-711bf4bf3b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1949ca55ba2a9e3279372f4005eef13 2x, https://si.imgix.net/418bf1cf/uploads/origins/9ac2196b-15aa-4eea-bb6a-711bf4bf3b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd4e7f8f30331fe76284c0315b93874c 3x", "genre": "art", "nsfw": false, "body": "僕のチャリザードが大きなクマのポケモンに挑まれているアートピースが欲しい。ウサリングとか、パンゴロとか、ベアティックとか。よくわからないけど、どれが一番好き？\n\n最終的には、僕のチャリダーがクマと一緒に腹いっぱいに寝そべるようにする。また、腹の口は自由に開いたり閉じたりできる。とても愛らしい。\n\nhttps://drive.google.com/file/d/1hyH_hI8XaVIJThd8kNDvauJ3s8cudk8c/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@0907_KAPI/works/41", "thumbnail_src": "https://si.imgix.net/01d4c8f5/uploads/origins/00fd93b6-5277-4f51-b811-21b38fe5631d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=