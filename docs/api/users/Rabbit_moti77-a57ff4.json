%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b94f2323ebd8a9eba76143e47e3382f 2x, https://si.imgix.net/6b359bd4/uploads/origins/52d321a2-fbef-4400-b2cc-248879e31027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0b337e2ac9a7e174a71e5fb34c05e66 3x", "genre": "art", "nsfw": false, "body": "はじめましてユーリと申します\n海砂餅様のイラストに一目惚れしましたのでぜひうちの子を描いていただけたら嬉しいなと思いリクエストさせていただきました\n廃墟で佇むうちの子を描いていただきたいと思います\n構図や表情は自由にしていただいて大丈夫です\n 資料は↓をご確認ください。\n設定\nhttps://x.com/yu_ri0128vvv/status/1697985648698028194?s=46&t=NkZAxdOeh3_B9ge7m4aIVw\n イメージ\nhttps://x.com/za7_ge7/status/1690110007935995905?s=46&t=NkZAxdOeh3_B9ge7m4aIVw\nご検討よろしくお願いします\n\nhttps://x.com/yu_ri0128vvv/status/1697985648698028194?s=46&t=NkZAxdOeh3_B9ge7m4aIVw", "created_at": "", "completed_at": ""}, {"path": "/@Rabbit_moti77/works/29", "thumbnail_src": "https://si.imgix.net/32854ecd/uploads/origins/31b90db6-4818-4b9a-b05c-11d0b36767ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dec71387c0a62ec35a70e2a4870b86f", "thumbnail_srcset": "https://si.imgix.net/32854ecd/uploads/origins/31b90db6-4818-4b9a-b05c-11d0b36767ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dec71387c0a62ec35a70e2a4870b86f, https://si.imgix.net/32854ecd/uploads/origins/31b90db6-4818-4b9a-b05c-11d0b36767ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=545f589297ddccc545e62585d00cd644 2x, https://si.imgix.net/32854ecd/uploads/origins/31b90db6-4818-4b9a-b05c-11d0b36767ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b2fb6c5dcebcbb27481657206dd9e87 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのイラストは本当に美しいです。VTuberのストリームで使う16:9の比率の背景をぜひ描いていただきたいです。 特に、この描いていただいた作品の雰囲気が好きです: https://skeb.jp/@Rabbit_moti77/works/21\n\n彼女は星から生まれた夢と悪夢を体現する孤独で不死身な存在です。彼女の仕事は、人々に甘い夢を与えたり、悪夢に悩ませたりすることです。 性格はクールで落ち着いていて、真面目で面倒見の良いお姉さんタイプです。\n\nだから、私の名前がDreamlike-Melodyであることから、音楽をテーマにした宇宙的・夢幻的な美学があるのです。そんな雰囲気のある部屋背景を期待していました。\nこれは私が手に入れた部屋のイラストで、白・青・紫・黒のような配色でこのようなものがあればいいなと思いました。そして、それに似たようなものを期待していたのですが、拡大しました:\nhttps://skeb.jp/@ito_44_3/works/34\n\nちょっとした窓際のヌックエリアも、こんなのがあったらいいなと思っていました:\nhttps://skeb.jp/@go_e_0000/works/7\nhttps://skeb.jp/@ito_44_3/works/15\n\nこれらの画像をインスピレーションとしてお使いください。私は特に最初の画像が大好きです: https://imgur.com/a/XxljC9v\n\n実際の部屋では、全体と窓際のヌークエリアの側面に本棚が欲しいと思っていました。部屋全体に光るフローティングランタンか、天井から吊るすか、どちらかを希望しています。私の部屋のSkebのイラストでは、コーヒーとオルゴールが置いてあるテーブルがあります。 そのテーブルの台座が星屑の入った砂時計になっているのですが、それもぜひ取り入れてほしいですね。\n\n現在、この部屋を背景として使っていますが、音符が流れているので、ピアノかオルゴールから流れてくる音を再現してほしいです: https://twitter.com/DreamlikeMelody/status/1362812275740925953?s=20&t=H4P_4IVD1Nklvlo9Azqtqg\n\nお忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/13EmdRIDS-LlTcirYss_KcnCDqCv07lpy?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Rabbit_moti77/works/28", "thumbnail_src": "https://si.imgix.net/84cc5113/uploads/origins/5534ce07-dfd6-4b6a-9be0-d761ea95bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b3f7a6f09f83030219d0eaae5a6a8f", "thumbnail_srcset": "https://si.imgix.net/84cc5113/uploads/origins/5534ce07-dfd6-4b6a-9be0-d761ea95bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b3f7a6f09f83030219d0eaae5a6a8f, https://si.imgix.net/84cc5113/uploads/origins/5534ce07-dfd6-4b6a-9be0-d761ea95bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=743d038d0f72ba3d3c2370e57d7a5c84 2x, https://si.imgix.net/84cc5113/uploads/origins/5534ce07-dfd6-4b6a-9be0-d761ea95bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fad7473762abbf77658bdf2416b68f6 3x", "genre": "art", "nsfw": false, "body": "안녕하세요.제가 일본어를 정말 기초적인 어휘만 사용할 줄 알고 번역기를 사용하는 점은 양해 부탁드립니다.\n그림이 너무 마음에 들어서 신청해봅니다.\n\n배경은 파란 빛이 아니라 빨간 빛으로 해 주세요.\n캐릭터는 가운데부터 구도사진 자세로 (09사진에서 왼쪽이 조금 앞으로 나온 느낌에요) 부탁드립니다.\n오른쪽 눈에 빨간색 안광이 비치면 좋겠네요.(11번 사진입니다.)\n안대와 귀는 표현을 하지 않아도 니다!\n\n05 - 2는 배경 자료 사진입니다.\n각 숫자의 위치(빨간 원)대로,\n01의 창가 배경은 붉은 빛의 번개가 치면서 보이길 바랍니다.\n02의 왼쪽 아래는 02 캐릭터 사진에서의 찢어진 모자만,\n03의 왼쪽 나무 옆에는 03 캐릭터 도트의 사진에서 금이 간이 모자만,\n04의 계단 중앙 오른쪽에는 04의 캐릭터의 찢어진 한쪽 날개를 그려 주십시오.\n\n잘 부탁드립니다.\n돈 잘 못 보내서 취소하고 다시 보내는 점 양해 부탁드려요.\n수신인 명을 그림의 구석(상하좌우 상관 없어요!)에 적어주시면 감사하겠습니다!", "created_at": "", "completed_at": ""}, {"path": "/@Rabbit_moti77/works/27", "thumbnail_src": "https://si.imgix.net/9063c690/uploads/origins/8e356d08-181e-485b-99e1-491eb1e32257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3963ca272b4dc10a3f865ab7d02767b7", "thumbnail_srcset": "https://si.imgix.net/9063c690/uploads/origins/8e356d08-181e-485b-99e1-491eb1e32257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3963ca272b4dc10a3f865ab7d02767b7, https://si.imgix.net/9063c690/uploads/origins/8e356d08-181e-485b-99e1-491eb1e32257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce2bb99945490714c5154d086d7778a4 2x, https://si.imgix.net/9063c690/uploads/origins/8e356d08-181e-485b-99e1-491eb1e32257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d3ffccc60b47c11239500f8d306ace 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今回は、Vtuberのキャラクターのストリーミング背景として使用するための背景画を依頼します。私のVtuberキャラクターのストリーミング用の背景アートワークを依頼したいと思います。\n山の中にある温泉のような、リラックスした雰囲気の部屋にしたいと思っています。宜しくお願い致します。\n\nhttps://pbs.twimg.com/media/E47JcS1WUAA8EWL?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@Rabbit_moti77/works/26", "thumbnail_src": "https://si.imgix.net/1ef8bfc3/uploads/origins/a3497876-66ee-436c-a91a-de94f5480d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ec9cc22843781af75322ae5ebf45b6", "thumbnail_srcset": "https://si.imgix.net/1ef8bfc3/uploads/origins/a3497876-66ee-436c-a91a-de94f5480d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ec9cc22843781af75322ae5ebf45b6, https://si.imgix.net/1ef8bfc3/uploads/origins/a3497876-66ee-436c-a91a-de94f5480d86?bg=%23fff&auto=format%2Ccomp