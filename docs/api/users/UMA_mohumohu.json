f-aa41-32554c2c8fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c61174f65fda7273b3363eb80ee5d8e, https://si.imgix.net/e497a3f1/uploads/origins/22c3b926-7e17-46bf-aa41-32554c2c8fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e54ba1f1d6738a3694c909c3d9fdfa15 2x, https://si.imgix.net/e497a3f1/uploads/origins/22c3b926-7e17-46bf-aa41-32554c2c8fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b9c5095dddbce45638ab8cc828cec01 3x", "genre": "art", "nsfw": false, "body": "お初にお目にかかります。\n\nUMAさんのイラストを毎回拝見させていただいており、\nいろんなケモミミっ子、どれも素晴らしいと感じました。\n\n推しキャラのバニー衣装が見たいのでリクエストさせていただきます。\n\n【キャラ】\nモン娘は～れむというソシャゲのヴェロニカさん\nモチーフはケルベロスです。\n容姿は参考画像をご確認ください。\n\n【衣装】\nバニー衣装（黒）\nタイツは網ではなくストッキング系\n\n【構図】\n座り込んだ格好でちょっと胸と太ももが強調されてる感じでお願いします。\n表情はちょっと恥ずかしがっている表情で、ハート目もあると嬉しいです。\n\nケルベロスのため、髪の毛の終端が２頭の犬の顔になっており、特殊な容姿になっております。\nそのまま参考にしていただいてもいいですし、犬の顔はなく普通のロングヘアーとなっていても問題ありません。お任せいたします。\n\nお忙しい中恐縮ですが、ご検討お願いいたします。\n\nhttps://imgur.com/a/KwhccOj", "created_at": "", "completed_at": ""}, {"path": "/@UMA_mohumohu/works/63", "thumbnail_src": "https://si.imgix.net/8566033b/uploads/origins/060fe023-4971-436f-8f3d-10bd77ed7690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e33bdd828ec78792c0623571008ed07b", "thumbnail_srcset": "https://si.imgix.net/8566033b/uploads/origins/060fe023-4971-436f-8f3d-10bd77ed7690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e33bdd828ec78792c0623571008ed07b, https://si.imgix.net/8566033b/uploads/origins/060fe023-4971-436f-8f3d-10bd77ed7690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08312af380f490989017b7ee113f3af9 2x, https://si.imgix.net/8566033b/uploads/origins/060fe023-4971-436f-8f3d-10bd77ed7690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6087d23988684a78bd219f97781bbca1 3x", "genre": "art", "nsfw": false, "body": "お世話になります。受諾頂ければ幸いです。\n以下仕様になります。（女の子は先生が書ける限界までかわいく）\n\nとある女子高の化学研究室。あなたはそこでシステムの管理者（JKなのに…）をしています。椅子に座ってにっこり微笑んでいます。\nキャラ設定は\n…都内某有名女子高に通学（理系）\n・制服はミッション系のどでかい蝶々リボン（淡いピンクで縛り方はかなりゆるい）先生の独創的な制服を期待します。\n・髪型はツインテール＋りぼん（金髪）\n・丸めがね必須（強調して）\n・実験白衣を着ている(前は全開)小物もあれば嬉しいです。(胸にボールペンなど)\n…ネームブレート着用（学生証・写真付き）\n・手首にはシュシュ、腰にはカーディガンが結んである。\n・スカートもビンクのチェックの入った柄。かわいいスカート希望。長さは短め。足は組んでいる。\nニーハイ＋ガーターベルト(かわいいとセクシーさを両立)目立つように。太ももの所に細かい装飾。\n・ローファー着用（普通のチョコみたいな色）\n・出来ればOCちゃんのモブキャラも左側にお願いします。\n…あとは先生にお任せします。\n\n【重要項目】（これだけはお願いしたいこと）\n・画面サイズは横3840✕縦2160ピクセル波(4K並）」（特定の使用用途のため）画面比率は16対9厳守\n・保存形式はpsd（レイヤー未結合）、jpg、女の子だけ分離したpngでお願いします。\n最後までお読み頂きまして、貴重な時間を頂戴しました。感謝です。ご検討を宜しくお願いします。失礼します。", "created_at": "", "completed_at": ""}, {"path": "/@UMA_mohumohu/works/62", "thumbnail_src": "https://si.imgix.net/c73b1eb0/uploads/origins/c6e1bfa2-cee2-4ec7-b782-af14e6704f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60d4e195308e5db4c555615741bd27ab", "thumbnail_srcset": "https://si.imgix.net/c73b1eb0/uploads/origins/c6e1bfa2-cee2-4ec7-b782-af14e6704f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60d4e195308e5db4c555615741bd27ab, https://si.imgix.net/c73b1eb0/uploads/origins/c6e1bfa2-cee2-4ec7-b782-af14e6704f21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0966e069109b3c2305b8c4fa74d22cee 2x, https://si.imgix.net/c73b1eb0/uploads/origins/c6e1bfa2-cee2-4ec7-b782-af14e6704f21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1df26c1d1006e786cf0871046e3ccd88 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見させてもらってます。ナインボール副隊長です。前回は素敵なイラストありがとうございました！\nまた篝ちゃんを描いて貰えるでしょうか？\nよくUMAさんのイラストでバニースーツを見かけるので、篝ちゃんにバニースーツを着せて、胸は大きく、バニースーツは暖色系で光沢感とハイレグが映えるものとスジが浮かんでいるものでお願いします！\nポーズはお任せしますが、上にある通りのものが強調されたり見えるポーズだと嬉しいです！\nタイツやソックス、付け耳の有無はお任せします！\nよろしくお願いします！\n\n↓資料\nhttps://drive.google.com/drive/folders/1GH5MB8scWSPidyuPqppdddXZHSmLF5JP", "created_at": "", "completed_at": ""}, {"path": "/@UMA_mohumohu/works/61", "thumbnail_src": "https://si.