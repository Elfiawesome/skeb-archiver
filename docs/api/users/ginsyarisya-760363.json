%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dadbfc3a6d00ec8c02e49d510831681, https://si.imgix.net/0170959b/uploads/origins/f2b8b28f-b7c1-407a-b648-cfec5c09b197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=612ae37666acddcd12e5c558ef65c471 2x, https://si.imgix.net/0170959b/uploads/origins/f2b8b28f-b7c1-407a-b648-cfec5c09b197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90aa2f873f2602d614fa6e9efe8a0e33 3x", "genre": "art", "nsfw": false, "body": "ginsyari先生、こんにちは！以前も素晴らしい仕事をしていただいたのですが、またまたお願いがあります。私のOCであるセレスティーヌにお願いしたいことがあります。彼女は火と水を操ることができる天才的な医者であり、衛生兵です。彼女はとても利他的で、困っている人がいれば迷わず助ける。彼女は自分の手で火と水を作り出すことができ、その2つの元素を使って新しい元素を作り出し、治癒にあたる。\n\n理想としては、セレスティーヌが片手に火と水を持ち、何らかの方法で遊んでいるようなイラストにしたいです。ポーズや表情、背景など、具体的な内容はお任せします。\n\n使用方法については、今後の依頼の参考とさせていただきます。\n\nお忙しい中、ありがとうございました！\n\nhttps://imgur.com/a/7KGq8fe", "created_at": "", "completed_at": ""}, {"path": "/@ginsyarisya/works/16", "thumbnail_src": "https://si.imgix.net/ad2a27e2/uploads/origins/9cea1979-6db9-4396-8151-3b3694c56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ce734a585cc79f8800d57aa47648fdc", "thumbnail_srcset": "https://si.imgix.net/ad2a27e2/uploads/origins/9cea1979-6db9-4396-8151-3b3694c56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ce734a585cc79f8800d57aa47648fdc, https://si.imgix.net/ad2a27e2/uploads/origins/9cea1979-6db9-4396-8151-3b3694c56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc2dc23fa4b50e7fb84f827b8004f6e9 2x, https://si.imgix.net/ad2a27e2/uploads/origins/9cea1979-6db9-4396-8151-3b3694c56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08e7603385351f2f2a63c0bce455e854 3x", "genre": "art", "nsfw": false, "body": "はじめまして、以前からイラスト拝見しておりました。\nあざやかな色使いがとても素敵だと思い今回依頼させていただきます。\nFF14の自キャラで、明るく快活な性格です。手袋を直しているようなポーズで、かわいい感じの表情でお願いしたいです。\n脚は気持ち太めで描いてもらえると助かります。よろしくお願いします。\n\nhttps://twitter.com/i_takanami/status/1662233972833677313?s=12&t=lFDTG2sXMBEjqxD2xSp_GA", "created_at": "", "completed_at": ""}, {"path": "/@ginsyarisya/works/15", "thumbnail_src": "https://si.imgix.net/be7bbe41/uploads/origins/69845e55-2576-4697-a68b-09eee1a9b2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=055a3dbd376a505d8d41a79eb9187afc", "thumbnail_srcset": "https://si.imgix.net/be7bbe41/uploads/origins/69845e55-2576-4697-a68b-09eee1a9b2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=055a3dbd376a505d8d41a79eb9187afc, https://si.imgix.net/be7bbe41/uploads/origins/69845e55-2576-4697-a68b-09eee1a9b2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52dc68dfa646ecff9efd8f2397d7fcb7 2x, https://si.imgix.net/be7bbe41/uploads/origins/69845e55-2576-4697-a68b-09eee1a9b2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dacbb91a780fec75a44930bd595f8381 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お元気でしょうか。\n私の狐の女の子のキャラクターを描いてほしいです。彼女はミュージシャンなので、このようにギターを弾きながら座っているようなポジションで描いてください（https://sta.sh/0kj1qbe3279）。平和な森の中で、彼女の周りに小動物や花が咲いているようなシーンを希望します。\n彼女の服の赤い斑点は花です。袖の緑の蔦のデザインも入れてください（https://sta.sh/0au0ts3smx、青で囲んだ部分）。彼女は穏やかで静かな性格なので、大きな笑顔ではなく、小さな笑顔でお願いします。\nありがとうございました。\n\nhttps://sta.sh/01nzrfuqnajb", "created_at": "", "completed_at": ""}, {"path": "/@ginsyarisya/works/14", "thumbnail_src": "https://si.imgix.net/3a08486a/uploads/origins/964bc394-b479-4d1c-9d12-9b437ac934cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1959fbf54131aea25065580db9fd42d", "thumbnail_srcset": "https://si.imgix.net/3a08486a/uploads/origins/964bc394-b479-4d1c-9d12-9b437ac934cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1959fbf54131aea25065580db9fd42d, https://si.imgix.net/3a08486a/uploads/origins/964bc394-b479-4d1c-9d12-9b437ac934cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d8092b392ef7bfa6998c34e1fb711bd 2x, https://si.imgix.net/3a08486a/uploads/origins/964bc394-b479-4d1c-9d12-9b437ac934cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ff5089d78accd54a13e0e2ac1e888cf 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！私はあなたが私のキャラクターを描いた絵が大好きなので、あなたが私のキャラクターの別のものを描いてくれることを期待していました。🙇‍♀️\n\nお姉さんタイプ。223cmの長身で筋肉質だが、知性と優しさを武器にしている。目には傷跡があり、目が見えない。とても優雅な性格の持ち主です。参考までに、彼女の服装の画像を添付しておきます。\n\nhttps://drive.google.com/drive/u/0/folders/1QhA0c_QSmXwHaGKKDV018Gn3KlaLZfwx", "created_at": "", "completed_at": ""}, {"path": "/@ginsyarisya/works/13", "thumbnail_src": "https://si.imgix.net/b54b485a/uploads/origins/94c2856d-e146-4767-93e2-96b02fa878fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c71caca4e49a4758d0bcd841226bde", "thumbnail_srcset": "https://si.imgix.net/b54b485a/uploads/origins/94c2856d-e146-4767-93e2-96b02fa878fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c71caca4e49a4758d0bcd841226bde, https://si.imgix.net/b54b485a/uploads/origins/94c2856d-e146-4767-93e2-96b02fa878fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c5ceef5fcb518f93d89f1a33356f7fe 2x, https://si.imgix.net/b54b485a/uploads/origins/94c2856d-e146-4767-93e2-96b02fa878fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee59f136b9fbb383087c0a7a476d1410 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ginsyari先生。以前描いていただいた作品（https://skeb.jp/@ginsyarisya/works/11）がとても気に入りました。\n私のもう一人のOCであるセリーヌの作品をお願いしたいのですが、いかがでしょうか？月林とは親友で、セリーヌは時折、月林を訪ねます。\n\n主な特徴：セリーヌの目は青色なのでご注意ください（https://imgur.com/luuW5fS）。\n\nポーズや構図、表情は自由ですが、もう一枚の作品と同じ設定にしていただけませんか？テーブルの反対側に座ってるとか？\n\nお忙しい中、ご検討いただきありがとうございました！\n\nセリーヌ参考： https://imgur.com/a/l912h9B\n\nhttps://imgur.com/a/l912h9B", "created_at": "", "completed_at": ""}, {"path": "/@ginsyarisya/works/12", "thumbnail_src": "https://si.imgix.net/368b9236/uploads/origins/1cf17c33-3768-4123-9c3e-ef77fe327b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e1177b09acad4f643120389fe16d90", "thumbnail_srcset": "https://si.imgix.net/368b9236/uploads/origins/1cf17c33-3768-4123-9c3e-ef77fe327b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e1177b09acad4f643120389fe16d90, https://si.imgix.net/368b9236/uploads/origins/1cf17c33-3768-4123-9c3e-ef77fe327b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6f28fd43d75ef56438a569ef84af3db 2x, https://si.imgix.net/368b9236/uploads/origins/1cf17c33-3768-4123-9c3e-ef77fe327b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7494a1ce17289ed52158fc30da8245e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、友人の依頼であなたのカラフルなアートスタイルを見て、信じざるを得ませんでした！\n\n蛮族の女性との戦闘シーンをリクエストさせてください。蛮族は2つの武器を持っていますが、それを背負っています（1つは大きなロボットハンマー、もう1つは魔法の船のオールです）。彼女はTTRPGの最後のセッションで、火山の中で長い戦いを続けていて、床には骸骨の骨があり、彼女は小さな鳥を持っていて、その鳥の脚を持っている。彼女は鳥を剣のように振り回し、戦うために自分を雷で囲み、鳥は影の魔法を使う。\n\nポーズや火山の捉え方、キャラクター紹介を添付しましたが、これは自由です！\n\nバーバリアンレディ 参考：https://imgur.com/a/DANU1gW\n\nバードリファレンス： https://imgur.com/a/TDICr9X\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@ginsyarisya/works/11", "thumbnail_src": "https://si.imgix.net/55d238bf/uploads/origins/44edb81d-b198-4713-9f49-070f400e71fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a9c5c3a66d67b0874295824b44aa91c", "thumbnail_srcset": "https://si.imgix.net/55d238bf/uploads/origins/44edb81d-b198-4713-9f49-070f400e71fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a9c5c3a66d67b0874295824b44aa91c, https://si.imgix.net/55d238bf/uploads/origins/44edb81d-b198-4713-9f49-070f400e71fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0973999a01e20fccb7c07f807696cf3 2x, https://si.imgix.net/55d238bf/uploads/origins/44edb81d-b198-4713-9f49-070f400e71fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97b