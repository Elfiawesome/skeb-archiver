7-bda0-99ee348ba0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e22c357b4270dffd436f0324d144fd10", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Dz0nNGqnToiUQMh/works/175", "thumbnail_src": "https://si.imgix.net/6a03501c/uploads/origins/780a726f-19b0-4269-bc91-b3347dcce643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c68fe6468af0455c0cfc2726f2ce1cb1", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Dz0nNGqnToiUQMh/works/174", "thumbnail_src": "https://si.imgix.net/9da01794/uploads/origins/7c2ffd30-e6d9-4776-9f46-02d4ef40f6ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c982c6d2208eab4b1985bf304b83277", "thumbnail_srcset": "", "genre": "comic", "nsfw": true, "body": "お久しぶりのリクエストです！\n\n黒獣2 http://liquid.nexton-net.jp/15th/kuro_2/chara.htmlからリクエストです！\n対象)コハク\n竿役)リュカオン・狼男達\nキャラクターイメージ↓\nhttps://www.pixiv.net/artworks/112058204\nリュカオンはホームページのキャラクター紹介から。リュカオンの手下は公式ではいないので以下の紹介文のキャラクターイメージです。\n\n紫色の狼男\nリュカオンの手下。インテリで戦いでは作戦などの提案をしている。調教の傾向は「どのようにすればこの女は堕ちるか」を常に考えながら調教を施す傾向。冷静でありながらあつくなると本能に忠実になる。\n\n黄色の狼男\nリュカオンの手下。奇人。調教の傾向は「ネチネチしつこく」。本能に忠実でたまに暴走する。(腕を強く握る。相手の意識がとんでも行為をするなど)\n\n赤色の狼男\nリュカオンの手下。自分に大きな自信をもっており、相手を堕とすことに喜びを感じている。\n\nストーリー\n-奉仕国家に敗れ、囚われているコハク。そこに現れるリュカオン・狼男達。リュカオンには何度も犯されているが、他の狼男たちは見たことがない。こんな大勢に身構えるコハク。今宵も狼男たちによる狐娘の調教が始まる！-\n\n※お願い\nカラーまたは白黒でお願いします。乱行ものでも1対1でも描きやすいほうで構いません。乱行の場合にはきくらげさんのお好きなように！1対1の場合はキャラクターイメージの通りなプレイをお願いします！\n体位は特に指定しませんが、どこかでいいので、「種付けプレス」を入れていただけると大変嬉しいです。最低でも5ページぐらいあると嬉しいです！\n\nだんだんと精液でドロドロになっていくコハクがみられることが楽しみです！\n\nきくらげさんの絵柄でコハク達・リュカオン達が見られるのが楽しみです！！\n\n\n以上何卒よろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@Dz0nN