る。眼鏡をかけ、右目には音楽とのつながりを象徴するノコギリ波のオーディオ波形のタトゥーがある。手には宝石、首にはチョーカーをつけ、爪は黒く塗られている。\n\n服装：ほとんどが黒で、髪の色と同じ色のハイライトが入っている。宇宙と天文学が好きで、首には三日月のネックレス、パンツには星のチェーンをつけている。黒のインナー・パーカーは腰の上でクロップド丈。アウターのジャケットはルーズに着ることが多く、時には片方か両方の肩から落ちることもある。シルバーのバックルが付いた背の高い黒いブーツを履いている。\n\nhttps://drive.google.com/drive/folders/1KKeGAMYjWJaCSkJBhbVUptdnx9LM60ZM?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_MMOQ/works/70", "thumbnail_src": "https://si.imgix.net/51a43f39/uploads/origins/72419554-92ac-4ae9-b249-3426d42324e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce46486fef1e10db89a6729cf9950467", "thumbnail_srcset": "https://si.imgix.net/51a43f39/uploads/origins/72419554-92ac-4ae9-b249-3426d42324e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce46486fef1e10db89a6729cf9950467, https://si.imgix.net/51a43f39/uploads/origins/72419554-92ac-4ae9-b249-3426d42324e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5f2430e9b8e3a8b68e622911906de40 2x, https://si.imgix.net/51a43f39/uploads/origins/72419554-92ac-4ae9-b249-3426d42324e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03aef26c5a18adba83a48b0cda8ba774 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_MMOQ/works/69", "thumbnail_src": "https://si.imgix.net/d855d55b/uploads/origins/7ab42c8c-172c-46d5-9d1e-3f78ae0f05f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=416d14c9e9bc7de78f01d