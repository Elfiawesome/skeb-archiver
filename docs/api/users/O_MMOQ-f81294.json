ります。全体的に冬っぽい感じです。\n資料は外見や軽い設定などメモしてあるものを添付させていただきました。\n資料内シナリオのネタバレなどはございません。\n\n乱文失礼いたしました。\n金額不足など何かしら不備がございましたら再送要請をしていただければ幸いです。また、その他不都合な点がございましたら遠慮無くキャンセルの方していただいて大丈夫です。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1qLdTRfGxh0-6-nq77WWiGsFuN2pk6JMN", "created_at": "", "completed_at": ""}, {"path": "/@O_MMOQ/works/73", "thumbnail_src": "https://si.imgix.net/b57fc0e8/uploads/origins/79fedf1a-f3d4-4214-a980-5006b27b3c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76cd24f55c85a7d2bd7a6101a1699d93", "thumbnail_srcset": "https://si.imgix.net/b57fc0e8/uploads/origins/79fedf1a-f3d4-4214-a980-5006b27b3c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76cd24f55c85a7d2bd7a6101a1699d93, https://si.imgix.net/b57fc0e8/uploads/origins/79fedf1a-f3d4-4214-a980-5006b27b3c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c4e8dbcbd79b7687525c32713afd11a 2x, https://si.imgix.net/b57fc0e8/uploads/origins/79fedf1a-f3d4-4214-a980-5006b27b3c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31c0769b63fd2fcf17214fee377d32a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_MMOQ/works/72", "thumbnail_src": "https://si.imgix.net/d87344b8/uploads/origins/124ccd89-46e7-484e-b5e4-308e787e9227?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fce18948c8369bb9f9e9bb92b12aed73", "thumbnail_srcset": "https://si.imgix.net/d87344b8/uplo