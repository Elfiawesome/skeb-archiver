42bb-be93-bf40a247d5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92db79f1b30f674f602e14337869305", "thumbnail_srcset": "https://si.imgix.net/e3c6153d/uploads/origins/10f96549-f9cd-42bb-be93-bf40a247d5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92db79f1b30f674f602e14337869305, https://si.imgix.net/e3c6153d/uploads/origins/10f96549-f9cd-42bb-be93-bf40a247d5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25261d0faf35358ed591a14fa80d009a 2x, https://si.imgix.net/e3c6153d/uploads/origins/10f96549-f9cd-42bb-be93-bf40a247d5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8ea35dfe0f4d4daa7caf98c2a20fe9b 3x", "genre": "art", "nsfw": false, "body": "いつも楽しく配信を拝見させていただいております。\n\n今回はフリフリなメイド服の千虎ちゃんをリクエストさせていただきます。\n\n千虎ちゃんといえば元気な感じだと思いますが、今回は恥ずかしがっている表情でお願いしたいです。髪はロングでお願いします。\n盛らないで頂けるととても助かります。\n\n難しい場合は描きやすいようにして頂いて差し支えありません。\nお忙しいとは存じますが、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oOtoriU_U/works/4", "thumbnail_src": "https://si.imgix.net/a2890e38/uploads/origins/e8840b48-f2a4-4fdc-abaf-8af7865069ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89228d801300bf8a4cfd8b57e135619f", "thumbnail_srcset": "https://si.imgix.net/a2890e38/uploads/origins/e8840b48-f2a4-4fdc-abaf-8af7865069ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89228d801300bf8a4cfd8b57e135619f, https://si.imgix.net/a2890e38/uploads/origins/e8840b48-f2a4-4fdc-abaf-8af7865069ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=892f2c2e337427382f5b4cb5fc72cb04 2x, https://si.imgix.net/a2890e38/uploads/origins/e8840b48-f2a4-4fdc-abaf-8af7865069ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9559515b655663c1fc06e4de84bc62d1 3x", "genre": "art", "nsfw": false, "body": "私のオリキャラのエミィちゃんのイラストを描いていただけますか？アイコン等に使用したいです。\n構図はおまかせします。\nうさ耳つけてるのでお願いします。\n衣装、髪型等はおまかせします。\n身長は150cmで胸はあまりない感じで雰囲気お淑やかで、ふわふわした感じでお願いします。ロリっぽい体型であると助かります。\n参考資料\n\nhttps://x.com/ustmgt/status/1755474117938331820?s=46&t=kOB2BwEQkkxqBG2gqKGwLw", "created_at": "", "completed_at": ""}, {"path": "/@oOtoriU_U/works/3", "thumbnail_src": "https://si.imgix.net/009c4588/uploads/origins/74850ae1-1781-43b6-9b2e-a8777f3092c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc06288d65584ede84a86018808ade68", "thumbnail_srcset": "https://si.imgix.net/009c4588/uploads/origins/74850ae1-1781-43b6-9b2e-a8777f3092c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc06288d65584ede84a86018808ade68, https://si.imgix.net/009c4588/uploads/origins/74850ae1-1781-43b6-9b2e-a8777f3092c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=325800b2a569de805cea7d12f21fa829 2x, https://si.imgix.net/009c4588/uploads/origins/74850ae1-1781-43b6-9b2e-a8777f3092c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d9c29cd56f9d6f5147cbe8b9b6c63e4 3x", "genre": "art", "nsfw": false, "body": "【スケブ対象】\n天海くりね\n【衣装】\nスク水\n（一般に旧スク水って言われてるタイプ／ひらひらのスカートタイプではない）\n初期衣装のパーカーを羽織ってる\n（フードは被ってない）\n【ヘアスタイル】ボブカット？（初期衣装の感じ）\n\n他はお任せ／脱がし等のセンシティブは事務所の規定の範囲内で。\n\n注文うるさくなりましたが、ご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oOtoriU_U/works/2", "thumbnail_src": "https://si.imgix.net/28af61a6/uploads/origins/62f48699-8edc-4b2b-9516-4937c4f6da7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c8e242c4c19bf1f789afca312174ccf", "thumbnail_srcset": "https://si.imgix.net/28af61a6/uploads/origins/62f48699-8edc-4b2b-9516-4937c4f6da7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c8e242c4c19bf1f789afca312174ccf, https://si.imgix.net/28af61a6/uploads/origins/62f48699-8edc-4b2b-9516-4937c4f6da7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ece10568b7ccde86d86e4f687f67d9e4 2x, https://si.imgix.net/28af61a6/uploads/origins/62f48699-8edc-4b2b-9516-4937c4f6da7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50f070bfda646ec9788f23da9a87f898 3x", "genre": "art", "nsfw": false, "body": "こんにちはこの度リクエスト再開されたとのことで依頼させていただきたいのですが内容は\n\n白い立ち耳うさぎ＋白地に黒（グレー）模様のたれ耳うさぎの姉妹の擬人化イラストを年齢、衣装、背景、小物等おおとり先生の趣味に合わせてオリジナルで描いていただけたらと思います。\n内容的に２キャラになってしまうので金額が倍になっても構いません。（システム上そのまま可能かリクエストし直しになるのかわかりませんが…）\n\nお忙しいと思いますがご検討いただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@oOtoriU_U/works/1", "thumbnail_src": "https://si.imgix.net/da05767f/uploads/origins/bde1b1df-7b91-4b65-bf3b-743b6c2409fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14ff88866dc448a63a98b07b240d206a", "thumbnail_srcset": "https://si.imgix.net/da05767f/uploads/origins/bde1b1df-7b91-4b65-bf3b-743b6c2409fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14ff88866dc448a63a98b07b240d206a, https://si.imgix.net/da05767f/uploads/origins/bde1b1df-7b91-4b65-bf3b-743b6c2409fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d4be00d6ce2fb734b45f6c1231dc202 2x, https://si.imgix.net/da05767f/uploads/origins/bde1b1df-7b91-4b65-bf3b-743b6c2409fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26d0831688c13ea7622acda523670ad1 3x", "genre": "art", "nsfw": false, "body": "おおとり先生のイラストが好きで依頼させていただきます！\n\n白ニーソ・制服姿の鳳儚ちゃんのイラストをお願いします。\n構図や背景等は全てお任せ致します。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}]}