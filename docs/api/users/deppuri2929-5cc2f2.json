ff-92db-a2d012bd37ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2c4e91dced6ed0dfd04ee9b2defebf3", "thumbnail_srcset": "https://si.imgix.net/689afcd3/uploads/origins/586ba9fc-6c1c-49ff-92db-a2d012bd37ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2c4e91dced6ed0dfd04ee9b2defebf3, https://si.imgix.net/689afcd3/uploads/origins/586ba9fc-6c1c-49ff-92db-a2d012bd37ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d01179a70ebeacc082828f5630be1536 2x, https://si.imgix.net/689afcd3/uploads/origins/586ba9fc-6c1c-49ff-92db-a2d012bd37ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdfffcbf886f4d9fa83a35dd2c02230f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@deppuri2929/works/59", "thumbnail_src": "https://si.imgix.net/b760d504/uploads/origins/ad7ccf24-87c7-46c0-83dc-5d91a4675c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b82ba13754b0eb8f985dfe4a59e8a93", "thumbnail_srcset": "https://si.imgix.net/b760d504/uploads/origins/ad7ccf24-87c7-46c0-83dc-5d91a4675c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b82ba13754b0eb8f985dfe4a59e8a93, https://si.imgix.net/b760d504/uploads/origins/ad7ccf24-87c7-46c0-83dc-5d91a4675c31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bb77ca050de9a1abdf7832dcbf375c9 2x, https://si.imgix.net/b760d504/uploads/origins/ad7ccf24-87c7-46c0-83dc-5d91a4675c31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffe35aa174fdd04de6747363915cf83c 3x", "genre": "art", "nsfw": true, "body": "キャラ：エリートトレジャーハンターロボ娘のリジネッタさん\nhttps://x.com/super_mican\nhttps://x.com/super_mican/status/1953298649238167930\n\nキャラの性格：自信たっぷりで、自分が一番可愛く最強だと自負している感じ。\n\nシチュ：巨大な肥満化スライムに敗北したリジネッタさん。尻餅をついたところに口から侵入を許してしまい、肥満化されてしまい肉塊サイズへ…\n\n恰好：メガネはかけて、他は裸なり破けてたり自由にお任せします。\n\n肉量：歩行不能の肉塊サイズで、たっぷり全身盛ってください。\nおっぱいが大きいキャラなので、おっぱいは多めに盛ってください。\n\n描いてほしいイラスト：体内で増殖するスライムを受け止めきれず、太った超乳の先からスライムを滴らせる事しかできなくなった肉苗床のリジネッタさん。\n\n表情：視線は胸の先。息苦しくも全身愛撫されてるような快感と、噴乳の快感に耐えてる様子。\n\n心の台詞（あってもなくてもいいです。イメージの参考になれば）：\n（ま、まずい…♡こんな体にされたというのに…♡太り過ぎて、息苦しい…のに…♡何度も軽くイかされてるような快感が…♡）\n（獲物を逃がさないために、太らせた挙句、快感で逃げる気力を奪うなんて…♡ずる賢いスライム…♡）\n（身動きもできませんし…♡敵意も感じられませんし…♡気持ちいいし…♡し、仕方ありませんね…♡動けるようになるまでは、付き合ってあげます…♡）\n（排出する量より、増える量が少しだけ多い…♡な、なんとかしないと、このままでは…♡）\n\nNG：張ってる感じの描写。あへ顔系の、白目むいてる表情", "created_at": "", "completed_at": ""}, {"path": "/@deppuri2929/works/58", "thumbnail_src": "https://si.imgix.net/4115ff27/uploads/origins/113a4f68-30a4-4233-a82f-dec3e30bb9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=886133ed171bbc3b85b451e8e28a7517", "thumbnail_srcset": "https://si.imgix.net/4115ff27/uploads/origins/113a4f68-30a4-4233-a82f-dec3e30bb9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=886133ed171bbc3b85b451e8e28a7517, https://si.imgix.net/4115ff27/uploads/origins/113a4f68-30a4-4233-a82f-dec3e30bb9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f7c413dcc4467f11e855f9bfd3c1a13 2x, https://si.imgix.net/4115ff27/uploads/origins/113a4f68-30a4-4233-a82f-dec3e30bb9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dc7cb9ee3025a0038f9c54edce5b695 3x", "genre": "art", "nsfw": true, "body": "オリキャラのタプリスちゃんが魔王っぽくなってしまったifのイラストをお願いします。\n見た目は魔王のツノと紫の体色になった以外は肥満化した時と変わらない感じでお願いします。(魔王の莫大な魔力も受け継いだけどそこで悪用しないのは勇者メンタル故)歩けないくらいに太ってしまったのを魔法で補助しながら幼馴染と一緒に生活してる感じの構図でお願いします。\nあとセリフで\n「やっぱりちょっとだけ魔王の怠惰が移っちゃってる。でもお肉が増えてるのを楽しんでる自分もいるなぁ」\nみたいな感じの入れていただけると嬉しいです。\n金額に合わないようでしたらキャンセルして下さい。よろしければご一考下さい。", "created_at": "", "completed_at": ""}, {"path": "/@deppuri2929/works/57", "thumbnail_src": "https://si.imgix.net/b1e9a339/uploads/origins/22b79279-8f27-4ce4-b90f-c5cbcb378916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a180be227a3ae2cd23af08d8cba89efb", "thumbnail_srcset": "https://si.imgix.net/b1e9a339/uploads/origins/22b79279-8f27-4ce4-b90f-c5cbcb378916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a180be227a3ae2cd23af08d8cba89efb, https://si.imgix.net/b1e9a339/uploads/origins/22b79279-8f27-4ce4-b90f-c5cbcb378916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8898ec8c35e8f8252c6a75ae165de7e2 2x, https://si.imgix.net/b1e9a339/uploads/origins/22b79279-8f27-4ce4-b90f-c5cbcb378916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58d187d02ec7b86063d53674a1880b22 3x", "genre": "art", "nsfw": true, "body": "ホロライブの一条莉々華のチクチンふたなり肥満化をお願いします！！\nエクレールさんのアイテムの肉ふーせんで体重が2tになるという付箋と、射精するたびに体重が500kg太るという付箋をつけられて、\n足元には空き瓶になったフタナールが3つも転がっていて、かなりの巨根ですが、腹肉に潰れされて、亀頭のみ見えるちんぽとチクチンが生えている\nさらにチアフィーダーの応援によって、身体を揺らして自己肥育をしようとチクチンを自分でしごきながら、自分の体を前後に揺らして床に股からはえたちんぽを擦り付けている。\nできることならその後股のちんぽ、チクチンから射精をして、アヘ顔になって、体がぶくぶくと太っている表現を描いてもらいたいです！\nまた、セリフを入れてもらいたいです！\n「なにこれぇ！？莉々華の体どうなってるの！？」\n「乳首もちんぽになってて、とんでもないくらい太ってるし…！！」\n「え…？射精するともっと太るぅ！？いやだぁぁー！！」\n\nもし射精しているのを描いていただけるなら\n「やだぁぁぁ！！射精したくない！！太りたくないぃぃぃ！！」\n「チアちゃん応援するのやめてぇぇぇえ！！」\n「おほぉ！？イグゥゥゥ！！！もっと太っちゃうぅぅ！！」\n\n服は頭に乗せたサングラスと、太ったことでビリビリに破れた服を羽織っているような感じにしてください！\n\nhttps://hololive.hololivepro.com/talents/ichijou-ririka/", "created_at": "", "completed_at": ""}, {"path": "/@deppuri2929/works/56", "thumbnail_src": "https://si.imgix.net/dc680e83/uploads/origins/297be82a-918a-4e9c-a7c5-6186ce2a5a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ff0bbcdc75977eec9c13c6087c31dd", "thumbnail_srcset": "https://si.imgix.net/dc680e83/uploads/origins/297be82a-918a-4e9c-a7c5-6186ce2a5a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ff0bbcdc75977eec9c13c6087c31dd, https://si.imgix.net/dc680e83/uploads/origins/297be82a-918a-4e9c-a7c5-6186ce2a5a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9fd1c2ce4e99a456f51dca50a4db04a 2x, https://si.imgix.net/dc680e83/uploads/origins/297be82a-918a-4e9c-a7c5-6186ce2a5a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b090447cead6fb97163949d884a6687b 3x", "genre": "art", "nsfw": true, "body": "エクレール様リクエスト失礼いたします。\nエクレール様のオリジナルキャラクターの1人の虎瀬フウカちゃんがTF肥満化して豚化人間収容施設に収容されてからの後日談のイラストを依頼したいです。\n\n時系列は収容から1ヶ月程度\n身長体重は前回168cm48kg→2m300kgになった時から変わらないもしくは微増\n排泄の制御が出来ない状態も変わらず\n収容直後は肥満化し豚化したもの綺麗だった身体は地面の土、餌の食べカス、そして自らの汗や糞尿で非常に汚れて家畜らしくなり匂いも凄まじいものになっている。\n\nイラストの内容は1ヶ月何をしても何を考えても元の美少女の姿に戻ることはなく身体に引っ張られるままに食事排泄睡眠を繰り返す単調な生活を繰り返し人間の感覚が薄れていた所に学校のクラスメイトや読モ仲間たちが許可を得て見学に来てしまい恥ずかしい思いをすると言う内容です。（今回は仲良しのコエちゃんは不在、フウカちゃんのTF肥満化は記憶改変されておらず美少女の姿で覚えられておりクラスメイトや読モ仲間は初めて変貌したフウカちゃんを見ると言う設置でお願いします。）\nお話の流れは\n①フウカちゃんはどうにもならない現状にウンザリしつつも餌を食べ排泄し寝ると言う暮らしに慣れてきてしまっている\n②そこにクラスメイトや読モ仲間たちが突然姿を消したフウカが豚化人間収容施設に居ると聞き見学にやって来ます。そしてそのあまりの変わりようにさまざまな反応を示します。（体重や容姿、匂いや環境など）\n③フウカは突然のクラスメイトや読モ仲間の来訪に驚いてしまい大量の放尿&脱糞（糞は水分少なめの固形）\n④クラスメイトたちは驚きつつも見学は撮影可であるので今のフウカを撮影し出し拡散されてしまう。クラスメイトや読モ仲間は優しい言葉をフウカにかけつつも撮影しSNSなどでは無配慮な投稿をしている。フウカはさまざまな思考が巡るが何も話せず鳴き声を出すしか出来ない。\n\nイラストは基本的に1枚絵で可能であれば排泄の差分をお願いします（差分が無理であれば排泄している方のみでお願いします。）以前の豚化のイラストのように使い回して文章を書いていただきたいです。\n\n1枚絵は前のTF豚化したフウカちゃんと同じようなイラストを今のエクレール様の画風で同じような背景で汚れを増やして糞を固形にして尿を別に描写して頂きたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@deppuri2929/works/55", "thumbnail_src": "https://si.imgix.net/59ad203f/uploads/origins/97e6347a-54b0-40d8-a657-6cd473d28a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e9f829ea8c9acf5c73a66aadd204777", "thumbnail_srcset": "https://si.imgix.net/59ad203f/uploads/origins/97e6347a-54b0-40d8-a657-6cd473d28a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e9f829ea8c9acf5c73a66aadd204777, https://si.imgix.net/59ad203f/uploads/origins/97e6347a-54b0-40d8-a657-6cd473d28a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc0c9a0a26fb09b8153505aba9432e1c 2x, https://si.imgix.net/59ad203f/uploads/origins/97e6347a-54b0-40d8-a657-6cd473d28a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f763fa57b51305b0ea430ce435f6cd32 3x", "genre": "art", "nsfw": true, "body": "ポケモンのアカネで膨乳肥満化シチュエーションをお願いしたいです。\nシチュエーションですが、ヒダイマックスの実験の一環で人体からモーモーミルクを絞り出せるように改造したが失敗してしまい、\n飲むどころか触れるだけで肥満化してしまうヒダイマックスミルクを噴き出すようになってしまったという感じです。\n参考URLのような体型で、何も食べていないのに自身のヒダイマックスミルクによってさらに肥満化し続けているような描写があると嬉しいです。\n\nhttps://skeb.jp/@deppuri2929/works/27", "created_at": "", "completed_at": ""}, {"path": "/@deppuri2929/works/54", "thumbnail_src": "https://si.imgix.net/f6a94111/uploads/origins/3de824fa-b5b6-430b-916e-2abc6aa3c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c4e9110db82945667b0c76aebd305ff", "thumbnail_srcset": "https://si.imgix.net/f6a94111/uploads/origins/3de824fa-b5b6-430b-916e-2abc6aa3c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c4e9110db82945667b0c76aebd305ff, https://si.imgix.net/f6a94111/uploads/origins/3de824fa-b5b6-430b-916e-2abc6aa3c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a61d9e4a62dcf1700bbf4355a2433ba4 2x, https://si.imgix.net/f6a94111/uploads/origins/3de824fa-b5b6-430b-916e-2abc6aa3c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4185