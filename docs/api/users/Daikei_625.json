uto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d38f04f1d512ba565ba9d299bbc5e8a1 2x, https://si.imgix.net/2d79f4de/uploads/origins/013cfb75-626b-4a1e-8e8e-b27621cca8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=931ca773385fe3bcec203bc9d46db9d8 3x", "genre": "art", "nsfw": false, "body": "Keep up the good work, I look forward to seeing what you create for my golfing art.\n\n良い仕事を続けてください、私はあなたが私のゴルフアートのために何を作成するかを見るのを楽しみにしています。", "created_at": "", "completed_at": ""}, {"path": "/@Daikei_625/works/23", "thumbnail_src": "https://si.imgix.net/0669b209/uploads/origins/ee18514f-1f5c-4531-a194-79a35a9f25bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e0963dbde789fc44deaf8b555c716a8", "thumbnail_srcset": "https://si.imgix.net/0669b209/uploads/origins/ee18514f-1f5c-4531-a194-79a35a9f25bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e0963dbde789fc44deaf8b555c716a8, https://si.imgix.net/0669b209/uploads/origins/ee18514f-1f5c-4531-a194-79a35a9f25bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a3599520a9a69fbacee2eb8d55c1105 2x, https://si.imgix.net/0669b209/uploads/origins/ee18514f-1f5c-4531-a194-79a35a9f25bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5443399934d501a2458f05f4ab599161 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Daikei_625/works/22", "thumbnail_src": "https://si.imgix.net/6e25e935/uploads/origins/ce18394a-026f-4f8a-8935-ef0ad1f8a466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df55a2faf3d171544d0499658be2acf", "thumbnail_srcset": "https://si.imgix.net/6e25e935/uploads/origins/ce18394a-026f-4f8a-8935-ef0ad1f8a466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df55a2faf3d171544d0499658be2acf, https://si.imgix.net/6e25e935/uploads/origins/ce18394a-026f-4f8a-8935-ef0ad1f8a466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e806f3836cece666d63bf6fd6ab54685 2x, https://si.imgix.net/6e25e935/uploads/origins/ce18394a-026f-4f8a-8935-ef0ad1f8a466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2039a8fda3a281408fcccc75130bb13 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n素敵な絵柄に惹かれて依頼させていただきました！\n\nVRChatというゲームで私が使用しているアバターのイラストをお願いします。\n眠そうな感じですと嬉しいです。\nポーズや構図などはお任せします。\n\nhttps://hub.vroid.com/characters/4662811115251876619/models/8165303740581620364\n\nhttps://drive.google.com/drive/folders/15OsPEKxKudTU-Pz5MWc361M8diwGkz3O?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Daikei_625/works/21", "thumbnail_src": "https://si.imgix.net/69795b8b/uploads/origins/c25ac09c-5c4a-4724-ae39-ef4d4812911a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f45c59a88c561a3e25dd2f0219043680", "thumbnail_srcset": "https://si.imgix.net/69795b8b/uploads/origins/c25ac09c-5c4a-4724-ae39-ef4d4812911a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f45c59a88c561a3e25dd2f0219043680, https://si.imgix.net/69795b8b/uploads/origins/c25ac09c-5c4a-4724-ae39-ef4d4812911a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56ca023151efaa593ef5502447b5c799 2x, https://si.imgix.net/69795b8b/uploads/origins/c25ac09c-5c4a-4724-ae39-ef4d4812911a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=306bec67487fc5ed2785df7c579a38a3 3x", "genre": "art", "nsfw": false, "body": "初めまして、カーマ堕ラ堕ラと申します。\n現在はストリーマーとして活動しています。\nだいけいさんのイラストをSNS