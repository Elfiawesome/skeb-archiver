0-9364-5ea5f9be415c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03026fe0b1d86805a9612b9b85d220ea, https://si.imgix.net/58685b93/uploads/origins/bd43bd3d-90b4-4920-9364-5ea5f9be415c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5f51f675128d22a8c2528df1126908f 2x, https://si.imgix.net/58685b93/uploads/origins/bd43bd3d-90b4-4920-9364-5ea5f9be415c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78a8679dbb835a4f9d535db080a23b56 3x", "genre": "art", "nsfw": true, "body": "Skeb開放のときをおまちしておりました！！ご無沙汰しております！！\nもしよければ今回はボクの看板ケモ娘『ミドリさん』を描いて頂きたいです！\n\nお願いしたいシチュとしてはミドリさんの浮気(甘NTR)のSEX絵で、\n好意の押しに弱く流されやすいミドリさんが小太りな中年おじさんに\nガッツりハメられていけないことと思いつつもイイ関係になっちゃう・・・\nという関係性のイメージでお願いしたく。体格差も感じられるとありがたいです。\n\n可能でしたら挿入前(スパッツあるなし)から挿入直前、挿入、大量に膣内射精、ペニスを抜いた後(事後)のような差分をいくつか頂けると嬉しいです。自分でくぱぁしたりおじさんのでかいペニスを招きいれるような関係の進んだ差分もあるとすごくありがたいのですがこちらは可能ならばで。(竿役のおじさんは部位のみで大丈夫です。)\n\nだいぶ贅沢に要望を伝えてしまいましたが叶えていただける範囲でかまいませんので\nなにとぞご検討よろしくお願いします！！\n\nhttps://www.pixiv.net/artworks/46771774", "created_at": "", "completed_at": ""}, {"path": "/@muhyowo/works/17", "thumbnail_src": "https://si.imgix.net/680d147f/uploads/origins/6eb33338-b0de-4204-9fae-7c2f9fc134a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9deeeb7625f362635eab5adbf8cc1e25", "thumbnail_srcset": "https://si.imgix.net/680d147f/uploads/origins/6eb33338-b0de-4204-9fae-7c2f9fc134a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9deeeb7625f362635eab5adbf8cc1e25, https://si.imgix.net/680d147f/uploads/origins/6eb33338-b0de-4204-9fae-7c2f9fc134a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44b1708df2351250014056bfb58b6f63 2x, https://si.imgix.net/680d147f/uploads/origins/6eb33338-b0de-4204-9fae-7c2f9fc134a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4061a1366c21f7635e2fea3a2e735d7 3x", "genre": "art", "nsfw": true, "body": "よろしければリクエストさせて下さい。\n魔界戦記ディスガイアよりハナコで戦火的なシチュエーションの物。\n基本は戦闘での敗北凌辱レイプ\n涙目・挿入したままでの中出し・レイプ目で絶望感のある絵だと嬉しいです。\n\n資料として公式のURLを添付します。\nhttps://disgaea.jp/psp2/lp/\nまたこちらはディスガイアRPGになりますがキャラ一覧のwikiです。\nhttps://wiki.dengekionline.com/disgaea-app/%E3%82%AD%E3%83%A3%E3%83%A9%E3%82%AF%E3%82%BF%E3%83%BC%E4%B8%80%E8%A6%A7\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@muhyowo/works/16", "thumbnail_src": "https://si.imgix.net/30baeb4a/uploads/origins/dbfd6f35-c6cc-408d-a542-f86edd70e0c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9190c06f700e42903a2ede684f14b6b7", "thumbnail_srcset": "https://si.imgix.net/30baeb4a/uploads/origins/dbfd6f35-c6cc-408d-a542-f86edd70e0c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9190c06f700e42903a2ede684f14b6b7, https://si.imgix.net/30baeb4a/uploads/origins/dbfd6f35-c6cc-408d-a542-f86edd70e0c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db031cd14e4e4927aa78cc2f18d8ae03 2x, https://si.imgix.net/30baeb4a/uploads/origins/dbfd6f35-c6cc-408d-a542-f86edd70e0c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee7846aff3f045b9a135fdb426c778c1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！！\n依頼よろしいですか！！\n\n『グランブルーファンタジー』の『ニオ』ちゃんで一枚お願いしたいです！！\n\n今回は何かの身体検査をイメージしています\nシチュとしては、立ったまま服を全裸に剥かれて頭の後ろに手を組んだ状態で体を弄られてる感じでお願いします…！\n\n表情は羞恥と悔しさで顔を赤らめ、体にはじっとりと汗をかかせてください！\n\n差分のような形でも良いので、お尻の穴が見えるようにお尻を広げられたり乳首を摘まれて引っ張られたり、撮影されたり、NTR風味でかわいそうな扱いをされてるとなお嬉しいです！！\n\nちょっとマニアックなので、気が向いたらで良いのでよろしくお願いします！！！", "created_at": "", "completed_at": ""}, {"path": "/@muhyowo/works/15", "thumbnail_src": "https://si.imgix.net/fa28ed6f/uploads/origins/1a3bfdad-910a-436f-a9e8-ee2267590367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a51d1ff11c956715e3e5688a4f161db2", "thumbnail_srcset": "https://si.imgix.net/fa28ed6f/uploads/origins/1a3bfdad-910a-436f-a9e8-ee2267590367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a51d1ff11c956715e3e5688a4f161db2, https://si.imgix.net/fa28ed6f/uploads/origins/1a3bfdad-910a-436f-a9e8-ee2267590367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ce7cbd576a911bc91b049a0240fc66f 2x, https://si.imgix.net/fa28ed6f/uploads/origins/1a3bfdad-910a-436f-a9e8-ee2267590367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2491416742d44c88fbeef5754465111 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@muhyowo/works/14", "thumbnail_src": "https://si.imgix.net/986bd7ad/uploads/origins/ee41d620-ab60-4c0e-8291-ff80b7591124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c49f290c28230a8faf9a412715e71675", "thumbnail_srcset": "https://si.imgix.net/986bd7ad/uploads/origins/ee41d620-ab60-4c0e-8291-ff80b7591124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c49f290c28230a8faf9a412715e71675, https://si.imgix.net/986bd7ad/uploads/origins/ee41d620-ab60-4c0e-8291-ff80b7591124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc0cb887ee2902047450abc04e02780a 2x, https://si.imgix.net/986bd7ad/uploads/origins/ee41d620-ab60-4c0e-8291-ff80b7591124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=787a9bc8c8a6f1fae597c368fe9044de 3x", "genre": "art", "nsfw": true, "body": "はじめまして、さらさらされていたので拝見させて頂いたところとてもスケベで惹かれて参りました。\n\n別の方にクリエイトしていただいたオリジナルキャラクターで恐縮ですが、\n資料の銀髪褐色メスガキギザ歯貧乳刺青ロリダークエルフのカティちゃんについて下記要素を満たすようにお願いいたします。\n\n・触手\n・くぱぁ\n・おしっこ\nその他衣装の状態など細かいポイントはお任せしたいと思います。\n\nご検討よろしくお願いいたします。\n\n\nご参考※資料更