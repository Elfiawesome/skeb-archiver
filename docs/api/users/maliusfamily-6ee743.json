eea8bc4c 2x, https://si.imgix.net/f76f7897/uploads/origins/e986fcd7-2f3b-4cb4-be2f-928abe8db8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30ec6a592970792936851b7ce10c39c9 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maliusfamily/works/140", "thumbnail_src": "https://si.imgix.net/9f93fe07/uploads/origins/9fa2e846-537c-42ab-8dea-4e2b7b5cf58e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd2c5231c96f534e952146c435bb8657", "thumbnail_srcset": "https://si.imgix.net/9f93fe07/uploads/origins/9fa2e846-537c-42ab-8dea-4e2b7b5cf58e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd2c5231c96f534e952146c435bb8657, https://si.imgix.net/9f93fe07/uploads/origins/9fa2e846-537c-42ab-8dea-4e2b7b5cf58e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71c2ad62f66270ab61b95f0ae594c650 2x, https://si.imgix.net/9f93fe07/uploads/origins/9fa2e846-537c-42ab-8dea-4e2b7b5cf58e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94efc32432d194ff9f35198b85567a57 3x", "genre": "comic", "nsfw": true, "body": "ぼっち・ざ・ろっく！の喜多郁代(私服Ver.)がセルに吸収される漫画を描いて欲しいです。\n\n画像参照:左上私服5の青いワンピの https://pbs.twimg.com/media/GYe1O1FbYAA-Agk?format=jpg&name=small\n\nシチュは、\n\n･喜多が愉しくスマホ(ピンク色)をいじる最中、いきなり後ろからセルのしっぽ襲いかかる\n･喜多は気づき、後ろに驚いな表情しながら振り向くも胸元まで捕まれ、スマホが落ちるところで吸収シーンが始まる\n･喜多は必死で足つかせじたばたする(最低3コマ以上が欲しい、パンチラは白いパンで)\n･ごっくん直前で足がピクピクしてて、セルは得意げな顔で膨らみを見てる\n･“きゅっぽん”という効果音と共に、喜多がしっぽ内に吸い込まれる\n･体内通過する時パンチラを晒す\n･体内に閉じ込められて意識を失って、セルはご満悦するような表情で終わる", "created_at": "", "completed_at": ""}, {"path": "/@maliusfamily/works/139", "thumbnail_src": "https://si.imgix.net/64b5408f/uploads/origins/c04ebd28-4eba-44da-9147-269233b89386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c84e819c37db0a90278e4bd77d8fccb", "thumbnail_srcset": "https://si.imgix.net/64b5408f/uploads/origins/c04ebd28-4eba-44da-9147-269233b89386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c84e819c37db0a90278e4bd77d8fccb, https://si.imgix.net/64b5408f/uploads/origins/c04ebd28-4eba-44da-9147-269233b89386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b34f43bd127314e857665e229ca6290c 2x, https://si.imgix.net/64b5408f/uploads/origins/c04ebd28-4eba-44da-9147-269233b89386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f04c42f7843aa41b4aa4b2c3046768e 3x", "genre": "art", "nsfw": true, "body": "今回も眷属化ネタです。\nそういえばレベル5女子で一人だけ食われてないのがいたので、マリウスくんに吸収されて眷属にされちゃった麦野さんをお願いします！\nコンセプトは飛び道具主体の砲撃型で、クラゲだと直属眷属の方と被ってしまうのでチョウチンアンコウあたりのモチーフでお願いします。\n眷属化固法さん同様に肉繭から変化したのが分かる質感だと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@maliusfamily/works/138", "thumbnail_src": "https://si.imgix.net/8fcbd449/uploads/origins/4d2b4a37-0f1d-4ae8-98e7-b74d37d2e85f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a11239bdcf252092936a79e79ae98b7f", "thumbnail_srcset": "https://si.imgix.net/8fcbd449/uploads/origins/4d2b4a37-0f1d-4ae8-98e7-b74d37d2e85f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a11239bdcf252092936a79e79ae98b7f, https://si.imgix.net/8fcbd449/uploads/origins/4d2b4a37-0f1d-4ae8-98e7-b74d37d2e85f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e09ba31d3c043bea52dfc1789817ff16 2x, https://si.imgix.net/8fcbd449/uploads/origins/4d2b4a37-0f1d-4ae8-98e7-b74d37d2e85f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=mi