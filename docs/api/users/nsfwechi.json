t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=067cb710caff7247674d88297b33b940 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/29", "thumbnail_src": "https://si.imgix.net/477b77b9/uploads/origins/ddcb832b-4a1e-4cd6-a769-44180dec5c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e29c0a7089281d892e0fc1187fbbfdb", "thumbnail_srcset": "https://si.imgix.net/477b77b9/uploads/origins/ddcb832b-4a1e-4cd6-a769-44180dec5c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e29c0a7089281d892e0fc1187fbbfdb, https://si.imgix.net/477b77b9/uploads/origins/ddcb832b-4a1e-4cd6-a769-44180dec5c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=598268b769f5c6553dc5265a1c637b5d 2x, https://si.imgix.net/477b77b9/uploads/origins/ddcb832b-4a1e-4cd6-a769-44180dec5c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b800c107492eae40d4cfe00f06fd0ec6 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/28", "thumbnail_src": "https://si.imgix.net/833a4f5b/uploads/origins/bde79390-444b-418d-830c-d28deb3bc8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3ff408d3e59082b4ff3c2563c6c7b2", "thumbnail_srcset": "https://si.imgix.net/833a4f5b/uploads/origins/bde79390-444b-418d-830c-d28deb3bc8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3ff408d3e59082b4ff3c2563c6c7b2, https://si.imgix.net/833a4f5b/uploads/origins/bde79390-444b-418d-830c-d28deb3bc8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55533cbb27561c2a92fbcd7e3024c75f 2x, https://si.imgix.net/833a4f5b/uploads/origins/bde79390-444b-418d-830c-d28deb3bc8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76e8433231e156cde54e2f4e3b71ed44 3x", "genre": "comic", "nsfw": true, "body": "こんにちは。いめん様の作品、いつも楽しく拝見させていただいております。早速ではございますが、自慰による失禁をテーマとした漫画をリクエストさせていただきます。登場人物はオリジナルキャラクターで30代前半の独身女性、ゴールドブラウンのロングヘアで穏やかな顔をしています。服装はクリーム色のリブ編み半袖ニット・ベージュ色のロング丈タイトスカート・黒色のパンプスです。シチュエーションとしては、『高校教師で文芸部の顧問を担当している主人公の女性（仮に鶴嶋さき・さきちゃん先生とする。）は放課後の部活動でビブリオバトルをするための準備で時間がかかるため、部員たちに図書室などで10分ほど自由時間を送ってから再度教室に集まるように言う。教室で準備のため机を動かしたときに、たまたま机の角が股間に当たってしまう。最近ご無沙汰だったこともあり、その感触でスイッチが入ってしまい、気づけばタイトスカート越しに角に擦りつける。夢中で擦りつけるうちに絶頂を迎える。イクと同時に尿道は緩み、「あっ…」と思ったときにはとっくに”じょ～っ”と勢いよくおしっこが放出される。おしっこは下着を突き抜け、スカートに固い音を響かせながら当たっていく。股間を角の食い込ませたままの体勢で失禁したため、おしっこはスカートの前面にこれでもかと染み込んでいき、ベージュ色のロングスカートに隠し切れないほど、扇状の染みを作る。「やばい…こんなのどうすれば…」といった感じでスカートに広がる染みをどうしようかと焦っているのもつかの間、「「ガラガラガラッ！」という音とともに扉が開き、そこには図書室から帰ってきた生徒たちが—。』といったストーリーです。メインとしては角オナによる失禁とそのあとの恥ずかしい格好で生徒に見つかるところなので、それより前は前置きで省略していただいても、セリフによる説明だけでも十分です。喘ぎ声や吐息のセリフ、さらにはスカートの生地が机に擦れる音、おしっこがスカートに当たる音や失禁の後に机に股間を食い込ませた時の感触などを表現するオノマトペもあればうれしいです。要望が多くなってしまいましたが、よければお受けしていただければ幸いです。何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/27", "thumbnail_src": "https://si.imgix.net/9200a626/uploads/origins/dbb9fa56-dea1-4269-8f66-5ccf6fadc04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d25e632d812032a858ce29bb03f3bab", "thumbnail_srcset": "https://si.imgix.net/9200a626/uploads/origins/dbb9fa56-dea1-4269-8f66-5ccf6fadc04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d25e632d812032a858ce29bb03f3bab, https://si.imgix.net/9200a626/uploads/origins/dbb9fa56-dea1-4269-8f66-5ccf6fadc04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31de5beccbaf942a73fd5598d947a181 2x, https://si.imgix.net/9200a626/uploads/origins/dbb9fa56-dea1-4269-8f66-5ccf6fadc04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7abe7f6adbd77a498e3f223d3c826442 3x", "genre": "comic", "nsfw": true, "body": "またまたリクエストさせていただきます。\n\n逆バニー衣装で接客してくれるエッチなbarの様なお店で接客する女の子を描いていただきたいです。\nいつも同じ様なリクエストで申し訳ないのですが、今回も逆バニー衣装で、股間部分を隠している前貼りがバイブとクリ吸引機が一体型になっているおもちゃになっている前貼りを仕込んでいる感じで、前貼りが外れない様にする為に、絶頂や潮吹きを我慢しなければならない設定でお願いします。\n\n描いてほしいシーンとしては\nおもちゃを仕込みながら接客やテーブルの片付け等をしている感じで描いてほしいです。\n上記のシチュエーションでバイブ-クリ吸引の強さが\n・弱-弱\n・中-弱\n・強-弱\n・中-中\n・強-中\n・強-強\nの6つのシーンを描いていただきたく、最終的に潮吹きしてしまう感じでお願いしたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/26", "thumbnail_src": "https://si.imgix.net/c1e5263c/uploads/origins/c0f27573-83d0-44bd-824e-15aead1004ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d50af00f11acff960a115383deb0f455", "thumbnail_srcset": "https://si.imgix.net/c1e5263c/uploads/origins/c0f27573-83d0-44bd-824e-15aead1004ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d50af00f11acff960a115383deb0f455, https://si.imgix.net/c1e5263c/uploads/origins/c0f27573-83d0-44bd-824e-15aead1004ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=905689232ebbca714bdf4a1559b2d6e4 2x, https://si.imgix.net/c1e5263c/uploads/origins/c0f27573-83d0-44bd-824e-15aead1004ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7ea215bf49a6d7b59a7f1e8e8d5737e 3x", "genre": "art", "nsfw": true, "body": "続けてリクエストを送ります。\n前回リクエストさせていただいたイラスト【https://skeb.jp/@nsfwechi/works/24】の続きで\nWiiFitトレーナーのお尻が見たいので、お尻アップのイラストをお願いします。\n\nトレーニングに紛れて誘惑してるような感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/25", "thumbnail_src": "https://si.imgix.net/1ffa54d5/uploads/origins/d480f3d3-9914-496c-afd4-edc790f8b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8780b70521bd70448da4895e086fc0c", "thumbnail_srcset": "https://si.imgix.net/1ffa54d5/uploads/origins/d480f3d3-9914-496c-afd4-edc790f8b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8780b70521bd70448da4895e086fc0c, https://si.imgix.net/1ffa54d5/uploads/origins/d480f3d3-9914-496c-afd4-edc790f8b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2593159d1259d6be6c6eb8cd7de6610 2x, https://si.imgix.net/1ffa54d5/uploads/origins/d480f3d3-9914-496c-afd4-edc790f8b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03f5269ef3a2583875135cfcca2aa37c 3x", "genre": "comic", "nsfw": true, "body": "またまたリクエストさせていただきます。\n前回のイラスト、お姉さん感がすごくてとても満足しました。\n最近人妻物の物にハマっているので、人妻の漫画orCG集的なものをお願いします。\n\nキャラクター\n以前描かれていた下記URLの様なお姉さんでお願いします。\n服装はジーパンで上はお任せ、パンツはフルバックタイプでお願いします。\nhttps://www.pixiv.net/artworks/123723861\n髪型は人妻感のあるサイドテールの下で結んであるタイプか、お団子ヘアー、URLの様な髪型の誰かでお願いします。\n\n設定\n結婚しているが性欲が強く、旦那の主張中or結婚生活が上手く行っていない感じの設定で、旦那が家にいない時は毎日オナニーして発散しているレベルで性欲が強い設定でお願いします。\n以前描かれていたこちらhttps://www.pixiv.net/artworks/123204328の様な感じで、Mっ気有りの求められると断れない性格でお願いします。\n\nシチュエーション\n上記の設定で、ママ友等に紹介されて暇つぶしで始めた家事代行のアルバイトで若い男の家に行くことになり、日々性欲が溜まっていって...\nみたいな感じでお願いします。\n\n描いてほしい内容\n\n・アルバイト中家主が会社に忘れ物したことに気づく等で、家を出た後にゴミ箱を片づけようとし、中のオナティシュを発見\n・気にしない様にしようとするが、ニオイが漂ってきてしまい、スイッチが入ってしまう\n・オナティシュを嗅ぎながら机の角で角オナ(着衣でぐりぐりお股を角に押し付けているところを詳しく3段階描いてほしい)\n・絶頂\n・満足できず、ジーパンの社会の窓を開け、手を突っ込みオナニー\n・絶頂しそうになっているところでいつの間にか帰ってきた家主にオナバレ\n・必死に言い訳をする\n\nといった感じでお願いしたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/24", "thumbnail_src": "https://si.imgix.net/178be57d/uploads/origins/2ec97357-aa5c-4116-90c1-737916f7dc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f3395ef76de1641b1c91f8ebf87d0f", "thumbnail_srcset": "https://si.imgix.net/178be57d/uploads/origins/2ec97357-aa5c-4116-90c1-737916f7dc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f3395ef76de1641b1c91f8ebf87d0f, https://si.imgix.net/178be57d/uploads/origins/2ec97357-aa5c-4116-90c1-737916f7dc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b08892a78aabca413543df86e916372 2x, https://si.imgix.net/178be57d/uploads/origins/2ec97357-aa5c-4116-90c1-737916f7dc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff0c83af29a91ff1f95632884897f357 3x", "genre": "comic", "nsfw": true, "body": "またまたリクエストさせていただきます。\n前回のWiiFitトレーナーのイラスト、ありがとうございました。\n今回は前回の続きのイラストで前回、バイブを押し込んで絶頂してしまったが、セリフでもあった通り、「気にせず続けて」いるイラストをお願いします。\n前回と同じ感じこ構成で、今回は気にせずトレーニングを続けようとするが、だんだん気持ちいいのが隠せなくなっていくWiiFitトレーナーちゃんが見たいです。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/23", "thumbnail_src": "https://si.imgix.net/143b7111/uploads/origins/87110155-3eff-4633-a9ff-6b896e6f7ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ffb747bfa92550418c68a63a327f63", "thumbnail_srcset": "https://si.imgix.net/143b7111/uploads/origins/87110155-3eff-4633-a9ff-6b896e6f7ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ffb747bfa92550418c68a63a327f63, https://si.imgix.net/143b7111/uploads/origins/87110155-3eff-4633-a9ff-6b896e6f7ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6330da2c7c995412ff2a90ff843e598 2x, https://si.imgix.net/143b7111/uploads/origins/87110155-3eff-4633-a9ff-6b896e6f7ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a141004a3885bdef6c62c5b351f8c09b 3x", "genre": "art", "nsfw": true, "body": "またまたリクエストさせていただきます。\nユーザーのやる気を上げる為にWiiFitトレーナーがバイブを仕込んだ状態でゲームの様にヨガのインストラクターをしている漫画orイラストをお願いします。\n服装は着衣で、トレーニングウェアのズボンの中にバイブを仕込んで固定している感じでお願いします。\n\n\n描いていただきたい内容としては\n・戦士のポーズ2\n・鳩のポーズ\n・I字バランス\nの3つのポーズをバイブを入れたままやっているイラストを描いていただきたいです。\nポーズの順番は任せますが、徐々に感じていって最後には潮吹き絶頂しながらも一緒にポーズを取ってくれる流れでお願いします。\n\nまた、ポーズによって細かく描いていただきたいところがあり\n・戦士のポーズ2ではバイブから愛液が滴り落ち、床に水たまりを作っている\n・鳩のポーズではバイブが床に押し付けられ、奥まで刺さり、下腹部にバイブが浮き出ている\n・I字バランスではバイブが刺さっている部分がビチャビチャになっており、股間周りがムワっとしている\nといった感じでお願いしたく、いずれも汗と愛液は多めでお願いします。\n\nまた、ゲームの様な感じのセリフorナレーションを入れて欲しくて、トレーナーは常に笑顔で快感を我慢しながら、一緒にトレーニングしてくれている感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/22", "thumbnail_src": "https://si.imgix.net/13c63256/uploads/origins/a71484b6-c600-499d-84d8-f5b5d2da4e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d979bc94816cce16730a34d7b923e7", "thumbnail_srcset": "https://si.imgix.net/13c63256/uploads/origins/a71484b6-c600-499d-84d8-f5b5d2da4e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d979bc94816cce16730a34d7b923e7, https://si.imgix.net/13c63256/uploads/origins/a71484b6-c600-499d-84d8-f5b5d2da4e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37466fb823a54bac002c15112df70c26 2x, https://si.imgix.net/13c63256/uploads/origins/a71484b6-c600-499d-84d8-f5b5d2da4e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94ea2da989720b134ff336f300a12ac5 3x", "genre": "comic", "nsfw": true, "body": "【女怪人セレカ】をさらにお願いします！\n\n若い少年ヒーローのライダーキックで吹っ飛んだ後、なんコマも使ってもがき苦しんだり撒き散らしまくった後、ヒーローの生意気でかっこいい決めポーズの背後で爆発！！おっぱいやら鎌やら触手やら体のパーツをべちゃべちゃ撒き散らしながら爆散させちゃってください！あと、少し作業量が多いですが、女怪人と、ヒーローと、前回のヒロインの立ち絵のようなものと、じきたりすさんの思う各キャラの軽い説明文とかも欲しいです…すこし長いリクエストになってしまいますがぜひよろしくお願いします！\n\nhttps://drive.google.com/file/d/14U3At5gSdp2uJsrFaB6jR8D8enlw__P1/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/21", "thumbnail_src": "https://si.imgix.net/68124203/uploads/origins/2e8475e0-f037-485a-b1b7-bcd7510e3aff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5c67a63514caea606fcae766b286732", "thumbnail_srcset": "https://si.imgix.net/68124203/uploads/origins/2e8475e0-f037-485a-b1b7-bcd7510e3aff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5c67a63514caea606fcae766b286732, https://si.imgix.net/68124203/uploads/origins/2e8475e0-f037-485a-b1b7-bcd7510e3aff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a2c44136118fd709bb3e16930d9009a 2x, https://si.imgix.net/68124203/uploads/origins/2e8475e0-f037-485a-b1b7-bcd7510e3aff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ca4d8b895f1d3a076ac2a340e3311b5 3x", "genre": "art", "nsfw": true, "body": "【女怪人セレカ】をまたお願いします！\n\n前回のように撒き散らしまくりながら倒されるシーンで、今度は若い少年ヒーローのライダーキックでド派手に下品に倒しちゃってほしいです！！\n\nhttps://drive.google.com/file/d/14U3At5gSdp2uJsrFaB6jR8D8enlw__P1/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/20", "thumbnail_src": "https://si.imgix.net/aa21e1ae/uploads/origins/8de999c7-a200-49c5-9cba-ece09aa1cb68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd01cd9e5e7f22fef3aa723e37f70612", "thumbnail_srcset": "https://si.imgix.net/aa21e1ae/uploads/origins/8de999c7-a200-49c5-9cba-ece09aa1cb68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd01cd9e5e7f22fef3aa723e37f70612, https://si.imgix.net/aa21e1ae/uploads/origins/8de999c7-a200-49c5-9cba-ece09aa1cb68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd6c7d88bf7550b30a91f823b499bdc1 2x, https://si.imgix.net/aa21e1ae/uploads/origins/8de999c7-a200-49c5-9cba-ece09aa1cb68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee21defd351c60d1c2f817ba315cc8ae 3x", "genre": "comic", "nsfw": true, "body": "またまたリクエストさせていただきます。\n前回リクエストさせていただいた音無小鳥さんのイラストが素晴らしかったので今回は前回の続きのようなイラストor漫画で、犯すためにトイレに向かう途中の廊下で、スイッチを再び入れられる感じの内容でお願いします。\n描いていただきたいのは\n・廊下を歩いている途中（トイレの手前）人が前から向かってくる時ににスイッチON\n・立ったまま耐える（すれ違いざまに挨拶等）\n・人が通り過ぎてもスイッチを切ってくれるず、壁に手をつき前屈みになりながらトイレに向かおうとする\n・耐えきれず潮吹き絶頂（出来ればお尻側アップでお漏らししたような感じで）\n\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/19", "thumbnail_src": "https://si.imgix.net/51f4ca15/uploads/origins/f5ef616f-6cfa-4121-97fd-fce0b44da013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5588cafba3f8722f421ed8084b539ce", "thumbnail_srcset": "https://si.imgix.net/51f4ca15/uploads/origins/f5ef616f-6cfa-4121-97fd-fce0b44da013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5588cafba3f8722f421ed8084b539ce, https://si.imgix.net/51f4ca15/uploads/origins/f5ef616f-6cfa-4121-97fd-fce0b44da013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9df321189d37657b759e18167d9003d0 2x, https://si.imgix.net/51f4ca15/uploads/origins/f5ef616f-6cfa-4121-97fd-fce0b44da013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6e72fbc73402cdbbed93f9ec568d077 3x", "genre": "comic", "nsfw": true, "body": "前回のコミック最高でした！そこで改めて依頼したいのですが\n\n改造を受けて怪人になった直後（立ち絵風）\n\n怪人としての日常（お好きな展開）\n\nヒロインとの遭遇（相手がただの小娘だと思って自信満々）\n\nピンチ！！（漏らしまくり）\n\nの４シーンを滑稽に下品に描いてほしいです！！！\nそして最初のリクエストの爆死シーンに繋がるような！！\nすこし作業量の多いコミックになってしましまいますがぜひお願いします！！\n\nhttps://drive.google.com/file/d/14U3At5gSdp2uJsrFaB6jR8D8enlw__P1/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/18", "thumbnail_src": "https://si.imgix.net/5dbceeb7/uploads/origins/19273826-1cc8-4590-b09c-4a725e7f5c6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea27d008c625352d3b79adfe5bf0b37", "thumbnail_srcset": "https://si.imgix.net/5dbceeb7/uploads/origins/19273826-1cc8-4590-b09c-4a725e7f5c6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea27d008c625352d3b79adfe5bf0b37, https://si.imgix.net/5dbceeb7/uploads/origins/19273826-1cc8-4590-b09c-4a725e7f5c6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=539cd973517b3695ba3799a54a06c728 2x, https://si.imgix.net/5dbceeb7/uploads/origins/19273826-1cc8-4590-b09c-4a725e7f5c6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2645852016f69f46578654dd8fef373 3x", "genre": "comic", "nsfw": true, "body": "はじめまして！少しニッチなリクエストなのですが\n私の推しキャラである\n悪の組織に所属するカマキリ雑魚怪人、【女怪人セレカ】のコミックをお願いします！\n\n全裸で全身がガサガサとした茶色の肌で覆われ、ボディペイントにくわえて、口や尻穴からはみ出た触手が特徴の醜いカマキリ怪人で、両手の鎌を武器にしていますがその見た目とは裏腹に、戦闘ではあまり強くありません！\n\nそんな怪人がイラストの手前から放たれたヒロインの必殺技を受けて母乳やらおしっこやら愛液やら撒き散らしながら滑稽に爆散しちゃうようなイラストをお願いします！滑稽なポーズで腰をヘコヘコさせながらド派手にやっつけてくれると嬉しいです！！\n\n興奮したり攻撃時に口の触手や乳首の部分から溶解液のようなものを撒き散らすので、とにかく下品な最後を飾らせてくださいネ！\n\n資料添付致しましたのでぜひご確認ください！\n\nhttps://drive.google.com/file/d/14U3At5gSdp2uJsrFaB6jR8D8enlw__P1/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/17", "thumbnail_src": "https://si.imgix.net/6051f88f/uploads/origins/4cf79791-d7b8-4165-88c9-9adb358620ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42c37e7869dc8e598db0a829385a3f2", "thumbnail_srcset": "https://si.imgix.net/6051f88f/uploads/origins/4cf79791-d7b8-4165-88c9-9adb358620ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42c37e7869dc8e598db0a829385a3f2, https://si.imgix.net/6051f88f/uploads/origins/4cf79791-d7b8-4165-88c9-9adb358620ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=514420d960ab4354a7fb46511aba64e2 2x, https://si.imgix.net/6051f88f/uploads/origins/4cf79791-d7b8-4165-88c9-9adb358620ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=530d56818329ba2acd6a84a24736c194 3x", "genre": "comic", "nsfw": true, "body": "初めまして、リクエストをよろしくお願いいたします。\n\nイラストのキャラクターはドルフロのDSR-50です。\n間もなくハロウィンが来ますので、彼女も一員としてパーティーを参考します。\nですがいたずらをしたい指揮官は先日任務のミスとゆう理由として罰を与えます。\n罰の内容は衣装やおもちゃを指定され、そのままでパーティーを参考します。\n\n衣装は下のURLに参考させてください。\n中にはシースルー生地のパンツを着けるだけ。\n\n乳首の左右にローターを挟み、リモコン側はパンツに固定し、まんこにバイブと多数のローターを入れて、リモコン側もパンツに固定する。\nローターやリモコン側とバイブは光っているし、闇には巨大な笑顔で見えます。\n彼女は愛液をドロドロにしたのままで歩きます。\nよろしければ、布地を透視で彼女の生身の差分も描くしらければ嬉しいです。\n\nご検討宜しくお願い致します。\n\nhttps://x.com/nago_purin/status/1844301851946037459", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/16", "thumbnail_src": "https://si.imgix.net/06bd8ff9/uploads/origins/fe8fe62b-040b-445c-9cc6-fb20d45f8f73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7642b213a382be505f56f2775c4f85e4", "thumbnail_srcset": "https://si.imgix.net/06bd8ff9/uploads/origins/fe8fe62b-040b-445c-9cc6-fb20d45f8f73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7642b213a382be505f56f2775c4f85e4, https://si.imgix.net/06bd8ff9/uploads/origins/fe8fe62b-040b-445c-9cc6-fb20d45f8f73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba2a9408e0b74e197ff55bc886986b4b 2x, https://si.imgix.net/06bd8ff9/uploads/origins/fe8fe62b-040b-445c-9cc6-fb20d45f8f73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=598c54c56ec921630f3bf2ea40005139 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/15", "thumbnail_src": "https://si.imgix.net/156d0b66/uploads/origins/dc621fbd-4c96-48e0-810c-edf066300137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=060607515a2428978c9d82c5622fe73f", "thumbnail_srcset": "https://si.imgix.net/156d0b66/uploads/origins/dc621fbd-4c96-48e0-810c-edf066300137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=060607515a2428978c9d82c5622fe73f, https://si.imgix.net/156d0b66/uploads/origins/dc621fbd-4c96-48e0-810c-edf066300137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a18d380fec8ea77f74b1e0738daffd8 2x, https://si.imgix.net/156d0b66/uploads/origins/dc621fbd-4c96-48e0-810c-edf066300137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=048144267f4d4a7d2eacf3afe0eecbdc 3x", "genre": "comic", "nsfw": true, "body": "またまたリクエストさせて頂きます。\n音無小鳥さんのイラストがとても素晴らしかったので、あのイラストの世界観で、プロデューサーの性欲をいつでも発散させれるよう準備しておくという設定で、バイブinパンツの状態で仕事をしている音無さんをお願いします。\n流れはお任せしますが、最終的に愛液でびちゃびちゃになったパンツとバイブを見せながら、以前のイラストのように「一回犯しときます？♡」と誘ってくる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/14", "thumbnail_src": "https://si.imgix.net/b606843f/uploads/origins/30b315c5-33f0-4f99-8d6c-7479844d1c70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c38337072bdd3c49a8e391500417e8", "thumbnail_srcset": "https://si.imgix.net/b606843f/uploads/origins/30b315c5-33f0-4f99-8d6c-7479844d1c70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c38337072bdd3c49a8e391500417e8, https://si.imgix.net/b606843f/uploads/origins/30b315c5-33f0-4f99-8d6c-7479844d1c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f18d85d5eb03de77127aae55a8536c67 2x, https://si.imgix.net/b606843f/uploads/origins/30b315c5-33f0-4f99-8d6c-7479844d1c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff39567f2d70480eec9d70b3f2cf85a3 3x", "genre": "art", "nsfw": true, "body": "ゼンゼロのニコが、ローターを仕込みながら尻をこちらに向けて潮吹き絶頂しているイラストをお願いします。\n服装は着衣、見せつける様な感じの表情で、着衣潮吹きしてる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/13", "thumbnail_src": "https://si.imgix.net/036f2f99/uploads/origins/f74dbe8c-352b-4fa3-a6ed-597683017dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de84187f58eec86ab86c4a283390e4b2", "thumbnail_srcset": "https://si.imgix.net/036f2f99/uploads/origins/f74dbe8c-352b-4fa3-a6ed-597683017dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de84187f58eec86ab86c4a283390e4b2, https://si.imgix.net/036f2f99/uploads/origins/f74dbe8c-352b-4fa3-a6ed-597683017dac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aba94916962fdfb12ae7480976ef4313 2x, https://si.imgix.net/036f2f99/uploads/origins/f74dbe8c-352b-4fa3-a6ed-597683017dac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61f83f794de89dd5e8692bd29a8064a4 3x", "genre": "art", "nsfw": true, "body": "アニポケのサクラギ・コハルちゃんのオナニー依頼させていただきました！ありがとうございました！\n\n描いていただいたイラストが滅茶苦茶よかったので、続きの様な形でローターを入れたまま、指をおまんこにずぼずぼ突っ込んでほしいです！\nじょりじょりの剃り残し陰毛やだらしないデカ乳輪が良く見えると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/12", "thumbnail_src": "https://si.imgix.net/ff42a120/uploads/origins/7ef80db5-8fde-4caa-b16a-6a029075c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2099f9b1140a0f3ba382585270c971", "thumbnail_srcset": "https://si.imgix.net/ff42a120/uploads/origins/7ef80db5-8fde-4caa-b16a-6a029075c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2099f9b1140a0f3ba382585270c971, https://si.imgix.net/ff42a120/uploads/origins/7ef80db5-8fde-4caa-b16a-6a029075c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7137e5d3db06e8642a437bcbd8e67ba 2x, https://si.imgix.net/ff42a120/uploads/origins/7ef80db5-8fde-4caa-b16a-6a029075c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a29323f5ff790a55beba69e381d67284 3x", "genre": "art", "nsfw": true, "body": "じきたりすさんこんにちは！\nアニポケのサクラギ・コハルちゃんのオナニーをもっと描いてください！\n\nカットインでおまんこを弄っているところのアップがあると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/11", "thumbnail_src": "https://si.imgix.net/70027c50/uploads/origins/7aab15ab-4557-42ac-9a98-6f8ea8ef1267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84aae97b2b51c66c28f2bc2a12882a16", "thumbnail_srcset": "https://si.imgix.net/70027c50/uploads/origins/7aab15ab-4557-42ac-9a98-6f8ea8ef1267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84aae97b2b51c66c28f2bc2a12882a16, https://si.imgix.net/70027c50/uploads/origins/7aab15ab-4557-42ac-9a98-6f8ea8ef1267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f0d4510da14d09d6ef94069c4ceaadd 2x, https://si.imgix.net/70027c50/uploads/origins/7aab15ab-4557-42ac-9a98-6f8ea8ef1267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7c6899bda507739065e656234399442 3x", "genre": "art", "nsfw": true, "body": "よろしければ追加でもう一点、お願いさせて頂きます。\n『エターナルメロディ』のティナ・ハーヴェルで\nベッドで大また開いてアヘアヘとハメ狂っている姿をお願い致します。\n汗だく汁だくで嬉し涙など流していると最高です。\n可能であれば、ベッドにお札を散乱させて売春のイメージを強めて頂けますとより嬉しいです。\n\nどうぞ、よろしくお願い致します( ꈍᴗꈍ)\n\nhttps://drive.google.com/file/d/1wARrNWIFjqd3dr6839_DhnhleK6T3RFH/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/10", "thumbnail_src": "https://si.imgix.net/cfefe5ed/uploads/origins/6ed4b448-f5e9-414c-96fc-7669a87c2487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7f3cc8ca7ef4f349d1d264a570fac1", "thumbnail_srcset": "https://si.imgix.net/cfefe5ed/uploads/origins/6ed4b448-f5e9-414c-96fc-7669a87c2487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7f3cc8ca7ef4f349d1d264a570fac1, https://si.imgix.net/cfefe5ed/uploads/origins/6ed4b448-f5e9-414c-96fc-7669a87c2487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a1678f4a06f671cbc136ea4726bb420 2x, https://si.imgix.net/cfefe5ed/uploads/origins/6ed4b448-f5e9-414c-96fc-7669a87c2487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32f2f06b95a0a557d2c365aa07b6461f 3x", "genre": "art", "nsfw": true, "body": "エロティックなイラストに惹かれ、お申し込みさせて頂きます。\n昔のゲーム『エターナルメロディ』より、ティナ・ハーヴェルをお願い致します。\n髪の毛は一部をマフラー状に身体の前を通して背面部でリボン(赤)で結んでいます。\n服装は全裸で、なるべくむちむちとした巨乳・巨尻で\n特にお尻は極力大きく描いて頂けると嬉しいです。\n\nソープランドで売春のアルバイトをさせられているというシチュエーションで\n背面騎乗位でのセックスシーンをお願い致します。\n汗だく汁だくで、気持ち良さそうな表情でお願いできますと幸いです。\n\n参考資料を添付させて頂きます。\nどうぞ、よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1sd-6Ij-XrhrlmZCpm22VucVXwopOmWbm/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/9", "thumbnail_src": "https://si.imgix.net/362bd291/uploads/origins/27ed04bc-f847-485e-b388-721cfd111bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d889201a560dbd04018df28ddb845550", "thumbnail_srcset": "https://si.imgix.net/362bd291/uploads/origins/27ed04bc-f847-485e-b388-721cfd111bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d889201a560dbd04018df28ddb845550, https://si.imgix.net/362bd291/uploads/origins/27ed04bc-f847-485e-b388-721cfd111bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=239e5d2dc018b9f751b8865e5dc3e84f 2x, https://si.imgix.net/362bd291/uploads/origins/27ed04bc-f847-485e-b388-721cfd111bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f74593971b8c6ae3e400317dcd0d535 3x", "genre": "art", "nsfw": false, "body": "わんだふるぷりきゅあ！　こむぎ(犬形態)", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/8", "thumbnail_src": "https://si.imgix.net/3b38e0fa/uploads/origins/a853d789-8127-4290-88f1-39bea039fd86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4efcd9b5b9782103ec20ccb6c708cc27", "thumbnail_srcset": "https://si.imgix.net/3b38e0fa/uploads/origins/a853d789-8127-4290-88f1-39bea039fd86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4efcd9b5b9782103ec20ccb6c708cc27, https://si.imgix.net/3b38e0fa/uploads/origins/a853d789-8127-4290-88f1-39bea039fd86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c74da71ebd8bfe20a30131d12fef293 2x, https://si.imgix.net/3b38e0fa/uploads/origins/a853d789-8127-4290-88f1-39bea039fd86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91a38f4e2d001c9d65ef8d3e9f864869 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/7", "thumbnail_src": "https://si.imgix.net/6f11f516/uploads/origins/534ff270-484b-4259-9ee3-0cf58fa882a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabc353be162d5ea2fafa90c54577126", "thumbnail_srcset": "https://si.imgix.net/6f11f516/uploads/origins/534ff270-484b-4259-9ee3-0cf58fa882a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabc353be162d5ea2fafa90c54577126, https://si.imgix.net/6f11f516/uploads/origins/534ff270-484b-4259-9ee3-0cf58fa882a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=530f58be1ee4b9fc75b68c16818041d5 2x, https://si.imgix.net/6f11f516/uploads/origins/534ff270-484b-4259-9ee3-0cf58fa882a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=345f35d4a9e1b69d7aec1695b83b32e0 3x", "genre": "art", "nsfw": true, "body": "遊戯王OCGの守護天使ジャンヌと一対一ボテ腹中出しエッチ\nhttps://www.pixiv.net/artworks/22142996\nカラーイラスト\n\nイメージ\nhttps://www.pixiv.net/artworks/114420326\nhttps://www.pixiv.net/artworks/105605725\nhttps://www.pixiv.net/artworks/104346918\n顔、おっぱい、お腹、結合部が見える物でおまかせ\n結合部から精液溢れる、びゅーっと中出しの瞬間\nおしっこお漏らし\nボテ腹は大きい、臨月のお腹\nhttps://www.pixiv.net/artworks/32309816\n妊娠しているので母乳出る、黒乳首\n\n守護天使ジャンヌ\n天使の輪っかがあり光の翼がある\n\n表情イメージ\nhttps://www.pixiv.net/artworks/22142996\n目は閉じない\n\nセリフを入れる場合は無しもお願いします\n\n：ラブな感じ\n：男の顔は見えず誰か分からない、相手は人間\n：修正は精液や黒線などモザイク以外\n：紐づけ以外のツイッターに投稿許可願います\n：真っ白だと寂しいので流用やグラデーションなど背景\n：難しい場合キャンセル願います", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/6", "thumbnail_src": "https://si.imgix.net/389b3416/uploads/origins/4acc87bc-f0c3-488e-9fb4-6d27f4edbb93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13fef7403fcdb4dffa75d7d763f280f4", "thumbnail_srcset": "https://si.imgix.net/389b3416/uploads/origins/4acc87bc-f0c3-488e-9fb4-6d27f4edbb93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13fef7403fcdb4dffa75d7d763f280f4, https://si.imgix.net/389b3416/uploads/origins/4acc87bc-f0c3-488e-9fb4-6d27f4edbb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02141a52bcd4e171217e166cc481f9f7 2x, https://si.imgix.net/389b3416/uploads/origins/4acc87bc-f0c3-488e-9fb4-6d27f4edbb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37c0fdbb5490a26657ccd78f69806015 3x", "genre": "art", "nsfw": true, "body": "またまたリクエスト失礼します。\n前回のスイレンママのイラストが非常に良かったので、前回の引き続きの様なイラストをお願いします。\n描いて頂きたいのは\n・前回の続きで、ローターを強められたまま平然と我慢しようとする→やっぱり耐え切れずに感じでしまう→モジモジしながら耐えようとするが「プシッ」「プシッ」と小刻みに絶頂してしまう→スカートが濡れるくらい大きく絶頂潮吹きしてしまう\n・スカートをたくし上げて中を見せる\n\n以上のイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/5", "thumbnail_src": "https://si.imgix.net/39784842/uploads/origins/3eba76d5-1e7d-4747-8046-5a8ceab4a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1157fd838bc29fb95ecba42c517214", "thumbnail_srcset": "https://si.imgix.net/39784842/uploads/origins/3eba76d5-1e7d-4747-8046-5a8ceab4a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1157fd838bc29fb95ecba42c517214, https://si.imgix.net/39784842/uploads/origins/3eba76d5-1e7d-4747-8046-5a8ceab4a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c1e9ef0311a2bb7b8aa55bdf03edf89 2x, https://si.imgix.net/39784842/uploads/origins/3eba76d5-1e7d-4747-8046-5a8ceab4a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8654cb9d7e2b695c124dfe3d57aa91e 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエスト失礼します。\nバイブinパンツの状態で快感を我慢しながら平然を装っているスイレンママをお願いします。\n出来ればでいいのですが、我慢～絶頂してしまうまでの差分等も書いていただけると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@nsfwechi/works/4", "thumbnail_src": "https://si.imgix