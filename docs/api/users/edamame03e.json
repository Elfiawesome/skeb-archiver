90-abc09fc7159a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ab99c21300407d7ae877f0ac60b0270, https://si.imgix.net/6d50f664/uploads/origins/0ea15403-d631-4742-af90-abc09fc7159a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58d2caf455da0cce1ee0f4cb003537eb 2x, https://si.imgix.net/6d50f664/uploads/origins/0ea15403-d631-4742-af90-abc09fc7159a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68c09f1af7ef61a222b5a781ddb20219 3x", "genre": "art", "nsfw": false, "body": "前回は素敵な山羊タウル族のお姉さんをデザインしていただき、ありがとうございました\nとてもよかったので、再び同様の依頼を送らせていただきます\n\n以下のイメージから女の子のキャラクターデザインをお願いします。\n\nイメージ \n\nジト目で垂れ目\n髪が長く、前髪も目にかかるくらい\n隠キャ、あるいは少し暗い性格。物事をはっきりと言えない。\n人の形の耳。アクセサリーは山羊タウル族の子と似た意匠の物で、それ以外にはつけていません。\nアラクネの血を引いていて下半身が蜘蛛に変身できる。しかしそのことでいじめられたことがあるので、世間的には隠して生活している。\n 服は女性的なラインのワンピースを基本として好きにデザインしてください。胸のサイズは大きめで。\n差分やレイヤーの分割なども前回と同様にお願いします。\n よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@edamame03e/works/15", "thumbnail_src": "https://si.imgix.net/826e3571/uploads/origins/ed32c692-fb47-4ac4-b3f0-883d84f5b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de8e9569fc67d02e17fb3dde4e1efd18", "thumbnail_srcset": "https://si.imgix.net/826e3571/uploads/origins/ed32c692-fb47-4ac4-b3f0-883d84f5b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de8e9569fc67d02e17fb3dde4e1efd18, https://si.imgix.net/826e3571/uploads/origins/ed32c692-fb47-4ac4-b3f0-883d84f5b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fb430fe80a51520c37eac9ae7e3b61e 2x, https://si.imgix.net/826e3571/uploads/origins/ed32c692-fb47-4ac4-b3f0-883d84f5b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=753cb599be2ea0ec77f1383aa9dad410 3x", "genre": "art", "nsfw": false, "body": "はじめまして！大人向けの活動をしております、Vtuberの明里と申します。\nSkebでお見かけして是非ともイラストをお願いできないかと思ってリクエストしました。\nぜひぶち様のタッチで明里を描いていただきたいです。\nお受けいただいた場合、イラストはTwit