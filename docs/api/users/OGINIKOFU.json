96-4056-bada-69c5b89d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cd3bfbf33a021bc42acd2a16e7a27c7 2x, https://si.imgix.net/47c1a6ef/uploads/origins/9e3c0e2c-ae96-4056-bada-69c5b89d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e81b6ab60b36eb15304e494631771ae5 3x", "genre": "art", "nsfw": false, "body": "いつも心から応援しております。\n此度は私の字創作に登場するキャラクターをご依頼したくご連絡差し上げました。\nつきましては下記のようなキャラを作成願えますでしょうか？\n\n・13歳のドラゴンショタ\n・赤と黒がイメージカラーで差し色に金やオレンジのような明るい色\n・やんちゃな見た目\n・ボロボロの服でトップはお腹周りが破れている\n・設定上残っている身体や頬の古傷\n・頬に白い絆創膏\n\n以上となります。\nご多忙な中難しい内容なのは重々承知ではございますが何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@OGINIKOFU/works/14", "thumbnail_src": "https://si.imgix.net/ce0bfc5f/uploads/origins/b06eee5e-bd30-43f0-baf8-f0f32713d1af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb8035eea9b59e6a5edcc61bb70b0a3b", "thumbnail_srcset": "https://si.imgix.net/ce0bfc5f/uploads/origins/b06eee5e-bd30-43f0-baf8-f0f32713d1af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb8035eea9b59e6a5edcc61bb70b0a3b, https://si.imgix.net/ce0bfc5f/uploads/origins/b06eee5e-bd30-43f0-baf8-f0f32713d1af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da70bf166b19abd18c295e4cb42b35a3 2x, https://si.imgix.net/ce0bfc5f/uploads/origins/b06eee5e-bd30-43f0-baf8-f0f32713d1af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=478957d199d41e028fe349952b50b307 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OGINIKOF