ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18bf97e0b9b27194c4bd79cbf4feee66", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、二人の男の子を描いてくれませんか？彼らはボーイフレンドなので、あなたは一緒にかわいいそれらを描くことができます、彼らは抱きしめたり、手を握っていることができます。どちらでも構いません。うさぎさんはチャラチャラしていて、オオカミさんは恥ずかしがり屋です。\n\nhttps://cdn.discordapp.com/attachments/438185492631126018/739877388640452698/unknown.png", "created_at": "", "completed_at": ""}, {"path": "/@OGINIKOFU/works/3", "thumbnail_src": "https://si.imgix.net/124af58f/requests/73080_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a95361341c742844d1ab362c447813f", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "ジェイスとエイデンが横たわっている、子供パターンが付いた小さめのTシャツ、あなたがタマと共同でよく描く笑顔で私たちに微笑んでいる星空のかわいい下着", "created_at": "", "completed_at": ""}, {"path": "/@OGINIKOFU/works/2", "thumbnail_src": "https://si.imgix.net/05c909e4/requests/34783_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f95387cbc6f0c0d0ecb44c029ad7437", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OGINIKOFU/works/1", "thumbnail_src": "https://si.imgix.net/fc371937/requests/32918_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37692e744cd24ecdf9b8ac27b297911f", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}