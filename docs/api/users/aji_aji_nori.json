fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b7068ae3f588bdaa93b0e74fb9e45a2 3x", "genre": "art", "nsfw": false, "body": "のり先生、一方的にですがいつもお世話になっております\n\nウルフカットに髪を伸ばした杏山カズサさん(バンド)のイラストをお願いします\nただし、胸は絶対に絶対に絶対に絶対に絶対に絶対に盛らないでください、重ね重ね恐縮ですがどうかお願い申し上げます", "created_at": "", "completed_at": ""}, {"path": "/@aji_aji_nori/works/16", "thumbnail_src": "https://si.imgix.net/a06782d9/uploads/origins/726aeb15-4f7b-4a65-b4a1-be581ac48f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3797ecbbf34a4bd18e17ba946ccee6c", "thumbnail_srcset": "https://si.imgix.net/a06782d9/uploads/origins/726aeb15-4f7b-4a65-b4a1-be581ac48f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3797ecbbf34a4bd18e17ba946ccee6c, https://si.imgix.net/a06782d9/uploads/origins/726aeb15-4f7b-4a65-b4a1-be581ac48f95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5190165caf9d5b13c4f4fc381d6d38b3 2x, https://si.imgix.net/a06782d9/uploads/origins/726aeb15-4f7b-4a65-b4a1-be581ac48f95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39b70854e2d5515d53c3b6107195d9b3 3x", "genre": "art", "nsfw": true, "body": "私のキャラクター「黒羽」の絵を描いてほしい。GDriveのリンクに過去の絵を添付しておきます。私のキャラクターの水着姿の絵をお願いしたいです。水着のデザインは、ドライブ内の最初の画像を参考にしてください（MAIN）。また、よろしければ独自の解釈を加えていただいても結構です。一般的な先生キャラなどを追加しても構いません。必要であれば量を増やしてください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1EHzuDK5yN-yh4B5ciZSyNEaU0dtUNlRw", "created_at": "", "completed_at": ""}, {"path": "/@aji_aji_nori/works/15", "thumbnail_src": "https://si.imgix.net/9cf78341/uploads/origins/3238d843-c847-4d1c-9494-bc3e9eff9505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e023f2f5c2cb503f5c71247fc66d3fc", "thumbnail_srcset": "https://si.imgix.net/9cf78341/uploads/origins/3238d843-c847-4d1c-9494-bc3e9eff9505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e023f2f5c2cb503f5c71247fc66d3fc, https://si.imgix.net/9cf78341/uploads/origins/3238d843-c847-4d1c-9494-bc3e9eff9505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b858a145149b03c3f56c1039b8fe0bc6 2x, https://si.imgix.net/9cf78341/uploads/origins/3238d843-c847-4d1c-9494-bc3e9eff9505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0a3c6c1954fb6c6aa855c263d291e36 3x", "genre": "art", "nsfw": false, "body": "はじめまして、いつも応援しています。\n\nブルアカのホシノと、リバースブルー×リバースエンドのハルが仲良くお昼寝してるイラストをお願いしたいです。\n服装はそれぞれのデフォルト衣装で、構図などはおまかせします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aji_aji_nori/works/14", "thumbnail_src": "https://si.imgix.net/192773b7/uploads/origins/ff109fdd-f697-4100-a7a7-8075edbf07f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f32a2b60e37933cd564ce9a1d0a24c2e", "thumbnail_srcset": "https://si.imgix.net/192773b7/uploads/origins/ff109fdd-f697-4100-a7a7-8075edbf07f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f32a2b60e37933cd564ce9a1d0a24c2e, https://si.imgix.net/192773b7/uploads/origins/ff109fdd-f697-4100-a7a7-8075edbf07f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7378c6a49b589724d7dcd79abdd22978 2x, https://si.imgix.net/192773b7/uploads/origins/ff109fdd-f697-4100-a7a7-8075edbf07f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=866d7bd455848110b110c800e93f38e1 3x", "genre": "art", "nsfw": true, "body": "のり先生\nこんにちは！\n\n前回はナースセリナのイラストを描いていただきありがとうございました。\nとても良かったので、もしよければ同様のコンセプトでもう一枚お願いできないでしょうか？\n\n【キャラクター/衣装】\n・聖園ミカ\n＿・通常衣装（トリニティ制服）\n＿・前回と同じく、シンプルな白いロンググローブを追加でお願いします\n＿・左腕のシュシュは手袋の上からつけてください\n\nシチュエーションや構図などは基本的にお任せしますが、腕を上げて腋が見えてる感じのポーズだと嬉しいです（片方だけでも可）\n前回と同じくNSFWをオンにしていますが、イラスト自体に必ずしもR-18表現を含めていただく必要はありません。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aji_aji_nori/works/13", "thumbnail_src": "https://si.imgix.net/6abe2a80/uploads/origins/53af0144-0078-4653-96b9-71564e7ba706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80311a7c97029f49c1e8c64de096a31", "thumbnail_srcset": "https://si.imgix.net/6abe2a80/uploads/origins/53af0144-0078-4653-96b9-71564e7ba706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80311a7c97029f49c1e8c64de096a31, https://si.imgix.net/6abe2a80/uploads/origins/53af0144-0078-4653-96b9-71564e7ba706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be529cfff76c0530d21b3624a074bcca 2x, https://si.imgix.net/6abe2a80/uploads/origins/53af0144-0078-4653-96b9-71564e7ba706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2c21057b180442ae808c7aa7c0a9b14 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイブのキャラを使った\n某有名マンガを原作としたゲームのパロディを依頼させてください\n\n右上か左上に「もういい！ミカマックスを起動する！」と叫ぶセイア\n真ん中には片足でクルセイダーちゃんを踏みつぶして破壊しようとする\n巨大なミカを書いてください\n\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@aji_aji_nori/works/12", "thumbnail_src": "https://si.imgix.net/74abdfe6/uploads/origins/ebeb1d0e-88aa-4773-b89f-bee4d8690ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01732c5a84d83c705e5ea9b44dd9e88d", "thumbnail_srcset": "https://si.imgix.net/74abdfe6/uploads/origins/ebeb1d0e-88aa-4773-b89f-bee4d8690ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01732c5a84d83c705e5ea9b44dd9e88d, https://si.imgix.net/74abdfe6/uploads/origins/ebeb1d0e-88aa-4773-b89f-bee4d8690ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3eca4522d2479ee05ea97b40ef0afb52 2x, https://si.imgix.net/74abdfe6/uploads/origins/ebeb1d0e-88aa-4773-b89f-bee4d8690ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69bb26b29886ee6222831f477fb0df50 3x", "genre": "art", "nsfw": true, "body": "車の運転席でしょんべん漏らしながら左手（手は袖に隠してる）にポケモンドーナツ（ピカチュウ）持って写真撮ってるセイアちゃん\n\n描きたくなければ全然断ってもらって大丈夫です😭", "created_at": "", "completed_at": ""}, {"path": "/@aji_aji_nori/works/11", "thumbnail_src