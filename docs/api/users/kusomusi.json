2a4c5adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a45954809d87f6ee56ce5569a95b7c84, https://si.imgix.net/13c560fa/uploads/origins/dbdcf10e-dc07-4caa-92cf-772d2a4c5adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b42acc93e1891356159c9a875a294d8 2x, https://si.imgix.net/13c560fa/uploads/origins/dbdcf10e-dc07-4caa-92cf-772d2a4c5adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efc37a34a15857458b92b40bd6d0ee34 3x", "genre": "art", "nsfw": true, "body": "初めまして、アピールありがとうございます！\n早速ですが、うちの子2人（男の娘と女の子）で触手姦をリクエスト（NSFW）します。\nシチュエーションですが、\nそれぞれの服は破れて、胸や秘部が見える状態で\nヨルネは口と両穴、ナズナは口とアナルを触手に犯されて、\n最後は触手（とナズナ）の射精と同時に絶頂する内容を希望します。\n※ナズナの竿は普段描いている竿役のサイズよりも一回りくらい小さめで、色白にしてくださ。\n\n他はお任せしますので、ぜひご検討をお願いします。\n\n参考資料 \nナズナ（男の娘）\nhttps://wiki3.jp/yoidukian_hind/page/31\nヨルネ\nhttps://wiki3.jp/yoidukian_hind/page/30", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/124", "thumbnail_src": "https://si.imgix.net/d56a0a0f/uploads/origins/8c6f6d9a-10cd-4eb5-8b83-fb6881891f30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=879457cd4462665754294c0d23e32964", "thumbnail_srcset": "https://si.imgix.net/d56a0a0f/uploads/origins/8c6f6d9a-10cd-4eb5-8b83-fb6881891f30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=879457cd4462665754294c0d23e32964, https://si.imgix.net/d56a0a0f/uploads/origins/8c6f6d9a-10cd-4eb5-8b83-fb6881891f30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a584b82f025393c741a48e6f3b292e9 2x, https://si.imgix.net/d56a0a0f/uploads/origins/8c6f6d9a-10cd-4eb5-8b83-fb6881891f30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=904b6196375da9898cd818a3a062c381 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/123", "thumbnail_src": "https://si.imgix.net/35e5f1f1/uploads/origins/84a10b82-ce73-4619-859f-4be6500fbfbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33a4f46ce332bfd2ae50888e9af66b7", "thumbnail_srcset": "https://si.imgix.net/35e5f1f1/uploads/origins/84a10b82-ce73-4619-859f-4be6500fbfbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33a4f46ce332bfd2ae50888e9af66b7, https://si.imgix.net/35e5f1f1/uploads/origins/84a10b82-ce73-4619-859f-4be6500fbfbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=007e58e7b6c0a85362b6b6327b9f33d7 2x, https://si.imgix.net/35e5f1f1/uploads/origins/84a10b82-ce73-4619-859f-4be6500fbfbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11f17ce6f2abac923589b4c07ed3548c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nあなたの触手アートが大好きです！\n私のバニーガールが触手に拘束されてファックされるところを描いてくれる？メガネをかけたヌードで。\n彼女の体や顔には精液が飛び散っていて、乱雑な感じにしてほしい。\n彼女の表情は興奮して楽しんでいる。\nその他はお任せします。\nありがとうございました！\n\nhttps://drive.google.com/file/d/1RCBT13WzoJKvotoUK4wCl_UxIFcHw9cE/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/122", "thumbnail_src": "https://si.imgix.net/fd160aa5/uploads/origins/a4453794-9dc6-4854-b5b2-2ae0ac3e5d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=466d7f6ade8dc54204544f21c2588531", "thumbnail_srcset": "https://si.imgix.net/fd160aa5/uploads/origins/a4453794-9dc6-4854-b5b2-2ae0ac3e5d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=466d7f6ade8dc54204544f21c2588531, https://si.imgix.net/fd160aa5/uploads/origins/a4453794-9dc6-4854-b5b2-2ae0ac3e5d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77e3851227b315b0937ceafcfdfe6d45 2x, https://si.imgix.net/fd160aa5/uploads/origins/a4453794-9dc6-4854-b5b2-2ae0ac3e5d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a24fa596006c97cddf6e3caced87d997 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ブレイズハートの七瀬桜火(ななせ おうか)のイラストをリクエストしたいです。\n\nシチュエーションとしては制服姿で触手に潜り込まれているものをお願いしたいです。\n制服は所々破れていたり、ニーソにも触手が入り込んでいたり、ツインテールに絡みついているようにもしてほしいです。\n\n桜火の下着はイベントのページで確認できますので参考にしてください。\n\n表情や構図等はおまかせしたいと思います。\n\nよろしくお願いします！\n\nhttp://www.kai-soft.jp/BSH-WEB/bladesheart.html", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/121", "thumbnail_src": "https://si.imgix.net/66c54ad8/uploads/origins/8a976f3f-c845-457f-9329-0b1341d46273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fcb94148d63effb46a3ea4f66f31d0e", "thumbnail_srcset": "https://si.imgix.net/66c54ad8/uploads/origins/8a976f3f-c845-457f-9329-0b1341d46273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fcb94148d63effb46a3ea4f66f31d0e, https://si.imgix.net/66c54ad8/uploads/origins/8a976f3f-c845-457f-9329-0b1341d46273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c6ff86ccf18d679f7013fbb95451515 2x, https://si.imgix.net/66c54ad8/uploads/origins/8a976f3f-c845-457f-9329-0b1341d46273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53f34c206b4c2158632d595458788ae3 3x", "genre": "art", "nsfw": true, "body": "こんにちは、田中芳太郎です、\nあなたのアピールメッセージを拝見し、私のFF14キャラクター、ツナ・タマシイギンの触手関連のアートワークを依頼したいと思います。\n\n以下は彼女の参考資料です：\nhttps://imgur.com/gallery/tsuna-references-0pwZ9Op\nhttps://imgur.com/gallery/tsunas-reference-3-clothes-ZjlLT5e (彼女の服)\n\n-テーマとしては、つなは刑務所の中で触手生物に体を触られている。彼女の捕獲者は、触手クリーチャーを使って、つなを性奴隷として調教している。触手によって、彼女は数日間、ほとんど休むことなくオーガズムを否定され続ける。\n-上半身は乳房を露出させるため、上か下に引っ張られる。少し大きくするのは自由。下の服は破かれ、下半身が丸見えになる。また、彼女のお腹に性奴隷のタトゥーを入れる。\n-どんな触手を使うか、彼女にどんなことをするかは、彼女が挿入されない限り、あなたの好みに任せます。\nご配慮ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/120", "thumbnail_src": "https://si.imgix.net/b1f9660b/uploads/origins/3a74d4e2-b670-4a18-93be-497f2833ae93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea66e60c796ef60dfafce04681ae5bbd", "thumbnail_srcset": "https://si.imgix.net/b1f9660b/uploads/origins/3a74d4e2-b670-4a18-93be-497f2833ae93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea66e60c796ef60dfafce04681ae5bbd, https://si.imgix.net/b1f9660b/uploads/origins/3a74d4e2-b670-4a18-93be-497f2833ae93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35f9d1e11f04258ffe983689244c6614 2x, https://si.imgix.net/b1f9660b/uploads/origins/3a74d4e2-b670-4a18-93be-497f2833ae93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5dbaac19d592d46a588bf49c1d3c2e8 3x", "genre": "art", "nsfw": true, "body": "初めまして。アピールありがとうございます。\n過去にマブラヴの作品を作成しているようなので、外伝にはなりますが\n描いて欲しいイラストがありますのでリクエストします。\n\n[作品名]\nマブラヴ ガールズガーデン\n\n[キャラ名]\nシエナ・クラーク\n\nキャラの見た目の資料は、下記URLのドライブや動画を参照してください。\nhttps://drive.google.com/drive/folders/1fJcoFuijW50z9doTbw8u6hUXfwQjHGhn?usp=drive_link\nhttps://www.youtube.com/watch?v=9j6qO3xWTzU\n\n[シチュエーション]\nコックピット内で無理やり触手に犯される。\n\n[想定している状況]\n色々あってメイズシフター(原生生物の敵)に負け、MG(マブラヴで言うところの戦術機)の\nコックピットを突き破って生えてきた触手に、シエナのマンコとアナルが犯される。\n\n[表情]\n怯えてパニック気味\n\n[補足]\n・体位、構図、細かい部分や服装等についてはお任せします。\n・描いていない部分につきましても、自由で問題ございません。", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/119", "thumbnail_src": "https://si.imgix.net/3ab9b75c/uploads/origins/28798cfe-bcf9-49c1-86c2-2006c478f540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd69ffec7025083527e4a5c387a42d80", "thumbnail_srcset": "https://si.imgix.net/3ab9b75c/uploads/origins/28798cfe-bcf9-49c1-86c2-2006c478f540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd69ffec7025083527e4a5c387a42d80, https://si.imgix.net/3ab9b75c/uploads/origins/28798cfe-bcf9-49c1-86c2-2006c478f540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a731e7accdaac6c95da1343a9ca988b 2x, https://si.imgix.net/3ab9b75c/uploads/origins/28798cfe-bcf9-49c1-86c2-2006c478f540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71fded6c23fba7baa56659e23d50fdb0 3x", "genre": "art", "nsfw": true, "body": "初めまして、アピールありがとうございます。アピール内容にもあった通り、「うちの子」の「七篠成実」の触手姦のイラストをリクエストさせていただきます。\n\n参考　https://wiki3.jp/minominutinoko/page/27\n\n参考その2　https://x.com/minomin7/status/1836709449685176455/photo/2\n※。巫女装束着用時はサラシである程度潰しているので、こちらが本来の胸のサイズになります\n\npixivにて過去作品を拝見させていただきましたが、こちらとしては四肢欠損（肉壁に埋め込まれてる表現はOK）などのR-18G、陰毛表現以外はOKですので、田中よしたろう様が「こういうのを描きたい」という触手姦イラストとして描いていただければと思います。\nそれではご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/118", "thumbnail_src": "https://si.imgix.net/9d811bd0/uploads/origins/7aa7e25e-2af9-4ff2-bcb0-0cc55f8509eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e4bb90f284276d2ca7680966bf71b13", "thumbnail_srcset": "https://si.imgix.net/9d811bd0/uploads/origins/7aa7e25e-2af9-4ff2-bcb0-0cc55f8509eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e4bb90f284276d2ca7680966bf71b13, https://si.imgix.net/9d811bd0/uploads/origins/7aa7e25e-2af9-4ff2-bcb0-0cc55f8509eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=666c78a56b77e2054101d481bdf2cd56 2x, https://si.imgix.net/9d811bd0/uploads/origins/7aa7e25e-2af9-4ff2-bcb0-0cc55f8509eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1f539d0eaefe28cb71859d6f4e61bed 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/117", "thumbnail_src": "https://si.imgix.net/8a6c9cad/uploads/origins/c0ea3353-9aa2-424a-9798-3b8207cef720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e56c3bfcf51fd5b17fef2497f04cf8", "thumbnail_srcset": "https://si.imgix.net/8a6c9cad/uploads/origins/c0ea3353-9aa2-424a-9798-3b8207cef720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e56c3bfcf51fd5b17fef2497f04cf8, https://si.imgix.net/8a6c9cad/uploads/origins/c0ea3353-9aa2-424a-9798-3b8207cef720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bf307bb8bdee9e1193f24be36be3756 2x, https://si.imgix.net/8a6c9cad/uploads/origins/c0ea3353-9aa2-424a-9798-3b8207cef720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba77045a9f0cb2b900f72504a71b5853 3x", "genre": "art", "nsfw": true, "body": "以前描いて頂いた心寿ちゃんのくすぐり絵がとても良かったので、同じシチュで恐縮ですがリクエストを送らせて頂きたいです…！\n\nキャラ\nソーシャルゲーム、魔法使いと黒猫のウィズに登場するローヴィ・フロイセ。\n\n衣装\nアプリ内で登場する黒のビキニタイプの水着。前回と同様に可能であれば、上の水着がはだけている差分があると嬉しいです。\n\n内容\n心寿ちゃんの時みたいに、整体師達にくすぐられてる絵をお願いしたいです。また、可能であれば今回はローヴィをくすぐる整体師の性別を女性の方に変更をお願いしたいです。\n\n（以下は前回のリクエストを送った際の文章となります。）\n\nくすぐり、及びマッサージについては腋の下、脇腹、お腹、胸など上半身を中心に手で責めて頂けると助かります。可能であれば、マッサージということでローションなどが塗られている表現があると嬉しいです。\n\n拘束については整体師の手で抑えつける、枷や縄で拘束する等、描きやすい拘束方法でIの字になるように拘束してください。\n\n表情については両目を瞑って大笑いしているような表情でお願いします。\n\nその他不明瞭な点や描きにくい点などございましたら、作者様が描きやすいように随時変更して頂ければ幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tGjCoX9jEKT6Qo_6oQ_CF3yRsIs_u3LY", "created_at": "", "completed_at": ""}, {"path": "/@kusomusi/works/116", "thumbnail_src": "https://si.imgix.net/39cd8b05/uploads/origins/9e9db823-5523-4b0a-8de2-a32c8167bed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=300e1262bea78858b8b570e9