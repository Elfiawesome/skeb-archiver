=crop&crop=top&w=200&h=200&s=6040f1bc8e48e8041b722600bfccc8a4, https://si.imgix.net/0fed4369/uploads/origins/002e921c-d48b-44a9-9919-338cd00fbe76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed8ada368f91b2e759cabeffff578a81 2x, https://si.imgix.net/0fed4369/uploads/origins/002e921c-d48b-44a9-9919-338cd00fbe76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=452cb294dc69c9d6ed31214c9805700d 3x", "genre": "art", "nsfw": false, "body": "ウェディングフラワーちゃんが来てくれません！セイちゃんのところにお嫁に行っちゃいました！！\n披露宴で、でっかいスプーンでウェディングケーキをあーーんされてるセイちゃんをまゆち先生のお力で見させてください！！", "created_at": "", "completed_at": ""}, {"path": "/@mayuchi427/works/4", "thumbnail_src": "https://si.imgix.net/0d5cfd70/uploads/origins/5e9b2826-16ed-40a2-8e83-0ed69e9b95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ddb50858d29505df03569f47dbf851c", "thumbnail_srcset": "https://si.imgix.net/0d5cfd70/uploads/origins/5e9b2826-16ed-40a2-8e83-0ed69e9b95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ddb50858d29505df03569f47dbf851c, https://si.imgix.net/0d5cfd70/uploads/origins/5e9b2826-16ed-40a2-8e83-0ed69e9b95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6c92cea634b208bc74ea659c1c68746 2x, https://si.imgix.net/0d5cfd70/uploads/origins/5e9b2826-16ed-40a2-8e83-0ed69e9b95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb0c8cc13ada8599a4362afea49ab0ed 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mayuchi427/works/3", "thumbnail_sr