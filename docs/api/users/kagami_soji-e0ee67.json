=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8aa53de844faa36c8c9b1d2bbcc87948 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/15", "thumbnail_src": "https://si.imgix.net/50d5360f/uploads/origins/ba88ab6d-b81c-4ab9-bfa7-49da382c7291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227f263096be18284a7b4041430bbc10", "thumbnail_srcset": "https://si.imgix.net/50d5360f/uploads/origins/ba88ab6d-b81c-4ab9-bfa7-49da382c7291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227f263096be18284a7b4041430bbc10, https://si.imgix.net/50d5360f/uploads/origins/ba88ab6d-b81c-4ab9-bfa7-49da382c7291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a0defad33e8619247dfaa384d8e3d8c 2x, https://si.imgix.net/50d5360f/uploads/origins/ba88ab6d-b81c-4ab9-bfa7-49da382c7291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b04db3de26b85f18d864d066012e3db0 3x", "genre": "art", "nsfw": false, "body": "かがみ そじ様、こんにちは。\nTRPGの自陣絵を描いていただきたく、リクエストさせていただきます。\nボロボロになった末ようやく穏やかな同棲生活を手に入れた２人なので、おうちでのひと時的なイラストをお願いしたいです。\n季節的にお布団でぬくぬくしていたらかわいいなぁと思いますが、そじさんのお好きなように描いていただければ嬉しいです。\n\n簡単な説明と資料を一緒にお送りいたします。\n服装は通過前の物のため、変えていただいて結構です。\n\nよろしくお願いします！\n\nhttps://www.dropbox.com/sh/j5vrd0i1dhdoepn/AACAVNk3Ljpo-b2Avtqs0Z-ba?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/14", "thumbnail_src": "https://si.imgix.net/0341d353/uploads/origins/b79d2797-4548-4576-8206-46893f31433a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5767322616406d102a10adb1ac8774de", "thumbnail_srcset": "https://si.imgix.net/0341d353/uploads/origins/b79d2797-4548-4576-8206-46893f31433a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5767322616406d102a10adb1ac8774de, https://si.imgix.net/0341d353/uploads/origins/b79d2797-4548-4576-8206-46893f31433a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e65524b8e0965abca399629f5f32509a 2x, https://si.imgix.net/0341d353/uploads/origins/b79d2797-4548-4576-8206-46893f31433a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76e127afb7e290eef9366228956bf9ca 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nこのたびはTRPGで遊んでいるキャラクターのコンビをそじさんの絵で是非見たいと思いリクエストさせていただきました。\n\n車で世界中を旅する2人です。よく笑いよく食べよく飲みと楽しく旅をしています。\n作画資料、設定などは以下のフォルダ内にも格納しているのでご一読ください。\nhttps://drive.google.com/drive/folders/1q2El1VDBRW9TgSx43LB62JuMZ3tlQODY\n\n構図、また服装などの指定も特にありませんが、楽しそうな2人が見られたら嬉しいです！\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1q2El1VDBRW9TgSx43LB62JuMZ3tlQODY", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/13", "thumbnail_src": "https://si.imgix.net/46fb91a4/uploads/origins/9f203efa-923a-4b81-bcea-5e4cefe0d126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e9609471c2bb69378dbce341d4ee53", "thumbnail_srcset": "https://si.imgix.net/46fb91a4/uploads/origins/9f203efa-923a-4b81-bcea-5e4cefe0d126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e9609471c2bb69378dbce341d4ee53, https://si.imgix.net/46fb91a4/uploads/origins/9f203efa-923a-4b81-bcea-5e4cefe0d126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41ab9429790488952d8183b499ee7dea 2x, https://si.imgix.net/46fb91a4/uploads/origins/9f203efa-923a-4b81-bcea-5e4cefe0d126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8224a20af5f5f2771cf77e7d417c2111 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつもお世話になっております！\n\nクトゥルフ神話TRPGの探索者たちをそじさんの絵柄でどうしても見てみたく、依頼させてもらいました！！\n下記URLの資料の二人を描いていただきたいです！！構図等は金額の範囲内でおまかせいたします！！\n\n資料があまり多くなく恐縮なのですが、お願いしたいです！！\n補足として、女性キャラクターの方は毛先が少し透けています（肌や背景等がほんのり透けて見えます）\nhttps://www.dropbox.com/sh/owm7e2rn5ut9doh/AAAYmV8i8b5h5-3Tj_vm6PJoa?dl=0\n\n初めての依頼なので何か不手際がありましたら申し訳ございません…！\nよろしくお願いいたします！！！", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/12", "thumbnail_src": "https://si.imgix.net/da1897ae/uploads/origins/eece8b91-1108-4b34-861a-e1a0afc34768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f0b346c3633a1672d5e2cfd336617f", "thumbnail_srcset": "https://si.imgix.net/da1897ae/uploads/origins/eece8b91-1108-4b34-861a-e1a0afc34768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f0b346c3633a1672d5e2cfd336617f, https://si.imgix.net/da1897ae/uploads/origins/eece8b91-1108-4b34-861a-e1a0afc34768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d277919a126ea7e9167bb37cdaf07f03 2x, https://si.imgix.net/da1897ae/uploads/origins/eece8b91-1108-4b34-861a-e1a0afc34768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b09bac8b1cf91fcd10481069265d7cbd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回らぶいぬ兄妹を描いていただいたもろこしと申します！\n先日はとてもステキなイラストをありがとうございました！家宝にしています！！\n\nそじさんのイラストがとても大好きなので今回は都市伝説課の自班を描いていただきたくてリクエストを送らせて頂きました！\n狗モチーフの先輩と猫又モチーフの後輩です！\n資料URLを添付いたしますので詳しいキャラクターデザインなどはそちらでご確認ください。\nイラストの雰囲気や構図はかがみ そじさんにお任せします！\n\nよろしくお願いします！\n\nhttps://www.dropbox.com/sh/dy00vryrtpq5uba/AADmurAMzCUcoGyfh9gzgO4Ta?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/11", "thumbnail_src": "https://si.imgix.net/883060a3/uploads/origins/03992042-2bb9-440f-9878-cb4b5c3e2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=212eec5e1884ce3bd190f1fe80c61527", "thumbnail_srcset": "https://si.imgix.net/883060a3/uploads/origins/03992042-2bb9-440f-9878-cb4b5c3e2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=212eec5e1884ce3bd190f1fe80c61527, https://si.imgix.net/883060a3/uploads/origins/03992042-2bb9-440f-9878-cb4b5c3e2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab57ed3e1c506e62787a9687698fdc19 2x, https://si.imgix.net/883060a3/uploads/origins/03992042-2bb9-440f-9878-cb4b5c3e2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06381f8408ce92d3534ee9aa2a80026a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！！いつもお世話になっております！！！！！！！\n\nソジチャンさんの描く子達が大好きだ！！！！！！！！！！！！！！！！！特に愛嬌のある表情がイキイキしててLOVE！！！！！！！！！！！！！！！！！\nそういう訳で、この度は是非ソジチャンさんのタッチで資料のクトゥルフ神話TRPG探索者のペアイラストを描いていただきたくリクエストさせていただきました。\n\n構図などは金額を加味して可能な範囲でお任せしますが、\n後生ですので、男性キャラよりも女性キャラクターを可愛く描いていただけると嬉しいです。\nキャラクターの顔や全体は描かれていなくても問題ございません。\nまた、描いていただいた後は個人利用としてSNSに掲載させていただく可能性がございます。(掲載時には必ずソジチャンさんのIDを記載するか、作品ページのリンクを使用させていただきます。)\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。\n\nhttps://www.dropbox.com/sh/qm0xg7ym88yoqe0/AAAvgZ8_SV-eaZ_0saaFPYpBa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/10", "thumbnail_src": "https://si.imgix.net/233671ad/uploads/origins/622259c0-b48a-4d00-b56c-10a47d607605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=348d233f47c0da51af9f6cab0c2ab3ac", "thumbnail_srcset": "https://si.imgix.net/233671ad/uploads/origins/622259c0-b48a-4d00-b56c-10a47d607605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=348d233f47c0da51af9f6cab0c2ab3ac, https://si.imgix.net/233671ad/uploads/origins/622259c0-b48a-4d00-b56c-10a47d607605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db3b0aa4f4b3da5f0d0a7e53345a98c0 2x, https://si.imgix.net/233671ad/uploads/origins/622259c0-b48a-4d00-b56c-10a47d607605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=833f9073cfb4a04bad98355be796cdfe 3x", "genre": "art", "nsfw": false, "body": "そじさんこんにちは、いつも大変お世話になっています。\n\nこの度はそじさんにTRPGで使用しているキャラクターを描いていただきたいと思いSkebを頼ませていただきました。\n\nシチュエーションや構図など指定ははないですが、そじさんの色使いが好きなので明るめの配色だととても嬉しいです。\n\nご検討いただけますと幸いです。よろしくお願いします。\n\nhttps://drive.google.com/file/d/1ViOAk-iNt8JuJINvxtuiKhMbTvgjr0oU/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/9", "thumbnail_src": "https://si.imgix.net/ba688606/uploads/origins/aa04c2b7-f12f-4716-9594-64a9e46d9924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daf190ffd06fec698261c2f4ab5ba576", "thumbnail_srcset": "https://si.imgix.net/ba688606/uploads/origins/aa04c2b7-f12f-4716-9594-64a9e46d9924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daf190ffd06fec698261c2f4ab5ba576, https://si.imgix.net/ba688606/uploads/origins/aa04c2b7-f12f-4716-9594-64a9e46d9924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f0d39aac4c99c6a03fccdbcbff7e23e 2x, https://si.imgix.net/ba688606/uploads/origins/aa04c2b7-f12f-4716-9594-64a9e46d9924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4321ec06e3710f9fccd1fb6ba2f3b472 3x", "genre": "art", "nsfw": false, "body": "こんばんは、再びリクエスト失礼します。\n\nファンタジーぽい男性キャラを描いて頂きたいです。\n\n◆男性20代前半あたり(身長180ぐらい)※容姿は人間\n◆髪型\n→セミロング(色は銀髪)　前髪はおろしたままで(ワンポイントで髪留め)\n→角あり(ヒツジぽい感じ)\n◆肌\n→褐色\n◆目の色\n→右目・赤　左目・金のオッドアイ\n◆服装\n→ラフな格好でお任せします。(上半身の露出可)\n両手にリング何個か付けてほしいです(指はどこでも)\n※色は黒をベースにして頂けると嬉しいです。\n◆性格\n→気が強い俺様系\n◆表情\n→悪だくみを考えてるような感じで\n※表情差分で、悪だくみが失敗して少し泣きそうな表情もお願いしたいです。\n\n可能であれば全身でお願いしたいです\n\nそじさんのイメージした感じで自由に描いて頂けたらと思います。\n服装に関してはファンタジー系でも現代系でも〇なのでお任せします\n\nイラストの用途は\n〇個人観賞\n〇他のクリエイター様に依頼する際に参考資料としての使用\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/8", "thumbnail_src": "https://si.imgix.net/78286100/uploads/origins/3bafd97b-89b1-4ba3-88d1-2726d0883dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66fb98a441cfcb538864f9bb3f541c18", "thumbnail_srcset": "https://si.imgix.net/78286100/uploads/origins/3bafd97b-89b1-4ba3-88d1-2726d0883dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66fb98a441cfcb538864f9bb3f541c18, https://si.imgix.net/78286100/uploads/origins/3bafd97b-89b1-4ba3-88d1-2726d0883dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f0fe05cd6c8c07bd669c67464ba4654 2x, https://si.imgix.net/78286100/uploads/origins/3bafd97b-89b1-4ba3-88d1-2726d0883dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b191739c0fcf51b23ca0857b642dbd5e 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nそじさんの絵柄で見てみたいなと思う子たちがおり、リクエストさせていただきました…！\n差し支えなければ、オリジナルキャラクター2人のイラストをお願いできますでしょうか。\n名前と見た目については添付資料をご参照ください。\n\n時代は大正末期頃で、生活を共にしながら持ちつ持たれつ暮らしている日本男児たちです。\n普段から鳴臣くんの方が愛九朗くんに振り回されているので、からかっている（からかわれている）ワンシーンを覗けると、とても嬉しいなと思っております…！\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/2hk0cg95fptznzv/AADM8Wvq_-TVDVzJPCM16fvJa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/7", "thumbnail_src": "https://si.imgix.net/df1759fc/uploads/origins/ad3dad2f-d7dd-4f5c-9323-66b889241aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b1e29f24e19b6a0baee3bb051fed65", "thumbnail_srcset": "https://si.imgix.net/df1759fc/uploads/origins/ad3dad2f-d7dd-4f5c-9323-66b889241aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b1e29f24e19b6a0baee3bb051fed65, https://si.imgix.net/df1759fc/uploads/origins/ad3dad2f-d7dd-4f5c-9323-66b889241aef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdb39487d65b4de82625328852d55392 2x, https://si.imgix.net/df1759fc/uploads/origins/ad3dad2f-d7dd-4f5c-9323-66b889241aef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b14ec50e21c31408513732ef2647c63f 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nこの度は是非そじさんにリクエストしたく、恥をかき捨ててメッセージをお送りいたしました。\n\nリクエスト内容についてですが、資料の二人（片方のみでも可）を描いていただけないでしょうか。\nどんな風に描くかというのは特に希望がないので、お好きにしていただいて大丈夫です。\n\n以上です。よろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/13b1c0mb2ws8r59/AADsDF197Ec3zn0QCaZP6hcsa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/6", "thumbnail_src": "https://si.imgix.net/971c9fef/uploads/origins/244a1e0c-17c1-4e03-9f9d-c4ab410c635c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c09395293a4f048610f5ca5ca1c4d85d", "thumbnail_srcset": "https://si.imgix.net/971c9fef/uploads/origins/244a1e0c-17c1-4e03-9f9d-c4ab410c635c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c09395293a4f048610f5ca5ca1c4d85d, https://si.imgix.net/971c9fef/uploads/origins/244a1e0c-17c1-4e03-9f9d-c4ab410c635c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3666ea641bf0122c8d6c510a77f36f8c 2x, https://si.imgix.net/971c9fef/uploads/origins/244a1e0c-17c1-4e03-9f9d-c4ab410c635c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90750888688ab25569441362dd3a6dd8 3x", "genre": "art", "nsfw": false, "body": "私のオリジナルキャラクターの素晴らしいアートを探しています。  セクシーでパワフルで邪悪なアニメにしたいです。\n\nhttps://ibb.co/3MYhFjp", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/5", "thumbnail_src": "https://si.imgix.net/66d84322/requests/283104_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa03b98ecef17122cfb15c92ecc6f28", "thumbnail_srcset": "https://si.imgix.net/66d84322/requests/283104_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa03b98ecef17122cfb15c92ecc6f28, https://si.imgix.net/66d84322/requests/283104_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=825ac097ebb58f16fd686db72554396b 2x, https://si.imgix.net/66d84322/requests/283104_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1314d6753a875e2cb3c6c758062a5c17 3x", "genre": "art", "nsfw": false, "body": "初めまして、新着クリエイター様の一覧からかがみさんのアカウントを見つけ素敵なイラストに惹かれ\n描いていただけたらなと思いリクエスト送らせていただきました。\n\n現在自分が遊んでいるゲームの自キャラをお願いしたいです。\nキャラクターの容姿はURLから、細かい部分は省略して大丈夫です。(SSがあまりうまく撮れてなくて申し訳ないです)\n目の色は、右目が赤・左目が茶のオッドアイになってます。\n\nhttps://twitter.com/sagami_vere/status/1366747008246059011\n\nポーズなどはお任せします。よろしくお願いいたします(*‘ω‘ *)", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/4", "thumbnail_src": "https://si.imgix.net/087e9c05/requests/279044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce8a13c9212a00df1cdd1bd8217a9094", "thumbnail_srcset": "https://si.imgix.net/087e9c05/requests/279044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce8a13c9212a00df1cdd1bd8217a9094, https://si.imgix.net/087e9c05/requests/279044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b2c4a8b073ced97eb74effc7e6304d6 2x, https://si.imgix.net/087e9c05/requests/279044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5429acf1290920a4f03695da2536ce33 3x", "genre": "art", "nsfw": false, "body": "そじさんこんにちは、いつもお世話になってます。初めてskebのリクエストを送ります。\n\n今回お願いしたいのはTRPGのPCではなく私のオリジナルキャラクターです。\nグイグイ押せ押せな女子高生×押されながらもそれを笑って受け入れる青年教師、という男女CPを描いて頂きたいす。\nそじさんの描かれる押せ押せなタイプの女の子が好きなので、そじさんの絵柄でそういうタイプのうちの子が見らたら嬉しいなあと思ってリクエストしちゃいました！\nシチュエーションや構図などは完全にお任せします。もし二人を描くのが大変そうだったら女の子のほうだけでも大丈夫です。\n\n資料は以下になります。\nhttps://www.dropbox.com/sh/jgqm2799tnlviw1/AACj6SF2WnqMviv1_trcQTkma?dl=0\n資料補足として、\n・女の子の方は両外側の髪だけ長くて内側は肩に着くぐらいの長さという髪型をしています。\n・青年の方は向かって右のもみあげ部分の色だけ焦げ茶～黒になっています。\n\n初めての依頼になるので、内容に至らない所があったらすみません。\nもし引き受けて頂けるようであれば、どうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/3", "thumbnail_src": "https://si.imgix.net/320e92fc/requests/277935_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32585397cc646ecfaa16fba755aaedd2", "thumbnail_srcset": "https://si.imgix.net/320e92fc/requests/277935_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32585397cc646ecfaa16fba755aaedd2, https://si.imgix.net/320e92fc/requests/277935_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9cd0e2c0305ef09580814053d8d3c40 2x, https://si.imgix.net/320e92fc/requests/277935_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5b08b23858e6f6015fe2fe82364a92d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n銀髪の女性を描いて頂けますか？\n\n【特徴】\n・現代人。\n・年齢は20代半ば。\n・社会的に高い地位にある。\n・穏やかな性格だが切れ者でもある。\n・髪は銀髪(髪型や長さはお任せします)。\n\n【用途】\n描いて頂いたイラストは以下の用途で使用させて頂く可能性がありますので、予めご了承ください。\n・PCやスマホの壁紙(サイズはお任せします)。\n・Twitte等のSNSのヘッダー、アイコン。\n・後日他の方に小説やイラストを依頼する際の参考資料。\n・Twitterでのイラストの紹介。\n\n【その他】\n・カラーイラストでお願いします。\n・矛盾点や言及の無い箇所があった場合はお任せします。\n・過度な露出は控えてください。\n・胸はあまり強調しないでください。\n\n以上、お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/2", "thumbnail_src": "https://si.imgix.net/3c784688/requests/277066_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2498a7ca965de8ad0fb71ea6c0e200a", "thumbnail_srcset": "https://si.imgix.net/3c784688/requests/277066_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2498a7ca965de8ad0fb71ea6c0e200a, https://si.imgix.net/3c784688/requests/277066_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14ce41edd87e5274b0a5af66da948c1f 2x, https://si.imgix.net/3c784688/requests/277066_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5deee3e2cc6433fc3e7ef1de41ec98d 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n\n「ジグザグ」というアイドルグループの絵をお願いしたいです。\n資料は以下になります。\nhttps://www.dropbox.com/sh/piu25135yvenkom/AADznvv0Y2mGIlXlWTLbZmQRa?dl=0\n\nそじさんの絵柄が大好きなので、\n是非そじさん画の二人が見たいと思いリクエストさせて頂きました！\n宜しくお願いします〜！", "created_at": "", "completed_at": ""}, {"path": "/@kagami_soji/works/1", "thumbnail_src": "https://si.imgix.net/47c1e0c0/requests/277047_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36039f8088c73c61b60eb23922a66e19", "thumbnail_srcset": "https://si.imgix.net/47c1e0c0/requests/277047_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36039f8088c73c61b60eb23922a66e19, https://si.imgix.net/47c1e0c0/requests/277047_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77cfe03cf1a4336d01fa9fadf65d4d72 2x, https://s