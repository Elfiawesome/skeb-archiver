379-a54c-5048bf2ff764?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46a4807973f93caac5b1fe2cd7f6e97d, https://si.imgix.net/6198f5d7/uploads/origins/806ef349-0539-4379-a54c-5048bf2ff764?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79db95d41a25631187316487ea16c586 2x, https://si.imgix.net/6198f5d7/uploads/origins/806ef349-0539-4379-a54c-5048bf2ff764?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22858f8af2a168a56e316b6795a015f2 3x", "genre": "art", "nsfw": false, "body": "デュエプレのアダムスキーが宇宙空間で漂いながらこちらに手を差し伸べてる感じのイラストをお願いします。\n空いてるスペースにタコンチュがいたらなおうれしいです。", "created_at": "", "completed_at": ""}, {"path": "/@gurivinesyu/works/250", "thumbnail_src": "https://si.imgix.net/b1203c10/uploads/origins/2cb1220f-5c4c-43df-b388-2f10035588d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92e18ed3d5f8c8f317a114e7d6f12a7c", "thumbnail_srcset": "https://si.imgix.net/b1203c10/uploads/origins/2cb1220f-5c4c-43df-b388-2f10035588d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92e18ed3d5f8c8f317a114e7d6f12a7c, https://si.imgix.net/b1203c10/uploads/origins/2cb1220f-5c4c-43df-b388-2f10035588d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5371c0c7320c9052c86cfa118d0eb5d0 2x, https://si.imgix.net/b1203c10/uploads/origins/2cb1220f-5c4c-43df-b388-2f10035588d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=036fe65e5a12a97f2e8a5186bc7148b1 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。恐れ入りますが、2枚の異なるポーズの全身図をご依頼させていただきたく存じます。\nバイクの両側カウルに使用する予定で、バイクはBMW S1000RR 2020年モデルです。\nキャラクターは「にじさんじの葉加瀨冬雪さん」で、衣装は初期配信のものをご希望しております。手にはフラスコと試験管を持たせていただき、3D初配信回の3D待機画面(48:58)のような雰囲気で描いていただけますと幸いです。ポーズについての指定はございません。\nお手数をおかけいたしますが、何卒よろしくお願い申し上げます。\n\nhttps://www.youtube.com/live/NYcHLF1mUag?si=5NCc9y6m1rqCvBLg&t=2938", "created_at": "", "completed_at": ""}, {"path": "/@gurivinesyu/works/249", "thumbna