3fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ae6dceb54d80128ecf91009eecf4957 2x, https://si.imgix.net/bb22a665/uploads/origins/16a4734a-46e7-4a88-92b9-f2ae0f82565b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45e8c4d8a60f30cd869e726ff4a9bf92 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！私はあなたの蛾の女のアートが本当に大好きでした。私が見た蛾の女性のコミッションの中で最も美しい作品の一つであるだけでなく、私が見た芸術全般の中で最も鮮やかで夢のような作品の一つです。\nhttps://drive.google.com/drive/folders/1H8x7JA87E0K3FE2QsidVJlM5DtMZs4dU\nこの女性はどうですか？彼女はダンサーで、手足を歪めることもできる。彼女は偽物の蛇の手を持っており、それを使って獲物や捕食者の注意をそらす。彼女は偽の蛇の手の牙のために2本の指の短剣を持っている。普段は砂漠にいる。彼女は袋状の服を好んで着るが、それは布地が邪魔になることなく、体型を簡単に歪めてコントロールできるからである。砂漠にいるにもかかわらず、彼女は冷たい性格だ。その冷たさを表現してほしい。コミッションでは、彼女のみぞおちが見えるようにしてほしい。ありがとうございました。蛇女については、自由に創作してください。", "created_at": "", "completed_at": ""}, {"path": "/@yuni/works/5", "thumbnail_src": "https://si.imgix.net/1d13b3cf/uploads/origins/347cc198-e19f-40a1-8635-abedf0f96561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58cc65c0b170fbf0c8cb56c376a05aa", "thumbnail_srcset": "https://si.imgix.net/1d13b3cf/uploads/origins/347cc198-e19f-40a1-8635-abedf0f96561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58cc65c0b170fbf0c8cb56c376a05aa, https://si.imgix.net/1d13b3cf/uploads/origins/347cc198-e19f-40a1-8635-abedf0f96561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1e86f993735861ba409c3ee7fdf2faa 2x, https://si.imgix.net/1d13b3cf/uploads/origins/347cc198-e19f-40a1-8635-abedf0f96561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d66d0fff4d28e698c47bfa5ca8e58bc9 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n鈴瑚を描いて頂きたいです。\n東方アレンジ楽曲をYouTubeに投稿しますので、その動画に使用いたします。\n比率は16:9でお願いいたします。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yuni/works/4", "thumbnail_src": "https://si.imgix.net/761ff756/uploads/origins/871d6e55-6038-48d6-971c-a42d6bbd2eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ad2545df5ec3eb853d949f39bf6c72b", "thumbnail_srcset": "https://si.imgix.net/761ff756/uploads/origins/871d6e55-6038-48d6-971c-a42d6bbd2eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ad2545df5ec3eb853d949f39bf6c72b, https://si.imgix.net/761ff756/uploads/origins/871d6e55-6038-48d6-971c-a42d6bbd2eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=283053e736874b641af4cd74b97b5155 2x, https://si.imgix.net/761ff756/uploads/origins/871d6e55-6038-48d6-971c-a42d6bbd2eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2f5772a46e27043251cffa205775989 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nvtuberのparasiの絵をお願いします。彼女は肉食の月兎で、水色の髪に大きなふわふわの耳、頭には血まみれの包帯、大きな丸いふわふわの尻尾を持っています。彼女は絵を描くこと、生肉を食べること、ビールを飲むこと、釣りが好きです。\n\n好きな服やアクセサリーで描いてください！\n\nhttps://drive.google.com/drive/folders/1OMlZ3Cwa4Rg0hxq2J1v9R6RotR-nW4jD", "created_at": "", "completed_at": ""}, {"path": "/@yuni/works/3", "thumbnail_src": "https://si.imgix.net/9de0f042/uploads/origins/25f2e394-8b1f-41b7-b76b-9870a005c1a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f447345717a019f1b5f82780d8b8bbf5", "thumbnail_srcset": "https://si.imgix.net/9de0f042/uploads/origins/25f2e394-8b1f-41b7-b76b-9870a005c1a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f447345717a019f1b5f82780d8b8bbf5, https://si.imgix.net/9de0f042/uploads/origins/25f2e394-8b1f-41b7-b76b-9870a005c1a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69395ef9537ba0ae4bb67af8de81aa37 2x, https://si.imgix.net/9de0f042/uploads/origins/25f2e394-8b1f-41b7-b76b-9870a005c1a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16bde8aa5accb8447a75aadd5af909db 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Juvlarです。この蛾の女性を描いていただけませんか？https://drive.google.com/drive/folders/1cAM8FphCzd3FZVfOFfUqSxeu3jWPl8Wv キャラクターの個性を強調する色の使い方が素晴らしいです！この蛾の女性を、あなたの他の絵のように、夢のようなシナリオで描いていただけませんか？夜明け、夕暮れ、夜に現れる蛾の女性です。ミステリアスでエレガントで、謎めいた魅力があります。彼女の目（赤い強膜、白い瞳孔、グレーの虹彩）と服装の毛皮の面はそのままにしていただけますか？環境とポーズはあなた次第です！ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yuni/works/2", "thumbnail_src": "https://si.imgix.net/58cf141e/uploads/origins/4e745538-16db-4c13-84aa-e21e8e76f02b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b77018c3ee6364a4e4d64d643ad85f", "thumbnail_srcset": "https://si.imgix.net/58cf141e/uploads/origins/4e745538-16db-4c13-84aa-e21e8e76f02b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b77018c3ee6364a4e4d64d643ad85f, https://si.imgix.net/58cf141e/uploads/origins/4e745538-16db-4c13-84aa-e21e8e76f02b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e07fdf074dc9b72d0475e853d7156270 2x, https://si.imgix.net/58cf141e/uploads/origins/4e745538-16db-4c13-84aa-e21e8e76f02b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a8b5053e5aa1702ee27fe1e3781f33b 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n世界はもっと鍵山雛を必要としています。\n東方projectのキャラクター、可愛い鍵山雛の作品を描いていただけませんか？\n雛はロングストッキングを履いてほしいです。\n自由にデザインしてください。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@yuni/works/1", "thumbnail_src": "https://si.imgix.net/6e1d4375/uploads/origins/55f0d7bd-354d-4074-9076-5304ab01de62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19def223ddddd07ce0dc1a2784fc3147", "thumbnail_srcset": "https://si.imgix.net/6e1d4375/uploads/origins/55f0d7bd-354d-4074-9076-5304ab01de62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19def223ddddd07ce0dc1a2784fc3147, https://si.imgix.net/6e1d4375/uploads/origins/55f0d7bd-354d-4074-9076-5304ab01de62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48799e2520f5957975cbe9223bfb695c 2x, https://si.imgix.net/6e1d4375/uploads/origins/55f0d7bd-354d-4074-9076-5304ab01de62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62867785ba5b81058446ee701463d335 3x", "genre": "art", "nsfw": false, "body": "こんにちは！東方ProjectのPC98用ゲームタイトル「祈りの高反応」のコンニャラの絵をお願いしたいです（キャラクター参考例：https://www.pixiv.net/en/artworks/127386353）。\n\nコンニャラには今風の服を着てほしいです。元の服の色のジャケットのようなものが合うと思います。できれば、刀は持っていてほしい。\n\nコンニャラには真剣な表情をしてほしい。クールなタイプだと思うので！", "created_at": "", "completed_at": ""}]}