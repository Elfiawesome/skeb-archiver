d6aafe37a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f5cb6b9128a10407924d00016101087 2x, https://si.imgix.net/b382f6d1/uploads/origins/00b755e2-a9f0-40bd-9cc6-0d2d6aafe37a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=348c88fac3b141c6667b5a33cf9723a3 3x", "genre": "comic", "nsfw": true, "body": "マンガのリクエスト\nの続編：\nhttps://www.pixiv.net/artworks/122974292\nサキュバスが少年を復活させ、解放する。その後、ゴブリンが少年を捕まえる。\n\nキャラクター\nA：少年、B：人間の少女、C：雄のゴブリン、D：雌のゴブリン：女ゴブリン。\n\np1：AとBはCに殴られる。\nCはAとBに戦うように命じる。\nBはAを倒し、頭はさみをかける。\nhttps://www.pixiv.net/artworks/80435023\nAが降参。\n\np2: ある日、DがAを騎乗位で犯す。DはAにキスをし、ピルを飲ませる。\nhttps://www.pixiv.net/artworks/111785869\nAはショタゴブリンに変身。\n \np3:ある日、DはAとBに戦うように命じる。\nゴブリンになったAはBに屈辱的な敗北を喫し、このホールドに支配される：\nhttps://www.pixiv.net/artworks/90214993\n\np4：ある日の昼間、BはCに宣教師的体位（男性が上）で犯される。\nBは従順な淫乱女としての快感を味わう。\nしかし夜、Bはスパイダー騎乗位（女性が上）でAを犯す。\nBは支配的な女王であることの快感を味わう。\n\n登場人物の表情と台詞を日本語で書いてください。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@MacroShiosaki/works/40", "thumbnail_src": "https://si.imgix.net/dfc5b3f2/uploads/origins/88fd58b9-7c60-43b9-97a8-49f256aeaf34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a7f6c13a9d614bf7867d337c669df73", "thumbnail_srcset": "https://si.imgix.net/dfc5b3f2/uploads/origins/88fd58b9-7c60-43b9-97a8-49f256aeaf34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a7f6c13a9d614bf7867d337c669df73, https://si.imgix.net/dfc5b3f2/uploads/origins/88fd58b9-7c60-43b9-97a8-49f256aeaf34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87b2f0a16837f473b75638453e4d5c79 2x, https://si.imgix.net/dfc5b3f2/uploads/origins/88fd58b9-7c60-43b9-97a8-49f256aeaf34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e0ac918b3973a4275e7b4a0fed71790 3x", "genre": "art", "nsfw": false, "body": "アッシュアームズのヴィルベルヴィントが左右で違うブーツを履いているイラストをお願いします(間違えて左右の足で違うブーツを履いたという設定、下は履いているブーツや地面まで)\n\nヴィルベルヴィントはメカ部分なしの通常スキンでお願いします\n履いているブーツについては、片足がヴィルベルヴィントのブーツ、もう片方の足がクーゲルブリッツのメカ部分なしの通常スキンのブーツでお願いします(どちらの足に履いているかはお任せします)\n\nヴィルベルヴィントは他の人に言われるまで左右の足で違うブーツを履いていることに気付かず、恥ずかしくなりながらも怒っている状態でお願いします\n\n以上よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@MacroShiosaki/works/39", "thumbnail_src": "https://si.imgix.net/65c41bbb/uploads/origins/8f5af7a4-ac80-47c8-b139-db45522fc7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc269e9c07faf94dc5e51dc99cc867b", "thumbnail_srcset": "https://si.imgix.net/65c41bbb/uploads/origins/8f5af7a4-ac80-47c8-b139-db45522fc7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc269e9c07faf94dc5e51dc99cc867b, https://si.imgix.net/65c41bbb/uploads/origins/8f5af7a4-ac80-47c8-b139-db45522fc7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66c89f262747e94140ac1f0d0bcdc7ff 2x, https://si.imgix.net/65c41bbb/uploads/origins/8f5af7a4-ac80-47c8-b139-db45522fc7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab5009ed3478a8651aeb1d426444e73b 3x", "genre": "comic", "nsfw": false, "body": "前回はブーツが脱げているイラストをありがとうございました。\n今回もアッシュアームズのキャラのブーツが脱げているイラスト(コミック)をお願いします\n今回はティーガーⅡとSU-100がブーツを脱ぐシーン2つを追加となります\n\n① ティーガーⅡのブーツのアップ\nティーガーⅡが片足のブーツを脱いでいる状態\n既にもう片方の足のブーツを脱いでいて素足の状態(ティーガーⅡについては下記URLを参照)\n\nhttps://asharms.wikiru.jp/?DOLLS/DOLLS一覧/戦車/ティーガーII\n\n②SU-100のブーツのアップ\nSU-100がブーツを脱ぐために片足のブーツのファスナーを下に下ろす\n既にもう片方の足のブーツを脱いでいるかはお任せします\n\n③ アッシュアームズのキャラのブーツが脱げているイラスト(ブーツのみのイラストです)\n置かれているブーツについては以下の5種類でお願いします\nKV-1以外は通常スキンのブーツでお願いします \nSU-100とティーガーⅡのブーツの状態については指定あり、それ以外の3種類のブーツの状態(立っているか、折れ曲がっているか、倒れているかなど)はお任せします\n\n・SU-85のブーツ\n\n・SU-100のブーツ\n片足のブーツは立っていて、もう片方の足のブーツは倒れている状態\n\n・ティーガーⅠ初期型のブーツ\n\n・ティーガーⅡのブーツ\n両足のブーツが折れ曲がっている状態\n\n・KV-1のスキン「聖なる鉄壁少女」のブーツ\n(下記URLから赤色十月同盟連合のKV-1の聖なる鉄壁少女を参照)\n\nhttps://asharms.wikiru.jp/?DOLLS/DOLLS一覧/スキン別一覧\n\n以上よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@MacroShiosaki/works/38", "thumbnail_src": 