84778a02fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e51d71142e61360b838911d3c652d7a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/19", "thumbnail_src": "https://si.imgix.net/ed0d39ed/uploads/origins/5a31e3e1-b428-47a5-be87-5f48d9903aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51aced9d16924d3e55589e709336d131", "thumbnail_srcset": "https://si.imgix.net/ed0d39ed/uploads/origins/5a31e3e1-b428-47a5-be87-5f48d9903aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51aced9d16924d3e55589e709336d131, https://si.imgix.net/ed0d39ed/uploads/origins/5a31e3e1-b428-47a5-be87-5f48d9903aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68a90f32b0db394ec6544b36e92d5d15 2x, https://si.imgix.net/ed0d39ed/uploads/origins/5a31e3e1-b428-47a5-be87-5f48d9903aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed1f0512922a42c403aa19393ab80f3 3x", "genre": "art", "nsfw": true, "body": "こんにちは、はじめまして。\n描いてほしいキャラ:真奈ちゃん\n衣装:乳首部分、マ〇コ部分、おへそ部分、下谷間部分がハート型にくり抜かれたレオチラミニスカ付きピンクレオタードにピンクのロンググローブとピンクのニーソを合わせた物\nポーズ:エロ蹲踞にハート型に合わせた手をマ〇コに持ってきているポーズ(イメージ: https://www.pixiv.net/artworks/60112894 )\nその他の要望:全身が映るように書いてください。", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/18", "thumbnail_src": "https://si.imgix.net/897e792d/uploads/origins/fc26338e-fa84-4d51-a181-28ccb5c86be8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18aad01afbcdde37836de08ac9aff59a", "thumbnail_srcset": "https://si.imgix.net/897e792d/uploads/origins/fc26338e-fa84-4d51-a181-28ccb5c86be8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18aad01afbcdde37836de08ac9aff59a, https://si.imgix.net/897e792d/uploads/origins/fc26338e-fa84-4d51-a181-28ccb5c86be8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a636e66eb7f8e58add98171c2e6c9740 2x, https://si.imgix.net/897e792d/uploads/origins/fc26338e-fa84-4d51-a181-28ccb5c86be8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f57c4c952180a4ef2e1c3a7c83eb5a6 3x", "genre": "art", "nsfw": true, "body": "前回も恐ろしいまでの可愛いさの真奈ちゃんをありがとうございましたm(__)m\n主観視点大好きなので、見つめあってる感じの没入感が最高でした！\n\nまたも真奈ちゃんの可愛さ布教的にリクエストさせて頂けましたら幸いです\n\n今回は歳相応？に学校帰りにJｓ制服にて\n反則急な可愛さにムラムラ来てお願いしちゃう感じにて\n\n主観構図：https://www.pixiv.net/artworks/77509449#1\n         (腰～頭頂部くらいの範囲?)\n衣装：https://www.pixiv.net/artworks/19961994\n(王道な吊りスカ・ブラウス・棒タイ・白ニーソあたりの要素イメージ)\n\n①、可愛い制服姿に思わず木陰に連れ込んで押し倒し\n②、パツパツのブラウスにまたもボタンも開けずに隙間へ…IN\n③、『お、おにいちゃ…制服やぶれちゃう💦』\n④、乳内射精\n　　→ブラウスの内側から徐々に染みだしちゃう\n⑤、①差分にて抜いたら液で汚れたブラと谷間…に滴って\n　　→『あう…制服が…(涙目)』\n\nといった感じです\n※男性透過にて\n\nもちろん今回も急ぎませんので、\n都度再リク申請など頂ければと思います。\n過不足あればぶーすと調整致します！\n\nhttps://www.pixiv.net/artworks/77509449#1", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/17", "thumbnail_src": "https://si.imgix.net/cfb077ee/uploads/origins/37b0ee2e-b791-4409-a2a3-293d2287ec02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee0b0430abe3c300773b1e442b34998b", "thumbnail_srcset": "https://si.imgix.net/cfb077ee/uploads/origins/37b0ee2e-b791-4409-a2a3-293d2287ec02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee0b0430abe3c300773b1e442b34998b, https://si.imgix.net/cfb077ee/uploads/origins/37b0ee2e-b791-4409-a2a3-293d2287ec02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9ddbba3db5f0465a6feb634109c21da 2x, https://si.imgix.net/cfb077ee/uploads/origins/37b0ee2e-b791-4409-a2a3-293d2287ec02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e49d1ba36e24e495767767708b53a345 3x", "genre": "art", "nsfw": true, "body": "ロリ巨乳を描いてください。\n黒髪。姫カット。\nサスペンダースカート。赤いランドセル。\n母乳の分泌を増やす薬をキャンディーと間違える。\nこの薬は成人向けなので、非常に効果的です。\n母乳がものすごい速さで生産されます。\nしかし、このような幼稚な乳首では母乳が出る準備ができていません。\nそれで、母乳がおっぱいに溜まるんです。\nおっぱいがどんどん大きく膨らんでいきます！\n服が破れてしまった！腫れが止まらない！\n\n成長し続けるバストのサイズはあなた次第。大きいほど良いです！\n\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/16", "thumbnail_src": "https://si.imgix.net/ce120687/uploads/origins/95129c65-4a08-48e0-a590-6d6e3fdc2573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b27ff2ffe2ac30c64b0b4998d2708110", "thumbnail_srcset": "https://si.imgix.net/ce120687/uploads/origins/95129c65-4a08-48e0-a590-6d6e3fdc2573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b27ff2ffe2ac30c64b0b4998d2708110, https://si.imgix.net/ce120687/uploads/origins/95129c65-4a08-48e0-a590-6d6e3fdc2573?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f273f470234af6b02618af5ba1a29b8 2x, https://si.imgix.net/ce120687/uploads/origins/95129c65-4a08-48e0-a590-6d6e3fdc2573?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f197ce06f74bffe7e606669123d08910 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/15", "thumbnail_src": "https://si.imgix.net/081326a7/uploads/origins/9e8b9af2-2216-4cf5-beed-4ce36bc03b06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1e9b542f74a57f02e8bab4cb1ce205", "thumbnail_srcset": "https://si.imgix.net/081326a7/uploads/origins/9e8b9af2-2216-4cf5-beed-4ce36bc03b06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1e9b542f74a57f02e8bab4cb1ce205, https://si.imgix.net/081326a7/uploads/origins/9e8b9af2-2216-4cf5-beed-4ce36bc03b06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb630d5e06f63b13f4c0db7e4342dafe 2x, https://si.imgix.net/081326a7/uploads/origins/9e8b9af2-2216-4cf5-beed-4ce36bc03b06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=930ef63a459904c52656f7be72e9d532 3x", "genre": "art", "nsfw": true, "body": "ご自身の作品もある中、\nめっちゃ可愛い真奈ちゃんありがとうございました！\n(文字有無差分でイラスト単体でも鑑賞できて幸せです…)\n今回も来年でも良いですので、\n真奈ちゃんにてご依頼できれば幸いです。\n\n前回の続きシチュ的に(お洋服やブラも同じ)\n一度出したものの溢れる可愛さとエッチさに耐えられず…\n\n①押し倒しちゃう(びっくり顔)\n②『え…な何お兄ちゃん？！』→挿入\n③『あう…おまたの中苦しいよ…(涙目)』\n④中出し『な…なに⁈』\n⑤徐々にスカートの内側から液が染み出す\n⑥『中に…熱いよ…(困り顔)』\n\n主観構図参考：https://www.pixiv.net/artworks/122191266\n\n結合部はスカートで隠しちゃって大丈夫です。\n捲る場合は可能な限り肌色少な目にて。\n\n今回も急ぎませんので、ご無理ない範囲・期間でご検討頂ければと思います。\n\nhttps://www.pixiv.net/artworks/122191266", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/14", "thumbnail_src": "https://si.imgix.net/a3da1def/uploads/origins/935c1349-0ead-4f20-9dd2-27cce376e187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa215c0112f7e901983dc533789d68a4", "thumbnail_srcset": "https://si.imgix.net/a3da1def/uploads/origins/935c1349-0ead-4f20-9dd2-27cce376e187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa215c0112f7e901983dc533789d68a4, https://si.imgix.net/a3da1def/uploads/origins/935c1349-0ead-4f20-9dd2-27cce376e187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb1853b9897cbe243e01c9905deebb95 2x, https://si.imgix.net/a3da1def/uploads/origins/935c1349-0ead-4f20-9dd2-27cce376e187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da3ee4a247f55718e1cb5f0e4eb20ae1 3x", "genre": "art", "nsfw": true, "body": "依頼の方を再送します。\n---------------\n作品名/キャラクター名：わたてんの白咲花ちゃんと姫坂乃愛ちゃん\nシチュエーション：パンツ丸出しの格好のコスプレ花ちゃんのフィギュアみたいなポーズシチュが見たいです。キャラクター切り替え方式にして衣装をPSDファイルでレイヤー分け方式にして頂ければ再現出来ます。\n\nポーズ：正面向きの全身立ち絵(手はパンツに干渉しない位置で)足は長く、太ももは少し太めでお願いします。以前描いた制服デート乃愛ちゃん及び花ちゃんのポーズとプロポーションを再現して欲しいです。\n\nコスプレ服装はこのタイプの制服2種\nhttps://x.com/madao_hentai/status/1787807205250715770?s=46&t=2S1WikyWWi9M4CyXZo_-_w\n\n+ブルアカのピチピチガイドスーツ\nhttps://www.pixiv.net/artworks/115582917\n\n+ニジガクの高咲侑のブレザー制服\nhttps://www.pixiv.net/artworks/117007359\n\n制服の余りシャツ(シャツベロ)はこのように出して欲しいです\nhttps://skeb.jp/@sinocya/works/44\n\nどのスカート丈もワカメちゃん並みにマイクロミニになっててパンツが丸見えになって欲しいです。\nスカート丈イメージ\nhttps://skeb.jp/@toritter09301/works/18\n\nパンツ:\n・シンプルな純白パンティー\n・縦クロッチの付いた純白パンティー\n\n靴下:\n・黒ライン入りの白サイハイニーソ\n・白ライン入りの黒サイハイニーソ\n・婦警コスプレのベージュストッキングサイハイニーソ\n・黒のショートソックス\n・https://x.com/kyabe2ndmk2/status/1778780778912153858?s=46&t=2S1WikyWWi9M4CyXZo_-_w\nが履いてる線入りのレオタード用のサイハイニーソ\n・ローファー(革靴)\n\n表情：基本お任せですが、可能でしたらグルグル目と曇り顔でゴミを見るような表情(特に花ちゃん)は欲しいです\n\n背景：無色か簡単な背景でお願いします\n使用用途は個人利用の妄想用として使いたいだけです。お手数ですが、ご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/13", "thumbnail_src": "https://si.imgix.net/0ed7e011/uploads/origins/863d59f2-67fd-46f7-a2dc-1dbf99e80112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0d9d50f72d1d069587a58f71422d4b8", "thumbnail_srcset": "https://si.imgix.net/0ed7e011/uploads/origins/863d59f2-67fd-46f7-a2dc-1dbf99e80112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0d9d50f72d1d069587a58f71422d4b8, https://si.imgix.net/0ed7e011/uploads/origins/863d59f2-67fd-46f7-a2dc-1dbf99e80112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=424583e3ad431ec0d0dfbc38d0ad3a40 2x, https://si.imgix.net/0ed7e011/uploads/origins/863d59f2-67fd-46f7-a2dc-1dbf99e80112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=042548b51cb346325feb66309b81e4dd 3x", "genre": "art", "nsfw": true, "body": "今回お願いしたいのは、「はじめてのギャル」の藤乃木ねね（ピンク髪バージョン）。\nシチュエーションは、裸に首のリボンと手首のアクセサリーだけで登校しているところです。\n服装やポーズ、おおよそのプロポーションはこちらの画像を参考にしてほしい：\nhttps://1drv.ms/i/s!AoSz-gx1hbwFh9wLSFk2ph_8v4C-1A?e=Yn2OS9\n構図や背景は自由に変更してください。\nあなたのスタイルに合うようにプロポーションを変えることもできます。\nおっぱいは大きく描いてもいいですが、できれば参考画像と同じような形で描いてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/12", "thumbnail_src": "https://si.imgix.net/c0cfcc9e/uploads/origins/5d4e078e-1a14-4dff-8005-63f73663f592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d529deda634b65839ec570f0868ac274", "thumbnail_srcset": "https://si.imgix.net/c0cfcc9e/uploads/origins/5d4e078e-1a14-4dff-8005-63f73663f592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d529deda634b65839ec570f0868ac274, https://si.imgix.net/c0cfcc9e/uploads/origins/5d4e078e-1a14-4dff-8005-63f73663f592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f51410b7cf13dc776d900c9c82ff1388 2x, https://si.imgix.net/c0cfcc9e/uploads/origins/5d4e078e-1a14-4dff-8005-63f73663f592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa900f4d1089113130bbbd073bf93fda 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aqua_dropb/works/11", "thumbnail_src": "https://si.imgix.net/998ae180/uploads/origins/5adc4dc5-574a-4ad7-b618-64838e178a1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e68ba58472d9e869875c1cbcdd81ed94", "thumbnail_srcset": "https://si.imgix.net/998ae180/uploads/origins/5adc4dc5-574a-4ad7-b618-64838e178a1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e68ba58472d9e869875c1cbcdd81ed94, https://si.imgix.net/998ae180/uploads/origins/5adc4dc5-574a-4ad7-b618-64838e178a1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a93e6ef489b881858e228