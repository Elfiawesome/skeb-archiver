%2Ccenter&txtsize=30&txt=PRIVATE&s=c7a31611b9c336d42e78429a6371e010", "thumbnail_srcset": "https://si.imgix.net/fd8054f2/uploads/origins/15aef2c2-78e8-46ce-8b8f-aa2d8bb20870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7a31611b9c336d42e78429a6371e010, https://si.imgix.net/fd8054f2/uploads/origins/15aef2c2-78e8-46ce-8b8f-aa2d8bb20870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cbd2ce02aabb1e1ca7d14d8ce79c669 2x, https://si.imgix.net/fd8054f2/uploads/origins/15aef2c2-78e8-46ce-8b8f-aa2d8bb20870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c22517cf0bb75dbe03314b3458aa73e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@etezarumonkey/works/28", "thumbnail_src": "https://si.imgix.net/c599345b/uploads/origins/c20af75c-6a7f-4569-96fa-9d17ef9ce16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8cab7f67a7fbf7cccc1fd4be9cb695", "thumbnail_srcset": "https://si.imgix.net/c599345b/uploads/origins/c20af75c-6a7f-4569-96fa-9d17ef9ce16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8cab7f67a7fbf7cccc1fd4be9cb695, https://si.imgix.net/c599345b/uploads/origins/c20af75c-6a7f-4569-96fa-9d17ef9ce16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e49b28a054d7956a87da085957bfbef 2x, https://si.imgix.net/c599345b/uploads/origins/c20af75c-6a7f-4569-96fa-9d17ef9ce16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e0d23b17edadbbe4d19feb093b557f7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの巨大なキャラクターを使ったアートがとても好きなので、そのようなものをリクエストしたいのです。\n\nゲーム「風雅～鋼鉄の旋律～」のプレッツェルを巨人化してほしいです。ゲーム中の敵ではありますが、必ずしも破壊的な巨人であってほしいとは思いません。でも、巨人としての迫力はもちろん、威圧感や恐ろしさを強調できるような絵になればいいなと思います。また、リファレンスにあるユニフォームを着用してほしいです。\n\nこの度は本当にありがとうございました！\n\nhttps://static.wikia.nocookie.net/forlittletail/images/1/12/Pretzel.png/revision/latest?cb=20210810072932", "created_at": "", "completed_at": ""}, {"path": "/@etezarumonkey/works/27", "thumbnail_src": "https://si.imgix.net/05d57cda/uploads/origins/2074b177-e0ad-4538-9999-3104b12d0e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d53f223ff08a5f4eb3bc5179d394a1ab", "thumbnail_srcset": "https://si.imgix.net/05d57cda/uploads/origins/2074b177-e0ad-4538-9999-3104b12d0e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d53f223ff08a5f4eb3bc5179d394a1ab, https://si.imgix.net/05d57cda/uploads/origins/2074b177-e0ad-4538-9999-3104b12d0e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7f26d07d9a6b5aa284b9291ad19b789 2x, https://si.imgix.net/05d57cda/uploads/origins/2074b177-e0ad-4538-9999-3104b12d0e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f687d02eb7cb5dc0110e481bb0cd114 3x", "genre": "art", "nsfw": false, "body": "こんにちは(^^)v以前、この人狼のイラストをお願いしたことがあるのですが、とても気に入りました！なので、今回も描いて頂きたいのです！イラスト例リンク：https://drive.google.com/drive/folders/1--ke4YBdwwflCqhFUwDLY5sMckhbhi14。\n(イラストのディテールを向上させるために少し値段を上げました。この値段でいいのかわかりませんが、引き受けていただけると本当にうれしいです)\nここでイラストですが、キャラクターは大胆で冷静沈着なグレイウルフで、エレメントパワー、特に風と雷を使うのが得意です（反映されているといいのですが）柄は少し水色の発光があるものになります（柄の形状に注意してください）。イラストは、このキャラクターの筋肉質で奔放な性格を表現できればと思っています。\n\nhttps://drive.google.com/drive/folders/1--ke4YBdwwflCqhFUwDLY5sMckhbhi14", "created_at": "", "completed_at": ""}, {"path": "/@etezarumonkey/works/26", "thumbnail_src": "https://si.imgix.net/0c685e3f/uploads/origins/ddfa9be0-35e6-49c7-a7b0-e61cdca42d82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771edab81e44083868cd7cf52ad96b9a", "thumbnail_srcset": "https://si.imgix.net/0c685e3f/uploads/origins/ddfa9be0-35e6-49c7-a7b0-e61cdca42d82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771edab81e44083868cd7cf52ad96b9a, https://si.imgix.net/0c685e3f/uploads/origins/ddfa9be0-35e6-49c7-a7b0-e61cdca42d82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61adc38beb0fe9268c2f85a0ffb8d7c6 2x, https://si.imgix.net/0c685e3f/uploads/origins/ddfa9be0-35e6-49c7-a7b0-e61cdca42d82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7df2984c662b4d367b51be2bc62a389f 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\n巨大なファルコとルカリオが敵の海軍と戦っているシチュエーションが見てみたいです。\nファルコがルカリオより背が高くてチンコもでかいです。\n二人のタマが少し浸っているくらいの水深です。\n戦闘機や戦艦が二人の体やチンコなどを撃っていますが二人を気持ちよくするだけです。\nファルコが片手で船を握りつぶしています。ルカリオのポーズはお任せします。\n二人の体にぶつかって沈んでいる船たちがあります。\n二人の足やチンコをよじ登っている兵士たちがいますが小さすぎて点のように見えています。\n後ろには二人によって破壊された街が映っています。\n\n3つのバージョンが欲しいです。\n1枚目は競パンを履いています。ファルコのが赤、ルカリオのが黒です。\n2枚目は全裸で勃起して兜合わせしています。チンコの間に船や兵士たちが挟まっています。二人の先走りが船などを濡らしています。\n3枚目は二人とも勢いよくイっています。二人のザーメンで海がほぼ白くなっています。\n\n詳細は資料URLを参考にしてください。\nそれではよろしくお願いします。\n\nhttps://sta.sh/2ta7xj6sxsk", "created_at": "", "completed_at": ""}, {"path": "/@etezarumonkey/works/25", "thumbnail_src": "https://si.imgix.net/3aed4bc5/uploads/origins/b625d584-ffb6-4a96-8a99-f704f1a41a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454c640fd7a8e30cdeca3d833c4de9a7", "thumbnail_srcset": "https://si.imgix.net/3aed4bc5/uploads/origins/b625d584-ffb6-4a96-8a99-f704f1a41a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454c640fd7a8e30cdeca3d833c4de9a7, https://si.imgix.net/3aed4bc5/uploads/origins/b625d584-ffb6-4a96-8a99-f704f1a41a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43896cf069c7646cbb9d3aac922cd695 2x, https://si.imgix.net/3aed4bc5/uploads/origins/b625d584-ffb6-4a96-8a99-f704f1a41a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20535b11b49b783a5f4dfe823a013c8a 