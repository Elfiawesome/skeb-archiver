af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e6c26e5f45d730d652d067b53661405, https://si.imgix.net/0308b463/uploads/origins/e46a2b9d-3b9f-45ad-abf5-972c0c57af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2deee36a75990121db3596f2304c3e4 2x, https://si.imgix.net/0308b463/uploads/origins/e46a2b9d-3b9f-45ad-abf5-972c0c57af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=701dbfd5f9e5e3015defdd4027ad996d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！また自己挿入イラストをお願いしに来ました！今回は『原神』のヴァルカと私のツーショットを描いてほしいです！ヴァルカのティザー画像が公開され、もうすぐ実装されるので、ガチャを引く前に二人のイラストで縁起を担ぎたいんです！ソファでワインを飲むような、そんな感じのロマンチックなツーショットを描けますか？ポーズはお任せします！\n私のキャラクターの参考画像と衣装を用意しました！ヴァルカの参考画像と身長比較も！彼はとても背が高くてハンサムです！本当にありがとうございます！いつも私のリクエストを完璧に描いてくれます！https://drive.google.com/drive/folders/1M1DIrCrkXD-00rofCQZBaiynmWwdrvvC?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kaeito0213/works/14", "thumbnail_src": "https://si.imgix.net/e9732606/uploads/origins/cfab17df-2bc2-4d2c-82f5-969931c7c5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a891f10bbf1bb375e3871459f5030e", "thumbnail_srcset": "https://si.imgix.net/e9732606/uploads/origins/cfab17df-2bc2-4d2c-82f5-969931c7c5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a891f10bbf1bb375e3871459f5030e, https://si.imgix.net/e9732606/uploads/origins/cfab17df-2bc2-4d2c-82f5-969931c7c5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccaa2dd0af66576897d3e06459e8147c 2x, https://si.imgix.net/e9732606/uploads/origins/cfab17df-2bc2-4d2c-82f5-969931c7c5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5399cad9b90efb42d7661fe6cfff12f 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、先生！新しいリクエストをしたいです！私のOCのセレスティーヌと崩壊坏：星穹铁道の丹恒のために。\n\nCONTEXT\n丹恒は新しい力を得て、新しい姿になりました。その結果、彼は背が高くなり、よりはっきりとした筋肉を持っている。尻尾と金の角もある。\n\nシナリオ - 丹恒の新しい姿\nこれはあなたの想像に任せますが、セレスティーヌが丹恒の新しい姿に畏敬の念を抱くというシナリオをお願いしたいです。彼女は常に丹恒に触れ、賞賛している。丹恒は恥ずかしがりながらもそれを許す。彼はついに彼女を抱きしめ、新しい力で必ず彼女を守ると約束する。どこかにキスを入れるとか？キュートでロマンチックなものにするのは自由だ！\n\nこんなリクエストで大丈夫かな？いつものように、お時間とご配慮をありがとうございました！\n\nセレスティン参考：https://imgur.com/a/7KGq8fe\n丹恒腾荒参考：https://imgur.com/a/QyIa9dU", "created_at": "", "completed_at": ""}, {"path": "/@kaeito0213/works/13", "thumbnail_src": "https://si.imgix.net/dc8875f2/uploads/origins/5e4777f5-34ab-46eb-a97d-f46320120055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48a1cd0361d59c047d0e8278dcac49a0", "thumbnail_srcset": "https://si.imgix.net/dc8875f2/uploads/origins/5e4777f5-34ab-46eb-a97d-f46320120055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48a1cd0361d59c047d0e8278dcac49a0, https://si.imgix.net/dc8875f2/uploads/origins/5e4777f5-34ab-46eb-a97d-f46320120055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7bd832f783f7b4838b41f4c58ea7006 2x, https://si.imgix.net/dc8875f2/uploads/origins/5e4777f5-34ab-46eb-a97d-f46320120055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66d3427383744a4ca4d3fc4e226bbcd0 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、先生！新しいリクエストをさせてください！私のOC月林と原神の钟离です。\n\nプロポーズ\nこれはあなたの想像に任せますが、钟离がどのように月林にプロポーズするのか、あなたの想像をリクエストしたいです。指輪は自分で作るのでしょうか？プロポーズ前のデートはどうする？自由にかわいく、ロマンチックにしてください！\n\nこんなリクエストで大丈夫かな。お忙しい中、いつもありがとうございます！今回はどんな漫画になるか楽しみです！\n\n月参考：https://imgur.com/a/HMxjaeg\n钟离参考：https://imgur.com/a/pVzNYRA", "created_at": "", "completed_at": ""}, {"path": "/@kaeito0213/works/12", "thumbnail_src": "https://si.imgix.net/fdce87b0/uploads/origins/620d62d6-3c11-46f7-8d5e-f3ece5aba74a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f879dd67b42efce2a7cdd25062c9d4d", "thumbnail_srcset": "https://si.imgix.net/fdce87b0/uploads/origins/620d62d6-3c11-46f7-8d5e-f3ece5aba74a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f879dd67b42efce2a7cdd25062c9d4d, https://si.imgix.net/fdce87b0/uploads/origins/620d62d6-3c11-46f7-8d5e-f3ece5aba74a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f650dbef049ec54c6413c437d095a5a 2x, https://si.imgix.net/fdce87b0/uploads/origins/620d62d6-3c11-46f7-8d5e-f3ece5aba74a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8fdfe8b8a0b70462539a904e64f7cb5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n本海スターレールのダン・ヘンが新しいフォームになりました！角と尻尾がお気に入りです！\n\n私のOC（シー）とダンヘンが一緒にアンフォレウスのお風呂/サウナに入っているアートをお願いします！\n腰にタオルを巻いたダン・ヘンと、シーの胸にタオルを巻いたダン・ヘンを描いてください。\nダンヘンの新しい姿、シーの参考資料、そして背景としてアンフォレウスの風呂場を用意しました！\nこれを私のパソコンの背景にしたいので、1920 X 1080でアートを作ってください！\n\nhttps://drive.google.com/drive/folders/1j1IuLNAVte2-oZb5JT-ORLfNDbx4Ex90?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kaeito0213/works/11", "thumbnail_src": "https://si.imgix.net/39da03a2/uploads/origins/6befc953-0ee4-45fd-bf5e-a5fdec960eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61ce1c3ddd2453ba8385fdd061bb9405", "thumbnail_srcset": "https://si.imgix.net/39da03a2/uploads/origins/6befc953-0ee4-45fd-bf5e-a5fdec960eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61ce1c3ddd2453ba8385fdd061bb9405, https://si.imgix.net/39da03a2/uploads/origins/6befc953-0ee4-45fd-bf5e-a5fdec960eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8e027f908f5712a1b6411e17812d50a 2x, https://si.imgix.net/39da03a2/uploads/origins/6befc953-0ee4-45fd-bf5e-a5fdec960eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a3331683af036e4325a297fee187fe7 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、先生！新しいリクエストをしたいです！私のOCのセレスティーヌと崩壊坏：星穹铁道の丹恒のために。\n\nシナリオ - セレスティーヌの救出\n想像にお任せしますが、丹恒がセレスティーヌを危機から救う方法をリクエストしたいです。セレスティーヌが檻に閉じ込められていて、丹恒が水の力で檻を壊すとか？彼は間違いなく彼女の無事を心配して大騒ぎするだろう。でも、きっと感動的な再会を果たすだろう。詳細はあなたにお任せする！\n\nこんなリクエストで大丈夫だろうか。いつもながら、お時間とご配慮をありがとうございます！今回はどんな漫画になるか楽しみです！\n\nセレスティーヌ参考：https://imgur.com/a/