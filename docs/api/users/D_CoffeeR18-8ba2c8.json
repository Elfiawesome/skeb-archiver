して先走り汁まで溢している夜空くんのチンポを見て顔を赤らめているイメージのイラストを描いていただきたいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@D_CoffeeR18/works/23", "thumbnail_src": "https://si.imgix.net/3b1a21d5/uploads/origins/2c74c3bf-4918-468f-8e90-15e44bf6a2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e491f172f26f1da51732e0a59269b99", "thumbnail_srcset": "https://si.imgix.net/3b1a21d5/uploads/origins/2c74c3bf-4918-468f-8e90-15e44bf6a2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e491f172f26f1da51732e0a59269b99, https://si.imgix.net/3b1a21d5/uploads/origins/2c74c3bf-4918-468f-8e90-15e44bf6a2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d31aef9be9fe6c2e31e81f5863700521 2x, https://si.imgix.net/3b1a21d5/uploads/origins/2c74c3bf-4918-468f-8e90-15e44bf6a2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01378b47340840124a0f175d0bd73211 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@D_CoffeeR18/works/22", "thumbnail_src": "https://si.imgix.net/232d7da4/uploads/origins/d402a192-98c3-427b-91fa-98777daf0923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd3a87fbeab112f77870b6eca3aa8d34", "thumbnail_srcset": "https://si.imgix.net/232d7da4/uploads/origins/d402a192-98c3-427b-91fa-98777daf0923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccen