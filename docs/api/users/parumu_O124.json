f59d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c04b7164f51545972160b21623b99b7 2x, https://si.imgix.net/2af89cfa/uploads/origins/835c2935-fbd3-4af3-b4cc-40d29ef59d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7387209642abc5ea51357941b2c33c6f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！以前あなたに依頼した作品がとても気に入ったので、今回もぜひお願いしたいと思っています！\n\n今回はセクシーな警察官の衣装の依頼です！ポーズと警察服は最初の参考資料と同じようなもので、背景はgoogle driveの2番目の参考資料と同じようなシンプルなものを希望します～ 表情はお任せします！～ できれば、衣装の中に手錠も入れてもらえると最高です～。\n\nイラストは主にXのアイコンとツイートに使う予定ですが、よろしければお願いします。背景とキャラクターのレイヤーを分けたpsdを頂けると嬉しいです。\n\nご考慮いただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1_y4r1ftHZXsS3-EE47R8-cEqyZYGlgQ3?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@parumu_O124/works/64", "thumbnail_src": "https://si.imgix.net/53a84c74/uploads/origins/4e5d498e-e931-4ac2-9ebf-429b7ee79b99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0043ef4b1302de57dd2d9699a4f4c8", "thumbnail_srcset": "https://si.imgix.net/53a84c74/uploads/origins/4e5d498e-e931-4ac2-9ebf-429b7ee79b99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0043ef4b1302de57dd2d9699a4f4c8, https://si.imgix.net/53a84c74/uploads/origins/4e5d498e-e931-4ac2-9ebf-429b7ee79b99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a10096442fa18bb5d25900add414bff 2x, https://si.imgix.net/53a84c74/uploads/origins/4e5d498e-e931-4ac2-9ebf-429b7ee79b99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea7644f021f0dbb922ab67ef98437637 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵はとても素敵で、特に二人の人物が描かれている作品が好きです。\n\n一人目のキャラクター\n名前 = ウィロー\n性別 = 女性\n年齢 = 20歳\n身長＝168センチ\nウィローはマイロのパートナー。彼女は半人半蛾のデミ・ヒューマン・シルク・ガである。とても物腰が柔らかく、マイロと同じ大学に通っている。不器用に見えたり、おっちょこちょいに見えたりすることもあるが、頭脳明晰で、特に科学には長けている。\n\n2番目のキャラクター\n名前＝マイロ\n性別＝男\n年齢＝20歳\n身長＝180センチ\nマイロはウィローのパートナー。半人半鹿のデミ・ヒューマン・クワガタである。一人でいることが多く、クールな性格で慌てない。音楽が好きで、ウィローと同じ大学で舞台芸術を学んでいる。音楽はオルタナティヴ・ロックが中心で、同年代の間で人気が高まっている。\n\nキャラクターのポーズについては、ドライブリンクに参考になるものをリンクしておいた。緑がマイロ、オレンジがウィローになります。このポーズを忠実に再現する必要はありません。ちびスタイルで描かれていますが、これらのキャラクターは大人であることに注意してください。特にマイロは男性的です。\n\nもし量が足りなければ、遠慮なくこのリクエストを送り返してください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Nl_vCm_ywVV6WLJ4xcS7hZePHx-XGOLv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@parumu_O124/works/63", "thumbnail_src": "https://si.imgix.net/2cb86bc0/uploads/origins/e0048834-7848-449f-a92f-55bde07726e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6613cdd93862c90f6dc0cb968ae440", "thumbnail_srcset": "https://si.imgix.net/2cb86bc0/uploads/origins/e0048834-7848-449f-a92f-55bde07726e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6613cdd93862c90f6dc0cb968ae440, https://si.imgix.net/2cb86bc0/uploads/origins/e0048834-7848-449f-a92f-55bde07726e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aed0c30c171070509ad2b7de34aa2010 2x, https://si.imgix.net/2cb86bc0/uploads/origins/e0048834-7848-449f-a92f-55bde07726e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d37169ec5413127abd4d48a588c655c2 3x", "genre": "art", "nsfw": false, "body": "あなたのアートは本当に美しい！\n\n私のキャラクターはファイナルファンタジーのミコテで、スターバードを仲間にしています。スターバードが飛んでいたり、肩に止まっていたりして、スターバードと交流してほしいのですが、大きな問題になるようでしたら、自由に創造してください。彼女の服装と武器のリンクを貼っておきます。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1_GVfGvR-n-L5XiffEmtgTtpPBZcDBYmA?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@parumu_O124/works/62", "thumbnail_src": "https://si.imgix.net/1cb83008/uploads/origins/2e84640c-6e12-4bfd-8350-ab9278ab4012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=283d397b277fd03022dede9bf3ac6ad3", "thumbnail_srcset": "https://si.imgix.net/1cb83008/uploads/origins/2e84640c-6e12-4bfd-8350-ab9278ab4012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=283d39