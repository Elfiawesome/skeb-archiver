, "created_at": "", "completed_at": ""}, {"path": "/@yoyodol09/works/19", "thumbnail_src": "https://si.imgix.net/8327588e/uploads/origins/4ab3fc0c-2c22-477c-8ba7-65c0ebbd6219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27be28bb8077908ff6c286682d1c086e", "thumbnail_srcset": "https://si.imgix.net/8327588e/uploads/origins/4ab3fc0c-2c22-477c-8ba7-65c0ebbd6219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27be28bb8077908ff6c286682d1c086e, https://si.imgix.net/8327588e/uploads/origins/4ab3fc0c-2c22-477c-8ba7-65c0ebbd6219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=481d13474f5989afd28f905d3b944934 2x, https://si.imgix.net/8327588e/uploads/origins/4ab3fc0c-2c22-477c-8ba7-65c0ebbd6219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b961bdb3bdf4c5d816b8a565b34d562 3x", "genre": "art", "nsfw": false, "body": "ペンキモンスターにTFしちゃったヨッシーが見たいです！\n\nペンキの色はURLに載せます。\n見た形はヨッシーですが、中身が全部ペンキでできており、伸びる舌もペンキでできています\n\nよろしくお願いします！\n\nhttps://images.app.goo.gl/jvLrxKxz4SFqpSkY6", "created_at": "", "completed_at": ""}]}