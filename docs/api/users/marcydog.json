73-8109-792925c26913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c7f4eb73a6027363c47fa0e75a1aba", "thumbnail_srcset": "https://si.imgix.net/01d03e50/uploads/origins/a7d1d069-9cf5-4773-8109-792925c26913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c7f4eb73a6027363c47fa0e75a1aba, https://si.imgix.net/01d03e50/uploads/origins/a7d1d069-9cf5-4773-8109-792925c26913?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4d83caa73da4391410eaf305e9f1e30 2x, https://si.imgix.net/01d03e50/uploads/origins/a7d1d069-9cf5-4773-8109-792925c26913?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f887569ecd2ac1d741c08fb5ac0d5bd 3x", "genre": "art", "nsfw": true, "body": "D.C.Ⅱの朝倉由夢をお願いできますでしょうか？\n服装はマジシャンミクのようなシルクハットと燕尾服にレオタードでお願いします。\n\n内容は男のアナル責めマジックです。カラー画像でお願いします。構図は男は膝を抱えた状態で箱の中に固定され、尻だけが箱の穴から出ている状態でお願いします。キャラクターはその横に立ちアナルを色々弄る形になります。\n\nまず、「それじゃ、お尻を使ったマジックだよ。まずは魔法をかけるね」と言い、白手袋をはめたまま人差し指でチョンチョンとアナルを触り、その後中指で掬い上げるようにアナルを触ります。次にタクトのようなステッキで先端をアナルにトントンと叩きます。\n\nその後、「さあ、何が出てくるかな？」と人差し指と親指でアナルをほじくり、「すごーい！旗が出てきたよ！」と万国旗を引き出してください。\n\n次に、「ちょっと熱いけど、頑張ってね」と赤い蝋燭の火でアナルを炙り、その蝋燭をアナルに突き刺します。\nそして、抜いた後に「どう？気持ちいい？」とアナルへ蝋燭責めを行います。蝋燭は、アナルが完全に隠れるまでかけてください。\n\n次に、蝋燭を剥がしたあと赤い布でアナルを隠し、「ワン、ツー、スリー！」でアナルに刺さった花（種類は桜が咲いた木の枝部分）を出現させるマジックを行います。\n\nその後、「次は串刺しマジックだよ。まずはこれ！」とハサミをアナルに突き刺し、抜いてください。ハサミには腸液が付着し、アナルから糸をひかせてください。\nその後、アナルに「最後に、お尻にもうちょっとおまじない（ハートマーク）」とアナルにキスをしてフェンシングに使うような長さの剣を「それじゃいくよ、えいっ！」と一気に根本までアナルに突き刺してください。\n\n「ほら！お尻に剣が刺さったよ！」と言い、「じゃあ、抜くよ」と言いながらすーっとゆっくり抜き、最後に「お尻は元通り！よく頑張ったね、二人だけのアナルマジックショー、楽しかった？」とまたアナルにキスをして終了です。\n男は終始、気持ちよさと緊張で息を荒くして喘いでいるだけで結構です。", "created_at": "", "completed_at": ""}, {"path": "/@marcydog/works/77", "thumbnail_src": "https://si.imgix.net/ccc9c47c/uploads/origins/efde97df-03cc-4a15-b9e8-3a05266e834d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f67a33e768c6565483a1aa18d7e2f12", "thumbnail_srcset": "https://si.imgix.net/ccc9c47c/uploads/origins/efde97df-03cc-4a15-b9e8-3a05266e834d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f67a33e768c6565483a1aa18d7e2f12, https://si.imgix.net/ccc9c47c/uploads/origins/efde97df-03cc-4a15-b9e8-3a05266e834d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a7ecf86816e802ec47983595b73fd68 2x, https://si.imgix.net/ccc9c47c/uploads/origins/efde97df-03cc-4a15-b9e8-3a05266e834d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c9126bee3654ba43a58237d6305c14c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marcydog/works/76", "thumbnail_src": "https://si.imgix.net/d4825063/uploads/origins/25ec6c00-c96f-42ca-b64a-cd9ff0551e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8ea8b66ac1474ff1e447004b7e4cecd", "thumbnail_srcset": "https://si.imgix.net/d4825063/uploads/origins/25ec6c00-c96f-42ca-b64a-cd9ff0551e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8ea8b66ac1474ff1e447004b7e4cecd, https://si.imgix.net/d4825063/uploads/origins/25ec6c00-c96f-42ca-b64a-cd9ff0551e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15ac43b31ddfb93d57b68dbfaaa8bd93 2x, https://si.imgix.net/d4825063/uploads/origins/25ec6c00-c96f-42ca-b64a-cd9ff0551e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66a643b9c913e5d889af37ca3caf7287 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marcydog/works/75", "thumbnail_src": "https://si.imgix.net/72034ac8/uploads/origins/57807717-9733-440c-af80-664c9ac4bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901eafea6e4c1ff2301e8b147e3ec9cd", "thumbnail_srcset": "https://si.imgix.net/72034ac8/uploads/origins/57807717-9733-440c-af80-664c9ac4bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901eafea6e4c1ff2301e8b147e3ec9cd, https://si.imgix.net/72034ac8/uploads/origins/57807717-9733-440c-af80-664c9ac4bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d64db87e5d54b4f16a4f30388a71b1ca 2x, https://si.imgix.net/72034ac8/uploads/origins/57807717-9733-440c-af80-664c9ac4bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a634fd665554ecef102d6319e6505416 3x", "genre": "art", "nsfw": true, "body": "プリンセスコネクトのキョウカちゃんがおじさんと駅弁スタイルでキスハメしているイラストをお願いします。\n\nキョウカちゃんの服は着衣のまま、落ちないようにおじさんの首に両手を回してラブラブでブチュブチュとキスしながら幸せそうにセックスさせて欲しいです。", "created_at": "", "completed_at": ""}, {"path": "/@marcydog/works/74", "thumbnail_src": "https://si.imgix.net/030de70b/uploads/origins/4a363f03-4463-4d7f-96df-636c19f5254b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7698d9f72ac433246899ed8496fbb94a", "thumbnail_srcset": "https://si.imgix.net/030de70b/uploads/origins/4a363f03-4463-4d7f-96df-636c19f5254b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7698d9f72ac433246899ed8496fbb94a, https://si.imgix.net/030de70b/uploads/origins/4a363f03-4463-4d7f-96df-636c19f5254b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e00bb61203edc8c3204ab739344b936 2x, https://si.imgix.net/030de70b/uploads/origins/4a363f03-4463-4d7f-96df-636c19f5254b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caa4ae6d5fdcb9e1cb38dfcf83417380 3x", "genre": "art", "nsfw": true, "body": "ブラウンダスト２というソシャゲから、\nレピテアと言うキャラの花嫁衣裳でのイラストを依頼させて頂きます\n\nシチュエーションは、レピテアが中年のおじさんに\n「未来の旦那様を悦ばせる為の花嫁修業だ」と騙され、\nアナルを犯されてしまう様子でお願いします\n\n恥ずかしがりながらも疑問を抱くレピテアですが、\n「お尻の穴だから練習だよ」といった感じで言いくるめられてしまい、\n最終的には中出しされてアナルで絶頂してしまいます\n\nポーズはまんぐり返しで自分で両足を抱え、股間を突き出して\n恥丘も肛門も丸見えになっている体勢でお願いします\n\n可能ならば、アナルに挿入前、挿入後、中出し絶頂、各差分もお願いします\n挿入前は恥ずかしそうにしながらドキドキしている表情で\n挿入後は戸惑いながらしっかり感じてしまい、\n中出しでは目を閉じて激しく絶頂してる表情をお願いします\n\nキャラクターの簡単なイメージですが、\nレピテアは一人称は「レピ」で、敬語は使わず、\n～だよ、～だもん、といった無邪気な喋り方をします\n誰とも分からぬ未来の旦那様と結婚する日を夢見ており、\n自分はもう立派な大人だと背伸びしています\n簡易的な台詞を入れて下さる場合は参考にして下さい\n\n以下、キャラの資料になります\n\nhttps://i.imgur.com/87qFmnP.jpeg\nhttps://i.imgur.com/8Hp4zxK.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@marcydog/works/73", "thumbnail_src": "https://si.imgix.net/cce02df5/uploads/origins/2fc43a33-f504-43b7-b36d-ac0cd2025332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4369476b5873fae692f815d8aa4e46b", "thumbnail_srcset": "https://si.imgix.net/cce02df5/uploads/origins/2fc43a33-f504-43b7-b36d-ac0cd2025332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4369476b5873fae692f815d8aa4e46b, https://si.imgix.net/cce02df5/uploads/origins/2fc43a33-f504-43b7-b36d-ac0cd2025332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7da0bd1c0e381c217f39ee66e006108e 2x, https://si.imgix.net/cce02df5/uploads/origins/2fc43a33-f504-43b7-b36d-ac0cd2025332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro