ize=30&txt=PRIVATE&s=c5c3aa9d82336a4c2d2c6b54070fae8a", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/28", "thumbnail_src": "https://si.imgix.net/0783aa26/uploads/origins/b6278621-1b74-4372-8032-61c509017a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=200eca2f9de54631bd650be39e148bd2", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "はじめまして、いつも作品楽しく拝見させていただいております。\n\n存在しない漫画の１コマbotさん（https://x.com/noreal_koma）\nのキャラクターである「狐鳴紺子郎（こなり こんしろう）」くんを描いていただきたいです！\n\nおっぱいを強調したような構図・アングルで、ニヤッとした表情で愛息を誘惑している感じでお願いします。\nカラーリングは発表されてないので、サルシッチャ牧野先生の想像にお任せ致します。\n（pixivなどで狐鳴紺子郎と検索すると、髪色は金髪派の人が殆どなようです）\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/15MOVsVcy_AncTIH3UZA2xTQzy7hA1g_s", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/27", "thumbnail_src": "https://si.imgix.net/12d833f6/uploads/origins/1676d649-53a1-4b3a-9423-791b73308bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70849869c3758ffeaca4275237c4a076", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "ブルアカの、制服の美甘ネルちゃんを描いて頂きたくてですね。\n制服の下にぴっちりなやつ着てるとこ見せてほしい……恥ずかしがってるとなお良い……", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/26", "thumbnail_src": "https://si.imgix.net/ab2cbd0a/uploads/origins/4e5d3fae-77f0-4179-8d45-03f824387334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5496f25f6c04b25b30ea07e00d887343", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/25", "thumbnail_src": "https://si.imgix.net/7a4a3bdb/uploads/origins/200088fa-8610-419a-90ac-6e512cb9f781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3a0b1eae6a7a903da092fa94d582089", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/24", "thumbnail_src": "https://si.imgix.net/27fb57ef/uploads/origins/16af3e33-a999-4619-acf4-d30d290fd5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ac13db0d7f04ad4c59ed519453bec9", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "はじめまして！私のOC、リリーのイラストをお願いします！白と黄色のツートンカラーの水着を着ています。伸びをしてカメラを見返しています。セクシーでお願いします！表情は自由です。\n\nBカップのバストと自然な黒い肌（日焼けしていません）にご注目ください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-XA3nlPlVkdd8MAEmN0J7d3vjbNlGOgN?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/23", "thumbnail_src": "https://si.imgix.net/e4ccc6eb/uploads/origins/8bb9a2e5-3bd4-4dcd-a308-e03938397258?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af56c6818f98b0dfe435bb08dc7beeb9", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/22", "thumbnail_src": "https://si.imgix.net/488a0f4a/uploads/origins/6a730853-b82b-41ac-85cc-ee80d09ccb78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=571ff3174bff894766c0226b2876fef9", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "見たいので刃尾カンナさん描いてくださーぃ。\n立って机に両肘をおくと御尻突き出すような体制になってセクシーっぽさが溢れると思うんですよ。\n軽率に水着を着せたいけど制服の姿も見たい…ならば上と下で衣装を分ければ解決！！というひらめきを得たので、そんな感じにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/21", "thumbnail_src": "https://si.imgix.net/f93d1d8d/uploads/origins/ecfacbc8-252c-4a94-af5e-95ec104f302d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45fa6cdcfc89619a0199c44035f65880", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/20", "thumbnail_src": "https://si.imgix.net/4894e8f8/uploads/origins/e99b0319-d529-4377-ab3d-bee9ef399ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc919bd249028f0bd5966c6f551aba08", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "メディア欄を見ていたら、眼鏡、褐色、ベリショの娘がいますね？\nもっと描いて欲しいのでお願いしまーす！\n最近応援されたい気持ちが強いのでチアガール衣装を希望。", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/19", "thumbnail_src": "https://si.imgix.net/e676bca0/uploads/origins/2d22fe73-8203-4964-adc3-bf629cb2ca77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b6900ce1183933444b316b67ed60b1e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/18", "thumbnail_src": "https://si.imgix.net/55cd505d/uploads/origins/fd9fa4fe-262b-40c4-b87b-9b05cd524c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ef15fcac5ca94aa62725212ae53e9b0", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/17", "thumbnail_src": "https://si.imgix.net/ada33279/uploads/origins/277c78d3-e80c-4585-ad19-39238995ef83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb59c84b76a49719c7cc135ea75d6c35", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "ウサギ年ですし、カジノに現れそうなバニーガールを描いて欲しいです。\nキャラクター指定はありません。\n\n\n\n自由に描いて欲しいのですが、なにも浮かばない時はFGOのにとくりすさんをバニー姿で......", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/16", "thumbnail_src": "https://si.imgix.net/5c669615/uploads/origins/619d2fe1-d6d4-4a11-bfc9-bed7e71146c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1614173fe2f3f829f18aa4b6949a1be7", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは！\n拙作キリングミーキリングユーの主人公ミーティアをお願いします。（添付ツイ2枚めの画像）\n荒廃した世界で死ぬために旅をしている不死の少女と男の物語です。\nミーティアのお尻か太ももが魅力的に見える構図でお願いします。\n背景の有無は問いません。\n作品の雰囲気が見えるとより嬉しいです。宜しくお願いします。\n\nhttps://twitter.com/Immortal1664/status/1490222061943361539/photo/2", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/15", "thumbnail_src": "https://si.imgix.net/b541285f/uploads/origins/e2283a00-3a56-4138-a8ac-7c7556438716?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2c37e64b6dc83c42959970043fdf3f", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは。\nキャラクター https://pasteboard.co/AHR6ZQhZ29cD.jpg ノーパンです。\nミスティは太ももが太くてお尻が大きい。ブロック（タケシ）はかなり大きなペニスと日焼けした肌を持っています。彼女は高速で激しい足コキをする。彼は彼女のアソコとお尻の穴に指を入れる。激しい射精と膣内液。汗をかいて、顔を赤らめて、発情する。", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/14", "thumbnail_src": "https://si.imgix.net/e0a44851/uploads/origins/3ae9c010-039f-45ef-95dd-67fafc8308a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558e901e0bafaa429147f3f8a50d9243", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "ヒロアカの芦戸三奈をリクエストします。\n\n・お尻を正面に向け手で尻穴を広げて見せている体勢\n・尻穴は大きくぽっかり開いている\n・楽しそうに誘うような表情\n・服装はヒーロースーツで肛門周りだけ破れている\n\nもしよろしければお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/13", "thumbnail_src": "https://si.imgix.net/856a6896/uploads/origins/14a0567b-f4fd-4c00-8bf0-5616a0ba7f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=672de845c5c50fa6f37a0b5fb421e058", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "FGOの謎のヒロインXXをリクエストさせて下さい。\n\n①ビキニではなく競泳水着を着用したXXの立ち絵をお願いします。\n・水泳のインストラクターっぽいイメージ\n・表情は元気な笑顔\n・競泳水着の色合いはビキニと同じような感じ\n\n②立ち絵の背景に平泳ぎで泳いでいるXXを後ろから追走しているスイマーの視点と\n　いった感じの大股開きな股ぐらのドアップ画像をお願いします。\n　（立ち絵で隠れてしまっても構いませんので、できる限り大きくお描き頂きたいです）\n\nまた、①のみの画像、②のみの画像で分離できるようにして頂きたいです。\n\nもしよろしければ、お引き受け下さると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/12", "thumbnail_src": "https://si.imgix.net/ebd532fc/uploads/origins/50e36a35-56ac-4429-b070-cae97579c0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3893201fd6f4c95084f5906a0667094", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "ヴォワール先生の顔の上でペニスをオナニーしている私の教授の男の子を描いてください。精液が顔を覆っている射精編集の2ndバージョン。\n\nhttp://refsheet.net/nanosheep/drvoir\n\nhttp://refsheet.net/nanosheep/nanosheep", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/11", "thumbnail_src": "https://si.imgix.net/75fdabec/requests/186818_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac2f012cbd461aa9f43b8d6df677188", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "FF14の自キャラのミコッテをお願いします。\n構図はお任せしますが、戦闘を楽しんでいるシーンだと嬉しいです。(ジョブは忍者です)\n・目はオッドアイです(青-紫)\n・鼠蹊部が見えていると嬉しいです\n・可能ならば、資料右側の画像にいるナマズも描いて下さると嬉しいです\n\nhttps://twitter.com/dead_mana/status/1297324507984584706?s=21", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/10", "thumbnail_src": "https://si.imgix.net/07a2ea65/requests/173396_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d73311dca2b34d21509b081fd9cc3df", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "自分@zundarinda0512のオリジナルキャラクターであるエイドを描いていただけないでしょうか……！\n健全でもr-18でも構いません。膝下くらいまで描いていただけると嬉しいです。\n\nhttps://twitter.com/zundarinda0512/status/1318906408914481154?s=21", "created_at": "", "completed_at": ""}, {"path": "/@salsiccia_m/works/9", "thumbnail_src": "https://si.imgix.net/360e68e8/requests/158285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f67e27c8d610fe79245ef75ece8d5d6", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "complete