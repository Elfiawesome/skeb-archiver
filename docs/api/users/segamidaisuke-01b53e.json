at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c4a606181adecc243614fe100c0e774 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/287", "thumbnail_src": "https://si.imgix.net/8d028d87/uploads/origins/539ea503-cad3-418c-ad03-12bc492e6b44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b11d17fc5a5c55f2d0627473a2365f8", "thumbnail_srcset": "https://si.imgix.net/8d028d87/uploads/origins/539ea503-cad3-418c-ad03-12bc492e6b44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b11d17fc5a5c55f2d0627473a2365f8, https://si.imgix.net/8d028d87/uploads/origins/539ea503-cad3-418c-ad03-12bc492e6b44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80571e5f4b29ec3ecbc713fd42f7d60d 2x, https://si.imgix.net/8d028d87/uploads/origins/539ea503-cad3-418c-ad03-12bc492e6b44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ea2c75cd946ebf06f3b6553a87e6fbf 3x", "genre": "art", "nsfw": true, "body": "初めまして。よろしければリクエストお願いします。\nキャラクターですが、ボーグマン２よりイライザ（悪堕ち容姿）\nシチュエーションですが背面駅弁のような体勢かつ両手を拘束された状態で手マン＆胸もみ攻めシチュをお願いします。\n基本構図はhttps://skeb.jp/@segamidaisuke/works/246のような感じで\nイライザの容姿ですが、胸は大きめで、汗は多めで。\n基本\n・拘束された状態で悔しそうな表情で睨んでいる\n差分\n・手マン＆胸もみ攻めが開始され、上の服がはだけ状態で胸が露出している。表情は頬を赤めらせつつも「この程度なの」という感じの嘲笑みがある表情で\n・盛大に潮吹き＆オホ顔絶頂\n\nhttps://drive.google.com/drive/folders/1nMai_e98CIwrn1tE59z2SHh7X8ndTsl0?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/286", "thumbnail_src": "https://si.imgix.net/f56fdcd7/uploads/origins/e6e020f2-6570-4550-af53-367d29ae6744?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ca540dd03e11565d59e14d83293214b", "thumbnail_srcset": "https://si.imgix.net/f56fdcd7/uploads/origins/e6e020f2-6570-4550-af53-367d29ae6744?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ca540dd03e11565d59e14d83293214b, https://si.imgix.net/f56fdcd7/uploads/origins/e6e020f2-6570-4550-af53-367d29ae6744?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b1c995a601d7318f9e7ee20fbb6eb48 2x, https://si.imgix.net/f56fdcd7/uploads/origins/e6e020f2-6570-4550-af53-367d29ae6744?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3145368f2aef76c92f9ea97f77f36e3d 3x", "genre": "art", "nsfw": false, "body": "何度もお世話になりありがとうございます、瀬上大輔先生。よろしければもう一件お願いしたくリクエストしました。\n\n■キャラ　魔法少女リリカルなのはシリーズからヴィータちゃんと八神はやてさん\n■衣装　指定無し\n\n〇はやてちゃんからベロチューキスされるヴィータちゃんのイラストを希望します\n☆ヴィータちゃんは総受け　バリタチなはやてちゃんに半無理やりチュッチュされるシュチでお願いします\n・舌を出すことを強要されるヴィータちゃん　もうチュウはらめぇとなっても舌を絡められる\n・Sっポイジト目等の余裕がありそうな表情を希望します\n\nもしよろしければ検討して頂けると嬉しいですよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/285", "thumbnail_src": "https://si.imgix.net/3befd611/uploads/origins/ace2c0b3-807e-4b9c-b0a1-f338a7b2e901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ae57b2981ae3dfe2af4d3b48829882b", "thumbnail_srcset": "https://si.imgix.net/3befd611/uploads/origins/ace2c0b3-807e-4b9c-b0a1-f338a7b2e901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ae57b2981ae3dfe2af4d3b48829882b, https://si.imgix.net/3befd611/uploads/origins/ace2c0b3-807e-4b9c-b0a1-f338a7b2e901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7809777979deace9d48575bdfcc0f364 2x, https://si.imgix.net/3befd611/uploads/origins/ace2c0b3-807e-4b9c-b0a1-f338a7b2e901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3603559a00a05bddd14c8d362052566 3x", "genre": "art", "nsfw": true, "body": "リクエストを送らせて頂きます\nキャラクターはドラクエシリーズのサマルトリアの王女(以降王女表記)↓とマリベル↓↓､マリベルの方が(恐らく)年上なので､マリベルの身長を王女より高くする\nhttps://www.dragonquest.jp/roto-trilogy/dq1and2/character/princess_samarutoria.html\nhttps://www.dragonquest.jp/dq7r/character/maribel.html\n貴方の過去作[退魔閃士リン]のように､[触手スーツに犯される]に､スライム出産要素を加えた作品をお願いします\n腹部はボテ腹\n衣装はナンバーズスーツを元にして､スライム↓がスーツに変身して纏わりついているという設定(色はナンバーズスーツのまま)\nhttps://dragonquest.fandom.com/ja/wiki/%E3%82%B9%E3%83%A9%E3%82%A4%E3%83%A0\nスーツの何処かにスライムの顔が浮かぶ\n構図は王女は↓､マリベルは↓↓参照で､王女を画面右､マリベルは画面左に配置\nhttps://www.pixiv.net/artworks/118083216\nhttps://www.pixiv.net/artworks/35410088\n\n\n[シチュエーション]\n成り行きでモンスターマスターになった2人\n[人間の胎から生まれたスライム系は尋常じゃない強さに育つ]という噂を聞いて､試してみたところ､スライム出産にハマってしまった\nより強いスライムを､より強い快感を求めて､[配合]を続けるのであった\n\n\n[絵の内容]\n・基本\nスライムに塗れた室内\nスーツは股座も覆っている(マン筋クッキリ)\n余裕な笑みの2人\n・差分1\n股座部分をスーツで覆ったままバブルスライム↓を大量噴射\nhttps://dragonquest.fandom.com/ja/wiki/%E3%83%90%E3%83%96%E3%83%AB%E3%82%B9%E3%83%A9%E3%82%A4%E3%83%A0\n目を瞑って絶頂&絶叫する2人\n・差分2\n両耳にスライムの細い触手を挿入される2人\nオホ顔の王女\n蕩けた顔のマリベル\nさらにバブルスライムを噴射する\n可能なら2人の口にバブルスライムが入り込む", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/284", "thumbnail_src": "https://si.imgix.net/746c9fa1/uploads/origins/02b56d68-14b5-4447-a2c4-f9aec4e01d60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d54eaf87a574a6205831b1cdd6e9e31", "thumbnail_srcset": "https://si.imgix.net/746c9fa1/uploads/origins/02b56d68-14b5-4447-a2c4-f9aec4e01d60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d54eaf87a574a6205831b1cdd6e9e31, https://si.imgix.net/746c9fa1/uploads/origins/02b56d68-14b5-4447-a2c4-f9aec4e01d60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53e7c0fd1f27b52fb281710e9bbe2515 2x, https://si.imgix.net/746c9fa1/uploads/origins/02b56d68-14b5-4447-a2c4-f9aec4e01d60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ce0f2ebaec9a22286a27ccf436692e6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/283", "thumbnail_src": "https://si.imgix.net/a64e2dde/uploads/origins/a06a859f-edde-4c85-a6c9-95fad1372ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd1d23ce75ce095c0431e48505933a89", "thumbnail_srcset": "https://si.imgix.net/a64e2dde/uploads/origins/a06a859f-edde-4c85-a6c9-95fad1372ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd1d23ce75ce095c0431e48505933a89, https://si.imgix.net/a64e2dde/uploads/origins/a06a859f-edde-4c85-a6c9-95fad1372ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a34437af214e0559949cfa6d7d135bdd 2x, https://si.imgix.net/a64e2dde/uploads/origins/a06a859f-edde-4c85-a6c9-95fad1372ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4125569a754593883aa79d411743aa5f 3x", "genre": "art", "nsfw": true, "body": "先日描いて頂きました、対魔使用人サクヤがザコ敵の不意討ち攻撃を喰らってしまうイラストの続きをお願いします。\n\n自爆攻撃を喰らって大きなダメージを負いボロボロの姿になりながらも、何とか気力を振り絞り、フラフラとした足取りでダンジョン内を歩いているところを描いて頂きたいです。\n※足から頭まで、彼女の全身が入る様にお願いします。\n\nhttps://skeb.jp/@segamidaisuke/works/281", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/282", "thumbnail_src": "https://si.imgix.net/d3245376/uploads/origins/31a21e4a-c065-444c-b6ef-5211a515fe3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b32164b8e6f595073b4e3e1a3ec4ea45", "thumbnail_srcset": "https://si.imgix.net/d3245376/uploads/origins/31a21e4a-c065-444c-b6ef-5211a515fe3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b32164b8e6f595073b4e3e1a3ec4ea45, https://si.imgix.net/d3245376/uploads/origins/31a21e4a-c065-444c-b6ef-5211a515fe3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9467c07fb73e7f3b2259d5cb5964035e 2x, https://si.imgix.net/d3245376/uploads/origins/31a21e4a-c065-444c-b6ef-5211a515fe3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=005cd00b1119eae9337808df7d37bc03 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n今回はオリジナルキャラクターのイラストを依頼したいと思います。\n\n【キャラクター概要】\n戦うヒロインのライバル的な立ち位置のキャラです。\n妖魔の世界で“最強クラスの美少女剣士”と呼ばれる存在です。\n人間界では東京都内の公立高校に通うギャル女子高生の姿で潜伏しています。\n見た目は華やかなギャルですが、その正体は妖魔一の剣士であり、戦闘時は妖気をまとう妖艶な美しさを放ちます。\n\n⸻\n\n【服装・外見】\n\t•\t服装： 都内の一般的な公立高校の制服（ブレザータイプ）。\n　→ ブレザーは少し着崩している。\n　→ スカートは短め、ルーズソックス or ニーハイ。\n\t•\t髪： 銀髪のロングヘア。\n\t•\t瞳： ルビーのような紅い瞳。人間離れした透明感と妖艶さ。\n\t•\t体型： モデル顔負けのグラマラスなプロポーション。\n\t•\t表情： 明るく挑発的な笑み、もしくは自信に満ちた目線。\n       ・武器は刀で腰に下げています。ギャルですが、剣に関しては真剣なため、装飾はありません。\n・ヒロインよりも強キャラなために、ギャルの格好で基本は戦いますが、本気になると本来の妖魔の姿になります。白目が黒くなり、角が生えて、黒いドレスのような服と、鋭い爪のある異形の手足に変化します。\n\n【その他希望】\n\t•\t全身立ち絵でお願いします。\n       ・    できれば、JKの状態と本気モードの二つを並べて描いてください。\n\t•\t背景はシンプル or 透過で大丈夫です\n\nよろしくお願いします。資料URLは別の方に依頼したヒロインの姿です。今回のキャラクターはこのヒロインのライバルとなります。\n\nhttps://x.com/yaeba209241/status/1969310179473654269?s=61", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/281", "thumbnail_src": "https://si.imgix.net/3d42e781/uploads/origins/db408868-2c73-47ad-b828-1b8a13df8c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94cb9ec0ab27e66b4d1719969b5364e9", "thumbnail_srcset": "https://si.imgix.net/3d42e781/uploads/origins/db408868-2c73-47ad-b828-1b8a13df8c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94cb9ec0ab27e66b4d1719969b5364e9, https://si.imgix.net/3d42e781/uploads/origins/db408868-2c73-47ad-b828-1b8a13df8c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eb95703545ae9d5b769921b557aac5f 2x, https://si.imgix.net/3d42e781/uploads/origins/db408868-2c73-47ad-b828-1b8a13df8c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec5f73e822bc2bb1b67bb8e0291f1295 3x", "genre": "art", "nsfw": true, "body": "対魔使用人サクヤが、探索中にザコ敵の不意討ち攻撃を喰らってしまうイラストをお願いします。\n\n以下の流れを、彼女の全身が入る構図で描いて頂きたいです。\n\n森または荒地の中、あるいはダンジョン内部などを独りで歩いている場面。\n↓\n突然ザコ敵が襲いかかってきた場面。\n※ザコ敵は栽培マンをモデルにして頂ければと思います。\n↓\n特に動じることもなく、一瞬で敵を倒した場面。\n↓\nしかし完全には倒しきれておらず、油断していた隙をつかれて脚にしがみつかれてしまい、慌てる場面。\n↓\n次の瞬間、敵が自爆する場面。\n↓\n煙が消え去った後、見るも無残な姿で呆然とした表情のまま、その場で突っ立っている場面。\n※スーツはボロボロに破れてボロ布程度しか残っておらず、かつ両脚とも膝から下の部分は裸足の状態でお願いします。\nまた身体は煤で汚れ、ホワイトブリム等の髪飾りは吹き飛ばされて消失し、髪も逆立つ感じでボサボサに乱れている様に描いて頂けると嬉しいです。\n(アフロにはしないでください)\n\n以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/280", "thumbnail_src": "https://si.imgix.net/70788dbd/uploads/origins/d28ea597-8f90-4c6d-a3b2-10bad6ea8d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3252343f80963ba81128f82ffd255445", "thumbnail_srcset": "https://si.imgix.net/70788dbd/uploads/origins/d28ea597-8f90-4c6d-a3b2-10bad6ea8d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3252343f80963ba81128f82ffd255445, https://si.imgix.net/70788dbd/uploads/origins/d28ea597-8f90-4c6d-a3b2-10bad6ea8d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f802f8f0f02192de89312534c3004f5 2x, https://si.imgix.net/70788dbd/uploads/origins/d28ea597-8f90-4c6d-a3b2-10bad6ea8d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2c26775cab9a410b7a43f0ff7e75479 3x", "genre": "art", "nsfw": true, "body": "何度もお世話になりありがとうございます、瀬上大輔先生。もししよろしければ一件お願いしたくリクエストします。\n\n■キャラ　魔法少女リリカルなのはシリーズからヴィータちゃんと八神はやてさん年齢はお任せします\n■衣装　ヴィータちゃんは対魔忍コスで　はやてさんは指定無し\n\n〇対魔忍コスのヴィータちゃんがはやてちゃんに責められら「らめぇ♡」と呂律が回らなくなるまで堕とされるイラストを希望します\n\n☆シチュは娼館で奴隷娼婦に躾られる対魔忍イメプレコスＨシチュでヴィータちゃんは管理者権限で強制発情状態にされ感度３０００倍にもされています\n☆プレイ内容はお任せはやてちゃんが直接でも機械や触手等の使用するものでも構いませんお任せします\n★ヴィータちゃんの痛がる反応はNGでお願いします\n\nもしよろしければ検討して頂けると嬉しいですよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/279", "thumbnail_src": "https://si.imgix.net/6f0fdaf5/uploads/origins/0a8fafb9-0f8a-4ac4-9a03-ace253cf3372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f98ec3053e4f0ea5abe772a9a13023e5", "thumbnail_srcset": "https://si.imgix.net/6f0fdaf5/uploads/origins/0a8fafb9-0f8a-4ac4-9a03-ace253cf3372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f98ec3053e4f0ea5abe772a9a13023e5, https://si.imgix.net/6f0fdaf5/uploads/origins/0a8fafb9-0f8a-4ac4-9a03-ace253cf3372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7aa73814b1d97b3cc95d841f087aabd3 2x, https://si.imgix.net/6f0fdaf5/uploads/origins/0a8fafb9-0f8a-4ac4-9a03-ace253cf3372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5460eb6ff3a3a5bd7560a8b5fbced9d4 3x", "genre": "art", "nsfw": true, "body": "リクエストを送らせて頂きます\nキャラクターは魔法少女リリカルなのはStrikerSのスバル・ナカジマ↓\nhttps://www.nanoha.com/archive3/character/subaru.html\n衣装はナンバーズスーツを元にして､スライムか触手がスーツに変身して纏わりついているという設定(色はナンバーズスーツのまま・スーツの何処かに拳くらいの大きさの眼球が浮かぶ)\n腹部はボテ腹\n構図は[媚肉の監獄]収録の[Demon's seed 〜After〜]の､[脳を弄られたセリアが､「ほぐれた様だし〜」と言われながら､挿入される直前の場面]か､[シャロンが最後のページで､「この―数億の〜」と言って､腹部を撫でている場面]を参考に､過去に描いて頂いたリーリエの時と同様のスライムに塗れた室内\n\n[シチュエーション]\nStrikerS本編終了後の世界\nとある管理外世界で仕事を終えたスバル\nトラブルが起きて帰還出来ない為､復旧まで管理外世界で過ごす事になった\nその世界は他の世界とは性に関する倫理観や価値観が異なる為､スライムや触手を使った出産プレイが､一般的な娯楽として扱われていた\n当初こそ抵抗感が強かったスバルだが､今では完全に虜になり､正義の心すら揺らぎかけていた\nそれでもスバルが､根底に持つ善性を失わない理由は､アフターケアによって脳を修復され､快楽で壊れた部分を治してもらえている為\n\n・基本\n頬を紅く染めて高揚した笑み\nスーツを透過しながら､マ◯コから触手か卵かスライム(どれか1種類で大丈夫・出来るだけグロテスクなデザイン)が産まれている\n・差分1\n産み付け用の触手がマ◯コに挿入される(スーツを透過する)\n絶頂して絶叫し､涙を流しながら白目を剥く\n・差分2\n完全に惚けた､心此処にあらずといった表情(ハイライトオフ・口角を上げてヘラヘラした笑顔・焦点の定まらない目)\n基本の時に産んでいた物を､さらにグロテスクにした物を産む(一例として､眼球が大量に生成されているとか､人間と同様の歯や歯茎があるとか)\n耳に極細の触手が入る\n\n以下のセリフも付けて下さい\n・基本\nあはぁ〜〜〜………♡もっと激しいの､ちょうだい♡\n・差分1\n◯✕■▲☆＊〜〜〜〜〜〜〜っ♡\n・差分2\nひゃぁ…♡あぁぁぁ〜〜〜……♡あんっ♡脳､気持ち良い…♡\nあたしが[戻る]､この感じが好きぃ〜〜…♡", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/278", "thumbnail_src": "https://si.imgix.net/ad29f70d/uploads/origins/e3572d42-c0e9-405d-b309-aef49d62f1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30057808d86cacc002319caa85b33f05", "thumbnail_srcset": "https://si.imgix.net/ad29f70d/uploads/origins/e3572d42-c0e9-405d-b309-aef49d62f1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30057808d86cacc002319caa85b33f05, https://si.imgix.net/ad29f70d/uploads/origins/e3572d42-c0e9-405d-b309-aef49d62f1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f23888ab30ea177944693b3e7a4aa7fa 2x, https://si.imgix.net/ad29f70d/uploads/origins/e3572d42-c0e9-405d-b309-aef49d62f1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6566bac978c3b5d817ee39a099aafb7 3x", "genre": "art", "nsfw": true, "body": "リクエストを送らせて頂きます\nキャラクターはアニポケのリコ↓\nhttps://www.tv-tokyo.co.jp/anime/pocketmonster2023/chara/\nhttps://dic.pixiv.net/a/%E3%83%AA%E3%82%B3(%E3%82%A2%E3%83%8B%E3%83%9D%E3%82%B1)\n衣装はマチエール↓のボディスーツ(Z-Aのキーストーン付きのヤツ)を元に､前回のリーリエのようにメタモンがスーツに変身している設定(スーツが黒いので､メタモンの目を白くして､目が判別出来るようにする)\nhttps://www.pokemon.co.jp/ex/legends_z-a/ja/characters/250722_04/\nhttps://youtube.com/shorts/gxghVzm4Jxc?si=O9Mad044fL4yhycK\nメタモンの顔は胸部か腹部に浮かべる\n背景は満月の月夜､月明かりが差し込む森林\n構図は貴方の描いた商業作品[孕殖の間]の門倉美咲の最後のページ(産みたくないとイヤイヤしている場面)を参考に､木を背にして､腕はメタモンを使ってセルフ拘束している\n耳にメタモンの一部が侵入して脳クチュされている\n\n[シチュエーション]\nとある伝手で､イクスパンションスーツの機能を持ったメタモンスーツを提供されたリコ\nバトルの成果は良くなっていったが､メタモンからの性的なアプローチが何度もあり､何度も孕んでしまった\nしかし､苦境に立たされ続けてメンタルが擦り減ったリコには寧ろ心地良かった\nリコのポケモン達も､リコのリフレッシュになるならと､見守る事にした\nそしてその日も､ロイやドットなどに秘密にしながら､夜中に屋外で出産ショーを楽しんでいた\n\n・基本\n頬を紅くして汗だくの､高揚した絶頂寸前の笑み\nボテ腹がボコボコと脈打つ\n・差分1\nスーツを透過してマ◯コからメタモンを噴射\n絶頂して顔が仰け反るor舌出して絶叫\n可能ならスーツを透過して母乳噴射\n・差分2\nさらにマ◯コからメタモンを噴射\nだらしなく蕩けた笑顔で舌を垂らして､涙と汗を垂れ流し､幸せそうなリコ", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/277", "thumbnail_src": "https://si.imgix.net/c479a5f1/uploads/origins/7b3a1976-cfae-42d5-a63c-e56e4a98b3ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd7791d5aed16510bdf2d86ee4c078fb", "thumbnail_srcset": "https://si.imgix.net/c479a5f1/uploads/origins/7b3a1976-cfae-42d5-a63c-e56e4a98b3ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd7791d5aed16510bdf2d86ee4c078fb, https://si.imgix.net/c479a5f1/uploads/origins/7b3a1976-cfae-42d5-a63c-e56e4a98b3ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4153c7067a5aa8d0831d780d434249e5 2x, https://si.imgix.net/c479a5f1/uploads/origins/7b3a1976-cfae-42d5-a63c-e56e4a98b3ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0ca5db923dfc6bb353eff6875249d9a 3x", "genre": "art", "nsfw": true, "body": "初めまして、ニコニコ動画に投稿されてたころ、見てました。\n\n依頼します。\n\n【キャラクター】\nペルソナ3 山岸風花\n\n【服装】\nビキニアーマー\n\n【シチュ】\nビキニアーマー姿で一人でナビしているところをシャドウに襲われて拘束され，\nシャドウの無数の手や舌や触手が服に入り込んできてエッチなことをされている。\n\nその姿をマヨナカテレビみたいな感じで配信されているシチュでお願いします。\n配信されている感じとしてニコニコ動画みたいな枠のなかで配信されている感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/276", "thumbnail_src": "https://si.imgix.net/99b82bc2/uploads/origins/a86cbbb3-e840-4d25-84e5-90edea7e14b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b45e544f12aa254aef85b45713d5abbb", "thumbnail_srcset": "https://si.imgix.net/99b82bc2/uploads/origins/a86cbbb3-e840-4d25-84e5-90edea7e14b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b45e544f12aa254aef85b45713d5abbb, https://si.imgix.net/99b82bc2/uploads/origins/a86cbbb3-e840-4d25-84e5-90edea7e14b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1735aee83e8d909f2d82a4dcc876e921 2x, https://si.imgix.net/99b82bc2/uploads/origins/a86cbbb3-e840-4d25-84e5-90edea7e14b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b55c2794bd9ea57114d5f5f459a15638 3x", "genre": "art", "nsfw": true, "body": "初めまして戦国乙女の豊臣ヒデヨシというキャラクターのイラストをお願いします\n\n対魔忍風衣装を着たヒデヨシがhttps://skeb.jp/@segamidaisuke/works/265のような体位で機械に拘束されて耳から挿入されたケーブルで脳クチュされ感度3000倍へ改造中\n胸、膣、アナルにアクメビームを浴びせられイキ狂っている\n可能であればあまりの快楽に舌を出しながら仰け反りデスアクメしている差分をお願いします\n\n以上になりますが検討よろしくお願いします\n\nhttp://otome-portal.com/sengoku/character/hideyoshi/", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/275", "thumbnail_src": "https://si.imgix.net/dc9722d0/uploads/origins/426aa80d-6319-42a7-96a4-cd9e197d27ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00b4e2b495c129766de9786f1b651a99", "thumbnail_srcset": "https://si.imgix.net/dc9722d0/uploads/origins/426aa80d-6319-42a7-96a4-cd9e197d27ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00b4e2b495c129766de9786f1b651a99, https://si.imgix.net/dc9722d0/uploads/origins/426aa80d-6319-42a7-96a4-cd9e197d27ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b999f4c0d33b409d51d67b42b86f2289 2x, https://si.imgix.net/dc9722d0/uploads/origins/426aa80d-6319-42a7-96a4-cd9e197d27ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e74d3ab32dc796a0a8fc830a5a3b863b 3x", "genre": "art", "nsfw": true, "body": "対魔使用人シリーズのイメージで、東方のフランちゃんが魔物と戦うイラストをお願いします！\n\n■シチュエーション■\n・フランの衣装はハイレグの対魔衣装\n・左右どちらかの乳首に小さなスライムが張り付いている。\n・フランはスライムの媚毒の影響で母乳が出る状態になっており、乳首に吸い付いたスライムが母乳を吸って膨らんでいる。スライムがくっついていない方の乳首も母乳が溢れ、衣装に染みを作っている。\n・フランは媚毒の影響で発情し汗をかいているものの、スライムの責めに屈さず周囲のスライムを撃破している。", "created_at": "", "completed_at": ""}, {"path": "/@segamidaisuke/works/274", "thumbnail_src": "https://si.imgix.net/cad8f2d9/uploads/origins/967aff43-6b12-4abc-a909-30acc1634b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f7a85a4f41b41d0a4e2d659efc0c65e", "thumbnail_srcset": "https://si.imgix.net/cad8f2d9/uploads/origins/967aff43-6b12-4abc-a909-30acc1634b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f7a85a4f41b41d0a4e2d659efc0c65e, https://si.imgix.net/cad8f2d9/uploads/origins/967aff43-6b12-4abc-a909-30acc1634b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20