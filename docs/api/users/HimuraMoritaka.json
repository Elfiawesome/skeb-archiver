c7-ddbeed68303a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac0ccdf01b7d8251a76d3d240dcefb5f", "thumbnail_srcset": "https://si.imgix.net/01c05bc9/uploads/origins/d82eba69-f68e-4607-bfc7-ddbeed68303a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac0ccdf01b7d8251a76d3d240dcefb5f, https://si.imgix.net/01c05bc9/uploads/origins/d82eba69-f68e-4607-bfc7-ddbeed68303a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd8be672de04fab3fae2875c96535e3d 2x, https://si.imgix.net/01c05bc9/uploads/origins/d82eba69-f68e-4607-bfc7-ddbeed68303a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5a5098f0c0523dbcf164a05486a1abe 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nVtuber準備中の有馬と申します。\n火村様が描く、かわいいくて柔らかい表情がとても好きで\nぜひ歌ってみたMV用のイラストを描いていただきたく、リクエストいたしました。\n\n●使用用途\n・歌ってみたの他にVtuber活動にて使用\n（ 収益化したYouTube、SNS活動、FANサイト先行公開、ネットプリント・カレンダー・として配布、商用利用でのグッズ制作など）\n\n●楽曲\nロミオとシンデレラ\nhttps://youtu.be/9HrOqmiEsN8?si=6lAj4bl8DyK3csQz\n\n●作品の内容\n服装や構図はお任せでお願いいたします！\n※顔周りは切れないようにお願いいたします。\nもしお任せが難しい場合は、本家様のオマージュでお願いしたいです。（本家様にある、男性の腕は無しでお願いします）\n\nまた可能であれば表情差分で目を閉じているのも欲しいです\n\n●本人の特徴\n・サラブレッドVtuber（人間の耳は無し）\n・右目下に涙ほくろ\n・左頬に絆創膏\n\n●資料\n・立ち絵\nhttps://drive.google.com/drive/folders/1dpxqpVJQ70r65kME70uPCZi1upFVF4Z4?usp=drive_link\n→白髪の方で、お願いします。\n\n●納品形式\n人物、背景がレイヤー分けされたPSDデータでいただけると嬉しいです。\n\nお忙しいところ恐縮ですが、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@HimuraMoritaka/works/65", "thumbnail_src": "https://si.imgix.net/d14d5dd4/uploads/origins/4939edf8-1f9d-43bf-8632-bd14f24d61e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a3d65ed2ebca0c2e8c3450a2932f17", "thumbnail_srcset": "https://si.imgix.net/d14d5dd4/uploads/origins/4939edf8-1f9d-43bf-8632-bd14f24d61e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a3d65ed2ebca0c2e8c3450a2932f17, https://si.imgix.net/d14d5dd4/uploads/origins/4939edf8-1f9d-43bf-8632-bd14