b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77ed35469a1fbf3f86da9e37001c7691, https://si.imgix.net/99d9ed2d/uploads/origins/c2be2499-c73f-4681-beff-8930b7d6eb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95252fd914535bac58897342b136d93f 2x, https://si.imgix.net/99d9ed2d/uploads/origins/c2be2499-c73f-4681-beff-8930b7d6eb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3af175d1c7e4b0fc199fc58240b2116 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n私のリクエストは、ファイアーエムブレム ヒーローズのウサギの服を着たヴェイルです。\nhttps://guide.fire-emblem-heroes.com/en-GB/14009002001217-2\n\n彼女の位置や背景を後ろから見て、このイラストのようにスカートを持ち上げてパンティーを見せます。\nhttps://x.com/miyase_mahiro/status/1553216366240444416\n\n次のようなバリエーションがあるとありがたい。\n-胸がドレスで覆われているところと、露出しているところ。\n-パンティをはいている状態と、はいていない状態。", "created_at": "", "completed_at": ""}, {"path": "/@yotubeya/works/170", "thumbnail_src": "https://si.imgix.net/86d1427c/uploads/origins/b368259e-91e5-4b24-871b-ccda95c6e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ad6e429c07fa026408212fc8916b4dd", "thumbnail_srcset": "https://si.imgix.net/86d1427c/uploads/origins/b368259e-91e5-4b24-871b-ccda95c6e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ad6e429c07fa026408212fc8916b4dd, https://si.imgix.net/86d1427c/uploads/origins/b368259e-91e5-4b24-871b-ccda95c6e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc469f4482f32ea1c947407457b729b9 2x, https://si.imgix.net/86d1427c/uploads/origins/b368259e-91e5-4b24-871b-ccda95c6e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e060fbf76d4cffa9d26c54ce0dd08c46 3x", "genre": "art", "nsfw": true, "body": "こんにちは、BrownDust2のロエンを描いてください！\n逆バニーガールバージョンでお願いします。エルフの耳と汗ばんだ肌を追加してください。乳首とマンコのシールは外してください。手袋や上着など、他のパーツをはずしてもかまいません。\n\nあなたの機械による性的拷問の絵が目に留まったので、同じようなものを希望します。  ロエンを拘束するか、何らかの方法で閉じ込めてください。彼女はエロゾーンへの執拗な刺激に耐えようとしているが、最終的には強力なオーガズムに追い込まれている。\n\nインスピレーションを得るために、シナリオの参考をいくつか入れました。それ以外はお好きなようにどうぞ！ご検討ありがとうございました！\n\nhttps://drive.google.com/drive/u/0/folders/18VdnYovr0XbL41nNrHyBGoervLcJ6_hO", "created_at": "", "completed_at": ""}, {"path": "/@yotubeya/works/169", "thumbnail_src": "https://si.imgix.net/a24061b9/uploads/origins/739487fa-4114-40fd-81e2-cc073a649fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc1dc7156b2ac55442e8cafaf36817ce", "thumbnail_srcset": "https://si.imgix.net/a24061b9/uploads/origins/739487fa-4114-40fd-81e2-cc073a649fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc1dc7156b2ac55442e8cafaf36817ce, https://si.imgix.net/a24061b9/uploads/origins/739487fa-4114-40fd-81e2-cc073a649fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc0f0111978f4fc95ea67405c47e65d3 2x, https://si.imgix.net/a24061b9/uploads/origins/739487fa-4114-40fd-81e2-cc073a649fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5f517d9c23000761b64d645f50ee051 3x", "genre": "art", "nsfw": true, "body": "初めましてよつべや先生、先生のリンク先のイラストに惹かれもしよろしければ私の推しキャラのイラストを描いて頂きたくリクエストしました。\nhttps://www.pixiv.net/artworks/134097860\n□キャラは閃刀姫-レイちゃんを\n□衣装はhttps://www.db.yugioh-card.com/yugiohdb/card_search.action?ope=2&cid=13670&request_locale=jaをベースに逆バニー衣装に改変した衣装を\n・乳首には大き目の二プレス(ローターを仕込めるサイズ)\n・股間には白の前張り(見た目的には湿布でも貼り付けたような物を濡らすと染みでバレる設定)をお願い致します。\n\n〇内股で不服そうな顔の逆バニー衣装レイちゃんの差分有のイラストをお願い致します\n・二プレス有と二プレス無し(勃起乳首)\n・股間の前張りシミの有無\n組み合わせを変えれるようなpsdファイル形式で納品をお願い致します\n☆レイちゃんの乳首は大き目を希望します\n☆再送や金額上げ再送はお気軽にお願いいたします\nもしよろしければ検討して頂けるなら嬉しいです、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yotubeya/works/168", "thumbnail_src": "https://si.imgix.net/40aca642/uploads/origins/0250e6cb-3a4d-4d20-ab18-2220c39f3491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fff55c8182ee6cd2bd9364cd2c713cb", "thumbnail_srcset": "https://si.imgix.net/40aca642/uploads/origins/0250e6cb-3a4d-4d20-ab18-2220c39f3491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fff55c8182ee6cd2bd9364cd2c713cb, https://si.imgix.net/40aca642/uploads/origins/0250e6cb-3a4d-4d20-ab18-2220c39f3491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72247bd52c781b2dbb2dd07351df845b 2x, https://si.imgix.net/40aca642/uploads/origins/0250e6cb-3a4d-4d20-ab18-2220c39f3491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05803644637df0bdcaeff53d911977cd 3x", "genre": "art", "nsfw": true, "body": "踊り子衣装の西木野真姫を再度リクエストさせていただきます!\n\n衣装は前回のリクエスト絵と同様の露出度の高い踊り子服。\nhttps://skeb.jp/@yotubeya/works/112\n\n上半身は乳暖簾。乳首は見えていないが、乳首の突起が浮き出て胸ポチしている。\n下半身はノーパン腰布。リングに腰紐と布が付いている、スジがギリギリ隠れる程度のきわどいサイズ。\n\n片足で立って、笑顔で踊っているポーズ。\n\nR18差分を２種類お願いします。\n①腰布がめくれ上がって、赤面しながら腰布を手でおさえようとしている。\n　隠しきれずに無毛のスジが丸見えになっている。\n②腰布めくれに加えて、羞恥の赤面顔、乳暖簾がめくれ上がって乳首が見えている。\n　おっぱいが跳ねて揺れている乳揺れの描写もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yotubeya/works/167", "thumbnail_src": "https://si.imgix.net/8bf53f99/uploads/origins/82badfb5-34d3-4ef6-8833-7c5b78f86921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dcd150d991875fe57da6c48602a7b84", "thumbnail_srcset": "https://si.imgix.net/8bf53f99/uploads/origins/82badfb5-34d3-4ef6-8833-7c5b78f86921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dcd150d991875fe57da6c48602a7b84, https://si.imgix.net/8bf53f99/uploads/origins/82badfb5-34d3-4ef6-8833-7c5b78f86921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c700f28d80deda7cb2be8abd9965b2e 2x, https://si.imgix.net/8bf53f99/uploads/origins/82badfb5-34d3-4ef6-8833-7c5b78f86921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b85c2013eac64f517da5b7d3c1287974 3x", "genre": "art", "nsfw": true, "body": "メギド72のバティンを描いて頂けますか？\n衣装ベース:Bウェパル星1の衣装\n衣装頭部:Bバティン星3のキャップとヴェール\n下着:ピンク色の可愛い系の勝負下着\nシチュエーション:スカートをたくし上げてパンツを全部見せてくれるイラストをお願いします。想定シチュエーションとして見せる相手はソロ