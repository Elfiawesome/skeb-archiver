e-4447-9ed6-d954dd812950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f37ed9d6de5693d93f0061169b094921", "thumbnail_srcset": "https://si.imgix.net/820adc40/uploads/origins/4911b868-4eee-4447-9ed6-d954dd812950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f37ed9d6de5693d93f0061169b094921, https://si.imgix.net/820adc40/uploads/origins/4911b868-4eee-4447-9ed6-d954dd812950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd3248f8ecf929f91f10e2c7c56f1fae 2x, https://si.imgix.net/820adc40/uploads/origins/4911b868-4eee-4447-9ed6-d954dd812950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da2c7f2a58e27b4d02c741be7afb8506 3x", "genre": "art", "nsfw": false, "body": "はじめまして。新着よりプードルのマスコットイラストを拝見し、とってもかわいくて依頼をさせていただいております。\nもし、可能でしたら私のペットのチンチラを書いていただくことは可能でしょうか？\n\n特徴：\n・男の子のチンチラ（小動物）\n・黒い毛皮でおなかの色は白、目の上にマロ眉毛のようなものがあります。\n（チンチラ/ブラックベルベットという種類です）\n・活発でわがまま\n利用範囲：\n・SNS、vtuber活動の配信画面のマスコット\n\nポーズ等お任せですが、正面を向いているとありがたいです\n万が一、意向に沿わない部分がございましたら遠慮なくキャンセルしていただければと思います。\nお忙しい中恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1la8Smhcljxavo9JUeN-Ywr6lYcLqdqUl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@chomoncha/works/61", "thumbnail_src": "https://si.imgix.net/1405fa95/uploads/origins/0af3c099-4ba8-49c1-a73f-c63979008638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c101014d2c77c41d54e45ab1e3a45558", "thumbnail_srcset": "https://si.imgix.net/1405fa95/uploads/origins/0af3c099-4ba8-49c1-a73f-c63979008638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c101014d2c77c41d54e45ab1e3a45558, https://si.imgix.net/1405fa95/uploads/origins/0af3c099-4ba8-49c1-a73f-c63979008638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f28c5fd7eb07c11cef1c1acdf05b038c 2x, https://si.imgix.net/1405fa95/uploads/origins/0af3c099-4ba8-49c1-a73f-c63979008638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9909d07cccab8bbecf18ffdf2149210 3x", "genre": "art", "nsfw": false, "body": "こんにちは。また何か描いていただいてもいいですか？私のOCであるナオミ（https://naruciakk.eu/naomi/000.pict）の絵をお願いしたいのですが、私のウェブサイトやソーシャルメディア（どちらも商業的なものではなく、個人的なものです）で使用することがあります。スマートなシャツとジーンズを着たキャラクターが希望です。\n\n背景が透明なバージョンもお願いできますか？とてもありがたいです。\n\n他のリファレンスはこちら: https://naruciakk.eu/naomi\n\nご検討ありがとうございました！\n\nhttps://naruciakk.eu/naomi/000.pict", "created_at": "", "completed_at": ""}, {"path": "/@chomoncha/works/60", "thumbnail_src": "https://si.imgix.net/ce4d9b45/uploads/origins/f29952a8-7de0-415e-a492-9e8932decdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb38a1c79d427851c3f96dd7034ebb2b", "thumbnail_srcset": "https://si.imgix.net/ce4d9b45/uploads/origins/f29952a8-7de0-415e-a492-9e8932decdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb38a1c79d427851c3f96dd7034ebb2b, https://si.imgix.net/ce4d9b45/uploads/origins/f29952a8-7de0-415e-a492-9e8932decdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1309d41e9466530fad331396cdbf80ec 2x, https://si.imgix.net/ce4d9b45/uploads/origins/f29952a8-7de0-415e-a492-9e8932decdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8955b67d6986f549019d2843a24d4574 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕は君のスタイルが大好きだよ！\n\nこの2つのキャラクターを依頼できますか？マイロは緑のフルーツコウモリのフェムボーイで、オニガンはいたずら好きなパンダです。自由に創作してください。マイロとオニイガンは親友です。このコミッションの描き方がとても気に入ったので、同じようなものが欲しいです！https://skeb.jp/@chomoncha/works/55\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1RGzXaR_vNV3GnDoV0G6cCgA8BriFkmwM", "created_at": "", "completed_at": ""}, {"path": "/@chomoncha/works/59", "thumbnail_src": "https://si.imgix.net/b4b5de08/uploads/origins/95d00204-d581-4c2e-b39d-3742952333a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6347062d136eef73ff5f3d55f81e3892", "thumbnail_srcset": "https://si.imgix.net/b4b5de08/uploads