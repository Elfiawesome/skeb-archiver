GnhUsBdpvvbVvFkG9thw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@konparunemunemu/works/55", "thumbnail_src": "https://si.imgix.net/41c50c31/uploads/origins/56dbd910-1990-4469-aafd-d0d3d0a89c71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1840f21c784b508bc9d2e2ce762d219b", "thumbnail_srcset": "https://si.imgix.net/41c50c31/uploads/origins/56dbd910-1990-4469-aafd-d0d3d0a89c71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1840f21c784b508bc9d2e2ce762d219b, https://si.imgix.net/41c50c31/uploads/origins/56dbd910-1990-4469-aafd-d0d3d0a89c71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8b0236ed6a25bc18c63eb98571f75f0 2x, https://si.imgix.net/41c50c31/uploads/origins/56dbd910-1990-4469-aafd-d0d3d0a89c71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25f663118a66b9ccd9341cfe5124010 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます\nクリスタルフューチャーに興味を持っていただきありがとうございます💖。\n好きなものを自由に描いてください🩵 よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1WT-zyJ-SQGcZ_xRcwZAlcpo-YnqSsenC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@konparunemunemu/works/54", "thumbnail_src": "https://si.imgix.net/64c89264/uploads/origins/a8de6078-3be5-4340-82ac-aecc3e3e6021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d79d8953e77a7bdbd2059aee8305ea21", "thumbnail_srcset": "https://si.imgix.net/64c89264/uploads/origins/a8de6078-3be5-4340-82ac-aecc3e3e6021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d79d8953e77a7bdbd2059aee8305ea21, https://si.imgix.net/64c89264/uploads/origins/a8de6078-3be5-4340-82ac-aecc3e3e6021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fbbd9450d70d94cf11daad35715a12d 2x, https://si.imgix.net/64c89264/uploads/origins/a8de6078-3be5-4340-82ac-aecc3e3e6021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8f0b