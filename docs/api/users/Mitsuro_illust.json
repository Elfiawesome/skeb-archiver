-4c58-a02e-3113b479af21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ad2d96f0be9319566fdfc625141d810 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mitsuro_illust/works/347", "thumbnail_src": "https://si.imgix.net/9c1429a4/uploads/origins/6b0d3ee9-32f1-4594-8fd4-12439a0dd680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=046d081bd38cd2bf1c3d952973692584", "thumbnail_srcset": "https://si.imgix.net/9c1429a4/uploads/origins/6b0d3ee9-32f1-4594-8fd4-12439a0dd680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=046d081bd38cd2bf1c3d952973692584, https://si.imgix.net/9c1429a4/uploads/origins/6b0d3ee9-32f1-4594-8fd4-12439a0dd680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38add53e0c0de6b1e78ba30477cb33c4 2x, https://si.imgix.net/9c1429a4/uploads/origins/6b0d3ee9-32f1-4594-8fd4-12439a0dd680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9198356505e091fea292cc5b975aae02 3x", "genre": "art", "nsfw": false, "body": "こんにちはこんにちは、\nあなたのデザイン作品は本当に可愛いですね。\nダンサーOCの私服衣装をお願いしたいです。\n彼女は170cmでDカップです。\n今着ている服とは対照的で、もっと隠れるような服をお願いします。\nセーターやジャケットのようなものを着せると冬らしい雰囲気になると思います。\nあとはお任せします。\nこの度はご検討いただきありがとうございました。\n\nhttps://drive.google.com/file/d/1mcZbUiuuhMUdQUI-QdhYcff_ugSTkaQl/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mitsuro_illust/works/346", "thumbnail_src": "https://si.imgix.net/05bcec88/uploads/origins/674910a7-f19d-4910-bbac-30f8f43e3685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7bad8ef8d6ae98a540f42bbd9cb995", "thumbnail_srcset": "https://si.imgix.net/05bcec88/uploads/origins/674910a7-f19d-4910-bbac-30f8f43e3685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7bad8ef8d6ae98a540f42bbd9cb995, https://si.imgix.net/05bcec88/uploads/origins/674910a7-f19d-4910-bbac-30f8f43e3685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dae22819c29f22fce8829a620a57ae7a 2x, https://si.imgix.net/05bcec88/uploads/origins/674910a7-f19d-4910-bbac-30f8f43e3685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06eca6beaffdc7ea729eab7de307f751 3x", "genre": "art", "nsfw": true, "body": "こんにちは、11月にも今後の作品の参考になるような衣装をお願いしたいのですが。\n\nリクエストの詳細\nテーマは、彼女の体がウイルスに乗っ取られ、体を堕落させ、「デジタル・サキュバス」の一種に変えてしまうというものです。\n衣装の大まかな見た目は、前回の依頼と同じ11月でお願いします。\n彼女の股間にはデジタル化されたような淫らな紋章が欲しい。\n彼女の体を横切るピンクのラインはデータストリームとして機能する。\nヘッドフォンの悪魔の角はアンテナの役割。\n肌は灰色で、髪は薄いピンク。\n瞳はピンクで瞳孔はハート。\n尻尾の先端はハート型。\n\nリクエストに応えてくれてありがとう。\n\n参考になりました：\nhttps://drive.google.com/drive/folders/1kEILmGDGfSdFvATWRkibpwBGrdpVh4LV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mitsuro_illust/works/345", "thumbnail_src": "https://si.imgix.net/b0f7ca2c/uploads/origins/979cf707-9412-428d-a4db-3a28a8856e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72aa5131a968b03a213f0d4935c95b50", "thumbnail_srcset": "https://si.imgix.net/b0f7ca2c/uploads/origins/979cf707-9412-428d-a4db-3a28a8856e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72aa5131a968b03a213f0d4935c95b50, https://si.imgix.net/b0f7ca2c/uploads/origins/979cf707-9412-428d-a4db-3a28a8856e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ada9691c630ef672b5719bb4681f154f 2x, https://si.imgix.net/b0f7ca2c/uploads/origins/979cf707-9412-428d-a4db-3a28a8856e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4e210e3ca946e73fa3432730c0f3ada 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mitsuro_illust/works/344", "thumbnail_src": "https://si.imgix.net/a7427efa/uploads/origins/4aebba7a-b993-4403-a5ad-6c8613f24c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77949778180a9cd152294cf76b33c0ad", "thumbnail_srcset": "https://si.imgix.net/a7427efa/uploads/origins/4aebba7a-b993-4403-a5ad-6c8613f24c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77949778180a9cd152294cf76b33c0ad, https://si.imgix.net/a7427efa/uploads/origins/4aebba7a-b993-4403-a5ad-6c8613f24c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57378dd6b0ef2fc9308042191bdfb09c 2x, https://si.imgix.net/a7427efa/uploads/origins/4aebba7a-b993-4403-a5ad-6c8613f24c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5744ed72dcf4c93b8b861b6500f94978 3x", "genre": "art", "nsfw": false, "body": "こんにちは、みつろう先生！先生のキャラクターデザインの幅の広さがとても気に入っていて、既存のキャラクターに新しい衣装のデザインを依頼したいと思っています。彼は若い男性で、顔はかわいいのですが、落ち込んでいて、苦悩しているような性格です。彼の新しい衣装のテーマは、普段の彼に比べて少しエッジの効いた、不機嫌なものにしたいです。ダークなトーンで。\n\n彼は自己嫌悪に陥っていて、一番愛している人を救えなかったことを後悔している。\n\nできればSNSに使いたい。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/11SJMWc8nv5GsWwaDLsSShzI7E6yr1fZz?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mitsuro_illust/works/343", "thumbnail_src": "https://si.imgix.net/51517eed/uploads/origins/b6d49b97-cfcb-47ef-88ec-4e430f2978db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=850c07ea14089d232c83d2c74f224b1e", "thumbnail_srcset": "https://si.imgix.net/51517eed/uploads/origins/b6d49b97-cfcb-47ef-88ec-4e430f2978db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=850c07ea14089d232c83d2c74f224b1e, https://si.imgix.net/51517eed/uploads/origins/b6d49b97-cfcb-47ef-88ec-4e430f2978db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41424a2423aff4f6993eefbfa071006c 2x, https://si.imgix.net/51517eed/uploads/origins/b6d49b97-cfcb-47ef-88ec-4e430f2978db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c1890fdbf402205e435c7423e9b402e 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n\nキャラクターデザインを手伝ってください\n\n20代前半の女性です。現役魔法少女で、大学を卒業して1年経った現在ニートです。紺色のジェムコアで変身する。\n\n変身前と変身後を描いてください。\n\nスケッチしたデザインと参考画像を添付します。服の形はリファレンスに従いますが、衣装のデザインパターンは自由に変更してください。参考画像を100％コピーしないでください。\n\n変身前\n体型\n165cm、50kg、巨乳、姫髪黒髪（エアインテークあり）、黒目\n\n服装\nクロップトップ＆ドルフィンショーツ、オーバーサイズパーカー（ショーツ半分まで）、丸メガネ\n\n変身後\nボディ\n青い髪に青い目、他はそのまま\n\n衣装\nダークブルーのジェムコア。インナースーツは胸から足までを覆い、腹と背中が露出している。フルスーツはスキンタイトマスク、クロップトップ、袖、グローブがすべて一枚の布になったもの。靴はスリッポン。メインカラーは白、サブカラーは青と金。\n\nありがとう\n\nhttps://drive.google.com/file/d/1zt3tCfuROws95zNK64S7U8dypbUdsJVw/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Mitsuro_illust/works/342", "thumbnail_src": "https://si.imgix.net/2c1afbb6/uploads/origins/fc584383-95ff-4248-9ebb-873369d9389d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dff0242139063bae56e0dce45e9cf2c8", "thumbnail_srcset": "https://si.imgix.net/2c1afbb6/uploads/origins/fc584383-95ff-4248-9ebb-873369d9389d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dff0242139063bae56e0dce45e9cf2c8, https://si.imgix.net/2c1afbb6/uploads/origins/fc584383-95ff-4248-9ebb-873369d9389d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5955e52046982dc0ca02f5f4bd65bcda 2x, https://si.imgix.net/2c1afbb6/uploads/origins/fc584383-95ff-4248-9ebb-873369d9389d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=