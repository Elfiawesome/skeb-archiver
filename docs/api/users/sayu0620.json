%2Ccenter&txtsize=30&txt=PRIVATE&s=c06e1e0a145dd0d850ea2cd2514e8d78 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sayu0620/works/3", "thumbnail_src": "https://si.imgix.net/e9a4f928/uploads/origins/8e23458a-8acf-40ef-8098-34343f290805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd9d635b19ac1cb46f9c1b122acfb9e", "thumbnail_srcset": "https://si.imgix.net/e9a4f928/uploads/origins/8e23458a-8acf-40ef-8098-34343f290805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd9d635b19ac1cb46f9c1b122acfb9e, https://si.imgix.net/e9a4f928/uploads/origins/8e23458a-8acf-40ef-8098-34343f290805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a11d6e4d637320ebb5ce94c5044a850 2x, https://si.imgix.net/e9a4f928/uploads/origins/8e23458a-8acf-40ef-8098-34343f290805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9038b3e5e3976f471d2930eebf3400dc 3x", "genre": "art", "nsfw": true, "body": "こんにちは。日頃より可愛らしい画の数々楽しませて頂いています。\n様々な美少女ゲーキャラを描かれているのを見込んで、ドマイナーなネタで恐縮ですが、「11eyes cross over」というゲームの『黒芝かなえ』さんをお願いします。 \n劇中の学園制服とエッチな方とありますが、お好きな服装で描いてください。他の描きたい服装やいっそ下着や水着、全裸でも一向に構いません！ 妖艶な感じの表情やポーズで、細かいシチュエーション、背景等はお任せします。\nポーズや表情、汁等のエフェクト差分あると悦びますが余裕があれば、で結構です。\nその他、基本的にはスマホ壁紙を想定しているので縦長の画で、各所存分に\"盛って\"貰えると捗ります。\nご検討頂ければ幸いです。\n\n ※今やお亡くなりになっているメーカーなので資料になりそうなサイトを貼っておきます。見れなかったらごめんなさい; https://yande.re/post?tags=kuroshiba_kanae+", "created_at": "", "completed_at": ""}, {"path": "/@sayu0620/works/2", "thumbnail_src": "https://si.imgix.net/9b5567b9/uploads/origins/7c596076-3042-45de-b86a-b9c93c692daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dbbf3838f56b68522b2af5f4ba1214d", "thumbnail_srcset": "https://si.imgix.net/9b5567b9/uploads/origins/7c596076-3042-45de-b86a-b9c93c692daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dbbf3838f56b68522b2af5f4ba1214d, https://si.imgix.net/9b5567b9/uploads/origins/7c596076-3042-45de-b86a-b9c93c692daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60aa5aa8a12178836692dc6b11fc7dbe 2x, https://si.imgix.net/9b5567b9/uploads/origins/7c596076-3042-45de-b86a-b9c93c692daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdc33067810ee6cd259cd9259c812dc2 3x", "genre": "art", "nsfw": false, "body": "初めまして！柑野さゆ様のイラストがTwitterで流れてきて書き方がとても可愛らしく心に刺さったのでリクエストを送らせて頂きました！\nまだ名もないVTuber準備ですがぜひお願いします！\n\n[使用用途]VTuber活動・Twitter投稿・アイコンとヘッダー・サムネイル・PC壁紙\n[キャラ]AI+天使モチーフで明るい性格、ふわふわした可愛いものがすきな女の子\n[内容]髪型や髪飾りはそのままでお洋服だけ天使界隈ぽいデザインをお願いしたいです…！\n構図や表情などはお任せでお願いしたいです\n[お願い]サインなしの背景透明も活動でとても助かるので可能であれば頂きたいです\n\nSkebを使うのが初めてなので分かりにくいところがあるかもしれません。\n\nhttps://drive.google.com/drive/folders/1-0pKz9iRIo5zMBzgDJS8_0tH-xKgz9DA", "created_at": "", "completed_at": ""}, {"path": "/@sayu0620/works/1", "thumbnail_src": "https://si.imgix.net/8455bd1e/uploads/origins/dc6d5f3a-f78a-40ba-b6c9-1f5211d6d756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5daff95c9b1ab2ac443b9c3742d11d0", "thumbnail_srcset": "https://si.imgix.net/8455bd1e/uploads/origins/dc6d5f3a-f78a-40ba-b6c9-1f5211d6d756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5daff95c9b1ab2ac443b9c3742d11d0, https://si.imgix.net/8455bd1e/uploads/origins/dc6d5f3a-f78a-40ba-b6c9-1f5211d6d756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbd70d56ea2ba1c4093cd7504f6ded9c 2x, https://si.imgix.net/8455bd1e/uploads/origins/dc6d5f3a-f78a-40ba-b6c9-1f5211d6d756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=