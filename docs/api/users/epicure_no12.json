da-efa88ad05c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5263cf8e8f1b5fdfd43e36524bc7a1df 2x, https://si.imgix.net/ae486f63/uploads/origins/3fed784b-e8ff-4bfa-bcda-efa88ad05c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84e9e50a6884e09b49cc4664c7d61b19 3x", "genre": "art", "nsfw": false, "body": "げ田さま\n\nはじめまして、Vtuberの白鳥ももと申します。 \n投稿されている作品のデザインや色使いなどが\n大変好みでしたのでリクエストを送らせていただきました！\n\n【内容】 \n自室でゲームをするキャラクター\nオーダーの詳細はGoogleドライブにまとめさせていただきました。\n（オーダー通りでなくても大丈夫です！詳細はお任せいたします！）\n\n【希望】\n・サムネイルなどで使用するため顔周りがキャンパス内に収まっていると嬉しいです！\n・人物のレイヤーが分かれているpsdまたはpngで納品をお願いできればと思います。\n\n【使用用途】 \n・SNSでの投稿、配信活動のサムネイルなど\nファン特典(ネットプリントや壁紙など)で使用できたらと考えておりますが、\nもし難しい場合はレイヤー名などで教えていただけますと幸いです…！\n\nお手数をおかけしますが、ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1E3kX78wIM3oqcoS9pL0aiyC9OMauk3Q3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@epicure_no12/works/37", "thumbnail_src": "https://si.imgix.net/d18e841f/uploads/origins/e36e23c0-1973-46de-802a-ef7957673a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a9d1903be7965d7ac5cb647a61c03cd", "thumbnail_srcset": "https://si.imgix.net/d18e841f/uploads/origins/e36e23c0-1973-46de-802a-ef7957673a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a9d1903be7965d7ac5cb647a61c03cd, https://si.imgix.net/d18e841f/uploads/origins/e36e23c0-1973-46de-802a-ef7957673a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfad45c2d1dccaf4e547062ab70da1bb 2x, https://si.imgix.net/d18e841f/uploads/origins/e36e23c0-1973-46de-802a-ef7957673a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f5ccb642e30a0358703f1da548e7719 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私は以前、Vtuberのキャラクターのイラストをお願いしたことがあります！\n\n最近、私のチャンネルに \"サイドキャラクター \"が登場しました。このキャラクターは以前お願いしたキャラクターとは違います。参考リンクに彼女への言及を含めました。\n\n名前は「ナノ」で、人懐っこいけどやんちゃ。ポーズや表情はお任せしますが、親しみやすいものにしてください。\n\n見ての通り