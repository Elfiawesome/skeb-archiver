b05f-37c1824ae04a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab6267417745ca60a31ea4f67ed684f", "thumbnail_srcset": "https://si.imgix.net/163fadbc/uploads/origins/4af98a28-0e20-48c8-b05f-37c1824ae04a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab6267417745ca60a31ea4f67ed684f, https://si.imgix.net/163fadbc/uploads/origins/4af98a28-0e20-48c8-b05f-37c1824ae04a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d25e4fffd1516a7e375315bdab580031 2x, https://si.imgix.net/163fadbc/uploads/origins/4af98a28-0e20-48c8-b05f-37c1824ae04a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=910363504d94c91e9e6b5c389cc04db1 3x", "genre": "art", "nsfw": false, "body": "こんばんは、twさん。\nあなたのアピールを受け取りました。私のOC、キサネに興味を持っていただきありがとうございます。\n\n彼女は孤児で、暗殺未遂の失敗で自分と家族が殺された後、謎の復活を遂げた。暗殺を命じたグループへの復讐を誓い、手がかりを求めて各地を放浪しているが、まだ9歳ということもあり、なかなかうまくいかない。\n\nそんな過酷なストーリーにもかかわらず、彼女がまだかわいいと思ってくれる人がいてうれしい。\n\n- キサネといえば、だいたい2つのテーマがある：「存在意義の追求」と「奔放な暴力」。彼女はとてつもなく危険な人間だが、あくまで終結を求めている。\n- 耳は尖っているが、彼女はエルフではなく、アンデッドでしかない。\n- 黒曜石のネックレスをつけている。それは彼女が復活した瞬間に皮膚と融合したため、外すことはできない。\n- また、サイドテールの反対側に花のバレッタをつけている。(この髪型にしているのは、母親から譲り受けたからだ。）\n- キサネのワードローブのほとんどは古着で構成されている。参考フォルダに衣装の例があるが、もしよければ、即興で何か作るのも自由だ。\n\nお時間とご配慮をありがとうございました！\n\nhttps://imgur.com/a/hO5lffa", "created_at": "", "completed_at": ""}, {"path": "/@twtw/works/74", "thumbnail_src": "https://si.imgix.net/d306043a/uploads/origins/37943ff4-33a2-40c9-ab0c-d9a39f7389c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae7fb3f3b3e6da97f3e5f29f37281388", "thumbnail_srcset": "https://si.imgix.net/d306043a/uploads/origins/37943ff4-33a2-40c9-ab0c-d9a39f7389c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae7fb3f3b3e6da97f3e5f29f37281388, https://si.imgix.net/d306043a/uploads/origins/37943ff4-33a2-40c9-ab0c-d9a39f7389c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4ebb199bc64b7ca9513ba3c68b128d5 2x, https://si.imgix.net/d306043a/uploads/origins/37943ff4-33a2-40c9-ab0c-d9a39f7389c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84f9ade49c0ce7d36c19d99f6db57ce4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのスタイルがとても好きです。\n\n作品について：トピックは冬とクリスマスで、キャラクターは寒い気候のために白い霧を吐いている。\n\nポスト、背景、表情などはすべてお任せします。冬やクリスマスをテーマにしたコートなどの服も希望します。\n \nグッズ、サムネイル、タイムテーブルなどに使用するかもしれません。\n\n背景とキャラクターのレイヤーを分けたPSDファイルも提供していただけると助かります。\n\nキャラクターのリンク\nhttps://drive.google.com/drive/folders/1m8HCl1zndSksT0AT_gpxlUJ77xwqx-hF", "created_at": "", "completed_at": ""}, {"path": "/@twtw/works/73", "thumbnail_src": "https://si.imgix.net/c040b55d/uploads/origins/0b22c81d-a5ac-446c-ba44-6ede094b490f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5946a775e0eba4cf34e3580d1e05b2", "thumbnail_srcset": "https://si.imgix.net/c040b55d/uploads/origins/0b22c81d-a5ac-446c-ba44-6ede094b490f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5946a775e0eba4cf34e3580d1e05b2, https://si.imgix.net/c040b55d/uploads/origins/0b22c81d-a5ac-446c-ba44-6ede094b490f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5035ebed81563029c5a12d2b8a5d114 2x, https://si.imgix.net/c040b55d/uploads/origins/0b22c81d-a5ac-446c-ba44-6ede094b490f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd8553381ce71e6ac065e402e65ef1f0 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nアピールありがとうございます！\nブルーロータスさんを魅力的に見ていただけて嬉しいです。\nぜひよろしくお願いします。\n\n【作品】フラワーナイトガール\n【キャラクター】ブルーロータス\n【衣装】進化前衣装\n【シチュエーション】\n表情は笑顔。\n膝から上が入るような構図でお願いします。\nポーズにはとくに指定はありません。\nその他の詳細はおまかせとさせてください。\n\n■参考情報\n・Wikiで視認しづらいですが左右に泣き黒子があります。ご留意ください。\nhttps://drive.google.com/drive/folders/1i7pl60WVwA8zNha3l8MFH4K1ukeRGruw?usp=sharing\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%96%E3%83%AB%E3%83%BC%E3%83%AD%E3%83%BC%E3%82%BF%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@