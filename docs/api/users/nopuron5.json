dle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd55add01b3331761680d94255117418 2x, https://si.imgix.net/8bc9f002/uploads/origins/ca71958f-9d78-4248-97ce-b13dbccc5ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff1482c2afbdf74e309651cda9ebf92f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nopuron5/works/41", "thumbnail_src": "https://si.imgix.net/51d5a9aa/uploads/origins/80501093-2235-49fd-a0d0-2df89c636c5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a80fd0e92f6002318fb2cdb5daa158e8", "thumbnail_srcset": "https://si.imgix.net/51d5a9aa/uploads/origins/80501093-2235-49fd-a0d0-2df89c636c5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a80fd0e92f6002318fb2cdb5daa158e8, https://si.imgix.net/51d5a9aa/uploads/origins/80501093-2235-49fd-a0d0-2df89c636c5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6274e714dd47a76bda73e99b8bf846bf 2x, https://si.imgix.net/51d5a9aa/uploads/origins/80501093-2235-49fd-a0d0-2df89c636c5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa22662e93d5dd5236f794f86fa09210 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです！( ˶'ᵕ'˶)\n今回はオスガキインキュバス『ルビルくん(ヒト形態)』でえっちなのを描いてほしいです。\n\n【衣装】\n部分袖ニーソ(仮称)&ニーソックス、そして首輪とｵﾁﾝﾁﾝにリボンを着せてあげてほしいです。参考を用意していますのでご確認ください。\n衣装だけは必ず上記の通りにしてほしいです。ニーソの長さはお好みで。\n\n衣装参考\nhttps://x.com/furkendonsfw/status/1916991660166164654?s=61&t=r2KUVpelirNUdwyFqyM1kA\n\nhttps://drive.google.com/file/d/1mKIcnBXIX7c6dGchcCUv0R72v2-ja8_o/view?usp=share_link\n\n【シチュエーションなど】\n騎乗位でモブセしているイラストをお願いします。\nムリヤリかイチャイチャな感じかはおまかせいたします。\n構図はこの作品( https://www.pixiv.net/artworks/119895688 )に似せていただけると幸いです。のぷろんさんの裁量で描きたいと思った別の構図・体位にしても大丈夫です。\n\n【差分】\n①挿入前②セックス中③射精の差分も希望しております。\n不備がある場合は再送をお願いします。各差分の表情はのぷろんさんがルビルくんで描きたいお顔で描いてください。また、差分に合わせてルビルくんの角と首輪が光るようにしてくださると幸いです。\n\nhttps://drive.google.com/drive/folders/10Gn-LLQNoqY9mM7Hy6XOovny8CQhFQ4X", "created_at": "", "completed_at": ""}, {"path": "/@nopuron5/works/40", "thumbnail_src": "https://si.imgix.net/6d76478c/uploads/origins/a82d484e-3370-4ae1-8377-f112783d7067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b634a9641d0ce355e66e8348bcc0aec3", "thumbnail_srcset": "https://si.imgix.net/6d76478c/uploads/origins/a82d484e-3370-4ae1-8377-f112783d7067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b634a9641d0ce355e66e8348bcc0aec3, https://si.imgix.net/6d76478c/uploads/origins/a82d484e-3370-4ae1-8377-f112783d7067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8556bd1d0316c959939026c8afdc3873 2x, https://si.imgix.net/6d76478c/uploads/origins/a82d484e-3370-4ae1-8377-f112783d7067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f3ca33ac1b47c61263b17aee1d483b7 3x", "genre": "art", "nsfw": true, "body": "先生こんにちは。私の好きなVtuberの一人のnsfwイラストを描いてほしいです。彼女の名前は命依Mei，悪魔です。\n私が望む体位は正常位、最初は挿入されておらず、彼女はペニスをいじっていました。そして挿入してたっぷり射精します。同時に、自分の表情も絶頂顔に変わることを期待します。最後には絶頂で失神する表現もある。サイズの違いがわかるといいですね。私の好みもあるので、できればお腹は膨らんでいてほしいと思っています。妊娠中のお腹の外観を作成します。衣服は少なく描くこともできますが、手袋、頭飾り、白いシルクだけ残しておきます。残りはあなたが決めることができます。\n\n下のリンクは、彼女の縦画と私が提供した参考アクションです。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-ENqZ7OcE-1HtyNh0KMfTiaqj-F00_Ur?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nopuron5/works/39", "thumbnail_src": "https://si.imgix.net/d06bb694/uploads/origins/92d03e03-5125-4706-b22e-73a11711c9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f1d660d70cc4ed20135b4b049a425b", "thumbnail_srcset": "https://si.imgix.net/d06bb694/uploads/origins/92d03e03-5125-4706-b22e-73a11711c9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f1d660d70cc4ed20135b4b049a425b, https://si.imgix.net/d06bb694/uploads/origins/92d03e03-5125-4706-b22e-73a11711c9c4?bg=%2