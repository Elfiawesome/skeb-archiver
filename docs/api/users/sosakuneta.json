=200&h=200&s=917abd60cf10a7843ccd68be0764a7d8 2x, https://si.imgix.net/9c8df8fb/uploads/origins/d6daae85-8256-4e60-a178-1784bd2262f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0502250e8df5bc5a373cd360bfb50c99 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ 悪魔の力に取り憑かれ、体の各所が徐々に悪魔へと変化していく「ヘイゼル」を描いてください！ 私はあなたのビジョンを信じて辛抱強く待ちます!\n\nhttps://imgur.com/Zuj4WHY\n\nhttps://www.dropbox.com/sh/5bes0tvwjgw59ej/AADV4y4V5GfOH3zUaDgainIga?dl=0\n\nhttps://www.dropbox.com/sh/z89x1ld0cmf5kxj/AAAew3FpPEb8pup188KNho4Ja?dl=0\n\nhttps://www.dropbox.com/sh/k49y11h9q99asrg/AACioS2Vqk8gnN1hlxEGxZlVa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sosakuneta/works/33", "thumbnail_src": "https://si.imgix.net/13ea911e/uploads/origins/0670ee64-7f0a-4292-acf4-88170d733edf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa69e8422912b9fb401c4ce48dfb5e6d", "thumbnail_srcset": "https://si.imgix.net/13ea911e/uploads/origins/0670ee64-7f0a-4292-acf4-88170d733edf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa69e8422912b9fb401c4ce48dfb5e6d, https://si.imgix.net/13ea911e/uploads/origins/0670ee64-7f0a-4292-acf4-88170d733edf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da3cbf753a8f7fd110321695893bc38d 2x, https://si.imgix.net/13ea911e/uploads/origins/0670ee64-7f0a-4292-acf4-88170d733edf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfcc7929963794078b07d505626c304f 3x", "genre": "art", "nsfw": false, "body": "@kudoh_rrのアイコンのキャラクターを描いてほしいです。 \nポーズ、構図、背景の有無などはお任せします。  \n【必要な要素】 \n・黒髪ロングストレート\n・無表情\n・瞳の色が紫っぽい\n・顎下から右目を通って額まで細い傷がある（一応切創という設定です）\n・上下ともシンプルな黒系の服装 （ボンバージャケット、MA-1、テーラードジャケットなど…デザインはお任せします。インナーも派手なプリントT以外のシンプルなものであれば、TシャツでもワイシャツでもなんでもOKです。ボトムスはスカート・パンツどちらでもOKですが、どちらかと言うとタイトめなシルエットがイメージです(必須ではないです)）  \n\n【ざっくりとした設定】\n・北欧系のハーフ(国籍日本)\n・170cm半ばくらい\n・20代半ば～後半くらい\n・肌が白め\n・強い \n\n参考https://x.com/kudoh_rr/status/1112202307943297024\nhttps://x.com/kudoh_rr/status/1005863865979002880\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sosakuneta/works/32", "thumbnail_src": "https://si.imgix.net/408d2d86/uploads/origins/74dd9406-2847-446b-a356-833d667db647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e42a263a628fc86c5fc4cb67b1ec9a3", "thumbnail_srcset": "https://si.imgix.net/408d2d86/uploads/origins/74dd9406-2847-446b-a356-833d667db647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e42a263a628fc86c5fc4cb67b1ec9a3, https://si.imgix.net/408d2d86/uploads/origins/74dd9406-2847-446b-a356-833d667db647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe1478ca12280fa770b567488b3b946c 2x, https://si.imgix.net/408d2d86/uploads/origins/74dd9406-2847-446b-a356-833d667db647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b391b08b5732810bb81bf485a37c18b2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sosakuneta/works/31", "thumbnail_src": "https://si.imgix.net/eb0b4fbf/uploads/origins/e1660a0c-c8cb-4323-aa42-5f2826d43dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da94eba38697817b63c1702b379d95f2", "thumbnail_srcset": "https://si.imgix.net/eb0b4fbf/uploads/origins/e1660a0c-c8cb-4323-aa42-5f2826d43dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da94eba38697817b63c1702b379d95f2, https://si.imgix.net/eb0b4fbf/uploads/origins/e1660a0c-c8cb-4323-aa42-5f2826d43dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cad8381b8f0ad5367cfa6c8c6579f5e 2x, https://si.imgix.net/eb0b4fbf/uploads/origins/e1660a0c-c8cb-4323-aa42-5f2826d43dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ffe4a9cc0ccb92a1a6370169ab12493 3x", "genre": "art", "nsfw": false, "body": "初めまして。Twitterから投稿を拝見し、絵柄が好みだったため今回skeb依頼をさせていただきました。\n（金銭が絡まない範囲での）TRPG用の立ち絵・SNS等のアイコン用として作成を依頼します。\nhttps://drive.google.com/file/d/1ZEH9jTHKUlgyiHILL5UvdRmUfuvifLhD/view?usp=sharing\n上記のAI生成画像を資料として、TRPG用のキャラの立ち絵（表情差分付き）をお願いいたします。\nポーズ:おまかせ", "created_at": "", "completed_at": ""}, {"path": "/@sosakuneta/works/30", "thumbnail_src": "https://si.imgix.net/1285ac92/uploads/origins/b8d4e506-5623-436a-addc-0c7b592ba3f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade6c44ff00410deb68dec81bc8c386b", "thumbnail_srcset": "https://si.imgix.net/1285ac92/uploads/origins/b8d4e506-5623-436a-addc-0c7b592ba3f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade6c44ff00410deb68dec81bc8c386b, https://si.imgix.net/1285ac92/uploads/origins/b8d4e506-5623-436a-addc-0c7b592ba3f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2ba67e07de5e9ba17db056249381b19 2x, https://si.imgix.net/1285ac92/uploads/origins/b8d4e506-5623-436a-addc-0c7b592ba3f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=035fcfa51375fac397231a622e040b22 3x", "genre": "art", "nsfw": false, "body": "Hello Sensei! Saw a lot of your Skebs and the art style is amazing! I would like to have a request for my vtuber oc and my friend's.\nMy character Fei is an exorcist from the past. she is a catgirl with sharp canines, she has a mischievous, smug, sadistic character and she thinks she is the best at everything and does whatever she wants. \nMy friend's character Xen is a wolf girl with a black-to-pink gradient wolf cut hairstyle. She likes a lot of silver accessories and her personality is a little mischievous and tomb