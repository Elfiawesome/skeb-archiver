ズにしたいと、Seirenのオーナーと意見が一致しました。違いは、Flouが一番下でSeirenを見上げていて、手には銃かナイフを持っていることです。\n\n首には噛み跡があり、口からは血が出ているかもしれません。もちろん、これは私たちの好みではありますが、私たちはあなたに判断してもらうことに同意しました。\n\n下のアルバムにリファレンスシートとアートの例があります。\n\nこのような機会を与えていただき、ありがとうございました。\n\nhttps://imgur.com/a/LWcbjpt", "created_at": "", "completed_at": ""}, {"path": "/@fosfatale/works/43", "thumbnail_src": "https://si.imgix.net/11aa10a9/uploads/origins/27ab414d-da9d-49d7-8107-8d675b0cf9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b2a5466bfb91f9e109b332f0102a1a8", "thumbnail_srcset": "https://si.imgix.net/11aa10a9/uploads/origins/27ab414d-da9d-49d7-8107-8d675b0cf9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b2a5466bfb91f9e109b332f0102a1a8, https://si.imgix.net/11aa10a9/uploads/origins/27ab414d-da9d-49d7-8107-8d675b0cf9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f531f47e83688d2bda9a383b143a4a3 2x, https://si.imgix.net/11aa10a9/uploads/origins/27ab414d-da9d-49d7-8107-8d675b0cf9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76aae16fc76bcc19b352a1c727bbcaf3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fosfatale/works/42", "thumbnail_src": "https://si.imgix.net/d7cdaabe/uploads/origins/96c0dfae-3c89-48a4-8f94-f792f2160adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58fd511e957ec378a0378b00151230cb", "thumbnail_srcset": "https://si.imgix.net/d7cdaabe/uploads/origins/96c0dfae-3c89-48a4-8f94-f792f2160adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to