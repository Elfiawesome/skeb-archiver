gix.net/63a45882/uploads/origins/94028349-8172-4c4d-98d9-8127544c336d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ecf42337bdc631eca825e7579613f1e", "thumbnail_srcset": "https://si.imgix.net/63a45882/uploads/origins/94028349-8172-4c4d-98d9-8127544c336d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ecf42337bdc631eca825e7579613f1e, https://si.imgix.net/63a45882/uploads/origins/94028349-8172-4c4d-98d9-8127544c336d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44e9554b3933612cb8855243c40f2bf0 2x, https://si.imgix.net/63a45882/uploads/origins/94028349-8172-4c4d-98d9-8127544c336d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7d922e23cb0e10294ee5f320e822814 3x", "genre": "art", "nsfw": false, "body": "Hi, ニャー さん ( ･ω･)ﾉﾞ\n\nSince this year's winter is on its way, I hope you could draw a pic of ❄️🦊 with the theme set in winter.\n\nI'll leave everything at your disposal. Just feel free to draw whatever you like. :D\n\nBest regards!", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/12", "thumbnail_src": "https://si.imgix.net/2b2c82b1/uploads/origins/f3c24f89-c968-4cc7-bcc6-08549b9f03f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1478210e85ec9afd66d4029283802298", "thumbnail_srcset": "https://si.imgix.net/2b2c82b1/uploads/origins/f3c24f89-c968-4cc7-bcc6-08549b9f03f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1478210e85ec9afd66d4029283802298, https://si.imgix.net/2b2c82b1/uploads/origins/f3c24f89-c968-4cc7-bcc6-08549b9f03f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e582ffac245fd791c8f308e9f21e38cb 2x, https://si.imgix.net/2b2c82b1/uploads/origins/f3c24f89-c968-4cc7-bcc6-08549b9f03f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7424a7f2977db11777a8dc9ac5a7eeff 3x", "genre": "art", "nsfw": false, "body": "初めまして、ニャー様。\n今回はニャー様にリクエストを送りたいと思い、依頼しました。\n\n【作品】\nけものフレンズ\n\n【キャラクター】\nフンボルトペンギン\n\n【内容】\n砂漠でのんびり座っている様子。\n（フンボルトペンギンは乾燥地帯に生息している為）\n\nそれら以外の詳細はニャー様にお任せします。\n何卒ご検討のほど宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/11", "thumbnail_src": "https://si.imgix.net/83a2d7b1/uploads/origins/836da6b1-bbe3-49db-9b0c-54ec04abb52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee32a9821924e3e0337c670df9854cbb", "thumbnail_srcset": "https://si.imgix.net/83a2d7b1/uploads/origins/836da6b1-bbe3-49db-9b0c-54ec04abb52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee32a9821924e3e0337c670df9854cbb, https://si.imgix.net/83a2d7b1/uploads/origins/836da6b1-bbe3-49db-9b0c-54ec04abb52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97dbb01919c4d340af3baba0f0c74a4e 2x, https://si.imgix.net/83a2d7b1/uploads/origins/836da6b1-bbe3-49db-9b0c-54ec04abb52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=204af8844725d56c74fac8eb5152e249 3x", "genre": "art", "nsfw": false, "body": "けものフレンズのシンリンオオカミちゃんがあくびして歯や口の中が見えてる瞬間の絵をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/10", "thumbnail_src": "https://si.imgix.net/f57a27fe/uploads/origins/6799c0d1-c169-4a9c-9417-b6961e4f7b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f6024653353e2039dbfb2812b798b8", "thumbnail_srcset": "https://si.imgix.net/f57a27fe/uploads/origins/6799c0d1-c169-4a9c-9417-b6961e4f7b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f6024653353e2039dbfb2812b798b8, https://si.imgix.net/f57a27fe/uploads/origins/6799c0d1-c169-4a9c-9417-b6961e4f7b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3cb50bd3ccd654bc947fc160bf99d15 2x, https://si.imgix.net/f57a27fe/uploads/origins/6799c0d1-c169-4a9c-9417-b6961e4f7b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2c02ec698da0b489a6f7f18d4c3eaa9 3x", "genre": "art", "nsfw": false, "body": "けものフレンズのフォークランドカラカラをお願いしたいです。\n\n服装はけもフレ3のおでかけ服（パーカ）で、\nポーズは資料URLにある「しゃがみサーバル」を参考にしてください（細部はおまかせします）。\n\nhttps://www.daiwa-dp.co.jp/kohrinbo/2025/08/814-10th-anniversary-shop-in-kanazawa.php", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/9", "thumbnail_src": "https://si.imgix.net/802505d1/uploads/origins/249a3459-0da3-467b-8543-4df95f5a64f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6be4602452e0707bdba417fdf9309af", "thumbnail_srcset": "https://si.imgix.net/802505d1/uploads/origins/249a3459-0da3-467b-8543-4df95f5a64f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6be4602452e0707bdba417fdf9309af, https://si.imgix.net/802505d1/uploads/origins/249a3459-0da3-467b-8543-4df95f5a64f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b366d8f2645cec5ff6059e1d93dbfea 2x, https://si.imgix.net/802505d1/uploads/origins/249a3459-0da3-467b-8543-4df95f5a64f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e6b8e3e4dc1df48858ea021dc2fd828 3x", "genre": "art", "nsfw": false, "body": "けものフレンズのイラストをリクエストします。\n\n開催中のイベントにちなんで、柿かサツマイモを頬張るホンドタヌキ(白変種)をお願いします。\n服装はデフォルト衣装で、モンペが見えてるとうれしいです。", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/8", "thumbnail_src": "https://si.imgix.net/54e613f3/uploads/origins/204cd19b-6af6-43ba-b218-99c1b6a1428f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c52a558fa3d2d804ff6bc5fd3b161b7c", "thumbnail_srcset": "https://si.imgix.net/54e613f3/uploads/origins/204cd19b-6af6-43ba-b218-99c1b6a1428f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c52a558fa3d2d804ff6bc5fd3b161b7c, https://si.imgix.net/54e613f3/uploads/origins/204cd19b-6af6-43ba-b218-99c1b6a1428f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba897f88b9941c1291f8e28ca86b7dca 2x, https://si.imgix.net/54e613f3/uploads/origins/204cd19b-6af6-43ba-b218-99c1b6a1428f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfc66397436d9e9b42ec68f6411fbc58 3x", "genre": "art", "nsfw": false, "body": "けものフレンズの二次創作をリクエストさせてください！\n\nシチュエーション：\n夏の突然の夕立の中、シロヘラコウモリの葉の傘の下に駆け込むツシマヤマネコの絵をお願いします！\n\n服装等：\n両者ともデフォルトの服装、シロヘラちゃんの傘は公式サイズだと足りないので大きめにして下さい・・\n\n表情：\nツシマヤマネコは慌ててる感じ、シロヘラコウモリは笑顔で入れてくれてる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/7", "thumbnail_src": "https://si.imgix.net/7766716e/uploads/origins/63a4faa9-f2b5-47e7-b879-48fae2fd5347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1896909ca5f5a3bfaab11e8d424f35e1", "thumbnail_srcset": "https://si.imgix.net/7766716e/uploads/origins/63a4faa9-f2b5-47e7-b879-48fae2fd5347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1896909ca5f5a3bfaab11e8d424f35e1, https://si.imgix.net/7766716e/uploads/origins/63a4faa9-f2b5-47e7-b879-48fae2fd5347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa4f50484b8ee49bbd3de9649553d300 2x, https://si.imgix.net/7766716e/uploads/origins/63a4faa9-f2b5-47e7-b879-48fae2fd5347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3d9304ceef1c18a4290a123cbfb9582 3x", "genre": "art", "nsfw": false, "body": "けものフレンズのプロングホーンさまをお願いしたいです！\n衣装はデフォルト衣装、ポーズ・表情はドヤってる感じがあれば嬉しいです\n\nご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@NEW_Rapid876/works/6", "thumbnail_src": "https://si.imgix.net/5a63ef48/uploads/origins/ca97f7c3-f6d0-4676-a097-47fdd6c97132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b131a56f84fa93298fd6fa7ca2d0276", "thumbnail_srcset": "https://si.imgix.net/5a63ef48/uploads/origins/ca97f7c3-f6d0-4676-a097-47fdd6c97132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b131a56f84fa93298fd6fa7ca2d0276, https://si.imgix.net/5a63e