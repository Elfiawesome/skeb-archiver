mgix.net/fa185dca/uploads/origins/26e375e8-cff3-4e3d-bff2-9c0da22ad8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ea91f4cccd20a7bdb7e456cb074250f", "thumbnail_srcset": "https://si.imgix.net/fa185dca/uploads/origins/26e375e8-cff3-4e3d-bff2-9c0da22ad8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ea91f4cccd20a7bdb7e456cb074250f, https://si.imgix.net/fa185dca/uploads/origins/26e375e8-cff3-4e3d-bff2-9c0da22ad8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f98072289e529b6083eeef1af15a769 2x, https://si.imgix.net/fa185dca/uploads/origins/26e375e8-cff3-4e3d-bff2-9c0da22ad8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83b1ee9a0d354b1f9a727d3b8a4136a5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nueko829/works/79", "thumbnail_src": "https://si.imgix.net/33f2ba84/uploads/origins/6d89b02b-ba0f-4977-afe7-e2a27bb2ff6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76f5c256bcaff6741dd2a4def9767379", "thumbnail_srcset": "https://si.imgix.net/33f2ba84/uploads/origins/6d89b02b-ba0f-4977-afe7-e2a27bb2ff6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76f5c256bcaff6741dd2a4def9767379, https://si.imgix.net/33f2ba84/uploads/origins/6d89b02b-ba0f-4977-afe7-e2a27bb2ff6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3477c3a02103bc61716ec0400f57ed97 2x, https://si.imgix.net/33f2ba84/uploads/origins/6d89b02b-ba0f-4977-afe7-e2a27bb2ff6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a466489ba259476d15f58607028c8eac 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nVSラムネ＆40炎が39周年ということで、アニメネタから一つリクエストします！\n\nアニメ18話からのIF展開で、フェロモンリップと入れ替わったラムネスが爆乳を揉んでいるシチュをお願いします。\n\nフェロモンリップ（中身はラムネス）が豊満な爆乳を驚きながらもにゅっと柔らかそうに揉みしだいている。\n中身はラムネスで瞳がやや大きく、吹き出しで中身がラムネスであることを伝える形を希望です。\n\nよろしければ衣装は前回同様赤いハート型ドレスで、通常・ハート型ニップレス・生乳のバージョンをPSD分けしていただけると嬉しいです。\n\nこちらに資料を載せておきますので、よろしくお願いします。\n\nフェロモンリップ資料\nhttps://drive.google.com/drive/folders/1775uFFVEzcAWGEgi1YuF59FIzleOMby5?usp=sharing\n\n入れ替わりシチュ全体例\nhttps://skeb.jp/@Hana_mugi0x0/works/6", "created_at": "", "completed_at": ""}, {"path": "/@nueko829/works/78", "thumbnail_src": "https://si.imgix.net/6267ceee/uploads/origins/1d5efd35-d43c-4a77-9f31-446546824733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1afedb2ab8dc035d36d251c57f847949", "thumbnail_srcset": "https://si.imgix.net/6267ceee/uploads/origins/1d5efd35-d43c-4a77-9f31-446546824733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1afedb2ab8dc035d36d251c57f847949, https://si.imgix.net/6267ceee/uploads/origins/1d5efd35-d43c-4a77-9f31-446546824733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f33e53e8873cdf74d8e828e26a4daa85 2x, https://si.imgix.net/6267ceee/uploads/origins/1d5efd35-d43c-4a77-9f31-446546824733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd5cc2083fa858f22e7e035a6cb2ab99 3x", "genre": "art", "nsfw": true, "body": "こんばんは！！　Skebのキャンペーンみたいですので、その勢いで2回目の依頼をさせていただきたいと思います！！\n\nお願いしたいのは、前回に引き続きVS騎士ラムネ&40FRESHのカカオと、プラスで同作よりパフェとの二人をお願いしたいです。\n\n構図は、向かい合って乳合わせするくらいの距離で身を寄せて、キスする1秒前くらいの位置で見つめ合っている姿をお願いします。\n片手は恋人繋ぎでしっかり指を絡めていて、もう片方の手はパフェの手がカカオの胸に、カカオの手はパフェの腰かお尻に、という感じで。\nしっかり雰囲気を出して、触れ合いからの前戯で、いざこれから！という寸前の瞬間を切り取ったような感じを描写していただけたら嬉しいです。\nカカオはパフェに揉まれている方の乳房は露出されて乳首も含めて弄られてる感じで、カカオはとろけた表情で、パフェは攻め攻めのイケイケでスイッチ入ってる感じで。そんな感じの要素も入れていただけたらと思います。\n\nお互いの衣装やロケーションなどはお任せします。\n（二人とも全裸でベッドなどでももちろんOKです！）\n\n前回のカカオはとてもいい感じでしたので、今回も引き続きでしっかり褐色＆乳盛り盛りに。\nパフェはカカオと比べると控えめですけど、スレンダーで引き締まっててちょっと筋肉質（細マッチョの手前くらい）、でも無乳じゃないよ、って感じでお願いしたいです。\nカカオの褐色肌とパフェの白い肌とでコントラストを描いていただけたら幸いです。\n\nどうぞよろしくお願いいたします！！", "created_at": "", "completed_at": ""}, {"path": "/@nueko829/works/77", "thumbnail_src": "https://si.imgix.net/2c48ed9e/uploads/origins/36bf34bf-da20-4b1d-9abd-686ca503a949?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=141a38018ade7a8e18961c2f4b2e91d6", "thumbnail_srcset": "https://si.imgix.net/2c48ed9e/uploads/origins/36bf34bf-da20-4b1d-9abd-686ca503a949?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=141a38018ade7a8e18961c2f4b2e91d6, https://si.imgix.net/2c48ed9e/uploads/origins/36bf34bf-da20-4b1d-9abd-686ca503a949?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1bc5f3d9dbc862a9c8220b60a888b43 2x, https://si.imgix.net/2c48ed9e/uploads/origins/36bf34bf-da20-4b1d-9abd-686ca503a949?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc4037270f41f77ed5e7bcd0478a5665 3x", "genre": "art", "nsfw": false, "body": "私のオリキャラの漏足デルノを描いてほしいです。\n冬制服で構図はニーショット、表情はツンデレみたいな照れ顔でお願いします。それ以外はヌエ子さんの描きやすいようにお任せしますができればパンチラして頂けると嬉しいです。\n\nヌエ子さんの懐かしさと今時さが魅力的に合わさった色っぽ可愛いアニメ塗りの絵が大好きで、いつかデルノを描いてもらいたいとずっと思っておりました。ご検討のほどよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/109148547", "created_at": "", "completed_at": ""}, {"path": "/@nueko829/works/76", "thumbnail_src": "https://si.imgix.net/5aee3f03/uploads/origins/acbbb57a-eef2-411e-bf2a-795ba80a49aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c544557e1bb2ac5712d75a1764d9c104", "thumbnail_srcset": "https://si.imgix.net/5aee3f03/uploads/origins/acbbb57a-eef2-411e-bf2a-795ba80a49aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c544557e1bb2ac5712d75a1764d9c104, https://si.imgix.net/5aee3f03/uploads/origins/acbbb57a-eef2-411e-bf2a-795ba80a49aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=107d675e551303c6979583e086b949d5 2x, https://si.imgix.net/5aee3f03/uploads/origins/acbbb57a-eef2-411e-bf2a-795ba80a49aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b314cb019f57e1993b5f997008fc058 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートが大好きです。僕は90年代のアニメのモデルを持っていて、90年代のアニメのスタイルでアートを描いてもらいたいんだ！どんなポーズでも構いません！彼女はとてもキュートで魔法少女ですが、今は原始人です！愛情深くて、ちょっとヤンデレで、ちょっとツンデレ。透明感のある絵で、全身もあれば最高です！\n\nアート参照：https://drive.google.com/drive/folders/1-04mMpe9D_rOyKH0dgA1awSOi_XBHrg9", "created_at": "", "completed_at": ""}, {"path": "/@nueko829/works/75", "thumbnail_src": "https://si.imgix.net/231b62d2/uploads/origins/9bd4cb7b-6bc4-4c67-a130-169e585691bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ef7e2402c0f1dcaf3c7436dc4c5c30", "thumbnail_srcset": "https://si.imgix.net/231b62d2/uploads/origins/9bd4cb7b-6bc4-4c67-a130-169e585691bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ef7e2402c0f1dcaf3c7436dc4c5c30, https://si.imgix.net/231b62d2/uploads/origins/9bd4cb7b-6bc4-4c67-a130-169e585691bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ce730685ecf928adb5a4d63ec73bd80 2x, https://si.imgix.net/231b62d2/uploads/origins/9bd4cb7b-6bc4-4c67-a130-169e585691bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=350a92ee92f2fecdaf0bc1b2fb92011a 3x", "genre": "art", "nsfw": false, "body": "年内は受付公開されているという事でまたリクエストさせて頂きました。\n\n◎以前依頼で描いて頂いたうちのうさぎさん＝ベルの擬人化／うちの子verのイラストをお願いします。\nhttps://skeb.jp/@nueko829/works/66\n\n◎ポーズやコンセプトなど\n前回納品頂いたのが設定図みたいな形（よそさまに依頼する時に大変助かってます）でしたので、今回は普段Twitter（現X)やskebで描かれているような１枚ポーズ絵でご検討下さい。\n\nポーズや構図などは基本的にヌエ子さんにお任せします。\nベルちゃんのイメージ的には飛び跳ねる・手を広げるといった活発な印象のポーズであったり、\nオヤツ（果物とか）を抱きかかえているといった食いしんぼなイメージであったりが合うでしょうか。\n→書いてて気づきましたが方向性はガラスさんの描いてくれたものが各々近い要素入ってました…。イメージの参考程度に。\nhttps://skeb.jp/@PlasmaGaras/works/1\n\n金額や内容の折り合いありましたら再送依頼などお願いします。\n以上、ご検討よろしくお願いします。", "created_at": "", "completed_at"