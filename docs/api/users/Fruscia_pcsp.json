orded_at": "2025-10-10T18:58:45.271484"}, {"amount": 3000, "recorded_at": "2025-10-18T12:37:12.936042"}]}, "current_prices": {"art": 12000, "comic": 12000, "correction": 3000}, "price_range": {"art": {"min": 12000, "max": 12000}, "comic": {"min": 12000, "max": 12000}, "correction": {"min": 3000, "max": 3000}}, "links": [{"label": "Twitter", "url": "https://x.com/Fruscia_pcsp", "name": "Fruscia_pcsp"}, {"label": "Misskey_io", "url": "https://misskey.io/@fruscia", "name": "fruscia"}, {"label": "Website", "url": "https://fruscia.fanbox.cc", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/69986246", "name": "69986246"}], "flags": {"from_archive": true}, "works": [{"path": "/@Fruscia_pcsp/works/525", "thumbnail_src": "https://si.imgix.net/2a694a7e/uploads/origins/303022b9-b799-46aa-a8d8-d1b3cf7436af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ed5866ce55f6ed287e1812dfe3b7f4b", "thumbnail_srcset": "https://si.imgix.net/2a694a7e/uploads/origins/303022b9-b799-46aa-a8d8-d1b3cf7436af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ed5866ce55f6ed287e1812dfe3b7f4b, https://si.imgix.net/2a694a7e/uploads/origins/303022b9-b799-46aa-a8d8-d1b3cf7436af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f4677be012ffeb97198a0dab3974581 2x, https://si.imgix.net/2a694a7e/uploads/origins/303022b9-b799-46aa-a8d8-d1b3cf7436af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4eb2172c151c601979e35854367a05eb 3x", "genre": "art", "nsfw": true, "body": "アピールありがとうございます！\nかなり遅くなってしまって申し訳ないです！\n\nキャラクターは、ブルーアーカイブの尾刃カンナをお願いします。\n\nシチュエーションは以下の通りでお願いします。\n・仕事のストレスと発情期が重なって自制心がなくなり先生を襲い騎乗位している\n・衣服についてはおまかせで胸などは見えている\n・射精中も「出せ」や「もっと出せ」と強要している感じ\n・射精後「まだ出来ますよね？」のような余裕のある表情をする\n\n可能であればセリフを入れていただきたいです。\n内容についてはお任せします。\n\n依頼内容が多くなり申し訳ないですがご検討の程よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Fruscia_pcsp/works/524", "thumbnail_src": "https://si.imgix.net/bf422f1b/uploads/origins/62e22cd9-6ab2-4c78-9b1d-4594975e4860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea64b896b64d87db2b4f60d348b1913", "thumbnail_srcset": "https://si.imgix.net/bf422f1b/uploads/origins/62e22cd9-6ab2-4c78-9b1d-4594975e4860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea64b896b64d87db2b4f60d348b1913, https://si.imgix.net/bf422f1b/uploads/origins/62e22cd9-6ab2-4c78-9b1d-4594975e4860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a51a276f03ef4cfa6fec807b4d0e59b 2x, https://si.imgix.net/bf422f1b/uploads/origins/62e22cd9-6ab2-4c78-9b1d-4594975e4860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed7cdf15bfbb68ec296e358a3a6ad2d3 3x", "genre": "art", "nsfw": true, "body": "フレシア様\n\nアピールありがとうございます。遅くなり申し訳ございません。nsfwイラストをリクエストさせていただきたく思います🙇\n\n【キャラクター】\n麻布麻衣、佐々木翔音(ラブライブブルーバード)\n\n【シチュエーション】\n・麻布麻衣は晒し台で拘束されている\n・佐々木翔音は麻縄で後手に縛られている\n・佐々木翔音はペニパンを装着しており、無理やり麻布麻衣とバックでレズセックスをさせられている\n・可能ならばボールギャグ差分をお願いします\n\n背景などの細かい設定はおまかせでお願いします。\n\nお手数ですがご検討のほどよろしくお願いします🙇", "created_at": "", "completed_at": ""}, {"path": "/@Fruscia_pcsp/works/523", "thumbnail_src": "https://si.imgix.net/ece11f13/uploads/origins/e1844b43-ddc0-4a51-ab06-0193b8280bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554e7725a090b31a36c6d770f8b91f44", "thumbnail_srcset": "https://si.imgix.net/ece11f13/uploads/origins/e1844b43-ddc0-4a51-ab06-0193b8280bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554e7725a090b31a36c6d770f8b91f44, https://si.imgix.net/ece11f13/uploads/origins/e1844b43-ddc0-4a51-ab06-0193b8280bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c69cf12ab8f66bc2238b0f4b2ce6a204 2x, https://si.imgix.net/ece11f13/uploads/origins/e1844b43-ddc0-4a51-ab06-0193b8280bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a52160ab45b2ad09c0d036b5f9d06c 3x", "genre": "art", "nsfw": true, "body": "フレシアさん初めまして。いつもかわいいイラスト楽しんでいます。今回は描いて欲しい百合モノがある為、このような形でオーダーさせていただきました。\n＊キャラクター\nブロッくるの女神アリカとネプテューヌの女神プルルート(アイリスハート)\n\n＊服装\nドレスの着脱はお任せします\n\n＊シチュエーション\n女神同士の交流の一環として女神アリカと女神プルルートはお互いのおっぱいをもてあそび合う……\n\n＊注意\nシチュエーションに関してアレンジOKです。(母乳など)\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Fruscia_pcsp/works/522", "thumbnail_src": "https://si.imgix.net/0ed11ab7/uploads/origins/29422ed1-e28c-48a4-a649-b47d29a3421d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57e2c1265c610aebca05ec9b40721057", "thumbnail_srcset": "https://si.imgix.net/0ed11ab7/uploads/origins/29422ed1-e28c-48a4-a649-b47d29a3421d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57e2c1265c610aebca05ec9b40721057, https://si.imgix.net/0ed11ab7/uploads/origins/29422ed1-e28c-48a4-a649-b47d29a3421d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc36f3a3da9634902ec7094eafb59357 2x, https://si.imgix.net/0ed11ab7/uploads/origins/29422ed1-e28c-48a4-a649-b47d29a3421d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3aa0adad6569e85532439e8088b5e7fc 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nあなたのアピールを受け取りました。あなたが私のキャラクターを描きたいと言ってくれたことに感謝していますし、私はあなたの絵が大好きです。私のキャラクターをあなたの望むように描いてください。大人っぽいお姉さんという雰囲気で、自信家です。過信しすぎて油断することも。参考までにGoogleドライブがあります。\n\nアピールありがとうございました。\n\nhttps://drive.google.com/drive/folders/1cVMgPrA7cXDdA4XreNgMXnA9ews1wIcR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Fruscia_pcsp/works/521", "thumbnail_src": "https://si.imgix.net/c1c14281/uploads/origins/96457ba4-22a3-4bbe-bf3f-9379eeba92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9edb86f8ad63962e0dd6bd0da82d2c8d", "thumbnail_srcset": "https://si.imgix.net/c1c14281/uploads/origins/96457ba4-22a3-4bbe-bf3f-9379eeba92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9edb86f8ad63962e0dd6bd0da82d2c8d, https://si.imgix.net/c1c14281/uploads/origins/96457ba4-22a3-4bbe-bf3f-9379eeba92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd43ce6d30bfb0f35f3b1aedf317cf29 2x, https://si.imgix.net/c1c14281/uploads/origins/96457ba4-22a3-4bbe-bf3f-9379eeba92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=323fd5ebc15b26dfc20367fef7e2f918 3x", "genre": "art", "nsfw": true, "body": "こんにちは、アピールありがとうございます。\n私のOC(https://www.pixiv.net/en/artworks/127021327)、花騎士ガールのカトレア、デート・ア・ライブの伊弉冉みくで百合依頼をお願いしたいです。OCはミクと着衣シザースをしていて、カトレアはOCを後ろからこんな感じでまさぐります(https://img4.gelbooru.com/images/a1/9e/a19e947b9ba01ca6d6cf3c68656cd02e.jpeg)。OCとカトレアがミクに微笑みかけている間、ミクは快感から横になっている。さらに、OCとカトレアがキスしている間、イクために背中を丸めるミクというバリエーションも追加。\n\nカトレア - https://static.wikia.nocookie.net/flowerknight/images/1/16/Portrait_112817.png/revision/latest?cb=20170904104926\n\nいざよいミク - https://static.wikia.nocookie.net/date-a-live/images/6/60/Miku_spirit_ver.png/revision/latest?cb=20140416091457", "created_at": "", "completed_at": ""}, {"path": "/@Fruscia_pcsp/works/520", "thumbnail_src": "https://si.imgix.net/15d57689/uploads/origins/06953271-6a0f-482f-86f5-512634802565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f245e15f682b6af31f519d14b3d14cb", "thumbnail_srcset": "https://si.imgix.net/15d57689/uploads/origins/06953271-6a0f-482f-86f5-512634802565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f245e15f682b6af31f519d14b3d14cb, https://si.imgix.net/15d57689/uploads/origins/06953271-6a0f-482f-86f5-512634802565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12de38f632ca4d00c7789e31c259e337 2x, https://si.imgix.net/15d57689/uploads/origins/06953271-6a0f-482f-86f5-512634802565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd064d1dd6ba426648a0f134a15cdd4c 3x", "genre": "art", "nsfw": true, "body": "イラストお願いします　めぞん一刻の音無響子様で何時もの普段着(スカート)で一刻館前掃除姿突然の風てスカートがめくれ上がり履いていた