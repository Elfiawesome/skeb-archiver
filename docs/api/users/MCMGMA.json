net/9dc96489/uploads/origins/eaf9342c-ede4-4234-9832-04c28fae2657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27b5176f243e0e936b8cd8b6de47e18d", "thumbnail_srcset": "https://si.imgix.net/9dc96489/uploads/origins/eaf9342c-ede4-4234-9832-04c28fae2657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27b5176f243e0e936b8cd8b6de47e18d, https://si.imgix.net/9dc96489/uploads/origins/eaf9342c-ede4-4234-9832-04c28fae2657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb6108770f141ee9db980641f21433a2 2x, https://si.imgix.net/9dc96489/uploads/origins/eaf9342c-ede4-4234-9832-04c28fae2657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d84b66de241c8841ab469d704ead5a9e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のOC、カズマの依頼を引き受けていただけないでしょうか？\n彼は16歳の孤児のファイヤーベンダーで、態度が悪く、意地悪そうな外見をしています。野生の猛獣を狩っていたため、体には引き締まった筋肉と様々な傷がある。\n\n右腕と右目がない！\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1ZFhUbaIuKH2-j62OQSBv_dEV8Jj3405x?usp=sharing\n\nhttps://drive.google.com/drive/folders/1ZFhUbaIuKH2-j62OQSBv_dEV8Jj3405x?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@MCMGMA/works/150", "thumbnail_src": "https://si.imgix.net/096cd405/uploads/origins/a8d4267e-031e-4b84-bf12-c30bf6859f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f5402ad4c6bfabaa771fa66cebb3dcd", "thumbnail_srcset": "https://si.imgix.net/096cd405/uploads/origins/a8d4267e-031e-4b84-bf12-c30bf6859f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f5402ad4c6bfabaa771fa66cebb3dcd, https://si.imgix.net/096cd405/uploads/origins/a8d4267e-031e-4b84-bf12-c30bf6859f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6259d6dcd762a1657a1ff0bf6049af3e 2x, https://si.imgix.net/096cd405/uploads/origins/a8d4267e-031e-4b84-bf12-c30bf6859f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1