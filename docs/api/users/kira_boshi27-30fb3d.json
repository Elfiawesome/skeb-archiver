f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96f8aa82c67cec7258a9af8e81156646 3x", "genre": "comic", "nsfw": true, "body": "お世話になっております。\nプリンセスコネクトRe:Diveから現実の由仁とちえるをお願いしたいです。\n\n●描いてほしい流れ\n騎士くんとの性行為に興味がある由仁を、騎士くんと既にヤってるちえるが説き伏せ、騎士くんの部屋にで行為へ至るという導入で。\n「パイズリで騎士くんを勃たせるちえる」「見せ槍されちんちんのでかさにビビる由仁」「おちんちんの大きさを実況するちえる（見て下さいこのでっぱり、これでおなか削られると頭おかしくなるくらい気持ちいいんですよ、等）」「由仁とセックス。最初は苦しそうだったが最後は慣れ、らぶらぶべろちゅーしながらイく」「嫉妬したちえるが私も‥！というところでオチ」\nを描いていただきたいです。内容が多ければ金額再送頂ければ。\n\n引き受けてくだされば嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kira_boshi27/works/50", "thumbnail_src": "https://si.imgix.net/7c8245af/uploads/origins/8593c21d-7fab-46eb-928e-6fa907194f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c92bb4e3e57291a14b9a9425b78009d2", "thumbnail_srcset": "https://si.imgix.net/7c8245af/uploads/origins/8593c21d-7fab-46eb-928e-6fa907194f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c92bb4e3e57291a14b9a9425b78009d2, https://si.imgix.net/7c8245af/uploads/origins/8593c21d-7fab-46eb-928e-6fa907194f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc96b1e7d848923a658003ab6d05f95d 2x, https://si.imgix.net/7c8245af/uploads/origins/8593c21d-7fab-46eb-928e-6fa907194f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72a270f5d18578da005afa6ab14b9740 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kira_boshi27/works/49", "thumbnail_src": "https://si.imgix.net/4b93183b/uploads/origins/8fc4d818-a927-40be-8e36-f4ea81fa9739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d32fe5fdcc0a9a2d164387035c0568a9", "thumbnail_srcset": "https://si.imgix.net/4b93183b/uploads/origins/8fc4d818-a927-40be-8e36-f4ea81fa9739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d32fe5fdcc0a9a2d164387035c0568a9, https://si.imgix.net/4b93183b/uploads/origins/8fc4d818-a927-40be-8e36-f4ea81fa9739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c60131cc71bb19234e360219b9587c4 2x, https://si.imgix.net/4b93183b/uploads/origins/8fc4d818-a927-40be-8e36-f4ea81fa9739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36a053d893d164279601f1b0e2d7748d 3x", "genre": "art", "nsfw": true, "body": "始めまして、リクエストさせていただきたいと思いました。\n\nキャラ　プリコネのエリス様（水着）と騎士くん（水着）の漫画\n\n・夏の夜の泊まり宿で夏の思い出作りをしちゃうラブラブな感じでお願いします。\n・あせあせしながら騎士クンに気持ちいい思いをしてもらおうと頑張ろうとしてるエリス\n・ログで見て知ってたが水着から出た超デカい生の騎士クンのチンポ見せ槍されて目を見開いて硬直\n・爆乳をもみしだかれたり不意打ちで乳首を引っ張られてのけぞり舌出しアクメ\n・騎士クンにリードされて激しいラブラブセックス\n最後に騎士クンにメロメロになりながらキスをする感じでお願いします。\n\nご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kira_boshi27/works/48", "thumbnail_src": "https://si.imgix.net/a08dc748/uploads/origins/677da353-b733-4d46-ad78-0a2e60627c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a610e901dfbf554ad4f1061cd8eadef", "thumbnail_srcset": "https://si.imgix.net/a08dc748/uploads/origins/677da353-b733-4d46-ad78-0a2e60627c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a610e901dfbf554ad4f1061cd8eadef, https://si.imgix.net/a08dc748/uploads/origins/677da353-b733-4d46-ad78-0a2e60627c68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d78c0bf096d17f95e96a35dd33add313 2x, https://si.imgix.net/a08dc748/uploads/origins/677da353-b733-4d46-ad78-0a2e60627c68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73ab78fe7b1ecda8f5d131f4c3e8c73b 3x", "genre": "comic", "nsfw": true, "body": "リクエストをさせて頂きます。\nプリンセスコネクトRe:Diveのリンド・ヴルムと騎士くんのイチャラブえっちをお願いしたいです。\n\nリンドは普段真面目でお堅いですが、チョロくて最後は何でも許してしまいます。\nヴルムは不真面目で気だるげですが、性行為には積極的で文句を言いつつも奉仕をしてくれます。\n\n●描いてほしい流れ\n主であるライラエルの為、騎士くんを手籠めにしようと夕食に媚薬を盛るヴルム。\n夜、媚薬でギンギンになり眠れない騎士くんの元に姉妹２人で夜這い。想像以上の巨根に興奮しつつもW手コキ、Wフェラ。その後我慢できなくなって騎士くんに襲われます。\nまずリンドが正常位で犯されます。最初は「れーぷですよっ♥」と止めようとするもヴルムがその様子を実況（「騎士さんのバッキバキのデカチンこんなとこまで入っちゃってますよ～♥」のような）を聞き興奮。最後はとろとろになって騎士さんにキスと中出しを要求します。\n次にヴルムは腕引きバックで犯されます。最初は余裕をもって受け入れようとするも「こんなのズルい♥」とだんだん余裕をなくし、オホ声を上げイキます。\nオチはまだまだ収まらない騎士くんに更に犯される様子で。\n\n以上となります、引き受けてくだされば嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@kira_boshi27/works/47", "thumbnail_src": "https://si.imgix.net/1ac602ca/uploads/origins/2dae1da9-da39-4673-ba76-807781504f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f085f5da6d34507ad78253b245e4fb0", "thumbnail_srcset": "https://si.imgix.net/1ac602ca/uploads/origins/2dae1da9-da39-4673-ba76-807781504f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f085f5da6d34507ad78253b245e4fb0, https://si.imgix.net/1ac602ca/uploads/origins/2dae1da9-da39-4673-ba76-807781504f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=774d47bc650e6f4dae4da996584d071a 2x, https://si.imgix.net/1ac602ca/uploads/origins/2dae1da9-da39-4673-ba76-807781504f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca3dbf8b8b4d32b07faf52840e1259c9 3x", "genre": "comic", "nsfw": true, "body": "skeb募集再開とのことでリクエストを送らせてもらいます\nゼンゼロのイヴリンが金持ちの息子のガキにいいようにされるシチュの漫画をお願いします。\n体系は爆乳巨尻のムチムチグラマー体系でお願いします。\n衣装は光沢のある黒色でロンググローブとニーハイにスリングショット水着か露出多めのハイレグ系の水着。\n\n\n・「パパもらったこのおクスリ試させてよ、少量って書いてあるけどお姉ちゃん強いから一本全部でもいいよね」\nと手を拘束された蹲踞のような体勢で制で媚薬をかがされ強制的に発情状態にさせられている状態\n\n・アストラとの通話中にお尻に顔をうずめられて舐められたり揉まれたり激しく責められて、何とか必死に耐えているも尻を叩かれて声が漏れてしまう様子\n\n・激しい寝バック、または正常位をしながらイク寸前で寸止めを自分の所有物になることを強要する。度重なる攻めに屈服し陥落したところに射精する獣のような声で激しく絶頂する様子。\n\n・イキ潰されてカエルのようにひっくり返っているような体勢で完全にチンポのことしか考えられず媚薬を乗せたチンポヲを必死に嗅いでいる様子\n\n・ハート目の陥落状態でパイズリしながら今度はアストラも呼んでくることを了承しているシチュ\n\n\n以上箇条書きした中で金額内で可能な範囲でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kira_boshi27/works/46", "thumbnail_src": "https://si.imgix.net/4b6c2b0e/uploads/origins/5522311d-648c-48e8-a089-123292796a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4567dbeb16a0b981a96342dc32f495d1", "thumbnail_srcset": "https://si.imgix.net/4b6c2b0e/uploads/origins/5522311d-648c-48e8-a089-123292796a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4567dbeb16a0b981a96342dc32f495d1, https://si.imgix.net/4b6c2b0e/uploads/origins/5522311d-648c-48e8-a089-123292796a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5859cc56e0c7fc3d2a491cdbcf218fb 2x, https://si.imgix.net/4b6c2b0e/uploads/origins/5522311d-648c-48e8-a089-123292796a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bcff82c4f27da0b3db9403919357005 3x", "genre": "comic", "nsfw": true, "body": "よろしければグラブルのアリシアママさんのえっちなショート漫画をお願いできますでしょうか？ \n シチュはガタイの大きな旦那との濃厚なドラフセックスの想定です。 \n\n細かい点はお任せしますが以下の構図をお願いします。 \n①事前の様子。お互いの身体を触り合いながらのイチャイチャディープキス \nhttps://www.pixiv.net/artworks/95399234   \n\n②セックスシーン様子。腕を掴んだ激しい後輩位でおっぱいをぶるんぶるん揺らすセックス、アリシアさんは余裕なく下品なオホ顔を晒す \nhttps://twitter.com/_anannex/status/1520163907725570049?  \n\n③フィニッシュシーンの様子。胸を揉みしだきながらの射精シーン、アリシアさんは母乳を吹き出し絶頂 \nhttps://www.pixiv.net/artworks/94784590（3p目）  \n\n④事後。旦那はひと段落という感じで休憩中、アリシアさんはガニ股で潮を吹きながら伸びている様子 \nhttps://www.pixiv.net/artworks/81969625\n  https://www.pixiv.net/artworks/87972666（女側のイメージはこちらの方が近いです）\n\n  衣装はお互いほぼ裸で問題ありません。\n またあくまで希望ですので、漫画的に不都合がありましたら省いてもらっても問題ございません。先生の描きやすいようにお願いします。\n  どうかご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kira_boshi27/works/45", "thumbnail_src": "https://si.imgix.net/ab0f346a/uploads/origins/289e156a-afb4-4b10-ba7c-9b9f637f962f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f27e71008bb021618852a4ebbcdcf36", "thumbnail_srcset": "https://si