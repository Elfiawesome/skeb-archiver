です。\n\nhttps://www.evernote.com/shard/s538/client/snv?noteGuid=a3f9ebba-e225-45f8-ab00-8090b1130743&noteKey=4c57d0bf3ce7c8fb91ebae949a92611e&sn=https%3A%2F%2Fwww.evernote.com%2Fshard%2Fs538%2Fsh%2Fa3f9ebba-e225-45f8-ab00-8090b1130743%2F4c57d0bf3ce7c8fb91ebae949a9", "created_at": "", "completed_at": ""}, {"path": "/@sikurooooo/works/7", "thumbnail_src": "https://si.imgix.net/d4def272/requests/24491_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eae12f579552ac6868fef4475b15082c", "thumbnail_srcset": "https://si.imgix.net/d4def272/requests/24491_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eae12f579552ac6868fef4475b15082c, https://si.imgix.net/d4def272/requests/24491_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c6bb071f79df4db1161a4d42e13d203 2x, https://si.imgix.net/d4def272/requests/24491_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0c82be0c62921888532e7b5e8346b6a 3x", "genre": "art", "nsfw": false, "body": "苦渋しくろ様、初めまして。\n個人Vtuberのやまや智子と申します。\nこの度私自身のイラストをお願いしたくリクエストをさせていただきました。\n容姿等は(@yamayatomo)の固定ツイートをご参照ください。\n構図等はお任せいたします。\nご検討の程よろしくお願いいたします。\n\nhttps://twitter.com/yamayatomo/status/1139719175176257538?s=20", "created_at": "", "completed_at": ""}, {"path": "/@sikurooooo/works/6", "thumbnail_src": "https://si.imgix.net/71132a16/requests/18218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1c066d4137f849cc5e4662912dcc7e", "thumbnail_srcset": "https://si.imgix.net/71132a16/requests/18218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1c066d4137f849cc5e4662912dcc7e, https://si.imgix.net/71132a16/requests/18218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30f1c8def9c4e6d60477ca86f813232f 2x, https://si.imgix.net/71132a16/requests/18218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4af7c2d9344e46d98fb707cf803