fdf-ccf05f1adcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d346f1af739e58af1c085d8089b53637 2x, https://si.imgix.net/d7076068/uploads/origins/d2f70f5e-0fb3-4e19-afdf-ccf05f1adcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22c3402ee425e737639c9965a00aea8e 3x", "genre": "art", "nsfw": true, "body": "度々お世話になっております。\n以前先生の描かれた\nhttps://skeb.jp/@chome1/works/171\nがド好みでしたので同じ正中線メカバレからの少し抱き枕風にポーズをとったシチュの絵をリクエストいたします。\n\n【キャラクター】\nSAOより\nイーディス・シンセシス・テン\nアリス・シンセシス・サーティ\nの両名(どちらも電脳空間上の存在でアリスは実際に作中でマシンボディによって現実世界に進出しています)\n\n【衣装】\n以下の候補からお願いします。\n・イーディス\n①https://www.pixiv.net/artworks/111444198\nの衣装(胸のキリトさんデフォルメ)\n②オーディナル・スケール衣装\nhttps://www.pixiv.net/artworks/107456222\nhttps://www.pixiv.net/artworks/118761292\nhttps://www.pixiv.net/artworks/130413667\nからレギンスをなくして生脚にしたもの\n\n・アリス\nhttps://x.com/ves_ZoL/status/1932486803526987834?t=RIn8Y2AcN1ECXu81n7mSqQ&s=19\nのレースクイーン衣装の内いずれか(2,3枚目は同じものです)\n【ポーズ】\nイーディス:片手で両乳首、もう片方の手で秘所を隠し少々恥じらってる。\nアリス:手首足首を上下で縛られたようになり(実際には縛られていない)、腋とぴっちり閉じた太腿を強調するポーズ。\n表情は「で、私をこれからどうするつもりだ？」と不敵に問う女騎士のような余裕ある表情\n\n内部構造につきましてはhttps://x.com/ves_ZoL/status/1932490985440972885?t=HYvzCszxckSRReQsCj2_IA&s=19\nのカメラアイ以外不明なので両者共通であること以外はお任せいたします。\n条件付再送の場合お時間お掛けするかもしれませんが可能な限りお応えする所存です。\n何卒ご一考いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/196", "thumbnail_src": "https://si.imgix.net/8cf75976/uploads/origins/faedce15-b33c-48c0-9b39-2b1269ac87c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd337902760e48a4ee2aed8b55381da4", "thumbnail_srcset": "https://si.imgix.net/8cf75976/uploads/origins/faedce15-b33c-48c0-9b39-2b1269ac87c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd337902760e48a4ee2aed8b55381da4, https://si.imgix.net/8cf75976/uploads/origins/faedce15-b33c-48c0-9b39-2b1269ac87c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83b6fdd830fa27265cb9fb971b96ce0d 2x, https://si.imgix.net/8cf75976/uploads/origins/faedce15-b33c-48c0-9b39-2b1269ac87c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3553e2935f58196b2478a168b4ba8a23 3x", "genre": "art", "nsfw": true, "body": "匿名にて失礼します。\nコマンダーミレーヌの作品の、特に、\n体内で爆発が起きている表現が素晴らしいと感じ、\nリクエストをさせて頂きました。\n\nキャラクターはファミコンソフト『スペースハンター』の主人公『アルティアナ』で、\n資料URLの作品等が原作のイメージに近いように思いますので、よろしければ御確認くださいませ。\n\n公式設定がサイボーグのキャラで、原作ゲームは割とシリアスな雰囲気だった気がします。\n\n具体的な希望としましては、\n既に満身創痍の状態で、ダメージが許容範囲を超えてしまい、\n下腹部を中心に体内で起きてしまった爆発から、\n全身あちこち内部で誘発が起きはじめてしまっている状況です。\n\n“満身創痍”のメカバレ具合などは、お任せします。\n\n“体内の大事な場所”に光線系のダメージを減衰させるような機関があって、\nそれが限界を超えてしまい爆発してしまったイメージです。\n\nこの直後には、身体が跡形もないくらい爆発四散…みたいな、\n想像ができてしまう感じが希望です。\n(実際、簡易的なものの、そんな感じのゲームオーバーです)\n\nキャラの配色と対比させる意味で、爆炎は青白系を希望ですが、\n難しいそうであれば黄色～オレンジ系の色合いでも大丈夫です。\n\n誘爆の感じについては、まさに“コマンダーミレーヌ”の\n上半身に描かれているようなイメージなのですが、\nイラストの直後に“四散”までいってしまうことを想起させるべく、\n太ももや、ブーツ(設定として飛行用のロケット内蔵)にも発生しつつある感じで、\n特に、首の付け根や腕の付け根あたりにも表現を御願いできればと思います。\n\n尚、『爆心地』の下腹部辺りは、最初に爆発が起きている点を考慮すると、\n爆炎大きめで、なんでしたら、爆炎に隠れた部分では、\n既に身体が上下に別れてしまっているような構図にて、\n御一考を願えればと思います。\n(バランス重視にて、この辺りはマストではございません)\n\n表情は断末魔って感じでしょうか。\n目をつむっているか見開いているかはお任せしたいと思いますが、\n舌出しNGにて御願いいたします。\n\n内容が内容ですのでNSFWはONとしましたが、少なくとも特にストレートなエロ表現は求めません。\n\n以上、御検討いただけましたら幸いです。\nよろしく御願いいたします。\n\nhttps://www.pixiv.net/artworks/93003070", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/195", "thumbnail_src": "https://si.imgix.net/d6213458/uploads/origins/8d94ff92-cabb-42ae-b3f7-0cf696125015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d7b1e44828579c5af9ee931478dd33e", "thumbnail_srcset": "https://si.imgix.net/d6213458/uploads/origins/8d94ff92-cabb-42ae-b3f7-0cf696125015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d7b1e44828579c5af9ee931478dd33e, https://si.imgix.net/d6213458/uploads/origins/8d94ff92-cabb-42ae-b3f7-0cf696125015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d49777cd222dc86e720a6094437440e1 2x, https://si.imgix.net/d6213458/uploads/origins/8d94ff92-cabb-42ae-b3f7-0cf696125015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49da3c7b220176f854b3d1a4c5009fee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/194", "thumbnail_src": "https://si.imgix.net/cde7e184/uploads/origins/3c2dde32-b3f4-4d2f-a7f0-a94e4c9eb6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86d6902af26b73c64bd297986fac076c", "thumbnail_srcset": "https://si.imgix.net/cde7e184/uploads/origins/3c2dde32-b3f4-4d2f-a7f0-a94e4c9eb6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86d6902af26b73c64bd297986fac076c, https://si.imgix.net/cde7e184/uploads/origins/3c2dde32-b3f4-4d2f-a7f0-a94e4c9eb6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b36129ab60194856086877a4e48bdc5e 2x, https://si.imgix.net/cde7e184/uploads/origins/3c2dde32-b3f4-4d2f-a7f0-a94e4c9eb6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f85fae80afe2c4ed99f3e5182cf8ba90 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nDimension Wというアニメのマイナーなキャラクター2人のアートをお願いしたいです！そのキャラクターは、一話限りの悪役の双子のアシスタントロボットです。彼らは主人公の一人によって使用不能にされるのですが、双子が修理されるシーンをお願いします！\n\nhttps://www.fembotwiki.com/index.php?title=Dimension_W\nhttps://www.dropbox.com/scl/fi/eqszeu9c2vnqz8gmz6aae/Dimension-W-Damage-2.mp4?rlkey=3nl6y0uobvxacoxnnidspugtu&st=pz9ltcg6&dl=0\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/193", "thumbnail_src": "https://si.imgix.net/3293298a/uploads/origins/b02d5735-6f34-445b-ae5f-227ce33d29ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66e6a67e4be8f990409a1f855619a42", "thumbnail_srcset": "https://si.imgix.net/3293298a/uploads/origins/b02d5735-6f34-445b-ae5f-227ce33d29ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66e6a67e4be8f990409a1f855619a42, https://si.imgix.net/3293298a/uploads/origins/b02d5735-6f34-445b-ae5f-227ce33d29ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=150a0c028f78e9756a99ebc7ce89bf68 2x, https://si.imgix.net/3293298a/uploads/origins/b02d5735-6f34-445b-ae5f-227ce33d29ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8d6a3ad144f6d8aeecaf4f6add2e39e 3x", "genre": "art", "nsfw": true, "body": "ダイターン３より、変身状態のコマンダーミレーヌさんのイラストをお願いします。\nダイターンからトドメのサンアタックをくらって腹部をえぐられ、立っているのがやっとの状態。\n兜や鎧はボロボロ、健闘むなしく折れたサーベルを握りしめている。\n敗北を認められないミレーヌは、歯を食いしばり何とか耐えようとしているが、腕や足の付根からに電撃、火花が吹き出し、爆発寸前。", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/192", "thumbnail_src": "https://si.imgix.net/87cacb29/uploads/origins/15afb806-469d-46a7-88a1-772bac25db90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32432ec8601520d7c969efeb66808377", "thumbnail_srcset": "https://si.imgix.net/87cacb29/uploads/origins/15afb806-469d-46a7-88a1-772bac25db90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32432ec8601520d7c969efeb66808377, https://si.imgix.net/87cacb29/uploads/origins/15afb806-469d-46a7-88a1-772bac25db90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb1ce197f874a68ff9126f9158efd4b5 2x, https://si.imgix.net/87cacb29/uploads/origins/15afb806-469d-46a7-88a1-772bac25db90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e45d17473d9f6a8fae9649ca035cb90 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/191", "thumbnail_src": "https://si.imgix.net/5e9f500d/uploads/origins/c9a5d40e-a39c-4f20-87b9-b0ed968f9233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd146e27f00e58b362635b32c71f80a7", "thumbnail_srcset": "https://si.imgix.net/5e9f500d/uploads/origins/c9a5d40e-a39c-4f20-87b9-b0ed968f9233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd146e27f00e58b362635b32c71f80a7, https://si.imgix.net/5e9f500d/uploads/origins/c9a5d40e-a39c-4f20-87b9-b0ed968f9233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc19296d283cbacc3c899896e1ebe0be 2x, https://si.imgix.net/5e9f500d/uploads/origins/c9a5d40e-a39c-4f20-87b9-b0ed968f9233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9a90cf354f1bc0d3d9c4336b0509f34 3x", "genre": "art", "nsfw": true, "body": "はじめまして。ロボ娘のイラストをリクエストします。\n外見のイメージはテスラボットのような顔面がディスプレイ、ボディが白い全身タイツの女性型ロボットです。体付きは巨乳のモデル体型、胸と股間はボディと同じ色でビキニアーマーのような装甲を付けてください。\nSEX時には身体が以下のように専用モードに移行します。\n・下半身が黒く変色してハイレグのような配色になる(Haydeeのイメージ)\n・装甲がパージして胸と股間が露出する。こちらも肌の色は黒\n・ディスプレイには大きくハートマークが表示される\n即落ち2コマのように通常モードと性処理モードの立ち絵が欲しいです。性処理モードの方は両手を頭の後ろに回し、脚はガニ股に開いた服従のポーズにしてください。\n\n以上、ご検討のほど宜しくお願いします。\n\n参考URL\nhttps://japan.cnet.com/article/35175505/\nhttps://dic.pixiv.net/a/Haydee", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/190", "thumbnail_src": "https://si.imgix.net/4d966bb6/uploads/origins/55728751-50a0-4a54-a3a4-0fc4e0474e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0670a81edfcf8d74bd088912cf64b4d", "thumbnail_srcset": "https://si.imgix.net/4d966bb6/uploads/origins/55728751-50a0-4a54-a3a4-0fc4e0474e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0670a81edfcf8d74bd088912cf64b4d, https://si.imgix.net/4d966bb6/uploads/origins/55728751-50a0-4a54-a3a4-0fc4e0474e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d840f03921604c55740e498c67c6f21b 2x, https://si.imgix.net/4d966bb6/uploads/origins/55728751-50a0-4a54-a3a4-0fc4e0474e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfc7f076f1d8b6b1338af8d1aee03a80 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n漫画[ 荒野に獣慟哭す ]に登場する3人のキャラクターのイラストをお願いしたいです！3人のキャラクターはサイボーグ傭兵( https://www.fembotwiki.com/images/b/b7/Kouya_ni_Kemono_Doukokusu_04_001.jpg )です。サイボーグ傭兵(  )です。\n\n以前描いた作品の続編のような感じでお願いします。修理と再組み立てのシーンをお願いできますか？詳細はお任せしたいと思います。\n\n参考文献\nhttps://www.fembotwiki.com/images/c/c3/Kouya_ni_Kemono_Doukokusu_01_117.jpg\nhttps://www.fembotwiki.com/images/4/45/Kouya_ni_Kemono_Doukokusu_03_25.jpg\nhttps://www.fembotwiki.com/images/5/5a/Kouya_ni_Kemono_Doukokusu_03_126.jpg\nhttps://www.fembotwiki.com/images/0/0d/Kouya_ni_Kemono_Doukokusu_04_119.jpg\nhttps://www.fembotwiki.com/images/2/2a/Kouya_ni_Kemono_Doukokusu_04_147.jpg\nhttps://www.fembotwiki.com/images/3/31/Kouya_ni_Kemono_Doukokusu_04_174.jpg\nhttps://www.fembotwiki.com/images/9/9d/Kouya_ni_Kemono_Doukokusu_04_176.jpg\nhttps://www.fembotwiki.com/images/0/0f/Kouya_ni_Kemono_Doukokusu_04_177.jpg\nhttps://www.fembotwiki.com/images/6/6f/Kouya_ni_Kemono_Doukokusu_15_099.jpg\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/189", "thumbnail_src": "https://si.imgix.net/e18cda91/uploads/origins/26b1570a-4aaa-40dc-b1af-40d2e802f814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d86400d89f0a82d9b3f00909b9985f2", "thumbnail_srcset": "https://si.imgix.net/e18cda91/uploads/origins/26b1570a-4aaa-40dc-b1af-40d2e802f814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d86400d89f0a82d9b3f00909b9985f2, https://si.imgix.net/e18cda91/uploads/origins/26b1570a-4aaa-40dc-b1af-40d2e802f814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd75db64b9d987f29bbc9983ee27654e 2x, https://si.imgix.net/e18cda91/uploads/origins/26b1570a-4aaa-40dc-b1af-40d2e802f814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45e4f73b89337a917c745a93f44e6ed1 3x", "genre": "art", "nsfw": true, "body": "大変お世話になっております。前回は戦闘用サイボーグに改造され、最終的な調整を行われて快楽に赤面している青年を描いていただきまして、本当にありがとうございました。とても雰囲気が良かったです!\n今回は、前回の青年を素材にして、「激しく」やっていただきたく思います。\nシチュとしては、前回改造された青年が、戦闘によって相当な損傷して、なんとか帰還。激しい損傷だったので修理も兼ねたアップグレードをすることになり、「再改造」されるというイメージです。\n具体的には、手術台に拘束された前回の青年が、損傷した胸から腹部などにかけて内部構造をメカバレさせていて、修繕されている。(可能であれば、片腕、片脚あたりにも損傷があれば…)その他の部分は、前回よりも強化された外骨格、アーマーに交換済み。ケーブルやチューブが接続され、調整もされていて、再度の快楽を受けている姿を希望します。首から上は前回と準拠していただければとおもいます。可能であれば、かなり激しくメカバレしている姿、そして外骨格もより「盛って」いただければと思います。\nその他のデザイン、構成、構図、カラーリングなどはすべておまかせします。\n毎度、男子ネタ、かつ同じようなマニアックな内容で申し訳ありませんが、よろしくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/188", "thumbnail_src": "https://si.imgix.net/9313a609/uploads/origins/30806b8d-49eb-475a-8916-f7b0bccf7063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c315aa60cb58a74614b188d829f98d23", "thumbnail_srcset": "https://si.imgix.net/9313a609/uploads/origins/30806b8d-49eb-475a-8916-f7b0bccf7063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c315aa60cb58a74614b188d829f98d23, https://si.imgix.net/9313a609/uploads/origins/30806b8d-49eb-475a-8916-f7b0bccf7063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=788497d830fbbee2375c607e4d65eacb 2x, https://si.imgix.net/9313a609/uploads/origins/30806b8d-49eb-475a-8916-f7b0bccf7063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33b251e513980992f4378881e86e74f2 3x", "genre": "art", "nsfw": true, "body": "Hello, I would like a mechabare illustration featuring Tifa   https://files.catbox.moe/76016n.jpg and Scarlet https://files.catbox.moe/jz4o19.jpg from Final fantasy 7 as robot girls. They are both fighting, Tifa is winning and Tifa is on top of Scarlet punching Scarlet like https://files.catbox.moe/4g8qfv.jpg. Tifa should have some damage on her like https://files.catbox.moe/rfy08z.jpg and Scarlet should be extremely damaged like https://skeb.jp/@chome1/works/121", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/187", "thumbnail_src": "https://si.imgix.net/73259899/uploads/origins/a9371a72-747e-4993-be79-ef7c4da8ea06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e44b161414c0fef39426618b77a19b", "thumbnail_srcset": "https://si.imgix.net/73259899/uploads/origins/a9371a72-747e-4993-be79-ef7c4da8ea06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e44b161414c0fef39426618b77a19b, https://si.imgix.net/73259899/uploads/origins/a9371a72-747e-4993-be79-ef7c4da8ea06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7aa4ef31a9b9c2ca671fb001925995ab 2x, https://si.imgix.net/73259899/uploads/origins/a9371a72-747e-4993-be79-ef7c4da8ea06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2939e66a53f0bd8427c0d02c67a50778 3x", "genre": "art", "nsfw": true, "body": "悪の組織の魔の手から一般市民を守る為機械化改造を施された3人の女性が並んで起動しているシーンをお願いします。\n彼女達は脳を完全に機械化されており素体の記憶や行動ルーティーンを元に造られた疑似人格によって稼働します。\n彼女達の身体は戦隊ヒロインを思わせるようなデザインでありメカニカルなボディとなっております。\n関節部などはジョイント機構が見えておりよりロボットっぽい。それぞれカラーに対応したヘルメットを装着している。\n胴体の胸部は装甲で覆われているがその下には人工乳房があり股間周りの装甲の下には素体の再現された女性用パーツが存在している。\n\nヘルメットを着用した姿とヘルメットを脱いだ姿、可能であればそれぞれ胸部装甲を外されて豊かな乳房が丸見えとなって恥ずかしそうに顔を赤らめる姿をお願いします。\n\n彼女達は豊満なボディでムチムチで年齢も皆30代前半ぐらいです。\n三人の特徴は以下の通りです。\n\n右側　イエロー ショートヘア。褐色肌で筋肉質。勝気な姉御肌\n\n中央　レッド　ミディアムヘア。3人の中でリーダー機として登録されている。メガネを掛けた知的な雰囲気\n\n左側　ブルー　ロングヘア。3人の中でも一番胸やお尻が大きい。おっとりとしたお姉様", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/186", "thumbnail_src": "https://si.imgix.net/c6b79c17/uploads/origins/e1354534-8980-44d1-a2b9-8bfce93735ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=350f6047828a9504738d5735def3e3d1", "thumbnail_srcset": "https://si.imgix.net/c6b79c17/uploads/origins/e1354534-8980-44d1-a2b9-8bfce93735ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=350f6047828a9504738d5735def3e3d1, https://si.imgix.net/c6b79c17/uploads/origins/e1354534-8980-44d1-a2b9-8bfce93735ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90fcd8366e276564d95a9cae5ef56201 2x, https://si.imgix.net/c6b79c17/uploads/origins/e1354534-8980-44d1-a2b9-8bfce93735ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c034eb1078d41e01435cf046b649cba9 3x", "genre": "art", "nsfw": true, "body": "キャラクター　ドールズフロントライン2のHK416(クルカイ)\nシチュエーション　1枚目の基本ベースは資料画像の感じで出血（少ない・多い）銃創（あり・無し）\nで。\n2枚目で死亡した亡骸が瓦礫から出ている尖った鉄骨に胸を貫かれた状態で晒されている（ここではポニーテールが解けて普通のロングヘアーで）服ビリで犯された後もある感じでここでも精子（あり・無し）、銃創（あり）、出血（少ない・多い）で目のハイライトが消えている感じで全身が見える感じで晒される構図でお願いしたいです。\nあり、無しと表記していますがここの部分をpsdで差分をお願いしたいので可能でしたらお願いしたいです。\n御検討の程よろしくお願いします。\n\nhttps://x.com/nanasi_RPG/status/1835149842647335058/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/185", "thumbnail_src": "https://si.imgix.net/c712c6ba/uploads/origins/f74d5674-15ef-4f64-b7df-0075d491214e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15aef33ee37a655a8fb760cc289945eb", "thumbnail_srcset": "https://si.imgix.net/c712c6ba/uploads/origins/f74d5674-15ef-4f64-b7df-0075d491214e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15aef33ee37a655a8fb760cc289945eb, https://si.imgix.net/c712c6ba/uploads/origins/f74d5674-15ef-4f64-b7df-0075d491214e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25837581896725f07b7d8ae3368b9770 2x, https://si.imgix.net/c712c6ba/uploads/origins/f74d5674-15ef-4f64-b7df-0075d491214e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf3a2e72040acbba5495118e84c59894 3x", "genre": "art", "nsfw": true, "body": "加齢の力を甘く見つつ現金の力に頼る事にしました。\n\n例によって資料の銀髪褐色メスガキギザ歯貧乳刺青ロリダークエルフのカティちゃんについて、2025年の蛇年にピッタリの多腕ラミア化イラストをお願いしたいと思います。\nこの時の腕の本数は4本または6本でお願いいたします。\nその他の細かい点は全てお任せいたします。\n\nご検討よろしくお願いいたします。\n\n\nご参考※資料更新日2024年08月\nhttps://twitter.com/wagunasu_TS/status/1298940810973470720\n\nhttps://drive.google.com/file/d/1b5KNe8vOsA5UjAatG45zl1hFQLfYfD_T/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/184", "thumbnail_src": "https://si.imgix.net/d99e9ab0/uploads/origins/826b0ad8-470a-41ef-8dc2-f99163516ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e1b0c6a48a59d0a0ec6111186d01482", "thumbnail_srcset": "https://si.imgix.net/d99e9ab0/uploads/origins/826b0ad8-470a-41ef-8dc2-f99163516ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e1b0c6a48a59d0a0ec6111186d01482, https://si.imgix.net/d99e9ab0/uploads/origins/826b0ad8-470a-41ef-8dc2-f99163516ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16ed9b5effd4b6ec5c931d4daa19847b 2x, https://si.imgix.net/d99e9ab0/uploads/origins/826b0ad8-470a-41ef-8dc2-f99163516ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c59f13c5e3b1777293aa2b9e8e723c97 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/183", "thumbnail_src": "https://si.imgix.net/d7d8f5e8/uploads/origins/26f026dc-3fd7-4a69-aa40-e1ae64f17614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27a5f9af8ad74e555825fb2a38a6f2de", "thumbnail_srcset": "https://si.imgix.net/d7d8f5e8/uploads/origins/26f026dc-3fd7-4a69-aa40-e1ae64f17614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27a5f9af8ad74e555825fb2a38a6f2de, https://si.imgix.net/d7d8f5e8/uploads/origins/26f026dc-3fd7-4a69-aa40-e1ae64f17614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d218fc3122a940a797ecaaae2cd45f0b 2x, https://si.imgix.net/d7d8f5e8/uploads/origins/26f026dc-3fd7-4a69-aa40-e1ae64f17614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b9e1c71e801f2545c41329334518f16 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/182", "thumbnail_src": "https://si.imgix.net/c84f5de8/uploads/origins/726fe80f-3a76-4cfc-bf0d-9dc05acca665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112bd1fc4b0bef63813cdb09076533d8", "thumbnail_srcset": "https://si.imgix.net/c84f5de8/uploads/origins/726fe80f-3a76-4cfc-bf0d-9dc05acca665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112bd1fc4b0bef63813cdb09076533d8, https://si.imgix.net/c84f5de8/uploads/origins/726fe80f-3a76-4cfc-bf0d-9dc05acca665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce7bff7024f0abc782c5e8c9df8e7c1c 2x, https://si.imgix.net/c84f5de8/uploads/origins/726fe80f-3a76-4cfc-bf0d-9dc05acca665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47765b3cd33f4a5a5d36d9ca0c71b0e4 3x", "genre": "art", "nsfw": true, "body": "再びのリクエスト失礼いたします。\n\nアニメキャラクターをモチーフにしたサイボーグ改造シーンを描いていただけないでしょうか。\n\nキャラクター名は京都アニメーション制作「氷菓」の入須冬実です。\n人物像について取り上げたリンクを下記に貼ります。\n\nhttps://sp.nicovideo.jp/watch/sm20893161\n\nhttps://dic.pixiv.net/a/%E5%85%A5%E9%A0%88%E5%86%AC%E5%AE%9F\n\n以下、希望する架空のシチュエーションです。\n\n※手術台に裸で横たえられ腹部を改造されている冬実\n※冬実は冷静を装いながら興奮状態\n※執刀しているのは冬実の交際相手\n※涙がにじみ口や乳房、下腹部から液漏れ\n※「冷血なわたしをこんな淫乱人形に改造するなんて、きみはとんだヘンタイだね。キミに性的奉仕をしなければと全身がプログラムに興奮しているよ」的なセリフを苦しそうに吐き出す\n※人格までは改造されておらず、執刀者にそれを指摘される冬実\n※「そ、そうか、おかしいな、私は壊れてしまったかな…」ととぼけるツンデレな愛情シーン\n\n以上となります。冬実をエッチでかわいらしいサイボーグに改造していただければ幸いです。\n\n以前、投稿作家さんに書いていただいた同人作品がございます。\nhttps://www.pixiv.net/novel/show.php?id=20637043\nあくまでご参考になればと…。\n\nご検討の程お願いいたします。\n\nhttps://dic.pixiv.net/a/%E5%85%A5%E9%A0%88%E5%86%AC%E5%AE%9F", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/181", "thumbnail_src": "https://si.imgix.net/65487922/uploads/origins/e1dba7f5-6383-4d1f-ae53-615362527c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62909b68a7476ddbe18e5a435f5de1b0", "thumbnail_srcset": "https://si.imgix.net/65487922/uploads/origins/e1dba7f5-6383-4d1f-ae53-615362527c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62909b68a7476ddbe18e5a435f5de1b0, https://si.imgix.net/65487922/uploads/origins/e1dba7f5-6383-4d1f-ae53-615362527c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7c6cead7a05ef92716de7d4c5b36b43 2x, https://si.imgix.net/65487922/uploads/origins/e1dba7f5-6383-4d1f-ae53-615362527c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58bb5d471ba6e6817b9925d7e6402439 3x", "genre": "art", "nsfw": true, "body": "セイバーマリオネットRのブラッドベリーのメカバレイラストをお願いいたします。設定はOAV2巻でブラッドベリーとブリットのダイブ後、ブラッドベリーを引き剥がし、ブラッドベリーが地面に叩きつけられ破損機能停止している。イラストです。以上をご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/180", "thumbnail_src": "https://si.imgix.net/d809a2a2/uploads/origins/eb44fdc6-7e42-4894-bdd4-343639d732ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9161fdc29ad6212a411c88eaa2c07330", "thumbnail_srcset": "https://si.imgix.net/d809a2a2/uploads/origins/eb44fdc6-7e42-4894-bdd4-343639d732ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9161fdc29ad6212a411c88eaa2c07330, https://si.imgix.net/d809a2a2/uploads/origins/eb44fdc6-7e42-4894-bdd4-343639d732ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40e5e0403e7840ca8bd6aac9dfc63419 2x, https://si.imgix.net/d809a2a2/uploads/origins/eb44fdc6-7e42-4894-bdd4-343639d732ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a2ec5515b43db9eae0fe16e2ed59b5b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/179", "thumbnail_src": "https://si.imgix.net/cadf7d5b/uploads/origins/3f268e75-f4eb-4b8b-a283-14bb08194985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f891d43c7da99c5e31c162594b830f38", "thumbnail_srcset": "https://si.imgix.net/cadf7d5b/uploads/origins/3f268e75-f4eb-4b8b-a283-14bb08194985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f891d43c7da99c5e31c162594b830f38, https://si.imgix.net/cadf7d5b/uploads/origins/3f268e75-f4eb-4b8b-a283-14bb08194985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0241b857968c77f5986fece7f412cbc 2x, https://si.imgix.net/cadf7d5b/uploads/origins/3f268e75-f4eb-4b8b-a283-14bb08194985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5bd862da549a1bae7996074bc31616c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nこの作品( https://skeb.jp/@chome1/works/162 )の続編をお願いしたいです！今回は、シンフォギアGXのヴァネッサ・ディオダティ( https://symphogear.fandom.com/wiki/Vanessa_Diodati )が修理中です。インターフェイスのおかげで、彼女はまだ感情表現が可能で、捕獲者たちが彼女を正常に戻しているにもかかわらず、侮辱しているはずです。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/178", "thumbnail_src": "https://si.imgix.net/0479ad0f/uploads/origins/93a746a0-0776-444a-b5c4-1e64419a5ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558e2759665efa0da01891d35ab25709", "thumbnail_srcset": "https://si.imgix.net/0479ad0f/uploads/origins/93a746a0-0776-444a-b5c4-1e64419a5ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558e2759665efa0da01891d35ab25709, https://si.imgix.net/0479ad0f/uploads/origins/93a746a0-0776-444a-b5c4-1e64419a5ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95325e5626ac1c10f702ec383a625c8d 2x, https://si.imgix.net/0479ad0f/uploads/origins/93a746a0-0776-444a-b5c4-1e64419a5ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4b844bb9fc33a24eb593e1d56c9fe28 3x", "genre": "art", "nsfw": true, "body": "おはようございます。\n\nうちの子のジホ(アンドロイドです)のイラストをリクエストしてほしいです。\n\nシチュエーションは、寝室でベッドの上で男とジホがヤっていることです。\n\nところでジホの両腕は引き裂かれてベッドの上に転がっています。\n\n左腕はほぼなくて、肩のパーツだけが残っていて、人工皮膚も肩まで裂けて肩のパーツと人工筋肉がそのまま見えます。\n\n右腕は上腕から引き裂かれて部品が突き出ています。\n\nジホの体位は騎乗位で、腰をまっすぐ伸ばしています。服装はランジェリーをまだ一部着ているのですが、ブラの左肩ひもがずり落ちて左胸がそのまま見えます。パンツ、ガーターベルト、ストッキングは着たままずらし挿入しています。\n\nジホの表情は片目を閉じるくらい多く感じていて、口は我慢しようと片唇をぎゅっと閉じています。\n\n時点は縦に長く通常の1人称の時点で少し高くしてそこがよく見えて、後にちらかった両腕がよく見えるようにお願いします。\n\nhttps://www.pixiv.net/en/artworks/121680747 ジホの設定はここを参考してください。https://twitter.com/sf_dsb1_0671/media ここも参考したらよろしいです。\n\nhttps://twitter.com/sf_dsb1_0671/status/1837152610173997548/photo/1\nhttps://twitter.com/sf_dsb1_0671/status/1833882680477548552/photo/1\nhttps://twitter.com/sf_dsb1_0671/status/1829535793184182562/photo/3\nhttps://twitter.com/sf_dsb1_0671/status/1829394762912456979/photo/1\n\nランジェリーのデザインは上のアドレスを参考してください。\n\nご注文はおおいですのですみません。何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@chome1/works/177", "thumbnail_src": "https://si.imgix.net/6bf6cb16/uploads/origins/161bcb6f-d256-44e5-9ca7-376a7fc2f586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b921a1f7edc7f03c5ff1bac8de3daa42", "thumbnail_srcset": "https://si.imgix.net/6bf6cb16/uploads/origins/161bcb6f-d256-44e5-9ca7-376a7fc2f586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b921a1f7edc7f03c5ff1bac8de3daa42, https://si.imgix.net/6bf6cb16/uploads/origins/161bcb6f-d256-44e5-9ca7-376a7fc2f586?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e505bbd91f787fd3fb323a7cf9dfa21 2x, https://si.imgix.net/6bf6cb16/uploads/origins/161bcb6f-d256-44e5-9ca7-376a7fc2f586?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bd315410ae02f8c8910f3bdd74bfdb0 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n前回はリクエストお受けいただきありがとうございます。\n\n今回についてもモノクロで良いので漫画の制作をお願いできますでしょうか？\n\n怪盗ガジェット（アズマ・サチ）\nhttps://twitter.com/TOKYOTOMATOco/status/1738929344561725813\n２～3枚目の女の子\n執刀する女は下記のyoutubeのイラストを参照いただけますとありがたいです。\n\nお願いしたいシーン\nhttp://gadjet.cutegirl.jp/gadjet/gadjet01/gadjet02.htm\nhttps://www.youtube.com/watch?v=tWPrl16Kv4k&embeds_referring_euri=http%3A%2F%2Fgadjet.cutegirl.jp%2F&source_ve_path=MTc4NDI0\n①改造用のベッドに寝かされる改造前\n②改造手術中\n③改造後に目が覚めて絶望するシーン\n\n恐れ入りますがよろしくお願いします。", "created_at": "", "completed_at": ""}]}