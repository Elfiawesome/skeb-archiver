le.com/drive/folders/1VXmAUiV2H6TVnL_9IHrFPbcyP05FeWi_?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yuusa_RL/works/16", "thumbnail_src": "https://si.imgix.net/f1ad7718/uploads/origins/c4208722-c60f-4e1a-aa55-213e72000ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0efcf4e9246a09e5bd6d1736341d606e", "thumbnail_srcset": "https://si.imgix.net/f1ad7718/uploads/origins/c4208722-c60f-4e1a-aa55-213e72000ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0efcf4e9246a09e5bd6d1736341d606e, https://si.imgix.net/f1ad7718/uploads/origins/c4208722-c60f-4e1a-aa55-213e72000ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4547acd37409de2a552544ff70fd2d3f 2x, https://si.imgix.net/f1ad7718/uploads/origins/c4208722-c60f-4e1a-aa55-213e72000ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce05d1dd160d76aefa0686fb041e5920 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuusa_RL/works/15", "thumbnail_src": "https://si.imgix.net/51278c7d/uploads/origins/4b65988c-6980-4bf9-9bfc-ea4d2527ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d59577ebc688ef5d58b07ff821f9d48", "thumbnail_srcset": "https://si.imgix.net/51278c7d/uploads/origins/4b65988c-6980-4bf9-9bfc-ea4d2527ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d59577ebc688ef5d58b07ff821f9d48, https://si.imgix.net/51278c7d/uploads/origins/4b65988c-6980-4bf9-9bfc-ea4d2527ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi