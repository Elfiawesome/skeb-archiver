a-20fd79fe7d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3418d3dc80bcc2777d221658179e5c36", "thumbnail_srcset": "https://si.imgix.net/c1377e25/uploads/origins/34b1a7d5-e90a-47f1-9e4a-20fd79fe7d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3418d3dc80bcc2777d221658179e5c36, https://si.imgix.net/c1377e25/uploads/origins/34b1a7d5-e90a-47f1-9e4a-20fd79fe7d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c152ae01e4bfa72aa2c0b2f1c75987bf 2x, https://si.imgix.net/c1377e25/uploads/origins/34b1a7d5-e90a-47f1-9e4a-20fd79fe7d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02f5c5049ab7335d3ef39285f0388c01 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mikezo2019/works/117", "thumbnail_src": "https://si.imgix.net/53e8dd3f/uploads/origins/0c958b3d-3e9b-49ef-b71a-0e27a8bda4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c05f6f630992c2f5a0933b7c445a475c", "thumbnail_srcset": "https://si.imgix.net/53e8dd3f/uploads/origins/0c958b3d-3e9b-49ef-b71a-0e27a8bda4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c05f6f630992c2f5a0933b7c445a475c, https://si.imgix.net/53e8dd3f/uploads/origins/0c958b3d-3e9b-49ef-b71a-0e27a8bda4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80190af076f8e6051fb2cca971ee52fd 2x, https://si.imgix.net/53e8dd3f/uploads/origins/0c958b3d-3e9b-49ef-b71a-0e27a8bda4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f9b1bd27f3facc952414333c7da05a4 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n形式はモノクロ漫画でページ数はお任せします。\n\n登場人物\n出番は少ないのですが、漫画『レジェンド』2巻の7〜10話に登場するセリルという筋肉質な女冒険者\nhttps://ibb.co/album/R4MH1q\n\n内容\nセリルが人類敗北物語の様にフタナリ女怪人に犯されて怪人化（フタナリでゴリラがモデル）した後、怪人化したセリルが女性を襲ってフタナリ怪人化させ、怪人化した女性のペニスをフェラや騎乗位等で死ぬまで連続搾精するというのをお願いします。\n\n・セリルを犯す女怪人とセリルに犯されて怪人化する女性は三毛蔵様のオリジナルでお願いします。\n\n・全員胸は張りがあり、ペニスと乳輪と乳首は大きめで使い込んでいる様な暗い色。\n\n・セリルに犯されている女性は人間時は黒髪、巨乳、鷲鼻で性格が悪そうな悪人顔で、怪人態は筋肉質で怪物感強めのザコっぽい感じ。\n\n・セリルの怪人の姿はゴリラがモデルで体毛は少なめ、又は無しで少なくとも胸、腋、腹筋、陰部には毛がなく、元々筋肉質だったのが怪人化する事によって海外の女性ボディービルダーの様な肩幅が広く更に筋肉質な姿になる。\n\n・もし可能なら怪人姿を色付きで見たいのでカラーページを入れて貰いたいです。\n\n以上の内容でどうかお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mikezo2019/works/116", "thumbnail_src": "https://si.imgix.net/7fb60f9e/uploads/origins/aea80521-4140-4fd0-9a8e-4fa3e72dc92a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fdd04c388ac22c69ee8fcf306fe01c8", "thumbnail_srcset": "https://si.imgix.net/7fb60f9e/uploads/origins/aea80521-4140-4fd0-9a8e-4fa3e72dc92a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fdd04c388ac22c69ee8fcf306fe01c8, https://si.imgix.net/7fb60f9e/uploads/origins/aea80521-4140-4fd0-9a8e-4fa3e72dc92a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cad4bc4cb4f6af34c72e036ceac893f 2x, https://si.imgix.net/7fb60f9e/uploads/origins/aea80521-4140-4fd0-9a8e-4fa3e72dc92a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0d440f902a58a19c0a2f59ca4bcc1bd 3x", "genre": "art", "nsfw": true, "body": "以前依頼させていただいたシリーズでDOAのほのかが特に可愛く身体も柔らかそうな表現でお気に入りなので、ほのかをクローズアップした漫画を依頼したいです。\n宗一君のキャラクターは台詞回しを適当に入れていますが先生の原作に寄せて下さい。\n\nキャラ：\n神のチンコの宗一君\nDOAのほのか\n\n形式：\nモノクロ漫画形式　９P\n\n概要\n神のチンコの宗一君が主人公でDOAの美女達を肉奴隷にしていく話。\n以前の依頼にて神のチンコの力でリゾート地の侵略を行い美女達を全員肉奴隷にしてハーレムを築くところまで描写して頂いておりますので、今回は侵略開始し始めた状況で、ほのかを自分専用の肉奴隷に堕とす所の概要。\n宗一もほのかは特にお気に入りのようなので、性格も良くおっぱいも大きいほのかは身体的には酷いやり方はしない。ほのかには宗一の事を運命の相手と認識させて、愛情から自発的に肉奴隷にしてくださいと言わせるように調教する。ほのかに肉奴隷宣言を言わせてから、神のチンコの膣内射精を放ちほのかの愛情と忠誠の両方を手に入れようとする。\n\n流れ：\n１～３\n宗一はほのかに２つの催眠効果（宗一が運命の相手。宗一の言葉に疑いをもてない）を与える。催眠されたほのかは初めて会った宗一の事を好きになった自分の気持ちに戸惑っている。宗一が俺様に一目惚れしたのかもしれないなと返す。ほのかが宗一を好きかどうかの確認には痴漢されれば分かる。痴漢されて気持ち良いならお前は俺様の事が好きなのだと暗示。宗一の言葉に疑問を持てないほのかが身体をエッチに触られる。更にお前のように可愛くておっぱいのでかい女はもう少しエッチな水着（https://skeb.jp/@mikezo2019/works/52　にあるマイクロ紐ビキニ）を着るべきだ。俺様がお前にふさわしい水着を選んでやる。買いに行こうと誘う。\n\nエッチな水着に着替えて恥ずかしがるほのか。高い水着を買ってもらって申し訳ないです。と言うが。宗一君は気にせず受け取れと言う。エロ水着を着て痴漢されて気持ち良ければお前は間違いなく俺様に一目惚れしているのだと言われ。ほのかは宗一の事を好きだと思い込む。\n\nほのかは宗一を最初に見た時に嫌悪感を向けなかったので優しく扱ってやると言い。ほのかを押し倒す。かけられていたのが弱催眠のためまんこにちんぽを突っ込んでのセックスは本能的にいけない事だと弱弱しく拒絶しようとするが、宗一は抵抗を許さない。お前には俺様の事を心底愛させてやるぞと言ってベロチュー。唾液を流し込まれるだけで処女のおまんこが濡れるほのか。宗一を運命の相手と認めて身体を委ねる。\n\n４～６　\n処女だったほのかに正常位、立ちバック、背面座位等、快感重視のセックス指導。丸一日使ってたっぷりと女の悦びを教え込んでいき、ほのかの心に宗一への愛情をたっぷり植え付ける。ほのかは宗一の事を好きだと言い、更に宗一のものになりたいと口にする。\n\n７～９\n宗一はほのかの愛情を隷属にまで誘導し、ほのかから肉奴隷にしてくださいという言葉を引き出そうとする。最後はおまんこに射精をおねだりさせ神のチンコの精液を子宮に流し込んで完堕ちしかかっているほのかに更に強催眠をして愛情と忠誠の両方を抱かせて調教完了。", "created_at": "", "completed_at": ""}]}