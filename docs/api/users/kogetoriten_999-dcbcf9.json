a38f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=633ba8d2534fd6b479bb65d9d30a0da7 2x, https://si.imgix.net/9384e886/uploads/origins/fcd141b9-bf9a-4f76-bf41-b57460a38f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0195a61b9e828a0bba46cbd4acda025d 3x", "genre": "art", "nsfw": false, "body": "プラテン先生、こんにちは！先生のページを見つけ、素晴らしいイラストを拝見しました！\n\n友人のキャラクター、チャ・ウォンオクのイラストをお願いしたいです！ウォンオクは身長181cmで、ちょっと猫背気味です。かなり病弱で色白です。一見普通のクールな男だが、どこか不気味なオーラを持っている。普段は穏やかで無表情。下向きのまつげ、顔のほくろ、ひび割れた唇にご注目！特にウォンオクは呪いによって不運に見舞われているため、彼の周りで事件が頻発する。ポーズや構図はお任せしますが、参考のためにフォルダを用意しました！^^\n\n参考：https://drive.google.com/drive/folders/1Ykz3wDGWzT6V5nGkBaOCEAXb062NYZpl?usp=sharing\n\nいつもお忙しい中、本当にありがとうございます💕💕 今日も素敵な1日をお過ごしください\n\nhttps://drive.google.com/drive/folders/1lbohFg_kQ86bwaE7sF7WqXcnfepFzYYv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kogetoriten_999/works/5", "thumbnail_src": "https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b796664c0c6a4457d445783ea10885b4", "thumbnail_srcset": "https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b796664c0c6a4457d445783ea10885b4, https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c6e8a6331625e8d83629ea656583685 2x, https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0753ae6d92e6dbf93f565238a85256bf 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のOCのリューのお願いをしたかったんだ。\n\nリューはファンタジー世界の平和で豊かな王国の皇太子です。彼はとても思いやりがあり、勤勉です。彼の黒い制服を描いてほしいです。マントのピンはポテンティラの花とセージの葉です。\n\n彼の矢の羽は、3枚目の写真の羽と同じ色にしてください。幸運の羽であり、彼が大切にしている贈り物です。\n\nhttps://imgur.com/a/vXPaUfp\n\nご配慮ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@kogetoriten_999/works/4", "thumbnail_src": "https://si.imgix.net/ae1d1bca/uploads/origins/cefd0224-0b3e-4d89-ba52-a6823222cdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96e2e82d867456d645181a46c394338", "thumbnail_srcset": "https://si.imgix.net/ae1d1bca/uploads/origins/cefd0224-0b3e-4d89-ba52-a6823222cdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96e2e82d867456d645181a46c394338, https://si.imgix.net/ae1d1bca/uploads/origins/cefd0224-0b3e-4d89-ba52-a6823222cdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8166ff7bc6e41dd14883608efb2dacd5 2x, https://si.imgix.net/ae1d1bca/uploads/origins/cefd0224-0b3e-4d89-ba52-a6823222cdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23a30c58b98da2464afd14f91c823ffd 3x", "genre": "art", "nsfw": false, "body": "はじめまして！ガンダムのイラストが大好きです。私のOCも描いてくれたら嬉しいです！\n\nジュンヤ（178cm、22歳）\n外向的で社交的だが、仕事は真面目。ちょっと短気で照れ屋。ファンタジーSFの世界の出身で、軍の兵士。ある王国から追放された王子。\n\n構図、ポーズ、表情は自由ですので、自由に描いてください。コスチュームも複数ありますので、お好きなものを選んでいただいても構いませんし、全く違うものを描いていただいても構いません。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1g0mgPjaO2Ch1EeP2qvEBnveUvmvDfQaf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kogetoriten_999/works/3", "thumbnail_src": "https://si.imgix.net/e6773db3/uploads/origins/496f318f-dd6b-4b2b-ad07-64a44fc957ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3ec6296b357fa949d743d4221aa1fc3", "thumbnail_srcset": "https://si.imgix.net/e6773db3/uploads/origins/496f318f-dd6b-4b2b-ad07-64a44fc957ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3ec6296b357fa949d743d4221aa1fc3, https://si.imgix.net/e6773db3/uploads/origins/496f318f-dd6b-4b2b-ad07-64a44fc957ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abe60c30ef819037f4f804de62dec87c 2x, https://si.imgix.net/e6773db3/uploads/origins/496f318f-dd6b-4b2b-ad07-64a44fc957ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=175cf41ecb7be3a065dea843cead4e11 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの作風がとても好きです！  私の2人のオリジナルキャラクターを描いてほしいです。\n\n-黒い肌とウェーブのかかった髪のキャラクターは178cm。科学者のアシスタントで、上司の日常生活を助けている。  とても陽気でのんびりしているが、心配性。\n\n-乱れた黒髪とメガネのキャラクターは148cm。\n薬と手術で助手の命を救ったマッドサイエンティスト。頭脳明晰だが変わり者。実験が雑になることもあるが、いつも助手を生かしている。\n\n二人の関係は普通ではない。思いつくままに描いてください！ありがとうございました。\n\n使用方法\n-印刷物、物理的メディア\n-今後のコミッションアートの参考\n\n可能であれば高解像度のPSDデータをお送りください。\n\nhttps://drive.google.com/drive/folders/18yzbteRavKmZrQjBEdQVFnMwD2TTYcWl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kogetoriten_999/works/2", "thumbnail_src": "https://si.imgix.net/cdcf482a/uploads/origins/5fe702c5-10b7-463e-917b-022e2c238744?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26fc59cd182ab61cfd1d4e91f5ae26fe", "thumbnail_srcset": "https://si.imgix.net/cdcf482a/uploads/origins/5fe702c5-10b7-463e-917b-022e2c238744?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26fc59cd182ab61cfd1d4e91f5ae26fe, https://si.imgix.net/cdcf482a/uploads/origins/5fe702c5-10b7-463e-917b-022e2c238744?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f1ebd2f1fbd19a51059e369ec89e669 2x, https://si.imgix.net/cdcf482a/uploads/origins/5fe702c5-10b7-463e-917b-022e2c238744?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9636984357ee5289493075fdc67fbb41 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のボーイフレンドのOCのアートワークをお願いしたいです。あなたのアートスタイルなら、彼はとても素敵に見えると思います！\n\nhttps://drive.google.com/drive/folders/1-zv0JGcedToEDjioLaPiHuZpjPSoaFQH?usp=drive_link\n\n彼は16-17歳の士官学校の学生で、RPGの主人公のような感じを目指しています。\n彼はとてもいい人で、いつも人を助けようとしています。だから、彼の表情はあまり激しくないほうがいい。ポーズや構図はあなた次第です！\nリンク先に武器のリファレンスがありますが、必ずしも入れる必要はありません。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-zv0JGcedToEDjioLaPiHuZpjPSoaFQH?usp=drive_link", "created_at": "",