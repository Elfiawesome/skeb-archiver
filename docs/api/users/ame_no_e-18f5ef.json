6-97d4-348d18ac7471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c0f569a43f874125d355fd3707e2ae, https://si.imgix.net/dd7b671e/uploads/origins/2c6c18f0-3368-48f6-97d4-348d18ac7471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e438ffb3ab8f91f08dc29379056bed9a 2x, https://si.imgix.net/dd7b671e/uploads/origins/2c6c18f0-3368-48f6-97d4-348d18ac7471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7471a0e383b64220e0c8fe49275bacb4 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n飴野さんの温かみのあるイラストに惹かれまして、よろしければ私を描いて頂きたくご連絡いたしました。\n\n溢れんばかりのミモザのお花を両手でぎゅっと抱えている私を描いていただけないでしょうか？\n難しければ、お好きなように描いていただけたら嬉しいです＊\n\n使用用途は配信のサムネイルやTwiter等SNSです。\n画像のサイズ等もお任せいたします。\n可能でしたら人のみの透過Verをいただけたら嬉しいです＊\n\nお手数ですが参考資料はURLをご確認ください。\nどうかよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WX6Nr7Pvc9mjgnvu-qGuVKi97rJMo9Ip?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ame_no_e/works/1", "thumbnail_src": "https://si.imgix.net/68a5323a/uploads/origins/0d3f1217-494f-41ea-93e4-645ea3e6bca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ad2cb46fc7416ad8eb5b7567dd3c35", "thumbnail_srcset": "https://si.imgix.net/68a5323a/uploads/origins/0d3f1217-494f-41ea-93e4-645ea3e6bca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ad2cb46fc7416ad8eb5b7567dd3c35, https://si.imgix.net/68a5323a/uploads/origins/0d3f1217-494f-41ea-93e4-645ea3e6bca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de9cf689ea35b3c0a8b69bf7d33e05a4 2x, https://si.imgix.net/68a5323a/uploads/origins/0d3f1217-494f-41ea-93e4-645ea3e6bca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a897d9751205fe1779107f24c0bb36d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVtuberを描いていただけたら嬉しいです。彼女はフクロウです。フィギアやガレージキットの絵を描いています。ポーズや服装はあなた次第です。絵筆やエアブラシ、小さなフィギュア、またはその組み合わせを持っているのが希望です。\n顔や服に絵の具が飛び散っているような感じにしてほしいです。\n\nht