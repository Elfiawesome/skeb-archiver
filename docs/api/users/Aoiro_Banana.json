%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add390c1331f4da978b8f61d55cf3ceb", "thumbnail_srcset": "https://si.imgix.net/bf153dd7/uploads/origins/a6666243-bade-4467-9272-4c4932a8cd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add390c1331f4da978b8f61d55cf3ceb, https://si.imgix.net/bf153dd7/uploads/origins/a6666243-bade-4467-9272-4c4932a8cd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=778213a030e2fa8e33f92307329d9916 2x, https://si.imgix.net/bf153dd7/uploads/origins/a6666243-bade-4467-9272-4c4932a8cd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3eb296f176e4dc93e51d44fce68fe434 3x", "genre": "art", "nsfw": true, "body": "初めまして、ふじもりと申します。\nいつもfanbox楽しく拝見させていただいております。\n新刊製作の方、お疲れ様でした。BBちゃん本楽しみにしてます！\n\n依頼の内容ですが、「Fate/Grand ordef」から「水着アナスタシア(第3/最終再臨)」\nシチュエーションは、\n「エロ蹲踞でフェラ&全身ぶっかけ」にてお願いします。\n以前描かれていらっしゃった水着アナ、めちゃめちゃエロ可愛かったのでまた見てみたく！\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/25", "thumbnail_src": "https://si.imgix.net/8252d3a6/uploads/origins/0566cc9c-eb16-4b51-ab9a-b63311ccf84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418228c168739c56155bfbcc7dfb6985", "thumbnail_srcset": "https://si.imgix.net/8252d3a6/uploads/origins/0566cc9c-eb16-4b51-ab9a-b63311ccf84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418228c168739c56155bfbcc7dfb6985, https://si.imgix.net/8252d3a6/uploads/origins/0566cc9c-eb16-4b51-ab9a-b63311ccf84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b20a05c39fee5e1661a05331afcc0aa 2x, https://si.imgix.net/8252d3a6/uploads/origins/0566cc9c-eb16-4b51-ab9a-b63311ccf84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb9300273e0a9e0b8fb5f8cf5d4e6e72 3x", "genre": "comic", "nsfw": true, "body": "青ばなな先生はじめまして、いつも素晴らしいイラストをありがとうございます（夏コミの新刊も今から楽しみです）\n普段描かれていない作品なので大変恐縮なのですが、女神転生シリーズの魔人アリスで衣装は全裸で、こちらにお尻を向けて誘惑するようなイラストをお願い致します。\n\nhttps://drive.google.com/drive/folders/1qQZQYTvWm-wQCKNPszuoiupRnxE5zNA2", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/24", "thumbnail_src": "https://si.imgix.net/33e85e1d/uploads/origins/1f3dc2f4-15f0-4027-b4e5-e6e967e99718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50af6bb5958588a4b39cf8f694540c1b", "thumbnail_srcset": "https://si.imgix.net/33e85e1d/uploads/origins/1f3dc2f4-15f0-4027-b4e5-e6e967e99718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50af6bb5958588a4b39cf8f694540c1b, https://si.imgix.net/33e85e1d/uploads/origins/1f3dc2f4-15f0-4027-b4e5-e6e967e99718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aacb7c9db6c89ed591254f2e4d9821f6 2x, https://si.imgix.net/33e85e1d/uploads/origins/1f3dc2f4-15f0-4027-b4e5-e6e967e99718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a18414ad9e27590e33148ac51b5139a 3x", "genre": "art", "nsfw": true, "body": "以前、夏コミを控えられてました、お忙しい時期にリクエストを送ってしまい、申し訳ございませんでした。\n\n青ばなな先生の絵柄で以下のシチュエーションをご再考いただきたく、もう一度だけ、リクエストをお送りさせていただきます。\n\n『FGOの巴御前がVR機器を使って、えっちな映像を見ながらのオナニーに夢中になっているイラストをお願いします。\n\n体勢は、\n布団の上で全裸になったまま仰向けになっている。肌が外気に晒されているため、陰核や乳首は既にビンビンになって剥き出しになっていると幸いです。\n先生の描かれるおへそが好きですので、おへそが見える構図でお願いします。\n\n仕草としては、\n片方の手で指マンをしており、愛液をいっぱい出しながら激しく弄り、もう片方の手は自分のおっぱいを弄っているでお願いします。乳首をつねってるものなのか、乳房を揉んでいるものなのかは先生の描きやすい形にお任せします。\n\n巴は、VRの画面に夢中で、周りが見えてないため、遠慮なく下品に蕩けており、盛大に喘いでいる感じでお願いします。\nまた、VRゴーグルには、ハートマークのアイコンが資料URLの様な感じで浮かんでる描写でお願いします。\n\nもし可能であれば、体が疼いて母乳を吹き出したり、盛大に潮やおしっこを吹きながら絶頂してる差分描写も出来たらお願いします。』\n\n改めまして、先生的に難しいと感じましたら、描写を変更したり、キャンセルしていただいても大丈夫です。\nもし、差し支えがなければ、よろしくお願いします。\n\nhttps://static.atlasacademy.io/JP/CharaFigure/1098198100/1098198100_merged.png", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/23", "thumbnail_src": "https://si.imgix.net/6186e901/uploads/origins/94f1d970-beb8-4d70-8531-3790c7270f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d0e9aa3ffb9747bdbdd3759a9648bd", "thumbnail_srcset": "https://si.imgix.net/6186e901/uploads/origins/94f1d970-beb8-4d70-8531-3790c7270f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d0e9aa3ffb9747bdbdd3759a9648bd, https://si.imgix.net/6186e901/uploads/origins/94f1d970-beb8-4d70-8531-3790c7270f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b66dd021fc401d90d4c078584487b93 2x, https://si.imgix.net/6186e901/uploads/origins/94f1d970-beb8-4d70-8531-3790c7270f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c965d8a24fbf0c567735fc29d709a83 3x", "genre": "art", "nsfw": true, "body": "夜の公園で露出しながら輪姦されるビッチな巨乳の初音ミクを描いていただきたいです。内容は両手でちんこをしごきながら、ガニ股騎乗をして最後にアヘ顔を晒しながらの潮吹き、中出し、ぶっかけでといった流れでお願いしたいです。差分としてスク水の日焼け後を書いていただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/22", "thumbnail_src": "https://si.imgix.net/807abd04/uploads/origins/8ab12ac9-42b6-4655-a931-c6ac7b838b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f68bf59fff884ad39f0822db772c17d3", "thumbnail_srcset": "https://si.imgix.net/807abd04/uploads/origins/8ab12ac9-42b6-4655-a931-c6ac7b838b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f68bf59fff884ad39f0822db772c17d3, https://si.imgix.net/807abd04/uploads/origins/8ab12ac9-42b6-4655-a931-c6ac7b838b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a02889c94b863c72d5e9842d7719815e 2x, https://si.imgix.net/807abd04/uploads/origins/8ab12ac9-42b6-4655-a931-c6ac7b838b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8bb797bca4d0e59110da624deda1171 3x", "genre": "art", "nsfw": true, "body": "青ばななさんこんにちは、いつもFateシリーズの素敵な絵を描いてくださってありがとうございます。もしよければぜひ酒呑童子をお願いします。\n\n設定：\n足フェチのマスターはいつも酒呑の足を見ているので、酒呑は逆にマスターを押し倒して、マスターに足をみせ、足コキをしてくれて、最後にたっぷり彼女の足でイった後、酒呑が今後定期的に足でマスターを満足させてあげると色気な顔をした\n\n視点は主観視点で、残りは全部青ばななさんにお任せします。\n青ばななさんが描いた酒呑ちゃんが本当に大好きで、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/21", "thumbnail_src": "https://si.imgix.net/e6568de1/uploads/origins/9b1b6bee-8cb3-40a2-85e0-7c3cff61ebf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8d900923a815740775475ff6aaa2fd", "thumbnail_srcset": "https://si.imgix.net/e6568de1/uploads/origins/9b1b6bee-8cb3-40a2-85e0-7c3cff61ebf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8d900923a815740775475ff6aaa2fd, https://si.imgix.net/e6568de1/uploads/origins/9b1b6bee-8cb3-40a2-85e0-7c3cff61ebf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41b3a92294c63c118f3ae27b19afa9ac 2x, https://si.imgix.net/e6568de1/uploads/origins/9b1b6bee-8cb3-40a2-85e0-7c3cff61ebf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2333e05131a2cc17f5145d7ee24e8801 3x", "genre": "art", "nsfw": true, "body": "以前依頼した闇のコヤンスカヤHがとても素敵だったので、光のコヤンスカヤのイラストもお願いしたいです。\n\n光のコヤンスカヤ\n衣装：第1段階 (先生が描きたいのであれば、第1段階の代わりに第3段階を描くこともできます）。\nコヤンのライダースーツの前はチャックが大きく開いている (大きなおっぱいとエロい体がこぼれるように）。\n竿役：マスター（ぐだ男）\nなお、男性（マスター）の描写は申し訳程度で構いません。無消費の令呪が右手の甲に見える。\n\n体位: 背面座位 (全身を見渡し、結合部の見やすさを重視した姿勢)。\nシチュ:\nコヤンスカヤとマスターは、最近のボックスガチャ形式のイベントでの成功を祝して、子作りSEXを行いました。こんな豪華なご褒美がもらえるのは、愛するマスターのためにあるNFFサービスの特別な特典ですから、これからも末永くよろしくお願いします。\n\nそれ以外の詳細は、先生にお任せします。前回のリクエストのコヤンスカヤの描写が素晴らしかったので、今回も好みに合わせて自由に描いてください。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/20", "thumbnail_src": "https://si.imgix.net/74e7d340/uploads/origins/c7890030-c782-44e8-9f2a-a15c15f7e9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68684d65d134271f89a837bc2698e89c", "thumbnail_srcset": "https://si.imgix.net/74e7d340/uploads/origins/c7890030-c782-44e8-9f2a-a15c15f7e9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68684d65d134271f89a837bc2698e89c, https://si.imgix.net/74e7d340/uploads/origins/c7890030-c782-44e8-9f2a-a15c15f7e9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24670ff859e0f09851111196021fc384 2x, https://si.imgix.net/74e7d340/uploads/origins/c7890030-c782-44e8-9f2a-a15c15f7e9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18a8ae6959cbe6282abf4f3a497f0d09 3x", "genre": "art", "nsfw": true, "body": "水着イオリのイチャラブエッチが見たいです。\n\nシチュエーションはお任せします。\n\n体位\nバックでお願いします。\n恥ずかしくて顔を背けながらもお尻を突き出してせがむような格好が見たいです。\n\n欲しい内容\n先生への罵倒\n罵倒しつつも先生とキスしたくて恥ずかしさを押し殺しながらせがむイオリ\n\nもし可能であればキスされるとわかった時に目を瞑って受け入れるイオリの差分またはカットインを描いていただけると嬉しいです。\n※無くても構いません。\n\nその他全てお任せします。\nお任せが多く恐縮ですがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/19", "thumbnail_src": "https://si.imgix.net/36f1f536/uploads/origins/6212ce2f-3d66-4e77-ab3e-655a324c63e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f364d51545b05a7f3d6b1ab55c219929", "thumbnail_srcset": "https://si.imgix.net/36f1f536/uploads/origins/6212ce2f-3d66-4e77-ab3e-655a324c63e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f364d51545b05a7f3d6b1ab55c219929, https://si.imgix.net/36f1f536/uploads/origins/6212ce2f-3d66-4e77-ab3e-655a324c63e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e1dd1488245634cbb62743a5151efee 2x, https://si.imgix.net/36f1f536/uploads/origins/6212ce2f-3d66-4e77-ab3e-655a324c63e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=475e096dcfb66c33ddb7a1c211d11006 3x", "genre": "art", "nsfw": true, "body": "依頼失礼します。\nFate/GrandOrderのマタ・ハリを描いて欲しいです！\n\nシチュエーションは両手を繋ぎながらの騎乗位で、\nマスターを優しく童貞卒業させてあげてる所を主観視点でお願いします！\n\nもし差分を描いて頂けるのであれば、\n最初はある程度余裕のある表情で\n「大丈夫よ、私も気持ち良いわ♡」「上手上手♡」\nみたいな感じに甘やかすけれど、\n段々と余裕がなくなっていき一緒にイッてしまう、\nといったストーリーで描いて頂けるとありがたいです。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Aoiro_Banana/works/18", "thumbnail_src": "https://si.imgix.net/54ecc457/uploads/origins/496294aa-931b-47a4-8778-50b831f186d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ad6dd1631f01ad184a54f0f8d5cfbf", "thumbnail_srcset": "https://si.imgix.net/54ecc457/uploads/origins/496294aa-931b-47a4-8778-50b831f186d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ad6dd1631f01ad184a54f0f8d5cfbf, https://si.imgix.net/54ecc457/uploads/origins/496294aa-931b-47a4-8778-50b831f186d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82a61e0122b043a25dd515c8b5c9d8bb 2x, https://si.imgix.net/54ecc457/uploads/origins/496294aa-931b-47a4-8778-50b831f186d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=156d2b354730a34ce9b61ffbd0f10ba9 3x", "genre": "art", "nsfw": true, "body": "またまた先生、こんにちは。\nカーリン・ケイソンのイラストを新たにお願いしたいです。今回は【狐将】のコスチュームで。\n参考イラストのように寝そべって、お尻を振って艦長を誘惑しています。アナルセックスを期待して、尻尾を少し振っています。\n艦長はまず、指と唾液でカーリンのアナルを潤滑にします。\nそして、ペニスを挿入すると、カーリンは喜びます。\n艦長が射精した後、カーリンは気持ちよさそうにしていますが、まだ完全に満足しているわけではありません。\n艦長は、スターオーシャンのクレイジーな天才少女、ウェルチ・ビンヤードが作った薬を飲みます。\n艦長は力を取り戻したが、ペニスは前よりずっと大きくなってしまった。\nカーリンはその大きさに恐れおののきながらも、もっとアナルセックスをしたいと興奮を隠せない。\nカーリンもその大きさに少し苦戦しながらも、さらに楽しんでいます。今回は射精後、たっぷり満足し、かなり疲れているようです。\n\nこの度は、私のリクエストに応えていただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1aFBXyEY9sD5_hi2qwHmNHvbKZhbFMmMH", "created_at": "", "completed_at": ""}]}