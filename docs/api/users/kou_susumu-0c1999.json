8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2867d23b55cb311fc196b1eff1ea2ce, https://si.imgix.net/22c709ef/uploads/origins/8c41a79a-05dc-4f9b-a6d8-2654572d8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae283252d8459b6e115939602d56f487 2x, https://si.imgix.net/22c709ef/uploads/origins/8c41a79a-05dc-4f9b-a6d8-2654572d8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7806a7bdf6a5b5cef63f12189c0029dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。今までの作品が大好きです。私のOCを描いてください。\n\nこのポーズかそれに近い形で描いてください: https://drive.google.com/file/d/1TmzX1RGvSl3jtp5cDMVQAnIm1vSk-rIy/view?usp=sharing\n\nありがとうございます。\n\nhttps://drive.google.com/file/d/1nNYN_hhkfHMFeZ3hZiiJmURqeSaNOlLW/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kou_susumu/works/7", "thumbnail_src": "https://si.imgix.net/147bb364/uploads/origins/bdebdd85-30dd-492b-9aed-42fdf68c3dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=730704089663ae4d98d1d21e41663f61", "thumbnail_srcset": "https://si.imgix.net/147bb364/uploads/origins/bdebdd85-30dd-492b-9aed-42fdf68c3dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=730704089663ae4d98d1d21e41663f61, https://si.imgix.net/147bb364/uploads/origins/bdebdd85-30dd-492b-9aed-42fdf68c3dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ff0e7852cf9cd94169c58420660def 2x, https://si.imgix.net/147bb364/uploads/origins/bdebdd85-30dd-492b-9aed-42fdf68c3dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=daecb17722d5063ffc83affcfd8b457a 3x", "genre": "art", "nsfw": false, "body": "荒坂ススム様 初めまして、あさのと申します。\n新着順イラストでお見かけして素敵な絵柄だったためリクエスト送らせて頂きました…！\n\n◆依頼内容\nUTAU自音源ちゃんの「奇敷グルミィ」ちゃんのSNOBBISMカバーの動画サムネイルに使う1枚絵をお願いしたいです\n原曲:https://youtu.be/f5jDVFmEIVQ\nカバー:https://drive.google.com/file/d/1dm2Pl8jMDwZVBEgkxxYfrvJcVji8-bIX/view?usp=drivesdk\n本家に近い衣装(エルフ耳とギザ歯含む)を着せてあげてください。その際のアレンジ等は荒坂様の裁量にお任せします…！絵柄寄せはしなくて大丈夫です、絵柄に一目惚れしましたので…\nあとぐるぐる目が立ち絵だと白抜きですが周りの線画と同じ色で書いて下さると助かります🙏\n画像比率は16:9(横長)、それ以外は特に指定はありませんので構図、色、表情等自由に制作してくださると嬉しいです🙇‍♀️もちろんグルミィ自身の髪型等のアレンジも大歓迎です！！\n\n色々と細かくてごめんなさい…!!リクエスト承諾して頂けましたら幸いです、それでは失礼します。\n\nhttps://drive.google.com/drive/folders/1XaVF4i7DeuGrOJXANR3TxkPgjsrGLAzZ", "created_at": "", "completed_at": ""}, {"path": "/@kou_susumu/works/6", "thumbnail_src": "https://si.imgix.net/c93ae3cf/uploads/origins/f5033d71-2af9-46f1-901a-a59e504e31ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c938d91056619c746ebf76f43647bf6", "thumbnail_srcset": "https://si.imgix.net/c93ae3cf/uploads/origins/f5033d71-2af9-46f1-901a-a59e504e31ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c938d91056619c746ebf76f43647bf6, https://si.imgix.net/c93ae3cf/uploads/origins/f5033d71-2af9-46f1-901a-a59e504e31ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd637b0677951eaeab432a5d2c65b82b 2x, https://si.imgix.net/c93ae3cf/uploads/origins/f5033d71-2af9-46f1-901a-a59e504e31ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37070c7eeba26c9a93e486ecb1208db0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nツイッターで荒坂ススムさんのイラストを楽しく拝見させて頂きました。とても素晴らしい絵柄に惹かれて、もし良ければ、私と友人たちのオリジナルキャラーを描いてもよろしいか？（友人からリクエストおよび資料提供の許可をいただいております）\n\n以下、キャラクターの設定と参考画像になります！\nhttps://drive.google.com/drive/folders/1YvAVmZJyxGPQuK-H8BlCWCATuFUUl-Yj?usp=sharing\n\nもしよければ、↓このようなイラストが欲しいです！！！\nhttps://twitter.com/osyouyuudon/status/1570073591131308038\nhttps://twitter.com/osyouyuudon/status/1562696016759246849\n\n金額不足の場合は再送要請も構いません。\n何卒宜しくお願い致します> <", "created_at": "", "completed_at": ""}, {"path": "/@kou_susumu/works/5", "thumbnail_src": "https://si.imgix.net/c5ceed9c/uploads/origins/6bd2cf1c-67ec-4622-b419-732314e29f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a26a95bbd8c89808a204b139981d4cc", "thumbnail_srcset": "https://si.imgix.net/c5ceed9c/uploads/origins/6bd2cf1c-67ec-4622-b419-732314e29f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a26a95bbd8c89808a204b139981d4cc, https://si.imgix.net/c5ceed9c/uploads/origins/6bd2cf1c-67ec-4622-b419-732314e29f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbab14e49ce7f6d993fa0f80f054f8e2 2x, https://si.imgix.net/c5ceed9c/uploads/origins/6bd2cf1c-67ec-4622-b419-732314e29f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc4c18831958d65c9621ad9e4a40235c 3x", "genre": "art", "nsfw": false, "body": "先生はじめまして。\n\nhttps://skeb.jp/@kou_susumu/works/3\nこのようなイラストが欲しいです。\n暗い/ヤンデレ/サイコパスな気分は大好き。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1I8SDE91dmSoHZgMPkp0r3rbAGo8ctQ1I?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kou_susumu/works/4", "thumbnail_src": "https://si.imgix.net/98c6e9f9/uploads/origins/4b7fd363-c77f-467f-8d72-dd83ecae9f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e37e2b8bef63e42f2c73d16909564e3", "thumbnail_srcset": "https://si.imgix.net/98c6e9f9/uploads/origins/4b7fd363-c77f-467f-8d72-dd83ecae9f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e37e2b8bef63e42f2c73d16909564e3, https://si.imgix.net/98c6e9f9/uploads/origins/4b7fd363-c77f-467f-8d72-dd83ecae9f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55165820d641e3a0e26f54197f4a7e76 2x, https://si.imgix.net/98c6e9f9/uploads/origins/4b7fd363-c77f-467f-8d72-dd83ecae9f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ed3401e983626b3b471a2a6fa4b3e0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n荒坂ススムさんの絵柄がとても好きです。私のオリキャラを描いて頂きたいと思いご依頼させて頂きました。\n\n彼女の名前はジュリア·フィヨルド(Julia Fjord）、日本名で峡江樹里亜とも呼ばれる。日本高校に留学しているアメリカ人です。\n父親から家庭内暴力を受けているだが、恐怖心を隠すため元気な少女を演じている。父親の影響で自分も暴力的になったが、そんな自分を嫌悪している。あちこちに傷を負っていることが多い。\n\nポーズなどその他の詳細については、ご自由に描いてください。\nキャラの服装などは変更・アレンジしていただいて構いません。\n\n宜しければご検討よろしくお願いいたします。\n\n資料は下記URLよりご確認ください：\n\nhttps://drive.google.com/drive/folders/1K_Ye6o26X_EZ4MC2Db7Aaxg6MG2eBUN7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kou_susumu/works/3", "thumbnail_src": "https://si.imgix.net/15e2d21c/uploads/origins/49e42520-85a2-4cd2-b9de-0a2d10299859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=346e048a018831b101f8954653591b89", "thumbnail_srcset": "https://si.imgix.net/15e2d21c/uploads/origins/49e42520-85a2-4cd2-b9de-0a2d10299859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=346e048a018831b101f8954653591b89, https://si.imgix.net/15e2d21c/uploads/origins/49e42520-85a2-4cd2-b9de-0a2d10299859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64b4f1b588fc060abd36be8b9a4b6887 2x, https://si.imgix.net/15e2d21c/uploads/origins/49e42520-85a2-4cd2-b9de-0a2d10299859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86aed988ea130c2585db7b919afca896 3x", "genre": "art", "nsfw": false, "body": "『心の傷』という題材で思いついたものを自由に描いてください。\nお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kou_susumu/works/2", "thumbnail_src": "https://si.imgix.net/ba42e37e/uploads/origins/c575b5ad-9ea2-4bf6-af45-57a5034e9912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4de198749c91ed4e1faf324c509e1539", "thumbnail_srcset": "https://si.imgix.net/ba42e37e/uploads/origins/c575b5ad-9ea2-4bf6-af45-57a5034e9912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4de198749c91ed4e1faf324c509e1539, https://si.imgix.net/ba42e37e/uploads/origins/c575b5ad-9ea2-4bf6-af45-57a5034e9912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsh