d98bb9606b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f3effa9fa7528517ec23897ef900932, https://si.imgix.net/35436eaf/uploads/origins/df7c92e4-8e9b-4871-a936-0ad98bb9606b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3c0a7e12c239878393589e4143623d9 2x, https://si.imgix.net/35436eaf/uploads/origins/df7c92e4-8e9b-4871-a936-0ad98bb9606b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7729bf3b5a778ce40f8c0bad58403516 3x", "genre": "art", "nsfw": false, "body": "再送失礼します💦\n咲良お嬢様と秋君のお二方でご依頼したいです！大人の姿の方を希望します！\n\n海に遊びに来ているという設定で、お嬢様が水着の格好を、秋君がウェットスーツの格好をしているイラストをお願いしたいです！お嬢様は浮き輪もしくはビーチボールと一緒に描かれていてほしいのですが、よろしいでしょうか？\n\nちなみにウェットスーツについて参考になりそうなサイトがありましたので資料として掲載いたします。\nhttp://www.kensuits.com/des_catalog/index.html", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/10", "thumbnail_src": "https://si.imgix.net/7acb7332/uploads/origins/8b57031f-5086-4cda-ac6f-fc488e29b3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff2a06084bd6d93a15004c6ee0dc9c4a", "thumbnail_srcset": "https://si.imgix.net/7acb7332/uploads/origins/8b57031f-5086-4cda-ac6f-fc488e29b3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff2a06084bd6d93a15004c6ee0dc9c4a, https://si.imgix.net/7acb7332/uploads/origins/8b57031f-5086-4cda-ac6f-fc488e29b3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0283a216122173c7f1652715a0938c4 2x, https://si.imgix.net/7acb7332/uploads/origins/8b57031f-5086-4cda-ac6f-fc488e29b3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb289d8f3fac1ea43d198bad431bf202 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\n私のVtuberアバターのアリス・クランペットを描いていただけませんか？\n\n構図ですが、背景や小物に力を入れてるとのことで、 ①の絵柄でアフタヌーンティーパーティしてるような感じでもよろしいでしょうか？？ (無理でしたら最初にご提案頂いたものでも大丈夫です) \n\nまた、Vtuber活動で使用する許可を頂けますか？ それと、可能でしたら背景透過版もあると嬉しいです。  よろしくお願い致します。\n\nアリスの資料 https://drive.google.com/drive/folders/1FzP_J7pec8LFwEwoUJZuKj9aDPjr-r9C?usp=drive_link\n\n構図のイメージ https://drive.google.com/file/d/1ukciJXjGe1eZMxQtxY9qs7N0AKmQNVCh/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/9", "thumbnail_src": "https://si.imgix.net/3cd666ef/uploads/origins/bb93da38-8bc0-4c4b-9806-fb3d679fed17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb710a9d849c23b345924e0824639de3", "thumbnail_srcset": "https://si.imgix.net/3cd666ef/uploads/origins/bb93da38-8bc0-4c4b-9806-fb3d679fed17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb710a9d849c23b345924e0824639de3, https://si.imgix.net/3cd666ef/uploads/origins/bb93da38-8bc0-4c4b-9806-fb3d679fed17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=896efa1cdadabb9e04c324a1c9bde0f4 2x, https://si.imgix.net/3cd666ef/uploads/origins/bb93da38-8bc0-4c4b-9806-fb3d679fed17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb12837203e78e936ac8e4d134de95c9 3x", "genre": "art", "nsfw": false, "body": "さがわるう様\nSkebアピールありがとうございました！\nリクエスト内容は『不思議の国のアリス×地雷系ファッション』でお願いします。\n構図や背景等については大変恐縮ではございますが、すべてお任せでお願い致します。\n好き勝手に描いて頂いて大丈夫です、素敵なイラストを楽しみにしています！", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/8", "thumbnail_src": "https://si.imgix.net/292761ea/uploads/origins/afe3c82f-1605-4b00-8a66-4104d13a29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86896c82433a5d2abf19d4576e51619", "thumbnail_srcset": "https://si.imgix.net/292761ea/uploads/origins/afe3c82f-1605-4b00-8a66-4104d13a29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86896c82433a5d2abf19d4576e51619, https://si.imgix.net/292761ea/uploads/origins/afe3c82f-1605-4b00-8a66-4104d13a29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5678c4749873a1a01b544109ef5af76b 2x, https://si.imgix.net/292761ea/uploads/origins/afe3c82f-1605-4b00-8a66-4104d13a29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7db4711149dc8b37b1dfce91968450 3x", "genre": "art", "nsfw": false, "body": "さがわるう様にゆるゆるの絵柄で壁紙に使えるような\nイラストを描いて頂きたくリクエストさせて頂きました。\nこの金額で可能な範囲の受け方をして頂ければと思います。\n\nサイズに関してですが指定してよろしければエクスペリアを使用しておりますので\n２１：９(２５２０×１０８０？)か周りの余白を多めにとって頂けると助かります。\n\n\nあまり資料がなく申し訳ないですがリンクになります。\n資料として６人ほど載せさせて頂きました。\n(複数人かけるようでしたら代理キャラを入れてもらえると嬉しいです。)\nhttps://twitter.com/has3kage/status/1685522858586550272?s=20\nhttps://twitter.com/has3kage/status/1683503338426617857?s=20\nhttps://twitter.com/has3kage/status/1654442566316879874?s=20\nhttps://twitter.com/has3kage/status/1648214542739206144?s=20\nhttps://twitter.com/has3kage/status/1617364715004624897?s=20\nhttps://twitter.com/has3kage/status/1653717992474288129?s=20\nhttps://twitter.com/has3kage/status/1681166731153395712?s=20", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/7", "thumbnail_src": "https://si.imgix.net/5e603dd6/uploads/origins/60a8b80d-54e3-4c84-a144-0c647872aa61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93cbeff9d9df36c7abdb72cb1cb356a0", "thumbnail_srcset": "https://si.imgix.net/5e603dd6/uploads/origins/60a8b80d-54e3-4c84-a144-0c647872aa61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93cbeff9d9df36c7abdb72cb1cb356a0, https://si.imgix.net/5e603dd6/uploads/origins/60a8b80d-54e3-4c84-a144-0c647872aa61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f0ee3a29a1e45552ae8c9055bb31a8e 2x, https://si.imgix.net/5e603dd6/uploads/origins/60a8b80d-54e3-4c84-a144-0c647872aa61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3bcd92fff89ced6b877e6ec64048948 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！\nうちの子を描いて頂けるとのことで、さっそく依頼させて頂きます。\n既にご覧になって頂けているご様子なので前後してしまい恐縮ですが、彼女のデザインの具体的な資料は以下の通りとなります。\n\n今回はアピール文の①にありました、ベッドに寝転がる彼女のイラストを依頼させて頂きます。\nデザインにセンシティブな箇所がある子ですので、服の裾や膝で隠すなどの対応をお願いします。そして、設定上「フサフサ」な子ですので「ツルツル」に見える描写は避けて頂けますと幸いです。\nよろしくお願いします。\n\nhttps://twitter.com/slotter_benny/status/1682762673371615232", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/6", "thumbnail_src": "https://si.imgix.net/4889d559/uploads/origins/e98c706c-c216-428a-88b6-006ad3e165ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820f33c555dc1605ebf58fd9d77a4fc8", "thumbnail_srcset": "https://si.imgix.net/4889d559/uploads/origins/e98c706c-c216-428a-88b6-006ad3e165ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820f33c555dc1605ebf58fd9d77a4fc8, https://si.imgix.net/4889d559/uploads/origins/e98c706c-c216-428a-88b6-006ad3e165ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3052292bda04734fc9142d3004da750e 2x, https://si.imgix.net/4889d559/uploads/origins/e98c706c-c216-428a-88b6-006ad3e165ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46114709ad821f160800d5bbbb8b79f6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！女の子の絵柄に惹かれました！依頼をさせてください。\n\n☆キャラ\n推しの子　星野アイ(単体)\n\n☆服装や髪型\nアニメOPや販促PV等でよく着ている赤を基調としたアイドル衣装と髪型\n\n☆お願いしたいポイント\nさがわさんの少女漫画を全面に出しつつ若干原作の横槍メンゴ先生のエッセンスを入れて頂きたいです(^^)\n背景はこだわりませんのでキャラをバリバリ全面に出していただけたらと思います！\n\n突然のリクエストではございますがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/5", "thumbnail_src": "https://si.imgix.net/5edbd107/uploads/origins/dc837bbd-a154-4afd-aabf-c35426416e66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d555774549139f56bdfbefdd69ed19c0", "thumbnail_srcset": "https://si.imgix.net/5edbd107/uploads/origins/dc837bbd-a154-4afd-aabf-c35426416e66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d555774549139f56bdfbefdd69ed19c0, https://si.imgix.net/5edbd107/uploads/origins/dc837bbd-a154-4afd-aabf-c35426416e66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=516a57707593e8106880f122fc27a68f 2x, https://si.imgix.net/5edbd107/uploads/origins/dc837bbd-a154-4afd-aabf-c35426416e66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80f509582e22807c4f3432bc080dffcf 3x", "genre": "art", "nsfw": false, "body": "こんにちは、たてはです！\nイラストご依頼させてください。\n一番のお気に入りの服を着た咲良お嬢様が見たいです！\nご無理でなければ是非、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/4", "thumbnail_src": "https://si.imgix.net/e6927ed6/uploads/origins/dad6e9cf-f8c0-4270-87e9-6c95439e04ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1169ae0f8f8049b0814228808a59961a", "thumbnail_srcset": "https://si.imgix.net/e6927ed6/uploads/origins/dad6e9cf-f8c0-4270-87e9-6c95439e04ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1169ae0f8f8049b0814228808a59961a, https://si.imgix.net/e6927ed6/uploads/origins/dad6e9cf-f8c0-4270-87e9-6c95439e04ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b566e24af2f19b7fbb3f9d4448c8c74 2x, https://si.imgix.net/e6927ed6/uploads/origins/dad6e9cf-f8c0-4270-87e9-6c95439e04ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f07cf209ea25f10597d955574b21b5a 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\n\n「綺麗なロングヘアのデュラハンの女の子」という内容で依頼させて頂きたいと思います。\n以下詳細を記しておりますので、内容ご確認の上でご検討頂ければ幸いです。\n\n【詳細】\n・髪の長さは頭３つ分かそれ以上の長さが好ましいです。長い髪の表現のためご負担がかかると思いますが宜しくお願いします。\n\n・ヘアアレンジに関しては、ロングヘアであることが分かりにくくなるお団子やシニヨンなどといったまとめ髪は避けてください。\n　ハーフアップやポニーテール等といった髪の一部分、または髪全体をゆったりまとめたりする場合はOKです。\n　お好みで編み込みなどのアレンジを加えて頂いても構いません。\n\n・服装に関しては私服やドレスなどの女性服であれば特に指定は無いのでお好みで着せてあげてください。\n　鎧などの女の子感がない無骨な衣装はNGでお願いします。\n\n・首の表現に関しては\n　①肌色で塗る\n　②タートルネックのような首元が隠れる・襟のある服装で見えなくする\n　③アクセサリーやチョーカー等による着飾りで隠す\n　などの方法を用いてマイルドな表現をお願いします。リアルな首の断面を描くのはNGでお願いします。\n　あわせて、性的表現・猟奇的表現は避けてください。\n　また、首の断面の隠し方として「首から炎や煙が出ている」という表現はNGでお願いします。\n\n・分離した頭の扱いについて\n　頭を小脇に抱える・両手で持つ・体のポーズに合わせて頭を乗せる…など、頭の位置に関してはお好みに任せます。\n　過去に私がリクエストした作品やSkebの検索のURLを記載するので、そちらを参考にお好みで判断して構図を決めてください。\n　それ以外に「こういうのもありでは？」と思ったものであればそちらでも構いません。\n\n・可能であれば没ラフのようなものや、文章の形式でもOKなので描いて頂いた子のコンセプトのようなものや\n　こだわりポイントのようなものがあればあわせてかいて頂けると嬉しいです。\n　差分に関してはそれだけ負担になると思うので判断をお任せします。\n\n・納品はPSDファイルでの納品をお願いします。\n　差分などがある場合はPSDファイル内に入れて頂ければ幸いです。\n\n・ご不明点等があった際はお好みで描いて下さい。\n\n長文になりますが、内容は以上になります。\nご負担をおかけしますが、よろしくお願いします。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/3", "thumbnail_src": "https://si.imgix.net/1ab0662d/uploads/origins/c1458dd3-a1df-4dff-a5cf-0c1963219c36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efcbb5705743fb228bb4f368fbac1a1a", "thumbnail_srcset": "https://si.imgix.net/1ab0662d/uploads/origins/c1458dd3-a1df-4dff-a5cf-0c1963219c36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efcbb5705743fb228bb4f368fbac1a1a, https://si.imgix.net/1ab0662d/uploads/origins/c1458dd3-a1df-4dff-a5cf-0c1963219c36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6254e8f1da11ff51abf7641eb281b90 2x, https://si.imgix.net/1ab0662d/uploads/origins/c1458dd3-a1df-4dff-a5cf-0c1963219c36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5929420c2f857f7ea5f7a024316beff 3x", "genre": "art", "nsfw": false, "body": "いつも可愛い絵や漫画を拝見させていただいてます。\nもしよろしければ私のオリキャラを描いていただきたいです。\n\nゆうと君\nショタキャラ。アホ毛がついてる白髪の純真無垢な男の子。優しい人が好き。\n参考画像：https://tkdk001.tumblr.com/post/721775422565761024\n\nポーズや衣装はお任せします。\n\nもしご都合が合いましたら、何卒ご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sgwruu/works/2", "thumbnail_src": "https://si.imgix.net/778a54dd/uploads/origins/97e35122-3b47-47c4-85ba-66fdbf43118d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a939cc0e144754b7443fe5dadbef05", "thumbnail_srcset": "https://si.imgix.net/778a54dd/uploads/origins/97e35122-3b47-47c4-85ba-66fdbf43118d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a939cc0e144754b7443fe5dadbef05, https://si.imgix.ne