9-8841-c908db0dd39c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=388530754506827056273487a4e7f0f8, https://si.imgix.net/d2d3abf7/uploads/origins/7a47d3ff-697b-4f79-8841-c908db0dd39c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c52ab9a920c7175edc2bd0b1e9fcae0 2x, https://si.imgix.net/d2d3abf7/uploads/origins/7a47d3ff-697b-4f79-8841-c908db0dd39c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4ce1a680603304365d74404cea716d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/12", "thumbnail_src": "https://si.imgix.net/1fe5de99/uploads/origins/a9466b60-be00-45af-954d-25fa4268e2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc154d7eb9193601a4bcdc34542d273", "thumbnail_srcset": "https://si.imgix.net/1fe5de99/uploads/origins/a9466b60-be00-45af-954d-25fa4268e2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc154d7eb9193601a4bcdc34542d273, https://si.imgix.net/1fe5de99/uploads/origins/a9466b60-be00-45af-954d-25fa4268e2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75904c3ea559ccc3c0152d761bdc3380 2x, https://si.imgix.net/1fe5de99/uploads/origins/a9466b60-be00-45af-954d-25fa4268e2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40af60612873c8ab9d9ea111f4933455 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。アイベルというキャラクターの絵をお願いできないでしょうか https://drive.google.com/file/d/1Tb8y0jDuHgeYB-kGV9S4DBo92G8LkHH6/view?usp=drive_link\nhttps://i.imgur.com/aPvV3Te.png\n\n彼女は鏡を見ている。古い木造の中世風の家にある大きな派手な鏡です。鏡の周りにアクセサリーや家具があっても構いません。\n\n鏡に映ったキャラクターは次のように見えます： https://drive.google.com/file/d/18qQB-UCh37WEpnzj8T2kpq1bwqC-aYAn/view?usp=drive_link\nhttps://i.imgur.com/sAPU7Nd.png\n\n鏡の中のキャラクターは悲しそうな笑顔でアイベルを見ています。鏡の背景は海の夕日です。キャラクターのコスチュームやディテールは即興で自由に作っていただいて構いません。\n翻訳ミスがあったらごめんなさい！\n\n参考画像がわかりにくくてすみません。\n\nhttps://imgur.com/a/aWjdW78", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/11", "thumbnail_src": "https://si.imgix.net/df8d618e/uploads/origins/757e7ee3-dba2-4909-8f0c-c2ed3ae0af47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d830c6af57883c3368e06e77d1288e25", "thumbnail_srcset": "https://si.imgix.net/df8d618e/uploads/origins/757e7ee3-dba2-4909-8f0c-c2ed3ae0af47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d830c6af57883c3368e06e77d1288e25, https://si.imgix.net/df8d618e/uploads/origins/757e7ee3-dba2-4909-8f0c-c2ed3ae0af47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=558220b7a035cd480021ef61081d6e3e 2x, https://si.imgix.net/df8d618e/uploads/origins/757e7ee3-dba2-4909-8f0c-c2ed3ae0af47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7627cdd73142e8ab3cc7625e9fdc2f26 3x", "genre": "art", "nsfw": false, "body": "あなたのアートスタイルがとても好きです!よろしくお願いします\n\n私のオリジナルキャラクターを描いてください。名前はヴァレリー。異なる世界を行き来できる強力な魔道士です。知識と技術の向上を求めて銀河系を旅している。性格はとても明るく、親切で知的。\n\nヴァレリーの参考文献 - https://imgur.com/a/ofeEZUZ\n\nエレガントに椅子に座って足を組んでいるポーズで描いてください。魔法の杖を持っているポーズでお願いします。表情は小さく微笑んでください。\n\nポーズ参考 - https://imgur.com/a/E3FedNK\n\n椅子のデザイン、背景など、細かい部分はあなたの想像にお任せします。楽しんで描いてくださいね！^_^", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/10", "thumbnail_src": "https://si.imgix.net/86ef1531/uploads/origins/75789131-d072-4239-88ae-6582bd9055d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9ab79fc79983ae4f3d9265e3b5658f3", "thumbnail_srcset": "https://si.imgix.net/86ef1531/uploads/origins/75789131-d072-4239-88ae-6582bd9055d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9ab79fc79983ae4f3d9265e3b5658f3, https://si.imgix.net/86ef1531/uploads/origins/75789131-d072-4239-88ae-6582bd9055d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8dd612c7b7be9ad36538c3e255f5397 2x, https://si.imgix.net/86ef1531/uploads/origins/75789131-d072-4239-88ae-6582bd9055d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80b42641cd857367f9ee965d92a6756d 3x", "genre": "art", "nsfw": false, "body": "Hi there,\n\nI'd like to request エイリーク from Fire Emblem. \n\nI would like for her to be wearing the outfit in the image. She is studying how to cast magic by reading a book. \n\nReference images: https://imgur.com/a/6EmPs6Z\n\nEirika is a bright and kind person. Here is a brief description of her personality: https://guide.fire-emblem-heroes.com/07001001000209-2/\n\nThanks for considering my request.\n\nhttps://imgur.com/a/6EmPs6Z", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/9", "thumbnail_src": "https://si.imgix.net/b64d03c4/uploads/origins/0c3a0d75-3734-41d3-a300-a39590e97e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03d34871fb1cca217673835a992b3fdb", "thumbnail_srcset": "https://si.imgix.net/b64d03c4/uploads/origins/0c3a0d75-3734-41d3-a300-a39590e97e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03d34871fb1cca217673835a992b3fdb, https://si.imgix.net/b64d03c4/uploads/origins/0c3a0d75-3734-41d3-a300-a39590e97e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=348b4c8034caa08fc55b806b0184aa5d 2x, https://si.imgix.net/b64d03c4/uploads/origins/0c3a0d75-3734-41d3-a300-a39590e97e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7817bfb7cdc79275b7e0f18ead7bfb3 3x", "genre": "art", "nsfw": false, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)と恒一(168cm)をカップルらしく描いてください。\n詳細はお任せします。資料を参考にご自由にお描きください。\nなお作品の舞台は98年の北陸の田舎町(モデルは富山県)です。\n絵柄はなるべく公式に寄せて欲しいです。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/8", "thumbnail_src": "https://si.imgix.net/691962ae/uploads/origins/30475a2b-48fb-482a-9466-48c491930ac4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b221b0b9ff3952e0e66dd7b38504dac8", "thumbnail_srcset": "https://si.imgix.net/691962ae/uploads/origins/30475a2b-48fb-482a-9466-48c491930ac4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b221b0b9ff3952e0e66dd7b38504dac8, https://si.imgix.net/691962ae/uploads/origins/30475a2b-48fb-482a-9466-48c491930ac4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa47358747b41569e2c75ce94ca58cf7 2x, https://si.imgix.net/691962ae/uploads/origins/30475a2b-48fb-482a-9466-48c491930ac4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f548657c1a0a9223b2e52ec2b34f5e8 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは！！是非イラストをリクエストさせて頂きたいです。\n\nわたし「天野寧々」を描いていただきたいです。\n\nシスター、ピンクのタートルネック、女神、どちらの姿でも大丈夫です！好きなように描いて欲しいと思っています。\n\nhttps://drive.google.com/drive/folders/1f7wrJMXmnzDexAIITPqgzBpr4CGpFgcw?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/7", "thumbnail_src": "https://si.imgix.net/aae382be/uploads/origins/be14744f-596c-449b-b134-2324d1fc19fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daf031b3ea31dfadca2411396e956d32", "thumbnail_srcset": "https://si.imgix.net/aae382be/uploads/origins/be14744f-596c-449b-b134-2324d1fc19fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daf031b3ea31dfadca2411396e956d32, https://si.imgix.net/aae382be/uploads/origins/be14744f-596c-449b-b134-2324d1fc19fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5ecf20932ccf438130f55b4e2db87ee 2x, https://si.imgix.net/aae382be/uploads/origins/be14744f-596c-449b-b134-2324d1fc19fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f4eecbc7fbf65fcb2f1b3458013e689 3x", "genre": "art", "nsfw": false, "body": "こんにちは～ファイアーエムブレムからルキナ（ルキナ）とロビン（ルフレ[男性]）をリクエストしたいのですが。\n\nルキナは花嫁のウエディングドレスを着ています。参考画像(01～05)を載せておきます。\n\nロビンは新郎のウェディングスーツを着用しています。ロビンは白髪です。参考画像(06-09)を載せておきます。\n\nロビンはルキナをお姫様だっこしています。参考画像(10-12)のようにロビンとルキナがキスをしています。目は閉じています。花嫁のウエディングドレスのクリノリン(Clinoline)を取り外して、ドレスの裾が広がらないようにすることができます。そうすることで、ロビンもルキナを楽に抱っこできるようになります。\n\nhttps://drive.google.com/drive/folders/1c-4Gt2wqyAzq1Bj1dxjgMgRf6H6bWRcr?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/6", "thumbnail_src": "https://si.imgix.net/e5fcb5b0/uploads/origins/113d4564-b001-427b-9553-5ec249b196b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd932971a3e4437418c991754e75fa7a", "thumbnail_srcset": "https://si.imgix.net/e5fcb5b0/uploads/origins/113d4564-b001-427b-9553-5ec249b196b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd932971a3e4437418c991754e75fa7a, https://si.imgix.net/e5fcb5b0/uploads/origins/113d4564-b001-427b-9553-5ec249b196b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f1ac56036adce6bcd6eae5a720bfdda 2x, https://si.imgix.net/e5fcb5b0/uploads/origins/113d4564-b001-427b-9553-5ec249b196b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebd5222dbf9b7ce5255136dd68536319 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shikilostman/works/5", "thumbnail_src": "https://si.imgix.net/3cc91b8