15e-8845c4dc6912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2517c0ee70630ccc86d515116816faf 2x, https://si.imgix.net/58a531c8/uploads/origins/670e4130-8741-4dac-815e-8845c4dc6912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1fa2e0497f74f3b68fc9fa9db9f8b51 3x", "genre": "art", "nsfw": false, "body": "私はあなたの作品が大好きです！スパイダーキャットのおかげであなたを見つけました。\n\nグレーのタビーのスコティッシュフォールドの猫又の女の子の肩にグレーのタビーのスコティッシュフォールドのクモがいて、彼女の頬に顔をうずめて、私のキャラクターが微笑んだり笑ったりしているような写真が撮れたらいいなと思っていました。\n\n注文を検討していただき、本当にありがとうございました！\n\nhttps://nutcasenekomata.carrd.co/assets/images/gallery27/619d5d86_original.jpg?v=f4f18b7a", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/64", "thumbnail_src": "https://si.imgix.net/9dafa0d4/uploads/origins/490b7c14-56ad-4e96-a155-89a1951fee03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75f103224de902a3ecd5844bdaeb439", "thumbnail_srcset": "https://si.imgix.net/9dafa0d4/uploads/origins/490b7c14-56ad-4e96-a155-89a1951fee03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75f103224de902a3ecd5844bdaeb439, https://si.imgix.net/9dafa0d4/uploads/origins/490b7c14-56ad-4e96-a155-89a1951fee03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4807b8b575d10ded6ea1577b6521cc4d 2x, https://si.imgix.net/9dafa0d4/uploads/origins/490b7c14-56ad-4e96-a155-89a1951fee03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d06a6eb487800f0ce72447c5888fe5a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お久しぶりです。  以前からまたご一緒したいと思っていたのですが、今日は簡単なお願いをさせてください。\n\n私のキャラクターはこちらです：\nhttps://i.imgur.com/k5JJBJe.jpg\nオレンジ色の目、白い髪、左目に傷がある少年です。\n\n彼を狼男として描いてくれませんか？人間っぽいので、長い髪と服はそのまま。目はオレンジのままで、表情は自由に。\n\nよく似たキャラクターがいるので、参考にしてみてください：\nhttps://i.imgur.com/nv5Pxta.jpg\n\n以上、よろしくお願いします！よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/63", "thumbnail_src": "https://si.imgix.net/5967fc23/uploads/origins/a0484a96-26e7-49f6-a557-6aad7655b270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a23bd636d1986e2b5f7d3b1cadf08fc", "thumbnail_srcset": "https://si.imgix.net/5967fc23/uploads/origins/a0484a96-26e7-49f6-a557-6aad7655b270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a23bd636d1986e2b5f7d3b1cadf08fc, https://si.imgix.net/5967fc23/uploads/origins/a0484a96-26e7-49f6-a557-6aad7655b270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e1523974fd46631ece969afb9396051 2x, https://si.imgix.net/5967fc23/uploads/origins/a0484a96-26e7-49f6-a557-6aad7655b270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c816eed848d581b21504169f4a5f43a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのマウの描き方がとても好きです。\n\n私のOCであるLupusのイラストをお願いしたいのですが、顔全体と開いた口の両方が見えるような、こちらのスタイルに似たものをお願いしたいです。https://twitter.com/82_rephap/status/1696115553302372425?s=20\n\n口、舌、歯は、標準的な色調を使用してください。\n\nありがとうございました！\n\nhttps://twitter.com/82_rephap/status/1696115553302372425?s=20\n\nhttps://drive.google.com/file/d/19QNNMhoexRZ2lIHM_lfitAuvKG9CMhKl/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/62", "thumbnail_src": "https://si.imgix.net/868c9e5a/uploads/origins/f6365db0-46cb-4ea3-b9b9-39ea6ee12f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e03063c5f02157b1c6a454d29178f4f8", "thumbnail_srcset": "https://si.imgix.net/868c9e5a/uploads/origins/f6365db0-46cb-4ea3-b9b9-39ea6ee12f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e03063c5f02157b1c6a454d29178f4f8, https://si.imgix.net/868c9e5a/uploads/origins/f6365db0-46cb-4ea3-b9b9-39ea6ee12f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12dc1900b4244b860cb8c145f0c56d1c 2x, https://si.imgix.net/868c9e5a/uploads/origins/f6365db0-46cb-4ea3-b9b9-39ea6ee12f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c8037ebfbaffd9a96a25e0de54cf2ef 3x", "genre": "art", "nsfw": false, "body": "「うちの子」\n\nハツ絵師様\nけもけっとにてお見かけした際に、\n・マズルの描き方\n・髪を髪として描かず、立髪っぽく描くやり方\n・獣化のシークエンスの多様性\n・獣もカッコ怖いものから、可愛いものの多様的な描き方\n・そして拘束！！\n全て素敵でした……。是非うちの子をデザインして戴きたいと思い、リクエストさせていただきます。依頼は３枚よろしくお願いします。\n\n●設定\n世界観は現代ファンタジー\n霊獣とJCのバディもの\n名前はマヤ（苗字は考え中です）\n歳は中学生ほどです。\nマヤの血統は人狼であり、数千年前より古より狼の霊獣をその体に封じて生まれてきます。\nこれは封印であり、半ば共生のようになっております。\n霊獣を封じて産まれてきた子供には下腹部に紋章がついてます。\nしかし、理由も意味も数千年前より薄れて参りました。\n狼の霊獣に唆されながら、狼の霊獣もマヤの体をたまに借りながら（偶に奪いながら）人に隠れてヒーローとして人助けをしています。\n【1枚目】\nマヤ、JC\n正義感が強く、アシカビを偶に困らせるほどに危険に無頓着、なんとかしてくれるでしょとアシカビを信頼している節がある（アシカビを舐めているという節もあります）\n変身プロセスとしては、首につけている勾玉を持ち、鏡にかざします\n肌は小麦色に日焼けしているタイプ\n下腹部に封印の紋章あり\n髪色はお任せ\n胸は少しあります\n活発な印象があるといいです\n目の色は濃い青（何か自分でも納得してないので、何かご提案あればそちらを優先してください）\n一人称は私\n\n【2枚目】\n名前はアシカビ\n正体は可美葦牙彦舅尊\n規格外の霊力を持っており、マヤについては、邪魔だとは思いつつも、少し大切に思っている。\n美形の霊狼として描いていただけると嬉しいです。\n毛皮は全体的に黒い感じで（黒一色じゃなくてもいいです）\n目の色は金で瞳孔は鷹のように縦長でお願いします（何か提案あればそちらを優先してください）\n一人称は俺\n気を失ったマヤの体から伸びたしめ縄で拘束されている感じをお願いします\n\n【3枚目】\nマヤが霊獣の力を解放して獣人になった姿\n目の色は青で瞳孔は鷹のように縦長\n胸は少しある。\n首には勾玉をぶら下げといてください\n毛皮は全体的に黒（黒一色というわけではない）で女性らしい体つき", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/61", "thumbnail_src": "https://si.imgix.net/00eb7883/uploads/origins/70b4f9ae-3d0c-41ec-abcf-fe173dcfae65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b4e8a2712980b1e5ba72b7a995e729e", "thumbnail_srcset": "https://si.imgix.net/00eb7883/uploads/origins/70b4f9ae-3d0c-41ec-abcf-fe173dcfae65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b4e8a2712980b1e5ba72b7a995e729e, https://si.imgix.net/00eb7883/uploads/origins/70b4f9ae-3d0c-41ec-abcf-fe173dcfae65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d876c899743ef749e156eccc84244fb 2x, https://si.imgix.net/00eb7883/uploads/origins/70b4f9ae-3d0c-41ec-abcf-fe173dcfae65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b86b515c7fb10fddf104efa1304ac7fb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が本当に大好きです。また依頼したいです。マンガを依頼したいんだ。私のOCはボーダーコリーに変身します。\n\n彼女はチアリーダーです。運動場で応援しているとき、リハーサルをしているとき、犬笛の音が聞こえてきた。それがきっかけでボーダー・コリーに変身する。\n\n最初はめまいがした。鼻が少し黒くなり、耳が長くなった。そして、チアリーディング用の手袋が脱げた。手は次第に前足に変わっていった。そして顔が変わり始め、舌を出した。振り向くと尻尾が生えていた。下半身も犬のようになり、服のサイズも合わなくなった。最後には完全に犬になって吠え続けた。  \n\n本当にありがとう肌の色は比較的明るい。目のハイライトはハートの形をしている。\n\nOC: https://drive.google.com/file/d/1a5zda4AfvqYEHxKd9wBiOQZ_bBjJGcKS/view?usp=drivesdk\n犬\nhttps://share.google/Qldbdjyv7szlVjGSG\n\nhttps://drive.google.com/file/d/1a5zda4AfvqYEHxKd9wBiOQZ_bBjJGcKS/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/60", "thumbnail_src": "https://si.imgix.net/66178aba/uploads/origins/27ae5be1-6ba9-46a5-a1f3-ccf193d98dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e563ef3b97e6741b36d22e23f920733", "thumbnail_srcset": "https://si.imgix.net/66178aba/uploads/origins/27ae5be1-6ba9-46a5-a1f3-ccf193d98dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e563ef3b97e6741b36d22e23f920733, https://si.imgix.net/66178aba/uploads/origins/27ae5be1-6ba9-46a5-a1f3-ccf193d98dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d47bffc67f731c68dcfd2535e39ddd0 2x, https://si.imgix.net/66178aba/uploads/origins/27ae5be1-6ba9-46a5-a1f3-ccf193d98dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc160b4b7a9d7307768a4f6a07b1e02d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ハツノニさん~\nハツノニさんの描く獣人の狂気的な雰囲気にとても魅了されています！\nぜひ私のキャラクターをもう一度描いていただければ嬉しいです。\n狂気的な悪の表情で、ポーズは自由に表現していただければと思います。\nどうぞよろしくお願いいたします、ありがとうございます～！\n\nhttps://www.dropbox.com/scl/fi/fdsjc2a5j9y0e04xh7hja/kirelons_oc.png?rlkey=io79e27ch0wa8hlrvadsqe1ei&st=rrl6695y&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/59", "thumbnail_src": "https://si.imgix.net/b2d531a7/uploads/origins/cdd5b88b-39e3-4f5d-b9ee-58ee2cbfb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef56ce7885ffed82d048b2f4aff2c55", "thumbnail_srcset": "https://si.imgix.net/b2d531a7/uploads/origins/cdd5b88b-39e3-4f5d-b9ee-58ee2cbfb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef56ce7885ffed82d048b2f4aff2c55, https://si.imgix.net/b2d531a7/uploads/origins/cdd5b88b-39e3-4f5d-b9ee-58ee2cbfb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc901875fbff12fbc86dd34bf9eb12c4 2x, https://si.imgix.net/b2d531a7/uploads/origins/cdd5b88b-39e3-4f5d-b9ee-58ee2cbfb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba701e58b068c001d5dd81d9c86c093d 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なTFイラストを描いていただきありがとうございます！\n\n今回もTFイラストを描いていただきたく依頼させていただきたいと思います！\n普段は構図やシチュエーションはある程度お任せしていますが、\n今回は是非見てみたい構図があるので、希望についても書き添えさせていただきます。\n\n前回は、以前の同人誌の中で特に好みだったシマウマTFを改めて描いていただきましたが、\n元となった同人誌のシマウマTFの構図や表情も好きだったので、\n是非別の動物でも見てみたいと思いました。\n\n同人誌で描かれていたシマウマTFの構図(首から上の横顔のシーケンス、4段階)を元に、\n女の子の顔が犬のドーベルマンに変化する過程が見てみたいです。\n\nまた、シチュエーションとして、首輪が変身のトリガーとなっている描写があると嬉しいです。\n\n女の子やドーベルマン、首輪などのデザインや細かな演出などはお任せするほか、シーケンスの過程数も構図に合わせて4以外でも構いません。\n\n是非今回もご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/58", "thumbnail_src": "https://si.imgix.net/c64d88cc/uploads/origins/2b909af0-d061-413e-b97b-ae2c85eabced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb167174b6ee0e1dbbc362905d1c9a3f", "thumbnail_srcset": "https://si.imgix.net/c64d88cc/uploads/origins/2b909af0-d061-413e-b97b-ae2c85eabced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb167174b6ee0e1dbbc362905d1c9a3f, https://si.imgix.net/c64d88cc/uploads/origins/2b909af0-d061-413e-b97b-ae2c85eabced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=587aaefb0f0a454f8ceffec95dc31056 2x, https://si.imgix.net/c64d88cc/uploads/origins/2b909af0-d061-413e-b97b-ae2c85eabced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20a69fa3851d5f95971928f09ed4b9b3 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！前回のイラストがとても気に入ったので、もっと欲しくなってしまいました！私の芸術への飢えをお許しください！\n\n前回お願いしたスケブのイラストの後のケテルのイラストが欲しいです。ケテルは不機嫌そうな顔をしているのですが、可愛く仕上げていただけたら嬉しいです。服は破れたりしてもいいので、ストライプとファーが好きなので、また描いてほしいです！\n\nお勧めのポーズはありませんが、爪やストライプを調べているポーズはかわいいと思います。大きな前足でコーヒーカップのマグカップを持っているところとか。良いと思うアイデアがあれば、遠慮なく実行してください！ぜひ見せてください！\n\n本当にありがとうございました！このリクエストがあなたの興味を引くことを願っています！\n\nhttps://skeb.jp/@82_rephap/works/56", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/57", "thumbnail_src": "https://si.imgix.net/f6fbae8d/uploads/origins/5f9261f4-9174-43ed-a297-652ecb129b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33be0e4b8caf4e8b43b62f1e4bd6d7cf", "thumbnail_srcset": "https://si.imgix.net/f6fbae8d/uploads/origins/5f9261f4-9174-43ed-a297-652ecb129b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33be0e4b8caf4e8b43b62f1e4bd6d7cf, https://si.imgix.net/f6fbae8d/uploads/origins/5f9261f4-9174-43ed-a297-652ecb129b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ec4c85fd1ffaac3c323fa4d596df301 2x, https://si.imgix.net/f6fbae8d/uploads/origins/5f9261f4-9174-43ed-a297-652ecb129b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f26f603fe9bde2214200cae8720ec418 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のOCエミリーがガゼルに変身するマンガのページを依頼したいんだ。\n\n大自然の中で写真を撮っているとき、自分の耳を触ってみたら、耳が長くなっていた。その後、手がひづめに変わった。彼女は怖くなった。顔がだんだん長くなっていく。毛は毛皮に溶け込んだ。体も変わり始めた。靴や靴下は蹄に引き裂かれた。服は破れた。そしてついに、彼女は完全にガゼルに変身した。蹄でカメラを拾おうとする。\n\nガゼルの毛色は現実を参考にしてほしい。メスのガゼルに角があるかどうかはわかりません。これも現実に従ってください！ありがとう！\n\nEmily: https://x.com/STrumpetBF/status/1904360919905566801?t=oOgEKn3CPPEylO4X8QXTxw&s=19\n\nhttps://x.com/STrumpetBF/status/1904360919905566801?t=oOgEKn3CPPEylO4X8QXTxw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/56", "thumbnail_src": "https://si.imgix.net/5e0fd4a3/uploads/origins/18636dbc-b930-4a61-818e-b8460071fdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49e22a83a55bc588d6ce58b69ec2b8c6", "thumbnail_srcset": "https://si.imgix.net/5e0fd4a3/uploads/origins/18636dbc-b930-4a61-818e-b8460071fdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49e22a83a55bc588d6ce58b69ec2b8c6, https://si.imgix.net/5e0fd4a3/uploads/origins/18636dbc-b930-4a61-818e-b8460071fdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68495f14cd195c0958a4c068184ac080 2x, https://si.imgix.net/5e0fd4a3/uploads/origins/18636dbc-b930-4a61-818e-b8460071fdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ba0256133c0e846a9a4a8b5e806e52a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Twitterからあなたの作品の大ファンです！私のOC、ケテルのTFシークエンスをお願いしたいです！\n\n私のOCが毛皮の虎に変身するTFシークエンスが欲しいです。特に、あなたがTwitterに投稿したこの作品にインスパイアされました：\nhttps://x.com/82_rephap/status/1880223691969294738\nもしご面倒でなければ、私のOCがこのようなアンソロトラに変身してほしいです！そして、それは私をとても幸せにするでしょう！\n\nこのリクエストのために、1つ細かいことをお知らせしておきます：ケテルのデザインはもともとドラゴンにインスパイアされたもので、オリジナルのデザインにはドラゴンの特徴がいくつかあります。今回のTFシークエンスでは、彼女の角をアートに含めないでもらいたい。なぜなら、彼女が他の種族の毛皮の動物に変身する楽しみを妨げると思うからだ。それ以外は特に指定することはない。\n\nケテルのリファレンスはこちら：\nhttps://drive.google.com/file/d/1C9_pa7S7mfEYzN15R9eAqNP-hB1HKR8l/view?usp=drive_link\n\nありがとうございました！\n\nhttps://drive.google.com/file/d/1C9_pa7S7mfEYzN15R9eAqNP-hB1HKR8l/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/55", "thumbnail_src": "https://si.imgix.net/5239f906/uploads/origins/75dbbb0c-2302-4f36-b214-067bc37fb918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1af729ed84011ace8e07c9cceec9cb07", "thumbnail_srcset": "https://si.imgix.net/5239f906/uploads/origins/75dbbb0c-2302-4f36-b214-067bc37fb918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1af729ed84011ace8e07c9cceec9cb07, https://si.imgix.net/5239f906/uploads/origins/75dbbb0c-2302-4f36-b214-067bc37fb918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a66b1f3eb0e71da65b59fd71143592e 2x, https://si.imgix.net/5239f906/uploads/origins/75dbbb0c-2302-4f36-b214-067bc37fb918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=556d0efc88dae4715c0b604e22e6a107 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が本当に大好きです！\n今回初めて依頼させていただきます。こういうTF漫画が欲しいです：\nhttps://x.com/82_rephap/status/1850137704308396525?t=zxtX9nTzGJmJdYJguL0Zyg&s=19\nhttps://x.com/82_rephap/status/1827310135137726799?t=xLyBFz5Sh83ag3oJqmCtGA&s=19\n\nOCのアンディを羊にしてください。角は描かないでください。\n彼女の表情はパニックと混乱で、変化中に痛みを感じます。下半身の変化が一番楽しみです。しかし、上半身の変化、特に顔の変化も描いてください。服が破れる様子もお願いします。\n\n参考にしたOC\nhttps://x.com/STrumpetBF/status/1866738861264736436?t=9tOJtAbGL80NyLNZPma7Kw&s=19\n真珠のイヤリングをしている。首のネックレスの模様は🌸と🐱。他の細かい部分は自分で調整できます。\n\nお値段はご相談に応じます。\n\nhttps://x.com/STrumpetBF/status/1866738861264736436?t=9tOJtAbGL80NyLNZPma7Kw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/54", "thumbnail_src": "https://si.imgix.net/6484fd1a/uploads/origins/e23026c7-685e-4bbf-bc64-a46af305c80e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0aac30226c8795c05770eb25a13531f", "thumbnail_srcset": "https://si.imgix.net/6484fd1a/uploads/origins/e23026c7-685e-4bbf-bc64-a46af305c80e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0aac30226c8795c05770eb25a13531f, https://si.imgix.net/6484fd1a/uploads/origins/e23026c7-685e-4bbf-bc64-a46af305c80e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a66f3f0120e29ae4e01bbf08720620cc 2x, https://si.imgix.net/6484fd1a/uploads/origins/e23026c7-685e-4bbf-bc64-a46af305c80e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd368648e69c9ef0ae4c93b498202259 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nいつもイラスト拝見させていただいております。\n\n早速依頼の内容ですが、男性が馬になるTFシーケンスをお願いしたいです。\nハミを咥えさせられて顔が変わっていくようにしていただけると尚嬉しいです。\nそれ以外の構図はお任せさせていただきたいと思います。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/53", "thumbnail_src": "https://si.imgix.net/6a729d3b/uploads/origins/90f973d9-9ffe-4388-817f-6fba28daac72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=951610fe83f5dc689bc3cbe50184973c", "thumbnail_srcset": "https://si.imgix.net/6a729d3b/uploads/origins/90f973d9-9ffe-4388-817f-6fba28daac72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=951610fe83f5dc689bc3cbe50184973c, https://si.imgix.net/6a729d3b/uploads/origins/90f973d9-9ffe-4388-817f-6fba28daac72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f53b949867bfb2fb67ef6c7c70c267b3 2x, https://si.imgix.net/6a729d3b/uploads/origins/90f973d9-9ffe-4388-817f-6fba28daac72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4064549a54f73fdb062224c8ddfc8da5 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なTFイラストを描いていただきありがとうございます！\n\n最新の同人誌を拝見させていただき、どのTFも素敵だったのですが、\nその中で特にシマウマTFがとても好みでした。\nそこで、同じテーマで二度描かせてしまうことになるので恐縮ですが、\n是非いつものskeb依頼で描いていただいているような変身シーケンスで、\nシマウマの変身を見てみたいと思いました。\n\n普通の女の子が完全なシマウマに変わるまでの変化が見てみたいです。\nシマウマの種類やデザイン、女の子のデザイン、シーケンスの過程数や細かな演出などはお任せします。\n\n是非今回もご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/52", "thumbnail_src": "https://si.imgix.net/9529a13f/uploads/origins/8b5e4fe6-bb79-4dd4-9a84-9bbdcb0a71f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21089967e38f4c51bda26ce62307d4f8", "thumbnail_srcset": "https://si.imgix.net/9529a13f/uploads/origins/8b5e4fe6-bb79-4dd4-9a84-9bbdcb0a71f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21089967e38f4c51bda26ce62307d4f8, https://si.imgix.net/9529a13f/uploads/origins/8b5e4fe6-bb79-4dd4-9a84-9bbdcb0a71f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f6eded6b9b51c37c8db4fb2b053839d 2x, https://si.imgix.net/9529a13f/uploads/origins/8b5e4fe6-bb79-4dd4-9a84-9bbdcb0a71f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b33feca38613553e7abac9f150673f06 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nTF本を拝見して自分も依頼してみたいと思い、リクエストさせていただきます！\n\n男の人がヨツケモの雄ライオンになってしまうTFシーケンスをお願いしたいです！\n\n男性の見た目やシーケンスの過程数など細かい設定はお任せいたします！ご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/51", "thumbnail_src": "https://si.imgix.net/8467462b/uploads/origins/bc90d033-2919-4f6e-a07c-930744a1762a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce22f76dd52302a00689a515442a9c2d", "thumbnail_srcset": "https://si.imgix.net/8467462b/uploads/origins/bc90d033-2919-4f6e-a07c-930744a1762a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce22f76dd52302a00689a515442a9c2d, https://si.imgix.net/8467462b/uploads/origins/bc90d033-2919-4f6e-a07c-930744a1762a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e636f84cfb687dd8ce6ad5fe05ba985 2x, https://si.imgix.net/8467462b/uploads/origins/bc90d033-2919-4f6e-a07c-930744a1762a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68c7f098bb0f3175d6d978d069412aed 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n先日のけもケで本を4冊セットで購入させていただき、とても良かったので、もしよければうちのテオドアとレイチェルを描いていただけないかと思い、リクエストさせていただきました。\n構図や表現方法など全てお任せいたします。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HqyLz7u8qbj_lExBuDPjaQXzKnqWSA6K", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/50", "thumbnail_src": "https://si.imgix.net/cb24bb0f/uploads/origins/66321c95-b9f4-44bd-aa8c-278c5b5cf699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb43861e1492ff4a5f83a046650fb95b", "thumbnail_srcset": "https://si.imgix.net/cb24bb0f/uploads/origins/66321c95-b9f4-44bd-aa8c-278c5b5cf699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb43861e1492ff4a5f83a046650fb95b, https://si.imgix.net/cb24bb0f/uploads/origins/66321c95-b9f4-44bd-aa8c-278c5b5cf699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3d6e3e17e2277d680c4bb909f686b9a 2x, https://si.imgix.net/cb24bb0f/uploads/origins/66321c95-b9f4-44bd-aa8c-278c5b5cf699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=309661b32dce4fd2526a38190c93c623 3x", "genre": "art", "nsfw": false, "body": "原稿お疲れ様です！\n以前から頂いた作品が大変気に入っており、描いて欲しいTFのシチュエーションがあるためリクエストさせて頂きます！\n\n■シチュエーション\n外へ出かけていた女の子はその日が満月の夜だったことを忘れており、自身の身体の変化で気付く。\n慌てて茂みに駆け込み、いつも通り人狼への変身を終えたと思ったが、\nその日はこれから彼女が1年に1度迎える特別な日の1回目で、そのまま変身が止まらず\n困惑しながら動物の狼の姿になってしまう。というシチュで2ページ～で描いて頂きたいです。\n\n■キャラクター\nキャラクターの設定は\nhttps://skeb.jp/@82_rephap/works/45\n上記の作品と同様にお願いします。\n服装だけ、描いて欲しい描写に影響するためシャツと短パンでお願いします。\n（今日が満月と忘れているため、変身を考慮していないような服装）\n服デザインはお任せします。靴は変身が始まるまでに脱げた、という設定で無くても問題ありません。\n\n■要望\n・シチュの慌てて茂みに駆け込み～までは最小限で問題ありません。\n・人→人狼と人狼→狼の描写量は半々くらいでお願いします。\n・前回の作品と同じく変身には比較的慣れているため苦痛表現は少な目でお願いします。\n・尻尾が生えて後ろ脚が変化するシーケンスを今回も入れて欲しいです。（大変良かったです…）\n　また、尻尾が生える際にズボンを破る描写を入れて欲しいです。\n・動物の狼へ変身する際に骨格の変化などで服が合わなくて脱げるか破れるような描写を入れて欲しいです。\n　変身完了時に何も着ていないか布が乗っているような形だと嬉しいです。\n・その他変身描写の量はお任せします。\n\n以上、前回より描写の指定が増えて恐縮ですが、条件やスケジュール等合えばよろしくお願いします！\nけもケの新刊も楽しみにしてます～！", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/49", "thumbnail_src": "https://si.imgix.net/972f9de2/uploads/origins/cf1bc0f9-1b71-4a73-a0ce-469c00953f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc46037cf365d237dc406d2702df985", "thumbnail_srcset": "https://si.imgix.net/972f9de2/uploads/origins/cf1bc0f9-1b71-4a73-a0ce-469c00953f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc46037cf365d237dc406d2702df985, https://si.imgix.net/972f9de2/uploads/origins/cf1bc0f9-1b71-4a73-a0ce-469c00953f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b303c2e91a492bebe03d432e91b9a5b3 2x, https://si.imgix.net/972f9de2/uploads/origins/cf1bc0f9-1b71-4a73-a0ce-469c00953f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dbaa5988565025f3d16b695e3cb976c 3x", "genre": "art", "nsfw": false, "body": "初めまして、匿名で失礼します。\nいつもイラスト拝見しております。\n\n黒髪の女の子が完全な馬に変身してしまうTFシーケンスのイラストを依頼したいです。\n\n少し苦しそうに顔が変化する過程が好きなので、可能であればそのように描いていただけると嬉しいです。\n\n髪色以外の女の子のデザインや馬のデザイン、シーケンスの過程数などはお任せいたします。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/48", "thumbnail_src": "https://si.imgix.net/46c190bf/uploads/origins/11154de2-c313-46a7-a132-a8e8133ec219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c76c3ee4b0d559b616e642025a58026d", "thumbnail_srcset": "https://si.imgix.net/46c190bf/uploads/origins/11154de2-c313-46a7-a132-a8e8133ec219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c76c3ee4b0d559b616e642025a58026d, https://si.imgix.net/46c190bf/uploads/origins/11154de2-c313-46a7-a132-a8e8133ec219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=122fa78befaf6d67c01228dac7e02d19 2x, https://si.imgix.net/46c190bf/uploads/origins/11154de2-c313-46a7-a132-a8e8133ec219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4ddb81dd565a5a86282d0e422ea5f4d 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なTFイラストを描いていただきありがとうございます！\n\n以前の同人誌や、他の方の依頼を拝見させていただき、\nもっと色々なTFを見てみたいと思いまたリクエストさせていただきます。\n\n今回依頼させていただきたいのは、人間の女の子からワニへの変身シーケンスです。\n前回同様、普通の女の子が完全なワニに変わるまでの変化が見てみたいです。\n\nワニの種類はイリエワニやナイルワニなどの大型の種が見てみたいですが、\n他に描いてみたい種や描きやすい種があればそちらでも構いません。お任せします。\n\n女の子のデザイン、ワニの詳細なデザイン、シーケンスの過程数や細かな演出などはお任せします。\n\n是非今回もご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/47", "thumbnail_src": "https://si.imgix.net/72abbc6a/uploads/origins/a8ceb2e3-546e-43d9-985b-eb4f3b24b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8924f01405d19b2898590e3307769877", "thumbnail_srcset": "https://si.imgix.net/72abbc6a/uploads/origins/a8ceb2e3-546e-43d9-985b-eb4f3b24b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8924f01405d19b2898590e3307769877, https://si.imgix.net/72abbc6a/uploads/origins/a8ceb2e3-546e-43d9-985b-eb4f3b24b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99bab1e3ff0aa6deef89c5dab60f2354 2x, https://si.imgix.net/72abbc6a/uploads/origins/a8ceb2e3-546e-43d9-985b-eb4f3b24b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21b849b44b0df17c0dd227d6ffc63ce7 3x", "genre": "art", "nsfw": false, "body": "ハツノニ様\nいつも素敵なTFイラストを投稿してくださり、ありがとうございます。塚祭草狼と申します。\n私のオリキャラも描いていただきたいと思い、リクエストさせていただきます。\n今回ご依頼したいのは、人間の巫女さんがニホンオオカミへと変身するシーケンスです。 小柄な巫女さんがニホンオオカミの霊に憑依されることで、狼獣人のような姿を経由して、完全なニホンオオカミに変わるまでの変化をお願いいたします。巫女服のデザイン、シーケンスの過程数や描写などはお任せします。\nマズルが伸びていく過程などが好きです。\n何卒よろしくお願いいたします。\n資料URLに私が描いた狼獣人モードの巫女さんを載せておきます。\n\nhttps://x.com/tsukamatsuri/status/1823353565748019671?s=46&t=61O2EAC-AaOW1HAdnj-xxA", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/46", "thumbnail_src": "https://si.imgix.net/ebe76645/uploads/origins/ae25d47e-79a9-4c3b-82b8-9a98dd2a8198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8943d5d6480e0c4d6a9c901d6681d9e", "thumbnail_srcset": "https://si.imgix.net/ebe76645/uploads/origins/ae25d47e-79a9-4c3b-82b8-9a98dd2a8198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8943d5d6480e0c4d6a9c901d6681d9e, https://si.imgix.net/ebe76645/uploads/origins/ae25d47e-79a9-4c3b-82b8-9a98dd2a8198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7666af21377d9aa6f1aee56fddfca6f9 2x, https://si.imgix.net/ebe76645/uploads/origins/ae25d47e-79a9-4c3b-82b8-9a98dd2a8198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bd31b08d221a66542ad885303995554 3x", "genre": "art", "nsfw": false, "body": "前回は素敵な作品をありがとうございました！\nイベント近いかと思いますので作業期間に余裕があれば1枚イラストをリクエストさせて頂きたく…！\n\nhttps://skeb.jp/@82_rephap/works/45\nこの作品の人狼の姿、衣服は無しの状態でお願いしたいです。\n他ポーズアングルなどは全てお任せします。\n\n難しいようでしたらまた機会改めさせていただきます…！\n要件合いましたらぜひお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/45", "thumbnail_src": "https://si.imgix.net/8889edc1/uploads/origins/6297bf7f-7dc8-4115-bd12-0e49aa31c603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22c49981a703c308c35637b16ee54995", "thumbnail_srcset": "https://si.imgix.net/8889edc1/uploads/origins/6297bf7f-7dc8-4115-bd12-0e49aa31c603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22c49981a703c308c35637b16ee54995, https://si.imgix.net/8889edc1/uploads/origins/6297bf7f-7dc8-4115-bd12-0e49aa31c603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aeaf53c118adc686ab37573d1853e3db 2x, https://si.imgix.net/8889edc1/uploads/origins/6297bf7f-7dc8-4115-bd12-0e49aa31c603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ba8c8a0a8f1913bfe030c1db54b2d54 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nTF描写がとても好みで作品拝見させて頂いております。\n金髪碧眼の少女が人狼に変身するシチュエーションでリクエストさせてください。\n\n■キャラクター資料\nhttps://www.dropbox.com/scl/fo/6kffab5ddclh7mckmawpf/APOPIGKzqUnSRPqK6cgOdy8?rlkey=8ogawzp334jd88uuo2pbre5ki&dl=0\n・10歳前後くらいの小柄な女の子です。\n・普段は教室で本を読んでいるようなおとなしめの性格です。\n・先天性の人狼病の影響で満月の夜に人狼に変身する体質。\n　なので、変身には比較的慣れています。\n・変身後に目の色を実在する狼と同じ色に変えて欲しいです。\n　変身後のデザインはお任せします。\n\n■描写など\n・人間のお尻から動物の尻尾が生えるのがとても好きなので、尻尾が生えるシーケンスを入れて欲しいです。\n・その他シーケンス数や枚数などは諸々お任せします。\n\n以上、条件合いましたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@82_rephap/works/44", "thumbnail_src": "https://si.imgix.net/01f25fa8/uploads/origins/aca42282-1beb-4028-907f-3c8537909565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5bd2ddb234b6a9998d7d08501d574ff", "thumbnail_srcset": "https://si.imgix.net/01f25fa8/uploads/origins/aca42282-1beb-4028-907f-3c8537909565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5bd2ddb234b6a9998d7d08501d574ff, https://si.