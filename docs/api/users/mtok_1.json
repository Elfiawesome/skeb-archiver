すのでもちろん松岡先生の自由に描いていただいて大丈夫です…！）\n\n細かい部分になってしまいますがネクタイの色（青紫）と前髪の白メッシュだけは必ず描いていただきたいです。\nその他は細かいデザインが多いので松岡先生の判断で略していただいて構いません。\n\nまた、よろしければ人物透過単体と背景単体のデータもいただけると大変ありがたいです。\n\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1JzoK3d3sr0pbGc0SeEoStXloSLJniRMu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mtok_1/works/5", "thumbnail_src": "https://si.imgix.net/c80937c3/uploads/origins/91b31243-d342-4cc7-a33f-8946581b1c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07441f32a7c0ddf8f472b07dfc70ddd8", "thumbnail_srcset": "https://si.imgix.net/c80937c3/uploads/origins/91b31243-d342-4cc7-a33f-8946581b1c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07441f32a7c0ddf8f472b07dfc70ddd8, https://si.imgix.net/c80937c3/uploads/origins/91b31243-d342-4cc7-a33f-8946581b1c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6fa485f8c6af33a3d2d09a8bc6cdf38 2x, https://si.imgix.net/c80937c3/uploads/origins/91b31243-d342-4cc7-a33f-8946581b1c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75875f8a36fe10be8045ee93a25d6564 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mtok_1/works/4", "thumbnail_src": "https://si.imgix.net/9a127753/uploads/origins/1ea5d209-0083-4f0b-aa34-219c5a59e6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2663304e240331b78e5bf8b883454b8a", "thumbnail_srcset": "https://si.imgix.net/9a127753/uploads/origins/1ea5d209-0083-4f0b-aa34-219c5a59e6b9?bg=%23fff&auto=format%2Ccompress&fm=we