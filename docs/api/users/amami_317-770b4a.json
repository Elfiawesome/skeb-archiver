-a290-5c1a7217cf5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e100cfc2695f095da1abc3fb564f86d, https://si.imgix.net/0b1902e0/uploads/origins/c2d47743-a753-48ff-a290-5c1a7217cf5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d71a13b0552f8e3ebc5fa4455928161 2x, https://si.imgix.net/0b1902e0/uploads/origins/c2d47743-a753-48ff-a290-5c1a7217cf5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19f60a6ecb74039885b3b1e30ccd5661 3x", "genre": "art", "nsfw": true, "body": "キャラクター：各務チヒロ（ブルーアーカイブ）\n\nシチュエーション：エンジニア部が作った機械が暴走してしまい、近くにいたチヒロが襲われて膨体化させられてしまう。\n\n-手足を拘束されている。\n-胸やへそにチューブを挿入されてガスを注入されている。\n-お腹に検査用の電極を貼り付けられ、膨張の具合が表示されている。\n全身をアーム揉みしだかれている。\n-膨張の苦しさで気絶してしまいヘイローが明滅している。\n-膨らまされたチヒロを見て慌てているエンジニア部の様子もお願いします。\nこちらのイラストの3枚目のようなイメージで（https://www.pixiv.net/artworks/101088896）\n\n以上になります、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/43", "thumbnail_src": "https://si.imgix.net/2925a1cd/uploads/origins/ec1adc78-1817-47fa-aa36-59e735c41dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a44fb8bf13bcb694fd5806333c286912", "thumbnail_srcset": "https://si.imgix.net/2925a1cd/uploads/origins/ec1adc78-1817-47fa-aa36-59e735c41dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a44fb8bf13bcb694fd5806333c286912, https://si.imgix.net/2925a1cd/uploads/origins/ec1adc78-1817-47fa-aa36-59e735c41dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c8b7d7bbd052eaba81eee8a235402a8 2x, https://si.imgix.net/2925a1cd/uploads/origins/ec1adc78-1817-47fa-aa36-59e735c41dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76f1de05a1d5abf83f525fd1b6453e46 3x", "genre": "art", "nsfw": true, "body": "かんみ様、いつもお世話になっております。以前拝見したアズレンベルファストのメントスコーラシチュ（https://www.pixiv.net/artworks/116131894）が素晴らしかったので、可能でしたらもっと膨らんだ姿をリクエストしたく思います。構図は以前描かれてましたブルアカサキ（https://www.pixiv.net/artworks/109628923の9枚目）のように仰向けで頭からの視点、体型は今挙げたサキのようなパンパンな膨らみ具合でお願いします。また、シチュエーションの詳細といたしましては、コーラをホースで口から流し込まれていて、可能でしたらお腹の上で饅頭を飛び跳ねてさせてください。以上となります。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/42", "thumbnail_src": "https://si.imgix.net/528703ae/uploads/origins/03863089-c134-478c-8117-11d276e1986f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e91412c666d077f1536b3653cfb1ed4d", "thumbnail_srcset": "https://si.imgix.net/528703ae/uploads/origins/03863089-c134-478c-8117-11d276e1986f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e91412c666d077f1536b3653cfb1ed4d, https://si.imgix.net/528703ae/uploads/origins/03863089-c134-478c-8117-11d276e1986f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1896cba8ee5adcc42892b58e60b3105 2x, https://si.imgix.net/528703ae/uploads/origins/03863089-c134-478c-8117-11d276e1986f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=030989e163388025422922f6e8ddbf87 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/41", "thumbnail_src": "https://si.imgix.net/0a13ab0a/uploads/origins/f8282345-03cd-4139-b9b8-f13100f78aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10dcd5c037093603edff5494759fefe7", "thumbnail_srcset": "https://si.imgix.net/0a13ab0a/uploads/origins/f8282345-03cd-4139-b9b8-f13100f78aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10dcd5c037093603edff5494759fefe7, https://si.imgix.net/0a13ab0a/uploads/origins/f8282345-03cd-4139-b9b8-f13100f78aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1b43d4ec4c2511b12b5e4417420df19 2x, https://si.imgix.net/0a13ab0a/uploads/origins/f8282345-03cd-4139-b9b8-f13100f78aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a62a8adf2d5da42066c7b4d46288f338 3x", "genre": "art", "nsfw": true, "body": "お世話になります！\n今回も私のオリジナルキャラクターの白扇をご依頼させてください。\n\nこちらの作品(https://skeb.jp/@amami_317/works/34)のような構図で、ものすごく肥満化して困っている立ち絵の姿をお願いします。\n\nポーズは大きくなったお腹に手を回している、胸の上に手をのせているなどのシンプルなもので構いません。\nできる範囲で全身がキャンバス内に納まるようにしてください。\n服装はいつもの着物か縦セタで、表情は大きくなった体に困っているイメージでお願いします。\n\n体型に関しては頭身を高く、また白扇といえば大きな身体と胸なのでこちら(https://skeb.jp/@amami_317/works/27)のように可能な範囲でものすごく大きくしてください。下半身も超乳に負けない大きさにしていただけると嬉しいです。\n\nかんみさんの肥満化や膨張絵がとても好きなので、是非目一杯大きくしてください！\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/84413536", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/40", "thumbnail_src": "https://si.imgix.net/efc3fe92/uploads/origins/5b315df0-8221-409b-ba25-de076eace390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d08f12585f539c2ae0d11e8a228f060", "thumbnail_srcset": "https://si.imgix.net/efc3fe92/uploads/origins/5b315df0-8221-409b-ba25-de076eace390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d08f12585f539c2ae0d11e8a228f060, https://si.imgix.net/efc3fe92/uploads/origins/5b315df0-8221-409b-ba25-de076eace390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f07e6cd1b5054e0721d2765f11eb0964 2x, https://si.imgix.net/efc3fe92/uploads/origins/5b315df0-8221-409b-ba25-de076eace390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d78afa3e5b7ddae61e793c8eff2cf69 3x", "genre": "art", "nsfw": false, "body": "VENUS PRJECT (ヴィーナスプロジェクト)の香島夕の膨体をお願いできますか…？(´・ω・)\n衣装はこれでお願いできますか…？(オレンジ色の衣装の方)↓\n①https://kknews.cc/comic/xm2b9vr.html\n② https://x.com/formula_venus/status/745398398178648066\n手足顔はそのままでお願いします。\n浮かせないで立っている感じでお願いします。\n膨らみ具合はこれみたいにまん丸に膨らませください。↓\nhttps://skeb.jp/@amami_317/works/1", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/39", "thumbnail_src": "https://si.imgix.net/f7cc9435/uploads/origins/1f8f3024-f17d-46b3-ae34-f0613ed99d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c640d341d1d7f031bd8d7de0547c4d8", "thumbnail_srcset": "https://si.imgix.net/f7cc9435/uploads/origins/1f8f3024-f17d-46b3-ae34-f0613ed99d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c640d341d1d7f031bd8d7de0547c4d8, https://si.imgix.net/f7cc9435/uploads/origins/1f8f3024-f17d-46b3-ae34-f0613ed99d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c7818b901db3b00b42dc8fe73226235 2x, https://si.imgix.net/f7cc9435/uploads/origins/1f8f3024-f17d-46b3-ae34-f0613ed99d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1759044b29ff0a22fc11e084b4b693ba 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！\nペンドリの絵がとても良かったので、今回は狐の女の子、鈴の絵をお願いします！\n少し太ってから描いてください。\n鏡の前に立って、ちょっと恥ずかしそうに自分の姿を見ているような絵にしたいです。彼女はベルトをしようと手に持っている。\n\nあなたの作品を応援するのを楽しみにしています！\n以下に参考資料を置いておきます：\nhttps://drive.google.com/drive/folders/1eprvQXm9HGYEuREDkmPnFRiBW3_m7KG0", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/38", "thumbnail_src": "https://si.imgix.net/16e5878b/uploads/origins/7127cb0a-5aa1-4def-8914-9d37b0abbacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1262891501b3489991e790c24411c3a5", "thumbnail_srcset": "https://si.imgix.net/16e5878b/uploads/origins/7127cb0a-5aa1-4def-8914-9d37b0abbacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1262891501b3489991e790c24411c3a5, https://si.imgix.net/16e5878b/uploads/origins/7127cb0a-5aa1-4def-8914-9d37b0abbacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eab1779aa4b0cf999018c1405f3e252a 2x, https://si.imgix.net/16e5878b/uploads/origins/7127cb0a-5aa1-4def-8914-9d37b0abbacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d69a419085e0529e74db7a733d38ed2d 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエスト失礼します\n　ブルアカのユウカ（体操服）の膨体をお願いします\nユウカ（体操服）→https://bluearchive.wikiru.jp/?ユウカ（体操服）\n　膨体は以前のskebで描かれた様な、タプンとした水風船の様な膨体をお願いしたいです。\n→https://skeb.jp/@amami_317/works/36\n　ネタとしましては高カロリーの食べ物を試食し、徐々に太り、食べすぎて気付いたらタプンタプンの膨体してしまい、動けない所をゲーム開発部のメンバー（又はかんみさんのやりやすいキャラで大丈夫です。）に揉まれたりクッションの様に寄りかかられていたり、乗られている物（こちらもこれらだけでなく膨体弄りはかんみさんのやりやすい物でも大丈夫）でお願いします。\n　もし可能したらこちらの様にシークエンスの様に、通常、肥満化、タプンとした膨体のシークエンスを、お肉がはみ出してる所は軽い締め付け、ぷにっとして貰えると嬉しいです。\n　シークエン参考→https://skeb.jp/@amami_317/works/11\n\n　少々長い文章失礼しました、ご一考のほど宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/37", "thumbnail_src": "https://si.imgix.net/42386746/uploads/origins/f25b02a1-a793-4f13-93df-97c5798a85c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8315b1343edc617f5d6c61de49ed899", "thumbnail_srcset": "https://si.imgix.net/42386746/uploads/origins/f25b02a1-a793-4f13-93df-97c5798a85c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8315b1343edc617f5d6c61de49ed899, https://si.imgix.net/42386746/uploads/origins/f25b02a1-a793-4f13-93df-97c5798a85c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c53b2ffb951fb55a88c0c4a9b009d95 2x, https://si.imgix.net/42386746/uploads/origins/f25b02a1-a793-4f13-93df-97c5798a85c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b2ef28b7332cdb809f81773798d2504 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回リクエストで火宮チナツの膨体をお願いしたいです。\n体格とシチュエーションは(https://x.com/amami_317/status/1809576921061290135?s=46&t=OVcwasUcrDaeRVXlddKgWw)こちらのイラストのように膨らまされて風船紐を付けられてしまってるシチュエーションでお願いしたいです。\n\nよろしければ是非ご検討の程をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/36", "thumbnail_src": "https://si.imgix.net/888749e3/uploads/origins/67714023-a4fb-4280-8529-e5345119ad38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d3bfc9dfc987e69504f79e89391f28e", "thumbnail_srcset": "https://si.imgix.net/888749e3/uploads/origins/67714023-a4fb-4280-8529-e5345119ad38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d3bfc9dfc987e69504f79e89391f28e, https://si.imgix.net/888749e3/uploads/origins/67714023-a4fb-4280-8529-e5345119ad38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=311e4b5e761c9c998579f333066fac93 2x, https://si.imgix.net/888749e3/uploads/origins/67714023-a4fb-4280-8529-e5345119ad38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=756688f6ae2f21f5e11b16f9f947b4e0 3x", "genre": "art", "nsfw": true, "body": "https://twitter.com/amami_317/status/1721869633991708917の風船タンクとなっているモルガン陛下の膨体風の肥満化タンクverをお願いしたいです！\n太った顔も見えるようにして頂いて当然膨らんでしまったことに驚き恥ずかしがっている感じでお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@amami_317/works/35", "thumbnail_src": "https://si.imgix.net/5cda299d/uploads/origins/ef42f9d9-6db9-4788-b4f1-976634d5bedf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f36e6d151bb675e9987fe8ba163dc641", "thumbnail_srcset": "https://si.imgix.net/5cda299d/uploads/origins/ef42f9d9-6db9-4788-b4f1-976634d5bedf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f36e6d151bb675e9987fe8ba163dc641, https://si.imgix.net/5cda299d/uploads/origins/ef42f9d9-6db9-4788-b4f1-976634d5bedf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30d498423a4db2692c857741f57790c0 2x, https://si.imgix.net/5cda299d/uploads/origins/ef42f9d9-6db9-4788-b4f1-97