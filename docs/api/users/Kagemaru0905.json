4990-8455-8c2cb26b5c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073c25be9d8c9f0bdd7d28fc975336e1, https://si.imgix.net/7f7b4178/uploads/origins/7afc64b1-7248-4990-8455-8c2cb26b5c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e055eadf0cc4ba5ce60237b833cd30e3 2x, https://si.imgix.net/7f7b4178/uploads/origins/7afc64b1-7248-4990-8455-8c2cb26b5c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dea34699b09124c472385a01b8fa9ba 3x", "genre": "art", "nsfw": false, "body": "Kagemaruさん こんにちは！\nいつもイラスト楽しみに見ております！！\n依頼なのですが、以前描かれていた漫画の一コマ目のmiCometのような仲の良い感じで左側にモル・アロヴィーテさんと右側にグレイグ・フルヴェイヤさんを描かれていただけますでしょうか？ \nあと一言だけセリフを入れて欲しいです\nhttps://www.pixiv.net/artworks/116920390\n［セリフ］\nモル・アロヴィーテさんが「たや〜」\nグレイグ・フルヴェイヤさんが「モルち〜」\n［参考資料］\nモル・アロヴィーテ\nhttps://x.com/MorArovete/status/1663560917928534018?t=o99eLMhwuadN5HQdNl6JgA&s=19\n\nグレイグ・フルヴェイヤ\nhttps://x.com/GreygFullveija/status/1688927948630540288?t=c_xjt6sZEyHjtNZHyImGWQ&s=19\n\n［使用用途］\nXにて私のアカウントのアイコンかヘッダーに使用したいと思っております", "created_at": "", "completed_at": ""}, {"path": "/@Kagemaru0905/works/10", "thumbnail_src": "https://si.imgix.net/f7078a07/uploads/origins/0e186844-551a-4f98-96af-06089f70ab24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b638a8fa43f799ce68074ffed4ee0fb", "thumbnail_srcset": "https://si.imgix.net/f7078a07/uploads/origins/0e186844-551a-4f98-96af-06089f70ab24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b638a8fa43f799ce68074ffed4ee0fb, https://si.imgix.net/f7078a07/uploads/origins/0e186844-551a-4f98-96af-06089f70ab24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a77781de12ba5e334881c09127aff481 2x, https://si.imgix.net/f7078a07/uploads/origins/0e186844-551a-4f98-96af-06089f70ab24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8640e3422c11c9f4c6b73d3acfa4e0f7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nステッカーにしようと思っていて、他のサイトでは画像が小さくて無理と思いこちらでお願いしています。\n\nイラストは\n左側にさくらみこが歩いている後ろに3人の35pがついていく感じでお願いしたいです。\nみこが自信満々に歩いていく感じで、それとともに自信満々に歩いていく35p、普通についていく35p、みこちを心配して不安そうな表情で「大丈夫か？」の看板？(よく35pが持ってる文字書くやつ)を持ってついていく35p、の4人が列になっているイラストでお願いします。\nみこはkagemaru様のアイコンくらいのデフォルメ感が良く、あまり顔がギュッとしてるより少し丸っこい感じが良いです！\n\n大きさは縦30cm、横90cmでお願いしたいのですが大丈夫でしょうか？\n\n\n初めてでどこまでのリクエストをしていいのか分からず、ずうずうしかったらすみません.....", "created_at": "", "completed_at": ""}, {"path": "/@Kagemaru0905/works/9", "thumbnail_src": "https://si.imgix.net/3ec109c8/uploads/origins/bc81938e-9ad5-4984-b9f7-38a0ac877e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c6f71b822543c047023873e950f2cec", "thumbnail_srcset": "https://si.imgix.net/3ec109c8/uploads/origins/bc81938e-9ad5-4984-b9f7-38a0ac877e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c6f71b822543c047023873e950f2cec, https://si.imgix.net/3ec109c8/uploads/origins/bc81938e-9ad5-4984-b9f7-38a0ac877e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adf537ea8a6363265c041a28d5a4f2cd 2x, https://si.imgix.net/3ec109c8/uploads/origins/bc81938e-9ad5-4984-b9f7-38a0ac877e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be3f6908ff3dbbfedb99d359d5420395 3x", "genre": "art", "nsfw": false, "body": "kagemaruさん、こんにちは\n\n以前描かれていた漫画の1コマ目のように、目を閉じて色んなラプくんを妄想しているノエルさんをお願いできますでしょうか。イラストでも漫画形式でも構いません。よろしくお願いいたします。\nhttps://www.pixiv.net/artworks/124609240\n\n【構図】\n左端に目を瞑ってラプくんを妄想するノエルさん（赤たんスタイル）\n残りのスペースでラプくんを3体ほど（リアル絵スタイル）\n\n【詳細】\n① 左側：スト6の不知火舞に会えて感激するラプくん\nセリフ：ラプくん「ままま舞さん！ず、ずっと待ってました…ぼ、ぼく…！」\nご参考：https://youtu.be/I_3ujYb1L_g?t=106\n\n② 真ん中：カステラの箱を持って、ノエルさんの一人称視点で、カステラ食べたいと言ってるラプくん\nセリフ：ラプくん「カステラ食う！カステラ食べたい！」\nご参考：https://youtu.be/OC6CtBTq2Cw?t=20\n\n③ 右側：妹の奏ちゃんからクッキーを箱ごと取り上げてるラプくん\nセリフ：ラプくん「このクッキー俺のー！」\nご参考：https://youtu.be/Zr5tiBWvv4Y?t=5\nhttps://youtu.be/OKlIV9BZxOE?t=125\n\n【髪型・衣装】\n・ノエルさん（赤たんスタイル）は、以前描かれていた下記URLのイラストのまま\nhttps://www.pixiv.net/artworks/124609240\