d18a4296024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73bfe50d7e3c747d1ac25adc70483dc7", "thumbnail_srcset": "https://si.imgix.net/add1164a/uploads/origins/b0cf6d45-6f45-4950-a632-0d18a4296024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73bfe50d7e3c747d1ac25adc70483dc7, https://si.imgix.net/add1164a/uploads/origins/b0cf6d45-6f45-4950-a632-0d18a4296024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9077399a50ddba11e6cb4ff947d9b0ac 2x, https://si.imgix.net/add1164a/uploads/origins/b0cf6d45-6f45-4950-a632-0d18a4296024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebb1fac4aa7d442e8ff58ec686fda651 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nいつも素敵な艦娘のイラストをありがとうございます！\n私も艦娘のイラストをリクエストさせて頂きます！\n\nプライベートビーチで、水着(ビキニ、可能であれば公式のもの)を着たアイオワとサラトガがこちらを覗き込んでいるイラストをお願いします！\n※公式水着：https://twitter.com/apdodlb/status/1155286252825956352?s=20&t=wYrtY3U0d60vjkhaQZRLiQ\n\n座っているこちらを、前屈みや四つん這いのような、谷間が強調されるポーズで覗き込んでいるといった感じでお願いします。\nまた、PCの壁紙に使用したいので、16:9もしくはそれに近いアスペクト比でお願いします。\n\n以上、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@blue_andwhite/works/5", "thumbnail_src": "https://si.imgix.net/3dee127f/uploads/origins/c722e358-3c05-4789-a152-630f8c452bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63ab1e2db968e5ec716804797ccf9441", "thumbnail_srcset": "https://si.imgix.net/3dee127f/uploads/origins/c722e358-3c05-4789-a152-630f8c452bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63ab1e2db968e5ec716804797ccf9441, https://si.imgix.net/3dee127f/uploads/origins/c722e358-3c05-4789-a152-630f8c452bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a0ad60509e6242642fe697e1339240e 2x, https://si.imgix.net/3dee127f/uploads/origins/c722e358-3c05-4789-a152-630f8c452bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d23bbc1885f9aa0ff601ffc0564e8333 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n以前からPixiv等でイラストを拝見しておりました。\n美麗な背景と艦娘の組み合わせを毎回楽しませて頂いております。\n\n此度Skebを始められたとの事でしたので、リクエスト致します。\n\n【キャラクター】\n・艦これの羽黒と神風\n\n【シチュエーション】\n・２人とも学生服姿\n・夕暮れの時間帯、下校中に夕飯の買い物を済ませた後\n・レジ袋orトートバッグの持ち手を２人で片方づつ持ち、並んで歩いているシーン\n・構図などはお任せします。\n\n・もし制服の指定も可能でしたら、\n　実在する「羽黒高校」の制服に似せた感じにして頂けると有難いです。\n・羽黒は冬服に黒ストッキング着用。\n・神風は合服でお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@blue_andwhite/works/4", "thumbnail_src": "https://si.imgix.net/8b25b749/uploads/origins/e8da9b5d-2016-4c52-958d-2d431cb554ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=234689e005d712246f18a1bbf5223b79", "thumbnail_srcset": "https://si.imgix.net/8b25b749/uploads/origins/e8da9b5d-2016-4c52-958d-2d431cb554ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=234689e005d712246f18a1bbf5223b79, https://si.imgix.net/8b25b749/uploads/origins/e8da9b5d-2016-4c52-958d-2d431cb554ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b377166a180259ff60af4b8341c68127 2x, https://si.imgix.net/8b25b749/uploads/origins/e8da9b5d-2016-4c52-958d-2d431cb554ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9301a7507b8811ad1cdb5768dd1ce9b 3x", "genre": "art", "nsfw": false, "body": "blewさんの着衣巨乳が大好きなのでリクエストさせていただきます。\n\nキャラは艦これの飛龍でお願いします。\n\nblewさんの胸大きめな飛龍が好きなのですが、特に爆乳を強調してください。蒼龍や雲龍を越えた鎮守府1位の胸の持ち主のようなイメージで。\n\nいつもの制服で艤装は無し、ただ立ってるだけでも胸の存在感が凄い感じでお願いします。\n表情は自信に満ちた笑顔でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@blue_andwhite/works/3", "thumbnail_src": "https://si.imgix.net/1d46ab9a/uploads/origins/84f43c99-dd71-4936-9c48-41b48c830902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70edc9a71b3703082f1603ae5bf623b5", "thumbnail_srcset": "https://si.imgix.net/1d46ab9a/uploads/origins/84f43c99-dd71-4936-9c48-41b48c830902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70edc9a71b3703082f1603ae5bf623b5, https://si.imgix.net/1d46ab9a/uploads/origins/84f43c99-dd71-4936-9c48-41b48c830902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac352bbb0a89269c351cf00505a8db14 2x, https://si.imgix.net/1d46ab9a/uploads/origins/84f43c99-dd71-4936-9c48-41b48c830902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4535c2ea096c453e6b5c29830b99da7 3x", "genre": "art", "nsfw": false, "body": "blewさん、はじめまして。\nいつも素敵なイラストを楽しましていただいています。\n艦これのヘレナをお願いしたくリクエストさせていただきます。\nメイド服を着て、こちらに微笑んでいる感じでお願いしたいです。\n他のポーズや構図、細かいところはお任せいたします。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@blue_andwhite/works/2", "thumbnail_src": "https://si.imgix.net/f6eadecb/uploads/origins/c71ed19a-3d06-42c7-9dc1-346856156d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78438226be2d19ac164b855369676b8b", "thumbnail_srcset": "https://si.imgix.net/f6eadecb/uploads/origins/c71ed19a-3d06-42c7-9dc1-346856156d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78438226be2d19ac164b855369676b8b, https://si.imgix.net/f6eadecb/uploads/origins/c71ed19a-3d06-42c7-9dc1-346856156d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce970c0fd91cb374d686394cc436ec84 2x, https://si.imgix.net/f6eadecb/uploads/origins/c71ed19a-3d06-42c7-9dc1-346856156d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69fca07b8a6196e46a6d2809deca06d5 3x", "genre": "art", "nsfw": false, "body": "初めまして、さよきちと申します。\n\n可能でしたら、アークナイツよりアシッドドロップをお願いします！\n隠れ巨乳つよめな子だと思ってまして…お胸が強調される構図でどうかお願いします！\n細部の描写や解釈はお任せします。\n\n最後に、宛名とサインをお願いします。\n以上、お気に召しましたらよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@blue_andwhite/works/1", "thumbnail_src": "https://si.imgix.net/d74ba136/uploads/origins/d3392b32-dc1d-4f08-8a8e-a8f56a687652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39577558e9886997cfcf1b2ac612839", "thumbnail_srcset": "https://si.imgix.net/d74ba136/uploads/origins/d3392b32-dc1d-4f08-8a8e-a8f56a687652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39577558e9886997cfcf1b2ac612839, https://si.imgix.net/d74ba136/uploads/origins/d3392b32-dc1d-4f08-8a8e-a8f56a687652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e45db3c9185afd8f4071dc12e40a5682 2x, https://si.imgix.net/d74ba136/uploads/origins/d3392b32-dc1d-4f08-8a8e-a8f56a687652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdf225a1486842b11f9a13a8a481c42d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nいつも魅力的なイラスト楽しませていただいています。（オリジナル、二次創作ともに。特に表情がいいなと思ってます。）\n募集を始められたみたいですので依頼したいと思います。\n\n・艦これの村雨（三越の衣装）\n・一緒にお出かけ後で「今日は帰りたくない」シチュエーションでお願いします。（構図はお任せします）\n・少し恥ずかしそうな表情\n・あとはお任せします。\n・psdで納品いただけると助かります。\n\n以上になります。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}]}