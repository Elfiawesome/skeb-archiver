d-9bd4-1a2ddaab94ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9da47a8bf8a11f6ae89c18df695c41", "thumbnail_srcset": "https://si.imgix.net/8bb3bfa6/uploads/origins/1927a749-2a73-433d-9bd4-1a2ddaab94ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9da47a8bf8a11f6ae89c18df695c41, https://si.imgix.net/8bb3bfa6/uploads/origins/1927a749-2a73-433d-9bd4-1a2ddaab94ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ac363b2420ca4347c6a31d5654538dd 2x, https://si.imgix.net/8bb3bfa6/uploads/origins/1927a749-2a73-433d-9bd4-1a2ddaab94ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f8fab05e70987f5b85321b5cdb28738 3x", "genre": "art", "nsfw": false, "body": "はじめまして。コロナと申します。\n\nTwitterでホロライブ、Gブリちゃんのイラストいつも楽しみに見てます！\n\n今回ご依頼させていただきたいイラストは、Gブリちゃんのイラストです。\n■イラスト内容\nアシダカグモに追われて大ピンチなGブリちゃんを2〜3コマくらいでお願いしたいです！\n可能であればアシダカグモも擬人化して名前も付けてあげてほしいです！\n※ アシダカグモのデザイン等すべてお任せします。\n■入れてほしい要素\n①うわあああああ！のリアクション\n②助けてほしそうにこちらを見るGブリちゃん\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@uryuuminene18/works/4", "thumbnail_src": "https://si.imgix.net/8f754983/uploads/origins/748a0197-3665-4aae-af69-4df4e46dc724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc67243998dd7d6586b1982c292b9004", "thumbnail_srcset": "https://si.imgix.net/8f754983/uploads/origins/748a0197-3665-4aae-af69-4df4e46dc724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc67243998dd7d6586b1982c292b9004, https://si.imgix.net/8f754983/uploads/origins/748a0197-3665-4aae-af69-4df4e46dc724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0303b8c083418b9b5df825287ff1300 2x, https://si.imgix.net/8f754983/uploads/origins/748a0197-3665-4aae-af69-4df4e46dc724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70bac0399d49a3a4445782fb5d6525a9 3x", "genre": "art", "nsfw": false, "body": "始めまして\nｐｉｘｉｖにあった作品で\n歩いていたら足元になにかいた\nの蟻さんの擬人化？の続きで\n左手の掌の上に乗せて右手の人差し指の腹で\n頭を撫でているイラストを描いていただきたいです。", "created_at": "", "completed_at": ""}, {"path": "/@uryuuminene18/works/3", "thumbnail_src": "https://si.imgix.net/2acadd77/uploads/origins/974515c9-ca04-476e-a7cf-b656e80b36c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cedf73e5e9204e4ef69ab93ffcfe80d4", "thumbnail_srcset": "https://si.imgix.net/2acadd77/uploads/origins/974515c9-ca04-476e-a7cf-b656e80b36c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cedf73e5e9204e4ef69ab93ffcfe80d4, https://si.imgix.net/2acadd77/uploads/origins/974515c9-ca04-476e-a7cf-b656e80b36c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4a9cfb4cc51def4f7cd5e2634091001 2x, https://si.imgix.net/2acadd77/uploads/origins/974515c9-ca04-476e-a7cf-b656e80b36c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3272cbc3d2517ea4032746463f1a57cc 3x", "genre": "art", "nsfw": false, "body": "個人VTuber「雲上アイリス (@KumoueIris)」のちびイラストをお願いしたいです。\n\nすべてはお任せ致しますが、可愛い雰囲気だと嬉しいです。\n\nいただいたイラストはサムネ等に使用したいため\nキャラクターと背景がわかれているpsdファイルでいただけると嬉しいです。\n\nよろしくお願い致します。\n\nhttps://twitter.com/KumoueIris/status/1545366213953732609?s=20&t=Ut-NjvlOtgCVXJ5Cd3lqrg", "created_at": "", "completed_at": ""}, {"path": "/@uryuuminene18/works/2", "thumbnail_src": "https://si.imgix.net/00a1bca6/uploads/origins/dcfd3483-38ee-46a8-bf49-ffc9cb4a2f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=572d4d6d3b11dc580ba7951b359a78da", "thumbnail_srcset": "https://si.imgix.net/00a1bca6/uploads/origins/dcfd3483-38ee-46a8-bf49-ffc9cb4a2f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=572d4d6d3b11dc580ba7951b359a78da, https://si.imgix.net/00a1bca6/uploads/origins/dcfd3483-38ee-46a8-bf49-ffc9cb4a2f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a5ddeb94f2e3e5c30201adf9ecd444d 2x, https://si.imgix.net/00a1bc