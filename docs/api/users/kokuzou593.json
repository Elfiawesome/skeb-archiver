ompleted_at": ""}, {"path": "/@kokuzou593/works/170", "thumbnail_src": "https://si.imgix.net/25cb96db/uploads/origins/f62653d1-02dc-4551-917f-1b76440e936a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3beda19a1d6a5de4a4f17886b6ed6b4e", "thumbnail_srcset": "https://si.imgix.net/25cb96db/uploads/origins/f62653d1-02dc-4551-917f-1b76440e936a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3beda19a1d6a5de4a4f17886b6ed6b4e, https://si.imgix.net/25cb96db/uploads/origins/f62653d1-02dc-4551-917f-1b76440e936a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9ba62e70fd4cdc35d5f80db15189a8a 2x, https://si.imgix.net/25cb96db/uploads/origins/f62653d1-02dc-4551-917f-1b76440e936a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=645933e2216c61072edb90fd90a1102d 3x", "genre": "art", "nsfw": false, "body": "Hello\nI really love your art style and would like to request a drawing of Moka Akashiya from Rosario + Vampire. I would like her to be in her vampire form (White hair with red eyes).\nFor the scenario I would like her to be in workout clothes wiping sweat of her body with a towel.\nSomething similar to your previous work in the reference.\nThanks for your consideration\n\nhttps://x.com/kokuzou593/status/1561322018674380803/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@kokuzou593/works/169", "thumbnail_src": "https://si.imgix.net/539c8e86/uploads/origins/bdf24175-6b29-4e3f-a893-3dfb60443f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=454ca4878d745015e6a88b87894bb194", "thumbnail_srcset": "https://si.imgix.net/539c8e86/uploads/origins/bdf24175-6b29-4e3f-a893-3dfb60443f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=454