-45cd-8e73-9826f04445ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7306db9bffd70cd985df8aa808257566, https://si.imgix.net/79f6ab08/uploads/origins/99bdb0c1-9b5a-45cd-8e73-9826f04445ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5925946490c0182de71bfd5f3879aa10 2x, https://si.imgix.net/79f6ab08/uploads/origins/99bdb0c1-9b5a-45cd-8e73-9826f04445ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2147308f88966466c9bbff94dc0fbeb 3x", "genre": "art", "nsfw": false, "body": "魚の「鯖（サバ）」をリクエストします。", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/8", "thumbnail_src": "https://si.imgix.net/fbb5cd0e/uploads/origins/a1d7cc91-1f4a-4a7b-b964-2d85b1e7ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f81a68027a6080834014cbc52272ce35", "thumbnail_srcset": "https://si.imgix.net/fbb5cd0e/uploads/origins/a1d7cc91-1f4a-4a7b-b964-2d85b1e7ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f81a68027a6080834014cbc52272ce35, https://si.imgix.net/fbb5cd0e/uploads/origins/a1d7cc91-1f4a-4a7b-b964-2d85b1e7ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=382dfa3d2306e4df710fcbe84dc48250 2x, https://si.imgix.net/fbb5cd0e/uploads/origins/a1d7cc91-1f4a-4a7b-b964-2d85b1e7ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14c91b9c257276d4c1d6891bb9fe9d7d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n艶感のある魚介イラストに心打たれたのでリクエストさせていただきます！\n\n描いていただきたいのはサメです！イメージとしてはホオジロザメですが、描きやすければ他の種類でも大丈夫です！\nあと、可能であれば口を開けて歯が見えてると嬉しいです\n\n\n描いていただいたイラストはアイコンなど個人的に使用させていただくので、ご了承ください\n何卒よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/7", "thumbnail_src": "https://si.imgix.net/1c253658/uploads/origins/e6c68ed5-d8f1-428e-a372-8fabb454d963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3cdebea9c93ba37a9787e9a63a9014", "thumbnail_srcset": "https://si.imgix.net/1c253658/uploads/origins/e6c68ed5-d8f1-428e-a372-8fabb454d963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3cdebea9c93ba37a9787e9a63a9014, https://si.imgix.net/1c253658/uploads/origins/e6c68ed5-d8f1-428e-a372-8fabb454d963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8987bb7c5f63b3642dc7070aabb9883d 2x, https://si.imgix.net/1c253658/uploads/origins/e6c68ed5-d8f1-428e-a372-8fabb454d963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3745ca277b6586f3ee96083a9da88a69 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの魚のイラストが大好きです！オールフィッシュを描いてもらえませんか？魚のリクエストばかりで面白いので、私も参加したいと思いました。背景は透明のままでお願いします。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/6", "thumbnail_src": "https://si.imgix.net/07490917/uploads/origins/fb822900-b59d-471e-b854-6eaec1e65735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b65e9ac947dc5bebe7382ff539218ec", "thumbnail_srcset": "https://si.imgix.net/07490917/uploads/origins/fb822900-b59d-471e-b854-6eaec1e65735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b65e9ac947dc5bebe7382ff539218ec, https://si.imgix.net/07490917/uploads/origins/fb822900-b59d-471e-b854-6eaec1e65735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=730c9f5885f33550598039e33f6224d5 2x, https://si.imgix.net/07490917/uploads/origins/fb822900-b59d-471e-b854-6eaec1e65735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e68b82b8ab506f1f0b1849c837e5d7c 3x", "genre": "art", "nsfw": false, "body": "マンボウ", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/5", "thumbnail_src": "https://si.imgix.net/2b0383be/uploads/origins/97be873d-246d-4b37-b028-b1b5fca9ca91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b337ccdc2978d5a71f83505585b9297b", "thumbnail_srcset": "https://si.imgix.net/2b0383be/uploads/origins/97be873d-246d-4b37-b028-b1b5fca9ca91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b337ccdc2978d5a71f83505585b9297b, https://si.imgix.net/2b0383be/uploads/origins/97be873d-246d-4b37-b028-b1b5fca9ca91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d62baba3f47171b9ef7298cf5fd79e9 2x, https://si.imgix.net/2b0383be/uploads/origins/97be873d-246d-4b37-b028-b1b5fca9ca91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=840bfc8b60d962cea9733faf0db307ed 3x", "genre": "art", "nsfw": false, "body": "緑魔キャロラインさん\n\nはじめまして。イシダイのイラストから興味をもったのでリクエストを送付させて頂きます。\nご検討頂けますと幸いです。\n\nズワイガニをお願いします。\n\n上からの構図（背中が良く見える）で、ハサミは開いた状態\n脚の状態は特に指定なし\n\n使用予定：SNSや壁紙に使用させて頂きたいと思います。", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/4", "thumbnail_src": "https://si.imgix.net/f1e7daab/uploads/origins/1a93de82-b414-46c6-a518-da2158805df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8216c3166241446ddd301688ca5675e", "thumbnail_srcset": "https://si.imgix.net/f1e7daab/uploads/origins/1a93de82-b414-46c6-a518-da2158805df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8216c3166241446ddd301688ca5675e, https://si.imgix.net/f1e7daab/uploads/origins/1a93de82-b414-46c6-a518-da2158805df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b606d1d5c9021ea611924fa29d1a2944 2x, https://si.imgix.net/f1e7daab/uploads/origins/1a93de82-b414-46c6-a518-da2158805df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa7346e5eae36957f8beb2adabb1d294 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n新着一覧でお魚描いてらっしゃるの見かけたので、私も描いて欲しいです！\n\n「ビンナガマグロ」をお願いします。\nカツオくらい小さなマグロで、よく寿司ネタやツナ缶の材料として食用されています。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/3", "thumbnail_src": "https://si.imgix.net/a74614df/uploads/origins/3d5e10e8-4b92-4c9e-94db-1e8909520cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a8cd8a95c37a3b6d2d1a22a3bfab3e0", "thumbnail_srcset": "https://si.imgix.net/a74614df/uploads/origins/3d5e10e8-4b92-4c9e-94db-1e8909520cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a8cd8a95c37a3b6d2d1a22a3bfab3e0, https://si.imgix.net/a74614df/uploads/origins/3d5e10e8-4b92-4c9e-94db-1e8909520cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=486994f1022d41b79ba2daf4b2d756e6 2x, https://si.imgix.net/a74614df/uploads/origins/3d5e10e8-4b92-4c9e-94db-1e8909520cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7f06703e83451d10d17a10a1b360ee7 3x", "genre": "art", "nsfw": false, "body": "お魚系が流行ってるので\nイシダイをお願いします。\n黒と白のしま模様なので背景に色付けて貰えると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/2", "thumbnail_src": "https://si.imgix.net/308c1258/uploads/origins/9e1f9802-9646-41ff-a4d8-b669435ed707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61011d32772e0cdecc466f8550653cfe", "thumbnail_srcset": "https://si.imgix.net/308c1258/uploads/origins/9e1f9802-9646-41ff-a4d8-b669435ed707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61011d32772e0cdecc466f8550653cfe, https://si.imgix.net/308c1258/uploads/origins/9e1f9802-9646-41ff-a4d8-b669435ed707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1082543987c33aed7c12d3ae37b6f8cc 2x, https://si.imgix.net/308c1258/uploads/origins/9e1f9802-9646-41ff-a4d8-b669435ed707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3be8ba7e18a1ec76b49d324e2f3f6962 3x", "genre": "art", "nsfw": false, "body": "緑魔キャロライン先生\n\nXを見ていたら、リアルで味のある魚介類のイラストが目に止まり、\nぜひイラストをお願いしたいと思い、リクエストを送らせていただきます。\n\n・書いていただきたい魚介類\nイセエビ\n\n・書いていただきたいイメージ\n先生にお任せいたします！\n\n・使用用途\n私自身の個人的な利用（モバイルとかPCの壁紙、切り抜き動画内の素材）\n推しのVtuberの配信活動等での利用（配信のサムネイル、X等での利用）\n\n推しのVtuberさんが、たまに「イセエビ食べたいな～」と言っているので、\nせめてイラストの中でも実現したいと思っております。\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@midorimacarol/works/1", "thumbnail_src": "https://si.imgix.net/839dfd3a/uploads/origins/3312ea8e-4adf-42d5-a231-be172bf43f41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f0b379e40b27238e1d4f509f139a5f", "thumbnail_srcset": "https://si.imgix.net/839dfd3a/uploads/origins/3312ea8e-4adf-42d5-a231-be172bf43f41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f0b379e40b27238e1d4f509f139a5f, https://si.imgix.net/839dfd3a/uploads/origins/3312ea8e-4adf-42d5-a231-be172bf43f41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83ddddcddb31c993685797ea09c0f14b 2x, https://si.imgix.net/839dfd3a/uploads/origins/3312ea8e-4adf-42d5-a231-be172bf43f41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c6f4714b475fafae2b78f8766b9038d 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n魚のイラストが欲しいと思ったその〝瞬間〟\n緑魔キャロライン様のイラストが、目に止まりぜひともお願いしたいと思いまして、リクエストをさせていただきました。 \n\n描いて頂きたい魚は【カサゴ】です\nまた、背景透過もいただけると助かります。何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}