おける純粋な愛と幸福 ;)\nそれがアイデアです、それが実現できることを願っています。 あなたの作品が大好きです！ ゾンサガコンテンツをありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@themanyoukilled/works/24", "thumbnail_src": "https://si.imgix.net/9b77ec75/uploads/origins/859f267e-11e7-473c-857d-fcc4c75c5815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e1d87873e242840221afcdd2016e10e", "thumbnail_srcset": "https://si.imgix.net/9b77ec75/uploads/origins/859f267e-11e7-473c-857d-fcc4c75c5815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e1d87873e242840221afcdd2016e10e, https://si.imgix.net/9b77ec75/uploads/origins/859f267e-11e7-473c-857d-fcc4c75c5815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fef358fd6ce7d0da9bdd4e33f254c4aa 2x, https://si.imgix.net/9b77ec75/uploads/origins/859f267e-11e7-473c-857d-fcc4c75c5815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b69b651b087576a6f98fa4de3630bd2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@themanyoukilled/works/23", "thumbnail_src": "https://si.imgix.net/b9715b96/uploads/origins/a1678615-675c-4ba8-975e-c37bc6ac22e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80c89a20f40c1e84224f67c408d0cbc", "thumbnail_srcset": "https://si.imgix.net/b9715b96/uploads/origins/a1678615-675c-4ba8-975e-c37bc6ac22e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80c89a20f40c1e84224f67c408d0cbc, https://si.imgix.net/b9715b96/uploads/origins/a1678615-675c-4ba8-975e-c37bc6ac22e1?bg=%23fff&auto=format%2Ccompre