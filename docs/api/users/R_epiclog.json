/uploads/origins/7c456155-2bf0-42f4-8e5b-7259afd95e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a13b1bbf332ce259da3f8518b07a2f16", "thumbnail_srcset": "https://si.imgix.net/ab81316e/uploads/origins/7c456155-2bf0-42f4-8e5b-7259afd95e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a13b1bbf332ce259da3f8518b07a2f16, https://si.imgix.net/ab81316e/uploads/origins/7c456155-2bf0-42f4-8e5b-7259afd95e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f52c3b3eaaf5cd46c33fedf4d3dde755 2x, https://si.imgix.net/ab81316e/uploads/origins/7c456155-2bf0-42f4-8e5b-7259afd95e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3790d0c8893ad2568289cc0cea822047 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@R_epiclog/works/48", "thumbnail_src": "https://si.imgix.net/f6198d39/uploads/origins/55476732-44a1-4e8b-bfac-ea1e5e9553c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=075bcd77ee7ad2fcde6b24416b7e6048", "thumbnail_srcset": "https://si.imgix.net/f6198d39/uploads/origins/55476732-44a1-4e8b-bfac-ea1e5e9553c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=075bcd77ee7ad2fcde6b24416b7e6048, https://si.imgix.net/f6198d39/uploads/origins/55476732-44a1-4e8b-bfac-ea1e5e9553c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89f64edbfa437daf28f9b29d877639d9 2x, https://si.imgix.net/f6198d39/uploads/origins/55476732-44a1-4e8b-bfac-ea1e5e9553c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f89de8af843f7fbe929b36e0bbb1236 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@R_epiclog/works/47", "thumbnail_src": "https://si.imgix.net/efe547ab/uploads/origins/81b23bd2-a7ec-44c9-9ccd-5f5ad8ff368e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b6805aba0b7aefbc0c4a2f103b0701", "thumbnail_srcset": "https://si.imgix.net/efe547ab/uploads/origins/81b23bd2-a7ec-44c9-9ccd-5f5ad8ff368e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b6805aba0b7aefbc0c4a2f103b0701, https://si.imgix.net/efe547ab/uploads/origins/81b23bd2-a7ec-44c9-9ccd-5f5ad8ff368e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0ba17cdad0235e1773ec553a70ecfea 2x, https://si.imgix.net/efe547ab/uploads/origins/81b23bd2-a7ec-44c9-9ccd-5f5ad8ff368e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32928a1c141b64ce58e89a71642f644f 3x", "genre": "art", "nsfw": true, "body": "高垣楓さんが壁穴から飛び出た肉棒の中から恋人のプロデューサーのおちんちんを探すシチュエーションをお願いします。\n\n最初は手で触ったり臭い嗅いだりするもわからないので、フェラし始めるようにお願いします。楓さんはフェラ上手くて次々とイカせるようにお願いします。フェラしながらこのチンポ気持ち良さそうとか値踏みするようにお願いします。途中で精子が服に掛かって下着姿になるようにお願いします。\n\nプロデューサーのチンポは分かったものの、間違えたら罰ゲームが気になり一番大きいチンポ咥えて、これが彼氏チンポですとわざと間違えるようにお願いします。\n\n罰ゲームで選んだデカマラと生ハメをプロデューサーに見せつけるようにお願いします。いやらしい雌の姿を沢山見せつけちゃようにお願いします。\n\n犯してる男がイキそうになると足で身体を挟み込み楓さんから中出しおねだりするようにお願いします。イク時に選ばれなかったチンポ達から楓さんに大量ぶっかけしちゃうようにお願いします。プロデューサーもしちゃうようにお願いします。最後にハメたチンポの感想言うようにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@R_epiclog/works/46", "thumbnail_src": "https://si.imgix.net/6c9570a4/uploads/origins/dc70cad5-089f-409d-b802-aeadd0351a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae8179927c46659e4dbf0150a886cbe", "thumbnail_srcset": "https://si.imgix.net/6c9570a4/uploads/origins/dc70cad5-089f-409d-b802-aeadd0351a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae8179927c46659e4dbf0150a886cbe, https://si.imgix.net/6c9570a4/uploads/origins/dc70cad5-089f-409d-b802-aeadd0351a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0b10acb769708660b1c72b014fc441b 2x, https://si.imgix.net/6c9570a4/uploads/origins/dc70cad5-089f-409d-b802-aeadd0351a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68bef74ab7fb2db14037189fb2d37072 3x", "genre": "art", "nsfw": true, "body": "(〆切超過でしたが再送させていただきます)\nデレマスの及川雫ちゃんをお願いしたいです。仕上げはモノクロで希望します。\n先生が以前描いていたAV撮影のシチュがとても好きなので、同様のシチュをお願いしたいです。\nhttps://skeb.jp/@R_epiclog/works/6\n\n基本的にはお任せしますが、こちらのような腕を掴むロールスロイス(膝立ちバック)で、おっぱいをぶるんぶるん揺らしまくる構図を入れて欲しいです。https://twitter.com/_anannex/status/1520163907725570049?\n\n雫ちゃんは激しくイカされてる様子で、下品なアヘ顔を晒していると嬉しいです。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@R_epiclog/works/45", "thumbnail_src": "https://si.imgix.net/03d1e393/uploads/origins/5e120db2-cf18-4892-99b6-a3e86d1088aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26379a5b028d006eae016035e1687c0c", "thumbnail_srcset": "https://si.imgix.net/03d1e393/uploads/origins/5e120db2-cf18-4892-99b6-a3e86d1088aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26379a5b028d006eae016035e1687c0c, https://si.imgix.net/03d1e393/uploads/origins/5e120db2-cf18-4892-99b6-a3e86d1088aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=642abf69a70a107a3b8ddd847b8418c7 2x, https://si.imgix.net/03d1e393/uploads/origins/5e120db2-cf18-4892-99b6-a3e86d1088aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cr