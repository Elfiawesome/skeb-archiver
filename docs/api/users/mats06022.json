x.net/db27aed4/uploads/origins/af98a6d6-d2f3-4596-bab3-ec92ff926328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e7274a08bfa2b2f8d0ae98be3acb873", "thumbnail_srcset": "https://si.imgix.net/db27aed4/uploads/origins/af98a6d6-d2f3-4596-bab3-ec92ff926328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e7274a08bfa2b2f8d0ae98be3acb873, https://si.imgix.net/db27aed4/uploads/origins/af98a6d6-d2f3-4596-bab3-ec92ff926328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b30856350bce4e6e4cc298a50c66f55 2x, https://si.imgix.net/db27aed4/uploads/origins/af98a6d6-d2f3-4596-bab3-ec92ff926328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a31d6171289452dd12f93daaf50f4c48 3x", "genre": "art", "nsfw": true, "body": "こんにちは、松吉さん！あなたの作品はとても表情豊かですね。\n字：高石 タケル X 一乗寺 賢。\n参考文献はクラウドリンクにあります。\nシチュエーション: タケルは賢と乱暴なセックスをしている。賢はそれをしたくはないが、嫌とも言わず、抵抗もせず、逃げようともしない。賢はしたくないのに快感を感じている。賢はタケルに好きなようにさせている。(2人は数年間、有害な関係にある。) タケルは楽しんでおり、微妙な微笑みを浮かべている。賢は呻いているが、目はほとんど虚ろだ。\nポーズと構図は自由です。お任せします。\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-tDwQn_C9PMn7f2XN1m6lMTSwak02tIP?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mats06022/works/21", "thumbnail_src": "https://si.imgix.net/8e41a72e/uploads/origins/0a2ddb35-1982-4983-bda4-0f122207d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=840390c8c9bd66f01016aa474bb47559", "thumbnail_srcset": "https://si.imgix.net/8e41a72e/uploads/origins/0a2ddb35-1982-4983-bda4-0f122207d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=840390c8c9bd66f01016aa474bb47559, https://si.imgix.net/8e41a72e/uploads/origins/0a2ddb35-1982-4983-bda4-0f122207d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b84c9acdf9224ea22eda7bd04e74e4f6 2x, https://si.imgix.net/8e41a72e/uploads/origins/0a2ddb35-1982-4983-bda4-0f122207d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21d41b245a946bb99ada82f44915aec0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mats06022/works/20", "thumbnail_src": "https://si.imgix.net/7f1469da/uploads/origins/ef648da4-9f61-4447-860c-45f76d0714ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7f92a51af595de3ee00bdfd9c1053b", "thumbnail_srcset": "https://si.imgix.net/7f1469da/uploads/origins/ef648da4-9f61-4447-860c-45f76d0714ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7f92a51af595de3ee00bdfd9c1053b, https://si.imgix.net/7f1469da/uploads/origins/ef648da4-9f61-4447-860c-45f76d0714ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f76bc513521c6653411d4c03d9e4984 2x, https://si.imgix.net/7f1469da/uploads/origins/ef648da4-9f61-4447-860c-45f76d0714ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2f68be8c2982e43204e461226315ac4 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの絵がとても素敵だったので、私のOCで試してみたくなりました :D\n\nこれは私の息子、レオとレド。この二人は親友で恋人同士。\n\nレオ: https://drive.google.com/drive/folders/1fUFEgBsf2hPieALisuLUyyjIW5SuHSox?usp=sharing\n\nレド： https://drive.google.com/drive/folders/15rZe84kIdeL5GfPGK1w9hT6Rpz0iAoWu?usp=sharing\n\n二人のセックスを描いてほしい。レオがレッドの上に乗っている。レオは太くて割礼されたペニスを持っていて、レドは細くて長い割礼されていないペニスを持っている。\n\n好きな体位を選んでください！この二人にぴったりだと思うものなら何でもOK :3\n\n変更も修正もご自由にどうぞ！ :D\n\nありがとうございます :D", "created_at": "", "completed_at": ""}, {"path": "/@mats06022/works/19", "thumbnail_src": "https://si.imgix.net/0a0a0ac6/uploads/origins/25c9b90a-f7a3-4d71-9319-07bea5a8646f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=175b79553243f2541a08d2825159bc0f", "thumbnail_srcset": "https://si.imgix.net/0a0a0ac6/uploads/origins/25c9b90a-f7a3-4d71-9319-07bea5a8646f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=175b79553243f2541a08d2825159bc0f, https://si.imgix.net/0a0a0ac6/uploads/origins/25c9b90a-f7a3-4d71-9319-07bea5a8646f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c42627fdf3087b1646bce6b99ddc656 2x, https://si.imgix.net/0a0a0ac6/uploads/origins/25c9b90a-f7a3-4d71-9319-07bea5a8646f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a6c17ec902547a5ba247c5366f9c221 3x", "genre": "art", "nsfw": true, "body": "どうもこんにちは。松吉さんの素敵な子たちに一目惚れしました。\nぜひ以下のリクエストをさせていただきたいです。\n\n松吉くん×昴くんの正常位セックス\n場所　松吉くんの自室ベッド\n服装　全裸\n\n【詳細】\n・ベロチューディープキスしながらちんちんしごいてあげる\n・急いで脱ぎ散らかしたのか周囲に服が乱雑に散乱\n・使用済みゴムとティッシュ散らばってる（ゴムが切れたから生でやっている）\n・ティッシュ全部使い切ったので昴くんのお腹は精液でべちょべちょ\n・射精差分と射精した後のちんちんがしぼんだバージョンの差分", "created_at": "", "completed_at": ""}, {"path": "/@mats06022/works/18", "thumbnail_src": "https://si.imgix.net/fc66b8ff/uploads/origins/7bc98c00-a856-4d83-82b4-1b4ae8174a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3c0284566751566ea814520ed40b9b6", "thumbnail_srcset": "https://si.imgix.net/fc66b8ff/uploads/origins/7bc98c00-a856-4d83-82b4-1b4ae8174a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3c0284566751566ea814520ed40b9b6, https://si.imgix.net/fc66b8ff/uploads/origins/7bc98c00-a856-4d83-82b4-1b4ae8174a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61e7acfebf433170312edbe9ed507f32 2x, https://si.imgix.net/fc66b8ff/uploads/origins/7bc98c00-a856-4d83-82b4-1b4ae8174a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=594b2ef23caf81eb2bf6ab393464bdf3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mats06022/works/17", "thumbnail_src": "https://si.imgix.net/e33a2425/uploads/origins/241d290d-bd50-4663-b727-a5a4a999a431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd98d319bec60db20c071767227d69e3", "thumbnail_srcset": "https://si.imgix.net/e33a2425/uploads/origins/241d290d-bd50-4663-b727-a5a4a999a431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd98d319bec60db20c071767227d69e3, https://si.imgix.net/e33a2425/uploads/origins/241d290d-bd50-4663-b727-a5a4a999a431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b27fe6390bf424c84daef958f46c19e1 2x, https://si.imgix.net/e33a2425/uploads/origins/241d290d-bd50-4663-b727-a5a4a999a431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dd0a39f6d9433b8dc882f3e8d428847 3x", "genre": "art", "nsfw": true, "body": "ペアのキャラクターシート、ペアのアンドロイドが欲しいんだ。\n\n一人はエルソードのユノを、もう一人は同じくエルソードのマヤをベースにしている。\n\nユノ(緑髪の男性アンドロイド): https://elwiki.net/wiki/images/a/a7/Yuno.png\n\nマヤ（緑髪の女性アンドロイド）：https://elwiki.net/wiki/images/e/e5/CODE-Maya_Portrait.png\n\n二人とも全裸で、機械的な性器を丸出しにしている。当該性器は、ビデオにあったこのようなデザインに似ている（一例として）: https://rule34.us/index.php?r=posts/view&id=4441577\n\nしかし、ここでは、彼らは通常よりもはるかに「人間」に見える（手始めに、女性のアンドロイドに彼女の男性の相手のような口を与える）ので、他の部分と一緒に人間のようなポルポーションを持っています。男性のアンドロイドは女性のアンドロイドより少し背が高い。\n\n首から足にかけての皮膚はほとんど半透明で、金属的な筋肉の構造を覆っている。https://files.catbox.moe/h63e6v.webp\n\nこれまでの説明の助けになれば幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@mats06022/works/16", "thumbnail_src": "https://si.imgix.net/282c1440/uploads/origins/0a917156-e800-4880-a101-dc09