446d277a-b403-49a9-b4f6-0ee65407e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c72eb25a74c6947ff530b8f1c0a9decc", "thumbnail_srcset": "https://si.imgix.net/50f2d5d2/uploads/origins/446d277a-b403-49a9-b4f6-0ee65407e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c72eb25a74c6947ff530b8f1c0a9decc, https://si.imgix.net/50f2d5d2/uploads/origins/446d277a-b403-49a9-b4f6-0ee65407e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f95139aeb71c8fe792fcc529df28d81 2x, https://si.imgix.net/50f2d5d2/uploads/origins/446d277a-b403-49a9-b4f6-0ee65407e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d90f40948096586a953f1056c9165b3f 3x", "genre": "art", "nsfw": true, "body": "作品\nファイアーエムブレムヒーローズ・聖戦の系譜\n\n登場キャラと衣装\nセリス（FEH花婿衣装）とヒルダ（風花雪月でなく聖戦のヒルダ・FEHティニーが着てる花嫁衣裳で髪型もリンク先のティニーと同じ）\nそれぞれの衣装は下半身側は省略しても構いませんが上半身は出来るだけそのままでお願いします\nhttps://dengekionline.com/article/images/202505/42153/371914\nhttp://fire-emblem-matome.com/66241\nhttps://dengekionline.com/article/images/202505/42153/371922\nロキ（杖のみ）\nhttps://www.4gamer.net/games/369/G036904/20240430007/\n\n内容\nロキによって催眠状態に陥り心から互いを愛し合わされてしまったセリスとヒルダが結婚式を挙げさせられ駅弁か対面立位で抱き合いながらのキスハメ\nhttps://www.pixiv.net/artworks/122290333\nhttps://www.pixiv.net/artworks/100254542\nロキが二人を見てるような視点で画面の手前側にピンク色の魔力を纏ったロキの杖が描かれ\nセリスとヒルダは正気を失ってる表現としてピンクの魔力がまとわりついてたり目にハイライトなし\n\nhttps://dengekionline.com/article/202505/42153", "created_at": "", "completed_at": ""}, {"path": "/@Sign_horn/works/88", "thumbnail_src": "https://si.imgix.net/e14a6cab/uploads/origins/13814c87-979a-4a29-a001-74addcd5b834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6356d2465488568e37b0b18947936a7", "thumbnail_srcset": "https://si.imgix.net/e14a6cab/uploads/origins/13814c87-979a-4a29-a001-74addcd5b834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr