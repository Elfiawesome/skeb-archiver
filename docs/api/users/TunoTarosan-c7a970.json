f16-4dc0-a317-3a09dbcd8b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb4f543d0c2062bb470b32851d26315d 3x", "genre": "art", "nsfw": false, "body": "私がVRChatで使っているアバターを描いていただきたいです。\n\n目をジト目に描いていただけるとありがたいです。\n構図などはおまかせします。\n\nアバターの見た目は資料URLをご参考ください。\n\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1wa7mnZ4JNKtMVYoKOPJ58S4YZhAV7--m?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@TunoTarosan/works/8", "thumbnail_src": "https://si.imgix.net/cda98b5c/uploads/origins/1af2eb0f-3702-4029-af46-5ce6a8b08b92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490edcbaacf700e87878863d0c9456ce", "thumbnail_srcset": "https://si.imgix.net/cda98b5c/uploads/origins/1af2eb0f-3702-4029-af46-5ce6a8b08b92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490edcbaacf700e87878863d0c9456ce, https://si.imgix.net/cda98b5c/uploads/origins/1af2eb0f-3702-4029-af46-5ce6a8b08b92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ddfeb047e6c9e9069fa25a9cdf45ca8 2x, https://si.imgix.net/cda98b5c/uploads/origins/1af2eb0f-3702-4029-af46-5ce6a8b08b92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd9059ba451dceb9d910b0721ee28f95 3x", "genre": "art", "nsfw": false, "body": "こんばんは\nVRCで使用しているアバターを描いて頂きたいです\nイヤリング以外の服等は自由に描いてください\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1VrdosnVvU5k6A5TpHgWcY2QTR4fd0qZQ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@TunoTarosan/works/7", "thumbnail_src": "https://si.imgix.net/b0ee2b3e/uploads/origins/7ec69b37-f814-4d8a-8d75-a5ce89442864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b1003b86267dd0db48ef20d37ca6bcc", "thumbnail_srcset": "https://si.imgix.net/b0ee2b3e/uploads/origins/7ec69b37-f814-4d8a-8d75-a5ce89442864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b1003b86267dd0db48ef20d37ca6bcc, https://si.imgix.n