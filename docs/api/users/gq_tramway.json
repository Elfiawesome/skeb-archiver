%2Ccenter&txtsize=30&txt=PRIVATE&s=c9b37b1690c96f8169df71aee12e449f 2x, https://si.imgix.net/976010a0/uploads/origins/9f6d3b48-63f5-41c7-bc98-85536b4aa7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7072f24ed052fc8ea44ceca16a9c90c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gq_tramway/works/15", "thumbnail_src": "https://si.imgix.net/f6ee425d/uploads/origins/2fba37d7-494d-4275-af12-ab3d5b2f2a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c7a616c13ddb3618bc01b26f118a79", "thumbnail_srcset": "https://si.imgix.net/f6ee425d/uploads/origins/2fba37d7-494d-4275-af12-ab3d5b2f2a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c7a616c13ddb3618bc01b26f118a79, https://si.imgix.net/f6ee425d/uploads/origins/2fba37d7-494d-4275-af12-ab3d5b2f2a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2a814b9bd03c17ac2cf26496e8a5868 2x, https://si.imgix.net/f6ee425d/uploads/origins/2fba37d7-494d-4275-af12-ab3d5b2f2a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83207bfc1041507ac05479f53cfd1c3c 3x", "genre": "art", "nsfw": false, "body": "URLのバイクに跨ってる黒髪きつね娘さんを描いて頂ければと思います。\n小柄で、胸はかなり控え目です。笑顔が似合う癒し系です。ほのぼの。\n前回は通常等身だったので今回はSDで描いて欲しいです。\nデザインとしては荷物を積載してるバイクに跨ってこっちを向いて笑顔になってるやつです。\n構図が無理でなければ絶対領域が描写されてると嬉しいです。\nバイクはトライアンフのボンネビルT120というバイクでお願いします。\nhttps://drive.google.com/drive/folders/1I62Ou07pIc3YpLxwpgOQtmB9JpDfs74U?usp=sharing\n用途としてはアクキーにしてバイクのバッグに取り付けたり、小さいアクスタを作って旅先で一緒に写真を撮ったりしたいなと…\nもしよろしければ考えて頂ければと思います。\n\nhttps://drive.google.com/drive/folders/1Pq3mBZ6NhLm4RpxD4RZMFycTWtk0ycoX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gq_tramway/works/14", "thumbnail_src": "https://si.imgix.net/f3d4218a/uploads/origins/b6310a8b-3d17-4e80-9dc7-b50d3a78edc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd6d5c722d9c54f7ec932b08162f0332", "thumbnail_srcset": "https://si.imgix.net/f3d4218a/uploads/origins/b6310a8b-3d17-4e80-9dc7-b50d3a78edc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd6d5c722d9c54f7ec932b08162f0332, https://si.imgix.net/f3d4218a/uploads/origins/b6310a8b-3d17-4e80-9dc7-b50d3a78edc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7db094889af364389b9190dea82ab87b 2x, https://si.imgix.net/f3d4218a/uploads/origins/b6310a8b-3d17-4e80-9dc7-b50d3a78edc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a76b7b9a4cdf0d70e4d299f6ffe935b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gq_tramway/works/13", "thumbnail_src": "https://si.imgix.net/47b4765b/uploads/origins/6ea4752e-fdc7-417d-80d0-79423b4299d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aa3dd1a1df84b8fbbfba6b6a211d6b8", "thumbnail_srcset": "https://si.imgix.net/47b4765b/uploads/origins/6ea4752e-fdc7-417d-80d0-79423b4299d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aa3dd1a1df84b8fbbfba6b6a211d6b8, https://si.imgix.net/47b4765b/uploads/origins/6ea4752e-fdc7-417d-80d0-79423b4299d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f56a6deee9da3dec9263f323a5c3c60e 2x, https://si.imgix.net/47b4765b/uploads/origins/6ea4752e-fdc7-417d-80d0-79423b4299d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ec4f93368276f6f6ca380ad2d980f7c 3x", "genre": "art", "nsfw": true, "body": "群鳩電軌さん、以前は素敵なイラストをありがとうございました。\n\n今回オリキャラのミズダコの女の子をお願いしたく、タコさんの作画に詳しい群鳩電軌さんにご依頼させていただきます。\n\nキャラ資料\nhttps://drive.google.com/drive/folders/1AEmjZ7J9TUzfe9fS2CZpyU67XJVhMl1q?usp=drive_link\n\n器用な多足を生かして料理をしているシーンをお願いします。\n陸上では長い間立っていられないので、台所に貼りついて調理しています。\nタコらしい吸盤の動きや足の粘液を表現していただけると嬉しいです。\n（以前描いていただいたハーピーちゃんが働くカフェに連れてこられて働かされているという世界観です）\nhttps://drive.google.com/file/d/1-OjD6GWb0rEE9fQZ_g1WHmbd1YGNNZtz/view?usp=drive_link\n落書きイメージを参考にしていただければと思いますが、イメージと同じではなく群鳩電軌さんのお任せでお願いしたいです!\n\n肌色多めで粘液あったりするので一応NSFTタグ付させていただきます...!\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@gq_tramway/works/12", "thumbnail_src": "https://si.imgix.net/e27d428b/uploads/origins/516d7887-f36e-44cd-ba0d-a69762a958cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64942ae3ea6a4a2bc66031d35d580ddf", "thumbnail_srcset": "https://si.imgix.net/e27d428b/uploads/origins/516d7887-f36e-44cd-ba0d-a69762a958cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64942ae3ea6a4a2bc66031d35d580ddf, https://si.imgix.net/e27d428b/uploads/origins/516d7887-f36e-44cd-ba0d-a69762a958cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87582c1d6f9da2499b042209ae55c16f 2x, https://si.imgix.net/e27d428b/uploads/origins/516d7887-f36e-44cd-ba0d-a69762a958cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c897911c7983f1830244f7b82d802e35 3x", "genre": "art", "nsfw": false, "body": "URLの黒髪きつね娘さんを描いて頂ければと思います。許可はとっております。\nちょっと小柄で、胸はかなり控え目です。笑顔が似合う癒し系です。ほのぼの。\nSDではなく通常に近い等身でお願いします。(SDも非常に好きなんですが今回は、ということで)\n服装はおまかせします。URLの制服でもいいですしカスタマイズしてもいいですし。あっもしマフラーを外すなら首輪を付けてほしい(\nシチュエーションとしては\n①2月くらいだしバレンタインということで、チョコを渡そうと照れてるやつ\n②最近寒いしオキシトシン足りてないので、照れつつも両手を広げてハグ待ちのポーズ\n③群鳩さんの好きなシチュ。季節感ガン無視でも大丈夫。好きに描こう！\nこれのどれかでお願いします。\n\n可能であれば笑顔や照れ表情などの差分があると非常に嬉しいです。\nおまかせが多くて申し訳ないですが考えて頂ければと。\n\nhttps://drive.google.com/drive/folders/1Pq3mBZ6NhLm4RpxD4RZMFycTWtk0ycoX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gq_tramway/works/11", "thumbnail_src": "https://si.imgix.net/0112d2c7/uploads/origins/0b8af2a0-5903-469d-a216-6c2146d31231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72ad5e31c2131dc43d3ffefa41855007", "thumbnail_srcset": "https://si.imgix.net/0112d2c7/uploads/origins/0b8af2a0-5903-469d-a216-6c2146d31231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72ad5e31c2131dc43d3ffefa41855007, https://si.imgix.net/0112d2c7/uploads/origins/0b8af2a0-5903-469d-a216-6c2146d31231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f52ba3ef244d4262f2d7341119650602 2x, https://si.imgix.net/0112d2c7/uploads/origins/0b8af2a0-5903-469d-a216-6c2146d31231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff72757b2d71f194b7f03548da7c32d6 3x", "genre": "art", "nsfw": false, "body": "群鳩電軌さん、あけましておめでとうございます。メンダコちゃん好きの者です。\n寒い時期が続きますね。メンダコちゃんも下半身がみずみずしいので寒そうだなと想像しています。\nところで、メンダコちゃんは制服のようなセーラー服を着ているシーンがあったので学校に通っているのかなと想像していますが、メンダコちゃんは椅子に座りますか？それとも椅子を使わず立って授業受けてたりするんでしょうか？体の構造的に椅子に座りづらそうだし椅子がぬるぬるになりそうだし、学校ではどうしているのかなと気になっていました！", "created_at": "", "completed_at": ""}, {"path": "/@gq_tramway/works/10", "thumbnail_src": "https://si.imgix.net/51845d94/uploads/origins/6d87baec-548b-4c38-ae18-64b002996563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498f868f0e1229f9652f997a344410d1", "thumbnail_srcset": "https://si.imgix.net/51845d94/uploads/origins/6d87baec-548b-4c38-ae18-64b002996563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498f868f0e1229f9652f997a344410d1, https://si.imgix.net/51845d94/uploads/origins/6d87baec-548b-4c38-ae18-64b002996563?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=403841781a9d3db230009ab03b6bb6ad 2x, https://si.imgix.net/51845d94/uploads/origins/6d87baec-548b-4c38-ae18-64b002996563?bg=%23fff&auto=format%2Ccompress&fm=