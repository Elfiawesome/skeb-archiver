bad87ed1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4a549bc520f22d2a99dabaab116c6d", "thumbnail_srcset": "https://si.imgix.net/aab97ef1/uploads/origins/2e80ffea-f04a-4434-896a-550bad87ed1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4a549bc520f22d2a99dabaab116c6d, https://si.imgix.net/aab97ef1/uploads/origins/2e80ffea-f04a-4434-896a-550bad87ed1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a0ca1f02433c35741d49430c72c2f72 2x, https://si.imgix.net/aab97ef1/uploads/origins/2e80ffea-f04a-4434-896a-550bad87ed1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3d8e79dd5499bf8917a2ffee088d593 3x", "genre": "art", "nsfw": false, "body": "Thank you for your nice drawings before!\nI would like to ask you to do Fuzuki Yoigahama again for the pre-college game.\nI'd like to make an image of a wonderful teacher (school nurse) who would regret that she is not the target of a school game (too fluffy).\n(Cleavage, garter, anything goes...) I'd like to leave it to you. I'd like to leave it to you to decide how much or how little I want to do...)\n\nI look forward to the opportunity to work with you 🙏✨.", "created_at": "", "completed_at": ""}, {"path": "/@anshindack/works/18", "thumbnail_src": "https://si.imgix.net/1847bf46/uploads/origins/907408f0-28cf-450d-aeb0-c94fd1b3c1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e68d08037b1127a17d6bdf706613627", "thumbnail_srcset": "https://si.imgix.net/1847bf46/uploads/origins/907408f0-28cf-450d-aeb0-c94fd1b3c1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e68d08037b1127a17d6bdf706613627, https://si.imgix.net/1847bf46/uploads/origins/907408f0-28cf-450d-aeb0-c94fd1b3c1d5?bg=%