80d3-4281-971a-6d43b9f0ec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=290077f58f0525f05827d4f1c4917423 3x", "genre": "art", "nsfw": false, "body": "こんにちは、イラストを依頼したいのですが！私のファーソナのイラストを描いていただけませんか？ジャケットと尾のリボンは、参考資料の左下にある紫の模様を使って描いていただけますか？ポーズについては、参考資料にある本を左腕の下に抱えているようにしていただけますか？それ以外のポーズの詳細は、お任せします！\n\n参考画像: https://drive.google.com/file/d/1FROEFKJEOodvTc1EV4gjl_CZoDQ3zEys/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/13", "thumbnail_src": "https://si.imgix.net/78fdb150/uploads/origins/ad8d0e0c-2fa6-48e9-92e5-3db4e22c6718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e30a527e47e4968804e50d5dd8eacd4f", "thumbnail_srcset": "https://si.imgix.net/78fdb150/uploads/origins/ad8d0e0c-2fa6-48e9-92e5-3db4e22c6718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e30a527e47e4968804e50d5dd8eacd4f, https://si.imgix.net/78fdb150/uploads/origins/ad8d0e0c-2fa6-48e9-92e5-3db4e22c6718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8df146590884b6c451f854d9cc13243f 2x, https://si.imgix.net/78fdb150/uploads/origins/ad8d0e0c-2fa6-48e9-92e5-3db4e22c6718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bf302c2f7380dd126ea240a8123faca 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております！\n\n最近、新しいうちの子が生まれたので依頼したいと思いお送りしましたっ！\n\n依頼の内容なのですが、氷を司るタイプの子になりますので\n宙に浮かびながら氷柱を周りに生成し、臨戦態勢の姿でお願いしたいと思いますっ\n\n資料に関しては以下に添付いたします\n\n■ラリマー君資料\nhttps://www.dropbox.com/scl/fi/hjhz7ys4l58jmrwi644n4/.png?rlkey=0gbktqwuk9b5ph1yl27jlmcid&st=guo04rbp&dl=0\nhttps://www.dropbox.com/scl/fi/t72t749psab7qonnlu1cz/.jpg?rlkey=r9kwfg03prvz8w1rb4w4254eu&st=w0erc53f&dl=0\n\n以上です、何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/12", "thumbnail_src": "https://si.imgix.net/cc501c3b/uploads/origins/56b94881-7db4-4251-becc-904111cbf5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f985e6d51f09dceb8b0db4794313f50c", "thumbnail_srcset": "https://si.imgix.net/cc501c3b/uploads/origins/56b94881-7db4-4251-becc-904111cbf5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f985e6d51f09dceb8b0db4794313f50c, https://si.imgix.net/cc501c3b/uploads/origins/56b94881-7db4-4251-becc-904111cbf5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77691f685aceec0a4c9cae451c77db34 2x, https://si.imgix.net/cc501c3b/uploads/origins/56b94881-7db4-4251-becc-904111cbf5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b15e001f2a2a0489e13bb7ef4e41039 3x", "genre": "art", "nsfw": false, "body": "いつも大変お世話になっております…！\n\nもしよければうちの子とよその子を描いていただきたいと思い依頼しに来ました…！\n\n依頼の内容になりますが\nリーキ君とアーラちゃんの仲睦まじい姿をお願いしたく思います…！\nうちの子とよその子の資料は以下に添付いたします\n\n■資料\n・リーキ君(うちの子)\nhttps://www.dropbox.com/scl/fi/ci6cbvgl1heeqen4jzrgy/.png?rlkey=qry7k4k8ctzryfp20hraeicg4&st=kwygj3sg&dl=0\n\n・アーラちゃん(あおさめこさん宅)\nhttps://www.dropbox.com/scl/fi/y8gy4kgzd5wyl447wgx27/.jpg?rlkey=szp9dwfmhyb5jba8xjs5q3nwj&st=0f1cu535&dl=0\n\n・参考イラスト\nhttps://www.dropbox.com/scl/fi/zbby3fz09o9b74csv9tpw/.png?rlkey=spzpmkmp93vbtkpfx6re9hgk4&st=piv5g87y&dl=0\n\n以上です、何卒よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/11", "thumbnail_src": "https://si.imgix.net/d3e7fd3e/uploads/origins/0e7443c9-e850-453b-96ce-13873f48c865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335da00fa72b8108cf4f003e91da34d3", "thumbnail_srcset": "https://si.imgix.net/d3e7fd3e/uploads/origins/0e7443c9-e850-453b-96ce-13873f48c865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335da00fa72b8108cf4f003e91da34d3, https://si.imgix.net/d3e7fd3e/uploads/origins/0e7443c9-e850-453b-96ce-13873f48c865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f06ceebf61c43e3b1e4c04c435370d1 2x, https://si.imgix.net/d3e7fd3e/uploads/origins/0e7443c9-e850-453b-96ce-13873f48c865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64a7eafd221b488cd1987bd70aa57ba2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品が大好きで、ぜひ依頼したいと思っています。\n私のキャラクターが空を飛べるようにしてほしいです。\nキャラクター設定へのリンク\nhttps://drive.google.com/file/d/1woQcX5Y_We0rTrn4f8_DuwpQLn61_Evf/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/10", "thumbnail_src": "https://si.imgix.net/89fe1517/uploads/origins/e21820ac-cb8d-42c0-a2f7-6f3c21573dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98165484595cc9e555f4f3723278f10a", "thumbnail_srcset": "https://si.imgix.net/89fe1517/uploads/origins/e21820ac-cb8d-42c0-a2f7-6f3c21573dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98165484595cc9e555f4f3723278f10a, https://si.imgix.net/89fe1517/uploads/origins/e21820ac-cb8d-42c0-a2f7-6f3c21573dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16029779d381429b344360e33388fe4d 2x, https://si.imgix.net/89fe1517/uploads/origins/e21820ac-cb8d-42c0-a2f7-6f3c21573dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e9b42f078a3d1b99a3c58f2c05670b4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生の作品がとても好きです。先生が私のために絵を描いてくれることを願っています。 https://drive.google.com/file/d/1bk72lKLHWcGB6CXhvT83iJZ3ubrh43c- /view?usp= 共有", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/9", "thumbnail_src": "https://si.imgix.net/e0edd906/uploads/origins/638e32c5-883e-4cf2-91bd-9f8b0c01e848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df62f7932488e9f6421c89881ce20c79", "thumbnail_srcset": "https://si.imgix.net/e0edd906/uploads/origins/638e32c5-883e-4cf2-91bd-9f8b0c01e848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df62f7932488e9f6421c89881ce20c79, https://si.imgix.net/e0edd906/uploads/origins/638e32c5-883e-4cf2-91bd-9f8b0c01e848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c26b613bb1bc3edc410e5ed5e7b53f1 2x, https://si.imgix.net/e0edd906/uploads/origins/638e32c5-883e-4cf2-91bd-9f8b0c01e848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df2f41903621363626ad0232261d9958 3x", "genre": "art", "nsfw": false, "body": "空曜さん、こんにちは。\n以前はゼノを描いていただきありがとうございました。\n宜しければ私のOCのステラをお願いします。\n星の海で生まれた彼は宇宙空間でも活動できます。\n\nアクセサリー類が多いので、省略/簡略化はご自由になさってください。\n\n納品はpsd形式で、宛名は別レイヤーにしていただけると幸いです。\n\nhttps://drive.google.com/drive/u/0/folders/1PuHVbgWtyF5PViTGrnUIMA5Qq-9BGgfh", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/8", "thumbnail_src": "https://si.imgix.net/0da9b626/uploads/origins/9c05ca81-606d-4345-a084-79cdc0fb8080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af53b492d9d07ef18c96ed6c29cc3a7a", "thumbnail_srcset": "https://si.imgix.net/0da9b626/uploads/origins/9c05ca81-606d-4345-a084-79cdc0fb8080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af53b492d9d07ef18c96ed6c29cc3a7a, https://si.imgix.net/0da9b626/uploads/origins/9c05ca81-606d-4345-a084-79cdc0fb8080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbee7ef315a24a9f5fdb7823fa59b4b8 2x, https://si.imgix.net/0da9b626/uploads/origins/9c05ca81-606d-4345-a084-79cdc0fb8080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c32055481bf01cf3c33077f190b1d232 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はBigglesです。私の2つのキャラクターがお互いに交流するサンプルを依頼したいと思います。\n私が考えているアクションは、私の小さなタコ（Atomos）が両手で私のキツネ（Biggles）の腰に触れ（抱きつき）、そしてキツネの表情が少しショックを受け、恥ずかしがりながら、少し甘いやりとりをするというものです。\n背景は特別なものではなく、キツネの腕と脚の片側だけにタトゥーがある。脚の片側だけにテクスチャーがあり、小さなタコ目は半月型に固定されている。\n高さの設定に差はありませんので、画像に合わせていただければ大丈夫です。その他の設定はご自由にお使いください。\n最後に、パソコンのデスクトップでも使えるように、アスペクト比は16:9を希望します。\n\nhttps://drive.google.com/drive/folders/1sQjDD6gvDHu5symozKyyu5faWcRka3BV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuuyou_/works/7", "thumbnail_src": "https://si.imgi