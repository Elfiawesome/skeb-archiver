f8e3/uploads/origins/1d5f04e9-08ad-4c70-8d1e-6e4d0e394770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d5ba9634377fdb1ab7d68eb796ff9eb, https://si.imgix.net/9c26f8e3/uploads/origins/1d5f04e9-08ad-4c70-8d1e-6e4d0e394770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f5be904c03ec44e63968807d4e48b6 2x, https://si.imgix.net/9c26f8e3/uploads/origins/1d5f04e9-08ad-4c70-8d1e-6e4d0e394770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc56e74475f3dbdc496304d635d7e501 3x", "genre": "art", "nsfw": false, "body": "◆全体\n資料URLのキャラ（ウェブゲームのマイキャラ）、猫夜敷・千舞輝を描いて頂きたいです\n\n◆キャラ設定\nだらだらするのが好き\nゲームする・コスプレするのが趣味\n猫っぽいけど人間\n\n◆描写内容\n外見は外見資料を参照で、\n服装は服装資料の服装のどちらか、または何かのコスプレ衣装（お任せ）で、\nシチュエーション等はお任せでお願いします\n\nよろしくお願いします！\n\n外見資料\nhttp://cdn.tw5.jp/i/tw5/origin/2586/730525_e25868_model_sheet_f.jpg\n服装資料 http://cdn.tw5.jp/i/tw5/origin/2586/1008973_e25868_totalbody.png\nhttp://cdn.tw5.jp/i/tw5/origin/2586/1019486_e25868_totalbody.png", "created_at": "", "completed_at": ""}, {"path": "/@fbctwit/works/38", "thumbnail_src": "https://si.imgix.net/8f555118/uploads/origins/44def176-a525-4d80-8b05-84580dc8a801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33171e5923b5027c8b85622613d6c2ec", "thumbnail_srcset": "https://si.imgix.net/8f555118/uploads/origins/44def176-a525-4d80-8b05-84580dc8a801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33171e5923b5027c8b85622613d6c2ec, https://si.imgix.net/8f555118/uploads/origins/44def176-a525-4d80-8b05-84580dc8a801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=937bd1b4da1d05c6787af86aa9ff7cda 2x, https://si.imgix.net/8f555118/uploads/origins/44def176-a525-4d80-8b05-84580dc8a801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d9a6be9fbc40c136a680fdd1c39afe5 3x", "genre": "art", "nsfw": true, "body": "ＦＢＣ様。\nいつもお世話になっております。\n早速依頼をさせて頂きます。\n\n御城プロジェクトのアーケシュフース城をお願い致します。\n\n衣装は公式のものでも、それ以外のものでも差し支えありません。\n構図はお任せ致します。\n爆乳ムチムチに仕立てて頂ければ幸甚に存じます。\nNSFWを有効にしておりますが、R15～17程度の作品に仕立てて頂ければ幸甚に存じます。\n\nご検討宜しくお願い致します。\n\nhttps://imgur.com/a/Cwhbvor", "created_at": "", "completed_at": ""}, {"path": "/@fbctwit/works/37", "thumbnail_src": "https://si.imgix.net/ba3dc73f/uploads/origins/92384d8d-8577-40d9-a7ed-5b09dcb50f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=840ea8652f9da4b1d3352c2c5419613a", "thumbnail_srcset": "https://si.imgix.net/ba3dc73f/uploads/origins/92384d8d-8577-40d9-a7ed-5b09dcb50f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=840ea8652f9da4b1d3352c2c5419613a, https://si.imgix.net/ba3dc73f/uploads/origins/92384d8d-8577-40d9-a7ed-5b09dcb50f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d046bd2db4ef88cceee5a545121a3a24 2x, https://si.imgix.net/ba3dc73f/uploads/origins/92384d8d-8577-40d9-a7ed-5b09dcb50f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9350e16c03dcb5c86a24fd15b018777b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、照瑚なすと申します。\nイラストのご依頼をさせていただきたく、ご連絡いたしました。\n\n実は、約25年前にFBCさんのホームページに掲載されていた、うさだ、カオ、FEZが未だに忘れられず、そしてラグナロクオンラインの漫画は今でも宝物です。\n\n当時はホームページで「}{age！」などと言ってFBCさんをいじったりしていた頃もありましたが、気づけば自分もすっかり頭皮が心もとない年齢になりました。時の流れを感じつつ、それでもFBCさんの作品は今でもずっと大切な存在です。\n\n現在はバ美肉VTuberとして活動しており、チャンネル登録者1000人を達成したら、ずっと憧れているFBCさんに依頼しようと決めていました。\n一年以上かかりましたが、ようやくその目標を叶えられたため、今回こうしてご依頼をさせて頂きました。\n\nもし可能でしたら、私のVTuberの姿を描いていただきたいです。構図等は基本的にお任せしますが、FBCさんらしい、パースの効いた可愛い絵だととても嬉しいです。\n\nまた、可能であれば商用利用（配信サムネやグッズなど）も許可いただけるととても嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nX、YouTube、リットリンクのURLを添えておきます。リットリンクには3面図もありますので、良かったら参考にしてください。\n\nhttps://x.com/tereko_nasu\n\nhttps://youtube.com/@tereko-nasu?si=IlWe4HXV7htsbkEn\n\nhttps://lit.link/terekonasu", "created_at": "", "completed_at": ""}, {"path": "/@fbctwit/works/36", "thumbnail_src": "https://si.imgix.net/59863f60/uploads/origins/94716266-5513-4ab5-a3a5-5b60770a9647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=821f9df619336265583e1b176b6c6811", "thumbnail_srcset": "https://si.imgix.net/59863f60/uploads/origins/94716266-5513-4ab5-a3a5-5b60770a9647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=821f9df619336265583e1b176b6c6811, https://si.imgix.net/59863f60/uploads/origins/94716266-5513-4ab5-a3a5-5b60770a9647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04f5fcb09ab97773b2cfbeadc7868172 2x, https://si.imgix.net/59863f60/uploads/origins/94716266-5513-4ab5-a3a5-5b60770a9647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a0c4855440beac021c5029d35c3f4b7 3x", "genre": "art", "nsfw": true, "body": "うちのこ、兎のケープを描いて頂きたいです。\n真面目系装った良く蒸れてる小悪魔系ウサギです。\nポーズ、構図等はFBC様にお任せ致しますが、資料の胸ジッパー開けた状態と生乳差分があると非常に助かります。\n\nお忙しい中とは思いますがご検討お願いいたします。\n\nhttps://www.dropbox.com/scl/fo/lu6s8d96a54jj1tgx64u8/AOvWsI4ocVQz9kwLMW0DdDU?rlkey=5qn8amgbkcxrf1beqxbmq4kr9&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@fbctwit/works/35", "thumbnail_src": "https://si.imgix.net/d3db0b08/uploads/origins/0ea5eee5-d225-4029-bee9-729806e61ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e40b10d41428b88f0f6b3a7b557bd82", "thumbnail_srcset": "https://si.imgix.net/d3db0b08/uploads/origins/0ea5eee5-d225-4029-bee9-729806e61ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e40b10d41428b88f0f6b3a7b557bd82, https://si.imgix.net/d3db0b08/uploads/origins/0ea5eee5-d225-4029-bee9-729806e61ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af50de36790fc9445638e305739c9c69 2x, https://si.imgix.net/d3db0b08/uploads/origins/0ea5eee5-d225-4029-bee9-729806e61ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eda92a7bddc606ec05d302e1856225ac 3x", "genre": "art", "nsfw": true, "body": "アズールレーンよりアンカレッジを描いてほしいです。\n公式スキンの水着を着用している。\nhttps://x.com/azurlane_staff/status/1