7ed4b2801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac938f9c27b9aabd9665879a0af964b3 2x, https://si.imgix.net/ef717878/uploads/origins/980bd3d7-a7ca-42a7-991e-46b7ed4b2801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f48da4ce0e5584ed51c58410aa64bef7 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n先日は大変スケベなイラストを描いていただきありがとうございました。\n改めて依頼をお願いしたくご連絡しました。\n\n●キャラクター\nハッカドール1号、2号、3号\n\n●シチュエーション\n1号、2号が3号の早漏ショタちんを立派に鍛えてあげている…というシチュエーションです。\n3号のチ○ポは鍛えられまくった結果立派なサイズに成長しており、それを舌舐めだけで執拗に責め立てる1号と2号の姿を3号の視点でお願いします。\nまた、可能な範囲で問題ありませんので下記の差分も含めていただけますと幸いです。\n\n・3号の方を見ながら慣れた様子でチ○ポを舐る二人。発情しているという訳でも無くいつも通りの朗らかな表情。\n・二人とも段々と逆に3号のチ○ポに釘付けになり、メスの顔をしながらチン舐めがヒートアップする。\n・顔射された後、顔にこびりついた精のにおいに二人は恍惚としている。\n\n細かい指定で申し訳ありませんが、ご検討の程を宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kumitaman/works/8", "thumbnail_src": "https://si.imgix.net/c373f443/uploads/origins/cea53261-9547-405a-86c1-0111964afa49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=722bd73193fb4521e9b6a78ad7653734", "thumbnail_srcset": "https://si.imgix.net/c373f443/uploads/origins/cea53261-9547-405a-86c1-0111964afa49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=722bd73193fb4521e9b6a78ad7653734, https://si.imgix.net/c373f443/uploads/origins/cea53261-9547-405a-86c1-0111964afa49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abf4d77af3725c9335903c6157a5615c 2x, https://si.imgix.net/c373f443/uploads/origins/cea53261-9547-405a-86c1-0111964afa49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bad02920370ef36a366b8beb85fc0534 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n此度はイラストの依頼をお願いしたくご連絡しました。\n\n●キャラクター\nハッカドール2号、3号\n\n●シチュエーション\n2号が3号のショタちんを下品なひょっとこフェラで搾り、無理矢理精通させてしまう姿を3号の主観視点でお願いします。\n可能であればショタちんを啜るバキューム音を付けて下さると幸いです。\n\nご検討の程を宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kumitaman/works/7", "thumbnail_src": "https://si.imgix.net/ec7c7b9c/uploads/origins/07d18e5d-74d8-467c-9bf0-1a670bb9ed8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=676faf02bcec90efe55c574de8a7a07c", "thumbnail_srcset": "https://si.imgix.net/ec7c7b9c/uploads/origins/07d18e5d-74d8-467c-9bf0-1a670bb9ed8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=676faf02bcec90efe55c574de8a7a07c, https://si.imgix.net/ec7c7b9c/uploads/origins/07d18e5d-74d8-467c-9bf0-1a670bb9ed8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=498a1c27a4d60b5d2c78a0d024ad35ed 2x, https://si.imgix.net/ec7c7b9c/uploads/origins/07d18e5d-74d8-467c-9bf0-1a670bb9ed8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cfd03edd04a1375544b35b530635c6f 3x", "genre": "art", "nsfw": true, "body": "遊戯王のRAI-MEIが見抜き専用シコられオナペットとしてエアパイズリとエアひょっとこフェラをしている姿を、\n\n・キャラクターの頭から股間までを真正面から写したバストアップ\n・原作と同じ衣装\n・頭身高めで筋肉質と言うよりは適度に脂の乗ったむちむちな身体付き\n・なるべく大きく、かつ下腹部が隠れない位の超乳\n・淫語を連呼して射精を促してくるセリフ付き+思い切り白目を剥き、汚い喘ぎ声を叫びながらアへ顔で絶頂する差分\n\n…以上の要素を含めて描いて頂きたいです。要求点が多くて申し訳ありませんが、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@kumitaman/works/6", "thumbnail_src": "https://si.imgix.net/75429463/uploads/origins/62f934c1-0c00-4e5a-8c13-98f5654ff331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee2e599efd933d96face3fd9733db66f", "thumbnail_srcset": "https://si.imgix.net/75429463/uploads/origins/62f934c1-0c00-4e5a-8c13-98f5654ff331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee2e599efd933d96face3fd9733db66f, https://si.imgix.net/75429463/uploads/origins/62f934c1-0c00-4e5a-8c13-98f5654ff331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=972271433c1a9cbc273ec545cb977d48 2x, https://si.imgix.net/75429463/uploads/origins/62f934c1-0c00-4e5a-8c13-98f5654ff331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8c544aba1e02e7d08ef64939527d028 3x", "genre": "art", "nsfw": true, "body": "こんにちは！タイムラインでお見かけして素敵なひょっとこフェラをお描きになっていたのでリクエストをさせていただきました！\n\nうちの子の柳井アリスちゃんのひょっとこフェラをお願いします！\n可能であれば根本まで咥えこみ→射精に合わせて目を細めてにやにや笑う→事後の包茎でしなしなになったペニスの差分があると嬉しいです\nご検討よろしくお願いします！\n\nhttps://twitter.com/salicevitaminC/status/1592214798397472770?t=bJyonsN9RvMUed1RW2X1tQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kumitaman/works/5", "thumbnail_src": "https://si.imgix.net/a8eb09fb/uploads/origins/59764950-0a4b-4064-a7b6-3ff7704a7018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58850be11295310524f99e5f72de8cbf", "thumbnail_srcset": "https://si.imgix.net/a8eb09fb/uploads/origins/59764950-0a4b-4064-a7b6-3ff7704a7018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58850be11295310524f99e5f72de8cbf, https://si.imgix.net/a8eb09fb/uploads/origins/59764950-0a4b-4064-a7b6-3ff7704a7018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30782e5bb64b43cf9ab8822738a4aeb1 2x, https://si.imgix.net/a8eb09fb/uploads/origins/59764950-0a4b-4064-a7b6-3ff7704a7018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37d1d6b7b6b8ef9359a96636349666b9 3x", "genre": "art", "nsfw": true, "body": "作品名【迷家-マヨイガ-】\nキャラクター名:らぶぽん\n\npixivに載っている作品が素晴らしかったのでご依頼をしたいと思いました。\n上記のキャラの主観バキュームフェラを描いて頂きたいです。\nもし可能でしたら胸も盛ってください。\nあまり知名度がない作品ですが是非一度御検討してくださると嬉しいです。\n\nhttps://imgur.com/a/iFAyAmz", "created_at": "", "completed_at": ""}, {"path": "/@kumitaman/works/4", "thumbnail_src": "https://si.imgix.net/a9555083/uploads/origins/85767f61-f6b0-4081-a79a-786da7df9120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d28720dc45f63ed5b777f4aa266a8aa", "thumbnail_srcset": "https://si.imgix.net/a9555083/uploads/origins/85767f61-f6b0-4081-a79a-786da7df9120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d28720dc45f63ed5b777f