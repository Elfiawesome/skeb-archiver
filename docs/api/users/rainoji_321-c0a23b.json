f6-48cd-8a05-f45d7f0bcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f6288a9ca6a59145b7a87a05e53f7c4 2x, https://si.imgix.net/36177c39/uploads/origins/aabd7fa8-bff6-48cd-8a05-f45d7f0bcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be9d7021c97a7cc711a36b842b7600c7 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもイラスト楽しく拝見させて頂いております。\n本当に絵柄が好みで、かっこよくて綺麗でセクシーで絵が上手くて、ファンです！\n\n早速リクエストについてなのですが、ohariさんの絵で自分と友人の探索者が見てみたく、リクエストさせていただきます。\nCoCシナリオ『ロトカ・ヴォルテラの愛堕討ち』の極道と落語家です。\nシチュエーションなど特に指定はありません。\n\n資料の不足やそのほか難しい場合は改めて依頼させていただきますので、キャンセルして頂いて構いません。\nご無理のない範囲で、どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1af3wBf8GTvCIAjVMmyXHzxYpv1f-nVZT", "created_at": "", "completed_at": ""}, {"path": "/@rainoji_321/works/34", "thumbnail_src": "https://si.imgix.net/c77b5e77/uploads/origins/eb29bc72-3ebe-4f28-9dc5-75ce1d2c3010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80c309bb4d8a065c71c91fb88762380b", "thumbnail_srcset": "https://si.imgix.net/c77b5e77/uploads/origins/eb29bc72-3ebe-4f28-9dc5-75ce1d2c3010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80c309bb4d8a065c71c91fb88762380b, https://si.imgix.net/c77b5e77/uploads/origins/eb29bc72-3ebe-4f28-9dc5-75ce1d2c3010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f377dd7834cbf722dd384f6b11a7b5cd 2x, https://si.imgix.net/c77b5e77/uploads/origins/eb29bc72-3ebe-4f28-9dc5-75ce1d2c3010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=896a7fcba220cbaf4878d0d4c339096a 3x", "genre