df6-41de-80cf-26f8dd0b936e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e3474548d60f42530d73af81b26c04c 2x, https://si.imgix.net/c56ced8f/uploads/origins/24529d74-8df6-41de-80cf-26f8dd0b936e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4b4c882f6a78bbd9d73810b7d62f9fd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nまたザングースの全身イラストをお願いします。\n\nザングースが戦闘に敗れて全身にダメージを受けているようなイラストをお願いします。ザングースは地面に倒れて動けません。体のポーズはこちらのリンクからお願いします：\nhttps://cdni.fancaps.net/file/fancaps-animeimages/7189681.jpg\n\n絵は上から見てください。ザングースの表情の例と、見る角度の例です：\nhttps://cdni.fancaps.net/file/fancaps-animeimages/7189685.jpg\n\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/14", "thumbnail_src": "https://si.imgix.net/1660e3f3/uploads/origins/2fd1627d-6c08-4ba3-a02f-6bc78c0e5f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aabbdace056bfbf8958e6a3c265cfee1", "thumbnail_srcset": "https://si.imgix.net/1660e3f3/uploads/origins/2fd1627d-6c08-4ba3-a02f-6bc78c0e5f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aabbdace056bfbf8958e6a3c265cfee1, https://si.imgix.net/1660e3f3/uploads/origins/2fd1627d-6c08-4ba3-a02f-6bc78c0e5f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=536eb6579610de9df03ecfd2a177563f 2x, https://si.imgix.net/1660e3f3/uploads/origins/2fd1627d-6c08-4ba3-a02f-6bc78c0e5f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdeb7c0970e756d0d56e6da0244a5c2f 3x", "genre": "art", "nsfw": false, "body": "私のトランビークが前かがみになってお尻を見せているポーズや体勢の画像をリクエストします。羽をたたむかたたまないか、表情も自由ですが、ちょっとチャラチャラした感じがいいです。背景はシンプルな屋外がいいです。ありがとうございました。\n\nその他の参考資料 - https://twitter.com/JaketheTrumbeak/status/1421589901603217410?t=Nq12xVvW6QsEuUI4LTSFbA&s=19\nhttps://twitter.com/JaketheTrumbeak/status/1421590256323907588?t=8Fi3lU_o4nZNJzWQTzMdUQ&s=19\n\nhttps://twitter.com/JaketheTrumbeak/status/1421583446246309893?t=8HUDnK6Q-rvmksCNVqO9lQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/13", "thumbnail_src": "https://si.imgix.net/630d3f53/uploads/origins/9465fa9b-922b-4b8f-9cb8-a40f8fa8fc95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=712a3aa375c0cf46cd2e12fdd0924b6a", "thumbnail_srcset": "https://si.imgix.net/630d3f53/uploads/origins/9465fa9b-922b-4b8f-9cb8-a40f8fa8fc95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=712a3aa375c0cf46cd2e12fdd0924b6a, https://si.imgix.net/630d3f53/uploads/origins/9465fa9b-922b-4b8f-9cb8-a40f8fa8fc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0998524cfd6d00a31c2d6ec19a2aaceb 2x, https://si.imgix.net/630d3f53/uploads/origins/9465fa9b-922b-4b8f-9cb8-a40f8fa8fc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=149461514a4e1b25b6623fdbee107b1a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のザングースが欲しいよ！どんな形であれ\n\nhttps://i.imgur.com/fcLf8gP.png", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/12", "thumbnail_src": "https://si.imgix.net/c8680614/uploads/origins/f4483c87-d921-4704-a354-0a76412dfccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=693668e0b1dbe95efb7986d2696150e7", "thumbnail_srcset": "https://si.imgix.net/c8680614/uploads/origins/f4483c87-d921-4704-a354-0a76412dfccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=693668e0b1dbe95efb7986d2696150e7, https://si.imgix.net/c8680614/uploads/origins/f4483c87-d921-4704-a354-0a76412dfccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83cbb327f309d9a4d920ddae387f01aa 2x, https://si.imgix.net/c8680614/uploads/origins/f4483c87-d921-4704-a354-0a76412dfccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c1ec63a072aaa77a1d2f11e8edcf155 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nノイヴァーン（オンバーン）とグリスコール（グライオン）と一緒に寝ているシンデレース（エースバーン）の全身イラストが欲しいです。\n\nシンデレースは背中を向けて正面にいてほしい。グリスコールは、正面を向いたまま片足を上げているノイヴァーンに抱かれて真ん中にいるはずだ。\n\n\nポーズは参考にしてください。\n\nありがとうございました！\n\nhttps://x.com/donutdoesarts/status/1741500349490307421?s=46&t=NktpWom-H5oNwpUeJ9tAqA", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/11", "thumbnail_src": "https://si.imgix.net/7b4bc31f/uploads/origins/20a0f475-bbe6-4008-90f5-16a606f9b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee34f2692dc719534da959f630a580b", "thumbnail_srcset": "https://si.imgix.net/7b4bc31f/uploads/origins/20a0f475-bbe6-4008-90f5-16a606f9b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee34f2692dc719534da959f630a580b, https://si.imgix.net/7b4bc31f/uploads/origins/20a0f475-bbe6-4008-90f5-16a606f9b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9e3471f005c3819e95488a23dae36c9 2x, https://si.imgix.net/7b4bc31f/uploads/origins/20a0f475-bbe6-4008-90f5-16a606f9b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b1b30603ed14d8939c584bc7749f4b5 3x", "genre": "art", "nsfw": false, "body": "初めまして、蒼米です\nなつまる🌻さん晴らしいイラスト拝見していたしました。\n僕のVRCキャラを描いてよろしくお願いいただきます\n\n\n【VRCキャラクター】\n健気な青いレッサーパンダケモショタです\nhttps://drive.google.com/drive/folders/14iYN68phZg-wOsowfQKR6AU8CA4hPfda\n\n【服装】\nhttps://booth.pm/ja/items/2859695 (購入済み)\nhttps://drive.google.com/drive/folders/1z70F0wozVnq98w7CuYLfTAxLxoW9u3Ny?usp=sharing (注文詳細)\n\nピンク色です(右1)\nスカートが半ズボンを変わります\n\n他の構図とポーズはお任せします。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/10", "thumbnail_src": "https://si.imgix.net/ceb13eff/uploads/origins/46b1f158-c101-43fe-ac93-31bb74d8a63b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fda427e9daca9b26bf55de5234240e3", "thumbnail_srcset": "https://si.imgix.net/ceb13eff/uploads/origins/46b1f158-c101-43fe-ac93-31bb74d8a63b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fda427e9daca9b26bf55de5234240e3, https://si.imgix.net/ceb13eff/uploads/origins/46b1f158-c101-43fe-ac93-31bb74d8a63b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e5c1ec22fa50be4ef4bbad1390b4831 2x, https://si.imgix.net/ceb13eff/uploads/origins/46b1f158-c101-43fe-ac93-31bb74d8a63b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62dc7771e72b5f1ad2f9833e112ceeea 3x", "genre": "art", "nsfw": false, "body": "なつまるさんこんにちは。\n初めてのskeb依頼失礼します。\n\nオリキャラのそうさを依頼させていただきます。\n\n構図はちょっぴりザングース寄りの体型でシチュエーションやポージングはお任せします。また全身絵を希望してます。\n\nよろしくお願いします！！\nhttps://twitter.com/nako_stoat303/status/1749037802740965589", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/9", "thumbnail_src": "https://si.imgix.net/fa5527ea/uploads/origins/327216b1-f3e8-4463-9b05-237e605ce452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee8834ed272f608a3ed742fc505696af", "thumbnail_srcset": "https://si.imgix.net/fa5527ea/uploads/origins/327216b1-f3e8-4463-9b05-237e605ce452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee8834ed272f608a3ed742fc505696af, https://si.imgix.net/fa5527ea/uploads/origins/327216b1-f3e8-4463-9b05-237e605ce452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01b38e00085b0973da6a0bbc89a32869 2x, https://si.imgix.net/fa5527ea/uploads/origins/327216b1-f3e8-4463-9b05-237e605ce452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54f239412a676929510275ee268350d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/8", "thumbnail_src": "https://si.imgix.net/b7cd671e/uploads/origins/eda3becf-da23-416f-9023-e9e5e6b3aa8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e716894aed1f6d777fb9a3bf76f4f7b0", "thumbnail_srcset": "https://si.imgix.net/b7cd671e/uploads/origins/eda3becf-da23-416f-9023-e9e5e6b3aa8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e716894aed1f6d777fb9a3bf76f4f7b0, https://si.imgix.net/b7cd671e/uploads/origins/eda3becf-da23-416f-9023-e9e5e6b3aa8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffa40db438c3cb39ace974bbaf2d6d65 2x, https://si.imgix.net/b7cd671e/uploads/origins/eda3becf-da23-416f-9023-e9e5e6b3aa8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cb225535f2328c39c13296c02af4599 3x", "genre": "art", "nsfw": false, "body": "足が40本ある多脚ケモノタウルを見てみたい！(昆虫じゃないけど）\n\n解剖学的には、2本の腕、2本の前脚、38本の後脚があり、それぞれの脚の間にフルサイズの胴体があるようなキャラクターにしたい。詳しくは以下のドキュメントをご覧ください。\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1104320790406627458/Taurtrain_anatomy_reference.doc\n\n以下の点を重視します：\n- 適切な解剖学（例えば、前脚と後脚の違いなど）\n- 全身と脚のほとんど（できればすべて）を見せること。\n- 蹄など他の脚よりも肉球や爪が好ましい。\n\n上記のすべてを満たした上で、以下のどれでもかまわない：\n- クリーチャー\n- デザイン\n- ポーズ", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/7", "thumbnail_src": "https://si.imgix.net/5839e8f0/uploads/origins/0f323b19-40c5-4ab9-808b-f16f3a35162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faccdf83ee13f1718b7948fb8d388335", "thumbnail_srcset": "https://si.imgix.net/5839e8f0/uploads/origins/0f323b19-40c5-4ab9-808b-f16f3a35162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faccdf83ee13f1718b7948fb8d388335, https://si.imgix.net/5839e8f0/uploads/origins/0f323b19-40c5-4ab9-808b-f16f3a35162c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e5f2bdcc152369f93e0307c3d75ea76 2x, https://si.imgix.net/5839e8f0/uploads/origins/0f323b19-40c5-4ab9-808b-f16f3a35162c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18710ab87a2b256263197dbcd5843a36 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nまたザングースの全身イラストをお願いします。\n\n戦いで体に傷を負ったザングースが、見る人に向かって片足ずつ歩いてくるようなイラストです。ザングースは真剣な表情で、もう一度戦う準備ができています。\n\nポーズ（左）は下記URLを参考にしてください。\n\nありがとうございました！\n\nhttps://drive.google.com/file/d/1Adu3faBxjCy8BSqZIPCXhm8fFSzKz4hS/view", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/6", "thumbnail_src": "https://si.imgix.net/a85930fc/uploads/origins/7b239665-7234-442e-84c1-59e1091e91ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a9bca14f9a9051e03a037f6604d006f", "thumbnail_srcset": "https://si.imgix.net/a85930fc/uploads/origins/7b239665-7234-442e-84c1-59e1091e91ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a9bca14f9a9051e03a037f6604d006f, https://si.imgix.net/a85930fc/uploads/origins/7b239665-7234-442e-84c1-59e1091e91ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a48fc93c1e9a3d3a0588a5c93b7ed92 2x, https://si.imgix.net/a85930fc/uploads/origins/7b239665-7234-442e-84c1-59e1091e91ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ae49b0da9030694365f06e6d23ca6c0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの絵が大好きです！  シャイニー・ジュナイパーと一緒にシャイニー・ザングースも描いてくれませんか？  どちらもほとんど同じ色で、私の大好きなポケモンです！\n\n好きなように描いていいよ。\n\nhttps://drive.google.com/drive/folders/1qrndgmk1hOIvNeoHCc-cZr4e3wg0vMdS?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@natsutyu/works/5", "thumbnail_src": "https://si.imgix.net/f71137ed/uploads/origins/fb590a3b-702b-4b4b-8f69-a5faca447a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbf7379da226186de5f623aefc96adfa", "thumbnail_srcset": "https://si.imgix.net/f71137ed/uploads/origins/fb590a3b-702b-4b4b-8f69-a5faca447a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop