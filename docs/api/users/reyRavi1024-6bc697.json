n・カメラ目線ではないこと\n・ヘッドフォンで音楽を聞いているポーズ\nこちら3点を指定させていただき、服装や小物のデザインはお任せします。\n鴒さんの描かれる瞳の描き込みが大好きなので、できれば目を閉じていない表情ですとありがたいです。\n\nスマートフォンの壁紙として使用したいため、アスペクト比20:9、上部1/3程度の部分に顔がかからないようにしていただけると助かります。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@reyRavi1024/works/21", "thumbnail_src": "https://si.imgix.net/0a2abf19/uploads/origins/a73db6a4-cfd2-4c3c-b4ba-dbbbdeff748c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e441d6e29d2187b0d6d88ba95cb5a2f", "thumbnail_srcset": "https://si.imgix.net/0a2abf19/uploads/origins/a73db6a4-cfd2-4c3c-b4ba-dbbbdeff748c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e441d6e29d2187b0d6d88ba95cb5a2f, https://si.imgix.net/0a2abf19/uploads/origins/a73db6a4-cfd2-4c3c-b4ba-dbbbdeff748c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15d839e7db0bf690e406101c334312fb 2x, https://si.imgix.net/0a2abf19/uploads/origins/a73db6a4-cfd2-4c3c-b4ba-dbbbdeff748c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f204973904a5e0cf9a5accf1c367b4f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@reyRavi1024/works/20", "thumbnail_src": "https://si.imgix.net/8b50427a/uploads/origins/4fc5fb4e-6194-4983-a023-0cb9893f8528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a448fd963bd822fd31b40e229863dad1", "thumbnail_srcset": "https://si.imgix.net/8b50427a/uploads/origins/4fc5fb4e-6194-4983-a023-0cb9893f8528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a448fd963bd822fd31b