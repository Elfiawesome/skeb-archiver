IVATE&s=7bc25648e6818d9b58b5ddf6bc50e0e5 2x, https://si.imgix.net/f29d8c76/uploads/origins/17e69a01-314a-4d6a-a97f-3785d2d16dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e9e10202479c83cdbbcfe861e31b386 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/656", "thumbnail_src": "https://si.imgix.net/169dc35e/uploads/origins/f825f032-af67-42cc-a201-ea11141a9006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed34b9b1cbe202dceb888c2a05263726", "thumbnail_srcset": "https://si.imgix.net/169dc35e/uploads/origins/f825f032-af67-42cc-a201-ea11141a9006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed34b9b1cbe202dceb888c2a05263726, https://si.imgix.net/169dc35e/uploads/origins/f825f032-af67-42cc-a201-ea11141a9006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecb4d2af4188efc2f8f0e6ce163e6905 2x, https://si.imgix.net/169dc35e/uploads/origins/f825f032-af67-42cc-a201-ea11141a9006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdb87b2870a7937bf4c1e88e9bb50285 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/655", "thumbnail_src": "https://si.imgix.net/de262918/uploads/origins/72e5090e-ccd8-4181-8d03-a3b0af8ea0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb761beb5713b7018d012da16d869170", "thumbnail_srcset": "https://si.imgix.net/de262918/uploads/origins/72e5090e-ccd8-4181-8d03-a3b0af8ea0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb761beb5713b7018d012da16d869170, https://si.imgix.net/de262918/uploads/origins/72e5090e-ccd8-4181-8d03-a3b0af8ea0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc0f6e57e69b4dd31136f46ffb1a350d 2x, https://si.imgix.net/de262918/uploads/origins/72e5090e-ccd8-4181-8d03-a3b0af8ea0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebcddb4b31f8ccf2a490ca5828d95810 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n一枚依頼させてください。\n\nうちの子であるシュヴァルツとエミーの緊縛イラストをお願いします。資料はＵＲＬから参照お願いします。\n\n画像はこちら参考ください。\n\nシュヴァルツ\nhttps://x.com/arupaka9/status/1705571646751289797\n（左の男性は無視してくれて構いません）\nエミー\nhttps://x.com/arupaka9/status/1889303508299477488\n\nシチュエーションとしては\n2人とも後ろ手に縛られてベッドに転がされ、これからまわりの玩具で遊ぼうか、というようなイメージです。\n\n・服装の差分でバニースーツ、ビキニがほしい。\n・縄での緊縛、腕は後ろ手にまわされて抵抗できないようにしてほしい。\n・ボールギャグと目隠しを装着させてほしい。\n・ベッドのまわりにはたくさんの玩具を転がしていてほしい。\n\n以上の点となります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/654", "thumbnail_src": "https://si.imgix.net/95b0ffa7/uploads/origins/609428f9-9675-442b-85a2-3612fa454578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0093061368fb6da9cf821f8a9447c7bf", "thumbnail_srcset": "https://si.imgix.net/95b0ffa7/uploads/origins/609428f9-9675-442b-85a2-3612fa454578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0093061368fb6da9cf821f8a9447c7bf, https://si.imgix.net/95b0ffa7/uploads/origins/609428f9-9675-442b-85a2-3612fa454578?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2c5f128dc417cb7ed2e80995f48dc8c 2x, https://si.imgix.net/95b0ffa7/uploads/origins/609428f9-9675-442b-85a2-3612fa454578?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66cb9d19b6f439d7f5bd0dc9699d0a9e 3x", "genre": "comic", "nsfw": true, "body": "姫海棠はたての恋愛シリーズですが、前回の続きをお願いします\n\n\n○ページ2P\n\n○本編\n①はたての乳首に吸い付く彼氏\n②感じながらも勃起した陰茎が目に入るはたて\n③陰茎に恐る恐る手コキをするはたてと感じる彼氏\n④そのまま授乳手コキプレイへ\n⑤射精\n⑥まだドキドキしてるはたて\n\n○彼氏\n・全裸\n○姫海棠はたて\n・局部が丸出しのエロ下着を上下着用\n・体型はこれまでどおり\n⭕️陰毛描写は無しで", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/653", "thumbnail_src": "https://si.imgix.net/41499ecc/uploads/origins/8bc7f235-c711-4b81-8373-a1d2d0c4f1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10bec258bfb2eedeebb39ffe49ca9b58", "thumbnail_srcset": "https://si.imgix.net/41499ecc/uploads/origins/8bc7f235-c711-4b81-8373-a1d2d0c4f1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10bec258bfb2eedeebb39ffe49ca9b58, https://si.imgix.net/41499ecc/uploads/origins/8bc7f235-c711-4b81-8373-a1d2d0c4f1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d5fb25dca578c6aad7ec2ad7d29eae9 2x, https://si.imgix.net/41499ecc/uploads/origins/8bc7f235-c711-4b81-8373-a1d2d0c4f1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31085dee353b3d15bf0fdcdfc38ef254 3x", "genre": "art", "nsfw": true, "body": "姫海棠はたての恋愛シリーズですが、前回の続きをお願いします\n\n話のつながった内容を連続で依頼しましたが、一応これで一旦終わりです\n\n○構図\n・男性目線\n・男性の上に跨るはたて\n\n○差分\n①恥ずかしそうに、今日は私が動いてあげる…と言いながら、騎乗位体勢で挿入しようとするはたて\n②挿入\n③動く\n④動くはたての乳首を弄る彼氏\n⑤絶頂が近くなる二人\n⑥絶頂したはたてと膣内射精した彼氏→余韻\n⑦余韻からの賢者モードに入るはたて→その後彼氏から、今日は凄く大胆だったね、と言われるはたて\n⑧いくら彼氏相手で二人きりならある程度の恥じらいは慣れたといったものの、今回自分らしからぬかなり大胆な性行為を行った影響か、賢者モードの流れもあって一気に恥ずかしくなってきてるはたて\n⑨反応が乏しいはたてに声をかける→実は恥ずかしさから失神していたはたてと焦る彼氏\n\n○姫海棠はたて\n・局部が丸出しのエロ下着を上下着用\n・体型はこれまでどおり\n⭕️陰毛描写は無しで", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/652", "thumbnail_src": "https://si.imgix.net/47972c18/uploads/origins/79c03b5c-f11e-4ae9-8f94-216291364bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=056503a3f4663fa4147e188ea5b90db0", "thumbnail_srcset": "https://si.imgix.net/47972c18/uploads/origins/79c03b5c-f11e-4ae9-8f94-216291364bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=056503a3f4663fa4147e188ea5b90db0, https://si.imgix.net/47972c18/uploads/origins/79c03b5c-f11e-4ae9-8f94-216291364bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a324925f20595a7f2fba9185b31c654 2x, https://si.imgix.net/47972c18/uploads/origins/79c03b5c-f11e-4ae9-8f94-216291364bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67aeb6094db1da0d91705d8e47567bbf 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエスト失礼いたします。\n\nイナズマイレブンのクィールが蒸れた裸足の両足裏を見せつけてくるイラストをお願いします。\n\n下記URLの画像のキャラクターおよび服装でお願いします。\nhttps://drive.google.com/file/d/160KaMQHrmSwy_AZIrSGJqNodIAvH_tEx/view?usp=drive_link\n\n可能であれば白ソックス差分、黒タイツ差分をお願いいたします。\n\n下記URLはキャラクターの画像を集めたフォルダへのリンクとなります。\nhttps://drive.google.com/drive/folders/151lF6ahmszZWvbz41XazLYcf6YIipwlo?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/651", "thumbnail_src": "https://si.imgix.net/fbcb59ec/uploads/origins/a3d0d3cc-c04b-4d2b-a7c0-34aaf7d0de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f0259dd7cc91c489e4f4f1052a83a6", "thumbnail_srcset": "https://si.imgix.net/fbcb59ec/uploads/origins/a3d0d3cc-c04b-4d2b-a7c0-34aaf7d0de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f0259dd7cc91c489e4f4f1052a83a6, https://si.imgix.net/fbcb59ec/uploads/origins/a3d0d3cc-c04b-4d2b-a7c0-34aaf7d0de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efed10a85759e0132a619a0eac47af79 2x, https://si.imgix.net/fbcb59ec/uploads/origins/a3d0d3cc-c04b-4d2b-a7c0-34aaf7d0de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bda005a5bfe696a7e1f484746ca6048e 3x", "genre": "art", "nsfw": true, "body": "姫海棠はたての恋愛シリーズですが、今回は以下の内容をお願いします\n\n\n○設定/あらすじ\nhttps://skeb.jp/@Tutihumaz77/works/638\nからだいぶ経ち、ある程度なら恥じらいが慣れてきてはたては、\nちょっと大胆なプレイをしてみようとサプライズ的な事を考えるのだった\n\n○構図\n①男性目線\n②服を脱ぎその下の下着を見せるはたて\n③はたての頭から腹部くらいが見える構図\n\n○本編\n①顔を赤くしながら、その下の【エロ下着】を見せるはたて\n②驚く彼氏と、たまにはこういうのもいいかと思って…どう？\nと尋ねる\n\n※差分として\n・スイッチが入ってはたてにとびつく彼氏と驚くはたての差分を1つ加えて下さい\n\n※エロ下着は\n性器と乳首が丸出しなデザインの物でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/650", "thumbnail_src": "https://si.imgix.net/46a0b706/uploads/origins/40de7860-bee6-42c1-a0da-5a1db8ce7353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a5a7c4c7da168e68726e0d8a0fb48f5", "thumbnail_srcset": "https://si.imgix.net/46a0b706/uploads/origins/40de7860-bee6-42c1-a0da-5a1db8ce7353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a5a7c4c7da168e68726e0d8a0fb48f5, https://si.imgix.net/46a0b706/uploads/origins/40de7860-bee6-42c1-a0da-5a1db8ce7353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad4c72dcc59ed3a0245ca76792818363 2x, https://si.imgix.net/46a0b706/uploads/origins/40de7860-bee6-42c1-a0da-5a1db8ce7353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a6f5cfb51c189b1bd1655b012ca6186 3x", "genre": "comic", "nsfw": true, "body": "漫画『エム×ゼロ』の9話に、女子がプール掃除している最中に、30秒間水に磁力が発生して体がくっついてしまう魔法がかかり、足がプールにくっついて身動き取れなくなって大変な目に遭う、というシーンがあります。\nこれを磁力が発生するのではなく、粘性が生まれたバージョンのIf漫画がみたいです。\n\n様々な女子が、プールのネバネバ水にくっついて、足を剥がそうと上げたり、バランスを崩して倒れたり、パンツが見えたり、濡れたブラウスが透けたり、ネバネバにくっついた服が引っ張られて脱げたり、といったシーンをお願いできればと思います。", "created_at": "", "completed_at": ""}, {"path": "/@Tutihumaz77/works/649", "thumbnail_src": "https://si.imgix.net/9370a815/uploads/origins/b5ce053e-22e2-48f3-b250-f70bbeaadc3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa1855e3e5736e0d926994e55129559", "thumbnail_srcset": "https://si.imgix.net/9370a815/uploads/origins/b5ce053e-22e2-48f3-b250-f70bbeaadc3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa1855e3e5736e0d926994e55129559, https://si.imgix.net/9370a815/uploads/origins/b5ce053e-22e2-48f3-b250-f70bbeaadc3d?bg=%23fff&auto=format%2Ccompress&fm=we