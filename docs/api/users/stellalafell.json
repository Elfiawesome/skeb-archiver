x.net/b26a4757/uploads/origins/8d2980f0-de94-40bb-9c66-6af1faff8d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b04d13b6cda2eaec0e609dd6dec846bf 2x, https://si.imgix.net/b26a4757/uploads/origins/8d2980f0-de94-40bb-9c66-6af1faff8d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f69a154e36358d647530271e266d398 3x", "genre": "art", "nsfw": true, "body": "以前アカネのイラストをリクエストした者です。素晴らしい作品をありがとうございました。\n\n今回のリクエストについてですが、がんばれゴエモンシリーズのヤエちゃん（スカートスタイルでお願いします）が敵に捕まってしまい、壁に手をついてお尻を突き出した状態にさせられて、スカートをめくられ、後ろからパンツが丸見えになってしまうイラストをお願いしたいです。\n\nパンツは作品の世界観にあった和風な感じで子供っぽさもある柄のパンツでお願いできればと思います。パンツの色は白以外でお願いしたいです。\n\nヤエちゃんは後ろを振り返っていて表情も見れるとありがたいです。\n\nまた、敵は手だけ描かれているので大丈夫です。", "created_at": "", "completed_at": ""}, {"path": "/@stellalafell/works/469", "thumbnail_src": "https://si.imgix.net/ac3566c7/uploads/origins/e2e2acae-cccc-4193-8401-1f4fdf03e127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf2cb2973af117de12c796ae6a6f1347", "thumbnail_srcset": "https://si.imgix.net/ac3566c7/uploads/origins/e2e2acae-cccc-4193-8401-1f4fdf03e127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf2cb2973af117de12c796ae6a6f1347, https://si.imgix.net/ac3566c7/uploads/origins/e2e2acae-cccc-4193-8401-1f4fdf03e127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed4b4abb5fafdf27dee5aa4e4158e0e7 2x, https://si.imgix.net/ac3566c7/uploads/origins/e2e2acae-cccc-4193-8401-1f4fdf03e127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91250b49195a82178e5f4c66d16cfc58 3x", "genre": "art", "nsfw": true, "body": "9yoおまかせで一丁！", "created_at": "", "completed_at": ""}, {"path": "/@stellalafell/works/468", "thumbnail_src": "https://si.imgix.net/27e09c0e/uploads/origins/b89a4f2f-ab7a-4492-9a42-4877f0efb82b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05b9e1e6477a7573f38e6a8f8a104b83", "thumbnail_srcset": "https://si.imgix.net/27e09c0e/uploads/origins/b89a4f2f-ab7a-4492-9a42-4877f0efb82b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05b9e1e6477a7573f38e6a8f8a104b83, https://si.imgix.net/27e09c0e/uploads/origins/b89a4f2f-ab7a-4492-9a42-4877f0efb82b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70b8685513035eaca07a8b3ca1c9d3c5 2x, https://si.imgix.net/27e09c0e/uploads/origins/b89a4f2f-ab7a-4492-9a42-4877f0efb82b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82954e8e6214d4d46ae3d2e825a504aa 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストありがとうございます\n38回目のリクエストよろしくお願いします\n\nキャラクター\n左:ヤマトタケル（Fate）\n右:行秋（原神）\nヤマトタケルは巨根、行秋も巨根でお願いします\n\nシチュ\n怯えた表情で素っ裸命乞いオナニーをしている二人をお願いします\nヤマトタケル:右手にふんどしを棒に結んだ白旗を振り、左手でチンポをしごく\n行秋:左手で女物の白パンツ（ワンポイントリボンが青色）を棒に括り付けた白旗代わりを振り、右手でチンポをしごく\n地面には折れた剣が2本落ちている\n\n\n以上、よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@stellalafell/works/467", "thumbnail_src": "https://si.imgix.net/8f0e98de/uploads/origins/9198fa44-5fa6-498a-8a99-3024d35eb12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4296effdd802454b5fe5cfa143dd0e14", "thumbnail_srcset": "https://si.imgix.net/8f0e98de/uploads/origins/9198fa44-5fa6-498a-8a99-3024d35eb12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4296effdd802454b5fe5cfa143dd0e14, https://si.imgix.net/8f0e98de/uploads/origins/9198fa44-5fa6-498a-8a99-3024d35eb12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daddbd20b3794413d54ea3fdb51ebf5c 2x, https://si.imgix.net/8f0e98de/uploads/origins/9198fa44-5fa6-498a-8a99-3024d35eb12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6dafdbbaa6918a0b91c663a1a158f6a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@stellalafell/works/466", "thumbnail_src": "https://si.imgix.net/2a421a4c/uploads/origins/13348a1d-bbbe-4699-b3b1-3b1f7be8f226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56cae8e44c28403120c9054edd77766e", "thumbnail_srcset": "https://si.imgix.net/2a421a4c/uploads/origins/13348a1d-bbbe-4699-b3b1-3b1f7be8f226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56cae8e44c28403120c9054edd77766e, https://si.imgix.net/2a421a4c/uploads/origins/13348a1d-bbbe-4699-b3b1-3b1f7be8f226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b6f3dc6522a84e46819eebef4a58843 2x, https://si.imgix.net/2a421a4c/uploads/origins/13348a1d-bbbe-4699-b3b1-3b1f7be8f226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40b15293c14b7ed48e1b75be8dfd6256 3x", "genre": "art", "nsfw": true, "body": "リクエストさせていただきます！\nポケモンXYのオカルトマニアとポケモンレジェンズZ-Aのオカルトマニアがポケモンの念力で宙に浮かされた状態で服を脱がされた後おしっことうんちをお漏らししてしまう絵をお願いします！\n服装は両者とも特殊でない普通の服装で、お願いします。\nXYオカルトマニアの下着は、白地に女児アニメ柄の大きなフロントプリントが入っている、正面にピンク色のリボンのついたインゴムのお子様パンツと同じフロントプリントが入っている白いキャミソールで、ZAオカルトマニアの下着は、薄い紫色地に濃い紫色とピンク色の小さなハート柄の散りばめられた、正面に濃い紫色のリボンのついたお子様パンツと薄い紫色地でパンツと同じ濃い紫色とピンク色の小さなハート柄のキャミソールでお願いします。二人ともショーツにはおしっこのシミが少しついているようにお願いします。\n2人の体型は以前すてらさんが描かれていたむちむちアニラと同じくらいかそれより少し太っているくらいの太り具合でお願いします。\n【参照URL】\nhttps://www.pixiv.net/artworks/110492727\nまた腋毛と陰毛はふさふさでお願いします。\n\n状況変化として、下記の差分をお願いします。\n・スカートが捲れ上がり、パンツが見えている状態。\n・服を完全に脱がされて、下着と靴下だけになっている状態。この時点ではキャミソールの裾はパンツのゴムの中に入っている。\n・キャミソールの裾を捲られて下腹の贅肉が顕になっている状態。\n・おしっこをちびり、パンツにおしっこシミが広がっている状態。\n・おしっこを漏らしてしまった状態。\n・おしっこを漏らした後うんちもちびってしまい、うんちシミがパンツのお尻についている状態。(この差分では漏れたうんちが見やすいようにワイプのような形でお尻も後ろから映してください。)\n・うんちも漏らしてしまい、パンツがこんもりしている状態。\n・うんちの重みでパンツがずり落ちて、まんこが見えてしまっている状態。\n・漏らしたパンツを頭に被せられた上で(脚を通す穴が頭の両横に向く水泳帽のような被せられ方)さらにおしっことうんちを漏らしてしまっている状態。\n\n表情に関してはお任せいたします。\n\n細かい依頼で恐縮ですが、ご確認をお願いいたします！\n\nhttps://www.pixiv.net/artworks/110492727", "created_at": "", "completed_at": ""}, {"path": "/@stellalafell/works/465", "thumbnail_src": "https://si.imgix.net/76b26e21/uploads/origins/db0e90b0-7660-43f7-9a7a-4cdee968853b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dec3ae2a43abbd1f7f54476aa914632", "thumbnail_srcset": "https://si.imgix.net/76b26e21/uploads/origins/db0e90b0-7660-43f7-9a7a-4cdee968853b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dec3ae2a43abbd1f7f54476aa914632, https://si.imgix.net/76b26e21/uploads/origins/db0e90b0-7660-43f7-9a7a-4cdee968853b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af17092216ffeb902ee3ab35d37b1c3d 2x, https://si.imgix.net/76b26e21/uploads/origins/db0e90b0-7660-43f7-9a7a-4cdee968853b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e7146a5dc5dce264b8151d2d0da343a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@stellalafell/works/464", "thumbnail_src": "https://si.imgix.net/fcf21575/uploads/origins/7e4f71ef-16b3-4172-9623-3e65b17e5437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87f1132fb57cd200479ef45ef7139ba2", "thumbnail_srcset": "https://si.imgix.net/fcf21575/uploads/origins/7e4f71ef-16b3-4172-9623-3e65b17e5437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87f1132fb57cd200479ef45ef7139ba2, https://si.imgix.net/fcf2157