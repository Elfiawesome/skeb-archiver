9-21T01:05:30.428372"}, {"amount": 500, "recorded_at": "2025-10-03T16:58:17.540414"}, {"amount": 500, "recorded_at": "2025-10-06T11:55:20.521945"}]}, "current_prices": {"art": 10000, "comic": 15000, "video": 15000, "correction": 500}, "price_range": {"art": {"min": 10000, "max": 10000}, "comic": {"min": 15000, "max": 15000}, "video": {"min": 15000, "max": 15000}, "correction": {"min": 500, "max": 500}}, "links": [{"label": "Twitter", "url": "https://x.com/itouyou0304", "name": "itouyou0304"}, {"label": "Website", "url": "https://youtube.com/@itouyou0304?si=pQO4wqqVFZAw0Xxv", "name": ""}, {"label": "BOOTH", "url": "https://itouyou0304.booth.pm", "name": "itouyou0304"}, {"label": "SKIMA", "url": "https://skima.jp/profile?id=424841", "name": "424841"}], "flags": {"from_archive": true}, "works": [{"path": "/@itouyou0304/works/115", "thumbnail_src": "https://si.imgix.net/21a33e63/uploads/origins/d5aa7f5f-c89b-4436-b85e-90783fda5816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02f07a204db5a250eeb195b281616ba7", "thumbnail_srcset": "https://si.imgix.net/21a33e63/uploads/origins/d5aa7f5f-c89b-4436-b85e-90783fda5816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02f07a204db5a250eeb195b281616ba7, https://si.imgix.net/21a33e63/uploads/origins/d5aa7f5f-c89b-4436-b85e-90783fda5816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01fc7ac7a0acab7e755c441400f4cb46 2x, https://si.imgix.net/21a33e63/uploads/origins/d5aa7f5f-c89b-4436-b85e-90783fda5816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4684bb2a2eebc520ab47fc9cf16c6d9c 3x", "genre": "art", "nsfw": false, "body": "いとうよう先生\n\nはじめまして、\nVtuber（動画勢ですが、まだ動画は準備中です）の小休もなと申します。\n写真を背景にされたイラストが素敵だなと思い、ぜひ1枚お願いしたくリクエストをお送りしました。\n\n◆依頼内容\n旅行した際に撮影した写真に、小休のイラストを描いてほしいです。\n参考資料が立ち絵1枚しかなくて恐縮です。ポーズや表情はお任せします。\n\n背景用の写真は、真冬に兵庫県の赤穂に行った際に自分で撮影したものです。\n写真の明るさの変更やトリミングなどは自由に行なっていただいて問題ございません。\n\n◆小休の詳細\n名前：小休もな（Koyasumi Mona）\n種族：ボタンヅルの妖精\n年齢：不明\n身長：160cm\n仕事：コピーライター\n旅行系Vtuberです！\n\n◆使用用途\nYoutubeの動画やサムネイル\nブログの記事やそのアイキャッチ画像\nSNSでの利用（旅行の動画やブログ記事ができたことのお知らせ）\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/122kaUILSN76JTdfoTgmNw-HvTN3IxU6U?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/114", "thumbnail_src": "https://si.imgix.net/83f54a48/uploads/origins/d67ce6ec-01c3-4786-bc76-b7cd28d0cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc0b16bd8c81c4558e0a3843ada2b58", "thumbnail_srcset": "https://si.imgix.net/83f54a48/uploads/origins/d67ce6ec-01c3-4786-bc76-b7cd28d0cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc0b16bd8c81c4558e0a3843ada2b58, https://si.imgix.net/83f54a48/uploads/origins/d67ce6ec-01c3-4786-bc76-b7cd28d0cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5767b641d9543459e6f7739887bad3c 2x, https://si.imgix.net/83f54a48/uploads/origins/d67ce6ec-01c3-4786-bc76-b7cd28d0cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7c8ee6b6d21aa43fd62f323fe6e7505 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/113", "thumbnail_src": "https://si.imgix.net/a000fc7e/uploads/origins/0d038fc9-cb31-4b85-963d-a4b8f10fd5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5e5ee9c835e22b566176fce8f4dcfb3", "thumbnail_srcset": "https://si.imgix.net/a000fc7e/uploads/origins/0d038fc9-cb31-4b85-963d-a4b8f10fd5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5e5ee9c835e22b566176fce8f4dcfb3, https://si.imgix.net/a000fc7e/uploads/origins/0d038fc9-cb31-4b85-963d-a4b8f10fd5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e5d1ce968e338d730a35eeaa7e95bf8 2x, https://si.imgix.net/a000fc7e/uploads/origins/0d038fc9-cb31-4b85-963d-a4b8f10fd5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f56156e9439db4807a12f5de3b322a7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/112", "thumbnail_src": "https://si.imgix.net/45562ea3/uploads/origins/2266f74c-717f-4193-b9a7-c95d6c561420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3c94827fcb44ddddd9b643411c35fd8", "thumbnail_srcset": "https://si.imgix.net/45562ea3/uploads/origins/2266f74c-717f-4193-b9a7-c95d6c561420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3c94827fcb44ddddd9b643411c35fd8, https://si.imgix.net/45562ea3/uploads/origins/2266f74c-717f-4193-b9a7-c95d6c561420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d5312c2e9467580d8e0115747a001f7 2x, https://si.imgix.net/45562ea3/uploads/origins/2266f74c-717f-4193-b9a7-c95d6c561420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a895e5879af476e5375216958108e900 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ニューロ様とイービル・ニューロのファンアートを一緒に描いていただきたいです。\n\n二人はよくスカイダイビングに行く話をしています（https://drive.google.com/file/d/1pCxCfKisgP0ou0uFZaU1TVvw_s-b4In6/view?usp=sharing）。可能であれば、抱き合いながらスカイダイビングをしている姿を描いてください。背景はお好きなものを選んでいただいて構いません。必ずヘアピンを描き込んでくださいね :)\n\n以下がニューロ様とイービル・ニューロのキャラクター参考画像です：https://drive.google.com/drive/u/1/folders/1XCtf5v3F2ha9zxT_x5G_9TdBDjKy7DTM", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/111", "thumbnail_src": "https://si.imgix.net/012b1375/uploads/origins/9b008cdd-3f59-486b-8140-e5c37803078a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4aa62a93457a70d4bdfd74ae32d2129", "thumbnail_srcset": "https://si.imgix.net/012b1375/uploads/origins/9b008cdd-3f59-486b-8140-e5c37803078a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4aa62a93457a70d4bdfd74ae32d2129, https://si.imgix.net/012b1375/uploads/origins/9b008cdd-3f59-486b-8140-e5c37803078a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e19e39edd326981cc3725a925dacb651 2x, https://si.imgix.net/012b1375/uploads/origins/9b008cdd-3f59-486b-8140-e5c37803078a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5db5edbd6b476a1cf9e2998b3aea46d4 3x", "genre": "art", "nsfw": false, "body": "いとうよう先生、アピールありがとうございました。\nいとうよう先生、はじめてのご依頼させていただきます。\n今回の依頼はIRIAMで活動中のVライバー｢くま瀬まく｣のFAを描いていただきたく依頼させてもらいました。\nなお、これはくま瀬まく本人に渡す予定なのでPSDでの納品をお願いします。\n〈お姿〉\nhttps://x.com/vt_kumase__/status/1573213376410701824?s=46\n身長は150cmぐらいだと思います。\n〈衣装〉\nお姿の衣装を参照してください。\n〈背景〉\n背景は夕日が差し込む海辺の写真でお願いします。\n〈ポーズ、表情〉\nポーズは海を蹴り上げてはしゃぐ感じのポーズでお願いします。\n表情は幼い感じに無邪気な笑顔でお願いします。\n〈使用用途〉\nXのおはVやIRIAMでのサムネに使用（Xで投稿する際はウォーターマークをつけるようくま瀬まく本人に伝えます）\nデジタルグッズ、リアルグッズでの使用\n〈備考〉\n背景とキャラクターは別レイアーでお願いします。\n\nご検討の程よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/110", "thumbnail_src": "https://si.imgix.net/27c32517/uploads/origins/d119cf2f-2461-409b-9f66-a313978cd208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89924e76a576ffd2037655adf1c37b65", "thumbnail_srcset": "https://si.imgix.net/27c32517/uploads/origins/d119cf2f-2461-409b-9f66-a313978cd208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89924e76a576ffd2037655adf1c37b65, https://si.imgix.net/27c32517/uploads/origins/d119cf2f-2461-409b-9f66-a313978cd208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cfed142c6616cdbb11c0871de899c0d 2x, https://si.imgix.net/27c32517/uploads/origins/d119cf2f-2461-409b-9f66-a313978cd208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=854500418af016c6a5ba7b5e5122527f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの風景に描かれたアニメキャラクターの画像をいくつか見ていたのですが、グーグルドライブのフォルダhttps://drive.google.com/drive/folders/1BH58dS6rxPBBSYb-WbjZq9gH1HPsqOpq?usp=sharing。\n\nキャラクターは身長155cmの「ハスノソラ」の日下夏帆です（キャラクターリファレンスはフォルダ内にあります）。表情やポーズは問いません。黄色い晴れ着を着て、大きな帽子をかぶって野原で遊んでいてほしい。\n\nご覧いただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1BH58dS6rxPBBSYb-WbjZq9gH1HPsqOpq?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/109", "thumbnail_src": "https://si.imgix.net/50f86c19/uploads/origins/4bed7b4d-0031-4a9b-8104-fe2f92ba8077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e05a386038094e30c93e264e8475532c", "thumbnail_srcset": "https://si.imgix.net/50f86c19/uploads/origins/4bed7b4d-0031-4a9b-8104-fe2f92ba8077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e05a386038094e30c93e264e8475532c, https://si.imgix.net/50f86c19/uploads/origins/4bed7b4d-0031-4a9b-8104-fe2f92ba8077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9e4ae3b7f39650b49e766e3558728ed 2x, https://si.imgix.net/50f86c19/uploads/origins/4bed7b4d-0031-4a9b-8104-fe2f92ba8077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9c7ad094fea0e8e8a5735af8c80cb91 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたからのアピールを受けて光栄です。お言葉に甘えさせていただきます。前回納品された私の狐娘の学生服姿の作品をご覧になったと思います。\n\nその格好かそれに近い格好で、電車の中で眠っているキャラクターをお願いします。ギャラリーの最後の2番目の画像と同じように、頭を後ろに向け、口を開けて。大げさな寝顔で、口が上向きで、顔によだれがついているようなイメージです。キャラクターの参考資料もいくつか載せました。最初のものは衣装ですが、アーティストは彼女のバストサイズを先取りしてしまったようです。他の写真でわかるように、彼女は実際には小さめで、Aか小さめのBカップです。身長は157cm。\n彼女のデザインには多少のバリエーションがあります。\n耳は1枚目と6枚目の写真のように長いです。\n耳の中の綿毛は白い。\n尻尾の先が白くなっている。\n\nhttps://imgchest.com/p/ljyqk6exoy2", "created_at": "", "completed_at": ""}, {"path": "/@itouyou0304/works/108", "thumbnail_src": "https://si.imgix.net/bc7e77a7/uploads/origins/9d6ff5e2-9756-415b-be64-568b17369faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00eba070204d13f3a5f464c044169e38", "thumbnail_srcset": "https://si.imgix.net/bc7e77a7/uploads/origins/9d6ff5e2-9756-415b-be64-568b17369faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00eba070204d13f3a5f464c044169e38, https://si.imgix.net/bc7e77a7/uploads/origins/9d6ff5e2-9756-415b-be64-568b17369faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5dfeeb83e8978a9f38e1208e6e12b63 2x, https://si.imgix.net/bc7e77a7/uploads/origins/9d6ff5e2-9756-415b-be64-568b17369faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1187c9c9d243e78b0eb3d8ffe8f2c92e 3x", "genre": "art", "nsfw": false, "body": "こんばんは、アピールありがとうございます!\n現実の写真を背景にして、実際にそこにいるようにというコンセプトがとっても素敵で、ぜひ描いていただきたく依頼失礼します。\n\n背景には、こちらのツイート,リプの写真の中から構造に合わせて選んでいただきたいです。(撮影者のお砂糖18グラムさんには、今回の依頼での写真の使用許可をもらってます)\nhttps://x.com/i/status/1958043229485719579\n\n構造は、\n(写真1枚目)ひまわり畑の前でひめちゃんと飼い猫のふゆちゃんがしゃがんで遊んでいる\n(写真6枚目)鐘の下でふゆちゃんを抱き上げる、もしくは鐘を鳴らしている\n(写真8枚目)ひまわりの間を歩いている、もしくは手前の大きなひまわりに手を添えて眺めている\nその他いとうよう様のおまかせ\nの中からどれかお願いします。\nひめちゃんはひまわりが好きなので、ひまわりがよく見えるように描いていただきたいです。\n\n\nひめちゃん本人のSNSアイコン、SNSにあげるおはVや予定表での使用、サムネイルの使用の可能性がありますので、ご了承いただけますと幸いです。\nぜひよろしくお願いします!\n\n\nリンク集\nhttps://1link.jp/inkyahime\n\n通常衣装\nhttps://x.com/HN_inkyahime/status/1911910354898309464?t=a28VZRBNtGEdahTeb8ZEJA&s=19\nメイド衣装\nhttps://x.com/HN_inkyahime/status/1924577178597130542?t=iv9USlmcBKEdSG-RZqdYdQ&s=06\nアイドル衣装\nhttps://x.com/HN_inkyahime/status/1924820520136278204?t=iv9USlmcBKEdSG-RZqdYdQ&s=06\n秋服衣装\