ちゃうフランが見たいです。\nコーデが可愛い子なのである程度着衣を残したままでお願いします。（服装はモンク姿でお願いします）\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@toshima19699496/works/165", "thumbnail_src": "https://si.imgix.net/150bb9e3/uploads/origins/c35d0b2c-7c94-46c7-baf9-90b30e85d9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=835b1008c6eec7977314802821b64a38", "thumbnail_srcset": "https://si.imgix.net/150bb9e3/uploads/origins/c35d0b2c-7c94-46c7-baf9-90b30e85d9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=835b1008c6eec7977314802821b64a38, https://si.imgix.net/150bb9e3/uploads/origins/c35d0b2c-7c94-46c7-baf9-90b30e85d9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47d8d46524d9726310c8004afea7e383 2x, https://si.imgix.net/150bb9e3/uploads/origins/c35d0b2c-7c94-46c7-baf9-90b30e85d9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=186d4fed8fae3329d6a5d52e8caaed61 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@toshima19699496/works/164", "thumbnail_src": "https://si.imgix.net/3f2b33ca/uploads/origins/ac8cee26-6c56-44ba-b61c-9f74f5197149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58f880aab2ed8f7cb26beabe4d73b88d", "thumbnail_srcset": "https://si.imgix.net/3f2b33ca/uploads/origins/ac8cee26-6c56-44ba-b61c-9f74f5197149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtali