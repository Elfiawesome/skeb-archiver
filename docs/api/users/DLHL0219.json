53/uploads/origins/6499780b-bebd-41f3-9f09-18748d8c18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4942e5da48e924ad4096084e096385ca 2x, https://si.imgix.net/7c494853/uploads/origins/6499780b-bebd-41f3-9f09-18748d8c18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25c0f5f2d1f32012651daf03b4884a30 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私を描いて貰えないでしょうか！\n\n本を読んでいた私が、可愛らしく画面の方を見ているところをお願いしたいです。\n（読んでいる本は小説とか童話とかです）\nポーズなど詳細はお任せします。\n明るく楽しく可愛い感じに描いて頂けたら嬉しいです！\n\nどうぞよろしくお願いいたします！\n\n※イラストの用途ですが、SNSで使用したり、紹介したり、配信する動画に利用するなど、みつみつきの活動全般に使用するかもしれません\nキャラクター・背景・宛名はレイヤー分けしたものをいただけると嬉しいです（PSDで頂戴できると幸いです）\n\nhttps://skeb.jp/@shiro_1ma2/works/1", "created_at": "", "completed_at": ""}, {"path": "/@DLHL0219/works/165", "thumbnail_src": "https://si.imgix.net/7da61630/uploads/origins/922ec018-fbaa-4e8b-a341-51d963db86e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=287b8cda10bbd3e383888444d2d11cda", "thumbnail_srcset": "https://si.imgix.net/7da61630/uploads/origins/922ec018-fbaa-4e8b-a341-51d963db86e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=287b8cda10bbd3e383888444d2d11cda, https://si.imgix.net/7da61630/uploads/origins/922ec018-fbaa-4e8b-a341-51d963db86e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc91e4d6f4f099a6051d697ba6c9a4a8 2x, https://si.imgix.net/7da61630/uploads/origins/922ec018-fbaa-4e8b-a341-51d963db86e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39daabdc6c3f72021cd189d409d67b90 3x", "genre": "art