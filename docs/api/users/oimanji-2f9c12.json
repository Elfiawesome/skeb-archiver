6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920f38b433f933423283b0fee3d2a2b2, https://si.imgix.net/7a210f9f/uploads/origins/87132961-0bde-4afe-a902-677e75ef2646?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52ab17b0dac1576082498b55c2b55d48 2x, https://si.imgix.net/7a210f9f/uploads/origins/87132961-0bde-4afe-a902-677e75ef2646?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cae8ee9035bf99e2672af4584332705 3x", "genre": "art", "nsfw": true, "body": "先日はありがとうございました\nリクエスト失礼します\n\n名探偵プリキュアの帆羽くれあがモブ竿役に背後から犯されるイラストをお願いします\nコスチュームは着衣状態でパティシエ服でお願いします\n\n先生の過去作、こちらを参考に構図などは先生にお任せします\nhttps://skeb.jp/@oimanji/works/1226\n\nキャラの資料も下記にお付けします\n\nhttps://www.toei-anim.co.jp/tv/precure/character/people.php?chara=kurea_howa", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1462", "thumbnail_src": "https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c6e3eb83da083fb2c63a071aac5b3a", "thumbnail_srcset": "https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c6e3eb83da083fb2c63a071aac5b3a, https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94138e49e14e6b5114e56aa845c84a0e 2x, https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=612fd1befb664d2c68271a2af44694e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1461", "thumbnail_src": "https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854794e2f60700c44f90c80f5f175e19", "thumbnail_srcset": "https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854794e2f60700c44f90c80f5f175e19, https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da60568d8c013dd6ac0d9637559527dc 2x, https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8698d3c400be2225334719d4f34e0f19 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\n\"借り暮らしのアリエッティ”のアリエッティちゃんの状況を見たいのですが。アリエッティちゃんは盗みながら隣人の子供に捕らえられ、今ではかわいい裸のペットとして飼われています。絵の中で、彼女のヘアクリップを除いて裸で、彼女の所有者の部屋で四つんばいで這うアリエッティを描いてください ​彼女は良い子のように所有者の巨大な指から餌をなめています。彼女は屈辱を受け、不幸ですが、適度によく訓練ており従順です。彼女の身長は10cm弱で.", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1460", "thumbnail_src": "https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a604e57c810e44e39bbfac775e5919", "thumbnail_srcset": "https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a604e57c810e44e39bbfac775e5919, https://si.imgix.net/603b9cf0/uploads/origins