leted_at": ""}, {"path": "/@ochagohan_/works/22", "thumbnail_src": "https://si.imgix.net/c6969822/uploads/origins/ba326251-04e4-492b-b538-20ac5b9cce4c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=36da04713824a10c012c400a4a2d150c", "thumbnail_srcset": "https://si.imgix.net/c6969822/uploads/origins/ba326251-04e4-492b-b538-20ac5b9cce4c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=36da04713824a10c012c400a4a2d150c, https://si.imgix.net/c6969822/uploads/origins/ba326251-04e4-492b-b538-20ac5b9cce4c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=0869c87d0dae1bab08b2942dfe9bc636 2x, https://si.imgix.net/c6969822/uploads/origins/ba326251-04e4-492b-b538-20ac5b9cce4c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5273de17baf89b1b97d2a24a61d5e9fe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVtuber、Lanoraのジェスター姿の絵をお願いしたいのですが。ラノーラはエレガントで、遊び心があり、ミステリアスで、不気味なゴシックスケルトンの女の子です。彼女の肌は灰色で、強膜は黒く、舌と歯は青く、骨の細部が肌から見えます。\n\n好きなようにポーズをとってください！ジェスターのフードをかぶっていても、はずしてもかまいません。ありがとうございました！❤️\n\nジェスター服の参考：https://drive.google.com/file/d/1dHKvfhBOV-5MV6FxlgtH3NzHr07uAtwB/view?usp=drivesdk\nベース・リファレンス（キャラクター詳細用）: https://drive.google.com/file/d/1PyFtqouip0xQmaZPM19Iyt_J4ujy1A2B/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@ochagohan_/works/21", "thumbnail_src": "https://si.imgix.net/ddbedcd6/uploads/origins/de6b33c1-af71-4909-b988-095bd1ae87e2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fd39ead4bc6d7416cc24c99ade668866", "thumbnail_srcset": "https://si.imgix.net/ddbedcd6/uploads/origins/de6b33c1-af71-4909-b988-095bd1ae87e2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fd39ead4bc6d7416cc24c99ade668866, https://si.imgix.net/ddbedcd6/uploads/origins/de6b33c1-af71-4909-b988-095bd1ae87e2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a32e6d9fda061d8b2b260ecb335ce8e 2x, https://si.imgix.net/ddbedcd6/uploads/origins/de6b33c1-af71-4909