f-4f4e-9acf-1312f4c0ca41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530472568e564987edffdce37d4f0b2f", "thumbnail_srcset": "https://si.imgix.net/2be17d95/uploads/origins/4d847569-153f-4f4e-9acf-1312f4c0ca41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530472568e564987edffdce37d4f0b2f, https://si.imgix.net/2be17d95/uploads/origins/4d847569-153f-4f4e-9acf-1312f4c0ca41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7a9fc8cf74772c3880a73e70f31f7d8 2x, https://si.imgix.net/2be17d95/uploads/origins/4d847569-153f-4f4e-9acf-1312f4c0ca41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d54219970a4f3f444ef7c37c77e95e5 3x", "genre": "art", "nsfw": true, "body": "初めまして。Vtuberの猫山みあちゃんを描いていただきたいです。\nhttps://x.com/nekoyama_miaaa\n・下着姿（上下白）と白ワイシャツ（長袖）で座った構図。\n・左足は伸ばす。右足は曲げる。左手は体の横について右手は首の後ろ。\n・視点は正面。\n・顔は少し赤らめる。\n・下着のみ差分。\n・下着無し差分。\n足の位置は下記URLを参考にしてください（こちらは左右逆）。\nhttps://x.com/belca8492/status/1945064201632014415\n\n仕様用途はXやYouTube（収益化済）でのサムネ、ファンボックスでの配布です。\nPSDでの納品を希望します。", "created_at": "", "completed_at": ""}, {"path": "/@rota_kokko/works/24", "thumbnail_src": "https://si.imgix.net/35ba4654/uploads/origins/b99247cd-6437-4999-9851-fc3afcf0d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f89e7c036ca4c3dfa89d104c5d85810c", "thumbnail_srcset": "https://si.imgix.net/35ba4654/uploads/origins/b99247cd-6437-4999-9851-fc3afcf0d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f89e7c036ca4c3dfa89d104c5d85810c, https://si.imgix.net/35ba4654/uploads/origins/b99247cd-6437-4999-9851-fc3afcf0d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6abea3ec8cc67e229c064181a8c38adc 2x, https://si.imgix.net/35ba4654/uploads/origins/b99247cd-6437-4999-9851-fc3afcf0d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d83c2404cacdae2982c18c5e3d3a6406 3x", "genre": "a