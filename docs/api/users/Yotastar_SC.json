fc9d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91fa3fd88c9a75eff92880c8628b401f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またお会いできて嬉しいです。昨年のレイ・クゴのイラスト、ありがとうございました！\n\n「オクトパストラベラー0」のレイメのイラストをお願いできますか？具体的なイメージは持っておらず、お任せしたいと思っています。ルビーハートのイラストのような角度、あるいは何らかのローアングルで描いていただけると嬉しいです。ただし、彼女をクールに、あるいはセクシーに見せる全く新しいアイデアがあれば、そちらも大歓迎です。\nあと、胸を少し大きく描いていただけますか？谷間が見えるくらいでもいいです。背景は気にしないでください。シンプルな暗い色で結構です。よろしくお願いします！https://drive.google.com/drive/folders/1ozXLQLFauFSssQ9IeN0cNMhxhs9QUhwt?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Yotastar_SC/works/98", "thumbnail_src": "https://si.imgix.net/74d69642/uploads/origins/c30f884a-8d84-4ac1-b2d6-cb65806c56fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f07bab08713ae3193ab830390de201c", "thumbnail_srcset": "https://si.imgix.net/74d69642/uploads/origins/c30f884a-8d84-4ac1-b2d6-cb65806c56fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f07bab08713ae3193ab830390de201c, https://si.imgix.net/74d69642/uploads/origins/c30f884a-8d84-4ac1-b2d6-cb65806c56fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b90caad674fecbd06104426c3710af5 2x, https://si.imgix.net/74d69642/uploads/origins/c30f884a-8d84-4ac1-b2d6-cb65806c56fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1fe1adf0ef6de70c02802de5ee51ff4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Yotastar_SC/works/97", "thumbnail_src": "https://si.imgix.net/fbab713e/uploads/origins/115990b7-5481-474d-9d1d-274828f6fa0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8755c1f94a4e392db2ad31648bfc893", "thumbnail_srcset": "https://si.imgix.net/fbab713e/uploads/origins/115990b7-5481-474d-9d1d-274828f6fa0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8755c1f94a4e392db2ad31648bfc893, https://si.imgix.net/fbab713e/uploads/origins/115990b7-5481-474d-9d1d-274828f6fa0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5939f23b03e5d6f5d7547732e21112af 2x, https://si.imgix.net/fbab713e/uploads/origins/115990b7-5481-474d-9d1d-274828f6fa0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a033245239d2781d08bafc5365a1e279 3x", "genre": "art", "nsfw": true, "body": "またこんにちは！可能であれば追加リクエストがあります。キャラクター：『鉄拳』のザフィナ（この衣装：https://tekken.fandom.com/wiki/Zafina/Gallery?file=Zafina_TTT2.png）。彼女のトップスは引き裂かれており、胸がはみ出し、乳首が完全に露出しています。 衣装の他の部分も破れ損傷し、肌がさらに多く露出している。状況：ザフィナが屈辱的な敗北を喫する。尻餅をついて追い詰められた状態！複数の精液の塊が彼女の体に飛び散る。片腕を上げて身を守り、もう一方の手は指を広げて相手を制止するよう合図している。 腕と手からは精液が滴り落ちる。片目は閉じられ、精液が飛び散っている。もう片方の目は衝撃と苛立ちで大きく見開かれている。鉄拳の戦闘ビジュアルへのオマージュとして、衝撃エフェクトも追加してほしい。（攻撃が命中した際に表示される「HIGH」「MIDDLE」「LOW」の文字と共に現れる、小さなオレンジがかった黄色の爆発エフェクト。例： https://cdn.arstechnica.net/wp-content/uploads/2017/06/20170602131044_1-scaled.jpg または https://absolvergame.com/forums/discussion/27615/high-mid-low-attacks-and-guarding-to-high-mid-low）。 精液が目に飛び散るため、頭部付近に「HIGH」インパクトエフェクトを表示。腰付近に「LOW」インパクトエフェクト、片方の胸付近に「MIDDLE」インパクトエフェクトを表示（胸には精液がべったり付着し、塊がまだ爆発中）。詳細な仕様はご自由にお決めください。ご検討いただきありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@Yotastar_SC/works/96", "thumbnail_src": "https://si.imgix.net/a20f9412/uploads/origins/0bbac65c-345d-4541-bf8d-d8bcdeae66cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4acc1857249fc909a5ef0df0ec8a7fbc", "thumbnail_srcset": "https://si.imgix.net/a20f9412/uploads/origins/0bbac65c-345d-4541-bf8d-d8bcdeae66cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4acc1857249fc909a5ef0df0ec8a7fbc, https://si.imgix.net/a20f9412/uploads/origins/0bbac65c-345d-4541-bf8d-d8bcdeae66cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1651f61b566fa13e5e7fc8d022ef3be 2x, https://si.imgix.net/a20f9412/uploads/origins/0bbac65c-345d-4541-bf8d-d8bcdeae66cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5619a72fc84554ee8e8241fea7613cde 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは、前回のご依頼、本当に素晴らしかったです！新たなリクエストをさせてください。キャラクター：『鉄拳タッグトーナメント』（https://tekken.fandom.com/wiki/Unknown/Gallery?file=Unknown-poster.jpg）のアンノウン。彼女のキャラクターデザインと同様に、薄い黒と紫のスライムに覆われています。 ただし、スライムは胸を覆っていません。乳房と乳首が完全に露出しています。状況：彼女は身体交換の被害者です！彼女の身体はカエルの像と入れ替わりました。これにより、彼女は似たような姿勢を取っています。四つん這いで、カエルのように地面に低くしゃがんでいます。舌を出し、虚ろな目つきをしています。乳房はだらりと垂れ下がり、乳首が露わになっています。 通常彼女の後ろに現れる狼の精霊の代わりに、カエルの精霊が浮かんでいる。（ポーズと状況の参考：https://x.com/seki_6196/status/1979529462896349246）。細部の描写はご自由にお任せします。ご依頼をご検討いただきありがとうございます！\n\nhttps://tekken.fandom.com/wiki/Unknown", "created_at": "", "completed_at": ""}, {"path": "/@Yotastar_SC/works/95", "thumbnail_src": "https://si.imgix.net/d45f74b8/uploads/origins/72d277a2-070e-42e7-ad81-4c01674958b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b18f509844f7e650ed2c27e15ae0d222", "thumbnail_srcset": "https://si.imgix.net/d45f74b8/uploads/origins/72d277a2-070e-42e7-ad81-4c01674958b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b18f509844f7e650ed2c27e15ae0d222, https://si.imgix.net/d45f74b8/uploads/origins/72d277a2-070e-42e7-ad81-4c01674958b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e520c9cc8f1021366c227a923b0b657 2x, https://si.imgix.net/d45f74b8/uploads/origins/72d277a2-070e-42e7-ad81-4c01674958b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb35d543496d6cf0b5ba5835829ab1c5 3x", "genre": "art", "nsfw": true, "body": "蜘蛛尼僧納品ありがとうございます。\nhttps://skeb.jp/@Yotastar_SC/works/92\n前回の続きのイメージでお願いします。\nお願いしたいポイントを箇条書きにしていきます。お付き合いお願いします。\n①お願いしたいシチュ…少年退魔師完全敗北。蜘蛛尼僧の蜘蛛糸に繭にされる。\n下記資料先の様に繭にした少年退魔師を巣の奥まで引きずり込んでいく尼僧をお願いします。\nhttps://skeb.jp/@HHy9i/works/341\nhttps://skeb.jp/@UC91776165/works/421\nhttps://skeb.jp/@takoppai/works/13\nhttps://www.pixiv.net/artworks/103627777\n②お願いしたいポイント、構図。\n以前お願いしたマキマさんや他の資料の様に布越しにお尻のラインとデカケツ感とムチムチ感が\n強調されるイメージでお願いします。\nhttps://skeb.jp/@Yotastar_SC/works/90\nhttps://skeb.jp/@HHy9i/works/256\nhttps://x.com/raita_z/status/1846174406588223936/photo/2\nhttps://x.com/pul_paca/status/1715700463281307868/photo/1\n構図自体はお任せしますがにむち♡むち♡のデカケツを魅せる感じにして貰えると嬉しいです。\n極論デカケツとむちむち太ももが映えるのであれば下半身だけ移っている状態でも大丈夫です。\n絵師様にお任せします。\n尼僧の顔が見えるか見えないかは絵師様にお任せします。\n繭にされた退魔師君は完全に巻き包まれ露出は無し。\n繭は獲物のボディラインが浮かぶ状態かみっちりと分厚く巻かれ浮かばない状態かは絵師様にお任せします。\n繭が画面内に何処まで映るかはお任せします。\nデカケツと太ももの邪魔になると判断した場合デカケツと太もも優先でお願いします。\n長くなり申し訳ありません。キャンセルはお気軽にお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Yotastar_SC/works/94", "thumbnail_src": "https://si.imgix.net/e5fa5219/uploads/origins/b21c5b1a-b945-4c0a-af49-6563706c1437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22922b2f9dfdc40406dadf81eab4fa92", "thumbnail_srcset": "https://si.imgix.net/e5fa5219/uploads/origins/b21c5b1a-b945-4c0a-af49-6563706c1437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22922b2f9dfdc40406dadf81eab4fa92, https://si.imgix.net/e5fa5219/uploads/origins/b21c5b1a-b945-4c0a-af49-6563706c1437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f18a7ae9d66d9d0554d2529eff8ec1dc 2x, https://si.imgix.net/e5fa5219/uploads/origins/b21c5b1a-b945-4c0a-af49-6563706c1437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t