4942-a073-685f6a9e92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daf60a16b761620007d3d238d3be49db, https://si.imgix.net/13f0005f/uploads/origins/ddd0d347-786d-4942-a073-685f6a9e92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b546a254a2e2b548d275fd2fb540d1d 2x, https://si.imgix.net/13f0005f/uploads/origins/ddd0d347-786d-4942-a073-685f6a9e92c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf9d358c7195a698a77b2fd03bba94ad 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\n以前はとても素敵なイラストをありがとうございました！\nよければ別のオリジナルキャラクターを描いて頂きたいと思い、リクエストを送らせていただきます。\n\n不老不死の魔法使いの男性です。\n基本的に穏やかで丁寧な振る舞いをしていますが、内心は悲観的・厭世的です。\nゲームの黒幕キャラクターとして制作したため、人に敵意があります。\n\n容姿はURLをご参考下さい。\n分かりづらい部分などは描きやすいようご自由にしていただければ幸いです！\n服装や表情、構図なども、すべてお好きなようにご自由に描いていただいて構いません。\n\n描いていただいたイラストは、SNSのアイコンなどプロフィール部分への使用や、依頼する際の参考イラストとして使用させていただく可能性があります。\n\n何か不備がありましたらお手数ですが再送リクエスト・キャンセルをお願いいたします。\n\n目を通して頂きありがとうございました。\nこれからも応援しています！\n\nhttps://drive.google.com/drive/folders/13wjvu0bLuNoP41covj_lWtAU0oLP9I33?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@inomemo/works/63", "thumbnail_src": "https://si.imgix.net/bc271ec4/uploads/origins/6b03b61c-1f3b-4f32-be2c-f18f9d0cf072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd41ffd8ea10c5ddd9a223570e2c0f88", "thumbnail_srcset": "https://si.imgix.net/bc271ec4/uploads/origins/6b03b61c-1f3b-4f32-be2c-f18f9d0cf072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd41ffd8ea10c5ddd9a223570e2c0f88, https://si.imgix.net/bc271ec4/uploads/origins/6b03b61c-1f3b-4f32-be2c-f18f9d0cf072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9659306530c2e5e4471e50702b9dd7dd 2x, https://si.imgix.net/bc271ec4/uploads/origins/6b03b61c-1f3b-4f32-be2c-f18f9d0cf072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=148e222b8c2f6937006415b86e147db8 3x", "genre": "art", "nsfw": false, "body": "命メモ様、初めまして\nいつもイラスト拝見しております\n宮田なくりさんのファンでぜひその方のイラスト描いて頂きたいです\n\nガイドラインと三面図の資料になります\nhttps://miyata0517.fanbox.cc/\n\nSNSの投稿、活動内での使用許可して頂けたらと思います\n表情やポージングはおまかせでお願いします。\n\n良くにこにこしてるんですが少し病んでる部分がたまにあるので\nもしその部分が表現できそうであればぜひお願いします。\n（酒カス、VALORANT大好き、関西弁な方です。）\n\nご検討いただければうれしいです", "created_at": "", "completed_at": ""}, {"path": "/@inomemo/works/62", "thumbnail_src": "https://si.imgix.net/bf94c337/uploads/origins/a3a0c078-80c6-47d2-ad21-9cc41adef08d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be5d2e7eac70599971cc43fd2551a66d", "thumbnail_srcset": "https://si.imgix.net/bf94c337/uploads/origins/a3a0c078-80c6-47d2-ad21-9cc41adef08d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be5d2e7eac70599971cc43fd2551a66d, https://si.imgix.net/bf94c337/uploads/origins/a3a0c078-80c6-47d2-ad21-9cc41adef08d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d6cd770d32627571836d257b8d0e8b0 2x, https://si.imgix.net/bf94c337/uploads/origins/a3a0c078-80c6-47d2-ad21-9cc41adef08d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ce573476dafe09bcd4565fb3db7bbb1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のオリジナルキャラクター「ヌードル」のイラストを依頼したいです。彼女は私のインディーゲーム『Velocity Noodle』と『DeadWire』に登場します。\n参考画像：https://store.steampowered.com/app/1488650/Velocity_Noodle/ https://drive.google.com/drive/u/1/folders/1aJYDZtt3yQPr_hLfHFcRSEEk6q8JX0V3\n\nキャラクターノート：• 女性• 昼はラーメン店で働き、夜は戦闘任務に従事• 可愛らしく引き締まった体型、ピンクの髪、強い性格、ブラックユーモア• 走りが速い• 赤いコート、レギンス、下駄を履いている• 投げたりテレポートしたりできる浮遊剣を使用ポーズ、構図、背景は自由にお任せします。\nご自由に想像力を働かせてください。使用条件：個人利用のみ。クレジットを明記の上、Twitterへの投稿可。ありがとうございます！https://drive.google.com/drive/u/1/folders/1aJYDZtt3yQPr_hLfHFcRSEEk6q8JX0V3", "created_at": "", "completed_at": ""}, {"path": "/@inomemo/works/61", "thumbnail_src": "https://si.imgix.net/60114bee/uploads/origins/d5a23dc5-233e-4062-8fb7-98cf7194418f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont