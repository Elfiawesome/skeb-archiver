b-4cc0-8bcf-45b184a7556c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e910977dd11bb84af03031316560769 2x, https://si.imgix.net/28db5856/uploads/origins/3941a118-619b-4cc0-8bcf-45b184a7556c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2edbcb8f086663cd41e85b67fe10980 3x", "genre": "art", "nsfw": false, "body": "私のオリジナルキャラクターが歩きながら変身するところを描いてください！変身は4段階です。format1やformat2のようなイラストを希望します。\n\n変身前：152cm\n変身後：175cm\n\nhttps://ln5.sync.com/dl/4e3458260#g9ztwu39-cn9apzfm-xqzqx7vs-s7ky2kas", "created_at": "", "completed_at": ""}, {"path": "/@sdus1017/works/90", "thumbnail_src": "https://si.imgix.net/41b50de0/uploads/origins/145c351e-fccf-4f36-8027-055a37cc1589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eae609311eb8fcff0ae9644e941e276", "thumbnail_srcset": "https://si.imgix.net/41b50de0/uploads/origins/145c351e-fccf-4f36-8027-055a37cc1589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eae609311eb8fcff0ae9644e941e276, https://si.imgix.net/41b50de0/uploads/origins/145c351e-fccf-4f36-8027-055a37cc1589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ece6f92a35aee2d86e0c2c5e7ff28a1 2x, https://si.imgix.net/41b50de0/uploads/origins/145c351e-fccf-4f36-8027-055a37cc1589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e970bf33bffa1956c6f8babe6ad5c796 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！もっとアートが欲しいです！\n\nGoogleフォルダ内のPose_Referenceのような、モブキャラに嫌がらせを受けるシーンを描いてください。モブは影/顔なしでも構いません。彼女は白いシャツに黒いネクタイ（Beni_Clothesを参考に、オレンジ部分を外してください）を着用し、モブが触れている部分のシャツは濡れて半透明になっている状態です。少しミルクが滴っている描写もOKです！表情はPose_Referenceの女の子と同様にしてください。 \n\n角は必ず含めてください。翼や尾は不要です。帽子は不要です。透明背景バージョン（またはPSD/クリップファイル、開けます）もお願いします。よろしくお願いします！https://drive.google.com/drive/folders/1Ptb8zlFzp6A5vOwnTQr13fgBS_vcOr5h?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sdus1017/works/89", "thumbnail_src": "https://si.imgix.net