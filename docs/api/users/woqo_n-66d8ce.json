c9472/uploads/origins/ce1cc637-2ab1-4f2e-85bc-827d231c4c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a67bf0eb19cc8eac1022e435de5605e1", "thumbnail_srcset": "https://si.imgix.net/18bc9472/uploads/origins/ce1cc637-2ab1-4f2e-85bc-827d231c4c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a67bf0eb19cc8eac1022e435de5605e1, https://si.imgix.net/18bc9472/uploads/origins/ce1cc637-2ab1-4f2e-85bc-827d231c4c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=430fc54d7571fe6348710cd3d486e11b 2x, https://si.imgix.net/18bc9472/uploads/origins/ce1cc637-2ab1-4f2e-85bc-827d231c4c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1598bb2405d71cc961d2dc09abd8d2c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@woqo_n/works/12", "thumbnail_src": "https://si.imgix.net/6fb54ec8/uploads/origins/6308464b-0039-450c-a7ef-43c1f364b2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50e2643e8815e9043ca904b2f90a3110", "thumbnail_srcset": "https://si.imgix.net/6fb54ec8/uploads/origins/6308464b-0039-450c-a7ef-43c1f364b2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50e2643e8815e9043ca904b2f90a3110, https://si.imgix.net/6fb54ec8/uploads/origins/6308464b-0039-450c-a7ef-43c1f364b2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b5d8d0f16cfb1a6785dfc9aa7880826 2x, https://si.imgix.net/6fb54ec8/uploads/origins/6308464b-0039-450c-a7ef-43c1f364b2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b829c671a636a45b30ec77eea23bb64 3x", "genre": "art", "nsfw": false, "body": "新規リクエスト失礼します。\n今回はGoogleドライブに載せている2人の男女のイラストを依頼したいと思っています。\n衣装のアレンジや捏造、構図、雰囲気共に問いません\n◾︎ｼｭﾉｯ！さんが思いつくままに描いて頂ければと思います。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1MiKDdy9cRGMfGHMyV6mlggChd9xpE_3A", "created_at": "", "completed_at": ""}, {"path": "/@woqo_n/works/11", "thumbnail_src": "https://si.imgix.net/fcb257ac/uploads/origins/8793a2cb-c6d9-46ab-8d16-df5092668e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5822842d4dc24908b4e606ed77c67cb", "thumbnail_srcset": "https://si.imgix.net/fcb257ac/uploads/origins/8793a2cb-c6d9-46ab-8d16-df5092668e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5822842d4dc24908b4e606ed77c67cb, https://si.imgix.net/fcb257ac/uploads/origins/8793a2cb-c6d9-46ab-8d16-df5092668e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=047f9a0c88d24d98c8a77684da3fe950 2x, https://si.imgix.net/fcb257ac/uploads/origins/8793a2cb-c6d9-46ab-8d16-df5092668e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bd225142b2813a3046f2c82778fbed5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n僕がフォローしているアカウントの一人が、以前君に絵をリクエストしていたことから、君のプロフィールを見たんだ。その画風に惹かれ、自分も描いてみたいと思いました。僕のキャラクター、モモモの絵を描いてほしいんだ。彼は宇宙船で旅をする船長で、たいてい何をやっても成功することよりも失敗することの方が多い。生意気で、自分が一番だと思っている。\n\n描いてほしいポーズは、アニメのチェーンソーマンのデビル・パワーがメガネをかけて生意気そうな表情をしていたのを参考にした。できれば、スケブの彼女と同じようなエネルギーを持ったキャラクターがいいのですが、まったく同じポーズである必要はありません。どうするかは自分で決めてください。可能であれば、白衣などを追加して、モモモがスマートに見えるようにしてください。私のキャラクターとチェーンソーマンのポーズを、アクセスしやすいようにフォルダに追加しています。\n\n可能であれば、透過ファイルも追加していただけると、サムネイル作成に活用できると思います。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1lFMpc8cmsw5mIhh-ip_Bvlv9n_4IUnT6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@woqo_n/works/10", "thumbnail_src": "https://si.imgix.net/11930c05/uploads/origins/179e97fa-6a26-49d4-8242-24d2553f59b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa08e341c2bcb577a8f5f9ca38fc113", "thumbnail_srcset": "https://si.imgix.net/11930c05/uploads/origins/179e97fa-6a26-49d4-8242-24d2553f59b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa08e341c2bcb577a8f5f9ca38fc113, https://si.imgix.net/11930c05/uploads/origins/179e97fa-6a26-49d4-8242-24d2553f59b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72dde490c1edc40f9af8f5f6a1c1369d 2x, https://si.imgix.net/11930c05/uploads/origins/179e97fa-6a26-49d4-8242-24d2553f59b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aa1de8ca74ed8ab4fb26bfe47d7b41b 3x", "genre": "art", "nsfw": false, "body": "新規リクエスト失礼します。\n\n今回は「永華一閃」という子を描いて頂きたくてリクエストを送らせて頂きました。\n構図、雰囲気共に指定はございません。\n良ろしければ‎ ◾︎ｼｭﾉｯ！様が感じたままの彼を描いて頂ければと思います。\n資料はGoogleドライブにてまとめさせて頂きましたので、そちらを見て頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/10DcBZPjM9NpLz7xMuS1RDcYiqtSffVaA", "created_at": "", "completed_at": ""}, {"path": "/@woqo_n/works/9", "thumbnail_src": "https://si.imgix.net/45d80066/uploads/origins/c6adea02-c65d-4df3-aa56-259e4ce8b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3859edbb1ca505e3837e3cf466f46c9", "thumbnail_srcset": "https://si.imgix.net/45d80066/uploads/origins/c6adea02-c65d-4df3-aa56-259e4ce8b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3859edbb1ca505e3837e3cf466f46c9, https://si.imgix.net/45d80066/uploads/origins/c6adea02-c65d-4df3-aa56-259e4ce8b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa9f9c24b55321e057de5ab00c6b0fcc 2x, https://si.imgix.net/45d80066/uploads/origins/c6adea02-c65d-4df3-aa56-259e4ce8b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=391f674cd969853aa1aba479ef7d659c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ニリー～！( ^ o ^ )\n\n私がフォローしているVTuberを通してあなたを見つけ、あなたのアートスタイルが大好きです！だから、私のVTuberのキャラクターもぜひあなたに依頼したいです！デザインとテーマさえ合えば、何をやっても自由です！\n\n<作品について\nシチュウは気性の荒い妖狐の少年。本海スターレールに似たモバイルゲームのキャラクターです。彼は感覚を与えられ、自分の運命をコントロールしたいと考えている！かっこつけたいけど、すぐふてくされたり、かわいい一面を見せたりするキャラクターです。\n\n<用途\nストリームのサムネイルやSNSに使いたいです！\n\n参考\nhttps://postimg.cc/z3TjyXk7", "created_at": "", "completed_at": ""}, {"path": "/@woqo_n/works/8", "thumbnail_src": "https://si.imgix.net/65da5e3c/uploads/origins/29559a03-85ce-4b2c-9713-7e9a4e592d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b86fe2878d3a7b1fbcf0c2619707fce", "thumbnail_srcset": "https://si.imgix.net/65da5e3c/uploads/origins/29559a03-85ce-4b2c-9713-7e9a4e592d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b86fe2878d3a7b1fbcf0c2619707fce, https://si.imgix.net/65da5e3c/uploads/origins/29559a03-85ce-4b2c-9713-7e9a4e592d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=940e8353872463c7502e4824841a96b0 2x, https://si.imgix.net/65da5e3c/uploads/origins/29559a03-85ce-4b2c-9713-7e9a4e592d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=849e2360754721fa727d5c64319f5472 3x", "genre": "art", "nsfw": false, "body": "新規リクエスト失礼します。\n今回はGoogleドライブに載せている2人の男性のイラストを依頼したいと思っています。\n衣装アレンジ(簡易化など)、構図は自由にしていただいて構いません。是非、練習したい構図の練習台にしてください。\n雰囲気も特に問いませんが、個人的には暗い雰囲気が好きです。\n個人の意見のためこれは忘れていただいても構いません。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-b9zhZ2zsOXFIWHXQQ2gmmmIYDi1tZl6", "created_at": "", "completed_at": ""}, {"path": "/@woqo_n/works/7", "thumbnail_src": "https://si.imgix.net/d5f115c6/uploads/origins/4efd75e9-e0d0-4bbc-934a-832519b090f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12f855ff9ac641db7fb9c1d60c9c224a", "thumbnail_srcset": "https://si.imgix.net/d5f115c6/uploads/origins/4efd75e9-e0d0-4bbc-934a-832519b090f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12f855ff9ac641db7fb9c1d60c9c224a, https://si.imgix.net/d5f115c6/uploads/origins/4efd75e9-e0d0-4bbc-934a-832519b090f3?