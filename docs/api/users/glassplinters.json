b1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c73f8c6a6d5a6e6294fb0ce14efed9", "thumbnail_srcset": "https://si.imgix.net/d049ecea/uploads/origins/b8b4c40b-c929-4e5b-81bf-7ad0c232b1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c73f8c6a6d5a6e6294fb0ce14efed9, https://si.imgix.net/d049ecea/uploads/origins/b8b4c40b-c929-4e5b-81bf-7ad0c232b1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c165a61ca7d372b4160fe6234d0e1342 2x, https://si.imgix.net/d049ecea/uploads/origins/b8b4c40b-c929-4e5b-81bf-7ad0c232b1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a459d81d3de28f594c7724fcaf88948c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、以前ご依頼させていただきました梨桜です。いつもミアさんの作品を楽しく拝見しております。一部内容に不備がありましたため、再送させていただきます。\n\nSkebを募集されるとのことで、再度ご縁がありましたら、と思いリクエストさせていただきます。\n\nリクエスト内容ですが、前回と同じく当方が制作した一次創作ノベルゲームに登場するオリジナルキャラクター（OC）の一枚絵イラスト、今作は乙女ゲームになりまして、カップリングの二人でお願いしたいです。架空のヨーロッパ風世界、魔法があるファンタジー設定が特徴の世界観になります。\n\n◆リクエスト内容\n当方の1枚絵のイラスト（可能であればスマートフォンの壁紙にしたいので縦型だと嬉しいですが、絶対ではありません。描きやすいアスペクト比でお願いいたします）\n\n◆内容の要望\n構図・背景等はお好きに（オリジナル衣装やコラージュ的な表現等でも）描いていただいてOKです。衣装に関しても、当方で複数種類用意していますが、ご自由に描いてください。\n\n◆使用用途\n個人的な観賞用として。\n\nキャラクターの資料については下記よりご確認ください。\n\n長文となりましたが、ご検討をいただけますと幸いです。\nご機会があれば、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1kp-Z1kS2XpL2RR_DwNvvQ6wrgHgu7MqP/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@glassplinters/works/180", "thumbnail_src": "https://si.imgix.net/45cb0dd7/uploads/origins/0337e2a3-bdc9-4b9a-9f15-4a6a64e0653e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=606e40e84aee40bbcc949aa73e4af029", "thumbnail_srcset": "https://si.imgix.net/45cb0dd7/uploads/origins/0337e2a3-bdc9-4b9a-9f15-4a6a64e0653e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=606e40e84aee40bbcc949aa73e4af029, https://si.imgix.net/45cb0dd7/uploads/origins/0337e2a3-bdc9-4b9a-9f15-4a6a64e0653e?bg=%23fff&aut