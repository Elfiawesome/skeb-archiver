r=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de339dfa71eaa528c91f0a329e2ae0c9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@So_Mu3/works/8", "thumbnail_src": "https://si.imgix.net/f9360db4/uploads/origins/a600f50e-4919-40ed-93b6-98caf30fa517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b88da1726c8e38a765f1300259dfa9", "thumbnail_srcset": "https://si.imgix.net/f9360db4/uploads/origins/a600f50e-4919-40ed-93b6-98caf30fa517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b88da1726c8e38a765f1300259dfa9, https://si.imgix.net/f9360db4/uploads/origins/a600f50e-4919-40ed-93b6-98caf30fa517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60ba9211618235069e70654bfc747d97 2x, https://si.imgix.net/f9360db4/uploads/origins/a600f50e-4919-40ed-93b6-98caf30fa517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1b22ccaaa05e649e93af9fa3c1eb84e 3x", "genre": "art", "nsfw": false, "body": "総務さんと自分の誕生日記念として\n\nキャラはちり姐様とちと姉さん\nちり姐様はあへ顔でちと姉さんは\"ちぬたん50\"の時みたいな後毛ありの色っぽい感じで\n\nコスはお任せしますが二人の表情が表情なのでセクシー系ですかね\n\n背景もお任せします\nあ、どこかにちびけほたんを頂けると…\n\nよろしくお願いします！\nこの度はお誕生日おめでとうございました！！", "created_at": "", "completed_at": ""}, {"path": "/@So_Mu3/works/7", "thumbnail_src": "https://si.imgix.net/29f86c3f/uploads/origins/9697a77c-db54-456e-ae42-51a6d1f57706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b2e441bf62ab7cbc41b8efeb3dd6c9f", "thumbnail_srcset": "https://si.imgix.net/29f86c3f/uploads/origins/9697a77c-db54-456e-ae42-51a6d1f57706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b2e441bf62ab7cbc41b8efeb3dd6c9f, https://si.imgix.net/29f86c3f/uploads/origins/9697a77c-db54-456e-ae42-51a6d1f57706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bd2a31b7444ee88797f5af7aad1c1b7 2x, https://si.imgix.net/29f86c3f/uploads/origins/9697a77c-db54-456e-ae42-51a6d1f57706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a178611e75d11f49638ac7d45dde0dfd 3x", "genre": "art", "nsfw": false, "body": "戦車娘さんたちが、艦これのタフィ3のコスプレをしてわちゃわちゃしているイラストをお願いします。\n\n・かべなんたん（ガンビアベイ）\n・ちはたん（サミュエルBロバーツ）\n・ちぬたん（ジョンストン）\n\n構図はかべなんたん（ガンビアベイ）がセンター。ちはたん（サミュエルBロバーツ）とちぬたん（ジョンストン）が両サイドでかべなんたんにちょっかい出してる感じでお願いします。\n\n背景は特に不要です。\nどうぞよろしくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@So_Mu3/works/6", "thumbnail_src": "https://si.imgix.net/a4d4cb3f/uploads/origins/bf88b94a-9675-42d4-aedd-2baff15d50c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6aa5d8901faba904b9f0ac90f6fa34", "thumbnail_srcset": "https://si.imgix.net/a4d4cb3f/uploads/origins/bf88b94a-9675-42d4-aedd-2baff15d50c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6aa5d8901faba904b9f0ac90f6fa34, https://si.imgix.net/a4d4cb3f/uploads/origins/bf88b94a-9675-42d4-aedd-2baff15d50c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a141a623b511c0b1036a4f4e42c05fe 2x, https://si.imgix.net/a4d4cb3f/uploads/origins/bf88b94a-9675-42d4-aedd-2baff15d50c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31622a3943372d89be917ec2dbef5428 3x", "genre": "art", "nsfw": false, "body": "イラストお願いします\n\n戦車娘さん達で「90年代キャラクターコスプレ」その２\n\n：キャラクター：\n・ランカちゃん\n「ストリートファイター」の「キャミィ・ホワイト」\n（ナンバリングで見た目に違いがありますが、初登場時希望です）\n・しおいたん\n「ドラゴンクエスト３」の「女戦士」\n（装備は盾無し、片手に斧を持っている）\n・ちと姉さん\n「サムライスピリッツ」の「いろは」\n（バストサイズに差異がありますが、コスプレ基準で大きめにしてくださると嬉しいです）\n\n○砲塔の有無と髪型はついては、できれば砲塔あり、各戦車娘のデフォの髪型が嬉しいですがコスチュームとの雰囲気優先で大丈夫です\n○ポーズについてはできればセクシーな感じで、判定が危なそうであれば各コスプレ元でよく見るポーズでも大丈夫です\n（ランカちゃん、ちと姉さんはよく見るポーズを添付させていただきます）\n（https://www.kotobukiya.co.jp/wp-content/uploads/2018/03/1a8fe62c1aaf1578a82f458050702768cfcae62b.jpg）\n（https://www.snk-onlineshop.com/client_info/SNKONLINESHOP/itemimage/4580015692767/4580015692767.jpg）\n○表情については\n・ランカちゃん\n恥じらい無し（楽しんでおり、ノリノリでポーズを決めている）\n・しおいたん\n恥じらい無し（というより無表情）\n・ちと姉さん\n恥じらい無し（コスプレ慣れしているため、凛とした雰囲気でポーズを決めている）\n先生のキャラに対する考えを優先してください\n\n：その他：\n背景はコスプレしている雰囲気\n打ちっぱなしコンクリートの壁、コミケ会場、秋葉原歩行者天国など\n作業量と相談していただいて特になくても問題ありません\nキャラの並び順はお任せします\nサイズ縦横1920×1080or横長希望ですが、構図の関係でサイズが変わっても大丈夫です\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@So_Mu3/works/5", "thumbnail_src": "https://si.imgix.net/ce9f935d/uploads/origins/989640fd-c15f-441c-8712-f922b8afbecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9feac8ec84799235202a73ecf4c3fc6", "thumbnail_srcset": "https://si.imgix.net/ce9f935d/uploads/origins/989640fd-c15f-441c-8712-f922b8afbecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9feac8ec84799235202a73ecf4c3fc6, https://si.imgix.net/ce9f935d/uploads/origins/989640fd-c15f-441c-8712-f922b8afbecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94507eb9e79e4703dbe6660bdc2a3cad 2x, https://si.imgix.net/ce9f935d/uploads/origins/989640fd-c15f-441c-8712-f922b8afbecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce12ecbe1bc872c77e9a001210f3400f 3x", "genre": "art", "nsfw": false, "body": "イラストお願いします\n\n戦車娘さん達で「90年代キャラクターコスプレ」\n\n：キャラクター：\n・おいの姉者\n「餓狼伝説」の「不知火舞」のコスプレ\n・ちり姐様\n「スレイヤーズ 」の「白蛇のナーガ」のコスプレ\n・すたにさん\n「新世紀エヴァンゲリオン」の「プラグスーツ」（アスカ仕様）のコスプレ\n\n○砲塔の有無と髪型はついては、できれば砲塔あり、各戦車娘のデフォの髪型が嬉しいですがコスチュームとの雰囲気優先で大丈夫です\n○ポーズについてはできればセクシーな感じで、判定が危なそうであれば各コスプレ元でよく見るポーズでも大丈夫です\n○表情については48回の件もありますので\n・おいの姉者\n恥じらい小（ポーズと表情は頑張っているが、年齢的に少し無理してる感がある）\n・ちり姐様\n恥じらい無し（楽しんでおり、ノリノリでポーズを決めている）\n・すたにさん\n恥じらい大（二人と違いテカテカぴっちりスーツのため、ぎこちない感じ、顔も赤らみ目をそらしている）\nと違いがあるか、ポーズに合わせてキメ顔でも大丈夫です\n先生のキャラに対する考えを優先してください\n\n：その他：\n背景はコスプレしている雰囲気\n打ちっぱなしコンクリートの壁、コミケ会場、秋葉原歩行者天国など\n作業量と相談していただいて特になくても問題ありません\nキャラの並び順はお任せします\nサイズ縦横1920×1080or横長希望ですが、構図の関係でサイズが変わっても大丈夫です\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@So_Mu3/works/4", "thumbnail_src": "https://si.imgix.net/3649875e/uploads/origins/b4d48563-94a8-46ae-a3ec-43abd5d3c441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efa2928e83d300c33941f5cb073d0f64", "thumbnail_srcset": "https://si.imgix.net/3649875e/uploads/origins/b4d48563-94a8-46ae-a3ec-43abd5d3c441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efa2928e83d300c33941f5cb073d0f64, https://si.imgix.net/3649875e/uploads/origins/b4d48563-94a8-46ae-a3ec-43abd5d3c441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c077d5bdeeda55e253fe7e371e116eff 2x, https://si.imgix.net/3649875e/uploads/origins/b4d48563-94a8-46ae-a3ec-43abd5d3c441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4e78c272089f6042113129c49c0552f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@So_Mu3/works/3", "thumbnail_src": "https://si.imgix.net/d62fdd1f/uploads/origins/f5f745ac-2fea-4614-abf9-e77f654a9729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10669362c42120c911e40c202875788c", "thumbnail_srcset": "https://si.imgix.net/d62fdd1f/uploads/origins/f5f745ac-2fea-4614-abf9-e77f654a9729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10669362c42120c911e40c202875788c, https://si.imgix.net/d62fdd1f/uploads/origins/f5f745ac-2fea-4614-abf9-e77f654a9729?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eae71265f7fda9fbd8303a1604ea9fd 2x, https://si.imgix.net/d62fdd1f/uploads/origins/f5f745ac-2fea-4614-abf9-e77f654a9729?bg=%23fff&auto=format%2Ccompress&f