したいです。\n\nこのキャラは読書家です。\n推理小説を好んで読み、推理や謎解きなど好きなことに思考を働かすことが好きです。\n警戒心が強いですが心を開けば情に厚い人物です。嫉妬深く愛が重く独占欲が強い面倒な性格をしています。\nプライドが邪魔して、言葉足らずになったり、素直になれなかったり優しくしたいと思っても不器用で空回りしてしまいます。\n\n察されるのが嫌で常にポーカーフェイスですが、仲の良い友人のみには少し表情が動きます。\n\n読書家をイメージしたような雰囲気にしていただきたいです。\n\nhttps://drive.google.com/drive/folders/1pyjvLzDG3pRz5hkU314fa9duPNLU_zU8", "created_at": "", "completed_at": ""}, {"path": "/@neh38h/works/187", "thumbnail_src": "https://si.imgix.net/860b6db8/uploads/origins/87e9ac60-4371-4734-bfd5-089e5db94703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a30504ccfe9ff5aab85ffc2f77acea9", "thumbnail_srcset": "https://si.imgix.net/860b6db8/uploads/origins/87e9ac60-4371-4734-bfd5-089e5db94703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a30504ccfe9ff5aab85ffc2f77acea9, https://si.imgix.net/860b6db8/uploads/origins/87e9ac60-4371-4734-bfd5-089e5db94703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8774e3a75d3cc7563d0d6616f656165d 2x, https://si.imgix.net/860b6db8/uploads/origins/87e9ac60-4371-4734-bfd5-089e5db94703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=860ebaed2101af92330c10c3df60bcca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@neh38h/works/186", "thumbnail_src": "https://si.imgix.net/42965496/uploads/origins/18b996e5-0711-47a1-a3ae-9576f483b1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58183fe84f50b2d663ef018cb9634