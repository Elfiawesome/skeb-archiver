=200&h=200&s=66d57bc4061eff66c77b5d507c9cbae5", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは。\nFGOの男性×海幸彦のR18イラストをお願いできますでしょうか。\n\n【イラスト資料】\n海幸彦は未実装キャラなので資料がとても少ないのですが、こちらのまとめ参考になると思います。\n背が高い男性で、神霊なのでちょっと上から目線のツンデレです。、\nhttps://fategrandorder.fandom.com/wiki/Umisachi-hiko_(Enemy\n\n相手の男性は、誰でもないモブまたは同作の男性主人公・藤丸立夏（下記）です。\nhttps://w.atwiki.jp/niconicomugen/pages/8721.html\n\n【希望内容】\nポーズはおまかせしますが、海幸彦が受けです。\n挿入有りだと嬉しいです。\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/210", "thumbnail_src": "https://si.imgix.net/ae1ab441/uploads/origins/89dc9595-3aca-428f-b4c6-9b7897ad0847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c75362e5c36c5ba8fdd19a719a5e5e13", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/209", "thumbnail_src": "https://si.imgix.net/7234e9ba/uploads/origins/861de97c-7f99-42fd-b7ad-354bcd47b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e5f2243ef9b2d8ec5b5c4a7383adc40", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/208", "thumbnail_src": "https://si.imgix.net/1dcd9754/uploads/origins/8b52c215-8334-47be-a9cc-a17aae125397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac82dee33a1ca470143de66124f981a", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは、私はあなたの作品、特にこの後背位の作品がとても好きです https://skeb.jp/@mineco08/works/181\nそこで私のOCが後ろから貫かれているイラストを描いて頂きたいです。彼はかわいい男の子です。お気軽に描いてください！\n\n以下は参考資料です\nhttps://drive.google.com/file/d/1I-KogiSXY1IQhBvfbwece0Cyma43Cx1N/view?usp=drive_link\nhttps://drive.google.com/file/d/1qo2XSIs0PDCS-cj3OWteX5-o1cX4BCka/view?usp=drive_link\n\nhttps://drive.google.com/file/d/1I-KogiSXY1IQhBvfbwece0Cyma43Cx1N/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/207", "thumbnail_src": "https://si.imgix.net/c5975ce8/uploads/origins/3ee1fa01-40b3-4e26-870c-d1398cff5aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e541603dd155b233acb6fa92b72d380", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/206", "thumbnail_src": "https://si.imgix.net/37b871a3/uploads/origins/e18aa0a2-370e-4aea-8632-43a31aeac9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc4d0d6045e9d92bab0226de1d8d6056", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/205", "thumbnail_src": "https://si.imgix.net/37747afd/uploads/origins/9d087a4c-2aca-440d-8ca1-e1bdeb6d91fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d02989a20ff13627cb2610b20b5d837", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/204", "thumbnail_src": "https://si.imgix.net/8b8ae7da/uploads/origins/48839356-8a53-40aa-82c0-57f1d3082460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcfd4c872580a51f6ac5ac4830180c55", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/203", "thumbnail_src": "https://si.imgix.net/74ca6cc0/uploads/origins/3c15cd61-f3e8-40dd-bcf2-18ae3a2cdc9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490d256d3fdb29a45c9473b3e8a1debf", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは！サイバーパンクの世界で傭兵をしている友人のひかりのために、また別の作品をお願いしたいです。凶悪犯に捕まり、参考写真のような屈辱的なポーズをとらされるシチュエーションで描いてほしいです！口には猿ぐつわ、目隠しで見えないようにしてください。猿轡と目隠しは布製でお願いしたいです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1V16uIFEoAs3bsJaKW2clp2bdHqbhfQY_?usp=sharing\n\nhttps://drive.google.com/drive/folders/1V16uIFEoAs3bsJaKW2clp2bdHqbhfQY_?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/202", "thumbnail_src": "https://si.imgix.net/98197dc4/uploads/origins/0291b0cd-d7bf-482b-880f-27d6faa9bd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef339ad807ed62b5ae3187414103a13", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "あなたの絵がとても好きです！\n私のハロウィンのキャラクター、ラヴィの絵を描いていただけませんか？彼はオスなので、ペニスをつけてあげてください！彼は生意気な底辺で、他人を困らせたりいたずらをするのが大好きです。彼のnsfwなところを描いてくれませんか？フォルダの中にスキンリファレンスが含まれているので、彼の矢印のパターンと暗い手と足を忘れないでください！\n一人または複数の男性と一緒に描いてください。ラヴィには受け側／下側になってほしい。\nオーラル＝OK！\nアナル＝OK\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1NggGcztd3Ahcz28sAd9bye5lesWSLIy0", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/201", "thumbnail_src": "https://si.imgix.net/8e683e51/uploads/origins/1780ac9b-0420-47ba-b337-1002b67950ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f71b12c6a6e81db4499629b0acce4d5", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/200", "thumbnail_src": "https://si.imgix.net/4ce23bf4/uploads/origins/e91da00b-378d-448e-85ff-34cccdae03f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4758902b4aa7a47f4b4cd00240e79cb", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/199", "thumbnail_src": "https://si.imgix.net/5496fba7/uploads/origins/23130013-d552-41fb-b9ed-3d5a439ade5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82f913430773e5ab9919b2cf841ac1d0", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "あなたの絵が好きなんだけど、僕のキャラクターを描いてくれないかな？僕のキャラクターは男だから、おちんちんがあるんだ >~< これが僕の参考資料と、かわいく見えると思うポーズだよ :3 --> https://drive.google.com/drive/folders/1Nu_FJNFqw_alSZMx2NagGg2UBi2jqiFS?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/198", "thumbnail_src": "https://si.imgix.net/53d5d4ad/uploads/origins/aea3d0d3-46f2-44c5-8845-f8c0b3a67710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7e6e693a559612c66b61908ddd3046e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/197", "thumbnail_src": "https://si.imgix.net/f5ece93b/uploads/origins/c8353369-55f3-4c4c-b4bc-559ad88d3fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=beff9178c751715806479ac4484db6a0", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/196", "thumbnail_src": "https://si.imgix.net/2a8a72dc/uploads/origins/342637e0-5905-4a95-80d4-f272eb6e2df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f588844858208892ff958745d5593bcc", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは！私のOC、ユエルの別の作品をリクエストしてもいいかな？\nもう何回か描いてもらってるんだけど。彼は不機嫌なツンデレで、まじめに振る舞おうとするんだけど、すぐに恥ずかしがって照れちゃうんだ。\n\n今回は、こんなピンクのベビードールのランジェリー姿を見てみたいです：\nhttps://drive.google.com/file/d/15oVD1YtCb-JLDB1ufuQncwMfDtDdEwCe/view?usp=sharing\nhttps://drive.google.com/file/d/1NWxeQIPjrfDxuYVBiR7M4FW3y-WsAHR5/view?usp=sharing\n\nこの衣装は少しスケスケだが、露骨なものにはしたくない。セクシーではなく、キュートな感じにしてほしい。肌の露出が多いが、股間は隠してほしい。\n\nユエルがベッドに横たわって枕を抱きしめているか、ボーイフレンドのタビのぬいぐるみ（この参考画像のぬいぐるみのようなもの）を抱きしめていたら素敵だと思う：\nhttps://skeb.jp/@ikupom_twi/works/80\n\n細かいポーズはお任せします。リクエストにお答えいただきありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/195", "thumbnail_src": "https://si.imgix.net/9509a6ae/uploads/origins/b9f18b09-cabf-4c86-9f9f-a88c8ac8d3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fe16c9388aba9dd2cc118f85de1bd15", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "前回のリクエストで申し訳ありませんでした！あなたの画風はとても素敵だと思うので、ぜひ私のキャラクターを描いていただきたいです。彼は水竜の武将で、目は切れ長の瞳孔があることを覚えておいてください。目の上に傷があります。その他はお任せします！ちょっと淫靡な雰囲気が希望です！\n\n参考文献のリンクはこちら：https://imgur.com/a/zMT1WUW\n服のデザインは複数あるので、どれを描くかはお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/194", "thumbnail_src": "https://si.imgix.net/f5fd075e/uploads/origins/d3babc83-a1ae-4464-a67a-a6425d68fb2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16ec92a4650b9feff3b5d2571f53a346", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/193", "thumbnail_src": "https://si.imgix.net/9d7b7362/uploads/origins/c4f328ff-70f9-473c-b7c1-651e3e48ab64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34f286a67a0742f226fd11c4b945c324", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/192", "thumbnail_src": "https://si.imgix.net/1da56415/uploads/origins/01e05a48-c338-4c58-9cfe-7df50a08c892?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85ee83cf6e5a876b8825637f94ed70dd", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは！前回の作品がとても気に入ったので、私の友人であるKatsuが、目隠しと猿ぐつわをされたまま、タオルでヨダレと涙を拭きながら、参考資料のように無意識のうちにベッドに縛られているアートをお願いしたいです。どんな作品になるか楽しみです！\n\nhttps://drive.google.com/drive/folders/1V16uIFEoAs3bsJaKW2clp2bdHqbhfQY_?usp=sharing\n\nhttps://drive.google.com/drive/folders/1V16uIFEoAs3bsJaKW2clp2bdHqbhfQY_?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/191", "thumbnail_src": "https://si.imgix.net/f5c0e3a7/uploads/origins/3323d173-e5a7-4c03-aa05-3f657709bd7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b10bd7e2e0066919606cee37cba73a", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは。\nhttps://www.deviantart.com/stash/01u8landfyhe と同じような体位でセックスしている二人のOCを描いていただけないでしょうか。OC(https://sta.sh/2123wycmzafw)が上にいて、もう一人のOC(https://sta.sh/22d4xtfod13a)の縛られた腕を頭の上で持ちながらセックスしてほしいです。\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/190", "thumbnail_src": "https://si.imgix.net/b46e9559/uploads/origins/e6355c1c-c8ca-4ea6-83c7-68ab2d6ba86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7663db5663f63e9bb23bc32009b9e74", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "私の友人と私のキャラクター、ウリゼンとスカディがセックスしている絵を描いていただけませんか？\nポーズはウリゼンが上になった交尾プレス。ウリゼンが勝利のドヤ顔でスカディの頭を床に押し付けているようにお願いします。\nウリゼンはスレンダーな体型で、視覚的には性別はありませんが、女性的な顔立ちをしています。\nあとはお任せします。\n\nhttps://drive.google.com/drive/folders/1G3-GpjyWIwPvlG2xdEeV8VqOEV07sxgh?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/189", "thumbnail_src": "https://si.imgix.net/86017426/uploads/origins/1703df32-6de6-40db-9a21-caa377e5d22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=306a3936e010adedb41ce1be8fd085cf", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "みね子さん、こんにちは！前回からお元気でしょうか🙏？\nまたリクエストを送ろうと思ってずっと待っていたのですが、やっと今送ることができました\n\n私のOCカップル、ビアンカと蓮斗のラブラブセックスを描いて欲しいです！\n体位とか細かいところはお任せしますが、結婚指輪と陰毛が見えてたら入れてください！🙇‍♂️\n\n二人の詳細は、私のサイトにあります：\nビアンカ (ビアンカ): https://argentumgaleria.carrd.co/#bianca-hulao\n蓮寅 (はすと): https://argentumgaleria.carrd.co/#hasuto-hulao\n\nリクエストに応えてくれてありがとう💗。", "created_at": "", "completed_at": ""}, {"path": "/@mineco08/works/188", "thumbnail_src": "https://si.imgix.net/3dbd0601/uploads/origins/daacfecb-5bb9-4fe8-925e-31a839d596be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c6ebcacc97c06a7a4550babc69e4f0", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n僕と僕の彼女のキャラクターのNSFW画像を描いてもらえないかな？\n\n私のバニーマンのキャラクターが、猫の女の子のキャラクターと後ろからセックスしているところを見てみたいです。彼は彼女よりずっと大きいので、彼女が地面から持ち上げられ、彼の大きなペニスにぶら下がっているところを見てみたいです。彼は首を絞めるように彼女の首に腕を巻きつけるだろう。彼の表情は生意気でもいい。彼女の表情はエロティックで、口から舌を出していてもいい。\nまた、レントゲンを使って、彼が彼女の中でイク第2バージョンも追加してもらえないだろうか？\n\nバニーマンの参考文献：\nhttps://drive.google.com/drive/folders/1jfmcBurkAM2OFKP5zejEIu2U-xfuRjIx\n\n猫の女の子の参考文献：\nhttps://drive.google.com/drive/folders/16zpVdWHuhD-q0WiWhUGDThgOaRTDbt7M\n\n大きさの比較画像：\nhttps://drive.google.com/file/d/1Z8fpfX44939Ensccx3JtC-p_nnhMxL5j/view", "created_at": "", "completed_at": ""}]}