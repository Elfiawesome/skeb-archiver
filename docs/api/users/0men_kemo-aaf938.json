44%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4afbbaf733b1bee7199ad225c27f2500 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f20d8bdb1d515c79830c06fc2a2e4164 3x", "genre": "music", "nsfw": false, "body": "こんにちは！あなたの音楽はとてもいい！私のVtuberのために、2つのバリエーションでループする曲を作っていただけませんか？彼女はすべての生きとし生けるものに夢をもたらす星です。彼女は穏やかで、気まぐれで、他の人を眠りにつかせることを楽しんでいます。SNSやストリーミングで使いたいです。\n\nピアノがとても好きです。あなたが作った曲のようなものが欲しいです：\nhttps://skeb.jp/@0men_kemo/works/14\nhttps://skeb.jp/@0men_kemo/works/23 (1曲目)\n\nもっとインスピレーションが欲しい：\nhttps://youtu.be/rhG87X6qX_w?si=-Hfb5bW6JNGvRXIG\nhttps://youtu.be/6kIluY7-Syk?si=2GRMo7BD3EPzSc_C\n\n最初のバージョンは、落ち着いた雰囲気にできませんか？宇宙や海の中にいるような感覚はないだろうか。\n\n2つ目のバージョンは、同じ曲で、もっと落ち着いたブレイクコアのスタイルでお願いします。https://www.youtube.com/watch?v=CzNfKfrwegg&ab_channel=vervid%21\n\nありがとうございました！お値段は大丈夫でしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@0men_kemo/works/23", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4afbbaf733b1bee7199ad225c27f2500 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f20d8bdb1d515c79830c06fc2a2e4164 3x", "genre": "music", "nsfw": false, "body": "はじめまして、先生。\n\n先生の作曲スタイルが大好きで、自分のオリキャラにも同じものを依頼したいと思っています。ペルソナ5の大ファンなので、似たような雰囲気でお願いします。\nオリキャラ参照イメージ\nhttps://drive.google.com/file/d/1lNeBOadsQSDBGJb3DJD3wHPqyRNrVbo3/view?usp=sharing\nhttps://drive.google.com/file/d/1Sg6c9nA4ctAvzd2CwTDfj9104mjT3gZ2/view?usp=sharing\n\n今回の依頼は、「ペルソナ5で自分のオリキャラのテーマはどんな感じだろう」という想像で3曲です：\n1. 商人のテーマ曲\n背景： オリキャラはゲーム後半に登場する強力な装備を持った商人です。彼女はコクテールバーのようなスペースで、プレイヤーと強力な装備品を交換する。\nスタイル：主にリラックスした感じで、「全ての人の魂の詩」に少し似ているが、もっとダークな面もある。\n\n2. 隠かくしボスのテーマ曲\n背景： 数々の超難関をクリアした後、OCはプレイヤーに「自分の魂の取引」と題された、彼女とのボス戦となるの試練を与える。\nスタイル エネルギッシュだが、少しホラーな雰囲気もある。\n(プレイヤーに大きなプレッシャーを与える。）\n参照イメージ: https://drive.google.com/file/d/1d2wopZD8pzM5UsAtGxsKJ3-mIjT7a04g/view?usp=sharing\n\n3. ボス第2階段のテーマ曲\n背景：オリキャラは真の悪魔の姿を現し、真剣に戦いに挑む。\nスタイル：第1階段のテーマをベースにしているが、よりフィーバーしている。できれば女性の詠唱を追加してほしい。\n参照イメージ: https://skeb.jp/@ah_h_that_gB/works/170\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@0men_kemo/works/22", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4afbbaf733b1bee7199ad225c27f2500 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f20d8bdb1d515c79830c06fc2a2e4164 3x", "genre": "music", "nsfw": false, "body": "【ジャンル】\n指定なし\n\n【〆切】\n指定なし\n\n【曲の長さ】\n指定なし\n\n【要望】\nわたしのイメージで曲を作って欲しい\nこの人だよ→@setsunann_vocal\n\n【用途】\n鑑賞用\n\n【その他】\nリクエスト手数料と出金手数料を上乗せしたよ\nちゃんと飯食べて", "created_at": "", "completed_at": ""}, {"path": "/@0men_kemo/works/21", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4afbbaf733b1bee7199ad225c27f2500 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f20d8bdb1d515c79830c06fc2a2e4164 3x", "genre": "music", "nsfw": false, "body": "Hello! I've seen a lot of your works and I really enjoy them and was hoping if you would accept my request!\n\nI am requesting to have something for my starting screen as well as my chatting screen for my streaming! I am looking to have a theme that is very exciting, hype and fitting of my chaotic character!\n\nMy character is a royal, evil, overconfident, smug and extremely egotistical penguin that wants to rule the world! Nothing will get in the way of his conquest!\n\nHere is a list of all the music I personally enjoy the vibe of either for your own reference or for you to jam out too while making something!\nhttps://youtube.com/playlist?list=PLTYHfo0vqSdp5Vqc2lk7WoEnFluQMqc2L\n\nI really love the Overlord openings, so I'd love to have something just as energetic or exciting, whatever you think would fit my glorious royalty best!\n\nThank you for reading!\n\nhttps://imgur.com/a/zGxqPQy", "created_at": "", "completed_at": ""}, {"path": "/@0men_kemo/works/20", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b4b50dc39ba0bfaa281d51127abcb0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4afbbaf733b1bee7199ad225c27f2500 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1986004921414815744%2FC9kgfF0h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f20d8bdb1d515c79830c06fc2a2e4164 3x", "genre": "music", "nsfw": false, "body": "こんにちは、私は本当にあなたの音楽が好きです私はペルソナ5のOstが大好きなので、同じような雰囲気の曲が欲しいです。ペルソナ5のOstが好きなので、同じような雰囲気のものを希望します。選択肢はお任せします。開始直後のものは、https://www.youtube.com/watch?v=R1ARDLN2tU8 のような元気な雰囲気のものを希望します。終了直後のものは、https://www.youtube.com/watch?v=m3RS9YrSwVw のようなリラックスできるものがいいかもしれません。\n私のキャラクターは妖怪の世界から来た猫又なので、日本的な要素が欲しいです。これは私のモデルです https://imgur.com/a/5RjbVx8", "created_at": "", "completed_at": ""}, {"path": "/@0men_kemo/works/19", "thumbnail_src": "https://skeb-avatar.imgix.net/