/origins/725ec7ec-8950-4401-8223-0da3a03186fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0572c41a8a6647a04b9c67b10eca29e", "thumbnail_srcset": "https://si.imgix.net/dd601334/uploads/origins/725ec7ec-8950-4401-8223-0da3a03186fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0572c41a8a6647a04b9c67b10eca29e, https://si.imgix.net/dd601334/uploads/origins/725ec7ec-8950-4401-8223-0da3a03186fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bad7e4bbdb9f87904d0beb9d878752ba 2x, https://si.imgix.net/dd601334/uploads/origins/725ec7ec-8950-4401-8223-0da3a03186fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11852b4edf1818960bcbf64d7f1dfb8b 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！\nお世話になっております。\n白鳥組の記念写真が見たいです！\n家でも、旅行先でも、どこでもいいですし、なんの記念撮影でもいいです！\nその点は全部お任せします。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/14", "thumbnail_src": "https://si.imgix.net/ac46f9fa/uploads/origins/b4f3da40-31be-497b-ad59-7abcf0517763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12eaf9c0070c5658961562cf5fbd030d", "thumbnail_srcset": "https://si.imgix.net/ac46f9fa/uploads/origins/b4f3da40-31be-497b-ad59-7abcf0517763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12eaf9c0070c5658961562cf5fbd030d, https://si.imgix.net/ac46f9fa/uploads/origins/b4f3da40-31be-497b-ad59-7abcf0517763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37ea961cbbac25beb56c6c11530e60af 2x, https://si.imgix.net/ac46f9fa/uploads/origins/b4f3da40-31be-497b-ad59-7abcf0517763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c717f3835ccda2d66ada837bc16c0913 3x", "genre": "art", "nsfw": false, "body": "お世話になっています！\n夏が過ぎ去った頃ですが、みらころが打ち上げ花火見てるのが見たいです。\n服装は浴衣でも私服でもどっちでも大丈夫です！お任せします〜\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/13", "thumbnail_src": "https://si.imgix.net/9296d1e1/uploads/origins/feec68ff-3fa1-4779-baba-87063e83e87b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabea1aefaeadf01bc0d875815593773", "thumbnail_srcset": "https://si.imgix.net/9296d1e1/uploads/origins/feec68ff-3fa1-4779-baba-87063e83e87b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabea1aefaeadf01bc0d875815593773, https://si.imgix.net/9296d1e1/uploads/origins/feec68ff-3fa1-4779-baba-87063e83e87b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4ed6c978083e1025d4ff09b8189f4bc 2x, https://si.imgix.net/9296d1e1/uploads/origins/feec68ff-3fa1-4779-baba-87063e83e87b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12036d6f17a9ec8764d3c09dc0ff0792 3x", "genre": "art", "nsfw": false, "body": "お世話になってます！\nアーノルドとジェンソンがカフェの仕事をしてる(だべっててもいい)ところを描いて欲しいです！よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/12", "thumbnail_src": "https://si.imgix.net/a8251b3d/uploads/origins/ed20e92e-9a76-4c63-a078-c6547df16e74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f595bb36bb2249388d3dc6123def9976", "thumbnail_srcset": "https://si.imgix.net/a8251b3d/uploads/origins/ed20e92e-9a76-4c63-a078-c6547df16e74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f595bb36bb2249388d3dc6123def9976, https://si.imgix.net/a8251b3d/uploads/origins/ed20e92e-9a76-4c63-a078-c6547df16e74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d1b3b42d07a053378a21be8453370ff 2x, https://si.imgix.net/a8251b3d/uploads/origins/ed20e92e-9a76-4c63-a078-c6547df16e74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4da442959419f143f0beb69633d80480 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/11", "thumbnail_src": "https://si.imgix.net/7c536933/uploads/origins/098ae077-cde5-48b5-bc05-9aae7786fc1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ad974b168d7eaedbe5d1b26c040f87", "thumbnail_srcset": "https://si.imgix.net/7c536933/uploads/origins/098ae077-cde5-48b5-bc05-9aae7786fc1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ad974b168d7eaedbe5d1b26c040f87, https://si.imgix.net/7c536933/uploads/origins/098ae077-cde5-48b5-bc05-9aae7786fc1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cc29cc9617f408a19a1073ad46467da 2x, https://si.imgix.net/7c536933/uploads/origins/098ae077-cde5-48b5-bc05-9aae7786fc1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f55e785f4fecdff651036242c77d9502 3x", "genre": "art", "nsfw": false, "body": "お世話になっています！\n海嵐がころものほっぺをよく引っ張るので、その場面を書いて欲しいです！\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/10", "thumbnail_src": "https://si.imgix.net/78140ad7/uploads/origins/34fc08d7-aab2-4e34-a620-82fac4befbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=436deaedc443d8d317f2b06144525c05", "thumbnail_srcset": "https://si.imgix.net/78140ad7/uploads/origins/34fc08d7-aab2-4e34-a620-82fac4befbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=436deaedc443d8d317f2b06144525c05, https://si.imgix.net/78140ad7/uploads/origins/34fc08d7-aab2-4e34-a620-82fac4befbef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec9636b5442c49e31d7c1710557b2153 2x, https://si.imgix.net/78140ad7/uploads/origins/34fc08d7-aab2-4e34-a620-82fac4befbef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=091b808ec6cee218de58b1893eb034a7 3x", "genre": "art", "nsfw": false, "body": "イラストのリクエストではないのですが、青鳴柾の手書きサインをデザインしていただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/9", "thumbnail_src": "https://si.imgix.net/d77ce757/uploads/origins/159408ec-593c-4e19-a7b1-771d4458d118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a284a8a4d458741032da498dcad080dc", "thumbnail_srcset": "https://si.imgix.net/d77ce757/uploads/origins/159408ec-593c-4e19-a7b1-771d4458d118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a284a8a4d458741032da498dcad080dc, https://si.imgix.net/d77ce757/uploads/origins/159408ec-593c-4e19-a7b1-771d4458d118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=230c3478d8c6f48671776a0e96a13c58 2x, https://si.imgix.net/d77ce757/uploads/origins/159408ec-593c-4e19-a7b1-771d4458d118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e6e2688cebf98a3848b210f20bf6753 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/8", "thumbnail_src": "https://si.imgix.net/a9ee6cbe/uploads/origins/cfa0aa7f-eee3-47d0-af05-1424d9c33397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d99513f2d52314af31605389b7ef1c3", "thumbnail_srcset": "https://si.imgix.net/a9ee6cbe/uploads/origins/cfa0aa7f-eee3-47d0-af05-1424d9c33397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d99513f2d52314af31605389b7ef1c3, https://si.imgix.net/a9ee6cbe/uploads/origins/cfa0aa7f-eee3-47d0-af05-1424d9c33397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c3d3ed93307aea91f74097880b53031 2x, https://si.imgix.net/a9ee6cbe/uploads/origins/cfa0aa7f-eee3-47d0-af05-1424d9c33397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc983985872fca02cad5b1bbc25d19a4 3x", "genre": "art", "nsfw": false, "body": "お世話になっています。今回初めてリクエストをしました。\nリクエスト内容なのですが…いわゆる生物なのですが大丈夫でしょうか？自分の上司がなかなか認めないのですがおそらくそうですね。彼らの日常をリクエストしたいと思い、こちらにお願いしました。\n構図やシチュエーションはお任せします。\n簡単ですが彼らの概要も送っておきますね。\n\n【概要】\n2人とも某警察署勤務。同い年の30代。男性。お互いのイメージカラーのヘヤピンをつけている。キス経験あり。\n銅流先輩(攻)…甘いもの好きの糖分モンスター。褐色が似合うイケメン。楽しいことが好きでよく久保先輩をからかっている。軽そうに見えて意外と秘密主義者。ヒーローみたいな人。よく久保先輩との近況報告(キスやデートをした事)を聞かしてくれる(久保先輩が止めに入るので全部本当のことですね)。イメージカラーは紫\n久保先輩(受)…俺の直属の上司。常に困り眉で自分に自信が無い。からかうと顔を真っ赤にして怒るが、だいたい許してくれる。コーヒーが好き。家が半壊した時に銅流先輩の家に泊まっていたらしい(寝顔写真が送られてきたのでおそらく同じベッドで寝ていたのだろう)。1日だけ子どものように小さくなったことがある。イメージカラーは青\n\n\n問題がなければ受理していただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/7", "thumbnail_src": "https://si.imgix.net/f580194b/uploads/origins/feb66c22-f5d7-49f9-813b-4526c77e8993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96366e21a53913a96158c23192267feb", "thumbnail_srcset": "https://si.imgix.net/f580194b/uploads/origins/feb66c22-f5d7-49f9-813b-4526c77e8993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96366e21a53913a96158c23192267feb, https://si.imgix.net/f580194b/uploads/origins/feb66c22-f5d7-49f9-813b-4526c77e8993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=348e10be5e956bd4c430c7b7543a0383 2x, https://si.imgix.net/f580194b/uploads/origins/feb66c22-f5d7-49f9-813b-4526c77e8993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b08c0c0a4948d8dfc76a7786d7fda334 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n青木とまりと搗海大鷹先輩の二人で写っているイラストをお願い出来ればと思いご連絡させて頂きました。\n構図や状況など、全てわぴさんにおまかせすることが可能でしたらおまかせでお願いしたいです。\n青木とまりと搗海大鷹先輩の服装や髪型の変更などに関してもわぴさんにお任せできればと思います。\nイラストはtwitter等SNSで紹介させていただく可能性や、個人用の鑑賞に使用するグッズ化の可能性があります。\nご検討よろしくお願いいたします。\n(もしも、おまかせだとアバウトすぎてだめなようでしたら、わぴさんの解釈の青木とまりと搗海大鷹先輩の学生時代をみられたら嬉しいなと思います。)", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/6", "thumbnail_src": "https://si.imgix.net/ed978305/uploads/origins/980413c3-35c2-4d1e-870f-92eb79cfed2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2d576b2f4da7c785abe663ee657323", "thumbnail_srcset": "https://si.imgix.net/ed978305/uploads/origins/980413c3-35c2-4d1e-870f-92eb79cfed2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2d576b2f4da7c785abe663ee657323, https://si.imgix.net/ed978305/uploads/origins/980413c3-35c2-4d1e-870f-92eb79cfed2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cd38d298cc618cc54267deb4533bc4b 2x, https://si.imgix.net/ed978305/uploads/origins/980413c3-35c2-4d1e-870f-92eb79cfed2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6af66df5d860750f4cba6df32e7fdba 3x", "genre": "art", "nsfw": false, "body": "翼のマジの照れ顔ください", "created_at": "", "completed_at": ""}, {"path": "/@tumumiko1210/works/5", "thumbnail_src": "https://si.imgix.net/a9abee0f/uploads/origins/660e0390-d6ae-46e4-8e90-c5f430a17d71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134d7b58387e9adede6acdfeb96911ca", "thumbnail_srcset": "https://si.imgix.net/a9abee0f/uploads/origins/660e0390-d6ae-46e4-8e90-c5f430a17d71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134d7b58387e9adede6acdfeb96911ca, https://si.imgix.net/a9abee0f/uploads/origins/660e0390-d6ae-46e4-8e90-c5f430a17d71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f40f2db580b76197205cae04aae928e 2x, https://si.imgix.net/a9abee0f/uploads/origins/660e0390-d6ae-46e4-8e90-c5f430a1