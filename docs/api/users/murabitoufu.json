a47d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d48f2aee29116a16c7d62ae445836ce, https://si.imgix.net/2e44e4b7/uploads/origins/f42b6806-e86b-422e-8c48-803ad8a0a47d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77fa5e08a63c17633366d7ff30d3ef5a 2x, https://si.imgix.net/2e44e4b7/uploads/origins/f42b6806-e86b-422e-8c48-803ad8a0a47d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=050df807364c4dceae3279939598694f 3x", "genre": "art", "nsfw": true, "body": "字: [静謐な慶び]鷺沢文香＋。\n全裸で、服は体の下に押し込められている。\n緊縛方法：後手縛り＋亀甲縛り＋膝縄＋M字開脚＋首輪＋布裂き猿轡＋ボールギャグ。\n彼女の胸を揉みながらの一人称セックス。\n彼女の髪を下ろし、リング状の髪留めをキープ。\n彼女の周りには使用済みのコンドームが散乱していた。\nありがとう！\n\nhttps://drive.google.com/drive/folders/1o0rCfLMMuZkrQ-FRMYgxuzyOCvqrpsZH", "created_at": "", "completed_at": ""}, {"path": "/@murabitoufu/works/405", "thumbnail_src": "https://si.imgix.net/649750ae/uploads/origins/5aad2ffd-7f90-479e-a134-f2746be32e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fd62f401341c3753abd72a6054cddd5", "thumbnail_srcset": "https://si.imgix.net/649750ae/uploads/origins/5aad2ffd-7f90-479e-a134-f2746be32e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fd62f401341c3753abd72a6054cddd5, https://si.imgix.net/649750ae/uploads/origins/5aad2ffd-7f90-479e-a134-f2746be32e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c932506644e9bdb811052cb967247a7a 2x, https://si.imgix.net/649750ae/uploads/origins/5aad2ffd-7f90-479e-a134-f2746be32e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8303b785045ec371ad33ef44bf58a927 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@murabitoufu/works/404", "thumbnail_src": "https://si.imgix.net/06b50805/uploads/origins/6f750ab7-60b2-4150-a4eb-79ac24466a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31613d0e6ca4a07ba5fb12ca4a434601", "thumbnail_srcset": "https://si.imgix.net/06b50805/uploads/origins/6f750ab7-60b2-4150-a4eb-79ac24466a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31613d0e6ca4a07ba5fb12ca4a434601, https://si.imgix.net/06b50805/uploads/origins/6f750ab7-60b2-4150-a4eb-79ac24466a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2802136397190d5bb536d004427412c7 2x, https://si.imgix.net/06b50805/uploads/origins/6f750ab7-60b2-4150-a4eb-79ac24466a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1153711cce1ef8b0b78137f9f3fccb2c 3x", "genre": "art", "nsfw": true, "body": "こんにちは。また依頼をさせていただきます。以前描いて頂いたチャイナドレスを着た紫雲清夏のイラストの続きのような構図の依頼なのですがよろしいでしょうか。\nキャラクター：学園アイドルマスターの紫雲清夏\n衣装：ノースリーブの両側スリットありの赤チャイナドレス。下着はきわどいレースのTバックショーツ\n参考画像\nhttps://i.imgur.com/F2298mH.png\nhttps://i.imgur.com/l8ZdOdk.png\n構図：ベットに寝かされ、両手を拘束された状態で陰部にローターによる刺激を下着越しに与えられ、イってしまう図(そういうプレイという趣旨)\n\n引き受けて頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@murabitoufu/works/403", "thumbnail_src": "https://si.imgix.net/4ddda8b7/uploads/origins/6f28fee1-b93a-4f36-8b33-76003c5ec5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63910dad6e291070d899411e4423d2a", "thumbnail_srcset": "https://si.imgix.net/4ddda8b7/uploads/origins/6f28fee1-b93a-4f36-8b33-76003c5ec5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63910dad6e291070d899411e4423d2a, https://si.imgix.net/4ddda8b7/uploads/origins/6f28fee1-b93a-4f36-8b33-76003c5ec5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c504a3b938923ecf946ad7b5b197092d 2x, https://si.imgix.net/4ddda8b7/uploads/origins/6f28fee1-b93a-4f36-8b33-76003c5ec5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72b6dddaa32914e51ca86124d3a5a358 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私の4人のOCのイラストが欲しいです。\n\n全裸。\n布ギャグ。\n両手を後ろ手に縛り、胸を強調してほしい。\n足と股間もロープで縛る。\n\nhttps://skeb.jp/@murabitoufu/works/365\n\nhttps://drive.google.com/drive/folders/1yaMYXXb0CREUz3guIj3VrcNGCiI_YiMg", "created_at": "", "completed_at": ""}, {"path": "/@murabitoufu/works/402", "thumbnail_src": "https://si.imgix.net/ba4c9e95/uploads/origins/a1132f5c-1f66-4cfe-9bb8-134dcb56d660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69e83b8140234ff7a73eea3ab07332a3", "thumbnail_srcset": "https://si.imgix.net/ba4c9e95/uploads/origins/a1132f5c-1f66-4cfe-9bb8-134dcb56d660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69e83b8140234ff7a73eea3ab07332a3, https://si.imgix.net/ba4c9e95/uploads/origins/a1132f5c-1f66-4cfe-9bb8-134dcb56d660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=281f7f6256f0c90c869e0b176ba2b540 2x, https://si.imgix.net/ba4c9e95/uploads/origins/a1132f5c-1f66-4cfe-9bb8-134dcb56d660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e42a51a12ea33d7676d66a018af62e7c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@murabitoufu/works/401", "thumbnail_src": "https://si.imgix.net/e4c27407/uploads/origins/a8b865c6-fba2-4eec-a5eb-b1bbbbb3d4ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c