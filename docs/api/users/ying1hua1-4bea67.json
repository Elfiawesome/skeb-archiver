3fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a16eb598d5c42244451f1c2c9339110c 2x, https://si.imgix.net/542b80a7/uploads/origins/6abb0408-cfc0-4c55-8ed4-352cd02b42bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7c7aa5c17ffc6947b7421868398af01 3x", "genre": "art", "nsfw": false, "body": "真冬様\nはじめまして、個人でVtuberをしているシバと申します。\n今回、私のイラストを描いていただきたくリクエストしました。\n\n衣装ですが、地雷系の服装でお願いします。\nその際、髪形はお任せいたします。\n\n構図ですが、モンスターキューバリブレ（赤）を持たせてほしいです。\n表情は若干病んでる感じでお願いします。\n\n可能でしたら、髪が途中で横に切れないように描いていただきたいです。\n\n立ち絵にあるように私の髪が白くてとても長く、毛量が多いのでその辺りを意識していただけると幸いです。\n※身長は140cmです。\n\n\n【使用用途】\nTwitterへの掲載、YouTube活動におけるサムネ、アイコンとしての使用などを考えております。\nまた、可能であればサムネ等へ使用できるように背景透過のデータ(psdファイルなど)もいただけると幸いです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14O3evcYwc7AewEPeyJwDsgUNS6QXiSCx?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@ying1hua1/works/2", "thumbnail_src": "https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397cfae15e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba86cb3b69e2c3527d106728148811d", "thumbnail_srcset": "https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397cfae15e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba86cb3b69e2c3527d106728148811d, https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397cfae15e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55a17e7a845cf84b9d735a839485897b 2x, https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397cfae15e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcdadfa22d4f6a0272341e97c32be13d 3x", "genre": "art", "nsfw": false, "body": "真冬さん、はじめまして！❄️☃️\n真冬さんの絵柄、お顔はもちろん七七ちゃんやナヒーダちゃんの絵のおててや肘の描き方がとってもかわいいですね☺️\n\nよろしければ、世界樹の迷宮というゲームのシャーマン(メカクレ♂)の絵を描いていただけないでしょうか？幼児体型が特徴の種族のキャラなので、絵柄にきっと合うかと思います。\n可能でしたら、資料にあるようなワルな顔にしていただけたらとっても嬉しいです！\n\nhttps://drive.google.com/drive/folders/1-2ZqS_gIFVHqFmNw3zDfp4Sb9EMq58BU\n\n資料からわかりにくい服の部分などは、簡単な感じにして下さって構いません(私にもわかりません)描きやすいように描いていただければと思います。\nご検討いただければ幸いです！\n\nhttps://drive.google.com/drive/folders/1-2ZqS_gIFVHqFmNw3zDfp4Sb9EMq58BU", "created_at": "", "completed_at": ""}, {"path": "/@ying1hua1/works/1", "thumbnail_src": "https://si.imgix.net/8aca68f6/uploads/origins/c4db58ad-92bd-436e-8cb2-c951e934f428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72f9af57c11ce9a16a21a75a5abebb77", "thumbnail_srcset": "https://si.imgix.net/8aca68f6/uploads/origins/c4db58ad-92bd-436e-8cb2-c951e934f428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72f9af57c11ce9a16a21a75a5abebb77, https://si.imgix.net/8aca68f6/uploads/origins/c4db58ad-92bd-436e-8cb2-c951e934f428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c408e42b604dd533f84821503fe636c0 2x, https://si.imgix.net/8aca68f6/uploads/origins/c4db58ad-92bd-436e-8cb2-c951e934f428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c54b21f430a09f6d1eb10cbfcc0c7b54 3x", "genre": "art", "nsfw": false, "body": "Hi, I received your appeal! I'd love for you to draw Ashley Taylor from Magia Record!\n\nhttps://wiki.puella-magi.net/Ashley_Taylor", "created_at": "", "completed_at": ""}]}