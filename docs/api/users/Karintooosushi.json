.imgix.net/ebd0d34e/uploads/origins/333a2696-e26f-4b85-a678-71b14d9e1363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a66a56d8a7ef4c80af43222081738e02 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/20", "thumbnail_src": "https://si.imgix.net/7fc03ec1/uploads/origins/35e676b3-ebbb-4347-8d72-6917ea7211c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0941e4565e3ce82c55b7a4b620006f56", "thumbnail_srcset": "https://si.imgix.net/7fc03ec1/uploads/origins/35e676b3-ebbb-4347-8d72-6917ea7211c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0941e4565e3ce82c55b7a4b620006f56, https://si.imgix.net/7fc03ec1/uploads/origins/35e676b3-ebbb-4347-8d72-6917ea7211c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a502c33f0579c801455d5121e11c8d97 2x, https://si.imgix.net/7fc03ec1/uploads/origins/35e676b3-ebbb-4347-8d72-6917ea7211c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc357f9bc6c705b4a2fb86c465b70047 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/19", "thumbnail_src": "https://si.imgix.net/a3ca916d/uploads/origins/932d7377-3f4e-4f3c-9264-44c87c832cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15d41d333e6679f8240b939617be7d8b", "thumbnail_srcset": "https://si.imgix.net/a3ca916d/uploads/origins/932d7377-3f4e-4f3c-9264-44c87c832cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15d41d333e6679f8240b939617be7d8b, https://si.imgix.net/a3ca916d/uploads/origins/932d7377-3f4e-4f3c-9264-44c87c832cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92731d1a7f76c76b3a035923bdc1f2b6 2x, https://si.imgix.net/a3ca916d/uploads/origins/932d7377-3f4e-4f3c-9264-44c87c832cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dc1d29171dc130429419d67c585a895 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵のスタイルと色が好きです。僕のOCを描いてくれませんか？\n\n私のOCはドラゴンと混血した狼で、ドラゴンの爪と尻尾を持っています。体から雷や電気を発することができる。気分は落ち込んでいて、他人を恐れている。人が近づくと攻撃する。\n構図、背景、ポーズはお任せします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1IaLHSZgeNiUVAtD1VFFEXeJ0PyLf1TRk", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/18", "thumbnail_src": "https://si.imgix.net/8f762569/uploads/origins/1920cd5e-2d23-49bd-90e5-3e7326dc1a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6432e36b2a4190bfddea0f4b45850fc1", "thumbnail_srcset": "https://si.imgix.net/8f762569/uploads/origins/1920cd5e-2d23-49bd-90e5-3e7326dc1a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6432e36b2a4190bfddea0f4b45850fc1, https://si.imgix.net/8f762569/uploads/origins/1920cd5e-2d23-49bd-90e5-3e7326dc1a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ec30c4ef08a6928302ddf1005e7e064 2x, https://si.imgix.net/8f762569/uploads/origins/1920cd5e-2d23-49bd-90e5-3e7326dc1a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abc18eca9a1a534c67daddbdcd47262c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、かりんと、\n\n前回の絵、本当にありがとうございました。\n\nまたこのドラゴンの絵を描いてください。\n\n私の要求に従う必要があります：\nドラゴン・マスター・リファレンス・シート1-5」を参照してください。\n私のドラゴンはアートワークの中で翼を持っていますが、私はあなたが少し効果を与えることができることを願っています（例えば：軽い翼の効果）。\n私のドラゴンは全身にディテールとテクスチャーがあります。\n私のドラゴンは影と光のある金属色をしています。\n2つのアートワーク（口を開け、口を閉じるだけ）を希望します。\nアートワークには16:9（4K伝説の壁紙）が必要ですが、細部まで描いていただけると嬉しいです。私はアーティストがこのアートワークで創造性と革新性を提供できることを願っています。\n\n構図、背景、ポーズなどは(かりんと)さんにお任せ致します以上です、何卒お願い致します！私のキャラ (設定: https://drive.google.com/drive/folders/1WwkAwVrpRm5t5H3X2GaNFOkaYorAM1Jf?usp=sharing)\n\nありがとうございました。\nオルタ\n\nhttps://drive.google.com/drive/folders/1WwkAwVrpRm5t5H3X2GaNFOkaYorAM1Jf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/17", "thumbnail_src": "https://si.imgix.net/341a34e2/uploads/origins/9d78a129-c20c-4562-a8a8-817fb64da6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c8de64a31dbf695d88a6fa0f3a49e5", "thumbnail_srcset": "https://si.imgix.net/341a34e2/uploads/origins/9d78a129-c20c-4562-a8a8-817fb64da6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c8de64a31dbf695d88a6fa0f3a49e5, https://si.imgix.net/341a34e2/uploads/origins/9d78a129-c20c-4562-a8a8-817fb64da6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68fd953d3a76c3ce7c20f1c80c5fef9d 2x, https://si.imgix.net/341a34e2/uploads/origins/9d78a129-c20c-4562-a8a8-817fb64da6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba5284141c9684f6cbff52d3799d94bc 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私の名前はゲイルで、私のOCは変身したグレイ・ウルフです。\n彼の雰囲気は真面目というか野性的な感じですが、魅力的で支配的な彼を描いてほしいです。\nまた、彼の性器が見える2つのバージョンもお願いできますか？\n\nありがとうございます。\n\nhttps://drive.google.com/drive/folders/1l5LqFz1Fqvcasa_cTpeEAMw5Tv27Ovck", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/16", "thumbnail_src": "https://si.imgix.net/37dc4963/uploads/origins/380ab0fd-5c54-4735-b8d2-1da605c0afa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=496e1f4ee9939e20e310b91bd88622d6", "thumbnail_srcset": "https://si.imgix.net/37dc4963/uploads/origins/380ab0fd-5c54-4735-b8d2-1da605c0afa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=496e1f4ee9939e20e310b91bd88622d6, https://si.imgix.net/37dc4963/uploads/origins/380ab0fd-5c54-4735-b8d2-1da605c0afa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4252bf8ab727adfd3f8a111cdfacb2c6 2x, https://si.imgix.net/37dc4963/uploads/origins/380ab0fd-5c54-4735-b8d2-1da605c0afa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=531d218aaaa35f432205b52e9c6b5057 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/15", "thumbnail_src": "https://si.imgix.net/cf38dca2/uploads/origins/72b006f6-5e8e-4690-802f-3bd96315e702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f98b3b218383aa150fc117cb406329f3", "thumbnail_srcset": "https://si.imgix.net/cf38dca2/uploads/origins/72b006f6-5e8e-4690-802f-3bd96315e702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f98b3b218383aa150fc117cb406329f3, https://si.imgix.net/cf38dca2/uploads/origins/72b006f6-5e8e-4690-802f-3bd96315e702?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa25284033fa18947dc6bd12dd3172c 2x, https://si.imgix.net/cf38dca2/uploads/origins/72b006f6-5e8e-4690-802f-3bd96315e702?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca168e2f4dd371f3599187a132bd6d33 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつもお世話になっております！\n\n私のOCをかりんとさんにぜひ描いていただきたく、僭越ながらリクエストさせていただきました！\n\n構図は、\n見下しながらギャルピース\nといった感じでお願いしたいです！\n\n資料についてですが、色も塗っておらず非常に見づらいと思いますので、自由に改変していただいて全く問題ありません！\n\n金額が足りない、資料が見れない等ございましたらキャンセルお願いします。\nお忙しい中恐れ入りますが、検討よろしくお願いします！\n\nhttps://drive.google.com/file/d/1Qt_CwyPPMJTxD8yoy85Kueagl8gHdlGF/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/14", "thumbnail_src": "https://si.imgix.net/b8e04349/uploads/origins/68c89881-8bd3-438c-9014-510d39ae85f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2b09ee418b1b3c55f6391ce54c2cf9d", "thumbnail_srcset": "https://si.imgix.net/b8e04349/uploads/origins/68c89881-8bd3-438c-9014-510d39ae85f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2b09ee418b1b3c55f6391ce54c2cf9d, https://si.imgix.net/b8e04349/uploads/origins/68c89881-8bd3-438c-9014-510d39ae85f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a055843a7128fd1d0cfb594ec98c358 2x, https://si.imgix.net/b8e04349/uploads/origins/68c89881-8bd3-438c-9014-510d39ae85f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fa1f0b2ba11ea4079225efce3c71c82 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵のスタイルと鮮やかな色が好きです。僕のドラゴンのOCを描いてくれないかな？\n彼の名前はゴールドで、羽の生えた優しそうなドラゴンです。彼の雰囲気は優雅で、優しくて自由。\nあなたの芸術的な自由に任せます。\n\nhttps://drive.google.com/drive/folders/1Dbd8BXW27KDQFtSXTaVoVHeMRvGNCqz5?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/13", "thumbnail_src": "https://si.imgix.net/69807002/uploads/origins/4e3e71d5-71a3-49c6-89b7-9c81eba6c57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc3f713a1a98e538d58ebefd693446c3", "thumbnail_srcset": "https://si.imgix.net/69807002/uploads/origins/4e3e71d5-71a3-49c6-89b7-9c81eba6c57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc3f713a1a98e538d58ebefd693446c3, https://si.imgix.net/69807002/uploads/origins/4e3e71d5-71a3-49c6-89b7-9c81eba6c57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1ee40984c9170b2f1ea67ddf8267e06 2x, https://si.imgix.net/69807002/uploads/origins/4e3e71d5-71a3-49c6-89b7-9c81eba6c57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d994e5712700b42125b66d2f15ce6bd 3x", "genre": "art", "nsfw": true, "body": "こんにちは、Karinto。私はあなたのドラゴンのキャラクターのスタイルがとても好きで、私のOCをドラゴンとして描いてもらいたいと思っています。私のOCであるVeerzは狼とライオンのハイブリッドで、彼は手裏剣のようなポータルを使って他の種族に変身します（参考画像_Veerz Art 01.jpg参照）。\n\n体がよく見えるセクシーなポーズで描いてください。同じアートワークで、性器のない無難なバージョンと、大きな雄ドラゴンの性器がスリットから出ている大人っぽいバージョンの2種類を描いてもらえないでしょうか。もし参考資料が必要なら、私のOCのポーズと性器のアイデアをいくつか載せておきますが、彼に一番似合うものを自由に選んでください。\n\nよろしくお願いします！\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/14pcLuyUQtEsSujSQLJvy1ibbnSMiPtjf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/12", "thumbnail_src": "https://si.imgix.net/63ce06d5/uploads/origins/143fc258-000e-4901-addb-414a28e756e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b2f2a8498ae0a0baa3781baf2f913f1", "thumbnail_srcset": "https://si.imgix.net/63ce06d5/uploads/origins/143fc258-000e-4901-addb-414a28e756e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b2f2a8498ae0a0baa3781baf2f913f1, https://si.imgix.net/63ce06d5/uploads/origins/143fc258-000e-4901-addb-414a28e756e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7630a646a3ee09791388722b0d980bca 2x, https://si.imgix.net/63ce06d5/uploads/origins/143fc258-000e-4901-addb-414a28e756e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33937263324d58d7a00d2385ef5d0d18 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n今までの作品を拝見して、ドラゴンの描き方が好きです。私のドラゴンのOCを描いてくれませんか？\n羽の生えたドラゴンです。彼の雰囲気は優雅で、優しくて、自由です。\nどんなポーズでも自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1Dbd8BXW27KDQFtSXTaVoVHeMRvGNCqz5?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/11", "thumbnail_src": "https://si.imgix.net/2310ce46/uploads/origins/3fa58599-03cb-4811-8006-6991fa79bf27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37959f50a6255a6e934ab3064187fd9f", "thumbnail_srcset": "https://si.imgix.net/2310ce46/uploads/origins/3fa58599-03cb-4811-8006-6991fa79bf27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37959f50a6255a6e934ab3064187fd9f, https://si.imgix.net/2310ce46/uploads/origins/3fa58599-03cb-4811-8006-6991fa79bf27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5029445f6e2f5a6b2856c9ca12a41a7b 2x, https://si.imgix.net/2310ce46/uploads/origins/3fa58599-03cb-4811-8006-6991fa79bf27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e92237a51b20ca87cbf275045f086caf 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの素晴らしいアートを拝見し、とても感銘を受けたので、私のキャラクターを描いていただけないかとお願いしました！\n\n私のキャラクターMero（彼らはリンクスです）のリファレンスはこちらです：\nhttps://drive.google.com/file/d/1H1SZ8dGHUTsvy-18VHHyWodzBFTLCl-7/view?usp=drive_link\nhttps://drive.google.com/file/d/1s_IM7JOV2R4cj9wrnFcAXVI1RTldfGRG/view?usp=drive_link\n\n彼らの好きなものを自由に描いてください！ハートの瞳孔のない絵がないので、違うものを描いてくれるとうれしいです！あと、黄色い鋭い歯も描いてほしいです！また、服装は変えてもいいですが、トゲトゲの首輪は残してほしいです。\n\nご検討ありがとうございます！:3", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/10", "thumbnail_src": "https://si.imgix.net/f828af94/uploads/origins/50fc1d33-f3d7-49ec-bae1-260c1e225697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d56f8d1f87a0c9146f4725a31cb40a7d", "thumbnail_srcset": "https://si.imgix.net/f828af94/uploads/origins/50fc1d33-f3d7-49ec-bae1-260c1e225697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d56f8d1f87a0c9146f4725a31cb40a7d, https://si.imgix.net/f828af94/uploads/origins/50fc1d33-f3d7-49ec-bae1-260c1e225697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73c4a4079742a5c82a01e9d3be3e53fd 2x, https://si.imgix.net/f828af94/uploads/origins/50fc1d33-f3d7-49ec-bae1-260c1e225697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dc3d661fa2a5b5f674097373553afae 3x", "genre": "art", "nsfw": true, "body": "かりんとへ、\n\n前回の絵、本当にありがとう。このメカドラゴンのためにもっと絵を描いて、新しいアートワークで向上してくれることを願っています。\n\n私の要求は以下の通りです：\n1.1.私のメカドラゴンには翼があります。\n2.2.私のメカドラゴンの全身のディテールとテクスチャー。\n3.私のメカドラゴンは、影と光のある金属色を持っています。\n4.このメカドラゴンのかっこいいポーズを描くのを手伝ってください。\n5.このメカドラゴンのポーズに合うような背景のデザインをお願いします。\n6.6. 作品は16:9 [3840 × 2160](4K Legendary Wallpaper)が必要です。\n7.7.必要なPSDファイルを提供してください。\n8.8.私はそれが2つのアートワークを持っていることを願っています（ちょうど口を開いて、口を閉じて）、あなたが提供することができれば、私はあなたに感謝します。\n\nメカドラゴンを描くために「メカドラゴンマスターリファレンス1-5」フォルダをよくご覧ください。\n参考までにアートワーク1-9も含まれています。\n\n頑張って描いてください。\n\nありがとうございました。\nオルタ\n\nhttps://drive.google.com/drive/folders/1WwkAwVrpRm5t5H3X2GaNFOkaYorAM1Jf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/9", "thumbnail_src": "https://si.imgix.net/0cd2c010/uploads/origins/28636539-1cb5-4b4b-af4c-80baf9eb9d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c84652477012d970a3ffe54a539ac8c4", "thumbnail_srcset": "https://si.imgix.net/0cd2c010/uploads/origins/28636539-1cb5-4b4b-af4c-80baf9eb9d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c84652477012d970a3ffe54a539ac8c4, https://si.imgix.net/0cd2c010/uploads/origins/28636539-1cb5-4b4b-af4c-80baf9eb9d81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ba53860218657c9c97f3f78d7ca170a 2x, https://si.imgix.net/0cd2c010/uploads/origins/28636539-1cb5-4b4b-af4c-80baf9eb9d81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71c0d8ace4e8b410406350131f037a75 3x", "genre": "art", "nsfw": true, "body": "こんばんは、また依頼をしてみたくなりました。\n今回は赤竜人のアギルが竜人姉妹に左右からいじられる物をお願いします。\n\n内容はアギル(赤竜人)が白竜人(姉)と青竜人(妹)に左右から捕まえられて白竜人は誘惑を、青竜人は体触りしている状況をお願いします。具体的には\n赤竜人→左右の女性に挟まれ誘惑されて身体が硬直。\n白竜人→片手を赤竜人の頬に当てながら舌を伸ばして逆の頬を舐めている(唾液垂れてるとよい)\n青竜人→片手を胸から股に伸ばし触っている。姉に負けじと口を開けて舌を出し「次は私の番(誘惑)～」と待っている感じ(こちらも唾液を垂らしているとよい)\nこんな感じになります。\n\n(顔付近の差分で、赤竜人と白竜人または青竜人と舌を絡ませる様なエチチシチュが可能であればお願いしたいが、難しい様でしたら無しでも大丈夫です。)\n赤竜人に恋する白竜人と赤竜人の依頼になりますが、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1tkHGGbm0_3vnljuZpcPmu_gOzKMDpm1D", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/8", "thumbnail_src": "https://si.imgix.net/4c1729db/uploads/origins/ab2bf760-bea5-4a5a-aed9-a07f68ac392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b2e8eab80d8b84f51a8a8d46d587ae", "thumbnail_srcset": "https://si.imgix.net/4c1729db/uploads/origins/ab2bf760-bea5-4a5a-aed9-a07f68ac392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b2e8eab80d8b84f51a8a8d46d587ae, https://si.imgix.net/4c1729db/uploads/origins/ab2bf760-bea5-4a5a-aed9-a07f68ac392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=283bbd8f39d59b7a9a0369514299cb02 2x, https://si.imgix.net/4c1729db/uploads/origins/ab2bf760-bea5-4a5a-aed9-a07f68ac392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e71970460213d9c07acb1cc55b036c74 3x", "genre": "art", "nsfw": true, "body": "かりんとへ、\n\n新しい作品を提供するために、あなたのプロの芸術家の真の強力なスキルと意欲を見てみたい。\n\n私の要求は次のとおりです：\n1.1.私のメカドラゴンのアートワークには翼があります。\n2.私のメカドラゴンの全身のディテールとテクスチャー。\n3.私のメカドラゴンは、影と光のある金属色を持っています。\n4.このメカドラゴンのかっこいいポーズを描くのを手伝ってください。\n5.5.このメカドラゴンのポーズに合う「サイバーシティ」の背景をデザインしてください。\n6.6. 作品は16:9 [3840 × 2160](4K Legendary Wallpaper)でお願いします。\n7.7.必要なPSDファイルをご提供ください。\n8.8.私はそれが2つのアートワークを持っていることを願っています（ちょうど口を開いて、口を閉じて）、あなたが提供することができれば、私はあなたに感謝します。\n\nメカドラゴンを描くために「メカドラゴンマスターリファレンス1-5」フォルダをよくご覧ください。\n参考までにアートワーク1-9も含まれています。\n\n頑張って描いてください。\n\nありがとうございました。\nオルタ\n\nhttps://drive.google.com/drive/folders/1WwkAwVrpRm5t5H3X2GaNFOkaYorAM1Jf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/7", "thumbnail_src": "https://si.imgix.net/eb1e06d2/uploads/origins/95c4df32-4c55-4a68-a734-f9357318f61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93626b088bcb24feef4d6852a70baec6", "thumbnail_srcset": "https://si.imgix.net/eb1e06d2/uploads/origins/95c4df32-4c55-4a68-a734-f9357318f61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93626b088bcb24feef4d6852a70baec6, https://si.imgix.net/eb1e06d2/uploads/origins/95c4df32-4c55-4a68-a734-f9357318f61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0177758495ef65668e0c4d1eb4aab0d0 2x, https://si.imgix.net/eb1e06d2/uploads/origins/95c4df32-4c55-4a68-a734-f9357318f61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edbf9ac3854bbb5619720a4eef23deae 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nブラックドラゴンのデビルンのイラストを描いて欲しい。細かい構図等はお任せします。\nお手数ですが、宜しくお願いします。\n\n参考資料\nhttps://drive.google.com/drive/folders/1lIqliMxlO0jZ0LO6XUmzujgF3_6NG5bW", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/6", "thumbnail_src": "https://si.imgix.net/1990e22d/uploads/origins/cfb31865-adeb-406b-b87a-0510a65487ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05b2caef8369b4794430bf67d0382473", "thumbnail_srcset": "https://si.imgix.net/1990e22d/uploads/origins/cfb31865-adeb-406b-b87a-0510a65487ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05b2caef8369b4794430bf67d0382473, https://si.imgix.net/1990e22d/uploads/origins/cfb31865-adeb-406b-b87a-0510a65487ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0d709e69dd4abef04780ff482f234e4 2x, https://si.imgix.net/1990e22d/uploads/origins/cfb31865-adeb-406b-b87a-0510a65487ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa48b7bd056c7776adc37e8b885b0562 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/5", "thumbnail_src": "https://si.imgix.net/b83550c4/uploads/origins/b426cde6-8f1a-4714-a058-9134242fb631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bae675274b1a18f1612bcde016d41025", "thumbnail_srcset": "https://si.imgix.net/b83550c4/uploads/origins/b426cde6-8f1a-4714-a058-9134242fb631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bae675274b1a18f1612bcde016d41025, https://si.imgix.net/b83550c4/uploads/origins/b426cde6-8f1a-4714-a058-9134242fb631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6cca8c4ee4412a0ba6d87d4880cf86f 2x, https://si.imgix.net/b83550c4/uploads/origins/b426cde6-8f1a-4714-a058-9134242fb631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eddb8f1bbfd9b3047b6a24ad7d33a04f 3x", "genre": "art", "nsfw": true, "body": "こんばんは、前回めちゃくちゃ素敵なイラストにまた依頼してみたくなりました。今回も変わった内容で申し訳ありませんが2枚お願いします。(ダメそうなら却下で大丈夫です。)\n内容は\n1.うちの子「アルーレット」という闇竜に立ち向かうも返り討ちに合い触手に呑み込まれ繭に包まれて出された「シツライくん」のイラスト(繭の中にシツライくんがうっすら眠っている姿があるとよい)+(アルーレットのどんな子が産まれるかたまらなく舌出しながら快感の表情をみせていると良い。)\n\n2.繭を破きアルーレットの同種化したシツライくんが現れて自分の変化した姿に舌出しながら快感を感じている姿。(服は溶けて少し破けており刀はなしで良い。顔の雰囲気や、目とか髪色はそのままで翼や手足はアルーレットに似た形で、しっぽの先だけ刀を吸収した様に形に変化していると良いです。服や顔の雰囲気からシツライだった者とわかれば良いです)\n\n捕食されたあとのシーンと、変貌したキャラのシーンという2枚の依頼になり大変かと思いますが可能でしたらよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1TYnjoqgF8-a9e5iA-ynYNDjpCX7RdKec", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/4", "thumbnail_src": "https://si.imgix.net/0d5c2770/uploads/origins/44f65fae-7e40-48ba-8e3b-5d74db99fc49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5d7f9215cbb5a641a5a1aeb48b4f69d", "thumbnail_srcset": "https://si.imgix.net/0d5c2770/uploads/origins/44f65fae-7e40-48ba-8e3b-5d74db99fc49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5d7f9215cbb5a641a5a1aeb48b4f69d, https://si.imgix.net/0d5c2770/uploads/origins/44f65fae-7e40-48ba-8e3b-5d74db99fc49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecc39d3a66493a8e344b4b066264fc6b 2x, https://si.imgix.net/0d5c2770/uploads/origins/44f65fae-7e40-48ba-8e3b-5d74db99fc49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8edcd1002ae05efea3d252a8b214ccba 3x", "genre": "art", "nsfw": false, "body": "かりんとさん初めまして！ 貴方の素敵なイラストに惹かれて、是非自分のOCのドラゴンを描いて欲しい！と思いましたのでリクエスト致しました\n\n【イメージと詳細】\n表情からポーズ構図シチュエーション全てお任せします  アイコンにしやすいと嬉しいです\n\n【使用用途】\n個人観賞用としてのグッズやSNSへの投稿  アイコンヘッダーとしての利用\n\n大きい姿の方を希望しますが資料が非常に見にくく、色も塗っていないため、色やデザイン改変等全て大丈夫です    描くのが難しい場合小さい方を描いてくださると助かります\n\n資料が表示されない、金額が足りない等ありましたらキャンセルをお願いします\n大変お忙しいところ恐縮ですがご検討の程よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1nzRENfbZ8FNnrHBmCOE6nt9P6n--wKpf", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/3", "thumbnail_src": "https://si.imgix.net/2cb5cec6/uploads/origins/4249d893-f0e2-4517-8a94-2f64c91faf6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=156ee38f7b3e49d0e26bab91b09882b1", "thumbnail_srcset": "https://si.imgix.net/2cb5cec6/uploads/origins/4249d893-f0e2-4517-8a94-2f64c91faf6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=156ee38f7b3e49d0e26bab91b09882b1, https://si.imgix.net/2cb5cec6/uploads/origins/4249d893-f0e2-4517-8a94-2f64c91faf6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a554daa09dcdd708efad91b4f130ab3 2x, https://si.imgix.net/2cb5cec6/uploads/origins/4249d893-f0e2-4517-8a94-2f64c91faf6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6d154d68e9984ad51a7372b58f67c4f 3x", "genre": "art", "nsfw": true, "body": "こんばんは、オロロソ様とかの素敵なイラストに興味が出て依頼してみようと思いました。\n♀キャラ→♂キャラなんですが。\n資料にあるアギルという赤竜人がカルネラールという吸血竜に襲われ、カルネラールは片側の翼でアギルを包まれながら長い舌で味わおうとしているイラストをお願いします。\nアギルは恐怖からか硬直しており、そんな姿を可愛いと感じるカルネラールが悪戯心で舌舐めしてしまう感じです。\nカルネラールの口や舌は唾液とかでニチャァとしていると良いです。\n\n可能であればで良いのですが、カルネラールがもう片側の翼でも包み込み周りから見えない様にして本番を始めちゃうシチュもあると良いです。\n\nhttps://drive.google.com/drive/folders/1TYnjoqgF8-a9e5iA-ynYNDjpCX7RdKec", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/2", "thumbnail_src": "https://si.imgix.net/a902e14c/uploads/origins/95807ff3-3b29-493b-890d-7d5a606f206f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d4d89fd698020d9264bc19e39945c72", "thumbnail_srcset": "https://si.imgix.net/a902e14c/uploads/origins/95807ff3-3b29-493b-890d-7d5a606f206f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d4d89fd698020d9264bc19e39945c72, https://si.imgix.net/a902e14c/uploads/origins/95807ff3-3b29-493b-890d-7d5a606f206f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7ad0d0c1217aa6f519f33b6f54d0b74 2x, https://si.imgix.net/a902e14c/uploads/origins/95807ff3-3b29-493b-890d-7d5a606f206f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=354381f6aea556bc71f7e41031b6621a 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\nあなたのツイートを見ました。私のキャラクターと私の友人を好きなように描いてください！\n絵は自由です！\n\n私のキャラクターは筋肉質な紫色のライオンで、金色の目、舌、角（お好きなように描いてください）、尻尾（骨でも爬虫類でもお好きなように）、金色の模様があり、額には黒い十字架があります。\n\n私の友人のキャラクターは、金髪、青い目、長い耳、眼鏡をかけたヤギです。彼は小さくて弱いのですが、よく私のキャラクターを困らせたりいじめたり、彼女のおかしな計画に彼を引きずり込んだりします。\n\n私の友達が最近これを送ってきて、サウナや温泉の話をしました：\nhttps://x.com/miyamoyan/status/1899796789886406932\n\nありがとう！\n\n友達のOC : https://drive.google.com/drive/folders/1i7c_cr09mAF9uLeh2AlnMmW2wu5tIZAj?usp=sharing\n\nhttps://drive.google.com/drive/folders/1jbcEHfCj2yTtXBcPYA3mXNr24WxKU51g?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Karintooosushi/works/1", "thumbnail_src": "https://si.imgix.net/fb69cf3b/uploads/origins/3e50d57f-8b71-44f5-8513-3111a9e2daea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffac327c6f849a714ed17a2327bf7432", "thumbnail_srcset": "https://si.imgix.net/fb69cf3b/uploads/origins/3e50d57f-8b71-44f5-8513-3111a9e2daea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffac327c6f849a714ed17a2327bf7432, https://si.imgix.net/fb69cf3b/uploads/origins/3e50d57f-8b71-44f5-8513-3111a9e2daea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94f74e561dd9074262231e81c2fc3e9c 2x, https://si.imgix.net/fb69cf3b/uploads/origins/3e50d57f-8b71-44f5-8513-3111a9e2daea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a72d49703b7af3ec3c933ababc06f92 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私は2人のキャラクター、私のOcと私の友人のOcの間の小さなシーンを描きたいと思います。\nこのシーンでは、2人が互いの顔に手を添え、頬を引っ張り合って歯や舌を見せ合いたいと思います。ちょっと暗示的。\n\n私のキャラクターは、角があり、金色の舌と目を持つ紫色のライオンです。筋肉質で、とても恥ずかしそうな表情をします。大きな牙がある。\n\n私の友人のキャラクターは、金髪、青い目、長い耳、眼鏡をかけたヤギ。\n痩せていて、魅惑的でセクシーな表情をしている。\n\n好きなように着飾ることができる、\n\nポーズ参照 : https://safebooru.org/index.php?page=post&s=view&id=4923404 | https://safebooru.org/index.php?page=post&s=view&id=5022486 | https://safebooru.org/index.php?page=post&s=view&id=3530998\n\nフレンド Oc : https://drive.google.com/file/d/1oA0kY0CkT-bT1fITUr1xKPgk3iymJqnC/view?usp=sharing\n\nhttps://drive.google.com/drive/folders/1oU9HRbJWlcSJK6yUDfT85xMkNOEISBhD?usp=sharing", "created_at": "", "completed_at": ""}]}