72-87af-e6eb1b937e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a469e3b042ce4d167ce32c7a5e3eadda", "thumbnail_srcset": "https://si.imgix.net/9d13dd0c/uploads/origins/dd252ed8-8114-4072-87af-e6eb1b937e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a469e3b042ce4d167ce32c7a5e3eadda, https://si.imgix.net/9d13dd0c/uploads/origins/dd252ed8-8114-4072-87af-e6eb1b937e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8e0f5cef33b0cc90a3aaee5b912b34f 2x, https://si.imgix.net/9d13dd0c/uploads/origins/dd252ed8-8114-4072-87af-e6eb1b937e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d203e8ce3dfa606d066094a32003f0e 3x", "genre": "art", "nsfw": false, "body": "はじめまして、こんにちは、みゝ津ツクローさんの絵が好きでリクエストさせていただきます。\n\n今回体操服ユウカの絆ランク100の達成記念イラストを依頼したくリクエストしました。\n\nリクエスト内容\nゲーム「ブルーアーカイブ」の早瀬ユウカ（体操服）が、ゲーム内アイテムの「美しい花束」の1部を変更したものを受け取っているイラストをお願いしたいです。\n「美しい花束」は現在ゲーム内の期間限定パックである、贈り物パッケージにて手に入る赤い花束のことです。\n変更点は、普通の「美しい花束」ではなく、赤い花の代わりに謎マキを花束にした「謎マキの花束」を受け取っているイラストにして欲しいです。\n\nいただいたイラストはSNSのアイコンに利用したいと考えています。\n\n変なリクエスト内容で申し訳ないですが、ぜひよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mimizukuro/works/1", "thumbnail_src": "https://si.imgix.net/ac557449/uploads/origins/90bcc11a-8e20-4142-8a8b-ccb2bfe7c623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97df14c78f353829f92bbc30268f6ea6", "thumbnail_srcset": "https://si.imgix.net/ac557449/uploads/origins/90bcc11a-8e20-4142-8a8b-ccb2bfe7c623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97df14c78f353829f92bbc30268f6ea6, https://si.imgix.net/ac557449/uploads/origins/90bcc11a-8e20-4142-8a8b-ccb2bfe7c623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d918e6510303e21c0e4cbc7f6962a2b4 2x, https://si.imgix.net/ac557449/uploads/origins/90bcc11a-8e20-4142-8a8b-ccb2bfe7c623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5eacdd4337909d6abe2fd6160620a23 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます。\nはじめまして、朱島悠永です。\nVTuberをしておりまして、Youtubeのサムネ作成等に使用できる一枚絵をお願いしたいです。\n大きさは、フルHD画面いっぱいにバスト～顔だけ大きく映したときに荒くならない程度あれば十分で、1500×1500px以上になるかと思います。縦横比は指定ありません。\n身体や髪の毛が左右、上で見切れないと使い勝手がよく、また差分や透過の背景無しがあると嬉しいです。\n\n資料URLはLive2Dモデルの立ち絵（ほぼ直立）です。\nhttps://x.com/yuna_akashima/status/1491076792173875200\n※上記が閲覧できない場合はこちらをご参照願います。\nhttps://x.com/yuna_akashima/status/1661802642694369280\n髪と目は立ち絵に使用されていない決めた色がありますので、こちらに記載いたします。\n髪：\n・真朱色\nhttps://irocore.com/shinshu/\n目：\n・真朱色（目の色、明るい部分等）\nhttps://irocore.com/shinshu/\n・葡萄色（影等の暗い部分）\nhttps://irocore.com/ebi-iro/\n・海老色（中間色として使用する色）\nhttps://irocore.com/ebi-iro2/\n\n以上です。よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}