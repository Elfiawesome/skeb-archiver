4 2x, https://si.imgix.net/e29d92f8/uploads/origins/fa896322-988d-4ba7-87d9-9f3fe69bacc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59fb63d89a6dacae653dcc552775150c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/122", "thumbnail_src": "https://si.imgix.net/22524529/uploads/origins/27d04e7d-3ac6-4c5f-9f0b-b87d23aff8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9313827705efd03f6f382c68ef636e5b", "thumbnail_srcset": "https://si.imgix.net/22524529/uploads/origins/27d04e7d-3ac6-4c5f-9f0b-b87d23aff8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9313827705efd03f6f382c68ef636e5b, https://si.imgix.net/22524529/uploads/origins/27d04e7d-3ac6-4c5f-9f0b-b87d23aff8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bbad5bb7356191671131cc61e09e320 2x, https://si.imgix.net/22524529/uploads/origins/27d04e7d-3ac6-4c5f-9f0b-b87d23aff8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6e775c8e0269dfd856c51cd28a997b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/121", "thumbnail_src": "https://si.imgix.net/fcbec899/uploads/origins/81642040-6fa1-41d6-ab0a-bb848e9fc381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a0b019f9dd9ed0b383893344cb6b22", "thumbnail_srcset": "https://si.imgix.net/fcbec899/uploads/origins/81642040-6fa1-41d6-ab0a-bb848e9fc381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a0b019f9dd9ed0b383893344cb6b22, https://si.imgix.net/fcbec899/uploads/origins/81642040-6fa1-41d6-ab0a-bb848e9fc381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acbd1f538ad8389b1801722c73faca47 2x, https://si.imgix.net/fcbec899/uploads/origins/81642040-6fa1-41d6-ab0a-bb848e9fc381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab69e91b1143287c3ea0b09327c10478 3x", "genre": "art", "nsfw": true, "body": "以前描いてくださったアメスクビッチギャルの愛宕と高雄がとても素晴らしかったので\nリクエスト送らせて頂きました。\n長くなりますがご一考頂けますとありがたいです。\n\n【内容】\n無断で男を食い荒らしまくったアメスクビッチギャルの愛宕と高雄が\n罰としてふたなりのセントルイスとブレマートンに徹底的に調教セックスされた事後のイラスト\n\n【構図】\nベッドの上で左からセントルイス、愛宕、高雄、ブレマートンの配置\nセントルイスは愛宕の、ブレマートンは高雄の顔の横らへんでエロ蹲踞に近い姿勢\n愛宕と高雄は潰れたカエルのようにぐったりと横たわっている\n全員ムチムチな体型で汗でぐっしょりになっている\n\n【セントルイスとブレマートン】\n服装はそれぞれ参考資料の格好\n片手で愛宕と高雄の外側の乳房を思い切り鷲掴みして引っ張っている\n睾丸と竿はかなり大きめかつ太め\n睾丸と竿には無理やりつけさせたキスマークがついている\n表情はセントルイスは舌なめずりしながら口の端を歪めてブレマートンはご満悦な笑みを浮かべている\n\n【愛宕と高雄】\n全身白濁液まみれ\n服装は以前お描きしていただいたアメスクギャルの格好でブラとパンティが破られている\n股間部とアナルから大量の精液が溢れ出てており近くに置いてある生徒証にも大量にかかっている\n表情はハート目で上目を向いて涙を流しており口は呆然と開けており\n度重なる絶頂でピクピクと痙攣している\n\n可能であればふたなりから膨大の量の射精が行われ\n愛宕と高雄がさらに白濁液まみれになる差分もつけてもらえるとありがたいです。\n\n参考資料\nセントルイス：https://azurlane.wikiru.jp/attach2/E382BBE383B3E38388E383ABE382A4E382B9_455A466B4C454B56414141344441682D312E6A7067.jpg \nブレマートン：https://x.com/azurlane_staff/status/1834909967393890482?t=-b-G0b396M6yocSf6J0B8g&s=19", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/120", "thumbnail_src": "https://si.imgix.net/167eefa8/uploads/origins/fdd60916-c069-40e5-9ab0-0996c8d7a947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68787755aa34d0f648c490b6bfc20b73", "thumbnail_srcset": "https://si.imgix.net/167eefa8/uploads/origins/fdd60916-c069-40e5-9ab0-0996c8d7a947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68787755aa34d0f648c490b6bfc20b73, https://si.imgix.net/167eefa8/uploads/origins/fdd60916-c069-40e5-9ab0-0996c8d7a947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a63e0d9962b193b7ad1f646e27c5842 2x, https://si.imgix.net/167eefa8/uploads/origins/fdd60916-c069-40e5-9ab0-0996c8d7a947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bac0b355990451fb476855ff8a360236 3x", "genre": "art", "nsfw": true, "body": "いつもイラスト拝見しております。\n怪獣をはじめとするクリーチャー、そしてむちむちで魅力的な女の子、どちらもお上手でいらっしゃるため今回依頼させていただく次第です。\n\nオリジナルの女体型エロクリーチャーのイラストをお願いいたします。\n構図としましては「立ち絵風の構図」、細かい背景は無しでかまいません。\n以下の要素で描いていただきたいです。\n\n◆ケシの花がモチーフの植物系女体型クリーチャー\n\n・爆乳デカ尻のムチムチ体型＆常時ボテ腹\n\n・体色は全身紫色。粘液でヌルテカした質感\n\n・首から上はケシの蕾(参考画像1)のような異形頭となっていて、太く長い首が1本垂れ下がっており、大きく丸い頭の部分には縦向きのギョロっとした単眼がある。頭には口はついておらず、眼だけ\n\n・ボテ腹の中央にも大きな縦向き単眼がついている\n\n・頭、腹どちらも瞳の色は赤\n\n・先端に大きなケシ坊主(参考画像2)が付いた太い尻尾が生えている\n\n・首や尻尾にあたる茎の部分は(参考画像3)のようにねじれている\n\n・乳首にあたる部分にはそれぞれ一輪の毒々しい深紅色の花が咲いている\n\n・両手首から先は長くて大きいうねうね、ぬめぬめしている5本の触手状の手\n\n・両足首から先は茶色くゴツゴツした木の根っこのような形になっている\n\n・手首、足首、襟元、肩口、腰からはフリルのように葉が生えている\n\nというデザインでお願いします。\n\nhttps://pbs.twimg.com/media/GaDUyhia0AAqfMU.jpg\n参考画像1: ケシの花と体色のサンプル。垂れ下がっている丸い部分が蕾です。\n\nhttps://pbs.twimg.com/media/GaDUyhjbMAAglte.jpg\n参考画像2: ケシ坊主のサンプル。これを尻尾の先に付けてください。\n\nhttps://pbs.twimg.com/media/GaDUyhgaYAAfTN-.jpg\n参考画像3: 首と尻尾のねじれた茎部分のイメージ。お手間でしたら簡略化していただいてかまいません。\n\n大変細かい指定となってしまい恐縮ですが、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/119", "thumbnail_src": "https://si.imgix.net/d65452b0/uploads/origins/bfe3012c-a0a7-4afc-93ac-38a8229da216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f6af00030a81b6f4f2e6d3deb83d355", "thumbnail_srcset": "https://si.imgix.net/d65452b0/uploads/origins/bfe3012c-a0a7-4afc-93ac-38a8229da216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f6af00030a81b6f4f2e6d3deb83d355, https://si.imgix.net/d65452b0/uploads/origins/bfe3012c-a0a7-4afc-93ac-38a8229da216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fd40815f5a16c8b963bd21978a21e1e 2x, https://si.imgix.net/d65452b0/uploads/origins/bfe3012c-a0a7-4afc-93ac-38a8229da216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb24d54c28219fbf0404a4d1968149f8 3x", "genre": "art", "nsfw": true, "body": "ガルシアさん、良い夏を！あなたの絵がとても好きです！\nあなたに絵を描いてもらいたいのですが、あなたが一番向いていると思います！\n絵は、資料1のように、2人のキャラクターがステージで自分を表現しているところです。\nAはフロリダビキニ（資料2）、Bはスリングビキニ（資料3）。\n水着の色や登場人物のポーズを決めるのは自由！\nヌードバージョンもあるはずです。\nフィギュアはフルボディであること\n参考写真は資料4(A)と資料5(B)です。\n迅速な対応を希望します！\n\nhttps://drive.google.com/drive/folders/1FATItYv4LMDjU9E4KCRzB64OxSABkZtC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/118", "thumbnail_src": "https://si.imgix.net/51f64488/uploads/origins/2b9414be-e223-4a5f-9aaa-6534c5c03a1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49d82dd507eb9da436a86c0ab0dfdd1f", "thumbnail_srcset": "https://si.imgix.net/51f64488/uploads/origins/2b9414be-e223-4a5f-9aaa-6534c5c03a1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49d82dd507eb9da436a86c0ab0dfdd1f, https://si.imgix.net/51f64488/uploads/origins/2b9414be-e223-4a5f-9aaa-6534c5c03a1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de264876ec830c333d92064e25af856b 2x, https://si.imgix.net/51f64488/uploads/origins/2b9414be-e223-4a5f-9aaa-6534c5c03a1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0575041da69e432348c2d1828293dc4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/117", "thumbnail_src": "https://si.imgix.net/f0160e68/uploads/origins/48ffc9fe-3652-4ea5-802c-4a5bc43e29e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef85bac1d61ba986b40610e16a028493", "thumbnail_srcset": "https://si.imgix.net/f0160e68/uploads/origins/48ffc9fe-3652-4ea5-802c-4a5bc43e29e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef85bac1d61ba986b40610e16a028493, https://si.imgix.net/f0160e68/uploads/origins/48ffc9fe-3652-4ea5-802c-4a5bc43e29e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=225c5d9fe7ebe8ffd407cd070d937432 2x, https://si.imgix.net/f0160e68/uploads/origins/48ffc9fe-3652-4ea5-802c-4a5bc43e29e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8760921533470d1b8bb83865e0538475 3x", "genre": "art", "nsfw": true, "body": "また会いましょう、\n友人のOCから私のOCをたくさんリクエストしたい。\nシルフィアとティオナは搾乳ステーションで、他の女の子たちに奉仕されながら、シルフィアとティオナからそれぞれ精液とミルクを抽出している。ティオナの胸とシルフィアの玉はいつもより大きい。ティオナは正面を向いてバーに寄りかかり、巨乳をバケツのように垂らしている。シルフィアは背中を向けているので、奉仕する彼女たちの姿が少し鮮明に見える。\nできれば、ティオナが激しく潮を吹いて搾乳し、シルフィアもバケツから水しぶきを上げている別の画像が欲しい。自由に調整してください。\n作品を楽しみにしています！\nティオナ - 恥ずかしがりながらも、乳を搾られるのを楽しんでいる (https://photos.app.goo.gl/LETe7irs1cRXcwW9A)\nシルフィア-ハーレムに奉仕されて大満足 (https://photos.app.goo.gl/mftS8tnNgCQt2u7M8)\nアテナ - 羨ましそうにティオナの乳を搾る (https://photos.app.goo.gl/voNwgpvLYJQAuVYw5)\nヒルダ - 嬉しそうにティオナの乳を搾る (https://photos.app.goo.gl/AbyXjd26P1UBb3nv9)\n瀬尾＆アリサ - 瀬尾がティオナを慰め、アリサがおっぱいに捕まっている (https://photos.app.goo.gl/5nG89M2fYF6M4wmc9)\nセレナ - 従順にSylphiaに奉仕する。やり方はあなた次第 (https://photos.app.goo.gl/pCuv9P8oWxvMjw5h6)\nオセラ - シルフィアのペニスの軸に愛おしそうにキスする、アテナに似た体 (https://photos.app.goo.gl/KvcSNhpD7SXVB1w3A)\nメロディ - シルフィアのタマを従順に舐める、まるで朦朧としているかのように、ミホに似た身体 (https://imgur.com/a/4A6Qin3)\nミホ - 誰を助けるかはあなた次第 (https://photos.app.goo.gl/oGY5q8NHZAWvv1AUA)\nポーズ - https://photos.app.goo.gl/Y5Ar7tBmDui3hseu6", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/116", "thumbnail_src": "https://si.imgix.net/ded0d473/uploads/origins/4cd31d1d-ede9-4094-aee0-da3c040e464a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9406b0f86f9288c1644cef466528f7fe", "thumbnail_srcset": "https://si.imgix.net/ded0d473/uploads/origins/4cd31d1d-ede9-4094-aee0-da3c040e464a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9406b0f86f9288c1644cef466528f7fe, https://si.imgix.net/ded0d473/uploads/origins/4cd31d1d-ede9-4094-aee0-da3c040e464a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b108b1e220a0a065835dcdb456df2fb3 2x, https://si.imgix.net/ded0d473/uploads/origins/4cd31d1d-ede9-4094-aee0-da3c040e464a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50747955f1fd805161e034066c651e5a 3x", "genre": "art", "nsfw": true, "body": "ガルシア様へ\nいつも作品を楽しみにしております。\nラスオリうわキツ部のイラストがとても好きなので依頼いたします。\n\n■シチュエーション\nラスオリうわキツ部・魔法少女（？）勢ぞろい！\n\n■キャラクター\nクノイチ・エンライを含めた３～５名。\nキャラクターの人数・選定はお任せいたします。\n\n■内容詳細\n・エンライはスキン「ミスオルカ：誰かの作品」の魔法少女衣装（無規制版）でお願いします。\n・その他のキャラについては、\n●「ミスオルカ：誰かの作品」のような、デフォルトスキンを魔法少女っぽくアレンジした衣装（露出は無規制版レベル）\n●デフォルトスキンとは違う髪型（魔法少女に変身して髪型が変わるイメージ）\nこちらの外見でお願いします。\n・変身した後の決めポーズをとっている感じの全身描写（見切れなし）でお願いします。\n・表情は、少し恥じらっているような笑顔でお願いします。\n\n\n■その他要望\n・金額的に可能であれば、以下の差分をいただけますと嬉しいです。\n●全裸の差分\n●興奮して発情してしまっている表情の差分\n\n長文で申し訳ありません。\n何卒ご検討のほどお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/115", "thumbnail_src": "https://si.imgix.net/0548a28e/uploads/origins/7dae48ce-372a-4552-bd9b-6eb65c8eb4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592bc81e2599cfa0b18c133e62a5e7dc", "thumbnail_srcset": "https://si.imgix.net/0548a28e/uploads/origins/7dae48ce-372a-4552-bd9b-6eb65c8eb4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592bc81e2599cfa0b18c133e62a5e7dc, https://si.imgix.net/0548a28e/uploads/origins/7dae48ce-372a-4552-bd9b-6eb65c8eb4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc9fa52e13c6e184b54ceafce4794984 2x, https://si.imgix.net/0548a28e/uploads/origins/7dae48ce-372a-4552-bd9b-6eb65c8eb4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2d8a3f1f0efbea8899371b7368afbe3 3x", "genre": "art", "nsfw": true, "body": "お世話になります！いつも依頼受けていただきありがとうございます！\n前回と同じ私のキャラ2人で、\n今回のシチュエーションは精液プールをお願いします！\n・水深2mくらいある水の入っていないプールのど真ん中に2人が並んで立っている感じで、大量射精ショタくんたちが周りのプールサイドで囲っている。\n・射精量はえげつなく、ドロッドロ。プールをどんどん溜めていきついに満タンに。2人が見えなくなっても射精は止まらずプールサイドにも溢れ出す感じでお願いします！\n\nキャラ2人は前回以上に超乳ムチぽちゃになりふとももなども極太に。身長は2人とも190cmあるくらいでお願いします！\n\n毎度細かくなり申し訳ありませんが、是非よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/114", "thumbnail_src": "https://si.imgix.net/8681ac5e/uploads/origins/3e92d8a1-e9b1-4031-9746-2526ce151e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ede31b58d836ecd1d889a9c5ed0b60a", "thumbnail_srcset": "https://si.imgix.net/8681ac5e/uploads/origins/3e92d8a1-e9b1-4031-9746-2526ce151e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ede31b58d836ecd1d889a9c5ed0b60a, https://si.imgix.net/8681ac5e/uploads/origins/3e92d8a1-e9b1-4031-9746-2526ce151e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d53ffc041b71a46174a2c3f15614f5a2 2x, https://si.imgix.net/8681ac5e/uploads/origins/3e92d8a1-e9b1-4031-9746-2526ce151e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=452dcc3c2195c01af190e5fe66bce667 3x", "genre": "art", "nsfw": true, "body": "前回の原点である、私の大好きなキャラクター「ポイ」のイラストをお願いします。\n\n相変わらずの服装と大きな胸ですが、今回はミルク泥棒の衣装を着ています。\n\n今回はポイに提督に胸をこねくり回されたり、吸われたりさせてみたい。\n\nよろしくお願いします。\n\n参考画像はこちら：https://imgur.com/a/xa3VKxz", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/113", "thumbnail_src": "https://si.imgix.net/bcfe74cf/uploads/origins/c5df482f-5e4f-4a8c-bac6-dca41485d615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=150abae4d045a43d8bf3492f935a0a83", "thumbnail_srcset": "https://si.imgix.net/bcfe74cf/uploads/origins/c5df482f-5e4f-4a8c-bac6-dca41485d615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=150abae4d045a43d8bf3492f935a0a83, https://si.imgix.net/bcfe74cf/uploads/origins/c5df482f-5e4f-4a8c-bac6-dca41485d615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b18629bcf5be567a8d145944c2f61a1 2x, https://si.imgix.net/bcfe74cf/uploads/origins/c5df482f-5e4f-4a8c-bac6-dca41485d615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee58594c86ba3bfdab35156c9edd1a55 3x", "genre": "art", "nsfw": false, "body": "モンスターバースシリーズのゴジラの敵にあたるオリジナル怪獣のデザインをお願いします\n\n名前: タイタヌス　キルケ\nデザイン: 本質的には不定形生物だが、形態としては一般的な怪獣に近い（コスモリキッドのような感じ）\n設定: 以前スキュラを凶暴化させ、環境を破壊させるように仕向けた黒幕という設定（公式にもスキュラの脳の異常が疑われていた）\n怪獣的な姿に反し高い知能を有し、その性質は狡猾かつ極めて邪悪。自身から出す毒液には人間や怪獣を凶暴化させる特性があり、毒に侵された人間の姿はまるで獣のように成り果てる。生きた毒薬ともゆうべき生態系に多大な悪影響をもたらす怪獣だが、自身は液状化して姿を隠す為発見は容易でない。\n戦闘: 他怪獣と戦う必要が出れば、前述の毒液で攻撃するがゴジラ等の上級の怪獣には無効。その為液状化する身体を使っての神出鬼没な戦法を行うが、切り札として絶大な破壊力を有する、虹色の超高熱の泡状光線を放出する。\n余談:モチーフはギリシャ神話の魔女キルケ、及びゲゾラやガニメ等に寄生した宇宙生物。またクトゥルフモチーフのスキュラに合わせ、ヨグ=ソトースのイメージ（虹色の泡）もお願いします", "created_at": "", "completed_at": ""}, {"path": "/@garcia1053/works/112", "thumbnail_src": "https://si.imgix.net/56d7d8f1/uploads/origins/e74c4e07-fea0-497a-b1b9-4701e8493c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c58b9583181d287e4f8b4b09bff4bf97", "thumbnail_srcset": "https://si.imgix.net/56d7d8f1/uploads/origins/e74c4e07-fea0-497a-b1b9-4701e8493c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c58b9583181d287e4f8b4b09bff4bf97, https://si.imgix.net/56d7d8f1/uploads/origins/e74c4e07-fea0-497a-b1b9-4701e8493c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bo