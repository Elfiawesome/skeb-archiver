=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6202dbb29f5dcb4eddee329250e2743c", "thumbnail_srcset": "https://si.imgix.net/82f114f2/uploads/origins/9275d031-6e3d-45b4-9773-2fbafd17b1da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6202dbb29f5dcb4eddee329250e2743c, https://si.imgix.net/82f114f2/uploads/origins/9275d031-6e3d-45b4-9773-2fbafd17b1da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bdec15c4a72830ed115ab4869571bf8 2x, https://si.imgix.net/82f114f2/uploads/origins/9275d031-6e3d-45b4-9773-2fbafd17b1da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a290a95dab0e261b093ab62eef8eebe6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/54", "thumbnail_src": "https://si.imgix.net/7910ffdc/uploads/origins/e0f8f794-3ecb-4bb8-9751-9be656564e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19b1ce5318de8c33533258f573441fc7", "thumbnail_srcset": "https://si.imgix.net/7910ffdc/uploads/origins/e0f8f794-3ecb-4bb8-9751-9be656564e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19b1ce5318de8c33533258f573441fc7, https://si.imgix.net/7910ffdc/uploads/origins/e0f8f794-3ecb-4bb8-9751-9be656564e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07b167f172624da8c1b26193fc84b6fa 2x, https://si.imgix.net/7910ffdc/uploads/origins/e0f8f794-3ecb-4bb8-9751-9be656564e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb1e6e6ef21b3960af4e27a13ff1f189 3x", "genre": "art", "nsfw": true, "body": "こんにちは！またお会いできましたね。\n今回も僕のサメを描いてほしい。サメのリファレンスはこちらです：\nhttps://drive.google.com/drive/folders/1zPKKWLplcQ39oSGbCKAfETdT0s8oQYw_?usp=drive_link\n服装の参考はこちらです：\nhttps://drive.google.com/drive/folders/11Gw5KX40_nY5hFcHEkPnpU_AbpXgnjpJ?usp=drive_link\n理想的な描画範囲は膝上。できればNSFWバージョンもお願いします。また、モザイクの種類は「黒線モザイク」を希望します！\n全てお任せします！自由に描いてください！\nお読みいただきありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/53", "thumbnail_src": "https://si.imgix.net/06fdbd47/uploads/origins/e00b4bc6-ef18-4bbe-a4dc-4fb75d96914d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4df46ccddd9333d10c8e964e027cef3", "thumbnail_srcset": "https://si.imgix.net/06fdbd47/uploads/origins/e00b4bc6-ef18-4bbe-a4dc-4fb75d96914d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4df46ccddd9333d10c8e964e027cef3, https://si.imgix.net/06fdbd47/uploads/origins/e00b4bc6-ef18-4bbe-a4dc-4fb75d96914d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec838c7fc7a751b33ccead1182e6d852 2x, https://si.imgix.net/06fdbd47/uploads/origins/e00b4bc6-ef18-4bbe-a4dc-4fb75d96914d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c70f4148903cc9ee4775000f1e8e74f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私の地味な羊のキャラクターを描いて楽しんでもらえたら嬉しいです！\n\n私は本当に龍の脈のアナザーエイドスが大好きで、そのためにOCを作ることにしました。ちょっとやりすぎたので、20代の若いバージョンもあります（通常バージョンは40代）。\n\n彼はオブシドニアの貴族で、一族の最後の一人なんだ。荘園が焼失して以来、彼は森の中でひっそりと一人で暮らしている。彼らの町は死の森に一番近いので、彼はモンスターから人々を守ろうと頑張っている。\n\n彼が夜な夜な人々に目撃されるようになったため、巨大な羊が錆びた斧を持って走り回るという都市伝説が地域中に広まり、その対処のために冒険者たちが派遣されるようになった。彼は結局、彼を見つけたパーティに加わることになった。\n\nあとは君に任せるよ。\n\nhttps://drive.google.com/drive/folders/1ls2zeF_hFR4OdI6FO-M9Nd41jMi94KE5?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/52", "thumbnail_src": "https://si.imgix.net/1326fbd2/uploads/origins/8b0cb67a-e748-44d5-9451-79a6daf6be14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e226568c2d9cfd2346785398d4560b", "thumbnail_srcset": "https://si.imgix.net/1326fbd2/uploads/origins/8b0cb67a-e748-44d5-9451-79a6daf6be14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e226568c2d9cfd2346785398d4560b, https://si.imgix.net/1326fbd2/uploads/origins/8b0cb67a-e748-44d5-9451-79a6daf6be14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ed5de3a8d855baba1ca6864c61320aa 2x, https://si.imgix.net/1326fbd2/uploads/origins/8b0cb67a-e748-44d5-9451-79a6daf6be14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5ea29e88c606cce83de0e6e56ffec68 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターを描いていただけませんか？茶目っ気というか、からかうような表情が欲しいんだ。ポーズや服装はお任せします。参考までにドライブフォルダに服装の例も載せておきます。どんなのが出てくるか見てみたい！\n\n参考フォルダ：https://drive.google.com/drive/folders/1aTK9WkklJHd5A0XWRdIIWRkDYD2qO01k?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/51", "thumbnail_src": "https://si.imgix.net/c4ca5d6d/uploads/origins/3ae5b67b-40fe-4bde-ac11-66b2c3a72e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddc7322d672a3fa998da92091c911225", "thumbnail_srcset": "https://si.imgix.net/c4ca5d6d/uploads/origins/3ae5b67b-40fe-4bde-ac11-66b2c3a72e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddc7322d672a3fa998da92091c911225, https://si.imgix.net/c4ca5d6d/uploads/origins/3ae5b67b-40fe-4bde-ac11-66b2c3a72e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=943dbd4864d9d457783ac5f508ce080f 2x, https://si.imgix.net/c4ca5d6d/uploads/origins/3ae5b67b-40fe-4bde-ac11-66b2c3a72e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6331a2bf1fc2cb48705355f40eec2be1 3x", "genre": "art", "nsfw": false, "body": "『サイレントヒルf』という作品を\n実況プレイするので、その配信で使うサムネを\n描いていただきたいです！\n\n鉄パイプを持って怖がってる\n夏目透楽をお願いします！\n\nいつもありがとうございます\nこれからもよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/50", "thumbnail_src": "https://si.imgix.net/4ef45cf2/uploads/origins/7d8fec6e-a258-440a-8d78-fa8b26a346d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03cdc299e6b61d4c17664a8f492ddaf3", "thumbnail_srcset": "https://si.imgix.net/4ef45cf2/uploads/origins/7d8fec6e-a258-440a-8d78-fa8b26a346d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03cdc299e6b61d4c17664a8f492ddaf3, https://si.imgix.net/4ef45cf2/uploads/origins/7d8fec6e-a258-440a-8d78-fa8b26a346d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bc80e21854cf0d891dc891b93f18903 2x, https://si.imgix.net/4ef45cf2/uploads/origins/7d8fec6e-a258-440a-8d78-fa8b26a346d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f3df8db7f0ee61123a31ad6dd131875 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたがネコのキャラクターを描く方法が大好きです！\n特別なお願いがあるのですが、あなたの描くスケッチが特に好きなので、理解の助けになるように、今までのスケッチの例をいくつか挙げてください：\nhttps://x.com/izm_rm7/status/1905149882413007009/photo/1\nhttps://x.com/izm_rm7/status/1684189397946871809/photo/1\n\n私のOCのポーズをスケッチしてほしいです：\nhttps://drive.google.com/drive/folders/1jbcEHfCj2yTtXBcPYA3mXNr24WxKU51g?usp=sharing\n私のOCは筋肉質のライオンで、金色の目、金色の舌、角（好きなように描いてください）、爬虫類の骨の尾、金色の模様、額に黒い十字架があります。彼はまた、暗いトーンの手を持っています。\n\nポーズやシチュエーションはお任せします（服装も自由です）。できれば、少なくとも半身は欲しいです :D", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/49", "thumbnail_src": "https://si.imgix.net/b9ddf483/uploads/origins/7cfc03a5-213f-4b70-bb34-feabe40be25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b9e29955fd619ee3b848e919e59f30", "thumbnail_srcset": "https://si.imgix.net/b9ddf483/uploads/origins/7cfc03a5-213f-4b70-bb34-feabe40be25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b9e29955fd619ee3b848e919e59f30, https://si.imgix.net/b9ddf483/uploads/origins/7cfc03a5-213f-4b70-bb34-feabe40be25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d8c8682380c744ef1b0f9b98bc41529 2x, https://si.imgix.net/b9ddf483/uploads/origins/7cfc03a5-213f-4b70-bb34-feabe40be25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9602fa16f1b2da1e74e0b22c596dd6ac 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n私のオリジナルキャラクター(https://drive.google.com/file/d/17b7RIk02Tx7sSrB0_qjj8TbxvRy23Arm/view?usp=drive_link)と東京アフタースクールサマナーズの「マーナガルム」のアートワークが欲しいです。(https://cdn.housamo.xyz/housamo/unity/Android/fg/fg_managarmr01.png )\n\n私のキャラクターはこの服を着てほしいです：(https://drive.google.com/file/d/1ncTuuru3syh347zwVGc72oGc4m0MpmiA/view?usp=drive_link)。(https://drive.google.com/file/d/1rpaeqdvPcGkEb53gtpOLdn-BXWWOy6Os/view?usp=drive_link)(https://drive.google.com/file/d/1Ncth7zoYQwb2ftpVg26B49DXFrcSNyDU/view?usp=drive_link)。\n\nシナリオは、私のオリジナルキャラクターとマーナガルムが、冬の夜の街並みを歩きながら、デートを楽しんでいるような作品を希望します。雪が舞っていてもいいし、霜が降りていてもいい。\n\n- 私のキャラクターとマーガナムの身長は177cmです。", "created_at": "", "completed_at": ""}, {"path": "/@izm_rm7/works/48", "thumbnail_src": "https://si.imgix.net/5e709d28/uploads/origins/1ed18a9f-5f0b-4538-881f-3eda361ee9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88723a90203d3a80e2b3297182c8ffdc", "thumbnail_srcset": "https://si.imgix.net/5e709d28/uploads/origins/1ed18a9f-5f0b-4538-881f-3eda361ee9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88723a90203d3a80e2b3297182c8ffdc, https://si.imgix.net/5e709d28/uploads/origins/1ed18a9f-5f0b-4538-881f-3eda361ee9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67f7ede6e97e04ec41c3d8ba31170cc8 2x, https://si.imgix.net/5e709d28/uploads/origins/1ed18a9f-5f0b-4538-881f-3eda361ee9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f6214a5a12a4bb2ce75b4e6e7de92f7 3x", "genre": "art", "nsfw": false, "body": "東京放課後サモナーズのトゥーアルシェン(水着姿)のイラストをお願いしたいです。\n\n構図等はお任せしますので可能であればよろしくお願いします。\n\nhttps://cdn.wikiwiki.jp/to/w/housamo/%E3%83%88%E3%82%A5%E3%83%BC%E3%82%A2%E3%83%AB%E3%82%B7%E3%8