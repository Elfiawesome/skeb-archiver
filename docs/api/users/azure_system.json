=30&txt=PRIVATE&s=431c581f60ddff7f358297a2e2233f50, https://si.imgix.net/f2faab6c/uploads/origins/93f060ac-78ed-45a1-a6a2-159f215f8207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6861246ef5b83123a411482b9ab82e27 2x, https://si.imgix.net/f2faab6c/uploads/origins/93f060ac-78ed-45a1-a6a2-159f215f8207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e962634e8134056b446912e9b3c0399 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/31", "thumbnail_src": "https://si.imgix.net/8398cf47/uploads/origins/9a0685fe-6655-4f29-be06-2a3308c83fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f48c59cc75140e5ca08a2b05fb42f7b", "thumbnail_srcset": "https://si.imgix.net/8398cf47/uploads/origins/9a0685fe-6655-4f29-be06-2a3308c83fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f48c59cc75140e5ca08a2b05fb42f7b, https://si.imgix.net/8398cf47/uploads/origins/9a0685fe-6655-4f29-be06-2a3308c83fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48f92685a523a212cae7e98adda6076a 2x, https://si.imgix.net/8398cf47/uploads/origins/9a0685fe-6655-4f29-be06-2a3308c83fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0114bafff77c7c11abad513bed77335 3x", "genre": "art", "nsfw": false, "body": "ペガサスナイト姉妹を描いてくださって有難うございました。\n\n今回は、「ファイアーエムブレム　蒼炎の軌跡」で登場するサナキ様を描いてください。\nサナキ様は「...のじゃ」を言う、若い皇帝です。\nよろしくお願いします。\n\nhttps://imgur.com/GZGZ0Qa", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/30", "thumbnail_src": "https://si.imgix.net/c0bed88f/uploads/origins/cc53b4c1-9a3a-4a34-9dbf-379c001e9475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76de66a1f99bc6d52eb600e2ec107821", "thumbnail_srcset": "https://si.imgix.net/c0bed88f/uploads/origins/cc53b4c1-9a3a-4a34-9dbf-379c001e9475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76de66a1f99bc6d52eb600e2ec107821, https://si.imgix.net/c0bed88f/uploads/origins/cc53b4c1-9a3a-4a34-9dbf-379c001e9475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69fe0bc6093b005c1608031009d65ebc 2x, https://si.imgix.net/c0bed88f/uploads/origins/cc53b4c1-9a3a-4a34-9dbf-379c001e9475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9fb6cbc95db04b435e351a9159bf1ed 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/29", "thumbnail_src": "https://si.imgix.net/f523908e/uploads/origins/bddbb4b8-c938-4537-98b3-53b940d9c98f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a472dbb4894cfba21c63dd0f2c2144a9", "thumbnail_srcset": "https://si.imgix.net/f523908e/uploads/origins/bddbb4b8-c938-4537-98b3-53b940d9c98f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a472dbb4894cfba21c63dd0f2c2144a9, https://si.imgix.net/f523908e/uploads/origins/bddbb4b8-c938-4537-98b3-53b940d9c98f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bc73800f7ec34e774249e04abf13580 2x, https://si.imgix.net/f523908e/uploads/origins/bddbb4b8-c938-4537-98b3-53b940d9c98f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438d6a61eaa2b00c2ac22a95a6cda920 3x", "genre": "art", "nsfw": false, "body": "私の（かつての）セイジ、ガーマイス／グスタフ・ワイズバーグのアートを依頼したい。かつての面影はない......今はただ疲れた、引きこもりの世捨て人だ。\n\n\n経歴かつてはデルサッツ大賢者として知られていたが、今はかつての面影はない。老後は隠遁生活を送り、かつては偉大だった魔法の力も長年の不使用で衰えてしまった。不機嫌で憤慨しているが、平静を装い、口数は少ない。その沈黙の底には深い恨みがある。自分の人生をむしばんだモンスターと、そのモンスターが野放しにされることを許した王国の失敗に対する恨みである。\n\nhttps://imgchest.com/p/6eyrmq2lg4p", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/28", "thumbnail_src": "https://si.imgix.net/272e3149/uploads/origins/ccd50f0f-6283-4c16-8014-87508c35a321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c53801557a2c03791634fce91c9d2ed6", "thumbnail_srcset": "https://si.imgix.net/272e3149/uploads/origins/ccd50f0f-6283-4c16-8014-87508c35a321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c53801557a2c03791634fce91c9d2ed6, https://si.imgix.net/272e3149/uploads/origins/ccd50f0f-6283-4c16-8014-87508c35a321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a0af8ae780d5f7fa35ffc799947cb2e 2x, https://si.imgix.net/272e3149/uploads/origins/ccd50f0f-6283-4c16-8014-87508c35a321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfba04e1db07a0d252382483d030fc58 3x", "genre": "art", "nsfw": false, "body": "シャニーを描いてありがとうございます。シャニーは三姉妹の一人です。\n\n今回は、お姉さんのティト (Thea/Thite) を描いてほしいです。\nhttps://imgur.com/OLQ4qd3\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/27", "thumbnail_src": "https://si.imgix.net/d7d47a75/uploads/origins/56441043-6fc3-427f-849b-55913aaccfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36a643618ad3da0aa07ad420df6389e", "thumbnail_srcset": "https://si.imgix.net/d7d47a75/uploads/origins/56441043-6fc3-427f-849b-55913aaccfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36a643618ad3da0aa07ad420df6389e, https://si.imgix.net/d7d47a75/uploads/origins/56441043-6fc3-427f-849b-55913aaccfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=403ebbb1da3b634323894b5246e0b5f2 2x, https://si.imgix.net/d7d47a75/uploads/origins/56441043-6fc3-427f-849b-55913aaccfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67f90bef85467dfe9689e605495bb67b 3x", "genre": "art", "nsfw": false, "body": "マーシャの絵がいいと思って、他のペガサスナイトも見たいです。マーシャのように可愛ければ嬉しいです。\n\nシャニーという天馬騎士（ペガサスナイト）を描いてくださいますか。\nまたはシャニーじゃなくて、お姉さんのティトを代わりに描いてもいいです。短いスカートが好きです。\n\nhttps://i.imgur.com/06N58Hm.jpeg\n資料としてこの絵が役立つかもしれません。\n\nちなみにこのマーシャはFE9の若いマーシャです。ゲームによって衣装が違います。好きな衣装のシャニーを描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/26", "thumbnail_src": "https://si.imgix.net/8b3fd21d/uploads/origins/e04da545-91a5-4f43-9bcf-074eb4636da7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be0c7ac04b6258dfe56961f5e8a82a03", "thumbnail_srcset": "https://si.imgix.net/8b3fd21d/uploads/origins/e04da545-91a5-4f43-9bcf-074eb4636da7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be0c7ac04b6258dfe56961f5e8a82a03, https://si.imgix.net/8b3fd21d/uploads/origins/e04da545-91a5-4f43-9bcf-074eb4636da7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55a8b8f1d31a8823c6b35df9525df2c6 2x, https://si.imgix.net/8b3fd21d/uploads/origins/e04da545-91a5-4f43-9bcf-074eb4636da7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36272680d16f599b35a92f138a91751b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/25", "thumbnail_src": "https://si.imgix.net/ab32ed5c/uploads/origins/48f1a1d0-185c-48b7-8d1b-80857e627133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13ea4d21fa9bb9490d42159a8a39db1c", "thumbnail_srcset": "https://si.imgix.net/ab32ed5c/uploads/origins/48f1a1d0-185c-48b7-8d1b-80857e627133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13ea4d21fa9bb9490d42159a8a39db1c, https://si.imgix.net/ab32ed5c/uploads/origins/48f1a1d0-185c-48b7-8d1b-80857e627133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8873c177fff70443b1db3bd367845ca3 2x, https://si.imgix.net/ab32ed5c/uploads/origins/48f1a1d0-185c-48b7-8d1b-80857e627133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e649818872408bf90e34b5b8432d77db 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのファイアーエムブレム風のアートが大好きです！私のファブラウルティマのキャラクター、グリフィン乗りのイシャーンと彼の信頼するグリフィンのイグナシオの「キャラクター略歴」風のアートを依頼したいのです。これはイグナシオの神々しく進化した姿を、キャンペーン間近に見せるためのものだ。彼はもう鎧を着ていない。\n\nNEW - イグナシオの進化した神々しい姿は、その神秘的で神々しい姿のために、ダレンリンの表現からモデル化され、影響を受けている。https://www.deviantart.com/darenrin/art/gryphon-680747453\n\nイシャーンとイグナシオのギャラリー: https://imgchest.com/p/dl7pk8zvjyo?grid (イグナシオの進化前)\n\nhttps://imgchest.com/p/dl7pk8zvjyo?grid", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/24", "thumbnail_src": "https://si.imgix.net/b851c846/uploads/origins/585fed1a-a568-42b7-8ded-2bd5c5b3ee17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a8d4226db1042e34caafb3888475b02", "thumbnail_srcset": "https://si.imgix.net/b851c846/uploads/origins/585fed1a-a568-42b7-8ded-2bd5c5b3ee17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a8d4226db1042e34caafb3888475b02, https://si.imgix.net/b851c846/uploads/origins/585fed1a-a568-42b7-8ded-2bd5c5b3ee17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1965c803ee1fc39ee1495718b6535ce8 2x, https://si.imgix.net/b851c846/uploads/origins/585fed1a-a568-42b7-8ded-2bd5c5b3ee17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=832b65d1858226bf5ac23298080ad5ee 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアートをとても楽しんだので、お願いがあります！\n\nキャラクターファイアーエムブレム覚醒のモーガン（参考画像左）。  \n\n衣装：モーガンにルキナの聖なる女王の衣装（参考画像右）を着せてください。  \n\n表情・ポーズ・背景アクションポーズかキュートなポーズを希望します。あとは自由に決めたいと思います。自分がやりやすいものでお願いします。  \n\n重要な情報です：\n- モーガンはルキナ（参考画像右の女性）と同じ青い色の髪と目をしていること。  \n- 参考画像の剣と盾も入れてほしい。できれば、盾の後ろに体があまり隠れないようにお願いします。  \n\n参考画像やインスピレーションについては、私が依頼した過去の例をご覧ください：\nhttps://drive.google.com/drive/u/1/folders/15vlgpWHqhG_XyIYrZw4_dPvMcCHr6Q8s\n\nありがとうございました。\n\nhttps://imgur.com/a/TSAs1uR", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/23", "thumbnail_src": "https://si.imgix.net/007a67f9/uploads/origins/ca52c764-9b08-4742-b603-171d5648453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba01d0225123829fad54e20ce8319e0", "thumbnail_srcset": "https://si.imgix.net/007a67f9/uploads/origins/ca52c764-9b08-4742-b603-171d5648453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba01d0225123829fad54e20ce8319e0, https://si.imgix.net/007a67f9/uploads/origins/ca52c764-9b08-4742-b603-171d5648453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a349db9a32b65c5d5a0d1b069d69790a 2x, https://si.imgix.net/007a67f9/uploads/origins/ca52c764-9b08-4742-b603-171d5648453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e40e627a9bb0f8aac1f568f4ea065d6c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして🙂 最近のファイアーエムブレムのアートワークがとても好きです！\n\nもしよろしければ、ファイアーエムブレムのマーシャを描いていただけませんか？特に『ファイアーエムブレム:ラジアントドーン』からの彼女の姿をね：\n\nhttps://cdn.fireemblemwiki.org/thumb/5/53/FERD_Marcia.png/800px-FERD_Marcia.png\n\nhttps://fireemblem.fandom.com/wiki/Marcia\n\n声が大きく、気立てがよく、ちょっと浮気性！\n\n詳細はあなたの専門知識にお任せしますが、もし彼女が指ハートをしていたら、それはありがたいです！\n\n❤️\n\nhttps://i.etsystatic.com/31885922/r/il/aaa90b/3382038909/il_570xN.3382038909_a722.jpg", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/22", "thumbnail_src": "https://si.imgix.net/00dd7eaf/uploads/origins/c3dc4eb3-7e48-49b4-9375-e3dfb467da7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0dd7c6be41245e72e910f631f160f7", "thumbnail_srcset": "https://si.imgix.net/00dd7eaf/uploads/origins/c3dc4eb3-7e48-49b4-9375-e3dfb467da7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0dd7c6be41245e72e910f631f160f7, https://si.imgix.net/00dd7eaf/uploads/origins/c3dc4eb3-7e48-49b4-9375-e3dfb467da7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=439240217c4d2e6316a81995bb47ccc6 2x, https://si.imgix.net/00dd7eaf/uploads/origins/c3dc4eb3-7e48-49b4-9375-e3dfb467da7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1c2d9a3abcc89030ff0c6e9d1f0caa5 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you.\n\nI would like to request an illustration of Sanaki (Fire Emblem) being princess carried by Sigrun (Fire Emblem) after losing consciousness.\n\n・Composition\n- Please give Sanaki a peaceful sleeping expression. Do not use a happy or silly expression.\n- Please give Sigrun a caring motherly expression.\n- I included different poses to reference, please use a pose you are comfortable with.\n- No background is required\n\nThank you for reading my request.\n\nhttps://drive.google.com/drive/u/2/folders/17zrIXa_aBAYJmWW6UO9P8OkiWybbhGvy\n\nTranslated text(Japanese): はじめまして。\n\n意識を失ったサナキ（ファイアーエムブレム）がシグラン（ファイアーエムブレム）にお姫様だっこされているイラストをお願いしたいです。\n\n構成\n- サナキの安らかな寝顔をお願いします。嬉しそうな表情やおどけた表情はご遠慮ください。\n- シグランは、母親らしい優しい表情でお願いします。\n- 参考までにいろいろなポーズを用意しましたので、ご自分のやりやすいポーズでお願いします。\n- 背景は不要です。\n\nリクエストを読んでいただきありがとうございます。\n\nhttps://drive.google.com/drive/u/2/folders/17zrIXa_aBAYJmWW6UO9P8OkiWybbhGvy", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/21", "thumbnail_src": "https://si.imgix.net/23401e7e/uploads/origins/939ba31c-12fc-487b-90e5-b3c11b8ed123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79840008c65e210e5424475f442c28f8", "thumbnail_srcset": "https://si.imgix.net/23401e7e/uploads/origins/939ba31c-12fc-487b-90e5-b3c11b8ed123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79840008c65e210e5424475f442c28f8, https://si.imgix.net/23401e7e/uploads/origins/939ba31c-12fc-487b-90e5-b3c11b8ed123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b134f18e17d7b6fc30c8b7201788467 2x, https://si.imgix.net/23401e7e/uploads/origins/939ba31c-12fc-487b-90e5-b3c11b8ed123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d450f3b4994872ad2e29be7259a823b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Vtuber「柳カンナ」のファンです。カンナちゃんの絵をお願いしたいです。彼女はアヒルの探偵です。ゲームが大好きで、とても元気でハッピーです。\n\nポーズなどはお任せします。できれば、背景とは別にキャラクターのPNG版があると嬉しいです。\n\nカンナはこのアートを自身のSNSやYoutubeで使うかもしれません。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1fk4bBeJyniNsyoRNPsV54OOGJo-5-OtV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/20", "thumbnail_src": "https://si.imgix.net/f8023c80/uploads/origins/1a8d87ed-0769-4925-9d44-110d672a62bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d515dca3f5ed68d9360c4d0dbbdd9d1", "thumbnail_srcset": "https://si.imgix.net/f8023c80/uploads/origins/1a8d87ed-0769-4925-9d44-110d672a62bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d515dca3f5ed68d9360c4d0dbbdd9d1, https://si.imgix.net/f8023c80/uploads/origins/1a8d87ed-0769-4925-9d44-110d672a62bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=623da0a0deff98d05449326549286eb1 2x, https://si.imgix.net/f8023c80/uploads/origins/1a8d87ed-0769-4925-9d44-110d672a62bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f325e8e11885604538c913598d31ebf1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵は本当にかわいいと思います！\n東方Projectの加曾谷京子を描いてくれませんか？\n妙林寺（命蓮寺）の正門で楽しそうに歌いながら掃き掃除をしているところが見たいです。\nもし必要なら、背景の参考にどうぞ - https://www.pixiv.net/artworks/18253434\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/19", "thumbnail_src": "https://si.imgix.net/84d11c3d/uploads/origins/c686f6e6-acc4-49b9-b7a4-12ecf2193d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae3e14d7644f9eae286ef6858377940", "thumbnail_srcset": "https://si.imgix.net/84d11c3d/uploads/origins/c686f6e6-acc4-49b9-b7a4-12ecf2193d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae3e14d7644f9eae286ef6858377940, https://si.imgix.net/84d11c3d/uploads/origins/c686f6e6-acc4-49b9-b7a4-12ecf2193d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2645397d5e638514320880654c64cd0 2x, https://si.imgix.net/84d11c3d/uploads/origins/c686f6e6-acc4-49b9-b7a4-12ecf2193d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a18a2d33f9b1e20e8318d7cead3b4f8 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\nルカとルマで素晴らしい仕事をしてくれたので、同じように、カジュアルな服を着た姉のドーンを描きたいと思いました。ルカとルマより1歳年上です。ルカやルマより1歳年上で、状況によって子供っぽくなったり大人っぽくなったりします。好奇心旺盛で冒険好き、ファッションと新しい体験が大好き。\n\nアイドルとしての暁は朝がテーマで、アイドルカラーはピンク。山から昇る朝日をバックに、田園風景の中にいるドーンをイメージしました。\n\n他の2人と同じように、彼女に一番似合うと思う服装、髪型、ポーズを決めてください。猫耳としっぽは本物で、人間の耳はありません。カラーコンタクトレンズを装着しているので、服装に合わせて瞳の色も自由。他の女の子と同じように、インスピレーションの助けになるように、参考資料と衣装のアイデアをいくつか添付しました。彼女を描くのを楽しんでください。\n\nhttps://imgur.com/a/hUgPSQT", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/18", "thumbnail_src": "https://si.imgix.net/3c9eecf1/uploads/origins/9ff7fc42-d517-449d-a9d7-b9c0148e9cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b10fbe4f12c77b138536ddf697970d0", "thumbnail_srcset": "https://si.imgix.net/3c9eecf1/uploads/origins/9ff7fc42-d517-449d-a9d7-b9c0148e9cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b10fbe4f12c77b138536ddf697970d0, https://si.imgix.net/3c9eecf1/uploads/origins/9ff7fc42-d517-449d-a9d7-b9c0148e9cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e72cff3e71eca34dd6c22c1c2ec5d27a 2x, https://si.imgix.net/3c9eecf1/uploads/origins/9ff7fc42-d517-449d-a9d7-b9c0148e9cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98f15e38e6121c29e527d71fbcf206b4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nルカちゃんを描いてくれてありがとう！ルカちゃんの二卵性双生児の妹、ルマちゃんの私服姿も興味深かったです。ルマちゃんも猫娘のアイドルです。彼女はもっと真面目で、甘やかされたお姫様のように振る舞い、他人を見下すような態度をとる。人にどう思われようと気にしないように振る舞っているが、内心では褒められたい、注目されたいと思っている。いつもベストな服装を心がけている。\n\nルマのアイドルの衣装は、夕方から夜にかけてがテーマです。ルマには、夕暮れ時の桟橋や遊園地をイメージしました。ルマの主なアイドルカラーはオレンジですが、カジュアルな場面ではどんな色でも着こなせます。ルカと同様、ルマの猫耳と尻尾は本物で、人間の耳はない。\n\n服装や髪型は自由で、ポーズや表情も自由です。インスピレーションの助けになるように、ルマの参考写真と服装のアイデアを添付しました。このアイデアを楽しんでください。\n\nhttps://imgur.com/a/FCt0rcf", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/17", "thumbnail_src": "https://si.imgix.net/43d8d4eb/uploads/origins/e363d089-1abb-4c41-8d18-d2ef3e08d4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f45db6588e46f565e69c3f694e95cd", "thumbnail_srcset": "https://si.imgix.net/43d8d4eb/uploads/origins/e363d089-1abb-4c41-8d18-d2ef3e08d4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f45db6588e46f565e69c3f694e95cd, https://si.imgix.net/43d8d4eb/uploads/origins/e363d089-1abb-4c41-8d18-d2ef3e08d4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a01df8308c417686e3c87ab7c71cf4f 2x, https://si.imgix.net/43d8d4eb/uploads/origins/e363d089-1abb-4c41-8d18-d2ef3e08d4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6360e034de96a892eb8ea717e8bf3e61 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私の猫娘アイドルキャラクター、るかのアートワークを依頼したいと思っていました。彼女は3人姉妹の末っ子。やんちゃで子供っぽい性格で、トラブルから逃れるためにかわいい顔をすることを知っています。実年齢よりも幼く見える傾向がある。\n\n瑠可とその姉妹は、1日の3つの時間をテーマにしたアイドルだ。瑠可は夜を象徴しているので、カジュアルな服装で都会的な夜の写真を依頼したかった。瑠香のアイドル・カラーは青ですが、カジュアルな服装なら何色でも着こなせます。猫耳と尻尾は本物で、人間の耳はない。\n\n服装や髪型は自由で、ポーズや表情も自由です。インスピレーションを得るために、瑠可の参考写真と服装のアイデアを添付しました。このアイデアを楽しんでほしい。\n\nhttps://imgur.com/a/Pgkt7x6", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/16", "thumbnail_src": "https://si.imgix.net/bc7c55c1/uploads/origins/ba9cbaa8-b35a-42ca-80e3-a2325dcde9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f78ea308a31b8fb59e768e89a0455903", "thumbnail_srcset": "https://si.imgix.net/bc7c55c1/uploads/origins/ba9cbaa8-b35a-42ca-80e3-a2325dcde9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f78ea308a31b8fb59e768e89a0455903, https://si.imgix.net/bc7c55c1/uploads/origins/ba9cbaa8-b35a-42ca-80e3-a2325dcde9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1873967ca7d4a494fe2b9ef3e24f2fa 2x, https://si.imgix.net/bc7c55c1/uploads/origins/ba9cbaa8-b35a-42ca-80e3-a2325dcde9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36a46cd4d10d7e1afe161709f296df08 3x", "genre": "art", "nsfw": false, "body": "saさんの水彩画のような絵柄が素敵だと思いましたので依頼いたしました。\n元にじさんじインドネシアメンバーのZEA　CORNELIA（ゼア　コルネリア）の絵を描いていただきたいです。\n最初期の衣装で、ライブステージ上で歌いながら笑みを浮かべ、ツインテール（各テールがリボンのところで二手の分かれているので実際は４テールになると思います。）が動きに合わせてふわっと浮かんでいるようなイラストにしていただけると嬉しいです。\nまた、可能であれば、隅のほうにカーネル（ZEAの配信上でのリスナーの総称、小さい三角形のキャラクター。ZEAの『シス×ラブ』coverを見ていただけるとわかりやすいと思います。）を描いていただけると幸いです。\n\n利用の目的としては個人的な利用で、saさんに描いていただいた旨を記載したtwitterでの投稿、および自身のtwitterアカウントのヘッダーでの利用を考えています。\nお忙しい中だと思いますがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/15", "thumbnail_src": "https://si.imgix.net/2d1c53cb/uploads/origins/8cf5bb23-6b7c-4ab8-a01f-efc333e7a182?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca724137db386d9ef874701ba5758236", "thumbnail_srcset": "https://si.imgix.net/2d1c53cb/uploads/origins/8cf5bb23-6b7c-4ab8-a01f-efc333e7a182?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca724137db386d9ef874701ba5758236, https://si.imgix.net/2d1c53cb/uploads/origins/8cf5bb23-6b7c-4ab8-a01f-efc333e7a182?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ba740dba01bb64366f9fef0a88696c8 2x, https://si.imgix.net/2d1c53cb/uploads/origins/8cf5bb23-6b7c-4ab8-a01f-efc333e7a182?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b2fbfa05c8f34b6d38d65c31740f38 3x", "genre": "art", "nsfw": false, "body": "世界はもっと鍵山雛を必要としている\n東方プロジェクトのキャラクター、鍵山雛を描いてくれませんか？ありがとうございます！\n特に指定はありません。好きなようにデザインしてください。", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/14", "thumbnail_src": "https://si.imgix.net/1f750411/uploads/origins/ef551c1e-ecd7-4a46-a8f6-a2f5506a8d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c68cc7ab9a2c8e7e8e471e153bd60c1", "thumbnail_srcset": "https://si.imgix.net/1f750411/uploads/origins/ef551c1e-ecd7-4a46-a8f6-a2f5506a8d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c68cc7ab9a2c8e7e8e471e153bd60c1, https://si.imgix.net/1f750411/uploads/origins/ef551c1e-ecd7-4a46-a8f6-a2f5506a8d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e528a3cd8f25a8845cdff0763182ef25 2x, https://si.imgix.net/1f750411/uploads/origins/ef551c1e-ecd7-4a46-a8f6-a2f5506a8d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=954b53a9992d3ad4a3b0cdf3785b0854 3x", "genre": "art", "nsfw": false, "body": "こんにちわ！お元気でお過ごしでしょうか。\n\nプロムドレス「オーキッドのイブニングドレス」（https://genshin-impact.fandom.com/wiki/Orchid%27s_Evening_Gown）を着た玄真インパクトに凝視をお願いしたいです。\n\n視聴者はテーブルの上にセットされ、彼女と向き合っています。 凝光は微笑みながら、翡翠の間（https://www.pinterest.com/pin/423338433731745995）のテーブルの前に座り、訪問者のために湯呑みにお茶を注いでいます。テーブルの上にはデザートもあります。可能であれば、彼女の顔と体の比率は上記の公式プロムドレスの設定のままにして、壁際の棒にかかったエメラルド色のフィンチを描いてください(https://genshin-impact.fandom.com/wiki/Emerald_Finch)。\n\nお忙しい中、どうもありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@azure_system/works/13", "thumbnail_src": "https://si.imgix.net/db097c34