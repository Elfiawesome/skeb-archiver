きなのです！！\nお手数でなければ、もう片方の肩にポッチャマがしがみついて、嫉妬したようなふくれっ面をしている様子も描いていただけませんか？ゲームを始めた時に最初に選んだポケモンなんです～SNSや配信で使いたいので、クレジットは必ず記載しますね^o^ 本当にありがとうございます、すごく楽しみです～参考画像： https://drive.google.com/file/d/10PjjArqAM8IMwdBN7ZZVB_OAJ8SqH09c/view?usp=sharingのろま～ https://drive.google.com/file/d/1viIAyQnkSR0GWqCn6V2j38yM8okwBXZR/view?usp=sharing ピプラップ～ https://drive.google.com/file/d/1ZPKMdKj585T0cg3M1jdEtddzva0fN-6_/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gopokenohito/works/208", "thumbnail_src": "https://si.imgix.net/05cb7ce3/uploads/origins/9b5e16e3-1f0d-4078-bbab-39697a0f6ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b339d36f83d08b53a8777459cc4f4d1f", "thumbnail_srcset": "https://si.imgix.net/05cb7ce3/uploads/origins/9b5e16e3-1f0d-4078-bbab-39697a0f6ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b339d36f83d08b53a8777459cc4f4d1f, https://si.imgix.net/05cb7ce3/uploads/origins/9b5e16e3-1f0d-4078-bbab-39697a0f6ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41dcad02ef96b06c5af21be43ddfce57 2x, https://si.imgix.net/05cb7ce3/uploads/origins/9b5e16e3-1f0d-4078-bbab-39697a0f6ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35b973dd139460a01f94a45e4c458b2c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gopokenohito/works/207", "thumbnail_src": "https://si.imgix.net/994acd90/uploads/origins/632d25d4-b26d-413a-8860-2a0d148bd69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c02fc5da8ca82945e12400