-9536-54a3e8ecb7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a55417d007ce1fabd809e8d15ba4e96, https://si.imgix.net/b73ee44c/uploads/origins/ab1e3dee-2620-495b-9536-54a3e8ecb7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9f195291d290a9b7d3bc67748b6a5b2 2x, https://si.imgix.net/b73ee44c/uploads/origins/ab1e3dee-2620-495b-9536-54a3e8ecb7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ede64d5064cf8607f0e2eedb60a88b4b 3x", "genre": "art", "nsfw": false, "body": "お寿司さんこんにちは!!!お元気ですか！？\nアストラの宇宙的でアイドル的なかわいいイラストをお願いしてもいいですか？  普段の衣装でも、お好きな新しい衣装でもOKです!\n本当にありがとうございます!\nよろしくお願いします。\nアストラ\n\nhttps://drive.google.com/drive/folders/1-1g-4xMv-O4wZ_iwfWYcUu68VIAoSHgp?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@osushichan6/works/18", "thumbnail_src": "https://si.imgix.net/e8ca1754/uploads/origins/53c8d4b0-5df7-409b-965f-989435c42808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5323406e0d8304b6e88ef5dd55fc418", "thumbnail_srcset": "https://si.imgix.net/e8ca1754/uploads/origins/53c8d4b0-5df7-409b-965f-989435c42808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5323406e0d8304b6e88ef5dd55fc418, https://si.imgix.net/e8ca1754/uploads/origins/53c8d4b0-5df7-409b-965f-989435c42808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=125930419b630831cc9aa1f19c3daf21 2x, https://si.imgix.net/e8ca1754/uploads/origins/53c8d4b0-5df7-409b-965f-989435c42808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c8297782dd56291df206e38200b7d6d 3x", "genre": "art", "nsfw": true, "body": "Hi Sushi～。\n\nあなたの作品が大好きです。\n私のパートナーと私のVTuberのアバターが一緒に写っている作品をお願いしたいです。  私たちは二人とも成熟した大人で、長年付き合っています。  私たちはとても遊び好きで、とてもおバカなところがあります。  私のパートナーは、公共の場では私よりも少し真面目で、愛情表現をすることはまずありません。  どちらかというと控えめでシャイな性格です。  私は声が大きく、騒々しいです。  \n\nできればPSDはサインを別レイヤーにして送ってください。\nできればポスターに使いたいと思っています。\n\nhttps://drive.google.com/drive/folders/1khNdVCXUfNyVYFjgL6zGvgZY39OT3MG4?usp=sharing", "created_at": "", "completed_at": ""}]}