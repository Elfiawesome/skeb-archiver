compress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df3f8af3b1f0b7ebceee338f939833bc", "thumbnail_srcset": "https://si.imgix.net/c22cd8d5/uploads/origins/401e4750-13a8-4baa-b5f1-51283499fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df3f8af3b1f0b7ebceee338f939833bc, https://si.imgix.net/c22cd8d5/uploads/origins/401e4750-13a8-4baa-b5f1-51283499fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfff37f57ca4f9fee7f4bf1f49fa95dc 2x, https://si.imgix.net/c22cd8d5/uploads/origins/401e4750-13a8-4baa-b5f1-51283499fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=465ffbbc1d1e04d9436ec30d8627dac9 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@W5r5X/works/86", "thumbnail_src": "https://si.imgix.net/fc61ca5d/uploads/origins/ba6750c0-deee-4183-bed5-c6df9773eff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1300d79ae598949734dc6cd1835d7649", "thumbnail_srcset": "https://si.imgix.net/fc61ca5d/uploads/origins/ba6750c0-deee-4183-bed5-c6df9773eff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1300d79ae598949734dc6cd1835d7649, https://si.imgix.net/fc61ca5d/uploads/origins/ba6750c0-deee-4183-bed5-c6df9773eff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f834e3f126dc59b41a7949aef743c6e8 2x, https://si.imgix.net/fc61ca5d/uploads/origins/ba6750c0-deee-4183-bed5-c6df9773eff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1105d68970f9088920add56bd4d8fc4a 3x", "genre": "art", "nsfw": false, "body": "助手さん、はじめまして、こんにちは！私はあなたの作品には独特なセンスと感情表现が好きでした！\n\n私のオリジナルキャラクターのイラストをお願いしたいです。これら2人のキャラクターはそれぞれバレンタインとヨアキムという名前です。以下は大まかなキャラクター紹介とプロットの概要です。\n\nバレンタイン：バユゥー（架空の国）の飛行士、軍人。性格は非常に優しく穏やかで、従順なイメージ。バユゥーの地元出身ではなく、信仰と国土の衝突がある近くの荒廃した村で生まれた。幼少期に崖から落ち、崖の下で拜尤の軍人に発見され、自分の命を救ってくれた軍人に恩返しするため、その軍人の幼い息子の代わりに軍人として育てられ、国に奉仕するようになりました。自分の命はその軍人の家族に属すると考え、その忠誠心は信仰に近い。実際には崖からの落下は事故ではなく、自殺であり、具体的な理由は不明。この出来事は彼以外に誰も知らない。\n飛行隊の演習での墜落事故で唯一生き残った人として、一時的に政治的宣伝を受け、\"英雄\"のイメージが形成されて名声を得る。\n最終戦争で国家が滅びる中、敵国の陣営となった養父の軍人の実の息子、つまり彼が愛する弟に殺されたと言われています。\n\nヨアキム：バユゥーの軍医。非常に若く、バレンタインを憧れてから参軍しました。感情的で反抗的なイメージで、冷静な表情の下には強烈な情熱を秘めた性格です。家族は政治家でしたが、家族の意向に逆らい、一人で戦地医師として働くことを選びました。ある行動で瓦伦丁を治療する機会があり、彼の身に違和感を感じ始め、その後、彼に対する尊敬が続かなくなる。一緒に過ごすうちに距離が縮まり、理解できなくても、最終的には一人の人間を愛し、形象を愛するのではなく、その人を愛することを決意する。この出来事は彼以外には誰も知らない。\n右目が家族との衝突で負傷した事故である。\n終戦前夜に、一人で崖の上にいたバレンタインを見つけ、彼に付いて山を下りました。しかし、バレンタインはヨアキムの同行を拒否し、最後に彼を安全な場所に導いていました。ヨアキムは誰の死も目撃せず、国の崩壊時に利益階級に関連した唯一の生存者となりました。敵に自分を殺すように要求しましたが、「兄に恩義がある」という理由で拒否されました。現在も新しい国で軍医として働いています。\n\n補助的なコンテンツとして、彼らの国は全体的に東方正教に近い宗教的要素があります。他のポーズ、構図、要素については、特別な要求や制限はございませんので、お好みで自由に描いていいんだよ！\n\n（p.s. 実際には人外の設定で、人間の口がないのですが、時々コンテンツの必要性や表情の表現のために、提供される画像には人間の口があります。主な要素は青紫色の肌と白い模様、6つの目と長い耳です。ちなみに、彼らの血液は青色であり、そのためにまぶたや舌（もし口があれば）も青色です。お手数ですが、お好みで描いてください。）\n（p.p.s. バレンタインの目の色は鉛灰色、ヨアキムの目の色は黒色です。ヨアキムの右目は、物語の途中で起こる出来事であり、時間のずれがあるため、提供された画像には受傷後の淡い青色に描かれていないものもあります。お好みで表現してください。）\n\n突然多くの情報を伝えてしまい、申し訳ございません。本当にありがとうございます。もし私のリクエストを受け入れていただけるなら、私は大変嬉しいです！これからもあなたの作品が好きで、ずっと応援していきます！\n\nhttps://drive.google.com/drive/folders/1sDfRt7Tfi8nD5NPxytTGhzBqBhnTB3aY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@W5r5X/works/85", "thumbnail_src": "https://si.imgix.net/37dd21fd/uploads/origins/fa833b3d-7eb0-419a-ad7d-020cf5a29689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc70c2d86db51f61a267842356b9646", "thumbnail_srcset": "https://si.imgix.net/37dd21fd/uploads/origins/fa833b3d-7eb0-419a-ad7d-020cf5a29689?bg=%23fff&auto=format%