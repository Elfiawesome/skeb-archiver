%2Ccenter&txtsize=30&txt=PRIVATE&s=185b9d98cbf188c2795b13762308e595 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/26", "thumbnail_src": "https://si.imgix.net/6edceaf2/uploads/origins/1a737b78-a343-4b5e-ac3c-06f9fb377b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2e463d72472db019dc2f6cbddc58847", "thumbnail_srcset": "https://si.imgix.net/6edceaf2/uploads/origins/1a737b78-a343-4b5e-ac3c-06f9fb377b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2e463d72472db019dc2f6cbddc58847, https://si.imgix.net/6edceaf2/uploads/origins/1a737b78-a343-4b5e-ac3c-06f9fb377b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6d3b665c41ff529141663dc73bb153b 2x, https://si.imgix.net/6edceaf2/uploads/origins/1a737b78-a343-4b5e-ac3c-06f9fb377b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6a37ced68b9403d78b282610cf15fe0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/25", "thumbnail_src": "https://si.imgix.net/17199d67/uploads/origins/4eb554dc-38cf-41c2-afd8-dc8655309ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09f48ab5eb09b898db1826550047605e", "thumbnail_srcset": "https://si.imgix.net/17199d67/uploads/origins/4eb554dc-38cf-41c2-afd8-dc8655309ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09f48ab5eb09b898db1826550047605e, https://si.imgix.net/17199d67/uploads/origins/4eb554dc-38cf-41c2-afd8-dc8655309ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1acc465ef84f34f900b4071b916632e 2x, https://si.imgix.net/17199d67/uploads/origins/4eb554dc-38cf-41c2-afd8-dc8655309ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f350d0d1e6429cf5801d5036827e704 3x", "genre": "art", "nsfw": true, "body": "To 曜先生\n\nこんにちは！\nお世話になっております。NepuX です。\n\nまたまた杏奈ちゃんなのですが、ぜひよろしければご検討いただけるとありがたいです！\n\n◆ 概要 **********************\nキャラ：アイドルマスター ミリオンライブ！より 望月 杏奈\n衣装　：スクール水着\nサイズ：A4 - 4093 x 2894 px / 350dpi 程度\n用途　：観賞に (個人利用に限ります)\n形式　：PSD\n※ サイズはあくまで目安ですので、アス比など変更いただいて問題無いです！\n※ キャンパス向きは縦横どちらでも OK です！\n\n◆ キャラ ********************\n杏奈ちゃんを、スイッチ OFF の物静かな感じでお願いいたします。\n\n◆ 衣装 **********************\n前回に引き続きスク水を名前入りのゼッケン付きでお願いいたします！\n\n◆ シチュ / 背景 *************\n水着で動画の撮影と聞いた杏奈ちゃんが百合子さんに変な知識を教えられ、\nお股にワイヤレスのローターを仕込んで来てしまった...というシチュで\nお願いいたします。\n\n場所は撮影前の楽屋、プロデューサーに「普通の撮影だよ...」と教えられるも、\nP にローターのスイッチを握られしっかり楽屋でイかされちゃう杏奈ちゃんをぜひ！\n\n◆ 構図 / 表情 他 ************\n細かな構図などについては曜先生にお任せさせてください！\n※ せっかくなのでお股とローターが見える画角だとありがたいです\n\n◆ その他お願い **************\nもし可能でしたら時系列で差分をいただけるととてもありがたいです！\n※ イく前 -> イッたところ、など\n\nまた、前回と同じく、曜先生のサインや宛名など文字類を別レイヤーに\n記載いただけるとありがたいです！\n\n以上、今回もまたご検討だけでもいただければ幸いです！\nぜひぜひよろしくお願いいたしますね(*´∇`)ﾉｼ\n\nNepuX", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/24", "thumbnail_src": "https://si.imgix.net/5aa377de/uploads/origins/dd7f49f9-76b7-4a77-900d-7928f6f03637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4177c92055bc949e9496bd0534fe6d2d", "thumbnail_srcset": "https://si.imgix.net/5aa377de/uploads/origins/dd7f49f9-76b7-4a77-900d-7928f6f03637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4177c92055bc949e9496bd0534fe6d2d, https://si.imgix.net/5aa377de/uploads/origins/dd7f49f9-76b7-4a77-900d-7928f6f03637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92306f4b9cb14d865a6b4020ed4526dc 2x, https://si.imgix.net/5aa377de/uploads/origins/dd7f49f9-76b7-4a77-900d-7928f6f03637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=569caade6429fb40c74022535aa1070c 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。また改めて依頼の方させていただきます。\n「二階堂千鶴さんのメイド姿」\nをお願いします。背景などシチュエーションはお任せしますが、美しい立ち姿でお願いします。\n千鶴さん元来の可愛らしさに加えて頼もしさが感じられる作品になりますと殊更嬉しいです。\n肝心のスカート丈は長めを希望します。宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/23", "thumbnail_src": "https://si.imgix.net/960525c5/uploads/origins/2cdfce15-86fb-49b6-9298-2e6e0885191d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f75a5f6802b0e276c3729462b49622", "thumbnail_srcset": "https://si.imgix.net/960525c5/uploads/origins/2cdfce15-86fb-49b6-9298-2e6e0885191d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f75a5f6802b0e276c3729462b49622, https://si.imgix.net/960525c5/uploads/origins/2cdfce15-86fb-49b6-9298-2e6e0885191d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5097dc499c71425beb1492ec4f39ba4f 2x, https://si.imgix.net/960525c5/uploads/origins/2cdfce15-86fb-49b6-9298-2e6e0885191d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7415da49577798b0b07bc61ff679396d 3x", "genre": "art", "nsfw": false, "body": "ルーントリガー（北沢志保）をリクエストします。\nポーズは「アイドルファイト 島原エレナ」のようにカカト落としをするポーズで、表情は強気で照れはない感じでお願いします。\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/22", "thumbnail_src": "https://si.imgix.net/17c885b4/uploads/origins/fc7d975a-0e4f-4280-a45a-9b13470568e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c43c7b171ffdd9e593ae52593d791ecb", "thumbnail_srcset": "https://si.imgix.net/17c885b4/uploads/origins/fc7d975a-0e4f-4280-a45a-9b13470568e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c43c7b171ffdd9e593ae52593d791ecb, https://si.imgix.net/17c885b4/uploads/origins/fc7d975a-0e4f-4280-a45a-9b13470568e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a105b19b12aa082e0ee667475e69141e 2x, https://si.imgix.net/17c885b4/uploads/origins/fc7d975a-0e4f-4280-a45a-9b13470568e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa0ca624735a3203f297de27ac63d1ca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/21", "thumbnail_src": "https://si.imgix.net/0d7ba42b/uploads/origins/d774399a-a956-4598-8472-fc7ee5483673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b03e4d917a4d46b0a0535379b639b4", "thumbnail_srcset": "https://si.imgix.net/0d7ba42b/uploads/origins/d774399a-a956-4598-8472-fc7ee5483673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b03e4d917a4d46b0a0535379b639b4, https://si.imgix.net/0d7ba42b/uploads/origins/d774399a-a956-4598-8472-fc7ee5483673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3855dae2fc58fcc532e082e03777dd8 2x, https://si.imgix.net/0d7ba42b/uploads/origins/d774399a-a956-4598-8472-fc7ee5483673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=503913a629b09aeae2a92cb43d8d3a31 3x", "genre": "art", "nsfw": false, "body": "はじめまして。　別々の作品のキャラと衣装という組み合わせは大丈夫でしょうか？\n\nキャラクター：「八月のシンデレラナイン」の有原翼\n（https://hachinai.com/character/arihara）\n衣装：「ラブライブ！」シリーズの虹ヶ咲学園の制服\n具体的にはこちら（https://lovelive-sif2.bushimo.jp/member/nijigasaki/yu/）\n\nあとは、絵柄を「ラブライブ！」シリーズに寄せる事もできたら、と思います。", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/20", "thumbnail_src": "https://si.imgix.net/776c93a3/uploads/origins/d10a6a43-7ab7-4253-9eb7-6648f05e9de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536e7740274dc1625cfda4d06580bcb3", "thumbnail_srcset": "https://si.imgix.net/776c93a3/uploads/origins/d10a6a43-7ab7-4253-9eb7-6648f05e9de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536e7740274dc1625cfda4d06580bcb3, https://si.imgix.net/776c93a3/uploads/origins/d10a6a43-7ab7-4253-9eb7-6648f05e9de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7735196d2eef318eacda877a273cfc6 2x, https://si.imgix.net/776c93a3/uploads/origins/d10a6a43-7ab7-4253-9eb7-6648f05e9de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10af81e7915525fb0107ad1bf9ea3ac2 3x", "genre": "art", "nsfw": false, "body": "他作品のイラストを見て依頼させていただきます。麻雀物語のドロシー・ジェファーソンを描いていただけませんでしょうか。他イラストの様にキャラの良さを活かした綺麗でカッコいいポージングのイラストをお願いしたいです。(いつものポーズがあるキャラなので、このポージング、もしくはコレに近いポージングでお願いします。)\n\n普段は麻雀卓の前でこのポーズなのですが、麻雀卓は要らないので「ポーズ全身」にあるような石作りの建物が背景だと嬉しいです。また、彼女のモチーフは鎖なので、鎖を張り巡らしたような背景でもよいです。\n\n性格は狡猾で妖艶だが意外と真面目。ダークヒーローのように笑みを浮かべながらかっこ付けて欲しいです。\n\nジャンル違いで恐縮ですがよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/10JImaQ24NnMgJ_ciUCO-YkyaDnk96psJ", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/19", "thumbnail_src": "https://si.imgix.net/c21d9336/uploads/origins/036370ff-e06c-497a-8180-71591e016985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e0b5975e0b5d6db49f4686bd25526c", "thumbnail_srcset": "https://si.imgix.net/c21d9336/uploads/origins/036370ff-e06c-497a-8180-71591e016985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e0b5975e0b5d6db49f4686bd25526c, https://si.imgix.net/c21d9336/uploads/origins/036370ff-e06c-497a-8180-71591e016985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b07a7fb1cff8da196abaf24e88f80a7 2x, https://si.imgix.net/c21d9336/uploads/origins/036370ff-e06c-497a-8180-71591e016985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e54a08a486e764cd70f40f906732814d 3x", "genre": "art", "nsfw": false, "body": "スケブ募集と聞いて依頼をお願いします\nお願いしたいのはDMMゲームの\n【ミストトレインガールズ】に登場する（ハバロフスク）と\nいうキャラクターをお願いします\n\n希望は可能であればハバロフスクの指導者の雰囲気を出してもらいたいです\n全てお任せしたいと思います\n\n\n参考資料になるかわかりませんが\nhttps://misttraingirls.wikiru.jp/index.php?%E3%83%8F%E3%83%90%E3%83%AD%E3%83%95%E3%82%B9%E3%82%AF\n\n宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/18", "thumbnail_src": "https://si.imgix.net/d20696bc/uploads/origins/0c9c3b07-4576-48df-b771-d3102525ee87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96f32467dc1defd88f997dcadbabdcd3", "thumbnail_srcset": "https://si.imgix.net/d20696bc/uploads/origins/0c9c3b07-4576-48df-b771-d3102525ee87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96f32467dc1defd88f997dcadbabdcd3, https://si.imgix.net/d20696bc/uploads/origins/0c9c3b07-4576-48df-b771-d3102525ee87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b37b17db3c829e568cbbc7836e8f90a 2x, https://si.imgix.net/d20696bc/uploads/origins/0c9c3b07-4576-48df-b771-d3102525ee87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b228fa4450914e0138f0eb04f87e1a7 3x", "genre": "art", "nsfw": false, "body": "To 曜先生\n\nこんばんは！\nお世話になっております。NepuX です！\n\nアクスタ！届きました！！(大歓喜)\n壁紙とセットで大事に大事に飾らせていただいております。\n\n今回ちょっとまた別の娘なのですが、とってもかわゆい娘なので\nぜひまた 1 枚リクエストさせていただきたく、ご検討だけでもいただければ幸いです(*´∇`)ﾉｼ\n\n◆ 概要\nキャラ：戦国乙女4 より 山本カンスケ\nサイズ：4K 縦向き - 2160 x 3840 px (350dpi 程度)\n用途　：壁紙用に (個人利用に限ります)\n形式　：PSD\n※ 今回は縦置きディスプレイ用に、キャンパス向きは 縦 にてお願いいたします！\n\n◆ キャラ情報\n非常に、非常ーに資料が少ないので、PV (3.5 分ほど) を見ていただくのが一番早いかと...<(_ _)>\n\n▼ 立ち絵\nhttp://otome-portal.com/sengoku/character/kansuke/img/img-01.png\nhttp://otome-portal.com/sengoku/character/kansuke/img/img-02.png\nhttp://otome-portal.com/sengoku/character/kansuke/img/img-03.png\n\n▼ PV\nhttps://www.youtube.com/watch?v=2YPXrS8vuVY\n\n▼ 公式資料\nhttps://x.gd/73byw\nhttps://www.heiwanet.co.jp/assets/images/products/guide/l-sg5.pdf\n\n◆ 構図・背景\n特に指定はありませんので、壁紙向けに曜先生のオススメを\nひとついただけるとありがたいです！\n\nまた、背景はカンスケらしく ダーク / シック な感じに\n仕上げていただけるとありがたいです。\n( 緑 / 黒 ベースのべた塗り・グラデーションなどでも全然問題無いです！)\n\n◆ その他お願い\n前回と同じく、曜先生のサインや宛名など文字類を別レイヤーに記載いただけるとありがたいです！\n\n以上、ご確認のほどよろしくお願いいたします(*´∇`)ﾉｼ\n\nNepuX", "created_at": "", "completed_at": ""}, {"path": "/@yo_namikaze/works/17", "thumbnail_src": "https://si.imgix.net/496540ef/uploads/origins/2e161e3c-4c1d-4e01-8769-8266d4bce336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d2d64aba60de02e4d6c916e8389692d", "thumbnail_srcset": "https://si.imgix.net/496540ef/uploads/origins/2e161e3c-4c1d-4e01-8769-8266d4bce336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d2d64aba60de02e4d6c916e8389692d, https://si.imgix.net/496540ef/uploads/origins/2e161e3c-4c1d-4e01-8769-8266d4bce336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dd3a5f7ffd0ead950bb5a9e7d1511fb 2x, https://si.imgix.net/496540ef/uploads/origins/2e161e3c-4c1d-4e01-8769-8266d4bce336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c471faa11cbac417c5ec4b1dd6238703 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n初めまして\nいつも良いイラストを描いてるのを見て\nいつか依頼を送ってみたいとやきもきしながら今回をきっかけに思い切って送らせていただきました！\n特に服の装飾やシワそして影がとても良くって見ているこちらが楽しくなってしまいます！\n\nさて、今回の依頼内容ですが\n\n・キャラ\n『アイドルマスターミリオンライブ』より\n最上静香、北沢志保\n『アイドルマスターシンデレラガールズ』より\n渋谷凛\n『アイドルマスターシャイニーカラーズ』より\n風野灯織\nの４名です\n\n・シチュエーション\n野外で4人とも顔を赤らめて恥じらいながらスカートをたくし上げる\n\n・衣装\n全員ミリオンライブの制服シリーズ(静香や志保のタイプの制服シリーズ)\n\nの以上の内容となります！\n構図やその他の事は南風さんの好みでお願いします！\n問題が無ければよろしくお願いします！", "created_at": "", "completed_at": ""}]}