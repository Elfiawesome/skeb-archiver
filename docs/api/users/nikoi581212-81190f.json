tsize=30&txt=PRIVATE&s=51fe4ce2b601582756a89427e784aa6a 2x, https://si.imgix.net/ced8eb12/uploads/origins/596a5c87-f4a8-4777-a428-1bc90b7795aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d92bf84ccffaff70f667a5d1ff04dbe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/44", "thumbnail_src": "https://si.imgix.net/23612553/uploads/origins/79cfad66-e1a7-49c5-8bda-97847c42c38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57edb9a369ef067a2c91a5c2771913d1", "thumbnail_srcset": "https://si.imgix.net/23612553/uploads/origins/79cfad66-e1a7-49c5-8bda-97847c42c38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57edb9a369ef067a2c91a5c2771913d1, https://si.imgix.net/23612553/uploads/origins/79cfad66-e1a7-49c5-8bda-97847c42c38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dab3fb32dbbc6ac96803369a23d5ee05 2x, https://si.imgix.net/23612553/uploads/origins/79cfad66-e1a7-49c5-8bda-97847c42c38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27047ef02a2ff146875d36a09f278e7d 3x", "genre": "art", "nsfw": true, "body": "要介護な宗谷さん（南極観測船のすがた）のリクエストです!\n細かい感じはお任せします!!", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/43", "thumbnail_src": "https://si.imgix.net/dfa69b55/uploads/origins/7a5e4570-5405-4156-b09e-b29a4b374bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5c489383347e11324d1b3cda7e66eb", "thumbnail_srcset": "https://si.imgix.net/dfa69b55/uploads/origins/7a5e4570-5405-4156-b09e-b29a4b374bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5c489383347e11324d1b3cda7e66eb, https://si.imgix.net/dfa69b55/uploads/origins/7a5e4570-5405-4156-b09e-b29a4b374bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7a39d8cddce132dcc4b26adfe159e63 2x, https://si.imgix.net/dfa69b55/uploads/origins/7a5e4570-5405-4156-b09e-b29a4b374bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a777726bc0fb202cbc0edf585c313a27 3x", "genre": "art", "nsfw": true, "body": "初依頼失礼します。いつもお世話になっております。\nネルソン（艦これ）の肥満化で依頼させていただきます。\n\n▶シチュエーション\n提督にお世辞抜きで肥満体を褒められ、珍しく赤面するネルソン。\n照れて普段の調子が崩れ、しどろもどろになり、最後に小声で感謝を伝える。\n\n▶詳細\n・太り方は、過去作の腹肉ネルソンタッチのような普通のものか、塊BIG7のようなまん丸塊魂体型のいずれか。\nhttps://skeb.jp/@nikoi581212/works/12\nhttps://skeb.jp/@nikoi581212/works/36\n・照れた理由についての補足：自身の貫禄ある肥満体は誇りに思っており、日頃から周囲に誇示していたが、提督から性愛的に魅力を褒められる事は全く想定していなかった。\n\n以上となります。そぐわなければ一部内容を改変しても構いません。\n何卒、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/42", "thumbnail_src": "https://si.imgix.net/9d5bf60e/uploads/origins/1626703e-ebdb-43b1-a9d4-9806527407da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b16d88897fca5e289a44f572cc3a214", "thumbnail_srcset": "https://si.imgix.net/9d5bf60e/uploads/origins/1626703e-ebdb-43b1-a9d4-9806527407da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b16d88897fca5e289a44f572cc3a214, https://si.imgix.net/9d5bf60e/uploads/origins/1626703e-ebdb-43b1-a9d4-9806527407da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbb57357d6da81d6843cd0622199b1d0 2x, https://si.imgix.net/9d5bf60e/uploads/origins/1626703e-ebdb-43b1-a9d4-9806527407da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdee73511a6b96badeea80a06872b5dd 3x", "genre": "art", "nsfw": true, "body": "こちらでははじめまして、リクエスト失礼します。\n\n艦これ、朝潮（改装段階問わず）の肥満化をお願いします。\n\n詳細\n体型：二足歩行可能な範囲\n服装・シチュ：激太りした朝潮がフリフリかわいい系の服（サイズは大きいが激太りに間に合っていない）を着て、食べ歩いている。\n（服も体型も荒潮等の妹が元凶のイメージ）\n\n以上、どうかご検討いただければ幸いです。\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/41", "thumbnail_src": "https://si.imgix.net/212836ed/uploads/origins/f409b8eb-e039-4709-8144-cf7f74f035e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cdfa2e633ddc3d26d0d56cdfa232d97", "thumbnail_srcset": "https://si.imgix.net/212836ed/uploads/origins/f409b8eb-e039-4709-8144-cf7f74f035e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cdfa2e633ddc3d26d0d56cdfa232d97, https://si.imgix.net/212836ed/uploads/origins/f409b8eb-e039-4709-8144-cf7f74f035e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dad2ea80525148ac09b56d53d349e1e 2x, https://si.imgix.net/212836ed/uploads/origins/f409b8eb-e039-4709-8144-cf7f74f035e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f46263f781eb6fc56bf98b4c0f36e237 3x", "genre": "art", "nsfw": true, "body": "はじめまして！うちの子の画像をリクエストしています：\nhttps://catbox.moe/c/hrum5d\n\n彼女はデカいお姉さん（226cm）です。背丈が人よりも高いかわいいなモブ顔女。縦にも横にもおっきくてよ。お姉さんは甘いものが大好きで、たくさん食べることができる。好物はドーナツ、洋菓子、パンケーキなど。楽しいことが大好きな女性だけど、ちょっと天然ボケ。お姉さんは楽しいことがあると、よく夢中になる。基本的にアホです。\n\n好きなように描いてください。ご清聴ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/40", "thumbnail_src": "https://si.imgix.net/bf8994b5/uploads/origins/32c0f8a1-f450-4c92-b8ea-c106fcbe5346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513180056356cd41ff37b0c81cea8c48", "thumbnail_srcset": "https://si.imgix.net/bf8994b5/uploads/origins/32c0f8a1-f450-4c92-b8ea-c106fcbe5346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513180056356cd41ff37b0c81cea8c48, https://si.imgix.net/bf8994b5/uploads/origins/32c0f8a1-f450-4c92-b8ea-c106fcbe5346?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c6bdb05cde594a9336439f7a3314f65 2x, https://si.imgix.net/bf8994b5/uploads/origins/32c0f8a1-f450-4c92-b8ea-c106fcbe5346?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99e453f4632fb41e31f1ad98d2db80e9 3x", "genre": "art", "nsfw": true, "body": "初めてのリクエスト失礼します。\n　ブルーアーカイブのリオ会長（https://bluearchive.wikiru.jp/?%E3%83%AA%E3%82%AA）の膨体をリクエストしたいです。バルーンアーカイブで描かれた様な膨体で、膨体した姿が一切見切れず、全体が見える様に描いて欲しいです。\n　推しかつ、バルーンアーカイブのゲストで少ししか映っていなかったので折角ならばと思いリクエストさせていただきました。\n　ご一考の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/39", "thumbnail_src": "https://si.imgix.net/48733935/uploads/origins/d02ae55e-71d5-4929-8bae-ea5ab584d89b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f13eadb2db782b305ddce3714f45aa79", "thumbnail_srcset": "https://si.imgix.net/48733935/uploads/origins/d02ae55e-71d5-4929-8bae-ea5ab584d89b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f13eadb2db782b305ddce3714f45aa79, https://si.imgix.net/48733935/uploads/origins/d02ae55e-71d5-4929-8bae-ea5ab584d89b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3b308ae28492dc191b55d16a745adeb 2x, https://si.imgix.net/48733935/uploads/origins/d02ae55e-71d5-4929-8bae-ea5ab584d89b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b2e1994268459719d2169e624ebd3c8 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回の依頼内容なのですが、「魔法少女リリカルなのはのフェイト・T・ハラオウンが変身した際に敵の罠が発動してブクブク太り、太りすぎた体のラインが丸見えになって恥ずかしがる様子」をお願いしたいです。\nフェイトちゃんの格好は大人時代の真・ソニックフォームの衣装で、体型は身動きが取れないぐらい(https://twitter.com/nikoi581212/status/1362083783734743043  ←こちらの絵位の体型)で、胸を重点的に盛って欲しいです。\n面倒な依頼かとは思いますが、御一考いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/38", "thumbnail_src": "https://si.imgix.net/48c5dfe2/uploads/origins/5beea4eb-0c99-471d-a300-e279b487f60e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ba8b96440b02cecabc36e89c201d5cd", "thumbnail_srcset": "https://si.imgix.net/48c5dfe2/uploads/origins/5beea4eb-0c99-471d-a300-e279b487f60e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ba8b96440b02cecabc36e89c201d5cd, https://si.imgix.net/48c5dfe2/uploads/origins/5beea4eb-0c99-471d-a300-e279b487f60e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e9ead43a67e7b6e0467850a89b87896 2x, https://si.imgix.net/48c5dfe2/uploads/origins/5beea4eb-0c99-471d-a300-e279b487f60e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d482c5264ca2f8b76da46c0b4b3d0e0 3x", "genre": "art", "nsfw": false, "body": "こんにちは。Fate/stay nightの遠坂凛の画像をお願いしたいです。ジャンクフードを嬉しそうにたくさん食べている肥満気味の凛ちゃんが見たいです。ありがとうございました。\n\n凛： https://i.imgur.com/mBHz4SW.jpg\n\nサイズ： https://skeb.jp/@nikoi581212/works/8", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/37", "thumbnail_src": "https://si.imgix.net/f492315c/uploads/origins/2bfbff00-7eea-4bb6-abb4-7ea1222c4b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ad8a623c5786d46087138abea18d04f", "thumbnail_srcset": "https://si.imgix.net/f492315c/uploads/origins/2bfbff00-7eea-4bb6-abb4-7ea1222c4b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ad8a623c5786d46087138abea18d04f, https://si.imgix.net/f492315c/uploads/origins/2bfbff00-7eea-4bb6-abb4-7ea1222c4b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6be6b4bcfbaafaed8832205caa14b26 2x, https://si.imgix.net/f492315c/uploads/origins/2bfbff00-7eea-4bb6-abb4-7ea1222c4b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=649ee4064b861e53d045faf14418bf46 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nドールズフロントライン（少女前線）より\nスプリングフィールド/SPAS-12/S・A・T8/PKPの4人の肥満化絵をお願いします。\n\n体型:スプリングフィールドとS・A・T8は https://skeb.jp/@nikoi581212/works/25 の内での米空母達並み\nPKPは https://skeb.jp/@nikoi581212/works/18 中でのアブルッツィ並から  https://skeb.jp/@nikoi581212/works/3  の中でのアイオワ並の間\n最後にSPAS-12は https://skeb.jp/@nikoi581212/works/27 鈴熊達並でお願いします。\n\n衣装:スプリングフィールド/宿舎カフェ内での仕事着 https://wikiwiki.jp/dolls-fl/%E6%8B%A0%E7%82%B9/%E3%82%AB%E3%83%95%E3%82%A7\nSPAS-12/デフォ衣装（https://www.pixiv.net/artworks/63500737の2枚目のベルト・ベストなしのものでOK)\nS・A・T8/デフォ衣装(https://twitter.com/k__hayasi/status/964927346368167936）\nPKP/スキン淑女の密命での衣装（コート類はなくてOK）https://wikiwiki.jp/dolls-fl/PKP(スキン欄参照)\n\nシチュ:宿舎のカフェにて大食いであるSPASとPKPがスプリングフィールドとSAT8から飲み物や料理をたっぷり振る舞われて幸せそうにたくさん食べている様子\nスプリングフィールドとSAT8も一緒に食べててもOK\n\n以上になります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/36", "thumbnail_src": "https://si.imgix.net/6391f0d5/uploads/origins/e3ba655c-daf0-472f-aafe-272a460af1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab6a7458ade7f6e190c1dfe0e2affc60", "thumbnail_srcset": "https://si.imgix.net/6391f0d5/uploads/origins/e3ba655c-daf0-472f-aafe-272a460af1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab6a7458ade7f6e190c1dfe0e2affc60, https://si.imgix.net/6391f0d5/uploads/origins/e3ba655c-daf0-472f-aafe-272a460af1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a94d1f52a84098c439eb7da8bb5544c 2x, https://si.imgix.net/6391f0d5/uploads/origins/e3ba655c-daf0-472f-aafe-272a460af1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59af97f0f25cd8d04591544c562b6b8e 3x", "genre": "art", "nsfw": true, "body": "コロ魂ちゃん(https://skeb.jp/@nikoi581212/works/15)がめちゃくちゃ好きで、\nもっと仲間が増えて欲しいと思って依頼させていただきました。\nもしよろしければお描き願います。\n\n対象はネルソン・長門改二・陸奥改二の3人の塊魂化\n体型は3人ともコロ魂ちゃん並みかそれ以上でお願いします。\n\n背景としては、\n　ひょんなことからコロ魂ちゃんの様に塊魂化させられてしまった3人は\n　気を抜いたら勝手に転がって行ってしまいそうなほどのまん丸ボディに。\n\n　しかしそんな状態でも活躍できると豪語するネルソンは、\n　長門・陸奥の静止を無視して無理やりネルソンタッチを発動。\n　案の定、三者三様あらぬ方向に転がりだして大混乱に。\n\n以上です。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/35", "thumbnail_src": "https://si.imgix.net/b7e4d81d/uploads/origins/201cf9a3-190b-4c7d-b936-f8ba05ea3c71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f440a796e46d430b4e43a2cb3e93474", "thumbnail_srcset": "https://si.imgix.net/b7e4d81d/uploads/origins/201cf9a3-190b-4c7d-b936-f8ba05ea3c71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f440a796e46d430b4e43a2cb3e93474, https://si.imgix.net/b7e4d81d/uploads/origins/201cf9a3-190b-4c7d-b936-f8ba05ea3c71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb35c32b0a1820d4e7b1a8b4a28460f6 2x, https://si.imgix.net/b7e4d81d/uploads/origins/201cf9a3-190b-4c7d-b936-f8ba05ea3c71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33aad890c7cc2dfbddd2aeb650fb2883 3x", "genre": "art", "nsfw": true, "body": "艦これのウォースパイトとアークロイヤルの肥満化をお願いします。https://www.pixiv.net/artworks/75063292\nの続きでその後かなり大きくなった彼女らが大量の空の皿を前にご飯を食べて談笑しているシチュエーションで。", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/34", "thumbnail_src": "https://si.imgix.net/c312dd0a/uploads/origins/5fa6f5b9-f165-4fa9-b28b-ac8ea39a32e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b545e3aca7b02c86d23a618cdef89b1", "thumbnail_srcset": "https://si.imgix.net/c312dd0a/uploads/origins/5fa6f5b9-f165-4fa9-b28b-ac8ea39a32e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b545e3aca7b02c86d23a618cdef89b1, https://si.imgix.net/c312dd0a/uploads/origins/5fa6f5b9-f165-4fa9-b28b-ac8ea39a32e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4863d80627207d8ceabbed94c51fe44a 2x, https://si.imgix.net/c312dd0a/uploads/origins/5fa6f5b9-f165-4fa9-b28b-ac8ea39a32e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9366cd81e3db91bb7d0c350aed062903 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/33", "thumbnail_src": "https://si.imgix.net/4fb3d9ec/uploads/origins/6ca434ab-cc4d-44d3-b20d-79e16cf829d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffe1b097fd658cab0e937fc322bd0b8", "thumbnail_srcset": "https://si.imgix.net/4fb3d9ec/uploads/origins/6ca434ab-cc4d-44d3-b20d-79e16cf829d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffe1b097fd658cab0e937fc322bd0b8, https://si.imgix.net/4fb3d9ec/uploads/origins/6ca434ab-cc4d-44d3-b20d-79e16cf829d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8edfa9a8fe41f565b4bda2cc47f6264 2x, https://si.imgix.net/4fb3d9ec/uploads/origins/6ca434ab-cc4d-44d3-b20d-79e16cf829d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e462b9acdd318b30a2eda6e2395d92c0 3x", "genre": "art", "nsfw": true, "body": "お世話になっております！モルモルです！先日は、素晴らしい作品をありがとうございます！\nもしよければ、再び「森のたくまさん」の花凛ちゃんと拓眞君をお願いします！\n\n今回は、拓真君のお兄さん(3巻に主に登場した)が太っても伸びる新作水着を男女両方で開発し、夏に出す前にテストとして、花凛ちゃんと拓眞君が着て試着する様子と、なぜか同伴した熊谷さんが大きな体に興奮し、よだれをたらしながら二人のお腹を抱え持って揉みしだく様子をお願いしたいです！(設定としては千織ちゃん達もいる設定で)\n\n今回は、二人のビフォーアフターを二枚組でお願いしたいです！\n一枚目は、体質で痩せた拓眞君となぜか体質まで似てしまった痩せた花凛ちゃんとそれを興味なさげに見る熊谷さん(もし可能でしたら、痩せたお兄さんも入れていただけると嬉しいです)\nこの時、久々の痩せた体に感動する花凛ちゃんと体質が似たことに突っ込む千織ちゃん達、驚きつつ褒める拓眞君(とお兄さん)や早く拓眞君にデブになれと急かす熊谷さんたちの会話を入れていただけますと幸いです\n\n二枚目は、海に合う食べ物を食べながら体型がおデブにリバウンドした二人と二人の巨体によだれをたらしお腹に抱き着いて抱え揉みしだく熊谷さん(よければ、ついでに一緒に食べたおデブお兄さんも入れていただけると嬉しいです)\nこの時も、元に戻りショックを受けつつやっぱり食べるのがいいと開き直りつつ、水着のサイズが伸びてびっくりする花凛ちゃんと拓眞君と同じ体質で変貌した花凛ちゃんとまた太っただろと突っ込みながら(それに反論する花凛ちゃんも)サイズがぴったりになる水着に驚愕する千織ちゃん達、サイズに驚きつつ褒める拓眞君（とお兄さん）と巨体になった花凛ちゃん(巨体になれると知らなかった)に驚きつつ拓眞君共々巨体に興奮し二人の肉をほめる熊谷さん達の会話を入れていただけますと幸いです\n\n体型は、熊谷さんがいて前回より後なので、二人共前回よりもちょっと大きくしてもらえると嬉しいです(裸足の足先まで全身で描いていただけると嬉しいです)\n痩せてる時との対比で、お肉を全開に出し夏前なのに汗だく等よりおデブ感を出してもらえると嬉しいです\n\n前回に引き続き、誠に恐れ入ります。シチュや現場、描写について可能な範囲で大丈夫なので、もしよろしければ、描いていただけますと幸いです！何卒よろしくお願い申し上げます！", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/32", "thumbnail_src": "https://si.imgix.net/32f3df11/uploads/origins/5d6e49e7-8320-42b1-affb-e61a5e330804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2869172d8b9fe1df4c83fc4aaf9fcbb", "thumbnail_srcset": "https://si.imgix.net/32f3df11/uploads/origins/5d6e49e7-8320-42b1-affb-e61a5e330804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2869172d8b9fe1df4c83fc4aaf9fcbb, https://si.imgix.net/32f3df11/uploads/origins/5d6e49e7-8320-42b1-affb-e61a5e330804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9434c8fb98a725150a0ab47acf60834 2x, https://si.imgix.net/32f3df11/uploads/origins/5d6e49e7-8320-42b1-affb-e61a5e330804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9327a2dd1c19945b5d56fd07c7352fd4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nikoi581212/works/31", "thumbnail_src": "https://si.imgix.net/64c79568/uploads/origins/da8f395c-09c5-4206-b616-10884d6bf0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe285de14125898ff59d1a0a45b794b", "thumbnail_srcset": "https://si.imgix.net/64c79568/uploads/origins/da8f395c-09c5-4206-b616-10884d6bf0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe285de14125898ff59d1a0a45b794b, https://si.imgix.net/64c79568/uploads/origins/da8f395c-09c5-4206-b616-10884d6bf0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2aa814710a350c128d52df7a718cec51 2x, https://si.imgix.net/64c79568/uploads/origins/da8f395c-09c5-4206-b616-10884d6bf0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=2