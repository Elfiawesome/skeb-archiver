&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c456ed7a03e69555bc0815b0357575a, https://si.imgix.net/67102804/uploads/origins/1289a1c9-4657-48b6-88cd-d7b1365bf864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3359c38a19ab3e984560c8aa2cde8de8 2x, https://si.imgix.net/67102804/uploads/origins/1289a1c9-4657-48b6-88cd-d7b1365bf864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f06dbd78955fbc88bd7363e29324331 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/185", "thumbnail_src": "https://si.imgix.net/27394235/uploads/origins/3f55890a-a718-41df-aa8c-5dbfc6649a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8697c22f788cb12f86d05c2003acd31", "thumbnail_srcset": "https://si.imgix.net/27394235/uploads/origins/3f55890a-a718-41df-aa8c-5dbfc6649a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8697c22f788cb12f86d05c2003acd31, https://si.imgix.net/27394235/uploads/origins/3f55890a-a718-41df-aa8c-5dbfc6649a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac18e496152ae5a5e018da38d87dd7e0 2x, https://si.imgix.net/27394235/uploads/origins/3f55890a-a718-41df-aa8c-5dbfc6649a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95d2399ca8d2a130f0ecbd542105deb8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/184", "thumbnail_src": "https://si.imgix.net/1f619944/uploads/origins/a5631fe7-caca-4181-909b-4e949c0a3a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4da06a461ffbe6775a68f6713af8da7", "thumbnail_srcset": "https://si.imgix.net/1f619944/uploads/origins/a5631fe7-caca-4181-909b-4e949c0a3a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4da06a461ffbe6775a68f6713af8da7, https://si.imgix.net/1f619944/uploads/origins/a5631fe7-caca-4181-909b-4e949c0a3a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd30339c5a3811c982ceea5cff259211 2x, https://si.imgix.net/1f619944/uploads/origins/a5631fe7-caca-4181-909b-4e949c0a3a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82e29babbbe5f9644afc26c038cb4e20 3x", "genre": "art", "nsfw": true, "body": "機動戦士ガンダムSEEDのザフト軍MSパイロットのミゲル・アイマンがパイロットスーツを着た状態で四肢を拘束され性拷問によって強制射精するイラストをお願いします。\n\n設定としては地球連合軍（ザフトの敵）の捕虜になったミゲルが尋問の名目で性的な辱めを受ける。\n尋問官は容姿が美しい捕虜で自身の性的欲求を満たすという悪癖がある。メインはミゲルですので尋問官の描写は有っても無くても気にしません。\n場所は宇宙空間の戦艦の尋問室なので無重力空間ではある。\n\nミゲルはザフトの緑ノーマルスーツ装備で、お任せしますが十字・X字・椅子のどれかで軽く股を開くに四肢を拘束する方法でお願いします。\nミゲルはプライドが高い性格なので屈辱感も大きいと思いますが、最後まで精神的に屈しないようにしてほしいです。\n\n注射か経口接種で（描写しなくても大丈夫です）強制的に媚薬を摂取させられたミゲルは勃起し、呼吸は荒く頬は赤みを帯びている。\n射精感の高まりから無意識に身を捩らせている。\nミゲルは心を強く保ち尋問官に屈しない気持ちが表情に出ている。\n下半身は勃起した男性器の輪郭をかたどるよりもパイスでテントを張る方での描写をお願いします。\n\n尋問官が射精させようとミゲルに何らかの刺激を与え続けた末にミゲルは短い悲鳴と共に射精する。射精では目を瞑りながら顔が仰反る。精液はパイスの外に漏れず中のインナーパンツがグチョグチョになる。射精や痙攣する体の反応などの擬音も入れてください。\n難しくなければ、射精が近づくにつれて捩る体の動きも大きくなり、射精時に腰が後ろに引くか前に出るような描写もお願いします。\n\n射精後に尋問官はミゲルのパイスの首周りの固定と黒いベルトを緩めてから下半身までファスナーを下ろし中のインナーを曝け出した。パンツには精液がべっとりと広がり染み付いている。心は折れていないミゲルは涙目でぐったりとしている。望まぬ射精の余韻に浸りながら呼吸を落ち着かせている。\n\nインナーは上下ともにスパッツタイプのデザイン。上はタートルネックか丸い襟口の水色半袖Tシャツで肩に青のラインがある。下は青の短パンで横に青のラインがある。\n\nhttps://natalie.mu/comic/gallery/news/502915/1948138\n\n\n無理のない範囲で大丈夫ですのでぜひご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/183", "thumbnail_src": "https://si.imgix.net/f4417d37/uploads/origins/0ea500cb-fee5-4520-9e7a-c9ef3a28bcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=292ba79e7782f15e74ee68c4a95f2cba", "thumbnail_srcset": "https://si.imgix.net/f4417d37/uploads/origins/0ea500cb-fee5-4520-9e7a-c9ef3a28bcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=292ba79e7782f15e74ee68c4a95f2cba, https://si.imgix.net/f4417d37/uploads/origins/0ea500cb-fee5-4520-9e7a-c9ef3a28bcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb4a99fad2a32d82333e471af9739b8d 2x, https://si.imgix.net/f4417d37/uploads/origins/0ea500cb-fee5-4520-9e7a-c9ef3a28bcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=254c2e5b709c15f96019a824b6d04fd8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/182", "thumbnail_src": "https://si.imgix.net/d26bf444/uploads/origins/02b7da9b-ef62-4ee1-b67e-a05ef228dad9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ec18e164a47f978d369835c98b3292", "thumbnail_srcset": "https://si.imgix.net/d26bf444/uploads/origins/02b7da9b-ef62-4ee1-b67e-a05ef228dad9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ec18e164a47f978d369835c98b3292, https://si.imgix.net/d26bf444/uploads/origins/02b7da9b-ef62-4ee1-b67e-a05ef228dad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae8ef46d0014631bc50e6a3668ed235d 2x, https://si.imgix.net/d26bf444/uploads/origins/02b7da9b-ef62-4ee1-b67e-a05ef228dad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58c768e42afe62e1e052808cc7a30fc5 3x", "genre": "art", "nsfw": false, "body": "たびたびこんにちは。\n\n女性キャラクターのリクエストをいたします。\n作品：ブリブリ王国の秘宝\nルル・ル・ルル\nhttps://imgur.com/SjykgEZ\n\n肉弾戦を行っているシチュエーション\n武器は不要\n非パンチラ\n胸は元々の作品と同じサイズ\n青い服の後半の装備\n首～肘～腰の部分の衣装は密着度を上げお色気の衣装のような状態\n肘～手 腰～足元までは正規の衣装と同様。\nThankYou！", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/181", "thumbnail_src": "https://si.imgix.net/66956c01/uploads/origins/235d5ba0-19fe-4f7f-b563-937133a0758b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=938502168c6b4d7817e3debbef7eab05", "thumbnail_srcset": "https://si.imgix.net/66956c01/uploads/origins/235d5ba0-19fe-4f7f-b563-937133a0758b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=938502168c6b4d7817e3debbef7eab05, https://si.imgix.net/66956c01/uploads/origins/235d5ba0-19fe-4f7f-b563-937133a0758b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6126c72825fb513af4918d58a96a5f9c 2x, https://si.imgix.net/66956c01/uploads/origins/235d5ba0-19fe-4f7f-b563-937133a0758b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2373303a7a96fcefc6bbdea3f2aa6c5c 3x", "genre": "art", "nsfw": true, "body": "こんにちは。拘束部屋の鎖手錠に両腕を繋がれ膝立ちの姿勢を強いられた全裸のかわいらしい男の子が後ろから黒スーツの男の肉棒でお尻をパコパコ突かれあえいで勃起したおちんちんを上下にプルンプルン揺らしているところをお願いします。\n\n登場人物\n男の子\n服装：全裸\n髪：茶髪\n肌：日焼けしていない色白　傷跡とか殴打された跡はない\n目：黒い瞳\nおちんちん：勃起して8cmくらい、黒ずんでいない、毛は生えていない、包皮は先っちょが出る以外完全に剥けていない\n\n責め役：黒スーツを着たの男、顔出しはしない\n\n場所\n天井から鎖手錠(鉄枷)が吊り下げられ、床に足枷がある薄暗い独房のような拘束部屋\n壁や床は黒に近いグレー、左右の幅は2ｍくらい\n\n男の子の両腕は頭より高い位置の天井から吊り下げられた鎖手錠・鉄枷にはめられ、バンザイのように両手を真上にあげられている。\nひじは曲げずのばす、手指はグーッと握る。\n両足は膝立ちの姿勢を強いられる(膝から下が床に接触する)。両膝の間は肩幅くらい広げる、足の甲は床に接触させる。膝から下の足首くらいに床の金具で固定する。\n\n補足図\nhttps://hstorage.io/dl/20241217064848_796167516130.jpg\n\nプレイ\nアナルファック:責め役は男の子の後ろで膝立ちになって着衣のままズボンのチャックから肉棒を取り出して拘束されたままの男の子のおしりの穴にねじこむ。責め役は男の子をパコパコ突き上げて勃起した男の子のおちんちんは上下にプルンプルン激しく揺れ(揺れる角度は上に45度～下に45度)、腰を前に突き出して海老反りにさせる。\nあごが上に20～30度ぐらいあがる。\n\nアングル\n拘束されて膝立ちの姿勢を強いられた男の子を真っ正面から向き合う(両腕と両足ははみ出さないようお願いします)。\n\n以上よろしくお願いします。\n\nhttps://hstorage.io/dl/20241217064848_796167516130.jpg", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/180", "thumbnail_src": "https://si.imgix.net/a4756f00/uploads/origins/f83f97c0-80a9-48d9-8390-cad07f22bfcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a067b31f0159cbc1f71039e43dfdddf", "thumbnail_srcset": "https://si.imgix.net/a4756f00/uploads/origins/f83f97c0-80a9-48d9-8390-cad07f22bfcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a067b31f0159cbc1f71039e43dfdddf, https://si.imgix.net/a4756f00/uploads/origins/f83f97c0-80a9-48d9-8390-cad07f22bfcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82d776bdd57f96315a3ea9fe14c45fb7 2x, https://si.imgix.net/a4756f00/uploads/origins/f83f97c0-80a9-48d9-8390-cad07f22bfcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d2e2ee11d8220aff7232f0e1b6b560d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/179", "thumbnail_src": "https://si.imgix.net/18142841/uploads/origins/afce55b2-9293-4d97-a2b7-219e9efbafbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e497ffab1a5684f87c7c994cfb03a7dc", "thumbnail_srcset": "https://si.imgix.net/18142841/uploads/origins/afce55b2-9293-4d97-a2b7-219e9efbafbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e497ffab1a5684f87c7c994cfb03a7dc, https://si.imgix.net/18142841/uploads/origins/afce55b2-9293-4d97-a2b7-219e9efbafbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50f162d728601bd2ece3fec78ef509dd 2x, https://si.imgix.net/18142841/uploads/origins/afce55b2-9293-4d97-a2b7-219e9efbafbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d13e58d1084cff1660af99527eff970e 3x", "genre": "art", "nsfw": true, "body": "この間は本当に素敵な作品の納品ありがとうございます！素敵すぎて、前回の冴凛のその後のイラストを\nリクエストしたく再びリクエスト失礼します\n\n可能な限り詳細に指示とのことで色々細かく書いてしまっていますがちょっと不安です、、\n\n【】希望キャラクター【】\nブルーロック\n糸師冴【18歳180cm】攻\n糸師凛【16歳186cm】受\n\n【】前回同様に衣装は【】\nU-20のユニフォーム姿\n糸師冴は白の代表ユニフォーム\n糸師凛は青の代表ユニフォーム \n(公式様のVISUALCHANGEよりCHANGE可能)\n\n【】場所【】\n前回同様試合後ロッカールームの床\n背景にて前回のイラストにて使った\n使用済みオナホ(溢れ出た白濁あり)\n凛の脱いだズボンとスパッツなど\n続編な感じで\n\n【】体位【】\n松葉崩しという体位でお願いいたします\nユニフォーム姿の行為で\n衣装的には\n【冴衣装】\n上そのまま着用\n下はズボン少し下げ竿だしな感じ\n靴下とスパイク履いたまま\n\n【凛衣装】\n・上そのまま\n・下は丸出し\n\n・上がってる足は靴下がずり下がりスパイク脱げかけ\n(ルーズソックスみたいなイメージ)\n(辛うじてつま先に引っかかってるスパイクイメージ)\n\n・下にある足は靴下とスパイクそのままはいてる感じのイメージでお願いいたします\n\n\n【】差分希望【】\nー表情ー\n(こんなイメージで書いてほしいとそれぞれ①ー⑤雰囲気で書かせていただきました)\n\n【冴の目】\n①通常時② 高揚感③射精時④射精後⑤ 充実感 \n（＋可能であれば歪な愛(赤黒い感じの赤目)\n【冴の口】\n①通常②ニヤ口③射精時④充実感⑤舌なめずり\n\n【凛の目】\n①通常時②半目③オホ目④アヘ目⑤堕ち目 \n(＋で赤目とハート可能であれば)\n【凛の口】\n①通常時②オホ口③アヘ口④堕ち口⑤舌出し堕ち口\n\n\nー行為ー\n①投入・ピストン\n冴→(ピストン表現はゆっくり・激しめそれぞれ希望)\n凛→(通常ビクビクと激しめのビクビク表現希望)\n\n②射精\n冴→中出し(勢いよく最奥に)\n凛→射精(激しく飛び散る感じ)\n\n③射精後\n冴→投入した竿の隙間から白濁漏れ出す感じ\n凛→竿とユニが白濁がかかる\n(可能であれば顔にも軽くお願いしたいです)\n\n本当に自分の欲望のまま書いてしまいすみません\n可能な限りお願いいたします\n最後にこれからも応援させていただきます！\n\nhttps://tv.bluelock-pr.com/", "created_at": "", "completed_at": ""}, {"path": "/@96tchi/works/178", "thumbnail_src": "https://si.imgix.net/7aee186e/uploads/origins/74bcf0de-1490-448d-b1f8-5b4c86a7323e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c001301cf50fb6233549ba44781b5416", "thumbnail_srcset": "https://si.imgix.net/7aee186e/u