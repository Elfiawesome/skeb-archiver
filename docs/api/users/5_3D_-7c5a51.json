b4-6bc7842f4c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188aef1a6d088b97eb285a8b9aa83548", "thumbnail_srcset": "https://si.imgix.net/fd6f12fc/uploads/origins/4e8b49e5-a69d-4bfd-8fb4-6bc7842f4c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188aef1a6d088b97eb285a8b9aa83548, https://si.imgix.net/fd6f12fc/uploads/origins/4e8b49e5-a69d-4bfd-8fb4-6bc7842f4c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fff33bcdea1db840e4ac9d933167783d 2x, https://si.imgix.net/fd6f12fc/uploads/origins/4e8b49e5-a69d-4bfd-8fb4-6bc7842f4c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6913bd82456e4f5362c40b39286572a8 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！私のおバカな猫とネズミのキャラクターを主人公にした物語をリクエストしたかったんです。\n\nチェリーはメスのピンクのネズミ。レモンはメスの黄色い猫。ライムはオスの緑猫。猫たちはいたずら好きで頭が悪く、ネズミは優しくて賢い。猫たちは互いに似ていて、まるで脳を共有しているかのようだ。猫たちはいつもチェリーを追いかけて食べようとするが、チェリーはいつも猫たちをだまして、猫たちを傷つけずに逃げなければならない。\n\nこれが私のアイデアだ：\n\nチェリーは2匹のいたずら猫に捕まる。猫たちに食べられる前に、チェリーは猫たちが疲れてストレスがたまっているように見えると宣言する。猫たちは元気そうに見えるが、彼女は猫たちの疲労の兆候をいくつか指摘する。例えば、垂れ下がった目、よだれを垂らす口、垂れ下がった耳、垂れ下がったお尻など。チェリーが猫たちの疲労を指摘した後、猫たちは疲れを感じ始め、チェリーは猫たちを甘やかすために横になるようせがむ。チェリーが猫たちを甘やかすと、猫たちは心地よい枕の上に横たわる。チェリーは猫たちの爪を切り、マッサージをし、眠くなるように歌を歌ってあげる。まぶたが重くなると、猫たちは満足げな笑みを浮かべる。ライムは眠りに落ちるが、レモンのお腹が空腹で目を覚まし、ネズミを食べるよう促す。レモンが起きる前に、チェリーは素早くレモンにジャンクフードを食べさせ、レモンの腹を満足させ、眠くて立っていられなくする。レモンは太って幸せそうに眠りにつく。チェリーは猫たちを甘やかした後で疲れ果て、猫たちの隣で眠ってしまう。猫とネズミは一緒に安らかに眠る。\n\nこのアイデアに興味を持たれた方は、ご自分の創造力を発揮して、キャラクターたちに強い個性を与えてください。お望みであれば、ビジュアルをより面白くするために具体的なディテールの一部を弄っても構いません。キャラクターをイメージしていただけるよう、参考資料を添付しました。楽しんでいただければ幸いです。\n\nhttps://imgur.com/a/HzjkvTU", "created_at": "", "completed_at": ""}, {"path": "/@5_3D_/works/7", "thumbnail_src": "https://si.imgix.net/7725a109/uploads/origins/f1f647be-b7c9-4be9-8778-aeb9c677446d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee53b5478ef2a5300e1130a0c67392c5", "thumbnail_srcset": "https://si.imgix.net/7725a109/uploads/origins/f1f647be-b7c9-4be9-8778-aeb9c677446d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee53b5478ef2a5300e1130a0c67392c5, https://si.imgix.net/7725a109/uploads/origins/f1f647be-b7c9-4be9-8778-aeb9c677446d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3a968205230c7bc98d45dc8fd0222ca 2x, https://si.imgix.net/7725a109/uploads/origins/f1f647be-b7c9-4be9-8778-aeb9c677446d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a766d36426b91ee7a0bca108035f1f5d 3x", "genre": "comic", "nsfw": false, "body": "213先生こんにちは、お邪魔します！あなたの作品が大好きなので、漫画の依頼を送らせていただきました。私の2つのOC、負傷兵と少女についての物語です。彼らは残酷で硝煙に満ちた世界で逃亡する、普通の魂です。提供したURLの二人の断片を基に、自由に創作していただけると嬉しいです。具体的な設定の詳細もURLに記載しています。\n\n世界観：剣と魔法の西洋幻想世界。魔女を討伐する戦争はすでに五年に及んでいます。世界中の様々な国や種族がこの戦争に巻き込まれ、魔女たちはその闇の魔法力で王国連合軍と対抗しています。戦争は大陸全体に広がり、都市は破壊され、村は焼き払われ、人々の生活は深刻な被害を受けています。人々は魔女たちを不吉な存在と考え、彼女たちは災いの化身であり、死と破壊を操る存在だと信じています。国王は魔女たちを完全に排除するよう命じました。しかし、魔女たちの力は容易には抵抗できません。彼女たちは戦場で無数の命を奪い、王国連合軍を次々に後退させています。\n\nセヴィル：元々は時計職人であり、戦争が始まった後に強制的に徴兵されました。彼は負傷兵であり、逃亡兵であり、全軍が壊滅した後、重傷を負いながらも何とか逃げ出した若い兵士です。自分が報告すべきであることを理解しながらも、彼の心に残っているのはただ一つの思いだけです――故郷に帰ること。彼は自分の行動に対して罪悪感を抱き、内心で苦しんでいます。感情が不安定で、外部からの刺激に非常に敏感です。\n\nレナ：外見は12、3歳のような三無系の神秘的な少女で、戦乱の廃墟で発見されました。全体的な印象は神秘的で静かであり、観察と受容です。他人への荒々しい反応にもかかわらず、彼女は沈黙と忍耐を保ち、年齢を超えた理解力と寛容さを持っています。\n\nhttps://drive.google.com/drive/folders/1-YrjNM5Ha9OsdZlR5oM1IU7JcaYiEppT\n\nhttps://drive.google.com/drive/folders/1-YrjNM5Ha9OsdZlR5oM1IU7JcaYiEppT", "created_at": "", "completed_at": ""}, {"path": "/@5_3D_/works/6", "thumbnail_src": "https://si.imgix.net/f2382097/uploads/origins/1153a357-3f2a-4b10-a0bf-4d64721ec0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55f430e4e1f7c61defd3a7321225f166", "thumbnail_srcset": "https://si.imgix.net/f2382097/uploads/origins/1153a357-3f2a-4b10-a0bf-4d64721ec0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55f430e4e1f7c61defd3a7321225f166, https://si.imgix.net/f2382097/uploads/origins/1153a357-3f2a-4b10-a0bf-4d64721ec0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8efca7770371b4251d25fecd69cc3e28 2x, https://si.imgix.net/f2382097/uploads/origins/1153a357-3f2a-4b10-a0bf-4d64721ec0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47614d509cc8139c90ffca696cae842e 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@5_3D_/works/5", "thumbnail_src": "https://si.imgix.net/ffc3578a/uploads/origins/e5376907-5947-424e-b106-687e1bf852a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52af03301b8f51633b1dbac6a1326840", "thumbnail_srcset": "https://si.imgix.net/ffc3578a/uploads/origins/e5376907-5947-424e-b106-687e1bf852a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52af03301b8f51633b1dbac6a1326840, https://si.imgix.net/ffc3578a/uploads/origins/e5376907-5947-424e-b106-687e1bf852a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7656f4f5cb94c106bed2dd55d2ee1c6d 2x, https://si.imgix.net/ffc3578a/uploads/origins/e5376907-5947-424e-b106-687e1bf852a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=410ef6f137d4634e223fbbb5025344a7 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、213さん！213さんの繊細な画風と、キャラクター同士のやりとりの面白さに一目で惚れました！もし可能なら、私のオリジナルキャラクター（14とインドレ）が一緒に冒険を繰り広げるマンガを作っていただきたいです。  \n二人は幼なじみです。まだ付き合ってはいないが、インドレはすでに14に恋心を抱いている。しかし、彼は恥ずかしがり屋で、失敗ばかりしている。怪我をした14に薬を塗っているのはインドルなのに、気絶しそうなのはインドルのほうだ。\n14: 冷静、勇敢、友好的。非常に強く、探検と戦闘を担当。白兵戦と槍の使い方に長けている。危険な自然環境の探索に興味がある。\nインドル：穏やか、内気、鋭敏な観察者。体力はあまりなく、後方支援と分析を担当。護身用にリボルバーを携帯。道中の動植物のサンプル収集と14号の戦闘の観察に興味がある。  \n構成と衣装はお任せします！\nありがとうございました  \n-\nhttps://drive.google.com/drive/folders/1-GF6xfGbuMkI5D_3zuPXQ8FDs6pXsuoG?usp=drive_link", "created_at": "", "completed_at": ""}]}