-05a0f9da1a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4721605be6cd5a8011bb1ab7e349ca92, https://si.imgix.net/b372cc66/uploads/origins/872f3329-0427-4208-8c5c-05a0f9da1a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=747872563ba7b5e63db7b39d1a4ffa98 2x, https://si.imgix.net/b372cc66/uploads/origins/872f3329-0427-4208-8c5c-05a0f9da1a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f518f5592043d02b1466acb956af53f0 3x", "genre": "art", "nsfw": true, "body": "うちのキャラすみやのイラスト委託したいです！\n\nキャラはショタっぽい犬が犯されて、うつぶせって後ろに向いて穴が完全に開いてる\n\n床がいっぱい使用済のコンドームあるし、周りも攻め達の精液残ってるちんぽある\n\nどうもありがとうございます！\n\nキャラ設定、過去の委託イラスト参考資料\nhttps://images.plurk.com/30ymNiewyMjDzQKaGld7ff.jpg  https://images.plurk.com/2BGFFgtSoJBpMYTbQNYncG.jpg \n https://images.plurk.com/635mkwVgTrNR6rxQ9iR00r.png \n\nポース参考\nhttps://images.plurk.com/6lFvZm97aGEdI4iHd4LlTV.jpg", "created_at": "", "completed_at": ""}, {"path": "/@MutsumiYuu/works/19", "thumbnail_src": "https://si.imgix.net/5c3617d8/uploads/origins/4f6bcba2-86c2-474b-aa50-af76505c2690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11a321499b14da51b288e294098e112", "thumbnail_srcset": "https://si.imgix.net/5c3617d8/uploads/origins/4f6bcba2-86c2-474b-aa50-af76505c2690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11a321499b14da51b288e294098e112, https://si.imgix.net/5c3617d8/uploads/origins/4f6bcba2-86c2-474b-aa50-af76505c2690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24567f8793107072d8c8b82e749c38b7 2x, https://si.imgix.net/5c3617d8/uploads/origins/4f6bcba2-86c2-474b-aa50-af76505c2690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49107f6327afaee6439fd8eb5d1bacfa 3x", "genre": "art", "nsfw": false, "body": "はじめまして。絵の雰囲気やかわいいタッチの猫が好きでこの度リクエスト送らせてもらいました。\n\n中２ぐらいの猫ケモショタとホストみたいな派手系の青年（ケモでも人でもいいです）が、大衆食堂（ラーメン屋みたいな定食なども提供するお店）で仲良く夕ご飯食べている絵をリクエストします。\n個人観賞用です。", "created_at": "", "completed_at": ""}, {"path": "/@MutsumiYuu/works/18", "thumbnail_src": "https://si.imgix.net/8288b965/requests/263003_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b7c40f15a0c1720f32d813a0a1fe10", "thumbnail_srcset": "https://si.imgix.net/8288b965/requests/263003_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b7c40f15a0c1720f32d813a0a1fe10, https://si.imgix.net/8288b965/requests/263003_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=657ae5195e94c63150a7237667c2fc7c 2x, https://si.imgix.net/8288b965/requests/263003_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1926c9dc3bc8190f27698b050dc5c6fd 3x", "genre": "art", "nsfw": true, "body": "FFTAのン・モゥ族（白魔道士）がモルボルに捕食されてしまっているイラストを下さい。\n頭隠して尻隠さずの体勢で、お尻とふぐりが丸見え状態でお願いします。失禁描写もお願いします。\nSFWで。", "created_at": "", "completed_at": ""}, {"path": "/@MutsumiYuu/works/17", "thumbnail_src": "https://si.imgix.net/3aebb288/requests/250981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa73592c16076be03ad2ec599e4423c1", "thumbnail_srcset": "https://si.imgix.net/3aebb288/requests/250981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa73592c16076be03ad2ec599e4423c1, https://si.imgix.net/3aebb288/requests/250981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=072dcfe3f51bbb81c5c728d358b467e0 2x, https://si.imgix.net/3aebb288/requests/250981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29e4e8421a3d834d064f69e9ec163dcc 3x", "genre": "art", "nsfw": true, "body": "こんにちは！！！！この二人のキャラクターと一緒に写真を撮ってもらえますか？この二人のキャラクターと一緒に写真をお願いします。二人ともオスです。\n\nてんし：https://puu.sh/HdmZi/e5a73f250b.png\nCael: https://imgur.com/a/u97HfKs\n\n天志はふんどしだけを着て仰向けに寝ている。青くて切られていない彼のペニスは勃起していて、ふんどしの脇から突き出ています。カエルもふんどしを着ていますが、ペニスは見えていません。ケールは立っていて、片方の足を天使の顔の上に置き、天使は両手をケールの足の上に置いています。\n\n表情の割には、ケエルは無邪気な顔をして笑っている。天志は嬉しそうに顔を赤らめています（もちろんケエルの足元には少ししか顔が見えませんが）。\n\n背景が雲で天に見えるようにお願いします。\n\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@MutsumiYuu/works/16", "thumbnail_src": "https://si.imgix.net/74bbb50b/requests/231231_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=262f3b9d19ee3cc66be26a63559392e4", "thumbnail_srcset": "https://si.imgix.net/74bbb50b/requests/231231_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=262f3b9d19ee3cc66be26a63559392e4, https://si.imgix.net/74bbb50b/requests/231231_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea8ac9dd7a29585c3382e1d21f62298a 2x, https://si.imgix.net/74bbb50b/requests/231231_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4546849f597d2606de3833b2f757872 3x", "genre": "art", "nsfw": true, "body": "はじめまして、ネコジャラスと申します。\n\n睦見勇さんのイラストタッチで「ハード」なサイズフェチイラストを見てみたいです。\n\nうちのマスコットキャラクターの「おおかみ君」を巨ケモで描いていただけませんか？\n\n造形は下記資料URLのTwitterプロフィールアイコンや固定ツイートの画像等を参考にして下さい。\n\nちなみに最近のイラストでは「炎系モンスター君」が大のお気に入りです！\n\n2000文字までOKということで、以下に少し細かく要望書かせていただきます。\n\n・500m〜1kmくらいの大怪獣サイズのおおかみ君が町を襲っている感じでお願いします。おおかみ君だけは楽しそうにしてるけど町は阿鼻叫喚の地獄というようなギャップが見たいです。\n\n・おおかみ君の容姿に関しては特にこだわりがあるわけではないので、灰色の狼獣人で首輪さえあればOKです。顔つきやポーズなどおまかせします。\n\n・睦見勇さんの描く「際どい腰布」が好きです！おおかみ君にも付けて欲しいです。\n\n・東京の中心地のような大都市を滅茶苦茶に蹂躙している感じでお願いします。\n\nあとはもし可能であればで結構ですので、以下に少々マニアックな要望も書かせていただきます。\n\n・足裏(肉球あり)に踏み潰された建物の残骸や、ぺちゃんこになった人・クルマ・電車などがくっついていると滾ります。\n\n・おおかみ君の背後に広がる街並みは既におおかみ君が通過・蹂躙した後で一部が破壊されていたり、踏み潰されたいたり、炎上していると滾ります。\n\n・足元には避難渋滞している車の列や逃げ惑う人間の姿が確認できると滾ります。\n\n・逃げ遅れた旅客機がいまにもおおかみ君に衝突しそうな距離で飛んでいたり、戦闘機や戦車が無謀にもおおかみ君に攻撃している(しかしノーダメージ)描写があると滾ります。\n\nなんだか好き放題書いてしまい申し訳ありません。\n\n最後に作品の利用範囲について要望があるのですが、現在、「ケモノ大好きクラブ」というケモノブログを運用しており、そこでskebについての記事を投稿する予定があります。もしよければその記事中で睦見勇さんの紹介も兼ねてイラストを使わせていただけないでしょうか？(サムネイルや実例紹介として)\n\nリクエストを承認いただけた場合は記事での利用OKと判断致しますので、難しいようであれば本リクエストは無視していただいて結構です。\n\n是非ご検討のほどお願い致します。\n\nhttps://mobile.twitter.com/nekojyaras77", "created_at": "", "completed_at": ""}, {"path": "/@MutsumiYuu/works/15", "thumbnail_src": "https://si.imgix.net/cfa50a29/requests/204119_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77456c05ffbad916d11ec9fb6ffd3d77", "thumbnail_srcset": "https://si.imgix.net/cfa50a29/requests/204119_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77456c05ffbad916d11ec9fb6ffd3d77, https://si.imgix.net/cfa50a29/requests/204119_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03030298b7db93524640df888e5e1904 2x, https://si.imgix.net/cfa50a29/requests/204119_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea203efabc3002e0c62769fc96bcb4ed 3x", "genre": "art", "nsfw": true, "body": "DRAGON BALLのアニメオリジナルキャラ・コンキチが暴漢に乱暴されて、ズボンを脱がされてお尻を露出してしまって恐怖で失禁するイラストを下さい。両手はロープで縛られ、両脚やシッポはなるべくお尻を隠さないよう、あくまで下半身だけ露出し、シャツと靴（靴下）は装着したままでお願いします。それと軽いアザや土汚れなんかもあると嬉しいです。\n\nhttps://imgur.com/6BpLfpJ", "created_at": "", "completed_at": ""}, {"path": "/@MutsumiYuu/works/14", "thumbnail_src": "https://si.imgix.net/8ab131a3/requests/169080_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d95a81c7f9e55c64204d7c4e47cdf36", "thumbnail_srcset": "https://si.imgix.net/8ab131a3/requests/169080_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d95a81c7f9e55c64204d7c4e47cdf36, https://si.imgix.net/8ab131a3/requests/169080_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3b0210a4497afae85e8ca88a65fb4ee 2x, https://si.imgix.net/8ab131a3/requests/169080_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&tx