-4a24-a709-56d40f41bcea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6e3dafecb513c216f0574323e9a8041 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/169", "thumbnail_src": "https://si.imgix.net/4d9e850a/uploads/origins/7214a0d5-1aef-4593-a926-67db8bc892d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11a5cb9a284b7b9c3ed1757d0b16beec", "thumbnail_srcset": "https://si.imgix.net/4d9e850a/uploads/origins/7214a0d5-1aef-4593-a926-67db8bc892d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11a5cb9a284b7b9c3ed1757d0b16beec, https://si.imgix.net/4d9e850a/uploads/origins/7214a0d5-1aef-4593-a926-67db8bc892d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c49b37ffd7f5c22c24f14d149f00c028 2x, https://si.imgix.net/4d9e850a/uploads/origins/7214a0d5-1aef-4593-a926-67db8bc892d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a2aab13821b734086bbc4fb76ede1de 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n\nチュウニズムのキャラクター「レナ･イシュメイル」のえっちをお願いしたいです。\n\n行為の流れは、\n①レナが涙目になりながら恥ずかしそうにスカートをたくし上げてる→②相手がパンツごしに女性器を指で擦り、胸を服越しにカリカリする→③パンツを脱がすか横にずらして女性器を直接触る（手で女性器が隠れないようにお願いします。女性器が見やすいように）服を上に捲り胸を直接カリカリする→④レナ絶頂→⑤絶頂の余韻（ハート目、愛液が垂れている）\nのような流れで差分を作っていただきたいです。\n金額的に難しそうなら①と②は無しで③からで大丈夫です。\n\n構図は以前描かれていた（https://skeb.jp/@kohsuke_krsk/works/85）こちらのような感じでお願いします。\n\n服装はゲーム内通常衣装（資料内のレナ通常）です。　パンツの色は白でお願いします。\n\n背景（場所）は特に指定はありませんが何かしらあると嬉しいです。\n\nご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1A4trDTNnR-NGTeITjzkHvz_QHoYxrGsT", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/168", "thumbnail_src": "https://si.imgix.net/169853ea/uploads/origins/aa493fa9-67c5-4b06-b44a-5f05f72ca966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6951e3865e875fd2c0a6634f181029dd", "thumbnail_srcset": "https://si.imgix.net/169853ea/uploads/origins/aa493fa9-67c5-4b06-b44a-5f05f72ca966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6951e3865e875fd2c0a6634f181029dd, https://si.imgix.net/169853ea/uploads/origins/aa493fa9-67c5-4b06-b44a-5f05f72ca966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cccb961804cfc861a26d5c0f60428169 2x, https://si.imgix.net/169853ea/uploads/origins/aa493fa9-67c5-4b06-b44a-5f05f72ca966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65bc171b9bbf02dc75d56031718f494a 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n黒崎先生の描かれるもちもちふんわり可愛い女の子のイラストに惹かれまして、畏れながらこの度リクエストさせていただきます。ご一考いただけますと幸いです。\n\n▽キャラクター\n1000ちゃんというコンテンツより、『ミリオちゃん』という子のイラストをお願いいたします。\nhttps://x.com/ninjinplanter/status/1705975922338496714\n衣服は以下添付資料１枚目のライブ衣装にて、破れ具合はだけ具合等々、衣服の状態はおまかせいたします。\nhttps://x.com/ninjinplanter/status/1710887827536503004\n\n▽ 内容\n上記ミリオちゃんが触手に襲われ大変な目に遭っているNSFWイラストをお願いします。\n雰囲気としては、触手生物にお持ち帰りされ肉壁空間で四肢拘束されている状態。ブラシ型の触手で股下をにゅるにゅるぞりぞり前後に擦られ、嫌がりつつもあまりの感覚に色んな液体を垂れ流してしまっている。といった感じでお願いします。\n粘液感・湿度感多め高めに描写いただけるととても捗ります。裁量はお任せいたします。\n\n---\n以上、先生のご存知ないコンテンツの子かもれしれず大変恐縮ですが、もしお引き受け可能でしたら何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/167", "thumbnail_src": "https://si.imgix.net/c7d0ef10/uploads/origins/f417c8c9-0207-4707-a68b-e3cf554fd0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32ca8e07fae7f45282736bdc52985f72", "thumbnail_srcset": "https://si.imgix.net/c7d0ef10/uploads/origins/f417c8c9-0207-4707-a68b-e3cf554fd0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32ca8e07fae7f45282736bdc52985f72, https://si.imgix.net/c7d0ef10/uploads/origins/f417c8c9-0207-4707-a68b-e3cf554fd0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35054000b2bc3e31d645772e119ddffa 2x, https://si.imgix.net/c7d0ef10/uploads/origins/f417c8c9-0207-4707-a68b-e3cf554fd0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d576d9ddeb62f772bee133057144cf55 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/166", "thumbnail_src": "https://si.imgix.net/94370f9b/uploads/origins/09112a73-1ae8-44f2-9500-4ed7ed3fd83f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=944b3a7f405063990b3429dadf332f07", "thumbnail_srcset": "https://si.imgix.net/94370f9b/uploads/origins/09112a73-1ae8-44f2-9500-4ed7ed3fd83f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=944b3a7f405063990b3429dadf332f07, https://si.imgix.net/94370f9b/uploads/origins/09112a73-1ae8-44f2-9500-4ed7ed3fd83f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7616ed0012365beab246d20e80c7b1dc 2x, https://si.imgix.net/94370f9b/uploads/origins/09112a73-1ae8-44f2-9500-4ed7ed3fd83f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56d6ae281a874a6948043232d9124a90 3x", "genre": "art", "nsfw": true, "body": "題材：フランドル(アズールレーン)\n服装：デフォルト（メイドでも可）\n構図・背景・表情：お任せします\nサイズ：PC壁紙を想定\n\n【参考】\n公式\nhttps://x.com/azurlane_staff/status/1679392718450212864\nメイドスキン\nhttps://x.com/azurlane_staff/status/1738396508981010845\n設定画\nhttps://x.com/NAMYOooo/status/1679348679151607808\nシスター衣装\nhttps://x.com/azurlane_staff/status/1852908566916878736\nアニメーション原画\nhttps://x.com/Yuuta16597/status/1973341691605295516\n\n【ご挨拶】\nこんにちは。\n流れてきた蒸しニヤニヤ教授を見て電流が走ったのでこの度依頼をさせていただきました。\nとりあえず目に入るのは実に美味しそう（婉曲表現）に仕上がった脚ですね。この教授の脚は膝の描写がはっきりしていてふくらはぎや太ももの筋肉が分かるような曲線になっているため、比較的「健脚」というイメージが付くと思うのです。とすると暗躍の裏で地道に続けてる草の根活動の終わりだったのかなとか計画の為にわざわざ自らの脚を運んだ帰りなのかなという想像もできるわけです。そういう描写されぬ背景があると想像が膨らみ何度見返しても楽しいイラストになっているなと感じます。脚に視線を向けていると必然その奥のパンツ周りの書き込みも目に入って来るわけで、座り込んで収縮している股間の筋肉のくぼみや脚と腰の付け根に生まれる溝などが自然に味わえるようになっていてとても良いと思います。（語彙死滅）一通り堪能した上で上半身に目を向けても、確かに下半身と比べてシンプルな色付けになっているがだからこそ力を入れた下半身がきちんと主役を張れていると一目で分かるし、だからといって添え物と言い切るには全く遜色ない魅力のある、というかこっち単体でも一枚にできるかわいい描写ができていると感じます。教授特有の不敵な雰囲気が疲労で剥がれ、見た目相応のあどけない表情が虚脱感によって成立しており普段とのギャップによりかわいさを引き立てている素晴らしい表情チョイスだと思います。髪については汗を吸って張り付く前髪と、汗そのものは吸わないとしても体の熱気を捉えて離さないもふもふの後ろ髪が分けて書いてあり、これもまた巧の一言でしょう。コートも気崩すのがニヤニヤスタイルですが今回に限ってはまた違う意味合いが産まれていいですね。胡乱な印象が外れて素が見えるような心理的脱衣と彼女の小さい体格をほのめかす物理的脱衣の両方を最小限の衣装変化で両立させていると感じます。ここまで上半身を楽しんでまた膝に誘われ下半身を楽しむことができる本当に素晴らしい一枚だと思います。\n\n\n上記の感想は読み飛ばしていただいて、今回依頼させていただくフランドルちゃんはあどけなさ、神々しさ、そして一つまみのドスケベさを兼ね備えた非常に愛おしい主人公崇拝系無垢ロリなのですが、出身ゲームがキャラ過多かつどうしても乳がデカい方が人気があるので秀逸なデザインと需要に反してFAが著しく少ないのです。この世界に少しでも彼女のイラストを増やすべくどうか貴方のお力をお貸しください。", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/165", "thumbnail_src": "https://si.imgix.net/47d9f2e0/uploads/origins/e340ab43-7940-4edc-98e1-0fffe87dc5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1bdad4dabbd4cbe6a383321b836520b", "thumbnail_srcset": "https://si.imgix.net/47d9f2e0/uploads/origins/e340ab43-7940-4edc-98e1-0fffe87dc5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1bdad4dabbd4cbe6a383321b836520b, https://si.imgix.net/47d9f2e0/uploads/origins/e340ab43-7940-4edc-98e1-0fffe87dc5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=191eb54bec32af2650ada35e465a5b45 2x, https://si.imgix.net/47d9f2e0/uploads/origins/e340ab43-7940-4edc-98e1-0fffe87dc5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a834d5a3692f412190688ad3cf959c9 3x", "genre": "art", "nsfw": false, "body": "こんにちは、クリスマステーマのものをリクエストしたいのですが（おそらくクリスマス後の配達になります）\n\nノゾミちゃん、モモカちゃん、ムツキちゃんは全員赤いサンタ風の制服を着ている。ノゾミちゃんはふわふわのクリスマス帽子をかぶっている。\n\n三人ともからかうように視聴者に向かって笑う。ふふふ\nノゾミちゃんは笑いながら、手を口元に近づける。\nモモカちゃんは視聴者の方を指さす。\nムツキちゃんは笑いながら、指を自分の口元に向ける。\n\n三人はそれぞれ、もう一方の手で小さな包みを持ち、その手を観る者の方へ差し出して贈り物を渡そうとしている。\n\n「プレゼントももらえなかったの？ 情けないわね、仕方ないわね」…そんな感じの雰囲気！", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/164", "thumbnail_src": "https://si.imgix.net/d31b38d8/uploads/origins/92c32ae2-ed05-4c01-b17a-39b05c6c7a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5c8d7ad474cde382155bf21a370d843", "thumbnail_srcset": "https://si.imgix.net/d31b38d8/uploads/origins/92c32ae2-ed05-4c01-b17a-39b05c6c7a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5c8d7ad474cde382155bf21a370d843, https://si.imgix.net/d31b38d8/uploads/origins/92c32ae2-ed05-4c01-b17a-39b05c6c7a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4058b4c14135a0cc57672a6a61682464 2x, https://si.imgix.net/d31b38d8/uploads/origins/92c32ae2-ed05-4c01-b17a-39b05c6c7a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0c13cad0d95bac60e13f468a99507ac 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/163", "thumbnail_src": "https://si.imgix.net/6271fb88/uploads/origins/9a4fedee-02e5-4d61-903e-d551ea270764?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b77aaa6f0b980c2bc9419e6cdd3d1bf4", "thumbnail_srcset": "https://si.imgix.net/6271fb88/uploads/origins/9a4fedee-02e5-4d61-903e-d551ea270764?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b77aaa6f0b980c2bc9419e6cdd3d1bf4, https://si.imgix.net/6271fb88/uploads/origins/9a4fedee-02e5-4d61-903e-d551ea270764?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bef3fc046e6302a2468f4302b7a5dc5d 2x, https://si.imgix.net/6271fb88/uploads/origins/9a4fedee-02e5-4d61-903e-d551ea270764?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24a883d776c0d3c9a1b344e0973b471f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/162", "thumbnail_src": "https://si.imgix.net/b56bd814/uploads/origins/d3f96249-8d75-419a-9929-63d8a99a5982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ba355b4c2bef2cff8fa966cc18c8c0", "thumbnail_srcset": "https://si.imgix.net/b56bd814/uploads/origins/d3f96249-8d75-419a-9929-63d8a99a5982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ba355b4c2bef2cff8fa966cc18c8c0, https://si.imgix.net/b56bd814/uploads/origins/d3f96249-8d75-419a-9929-63d8a99a5982?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e998e39a3cc9dfa7e67d560a2d8d2aa 2x, https://si.imgix.net/b56bd814/uploads/origins/d3f96249-8d75-419a-9929-63d8a99a5982?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6051a62dcc65e8891936b3e7b01bc06 3x", "genre": "art", "nsfw": true, "body": "はじめましてこんにちは！\n初めてのリクエストなのですか、受けていただけるとありがたいです！\n私の代理的な？うちの子的な子「三崎黒音ちゃん」のえっちなイラストをお願いしたいです！\n路地裏的な場所で片足上げ立ちバックで無理やり犯されているシチュをお願いしたいです。\nソックスはニーソ(白or黒)でお願いします。\n片足ぱんつ(青のしましま)をお願いしたいです！\n可能なら受精カットインもお願いしたいです！\n是非ともよろしくお願いいたします。\n\nおかし屋(@okashiageruoide)先生が描いてくれた資料です▶https://x.com/irukamairuiru/status/1986051520945897954?t=rfwBoba0QRvBI6_4Kz3BJA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/161", "thumbnail_src": "https://si.imgix.net/ba1661f4/uploads/origins/f4e7972d-f5eb-49b4-ba5f-bcbe37ef52c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e519ec5d77f7d623ab749f566ba880b", "thumbnail_srcset": "https://si.imgix.net/ba1661f4/uploads/origins/f4e7972d-f5eb-49b4-ba5f-bcbe37ef52c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e519ec5d77f7d623ab749f566ba880b, https://si.imgix.net/ba1661f4/uploads/origins/f4e7972d-f5eb-49b4-ba5f-bcbe37ef52c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a321a6f85fee55e2fe4978fdfa82103 2x, https://si.imgix.net/ba1661f4/uploads/origins/f4e7972d-f5eb-49b4-ba5f-bcbe37ef52c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50c432c5f11a312050668f728f1c7eac 3x", "genre": "art", "nsfw": false, "body": "うちの子(代理)のSNS用イラストを3種類お願いしたいです。\n代理の衣装等については既定(キャラクターデザイン通り)でお願いします\n〇用途\n　アイコン画像(3枚)\n　ヘッダー画像(3枚のアイコン画像を横に並べて1枚)\n　以前にお願いした下記リクエストと同等の想定ですが、やりやすい形に変えていただいても構いません。\n　https://skeb.jp/@kohsuke_krsk/works/29\n〇シチュエーション・構図等\n　PC、モニタ等を置いた机の前で椅子(肘置き付きのオフィスチェア)に座って何かしている様子。\n　モニタ側から見て正面の視点の想定ですので、PCやモニタ等については含めなくて構いません。\n　トラックボールを右手で操作するので、タバコと灰皿は左側で。\n〇内容\n　①前のめり気味の体制で調べものをしている様子\n　②ノリノリで音楽を聴いている様子(ヘッドフォン装着)\n　③ゲーム機でゲームをしている様子(体も一緒に動いてしまうタイプ)\n〇参考資料\n　キーボード\n　https://www.amazon.co.jp/dp/B072ZVFVHS/\n　トラックボール\n　https://www.amazon.co.jp/dp/B004QJYBAG/\n　ヘッドフォン\n　https://www.amazon.co.jp/dp/B000UPEJCU/\n　ゲームパッド\n　https://www.amazon.co.jp/dp/B0FC6QT3L4/\n〇その他参考\n　一応、キャラクター紹介の資料URLを付けておきます。\n\nhttps://uchinokoskey.com/@reima/pages/1739670206034", "created_at": "", "completed_at": ""}, {"path": "/@kohsuke_krsk/works/160", "thumbnail_src": "https://si.imgix.net/f9dc23bf/uploads/origins/f9a245b2-31ee-4216-960c-2d42193d4c27?bg=%23fff&auto=format%2Ccompres