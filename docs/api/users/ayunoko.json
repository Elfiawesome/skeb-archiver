す。この依頼は、寅年生まれの私の生意気な女の子にインスパイアされたものです。\n\nありがとう。\n\nhttps://getstickerpack.com/stickers/wild-tiger-still-baby", "created_at": "", "completed_at": ""}, {"path": "/@ayunoko/works/40", "thumbnail_src": "https://si.imgix.net/3785c401/uploads/origins/7a0c58fa-d216-4a53-8482-5b4648fe2429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ada0972acd51981f03ac062bd2eadb9", "thumbnail_srcset": "https://si.imgix.net/3785c401/uploads/origins/7a0c58fa-d216-4a53-8482-5b4648fe2429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ada0972acd51981f03ac062bd2eadb9, https://si.imgix.net/3785c401/uploads/origins/7a0c58fa-d216-4a53-8482-5b4648fe2429?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=503afbb788f031a2746a62e98e6d0e0b 2x, https://si.imgix.net/3785c401/uploads/origins/7a0c58fa-d216-4a53-8482-5b4648fe2429?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a051e5430c11f6a469fb19a2f044f9a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ayunoko/works/39", "thumbnail_src": "https://si.imgix.net/9c99384a/uploads/origins/ea25e048-3cf0-4bd2-b414-416ac9dbf0b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20794f37bfe834299e96a477a7d05579", "thumbnail_srcset": "https://si.imgix.net/9c99384a/uploads/origins/ea25e048-3cf0-4bd2-b414-416ac9dbf0b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20794f37bfe834299e96a477a7d05579, https://si.imgix.net/9c99384a/uploads/origins/ea25e048-3cf0-4bd2-b414-416ac9dbf0b6?bg=%23fff&a