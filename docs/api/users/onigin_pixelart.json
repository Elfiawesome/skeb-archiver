top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c05e8c3545fb9f6fd3197eae10e185c1 2x, https://si.imgix.net/5e7cadc4/uploads/origins/41773db3-37d2-4533-9fa5-c00a37a7ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3f868034ee24dfc989317c7788967f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@onigin_pixelart/works/4", "thumbnail_src": "https://si.imgix.net/5e699f81/uploads/origins/a00335a0-a984-4f3f-bbf4-7dfd88b6d5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ffeb2b82ee3930e38755b5a3b069e31", "thumbnail_srcset": "https://si.imgix.net/5e699f81/uploads/origins/a00335a0-a984-4f3f-bbf4-7dfd88b6d5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ffeb2b82ee3930e38755b5a3b069e31, https://si.imgix.net/5e699f81/uploads/origins/a00335a0-a984-4f3f-bbf4-7dfd88b6d5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c0bcafa1808b3f94fa00d999dbb5c00 2x, https://si.imgix.net/5e699f81/uploads/origins/a00335a0-a984-4f3f-bbf4-7dfd88b6d5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a5212883447db1680c2bb648d4c4687 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@onigin_pixelart/works/3", "thumbnail_src": "https://si.imgix.net/f6d162d7/uploads/origins/6a2f1e5c-16fe-4a7a-9127-6d4bf7565f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acc822fdbba31bd881ecfb98166057e6", "thumbnail_srcset": "https://si.imgix.net/f6d162d7/uploads/origins/6a2f1e5c-16fe-4a7a-9127-6d4bf7565f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acc822fdbba31bd881ecfb98166057e6, https://si.imgix.net/f6d162d7/uploads/origins/6a2f1e5c-16fe-4a7a-9127-6d4bf7565f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa4e7281142d510558eac08df85dc0f3 2x, https://si.imgix.net/f6d162d7/uploads/origins/6a2f1e5c-16fe-4a7a-9127-6d4bf7565f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74cfa6fd76ac354e3bfa3a612f03a3d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@onigin_pixelart/works/2", "thumbnail_src": "https://si.imgix.net/ad317111/uploads/origins/c46b0c9d-7cdf-46e1-aeec-b0be7c1406b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeca653de0cd162b53d82653b3b6ff14", "thumbnail_srcset": "https://si.imgix.net/ad317111/uploads/origins/c46b0c9d-7cdf-46e1-aeec-b0be7c1406b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeca653de0cd162b53d82653b3b6ff14, https://si.imgix.net/ad317111/uploads/origins/c46b0c9d-7cdf-46e1-aeec-b0be7c1406b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1ce70f1a9919b7c9252ceadc6f73a1f 2x, https://si.imgix.net/ad317111/uploads/origins/c46b0c9d-7cdf-46e1-aeec-b0be7c1406b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7b388c5bf98821ff5ce86677c2d4240 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのオリポケのデザインの大ファンです！伝説のオリポケのピクセルスプライトをお願いしたいです。\n\n次元の狭間に住むポケモンをデザインしてほしい。空間と時間に影響を与えることができ、霧のような粒子を噴出し、異なる次元を互いに漏出させることができます。\n多くの時間を眠って過ごし、夢を見ているため、多くの孤立した境界を作り出している。\nこのポケモンが住んでいる地域では、私たちの現実と異次元の間にある奇妙な領域に人やポケモンが連れ去られる事件が多発している。\n\nあとはあなたにお任せします！\n\nこの依頼が、あなたにご迷惑をおかけしないことを願っています。お忙しい中、本当にありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@onigin_pixelart/works/1", "thumbnail_src": "https://si.imgix.net/6ad85d6d/uploads/origins/d9236324-ac13-48ad-8a00-8ffdfdac2db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d1c02ab538e004a229fab9efea7db0b", "thumbnail_srcset": "https://si.imgix.net/6ad85d6d/uploads/origins/d9236324-ac13-48ad-8a00-8ffdfdac2db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d1c02ab538e004a229fab9efea7db0b, https://si.imgix.net/6ad85d6d/uploads/origins/d9236324-ac13-48ad-8a00-8ffdfdac2db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3812e646b169ff2af4f85ab41f24c3e8 2x, https://si.imgix.net/6ad85d6d/uploads/origins/d9236324-ac13-48ad-8a00-8ffdfdac2db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6586972ef5a7b09dd0844a6f96e7a124 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n\nPixivやTwitterに上がっているイラストがとても素敵なのでリクエストさせていただきました。\n\nゲームをするイエティをポケモン化したイラストをお願いさせていただきたいです。\n\nTwitterなどのSNSやその他Webサイトの自分のプロフィール画像として使わせていただきたいと思っています。\n\n基本的には特に希望はなく「ゲームをするイエティ」の字面から受けたイメージで自由に書いていただければと思っています（カッコいいもの、暴力的なもの、可愛いものなど何でもOKです）\n\nもし何らかの方向性があった方が描きやすいようでしたら、過去別の方に依頼して書いていただいた現在のTwitterのプロフィール画像を参考にしていただけると幸いです。\n※資料URLに画像へのURLを添付します。\n\nどうぞよろしくお願いします。\n\nhttps://pbs.twimg.com/profile_images/1174509697300254721/8N-AhlHm_400x400.jpg", "created_at": "", "completed_at": ""}]}