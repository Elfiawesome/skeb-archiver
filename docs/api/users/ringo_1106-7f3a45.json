c-a0c4-25254c2d1e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=817d1da02273454e3f88e04926f7e523, https://si.imgix.net/914b4731/uploads/origins/96890d37-0502-49ac-a0c4-25254c2d1e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91eb0d4480072fa575661186e54b8cb9 2x, https://si.imgix.net/914b4731/uploads/origins/96890d37-0502-49ac-a0c4-25254c2d1e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96bb708e9b45f7491a7e8f4fc3ca59b7 3x", "genre": "art", "nsfw": false, "body": "りんご様、こんにちは。いつも夢と未来に溢れた、キラキラしているイラストがとても大好きです。\nこの度、私の創作が最終回を迎えること、そしてりんごさんがskebを再開されるという機会が重なったため、ご依頼に至りました！\n\n\n【依頼内容】\n私の創作、「明け星学園」の主人公2人、伊勢美灯子と小鳥遊言葉のバストアップのイラスト。\nPCの壁紙にしたり、りんご様のクレジット付きでSNSでの共有をしたりしようと考えております。\n\n【キャラクターの特徴】\n・伊勢美灯子（いせみ とうこ）……薄い茶髪を後頭部でお団子。切れ長でオレンジ色の瞳。白のYシャツの上に紺色のブレザーを羽織っている。\n・小鳥遊言葉（たかなし ことは）……濃い茶髪。ロングウェーブ。毛先に濃いピンク色のグラデーション。ぱちっとした丸くて大きい赤色の瞳。深紅色のパーカーを身に着けている。\n\n立ち絵\n・https://plus.fm-p.jp/u/rin_karin2/free?id=1\n・https://plus.fm-p.jp/u/rin_karin2/free?id=2\n\nここに立ち絵を載せましたが、この立ち絵からいくつか変更してほしい部分がありまして、\n【灯子】胸元のリボンを外してお団子に付けてほしい。\n【言葉】薄紫色のパーカーを着せないでほしい。\n以上2点をよろしくお願いします。\n（参考（今表紙画像にしているもの）→https://novelup.plus/story/957704552）\n\nまた、2人が幸せそうに微笑みながら恋人繋ぎをしているというポーズでお願いします。（繋いだ手と2人の瞳が見えるようにしてくださると幸いです）\n背景は朝焼けのような淡い色合いの星空でお願いします。\n\n\n希望は以上です。書いたところ以外はりんご様にお任せします。\n希望が多くて申し訳ありません。また、初めての依頼なので何か不手際がありましたら申し訳ありません。\nお手数おかけしますが、もし余力がありましたらご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/82", "thumbnail_src": "https://si.imgix.net/9622040e/uploads/origins/0989e727-15d2-49f7-813e-ca8d78653b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d7f2e3edeb3ca2e5323ce089aa8d438", "thumbnail_srcset": "https://si.imgix.net/9622040e/uploads/origins/0989e727-15d2-49f7-813e-ca8d78653b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d7f2e3edeb3ca2e5323ce089aa8d438, https://si.imgix.net/9622040e/uploads/origins/0989e727-15d2-49f7-813e-ca8d78653b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d34281e526b820fde67c6011eea8dc7 2x, https://si.imgix.net/9622040e/uploads/origins/0989e727-15d2-49f7-813e-ca8d78653b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6137d0ab0d7206f1f56732b8d0679a4 3x", "genre": "art", "nsfw": false, "body": "リクエストばかりで申し訳ありません、他のキャラクターを描きたいのであればわかりますが．星空の中で、光るクラゲが浮かんでいるようなキャラクターを描いてほしいです！もしくは似たような感じで^_^ 手に乗せるとか、寝そべっているとかでもいいです！ポーズはお任せします。\n\nhttps://drive.google.com/drive/folders/1uyQMdgyE3gbMQcjJIDkDV9q4u_KwXBTP?usp=sharing\n\n好きなように描いてください！もし描きたくなければ、このシーンとキャラクターは無視してかまいません！", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/81", "thumbnail_src": "https://si.imgix.net/7675bfef/uploads/origins/4015a41c-21ea-477f-88e7-b605d8a1bcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db1bd492161baa8eced6668ed99df723", "thumbnail_srcset": "https://si.imgix.net/7675bfef/uploads/origins/4015a41c-21ea-477f-88e7-b605d8a1bcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db1bd492161baa8eced6668ed99df723, https://si.imgix.net/7675bfef/uploads/origins/4015a41c-21ea-477f-88e7-b605d8a1bcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25b89bcf64fbbf287a231b4fb85549f2 2x, https://si.imgix.net/7675bfef/uploads/origins/4015a41c-21ea-477f-88e7-b605d8a1bcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=651feb4ec83a5927d55a622993271b28 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/80", "thumbnail_src": "https://si.imgix.net/34406645/uploads/origins/df20765a-bf3b-4d98-9e45-bb74de172dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce350c8ae2421b2f579892df0ee08066", "thumbnail_srcset": "https://si.imgix.net/34406645/uploads/origins/df20765a-bf3b-4d98-9e45-bb74de172dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce350c8ae2421b2f579892df0ee08066, https://si.imgix.net/34406645/uploads/origins/df20765a-bf3b-4d98-9e45-bb74de172dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f1c98d0d8345151b84aa9ef9b6dc15d 2x, https://si.imgix.net/34406645/uploads/origins/df20765a-bf3b-4d98-9e45-bb74de172dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35a80ed3a3805cea141f6c73a5a6d071 3x", "genre": "art", "nsfw": false, "body": "リクエスト致します。\n\n【人物】\n○メジロアルダン\nhttps://umamusume.jp/character/mejiroardan\n○ホッコータルマエ\nhttps://umamusume.jp/character/hokkotarumae\n○ヴィブロス\nhttps://umamusume.jp/character/vivlos\n\n【衣装】\n下記リンク3つと同じ大隊長カッシーンのマスクオフ。\nhttps://www.pixiv.net/artworks/120268293 https://www.pixiv.net/artworks/120730463 https://www.pixiv.net/artworks/120745732\n\n素肌の露出は頭のみ。\n\n首元は、頭と首の境目まで黒いインナーで覆われている。\n\nへそが衣装の上から透けて見える\nhttps://www.pixiv.net/artworks/128104426\n\n金色のベルトから垂れ下がった装甲は、下記リンクのように下半身を覆っている。\nhttps://www.pixiv.net/artworks/127766476\n\n衣装の元ネタ\nhttps://kamenrider.fandom.com/wiki/Alpha_(Gotchard)#Captain_Kasshine\n\n【共通項】\n体型はボンキュッボン。胸の大きさは、それぞれ頭の大きさと同じ。描き分けが難しいようでしたら、下記リンクのように使い回しても構いません。\nhttps://www.pixiv.net/artworks/128140062\n尻尾はなし。\n\n表情は口を開けた笑顔。\nhttps://www.pixiv.net/artworks/98144450\n\nポーズは下記リンクと同じ。\nhttps://skeb.jp/@koko_cieliris/works/10\n\n右手は、下記リンクの怪人と同じ剣を持っている。\nhttps://kamenrider.fandom.com/wiki/Knight_Soldiers#Statistics\n\n全身を描いた全身絵。\n\nお忙しいところ恐れ入りますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/79", "thumbnail_src": "https://si.imgix.net/87eaed61/uploads/origins/3a41a212-d06c-49fb-9241-7393586427f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d30a678be9ddf16ad50401488b2e2331", "thumbnail_srcset": "https://si.imgix.net/87eaed61/uploads/origins/3a41a212-d06c-49fb-9241-7393586427f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d30a678be9ddf16ad50401488b2e2331, https://si.imgix.net/87eaed61/uploads/origins/3a41a212-d06c-49fb-9241-7393586427f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c676d8ee36d0677afec8ff8f2592baf 2x, https://si.imgix.net/87eaed61/uploads/origins/3a41a212-d06c-49fb-9241-7393586427f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6bd7b20d3c494d18e254a02b81905df 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！またまたリクエストすみませんでした₍₍ ◝(⁰▿⁰).^₎⟆.もしよろしければ、キャラ紹介シートを作っていただけないでしょうか？私はあなたが彼女を描く方法が大好きで、私は彼女のさらに多くの芸術を得るためにシートが大好きです^_^。シートは、カジュアルな服装や他の服装を追加するとか、何でも好きにしてください！！！\n\nいつも素晴らしい作品をありがとうございます！\n\nhttps://drive.google.com/drive/folders/1uyQMdgyE3gbMQcjJIDkDV9q4u_KwXBTP?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/78", "thumbnail_src": "https://si.imgix.net/b301dee5/uploads/origins/22f4cf9b-19ef-4647-b6da-5ecf3a54b8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916845bd15eac4fa07619299475730e7", "thumbnail_srcset": "https://si.imgix.net/b301dee5/uploads/origins/22f4cf9b-19ef-4647-b6da-5ecf3a54b8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916845bd15eac4fa07619299475730e7, https://si.imgix.net/b301dee5/uploads/origins/22f4cf9b-19ef-4647-b6da-5ecf3a54b8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c1babac1cee486669f1d026c12dbf2e 2x, https://si.imgix.net/b301dee5/uploads/origins/22f4cf9b-19ef-4647-b6da-5ecf3a54b8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=245ade54fa5ec6d4babf59cdb34eb31f 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nvtuber活動をしている恋沼ミヤ（こいぬまみや）と申します！\n新着イラストで見かけてすごく好みのイラストたちだったので速攻リクエストさせて頂きました！\n\n【キャラクター】\n▶︎ゲーム配信と歌枠がメインの元気系ギャルです！\n▶︎白髪or黒髪　オッドアイ（左目がみどり、右目が黄色）\n\n最近新衣装でチャイナドレスを実装しまして\n新しい衣装でイラストを描いてほしいです！\n\n【希望内容】\n▶︎構図はお任せなのですが\n国産高級りんご様のダークな感じのイラストがすごく好みなので\n衣装は良ければチャイナドレスのほうで書いていただければ嬉しいです！\n髪色はblackとwhiteの2種類があるのですが\nblackとWHITEで向かい合っている感じとかうれしいです！（お好みでなければ無視してください🙇）\n\n【使用予定】\nYouTubeやFANBOXでの使用、配信サムネイル、グッズでの使用、SNS、返礼品(アイコンリング、ヘッダー、ネップリ等)\n\n【その他】\n頭部や髪の毛の見切れが少ないと大変嬉しいです！\nもしご厚意で背景を描いていただけました場合、人物のみ透過でも保存できますと幸いです！\n\n恋沼ミヤの情報\nYouTube：https://www.youtube.com/@koinumamiya\nX：https://x.com/miyamyaw\n\nhttps://drive.google.com/drive/folders/1dJSAXcHpp4-MvYu_AN0PgvcSPmVxCAQJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/77", "thumbnail_src": "https://si.imgix.net/6f5963e0/uploads/origins/b2e9fc74-eba5-401a-a84c-f0fff3fe78dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69db572423d5edb60479e69802a6fccd", "thumbnail_srcset": "https://si.imgix.net/6f5963e0/uploads/origins/b2e9fc74-eba5-401a-a84c-f0fff3fe78dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69db572423d5edb60479e69802a6fccd, https://si.imgix.net/6f5963e0/uploads/origins/b2e9fc74-eba5-401a-a84c-f0fff3fe78dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d44632d50d057fb8d046c446bf66de2 2x, https://si.imgix.net/6f5963e0/uploads/origins/b2e9fc74-eba5-401a-a84c-f0fff3fe78dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d3b6093b2b92256db39d798feb8675e 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n女の子二人のキャラデザお願いしたいです！\n\nライオンモチーフの子、イルカモチーフの子、でお願いしたいです！\n\n一人はにまあって顔をよくするマイペースな子でもう一人はその子のこと大好きで少しメンヘラな女の子\n\n雰囲気は\nピエロ×何かでお願いしたいです！\nメイドとか、アイドルとか、サバイバーとか、忍者とかでも、何でも構いません！\n\n髪型は2つ結びでお願いしたいです！\nどこか2つに結んでいれば後ろ髪などおろしていても構いません！\n\nピアスの空いている位置はこちらがわからみて左が軟骨一つ、耳たぶ2つ、右が耳たぶ1つ\n\n好きなものは\n露出の多い衣装、薔薇、リボン、ベルト、ぬいぐるみ、ゴーグル、手袋またはグローブ\n武器など持つ場合は2個持ち\n\n色は薄灰×赤（白黒）\n\nゴーグルと全部でも一部でも構わないので空いている手袋、またはグローブをしていてほしいです！両手、片手もまかせます！\n\nメンヘラな子がマイペースな子のこと好きすぎて寄せている感じでお願いしたいです！\n\nできたらミニキャラみたいな相棒もお願いしたいです\n\nご検討いただけると幸いです", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/76", "thumbnail_src": "https://si.imgix.net/9fbb657e/uploads/origins/46fffd66-fcc0-415b-9c98-5ec23aeb3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2568bd882eb59116067021e9467f833", "thumbnail_srcset": "https://si.imgix.net/9fbb657e/uploads/origins/46fffd66-fcc0-415b-9c98-5ec23aeb3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2568bd882eb59116067021e9467f833, https://si.imgix.net/9fbb657e/uploads/origins/46fffd66-fcc0-415b-9c98-5ec23aeb3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f3d0beeb724c359b9461c412bb90525 2x, https://si.imgix.net/9fbb657e/uploads/origins/46fffd66-fcc0-415b-9c98-5ec23aeb3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff39489ce25dcbc9994950d0a25e4513 3x", "genre": "art", "nsfw": false, "body": "またまたRingoです！あなたが描いてくれた女の子のデザインをもっとリクエストしたかったんです。彼女のデザインの続きを描いていただけたら嬉しいです！どのような服装やデザインをイメージしているのか気になります＾＾。一人で描いてもいいですし、男性OCと一緒に描いてもいいです！また、両方描いてくださる場合は、依頼を送り返していただき、お値段を上げさせていただきます！ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ZJieXnrSLmhTbcjCz2JDV-S0iXzAr6Pr?usp=sharing\nhttps://drive.google.com/drive/folders/1U-yBKj921uZpOyz22DyOxzZNriJ7XUaz?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ringo_1106/works/75", "thumbnail_src": "https://si.imgix.net/fa8f6fed/uploads/origins/f6e3e971-bab9-4678-89c4-cda8b0777a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7120e3d05028a10203d8dd7786b80e24", "thumbnail_srcset": "https://si.imgix.net/fa8f6fed/uploads/origins/f6e3e971-bab9-4678-89c4-cda8b0777a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7120e3d05028a10203d8dd7786b80e24, https://si.imgix.net/fa8f6fed/uploads/o