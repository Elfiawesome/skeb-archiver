15bb126475cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fdf7ec61e3163ea9ec6b92188ae9b54", "thumbnail_srcset": "https://si.imgix.net/d7f80f58/uploads/origins/44ce67a7-c9ab-4b76-b029-15bb126475cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fdf7ec61e3163ea9ec6b92188ae9b54, https://si.imgix.net/d7f80f58/uploads/origins/44ce67a7-c9ab-4b76-b029-15bb126475cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1125970bbeadb15261fd632e054ec24b 2x, https://si.imgix.net/d7f80f58/uploads/origins/44ce67a7-c9ab-4b76-b029-15bb126475cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1abd3a53ae5dd366ac814ea8129ba2e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/457", "thumbnail_src": "https://si.imgix.net/ba68374c/uploads/origins/0e8e1fc6-f200-4665-9627-17bbfaf870a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0495e5ce56132a554b660aefc62863b", "thumbnail_srcset": "https://si.imgix.net/ba68374c/uploads/origins/0e8e1fc6-f200-4665-9627-17bbfaf870a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0495e5ce56132a554b660aefc62863b, https://si.imgix.net/ba68374c/uploads/origins/0e8e1fc6-f200-4665-9627-17bbfaf870a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c5e76d7fdffa206fe8c7fee82b1baee 2x, https://si.imgix.net/ba68374c/uploads/origins/0e8e1fc6-f200-4665-9627-17bbfaf870a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a7961515ee600154860b9997cb5e816 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/456", "thumbnail_src": "https://si.imgix.net/319384c4/uploads/origins/c31a07a8-23b4-4e2b-a012-df829aa4ff22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29445ebf141af27fc25fcdca5d18700e", "thumbnail_srcset": "https://si.imgix.net/319384c4/uploads/origins/c31a07a8-23b4-4e2b-a012-df829aa4ff22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29445ebf141af27fc25fcdca5d18700e, https://si.imgix.net/319384c4/uploads/origins/c31a07a8-23b4-4e2b-a012-df829aa4ff22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8af483c71a1b50861b78be1d71daa190 2x, https://si.imgix.net/319384c4/uploads/origins/c31a07a8-23b4-4e2b-a012-df829aa4ff22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38db2e2fe23dfaf612fe609e589c659d 3x", "genre": "art", "nsfw": false, "body": "うにたる様\nお世話になっております「きんめだい」です。\n2回目のリクエストです、その節は大変素敵なイラストありがとうございました。\n\n《依頼内容》\n・キャラクター\nきんめだい。頭の魚が本体で（イメージぴょん吉）女の子は共生仲間のエーちゃんです。\n・ポーズ、表情お任せ。\n・イメージ\nチョコレート、プレゼント。\n・服装は新衣装の服か、アレンジしたメイド服でお願いします。\n（新衣装のジッパーの上げ下げもご自由にどうぞ）\n頭の魚は一回目のようにグッズにして頂いてもかまいません。\n・XやYouTubeなどのSNS投稿、FANBOX、グッズ化で使用させていただきたいです。\n・表情、お任せいたします。\n・ファイル形式PSD/PNG\n・可能でしたら背景レイヤーとキャラクターレイヤーを分けて頂けると助かります。\n\nそれでは何卒よろしくお願いします。\n\n参考資料\nきんめだい（新衣装）\nhttps://www.dropbox.com/scl/fi/rzq4wgt0y9ex95rsn4yc7/_.png?rlkey=iac5qc9p5ky2o7obhcfgs5ub8&st=9g693twn&dl=0\n\nフード無し（＋魚）\nhttps://www.dropbox.com/scl/fi/ptftcldrypnhtkuy90fga/84.png?rlkey=zby8k2wla9727d8tfxld3chqf&dl=0\nhttps://www.dropbox.com/scl/fi/7n7ncekq9u31etl6izl05/1823f43d4273c9b4.png?rlkey=9ucbtjvoipj4prgdlnegip46h&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/455", "thumbnail_src": "https://si.imgix.net/b87abfc6/uploads/origins/94695db2-b518-4a0a-bb9f-a7ccbf34eb28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495e68293153b8ea098a7f88cd505213", "thumbnail_srcset": "https://si.imgix.net/b87abfc6/uploads/origins/94695db2-b518-4a0a-bb9f-a7ccbf34eb28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495e68293153b8ea098a7f88cd505213, https://si.imgix.net/b87abfc6/uploads/origins/94695db2-b518-4a0a-bb9f-a7ccbf34eb28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e294edfcc2f674683f7a7ae3206adfde 2x, https://si.imgix.net/b87abfc6/uploads/origins/94695db2-b518-4a0a-bb9f-a7ccbf34eb28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9161880d1831591027500dfa46031224 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです！\n前黒雪姫を依頼した者です！\nもしよろしければ、また依頼してもよろしいでしょうか？\n\n詳細は以下の通りです：\nキャラ：黒雪姫\n衣装：制服\n内容：抱き枕風イラスト居ちまいいただければ幸いです！他の内容はお任せいたします！\n\n以上、何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/454", "thumbnail_src": "https://si.imgix.net/3042c31f/uploads/origins/59f5b42f-d00d-4763-b9b6-e38f6740d7fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f4cad3f6d774f87bb4a41398695174a", "thumbnail_srcset": "https://si.imgix.net/3042c31f/uploads/origins/59f5b42f-d00d-4763-b9b6-e38f6740d7fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f4cad3f6d774f87bb4a41398695174a, https://si.imgix.net/3042c31f/uploads/origins/59f5b42f-d00d-4763-b9b6-e38f6740d7fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7669c54e5fa12933f02c16cd27943d6 2x, https://si.imgix.net/3042c31f/uploads/origins/59f5b42f-d00d-4763-b9b6-e38f6740d7fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09dde2af39632514963a85964304b875 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n早速ですがリクエストさせて頂きます。内容としとは私が過去にpixivリクエストにて制作頂いた小説作品をモチーフにしたイラストでございます。勿論元作者様からイラスト化の許可は以前頂いております。\n\nでは以下が詳細となります。\n<元小説>\nhttps://www.pixiv.net/novel/show.php?id=16377501\n\n<キャラクター>\n・園神凜祢\n\n<シチュエーション>\n・凜祢がエロ下着を着てカフェで接客している\n\n<服装>\n・黒色のオープンブラとオープンショーツ、ミニスカート(オープンブラのデザインはカップが小さいマイクロビキニタイプではなく普通のブラジャーからごっそりカップを取り除いたようなデザイン。※イメージ:https://www.pixiv.net/artworks/92878327\n\n<構図>\n・イラスト中央に、こちらを向いている凜祢の膝から上を描いて下さい\n・ミニスカートの裏面にメニュー表があり、凜祢がスカートをたくし上げている\n\n<表情>\n・眉を八の字にして恥ずかしそうな表情\n・もしよろしければ、快楽堕ちしてハート目になって膣から愛液、乳首から母乳を垂らしている差分も頂けると嬉しいです\n\n\n以上でございます。どうかご検討のほどよろしくお願い致します。\n\nhttps://twitter.com/qqrcrcgqaquaex1/status/1494240786321649664?s=46&t=MiZ-govJzAXeRgAJ4HIxLg", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/453", "thumbnail_src": "https://si.imgix.net/4d406a12/uploads/origins/d84a257c-53bc-404a-9a15-37ccbf66290e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=befae37ad21f35b8cc94f516480f97c1", "thumbnail_srcset": "https://si.imgix.net/4d406a12/uploads/origins/d84a257c-53bc-404a-9a15-37ccbf66290e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=befae37ad21f35b8cc94f516480f97c1, https://si.imgix.net/4d406a12/uploads/origins/d84a257c-53bc-404a-9a15-37ccbf66290e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6009e594687b0cc1003e2ae8dc986dc 2x, https://si.imgix.net/4d406a12/uploads/origins/d84a257c-53bc-404a-9a15-37ccbf66290e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02ec9d84f9fa3c426fff944ec9b98bb1 3x", "genre": "art", "nsfw": true, "body": "前回、黒い双葉シャロちゃんのイラストを描いていただきありがとうございます。\n\n今回もイラストを依頼させていただきます。\n\n前回に引き続き、黒いシャロちゃんのイラストを描いていただきたいのですが、今回はがっつりえっちなやつをお願いします。\n\nシチュエーションは黒いシャロちゃんとえっちしてる感じでお願いしたく、入れる前、プレイ中、中出し差分があると嬉しいです。…出来れば脱衣ver.も…\n\n大まかなシチュエーションは上記の通りで、あとの部分はおまかせします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/452", "thumbnail_src": "https://si.imgix.net/9821cf03/uploads/origins/103d4e7d-040e-4826-abfc-11b1443078ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c55b0ed1f19777bcb07df3410b58d147", "thumbnail_srcset": "https://si.imgix.net/9821cf03/uploads/origins/103d4e7d-040e-4826-abfc-11b1443078ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c55b0ed1f19777bcb07df3410b58d147, https://si.imgix.net/9821cf03/uploads/origins/103d4e7d-040e-4826-abfc-11b1443078ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9178243009c215aec4dec67caa3fa78 2x, https://si.imgix.net/9821cf03/uploads/origins/103d4e7d-040e-4826-abfc-11b1443078ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38098d67f608708f554ad08493aed446 3x", "genre": "art", "nsfw": false, "body": "うにたるさん、こんばんは\n前回は決意を秘めた神通先生を描いて頂きありがとうございました\n今回も、下記のような内容で神通先生を描いて頂けないでしょうか\n\n【衣装】\nhttps://skeb.jp/@uni_tal/works/318\n↑\n以前描いて頂いた、こちらの長門先生と同じ香取型練習巡洋艦の制服を着用した、教導艦modeの神通先生を描いて頂きたいです\n頭部以外の艤装は無しでお願いします\n頭部の艤装は改二（https://drive.google.com/file/d/179GmFJpLCkktKcLwv6NREH6-wpZUT7Ta/view?usp=sharing）の鉢巻とリボンでお願いします\n\n【構図】\n候補生（セリフ以外は描写なしで結構です）に対して厳しい事を言っている表情・振る舞いで描いて頂けないでしょうか\n\n\n【セリフ】\n神通先生\n「いい？電探で夜も昼の視界に匹敵する情報が得られる今、肉薄しての魚雷戦は犠牲だけが多く戦果はわずかなもの。私のような水雷戦を主任務とした艦が、後方で教導艦任務に就ける理由にもなっている事まで説明しないといけないかしら？」\n\n候補生\n「ですが先生、酸素魚雷の威力をみすみす失うのはあまりにも惜しいです。接近が無理ならば、長射程そのもの活かした戦法や〝魚雷を敵艦まで誘導する手段〟の開発に重点を置くべきではないでしょうか」\n\n以上のようなオーダーでお願いしたいです\nおかしな部分含め、必要と判断されたアレンジはぜひお願いいたします\n今回の神通先生も、うにたるさんに描いて頂けるのをとても楽しみにしております\nどうぞよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/451", "thumbnail_src": "https://si.imgix.net/3713abce/uploads/origins/c41b85ee-d025-4875-bb02-c99ae0f60a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61662a96a82b748d366079cea7ffac83", "thumbnail_srcset": "https://si.imgix.net/3713abce/uploads/origins/c41b85ee-d025-4875-bb02-c99ae0f60a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61662a96a82b748d366079cea7ffac83, https://si.imgix.net/3713abce/uploads/origins/c41b85ee-d025-4875-bb02-c99ae0f60a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccfcc342963cf8e54c0158913f62d558 2x, https://si.imgix.net/3713abce/uploads/origins/c41b85ee-d025-4875-bb02-c99ae0f60a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ede9925f36e8e57c9cb7e88b76179e2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/450", "thumbnail_src": "https://si.imgix.net/627dad0c/uploads/origins/6078f91d-1579-4ca7-9e67-80e7e149631f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c6db60eb55b86240b4f98bf19535699", "thumbnail_srcset": "https://si.imgix.net/627dad0c/uploads/origins/6078f91d-1579-4ca7-9e67-80e7e149631f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c6db60eb55b86240b4f98bf19535699, https://si.imgix.net/627dad0c/uploads/origins/6078f91d-1579-4ca7-9e67-80e7e149631f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=829ace052c3adc5e0ab6b380958ac2c6 2x, https://si.imgix.net/627dad0c/uploads/origins/6078f91d-1579-4ca7-9e67-80e7e149631f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2176ac1c29e81cf5fc0c7496fd86c2b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/449", "thumbnail_src": "https://si.imgix.net/402dba77/uploads/origins/827a91ff-d1c4-4431-8601-94acaeaf6fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c75bda3092ede32f6abbcc212b48e248", "thumbnail_srcset": "https://si.imgix.net/402dba77/uploads/origins/827a91ff-d1c4-4431-8601-94acaeaf6fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c75bda3092ede32f6abbcc212b48e248, https://si.imgix.net/402dba77/uploads/origins/827a91ff-d1c4-4431-8601-94acaeaf6fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a6b3a214083617a77b62ebaab893098 2x, https://si.imgix.net/402dba77/uploads/origins/827a91ff-d1c4-4431-8601-94acaeaf6fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28452dfac5aae07e925d17dcd8585330 3x", "genre": "art", "nsfw": true, "body": "初めましてうにたるさん\nうちの子をこよなく愛するkaintsと申します。\nこちらのイラストがとても良くて私もこういうイラストが欲しいなと思い、依頼します。\nhttps://skeb.jp/@uni_tal/works/386\n\n・キャラ\n姫騎士アリス（龍紋の姫騎士）\nhttps://drive.google.com/drive/u/1/folders/1_c6nOonEW_KF2s3yrOSaXZmc4WmKx2QS\n\n世界を救う勇者パーティの一員、元勇者くんとは幼馴染みで彼のことが大好きだったチョロイン\n自身のプロポーションに自身満々で皆からも好かれるお姫様\n頭のミニチュア王冠は元勇者くんがくれた大切なものだった\n勇者を選ぶ能力を持っており、龍紋の英雄を新たな勇者様に選び、物語は正規ルートから外れてしまった。\n\n竿役・・・龍紋の英雄（新勇者）\nアリスの能力を知っており彼女を自身にだけ媚びるメスへと堕とした\n最前線の街で最も活躍しており、圧倒的な強さと龍のように強い雄の魅力を持つ男\n周囲からの評判は最悪だが強さゆえに誰も手出しできない。\n傭兵団「龍紋の乙女」を率いており、優秀なメスを絶賛引き抜き中\n堕としたメスに龍紋を刻み所有物アピールをしている。\n\n・衣装\n龍紋の姫騎士衣装（満足一本氏）\n強大な龍の素材をふんだんに使用した最上位装備品\n龍紋の乙女所属の国宝級鍛冶師が英雄様を想い、心を込めて仕立てた。\n艶めかしい光沢を放ち、着用者には彼の隣に相応しい淫靡で強いメスとしての自信を持たせるデザインとなっている。\n\n※姫騎士衣装、龍紋の姫騎士衣装を考慮しつつであれば衣装を多少アレンジして頂いてもかまいません。\n\n・依頼イラスト\n龍紋の姫騎士衣装のアリスが嗜虐的な笑みな感じの表情で双剣を構えているイラスト\n及び\n上記イラストのコスプレ衣装版イラスト（タトゥー＆表情差分イラスト）\n\nコスプレ衣装版・・・ゲームのスキン変更みたいな感じ\n龍紋の英雄に堕ちず、勇者くんと相思相愛の旅をしている正規ルートでの衣装変更\nタトゥーは無く、快活で親しみやすいお転婆お姫様\n優しい笑みを浮かべている\n\n\n双剣は両刃でモチーフは龍、魔剣っぽいイメージ\n色は衣装と合わせた赤紫系が良いかなと思いますが素人感覚なのでお任せします。\n二本とも同じものでOK\n\n特にポーズが思い浮かびませんのでお任せします。\nポーズに悩まれた場合は永龍氏姫騎士アリスの立ち絵イラストに寄せたものを頂ければと思います。\n\n\n以上、長くなってしまいましたが\nうにたるさんのイラストでうちの子を描いて頂けないでしょうか！\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/448", "thumbnail_src": "https://si.imgix.net/e75c101f/uploads/origins/a55efe66-9d28-42b4-a6d7-96e12136e99c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c7f81f8002962fe95873494eaca7cc1", "thumbnail_srcset": "https://si.imgix.net/e75c101f/uploads/origins/a55efe66-9d28-42b4-a6d7-96e12136e99c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c7f81f8002962fe95873494eaca7cc1, https://si.imgix.net/e75c101f/uploads/origins/a55efe66-9d28-42b4-a6d7-96e12136e99c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14a77d43b7752c73bf095150f74ca739 2x, https://si.imgix.net/e75c101f/uploads/origins/a55efe66-9d28-42b4-a6d7-96e12136e99c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32ad60ae50e0a68d22c3885a115ed356 3x", "genre": "art", "nsfw": true, "body": "とても綺麗な裸体の女の子を描かれているのを拝見いたしましてリクエストよろしくお願いします\n\n描いて欲しいのは生駒彩未というキャラクターです\n\nえっち後ベッドの上で仰向けの状態\n\n性器から精液を垂れながし（胸、お腹にも少量の精液をお願いします）好きな男性とひとつになれた嬉しさ愛おしいさが溢れた表情\n\nYシャツとリボンのみで全裸でお願いします\n\n資料が少なく申し訳ないですがご検討よろしくお願いします\n\nhttps://x.com/BRSUN_game/status/1590267959183745024", "created_at": "", "completed_at": ""}, {"path": "/@uni_tal/works/447", "thumbnail_src": "https://si.imgix.net/b96ac372/uploads/origins/22867686-f954-411d-be55-58822f3f8b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=372ca57f4e2ab1340f61cb4366dc5f68", "thumbnail_srcset": "https://si.imgix.net/b96ac372/uploads/origins/22867686-f954-411d-be55-58822f3f8b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s