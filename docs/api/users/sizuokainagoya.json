Rv7\n\t•\t2人目\nhttps://drive.google.com/drive/folders/116XCpvOpobiTFkShUgx1SJNVs97M4eXR\n\n構図やポーズなどの詳細は、静岡いなご屋様のご自由な発想にお任せしたいと考えております。\n\n\n\n◾️イラストの使用用途について\n\t•\tSNSでのアイコン\n\t•\tiPhoneの壁紙\n\t•\t自分用に印刷し、自宅での鑑賞　など\n\n背景透過のキャラクター単体イラスト（透過PNGまたはPSDデータ）で納品いただけますと、大変ありがたいです。\n\n\n\n金額や資料に不備がある場合は、お手数ですがご指摘いただけますと幸いです。\n\nこのたびご縁があり、静岡いなご屋様に描いていただけましたら光栄です。ご検討いただけましたら嬉しいです！\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sizuokainagoya/works/273", "thumbnail_src": "https://si.imgix.net/7ecc0652/uploads/origins/16cb9b48-2582-4615-ac13-683ed7fef2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f561916a2fe53287bdc8232e42a352a8", "thumbnail_srcset": "https://si.imgix.net/7ecc0652/uploads/origins/16cb9b48-2582-4615-ac13-683ed7fef2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f561916a2fe53287bdc8232e42a352a8, https://si.imgix.net/7ecc0652/uploads/origins/16cb9b48-2582-4615-ac13-683ed7fef2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=684ca25362bef281de0759f8ea865e7c 2x, https://si.imgix.net/7ecc0652/uploads/origins/16cb9b48-2582-4615-ac13-683ed7fef2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0a5d9d4f8fb578855707b42ec385793 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sizuokainagoya/works/272", "thumbnail_src": "https://si.imgix.net/0f6a63c0/uploads/origins/5ad405b4-54f9-4960-9aa6-0ecd29a7c305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7f8993e4eab20d827ebc1b4b7c02037", "thumbna