d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad72054c474eb1c1316467a704b4ce67 2x, https://si.imgix.net/6cb4a4bc/uploads/origins/14deadad-e056-4e02-bc26-398c66d5f82e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6a439d674d02cb8e95832309f23457 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@m_oduku/works/44", "thumbnail_src": "https://si.imgix.net/b673783e/uploads/origins/76731e6d-a84c-474c-af8a-ed2f29930181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae19e2e78a9904d319735512fd00f4d", "thumbnail_srcset": "https://si.imgix.net/b673783e/uploads/origins/76731e6d-a84c-474c-af8a-ed2f29930181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae19e2e78a9904d319735512fd00f4d, https://si.imgix.net/b673783e/uploads/origins/76731e6d-a84c-474c-af8a-ed2f29930181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=804474aeec1461f3c46f5c0c979722bd 2x, https://si.imgix.net/b673783e/uploads/origins/76731e6d-a84c-474c-af8a-ed2f29930181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c60d18029517ad858daf7eb90cc379a 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターをあなたのスタイルで描いていただけませんか？どんな風に描いてもいいし、服装を変えるのも自由です。ありがとうございます！\n\nhttps://drive.google.com/drive/u/2/folders/1F6mtB-3vQf4QDydUK13sItKcB4Dzu5dd", "created_at": "", "completed_at": ""}, {"path": "/@m_oduku/works/43", "thumbnail_src": "https://si.imgix.net/a4c1c7bc/uploads/origins/5614bbd0-7e15-46f5-99cc-57b1a22928a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cb345b2a7087fe57517b375b2c86f7b", "thumbnail_srcset": "https://si.imgix.net/a4c1c7bc/uploads/origins/5614bbd0-7e15-46f5-99cc-57b1a22928a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cb345b2a7087fe57517b375b2c86f7b, https://si.imgix.net/a4c1c7bc/uploads/origins/5614bbd0-7e15-46f5-99cc-57b1a22928a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b064225f2dc764eaa35880a634806665 2x, https://si.imgix.net/a4c1c7bc/uploads/origins/5614bbd0-7e15-46f5-99cc-57b1a22928a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e279654268568efd78f112ace3a580ae 3x", "genre": "art", "nsfw": false, "body": "初めまして、リクエスト失礼します。\nオリジナルキャラクターのイラストをお願いできますか？\n\n【ご依頼内容】\n\nキャラクター: 八尾（単体）または八尾ともう一人「Nok」\nテーマ: 互いに賞金稼ぎであることを知りつつも探り合い、緊張感のある駆け引きをしながら、どこか曖昧な好意が漂う雰囲気を表現していただければ嬉しいです。\nまた、日式怪談のような要素を取り入れていただけると大変嬉しく思います。\n\n【衣装について】\n参考URLの中の衣装からお好きなものを選んでいただいて構いません。\nまた、新たにデザインしていただくことも歓迎いたします。\n\n詳細な指定はございませんので、先生のセンスにお任せします。\n\n【納品データについて】\n\n以下の形式でご対応いただけますと幸いです。\n\t•\t透過PNGまたはPSDファイル（キャラクターのみ）\n\t•\t宛名「八尾」とサインをPSDレイヤーで切り替え可能な形式\n\n用途\n\t•\tSNSアイコンやヘッダー\n\t•\tスマホの待ち受け、個人で楽しむ範囲での印刷\n\n参考画像が不明瞭、またはどの画像を基準にするかの説明が無い場合は、自由に描いていただいて問題ございません。\n\nhttps://www.tumblr.com/nokonkk7/720746299028389888", "created_at": "", "completed_at": ""}, {"path": "/@m_oduku/works/42", "thumbnail_src": "https://si.imgix.net/600af57e/uploads/origins/2af9d2bd-62e6-473b-82ae-e3158f87babd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc9d7b8534fcbc13291cb79552895ea1", "thumbnail_srcset": "https://si.imgix.net/600af57e/uploads/origins/2af9d2bd-62e6-473b-82ae-e3158f87babd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc9d7b8534fcbc13291cb79552895ea1, https://si.imgix.net/600af57e/uploads/origins/2af9d2bd-62e6-473b-82ae-e3158f87babd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c93702e1b7269ec624da67b014f1501 2x, https://si.imgix.net/600af57e/uploads/origins/2af9d2bd-62e6-473b-82ae-e3158f87babd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c69b61e3d40aad7f0a5c0ecf01f3eaa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生。\n\n先生の作品はどれもとても好きです。今回は、僕のOCを描いてもらおうと思います。\n最近、新しいOCができました。 アリスという地雷＋病弱な自傷キャラです。彼女のイラストを描いてほしい。\n\n以下、キャラクター説明です：\n名前：アデライ／体型：159.5cm、Dカップ。\n詳細\n- 口がなく、無表情な妹！不安定になると自傷行為をする。(モルート妹)\n- 左目はカラーでガラス玉（詳細2）、右目は赤で下に3つの点がある（詳細1）。髪は銀白色。\n- 白いスカートを脱ぐと赤いバニーガールのジャンプスーツ。\n- 右側には蝶が描かれた溶けた時計がある（詳細3、詳細4）。\n- 体にはたくさんの傷がある。\n- 影はウサギの形をしている。\n- デザインの全体的なコンセプトは、ウサギの女の子＋純白＋シャープな感じ（ナイフとハサミ）であり、メルヘンチックなスタイル（白＋リボンの花柄＋キャンディ）とモリュート耽美スタイルのシャープで危険な感じを組み合わせている。\n\n絵柄の好みやキャラクターの理解度に合わせて、自由に遊んでください。ドレスのハサミは状況に応じて適当に外していただいて構いません。\nご配慮ありがとうございました！皆様のご多幸とご健勝を心よりお祈り申し上げます。\n\nはるか\n\nhttps://imgur.com/a/Wuv7zOU", "created_at": "", "completed_at": ""}, {"path": "/@m_oduku/works/41", "thumbnail_src": "https://si.imgix.net/1e492b16/uploads/origins/44b830c7-ed0d-4010-8ad3-c4888c91fae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2682c122a8c44cb284387d909c449cbf", "thumbnail_srcset": "https://si.imgix.net/1e492b16/uploads/origins/44b830c7-ed0d-4010-8ad3-c4888c91fae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2682c122a8c44cb284387d909c449cbf, https://si.imgix.net/1e492b16/uploads/origins/44b830c7-ed0d-4010-8ad3-c4888c91fae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd0ab30cda47631b99aa62cde20f234d 2x, https://si.imgix.net/1e492b16/uploads/origins/44b830c7-ed0d-4010-8ad3-c4888c91fae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5149ddd705e846fb821b73e0f8ce0a0f 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nVTuber準備中の夜月ねこと申します。\nmoduku様のダークな雰囲気のイラストがとても素敵でこの度依頼させていただきました。 \n\n衣装は資料を参考にしていただけるとありがたいです…！\n構図やポーズはmoduku様の好きに描いていただけると嬉しいです…！！\n 横幅に対して髪や腕が途切れない形、縦幅に対して頭のてっぺんが途切れない形ですとありがたいです！\n\n【キャラクター設定】\n夜とねこが大好きなねこ。\n普段は耳を出すのが恥ずかしくて髪の毛で耳を隠している。\n後ろにはしっぽがあり、猫口、実は八重歯が生えています。\nお供とは仲が良くよく同じ動きをしている。\n\n【使用用途】 \nSNSでの投稿、動画への使用  、グッズ化など商用利用等も考えております。(こちらダメな場合教えていただけるとありがたいです！)\n\n背景透過と背景込みを分けていただけると大変助かります…！！\n\nお忙しいところ申し訳ございませんが、ご検討いただけますと幸いです。 \nよろしくお願い致します！\n\nhttps://birdfile.jp/4JEQkoVVI8M3sI8/file", "created_at": "", "completed_at": ""}, {"path": "/@m_oduku/works/40", "thumbnail_src": "https://si.imgix.net/d5fc232f/uploads/origins/6aebe5f6-41ac-418a-96d5-a052515a885c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dbd7934499669c9dd986be6f2cee9ef", "thumbnail_srcset": "https://si.imgix.net/d5fc232f/uploads/origins/6aebe5f6-41ac-418a-96d5-a052515a885c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dbd7934499669c9dd986be6f2cee9ef, https://si.imgix.net/d5fc232f/uploads/origins/6aebe5f6-41ac-418a-96d5-a052515a885c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d16be3286cfc76ab227f7d4f4c510611 2x, https://si.imgix.net/d5fc232f/uploads/origins/6aebe5f6-41ac-418a-96d5-a052515a885c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc44d8c5a337f0e016ccd17169e5dcd2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@m_oduku/works/39", "thumbnail_src": "https://si.imgix.net/6c452161/uploads/origins/596c3b50-106f-4bf4-ba64-ac0e5063bb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=650bfad761c09fc265e16ecc0faba51f", "thumbnail_srcset": "https://si.imgix.net/6c452161/uploads/origins/596c3b50-106f-4bf4-ba64-ac0e5063bb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=650bfad761c09fc265e16ecc0faba51f, https://si.imgix.net/6c452161/uploads/origins/596c3b50-106f-4bf4-ba64-ac0e5063bb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1b7bed3ab712a360922a7a5e2c44119 2x, h