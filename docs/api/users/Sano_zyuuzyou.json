307b-336d-4e82-a3b1-1c4d7183f3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=667856cebfc52fa01df5733c9755f045 2x, https://si.imgix.net/ea30ee09/uploads/origins/08cb307b-336d-4e82-a3b1-1c4d7183f3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd2d9cb9be396ea3cf7545f7a7525fc3 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました！またリクエスト失礼します。\nささささんのイロハがとても良かったのでまたイロハのえっちな\nイラストをお願いします。\n前回は和姦系だったので今回は無理やり系をお願いします。\n\nキャラクター\nブルーアーカイブ　棗イロハ\n\n服装\nデフォルトの制服で脱がし具合はお任せします\n\nシチュエーション\n変態おじさん達とえっちする羽目になってしまう\n複数プレイでお願いします\n\n体位や構図\n竿役複数の３P・４Pえっちでお願いします\n具体的な体位や構図はお任せします\n対面座位は別の機会にリクエストさせて頂くと思うので避けて頂けると\n乗り気ではない渋々えっちな雰囲気で\nまたささささんの汁表現好きなので後半は汗だくな感じでお願いします\n\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Sano_zyuuzyou/works/25", "thumbnail_src": "https://si.imgix.net/0a2cbdae/uploads/origins/9f1e314b-6c9b-41f9-ba29-ab08ff5ed1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47edc0842c12c1c020433223e94aced4", "thumbnail_srcset": "https://si.imgix.net/0a2cbdae/uploads/origins/9f1e314b-6c9b-41f9-ba29-ab08ff5ed1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47edc0842c12c1c020433223e94aced4, https://si.imgix.net/0a2cbdae/uploads/origins/9f1e314b-6c9b-41f9-ba29-ab08ff5ed1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bca5bb5a1604de3c985f95326e5212f 2x, https://si.imgix.net/0a2cbdae/uploads/origins/9f1e314b-6c9b-41f9-ba29-ab08ff5ed1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97aeb901a166479cf4efe6083c8ae996 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました！またリクエスト失礼します。\nブルーアーカイブの棗イロハのえっちイラストをお願いします\n\nキャラクター\nブルーアーカイブ　棗イロハ\n\n服装\nデフォルトの制服で脱がし具合はお任せします\n\nシチュエーション\n前回何かめんどうな気配を感じていたイロハがどうなるのか\nとても気になったのでシチュエーションはお任せで\nささささんのえっちなイロハをお願いします！\n獣やふたな等は抵抗ありますがそれ以外はブルアカの地雷はありません\n\n体位や構図\n体位や構図はお任せします\n\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Sano_zyuuzyou/works/24", "thumbnail_src": "https://si.imgix.net/452f4c70/uploads/origins/5c0e707a-2911-4236-b428-25dd7b3dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185c55bbd69432e696ecb14e70ad0faf", "thumbnail_srcset": "https://si.imgix.net/452f4c70/uploads/origins/5c0e707a-2911-4236-b428-25dd7b3dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185c55bbd69432e696ecb14e70ad0faf, https://si.imgix.net/452f4c70/uploads/origins/5c0e707a-2911-4236-b428-25dd7b3dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=661b1de5d98bfea531baac64fa849436 2x, https://si.imgix.net/452f4c70/uploads/origins/5c0e707a-2911-4236-b428-25dd7b3dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b355baa7448d57e03895f6d401601572 3x", "genre": "art", "nsfw": true, "body": "何度も何度も黒音ちゃんを描いていただいてありがとうございます！\nまたまたリクエストさせてください！\nよろしくお願いいたします。\nーーーーーーーーー\n今回も黒音ちゃんのえっちなイラストをお願いしたいです。\n公衆トイレに連れ込まれて襲われちゃうシチュをお願いしたいです。\n最後に妊娠検査薬を使われて……\nーーーーーーーーー", "created_at": "", "completed_at": ""}, {"path": "/@Sano_zyuuzyou/works/23", "thumbnail_src": "https://si.imgix.net/c78847f6/uploads/origins/0850862e-3472-4e6d-849d-d1cfe4fabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30138f2a568959db0e5e3083333a5c2", "thumbnail_srcset": "https://si.imgix.net/c78847f6/uploads/origins/0850862e-3472-4e6d-849d-d1cfe4fabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30138f2a568959db0e5e3083333a5c2, https://si.imgix.net/c78847f6/uploads/origins/0850862e-3472-4e6d-849d-d1cfe4fabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0dd9a3f26e9837e0f60decad51aa644 2x, https://si.imgix.net/c78847f6/uploads/origins/0850862e-3472-4e6d-849d-d1cfe4fabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cafd44d88abc1cfeebc37ba4130facb 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました！またリクエスト失礼します。\n前回のススーロとてもえっちで良かったので同じシチュで今度は\n別の体位でいっぱい気持ちよくなっているススーロをお願いします。\n\nキャラクター\nアークナイツ　ススーロ\n\n服装\nデフォルト衣装でお願いします\n\nシチュエーション\n患者達の性処理をしてくれているシチュ\n\n体位や構図\n前とお尻に挿入れられている二穴えっちでお願いします\n具体的な体位や構図はお任せします\n\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Sano_zyuuzyou/works/22", "thumbnail_src": "https://si.imgix.net/395f1571/uploads/origins/6d6926cc-eaee-44c9-a3fe-ca1e600be04b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d62ecf2f80ea0447a5189d420b6fe95d", "thumbnail_srcset": "https://si.imgix.net/395f1571/uploads/origins/6d6926cc-eaee-44c9-a3fe-ca1e600be04b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d62ecf2f80ea0447a5189d420b6fe95d, https://si.imgix.net/395f1571/uploads/origins/6d6926cc-eaee-44c9-a3fe-ca1e600be04b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d44ae8302ebfddd16fb8aa5b67d34f40 2x, https://si.imgix.net/395f1571/uploads/origins/6d6926cc-eaee-44c9-a3fe-ca1e600be04b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4a01c75a6de9505135dbd6c0ca8342f 3x", "genre": "art", "nsfw": true, "body": "何度も黒音ちゃんを描いてもらっているものです。\nまたリクエストをさせてください。\nーーーーーーーーー\nまた私のうちの子的な「三崎黒音ちゃん」のえっちなイラストをお願いします。\nおじさんとの行為が学校にまで広まってしまい男子生徒や教師に輪姦わされてしまうシチュをお願いしたいです。\n事後に学生証と共に写真を取られちゃうシチュもお願いしたいです。\nーーーーーーーーー\n以上です！\n\n資料▶https://x.com/i/status/2009636326061285402", "created_at": "", "completed_at": ""}, {"path": "/@Sano_zyuuzyou/works/21", "thumbnail_src": "https://si.imgix.net/1fb60fa3/uploads/origins/0424c869-709c-4981-86b7-b273552d6e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e99ed19e2ed33118f12aa13aa004fb25", "thumbnail_srcset": "https://si.imgix.net/1fb60fa3/uploads/origins/0424c869-709c-4981-86b7-b273552d6e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e99ed19e2ed33118f12aa13aa004fb25, https://si.imgix.net/1fb60fa3/uploads/origins/0424c869-709c-4981-86b7-b273552d6