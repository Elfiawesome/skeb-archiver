e-46c2-9a4e-add8848c0d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=183ff18e13423a2e3aeb46c727ed901b", "thumbnail_srcset": "https://si.imgix.net/d2d66d8f/uploads/origins/5bc1474b-68ee-46c2-9a4e-add8848c0d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=183ff18e13423a2e3aeb46c727ed901b, https://si.imgix.net/d2d66d8f/uploads/origins/5bc1474b-68ee-46c2-9a4e-add8848c0d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=750b1c7e49c0776a2fb383e53d6b30d5 2x, https://si.imgix.net/d2d66d8f/uploads/origins/5bc1474b-68ee-46c2-9a4e-add8848c0d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48a0459e0794dea5b64171aab8526a16 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/18", "thumbnail_src": "https://si.imgix.net/f9ec7884/uploads/origins/a9bf7d0a-5ce8-4f5e-b4b2-a2a0070cec7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=692172ec4e48e81bd675ba5d52b08d90", "thumbnail_srcset": "https://si.imgix.net/f9ec7884/uploads/origins/a9bf7d0a-5ce8-4f5e-b4b2-a2a0070cec7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=692172ec4e48e81bd675ba5d52b08d90, https://si.imgix.net/f9ec7884/uploads/origins/a9bf7d0a-5ce8-4f5e-b4b2-a2a0070cec7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3c2cd2eefa968e50d20bb0c7d05cbc7 2x, https://si.imgix.net/f9ec7884/uploads/origins/a9bf7d0a-5ce8-4f5e-b4b2-a2a0070cec7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfa9ac80bd66c917bc0f385a1c67dc98 3x", "genre": "art", "nsfw": true, "body": "拘束脱出ゲームに捕らわれた女性がすごくすごく良かったので、ぜひ似たようなイメージで他のイラストも見てみたいです。\nお任せしますのでピンチ（危機）寄りのシチュエーションをお願い致します。\n\n金髪で胸が大きく気の強そうな女性の首枷（参考 https://www.amazon.co.jp/dp/B08PKFVKRM）拘束で、枷に頑丈そうな留め金と錠をつけて頂けますでしょうか。", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/17", "thumbnail_src": "https://si.imgix.net/16fc5d23/uploads/origins/3b64c361-8a44-4325-be0f-8223c77e48b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d3b1ee6392bb09fb43513b62ea3bc8", "thumbnail_srcset": "https://si.imgix.net/16fc5d23/uploads/origins/3b64c361-8a44-4325-be0f-8223c77e48b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d3b1ee6392bb09fb43513b62ea3bc8, https://si.imgix.net/16fc5d23/uploads/origins/3b64c361-8a44-4325-be0f-8223c77e48b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0557201afd7e6ef89e8245d094b49fcb 2x, https://si.imgix.net/16fc5d23/uploads/origins/3b64c361-8a44-4325-be0f-8223c77e48b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=870fada08b177d33af53602d1455ea06 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nいつもイラストを楽しみにしています。もし宜しければ以下のイラストをお願いします。\n\n■キャラ\n鹿山レイジョ（ブルーアーカイブ）\n\n■服装\n資料をご参照ください。\n\n■シチュエーション\n偽装拘束シチュをお願いします。\n　・チャイナ服の上から縄で後ろ手に緊縛し、ジャージを羽織る形で縄目を隠す\n　　※ジャージを羽織っていても縄目が完全に隠れていないくらいが嬉しいです…。\n　・ジャージの袖口はポケットに入れて、腕が通っていないことを誤魔化す\n　・口にはボールギャグを咥え、マスクを装着して隠す\n　・屋外（街中）に居ることが分かるようにしていただければ嬉しいです。\n\n■差分について\nジャージとマスクの有無の差分をお願い致します。\n可能であれば、ジャージ・マスクをレイヤー分けして頂き、組み合わせられるようにPSD形式などで頂けるととても嬉しいです。\n\n特殊な内容ですが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/16", "thumbnail_src": "https://si.imgix.net/f6d25050/uploads/origins/287c738d-fe2f-45ea-8c6e-51eb66a4a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb48401afaa636ea11e95acd95bf40e", "thumbnail_srcset": "https://si.imgix.net/f6d25050/uploads/origins/287c738d-fe2f-45ea-8c6e-51eb66a4a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb48401afaa636ea11e95acd95bf40e, https://si.imgix.net/f6d25050/uploads/origins/287c738d-fe2f-45ea-8c6e-51eb66a4a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f19d04f798024c75dd4c2233be26f41b 2x, https://si.imgix.net/f6d25050/uploads/origins/287c738d-fe2f-45ea-8c6e-51eb66a4a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4154fe781a596cb0736e844184fc654 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n先生の絵が大好きです！\nぜひ依頼をさせてくれませんか？\n\nキャラクターはキュラソー(アズールレーン)のチャイナスキン\n(イラストはURLを参照してください)\n\n変質者に捕まって監禁されているという状況で、キュラソーは相手を睨んでいる。\n拘束は、縄で胡座縛りやM字縛りのような羞恥を与える縛り方が嬉しいです。\n\n口は、前に先生が描いていた布を詰めたギャグ(https://www.pixiv.net/artworks/98145567)、布を被せギャグ、テープギャグ\nのどれかを希望したいです。\n\n言葉を勉強中なので分からなかったらごめんなさい。\nよろしくお願いします！\n\nhttps://www.dropbox.com/sh/7wsbpnalbjnq72d/AACy6yWO8MkKD5kSFkUepD1Ma?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/15", "thumbnail_src": "https://si.imgix.net/0a26130e/uploads/origins/730351f9-f26e-41b5-a3f5-55e10a96d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86c3eee8a147b5a2e6a1f04ecccae11c", "thumbnail_srcset": "https://si.imgix.net/0a26130e/uploads/origins/730351f9-f26e-41b5-a3f5-55e10a96d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86c3eee8a147b5a2e6a1f04ecccae11c, https://si.imgix.net/0a26130e/uploads/origins/730351f9-f26e-41b5-a3f5-55e10a96d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b567385a4704ab7cf54ec4d9ac362d21 2x, https://si.imgix.net/0a26130e/uploads/origins/730351f9-f26e-41b5-a3f5-55e10a96d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=103eb3b95581a2a86c26e6d2c24fe3bd 3x", "genre": "art", "nsfw": true, "body": "先生こんにちは、初めてお邪魔します。\n戦艦少女Rの「ヤット・セン」が縛られているシーンを描いてほしいです。\nhttps://www.dropbox.com/scl/fo/uxd79tijuvy4s3bhn9lam/h?dl=0&rlkey=kyz8ljur53xm2w2wgwzaqhurd\n\nベッドの上でM字に縛られ、布切れで口を塞がれた少女。\nその他、記載されていないことでもお気軽にご相談ください。\n予算が許すなら、ギャグの別バージョンを追加してください。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/14", "thumbnail_src": "https://si.imgix.net/6f8e585b/uploads/origins/51848384-ae12-40c8-ac13-1440b6cfa970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9482d7ee0724f88a2dccf45a3725914c", "thumbnail_srcset": "https://si.imgix.net/6f8e585b/uploads/origins/51848384-ae12-40c8-ac13-1440b6cfa970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9482d7ee0724f88a2dccf45a3725914c, https://si.imgix.net/6f8e585b/uploads/origins/51848384-ae12-40c8-ac13-1440b6cfa970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9209f13d7b73699f70493802b34c345b 2x, https://si.imgix.net/6f8e585b/uploads/origins/51848384-ae12-40c8-ac13-1440b6cfa970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27cc9b1973e0421e868d2960b7136e3a 3x", "genre": "art", "nsfw": true, "body": "前回の依頼では申し訳ありませんでした、内容を変更させていただき、可能であれば再度依頼させてください。\nキャラクターはアズールレーンの東（吾妻）です。\n衣装は「語らいの春霞\nhttps://twitter.com/azurlane_staff/status/1215181412174835714\nhttps://hobby.dengeki.com/event/1625431/\n縛られて部屋に置かれ、司令官が来るのを待っている画像をお願いします。\n予算が許すなら、口枷の有無の違いも見てみたいです。\nあとはあなたの判断にお任せします。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/13", "thumbnail_src": "https://si.imgix.net/85a38bd2/uploads/origins/40017824-b303-4613-affa-1394678752ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6de834d6b6a51a71efa92464cdadaa9", "thumbnail_srcset": "https://si.imgix.net/85a38bd2/uploads/origins/40017824-b303-4613-affa-1394678752ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6de834d6b6a51a71efa92464cdadaa9, https://si.imgix.net/85a38bd2/uploads/origins/40017824-b303-4613-affa-1394678752ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=738ba71348b8d8058a72b9ea65a0bb33 2x, https://si.imgix.net/85a38bd2/uploads/origins/40017824-b303-4613-affa-1394678752ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3808ef924ff95208597d05b820496351 3x", "genre": "art", "nsfw": true, "body": "こんにちは、お目にかかれて光栄です。\nこの度、依頼を開始したいと思います。\nキャラクターは少女前線のOTS-14で、衣装はCrassula volkensii(紫雨心ver)です。\nhttps://twitter.com/GirlsFrontline/status/1386615616342089732\nhttps://iopwiki.com/wiki/OTs-14#/media/File:OTs-14_costume2.png\nhttps://www.amiami.jp/top/detail/detail?gcode=FIGURE-060853\n拘束方法：上半身はうしろ手縛り、割座座り、脚はカエル縛り、口元はマウスギャグで拘束。\n希望する視点は俯瞰のアングル。\nそれ以外の内容については、お客様のご判断にお任せします。\n予算があれば、アイマスクとマスクタイプの口パクの違いもあるといいのですが。\n翻訳ソフトの関係でわかりにくい表現があればご容赦ください。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/12", "thumbnail_src": "https://si.imgix.net/8d0cab50/uploads/origins/d952631d-9a28-4d8d-af99-1fff30b7d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05f37340ce228d9a70ec8ac46b301fed", "thumbnail_srcset": "https://si.imgix.net/8d0cab50/uploads/origins/d952631d-9a28-4d8d-af99-1fff30b7d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05f37340ce228d9a70ec8ac46b301fed, https://si.imgix.net/8d0cab50/uploads/origins/d952631d-9a28-4d8d-af99-1fff30b7d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b4a70f51b1ed7de0b8650c5b0c301c7 2x, https://si.imgix.net/8d0cab50/uploads/origins/d952631d-9a28-4d8d-af99-1fff30b7d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83df6684adb2cb4b1b5c6413c8d6e3e2 3x", "genre": "art", "nsfw": true, "body": "こんにちわ、拘束イラストが素晴らしかったので依頼させていただきます。\n「二人組の用心棒」的なイメージで、 https://skeb.jp/@BlackCarSplint/works/5 と同じ形の開口マスクをつけた2人の女の子のイラストをお願いいたします。開口マスクはつけていますが、捕まっているというよりそういうコスチュームというイメージです。\n服装はチャイナ服でお願いします。\n特徴としては\n・金髪セミロング、巨乳で活発そう\n・銀髪ショートヘア、バスト普通で真面目そう\nなデザインで、栓の閉まった開口マスクをつけて並んで立っている感じでお願いします。\n可能であれば差分として\n②栓があいてよだれを垂らしている\n③開口マスクどうしを透明なチューブで繋いで唾液交換している\n姿もお願いできると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/11", "thumbnail_src": "https://si.imgix.net/47fdc082/uploads/origins/d9525bc5-e95f-4353-bfa0-77556942d209?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb973c039374b47a70ee9b6c2fca5624", "thumbnail_srcset": "https://si.imgix.net/47fdc082/uploads/origins/d9525bc5-e95f-4353-bfa0-77556942d209?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb973c039374b47a70ee9b6c2fca5624, https://si.imgix.net/47fdc082/uploads/origins/d9525bc5-e95f-4353-bfa0-77556942d209?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db4d9f7e755ff33649354128a0f42204 2x, https://si.imgix.net/47fdc082/uploads/origins/d9525bc5-e95f-4353-bfa0-77556942d209?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f5e7e0c39bd760d9de79d519b14826 3x", "genre": "art", "nsfw": true, "body": "以前描かれていた短い黒髪の女性（https://skeb.jp/@BlackCarSplint/works/5）をまたお願いします\n（脱出させるつもりのない）拘束脱出ゲームに無理やり参加させられたというシチュエーションで\n\n・棒状の猿轡をされており、拘束具で腕も使えない（同じアームバインダーでも違う拘束具でもOKです）\n・首輪からなにかの鍵がぶら下がっているが手に取れない位置\n・見知らぬ建物内の曲がり角で、恐る恐る先の様子を伺っている様子", "created_at": "", "completed_at": ""}, {"path": "/@BlackCarSplint/works/10", "thumbnail_src": "https://si.imgix.net/52e43ea7/uploads/origins/4f47b088-dacc-4572-ae4b-5b724982fa98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab7c93094ceec457f0634a375bb3e711", "thumbnail_srcset": "https://si.imgix.net/52e43ea7/uploads/origins/4f47b088-dacc-4572-ae4b-5b724982fa98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab7c93094ceec457f0634a375bb3e711, https://si.imgix.net/52e43ea7/uploads/origins/4f47b088-dacc-4572-ae4b-5b724982fa98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9944737be669ffd85d9e1f2f47f9ca04 2x, https://si.imgix.net/52e43ea7/uploads/origins/4f47b0