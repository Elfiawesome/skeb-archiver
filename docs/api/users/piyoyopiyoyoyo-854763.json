9f99ddf9e8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51a7a064ff0280268ef7757449cea764, https://si.imgix.net/23b3f880/uploads/origins/d6e8657b-1ed0-4f01-86b0-9f99ddf9e8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b67dfd8a47c72b880a416dc0e40f8fe9 2x, https://si.imgix.net/23b3f880/uploads/origins/d6e8657b-1ed0-4f01-86b0-9f99ddf9e8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38e243244334bd2da9a1530706e1827b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@piyoyopiyoyoyo/works/7", "thumbnail_src": "https://si.imgix.net/11116f95/uploads/origins/c8c1b6fb-a031-4a12-a2f1-70f75de638d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e6553f7b4b64b98ff011c6d637d7f5c", "thumbnail_srcset": "https://si.imgix.net/11116f95/uploads/origins/c8c1b6fb-a031-4a12-a2f1-70f75de638d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e6553f7b4b64b98ff011c6d637d7f5c, https://si.imgix.net/11116f95/uploads/origins/c8c1b6fb-a031-4a12-a2f1-70f75de638d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ae1a6fe16909b5cb266906aadf94eea 2x, https://si.imgix.net/11116f95/uploads/origins/c8c1b6fb-a031-4a12-a2f1-70f75de638d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=334f0e7933c0fd023fa70fcf00023081 3x", "genre": "art", "nsfw": false, "body": "西田先生こんにちは。\n突然で申し訳ありませんが、私も海外で先生の作品のファンで、学生の頃から先生の作品の大ファンでした！\n何年も前から、ほとんどの友人に西田先生の漫画を勧め、心を打たれてきました。 私たちの想像を絶するような様々なご苦労があったと思いますが、先生の創られた世界が、何千キロも離れた多くの人々に感動を与えていることを知っていただき、これからも先生の創作に喜びを感じていただけることを心から願っています！あなたの創造物から喜びを得続けることを心から願っています！\n感謝の気持ちを込めて、過去の作品の主人公を2人、モノクロでもカラーでもいいので、負担にならない範囲で描いてください～。\nあらためて、青春時代を共に歩んでくれた西田先生に感謝し、これまで照らしてくれた星が、今、さらに空を明るく照らすことを願いつつ、先生のご健康とご活躍をお祈りいたします！", "created_at": "", "completed_at": ""}, {"path": "/@piyoyopiyoyoyo/works/6", "thumbnail_src": "https://si.imgix.net/ce9d7aa4/uploads/origins/d2874a6a-ba24-414d-8b5c-db5fe9a228e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd543226c1587f825082daebcb5f9730", "thumbnail_srcset": "https://si.imgix.net/ce9d7aa4/uploads/origins/d2874a6a-ba24-414d-8b5c-db5fe9a228e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd543226c1587f825082daebcb5f9730, https://si.imgix.net/ce9d7aa4/uploads/origins/d2874a6a-ba24-414d-8b5c-db5fe9a228e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f75606aa0c65c5b9739a0add96df1a63 2x, https://si.imgix.net/ce9d7aa4/uploads/origins/d2874a6a-ba24-414d-8b5c-db5fe9a228e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=231ba26d23cd2d050ff45f60138ec4f6 3x", "genre": "art", "nsfw": false, "body": "西田さんへ、\n\nこんにちは！まず最初に、前回の依頼の件ですが、誤って作品のタイトルを間違えて書いてしまったことをお詫びしたいと思います。大変申し訳ないので、正しい内容でメッセージを送り直すことにしました。\n\n私はあなたの漫画の大ファンです。数年前に初めて先生の作品を知って以来、ずっと大好きなBL漫画家です。あなたのストーリーは素晴らしく、絵を通して感情を表現する方法はとても感動的です。T T\n\n特に「やさしいあなた...」のストーリーテリングが大好きです！テンポがとてもスムーズで、まるでフォックストロットのよう。\n\nできれば、春本と水田を描いていただけたら嬉しいです。モノクロでもカラーでもかまいません！\n\nお返事がとても楽しみです！ご検討ありがとうございました。\n\nよろしくお願いします、\n\nあなたの作品のファン", "created_at": "", "completed_at": ""}, {"path": "/@piyoyopiyoyoyo/works/5", "thumbnail_src": "https://si.imgix.net/9d6d3dca/uploads/origins/d5cb97d9-479c-424e-9be6-9e09be01e144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6fda1737daaebbe5c7f1b84d49f06f3", "thumbnail_srcset": "https://si.imgix.net/9d6d3dca/uploads/origins/d5cb97d9-479c-424e-9be6-9e09be01e144?bg=%23fff&auto=format%2Ccompress&fm=webp&f