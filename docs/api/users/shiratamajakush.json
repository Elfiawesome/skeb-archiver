23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc89f4c769c0ab5bfd556c82beb165bd 2x, https://si.imgix.net/b8b48635/uploads/origins/040f7c2b-2415-4f13-91fa-cfb60ec2ca76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=128f077b1ea08ea07de8cc6b1baf1b1b 3x", "genre": "art", "nsfw": false, "body": "今年初めての依頼です。\n節分が近くなってきたので鬼役になった颯ちゃんをおねがいします。\n鬼役になった颯ちゃんは他人のふんどしの前垂れをビリビリにしようと、襲ってくる感じです。\n鬼の颯ちゃんはこんな感じです。資料だと素足になってますが、いつものケモ足にさせてください。\nあといままのの颯ちゃんは若干前垂れが短いと思いましたので、もう少し長くしてください。\n\nhttps://x.com/hayate2E233kei/status/1621166483278819328?t=DsmdNrEwP5jGRXqhShB1-A&s=19", "created_at": "", "completed_at": ""}, {"path": "/@shiratamajakush/works/4", "thumbnail_src": "https://si.imgix.net/15628a5c/uploads/origins/e7fd1015-ffe9-4bce-951e-1901c7a4df73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01d762877cc828bf303c1d4e2eed5a44", "thumbnail_srcset": "https://si.imgix.net/15628a5c/uploads/origins/e7fd1015-ffe9-4bce-951e-1901c7a4df73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01d762877cc828bf303c1d4e2eed5a44, https://si.imgix.net/15628a5c/uploads/origins/e7fd1015-ffe9-4bce-951e-1901c7a4df73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e74f9b5379eeef90a783f33d18ca5c7c 2x, https://si.imgix.net/15628a5c/uploads/origins/e7fd1015-ffe9-4bce-951e-1901c7a4df73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec5e110c89ee84f2cfde332cd14dc90e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shiratamajakush/works/3", "thumbnail_src": "https://si.imgix.net/70efe0ac/uploads/origins/b90a1615-5d7d-48f1-83c5-1ce28c5c33c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58bea2605cc0c9f10ffc49abc47fbf5", "thumbnail_srcset": "https://si.imgix.net/70efe0ac/uploads/origins/b90a1615-5d7d-48f1-83c5-1ce28c5c33c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58bea2605cc0c9f10ffc49abc47fbf5, https://si.imgix.net/70efe0ac/uploads/origins/b90a1615-5d7d-48f1-83c5-1ce28c5c33c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7711f60ada5dd111544c96a27a23121 2x, https://si.imgix.net/70efe0ac/uploads/origins/b90a1615-5d7d-48f1-83c5-1ce28c5c33c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a7d8c19000135d12f5bfb353ec1820a 3x", "genre": "art", "nsfw": false, "body": "久しぶりに依頼します。\n描いてほしいのは踊り子颯ちゃんです。\n今回も構図はおまかせします。踊り子らしさを出してくだされば光栄です。\nhttps://twitter.com/hayate233kei/status/1647601029507342336?s=20\nhttps://twitter.com/hayate233kei/status/1664575460716740608?s=20\nhttps://i.imgur.com/WIRQl7p.png", "created_at": "", "completed_at": ""}, {"path": "/@shiratamajakush/works/2", "thumbnail_src": "https://si.imgix.net/b21ec1d0/uploads/origins/c97fbb22-0ab1-4ea1-995e-363250855b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1875ccd3b4e620b797699c908d09289", "thumbnail_srcset": "https://si.imgix.net/b21ec1d0/uploads/origins/c97fbb22-0ab1-4ea1-995e-363250855b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1875ccd3b4e620b797699c908d09289, https://si.imgix.net/b21ec1d0/uploads/origins/c97fbb22-0ab1-4ea1-995e-363250855b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c349677b091fd4cf34d4e6b34be9d47 2x, https://si.imgix.net/b21ec1d0/uploads/origins/c97fbb22-0ab1-4ea1-995e-363250855b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed3337040feaa82d6b30ac57e62c739 3x", "genre": "art", "nsfw": false, "body": "前回の颯ちゃんのイラストありがとうございました。\n今回は颯ちゃんと燐鬼ちゃんとのコラボ的なものをお願いしようかなと思います。\n燐鬼ちゃんは颯ちゃんの胸に嫉妬しつつ前たれをもって布の無駄使いじゃ的なことを言ってる感じです。\n颯ちゃんにとって前たれを持つことは友好の証だと思ってますが燐鬼ちゃんの前たれが短くてどこをもてばいいだろと思ってる感じです。\n\nあと二人のお尻が見たいですね。（颯ちゃんは資料通りお尻が布で覆ってますが、燐鬼ちゃんはしらたまさん次第です。）", "created_at": "", "completed_at": ""}, {"path": "/@shiratamajakush/works/1", "thumbnail_src": "https://si.imgix.net/c779db34/uploads/origins/12401423-1892-47d4-8b66-63ddc34da26f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0931ed6f23c6eb26fd4a7a6f2ae85dba", "thumbnail_srcset": "https://si.imgix.net/c779db34/uploads/origins/12401423-1892-47d4-8b66-63ddc34da26f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0931ed6f23c6eb26fd4a7a6f2ae85dba, https://si.imgix.net/c779db34/uploads/origins/12401423-1892-47d4-8b66-63ddc34da26f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bbcf799711f132e7ee1b11ead5aa0ad 2x, https://si.imgix.net/c779db34/uploads/origins/12401423-1892-47d4-8b66-63ddc34da26f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e22572f835beec8b5ec6c00d7e54b48 3x", "genre": "art", "nsfw": false, "body": "初めまして、ふんどし鬼娘ちゃんがかわいかったのでフォローしました。\n描いてほしいのはうちの子の颯ちゃんです。\n構図はお任せします。自由きままな感じの子です。\n詳しい資料はこちらになります。\nhttps://pbs.twimg.com/media/FGE-7P2VkAEBjMP?format=jpg&name=4096x4096\nhttps://twitter.com/hayate233kei/status/1462314634296266757?s=20&t=dCAMsqwcHbP0m8gumx0V5Q", "created_at": "", "completed_at": ""}]}