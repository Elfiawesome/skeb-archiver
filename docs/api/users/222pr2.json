-babe-eabaac44b409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd6badfca558ad72b4a2f8b3ca004a23", "thumbnail_srcset": "https://si.imgix.net/eba5787f/uploads/origins/c417fa72-5545-4f96-babe-eabaac44b409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd6badfca558ad72b4a2f8b3ca004a23, https://si.imgix.net/eba5787f/uploads/origins/c417fa72-5545-4f96-babe-eabaac44b409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30e20fab62b1236a18682d31dc940178 2x, https://si.imgix.net/eba5787f/uploads/origins/c417fa72-5545-4f96-babe-eabaac44b409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c13899b1c67d3dc1b378b2c0e7a55d7f 3x", "genre": "art", "nsfw": true, "body": "こんにちは！奴隷オークションで最高額落札された後の、マイ・バレンタインの展開に興味があるか確認したくて。彼女は清掃のために連れ去られ、処理の準備が整えられます。もちろん購入側は、彼女の才能と身体をどう活用するのが最適かまだ検討中です。準備センターで彼女を訪ねる？ https://www.pixiv.net/en/artworks/139680108\nhttps://www.pixiv.net/en/artworks/140213545\nhttps://skeb.jp/@rakuraku_kmczk/works/173 https://skeb.jp/@CielR18/works/88 彼女は壁に閉じ込められている。彼らは彼女の乳首や乳房を引っ張ったり握ったりしながら、様々なものを挿入し、触診し、測定する。 \n\n参考：https://skeb.jp/@notogoro/works/64 https://skeb.jp/@j1S0dbMKRA/works/128 https://skeb.jp/@honotomo7/works/110 https://skeb.jp/@honotomo7/works/109", "created_at": "", "completed_at": ""}, {"path": "/@222pr2/works/24", "thumbnail_src": "https://si.imgix.net/e428af0a/uploads/origins/cd1e60c2-d144-4944-9ff9-9d8ed0c5cdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18d212233c82ea049f2096daa2531575", "thumbnail_srcset": "https://si.imgix.net/e428af0a/uploads/origins/cd1e60c2-d144-4944-9ff9-9d8ed0c5cdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18d212233c82ea049f2096daa2531575, https://si.imgix.net/e428af0a/uploads/origins/cd1e60c2-d144-4944-9ff9-9d8ed0c5cdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c7fe74d85f343164a946e8913e1fad8 2x, https://si.imgix.net/e428af0a/uploads/origins/cd1e60c2-d144-4944-9ff9-9d8ed0c5cdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec43b1cd50b4693eff9a3a525583a63a 3x", "genre": "art", "nsfw": true, "body": "こんにちは！バトルシティ衣装のマイ・バレンタインが、ここで描かれたようなパイズリと射精シーンを再現した作品をお願いします！可能な限り得意げなセクシーな姿で描いてください！\n\nhttps://skeb.jp/@MUJINA627OEKAKI/works/9舞の衣装参考：https://skeb.jp/@honotomo7/works/106https://skeb.jp/@warukuriboo/works/121", "created_at": "", "completed_at": ""}, {"path": "/@222pr2/works/23", "thumbnail_src": "https://si.imgix.net/46fa0bdb/uploads/origins/b11ece0a-2786-411f-864d-874c8a4730ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe939d91a577cf0e8c1802f3a1654a95", "thumbnail_srcset": "https://si.imgix.net/46fa0bdb/uploads/origins/b11ece0a-2786-411f-864d-874c8a4730ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe939d91a577cf0e8c1802f3a1654a95, https://si.imgix.net/46fa0bdb/uploads/origins/b11ece0a-2786-411f-864d-874c8a4730ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71dbc47c7a891746dfe835cb2a17c498 2x, https://si.imgix.net/46fa0bdb/uploads/origins/b11ece0a-2786-411f-864d-874c8a4730ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8338e41ae3ed9d30053b47f3687ccf1f 3x", "genre": "art", "nsfw": true, "body": "こんにちは！マイ・バレンタインがプラズマウナギに弄ばれ、屈辱的な追加プレイを受ける作品をお願いします。両腕と両脚を拘束された状態で。マイはバトルシティの衣装を着用し、豊満な胸と深い谷間を強調してください。抵抗しようとするも、最終的に我を忘れ、腹部が膨らむ快感に溺れる様子を描いてください。より官能的な演出のため、お好きな詳細を追加していただいて構いません。 \nhttps://www.pixiv.net/en/artworks/136416825https://skeb.jp/@honotomo7/works/106https://www.pixiv.net/en/artworks/140055496\nhttps://skeb.jp/@warukuriboo/works/121 https://skeb.jp/@bara_no_oniku/works/102 追加の舞が腕を組む参考画像： https://skeb.jp/@Kta_osushi/works/160", "created_at": "", "completed_at": ""}, {"path": "/@222pr2/works/22", "thumbnail_src": "https://si.imgix.net/c84ba646/uploads/origins/62fe29e8-aa9f-4cc0-a3d6-21353af92b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=645250702c97a229f7eb3c9b37f9696b", "thumbnail_srcset": "https://si.imgix.net/c84ba646/uploads/origins/62fe29e8-aa9f-4cc0-a3d6-21353af92b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=645250702c97a229f7eb3c9b37f9696b, https://si.imgix.net/c84ba646/uploads/origins/62fe29e8-aa9f-4cc0-a3d6-21353af92b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5e48d8905aaab475372aed770ace5c9 2x, https://si.imgix.net/c84ba646/uploads/origins/62fe29e8-aa9f-4cc0-a3d6-21353af92b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff50fe02d87acbad0cd1e1a1924fa140 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私のキャラクターをそんなに気に入ってくださって光栄です。キャラクターの描き方や設定する状況は、お任せします。本当にありがとうございます！参考画像：https://files.catbox.moe/5nlm4y.zip", "created_at": "", "completed_at": ""}, {"path": "/@222pr2/works/21", "thumbnail_src": "https://si.imgix.net/e37eca1d/uploads/origins/ef45c86f-2e0c-4412-96a0-6b3f7726e6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd1f7d25522c4b3c58d41b6e2e471f14", "thumbnail_srcset": "https://si.imgix.net/e37eca1d/uploads/origins/ef45c86f-2e0c-4412-96a0-6b3f7726e6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd1f7d25522c4b3c58d41b6e2e471f14, https://si.imgix.net/e37eca1d/uploads/origins/ef45c86f-2e0c-4412-96a0-6b3f7726e6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be4bac439d1ca00fe82b319783697375 2x, https://si.imgix.net/e37eca1d/uploads/origins/ef45c86f-2e0c-4412-96a0-6b3f7726e6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad3d7951c0ccdec816ee77413de4ace0 3x", "genre": "art", "nsfw": true, "body": "こんにちは！今回は遊戯王のマイ・バレンタインのリクエストです。\n\nhttps://skeb.jp/@bondi_tei/works/132\nhttps://skeb.jp/@honotomo7/works/95\nhttps://skeb.jp/@katenatioura/works/37\nhttps://skeb.jp/@Lv_Lunatic/works/14\nhttps://skeb.jp/@calicchio23/works/534\n\nマイ・バレンタインは、バトル・シティのユニフォームを着て、傷んでいない状態でスタートするのがいい。紫の紐がついた白いチューブトップ・ソートを使うように気をつけてほしい。彼女の衣装の参考文献はこちら：\nhttps://skeb.jp/@oguwooo/works/59\n\nhttps://skeb.jp/@warukuriboo/works/81\n\nご検討ありがとうございました。\n\nhttps://www.pixiv.net/en/artworks/132253925\n\nhttps://skeb.jp/@bondi_tei/works/132", "created_at": "", "completed_at": ""}, {"path": "/@222pr2/works/20", "thumbnail_src": "https://si.imgix.net/317a0faa/uploads/origins/93127db2-341c-42bb-8fc4-53d7b3f1de6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38ac5d753324a8f44b91cf80a5128e23", "thumbnail_srcset": "https://si.imgix.net/317a0faa/uploads/origins/93127db2-341c-42bb-8fc4-53d7b3f1de6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38ac5d753324a8f44b91cf80a5128e23, https://si.imgix.net/317a0faa/uploads/origins/93127db2-341c-42bb-8fc4-53d7b3f1de6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e84575cbd58b277f96900c2ac493f39 2x, https://si.imgix.net/317a0faa/uploads/origins/93127db2-341c-42bb-8fc4-53d7b3f1de6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bae4dc58ad550f0a5b4573b52cd3560d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@222pr2/works/19", "thumbnail_src": "https://si.imgix.net/1cc75aa6/uploads/origins/36959a96-87ee-4390-98ed-93701ef3845b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12c0a95f0ed281e018b2aea01c43126f", "thumbnail_srcset": "https://si.imgix.net/