d=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63e84585e8fc520405f79b31343f9565 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/11", "thumbnail_src": "https://si.imgix.net/928ff5db/uploads/origins/5150ebea-7b01-4b7c-8b62-425a93419bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82716c896c83acf121123fa36b7cd50b", "thumbnail_srcset": "https://si.imgix.net/928ff5db/uploads/origins/5150ebea-7b01-4b7c-8b62-425a93419bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82716c896c83acf121123fa36b7cd50b, https://si.imgix.net/928ff5db/uploads/origins/5150ebea-7b01-4b7c-8b62-425a93419bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f887b7a5035e80089565ebd8baeff7e4 2x, https://si.imgix.net/928ff5db/uploads/origins/5150ebea-7b01-4b7c-8b62-425a93419bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32d4397d8846c96bc8680cc1090320bb 3x", "genre": "art", "nsfw": false, "body": "とさんこんにちは！前回の\nhttps://skeb.jp/@hao_kainushi/works/3\nがよかったので、これの対バージョンみたいな感じでお願いしたいと思います！\n・前回のと逆向き\n・パーカーやジャージなど全体的に黒っぽい服装で差し色は青緑みたいなかんじ(とさんの衣装のデザイン好きなのでアレンジもあれば嬉しいです)\n・前回は小脇に抱えていた羊を、今回は黒羊に変えて、それを肩に乗せている。(サトシとピカチュウみたいなかんじ)もしくは頭に乗せる\n・本人も羊も真剣な表情\n・なにかしらのカメラを持っている\n\n資料\nhttps://drive.google.com/drive/folders/1nMSvb1X8SInizH0CKR6bdrFLnn9ejrOQ?usp=sharing\n\n黒羊\nhttps://drive.google.com/file/d/14ZJAAVZwGYy5UajY1oKI1bvttimHgUWj/view?usp=drivesdk\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/10", "thumbnail_src": "https://si.imgix.net/2180224b/uploads/origins/270598a4-997d-4080-944d-d11798823df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0a4931ebfd617595a9b1a28863d04a", "thumbnail_srcset": "https://si.imgix.net/2180224b/uploads/origins/270598a4-997d-4080-944d-d11798823df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0a4931ebfd617595a9b1a28863d04a, https://si.imgix.net/2180224b/uploads/origins/270598a4-997d-4080-944d-d11798823df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4de0d32ac7a25552b31703a1ff9496ae 2x, https://si.imgix.net/2180224b/uploads/origins/270598a4-997d-4080-944d-d11798823df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84331f8da756f4c9711b8402db9055dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵はとても美しいです\n私のキャラクターが夜空に見とれている絵を描いていただけませんか？多分、彼女の前足の上に星が浮かんでいると思います。彼女は夜、星、月についてのテーマを持っています。\n彼女の他のアートはこちらです。\nhttps://toyhou.se/12778680.stitches/gallery\n\n彼女をポニーテールにしないでください。彼女の髪は乱れ、カール/ウェーブしています。\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/42962789_6dkqZCu5IR8vDfS.png?1639414365\n\nもし、彼女の手を絵に入れるのであれば、前足をつけてください。彼女は人間の手/指を持っていません。\n\n完全な参考文献はこちら: https://f2.toyhou.se/file/f2-toyhou-se/images/40500973_h77pW5hJpbqFYGz.png?1649186272\n\nこのような要望を聞いていただきありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/9", "thumbnail_src": "https://si.imgix.net/d0437c16/uploads/origins/54a82ea2-12f7-47cf-a355-ff898d95ec4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c277bdcb81b747514a148d89d57962", "thumbnail_srcset": "https://si.imgix.net/d0437c16/uploads/origins/54a82ea2-12f7-47cf-a355-ff898d95ec4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c277bdcb81b747514a148d89d57962, https://si.imgix.net/d0437c16/uploads/origins/54a82ea2-12f7-47cf-a355-ff898d95ec4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cebe69aff5cdfe7db389d6e720e793c 2x, https://si.imgix.net/d0437c16/uploads/origins/54a82ea2-12f7-47cf-a355-ff898d95ec4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f740e6f9b725956097b9925b46d9d367 3x", "genre": "art", "nsfw": false, "body": "初めまして。いつも素敵なイラスト拝見しております！\nskebの再開待ちにしておりました。\nよろしければうちの子を描いて頂けないでしょうか…！\n（https://drive.google.com/drive/folders/1-7FJYkON6Rdl-_xFVxlZrxmqlJtJbeIm?usp=sharing）\n\n時果さんのデザインされる衣装が本当に好きなので、適当に似合いそうなメイド服(デザインはお任せ)を着せて頂けたらとても嬉しいですが、難しければ資料画像の服装でも構いません。\n構図等はお任せしますので、お好きなように描いて頂けたら嬉しいです！\n\nご検討のほどよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1-7FJYkON6Rdl-_xFVxlZrxmqlJtJbeIm?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/8", "thumbnail_src": "https://si.imgix.net/7df37bf4/uploads/origins/a34961b8-7ba7-4423-81f9-914419c27ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=106ff7409f6ab688fd3094c28ca6fa58", "thumbnail_srcset": "https://si.imgix.net/7df37bf4/uploads/origins/a34961b8-7ba7-4423-81f9-914419c27ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=106ff7409f6ab688fd3094c28ca6fa58, https://si.imgix.net/7df37bf4/uploads/origins/a34961b8-7ba7-4423-81f9-914419c27ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1987bf207fd04f7af52278378f5ebd8 2x, https://si.imgix.net/7df37bf4/uploads/origins/a34961b8-7ba7-4423-81f9-914419c27ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15785fe91c82aee1bc9d1dc6df605cbe 3x", "genre": "art", "nsfw": false, "body": "Hello! Could you draw my half rabbit character relaxing comfortably wrapped in a blanket?\n\nIf this pose/idea is not ok, feel free to draw him in any pose and in any outfit! Thank you!\n\nhttps://imgur.com/a/FB2Ylcg", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/7", "thumbnail_src": "https://si.imgix.net/41f3e926/uploads/origins/afe8cf58-0304-4a2d-8374-55b7d7b732a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d9b34efe240ec710398e083ee35cc0", "thumbnail_srcset": "https://si.imgix.net/41f3e926/uploads/origins/afe8cf58-0304-4a2d-8374-55b7d7b732a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d9b34efe240ec710398e083ee35cc0, https://si.imgix.net/41f3e926/uploads/origins/afe8cf58-0304-4a2d-8374-55b7d7b732a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=881e18f65a806979bb096f5dd0c59892 2x, https://si.imgix.net/41f3e926/uploads/origins/afe8cf58-0304-4a2d-8374-55b7d7b732a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e644e7922ce8732dc0053c077f84a8d7 3x", "genre": "art", "nsfw": false, "body": "またまた、こんにちは!\n\n先ほどはお写真ありがとうございました！とても気に入りました。\n\nまた、同じキャラクターの恥ずかしがり屋さんや赤面症の方、かわいい方の写真をお願いしたいと思います。投稿内容や衣装はご自由にどうぞ\n\nありがとうございました。\n- バフパップ\n\nhttps://twitter.com/Buffpup_/status/1450251607208304644?s=20", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/6", "thumbnail_src": "https://si.imgix.net/15d897de/uploads/origins/80d7212e-cb34-485d-8fbc-6dbf7704beee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96aa7af5f954110ad38daad3ad3df722", "thumbnail_srcset": "https://si.imgix.net/15d897de/uploads/origins/80d7212e-cb34-485d-8fbc-6dbf7704beee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96aa7af5f954110ad38daad3ad3df722, https://si.imgix.net/15d897de/uploads/origins/80d7212e-cb34-485d-8fbc-6dbf7704beee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=387ff15528be578a7b48a2c6a0b41cc0 2x, https://si.imgix.net/15d897de/uploads/origins/80d7212e-cb34-485d-8fbc-6dbf7704beee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5d7d5a7780c1deb723bf76f5b47c28c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hao_kainushi/works/5", "thumbnail_src": "https://si