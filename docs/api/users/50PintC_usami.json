mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3f3f2dcf51f01176a4cf8e8cdde59d1 2x, https://si.imgix.net/1622d6e7/uploads/origins/507b4b3e-0481-418b-9137-897c124b3ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ef9dcb3274400051a528a5a3644968a 3x", "genre": "art", "nsfw": true, "body": "匿名で失礼致します。\n宜しければ以下の内容でご検討をお願い致します。\n\n人物\n『愛天使伝説ウェディングピーチ』のエンジェルリリィ（OVA版）\n\nシチュエーション\nチームで敗北し捕らえられ、磔にされた状態で力尽きるまで攻撃される\n※流れとしては攻撃を受ける前、攻撃を受けて声を上げて抵抗している、限界を迎えた時の\n　シーンをイメージしています。事細かく段階を踏んで頂く必要はございません\n※大まかなイメージとしては以前にお願いしたこちらの作品を合わせたようなイメージになります\nhttps://skeb.jp/@50PintC_usami/works/9\nhttps://skeb.jp/@50PintC_usami/works/12\n\n参考資料\nhttps://drive.google.com/drive/folders/1DnkZ0LgixVWSNhQnEpVf21nJosDl28bj?usp=drive_link\n\n・構図はお任せします。資料としてサンプルを添付していますが参考程度で構いません\n\n・背景についても特に指定はございません\nチームで負けたというシチュエーション上、空きがあれば背景の一部に同じく力尽きた仲間の台座があると\n嬉しいです\n※配置数はお任せで詳細な描き込みも不要、遠くに誰かが居るレベルで大丈夫です\n　必要度合いは低いため、主役と相手役を優先してください\n\n・敵役の配置をお願い致します\n仮想敵としては自身か仲間（特に主人公）の偽物・コピー・悪堕ち後を想定しています\nデザインや配色についてはそのままでも敵仕様として変更頂いても構いません\n間合いはこの時よりも近め、手が届きそうな距離をイメージしています\nhttps://skeb.jp/@50PintC_usami/works/9\n\n・便宜上NSFW対象としていますが、大きな外傷などは特に想定していません\n　衣装の損傷の有無・度合いはお任せします\n　また、弱体化した状態は前回と同じく装備の消えたレオタード姿をイメージしています\n\n・可能であれば敵、エフェクトは別々のレイヤーにして頂くかリリィ単体で閲覧できるものがあると嬉しいです\n\n\nご検討をよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/26", "thumbnail_src": "https://si.imgix.net/9a39c949/uploads/origins/31e26623-30d9-4261-8ec7-7dcf3eff1131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db7448b774b7b02b14e09afc1f740213", "thumbnail_srcset": "https://si.imgix.net/9a39c949/uploads/origins/31e26623-30d9-4261-8ec7-7dcf3eff1131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db7448b774b7b02b14e09afc1f740213, https://si.imgix.net/9a39c949/uploads/origins/31e26623-30d9-4261-8ec7-7dcf3eff1131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17795438c9727bd7b3975832b6b35f25 2x, https://si.imgix.net/9a39c949/uploads/origins/31e26623-30d9-4261-8ec7-7dcf3eff1131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33e3f7eb2bf0429907e52dd82a6702a9 3x", "genre": "art", "nsfw": false, "body": "匿名にて失礼いたします。\n先日は納品ありがとうございました。\nまた同じ作品からの依頼になりますが、宜しければお願いします。\n\n【キャラクター】\n『愛天使伝説ウェディングピーチ』のピーチ・リリィ・デイジー3人\n\n【詳細】\n・雪山での戦いで三人が必死に立ち上がろうとしていて、それを敵が余裕の表情で見ているところ\n・ピーチがメインでリリィとデイジーは横や後ろ姿や遠めでも構いませんが、全員立ち上がる途中の辛そうな表情で\n・三人とも過去のイラストと同程度のダメージ跡を\n・敵の姿も後ろ姿や見切れていても可\n・構図はお任せします\n\n以上となります、ご検討宜しくお願い致します。\n\n\n資料\nhttps://imgur.com/a/JTv5Gc6\nhttps://imgur.com/a/FVNXvOf", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/25", "thumbnail_src": "https://si.imgix.net/3cc1bc8d/uploads/origins/df31363c-2b9c-4939-8fc9-5672d2e3ac05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7fc4a41088539c0299c610331828a86", "thumbnail_srcset": "https://si.imgix.net/3cc1bc8d/uploads/origins/df31363c-2b9c-4939-8fc9-5672d2e3ac05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7fc4a41088539c0299c610331828a86, https://si.imgix.net/3cc1bc8d/uploads/origins/df31363c-2b9c-4939-8fc9-5672d2e3ac05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95b01494107bc888b5476bed24299f99 2x, https://si.imgix.net/3cc1bc8d/uploads/origins/df31363c-2b9c-4939-8fc9-5672d2e3ac05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f2bec21be13b69e0397220c69e8ce66 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nディテールまで丁寧に表現されている衣装の描写や、質感まで感じられる液体描写等が気に入り、リクエストをお願いしたくなりました。\nNTRモノでも宜しければ、以下のカラーイラストをお願い致します。\n\n●キャラクター\n宝多六花(ssss gridman)\n季節外れですが、こちら(https://tsundora.com/ssss_gridman_133,資料URL)の制服(濃紺ブレザー+ベスト、スカート、黒パンスト)を履かせ、ショーツは白でお描き下さい。\n※マフラー、イヤホンは不要です。\n\n制服詳細\nhttps://asahiwa.jp/f/gridman_rikka_seifuku.html\n\n●シチュエーション\n満員電車内で、知らない男性に背後から痴漢されている六花。\n背景は満員電車内のイメージです。\n\n●描いて頂きたい点\n①背後から痴漢されている六花を正面側から見たカット、②背後から見たお尻側のアップをカットインでお描き下さい。\n\nご参考構図\nhttp://cloud.akibablog.net/2018/sep/13/josikausei/103a.jpg, https://livedoor.blogimg.jp/gazou2zigen/imgs/2/6/26e896bd.jpg\n\n▪︎詳細な内容\n①正面側のカット\n・痴漢加害者は一人のみでお描き下さい。背後から六花のお尻や股間周辺をこっそりと触り、弄っているイメージです。\n\n・六花は片手でポールを握りしめ、片手でめくれ上がるスカートを必死に押さえているポーズです。頬や耳を真っ赤にさせ、涙を流して嫌がっている表情をお描き下さい。\n(車内の暖房や痴漢の所為で)しっとりと脂汗をかかせて下さい。\n\n・パンストは股間部分が破かれて、ショーツと共に愛液にまみれ、ぬらぬらと染みになっているようにお描き下さい（痴漢から手マンされた直後のイメージです）。\n\n②お尻側のアップ\n・お尻部分のパンストも破かれて、裂け目から純白のショーツがのぞいているイメージです。\n痴漢の手が、六花のスカートで愛液を拭っている様子も描写下さい。\n\n●ファイル\nPSDデータにて、人物と背景は別レイヤーにてお願いします。可能であれば未結合データも付けて下さい。\n\n複雑になってしまい申し訳ありません。ご対応が困難でしたら、キャンセルか再送依頼下さい\n\nhttps://ogre.natalie.mu/media/news/comic/2019/0605/ssss01.jpg?imwidth=750&imdensity=1", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/24", "thumbnail_src": "https://si.imgix.net/7ba53218/uploads/origins/2a4a8778-6320-4518-b8e2-5656da3ab301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d66d7f8730ac5c5d06a847179f00824f", "thumbnail_srcset": "https://si.imgix.net/7ba53218/uploads/origins/2a4a8778-6320-4518-b8e2-5656da3ab301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d66d7f8730ac5c5d06a847179f00824f, https://si.imgix.net/7ba53218/uploads/origins/2a4a8778-6320-4518-b8e2-5656da3ab301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7422d4ee4d5d596ae940a6ef7822d419 2x, https://si.imgix.net/7ba53218/uploads/origins/2a4a8778-6320-4518-b8e2-5656da3ab301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62bfecc24039c655f9e5f1f6ef9e04ba 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n宜しければ下記イラストお願いできないでしょうか。\n\n【キャラ】\n「狙われた女神天使エンゼルティアー」より、倉澤杏\n\n【シチュエーション・構図】\n倉澤杏の本編に採用されなかった設定であるシャイニーキュアが、\n変身バンクの最後にポーズを決める姿の全身絵をお願いします。\n\n【服装・髪色・瞳色差分】\n①シャイニーキュア（設定画どおり）\n\n②全裸の倉澤杏（変身前）\n■髪が藍色から黒色に。瞳が黄色から緑色に。\n■金属製の髪飾りが、紫色のシュシュに。\n\n③シャイニーキュア（アレンジver）\n■塗り残しと想定される部分を着色して下さい。（資料：赤部分）\n■胸部のインナーが他２人の女神天使と同様にバストを覆わず、\n　アンダーバストまでの状態にして下さい。（資料：ピンク部分が肌が見える状態）\n■変身後の髪色を別パターンで２つお願いします。\n　１つは、他２人の女神天使を見ると服のメインカラーの隣の色相が髪色になっているので、\n　緑色の隣の色相（水色や青みがかった緑色のあたり）で、もう1つの髪色は自由です。\n\n④全裸のシャイニーキュア\n\n【その他】\nエフェクト、背景、汗等については、レイヤーでオン・オフできるようにお願いします。\n\n以上、要望多く誠に恐縮ですが、何卒ご検討下さいますよう宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1E1HGohZ0df-dOtipE3kHyeNbhCzON6t9?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/23", "thumbnail_src": "https://si.imgix.net/82f7c391/uploads/origins/4c684e18-8824-4320-84a4-f149e5bc08bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c6b7c54a5bbf23a1cd7c4cb9886145b", "thumbnail_srcset": "https://si.imgix.net/82f7c391/uploads/origins/4c684e18-8824-4320-84a4-f149e5bc08bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c6b7c54a5bbf23a1cd7c4cb9886145b, https://si.imgix.net/82f7c391/uploads/origins/4c684e18-8824-4320-84a4-f149e5bc08bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3724817293602c193444b2b2535bd150 2x, https://si.imgix.net/82f7c391/uploads/origins/4c684e18-8824-4320-84a4-f149e5bc08bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd3fb056c4ca3623db5f6c8df66babe5 3x", "genre": "art", "nsfw": true, "body": "先に電影少女ものを依頼した者です。\n素敵なイラストをありがとうございました。\n\nもしよろしければ、追加で先のイラストの\n続きをリクエストをしてもよろしいでしょうか？\n\nシチュとしては、原作にあります、全裸・透明化された天野あいが神尾まいに抱き寄せられ、胸に口づけ、その後心臓に磁力（電撃）を流し込まれる場面をお願いします。\n\n可能でしたら、抱き寄せられた際のぐったりとした表情、胸に口づけされた際のピクリとした表情、磁力を流し込まれた際の苦悶、磁力（電撃）を中断した際に身体の透明化が進行し弱った様子など、可能な範囲で差分がありますとありがたいです。\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/22", "thumbnail_src": "https://si.imgix.net/9f6af1f1/uploads/origins/85c0450e-744f-41af-bacb-708f1b9580da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02db67edf09d937be9035b759522cf3", "thumbnail_srcset": "https://si.imgix.net/9f6af1f1/uploads/origins/85c0450e-744f-41af-bacb-708f1b9580da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02db67edf09d937be9035b759522cf3, https://si.imgix.net/9f6af1f1/uploads/origins/85c0450e-744f-41af-bacb-708f1b9580da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e61bceee7127e77070d68ec3e410c532 2x, https://si.imgix.net/9f6af1f1/uploads/origins/85c0450e-744f-41af-bacb-708f1b9580da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9228ecb2eddcbb47e009adbc9daf85aa 3x", "genre": "art", "nsfw": true, "body": "50pointcaliper（うさみする）様\nこんにちは！\n前回はとても素晴しいフミナ先輩をありがとうございます！(https://skeb.jp/@50PintC_usami/works/14)\nまた、作者様の絵柄で描いていただきたくてリクエストしました！\nもし、宜しければ承認お願いいたします！\n\nリクエスト内容はグリッドマンユニバースの宝多六花と響裕太がいちゃラブセックスしているシーンをお願いします!\n\n服装は、制服姿で、\n六花の方は半脱ぎで胸を露出している。スカートは捲りあげているか、脱いでいて、下着は着けていない。\n(難しければ全裸でokです)\n裕太の方は最低限の表現で、顔等は画面外で問題ありません\n\n体位はおまかせしたいのですが、挿入部が見える構図にしていただけると嬉しいです。\n\n可能であれば、差分として以下を作成お願いします。\n\n1.挿入前でちん◯の先っぽがまん◯の入口にくちゅっと当たっている姿\n2.セックス中の姿(ちょっと激しめに攻められている感じにしていただけると嬉しいです！)\n3.中出し一緒に絶頂している姿\n4.ちん○が抜けたまん○から、精液がこぼれ出していてハァハァしながらも嬉しそうな姿\n\nどうか、ご検討のほど宜しくお願いいたします！\n以下キャラクターの資料です。\nhttps://ssss-movie.net/#character", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/21", "thumbnail_src": "https://si.imgix.net/022e83a0/uploads/origins/630f3ea3-8ca1-4597-85d8-8475e826cae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741b9c8174e61dc302137a787434d777", "thumbnail_srcset": "https://si.imgix.net/022e83a0/uploads/origins/630f3ea3-8ca1-4597-85d8-8475e826cae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741b9c8174e61dc302137a787434d777, https://si.imgix.net/022e83a0/uploads/origins/630f3ea3-8ca1-4597-85d8-8475e826cae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a43d3185bf7d7e780b63ab42f002174 2x, https://si.imgix.net/022e83a0/uploads/origins/630f3ea3-8ca1-4597-85d8-8475e826cae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71dbb1719861c7a0703b6e83e59ab2c1 3x", "genre": "art", "nsfw": false, "body": "匿名で失礼致します。\n\n『愛天使伝説ウェディングピーチ』のエンジェルリリィのイラストをお願いします。\n\nシチュエーションは雪山でうつ伏せに倒れた状態から上体を起こした体勢で、\n・仲間に手を差し伸べられ安堵した表情\n・突然足が凍り付き始め驚愕の表情\n・凍結が広がり絶望の表情を浮かべたまま完全に氷漬けになってしまう\n以上の差分をお願いします。\n\n補足として、\n・リリィの体やコスチュームに軽いダメージ跡を（過去に描かれていたリリィのイラストと同程度で構いません）\n・仲間に姿は後ろ姿、或いは伸ばした手のみでも構いません\n・構図はお任せします\n\n以上となります、ご検討宜しくお願い致します。\n\n参考資料\nhttps://imgur.com/a/IntCHQR\nhttps://imgur.com/a/FJezHgs", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/20", "thumbnail_src": "https://si.imgix.net/f46f4389/uploads/origins/91c46ac9-77dd-45d7-a5cc-a440724a5e18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0fa7ac73c621c464c4a6f5c9669c5f4", "thumbnail_srcset": "https://si.imgix.net/f46f4389/uploads/origins/91c46ac9-77dd-45d7-a5cc-a440724a5e18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0fa7ac73c621c464c4a6f5c9669c5f4, https://si.imgix.net/f46f4389/uploads/origins/91c46ac9-77dd-45d7-a5cc-a440724a5e18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f74266d660cae81bc4e46d15d859579a 2x, https://si.imgix.net/f46f4389/uploads/origins/91c46ac9-77dd-45d7-a5cc-a440724a5e18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf8de64972e0723c02e0fd0b147b45d3 3x", "genre": "art", "nsfw": true, "body": "好みの絵柄でしたので、初リクエスト失礼します。\n古い作品ですが、桂正和作の電影少女から、ヒロインの天野あいが敵役の神尾まいに襲撃されるシーンのイラストをお願いします。\n\nhttps://i.imgur.com/mDQ6ThN.jpeg\nhttps://imgur.com/12JnZk2\nhttps://imgur.com/C5eofuP\nhttps://imgur.com/20xFOT9\n\nこのうち、ヒロインのあいが敵役のまい（黒髪）から逃げていたものの捕まり、シーン切り替え時には電撃を受けて靴・靴下除いて全裸となっている展開があるのですが、そちらを描いて頂くことは可能でしょうか？\n\n当初は僅かに抵抗する意思があるものの、電撃を受けて服を弾き飛ばされ、力なく横たわる感じで。また、可能であれば、電撃を受けて以後は身体が透けるような描写を入れて頂けますと幸いです。\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/19", "thumbnail_src": "https://si.imgix.net/68520e1c/uploads/origins/f878b4cf-1b99-4eee-99da-cc324bd5ca1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8a60b9509a8d93d49aa2a090d1b79ab", "thumbnail_srcset": "https://si.imgix.net/68520e1c/uploads/origins/f878b4cf-1b99-4eee-99da-cc324bd5ca1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8a60b9509a8d93d49aa2a090d1b79ab, https://si.imgix.net/68520e1c/uploads/origins/f878b4cf-1b99-4eee-99da-cc324bd5ca1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8742d99baf9aea535ea97af7dbd00217 2x, https://si.imgix.net/68520e1c/uploads/origins/f878b4cf-1b99-4eee-99da-cc324bd5ca1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d40c9f14221ab3f8d3f1051ee072dc4d 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nよろしければ、下記のイラストをお願いできないでしょうか。\n\n【キャラ】\n「ユニコーンオーバーロード」より、スカーレット\n\n【シチュエーション・構図】\nベッドの上でのイチャラブ正常位エッチをお願いしたいです。\n\n【服装差分】\n①着衣（第一希望として告白時の「ハイプリーステス」ですが、描きにくければ「私服」「プリーステス」でも可です。）\n②下着姿（設定ないのでデザインお任せしますが、下着の色は『白』でお嬢様らしい感じだと嬉しいです。）\n③全裸\n\n【表情・描写差分】\n①ベッドの上に押し倒されて、これからする本番行為にドキドキしている姿\n②挿入されて、好きな人と繋がっている喜びと快感に、気持ち良いと感じている姿\n③中出しと同時に絶頂している姿\n④事後、秘部から精液が溢れて、荒く息を吐きながらも幸せそうな姿\n\n【その他】\n■エフェクト、背景については、レイヤーでオン・オフできるようにお願いします。\n■「ハイプリーステス」「プリーステス」の服装については、タイツではありません。\n　設定画を見ればわかる通り、ニーソックスとなっております。\n\n以上、要望が非常に多く誠に恐縮ですが、ご何卒ご検討下さいますよう宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1mPmJTpYkud3cV8LV1VOECoAvTmo-fDYg?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/18", "thumbnail_src": "https://si.imgix.net/292c129e/uploads/origins/eff46427-7e98-4f9c-8aa5-e187eea7a516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4018baabc97fcc60ecd135ed5a5105a2", "thumbnail_srcset": "https://si.imgix.net/292c129e/uploads/origins/eff46427-7e98-4f9c-8aa5-e187eea7a516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4018baabc97fcc60ecd135ed5a5105a2, https://si.imgix.net/292c129e/uploads/origins/eff46427-7e98-4f9c-8aa5-e187eea7a516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2040a6b6bcf82e3d83aa43326c830d2 2x, https://si.imgix.net/292c129e/uploads/origins/eff46427-7e98-4f9c-8aa5-e187eea7a516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1823bef20e6b3f31bab86cee3f8f6f6 3x", "genre": "art", "nsfw": true, "body": "前回はお世話になりました。\nよろしければ、下記のイラストをお願いできないでしょうか。\n\n【キャラ】\n「光翼戦姫エクスティア３」より、エクスティア(葛城真理奈)\n\n【シチュエーション・構図】\n敵に止めを刺すべく、頭上に構えた武器(剣状態)を振り下ろして\n必殺技を放つ凛とした正義のヒロインの全身絵をお願いしたいです。\n\n【その他】\n青みがかった白い翼、必殺技等のエフェクト、背景については、\nレイヤーでオン・オフできるようにお願いします。\n\n【服装差分】\n①フル装備(無傷)\n②スカートパーツと背中から伸びる布マフラーが取り外された状態かつ、\n　スーツの各部分が破損している状態\n③全裸（頭部はヘッドパーツとリボンが外した状態）\n\n【表情差分】\n①口を真一文字に結び、毅然とした瞳・表情\n②裂帛の気合いで、大きな声を上げる表情\n③微笑み\n\n服装差分と表情差分は、①②③の順で優先して可能な範囲内で構いません。\n以上、要望が非常に多く誠に恐縮ですが、ご何卒ご検討下さいますよう宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1n-UK_D988ynZJW6LzjAxjiVpNr_QOTUC?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@50PintC_usami/works/17", "thumbnail_src": "https://si.imgix.net/a175a605/uploads/origins/529897fd-9839-4979-8d00-bd73eb6ac25d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b455cccc98649c1535db8457a580070", "thumbnail_srcset": "https://si.imgix.net/a175a605/uploads/origins/529897fd-9839-4979-8d00-bd73eb6ac25d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b455cccc98649c1535db8457a580070, https://si.imgix.net/a175a605/uploads/origins/529897fd-9839-4979-8d00-bd73eb6ac25d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=769cbbf0fd79efdd3a9f0259ffdb132e 2x, https://si.imgix.net/a175a605/uploads/origins/529897fd-9839-4979-8d00-bd73eb6ac25d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFF