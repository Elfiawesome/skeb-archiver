00&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bae894975fa69acb1e0239f95d7fee0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/21", "thumbnail_src": "https://si.imgix.net/e356f06d/uploads/origins/7fb23d74-e4ec-419d-8c30-c674585dad15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d894bdc8276c734f9a17e17802ecd5e8", "thumbnail_srcset": "https://si.imgix.net/e356f06d/uploads/origins/7fb23d74-e4ec-419d-8c30-c674585dad15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d894bdc8276c734f9a17e17802ecd5e8, https://si.imgix.net/e356f06d/uploads/origins/7fb23d74-e4ec-419d-8c30-c674585dad15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f42cdfcda08e9bc860ee639e67044420 2x, https://si.imgix.net/e356f06d/uploads/origins/7fb23d74-e4ec-419d-8c30-c674585dad15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7789fb85e4930659d989a6fb8da1a4aa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/20", "thumbnail_src": "https://si.imgix.net/866cd441/uploads/origins/4cd7a380-ed35-4976-9599-4392caf202ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce54c0a4464f7b3ef7c81ad7bd9b0b0e", "thumbnail_srcset": "https://si.imgix.net/866cd441/uploads/origins/4cd7a380-ed35-4976-9599-4392caf202ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce54c0a4464f7b3ef7c81ad7bd9b0b0e, https://si.imgix.net/866cd441/uploads/origins/4cd7a380-ed35-4976-9599-4392caf202ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08b56ce577e075cb31b75487d5cde7be 2x, https://si.imgix.net/866cd441/uploads/origins/4cd7a380-ed35-4976-9599-4392caf202ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=314addc0bd3e3c0f9a1600f36bb25300 3x", "genre": "art", "nsfw": true, "body": "連続でのリクエスト失礼します…！\nフェラ大垣がすごく良かったのでその続きでデカチンにオナホにされる大垣をお願いしたいです！\n\n以前描かれてらした大垣の後ろからおっぱい揉んでる絵がすごくスケベだったので、制服着た大垣の後ろから胸を揉み潰しつつ全く萎えないデカチンポで後ろから子宮バコバコド突き回して大垣を激しくオホらせて欲しいです\n\n「あっ❤️そんなおっぱい激しくっ❤️お゛っ❤️ダメっすよ？❤️女の子は優しくしないと…おっごぉ゛っ❤️❤️❤️」\nいきなり根元まで挿入し、服の上からでもわかるほどデカチンポで腹ボコさせまくって大垣におっさんのチンポケースとしての自覚を叩き込む\n「このっ❤️チンポッ❤️ヤバすぎっ❤️女の子チンポ奴隷にらするためのチンポっ❤️お゛っ❤️お゛っ❤️お゛っ❤️」\nコキ捨てるためだけの身勝手な全力ピストンでまんこをほじくり回し、まず1発目大量に中出しして、軽くザーボテ\n\n\nまだまだ萎えないまま2ラウンド目が始まりザーメンで満たされてる子宮を構わず全力でデカチンポでド突き回される\n「なんでっ❤️まだデカくなるんすかっ❤️ヤバすぎっ❤️あ゛っ死ぬっ❤️チンポで死ぬイキ死ぬっ❤️ほぉっ❤️おっほぉぉぉぉっ❤️❤️」\nそして本気の射精、今までの射精量と比べ物にならないほどザーメンをブチ込まれ続け完全に妊娠したみたいに大垣のお腹がザーメンで大きくボテボテになり下品なメスブタみたいな声を出しながらイキ狂う大垣\n\n「絶対…❤️デキたぁ…❤️責任取って…くださいよぉ…？❤️」\n前のフェラ絵のセリフがめちゃくちゃエッチだったのでセリフが多めだととても嬉しいです！\n\nそれと料金の範囲内でありましたら大垣のメガネのガラス部分を真っ白で塗った差分（以前描いたらしたデカチンガキx大垣みたいなメガネ表現）があると嬉しいです！\n\n細かくなりましたがご検討くだされば幸いです…！！", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/19", "thumbnail_src": "https://si.imgix.net/ca963473/uploads/origins/9fbf00de-4509-4c6a-985f-e78f30bf1867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a2c318e0369244f583f3447efc7b8b", "thumbnail_srcset": "https://si.imgix.net/ca963473/uploads/origins/9fbf00de-4509-4c6a-985f-e78f30bf1867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a2c318e0369244f583f3447efc7b8b, https://si.imgix.net/ca963473/uploads/origins/9fbf00de-4509-4c6a-985f-e78f30bf1867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60124273f2da0e1f1f585f2669ea10b0 2x, https://si.imgix.net/ca963473/uploads/origins/9fbf00de-4509-4c6a-985f-e78f30bf1867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=befbefe3033c67598b25e21a0bc42f94 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します！\nオマユさんの大垣がすごく好きなのでフェラ大垣が見たいです…！\n\n・デカチンポの先っちょを淫語射精媚びしながらデカい舌でベロベロ舐めまくり射精されたらひょっとこフェラで全部飲み干す\n・まだチンポバキバキのままで、搾れそうだから咥えたまま根元までガポガポイラマフェラ、大量射精からのザーメンゲップ\n\nザーメン量は多ければ多いほど良くて、服は制服でお願いします…！\nご検討くだされば幸いです…！", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/18", "thumbnail_src": "https://si.imgix.net/7deb8afe/uploads/origins/794ec834-fb6a-4bb0-980f-0fcae0c6c1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=048d17b03d5baf88db9a3ff9e1428902", "thumbnail_srcset": "https://si.imgix.net/7deb8afe/uploads/origins/794ec834-fb6a-4bb0-980f-0fcae0c6c1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=048d17b03d5baf88db9a3ff9e1428902, https://si.imgix.net/7deb8afe/uploads/origins/794ec834-fb6a-4bb0-980f-0fcae0c6c1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f3620bf775d6dfa4c37a565b8e59039 2x, https://si.imgix.net/7deb8afe/uploads/origins/794ec834-fb6a-4bb0-980f-0fcae0c6c1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6bbdf31f752f6f7f918bfa44d39455b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/17", "thumbnail_src": "https://si.imgix.net/06691a87/uploads/origins/94c0df0f-941e-479d-b316-bb2a574ca3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feb6a194293447287794a92b55ec6eb0", "thumbnail_srcset": "https://si.imgix.net/06691a87/uploads/origins/94c0df0f-941e-479d-b316-bb2a574ca3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feb6a194293447287794a92b55ec6eb0, https://si.imgix.net/06691a87/uploads/origins/94c0df0f-941e-479d-b316-bb2a574ca3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3d3369c0e52ec4ce9bb8eec8b8e5b21 2x, https://si.imgix.net/06691a87/uploads/origins/94c0df0f-941e-479d-b316-bb2a574ca3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4a5ad2ddd73bc7a9942a54b9725d4cc 3x", "genre": "art", "nsfw": true, "body": "エロいイラストをお願いしたいです！\n私のアイデアは、とても大きくて太ったアマンダ・オニールと、ルイス・ブラックウェルの若くて背の低いバージョンをキャラクターにすることです。\nアイデアは、最初のコマで2人が横抱きをしていて、アマンダがルイスに近づくためにしゃがんでいるところです。アマンダはとてもエッチな表情をしています。ルイスは心配そうで怒っているように見えます。\n2番目のコマでは、とてもエッチなセックスシーンに巻き込まれています。この部分ではルイスのペニスはとても大きく、アマンダの表情は本当に状況を楽しんでいます。\nルイスの表情は興奮から感動まで何でも構いません。\nエロいコマの服装やポーズについては、特に指定はないので、お好きなように描いてください！\nエロいシーンでお願いしたいのは、2人ともアナルセックスをすることです。それだけです！", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/16", "thumbnail_src": "https://si.imgix.net/8d2c8bce/uploads/origins/ab268bf5-f07e-44c7-af17-dbbb839cfda7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=093b4277ecbf861bcd7f62abc09b9ee8", "thumbnail_srcset": "https://si.imgix.net/8d2c8bce/uploads/origins/ab268bf5-f07e-44c7-af17-dbbb839cfda7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=093b4277ecbf861bcd7f62abc09b9ee8, https://si.imgix.net/8d2c8bce/uploads/origins/ab268bf5-f07e-44c7-af17-dbbb839cfda7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc5e9cd75d7681510fe72a48eaffccdf 2x, https://si.imgix.net/8d2c8bce/uploads/origins/ab268bf5-f07e-44c7-af17-dbbb839cfda7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=502cc199fa8f5a32167486c068b2dec2 3x", "genre": "art", "nsfw": true, "body": "巨根ショタ、人外になりますが、私の推しキャラ「ポリニアンのルシオくん」を描いてください。 \n公式：http://www.daibadi.com/list6_08.htm \n我が家設定や希望の格好等：https://x.com/kagiakaromsen/status/1843151523972628550\nツリーにも、フィギュア写真や過去依頼絵の追加資料があります。  \n彼はツリ目でやんちゃなライフセイバー（救助隊員）の少年です。 「男の娘」ではなく「少年」です。\n\n＜描いてほしいイラスト＞\nルシオの格好は我が家設定にある衣装[B]。\n上半身は赤と黒の長袖ラッシュガードに、下半身はブーメランパンツ水着。ただしラッシュガードは３枚目のイラストのように前開きで。 \n描いて欲しいシチュエーションは、ルシオくんのペニス（元々20cm超えの巨根）が突然爆根サイズの勃起状態（80cmくらい）になり、「うわっ、どうしよう… これじゃパンツに収まらないよ！」と困惑している様子。\n爆根の竿や玉のサイズ、表情や構図のイメージは、貴方のリリィちゃんの下記イラストです。\nhttps://www.pixiv.net/artworks/90693956\nペニスは当然水着には入り切らず、なんとか持ち上げようとしますが、玉すら収納できない。もちろん露出したペニスはギンギン状態かつズル剥けです。ペニスの修正はモザイクではなく、黒線を優先してください。\nなお、もし可能であれば、水着がペニスにぴっちり貼り付くような形で（もはやコンドームのように）履けている差分がいただけると嬉しいです。（表情は特に変えなくてもいいです。また、金額的に難しいなら対応不要）\n\n＜最後に補足：ポリニアンとは＞ \n簡単に言うと、身体の組成が無機物の人間です。 白い肌と露出した関節球体を持っています。 ロボットのように見えますが、皮膚は人間と同じ感じです。 ただし髪の毛はパーツのように固定形状となっていて形は変わりません。 また、今回着ているラッシュガードや水着は人間が着ているものと同じ布製です。 http://www.daibadi.com/porynian02_02.htm　（読まなくていいですが、公式の説明）", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/15", "thumbnail_src": "https://si.imgix.net/f1d74b91/uploads/origins/7f177ef7-d2e7-4bb8-bc9a-c3cd3f1c5e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edb8f683217980c8e85f72712c3c85a6", "thumbnail_srcset": "https://si.imgix.net/f1d74b91/uploads/origins/7f177ef7-d2e7-4bb8-bc9a-c3cd3f1c5e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edb8f683217980c8e85f72712c3c85a6, https://si.imgix.net/f1d74b91/uploads/origins/7f177ef7-d2e7-4bb8-bc9a-c3cd3f1c5e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52cd6b99516e84abe947c2786bc02ae7 2x, https://si.imgix.net/f1d74b91/uploads/origins/7f177ef7-d2e7-4bb8-bc9a-c3cd3f1c5e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dd8468b8ab95cd1a2e89ad1a178199c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/14", "thumbnail_src": "https://si.imgix.net/1aef306c/uploads/origins/6249e469-b26f-440a-8ae3-1d28930632ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=093c4d0dc9f0ba1359c897bbf021910c", "thumbnail_srcset": "https://si.imgix.net/1aef306c/uploads/origins/6249e469-b26f-440a-8ae3-1d28930632ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=093c4d0dc9f0ba1359c897bbf021910c, https://si.imgix.net/1aef306c/uploads/origins/6249e469-b26f-440a-8ae3-1d28930632ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=504357656ee8a15c69eea6bf5325aa78 2x, https://si.imgix.net/1aef306c/uploads/origins/6249e469-b26f-440a-8ae3-1d28930632ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5176eb3fdf90b5fb18f27fa27ccc0d6e 3x", "genre": "art", "nsfw": true, "body": "こんにちは！すごくエッチなアイデアを思いつきました。2コマかスケッチのどちらかにしようと思っています。どちらのコマも、ニワトリのコスチュームを着た巨乳のサキちゃんが描かれています。同じシリーズのリリィちゃんもいます。リリィちゃんの服はどんなものでも構いませんし、裸でも構いません。最初のコマでは、リリィちゃんがサキちゃんを後ろから貫いていますが、立ったままではなかなか届かないので、サキちゃんに届いて貫くにはお尻の上に少し登らなければなりません。2番目のコマでは、リリィちゃんがサキちゃんに交尾プレスの体位をとっています。楽しみにしています！あなたの絵と、女の子が興奮しているときのエロティックな表現が大好きです。どうもありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/13", "thumbnail_src": "https://si.imgix.net/76cb0f9e/uploads/origins/e2b7df27-2c1d-4e4e-a459-a99785494559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0eca1d22051a5aee0abb3d6b59e1085", "thumbnail_srcset": "https://si.imgix.net/76cb0f9e/uploads/origins/e2b7df27-2c1d-4e4e-a459-a99785494559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0eca1d22051a5aee0abb3d6b59e1085, https://si.imgix.net/76cb0f9e/uploads/origins/e2b7df27-2c1d-4e4e-a459-a99785494559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cf2b487dd44463b87162c7652709c5e 2x, https://si.imgix.net/76cb0f9e/uploads/origins/e2b7df27-2c1d-4e4e-a459-a99785494559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c69ffed6511c61882f3a397c83017d2 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nこちらの「https://www.pixiv.net/artworks/101688732」ゆずこのような感じで嫌々玉舐めさせられてる\nゆるゆりの吉川ちなつをお願いします。\n\n差分で玉舐めで気持ちよくなった男がそのまま射精して上から降ってきた精液がかかりぶっかけられた感じになってるちなつをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/12", "thumbnail_src": "https://si.imgix.net/1eca7de7/uploads/origins/cef88c9c-eab2-4682-be63-925973967114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5527147ed1b92804de40ec07e80a4be", "thumbnail_srcset": "https://si.imgix.net/1eca7de7/uploads/origins/cef88c9c-eab2-4682-be63-925973967114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5527147ed1b92804de40ec07e80a4be, https://si.imgix.net/1eca7de7/uploads/origins/cef88c9c-eab2-4682-be63-925973967114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f661a8ea0479f5881c96cdd351de90b 2x, https://si.imgix.net/1eca7de7/uploads/origins/cef88c9c-eab2-4682-be63-925973967114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10be6cdcadbbc01dbe478fcaccb245d3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3norin_/works/11", "thumbnail_src": "https://si.imgix.net/c400aa55/uploads/origins/4ac74ebe-41f8-4524-b313-e121d127b75a?bg=%23ff