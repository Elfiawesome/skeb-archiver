op=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1730cb2250164d0956ec391094eb57ec", "thumbnail_srcset": "https://si.imgix.net/6f883c4a/uploads/origins/080d3477-9bb1-4567-b057-8f99445086ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1730cb2250164d0956ec391094eb57ec, https://si.imgix.net/6f883c4a/uploads/origins/080d3477-9bb1-4567-b057-8f99445086ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7df5dd7a95ac808be5a59c2bd6d8ad5f 2x, https://si.imgix.net/6f883c4a/uploads/origins/080d3477-9bb1-4567-b057-8f99445086ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73b9ea497e9021369e70c539ee250b7a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/22", "thumbnail_src": "https://si.imgix.net/dd255778/uploads/origins/f2f6ac51-ee70-4977-90ee-6cc238ee2566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=181ee61846abca5be23b5028cfcbf0e1", "thumbnail_srcset": "https://si.imgix.net/dd255778/uploads/origins/f2f6ac51-ee70-4977-90ee-6cc238ee2566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=181ee61846abca5be23b5028cfcbf0e1, https://si.imgix.net/dd255778/uploads/origins/f2f6ac51-ee70-4977-90ee-6cc238ee2566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97d33aa2fb80fd2f6b6713aa3b830f48 2x, https://si.imgix.net/dd255778/uploads/origins/f2f6ac51-ee70-4977-90ee-6cc238ee2566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15724827071fccf641a90287b38276ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/21", "thumbnail_src": "https://si.imgix.net/01db4b91/uploads/origins/a862f95d-636e-445f-bed3-4f6c343303eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154f0eebe0dafaa7654307865914b4e0", "thumbnail_srcset": "https://si.imgix.net/01db4b91/uploads/origins/a862f95d-636e-445f-bed3-4f6c343303eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154f0eebe0dafaa7654307865914b4e0, https://si.imgix.net/01db4b91/uploads/origins/a862f95d-636e-445f-bed3-4f6c343303eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dce0c14be0423eb5fb12edcd200333f 2x, https://si.imgix.net/01db4b91/uploads/origins/a862f95d-636e-445f-bed3-4f6c343303eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=511ec1f52075014c80affac3c79f2677 3x", "genre": "art", "nsfw": true, "body": "はじめての依頼をさせて頂きます。\n臭い系の依頼になります。\n先生の女子校オノユリ学園の作品のファンで、\nこんな部活があったらとリクエストさせていただきました。\n\nテーマは「汚風俗部」\n\n顧問は私がAIで作成しているラビア（シーメール化希望）をお願いします。\n一人称は私で髪色はメインが銀髪で毛先にグラデーションで青や紫が混じっています。この（https://www.pixiv.net/artworks/105950958）１枚目のような感じです。なお髪の長さは、肩ぐらいで構いません。体の特徴は大きめの乳輪と腋毛の剃り残しと濃いめの陰毛です。\n \n内容は風俗部体験入部の少年（女装子）がベットで待っていると、全身タイツのラビアが入室、最初はとても良い香りが漂うが、彼女がタイツを脱いだ瞬間、様々な臭いが迫ってくる。\nラビア「1週間ぶりに脱いだの、これ。すごいでしょ坊や♥」\nするとチンポはたちまちフル勃起。\nそれを見たラビアに襲われ、なすすべなく何度も絶頂。（細かな臭いプレイは先生のお好みにおまかせします。腋責めがあると嬉しいです。）\n\n最後に少年は鼻フックをつけられ、白目をむきながら入部を宣言し、ペニスをいじらずに射精をし至高の絶頂を迎える。", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/20", "thumbnail_src": "https://si.imgix.net/f0716c87/uploads/origins/89cbb3d9-433f-4c01-85ba-43506846e688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7119d6f2c9ae8e78d34e6839a344abe", "thumbnail_srcset": "https://si.imgix.net/f0716c87/uploads/origins/89cbb3d9-433f-4c01-85ba-43506846e688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7119d6f2c9ae8e78d34e6839a344abe, https://si.imgix.net/f0716c87/uploads/origins/89cbb3d9-433f-4c01-85ba-43506846e688?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=636ef6f6f49c8046d7d060a22fb80aad 2x, https://si.imgix.net/f0716c87/uploads/origins/89cbb3d9-433f-4c01-85ba-43506846e688?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=928befa9e8e1a71f0ddb417ee5d80671 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nオノユリ学園読ませて頂きました。\n汗蒸れのピッチリコスチュームの男の娘が大好きなので機会があれば漫画を描いて頂きたいと思っておりました。\nイラストではなく漫画のリクエストになってしまいますので無理であればキャンセルしていただければと思います。\n\n３～４ページくらいのモノクロ漫画。\n内容は以下の通りです。\n男の娘だけの部活動「ブルマ部」の新入生歓迎会。\nまず先輩男の娘がブルマ履いたままオナニー→ブルマの中に射精。\nそのブルマを脱ぎ2人目の先輩がそれを履く。\nその先輩もブルマ履いたままオナニー→ブルマの中に射精。\n2人分の精液でドロドロになったブルマを新入部員の男の娘が先輩たちに履かされる。\n「ダメダメ！こんなの履いたら私絶対おかしくなっちゃう！」\n新入部員の子は履いた瞬間にブルマの中に射精。\n先輩たちは「まだまだこれからだよ！」と言ってブルマの上からチ〇ポをさらにシコシコ。\n新入部員の子は絞りつくされてブルマはもう精液漬けになってしまう。\n\nご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/19", "thumbnail_src": "https://si.imgix.net/9f3b1acf/uploads/origins/b1a3630a-4ede-43e5-85bc-2425580b6834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=127590e1437f10f6d06f3ffcd54d9f76", "thumbnail_srcset": "https://si.imgix.net/9f3b1acf/uploads/origins/b1a3630a-4ede-43e5-85bc-2425580b6834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=127590e1437f10f6d06f3ffcd54d9f76, https://si.imgix.net/9f3b1acf/uploads/origins/b1a3630a-4ede-43e5-85bc-2425580b6834?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a5b104584142aa11c25d7430d9f4d86 2x, https://si.imgix.net/9f3b1acf/uploads/origins/b1a3630a-4ede-43e5-85bc-2425580b6834?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8e4f360f10de08a84e19dbd6945bed2 3x", "genre": "art", "nsfw": true, "body": "「女子生徒・着衣汚臭洗脳」の後日的な作品（蒸れ・ニオイ・レズ要素あり）をリクエストします。\n\n●概要\n「居残り運動」経験者の女の子2人が、「居残り運動」の時と同じスク水を着て汗だくになりレズプレイする。\n\n●登場人物\n女の子2人。\n1人は「女子生徒・着衣汚臭洗脳」に登場した娘。\n相手の娘の容姿は、髪型はツインテール、胸は（前作の娘よりは）小さめでお願いします。\n2人とも着衣汚臭洗脳を受けたことによって蒸れ＆臭いフェチになってしまった設定でお願いしたいです。\n\n●服装\n「女子生徒・着衣汚臭洗脳」で身につけていたスク水、水泳帽、上履きブーツ。\n\n以下のような描写を入れていただけるとありがたいです。全部入れることが難しそうなら一部だけでも嬉しいです。\n・腋を嗅ぐ描写\n・頭or脱いだ帽子を嗅ぐ描写\n・足or脱いだ靴を嗅ぐ描写\n・水泳帽からツインテ部分が出ている描写\n・お互いの着衣（水着など）を交換して着る描写\n・衣服（制服or私服）の下に蒸れるように水着を着ている描写、またはそれを示唆するセリフ\n\n内容は自由に追加やアレンジ等していただいて問題ありません。\nご検討よろしくお願いします。\n\nhttps://skeb.jp/@joposato/works/14", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/18", "thumbnail_src": "https://si.imgix.net/38a2a8d5/uploads/origins/f5d32494-fb1c-4195-b6f2-6ec0013ef21b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4577b92d10475e0faece7b8df0757d99", "thumbnail_srcset": "https://si.imgix.net/38a2a8d5/uploads/origins/f5d32494-fb1c-4195-b6f2-6ec0013ef21b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4577b92d10475e0faece7b8df0757d99, https://si.imgix.net/38a2a8d5/uploads/origins/f5d32494-fb1c-4195-b6f2-6ec0013ef21b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e63ca8ccf6580b1dc499717001174ef 2x, https://si.imgix.net/38a2a8d5/uploads/origins/f5d32494-fb1c-4195-b6f2-6ec0013ef21b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=176e858a77bbb238092dd90c83662f73 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/17", "thumbnail_src": "https://si.imgix.net/bda5106d/uploads/origins/152fdaeb-b295-411c-9acc-90b68e0abd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f44b520ed4fc11bf76a5637cf3cbda", "thumbnail_srcset": "https://si.imgix.net/bda5106d/uploads/origins/152fdaeb-b295-411c-9acc-90b68e0abd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f44b520ed4fc11bf76a5637cf3cbda, https://si.imgix.net/bda5106d/uploads/origins/152fdaeb-b295-411c-9acc-90b68e0abd21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3807774b5d51f421cc7a705ce99296a5 2x, https://si.imgix.net/bda5106d/uploads/origins/152fdaeb-b295-411c-9acc-90b68e0abd21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16f578372ab65a7bd68602aff40c67a5 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品、ありがとうございます。\n先生の作風でぜひ表現して頂きたいシチュ、自創作の設定がありますので良ければ受理ご検討よろしくお願いします。\n\n●世界観\nサイバーパンク未来世界。\n意思を持ち人類に反旗を翻したAI《MARIA》はアンドロイドの軍勢を使い侵攻を開始、世界の一部地域を制圧するとそこに《教区》なる人間牧場を作り遺伝子操作により生み出した《家畜化人類》を飼育管理していた。\n\n●世界観補足\n教区には《教義》と呼ばれる掟があり、そこには『AI《MARIA》を神と崇めよ』『異性間膣性交禁止、自然交配、自然分娩禁止』『アンドロイドを敬うべし』『男は女への奉仕を義務化』などがある。\n\n●キャラ\n・攻め側\nとある教区の家畜化人類のリーダーをしている女。\nhttps://twitter.com/er114_k/status/1577652010261745664?s=46&t=446Qhzf8v1qLSHrHJnsZPw\n\n\n・ウケ\n家畜化人類の一般的な男性達。\nhttps://twitter.com/er114_k/status/1589109745881079808?s=46&t=446Qhzf8v1qLSHrHJnsZPw\n\n●内容\n・穴清掃奉仕\n立っている女の子様のオマンコ様と肛門様を、それぞれ1人ずつの男が前後から跪き舌を穴に挿れて丁寧に汚れを舐めとる。\nこの奉仕は男の悦びであり、奉仕中のオナニーと射精が許可されている。\n\n・オスマンコ穴の提供\n女の子様のストレスと性欲発散のため、男は命じられればいつでも四つん這いか尻を突き出してアナルを提供、女の子様がペニバンを使いアナルを犯す為の性処理穴となる。\nなお女の子様は膣の快感のみではなく精神的な充足も重要なため、基本的には男を罵倒しながら暴力的にアナルを突き回しストレスを解消。\n男は一突きされる事に「ありがとうございます！」と述べ、負傷又は死亡させられても一切不満を表す権利はない。\n\n●補足\n上記世界観、キャラ、プレイ内容から先生のインスピレーションで製作して頂けたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/16", "thumbnail_src": "https://si.imgix.net/7187441b/uploads/origins/6486ad87-a8c1-4d01-9da1-cc516c0f270a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a520e4bad1f07cbcc257da6dadf7499", "thumbnail_srcset": "https://si.imgix.net/7187441b/uploads/origins/6486ad87-a8c1-4d01-9da1-cc516c0f270a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a520e4bad1f07cbcc257da6dadf7499, https://si.imgix.net/7187441b/uploads/origins/6486ad87-a8c1-4d01-9da1-cc516c0f270a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f54695fa6e98819d718409ea36872c70 2x, https://si.imgix.net/7187441b/uploads/origins/6486ad87-a8c1-4d01-9da1-cc516c0f270a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=441bd7bdf55b6ced04c93840b6043fdc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/15", "thumbnail_src": "https://si.imgix.net/d0bc00fc/uploads/origins/d6e90a7c-444e-4d51-9374-698364e91f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57fc9bf6774e69b5d43a4d17a3769dd1", "thumbnail_srcset": "https://si.imgix.net/d0bc00fc/uploads/origins/d6e90a7c-444e-4d51-9374-698364e91f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57fc9bf6774e69b5d43a4d17a3769dd1, https://si.imgix.net/d0bc00fc/uploads/origins/d6e90a7c-444e-4d51-9374-698364e91f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae27f472227f3ee0e6057d70a72b2138 2x, https://si.imgix.net/d0bc00fc/uploads/origins/d6e90a7c-444e-4d51-9374-698364e91f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af22526aa01cafbbe76b0501f0097830 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/14", "thumbnail_src": "https://si.imgix.net/b071cba2/uploads/origins/c10efeeb-2677-4fc6-9337-dae4a73cad96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d5750c5e229f728e7a3aadb4e5910b", "thumbnail_srcset": "https://si.imgix.net/b071cba2/uploads/origins/c10efeeb-2677-4fc6-9337-dae4a73cad96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d5750c5e229f728e7a3aadb4e5910b, https://si.imgix.net/b071cba2/uploads/origins/c10efeeb-2677-4fc6-9337-dae4a73cad96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89bc46f473fc2abe326fb353a06f65ed 2x, https://si.imgix.net/b071cba2/uploads/origins/c10efeeb-2677-4fc6-9337-dae4a73cad96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12ffc0de509ca2ffd7193985fd69d44d 3x", "genre": "art", "nsfw": true, "body": "蒸れ・ニオイ系のシチュエーションをリクエストいたします。\n\n以下、概要です。\n\nプールの授業を仮病でさぼった女子（JC～JKくらい）に罰として水着（スク水または競泳水着）を着させて強制的に運動させる。\n水着がずぶ濡れになるよう汗だくになるまで運動するよう命じる。\n水着の他には頭と手足も蒸れるように水泳帽をかぶらせて上履きブーツも履かせる。\n女の子は自分の恰好と汗臭くなっていく恥ずかしさ、汗で蒸れた水着が張り付く不快感、水泳帽で蒸れる頭と上履きブーツで蒸れる足の不快感に苦しめられながらも指令をやりとげる。\n運動後の女の子はまるでプールに入った後のように着ている水着がずぶ濡れになっているが、プールの塩素臭のかわりに蒸れた女子の臭いがものすごいことになっている。\n\n以下の要素を入れていただけるとありがたいです。\n・水着は最後まで脱がさず\n・水泳帽と上履きブーツは運動後に脱がせて蒸れた頭と足の描写\n・ずぶ濡れの水着について「プールに入ったみたい」だと思う女の子の心の声、または外部から指摘するセリフ\n\n内容は自由に追加やアレンジ等していただいて問題ありません。\n女の子の容姿もお任せいたします。\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/13", "thumbnail_src": "https://si.imgix.net/6dd0524d/uploads/origins/5b4285ac-40aa-436d-80a2-271f597851b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=288d1db101653a66c00df3de332d59f0", "thumbnail_srcset": "https://si.imgix.net/6dd0524d/uploads/origins/5b4285ac-40aa-436d-80a2-271f597851b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=288d1db101653a66c00df3de332d59f0, https://si.imgix.net/6dd0524d/uploads/origins/5b4285ac-40aa-436d-80a2-271f597851b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=648370ffc182364950aede446c235c45 2x, https://si.imgix.net/6dd0524d/uploads/origins/5b4285ac-40aa-436d-80a2-271f597851b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9b16a249c624f8cb486c89ffdd379bc 3x", "genre": "art", "nsfw": true, "body": "先日は素晴らしい作品、ありがとうございました。\n先生の作品の中で『年上女性によるショタ責め』もめちゃくちゃ好きなので、そんな感じのシチュを今回はお願いします。\n\n●キャラ\n資料URLのウチの子、ピンク髪の舌ピアスJK。\nちょっとダウナーで性に奔放なJKで、何人もの男をたらし込んだり調教したりしてATMにしている。\n当然キケンな輩などに狙われたりするが、こう見えて格闘技の達人かつ頭の回転が速く誰も敵わない。\n\n●シチュ\n『公園のベンチでぼーっとしていたら裕福なショタと偶然に居合わせ、話をする内に仲良くなったので性癖歪め逆レイプしてATMにしちゃうピンク髪JK』というシチュ。\n・「ふーん、そんなにお金持ちなんだ…」とショタに狙いを定めるJK。\n・抱き締めて顔や鼻を舐め回す匂い責めしながらペニスを弄り、ペニスの快感と匂いと舌ピアスで舐め回される独特の感触を紐付けて性癖を歪ませるJK。\n・「次からはパパからもらったお小遣いと引き換えにオマンコの匂い嗅がせてやる、分かった？」と、跪かせたショタの顔にパンツ越しオマンコを押しつけ窒息させ《おまんこ信仰》を脳に刻むJK。\n・締めは騎乗位、しかし挿入したまま動かず「口を開け」と命令し、唾を口に吐き捨てた瞬間に射精させるJK。\n\n●補足\n上記のイメージで自由に解釈して製作してください。\nショタを虐めるピンク髪の舌ピアスJKちゃんであれば、アレンジはご自由に。\nよろしくお願いします。\n\nhttps://twitter.com/er114_k/status/1474390056572186629?s=46&t=9WNI2bxkgow7_vYzOQYiyQ", "created_at": "", "completed_at": ""}, {"path": "/@joposato/works/12", "thumbnail_src": "https://si.imgix.net/6b28ac79/uploads/origins/5fbe082e-1db9-4bde-91d6-fda8e6610aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0179deeb15996950d74a06a40690dd0c", "thumbnail_srcset": "https://si.imgix.net/6b28ac79/uploads/origins/5fbe082e-1db9-4bde-91d6-