200&h=200&s=0f584b4f7040568059bc37d207faa336, https://si.imgix.net/dce572cf/uploads/origins/ae0546c9-f902-4429-b601-9e6000c7a50d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=593ed8285b1e61688e4958e6bf0434a0 2x, https://si.imgix.net/dce572cf/uploads/origins/ae0546c9-f902-4429-b601-9e6000c7a50d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69c9bee513f4592622bd0e961ecb8b16 3x", "genre": "art", "nsfw": false, "body": "アピールをありがとう！\n\n好きなポーズで描いてください\n\nキャラクターを気に入っていただきありがとうございます\n\nhttps://drive.google.com/drive/folders/1SBOab-JEAHimTfO4Kp1W_tyxiJHKo1bs?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@teho__o/works/4", "thumbnail_src": "https://si.imgix.net/6c9ad2d5/uploads/origins/6c360938-0de4-4572-b4c3-65528be36d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680f3b613dd20b3bc1e6eb6d890358b1", "thumbnail_srcset": "https://si.imgix.net/6c9ad2d5/uploads/origins/6c360938-0de4-4572-b4c3-65528be36d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680f3b613dd20b3bc1e6eb6d890358b1, https://si.imgix.net/6c9ad2d5/uploads/origins/6c360938-0de4-4572-b4c3-65528be36d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfd5d1656f331a75d48d6d59c0a59789 2x, https://si.imgix.net/6c9ad2d5/uploads/origins/6c360938-0de4-4572-b4c3-65528be36d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c8a1714ab881dc831172384125efa30 3x", "genre": "art", "nsfw": false, "body": "こんにちは。可愛らしい絵柄のイラストをskebの新着欄から拝見しました。\nもしリクエストをお受けいただける場合、資料にある2人のうち好きな方を選んで描いて頂けませんか？\n衣装や髪型にアレンジや変更を加えても問題ありません。\n検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1BF8QcPY2eSOF5Gpxi3ROzEsBdwsGB7Bn", "created_at": "", "completed_at": ""}, {"path": "/@teho__o/works/3", "thumbnail_src": "https://si.imgix.net/acc87930/uploads/origins/1b36f1fe-4a30-4f45-b707-33e0b6c987ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e55e5e5c7e3d1bf770798c25894123", "thumbnail_srcset": "https://si.imgix.net/acc87930/uploads/origins/1b36f1fe-4a30-4f45-b707-33e0b6c987ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e55e5e5c7e3d1bf770798c25894123, https://si.imgix.net/acc87930/uploads/origins/1b36f1fe-4a30-4f45-b707-33e0b6c987ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=207b5c7b83725728b6092eb9508986e2 2x, https://si.imgix.net/acc87930/uploads/origins/1b36f1fe-4a30-4f45-b707-33e0b6c987ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=044917aa8efa10ab74b93c550ecbd019 3x", "genre": "art", "nsfw": false, "body": "こんなに早く同じアーティストに依頼するのも変かもしれませんが...。前回の絵から追加されたメモを読んで思いついたのですが...。\n\n同じキャラクター、ジェミを描いてほしいのですが、（見る側から）手でなでてあげてほしいのです！頬をさすったり、あごをさすったり、頭のてっぺんをさすったり。ジェミはおそらく、これに口を尖らせて反応するだろう...。そして顔を赤らめるだろう。彼はエネルギッシュでハッピーな男の子だが、すぐに慌ててしまう。\n\nあなたが自分のOCを持っているかどうかわからないけど、彼をなでる自分のキャラクターも描けるよ！抱きしめたり。あるいは...本当に何でも好きなように！\n\n今までのあなたの作品にはとても感動しています。あなたなら、きっとかわいいイラストになると思います！\n\nhttps://drive.google.com/drive/folders/1DK56UglJX5nbz4Oy2dWZQyiDZLQvqQiu?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@teho__o/works/2", "thumbnail_src": "https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76c67a653f6f6020db62eaac537ca62b", "thumbnail_srcset": "https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76c67a653f6f6020db62eaac537ca62b, https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5c981f00cfa74729946936cb6207b67 2x, https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f49bdb22a3d804932add73e5cf5c45d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアートワークを見ました。\n私のキャラクター、ミキのアートワークをお願いしたいです！\n\n彼女について重要なことがあります：\n私のキャラクターは、翼と後光のあるかわいい天使です。\n彼女の瞳孔は暗いというより明るいです。\n\nこれが彼女の写真と衣装です！(https://drive.google.com/drive/folders/1hrH-yMV108uwPc66jdplhW_jV6YAdpv_?usp=drive_link)\n\nその他はすべてお任せします！\n\nご配慮ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@teho__o/works/1", "thumbnail_src": "https://si.imgix.net/135e3fdf/uploads/origins/fab1872e-fe69-4b56-9288-911f072b0edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=657078589520760b888874a127ec8b38", "thumbnail_srcset": "https://si.imgix.net/135e3fdf/uploads/origins/fab1872e-fe69-4b56-9288-911f072b0edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=657078589520760b888874a127ec8b38, https://si.imgix.net/135e3fdf/uploads/origins/fab1872e-fe69-4b56-9288-911f072b0edc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfa031a41af321e357bd842ba87a7d05 2x, https://si.imgix.net/135e3fdf/uploads/origins/fab1872e-fe69-4b56-9288-911f072b0edc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74ab703cc82641f8584947c362bcfe7b 3x", "genre": "art", "nsfw": false, "body": "ああ、あなたの絵はとても柔らかくて暖かく見える...。確かに！お言葉に甘えさせていただきます！\n\nリクエストのキャラクターを描いてほしいんだけど、名前は \"Jhemi\"！男の子なんだけど、顔立ちが柔らかいんだ。お気づきのように、耳は犬のようにペタペタしていますが、尻尾はキツネのように大きくてフワフワしています！服装は2種類ある。フワフワしている方が普段着でカジュアルな服。光沢のある鎧のような服は、冒険家や配達人として働いているため、仕事着だ！\n\n性格はとても陽気で明るく、人を喜ばせるのが大好き！元気な反面、面倒見がよく、思慮深い。そのことを頭に入れながら描いてください！絵のスピードが速いということですが、自分のペースを守りましょう！健康維持のために時間をかけましょう！\n\nhttps://drive.google.com/drive/folders/1DK56UglJX5nbz4Oy2dWZQyiDZLQvqQiu?usp=drive_link", "created_at": "", "completed_at": ""}]}