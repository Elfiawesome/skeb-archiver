200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bd9cba1715b895c00479076ee792992", "thumbnail_srcset": "https://si.imgix.net/de9a88b9/uploads/origins/7aeea8ef-5185-4b2f-8bf7-f0327c7d8f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bd9cba1715b895c00479076ee792992, https://si.imgix.net/de9a88b9/uploads/origins/7aeea8ef-5185-4b2f-8bf7-f0327c7d8f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=548df68f85c86a122f138c82ac96d128 2x, https://si.imgix.net/de9a88b9/uploads/origins/7aeea8ef-5185-4b2f-8bf7-f0327c7d8f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2eed11fdd6d0168a27a27891d233e8b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@UranosEBi/works/57", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/9d1611d8/uploads/origins/a5b310f3-1d73-4699-b677-1cb1ab9b76b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0da124a5922448128412b29b660bac", "thumbnail_srcset": "https://si.imgix.net/9d1611d8/uploads/origins/a5b310f3-1d73-4699-b677-1cb1ab9b76b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0da124a5922448128412b29b660bac, https://si.imgix.net/9d1611d8/uploads/origins/a5b310f3-1d73-4699-b677-1cb1ab9b76b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bd816372c72d14c6e3d398fdf73894f 2x, https://si.imgix.net/9d1611d8/uploads/origins/a5b310f3-1d73-4699-b677-1cb1ab9b76b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcdd0a33d5ac7208529a819552b8d537 3x", "genre": "art", "nsfw": false, "body": "VOICEROID劇場で使用可能なPSD立ち絵を依頼します\n\n〇キャラクター\n・彩澄りりせ\n\n〇衣装について\n・学生服\nhttps://www.ah-soft.com/asumi/\n\n〇希望差分\n眉：通常、喜(上げ)、怒、哀\n目(閉)：通常、笑み\n目(開)：通常、見開き、ジト目、細目(妖艶)\n⇒それぞれハイライト無、黒ベタの眼球差分\n口：あいうえお、閉じ笑み、閉じ無表情、口開(楽)、口開(怒)\n⇒あいうえおの口開けは控えめに、口開の2つはやや大きめに\n表情効果：チーク、照れ、顔影\n⇒チークは通常時用、感情表現としての照れ(赤面)\n腕：おろし、胸に手を当てる、胸の前で握り拳\n※その他の差分については指定なし\n⇒感情アイコン、コミカル調の差分は不要\n\n〇その他\n・主観視点動画で使用のため、視点はカメラ目線\n・立ち姿は真正面ではなく若干斜め向き(ぴた声のパケ絵のイメージが近い)\n・等身は高め\n・全体の雰囲気は、美しさの中にどこか影を感じるいつも描いていらっしゃるようなイメージを\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@UranosEBi/works/56", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/ddfb70d2/uploads/origins/fb91b88d-a015-40fc-89a8-3dff1eb3547b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf78f4e8577f3ccda461fcf94e391101", "thumbnail_srcset": "https://si.imgix.net/ddfb70d2/uploads/origins/fb91b88d-a015-40fc-89a8-3dff1eb3547b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf78f4e8577f3ccda461fcf94e391101, https://si.imgix.net/ddfb70d2/uploads/origins/fb91b88d-a015-40fc-89a8-3dff1eb3547b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2d25ea800697e2e7b3ec3e638f42de2 2x, https://si.imgix.net/ddfb70d2/uploads/origins/fb91b88d-a015-40fc-89a8-3dff1eb3547b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63c3586e2b2fd982ee5bb1ab7db6d432 3x", "genre": "art", "nsfw": false, "body": "ぎりぎり公式さんが許してくれそうな双葉湊音イラストをお願いします\n方向性はうらのす海老さんにお任せします", "created_at": "", "completed_at": ""}, {"path": "/@UranosEBi/works/55", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/4f3c7325/uploads/origins/9cd966fd-29a9-4f68-b5c9-c5408d1d890d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c640bda8e39e28268193d50c64f89b", "thumbnail_srcset": "https://si.imgix.net/4f3c7325/uploads/origins/9cd966fd-29a9-4f68-b5c9-c5408d1d890d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c640bda8e39e28268193d50c64f89b, https://si.imgix.net/4f3c7325/uploads/origins/9cd966fd-29a9-4f68-b5c9-c5408d1d890d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e38c8c30c657426924bbee565bfee23 2x, https://si.imgix.net/4f3c7325/uploads/origins/9cd966fd-29a9-4f68-b5c9-c5408d1d890d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30fcf8cb88afe046e2a9be8182aea9aa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、匿名にて失礼致します。\n合成音声キャラのNo.7のイラストをリクエストさせて頂きます。\n構図・ポーズ等はおまかせ致します。\n\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@UranosEBi/works/54", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/5dd0d841/uploads/origins/9b8a3826-626a-4af9-97ba-0e369d3fa9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54e6a2fe2fb15e7555d6c406338d125f", "thumbnail_srcset": "https://si.imgix.net/5dd0d841/uploads/origins/9b8a3826-626a-4af9-97ba-0e369d3fa9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54e6a2fe2fb15e7555d6c406338d125f, https://si.imgix.net/5dd0d841/uploads/origins/9b8a3826-626a-4af9-97ba-0e369d3fa9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e139c4cb8956e5cda350c828d46999c1 2x, https://si.imgix.net/5dd0d841/uploads/origins/9b8a3826-626a-4af9-97ba-0e369d3fa9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e92ad8e0c2bdc5f27878d547f0ff930a 3x", "genre": "art", "nsfw": false, "body": "",