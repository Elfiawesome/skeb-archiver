ze=30&txt=PRIVATE&s=d590716f2bf723819887ee60fac694cb 2x, https://si.imgix.net/fbd23088/uploads/origins/49ffbd32-6af5-4867-b538-1fad1d35673c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2d4e353225b55f4f89d0a066b00b76c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanae5685/works/103", "thumbnail_src": "https://si.imgix.net/a8ec0afb/uploads/origins/81abda86-96a2-4b81-add4-fb8bd3855b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edf789c597ace64d28e5d477d07dfb09", "thumbnail_srcset": "https://si.imgix.net/a8ec0afb/uploads/origins/81abda86-96a2-4b81-add4-fb8bd3855b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edf789c597ace64d28e5d477d07dfb09, https://si.imgix.net/a8ec0afb/uploads/origins/81abda86-96a2-4b81-add4-fb8bd3855b89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b98cffc27100e60adfefa632f2d1187 2x, https://si.imgix.net/a8ec0afb/uploads/origins/81abda86-96a2-4b81-add4-fb8bd3855b89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02f137877b528e72e2a9576c1c51ff74 3x", "genre": "art", "nsfw": false, "body": "黒白カナエ先生　いつもお世話になっております\n先生のXでお見掛けしたプラナちゃんの水着衣装がとてもかわいかったので水着の衣装のイラストを依頼させていただきました\n\n【書いていただきたい方】\nVarium所属　VTuberの「綿宮あひる」さん(@Watamiya_Ahiru)のイラストをお願いしたいです\n（動物のあひるモチーフのVTuberさんです）\n\nガイドライン的に二次創作は大丈夫です\nhttps://varium.jp/guide_line/\n\n【目的】\n綿宮あひるさんのサムネやXなどの使用です\nVTuber活動に使えるように許可をいただけると幸いです\nプレゼント時に先生のXのIDとAI禁止の文言付きでポストさせていただきたいです\nまたは自分での鑑賞用です\n\n【リクエスト事項】\n綿宮あひるさんのビキニ衣装のイラストを書いて頂きたいです（胸はあまり大きくありません）\n本人に似合いそうな水着を見立てていただけると嬉しいです\n背中の羽は無しで、髪型を新衣装時の編み込みのある公式の髪型でお願いします\n\nもし可能であれば表情差分などいただけるとありがたいです\n\n綿宮あひるさんがサムネで使えるように、背景なしや文字なしで差分のレイヤーを分けたPSDファイルで納品していただけると嬉しいです\n\n【参考資料】\nXの通常衣装三面図です\nhttps://x.com/Watamiya_Ahiru/status/1673995669454086145\n\nXの新衣装キービジュアルです（こちらの編み込みの髪型でお願いします）\nhttps://x.com/varium_info/status/1898282547794395253\n\n参考までにその他新衣装・アップ画像などです（私のポストで申し訳ありません）\nhttps://x.com/gertrud501/status/1901166878287954094\n\n事務所の公式HP（タレントページ）です\nhttps://varium.jp/talent/ahiru/\n\nお時間をかけて頂いて大丈夫ですのでご検討のほどよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@kanae5685/works/102", "thumbnail_src": "https://si.imgix.net/6165b14a/uploads/origins/773f281d-98e0-4f77-be06-7276a74ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d6d6c0ed89f84860e12c565dc099a35", "thumbnail_srcset": "https://si.imgix.net/6165b14a/uploads/origins/773f281d-98e0-4f77-be06-7276a74ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d6d6c0ed89f84860e12c565dc099a35, https://si.imgix.net/6165b14a/uploads/origins/773f281d-98e0-4f77-be06-7276a74ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83943f29737a542c99cd6af9921c46d7 2x, https://si.imgix.net/6165b14a/uploads/origins/773f281d-98e0-4f77-be06-7276a74ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba22a45ec2adfbbed8b5c91dd4dfe709 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n素敵なイラストをお見かけし、リクエストを送らせて頂きました。\n\n資料URLにある、私の創作キャラクターをお願いしたいです。\n衣装については資料のものからアレンジを加えたり、全く別の衣装にしても問題ございません。\n儚げでほんのりセクシーな雰囲気ですと嬉しいですが、そうでなくても大丈夫ですので自由に描いて頂いて結構です。\n表情については満面の笑顔以外であればどのような表情でも大丈夫です。\nその他構図等の詳細な指定はございません。\n\nご検討頂ければ幸いです、宜しくお願いします!\n\nhttps://drive.google.com/file/d/11CU8Cw_Ockc61ZdjQowIWBHqAbcB2YTh/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kanae5685/works/101", "thumbnail_src": "https://si.imgix.net/243b4559/uploads/origins/3e243a70-1dbe-4e47-b364-0c01c1d00c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f3a0ddaa724dae504a5f42c6e3c1b77", "thumbnail_srcset": "https://si.imgix.net/243b4559/uploads/origins/3e243a70-1dbe-4e47-b364-0c01c1d00c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f3a0ddaa724dae504a5f42c6e3c1b77, https://si.imgix.net/243b4559/uploads/origins/3e243a70-1dbe-4e47-b364-0c01c1d00c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49d36a781f2ab38b8a8c6bb611bb3259 2x, https://si.imgix.net/243b4559/uploads/origins/3e243a70-1dbe-4e47-b364-0c01c1d00c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47e4e3686a294f45ae7af4680939530f 3x", "genre": "art", "nsfw": false, "body": "黒白先生はじめまして！\n先生の描く美麗でクールでスタイリッシュなイラストをTLで目撃し、是非推しのイラストをご依頼させてください！\n\n版権ものとなってしまうのですが、もしご対応可能であれば、『ロウきゅーぶ！』という作品の袴田ひなたちゃんのイラストをお願いしたいです。\n身長131cmの小学6年生で、ゆるふわな天使のような女の子です。\n\nテーマは「男装」で、\nかわいさを残しながらも、王子様的な感じでクールでかっこよく描いてください。\n構図等細かいところはおまかせします！\n\n何卒ご検討ください。\n\nhttp://www.ro-kyu-bu.com/contents/hp0003/index00080000.html#chara", "created_at": "", "completed_at": ""}, {"path": "/@kanae5685/works/100", "thumbnail_src": "https://si.imgix.net/fc20169d/uploads/origins/99320463-f944-4430-b57a-e8e724cc6b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f063dae94d495d2243c5cbbdb5e2185", "thumbnail_srcset": "https://si.imgix.net/fc20169d/uploads/origins/99320463-f944-4430-b57a-e8e724cc6b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f063dae94d495d2243c5cbbdb5e2185, https://si.imgix.net/fc20169d/uploads/origins/99320463-f944-4430-b57a-e8e724cc6b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2674dcb66b862cf4090cfd53eeb32be2 2x, https://si.imgix.net/fc20169d/uploads/origins/99320463-f944-4430-b57a-e8e724cc6b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=317ac148aea6bfd7551d55339acdcada 3x", "genre": "art", "nsfw": false, "body": "はじめまして、黒白カナエ様のイラストに惹かれてリクエスト送らせていただきます。\nPSO2 NGSで使用している自キャラのイラストを貴方の絵柄で描いてもらえたら嬉しいです。\n\n身長138cmと小柄で、タレ目がちな童顔の女の子です。資料になりそうな画像は下記にまとめています。\nhttps://drive.google.com/drive/u/0/folders/1-OC6WUyS_d7Dvh_n1qlgskvHTBxYMlDB\n\n表情はふにゃっとした感じの笑顔で、全身が見きれ無しで画面に収まっているとうれしいです。\n個人的には谷間に垂れるネクタイがお気に入りポイントです。\n更にぶっちゃけるとアクスタにしたとき映える画だと言う事無しです。\n\n資料の中には愛用の武器の画像も入っていて武器を持ったポーズだとうれしいですが、武器無しでもアリでも好きなように描いてもらえればと思います。\n構図やポーズはもちろん、ディテールの省略などもご随意にお任せいたします。\n\n用途：個人鑑賞、個人利用の為のグッズに利用する、skebで描いてもらったと個人的な知り合いに見せる\n\n以上、もしよろしければ、ご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kanae5685/works/99", "thumbnail_src": "https://si.imgix.net/87e709cb/uploads/origins/fcbf8638-88c9-4599-922d-9144b6f262a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3790dc37582de5d230837651104f20ce", "thumbnail_srcset": "https://si.imgix.net/87e709cb/uploads/origins/fcbf8638-88c9-4599-922d-9144b6f262a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3790dc37582de5d230837651104f20ce, https://si.imgix.net/87e709cb/uploads/origins/fcbf8638-88c9-4599-922d-9144b6f262a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b941804ab8c6a8a7c767ee33f00b8584 2x, https://si.imgix.net/87e709cb/uploads/origins/fcbf8638-88c9-4599-922d-9144b6f262a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ad2ae00cfa29e8a3d6476cdc2326442 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanae5685/works/98", "thumbnail_src": "https://si.imgix.net/5094f6b8/uploads/origins/b71163c2-96cf-4ed8-9db3-2d60c0841236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93228fb750f3616f4bced0ce352bc82b", "thumbnail_srcset": "https://si.imgix.net/5094f6b8/uploads/origins/b71163c2-96cf-4ed8-9db3-2d60c0841236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to