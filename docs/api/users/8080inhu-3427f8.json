a48c81301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45cfbb0cdfafe59f9dd081a3af22447a 3x", "genre": "art", "nsfw": true, "body": "リクエストを失礼します。\n制服半裸のモリーちゃんの微エロ絵を描いてほしいです。\nブレザー制服で一番上のボタンとリボンは付けたままで、それ以降のボタンを外しておっぱいを丸出しにしてください。\nポーズはセクシーめな立ちポーズでお願いします。\nふたなり好きであれば下を生やしてくれて大丈夫ですが、皮付きの粗チンで描いてください。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@8080inhu/works/5", "thumbnail_src": "https://si.imgix.net/94f62f16/uploads/origins/fc660502-3b10-49f6-84b9-4a1b9ee2dd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b20a4a76bb3fc420470e0600787e5f5", "thumbnail_srcset": "https://si.imgix.net/94f62f16/uploads/origins/fc660502-3b10-49f6-84b9-4a1b9ee2dd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b20a4a76bb3fc420470e0600787e5f5, https://si.imgix.net/94f62f16/uploads/origins/fc660502-3b10-49f6-84b9-4a1b9ee2dd63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58f596f81345c41cf3807acb908b02d4 2x, https://si.imgix.net/94f62f16/uploads/origins/fc660502-3b10-49f6-84b9-4a1b9ee2dd63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba0e32abcad0ed7bd4c1db9c98e43aa0 3x", "genre": "art", "nsfw": true, "body": "依頼お願いしますキャラは東方の八意永琳先生を内容はある薬の実験で困ったことに助手兼彼氏あるところに呼び出してそこには搾乳器つけた永琳先生が実は母乳が出る薬を飲んで成功したか予想以上に出るので絞りと飲んで欲しいとエッチもしたいと授乳エッチも", "created_at": "", "completed_at": ""}, {"path": "/@8080inhu/works/4", "thumbnail_src": "https://si.imgix.net/27c4b7ef/uploads/origins/8e6bcd6f-1b6e-41de-a164-b08406992b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a621397012875ded3b3a3d9ad16ddfa", "thumbnail_srcset": "https://si.imgix.net/27c4b7ef/uploads/origins/8e6bcd6f-1b6e-41de-a164-b08406992b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a621397012875ded3b3a3d9ad16ddfa, https://si.imgix.net/27c4b7ef/uploads/origins/8e6bcd6f-1b6e-41de-a164-b08406992b41?bg=%23fff&auto=format%2Cco