トを横並びに描いて頂きたいです\nポーズなどはお任せします\n表情は、キャラクターそれぞれの個性が垣間見える笑顔でお願いします\n千織・・・凛とした感じ\nリネット・・・無表情　\n\n細かな部分はお任せします。\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@uzu_kazu411/works/8", "thumbnail_src": "https://si.imgix.net/fa2775f1/uploads/origins/0325d564-a6d9-4cfd-8a2f-e8d9e32cae5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81f7dfd0155164d839980737af9e6b03", "thumbnail_srcset": "https://si.imgix.net/fa2775f1/uploads/origins/0325d564-a6d9-4cfd-8a2f-e8d9e32cae5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81f7dfd0155164d839980737af9e6b03, https://si.imgix.net/fa2775f1/uploads/origins/0325d564-a6d9-4cfd-8a2f-e8d9e32cae5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8572d2b9e33518f6566348812a7500ef 2x, https://si.imgix.net/fa2775f1/uploads/origins/0325d564-a6d9-4cfd-8a2f-e8d9e32cae5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f71b15e64b0c8671b7240fb69d1bb548 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uzu_kazu411/works/7", "thumbnail_src": "https://si.imgix.net/cdb032c2/uploads/origins/59a62ebf-3764-41f6-ad63-a1e5cc0529e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b21f1ed5dce459e0e03bb0737e75d1a9", "thumbnail_srcset": "https://si.imgix.net/cdb032c2/uploads/origins/59a62ebf-3764-41f6-ad63-a1e5cc0529e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b21f1ed5dce459e0e03bb0737e75d1a9, https://si.imgix.net/cdb032c2/uploads/origins/59a62ebf-3764-41f6-ad63-a1e5cc