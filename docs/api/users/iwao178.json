.net/68e16712/uploads/origins/ac18461d-86ea-4e96-be57-edc7676b9e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2602ea04925a6fbe659913655bb1679", "thumbnail_srcset": "https://si.imgix.net/68e16712/uploads/origins/ac18461d-86ea-4e96-be57-edc7676b9e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2602ea04925a6fbe659913655bb1679, https://si.imgix.net/68e16712/uploads/origins/ac18461d-86ea-4e96-be57-edc7676b9e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d16d30691dd1d4a65fd202f265ff4a70 2x, https://si.imgix.net/68e16712/uploads/origins/ac18461d-86ea-4e96-be57-edc7676b9e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efaab9dec89fde514d5a72fe31566441 3x", "genre": "art", "nsfw": true, "body": "いわお先生、お疲れ様です。\n\nカラーイラストでコードギアスのミレイさんをお願いします。\n\nシチュエーションとしましては、とある貴族と結婚したミレイさんという設定で、貴族である肥満体のオッサンとの騎乗位エッチシーン(イチャラブもの)をお願いします。\n\nhttps://www.fanbox.cc/@iwao178/posts/8282267\nコチラのセセリアさんの騎乗位セックスのような感じで、特盛おっぱいを鷲掴みにされながら種付けを促すセリフを言ってくれてると嬉しいです。\n\n色々とお手数をお掛けしますが、ご検討の程よろしくお願い致します。\n\nhttps://www.fanbox.cc/@iwao178/posts/8282267", "created_at": "", "completed_at": ""}, {"path": "/@iwao178/works/84", "thumbnail_src": "https://si.imgix.net/a386e56b/uploads/origins/6ed38cec-9ddb-49e8-b852-afedd7a6bd22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597772b03f962d69a26944789d0c1d0e", "thumbnail_srcset": "https://si.imgix.net/a386e56b/uploads/origins/6ed38cec-9ddb-49e8-b852-afedd7a6bd22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597772b03f962d69a26944789d0c1d0e, https://si.imgix.net/a386e56b/uploads/origins/6ed38cec-9ddb-49e8-b852-afedd7a6bd22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6308e8c6ce61144332a461010c3a8114 2x, https://si.imgix.net/a386e56b/uploads/origins/6ed38cec-9ddb-49e8-b852-afedd7a6bd22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=227f266d06f340d98982c60b6556b2cd 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@iwao178/works/69 このイラストの構図からわかるように、正面からのバストアップで、ルーシーの巨乳の間からペニスから大量の精液が噴出し、ルーシーが勝ち誇った表情でこちらを見ている。以上です。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@iwao178/works/83", "thumbnail_src": "https://si.imgix.net/c41175c4/uploads/origins/95441640-3400-47e7-81af-a7e71d437603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea6d5812f21cae1dbe20f5495ba09d9", "thumbnail_srcset": "https://si.imgix.net/c41175c4/uploads/origins/95441640-3400-47e7-81af-a7e71d437603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea6d5812f21cae1dbe20f5495ba09d9, https://si.imgix.net/c41175c4/uploads/origins/95441640-3400-47e7-81af-a7e71d437603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c3a6c30173bcaf8ae11a31accc8ef30 2x, https://si.imgix.net/c41175c4/uploads/origins/95441640-3400-47e7-81af-a7e71d437603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15a6b1cdde31d7a7c6e5a83893f8459f 3x", "genre": "art", "nsfw": true, "body": "岩尾先生、こんにちは！\n\n先生の紅月カレン作品をとても楽しませていただいておりますので、ぜひとも続編をお願いしたいです！\n\nカレンが超ロボット大戦DDの水着姿で、巨根のショタにパイズリをしながら「今日から君を男にしてあげる～<3」といった淫語を囁くシーンをお願いします。\n\n可能であれば、ショタがカレンの胸から射精するバージョンもお願いします。\n\n具体的な台詞はご自由に決めてください。\n\nよろしくお願いします！\n\nrefere\n\nhttps://cdn.imgchest.com/files/b32aa99a4fa4.png", "created_at": "", "completed_at": ""}, {"path": "/@iwao178/works/82", "thumbnail_src": "https://si.imgix.net/ded159ba/uploads/origins/129d5788-dfc0-4b27-8d9d-5f610c661b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4de21000fd86ee2f7f82bd453dc42843", "thumbnail_srcset": "https://si.imgix.net/ded159ba/uploads/origins/129d5788-dfc0-4b27-8d9d-5f610c661b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4de21000fd86ee2f7f82bd453dc42843, https://si.imgix.net/ded159ba/uploads/origins/129d5788-dfc0-4b27-8d9d-5f610c661b62?bg=%