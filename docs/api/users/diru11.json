bsky.social/post/3kgzwjf6nx22t\nhttps://bsky.app/profile/fakeyzai.bsky.social/post/3kgzwo5hasc23\nhttps://bsky.app/profile/fakeyzai.bsky.social/post/3kgzxjdnoqd2o", "created_at": "", "completed_at": ""}, {"path": "/@diru11/works/13", "thumbnail_src": "https://si.imgix.net/93dcbccd/uploads/origins/2e1f0559-16d2-43d1-9021-fb9e7ff991e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c25c3cd7ab264c87e05d0d69c4066a89", "thumbnail_srcset": "https://si.imgix.net/93dcbccd/uploads/origins/2e1f0559-16d2-43d1-9021-fb9e7ff991e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c25c3cd7ab264c87e05d0d69c4066a89, https://si.imgix.net/93dcbccd/uploads/origins/2e1f0559-16d2-43d1-9021-fb9e7ff991e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a7ccd5bf6c67db5b5c75f78784069c3 2x, https://si.imgix.net/93dcbccd/uploads/origins/2e1f0559-16d2-43d1-9021-fb9e7ff991e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51b05005c463b925899d15fcb0ce0342 3x", "genre": "art", "nsfw": false, "body": "DIRUさん、こんにちは。 友達の設定を描いてほしいです\nホワイト ベアの瞳孔は緑色で、額の髪とポニーテールにはシアン色のハイライトがあります。\nアクション姿勢がポニーテールを反映できる限り\n以下は参照リンクです: https://x.com/hfyfb2rxidhdtot/status/1768883649305551178?s=46&t=DLhLsQOVgUcyG43-X3FEsw", "created_at": "", "completed_at": ""}, {"path": "/@diru11/works/12", "thumbnail_src": "https://si.imgix.net/04731b77/uploads/origins/f1bf45ec-cbac-469b-b4c7-a2d8fa5c7f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc3775b813dd3a778c225e88a2afc1e", "thumbnail_srcset": "https://si.imgix.net/04731b77/uploads/origins/f1bf45ec-cbac-469b-b4c7-a2d8fa5c7f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc3775b813dd3a778c225e88a2afc1e, https://si.imgix.net/04731b77/uploads/origins/f1bf45ec-cbac-469b-b4c7-a2d8fa5c7f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fcb198fb6cc8e7ede6696a1ff2fc634 2x, https://si.imgix.ne