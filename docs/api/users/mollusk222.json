b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=187281fe3337497697f159d580560ee6 2x, https://si.imgix.net/4b60dbd9/uploads/origins/0eaca398-a94c-4a9b-b888-801c334b8b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbbf8aa05fe92c1ad04372210229cdb0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きです。あなたの作る構図はいつもとても素晴らしいです！私のオリジナルキャラクターをリクエストすることは可能でしょうか？彼は祖父のノートに隠された暗い秘密を知らずに、その意味を求めて世界中を旅する青年です。彼には2つのモードがあり、イヤリングが太陽や月の光に当たるかどうかで切り替えることができます。彼の外見は、どちらのモードにあるかを反映している。黒髪で描かれる彼の主な性格は、穏やかで一見ナイーブだが、かなり鋭い。モードが切り替わると正反対の行動をとり、通常は悪役を演じる。どちらの人格も相手を高く評価しているが、根は同じ人間だ。普段は傘を差して日差しを遮っている。何でも嬉しいです。無理そうなら遠慮なく断ってください。私のリクエストを見てくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1SgevO79SAWSi1XTvkjORj5xhaIe4Jti-?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mollusk222/works/80", "thumbnail_src": "https://si.imgix.net/4e304a33/uploads/origins/91bc9b16-ea66-4e2b-bd0d-2929f0363e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e9e8ce1be38d73f8b8894438d079426", "thumbnail_srcset": "https://si.imgix.net/4e304a33/uploads/origins/91bc9b16-ea66-4e2b-bd0d-2929f0363e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e9e8ce1be38d73f8b8894438d079426, https://si.imgix.net/4e304a33/uploads/origins/91bc9b16-ea66-4e2b-bd0d-2929f0363e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f676024baec7473f52f43b44e2a9f03 2x, https://si.imgix.net/4e304a33/uploads/origins/91bc9b16-ea66-4e2b-bd0d-2929f0363e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2C