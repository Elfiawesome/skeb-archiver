size=30&txt=PRIVATE&s=b36c33686458c3809d94ca706e1b6ad4 2x, https://si.imgix.net/1ee15b97/uploads/origins/a723becd-4361-47b3-8a3d-84373950635b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82d7ea9432096f67fd5eedde15034dca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/20", "thumbnail_src": "https://si.imgix.net/53ffe8be/uploads/origins/1ace6c50-cfa1-4f97-8003-d343aa2e45f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef50c4d8498ffdb982e40b12fde4b78", "thumbnail_srcset": "https://si.imgix.net/53ffe8be/uploads/origins/1ace6c50-cfa1-4f97-8003-d343aa2e45f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef50c4d8498ffdb982e40b12fde4b78, https://si.imgix.net/53ffe8be/uploads/origins/1ace6c50-cfa1-4f97-8003-d343aa2e45f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b1c824761df67ffd5f20d33616a8f98 2x, https://si.imgix.net/53ffe8be/uploads/origins/1ace6c50-cfa1-4f97-8003-d343aa2e45f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=721418448a437f32ab339a1a8e7fa98d 3x", "genre": "art", "nsfw": false, "body": "こんばんわ。依頼させていただきます。\n\n王様のプロポーズの烏丸黒衣とヒルデガルド・シルベルを描いていただきたいです。\n\n資料の「ヒルデガルド表情」のようなキラキラした瞳で「黒衣ちゃんにとても似合うと思うの！いざというときも役に立つから！」と黒衣ににじり寄るヒルデガルド。\n「これがですか…？」と疑いの眼差しで資料の「ビスチェ」を手に取り眺めている黒衣。\n\nというイメージのシチュエーションでお願いします。\n\nヒルデガルドの衣装は資料の「ヒルデガルド衣装」\n黒衣の衣装は資料の「制服」か「メイド服」のどちらか描きやすい方をお願いします。\n\nご検討いただけたら幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1vjMaU8WZ4xZ5zncqECZNFk2WPDHItvoW", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/19", "thumbnail_src": "https://si.imgix.net/ab08ea48/uploads/origins/b5cd70bf-b42f-461f-be04-573e3942e066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddfa12dc5a517fc1c955c8ae3d928f75", "thumbnail_srcset": "https://si.imgix.net/ab08ea48/uploads/origins/b5cd70bf-b42f-461f-be04-573e3942e066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddfa12dc5a517fc1c955c8ae3d928f75, https://si.imgix.net/ab08ea48/uploads/origins/b5cd70bf-b42f-461f-be04-573e3942e066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2493ab8164ab1e950c29081b96e93cd9 2x, https://si.imgix.net/ab08ea48/uploads/origins/b5cd70bf-b42f-461f-be04-573e3942e066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e308ea17afafc3f5a171633a5434d2ac 3x", "genre": "art", "nsfw": false, "body": "こんばんわ。依頼させていただきます。\n\nスレイヤーズのリナ・インバースを描いていただきたいです。\n\n衣装は資料の「1」でお願いします。\n\n「どれにしよっかな～♡」とタブレット（※現代のiPad的な電子タブレット）を嬉しそうに操作するリナ。というシチュでお願いします。\n\nもらえるプレゼントを選んでいるイメージです。\n\nタブレットの画面は映らないアングルで大丈夫です。\n\nご検討いただけたら幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1GRQ7nZ3NpJgX6iys2twBuoeCtIY1Glbw", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/18", "thumbnail_src": "https://si.imgix.net/9152a9ac/uploads/origins/baf0e914-7a04-495c-a53a-540b7b836df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a97177b2032340df3039261c0d1cba", "thumbnail_srcset": "https://si.imgix.net/9152a9ac/uploads/origins/baf0e914-7a04-495c-a53a-540b7b836df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a97177b2032340df3039261c0d1cba, https://si.imgix.net/9152a9ac/uploads/origins/baf0e914-7a04-495c-a53a-540b7b836df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8434f6fc7c958dabffc094f1f242055 2x, https://si.imgix.net/9152a9ac/uploads/origins/baf0e914-7a04-495c-a53a-540b7b836df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d38cff579716dbb77fb61b1285ffb38 3x", "genre": "art", "nsfw": false, "body": "はじめまして！先生の描かれるSDキャラが可愛すぎて依頼をさせていただきました！\n描いていただきたいのは個人Vtuberの星雲すずさんとなります。\n麻雀の赤五筒を持ってルンルンにご機嫌な様子のすずちゃんをぜひお願いしたいです！\nVご本人様がご希望されればYoutubeでの配信やXでのポストなどにご使用させていただければと\n思いますのでキャラクターの透過データもいただけると幸いです。\nよろしくお願い致します！\n\nhttps://twitter.com/hoshigumo_suzu/status/1785490893417689132", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/17", "thumbnail_src": "https://si.imgix.net/1130d8e8/uploads/origins/a95ef9ee-2e69-4538-9efa-87c1d913b180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3849fc096a88775c729c08e2908d046b", "thumbnail_srcset": "https://si.imgix.net/1130d8e8/uploads/origins/a95ef9ee-2e69-4538-9efa-87c1d913b180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3849fc096a88775c729c08e2908d046b, https://si.imgix.net/1130d8e8/uploads/origins/a95ef9ee-2e69-4538-9efa-87c1d913b180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c742c4b027219cf9310fa22b0f18b409 2x, https://si.imgix.net/1130d8e8/uploads/origins/a95ef9ee-2e69-4538-9efa-87c1d913b180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ef2860b96296a7d6a0910e82713e29 3x", "genre": "art", "nsfw": false, "body": "先日は素敵なイラスト誠にありがとうございました！今回は男の子キャラをお願いしたくリクエストいたしました。\n\n詳細URLは以下に添付させていただきますm(*_ _)m \nURL先右側の画像になります！\n\n服装は先生にお任せしたいです！色味は青系が好みです！\n\n可能でしたら、\n柴犬を抱えた(又は共にする)勇者 がテーマだと嬉しいです(;_;)\n\niPhone背景などにも使用したいので、立ち絵ですと嬉しいです！\n\nもし不可能な点、不足などがあれば取り下げていただいて構いませんm(*_ _)mよろしくお願いいたします。\n\nhttps://x.com/ppcmrv/status/1776987963517546612?s=46&t=oLhkkuM1nVf4TWwqAlltzQ", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/16", "thumbnail_src": "https://si.imgix.net/2faa2897/uploads/origins/8549e4b0-bbc6-48ec-ae9e-311d66057df9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84681cc52ac31d5309d2a66178abad5a", "thumbnail_srcset": "https://si.imgix.net/2faa2897/uploads/origins/8549e4b0-bbc6-48ec-ae9e-311d66057df9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84681cc52ac31d5309d2a66178abad5a, https://si.imgix.net/2faa2897/uploads/origins/8549e4b0-bbc6-48ec-ae9e-311d66057df9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64d75184f0e1d23c9d9a12947eeab9fd 2x, https://si.imgix.net/2faa2897/uploads/origins/8549e4b0-bbc6-48ec-ae9e-311d66057df9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e12a84acb7bc67a7e3443409bcd1103 3x", "genre": "art", "nsfw": false, "body": "資料\n\nねこまんま先生こんにちは！\n友達が先生の絵をとても好きでそこから私も知って先生のファンになりました！\n今回はその友達と私のキャラを描いていただきたいです！\n友達が先生に見えないところまで描いてもらってとても気に入っていたので友達はその服装で描いてもらえると嬉しいです！\n\nhttps://note.com/sveei/n/ndb5d3d4889a5", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/15", "thumbnail_src": "https://si.imgix.net/f2a52559/uploads/origins/afc6849a-afe8-4229-bf25-3c49cddcb2ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdfcac09878933568b0d7234af9d8c20", "thumbnail_srcset": "https://si.imgix.net/f2a52559/uploads/origins/afc6849a-afe8-4229-bf25-3c49cddcb2ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdfcac09878933568b0d7234af9d8c20, https://si.imgix.net/f2a52559/uploads/origins/afc6849a-afe8-4229-bf25-3c49cddcb2ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cb0fd10a19f08459ac24eb53627fabe 2x, https://si.imgix.net/f2a52559/uploads/origins/afc6849a-afe8-4229-bf25-3c49cddcb2ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f915f08ce8f43f3d1aa6e029f6c0278 3x", "genre": "art", "nsfw": false, "body": "初めまして！ねこまんま先生様の作品を見て素敵だと思い、リクエストさせて頂きました。\n\n・イメージ\n参考イメージのポストURLを以下に添付させて頂きました。↓\n前髪なし女の子(髪色は茶系)、猫目気味。\n黒パーカーで柄やロゴはお任せいたします！\nヨギボーに座ってるような、まったりインドアなイメージで描いて頂きたいです。手持ちでタピオカミルクティーを持たせたいです。\n\nそして柴犬(雄)をで追加でお願いしたいです。こちらは抱っこしていても、隣にいても噛み付いていても..！お任せで大丈夫です！\n柴犬はタレ目気味で、茶色毛で希望します。可能であれば黒縁メガネをおでこにかけるようにつけて頂きたいです！(こちら追加金額等あれば変更くださいませ。)\n\nskebでの初めての依頼のため、項目不足等ありましたらお教えくださいませ。よろしくお願いいたしますm(*_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/14", "thumbnail_src": "https://si.imgix.net/e1a54b49/uploads/origins/d14f71ef-395d-4a57-a349-d7d80bb22b95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=925fcd232d72f9cd27762bb9b01c636e", "thumbnail_srcset": "https://si.imgix.net/e1a54b49/uploads/origins/d14f71ef-395d-4a57-a349-d7d80bb22b95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=925fcd232d72f9cd27762bb9b01c636e, https://si.imgix.net/e1a54b49/uploads/origins/d14f71ef-395d-4a57-a349-d7d80bb22b95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f53f0b6f7f819cb4ce578042987991a 2x, https://si.imgix.net/e1a54b49/uploads/origins/d14f71ef-395d-4a57-a349-d7d80bb22b95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d05715748ec3a99d3e734c8c351feb44 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVTuberを描いてください。元気でかわいいレースクイーンです。傘や旗を持った彼女を描いてください。お好みでチンチラのマスコットも描いてください。\n\nhttps://toyhou.se/13540888.-", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/13", "thumbnail_src": "https://si.imgix.net/61f4f65f/uploads/origins/d49b4e42-9db7-4208-a727-6067a0c29938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc23cdd33909a788f51a5ba167250d3f", "thumbnail_srcset": "https://si.imgix.net/61f4f65f/uploads/origins/d49b4e42-9db7-4208-a727-6067a0c29938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc23cdd33909a788f51a5ba167250d3f, https://si.imgix.net/61f4f65f/uploads/origins/d49b4e42-9db7-4208-a727-6067a0c29938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9fbff7ce516b4740cf7db39d5330e3a 2x, https://si.imgix.net/61f4f65f/uploads/origins/d49b4e42-9db7-4208-a727-6067a0c29938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d868f72555f7e614671c111784f48455 3x", "genre": "art", "nsfw": false, "body": "ねこまんま先生が描かれた\nhttps://skeb.jp/@codeblueocean/works/9\nこちらのようなティータイムなイラスト+軽度な差分をリクエストしたいです\n\n描いて欲しいキャラ：うちのこキャラであるエイル\nキャラクター資料：https://www.pixiv.net/artworks/96678055\n服装：タートルネックノースリーブニット+スリットが深いタイトスカート\n（服の色はお任せしますが「大人のおねえさん」な雰囲気を出してほしいです）\nシチュエーションイメージ1：おっぱいが大きな大人のおねえさんがカフェでのんびりティータイム\n足を組んでいるのでスリット見える足がセクシー\nという内容\n\n差分イメージ：上記イラストの状態から静かに瞳を閉じて、鼻血がたらり\nという内容をお願いしたいです\n\n要約：穏やかなティータイムと妄想して鼻血垂らしてるイラストをお願いしたいです\n\nこのような内容ですがいかがでしょうか？\nご一考いただければ幸いです\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/12", "thumbnail_src": "https://si.imgix.net/b63b43d9/uploads/origins/5b61e7e4-7bb4-464f-b74b-d2b89b9c3e11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0180af6b2fdf6dab5a3018a8b241f52c", "thumbnail_srcset": "https://si.imgix.net/b63b43d9/uploads/origins/5b61e7e4-7bb4-464f-b74b-d2b89b9c3e11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0180af6b2fdf6dab5a3018a8b241f52c, https://si.imgix.net/b63b43d9/uploads/origins/5b61e7e4-7bb4-464f-b74b-d2b89b9c3e11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eee12fde0f64b6ca8cfcfa381fb2246f 2x, https://si.imgix.net/b63b43d9/uploads/origins/5b61e7e4-7bb4-464f-b74b-d2b89b9c3e11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fee2dabecbd6bfd49eb1095de023e2a 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nリクエストを送らせていただきます。\nご検討をお願いします。\n\n>キャラクター(2名\n・エイシンフラッシュ(ウマ娘)\n・藤原肇(シンデレラガールズ)\n\n>服装\n2人とも作務衣着用\n藤原肇は手拭いを頭に巻いている。\nエイシンフラッシュの頭については指定無し。耳や尻尾は見えている。\n\n>情景\n陶芸の工房で、すぐ側に立っている藤原肇の指導の下、エイシンフラッシュがろくろの前に座りお皿を成形している。\n\n>さらに詳細\n成形を終え、袖で汗を拭いながらひと息つくエイシンフラッシュと、お皿の出来栄えと集中力を褒める藤原肇の談笑姿。\nエイシンフラッシュは藤原肇を見上げてホッとしたような表情。頬や鼻の頭に若干泥がついている。\n藤原肇はニコニコして、手は合掌🙏のように。\n\n>その他\n背景…工房とは書いていますが特にこだわりありませんので、ろくろとエイシンフラッシュの座っている椅子があれば十分です。\nお皿…デザート皿風の平たい丸皿\n\n以上よろしくお願いします。\n\nhttps://imas.gamedbs.jp/cgss/card/detail/799/799", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/11", "thumbnail_src": "https://si.imgix.net/de7e4cf5/uploads/origins/f9f6b72d-cb0f-4cbc-a196-9a16f78bfa44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a2fde5e6922c0649c8acf969b0764e", "thumbnail_srcset": "https://si.imgix.net/de7e4cf5/uploads/origins/f9f6b72d-cb0f-4cbc-a196-9a16f78bfa44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a2fde5e6922c0649c8acf969b0764e, https://si.imgix.net/de7e4cf5/uploads/origins/f9f6b72d-cb0f-4cbc-a196-9a16f78bfa44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeb8cca69c60a75205560f6c503b39f0 2x, https://si.imgix.net/de7e4cf5/uploads/origins/f9f6b72d-cb0f-4cbc-a196-9a16f78bfa44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=705f8b1826edad29e9fe99dbe13d48dc 3x", "genre": "art", "nsfw": false, "body": "こんばんわ。依頼させていただきます。\n\nデート・ア・ライブの四糸乃と七罪を描いていただきたいです。\nゲームボーイを通信ケーブルで繋いでポケモンを通信交換してるイラストをお願いします。\n四糸乃は楽しそうな笑顔で、七罪は感動でちょっと涙ぐんでいる感じでおねがいします。（七罪はぼっちキャラで友達がいませんでした）\n四糸乃の左手のパペット（よしのん）が外れると精神が不安定になる設定なので外さないようお願いします。\n\n以上になります。ご検討いただけたら幸いです。\n\nhttps://drive.google.com/drive/u/0/folders/1hg4ulOyJP9W8j25Shrwu3DDmD4UVZ7AQ", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/10", "thumbnail_src": "https://si.imgix.net/41ae92f6/uploads/origins/dd868840-35fa-4192-9ecc-ad72ec06aab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ab8713a46a7cf9ddb6f8d741a8214f5", "thumbnail_srcset": "https://si.imgix.net/41ae92f6/uploads/origins/dd868840-35fa-4192-9ecc-ad72ec06aab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ab8713a46a7cf9ddb6f8d741a8214f5, https://si.imgix.net/41ae92f6/uploads/origins/dd868840-35fa-4192-9ecc-ad72ec06aab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1336a1354c3572e1a9aac532a44c452 2x, https://si.imgix.net/41ae92f6/uploads/origins/dd868840-35fa-4192-9ecc-ad72ec06aab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e8e330e1398701ecbf0d321540aa988 3x", "genre": "art", "nsfw": false, "body": "どうもこんばんわ！ンモエザゴです！\n今回はぜひ、ねこまんま先生にイラストをお願いしたく依頼しました！\n\n【依頼内容】\nキャラクター：ンモちゃん (人型の方)\nチューリップ、野良ンモの方は描いても描かなくても大丈夫です！\n\n画角としては、全身か、股下ぐらいまで映ってる構図が希望です。\n元気いっぱいに楽しそうにしてる姿が見れると幸いです！\n\nまた、可能であれば表情差分も数枚あると大変うれしいです！\n\n【用途】\nTwitterで自慢したり、youtubeのサムネ用に使用したいため、\n背景付きの場合はレイヤー別のPSDで頂けると幸いです。\n\n【資料】\n・設定画\nhttps://drive.google.com/file/d/1U-X6y4PExqoEpyiYh2Q2Td6yj4mQE1t8/view?usp=sharing\n\n・FA関連\nhttps://twitter.com/i/events/1487768061562159108", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/9", "thumbnail_src": "https://si.imgix.net/9ee48eaa/uploads/origins/e85510cf-b2ec-4e8f-8926-a49e11fcb822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1779a6f0a995b7534a8e80bd2f73b189", "thumbnail_srcset": "https://si.imgix.net/9ee48eaa/uploads/origins/e85510cf-b2ec-4e8f-8926-a49e11fcb822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1779a6f0a995b7534a8e80bd2f73b189, https://si.imgix.net/9ee48eaa/uploads/origins/e85510cf-b2ec-4e8f-8926-a49e11fcb822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1886a6d5ce4af5fea4e8b9a822e38cc6 2x, https://si.imgix.net/9ee48eaa/uploads/origins/e85510cf-b2ec-4e8f-8926-a49e11fcb822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f3439c399a6825416dd6ebb89addfef 3x", "genre": "art", "nsfw": false, "body": "はじめまして。依頼させていただきます。\n\n紅茶を飲んでホッと一息いれている「王様のプロポーズ」の「烏丸黒衣」をSDキャラでお願いします。\n基本無表情なキャラなので微笑んでいる程度の笑顔でお願いします。\n\n受けていただけたら幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1JOnNzdwHPTFqhKBSxDsLSK0cjzIOcDZ3", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/8", "thumbnail_src": "https://si.imgix.net/fb9d5b70/uploads/origins/b336785c-c359-4b6c-a7aa-7eb7a1d18913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=851089bd1dd36c0e5b26ab198ba75117", "thumbnail_srcset": "https://si.imgix.net/fb9d5b70/uploads/origins/b336785c-c359-4b6c-a7aa-7eb7a1d18913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=851089bd1dd36c0e5b26ab198ba75117, https://si.imgix.net/fb9d5b70/uploads/origins/b336785c-c359-4b6c-a7aa-7eb7a1d18913?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d46f0c3bd7753139e0e84a8fef2759f 2x, https://si.imgix.net/fb9d5b70/uploads/origins/b336785c-c359-4b6c-a7aa-7eb7a1d18913?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f28bb4eeb7cb721add2e5f60b667662 3x", "genre": "art", "nsfw": false, "body": "ねこまんま先生さん描かれた\nhttps://www.pixiv.net/artworks/105327246\nこちらの「これではんごろしにします。」なイラストを2点リクエストしたいです\n\n２点ともほぼ同じ内容なので差分描写という形でお願いしたいのですが\n描いて欲しいキャラ：うちのこキャラであるマオ\nキャラおよび服装資料：https://www.pixiv.net/artworks/96705133\nシチュエーションイメージ1：はんごろし＝潰した料理と勘違いしてるので\n家主に夕飯のメニューを聞かれて「これから（夕飯の食材を）はんごろしにします」と答えつつ\n肉叩きハンマーやすりこぎ棒を持ってニッコリ\nという内容\n\nシチュエーションイメージ2：家主が盛大にやらかしたので説教的な感じで\nこれではんごろしにします（このあとガチでひっぱたく）\nという内容\nザックリ言うならば\n言葉を勘違いしてニッコリと「はんごろしです」って答えてしまうイラストと\nとてもご立腹な感じで「はんごろしです」って答えてるイラストをお願いしたいです\n暴力描写や血糊的な描写は必要ありませんが\nこれで殴られたら痛いじゃ済まないオーラを出してほしいです\n\nこのような内容ですがいかがでしょうか？\nご一考いただければ幸いです\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@codeblueocean/works/7", "thumbnail_src": "https://si.imgix.net/df7d81ce/uploads/origins/f7d8d35f-025a-4de6-9812-5e4a140d872b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe043df4838f668f1f33b6fbeafb38c3", "thumbnail_srcset": "https://si.imgix.net/df7d81ce/uploads/origins/f7d8d35f-025a-4de6-9812-5e4a140d872b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe043df4838f668f1f33b6fbeafb38c3, https://si.imgix.net/df7d81ce/uploads/origins/f7d8d35f-025a-4de6-9812-5e4a140d872b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&tx