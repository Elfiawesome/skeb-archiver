enter&txtsize=30&txt=PRIVATE&s=94d68c72a295b8c47706ac44af0738dd 2x, https://si.imgix.net/781ff686/uploads/origins/d223195f-f4b2-406c-88db-893e83dbae56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f97d17f07612c3cbd89d23b464ef3870 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakakihaku/works/14", "thumbnail_src": "https://si.imgix.net/97795810/uploads/origins/b424cdf0-f5e9-4e4d-a1b3-b200b7207a51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65c16c21d8a7f91c77c528536998f0f0", "thumbnail_srcset": "https://si.imgix.net/97795810/uploads/origins/b424cdf0-f5e9-4e4d-a1b3-b200b7207a51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65c16c21d8a7f91c77c528536998f0f0, https://si.imgix.net/97795810/uploads/origins/b424cdf0-f5e9-4e4d-a1b3-b200b7207a51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1390a3a62d81011b5506d7b3009d9ce 2x, https://si.imgix.net/97795810/uploads/origins/b424cdf0-f5e9-4e4d-a1b3-b200b7207a51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef800c5e4bd03572b0843a3c5f66ad70 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakakihaku/works/13", "thumbnail_src": "https://si.imgix.net/0422f5ff/uploads/origins/c20dec3b-5903-4caf-b6a6-76edad36b9f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af0a970e06bf7e9bc20b3d914a04ba46", "thumbnail_srcset": "https://si.imgix.net/0422f5ff/uploads/origins/c20dec3b-5903-4caf-b6a6-76edad36b9f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af0a970e06bf7e9bc20b3d914a04ba46, https://si.imgix.net/0422f5ff/uploads/origins/c20dec3b-5903-4caf-b6a6-76edad36b9f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a17e3df8350cb46030151d07048e16c8 2x, https://si.imgix.net/0422f5ff/uploads/origins/c20dec3b-5903-4caf-b6a6-76edad36b9f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=740bd40b1ae602d1c424d088d69c93dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、サカキハクさん！榊白さんのイラストはとても綺麗で、一つ一つのイラストに込められた雰囲気がとても好きです。私のOCのイラストをお願いしたいと思っています。彼女はドラゴンなのですが、人間の姿のイラストをお願いしたいです。https://drive.google.com/file/d/1GAHU3W2NqvocZY39xaqHpYqjzDRqxl2c/view?usp=sharing\n\nドラゴンのマークは入れないでください。また、彼女の目の周りの赤い化粧も入れてください。\n\n彼女は20代半ばです。とても礼儀正しく穏やかな性格です。また、とても賢く、大人です。彼女は住んでいる島のリーダー。地元の人々の面倒を見ている。泳ぎも得意。ビーチで水泳運動の準備をしている彼女のイラストが欲しい。早朝で薄霧がかかっている。彼女はワンピースタイプの水着を着ています。水着の色やデザインは自由です。水中で髪を結んでいる。前髪はまだ緩んでいる。違うポーズやアイデアでもOKです。\n\nこのリクエストを受け入れていただけると幸いです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@sakakihaku/works/12", "thumbnail_src": "https://si.imgix.net/abba3330/uploads/origins/464179f1-fea9-4f6e-a4cd-3b8f68e28868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae2ef306d5d7f1096f945792388b32b6", "thumbnail_srcset": "https://si.imgix.net/abba3330/uploads/origins/464179f1-fea9-4f6e-a4cd-3b8f68e28868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae2ef306d5d7f1096f945792388b32b6, https://si.imgix.net/abba3330/uploads/origins/464179f1-fea9-4f6e-a4cd-3b8f68e28868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc6aa647011ef4556b34d3784d00b090 2x, https://si.imgix.net/abba3330/uploads/origins/464179f1-fea9-4f6e-a4cd-3b8f68e28868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6168065b47808b84019c1716da784958 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは！はじめまして、突然のご連絡で失礼いたします。先生の白色系の插画がとても魅力的で大好きなので、もし可能でしたら私のオリジナルキャラクターを先生のスタイルで描いていただきたく、ご依頼させていただきました。表情や動きはすべて先生にお任せいたします。\nLythros（リスロス）は男性でありながら、雌雄を思わせる中性的な外見を持つ神像です。白髪と紫の瞳を持ち、白を基調に深い青と金をあしらった華麗な長衣を纏い、周囲には甘美で惑わす香気が漂っています。見た目は願いを叶える善き神のようですが、実際には冷淡で、人を喰らうことを純粋な愉悦としています。必ず残してほしい要素は「目を隠した蓮」「脊椎の骨」「装飾品（腕輪・頭冠・首飾り・手飾り）」「スカートの裾から指先に伸びる装飾」です。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/14kYJ6_aQHFhWgCWooWWDoLNyspvpsTNb", "created_at": "", "completed_at": ""}, {"path": "/@sakakihaku/works/11", "thumbnail_src": "https://si.imgix.net/fbefa619/uploads/origins/ce42a7fa-4445-4dc5-8220-7c9777db5e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b239aa6aa0319a6a2b70eed2707d4b9e", "thumbnail_srcset": "https://si.imgix.net/fbefa619/uploads/origins/ce42a7fa-4445-4dc5-8220-7c9777db5e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b239aa6aa0319a6a2b70eed2707d4b9e, https://si.imgix.net/fbefa619/uploads/origins/ce42a7fa-4445-4dc5-8220-7c9777db5e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e3530b1a2792d1d144fd336c1cc5795 2x, https://si.imgix.net/fbefa619/uploads/origins/ce42a7fa-4445-4dc5-8220-7c9777db5e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7411c43503c4d162c5297371a1164e9 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n透明感のある素敵なイラストをXでお見かけしてリクエストさせて頂きました。\n条件が合いましたら是非お願い致します…！\n\n・構図等は描きやすいもので構いません\n・人物、背景、サインのレイヤーが分かれたデータでお願いします\n・配信活動をしているのでその活動にて使用させて頂きたいです\n\nOC特徴\n・病弱\n・幸薄\n・彩度低め\n\nご縁がありましたらよろしくお願い致します！\n\nhttps://photos.app.goo.gl/7KC8kEicqpD13WYZ9", "created_at": "", "completed_at": ""}, {"path": "/@sakakihaku/works/10", "thumbnail_src": "https://si.imgix.net/24228631/uploads/origins/24183abd-95b6-4df5-bbd0-30134c4851c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&tx