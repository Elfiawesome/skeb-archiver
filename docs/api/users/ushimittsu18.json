を頂けますと大変嬉しいです。\n希望順に記載致しましたので、金額の範囲内で可能なものがあればご対応頂けますと幸いです。\n・射精シーン。\n　立派な竿からイベリスの顔めがけてビュービュー大量にぶち撒けまくります。\n・事後。\n　大量の精液がイベリスの顔や胸にぶっかかります。\n　イベリスは瞳に薄いピンクのハートマークを浮かべながらうっとりしつつ微笑みます。\n・お尻をワイプ（小窓）描写。\n　ワイプでイベリスのお尻が見えるものです。\n　セックスもしまくっていて、性器から大量の精液がドボドボ滝のように流れ落ちています。\n\n以上、細かく記載してしまいましたが、もしよければお願いします……！\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%a4%a5%d9%a5%ea%a5%b9", "created_at": "", "completed_at": ""}, {"path": "/@ushimittsu18/works/64", "thumbnail_src": "https://si.imgix.net/a3dd7392/uploads/origins/cd1428ed-c345-4f4b-bd35-d840aa6a5708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a40b1dc5357153a7224f2e04a5b921c7", "thumbnail_srcset": "https://si.imgix.net/a3dd7392/uploads/origins/cd1428ed-c345-4f4b-bd35-d840aa6a5708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a40b1dc5357153a7224f2e04a5b921c7, https://si.imgix.net/a3dd7392/uploads/origins/cd1428ed-c345-4f4b-bd35-d840aa6a5708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8dfb7fcda5755985508b1780cabd4824 2x, https://si.imgix.net/a3dd7392/uploads/origins/cd1428ed-c345-4f4b-bd35-d840aa6a5708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5af4fd246b5995d67601c98477b85070 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ushimittsu18/works/63", "thumbnail_src": "https://si.imgix.net/4626248f/uploads/origins/dc2a0665-9285-42ad-a14a-0c3f5ce95dd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9cd325e2b079d53e5e9727aa665f60", "thumbnail_srcset": "https://si.im