5ba-bbc7-1100a4e6beb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72f39ba9ee7e7b3dcb500a11bf6b9ef, https://si.imgix.net/7a1af929/uploads/origins/acff106c-a720-45ba-bbc7-1100a4e6beb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f01b505375cb2dbf615ecb5973417bf 2x, https://si.imgix.net/7a1af929/uploads/origins/acff106c-a720-45ba-bbc7-1100a4e6beb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5262bbee505ae41005ce818cc745410 3x", "genre": "art", "nsfw": false, "body": "前回はリクエスト受けていただきありがとうございました！\n今回も無田虚さんのイラストをお願いいたします！\n\n以下の要素を含めていただけると助かります。\n・雪\n・和傘\n・和服\n正面からではなく、横もしくは振り返って微笑んでる感じで、\n可愛いより綺麗寄りに静かな雰囲気だと嬉しいですが、お任せします！！！\n\n何卒ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kyomudaaa/works/3", "thumbnail_src": "https://si.imgix.net/b276f4f5/uploads/origins/6b495d58-154d-4635-aa8e-78cc831bd394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30e9eb17614afa79a9970e69e60ecdf", "thumbnail_srcset": "https://si.imgix.net/b276f4f5/uploads/origins/6b495d58-154d-4635-aa8e-78cc831bd394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30e9eb17614afa79a9970e69e60ecdf, https://si.imgix.net/b276f4f5/uploads/origins/6b495d58-154d-4635-aa8e-78cc831bd394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d27a3de45be0056d6951f9abb3ee702b 2x, https://si.imgix.net/b276f4f5/uploads/origins/6b495d58-154d-4635-aa8e-78cc831bd394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b46b0e5af07a05abe9dcf947b52000e 3x", "genre": "art", "nsfw": false, "body": "大変遅くなりましたが、うーちゃんに是非描いて欲しいイラストがあるので、何卒よろしくお願いします！\n俺は犬が大好きで、もう亡くなってしまったんですが、茶柴犬を飼ってました。\nなのでうーちゃんには是非茶柴犬を描いて欲しいです！\n俺の大好きなうーちゃんのイラスト描いた柴犬を見てみたいと思って依頼させて頂きました。\n愛犬の名前は風真(ふうま)やったのでどこかに入れてやってくれるとめちゃくちゃ嬉しいです。\n毎日忙しいやろうけど、是非ともよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@kyomudaaa/works/2", "thumbnail_src