6a0c923adaeaa308099a6089c0c25d 2x, https://si.imgix.net/43f6d426/uploads/outputs/ac770fc7-87a3-4900-b774-00be20275ca6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45d41c8ee900ec16ee4cc44aca070edf 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/21", "thumbnail_src": "https://si.imgix.net/d3d1daa6/uploads/outputs/432ba30d-c96c-459f-a560-50e016d61115?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e56c336ee1942cc21087d01975416350", "thumbnail_srcset": "https://si.imgix.net/d3d1daa6/uploads/outputs/432ba30d-c96c-459f-a560-50e016d61115?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e56c336ee1942cc21087d01975416350, https://si.imgix.net/d3d1daa6/uploads/outputs/432ba30d-c96c-459f-a560-50e016d61115?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40dff68ccdbd9ecb4b3ea4c822f0ef21 2x, https://si.imgix.net/d3d1daa6/uploads/outputs/432ba30d-c96c-459f-a560-50e016d61115?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1405a59f7ca53c5cfebc35dc742e978 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/20", "thumbnail_src": "https://si.imgix.net/ce976591/uploads/outputs/6a29e384-a6aa-4904-aa8f-862d84200520?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4378900b451be9a03df85cf1dcb6e62a", "thumbnail_srcset": "https://si.imgix.net/ce976591/uploads/outputs/6a29e384-a6aa-4904-aa8f-862d84200520?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4378900b451be9a03df85cf1dcb6e62a, https://si.imgix.net/ce976591/uploads/outputs/6a29e384-a6aa-4904-aa8f-862d84200520?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eace205214525cc42fa898b1971522b 2x, https://si.imgix.net/ce976591/uploads/outputs/6a29e384-a6aa-4904-aa8f-862d84200520?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ea4406b6160b6142f23204c11cf9f91 3x", "genre": "video", "nsfw": true, "body": "こんにちは、もう一度八雲蘭を描いてほしい。このシナリオでは、彼女は恋人を初めて寝室に招いた。彼を興奮させるために、特別なランジェリーブラジャーを身につけ、手をつないだまま二人でパイズリをする。パイズリのペースはゆっくりで優しいが、まったく上がらない。このペースと圧力は射精を誘発するには十分だが、射精は早く、満足感はあまりない。男性は彼女のブラジャーを引き剥がし、無理矢理パイズリをコントロールし、ランの顔とオッパイに乱雑に射精するまで、ランのオッパイをペニスに沿って上下に激しく動かす。蘭は一瞬恥ずかしそうな顔をするが、胸を激しく揉まれるのが密かに好きなので、その後は励ますような笑みを浮かべる。男性はペニスがまだ敏感なので、最初はゆっくりとパイズリを続けるが、すぐにエスカレートして再び射精する。今度は蘭の胸を押しつけ、ペニスを丸ごと包み込みながら射精する。蘭の胸の谷間から精液がわずかに漏れ、少量ずつ噴き出す。部屋を薄暗い照明にしてロマンチックな雰囲気にし、カメラは男性目線にしたい。\n\n以下、参考にしてほしい：\nhttps://drive.google.com/drive/folders/1--6_q2tnV9iqExGUvqZSf7Hq3HWC_X8c", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/19", "thumbnail_src": "https://si.imgix.net/1b2d17a2/uploads/outputs/30348e9e-11c6-4465-8024-e010149bd003?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a816ceea30b27eea9c0b3b1e61a53de0", "thumbnail_srcset": "https://si.imgix.net/1b2d17a2/uploads/outputs/30348e9e-11c6-4465-8024-e010149bd003?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a816ceea30b27eea9c0b3b1e61a53de0, https://si.imgix.net/1b2d17a2/uploads/outputs/30348e9e-11c6-4465-8024-e010149bd003?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63b3780e85ad748f40798018e8d58c6f 2x, https://si.imgix.net/1b2d17a2/uploads/outputs/30348e9e-11c6-4465-8024-e010149bd003?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc020930859799b571f5ca247f4f1b7e 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/18", "thumbnail_src": "https://si.imgix.net/7b42b0e7/uploads/outputs/bb32c3b1-666f-455e-a339-3bbf70bf328d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c908c5475017e9b9fc96ff6b4be2db8", "thumbnail_srcset": "https://si.imgix.net/7b42b0e7/uploads/outputs/bb32c3b1-666f-455e-a339-3bbf70bf328d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c908c5475017e9b9fc96ff6b4be2db8, https://si.imgix.net/7b42b0e7/uploads/outputs/bb32c3b1-666f-455e-a339-3bbf70bf328d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76aa2bd8f282bb78f7953075105fbab1 2x, https://si.imgix.net/7b42b0e7/uploads/outputs/bb32c3b1-666f-455e-a339-3bbf70bf328d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d8283b86832ab5ab3db4eff5a571aa9 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/17", "thumbnail_src": "https://si.imgix.net/9770b6a9/uploads/outputs/c0885dd6-09a7-4fee-a6e1-c56f700c1a55?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=941e4fe708043c7d4fe94233e072db38", "thumbnail_srcset": "https://si.imgix.net/9770b6a9/uploads/outputs/c0885dd6-09a7-4fee-a6e1-c56f700c1a55?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=941e4fe708043c7d4fe94233e072db38, https://si.imgix.net/9770b6a9/uploads/outputs/c0885dd6-09a7-4fee-a6e1-c56f700c1a55?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b6838a4a7fcf74d0c7005fad1c56d2f 2x, https://si.imgix.net/9770b6a9/uploads/outputs/c0885dd6-09a7-4fee-a6e1-c56f700c1a55?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f07f4b935d2144421975b51c22c5b977 3x", "genre": "video", "nsfw": true, "body": "再びこんにちは！前回の依頼では素晴らしい作品をありがとうございました。\n\nエヴァンゲリオンのアスカを描いてください。アスカは牛柄のレギンスと手袋をしている。アスカの重い乳房には乳汁があふれている。 青白い手で乳を搾られるアスカ。搾乳されながら至福の表情を浮かべるアスカ。アスカは搾乳されると嬉しそうにモオー。\n\nアニメーションの参考に。\nhttps://files.catbox.moe/hnpc74.gif\nhttps://files.catbox.moe/twm1a4.gif\n\n理想的には、これらの搾乳テクニックを組み合わせたものが描かれるだろう。2つ目のアニメーションと同じように乳房全体を引き下げ、最後は1つ目のアニメーションと同じように乳首を下向きにしぼる。\n\nあとは皆さんのご判断にお任せします。\n御時間ありがとうございます。\n\n---------------\nEnglish text:\n\nHello again! Thank you for the great work on my last commission.\n\nPlease draw Asuka from Evangelion. Asuka is wearing cow print leggings and gloves. Asuka's heavy boobs are full of milk. Asuka is being milked by pale hands. Asuka has a blissful expression as she is being milked. Asuka happily moos as she is milked.\n\nFor animation reference.\nhttps://files.catbox.moe/hnpc74.gif\nhttps://files.catbox.moe/twm1a4.gif\n\nIdeally, I'd like to see a combination of the milking techniques shown in these animations: The entire breast is squeezed from the top downward as in the second animation, and finally the nipple squeezed downward as in the first animation.\n\nThe rest is left to your discretion.\nThank you for your time.\n\nhttps://files.catbox.moe/hnpc74.gif", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/16", "thumbnail_src": "https://si.imgix.net/b173f1b1/uploads/outputs/3fe0c6f3-82c3-480b-9b8d-7c5a8a6deed0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=be87192dda6cf441a0ffa83d2e3fa4bf", "thumbnail_srcset": "https://si.imgix.net/b173f1b1/uploads/outputs/3fe0c6f3-82c3-480b-9b8d-7c5a8a6deed0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=be87192dda6cf441a0ffa83d2e3fa4bf, https://si.imgix.net/b173f1b1/uploads/outputs/3fe0c6f3-82c3-480b-9b8d-7c5a8a6deed0?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d53356f6a50e4886de1601fac65b020 2x, https://si.imgix.net/b173f1b1/uploads/outputs/3fe0c6f3-82c3-480b-9b8d-7c5a8a6deed0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba026b6e1b6350e953f627d95c192ef2 3x", "genre": "video", "nsfw": true, "body": "八雲蘭に八雲ゆかりをパイズリしてもらいたい。シナリオでは、ゆかりは嬉しそうに蘭にお願いするが、蘭は不愉快に思い、ただの雑用としか思っていないので、ゆかりの射精後まであまりパイズリに熱中しない。由香里は蘭の柔らかさの快感に身を任せ、熱心に腰を突き始める。やがて快感に狂った由香里は蘭の谷間に射精し続けるが、蘭はそれでもパイズリを続け、由香里は蘭の乳房の快感の奴隷と化す。カメラのアングルは、ゆかりの目線にしてほしい。蘭とゆかりは普段着で、蘭は胸を露出させる。ゆかりのパイズリの声優も入れていただけるとありがたいですが、なければ問題ありません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/15", "thumbnail_src": "https://si.imgix.net/52a4635f/uploads/outputs/2b35b934-6dfb-421e-a381-7a02622ea437?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f0e1fbfdef8e1fcef1fad2a7bd43dbb", "thumbnail_srcset": "https://si.imgix.net/52a4635f/uploads/outputs/2b35b934-6dfb-421e-a381-7a02622ea437?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f0e1fbfdef8e1fcef1fad2a7bd43dbb, https://si.imgix.net/52a4635f/uploads/outputs/2b35b934-6dfb-421e-a381-7a02622ea437?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3609311c4b4df5f1d6ee1fbc7aaeab93 2x, https://si.imgix.net/52a4635f/uploads/outputs/2b35b934-6dfb-421e-a381-7a02622ea437?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8548455ed19c07bc024b2cfcb346b768 3x", "genre": "video", "nsfw": true, "body": "ホロライブENから牛柄ビキニのセレス・ファウナをお願いしたいです。ビキニはhttps://twitter.com/Mikoto_LY/status/1562043709335945217 のようなアイパッチスタイルです。\n\nできれば騎乗位で、弾むおっぱいに注目してほしいです。できればセックス中に母乳が漏れるところも取り入れてもらえると嬉しいです。また、騎乗位をアニメ化しないのであれば、代わりにどんな体位でパイズリをしても自由です。ご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/14", "thumbnail_src": "https://si.imgix.net/3ffceba8/uploads/origins/d353e0a4-84f5-4162-a676-28e9a7b6f906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=209759945099dadad449b9e9440d4677", "thumbnail_srcset": "https://si.imgix.net/3ffceba8/uploads/origins/d353e0a4-84f5-4162-a676-28e9a7b6f906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=209759945099dadad449b9e9440d4677, https://si.imgix.net/3ffceba8/uploads/origins/d353e0a4-84f5-4162-a676-28e9a7b6f906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74c09518bb5eb3792632c942dd521b96 2x, https://si.imgix.net/3ffceba8/uploads/origins/d353e0a4-84f5-4162-a676-28e9a7b6f906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4a14a821efd0abca223f2f0ce4b83ea 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/13", "thumbnail_src": "https://si.imgix.net/253891fb/uploads/outputs/08896aab-91a9-4c6e-8e91-950f888cf8fe?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a74a1488de728ac146752845981172ce", "thumbnail_srcset": "https://si.imgix.net/253891fb/uploads/outputs/08896aab-91a9-4c6e-8e91-950f888cf8fe?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a74a1488de728ac146752845981172ce, https://si.imgix.net/253891fb/uploads/outputs/08896aab-91a9-4c6e-8e91-950f888cf8fe?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=281780a0139ed80309e7fe921d01a46e 2x, https://si.imgix.net/253891fb/uploads/outputs/08896aab-91a9-4c6e-8e91-950f888cf8fe?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b389e5dd3cf6f529de40c86631a08efc 3x", "genre": "video", "nsfw": true, "body": "前回の早苗のリクエストに時間を割いていただき、ありがとうございました。\n\n今回は東方Projectの八雲ゆかりさんのパイズリをお願いします。妖艶～Perfect Cherry Blossomの衣装で（各リファレンスにあります）、シンプルなトップスで、簡単に下ろして美しい巨乳を見せることができます。位置や視点は、これまでの愛ちゃんや幽々子の作品と同じでいいと思います。表情は2種類欲しいですね：前半は、これから起こることを予期して唇をなめているような表情（例4のような、赤面していない表情）、後半は、ペースを速めながら、どこか小悪魔的な笑みを浮かべているような表情（例2のような表情）。\n\n例1と例3では、ペニスの持ち主は服装で判別できるフタナリ役の八雲らんである。もしよろしければ、ペニスの持ち主は蘭さんにして、例のように部分的に見えるようにしてほしいです。もしそうするのであれば、例3で彼女のパンティがペニスのために横に押されているディテールを再現してほしい。あなたの能力の範囲内かどうかわかりませんが、フタにこだわらない人を満足させるために、一般的な男性で代替案を作るのは自由です。\n\n射精も、愛ちゃんや由結子と同じように、乳房内射精と外射精を演出してほしいです。外部射精は、例3のように、ゆかりちゃんの顔、髪、帽子、胸、ランの一部がザーメンまみれになるような雑な射精をしてほしいです。\n\n例\n1. https://www.pixiv.net/en/artworks/85132915\n2. https://twitter.com/tousens/status/1721855171536581113\n3. https://www.pixiv.net/en/artworks/88170115\n4. https://twitter.com/Buckethead_ero/status/1512357746670137348\n\nもしこのリクエストを受け入れてくださるようでしたら、私の東方リクエストにお付き合いくださり、本当にありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/12", "thumbnail_src": "https://si.imgix.net/0b924059/uploads/outputs/23c50184-a7fd-4b0c-b1a0-98c6cd9228fb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6561ded41841777998f96fbfe6551416", "thumbnail_srcset": "https://si.imgix.net/0b924059/uploads/outputs/23c50184-a7fd-4b0c-b1a0-98c6cd9228fb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6561ded41841777998f96fbfe6551416, https://si.imgix.net/0b924059/uploads/outputs/23c50184-a7fd-4b0c-b1a0-98c6cd9228fb?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=355d2f38db88f2eadf0c366732277926 2x, https://si.imgix.net/0b924059/uploads/outputs/23c50184-a7fd-4b0c-b1a0-98c6cd9228fb?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fd0bd10e32b7b102ce8cd62a4173671 3x", "genre": "video", "nsfw": true, "body": "こんにちは！\n\n私はパイズリに夢中なので、私のギャルOCアリッサのアニメーションのリクエストを受け入れてくれたら嬉しいです。\n彼女はPカップの胸があって、\"paizuri queen \"と呼ばれているんだ😚。\n\n動画の再生時間は30秒から1分です。\n最終的にはあなた次第です。\n\n男性の視点（POV）です。\n彼は彼女の胸を強く掴んで揉んでいます。\nhttps://twitter.com/atahuta_/status/1734204067986235604。\n\n彼女は彼の手首か腕を掴んでいる。\n歯を食いしばって笑っている。\n彼女はトップレスだが、アクセサリー（サングラス、イヤリングなど）をつけている。\n\n彼女の胸がとても大きいため、彼のペニスの先がわずかに見える（彼の下半身に叩きつけられるとき）。\n類似作品：https://skeb.jp/@ZuriKitt_en/works/6\n\n私は3回の射精を想像する。\n最初の射精は大きく、彼女の顔と胸の谷間をぐちゃぐちゃにする。\n\nアニメーションはより速い乳房の動きで進行する。\n\nそして2回目の射精も基本的に同じなので、彼女の顔はさらに精液でぐちゃぐちゃになる。\n\n速い乳房の動きは続き、彼は3度目の射精をする。\nしかし、今度は彼のペニスは完全に乳房の間に埋まり、乳房は激しくグラグラしている。\n最後はこのシナリオに似ている： https://twitter.com/ZuriKitt_en/status/1727324900241944761\n\n彼女の顔のほくろの追加もお忘れなく。\n\n以上。\n無理のない範囲でお願いします。\n\nありがとう\n\nhttps://drive.google.com/drive/folders/1xMwHURRf_3wxx3G-hL4IWjj-EVL7xu96", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/11", "thumbnail_src": "https://si.imgix.net/74073312/uploads/outputs/b07dea1b-f9f0-4bd6-aa55-31fd6bb5b231?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8599e874dddad3cf3f51b2c3473f9ac5", "thumbnail_srcset": "https://si.imgix.net/74073312/uploads/outputs/b07dea1b-f9f0-4bd6-aa55-31fd6bb5b231?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8599e874dddad3cf3f51b2c3473f9ac5, https://si.imgix.net/74073312/uploads/outputs/b07dea1b-f9f0-4bd6-aa55-31fd6bb5b231?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6366635b9797bb80d0098b62ce9a97fd 2x, https://si.imgix.net/74073312/uploads/outputs/b07dea1b-f9f0-4bd6-aa55-31fd6bb5b231?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e3d645b259509fb2e27652dd885dedb 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/10", "thumbnail_src": "https://si.imgix.net/4dc9b759/uploads/outputs/2651a6a4-d42f-48d5-9a1b-2ae7f73f0004?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=123019dccda22ce9e2e05436aa5384e5", "thumbnail_srcset": "https://si.imgix.net/4dc9b759/uploads/outputs/2651a6a4-d42f-48d5-9a1b-2ae7f73f0004?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=123019dccda22ce9e2e05436aa5384e5, https://si.imgix.net/4dc9b759/uploads/outputs/2651a6a4-d42f-48d5-9a1b-2ae7f73f0004?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=478dcec684f960685d73e283cd22530b 2x, https://si.imgix.net/4dc9b759/uploads/outputs/2651a6a4-d42f-48d5-9a1b-2ae7f73f0004?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1e6bc830f5c9775d241d209e0c7b6ca 3x", "genre": "video", "nsfw": true, "body": "初めまして。私はあなたのアートワークが大好きです。\n\n特に最近のアニメが好きだ：\nhttps://twitter.com/ZuriKitt_en/status/1738573457158549647\n\n巨乳の狼男りるが肌の薄い男性にパイズリを披露する同様のアニメを見てみたい。りるの胸は丸出しで、乳首はピンク色だ。彼は彼女の巨大な胸に我慢できず、射精してしまう。\nポーズとバストの大きさは、上で紹介した以前のアニメーションに似ているのが理想です。\n\nりるの参考作品をいくつか紹介しよう：\nhttps://files.catbox.moe/qhk7ti.jpg\nhttps://files.catbox.moe/1eodr1.jpg\nhttps://files.catbox.moe/8d0bk2.jpg\nhttps://files.catbox.moe/aw0xjd.gif\nhttps://files.catbox.moe/za31v8.gif\n\nあとは皆さんのご判断にお任せします。\n御時間ありがとうございます。\n\nhttps://twitter.com/ZuriKitt_en/status/1738573457158549647", "created_at": "", "completed_at": ""}, {"path": "/@ZuriKitt_en/works/9", "thumbnail_src": "https://si.imgix.net/ddd3088f/uploads/outputs/abc822c2-b884-4984-aa50-645ed73a4f31?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5627e68b9a6567356298ed5e5cef4fcc", "thumbnail_srcset": "https://si.imgix.net/ddd3088f/uploads/outputs/abc822c2-b884-4984-