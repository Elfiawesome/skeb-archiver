e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb9b6698da97a954eddf5ee02aab98c7, https://si.imgix.net/8a9308ec/uploads/origins/2ec29b57-b9a7-47df-b5e6-0ae2af94d7e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0091e2651920ce23b24ec6c8eca890d9 2x, https://si.imgix.net/8a9308ec/uploads/origins/2ec29b57-b9a7-47df-b5e6-0ae2af94d7e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a95d9d7c5c557dbd0d074aa960a7a741 3x", "genre": "art", "nsfw": false, "body": "うどん先生、はじめまして。\nこの度はご依頼を検討していただき、ありがとうございます。\n\nこの度は自分のオリジナルキャラクター二人のイラストをお願いしたくて依頼を送らせていただきました。\n\n服装設定や参考資料は下記のURLにて添付させていただきました。\nhttps://drive.google.com/drive/folders/1aH5Yo-FYLw-WZ5H8HqsdRs240Pg7U8Pz?usp=sharing\n表現、解釈、使う服装設定は全部お任せします。\n\nもしご予算が不足していましたら、\n金額を上乗せして再度依頼をお送りすることも可能です。\n\nご縁がありましたら、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@__udonh/works/29", "thumbnail_src": "https://si.imgix.net/600928bf/uploads/origins/e0718528-0967-4475-b502-fa4314a0591a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebc38a1e8614c9277b9e9e35fd98221e", "thumbnail_srcset": "https://si.imgix.net/600928bf/uploads/origins/e0718528-0967-4475-b502-fa4314a0591a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebc38a1e8614c9277b9e9e35fd98221e, https://si.imgix.net/600928bf/uploads/origins/e0718528-0967-4475-b502-fa4314a0591a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ae87e1d36a0c0fa977fdcb5e8d83e65 2x, https://si.imgix.net/600928bf/uploads/origins/e0718528-0967-4475-b502-fa4314a0591a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=20