reated_at": "", "completed_at": ""}, {"path": "/@ckwmg11/works/10", "thumbnail_src": "https://si.imgix.net/92e9cbdf/uploads/origins/59870c45-3b06-4499-9bd6-0571e01239b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=029001c26baf6b9e45f205c5ba223c4f", "thumbnail_srcset": "https://si.imgix.net/92e9cbdf/uploads/origins/59870c45-3b06-4499-9bd6-0571e01239b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=029001c26baf6b9e45f205c5ba223c4f, https://si.imgix.net/92e9cbdf/uploads/origins/59870c45-3b06-4499-9bd6-0571e01239b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dcac54b99e61ced2be833d984f5ef19 2x, https://si.imgix.net/92e9cbdf/uploads/origins/59870c45-3b06-4499-9bd6-0571e01239b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c484330ce90fe08bc262df2dd6c9047 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ckwmg11/works/9", "thumbnail_src": "https://si.imgix.net/47b61014/uploads/origins/d5dfc1f2-3c55-471a-b260-6f901eb80bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061a29b95ece7358b80f0068a9dd9bd5", "thumbnail_srcset": "https://si.imgix.net/47b61014/uploads/origins/d5dfc1f2-3c55-471a-b260-6f901eb80bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061a29b95ece7358b80f0068a9dd9bd5, https://si.imgix.net/47b61014/uploads/origins/d5dfc1f2-3c55-471a-b260-6f901eb80bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df5c888d1c816bb50982ab0f2191e1d 2x, https://si.imgix.net/47b61014/uploads/origins/d5dfc1f2-3c55-471a-b260-6f901eb80bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f8aadb7e13b5db6751a3f702e1eb760 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\nオリジナルのキャラクターをアニメ風にすることに興味があります。具体的には、あなたのスタイルです。\n\nhttps://imgur.com/a/C0kSB5O?fbclid=IwAR1_xTtTWQvPUeXpXhOrWTf7TX0rIDu9PCyRPY5OYcXCCMBT9XE4JxdpvUo\n\n上記のリンクは、私が他のアーティストに依頼したオリジナルキャラクターのリストです。あなたへの最初の依頼は、リンクを開いたときの最初のキャラクター、生意気な笑顔でパイロットのヘルメットを持った男性パイロットのイメージを描いていただきたいのです。あなたのスタイルで描いていただければ、とてもありがたいです。\n\n最初の1枚だけでいいよ。気に入ったものがあれば、残りの作品もお願いしたいと思っています。最後になりましたが、このメッセージを読んでいただきありがとうございました。そして、私のリクエストを受け入れていただけると幸いです。\n\nhttps://imgur.com/a/C0kSB5O?fbclid=IwAR1_xTtTWQvPUeXpXhOrWTf7TX0rIDu9PCyRPY5OYcXCCMBT9XE4JxdpvUo", "created_at": "", "completed_at": ""}, {"path": "/@ckwmg11/works/8", "thumbnail_src": "https://si.imgix.net/2ea70305/uploads/origins/125c0fc0-952d-4913-a9a0-56152bf6218f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cd2bca6dc574986f420290799b8a92c", "thumbnail_srcset": "https://si.imgix.net/2ea70305/uploads/origins/125c0fc0-952d-4913-a9a0-56152bf6218f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cd2bca6dc574986f420290799b8a92c, https://si.imgix.net/2ea70305/uploads/origins/125c0fc0-952d-4913-a9a0-56152bf6218f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a50030d43b4e08484b812a9097020cef 2x, https://si.imgix.net/2ea70305/uploads/origins/125c0fc0-952d-4913-a9a0-56152bf6218f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=675464cc9854cde8dfbc