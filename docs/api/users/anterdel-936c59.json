format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a33b8c205aa5b186809fa0d8f5ea9ef 2x, https://si.imgix.net/f18485e3/requests/45055_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=874fb4bef39a9e71c2077b70a8533bba 3x", "genre": "art", "nsfw": true, "body": "キャラクター、艦隊これくしょんの間宮とのイチャラブセックス\n\n仕事で疲れた提督(プレイヤー)を、身体で癒してくれる内容を希望します。\n具体的な内容はあすとらさんにお任せしますが、１枚絵に数点入っているのを希望します。\n\n体型が分かりにくいので、水着modeが掲載されてるサイトを資料URLに載せておきます\n\nhttps://kcwiki.blog.fc2.com/blog-entry-1328.html", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/10", "thumbnail_src": "https://si.imgix.net/7108008b/requests/44678_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2f3462bd5c028ca7fc35798ac98d35", "thumbnail_srcset": "https://si.imgix.net/7108008b/requests/44678_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2f3462bd5c028ca7fc35798ac98d35, https://si.imgix.net/7108008b/requests/44678_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64bb6d152b6873565e8fa2a6bdd90045 2x, https://si.imgix.net/7108008b/requests/44678_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b35925da2fe106f478d44f730a56587d 3x", "genre": "art", "nsfw": true, "body": "#夕焼ヒノ (うちのこ)が、乳首をいじられて気持ちよさそうにしている様子をお願いできないでしょうか？\n構図はお任せしますが、雰囲気的にはこんなイメージです。\nhttps://twitter.com/anterdel/status/1196270941262663680\n\nhttps://twitter.com/i/moments/1140110518604029952\nhttps://www.pixiv.net/fanbox/creator/41166920", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/9", "thumbnail_src": "https://si.imgix.net/6dccfbed/requests/41309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9a052fedb9cfbababfaf22bb72ce9c7", "thumbnail_srcset": "https://si.imgix.net/6dccfbed/requests/41309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9a052fedb9cfbababfaf22bb72ce9c7, https://si.imgix.net/6dccfbed/requests/41309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da6587e2425f0ed170fd0e42b84853cf 2x, https://si.imgix.net/6dccfbed/requests/41309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=287392fd3204f55e1624ee2f64fe31a1 3x", "genre": "art", "nsfw": true, "body": "あすとらさんの描くイラストが好きで、今回SKEBでリクエストをさせていただきたいです。\n\n内容は東方の響子ちゃんで、妊娠ボテ腹エッチ(中出しあり)をしているものをお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/8", "thumbnail_src": "https://si.imgix.net/c5ca92e8/requests/43652_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b08685f85740449e1b5c031a58293c8", "thumbnail_srcset": "https://si.imgix.net/c5ca92e8/requests/43652_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b08685f85740449e1b5c031a58293c8, https://si.imgix.net/c5ca92e8/requests/43652_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fded314e083fb46231ecd463837d3d2f 2x, https://si.imgix.net/c5ca92e8/requests/43652_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad38a4485debe6b4e76e3c1624ee45ae 3x", "genre": "art", "nsfw": true, "body": "キャラクターは艦隊これくしょんの古鷹改二\n\nレミセックスや紅魔館えっちの様な一枚にエッチの流れが入っている絵を可能なかぎりでいいのでお願いしたいです。\n\n相手役の男性は特徴の無い感じで状況に合わせて省略してください。\n\n内容\n激しい性交の跡が見て取れる様な汗をかいて乱れた様子の二人がお互いに腰を突き合わせ絶頂している絵（古鷹改二は腰を反らしながらも陰茎を一番奥まで挿入し中だしされている）（断面図表現はいらないです）\n\n古鷹改二の甘い絶頂が続いている様な蕩け顔の絵\n\nエッチが終わったと油断しているところに密着し、激しく腰振りを再開され驚き、感じる等の絵をお願いします。\n\nあくまで要望ですので、描きやすい内容に変えてくださって大丈夫です。また、無理せず依頼料に合わせて着色や要望を省略してください。\n\nビクビクといった擬音や台詞ありと無しの差分があると嬉しいです。\n　\n古鷹改二の衣服の着脱、胸の形、陰毛の有無はお任せします。また、片目から光を出せるキャラクターですが光の有無もお任せします。\n\n古鷹改二　https://d.kuku.lu/ce9bf31400（こちらのイメージでお願いします）\n目の光参考　https://d.kuku.lu/33356c1d14\n本文の指示は簡潔にとなっているのに長くなってしまいすみません。", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/7", "thumbnail_src": "https://si.imgix.net/b1772746/requests/41904_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d54751c493fe4240d904bb5650d7b70", "thumbnail_srcset": "https://si.imgix.net/b1772746/requests/41904_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d54751c493fe4240d904bb5650d7b70, https://si.imgix.net/b1772746/requests/41904_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7760af940a8c4314888b109d32a4d6a2 2x, https://si.imgix.net/b1772746/requests/41904_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99cbd5eab6d79d948b335b7d74650c51 3x", "genre": "art", "nsfw": true, "body": "ToLOVEるダークネスのモモ・ベリア・デビルークのイラストをお願いします。\n服を脱いだ裸の状態でのイチャラブエッチで、中出しして喜んでいるところをお願いします。\n体位や構図はおまかせします。", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/6", "thumbnail_src": "https://si.imgix.net/9942e2c1/requests/41761_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc72d8aee3bb1dd388a975232f19353b", "thumbnail_srcset": "https://si.imgix.net/9942e2c1/requests/41761_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc72d8aee3bb1dd388a975232f19353b, https://si.imgix.net/9942e2c1/requests/41761_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b9e15fc262104f9b43b67b8eed1bbfd 2x, https://si.imgix.net/9942e2c1/requests/41761_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=721e08909c2159a20caab9c88b523ca5 3x", "genre": "art", "nsfw": true, "body": "東方以外も可能でしたら(無理ならキャンセルしてください)、#夕焼ヒノ (うちのこ)のイチャラブエッチをハメ撮り視点でお願いできないでしょうか？\nhttps://twitter.com/i/moments/1140110518604029952\nhttps://www.pixiv.net/fanbox/creator/41166920", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/5", "thumbnail_src": "https://si.imgix.net/d227f177/requests/40951_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=237246b7bbb4cee10d6ee898fbdf9b0c", "thumbnail_srcset": "https://si.imgix.net/d227f177/requests/40951_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=237246b7bbb4cee10d6ee898fbdf9b0c, https://si.imgix.net/d227f177/requests/40951_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da9ae4eaf1bf470093842772ce18224d 2x, https://si.imgix.net/d227f177/requests/40951_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b22864853bf8c604b6c30cc8b31d4a14 3x", "genre": "art", "nsfw": true, "body": "私のうちの子でいちゃらぶエッチなイラストをお願いいたします。黒ストを破って挿入し中に溢れるぐらい沢山出されて絶頂している様子をお願い致します。資料に関しましては、私の固定ツイートか、pixiv等を参照して頂けるとありがたいです。\n\nhttps://www.pixiv.net/member.php?id=3318036", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/4", "thumbnail_src": "https://si.imgix.net/475f8196/requests/40999_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a5f1244f56b7f28cd0e4adafc240dd", "thumbnail_srcset": "https://si.imgix.net/475f8196/requests/40999_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a5f1244f56b7f28cd0e4adafc240dd, https://si.imgix.net/475f8196/requests/40999_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75afbecfc0acc49215d571a17d409c97 2x, https://si.imgix.net/475f8196/requests/40999_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33608e9781803f1fb40d4dd60a3faa16 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nあすとらさんの作品をいつも楽しみに拝見しております。\nリクエストですが、リグル・ナイトバグのいちゃラブなR-18絵をお願いします。\n\n・体位は後背位でお願いします\n・以前あすとらさんが描いたリグルのお尻絵(https://twitter.com/anterdel/status/1081765250775474177?s=19)の続きで、隣で寝ていた恋人が目の前の絶景に我慢できず襲いかかってしまったようなイメージでお願いします\n・リグルの格好は乱れてる内にシャツがはだけて胸を露出してる感じでお願いします。可能ならば脚に脱げてしまったパンツが引っ掛かっている描写もお願いします\n・ハートマークや快感でヒクついてる様子なども描写をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/3", "thumbnail_src": "https://si.imgix.net/04aa23e6/requests/40827_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84666ee8fc0ddd21cfcf49b5ef2053c4", "thumbnail_srcset": "https://si.imgix.net/04aa23e6/requests/40827_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84666ee8fc0ddd21cfcf49b5ef2053c4, https://si.imgix.net/04aa23e6/requests/40827_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4b5fdf98036c3a0dd641a02c3f53fc4 2x, https://si.imgix.net/04aa23e6/requests/40827_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1598449ab78db919f8b038536092da7d 3x", "genre": "art", "nsfw": true, "body": "魂魄妖夢の後背位ハメ撮り視点の絵をお願いします。\n腰のくびれと背中をセクシーに描写して頂けると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/2", "thumbnail_src": "https://si.imgix.net/8af31c99/requests/40983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc2e83ade0719843fc0c95ecda2dd7a", "thumbnail_srcset": "https://si.imgix.net/8af31c99/requests/40983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc2e83ade0719843fc0c95ecda2dd7a, https://si.imgix.net/8af31c99/requests/40983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f757c3d4a681923a052c99ea4ad8af74 2x, https://si.imgix.net/8af31c99/requests/40983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=083293295b78c14029f8f8c136638b61 3x", "genre": "art", "nsfw": true, "body": "東方の西行寺幽々子ちゃんで\n・布団の上で胸が全て見えるくらい着物がはだけてる\n・白濁液まみれの陰茎を頬に押し当てられている\n・顔や胸も白濁液まみれで、舌なめずりをしながら恍惚な表情をしている（ハートマーク付き）\n\nでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@anterdel/works/1", "thumbnail_src": "https://si.imgix.net/12c97d96/requests/40773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4313e75a60e5e3a2918d9237d1fdef15", "thumbnail_srcset": "https://si.imgix.net/12c97d96/requests/40773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4313e75a60e5e3a2918d9237d1fdef15, https://si.imgix.net/12c97d96/requests/40773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4604c53ba6bd66c86af47344b828ad70 2x, https://si.imgix.net/12c97d96/requests/40773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5a20a88bc305f1420fc5313e3903358 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します！\n東方の黒谷ヤマメのイチャラブエッチをお願いいたします！\n\n・服は着用だが胸、大事な箇所は見えている。\n\n・体位は背面座位で男性が片方の手で胸(巨乳)を掴んでもう片方はクリトリスをいじってる。\n\n・トロ顔状態でハートマークなどがあると嬉しいです！\n\n・可能ならば差分(表情+中出し差分)があると嬉しいです。 難しければ中出しバージョンの方を希望いたします。\n\nそのようなイチャラブイラストをよろしくお願いいたします！", "created_at": "", "completed_at": ""}]}