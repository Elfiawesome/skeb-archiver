54b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=345334dbf0ca4f1c5cdddc0084d65e94", "thumbnail_srcset": "https://si.imgix.net/ee6f58e7/uploads/origins/f1bb2a05-40ca-4c3e-b879-3fbb7c054b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=345334dbf0ca4f1c5cdddc0084d65e94, https://si.imgix.net/ee6f58e7/uploads/origins/f1bb2a05-40ca-4c3e-b879-3fbb7c054b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01b6c10c76de5a75f80ffcdb303d8aff 2x, https://si.imgix.net/ee6f58e7/uploads/origins/f1bb2a05-40ca-4c3e-b879-3fbb7c054b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d24127b6e3ce817310e4ed9809c2097 3x", "genre": "art", "nsfw": true, "body": "またまたリクエストさせていただきます。\n今回は今後のリクエストの参考＆リクエストで使用するためのキャラを作って頂きたいです。\n出来れば3人ほど作って頂きたくて(大変でしたら1人でも大丈夫です)、三人とも同じタイプの女性キャラになるのですが、以下の要素で描いていただきたくて\n・年齢は28～34歳\n・胸は普通～少し大きめ、尻が少し大き目(重要 )でジーンズや、タイトスカートをはいたときにいい感じにエロくなるくらいの大きさでプロポーション抜群な感じで\n・3人ともかわいい,ほんわかしてそうって感じではなく、大人っぽい、美しいって感じの見た目でお願いします\n・陰毛はパイパンか整えられている感じで、腋毛は無しで\n・全員人並の羞恥心を持っているが、まんざらでもなさそうに(あるいは挑発的に)なんでもいうことを聞いてくれる\n・エロにはある程度耐性がある\n\n上記のような感じで3人ほどキャラクターを作って頂きたいです。\n上に書いてある要素以外キャラクターの性格等ははすべてお任せします。\n\n描いていただきたい構図としましては、立ち絵＋性格等の説明文(ステータス的な感じ)で描いてほしいです。\n出来ればそれぞれキャラクターの感度等を見たいので、ローターをパンツの中に実は仕込んでいる立ち絵も書いていただきたいです。写真等取られている感じで、3人とも同じローター、同じ震動の強さで平然としていなければならない状況で各キャラクターの反応の違いと通常立ち絵との違いを見てみたいです。\n\n長文失礼しました。\n検討、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/10", "thumbnail_src": "https://si.imgix.net/ef8f7421/uploads/origins/04b2b823-e6d9-4559-889d-9d197da5ceea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3505b130ff738fbf22ff00cc3697571", "thumbnail_srcset": "https://si.imgix.net/ef8f7421/uploads/origins/04b2b823-e6d9-4559-889d-9d197da5ceea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3505b130ff738fbf22ff00cc3697571, https://si.imgix.net/ef8f7421/uploads/origins/04b2b823-e6d9-4559-889d-9d197da5ceea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a92117262692bd3aa7d006e011799a37 2x, https://si.imgix.net/ef8f7421/uploads/origins/04b2b823-e6d9-4559-889d-9d197da5ceea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd7c0997fdc9bfd28d1730a794b62230 3x", "genre": "art", "nsfw": true, "body": "またリクエストさせていただきます。\n以前描かれていたこちらのイラスト【https://www.pixiv.net/artworks/114311743】の概要欄に書いてある特訓シーンを描いて頂きたいです。\nキャラクターは右側の女の子で、日々の特訓を取材（TVでも雑誌でも）されている感じの内容でお願いします。\n服装は取材されているということで、何かしらのえっちな服装をきている感じでお願いします。\n描いて頂きたい詳しい内容としましては、URL概要欄に書いてある内容に則って\n・媚薬を飲んでローター固定\n・吸引バイブ耐久最中にインタビュー\n・スパークリング相手と相互手マン、相手にお姉さんの弱点を言われながら特訓\n等でお願いします。\n\n元イラストのようにお姉さんが余裕で耐えている感じでも、アクメ我慢しているのがまる分かりなくらい愛液が垂れていたり、腰をヘコヘコしたり、潮吹きしていたりする感じでお願いします。\n最終的にお姉さんがアクメするかどうかはお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/9", "thumbnail_src": "https://si.imgix.net/31677e4d/uploads/origins/3ff74e9f-481c-42f2-bed0-3cd6c7b3cb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be5f8e6cca560b9282a210cc08347453", "thumbnail_srcset": "https://si.imgix.net/31677e4d/uploads/origins/3ff74e9f-481c-42f2-bed0-3cd6c7b3cb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be5f8e6cca560b9282a210cc08347453, https://si.imgix.net/31677e4d/uploads/origins/3ff74e9f-481c-42f2-bed0-3cd6c7b3cb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c23539108903057f5763d1cc460108d8 2x, https://si.imgix.net/31677e4d/uploads/origins/3ff74e9f-481c-42f2-bed0-3cd6c7b3cb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f24bdd86926b63eea1f5839da58c616c 3x", "genre": "art", "nsfw": true, "body": "幼い時から超乳でパイズリ奴隷として生きてきた無表情超乳パイズリ奴隷\n\n小中高大人と成長しながらパイズリしていく過程", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/8", "thumbnail_src": "https://si.imgix.net/66ef3397/uploads/origins/e118eb27-3049-47f9-bb42-315136131f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5cabb9f731dc5eb9cfbccac2671e4d0", "thumbnail_srcset": "https://si.imgix.net/66ef3397/uploads/origins/e118eb27-3049-47f9-bb42-315136131f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5cabb9f731dc5eb9cfbccac2671e4d0, https://si.imgix.net/66ef3397/uploads/origins/e118eb27-3049-47f9-bb42-315136131f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0706fab924bb279dc0fa50b25d5b8b83 2x, https://si.imgix.net/66ef3397/uploads/origins/e118eb27-3049-47f9-bb42-315136131f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a7c38c4b4499b72372e8e0975c4586f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/7", "thumbnail_src": "https://si.imgix.net/d9becd90/uploads/origins/1688cb8a-1c2c-4225-ad39-1c79b6c46fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bcd57c1bf2e9c00eb13e2b72e07f5c4", "thumbnail_srcset": "https://si.imgix.net/d9becd90/uploads/origins/1688cb8a-1c2c-4225-ad39-1c79b6c46fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bcd57c1bf2e9c00eb13e2b72e07f5c4, https://si.imgix.net/d9becd90/uploads/origins/1688cb8a-1c2c-4225-ad39-1c79b6c46fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c06517ae831a3832320ad0df34f07137 2x, https://si.imgix.net/d9becd90/uploads/origins/1688cb8a-1c2c-4225-ad39-1c79b6c46fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8df7fc6c3d3b8124f4197a9c9b0c0e6f 3x", "genre": "art", "nsfw": true, "body": "オリジナルでふたなり冒険者パーティーが触手モンスターに搾精されるシチュを差分・セリフ・効果音付きでお願いします。\n\n差分の流れは下記のような感じでお願いします。\n凶暴な触手モンスターに捕まってしまったふたなり冒険者パーティー。\n低い唸り声を上げる口型触手に囲まれて、モンスターに詳しい魔術師以外は全員食べられると思い込んでそれぞれ恐怖したり死を覚悟したりしている。魔術師だけは期待で息を荒げながらちんぽを勃起させてしまっている。\n一斉に触手にちんぽと金玉を激しくしゃぶられたり吸われたりして搾精され始める。魔術師だけは最初から最後までオホ声を上げて悦んでいるが、他のメンバーは混乱→快楽を受け入れてオホ喘ぎ→射精の流れ。\n搾精後、ちんぽや金玉に優しくキスをされたりねっとり舐めしゃぶられたりしているメンバー。全員触手搾精中毒になっていて、更に搾って欲しそうな表情をしている。", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/6", "thumbnail_src": "https://si.imgix.net/fab748cc/uploads/origins/d48bb08e-e5a1-4d34-9207-5e49d57ff0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a45d3d5d5ec8f749197e83a8422cfcc3", "thumbnail_srcset": "https://si.imgix.net/fab748cc/uploads/origins/d48bb08e-e5a1-4d34-9207-5e49d57ff0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a45d3d5d5ec8f749197e83a8422cfcc3, https://si.imgix.net/fab748cc/uploads/origins/d48bb08e-e5a1-4d34-9207-5e49d57ff0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92ee09cdaa0be4f556bf1911805bf19a 2x, https://si.imgix.net/fab748cc/uploads/origins/d48bb08e-e5a1-4d34-9207-5e49d57ff0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cdc8c54c64d0eb78c68a3be8222c9a3 3x", "genre": "art", "nsfw": true, "body": "納品ありがとうございます\n続きをぜひお願いします。\n\n\n次の日、亮は綾香の家に向かい出迎えられる。\n綾香の部屋に通され約束を守っているか服を脱ぐよう言われ服を脱ぎぱんつを見せる。\n確認したら綾香も服を脱ぎ着るよう言う。\n服を着た亮に対しとてもお似合いですよお兄さんと笑いながらスカートをまくり上げるよう命じめくると小ささもあり膨らみも見えないのもあり年上の男の子って聞いていたんですけど年下の女の子の間違いだったのかなと笑いながら聞く。\n亮が言いよどんでいると綾香はパンツの上から股間を握り、返事と強めに言う。\n股間を握りながら年上の男の子じゃなくて年下の女の子ですでしょうと返事をするよう強要する。\n返事をするといい子と満足し手を放す。\nするといい子はご褒美と言い綾香ははいていたパンツを脱ぎ亮の顔面にかぶせる。\n代わりにペニバンを装着して約束通り男の子が絶対にしちゃ駄目な射精させてあげますねと言う。\n亮を四つん這いにさせ挿入、そのままピストン。\nしかし亮がイキそうになるとピストンを止める。すると綾香はイカせてほしかったらちゃんと自身が男の子じゃなくて惨めな劣等女児であることを認めるよう強要する。\n言いよどんでいると違うなら抜いちゃうねとゆっくり抜き始める。\nたどたどしくかつ小声で認めるも聞こえないと言われ大声で劣等女児であることを認める。\n答えに満足した綾香は一度ペニバンを抜くとご褒美と言い根元まで一気に挿入して絶頂させる。\nその後何度もペニバンで犯され空っぽになるまで射精させられた亮。\nすると最後に楽しませてくれたご褒美と言い床にあおむけになり行き絶え絶えの亮のアナルに外したペニバンを挿入し強制的に勃起させると小さいながらもペニスを騎乗位で挿入する。\nお兄さんのペニス小さすぎて全然気持ちよくない。女の子一人気持ちよくできないお兄さんはやっぱり劣等女児の身分がお似合いだよね。笑う。\n亮は綾香の中で絶頂するが精液すら出ない空イキでしかできずそのまま綾香はペニスを抜きそのまま亮の替えに顔面騎乗して舐めるよう命じ、今後も私の相手をするように命じ、亮は空イキと言う形で返事をして笑われるのだった。\n\nhttps://skeb.jp/@18tokidesuyo/works/5", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/5", "thumbnail_src": "https://si.imgix.net/b3ab2476/uploads/origins/054301b6-c122-4037-a7fc-484d15110f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effd1123dc0450932092a61664e6302f", "thumbnail_srcset": "https://si.imgix.net/b3ab2476/uploads/origins/054301b6-c122-4037-a7fc-484d15110f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effd1123dc0450932092a61664e6302f, https://si.imgix.net/b3ab2476/uploads/origins/054301b6-c122-4037-a7fc-484d15110f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0fcc22b7be279ccac640a57fbcbb8bb 2x, https://si.imgix.net/b3ab2476/uploads/origins/054301b6-c122-4037-a7fc-484d15110f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=505e65d8bb887c2068e2235b30560436 3x", "genre": "art", "nsfw": true, "body": "リクエストお願いします。\n\nこの世界は男＝女＝ふたなり＞短小男子\nで短小男子は劣等女児と言われ男でなく女児扱いされ服も女児服や女児ぱんつしか着ることができない法律がある。\n小学入学前からおちんちんチェックと言われえるのが年1回ありそこで5㎝未満の男子が対象となり、１年の間劣等女児として過ごさなければならない。\n\nキャラ\n兄　小学5年　3㎝の劣等女児　妹のおさがりを着せられている\n妹　小学3年　8㎝のふたなり\n妹の友達A　小学3年　女\n妹の友達B　小学3年　10㎝のふたなり\n\n身長は友達B＞妹＞兄＝友達A\n\n内容\n銭湯に来た兄と妹、兄は劣等女児のため妹と共に女湯に入らなければならない。\nすると妹の友達AとBが偶然おり、妹いたっけと不思議がられる。\nスカートをまくり上げさせ女児ぱんつにつつまれた短小おちんちんを見せさせ劣等女児の兄だと紹介する。\n全員全裸になり改めて小ささを笑われ友達Aには小学1年の弟がおりその子はちゃんと男湯に行っていると言う。\nその後洗い場では友達Aは妹のちんちんを洗い、兄は友達Bのちんちんを洗わされた。\nそのまま友達Aと兄は四つん這いで横に並び友達Aは妹にまんこを兄は友達Bにアナルを犯される。\n犯される兄の顔をかわいいと思った友達Aは妹に犯されながら兄にキスをして二人はキスしながら射精され二人そろって絶頂。\nその後おちんちんをお掃除フェラ。\nお風呂に入り脱衣所に戻ると友達Aが兄を妹と友達Bから離して二人きりになると最初来た時に穿いていたぱんつを渡してはくように言う。\nふたなりでない本当の女の子が少し前まではいていたぱんつをはいてしまいドキドキし粗末ながらの勃起をする兄。\n兄にはふたなりである妹のぱんつより私のぱんつのほうが似合っていると言い、さらに兄に今度そのぱんつをはいたまま私の家に遊びに来てください、その時は私のお古の服を着てペニバンで激しく愛してあげますからと耳打ちし兄はそのことを想像して友達Aのぱんつの中に粗末射精しながらうなずくのだった。", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/4", "thumbnail_src": "https://si.imgix.net/6c68dd36/uploads/origins/9fdb45ee-1eb8-4e38-81a2-47e68bd9f856?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=618ccd5bee7f11cffa0f5e2907f8bfd4", "thumbnail_srcset": "https://si.imgix.net/6c68dd36/uploads/origins/9fdb45ee-1eb8-4e38-81a2-47e68bd9f856?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=618ccd5bee7f11cffa0f5e2907f8bfd4, https://si.imgix.net/6c68dd36/uploads/origins/9fdb45ee-1eb8-4e38-81a2-47e68bd9f856?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bd2213a181ed648eaad612b7f686db3 2x, https://si.imgix.net/6c68dd36/uploads/origins/9fdb45ee-1eb8-4e38-81a2-47e68bd9f856?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=faad618ab245d4216ee3e6ab9c8afbef 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしいイラストをありがとうございました。\n今回も前回と同じ設定で、前回書いていただいた3人目のお姉さんの陰毛を薄く変更したキャラクターのイラストをお願いします。\n描いていただきたいのは、前回の3人目のお姉さんが、新製品のバイブのテスターとして、一日中監視（撮影記録）されながら仕事をしていて、前回のイラストの様に大人の余裕な雰囲気で平然としながらも、どんどん感じていってしまう様子を描いていただきたいです。\nまた、情報収集の為、特別に絶頂時は宣言しないとならないという設定でお願いします。\nバイブは太くて長い、膣内を隙間なく埋めるくらいの物でお願いします（イメージ: https://www.pixiv.net/artworks/30268233）\n服装も少し変えていただきたくて、スカートを超ミニタイトスカートにしていただきたくて、バイブinパンツが股下からギリギリ見えるか、見えないかくらいでお願いします。\n描いていただきたいのは\n・始業、既に振動しているバイブを仕込んでいる状態で、撮影係（男）と「今日はよろしくお願いします」等挨拶と会話している途中に、振動を強くされ感じてしまい、徐々に愛液でパンツを濡らしてしまう感じでお願いします（前回イラストの様に会話している感じでお願いします）\n・新人に仕事を教えている最中、だんだん感じて、限界に近づくお姉さんをお願いします。徐々に隠せないくらい愛液が垂れてきて、新人の子に「イキそうならトイレに行った方が...」等言われるが、テスターの為、隠れて絶頂することができず、我慢を強いられている感じで、それでも笑顔のまま「大丈夫よ」と余裕を見せている感じでお願いします。\n・部屋の移動中、階段の下から撮影係がローアングルでスカートの中を撮影している感じの視点で、余裕がないのかお尻をモジモジさせながら階段を上がるお姉さんをお願いします。一段一段上がるごとに愛液が滴り落ちる感じで、それでもできるだけ平然としている感じで、お願いします。\n・部屋の前に着いたら立ち止まり「すいません、一度イキますね」と言いながら腰クネし、絶頂するお姉さんをお願いします。我慢していた分、盛大に潮吹きもしているが顔や表情は堪えている感じだと嬉しいです。\n\n以上になります。\n長いですがどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/3", "thumbnail_src": "https://si.imgix.net/d3dfca11/uploads/origins/2da47a9a-d0d1-446a-9ed6-9101fefbf7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=119d41062e9cb9a81b4433e634823a80", "thumbnail_srcset": "https://si.imgix.net/d3dfca11/uploads/origins/2da47a9a-d0d1-446a-9ed6-9101fefbf7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=119d41062e9cb9a81b4433e634823a80, https://si.imgix.net/d3dfca11/uploads/origins/2da47a9a-d0d1-446a-9ed6-9101fefbf7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53df29c3a0661d094def2e46b0b50a51 2x, https://si.imgix.net/d3dfca11/uploads/origins/2da47a9a-d0d1-446a-9ed6-9101fefbf7ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d37fa38316ea08e2d00b84e9d1d9c3cd 3x", "genre": "art", "nsfw": true, "body": "トイレでみんなの性処理フェラチオ係になっている貧乳ロリふたなりちゃんをお願いしたいです。\n\nふたなりちんぽをしごきながらフェラジェスチャーで誘ってフェラしてるシチュ", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/2", "thumbnail_src": "https://si.imgix.net/9b6d2acb/uploads/origins/9fb56b80-4d5e-4bdf-bd17-6d26065c3338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65936f48e291f05bec3852967b26544f", "thumbnail_srcset": "https://si.imgix.net/9b6d2acb/uploads/origins/9fb56b80-4d5e-4bdf-bd17-6d26065c3338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65936f48e291f05bec3852967b26544f, https://si.imgix.net/9b6d2acb/uploads/origins/9fb56b80-4d5e-4bdf-bd17-6d26065c3338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a42cf64a77abf0d648b29302608164ef 2x, https://si.imgix.net/9b6d2acb/uploads/origins/9fb56b80-4d5e-4bdf-bd17-6d26065c3338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=276fb4788898d5cc56f9a07eb4eec510 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエストさせていただきます。\n30歳前後の大人のお姉さんが、バイブinパンツorローター状態で働いているイラストをお願いします。\n設定としては、アダルトグッツ製作会社で女性社員は、自社製品をテストしながら通常業務に当たらなければならないルールがある会社で、そのルールの為、入社してくる女性はある程度性的快感に耐性がある人が多く、おもちゃを入れていること自体は恥ずかしくないが、人前で喘ぎ声をあげる、感じているのを表に出す、絶頂しているのを知られる等は恥ずかしいという設定でお願いします。\n描いていただきたいのは\nキャラクターの服装は基本スーツで、平然としているのにスカートの中は愛液で濡れてたり、垂れてたりするといった内容のイラストをかけるだけ描いて頂きたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@18tokidesuyo/works/1", "thumbnail_src": "https://si.imgix.net/36ba8d73/uploads/origins/3db4833d-bff8-48c3-a85e-0e1efad71483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f516fd9f3e50b222dd0c6edba1105e7a", "thumbnail_srcset": "https://si.imgix.net/36ba8d73/uploads/origins/3db4833d-bff8-48c3-a85e-0e1efad71483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f516fd9f3e50b222dd0c6edba1105e7a, https://si.imgix.net/36ba8d73/uploads/origins/3db4833d-bff8-48c3-a85e-0e1efad71483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a320c958f7557b77cbf616e39e328bf 2x, https://si.imgix.net/36ba8d73/uploads/origins/3db4833d-bff8-48c3-a85e-0e1efad71483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63c1b5f6214568f66de52f9506b9f116 3x", "genre": "art", "nsfw": true, "body": "優勝したくて自らライバルに交渉しちゃう女の子のイラストがとても素敵で依頼させていただきます。\n\nロングヘア貧乳（もはや壁）デカ乳輪腋毛陰毛ふたなりちゃんが銭湯の男湯に行き\nこんな壁乳女だからバレてないバレてないと緊張しながら勃起している状況\n\n結局みんなにじっと見られて脇を上げ腋毛を見せつけるようなポーズ\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}]}