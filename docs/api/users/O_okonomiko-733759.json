ad0-d636fcd7bbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=924851cc1aa051497a9ba70cbb1174ac 2x, https://si.imgix.net/51e6cc62/uploads/origins/7cf6ad75-959a-458f-8ad0-d636fcd7bbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=154ded6891749f9e3e87ba14c4a69b30 3x", "genre": "art", "nsfw": false, "body": "こんにちは！少し前に依頼したのですが、また戻ってきたくなりました。この2人のキャラクターで大丈夫だといいのですが！\n\nhttps://drive.google.com/file/d/1mIc_paSXnnJfLDSwsSjNOCpqIPgXLCuK/view?usp=drivesdk - アルダです。彼女は人間に変装した不死鳥で、田舎町で普通の生活を送ろうとしています。\n\nhttps://drive.google.com/file/d/1ltisBg-thH229nr3jKfmSo6fsj4ZjC7Z/view?usp=drivesdk - ゲーム「Fields of Mistria」のカルダロスです。彼はアルダを攻撃から救うために人間の姿になったドラゴンで、まだ人間に慣れていない。(彼は全身の参照を持っていないので、即興で作ってください-ごめんなさい)。\n\nこの2人はとても仲がいい。アルダはカルダロスが自分の世話をしているかどうか、よくチェックする。一方、カルダロスは彼女の世話を楽しみつつも、無理しすぎないように彼女を引き止める。とても仲の良いカップルだ。\n\nアートの詳細はお任せします。ありがとう！\n\nhttps://drive.google.com/file/d/1mIc_paSXnnJfLDSwsSjNOCpqIPgXLCuK/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/135", "thumbnail_src": "https://si.imgix.net/e20225cd/uploads/origins/e83349a7-12b6-4ca9-abd2-1b6407f7950c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7f97a048582aa121bf613b7a642577", "thumbnail_srcset": "https://si.imgix.net/e20225cd/uploads/origins/e83349a7-12b6-4ca9-abd2-1b6407f7950c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7f97a048582aa121bf613b7a642577, https://si.imgix.net/e20225cd/uploads/origins/e83349a7-12b6-4ca9-abd2-1b6407f7950c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1c3bf25de8463c76d89b9263250258f 2x, https://si.imgix.net/e20225cd/uploads/origins/e83349a7-12b6-4ca9-abd2-1b6407f7950c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6a22ba7d645fa944303a0f885ec793e 3x", "genre": "art", "nsfw": false, "body": "僕の友達のキャラクターを描いてもらいたいんだ。彼の名前は「2」（ツー）です。\n\n- 彼は医者です。彼はとても頭がいいです。\n- 彼は疲れているように見えると思います。\n- 彼は尖ったエルフの耳を持っている。紫色の目。灰色。\n- とてもフォーマルな服を着ている！\n- お医者さんの道具か、優しい笑顔で描いてください。\n- 好きな服を選ぶか、似たような服を作ってください。\n\nhttps://drive.google.com/file/d/1y79anpFOVZyz6oyCcdi8h7peLd1olnPn/view?usp=sharing\n\nhttps://drive.google.com/file/d/1y79anpFOVZyz6oyCcdi8h7peLd1olnPn/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/134", "thumbnail_src": "https://si.imgix.net/50278a0c/uploads/origins/4c7a485d-a04f-4916-b567-d27a419067aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7be3ae38a8ba05d026bf9ebe800307fd", "thumbnail_srcset": "https://si.imgix.net/50278a0c/uploads/origins/4c7a485d-a04f-4916-b567-d27a419067aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7be3ae38a8ba05d026bf9ebe800307fd, https://si.imgix.net/50278a0c/uploads/origins/4c7a485d-a04f-4916-b567-d27a419067aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8753ee4ca3b6a631197d3508ab8051fb 2x, https://si.imgix.net/50278a0c/uploads/origins/4c7a485d-a04f-4916-b567-d27a419067aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b88fd99334eede52859a018440ff5753 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターを描いてもらうために戻ってきました。\n\n最近の冒険の中で、彼らは仮装パーティーに行って、たくさんのトラブルに巻き込まれた。\n\ntwosday-ウサギのマスク、古風なドレス、とても平らな胸！\n\nカルメン - ウサギのお面、メイド服。\n\nポージングはあなた次第です！\n\nhttps://drive.google.com/drive/folders/1BVVdgXA4MWFMXzqS3KFTePxZPbLlOwgj?usp=sharing\n\nhttps://drive.google.com/drive/folders/1BVVdgXA4MWFMXzqS3KFTePxZPbLlOwgj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/133", "thumbnail_src": "https://si.imgix.net/407114b8/uploads/origins/781e2bc1-eca4-4fe9-a892-793852783463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e224050e54cdf30b677e7b5c7d880cad", "thumbnail_srcset": "https://si.imgix.net/407114b8/uploads/origins/781e2bc1-eca4-4fe9-a892-793852783463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e224050e54cdf30b677e7b5c7d880cad, https://si.imgix.net/407114b8/uploads/origins/781e2bc1-eca4-4fe9-a892-793852783463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd3c4ed574775d273697afb62e127408 2x, https://si.imgix.net/407114b8/uploads/origins/781e2bc1-eca4-4fe9-a892-793852783463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56c2a3bffb8f9ed5765ec917e05f95f8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、おこのみこさん！\n\n私のオリジナルキャラクター、メイちゃんの写真をお願いします。リファレンスにある緑の髪の子です。彼女のクラスタイプはシーフ/アサシンのスタイルで、ダガーを二刀流で使うので、それも含めていただけるとありがたいです。\n\nポーズや構図はお任せしますが、全体的に子供っぽくて遊び心があります。ご検討のほどよろしくお願いします！\n\n参考：https://drive.google.com/drive/folders/1umaqheYYAgHcP1JhXSveRoQI-UXPgqHL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/132", "thumbnail_src": "https://si.imgix.net/238f5b5b/uploads/origins/ad3c7b23-0758-4c79-a6b0-e9ebb0f21a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a011041e801790f3d23ba40b52a1d41b", "thumbnail_srcset": "https://si.imgix.net/238f5b5b/uploads/origins/ad3c7b23-0758-4c79-a6b0-e9ebb0f21a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a011041e801790f3d23ba40b52a1d41b, https://si.imgix.net/238f5b5b/uploads/origins/ad3c7b23-0758-4c79-a6b0-e9ebb0f21a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c64de19454992c48777839a1818bc6e 2x, https://si.imgix.net/238f5b5b/uploads/origins/ad3c7b23-0758-4c79-a6b0-e9ebb0f21a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abe69bbec2c2dc002c6aa8abce824316 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターを描いてほしいです。\n\n彼はとても幸せで、サーカスでパフォーマンスするのが好きなんだ。\n\n彼はトリックやフリップをするのが大好き。\n\nデザインは自由に修正してください。\n\nhttps://drive.google.com/drive/folders/1YbkXXnZNDn-GrUHa2yS9tes2T-M7X7mi?usp=sharing\n\nhttps://drive.google.com/drive/folders/1YbkXXnZNDn-GrUHa2yS9tes2T-M7X7mi?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/131", "thumbnail_src": "https://si.imgix.net/f6f75aa6/uploads/origins/23171abe-8dd7-4db1-b487-c782ac88be69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add8a9f0afefa8f586440fa2b209af58", "thumbnail_srcset": "https://si.imgix.net/f6f75aa6/uploads/origins/23171abe-8dd7-4db1-b487-c782ac88be69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add8a9f0afefa8f586440fa2b209af58, https://si.imgix.net/f6f75aa6/uploads/origins/23171abe-8dd7-4db1-b487-c782ac88be69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af9d1e7c76df3ccb8befc83f406f4609 2x, https://si.imgix.net/f6f75aa6/uploads/origins/23171abe-8dd7-4db1-b487-c782ac88be69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0876210819d6a1b5b9b3d660f1650c16 3x", "genre": "art", "nsfw": false, "body": "こんにちは！風船を持ったかわいいピエロのOCを描いてください。デザインはお任せします。\n\nhttps://drive.google.com/drive/folders/1U6vSe_pyR9nJxMVAuGegnjBXs1qST_yi?usp=sharing\n\nhttps://drive.google.com/drive/folders/1U6vSe_pyR9nJxMVAuGegnjBXs1qST_yi?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/130", "thumbnail_src": "https://si.imgix.net/2f4a0a7c/uploads/origins/609e9d72-5d12-4741-bac9-3a7f75b37be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4fa1b6046a6c920beacfa83175ba85", "thumbnail_srcset": "https://si.imgix.net/2f4a0a7c/uploads/origins/609e9d72-5d12-4741-bac9-3a7f75b37be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4fa1b6046a6c920beacfa83175ba85, https://si.imgix.net/2f4a0a7c/uploads/origins/609e9d72-5d12-4741-bac9-3a7f75b37be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d4db84d41ff25cc4cb36ed727b67619 2x, https://si.imgix.net/2f4a0a7c/uploads/origins/609e9d72-5d12-4741-bac9-3a7f75b37be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e08067ff736433636ee1136ca9af034 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のオリジナルキャラクターを描いてほしいのです。できれば、ぬいぐるみ（ウサギ、クマ、ネコ）と一緒に、まるで生きているかのように描いていただけませんか？ぬいぐるみと遊んでいるような感じでお願いします。顔に花のシールを貼ってください。手にはかわいいカッターナイフを持たせてください。( https://drive.google.com/file/d/1iiIrL2Ip2YJAa-qwdXoxMw7bUXHIVbji/view?usp=sharing )某ホラーゲームのキャラクターです。ぬいぐるみとカッターナイフで身を守っています！\n\n幸せそうな表情でお願いします。かわいいイメージでお願いします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1U6vSe_pyR9nJxMVAuGegnjBXs1qST_yi?usp=sharing\nhttps://drive.google.com/file/d/1iiIrL2Ip2YJAa-qwdXoxMw7bUXHIVbji/view?usp=sharing\n\nhttps://drive.google.com/drive/folders/1U6vSe_pyR9nJxMVAuGegnjBXs1qST_yi?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/129", "thumbnail_src": "https://si.imgix.net/dbae1536/uploads/origins/4f74b5d6-f698-46b5-9722-a6c14e01995f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce7b81a2145f46fbc4d798b9a19949bd", "thumbnail_srcset": "https://si.imgix.net/dbae1536/uploads/origins/4f74b5d6-f698-46b5-9722-a6c14e01995f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce7b81a2145f46fbc4d798b9a19949bd, https://si.imgix.net/dbae1536/uploads/origins/4f74b5d6-f698-46b5-9722-a6c14e01995f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c079a1c6a8717e3f2ae17a386e3411d2 2x, https://si.imgix.net/dbae1536/uploads/origins/4f74b5d6-f698-46b5-9722-a6c14e01995f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1beecfd91bff581e13ba7b962dcc520d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/128", "thumbnail_src": "https://si.imgix.net/007805bc/uploads/origins/53e2f4f6-57f7-4b9b-b8fc-23f5547cb10c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fb7708c5e54c1848e206bc8afb65aa", "thumbnail_srcset": "https://si.imgix.net/007805bc/uploads/origins/53e2f4f6-57f7-4b9b-b8fc-23f5547cb10c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fb7708c5e54c1848e206bc8afb65aa, https://si.imgix.net/007805bc/uploads/origins/53e2f4f6-57f7-4b9b-b8fc-23f5547cb10c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8aea148835f11564e5d831d7a239b7ee 2x, https://si.imgix.net/007805bc/uploads/origins/53e2f4f6-57f7-4b9b-b8fc-23f5547cb10c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06b3c1a43b33b7a80959550a39cdd851 3x", "genre": "art", "nsfw": false, "body": "できれば、柔術海戦の真仁の画像を描いてほしいです。満面の笑みでもなんでも好きなように描いてください。\n\nこれはアイコンやタンブラーのテーマとしてSNSで使わせてもらいます！\n\nhttps://drive.google.com/drive/folders/1eory8qy0koc9wKR7SGf2G_t_DAgAMSyw?usp=sharing\n\nhttps://drive.google.com/drive/folders/1eory8qy0koc9wKR7SGf2G_t_DAgAMSyw?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/127", "thumbnail_src": "https://si.imgix.net/4db55536/uploads/origins/3b7dbbee-1980-4a67-a94c-531b01f0b751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da5946e8dc87f96775b1aeb538f5b08", "thumbnail_srcset": "https://si.imgix.net/4db55536/uploads/origins/3b7dbbee-1980-4a67-a94c-531b01f0b751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da5946e8dc87f96775b1aeb538f5b08, https://si.imgix.net/4db55536/uploads/origins/3b7dbbee-1980-4a67-a94c-531b01f0b751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39758eab9610184cbcde264b6cadae64 2x, https://si.imgix.net/4db55536/uploads/origins/3b7dbbee-1980-4a67-a94c-531b01f0b751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28b49bf030a2db770901ca7e341d9067 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！私です！あなたのアートを応援するのが大好きです。\n\n友達にプレゼントしたいので、代わりにお願いします。\n\n前と同じ女の子（顔にシール）と男の子をくっつけて描いてください。彼女は彼にとって家族のような姉・母のような存在で、お互いをとても大切に思っています！\n\n幸せそうな家族写真でお願いします。カメラに向かって微笑んでいてもいいですし、彼女の髪留めをつけているようなおどけた写真でもいいです。\n\n男の子 - 勉強熱心で、優しくて、ちょっとオタク。\n\n女性 - エネルギッシュで、興奮しやすいが、人に見られると緊張する。\n\nhttps://drive.google.com/drive/folders/1lUCosVSVOmIqaUmOcoKoAy4ZUD4nvCAg?usp=sharing\n\nhttps://drive.google.com/drive/folders/1lUCosVSVOmIqaUmOcoKoAy4ZUD4nvCAg?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/126", "thumbnail_src": "https://si.imgix.net/e78d3280/uploads/origins/571942a5-f953-4347-a0a4-9fa3b2c1e242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11aa775d5db61c2724d8ad801ef374c7", "thumbnail_srcset": "https://si.imgix.net/e78d3280/uploads/origins/571942a5-f953-4347-a0a4-9fa3b2c1e242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11aa775d5db61c2724d8ad801ef374c7, https://si.imgix.net/e78d3280/uploads/origins/571942a5-f953-4347-a0a4-9fa3b2c1e242?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4246659b23d0c2de77a499e241c91116 2x, https://si.imgix.net/e78d3280/uploads/origins/571942a5-f953-4347-a0a4-9fa3b2c1e242?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c56b16e6da18361779be6cb31d98d802 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/125", "thumbnail_src": "https://si.imgix.net/73e5049a/uploads/origins/c94f4a65-296f-4154-8e77-cc2296fa4c14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7d34a6c2c83ff0fc457b91446b0cd3", "thumbnail_srcset": "https://si.imgix.net/73e5049a/uploads/origins/c94f4a65-296f-4154-8e77-cc2296fa4c14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7d34a6c2c83ff0fc457b91446b0cd3, https://si.imgix.net/73e5049a/uploads/origins/c94f4a65-296f-4154-8e77-cc2296fa4c14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61c22043249868a1990651a77f15348b 2x, https://si.imgix.net/73e5049a/uploads/origins/c94f4a65-296f-4154-8e77-cc2296fa4c14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d822a2113e206af134131a5b541b37 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私の2人のOC、アーディーとシュウのアートをお願いしたいです。\n\nアーディー：https://drive.google.com/file/d/1XgXPxZQlxJGIwo9VWvvh_iuWjMlMHxe5/view?usp=drivesdk\n\nシュウ：https://drive.google.com/file/d/1Xcsa_aSY9GHV-iPE9V5pUVVA_0Tk9bfd/view?usp=drivesdk\n\nこの2人はパートナーで、お互いに心地よくなるのが好きなんだ。お互いに休んでリラックスしているところを見たいですね。アーディーは明るく、シュウはのんびりしている。その他はお任せします。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/124", "thumbnail_src": "https://si.imgix.net/2114b119/uploads/origins/5786571e-5fea-4f98-9d83-0e91e1e6d585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2353ca9bead49ab8d456e9001b0b3b5", "thumbnail_srcset": "https://si.imgix.net/2114b119/uploads/origins/5786571e-5fea-4f98-9d83-0e91e1e6d585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2353ca9bead49ab8d456e9001b0b3b5, https://si.imgix.net/2114b119/uploads/origins/5786571e-5fea-4f98-9d83-0e91e1e6d585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee1c7a3fa03e87598e4917d0df5876c5 2x, https://si.imgix.net/2114b119/uploads/origins/5786571e-5fea-4f98-9d83-0e91e1e6d585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8e20b935c70ba1b347d6949db2124c0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お元気ですか？\n\n今回のイラストは、「カルメン」と「トーズデイ」を描いてください。\n\nカルメンがトーズデイのスカーフを持っているところを描いてください。カルメンはトーズデイのスカーフを持っています。トーズデイはピエロで、パフォーマンスでスカーフを使います。ここに添付します。( https://drive.google.com/drive/folders/1W7vYLalbdfeb0kFWPcjfLMLm_GZ_p-KH?usp=sharing )\n\nTwosday』が恥ずかしがっているように見せてください。カルメンを困った顔にしてください。その他は自由にしてください。足りなければ送り返してください。\n\n素敵な一日を！\n\nカルメン - https://drive.google.com/drive/folders/1XqAEGrvHqQlmBg1cso5OTn-q4wTLdsVJ?usp=sharing\n\nトーズデイ - https://drive.google.com/drive/folders/1aWlVoGRIlhIw_K7h4qBqu-RPA8DiiAyN?usp=sharing\n\nhttps://drive.google.com/drive/folders/1W7vYLalbdfeb0kFWPcjfLMLm_GZ_p-KH?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/123", "thumbnail_src": "https://si.imgix.net/9319c7a3/uploads/origins/1bbfa427-c4d0-44fe-93bc-1d0511c7d491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=250b3a481274dc2573491d7d238f8461", "thumbnail_srcset": "https://si.imgix.net/9319c7a3/uploads/origins/1bbfa427-c4d0-44fe-93bc-1d0511c7d491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=250b3a481274dc2573491d7d238f8461, https://si.imgix.net/9319c7a3/uploads/origins/1bbfa427-c4d0-44fe-93bc-1d0511c7d491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f87266e7d6b93972708589ee8f1f9ce4 2x, https://si.imgix.net/9319c7a3/uploads/origins/1bbfa427-c4d0-44fe-93bc-1d0511c7d491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4211c9ae4566f29fc9468636eaaff715 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またまたお邪魔します！前回に引き続き、カルメン、トーズデイのイラストをお願いします。あなたの描き方が大好きです。ファイル内のリファレンスを更新しました。\n\nお泊り会のところを描いてください。カルメンがすやすや眠っているところを描いてください。トーズデーは布団の中から覗きこもうとしたり、手を見たりしているところを描いてください（怪我をしていますが、それを見せる必要はありません）。二人が隣り合っているところを描いてください。\n\nトゥースデイは眠そうで疲れているように見えるはずです。彼らは友達です。好きなパジャマを着て描いてください！前回のように妖精を描いてもかわいいです。\n\n今回も本当にありがとうございました！\n\nCarmen - https://drive.google.com/drive/folders/1XqAEGrvHqQlmBg1cso5OTn-q4wTLdsVJ?usp=sharing 可愛いパジャマを着てくれそうです。\n\nTwosday - https://drive.google.com/drive/folders/1aWlVoGRIlhIw_K7h4qBqu-RPA8DiiAyN?usp=sharing 明るいパジャマを着るだろう。", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/122", "thumbnail_src": "https://si.imgix.net/61131fe1/uploads/origins/0a1b59ef-ddc8-445a-9c0e-d637ae60262c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba5e3b707240360f19a28033efd8b857", "thumbnail_srcset": "https://si.imgix.net/61131fe1/uploads/origins/0a1b59ef-ddc8-445a-9c0e-d637ae60262c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba5e3b707240360f19a28033efd8b857, https://si.imgix.net/61131fe1/uploads/origins/0a1b59ef-ddc8-445a-9c0e-d637ae60262c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2495cae099513830de9dbcf0eab30df0 2x, https://si.imgix.net/61131fe1/uploads/origins/0a1b59ef-ddc8-445a-9c0e-d637ae60262c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=611c7eacbeb8a0c1efab40726720773b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵はとてもかわいいです！私のキャラクター、ウィノナの絵をお願いしたいです！\n\nウィノナは22歳、身長152cm。エンターテイメント・メディアについてエッセイを書くのが好きで、実際よりも皮肉屋に見えるストイックでオタクなインテリ。普段は無表情で、顔をしかめてぶっきらぼうに話す。しかし、好きなことをしたり、興味のあることを話したりして興奮すると、笑顔を見せ、とても饒舌になり、エネルギッシュで表情豊かになる。オレンジ色やオレンジ風味のものには執着心がある。髪が長く、頬にほくろがあり、肌が黒い。カナダのトロントに住んでいる。\n\nジャケットを着た彼女を描いてください。ポーズや構図はお任せします。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16jkykuYrrr8HaFkp4JuqhFqvfFWGJIzQ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/121", "thumbnail_src": "https://si.imgix.net/6e1769e5/uploads/origins/e7a9a7fe-d13f-4b32-8109-4182bee451af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac658c237018d8f5188da537aa0138b7", "thumbnail_srcset": "https://si.imgix.net/6e1769e5/uploads/origins/e7a9a7fe-d13f-4b32-8109-4182bee451af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac658c237018d8f5188da537aa0138b7, https://si.imgix.net/6e1769e5/uploads/origins/e7a9a7fe-d13f-4b32-8109-4182bee451af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ba907a3e11eb687782f86b225e4ebf2 2x, https://si.imgix.net/6e1769e5/uploads/origins/e7a9a7fe-d13f-4b32-8109-4182bee451af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5878adfa878015402e43e4a2a25e9159 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕の友達のキャラクターを描いてほしいんだ。名前はカルメンです。\n\nよろしくお願いします：彼女の目は真っ黒です。頭の光輪は外せません。黒い肌。髪はドレッドヘア。\n\nそれ以外は変更できます。彼女は楽しくて幸せな性格です。自然と鳥が大好き！カジュアルなポーズがいいです。紫と紫のメイクが好き。彼女はエルフなので、耳が尖っています。\n\nどんなポーズでも自由にしてください。彼女は笑顔が大好きです。いつも応援してくれてありがとう。あなたの絵がとても大好きです！https://drive.google.com/drive/folders/1XqAEGrvHqQlmBg1cso5OTn-q4wTLdsVJ?usp=sharing。\n\nhttps://drive.google.com/drive/folders/1XqAEGrvHqQlmBg1cso5OTn-q4wTLdsVJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/120", "thumbnail_src": "https://si.imgix.net/f8fa38fe/uploads/origins/5dafff72-bc31-4267-ac41-cc8b12c366e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b895655320e0bcffb171e82d6717422", "thumbnail_srcset": "https://si.imgix.net/f8fa38fe/uploads/origins/5dafff72-bc31-4267-ac41-cc8b12c366e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b895655320e0bcffb171e82d6717422, https://si.imgix.net/f8fa38fe/uploads/origins/5dafff72-bc31-4267-ac41-cc8b12c366e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13d32e0a10c122f50f68ac8524102d58 2x, https://si.imgix.net/f8fa38fe/uploads/origins/5dafff72-bc31-4267-ac41-cc8b12c366e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a537790e4f566130f33289aa30ef87b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のキャラクター「火曜日」を描いてほしいんだ。彼はダンジョンズ＆ドラゴンズの「ドロー」なので、紫色の肌と赤い目をしています。彼はサーカスのパフォーマーで、似合わない明るい服を着ている。悪趣味なファッションが好き。自信家で、少々自信過剰なため、トラブルに巻き込まれることもある。嫉妬深いが善意があり、可能な限り助けようとする。\n\n女性らしく、女性のように見せてください。彼の肌の色、目の色、明るい服が好きなところはそのままに、好きなようにデザインを変えてください。\n\n彼は人前でパフォーマンスするのが大好きです。彼の写真、または添付の写真からピエロのメイクを追加してください。自分なりのアレンジを加えても構いません。\n\n彼は妖精と縁があります。彼が妖精に手を伸ばしたらかわいいだろうね。また、花やサーカスの芸もかなり好きです。\n\nいつもありがとうございます！ https://drive.google.com/drive/folders/1aWlVoGRIlhIw_K7h4qBqu-RPA8DiiAyN?usp=sharing\n\nhttps://drive.google.com/drive/folders/1aWlVoGRIlhIw_K7h4qBqu-RPA8DiiAyN?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/119", "thumbnail_src": "https://si.imgix.net/885ec4e7/uploads/origins/324dabf3-eb4e-4262-aa9f-8a26ddb108d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=412458086269ae478535db73b27a4945", "thumbnail_srcset": "https://si.imgix.net/885ec4e7/uploads/origins/324dabf3-eb4e-4262-aa9f-8a26ddb108d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=412458086269ae478535db73b27a4945, https://si.imgix.net/885ec4e7/uploads/origins/324dabf3-eb4e-4262-aa9f-8a26ddb108d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e2f065af9fc25ccdea465e4259eb26e 2x, https://si.imgix.net/885ec4e7/uploads/origins/324dabf3-eb4e-4262-aa9f-8a26ddb108d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da0e038ceefed7ef89c18cb7a60bd49b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_okonomiko/works/118", "thumbnail_src": "https://si.imgix.net/36c052c4/uploads/origins/b82c79fe-ee01-4cd7-91e1-e27b18c18bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed1a4bb49f64dac67672a87ccf47ec09", "thumbnail_srcset": "https://si.imgix.net/36c052c4/uploads/origi