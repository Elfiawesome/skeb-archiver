Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c2dfd5f1c8e03200ed1bcb20c936ff5 2x, https://si.imgix.net/bddfc7d8/uploads/origins/501fba50-fee3-4305-bc4e-6cb28eb56f51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36051e5866024a608d1634296143b230 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/399", "thumbnail_src": "https://si.imgix.net/df6ec2fc/uploads/origins/03a0746d-4ba3-4280-8889-88db8c34adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=400834ee769fa24c600e2273b29a2c35", "thumbnail_srcset": "https://si.imgix.net/df6ec2fc/uploads/origins/03a0746d-4ba3-4280-8889-88db8c34adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=400834ee769fa24c600e2273b29a2c35, https://si.imgix.net/df6ec2fc/uploads/origins/03a0746d-4ba3-4280-8889-88db8c34adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40a54fae28e9992533e9a9d4d0fc0c4e 2x, https://si.imgix.net/df6ec2fc/uploads/origins/03a0746d-4ba3-4280-8889-88db8c34adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b83383e037f271ab08a47b0ec50d5b8c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Hideさん。友人と私は、FFXIVのキャラクター、SumiとCelesのアートをお願いしたいと思っています。スミはビエラの死神で、セレスはビエラの黒魔道士です。私たちは、鷲見が決意を固めて獰猛に鎌を振りかざそうとしているアクションポーズ（できれば鎌の刃の一部が見えるような形で）と、セレスが片手で杖を前方に突き出して呪文を唱えているポーズを希望していました。背景は特に考えていないので、かっこよく見えれば何でもいいです。ありがとうございました！\n\n参考文献：https://drive.google.com/drive/folders/1XAN1g8nHTHft5CaWeJg2t6EH28LC4xiL", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/398", "thumbnail_src": "https://si.imgix.net/238693aa/uploads/origins/8b0fdc6d-3b75-4d44-a4a8-db19974dca49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8429cb43526310d835740a7ff17dd879", "thumbnail_srcset": "https://si.imgix.net/238693aa/uploads/origins/8b0fdc6d-3b75-4d44-a4a8-db19974dca49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8429cb43526310d835740a7ff17dd879, https://si.imgix.net/238693aa/uploads/origins/8b0fdc6d-3b75-4d44-a4a8-db19974dca49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75b87d0fe658b0499ae7aa748aac9b60 2x, https://si.imgix.net/238693aa/uploads/origins/8b0fdc6d-3b75-4d44-a4a8-db19974dca49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f08307caf838a10ba7510e6c4c3e421b 3x", "genre": "art", "nsfw": false, "body": "やあ！\n\n僕のキャラクター、おくにの写真を探していたんだ。彼女はコソコソするのが好きで、ヘビのような性質を持っている、ほとんど伝統的なローグタイプなんだ。鎧を着せてみたいんだ。ちょっと威圧的なオーラを漂わせながら、楽しそうに見えるようにしたいんだ！\n\nどんな鎧にするかはいくつか選択肢があるので、一番インスピレーションが湧くものを描いてほしいし、その中から組み合わせてもいい！\n\nhttps://imgur.com/a/okuni-references-wVQx6hR", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/397", "thumbnail_src": "https://si.imgix.net/ee82a52e/uploads/origins/01044921-08d2-4fc6-8844-ad2f3ce867ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f70e46b68a054ce71ddcb15e6d658ed3", "thumbnail_srcset": "https://si.imgix.net/ee82a52e/uploads/origins/01044921-08d2-4fc6-8844-ad2f3ce867ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f70e46b68a054ce71ddcb15e6d658ed3, https://si.imgix.net/ee82a52e/uploads/origins/01044921-08d2-4fc6-8844-ad2f3ce867ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca1144fd29c1a3c95f650dec7544adb 2x, https://si.imgix.net/ee82a52e/uploads/origins/01044921-08d2-4fc6-8844-ad2f3ce867ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=595fceaae9d5b428046f91f95995c55e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Hideさん、私はとても長い間あなたのFFXIVアートワークのファンでした！私のAu Ra、Yazzel FreshをArcadionの装備で描いてほしいというリクエストを受け入れてくれると嬉しいです。\n\nできれば全身でお願いします。ポーズや表情、武器を描くかどうかはお任せします。\n\nヤゼルは物静かだけど自信家で生意気なタイプで、自分の体を見せるのは嬉しいけど、わざと魅惑的な感じはしない。参考資料の中に、彼女がよく見せる表情を写したスクリーンショットがある。コートがもっと開いているか、胸のジッパーが下がっているのが彼女らしい。\n\n参考文献：https://drive.google.com/drive/folders/1fcR3tsEbrnOg1H1S0-rjF9H6_oy557Rc", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/396", "thumbnail_src": "https://si.imgix.net/f94a5d9a/uploads/origins/5fb6dc66-7c70-4ad9-b04f-22392e9c0da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f77fa4ad0b51f6492c7483fa3ec31133", "thumbnail_srcset": "https://si.imgix.net/f94a5d9a/uploads/origins/5fb6dc66-7c70-4ad9-b04f-22392e9c0da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f77fa4ad0b51f6492c7483fa3ec31133, https://si.imgix.net/f94a5d9a/uploads/origins/5fb6dc66-7c70-4ad9-b04f-22392e9c0da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=788c7de0d620b9a76c15a471068b80c0 2x, https://si.imgix.net/f94a5d9a/uploads/origins/5fb6dc66-7c70-4ad9-b04f-22392e9c0da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed2b34ba83f819b7b70162461c7a8152 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n僕と友達のFF14のキャラクターを描いてくれませんか？\n\n以下は私たちのキャラクターの参考URLです：\nナラ：https://i.imgur.com/3JJi1Kt.jpeg\nセロ：https://i.imgur.com/xNZBZ2Y.jpeg\n\nナラとセロは、切っても切れないダイナミックなデュオです。\n- ナラは明るく、遊び好きで自信家。\n- セロはクールで狡猾で大人っぽい。\n\nバーやナイトクラブを舞台に、キャラクターたちが自信に満ちた表情で見る人の方を向いているような構図にしたい。\nナラ（友人のキャラクター）は左側に、セロ（私のキャラクター）は右側に、参考シートの五條と同じような表情やポーズをしています。\n\nその他はすべてお任せします！\n\nスマホの壁紙にしたいので、縦構図にしていただけませんか？\nスマホの壁紙として使いたいので、縦長の構図にしていただけませんか？\n\n提出量が足りない場合は、再送をお願いします。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1FMSHoieXkg3Af8s1xkNp2ZIIUP9HtI4C?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/395", "thumbnail_src": "https://si.imgix.net/69e7c5f5/uploads/origins/d25136a0-1cde-49c9-8bea-5417b1510557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae746e3c40d07dd71f822322b58a676f", "thumbnail_srcset": "https://si.imgix.net/69e7c5f5/uploads/origins/d25136a0-1cde-49c9-8bea-5417b1510557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae746e3c40d07dd71f822322b58a676f, https://si.imgix.net/69e7c5f5/uploads/origins/d25136a0-1cde-49c9-8bea-5417b1510557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53aad089d190008d8ce4e9e04ac388fd 2x, https://si.imgix.net/69e7c5f5/uploads/origins/d25136a0-1cde-49c9-8bea-5417b1510557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9cd8b0c5d2e1fab743566d1975ffdeb 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！前回、FFオーラのキャラクター、カシアの作品を作っていただいて嬉しかったので、今回も私のキャラクターとパートナーのヴィエラ、アンブラの作品をお願いしたいと思います！この絵は冒険の装備をしていて、新しい冒険に出発するというテーマでお願いしたいです。カッシアは少し先を急いでいて、アンブラはそのスピードに驚いてついていこうとしている。どちらも興奮していて、幸せそうだ。\n\nCassia (Au Ra): https://drive.google.com/drive/folders/1f4S77ntBL2YkRcDqiRv4WjoA1RgP6lUy?usp=sharing - 髪型はどちらでもご自由に。\n\nアンブラ（ヴィエラ）: https://drive.google.com/drive/folders/1tbXMIk-rjOg73OREf2mCob4zzBgmE73M 髪型は長いほうでお願いします。あと、インナーの服の下の部分（写真の1枚で×印）を外してお腹を露出させてもらえると最高です。", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/394", "thumbnail_src": "https://si.imgix.net/a04d8d68/uploads/origins/aa2e9d93-c2e7-4d62-8536-a5d551635c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4a8bac0fb514b1b2d3cec4ccb070ae6", "thumbnail_srcset": "https://si.imgix.net/a04d8d68/uploads/origins/aa2e9d93-c2e7-4d62-8536-a5d551635c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4a8bac0fb514b1b2d3cec4ccb070ae6, https://si.imgix.net/a04d8d68/uploads/origins/aa2e9d93-c2e7-4d62-8536-a5d551635c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d452311748639b1b94aa28498711625 2x, https://si.imgix.net/a04d8d68/uploads/origins/aa2e9d93-c2e7-4d62-8536-a5d551635c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46a12795f9e7d866656fecb2e90aa122 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/393", "thumbnail_src": "https://si.imgix.net/08c64487/uploads/origins/4ef743fa-db90-4069-a6b3-0fe059f259b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2026638d8fec028328764ab5a6439cb0", "thumbnail_srcset": "https://si.imgix.net/08c64487/uploads/origins/4ef743fa-db90-4069-a6b3-0fe059f259b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2026638d8fec028328764ab5a6439cb0, https://si.imgix.net/08c64487/uploads/origins/4ef743fa-db90-4069-a6b3-0fe059f259b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91446dec824a0306ae264d8ce92eae75 2x, https://si.imgix.net/08c64487/uploads/origins/4ef743fa-db90-4069-a6b3-0fe059f259b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4aea39a1e2db90a4a728c55a8d8e95a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n16:9のゲームのローディング画面風の画像が欲しいのですが、どんなポーズや設定でも構いません。\n\n\nどんなポーズや設定でも構いません。\n\nメン・ポーはいつも眠い。\n\n発明家はいつもチームの怠慢や間抜けなアイデアに腹を立てている。\n\nキャプテンは、素晴らしいアイデアを思いついたとき、目の上にX字型の金色の星をつける。\n\nデザインは以下の通り。\n\nhttps://drive.google.com/drive/folders/1VyfjLn8Wsuj0XM5HycL_m2dwg2AWUPFn?usp=sharing\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/392", "thumbnail_src": "https://si.imgix.net/e59b815e/uploads/origins/8ca824e0-87e1-466c-a20e-7c1ea6083cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adb3a86548bb81f71e145fc0ad567347", "thumbnail_srcset": "https://si.imgix.net/e59b815e/uploads/origins/8ca824e0-87e1-466c-a20e-7c1ea6083cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adb3a86548bb81f71e145fc0ad567347, https://si.imgix.net/e59b815e/uploads/origins/8ca824e0-87e1-466c-a20e-7c1ea6083cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc700c3e516ca86e288797c965fd9bb5 2x, https://si.imgix.net/e59b815e/uploads/origins/8ca824e0-87e1-466c-a20e-7c1ea6083cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90ee7d858121d0609ea115e9a2126b21 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nテンポの良いアクションシーンを描いてもらいたいオリジナルキャラクターが2人います。夕暮れ時の伝統的な寺院の中庭を舞台に、2人が戦いのスリルを楽しんでいるようなシーンが希望です。環境設定とキャラクターの外見の参考アイデアを提供しました（参考資料に従って、キャラクターのアクセサリーをすべて含めてください）。\nまた、16×9の横長キャンバスに完成させていただければ、額装をお願いしたいです。\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/10IfdKdDf2DMGWzPOg0q8VblCRqgFkqIA", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/391", "thumbnail_src": "https://si.imgix.net/707c1a15/uploads/origins/097d7501-da49-4422-91b9-1abc8f333c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36964b3fdbffc4337e1d1133ec4fa66d", "thumbnail_srcset": "https://si.imgix.net/707c1a15/uploads/origins/097d7501-da49-4422-91b9-1abc8f333c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36964b3fdbffc4337e1d1133ec4fa66d, https://si.imgix.net/707c1a15/uploads/origins/097d7501-da49-4422-91b9-1abc8f333c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac4c4408f85ff9d234ff9ba0ef462771 2x, https://si.imgix.net/707c1a15/uploads/origins/097d7501-da49-4422-91b9-1abc8f333c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=241d4a10d4804be5397859585b25f6ab 3x", "genre": "art", "nsfw": false, "body": "こんにちは、FFXIVのOCのファイティングポーズのアートワークを依頼するのがとても楽しみです。\n\n私のキャラクターの名前はR'ahki Tiaで、若くてフレンドリーなmiqo'teの僧侶です。彼は素早くて機敏なファイターで、戦闘中は常に100％真剣です。彼の機敏さと集中力、そして決意を、青空の下で風のエフェクトを交えて表現したアートワークを希望します。タトゥーはオプションで、ズボンの太ももの窓を、提供された参考資料のようにヒップまで届くように大きくしてほしい。\n\n本当にありがとうございました！\n参考：https://drive.google.com/drive/folders/17As1TmSVtT52yiWuKdOrujzy7RcBRSje?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Hideout/works/390", "thumbnail_src": "https://si.imgix.net/f5213148/uploads/origins/77fb74f2-0eaa-4b6e-8677-eec97769fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ee912c602eeae73b8748eb6a525859", "thumbnail_srcset": "https://si.imgix.net/f5213148/uploads/origins/77fb74f2-0eaa-4b6e-8677-eec97769fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ee912c602eeae73b8748eb6a525859, https://si.imgix.net/f5213148/uploads/origins/77fb74f2-0eaa-4b6e-8677-eec97769fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=144f86c86643f35689e911d166c431c6 2x, https://si.imgix.net/f5213148/uploads/origins/77fb74f2-0eaa-4b6e-8677-eec97769fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1114f342d4bfc8ad0c828daed91c6f01 3x", "genre": "art", "nsfw": false, "body": "HIDEさんこんにちは、いつも素敵なイラスト拝見しております。\n他の方々と同じく、FF14の自キャラを描いていただきたくリクエスト致します。\n\n\n構図やポーズはお任せいたしますが、戦闘中でのシーンであると嬉しいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/156jdwKShViAAG-IOolbnM_hJ-XlsLo0C?usp=sharing", "created_at": "", "completed_at": ""}]}