49a9-abc2-fad6a74ea785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18ecbf05d676aa3e6bdfc75751a70018 2x, https://si.imgix.net/3b0e26a1/uploads/origins/3745c38a-423f-49a9-abc2-fad6a74ea785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2fac0c6da7f9053f9f58d9ffbbf2469 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生のおねショタイラストや同人誌に前から関心がありました。この度初めてリクエストをお送りいたします。\n\n【キャラクター】\nブルーアーカイブの美甘ネルとオリジナルショタ先生によるインピオを依頼致します\n\n【ショタ】\nデザインはオリジナルで女の子のような小柄、華奢、肌が綺麗で純真そうな容姿をした美少年\n\n【構図】\n・お互い舌を出して絡ませ合うディープキス\n・二人とも全裸でシックスナインの体勢でお互いの性器をフェラ（口内射精）、クンニ\n・二人とも全裸で向かい合って抱き合い中出しセックス\n・ネルのお腹が大きくなった妊娠後もお願いいただけますか。\n以上でご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nakayoshi_obgyn/works/23", "thumbnail_src": "https://si.imgix.net/8a5e24e5/uploads/origins/f8599366-29aa-47b5-9b15-f8189784d397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d2c51c9f0213c12cdf584f0d557b1bd", "thumbnail_srcset": "https://si.imgix.net/8a5e24e5/uploads/origins/f8599366-29aa-47b5-9b15-f8189784d397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d2c51c9f0213c12cdf584f0d557b1bd, https://si.imgix.net/8a5e24e5/uploads/origins/f8599366-29aa-47b5-9b15-f8189784d397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9c8c87efa9a44281a7ffb363acc452c 2x, https://si.imgix.net/8a5e24e5/uploads/origins/f8599366-29aa-47b5-9b15-f8189784d397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ade621590e25b32b5d63ec1d82417a4 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、前回の僕ヤバの依頼では大変お世話になりました。\n\n今回は、ガンダムビルドファイターズを題材に、主人公のイオリ・セイと美星とのオネエショタコンビのシナリオをお願いしたいと思います。\n\n原作では、美星はイオリに好意的なオネエサンを装っているが、ガンプラアイドルとしてのキャリアを積むため、密かにイオリを妨害しようとしている。彼女の本当の性格は、自己中心的で策略家だ。エピソードの最後で彼女は敗北し、教訓を学び、再登場するキャラクターとなる。\n\n私の予想では、彼女はこのエピソードの最中か後に純粋に彼を好きになり、2人は交際を始め、その結果彼女は妊娠した、というシナリオだ。漫画は、彼女がすでに妊娠8カ月か9カ月というところから始まる。彼女はエッチな一面を持つ自信家のオネエサンを演じている。聖はそんな彼女に振り回されることになる。\n\nあらすじはこうだ：\n\n最初のページでは、パートナーとして一緒に優勝した大会を後にする2人の姿が描かれ、美星は彼の助力を称える。伊織は付き合い始めたきっかけを説明し、彼女がアイドル活動を休止している間にガンプラバトラーとして大きく成長したことを伝える。\n\n美星は報酬を約束し、2人は伊織の母が経営する店に戻る。伊織の母、伊織凛子も妊娠していた。伊織のナレーションによれば、彼女は美星のすぐ後に妊娠し、嫉妬からもう一人子供を欲しがったのだという。伊織のナレーションによれば、彼は最近、知り合いの女の子がたくさん妊娠していることに気づいたという。\n\n倫子は2人きりにすると言い、彼の部屋でセックスをすることになる。詳しいことは彼女に任せるが、美星が服を脱ぎ始めると、彼は部分的に服を着たセックスをしてほしいと言う。セックスの後、美星は2人には長い付き合いをしてほしい、彼と仕事をするのが楽しみだと言う。\n\nミホシ\nhttps://imgur.com/a/3KBpOU0\n\nイオリ・リン子\nhttps://imgur.com/a/hULy3Na\n伊織は、息子に恋人ができたことを熱望する明るい母親として描かれている。\n\nできれば、他の妊娠中のビルドファイターズガールもカメオ出演してほしい。大会会場を後にする最初のコマに登場させるか、伊織が他の妊娠した女の子たちのことを考えている間に登場させるか。\n\nhttps://imgur.com/a/leH3oWG", "created_at": "", "completed_at": ""}, {"path": "/@nakayoshi_obgyn/works/22", "thumbnail_src": "https://si.imgix.net/a6b8e690/uploads/origins/78d468b3-508e-4ed3-911e-ced1de147a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13081cf30f8d323a31765d9c8b6d944b", "thumbnail_srcset": "https://si.imgix.net/a6b8e690/uploads/origins/78d468b3-508e-4ed3-911e-ced1de147a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13081cf30f8d323a31765d9c8b6d944b, https://si.imgix.net/a6b8e690/uploads/origins/78d468b3-508e-4ed3-911e-ced1de147a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37959b59e2285bd91d36ca93132af01f 2x, https://si.imgix.net/a6b8e690/uploads/origins/78d468b3-508e-4ed3-911e-ced1de147a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2557b5ec94b58bf7954a338035f4b3a7 3x", "genre": "art", "nsfw": true, "body": "ふたなりの錠前サオリさんが女先生を乱暴に犯しているところをお願いします。\nサオリさんは我慢しきれず女先生を身体目当てで襲ってひたすら性欲をぶつけていて、\n女先生もサオリさんの顔がいいのであまり抵抗しておらず嫌がっていない様子だととても嬉しいです。\nふたなりはあくまでサオリさんと女先生をどうしてもどろどろに爛れた肉体関係にしたいがために分かりやすい記号として設定しているに過ぎず、\nふたなりであることを強調するような構図にしていただく必要はなく、ふたなりであることが分からなくても結構です。\n女先生のキャラデザは任意で細かな指定はありませんが、件のアロナちゃんの似顔絵に引っ張られないように(ボーイッシュではなく女性っぽく)お願いしたいです。\n\nこれまで他の方にも同様のシチュを描いていただいており、\nまてつ先生に今回描いていただく作品の内容を問わず、これから他の方にも同様のシチュを描いていただく可能性がありますが、\n他の方のこれまで描いていただいた作品に満足していないということや、\nまてつ先生に今回描いていただく作品に満足しないということでは決してないということを予め明記します。\nこのような背景を隠すのは公平ではないと考えているため明記しましたが、お気に障るようでしたら蹴っていただければと思います。\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@nakayoshi_obgyn/works/21", "thumbnail_src": "https://si.imgix.net/51fb386f/uploads/origins/e9b23a34-cbd7-4649-81bc-ffeab18cbd97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cb43b4d99118fdbf8d9fb6d9892bea3", "thumbnail_srcset": "https://si.imgix.net/51fb386f/uploads/origins/e9b23a34-cbd7-4649-81bc-ffeab18cbd97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cb43b4d99118fdbf8d9fb6d9892bea3, https://si.imgix.net/51fb386f/uploads/origins/e9b23a34-cbd7-4649-81bc-ffeab18cbd97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=986532b8f8d4b159f51a46d6e5287455 2x, https://si.imgix.net/51fb386f/uploads/origins/e9b23a34-cbd7-4649-81bc-ffeab18cbd97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88882e48a6ef19223b1367de530d048d 3x", "genre": "art", "nsfw": true, "body": "あなたの絵は素晴らしい！\nまた依頼したいんだけど。\n数種類のレッサーパンダのnsfwな絵が欲しいんです。\nレッサーパンダの飼い主全員から了承を得ています。全員が銭湯にいるようなイメージでお願いします。私が探しているもののアイデアのために参考画像を提供しましたが、最終的にはほとんどお任せします。ただ1つだけお願いしたいのは、2番はタオルか何かで覆われている必要があるということです。\n\nhttps://drive.google.com/drive/folders/1oLiXDz7zt9RnaSqI9xE1hRNKyyJRgEbr", "created_at": "", "completed_at": ""}, {"path": "/@nakayoshi_obgyn/works/20", "thumbnail_src": "https://si.imgix.net/3e12ac68/uploads/origins/d8343226-86b7-4042-925e-a1aaf609d90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d385d100dadad662d97bebcea7216a", "thumbnail_srcset": "https://si.imgix.net/3e12ac68/uploads/origins/d8343226-86b7-4042-925e-a1aaf609d90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d385d100dadad662d97bebcea7216a, https://si.imgix.net/3e12ac68/uploads/origins/d8343226-86b7-4042-925e-a1aaf609d90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae4b868e52e43e0d5fc04a23ade2f6ed 2x, https://si.imgix.net/3e12ac68/uploads/origins/d8343226-86b7-4042-925e-a1aaf609d90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07c6c6c603b36d9799330f3a33af9503 3x", "genre": "art", "nsfw": true, "body": "こんにちは、山田杏奈「僕の心の闇夜」の以下のシナリオをマンガでお願いします。\n\nシナリオは、山田アナが妊娠を前提としたテレビドラマのオーディションに合格したというもの。彼女はこの役が女優としてブレイクすると信じている。彼女は主人公の市川に父親になってほしいと頼み、市川はそれを承諾して彼女とセックスし、彼女を妊娠させる。\n\n2ページ目か残りのページ（何をもってベストとするかはお任せする）は、山田が妊娠9カ月でインタビューを受け、自分の役についてどう感じているかという質問に答えるところから始まる。\n\n山田は、妊娠していることが予想以上に楽しく、妊娠中の演技を楽しんでいると答えている。番組のファースト・シーズンはほぼ終了し、撮影スタッフは最後のシーンを撮影するために彼女が陣痛を起こすのを待っていると述べている。また、マタニティ・モデルもやっているという。番組は成功し、彼女のキャラクターは人気があり、山田は必要であれば2度目の妊娠もあり得ると述べている。父親は誰かという質問に対して、山田は秘密だと答えた。\n\nパネル1：担当番組の撮影現場でインタビューを受ける山田。明るく、インタビューに興奮している様子。片手でカメラに手を振りながら、もう片方の手でお腹を押さえ、マイクに向かって話している。\n\nパネル2：演技を撮影される山田。演じているキャラクターはチャラチャラしたギャル。細かい設定はお任せします。\nコマ目と2コマ目の彼女の姿：https://imgur.com/a/x1FP7e1\n\n3コマ目：妊娠中、制服姿で友達と楽しそうに話す山田。髪は染めたまま。友達は画面外でもシルエットでもOK。\n\nパネル4：病院で患者用のガウンを着た山田のビハインドショット。山田は笑顔でカメラに向かってピースサインをしている。立っているのか、ベッドに横になっているのかはお任せします。\n\nお願いが多いのは承知していますが、できれば上記のシーンが見たいです。もし、私の要望が多すぎるようでしたら、遠慮なくお断りするか、変更をお願いします。\n\nもし、上記で構わないが、2回目の妊娠中のセックスシーンを希望されるのであれば、山田が妊娠中に市川とデートしているシーンを追加で1ページお願いします。この格好の山田さんが見たいです。\nhttps://imgur.com/a/aN2JdGC", "created_at": "", "completed_at": ""}, {"path": "/@nakayoshi_obgyn/works/19", "thumbnail_src": "https://si.imgix.net/22f7d176/uploads/origins/ad42a0b0-dd4a-46e4-8260-3c19b18ab636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdfb5b6342ee2fb3c7c174c14d952f74", "thumbnail_srcset": "https://si.imgix.net/22f7d176/uploads/origins/ad42a0b0-dd4a-46e4-8260-3c19b18ab636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdfb5b6342ee2fb3c7c174c14d9