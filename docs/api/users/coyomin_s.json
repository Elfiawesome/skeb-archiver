%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4054bd6b129079842e199fc9c57f865e 2x, https://si.imgix.net/ea2600d9/requests/89330_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b25e58e24d08215ccd341a099ae94bb 3x", "genre": "art", "nsfw": true, "body": "拙作「先輩が僕を殺(ト)りにきてる」より神宮寺澪様を描いて下さいませ。主人公山田律くんから見た日常的な風景の中に見えるちょっとセクシーなワンシーンをお願い出来ればと思います。", "created_at": "", "completed_at": ""}, {"path": "/@coyomin_s/works/3", "thumbnail_src": "https://si.imgix.net/24c8c06b/requests/75321_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d25aaeeae51cfa0a3e6b2453ad1dd8", "thumbnail_srcset": "https://si.imgix.net/24c8c06b/requests/75321_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d25aaeeae51cfa0a3e6b2453ad1dd8, https://si.imgix.net/24c8c06b/requests/75321_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d2ad839a50a8f116ad77bc305c7dae9 2x, https://si.imgix.net/24c8c06b/requests/75321_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=550c480475c3e4944c33d0ad711bf1cb 3x", "genre": "art", "nsfw": true, "body": "双星の陰陽師のキャラをお願いします。Pixivに上げておられたクロエの様に、背景ありでカッコよくポーズを決めた全身で。希望キャラは15巻登場の太陰の紅緒。他に描きたいキャラがいればそちらでも大丈夫です\n宜しければTwitter等に上げて頂けると幸いです。よろしくお願いします\n\nhttps://www.google.co.jp/search?q=%E5%A4%AA%E9%99%B0+%E7%B4%85%E7%B7%92&client=safari&hl=ja-jp&prmd=inv&sxsrf=ALeKk02CT1_drrRBTk3u_OyFpRbuXNT-Sw:1589452274868&source=lnms&tbm=isch&sa=X&ved=2ahUKEwioheyRk7PpAhUv-2EKHTm-CmkQ_AUoAXoECA4QAQ&biw=414&bih=622\n\nhttps://www.google.co.jp/search?q=%E5%A4%AA%E9%99%B0+%E7%B4%85%E7%B7%92&client=safari&hl=ja-jp&prmd=inv&sxsrf=ALeKk02CT1_drrRBTk3u_OyFpRbuXNT-Sw:1589452274868&source=lnms&tbm=isch&sa=X&ved=2ahUKEwioheyRk7PpAhUv-2EKHTm-CmkQ_AUoAXoECA4QAQ&biw=414&bih=622", "created_at": "", "completed_at": ""}, {"path": "/@coyomin_s/works/2", "thumbnail_src": "https://si.imgix.net/5ee62ffe/requests/64281_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8d45aa330f0a633c6879ee4a33ffb2e", "thumbnail_srcset": "https://si.imgix.net/5ee62ffe/requests/64281_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8d45aa330f0a633c6879ee4a33ffb2e, https://si.imgix.net/5ee62ffe/requests/64281_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5684df2a3803fa6a10b247e37f4f469 2x, https://si.imgix.net/5ee62ffe/requests/64281_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adbf69a0b094b9f5f8944b4303c47641 3x", "genre": "art", "nsfw": false, "body": "小説の表紙として、各種小説投稿サイトへの投稿するための風景イメージをリクエストします。\n\n詳細の説明とイメージは以下のリンクに載せました。\n\n世界の設定として、\n①雨は降らず草は生えません。\n②メインは黒い箱で、それを目立つように描いていただけると良いです。\n③箱のテクスチャは参考程度で、黒がメインであればある程度自由にして頂いても構いません。\n④キャンバスの配置やその他小物は自由です。キャンバス内の海が青く、黒い箱が描かれていれば問題ありません。\n⑤イメージは建造物の上を想定していますが、ここが良いという場所があれば変更していただいても構いません。\n\n以上、結構むちゃくちゃ書いてますが。都合が合えばお受けいただけると幸いです。\n\n\n今回の小説は現在執筆中につき、まだ投稿していないのですが。\n自身の作風の参考として、以前の作品の参考URLも載せておきます。\nhttps://kakuyomu.jp/users/Mister_N/works\n\nhttps://drive.google.com/file/d/1Eh4O0oVO5TVubLgoIONNlQw_H7iZvKl9/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@coyomin_s/works/1", "thumbnail_src": "https://si.imgix.net/229bc0ca/requests/57309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8fb6e8669d2eb586eee7e1fe9477bb", "thumbnail_srcset": "https://si.imgix.net/229bc0ca/requests/57309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8fb6e8669d2eb586eee7e1fe9477bb, https://si.imgix.net/229bc0ca/requests/57309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4128e5f7fd3eb5327691ab55c44101b 2x, https://si.imgix.net/229bc0ca/requests/57309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aa1e121526a7e39b46cd76dc7acff44 3x", "genre": "art", "nsfw": false, "body": "こよみんさん、はじめまして！\n「小女ラムネ」の「足立甜花」を描いてお願いしたいんです！\n\nこの絵で白いバニースーツ姿で甜花ちゃんが髪を縛って