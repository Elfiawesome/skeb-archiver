f36-4417-813f-5e22901a3c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=821b4321c46314e51fe26d1211a3027e 2x, https://si.imgix.net/f872c862/uploads/origins/08bcd7e6-7f36-4417-813f-5e22901a3c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d002e9704f263b5a8b3aa4b693b5fe7 3x", "genre": "art", "nsfw": false, "body": "もんすー様。\n初めまして。\n\nニッチな内容ですが可能でしたら、次の様なイラストをお願い出来ればと思います。\n\n南方の前線に近い簡易施設で海外艦娘と物々交換し、初めて食べる海外の糧食を「これは・・・意外といける！」と言う表情で食する磯風乙改をお願い致します。\n\nhttp://www.eonet.ne.jp/~kfir/gazo/phms/phms02.jpg\n上記のURLが糧食と食器のイメージとなります。\n\nメニューは食パン、レトルトのシチュー、コールスロー、グルーンピース、フルーツミックス、コーヒーで食している物はお任せ致します。\n\n戦場での束の間の休息を表現して頂ければ嬉しいです。\n\n以上となりますが、ご検討を頂けますと幸いです。\nどうぞ宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/14", "thumbnail_src": "https://si.imgix.net/81af3226/uploads/origins/a1d1c1b9-7795-43cf-98a5-e1879fec987d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5469124ad0876a04e4a14851c6538860", "thumbnail_srcset": "https://si.imgix.net/81af3226/uploads/origins/a1d1c1b9-7795-43cf-98a5-e1879fec987d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5469124ad0876a04e4a14851c6538860, https://si.imgix.net/81af3226/uploads/origins/a1d1c1b9-7795-43cf-98a5-e1879fec987d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e47976636da27c6272f5b8181a32462b 2x, https://si.imgix.net/81af3226/uploads/origins/a1d1c1b9-7795-43cf-98a5-e1879fec987d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a22ea33c4829947d8f6ba99c2846e10 3x", "genre": "art", "nsfw": true, "body": "もんすー先生の描かれる可愛く凛々しくそして動きのあるイラスト等、いつも楽しませていただいております。もしよろしければ、花騎士から私の推しをリクエストさせてもらえればと思います。\n\n・希望キャラクター：フォックスフェイス\n・衣装格好について：ゲーム内の進化後または開花後、どちらも選び難いのでもんすー先生の好きな方で描いていただければと思います。\n・構図やシチュエーション：セクシーなポーズをとってその豊かな体つきを見せつけアピールしているようなイラストをお願いします。具体的な構図についてはおまかせしますが全身が映るようにお願いします。\n・表情について：団長を誘惑しようとしているような表情、可能であれば差分で恥ずかしがっている表情の2パターンをお願いします。\n・その他：キャラクターの格好が元々かなり性的なのでNSFWをつけていますが、露出度や局部描写の有無についてはおまかせします。\n\nもんすー先生の絵柄で私の推し花騎士が見られればとても嬉しいです。\nSkebのキャンペーン終了間際の依頼ですみませんが、よろしければご一考の程よろしくお願いします。\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%d5%a5%a9%a5%c3%a5%af%a5%b9%a5%d5%a5%a7%a5%a4%a5%b9#", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/13", "thumbnail_src": "https://si.imgix.net/540b4f38/uploads/origins/7b37bee4-d043-4879-a5d7-c9b9a716eb9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8718b341cd31dc36b3b97f172748f963", "thumbnail_srcset": "https://si.imgix.net/540b4f38/uploads/origins/7b37bee4-d043-4879-a5d7-c9b9a716eb9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8718b341cd31dc36b3b97f172748f963, https://si.imgix.net/540b4f38/uploads/origins/7b37bee4-d043-4879-a5d7-c9b9a716eb9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b31e379b0c30e28f590ba9ef17d4b51e 2x, https://si.imgix.net/540b4f38/uploads/origins/7b37bee4-d043-4879-a5d7-c9b9a716eb9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9aadf0836eed36e3b741a4f085184f18 3x", "genre": "art", "nsfw": false, "body": "はじめまして。リクエストさせていただきます。\nよろしければご一考ください。\n\n【作品】フラワーナイトガール\n【キャラクター】ブルーロータス\n【衣装】進化前衣装\n【シチュエーション】\n表情は笑顔で、全身像もしくは膝から上が入るくらいで。\nその他の詳細はおまかせとさせてください。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%96%E3%83%AB%E3%83%BC%E3%83%AD%E3%83%BC%E3%82%BF%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/12", "thumbnail_src": "https://si.imgix.net/174eac2b/uploads/origins/0534d128-e4ec-407d-a20d-bd8a3a3f05d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f650c3d37d413c96379ebd1f8f4d637", "thumbnail_srcset": "https://si.imgix.net/174eac2b/uploads/origins/0534d128-e4ec-407d-a20d-bd8a3a3f05d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f650c3d37d413c96379ebd1f8f4d637, https://si.imgix.net/174eac2b/uploads/origins/0534d1