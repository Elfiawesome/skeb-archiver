ddle%2Ccenter&txtsize=30&txt=PRIVATE&s=b588e920e956b551c7ab91875af8e72f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/25", "thumbnail_src": "https://si.imgix.net/3bf2d64e/uploads/origins/1e666f3b-a64e-465d-a265-73bf168ffbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89ff83824ff77f87b869c42212ac09c7", "thumbnail_srcset": "https://si.imgix.net/3bf2d64e/uploads/origins/1e666f3b-a64e-465d-a265-73bf168ffbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89ff83824ff77f87b869c42212ac09c7, https://si.imgix.net/3bf2d64e/uploads/origins/1e666f3b-a64e-465d-a265-73bf168ffbab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a771d4fb838465d510f20f77eabd7f9d 2x, https://si.imgix.net/3bf2d64e/uploads/origins/1e666f3b-a64e-465d-a265-73bf168ffbab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99c28b3300cd0612bcf335283d4fc8fc 3x", "genre": "art", "nsfw": true, "body": "毎度、突然の依頼失礼します\n\n過去に依頼させて頂いたビスマルクの水着立ち絵イラスト\nhttps://skeb.jp/@monsuu/works/24\nhttps://skeb.jp/@monsuu/works/22\nに関して\n更に小物追加などでの差分の作成をお願いできますでしょうか？\n差分はレイヤーやファイル分けしてON,OFFできると助かります。\n\n★★小物系\n★全体\n・これまでにお願いした小物\n・これまでにお願いした小物(左手)をパーカー差分に合わせたもの \n(※スイミングボードとパーカーが併用できないなどが凄く惜しいので)\n+追加して欲しいものとして\n★頭\n・艤装ぽいサンバイザー(ビスマルクドライの帽子or艤装ぽいデザインのもの)\n(知らない人が見てもビスマルクと認識してもらえるようにする意図です)\n・照れ怒りの表情\n★胴体\n・首にかける指輪ネックレス\n★右手\n・ビアサーバーベルトガン(右手)\n(※左手の物が右手にも欲しくなりました)\n・右手にドライ艤装の小銃\n・右手に水鉄砲のおもちゃ\n★左手\n・パーカー、パーカー無し左手薬指に指輪差分\n\nレイヤーに関しては上半身の状態でpsdデータ自体を分けた方が見やすいかなと個人的意見です\n・水着のみ\n・前開けパーカー+水着\n・前開けパーカー+裸\n・前閉めパーカー\n・裸\nくらいに分けると良いかも？\n\nまた、\n・頭\n・胴体\n・右手\n・左手\n・艤装\nなどでレイヤー階層を分けてもいいかもしれません\n\n合わせて、描いて頂くイラストを使った個人私物用グッズ作成(アクスタなど)と 私のyoutube配信でイラストを使用させていただく可能性があります。ご許可いただければ幸いです。\n下記URL：私のyoutube配信とイラスト使用例\nhttps://www.youtube.com/@exalanceg\nhttps://twitter.com/exalanceg/status/1762840096846598549\n\nお手数をおかけしますがよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/24", "thumbnail_src": "https://si.imgix.net/4a1361fd/uploads/origins/75066107-2626-4cde-8de1-22cc6805364e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f11e0e81c72c08215e8e3f3553d8d287", "thumbnail_srcset": "https://si.imgix.net/4a1361fd/uploads/origins/75066107-2626-4cde-8de1-22cc6805364e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f11e0e81c72c08215e8e3f3553d8d287, https://si.imgix.net/4a1361fd/uploads/origins/75066107-2626-4cde-8de1-22cc6805364e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfcf8fe6cb989d1ab66e31f282001d99 2x, https://si.imgix.net/4a1361fd/uploads/origins/75066107-2626-4cde-8de1-22cc6805364e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=994b1a5d9bb64cf4842692f5e30554d4 3x", "genre": "art", "nsfw": true, "body": "毎度、突然の依頼失礼します\n\n前回の依頼させて頂いたビスマルクの水着立ち絵イラスト\nhttps://skeb.jp/@monsuu/works/22\nに関して\n小物追加などでの差分の作成をお願いできますでしょうか？差分はレイヤー分けしてON,OFFできると助かります。\n\n追加して欲しいもの\n・サンバイザー(ビーチバレーの女性選手が付けていそうな+ビス子らしいデザインのもの)\n・サングラス(頭)(ビーチバレーの女性選手が付けていそうなカッコイイデザインのもの)\n・サングラス(目)(上記と同じデザインのものを目に掛けている)\n・サングラス(目)(上記を目が見えるように半透明化)\n・ビーチボール\n・裸(上下水着をレイヤー分けして貰えると助かります)\n・パーカー(ファスナー閉じ)\n・パーカー(ファスナー開けて前開け)\n・フランクフルト(串付き)　(こだわってもらったのにすいません)\n・照れ顔表情\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/23", "thumbnail_src": "https://si.imgix.net/aa2a37a1/uploads/origins/6771f8e0-db71-46e3-b007-1789cb9ba8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94a82233536d1a628eaf8b12bb8afa15", "thumbnail_srcset": "https://si.imgix.net/aa2a37a1/uploads/origins/6771f8e0-db71-46e3-b007-1789cb9ba8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94a82233536d1a628eaf8b12bb8afa15, https://si.imgix.net/aa2a37a1/uploads/origins/6771f8e0-db71-46e3-b007-1789cb9ba8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=805c95d213e15796afb243707a16cb1b 2x, https://si.imgix.net/aa2a37a1/uploads/origins/6771f8e0-db71-46e3-b007-1789cb9ba8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=261f3771640adf7155be080c550006d9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/22", "thumbnail_src": "https://si.imgix.net/7c380a33/uploads/origins/ae75cafa-2979-4809-9ed6-17d2ee360b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bc25820d6201627cadb6efb65b47ac8", "thumbnail_srcset": "https://si.imgix.net/7c380a33/uploads/origins/ae75cafa-2979-4809-9ed6-17d2ee360b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bc25820d6201627cadb6efb65b47ac8, https://si.imgix.net/7c380a33/uploads/origins/ae75cafa-2979-4809-9ed6-17d2ee360b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9aa6c3f711ebe732515810eb5a0742d4 2x, https://si.imgix.net/7c380a33/uploads/origins/ae75cafa-2979-4809-9ed6-17d2ee360b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e95746205922b9ae7006c7d53afcd8c 3x", "genre": "art", "nsfw": false, "body": "突然の依頼失礼します\n\n艦これのビスマルクのイラストをお願いできますでしょうか？\n\nビスマルクの水着立ち絵イラストをお願いします。艤装あり、トリミング無しの全身イラストでお願いします。艦これのゲーム内水着グラとして実装されそうな感じでお願いします。詳細はお任せします。\n\n合わせて、描いて頂くイラストを使った個人私物用グッズ作成(アクスタなど)と 私のyoutube配信でイラストを使用させていただく可能性があります。ご許可いただければ幸いです。\n下記URL：私のyoutube配信とイラスト使用例\nhttps://www.youtube.com/@exalanceg\nhttps://twitter.com/exalanceg/status/1762840096846598549\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/21", "thumbnail_src": "https://si.imgix.net/7be85dd1/uploads/origins/8b57fdda-55b6-4d0d-8bd2-10a184d1ec40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa270201ac9eae5889818cfb2e321f09", "thumbnail_srcset": "https://si.imgix.net/7be85dd1/uploads/origins/8b57fdda-55b6-4d0d-8bd2-10a184d1ec40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa270201ac9eae5889818cfb2e321f09, https://si.imgix.net/7be85dd1/uploads/origins/8b57fdda-55b6-4d0d-8bd2-10a184d1ec40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31e5c6774315c50a3114ee30d292ae71 2x, https://si.imgix.net/7be85dd1/uploads/origins/8b57fdda-55b6-4d0d-8bd2-10a184d1ec40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35994025ba46d6389b427fa4a634286c 3x", "genre": "art", "nsfw": false, "body": "突然の依頼失礼します\n\n艦これのビスマルクのイラストをお願いできますでしょうか？\nもんすーさんの同人誌「陽炎13　クリスマス」の表紙の陽炎のように艤装+アレンジ衣装の立ち絵イラストをお願いします。トリミング無しの全身イラストだと嬉しいです。\nもんすーさんの服飾アレンジ好きなので、詳細はお任せします。\n\nアバウトな依頼で恐縮ですが、よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/20", "thumbnail_src": "https://si.imgix.net/63f052f3/uploads/origins/076cd2f9-f70e-4b16-835e-0853945f9000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f8fbec301eb8c93ae3c535fc9a65360", "thumbnail_srcset": "https://si.imgix.net/63f052f3/uploads/origins/076cd2f9-f70e-4b16-835e-0853945f9000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f8fbec301eb8c93ae3c535fc9a65360, https://si.imgix.net/63f052f3/uploads/origins/076cd2f9-f70e-4b16-835e-0853945f9000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb4dd98c4b2ae1ff8ed85e9bb06f1747 2x, https://si.imgix.net/63f052f3/uploads/origins/076cd2f9-f70e-4b16-835e-0853945f9000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09b965f085baf9d7e936147e1537ab37 3x", "genre": "art", "nsfw": true, "body": "もんすー先生、お久しぶりです。牛の王子さまでち＠８６ｋです。\nもしよろしければご一考いただけますと幸いです。\n\n【作品】フラワーナイトガール（花騎士）\n【キャラクター】ハツユキソウ\n参考：キャラクターの体型はこちらの方がわかりやすいと存じます\n腰まである白髪ストレートロングでやや小ぶりのおっぱいに大きめのお尻の子です\nhttps://i.imgur.com/ketEKFQ.png\n\n【衣装】\n流行りのセーター\n※正式名称は分かりませんが以下の画像の様なデザインのセーターをイメージしております\nhttps://x.com/_yudu_twt/status/1741399799197544790?s=20\nhttps://x.com/AlmonDrake/status/1741040810857279902?s=20\nhttps://x.com/YoGr6w/status/1740016535983583307?s=20\n\n【シチュエーション】\n団長さん(主人公です、描写不要です)に流行りのセーターを着て見せにきたイラストを描いてください、お願いします。\n表情は恥ずかしがっていると嬉しいです。\n可能であればドヤ顔等いくつかの表情差分をいただけますと大変嬉しいです。\n（可能な限りで結構です。）\n\n※肌面積が広い衣装のため念のためNSFWをONにしておきましたが直接的な描写は不要です。\n\n以上が私の要望でございますが、難しいようであれば先生の御自由にアレンジしていただいても構いません。\n\nよろしければで結構ですので、お受けいただければ幸いです。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "created_at": "", "completed_at": ""}, {"path": "/@monsuu/works/19", "thumbnail_src": "https://si.imgix.net/2037b372/uploads/origins/7fcc27fc-6568-450a-8714-3c20134ab0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=892c311d1e408541850a912563782e55", "thumbnail_srcset": "https://si.imgix.net/2037b372/uploads/origins/7fcc27fc-6568-450a-8714-3c20134ab0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=892c311d1e408541850a912563782e55, https://si.imgix.net/2037b372/uploads/origins/7fcc27fc-6568-450a-8714-3c20134ab0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4525887c30eebbc67406f451f602ac2a 2x, https://si.imgix.net/2037b372/uploads/origins/7fcc27fc-6568-450a-8714-3c20134ab0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txts