ted_at": ""}, {"path": "/@SG_rough/works/28", "thumbnail_src": "https://si.imgix.net/c641cd6e/uploads/origins/e3f378b5-9f5b-4c4f-8fef-2cb915762016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c601d25243177e264667238b8ca5e79", "thumbnail_srcset": "https://si.imgix.net/c641cd6e/uploads/origins/e3f378b5-9f5b-4c4f-8fef-2cb915762016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c601d25243177e264667238b8ca5e79, https://si.imgix.net/c641cd6e/uploads/origins/e3f378b5-9f5b-4c4f-8fef-2cb915762016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3518d13aa06eda9d64bd4e2953b7c236 2x, https://si.imgix.net/c641cd6e/uploads/origins/e3f378b5-9f5b-4c4f-8fef-2cb915762016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ab39f648cf1ad194121d33cef730db1 3x", "genre": "art", "nsfw": false, "body": "ウマ娘から結婚後のライトハロー新婚YES枕見せシチュ\n寝間着姿（可愛い系なふわふわパジャマでもセクシー系なランジェリーでも何でも、デザインはお任せ）でお腹辺りに「YES」がプリントされた枕を持ち、ちょっと恥じらい顔でこちらに見せてきている\n差分で表情笑顔で枕の裏返しの方を見せてくる、でもYES/NO枕では無くて裏に書かれてる言葉は「OK」\n\nというものをよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@SG_rough/works/27", "thumbnail_src": "https://si.imgix.net/e9c9a2c2/uploads/origins/6a714197-a697-4f9a-85d8-8e62608c0645?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f2e2de1a0e1f6f2c64e7a5a6e07e45", "thumbnail_srcset": "https://si.imgix.net/e9c9a2c2/uploads/origins/6a714197-a697-4f9a-85d8-8e62608c0645?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f2e2de1a0e1f6f2c64e7a5a6e07e45, https://si.imgix.net/e9c9a2c2/uploads/origins/6a714197-a697-4f9a-85d8-8e62608c0645?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9716775845d9a0d5c7c5896abfe6249 2x, https://si.imgix.net/e9c9a2c2/uploads/origins/6a714197-a697-4f9a-85d8-8e62608c0645?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cef55c26725e6ccfdb6d3f3b3f62aa6c 3x", "genre"