b18f43af8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7bf4fa85b354d71827987b7e70d486c", "thumbnail_srcset": "https://si.imgix.net/be6f8e56/uploads/origins/6b394bc9-5b56-47db-a82a-9cb18f43af8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7bf4fa85b354d71827987b7e70d486c, https://si.imgix.net/be6f8e56/uploads/origins/6b394bc9-5b56-47db-a82a-9cb18f43af8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ef46ea71a14ecbbe720f658fe132155 2x, https://si.imgix.net/be6f8e56/uploads/origins/6b394bc9-5b56-47db-a82a-9cb18f43af8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c82ca6a014fa8cffe66c787f0501c23 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。ぽいとんです！\nまた個人勢の蒼咲ユウリさんを描いて欲しくてリクエストもってまいりました！\nシュチュエーションは温泉！\n背景は紅葉した山とか秋っぽい感じに(構図的に見えなくても可。秋っぽい雰囲気があると嬉しい程度にお考えください。)\n温泉の縁から少し身を乗り出す感じで。\nお酒飲んで少しポヤポヤしてるような表情だと嬉しいです！\n露出度等ははりこみぃ様にお任せいたします。\nお忙しいと思いますがよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@oukkmn_h/works/88", "thumbnail_src": "https://si.imgix.net/fc21c0d3/uploads/origins/14ecd971-a16c-411c-81ec-78aaecb1b038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915995b1b9c0622711ab15729e6d7448", "thumbnail_srcset": "https://si.imgix.net/fc21c0d3/uploads/origins/14ecd971-a16c-411c-81ec-78aaecb1b038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915995b1b9c0622711ab15729e6d7448, https://si.imgix.net/fc21c0d3/uploads/origins/14ecd971-a16c-411c-81ec-78aaecb1b038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cd17f9c180de93f15f1f1eabd714ef5 2x, https://si.imgix.net/fc21c0d3/uploads/origins/14ecd971-a16c-411c-81ec-78aaecb1b038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=daa886453bece43e55f75ab3e42451fd 3x", "genre": "art", "nsfw": false, "body": "はりこみ様初めまして。先日のにじ甲の聖アザラシイメージソングでイラストを拝見させて頂きました。\nとても素敵なイラストありがとうございます。\n\n依頼内容としましては、五十嵐梨花さんと小清水透さんのCP絵を依頼したいです。\n\nシチュエーションは真夏の海で元気いっぱいな五十嵐さんと暑さにやられてる小清水さん、みたいなイメージでお願いしたいです。\n\nできれば水着姿だと好ましいですが、この辺りはお任せします。\n\nお忙しいとは思いますがよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@oukkmn_h/works/87", "thumbnail_src": "https://si.imgix.net/7f2332f1/uploads/origins/b6f3449b-59fd-4740-90f7-811471a59b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd564dd1373099b673c4bedf21e5fb02", "thumbnail_srcset": "https://si.imgix.net/7f2332f1/uploads/origins/b6f3449b-59fd-4740-90f7-811471a59b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd564dd1373099b673c4bedf21e5fb02, https://si.imgix.net/7f2332f1/uploads/origins/b6f3449b-59fd-4740-90f7-811471a59b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd43695e9b652bdc615e11a37e9800b4 2x, https://si.imgix.net/7f2332f1/uploads/origins/b6f3449b-59fd-4740-90f7-811471a59b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de1228f65c0c74045bd5d274198f4a35 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oukkmn_h/works/86", "thumbnail_src": "https://si.imgix.net/2452782c/uploads/origins/de63eefe-110c-497f-8051-eba7eac45685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d7ac34f4ed9ab95bb56b53c7238d21", "thumbnail_srcset": "https://si.imgix.net/2452782c/uploads/origins/de63eefe-110c-497f-8051-eba7eac45685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d7ac34f4ed9ab95bb56b53c7238d21, https://si.imgix.net/2452782c/uploads/origi