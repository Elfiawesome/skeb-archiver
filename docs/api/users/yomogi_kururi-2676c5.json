57adf9f3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04489519d5eed547ff15fffa02058aef", "thumbnail_srcset": "https://si.imgix.net/8ba00120/uploads/origins/0e4abf1f-5132-4fb4-9328-bb57adf9f3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04489519d5eed547ff15fffa02058aef, https://si.imgix.net/8ba00120/uploads/origins/0e4abf1f-5132-4fb4-9328-bb57adf9f3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b776189462c7ab26d69c7a0eb7109e1 2x, https://si.imgix.net/8ba00120/uploads/origins/0e4abf1f-5132-4fb4-9328-bb57adf9f3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ce5508becd6c31e4d0eba20ba01c76d 3x", "genre": "art", "nsfw": false, "body": "初めまして、角森ぽぴぽと申します。\n実はこっそり配信楽しませていただいておりましていつか機会があれば依頼させていただきたいと思っていた次第です。\n今回リクエストを送ることが出来てとても嬉しいです！\n\n以下応募内容となります。\n○使用用途\n主に観賞用、配信にも使うかもしれません\n○描いていただきたいイメージ\nロケーション…パステルカラーな部屋\nシチュエーション…鏡の前でお化粧を楽しんでいる場面\n人物…私の使用しているアバター(資料URLに記載)\n衣装はおまかせで大丈夫です\n〇サイズ\n1920×1080の横長タイプが嬉しいです\nよもぎさんの描くもふもふふわふわしっぽが見れる画角だとさらに嬉しいです\n\nご検討のほどよろしくお願いいたします\n\nhttps://x.com/popipo_t/status/1852204394932220316", "created_at": "", "completed_at": ""}, {"path": "/@yomogi_kururi/works/9", "thumbnail_src": "https://si.imgix.net/9a9b996b/uploads/origins/829696bb-a9cd-4e6c-bf94-2c74d7630dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=200cc51cb303ae9dcae3a1127602f0e6", "thumbnail_srcset": "https://si.imgix.net/9a9b996b/uploads/origins/829696bb-a9cd-4e6c-bf94-2c74d7630dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=200cc51cb303ae9dcae3a1127602f0e6, https://si.imgix.net/9a9b996b/uploads/origins/829696bb-a9cd-4e6c-bf94-2c74d7630dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebd79e471eb17eaa3300d66a56eeb7b1 2x, https://si.imgix.net/9a9b996b/uploads/origins/829696bb-a9cd-4e6c-bf94-2c74d7630dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f35fc15b460d2acba0d26afa60087e57 3x", "genre": "art", "nsfw": false, "body": "はじめまして。いつも素敵なイラスト拝見しております。\n\n私が普段SNSで使用している、おさげ髪と赤いリボン、赤い目が特徴のオリジナルキャラクターを描いて頂けますでしょうか。\nテーマとしては秋っぽい感じでお願いしたいです。キャラクターの細かい部分やその他の点についてはおまかせいたします。かわいい感じにして頂けますと幸いです。\n使用用途としては私のSNSアカウントのプロフィール画像として使用させて頂きたい他に、私的利用として壁紙やSkebの印刷してお届け機能を使用させて頂きたいです。\n\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/7KbV8fHBbLVxve697", "created_at": "", "completed_at": ""}, {"path": "/@yomogi_kururi/works/8", "thumbnail_src": "https://si.imgix.net/be7203b8/uploads/origins/7af95ff1-e883-4884-88a1-6a9b2c48e047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96ae69e9bd4a5080f6767a84fa7569f8", "thumbnail_srcset": "https://si.imgix.net/be7203b8/uploads/origins/7af95ff1-e883-4884-88a1-6a9b2c48e047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96ae69e9bd4a5080f6767a84fa7569f8, https://si.imgix.net/be7203b8/uploads/origins/7af95ff1-e883-4884-88a1-6a9b2c48e047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a09f6315f0f38d9c36cd4c4d73b22f3d 2x, https://si.imgix.net/be7203b8/uploads/origins/7af95ff1-e883-4884-88a1-6a9b2c48e047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20b96cec7e0f45f25703495c0d2ca918 3x", "genre": "art", "nsfw": false, "body": "くるり先生、こんにちは。あなたの作品を拝見し、特にその雰囲気とキャラクターと背景の組み合わせ方がとても気に入りました。先生の作風がとても好きです。私のOCのイラストをお願いしたいのですが、可能でしょうか？\n\nポーズや背景の指定は特にありませんので、自由に創作してください。唯一の希望は、絵の全体的な雰囲気がリラックスした夢のあるものになることと、キャラクターが大きすぎず小さすぎず、あなたの例と同じくらいの大きさになることです。\n\nこのイラストは個人的に携帯やパソコンの壁紙としてのみ使用する予定です。よろしくお願いいたします。\n\nありがとうございました！\n\nhttps://sta.sh/018a738yk51y", "created_at": "", "completed_at": ""}, {"path": "/@yomogi_kururi/works/7", "thumbnail_src": "https://si.imgix.net/72139831/uploads/origins/7dea3c57-1dd1-4b0b-82b1-04848aa7db59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89a0ed59a44576d7faa1b8f69d785b26", "thumbnail_srcset": "https://si.imgix.net/72139831/uploa