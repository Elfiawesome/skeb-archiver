-9fb0-f7e687a78d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b0c435c4136d43bc46c71590efc3588", "thumbnail_srcset": "https://si.imgix.net/36cda834/uploads/origins/358541a9-e87a-46b5-9fb0-f7e687a78d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b0c435c4136d43bc46c71590efc3588, https://si.imgix.net/36cda834/uploads/origins/358541a9-e87a-46b5-9fb0-f7e687a78d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5594a9fded21db9910b60376f896569d 2x, https://si.imgix.net/36cda834/uploads/origins/358541a9-e87a-46b5-9fb0-f7e687a78d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2de3672e5c78a7a61d803c3033447e62 3x", "genre": "art", "nsfw": true, "body": "はじめまして、素敵な絵柄に惹かれたのでリクエストを送らせていただきます。\n描いて頂きたいのはうちの子です。\nhttps://x.com/YMFygsl/status/1762855889244225625\n\n・服装はジャケットとニーソのみで、ベッドに仰向けで寝そべっている状態。\n・無表情orジト目でこちらを見ていて赤面はしていない。\n・枕元にコンドームの箱が置いてある。\n\nその他の要素はお任せします。\n以上の条件で良ければお受けして頂けると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/65", "thumbnail_src": "https://si.imgix.net/52c893a0/uploads/origins/485688da-737f-4448-8a3b-d8e5c1286805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2aed32b05791ec26a5abce80ce946c9", "thumbnail_srcset": "https://si.imgix.net/52c893a0/uploads/origins/485688da-737f-4448-8a3b-d8e5c1286805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2aed32b05791ec26a5abce80ce946c9, https://si.imgix.net/52c893a0/uploads/origins/485688da-737f-4448-8a3b-d8e5c1286805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=923023e948f5233cceef755fae87a77c 2x, https://si.imgix.net/52c893a0/uploads/origins/485688da-737f-4448-8a3b-d8e5c1286805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d5e49ba0e029ee1165d946e6d35c39d 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです\n前回素敵なイラストをありがとうございます\n今回もうちの子（VRChatアバター）のえっちなイラストをお願いしたいです\n\n参考資料内には複数の服装がありますが、詳細な指定はありません\n服装のアレンジや、資料以外の服装も大歓迎です\n構図や背景等はおまかせします、自由に描いていただけたら嬉しいです\n\nご検討よろしくお願いします！\n\nhttps://to.yan-k.tv/Yan-KMishe", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/64", "thumbnail_src": "https://si.imgix.net/be634353/uploads/origins/2dc3dd1a-fb2e-4dc3-9c7d-ce4d082a344d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78729a5494d35b8c943ccd1ece178b4", "thumbnail_srcset": "https://si.imgix.net/be634353/uploads/origins/2dc3dd1a-fb2e-4dc3-9c7d-ce4d082a344d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78729a5494d35b8c943ccd1ece178b4, https://si.imgix.net/be634353/uploads/origins/2dc3dd1a-fb2e-4dc3-9c7d-ce4d082a344d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4713b1bf1e47fc9e6c9d1e998a8c10ee 2x, https://si.imgix.net/be634353/uploads/origins/2dc3dd1a-fb2e-4dc3-9c7d-ce4d082a344d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e122fc98c96f28be8c904d0269be7b79 3x", "genre": "art", "nsfw": true, "body": "かんどりさん、はじめまして。描かれているイラストの数々素晴らしいですね。\n募集の再開お待ちしていました。初リクになりますが、是非宜しくお願い致します。\n\n◎希望のキャラ・シチュ\n望月聖（アイドルマスターシンデレラガールズ）がハイエースで拉致され、私服姿のままレイプされ処女を奪われる、というシチュを希望します。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/129?h=3940722a298289d255af65f4bbabbc62\n\n◎シチュ詳細\n希望の体位は正常位で構図等詳細はお任せしますが、聖の全身、特に顔、胸、局部（結合部分）がしっかり見えるような構図を希望します。\n\nリンクのワンピース私服を着用している状態での行為で。\n・ワンピースの上着部分は肩からずり下げられ聖の大きな胸が見えている状態（ブラも一緒に下側にずり下げられている）。\n※聖はJCですがB82設定なのでそれなりの大きさでお願いします\n・ワンピースのスカート部分はめくれていて、パンツはどちらかの足に引っかかっている表現で（下着の色は白で）。\n・首に掛けている麦わら帽子は聖の傍らに置かれている描写でお願いしたいです。\n\n涙目の表現は号泣している感じ、涙が頬を伝っている表現でお願いします。\n口はガムテープで塞がれていて、ガムテープはオンオフできるようお願いします（手の縛りはNGで）。\n背景は車内での行為が分かる感じで。\n竿役は雰囲気程度、身体と男性器が表現されている程度で。\n擬音や台詞など音の表現はお任せします。\n消しは黒線（横棒）でお願いします。\n\n複数のシーン（差分）をお願いしたいのですが\n①挿入の直前（聖は怯えていて目に涙を浮かべている表情で）\n②挿入の瞬間（両目を開けて号泣、処女喪失・破瓜の表現も必須で）\n③激しく挿入\n④中出しの瞬間（目を閉じて号泣、③と比べて男性器がより深く挿入されている）\n⑤事後の状態（ぐったりした様子で、男性器が引き抜かれ女性器からは精液と破瓜の証がドローンと垂れている）\nシーンごとに顔の表情や結合部分を変えて頂けると嬉しいです。\n\nかんどりさんの描く最高のワンピース私服聖で堪能させて下さい。ご検討の程宜しくお願い致します！\n\nhttps://imas.gamedbs.jp/cg/media/image_sp/cartoon/932/1f49d4141b4b7a637b90bb38e7053774.jpg", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/63", "thumbnail_src": "https://si.imgix.net/5b04a662/uploads/origins/33c1c108-7276-4d2e-a182-92f5ba621497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dd3697c8dd4c2f5fa52ee3c807f66f0", "thumbnail_srcset": "https://si.imgix.net/5b04a662/uploads/origins/33c1c108-7276-4d2e-a182-92f5ba621497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dd3697c8dd4c2f5fa52ee3c807f66f0, https://si.imgix.net/5b04a662/uploads/origins/33c1c108-7276-4d2e-a182-92f5ba621497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4764e0a813a1b9e05a157276b42e87eb 2x, https://si.imgix.net/5b04a662/uploads/origins/33c1c108-7276-4d2e-a182-92f5ba621497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60952ae2b48b8d0ded3c89242a7686ef 3x", "genre": "art", "nsfw": true, "body": "大変お久しぶりです、以前G11をお願いしていた者です。\n作品が忘れられず、再開される日を待っておりました。\nまた良ければリクエストしたいですが、少しキャラに変更があります。\n可能であればドールズフロントライン2の「Mechty(G11)」でお願いします。\n全身が見える参考 : https://www.youtube.com/watch?v=oGP6iDaXVVY&t=189s\n上記参考動画の3:00以降を参考に全裸でお願いします。\n口調や雰囲気(11:20など) : https://www.youtube.com/watch?v=0TeggHe-tl8\n一人称が「あたし」で胸は控えめで少し小柄な子で、下は無毛でお願いします。\n※前作ドールズフロントラインでG11という名前で登場し、続編2で再登場しMechty(ミシュティ)に改名されましたが同一人物です。\nG11からの大きな変更点としてロングヘアからショートヘアになり、後ろに小さくポニーテールがあります。\nG11参考 : https://wikiwiki.jp/dolls-fl/Gr%20G11 \n簡単な喘ぎセリフと擬音の有りと無しが欲しいです。\n\n手繋ぎのM字騎乗位かM字正常位をお願いしたいです。\n愛液の糸引きなどがまたあると嬉しいです。\nとても汗だくで、とても紅潮し困り眉で涙流してイク寸前なくらい激しく感じた表情でお願いします。\nピストンと中出しで、いくつかの表情パターンがまた見てみたいです。\n\n良ければご検討下さい。", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/62", "thumbnail_src": "https://si.imgix.net/3248ea4e/uploads/origins/76dd7f0a-3e27-4efb-9072-9474fef4c564?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a75f5cd3b5e83c7216b23964b14967a", "thumbnail_srcset": "https://si.imgix.net/3248ea4e/uploads/origins/76dd7f0a-3e27-4efb-9072-9474fef4c564?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a75f5cd3b5e83c7216b23964b14967a, https://si.imgix.net/3248ea4e/uploads/origins/76dd7f0a-3e27-4efb-9072-9474fef4c564?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a064cf3c2db6db5b830682ec354808e4 2x, https://si.imgix.net/3248ea4e/uploads/origins/76dd7f0a-3e27-4efb-9072-9474fef4c564?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b610757f421fc96837b910eab5cb9b9 3x", "genre": "art", "nsfw": true, "body": "かんどり様\n\nはじめまして、ありのみと申します\n先生に東方projectのチルノさんと大妖精さんの百合えっちをお願いしてもよろしいでしょうか？\n\n念のため２人の資料画像を用意していますので、もしよろしければ下記URLをご参照下さい。\nhttps://twitter.com/ARINOMI7/status/1549022259926695938\n羽のデザインはその時々で変わりますので可変(自由)だと思っておりますが\nもし可能であれば大妖精さんの羽根はドットで見られるようなフワっとした雰囲気があると嬉しいです。\nまたあくまで個人的なイメージではありますが\n　身長体型は同程度で２人ともスレンダー、お胸もぺたんこ\n　強いて言えば大妖精さんの方が小柄\n　チルノさんはちょっとクセ毛のツリ目系で、裏表の無い勝気で活発なタイプ\n　大妖精さんはタレ目系で、口数が少なくどちらかと言えば受け身なタイプ\n　お互いに相手の事が大好きでよく一緒にいる仲良しコンビ\n　率直で積極的なチルノさんが基本的に主導権を持っている間柄の印象です\n\nふたりの相互手マンシチュをリクエストいたします。\n顔を真っ赤に染め、吐息や喘ぎ声を漏らしながら\nお互いの秘所を激しくぐちゅぐちゅと愛撫している感じで\n可能であれば絶頂差分もお願いしたいです\n服装は裸でも普段の服装でも下着姿でも全く別の格好でも問題ございません。\n構図や細かいシチュエーション等もお任せでお願いしたく存じます。\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/61", "thumbnail_src": "https://si.imgix.net/4cea1566/uploads/origins/561820c6-db09-4c50-956d-11c30722aad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=788c66e6abbfc3cb86d483d6a8c7feae", "thumbnail_srcset": "https://si.imgix.net/4cea1566/uploads/origins/561820c6-db09-4c50-956d-11c30722aad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=788c66e6abbfc3cb86d483d6a8c7feae, https://si.imgix.net/4cea1566/uploads/origins/561820c6-db09-4c50-956d-11c30722aad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=476aaab8f0ecdcbbb770da2834b68d27 2x, https://si.imgix.net/4cea1566/uploads/origins/561820c6-db09-4c50-956d-11c30722aad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54cd9b94278c003c5b3100a60fb917b2 3x", "genre": "art", "nsfw": true, "body": "先日はコメットちゃんのイラストありがとうございました\n\n今回はブルアカの月雪ミヤコちゃんをお願いできませんでしょうか\n制服で正面からの正常位でえっちしているところをお願いします。白色のパンツをずらし装入で装入中で射精前のシーンでお願いします\n表情は表情変化の少ないミヤコなので少し恥ずかしがってるような感じで\n\n制服に付いてる装備等は外している想定で省略していただいてかまいません（おまかせします）\n\n可能であれば装入前のパンツをはいている差分をお願いできればと思います\n\nご検討いただければ幸いです", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/60", "thumbnail_src": "https://si.imgix.net/f07c885a/uploads/origins/d23a7b72-7e68-40cf-a744-901e48059e14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec446becbcf8bd6c3bcd692700396817", "thumbnail_srcset": "https://si.imgix.net/f07c885a/uploads/origins/d23a7b72-7e68-40cf-a744-901e48059e14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec446becbcf8bd6c3bcd692700396817, https://si.imgix.net/f07c885a/uploads/origins/d23a7b72-7e68-40cf-a744-901e48059e14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0424487493ff62a52a767d556c64bea6 2x, https://si.imgix.net/f07c885a/uploads/origins/d23a7b72-7e68-40cf-a744-901e48059e14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f915bf6a980cda40317ce4a0d3f3f1c 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nTwitterでイラストをお見掛けして是非リクエストをしたいと思いました。\n\n依頼したいのは私のオリジナルキャラクターのNSFWイラストです。\n\n・キャラクター\n引きこもりのユキヒョウのTS娘です。年齢は10歳ぐらい。\nダウナーでクールなイメージで、いつも眠そうにしています。\n\n・シチュエーション\n男物のパジャマの上だけを羽織った服装でベッドの上にあぐらで座り、オナニーに浸っている様子をお願いします。\n\nその他の要素はお任せしたいです。\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1MO_1iWziobPcgR_gCK91V8q2lFTKmv5P/view?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/59", "thumbnail_src": "https://si.imgix.net/3e4bd60f/uploads/origins/9c63cfdc-c17b-4fb5-888d-ac0b3ddbf1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2102d2ccc447cb6b7a141ffb33e12cd3", "thumbnail_srcset": "https://si.imgix.net/3e4bd60f/uploads/origins/9c63cfdc-c17b-4fb5-888d-ac0b3ddbf1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2102d2ccc447cb6b7a141ffb33e12cd3, https://si.imgix.net/3e4bd60f/uploads/origins/9c63cfdc-c17b-4fb5-888d-ac0b3ddbf1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95d0042cc8c8a0035d4ca1883dfc88c1 2x, https://si.imgix.net/3e4bd60f/uploads/origins/9c63cfdc-c17b-4fb5-888d-ac0b3ddbf1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=908e47956cce1c28a38b512e4248bded 3x", "genre": "art", "nsfw": true, "body": "はじめまして。素敵なイラストを作品欄で拝見し、リクエストさせていただきます。\n妄想強めにつき、内容が合わない等、各種ご事情でキャンセルとして頂いてももちろん大丈夫です。\n\n■キャラクター\nアイドルマスターシンデレラガールズから「白雪千夜」ちゃんをお願いしたいです。\n\n■シチュエーション等\n・艦これの島風のコスプレ姿で、担当プロデューサーに犯されている場面をお願いしたいです。\n・おそらく撮影の仕事という名目で連れ出され、衣装と称して用意された島風の服を怪訝に思いつつも仕事ということで素直に身に着け、そのタイミングで襲われたのだと思います。\n・体位や構図等はお任せしますが、可能な範囲で衣装は崩さず脱がさず…だと嬉しいです。\n\n妄想ですが、いろいろあって自暴自棄になったプロデューサーが最後の思い出にと（？）担当アイドルに手を出してしまったようなイメージです。\nそれに対し、「やはり、お前はケダモノだったのですね…。いいでしょう、私が相手になります。──私以外には、手を出すな」と応じている…。どんな表情なのか、どんな感情で応じているかはお任せします。\n※あくまでもイメージですので、特にイラスト内にセリフなどは不要です。\n※もし金額の範囲内で可能であれば、表情のバリエーションなどがあると嬉しいです。\n\n重ねてとなりますが、イメージが湧かない等、各種ご事情でキャンセルとしていただいても大丈夫です。\nご無理のない範囲でご検討ください。どうぞよろしくお願いいたします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/208", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/58", "thumbnail_src": "https://si.imgix.net/38b2c3de/uploads/origins/2c716691-c8a5-4b71-b7ad-e54e1d351a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c309e15a9a6681086b028db3243b444", "thumbnail_srcset": "https://si.imgix.net/38b2c3de/uploads/origins/2c716691-c8a5-4b71-b7ad-e54e1d351a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c309e15a9a6681086b028db3243b444, https://si.imgix.net/38b2c3de/uploads/origins/2c716691-c8a5-4b71-b7ad-e54e1d351a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84095fa219e2f3910ee88fcd8a5462f4 2x, https://si.imgix.net/38b2c3de/uploads/origins/2c716691-c8a5-4b71-b7ad-e54e1d351a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04bbcbbaa07f5088353dc6d3235c8e77 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。G11などリクエストしていた者です。\n良ければまたリクエストしたいです。\n\n以前から以下の作品が非常に気に入っており迷っていたのですが、こちらの騎乗位差分絵を描く事は可能でしょうか？\nあるいは、近い物でも大丈夫です。\nhttps://twitter.com/kandori_z/status/1499028965511827456?s=21&t=skCyKt-H37ngqUUyFvcwjQ\n下は履かず、ブラも外した状態でお願いします。\n男性は構図的に厳しければ、男性器のみの描写でも構いません。\n時中と中出しが欲しく、表情は時中で歯を食いしばり、中出しで口を開いて両目を閉じて欲しいです。\nまた出来れば、ワイプでは無いg11の腹部に直接描くような膣断面図がレイヤー分けか差分であると助かります。\n擬音やセリフもこれまでのような感じで、また涙や糸引き愛液も沢山あると嬉しいです。\n\n良ければご検討下さい。", "created_at": "", "completed_at": ""}, {"path": "/@KanDori_S/works/57", "thumbnail_src": "https://si.imgix.net/20a69fe7/uploads/origins/39c1421c-e6e0-4963-9dcd-9f0097178ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ac233534fd59cdd837aa7d90112444", "thumbnail_srcset": "https://si.imgix.net/20a69fe7/uploads/origins/39c1421c-e6e0-4963-9dcd-9f0097178ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ac233534fd59cdd837aa7d90112444, https://si.imgix.net/20a69fe7/uploads/origins/39c1421c-e6e0-4963-9dcd-9f0097178ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7a30def445a1f4d76bf4692caa526dd 2x, https://si.imgix.net/20a69fe7/uploads/origins/39c1421c-e6e0-4963-9dcd-9f0097178ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2008cde6cef71ba16cb3095f31d1480d 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました。\n募集再開されているのを機にまたご依頼させて頂きました。\n\n◆春原ココナ　体操着（ブルマ）\n・お尻を強調か見せるような形であればポーズはお任せいたします。\n・ブルマをパンツに変えた差分もお願いします。\n・PSD納品で文字をレイヤーで表示・非表示に出来るようにして頂けますと助かります。\n\n以上、ご検討いただけますと幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"pa