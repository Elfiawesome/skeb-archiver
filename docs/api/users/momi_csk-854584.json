txt=PRIVATE&s=948713870d5110f05fde779d7ccc52a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/16", "thumbnail_src": "https://si.imgix.net/eecafe6f/uploads/origins/2d854a3e-0c82-4866-a6f5-20893ac9acb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b543858a3b7f7bf538427aa69f936770", "thumbnail_srcset": "https://si.imgix.net/eecafe6f/uploads/origins/2d854a3e-0c82-4866-a6f5-20893ac9acb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b543858a3b7f7bf538427aa69f936770, https://si.imgix.net/eecafe6f/uploads/origins/2d854a3e-0c82-4866-a6f5-20893ac9acb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1b41c2f926d1fa1e3de7b65fb6f3702 2x, https://si.imgix.net/eecafe6f/uploads/origins/2d854a3e-0c82-4866-a6f5-20893ac9acb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ca7f2268c93da4f9135d0da391455c6 3x", "genre": "art", "nsfw": false, "body": "初めまして。くろと申します。\n\nもみ先生の描く霧子が好きで、今回skeb募集を再開していただけたということで初めてご依頼させていただきます。\n\n\n今回描いて欲しい霧子が\n「白い彼岸花を持つ霧子」です。\n\n\n用途としては\n「Xのアイコン」と「アイマスの名刺」で使用したいと考えています。\n\n\n肩の調子が悪いとお伺いしたので、お身体のご負担が少ない時に描いていただければ幸いです。\n\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/15", "thumbnail_src": "https://si.imgix.net/0df3fcec/uploads/origins/2cb4371a-5ad6-4fa6-9cbc-3a8088d272ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51cca377318bd89816f50b85b9b0728b", "thumbnail_srcset": "https://si.imgix.net/0df3fcec/uploads/origins/2cb4371a-5ad6-4fa6-9cbc-3a8088d272ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51cca377318bd89816f50b85b9b0728b, https://si.imgix.net/0df3fcec/uploads/origins/2cb4371a-5ad6-4fa6-9cbc-3a8088d272ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59a55349f0caf5fcde5e15e8aa7f01b1 2x, https://si.imgix.net/0df3fcec/uploads/origins/2cb4371a-5ad6-4fa6-9cbc-3a8088d272ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20154d0454ba1378295c2e4b7e903c5b 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストありがとうございます。\n以前描かれていたオルカドサーヴァントの霧子イラストがとても好きなので、また描いていただきたく依頼しました。いつもより少し妖艶だったり悩まし気な表情の、いつもでない霧子が見られると嬉しいです。\nもしよろしければご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/14", "thumbnail_src": "https://si.imgix.net/02013682/uploads/origins/37141aa8-5d9b-4bc5-86f9-142c345d571b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df02addb63abc1c5256ec7a262f0b961", "thumbnail_srcset": "https://si.imgix.net/02013682/uploads/origins/37141aa8-5d9b-4bc5-86f9-142c345d571b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df02addb63abc1c5256ec7a262f0b961, https://si.imgix.net/02013682/uploads/origins/37141aa8-5d9b-4bc5-86f9-142c345d571b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e3e62b20be3810c0f05899eeddfde24 2x, https://si.imgix.net/02013682/uploads/origins/37141aa8-5d9b-4bc5-86f9-142c345d571b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c96b07d84d5bd8bd2117088cd00aecd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/13", "thumbnail_src": "https://si.imgix.net/bacb3b2d/uploads/origins/6798fd01-012d-4a5c-8f9f-0e9f392d35f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74db7d7f015b17113c3038010dca9e34", "th