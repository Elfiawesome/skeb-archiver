8c2 2x, https://si.imgix.net/577dd6a2/uploads/origins/d06453de-c33f-42e7-8b41-dd59d3cf38e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b4a9fd34ef4f75247c38c35eac9afc 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ申し訳ございません。\n以前にツイートされていた成人向け霧ちゃんをめちゃくちゃにするお話をイラストで描いてもらえないでしょうか。描ける範囲ででいいのでよければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/9", "thumbnail_src": "https://si.imgix.net/4ece2364/uploads/origins/7f6cdadd-52b5-43c8-b61f-2d5becd59921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f857234df5f954a3ebe2c9ad9cdbb8a", "thumbnail_srcset": "https://si.imgix.net/4ece2364/uploads/origins/7f6cdadd-52b5-43c8-b61f-2d5becd59921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f857234df5f954a3ebe2c9ad9cdbb8a, https://si.imgix.net/4ece2364/uploads/origins/7f6cdadd-52b5-43c8-b61f-2d5becd59921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3996c9d918a725d6f52e8e242e51666 2x, https://si.imgix.net/4ece2364/uploads/origins/7f6cdadd-52b5-43c8-b61f-2d5becd59921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=967aad9e6e10e50eef6383a101edc604 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/8", "thumbnail_src": "https://si.imgix.net/79eebdd2/uploads/origins/3923b2e6-7fad-441d-90a8-abf06887bacf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9486dc63353775907d51bcc2869a05b5", "thumbnail_srcset": "https://si.imgix.net/79eebdd2/uploads/origins/3923b2e6-7fad-441d-90a8-abf06887bacf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9486dc63353775907d51bcc2869a05b5, https://si.imgix.net/79eebdd2/uploads/origins/3923b2e6-7fad-441d-90a8-abf06887bacf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34996849cb92e157b649fbdd0d55bb5 2x, https://si.imgix.net/79eebdd2/uploads/origins/3923b2e6-7fad-441d-90a8-abf06887bacf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bd4f56fc7a39a6f5ded35c9189d7f66 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストありがとうございます。\n今回は看護師の幽谷さんを描いていただけないでしょうか。\n構図は以前描いていただいた保育士霧子先生のような複数の視点で見られる感じでお願いします。\n衣装はお任せしますが、迷われるようでしたらリスペクティブワークスタイルをご参照ください。\nもしよければご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/7", "thumbnail_src": "https://si.imgix.net/d769747f/uploads/origins/d55f51fd-ae7f-4a26-8d5c-6c03ca91d920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=100772d7e15c33bf654b4550d1e0c8c9", "thumbnail_srcset": "https://si.imgix.net/d769747f/uploads/origins/d55f51fd-ae7f-4a26-8d5c-6c03ca91d920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=100772d7e15c33bf654b4550d1e0c8c9, https://si.imgix.net/d769747f/uploads/origins/d55f51fd-ae7f-4a26-8d5c-6c03ca91d920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01dd5a6a2ddfdf6dd3998752d21bd9b9 2x, https://si.imgix.net/d769747f/uploads/origins/d55f51fd-ae7f-4a26-8d5c-6c03ca91d920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c856889e3a1ef243aed10dc12bcf0def 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストありがとうございます。\nまた霧子のイラストをお願いしたくリクエストいたしました。\n今回は【天・天・白・布】の私服で、保育士の幽谷先生を描いていただけないでしょうか。\n以前描かれていた医者霧子の保育士版のようなイメージです。細かいシチュエーションなどはお任せします。\nお忙しいとは思いますが、もし可能でしたらご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/6", "thumbnail_src": "https://si.imgix.net/07b5a9ec/uploads/origins/1f150d78-6305-4c3f-902b-01af28958fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f059a4386476040805934f4bcf9e1c", "thumbnail_srcset": "https://si.imgix.net/07b5a9ec/uploads/origins/1f150d78-6305-4c3f-902b-01af28958fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f059a4386476040805934f4bcf9e1c, https://si.imgix.net/07b5a9ec/uploads/origins/1f150d78-6305-4c3f-902b-01af28958fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b9fcd57e1bc5ca9ece8af9b5d8ab349 2x, https://si.imgix.net/07b5a9ec/uploads/origins/1f150d78-6305-4c3f-902b-01af28958fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=697e6ae6a48f2a1a51c1407fade00aa8 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見しております。T.R.Tと申します。\n前回はありがとうございました。霧子さんの自撮りという私の見たい！という気持ちを叶えてくださって本当に感謝の気持ちでいっぱいです。\n今回、またご依頼させていただきます。\n内容といたしましては、私のTwitterのアイコンに是非、もみさんの描かれたイラストを使用させていただきたいと思いまして、その内容といたしましては、\n『部屋着を着た霧子さん』でお願いしたいと思います。\nその他の構図等はお任せいたします。\nご多忙のこととは存じますが、何卒、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/5", "thumbnail_src": "https://si.imgix.net/f499bbde/uploads/origins/00dc1ed5-3595-4afd-ab30-530dc0f19914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c71f53dffed609c8ccd50b6cf7cd2784", "thumbnail_srcset": "https://si.imgix.net/f499bbde/uploads/origins/00dc1ed5-3595-4afd-ab30-530dc0f19914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c71f53dffed609c8ccd50b6cf7cd2784, https://si.imgix.net/f499bbde/uploads/origins/00dc1ed5-3595-4afd-ab30-530dc0f19914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f58441d50000acb1aa0edeba4f05040 2x, https://si.imgix.net/f499bbde/uploads/origins/00dc1ed5-3595-4afd-ab30-530dc0f19914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b263a4b73e1c3d34d1c9e088fcbe53f7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/4", "thumbnail_src": "https://si.imgix.net/96eeb39c/uploads/origins/19a65469-27cf-43ab-a9ce-abcb220cae5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d885b9af2885e4d5dcc8b2eda44b07d", "thumbnail_srcset": "https://si.imgix.net/96eeb39c/uploads/origins/19a65469-27cf-43ab-a9ce-abcb220cae5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d885b9af2885e4d5dcc8b2eda44b07d, https://si.imgix.net/96eeb39c/uploads/origins/19a65469-27cf-43ab-a9ce-abcb220cae5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d60135af3bc191700d11e429d0fedf18 2x, https://si.imgix.net/96eeb39c/uploads/origins/19a65469-27cf-43ab-a9ce-abcb220cae5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c3d1b37055556c2003de3907cfc8c3e 3x", "genre": "art", "nsfw": false, "body": "前回はとても素敵なイラストをありがとうございました。\n今回は霧子でツイッターのヘッダー用のイラストをお願いしたく依頼いたしました。\n衣装は【かぜかんむりの子どもたち】私服で、構図についてはお任せします。いつもの等身でもデフォルメでも、描きやすいようにしてくださって構いません。\n大雑把な依頼になってしまい恐縮ですが、もしよろしければご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/3", "thumbnail_src": "https://si.imgix.net/7357b574/uploads/origins/53606f07-6f08-4e5c-99e7-55de6f5765b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b90359c741619fc5a685514ec78e9630", "thumbnail_srcset": "https://si.imgix.net/7357b574/uploads/origins/53606f07-6f08-4e5c-99e7-55de6f5765b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b90359c741619fc5a685514ec78e9630, https://si.imgix.net/7357b574/uploads/origins/53606f07-6f08-4e5c-99e7-55de6f5765b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f94b066861c85112108204835bb5f343 2x, https://si.imgix.net/7357b574/uploads/origins/53606f07-6f08-4e5c-99e7-55de6f5765b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f7767ea4f71cfc530edd006ae699814 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私、T.R.Tと申します。\n以前、もみさんの「残夏」を拝読いたしまして、それ以来もみさんの描かれる霧子さんが凄く好きになり、魅了され、今回ご依頼させていただきと思いました。\n内容といたしましては、\n最近、ゲーム内に追加されました、三峰結華さんの『心に住む人』のイラストに描かれている霧子さんの衣装というか服装が、白を基調とした穏やかな服装で、とても霧子さんに似合っているなぁと感じまして。\n普段の服装自体も白や水色といった薄めの色合いの服が多めと見受けられますが、\n私は今回の服装がこれまで見てきた中でも凄く好きなので、\n是非衣装はそちらでお願いしたいです。\nそして構図なのですが、\n『テイクアウトのコーヒーを片手に可愛く自撮りをする霧子さん（上半身）』\nをお願いしたいです。\n霧子さんは恐らく、あまり自撮りをするタイプではありませんが、このコミュで写真を撮っていることと、「あえて」見てみたいと思いましたので、是非お願いしたいです。\nお仕事等々、大変お忙しい中、リクエストの内容も含め、誠に恐縮ではございますが、何卒よろしくお願いいたします。\n\nここまで読んでいただきありがとうございます。\nこの度は、長文失礼いたしました。\nどうか、お身体にお気をつけてお過ごしくださいませ。", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/2", "thumbnail_src": "https://si.imgix.net/43a22919/uploads/origins/02093e89-8a21-4cbb-8022-8680a828887a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed7b7b9d5a3c9d891e2a5d3a9e87b043", "thumbnail_srcset": "https://si.imgix.net/43a22919/uploads/origins/02093e89-8a21-4cbb-8022-8680a828887a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed7b7b9d5a3c9d891e2a5d3a9e87b043, https://si.imgix.net/43a22919/uploads/origins/02093e89-8a21-4cbb-8022-8680a828887a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81aad747f7b30d67d528db83ea53dc56 2x, https://si.imgix.net/43a22919/uploads/origins/02093e89-8a21-4cbb-8022-8680a828887a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=606c3e79dee0183c34dba8dc9d78f4d3 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストをありがとうございます。\n先日描かれていた幽谷先生がとても癖に刺さったので、医者霧子をまた描いていただきたくご依頼いたしました。\n衣装、構図、シチュエーションなどはお任せいたします。\nお忙しい時期とは思いますが、もしよろしければご検討お願いいたします。\n（こちらの誤操作でリクエスト再送信になってしまい申し訳ございません）", "created_at": "", "completed_at": ""}, {"path": "/@momi_csk/works/1", "thumbnail_src": "https://si.imgix.net/5b1e6e14/uploads/origins/d6999cdb-675e-4c4a-a49a-ee6395adaf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4407bc5b6be396e1cec14b207f52039", "thumbnail_srcset": "https://si.imgix.net/5b1e6e14/uploads/origins/d6999cdb-675e-4c4a-a49a-ee6395adaf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4407bc5b6be396e1cec14b207f52039, https://si.imgix.net/5b1e6e14/uploads/origins/d6999cdb-675e-4c4a-a49a-ee6395adaf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ddc98c613fef16115e913e306ed499a 2x, https://si.imgix.net/5b1e6e14/uploads/origins/d6999cdb-675e-4c4a-a49a-ee6395adaf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b7386cbfa7e77cae1961e51aecd5b37 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}