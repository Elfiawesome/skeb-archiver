nt=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eccdc15eb184247ffff78b3d75fc1459 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/29", "thumbnail_src": "https://si.imgix.net/26dc97a8/uploads/origins/5b3dde13-d04f-4606-8161-805beee744c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a458b2d35f3e75c04e05c987616c72f8", "thumbnail_srcset": "https://si.imgix.net/26dc97a8/uploads/origins/5b3dde13-d04f-4606-8161-805beee744c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a458b2d35f3e75c04e05c987616c72f8, https://si.imgix.net/26dc97a8/uploads/origins/5b3dde13-d04f-4606-8161-805beee744c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56bfb808ff73d0d5c9030105818ab62e 2x, https://si.imgix.net/26dc97a8/uploads/origins/5b3dde13-d04f-4606-8161-805beee744c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df1c37ace245db042f90a1021775e0a2 3x", "genre": "art", "nsfw": true, "body": "キャラ：虚構推理の七瀬かりん\nhttps://imgur.com/a/gCz7HJq\n資料URLにも別資料ございます。服装はご自由にお任せします。\n\nシチュエーション：後ろから犯され、両方の爆乳を揉まれて母乳を噴き出しながら、中出しされて涙目で絶頂している。\n母乳の量や勢いについては\nhttps://imgur.com/oZLXMES\nの「C3」のような感じでお願いできますでしょうか。\n構図は\nhttps://skeb.jp/@steam_erobou/works/25\nに近い感じ(でキス無し・両乳搾乳追加)でお願いします。竿役は原作無視モブ竿で、構図都合であまり見えない感じでも大丈夫です。\n\nhttps://union-creative.jp/goods/detail/?id=386", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/28", "thumbnail_src": "https://si.imgix.net/291c693b/uploads/origins/a66ede7e-3233-442e-b7bd-286708609f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8b296236df0030e871ad602ef6f6b4", "thumbnail_srcset": "https://si.imgix.net/291c693b/uploads/origins/a66ede7e-3233-442e-b7bd-286708609f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8b296236df0030e871ad602ef6f6b4, https://si.imgix.net/291c693b/uploads/origins/a66ede7e-3233-442e-b7bd-286708609f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4ff810742a6714f0df38e29d314070d 2x, https://si.imgix.net/291c693b/uploads/origins/a66ede7e-3233-442e-b7bd-286708609f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffbfb840e279b4dcb04fbf211d01aa18 3x", "genre": "art", "nsfw": true, "body": "今回の依頼内容は前回のジンキ・青葉の調教シーンの続きとなります。\n主人との情事を調教により堕ちてしまった青葉が悦びながら行っている所を、直ぐ近くで嬉しそうに見守っている赤緒（ただ立って見守るだけでもいいし、興奮して立った状態で自慰をしていても構いません）になります。\n服装：青葉、赤緒、二人とも裸に長手袋、ストッキング（両方、黒）を装着\n表情：二人とも虚ろ目（青葉の方は情事中の悦びで目をつぶっていても構いません）で頬を赤らめている。\n情事のシーン：サンプル①～⑤を参考。（参考なので別のポーズでも構いません）\n男や周りの様子は続きものなので、前回描いて頂いた感じでお願いします。\n\nhttps://pbs.twimg.com/media/FwqzYVraUAAJ_i9?format=jpg&name=large", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/27", "thumbnail_src": "https://si.imgix.net/c0728737/uploads/origins/92f9ed9b-9a6c-4145-8498-b02f52f2bd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b92676a6b921ac3c215162632de27ed5", "thumbnail_srcset": "https://si.imgix.net/c0728737/uploads/origins/92f9ed9b-9a6c-4145-8498-b02f52f2bd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b92676a6b921ac3c215162632de27ed5, https://si.imgix.net/c0728737/uploads/origins/92f9ed9b-9a6c-4145-8498-b02f52f2bd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f123d0f6cc90f5ce222ebddcfb4a855 2x, https://si.imgix.net/c0728737/uploads/origins/92f9ed9b-9a6c-4145-8498-b02f52f2bd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45bf280d8e3ed98919ae53a9f42344c1 3x", "genre": "art", "nsfw": true, "body": "ヒュースケン様\n初リクエスト致します\nシーダ（ＦＥ）\nhttps://twitter.com/RAMU_INU/status/1514222215876669442/photo/1\n\n合意のセッ〇ス、首筋にキス（構図イメージ）\nhttps://bokasitter.net/p/8c18ed881205485584c36de5f4ada09e\n\n相方\nhttps://bokasitter.net/p/9d692f19d46145b9a56e5778968661c1\n\nソックスを残す等でシーダと分かるようお願いします\n他の構図でも可、詳細はお任せします\n\nお好みに沿わなければキャンセル下さいませ", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/26", "thumbnail_src": "https://si.imgix.net/c5870b42/uploads/origins/9442131f-d731-46e3-8501-c2a5c55b150b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f78440cef33c396d2143f92cd2de5307", "thumbnail_srcset": "https://si.imgix.net/c5870b42/uploads/origins/9442131f-d731-46e3-8501-c2a5c55b150b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f78440cef33c396d2143f92cd2de5307, https://si.imgix.net/c5870b42/uploads/origins/9442131f-d731-46e3-8501-c2a5c55b150b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=892f1edaae72cb5ef445e4cb66286a78 2x, https://si.imgix.net/c5870b42/uploads/origins/9442131f-d731-46e3-8501-c2a5c55b150b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5baa5591db0c849dc5a97c82dcf498f1 3x", "genre": "art", "nsfw": true, "body": "前回のジンキの青葉・赤緒イラストありがとうございます。\n今回依頼したい内容はは洗脳処理が終わり青葉の調教を手伝う赤緒になります。\n裸で腕を吊るされて足が開いて人の字に拘束されている青葉に、四つん這いで後ろから御主人様に犯される赤緒が青葉の股間に愛撫しているイラストでお願いします。\n衣装は青葉は裸、赤緒は長手袋、ストッキング（両方、黒）\n目が開いている場合になるなら青葉、赤緒も虚ろ目でお願いします。\n資料のイラストは少し人の字が崩れていますが、なるべく人の字でお願いします。\n\nhttps://pbs.twimg.com/media/FsBik9XaIAAdoxq?format=jpg&name=medium", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/25", "thumbnail_src": "https://si.imgix.net/74016e9b/uploads/origins/75876897-c97a-4639-b837-18f62e5df767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=677c63348e01aa6de0eea36b9bc3e79c", "thumbnail_srcset": "https://si.imgix.net/74016e9b/uploads/origins/75876897-c97a-4639-b837-18f62e5df767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=677c63348e01aa6de0eea36b9bc3e79c, https://si.imgix.net/74016e9b/uploads/origins/75876897-c97a-4639-b837-18f62e5df767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48e4e5b59be8fbd7876ef58cc3363784 2x, https://si.imgix.net/74016e9b/uploads/origins/75876897-c97a-4639-b837-18f62e5df767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5244ed1a59c1e5a194ec0f943a9c7f9 3x", "genre": "art", "nsfw": true, "body": "▼作品\nハンドレッド\n\n▼キャラ\nクレア・ハーヴェイ\n\n▼詳細\nOCショタとのセックス。\nhttps://skeb.jp/@y_warabi/works/25\n\n後背位でハメられながら舌を絡めるような濃厚なキスをしている。\n\n雰囲気の参考として以下の3D作品を提示致します。\nhttps://www.pixiv.net/artworks/85120186\n\n姉弟なような関係の二人が本気で恋人セックスをしているイメージ。\n\nクレアは弟のように思っていた相手に背徳感を覚えながらもキスによる快楽の虜にされている。\nショタは余裕のある穏やかな表情でクレアの巨乳と舌を弄びながら突いている。\n\nhttps://ga.sbcr.jp/sp/hundred/img/chara02.jpg", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/24", "thumbnail_src": "https://si.imgix.net/eb2c1952/uploads/origins/1f5b1f0c-f0f6-42fb-a2f5-12a5ceaecaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=526d768738b8ca9f1bba8ff7520defd8", "thumbnail_srcset": "https://si.imgix.net/eb2c1952/uploads/origins/1f5b1f0c-f0f6-42fb-a2f5-12a5ceaecaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=526d768738b8ca9f1bba8ff7520defd8, https://si.imgix.net/eb2c1952/uploads/origins/1f5b1f0c-f0f6-42fb-a2f5-12a5ceaecaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64ecf24f405c2bf7066af9d738a31264 2x, https://si.imgix.net/eb2c1952/uploads/origins/1f5b1f0c-f0f6-42fb-a2f5-12a5ceaecaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2462f1ba0edcdc513681504afbc7a327 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@steam_erobou/works/23", "thumbnail_src": "https://si.imgix.net/47f24db2/uploads/origins/