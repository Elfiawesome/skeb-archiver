dac4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbc927c60852314537be95ac48eb77a0, https://si.imgix.net/b4f1a1e4/uploads/origins/c65900b6-92a5-49c8-b64f-ba52d8dac4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86fa1650009ac928bbe88914405d235e 2x, https://si.imgix.net/b4f1a1e4/uploads/origins/c65900b6-92a5-49c8-b64f-ba52d8dac4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f9f3a0a933ca09874a6bf847e08c92d 3x", "genre": "art", "nsfw": true, "body": "温和な性格の黒髪熟祖母のイラストをお願いします。\n祖母の見た目はこちら（https://skeb.jp/@steel_yamyam/works/146）の祖母を黒髪にした感じで、和服を着ています。\n田舎で一人暮らしをしている祖母のもとを訪れた孫（成人）が、酒の勢いで祖母の過去の男性経験を聞いたところ、屈強な黒人男性のセフレだったことが発覚するというシチュです。\n酒の勢いもあって詳しい話を聞く孫に、恥じらいながらも拒むことなく詳細な内容を話す祖母。獣みたいな交尾をしていたという話と現在の落ち着いている様子とのギャップに懐疑的な孫に対して、祖母は服を脱いで全裸を見せてくれます。臀部はシリコン整形をされておりアンバランスに肥大化した豊尻で、QOSのマークが刻まれています。\nセリフは前回の形式でお願いします。\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/186", "thumbnail_src": "https://si.imgix.net/dc5cccf5/uploads/origins/6a0617ed-83e3-4b2e-a7d2-ea1f1a149bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474a8c4c3a57b94334b0588098835a9d", "thumbnail_srcset": "https://si.imgix.net/dc5cccf5/uploads/origins/6a0617ed-83e3-4b2e-a7d2-ea1f1a149bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474a8c4c3a57b94334b0588098835a9d, https://si.imgix.net/dc5cccf5/uploads/origins/6a0617ed-83e3-4b2e-a7d2-ea1f1a149bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d913cb5aac325b44e441ac0b37ded2ad 2x, https://si.imgix.net/dc5cccf5/uploads/origins/6a0617ed-83e3-4b2e-a7d2-ea1f1a149bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c92f1d8c298f6a165b51d8b0aa777ea 3x", "genre": "art", "nsfw": true, "body": "いつも素敵な作品ありがとうございます！\n最高です！！\n\n  ぜひまた今依頼しているシリーズの続編をお願いします ！\n\n内容、展開、構図に関しては全て先生にお任せしたいと思います  \n\n何卒ご検討のほどよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/185", "thumbnail_src": "https://si.imgix.net/e4577ce9/uploads/origins/eb9b84da-01e2-4d0a-8bf2-c34193caa9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=260c184dbbe0a890228a076a129cd968", "thumbnail_srcset": "https://si.imgix.net/e4577ce9/uploads/origins/eb9b84da-01e2-4d0a-8bf2-c34193caa9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=260c184dbbe0a890228a076a129cd968, https://si.imgix.net/e4577ce9/uploads/origins/eb9b84da-01e2-4d0a-8bf2-c34193caa9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=295324a852d3aa41de852949c3d22d3a 2x, https://si.imgix.net/e4577ce9/uploads/origins/eb9b84da-01e2-4d0a-8bf2-c34193caa9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eea124696c40825f4e8f4da9497df019 3x", "genre": "art", "nsfw": true, "body": "「今だからこそ知りたい結婚と性行為の歴史」に描かれていたような丸髷の熟女のイラストをお願いします。\n熟女は元々は武家の女性で家格は高く武芸も修めているが夫を亡くし没落、金銭的に困窮したことから、成人している息子共々、豪商のところに身を寄せることになったというシチュです。\n実際は女遊びの激しい豪商のドラ息子にあてがうための実質的な妾であり、母も息子もそのことは理解しています。ドラ息子は巨根で性豪、幾度も遊び半分に女性に手を出し、時には妊娠させています。\n妊娠の可能性や家の体裁もあり、表向きは妾としての関係は伏せられていますが商家内では公然の秘密となっております。\n熟女は武家出身ではあるものの体型は年齢年相応、ドラ息子に囲われている女性の中では最高齢、陰毛ありです。\n\nイラストとして描写する人物は熟女のみ。シーンとしては、ドラ息子との初夜を迎える母。ドラ息子は軽薄な感じのヤリチンで清廉潔白な熟母にとっては苦手なタイプですが、立場の違いから従順な態度をとっています。その後、ドラ息子に命令され全裸になる母ですが恥じらいながらも毅然とした態度をとっています。\nセリフは前回の形式でお願いします。\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/184", "thumbnail_src": "https://si.imgix.net/2f129fc7/uploads/origins/db8937e9-6952-4c88-b6e9-73444cdd0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b83d9d62c88c6cd47a5ad80f11087c", "thumbnail_srcset": "https://si.imgix.net/2f129fc7/uploads/origins/db8937e9-6952-4c88-b6e9-73444cdd0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b83d9d62c88c6cd47a5ad80f11087c, https://si.imgix.net/2f129fc7/uploads/origins/db8937e9-6952-4c88-b6e9-73444cdd0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8da7d4bed7ce42eb110a20e48d2d8b8 2x, https://si.imgix.net/2f129fc7/uploads/origins/db8937e9-6952-4c88-b6e9-73444cdd0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ffaeba1570b59f5222b842bde4c35ff 3x", "genre": "art", "nsfw": true, "body": "地味な普通の熟母の托卵イラストをお願いします。\n少子化対策として、托卵が制度化された世界で、托卵対象に熟母が選ばれたというシチュです。\n相手は遺伝的に優秀だとして選抜されたイケメンヤリチンで、すでに何十回と托卵した実績のある相手。歳は若く、息子と対して変わりません。\nそんな簡単に落とされたりしないと笑っていた熟母ですが、自分の息子と大して変わらない若いイケメンに口説かれて女の顔になっています。息子の目の前でナンパされて押し切られてしまうも、制度なので口出しできない息子君。\nまた、差分として、帰ってきた母から、妊娠検査キットを見せられて妊娠報告されるイラストをお願いします。\nイラストとしては母とヤリチンが並んでいる形でお願いします。\nセリフは前回の形式でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/183", "thumbnail_src": "https://si.imgix.net/cd2bb3d3/uploads/origins/13e16ff9-9cb6-438b-92ba-97ca789b1678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4b284cb2679a23c3e50d6a0c83f99d3", "thumbnail_srcset": "https://si.imgix.net/cd2bb3d3/uploads/origins/13e16ff9-9cb6-438b-92ba-97ca789b1678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4b284cb2679a23c3e50d6a0c83f99d3, https://si.imgix.net/cd2bb3d3/uploads/origins/13e16ff9-9cb6-438b-92ba-97ca789b1678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6978a75159e804ce3cdfc7b12bef4c7 2x, https://si.imgix.net/cd2bb3d3/uploads/origins/13e16ff9-9cb6-438b-92ba-97ca789b1678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95b0b52132749b4b485571c4f4356bdf 3x", "genre": "art", "nsfw": true, "body": "いつも素敵な作品ありがとうございます！\n\n今依頼しているシリーズの続編をお願いします\n内容、展開、構図に関しては全て先生にお任せしたいと思います\n\n何卒ご検討のほどよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/182", "thumbnail_src": "https://si.imgix.net/82b5c27c/uploads/origins/11a41de8-f07f-4834-9a5e-dde1fbf51c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e9651516c286aa91e57d42e562a4a4", "thumbnail_srcset": "https://si.imgix.net/82b5c27c/uploads/origins/11a41de8-f07f-4834-9a5e-dde1fbf51c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e9651516c286aa91e57d42e562a4a4, https://si.imgix.net/82b5c27c/uploads/origins/11a41de8-f07f-4834-9a5e-dde1fbf51c37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65dd0adb1436aabd73b7406e7fb5583b 2x, https://si.imgix.net/82b5c27c/uploads/origins/11a41de8-f07f-4834-9a5e-dde1fbf51c37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fd39d71a4f436ae09904cbb109319cf 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、これは私が構想したストーリー展開です。ヒロインは腹筋の割れた、スタイルの良い筋肉質の強い女性です。彼女の身分は何でも構いません（例：マフィアのボスの妻、女刑事、エージェント、戦士など、作者が決めても良いです）。\n\nとにかく、彼女は何らかの理由（薬を盛られる、敗北するなど）で意識を失い、その後、全裸に剥かれて拘束されます。悪役（身分は問いません）は、ある情報を聞き出すために彼女を拷問します。彼女は精神的に強く、拷問に必死に耐え抜かなければなりませんが、最終的に悪役に灌腸（強力な下剤）を施されます。\n\n注入後、悪役は彼女が排泄できないように肛門に栓をし、情報を吐くまで放置します。排泄できない苦しみの中、彼女はどれほど努力しても最後には屈してしまい、情報を教えてしまいます。情報を手に入れた悪役はカメラを回し、アナルプラグを抜いて、彼女をボウルの中に排泄させます。長い間我慢させられていたため、彼女は大量に排泄し、羞恥心を感じながらも、次第に失禁の解放感に浸っていきます。そして最後には絶頂に達し、気絶してしまいます。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/181", "thumbnail_src": "https://si.imgix.net/4e4475c3/uploads/origins/54d4aba9-17cb-4eea-9e93-254d875ee455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e4ea20cd3ecc955675448f03b60e95d", "thumbnail_srcset": "https://si.imgix.net/4e4475c3/uploads/origins/54d4aba9-17cb-4eea-9e93-254d875ee455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e4ea20cd3ecc955675448f03b60e95d, https://si.imgix.net/4e4475c3/uploads/origins/54d4aba9-17cb-4eea-9e93-254d875ee455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0a343136c88cd64d64f91714ea38ee3 2x, https://si.imgix.net/4e4475c3/uploads/origins/54d4aba9-17cb-4eea-9e93-254d875ee455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4428373f95378b3740c68d1fa4a9b5bc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/180", "thumbnail_src": "https://si.imgix.net/626a2ce9/uploads/origins/8263288d-70a9-4517-abc8-a96bd643af46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a02f9a458f7f1f2cb83ad37c4e1dd7f3", "thumbnail_srcset": "https://si.imgix.net/626a2ce9/uploads/origins/8263288d-70a9-4517-abc8-a96bd643af46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a02f9a458f7f1f2cb83ad37c4e1dd7f3, https://si.imgix.net/626a2ce9/uploads/origins/8263288d-70a9-4517-abc8-a96bd643af46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bd54b58eb77ecbda9b18d8c4a200f59 2x, https://si.imgix.net/626a2ce9/uploads/origins/8263288d-70a9-4517-abc8-a96bd643af46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63ec913e49b5556087f2587eabff5f15 3x", "genre": "comic", "nsfw": true, "body": "以前に描いていただいた出産作品が素晴らしかったので、今回も熟母が性に溺れた果てに高齢出産をするところを描いた作品をリクエストしたいと思います。\n出産描写は前回2件と同様にはっきりと産んでいる子が描写されるくらいのレベルでお願いします。\n熟母が出産すること以外のキャラやシチュエーションの設定は特に希望しませんので今回新規のキャラ、過去の山岡さんの同人や依頼の設定を流用した後日談的なもの、その他二次創作といった中で山岡さんが描きやすいもので大丈夫です。\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/179", "thumbnail_src": "https://si.imgix.net/1a9de5bb/uploads/origins/7be70e91-67cf-48c5-a200-aa7806c47e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ec86af9ce154a235aea5a5fd76c22f", "thumbnail_srcset": "https://si.imgix.net/1a9de5bb/uploads/origins/7be70e91-67cf-48c5-a200-aa7806c47e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ec86af9ce154a235aea5a5fd76c22f, https://si.imgix.net/1a9de5bb/uploads/origins/7be70e91-67cf-48c5-a200-aa7806c47e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b66abfbc87b8019b8279bb94d22ee614 2x, https://si.imgix.net/1a9de5bb/uploads/origins/7be70e91-67cf-48c5-a200-aa7806c47e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e18191f8c29dd8b94b99a5352ef57a3a 3x", "genre": "art", "nsfw": true, "body": "運動部に所属している高校生の真面目な息子君が、地味な普通の母を部活の後輩に寝取られるイラストをお願いします。\n後輩は、実力はあるが女癖と素行の悪いイケメンヤリチンです。後輩に手を出してもいいか尋ねられて、真面目な母さんが頷くはずはないと許可を出したところ、簡単に股を開いていたというシチュです。\n場所は自宅。後輩君から母を堕としたことを伝えられて半信半疑の息子君のスマホに、母の無様フェラ画像が届きます。そんな画像が送られているとは知らない目の前の母親とのギャップに信じられない息子君の元に、母をどうやって堕としたかや使い心地についてのメッセージが届きます。有料で画像や動画も送ってやると煽られるも、強く拒むことができません。\nイラストとしては普段着の母と、画面手前にスマホを持っている息子くんの手が描かれています。スマホには、後輩から送られてきた母の下品な正面ひょっとこフェラ顔が表示されています。\nセリフは前回の形式でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/178", "thumbnail_src": "https://si.imgix.net/32f9f6c3/uploads/origins/fe7ef536-8316-458c-b5ca-6235118303f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ea6296ef08b48f7c66f61eb1cb27e5", "thumbnail_srcset": "https://si.imgix.net/32f9f6c3/uploads/origins/fe7ef536-8316-458c-b5ca-6235118303f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ea6296ef08b48f7c66f61eb1cb27e5, https://si.imgix.net/32f9f6c3/uploads/origins/fe7ef536-8316-458c-b5ca-6235118303f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=268c22a49593178191e93ba5eb53e7ae 2x, https://si.imgix.net/32f9f6c3/uploads/origins/fe7ef536-8316-458c-b5ca-6235118303f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd897076a3914d26d07a9ce89e4857a1 3x", "genre": "art", "nsfw": true, "body": "いつも素敵な作品ありがとうございます！\n\n今依頼しているシリーズの続編をお願いします\n内容、展開、構図に関しては全て先生にお任せしたいと思います\n\n何卒ご検討のほどよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/177", "thumbnail_src": "https://si.imgix.net/ead5cb81/uploads/origins/62de3abf-bd5e-4509-b894-c9e0e0588487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80ad6d31fb0eef4a82bb54dd8038c14", "thumbnail_srcset": "https://si.imgix.net/ead5cb81/uploads/origins/62de3abf-bd5e-4509-b894-c9e0e0588487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80ad6d31fb0eef4a82bb54dd8038c14, https://si.imgix.net/ead5cb81/uploads/origins/62de3abf-bd5e-4509-b894-c9e0e0588487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e01d6ef557adec5922bff50763a2cb46 2x, https://si.imgix.net/ead5cb81/uploads/origins/62de3abf-bd5e-4509-b894-c9e0e0588487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=327521ade0c2864e35ef5bcb751777c3 3x", "genre": "art", "nsfw": true, "body": "高校生の息子が偶然父のカメラを見つけ、中の動画を見ていると、ホームステイ中の屈強な黒人留学生に抱かれる母が写っていたというモノクロのイラストをお願いします。\n母は真面目で地味な普通のタイプ。父が母を貸し出したというシチュで、母も恥ずかしがっているが満更ではない感じです。場所は夫婦の寝室で、父が二人を撮影しています。留学生は普段は陽気で気のいいタイプですが、母のことは早速呼び捨てにしており（父にはさん付け）、プレイだからとBBC専用などと恥ずかしいおねだりを言わせたりと嗜虐的です。\nイラストはモノクロの1枚絵で、内容は、撮影前の全裸の二人、ひょっとこフェラ、本番、事後の四つを希望します。\nセリフは前回の形式でお願いします。\nもしよろしければお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/176", "thumbnail_src": "https://si.imgix.net/86fffa92/uploads/origins/caa593aa-c4df-4650-a772-0718181b17f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2001a5a734c2e9d646af77ace9fb5545", "thumbnail_srcset": "https://si.imgix.net/86fffa92/uploads/origins/caa593aa-c4df-4650-a772-0718181b17f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2001a5a734c2e9d646af77ace9fb5545, https://si.imgix.net/86fffa92/uploads/origins/caa593aa-c4df-4650-a772-0718181b17f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58d6d26d07e418e9caa9a831a3eb2057 2x, https://si.imgix.net/86fffa92/uploads/origins/caa593aa-c4df-4650-a772-0718181b17f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11f0695ced7ab57fb9368a32027e5e05 3x", "genre": "art", "nsfw": true, "body": "いつも素敵な作品ありがとうございます！\n前回の続編をお願いします\n\nまた母の様子を見に行く息子\nまたセックスしている母とユウト\nそれを見ながら我慢できずに自らの粗ちんを扱く息子\n情けなく射精\n\n今回は息子が扱いているシーンが見たいです\nまた息子の粗ちんは可能な限り小さく粗末で皮が被っている感じにして欲しいです！\n\n何卒ご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/175", "thumbnail_src": "https://si.imgix.net/57f84731/uploads/origins/b9cd2948-f606-4688-9ada-40774a2290e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=265b18681431383fc8c7be57e2911690", "thumbnail_srcset": "https://si.imgix.net/57f84731/uploads/origins/b9cd2948-f606-4688-9ada-40774a2290e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=265b18681431383fc8c7be57e2911690, https://si.imgix.net/57f84731/uploads/origins/b9cd2948-f606-4688-9ada-40774a2290e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fce80ba9371228d9d8985a8d54d463b 2x, https://si.imgix.net/57f84731/uploads/origins/b9cd2948-f606-4688-9ada-40774a2290e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66c0ec7f27b7bd394bfec89c838b12dc 3x", "genre": "art", "nsfw": true, "body": "（https://skeb.jp/@steel_yamyam/works/163）の続きで、その後見事に孕まされた熟母だが表向きはいつも通りの生活をしていた。ある日、母から軽い調子でDVDを渡され、恐る恐る再生してみると全裸の母が写っていたというシチュでお願いします。\n息子との筆おろしを知ったヤリチンが、息子にオカズを提供してやれよwと企画したという流れです。母は恥じらい、相手の男のことは呼び捨てで勝ち気な口調を保っていますが、激しく責められることを期待していることを見透かされています。\n母は陰毛あり、体型はさらにだらしなく、乳首と性器は色素沈着しており、グロマンです。\nイラストとしては普段着のボテ腹の母と全裸差分という感じでお願いします。\nセリフは前回の形式でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/174", "thumbnail_src": "https://si.imgix.net/f094c7f1/uploads/origins/2addc736-05c1-4cda-ab42-73d6f814a05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d89c45e6ccc0e61c60d56f9f7f17c8d1", "thumbnail_srcset": "https://si.imgix.net/f094c7f1/uploads/origins/2addc736-05c1-4cda-ab42-73d6f814a05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d89c45e6ccc0e61c60d56f9f7f17c8d1, https://si.imgix.net/f094c7f1/uploads/origins/2addc736-05c1-4cda-ab42-73d6f814a05e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24e4b40b33d4e1a1ffe9006dffefdad3 2x, https://si.imgix.net/f094c7f1/uploads/origins/2addc736-05c1-4cda-ab42-73d6f814a05e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10bb3d0ea4c39afb1ea5f51878403791 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@steel_yamyam/works/173", "thumbnail_src": "https://si.imgix.net/19588556/uploads/origins/b8a4023f-ec26-4f8f-a9e3-0d696ceeaeb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9777d191c50dad13de15c01afd5fab3", "thumbnail_srcset": "https://si.imgix.net/19588556/uploads/origins/b8a4023f-ec26-4f8f-a9e3-0d696ceeaeb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9777d191c50dad13de15c01afd5fab3, https://si.imgix.net/19588556/uploads/origins/b8a4023f-ec26-4f8f-a9e3-0d696ceeaeb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ae0663ee0495bc3e295ea