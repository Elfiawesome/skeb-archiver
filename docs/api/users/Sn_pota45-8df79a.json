ea-b1cb8dfab75c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84ff6b04c5a3784057e05041b933f783 3x", "genre": "art", "nsfw": true, "body": "初めまして。次の内容でリクエストします。\n\n●キャラクター\n茶髪ロング、つり目、ふたなり、制服(URLの色違い)\n\n●シチュエーション\n①直立姿勢(ノーマル)の状態\n②スカートの中で勃起してカウパーのシミが出来てる状態\n③スカートの中で大量射精している状態\n\nの3種類をお願いしたいです。\n表情や構図等は先生にお任せ致します。\nよろしくお願い致します。\n\nhttps://seifukudoncky.com/smartphone/detail.html?id=000000060416&category_code=&page=1", "created_at": "", "completed_at": ""}, {"path": "/@Sn_pota45/works/2", "thumbnail_src": "https://si.imgix.net/474cee0b/uploads/origins/53f6164c-5d0a-4d75-b424-05ec5bf11858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bb0f9804776f9d1dc1c57d91f80e23e", "thumbnail_srcset": "https://si.imgix.net/474cee0b/uploads/origins/53f6164c-5d0a-4d75-b424-05ec5bf11858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bb0f9804776f9d1dc1c57d91f80e23e, https://si.imgix.net/474cee0b/uploads/origins/53f6164c-5d0a-4d75-b424-05ec5bf11858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a90834e2d44c318cc1a93be962bea2d 2x, https://si.imgix.net/474cee0b/uploads/origins/53f6164c-5d0a-4d75-b424-05ec5bf11858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=641b1c9891f5d228c56bcf885358b76e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Sn_pota45/works/1", "thumbnail_src": "https://si.imgix.net/53ed177d/uploads/origins/2be57bcb-7784-46fd-a341-d31563605773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=605976047fa61c4355c8e61fd9269abe", "thumbnail_srcset": "https://si.imgix.net/53ed177d/uploads/origins/2be57bcb-7784-46fd-a341-d31563605773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=605976047fa61c4355c8e61fd9269abe, https://si.imgix.net/53ed177d/uploads/origins/2be57bcb-7784-46fd-a341-d31563605773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5aeb1ed88cda45a8a5c116de9e006d1a 2x, https://si.imgix.net/53ed177d/uploads/origins/2be57bcb-7784-46fd-a341-d31563605773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f1bd5ad108ace2bae0d7fb6917b8986 3x", "genre": "art", "nsfw": true, "body": "女の子やおっぱいが最高だったので可能な範囲でお願いします\n着衣超乳&ボテ優先で、触手要素は無視でも構いません\n書くかも程度の予定ですがM向け小説の挿絵に利用できればと思ってます\n\n作品名：賢者の弟子を名乗る賢者\nキャラ：ヒナタ、マリアナ(https://imgur.com/a/npMoMfP)\nシチュ：\n触手に寄生・苗床にされた着衣超乳&特大着衣ボテ腹姿の二人に侮蔑されながら、\nスカートの下から這い出した（搾精用/産卵用）触手や粘液まみれの触手の群れを見せつけられるドMホイホイシチュ\n二人ともゴミを見るような冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし)で、\nヒナタは変態マゾへの嫌悪と怯え交じりの侮蔑、マリアナは嫌悪を一切隠すことなく瞳に涙を浮かべている侮蔑の表情を希望します\n\n二人とも手が簡単に沈む程で上半身以上のサイズかつ服越しにピンク色の透け勃起乳首がわかる着衣超乳&特大着衣ボテ腹衣装の中にギチギチに押し込まれ強調されており、\n衣装は着衣超乳や着衣ボテ腹用に調整して、肌は服で隠れている完全着衣状態で、\n着衣超乳&着衣ボテ腹内部は粘液まみれの大量の触手を孕み蠢き波打ってるイメージで、ボテ腹下腹部に怪しく光る淫紋の描写を希望します\n更にマリアナは衣装腹部の×の紐がギチギチに引き伸ばされてる描写にしてください\n\nスカート下の触手はスカートの表面を波打たせながら溢れ出る粘液まみれのブラシ状触手のほかに、\nヒナタはペニスを包み込む花弁と精巣まで到達する尿道責め産卵触手が、マリアナは肉塊卵を産み付けるような産卵用の肉々しい触手がメインにしてください\n背景は触手肉壁もしくは禍々しい感じで、psd形式希望で粘液まみれの触手が蠢く水音(効果音)の有無、二人の瞳のハイライト&顔上部の影の有無差分希望です\n\n予算的に可能ならや気が向いたら程度でいいので男性を捕縛して苗床にしているのは自身の身体の一部で男性の理想の女性型疑似餌を作って捕らえる巨大な肉塊の怪物で、\nあくまでも彼女たちは男性の好みを模して造られた意思なき肉人形に過ぎず、足が肉壁や肉床などと融合している設定を希望します\nまたもし上記設定で台詞あり差分(口調は適当で構いませんのでお任せします)が可能そうでしたらお願いします\n\n各種触手参考：https://imgur.com/a/I02AVSy\n肉塊疑似餌参考：\n\nhttps://imgur.com/a/MQNHvSy", "created_at": "", "completed_at": ""}]}