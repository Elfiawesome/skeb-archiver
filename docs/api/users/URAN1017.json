a73e5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c831b6ded092ed7e8bbac656a1a501f7", "thumbnail_srcset": "https://si.imgix.net/82157c28/uploads/origins/188c5b80-b48e-44b6-9812-eede4a73e5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c831b6ded092ed7e8bbac656a1a501f7, https://si.imgix.net/82157c28/uploads/origins/188c5b80-b48e-44b6-9812-eede4a73e5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb3d7e3d7bc6403c9de2e8172d1f31f2 2x, https://si.imgix.net/82157c28/uploads/origins/188c5b80-b48e-44b6-9812-eede4a73e5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cff9b321a2f165fe88f4b7be45dcc65e 3x", "genre": "art", "nsfw": false, "body": "うる星やつらのラムちゃんをリクエストします。\n衣装はトレードマークのトラ柄ビキニで、浮遊しながらご機嫌な笑顔を浮かべている様子が希望です。髪色はアニメ・原作どちら寄りでも構いません。構図等もお任せ致します。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/2", "thumbnail_src": "https://si.imgix.net/e38345fe/requests/177817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6683a8cbfb5f9d361bc08e35519771", "thumbnail_srcset": "https://si.imgix.net/e38345fe/requests/177817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6683a8cbfb5f9d361bc08e35519771, https://si.imgix.net/e38345fe/requests/177817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5438c0e4e40aa5f3467e24f584dbb4c 2x, https://si.imgix.net/e38345fe/requests/177817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8ff08fae8228ce4060cfb945f8e56a 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼します。\n初恋ゾンビの江火野さんがこちらを見つめながら\nブラジャーを脱いであの大きなおっぱいをこちらに見せているイラストをお願いしたいです。\nおっぱいが見えていれば「ブラジャーを脱いでいる途中」でも「脱いだブラジャーを片手に持っている」でも構いません。\n\n表情はとにかく恥ずかしくてたまらない感じ（ただし嫌々脱いでいるような屈辱系ではない感じ）でお願い致します。\nブラジャーはスポブラではなくできるだけオシャレなものでお願いします。\n「すごく見てる…」とか「恥ずかしい…」みたいな心の声もお願いします。\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {