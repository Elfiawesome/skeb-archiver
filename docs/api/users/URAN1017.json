a41a92f922a6caf46b604e3324d7997 2x, https://si.imgix.net/09118da7/uploads/origins/71e28690-0093-47c6-b262-c81fed8822e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=468bfc4efde41de5def397c2f1482765 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/18", "thumbnail_src": "https://si.imgix.net/e6ceb60a/uploads/origins/31e373df-9222-42db-8add-c84a249f17a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbbdab85967f08cb9d7978d6a26e14ab", "thumbnail_srcset": "https://si.imgix.net/e6ceb60a/uploads/origins/31e373df-9222-42db-8add-c84a249f17a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbbdab85967f08cb9d7978d6a26e14ab, https://si.imgix.net/e6ceb60a/uploads/origins/31e373df-9222-42db-8add-c84a249f17a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2816a0763ff5710133f0b22bc4960edd 2x, https://si.imgix.net/e6ceb60a/uploads/origins/31e373df-9222-42db-8add-c84a249f17a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91cc2d0416422de08a2f52d39a0fd803 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/17", "thumbnail_src": "https://si.imgix.net/da5e329b/uploads/origins/dcafdac7-41a5-469b-b2f3-09a7d925c38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4cced6150927d806525bfc7fc643ec9", "thumbnail_srcset": "https://si.imgix.net/da5e329b/uploads/origins/dcafdac7-41a5-469b-b2f3-09a7d925c38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4cced6150927d806525bfc7fc643ec9, https://si.imgix.net/da5e329b/uploads/origins/dcafdac7-41a5-469b-b2f3-09a7d925c38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2be918dbb91fa42e28eb88b98b39725b 2x, https://si.imgix.net/da5e329b/uploads/origins/dcafdac7-41a5-469b-b2f3-09a7d925c38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03a9647cf85a63967f73845b3d3fa6dd 3x", "genre": "art", "nsfw": false, "body": "此方では初めまして！\n艦これの時雨改三！\n頭の後ろに腕を組め！\n胸を張れ！\n腋を見せろ！\n横乳を強調せよ！\n自身に満ち溢れたドヤ顔でお願いします。\n以上細かいとこはお任せご検討願います。", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/16", "thumbnail_src": "https://si.imgix.net/fefe826f/uploads/origins/fab54cb9-9481-4d04-93a1-638ddfd9d802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d5ffc354c0bcd48b687c4a230a1776", "thumbnail_srcset": "https://si.imgix.net/fefe826f/uploads/origins/fab54cb9-9481-4d04-93a1-638ddfd9d802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d5ffc354c0bcd48b687c4a230a1776, https://si.imgix.net/fefe826f/uploads/origins/fab54cb9-9481-4d04-93a1-638ddfd9d802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cb0891a593f472997a1a82c755bd1e6 2x, https://si.imgix.net/fefe826f/uploads/origins/fab54cb9-9481-4d04-93a1-638ddfd9d802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=394c51018d598bf8bd620919def2621a 3x", "genre": "art", "nsfw": false, "body": "『艦これ』の夕立改二をリクエストします。\n衣装は通常のセーラー服姿で、おてんばな雰囲気の笑顔で元気よくジャンプやガッツポーズなどしている姿をお願いします。時雨ら白露型姉妹艦とおどけ合っているような平時のシチュエーションで、艤装は無し。構図等はお任せ致します。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/15", "thumbnail_src": "https://si.imgix.net/54539dcd/uploads/origins/a97c49f4-31e2-443f-be97-90cc8f8fe535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46763c1a4025b3f88f334490ff9ac439", "thumbnail_srcset": "https://si.imgix.net/54539dcd/uploads/origins/a97c49f4-31e2-443f-be97-90cc8f8fe535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46763c1a4025b3f88f334490ff9ac439, https://si.imgix.net/54539dcd/uploads/origins/a97c49f4-31e2-443f-be97-90cc8f8fe535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=125c08cb8ac66a3b0fae46c301e42ef0 2x, https://si.imgix.net/54539dcd/uploads/origins/a97c49f4-31e2-443f-be97-90cc8f8fe535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96ffd3e16d9991917bd61647c650beec 3x", "genre": "art", "nsfw": true, "body": "URAN先生、はじめまして。\n\n原神に登場する雷電将軍が休息中にムラムラしてしまい、半脱ぎの格好で自分のおっぱいを自分で吸いながら気持ちよさそうにセルフ乳吸いオナニーしてしまう絵をリクエストしてもよろしいでしょうか？\n\n希望する主な要素と内容は・・\n・服から両肩と両胸を曝け出しながらノーパンの格好でオナニー\n・片方の手で自分のおっぱいを自分の口元まで寄せて、自分の乳首を丸ごと咥えながら気持ちよさそうにセルフ乳吸い\n・もう片方のおっぱいも自分の乳首を吸った形跡があり、両胸に唾液が垂れている\n・アソコを濡らしながら余った手でクリトリスを刺激する\n・激しく自慰行為に浸ってしまい、体中汗塗れ\n・快感により涙目、または涙を流している\n\nシチュエーションに合ったエッチな擬音も入れていただけると嬉しいです。\n\n適当な台詞やイッちゃう差分もあると嬉しいですけど、負担になるようでしたら無くても結構です。\n\nご検討のほどよろしくお願い致します。\n\n参考URL:\n雷電将軍\nbit.ly/3DCBSgE\n\nセルフ乳吸い\nbit.ly/3rrLd56\nbit.ly/3ursPLC\nbit.ly/3gsVzvn", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/14", "thumbnail_src": "https://si.imgix.net/5ca4129b/uploads/origins/0a418fef-0ae4-4585-ad3f-90ee7439f01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ea0ad147c8adbe2995e6be8c119177b", "thumbnail_srcset": "https://si.imgix.net/5ca4129b/uploads/origins/0a418fef-0ae4-4585-ad3f-90ee7439f01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ea0ad147c8adbe2995e6be8c119177b, https://si.imgix.net/5ca4129b/uploads/origins/0a418fef-0ae4-4585-ad3f-90ee7439f01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=156d25751f0a5773fe3f7e9dc535816f 2x, https://si.imgix.net/5ca4129b/uploads/origins/0a418fef-0ae4-4585-ad3f-90ee7439f01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c2e049ee89616d569a2a894c4a6ead5 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n初めてskebを使っておりますので不慣れなところがあるかもしれませんが、モノクロ色紙の依頼をさせて頂きたいと思います。\nキャラクター指定に関しましては原神の胡桃にお願いしたいと思います。\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/13", "thumbnail_src": "https://si.imgix.net/8a7444a9/uploads/origins/3ca8df7d-60c8-4c41-9a2f-e6d59a33e4a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48ff28adbba1780fe2e65b92c93a534b", "thumbnail_srcset": "https://si.imgix.net/8a7444a9/uploads/origins/3ca8df7d-60c8-4c41-9a2f-e6d59a33e4a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48ff28adbba1780fe2e65b92c93a534b, https://si.imgix.net/8a7444a9/uploads/origins/3ca8df7d-60c8-4c41-9a2f-e6d59a33e4a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b072bd3b0e6e1edf1d7cd7bf1b6c1e2 2x, https://si.imgix.net/8a7444a9/uploads/origins/3ca8df7d-60c8-4c41-9a2f-e6d59a33e4a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8097225b3f746c65396cc296b52f73 3x", "genre": "art", "nsfw": true, "body": "URANさん、はじめまして。URANさんの描くラズベリー咲川がかわいかったので、依頼しようと決意しました。内容は、ラズベリー咲川が男にベアハッグをかけられ、おっぱいをコスチュームごしに吸われてしまう、で依頼したいです。コスチュームは下記urlの、オレンジ色のビキニでお願いいたします！\nhttps://netgamebm.com/game_news/view/80900", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/12", "thumbnail_src": "https://si.imgix.net/eeeddf98/uploads/origins/bbf2bf43-4187-48e3-9b13-dcb251819f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=897488d420667913a24db27b67ec781d", "thumbnail_srcset": "https://si.imgix.net/eeeddf98/uploads/origins/bbf2bf43-4187-48e3-9b13-dcb251819f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=897488d420667913a24db27b67ec781d, https://si.imgix.net/eeeddf98/uploads/origins/bbf2bf43-4187-48e3-9b13-dcb251819f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68db111b7e3b1d01393b98d00a21b8ff 2x, https://si.imgix.net/eeeddf98/uploads/origins/bbf2bf43-4187-48e3-9b13-dcb251819f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6131fe27a9c0179faea60f79eb8e1af 3x", "genre": "art", "nsfw": true, "body": "うる星やつらの藤波龍之介をお願いします。\n\n・衣装\n学ラン+さらしor海での短パン+シャツスタイルにて。\nまた、胸の露出をお願いします。\nその際さらしやシャツがはだけているのが希望ですが、単純なキャストオフ状態(半裸/全裸)でも大丈夫です。\n作業量から調整ください。\n\n・構図\nバストアップ(色紙などでよく描かれる感じ)、もしくは全身(膝上くらいあればok)の寝転び\n\n・その他\n印刷サービス用に宛名無しの差分もお願いします。\n何かしら不足があれば再送依頼をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/11", "thumbnail_src": "https://si.imgix.net/7e6a684a/uploads/origins/3ea0e74c-b2ba-4ba6-898e-8fa893cd5674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d2a27551aa095d4cf9260a007295c95", "thumbnail_srcset": "https://si.imgix.net/7e6a684a/uploads/origins/3ea0e74c-b2ba-4ba6-898e-8fa893cd5674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d2a27551aa095d4cf9260a007295c95, https://si.imgix.net/7e6a684a/uploads/origins/3ea0e74c-b2ba-4ba6-898e-8fa893cd5674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4cd6f50266743e761d4b1f59150ea95 2x, https://si.imgix.net/7e6a684a/uploads/origins/3ea0e74c-b2ba-4ba6-898e-8fa893cd5674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb96f928e6d016c33985f5dd88b207dc 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nお正月の着物を着た大淀を描いていただけませんか？\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/10", "thumbnail_src": "https://si.imgix.net/5894d468/uploads/origins/bdc39485-9368-4e83-8105-6c56668528cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b58e798c3eb00586566d097b732269c9", "thumbnail_srcset": "https://si.imgix.net/5894d468/uploads/origins/bdc39485-9368-4e83-8105-6c56668528cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b58e798c3eb00586566d097b732269c9, https://si.imgix.net/5894d468/uploads/origins/bdc39485-9368-4e83-8105-6c56668528cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=121e8c16aa8fef334e65ef872e0e6dd7 2x, https://si.imgix.net/5894d468/uploads/origins/bdc39485-9368-4e83-8105-6c56668528cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74aa2ccad7c1ccba170b7c70afb30de5 3x", "genre": "art", "nsfw": true, "body": "初めまして！ 絵柄がとっても好みだったのでリクエストさせていただきます！\nちょっとハードなリクエストですが、ソフィーのアトリエのソフィーちゃんが森での採取中に暴漢に襲われ必死に戦うもそのまま…といった内容でお願いします！\n\n服は初期の服で服ビリ、ビリ具合はお任せします！\n体位はバックで是非とも！\nアングルは俯瞰視点というのでしょうか、上から見た感じのアングル（あまり詳しくなくてすいません！）\n顔はモブの方を向きながら涙を目に溜めながら睨んでるものか泣きじゃくってる感じの表情どちらでも構いません！（もしよければ両方お願いできればなんて…）\n最後に要望なのですが、おしりをむっちりした感じにしていただけると嬉しいです！ 以上となります、ご検討いただければ幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/9", "thumbnail_src": "https://si.imgix.net/2e3aa101/uploads/origins/591acdae-1602-45bf-bae4-c8b8f9a4bc9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e84d942f089f6df51a92e05d0474cc96", "thumbnail_srcset": "https://si.imgix.net/2e3aa101/uploads/origins/591acdae-1602-45bf-bae4-c8b8f9a4bc9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e84d942f089f6df51a92e05d0474cc96, https://si.imgix.net/2e3aa101/uploads/origins/591acdae-1602-45bf-bae4-c8b8f9a4bc9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d74b7fea9def3c7dcba26a3bc6f16a0 2x, https://si.imgix.net/2e3aa101/uploads/origins/591acdae-1602-45bf-bae4-c8b8f9a4bc9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b020bcf78306f80625e7768903d7149f 3x", "genre": "art", "nsfw": true, "body": "またまた、こんにちは。\n\n前回の作品がとても気に入ったので、今回もお願いします!\n\n私のOCをセクシーなポーズで描いていただきたいのです。私が好きなポーズのいくつかは以下に参照されていますが、あなたはそれらのいずれかを選択するか、または新しいものを描くことができます\n精液や分泌物を入れても構いませんが、ヌードは別レイヤーにしてください。\n髪の毛は肩にかかるくらいまで伸ばしていただくと雰囲気が出ます。\n服装は、彼女が着ているランジェリーか、レースのついたセクシーなランジェリーを選んでください。\n彼女が身につけているアクセサリーは、以下のようなものを描いていただけると幸いです。\n\n\n楽しんでください。\nよろしくお願いします!\n\nアクセサリー： https://imgur.com/a/tkLOpLy\nポーズ： https://imgur.com/a/mJU7LgY\n\nhttps://imgur.com/a/o7YQFWv", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/8", "thumbnail_src": "https://si.imgix.net/badf2944/uploads/origins/a62d6b04-24be-4b34-b10c-e12ef5576cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6698997eada69527b9111ff479b99214", "thumbnail_srcset": "https://si.imgix.net/badf2944/uploads/origins/a62d6b04-24be-4b34-b10c-e12ef5576cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6698997eada69527b9111ff479b99214, https://si.imgix.net/badf2944/uploads/origins/a62d6b04-24be-4b34-b10c-e12ef5576cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8f6b61308c98b0f830e261ea2de1c5e 2x, https://si.imgix.net/badf2944/uploads/origins/a62d6b04-24be-4b34-b10c-e12ef5576cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=450576fde8c6d1f97802dc5b59a86b4a 3x", "genre": "art", "nsfw": true, "body": "艦これの大淀のエロ画像をリクエストしたいです。できれば、中出しやX線があるバリエーションもお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@URAN1017/works/7", "thumbnail_src": "https://si.imgix.net/b09aa702/uploads/origins/db2b885f-390a-48dd-940a-5e918e4f0ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66b256cb711360214c0a4dbc8cc29a2d", "thumbnail_srcset": "https://si.imgix.net/b09aa702/uploads/origins/db2b885f-390a-48dd-940a-5e918e4f0ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66b256cb711360214c0a4dbc8cc29a2d, https://si.imgix.net/b09aa702/uploads/origins/db2b885f-390a-48dd-940a-5e918e4f0ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f8af622315e340eb6551abd745b0f8f 2x, https://si.imgix.net/b09aa702/uploads/origins/db2b885f-390a-48dd-940a-5e918e4f0ec6?bg=%23fff&auto=format%2Ccompress&fm=we