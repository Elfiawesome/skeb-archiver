2f-44cd-baa4-7893b434d053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88f23a53d8495d52581328a744dc9a85 2x, https://si.imgix.net/954547cf/uploads/origins/70436dec-1d2f-44cd-baa4-7893b434d053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cda55cdbc78d5d735d87e38f4c0f1d1 3x", "genre": "art", "nsfw": true, "body": "前回はとても満足したので、今回もお願いしに来ました！\n\n以前お願いしたものと似たようなものです。\n\n1.エヴァンゲリオンのアスカとシンジ。\n2.前回のリクエストと同じ体格、髪型など。\n3.放課後の空き教室でセックスしている。アスカは机に突っ伏している。\n4.シンジはシャツを着ている。ズボンと下着は足首に下がっている。\n5.アスカのスカートは脱げ、地面に落ちている。パンティは足首にある。白い。ブラウスのボタンが開けられ、ブラジャーが引き上げられ、胸が露わになっている。\n6.たくさんのスウェット。\n7.シンジはアスカの腹の上で射精した。徹底的に疲れ果て、アスカの上で全身を折り曲げている。\n8.アスカはシンジの精液を見ている。彼はアスカの胸の真下に溜まるほど射精した。一部は机の上に流れ落ちている。アスカはそれを見てとても喜んでいる。\n\nその他の細かいことは、あなたの判断にお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@quanero95/works/13", "thumbnail_src": "https://si.imgix.net/fe3593fc/uploads/origins/d208780d-b0a2-4d66-8654-82730a7d31d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=709fca14ce4e4167ef5ffd023486f086", "thumbnail_srcset": "https://si.imgix.net/fe3593fc/uploads/origins/d208780d-b0a2-4d66-8654-82730a7d31d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=709fca14ce4e4167ef5ffd023486f086, https://si.imgix.net/fe3593fc/uploads/origins/d208780d-b0a2-4d66-8654-82730a7d31d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13363497799146e47638a49145875abe 2x, https://si.imgix.net/fe3593fc/uploads/origins/d208780d-b0a2-4d66-8654-82730a7d31d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d5e6cd6e915931fd01f6df8db8f3472 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは。いつも素晴らしい作品をありがとうございます。\nグランブルーファンタジーのオロロギア（女性）とグランのイラストをお願いしたいです。\n\nシナリオはハロウィンパーティーで、オロロギアはミイラのコスチュームを着ています。オロロギアはグランにその衣装を嬉しそうに見せびらかします。\n\nオロロギアの衣装が故障してオロロギアの体が露わになり、グランが勃起してしまう。\n\nシーンはオロロギアとグランの情熱的なセックスに飛ぶ。\n\n構図などはお任せします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@quanero95/works/12", "thumbnail_src": "https://si.imgix.net/a289ccec/uploads/origins/e839949c-8437-4785-967c-6b7a823d6b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daf321c705aa5b5c8f32b0200e97f829", "thumbnail_srcset": "https://si.imgix.net/a289ccec/uploads/origins/e839949c-8437-4785-967c-6b7a823d6b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daf321c705aa5b5c8f32b0200e97f829, https://si.imgix.net/a289ccec/uploads/origins/e839949c-8437-4785-967c-6b7a823d6b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e934c85d012b9cb52c2c0903a089354 2x, https://si.imgix.net/a289ccec/uploads/origins/e839949c-8437-4785-967c-6b7a823d6b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b1f697097fc3c73c6f32a8335d5e0cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}