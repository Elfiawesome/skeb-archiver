{"screen_name": "flying_watagash", "file": "flying_watagash", "name": "白珠(しらたま) 🍣", "avatar_url": "https://pbs.twimg.com/profile_images/1642188004877012993/uiRuksYK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3614065214/1632146711/1500x500", "description": "バニーガールや触手を描いてます((🍣)) I draw bunny girls and tentacles.((🍣)) 各種SNS、支援サイトは下記リンクからいらっしゃいませ！ 【https://linktr.ee/flying_watagash】", "total_works": 61, "scraped_works": 30, "first_seen": "2026-03-20T11:02:43.309682+00:00", "last_updated": "2026-03-20T11:02:43.309682+00:00", "price_history": {"art": [{"amount": 26000, "recorded_at": "2026-03-20T11:02:43.309682+00:00"}]}, "current_prices": {"art": 26000}, "price_range": {"art": {"min": 26000, "max": 26000}}, "links": [{"label": "Twitter", "url": "https://x.com/flying_watagash", "name": "flying_watagash"}, {"label": "Website", "url": "https://linktr.ee/flying_watagash", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/1085859", "name": "1085859"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/346192", "name": "346192"}, {"label": "Fanbox", "url": "https://whiteball7491.fanbox.cc", "name": "whiteball7491"}], "flags": {}, "acceptable": false, "works": [{"path": "/@flying_watagash/works/62", "thumbnail_src": "https://si.imgix.net/59d0efac/uploads/origins/d5bed763-40c1-456a-8d81-a919f7b172f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9c769d956332aa10c3c46c20218f0bd", "thumbnail_srcset": "https://si.imgix.net/59d0efac/uploads/origins/d5bed763-40c1-456a-8d81-a919f7b172f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9c769d956332aa10c3c46c20218f0bd, https://si.imgix.net/59d0efac/uploads/origins/d5bed763-40c1-456a-8d81-a919f7b172f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w