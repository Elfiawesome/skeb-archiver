uploads/origins/b1543641-2ffc-4230-90d3-035b24338038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdd8a8a4507e7e1b13cb6a3bf1e112eb", "thumbnail_srcset": "https://si.imgix.net/52926222/uploads/origins/b1543641-2ffc-4230-90d3-035b24338038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdd8a8a4507e7e1b13cb6a3bf1e112eb, https://si.imgix.net/52926222/uploads/origins/b1543641-2ffc-4230-90d3-035b24338038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46317c3c8b5b2dec8b0f828eb3986554 2x, https://si.imgix.net/52926222/uploads/origins/b1543641-2ffc-4230-90d3-035b24338038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27517457918437b43a84353729a68e45 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@xx_mami_xx/works/8", "thumbnail_src": "https://si.imgix.net/975a9590/uploads/origins/c23d782b-fabf-40cb-84be-47edccd879fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34d675dbd9a3aeb4e2d859ba34f9e47d", "thumbnail_srcset": "https://si.imgix.net/975a9590/uploads/origins/c23d782b-fabf-40cb-84be-47edccd879fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34d675dbd9a3aeb4e2d859ba34f9e47d, https://si.imgix.net/975a9590/uploads/origins/c23d782b-fabf-40cb-84be-47edccd879fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a920477187aeb6176dd2dcb77deef7df 2x, https://si.imgix.net/975a9590/uploads/origins/c23d782b-fabf-40cb-84be-47edccd879fe?bg=%23fff&auto=format%2Ccompress&fm=webp