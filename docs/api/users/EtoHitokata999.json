bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f67181706550ca31115a2c0fef0c8e46, https://si.imgix.net/31236ed2/uploads/origins/21218797-c20a-42f5-b846-f474e13a423d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c725c3344c45ed649c99ed2fc76347ac 2x, https://si.imgix.net/31236ed2/uploads/origins/21218797-c20a-42f5-b846-f474e13a423d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4952d6b2313863479477fe09603ff2c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの作品とデザインの大ファンです。\n\n私のOC、エクシアの作品をお願いしたいです。以下、参考シート：\n\nhttps://imgur.com/a/ref154267-Rz6DW1X\n\n性格はクールなお姉さんで、研究者として働いています。\n\nあなたのデザインのバニースーツにうさ耳をつけた彼女を見てみたいです。白衣なども取り入れていただけるとありがたいです。\n\nポーズや表情は特にありません。\n\nお忙しい中、ご検討ありがとうございました😊。", "created_at": "", "completed_at": ""}, {"path": "/@EtoHitokata999/works/16", "thumbnail_src": "https://si.imgix.net/b2258dbf/uploads/origins/69affb16-052a-429f-bf51-4d0ab7ab4c29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14a4ab32e99c2fc74a32a2b7275ad53", "thumbnail_srcset": "https://si.imgix.net/b2258dbf/uploads/origins/69affb16-052a-429f-bf51-4d0ab7ab4c29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14a4ab32e99c2fc74a32a2b7275ad53, https://si.imgix.net/b2258dbf/uploads/origins/69affb16-052a-429f-bf51-4d0ab7ab4c29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f068482b1c83aeb2565a1560dbe96c42 2x, https://si.imgix.net/b2258dbf/uploads/origins/69affb16-052a-429f-bf51-4d0ab7ab4c29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2606e13d38a5c81c2e74a3e660ebb03 3x", "genre": "art", "nsfw": false, "body": "私はあなたの絵の表現力と色彩が本当に大好きです！\n\nVTuberのMono Monetを描いてみませんか？陽気で小生意気なレトロな雰囲気を体現している彼女に、あなたのスタイルはぴったりだと思います。\n\nポーズや表情はお任せしますが、もしアートディレクションをご希望でしたら、横顔がとても効果的だと思います。\n\n完成したら、#monomismの下に投稿します。\n\nモノのDJ衣装はURLからダウンロードできます。彼女の爪の色など、細かいデザインには特に注意してください。可能であれば、モノのマスコットである小さな青い犬も入れていただけると嬉しいです。\n\nお忙しい中、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1XPJOqIzBzsNUlDNc7TmbXYgGbn-8ymmI", "created_at": "", "completed_at": ""}, {"path": "/@EtoHitokata999/works/15", "thumbnail_src": "https://si.imgix.net/8569fd5a/uploads/origins/d8c64bbf-0eff-4e19-9ecb-79dba68ae790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1e97bf29dd1eb10f57ebde7e3ac403", "thumbnail_srcset": "https://si.imgix.net/8569fd5a/uploads/origins/d8c64bbf-0eff-4e19-9ecb-79dba68ae790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1e97bf29dd1eb10f57ebde7e3ac403, https://si.imgix.net/8569fd5a/uploads/origins/d8c64bbf-0eff-4e19-9ecb-79dba68ae790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e613c2b4193a1199ef8c5ccf949565d 2x, https://si.imgix.net/8569fd5a/uploads/origins/d8c64bbf-0eff-4e19-9ecb-79dba68ae790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23870b100ce6dfc909e046c040f7e302 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつも素敵なイラスト拝見しているので是非にとリクエストさせてもらいました！\n私のオリキャラを描いてほしいです。ポーズはおまかせします！(元気な感じで描いてもらえるとうれしいです)\n\n是非よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1pkpk2zb-fsrxPKRKJ12SB-wAsQaW8aV4", "created_at": "", "completed_at": ""}, {"path": "/@EtoHitokata999/works/14", "thumbnail_src": "https://si.imgix.net/6eca6087/uploads/origins/8d4ebbf6-a4ed-4640-9a1a-4347f859996a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f578c2ae1cdfd4c309fb16b2c7010f5e", "thumbnail_srcset": "https://si.imgix.net/6eca6087/uploads/origins/8d4ebbf6-a4ed-4640-9a1a-4347f859996a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f578c2ae1cdfd4c309fb16b2c7010f5e, https://si.imgix.net/6eca6087/uploads/origins/8d4ebbf6-a4ed-4640-9a1a-4347f859996a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=517fb4af090e635f27e67bbd8eff6b54 2x, https://si.imgix.net/6eca6087/uploads/origins/8d4ebbf6-a4ed-4640-9a1a-4347f859996a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84e0c9de6a9c39542a516dfcd66187c7 3x", "genre": "art", "nsfw": false, "body": "依頼をお願いします！\n\n内容はキッシュちゃんという猫の子をお願いします、構図等は鎖骨が見えたり口元、目元のほくろが強調されるような構図でお願いします！\n\n資料\nhttps://x.com/syuneko_otonasi/status/1552272525484523523", "created_at": "", "completed_at": ""}, {"path": "/@EtoHitokata999/works/13", "thumbnail_src": "https://si.imgix.net/7498b7bb/uploads/origins/be4f4807-a4c0-4f48-9fa3-a8bf39a64330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff9a588d8ffd5a59e96c2fdfb16922ea", "thumbnail_srcset": "https://si.imgix.net/7498b7bb/uploads/origins/be4f4807-a4c0-4f48-9fa3-a8bf39a64330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff9a588d8ffd5a59e96c2fdfb16922ea, https://si.imgix.net/7498b7bb/uploads/origins/be4f4807-a4c0-4f48-9fa3-a8bf39a64330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7db79fa85d24b7ac829df30bd849eb63 2x, https://si.imgix.net/7498b7bb/uploads/origins/be4f4807-a4c0-4f48-9fa3-a8bf39a64330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96df8bacf221bbc61cf1c252a74532ff 3x", "genre": "art", "nsfw": false, "body": "初めまして！　度々Xでお見掛けしていましたが、はっきりした線とビビッドな色遣いが大変素敵なイラストを描かれていたので、リクエストさせて頂きたいと思いリクエストを送らせて頂きます。\n\n▼描いて頂きたいイラスト\nSkebでデザイン頂いたURL先のオリジナルキャラをお願いします。\n＊以下大まかな設定\n・通名／名前：ジキタリス／伏見　狐々（ふしみ　ここ）\n・髪色：黒白のツートンカラー（左右できっちり分かれているタイプ）\n・髪型：おさげ髪。左右色違いのおさげが垂れてます。\n・瞳色：赤青のヘテロクロミア\n・スリーサイズ：デカい・細い・デカい！\n・補足：二尾。白の尾と黒の尾。\n明朗快活でテキトー気味の大体拳で解決するタイプな白黒狐になります！\n幻術も……分身とか記憶操作くらいなら……行けます！\n一人称はココ。自分の名前を言うタイプの人種だ！！\n\n＊構図等々はお任せします。アレンジも自由。\n楽しく描いて頂けるのが一番だと思うので、細かい事は気にせずうおー！　とやって下されれば！\n\nhttps://photos.app.goo.gl/5jvoMAEFdn31TZGWA", "created_at": "", "completed_at": ""}, {"path": "/@EtoHitokata999/works/12", "thumbnail_src": "https://si.imgix.net/eecd066c/uploads/origins/7a34d629-d431-4700-9bcb-baa82a5a1141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&