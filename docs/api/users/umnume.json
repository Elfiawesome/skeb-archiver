1c6-ea5cb2fa933c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1cfdfef4e21820b511f8b075dfc4473 2x, https://si.imgix.net/35ed8139/uploads/origins/2ec1358f-49af-465b-b1c6-ea5cb2fa933c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8b5d2fae4b30a675cbd55415b7cbaa2 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、うめの先生。先生の素晴らしい作品に感銘を受け、ぜひ私のOCのイラストを描いていただきたく、ご連絡いたしました。\n\nhttps://drive.google.com/drive/folders/1tk8q16Itwa3cp9DujYvotFvKMjMAm8zW\n\n彼女は見た目が18歳前後で、礼儀正しく優しく落ち着いた性格で、上品な雰囲気を持っています。白くて長い髪と、緑の瞳が特徴です。\n\n彼女に画面外の「私たち」と視線を合わせていただきたいです。また、もし可能でしたら、正面に近い角度で描いていただけると嬉しいです。\n\nhttps://skeb.jp/@umnume/works/28こちらの作品の、柔らかく淡い雰囲気がとても素敵で、大変気に入っております。\n\n何卒よろしくお願い申し上げます。不備や金額の不足等ございましたら、再送通知をしていただけると幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@umnume/works/47", "thumbnail_src": "https://si.imgix.net/a19506b3/uploads/origins/f1391ef8-ae1b-46f1-925a-9ee591878490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a236e253201255c587fd7f8c572ebd", "thumbnail_srcset": "https://si.imgix.net/a19506b3/uploads/origins/f1391ef8-ae1b-46f1-925a-9ee591878490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a236e253201255c587fd7f8c572ebd, https://si.imgix.net/a19506b3/uploads/origins/f1391ef8-ae1b-46f1-925a-9ee591878490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=470d7f8539680f212bce7049f4378ac8 2x, https://si.imgix.net/a19506b3/uploads/origins/f1391ef8-ae1b-46f1-925a-9ee591878490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=381b449ba232bff80d74acae20c9b1bb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、うめのさん！はじめまして。\n私のカップルペアのイラストをお願いしたいです。 もし金額が足りなかったり、困るような要請ならお気軽にお断りしてください！\n雰囲気や姿勢、衣装などなどは似合うように自由にお願いします。\nありがとうございます！\nhttps://drive.google.com/drive/u/0/folders/1pViSF5TJA28VKNCniWdpuSBmqfmOjxGC", "created_at": "", "completed_at": ""}, {"path": "/@umnume/works/46", "thumbnail_src": "h