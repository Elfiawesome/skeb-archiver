8-bebe-780073a51533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3d2658d1921729a8bbd0013af87de8", "thumbnail_srcset": "https://si.imgix.net/cdfe0b0c/uploads/origins/74a15769-97ae-4608-bebe-780073a51533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3d2658d1921729a8bbd0013af87de8, https://si.imgix.net/cdfe0b0c/uploads/origins/74a15769-97ae-4608-bebe-780073a51533?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ac9eb2385f7923b68f0dc804e98d460 2x, https://si.imgix.net/cdfe0b0c/uploads/origins/74a15769-97ae-4608-bebe-780073a51533?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=501a40d4967415c4d9436c8f796e2d15 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nもし宜しければ、モンスターストライクに登場するニーベルンゲン(進化前)を描いて頂きたいです！\n\n詳細は以下の通りになります\nシチュエーション：激しく性行為をした後の事後\n衣装：裸に黒のニーソックスを着用(頭の装飾はそのまま)\n表情：少し涙目になっているが、満足げな顔でうっとりしてる\n髪の毛の色は淡い黄緑色で、胸のサイズはA~Bくらい\n\n【https://skeb.jp/@rawell1963/works/41】\nこちらのイラストがとても好みだったので、同様に顔や胸の間、ニーソなど身体中に精液が付着していて、事後の余韻で潮を吹いていてシーツを濡らしている様子をお願いします\n\n以上になります！\n\nその他の点については全てお任せします\nそれではご検討の程よろしくお願いします…！\n\nhttps://drive.google.com/drive/folders/11wuBQGzZU9T0xjAmYtv-Y3k4q24vorhQ", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/49", "thumbnail_src": "https://si.imgix.net/67de4270/uploads/origins/9711108c-5161-4dfe-bf40-e175e58ed4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d0e8ad1b153274ce7f55cb15ee4035", "thumbnail_srcset": "https://si.imgix.net/67de4270/uploads/origins/9711108c-5161-4dfe-bf40-e175e58ed4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d0e8ad1b153274ce7f55cb15ee4035, https://si.imgix.net/67de4270/uploads/origins/9711108c-5161-4dfe-bf40-e175e58ed4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1d7171208b9d561188a7501fac4feef 2x, https://si.imgix.net/67de4270/uploads/origins/9711108c-5161-4dfe-bf40-e175e58ed4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcb6421910e15394f47d22a378bb600f 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nラブライブ・スーパースターのマルガレーテ・ウィーンをリクエストしたいです！\n\n彼女はちょうどディープスロートフェラチオを終えたところです。彼女の顔には精液が、口には精液が残っています。彼女の胸が見えるアングルでお願いします。\n\nキャラクター参考 - https://imgur.com/a/SSMTteu\nポーズ例 - https://imgchest.com/p/md7o96al97p\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/48", "thumbnail_src": "https://si.imgix.net/cdcde627/uploads/origins/879d7382-38ac-4ad6-a8d4-26cfd2bee847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b347fd82e1639848ddda1895bc5c6987", "thumbnail_srcset": "https://si.imgix.net/cdcde627/uploads/origins/879d7382-38ac-4ad6-a8d4-26cfd2bee847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b347fd82e1639848ddda1895bc5c6987, https://si.imgix.net/cdcde627/uploads/origins/879d7382-38ac-4ad6-a8d4-26cfd2bee847?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a5d4cc241b6c9f1b660fe994c3c704c 2x, https://si.imgix.net/cdcde627/uploads/origins/879d7382-38ac-4ad6-a8d4-26cfd2bee847?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=015362ff685c7d7b54d32fd9de8c736d 3x", "genre": "art", "nsfw": true, "body": "「僕のヒーローアカデミア」の葉隠透が、正常位で犯されて中出しされているイラストを、\n透明度違いの「完全に透明で、中に出された精液が透けて見えている」「姿が完全に見えている」「その中間」の差分の形でお願いします（レイヤーで透明度を変える形で大丈夫です）\nその他の着衣状況や背景などの設定はすべてお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/47", "thumbnail_src": "https://si.imgix.net/295c3f00/uploads/origins/156b1b53-50ce-4f86-abeb-9409beaa2aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b2d10225865c63b13884bc0880a7fb9", "thumbnail_srcset": "https://si.imgix.net/295c3f00/uploads/origins/156b1b53-50ce-4f86-abeb-9409beaa2aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b2d10225865c63b13884bc0880a7fb9, https://si.imgix.net/295c3f00/uploads/origins/156b1b53-50ce-4f86-abeb-9409beaa2aef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3065890ee8a56f5249ab8248d5cbc73 2x, https://si.imgix.net/295c3f00/uploads/origins/156b1b53-50ce-4f86-abeb-9409beaa2aef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27b5588335eed3c52fe9386f6a53d51f 3x", "genre": "art", "nsfw": true, "body": "いつも可愛くてえっちなイラストありがとうございます。\nロウェルさんの描かれる天王寺璃奈ちゃんのきょとんとした表情、程よくちっちゃいサイズ感、本当に最高です。\nもっとロウェルさんの璃奈ちゃんが見てみたいので、巫女装束姿のえっちな璃奈ちゃんを描いていただけないでしょうか？\n\n巫女装束を着ながら上半身をはだけつつ、事後のような状態で寝そべりながらぶっかけられる姿が見たいです！\n緋袴も見せてほしいので全身絵だと嬉しいです。\n\nシチュエーションはロウェルさんの描かれた\nhttps://www.pixiv.net/artworks/125061581\nhttps://www.pixiv.net/artworks/123514285\nこれらのイメージですが、よりえっちなシチュエーションがあればお任せしたいです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/46", "thumbnail_src": "https://si.imgix.net/1231cad4/uploads/origins/d93171cb-c5a1-44e2-8b8c-cc7feba8e2ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1922f00257432e6b664e91ce181bcd54", "thumbnail_srcset": "https://si.imgix.net/1231cad4/uploads/origins/d93171cb-c5a1-44e2-8b8c-cc7feba8e2ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1922f00257432e6b664e91ce181bcd54, https://si.imgix.net/1231cad4/uploads/origins/d93171cb-c5a1-44e2-8b8c-cc7feba8e2ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfb0508573e69e81b72b53783e0fb31b 2x, https://si.imgix.net/1231cad4/uploads/origins/d93171cb-c5a1-44e2-8b8c-cc7feba8e2ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7782830d411f5d94a2550ca7abdb4ca9 3x", "genre": "art", "nsfw": true, "body": "こんにちは、イラストに惹かれたので私のアバターのエロ絵を依頼したいです。\n\nアバター\nhttps://x.com/martial_trpg/status/1882750501684760903\n\n入れてほしい要素は下記のとおりです\n高校の男子トイレ(小便器)に手錠で拘束されており、事後\n男子高校生たちの精液を全身に浴びている(たくさん精液がかかってるとうれしいです)\nアへ顔、エロ蹲踞のポーズ\n服は無理やり脱がされて半裸の状態\n\n以上、お願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/45", "thumbnail_src": "https://si.imgix.net/bb6eedcb/uploads/origins/31204064-39df-4bb4-b88e-8d3421e38cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a777fc7b83fd401d66fc412de4cebeb1", "thumbnail_srcset": "https://si.imgix.net/bb6eedcb/uploads/origins/31204064-39df-4bb4-b88e-8d3421e38cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a777fc7b83fd401d66fc412de4cebeb1, https://si.imgix.net/bb6eedcb/uploads/origins/31204064-39df-4bb4-b88e-8d3421e38cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6da742b6a516be558487439a616efd1 2x, https://si.imgix.net/bb6eedcb/uploads/origins/31204064-39df-4bb4-b88e-8d3421e38cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4d1f1f9651d16a365c667c33fcd8ebd 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n「モニタリング」のミクちゃんが玄関に引き摺りこまれて朝が来るまでいっぱい出された事後、というシチュエーションで描いて頂けないでしょうか。\n詳細はお任せします。精液でぐちゃぐちゃになってるととても嬉しいです。\n\nご検討のほどよろしくお願いします。\n\n↓公式MV\nhttps://www.youtube.com/watch?v=kbNdx0yqbZE", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/44", "thumbnail_src": "https://si.imgix.net/2820db4d/uploads/origins/16c8117d-0a2b-498b-9286-67951801e701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7d3f25348e68fc0c3029bac4c3a401", "thumbnail_srcset": "https://si.imgix.net/2820db4d/uploads/origins/16c8117d-0a2b-498b-9286-67951801e701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7d3f25348e68fc0c3029bac4c3a401, https://si.imgix.net/2820db4d/uploads/origins/16c8117d-0a2b-498b-9286-67951801e701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=959d05c855f40de6e264bd02f1aca9bc 2x, https://si.imgix.net/2820db4d/uploads/origins/16c8117d-0a2b-498b-9286-67951801e701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6de490745bc6ec0cd6bcb30ddc6c59d 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n\n双葉湊音が制服のシャツ一枚のみでM字開脚をしてお○んこを広げて見せているような構図をお願いしたいです。\n\n表情はちょっと恥じらいもありながら、攻めのようなそんな表情が望ましいですが伝わりにくい表現で申し訳ありません。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/43", "thumbnail_src": "https://si.imgix.net/c8fdce64/uploads/origins/a0c45126-50e9-4aeb-84cb-b277b57a596d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c675a94eb582c5e978d0ed66ee06dd2", "thumbnail_srcset": "https://si.imgix.net/c8fdce64/uploads/origins/a0c45126-50e9-4aeb-84cb-b277b57a596d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c675a94eb582c5e978d0ed66ee06dd2, https://si.imgix.net/c8fdce64/uploads/origins/a0c45126-50e9-4aeb-84cb-b277b57a596d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=146c7c22e16eb1cafa8c8aa1a08f301f 2x, https://si.imgix.net/c8fdce64/uploads/origins/a0c45126-50e9-4aeb-84cb-b277b57a596d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e561b907144491972182ecac463163a0 3x", "genre": "art", "nsfw": true, "body": "駅メモで本日実装された、IKS.gearのリズが「マスターにフェラチオしている」イラストを、すでに射精したあとで、顔や髪が精液に汚れている感じでお願いします。\nイラストにするのはバストアップの範囲で大丈夫です、口とギザ歯を中心に描写していただけると嬉しいです。\nその他の設定（着衣状況や表情、背景など）はお任せします、描きやすさを優先していただいて大丈夫です。\n可能ならば追加で射精する瞬間の差分をお願いします。\n\nhttps://imgur.com/a/ZrWNbUz", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/42", "thumbnail_src": "https://si.imgix.net/6caa6a4a/uploads/origins/5b451da5-c681-4a79-826d-0f6924561534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8bd59c0fd2378c1081465915e48ad1c", "thumbnail_srcset": "https://si.imgix.net/6caa6a4a/uploads/origins/5b451da5-c681-4a79-826d-0f6924561534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8bd59c0fd2378c1081465915e48ad1c, https://si.imgix.net/6caa6a4a/uploads/origins/5b451da5-c681-4a79-826d-0f6924561534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a13c8d7f594dfb6511c7ff9e9be49d8 2x, https://si.imgix.net/6caa6a4a/uploads/origins/5b451da5-c681-4a79-826d-0f6924561534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1d534a76cdc632487c1ac8a574baad5 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼いたします。\n\nシチュエーション\nv_flowerちゃん（Vocaloid4版）のご奉仕フェラ\n\n詳細\n・直立した竿に顔をくっつけて竿を舌で舐めてる\n・顔にぶっかけされて恍惚とした表情をしてる\n・裸（チョーカーあり）\n・男の描写は竿周りだけでもOKです\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/41", "thumbnail_src": "https://si.imgix.net/f2c85f0a/uploads/origins/f92ff406-f120-4000-a443-9decfbcf0f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771336a7cfa4e981eb5b7584804b6551", "thumbnail_srcset": "https://si.imgix.net/f2c85f0a/uploads/origins/f92ff406-f120-4000-a443-9decfbcf0f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771336a7cfa4e981eb5b7584804b6551, https://si.imgix.net/f2c85f0a/uploads/origins/f92ff406-f120-4000-a443-9decfbcf0f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd4e9ddcb1c8686108d3fd668bd80fb9 2x, https://si.imgix.net/f2c85f0a/uploads/origins/f92ff406-f120-4000-a443-9decfbcf0f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3edf44591a346914a24a05e72e14cfb3 3x", "genre": "art", "nsfw": true, "body": "よろしければ「白聖女と黒牧師」の「セシリア」様をお願いします！！\nhttps://www.pixiv.net/artworks/103950053\n聖女様衣装資料\nhttps://x.com/TEIGI_3/status/1701317035714813972\n頭のヴェールとサイハイソックスのみの全裸の事後シチュ\nこちらの作品\nhttps://www.pixiv.net/artworks/123514285\nのような感じで精液が身体や口内に精液が付いて膣内射精済み\n性奉仕で使われまくっているけどやさしい笑顔な感じ\n\nよろしければ是非お願いします！\n\nhttps://pocket.shonenmagazine.com/episode/10834108156630546365", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/40", "thumbnail_src": "https://si.imgix.net/3afb505a/uploads/origins/4298b852-026b-4781-9c6d-134e2b9ae734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0baba71cae9d16c9d367950b8b4b454c", "thumbnail_srcset": "https://si.imgix.net/3afb505a/uploads/origins/4298b852-026b-4781-9c6d-134e2b9ae734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0baba71cae9d16c9d367950b8b4b454c, https://si.imgix.net/3afb505a/uploads/origins/4298b852-026b-4781-9c6d-134e2b9ae734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc5988498f68475e5526704fdfc0c6ce 2x, https://si.imgix.net/3afb505a/uploads/origins/4298b852-026b-4781-9c6d-134e2b9ae734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da481699acf2bd9b6895faaa53e6c015 3x", "genre": "art", "nsfw": true, "body": "いつもイラスト楽しませていただいております！\n先日投稿されていた実寸でんこイラストが非常に刺さりまして、恥を忍んでえっちイラストをリクエストします。\n\nキャラクターは駅メモ！より二見浦みえちゃん、ラッピングはハロウィンパーティー2023でお願いしたいです。要素として、以下を希望します。\n\n・細バイブ等小さめのおもちゃによる快楽責め。でんこもおもちゃも実寸大で、挿入の有無はお任せします。\n・着衣で胸の露出あり。プレイ・構図優先で適宜脱がせて大丈夫です。最低限、蝶ネクタイ風スカーフ、手袋、ソックスは残していただけると嬉しいです。\n・手錠による拘束。特にでんこが実寸大であることを活かした拘束が見てみたいですが、難しければ無視してください。細かいポーズや構図はお任せします。\n・表情は嫌々寄り。\n・サイズは横1:縦1.48(ハガキ縦横比)を希望しますが、そこまでこだわりません。\n\n資料URLは当該ラッピング画像になります。また、リプライ欄にほくろ位置の参考として別ラッピングの画像を載せています。\n\nリクエストが細かくなってしまい恐縮です。難しいものは無視していただいてかまいません。金額感や描きたいものに合わなければ却下をお願いします。\n\nご検討いただけると幸いです！\n\nhttps://x.com/kikiishiki/status/1851928664486875489?s=46&t=WKxqjGYLTr69z9Bh55BCMA", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/39", "thumbnail_src": "https://si.imgix.net/b53bb2dd/uploads/origins/61b76c8f-85e6-4d8d-8fe7-170910757ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf508ef6fddd728e977c46b252d5901b", "thumbnail_srcset": "https://si.imgix.net/b53bb2dd/uploads/origins/61b76c8f-85e6-4d8d-8fe7-170910757ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf508ef6fddd728e977c46b252d5901b, https://si.imgix.net/b53bb2dd/uploads/origins/61b76c8f-85e6-4d8d-8fe7-170910757ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=623bdf1526f9580f796d8d9dd437c815 2x, https://si.imgix.net/b53bb2dd/uploads/origins/61b76c8f-85e6-4d8d-8fe7-170910757ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fda2d5260f051badf6922c305333e5a5 3x", "genre": "art", "nsfw": true, "body": "こんにちは！Twitter(https://twitter.com/rawell1596/status/1847484745221099729)のあなたの最近の作品がとても気に入りました。同じようなシナリオで私のVtuberを描いてもらえますか？\n\nhttps://imgur.com/a/1yq6A5m", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/38", "thumbnail_src": "https://si.imgix.net/af893384/uploads/origins/ccb20cff-cda4-4e59-942b-c3cd02a62eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23deff4191b9cd1616bb09efa8ac5301", "thumbnail_srcset": "https://si.imgix.net/af893384/uploads/origins/ccb20cff-cda4-4e59-942b-c3cd02a62eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23deff4191b9cd1616bb09efa8ac5301, https://si.imgix.net/af893384/uploads/origins/ccb20cff-cda4-4e59-942b-c3cd02a62eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8def124820a6c7fc5621935cb250ebef 2x, https://si.imgix.net/af893384/uploads/origins/ccb20cff-cda4-4e59-942b-c3cd02a62eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=967f96d2de1a7b1507b44ca81356b2c3 3x", "genre": "art", "nsfw": true, "body": "Vtuber Kattarina Quitie (https://x.com/kattarina_qutie)のアートワークを依頼したいです。\nリファレンスはフォルダ（Katta3.jpeg）にあり、ポーズのリファレンスはPOSE.jpgを使ってください。ヌードバージョンで、おっぱいと口にザーメンがかかっているものをお願いします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1KJkda4KGzwfmT-3Vyr2D0rUj204_MOkH?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/37", "thumbnail_src": "https://si.imgix.net/54c5187f/uploads/origins/1d0904b7-6c0b-41a7-9492-3b47daeb10c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f022fbb7314c7cdba853b2bd4007da0", "thumbnail_srcset": "https://si.imgix.net/54c5187f/uploads/origins/1d0904b7-6c0b-41a7-9492-3b47daeb10c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f022fbb7314c7cdba853b2bd4007da0, https://si.imgix.net/54c5187f/uploads/origins/1d0904b7-6c0b-41a7-9492-3b47daeb10c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6b0c907f0e3eb7b7da79cd926652008 2x, https://si.imgix.net/54c5187f/uploads/origins/1d0904b7-6c0b-41a7-9492-3b47daeb10c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=313abd0293aba37853d921c8893da931 3x", "genre": "art", "nsfw": true, "body": "ロウェル様の描かれる口内射精やぶっかけの描写がとても癖に刺さっております\nつきましては、とある個人Vの方で以下のような作品をお願いしたくご依頼します\n\n【モデル】\n田中かなた様\n（資料URL参照、「NSFWの二次創作作品についてNG無し」である旨もそちらで確認できます）\n【概要】\n・いわゆる「ぺたん座り」の状態で、口で奉仕させた後のシーンを想定（他作者様の作品の引用で申し訳ありませんが、全体的な構図はこちらの作品がイメージに近いです：https://www.pixiv.net/artworks/63876821）\n・具体的には、上記引用作品より「やや左に回り込んだアングルで、口の中や表情を見えやすく」「事は終わっているので、ペニスは口から抜けた状態」でお願いします\n・膝の上に手を揃えて置いている状態は、同様に再現をお願いします\n【容姿・服装など】\n・資料URLの立ち絵のうち「黒のインナー、ソックス、靴（ローラーは省略可）、アクセサリー類、絆創膏類」だけを残した格好（＝下半身はほぼ裸、局部が写り込んでいるかどうかはお任せします）\n・黒インナーはずり上げられて、胸（膨らみは控えめ）も露出している\n・背後側の床/地面に有線式ピンクローターの本体が３～４台落ちており、コードがへたり込んだ腰/尻の下に伸びている（見えない部分でローターが挿入されているんだな、と想像がつけばOKです）\n【詳細なシチュエーション】\n・モデルは「目の前に立った男に、口の中の精液を見せるよう命令されている」想定で、やや上を向きながら口を大きく開けており、口内にたっぷり精液が溜まっている（男は腰から下だけ映っていればOK、アングル的に邪魔ならペニスだけ宙に浮いているような描写でもOK）\n・顔や髪、身体にも精液が飛び散っている\n・目の前に立つ男の勃起して反り返ったペニスとの間に、でろり、とまだ精液の糸が繋がっている\n・モデルは大粒の涙を浮かべながらも、「最ッ低……！」と言いたげな険しい目付きで男の顔を見上げながら睨んでいる（台詞はあくまで「表情のイメージ」です）\n・薬指に指輪をはめた左手が、精液でドロドロに汚されている（このシーンの前に「左の掌に射精された」ことを想定）\n\n見たいものをとにかく詰め込んでしまいましたが、ご検討いただければ幸いです\n（追加金額が必要であれば、再送依頼をいただければ対応します）\n\nhttps://lit.link/coreesm", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/36", "thumbnail_src": "https://si.imgix.net/bc1c36e6/uploads/origins/75121a8e-5da4-4701-a9b6-bd78a6025e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df7311c63858aa24a19640f2b1d0a626", "thumbnail_srcset": "https://si.imgix.net/bc1c36e6/uploads/origins/75121a8e-5da4-4701-a9b6-bd78a6025e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df7311c63858aa24a19640f2b1d0a626, https://si.imgix.net/bc1c36e6/uploads/origins/75121a8e-5da4-4701-a9b6-bd78a6025e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1dae11610e2cb7c4571ec52064d6a577 2x, https://si.imgix.net/bc1c36e6/uploads/origins/75121a8e-5da4-4701-a9b6-bd78a6025e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26ba75089eb0c9a345b6537061ad3279 3x", "genre": "art", "nsfw": true, "body": "ロウェル🔞様\n\n初めまして。\nMSYと申します。\n\nTwitterでイラストを拝見して、素敵なイラストを描かれる方だなと思い、今回ご連絡させていただきました。\n特にhspのイラストの表情や表現の感じがえっちで好きです。\n\n依頼させていただきたい内容といたしましては、「優越感たっぷりの表情で精液を浴びている少女を描いてほしい」ということになります。\n作成していただいたイラストの用途は個人観賞用のみです。\n\n描いていただきたい少女の参考資料として、one driveにアップロードした画像のURLを記載させていただきます（アイコンの子と同一人物です）。\n\nhttps://1drv.ms/i/s!Aj5_ir54kL0w-hRAvuAFe1mDanzE?e=Tx4t1W\n\n参考資料は描いていただいたものですが、キャラクターはオリジナルです。\n\n構図等はお任せとさせていただきたいのですが、服装は全裸よりは脱ぎかけの方がありがたいです。\n参考資料では制服ですが、そこは特にこだわりはありませんので書きやすいようにしていただいて問題ありません。\n\n以上の内容をもって依頼とさせていただきます。\nお忙しい中大変恐縮ですが、お時間のある際にご検討いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@rawell1963/works/35", "thumbnail_src": "https://si.imgix.net/3eab6324/uploads/origins/ca871098-ae51-4b96-a52f-b00949741cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeabf0751dd873eecf4164bc32b212e4", "thumbnail_srcset": "https://si.imgix.net/3eab6324/uploads/origins/ca871098-ae51-4b96-a52f-b00949741cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeabf0751dd873eecf4164bc32b212e4, https://si.imgix.net/3eab6324/uploads/origins/ca871098-ae51-4b96-a52f-b00949741cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1934bf00d4f4bc9ab01c53555e6230c 2x, https://si.imgix.net/3eab6324/uploads/origins/ca871098-ae51-4b96-a52f-b00949741cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d3701996c65fea988c343938fcf5d6e 3x", "genre": "art", "nsfw": true, "body": "結月ゆかり雫ちゃんの前の依頼（https://skeb.jp/