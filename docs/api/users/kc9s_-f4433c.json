30&txt=PRIVATE&s=a02fd7776becbaa1ff5e1e51b7591255 2x, https://si.imgix.net/54d287fb/uploads/origins/2fffb5ac-63f7-4899-a6ab-fdeef6b8efaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45475e3ce68ba990d141ec964cafc8aa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/203", "thumbnail_src": "https://si.imgix.net/5febb563/uploads/origins/c4bd5d45-40a7-4002-8f21-41ac44faf143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388f129e4987fce1ef0acf7416f96161", "thumbnail_srcset": "https://si.imgix.net/5febb563/uploads/origins/c4bd5d45-40a7-4002-8f21-41ac44faf143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388f129e4987fce1ef0acf7416f96161, https://si.imgix.net/5febb563/uploads/origins/c4bd5d45-40a7-4002-8f21-41ac44faf143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=901672aa7897aaee9cbed05322a95a13 2x, https://si.imgix.net/5febb563/uploads/origins/c4bd5d45-40a7-4002-8f21-41ac44faf143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7da75a9281f5bf7fe52c889ae8fe3d7 3x", "genre": "art", "nsfw": false, "body": "こんにちわ、以前にvtuberねきの可愛アイドル衣装イラストを描いて頂きありがとうございます。\n\n改めて今度は彼女の新衣装のY2K衣装で上着を着てない方の姿を描いて頂きたいです。\n\n立ち絵、髪型、大きさなど絵師様のお好みでお任せします。\n\nイラストに関してですがご本人様のVtuber活動での使用許可(サムネイル、Twitter等SNSでの告知画像等)\nまた可能でしたらPSDファイルで背景・サインのON/OFFができたら嬉しいです\n\n資料は彼女のホームページを参考にご検討頂けたら幸いです\n\nhttps://nekiprofile.amebaownd.com/posts/57181687", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/202", "thumbnail_src": "https://si.imgix.net/4e3752cb/uploads/origins/825a2d0b-e66e-403b-b636-7911c110bedd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e5a0c5246084b63433cf9b8da702b5", "thumbnail_srcset": "https://si.imgix.net/4e3752cb/uploads/origins/825a2d0b-e66e-403b-b636-7911