d90ed129b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f270ce1ffce92864997e7148e4af28, https://si.imgix.net/bc9cbc7e/uploads/origins/4b92b9a8-6f30-4f32-8a66-109d90ed129b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3ad882d7ca74feb20fec11112c2a0bc 2x, https://si.imgix.net/bc9cbc7e/uploads/origins/4b92b9a8-6f30-4f32-8a66-109d90ed129b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39958f64cb58bca2745a7818149e87c6 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nVtuberのゆめくい ゆんと申します。\n\nくの様の描く、表情豊かで魅力的なイラストに惹かれ、ご連絡させて頂きました。  \n\n以下依頼内容となります。  \n\n┈┈┈┈┈┈┈┈┈┈\n\n  ・ゆめをたべるバクのVtuberゆめくいゆんの縦型一枚絵\n・ジムもしくはお家で、トレーニング後の休憩中の様子を描いて頂きたいです。\n(タオルで汗をぬぐっているイメージ)\n・服装はスポーツウェア\n・元気で可愛らしいイメージでありつつも、少しセクシーな表情になると嬉しいです。\n・可能であれば表情差分があると嬉しいです。\n\n 【お願い】 \n・サムネイルに使用させて頂きたいため耳や、髪の毛などが見切れない構図でお願いしたいです。\n・背景やサインなど描いていただける場合は、PSDでレイヤーを分けて納品して頂けますと幸いです。\n\n 【使用用途】 \n・SNSでの使用\n・収益化済のYouTubeのサムネイル\n・可能であれば、グッズなど商用利用の使用許可をいただきたいです。\n難しい場所は別途レイヤーにて記載していただけますと幸いです。\n\n【資料】\n立ち絵や三面図資料がのっているリンクになります。\n\nhttps://ci-en.net/creator/12320/article/1014815\n\n・新衣装(バクの姿)で描いて頂きたいです。\n・八重歯があります。\n・左足の内ももにホクロがあります。\nお忙しい中恐縮ですがご検討の程、よろしくお願いいたします。\n\nhttps://ci-en.net/creator/12320/article/1014815", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/191", "thumbnail_src": "https://si.imgix.net/abb351e1/uploads/origins/8ff49a4a-b29c-4299-a8c2-db2ce1628d62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7cabb5caf953591308039d318e782a4", "thumbnail_srcset": "https://si.imgix.net/abb351e1/uploads/origins/8ff49a4a-b29c-4299-a8c2-db2ce1628d62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7cabb5caf953591308039d318e782a4, https://si.imgix.net/abb351e1/uploads/origins/8ff49a4a-b29c-4299-a8c2-db2ce1628d62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e866a7a05cf7aa43be25c5940d12f37 2x, https://si.imgix.net/abb351e1/uploads/origins/8ff49a4a-b29c-4299-a8c2-db2ce1628d62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f33a7f0e3b4bce089c39880ae718261e 3x", "genre": "art", "nsfw": false, "body": "くの先生いつもお世話になっております、あおです！初めてくの先生のFAを見た時からずっとファンで、いつかSkebでご依頼したいと思っておりました！今回自分へのご褒美として、セルフ誕生日プレゼントみたいな感じで先生にSkeb依頼受けていただければ嬉しいです！！\n\n・リクエスト\nもちろん推しの大空スバルさんを新アイドル衣装でお願いしたいです！\n構図に関しては添付のギガファイル便にスクショを入れておりますのでそちらを参考にしていただければと思います。しかしながら、もし先生の方でこの向き、このアングルの方がスバルさんが輝く！という構図があればそちらを優先して頂いて問題ありません！！よろしければ簡単な表情差分なども描いていただけると幸いです！そちらも参考表情をギガファイル便に添付しております。付随して、「あおさん誕生日おめでとう！」とひとこと書いていただければとても嬉しいです…！\n後述しますがスマホの壁紙にしたいので別ファイルで9:21のサイズ比で描いて頂けると現在使用しているスマホの壁紙にしやすいです。\n\n・構図、表情\n参考資料\n(https://photos.app.goo.gl/EG7mj6FzkAmdSAqQ6)\n\n・使用用途\n個人での鑑賞、スマホの壁紙、印刷してお届け機能を活用してタペストリーにし部屋に飾る等\n\n初めての依頼で拙い部分ばかりだと思いますが何卒ご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/190", "thumbnail_src": "https://si.imgix.net/b87a0148/uploads/origins/36b96d42-367a-47cd-936d-2766c9aa51ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ff3c464e212bb60d933d937e6e42cf9", "thumbnail_srcset": "https://si.imgix.net/b87a0148/uploads/origins/36b96d42-367a-47cd-936d-2766c9aa51ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ff3c464e212bb60d933d937e6e42cf9, https://si.imgix.net/b87a0148/uploads/origins/36b96d42-367a-47cd-936d-2766c9aa51ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ca916ff2bbd91a7c30b7f188a970c2a 2x, https://si.imgix.net/b87a0148/uploads/origins/36b96d42-367a-47cd-936d-2766c9aa51ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8b0e5659b09dba5985a4712e67a3a07 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/189", "thumbnail_src": "https://si.imgix.net/fb4c3623/uploads/origins/2cf0f713-0025-42fc-b590-992d733c5495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1039ceb306b3ff4fa4a5ec27fd3fa3", "thumbnail_srcset": "https://si.imgix.net/fb4c3623/uploads/origins/2cf0f713-0025-42fc-b590-992d733c5495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1039ceb306b3ff4fa4a5ec27fd3fa3, https://si.imgix.net/fb4c3623/uploads/origins/2cf0f713-0025-42fc-b590-992d733c5495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fa7c6572c723b88a1b214a0c62c11ce 2x, https://si.imgix.net/fb4c3623/uploads/origins/2cf0f713-0025-42fc-b590-992d733c5495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21e3c37d1245b25aafb25d33a6ec6305 3x", "genre": "art", "nsfw": false, "body": "くの🌸様\n\nはじめまして。\n個人VTuberの桃彩ぷどると申します。\n いつも素敵なイラストを拝見しております。\nくの🌸様が描かれる表情やむちむち感がどタイプでしてぜひ私も描いていただきたいと思いリクエスト送らせて頂きました。\n\n○要望 \n私、桃彩ぷどるのイラストをお願いいたします。\n食べることが好きなので、食べ過ぎて少しむちっとしてきたかな？と気にしているような構図が希望です。\nもし可能であれば、表情差分も何点かあると嬉しいです！\n\n髪型や衣装はそのままでもおまかせでも大丈夫です。\nケモ耳の有無やポーズはおまかせいたします。\nサムネイルでの使用も考えているため、頭頂部や髪の毛の先が見切れていないと有難いです。\n\n※可能であれば、人物の透過もいただきたくPSDデータですと大変ありがたいです！   \n\n○使用用途  \n・XなどのSNSや収益化済みのYOUTUBEチャンネルのサムネイルや動画内使用\n ・可能であればネットプリントや、ファンボックスなどの有料サイトでの使用   \n・グッズ利用\n\n使用不可などありましたら別途レイヤーに記載してくださいますと幸いです。\n\n○キャラクターについて\nトイプードルとカット桃がモチーフの女の子です。トイプードル2匹と一緒に暮らしています。\n前髪には2色のメッシュと後ろ髪はピンク→黄色→赤の桃グラデーションになっております。\n瞳は全体的に緑色で、赤・青・黄の色が入っております。\n正面から見て右側に八重歯があります。\n\nご検討の程どうぞよろしくお願いいたします。\n\n桃彩ぷどる  https://twitter.com/pudoru_\n\nhttps://drive.google.com/drive/folders/1ka1GVtWXiO6AdBtcCoCoVnlBmTwdMkIt", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/188", "thumbnail_src": "https://si.imgix.net/6974aee6/uploads/origins/c3788fed-c262-4578-83ae-f32733681a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99665904016d4048cf279b8bb46e3a0c", "thumbnail_srcset": "https://si.imgix.net/6974aee6/uploads/origins/c3788fed-c262-4578-83ae-f32733681a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99665904016d4048cf279b8bb46e3a0c, https://si.imgix.net/6974aee6/uploads/origins/c3788fed-c262-4578-83ae-f32733681a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1be6ee3548b33c22d4d83140a64b491 2x, https://si.imgix.net/6974aee6/uploads/origins/c3788fed-c262-4578-83ae-f32733681a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1430c899aefa8c9738451b1b013b23ea 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは！！イラストが素敵で是非リクエストをさせて頂きたいです。\n\nわたし「天野寧々」を描いていただきたいです。\nhttps://twitter.com/amanene_kawaii/status/1493821515342573569\n水着姿で描いて頂きたいです。ビキニや競泳水着、先生の好きなように書いて大丈夫です。\n\n使用はSNSのサムネ、バナー、およびYouTubeのサムネとして使用させて頂きたいです。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1f7wrJMXmnzDexAIITPqgzBpr4CGpFgcw?usp=", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/187", "thumbnail_src": "https://si.imgix.net/b8a2a378/uploads/origins/ecf9a910-d920-46dc-8bc5-1a52b0438a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43ac1641f91311216451d95fcd212d8f", "thumbnail_srcset": "https://si.imgix.net/b8a2a378/uploads/origins/ecf9a910-d920-46dc-8bc5-1a52b0438a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43ac1641f91311216451d95fcd212d8f, https://si.imgix.net/b8a2a378/uploads/origins/ecf9a910-d920-46dc-8bc5-1a52b0438a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=502fec9102c73d805ae8ae3b83d3d8ef 2x, https://si.imgix.net/b8a2a378/uploads/origins/ecf9a910-d920-46dc-8bc5-1a52b0438a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03d8ed114d5792b207587e8fc4bb7cd4 3x", "genre": "art", "nsfw": false, "body": "はじめまして！VTuberの「魔女っ子めいみ」です。先生の水着イラストを見て、依頼することにした。\n私のVtuberに水着の衣装をお願いしたいのですが。小生意気な表情のイラストの描き方は、めいみにも似合うと思った。\nhttps://skeb.jp/@kc9s_/works/179\n\nめいみは修行中の魔女です。大きな帽子をかぶると167cmですが、かぶっていないともっと低いです(~151cm)。明るくて、生意気で、やんちゃだけど、ちょっとツンデレ。水晶玉、タロットカード、アイドルが好き。\n彼女に似合いそうな、ガーリーで魅力的な水着を自由にデザインしてみよう。個人的には、ツーピース水着のこのスタイルが好きだ。また、海でインナーチューブを使ったり、インナーチューブを使って楽しそうに泳いだり、水遊びをしている姿も描いてくれたら嬉しい。好きな色は薄紫、ミント、青、緑。\nhttps://gamepress.gg/arknights/news/arknights-cn-eyjafjalla-summer-skin-art-and-animations\nhttps://x.com/misyune12/status/1693899346889363825\nhttps://gbf.wiki/Ferry_%28Summer%29\n\nサムネイルなどにも使用させていただきたく、よろしければ頭頂部や髪の毛先・上半身などは先が切れないよう描いて頂けますと嬉しいです。\nキャラクターのみ透過でも利用できるよう、psd形式、もしくは透過PNGでキャラクターだけのものも頂けますと幸いです。\n\nありがとうございました！\n\nhttps://twitter.com/Meimi_kawaii/status/1764198387442753867\n\nhttps://drive.google.com/drive/folders/1zIp0LugO18GN3KN5U0lBCHHZp0SvEx_O?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/186", "thumbnail_src": "https://si.imgix.net/1afc37fc/uploads/origins/b9768e6e-0557-45b0-948e-ba02960c9b38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b261a602feb6d515c1701b4ef3a2e82", "thumbnail_srcset": "https://si.imgix.net/1afc37fc/uploads/origins/b9768e6e-0557-45b0-948e-ba02960c9b38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b261a602feb6d515c1701b4ef3a2e82, https://si.imgix.net/1afc37fc/uploads/origins/b9768e6e-0557-45b0-948e-ba02960c9b38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02bbb0e0043d666bb8f5e3a4a1e17465 2x, https://si.imgix.net/1afc37fc/uploads/origins/b9768e6e-0557-45b0-948e-ba02960c9b38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13086c170ea78b6f7b4fcfd946617c70 3x", "genre": "art", "nsfw": false, "body": "くの🌸様、新人Vちあももこです！\nリクエストで描かれている《マリア・アムネア》さんのイラストが素敵すぎて、私もぜひお願いしたい‼︎と思いました。\n\n【使用用途】\n・配信活動用\n　投稿先：YouTubeがメインで、Ci-en,Fantiaなどへの投稿やグッズ使用の可能性もあり。\n・他、X等、SNSへの投稿\n・動画内でLive２Dを使用して動かす可能性があります。\n\n【キャラクター】\n自身のVtuberキャラ、「ちあももこ」をお願いします。\n目の中に逆♡の桃が入っているのが特徴です。\nキャラクターの顔、髪型、服装などの参考になる資料をGoogleドライブにアップしました。\n\n複数のデータが入っていますが、「ちあももこ🍑キービジュ縮小」を参考にして頂ければ幸いです。目の中の桃は「ちあももこ顔アップ」がわかりやすいと思います。\n\n【サイズ・仕様】\n縦長3,464 × 2,480pxでいただけますと、グッズ作成もできるので嬉しいです！\n人物と背景、サイン等のレイヤーを分けた背景透過PNGデータで納品頂けるとありがたいです。（あればPSDデータも）\n\n【構図・背景】\nHoneyWorksさんの「メイド☆至上主義」歌ってみたやメイドの日の投稿などに使わせて頂くメイドさんイラストをお願いしたいです。\n\n衣装のデザインはGoogleドライブ内の「メイド服デザイン参考画像」でお願いしたいです。（細かい部分は省いてもOKです）\n髪型や頭のリボン、首のチョーカー、手首のリストバンドとブレスレットは「ちあももこ」のものをつけて頂きたいです。（猫耳カチューシャはつけて欲しいです）\n\n露出が少ない衣装なので、お胸は大きめに描いていただけるとありがたいです。\n\n手でハートを作っているポーズで、太ももくらいまで欲しいです。\nシルエットも利用したいので、ハートは体の外に出ていると嬉しいです。\n\nもし可能であれば表情差分をお願いしたくて、\n①口も目も閉じて満面のにっこり\n②ウインクで口を開けた笑顔\n③両目を開けてちゅ♡と口を尖らせたキス顔\nの3パターンを、同じポーズでOKなのでいただけるとありがたいです。\n\nサムネイルに使用しやすいように【上、左右】は人物が見切れないように描いていただけるとありがたいです。\n\nどうぞよろしくお願いいたします。ご縁がありますように。\n\nhttps://drive.google.com/drive/u/0/folders/1Z0oenXLDIhbI9VF2Yk_xGlwbvkMs6MSf", "created_at": "", "completed_at": ""}, {"path": "/@kc9s_/works/185", "thumbnail_src": "https://si.imgix.net/c18a4ea7/uploads/origins/ba483b9c-4fb2-435f-82c8-102553d8f21c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=500821384241e6115734a46a87c56ba9", "thumbnail_srcset": "https://si.imgix.net/c18a4ea7/uploads/origins/ba483b9c-4fb2-435f-82c8-102553d8f21c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=500821384241e6115734a46a87c56ba9, https://si.imgix.net/c18a4ea7/uploads/origins/ba483b9c-4fb2-435f-82c8-102553d8f21c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e28ea49a2d84e5205ef06d02cc6f66b 2x, https://si.imgix.net/c18a4ea7/uploads/origins/ba483b9c-4fb2-435f-82c8-102553d8f21c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78896b3d06bdc13c3085e387f6cea836 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}