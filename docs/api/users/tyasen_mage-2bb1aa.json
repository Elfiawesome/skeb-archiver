5c-4dba-b7f7-e5b0e950dc77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f0dea851e51e7b9bc84183bb71baa91 2x, https://si.imgix.net/0c9f3cbf/uploads/origins/19e4478f-a55c-4dba-b7f7-e5b0e950dc77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21d2df257a83f2883632e0eb8aa0cf06 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\n今回は、以前Skebで茶筅髷先生に陰毛図鑑にしていただいたウチの子、しつじちゃんとひめきしちゃん二人のイラストをお願いします。\n\nお風呂場でしつじちゃんがひめきしちゃんの陰毛のお手入れをしているシーンです。\n二人とも全裸\nお風呂場で脚を開いて座り込んだひめきしちゃんの股間部にカミソリを持ったしつじちゃんが顔を近づけて剃毛しようとしている\n「おひいさま、今日こそアナル周りもお手入れしましょう」\n「あ、貴女こそ自分もアンダーヘアのお手入れをするクセを付けなさいな」\nと軽く掛け合いを入れてください\n\nひめきしちゃんは恥ずかしがりながらも、お互いにラブラブな百合ップルです。\n\nhttps://skeb.jp/@Honokitiliver/works/52", "created_at": "", "completed_at": ""}, {"path": "/@tyasen_mage/works/35", "thumbnail_src": "https://si.imgix.net/b07d5306/uploads/origins/95a1d510-254c-4685-9380-cb621c5ec86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca6718d21d78270b7194d0c8c76d72d2", "thumbnail_srcset": "https://si.imgix.net/b07d5306/uploads/origins/95a1d510-254c-4685-9380-cb621c5ec86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca6718d21d78270b7194d0c8c76d72d2, https://si.imgix.net/b07d5306/uploads/origins/95a1d510-254c-4685-9380-cb621c5ec86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65529c9ee298614b21b558d937e31b27 2x, https://si.imgix.net/b07d5306/uploads/origins/95a1d510-254c-4685-9380-cb621c5ec86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c862defe8a723ea301309624961e856 3x", "genre": "art", "nsfw": true, "body": "是非先生に描いて頂きたいと思い依頼しました。\n内容は捕虜にされた艦これの北上、大井、木曾（改二）の三人が捕虜収容所で慰み者にされてる感じです。\n・三人は枷で首と手を固定されて並べられてる状態で立ちバックで犯されている\n・竿役は人型の深海棲艦のオス\n・服装は三人とも全裸で乳首にはピアス（可能であればそれを繋ぐチェーンの様なもの有）\n・表情としては北上は泣きながら嬌声をあげている感じで、大井は相手に向かって罵声を浴びせている感じ、木曾は歯を食いしばって耐えている感じで\n・アングルは若干斜め前ぐらいの感じで手前から木曾、大井、北上の並び順\n・差分に全身ドロドロで口にも出された跡や抜けた陰毛有の方も…", "created_at": "", "completed_at": ""}, {"path": "/@tyasen_mage/works/34", "thumbnail_src": "https://si.imgix.net/13c40ac6/uploads/origins/4cff748b-2b7c-432c-a098-e935bda39db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e2a589d49cac6344e2a26be295557e5", "thumbnail_srcset": "https://si.imgix.net/13c40ac6/uploads/origins/4cff748b-2b7c-432c-a098-e935bda39db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e2a589d49cac6344e2a26be295557e5, https://si.imgix.net/13c40ac6/uploads/origins/4cff748b-2b7c-432c-a098-e935bda39db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=852f1a522bad72bea11dee6ca6fde6ad 2x, https://si.imgix.net/13c40ac6/uploads/origins/4cff748b-2b7c-432c-a098-e935bda39db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b33c17e76f66a34e8ea8cbfe4f98ff77 3x", "genre": "art", "nsfw": true, "body": "前回の作品も最高でした。同じくToLoveるから九条凛ちゃんをお願いしたいです。今回も黒ハイソックスで脚先まで全身が入る構図だと嬉しいです。陰毛は濃いめでデカクリ、アナルは毛が生えたピンク、乳首は小さめのピンク色だと嬉しいです。竹刀でのオナニーで処女喪失してしまった設定を説明に入れて頂けると嬉しいです。\nもし可能であれば、陰毛撮影中に泣きながらお漏らししてしまっている差分があると嬉しいです（無理であれば差分なしで結構です）\nもしよろしければ、よろしくお願いします。\n\nhttps://skeb.jp/@tyasen_mage/works/26", "created_at": "", "completed_at": ""}, {"path": "/@tyasen_mage/works/33", "thumbnail_src": "https://si.imgix.net/95fd8fe8/uploads/origins/d040ef01-ac86-4c50-ad7c-a7eb1b3d88ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae9d1330e91dcaf1b6fcf7a6dc20458a", "thumbnail_srcset": "https://si.imgix.net/95fd8fe8/uploads/origins/d040ef01-ac86-4c50-ad7c-a7eb1b3d88ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae9d1330e91dcaf1b6fcf7a6dc20458a, https://si.imgix.net/95fd8fe8/uploads/origins/d040ef01-ac86-4c50-ad7c-a7eb1b3d88ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=