e-4b42-9b16-39bf2171bc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e67215f07608043598902b6e7f0123c", "thumbnail_srcset": "https://si.imgix.net/eea153a1/uploads/origins/b088cd1e-d07e-4b42-9b16-39bf2171bc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e67215f07608043598902b6e7f0123c, https://si.imgix.net/eea153a1/uploads/origins/b088cd1e-d07e-4b42-9b16-39bf2171bc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae8f1d254904427c6da0250fcc092d78 2x, https://si.imgix.net/eea153a1/uploads/origins/b088cd1e-d07e-4b42-9b16-39bf2171bc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e23052b9adee49ad953fcbf98196550b 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します！\n私のオリジナルキャラクターの作品をお願いしたいです。\n\n▼下記リンク先にある、「創作B」フォルダ内のふたり\nhttps://drive.google.com/drive/folders/1DSygT6scoU-deX8KSlVrdfeI8fJ6jT4c\n\n▼内容など\nシチュエーションなどのある絵だと嬉しいですが、すべておまかせします！\n\n▼他\nキャラクター以外のものが別レイヤーに分けてある状態の、psdファイルでの納品を希望します。\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。\n納品された作品はSNSのアイコンやヘッダーに使用させていただくことがあります。\nまた、自分用のグッズを作ったり他の方への依頼の際に資料として使用させていただくことがあります。\n\n依頼内容になにか問題があれば再送要請してください。難しければキャンセルして大丈夫です。\nどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/7", "thumbnail_src": "https://si.imgix.net/75d78939/uploads/origins/f830a458-364f-4f71-8e0b-1e34e7fe7e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbc0768d55da20b458c041a6f1326f86", "thumbnail_srcset": "https://si.imgix.net/75d78939/uploads/origins/f830a458-364f-4f71-8e0b-1e34e7fe7e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbc0768d55da20b458c041a6f1326f86, https://si.imgix.net/75d78939/uploads/origins/f830a458-364f-4f71-8e0b-1e34e7fe7e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d875b4e29d68a21166015a0951533be1 2x, https://si.imgix.net/75d78939/uploads/origins/f830a458-364f-4f71-8e0b-1e34e7fe7e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83803c68b938f1909bc03e32310ea584 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/6", "thumbnail_src": "https://si.imgix.net/4fbf115c/uploads/origins/859f33fe-0468-4768-b54e-e3d87fc70491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9626156248dbd0370546a6e07ae6234b", "thumbnail_srcset": "https://si.imgix.net/4fbf115c/uploads/origins/859f33fe-0468-4768-b54e-e3d87fc70491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9626156248dbd0370546a6e07ae6234b, https://si.imgix.net/4fbf115c/uploads/origins/859f33fe-0468-4768-b54e-e3d87fc70491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9826638ffab1bcdab0cba6109c77969a 2x, https://si.imgix.net/4fbf115c/uploads/origins/859f33fe-0468-4768-b54e-e3d87fc70491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75c3af071f86e0fea9d260d1ab3320ba 3x", "genre": "art", "nsfw": false, "body": "コーブドリ様、はじめまして！ツイッターでイラストを楽しく拝見させて頂きました。素敵な絵柄に惹かれて、可能ならば自キャラを依頼したいと思っております。\n\n【依頼内容】\nキャラ参照は下記のURLをご覧ください。南東アジアの様なトロピカル島国に旅をしていて、凸凹コンビで親友家族相棒という関係性のお2人です。一緒に未知か禁じられた廃墟や遺跡を探索している、所謂トゥームレイダーの様な存在です。褐色肌の子は明るくてお喋りなタイプ、黒髪の子は不器用でクールな性格で、相手より背が7cm高い。対照的な2人ですが、「一緒にいれば自分の世界はどんどん広がっていく」様な親しい仲です。\n\n【テーマ】\n・「冒険・旅」のテーマの一枚をお願い致します。一緒にキャンプするか、廃墟や自然を探索するか、旅先を決めようとしているか、シチュエーションは何でも構いません。\n・新しい世界に訪れて色んな不思議なものと人々を触れて、そういう楽しい雰囲気をお願い致します。\n・「トロピカル、夏、遺跡、夜明け・夕焼け、地平線」のモチーフを、どちらでもご自由に使って大丈夫です。\n・ポーズや構図は何でも構いませんので、コーブドリ様にお任せ致します。お気軽に描いてください！\n\n依頼内容に何か難しい点か問題点があれば、是非この依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://sta.sh/22ag5l1wab16", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/5", "thumbnail_src": "https://si.imgix.net/db6c9119/uploads/origins/1f83606a-d709-4864-8f1a-cf1d35abe528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34cee19c467ec4c042f06358b51fb93f", "thumbnail_srcset": "https://si.imgix.net/db6c9119/uploads/origins/1f83606a-d709-4864-8f1a-cf1d35abe528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34cee19c467ec4c042f06358b51fb93f, https://si.imgix.net/db6c9119/uploads/origins/1f83606a-d709-4864-8f1a-cf1d35abe528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44a8cd4d3f701912d332d65bbc01c4dc 2x, https://si.imgix.net/db6c9119/uploads/origins/1f83606a-d709-4864-8f1a-cf1d35abe528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b846e41b1cebcfd39793cf0e93fa86e7 3x", "genre": "art", "nsfw": false, "body": "Hello! I want to get a drawing of my vtuber model! Her name is Kumomo and she is a shrine maiden during the day and an assassins during the night. \n\nI’d love to get a drawing of her on the way to assassinate someone during the night. I would like her to have her kimono off and have her hair flowing in the wind while standing on the roof of a Japanese house. I would like her shiba inu to be standing next to her too!\n\nI want to use it on my twitch and twitter but I will give appropriate credit\n\nThank you!\n\nhttps://drive.google.com/drive/folders/1suU2n0zjrkrjMJQllDryYL8NWMwjiccG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/4", "thumbnail_src": "https://si.imgix.net/7d77a4b1/uploads/origins/393108af-c40c-405b-a286-cea5d55d058c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe6f91e202ee7120d436fb6957a4ef4c", "thumbnail_srcset": "https://si.imgix.net/7d77a4b1/uploads/origins/393108af-c40c-405b-a286-cea5d55d058c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe6f91e202ee7120d436fb6957a4ef4c, https://si.imgix.net/7d77a4b1/uploads/origins/393108af-c40c-405b-a286-cea5d55d058c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e52486226f76bfe88597c6fda38e9da0 2x, https://si.imgix.net/7d77a4b1/uploads/origins/393108af-c40c-405b-a286-cea5d55d058c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1af8cb081c68cd8f4547aff5a1fdd190 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n\n｢Ar:pieL」という作品の｢ハンナ・カルティア｣というキャラクターをお願いしたいです。\nマイナーな作品のリクエストとなりますが、お暇がおありでしたらぜひお願いいたします。\n\n背景や植物、自然な感じがとても印象深いので、当リクエストでもそんな雰囲気の物をお願いしていいでしょうか？\n参考資料のハンナを見て、何かピンとくるようなインスピレーションがありましたらそちらを優先して描いて頂ければ幸いです。\nもし特に浮かばなければ\"暑い夏が過ぎて、秋の涼しい風を感じるハンナ\"そんなイメージのものをお願いできたらと思っています。\nAr:pieLの世界の背景資料はこんな感じになります。\n【https://drive.google.com/drive/folders/10N3fwWV8j6bFnLntRC-K4mBzejTHzCOa?usp=sharing】\nが、こちらもまた特に制限はなく他の世界等からイメージを持ってきていただいて構いません。\n\nハンナのコスチュームは参考資料「ハンナ資料」の「A(アルピエル学園指定制服)」でお願いします。\n\n以上になります。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10KkoXCpOE4lLmQkxDsburSyGiEgIS_AY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/3", "thumbnail_src": "https://si.imgix.net/4bd34d6b/uploads/origins/d14dfae5-2766-4820-b9d9-8c432e9e836b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=119be13d92a67bfbf2f120d4fa1f35e3", "thumbnail_srcset": "https://si.imgix.net/4bd34d6b/uploads/origins/d14dfae5-2766-4820-b9d9-8c432e9e836b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=119be13d92a67bfbf2f120d4fa1f35e3, https://si.imgix.net/4bd34d6b/uploads/origins/d14dfae5-2766-4820-b9d9-8c432e9e836b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c356122f156c60602272860afa54f94e 2x, https://si.imgix.net/4bd34d6b/uploads/origins/d14dfae5-2766-4820-b9d9-8c432e9e836b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87ad60bbfb77be0d885cb8926f3016a2 3x", "genre": "art", "nsfw": false, "body": "Hello i saw your art and its beautiful and i wanted to request a artwork of my Neko OC Maya in a Office lady outfit and her black head ribbon, sitting infront of a table and eating Sushi while looking at her phone with a happy expression. for the rest i let you decide.\n\nOC Reference : https://imgur.com/a/h9NJP6n\nPose / Outfit Reference : https://imgur.com/a/ZW3WMOh\n\nThank you so much and have a nice day!", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/2", "thumbnail_src": "https://si.imgix.net/267319dd/uploads/origins/c50fb13e-68b1-487c-9d59-46d186d6ca6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fe4a4b5dcbee5696d502f2c411bf6c", "thumbnail_srcset": "https://si.imgix.net/267319dd/uploads/origins/c50fb13e-68b1-487c-9d59-46d186d6ca6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fe4a4b5dcbee5696d502f2c411bf6c, https://si.imgix.net/267319dd/uploads/origins/c50fb13e-68b1-487c-9d59-46d186d6ca6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8adf413b3fc329cd279de1fc099706eb 2x, https://si.imgix.net/267319dd/uploads/origins/c50fb13e-68b1-487c-9d59-46d186d6ca6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4951ef0017274bc7e11433e095d6da4 3x", "genre": "art", "nsfw": false, "body": "初めまして、Sinatakaと申します。\nSkebの新着一覧で拝見した\nコーブドリ様のイラストから\n感じたリアルな食事風景と\nキャラクターの生き生きとした\n魅力的な表情に心惹かれ、今回\nリクエスト申請させて頂きました。\n\n【要望】\n私が\"VRChat\"というゲームで\n使用しているアバター２人を\n描いていただきたいです。\n\nPCの壁紙として使用したいと\n思っていますので、作品のサイズは\n1920×1080程度でお願いします。\n\n構図やポーズはお任せしたいのですが、\n設定としてはアイリッシュパブで\n美味しいご飯とお酒を楽しんでいる\nイメージでお願いします。\n\nまた、もし可能でしたらコーブドリ様の\nサイン入り・サイン無し画像を\n差分として入れて頂けると幸いです。\n　\n【参考資料】\n資料URLに\"ME_Rabisipu\"と\"Karukia_TC\"という\nフォルダ名で各アバターの情報を記載しております。\n（Karukia_TCの方が酒豪のイメージです。）\n　\n【使用用途】\n頂いたイラストはSNSアイコンへの使用や、\nタペストリー等のグッズを作成し\n個人でのみ使用したり、ゲーム内の\n自宅Worldに飾りたいと思っています。\n　\nお忙しいところ恐縮ですが、\n是非よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1hJS4wYkyuHmf5qfBTE1FACBtxNK8Q-Ia?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@___0shir0/works/1", "thumbnail_src": "https://si.imgix.net/ddc504b3/uploads/origins/f58566d0-8370-4428-a02e-c04286a6ff5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a15f96bae403e13fe7bde321928fcb", "thumbnail_srcset": "https://si.imgix.net/ddc504b3/uploads/origins/f58566d0-8370-4428-a02e-c04286a6ff5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a15f96bae403e13fe7bde321928fcb, https://si.imgix.net/ddc504b3/uploads/origins/f58566d0-8370-4428-a02e-c04286a6ff5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00db0d54acfee9047df331bc738f40c4 2x, https://si.imgix.net/ddc504b3/uploads/origins/f58566d0-8370-4428-a02e-c04286a6ff5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=565dcc68c262d7eaa89192bce37fe611 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\n私のオリジナルキャラクターの絵を描いていただきたいです。\nhttps://imgur.com/a/fB3q1Zz\n\nなにかシチュエーションや世界観などが感じられる絵ですと嬉しいですが、基本的に全ておまかせします。\n特に設定などがあるキャラクターではないので、資料にある表情や関係性的なものは無視していただいても構いません。\nなにをさせても・どんな表情でも大丈夫です。仲良くしてたり殺伐としてたりなんでもどうぞ。\n\nキャラクター単体のみが見れるようなレイヤー構成のファイルをもらえると嬉しいです。\n納品された絵はSNSのアイコン、ヘッダーなどに使わせていただくことがあります。\nなにか問題などあればお気軽にキャンセルしてください。\nもし大丈夫であればぜひよろしくお願いします。", "created_at": "", "completed_at": ""}]}