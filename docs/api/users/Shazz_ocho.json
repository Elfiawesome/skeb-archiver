7-bcbd-ef8fad4ab22c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8aadd5569a036d1a629e5aca254ea09f 2x, https://si.imgix.net/b4a74493/uploads/origins/6b70bf69-fea2-4e57-bcbd-ef8fad4ab22c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd531bdfa45f22a1ea946ddcc3ba537d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVtuberキャラクター、ワオの絵をお願いします！彼女はオレンジが大好きで、羽がないセクシーだけど無邪気な妖精です。彼女のデザインで重要なのは、瞳の中に小さなオレンジがあることです。\n\n作品は私のSNS（@waomeoVT）にアップロードし、Twitchで公開する予定です！もし可能であれば、背景と署名のあるファイルとないファイルを分けていただけると嬉しいです。ありがとうございました！\n\nこれが彼女のリファレンスです：\nhttps://drive.google.com/drive/folders/1ij3oLgOolWXAY-aCB8hD1kBZVBW8QjGz?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Shazz_ocho/works/1", "thumbnail_src": "https://si.imgix.net/0509a1cb/uploads/origins/a365b7c9-a26a-4ee3-89cb-dc1b55e162d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bfeccc73de83862fa0dd4335cda97be", "thumbnail_srcset": "https://si.imgix.net/0509a1cb/uploads/origins/a365b7c9-a26a-4ee3-89cb-dc1b55e162d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bfeccc73de83862fa0dd4335cda97be, https://si.imgix.net/0509a1cb/uploads/origins/a365b7c9-a26a-4ee3-89cb-dc1b55e162d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fa9a861d3bc6071041b9a07fdfee913 2x, https://si.imgix.net/0509a1cb/uploads/origins/a365b7c9-a26a-4ee3-89cb-dc1b55e162d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29353f8b34f6e70ade0dc4d392934b3a 3x", "genre": "art", "nsfw": false, "body": "初めまして、今回イラストを描いていただきたくリクエストを送りました。\n\n依頼したいイラストの内容なのですが、ブルーアーカイブの歌住サクラコ(通常衣装)の絆100を達成したので記念イラストをお願いしてもいいでしょうか？ツイッター、PIXIVでおこさんが描いたサクラコのイラストを見て気に入ったものでして。\n\n構図なのですが、絆100に上げるときに贈り物で美しい花束(赤色の花束)を送ったのでそれを持たせた構図でお願いします。\n\nイラストの依頼はこれが初めてで勝手がわからないので細かいところはお任せでもいいでしょうか。\n\nそれでは検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}]}