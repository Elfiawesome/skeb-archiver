ださい。長いポニーテールは入れないでください。トレーニングウェアは、コンプレッショントップ、レギンス、アームスリーブ（https://drive.google.com/file/d/17KIRs5uOMOc5GN5LD9R6OMe_goddf5Ww/view?usp=sharing）。ランニングシューズも。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@nyoma0410/works/16", "thumbnail_src": "https://si.imgix.net/cf771b3b/uploads/origins/ccf6385e-5082-4724-8ea1-e620fe444a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60b10558193760cb9e9bbe3d057c87da", "thumbnail_srcset": "https://si.imgix.net/cf771b3b/uploads/origins/ccf6385e-5082-4724-8ea1-e620fe444a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60b10558193760cb9e9bbe3d057c87da, https://si.imgix.net/cf771b3b/uploads/origins/ccf6385e-5082-4724-8ea1-e620fe444a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=636778772954c83a1ce24f64183f35b6 2x, https://si.imgix.net/cf771b3b/uploads/origins/ccf6385e-5082-4724-8ea1-e620fe444a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d0a0abdaab81e0b585a18f02d0571d1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nyoma0410/works/15", "thumbnail_src": "https://si.imgix.net/64395d4b/uploads/origins/f51e7aef-bbd7-4508-91b3-79e5ab2b0439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a299ae5d2355ef273fe92eba010ed09", "thumbnail_srcset": "https://si.imgix.net/64395d4b/uploads/origins/f51e7aef-bbd7-4508-91b3-79e5ab2b0439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a299ae5d2355ef273fe92eba010ed09, https://si.imgix.net/64395d4b