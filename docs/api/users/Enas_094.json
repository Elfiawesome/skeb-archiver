26304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dce0447b627579cf26be1fc82acb64e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dce0447b627579cf26be1fc82acb64e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48504a1ca3314349a4e61f248124b82a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a426376b153d0c15caeb601c3c4dc16 3x", "genre": "music", "nsfw": false, "body": "初めまして、新着で素敵な音楽を拝聴し、リクエストさせて頂きました。\nご確認ご検討お願い致します。\n\n■キャラクター\n資料の2名をイメージした曲をお願いしたいです。自作ゲーム（ファンタジーRPG）の敵キャラクターです。\n雰囲気の参考にゲームのスクショもいくつか同梱しています。\n\n■雰囲気など\n戦闘BGM風をお願いしたいです。いわゆる四天王的なポジションで、その中でも強い方ですので、ゲーム終盤まで立ち塞がる強ボスのイメージでお願いしたいと思っています。\nテンポが速めで激しいものが好みですが、何か思いついたものがあれば自由にして頂けたらと思います。\n\n■利用用途\n個人観賞用です。実際にゲームでの使用はありませんので、ループなどは気にしなくて大丈夫です。\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lj-QR008xBzT4chQU3qlxQjOtySS1uFA", "created_at": "", "completed_at": ""}, {"path": "/@Enas_094/works/22", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f32b0eb65bd64c04e31241aa20cf3cec", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f32b0eb65bd64c04e31241aa20cf3cec, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e5a4aba33f44d482430729220947301 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e815ffd49837b0a4fdb23d69ea23ad41 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Enas_094/works/21", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dce0447b627579cf26be1fc82acb64e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dce0447b627579cf26be1fc82acb64e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48504a1ca3314349a4e61f248124b82a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a426376b153d0c15caeb601c3c4dc16 3x", "genre": "music", "nsfw": false, "body": "こんにちは。先ほどは素敵な楽曲を納品いただきまして誠にありがとうございます…！聞いてすぐ、感動が抑えきれずにもっとＥna-s様のこの二人の解釈で作られた曲が聞きたい！と再びリクエストに参りました…！\nお忙しいところ恐縮ですが、再度ご検討をいただけますと幸いです。\n\n※前回の感想です\n駒かいバリエーション違いも納品していただき、丁寧なご対応に感謝が尽きません。特に【3121464-9】の戦闘曲に笛の音が軽やかに乗った楽曲が大好きです。ベースの楽曲と比較して違いを二度楽しませていただいております。\n日常曲の方もトロンボーンと横笛だけのものと、可愛らしい他楽器の伴奏のものと分けていただいたものをいただけたのがとっても嬉しかったです。鳥の音に連れられるように朝二人きりで演奏しているだけの時間と、そのまま時間が進み日中街中にいる二人、二つの時間を楽しませていただいているようでした。特に最後の掛け合いになってるようなパートが大好きで初めて聞いたときに鳥肌が立ちました…！\n\nーーーーーーーーーー\n\n以下、ご詳細になります。(一緒です)\n\nーーーーー\n\n【キャラクター詳細】\n\n■イ・ジオ(黒髪)\n男性/185cm/25歳/韓国人\n好きな音楽：ファンファーレ\nトロンボーンの奏者でその演奏で戦場を鼓舞する。\n自信家で心が広く、ダジャレが大好き。まっすぐ生きてきた情にアツい男。\nハユンの危うげなところが放っておけず何かと気にかけている。早朝はハユンを誘い朝のセッションを行う。\n\n■キム・ハユン(赤髪)\n男性/180cm/25歳/韓国人\n好きな音楽：韓国の民俗音学/クラシック\n刀を使用して戦う。横笛の奏者。\n名家の出自で生真面目で規律を重視する。他人に厳しく自分にも厳しい。\nオンオフが激しく、オフではよく笑い、人の世話をやき、情に弱い面を見せる。\nジオには信頼をよせており、唯一弱音を零すことが出来る。\n\n\n<関係性>\n舞台は18世紀のロンドン。二人とも軍の隊長でジオが先輩。\n同い年で同郷出身、音楽という共通の趣味を持ち。親友であり戦友である。言葉よりも音楽の方が素直にコミュニケーションをとれる二人。\n\nーーーーーーーーーーーーーーー\n\n※追記部分【キャラクター詳細】\n\n戦場で死に別れている。\nジオが戦死、ハユンは終戦まで生き残っている。\nジオの死に際に泣いているハユンに「泣くな」「歩け」と遺言を、そして自身の楽器トロンボーンを授けている。\n\nーーーーーーーーーーーーーーー\n\n\n<要望>\n\n【01】二人の戦闘イメージ02\n【3121464-9】のようなイメージで、さらに少し系統違いの戦闘の楽曲を頂きたいです。\nトロンボーンと横笛を入れていただき、進行曲のようなイメージだと嬉しいです。(もし可能でしたら今回みたいに二種類入れていただけるととっても嬉しいです…！)\n\n\n【02】クラシックベースの曲\n前回は明るい曲調でしたので今回は暗め(シリアスでせつない)の印象の楽曲をお願いしたいです。マイナーコードをメインにトロンボーンとフルートがあると嬉しいです。\n戦場で死別している二人(ハユンのみ生き残っている)なので「涙」をテーマにお願いいたします。\n\n※参照イメージ\nベートーヴェン「月光」「悲愴」\nクライスラー 「愛の悲しみ」\n\n\n【03】別れの曲\n二重奏ではなくメインメロディーをトロンボーン→フルート(横笛)へ渡すようなイメージで制作いただくことは可能でしょうか？\n\n戦場でジオが死に際にハユンへ楽器と意思を託すシーンがあるので、それらを表現していただけると嬉しいです。難しい注文になり申し訳ありません。Ena-s様の解釈、作りやすい方法で表現して頂けたらと思います。\n\nピアノやオルゴールなど(お任せします)切なく静かな曲でお願いします。\n\n\n<使用用途>\n・個人での鑑賞\n・個人範囲でのゲーム内BGMでの使用\n\nーーーーーーーーーーー\n\n\n合計3曲をお願いできますと幸いです。\nそれではご縁がありましたら、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1iImFA0uiEOPPIpWyJSndMiFn7ntsZXPH?ths=true", "created_at": "", "completed_at": ""}, {"path": "/@Enas_094/works/20", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697950195030626304%2F06DFYyGY.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f32b