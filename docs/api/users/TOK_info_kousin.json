容】\n可能ならば、この子でアイドルみたいな可愛いポーズで、一枚のイラストをお願い致します。明るい雰囲気で描いて頂ければ大変嬉しいです。その他の構図などはトクヲツム様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Ze-4O5Vez4zAhG1FySxbSGG0PLCs-PSF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@TOK_info_kousin/works/36", "thumbnail_src": "https://si.imgix.net/7d88e3d0/uploads/origins/c230b2f6-0971-40dd-9c22-2f33c03e09ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b63491887cc4c3f4f0d57ff2f2e0c691", "thumbnail_srcset": "https://si.imgix.net/7d88e3d0/uploads/origins/c230b2f6-0971-40dd-9c22-2f33c03e09ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b63491887cc4c3f4f0d57ff2f2e0c691, https://si.imgix.net/7d88e3d0/uploads/origins/c230b2f6-0971-40dd-9c22-2f33c03e09ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c093a63265948605e9dc431f954c30e0 2x, https://si.imgix.net/7d88e3d0/uploads/origins/c230b2f6-0971-40dd-9c22-2f33c03e09ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a792198fffdd46ef8208e8720b7cf2fb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TOK_info_kousin/works/35", "thumbnail_src": "https://si.imgix.net/e4f10131/uploads/origins/bcce9bb3-fb49-4bfe-b2ac-35720e3d995e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47c51d81aef3e4d50263ec8e280d1e7b", "thumbnail_srcset": "https://si.imgix.net/e4f10131/uploads/origins/bcce9bb3-fb49-4bfe-b2ac-35720e3d995e?bg=%23fff&auto=format%2Ccompress&fm=web