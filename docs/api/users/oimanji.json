_src": "https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c6e3eb83da083fb2c63a071aac5b3a", "thumbnail_srcset": "https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c6e3eb83da083fb2c63a071aac5b3a, https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94138e49e14e6b5114e56aa845c84a0e 2x, https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=612fd1befb664d2c68271a2af44694e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1461", "thumbnail_src": "https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854794e2f60700c44f90c80f5f175e19", "thumbnail_srcset": "https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854794e2f60700c44f90c80f5f175e19, https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da60568d8c013dd6ac0d9637559527dc 2x, https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8698d3c400be2225334719d4f34e0f19 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\n\"借り暮らしのアリエッティ”のアリエッティちゃんの状況を見たいのですが。アリエッティちゃんは盗みながら隣人の子供に捕らえられ、今ではかわいい裸のペットとして飼われています。絵の中で、彼女のヘアクリップを除いて裸で、彼女の所有者の部屋で四つんばいで這うアリエッティを描いてください ​彼女は良い子のように所有者の巨大な指から餌をなめています。彼女は屈辱を受け、不幸ですが、適度によく訓練ており従順です。彼女の身長は10cm弱で.", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1460", "thumbnail_src": "https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a604e57c810e44e39bbfac775e5919", "thumbnail_srcset": "https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a604e57c810e44e39bbfac775e5919, https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d4b95a5b8d3af149e1a1901384c98f1 2x, https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bc0f2d1829beff7da245fbf5470abb0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1459", "thumbnail_src": "https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5416a12f39281c9b1b18e300467f272c", "thumbnail_srcset": "https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5416a12f39281c9b1b18e300467f272c, https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e08a9b5b0e27e1f1ff1b13b1ddf868ef 2x, https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe0fa7a963e4b3a13c6263ac91c4bfaf 3x", "genre": "art", "nsfw": true, "body": "ハイスクールD×D、アーシア・アルジェント、スケベ修道女の衣装、対面座位ベロチュー、チャラ男と", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1458", "thumbnail_src": "https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=521b59dff02d708e2384e39542fffbff", "thumbnail_srcset": "https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=521b59dff02d708e2384e39542fffbff, https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26074200a5455322cd76ed5909bf75a0 2x, https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fa2791fbc94f5acc83187a6d27c963e 3x", "genre": "art", "nsfw": false, "body": "はじめまして。自分が見たいキャラのシチュエーションなので、リクエストさせていただきます。\nキャラクター→白井日菜子(ブルーリフレクション)\nシチュエーション→戦闘時のコスチューム(リフレクター)姿で、髪や眼の色は変身前の状態(プリキュアシリーズで言うミッドフォーム)。\n表情は強敵を倒した清々しい笑顔でお願いします。\n\nhttps://social.gust.co.jp/gakkou/chara_01.html", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1457", "thumbnail_src": "https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f7f6c5d1d2ab650cefdf79d33fbc94c", "thumbnail_srcset": "https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f7f6c5d1d2ab650cefdf79d33fbc94c, https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b035ca76ecee3fce9c14baf041f73642 2x, https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed8bdf272ef2c7905d33ebe975345cb2 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n匿名で失礼します\n\n機動戦士Vガンダムより\nシャクティ・カリンが下記資料のトップイラストの村娘の様な服装で、上着を片手でぺろんと捲っておっぱいを露出、スカートも捲り上げて下着を着けていない秘所が顕になった状態で、秘所をもう片方の手でくぱぁしているイラストをお願い致します。\n\n\nご検討の程、よろしくお願い致します！\n\n以下資料です。\nhttps://dic.pixiv.net/a/%E3%82%B7%E3%83%A3%E3%82%AF%E3%83%86%E3%82%A3%E3%83%BB%E3%82%AB%E3%83%AA%E3%83%B3", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1456", "thumbnail_src": "https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5ada4f9d76ccaae001c3a55558bf227", "thumbnail_srcset": "https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5ada4f9d76ccaae001c3a55558bf227, https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2b37152777f0634bd0c879e9afc9c74 2x, https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e71d6da43df37b89b04dcd6978759f6a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1455", "thumbnail_src": "https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02e388e42320420a4ba850b125eea7cc", "thumbnail_srcset": "https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02e388e42320420a4ba850b125eea7cc, https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04316b08d0e787366c9fe4e8ee7a522c 2x, https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b47e952b59eadfa5af18ba0f698020bd 3x", "genre": "art", "nsfw": true, "body": "前回の納品からすぐにで恐縮ですが、リクエストさせていただきます！\nシャニマスの大崎甘奈ちゃんが、和式トイレで下痢ウンチを排泄しているシーンを、カラーのイラスト形式でお願いします。\n排泄時の効果音（ブリブリビチビチなど……）は必ず入れてください。\n\n服装は通常の制服（参考URL→https://imassc.gamedbs.jp/image/card/still/1611632395256_05jbtycq.jpg）で、少し染みつき白パンツ、黒のハイソックス、こげ茶色のローファー着用でお願いします。\n\n排泄シーンの構図は前回の真乃ちゃん（https://skeb.jp/@oimanji/works/1318）と同じ構図でお願いします。\n\n以上です。\n前回同様情報量が多いですが、是非ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1454", "thumbnail_src": "https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09acc8935865ff3ef8a725c0dbfee9d5", "thumbnail_srcset": "https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09acc8935865ff3ef8a725c0dbfee9d5, https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9927914bbb9608e20bdbbcc6563c8a59 2x, https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d340e2ed5d72045fbf6f64735e68e577 3x", "genre": "art", "nsfw": true, "body": "おいまんじさんこんにちは、お久しぶりです。\n今回のリクエストですが「名探偵プリキュア！」よりキュアアルカナ・シャドウを触手で尿道責めして連続絶頂させて欲しいです。\n\n衣服はそのままにパンツだけ脱がせて、大股開きのポーズで拘束し、細長い触手でアソコを拡張し、イボイボトゲトゲだらけの極細触手でおしっこの穴を残像が見えるほど激しくピストン責めしてください。\nアソコの拡張は尿道口や子宮口がよく見えるように描いて欲しいです。\n可能であれば更に高速化していく尿道ピストンと色んなイキ顔＆泣き顔の表情を、金額の見合う範囲でお願いしたいです。\n\n加速度的にインフレしていく尿道快楽責めに文字通り連続絶頂するキュアアルカナ・シャドウをぜひよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1453", "thumbnail_src": "https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b18350d3c922d28b5590f678e6cc6392", "thumbnail_srcset": "https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b18350d3c922d28b5590f678e6cc6392, https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6503879da443b842fa0676e0137504d8 2x, https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a50a58e242753a9d8abe107733d2006 3x", "genre": "art", "nsfw": true, "body": "抱き枕風イラストでベッドで寝そべる名探偵プリキュアの明智あんなをリクエストします。\nあんなの服装はソックス着用のパンツ一枚で、下着は肌に密着したリボン付のジュニアショーツでお願いします。\n構図はFANBOXで描かれた下記イラストを参考にしていただけると嬉しいです。\nhttps://www.fanbox.cc/@oimanji/posts/10928721", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1452", "thumbnail_src": "https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2355a3fb8d5b6c8873aa7dfaf67c4189", "thumbnail_srcset": "https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2355a3fb8d5b6c8873aa7dfaf67c4189, https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88a71bcfdd3119e415bc1c1c5dcd9aa4 2x, https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c9abf074ff3af349543fc9c6bc4a56c 3x", "genre": "art", "nsfw": true, "body": "おいまんじ様、また秘密戦隊ゴレンジャーからペギー松山をリクエストさせてください。\n下記アドレスのイラストのように、頭を捕まれ両目を開き涙を流しアップで（両胸より上を描いてください、下半身は描かないでください）黒十字軍兵士にフェラチオをされている姿をお願いします。\nhttps://x.com/oreizmmiporin/status/1975840989249216567\nいつもの黄色のベストで両胸が開けて赤いハートのペンダントとイヤリングも着けていている状態で、口から精液が溢れています。\n是非お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1451", "thumbnail_src": "https://si.imgix.net/c910ddf3/uploads/origins/a8915b17-af6a-4669-b1e4-e291dd2ca263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83801c283f7eec7da17288b37aeb073a", "thumbnail_srcset": "https://si.imgix.net/c910ddf3/uploads/origins/a8915b17-af6a-4669-b1e4-e291dd2ca263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83801c283f7eec7da17288b37aeb073a, https://si.imgix.net/c910ddf3/uploads/origins/a8915b17-af6a-4669-b1e4-e291dd2ca263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84ff7460816fd0ec3d36e5c616fff978 2x, https://si.imgix.net/c910ddf3/uploads/origins/a8915b17-af6a-4669-b1e4-e291dd2ca263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3bbf93fd991b2b2ab47b8cb6c2689b 3x", "genre": "art", "nsfw": true, "body": "ガヴに登場するグロッタ(人間態)が幼少期ショウマの筆下ろしをしてあげるイラストをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1450", "thumbnail_src": "https://si.imgix.net/4bac819d/uploads/origins/56f8d118-3188-4299-93e3-d31610a1a762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a7e3ff239cc72919acf7231e968e168", "thumbnail_srcset": "https://si.imgix.net/4bac819d/uploads/origins/56f8d118-3188-4299-93e3-d31610a1a762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a7e3ff239cc72919acf7231e968e168, https://si.imgix.net/4bac819d/uploads/origins/56f8d118-3188-4299-93e3-d31610a1a762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18c4388b196bcb57a39b969cab830185 2x, https://si.imgix.net/4bac819d/uploads/origins/56f8d118-3188-4299-93e3-d31610a1a762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02f373d15809633e66d6d10cfbe95f23 3x", "genre": "art", "nsfw": true, "body": "こんばんは、今回もリクエストさせて頂きます。  \n\n <キャラクター> 『Go！プリンセスプリキュア』より天ノ川きらら \n<シチュエーション> ベットに寝そべっている。\nその際スカートがめくれてパンツが見えている。 \n可能ならスカートが無い状態もあれば嬉しいです。\n・衣装は、ノーブル学園の制服。パンツは白色のシンプルなデザイン\n・ポーズは、仰向けで寝そべり\n・構図は、頭部から膝上のあたりまで。  \n・表情は、恥ずかしがって困り顔。   \n・その他はお任せします。   \n\n以上です。それではどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1449", "thumbnail_src": "https://si.imgix.net/eeecdd73/uploads/origins/26c93cda-ee03-48e1-97e8-59217d8916c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e031df9a649e4cd62aac589593c489f2", "thumbnail_srcset": "https://si.imgix.net/eeecdd73/uploads/origins/26c93cda-ee03-48e1-97e8-59217d8916c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e031df9a649e4cd62aac589593c489f2, https://si.imgix.net/eeecdd73/uploads/origins/26c93cda-ee03-48e1-97e8-59217d8916c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b67165a59e1927f9782fa3ea38da900 2x, https://si.imgix.net/eeecdd73/uploads/origins/26c93cda-ee03-48e1-97e8-59217d8916c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a3e05f3845b7ce4ca02a8e928a3f985 3x", "genre": "art", "nsfw": true, "body": "またリクエストを送らせて頂きます！\n今回は「雪城ほのか」と「美墨亮太」のイラストをお願い致します！\n構図は後背位でお願い致します。\n表情についてですが、ほのかは恥ずかしそうにしながらも感じてしまっている顔でお願いします。\n亮太はなぎさとのSEXで慣れているので、憧れのほのかを満足させているという愉悦感に浸ったような余裕の表情でお願いします。\n\nご検討何卒よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1448", "thumbnail_src": "https://si.imgix.net/36932613/uploads/origins/61587eb1-d90e-4a5e-92a2-96b67518d8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=386d3daa257299fed4ac0a37738e41e5", "thumbnail_srcset": "https://si.imgix.net/36932613/uploads/origins/61587eb1-d90e-4a5e-92a2-96b67518d8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=386d3daa257299fed4ac0a37738e41e5, https://si.imgix.net/36932613/uploads/origins/61587eb1-d90e-4a5e-92a2-96b67518d8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3a7a07d4bed38741c87db9bc6dc799c 2x, https://si.imgix.net/36932613/uploads/origins/61587eb1-d90e-4a5e-92a2-96b67518d8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b617d11a56eee68db21c92332c2035e 3x", "genre": "art", "nsfw": true, "body": "お世話になっております\nリクエスト失礼します\nよろしければ承認お願い致します  \n\n香久矢まどかが敵に背後から羽交い絞めにされ、もう一方の敵から攻撃を受けそう、または受けているところをお願いします \nいわゆるヒロピンイラストになります\n まどかのコスチュームは変身途中の紫色のキャミソール姿で羽交い絞めされている姿をお願いします\n変身初期のキャミソールのみで裸足、髪のリボンなし\n(キュアセレーネのパーツ、髪飾りなどは全てなし)\n羽交い絞めされている姿は、前のリクを参考にしていただければと思います\nよろしくお願い致します\n\n前作:https://skeb.jp/@oimanji/works/1382\n\nhttps://www.dropbox.com/scl/fo/bfoyy6vnrosl7636n5h4x/ANGd2XBIOCccCWQBVrXgHtg?rlkey=qswuv7qb25pgnmkl2fb7sln9z&st=4hwx1qa1&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1447", "thumbnail_src": "https://si.imgix.net/3a8cbb12/uploads/origins/95caff4f-caa3-46a0-a5b3-79024bec6c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f91623e38d23d2be53f6a87755a1e84f", "thumbnail_srcset": "https://si.imgix.net/3a8cbb12/uploads/origins/95caff4f-caa3-46a0-a5b3-79024bec6c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f91623e38d23d2be53f6a87755a1e84f, https://si.imgix.net/3a8cbb12/uploads/origins/95caff4f-caa3-46a0-a5b3-79024bec6c38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20ace9ea53df37c92de86b1be98e4fa8 2x, https://si.imgix.net/3a8cbb12/uploads/origins/95caff4f-caa3-46a0-a5b3-79024bec6c38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59e866bceb27b155ab3193fcd8f6aa0a 3x", "genre": "art", "nsfw": true, "body": "またお願いです。プリキュアのイラストをもう一枚描いてください。前回同様スイートの亜子ですが、今回はハグっとプリキュアの恵理と一緒です。二人ともベリーダンサー風の衣装で、非常に露出が多く透けています。恵理はお尻を強調（陰部と肛門が両方見える状態）し、亜子は体の前面を見せています。二人とも生意気にも舌を出しています。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1446", "thumbnail_src": "https://si.imgix.net/548033a2/uploads/origins/a1273c2a-4364-40c8-b502-f79f15937664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78844858c0f8644b0fa13b773efce695", "thumbnail_srcset": "https://si.imgix.net/548033a2/uploads/origins/a1273c2a-4364-40c8-b502-f79f15937664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78844858c0f8644b0fa13b773efce695, https://si.imgix.net/548033a2/uploads/origins/a1273c2a-4364-40c8-b502-f79f15937664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=334d7afce0e654f38a60bd2e30761f59 2x, https://si.imgix.net/548033a2/uploads/origins/a1273c2a-4364-40c8-b502-f79f15937664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a5d1b1e13e5b2f9b5470c95e438871d 3x", "genre": "art", "nsfw": true, "body": "はじめまして、ゲーム『リーグ・オブ・レジェンド（LoL）』のイラストを依頼したいです。「雨の導き手」の4人全員：トリスタナ、グウェン、ミリオ、フィズです。人間（男女）2人と魔法の生き物（男女）2人です。彼らは可愛らしいエナメルレインコートを着たまま、楽しそうにセックスをしています。 水しぶきが飛び散り、衣装は濡れています。可能であれば男性キャラクターも画面内に収め、切れたり顔が見えない状態にならないようお願いします。女性だけを鑑賞するのではなく、4人が共に楽しむ様子に焦点を当ててください。キャラクターの組み合わせなどはご判断にお任せします。ご検討いただきありがとうございます。https://imgur.com/a/ZnrdIMX", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1445", "thumbnail_src": "https://si.imgix.net/b44597aa/uploads/origins/c81df4af-d4ec-4721-8bef-a66055995bfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dfcdd3727171c6707baf93c297843ee", "thumbnail_srcset": "https://si.imgix.net/b44597aa/uploads/origins/c81df4af-d4ec-4721-8bef-a66055995bfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dfcdd3727171c6707baf93c297843ee, https://si.imgix.net/b44597aa/uploads/origins/c81df4af-d4ec-4721-8bef-a66055995bfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9530888485debd20663c970f6c208aca 2x, https://si.imgix.net/b44597aa/uploads/origins/c81df4af-d4ec-4721-8bef-a66055995bfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3306ba9e20db4e27c2aa2bdc06fa38e0 3x", "genre": "art", "nsfw": true, "body": "機動戦艦ナデシコのミスマル・ユリカが演算ユニットに制御装置として組み込まれている姿（全裸）をお願いします。\n以前描いていただいたDGレインみたいな感じ（全裸で、股や陰部が見えるくらいまで埋まっている部分を浅くし、壁からケーブルみたいなものが伸びてユリカの女性器に挿入されている/一応、資料URLに本来の状態のものを置いておきます）で、ケーブルと女性器の結合部からは愛液が滴り落ちてるみたいな風でお願いします。\n元は乳首など省略などされていますが、陰毛と合わせて描いていただけると嬉しいです。\nご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1oP_k1sFUaoQVKdTUZuG2BlY5UWaJPk9G?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1444", "thumbnail_src": "https://si.imgix.net/9ad400a7/uploads/origins/92090460-16ce-4d60-b664-1255d3ddcee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af557653c85f769d3d7fc97345eb57c", "thumbnail_srcset": "https://si.imgix.net/9ad400a7/uploads/origins/92090460-16ce-4d60-b664-1255d3ddcee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af557653c85f769d3d7fc97345eb57c, https://si.imgix.net/9ad400a7/uploads/origins/92090460-16ce-4d60-b664-1255d3ddcee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e47c6886365b60c98954c7e0afcd8c0d 2x, https://si.imgix.net/9ad400a7/uploads/origins/92090460-16ce-4d60-b664-1255d3ddcee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=687d60d79b58fd7113eb74065ec84ad7 3x", "genre": "art", "nsfw": true, "body": "いつも陰ながら応援しています。\n冥王せつながセーラージュピターの首輪を締めて制圧しているリョナリーンをリクエストします。\n以下詳細です。\n\n・ジュピターとせつなの服装等\nジュピターは(https://skeb.jp/@oimanji/works/1028)と同じ格好(腰に巻く分厚い革手錠で両手をキツく拘束されている。コスは破かれて大きな胸が丸出し。首にはチョークチェーンの首輪)。\n冥王せつなは(https://skeb.jp/@oimanji/works/1184)と同じ格好(競泳水着だが、胸部がズレて巨乳が丸出し)。顔にはアザあり。\n\n・構図\nジュピターは仰向けに横たわっており、足を広げて座る冥王せつなの下腹部付近に股枕のような体勢で頭部を預けている( https://www.pixiv.net/artworks/91310223 のような体勢。ただしジュピターは仰向け)。\n※上記の形で描きづらい場合、せつなをしゃがませたり、イス等に座らせて少し高さを出すなどの変更を適宜加えていただいて大丈夫です(全力で首輪を締め上げていることが伝わればOK)。\n\n・その他(シチュエーション、表情等)\n厳しい表情の冥王せつなは首輪から伸びるチェーンの根本近くを両手で握り、思い切り引っ張ってジュピターの首輪を締め上げている(チェーンに十分な力が伝わっていることが伝わる絵面になるように、チェーンを片方の手首に巻いている描写など、適宜お願いできればと存じます)。\nジュピターは首筋に首輪がガッツリ食い込んで呼吸ができず、革手錠で拘束された両手をきつく握りしめて苦しそうな表情。\n完全に意識を失って脱力し、(https://x.com/nikkioh2501/status/1954213179900481748/photo/1)のように目があらぬ方向を向いている表情差分や、失禁・脱糞している差分があると嬉しいです。\n\n可能であればぜひよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1443", "thumbnail_src": "https://si.imgix.net/2e04f1cb/uploads/origins/38d74d75-1ccd-47fb-afa7-a5391fe8da37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=791a32c0075d548ae1399fd77fe6c6f0", "thumbnail_srcset": "https://si.imgix.net/2e04f1cb/uploads/origins/38d74d75-1ccd-47fb-afa7-a5391fe8da37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=791a32c0075d548ae1399fd77fe6c6f0, https://si.imgix.net/2e04f1cb/uploads/origins/38d74d75-1ccd-47fb-afa7-a5391fe8da37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1193dd92c3306f026d2319807eae305 2x, https://si.imgix.net/2e04f1cb/uploads/origins/38d74d75-1ccd-47fb-afa7-a5391fe8da37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=919c37d4b14010665d757a026a023aba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1442", "thumbnail_src": "https://si.imgix.net/4da0d3b9/uploads/origins/9ed0e95c-6448-4bca-8065-698b70febc80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52c5605673ea443646d13f3aefc33dce", "thumbnail_srcset": "https://si.imgix.net/4da0d3b9/uploads/origins/9ed0e95c-6448-4bca-8065-698b70febc80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52c5605673ea443646d13f3aefc33dce, https://si.imgix.net/4da0d3b9/uploads/origins/9ed0e95c-6448-4bca-8065-698b70febc80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56cbe4bc895dea9f426eba99019e1b5c 2x, https://si.imgix.net/4da0d3b9/uploads/origins/9ed0e95c-6448-4bca-8065-698b70febc80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=990d3f64cdec55c623678cc2d3fb4322 3x", "genre": "art", "nsfw": true, "body": "体重測定をする調辺アコをリクエストします。\nこの日のためにダイエットしてきたのに全然体重が減ってなく、残念そうな表情のシチュでお願いします。\nまた、服装はパンツ一枚で下着はリボン付のジュニアショーツでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1441", "thumbnail_src": "https://si.imgix.net/5260dbc2/uploads/origins/82ba6275-c694-47a0-adfa-f5edcf4eee00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166c56544757bcc88c8ee330f7f36061", "thumbnail_srcset": "https://si.imgix.net/5260dbc2/uploads/origins/82ba6275-c694-47a0-adfa-f5edcf4eee00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166c56544757bcc88c8ee330f7f36061, https://si.imgix.net/5260dbc2/uploads/origins/82ba6275-c694-47a0-adfa-f5edcf4eee00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b59ad3c411deda05f89801dc9601be01 2x, https://si.imgix.net/5260dbc2/uploads/origins/82ba6275-c694-47a0-adfa-f5edcf4eee00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f9dfed92718f0292b06c238f5e12811 3x", "genre": "art", "nsfw": true, "body": "ご無沙汰してます。おいまんじ様、今回はスター⭐︎トゥインクルプリンセスプリキュアのキュアセレーネをお願いします。首から下は全裸で巨乳のオッパイとパイパンの秘所は丸出しにしてください。体位は燕返しで結合部は精液が溢れ出す感じでお願いします。竿役はガルオウガでキュアセレーネの表情は巨根による快楽堕ちにイキまくったものと完全に力負けした恐怖感が入り混じった泣き顔にしてください。何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1440", "thumbnail_src": "https://si.imgix.net/c66a7e1e/uploads/origins/4cae7d3c-30d6-4b64-a3e7-6aaf1cd701c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3998008df540b41404e91cc223dcb1d", "thumbnail_srcset": "https://si.imgix.net/c66a7e1e/uploads/origins/4cae7d3c-30d6-4b64-a3e7-6aaf1cd701c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3998008df540b41404e91cc223dcb1d, https://si.imgix.net/c66a7e1e/uploads/origins/4cae7d3c-30d6-4b64-a3e7-6aaf1cd701c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cec903bdaecbf4a83eb4131826652cf7 2x, https://si.imgix.net/c66a7e1e/uploads/origins/4cae7d3c-30d6-4b64-a3e7-6aaf1cd701c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7116ab9dafa9283d09174bd07f29879 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです、今年もよろしくお願いします！　またリクエストさせていただきます！\nミリマスの所恵美ちゃんが、和式トイレで下痢ウンチを排泄しているシーンを、カラーのイラスト形式でお願いします。\n排泄時の効果音（ブリブリビチビチなど……）は必ず入れてください。\n\n服装はアイドル学園 所恵美の制服（参考URL→https://livedoor.blogimg.jp/sosyage/imgs/7/d/7d66cb3d-s.png）で、少し染みつき白パンツ、黒のニーハイソックス、黒のローファー着用でお願いします。\n\n排泄シーンの構図は前回の真乃ちゃん（https://skeb.jp/@oimanji/works/1318）と同じ構図でお願いします。\n\n以上です。\n前回同様情報量が多いですが、是非ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1439", "thumbnail_src": "https://si.imgix.net/c409a6c2/uploads/origins/f8447541-dfe3-4919-88b3-dc6f733972f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1b0eafa0b7150c4ac51ee72929146b", "thumbnail_srcset": "https://si.imgix.net/c409a6c2/uploads/origins/f8447541-dfe3-4919-88b3-dc6f733972f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1b0eafa0b7150c4ac51ee72929146b, https://si.imgix.net/c409a6c2/uploads/origins/f8447541-dfe3-4919-88b3-dc6f733972f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6beb8522eb757e78ebf253f8b088ee41 2x, https://si.imgix.net/c409a6c2/uploads/origins/f8447541-dfe3-4919-88b3-dc6f733972f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0521fa482db16fa1de692bd700ca769 3x", "genre": "art", "nsfw": true, "body": "こんにちは、再度お絵描きをお願いしたいです。今回はスイートプリキュアの亜子と彼女の母親アフロディーテを描いていただけますか？二人の少女がベッドに嬉しそうに横たわり、欲情した表情をしています。亜子は尻を露出（陰部と肛門が両方見える状態）し、アフロディーテは大きな胸と毛深い陰部を披露しています。二人とも下着はベッドの端にぶら下がっています。改めてありがとうございます", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1438", "thumbnail_src": "https://si.imgix.net/a44f9536/uploads/origins/2a2fc968-6c1f-438f-b8ca-3ed421d6c784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a166088e44117c600ea8d7ed6a6e3c", "thumbnail_srcset": "https://si.imgix.net/a44f9536/uploads/origins/2a2fc968-6c1f-438f-b8ca-3ed421d6c784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a166088e44117c600ea8d7ed6a6e3c, https://si.imgix.net/a44f9536/uploads/origins/2a2fc968-6c1f-438f-b8ca-3ed421d6c784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54fb10287bbc82dd34223e982d949643 2x, https://si.imgix.net/a44f9536/uploads/origins/2a2fc968-6c1f-438f-b8ca-3ed421d6c784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbee709c368406d0da891b8df9aeae5c 3x", "genre": "art", "nsfw": true, "body": "匿名でリクエスト失礼します。\n\n「特捜戦隊デカレンジャー」の胡堂小梅(デカピンク）を描いていただきたいです。\n\n衣装\n下の資料の変身スーツにしてください。\n\nhttps://pin.it/5ZFKClEy6\n\n要望\nこの絵みたいにメットオフ状態で背後から乳首を弄られ、犯されている場面を描いてください。\n\nhttps://skeb.jp/@oimanji/works/767\n\n股間部分は挿入できるように穴を開けてください。乳首部分も開けてください。\n表情は気持ちよくなっている感じを出してください。\n\nご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1437", "thumbnail_src": "https://si.imgix.net/27ee9f2d/uploads/origins/050ff1b1-aab7-4f05-9de7-f31a10a349f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9d8812ecd90314472e847e664752c3d", "thumbnail_srcset": "https://si.imgix.net/27ee9f2d/uploads/origins/050ff1b1-aab7-4f05-9de7-f31a10a349f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9d8812ecd90314472e847e664752c3d, https://si.imgix.net/27ee9f2d/uploads/origins/050ff1b1-aab7-4f05-9de7-f31a10a349f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3f7e21479492f609b410f0734ee36cf 2x, https://si.imgix.net/27ee9f2d/uploads/origins/050ff1b1-aab7-4f05-9de7-f31a10a349f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=130721aa59779c60266186359591c2bf 3x", "genre": "art", "nsfw": true, "body": "おいまんじ様、また秘密戦隊ゴレンジャーからペギー松山をリクエストさせてください。\nペギー松山が電車の中で痴漢レイプされている姿です。\n乗り合わせた電車の車両が全員黒十字軍で、ペギーがつり革を両手で持っているのですが、下記アドレスのごとく、黄色のベストを着てワイシャツが開けて両胸は見え、下半身は裸で立ったままですが尻を後ろに突き出した格好でバックから腰を両手で持たれ激しく犯され（陰毛はなし）、目を細めて涙を流しながら口を開き激しく喘いでいます。\n胸のペンダントと両耳のハートのイヤリングの書き込みもお願いします(色は両方とも赤色で)。\n是非お願いいたします。\nhttps://skeb.jp/@oimanji/works/1101", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1436", "thumbnail_src": "https://si.imgix.net/bbe7151d/uploads/origins/2a16c9d1-3d27-4c20-8dc9-251e5a82824c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3028debccd7030a68f557aabd00833c6", "thumbnail_srcset": "https://si.imgix.net/bbe7151d/uploads/origins/2a16c9d1-3d27-4c20-8dc9-251e5a82824c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3028debccd7030a68f557aabd00833c6, https://si.imgix.net/bbe7151d/uploads/origins/2a16c9d1-3d27-4c20-8dc9-251e5a82824c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31dce2b0a758f85e0cc4492cb390a2c5 2x, https://si.imgix.net/bbe7151d/uploads/origins/2a16c9d1-3d27-4c20-8dc9-251e5a82824c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e3a3a5caef502b45da30c8d6801fd6b 3x", "genre": "art", "nsfw": true, "body": "いつも大変お世話になっております。\n下記のリクエストをお願いできますでしょうか。\n\n【キャラ】\nスイートプリキュア　キュアメロディ\n\n【シチュエーション】\nキュアメロディを精巧に模した呪いの人形によって人形と同じ動きをさせられているキュアメロディ。\nX字のような態勢で仰向けになっている彼女と人形を踏みつけるフーナイトを描いて欲しいです\n\n【要望】\n・戦闘中だったので全身汗まみれ\n・人形は手で掴める程度の大きさで人形にダメージが入ると本人も負傷する\n\nご検討のほど、よろしくお願いいたします。\n\n【参考資料】\nhttps://drive.google.com/drive/folders/19-4LCbzN_kEVqcgQhE7IVUM0m42qxd-z?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1435", "thumbnail_src": "https://si.imgix.net/dd1967bc/uploads/origins/aca325a9-636c-46e6-875a-0b6e5b88b134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc04e558737250017ae24a9a048bf69", "thumbnail_srcset": "https://si.imgix.net/dd1967bc/uploads/origins/aca325a9-636c-46e6-875a-0b6e5b88b134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc04e558737250017ae24a9a048bf69, https://si.imgix.net/dd1967bc/uploads/origins/aca325a9-636c-46e6-875a-0b6e5b88b134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c731efbe8f533ba75677be5ff0095845 2x, https://si.imgix.net/dd1967bc/uploads/origins/aca325a9-636c-46e6-875a-0b6e5b88b134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab033b5041faf259accab579d81fe18a 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nリクエストさせて頂きます。\n\n\n<キャラクター>\n『機動戦士ガンダム』よりララァ・スン\n\n<シチュエーション>\nララァのパンモロイラストをお願いします。ララァは前面向きで、ヘソが見えるぐらいドレスが豪快にまくれ上がりパンツが丸見えになっています。自然にまくれ上がる感じでも自分でたくし上げる感じでもどちらでも構いません。\n・パンツの色は白で、刺繍やレースなどの付いた高級そうな下着です。デザインはお任せします。\n・表情は妖しげな笑みを浮かべています。わざと見せてるんじゃないかという感じの余裕のある表情です。\n・背景は適当で大丈夫です。\n\n\n以上です。\n検討頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/1xL6_B1IY1MvXY_b9DIIRRkduh5hYhY5V?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1434", "thumbnail_src": "https://si.imgix.net/b8a26dbc/uploads/origins/babc2756-daf7-42f1-99f0-ab95ef3b6148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f8fd8a1aa71cb69dae646f331003602", "thumbnail_srcset": "https://si.imgix.net/b8a26dbc/uploads/origins/babc2756-daf7-42f1-99f0-ab95ef3b6148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f8fd8a1aa71cb69dae646f331003602, https://si.imgix.net/b8a26dbc/uploads/origins/babc2756-daf7-42f1-99f0-ab95ef3b6148?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f972fba6a85e0907a1bcfb4bdf5984e0 2x, https://si.imgix.net/b8a26dbc/uploads/origins/babc2756-daf7-42f1-99f0-ab95ef3b6148?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a6568d836388020c162b28c475017e0 3x", "genre": "art", "nsfw": true, "body": "おいまんじ様、大変ご無沙汰しております。\n科学戦隊ダイナマンの立花レイをお願いします。\nシチュエーションは、王女キメラの攻撃で変身解除、泥水の中にうつ伏せで倒れ、立ちあがろうとしたところをにキメラに背部を踏みつけられピンチ。衣装は変身前(https://tokusatsuheroine.up.seesaa.net/image/003-b957f.JPG)で髪型は(https://tokusatsuheroine.up.seesaa.net/image/011-26441.jpg)\n(https://blog-imgs-147.fc2.com/s/a/t/satokuwa/vlcsnap-2022-04-24-10h56m38s964.jpg)のような構図で、全身泥まみれでドロドロになり、さらに衣装は濡れて肌に張り付いたり濡れ透けして乳首が立っている。手放したローズサーベルを取り返そうと右手を伸ばすが届かない状態。表情は、敵に踏まれて「うっ‼︎」と叫びながら片目を見開き苦しんでいる感じ。\nレイの前に転がっているローズサーベルと右腕に破壊されたダイナブレスの描写もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1433", "thumbnail_src": "https://si.imgix.net/c5ec9158/uploads/origins/935ce4df-bced-47dd-aaca-fc5b3738efc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3da9a02364d8712e23fbec2c1472e7a", "thumbnail_srcset": "https://si.imgix.net/c5ec9158/uploads/origins/935ce4df-bced-47dd-aaca-fc5b3738efc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3da9a02364d8712e23fbec2c1472e7a, https://si.imgix.net/c5ec9158/uploads/origins/935ce4df-bced-47dd-aaca-fc5b3738efc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70da91ae91bf2c64319e63eb9afec9a3 2x, https://si.imgix.net/c5ec9158/uploads/origins/935ce4df-bced-47dd-aaca-fc5b3738efc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=462148f48a0c885005f0f6e3ce3530a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}