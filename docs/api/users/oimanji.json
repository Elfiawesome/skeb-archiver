net/2d5b7c49/uploads/origins/6fd2d114-1635-4c34-8ede-3d3a0b61dc87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530d5f07e8fd250d18fabdbff05dd3a7", "thumbnail_srcset": "https://si.imgix.net/2d5b7c49/uploads/origins/6fd2d114-1635-4c34-8ede-3d3a0b61dc87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530d5f07e8fd250d18fabdbff05dd3a7, https://si.imgix.net/2d5b7c49/uploads/origins/6fd2d114-1635-4c34-8ede-3d3a0b61dc87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b98e7b26aab6a1703949f149ca40c0d 2x, https://si.imgix.net/2d5b7c49/uploads/origins/6fd2d114-1635-4c34-8ede-3d3a0b61dc87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87b5a9a8e8b1efcd96878975728acb16 3x", "genre": "art", "nsfw": true, "body": "機動戦艦ナデシコのミスマル・ユリカが演算ユニットに組み込まれながら妊娠してしまったところをお願いします。\n以前描いていただいたDGレイン（妊婦）みたいな感じに、壁の埋まり具合や乳首の有無にケーブルなどは先月のリクエストのままで、お腹は臨月のように膨らんで乳房からは母乳が滴っている状態でお願いします。\n陰毛ありでお願いします。\nご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1oP_k1sFUaoQVKdTUZuG2BlY5UWaJPk9G?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1471", "thumbnail_src": "https://si.imgix.net/07023291/uploads/origins/185fb3b4-1310-4d67-86fb-e94dbcb7acfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1754244745596f34bd0cec4a4785efa", "thumbnail_srcset": "https://si.imgix.net/07023291/uploads/origins/185fb3b4-1310-4d67-86fb-e94dbcb7acfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1754244745596f34bd0cec4a4785efa, https://si.imgix.net/07023291/uploads/origins/185fb3b4-1310-4d67-86fb-e94dbcb7acfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=963ab520bd11456d6561edb4f8877514 2x, https://si.imgix.net/07023291/uploads/origins/185fb3b4-1310-4d67-86fb-e94dbcb7acfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=263c1d62669609c19692f4ac1ae2fe8a 3x", "genre": "art", "nsfw": true, "body": "『カードキャプターさくら』の木之本桜が、第3話のバトルコスチュームを着ている姿。\nレオタードの股の部分がはっきりと見えています。\nhttps://skeb.jp/@oimanji/works/1244 の体が少し大人っぽいと同じ。\n\n第3話のバトルコスチュームの参考資料:\nhttps://lmk.suppi.net/costume-episode3.php\nhttps://ccsakura.fandom.com/wiki/Episode_3_Battle_Costume\n\nhttps://lmk.suppi.net/costume-episode3.php", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1470", "thumbnail_src": "https://si.imgix.net/327295a9/uploads/origins/449c7142-a1ee-43a0-94f9-97c0ae4d4802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=627bdd73453b8aa762768da73eee32bb", "thumbnail_srcset": "https://si.imgix.net/327295a9/uploads/origins/449c7142-a1ee-43a0-94f9-97c0ae4d4802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=627bdd73453b8aa762768da73eee32bb, https://si.imgix.net/327295a9/uploads/origins/449c7142-a1ee-43a0-94f9-97c0ae4d4802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02dece0392b628c292e4de94ead77638 2x, https://si.imgix.net/327295a9/uploads/origins/449c7142-a1ee-43a0-94f9-97c0ae4d4802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12198b5769f95a59df5edd08c9c942da 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\nよろしければ承認お願い致します\n\nキュアセレーネが敵に捕まり、M字開脚のまま拘束され、アソコに焼けた鉄パイプを挿入されて泣き叫んでいるイラストをお願いします\nセレーネはなるべく着衣のまま\n敵は描写なくてもOKです\n可能でしたら、挿入後抜き取られて絶望している姿、挿入前の恐怖顔もあると嬉しいです(無理そうでしたら挿入中のをメインで)\n\n資料おつけしますので参考に(主に4がメインです)\nよろしくお願いします\n\nhttps://www.dropbox.com/scl/fo/cywn4amv12cupvffrtci8/AHaNolrRLm5FsXJZX9oWr6k?rlkey=sp93xqkd65841538uswghapm3&st=do8j84d7&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1469", "thumbnail_src": "https://si.imgix.net/f6c04934/uploads/origins/6add1a69-9512-407d-8c29-3da332325571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6435c621ad03430f75ff1e6081eff7a", "thumbnail_srcset": "https://si.imgix.net/f6c04934/uploads/origins/6add1a69-9512-407d-8c29-3da332325571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6435c621ad03430f75ff1e6081eff7a, https://si.imgix.net/f6c04934/uploads/origins/6add1a69-9512-407d-8c29-3da332325571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=647b1c10e17b5871e5c7aec7f354c5ee 2x, https://si.imgix.net/f6c04934/uploads/origins/6add1a69-9512-407d-8c29-3da332325571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d40f8eb5fc5321ddcd4afce32f138d88 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nタイミングを逃してしまいましたがまたひとつ私の趣味にお付き合いいただけたら幸いです。\n\n小説「ゴブリンスレイヤー」より\n『【剣の乙女衣装の女神官】がゴブリンスレイヤーに尻を触られている様子』を\nこのような構図【https://drive.google.com/file/d/1GluKZ0x5kjkB4ilj4HWDawRw1i61NRsP/view?usp=sharing】でお願いします（赤枠で囲った範囲）\n\n○女神官\n・衣装のサイズが合ってない感じでガバガバ\n・錫杖を両手持ち\n・やや困惑しつつも微笑み\n・視線はゴブリンスレイヤーの顔または手\n・胸は盛らないでください\n○ゴブリンスレイヤー\n・横辺りに立ち、服の隙間から手を挿し入れて直接尻に触れている（掴み、揉みではない）\n・『装備を確認しているだけ』と云う感じの素っ気ない雰囲気\n・ほぼ見切れていて構いません\n\n○補遺\n・昼、順光\n・背景不要、透過pngでお願いします\n・どちらも衣装がややこしいのである程度の簡略化は仕方ないかと…\n\n衣装（布質）イメージ参考\nhttps://drive.google.com/drive/folders/1oekmqONV27lj4zxc3O0ijG7M0dGAxwIZ?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1CLM--np5N3iQtO8meVfZBa7EidV-tcCX?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1468", "thumbnail_src": "https://si.imgix.net/35baec17/uploads/origins/795c707b-202b-4073-8196-eafffe024906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a65ee5839b15f8c5aad9c03781fffb87", "thumbnail_srcset": "https://si.imgix.net/35baec17/uploads/origins/795c707b-202b-4073-8196-eafffe024906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a65ee5839b15f8c5aad9c03781fffb87, https://si.imgix.net/35baec17/uploads/origins/795c707b-202b-4073-8196-eafffe024906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99a3c905ab837dd10e88d1287f1c80fd 2x, https://si.imgix.net/35baec17/uploads/origins/795c707b-202b-4073-8196-eafffe024906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c221c14833bea8d3354a1c368dd4597 3x", "genre": "art", "nsfw": true, "body": "またお願いします。今度はドキドキプリキュアのアリスを描いてほしいです。彼女は透け感のあるベビードールのランジェリーを着ています（胸を少し大きく描いてほしいです。また股間に少し陰毛を描いてください）。アリスはセックスを強く望んでおり、指で挿入のジェスチャーをしています。男性の勃起したペニスが反応し、アリスの要求を満たす準備ができています。改めて感謝します。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1467", "thumbnail_src": "https://si.imgix.net/3d4fb234/uploads/origins/b445a464-836d-49a3-9e4e-bb427c1b03af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cfc286d5db98b7f2133d0cc981f1c1e", "thumbnail_srcset": "https://si.imgix.net/3d4fb234/uploads/origins/b445a464-836d-49a3-9e4e-bb427c1b03af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cfc286d5db98b7f2133d0cc981f1c1e, https://si.imgix.net/3d4fb234/uploads/origins/b445a464-836d-49a3-9e4e-bb427c1b03af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bf40d59fab86f22bb3b5bd2b2efecde 2x, https://si.imgix.net/3d4fb234/uploads/origins/b445a464-836d-49a3-9e4e-bb427c1b03af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96a5bd00c63d7fe806ee22a3e511125d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1466", "thumbnail_src": "https://si.imgix.net/b18d6ea3/uploads/origins/cdcb7d65-3a7e-4e4f-bc9d-f39c15241a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e8a49244fbfa931700920dd2f