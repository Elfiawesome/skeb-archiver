/uploads/origins/858d8fc3-afe8-46ca-b1eb-93c42f181d23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca0a475114cb1b7d9d070a4f0c0985e9", "thumbnail_srcset": "https://si.imgix.net/73ddbc32/uploads/origins/858d8fc3-afe8-46ca-b1eb-93c42f181d23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca0a475114cb1b7d9d070a4f0c0985e9, https://si.imgix.net/73ddbc32/uploads/origins/858d8fc3-afe8-46ca-b1eb-93c42f181d23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6db3ae3412dc869cfad5d0e1db13b2f6 2x, https://si.imgix.net/73ddbc32/uploads/origins/858d8fc3-afe8-46ca-b1eb-93c42f181d23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7dfdc4e4545695eca336bfb66c91b90 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1464", "thumbnail_src": "https://si.imgix.net/d9f99fa0/uploads/origins/21328ff6-7e7c-4d68-89e1-ac9f3e16b8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43fe8ab8024e3f42d1ef322df1a6190c", "thumbnail_srcset": "https://si.imgix.net/d9f99fa0/uploads/origins/21328ff6-7e7c-4d68-89e1-ac9f3e16b8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43fe8ab8024e3f42d1ef322df1a6190c, https://si.imgix.net/d9f99fa0/uploads/origins/21328ff6-7e7c-4d68-89e1-ac9f3e16b8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0edb21418150ab4fcd7d40fb86d18aeb 2x, https://si.imgix.net/d9f99fa0/uploads/origins/21328ff6-7e7c-4d68-89e1-ac9f3e16b8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=016123ec2e0466dcdee175c4fde9944c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1463", "thumbnail_src": "https://si.imgix.net/7a210f9f/uploads/origins/87132961-0bde-4afe-a902-677e75ef2646?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920f38b433f933423283b0fee3d2a2b2", "thumbnail_srcset": "https://si.imgix.net/7a210f9f/uploads/origins/87132961-0bde-4afe-a902-677e75ef2646?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920f38b433f933423283b0fee3d2a2b2, https://si.imgix.net/7a210f9f/uploads/origins/87132961-0bde-4afe-a902-677e75ef2646?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52ab17b0dac1576082498b55c2b55d48 2x, https://si.imgix.net/7a210f9f/uploads/origins/87132961-0bde-4afe-a902-677e75ef2646?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cae8ee9035bf99e2672af4584332705 3x", "genre": "art", "nsfw": true, "body": "先日はありがとうございました\nリクエスト失礼します\n\n名探偵プリキュアの帆羽くれあがモブ竿役に背後から犯されるイラストをお願いします\nコスチュームは着衣状態でパティシエ服でお願いします\n\n先生の過去作、こちらを参考に構図などは先生にお任せします\nhttps://skeb.jp/@oimanji/works/1226\n\nキャラの資料も下記にお付けします\n\nhttps://www.toei-anim.co.jp/tv/precure/character/people.php?chara=kurea_howa", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1462", "thumbnail_src": "https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c6e3eb83da083fb2c63a071aac5b3a", "thumbnail_srcset": "https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c6e3eb83da083fb2c63a071aac5b3a, https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94138e49e14e6b5114e56aa845c84a0e 2x, https://si.imgix.net/a0c51e98/uploads/origins/a24136d0-1493-43d7-9570-3f8b0208b198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=612fd1befb664d2c68271a2af44694e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1461", "thumbnail_src": "https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854794e2f60700c44f90c80f5f175e19", "thumbnail_srcset": "https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854794e2f60700c44f90c80f5f175e19, https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da60568d8c013dd6ac0d9637559527dc 2x, https://si.imgix.net/47e513f9/uploads/origins/37197985-ffdb-47ef-b245-8f67e3ba61f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8698d3c400be2225334719d4f34e0f19 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\n\"借り暮らしのアリエッティ”のアリエッティちゃんの状況を見たいのですが。アリエッティちゃんは盗みながら隣人の子供に捕らえられ、今ではかわいい裸のペットとして飼われています。絵の中で、彼女のヘアクリップを除いて裸で、彼女の所有者の部屋で四つんばいで這うアリエッティを描いてください ​彼女は良い子のように所有者の巨大な指から餌をなめています。彼女は屈辱を受け、不幸ですが、適度によく訓練ており従順です。彼女の身長は10cm弱で.", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1460", "thumbnail_src": "https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a604e57c810e44e39bbfac775e5919", "thumbnail_srcset": "https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a604e57c810e44e39bbfac775e5919, https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d4b95a5b8d3af149e1a1901384c98f1 2x, https://si.imgix.net/603b9cf0/uploads/origins/119a687a-94c9-4852-853c-84ab5dde8223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bc0f2d1829beff7da245fbf5470abb0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1459", "thumbnail_src": "https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5416a12f39281c9b1b18e300467f272c", "thumbnail_srcset": "https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5416a12f39281c9b1b18e300467f272c, https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e08a9b5b0e27e1f1ff1b13b1ddf868ef 2x, https://si.imgix.net/d9ea818b/uploads/origins/8cdd59ed-45cd-492c-abda-295b5f320e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe0fa7a963e4b3a13c6263ac91c4bfaf 3x", "genre": "art", "nsfw": true, "body": "ハイスクールD×D、アーシア・アルジェント、スケベ修道女の衣装、対面座位ベロチュー、チャラ男と", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1458", "thumbnail_src": "https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=521b59dff02d708e2384e39542fffbff", "thumbnail_srcset": "https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=521b59dff02d708e2384e39542fffbff, https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26074200a5455322cd76ed5909bf75a0 2x, https://si.imgix.net/adacd291/uploads/origins/36080770-8749-4c3c-a159-2ae076b55424?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fa2791fbc94f5acc83187a6d27c963e 3x", "genre": "art", "nsfw": false, "body": "はじめまして。自分が見たいキャラのシチュエーションなので、リクエストさせていただきます。\nキャラクター→白井日菜子(ブルーリフレクション)\nシチュエーション→戦闘時のコスチューム(リフレクター)姿で、髪や眼の色は変身前の状態(プリキュアシリーズで言うミッドフォーム)。\n表情は強敵を倒した清々しい笑顔でお願いします。\n\nhttps://social.gust.co.jp/gakkou/chara_01.html", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1457", "thumbnail_src": "https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f7f6c5d1d2ab650cefdf79d33fbc94c", "thumbnail_srcset": "https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f7f6c5d1d2ab650cefdf79d33fbc94c, https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b035ca76ecee3fce9c14baf041f73642 2x, https://si.imgix.net/6d2bc531/uploads/origins/340842e0-106b-44ee-9eb0-a5a23255dc93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed8bdf272ef2c7905d33ebe975345cb2 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n匿名で失礼します\n\n機動戦士Vガンダムより\nシャクティ・カリンが下記資料のトップイラストの村娘の様な服装で、上着を片手でぺろんと捲っておっぱいを露出、スカートも捲り上げて下着を着けていない秘所が顕になった状態で、秘所をもう片方の手でくぱぁしているイラストをお願い致します。\n\n\nご検討の程、よろしくお願い致します！\n\n以下資料です。\nhttps://dic.pixiv.net/a/%E3%82%B7%E3%83%A3%E3%82%AF%E3%83%86%E3%82%A3%E3%83%BB%E3%82%AB%E3%83%AA%E3%83%B3", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1456", "thumbnail_src": "https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5ada4f9d76ccaae001c3a55558bf227", "thumbnail_srcset": "https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5ada4f9d76ccaae001c3a55558bf227, https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2b37152777f0634bd0c879e9afc9c74 2x, https://si.imgix.net/9e47d982/uploads/origins/08ed05ae-3560-419d-8e81-7a72f048be56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e71d6da43df37b89b04dcd6978759f6a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1455", "thumbnail_src": "https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02e388e42320420a4ba850b125eea7cc", "thumbnail_srcset": "https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02e388e42320420a4ba850b125eea7cc, https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04316b08d0e787366c9fe4e8ee7a522c 2x, https://si.imgix.net/0269916b/uploads/origins/5e7366b4-2f90-4d6f-9677-0e014b35cb55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b47e952b59eadfa5af18ba0f698020bd 3x", "genre": "art", "nsfw": true, "body": "前回の納品からすぐにで恐縮ですが、リクエストさせていただきます！\nシャニマスの大崎甘奈ちゃんが、和式トイレで下痢ウンチを排泄しているシーンを、カラーのイラスト形式でお願いします。\n排泄時の効果音（ブリブリビチビチなど……）は必ず入れてください。\n\n服装は通常の制服（参考URL→https://imassc.gamedbs.jp/image/card/still/1611632395256_05jbtycq.jpg）で、少し染みつき白パンツ、黒のハイソックス、こげ茶色のローファー着用でお願いします。\n\n排泄シーンの構図は前回の真乃ちゃん（https://skeb.jp/@oimanji/works/1318）と同じ構図でお願いします。\n\n以上です。\n前回同様情報量が多いですが、是非ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1454", "thumbnail_src": "https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09acc8935865ff3ef8a725c0dbfee9d5", "thumbnail_srcset": "https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09acc8935865ff3ef8a725c0dbfee9d5, https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9927914bbb9608e20bdbbcc6563c8a59 2x, https://si.imgix.net/d4d104f8/uploads/origins/d7faa632-448a-4bd3-bf49-4da8ee92a575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d340e2ed5d72045fbf6f64735e68e577 3x", "genre": "art", "nsfw": true, "body": "おいまんじさんこんにちは、お久しぶりです。\n今回のリクエストですが「名探偵プリキュア！」よりキュアアルカナ・シャドウを触手で尿道責めして連続絶頂させて欲しいです。\n\n衣服はそのままにパンツだけ脱がせて、大股開きのポーズで拘束し、細長い触手でアソコを拡張し、イボイボトゲトゲだらけの極細触手でおしっこの穴を残像が見えるほど激しくピストン責めしてください。\nアソコの拡張は尿道口や子宮口がよく見えるように描いて欲しいです。\n可能であれば更に高速化していく尿道ピストンと色んなイキ顔＆泣き顔の表情を、金額の見合う範囲でお願いしたいです。\n\n加速度的にインフレしていく尿道快楽責めに文字通り連続絶頂するキュアアルカナ・シャドウをぜひよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1453", "thumbnail_src": "https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b18350d3c922d28b5590f678e6cc6392", "thumbnail_srcset": "https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b18350d3c922d28b5590f678e6cc6392, https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6503879da443b842fa0676e0137504d8 2x, https://si.imgix.net/1f1183f0/uploads/origins/061d8d5f-c09e-48f7-b2a6-f48df9727217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a50a58e242753a9d8abe107733d2006 3x", "genre": "art", "nsfw": true, "body": "抱き枕風イラストでベッドで寝そべる名探偵プリキュアの明智あんなをリクエストします。\nあんなの服装はソックス着用のパンツ一枚で、下着は肌に密着したリボン付のジュニアショーツでお願いします。\n構図はFANBOXで描かれた下記イラストを参考にしていただけると嬉しいです。\nhttps://www.fanbox.cc/@oimanji/posts/10928721", "created_at": "", "completed_at": ""}, {"path": "/@oimanji/works/1452", "thumbnail_src": "https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2355a3fb8d5b6c8873aa7dfaf67c4189", "thumbnail_srcset": "https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2355a3fb8d5b6c8873aa7dfaf67c4189, https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88a71bcfdd3119e415bc1c1c5dcd9aa4 2x, https://si.imgix.net/541d371a/uploads/origins/fdbe579d-53b3-4579-aeac-cce3c7b45f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c9abf074ff3af349543fc9c6bc4a56c 3x", "genre": "art", "nsfw": true, "body": "おいまんじ様、また秘密戦隊ゴレンジャーからペギー松山をリクエストさせてください。\n下記アドレスのイラストのように、頭を捕まれ両目を開き涙を流しアップで（両胸より上を描いてください、下半身は描かないでください）黒十字軍兵士にフェラチオをされている姿をお願いします。\nhttps://x.com/oreizmmiporin/status/1975840989249216567\nいつもの黄色のベストで両胸が開けて赤いハートのペンダントとイヤリングも着けていている状態で、口から精液が溢れています。\n是非お願いいたします。", "created_at": "", "completed_at": ""}]}