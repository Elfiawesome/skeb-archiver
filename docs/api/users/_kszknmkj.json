fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c37df6f755dc745919a86803f917bf42 2x, https://si.imgix.net/bc71ac15/uploads/origins/bd1a5728-be9d-47cc-ae69-6450e8a6476e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d77db0f960dcf70ef7bf2a5adf2af4d 3x", "genre": "art", "nsfw": false, "body": "あたパさん、こんにちは！私はあなたの画風とがとても好きです！\nもし可能であれば、私のOCを描いていただけないでしょうか？\n\n💖参考URLから描きたいOCを選んでください！\n\nお好きな衣装を選んで彼女（たち）を描いていただけると嬉しいです。もし衣装のディテールを調整したり、新しい衣装を描いたりしていただいても大丈夫です！動作や構図など、すべてお任せします。\n\n依頼内容と金額が見合わない・その他不備などがあれば、お気軽に再送要請してください。ご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/folder/d/1lOKbMaXFD0tN775Tl64xyMtTcSoXls-K", "created_at": "", "completed_at": ""}, {"path": "/@_kszknmkj/works/43", "thumbnail_src": "https://si.imgix.net/c4d4a23b/uploads/origins/111ec4b8-eb29-4319-995f-f3e8081bcb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecbb3c198b9c82247b4ac11ded8bbfb0", "thumbnail_srcset": "https://si.imgix.net/c4d4a23b/uploads/origins/111ec4b8-eb29-4319-995f-f3e8081bcb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecbb3c198b9c82247b4ac11ded8bbfb0, https://si.imgix.net/c4d4a23b/uploads/origins/111ec4b8-eb29-4319-995f-f3e8081bcb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abec3259262c332a1847eac674b7e4b6 2x, https://si.imgix.net/c4d4a23b/uploads/origins/111ec4b8-eb29-4319-995f-f3e8081bcb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94548ac08e248eb00d41a11aa854697f 3x", "genre": "art", "nsfw": false, "body": "あたパ様、初めまして！\nskebのイラストを拝見し、どのイラストも可愛くで、私はとても大好きです！\n\n私のオリジナルキャラクターを描けるたら嬉しいです。\n\nキャラクターA（紫の髪）\n性格は明るくて、人と話すことが上手。ちょっと腹黒いところがあって、よくBを意地悪する。\nキャラクターB（目の色が違う）\n内向型、Aに対する依存している。そそっかしいのタイプ、大食いなやつ。\n\nこの2人元々試験室で生まれた怪物、今の姿は偽装。普段はこのまま人間のように生活している。\n\n特に指定したいものはないので、先生が自由に描いてください。\n\nご検討をお願いします。\n金額が足りない場合、再送要請をお願い致します。\nリクエストを読んでいただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1N-It-jxoYYK-z