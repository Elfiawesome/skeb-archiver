4ed03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b0796d52540cc514aa5150df325e2c9 2x, https://si.imgix.net/dc0de663/uploads/origins/0b6fa83b-94cd-4efe-9f96-7c2b5584ed03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5109137c0c5720b8fbbf992b45172379 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。Xのポストを拝見いたしましたので依頼を送らせて頂きます。よろしくお願いします。\n☆★☆★☆★☆★☆★☆★☆★☆★\n①コナミが昔出していたキッズメダルゲーム・「リッキー君」のダムダムボーイ版をお願いします。\nhttps://drive.google.com/file/d/1_Ydf17H9GUzz8kEO8Zh5RNTlNfxfZnr7/view?usp=drive_link\n②全身　もしくは　膝上まで\n③カラー\n④構図　：練習や試合後の汗かいて顔が上気して赤くなってる。はにかんだ笑顔←重要！　\n⑤６～７頭身　くらいで\n⑥背景　：お任せ\n⑦服装　：バスケユニフォーム　丈は昔の超短いやつで←超重要！\n\nhttps://drive.google.com/drive/folders/1PgWNe95T0umxyOXuog5aMGbX6Lhf_H3S?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/58", "thumbnail_src": "https://si.imgix.net/29164ec1/uploads/origins/a3f30423-bafe-4d4b-bf9f-83efe24c11fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f56e107172e608452c25960962fd4939", "thumbnail_srcset": "https://si.imgix.net/29164ec1/uploads/origins/a3f30423-bafe-4d4b-bf9f-83efe24c11fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f56e107172e608452c25960962fd4939, https://si.imgix.net/29164ec1/uploads/origins/a3f30423-bafe-4d4b-bf9f-83efe24c11fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=127f93311c98dbb0e5e262946735a564 2x, https://si.imgix.net/29164ec1/uploads/origins/a3f30423-bafe-4d4b-bf9f-83efe24c11fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbc005f298b129783b5b02175e47883c 3x", "genre": "art", "nsfw": false, "body": "ウェストメゾン様\n\nお世話になっております。\n何度か、いわゆるウチの子を描いてもらってますが、今回はナコルルをお願いします。\nただ今進行中の企画には普通に描いてもらっても何となく合わないので、SNKヒロインズのヴァンパイア衣装でお願いします。\n\n構図と衣装は以下のリンクです。\n\nhttps://x.com/zettai_GU/status/1968314144983244915/photo/1\n\n彼女のトレードマークの赤いリボンは付けてください。\n片足を立て、片手は頭の後ろ。表情は少し色っぽく(画像はウィンクさせていますが、任せます)\n少し垢ぬけて、頑張って誘惑してみた感じに。\n画像は鼠径部が露出してるので、描くのに抵抗があれば、あくまで構図例ですので、構図角度を変えたり、足で隠してもらって構いません。\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/57", "thumbnail_src": "https://si.imgix.net/477c6e90/uploads/origins/46d1f985-49a6-49fd-82f1-e506cd3cb053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b7eebe5ad335b9088f368c27aabbc24", "thumbnail_srcset": "https://si.imgix.net/477c6e90/uploads/origins/46d1f985-49a6-49fd-82f1-e506cd3cb053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b7eebe5ad335b9088f368c27aabbc24, https://si.imgix.net/477c6e90/uploads/origins/46d1f985-49a6-49fd-82f1-e506cd3cb053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=287c8d825b8399adf21b6f847816064d 2x, https://si.imgix.net/477c6e90/uploads/origins/46d1f985-49a6-49fd-82f1-e506cd3cb053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa5c185eb92021fa040de3e6b46dd92e 3x", "genre": "art", "nsfw": false, "body": "何時も何時もすいません！今回「赤城さん」よろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/56", "thumbnail_src": "https://si.imgix.net/6733c894/uploads/origins/b9cb12cf-82e6-49c9-ac7f-26a06a0cedb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f1d7574dca076c8dab857af259631a", "thumbnail_srcset": "https://si.imgix.net/6733c894/uploads/origins/b9cb12cf-82e6-49c9-ac7f-26a06a0cedb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f1d7574dca076c8dab857af259631a, https://si.imgix.net/6733c894/uploads/origins/b9cb12cf-82e6-49c9-ac7f-26a06a0cedb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dac91683bb4cb3e70df5a6d398685e24 2x, https://si.imgix.net/6733c894/uploads/origins/b9cb12cf-82e6-49c9-ac7f-26a06a0cedb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85dbad3081eca9615c472eff83d98766 3x", "genre": "art", "nsfw": false, "body": "ウェストメゾン様。匿名にて失礼します。\nスターグラディエイターのジューン＆エルをリクエストします。\nコスチュームは「ジャスティス学園」の若葉ひなたと同じ太陽学園の制服（夏服）でお願いします。（https://pbs.twimg.com/media/FHNv5nqaMAgc1wf?format=jpg&name=large）\n2人ともネクタイの色は赤ですが、制服の色はジェーンがピンク色で、エルがオレンジ色になります。\n\n以上、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/55", "thumbnail_src": "https://si.imgix.net/19401549/uploads/origins/c9a6fce3-9bb6-4d09-beae-dea654f8d151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5d4499bedb5cee8b95589a81400891b", "thumbnail_srcset": "https://si.imgix.net/19401549/uploads/origins/c9a6fce3-9bb6-4d09-beae-dea654f8d151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5d4499bedb5cee8b95589a81400891b, https://si.imgix.net/19401549/uploads/origins/c9a6fce3-9bb6-4d09-beae-dea654f8d151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77fdc46f86a94f28b26323eb9ca243bb 2x, https://si.imgix.net/19401549/uploads/origins/c9a6fce3-9bb6-4d09-beae-dea654f8d151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de3dfa63ea31bbe18028a3999b6cbf62 3x", "genre": "art", "nsfw": false, "body": "今回は、ライダースーツを着てヘルメットを抱えてる憲磨呂と、レースクイーンの格好した風間あきらの立ち姿が見たいです！\nあきらの依頼で憲磨呂にパワードアキラの（あきらと同じ）ライダースーツ姿でレースに出場し、彼を励まし喜ばせるためにあきらが自らレースクイーンになってるというシチュエーションになります。\nあきらの水着は、「SR カプコンギャルズ サマーコレクション」に登場したシャドルーガールズ（キャミィ，ユーリ，ユーニ）が着ていたもので。カラーリングは3種類（通常カラー：黒＋ピンク，別カラー：白＋青，限定カラー：銀＋ピンク）ありましたが、通常カラーを選択します。ロベルト三浦と同じサンバイザーと、春日野さくら（ストV - デフォルトコス）がつけていた耳掛けコンデンサーマイクを追加して下さい。バイザーの色は通常と限定版に合わせてピンク※になりますが、ロベルトみたいに顔（目）を隠しません。あきらの持つイベント傘（ゴルフ傘）の色はピンク※＆白（2色コンビ）です。\n2人とも少し照れながら微笑んでます。\n※別カラー版（白＋青）の場合は青になります。\n\n以上で、ご検討ほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/54", "thumbnail_src": "https://si.imgix.net/6085a1ce/uploads/origins/dd843c84-95f1-4bd2-8b87-1f0ecc0bff1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6c454aaa4e3493184ebf52e7114c1cd", "thumbnail_srcset": "https://si.imgix.net/6085a1ce/uploads/origins/dd843c84-95f1-4bd2-8b87-1f0ecc0bff1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6c454aaa4e3493184ebf52e7114c1cd, https://si.imgix.net/6085a1ce/uploads/origins/dd843c84-95f1-4bd2-8b87-1f0ecc0bff1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=694d705260873a7669077ccd57bb502b 2x, https://si.imgix.net/6085a1ce/uploads/origins/dd843c84-95f1-4bd2-8b87-1f0ecc0bff1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3c8f0975c3e86227efb72dd53d2c461 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。今回はタイムセール開催という事で久しぶりのリクエストしたいと思います。今回リクエストしたいのは飛龍の拳の5人の龍戦士です。イメージとしてはミンミンを中心に龍飛やハヤト、ワイラーと昇龍を周りに配置する感じでミンミンのみ全身が映る以外他の龍戦士は構図と配置、ポーズと表情は全てお任せします。(ミンミンの表情とポーズもお任せします)是非ともご検討宜しくお願い致します。\n\nhttps://x.com/fujimya/status/851027206545354752", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/53", "thumbnail_src": "https://si.imgix.net/672cb1cf/uploads/origins/337e11da-16dd-4380-a71e-3db2feebf5ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a4fabf0c3b2769fb8e6dcc451f4b824", "thumbnail_srcset": "https://si.imgix.net/672cb1cf/uploads/origins/337e11da-16dd-4380-a71e-3db2feebf5ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a4fabf0c3b2769fb8e6dcc451f4b824, https://si.imgix.net/672cb1cf/uploads/origins/337e11da-16dd-4380-a71e-3db2feebf5ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a48e5a3853ec183e2d42a49d91491550 2x, https://si.imgix.net/672cb1cf/uploads/origins/337e11da-16dd-4380-a71e-3db2feebf5ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4de984ed485beda3d7a7102edeb115c8 3x", "genre": "art", "nsfw": false, "body": "ウェストメゾン様\n\n先日はアバターキャラを描いていただき、ありがとうございます。\n\n結婚記念日を祝ってと言うところで、依頼をしやすく手を打たれていましたので、みたびウチの子をお願いいたします。\n\n今回はファンタシースターユニバースの女性キャラです。\n\nhttps://x.com/zettai_gu/status/1939671658748608650?s=46&t=iD4SV4doJXh9VFySou4hcg\n\n以前描いていただいたハニュエールと同一人物と解釈してもらえたら。\n補足として\n\n①下半身の網タイツ\n本来、甲冑の下履きと鎖かたびらの様なデザインなのですが、ここでは普通の黒系のハーフパンツとシーム入りの網タイツとお考えください。\n\n②服の模様の色が資料それぞれ異なっていますが、白色でお願いいたします。\n\n③髪の色は前回のイラストより、やや淡いピンク色で。\n\n④今回の武器です。\n本来なら先端の三又は閉じていて戦闘時だけ写真の様に開きますが、この開いた形状で。\n\nhttps://x.com/zettai_gu/status/1939683803175551016?s=46&t=iD4SV4doJXh9VFySou4hcg\n\n構図はお任せいたします。\n欲を言えば足先までの全身像を描いていただきたいです。\n\n以上の内容になります。\n\nご多忙の中、恐れ入りますがご検討をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/52", "thumbnail_src": "https://si.imgix.net/1f3d497d/uploads/origins/8b42f23b-3a52-4db2-9662-9fd8956f7802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c3750ea495dca8a1c9bcfafa22c912d", "thumbnail_srcset": "https://si.imgix.net/1f3d497d/uploads/origins/8b42f23b-3a52-4db2-9662-9fd8956f7802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c3750ea495dca8a1c9bcfafa22c912d, https://si.imgix.net/1f3d497d/uploads/origins/8b42f23b-3a52-4db2-9662-9fd8956f7802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e3d2a6da9f06e487d57bc01e696f926 2x, https://si.imgix.net/1f3d497d/uploads/origins/8b42f23b-3a52-4db2-9662-9fd8956f7802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7d9ec0eacaafd87fc44845d6d41942b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/51", "thumbnail_src": "https://si.imgix.net/0026b7fc/uploads/outputs/7a6d5d81-9786-489e-a39c-54b78c6af6a9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7c7a978d346232df7c0e7a96239db902", "thumbnail_srcset": "https://si.imgix.net/0026b7fc/uploads/outputs/7a6d5d81-9786-489e-a39c-54b78c6af6a9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7c7a978d346232df7c0e7a96239db902, https://si.imgix.net/0026b7fc/uploads/outputs/7a6d5d81-9786-489e-a39c-54b78c6af6a9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4188b9858a8cab6fc331f74257a524e5 2x, https://si.imgix.net/0026b7fc/uploads/outputs/7a6d5d81-9786-489e-a39c-54b78c6af6a9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a993b52f90a1c10cf3f60ed79fc8f38 3x", "genre": "video", "nsfw": false, "body": "今回はイングリッド(カプコン)と憲磨呂をリクエストします。\nイングリッドのお絵かき（魔法?!）で、憲磨呂が出現するという展開をムービーをお願いできませんか？\nイングリッドがササッと素早く（色づけも）憲磨呂の絵を描き上げた後、ツンと絵に指を当てる(サンアッパーもしくはサンデルタみたいな必殺技演出で)と、絵が光り本物の憲磨呂となって実体化するシーンが見たいです！\nご検討ほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/50", "thumbnail_src": "https://si.imgix.net/60349645/uploads/origins/ccb6aa27-f5f5-434f-9539-bb1854f2b076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9db87ee56dcba16e413c2f6ae5df7c", "thumbnail_srcset": "https://si.imgix.net/60349645/uploads/origins/ccb6aa27-f5f5-434f-9539-bb1854f2b076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9db87ee56dcba16e413c2f6ae5df7c, https://si.imgix.net/60349645/uploads/origins/ccb6aa27-f5f5-434f-9539-bb1854f2b076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ade1a2d3c3c0a0f651958ba23c057d69 2x, https://si.imgix.net/60349645/uploads/origins/ccb6aa27-f5f5-434f-9539-bb1854f2b076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2cda89566df39320518a04e3f22573e 3x", "genre": "art", "nsfw": false, "body": "こんばんは、いつも素敵なイラストをありがとうございます。\n\n今回のリクエストですが、オンラインゲーム「ファンタジーアースゼロ」の自キャラをSNS向けのアイコンイラスト仕様で描いていただきたいです。\n参考の画像はSNSのURLを記載します。\n\n描写については、全てお任せいたします。\n\nお手数おかけしますが、よろしくお願いいたします。\n\nhttps://x.com/_gelid/status/1510272616354893825", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/49", "thumbnail_src": "https://si.imgix.net/e2c4ecd8/uploads/origins/91fd7517-12cc-4ec0-b487-f6e1c9778043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4a04d6aa3de100a925d50c9fefc51a", "thumbnail_srcset": "https://si.imgix.net/e2c4ecd8/uploads/origins/91fd7517-12cc-4ec0-b487-f6e1c9778043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4a04d6aa3de100a925d50c9fefc51a, https://si.imgix.net/e2c4ecd8/uploads/origins/91fd7517-12cc-4ec0-b487-f6e1c9778043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28bbb1017df2a37ff6532c203b017e88 2x, https://si.imgix.net/e2c4ecd8/uploads/origins/91fd7517-12cc-4ec0-b487-f6e1c9778043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2c7972b1acb188c50f35c6a31feb25c 3x", "genre": "art", "nsfw": false, "body": "誕生日おめでとう！\n今回のリクエストは\n「レイメイズ」の里香とマコト！\n二人がサイバリオンのレイメイズルートにどう映るのか見てみたい。彼らは数歳年上で、違う服を着ているかもしれない...\n楽しんで描いてほしい！\n今回もよろしく～", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/48", "thumbnail_src": "https://si.imgix.net/5753f549/uploads/origins/4cc9c28e-7d01-4ada-89c3-86aba6c433ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbd8068279cdd65564fc588bb6cff10a", "thumbnail_srcset": "https://si.imgix.net/5753f549/uploads/origins/4cc9c28e-7d01-4ada-89c3-86aba6c433ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbd8068279cdd65564fc588bb6cff10a, https://si.imgix.net/5753f549/uploads/origins/4cc9c28e-7d01-4ada-89c3-86aba6c433ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fce7e7e34f3da4f55a08c8708e92e0fb 2x, https://si.imgix.net/5753f549/uploads/origins/4cc9c28e-7d01-4ada-89c3-86aba6c433ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32f8ef90dc8987624e63ff07896ca822 3x", "genre": "art", "nsfw": false, "body": "こんばんは、先日は素敵なイラストをありがとうございました。\n今回も前回と同様に、スーパーロボット大戦Kのミスト=レックスとゴーダンナーチームの光司鉄也のコンビを描いていただきたく依頼をいたしました。\n\n今回は2人がハイタッチをしている状況を描いていただきたいです。\n\n構図については全てお任せいたします。\n差し支えなければ、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/47", "thumbnail_src": "https://si.imgix.net/f67f267f/uploads/origins/ede5570b-e9a4-4525-8527-522a3c14d677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c084184107adf628a7d9d2cf4017ab9b", "thumbnail_srcset": "https://si.imgix.net/f67f267f/uploads/origins/ede5570b-e9a4-4525-8527-522a3c14d677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c084184107adf628a7d9d2cf4017ab9b, https://si.imgix.net/f67f267f/uploads/origins/ede5570b-e9a4-4525-8527-522a3c14d677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ed39acd3ac454fd52c15f32efb2d80a 2x, https://si.imgix.net/f67f267f/uploads/origins/ede5570b-e9a4-4525-8527-522a3c14d677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bd9511a91343b6a679fd60eeab173cf 3x", "genre": "art", "nsfw": false, "body": "先日はうちの子のハニュエールを描いていただき、ありがとうございました。\n\n再びうちの子をお願いしたいのですが、今回はファンタシースターユニバースの男性キャラです。\n私のXのアイコンのキャラですね。\n\n全身 https://x.com/zettai_gu/status/1912876388056752540?s=46&t=iD4SV4doJXh9VFySou4hcg \n\n顔のアップ https://x.com/zettai_gu/status/1916851015669662041?s=46&t=iD4SV4doJXh9VFySou4hcg\n肩の模様の色が資料それぞれ異なっていますが、白色でお願いいたします。\n\nシチュエーションは\n加えタバコ(フィルタがマールボロやラークのような茶色の紙巻きタバコ)で、引き締まった表情or不敵に微笑むような表情で。\n\n 所持してる武器  https://search.yahoo.co.jp/image/search?ei=UTF-8&p=スプレッドニードル&fr=applep2&aq=2&ai=1d5367b5144a780-11e4d1725c6ffc0-2316ce4cf738440-b71f60b9e86b50&oq=スプレッドニードル&aa=0&ts=4800&at=h&iau=1&x=nl  \n\nスプレッドニードルと言う物で、ライフル銃のような物ですが、無数の針を瞬時に飛ばす武器です。\n\nこのシチュエーションを取り入れて描いていただきたいです、構図はお任せいたします。\n以上の内容になります。\n\nご多忙の中、恐れ入りますがご検討をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/46", "thumbnail_src": "https://si.imgix.net/572305f4/uploads/origins/3bc44207-c7d5-43e0-9623-2d20d2085f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5fdb023b6b6f4c8728d7a3ef5ad74ad", "thumbnail_srcset": "https://si.imgix.net/572305f4/uploads/origins/3bc44207-c7d5-43e0-9623-2d20d2085f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5fdb023b6b6f4c8728d7a3ef5ad74ad, https://si.imgix.net/572305f4/uploads/origins/3bc44207-c7d5-43e0-9623-2d20d2085f95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d329ab92b434d82830fea486c3862ef 2x, https://si.imgix.net/572305f4/uploads/origins/3bc44207-c7d5-43e0-9623-2d20d2085f95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de027c07fae92a9f9b432df697089df8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ウェストメゾン様。匿名にて失礼します。\n\nキャミィ・ホワイト（ストリートファイター6）とアイルー（モンスターハンターワイルズ）をお願いできませんか？\nキャミィのコスチュームはスト6のOutfit1\nアイルー（装着/装備なし）：https://livedoor.blogimg.jp/are13-kuroko/imgs/0/7/077ab890.png \nhttps://img.gamewith.jp/img/83efd5f1bb12d1e12f57a6385b5feeaf.png　\n\n猫好きのキャミィがすごい笑顔で、アイルーをギューッと抱きしめ頬ずりしているイラストを描いていただければ幸いです。\nアイルーは恥ずかしがってる表情でお願いしたいです。\n\n内容は以上で、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/45", "thumbnail_src": "https://si.imgix.net/5b5cc87f/uploads/origins/241ac5f1-3dbc-4875-8d73-eb5bdbdc83d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3ecec310a3a76de1b0838d83a5c2f47", "thumbnail_srcset": "https://si.imgix.net/5b5cc87f/uploads/origins/241ac5f1-3dbc-4875-8d73-eb5bdbdc83d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3ecec310a3a76de1b0838d83a5c2f47, https://si.imgix.net/5b5cc87f/uploads/origins/241ac5f1-3dbc-4875-8d73-eb5bdbdc83d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ae4ced1ad9a1b4478b893ebf9858658 2x, https://si.imgix.net/5b5cc87f/uploads/origins/241ac5f1-3dbc-4875-8d73-eb5bdbdc83d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a08728076483233ba2e93eb4b4ee951 3x", "genre": "art", "nsfw": false, "body": "匿名にて失礼します。\n\nファミコンソフト『スペースハンター』の主人公『アルティアナ』を御願いできますでしょうか？\n\n資料URLの作品等が原作のイメージに近いように思いますので、よろしければ御確認くださいませ。\nできれば、全身が見切れずに入っている感じが望ましいです。\n\n割と原作ゲームの設定がシリアスな感じですので、\nそんな雰囲気を出して頂けると嬉しく思います。\n\n細かい部分が漠然としており申し訳ないことですが、以上につき御検討を願います。\nよろしく御願いいたします。\n\nhttps://www.pixiv.net/artworks/93003070", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/44", "thumbnail_src": "https://si.imgix.net/b41b47aa/uploads/origins/77384240-1e43-4b33-b3ab-5b9b056ab951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1556589245af9114318e731e692d44ad", "thumbnail_srcset": "https://si.imgix.net/b41b47aa/uploads/origins/77384240-1e43-4b33-b3ab-5b9b056ab951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1556589245af9114318e731e692d44ad, https://si.imgix.net/b41b47aa/uploads/origins/77384240-1e43-4b33-b3ab-5b9b056ab951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b3a6c186d4acc8884cb2e000d7e22c6 2x, https://si.imgix.net/b41b47aa/uploads/origins/77384240-1e43-4b33-b3ab-5b9b056ab951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=527459683cedd8d2f9210fed084c23d4 3x", "genre": "art", "nsfw": false, "body": "ウェストメゾン様\n\n前回のリクエスト企画、ありがとうございました。\n当選とはならなかったものの、ワクワクさせていただきました。\n\nさて、今回はリクエスト祭りと…、有償リクエストが出来ると言うことで一つ、はじめてリクエストさせていただきます。\n\nファンタシースターオンライン(初代)のいわゆる、うちの子を描いていただきたいです。\n昔のゲームで解像度が低くカメラも回せませんでした、申し訳ありませんがこちらがキャラクターの資料です。\n\nhttps://x.com/zettai_GU/status/1893809803123638383\n\n補足として\n画像1枚目\n布地以外は荒い目のメッシュ構造、下半身はハーフパンツと網タイツと足首までのヒールブーツ。\n左手だけグローブを装着しています。\n\n画像2枚目\n首輪(?)に入るセクションIDと言う物です。\nはそれぞれ名前に応じたIDが入っているのですが、1枚目資料は緑色ですが、撮影時に紫に変え忘れてました。\n2枚目の画像の紫色のIDでお願いします。\n\n画像3\n使用武器です。\n見た目が好きでよく使っていました。\n\nセクシーなハニューエールのお姉さんといった感じに当時キャラクターを作成した記憶があります。\n\n状況は非戦闘時。\n構図は脚線美を強調し、表情は微笑んでいる感じ。\n\n以上です。\nご多忙中と存じますが、ご検討をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@westmaison1/works/43", "th