6b54629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f56edf9b960dec9b2a17e6fe42fd6199, https://si.imgix.net/2096577d/uploads/origins/e4b9aeed-00cc-4b85-801f-3ab916b54629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=659643f8379464590945e83be2c5bdf4 2x, https://si.imgix.net/2096577d/uploads/origins/e4b9aeed-00cc-4b85-801f-3ab916b54629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ec119d7eea3d751cbaee036b2abb24e 3x", "genre": "art", "nsfw": false, "body": "せっかくいい機会なんでリクエストさせてください！\n勝負服姿のデアリングタクトをお願いします。\nシチュエーションは「勝負服に初めて袖を通して、ご機嫌に着心地を確かめてる」みたいな感じで。あとは、かにたまさんのお好きなようにおまかせします！", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/13", "thumbnail_src": "https://si.imgix.net/e95a15c2/uploads/origins/ccd7ca6e-736d-40d4-837b-af75e53486fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597ed4eddc9aa0056035c6b1d9e6d173", "thumbnail_srcset": "https://si.imgix.net/e95a15c2/uploads/origins/ccd7ca6e-736d-40d4-837b-af75e53486fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597ed4eddc9aa0056035c6b1d9e6d173, https://si.imgix.net/e95a15c2/uploads/origins/ccd7ca6e-736d-40d4-837b-af75e53486fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c88c64c575da087d911be381c58defb 2x, https://si.imgix.net/e95a15c2/uploads/origins/ccd7ca6e-736d-40d4-837b-af75e53486fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07f2669af20d35f4449635d27e8e9cea 3x", "genre": "art", "nsfw": false, "body": "いつもXにイラスト楽しみにしております！ハルです。\n\n今回依頼させていただく内容は海辺もしくはプールでのビキニ姿のヴィブロスをお願い致します。\n\nイメージとしてはトレーナーと2人で海もしくはプールへ遊びに来て、ヴィブロスが隠していたビキニを意気揚々と見せてくるところをトレーナー目線で見ているようなシチュです。\n\nポーズ、背景、ビキニのデザインなどはお任せします。また、可能であればマジマジと見られて照れて恥ずかしそうな顔や結局トレーナーのシャツを借りた差分もお願い致します。\n\n内容・使用用途について気が乗らない、スケジュールが合わない等ありましたらキャンセルしても構いません。 描いていただいた場合グッズ化していただいても問題ございません。（むしろ喜んで買います） ご都合のつく場合であればよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/12", "thumbnail_src": "https://si.imgix.net/4aafa92a/uploads/origins/66670274-792a-4700-876d-62b670e741fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd59624b8d8a90627100a243fddb999e", "thumbnail_srcset": "https://si.imgix.net/4aafa92a/uploads/origins/66670274-792a-4700-876d-62b670e741fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd59624b8d8a90627100a243fddb999e, https://si.imgix.net/4aafa92a/uploads/origins/66670274-792a-4700-876d-62b670e741fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1966f9ce8f3fd946fd0405bd5e288ef7 2x, https://si.imgix.net/4aafa92a/uploads/origins/66670274-792a-4700-876d-62b670e741fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b093f09a700f76e7d697f1167fa232cc 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nいつも素敵なイラストを見てます\nかにたまさんへの依頼ですが、『ゼンレスゾーンゼロ』に登場する『リナさん』をぜひ描いてもらいたいです\n衣装はビキニタイプの黒い水着で、背景は海辺でお願いします\nポーズや表情はおまかせします", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/11", "thumbnail_src": "https://si.imgix.net/14ad6b98/uploads/origins/7406ce0d-dc10-421e-bf9f-1f8362e3746f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb25052cf4ac3a8abc6b003031d7448a", "thumbnail_srcset": "https://si.imgix.net/14ad6b98/uploads/origins/7406ce0d-dc10-421e-bf9f-1f8362e3746f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb25052cf4ac3a8abc6b003031d7448a, https://si.imgix.net/14ad6b98/uploads/origins/7406ce0d-dc10-421e-bf9f-1f8362e3746f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed77d59bc6ccbe1a4937799a9287c8c0 2x, https://si.imgix.net/14ad6b98/uploads/origins/7406ce0d-dc10-421e-bf9f-1f8362e3746f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46ad6b133230af17dad67d1850ebc35c 3x", "genre": "art", "nsfw": false, "body": "かにたまさんお疲れ様です✨️\n前回は元気溢れるパワフルなポッケちゃんを描いていただき、ありがとうございました🙇‍♀️\n\n今回依頼させていただきたいイラストは、水着のヤマニンゼファーです！！\n今回は初の試みとして、他の絵師様(さめくじら様)にデザインしていただいた水着のゼファーを描いていただきたいです🙏🏻\n水着に関してのデザインはいただきましたので、資料の方をご確認ください🙇‍♀️\n\n構図は海(ビーチ)へバカンスに行っているようなイメージで、全身が写っている＋南国風の飲み物(トロピカルジュースみたいな感じです！)を取り入れた構図でお願いします！\n\n例えば…\n・風になびく帽子を片手で抑えながら、もう片方の手でトロピカルジュースを持っている\n・ビーチチェアで横になって気持ちよさそうにしている(テーブルにトロピカルジュース)\nみたいな感じです！\n\n上記の条件に合う、かにたまさんがこれだ！と思いついた構図で描いていただきたいです！！もちろん、私が例に出したような構図が1番鮮明に思い描けるなら、そちらで描いていただいても問題ありません！\n\n長くなってしまいましたが、よろしくお願いします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1-HB53qDlhujebNr021r-Tn4ZjlGixEVd", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/10", "thumbnail_src": "https://si.imgix.net/a54311b2/uploads/origins/569be75f-a37b-4407-9774-8193888aa817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1da61c76b65144ea1dc7bbf6ba7d30a1", "thumbnail_srcset": "https://si.imgix.net/a54311b2/uploads/origins/569be75f-a37b-4407-9774-8193888aa817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1da61c76b65144ea1dc7bbf6ba7d30a1, https://si.imgix.net/a54311b2/uploads/origins/569be75f-a37b-4407-9774-8193888aa817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a379b46670b18cb867cb2fa67e0808ea 2x, https://si.imgix.net/a54311b2/uploads/origins/569be75f-a37b-4407-9774-8193888aa817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c7e146ec53a6fac4c285d55e950459b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/9", "thumbnail_src": "https://si.imgix.net/09672a1a/uploads/origins/427768d1-8c08-4d90-bfb1-75c7fa8f1964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb2e8f003ff0a69ea8a21377169dac59", "thumbnail_srcset": "https://si.imgix.net/09672a1a/uploads/origins/427768d1-8c08-4d90-bfb1-75c7fa8f1964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb2e8f003ff0a69ea8a21377169dac59, https://si.imgix.net/09672a1a/uploads/origins/427768d1-8c08-4d90-bfb1-75c7fa8f1964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=066055d680e47bc39476e82dd215dd22 2x, https://si.imgix.net/09672a1a/uploads/origins/427768d1-8c08-4d90-bfb1-75c7fa8f1964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e5a6400ad0ce70de48e74edfa7a910a 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。リュウサイと申します。\n前回ブルボンのイラストをリクエストさせていただいた者です。\n\n前回はリクエストを受けていただきありがとうございました。とても可愛いブルボンを描いていただき大変満足しました。\nそこで今回も支援の気持ちも含めてかにたまさんにリクエストさせていただきます。\n\n題材はブルボンとデュランダルが担当トレーナーの取り合いをお願いします。\n\n引き受けていただけると嬉しいです。\n長文失礼しました。", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/8", "thumbnail_src": "https://si.imgix.net/10ebacdc/uploads/origins/d6bb6836-f0fc-4e94-94fc-31bf8453716e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=704244f8004e2671c30b6716a5ed5c29", "thumbnail_srcset": "https://si.imgix.net/10ebacdc/uploads/origins/d6bb6836-f0fc-4e94-94fc-31bf8453716e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=704244f8004e2671c30b6716a5ed5c29, https://si.imgix.net/10ebacdc/uploads/origins/d6bb6836-f0fc-4e94-94fc-31bf8453716e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d6002c8d0348871cdf785d04a5b4c4d 2x, https://si.imgix.net/10ebacdc/uploads/origins/d6bb6836-f0fc-4e94-94fc-31bf8453716e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc008207e1d58b875d9b6a2afa83faa6 3x", "genre": "art", "nsfw": true, "body": "NSFWイラストのリクエストを送らせていただきます。\nブルアカのユウカでぶっかけイラストをお願いします。\n\nベッドに全裸で座る(可能であればぺたん座りでお願いします)ユウカの全身に、濃厚な精液が大量にぶっかけられている感じでお願いします。\n\nまた、可能であれば、顔の前に両手を差し出して、目を瞑って口を開いて、「ぶっかけ待ち」の姿勢(表情)でいると最高です。\n射精している男性器もあると最高です。\n\nお肌はすべすべ、体つきはムチムチでお願いします。\n\n難しい依頼とは存じますが、よろしければ、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/7", "thumbnail_src": "https://si.imgix.net/633b7b41/uploads/origins/be7e42f5-2305-4db7-8993-afed940342ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d15d2395b70f460e90038145e6b9ee", "thumbnail_srcset": "https://si.imgix.net/633b7b41/uploads/origins/be7e42f5-2305-4db7-8993-afed940342ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d15d2395b70f460e90038145e6b9ee, https://si.imgix.net/633b7b41/uploads/origins/be7e42f5-2305-4db7-8993-afed940342ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e49cd48c417ea7a113bbe94bd836e765 2x, https://si.imgix.net/633b7b41/uploads/origins/be7e42f5-2305-4db7-8993-afed940342ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b472fdf142b31a8044c29ae6e5f5a31b 3x", "genre": "art", "nsfw": false, "body": "Twitterに投稿されていたヴィブロスやダンツのイラストを見て惹かれたので依頼させていただきます\n\n海岸に居る水色ビキニ姿のデアリングタクトをお願いします\n\nイメージとしてはトレーナーと2人で海へ遊びに来て、タクトが着替えてビキニ姿を見せに来たのをトレーナー目線で見ているようなシチュです\nスリーサイズなどが明らかになっていないので個人的なイメージにはなりますが、美乳美尻と表現できるくらいの大きさでスラっとした体つきで描いていただきたいです\nポーズ、背景、ビキニのデザインなどはお任せしますが照れて恥ずかしそうな顔、トレーナーの体などは入れずタクトがビキニ姿と分かる構図でお願いします\n\n可能でしたら白ワンピースを上に着てビキニが透けている差分もお願いします", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/6", "thumbnail_src": "https://si.imgix.net/931e98d5/uploads/origins/85072d14-00a0-43c7-bc31-223b6d0353e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef350464f483a7222038031dd17cc7c", "thumbnail_srcset": "https://si.imgix.net/931e98d5/uploads/origins/85072d14-00a0-43c7-bc31-223b6d0353e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef350464f483a7222038031dd17cc7c, https://si.imgix.net/931e98d5/uploads/origins/85072d14-00a0-43c7-bc31-223b6d0353e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ac69a631e02ebf75e9c84a90fe37285 2x, https://si.imgix.net/931e98d5/uploads/origins/85072d14-00a0-43c7-bc31-223b6d0353e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e737b9e4787f90c358952892e2f01402 3x", "genre": "art", "nsfw": false, "body": "初めまして、配信者として活動している潤上ユーリと申します。\nいつもXにてイラストを楽しませてもらっております。\n\n今回[バレンタイン衣装]のアイネスフウジンを書いていただきたく依頼いたしました。\n内容（トレーナーに向かって行っているシチュエーションを想定してます）\n・上記の通りバレンタイン衣装\n・胸元で手でハートをつくってポーズをとっている\n・ウマミミはできれば切れてない構図\nできれば差分（他の人には問題ないのにトレーナーへいざやった後に恥ずかしくなった感じ）\n・ポーズをしたまま顔を少し赤くして恥ずかしがってる表情\n・上記のためウマミミがへにょってる\n〇背景等描いていただける場合や、なくても背景を透明化できるようレイヤー分けしていただきたいです\n\n使用用途\n・たまにウマ娘配信をしているためサムネでの使用（レイヤー分けしていただきたい理由）\n・個人用途での壁紙として使用を想定しております。\n\n内容・使用用途について気が乗らない、スケジュールが合わない等ありましたらキャンセルしても構いません。\n描いていただいた場合グッズ化していただいても問題ございません。（むしろ喜んで買います）\nご都合のつく場合であればよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@kaniitama/works/5", "thumbnail_src": "https://si.imgix.net/9fb5c73c/uploads/origins/85127a29-c10d-424f-bf63-a3c92d770372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a28134f7d52b99cd7b2d39e00e7cd319", "thumbnail_srcset": "https://si.imgix.net/9fb5c73c/uploads/origins/85127a29-c10d-424f-bf63-a3c92d770372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a28134f7d52b99cd7b2d39e00e7cd319, https://si.imgix.net/9fb5c73c/uploads/origins/85127a29-c10d-424f-bf63-a3c92d770372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0437bfbeaae3874fe7103a6fd39f260f 2x, https://si.imgix.net/9fb5c73c/uploads/origins/85127a29-c10d-424f-bf63-a3c92d770372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6aa5d7b8439affa51688f581c5f5f862 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。リュウサイと申します。\nミホノブルボン合同誌を拝見させてもらいイラストを書いていただきたいと思いリクエストさせていただきました。\n\n題材はミホノブルボンをお願いします。\n構図や背景などはかにたまさんにお任