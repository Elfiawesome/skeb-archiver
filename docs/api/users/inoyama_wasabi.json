61-15af-4e2b-9144-ba8d79dda231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38b11736a002bebca228141905d12835", "thumbnail_srcset": "https://si.imgix.net/015a793f/uploads/origins/df6dd261-15af-4e2b-9144-ba8d79dda231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38b11736a002bebca228141905d12835, https://si.imgix.net/015a793f/uploads/origins/df6dd261-15af-4e2b-9144-ba8d79dda231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=832d4f119325b0cb57b65e341d2df803 2x, https://si.imgix.net/015a793f/uploads/origins/df6dd261-15af-4e2b-9144-ba8d79dda231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=040d96c54228d5f97a4bb32febe71245 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n猪山わさび先生にオリジナルキャラクターのイラストをお願いしたく、ご連絡させていただきました。\nこちらがキャラクターの詳細が記載されたアートシートです：\nhttps://x.com/aubrey1408/status/1771951973220130832\n\nイラストのシチュエーションや背景については、猪山わさび先生にお任せしたいと思っています。ただ、キャラクターにミステリアスな雰囲気や、眼鏡をかけていることで知的な印象が感じられるような描写をお願いできたら嬉しいです。\n\n最後までお読みいただき、ありがとうございます！どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@inoyama_wasabi/works/62", "thumbnail_src": "https://si.imgix.net/e57a7883/uploads/origins/123eba6e-d700-4e59-a63a-11bf6d4f0c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cef7f61a49a3129cd4f9f5dd00fd704", "thumbnail_srcset": "https://si.imgix.net/e57a7883/uploads/origins/123eba6e-d700-4e59-a63a-11bf6d4f0c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cef7f61a49a3129cd4f9f5dd00fd704, https://si.imgix.net/e57a7883/uploads/origins/123eba6e-d700-4e59-a63a-11bf6d4f0c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13d6cb3d3c8d45a6889abde323bbe12a 2x, https://si.imgix.net/e57a7883/uploads/origins/123eba6e-d700-4e59-a63a-11bf6d4f0c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=770cd56d5e0671c59770f8f32c8fb82b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！:3\nあなたの絵が好きなので、私のゴスOCを描いていただけませんか？私は彼女に、まだかなり露出度の高い、居心地の良い冬服を着せてあげたいと思っています。他は全てお任せします。\nよろしくお願いします！\n\nhttps://imgur.com/a/zilyno-oc-JlsJ1vw", "created_at": "", "completed_at": ""}, {"path": "/@inoyama_wasabi/works/61", "thumbnail_src": "https://si.imgix.net/9ab02cf1/uploads/origins/f0edae5c-bf01-427a-8cea-0b0e1f185489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a999d74a47cd44c8f21c7b295642b9a", "thumbnail_srcset": "https://si.imgix.net/9ab02cf1/uploads/origins/f0edae5c-bf01-427a-8cea-0b0e1f185489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a999d74a47cd44c8f21c7b295642b9a, https://si.imgix.net/9ab02cf1/uploads/origins/f0edae5c-bf01-427a-8cea-0b0e1f185489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bee5b6a157ae76a350f966aa8cd7fa43 2x, https://si.imgix.net/9ab02cf1/uploads/origins/f0edae5c-bf01-427a-8cea-0b0e1f185489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fc8d81e19a9dd702d36f9da0d20139a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n僕は君のアートスタイルが大好きで、自分も依頼されないと我慢できなかったんだ。\n\n私のオシを描いてくれませんか？どんなポーズでも、どんな表情でも、どんな服装でも、何でも構いません。\n\n本当にありがとう！\n\nhttps://cdn-longterm.mee6.xyz/plugins/embeds/images/771741598580473857/b1a3fbbc12647bc7a9852905ed47b10be0e39a052088058026730635613d908a.png", "created_at": "", "completed_at": ""}, {"path": "/@inoyama_wasabi/works/60", "thumbnail_src": "https://si.imgix.net/fa15574b/uploads/origins/2d5d7534-bc1c-4209-80c1-9fa2508c401a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf42e942861a88e442a2208d5ad5ad6", "thumbnail_srcset": "https://si.imgix.net/fa15574b/uploads/origins/2d5d7534-bc1c-4209-80c1-9fa2508c401a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf42e942861a88e442a2208d5ad5ad6, https://si.imgix.net/fa15574b/uploads/origins/2d5d7534-bc1c-4209-80c1-9fa2508c401a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2