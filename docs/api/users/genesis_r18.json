{"screen_name": "genesis_r18", "file": "genesis_r18", "name": "じぇねしす", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fbd8b1269-bf8b-49ff-9252-5db63e6cc299.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-2265fece-1a4c-4fce-98fb-1e04a6a154be.png", "description": ":kusozako::oniityan:です。\n:hokahoka::punipuni::mochimochi::loli:←:hayaku_koreni_naritai:\n", "total_works": 8, "scraped_works": 8, "first_seen": "2026-02-24T11:56:43.642042+00:00", "last_updated": "2026-02-27T17:44:19.872226+00:00", "price_history": {"art": [{"amount": 7000, "recorded_at": "2026-02-24T11:56:43.642042+00:00"}], "comic": [{"amount": 7000, "recorded_at": "2026-02-24T11:56:43.642042+00:00"}], "correction": [{"amount": 500, "recorded_at": "2026-02-24T11:56:43.642042+00:00"}]}, "current_prices": {"art": 7000, "comic": 7000, "correction": 500}, "price_range": {"art": {"min": 7000, "max": 7000}, "comic": {"min": 7000, "max": 7000}, "correction": {"min": 500, "max": 500}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@genesis", "name": "genesis"}, {"label": "Twitter", "url": "https://x.com/genesis_r18", "name": "genesis_r18"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/34140150", "name": "34140150"}], "flags": {}, "works": [{"path": "/@genesis_r18/works/8", "thumbnail_src": "https://si.imgix.net/eb993603/uploads/origins/a54cc41f-d1b1-4951-bcbc-014f8c30c6de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b41d99a8da9d74dbc7f2e8563f5af1", "thumbnail_srcset": "https://si.imgix.net/eb993603/uploads/origins/a54cc41f-d1b1-4951-bcbc-014f8c30c6de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b41d99a8da9d74dbc7f2e8563f5af1, https://si.imgix.net/eb993603/uploads/origins/a54cc41f-d1b1-4951-bcbc-014f8c30c6de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9dd04834343a25ec78c61ab4eb9f249 2x, https://si.i