F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4be39d921eeb9bd8cc1e866235d44f2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d73af9e5109b93ee8744205e5188a019 3x", "genre": "music", "nsfw": false, "body": "こんにちは！私のキャラクターのために短いテーマソングを作曲していただけませんか？\n\nそのキャラクターは幽霊にインスパイアされ、悪魔退治もするので、最初はドラマチックで不気味なものを想像しています。\n\n私が探しているような雰囲気を捉えた参考文献はこちらです：\nhttps://youtu.be/mKOpTUezXeM?si=91ZZq0Ua1E9CduC4\n\nヴァイオリンかフルートを入れてほしいのですが、引き続き芸術的な自由に任せてください。\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Bluemoonplus/works/26", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4be39d921eeb9bd8cc1e866235d44f2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d73af9e5109b93ee8744205e5188a019 3x", "genre": "music", "nsfw": false, "body": "私のスタート画面のテーマソングを作ってもらえませんか？\n\n私のキャラクターは \"Nael \"という名前です。  紫エルフの死霊術師で、邪悪な魔法と呪文を使う。\n\nちょっと不気味で、でもロックがテーマで、たぶんEDM？\n\n曲のキャラクターとアニメーションを添付します。\n\nhttps://drive.google.com/file/d/1tdRKwbs8am-lR6PwAL6rFvHSYAtVOnCl/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Bluemoonplus/works/25", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4be39d921eeb9bd8cc1e866235d44f2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d73af9e5109b93ee8744205e5188a019 3x", "genre": "music", "nsfw": false, "body": "こんにちは！\n\n僕のオリジナルキャラクターのテーマソングが欲しいんだ。https://drive.google.com/drive/folders/1EXbL7_hqr--HUX0YpTTYn4buF09dpGiD?usp=sharing\n\n私の物語の舞台はダークな中世ファンタジーの世界（ベルセルクやダークソウルなどに似ている）。幼い頃に捨てられ、数人の保護者（彼らは皆悲劇的な死を遂げた）に育てられた私のキャラクターは、18歳のはみ出し者で、傭兵でありながら魔法も使える。彼女はライカンのようなモンスターに変身する魔法の仮面をつけている。時には盗賊に襲われた村を救うこともある。彼女は物語を通して、内なる闇と戦い、恐怖に打ち勝とうとする。\n\nオーケストラのような、どこか映画的なサウンドにしたい。参考までにインスピレーションのプレイリストを載せておきますが、引き続き芸術的な自由に任せてください。https://youtube.com/playlist?list=PLufIYUtQTGwTXz9u2f5PiYjjxug-hx76A&si=WmDOwwOgMkfUp3yz\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Bluemoonplus/works/24", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4be39d921eeb9bd8cc1e866235d44f2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d73af9e5109b93ee8744205e5188a019 3x", "genre": "music", "nsfw": false, "body": "はじめまして！私のキャラクターをモチーフにしたオリジナル曲を作っていただけませんか？\n\n【キャラ】\n「鬼崎直樹（きさき・なおき）」というキャラです。新選組のような組織の元三番隊隊長、彼は「デビルメイクライのダンテ」のような人物になった。もうただの人斬りだけではなくて、どんな敵を切り落とす剣士です。生き物や怪物や器械などでも、邪魔すれば切る。ちょっとヘラヘラな奴になっても、まだ真剣な剣士です。打ち刀だけ使わなくて、リボルバーも他の銃も紅色の稲妻も使います。その装備があっても、彼の刀は一番危険です。キャラのデザインを見たいなら、以下のGoogle Driveのリンクを是非見て下さい！\n\nhttps://drive.google.com/drive/folders/1pkYTQu9gnTXszpnKpLDJiw_Jrevx-t8b?usp=drive_link\n\n【曲】\nこのキャラためのイメージソングか戦闘曲が欲しいです。ロックやEDMの音楽を影響した曲が欲しいので、ギターを中心として下さい！参考までにインスピレーションのプレイリストを挙げておきますが、引き続き芸術的な自由に任せて下さい！\n\nhttps://youtube.com/playlist?list=PLHMzrgc8T5Puc5_nSNQm7rbhsngZXBrtM&si=T79qoDmlMrSmhTkg", "created_at": "", "completed_at": ""}, {"path": "/@Bluemoonplus/works/23", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1819379938216255488%2Fejsj7Zim.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2695136221749ad8c0b965f47a45ff33, https://skeb-avatar.