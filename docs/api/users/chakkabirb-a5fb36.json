212-959a-41e7-9f8e-390da7e9f3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94763aa8309b2ce664a4c0f7c36b08bc", "thumbnail_srcset": "https://si.imgix.net/b9933727/uploads/origins/e11df212-959a-41e7-9f8e-390da7e9f3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94763aa8309b2ce664a4c0f7c36b08bc, https://si.imgix.net/b9933727/uploads/origins/e11df212-959a-41e7-9f8e-390da7e9f3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91e4f880906f3fd83e66f6954abc23da 2x, https://si.imgix.net/b9933727/uploads/origins/e11df212-959a-41e7-9f8e-390da7e9f3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c61b8ebc4eda3272a5fb83e744628c2e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつもX等でもにょもにょ食前酒様のイラストを拝見させていただいております。\nもにょもにょ食前酒様のふわふわもちもちとした喜怒哀楽豊かな生き物たちのイラストがとても大好きで、リクエストを送らせていただきました！\n\n▼リクエスト内容\n深夜にコンビニへ向かう動物たちをゆるいデフォルメで描いていただきたいです。\n構図や動物たちはおまかせで、自由に描いて頂きたいと思います。\n(ドラゴンといった架空の生き物でもうれしいです！)\n本当にもにょもにょ食前酒様の思うがままに作成して頂けますと幸いです...!(ネタ要素などを入れていただいても非常にうれしいです！)\n\n個人利用の範囲での鑑賞や、SNSのプロフィール画像に使用させていただく予定です。\n\n\n金額等、不都合がございましたら遠慮なくキャンセルしていただいて差し支えありません。\nお忙しいとは思いますが、ご検討いただけますと幸いです...!", "created_at": "", "completed_at": ""}, {"path": "/@chakkabirb/works/3", "thumbnail_src": "https://si.imgix.net/db32c452/uploads/origins/3bbc2afe-8fac-47d6-92d8-c08e8f28f638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8279e48b0d9225d245123733dd6c76", "thumbnail_srcset": "https://si.imgix.net/db32c452/uploads/origins/3bbc2afe-8fac-47d6-92d8-c08e8f28f638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8279e48b0d9225d245123733dd6c76, https://si.imgix.net/db32c452/uploads/origins/3bbc2afe-8fac-47d6-92d8-c08e8f28f638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c938fcc138e44de3fafddea701a636c 2x, https://si.imgix.net/db32c452/uploads/origins/3bbc2afe-8fac-47d6-92d8-c08e8f28f638?bg=%23fff&auto=forma