7-96c0-bf3ab8dc74fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afd8f7482ff2542b63712a2569913178, https://si.imgix.net/9b8bd32f/uploads/origins/f1105681-381c-4dd7-96c0-bf3ab8dc74fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cfca40bc6db90eceb2b1de41041ab4f 2x, https://si.imgix.net/9b8bd32f/uploads/origins/f1105681-381c-4dd7-96c0-bf3ab8dc74fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b08496a69a0ceed37f24a72a70b75062 3x", "genre": "art", "nsfw": false, "body": "こんにちは、作家のリクエストを検討していただきありがとうございます。 https://skeb.jp/@hisha_04/works/34 上の作品を参考にしてリクエストしました。私もオリジナルキャラクターのアーマー化された姿デザインをお願いしたいと願っております。キャラクター設定：中学生または高校生に見えるルックス/淡い紫色の髪に薄い水色の瞳、白い肌を持っています。休日や放課後、悪役やモンスターを扱うヒーローというコンセプトです。要求事項：既存のオリジナルキャラクターは拳銃を武器として使用しますが、今作ではレバーアクションライフルを武器として使用し、手袋とヘルメットを着用したいと思います。上記の要求事項以外の要素は、作家様の裁量でいただきありがとうございます。作品はアイコンやパーソナル放送で使う考えです。キャラクター資料があるリンクです。 https://drive.google.com/drive/folders/1Ytnz2Nkjl_QnxGwowoGSZB9013v4M9OBリクエストを読んでくれてありがとう。良い一日になりますように！\n\nhttps://drive.google.com/drive/folders/1Ytnz2Nkjl_QnxGwowoGSZB9013v4M9OB", "created_at": "", "completed_at": ""}, {"path": "/@hisha_04/works/56", "thumbnail_src": "https://si.imgix.net/3eb52dff/uploads/origins/9074562a-ccf6-4ab7-a3ca-eb66f735863f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8edd73602d706c2d1b9bcff3ace0e88", "thumbnail_srcset": "https://si.imgix.net/3eb52dff/uploads/origins/9074562a-ccf6-4ab7-a3ca-eb66f735863f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8edd73602d706c2d1b9bcff3ace0e88, https://si.imgix.net/3eb52dff/uploads/origins/9074562a-ccf6-4ab7-a3ca-eb66f735863f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee4eec39fe1364db73b211cb11966904 2x, https://si.imgix.net/3eb52dff/uploads/origins/9074562a-ccf6-4ab7-a3ca-eb66f735863f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ff8527e4d84c3d161c1551e