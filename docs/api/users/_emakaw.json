5e01f8 2x, https://si.imgix.net/698eb33f/uploads/origins/0b973aa8-b81f-4683-a3bb-7f4715d8f011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e606b7fe33da73e36de3504a92ee966e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/20", "thumbnail_src": "https://si.imgix.net/dfa07253/uploads/origins/97f6c76d-1804-46cf-8725-edad33610f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7029e07ff2453c6a29bd1866d4f1fb9", "thumbnail_srcset": "https://si.imgix.net/dfa07253/uploads/origins/97f6c76d-1804-46cf-8725-edad33610f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7029e07ff2453c6a29bd1866d4f1fb9, https://si.imgix.net/dfa07253/uploads/origins/97f6c76d-1804-46cf-8725-edad33610f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8a3fc562fe6a73ce90da74258893832 2x, https://si.imgix.net/dfa07253/uploads/origins/97f6c76d-1804-46cf-8725-edad33610f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55d73702aa3d2ad2836c3d8419502e62 3x", "genre": "art", "nsfw": false, "body": "こんばんは、いつも素敵なイラストをありがとうございます。今回初めてskebで依頼をするので勝手が分からずのままで恐縮なのですが、各種SNSのアイコンで使用するイラストを依頼したいです。\n \n要望なのですが、ゆのさんの描く人物の横顔がめちゃくちゃ好きで、女性の横顔（全身）を描いて欲しいです。\n色合いなのですが2024/11/30にXにて5:23amとポストしていたイラストの色合いがめちゃくちゃどストライクだったので同じようなテイストで出来たらお願いします。\nその他、背景等はお任せします。\n細かい指定申し訳ないですが、お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/19", "thumbnail_src": "https://si.imgix.net/2a3453c0/uploads/origins/77d976d6-f512-442f-9769-37e7eea0bbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89c3c587d78be614bfeb5d70f24e86b9", "thumbnail_srcset": "https://si.imgix.net/2a3453c0/uploads/origins/77d976d6-f512-442f-9769-37e7eea0bbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89c3c587d78be614bfeb5d70f24e86b9, https://si.imgix.net/2a3453c0/uploads/origins/77d976d6-f512-442f-9769-37e7eea0bbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d31e346a4bbbbd9d6b2b834558d0692 2x, https://si.imgix.net/2a3453c0/uploads/origins/77d976d6-f512-442f-9769-37e7eea0bbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c4c77a12496aadbb596cbe44bed2ab6 3x", "genre": "art", "nsfw": false, "body": "ゆの様\n\nおとめちゃんの絵に惹かれまして、自分もアイカツシリーズの絵を描いていただけないでしょうか。\n友人にプレゼントしたいので花束を上げるような構図の霧矢あおいちゃんをお願いいたします。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/18", "thumbnail_src": "https://si.imgix.net/18e3e040/uploads/origins/deb5ef22-bff8-4c7d-8985-b7ee7186662e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe6f12cea02c33f788687c5f643aa5b", "thumbnail_srcset": "https://si.imgix.net/18e3e040/uploads/origins/deb5ef22-bff8-4c7d-8985-b7ee7186662e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe6f12cea02c33f788687c5f643aa5b, https://si.imgix.net/18e3e040/uploads/origins/deb5ef22-bff8-4c7d-8985-b7ee7186662e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c97aa1c1d5162302a42159513cc3ce4f 2x, https://si.imgix.net/18e3e040/uploads/origins/deb5ef22-bff8-4c7d-8985-b7ee7186662e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1af8efac5932684adcc2ae5f8575015b 3x", "genre": "art", "nsfw": false, "body": "前回、素敵なイラストを描いていただき、ありがとうございました！\n\n今回も同じキャラクター、リコリコ「錦木千束」のイラストをお願いします~\n\n詳しい構図は自由にお任せします！ よかったらご検討お願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/17", "thumbnail_src": "https://si.imgix.net/7e29abe1/uploads/origins/84ebdb47-8926-48ef-b76d-71579cae1cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2e4ca84e405a42b0f16c794e1030ec6", "thumbnail_srcset": "https://si.imgix.net/7e29abe1/uploads/origins/84ebdb47-8926-48ef-b76d-71579cae1cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2e4ca84e405a42b0f16c794e1030ec6, https://si.imgix.net/7e29abe1/uploads/origins/84ebdb47-8926-48ef-b76d-71579cae1cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb750ac997b5a37d387d006ab1f2f958 2x, https://si.imgix.net/7e29abe1/uploads/origins/84ebdb47-8926-48ef-b76d-71579cae1cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c8810fff8fc186a5dfcbcd240086f55 3x", "genre": "art", "nsfw": false, "body": "ゆのさんこんにちは！\nいつも素敵な作品をありがとうございます。\n\"ﾈｺﾁｬﾝと丸眼鏡の男の子\"をリクエストさせてください。\nゆのさんの色づかいがとってもすきです！これからも応援しています～！", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/16", "thumbnail_src": "https://si.imgix.net/c48639a5/uploads/origins/6c0ed123-b6be-4355-be63-e310171c581a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e302cd5a26990e4ad0f2b9da3e52c81", "thumbnail_srcset": "https://si.imgix.net/c48639a5/uploads/origins/6c0ed123-b6be-4355-be63-e310171c581a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e302cd5a26990e4ad0f2b9da3e52c81, https://si.imgix.net/c48639a5/uploads/origins/6c0ed123-b6be-4355-be63-e310171c581a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0867ef75ccefac536a5fd3677822b8ac 2x, https://si.imgix.net/c48639a5/uploads/origins/6c0ed123-b6be-4355-be63-e310171c581a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4f2685df708d3854c39e01bb72fd900 3x", "genre": "art", "nsfw": false, "body": "ゆの様\nアイカツのリクエストお願いしてもよろしいでしょうか？\n\n大空あかりちゃんと服部ユウちゃんのイラストを依頼させていただきたいです。\n普段の髪型でなく、少しヘアアレンジして描いていただけると嬉しいです。\n\nゆの様の描かれる瞳に力のある子達のイラストがとても好きなので、おめめキラキラで目力ある感じでお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/15", "thumbnail_src": "https://si.imgix.net/e2e20f84/uploads/origins/b61fd6bb-097d-4dae-a36d-542cd7b2e992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490da33e238f558bc982653b7527bbd8", "thumbnail_srcset": "https://si.imgix.net/e2e20f84/uploads/origins/b61fd6bb-097d-4dae-a36d-542cd7b2e992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490da33e238f558bc982653b7527bbd8, https://si.imgix.net/e2e20f84/uploads/origins/b61fd6bb-097d-4dae-a36d-542cd7b2e992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b60861a610cd4e74cdf6a20058d20dd7 2x, https://si.imgix.net/e2e20f84/uploads/origins/b61fd6bb-097d-4dae-a36d-542cd7b2e992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1d3cbe5baa28dc7b3a9ad9def94df8c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n先日イラストを描いて頂いた者です。\nせっかくなのでアクリルにもしたのですが本当に素敵で…\nまたまたリクエストさせて頂ければと思います。\nゆのさんの描くイラストは横顔が特徴的なので、横顔でお花をモチーフにした人物をお願いしたいです。\n他指定はございません。　\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/14", "thumbnail_src": "https://si.imgix.net/9d1175dd/uploads/origins/9d5ccbba-3f75-4ea7-9fc2-d23d13bf1d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f16be361704af326bf0d626fb30975ed", "thumbnail_srcset": "https://si.imgix.net/9d1175dd/uploads/origins/9d5ccbba-3f75-4ea7-9fc2-d23d13bf1d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f16be361704af326bf0d626fb30975ed, https://si.imgix.net/9d1175dd/uploads/origins/9d5ccbba-3f75-4ea7-9fc2-d23d13bf1d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbf75d7a706caf347333bc5ed4599845 2x, https://si.imgix.net/9d1175dd/uploads/origins/9d5ccbba-3f75-4ea7-9fc2-d23d13bf1d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17438ff7e7645151f7baa2fbd7551711 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも陰ながら応援しています。\n今回リクエストさせて頂きたいのはアイカツ！の「有栖川おとめ」ちゃんです。\nゆのさんを応援し始めて、アイカツにも興味を持って頂いていると知ってから、いつかおとめちゃんの絵を描いて頂きたいと長らく思っていました。\n構図等はすべてお任せいたします。おとめちゃんのハッピーもしくはらぶゆ〜な感じが溢れていると嬉しいです。\n個展やお仕事等でお忙しいかと思いますが、お手隙の際に描いていただけると幸いです。\n宜しくお願い致します。いつまでも応援しています。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/13", "thumbnail_src": "https://si.imgix.net/618bd403/uploads/origins/9d0d6476-24ee-4614-80fc-0cb225204365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01ac8179e81eea34b56278d4a296dc2", "thumbnail_srcset": "https://si.imgix.net/618bd403/uploads/origins/9d0d6476-24ee-4614-80fc-0cb225204365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01ac8179e81eea34b56278d4a296dc2, https://si.imgix.net/618bd403/uploads/origins/9d0d6476-24ee-4614-80fc-0cb225204365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d53affb2d3e73e3df86052935598b736 2x, https://si.imgix.net/618bd403/uploads/origins/9d0d6476-24ee-4614-80fc-0cb225204365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29e391c8764159c893de78b4aa778170 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/12", "thumbnail_src": "https://si.imgix.net/9c9313bb/uploads/origins/3b97be81-a9b2-47af-b533-a80bb4255658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eaffc34cad38c0b456051ba4e157b38", "thumbnail_srcset": "https://si.imgix.net/9c9313bb/uploads/origins/3b97be81-a9b2-47af-b533-a80bb4255658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eaffc34cad38c0b456051ba4e157b38, https://si.imgix.net/9c9313bb/uploads/origins/3b97be81-a9b2-47af-b533-a80bb4255658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07d2383635d12e4cb60aba9260f326ab 2x, https://si.imgix.net/9c9313bb/uploads/origins/3b97be81-a9b2-47af-b533-a80bb4255658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3aba4a8a125f0ed07ab01561f649527 3x", "genre": "art", "nsfw": false, "body": "ゆの様\n\nいつも素敵な作品、呟き拝見させて頂いております。関西での個展開催もとても嬉しいです！おめでとうございます。\n在廊日にお伺いしたかったのですが上司からお休みをぶんどることが出来ず悔しかったため、こちらでリクエストさせて頂きます。\n特に指定等ございません。\n\nこれからの益々のご活躍を、微力ながら応援させて頂きたく存じます(˶◜ᵕ◝˶)", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/11", "thumbnail_src": "https://si.imgix.net/56afe29b/uploads/origins/18d41638-3164-400a-807b-0c18f627f079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a763c05d61cd312162aa3a9d8369ca1b", "thumbnail_srcset": "https://si.imgix.net/56afe29b/uploads/origins/18d41638-3164-400a-807b-0c18f627f079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a763c05d61cd312162aa3a9d8369ca1b, https://si.imgix.net/56afe29b/uploads/origins/18d41638-3164-400a-807b-0c18f627f079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02cdf47935b9cb2c8bb0f60f518b2739 2x, https://si.imgix.net/56afe29b/uploads/origins/18d41638-3164-400a-807b-0c18f627f079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ade333b46d7a8575a65a5883b7042dff 3x", "genre": "art", "nsfw": false, "body": "前回の東京でのドローイング展におじゃまさせて頂いた者です。\nTwitterのアイコンで使用させて頂きたく、人物のイラストをお願いできれば幸いです。\nナチュラルなゆのさんの作品では見たことがないリクエストになるかもですが‥\n髪は前髪ぱっつんのショートボブで、楠田枝里子さんばりの大きなイアリングと眼力強めの女子でお願いしたいです。\n色味等はお任せでお願いします。\n最後になりますが、大阪個展おめでとうございま\nす。本当に行きたかった‥\n東京で開催の際は絶対にお伺いさせて頂きます。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/10", "thumbnail_src": "https://si.imgix.net/58a1164e/uploads/origins/6e683249-b639-4169-96eb-1ffd8d5427d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdab774f740bb16e010edb53c18a3d8e", "thumbnail_srcset": "https://si.imgix.net/58a1164e/uploads/origins/6e683249-b639-4169-96eb-1ffd8d5427d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdab774f740bb16e010edb53c18a3d8e, https://si.imgix.net/58a1164e/uploads/origins/6e683249-b639-4169-96eb-1ffd8d5427d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39620410ec0a734416168e340954e9ea 2x, https://si.imgix.net/58a1164e/uploads/origins/6e683249-b639-4169-96eb-1ffd8d5427d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cccf38d12a3953ea6c9fd605254a50d2 3x", "genre": "art", "nsfw": false, "body": "ゆの様\nTwitterいつも拝見しております。初依頼なので不足・失礼ございましたら申し訳ありません。\n\nリコリス・リコイルの錦木 千束をお願いします。\n\n【参考資料】\nhttps://lycoris-recoil.com/character/\n\n構図等、全てお任せでお願いいたします。\nご検討のほどよろしくお願いします。\n\n「描いていただいたイラスト」と記載し、作者名を添えたうえで\nSNS（ツイッター）に掲載させていただくことがあります。\nご都合が合いましたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/9", "thumbnail_src": "https://si.imgix.net/217ccff3/uploads/origins/534494ed-64be-49f0-9f82-ae6e2cb7415d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f053ecb646f8b600fc8f0c059e0c3de5", "thumbnail_srcset": "https://si.imgix.net/217ccff3/uploads/origins/534494ed-64be-49f0-9f82-ae6e2cb7415d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f053ecb646f8b600fc8f0c059e0c3de5, https://si.imgix.net/217ccff3/uploads/origins/534494ed-64be-49f0-9f82-ae6e2cb7415d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=368548cdf7f2040461b3c7a1e23f13ab 2x, https://si.imgix.net/217ccff3/uploads/origins/534494ed-64be-49f0-9f82-ae6e2cb7415d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b27d899b6230613c1225b514093c836 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/8", "thumbnail_src": "https://si.imgix.net/0febe769/uploads/origins/0226f273-39b4-461f-94d7-9db16fc52bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eee191efbd6b0130755824755899df6c", "thumbnail_srcset": "https://si.imgix.net/0febe769/uploads/origins/0226f273-39b4-461f-94d7-9db16fc52bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eee191efbd6b0130755824755899df6c, https://si.imgix.net/0febe769/uploads/origins/0226f273-39b4-461f-94d7-9db16fc52bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd766187ef26d5a49cfc5ae29e7c7e45 2x, https://si.imgix.net/0febe769/uploads/origins/0226f273-39b4-461f-94d7-9db16fc52bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1a5de71f8aa36616b1876c60c480d8b 3x", "genre": "art", "nsfw": false, "body": "黒猫っぽい眼鏡っ娘をお願いしたいです(猫耳付)。 髪型はくらげみたいにふわふわ、、\n眼鏡っ「娘」なんですけど、実は男だったりして、、  \nゆのさんの絵が本当に大好きで、本当は時間が合えば展示会とかに行きたいんですけど、、 \nなので今回はSkebでお願いしてみました！ \n なんだか変なリクエストですが、、よろしくお願いします、、", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/7", "thumbnail_src": "https://si.imgix.net/d1cb0ecd/uploads/origins/35cf06b0-14a4-49c0-b7c2-6a5fb852c817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d2b8a3f3c0f352d8d57ad53b08b621", "thumbnail_srcset": "https://si.imgix.net/d1cb0ecd/uploads/origins/35cf06b0-14a4-49c0-b7c2-6a5fb852c817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d2b8a3f3c0f352d8d57ad53b08b621, https://si.imgix.net/d1cb0ecd/uploads/origins/35cf06b0-14a4-49c0-b7c2-6a5fb852c817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d2a6aa18405aaa8f54778c6b6687f64 2x, https://si.imgix.net/d1cb0ecd/uploads/origins/35cf06b0-14a4-49c0-b7c2-6a5fb852c817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee89083bb4ec646716e85b6949ea90de 3x", "genre": "art", "nsfw": false, "body": "以前、アイコン用の青色のイラストを依頼させて頂いた者です。\n前回と同じくTwitterのアイコンで使用させて頂きたく、人物のイラストをお願いできれば幸いです。\n人物の造形や構図はお任せで、色味はできれば暖色系でお願い致します。\n\n最後になりますが、個展おめでとうございます！\n銀座の個展に近々お伺いする予定なので、楽しみにしております。\n今後も応援しております！", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/6", "thumbnail_src": "https://si.imgix.net/52dc613b/uploads/origins/48316801-b1a7-4707-a626-c14c41a10fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=960071951da15617bd96d0ac21db2a51", "thumbnail_srcset": "https://si.imgix.net/52dc613b/uploads/origins/48316801-b1a7-4707-a626-c14c41a10fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=960071951da15617bd96d0ac21db2a51, https://si.imgix.net/52dc613b/uploads/origins/48316801-b1a7-4707-a626-c14c41a10fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0536d1656433b2cf0719e622b5c6e095 2x, https://si.imgix.net/52dc613b/uploads/origins/48316801-b1a7-4707-a626-c14c41a10fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f2e248f341264c1408239760991fb28 3x", "genre": "art", "nsfw": false, "body": "ゆの様\nSNS上でとても素敵なイラストをお見掛けし、是非ゆの様に下記の内容でお願いできればと思いリクエストいたしました。\n\n・ホロライブ所属「ときのそら」のイラスト\n・構図等、全てお任せでお願いいたします。\n・使用目的は、twitterにアップし多くの人にイラストを見てもらうため。もちろん作者名等を記載いたします。\n\ntwitterで、ドローイングではキャラクター等のリクエストはお受けできませんとありましたので、無理を言っているのであれば申し訳ありません。\n\n【参考資料】https://www.hololive.tv\n\n\n銀座で開催中のゆの展に行く予定です。楽しみです！", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/4", "thumbnail_src": "https://si.imgix.net/747d532e/requests/14924_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdf4bff63f42766b3734a7a323ca0fa1", "thumbnail_srcset": "https://si.imgix.net/747d532e/requests/14924_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdf4bff63f42766b3734a7a323ca0fa1, https://si.imgix.net/747d532e/requests/14924_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45201769a9297828a9f20b08bfe155a9 2x, https://si.imgix.net/747d532e/requests/14924_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05735d23a0c5f004cb07f462162df691 3x", "genre": "art", "nsfw": false, "body": "こんばんは！\n以前は素敵なイラストを描いてくださりありがとうございました。\n\n今回は、いわゆるケモノっ子をリクエストしたいです。\n「朝起きたら、（猫のような）耳と尻尾が生えていた…！？」\nという感じの、戸惑いのあるシチュエーションだと嬉しいです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/3", "thumbnail_src": "https://si.imgix.net/106c1f62/requests/11622_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b98f8305d8b1885a0c33bba8fd1a1440", "thumbnail_srcset": "https://si.imgix.net/106c1f62/requests/11622_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b98f8305d8b1885a0c33bba8fd1a1440, https://si.imgix.net/106c1f62/requests/11622_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33067510a97348d2cb575546aebf1a3e 2x, https://si.imgix.net/106c1f62/requests/11622_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=360404ec2d9c6aac1bd9e0a58b531e68 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回のゆの展でドローイングされておりました天使の女の子のイラストが大好きで、\n是非とも同じテイストのイラストが見られればと思いリクエストをさせて頂きました！\n（※頭の上の輪っかは描写無しでお願いいたします…！）\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/2", "thumbnail_src": "https://si.imgix.net/2a4166b4/requests/10772_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753ed183376c3f3ae6b903e3c5612588", "thumbnail_srcset": "https://si.imgix.net/2a4166b4/requests/10772_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753ed183376c3f3ae6b903e3c5612588, https://si.imgix.net/2a4166b4/requests/10772_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a9fdd46123caff2a8459776764463cc 2x, https://si.imgix.net/2a4166b4/requests/10772_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f0c3cc3b7ef97b0f28b71005a6f0546 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストを拝見しております。\n\n「告白前夜」\nというテーマでリクエストをしたいです。\n人物や細かなシチュエーションは全てゆの先生にお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@_emakaw/works/1", "thumbnail_src": "https://si.imgix.net/e9522d1f/requests/10773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610ede6eacdc71d7a8a6bb96b84a672d", "thumbnail_srcset": "https://si.imgix.net/e9522d1f/requests/10773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610ede6eacdc71d7a8a6bb96b84a672d, https://si.imgix.net/e9522d1f/requests/10773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fd10f25eaf21662517ca476a2c15398 2x, https://si.imgix.net/e9522d1f/requests/10773_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dab9e0697e447428849dd035bc30d9c 3x", "genre": "art", "nsfw": false, "body": "いつもTwitter拝見しております。\n\n月末のイベントにお伺いできないので、この機会に購入させて頂ければ嬉しいです。\nもしイラストのリクエストをさせて頂けるのであれば、Twitterのアイコンをお願いしたく存じます。\n内容は、女性のイラストで丸顔・ショートカット・めがね・色調は青色ベースだと嬉しいです。表情や角度等はお任せさせて頂ければと思います。\n（ですが、skebですしリクエスト通りでなくても全く構いません…！）\nどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}]}