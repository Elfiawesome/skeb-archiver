43c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b244884a5e807f8857738d87420b0f74, https://si.imgix.net/34e28d4c/uploads/origins/a183f8c2-7176-4f72-b64a-0df2bdb43c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8901651c0701890b3ea03839812d07ea 2x, https://si.imgix.net/34e28d4c/uploads/origins/a183f8c2-7176-4f72-b64a-0df2bdb43c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=293f899b37008566ba72663e174b3be4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！ずっとあなたの作品を拝見していて、私のオリジナルキャラクターをあなたのスタイルで描いていただけたら嬉しいです！サイラスについて：元不良の猫耳少年で、狼のような悪魔から逃げています。性格は少し気まぐれで、見知らぬ人を信用しません。それでも、大切な人からの承認を切実に求めています。 口が軽く、よく考えずに発言してしまうことも。錠前を解くのが得意で、立ち入り禁止の場所に潜り込むのもお手の物です。お願いを検討いただきありがとうございます！！ https://drive.google.com/file/d/1hlJ-YNydbdu-8Gatj4oGuJVYvXPlM8Qj/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@k0banzame_omo/works/119", "thumbnail_src": "https://si.imgix.net/cca27ce7/uploads/origins/88c84e1d-6f6a-4836-bca4-db1dfed71845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01838d6d07dc37140854ec4cccda3ebf", "thumbnail_srcset": "https://si.imgix.net/cca27ce7/uploads/origins/88c84e1d-6f6a-4836-bca4-db1dfed71845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01838d6d07dc37140854ec4cccda3ebf, https://si.imgix.net/cca27ce7/uploads/origins/88c84e1d-6f6a-4836-bca4-db1dfed71845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=807229a55ff9fee30520de2e232d2b17 2x, https://si.imgix.net/cca27ce7/uploads/origins/88c84e1d-6f6a-4836-bca4-db1dfed71845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=641daf68b04e3db487aaee3a551877df 3x", "genre": "art", "nsfw": false, "body": "いつも先生のイラスト拝見させていただきます。\nよしければ私のOCをリクエストしたいです。\n\n▼\n２０歳／男性／東京出身\n舌ピアス／リップピアス／耳ピアス／黒ネイル\n\n◩キャラクタ―要素\nOD／精神不穏もしく不安定／自傷行為／腕に傷跡／カッター\n\n◩背景\n家庭環境の悪さと学校でのいじめが原因で、精神的な問題を抱えるようになり、定期的に薬を服用する必要がある\nしかし、その精神状態のために日常生活が非常に困難になり、ついには退学して家族に頼って暮らすようになった\n家族の中での立場もとても弱く、存在感はほとんどない\nそして、精神薬物や自傷行為にも徐々に依存するようになっていった\n\n◩その他\nコートなしでも大丈夫です。構図やアレンジは先生におまかせします\n\n依頼を読んでいただき、ありがとうございました...！\n\nhttps://drive.google.com/drive/folders/1JjNCB6i-2JuIr0SgaXHoE8O3pGRY3MhB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@k0banzame_omo/works/118", "thumbnail_src": "https://si.imgix.net/dc0ac123/uploads/origins/c1402903-0097-4f85-9d2e-a99c3679f4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5493cb19a424e129a51f56f63adffe3c", "thumbnail_srcset": "https://si.imgix.net/dc0ac123/uploads/origins/c1402903-0097-4f85-9d2e-a99c3679f4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5493cb19a424e129a51f56f63adffe3c, https://si.imgix.net/dc0ac123/uploads/origins/c1402903-0097-4f85-9d2e-a99c3679f4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e03c4e62ee5c1d262b77741bc8bc2bb4 2x, https://si.imgix.net/dc0ac123/uploads/origins/c1402903-0097-4f85-9d2e-a99c3679f4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cee115774a848e23191f2c7b35d01ccb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！\n前回は素敵なイラストを描いていただき、本当にありがとうございました。\n拝見した瞬間とても嬉しくて、とても気に入りました。\nぜひまた、このキャラクターの分岐設定について描いていただけないかと思い、ご連絡しました。\n\n大まかな设定是：\n喜欢的人と一緒に、少しずつ怪物へと異変していく過程で強い苦しみを味わっている、というものです。\nあまりにも苦痛が大きいため、見えるものすべてが幻覚のように感じられている状態です。\n解釈や表現はご自由にお任せします。\nお読みいただきありがとうございます！\n\nhttps://x.com/i/status/2016022262311207178", "created_at": "", "completed_at": ""}, {"path": "/@k0banzame_omo/works/117", "thumbnail_src": "https://si.imgix.net/546d1b07/uploads/origins/3cb2925f-a6bc-46ad-81e3-9a6f9438059d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b0fb0c9025b4b036998653de4052edf", "thumbnail_srcset": "https://si.imgix.net/546d1b07/uploads/origins/3cb2925f-a6bc-46ad-81e3-9a6f9438059d?bg=%23fff&