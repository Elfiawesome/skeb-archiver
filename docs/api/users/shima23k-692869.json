设定请参考下面的链接. 我最近更新了设计, 因此一切细节以编号为20和21的参考图的设计和服饰为准. 他是一位会魔法的天文学家. 服饰上的六角形装饰代表了JWST的星芒形状. \n我没有具体的动作要求, 您可以自由发挥, 比如画他释放魔法的样子, 也可以画战斗的样子. 无论如何, 希望您能将他画得动感且帅气! \n注意他的下半身需要画趾行(如果在画面中的话), 以及他的左耳有缺口.\n谢谢\n赤弦\n\nhttps://drive.google.com/drive/folders/1maBoc5D-Afpj8F6dM-d4rnKjYhud4Fup?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@shima23k/works/54", "thumbnail_src": "https://si.imgix.net/39ab1c3b/uploads/origins/9d3e239e-779d-4176-a206-20ec7a3c7ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3901a0bbf16883692fdad38953ca687f", "thumbnail_srcset": "https://si.imgix.net/39ab1c3b/uploads/origins/9d3e239e-779d-4176-a206-20ec7a3c7ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3901a0bbf16883692fdad38953ca687f, https://si.imgix.net/39ab1c3b/uploads/origins/9d3e239e-779d-4176-a206-20ec7a3c7ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41ed4193ae2a5e6e68f7bbdfae93b744 2x, https://si.imgix.net/39ab1c3b/uploads/origins/9d3e239e-779d-4176-a206-20ec7a3c7ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=593bf69e9d74c3ee14bf638fa23f0673 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shima23k/works/53", "thumbnail_src": "https://si.imgix.net/a995f702/uploads/origins/722ac603-95b4-4ed5-b599-d449ddb0f143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14de8b1d582ab34fc2dbacdf9506c44c", "thumbnail_srcset": "https://si.imgix.net/a995f702/uploads/origins/722ac603-95b4-4ed5-b599-d449ddb0f143?bg=%23fff&auto=fo