い！可愛いからね、ぬくもり大事！\n\nPCの壁紙とかに使用させていただければと思います！！\n煩悩まみれの依頼ですが、何卒よろしゅうお願いします！\n\nP.S  最大の愛をあなたに。", "created_at": "", "completed_at": ""}, {"path": "/@marotanidatta8/works/175", "thumbnail_src": "https://si.imgix.net/10e489c5/uploads/origins/bafa58fb-0405-4217-a53b-85ef9b925e95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8f979cad8e040c1ba98a7f82e6bab5c", "thumbnail_srcset": "https://si.imgix.net/10e489c5/uploads/origins/bafa58fb-0405-4217-a53b-85ef9b925e95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8f979cad8e040c1ba98a7f82e6bab5c, https://si.imgix.net/10e489c5/uploads/origins/bafa58fb-0405-4217-a53b-85ef9b925e95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40a80c4f19e09cfc199e087dbe34e1d9 2x, https://si.imgix.net/10e489c5/uploads/origins/bafa58fb-0405-4217-a53b-85ef9b925e95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc84408eee28bb0b01e8ce20ab54489d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marotanidatta8/works/174", "thumbnail_src": "https://si.imgix.net/e637eb8f/uploads/origins/eb633c47-0fde-4394-bae6-0a14e7b5e748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7e489612bfc40e0947682a7b3a05021", "thumbnail_srcset": "https://si.imgix.net/e637eb8f/uploads/origins/eb633c47-0fde-4394-bae6-0a14e7b5e748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7e489612bfc40e0947682a7b3a05021, https://si.imgix.net/e637eb8f/uploads/origins/eb633c47-0fde-4394-bae6-0a14e7b5e748?bg=%23fff&a