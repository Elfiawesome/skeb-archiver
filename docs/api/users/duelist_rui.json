imgix.net/a3c31670/uploads/origins/f2f2427f-11bb-4cc1-bea0-ad7b969c3d16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3251e32ec979ed76ef9ec7e74a763741 2x, https://si.imgix.net/a3c31670/uploads/origins/f2f2427f-11bb-4cc1-bea0-ad7b969c3d16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38a085818690032a829dc9aaa658b5a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@duelist_rui/works/63", "thumbnail_src": "https://si.imgix.net/1458210b/uploads/origins/f7bf4727-2728-46b6-83d2-0dba0d8425a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=288ffceb43d195de9ea5298f48346e3f", "thumbnail_srcset": "https://si.imgix.net/1458210b/uploads/origins/f7bf4727-2728-46b6-83d2-0dba0d8425a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=288ffceb43d195de9ea5298f48346e3f, https://si.imgix.net/1458210b/uploads/origins/f7bf4727-2728-46b6-83d2-0dba0d8425a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70e1524c08ba1990e5f2d00649dd5c87 2x, https://si.imgix.net/1458210b/uploads/origins/f7bf4727-2728-46b6-83d2-0dba0d8425a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=670bc904f76a1167da89079b4cf0c60e 3x", "genre": "art", "nsfw": true, "body": "こんにちは！幻影異聞録のフリナについてお願いがあります。青いコート、青いスカート、不透明な黒いパンスト。\n\nカメラアングルはこのような感じですが、少し横（サンプル）https://konachan.com/post/show/260287。\n\nフリナは筋肉質で、服はタイトフィットで、腹筋、上腕二頭筋、太ももの筋肉が服を押し出して見えている。その筋肉質な太ももにフタがあり、チンコが滑り落ちる。彼女のチンポはパンストと筋肉質な太ももの間に挟まっている。彼女の血管のようなチンコが立ち上がろうとしているのが見えるが、パンストがそれを抑えている。\n\nふりーなは熱心に、そしてとても誇らしげに見ている。彼女はこんなことを言う：「何を見てるんだい？\n\n体の色も前と似ている。\n\n服装は、筋肉が成長した頃のような制服だが、より筋肉質なサイズにフィットしている。これは彼女の予備の服だ。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@duelist_rui/works/62", "thumbnail_src": "https://si.imgix.net/18d06180/uploads/origins/d5234cba-fa81-4c4b-91db-11b44382548c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e4cf03cccf7694211ce444098cb1cd2", "thumbnail_srcset": "https://si.imgix.net/18d06180/uploads/origins/d5234cba-fa81-4c4b-91db-11b44382548c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e4cf03cccf7694211ce444098cb1cd2, https://si.imgix.net/18d06180/uploads/origins/d5234cba-fa81-4c4b-91db-11b44382548c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a03ea4c9f76e23b008f7f2e02fa75e1 2x, https://si.imgix.net/18d06180/uploads/origins/d5234cba-fa81-4c4b-91db-11b44382548c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c930c45fb9718f869f0f7fbe3aedd9e3 3x", "genre": "art", "nsfw": true, "body": "白井黒子のFMG漫画をお願いします。\nイメージとしてはジョーイさんの漫画(https://www.pixiv.net/artworks/128034612)のような感じです。\n戦う相手は適当で良いのですが、エリス(https://stat.ameba.jp/user_images/20210414/11/naoya7081236/21/51/p/o0640035914926190178.png　の背後のゴーレム)がいいかと思います。\n\nシチュはゴーレムと対峙する黒子（この時点でムキムキ）→自分より大きい相手にも不敵な態度で、気合を入れて筋肉を盛り上げる→筋肉巨体化し肌も褐色に変化、制服は破れ飛んで下にはマイクロビキニ→ゴーレムを力で圧倒し粉砕、性格も荒々しくなって絶頂しながら勝ち誇る。\nまた、ジョーイさん漫画の6枚目のような筋肉巨体を背中から映すアングルで、ダブルバイセップスのポーズを決めているコマもシチュの中に入れてほしいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@duelist_rui/works/61", "thumbnail_src": "https://si.imgix.net/9446d1c1/uploads/origins/49420e60-4ad4-435c-b2d8-31073ff731e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f8fbb3c26128b6941222b57fc3910cd", "thumbnail_srcset": "https://si.imgix.net/9446d1c1/uploads/origins/49420e60-4ad4-435c-b2d8-31073ff731e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f8fbb3c26128b6