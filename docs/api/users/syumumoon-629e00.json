4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ec5ddabfd9dc47567839274e33d75f", "thumbnail_srcset": "https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ec5ddabfd9dc47567839274e33d75f, https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75e32955faca7383848678bf5b86db20 2x, https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=040d09932746e53846b3dcbc3e7b8953 3x", "genre": "art", "nsfw": false, "body": "Hello!\n\nFirstly, I want to say that I adore your art style! Keep up the amazing work!\n\nI was wondering if you would be able to/would like to draw me some emotes for my character Aster? Here are some references:\n\nhttps://www.furaffinity.net/view/37331193/\nhttps://www.furaffinity.net/view/37535470/\n\nGenerally speaking, you're free to have as much fun with them as you'd like! I'd just love to have a variety of emotions, including:\n\n- Neutral\n- Happy\n- Laughing\n- Crying\n- Angry\n- Blushing\n- Giggling\n- Winking\n- Serious\n\nAgain, have as much fun as you'd like! Looking forward to hearing back from you!", "created_at": "", "completed_at": ""}, {"path": "/@syumumoon/works/13", "thumbnail_src": "https://si.imgix.net/ef82cbc0/uploads/origins/ca3734d5-0e02-4854-aad2-f21afe0cf511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d696981cda9a491d48187fcf517995d", "thumbnail_srcset": "https://si.imgix.net/ef82cbc0/uploads/origins/ca3734d5-0e02-4854-aad2-f21afe0cf511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d696981cda9a491d48187fcf517995d, https://si.imgix.net/ef82cbc0/uploads/origins/ca3734d5-0e02-4854-