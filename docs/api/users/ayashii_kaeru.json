t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff6b41b3c329f33553cc1447b647dd1f 2x, https://si.imgix.net/947d5720/uploads/origins/54d12ea1-9bd1-4357-9da3-2b57259c312e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbb2825388ba35e65584a3ad8190e59c 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております、伊倉はると申します！以前描いていただいたディアナのイラストは専用のファイルに移動させて不定期で見返してニコニコしています！今回はまた私のOCを描いていただけたらと思い、リクエストを送らせていただきました🙏\n━━━━━━━━━━━━━━━\n◆描いていただきたいキャラクター\n伊倉はるのOC｢モーリス｣\n\n◆キャラクターの特徴･設定\n・髪は茶髪で少しだけ癖毛\n・瞳の色はグリーン、目は死に気味\n・ヘビースモーカー\n・左利き\n・基本クールだが相手によって態度を変えがちで、喋る時は喋るし笑う時は笑う\n\n◆イラストの内容\nタバコを持っている、あるいは吸っているモーリスを描いていただきたいです。\n表情はむっとしたお顔で、服装や髪型は添付資料のデフォルメ立ち絵と同じものでお願いします。\nポーズや構図はお任せします！\n\n◆使用用途\n・個人での観賞\n\n◆納品形式\n可能であれば、宛名やキャラクター等がレイヤー分けされているpsdファイルで納品していただけると嬉しいです。\n画像の縦横比率やサイズはお任せします。\n\n◆キャラクターの資料\nhttps://drive.google.com/drive/folders/1QgFve_arZAGWwJeq2hVbjE8ux9M3FZjS\n\nその他資料はお手数ですが私のTwitterのメディア欄などから拾っていただければと思います。\n━━━━━━━━━━━━━━━\nご検討の程よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@ayashii_kaeru/works/25", "thumbnail_src": "https://si.imgix.net/d030ee23/uploads/origins/817c6987-ad4d-47ae-b980-ed410e9819c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c85c20e04459e3be71198c6348ee4fd", "thumbnail_srcset": "https://si.imgix.net/d030ee23/uploads/origins/817c6987-ad4d-47ae-b980-ed410e9819c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c85c20e04459e3be71198c6348ee4fd, https://si.imgix.net/d030ee23/uploads/origins/817c6987-ad4d-47ae-b980-ed410e9819c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=813771c9d10f6eae140731d070db9663 2x, https://si.imgix.net/d030ee23/uploads/origins/817c6987-ad4d-47ae-b980-ed410e9819c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1e036ec3de346b2034d42f4c772d5ee 3x", "genre": "art", "nsfw": false, "body": "いつも陰ながら可愛いイラストを拝見しております。\n秋田蕗ミオです。\n\nｹﾛﾘさんの可愛いモチモチした絵柄で是非イラストをお願いしたい