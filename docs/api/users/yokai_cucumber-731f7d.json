e-4676-bcef-0dffe8255323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b29444aa19de942a47f001abc5bca0c2, https://si.imgix.net/30cc5b23/uploads/origins/e09f1b6d-9c3e-4676-bcef-0dffe8255323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ee7cf812e1ed6ec6e3ab470f036a6f4 2x, https://si.imgix.net/30cc5b23/uploads/origins/e09f1b6d-9c3e-4676-bcef-0dffe8255323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=516f6c8dfc35253eecf56c896e7182f8 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n17liveという配信プラットフォームにてVliverとして活動しているりぼんちゃんと申します。\n配信のプライズに使用するイラストの制作を頼める方を探して、ぜひ妖怪海岸きゅうり洗い女様にお願いしたくご連絡させていただきました。\n\n【仕様】\n350dpi\n182×257mm\n\n【使用用途】\n配信のギフティングに対する還元プライズ\n(Tシャツ、ポストカード、マグカップ等グッズに使用する予定です)\n\n【リクエスト内容】\nVliver「りぼんちゃん」のイラスト\n\n背面や横デザインは支給されていないため、想像で保管していただいて問題ございません。\nまたコスプレなど衣装チェンジや改変は自由にして頂いて大丈夫です。\nただし、キャラクターのアイデンティティとして残したいのでカチューシャ(ティアラ？)は必ず着用お願いできればと思います。\n\n秋、または制服(茶ブレザー)、メイド服のいずれかのテーマでお願い致します。\n描きやすいテーマで構いません。\n\n自由に可愛く描いていただけたら嬉しいです！\n\nお忙しい中大変恐れ入りますが、\nご検討の程何卒よろしくお願いいたします。\n\nhttps://twitter.com/ribonchan_vlive/status/1404111655311532039?s=21", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/9", "thumbnail_src": "https://si.imgix.net/a6b8ff9d/uploads/origins/2dcf4d3a-ae5f-4aba-a58b-8526f26a47be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536bbffbb6db48b724f7bf73b20ecb29", "thumbnail_srcset": "https://si.imgix.net/a6b8ff9d/uploads/origins/2dcf4d3a-ae5f-4aba-a58b-8526f26a47be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536bbffbb6db48b724f7bf73b20ecb29, https://si.imgix.net/a6b8ff9d/uploads/origins/2dcf4d3a-ae5f-4aba-a58b-8526f26a47be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae9644346cc4411519cf72d37fbf1c0b 2x, https://si.imgix.net/a6b8ff9d/uploads/origins/2dcf4d3a-ae5f-4aba-a58b-8526f26a47be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3bda8fb03beecfdc775445d48145a4b 3x", "genre": "art", "nsfw": false, "body": "ドールズフロントラインのMG5を描いていただけますか？MG5は、ドヤ顔で嬉しそうに携帯電話を見ていると思います。以前の作品と同様 https://skeb.jp/@yokai_cucumber/works/2\n\nMG5のスマホ画面には、机で寝ている司令官をこっそり撮影したユーモラスな写真があります。\n\nMG5参考： https://imgur.com/a/dZjnxFT https://iopwiki.com/wiki/MG5\n司令官の制服 参考：https://imgur.com/a/QPlA0FD", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/8", "thumbnail_src": "https://si.imgix.net/cbb88bde/uploads/origins/e5dd11f0-8bc2-47ab-af2f-6f97c41afd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54551e8df6e58f58da23fe7282b6d8bb", "thumbnail_srcset": "https://si.imgix.net/cbb88bde/uploads/origins/e5dd11f0-8bc2-47ab-af2f-6f97c41afd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54551e8df6e58f58da23fe7282b6d8bb, https://si.imgix.net/cbb88bde/uploads/origins/e5dd11f0-8bc2-47ab-af2f-6f97c41afd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=044cfcd202a0fa89165782e4310083ba 2x, https://si.imgix.net/cbb88bde/uploads/origins/e5dd11f0-8bc2-47ab-af2f-6f97c41afd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ec30ed3a4538001f5b846cb4975488c 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nTwitterでイラストを拝見してぜひご依頼させていただきたいと思いました。\n\nイラストはアイドルマスターシンデレラガールズの水木聖來をお願いしたいです。\n衣装はSSR【ストリートステージ】の特訓後(資料1)で、完成後はTwitterのアイコンとして使用したく、よろしくお願い致します。\n\n資料1: https://imas.gamedbs.jp/cgss/images/iRjOnW82xYPeXOS1MmGmEiudjPd5DlzYYvS2yBz8U5Q.jpg\n\n資料2:\nhttps://twitter.com/mariotarou/status/1427421108043608070?s=21\n\nhttps://dere-ken.com/?p=1261", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/7", "thumbnail_src": "https://si.imgix.net/8c2745b2/uploads/origins/03f29d1b-f93a-4641-8c68-290cd65fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2ba0e17d62e0ab4561007c8f10c6a86", "thumbnail_srcset": "https://si.imgix.net/8c2745b2/uploads/origins/03f29d1b-f93a-4641-8c68-290cd65fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2ba0e17d62e0ab4561007c8f10c6a86, https://si.imgix.net/8c2745b2/uploads/origins/03f29d1b-f93a-4641-8c68-290cd65fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe14b6b50166ba30b15519cb2d45cee9 2x, https://si.imgix.net/8c2745b2/uploads/origins/03f29d1b-f93a-4641-8c68-290cd65fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46420427b7ebbd0e9427d88d55bf39e1 3x", "genre": "art", "nsfw": false, "body": "アイドルマスターシンデレラガールズの上条春菜ちゃんをお願いします。\n可能であればツイッターなどのアイコンに使用できる形で依頼させてください。", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/6", "thumbnail_src": "https://si.imgix.net/dac78ffe/uploads/origins/c97c007a-ef80-418a-b68b-53cad11e224a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62c567288f74643d96a9dc720dc222ae", "thumbnail_srcset": "https://si.imgix.net/dac78ffe/uploads/origins/c97c007a-ef80-418a-b68b-53cad11e224a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62c567288f74643d96a9dc720dc222ae, https://si.imgix.net/dac78ffe/uploads/origins/c97c007a-ef80-418a-b68b-53cad11e224a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b1fa61036207aca9e8b6d9290f08530 2x, https://si.imgix.net/dac78ffe/uploads/origins/c97c007a-ef80-418a-b68b-53cad11e224a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70d7aab875973ac9afe9aae1cdbed80a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のVTuberのペルソナを描いていただけると嬉しいです。\n魔女のタイムトラベラーで、宇宙的な要素を含んだデザインになっています。姉御肌のキャラクターです。\n背景、キャラクター、サインをそれぞれのレイヤーに配置したPSDファイルがあれば、ありがたいです。\n\n本当にありがとうございます。\n\n参考1： https://ibb.co/SsJSGJ3\n参考資料2： https://ibb.co/jz8PLxd\n参考資料3： https://ibb.co/P4cJGJs", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/5", "thumbnail_src": "https://si.imgix.net/8ab2cd7c/uploads/origins/02483113-849a-460d-aaf7-678f2cd6654f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4f6682e7795e73f2c4aef6ba6bf995", "thumbnail_srcset": "https://si.imgix.net/8ab2cd7c/uploads/origins/02483113-849a-460d-aaf7-678f2cd6654f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4f6682e7795e73f2c4aef6ba6bf995, https://si.imgix.net/8ab2cd7c/uploads/origins/02483113-849a-460d-aaf7-678f2cd6654f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e76e610657eb4bf3c4cfd4c9c904d51 2x, https://si.imgix.net/8ab2cd7c/uploads/origins/02483113-849a-460d-aaf7-678f2cd6654f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b3c8c936c5d965a8dcb430cb90f2d21 3x", "genre": "art", "nsfw": false, "body": "初めまして、新着の素敵なイラストをお見かけしてリクエスト送らせて頂きました。\n\nもしよろしければ、FFXIVのうちの子を描いて頂けないでしょうか？\n種族はアウラ♀、髪型はサイドテール、髪の色は金髪に薄くメッシュが入っていて、目は釣り目で青色。\n右ツノにカボチャのイヤリング（https://jp.finalfantasyxiv.com/lodestone/playguide/db/item/8931cefcffd/）をしています。\nメインジョブはレンジ全般、クールで戦うことが大好き！な気が強いお姉さんタイプ。\nhttps://imgur.com/a/IfPAak8\n\nカッコイイ構図を希望しますが、うちの子に合うと思ったポーズ構図でも大丈夫です。\n\nSNSアイコンにも使用したいので、宛名と背景をPSDでon/offできると助かります。\n細かい要望のリクエストになってしまいましたが、ご検討のほどよろしくお願い致します！！\n\nhttps://imgur.com/a/IfPAak8", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/4", "thumbnail_src": "https://si.imgix.net/8e793052/uploads/origins/50a1bede-de5e-4621-bc11-1941969c352f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a654745b07e24b76c6b14bfb415794", "thumbnail_srcset": "https://si.imgix.net/8e793052/uploads/origins/50a1bede-de5e-4621-bc11-1941969c352f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a654745b07e24b76c6b14bfb415794, https://si.imgix.net/8e793052/uploads/origins/50a1bede-de5e-4621-bc11-1941969c352f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06270233064c2336414f16f57288306e 2x, https://si.imgix.net/8e793052/uploads/origins/50a1bede-de5e-4621-bc11-1941969c352f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6ba33cafdc205e371bda5f0a3f48522 3x", "genre": "art", "nsfw": false, "body": "こんにちは!私はファイナルファンタジーにカナリーというキャラクターを持っています（参考資料参照）。\n彼の腰から上のキャラクターポートレートを依頼したいと思っています。緑色のタンクトップを着て（参考資料にあるような、タトゥーのないもの）、腕を頭の後ろに上げて、にっこり笑っているような感じにしたいです。眼鏡をかけている写真はありませんが、サングラス（顔にかけるか、タンクトップの首にかけるか）も入れたいと思い、参考にしました。背景は特別なものでなくてもいいので、ビーチであることがわかるようなものがいいと思います。\n\nありがとうございました。\n\nhttps://imgur.com/a/j8GqXyw", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/3", "thumbnail_src": "https://si.imgix.net/c172327d/uploads/origins/93b11826-dc12-4b2f-8372-c7d1e049f5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fb8276e719fa779112aa493c65df74", "thumbnail_srcset": "https://si.imgix.net/c172327d/uploads/origins/93b11826-dc12-4b2f-8372-c7d1e049f5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fb8276e719fa779112aa493c65df74, https://si.imgix.net/c172327d/uploads/origins/93b11826-dc12-4b2f-8372-c7d1e049f5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35bb6d48e41ef4cd72fd9cecd97936e5 2x, https://si.imgix.net/c172327d/uploads/origins/93b11826-dc12-4b2f-8372-c7d1e049f5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0eabd7a1de898aab3798b447e64607c 3x", "genre": "art", "nsfw": false, "body": "月末誕生日なので自分へのプレゼントに純愛コンビをください\n\n希望は以下。えちち絵でもいいよ！\nhttps://fnex.jp/i/155\nhttps://fnex.jp/i/143\n\n二人なのと服面倒くさいのとで割に合ってなかったらごめんなさい。", "created_at": "", "completed_at": ""}, {"path": "/@yokai_cucumber/works/2", "thumbnail_src": "https://si.imgix.net/b9bdf91e/uploads/origins/b6512b7d-2ed6-46c7-b891-acdabd9ef444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01198c3973959faa130775832d34a6f2", "thumbnail_srcset": "https://si.imgix.net/b9bdf91e/uploads/origins/b6512b7d-2ed6-46c7-b891-acdabd9ef444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20