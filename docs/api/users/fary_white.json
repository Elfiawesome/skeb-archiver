cae-b82a-4fef17a6964c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095579cc1665c4f0c5bea214f0aeb9f5", "thumbnail_srcset": "https://si.imgix.net/9783fb0b/uploads/origins/f9b404c2-54d5-4cae-b82a-4fef17a6964c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095579cc1665c4f0c5bea214f0aeb9f5, https://si.imgix.net/9783fb0b/uploads/origins/f9b404c2-54d5-4cae-b82a-4fef17a6964c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5825f2f130eca7fb2b27db5c01d7efa5 2x, https://si.imgix.net/9783fb0b/uploads/origins/f9b404c2-54d5-4cae-b82a-4fef17a6964c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9b552335cd63eabf68d5c09b0b28479 3x", "genre": "art", "nsfw": false, "body": "msa様初めまして\nいつも素敵なイラスト、作品を拝見させていただいております。\nmsa様の可愛さの中にある儚げで繊細な表現が大好きで依頼再開を楽しみにしておりました。\n\n今回は私のOCを依頼したいです。\n\n⚫︎キャラクター詳細\nお手数をおかけいたしますが詳細は参考資料をご参考ください。\nわかりづらいのですが右目下と左胸に黒子があります。目の色は下部に少し水色が入っており、髪色は少し紫がかった黒髪ではない暗髪です。ご確認お願い致します。\n髪型、服装や構図、背景等全てお任せいたします。元のデザインは無視していただいても参考にしていただいてもかまいません。\nmsa様の自由に描いていただきたいです…！\n\n⚫︎使用用途、他詳細\n\n・個人鑑賞やSNSアイコン、ヘッダーでの使用に加え、アクスタやステッカー等の個人利用範囲内でのグッズ作成をさせて頂きたいです。\n・グッズにさせていただける場合は全身（立ちでも座りでもどちらでも）、解像度は350dpi以上でお願いします。\n・服装やアクセサリーなど悩んでいるので考えて頂いたデザインは今後の参考にさせて頂きたいです。\n・人物と背景他レイヤー分けをお願いします。\n\nもし難しい部分や何かありましたら別レイヤーに記載して頂けますと幸いです。\nお忙しいとは思いますがぜひご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1TRyVAzDsx0om11e1CuL7xZXI-flBrOVT/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@fary_white/works/84", "thumbnail_src": "https://si.imgix.net/0b61aa7b/uploads/origins/52471692-893b-4efe-b9f7-ef68d8b98e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2fb5865427bf91f9ae60c6f595d43e4", "thumbnail_srcset": "https://si.imgix.net/0b61aa7b/uploads/origins/52471692-893b-4efe-b9f7-ef68d8b98e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2fb5865427bf91f9ae60c6f595d43e4, https://si.imgix.net/0b61aa7b/uploads/origins/52471692-893b-4efe-b9f7-ef68d8b98e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9f8ebfbbc9fc777df02c33eb4ca483e 2x, https://si.imgix.net/0b61aa7b/uploads/origins/52471692-893b-4efe-b9f7-ef68d8b98e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26b32382cf820307034ce8e239907914 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！あなたの絵はとても美しいですね。私は先生の絵がとても好きです。\nこれは私のOCです。トルコギキョウの花をテーマにした巫女さんで、どんな布を描くかは自由です>w<\n個人的なコレクションにしか使いません。\n\n私の依頼を受け入れてくれることを願っています。\nhttps://drive.google.com/drive/folders/1vySH5zrnnYRWY9mdKBFIEOhtqPWTeXGX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@fary_white/works/83", "thumbnail_src": "https://si.imgix.net/551cb503/uploads/origins/6b1840fe-c8b2-4faf-8897-a333c1ebf229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8871c78ac1f79f8b981b2388b9a97f8c", "thumbnail_srcset": "https://si.imgix.net/551cb503/uploads/origins/6b1840fe-c8b2-4faf-8897-a333c1ebf229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8871c78ac1f79f8b981b2388b9a97f8c, https://si.imgix.net/551cb503/uploads/origins/6b1840fe-c8b2-4faf-8897-a333c1ebf229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a597d5039d02d5dc9aa9c92a48f7c22 2x, https://si.imgix.net/551cb503/uploads/origins/6b1840fe-c8b2-4faf-8897-a333c1ebf229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3486d37d73f3fd99b4eaa1b932beb0a 3x", "genre": "art", "nsfw": false, "body": "すごい作品ですね。もしよろしければ、また別のものを提出したいです。今回もOCを選んで描いてもらえますか？\n\nメロシアは優しくて可愛くて、人見知りしやすくて、その上泣き虫です。話し方も反応もゆっくり。髪は明るい茶色で、目は明るい灰色の白。甘いものが大好き。\n\nカインシアは物静かで上品な少女で、感情の起伏がほとんどない。灰色の白いロングカーリーヘアに黒いハイライトとグラデーションが入っている。瞳孔はピンクで、青い輪郭をしている。肌の色は髪の色にとても近い。  \n\nフォルダから好きな服を選ぶか、選んだ女の子のために新しい服をデザインしてください。\n\nこの依頼は個人的なコレクション用です。依頼を検討していただき、ありがとうございました！🥰\n\nhttps://drive.google.com/drive/folders/1uHU0VdtqeM-sQo2V0kWCvUL_QHEX_Tn4?usp=sharing\n\nhttps://drive.google.com/drive/mobile/folders/1ts_6gd1t44ZGbX4zQg-eoOgrxYVH4dAU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@fary_white/works/82", "thumbnail_src": "https://si.imgix.net/e5ac63b4/uploads/origins/a56d99fc-b4e1-44e6-ae5d-27d348eec754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0a3f7dc62916d9a2ae786399fde9179", "thumbnail_srcset": "https://si.imgix.net/e5ac63b4/uploads/origins/a56d99fc-b4e1-44e6-ae5d-27d348eec754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0a3f7dc62916d9a2ae786399fde9179, https://si.imgix.net/e5ac63b4/uploads/origins/a56d99fc-b4e1-44e6-ae5d-27d348eec754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b92f5eec878218f8f4cbff6768e12b5e 2x, https://si.imgix.net/e5ac63b4/uploads/origins/a56d99fc-b4e1-44e6-ae5d-27d348eec754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70e786d2411d68b2160cce92bc443541 3x", "genre": "art", "nsfw": false, "body": "𝙢𝙨𝙖様、お世話になっております♡\n今回も募集再開を見かけまして、リクエストをお願いしたいです！\n\nもし可能であれば、またこの子のイラストをお願いしたいです、、、！\n・ロード・ナイト\n宝石の魔女で、右目はいつも閉じているが、開けたピンク色の涙が出てきます。\n彼女は賢くてクールな子で、イチゴとラズベリーが大好物です。\nお茶会をするのがとてもすきで、ローズのハーブティをよく飲んでいます。\n傍にはウサギの使い魔がいます。\n\n𝙢𝙨𝙖様の描かれるリファちゃんがとてもとてもかわいくて、、！いつもXで見て癒されます♡\n今回はいくつかテーマを考えて、その中の一つお好きなテーマを選んで頂いて描いて欲しいです、、！！もしどれも難しいのようでしたら、お好きなように自由に描いて頂けると幸いです！！\n\n①ピンク系のセーラー服姿をお願いしたいです。具体的なものは指定しません！可能であれば花などの要素も入れて欲しいです…！\n②お部屋の中で、部屋着姿。\n③バレエコア風なお洋服。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10cY-zWdEMzQxyNowYvSeJ16wQ7qSUqPG", "created_at": "", "completed_at": ""}, {"path": "/@fary_white/works/81", "thumbnail_src": "https://si.imgix.net/56c0a8e7/uploads/origins/92ee6d77-adfa-46ff-a947-d0278315578b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcb73578a74dabb34ea8dea8156195e2", "thumbnail_srcset": "https://si.imgix.net/56c0a8e7/uploads/origins/92ee6d77-adfa-46ff-a947-d0278315578b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&