ております！\n\nメインはあくまでも牡丹に蝶さん……と思っておりますので、真ん中で眩いほどに存在してくださったら思い残すことはありません。\nご依頼することが初めてなので不備や至らないところがありましたら申し訳ありません。\nどうぞよろしくお願いいたします❣️", "created_at": "", "completed_at": ""}, {"path": "/@Qomk0u_/works/3", "thumbnail_src": "https://si.imgix.net/c705cbf7/uploads/origins/1c01eca9-f2b8-4b94-8ff9-6a46012e4846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e2a8066056080f0a022ac766566cfb1", "thumbnail_srcset": "https://si.imgix.net/c705cbf7/uploads/origins/1c01eca9-f2b8-4b94-8ff9-6a46012e4846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e2a8066056080f0a022ac766566cfb1, https://si.imgix.net/c705cbf7/uploads/origins/1c01eca9-f2b8-4b94-8ff9-6a46012e4846?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c984c6ee5b29196b997dc699ca233b47 2x, https://si.imgix.net/c705cbf7/uploads/origins/1c01eca9-f2b8-4b94-8ff9-6a46012e4846?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=581a5cafee8a207836d58be7ab926725 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Qomk0u_/works/2", "thumbnail_src": "https://si.imgix.net/5cd6dd19/uploads/origins/004de347-1586-44c1-8be2-a109bb932cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca77e6ec3d2ce30c7a0fb2a4ef0d93da", "thumbnail_srcset": "https://si.imgix.net/5cd6dd19/uploads/origins/004de347-1586-44c1-8be2-a109bb932cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca77e6ec3d2ce30c7a0fb2a4ef0d93da, https://si.imgix.net/5cd6dd19/uploads/origins/004de347-1586-44c1-8be2-a109