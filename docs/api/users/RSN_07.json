f9-be08-de7c19a03ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b497bf8bca52775f327b947a345b5aa9, https://si.imgix.net/a761bc0c/uploads/origins/b3827ead-1e2b-42f9-be08-de7c19a03ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b908f8101f7503dc8d0ceae4da3e7571 2x, https://si.imgix.net/a761bc0c/uploads/origins/b3827ead-1e2b-42f9-be08-de7c19a03ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=538097b60c506795cc0a23baec0c5a81 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nRSN様の素敵な絵柄を見て私のOCキャラを描いていただきたく依頼させていただきました。\n下に描いてもらいたいキャラの細かい詳細やURLを送ります。\n\n・彼の名前  マリィ\n・種族  犬獣人\n・性別  男性\n・髪型と毛の色  クロスバングにウルフカット(髪型)、パステルパープル(髪の色)、ピンク(毛の色)\n耳の毛は白です。\n眉もパステルパープルになっております。\n・瞳の色  スカイブルー\n目の形はキリッとしていて瞳は大きいです。\n・服装  ブラックのもこもこムートンジャケット(上)、ホワイトのスエット(中)、パープルブラックのデニムパンツ(下)\nわかりずらいですが黒のベルトを着けております。\n\n背景は彼のイメージカラーであるパステルパープルで後ろにユニコーンや雲などがあれば嬉しいです。\nポーズはRSN様のお好きなようにしてもらって大丈夫です。\n\nhttps://share.icloud.com/photos/0c9JWV0ZikR1LxObGwRqhv3qw\nhttps://share.icloud.com/photos/084Z-Ck9Gu2dWKtQoqH8lDcTQ\nhttps://share.icloud.com/photos/04d0N9_b96cte95WUxXS8lSoA\n\nお手数お掛けしますが宜しくお願い致します。\n\nhttps://share.icloud.com/photos/024K_FDBPDa2I_iH7Wx7gOFrA", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/280", "thumbnail_src": "https://si.imgix.net/7cce68d4/uploads/origins/d723438b-3a62-4a18-b937-c14d060551cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25e570344e2515dda3bf055917e231bd", "thumbnail_srcset": "https://si.imgix.net/7cce68d4/uploads/origins/d723438b-3a62-4a18-b937-c14d060551cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25e570344e2515dda3bf055917e231bd, https://si.imgix.net/7cce68d4/uploads/origins/d723438b-3a62-4a18-b937-c14d060551cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81b07e764aa39d37d2065514087c3791 2x, https://si.imgix.net/7cce68d4/uploads/origins/d723438b-3a62-4a18-b937-c14d060551cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=687200fd13cb03f85e33147bc5b46c64 3x", "genre": "art", "nsfw": false, "body": "先生、はじめまして❤️先生の画風がとても好きなので、私のキャラクターを描いていただきたいです。そして新しい衣装を着せてください。彼は猫であり、同時にカルト信者でもあります。衣装、ポーズ、背景などは全て先生にお任せします（衣装には教会の要素があると嬉しいです）。どうぞよろしくお願いいたします。素敵な一日をお過ごしください❤️\n\nhttps://drive.google.com/drive/folders/1UcoRRq3iY17x6J82jjcU79qTvR_BFir1?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/279", "thumbnail_src": "https://si.imgix.net/e40b1718/uploads/origins/c915a1e5-0658-4d0e-b794-5a47f15a2a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0683786e995b38eb239069e731b1f3", "thumbnail_srcset": "https://si.imgix.net/e40b1718/uploads/origins/c915a1e5-0658-4d0e-b794-5a47f15a2a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0683786e995b38eb239069e731b1f3, https://si.imgix.net/e40b1718/uploads/origins/c915a1e5-0658-4d0e-b794-5a47f15a2a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ad2ff2ace9ecf5b5f42e55082a079e6 2x, https://si.imgix.net/e40b1718/uploads/origins/c915a1e5-0658-4d0e-b794-5a47f15a2a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e9bd11b3c2cbbe73ced599576eadf38 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは。初めまして。 先生の作品がとても好みでしたので、よろしければ、私のOCのイラストを依頼したいと思っています。\n\n设定定:クールな妖怪です。\n\n今回の依頼は個人用です。\n *依頼内容が金額と見合わない、その他不備などがあればお気軽に再送要請してください。\n\nhttps://drive.google.com/file/d/1_QX5yVe50erQT5ptUPlUdzykUiC5PHjd/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/278", "thumbnail_src": "https://si.imgix.net/268da97e/uploads/origins/e6f81b6d-1dc0-47fc-91e6-bbc1b9588ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b06551f7cbd60ec31cbf82b88035f046", "thumbnail_srcset": "https://si.imgix.net/268da97e/uploads/origins/e6f81b6d-1dc0-47fc-91e6-bbc1b9588ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b06551f7cbd60ec31cbf82b88035f046, https://si.imgix.net/268da97e/uploads/origins/e6f81b6d-1dc0-47fc-91e6-bbc1b9588ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e40b8501942612f258c0953db54b9c19 2x, https://si.imgix.net/268da97e/uploads/origins/e6f81b6d-1dc0-47fc-91e6-bbc1b9588ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49d440fed0bda7b0ef5f08b51597d2c7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/277", "thumbnail_src": "https://si.imgix.net/d429fd5a/uploads/origins/ad2ff537-4c00-4234-bd29-f1ebb6facb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6089aa8e043bd73669a65bd605f0e64", "thumbnail_srcset": "https://si.imgix.net/d429fd5a/uploads/origins/ad2ff537-4c00-4234-bd29-f1ebb6facb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6089aa8e043bd73669a65bd605f0e64, https://si.imgix.net/d429fd5a/uploads/origins/ad2ff537-4c00-4234-bd29-f1ebb6facb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=296d4b12c2f86aebf874e605762e5ff3 2x, https://si.imgix.net/d429fd5a/uploads/origins/ad2ff537-4c00-4234-bd29-f1ebb6facb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c7e48e427ef36bc990504fe1d9564e7 3x", "genre": "art", "nsfw": false, "body": "またこんにちは！フェネックのキャラクターをすごく素敵に描いてくれて、本当にありがとう！ぜひまた描いてほしいです！見た目や服装のディテールは全部お任せします！どんな風に描いても、あなたがカッコいいと思う方法で描いてください！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1VJib7XmBmPGVUyb8gmM_3EmqGIzLDrdY?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/276", "thumbnail_src": "https://si.imgix.net/022998b1/uploads/origins/2a910572-6680-40a9-b4eb-9fe77407332a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=359db55caddf1b86cbc1cdcb8ce35869", "thumbnail_srcset": "https://si.imgix.net/022998b1/uploads/origins/2a910572-6680-40a9-b4eb-9fe77407332a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=359db55caddf1b86cbc1cdcb8ce35869, https://si.imgix.net/022998b1/uploads/origins/2a910572-6680-40a9-b4eb-9fe77407332a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2b13494c8f91302a0eee47373fe8b08 2x, https://si.imgix.net/022998b1/uploads/origins/2a910572-6680-40a9-b4eb-9fe77407332a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c308eaa0bd745dea096555b73bd6840d 3x", "genre": "art", "nsfw": false, "body": "あなたのペインティングスタイルがとても好きです！\nこれが私のセットアップ写真です：\nhttps://drive.google.com/file/d/1oZwJgzpLChRqFV7tqz6mbK8exGYQ80Ux/view?usp=drive_link\n黒と紺のドミトリージャケット（またはトレンチコート）を希望します。\nキャラクターの表情はこちらを参考にしてください（この表情が欲しいだけで、角度や動きは参考にしなくて結構です）：\nhttps://drive.google.com/file/d/1gVAL-hvrFDbfk7XLM-w0GPys8KDv7sgG/view?usp=drive_link\n全体的な雰囲気はクールで落ち着いた感じです。\nその他はご自由にどうぞ。", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/275", "thumbnail_src": "https://si.imgix.net/3ee1b1df/uploads/origins/241e0ba8-fd13-4114-b3eb-ee6150f5cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a686628141397fdab6c460bf3f5dcb46", "thumbnail_srcset": "https://si.imgix.net/3ee1b1df/uploads/origins/241e0ba8-fd13-4114-b3eb-ee6150f5cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a686628141397fdab6c460bf3f5dcb46, https://si.imgix.net/3ee1b1df/uploads/origins/241e0ba8-fd13-4114-b3eb-ee6150f5cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef40c12b5d3c8352aeec4966a03cb40e 2x, https://si.imgix.net/3ee1b1df/uploads/origins/241e0ba8-fd13-4114-b3eb-ee6150f5cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87d62cca1a573050480464122eee4324 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの作品と画風がとても素敵で、以前から拝見していました。\n\n私のキャラクター「Lupis（ルピス）」のイラストをぜひお願いしたいと思い、ご連絡しました。\n全体的には、こちらの作品のような「威厳のある」「存在感のある」雰囲気で描いていただけたら嬉しいです。\nhttps://skeb.jp/@RSN_07/works/268\n\nこちらが、Lupisのデザインとリファレンスシートのリンクになります。\nhttps://drive.google.com/drive/folders/1VoGetXLi7Vcu1K-OCv30TCkdG40Ls4RS?usp=drive_link\n\n服装やポーズについては、いつもあなたがされている判断やセンスがとても好きなので、\nもし問題なければ、全体の雰囲気（威厳・インポーネントさ）を保った上で、\nデザインはある程度お任せしたいと考えています。\n\n一点だけ希望としては、プラスチックやレザーのような質感のジャケットを取り入れていただけたら嬉しいです。\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/274", "thumbnail_src": "https://si.imgix.net/13195e5e/uploads/origins/01159b1b-14ec-4fd6-91b3-9a417622d3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43e60967771ad443b369b9a80d2dbd41", "thumbnail_srcset": "https://si.imgix.net/13195e5e/uploads/origins/01159b1b-14ec-4fd6-91b3-9a417622d3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43e60967771ad443b369b9a80d2dbd41, https://si.imgix.net/13195e5e/uploads/origins/01159b1b-14ec-4fd6-91b3-9a417622d3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e4930dee806033289cca3be759634fa 2x, https://si.imgix.net/13195e5e/uploads/origins/01159b1b-14ec-4fd6-91b3-9a417622d3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94dc2512c3770c4917616c45f5be4e00 3x", "genre": "art", "nsfw": false, "body": "こんばんは\nいつも依頼を受けていただきありがとうございます\n今回は私がVRChatで使用しているアバターのイラストを描いてほしくてリクエストしました\nよろしくお願いします！！\n\n〇衣装、武器（杖）はドライブにて参照ください\n・衣装は白色に変更してください\n〇描いてほしいイメージ\n・白魔導士（ヒーラー職）\n・表情：微笑んでいる\n・ポーズ指定：無し\n\nhttps://drive.google.com/drive/folders/1vb39mh6GDeeFRoUvWZfsgRG7ZS_wsMO9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/273", "thumbnail_src": "https://si.imgix.net/db0d1e4d/uploads/origins/d75263de-485d-4436-8bfc-8977d203b558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40e19755cc25a2a85d7bda2f2bc32046", "thumbnail_srcset": "https://si.imgix.net/db0d1e4d/uploads/origins/d75263de-485d-4436-8bfc-8977d203b558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40e19755cc25a2a85d7bda2f2bc32046, https://si.imgix.net/db0d1e4d/uploads/origins/d75263de-485d-4436-8bfc-8977d203b558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79f5afae544e894dc4e0563b604c3e85 2x, https://si.imgix.net/db0d1e4d/uploads/origins/d75263de-485d-4436-8bfc-8977d203b558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77ee62e2598e5e9bb94be901e9fd290d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/272", "thumbnail_src": "https://si.imgix.net/a974822a/uploads/origins/a3d3d882-0c66-4d63-a07e-3af51eeacd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=843f8afbd0ee092374e2911051d3a907", "thumbnail_srcset": "https://si.imgix.net/a974822a/uploads/origins/a3d3d882-0c66-4d63-a07e-3af51eeacd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=843f8afbd0ee092374e2911051d3a907, https://si.imgix.net/a974822a/uploads/origins/a3d3d882-0c66-4d63-a07e-3af51eeacd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a595333c9238ee8bf8c3e60f28ed1de4 2x, https://si.imgix.net/a974822a/uploads/origins/a3d3d882-0c66-4d63-a07e-3af51eeacd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6f4033d5e1ae93037668576238ae6ed 3x", "genre": "art", "nsfw": false, "body": "RSNさん、初めまして。胖達（ぱんだ、Panda）と申します。\n先生の描かれるキャラクターと、細部まで凝った衣装デザインが大好きで、ぜひ私の新衣装をデザインしていただきたくリクエストいたしました。\n【デザイン依頼内容】\n・テーマ：「山居 × 神職」\n・モチーフ：山暮らしの素朴さと、神職の神聖さを掛け合わせた和モダンな雰囲気。\n・小物：神楽鈴（デザインや持ち方は自由です）。\n・雰囲気：カッコよさの中に、少し可愛らしさもあるイメージ。\n【構図・その他】\n・衣装全体が正面からよく見えるようにお願いします。\n・ポーズや表情は自由です。先生の感性にお任せいたします。\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。よろしくお願いいたします！\n\n参考画像（設定など）はこちらにまとめています: https://drive.google.com/file/d/1dW1c-V_wWdzHW5ZiA-KBJaCseKJaO3QG/view?usp=drivesdk\n\nhttps://drive.google.com/drive/folders/1PwN3aMfGE0f9NRUdT1UffuXLtmeAnbTv", "created_at": "", "completed_at": ""}, {"path": "/@RSN_07/works/271", "thumbnail_src": "https://si.imgix.net/bdc22a5d/uploads/origins/f6b68a7e-477c-4c25-b919-a3f9e5ceea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6147cdb3706e56dba2548df116b557ff", "thumbnail_srcset": "https://si.imgix.net/bdc22a5d/uploads/origins/f6b68a7e-477c-4c25-b919-a3f9e5ceea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6147cdb3706e56dba2548df116b557ff, https://si.imgix.net/bdc22a5d/uploads/origins/f6b68a7e-477c-4c25-b919-a3f9e5ceea17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0b50e99dd336823eb95b892e8a22836 2x, https://si.imgix.net/bdc22a5d/uploads/origins/f6b68a7e-477c-4c25-b919-a3f9e5ceea17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efdba03b38cc0bd44995759357a9aba7 3x", "genre": "art", "nsfw": false, "body": "RSN先生\nいつも先生のイラストが大好きで、以前は友人にお願いしてSkebで依頼させていただきました。本当に素晴らしく、とても気に入っています。\n\n今回は、豊作をテーマにしたイラストをぜひお願いしたくご連絡いたしました。\n\n〈イラスト内容のご希望〉\n\t•\tキャラは豊作の稲田に立つ\n\t•\t右手には収穫した稲穂を抱えている\n\t•\t左手で、まだ収穫前の稲をやさしく撫で\n　　　　ている。\n\t•\t目を閉じ、穏やかな表情\n\t•      服装は神職風(デザインはRSN先生\n　　　　ご自由に！)\n\t•\t背景に伊勢の鳥居を入れていただきたい\n\t•\t天気は晴れのイメージ\n\nもし可能でしたら、こちらのテーマでご制作いただけると大変嬉しいです。\nどうぞよろしくお願いいたします。\n\nhttps://dr