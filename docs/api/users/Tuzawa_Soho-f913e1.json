mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc92b1b13822924df1fc1dc7963c4ed9 2x, https://si.imgix.net/677190a2/uploads/origins/30cb0605-5369-4028-9a78-3bfe5753e9f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d9348f90777aa583d56c20387b91553 3x", "genre": "art", "nsfw": false, "body": "つざわ様\n\n始めまして、配信者として活動しているマスタードと申します。\nTwitterにてつざわ様のイラストを拝見させていただき、\n絵柄がとても素敵で目が惹き付けられ、リクエストさせていただきました…！\nつざわ様のご都合がよろしければ、是非私の代理キャラクターを描いていただけないでしょうか…！\n\n【使用用途】\nYouTube、Twitter、ラジオトーク等活動の全般。\n（ラジオトークというアプリで毎週水曜日にラジオを放送しているのですが、毎回お便りが面白かった方に無償でステッカーをプレゼントするということを行っており、そのステッカーのイラストに是非使用させて頂けないかなと思っております。可能でしょうか…？）\n\n【イラストに関する指定】\n画像アスペクト比は：1：1の正方形でお願いしたいです！\n構図はバストアップで、表情やポーズ等はつざわ様に自由におまかせでお願いします！\n\n【参考資料】\nこちらの画像を参考にしていただければ幸いです！\nhttps://drive.google.com/drive/folders/1mYFQeEz7lpeXgMzZT16Jvtg4wj4Ojxcc?usp=drive_link\n\n難しい場合はお手数ではございますがキャンセルをお願い致します。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tuzawa_Soho/works/8", "thumbnail_src": "https://si.imgix.net/dc6ac4e5/uploads/origins/e2f5c021-a934-42e8-bcda-fc955d3ba75b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff1655d116971bda8ecfcbe7dc4899f7", "thumbnail_srcset": "https://si.imgix.net/dc6ac4e5/uploads/origins/e2f5c021-a934-42e8-bcda-fc955d3ba75b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff1655d116971bda8ecfcbe7dc4899f7, https://si.imgix.net/dc6ac4e5/uploads/origins/e2f5c021-a934-42e8-bcda-fc955d3ba75b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bc8b6952216f98d169bbbd5e1758fbd 2x, https://si.imgix.net/dc6ac4e5/uploads/origins/e2f5c021-a934-42e8-bcda-fc955d3ba75b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a90da2f1e509f22af8a35aa029443791 3x", "genre": "art", "nsfw": true, "body": "ﾅﾃﾞﾀﾗﾒｼｭｲｷｽﾝﾃﾞｶﾗｶﾙ", "created_at": "", "completed_at": ""}, {"path": "/@Tuzawa_Soho/works/7", "thumbnail_src": "https://si.imgix.net/2fe20818/uploads/or