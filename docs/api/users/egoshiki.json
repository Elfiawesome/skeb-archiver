b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=451ded6fbc1a08f9fff4e80e15bc58b6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/34", "thumbnail_src": "https://si.imgix.net/651798a4/uploads/origins/2950f44b-ab03-431a-8586-0087b536d7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55241ea3b7c9f5e4d69c46cdf63ab18f", "thumbnail_srcset": "https://si.imgix.net/651798a4/uploads/origins/2950f44b-ab03-431a-8586-0087b536d7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55241ea3b7c9f5e4d69c46cdf63ab18f, https://si.imgix.net/651798a4/uploads/origins/2950f44b-ab03-431a-8586-0087b536d7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22693abdf46c11790752a8d10d9e9dbd 2x, https://si.imgix.net/651798a4/uploads/origins/2950f44b-ab03-431a-8586-0087b536d7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12e52455fdc0c698425dce83ae9bdd54 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/33", "thumbnail_src": "https://si.imgix.net/e1c6479c/uploads/origins/4146d651-8131-4a6c-bd26-7cef64a5e71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb3292a420537c05bf7a48c6135d240", "thumbnail_srcset": "https://si.imgix.net/e1c6479c/uploads/origins/4146d651-8131-4a6c-bd26-7cef64a5e71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb3292a420537c05bf7a48c6135d240, https://si.imgix.net/e1c6479c/uploads/origins/4146d651-8131-4a6c-bd26-7cef64a5e71b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dce71733e51c2f759071cff4e083f996 2x, https://si.imgix.net/e1c6479c/uploads/origins/4146d651-8131-4a6c-bd26-7cef64a5e71b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bb545fcd32ac21690e42c0aba21a44f 3x", "genre": "art", "nsfw": true, "body": "鮮花、もしくは幹也に、立ったまま指でされて、感じてしまう式をお願いします。力が抜けて縋りついてしまっている感じで。また、気持ち良くなってしまった結果の失禁差分はアリでお願いします！　愛液や致してしまったもので、下着が染みてしまっていると最高です。大筋このような感じでお任せします。信仰上の理由でこのシチュは無理と思われたら、遠慮なく切ってしまって下さい。", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/32", "thumbnail_src": "https://si.imgix.net/eab80dbb/uploads/origins/a9058e3e-2ac5-4064-93c9-3c0f6a0b5b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9ec73c3d79c6d2a1be1d1116dc86f1", "thumbnail_srcset": "https://si.imgix.net/eab80dbb/uploads/origins/a9058e3e-2ac5-4064-93c9-3c0f6a0b5b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9ec73c3d79c6d2a1be1d1116dc86f1, https://si.imgix.net/eab80dbb/uploads/origins/a9058e3e-2ac5-4064-93c9-3c0f6a0b5b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f4e46147088fe4cb5b5fb9ba1b06200 2x, https://si.imgix.net/eab80dbb/uploads/origins/a9058e3e-2ac5-4064-93c9-3c0f6a0b5b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dba586f76f3a16928218557d34f3ae44 3x", "genre": "art", "nsfw": false, "body": "えご。先生\nはじめまして。\n\n日頃より式のイラスト、最近はトラックジャケットの子イラストで楽しませていただいております。\nえご。先生の絵柄とキャラが刺さりそうと思い今回依頼を出させて頂きました。\n\n以下依頼内容となります。\nキャラクター：良秀（リンバスカンパニー）\n人格（容姿）：エドガー家チーフバトラーもしくはLCB囚人\nポーズや構図：先生にお任せします\n\nチーフバトラーの方はメイド姿で刀を腰に携えつつ暗器メインとしており、LCB囚人の方はパンツにシャツ、ジャケットスタイルで刀を携えており、どちらもえご先生。の絵で見たいのでどちらかお願いします。\n（今回選ばれなかった容姿は後日別途で依頼します）", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/31", "thumbnail_src": "https://si.imgix.net/2b1c5a95/uploads/origins/ad7b0777-674f-48e9-8b6e-9b66696ad68d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad182da7d78685a2e726ef2f59cdc309", "thumbnail_srcset": "https://si.imgix.net/2b1c5a95/uploads/origins/ad7b0777-674f-48e9-8b6e-9b66696ad68d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad182da7d78685a2e726ef2f59cdc309, https://si.imgix.net/2b1c5a95/uploads/origins/ad7b0777-674f-48e9-8b6e-9b66696ad68d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba163ae1d415baf700affa076f97a4e3 2x, https://si.imgix.net/2b1c5a95/uploads/origins/ad7b0777-674f-48e9-8b6e-9b66696ad68d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1aa5a50a9eeadc73c63bfe1a13b6774 3x", "genre": "art", "nsfw": false, "body": "初めまして、えご。さん。skebで拝見したイラストとキャラデザが非常に良かったので、この度は自分もTRPGのPCのキャラデザをお願いしたく、リクエストを送らせていただきました\n\n・イメージはクトゥルフ神話TRPGや現代ホラーモノに出てきそうな、言葉で自己主張はあまりしないけど行動はアクティブな女主人公\n ・外見年齢は20代前半\n ・髪は黒色のセミショート。髪型と顔立ちのイメージはシン仮面ライダーの緑川ルリ子(https://www.kamen-rider-official.com/zukan/characters/3744)\n・眼はクールな目つきのハイライトの無い黒色\n ・身長は155〜160cmほど。スタイルが良く、胸はFカップで尻も安産型で大きめ\n ・服装は赤茶色のトレンチコートを前開きで纏い、リブニットの黒い服とピッチリめの黒いスキニーパンツを着用。黒いブーツを履いている\n ・性格はクールでドライ。割と勝気で物怖じせず、遠慮なくズバズバものを言う\n・可能であれば差分希望で、トレンチコート無しの差分をお願いします\n\n以上が内容になります。書いていない部分はお任せします。また無理そうな所は変えたり、良い案がありましたらそちらを採用したり服装を変更したりアレンジしたりして大丈夫です。ご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/30", "thumbnail_src": "https://si.imgix.net/6508278e/uploads/origins/ef856f97-3fe9-4d81-8006-3f60a45797af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=022ab8c60e3e10971fa59a4fd4b38258", "thumbnail_srcset": "https://si.imgix.net/6508278e/uploads/origins/ef856f97-3fe9-4d81-8006-3f60a45797af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=022ab8c60e3e10971fa59a4fd4b38258, https://si.imgix.net/6508278e/uploads/origins/ef856f97-3fe9-4d81-8006-3f60a45797af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f93cfb087bc71ee88c500c150f160c1 2x, https://si.imgix.net/6508278e/uploads/origins/ef856f97-3fe9-4d81-8006-3f60a45797af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36872a0688d0fea4b48b7766c8073e01 3x", "genre": "art", "nsfw": true, "body": "お世話になっております\n前回のイラストがとても良かったので、また両儀式と両儀織のすけべイラストをお願いしたいです。（解釈違いでしたらキャンセルして下さい）\n\nイメージお伝えしやすそうなものを資料として入れておりますが\n構図などはお任せです。\n2人とも着衣で織が後ろから式を抱きしめて耳を舐めているイラストになります\n式メインで、前回のイラストのように2人の全身まで入らなくて問題ありません\n（構図はお任せなので入れた方が良いという判断でも結構です）\n\n資料1の様に背後から抱きしめて耳舐め\n資料2やこちらのイラストの様に織が後ろから抱きしめて、足を使って式の足を開かせています\nhttps://skeb.jp/@egoshiki/works/20\n\n参考資料\nhttps://www.dropbox.com/scl/fo/keqp6s7a18e25nai5fj5u/h?rlkey=62ogm7tu0kxcc2fqkhgpnay6d&dl=0\n\n\n以下細かい要望ですが\nどの程度の描写までなら大丈夫なのか分かりませんので、可能な範囲での調整をしていただければ結構です\n\n後ろから手を回して\n口の中に指をいれている/下着の中へ\n　　　　　　　　or\n顎を掴んでいる/着物の胸元へ　\n着物の胸元へ/太ももへ　など（組み合わせ変更可）\n\n耳の中まで涎塗れで口元へ糸を引いている\n下着とそのすぐ下の着物が濡れている\n2人の表情のニュアンスはお任せ\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/29", "thumbnail_src": "https://si.imgix.net/f980290b/uploads/origins/566af4bb-a299-49ac-b493-fb3461c7947a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5f8d8a785242ca494eb23125e5d88a8", "thumbnail_srcset": "https://si.imgix.net/f980290b/uploads/origins/566af4bb-a299-49ac-b493-fb3461c7947a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5f8d8a785242ca494eb23125e5d88a8, https://si.imgix.net/f980290b/uploads/origins/566af4bb-a299-49ac-b493-fb3461c7947a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=def6a4abe5668da74fd1b3d7374d286c 2x, https://si.imgix.net/f980290b/uploads/origins/566af4bb-a299-49ac-b493-fb3461c7947a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65e2aaa5cb1d020899a6a1495947d7f2 3x", "genre": "art", "nsfw": true, "body": "依頼内容を加筆修正して再送します\n\nhttps://twitter.com/egoshiki/status/1748672318027825277/photo/1 \n↑　この娘のエロ漫画お願いできますでしょうか\n\n敵女性たちに拘束されてエロいことされる、イッた拍子に十手落としちゃうモノクロエロ漫画  \n\n武器持った女の子が武器落としちゃう瞬間が好きです、武器落とす＝心が折れる表現\n\n・https://x.com/egoshiki/status/1775485284324696539?s=46&t=6HmSmATHy4sD2vXB3bvRNA\n↑ これくらいのクオリティのモノクロ漫画\n\n以下展開\n・敵女性に羽交い締めにされる、にらみつける、十手を握り締まる \n・ネクタイとブラを奪われてノーブラYシャツの状態、谷間は見えるが乳首は見えない \n・もう一人の女性に片方の乳首を服の上からしゃぶられる、オリキャラちゃんは乳首が弱点、舌や歯で軽く噛まれて刺激される、余裕がなくなってだんだん声が我慢できなくなり喘ぐ、そのまま絶頂\n・イッた拍子に十手を落としてしまう\n・口を離すとヨダレで濡れたYシャツ越しに乳首がしっかり勃起しているのがわかる \n・抵抗する手段を失い弱気になったオリキャラちゃんに再び乳首責めを再開、再び乳首に口が近づく様子を見てい、いやっと弱気な声をあげ再開された乳首責めに声が我慢できない、最初より大きな声で喘ぐ\n\n敵の女性は適当でよいです、女性だとわかればいいです  \n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/28", "thumbnail_src": "https://si.imgix.net/8020e6a2/uploads/origins/4461b450-f475-4681-a3e7-e6626d72729d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b076a8f8122372d024b54c54e46828b", "thumbnail_srcset": "https://si.imgix.net/8020e6a2/uploads/origins/4461b450-f475-4681-a3e7-e6626d72729d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b076a8f8122372d024b54c54e46828b, https://si.imgix.net/8020e6a2/uploads/origins/4461b450-f475-4681-a3e7-e6626d72729d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0e41296f204b85a701dde25d3f2cd35 2x, https://si.imgix.net/8020e6a2/uploads/origins/4461b450-f475-4681-a3e7-e6626d72729d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a249b8b0a35176e73500a19d34289833 3x", "genre": "art", "nsfw": false, "body": "カタワ少女のリリーのアート。ポーズは自由。\n\nhttps://katawashoujo.fandom.com/wiki/Lilly_Satou", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/27", "thumbnail_src": "https://si.imgix.net/3aca83d5/uploads/origins/6fcc8d8b-52d9-4efe-bc7a-a1ec518e1a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7854ddb9c964764eb4d6336dd9390612", "thumbnail_srcset": "https://si.imgix.net/3aca83d5/uploads/origins/6fcc8d8b-52d9-4efe-bc7a-a1ec518e1a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7854ddb9c964764eb4d6336dd9390612, https://si.imgix.net/3aca83d5/uploads/origins/6fcc8d8b-52d9-4efe-bc7a-a1ec518e1a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df2a3e5c56430f4713eaac36187b4c85 2x, https://si.imgix.net/3aca83d5/uploads/origins/6fcc8d8b-52d9-4efe-bc7a-a1ec518e1a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7324b3115f00ce5fb95b5b9db18dd6bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/26", "thumbnail_src": "https://si.imgix.net/5c3a42ca/uploads/origins/4f09e696-cacc-45cb-a0e9-e2d445373d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d71aa1e48d0d3c569f348f62597bf9b", "thumbnail_srcset": "https://si.imgix.net/5c3a42ca/uploads/origins/4f09e696-cacc-45cb-a0e9-e2d445373d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d71aa1e48d0d3c569f348f62597bf9b, https://si.imgix.net/5c3a42ca/uploads/origins/4f09e696-cacc-45cb-a0e9-e2d445373d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2da1d4073af3ee0b8d04166402c74ea7 2x, https://si.imgix.net/5c3a42ca/uploads/origins/4f09e696-cacc-45cb-a0e9-e2d445373d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e33361f6f4ce47dc92e3b1f234dce79a 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nえご様の絵が好みで、可能であればイラストを描いて頂きたく、今回リクエストさせていただきます。\n\nリクエスト内容\n参考URLのキャラクターを描いて頂きたいです。\nウルフヘアの中性的な男性、赤橙色の瞳、左目に泣きぼくろがあります。\n超能力者でチェスと音楽が好きです。\nポーズや構図、衣装等はお任せで描いて頂きたいです。\n\n使用用途はアイコンや個人鑑賞等です。\nご検討頂ければ幸いです、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1S_BDrYEmMDOFXceWsokzbZAC3TYfjvb2", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/25", "thumbnail_src": "https://si.imgix.net/e3ff3594/uploads/origins/f96ffe8f-fe4d-4f1c-8f52-43fd53665e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a62d828fc38e8c79255b17610b530831", "thumbnail_srcset": "https://si.imgix.net/e3ff3594/uploads/origins/f96ffe8f-fe4d-4f1c-8f52-43fd53665e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a62d828fc38e8c79255b17610b530831, https://si.imgix.net/e3ff3594/uploads/origins/f96ffe8f-fe4d-4f1c-8f52-43fd53665e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f391b89113312aea6b06d74206e22424 2x, https://si.imgix.net/e3ff3594/uploads/origins/f96ffe8f-fe4d-4f1c-8f52-43fd53665e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdf4247a98e0b2aa34cc33eeb4861734 3x", "genre": "art", "nsfw": false, "body": "連続のリクエスト失礼します。\n今回はぼっち・ざ・ろっくに登場するキャラクター廣井きくりの立ち絵をえごさんの絵のタッチで描いて欲しいと思いリクエストを送りました。\n\n目は瞳の中がぐるぐる目で少し酔ってる様な顔で服装は黒スーツに白ワイシャツ、黒ネクタイの恰好にしてほしいです。\n正面立ち絵で腰上辺りまでお願いしたいです\n使用用途はTRPGの立ち絵の為背景は白にしてほしいです。\n是非宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/24", "thumbnail_src": "https://si.imgix.net/a22ca7b7/uploads/origins/7df69be0-6045-4ac9-93dc-bf7ebe827d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=127da3133c894d26ab5fde3872c6b70d", "thumbnail_srcset": "https://si.imgix.net/a22ca7b7/uploads/origins/7df69be0-6045-4ac9-93dc-bf7ebe827d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=127da3133c894d26ab5fde3872c6b70d, https://si.imgix.net/a22ca7b7/uploads/origins/7df69be0-6045-4ac9-93dc-bf7ebe827d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=808991df7cd898468664f8d24868b792 2x, https://si.imgix.net/a22ca7b7/uploads/origins/7df69be0-6045-4ac9-93dc-bf7ebe827d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a571f95b71ae802e457ba576e19adf54 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/23", "thumbnail_src": "https://si.imgix.net/511286b2/uploads/origins/2cf01147-0db7-4e5d-b897-0620715a753c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e49170a722938d600c815926e139ff", "thumbnail_srcset": "https://si.imgix.net/511286b2/uploads/origins/2cf01147-0db7-4e5d-b897-0620715a753c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e49170a722938d600c815926e139ff, https://si.imgix.net/511286b2/uploads/origins/2cf01147-0db7-4e5d-b897-0620715a753c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=519b8533776d70b58a595b9d94bc3aec 2x, https://si.imgix.net/511286b2/uploads/origins/2cf01147-0db7-4e5d-b897-0620715a753c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5508a10a64a8f6598f6f57ad0550c9d2 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\nえごさんの絵のタッチで描いて欲しくて本日はリクエストいたしました。\n使用用途はTRPGの立ち絵として使用したいなと思っています。\n腰上辺りまでの白背景でお願いしたいです。\n一部文章が抜けていたので再度リクエストです\n\n[見た目]\n全体的にスレンダーな体型、性別は男性だが女性顔\n少し血色の悪い肌と目の下の薄いクマがありハイライトが薄い黒い目でまだ幼さが残ってる様な顔立ち\n肩に少しかかる位のセミロングで黒髪に緑色のメッシュを一房の髪と内側に入れて欲しいです\n[服装]\nブルーアーカイブの登場キャラである錠前サオリの様な外套に、骸骨と文字がない白のラインだけ入った黒い腕章\n黒色のシャツに黒色で六角形に緑色のラインが入ったネクタイを緩く締めている\n[アクセサリー]\n耳に黒色のピアスを数個つけている\n黒色のベルトを片方の肩に下げており物を吊り下げてる様な形\n\n以上な形を基本にえごさん風にメイクして仕上げて欲しいです\n今年も素敵なイラストを待っています、宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/22", "thumbnail_src": "https://si.imgix.net/0c8b9024/uploads/origins/25c0f3b6-760d-41f0-b40a-01ff8a08da84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b1a1c05fbd20724f64b17e93a132b6", "thumbnail_srcset": "https://si.imgix.net/0c8b9024/uploads/origins/25c0f3b6-760d-41f0-b40a-01ff8a08da84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b1a1c05fbd20724f64b17e93a132b6, https://si.imgix.net/0c8b9024/uploads/origins/25c0f3b6-760d-41f0-b40a-01ff8a08da84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68f882a01483cf7e930777d091f0de1f 2x, https://si.imgix.net/0c8b9024/uploads/origins/25c0f3b6-760d-41f0-b40a-01ff8a08da84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d3f914db325935fd333587e89e10566 3x", "genre": "art", "nsfw": true, "body": "こんにちは、エゴ！あなたの式や他の作品を見て、とても気に入りました！だから、あなたに依頼したいと思いました！\n\nクレイモアのミリアのオーバーコート、黒いタートルネックのセーター、黒いリボンのパンティー...セーターを引き上げて、下に黒いブラジャーが見えるようにしてほしい。\n\nキャラクター紹介：\nhttps://imgur.com/a/mlu3jAX\n\nポーズ/表情の参照：\nhttps://imgur.com/a/BqQt79V\n\nオーバーコート参照：\nhttps://imgur.com/a/qdhFQLb", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/21", "thumbnail_src": "https://si.imgix.net/da6651a1/uploads/origins/73d8af1a-1a3a-43bf-b58a-98311da90f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d73710102be9f578af9d27c7915a5c4", "thumbnail_srcset": "https://si.imgix.net/da6651a1/uploads/origins/73d8af1a-1a3a-43bf-b58a-98311da90f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d73710102be9f578af9d27c7915a5c4, https://si.imgix.net/da6651a1/uploads/origins/73d8af1a-1a3a-43bf-b58a-98311da90f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1544b647c99d1b36a21473dac69519d7 2x, https://si.imgix.net/da6651a1/uploads/origins/73d8af1a-1a3a-43bf-b58a-98311da90f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5588c7e9ccddfb925806b4e11e5f5ff3 3x", "genre": "art", "nsfw": true, "body": "前回は式と藤乃の素敵なイラストをありがとうございました\n\nこちらの内容を織と式の2人のイラストでお願いしたいです。\n一応NSFWと致します。\n\n参考イラストのような体勢で識が式を押し倒してこちらへ視線を向けている\n（構図などの調整はお任せです）\n服は着物と革ジャンでブーツも履いています\n式は足を開いて、識も着物の裾が捲れてお尻と下着が見えている状態\n前回と同じくどちらも冷めた視線の表情\n下着はセクシー系で、お尻を向けている織の方はTバック希望です\n（解釈違いの場合はお任せします）\n\n\n今回も差分をお願いしたいのですが\n・2人の表情\n・下着　となります\n\nえご。さんの織式が好きなので指定とは別の表情をお願いしたいです\nこちらはもしご自身で描いた場合として2人の雰囲気含めてお任せです\n\nそれと先日の呟き拝見しまして、以前からリクエストしたかったので2人が下着ではなく褌を履いているものもお願いしたいです（資料参照）\n\nPSDデータとpngファイルで納品していただけると幸いです。\n\n参考資料\nhttps://www.dropbox.com/scl/fo/hw06jerrni07i1hpcsegj/h?rlkey=4t9kem0j3wpe2wtlhj2l69lje&dl=0\n\n\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/20", "thumbnail_src": "https://si.imgix.net/a1b3bafc/uploads/origins/34db9791-d310-494c-936b-777b423d599c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f54f40b86038465d90c0439e160868e", "thumbnail_srcset": "https://si.imgix.net/a1b3bafc/uploads/origins/34db9791-d310-494c-936b-777b423d599c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f54f40b86038465d90c0439e160868e, https://si.imgix.net/a1b3bafc/uploads/origins/34db9791-d310-494c-936b-777b423d599c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c8302abbff67c57498d273ef3f257a8 2x, https://si.imgix.net/a1b3bafc/uploads/origins/34db9791-d310-494c-936b-777b423d599c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dbd6bdb5f5733d76c8725d7f3e4ee9b 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n式さんのすけべイラストに惹かれたので依頼させていただきます。\n\n両儀式が黒桐に生おっぱいを揉まれているイラストをお願いしたいです。\n\n以下細かい要望です。\n・揉まれ方は後ろから着物の胸元に手を突っ込まれて…みたいにしてください。\n・表情は呆れたようなジト目(嫌だとは言っていない)のような感じでお願いします。\n・ちょっと感じちゃった差分があると嬉しいです。\n\n以上になります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/19", "thumbnail_src": "https://si.imgix.net/6ed7cb25/uploads/origins/de42cc5f-b69b-4e03-94ca-0c4c3e04410f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab551cab7cfaabdf9018b74232b88472", "thumbnail_srcset": "https://si.imgix.net/6ed7cb25/uploads/origins/de42cc5f-b69b-4e03-94ca-0c4c3e04410f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab551cab7cfaabdf9018b74232b88472, https://si.imgix.net/6ed7cb25/uploads/origins/de42cc5f-b69b-4e03-94ca-0c4c3e04410f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4db70f25ddc74c6d1898d46ce57736df 2x, https://si.imgix.net/6ed7cb25/uploads/origins/de42cc5f-b69b-4e03-94ca-0c4c3e04410f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f891cf267e4a3540fe61f4fc07234294 3x", "genre": "art", "nsfw": false, "body": "はじめまして、依頼の失礼致します。\nリーズバイフェ・ストリンドヴァリを描いていただけませんか。全身できれば。\n服は黒のスーツとネクタイを着ている、執事のように。\n表情が悪意の微笑み。\nポーズはえごさんお任せしたい。おそらく何かかっこいいのだろう。\nどうもありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/18", "thumbnail_src": "https://si.imgix.net/d3369bf4/uploads/origins/25f573e7-60f6-42ea-b57e-38839aa29d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65ae276f2b3c7f86775c6f74116f323", "thumbnail_srcset": "https://si.imgix.net/d3369bf4/uploads/origins/25f573e7-60f6-42ea-b57e-38839aa29d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65ae276f2b3c7f86775c6f74116f323, https://si.imgix.net/d3369bf4/uploads/origins/25f573e7-60f6-42ea-b57e-38839aa29d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2884c429a3411f5da6b176072158974 2x, https://si.imgix.net/d3369bf4/uploads/origins/25f573e7-60f6-42ea-b57e-38839aa29d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48eafb0fba7317ec6b686383f5ca61a6 3x", "genre": "art", "nsfw": false, "body": "初めまして。いつも素敵なイラストを拝見させて頂いております。\n以前skebの方で投稿されていた“勝負下着姿の式と藤乃”がとても鮮烈で衝撃を受け、今回の依頼を決めました。\n\n内容は、\n「勝負下着を履いた藤乃が、目隠しをされたぐだ子の顔にスカートを捲り上げてお尻を近付ける」です。\nがっつり悪属性。仄暗いようで大胆な藤のんも良いかと思います。\n下着のデザインはあの投稿のもので、表情等はお任せします。\n\nお忙しい中とは存じますが、もし宜しければ是非お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@egoshiki/works/17", "thumbnail_src": "https://si.imgix.net/df728e3d/uploads/origins/077f4301-94fb-44ca-bf12-a03060674de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=946f30c70ee683020d2767e375ed55f2", "thumbnail_srcset": "https://si.imgix.net/df728e3d/uploads/origins/077f4301-94fb-44ca-bf12-a03060674de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=946f30c70ee683020d2767e375ed55f2, https://si.imgix.net/df728e3d/uploads/origins/077f4301-94fb-44ca-bf12-a03060674de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=521259351baf602b1014933739524f26 2x, https://si.imgix.net/df728e3d/uploads/origins/077f4301-94fb-44ca-bf12-a03060674de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c565a81a79337220080f1915551deb9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}