3/uploads/origins/42702f33-a05b-4a7e-918d-c251a0e7a963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ae0871c73b5c96793e8724f1fc20dc", "thumbnail_srcset": "https://si.imgix.net/532d6ed3/uploads/origins/42702f33-a05b-4a7e-918d-c251a0e7a963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ae0871c73b5c96793e8724f1fc20dc, https://si.imgix.net/532d6ed3/uploads/origins/42702f33-a05b-4a7e-918d-c251a0e7a963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=476d0a3438dd9ff463c820b396c2fa6c 2x, https://si.imgix.net/532d6ed3/uploads/origins/42702f33-a05b-4a7e-918d-c251a0e7a963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91f2e8906ae40382b85db1703b2c9a54 3x", "genre": "art", "nsfw": false, "body": "響さん初めまして\n個人勢Vtuberのななたろう（https://x.com/nanatarou57）さんと秋月華詩亜（https://x.com/AkidukiCashia）さんのイラストをお願いしたいです\n\nななたろうさんが異形化華詩亜さんと対峙しているシチュでお願いします\n\nななたろうさんの衣装は https://x.com/nanatarou57/status/1569266926693814272 のもので、刀身の色が黄色のビームサーベルを持たせてください\n\n異形化華詩亜さんは https://x.com/AkidukiCashia/status/1960370375226782071/photo/1(万が一このリンクを開けなかったら、https://x.com/AkidukiCashia のメディア欄を参照してください)をベースに「地球防衛軍」シリーズの歴代の強敵たちが融合したような姿で、下半身が「ドラゴン・センチピード（百足）」、背中に「サイレン」の翼、頭に「ドラゴン型巨大生物」のツノ、顔には本来の眼球とは別に「侵略生物β」の複眼が形成され、口内に「ネイカー」の火炎放射器を内蔵し、両腕が機械化されていて右腕はビームキャノン、左腕は回転ノコギリにしてください\nまた、下半身の百足部分は金色で、機械化部分は銀色、ビームキャノンのみ青色で、背中に巨大な弾道ミサイルを背負わせてください。\n\n凶悪さと悍ましさを前面的に押し出してほしいです\n\n参考資料(地球防衛軍シリーズの敵たち)\nドラゴン型巨大生物 https://www.d3p.co.jp/edf4.1/#enemy9\nサイレン https://www.d3p.co.jp/edf6/enemy/enemy05.php\nネイカー https://www.d3p.co.jp/edf6/enemy/enemy04.php\n侵略生物β https://www.d3p.co.jp/edf6/enemy/enemy01.php(複眼の色は赤色でお願いします)", "created_at": "", "completed_at": ""}, {"path": "/@Anderson_M0311/works/226", "thumbnail_src": "https://si.imgix.net/e9c35da0/uploads/origins/c9759dda-64a9-453b-ada8-c9324e3afef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign