h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f67c4ff7d3327985de7151ab2289329 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chabi_0427/works/52", "thumbnail_src": "https://si.imgix.net/e4e4369d/uploads/origins/246a5a97-487d-410e-9723-483851d26eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afbc98757ca09c9c4eea846348325f82", "thumbnail_srcset": "https://si.imgix.net/e4e4369d/uploads/origins/246a5a97-487d-410e-9723-483851d26eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afbc98757ca09c9c4eea846348325f82, https://si.imgix.net/e4e4369d/uploads/origins/246a5a97-487d-410e-9723-483851d26eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46520a03baab2ec0fb05f2c695808eeb 2x, https://si.imgix.net/e4e4369d/uploads/origins/246a5a97-487d-410e-9723-483851d26eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51e863ccb07e843310b72450732b3e93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chabi_0427/works/51", "thumbnail_src": "https://si.imgix.net/c80e665f/uploads/origins/d9f62c93-ad7c-43a1-ae19-bfbd2b1c6361?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59391caa3ed8f5fb73137186865e5e19", "thumbnail_srcset": "https://si.imgix.net/c80e665f/uploads/origins/d9f62c93-ad7c-43a1-ae19-bfbd2b1c6361?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59391caa3ed8f5fb73137186865e5e19, https://si.imgix.net/c80e665f/uploads/origins/d9f62c93-ad7c-43a1-ae19-bfbd2b1c6361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f88c4ccdffc8012e0e6ad4c797c76948 2x, https://si.imgix.net/c80e665f/uploads/origins/d9f62c93-ad7c-43a1-ae19-bfbd2b1c6361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed1b3e5ce2417cb0f5c55a22b3824b8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Chabi!私はあなたの作品がとても好きです。アンダーテールのマフェットが焼き菓子を売るカフェを経営している依頼をやってみたいと思います。いつも通り1920x1080でお願いします!この作品はTwitchかどこかでバナーとして使用し、あなたのアカウントにクレジットを入れる予定です。\n\n参考リンクにマフェットに関する情報と、作品の雰囲気がわかるような画像を載せています。このムードボードに完全に従う必要はありません。この作品に関するすべてのことは、あなたとこの依頼に関するあなたのアイデアによって完全に決定することができます!マフェットのデザイン、カフェのインテリア、その他のディテールは、アーティストの解釈にお任せしたいと思います。\n\n椅子の形やテーブルクロスのデザイン、全体の雰囲気など、統一感を持たせてもいいかもしれません。このパターンを踏襲するもよし、自分の作風に合ったものを作るもよし。\n\n強いて言えば、店に入ってきたばかりのお客さんが、カウンターの中ほどまで来たところから見た構図がいいかなと思います。お店に入って、スマホを取り出して写真を撮るのと似ていますね。マフェットは、カウンターの後ろから、頬に手を当てながら、もう一人の手で手を振って、見る人を見ているでしょう。さらに両腕には、彼女が売っているお菓子の一例や、いつものようにティーポットやティーカップが掲げられているかもしれません。パン屋の一部であるため、いくつかの例では、ガラスの後ろに表示されますまたは多分彼女の背後にあります。彼女が売ることで知られているサイダーのボトルも見えますよ。\n\nこのプロンプトは、カフェのインテリアについて考えることを意味しています。モダンでもオールドファッションでもOKです。アンダーテールの予備知識をお持ちの方は、ゲームに関連したオブジェをさりげなく入れてもかわいいかもしれませんね。\n\nあと、照明の描き方がとても上手で好きです。もし、照明の演出ができるのであれば、ぜひお願いします。部屋の照明が暗くて威圧感があるとか、太陽が沈んで光線が漏れているとか。ぜひお願いします。\n\n結局、構図はシンプルに \"マフェットが焼き菓子を売るカフェを経営している \"ということです。本当に強調したいのは、「芸術的な自由は完全にある！」ということです。細かいことをいろいろ書きましたが、私のアドバイスやアイデアはあくまでオプションです\n\nありがとうございました。\n\nhttps://imgur.com/a/ORGZ9A5", "created_at": "", "completed_at": ""}, {"path": "/@chabi_0427/works/50", "thumbnail_src": "https://si.imgix.net/d994874d/uploads/origins/3e25dad1-4b8b-4f1b-bca4-2d4f327ce2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=513b6b9eefaf7a4ee86822b22941c97b", "thumbnail_srcset": "https://si.imgix.net/d994874d/uploads/origins/3e25dad1-4b8b-4f1b-bca4-2d4f327ce2eb?bg=%23fff&auto=for