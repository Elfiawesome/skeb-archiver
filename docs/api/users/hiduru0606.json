200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=681771f7d70cfe6dcdb4d54db947d985", "thumbnail_srcset": "https://si.imgix.net/3358b6d7/uploads/origins/857a62d8-2e30-41e9-bff3-98260331cdf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=681771f7d70cfe6dcdb4d54db947d985, https://si.imgix.net/3358b6d7/uploads/origins/857a62d8-2e30-41e9-bff3-98260331cdf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d2b88ed7ab1b13583698969c5b7e920 2x, https://si.imgix.net/3358b6d7/uploads/origins/857a62d8-2e30-41e9-bff3-98260331cdf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2945f37a430e466f2022741be6ab78f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hiduru0606/works/16", "thumbnail_src": "https://si.imgix.net/eb757737/uploads/origins/918d43fd-fee8-4bbd-9b76-e96382db90da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b93ab83ea545723ac240d087f0bd44e", "thumbnail_srcset": "https://si.imgix.net/eb757737/uploads/origins/918d43fd-fee8-4bbd-9b76-e96382db90da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b93ab83ea545723ac240d087f0bd44e, https://si.imgix.net/eb757737/uploads/origins/918d43fd-fee8-4bbd-9b76-e96382db90da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b131caf42c7ea9da4070541a089ccf6 2x, https://si.imgix.net/eb757737/uploads/origins/918d43fd-fee8-4bbd-9b76-e96382db90da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f617dd53ba86e9b09114b4374e4262aa 3x", "genre": "comic", "nsfw": false, "body": "カードファイト!!ヴァンガードのヴァンガードユニット、花占いの女神サクヤとメテオブレイク・ウィザードの1ページ漫画をリクエストします。\nヴォイド予防ワクチン注射の為にメテオブレイクを病院に連れて行こうとするサクヤと、それを全力で拒否するメテオのシチュエーションです。\nネット等でよくあるおでかけのふりして動物病院へ連行され、紐で引っ張られて必死に抵抗する惨めな犬の動画や画像などがありますが、大体あんな感じでお願いします。\nメテオは両手を接地した腑抜けたカエル座りのような状態でしゃがみ込み、顔を斜め上に背け、体重体勢を後ろに全力で傾けて、ヘタれた大型犬を彷彿とさせる無様極まる拒否を決め込みます。\nサクヤは可憐にぎゅっと目を閉じ、口をへの字に結び、懸命にメテオを病院へ連れ込もうとするも体格差のせいで力負け気味。華奢な身体をくの字に曲げ、意外にも健気に奮闘していますが、ジリジリと少しずつ彼に引き摺られています。\nサクヤはメテオのマントの首元付近を両手で掴んで盛大に引っ張っており、他所様から見たらもうそのマント二度と着れなくなるんじゃないかと思うくらいビロンビロンに伸び切っています。\n本来は美丈夫であるメテオの端正な顔立ちは見る影もないくらい引っ張られたマント圧で頬肉と皮が変形し、病院抵抗犬のように最高にブサ可愛くなっています。\n\n細かい描写やコマ割り等はクリエイター様にお任せします。大体の話の流れやセリフとしては\n\n【要1】\nサクヤ「メテオ、急な話ですが私と少し外出しませんか？」\nメテオ「ああ、構わないよ姫さん。どこ行くんだ？」（少しうきうき）\nサクヤ「うふふたぶんたのしいところですよ」（棒）\n\n【要2】\nメテオ「話がっ！違うじゃねえかよぉ！姫さあぁぁぁぁん！ぜってぇそこ楽しくねぇよぉ！」\nサクヤ（無言の渾身引き）\n\n【要3】\nサクヤに優しく両肩を抑えられつつ診療所で結局注射される。メテオ、事前にあんだけ抵抗したくせに刺されるときは某世紀末漫画の主人公みたいな濃い顔で正面無言真顔。マントはビロンビロン。\n\n【要4】\nサクヤに「よく我慢しました、偉いです」的な感じで頭撫でられて褒められる。メテオは体育座りで涙目。\n\n二人共に可愛くて笑えると嬉しいです。\n\n昔pixivで貴方のユニットイラストを見ていて、pixiv新作があったらと思い、此度依頼してみました。宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hiduru0606/works/15", "thumbnail_src": "https://si.imgix.net/a367e7f2/uploads/origins/66fc0431-9fd7-4425-a226-bc604b1e7096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a65dc74d137a0ed019687b8aba071df", "thumbnail_srcset": "https://si.imgix.net/a367e7f2/uploads/origins/66fc0431-9fd7-4425-a226-bc604b1e7096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a65dc74d137a0ed019687b8aba071df, https://si.imgix.net/a367e7f2/uploads/origins/66fc0431-9fd7-4425-a226-bc604b1e7096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc51b92fe9140bc2e5b1edca05f96a66 2x, https://si.imgix.net/a367e7f2/uploads/origins/66fc0431-9fd7-4425-a226-bc604b1e7096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78c297fab767ebcabbf9fff5c09978e1 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nこの度、自分の探索者と他の方の探索者の2名のイラ