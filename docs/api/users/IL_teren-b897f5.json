c096/uploads/origins/616b0d6c-9f90-40ee-b6c0-d94079e14978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d789ad3205a603fa856b157f65482e9e 3x", "genre": "art", "nsfw": false, "body": "水着コッコロの全身絵お願いします！！\n絵の依頼はじめてなので特に細かい依頼はできませんが、てれんさんが可愛いと思う水コロちゃんの絵をお願いします。\n(ロリキャラだれを依頼しようかめっちゃ悩んだ)", "created_at": "", "completed_at": ""}, {"path": "/@IL_teren/works/3", "thumbnail_src": "https://si.imgix.net/882a25b5/uploads/origins/d11a2165-dce3-4a60-ba99-7f68be74c272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1e51c92e46df7efd208bd12396285be", "thumbnail_srcset": "https://si.imgix.net/882a25b5/uploads/origins/d11a2165-dce3-4a60-ba99-7f68be74c272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1e51c92e46df7efd208bd12396285be, https://si.imgix.net/882a25b5/uploads/origins/d11a2165-dce3-4a60-ba99-7f68be74c272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86e260eadc619e947b1c671e892e198c 2x, https://si.imgix.net/882a25b5/uploads/origins/d11a2165-dce3-4a60-ba99-7f68be74c272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2af02143fb9cd5d38a6395170a95ed5 3x", "genre": "art", "nsfw": false, "body": "https://sta.sh/2o1ji8t9d5i\n\nLet's do a full body comic of Yuni-chan in her uniform. It will be her posing with a mirror in her uniform.\n\nユニちゃんのユニちゃんの全身漫画をやってみましょう。制服を着た鏡でポーズをとる。", "created_at": "", "completed_at": ""}, {"path": "/@IL_teren/works/1", "thumbnail_src": "https://si.imgix.net/ace11e63/requests/66261_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7d8b8208d5859566db713c95cc7591", "thumbnail_srcset": "https://si.imgix.net/ace11e63/requests/66261_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7d8b8208d5859566db713c95cc7591, https://si.imgix.net/ace11e63/requests/66261_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2f085921ca759d7c5b2e5f7b6