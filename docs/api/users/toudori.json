o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88eec631ca4eb716634c62e70b8e7919, https://si.imgix.net/30132cbd/uploads/origins/ba5ef09f-7f37-4177-aab6-8856aba49135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9d7b36c33694a8a00c839a4a9ad8e9b 2x, https://si.imgix.net/30132cbd/uploads/origins/ba5ef09f-7f37-4177-aab6-8856aba49135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac6efaa87f520e01200870d728d7758d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@toudori/works/180", "thumbnail_src": "https://si.imgix.net/0431cc05/uploads/origins/df2d78b1-a448-4293-8d1e-2860ce3367d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc29900b93cd7284efbcdb441ec378e", "thumbnail_srcset": "https://si.imgix.net/0431cc05/uploads/origins/df2d78b1-a448-4293-8d1e-2860ce3367d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc29900b93cd7284efbcdb441ec378e, https://si.imgix.net/0431cc05/uploads/origins/df2d78b1-a448-4293-8d1e-2860ce3367d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c642526be1b546200f97508c3faa0b24 2x, https://si.imgix.net/0431cc05/uploads/origins/df2d78b1-a448-4293-8d1e-2860ce3367d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a4415069a343564914cbf9556a2963e 3x", "genre": "art", "nsfw": true, "body": "前回QBのメナスをリクエストした者ですが、その節は大変素晴らしい\nイラストを描いていただきありがとうございました。\n二度目のリクエストとなりますが、ご一考いただければ幸いです。\n\nキャラ:Fate/Grand Orderよりブーディカ(第1再臨の姿)\n\nシチュ:ブーディカを前の「何故か」前屈みになるマスターの顔を\n　　　 「どうしたの？」といった表情で覗き込む場面。\n　　 　(ブーディカの目の前にマスターがいる、といった想定で\n　　　  マスター自体は描かなくて大丈夫です。)\n\nポーズ:正面向き構図での前傾姿勢\n　　　 (無自覚に胸を強調しているような状態でお願いします。)\n\n差分:可能であれば、\n　　 ・「何故」に気付いてニヤッとした表情\n　　 ・トップレス状態\n　　 の差分を希望します。\n　　(金額等々の諸々の理由で難しいと感じた場合は\n　　 無視していただいて問題ありません。)\n\n体型:全体的な体型や胸サイズは前回のメナスと同じくらいでお願いします。\n　　 加えて、長乳キャラというのは重々承知しているのですが可能であれば\n　　 丸みを帯びたタイプの胸の描き方にしていただけると有難いです。\n\nまたも要望が多くなり申し訳ありませんが、\n何卒ご検討のほど、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@toudori/works/179", "thumbnail_src": "https://si.imgix.net/df4693b8/uploads/origins/962ac7ca-79ca-4516-a27f-d368d8e3fdda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f0a585eaf87d779a6387795a10d707e", "thumbnail_srcset": "https://si.imgix.net/df4693b8/uploads/origins/962ac7ca-79ca-4516-a27f-d368d8e3fdda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f0a585eaf87d779a6387795a10d707e, https://si.imgix.net/df4693b8/uploads/origins/962ac7ca-79ca-4516-a27f-d368d8e3fdda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a44b71318f15952c5804271991602218 2x, https://si.imgix.net/df4693b8/uploads/origins/962ac7ca-79ca-4516-a27f-d368d8e3fdda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59091612dc246b2b8d75bc0c119728ab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@toudori/works/178", "thumbnail_src": "https://si.imgix.net/01de8c16/uploads/origins/06d936f3-2dd4-4e40-8210-45a2f32b6b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6c77bbe598b85b2a4ea0ffbe272b3c4", "