.net/30ee28c2/uploads/origins/b3caaf56-7523-4a2b-b21a-f5dd5eaed97d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a17ccea28a883646b28c002b6d96403", "thumbnail_srcset": "https://si.imgix.net/30ee28c2/uploads/origins/b3caaf56-7523-4a2b-b21a-f5dd5eaed97d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a17ccea28a883646b28c002b6d96403, https://si.imgix.net/30ee28c2/uploads/origins/b3caaf56-7523-4a2b-b21a-f5dd5eaed97d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d7bab55f68e177da7e7bd4273ea5836 2x, https://si.imgix.net/30ee28c2/uploads/origins/b3caaf56-7523-4a2b-b21a-f5dd5eaed97d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc12ea93aaa0cf429eb37d5b06d16faa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも素敵なイラストを拝見させて頂き元気を頂いています。\n今回リクエストさせて頂きたいのは、菅牧典です。\n何度か、けいき様が描いた典を拝見し、是非お願いしたいと思った次第です。\n構図としては、典を単体で耳打ちしているような感じだと嬉しいです。\nもし、より良い構図などがあればそちらを採用頂いても構いません。\n何卒よろしくお願いしますm(_ _)", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/21", "thumbnail_src": "https://si.imgix.net/f2b49fda/uploads/origins/153bb58a-7525-4060-ba64-842370887b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48ea89bf7582dc9cd4646660f3cde4dc", "thumbnail_srcset": "https://si.imgix.net/f2b49fda/uploads/origins/153bb58a-7525-4060-ba64-842370887b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48ea89bf7582dc9cd4646660f3cde4dc, https://si.imgix.net/f2b49fda/uploads/origins/153bb58a-7525-4060-ba64-842370887b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41c7fa7aaa7f29ba2ff7c557060717f7 2x, https://si.imgix.net/f2b49fda/uploads/origins/153bb58a-7525-4060-ba64-842370887b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c32799a28f6dca5aab8003b6b0e608d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品、特に本折小鈴の作品をもっと見たいです。\n\n彼女がメガネを調節しているところを見てみたいです。\nこれ（https://x.com/KEiki8296/status/1797545378402967633）と同じような構図で、彼女の表情に強く焦点を当てた素晴らしいものになるはずです。\n\n表情は、クールでもキュートでも何でもいい。何を描いても素晴らしいものになると確信しています！\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/20", "thumbnail_src": "https://si.imgix.net/f161d1bb/uploads/origins/b2fddd99-2e99-4b3f-bfbb-f493e05f5a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31069bc29854b30b5530a2c969e18a53", "thumbnail_srcset": "https://si.imgix.net/f161d1bb/uploads/origins/b2fddd99-2e99-4b3f-bfbb-f493e05f5a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31069bc29854b30b5530a2c969e18a53, https://si.imgix.net/f161d1bb/uploads/origins/b2fddd99-2e99-4b3f-bfbb-f493e05f5a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b1700911bef0362485f68302a82d27b 2x, https://si.imgix.net/f161d1bb/uploads/origins/b2fddd99-2e99-4b3f-bfbb-f493e05f5a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e995b7c80a5fc07aa3292ebcbae53a01 3x", "genre": "art", "nsfw": false, "body": "前回の霊夢と魔理沙のイラストと同じ構図でビキニ姿の本居小鈴と稗田阿求をお願いします。阿求はパレオを巻いてください。背景は涼しげで爽快な雰囲気の青色と白色が多めなシティポップのイラストみたいに描いてくださると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/19", "thumbnail_src": "https://si.imgix.net/5b7d09c8/uploads/origins/12f3e4dc-a146-4801-bd80-a22fdbcd2f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863854c0c5c4658f2db43bc70f1c5aaf", "thumbnail_srcset": "https://si.imgix.net/5b7d09c8/uploads/origins/12f3e4dc-a146-4801-bd80-a22fdbcd2f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863854c0c5c4658f2db43bc70f1c5aaf, https://si.imgix.net/5b7d09c8/uploads/origins/12f3e4dc-a146-4801-bd80-a22fdbcd2f63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc183268443d782115a685915f63b32b 2x, https://si.imgix.net/5b7d09c8/uploads/origins/12f3e4dc-a146-4801-bd80-a22fdbcd2f63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5fd38995d425fcc45cff63c2301c15 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの最近の天使の絵がとても好きです、\nなので、東方Projectの青蘭と林檎の絵をお願いしたいです。\n\n二人とも月防衛隊の制服を着て、武器を持って、かっこいいポーズをとってほしいです！\n星蘭は近接武器（ハンマーやパワーハンマーなど）を使い\n林檎は射撃武器を使う。\n\nポーズはお任せします。\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/18", "thumbnail_src": "https://si.imgix.net/a0349b4e/uploads/origins/ecd4a86e-b8e0-4c01-acfe-78593d227a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a3055953328ab66468b7c828e4a6fae", "thumbnail_srcset": "https://si.imgix.net/a0349b4e/uploads/origins/ecd4a86e-b8e0-4c01-acfe-78593d227a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a3055953328ab66468b7c828e4a6fae, https://si.imgix.net/a0349b4e/uploads/origins/ecd4a86e-b8e0-4c01-acfe-78593d227a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9d86a4bfdad19e63dda56b2a1de0c41 2x, https://si.imgix.net/a0349b4e/uploads/origins/ecd4a86e-b8e0-4c01-acfe-78593d227a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3b44899f82171314c407fb9210f5277 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/17", "thumbnail_src": "https://si.imgix.net/d7118dd3/uploads/origins/da199132-f68a-4da0-851d-845058ea36ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ef3596237cfa9b94edad06f9cfc12d", "thumbnail_srcset": "https://si.imgix.net/d7118dd3/uploads/origins/da199132-f68a-4da0-851d-845058ea36ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ef3596237cfa9b94edad06f9cfc12d, https://si.imgix.net/d7118dd3/uploads/origins/da199132-f68a-4da0-851d-845058ea36ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4f23ff1a3cf564a8f2359e1975c18bc 2x, https://si.imgix.net/d7118dd3/uploads/origins/da199132-f68a-4da0-851d-845058ea36ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a369192ae7b662f30473dbda339b4846 3x", "genre": "art", "nsfw": false, "body": "前回のSkebありがとうございます！\nhttps://x.com/KEiki8296/status/1770798310028152939\n\n私も同じようなお願いをしたいのですが、鈴奈庵アートスタイル 博麗 霊夢 の夏の絵を描いていただけませんか？\n\nもしよろしければ、赤いビキニ姿で描いていただけますか？ そうでなければ水着のデザインはお任せしますが、頭のリボンはそのままにしておいてください\n\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1ZsWpre8Ly0sOw004C2yXdRyXAJ3hQF_M?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/16", "thumbnail_src": "https://si.imgix.net/0a1cef1a/uploads/origins/ff047fde-a79e-447e-8913-f82ef0098e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a8966f3bf62c5a152fecde3bea19ebe", "thumbnail_srcset": "https://si.imgix.net/0a1cef1a/uploads/origins/ff047fde-a79e-447e-8913-f82ef0098e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a8966f3bf62c5a152fecde3bea19ebe, https://si.imgix.net/0a1cef1a/uploads/origins/ff047fde-a79e-447e-8913-f82ef0098e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36dc483e2c188f6090bf6c55246f52a1 2x, https://si.imgix.net/0a1cef1a/uploads/origins/ff047fde-a79e-447e-8913-f82ef0098e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c24f02d334eee676ee440f9670d7e431 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n世界はもっと鍵山雛を必要としています。\n東方projectのキャラクターで可愛い鍵山雛の作品を描いていただけませんか？\n ロングストッキングのお雛様希望です。\nありがとうございます", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/15", "thumbnail_src": "https://si.imgix.net/42f340a8/uploads/origins/f85a0ea9-52bb-4859-83b4-7f7ae454be28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e69f3ab7f3bbf8094aa530f170b5742", "thumbnail_srcset": "https://si.imgix.net/42f340a8/uploads/origins/f85a0ea9-52bb-4859-83b4-7f7ae454be28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e69f3ab7f3bbf8094aa530f170b5742, https://si.imgix.net/42f340a8/uploads/origins/f85a0ea9-52bb-4859-83b4-7f7ae454be28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faf7424fbf590579aeef293b77c2476e 2x, https://si.imgix.net/42f340a8/uploads/origins/f85a0ea9-52bb-4859-83b4-7f7ae454be28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e535dcafebc9cd8990eaec87000baea4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n鈴奈庵アートスタイルのレミリア・スカーレットを儚い月抄の水着で描いていただけませんか？ 両方をフォルダーに提供しました、\n可愛くてカリスマ性のあるポーズを希望しますが、ポーズはあなた次第です\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1AeF06tV82xJKnPcVeCCDGnX4S-9Ayfjx?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/14", "thumbnail_src": "https://si.imgix.net/fe844e46/uploads/origins/e79fa728-1738-4b29-a96f-a4ee127a8a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=078809bd90fd462ec13007bad12828b9", "thumbnail_srcset": "https://si.imgix.net/fe844e46/uploads/origins/e79fa728-1738-4b29-a96f-a4ee127a8a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=078809bd90fd462ec13007bad12828b9, https://si.imgix.net/fe844e46/uploads/origins/e79fa728-1738-4b29-a96f-a4ee127a8a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56c8c4a8df9b2957b7348ded97b35dc8 2x, https://si.imgix.net/fe844e46/uploads/origins/e79fa728-1738-4b29-a96f-a4ee127a8a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da00605a78ba6360b0049c6a288f2821 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます！！！\nアチチルノが銃を向け、背景の左側にナインボール、中央に鬼人正邪、右側に吉弔八千慧がいるイラストを依頼させていただきます！\n\n参考資料\nアチチルノ\nhttps://twitter.com/SatanNeutral/status/1748289292529803468?t=fl_HoeAnL1FuNEHSkQLo2w&s=19\n\nナインボール\nhttps://twitter.com/SatanNeutral/status/1697073858858332559?t=p8lIjN6bC1Ljur1zH5LwxA&s=19\n\n参考構図イラスト\nhttps://twitter.com/_SrPelo_/status/1535781020360126464?t=lkeWKBu_srOEIAjVDMJIHg&s=19\n\n銃を向けるポーズ\nhttps://twitter.com/AlcoholicDJ_/status/1747087396137480389?t=uqDQvEyt3vXaFrv0DAItTQ&s=19\n\nお忙しいとは思いますがどうかよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/13", "thumbnail_src": "https://si.imgix.net/ab5b4411/uploads/origins/b61ee636-a941-4841-98b1-b0f09637d86f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f046883d71c37baf92a568418fca5dfc", "thumbnail_srcset": "https://si.imgix.net/ab5b4411/uploads/origins/b61ee636-a941-4841-98b1-b0f09637d86f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f046883d71c37baf92a568418fca5dfc, https://si.imgix.net/ab5b4411/uploads/origins/b61ee636-a941-4841-98b1-b0f09637d86f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a095ca89b27907a822b380cc69a97eac 2x, https://si.imgix.net/ab5b4411/uploads/origins/b61ee636-a941-4841-98b1-b0f09637d86f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cd89f9c834ba7011c6711ac943d0c9d 3x", "genre": "art", "nsfw": false, "body": "お元気ですか？\n\n本居小鈴ちゃんを描いてくれませんか？ 可愛いポーズなら何でもいいからお任せします\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/12", "thumbnail_src": "https://si.imgix.net/fc8112af/uploads/origins/98b4b7c3-0f06-4c03-b91a-d5bb1a153f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1358eb5954e4514da3c47436ab14684d", "thumbnail_srcset": "https://si.imgix.net/fc8112af/uploads/origins/98b4b7c3-0f06-4c03-b91a-d5bb1a153f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1358eb5954e4514da3c47436ab14684d, https://si.imgix.net/fc8112af/uploads/origins/98b4b7c3-0f06-4c03-b91a-d5bb1a153f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=620d6e6c4b674f1e6d4c7104fd9d27a0 2x, https://si.imgix.net/fc8112af/uploads/origins/98b4b7c3-0f06-4c03-b91a-d5bb1a153f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bb2357adb9db6b82a07c518a4b847f5 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは、\n前回の仕事（鍵山雛）にはとても満足しています。細かいところまで本当に感謝しています。今回は茨木華扇というキャラクターを描いていただけませんか？ゲーム/WaHHと同じ服装で。\n背景：背景のデザインは前作からとても気に入っています。香仙のために、背景は似たようなもの、おそらく桜の木を使ったものになるかもしれません。画像に何か追加したいことがあれば、ご自由にどうぞ。\nポーズはこれに似ていても構いません。https://en.touhouwiki.net/wiki/File:Ibaraki_Whos_Who.png\nこの依頼を受け入れてくださったら、ありがとうございます。\n\nhttps://en.touhouwiki.net/wiki/Kasen_Ibaraki", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/11", "thumbnail_src": "https://si.imgix.net/7a4dca94/uploads/origins/49d93685-51ab-49d7-8328-0d3bebd84592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c481b81d4837a55d2b4367f57306da99", "thumbnail_srcset": "https://si.imgix.net/7a4dca94/uploads/origins/49d93685-51ab-49d7-8328-0d3bebd84592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c481b81d4837a55d2b4367f57306da99, https://si.imgix.net/7a4dca94/uploads/origins/49d93685-51ab-49d7-8328-0d3bebd84592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e297a98cefca888265ff49acf612eb8 2x, https://si.imgix.net/7a4dca94/uploads/origins/49d93685-51ab-49d7-8328-0d3bebd84592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bb9fb3beaf9c52950e66f8642470e77 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n本居 小鈴チャンの水着姿を描いていただけませんか？\nどんなかわいいポーズでも構いません、 帽子を必ず入れてください。\n\nありがとうございます。\n\nhttps://s1.zerochan.net/Motoori.Kosuzu.600.1917408.jpg", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/10", "thumbnail_src": "https://si.imgix.net/12e8a062/uploads/origins/8cd53f79-d1ef-4aa7-a6e0-0042459355a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e74908042e68a568a33319320f4b305", "thumbnail_srcset": "https://si.imgix.net/12e8a062/uploads/origins/8cd53f79-d1ef-4aa7-a6e0-0042459355a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e74908042e68a568a33319320f4b305, https://si.imgix.net/12e8a062/uploads/origins/8cd53f79-d1ef-4aa7-a6e0-0042459355a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cd67dcc1c90725353d5b88c6b27051b 2x, https://si.imgix.net/12e8a062/uploads/origins/8cd53f79-d1ef-4aa7-a6e0-0042459355a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65a8101e948c9afa3112405f0f3db396 3x", "genre": "art", "nsfw": false, "body": "けいき様の可愛い絵柄に一目惚れしました。\n吉弔八千慧ちゃんと驪駒早鬼ちゃんの2人の仲良しなイラストをリクエストさせて頂きたいです。(吉弔八千慧ちゃんの瞳の色は鬼形獣準拠で赤色希望です。)\n可能であればカワウソ霊とオオカミ霊もいると嬉しいです！\n返答及び納品は急ぎではありませんのでけいき様のご都合に合わせて頂ければと思います。上記の通りリクエストさせて頂きます。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/9", "thumbnail_src": "https://si.imgix.net/50917107/uploads/origins/aa521f8e-fcc7-474f-8abc-313eac1bdffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e92479feb4fdfec918fc41b02ff9615a", "thumbnail_srcset": "https://si.imgix.net/50917107/uploads/origins/aa521f8e-fcc7-474f-8abc-313eac1bdffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e92479feb4fdfec918fc41b02ff9615a, https://si.imgix.net/50917107/uploads/origins/aa521f8e-fcc7-474f-8abc-313eac1bdffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c36e2876f4365abbbf7c2d2ad0e11ecd 2x, https://si.imgix.net/50917107/uploads/origins/aa521f8e-fcc7-474f-8abc-313eac1bdffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d1207d5f10e1d833ff1dbbf3059d2a4 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n以前からあなたのアカウントを見ていて、絵が好きです。鍵山雛というキャラクターを描いていただけませんか？ゲームと同じ服装で。おそらくポーズもゲームオリジナルに近いと思います。\n背景：森の中の小道が似合うと思います。でも、背景はもっとシンプルで、草とか青空とかでもいいです。どの程度細かい背景を作りたいのかわかりませんが。ごめんなさい、あまりアイディアがなくて。ポーズでも背景でも、自由に描いてください。\n日本語は話せません、ごめんなさい。このリクエストを受け入れてくれたらありがとう。\n\nhttps://en.touhouwiki.net/wiki/Hina_Kagiyama", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/8", "thumbnail_src": "https://si.imgix.net/40e55e91/uploads/origins/a83d3ae8-5efc-45ec-b01c-1978249e271b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6fb330c84dd9aac2d0aebafb619f14", "thumbnail_srcset": "https://si.imgix.net/40e55e91/uploads/origins/a83d3ae8-5efc-45ec-b01c-1978249e271b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6fb330c84dd9aac2d0aebafb619f14, https://si.imgix.net/40e55e91/uploads/origins/a83d3ae8-5efc-45ec-b01c-1978249e271b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ac003136b86c5cf53320599e94d77e0 2x, https://si.imgix.net/40e55e91/uploads/origins/a83d3ae8-5efc-45ec-b01c-1978249e271b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d767382de43a130672b51f034f5dd11a 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです！急なお願いですが、宜しいでしょうか？来年の干支の兎に関して、東方の兎キャラでの集合をお願い出来ますでしょうか？全員がバニーガール衣装（レオタード&ハイヒール）なのですが、うどんげが黒の網タイツ、てゐは薄いピンクのタイツ、鈴瑚は白タイツです（ヘソだしレオタードなので若干おヘソに白タイツが被ってます）。清蘭は薄い青いタイツ。レイセンは黒タイツです。各々のレオタードの色やデザインはけいき様にお任せ致します。新年を祝うフリップ（立て看板）を持った可愛い兎さん達を是非ともお願いします…", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/7", "thumbnail_src": "https://si.imgix.net/891ace8f/uploads/origins/414ba1f4-fd9b-48e6-a6cb-e28055c68e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=544ef8c1187fbcd1b05a573b7a9902b3", "thumbnail_srcset": "https://si.imgix.net/891ace8f/uploads/origins/414ba1f4-fd9b-48e6-a6cb-e28055c68e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=544ef8c1187fbcd1b05a573b7a9902b3, https://si.imgix.net/891ace8f/uploads/origins/414ba1f4-fd9b-48e6-a6cb-e28055c68e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=747106a2d4d899973be99d1f6e541639 2x, https://si.imgix.net/891ace8f/uploads/origins/414ba1f4-fd9b-48e6-a6cb-e28055c68e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb96e0bc5c2cc5480340da03312af134 3x", "genre": "art", "nsfw": false, "body": "こんにちは、もうひとつリクエストさせていただきます。\n依神紫苑と秦こころ、古明地さとりをクリスマス仕様でお願いしたいです。3人ともサンタコスのような服（露出はあまり高くなく下はスカート、こころにはサンタ帽をかぶせて欲しい）で可能であればクリスマスツリーやプレゼント箱などもあると嬉しいです。\n何卒よろしくお願いしますm(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/6", "thumbnail_src": "https://si.imgix.net/fdc6ac61/uploads/origins/35293cd5-99cc-421c-90ca-30cdbea2d9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eecc19232d981907141215ce477422f", "thumbnail_srcset": "https://si.imgix.net/fdc6ac61/uploads/origins/35293cd5-99cc-421c-90ca-30cdbea2d9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eecc19232d981907141215ce477422f, https://si.imgix.net/fdc6ac61/uploads/origins/35293cd5-99cc-421c-90ca-30cdbea2d9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac2010724d4fcf00db1999d82e8fd98c 2x, https://si.imgix.net/fdc6ac61/uploads/origins/35293cd5-99cc-421c-90ca-30cdbea2d9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0472184eab9c046a0b128e3faa3b42b7 3x", "genre": "art", "nsfw": false, "body": "文章が言葉足らずだったのでキャンセルし再度リクエストさせていただきます。すみませんm(_ _)m\nこんにちは、けいき先生の画風が大好きで依頼させていただきました。\n依神紫苑をお願いしたいです。可能でしたら紫苑1人で紫苑がぬいぐるみ（紫苑が所持している黒い猫のぬいぐるみ）を持っているような構図でお願いしたいです。何卒よろしくお願いしますm(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/5", "thumbnail_src": "https://si.imgix.net/2d93758d/uploads/origins/b560cf70-efc4-475c-8e53-25a34747bdec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0a2c31321b2c5084305b36f8ef0308", "thumbnail_srcset": "https://si.imgix.net/2d93758d/uploads/origins/b560cf70-efc4-475c-8e53-25a34747bdec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0a2c31321b2c5084305b36f8ef0308, https://si.imgix.net/2d93758d/uploads/origins/b560cf70-efc4-475c-8e53-25a34747bdec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=926efa79f863303117ba999b5f568397 2x, https://si.imgix.net/2d93758d/uploads/origins/b560cf70-efc4-475c-8e53-25a34747bdec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2e1a928abc75472f20bf543182f39ab 3x", "genre": "art", "nsfw": false, "body": "初めまして！けいき様のイラストをいつも拝見させて頂いています！依頼をお願いしたいのですが、宜しいでしょうか？白タイツを穿いた王子様衣装のリグル・ナイトバグちゃんがレイピアを持って、蝶のように舞い蜂のように刺す感じのカッコ可愛いイラストをお願いします！衣装に関してですが、王子様衣装の下履きは半ズボン、キュロット、カボチャ等、けいき様が選んでくださって構いませんので、その中からでけいき様の好みで王子様衣装を作って頂けますでしょうか？上半身部分の衣服はけいき様の思った感じで描いて頂いても構いません。（原作風でも、アレンジでも）靴は原作基準でストラップシューズ系だと嬉しいです。この内容で良ければ是非とも宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/4", "thumbnail_src": "https://si.imgix.net/ad104f7c/uploads/origins/1807c214-ea86-4edb-b140-1319f043875d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9217af777d552f3b6d46e4381d00d3a8", "thumbnail_srcset": "https://si.imgix.net/ad104f7c/uploads/origins/1807c214-ea86-4edb-b140-1319f043875d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9217af777d552f3b6d46e4381d00d3a8, https://si.imgix.net/ad104f7c/uploads/origins/1807c214-ea86-4edb-b140-1319f043875d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26ec2f734477d2d37a18b4002125885f 2x, https://si.imgix.net/ad104f7c/uploads/origins/1807c214-ea86-4edb-b140-1319f043875d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88fc7f12a74df1e90da6ce835ed0070f 3x", "genre": "art", "nsfw": false, "body": "(東方) ウサギをなでる蓬莱山輝夜を描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@KEiki8296/works/3", "thumbnail_src": "https://si.imgix.net/15dcc940/uploads/origins/b6c6170a-7484-4096-8e62-4b6cdedd3238?bg=%23fff&auto=format%2Cc