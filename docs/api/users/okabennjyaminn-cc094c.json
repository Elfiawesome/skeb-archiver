2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30e5a6cfce486d60e390daa45435add3 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のFFXIVのキャラクターを描いていただけませんか？\n\n彼女は耳の代わりに角を持っています。  角、頬、首、尻尾にダークブルーの竜の鱗があります。\n\n燃え盛る戦場で斧を持った彼女を描いてください。  斧を振り回しているところや、肩に乗せて勝利のポーズをとっているところなど。\n\n宜しくお願いします。\n\nhttps://imgur.com/a/hoVz08U", "created_at": "", "completed_at": ""}, {"path": "/@okabennjyaminn/works/4", "thumbnail_src": "https://si.imgix.net/a6f0cae8/uploads/origins/12e2fd20-7c77-4066-8f90-135f758b8a15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=598d16272face5ca56a71b41ca365102", "thumbnail_srcset": "https://si.imgix.net/a6f0cae8/uploads/origins/12e2fd20-7c77-4066-8f90-135f758b8a15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=598d16272face5ca56a71b41ca365102, https://si.imgix.net/a6f0cae8/uploads/origins/12e2fd20-7c77-4066-8f90-135f758b8a15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c4e17ce8eb3cd410a4349ee0aabbd29 2x, https://si.imgix.net/a6f0cae8/uploads/origins/12e2fd20-7c77-4066-8f90-135f758b8a15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fab5bf96a2284df540ab5cf804a7836 3x", "genre": "art", "nsfw": false, "body": "アウトフィット： https://imgur.com/a/Nm9etvr\n設定： https://imgur.com/a/DwRklC3\n\nXaviaは \"Inner Beast \"という能力を使っています。怒りに満ちた時にのみ、この状態になることができる。目が赤く光り、力とスピードが10倍になります。斧を持って復讐に燃える彼女。ポーズはあなた次第です。", "created_at": "", "completed_at": ""}, {"path": "/@okabennjyaminn/works/3", "thumbnail_src": "https://si.imgix.net/cf1a34d2/uploads/origins/00bd9a41-228a-454b-a3e2-c6e3b61e7bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb6d451eb9989ce5add9f870f9d09a65", "thumbnail_srcset": "https://si.imgix.net/cf1a34d2/uploads/origins/00bd9a41-228a-454b-a3e2-c6e3b61e7bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb6d451eb9989ce5add9f870f9d09a65, https://si.imgix.net/cf1a34d2/uploads/origins/00bd9a41-228a-454b-a3e2-c6e3b61e7bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ccd4e09d66ee54eb488b29482a36258 2x, https://si.imgix.net/cf1a34d2/uploads/origins/00bd9a41-228a-454b-a3e2-c6e3b61e7bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=061be14c6f01aa77fd1a52f142a16aa9 3x", "genre": "art", "nsfw": false, "body": "前回は凛々しいうちの子を描いて頂きありがとうございました\n今回クリエイター様に擬人化した女性型ドラゴンを描いて頂きたくご依頼させて貰います\n\nドラゴンのイメージは他の地から流れ着いた西洋竜で巣穴の土地の主人（領主や王様等）以外とは対等に意思疎通を行うことはない黒く美しい暴竜\n擬人化に対しての要望としましては\n・外見の年齢は30歳くらい\n・背丈が高めで濡羽色の髪に顔の造形は人だけど瞳孔や舌は爬虫類\n　人の形をしているが肘やスネより先が鱗に覆われ、脚が竜のような逆間接\n・世界観は前回のうちの子っぽい雰囲気でお願いします\n・その他は全てクリエイター様におまかせします\n\n是非ともご考慮頂きたく存じます", "created_at": "", "completed_at": ""}, {"path": "/@okabennjyaminn/works/2", "thumbnail_src": "https://si.imgix.net/c46f05c6/requests/226754_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3733c356506eabc98dc5e675713a76e5", "thumbnail_srcset": "https://si.imgix.net/c46f05c6/requests/226754_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3733c356506eabc98dc5e675713a76e5, https://si.imgix.net/c46f05c6/requests/226754_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec2dfcd575aa83b144ecb3215228f9c2 2x, https://si.imgix.net/c46f05c6/requests/226754_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d11c931fc912f059e489da9f415d71eb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@okabennjyaminn/works/1", "thumbnail_src": "https://si.imgix.net/40b70ce8/requests/220022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f901acf09e37785e11998937700e4d2c", "thumbnail_srcset": "https://si.imgix.net/40b70ce8/requests/220022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f901acf09e37785e11998937700e4d2c, https://si.imgix.net/40b70ce8/requests/220022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50f8f43533624dfefb51e0219f154aac 2x, https://si.imgix.net/40b70ce8/requests/220022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f5c463281a9f783c136175eb4ecc5e6 3x", "genre": "art", "nsfw": false, "body": "はじめまして！RTで拝見してシリアスなうちの子を描いていただきたくリクエストを送りました。\nキャラクタの外見に関しては資料URLをご覧ください。\n\n・イメージは君主（以下にゃんこ）専属軍師的な女官で、にゃんこに対して甘々で過保護なクールビューティ\n・シチュエーションとしては戦火の中、凛々しく陣頭に立って指図をするような感じで\n・構図等は全てお任せしますが、にゃんこを寄り添わせて頂けると嬉しいです\n・iPadminiでの使用及び他クリエイターへの依頼の際の作例として使用する為、画像アスペクト比3:4（1536×2048以上）\n以上になります。 \n是非ともご考慮頂きたく存じます。\n\nhttps://f.easyuploader.app/eu-prd/upload/20201212132707_314e4d796e455935387a.jpeg", "created_at": "", "completed_at": ""}]}