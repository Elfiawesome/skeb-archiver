ーバーサイズ。\n\nVtuber ref : https://drive.google.com/drive/folders/1poSraUedyg2YUibGOBY1H7k2UmFSz4B8?usp=drive_link\n\nチーズを食べる私を描いてくれませんか？\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@DeFicientRAbbit/works/251", "thumbnail_src": "https://si.imgix.net/09e5559d/uploads/origins/d87cbb2f-48c9-499e-b315-4f00c9a64511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d6589b5aba2f5602017b25b9ac2d342", "thumbnail_srcset": "https://si.imgix.net/09e5559d/uploads/origins/d87cbb2f-48c9-499e-b315-4f00c9a64511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d6589b5aba2f5602017b25b9ac2d342, https://si.imgix.net/09e5559d/uploads/origins/d87cbb2f-48c9-499e-b315-4f00c9a64511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7caf5c67fbeebe94956f2d6fcf8f3949 2x, https://si.imgix.net/09e5559d/uploads/origins/d87cbb2f-48c9-499e-b315-4f00c9a64511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d8bf9fe376110cde22c7ccc745639d8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DeFicientRAbbit/works/250", "thumbnail_src": "https://si.imgix.net/5a9a686a/uploads/origins/59f5e6d9-0e13-46d2-8780-1e84f031d3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2bd3cf8b12df0092947335989cf98f8", "thumbnail_srcset": "https://si.imgix.net/5a9a686a/uploads/origins/59f5e6d9-0e13-46d2-8780-1e84f031d3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2bd3cf8b12df0092947335989cf98f8, https://si.imgix.net/5a9a686a/upload