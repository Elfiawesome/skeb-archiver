88-bc4e-e60b805fbf07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19393130c5c97286b961eb2219e3c7b1", "thumbnail_srcset": "https://si.imgix.net/e1150094/uploads/origins/740cefa0-1eb3-4c88-bc4e-e60b805fbf07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19393130c5c97286b961eb2219e3c7b1, https://si.imgix.net/e1150094/uploads/origins/740cefa0-1eb3-4c88-bc4e-e60b805fbf07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbe6cc9a6c8525c60d7745e0fee49497 2x, https://si.imgix.net/e1150094/uploads/origins/740cefa0-1eb3-4c88-bc4e-e60b805fbf07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbdc9a42ec4923fa899253dcbb7340ed 3x", "genre": "art", "nsfw": true, "body": "箱 庭師さん、こんにちは！ \n今回はうちの代理ちゃんと美兎(みう)ちゃんのエッチな絡みを描いていただきたいです♪\n\n★描いてほしいキャラ:代理ちゃん(ミズチ)、美兎(みう)ちゃん\n★表情:表情はお任せしますが、淫らな感じだと嬉しいです///\n★ポーズ,背景:背景は海岸の岩陰で、ポーズは美兎ちゃんが座っていてその上に代理ちゃんが乗っかっている感じでお願いします♡\n★衣装,状態:代理ちゃんがスク水(紺色)できればボテ腹で、美兎ちゃんは全裸でお願いします♡\n★シチュ:座っているふたなりの美兎ちゃんの上に代理ちゃんが乗っかっていて、片方のおっぱいは美兎ちゃんがスク水の間に手を入れて乳首を弄ってる感じで、もう片方のおっぱいは乳輪と乳首がスク水に浮き出て形がわかる感じだと嬉しいです♪\nスク水の股間部分をずらしてふたなりのモノを代理ちゃんのアソコにいれて中出しして外に溢れてる感じでお願いします♡\n\nよろしければよろしくお願いします♪\n\n★代理ちゃん参考資料\nhttps://twitter.com/mizuti_kemo/status/1248878136550232065?s=21\n★美兎ちゃん参考資料\nhttps://twitter.com/mizuti_kemo/status/1407642891804045313?s=21", "created_at": "", "completed_at": ""}, {"path": "/@85_2wa/works/15", "thumbnail_src": "https://si.imgix.net/5eb43860/uploads/origins/faebbf85-3ea4-420a-8d30-397ecdda4a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abc689d8f86a5066af883194f44b5496", "thumbnail_srcset": "https://si.imgix.net/5eb43860/uploads/origins/faebbf85-3ea4-420a-8d30-397ecdda4a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abc689d8f86a5066af883194f44b5496, https://si.imgix.net/5eb43860/uploads/origins/faebbf85-3ea4-420a-8d30-397ecdda4a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf658d1161fab5f00a05a937fdd92d7d 2x, https://si.imgix.net/5eb43860/uploads/origins/faebbf85-3ea4-420a-8d30-397ecdda4a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfb781ae5c4e25361c151f0822ed51e2 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n蹲踞ポーズのエンブオーがベトベトンに犯されている絵をお願いします。\nベトベトンは口とお尻からエンブオーを犯しつつお腹に手を当てて、満足げな笑みを浮かべてる感じで。\nエンブオーはアへ顔気味で、巨根から大量に射精してる描写が欲しいです。白目の部分は浸食されてる感が出るように紫色にしてください。\n（エンブオーはなるべく太ましくしてくださると助かります。）\n\n畑違いかもしれませんが可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@85_2wa/works/14", "thumbnail_src": "https://si.imgix.net/dce60ff1/uploads/origins/bc3cbb32-2eef-4927-b7d8-fe57850ca2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5c3cc26d3a8eed14c0426b4a1119bc4", "thumbnail_srcset": "https://si.imgix.net/dce60ff1/uploads/origins/bc3cbb32-2eef-4927-b7d8-fe57850ca2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5c3cc26d3a8eed14c0426b4a1119bc4, https://si.imgix.net/dce60ff1/uploads/origins/bc3cbb32-2eef-4927-b7d8-fe57850ca2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=600c9e77c7b6e02c9135e1f0819ec9a3 2x, https://si.imgix.net/dce60ff1/uploads/origins/bc3cbb32-2eef-4927-b7d8-fe57850ca2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52782bc0e9620f44e3ce86c109022072 3x", "genre": "art", "nsfw": true, "body": "前回は素敵なイラストをありがとうございました\nまた可能でしたら以下のシチュエーションでお願い出来ますでしょうか？\n\n１、アミンゴ(marvel vs capcom 2のキャラクター)がガオガエンを植物の掟と言う技で丸呑みしてしまう。\n\n２、アミンゴの体内でガオガエンはモノに触手をあてがわれてしまい、マラカスを振りながら踊られると踊りの衝撃でモノにあてがわれた触手が激しく擦れてしまってガオガエンはあっという間に絶頂してしまい大量に射精してしまう\n\nガオガエンは触手で手足を拘束されて抵抗や身動きが出来ない感じでお願いします\n(もし、可能であれば)\n\nアミンゴの姿と植物の掟と言う技の詳細はリンク先を参考にお願いします\n\nhttps://voreinmedia.wordpress.com/2021/02/12/marvel-vs-capcom-2-new-age-of-heroes-arc-ios-ps2-ps3-sdc-xb-xb360-amingo-various/", "created_at": "", "completed_at": ""}, {"path": "/@85_2wa/works/13", "thumbnail_src": "https://si.imgix.net/fb