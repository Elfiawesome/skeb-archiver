6-496d-af7b-e6e8853adce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1747e20a8ee09563a988e0e64d094819, https://si.imgix.net/a7c7492f/uploads/origins/0421da2f-bde6-496d-af7b-e6e8853adce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52e7e699c504a5f3122441afb742d931 2x, https://si.imgix.net/a7c7492f/uploads/origins/0421da2f-bde6-496d-af7b-e6e8853adce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b07f64f947e7e932e6893124b0a0266f 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nペルソナ5風のイラストがとても素敵だったのでリクエストさせていただきました。\nFFXIVで使用しているマイキャラクター(とミニオン)のイラストをお願いします！\n\nペルソナ５の総攻撃フィニッシュ風で、できればロッドに魚がかかり引き上げようとしているポーズだと嬉しいですが構図などは自由に変更していただいてOKです！\n\nSNSのプロフィールやアイコンなどに使用予定です。\nよろしくお願いします！\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1SETF1CYmeDidQq43o_7Am99ppUWSY4zE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@motoki_rin/works/5", "thumbnail_src": "https://si.imgix.net/bd9d319b/uploads/origins/9a21b414-a55b-4fe7-a21a-2fabd5177985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f2df0a01bac92c04e4fdee99d889b9e", "thumbnail_srcset": "https://si.imgix.net/bd9d319b/uploads/origins/9a21b414-a55b-4fe7-a21a-2fabd5177985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f2df0a01bac92c04e4fdee99d889b9e, https://si.imgix.net/bd9d319b/uploads/origins/9a21b414-a55b-4fe7-a21a-2fabd5177985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f57f87d7fbdc0b62305aa11d5210e45e 2x, https://si.imgix.net/bd9d319b/uploads/origins/9a21b414-a55b-4fe7-a21a-2fabd5177985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=760f9216cc68f71f28cb3c3cf2da1732 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートは素晴らしいですね\n\n私のVTuberである桃華をペルソナ5の総攻撃のようなスタイルで描いていただけたらと思います。\n\n彼女はとてもドジなバニーガールで、どこかお茶目なところがあります。テーマは魔法使いのうさぎです。\n\nTwitchやSNSで使用したいのですが、よろしいでしょうか？\n\nhttps://imgur.com/a/ICWMkBs", "created_at": "", "completed_at": ""}, {"path": "/@motoki_rin/works/4", "thumbnail_src": "https://si.imgix.net/9dcdb99f/uploads/origins/02c3ce95-0aef-43d9-b37b-ed727ab706b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68349789b85887d6b764d7067576c02a", "thumbnail_srcset": "https://si.imgix.net/9dcdb99f/uploads/origins/02c3ce95-0aef-43d9-b37b-ed727ab706b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68349789b85887d6b764d7067576c02a, https://si.imgix.net/9dcdb99f/uploads/origins/02c3ce95-0aef-43d9-b37b-ed727ab706b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d5eb291bd1a51953467eb72107e61a 2x, https://si.imgix.net/9dcdb99f/uploads/origins/02c3ce95-0aef-43d9-b37b-ed727ab706b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f9bcc5e6f54f86398bcf5b47ffffb22 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのスタイルがとても好きで、ペルソナ5をよく思い出します。私のVTuberのOCであるZenが、あなたの他のアートのように、All-Out Attackを終えた後にポーズをとっているようなアートを作っていただけないでしょうか。Zenは訓練された剣士であり武道家です。普段は穏やかで優しい人ですが、心の奥底では戦うことや強い相手に挑むことが好きで、常により大きな挑戦を求め、自分の限界を試して強くなることに不健康なほど執着しています。\n\nまた、彼のモチーフは、氷と木の葉、桜の花であり、日本の伝統的な美学を愛しています。また、料理も好きですが、それはここで付け加える必要はありません。\n\n武器はカタナを使用しており、武術の修行をしています。カタナのデザインとポーズはあなた次第ですが、もし参考になるものがあれば、下に提案を掲載します。ご検討ありがとうございました。先生のスタイルで描かれたZenに会えることを願っています。\n\nキャラクターの参考資料\nhttps://sta.sh/0fj9rahbz82\n\nポーズ提案のためのサンプルリファレンス。\nhttps://static.wikia.nocookie.net/kiseki/images/c/cf/Rean_Schwarzer_%28Browndust_Collaboration%29.png/revision/latest?cb=20210311121915\n\nhttps://static.wikia.nocookie.net/kiseki/images/b/b7/Rean_Schwarzer_-_S-Craft_Berserk_Tattered_%28Sen_IV%29.png/revision/latest?cb=20200718064037\n\nhttps://sta.sh/01qsgs4y2x52", "created_at": "", "completed_at": ""}, {"path": "/@motoki_rin/works/3", "thumbnail_src": "https://si.imgix.net/0fbf6cc2/uploads/origins/551b9943-13c2-4fa8-9c13-db14176f7650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42bbb2ea731ce667fb8062f84e98953", "thumbnail_srcset": "https://si.imgix.net/0fbf6cc2/uploads/origins/551b9943-13c2-4fa8-9c13-db14176f7650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42bbb2ea731ce667fb8062f84e98953, https://si.imgix.net/0fbf6cc2/uploads/origins/551b9943-13c2-4fa8-9c13-db14176f7650?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1012fc34031ee26f23f22eca805230fd 2x, https://si.imgix.net/0fbf6cc2/uploads/origins/551b9943-13c2-4fa8-9c13-db14176f7650?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c6178878d37bb3c4060c91b2a539187 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\n私はあなたのアートスタイルが大好きで、私のvtuberキャラクターにリクエストしたいと思います。\n\nこの男は私のVTuberキャラクターのユキです。身長は176cmです。楽しそうに見えますが、心の中ではとても悲しんでいます。また、ペットのアザラシが王様になっています。\n\nペルソナ5をテーマにしたイラストをお願いしたいです。画面に「It's Showtime」と書かれた、総攻撃のイラストをお願いします。私のペットのアザラシをイラストの中に入れてください。\n\n先生の私たちのイラストを見てみたいですね。\n\nライブ配信やYouTubeの動画に使用します。私のTwitchチャンネルのスタート画面に使用します。)\n\nよろしくお願いします！（笑\n\nhttps://imgur.com/a/0EWGS17", "created_at": "", "completed_at": ""}, {"path": "/@motoki_rin/works/2", "thumbnail_src": "https://si.imgix.net/7747db34/uploads/origins/52347022-cb3e-4ba9-b7c9-e0b05c82e45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6abb9948d2f6c08bd9cd47d8245c665", "thumbnail_srcset": "https://si.imgix.net/7747db34/uploads/origins/52347022-cb3e-4ba9-b7c9-e0b05c82e45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6abb9948d2f6c08bd9cd47d8245c665, https://si.imgix.net/7747db34/uploads/origins/52347022-cb3e-4ba9-b7c9-e0b05c82e45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35751e82650ede2aaa49c4bcd7722e59 2x, https://si.imgix.net/7747db34/uploads/origins/52347022-cb3e-4ba9-b7c9-e0b05c82e45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93e6410b582ce6ad086ec42befb4c0b7 3x", "genre": "art", "nsfw": false, "body": "初めまして、Twitterのほうでスタイリッシュなペルソナのイラストを拝見して、ぜひお願いしたく、リクエストをお送りさせていただきました！\nぜひ自作キャラのイラストを描いていただければ、幸いです。\n\n参考画像は最後にＵＲＬを記載しております。\n\n\n【キャラ設定】\n青年\n・青年、18歳、176センチ55キロ\n・昼は映画好きの法学部一年生であり、弁護士事務所でアルバイトをしている\n・夜は義賊として、悪党の屋敷から金を盗み、恵まれない施設に寄付をしている\n\n【シチュエーション】\nナイフと素手で攻撃するキャラクターです\nこのキャラクターによる、ペルソナ５の総攻撃フィニッシュ風のイラストを、自由に描いていただければ、と！\n\nどうぞよろしくお願いいたします！\n\n\n【参考画像】\nhttps://drive.google.com/file/d/1aRckA03-ASSlnwN8K6hkotONSYZNWYuU/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@motoki_rin/works/1", "thumbnail_src": "https://si.imgix.net/76c5e631/uploads/origins/c56e5e24-f7ee-413c-9540-700f2f647f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e65bd2cfc7bb11c4da17bf5080369e4", "thumbnail_srcset": "https://si.imgix.net/76c5e631/uploads/origins/c56e5e24-f7ee-413c-9540-700f2f647f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e65bd2cfc7bb11c4da17bf5080369e4, https://si.imgix.net/76c5e631/uploads/origins/c56e5e24-f7ee-413c-9540-700f2f647f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f41f1d0b2fd326f378d2700951a5aa9 2x, https://si.imgix.net/76c5e631/uploads/origins/c56e5e24-f7ee-413c-9540-700f2f647f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d0db305dc148cd100b8d0575d3f8280 3x", "genre": "art", "nsfw": false, "body": "twitterにてペルソナの格好いいイラストを拝見し、リクエストさせていただきました。\nVRCHATというVRでのゲームで用いている、myアバターのイラストをお願いしたくご依頼させていただきました。ミニスカート・ノースリーブに改変し、使用しております。イメージとしては、某美少女怪盗のような雰囲気のほんわかした子です。\n\nリクエストイメージは、P5の総攻撃後に表示される一枚絵っぽいイラストとなります。\n詳細はおまかせいたしますが、可能であれば白衣を纏った化学系のイメージであれば幸いです。\n参考：https://drive.google.com/file/d/1pi-tZUvndrDbcHOvWLTyfH0d6V4aW4UO/view?usp=sharing\n\n以上、ご検討のほどよろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1M0WIXCVF8Ff1eAp5GQc_o4rIoH7kre55/view?usp=sharing", "created_at": "", "completed_at": ""}]}