92f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a28bcfa52423610e69e28bdad45b3f4c", "thumbnail_srcset": "https://si.imgix.net/94d413a7/uploads/origins/7221ab0c-2cc7-4c97-863d-5e9d8d392f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a28bcfa52423610e69e28bdad45b3f4c, https://si.imgix.net/94d413a7/uploads/origins/7221ab0c-2cc7-4c97-863d-5e9d8d392f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=886310f854cc5f041561b59a14a58d38 2x, https://si.imgix.net/94d413a7/uploads/origins/7221ab0c-2cc7-4c97-863d-5e9d8d392f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93395127d63ec5c8b976705f9bbc20ab 3x", "genre": "art", "nsfw": false, "body": "このドラゴンの女の子を描いてください。  彼女は敵対する王国に捕らえられた王女だった。  ライバル王国は彼女に同情し、インターネットへのアクセスを与えた。  彼女は今、社会的に注目されるためにストリーミングをしている。  彼女の性格はとてもプライドが高いですが、賞賛やプレゼントも欲しがります。  ジュエリーの手入れをしたり、自分のために鏡でモデルをしたり、ゲームをしてリラックスするのが好き。  好きなように描いてください。\n\nhttps://drive.google.com/drive/folders/1ND63zo_Oqt1zwJBqTpoKa_QMovJRw97d?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hatomune666/works/28", "thumbnail_src": "https://si.imgix.net/ead3b170/uploads/origins/e53904e1-5362-4515-b6e5-ee050e4d51e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fed98694b1ace3174342a8b3d942556", "thumbnail_srcset": "https://si.imgix.net/ead3b170/uploads/origins/e53904e1-5362-4515-b6e5-ee050e4d51e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fed98694b1ace3174342a8b3d942556, https://si.imgix.net/ead3b170/uploads/origins/e53904e1-5362-4515-b6e5-ee050e4d51e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de09fe380fc8a3d48109da9b58899097 2x, https://si.imgix.net/ead3b170/uploads/origins/e53904e1-5362-4515-b6e5-ee050e4d51e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0957c710d0e7b59b68471d80b1b908cb 3x", "genre": "art", "nsfw": false, "body": 