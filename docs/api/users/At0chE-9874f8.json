曜日のお昼12時に、いつも定期で 元気で可愛いをモットーとした歌枠を行っているのですが、\n\n・可愛い\n・明るい\n・楽しい　\n\nこの3点のどれかをメインとして、\n”歌枠”のモチーフロゴを作って頂いても宜しいでしょうか？\nその他全てお任せ致します。何卒、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@At0chE/works/19", "thumbnail_src": "https://si.imgix.net/8b645439/uploads/origins/4fc8e29b-7210-4a59-86ec-0748f663ddab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b3af6b972d5aac06c6ba19ffcdc0567", "thumbnail_srcset": "https://si.imgix.net/8b645439/uploads/origins/4fc8e29b-7210-4a59-86ec-0748f663ddab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b3af6b972d5aac06c6ba19ffcdc0567, https://si.imgix.net/8b645439/uploads/origins/4fc8e29b-7210-4a59-86ec-0748f663ddab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd3c5083730746cf402374a8e1933683 2x, https://si.imgix.net/8b645439/uploads/origins/4fc8e29b-7210-4a59-86ec-0748f663ddab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6e014c0c8632f473c0576d77ab72c0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@At0chE/works/18", "thumbnail_src": "https://si.imgix.net/7a405d66/uploads/origins/ec352cd1-a8b8-4735-992c-99da3d6ae36d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a35f72eb43d9608bb99906c1480f77f7", "thumbnail_srcset": "https://si.imgix.net/7a405d66/uploads/origins/ec352cd1-a8b8-4735-992c-99da3d6ae36d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a35f72eb43d9608bb99906c1480f77f7, https://si.imgix.net/7a405d66/uploads/origins/ec352cd1-a8b8-4