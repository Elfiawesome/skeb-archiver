、金髪と青と白のリボンが風になびいていた。\nhttps://commons.m.wikimedia.org/wiki/File:T-34-85_nva.svg\n東ドイツの戦車には通常このエンブレムが付いていますが、この絵ではこの戦車のエンブレムに✖️❌を落書きしたかったのです。\n\nhttps://skeb.jp/@2tr20530/works/4\n絵の背景をヨーロッパの町の通りにしたかったのですが、その通りには抗議活動で人々が積み上げた石や鉄筋が交差して積み上げられていました。\n\nあなたの署名と私の名前が入った差分があればいいのにと思います。\n\n以上です、ありがとうございます！\n\nhttps://imgur.com/a/CtedVR7", "created_at": "", "completed_at": ""}, {"path": "/@drops_mint/works/12", "thumbnail_src": "https://si.imgix.net/dc5f6804/uploads/origins/25c19433-dba9-402f-908e-9b0f92b872b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf410cc3605572f81082c92c10095dd0", "thumbnail_srcset": "https://si.imgix.net/dc5f6804/uploads/origins/25c19433-dba9-402f-908e-9b0f92b872b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf410cc3605572f81082c92c10095dd0, https://si.imgix.net/dc5f6804/uploads/origins/25c19433-dba9-402f-908e-9b0f92b872b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0fe42b6a701b9d7315aa9074ee9e98e 2x, https://si.imgix.net/dc5f6804/uploads/origins/25c19433-dba9-402f-908e-9b0f92b872b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3170790dfd88f4fe7c131b4a49365333 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@drops_mint/works/11", "thumbnail_src": "https://si.imgix.net/d754d5b6/uploads/origins/368ca799-2fb9-476b-9e7e-662f999adb48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a71a660f2f67d32c5b6ba76b59eb952f", "thumbnail_srcset": "https://si.imgix.net/d754d5b6/uploads/origins/368ca799-