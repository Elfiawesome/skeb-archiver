96-b0eb-954d2e1af644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=630693cf3047bdd7f4a21abcbe7c972f 3x", "genre": "art", "nsfw": true, "body": "久しぶりに腋臭眼鏡委員長ちゃんでリクエストお願いします。\n\n委員長ちゃんが上着を脱いで腋が露出するイラストが見たいです。以下はそのシチュエーションです。\n\nおそらく冬。彼氏くんの部屋にお邪魔した委員長が上着を脱ぐ。予想以上に道中が暖かく暑いくらいだったため汗ばむほどだった。下に着ていたのはノースリーブの服。腋汗が横腹の辺りまで滲んでいる。解放されたむき出しの腋から放たれる臭いが部屋に充満する。委員長ちゃんは汗を気にしてない。\n\nhttps://skeb.jp/@Zakotsu_XYH/works/119", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/127", "thumbnail_src": "https://si.imgix.net/5ad7db4a/uploads/origins/00e06970-5b86-4a4f-a333-49c62c75692f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c1d4ca406c118a62a58293235fde2c", "thumbnail_srcset": "https://si.imgix.net/5ad7db4a/uploads/origins/00e06970-5b86-4a4f-a333-49c62c75692f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c1d4ca406c118a62a58293235fde2c, https://si.imgix.net/5ad7db4a/uploads/origins/00e06970-5b86-4a4f-a333-49c62c75692f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c83903434d44c222619880e188f72ab 2x, https://si.imgix.net/5ad7db4a/uploads/origins/00e06970-5b86-4a4f-a333-49c62c75692f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac44accc6618cc3aa57e9836e2c3dbc9 3x", "genre": "art", "nsfw": true, "body": "はじめまして、いつもfanboxの作品の数々にお世話になっております。特に柊さんのトイレ盗撮が好きなのですが、私事でございますが最近、和式トイレで女の子がうんちするアダルトビデオを見ていて、その中の一人がイキんだ時に経血が垂れてくるシーンがありとても癖に刺さりました。そこで、ぜひとも生理中の柊さんの脱糞シーンを描いていただきたいです。生理用品をこちらに見せつけてくれるとよりうれしいです。skeb利用初心者なのでご無礼がありましたら申し訳ございませんが何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/126", "thumbnail_src": "https://si.imgix.net/e79da215/uploads/origins/0ecc07f8-b68d-48b8-b458-7f52ecae37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9869df08f1ccdcba4413a00f695603d3", "thumbnail_srcset": "https://si.imgix.net/e79da215/uploads/origins/0ecc07f8-b68d-48b8-b458-7f52ecae37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9869df08f1ccdcba4413a00f695603d3, https://si.imgix.net/e79da215/uploads/origins/0ecc07f8-b68d-48b8-b458-7f52ecae37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=144d30db734c2235f36b1e231e11467c 2x, https://si.imgix.net/e79da215/uploads/origins/0ecc07f8-b68d-48b8-b458-7f52ecae37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1e8612a984644fff8f837b49cdfea43 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/125", "thumbnail_src": "https://si.imgix.net/f1257404/uploads/origins/a63322bf-ac69-4f0f-9eb8-8e4070bc5bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95020f1049fe0bccccdcff13d446cd4b", "thumbnail_srcset": "https://si.imgix.net/f1257404/uploads/origins/a63322bf-ac69-4f0f-9eb8-8e4070bc5bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95020f1049fe0bccccdcff13d446cd4b, https://si.imgix.net/f1257404/uploads/origins/a63322bf-ac69-4f0f-9eb8-8e4070bc5bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee992c985ca0275463d1e067140ecdc9 2x, https://si.imgix.net/f1257404/uploads/origins/a63322bf-ac69-4f0f-9eb8-8e4070bc5bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e07a351c66cedd6483f239226a0d18f2 3x", "genre": "comic", "nsfw": true, "body": "リクエスト失礼致します。\n雪水小夜ちゃんが足フェチのおじさんに辱められるシチュをお願いしたいです。\n\n雪水小夜ちゃんはおじさんに弱みを握られており、上履きを裸足で履いて授業を受けるように命令されています。\n放課後、言いつけどおり素足履きにしていた雪水小夜ちゃんは上履きを脱がされ、\n蒸れた足の指を舐め回されます。\nそして対面でムレムレ両足コキをするように言われ、雪水小夜ちゃんは両手で顔を隠しながら恥ずかしそうに陰茎に足指を絡めてしごきます。\n射精の有無は尺の都合に合わせてくださって構いません。\n\n以上になります。どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/124", "thumbnail_src": "https://si.imgix.net/548e36eb/uploads/origins/68aa538c-061d-4659-9e57-a64db1442c44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753514346bd245f7b551a90dbeb32d5a", "thumbnail_srcset": "https://si.imgix.net/548e36eb/uploads/origins/68aa538c-061d-4659-9e57-a64db1442c44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753514346bd245f7b551a90dbeb32d5a, https://si.imgix.net/548e36eb/uploads/origins/68aa538c-061d-4659-9e57-a64db1442c44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44a693969f8540fc5ad9180ef38a439a 2x, https://si.imgix.net/548e36eb/uploads/origins/68aa538c-061d-4659-9e57-a64db1442c44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=448221c376b06e8c1a7aef8032fec159 3x", "genre": "art", "nsfw": true, "body": "シャンタルちゃんが年下の女の子にヘッドロックをかけるイラストをお願いします。\n女の子の顔はシャンタルちゃんの腋で覆われています。\n腋汗が女の子の顔を伝っています。\n女の子はビクビクと震えています。\n女の子の体型はシャンタルちゃんと同じくらいがいいです。他に指定はありません。\nよろしければご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/123", "thumbnail_src": "https://si.imgix.net/8b2273d5/uploads/origins/3b4f94f8-b69a-4e9d-a5f5-8a8e1a380547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5c8a5851dcbc3f4e849e80994351d06", "thumbnail_srcset": "https://si.imgix.net/8b2273d5/uploads/origins/3b4f94f8-b69a-4e9d-a5f5-8a8e1a380547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5c8a5851dcbc3f4e849e80994351d06, https://si.imgix.net/8b2273d5/uploads/origins/3b4f94f8-b69a-4e9d-a5f5-8a8e1a380547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cd393266f47490bde9c01770dcaf628 2x, https://si.imgix.net/8b2273d5/uploads/origins/3b4f94f8-b69a-4e9d-a5f5-8a8e1a380547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d743e562e67bad5e1fd8915c0080a4b8 3x", "genre": "art", "nsfw": true, "body": "以前特別制服の女子達(https://skeb.jp/@Zakotsu_XYH/works/102)を依頼したものです。\n今回は女性教諭達も特別制服が導入されたという設定でストーリー形式のイラストをお願いします。\n\n【シチュエーション】\n産休直前の妊娠中の女性教諭が特別制服の日にボテ腹を衆目に晒すことに\n↓\n更に保険の授業で子作り実習として生徒達の前でSEX、下品なアへ顔を晒してしまう\n\n【キャラ】\n•女性教諭\n20代後半、生徒達に人気\n夫とはラブラブ\nスレンダーなためボテ腹が目立つ\n\nシーン１\n普段の朝、校門に立ち笑顔で生徒に挨拶\nシーン２\n特別制服の日、他の先生と一緒に丸出しのデカ乳輪とボテ腹に顔を真っ赤にしながら校門で挨拶\nシーン３\nSEX実演なんて聞いてないです、と嫌がりながらも立ちバックの体勢で同僚に犯される先生\n普段聞いたこともないオホ声と無様なアへ顔に驚愕する生徒達だった…", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/122", "thumbnail_src": "https://si.imgix.net/a0822f83/uploads/origins/783db0d9-bddc-4ebd-a5bf-f3f948debe49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f6796a1de160d64fb941ab448b2ec3a", "thumbnail_srcset": "https://si.imgix.net/a0822f83/uploads/origins/783db0d9-bddc-4ebd-a5bf-f3f948debe49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f6796a1de160d64fb941ab448b2ec3a, https://si.imgix.net/a0822f83/uploads/origins/783db0d9-bddc-4ebd-a5bf-f3f948debe49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4c12053255fedb455f81ae3f970d845 2x, https://si.imgix.net/a0822f83/uploads/origins/783db0d9-bddc-4ebd-a5bf-f3f948debe49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93225eaabfef7a4dacd3d6bb7fa743a4 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/121", "thumbnail_src": "https://si.imgix.net/13075e57/uploads/origins/12f2107c-5914-4feb-8854-59c2ee66c80b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e30d5cc6dda3816c163334a591ea081e", "thumbnail_srcset": "https://si.imgix.net/13075e57/uploads/origins/12f2107c-5914-4feb-8854-59c2ee66c80b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e30d5cc6dda3816c163334a591ea081e, https://si.imgix.net/13075e57/uploads/origins/12f2107c-5914-4feb-8854-59c2ee66c80b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=588dc470a443cfd18614d6dd1fb01e60 2x, https://si.imgix.net/13075e57/uploads/origins/12f2107c-5914-4feb-8854-59c2ee66c80b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e386c7b81f288246753c3b96f0742f1a 3x", "genre": "comic", "nsfw": true, "body": "リクエストさせていただきます！\n錫家摩季ちゃん（資料URL参照）が、お腹を壊して学校の和式トイレで下痢便を排泄する様子を、漫画形式でお願いします。\n\n・服装\n同じく資料URLの私服（シャツ、パーカー、スカート、黒ニーハイソックス、無地の白パンツ、上履き）。\n\n・シチュエーション\n1、学校でお腹を壊した錫家ちゃんが小さくオナラを漏らしながら、和式トイレに駆け込む\n2、苦しそうな顔で下痢便を排泄\n3、ウンチを全部出し終わり、水っぽいオナラと放尿をする\n4、間に合って安心した表情でお尻を拭く\n\n※2、3部分での排泄シーンの構図は、正面ぎみの盗撮アングルで排泄の様子と便器内と顔が見えるようにお願いします。\nまた、排泄中のシーンではブリブリビチビチジョボジョボ……等、ウンチ、おしっこ、オナラの効果音を必ず描いてください。\n\n以上です。\n是非、ご検討のほどよろしくお願いいたします。\n\nhttps://www.fanbox.cc/@zakotsu/posts/8935881", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/120", "thumbnail_src": "https://si.imgix.net/5bd756d7/uploads/origins/939f8f93-1ca2-4305-b288-d8680f68f326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c2b8b7462b5b69a35f2b7ffe15ee86a", "thumbnail_srcset": "https://si.imgix.net/5bd756d7/uploads/origins/939f8f93-1ca2-4305-b288-d8680f68f326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c2b8b7462b5b69a35f2b7ffe15ee86a, https://si.imgix.net/5bd756d7/uploads/origins/939f8f93-1ca2-4305-b288-d8680f68f326?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e719475d796263b024f7a935d69b0cdf 2x, https://si.imgix.net/5bd756d7/uploads/origins/939f8f93-1ca2-4305-b288-d8680f68f326?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21dcc9e729c5eaa1607b5f677119e50b 3x", "genre": "art", "nsfw": true, "body": "月戸美弥ちゃんの時間停止ものを漫画、もしくは差分形式イラストでモノクロでお願いしたいです。 ナンパしてきた男に「話しかけないでもらえますか？興味ないので。」とクールに返したのが逆鱗に触れ、時間を止められてめちゃくちゃに犯されるところをお願いします。本編軸とは関係ないIF設定で、処女の設定をお願いします。陰毛の処理もしておらず、剛毛だと嬉しいです。チョークスリーパーのような感じで首をロックしながら前穴を犯した後に後ろ穴も犯し、1ヶ月ほど犯し続けて身体、髪の毛や膣内、肛門内、口腔内が性液まみれになったところで時間停止を解除してください。無様な表情で奇声を上げながら小と大を吹き出し、倒れてビクビクなるところまでお願いします。脚好きなので、原作通りのストッキングは最後まで脱がさず犯し、大がストッキングの中に盛り上がる描写をお願いします。脚先まで入る構図が多いと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/119", "thumbnail_src": "https://si.imgix.net/6abb3364/uploads/origins/54e4bbd8-030b-451e-b8c6-e703b3c504d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cfbd78183397992648c60ec08d3e0aa", "thumbnail_srcset": "https://si.imgix.net/6abb3364/uploads/origins/54e4bbd8-030b-451e-b8c6-e703b3c504d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cfbd78183397992648c60ec08d3e0aa, https://si.imgix.net/6abb3364/uploads/origins/54e4bbd8-030b-451e-b8c6-e703b3c504d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b8da2351563cf6d76b725f34b8df4ab 2x, https://si.imgix.net/6abb3364/uploads/origins/54e4bbd8-030b-451e-b8c6-e703b3c504d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f8e89773ea16257bd6aa7ee1d439516 3x", "genre": "comic", "nsfw": true, "body": "腋臭眼鏡委員長ちゃんでまたまたリクエストお願いします。今回も男子のモノローグ付きがいいです。\n\n委員長の家にて性行為。委員長の腋に顔を埋めながらゼロ距離で呼吸することで、脳細胞と嗅覚細胞を犠牲に精力を保つ彼氏くん。臭いと興奮で意識が飛びそうになる。委員長は気持ちよさに喘いでおり汗だく。\n\n委員長ちゃんは裸がいいです。体位についてはおまかせします。よろしければお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/118", "thumbnail_src": "https://si.imgix.net/37e8c14e/uploads/origins/ae97a45a-1ae8-4efe-82fb-290f2f2a2e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9bee4d360ae21facbec18483a7b701", "thumbnail_srcset": "https://si.imgix.net/37e8c14e/uploads/origins/ae97a45a-1ae8-4efe-82fb-290f2f2a2e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9bee4d360ae21facbec18483a7b701, https://si.imgix.net/37e8c14e/uploads/origins/ae97a45a-1ae8-4efe-82fb-290f2f2a2e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d92ac570dd946b85ca403a26b73867fb 2x, https://si.imgix.net/37e8c14e/uploads/origins/ae97a45a-1ae8-4efe-82fb-290f2f2a2e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=091025d5f30221711b485cfa8c53aa8d 3x", "genre": "art", "nsfw": true, "body": "以前描いてくださった委員長ちゃんでリクエストさせてください。男子のモノローグ付きでお願いします。\n\n体育倉庫にて同じクラスの男子に押し倒されてしまった委員長ちゃん。満更でもないのか目を閉じてキス待ちの表情。袖は捲っていたため生腋がむき出しの状態。汗染みが体操服を黄色く染めている。\n\nよろしければご一考ください。お願いします！\n\nhttps://www.fanbox.cc/@zakotsu/posts/4880329", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/117", "thumbnail_src": "https://si.imgix.net/1daa219c/uploads/origins/b3b1a2b6-8e4b-43b4-920f-68c18db6b661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aa60d265ebd3bdfd11884582068da4b", "thumbnail_srcset": "https://si.imgix.net/1daa219c/uploads/origins/b3b1a2b6-8e4b-43b4-920f-68c18db6b661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aa60d265ebd3bdfd11884582068da4b, https://si.imgix.net/1daa219c/uploads/origins/b3b1a2b6-8e4b-43b4-920f-68c18db6b661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bb2917affd92aaf2beeacc9ce3c045c 2x, https://si.imgix.net/1daa219c/uploads/origins/b3b1a2b6-8e4b-43b4-920f-68c18db6b661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a95e671b45475cde8c5b925ebf905365 3x", "genre": "art", "nsfw": true, "body": "雪水小夜シリーズがすごく良かったので依頼します。\n\n【キャラクター】\n雪水小夜\n\n【シチュ】\n便秘になってお医者さんに診てもらっている雪水小夜ちゃん。\nお医者さんは盗撮動画を知っていて、自分でも盗撮をしようとする。\n\n小夜ちゃんは診察ベッドの上で浣腸され，検査のためと言われてトイレではなくベットの上でたらい状の容器に排便させれているのを盗撮されているシチュでお願いします。\n\n【ポーズ】\nぺたんこ座りでちょっとおしりを上げて排便している構図でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/116", "thumbnail_src": "https://si.imgix.net/609f0db3/uploads/origins/4c3b6db0-3cc2-4b93-9c1d-5f9b4a8a3146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b546f44e982a35b25a7977860353ba", "thumbnail_srcset": "https://si.imgix.net/609f0db3/uploads/origins/4c3b6db0-3cc2-4b93-9c1d-5f9b4a8a3146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b546f44e982a35b25a7977860353ba, https://si.imgix.net/609f0db3/uploads/origins/4c3b6db0-3cc2-4b93-9c1d-5f9b4a8a3146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b9633fc82507496ede09bcf3c49d0f2 2x, https://si.imgix.net/609f0db3/uploads/origins/4c3b6db0-3cc2-4b93-9c1d-5f9b4a8a3146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f667b5fe0d76f3bdc3a1a341801287b 3x", "genre": "art", "nsfw": true, "body": "こんばんは。1/7にお願いした錫家さん（URL）の続きを是非リクエストさせて下さい\n\n服装…前回と同じ(シャツ、パーカー、スカート、ニーソ&無地白パンツ)\n内容…前回の失禁後、周りにバレて椅子から立たされる錫家さん\n\nニーソや床を濡らし、椅子に座りながら静かに啜り泣く錫家さん。こちら(https://skeb.jp/@Zakotsu_XYH/works/74)の一枚目右カットの様に全身像を希望します)\n↓\n椅子から立たされた後の、スカートお尻部分のアップ。大きく染みが広がり、裾からポタポタ滴るおしっこ\n↓\n耳まで真っ赤になり、俯いて涙を流す錫家さん。先生に優しく保健室行きを指示され、恥ずかしそうにこくりと頷く\n↓\nローアングルから見た下半身(お尻)。お尻にぺったり張り付く濡れたパンツ、液体の流れた跡が残るニーソ、スカートから垂れるおしっこの残滓\n\n複雑で申し訳ありません、ご検討お願いします\n\nhttps://skeb.jp/@Zakotsu_XYH/works/113", "created_at": "", "completed_at": ""}, {"path": "/@Zakotsu_XYH/works/115", "thumbnail_src": "https://si.imgix.net/6950fe78/uploads/origins/6f184a8f-038c-4467-adcd-7b66e54a518a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a414a837e5290fd6e92280f64423ba5", "thumbnail_srcset": "https://si.imgix.net/6950fe78/uploads/origins/6f184a8f-038c-4467-adcd-7b66e54a518a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a414a837e5290fd6e92280f64423ba5, https://si.imgix.net/6950fe78/uploads