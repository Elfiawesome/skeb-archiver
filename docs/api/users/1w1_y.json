c0-9db0-32427a8ea9ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a88fa95feda880b69bc32835a3af5879 2x, https://si.imgix.net/d7cb64c6/uploads/origins/c29c55e9-43c5-42c0-9db0-32427a8ea9ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4909bca12c76b99034e454483650b0ac 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、ドラ公です。\n\nhttps://skeb.jp/@1w1_y/works/59\n以前ご依頼した、こちらのキャラクターの新規立ち絵を追加でご依頼したく存じます。\n\n\n・外見\n上半身裸。下は前回通りブカブカのカーゴパンツ。\n上半身は顔以外いたる所に古傷がある。\n・表情\n真顔。\n・構図\nあぐらをかきながら横にいる相手に手を伸ばしてる\n・背景\n透過\n・差分で欲しい表情\n真顔に加えて、納品していただいた表情と追加で依頼中の表情をお願いいたします。\n各表情に眼鏡の有無の差分も頂きたいです。\n\n納品に関しては遅くなっても大丈夫です。\n提示した金額で収まらなければ再送を要請ください。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@1w1_y/works/68", "thumbnail_src": "https://si.imgix.net/5c406fd9/uploads/origins/77ad5be7-5c3a-4f4f-96c8-6c60aec44861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b052d939db5aad6f9d830fe748ed07a4", "thumbnail_srcset": "https://si.imgix.net/5c406fd9/uploads/origins/77ad5be7-5c3a-4f4f-96c8-6c60aec44861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b052d939db5aad6f9d830fe748ed07a4, https://si.imgix.net/5c406fd9/uploads/origins/77ad5be7-5c3a-4f4f-96c8-6c60aec44861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8f73756c2199c97a43678b18955e743 2x, https://si.imgix.net/5c406fd9/uploads/origins/77ad5be7-5c3a-4f4f-96c8-6c60aec44861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ab10af19c0a2d563f67f9e1b7c53538 3x", "genre": "art", "nsfw"