t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caac4299d24f4de841765f2b9b7e7c2a 3x", "genre": "art", "nsfw": false, "body": "a pov kiss from イザベル from 大きな館のおもてなし", "created_at": "", "completed_at": ""}, {"path": "/@TE96765987/works/9", "thumbnail_src": "https://si.imgix.net/55554b61/uploads/origins/f038a973-afc9-434c-ad63-1a59a6b7ef5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a7b46d14883c61643834a5b02d54a3f", "thumbnail_srcset": "https://si.imgix.net/55554b61/uploads/origins/f038a973-afc9-434c-ad63-1a59a6b7ef5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a7b46d14883c61643834a5b02d54a3f, https://si.imgix.net/55554b61/uploads/origins/f038a973-afc9-434c-ad63-1a59a6b7ef5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64ee26775b6f7908392b4c264ca2fef2 2x, https://si.imgix.net/55554b61/uploads/origins/f038a973-afc9-434c-ad63-1a59a6b7ef5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d37032ad8621fb33e048ef017ce476a 3x", "genre": "art", "nsfw": true, "body": "いつもありがとうございます。\n今回はT&E様の最新作、巨大の夢RSSからリクエストを送らせていただきます。\n今作も楽しませていただきました。\n\n・現実世界にやってきたミリアとアリア（ともに全裸）が主人公（全裸にされている、現実世界なので小さくない）を顔中身体中キスマークだらけにしている\n・ミリアはいつもの真っ赤な口紅、アリアは桃色の口紅\n・アリアは興奮して主人公に大量に愛をささやきながら、足を絡めながら挿入させている\n・ミリアはその様子を面白がりつつも自分にもさせるようねだっている\n\nといった感じのイラストをお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@TE96765987/works/8", "thumbnail_src": "https://si.imgix.net/53519e61/uploads/origins/909b39ff-7cd0-4aff-9511-bc7b471b0aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5c0c4466201162aed52e0c8e2f18a90", "thumbnail_srcset": "https://si.imgix.net/53519e61/uploads/origins/909b39ff-7cd0-4aff-9511-bc7b471b0aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5c0c4466201162aed52e0c8e2f18a90, https://si.imgix.net/53519e61/uploads/origins/909b39ff-7cd0-4aff-9511-bc7b471b0aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c4162c5b1c59467f183508db219fc24 2x, https://si.imgix.net/53519e61/uploads/origins/909b39ff-7cd0-4aff-9511-bc7b471b0aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16a5ffcceea5fbdedf5232d58eb78b42 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nT&E様の作品、「誘惑の夢～魔物の夢～」の猫又と妖狐が、全裸にされた主人公を挟んで両側から抱きしめ、顔中身体中をお互いが競い合ってキスマークだらけにしている様子のイラストをお願いします。\n・口紅は、作中同様猫又がピンク、妖狐が赤で、猫又がいる側は猫又、妖狐がいる側は妖狐のキスマークが集中\n・どちらも塗りなおすために口紅を手に持っている\n・妖狐は頬（すでにキスマークだらけ）に思い切り強く吸い付くようなキスをしている瞬間、猫又は反対側の耳（すでにキスマーク付着）を舐めている、もしくはしゃぶっている瞬間\n・主人公はすでに射精しているが、それに気づきつつも、一向にやめる気はない旨の猫又の台詞\n・猫又の台詞には、競い合っていることが分かる旨の台詞も\n・妖狐も、キスをしている最中なのでしゃべれないが、思っていること、（負けられない）みたいな感じの、競い合っている故のモノローグをお願いします", "created_at": "", "completed_at": ""}]}