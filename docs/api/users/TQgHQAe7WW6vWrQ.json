-4601-8ebc-8cb9a77dee37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=290d3161db0c3e2f1e55accfdb725764 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/245", "thumbnail_src": "https://si.imgix.net/d7318439/uploads/origins/c27c2611-5b36-45c1-a416-1468457567d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a495c0b64f663c0f825130c252eb0dd", "thumbnail_srcset": "https://si.imgix.net/d7318439/uploads/origins/c27c2611-5b36-45c1-a416-1468457567d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a495c0b64f663c0f825130c252eb0dd, https://si.imgix.net/d7318439/uploads/origins/c27c2611-5b36-45c1-a416-1468457567d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98b6035c51de465b8cd6d547ee56a45f 2x, https://si.imgix.net/d7318439/uploads/origins/c27c2611-5b36-45c1-a416-1468457567d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=880f53c8e1f76daefc6116b8b45e7fef 3x", "genre": "art", "nsfw": true, "body": "前回は最高のイラストをありがとうございました。\nまたリクエストさせてください。\n\n以下の設定のセリフ付イラストをお願いします。\nブルーラビット\nhttps://www.pixiv.net/artworks/114662438\n\nセリフ参考\nhttps://www.pixiv.net/novel/show.php?id=16650925\nが、\n\nブラックラビット（ブルーラビットのクローンでふたなり。性格はブルーラビットを少しSにした感じ）\nhttps://www.pixiv.net/artworks/100057637\nに敗北した後。\n\nブルーラビットはブラックラビット（ふたなり）中出しされまくって、既にブラックラビットの子を4人妊娠出産済みで、５人目を妊娠してボテ腹になり黒くなった巨乳輪（爆乳）から母乳を出しながら、\nhttps://www.pixiv.net/artworks/77624435のような体位で、中出しされているイラスト。\n\nブルーラビットはブラックラビットの子を4人妊娠出産済みで、５人目を妊娠していることや子は１０人以上作る予定なこと等の市民などに報告している。\n\nブルーラビットの服装は参考のような感じで乳輪が丸見えな感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/244", "thumbnail_src": "https://si.imgix.net/cbce66b1/uploads/origins/da80d2dc-0054-4c8b-9c6a-99dfacf24023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9db396ebcef187fd8a5bf8832e1bd545", "thumbnail_srcset": "https://si.imgix.net/cbce66b1/uploads/origins/da80d2dc-0054-4c8b-9c6a-99dfacf24023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9db396ebcef187fd8a5bf8832e1bd545, https://si.imgix.net/cbce66b1/uploads/origins/da80d2dc-0054-4c8b-9c6a-99dfacf24023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e0d57b14eb71d99479de727d6e28408 2x, https://si.imgix.net/cbce66b1/uploads/origins/da80d2dc-0054-4c8b-9c6a-99dfacf24023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef78c7f460dc4e7c7d0e6d00987074ab 3x", "genre": "art", "nsfw": true, "body": "こんにちは。よろしければリクエストを受けていただけると嬉しいです。\n\n【キャラクター】\n「艦これ」よりアイオワ、金剛、大和\n\n【シチュエーション】\n全員がふたなりで3Pしている。\nアイオワが金剛の胸を揉みしだきながら金剛に挿入。同時に、金剛が大和に手コキしながら挿入。\n 表情はアイオワは楽しそうに、金剛は気持ちいいのを耐えているように。大和は快楽に顔を歪めている。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/243", "thumbnail_src": "https://si.imgix.net/604db792/uploads/origins/5ef40092-02eb-4474-ae8f-8971c13d21e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b00c848c7f76c6934580bb5850ca3be", "thumbnail_srcset": "https://si.imgix.net/604db792/uploads/origins/5ef40092-02eb-4474-ae8f-8971c13d21e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b00c848c7f76c6934580bb5850ca3be, https://si.imgix.net/604db792/uploads/origins/5ef40092-02eb-4474-ae8f-8971c13d21e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b1a2285cefd1dc59c1ce1059eac034b 2x, https://si.imgix.net/604db792/uploads/origins/5ef40092-02eb-4474-ae8f-8971c13d21e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bddd65c3368ff001f69c63a12e8658e3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/242", "thumbnail_src": "https://si.imgix.net/bf8d8b32/uploads/origins/e6000b9f-80fc-4bee-aa43-afea415990ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=997326cb616d2bbd08917cac37058fb9", "thumbnail_srcset": "https://si.imgix.net/bf8d8b32/uploads/origins/e6000b9f-80fc-4bee-aa43-afea415990ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=997326cb616d2bbd08917cac37058fb9, https://si.imgix.net/bf8d8b32/uploads/origins/e6000b9f-80fc-4bee-aa43-afea415990ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=341c994b8b6d252ec94db09d1fe4d00c 2x, https://si.imgix.net/bf8d8b32/uploads/origins/e6000b9f-80fc-4bee-aa43-afea415990ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5132d849b02d363e66cb01e5d0b06d2 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエストさせていただきます\n【キャラ】\n東郷あい、高橋礼子（アイドルマスターシンデレラガールズ）\n【シチュエーション】\n高橋礼子がふたなりの東郷あいに授乳手コキをしている\n高橋礼子は母乳が出ており、二人とも全裸でお願いします\n【表情】\n高橋礼子＞優しい顔で見つめながらも乳首を吸われて感じている\n東郷あい＞恥ずかしがりながら、手コキされて感じている\n\n擬音とセリフはお任せします\n\n疎い文章ですがよろしくお願いします\n\n参考：https://photos.app.goo.gl/iuDxu3f2Kmb1nJYUA", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/241", "thumbnail_src": "https://si.imgix.net/b8a6846f/uploads/origins/70bbf607-0c4a-4dbf-9cbe-3ba9a5138c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c6282e4a29b1d906f4fdc3a931d1752", "thumbnail_srcset": "https://si.imgix.net/b8a6846f/uploads/origins/70bbf607-0c4a-4dbf-9cbe-3ba9a5138c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c6282e4a29b1d906f4fdc3a931d1752, https://si.imgix.net/b8a6846f/uploads/origins/70bbf607-0c4a-4dbf-9cbe-3ba9a5138c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4166d003d03def7e884c8b6c56c8a98f 2x, https://si.imgix.net/b8a6846f/uploads/origins/70bbf607-0c4a-4dbf-9cbe-3ba9a5138c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6186782e962cc20a80c6a36a4e2d397e 3x", "genre": "art", "nsfw": true, "body": "前回、ティファの御依頼受けていただきありがとうございました。今回もうけていただけるとありがたいです。\n今回も、レズでお願いします。\n今回のキャラクターはゴブリンスレイヤー1話に出る眼鏡の女魔法使いと\nレズゴブリン\nレズゴブリンを新たにデザインしてもらう形になります。\nレズゴブリンのイメージは背はゴブリンと同じで、冒険者の半分くらい、身体の色は緑で爆乳。かわいい系の顔で、八重歯がある感じ\n長乳首で、乳首がビン勃ち。補足すると、レズゴブリンの乳首がゴブリンの生殖器のイメージになります。(だからといってチ○コの形ではないです。)竿は無しです。\n\n構図\nアニメ一話みたいに、女魔導士が倒されて、\n上半身にレズゴブリンがマウントポジションで乗りビンビンになった長乳首を女魔導士の口に突っ込んでねっとりした母乳を飲ませている。レズゴブリンは、感じているが言葉というより奇声をあげている感じのセリフと\n女魔導士は心の声で、ねっとりしたのが喉に、、、嫌あああ❤️ みたいなのをいれていただけるとありがたいです。\n場所は、アニメ一話のように洞窟内みたいな感じでよろしくお願いします。\nあと右上に四角い枠で、\nレズゴブリン\n体躯は小さいが、女冒険者の匂いを嗅ぐと発情して襲いかかって来る。\n奴らの母乳は、ねっとりとした媚薬で飲まされるとたちまち性の虜となってしまうであろう。\n\nみたいに説明文をつけてくれるとありがたいです。\nまた、御依頼受けていただけるとありがたいです。\nよろしくお願いします。\n\nhttps://www.ganganonline.com/title/47", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/240", "thumbnail_src": "https://si.imgix.net/094271a5/uploads/origins/4f523dc5-7db8-4144-9ae2-15bcda8e0a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32f938365066be1325b3a2d3c83c4d5", "thumbnail_srcset": "https://si.imgix.net/094271a5/uploads/origins/4f523dc5-7db8-4144-9ae2-15bcda8e0a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32f938365066be1325b3a2d3c83c4d5, https://si.imgix.net/094271a5/uploads/origins/4f523dc5-7db8-4144-9ae2-15bcda8e0a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57327c450bf68e94376aaa50e8d357fc 2x, https://si.imgix.net/094271a5/uploads/origins/4f523dc5-7db8-4144-9ae2-15bcda8e0a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6527c9654015980ef444da1d4a5e9e2 3x", "genre": "art", "nsfw": true, "body": "ポケモンのリコとサンゴの相互手マンレズバトルをお願いします。全裸の状態で胸をぶつけ合いながら、相手の秘所を必死に刺激し合って同時に潮吹きしてしまうイラストをお願いします。胸の大きさは普通ぐらいでお願いします。\n\n良ければご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/239", "thumbnail_src": "https://si.imgix.net/adb7cca3/uploads/origins/7e68a5f8-d518-4ad0-988b-b8e7e950d781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daad353ecdfb46947af8cecc937975ce", "thumbnail_srcset": "https://si.imgix.net/adb7cca3/uploads/origins/7e68a5f8-d518-4ad0-988b-b8e7e950d781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daad353ecdfb46947af8cecc937975ce, https://si.imgix.net/adb7cca3/uploads/origins/7e68a5f8-d518-4ad0-988b-b8e7e950d781?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b81298c05ab163e67a517054e7f1aa50 2x, https://si.imgix.net/adb7cca3/uploads/origins/7e68a5f8-d518-4ad0-988b-b8e7e950d781?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8afb8b4a75941b79eaa255637e890194 3x", "genre": "art", "nsfw": true, "body": "いつも楽しくイラストを拝見しています！\n\nブルーアーカイブより、角楯カリンと一之瀬アスナがふたなりお姉さんたちに犯されているイラストをお願いします。\n構図は以前投稿された「キサキとトキ」に似た感じで、ふたなり化したアスナとカリンのペニスにはオナホが装着されて、強制的に兜合わせさせられている。\n\n可能であればセリフ付きでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@TQgHQAe7WW6vWrQ/works/238", "thumbnail_src": "https://si.imgix.net/28571d39/uploads/origins/85c318fd-c597-46ca-8196-38eaf9aa4dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5717b5570b5409108908b75b3623a27f", "thumbnail_srcset": "https://si.imgix.net/28571d39/uploads/origins/85c318fd-c597-46ca-8196-38eaf9aa4dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5717b5570b5409108908b75b3623a27f, https://si.imgix.net/28571d39/uploads/origins/85c318fd-c597-46ca-8196-38eaf9aa4dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=607355fece291beedcacea4b98ea6e86 2x, https://si.imgix.net/28571d39/uploads/