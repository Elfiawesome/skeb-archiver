.net/9f29ea32/uploads/origins/a668175a-192d-44e0-8ec1-5e35f13dd8b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7fc4b5081c00c6d1784a0dfab8598e4", "thumbnail_srcset": "https://si.imgix.net/9f29ea32/uploads/origins/a668175a-192d-44e0-8ec1-5e35f13dd8b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7fc4b5081c00c6d1784a0dfab8598e4, https://si.imgix.net/9f29ea32/uploads/origins/a668175a-192d-44e0-8ec1-5e35f13dd8b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f4e77c5f8f5ede1c090638a29d0f63a 2x, https://si.imgix.net/9f29ea32/uploads/origins/a668175a-192d-44e0-8ec1-5e35f13dd8b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c4a6f7e1a1a4cbedce73a137d6e15e1 3x", "genre": "art", "nsfw": false, "body": "ツイッターではお世話になっています。かずらです。\n是非自宅のキャラを描いてもらいたいと思いリクエストさせていただきます。\n資料は一応全身も入れてますが構図は好きなようにとってもらって大丈夫です。キャラデザもまだ最近練ったばかりのキャラなので、白髪黒目など顔周りがなんとなく一致していれば細かい装飾は変えたり足したりされてもOKです。\n補足の設定としては、200歳の魔術師(男)。魔術師としては国一の天才と言われているが女性関係にだらしなく、100数十年の間に何人かの妻と子供がいる。軽い性格で歯の浮く台詞も平気で言う。\n\nhttps://drive.google.com/drive/folders/1Bx_-6Cj121x8bU8uRNqdPxyi69kUMB5V", "created_at": "", "completed_at": ""}, {"path": "/@souSakumaru/works/7", "thumbnail_src": "https://si.imgix.net/5a5ec330/uploads/origins/af3098d4-6c71-4f86-8b83-e6cab9f267df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce48cf842b82452f30adcd484aa6f534", "thumbnail_srcset": "https://si.imgix.net/5a5ec330/uploads/origins/af3098d4-6c71-4f86-8b83-e6cab9f267df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce48cf842b82452f30adcd484aa6f534, https://si.imgix.net/5a5ec330/uploads/origins/af3098d4-6c71-4f86-8b83-e6cab9f267df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9f3af290a8d261bca5409d2b68b37a9 2x, https://si.imgix.net/5a5ec330/uploads/origins/af3098d4-6c71-4f86-8b83-e6cab9f267df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12cc80a157df1058cb7dd965c392fd1f 3x", "genre": "art", "nsfw": false, "body": "さくまる様、いつもお世話になっております！\n\nアースィム単体のイラストをリクエストしたくお願いに参りました。\n\nCS▶https://charasheet.vampire-blood.net/m5de6a39e3637cc343bafa462c1c09693\n　　(ネタバレを含む為、アラララ現行未通過の方は踏まないでください！)\n\n資料▶https://charasheet.vampire-blood.net/m5de6a39e3637cc343bafa462c1c09693\n\nシチュエーションや構図はお任せします。自陣から見た彼の印象が知りたく……よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@souSakumaru/works/6", "thumbnail_src": "https://si.imgix.net/db845d52/uploads/origins/96475256-8cae-4546-8652-4e002fcada76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b30f749d3a1016aedbceb7f6cb29ba8d", "thumbnail_srcset": "https://si.imgix.net/db845d52/uploads/origins/96475256-8cae-4546-8652-4e002fcada76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b30f749d3a1016aedbceb7f6cb29ba8d, https://si.imgix.net/db845d52/uploads/origins/96475256-8cae-4546-8652-4e002fcada76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27369d5df004ea3bb230c1b8cc97a538 2x, https://si.imgix.net/db845d52/uploads/origins/96475256-8cae-4546-8652-4e002fcada76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f368dc42f9b81589115bde01cdbbb07 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n創作キャラと蛇を一緒に描いていただきたいです。\n\n—創作キャラ\nフォルダ②黒髪の子をお願い致します。\n髪型：毛先を巻いたハーフツイン\n服装：ジャケットなし\n指定以外の髪型、服装のアレンジや簡略化していただいて大丈夫です。\n\n—蛇\n目の色：金色\n胴体の色：薄緑色\nリアル調、デフォルメなど、蛇と分かるものならなんでも構いません。胴体の大きさもご自由にしてください。イラストの雰囲気に合わせてお願い致します。\nフォルダ①に蛇を描いていただいたイラストが幾つかあるので参考にしてください。\n\n構図や表情はお任せ致します。\nご検討頂けますと幸いです！\n\nhttps://drive.google.com/drive/folders/10MNbMOmVbXzNGR9nyhQu6uKDDiyJyXLK", "created_at": "", "completed_at": ""}, {"path": "/@souSakumaru/works/5", "thumbnail_src": "https://si.imgix.net/23cd590e/uploads/origins/57f40b76-3d4c-4572-9e80-4438e32d135b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8537323d64867833ca77004b027e3889", "thumbnail_s