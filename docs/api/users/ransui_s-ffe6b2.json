bd-4c48-8db8-6f6bfcdeded4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51a64ebd051892cffa410450d95baedf", "thumbnail_srcset": "https://si.imgix.net/5f5357d6/uploads/origins/d655b88b-d8bd-4c48-8db8-6f6bfcdeded4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51a64ebd051892cffa410450d95baedf, https://si.imgix.net/5f5357d6/uploads/origins/d655b88b-d8bd-4c48-8db8-6f6bfcdeded4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ff6f4dda2d6b0321e601ce4cf8785f2 2x, https://si.imgix.net/5f5357d6/uploads/origins/d655b88b-d8bd-4c48-8db8-6f6bfcdeded4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f57cbcd5222ab2d66994ce8647a3866d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、彼女を気に入っていただけて嬉しいです彼女は、私のライトノベル「野良王国」の主人公です。親がいない動物たちが都会で暮らす話です。リリアンは魔法薬師であり、看護師でもあるのですが、血液恐怖症のため、その制約を受けています。彼女は白鳥で、フクロウ男の養子として育てられた。白鳥のように母性本能が強く、見た目より身体能力が高い。いつか街で空を飛ぶことが禁止されなくなったら、空を飛びたいと夢見ている。主人公のライラというライオンの女性に惹かれるが、彼女は密かに殺し屋をしている。いつかライラと結ばれたいと願い、ライラに振り回されながらも、会うたびに一生懸命になる。\n\n私はあなたの画風がとても好きなので、あなたが思うように彼女を描いてください。\n\nhttps://imgur.com/a/4FWTKNi", "created_at": "", "completed_at": ""}, {"path": "/@ransui_s/works/45", "thumbnail_src": "https://si.imgix.net/c82c5438/uploads/origins/6eedb0fe-6c4b-4302-89a5-81a581f8a2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54a6a9a7506308d3fed61220bf9c684b", "thumbnail_srcset": "https://si.imgix.net/c82c5438/uploads/origins/6eedb0fe-6c4b-4302-89a5-81a581f8a2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54a6a9a7506308d3fed61220bf9c684b, https://si.imgix.net/c82c5438/uploads/origins/6eedb0fe-6c4b-4302-89a5-81a581f8a2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d07621f1e3ccfb76f87707b3bfab3bc 2x, https://si.imgix.net/c82c5438/uploads/origins/6eedb0fe-6c4b-4302-89a5-81a581f8a2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d0c