781f9dd2c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7ecc35b28f4ab321f1b64e8fef6d624, https://si.imgix.net/a734395d/uploads/origins/d962a50a-fe32-4320-8e28-d781f9dd2c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ec20e58f6173e50e8c5ce985dddb17b 2x, https://si.imgix.net/a734395d/uploads/origins/d962a50a-fe32-4320-8e28-d781f9dd2c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e679ed64fe04f7da4705058d37a89da 3x", "genre": "art", "nsfw": false, "body": "はじめまして！(*^^*)オリジナルキャラのイラストをお願いしたいです。\n\n参考画像：https://sta.sh/224u9u0jm3bs\n\n茶色の大きな翼に色とりどりの花が描かれた天使です。年齢は27歳です。温厚で優しく、社交的な性格です。小さな村に住んでいて、花の世話をするのが好きです。\n\n自由に描いてください。ありがとうございました^_^。\n\nhttps://sta.sh/224u9u0jm3bs", "created_at": "", "completed_at": ""}, {"path": "/@SANERU77/works/2", "thumbnail_src": "https://si.imgix.net/1cf8a556/uploads/origins/1ee027b4-371e-46c9-bc3f-80cfd88b6557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd299ddcb12d02a72364baf707d83961", "thumbnail_srcset": "https://si.imgix.net/1cf8a556/uploads/origins/1ee027b4-371e-46c9-bc3f-80cfd88b6557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd299ddcb12d02a72364baf707d83961, https://si.imgix.net/1cf8a556/uploads/origins/1ee027b4-371e-46c9-bc3f-80cfd88b6557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1147e8cbb917f7c220ed482038d35a4 2x, https://si.imgix.net/1cf8a556/uploads/origins/1ee027b4-371e-46c9-bc3f-80cfd88b6557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39cbd4053ee129ac9a1a2c26eccaa34e 3x", "genre": "art", "nsfw": false, "body": "何でもいいのでかいてくださいませ。", "created_at": "", "completed_at": ""}, {"path": "/@SANERU77/works/1", "thumbnail_src": "https://si.imgix.net/17560c98/uploads/origins/68699a96-1f89-402c-9a3e-5ef0422de90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce3c5ef6c143fdefbb83afb83e7d0be", "thumbnail_srcset": "https://si.imgix.net/17560c98/uploads/origins/68699a96-1f89-402c-9a3e-5ef0422de90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce3c5ef6c143fdefbb83afb83e7d0be, https://si.imgix.net/17560c98/uploads/origins/68699a96-1f89-402c-9a3e-5ef0422de90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9bdb1ae4c206b2874ab7e42afaa5183 2x, https://si.imgix.net/17560c98/uploads/origins/68699a96-1f89-402c-9a3e-5ef0422de90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7caa3e84a4456dd59e478d8c087a781 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。今回はうちの子である「太期美咲」ちゃんをお願いしたいです。\n高身長、巨乳、迷彩服、キャップ、マスク、火器類など私自身すら描きづらい要素を含んでいます故、正直に申し上げて、サネル姉貴の絵柄とは絶望的に親和性が低いと思われます…。ですがサネル姉貴にならきっと魅力的に仕上げていただけると期待しています！\nデフォ装備はキャップ、戦闘服二型*、牙マスク、ニーパッド、ミリタリーブーツですが、参考画にはマルチカム迷彩*、ビーニー帽、Golka戦闘服*、バックパック、プレートキャリア*などが含まれます。依頼金額の範囲で、サネル姉貴が納得いくように恰好をアレンジいただければと思います。\n私も普段描くときはネットで軍事組織の隊員さんの写真を拾って装備をパクっているので、そういった方法をオススメします。\n（依頼文中に「*」が付いた単語は一度ググってみてください）\n\nこちら参考画になります↓\nhttps://twitter.com/vitellus_sis/status/1580177534116802560?s=20&t=H0LrcTXT1eWwPFEMa6MJdA", "created_at": "", "completed_at": ""}]}