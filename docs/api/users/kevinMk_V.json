ps://drive.google.com/drive/folders/1Mq-Fs5ukM7GoJnr1oE1zDE14920Krijt?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kevinMk_V/works/52", "thumbnail_src": "https://si.imgix.net/14680482/uploads/origins/c125df8a-bc7b-4f80-8b76-9b9fd704f362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf8fa8ecf089a3914769e2c66c253154", "thumbnail_srcset": "https://si.imgix.net/14680482/uploads/origins/c125df8a-bc7b-4f80-8b76-9b9fd704f362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf8fa8ecf089a3914769e2c66c253154, https://si.imgix.net/14680482/uploads/origins/c125df8a-bc7b-4f80-8b76-9b9fd704f362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc1baeef45309c78550906e4792a48b8 2x, https://si.imgix.net/14680482/uploads/origins/c125df8a-bc7b-4f80-8b76-9b9fd704f362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3757894e6596f9b10d69ad87b9211e9 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kevinMk_V/works/51", "thumbnail_src": "https://si.imgix.net/cabb4725/uploads/origins/05290f89-5c51-4886-831d-837499b2e948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f028d11a6b2dba975e81ed1af7bf1ddf", "thumbnail_srcset": "https://si.imgix.net/cabb4725/uploads/origins/05290f89-5c51-4886-831d-837499b2e948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f028d11a6b2dba975e81ed1af7bf1ddf, https://si.imgix.net/cabb4725/uploads/origins/05290f89-5c51-4886-831d-837499b2e948?bg=%23fff&auto=format%2Ccompress&