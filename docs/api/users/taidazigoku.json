1-4bab-856b-823098833ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e187b72422c438124613f5c2371f8c2, https://si.imgix.net/f52c33c4/uploads/origins/5a8a13ff-9561-4bab-856b-823098833ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b70924aeba24c8b09a0d4b00b7936565 2x, https://si.imgix.net/f52c33c4/uploads/origins/5a8a13ff-9561-4bab-856b-823098833ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19e16db518fce0b04f5d5c6168556b7a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/139", "thumbnail_src": "https://si.imgix.net/ec6dc45e/uploads/origins/ba1b9ed3-853b-4fdb-b4cf-59f6dc20067c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bc9ab2510eaa702f9e6507764fe7191", "thumbnail_srcset": "https://si.imgix.net/ec6dc45e/uploads/origins/ba1b9ed3-853b-4fdb-b4cf-59f6dc20067c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bc9ab2510eaa702f9e6507764fe7191, https://si.imgix.net/ec6dc45e/uploads/origins/ba1b9ed3-853b-4fdb-b4cf-59f6dc20067c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94236644f84f2521cbb5b1706daecd7a 2x, https://si.imgix.net/ec6dc45e/uploads/origins/ba1b9ed3-853b-4fdb-b4cf-59f6dc20067c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d56719bc24bc37473df50465f24d3f0 3x", "genre": "art", "nsfw": true, "body": "またこんにちは、私のオリジナルキャラクターであるシルフィアとソエを一緒に描いてほしいです。ソエはピースサインをしながらシルフィアにフェラチオをしていて、シルフィアはソエの頭に手を置いています。ソエの頬には、口に入れたシルフィアのペニスによる膨らみがあります。 シルフィアのペニスと下半身（ペニス周辺）には口紅のキスマークが付き、ペニス周囲には口紅の輪が浮かんでいる。これはフェラチオがしばらく続いていることを示す。ソの唇の口紅も、フェラチオのせいで乱れてにじんでいる。可能であればシルフィアの顔も見えるように、表情はご自由に。\nご判断で調整を加えていただいて構いません。作品をお待ちしております！\n\nシルフィア: https://photos.app.goo.gl/mftS8tnNgCQt2u7M8ソ: https://photos.app.goo.gl/5nG89M2fYF6M4wmc9ポーズ: https://photos.app.goo.gl/aesbGZeAtDDYgU33A", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/138", "thumbnail_src": "https://si.imgix.net/4aaf6221/uploads/origins/08edcee7-ec84-45a1-9f08-45246e851356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b8c51d3f1eb19bd9139f154e0303c4", "thumbnail_srcset": "https://si.imgix.net/4aaf6221/uploads/origins/08edcee7-ec84-45a1-9f08-45246e851356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b8c51d3f1eb19bd9139f154e0303c4, https://si.imgix.net/4aaf6221/uploads/origins/08edcee7-ec84-45a1-9f08-45246e851356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e47b551eb61e9f88e0d7f96e139a11e 2x, https://si.imgix.net/4aaf6221/uploads/origins/08edcee7-ec84-45a1-9f08-45246e851356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ed050d65ed5c9c062af44caf2804c2c 3x", "genre": "art", "nsfw": true, "body": "イラスト依頼させて頂きます\n\nブルーアーカイブの桐藤ナギサのイラストを描いて欲しいです\n\n乳サイズはこのくらいの爆乳でお尻と太ももはムチムチ\nhttps://skeb.jp/@taidazigoku/works/93\n\n衣装\nこちらのイラストのような胸から上部分のみの服、タイツ部分は無し\nhttps://www.pixiv.net/artworks/106077492\n黒マイクロビキニ、黒ストッキングニーソと白ハイヒール、ホルスター付きのハーネス\n\n構図\n全身またはひざ下くらいの立ち絵で手にティーカップとティーソーサー（受け皿）のセットを持っている\n\n汗でしっとりした肌で顔を赤らめながら微笑んでいる\n\n資料\nhttps://drive.google.com/drive/folders/1rVNXGhzwVZgBW9G7H-BOa7Iwa_lugxJZ?usp=sharing\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/137", "thumbnail_src": "https://si.imgix.net/3f5d8711/uploads/origins/36164c0e-59c8-4076-be25-512351ee770c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f6884fe9338d6a2e734eb15f04dd759", "thumbnail_srcset": "https://si.imgix.net/3f5d8711/uploads/origins/36164c0e-59c8-4076-be25-512351ee770c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f6884fe9338d6a2e734eb15f04dd759, https://si.imgix.net/3f5d8711/uploads/origins/36164c0e-59c8-4076-be25-512351ee770c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fa384ed1461637e5d06090095613e81 2x, https://si.imgix.net/3f5d8711/uploads/origins/36164c0e-59c8-4076-be25-512351ee770c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70275ca79c8ec5d9c6c2891169f9b516 3x", "genre": "art", "nsfw": true, "body": "https://i.postimg.cc/g0vD3gnm/562-9Ow-WXRT.png\n\nザイヴァのイラスト、すごく気に入りました！今度は私のオークの女性、サーナを描いてほしいです。参考画像にあるどちらの衣装でも、彼女に似合うと思う他の衣装でも構いません。お嬢様のように笑っている姿をお願いします。https://postimg.cc/gallery/WzvQw0n", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/136", "thumbnail_src": "https://si.imgix.net/8c42f08c/uploads/origins/430d3323-677b-43f7-8eaf-ad8b7ced086b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70e47b7b05bf896fc16781a6c51693d", "thumbnail_srcset": "https://si.imgix.net/8c42f08c/uploads/origins/430d3323-677b-43f7-8eaf-ad8b7ced086b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70e47b7b05bf896fc16781a6c51693d, https://si.imgix.net/8c42f08c/uploads/origins/430d3323-677b-43f7-8eaf-ad8b7ced086b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=011abb88f890a31c556228b29ef39fd9 2x, https://si.imgix.net/8c42f08c/uploads/origins/430d3323-677b-43f7-8eaf-ad8b7ced086b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5d856a6fe9cf74e1ef32810eebd1dcb 3x", "genre": "art", "nsfw": true, "body": "エイクンの御園キミカを新世紀エヴァンゲリオンのプラグスーツ姿でお願いしますhttps://gelbooru.com/index.php?page=post&s=list&tags=misono_kirika+neon_genesis_evangelion+\n\nhttps://gelbooru.com/index.php?page=post&s=list&tags=misono_kirika+neon_genesis_evangelion+", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/135", "thumbnail_src": "https://si.imgix.net/4b836889/uploads/origins/2cd7ef58-009c-4238-bbde-d7419995640e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2f80938379872d4410808afc917dd00", "thumbnail_srcset": "https://si.imgix.net/4b836889/uploads/origins/2cd7ef58-009c-4238-bbde-d7419995640e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2f80938379872d4410808afc917dd00, https://si.imgix.net/4b836889/uploads/origins/2cd7ef58-009c-4238-bbde-d7419995640e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0351081b0a4c0349fefcaa5cb5d4d44 2x, https://si.imgix.net/4b836889/uploads/origins/2cd7ef58-009c-4238-bbde-d7419995640e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7145034ea058971ace7c3459c607f180 3x", "genre": "art", "nsfw": true, "body": "またこんにちは、私のオリジナルキャラクター、シルフィア、ラドリ、オセラのサイズをリクエストします。\nシルフィアは身長190cm（耳を除く）、オセラは177cm、ラドリは212cm（角を除く）。シルフィアとラドリはやや引き締まった体格で、オセラはより細身で小柄。シルフィアのペニスは普通の大きさだが、ラドリのペニスは馬並み。両者ともペニスと睾丸が非常に大きい。\n3人はサウナ室に一緒にいる。シルフィアは首にタオルを巻いて立っており、オセラは中央に座り、ラドリはシルフィアと反対側の隣に座っている。オセラは中央に位置し、筋肉質な体と巨大なペニス・睾丸を持つ女性に囲まれ、極度に興奮して動揺している様子を（失敗しつつ）隠そうとしている。シルフィアはリラックスした明るい表情で、ラドリはより支配的な表情をしている。\n適宜調整してください。楽しみにしています！シルフィア: https://photos.app.goo.gl/mftS8tnNgCQt2u7M8 オセラ: https://photos.app.goo.gl/UoqfujsDj2LFqH398\nラドリ：https://photos.app.goo.gl/okzjaKeWn81LmPUo8ポーズ：https://photos.app.goo.gl/u3Be6WubRTY3VbSm8", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/134", "thumbnail_src": "https://si.imgix.net/d47e2c23/uploads/origins/6724fce2-60d1-4a34-b979-1fbcdc041976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cce46e6edcacc390bbbc025a9f25965", "thumbnail_srcset": "https://si.imgix.net/d47e2c23/uploads/origins/6724fce2-60d1-4a34-b979-1fbcdc041976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cce46e6edcacc390bbbc025a9f25965, https://si.imgix.net/d47e2c23/uploads/origins/6724fce2-60d1-4a34-b979-1fbcdc041976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60a655674437260c630f5fac4bb743ed 2x, https://si.imgix.net/d47e2c23/uploads/origins/6724fce2-60d1-4a34-b979-1fbcdc041976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=faa355c304ec92eb8bd78cb575faaab5 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ダークエルフのローグ、ザイヴァのコミッションをお願いします。サイズやポーズは特に指定ありません。お描きになるバストサイズは何でも構いません。身長は6フィート8インチ（約203cm）、砂時計型の体型です。二本の短剣を携えています。膨らんだ胸で床に押さえつけられている姿を描いてください。\n\nキャラクター参考資料: https://postimg.cc/PPB598T5コンセプトのインスピレーション: https://x.com/kumadaibako/status/1832546062802022863", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/133", "thumbnail_src": "https://si.imgix.net/569b1691/uploads/origins/f5085c88-e20c-41db-a453-fcdc900a2f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce63127877fd0e3897b0e23540feb9d1", "thumbnail_srcset": "https://si.imgix.net/569b1691/uploads/origins/f5085c88-e20c-41db-a453-fcdc900a2f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce63127877fd0e3897b0e23540feb9d1, https://si.imgix.net/569b1691/uploads/origins/f5085c88-e20c-41db-a453-fcdc900a2f36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=736bed9da3ba799e11f45deadd42c475 2x, https://si.imgix.net/569b1691/uploads/origins/f5085c88-e20c-41db-a453-fcdc900a2f36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6db31ddaaa46019f27d5a87f087dc6 3x", "genre": "art", "nsfw": true, "body": "Reincarnation ColosseumのZaydのアートが欲しいですhttps://gelbooru.com/index.php?page=post&s=list&tags=zaydhttps://gelbooru.com/index.php?page=post&s=list&tags=zayd", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/132", "thumbnail_src": "https://si.imgix.net/9b9a4d45/uploads/origins/fda0e517-e6ce-478e-8c48-a79dc434e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aff2ddedb91f8fda53ffd09a6f5b1326", "thumbnail_srcset": "https://si.imgix.net/9b9a4d45/uploads/origins/fda0e517-e6ce-478e-8c48-a79dc434e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aff2ddedb91f8fda53ffd09a6f5b1326, https://si.imgix.net/9b9a4d45/uploads/origins/fda0e517-e6ce-478e-8c48-a79dc434e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8207b7b99e06e1cec5d57891727cbf2 2x, https://si.imgix.net/9b9a4d45/uploads/origins/fda0e517-e6ce-478e-8c48-a79dc434e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e12bd0baa4f4fcc7b4bedc3248c2b3e0 3x", "genre": "art", "nsfw": true, "body": "私のオリジナルキャラクターを描いてください。彼女は非常に大きな胸をしています。眼鏡をかけていて、ボリュームのある長い緑色の髪をしています。描き方は自由ですが、遊び心があって親しみやすく、照れ屋な性格にしてください。そして、巨大な胸を忘れないでください。https://catbox.moe/c/9p6p5f", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/131", "thumbnail_src": "https://si.imgix.net/82b990a3/uploads/origins/b583dc5d-4862-42a9-b105-0031275b2ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1076f573fff15ee1085e8fbd9e59ffd", "thumbnail_srcset": "https://si.imgix.net/82b990a3/uploads/origins/b583dc5d-4862-42a9-b105-0031275b2ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1076f573fff15ee1085e8fbd9e59ffd, https://si.imgix.net/82b990a3/uploads/origins/b583dc5d-4862-42a9-b105-0031275b2ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ffc8f4d2613b1e83675c5b5682e8dbb 2x, https://si.imgix.net/82b990a3/uploads/origins/b583dc5d-4862-42a9-b105-0031275b2ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8db6605220914df743c11374856b0e33 3x", "genre": "comic", "nsfw": true, "body": "こんにちは！\nあなたの作品、大好きです！私の狼娘ナタネと巨乳の狐娘ムラサキの漫画をリクエストします。二人がカフェのブース席でくつろいでいるシーンをお願いします。大きな胸がテーブルの上に美しく乗っている様子を描いてください。ナタネ（身長165cm）はムラサキ（148cm）より背が高く、ムラサキの方が胸が大きい設定です。\n二人が飲み物を共有すると、胸が巨大化します。胸が大きくなり、互いに押し合う様子を連続描写してください。やがて伸びきった服から胸がはみ出し、乳首が露わになりながらさらに成長を続けます。最終的に二人は互いに押し合いながら新たな胸の大きさを楽しみつつ、カフェで大混乱を引き起こす展開をお願いします。それ以外はご自由に描いてください。\n\nご検討いただきありがとうございます。ナタネ参考文献: https://drive.google.com/drive/folders/1NvH9IUa8zaZ9GSofmrj-RwlTB_Zq_KYc?usp=drive_link\n\n紫 参照: https://drive.google.com/drive/folders/1NxN619JbdYk0n_PRSBO87FfNm_pkV47t", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/130", "thumbnail_src": "https://si.imgix.net/7a3bd013/uploads/origins/1c393e75-9065-4b83-a564-391754091cd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25fd1a194b31f031dd642c86d19597e7", "thumbnail_srcset": "https://si.imgix.net/7a3bd013/uploads/origins/1c393e75-9065-4b83-a564-391754091cd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25fd1a194b31f031dd642c86d19597e7, https://si.imgix.net/7a3bd013/uploads/origins/1c393e75-9065-4b83-a564-391754091cd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d0b9ab77c26f8ee81b8c359dd3a24f7 2x, https://si.imgix.net/7a3bd013/uploads/origins/1c393e75-9065-4b83-a564-391754091cd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19fac2b2d7593f7d01c1f51f29f0aa55 3x", "genre": "comic", "nsfw": true, "body": "私のキャラクター、エリゼ（小柄で巨乳の吸血鬼）とネル（筋肉質なドラゴン娘のふたなり）が激しいセックスをする漫画を描いていただけると嬉しいです！エリゼの胸は好きなだけ大きく、ネルの胸はかなり小さく描いてください。ネルのペニスは構図が良くなるサイズにしてください。\n\nキーポーズ:)1) エリーゼがネルに短い前戯としてパイズリフェラをする、いたずらっぽい表情\n\n2) エリーゼが抱え上げられ、驚いた表情で背中にネルを抱える。ネルは片腕でエリーゼの首を抱え、もう片方の足で体重を支えながら挿入を開始する。3) ネルがエリーゼをベッドに押し倒し、顔をシーツに埋めた状態で膣を激しく突き、中に出して絶頂させる。\n\nhttps://drive.google.com/drive/folders/1k9KIUA1VDc2vllb1WC0m8Z5hjGBa0iPj", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/129", "thumbnail_src": "https://si.imgix.net/a3e01cf3/uploads/origins/68debd87-f7e7-4a5b-b635-2f7632e2afc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d68ff3cbe981c2764016c0e8e83c7c34", "thumbnail_srcset": "https://si.imgix.net/a3e01cf3/uploads/origins/68debd87-f7e7-4a5b-b635-2f7632e2afc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d68ff3cbe981c2764016c0e8e83c7c34, https://si.imgix.net/a3e01cf3/uploads/origins/68debd87-f7e7-4a5b-b635-2f7632e2afc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4a3a73b77bac18006460e3938a31861 2x, https://si.imgix.net/a3e01cf3/uploads/origins/68debd87-f7e7-4a5b-b635-2f7632e2afc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d758b59a00df26df427a34e82f734a36 3x", "genre": "art", "nsfw": true, "body": "シンフォギアの超乳ミカをお願いしたいです。頭の何倍もの大きさ、できれば腰下くらい、もしくはそれ以上のサイズでお願いします。衣装は選択肢からお好きなものをお選びください。歯を見せながら興奮した表情を描いてくれると最高です。どうぞお楽しみください。\n\nhttps://drive.google.com/drive/folders/18Z84mnz020rDKzPQs2ovGeIl-lRH0niK?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/128", "thumbnail_src": "https://si.imgix.net/e8179e84/uploads/origins/e209c3bc-a2fa-436e-8343-a788d4f27f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6c3bdbd946998a48d679898c2f0e5d8", "thumbnail_srcset": "https://si.imgix.net/e8179e84/uploads/origins/e209c3bc-a2fa-436e-8343-a788d4f27f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6c3bdbd946998a48d679898c2f0e5d8, https://si.imgix.net/e8179e84/uploads/origins/e209c3bc-a2fa-436e-8343-a788d4f27f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=382712cdfa3411f98bd0751a6bb8bc12 2x, https://si.imgix.net/e8179e84/uploads/origins/e209c3bc-a2fa-436e-8343-a788d4f27f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=989415da4fd8c12dc4984e599a91c719 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/127", "thumbnail_src": "https://si.imgix.net/b858e3ff/uploads/origins/327e9732-8160-478e-9715-03fc9b06b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90db0de13058afb21f2c73e70baafc98", "thumbnail_srcset": "https://si.imgix.net/b858e3ff/uploads/origins/327e9732-8160-478e-9715-03fc9b06b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90db0de13058afb21f2c73e70baafc98, https://si.imgix.net/b858e3ff/uploads/origins/327e9732-8160-478e-9715-03fc9b06b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f0e209a0e1bd0b6ba0cf2d860caf5fe 2x, https://si.imgix.net/b858e3ff/uploads/origins/327e9732-8160-478e-9715-03fc9b06b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20da09ed3eae3addb8ee49790d95dde0 3x", "genre": "comic", "nsfw": true, "body": "初めまして、あなたの絵柄が好きなので依頼させて頂きます\n\nトイレの花子さんと恋人の男の子がセックスするイラストを描いて頂きたいです\n\n花子さん\nデザインと衣装はこちらを参考にしてください\nhttps://skeb.jp/@Kicdon_smash/works/294\nhttps://twitter.com/oekakizuki_turi/status/1659753274122330117\n体形は爆乳デカ尻で乳サイズはこのくらい、身長160㎝位\nhttps://www.pixiv.net/artworks/120122110\nhttps://www.pixiv.net/artworks/115437308\n使用済みコンドームをビキニやニーソに沢山ぶら下げていて、胸や太もも、お尻にに正の字とW.Cマークとトイレマークが書かれている\nビキニとニーソはエナメル材質\n汗だくのヌルテカ肌、パイパン\n\n男の子\n身長125cm位\n細身で可愛い系の見た目で髪型は黒髪ショートボブ（坊ちゃん刈りは×）、チンコサイズは細長めの巨根、性欲は非常に強く絶倫、とても可愛い\n\nプレイ内容\nhttps://skeb.jp/@taidazigoku/works/33\nhttps://skeb.jp/@taidazigoku/works/19\nのように複数カットの構図で描いてほしいですが難しければプレイ内容を減らしたり④だけでも大丈夫です\n①フェラ抜きで口内射精\n②パイズリで射精\n③立ちバックで高速ピストンされながら中出しで絶頂してる花子さん\n④花子さんと男の子が二人で並んで立って事後の記念撮影している、花子さんは汗だくで顔を上気させて息を切らして微笑んでいる、胸にズリ後の精液が付いていて、膣から精液が垂れている\n男の子は笑顔で花子さんのお尻を揉みながらピースして細長巨根を反り立たせている\n\n資料\nhttps://drive.google.com/drive/folders/1lNTnJAJJc9CnEGQOx-5z_qnq0vOl7VOe?usp=sharing\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/126", "thumbnail_src": "https://si.imgix.net/46870580/uploads/origins/89701858-f1b8-4e91-94b0-8e89bf9ecc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77cfed6f32781439f7b172e17b123aac", "thumbnail_srcset": "https://si.imgix.net/46870580/uploads/origins/89701858-f1b8-4e91-94b0-8e89bf9ecc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77cfed6f32781439f7b172e17b123aac, https://si.imgix.net/46870580/uploads/origins/89701858-f1b8-4e91-94b0-8e89bf9ecc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a22447852b958f4b7f7a1f432743bdb 2x, https://si.imgix.net/46870580/uploads/origins/89701858-f1b8-4e91-94b0-8e89bf9ecc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f95e109c0b474ea816eeb22d7692fa4 3x", "genre": "comic", "nsfw": true, "body": "英検の御園キリカの漫画をリクエストしたい。まず、彼女は自分よりはるかに背の高い男性モブキャラに向かってドヤ顔で胸を見せつける。まだドヤ顔のキリカにモブキャラがおっぱいを吸われるカット。", "created_at": "", "completed_at": ""}, {"path": "/@taidazigoku/works/125", "thumbnail_src": "https://si.imgix.net/10156d36/uploads/origins/0e2cc83b-195e-40e5-929c-6a4db2861a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde8dd8ccd544d50a92c29e66c63cce0", "thumbnail_srcset": "https://si.imgix.net/10156d36/uploads/origins/0e2cc83b-195e-40e5-929c-6a4db2861a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde8dd8ccd544d50a92c29e66c63cce0, https://si.imgix.net/10156d36/uploads/origins/0e2cc83b-195e-40e5-929c-6a4db2861a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b8e1fa817510d2ab781b4af5c9a04f7 2x, https://si.imgix.net/10156d36/uploads/origins/0e2cc83b-195e-40e5-929c-6a4db2861a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba38c77025cec7fa3b6742ee9cad7145 3x", "genre": "art", "nsfw": true, "body": "私のキャラクターを描いたあなたの作品が大好きです！\n\nhttps://skeb.jp/@orz_can/works/176\n\nこの例のように、ローアングルから彼女を描いていただけませんか？\n\nhttps://www.pixiv.net/en/artworks/112327897\n\nディテールやサイズはお好みで。\n\nありがとうございます！