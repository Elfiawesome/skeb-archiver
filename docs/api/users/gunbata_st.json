d8-4ef7-a491-ba42879739a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e352a3213f5143fd315939bfb4e2e1, https://si.imgix.net/f9b2326a/uploads/origins/b05b8fbe-3ed8-4ef7-a491-ba42879739a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75e44da6edd59c0a2ccb7c50e8f1bc61 2x, https://si.imgix.net/f9b2326a/uploads/origins/b05b8fbe-3ed8-4ef7-a491-ba42879739a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a153d3e83c0ac5fad0e1421013e363e 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\nもしよろしければ以下のキャラのイラストをお願いしたく思います\nよろしくお願い致します\n\nキャラ：キュアプレシャス（デリシャスパーティプリキュア）\nシチュ：三角木馬の上で鞭打ち\n衣装：プリキュア衣装（半裸OK）\n\nイラストは以下のゲーム（プリマヴェールZwei）のプリマヴェールルナ調教のイラストを参考にしていただければと思います\nhttps://www.escude.co.jp/product/zwei/index04.html\nhttps://www.escude.co.jp/product/zwei/index05.html\nギャラリーモードの10番です\n（見づらいかもしれないので、ドロップボックスにも参考画像入れておきます）\n\nルナ調教の画像と同じ感じで、キャラ（青いキャラ、ルナ）をキュアプレシャスに変更して頂ければと思います\nカメラアングルなども同じでOKで、後ろにいるキャラ（モブ）も同じでOKです（変更しても大丈夫です）\n表情も同じ感じでOKです\n元CGでも半裸となっているように、半裸OKです（完コスでもOK）\n完璧じゃなくても雰囲気が同じ感じであればOKですので、先生に細かいところはお任せします\n三角木馬の上で、鞭やロウ責めを受けている感じが伝わればOKです\n\nもし可能であれば、差分としてお漏らし差分（おしっこ）があると嬉しいです（木馬を濡らす感じで）表情は変わっても変わらなくてもOKです\n\n色々書いてしまって申し訳ありませんが、承認していただけると嬉しいです\nよろしくお願い致します\n\nhttps://www.dropbox.com/scl/fo/xc4q8k81pelvp0xq60se8/AHNVQzKDdBOREUN-suiFs7Q?rlkey=0e97c0jaake5rwuip8k7292nl&st=3ff1go3y&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@gunbata_st/works/639", "thumbnail_src": "https://si.imgix.net/aeeea6cb/uploads/origins/c3a6122d-e789-40db-8bf3-bd2a6184ec90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebbc2c743b77824850067a2dcdd8b5cc", "thumbnail_srcset": "https://si.imgix.net/aeeea6cb/uploads/origins/c3a6122d-e789-40db-8bf3-bd2a6184ec90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebbc2c743b77824850067a2dcdd8b5cc, https://si.imgix.net/aeeea6cb/uploads/origins/c3a6122d-e789-40db-8bf3-bd2a6184ec90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d529fc92c352280ec090dc9d292bfb7 2x, https://si.imgix.net/aeeea6cb/uploads/origins/c3a6122d-e789-40db-8bf3-bd2a6184ec90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc0e9c1aeeab562943b906b230c152b8 3x", "genre": "art", "nsfw": true, "body": "東方の十六夜咲夜をお願いします\n\n服装は下記の9枚目の衣装で完全に着衣でお願いします\nhttps://www.pixiv.net/artworks/30991785\n衣装の下半身部分はレオタード型で,上にブラウスとベストを着ている形(下記のようなの)でお願いします\nhttps://skeb.jp/@guild_tatsuya/works/4\nサポーター,ガーターベルト,ブーツ等手足の装備品は無しの状態でお願いします\nエプロン部分は股間の衣装が少し見える長さで表示非表示できる形でお願いします\n頭の飾りは無しで髪は解いた状態でお願いします\n衣装の胸部分は乳首が浮き出ない形でお願いします\n股間部分は縫い目の線は無しで性器が浮き出ない形でお願いします\n股布から汁が染み出ない形でお願いします\n\n下記のような主観視点で正常位でエッチをしている様子をお願いします\nhttps://www.pixiv.net/artworks/97197230\n全て着衣で衣装の性器部分を少しずらして挿入する形でお願いします\n竿側に求められて着衣でさせてくれる設定でお願いします\n可能であればそれっぽいセリフ、擬音有りでお願いします\n修正は線,モザイク切り替えられる形か線でお願いします\n可能でしたら奥まで細いタイプの断面図(下記のようなの)を表示非表示できる形で余白にお願いします\nhttps://www.pixiv.net/artworks/116253244\n胸の大きさは控え目(下記の位)でお願いします\nhttps://www.pixiv.net/artworks/114542662\n\n可能でしたら下記の差分もお願いします\n股布をずらす前(股間を見せて誘惑中,竿等無し)\n竿先端で衣装越しに股間を擦って前戯\n股布がずれて性器が見えてる(竿を性器に近づける)\n竿先端を性器に当てる\n挿入途中\n奥に到達\n膣内の感触を堪能させながらピストン要求\nピストン中\n中出し直前\n中出し(精液は外に出さないで膣の奥で射精)\n咲夜が満足するまで繋がったまま余韻中\n竿抜き出し中\n竿先端が性器から出る\n竿が糸を引きながら性器から離れる\n事後(性器から精液が少し出てくる)", "created_at": "", "completed_at": ""}, {"path": "/@gunbata_st/works/638", "thumbnail_src": "https://si.imgix.net/48c7848f/uploads/origins/c10488c2-d1e6-49c2-95df-298c73672754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f9e4ec95d4658be511efb84f24a47f", "thumbnail_srcset": "https://si.imgix.net/48c7848f/uploads/origins/c10488c2-d1e6-49c2-95df-298c73672754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f9e4ec95d4658be511efb84f24a47f, https://si.imgix.net/48c7848f/uploads/origins/c10488c2-d1e6-49c2-95df-298c73672754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4984646ae329b6a3020c014df1c5e07a 2x, https://si.imgix.net/48c7848f/uploads/origins/c10488c2-d1e6-49c2-95df-298c73672754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1187bdcb39364e7e62f69f16b01f6566 3x", "genre": "art", "nsfw": true, "body": "こんにちは、依頼させていただきます。\n今回は、以前に描いていただいたクラリス＝フラーナ（https://skeb.jp/requests/1758266）に追加、変更を加えた追加差分という形でお願いします。\n主な内容は、パンツとニーソックスの濡れ状態追加、汚れとエネミーの描写パターン追加、表情や汁差分の追加、前回より細かいレイヤー分け(未統合PSD)になります。\n要望が多く細かいので、金額に見合わない場合や追加差分の範疇を超えている場合はキャンセルしていただいても大丈夫です。\n\nパンツ・ニーソックス(濡れ無しと濡れ状態の2パターン)\n・濡れ無し、前回から変更無し\n・濡れ状態、全体がべっとりと濡れて肌に張り付いている\n\n汚れ\n・汚れは薄目と濃い目の2パターンお願いします。金額が厳しい場合はどちらかだけでも構いません\n・パンツとニーソックス、体の何カ所かに汚れを追加。クロッチも汚してもらえると嬉しいです\n・汚れは砂埃をイメージしていますが、どのように描かれるかはお任せします\n\nエネミー追加\n・前回と同じヒトデ型。左胸の乳首と右太腿に一匹づつ追加して下さい\n・サイズ、二匹とも股間のエネミーよりも小さめ\n\nエネミー（股間）の描写パターン追加\n・透け有り、前回と変更なし\n・透け無し、色が完全に透けずに形のみ浮き上がっている。エフェクトも無しでお願いします\n・エネミー無し\n\n表情の追加(前回のメインに別パターンとして追加して下さい)\n・時系列は前回のメインの直前で吸引前\n・エネミーに弄ばれてる事に気づき、悔しそうに強い視線で睨みつけるような表情\n\n汁差分（前回の差分4に追加する形でお願いします。NGの場合は無視して下さい）\n・失禁している差分をお願いします\n・色は無色透明で水とほとんど変わらない\n・一気に噴き出しているのではなく、ちょろちょろと垂れ流しているイメージ\n\nレイヤーは色々と組み合わせを試したいので、より細かく分けた未統合PSDでお願いします。\n・表情(眉、目、ハイライト、涙、口、唾液、汗をそれぞれ別々に)\n・エネミー(左乳首、右胸、左腕、左太腿、右太腿、股間をそれぞれ別々に)\n・パンツ(濡れ無し、濡れ有り)\n・ニーソックス(濡れ無し、濡れ有り)\n・汚れ(薄目、濃い目を別々に)\n・愛液の染み\n・汁(愛液、失禁)\n・全てが厳しい場合は、上から順に可能な範囲でお願いします\n\n要望は以上になります。ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@gunbata_st/works/637", "thumbnail_src": "https://si.imgix.net/7c8963c3/uploads/origins/04418fc4-0516-4d59-9642-5070bcd7d503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4252a528dad7b76220a4152946c9a3a3", "thumbnail_srcset": "https://si.imgix.net/7c8963c3/uploads/origins/04418fc4-0516-4d59-9642-5070bcd7d503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4252a528dad7b76220a4152946c9a3a3, https://si.imgix.net/7c