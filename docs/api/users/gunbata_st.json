fdeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e40e2f84a60512998e80a8ad7696b026 2x, https://si.imgix.net/5c961ccd/uploads/origins/ee41f443-38a9-4706-90f1-cde0ed5cfdeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=949556ed971df4c97e7bb2176dde6728 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gunbata_st/works/658", "thumbnail_src": "https://si.imgix.net/4b100972/uploads/origins/ddd842b4-6782-487f-b3ae-0f777d0c8f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f30b04a53c3f2cc37f15201c4eb3377", "thumbnail_srcset": "https://si.imgix.net/4b100972/uploads/origins/ddd842b4-6782-487f-b3ae-0f777d0c8f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f30b04a53c3f2cc37f15201c4eb3377, https://si.imgix.net/4b100972/uploads/origins/ddd842b4-6782-487f-b3ae-0f777d0c8f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4971ae8697bc1ad222db151884e1960e 2x, https://si.imgix.net/4b100972/uploads/origins/ddd842b4-6782-487f-b3ae-0f777d0c8f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57f80401e88c11e67d1d5403f7f7adf3 3x", "genre": "art", "nsfw": true, "body": "どうも、tirasiさん。\n今回はスターグラディエイター2からカエデというキャラを以下の内容でイラスト2点お願いします。\n\nカエデ↓\nhttps://static.wikia.nocookie.net/capcomdatabase/images/0/04/PlasmaKaede.png/revision/latest?cb=20091027202415\nhttps://youtu.be/sLTg_scQUmw?si=66cV3uf0dOJTFgJx (海外版)\nhttps://twitter.com/tachi1856/status/1520245403828224002?t=beU74mDjmivxPT4eIOJ5dg&s=19\n･下着は下記の画像の様な際どいハイレグのフンドシで。↓\nhttps://www.pixiv.net/artworks/5763238\n\n内容:賞金首に挑み、敗北してしまうカエデ\n\n1.ハンマー担いで余裕ぶった表情のカエデ\n･ミニスカ着物からフンドシがチラリと見えるアングルで、ハンマーを担いだカエデの立ち絵を描いて下さい。\n･セリフ↓\nカエデ「アンタらが例の賞金首かい？」「見た所、アタイの敵じゃないね。ちゃちゃっと行くよ!!」\n\n2.敗北して倒れているカエデ\n･下記の画像の様な形で脚を大きく開いてフンドシ丸見えで、悶えた表情で倒れているカエデを描いて下さい。また、体全体が見える様にお願いします。↓\nhttps://pbs.twimg.com/media/GpoAHjZa0AEcrJF?format=jpg&name=large\n･差分で賞金首（手のみ）に胸を揉まれ、指でフンドシの股布をズラされマ◯コを露わにされて「イヤァ!!」と泣きながら怯えるカエデもお願いします。\n･セリフ↓\n賞金首1「手こずらせやがって、くノ一のガキが。」\n賞金首2「忍びのクセにデカいハンマーなんか振り回しやがってよ。」\n･セリフ（差分）↓\n賞金首1「しっかし、ガキのクセにくノ一だけあってスケベな格好してやがるな。」\n賞金首2「お〜🎶、綺麗な色してんじゃん。♥　このまま犯（や）っちまわね？」\nカエデ「い、イヤァァァァ!!」\n\n以上でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gunbata_st/works/657", "thumbnail_src": "https://si.imgix.net/c600c820/uploads/origins/9c8f10c1-030e-4aab-b8ba-4ff20d9924bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a73efc3bbe8c34c2e51623a5ad93f2f7", "thumbnail_srcset": "https://si.imgix.net/c600c820/uploads/origins/9c8f10c1-030e-4aab-b8ba-4ff20d9924bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a73efc3bbe8c34c2e51623a5ad93f2f7, https://si.imgix.net/c600c820/uploads/origins/9c8f10c1-030e-4aab-b8ba-4ff20d9924bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=880731424a9ae5faa55ef07ed3374a10 2x, https://si.imgix.net/c600c820/uploads/origins/9c8f10c1-030e-4aab-b8ba-4ff20d9924bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1078955689b8fe61a5d3285459236e97 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nまたリクエストさせて頂きます。\n\n\n<キャラ>\n『ファイナルファンタジー7(リバース)』より「プリシラ」\n\n<シチュエーション>\nプリシラのパンチラ(モロ)イラストをお願いします。ゲーム中ではショートパンツを穿いていますが、白パンティでお願いします。パレオがまくれ上がってパンティが見えてしまっている感じです。\n・プリシラは元気そうな笑顔を浮かべています。パンチラは気づいていないor気にしていないという感じです。\n・ポーズやアングルはお任せします。\n\n\n以上です。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1TbGGO49DKQMI4WRD6hJcdoeP9DmJmBkz?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@gunbata_st/works/656", "thumbnail_src": "https://si.imgix.net/04b904ed/uploads/origins/941eec1e-7a81-45d5-b911-0545930f2a11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s