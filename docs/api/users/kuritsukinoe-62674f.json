2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d6ad47a81fff2f73a5932da65ab0c39 2x, https://si.imgix.net/fb2ef6b7/uploads/origins/9ebd0971-c171-4a96-b6f4-8965b5b83398?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f396e4860a7aa4e2683d8dd38182bb89 3x", "genre": "art", "nsfw": false, "body": "こんにちは。youtubeやその他のソーシャルメディアで私のアバターとして使用するためのアートワークをお願いしたいと思っています。私は21歳の女性で、肩までの長さの茶色の髪にサイドに前髪があり、青い目をしていて、普段はパンツに「セリーズ」色のフード付きジャケットを着ています。その他のアクセサリーや服は、信頼できる芸術家の方にお任せします。表情や位置については、できれば生意気だったり奇抜だったりしてほしいですね。誰かが何かを企んでいて、でも楽しんでいるという顔です。\n\n申し訳ありませんが、参考となる写真はまだありません。でも、あなたがどんな作品を作ってくれるのか楽しみにしています。", "created_at": "", "completed_at": ""}, {"path": "/@kuritsukinoe/works/6", "thumbnail_src": "https://si.imgix.net/faa9eed4/uploads/origins/3219ddbc-be18-4b1b-8eaf-c024fc158cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a547a1109d995006ba1576787b51945", "thumbnail_srcset": "https://si.imgix.net/faa9eed4/uploads/origins/3219ddbc-be18-4b1b-8eaf-c024fc158cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a547a1109d995006ba1576787b51945, https://si.imgix.net/faa9eed4/uploads/origins/3219ddbc-be18-4b1b-8eaf-c024fc158cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca3ab7a0079bac5830945727fe26c917 2x, https://si.imgix.net/faa9eed4/uploads/origins/3219ddbc-be18-4b1b-8eaf-c024fc158cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20e1467371e4981ec346ba6fb439110c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のキャラクター「Milreaf」に興味を持っていただき、ありがとうございます。\n\nhttps://toyhou.se/117016.milreaf-nakamura/gallery\n\n氷の魔女で、恋の薬を作るために薬屋の勉強をしています。夜はホストガールをして実験費用を稼いでいます。\n\nポーズとしては、お客さんに胸の谷間を見せるために屈んでいる姿（画面外）がいいかもしれません。その他はご自由にお描きください。\n\n注意すべき点は\n彼女は常に白い手袋をしていて、ホストガールの衣装では肘から先が白い。\n胸が大きく、だいたいHカップ以上あります。\n\nもしよろしければ、チビもお願いします。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kuritsukinoe/works/5", "thumbnail_src": "https://si.imgix.net/3951875e/uploads/origins/09be00fa-a1e4-4e44-bc1e-7b5e58e7e257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea14df517186638e827164c1902dfc1a", "thumbnail_srcset": "https://si.imgix.net/3951875e/uploads/origins/09be00fa-a1e4-4e44-bc1e-7b5e58e7e257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea14df517186638e827164c1902dfc1a, https://si.imgix.net/3951875e/uploads/origins/09be00fa-a1e4-4e44-bc1e-7b5e58e7e257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c22a38a11887481ebd04d95c2820d63f 2x, https://si.imgix.net/3951875e/uploads/origins/09be00fa-a1e4-4e44-bc1e-7b5e58e7e257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f488d3db40af31c5447f4663df66cd4 3x", "genre": "art", "nsfw": false, "body": "Hello. Thank you for your appeal! I would love for you to draw my Vtuber character. If possible, I would like a winter themed picture, but I am fine with anything else too.\nI would like it to be in 16:9 so I can use as a wallpaper.\nIf possible, I would like to use the picture for twitter & twitch as well. Of course, I will credit you as well!\nHere is the link to my character reference.\n\nThank you for your consideration.\n\nhttps://drive.google.com/drive/folders/1vTB2MyyBYYwBRFYBZYnsVozViMa38P3d?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuritsukinoe/works/4", "thumbnail_src": "https://si.imgix.net/559d4731/uploads/origins/9f75b80c-a43f-44b6-8897-b54e47207119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d60caef318c748155b4ddfe5484a4a5", "thumbnail_srcset": "https://si.imgix.net/559d4731/uploads/origins/9f75b80c-a43f-44b6-8897-b54e47207119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d60caef318c748155b4ddfe5484a4a5, https://si.imgix.net/559d4731/uploads/origins/9f75b80c-a43f-44b6-8897-b54e47207119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&