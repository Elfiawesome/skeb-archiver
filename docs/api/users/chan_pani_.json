ix.net/e0e701f9/uploads/origins/0a30d58e-a7bc-41f8-95fd-489ee18e0ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e784706d1949dc5963ccaa479fdfa6a6", "thumbnail_srcset": "https://si.imgix.net/e0e701f9/uploads/origins/0a30d58e-a7bc-41f8-95fd-489ee18e0ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e784706d1949dc5963ccaa479fdfa6a6, https://si.imgix.net/e0e701f9/uploads/origins/0a30d58e-a7bc-41f8-95fd-489ee18e0ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51448a763c65c5c0683ce480bee3efb2 2x, https://si.imgix.net/e0e701f9/uploads/origins/0a30d58e-a7bc-41f8-95fd-489ee18e0ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ea08646bfe92e044b66e4e4ad9ae246 3x", "genre": "art", "nsfw": false, "body": "お世話になってます。\nスモックよしのんのイラストをお願いします。\n特にその他に指定はございません。\nよろしければお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chan_pani_/works/35", "thumbnail_src": "https://si.imgix.net/2a769b63/uploads/origins/a8cfffbf-c16e-4f4d-b98f-e3d72fca3bff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc1b0067d3956f51de63e808fe83c7e", "thumbnail_srcset": "https://si.imgix.net/2a769b63/uploads/origins/a8cfffbf-c16e-4f4d-b98f-e3d72fca3bff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc1b0067d3956f51de63e808fe83c7e, https://si.imgix.net/2a769b63/uploads/origins/a8cfffbf-c16e-4f4d-b98f-e3d72fca3bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96fd62241ae9ed500706798ca00f805d 2x, https://si.imgix.net/2a769b63/uploads/origins/a8cfffbf-c16e-4f4d-b98f-e3d72fca3bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e14e313c0a1c3923edae1a755f14a57 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\nリクエスト募集中でしたので失礼します。\n\nパジャマジャマのSR特訓後のパジャマ衣装のよしのんのイラストをお願いします。\n構図等はおまかせします。\n\nよろしければお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chan_pani_/w