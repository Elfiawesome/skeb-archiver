uploads/origins/b4024844-ef99-4019-94b8-efe6760a1105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de8019bb51d6c2ece1c23aaf9b0d41e0 3x", "genre": "art", "nsfw": true, "body": "飛来ボデーさんこんにちは。\nリクエストお願いします。\n飛来ボデーさんが描いている「黒霧島」とダンまちに登場する「デメテル」のイラストをお願いします。\n内容は、デメテルが背の高い黒霧島を見て、「(この人とても大きいわぁ〜)」と見上げ、この時黒霧島は、「(身長の割に、凄い物を持ってるな…)」と胸を見て思う。　という内容です。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@goumonsha/works/14", "thumbnail_src": "https://si.imgix.net/4288a240/uploads/origins/41135991-8b53-40d2-b51a-0f89e885c57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=075bbe6d3cb6a82d0ac2e65f1b909f26", "thumbnail_srcset": "https://si.imgix.net/4288a240/uploads/origins/41135991-8b53-40d2-b51a-0f89e885c57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=075bbe6d3cb6a82d0ac2e65f1b909f26, https://si.imgix.net/4288a240/uploads/origins/41135991-8b53-40d2-b51a-0f89e885c57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7cca40469e15dd7f94967e686859de2 2x, https://si.imgix.net/4288a240/uploads/origins/41135991-8b53-40d2-b51a-0f89e885c57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b479b774c9dae5e6aa5a329e5e329b2c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@goumonsha/works/13", "thumbnail_src": "https://si.imgix.net/48257971/uploads/origins/c428bc75-bed5-4095-a7df-a277ceda57af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%