ize=30&txt=PRIVATE&s=aea04587368b34648284277ff526e61d 2x, https://si.imgix.net/99d98164/uploads/origins/3e5a00c5-13b7-4250-b26d-1c717703c98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de95d5d9e62895982937f9e1ed41e51 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nonbirireo/works/7", "thumbnail_src": "https://si.imgix.net/dde7ad4e/uploads/origins/0c96e470-d330-404e-ad9f-76bb8e56ba24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874cb3aa405ed7ec3543269f124ea87d", "thumbnail_srcset": "https://si.imgix.net/dde7ad4e/uploads/origins/0c96e470-d330-404e-ad9f-76bb8e56ba24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874cb3aa405ed7ec3543269f124ea87d, https://si.imgix.net/dde7ad4e/uploads/origins/0c96e470-d330-404e-ad9f-76bb8e56ba24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5959f16c0780c87fe959c941dc9eaf01 2x, https://si.imgix.net/dde7ad4e/uploads/origins/0c96e470-d330-404e-ad9f-76bb8e56ba24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1cf7b6633fa463474ae76a94216dba1 3x", "genre": "art", "nsfw": true, "body": "私のキャラクターを描くことを楽しんでください\n最終的にどのような作品になるかは、あなたが描いてくれたものであれば気にしません\n\n\nキャラクターの参考画像\nhttps://drive.google.com/drive/folders/1mOZfMxqD--hJv-wv4--QtomM2pNc6WT1\n\nhttps://drive.google.com/drive/folders/1mOZfMxqD--hJv-wv4--QtomM2pNc6WT1", "created_at": "", "completed_at": ""}, {"path": "/@nonbirireo/works/6", "thumbnail_src": "https://si.imgix.net/2f7b704f/uploads/origins/d2ad6ff7-a2bd-483d-8f60-305fbee5883d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27e52deda69199cc53943730e0dc3a68", "thumbnail_srcset": "https://si.imgix.net/2f7b704f/uploads/origins/d2ad6ff7-a2bd-483d-8f60-305fbee5883d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27e52deda69199cc53943730e0dc3a68, https://si.imgix.net/2f7b704f/uploads/origins/d2ad6ff7-a2bd-483d-8f60-305fbee5883d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa6b9d83e7914ce5857b2797eff69e7d 2x, https://si.imgix.net/2f7b704f/uploads/origins/d2ad6ff7-a2bd-483d-8f60-305fbee5883d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cff6ecf8794762b0736e610f3f8c8e9a 3x", "genre": "art", "nsfw": true, "body": "こんにちは、お先生！\n\nあなたのかわいい画風と色使いが本当に大好きです！\n\n私のVtuberキャラクターは、メイド喫茶で働く悪魔の少年メイドです。あどけない顔をしていますが、とても生意気です。左目は白い瞳孔と黒い強膜があり、右目は普通です。好きなように描いてください。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1IT4T2G5Uv84r2zgVE1xG36hXMJQSX7vZ?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nonbirireo/works/5", "thumbnail_src": "https://si.imgix.net/f7eae94e/uploads/origins/4ce31ebd-83e6-4867-b85b-ee9e9502cfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc02176f66df717607acd361698dcd7", "thumbnail_srcset": "https://si.imgix.net/f7eae94e/uploads/origins/4ce31ebd-83e6-4867-b85b-ee9e9502cfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc02176f66df717607acd361698dcd7, https://si.imgix.net/f7eae94e/uploads/origins/4ce31ebd-83e6-4867-b85b-ee9e9502cfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5433f8720d8c838aaa82692c509c8ff9 2x, https://si.imgix.net/f7eae94e/uploads/origins/4ce31ebd-83e6-4867-b85b-ee9e9502cfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1534722d0a0ccafadc1cb3e107083084 3x", "genre": "art", "nsfw": false, "body": "こんにちはれおくん！\nレオくんのアートワークは最近、彼が描くかわいい状況やキャラクターで私をとても魅了しているので、ついに彼をサポートするために次のステップに進むことにしました。そして、この機会を得られたことを本当に嬉しく思います！\n僕のOC、ラウクンを幼稚園児の制服で描いていただきたいと思います。彼は優しくて優しい少年ですが、抜け目なくいたずら好きです\nイラストでは、ラウクンはベッドに横たわり、恥ずかしがり屋のポーズで胸に手を握り、頬を少し赤らめて見る人に優しく微笑んでいます\nイラストの 2 番目のバリエーションでは、ラウクンがショートパンツを履かず、おむつを見せ、あたかも自分がまだ赤ちゃんであるかどうか質問されているかのように、その状況にかなり恥ずか