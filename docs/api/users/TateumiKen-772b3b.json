fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32cb62b073ba39a7cac46bf318eb9611 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\n\n鬼っ子ハンターついなちゃんの「ついなちゃん」をお願いいたします。\n\n全裸で性器を見せつけて誘惑しているイラストです。\n笑顔で誘っている表情でお願いします。\nポーズなどの詳細はお任せします。\n\n差分として、中出しされて精液が垂れているのをお願いします。\nこちらは気持ちよくて満足している表情です。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@TateumiKen/works/113", "thumbnail_src": "https://si.imgix.net/c2857a9f/uploads/origins/e8e63e06-edbc-4723-b10b-f9bb7ae6bc2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc27217f77b799af362700e8517f0164", "thumbnail_srcset": "https://si.imgix.net/c2857a9f/uploads/origins/e8e63e06-edbc-4723-b10b-f9bb7ae6bc2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc27217f77b799af362700e8517f0164, https://si.imgix.net/c2857a9f/uploads/origins/e8e63e06-edbc-4723-b10b-f9bb7ae6bc2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33096d3b2a84133058eed3271304d521 2x, https://si.imgix.net/c2857a9f/uploads/origins/e8e63e06-edbc-4723-b10b-f9bb7ae6bc2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db5af90abab1d373fd0a3101040a3955 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TateumiKen/works/112", "thumbnail_src": "https://si.imgix.net/56b35b59/uploads/origins/c002f2b1-99dd-4922-a95a-b62fbed40097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8abf7324a00e71311cdb5d676169400", "thumbnail_srcset": "https://si.imgix.net/56b35b59/uploads/origins/c002f2b1-99dd-4922-a95a-b62fbed40097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8abf7324a00e71311cdb5d676169400, https://si.imgix.net/56b35b59/uploads/origins/c002f2b1-99dd-4922-a95a-b62fbed40097?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82b319046fb871e9d7d515e8674dac51 2x, https://si.imgix.net/56b35b59/uploads/origins/c002f2b1-99dd-4922-a95a-b62fbed40097?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abb6689dd5038f66d8e7cea5e2f89891 3x", "genre": "art", "nsfw": true, "body": "初めまして、可愛いキャラやくぱぁと広げている構図のイラストをよく描かれていて好みだったので依頼を出させて頂きました。\n\n今回の依頼内容ですが、FGOという作品のメリュジーヌというキャラで女性器を自らくぱぁと広げている内容でお願いします。\n構図はこちらにて描かれたイラストをイメージしております。https://www.pixiv.net/artworks/139399922\n\n衣服は何もつけていない状態で、もし可能でしたら尿道が見える感じですと助かります！\n\nもし上記の内容で大丈夫でしたらよろしくお願いします。\n\nURLは渋の百科事典となっております\nキャラ百貨\nhttps://dic.pixiv.net/a/%E3%83%A1%E3%83%AA%E3%83%A5%E3%82%B8%E3%83%BC%E3%83%8C(Fate)", "created_at": "", "completed_at": ""}, {"path": "/@TateumiKen/works/111", "thumbnail_src": "https://si.imgix.net/d1e44753/uploads/origins/85c0cb8b-7a43-4373-af0c-b20f6e119bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b85ae4bff454682a343ed2dff1b5fb", "thumbnail_srcset": "https://si.imgix.net/d1e44753/uploads/origins/85c0cb8b-7a43-4373-af0c-b20f6e119bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b85ae4bff454682a343ed2dff1b5fb, https://si.imgix.net/d1e44753/uploads/origins/85c0cb8b-7a43-4373-af0c-b20f6e119bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=630431bcd458dcbabcd7df843faca2d4 2x, https://si.imgix.net/d1e44753/uploads/origins/85c0cb8b-7a43-4373-af0c-b20f6e119bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21aca9518752616facb86f49e32a827b 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。  レジェンドクローバーのアポロを描いていただけませんか？  主人公とラブラブなセックスをしてほしいです。  胸とアソコが露出していれば、どの衣装でも全裸でも構いません。  セックスの体位は正常位。  アソコを広げてほしい。  彼女は満面の笑みを浮かべている。  イクときは潮を吹いてほしい。  ありがとうございました！\n\nhttps://legeclo.wikiru.jp/?%E3%82%A2%E3%83%9D%E3%83%AD%E3%83%B3", "created_at": "", "completed_at": ""}, {"path": "/@TateumiKen/works/110", "thumbnail_src": "https://si.imgix.net/b19fd4e8/uploads/origins/211429f0-861c-4df0-a94e-3fedb5f10d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6a3213716f1cd775651c658249ea48", "thumbnail_srcset": "https://si.imgix.net/b19fd4e8/uploads/origins/211429f0-861c-4df0-a94e-3fedb5f10d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6a3213716f1cd775651c658249ea48, https://si.imgix.net/b19fd4e8/uploads/origins/211429f0-861c-4df0-a94e-3fedb5f10d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8bab6f0d436ddf0f7accf8ce561b744 2x, https://si.imgix.net/b19fd4e8/uploads/origins/211429f0-861c-4df0-a94e-3fedb5f10d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5eaa014f84bf3a0fd0540270b99210bd 3x", "genre": "art", "nsfw": true, "body": "縦海けん様\n\n初めまして、いつも先生の絵柄の素敵な絵を拝見させていただいております。\nこの度是非先生の絵で最愛の推し絵を描いていただきたく参りました。\n\n早速内容で恐縮ですが、\n\n\n作品・キャラ：リトルバスターズ!EXより、二木佳奈多（ご参考URL：https://dic.pixiv.net/a/%E4%BA%8C%E6%9C%A8%E4%BD%B3%E5%A5%88%E5%A4%9A）\n\nシチュエーション：ベッドの上で座る佳奈多の局部を優しく手でいじっている状況。\n\n服装：公式制服で胸元ははだけて開けていてブラジャーをずらす形、スカートはめくれてパンツは足に掛かっている状態の佳奈多の局部を手で開いていじる様子。\n\n構図：M字開脚で座っている佳奈多を真正面から見た視点、もしくは男子の一人称視点で、色白、もしくは半透明の手・腕のみの描写。\n\n表情：柔和な笑顔で感じている状態。\n\n差分等：可能であれば陰毛（髪と同じ色）の差分と、絶頂している状態の表情、場合によっては潮吹き可能ならお願いしたいです。\n\n\n以上となります。\n分かりづらく長くなってしまい申し訳ありません。\nご縁がありましたらよろしくお願いいたします。\n\n今後とも先生を応援していく所存です。", "created_at": "", "completed_at": ""}, {"path": "/@TateumiKen/works/109", "thumbnail_src": "https://si.imgix.net/97140f4f/uploads/origins/f9c30807-5a94-43dc-afca-865e3be47793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=272297991f1d6b3e9875b992b8dbd69f", "thumbnail_srcset": "https://si.imgix.net/97140f4f/uploads/origins/f9c30807-5a94-43dc-afca-865e3be47793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=272297991f1d6b3e9875b992b8dbd69f, https://si.imgix.net/97140f4f/uploads/origins/f9c30807-5a94-43dc-afca-865e3be47793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d2bd0a2b6b400e854384420be3aa2e2 2x, https://si.imgix.net/97140f4f/uploads/origins/f9c30807-5a94-43dc-afca-865e3be47793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a20b71239c9e5a5acc1f91ea65c15374 3x", "genre": "art", "nsfw": true, "body": "もしよろしければ、私のエルフの弓使いも描いていただけませんか？\n\n前と同じシチュでお願いします。うちの子が悪い人たちに捕まって、おまんこを開かれているシチュでお願いします。\nhttps://skeb.jp/@TateumiKen/works/97\n手の指を何本も使って、思いっきりこじ開けるように広げてください。遠慮しないでください。こういうの、本当に好きです。\nまた、子宮口がはっきり見えるようにしていただきたいです。できれば、子宮口から精液があふれ出てくるところ差分もお願いします。\n白いパンツずらしてください。愛液をたくさん描いてください。修正は黒海苔でお願いします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ZF9Q5UILIVZCHWEbYdbYpS33M8qvkHIX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@TateumiKen/works/108", "thumbnail_src": "https://si.imgix.net/5b40f120/uploads/origins/7e4adff6-7f32-43ce-9c12-df28deea9ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c27f9720617600cc05780e1f78cd75ce", "thumbnail_srcset": "https://si.imgix.net/5b40f120/uploads/origins/7e4adff6-7f32-43ce-9c12-df28deea9ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c27f9720617600cc05780e1f78cd75ce, https://si.imgix.net/5b40f120/uploads/origins/7e4adff6-7f32-43ce-9c12-df28deea9ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c1f6d1888525a1982cb9cfc94ed4bfa 2x, https://si.imgix.net/5b40f120/uploads/origins/7e4adff6-7f32-43ce-9c1