google.com/drive/folders/1-52G7v8xut0uqZxXDcP9JK4RFwLvGj01\n\n\n不明な箇所は捏造してしまって大丈夫です。これからもご活動を影から応援しております。頑張ってください！\nよろしくお願い致します！！", "created_at": "", "completed_at": ""}, {"path": "/@sakiamaikas/works/14", "thumbnail_src": "https://si.imgix.net/171a8656/uploads/origins/59e563ee-63e9-414b-87b7-4ec1e25b5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e30431e7857b639d5f9fdbc6036db7a", "thumbnail_srcset": "https://si.imgix.net/171a8656/uploads/origins/59e563ee-63e9-414b-87b7-4ec1e25b5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e30431e7857b639d5f9fdbc6036db7a, https://si.imgix.net/171a8656/uploads/origins/59e563ee-63e9-414b-87b7-4ec1e25b5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f46aca44344b1616fbd92a1c7bd7760d 2x, https://si.imgix.net/171a8656/uploads/origins/59e563ee-63e9-414b-87b7-4ec1e25b5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a920a9dedf9bea079c09b378c31cbc02 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakiamaikas/works/13", "thumbnail_src": "https://si.imgix.net/aa8e9595/uploads/origins/f5a0354b-33ea-4b38-8724-c92622ec82de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d877b97c51b9180e712c2dc53ae3a48", "thumbnail_srcset": "https://si.imgix.net/aa8e9595/uploads/origins/f5a0354b-33ea-4b38-8724-c92622ec82de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&tx