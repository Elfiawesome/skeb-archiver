d_at": ""}, {"path": "/@nekotowakaisita/works/32", "thumbnail_src": "https://si.imgix.net/15c8df44/uploads/origins/421370df-623d-43bb-b4da-1993cfeddbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6a8d91bce780a8f13b00a10fa3ee592", "thumbnail_srcset": "https://si.imgix.net/15c8df44/uploads/origins/421370df-623d-43bb-b4da-1993cfeddbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6a8d91bce780a8f13b00a10fa3ee592, https://si.imgix.net/15c8df44/uploads/origins/421370df-623d-43bb-b4da-1993cfeddbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a14be6e0573a1b4753401083cb78834 2x, https://si.imgix.net/15c8df44/uploads/origins/421370df-623d-43bb-b4da-1993cfeddbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3917c0c5cd4af91439085ec9baa1a3ed 3x", "genre": "art", "nsfw": false, "body": "こんにちは、FEのソフィアとニニアンが一緒に写っている写真をリクエストしてもいいですか？ポーズや設定は自由に決めていただいて構いません。二人ともかなり内向的で控えめなキャラクターなので、表情は冷静沈着、メランコリックなどのままでお願いしたいです。ご検討よろしくお願いします。\nhttps://fireemblemwiki.org/w/images/d/d0/FEH_Ninian_01.png\nhttps://www.pixiv.net/en/artworks/69020174", "created_at": "", "completed_at": ""}, {"path": "/@nekotowakaisita/works/31", "thumbnail_src": "https://si.imgix.net/41d8155e/uploads/origins/ae9b5843-f857-4535-87d9-b0d233e16559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db7bd63b7023fe74d8b6f5580046ff4", "thumbnail_srcset": "https://si.imgix.net/41d8155e/uploads/origins/ae9b5843-f857-4535-87d9-b0d233e16559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db7bd63b7023fe74d8b6f5580046ff4, https://si.imgix.net/41d8155e/uploads/origins/ae9b5843-f857-4535-87d9-b0d233e16559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=904f859586421429f8f0ee403dd9161f 2x, https://si.imgix.net/41d8155e/uploads/origins/ae9b5843-f857-4535-87d9-b0d233e16559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w