completed_at": ""}, {"path": "/@sayoselene/works/24", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c89e5bd08ca809d513bf24a3e1870e7", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c89e5bd08ca809d513bf24a3e1870e7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c786ade3419aa5d8efa3d8ec4128e43 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70eb41df590cc4565692f793206a3990 3x", "genre": "voice", "nsfw": false, "body": "ねぇ、明日空が落ちてきて、全てが終わるとしたらどうする？\nわかった、似合わないかも知れないけど\nその時は僕はきみのために希望を歌う人になるよ", "created_at": "", "completed_at": ""}, {"path": "/@sayoselene/works/23", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34e4ccf000bac59a88b1af5e4792198e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34e4ccf000bac59a88b1af5e4792198e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=