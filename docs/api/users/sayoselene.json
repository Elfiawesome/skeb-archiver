F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=502308e2b7c5a809b016ff62dc02097e 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sayoselene/works/40", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c89e5bd08ca809d513bf24a3e1870e7", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c89e5bd08ca809d513bf24a3e1870e7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c786ade3419aa5d8efa3d8ec4128e43 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70eb41df590cc4565692f793206a3990 3x", "genre": "voice", "nsfw": false, "body": "DAMチャンネル（権利的にまずい場合は変更可）をご覧の皆様、こんにちは！バーチャル表現者の小夜セレネです！ところで、『小夜セレネ』って名前に『夜』が入っているのに『こんにちは！』って変だと思いませんか？やっぱり挨拶やり直しますね！\n\nということで、改めまして、DAMチャンネル（権利的にまずい場合は変更可）をご覧の皆様、こんばんは！バーチャル表現者の小夜セレネです！ただ今、1st original song の『永音』がYouTubeにて公開中！是非聴いてみてくださいね！それでは！\n\nえ？尺余りました？うーん、でもこんなに少ない待ち時間で曲について語るとか、全然無理なんで……（笑）まあ、その辺はぼくのチャンネルにある配信アーカイブとか観てください（笑）はい（笑）じゃ、今度こそ、それでは！（笑）", "created_at": "", "completed_at": ""}, {"path": "/@sayoselene/works/39", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c89e5bd08ca809d513bf24a3e1870e7", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c89e5bd08ca809d513bf24a3e1870e7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c786ade3419aa5d8efa3d8ec4128e43 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70eb41df590cc4565692f793206a3990 3x", "genre": "voice", "nsfw": false, "body": "「時間だけど、出なくていいの？」\n「……そう？  まあどっちでもいいけど知らないよー」\n\n1文目は前日に明日早く出掛けなければならないと聞いていたためセレネ氏が早く起きて確認してみると、時間になっても起きていなかったため「まあ起こしてあげるか」ぐらいの気楽さでお願いします。\n1文目と2文目の間は寝ている方がうだうだ言ってるのを聴き流している感じで、おおよそ3~4秒程度の間を取っていただけると嬉しいです。\n2文目ではせっかく起こしてあげたのにまだなんか言ってるわ的な若干のイラつきや呆れなども含まれると思います。しかし、あくまでも言外に滲む程度であり、態度や口調そのものにほとんど表出しない様にお願いいたします。\nまた、方言･標準語･口癖などもございますので、自然に読んだ際「そう？」よりも「そ？」に近いであったり、「知らないよー」より「知らないよ？」の方が気楽などありましたら是非改変していただけますと幸甚の極みであります。\n\n依頼期間の最終日での依頼となってしまい恐れ入りますがどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sayoselene/works/38", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34e4ccf000bac59a88b1af5e4792198e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962599171086786562%2Fk1QqO0_T.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34e4ccf000bac59a88b1af5e4792198e, https://sk