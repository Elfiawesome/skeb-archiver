mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7e7f841d1533536163a3b3e11da8fa5 2x, https://si.imgix.net/0ac0f0b1/uploads/origins/0758b7c0-56d0-4cde-bc92-793b1d4b061e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e8ac7de970d52f706e39b2549f1815c 3x", "genre": "art", "nsfw": false, "body": "いつも大変お世話になっております\n\nイラストのご依頼を恐縮ながらお願いいたします。\n\n以前拝見いたしました\n「ごいみなさんのお出かけ」\nをお手すきの際にで構いませんがお願いできますでしょうか\n\nお忙しい中とは存じますがよろしくお願いいたします。\n\n追記　先日は大変失礼いたしました", "created_at": "", "completed_at": ""}, {"path": "/@sowra_rakugaki/works/29", "thumbnail_src": "https://si.imgix.net/e5c186d8/uploads/origins/c120149c-2987-4ff8-9c0e-f16849aaff07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d01f9a0b710a1c6eadc8fa12161ac6f6", "thumbnail_srcset": "https://si.imgix.net/e5c186d8/uploads/origins/c120149c-2987-4ff8-9c0e-f16849aaff07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d01f9a0b710a1c6eadc8fa12161ac6f6, https://si.imgix.net/e5c186d8/uploads/origins/c120149c-2987-4ff8-9c0e-f16849aaff07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=667c81f0617aff388cea92a729c4b826 2x, https://si.imgix.net/e5c186d8/uploads/origins/c120149c-2987-4ff8-9c0e-f16849aaff07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6d21c0425252ffaad6844b8ac005d9f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回(https://skeb.jp/@sowra_rakugaki/works/28)は素晴らしいイラストをありがとうございました。再び依頼させて頂きたくおもいます。\n\n今回の内容につきましては、彼女の日常をテーマに一作お願いできないでしょうか。\n\nご検討頂けますと幸いです。よろしくお願い致します！\n\nhttps://www.dropbox.com/scl/fo/2m25a2gk58pelinr4k58h/h?rlkey=bjj7dkhjx05ytm0776sv00vyd&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sowra_rakugaki/works/28", "thumbnail_src": "https://si.imgix.net/0996a94f/uploads/origins/ff0be5ff-70c8-4f3a-a083-b78da9238c41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f222dd644b7afc9c80e16290a12ad3", "thumbnail_srcset": "https://si.imgix.net/0996a94f/uploads/origins/ff0be5ff-70c8-4f3a-a083-b78da9238c41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f222dd644b7afc9c80e16290a12ad3, https://si.imgix.net/0996a94f/uploads/origins/ff0be5ff-70c8-4f3a-a083-b78da9238c41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6386c075e7b5d3652853793685e78830 2x, https://si.imgix.net/0996a94f/uploads/origins/ff0be5ff-70c8-4f3a-a083-b78da9238c41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=965dbf3449be8a6213c8c12fa78f26a1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n以前、オリキャラのおしがまイラストを依頼した者です。その節はありがとうございました。『こんな時だけ外れない』ベルトや、紙切れとなり床に転がるトイレットペーパーの芯などなど、うちの子の不運体質を体現して頂いた素晴らしいイラストでした。\n期間が空いてしまったところにいきなりで恐縮なのですが、再び依頼させて頂いてもよろしいでしょうか？\n\nさて、今回ですが『満員電車の中で周りの客の傘か何かがジーンズのポケットなりベルトなりに引っかかりそのままずり落ちる→慌てるうちの子。しかし、満員故に身動きが取れずパンツが丸見えの状態でそのまま居る羽目に(一応周りには気付かれていない)』といった内容でお願いしたく思います。\n前回はベルトが外れず可哀想な目に遭っておりましたが、今回はベルトが仕事を果たさずに可哀想な目に遭うという事でひとつ……。また、更に贅沢な要望を承知で申し上げますと、脱げる前と後が分かる様な感じで仕上げて頂けますと大変ありがたく……。\n\nご検討頂けますと幸いです。よろしくお願い致します！\n\nhttps://www.dropbox.com/scl/fo/2m25a2gk58pelinr4k58h/h?rlkey=bjj7dkhjx05ytm0776sv00vyd&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sowra_rakugaki/works/27", "thumbnail_src": "https://si.imgix.net/eefb2f4c/uploads/origins/724124ab-ecd6-476a-b163-5f1873bc75f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b3d23331da659c64686bbce48d58bd3", "thumbnail_srcset": "https://si.imgix.net/eefb2f4c/uploads/origins/724124ab-ecd6-476a-b163-5f1873bc75f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b3d23331da659c64686bbce48d58bd3, https://si.imgix.net/eefb2f4c/uploads/origins/724124ab-ecd6-476a-b163-5f1873bc75f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=578c7a39f9b606b79815aca70595cf92 2x, https://si.imgix.net/eefb2f4c/uploads/origins/724124ab-ecd6-476a-b163-5f1873bc75f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0921863c8e8e8de57050c5a910af4e82 3x", "genre": "art", "nsfw": true, "body": "でんこの東海なな\n・スレンダー体形\n・イチャイチャ処女喪失\n上記でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sowra_rakugaki/works/26", "thumbnail_src": "https://si.imgix.net/7121a1ee/uploads/origins/4f02852a-8276-4c1b-9e16-5e43a76434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99c5d4cca6e1627028eaaad9ee487af8", "thumbnail_srcset": "https://si.imgix.net/7121a1ee/uploads/origins/4f02852a-8276-4c1b-9e16-5e43a76434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99c5d4cca6e1627028eaaad9ee487af8, https://si.imgix.net/7121a1ee/uploads/origins/4f02852a-8276-4c1b-9e16-5e43a76434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70a161b41a04f5bf784a7fa806bb454a 2x, https://si.imgix.net/7121a1ee/uploads/origins/4f02852a-8276-4c1b-9e16-5e43a76434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f51518f392caf77f0b3c4aabd12059e5 3x", "genre": "art", "nsfw": false, "body": "いつも作品を拝見しております。\n\n突然のご依頼となりますことお許し下さい。\n是非　ごいみなさんのお出かけ　をテーマに作品をお願い出来ますでしょうか\n\nお忙しい中とは存じますがよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sowra_rakugaki/works/25", "thumbnail_src": "https://si.imgix.net/a73c79d4/uploads/origins/d5272cc1-be58-484a-9afc-a649f31d1fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d19ca299fd594d0b25598375a99c963", "thumbnail_srcset": "https://si.imgix.net/a73c79d4/uploads/origins/d5272cc1-be58-484a-9afc-a649f31d1fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d19ca299fd594d0b25598375a99c963, https://si.imgix.net/a73c79d4/uploads/origins/d5272cc1-be58-484a-9afc-a649f31d1fa6?bg=%23fff&auto=format%2Ccomp