8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8b645630bc6abb410c635b239beb9e, https://si.imgix.net/59e66e70/uploads/origins/33001e32-20b1-4443-936f-28159fc0858f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8efed9f2cff617bae27edfb417541eb 2x, https://si.imgix.net/59e66e70/uploads/origins/33001e32-20b1-4443-936f-28159fc0858f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29ba8fb0353a3ced96a8d8c4d23de312 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風は素晴らしいと思います！私のVTuberの絵をお願いしたいです。彼女は元気でかわいいレースクイーンです。傘や旗を持った彼女を描いてください。チンチラのマスコットも描いてください。\n\nhttps://toyhou.se/13540888.-", "created_at": "", "completed_at": ""}, {"path": "/@ikupom_twi/works/61", "thumbnail_src": "https://si.imgix.net/7310eba1/uploads/origins/9bb4b8f5-7a67-47da-92e1-0b7d4ca591e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=280ef0ee5c58c264488cb676d1d45d44", "thumbnail_srcset": "https://si.imgix.net/7310eba1/uploads/origins/9bb4b8f5-7a67-47da-92e1-0b7d4ca591e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=280ef0ee5c58c264488cb676d1d45d44, https://si.imgix.net/7310eba1/uploads/origins/9bb4b8f5-7a67-47da-92e1-0b7d4ca591e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bc1c4e5f834fe60e12f28c7f49ec8f1 2x, https://si.imgix.net/7310eba1/uploads/origins/9bb4b8f5-7a67-47da-92e1-0b7d4ca591e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0394cdf4b69218a3d6284171b691e8a 3x", "genre": "art", "nsfw": false, "body": "こんばんは、たまさぶろう様のイラストとアスカガが大好きで、いつも楽しく拝見させて頂いています！\n今回、私がPSO2NGSのゲーム内で使用している自キャラのさくらもちをたまさぶろう様の画風で見てみたくご依頼させて頂きます！\n衣装などの資料はURLからご確認いただけたらと思います。\n恋に恋する女の子で、明るく天真爛漫な子です。\nどうぞよろしくお願いします！\n\nhttps://twitter.com/sakura_mochi_19/status/1718611673953734953?t=6h7geK29Ei17oJb35K9Yrw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@ikupom_twi/works/60", "thumbnail_src": "https://si.imgix.net/4023f43b/uploads/origins/7d99f27d-ddd1-40f7-9eab-0d574e932c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21e6b7fd675fbe217b0649d67216a943", "thumbnail_srcset": "https://si.imgix.net/4023f43b/uploads/origins/7d99f27d-ddd1-40f7-9eab-0d574e932c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21e6b7fd675fbe217b0649d67216a943, https://si.imgix.net/4023f43b/uploads/origins/7d99f27d-ddd1-40f7-9eab-0d574e932c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e056db1d29423e9c613b8304607d3cf3 2x, https://si.imgix.net/4023f43b/uploads/origins/7d99f27d-ddd1-40f7-9eab-0d574e932c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=222a84ac09cb3dbb75ee5130c99bdb38 3x", "genre": "art", "nsfw": false, "body": "■初めまして。個人VTuberのおはじちゃんと申します。\nしっかりした魅力的な線、陰影の落とし方に惹かれました！\n是非私自身のイラストを描いて頂けたら嬉しいです。\n\n■デザインは下記をご参考にして下さい。\nhttps://pbs.twimg.com/media/F7K9VPUaUAAsTt2?format=jpg&name=large\n（※https://x.com/ohajichan_0821/status/1707636079183241308?s=20の添付画像）\n・中身は90年代VTuberとして90年代の歌やゲーム、漫画、文化を嗜んでおります。\n・瞳のハイライトが上部に無いこと以外はご自身の絵柄に合う、描きやすいようにアレンジして下さって構いません。\n・髪型は今回は目隠れの方希望です。\n・ポージングや構図はお任せします。ご自身が描きやすい・描きたいもので構いません。\n→指定がある方が楽な場合はキャラ的にはダウナー、ミステリアスキャラぽく不思議な表情や仕草が合いますが、たまさぶろう様の描かれる表情が好きなので少し大げさでも構いません♡\n\n■用途\nYou Tubeの配信サムネイル、SNSの告知などで使用。\n\n■備考\n・背景は無し・簡素で構いません。（Skebで描かれているうさ耳アリスの絵すごく素敵です！）\n・頭部や髪の毛、肩や肘(ある場合)は先が切れていない構図ですと有り難いです。\n・出来ればキャラクターのみの透過データ(pngかPSD形式)も頂けると幸いです。（別途用意ではなくこちらで調整・取り出せる形のもので構いません）\n\n宜しくお願い致します。\n\nhttps://pbs.twimg.com/media/F7K9VPUaUAAsTt2?format=jpg&name=large", "created_at": "", "completed_at": ""}, {"path": "/@ikupom_twi/works/59", "thumbnail_src": "https://si.imgix.net/8fbf80f4/uploads/origins/58e0ebaa-d054-4dae-bbc2-5de8b0a36d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c61533d5c92fb350850aa12157cce34", "thumbnail_srcset": "https://si.imgix.net/8fbf80f4/uploads/origins/58e0ebaa-d054-4dae-bbc2-5de8b0a36d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c61533d5c92fb350850aa12157cce34, https://si.imgix.net/8fbf80f4/uploads/origins/58e0ebaa-d054-4dae-bbc2-5de8b0a36d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12d30042263b9b17ae5395bb5adc1142 2x, https://si.imgix.net/8fbf80f4/uploads/origins/58e0ebaa-d054-4dae-bbc2-5de8b0a36d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ad5098e05c77bc1f7b104462fd5adc3 3x", "genre": "art", "nsfw": false, "body": "たまさぶろう様\nはじめまして。Vtuberの桃江ゆうと申します。\nたまさぶろうさんの絵を見つけ一目惚れしたので、ぜひ桃江ゆうのハロウィンイラストを描いていただきたくリクエストさせていただきました！\n\n・希望\n服装は既存のものではなく たまさぶろうさんの思うセクシーなハロウィン衣装で描いていただきたく、髪型もそれに合わせておまかせしたいです。\nハートモチーフのステッキを持ったり少し魔法少女みがあると嬉しいです。\n瞳の中にあるハートは描いていただきたいです。\n\n・桃江ゆうの詳しい容姿\nうさ耳があり、左は悪魔、右は天使の羽があります\n髪色はピンクで白薄紫のハイライトやインナーが入っています(資料a)\n瞳は色がターコイズブルーで、ハートのハイライト?と、ピンク青黄系３色の控えめワンポイントが入っています(ハートもワンポイントも位置や形はどこでもかまいません！)\n以下のURLは桃江ゆうの容姿の資料になります\nhttps://drive.google.com/file/d/1freqCZpi_BawS1l2xsPqVEx5Q3NVj25v/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1F1BvM3q0GntIwvdTvyG-H0BJdM55RzvH/view?usp=drivesdk\n\n・使用用途\nX等SNSでの利用、YouTubeのサムネイル、ネットプリント\n\n人物のみの背景透過版もいただけるととても嬉しいです。\nもし説明がわからない部分がございましたら、たまさぶろうさんの思うように描いていただきたいです！\n大変お忙しいかと存じますが、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1freqCZpi_BawS1l2xsPqVEx5Q3NVj25v/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@ikupom_twi/works/58", "thumbnail_src": "https://si.imgix.net/234e4b91/uploads/origins/50ab1990-bac0-4eeb-b4d1-b03b69ada5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68aa1aa0fd0f6f46aa6c4a01da924d09", "thumbnail_srcset": "https://si.imgix.net/234e4b91/uploads/origins/50ab1990-bac0-4eeb-b4d1-b03b69ada5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68aa1aa0fd0f6f46aa6c4a01da924d09, https://si.imgix.net/234e4b91/uploads/origins/50ab1990-bac0-4eeb-b4d1-b03b69ada5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi