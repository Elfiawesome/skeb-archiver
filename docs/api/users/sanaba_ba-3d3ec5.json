54d-8264-a5b7ecc25986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae8f98d4b64947d08a668ba4a0d056f", "thumbnail_srcset": "https://si.imgix.net/8da64bd0/uploads/origins/57ea4727-0f74-454d-8264-a5b7ecc25986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae8f98d4b64947d08a668ba4a0d056f, https://si.imgix.net/8da64bd0/uploads/origins/57ea4727-0f74-454d-8264-a5b7ecc25986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3048e42ce08565721989f61402537cde 2x, https://si.imgix.net/8da64bd0/uploads/origins/57ea4727-0f74-454d-8264-a5b7ecc25986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcee9fd5ead8f66ef850773e444c9896 3x", "genre": "art", "nsfw": false, "body": "sanababa様　\n世話になっております。\nskebの募集再開、とても楽しみにお待ちしておりました。\n以前デフォルメキャラのイラストを描いていただきました、\nVtuberの蜜月みるくと申します。\n(Twitter：https://twitter.com/Mitsuki32Milk)\n\nその節は素敵なイラストをありがとうございました。\n\nこの度は、以前描いていただいたイラストとは別衣装のデフォルメイラストを描いていただきたくリクエストを送らせていただきました。\n\n【衣装参考】\n\nhttps://twitter.com/mitsuki32milk/status/1517491860742479873?s=21&t=YHkdoJxOJmlE23FpvOqHjQ\n\n【使用用途】\nyoutubeのアイコン、動画のサムネイル、\nTwitterへの投稿、アイコン、グッズ制作\n\n納品の際、PSDファイルで\n背景と人物、サインを分けられるようにしていただけますと大変助かります。\n\nその他表情、ポーズ等は全てお任せいたします。\n\nご多忙中大変恐縮ではありますが、\nご検討のほど何卒よろしくお願い申し上げます。\n\nhttps://twitter.com/mitsuki32milk/status/1517491860742479873?s=21&t=NTfYS2OBEAU8XK7L4NCrEw", "created_at": "", "completed_at": ""}, {"path": "/@sanaba_ba/works/82", "thumbnail_src": "https://si.imgix.net/7619d5cd/uploads/origins/662520e3-3c47-4292-82d1-d4591374a8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f91cd4303ddde8bae116bfeb31c37e99", "thumbnail_srcset": "https://si.imgix.net/7619d5cd/uploads/origins/662520e3-3c47-4292-82d1-d4591374a8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f91cd4303ddde8bae116bfeb31c37e99, https://si.imgix.net/7619d5cd/uploads/origins/662520e3-3c47-4292-82d1-d4591374a8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8a2cca6fd4239613fea666d7fcdb0f4 2x, https://si.imgix.net/7619d5cd/uploads/origins/662520e3-3c47-4292-82d1-d4591374a8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb921c2ea9d525fc9287ea6d79f57334 3x", "genre": "art", "nsfw": false, "body": "sanababa様。はじめまして、\n個人Vtuberの『恣ノ宮うか』と申します。\n\n以前から新着で何度も拝見しておりまして、\nいつかsanababa様に、依頼したいなと思っておりました。\nぜひ、わたしのことを描いていただきたいです！\n\n構図などは、全てお任せいたします。\nメイン衣装（ケープ有）だと嬉しいです。\n喜怒哀楽があると有難いですが、怯えている表情や\nわがままそうな表情、小悪魔みたいな表情があると嬉しいです。\n\n納品はpsdだとありがたいです。\n\n使用用途は、twitterや YouTubeサムネ、\nまた、グッズとして販売する可能性があります。\n\nご検討、よろしくお願い致します！\n\nhttps://twitter.com/shinomiya_uka/status/1515552898515861505?s=21&t=-DaxgONmJ3JQgvwvwx2YKg", "created_at": "", "completed_at": ""}, {"path": "/@sanaba_ba/works/81", "thumbnail_src": "https://si.imgix.net/4a4c97da/uploads/origins/68a88526-4e82-4a0e-b572-79727b7512b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b7859e00ee6075003da016e8f48bd18", "thumbnail_srcset": "https://si.imgix.net/4a4c97da/uploads/origins/68a88526-4e82-4a0e-b572-79727b7512b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b7859e00ee6075003da016e8f48bd18, https://si.imgix.net/4a4c97da/uploads/origins/68a88526-4e82-4a0e-b572-79727b7512b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a136f9bfdc27c36a44ee6c840f81cef4 2x, https://si.imgix.net/4a4c97da/uploads/origins/68a88526-4e82-4a0e-b572-79727b7512b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1095013fa643f1051cd3dd2748699a92 3x", "genre": "art", "nsfw": false, "body": "新着で素敵なイラスト拝見してデフォルメキャラ\n可愛かったので依頼させて下さい\n推しである猫〆しあさんをお願いします\nポーズや構図等はおまかせします。\nhttps://profcard.info/u/zJgItbGHwyLjkBXcE6OselfxlJP2\n二次創作につきましては本人の許可済みです\n宛名と背景ある場合はレイヤー分けしてPSDでいただけると嬉しいです。\n個人利用としましては、Twitterでの宣伝許可頂けると嬉しいです\n使用は本人次第なのですが、可能であればSNSやサムネ、youtube等での使用承諾を頂けますと幸いです。\nご検討よろしくお願いします", "created_at": "", "completed