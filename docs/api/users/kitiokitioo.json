8-b3f8-05a7bfa440fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d57882a549d904ac9e28edf179fe393", "thumbnail_srcset": "https://si.imgix.net/0008de1b/uploads/origins/41587045-aefa-4d38-b3f8-05a7bfa440fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d57882a549d904ac9e28edf179fe393, https://si.imgix.net/0008de1b/uploads/origins/41587045-aefa-4d38-b3f8-05a7bfa440fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d43bc4118a421ce00b8d644b8e69d33b 2x, https://si.imgix.net/0008de1b/uploads/origins/41587045-aefa-4d38-b3f8-05a7bfa440fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cb3d621edba8bf60e7267b72256b72f 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n素敵なイラストをお見掛けして、リクエストをお願いしたくご連絡いたしました。\nよろしければ、ご検討お願いします。\n\n■キャラクター\n冬藤かさねさん\nhttps://drive.google.com/drive/folders/1HpIH60hqrsShCig4gTwax43mDtvA_n6f?usp=drive_link\n\n■構図\n以前、ご製作していた作品でふともものムチムチした描画がすごく好みでした。\n冬藤かさねさんの衣装ではスカートが長めですが、ミニスカにしたりふわっとさせたりして、ふとももを描写したイラスト構図にしてほしいです。\nhttps://skeb.jp/@kitiokitioo/works/24\n\nポーズや構図をお任せします。\n\n可能ならば、全身描写で透過レイヤーがあると助かります。\nまた、SNSの公開や利用を許可いただけますとお幸いです。\n\n以上、ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1HpIH60hqrsShCig4gTwax43mDtvA_n6f?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kitiokitioo/works/44", "thumbnail_src": "https://si.imgix.net/86038934/uploads/origins/c5dc8b4e-ca31-445a-bdf1-de6fc65d85a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c4b6cfbfd818bd3905d0e34dc6667c8", "thumbnail_srcset": "https://si.imgix.net/86038934/uploads/origins/c5dc8b4e-ca31-445a-bdf1-de6fc65d85a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c4b6cfbfd818bd3905d0e34dc6667c8, https://si.imgix.net/86038934/uploads/origins/c5dc8b4e-ca31-445a-bdf1-de6fc65d85a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb96517879ec1b15af667ade72008e82 2x, https: