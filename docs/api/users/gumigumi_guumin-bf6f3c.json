a5524379 2x, https://si.imgix.net/ef0da2e2/uploads/origins/f85d3e19-dbf7-4e3c-bb93-3d5f6e0b622a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3301661b9cf2e07d7104c6f505d81844 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/26", "thumbnail_src": "https://si.imgix.net/6b1dba65/uploads/origins/566b264f-666a-4216-8959-c038c7bedb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1be33d576dc5b45314dab3ebf1b35fa", "thumbnail_srcset": "https://si.imgix.net/6b1dba65/uploads/origins/566b264f-666a-4216-8959-c038c7bedb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1be33d576dc5b45314dab3ebf1b35fa, https://si.imgix.net/6b1dba65/uploads/origins/566b264f-666a-4216-8959-c038c7bedb02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8dc63983560aedf9f7f1635ccfc2de7 2x, https://si.imgix.net/6b1dba65/uploads/origins/566b264f-666a-4216-8959-c038c7bedb02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d0203696b2077d51ace4f687f520a77 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\nサリエル（東方Project）\n\n【シチュエーション】\nラブラブコスプレエッチからの中出し\n\n【バストサイズ】\nでっかく\n\n【服装】\n露出の大きいシスター服\n\n【構図】\n背後から胸を鷲掴みにされている感じでお願いします。\n\n【その他】\n良ければ翼は付けてください。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/25", "thumbnail_src": "https://si.imgix.net/eaf5af16/uploads/origins/96cc6721-7828-4802-83a1-2b40e1d8fa11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=628c19b17b9da8b735712013e7dc81d3", "thumbnail_srcset": "https://si.imgix.net/eaf5af16/uploads/origins/96cc6721-7828-4802-83a1-2b40e1d8fa11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=628c19b17b9da8b735712013e7dc81d3, https://si.imgix.net/eaf5af16/uploads/origins/96cc6721-7828-4802-83a1-2b40e1d8fa11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0183f14730c34b965d2b07901b0d42a4 2x, https://si.imgix.net/eaf5af16/uploads/origins/96cc6721-7828-4802-83a1-2b40e1d8fa11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ce2496868a3ec1bc2c5f6dd1a2970e5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/24", "thumbnail_src": "https://si.imgix.net/b3542961/uploads/origins/eb661857-0a5e-4168-8e1b-6af31f67e3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fb2f8a083b0d3d2fabac28961e3818e", "thumbnail_srcset": "https://si.imgix.net/b3542961/uploads/origins/eb661857-0a5e-4168-8e1b-6af31f67e3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fb2f8a083b0d3d2fabac28961e3818e, https://si.imgix.net/b3542961/uploads/origins/eb661857-0a5e-4168-8e1b-6af31f67e3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b65fa85e74835ca9e1d387b7c5a56204 2x, https://si.imgix.net/b3542961/uploads/origins/eb661857-0a5e-4168-8e1b-6af31f67e3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec5bb3a0e3df4e0b7a318f0504c2cef6 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\n神綺（東方Project）\n\n【バストサイズ】\n頭部と同じくらいでっかく。\n\n【服装】\n露出が多いウェディングドレス＋ウェディングヴェール\n（色やデザインはお任せします）\n\n【シチュエーション】\nベッドに寝転んでのラブラブエッチ→中出し\n\n【構図】\n上から見下ろした状態", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/23", "thumbnail_src": "https://si.imgix.net/fcc19ec6/uploads/origins/05142073-8fdf-4f03-b094-460b53b2c0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a662ca2ee9ff771f186acb1635b461", "thumbnail_srcset": "https://si.imgix.net/fcc19ec6/uploads/origins/05142073-8fdf-4f03-b094-460b53b2c0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a662ca2ee9ff771f186acb1635b461, https://si.imgix.net/fcc19ec6/uploads/origins/05142073-8fdf-4f03-b094-460b53b2c0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2717201e27050e86666078d68cd1e7fd 2x, https://si.imgix.net/fcc19ec6/uploads/origins/05142073-8fdf-4f03-b094-460b53b2c0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=157af748d48844ac3cf370bc04e8af8e 3x", "genre": "art", "nsfw": true, "body": "リクエストしたいと思います。\n\nキャラは東方星蓮船の聖白蓮\n\nシチュはSMに使う拘束具で拘束されされてるシーンをお願いします。\n\n首輪に手枷が繋がってる手枷をつけられ、拘束グローブをはめられる。\nhttps://drive.google.com/drive/folders/155dXXNR83hwjfwEJM4KlrvDcxhwS1EBS?usp=sharing\n\n口にはリングギャグを付けられている。\nhttps://drive.google.com/drive/folders/1yN_A-YAxVas7OngJn2ieVZQ5bzVHvddC?usp=drive_link\n\n恰好は全裸で膝をついてしゃがんでいる。\nフェラ事後のような状態で顔や口の中、胸などが精液で汚れている。\n聖は疲弊していて苦しそうな表情。\n周囲に２～3人の男のシルエット、下半身のみ映ってるだけでいいです。\n\nご検討のほどお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/22", "thumbnail_src": "https://si.imgix.net/6a2460f2/uploads/origins/5ca218c6-5412-4692-9f39-6e8cb5a7d990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbc6cced0f927faf4e3bbdb3f19c41d7", "thumbnail_srcset": "https://si.imgix.net/6a2460f2/uploads/origins/5ca218c6-5412-4692-9f39-6e8cb5a7d990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbc6cced0f927faf4e3bbdb3f19c41d7, https://si.imgix.net/6a2460f2/uploads/origins/5ca218c6-5412-4692-9f39-6e8cb5a7d990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5af783d4c06015d9f592b3f6c213cb43 2x, https://si.imgix.net/6a2460f2/uploads/origins/5ca218c6-5412-4692-9f39-6e8cb5a7d990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c3bf6fad78c8d658bd489c9befd54bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/21", "thumbnail_src": "https://si.imgix.net/d592556f/uploads/origins/3209b72a-ef0a-4beb-b893-087c0de1ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bde88c298d0c26ae8fc060a3563d9aa", "thumbnail_srcset": "https://si.imgix.net/d592556f/uploads/origins/3209b72a-ef0a-4beb-b893-087c0de1ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bde88c298d0c26ae8fc060a3563d9aa, https://si.imgix.net/d592556f/uploads/origins/3209b72a-ef0a-4beb-b893-087c0de1ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea4023bdbe40c0f096c6fec74d8c858c 2x, https://si.imgix.net/d592556f/uploads/origins/3209b72a-ef0a-4beb-b893-087c0de1ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29f15d242c15f9c1d378f3cdcb68ddef 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。\n新着作品に目を惹かれました。\n妖夢のイラストでしたが、艶やかで綺麗にそろった髪型の表現や、大きくて綺麗な瞳、上手な服飾の表現が好みでした。\nPixivも拝見し、やはり服飾の表現や表情の豊かさが魅力的でした。\n\n少しマニアックな要素を含みますが、以下のようなオリキャラの女の子を描いていただけませんでしょうか。\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/20", "thumbnail_src": "https://si.imgix.net/ed273da6/uploads/origins/e75b04d1-7752-4dfb-ae7a-abc74403935a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ddf8a07ed9ba56bba885fd10764e81", "thumbnail_srcset": "https://si.imgix.net/ed273da6/uploads/origins/e75b04d1-7752-4dfb-ae7a-abc74403935a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ddf8a07ed9ba56bba885fd10764e81, https://si.imgix.net/ed273da6/uploads/origins/e75b04d1-7752-4dfb-ae7a-abc74403935a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7601de37fbfb62853fad81057248a214 2x, https://si.imgix.net/ed273da6/uploads/origins/e75b04d1-7752-4dfb-ae7a-abc74403935a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b10a0a2f8c8c03c50ea07ad5d406959 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\nサリエル（東方Project）\n\n【シチュエーション】\n前回依頼させていただいた衣装(works/16)を着てのエッチ\n\n【構図】\nでっかいおっぱいを強調していただければ、他はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/19", "thumbnail_src": "https://si.imgix.net/a7af8c83/uploads/origins/c288c56e-35ef-42a3-9b48-5c8d8d6e449d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e44e4a8ac062f78fb7d62706b7f559", "thumbnail_srcset": "https://si.imgix.net/a7af8c83/uploads/origins/c288c56e-35ef-42a3-9b48-5c8d8d6e449d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e44e4a8ac062f78fb7d62706b7f559, https://si.imgix.net/a7af8c83/uploads/origins/c288c56e-35ef-42a3-9b48-5c8d8d6e449d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bffec2c121da2f4956f5a6bdb0402ae 2x, https://si.imgix.net/a7af8c83/uploads/origins/c288c56e-35ef-42a3-9b48-5c8d8d6e449d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0715d15b8cebd97867f79c5c08fa5f4 3x", "genre": "art", "nsfw": false, "body": "こんにちはグウミン、私は魂の悪魔の夢のファンです、私は本当にあなたが描いたパンストの質感が好きです！\n私はあなたが悪魔の夢の衣装のセットを設計するためにお願いしたいと思いますが、ライン上の自由な遊びは、元の衣装ができるようにあまりにも似ていない、唯一の要件は白いパンスト差分の必要性に加えて、緑色のパンストがあります。\n他の衣服の形態が制限されていない、アクションが制限されていない、半分精神を描くことを忘れないでください。緑のパンストの色はhttps://www.pixiv.net/artworks/117538410和https://www.pixiv.net/artworks/112527025、白のパンストは今まで通りを参考にしてください。透明感を出すのもいい。\n背景については、自分が適切だと感じ、描きたいと思う背景があれば描けばいい。そうでなければ、背景を描かないことはそれほど重要ではない。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/18", "thumbnail_src": "https://si.imgix.net/224b6b37/uploads/origins/870c22ec-d3d8-49fb-b160-ccd34114c97d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211b3bb865470f4280727bbe90c3161b", "thumbnail_srcset": "https://si.imgix.net/224b6b37/uploads/origins/870c22ec-d3d8-49fb-b160-ccd34114c97d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211b3bb865470f4280727bbe90c3161b, https://si.imgix.net/224b6b37/uploads/origins/870c22ec-d3d8-49fb-b160-ccd34114c97d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19fcb145b2a195542aed99120288acc8 2x, https://si.imgix.net/224b6b37/uploads/origins/870c22ec-d3d8-49fb-b160-ccd34114c97d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f143899991bd9e3b904687d334e67773 3x", "genre": "art", "nsfw": true, "body": "博麗靈夢(封魔録衣装)でひょっとこフェラをリクエストしたいです!\n構図は以前投稿されていた旧作風見幽香のひょっとこフェラと同じようなものでお願いします。\n鼻と口からを精液が大量に吹き出していると嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/17", "thumbnail_src": "https://si.imgix.net/a061ab1c/uploads/origins/58d3c5a9-ebca-4462-aa1b-22004309e4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=124f0463f6bbe0d5d11b334faf616283", "thumbnail_srcset": "https://si.imgix.net/a061ab1c/uploads/origins/58d3c5a9-ebca-4462-aa1b-22004309e4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=124f0463f6bbe0d5d11b334faf616283, https://si.imgix.net/a061ab1c/uploads/origins/58d3c5a9-ebca-4462-aa1b-22004309e4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31287c3943a717805b0666a9cdb06b9a 2x, https://si.imgix.net/a061ab1c/uploads/origins/58d3c5a9-ebca-4462-aa1b-22004309e4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afc4b9db2403071e25a019617fde0513 3x", "genre": "art", "nsfw": true, "body": "御世話になります。 今回は眠らされる咲夜の続きで「咲夜が睡姦されている最中、目を覚ましたので再びクロロホルムを嗅がせて眠らせる」シーンをお願い致します。\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「中だしされつつ目を閉じ気絶」「ハンカチ無しで寝顔が見える」をお願いいたします\n・犯人は一部分やシルエットでも大丈夫です。背景もこだわりません。\n・緊縛され、猿轡つきでお願いいたします。\n・余裕があれば台詞や効果音の有無差分もよろしいでしょうか？\n・乳やスジ（陰毛）が見える男目線の構図でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/16", "thumbnail_src": "https://si.imgix.net/b8e777df/uploads/origins/856ae4ca-5a6a-473c-b223-6f4f3667c2de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06260188cafb0cef89b793f9bbcbae75", "thumbnail_srcset": "https://si.imgix.net/b8e777df/uploads/origins/856ae4ca-5a6a-473c-b223-6f4f3667c2de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06260188cafb0cef89b793f9bbcbae75, https://si.imgix.net/b8e777df/uploads/origins/856ae4ca-5a6a-473c-b223-6f4f3667c2de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f05f56981c817a492525a52e9a54ffc 2x, https://si.imgix.net/b8e777df/uploads/origins/856ae4ca-5a6a-473c-b223-6f4f3667c2de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a10824178e10079a0fee021af3225c10 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\nサリエル（東方Project）\n\n【バストサイズ】\n頭部と同じくらいでっかく。\n\n【服装】\n裸ウェディング（ウェディングベール＋長手袋＋ストッキングのみ）。\n翼はありでお願いします。\n\n【構図】\nでっかいおっぱいを強調していただければ\n他はお任せします。\n\n【シチュエーション】\nお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/15", "thumbnail_src": "https://si.imgix.net/00c38350/uploads/origins/0db9e060-f311-46fa-97e2-f889f7715304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7e5bbe47fb62d17a5bb833c8ae86693", "thumbnail_srcset": "https://si.imgix.net/00c38350/uploads/origins/0db9e060-f311-46fa-97e2-f889f7715304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7e5bbe47fb62d17a5bb833c8ae86693, https://si.imgix.net/00c38350/uploads/origins/0db9e060-f311-46fa-97e2-f889f7715304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6906f3a7b44644fcb0f3390312f06d59 2x, https://si.imgix.net/00c38350/uploads/origins/0db9e060-f311-46fa-97e2-f889f7715304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0ad36afe81dafa0da9c9ed94fa4f182 3x", "genre": "art", "nsfw": true, "body": "御世話になります。\n「十六夜咲夜が、何者かによってクロロホルムを嗅がされて眠らされるシーン」をお願いします。\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「目を閉じ気絶」「ハンカチ無しで寝顔が見える」をお願いします。\n・全裸でお願いします。乳やスジ（陰毛）が見える構図でお願いします。\n・犯人は腕など一部分やシルエットで大丈夫です。背景もこだわりません。\n・犯人に抱きしめられる感じで眠らされます。片手でおっぱいを揉んでます。\n・よければ台詞や効果音の有無差分もよろしいでしょうか。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/14", "thumbnail_src": "https://si.imgix.net/6473a19a/uploads/origins/cb4138ba-f9a2-473f-802a-76398e0b9525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e76ba24edce0472b49f259691ba488d", "thumbnail_srcset": "https://si.imgix.net/6473a19a/uploads/origins/cb4138ba-f9a2-473f-802a-76398e0b9525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e76ba24edce0472b49f259691ba488d, https://si.imgix.net/6473a19a/uploads/origins/cb4138ba-f9a2-473f-802a-76398e0b9525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dccb47fde20c9116f75973d1b7c5650e 2x, https://si.imgix.net/6473a19a/uploads/origins/cb4138ba-f9a2-473f-802a-76398e0b9525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0f6bda51aff3bc2b51f1fc89640643b 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nグウンミンさんのイラストを拝見しております。個性があって素敵な絵で感動しました。なのでこちらからリクエストしたいと思います。\nリクエストしたいキャラは東方Projectの作品で怪綺談キャラです。\n怪綺談と言えば魔界で寒い地域なので怪綺談のサラ、ルイズ、アリス、ユキ、マイ、夢子、神綺の7人でデザートのお店に行ってアイスクリームやケーキを食べる食べ放題の漫画にしたいと思います。私たちで言うスイパラみたいな感じにしたいと思います。\n1\nみんなで幸せそうになってアイスクリームやかき氷などを食べてる。サラちゃんとユキちゃんと神綺様ははしゃいぎながら食べたりしてる。夢子さんとルイズさんとマイちゃんはお上品な感じに食べてる感じがします。アリスちゃんは純粋にアイスを食べたり、ジュースを飲んでる感じがします。みんなは何を食べてるかはご想像にお任せします！\n2\nおかわりしそうな神綺様やユキちゃんが調子に乗ってまたデザートを食べてる。神綺様たちがあまりにたくさん食べたり、飲んだりしてるのでそれで夢子さんは2人に叱りました。なんだかんだ純粋に楽しんでる様子です。\n3\nみんなで雑談したり、談笑して楽しんでる時にルイズさんが激しい腹痛に襲われたのでお腹を擦ってニコニコしながらお手洗いに向かいました。冷房が聞いてる中でアイスクリームを食べたり、氷が入ってるコーヒーを飲んだのが原因かも知れません。\n4\n神綺様はお皿が積めるくらいたくさん食べまくっていて、ユキちゃんもたくさん食べてて、サラちゃんは食べきれなかった人の分を食べる感じでマイちゃんと夢子さんはゆっくり食べてるような感じにお願いします。アリスちゃんは純粋にアイスを食べたり、パフェなどを食べる好きなように食べるようにお願いします。\n5\n帰る頃にルイズさんがお手洗いから帰ってきて大丈夫？と声をかける感じでユキちゃんが遅いよ〜と怒った感じでお願いします。それでみんな揃って帰宅しました。\n\nこんな感じで6枚漫画でお願いします。セリフはすべてご想像にお任せします。怪綺談ではファミリー感があって楽しくワイワイ時にはカオスな感じがある感じがあるかも知れません。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/13", "thumbnail_src": "https://si.imgix.net/e7638fd8/uploads/origins/152138c1-05f7-4c1b-8b5f-900eccbf5c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56a9de26bc70ff53c1adece81af3d3e9", "thumbnail_srcset": "https://si.imgix.net/e7638fd8/uploads/origins/152138c1-05f7-4c1b-8b5f-900eccbf5c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56a9de26bc70ff53c1adece81af3d3e9, https://si.imgix.net/e7638fd8/uploads/origins/152138c1-05f7-4c1b-8b5f-900eccbf5c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11d0d5850e0129d473e34c99a37fe435 2x, https://si.imgix.net/e7638fd8/uploads/origins/152138c1-05f7-4c1b-8b5f-900eccbf5c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1cd0a10d29f8e690d8f57c99ffd364f 3x", "genre": "art", "nsfw": true, "body": "こんにちは。フェラ描写が素晴らしいのでリクエストしたいと思います。\n\n東方projectの十六夜咲夜をお願いします。\n\nシチュは拘束されて男竿役に開口器イラマチオされるシチュで\n\nメイド服姿で後ろ手拘束で縛られて口にはリングギャグを付けられる。\nhttps://drive.google.com/drive/folders/1yN_A-YAxVas7OngJn2ieVZQ5bzVHvddC?usp=drive_link\n\nしゃがんでる状態で男に頭を掴まれてイラマチオされている。\n咲夜は苦しそうな表情をしている。\n構図はパンチラしてる構図がいいですね。\n\n差分で口内射精＋鼻ザーとアヘってる表情もあると嬉しいです。\nご検討のほどお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/12", "thumbnail_src": "https://si.imgix.net/b15ae5c9/uploads/origins/3e8dd4f0-7a27-4e6e-bbc4-f5c5e59fdcea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f0d989125c9ed53ac89e1cb2567e62", "thumbnail_srcset": "https://si.imgix.net/b15ae5c9/uploads/origins/3e8dd4f0-7a27-4e6e-bbc4-f5c5e59fdcea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f0d989125c9ed53ac89e1cb2567e62, https://si.imgix.net/b15ae5c9/uploads/origins/3e8dd4f0-7a27-4e6e-bbc4-f5c5e59fdcea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86fcd452a1c4e6a361dce7203696ac06 2x, https://si.imgix.net/b15ae5c9/uploads/origins/3e8dd4f0-7a27-4e6e-bbc4-f5c5e59fdcea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19df7ef69a9296a7eaf6bca763a26e0c 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\nサリエル（東方Project）\n\n【バストサイズ】\n頭部と同じくらいでっかく。\n以前pixivに投稿された「クリスマス in 地獄（artworks/103892309）」が\n近い感じです。\n\n【シチュ】\n水辺でエッチ\n\n【服装】\n全裸。翼はありでお願いします。\n\n【構図】\nでっかいおっぱいを強調していただければ\n構図はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/11", "thumbnail_src": "https://si.imgix.net/1af7ad13/uploads/origins/f4b45c0e-17a3-4255-bc9e-cc18dcf0ca7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73c1a0b57c94ae4b96b370428bd2ac3", "thumbnail_srcset": "https://si.imgix.net/1af7ad13/uploads/origins/f4b45c0e-17a3-4255-bc9e-cc18dcf0ca7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73c1a0b57c94ae4b96b370428bd2ac3, https://si.imgix.net/1af7ad13/uploads/origins/f4b45c0e-17a3-4255-bc9e-cc18dcf0ca7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86b510d06c58648acb80c05ad48123c0 2x, https://si.imgix.net/1af7ad13/uploads/origins/f4b45c0e-17a3-4255-bc9e-cc18dcf0ca7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e34f48c842f35d18ff58d980bc2bdcf 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nスマートフォンゲーム「アークナイツ」のキャラクター「スペクター(中国語表記：幽灵鲨)」をお願いします。\n\n◯キャラ説明\n外観は以下を参考に。\n・公式\nhttps://twitter.com/ArknightsStaff/status/1222731170460270593\nhttps://twitter.com/ArknightsStaff/status/1603586190665338881\n\n・二次創作\nhttps://twitter.com/L_torifune/status/1439683541361594368\nhttps://twitter.com/Fenrir_corp/status/1676702241007505408\nhttps://twitter.com/payopayo326a/status/1614937512992182272\nhttps://skeb.jp/@knk_momomo/works/8\n\n修道女のような見た目と裏腹に、強靭な身体能力で押し通すパワースタイルの戦い方をします。戦闘時は非常に強気で好戦的です。\n\n◯依頼内容\n戦闘中に武器を振るうワンシーンを希望します。\n以前描かれていました魅魔様の表情がとても格好良かったので、そちらに近い雰囲気を見たいです。戦いを楽しむような、少し悪そうな笑顔という感じ。\nhttps://twitter.com/gumigumi_guumin/status/1650759067705671685\n\n量は問いませんので、返り血の描写があると嬉しいです。(※本項目がNSFWに該当する可能性があるので、念のため設定を有効にしています)\nご負担であれば武器や服装などの細部は簡略化・省略して頂いて構いません。全身絵でなくてもOKです。\n\n馴染みのない作品かと思いますが、もしご了承いただけましたらよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/10", "thumbnail_src": "https://si.imgix.net/8907998d/uploads/origins/7a4d83f0-b45b-4c48-9f8d-241467e566a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5604759969abdc4f34d920c4014f43d3", "thumbnail_srcset": "https://si.imgix.net/8907998d/uploads/origins/7a4d83f0-b45b-4c48-9f8d-241467e566a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5604759969abdc4f34d920c4014f43d3, https://si.imgix.net/8907998d/uploads/origins/7a4d83f0-b45b-4c48-9f8d-241467e566a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=932ff2b11c9ae1306e4f029dc0f52c10 2x, https://si.imgix.net/8907998d/uploads/origins/7a4d83f0-b45b-4c48-9f8d-241467e566a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0962105f8befc8b3e3ca40cc2242d81a 3x", "genre": "art", "nsfw": true, "body": "こんにちは、pixivであなたの作品をよく見ています。\n東方project 東方靈異伝から登場するサリエルが おしっこが我慢できないとパンツにちびる姿をお願いします。\n\nサリエルの下着色は平凡な白でお願いします。\n複数枚差分ごとにパンツの状態が現れるといいですね, そして. 複数枚差分をお願いしたく、それぞれの希望差分を書かせて頂きます。\n\n1. お茶をたくさん飲んだのでちょっとした尿意を感じ始めたサリエル,  まだ我慢できるのか、もじもじしています\n\n2. 尿意が限界間近に迫り、大事なところをぎゅっと押さえ息を荒くしながら、がくがくと身体を震わせながら必死に我慢しています。\n\n3. ついに我慢しきれなくなったおしっこが、ショーツに少しずつ滲んでいきます。(服の表面にまではまだ濡れてない感じ）\n\n4. もう少しやらかしてしまい、今度はスカートまで濡れてしまいます。\n\n5. ついに気力が尽きてしまい、おもらしをしてしまいます。\n下着や服の股の中心部分を濡らしながら、我慢しきれなかったおしっこがあふれ出ています。\n\n加えて、ちょっとしたセリフもあったらいいなと思います。 どんなセリフを入れるかはお任せします。ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/9", "thumbnail_src": "https://si.imgix.net/5ecab44d/uploads/origins/acfb6674-3e51-43ac-a11d-eea3a7c16009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01553e1431ac3c701212b8abdf2d6b13", "thumbnail_srcset": "https://si.imgix.net/5ecab44d/uploads/origins/acfb6674-3e51-43ac-a11d-eea3a7c16009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01553e1431ac3c701212b8abdf2d6b13, https://si.imgix.net/5ecab44d/uploads/origins/acfb6674-3e51-43ac-a11d-eea3a7c16009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22e6042cc5f6b4c8c3d0fc6d7ddc4af0 2x, https://si.imgix.net/5ecab44d/uploads/origins/acfb6674-3e51-43ac-a11d-eea3a7c16009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfa482a7117944acdd78cdd720c03586 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gumigumi_guumin/works/8", "thumb