-4f6e-490d-9919-14e424dd7ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b539c30ba28715f462513aba7f9010f, https://si.imgix.net/07987587/uploads/origins/2d06d954-4f6e-490d-9919-14e424dd7ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ad3f8575f89ce04067688f580764583 2x, https://si.imgix.net/07987587/uploads/origins/2d06d954-4f6e-490d-9919-14e424dd7ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67efc576589a701df9095ff69f9720cd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pepapepepe01/works/13", "thumbnail_src": "https://si.imgix.net/a4f53736/uploads/origins/26ede61f-dbe8-4886-a770-4fd150def86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=934568b2958619da73d35ada2296067a", "thumbnail_srcset": "https://si.imgix.net/a4f53736/uploads/origins/26ede61f-dbe8-4886-a770-4fd150def86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=934568b2958619da73d35ada2296067a, https://si.imgix.net/a4f53736/uploads/origins/26ede61f-dbe8-4886-a770-4fd150def86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c7de34fddd539cf47bcf8305a8035d0 2x, https://si.imgix.net/a4f53736/uploads/origins/26ede61f-dbe8-4886-a770-4fd150def86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7c41e23d8a06b753aec352b6080c9c2 3x", "genre": "art", "nsfw": true, "body": "爆乳の弦巻マキちゃんが、全裸でソファ等に座り、脚をひろげたポーズで精液ぶっかけ待ちをしているイラストをリクエストします。\n\n相手の体は描かなくて良いですが、マキちゃんの体の好きな部分に好きな量の精液をぶっかけた差分があると嬉しいです。\n\nマキちゃんは、ぶっかけられるのが大好きな設定で表情を描いてほしいです。\n\nコッショリな内容ですみませんが、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@pepapepepe01/works/12", "thumbnail_src": "https://si.imgix.net/2d46ab60/uploads/origins/e983be46-f6e0-43c5-b702-31257dce0950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f8b3ebfe740736030ca483eba899b2", "thumbnail_srcset": "https://si.imgix.net/2d46ab60/uploads/origins/e983be46-f6e0-43c5-b702-31257dce0950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f8b3ebfe740736030ca483eba899b2, https://si.imgix.net/2d46ab60/uploads/origins/e983be46-f6e0-43c5-b702-31257dce0950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e465fcdc987b60c2a3674525c68aee56 2x, https://si.imgix.net/2d46ab60/uploads/origins/e983be46-f6e0-43c5-b702-31257dce0950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dcd53e93ebb6596d1b6a6245125be07 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエストよろしいでしょうか？\n\n昔（概ね1980～2000年代あたりの）のバスケユニフォーム姿の\n（丈がふともも付け根あたりまでの際どい短パン）\n短パンスポーツ少女をお願いします\n見た目は十代半ばくらいのJK、黒目、髪型は黒髪のセミロング\n胸のサイズは普通で美乳な一方\n尻からふとももにかけてラインは健康的ながら肉感的でむっちりと太め\nバスケユニフォームは以下の画像を参考にしてください\n\n上（タンクトップ）\nhttps://jp.mercari.com/item/m39831153953\n下（短パン、画像は下へスクロール）\nhttps://page.auctions.yahoo.co.jp/jp/auction/t1064410796\n\n画像のユニフォームは上下とも紺が基調で\n太い赤のラインと細い白のラインによる配色パターンとなってますが\n紺と赤のところを逆転させ（白はそのままで）\n赤を基調とし、太い紺のラインと細い白のラインに変更してください\n下の短パンも同様にお願いします\n\nタンクトップは襟ぐりと袖まわりがゆったりとして\n腋からちょっと見えそうなほどのゆるゆるな隙間だらけでお願いします\nまた画像から背番号やチーム名等を消去し\n何もプリントされてないシンプルなデザインに変更してください\n短パンについては画像を御覧の通り\n丈がふともも付け根あたりまでの丈が際どい短さのショートパンツです\n短パンのアディダスのロゴは\n（色を赤から紺に変換させる以外）別に残しておいても構いません\n短パンの中にタンクトップの裾をしっかりと入れてる状態でお願いします\n着装参考例\nhttps://aucfree.com/items/e310120754\n着用時ちょうどタンクトップと短パンのサイドラインが繋がるイメージで\nまたブルマではなく\nあくまでも短パンなので裾まわりに余裕がある感じでお願いします\n\n表情は明るくさわやかなイメージ\n一方で腋のところが大きく空いてゆるゆるなタンクトップや\n短パンの丈の際どいところを意識しつつ\n腋とふとももを強調するよう肉感的な感じのスポーティながらセクシーで\nいろいろ見えそうで見えない構図でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@pepapepepe01/works/11", "thumbnail_src": "https://si.imgix.net