fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7c7e1a2e59bae12013b761e26e308fc 2x, https://si.imgix.net/630b7638/uploads/origins/4caa93d0-dadc-4e55-b62b-276e051839b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a6f087809fb28bc024b932cbdaab470 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクター（フィジー）が寝ているアートをお願いしたいです。メガネが今にも落ちそうな感じで、背景とポーズは自由です！\n\nフィジーの参考資料と過去の依頼\nhttps://drive.google.com/drive/folders/1b0AOfczcEFPiqh8MMi7aZCmb7BC5aClh?usp=sharing\n\nサンクス", "created_at": "", "completed_at": ""}, {"path": "/@wanco_HT/works/29", "thumbnail_src": "https://si.imgix.net/8f5c9532/uploads/origins/af2d5d2c-5018-46ce-9f24-ff72bca4183f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4881f81bc3b112d231be7651e5b8133", "thumbnail_srcset": "https://si.imgix.net/8f5c9532/uploads/origins/af2d5d2c-5018-46ce-9f24-ff72bca4183f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4881f81bc3b112d231be7651e5b8133, https://si.imgix.net/8f5c9532/uploads/origins/af2d5d2c-5018-46ce-9f24-ff72bca4183f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a5a61b1e3df061687edd5c7b3f86e49 2x, https://si.imgix.net/8f5c9532/uploads/origins/af2d5d2c-5018-46ce-9f24-ff72bca4183f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fcff88dce577d35b60cad020226151e 3x", "genre": "art", "nsfw": false, "body": "目覚めたばかりのイーブイ。できればプロフィール写真として使えるように、イーブイの横顔が見る人に見えるようにする。\n左耳に紫色のバンドをつける。\nありがとうございました>～<、それ以外は好きにしていただいて大丈夫です", "created_at": "", "completed_at": ""}, {"path": "/@wanco_HT/works/28", "thumbnail_src": "https://si.imgix.net/3ac1f404/uploads/origins/8becc46c-d248-4e17-9d85-7595c8cbbde4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6955497709ecc891442a706b0ea01a1f", "thumbnail_srcset": "https://si.imgix.net/3ac1f404/uploads/origins/8becc46c-d248-4e17-9d85-7595c8cbbde4?bg=%23fff&auto=format%2Ccompress&fm=webp&f