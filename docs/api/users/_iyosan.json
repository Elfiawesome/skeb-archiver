の違うリクエストで恐縮なのですが、以前依頼した漫画も素晴らしかったため、是非先生に描いて頂きたく思っております。\n何卒宜しくお願いします！\n\nhttps://www.youtube.com/watch?v=3rw3XCMcsUc", "created_at": "", "completed_at": ""}, {"path": "/@_iyosan/works/176", "thumbnail_src": "https://si.imgix.net/66b09c45/uploads/origins/bb8dc4d7-ef45-4339-ad1d-c5ba0f6cb789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33f410045897641e1542ac5c1d91bc40", "thumbnail_srcset": "https://si.imgix.net/66b09c45/uploads/origins/bb8dc4d7-ef45-4339-ad1d-c5ba0f6cb789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33f410045897641e1542ac5c1d91bc40, https://si.imgix.net/66b09c45/uploads/origins/bb8dc4d7-ef45-4339-ad1d-c5ba0f6cb789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=498d3d20db3077c607e2f422f366ae93 2x, https://si.imgix.net/66b09c45/uploads/origins/bb8dc4d7-ef45-4339-ad1d-c5ba0f6cb789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4faeba4bff9ff482ae43997b98e7f994 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_iyosan/works/175", "thumbnail_src": "https://si.imgix.net/f0caf50a/uploads/origins/86bda1c4-b87c-4887-819d-4bd1aeb0833f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29200ffcb71d1b6cbb2220a219c56628", "thumbnail_srcset": "https://si.imgix.net/f0caf50a/uploads/origins/86bda1c4-b87c-4887-819d-4bd1aeb0833f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29200ffcb71d1b6cbb2220a219c56628, https://si.imgix.net/f0caf50a/uploads/origins/86bda1c4-b87c-4887-819d-4bd1aeb0833f