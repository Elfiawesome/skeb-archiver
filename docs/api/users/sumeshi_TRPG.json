gins/fa746aa6-554e-4119-9fa6-ef0dfb2e6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc7a8442daa05abfa4cc038687cf28b4", "thumbnail_srcset": "https://si.imgix.net/30c550c3/uploads/origins/fa746aa6-554e-4119-9fa6-ef0dfb2e6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc7a8442daa05abfa4cc038687cf28b4, https://si.imgix.net/30c550c3/uploads/origins/fa746aa6-554e-4119-9fa6-ef0dfb2e6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=344dc9f97b59a204ea418bad69ea8ca2 2x, https://si.imgix.net/30c550c3/uploads/origins/fa746aa6-554e-4119-9fa6-ef0dfb2e6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38e8d883222641a44f760232a2584eec 3x", "genre": "comic", "nsfw": false, "body": "チマンタです\n\n花冷えの自陣をかいてほちいです！（シノさんとソフィラ）\n　会話があると嬉しいのでコミックにしました\n現行未通過✖絵でも二次創作でも卓中の会話の延長とかでも自由に.....\n\n宜しくお願いします；；\n\nhttps://drive.google.com/drive/u/1/folders/19h4fZwbZL6ZsciAAnTbfwd0v6052ADu4", "created_at": "", "completed_at": ""}, {"path": "/@sumeshi_TRPG/works/20", "thumbnail_src": "https://si.imgix.net/c4d21af5/uploads/origins/81b91a51-ac80-441a-ad1b-8bbc1b657dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e202da278d175a357bfc2077a81b010", "thumbnail_srcset": "https://si.imgix.net/c4d21af5/uploads/origins/81b91a51-ac80-441a-ad1b-8bbc1b657dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e202da278d175a357bfc2077a81b010, https://si.imgix.net/c4d21af5/uploads/origins/81b91a51-ac80-441a-ad1b-8bbc1b657dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36c48bcfb1c810c4f3a7f75909632cc1 2x, https://si.imgix.net/c4d21af5/uploads/origins/81b91a51-ac80-441a-ad1b-8bbc1b657dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19ff89d1089dbb8ebabd9804891b737a 3x", "genre": "art", "nsfw": false, "body": "ヘイ大将やってる？\n\nドロマイ回してくれてありがとうございました！\n白神 研悟さんと八波月 千鳥さんをお願いします。\n居酒屋で飲ん