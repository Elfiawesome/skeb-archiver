ix.net/4cf89839/uploads/origins/21d72f9a-4c8c-4a51-93ea-29037c0e4c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c649ed43c0b97ec8a81d8f55d74a6fc 2x, https://si.imgix.net/4cf89839/uploads/origins/21d72f9a-4c8c-4a51-93ea-29037c0e4c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a389c8cc06d34147462a96a0d4be0ac 3x", "genre": "art", "nsfw": false, "body": "いつものこの子をお願いします。\nhttps://skeb.jp/@tsukizumikana/works/9\nhttps://skeb.jp/@tsukizumikana/works/12\n\n毎回お任せ担ってしまって申し訳ないですが、ポーズや構図はお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@tsukizumikana/works/12", "thumbnail_src": "https://si.imgix.net/8e7d2c00/uploads/origins/a63a6ac7-054f-46e5-aec0-7015c38c20ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89b5eb5b6c2e97c3d4b37e46522d69df", "thumbnail_srcset": "https://si.imgix.net/8e7d2c00/uploads/origins/a63a6ac7-054f-46e5-aec0-7015c38c20ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89b5eb5b6c2e97c3d4b37e46522d69df, https://si.imgix.net/8e7d2c00/uploads/origins/a63a6ac7-054f-46e5-aec0-7015c38c20ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b75b4da5d1f1819e568887bb8108f81d 2x, https://si.imgix.net/8e7d2c00/uploads/origins/a63a6ac7-054f-46e5-aec0-7015c38c20ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85e6f920090ce0eb1a27aac2a6c14842 3x", "genre": "art", "nsfw": false, "body": "前回描いていただいた子ですが、今回はTwitterのヘッダー用のイラストをお願いしたいです！ポーズや構図はお任せします！\n\nhttps://skeb.jp/@tsukizumikana/works/9", "created_at": "", "completed_at": ""}, {"path": "/@tsukizumikana/works/11", "thumbnail_src": "https://si.imgix.net/9e49011e/uploads/origins/7a56cda1-b958-42ab-824b-b625e453d2cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbf51177d219e86887b0a4383c6c57e9", "thumbnail_srcset": "https://si.imgix.net/9e49011e/uploads/origins/7a56cda1-b958-42ab-824b-b625e453d2cb?bg=%23ff