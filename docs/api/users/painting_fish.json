rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2a8c13ad3c2d98161e1698e46abbe7b", "thumbnail_srcset": "https://si.imgix.net/db1761a0/uploads/origins/7b2a8d59-d5ba-4367-897a-813af5b92d75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2a8c13ad3c2d98161e1698e46abbe7b, https://si.imgix.net/db1761a0/uploads/origins/7b2a8d59-d5ba-4367-897a-813af5b92d75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff5d65defa4c1a4349b4d1de926cf49e 2x, https://si.imgix.net/db1761a0/uploads/origins/7b2a8d59-d5ba-4367-897a-813af5b92d75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7070b329b680be74ccfe0deae3d90cce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/41", "thumbnail_src": "https://si.imgix.net/c72c03c0/uploads/origins/8877e542-4f81-48ad-aac9-aea01e209749?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08dee1be5b39abfe421cf486e3f7d11d", "thumbnail_srcset": "https://si.imgix.net/c72c03c0/uploads/origins/8877e542-4f81-48ad-aac9-aea01e209749?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08dee1be5b39abfe421cf486e3f7d11d, https://si.imgix.net/c72c03c0/uploads/origins/8877e542-4f81-48ad-aac9-aea01e209749?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e6ce2209bd3631496cef1bce9b97fc0 2x, https://si.imgix.net/c72c03c0/uploads/origins/8877e542-4f81-48ad-aac9-aea01e209749?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e501e56f611cbe5ce72c906a18a5fa18 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは！素敵なリクエストありがとうございます。今回も斎藤選手にお願いしたいと思います。前かがみになってお尻に集中。指の動きが速い。表情が艶っぽい。下唇を噛みながら微笑んでいます。  斉藤が絶頂を迎え、潮を吹きまくるシーンもリクエストしたい。それに合わせて表情も変わります。  彼女の特徴的なお辞儀もお願いします。舞台は先ほどのリクエストと同じく、蒸し暑くて汗ばむような感じです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Pf_PCuNHINoCrIkANOVjMEQSr13amGlH\n\nhttps://drive.google.com/drive/folders/1Pf_PCuNHINoCrIkANOVjMEQSr13amGlH", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/40", "thumbnail_src": "https://si.imgix.net/73a72390/uploads/origins/2b111f1f-50f9-4104-9c3d-25de0b7e9668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2871cd1c5c3e8d660b18a38e1bce2ffb", "thumbnail_srcset": "https://si.imgix.net/73a72390/uploads/origins/2b111f1f-50f9-4104-9c3d-25de0b7e9668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2871cd1c5c3e8d660b18a38e1bce2ffb, https://si.imgix.net/73a72390/uploads/origins/2b111f1f-50f9-4104-9c3d-25de0b7e9668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c30b3debb21399ff05217f261e5cdf9 2x, https://si.imgix.net/73a72390/uploads/origins/2b111f1f-50f9-4104-9c3d-25de0b7e9668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acdc631406924288303374cde16f1b46 3x", "genre": "art", "nsfw": true, "body": "先日はありがとうがざいました。よろしければまたリクエストをお願いします。 \n\nSpice氏デサインのhotcityミクをお願いします。\n内容はお任せします。直球のエロも良いですし、R15くらいのエロでも大丈夫ですが、最低限乳輪はチラっと見えるイラストでお願いします。\n\nhotcityミクは絵によってはリップがあったりしますがそれは無しで。\nNG:アヘ顔、ボテ腹、涙目（ギャグ系はok）、唇や鼻穴が目立つ描き方。\nご検討宜しくお願いします。\n\nhttps://x.com/spicydoesart/status/1894547034394210721", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/39", "thumbnail_src": "https://si.imgix.net/4122a5e7/uploads/origins/6526df52-468b-4879-b198-4ecf2e4fd852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995de7fd2301edfa9cc06adb46be8396", "thumbnail_srcset": "https://si.imgix.net/4122a5e7/uploads/origins/6526df52-468b-4879-b198-4ecf2e4fd852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995de7fd2301edfa9cc06adb46be8396, https://si.imgix.net/4122a5e7/uploads/origins/6526df52-468b-4879-b198-4ecf2e4fd852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2ec97d1cfd7388b6dd098017dcc9143 2x, https://si.imgix.net/4122a5e7/uploads/origins/6526df52-468b-4879-b198-4ecf2e4fd852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4733f1b824aa1c5518df5a794178926 3x", "genre": "art", "nsfw": true, "body": "モモとドラの2人のキャラクターをお願いしたい。\n\n最初はこの過去の作品と同じような位置で隣り合って立っています。\nhttps://www.pixiv.net/en/artworks/119605768\nこの過去作のような、頭よりも大きな胸と、曲線美の強い体をお願いします。\nhttps://www.pixiv.net/en/artworks/122161607\n\n恥ずかしそうに顔を赤らめながら、ムラムラしている二人。モモは恥ずかしがり、ドラは余裕を見せようと必死。乳首は硬く、ドレスから透けて見える。\n\nいくつかのバリエーションがある：\n1.2人ともスカートを少し持ち上げ、パンティをはいていないことがわかる。モモは恥ずかしそうに目をそらし、ドラは平静を装う。\n2.浮いている手が二人の胸を触り始め、アソコを優しく揉み始める。  二人とも冷静さを失っている。\n3.浮いていた手が消える。ドレスの下には何も着ていないので、全身が露わになる。二人は呼吸を整え、大量の汗をかいている。\n4.ドレスが完全に脱がされ、全身があらわになる。両手は後ろに回されている。モモは恥ずかしさで目を閉じかけているが、ドーラも恥ずかしさで目をそらしていない。\n5.アソコ、ヒップ、バスト、顔など、体の敏感な部分をたくさんの浮いた手で触られ、押され始める。二人とも心臓の瞳孔が開き、絶頂に近づいて呼吸が荒くなる。\n6.二人同時に絶頂を迎える。子宮の近くに排卵を示すイラストがある。\n7.7.手はなくなったが、彼女たちは今、発情から激しいオナニーをしている。彼女たちはまだハートの瞳孔を持ち、その表情は欲望に完全に身を委ねていることを示している。\n8.浮遊する2本のチンコが彼女たちの背後から、顔のすぐ近くに現れる。二人の少女はチンコを見てとても興奮します。彼女たちの顔が完全に見えるようにしてください。彼女たちが排卵している別のイラストがありますが、複数の卵子が出現しています。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1nr70aXHcFAFfO4eoSEGoMLGZNHNRUmg8?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/38", "thumbnail_src": "https://si.imgix.net/72c0b55c/uploads/origins/abf39147-dced-4b59-932e-bddcedc94a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4dd6fc3cf2f52bd676938b7ee3251ac", "thumbnail_srcset": "https://si.imgix.net/72c0b55c/uploads/origins/abf39147-dced-4b59-932e-bddcedc94a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4dd6fc3cf2f52bd676938b7ee3251ac, https://si.imgix.net/72c0b55c/uploads/origins/abf39147-dced-4b59-932e-bddcedc94a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1506c811788d6db3528ae0d3bcd4bcb 2x, https://si.imgix.net/72c0b55c/uploads/origins/abf39147-dced-4b59-932e-bddcedc94a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1cce5c25d26f926340a78e54a82b25b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ポケモンの斉藤をリクエストします。彼女は親密な表情でオナニーをしている。片方の手で胸を触り、もう片方の手でアソコを触っています。\n\n彼女の目の前には、同じくオナニーをしている男性のペニスがある。斉藤は興奮してペニスを見つめている。\n\n男性が斉藤に射精し、同時に彼女が膣から射精するバージョンもお願いします。興奮のあまり絶頂の表情を浮かべる。\n\n斉藤のバストサイズは、以前に完成したリクエストと同様です。https://skeb.jp/@painting_fish/works/33\n\n服装はお任せします。ただ、斉藤の特徴であるカチューシャはお願いします。また、体が汗ばんでいて、湯気が立ち上っているようなシチュエーションでお願いします。ご検討よろしくお願いします！\n\nhttps://imgchest.com/p/ne7b5rrrg75", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/37", "thumbnail_src": "https://si.imgix.net/adbb8e3c/uploads/origins/1eba2445-fec7-4dca-812b-89917f3ca812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=254d69068f183608fc02910ab05d21d1", "thumbnail_srcset": "https://si.imgix.net/adbb8e3c/uploads/origins/1eba2445-fec7-4dca-812b-89917f3ca812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=254d69068f183608fc02910ab05d21d1, https://si.imgix.net/adbb8e3c/uploads/origins/1eba2445-fec7-4dca-812b-89917f3ca812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=867762b03830cd7e4c4d642de434f47c 2x, https://si.imgix.net/adbb8e3c/uploads/origins/1eba2445-fec7-4dca-812b-89917f3ca812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f7edf3804a6f03d35f4e21c8e46e2ca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/36", "thumbnail_src": "https://si.imgix.net/73184203/uploads/origins/ab165581-271f-4805-80de-b5b140b850fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6f456149329c812e3af7a73c53771f0", "thumbnail_srcset": "https://si.imgix.net/73184203/uploads/origins/ab165581-271f-4805-80de-b5b140b850fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6f456149329c812e3af7a73c53771f0, https://si.imgix.net/73184203/uploads/origins/ab165581-271f-4805-80de-b5b140b850fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b3b5714943de583ce9f4a97238ce68e 2x, https://si.imgix.net/73184203/uploads/origins/ab165581-271f-4805-80de-b5b140b850fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5672653e7ac22964de4f21503f339cb4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/35", "thumbnail_src": "https://si.imgix.net/ea4ec7fb/uploads/origins/bfcc8d50-d80b-432c-bb60-7a108eb84f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa76a091b4356aa2c073bffd66114abc", "thumbnail_srcset": "https://si.imgix.net/ea4ec7fb/uploads/origins/bfcc8d50-d80b-432c-bb60-7a108eb84f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa76a091b4356aa2c073bffd66114abc, https://si.imgix.net/ea4ec7fb/uploads/origins/bfcc8d50-d80b-432c-bb60-7a108eb84f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f03b9fa1c767c50f0fb0f9f81dec1e5 2x, https://si.imgix.net/ea4ec7fb/uploads/origins/bfcc8d50-d80b-432c-bb60-7a108eb84f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b09f41085966c7144c0402c1427b7ad0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/34", "thumbnail_src": "https://si.imgix.net/dd24fd9e/uploads/origins/504c4a44-22e7-4cd2-b9c3-076fb617dbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b1bb09baaa14f9f543230c54d896cd", "thumbnail_srcset": "https://si.imgix.net/dd24fd9e/uploads/origins/504c4a44-22e7-4cd2-b9c3-076fb617dbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b1bb09baaa14f9f543230c54d896cd, https://si.imgix.net/dd24fd9e/uploads/origins/504c4a44-22e7-4cd2-b9c3-076fb617dbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16c67fc3c3f0065b887b7ec675cb41b0 2x, https://si.imgix.net/dd24fd9e/uploads/origins/504c4a44-22e7-4cd2-b9c3-076fb617dbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca7ef010d4d2c69a2ffcfcf127241718 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n麦男先生の描かれるイラストが大変素晴らしいのでリクエストさせていただきます。\n足先の描き方がとても好きなので、足フェチイラストをお願いしたいです。\n\n画像001のような感じで掘りごたつ式のテーブルに裸足の女の子が複数人入っている状態で、\n掘りごたつの中からのアングルで女の子たちの足裏や足先が見えているイラストをお願いしたいです。\n人数は可能な範囲でお願いできればと思います。\n全員裸足（靴下のように完全に足が隠れる物ではなく、デニールの薄いストッキングやトレンカ等はOK）で、画像001、002のように足先の装飾やペディキュア、肌の色等にバリエーションがあると嬉しいです。\n足指を開ききる、全て握りしめる、親指だけ反らす等の動きを入れていただき、それぞれの足の動き、装飾等から何となくどんな子か分かりそうな感じが出ているとありがたいです。\n体格差もつけていただいて、一人ぽっちゃりムチムチした特に肉付きのいい足の子がいるようにお願いいたします。\n\nまた、それぞれの子の両足の裏がアップで写るカット（足の動きは１枚目の時とパターンを変えて）を個別に描いていただけるとありがたいです。\n個別カットでは足裏に汗をかいていて汗の量に個人差があり、ぽっちゃりの子が特に汗っかきだと嬉しいですが、発汗に伴う湯気は描いていただかなくて大丈夫です。\n\nお引き受けいただけるようでしたら、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/15Gzmb0nLKROjk32nGDqvRDUVqa1q_p1T/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/33", "thumbnail_src": "https://si.imgix.net/99a22066/uploads/origins/b6914c4a-d56a-4460-93a1-62f51817212d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aee3e4e9e156373428863595c1283c1", "thumbnail_srcset": "https://si.imgix.net/99a22066/uploads/origins/b6914c4a-d56a-4460-93a1-62f51817212d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aee3e4e9e156373428863595c1283c1, https://si.imgix.net/99a22066/uploads/origins/b6914c4a-d56a-4460-93a1-62f51817212d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4be7e0346b617c79b0f4ba4e64617358 2x, https://si.imgix.net/99a22066/uploads/origins/b6914c4a-d56a-4460-93a1-62f51817212d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b93816df666743653f2f33766ecc0e7 3x", "genre": "art", "nsfw": true, "body": "先日はお世話になりました！御都合よろしければ下記の内容をお願いしたいと思います。\n\nキャラクター：ルリナ（ポケモン）\n\nhttps://www.pixiv.net/artworks/123265959のルリナがとても好みなので、こちら絵の顔と体の向き、アングルは維持したままセックスに移行するイラストをお願いします。身体は全裸、体位の指定は無しで、騎乗位でも後背位でも。ルリナの体が遮られなければ正常位でもOKですのでお任せします。\n\n差分 （表情）\n・\t①待機 （期待）\n・\t②挿入（軽イキ）\n・\t③ピストン（快感）\n・\t④外出し（絶頂）\n・\t⑤全身精液でドロドロ（事後）\n表情は和姦だが笑顔でも苦悶顔でもなく、ひたすら自身の性欲の世界に浸ってる感じで（https://www.pixiv.net/artworks/121267507のカトレアさんに近い感じ）。事後では笑顔を見せてもOK。\n絶頂時はアヘに至らないくらいのトロ顔でお願いします。\n\nNG:涙目、唇や鼻穴が目立つ描き方、ボテ腹。\nご検討宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/32", "thumbnail_src": "https://si.imgix.net/b5805ad1/uploads/origins/92f86b79-810b-44f9-8899-35f718bf3b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da87f8a8afd34dd0e9277973cccadfdf", "thumbnail_srcset": "https://si.imgix.net/b5805ad1/uploads/origins/92f86b79-810b-44f9-8899-35f718bf3b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da87f8a8afd34dd0e9277973cccadfdf, https://si.imgix.net/b5805ad1/uploads/origins/92f86b79-810b-44f9-8899-35f718bf3b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca32736d61cf81e93fd404a463c44b88 2x, https://si.imgix.net/b5805ad1/uploads/origins/92f86b79-810b-44f9-8899-35f718bf3b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4969f88720db84dba326af9942be3f3a 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたのアートスタイルが大好きです。私の友人のoc、Drakefireの依頼を受けたいです。\n参照：https://drive.google.com/drive/folders/1BzSKI2z8Yt--_7NcfjqXt4HI0ovwzI95\nこのポーズでお願いします: https://photos.app.goo.gl/9xM3Tryy9kchi2jQ7\n右の男はこのoc、皇帝にしたいです: https://photos.app.goo.gl/38Av4PNyHqeCx8PPA\n左の男は無表情でいい。Drakefireに皇帝にキスしてほしい。あと、Drakefireの尻尾を左の男の首に巻いてほしい。あとはお任せします！\n\nhttps://drive.google.com/drive/folders/1p_abK2oCqS8lABrBIDzAmGH7Z-JJadX9", "created_at": "", "completed_at": ""}, {"path": "/@painting_fish/works/31", "thumbnail_src": "https://si.imgix.net/c540da3c/uploads/origins/e95889d5-d432-4ce1-9396-eb34b69f68ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42fb470de7bba2376d9f888e6bcdd608", "thumbnail_srcset": "https://si.imgix.net/c540da3c/uploads/origins/e95889d5-d432-4ce1-9396-eb34b69f68ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42fb470de7bba2376d9f888e6bcdd608, https://si.imgix.net/c540da3c/uploads/origins/e95889d5-d432-4ce1-9396-eb34b69f68ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d37a99a144c02fc567ca5e53928c7f 2x, https://si.imgix.net/c540da3c/uploads/origins/e95889d5-d432-4ce1-9396-eb34b69f68ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cr