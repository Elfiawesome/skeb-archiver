.net/5d6a4c0f/uploads/origins/d7b82ce0-fa18-4c74-b4cf-e6e1fc584d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f4bea562c21053fb4c0ef87313564ce", "thumbnail_srcset": "https://si.imgix.net/5d6a4c0f/uploads/origins/d7b82ce0-fa18-4c74-b4cf-e6e1fc584d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f4bea562c21053fb4c0ef87313564ce, https://si.imgix.net/5d6a4c0f/uploads/origins/d7b82ce0-fa18-4c74-b4cf-e6e1fc584d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=002f92a070b9d6461fd7f9344ac8817e 2x, https://si.imgix.net/5d6a4c0f/uploads/origins/d7b82ce0-fa18-4c74-b4cf-e6e1fc584d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d1c62afe7f8652a0898dded313e10d8 3x", "genre": "art", "nsfw": true, "body": "参考URLの一枚目の凍結イラストがとても好みなので依頼させていただきます！\nヘブンバーンズレッドの國見タマの凍結をお願いします。\n服装は頭の帽子と白いポンポン、それとマントを残して後は裸。\n参考URLのように台座付きで凍りついていて、ライトで照らされた状態で飾られているような感じでお願いします。\n\nhttps://www.pixiv.net/artworks/116598201", "created_at": "", "completed_at": ""}, {"path": "/@nonokoEM/works/19", "thumbnail_src": "https://si.imgix.net/78458497/uploads/origins/37fb7963-8d94-4990-a526-28ffe11f6ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b24de441019d4d2df6b9cb3a2997192a", "thumbnail_srcset": "https://si.imgix.net/78458497/uploads/origins/37fb7963-8d94-4990-a526-28ffe11f6ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b24de441019d4d2df6b9cb3a2997192a, https://si.imgix.net/78458497/uploads/origins/37fb7963-8d94-4990-a526-28ffe11f6ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d3eb7e4d1836766f5aaa5546abb0eb5 2x, https://si.imgix.net/78458497/uploads/origins/37fb7963-8d94-4990-a526-28ffe11f6ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f4b7e55bcb138df4fd6dca719608332 3x", "genre": "art", "nsfw": true, "body": "前回はイラストありがとうございました。再度リクエストさせていただきます。\n \nキャラクターはセシア・アウェアの金属板化をお願いします。\n \n下記URL2つはセシア・アウェアのイラストです。\n \nhttps://www.pixiv.net/artworks/75352603\n \nhttps://www.pixiv.net/artworks/33631967\n \n衣装はへそを出したビキニでお願いしたいです。 胸やおへそやふとももはみえるようにしてほしいです。（乳首を出して下さいという意味ではないです。） \n \n帽子や装飾品は外して大丈夫です。\n \n谷間や下乳がみえるようなビキニのデザインをお願いします。\n \n前回のイラストのような感じで、顔や胸やおへそやふとももの肌の光沢感も多めな感じでお願いしたいです。\n \n構図は前回と同じで真正面からでお願いします。 下記URLは以前丸薫さんに描いて頂いたイラストです。\nこちらのイラストのような感じでお願いします。 \n \nhttps://skeb.jp/@nonokoEM/works/15\n \n差分で金色の金属板化もお願いしたいです。\n \n 可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nonokoEM/works/18", "thumbnail_src": "https://si.imgix.net/c9441fd0/uploads/origins/a9b8fd05-62ae-4360-83a7-82e3b3aa2e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daaddbc3b494c078f2337e0600864c8c", "thumbnail_srcset": "https://si.imgix.net/c9441fd0/uploads/origins/a9b8fd05-62ae-4360-83a7-82e3b3aa2e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daaddbc3b494c078f2337e0600864c8c, https://si.imgix.net/c9441fd0/uploads/origins/a9b8fd05-62ae-4360-83a7-82e3b3aa2e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb87d4a6eb5c00a927f8ccaf45bda5db 2x, https://si.imgix.net/c9441fd0/uploads/origins/a9b8fd05-62ae-4360-83a7-82e3b3aa2e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b271c1efdcbdae95b4263be0dc349417 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nonokoEM/works/17", "thumbnail_src": "https://si.imgix.net/d3aea0de/uploads/origins/9ea2ec0c-75d3-40f8-a62e-95b643263cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b384e6ae7589c8f579b68f2507f2db", "thumbnail_srcset": "https://si.imgix.net/d3aea0de/uploads/origins/9ea2ec0c-75d3-40f8-a62e-95b643263cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b384e6ae7589c8f579b68f2507f2db, https://si.imgix.net/d3aea0de/uploads/origins/9ea2ec0c-75d3-40f8-a62e-95b643263cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c01bc58dc33743f0f97939de567e53c0 2x, https://si.imgix.net/d3aea0de/uploads/origins/9ea2ec0c-75d3-40f8-a62e-95b643263cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405cadb8c103669528b5ee78e443cc0a 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n龴სƷさんに描いていただきたいと思い、固めでリクエストさせていただきます。\nオリキャラのエヴァちゃんの金属化ををお願いします。\n\n概要：\n・服装は全裸\n・性器の描写は可能な範囲でモザイクや黒塗りが不要なレベルで簡素\n・瞳はあり（ハイライトオフ）\n・表情は快感に溺れた絶頂時の笑顔\n・ポーズは蹲踞で片手で乳首を弄って、もう片方はアナル（尻穴）に指を入れてる自慰姿勢。\n・描写アングルは斜め少し下から\n\nシチュエーション：\n発情状態でなんとか落ち着こうとするが、指が勝手に動いて自慰がやめられないエヴァ。\n足元から段々と金属化の波がせり上がっていく。\n身体が染まるほどに快感が強くなっていき、ラドくんの名前を連呼しながら自慰行為に溺れる。\n全身が銀色に染まり、絶頂の瞬間に金属化して固まる。\nその後、涙と涎を流しながら秘所から液体金属が弧を描いて噴き出す。\n\n可能であればほしい要望：\n・セリフ無し差分\n・液体金属を愛液に変えた差分\n・表情が放心して呆けた表情差分\n\n以上となります。\nご要望が多く大変申し訳ございません。\n何卒お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nonokoEM/works/16", "thumbnail_src": "https://si.imgix.net/db67617d/uploads/origins/00c2c0ff-3346-4886-a90d-4968e5d857f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe8fc553ea33cee6bd9fe3c21dae0e7", "thumbnail_srcset": "https://si.imgix.net/db67617d/uploads/origins/00c2c0ff-3346-4886-a90d-4968e5d857f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe8fc553ea33cee6bd9fe3c21dae0e7, https://si.imgix.net/db67617d/uploads/origins/00c2c0ff-3346-4886-a90d-4968e5d857f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c86dad84552e3cf9a098fbd086734961 2x, https://si.imgix.net/db67617d/uploads/origins/00c2c0ff-3346-4886-a90d-4968e5d857f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d02b69b94eee4c1229efd66700faa4d 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエストさせていただきます。\n\n【キャラクター】\n「GINKA」より\nギンカ（四ノ宮　銀花）\nhttps://imgur.com/a/7E0twZv\n（公式サイト）\nhttp://ginka.frontwing.jp/character/\n【シチュエーション】\nおとなの銀花と子供のギンカちゃん、\n二人とも「銀化」にさせて頂きたいです。\n瞳はなしで、\nそして服装は髪飾り以外全裸でお願いいたします。\nポーズや表情などお任せします。\n\n以上、ご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nonokoEM/works/15", "thumbnail_src": "https://si.imgix.net/8835f773/uploads/origins/146febc0-8dfe-4881-90ec-44640db4b8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=131b946910c3fd585eda520fa6e8671a", "thumbnail_srcset": "https://si.imgix.net/8835f773/uploads/origins/146febc0-8dfe-4881-90ec-44640db4b8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=131b946910c3fd585eda520fa6e8671a, https://si.imgix.net/8835f773/uploads/origins/146febc0-8dfe-4881-90ec-44640db4b8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fcb7c7517812d655656ed360ffb1ae1 2x, https://si.imgix.net/8835f773/uploads/origins/146febc0-8dfe-4881-90ec-44640db4b8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa0c1519d82fbb5cec0caeb9d33f2aa0 3x", "genre": "art", "nsfw": true, "body": "はじめまして。はじめてリクエストさせて頂きます。\n \nキャラクターは閃乱カグラの雪泉（ゆみ）の金属板化をお願いします。\n \n下記のURLは閃乱カグラの雪泉のイラストです。\n \nhttps://www.pixiv.net/artworks/112545493\n \n衣装はへそを出したビキニでお願いしたいです。上の水着は元の衣装に近い感じで、はだけている感じでお願いしたいです。\n \n胸やおへそやふとももはみえるようにしてほしいです。（乳首を出して下さいという意味ではないです。）\n \n構図は真正面からでお願いします。\n \n下記URLは以前丸薫さんが描いたイラストです。こちらのイラストのような感じでお願いします。\n \n \nhttps://skeb.jp/@nonokoEM/works/7\n \n可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nonokoEM/works/14", "thumbnail_src": "https://si.imgix.net/1505e336/uploads/origins/eb32d632-393b-47bd-9502-a357e5d2200c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d8635a