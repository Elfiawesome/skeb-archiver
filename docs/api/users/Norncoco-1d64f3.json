a30-4f9e-b37a-26fde9d802f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7b088ba31fc53cd6629da2449064f7c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Norncoco/works/23", "thumbnail_src": "https://si.imgix.net/d97a1ba3/uploads/origins/5c5548d4-c3f2-40ac-98be-1e1cef92255d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ba14f27793362e253a347a61605a33", "thumbnail_srcset": "https://si.imgix.net/d97a1ba3/uploads/origins/5c5548d4-c3f2-40ac-98be-1e1cef92255d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ba14f27793362e253a347a61605a33, https://si.imgix.net/d97a1ba3/uploads/origins/5c5548d4-c3f2-40ac-98be-1e1cef92255d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19f49fafc2fafc06f2e80786562361a4 2x, https://si.imgix.net/d97a1ba3/uploads/origins/5c5548d4-c3f2-40ac-98be-1e1cef92255d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f696f9fbba981f761557d840b52dba68 3x", "genre": "art", "nsfw": false, "body": "のるんさんこんにちは 𝜗𝜚\nKobiです。お世話になっております。\n\nこのたび、私のOCちゃん二人組をのるんさんに描いていただきたく、、(⑉• •⑉)、\n\n★左側の‎🤍色のキャラクター、チャイ\n★右側の🤎色のキャラクター、リン\n\nふたりコンビで一枚の絵を、よろしければお描きいただけますでしょうか。\n\nまた、もしおねだん見合わない場合がございましたら\nお好きなほうの子をひとりにもう片方の子の色のハートをどこかに入れた絵\n(たとえば 🤎色の子が‎🤍色のハートを抱いている や ‎🤍色の子の背景に🤎色のハートがある など)\nを一枚描いていただきたいです。\n\nhttps://x.com/kbias21/status/1986419183408881799?s=46", "created_at": "", "completed_at": ""}, {"path": "/@Norncoco/works/22", "thumbnail_src": "https://si.imgix.net/8db79b00/uploads/origins/194c225a-bbf6-4c5f-b675-5dbd3f4f60a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c41f3d43e0dc15d4381360053180ab44", "thumbnail_srcset": "https://si.imgix.net/8db79b00/uploads/origins/194c225a-bbf6-4c5f-b675-5dbd3f4f60a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c41f3d43e0dc15d4381360053180ab44, https://si.imgix.net/8db79b00/uploads/origins/194c225a-bbf6-4c5f-b675-5dbd3f4f60a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfce0cddefe1b96c41151d94b9eceee6 2x, https://si.imgix.net/8db79b00/uploads/origins/194c225a-bbf6-4c5f-b675-5dbd3f4f60a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2855fbd5f257d9b3a76109c66f1423f5 3x", "genre": "art", "nsfw": false, "body": "のるん先生こんにちは。\n\nアークナイツというゲームの、クルースもしくは寒芒クルースというキャラクターをお願いしたいです。\n服装は問いません。ゲームに準じていなくて大丈夫です。\nどちらかと言うと、かわいらしくファンタジーな感じが好みですが、構図やポーズ、描画範囲などお任せします。\n\nPCの壁紙への使用を考えております。\n\nよろしくお願い致します。\n\nhttps://arknights.wikiru.jp/index.php?%E3%82%AF%E3%83%AB%E3%83%BC%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@Norncoco/works/21", "thumbnail_src": "https://si.imgix.net/b9844a5e/uploads/origins/699a257f-e1df-4a10-b172-4f9405f1b33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a95378ebb4ca7dbc8a85aa7de57fac", "thumbnail_srcset": "https://si.imgix.net/b9844a5e/uploads/origins/699a257f-e1df-4a10-b172-4f9405f1b33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a95378ebb4ca7dbc8a85aa7de57fac, https://si.imgix.net/b9844a5e/uploads/origins/699a257f-e1df-4a10-b172-4f9405f1b33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=198e452f661d968ec14143d000e3dfdb 2x, https://si.imgix.net/b9844a5e/uploads/origins/699a257f-e1df-4a10-b172-4f9405f1b33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3765ac93000ea75c494f624e5171a1a 3x", "genre": "art", "nsfw": true, "body": "内容修正し再リクエスト致します。以下の設定のオリジナルの女の子のイラストをお願いします。 \n\nヘアスタイル:黒髪のおさげっぽいツインテール\n体格:身長150センチくらいで胸はCからDカップくらい\n服装:メイドビキニ。黒地で白のレースやフリル等の装飾。 マイクロビキニではないが下乳が見える布面積。\n表情:大人しい子が露出が多い水着で恥ずかしがってる感じ\n\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Norncoco/works/20", "thumbnail_src": "https://si.imgix.net/cbd8721