6:43.642042+00:00"}, {"amount": 14000, "recorded_at": "2026-02-25T05:35:01.758620+00:00"}, {"amount": 13000, "recorded_at": "2026-02-25T12:25:44.573447+00:00"}]}, "current_prices": {"art": 13000}, "price_range": {"art": {"min": 8000, "max": 22000}}, "links": [{"label": "Twitter", "url": "https://x.com/iro_iro_iroo", "name": "iro_iro_iroo"}, {"label": "Website", "url": "https://lit.link/iroiron", "name": ""}], "flags": {"from_archive": true}, "works": [{"path": "/@iro_iro_iroo/works/169", "thumbnail_src": "https://si.imgix.net/a8d51af1/uploads/origins/47e70081-76b2-4ac2-b7b3-e84e45bc4ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fee92eae0354a0ec84f4b0cccd428c75", "thumbnail_srcset": "https://si.imgix.net/a8d51af1/uploads/origins/47e70081-76b2-4ac2-b7b3-e84e45bc4ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fee92eae0354a0ec84f4b0cccd428c75, https://si.imgix.net/a8d51af1/uploads/origins/47e70081-76b2-4ac2-b7b3-e84e45bc4ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9db38e952c79051e3c04457fd8deed9 2x, https://si.imgix.net/a8d51af1/uploads/origins/47e70081-76b2-4ac2-b7b3-e84e45bc4ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61a5f2109951dcd6c04d8234d02ca5ad 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの画風がとても好きです。特にあなたの絵のスタイルを高く評価しているので、私のオリジナルキャラクターのイラストを描いていただけませんか。\n彼女はカフェの猫メイドで、表情やポーズは完全にあなたの自由にお任せします。お返事ありがとうございます。\n今回は16：9の壁紙を1枚描いていただけませんか？背景はシンプルで結構です。ぜひお願いしたいです！\n 設定https://drive.google.com/file/d/1t8al2oe8HNZrTkBkrEulRTkHzNzVx-a9/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@iro_iro_iroo/works/168", "thumbnail_src": "https://si.imgix.net/f25b8487/uploads/origins/ae694360-7b04-4ca5-a625-b79f75a635f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bf62f0a5c62ceac12094be8a68834d6", "thumbnail_srcset": "https://si.imgix.net/f25b8487/uploads/origins/ae694360-7b04-4ca5-a625-b79f75a635f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bf62f0a5c62ceac12094be8a68834d6, https://si.imgix.net/f25b8487/uploads/origins/ae694360-7b04-4ca5-a625-b79f75a635f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34aabf1a6765b21b637c2a27fb3f71f2 2x, https://si.imgix.net/f25b8487/uploads/origins/ae694360-7b04-4ca5-a625-b79f75a635f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d87e062c635ae2d0035879b2d00c4877 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n作品の雰囲気に惹かれて、Skebよりリクエストさせていただきました。\nSkebの仕様（修正不可・お任せ前提）を理解した上での依頼です。\n\n本作品はプレゼント用のイラストになります。\n贈る相手が、最近とても大切にしていたインコを亡くしてしまい、\n少しでもその子とのあたたかい思い出を形に残せたらと思い、\n今回リクエストさせていただきました。\n\n悲しい雰囲気にはせず、\nやさしく、穏やかで、見たときに心が少しあたたかくなるような一枚になると嬉しいです。\n\n⸻\n\n■ キャラクターデザイン\n\n以下のオリジナルキャラクターを描いていただきたいです。\n\t•\t性別：女性\n\t•\t年齢感：10代後半〜20代前半\n\t•\t体型：華奢で細身\n\t•\t肌：色白でやわらかい印象\n\n髪・顔\n\t•\t髪色：淡いピンク（パステル寄り）\n\t•\t髪型：ツインテール（高すぎず、自然に垂れる位置）\n\t•\t前髪：眉が少し隠れる長さ\n\t•\t目：\n\t•\t大きめ\n\t•\t青〜水色系\n\t•\t透明感があり、うるっとした表現\n\t•\t表情：\n\t•\t控えめな微笑み\n\t•\tおっとりしていて優しい雰囲気\n\t•\t甘めだが子どもっぽくなりすぎない\n\n⸻\n\n■ 服装（春らしい装い）\n\n全体的に春っぽく、やわらかく落ち着いた雰囲気でお願いします。\n\t•\tアウター：\n\t•\t膝丈〜ミドル丈の淡いアイボリー系コート\n\t•\t少しゆるっとしたシルエット\n\t•\tトップス：\n\t•\t白〜生成りのブラウス\n\t•\tふんわりした袖\n\t•\tボトムス：\n\t•\tブラウン系のチェック柄スカート\n\t•\tロング丈〜ミモレ丈\n\t•\t足元：\n\t•\tダークブラウン系の靴（ローファーまたはショートブーツ）\n\n⸻\n\n■ 動物モチーフ\n\n① 肩にハムスター\n\t•\t位置：女の子の片方の肩\n\t•\t種類イメージ：一般的なハムスター\n\t•\t色味：ベージュ〜薄茶系\n\t•\t表情：きょとんとして穏やか\n\t•\tサイズ感：\n\t•\t小さめ\n\t•\tマスコット寄り\n\t•\t重さを感じさせない存在感\n\n② お腹にトイプードル\n\t•\t抱き方：赤ちゃんを抱くように、両腕で大切に抱えている\n\t•\t犬種：トイプードル\n\t•\t特徴：\n\t•\t目が大きく、くりっとしている\n\t•\tふわふわの毛並み\n\t•\tサイズ感：\n\t•\t小さめ\n\t•\t腕の中にすっぽり収まる程度\n\n③ インコ（思い出の存在）\n\t•\t表現：\n\t•\t女の子や他の動物たちにやさしく寄り添う存在\n\t•\t種類イメージ：コザクラインコ系\n\t•\t色味：\n\t•\t頭〜顔：淡い黄色〜薄いオレンジ\n\t•\t体：黄色\n\t•\tくちばし：小さめ・淡い黄色\n\t•\t表情：穏やか、きょとんとした印象\n\t•\tサイズ感：\n\t•\t実物よりややデフォルメ\n\t•\t世界観に自然に馴染む程度\n\n※インコは主張しすぎず、\n大切な思い出として静かにそこにいるような存在感だと嬉しいです。\n\n⸻\n\n■ 構図・画面\n\t•\t構図：女の子座りに近い感じ、トイプードルを抱き抱えている。頭にインコ、肩にハムスターでよじ登ってたら面白いかも\n\n⸻\n\n■ 全体の雰囲気\n\t•\tふわっとしていて、愛するペット達を大切にしてる感じ\n\n細かく書いてしまいすみません💦\n何卒よろしくお願い申し上げます🙇", "created_at": "", "completed_at": ""}, {"path": "/@iro_iro_iroo/works/167", "thumbnail_src": "https://si.imgix.net/232361af/uploads/origins/f0377526-73e0-4254-afd7-2c08ea5ae41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d53a16205a61a15f51d3156480853e4", "thumbnail_srcset": "https://si.imgix.net/232361af/uploads/origins/f0377526-73e0-4254-afd7-2c08ea5ae41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d53a16205a61a15f51d3156480853e4, https://si.imgix.net/232361af/uploads/origins/f0377526-73e0-4254-afd7-2c08ea5ae41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5281512cb23c770a10312e4f7771a084 2x, https://si.imgix.net/232361af/uploads/origins/f0377526-73e0-4254-afd7-2c08ea5ae41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dda65fb0db0c4fec4f5df91f1f85746a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、iroN先生！あなたの作品が大好きで、依頼を送りたいです！\n\nイラストの構図と背景はお任せします。参考資料は下のリンクにあります。\n\nまた可能でしたらデータはpsdで、キャラと背景のレイヤーを分けて頂けますと幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1A0nJNC5u0od5kAcVdYf5YFq01_DbzwvK?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@iro_iro_iroo/works/166", "thumbnail_src": "https://si.imgix.net/6439be3c/uploads/origins/07642abe-c6bc-4482-b0dc-4db4baea95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24c0bb83495b7c8ece54968a1474a423", "thumbnail_srcset": "https://si.imgix.net/6439be3c/uploads/origins/07642abe-c6bc-4482-b0dc-4db4baea95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24c0bb83495b7c8ece54968a1474a423, https://si.imgix.net/6439be3c/uploads/origins/07642abe-c6bc-4482-b0dc-4db4baea95e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b97dbd7d421e5839aedda136316dbd3 2x, https://si.imgix.net/6439b