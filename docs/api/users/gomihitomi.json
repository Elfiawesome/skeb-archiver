-a991-3a0b9e8a71de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbe02ea53f912f1fa7190f3fd5ac07c1", "thumbnail_srcset": "https://si.imgix.net/7098fbfe/uploads/origins/2c0270d1-15d4-4763-a991-3a0b9e8a71de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbe02ea53f912f1fa7190f3fd5ac07c1, https://si.imgix.net/7098fbfe/uploads/origins/2c0270d1-15d4-4763-a991-3a0b9e8a71de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bf92d7b9d8e7a439c232a81f2f5d55f 2x, https://si.imgix.net/7098fbfe/uploads/origins/2c0270d1-15d4-4763-a991-3a0b9e8a71de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57f5abf8dbc461696ca6cf5957c20510 3x", "genre": "art", "nsfw": false, "body": "Vtuberとして個人で活動を行っている尾花そこつと申します。\n\n【リクエスト】\n尾花そこつを描いてください。\nそれ以外はおまかせ致します。\n\n【可能であれば】※必須ではありません\n・透過をお願いします。\nPSDでの納品の場合、こちらで操作出力可能です。\n\n【利用について】\n各種SNSおよび動画配信サイトで使用させて頂きたいです。\n差し支え無ければ、吾味さんに描いていただいた事を見せびらかしたいので、グッズにして販売したいです。\n使用の際は可能な場においては都度、吾味人美さんのお名前を記載させて頂きます。\nご執筆頂いたイラストを元にFAが描かれる等、第三者がアイデアを引用する可能性もありうることもご考慮の上、受注を検討頂ければ幸いです。\n\n資料URLについて\nindex>詳細>profile(スクロールして頂くと、作画資料がございます)\n\nhttps://obanasokotsu.futene.net/", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/14", "thumbnail_src": "https://si.imgix.net/87abae78/uploads/origins/49570e31-3761-4540-bfb5-e051f57e1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d53a6c086515ede4938ecf3f08e35e9f", "thumbnail_srcset": "https://si.imgix.net/87abae78/uploads/origins/49570e31-3761-4540-bfb5-e051f57e1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d53a6c086515ede4938ecf3f08e35e9f, https://si.imgix.net/87abae78/uploads/origins/49570e31-3761-4540-bfb5-e051f57e1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44af5128124a270e736eba5f2882babc 2x, https://si.imgix.net/87abae78/uploads/origins/49570e31-3761-4540-bfb5-e051f57e1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=939780dbe6630fe5299d2c1dac050c6d 3x", "genre": "art", "nsfw": false, "body": "いつも素晴らしい作品をありがとうございます．\n他に無い独特のタッチが大好きなのでリクエストさせていただきます．\n\nオリジナルキャラクター(①②③)の制服姿のイラストをお願いします．\nダウナーな見た目だけど明るいキャラという雰囲気を表現していただけるとありがたいです，\nポーズはお任せで，塗りは(④⑤⑥)のような雰囲気で仕上げていただきたいです．\n可能であれば線はクリンナップしすぎずほどよくざらつきを残したようなタッチ(⑦)であるとありがたいです．難しいリクエストで申し訳ございません．\n\n金額が足りない事による再送は構いませんので何卒よろしくお願いします．\n\n①https://x.com/nann_kyoku368/status/1921666403259519217?s=20\n②https://x.com/nann_kyoku368/status/1695452227610296744/photo/1\n③https://x.com/nann_kyoku368/status/1731336192044806656/photo/1\n\n④https://x.com/gomihitomi/status/1908847399289880930/photo/1\n⑤https://x.com/gomihitomi/status/1711760505420075183/photo/1\n⑥https://x.com/gomihitomi/status/1679867044198752256/photo/1\n\n⑦https://x.com/gomihitomi/status/1909940877784670523/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/13", "thumbnail_src": "https://si.imgix.net/6446391c/uploads/origins/39ed8a83-7fff-404c-9e5b-3b2ef33b6b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd68eebfe899bacf5893a3b006c3e892", "thumbnail_srcset": "https://si.imgix.net/6446391c/uploads/origins/39ed8a83-7fff-404c-9e5b-3b2ef33b6b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd68eebfe899bacf5893a3b006c3e892, https://si.imgix.net/6446391c/uploads/origins/39ed8a83-7fff-404c-9e5b-3b2ef33b6b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f46e609f7e47d3c7ade0a4f6ac3097f 2x, https://si.imgix.net/6446391c/uploads/origins/39ed8a83-7fff-404c-9e5b-3b2ef33b6b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce674c661b9376e2b3d771e6722964e3 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！\nごみさんの作風が好きなのでぜひお願いします！！\nイメージなのですが、ジト目でやる気の無さそうな女性ドクターを描いて欲しいです！\nヤブ医者っぽい雰囲気を出しつつ、金さえあればキッチリ治療する雰囲気、イメージでお願いしますー！\n\nかなり大雑把なのですがそれでもよければお願いしますー！", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/12", "thumbnail_src": "https://si.imgix.net/49cd0110/uploads/origins/9dc48f75-218d-4682-b165-7b141227e2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3478854ea9e748d12d17b2ed1618030", "thumbnail_srcset": "https://si.imgix.net/49cd0110/uploads/origins/9dc48f75-218d-4682-b165-7b141227e2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3478854ea9e748d12d17b2ed1618030, https://si.imgix.net/49cd0110/uploads/origins/9dc48f75-218d-4682-b165-7b141227e2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8658478861f2efc06e652ff0daf08cf1 2x, https://si.imgix.net/49cd0110/uploads/origins/9dc48f75-218d-4682-b165-7b141227e2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4e143c0a06a1019bae16f080f1c64ac 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nスケブを開けてくださりありがとうございます。\nイラストの依頼をお願いします。\n\n用途:個人\nカラー、サイズ等:おまかせ\n内容:申し訳なさそうな顔で得体の知れないものが入った鍋を手に「作りすぎちゃいました」みたいなセリフとともに玄関に立っている吾味人美様\n\n可能な範囲で構いません\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/11", "thumbnail_src": "https://si.imgix.net/896401c1/uploads/origins/8cbb19f8-bbe5-4cd4-8851-34644b4d3fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cb9b04ce8b4f30e5e235dc6a10cd0ac", "thumbnail_srcset": "https://si.imgix.net/896401c1/uploads/origins/8cbb19f8-bbe5-4cd4-8851-34644b4d3fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cb9b04ce8b4f30e5e235dc6a10cd0ac, https://si.imgix.net/896401c1/uploads/origins/8cbb19f8-bbe5-4cd4-8851-34644b4d3fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5380ba534b8e873ffd2c4c12395d70c7 2x, https://si.imgix.net/896401c1/uploads/origins/8cbb19f8-bbe5-4cd4-8851-34644b4d3fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=650d1c8ff2549fbdd2c7de84132df365 3x", "genre": "art", "nsfw": false, "body": "吾味人美さんこんにちは！\nうちのこのミ六ねーちゃんを描いて頂く事は可能でしょうか？\n\nグレー等ではない黒白目は必須、\n（黒目部分はほぼ真っ黒、白目部分は明るめに描いて頂けるとそれっぽくなると思います！）\n後は資料の通り、長身のキョンシーもどき三十路お姉さんという感じです。\n衣装は私服でお願いいたします。\n\n構図は「おっぱいのついたイケメンお姉さん」という感じを出して頂けると嬉しいです！\nよろしければ、よろしくお願いいたします！\n\n\nhttps://www.pixiv.net/artworks/101499034\nhttps://www.pixiv.net/artworks/103383407\nhttps://www.pixiv.net/artworks/105242041\n\nhttps://www.pixiv.net/artworks/102692975", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/10", "thumbnail_src": "https://si.imgix.net/e7865158/uploads/origins/4eca7446-aca1-45f8-a229-479537ce8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7301b4d51c248e3dec6684bd27896ef", "thumbnail_srcset": "https://si.imgix.net/e7865158/uploads/origins/4eca7446-aca1-45f8-a229-479537ce8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7301b4d51c248e3dec6684bd27896ef, https://si.imgix.net/e7865158/uploads/origins/4eca7446-aca1-45f8-a229-479537ce8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5129661e793c011c832ec668020e5956 2x, https://si.imgix.net/e7865158/uploads/origins/4eca7446-aca1-45f8-a229-479537ce8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad5ff1b213bfa291177a3a14a49f84cc 3x", "genre": "art", "nsfw": false, "body": "はじめまして。いつも楽しませていただいています。小倉自転車という自転車素材屋をやっている吉田といいます。ツイッター用のアイコン作りたいなと思っていたところ、リクエスト募集のポストを見つけました。適当なことばかり言ってる、性格の悪いロボットとか描いていただけますでしょうか？お任せとあるので、そういうの一切受け付けないというのであればおまかせで構いません。吾味さんのアイコンかわいいなといつも思ってたので線画がよいです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/9", "thumbnail_src": "https://si.imgix.net/887291aa/uploads/origins/930de730-12d6-4807-ae0a-5c1362a33ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0dede6f3047387f2332537238d3625b", "thumbnail_srcset": "https://si.imgix.net/887291aa/uploads/origins/930de730-12d6-4807-ae0a-5c1362a33ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0dede6f3047387f2332537238d3625b, https://si.imgix.net/887291aa/uploads/origins/930de730-12d6-4807-ae0a-5c1362a33ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa813e81709cc6ccb6d661c94fb00f2c 2x, https://si.imgix.net/887291aa/uploads/origins/930de730-12d6-4807-ae0a-5c1362a33ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38a0a991decd10ceae72a5c9722dbcca 3x", "genre": "art", "nsfw": false, "body": "吾味人美一連ガチャ！？\nｶﾞﾁｬｶﾞﾁｬ\n\n　ﾋﾟｶｰ\n\n【N】コンビニ吾味人美「金のワッフルコーンか、雪見だいふくか、」\n\n...の絵を描いてください。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/8", "thumbnail_src": "https://si.imgix.net/749afea8/uploads/origins/87be1b3e-0d8b-4011-b9ee-297f10175404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=921ce58bebea678097618ec26d152d7d", "thumbnail_srcset": "https://si.imgix.net/749afea8/uploads/origins/87be1b3e-0d8b-4011-b9ee-297f10175404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=921ce58bebea678097618ec26d152d7d, https://si.imgix.net/749afea8/uploads/origins/87be1b3e-0d8b-4011-b9ee-297f10175404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1ef0b421a42fa3fd13669fd7420adf3 2x, https://si.imgix.net/749afea8/uploads/origins/87be1b3e-0d8b-4011-b9ee-297f10175404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbcb1d2c3c0be8ae03eaf8d962d9d3fb 3x", "genre": "art", "nsfw": false, "body": "バニーガール着て人参齧ってくれ吾味人美", "created_at": "", "completed_at": ""}, {"path": "/@gomihitomi/works/7", "thumbnail_src": "https://si.imgix.net/83486b57/uploads/origins/d9b9899c-a443-4b59-8dd9-e82f714c8c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94e05199ef792a435ca520e87805842f", "thumbnail_srcset": "https://si.imgix.net/83486b57/uploads/origins/d9b9899c-a443-4b59-8dd9-e82f714c8c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20