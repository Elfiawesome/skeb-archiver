らとても嬉しいなと考えております。\n見えない部分のデザイン等おまかせする形になってしまうので、お値段など不足でしたら断わって頂いて大丈夫ですし、気楽に描いてもらえたらと思います。\n\n体勢なども自由で、画像を使用予定も今のところはないので、サイズ比など描きやすい形で大丈夫です。\n\n是非よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JGMVSnfwrJFN-lg7Igj8gVA1iTxji9Yp", "created_at": "", "completed_at": ""}, {"path": "/@yosuzu_dragon/works/14", "thumbnail_src": "https://si.imgix.net/be1f3f19/uploads/origins/3690a817-3ee0-4fce-a867-b2bda6d69b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a40773d434202e16117891b5e098a63b", "thumbnail_srcset": "https://si.imgix.net/be1f3f19/uploads/origins/3690a817-3ee0-4fce-a867-b2bda6d69b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a40773d434202e16117891b5e098a63b, https://si.imgix.net/be1f3f19/uploads/origins/3690a817-3ee0-4fce-a867-b2bda6d69b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e7fbaea4c378d18d43182fb48d203d0 2x, https://si.imgix.net/be1f3f19/uploads/origins/3690a817-3ee0-4fce-a867-b2bda6d69b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36acf201ec596fc34727161c00c7aeec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yosuzu_dragon/works/13", "thumbnail_src": "https://si.imgix.net/08e59622/uploads/origins/1756f895-1258-42c1-8003-39463138bb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10fb0026af439d77102b90a8d3858f2d", "thumbnail_srcset": "https://si.imgix.net/08e59622/uploads/origins/1756f895-1258-42c1-8003-39463138bb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200