好きに描いていただけましたら幸いです。内容は、可能であればギャグか恋愛よりだと嬉しいです。松本さんの解釈にお任せ致します。\n\n金額不足等ありましたら再送またはキャンセルしていただければと思います。機会がありましたらよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Franchise_Matsu/works/45", "thumbnail_src": "https://si.imgix.net/3b7b2152/uploads/origins/fd347e94-bf35-4959-8c28-576c78002670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39442ad6f5c56509bcf4d0737d665822", "thumbnail_srcset": "https://si.imgix.net/3b7b2152/uploads/origins/fd347e94-bf35-4959-8c28-576c78002670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39442ad6f5c56509bcf4d0737d665822, https://si.imgix.net/3b7b2152/uploads/origins/fd347e94-bf35-4959-8c28-576c78002670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fe554766885c38ca27a419a7aab8042 2x, https://si.imgix.net/3b7b2152/uploads/origins/fd347e94-bf35-4959-8c28-576c78002670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fbade58c26b5d4258c69512b801b8a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Franchise_Matsu/works/44", "thumbnail_src": "https://si.imgix.net/cf6179fe/uploads/origins/87ec75fb-3e43-4088-a583-9e0716dd53f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8693a4d6e2016e722273d3c5354c61c9", "thumbnail_srcset": "https://si.imgix.net/cf6179fe/uploads/origins/87ec75fb-3e43-4088-a583-9e0716dd53f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8693a4d6e2016e722273d3c5354c61c9, https://si.imgix.net/cf6179fe/uploads/origins/87ec75fb-3e43-4088-a