a-8ae5ea6b9f13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7176a1565423a23b02980fb931f93d7", "thumbnail_srcset": "https://si.imgix.net/17e9742b/uploads/origins/c39abe41-6797-41a0-bc9a-8ae5ea6b9f13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7176a1565423a23b02980fb931f93d7, https://si.imgix.net/17e9742b/uploads/origins/c39abe41-6797-41a0-bc9a-8ae5ea6b9f13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c2b7556fc2214391696a8b841d97fd3 2x, https://si.imgix.net/17e9742b/uploads/origins/c39abe41-6797-41a0-bc9a-8ae5ea6b9f13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=415d43eeb9d728b39921bfb03f855ca3 3x", "genre": "art", "nsfw": true, "body": "イラストの依頼です\n自キャラのソラちゃんhttps://misskey.io/notes/9rwsi50vsiqg0duk\nのイラストを描いていただきたいです\n\n？マーク浮かべたおまたのドアップで\nぷにゅまんっ💗　っておまんこからえっちな擬音出てて欲しいです！\n\n以上の内容でご検討よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/31", "thumbnail_src": "https://si.imgix.net/766f6a2b/uploads/origins/f83b0a0a-f6a8-4efe-8802-dc8039397cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b636adaf6b80a02073eac7f83d0f9d3", "thumbnail_srcset": "https://si.imgix.net/766f6a2b/uploads/origins/f83b0a0a-f6a8-4efe-8802-dc8039397cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b636adaf6b80a02073eac7f83d0f9d3, https://si.imgix.net/766f6a2b/uploads/origins/f83b0a0a-f6a8-4efe-8802-dc8039397cca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c2d805ed331471d4a5cacb73b17dfe 2x, https://si.imgix.net/766f6a2b/uploads/origins/f83b0a0a-f6a8-4efe-8802-dc8039397cca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6aa5c94f7b6ca3edee0a3fb1fab74d1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nVtuberの絵は描きますか？なければ遠慮なく断ってください。\n\nvtuberのchromuchromuさんのoc、trashcatを描いてほしいです。\n彼女は平らです。しっぽと耳と頭のピンクのリボンがチャームポイントです。\n\nスクール水着を着てオシッコに必死な彼女を描いてくれませんか？\n予算内であれば、お漏らしのバリエーションも大歓迎です。\n恥ずかしがって顔を赤らめているはずです。\n股間重視が理想。\nマンコが見えていてもOK。\nその他はお任せします。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1stLvRnf8iUWRQgKMlXs81NXaUOvCv3Cq", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/30", "thumbnail_src": "https://si.imgix.net/fb91c6be/uploads/origins/a45c5033-4c3a-422a-a9b0-8f6c06db6e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73224498ad2a9fb0ddcca194669add69", "thumbnail_srcset": "https://si.imgix.net/fb91c6be/uploads/origins/a45c5033-4c3a-422a-a9b0-8f6c06db6e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73224498ad2a9fb0ddcca194669add69, https://si.imgix.net/fb91c6be/uploads/origins/a45c5033-4c3a-422a-a9b0-8f6c06db6e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb5962e3a6a8fff0dcd4275471e6c6f5 2x, https://si.imgix.net/fb91c6be/uploads/origins/a45c5033-4c3a-422a-a9b0-8f6c06db6e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea7c9ab240daf4183845d1f04bce3aa8 3x", "genre": "art", "nsfw": true, "body": "衣装チェンジ第二弾！と言った所で、\n今度はカティちゃんとししょーの衣装をチェンジして頂きたいと思います。\n\nカティちゃん側からの衣装もししょー側の衣装も一番よく着ているデフォの物に限らず、\n入れ替えに使うならこれだ！と思ったもので構いません。\n例）\nカティちゃん提供が踊り子服などでもOK！\nししょー提供が昔の軍服などでもOK！\n\nまたあからさまなスケベも欲しい！と思いましたので2ページ目としてカティちゃんの服を着たししょーのエッチなくぱぁをお願いしたいと思います。\nパンツずらしくぱぁ等、くぱらせ方はお任せいたします。\n（今回はカティちゃんのくぱぁは必須ではありません）\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1b5KNe8vOsA5UjAatG45zl1hFQLfYfD_T/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/29", "thumbnail_src": "https://si.imgix.net/9ab3efb8/uploads/origins/415ff616-bca8-4deb-95c3-a80d1ae422dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c401a8dc1a937bb06de79bd5aeb31ab", "thumbnail_srcset": "https://si.imgix.net/9ab3efb8/uploads/origins/415ff616-bca8-4deb-95c3-a80d1ae422dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c401a8dc1a937bb06de79bd5aeb31ab, https://si.imgix.net/9ab3efb8/uploads/origins/415ff616-bca8-4deb-95c3-a80d1ae422dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d40cbce49641ab701269bfbbb0dbc8f7 2x, https://si.imgix.net/9ab3efb8/uploads/origins/415ff616-bca8-4deb-95c3-a80d1ae422dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc02407181dc3c660ef78be25eb14e9e 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです、募集開始されたのでまた依頼の話をしようと思います\n\n東方虹龍洞の管牧典の膣から中出しした精液を試験管に詰める絵をお願いしたいです\n\n流れとしては①試験管に精液と愛液が混ざった液体の採取という謎の目的を達そうと一生懸命交わる典\n②しかし頑張りすぎて疲れてしまい中に出されまくった精液を指で掬って試験管に詰めてほしいと相手にお願い\n③膣から指で掬って試験管にちまちま詰めていく\n④思った以上に時間がかかるので膣に試験管を当てがう\n⑤お腹を押して精液を試験管に放出させる\n⑥最後に膣を広げて精液が残ってないか確認して〆(お腹を突然押されてびっくりしたのか少しムスッとしてる典)\n\n難しければ行為すっ飛ばして事後からの②からでも\n可能ならば線修正を希望します。\n\nまた特殊なシチュかと思われますが…宜しくお願い致しますわ", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/28", "thumbnail_src": "https://si.imgix.net/de1e25ba/uploads/origins/06bcb9d8-2375-44eb-a741-bc03d26cae39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5786732c66a18d83e7a0d67e9e68281", "thumbnail_srcset": "https://si.imgix.net/de1e25ba/uploads/origins/06bcb9d8-2375-44eb-a741-bc03d26cae39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5786732c66a18d83e7a0d67e9e68281, https://si.imgix.net/de1e25ba/uploads/origins/06bcb9d8-2375-44eb-a741-bc03d26cae39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e31fab90d0eaeeaac97efaccd75740e 2x, https://si.imgix.net/de1e25ba/uploads/origins/06bcb9d8-2375-44eb-a741-bc03d26cae39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfbf72ed7898c02cadb40e5839ce7ec7 3x", "genre": "art", "nsfw": true, "body": "ジャングル・ブックに出てくる蛇のカーに催眠術をかけられ、犯される全裸の猫娘を参考にしたい。青と黄色の催眠術をかけたような目をして、幸せそうな顔をしてください。もしよろしければ、素足が見えるようにしてください。よろしくお願いします！\n\nhttps://x.com/basshie_P/status/1476921555787853830\nhttps://www.pixiv.net/e