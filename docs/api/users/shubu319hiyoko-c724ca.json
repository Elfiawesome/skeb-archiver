23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8e56ae4b8d037235fdbfd7660e3713c 2x, https://si.imgix.net/61bced7a/uploads/origins/a1abb588-7956-4c96-aace-0c406b8bf4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff2b5eb4af44bd4569223b72e2103245 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/11", "thumbnail_src": "https://si.imgix.net/e1d4a87f/uploads/origins/a815d504-a736-4304-af22-7f5b9c404ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fb0de3bbcdb9f60d0ab3652c9138591", "thumbnail_srcset": "https://si.imgix.net/e1d4a87f/uploads/origins/a815d504-a736-4304-af22-7f5b9c404ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fb0de3bbcdb9f60d0ab3652c9138591, https://si.imgix.net/e1d4a87f/uploads/origins/a815d504-a736-4304-af22-7f5b9c404ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a08f2fd70f146c4ac90bf9a20fe2fdcc 2x, https://si.imgix.net/e1d4a87f/uploads/origins/a815d504-a736-4304-af22-7f5b9c404ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe2be5a7e0afaa1dabf4e0350d160761 3x", "genre": "art", "nsfw": true, "body": "こんばんは、初めまして。\n\nぷにぷにした絵柄に惹かれて依頼させて頂きに参りました。\n\n資料にあるうちのエルフを描いて頂きたいです。\n\n構図などはお任致します。\n\nよろしくお願いします。\n\nhttps://mobile.twitter.com/marion_sera/status/1388481474479857664", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/10", "thumbnail_src": "https://si.imgix.net/e0d51da5/requests/179193_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a3d9af7425e62a762570f0dcb4c2620", "thumbnail_srcset": "https://si.imgix.net/e0d51da5/requests/179193_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a3d9af7425e62a762570f0dcb4c2620, https://si.imgix.net/e0d51da5/requests/179193_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc44cf5dbaab80e77f88e691268f8995 2x, https://si.imgix.net/e0d51da5/requests/179193_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fa35d3c3f24793003c224b675913dd1 3x", "genre": "art", "nsfw": true, "body": "＞「うちの子描けよ…」って猛者はあんまりいないから…(描く絵が悪いのでは？\nと言う事でしたので…\n\nうちの子…描けよ！\n\n条件指定はしません！\n\nhttps://twitter.com/wagunasu_TS/status/1298940810973470720", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/9", "thumbnail_src": "https://si.imgix.net/b1d668c3/requests/145854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=788b8c9347d1d6fe7892e92e5ecd2c34", "thumbnail_srcset": "https://si.imgix.net/b1d668c3/requests/145854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=788b8c9347d1d6fe7892e92e5ecd2c34, https://si.imgix.net/b1d668c3/requests/145854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=729cd8147124ad2eac10702b9cde65da 2x, https://si.imgix.net/b1d668c3/requests/145854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36f733c3080b17a35c999acfa41ffe89 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\n朱武様のうちの子の纏ちゃんがとても性癖にぐさっときたので…\n割とアレなジャンルなのですが、纏ちゃんが巨大なナメクジ(or芋虫)っぽい生き物に種付けされる蟲姦シチュをお願いしてもよろしいでしょうか？\nNGジャンルでしたら申し訳ない…\n\n↓以下大まかな内容になります。可能な部分だけで大丈夫です！\n・着衣or半脱ぎ\n・ずらし挿入or脚に脱ぎかけパンツ\n・虫は纏ちゃんの半分くらいの大きさ\n・覆いかぶさる様に押し倒され、ぐっちょぐっちょと激しく出し入れ\n・粘液まみれのねとねとした巨根ペニス\n・挿入前、最中、射精、終わらない射精と受精…な差分\n・精液ボテ\n・大量射精で精液みっちりな断面図(別コマではなく、体を透過した感じの)\n・卵子に夥しい精子が群がる受精描写\n・凄まじい射精量を強調する感じの射精擬音、子宮がごきゅごきゅ精液を飲み込む擬音をかなり多めに\n・規約に反しない範囲で、大丈夫ならできるだけレイター未統合\n\n以上になります。\n細かい要望ばかりで申し訳ありませんが、ご検討くださると幸いです。\nそれでは、失礼します！", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/7", "thumbnail_src": "https://si.imgix.net/8b3381f4/requests/124414_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4441718c43f0b9be828e995bea07b727", "thumbnail_srcset": "https://si.imgix.net/8b3381f4/requests/124414_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4441718c43f0b9be828e995bea07b727, https://si.imgix.net/8b3381f4/requests/124414_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fafb1f980d0f8be6ab63439698d0d9d5 2x, https://si.imgix.net/8b3381f4/requests/124414_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8fd8bb61e3b8eb3e812ccd530763000 3x", "genre": "art", "nsfw": true, "body": "今キャンペーン中で手数料割引のようですので、依頼だけ先に投げておきたいと思います。\n\nこういったものも可能でしょうか。\n先日納品頂いた\nhttps://skeb.jp/works/119810\nこちらの後日談のようなものとして\n\nキャラのチョイスで解釈違いがあるかもしれませんので朱武さんにその選択はおまかせするとして…\nうちのメスガキが纏ちゃんいじめた事が発端で捕まってスケベなお仕置きをされてしまうところ…\n強キャラの永久嶺ちゃんにされるのがよいかと思いましたがキャラクター的に攻める側に回らない…と言うのであれば、そう言う事をするのにおススメの子に♀×♀のエッチなお仕置きを実行して頂ければ幸いです。\nこちらのお仕置きについてはR-18Gにならない範囲であれば酷い目に合わせて頂いても問題ありません。\nいじめた事に対するお仕置き、いじめっ子になら何をしてもいいだろう、保護者的存在の登場などなど…状況もお任せいたします。\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/6", "thumbnail_src": "https://si.imgix.net/142c4055/requests/120229_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32c3810efb5520a2fc429b1ba9ef12fc", "thumbnail_srcset": "https://si.imgix.net/142c4055/requests/120229_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32c3810efb5520a2fc429b1ba9ef12fc, https://si.imgix.net/142c4055/requests/120229_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b2ac5b6338c1e251359bb4340a356d2 2x, https://si.imgix.net/142c4055/requests/120229_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41795afd7e95ee00b339eab0a29e834f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/5", "thumbnail_src": "https://si.imgix.net/dcd8ed61/requests/119810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65bd73e916d4f12bd706eac9dc4465a2", "thumbnail_srcset": "https://si.imgix.net/dcd8ed61/requests/119810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65bd73e916d4f12bd706eac9dc4465a2, https://si.imgix.net/dcd8ed61/requests/119810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d8427a908e6fee137856a4ed8393135 2x, https://si.imgix.net/dcd8ed61/requests/119810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aa6f4a7da98c7b9cab5fd29c0a1b8e0 3x", "genre": "art", "nsfw": true, "body": "前回、前々回とありがとうございました。\nツイートの方で拝見させて頂きましたが永久嶺ちゃん、纏ちゃん、紗奈彌ちゃん…皆可愛いくえっちな依頼をしたくなりました。\n他に名を上げられていたりゅーこ、クジラ、ヤシガニさんもきっと可愛い子なのでしょう。\nそこで今回の依頼なのですが\n\nうちの銀髪褐色メスガキギザ歯貧乳ロリダークエルフが纏ちゃんを何らかの方法で拘束し\n小さなおててを生かしたフィストファックをして子宮口を指でほじる等とナカを責め立てのけぞり放尿アクメを決めさせるところ\n可能であれば断面図でおてての動きがわかると嬉しいです。\n\nと言った形で被害担当の子にえっちな事をする形になりますがいかがでしょうか、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shubu319hiyoko/works/4", "thumbnail_src": "https://si.imgix.net/a6dc1d4b/requests/117828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0d6021f318c21639e82688c8f9edb6", "thumbnail_srcset": "https://si.imgix.net/a6dc1d4b/requests/117828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0d6021f318c21639e82688c8f9edb6, https://si.imgix.net/a6dc1d4b/requests/117828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c58cffc79b080278e89819aa16d393f 2x, https://si.imgix.net/a6dc1d4b/requests/117828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44953df1191029d58cf5167001246475 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nよろしければ赤城ちゃん(アズールレーン)のイラストをお願いします。\n赤城ちゃん:http://get.secret.jp/pt/file/1596887391.jpg\n\n以下内容になります\n・触手に捕まり、子宮内にまで触手を挿入され、表情は痛みで目を見開いている(所謂ひぎぃ顔)\n・触手が挿入し易い様に細い触手が秘部を広げている(くぱぁ状態)\n・中出しされて絶頂する差分をお願いします。その時の表情はTwitterに投稿されていた画像(https://twitter.com/moekasuentan/status/1282954207604043776)の3枚目みたいな表情でお願いします。\n\n以上となります。\nご検討いただけましたら幸いです。", "created_at": "", "completed_at": ""}]}