%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aabd518021dd980941216687237be001 2x, https://si.imgix.net/32007943/uploads/origins/5a517b1e-fcfe-4c0e-8e14-3a2166efa8bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96f7046ba9e62ef806bb8ddaa5ef2a82 3x", "genre": "art", "nsfw": false, "body": "あなたの画風がとても好きです！私のジャッカルフォーム（LV2）を描いていただけませんか？普段は冷静で計算高いが、怒ると容赦ない一面を見せる。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1gLvGhHtrf39pSWvTRF7ul5-myE4DTLDd?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@skebinu/works/62", "thumbnail_src": "https://si.imgix.net/c71a90e4/uploads/origins/9235edab-f389-47cd-9e22-1870283fbf16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd1f5038c57d203aaef6cc198572fc4c", "thumbnail_srcset": "https://si.imgix.net/c71a90e4/uploads/origins/9235edab-f389-47cd-9e22-1870283fbf16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd1f5038c57d203aaef6cc198572fc4c, https://si.imgix.net/c71a90e4/uploads/origins/9235edab-f389-47cd-9e22-1870283fbf16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bb126c9f019d55dba4981f320938013 2x, https://si.imgix.net/c71a90e4/uploads/origins/9235edab-f389-47cd-9e22-1870283fbf16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f8c7bfba4add1cafad8cd25a6e71c64 3x", "genre": "art", "nsfw": true, "body": "ちびいぬ様\nお疲れ様です🍇星ブドウです🍇🍇🍇\nうちのこのベルにぇちゃんが、おくちを開かされてムシ歯だらけのギザ歯を見られちゃうイラストをお願いします。\nhttps://x.com/grapebudou/status/1695088651422540059\n↑ベルにぇちゃんのキャラシになります。\n涙目で臆病な吸血鬼で、甘いものばかり食べてハミガキしないので、いつもムシ歯で泣いているコです。\nもしよろしければ、悪化したムシ歯差分、治療後の銀歯差分もお願いします。\n\nhttps://x.com/skebinu/status/1951209897556664462\nこれのレベル3でお願いします！前歯はギザギザ、犬歯は鋭め、奥歯はニンゲンの小臼歯大臼歯のような感じでお願いします。\n\nよろしくお願いします🦷", "created_at": "", "completed_at": ""}, {"path": "/@skebinu/works/61", "thumbnail_src": "https://si.imgix.net/04a2bf35/uploads/origins/75b70411-a736-469a-8733-9e7382a06f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d82ab0f2493b595d98de0953ca3efbed", "thumbnail_srcset": "https://si.imgix.net/04a2bf35/uploads/origins/75b70411-a736-469a-8733-9e7382a06f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d82ab0f2493b595d98de0953ca3efbed, https://si.imgix.net/04a2bf35/uploads/origins/75b70411-a736-469a-8733-9e7382a06f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7db81787a73f923b20c706ded72a95c 2x, https://si.imgix.net/04a2bf35/uploads/origins/75b70411-a736-469a-8733-9e7382a06f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fbbceedbb234181fc78f0289947f624 3x", "genre": "art", "nsfw": false, "body": "こんにちは！👋\n初めまして。お元気ですか？😄\n\nアーティストを探している時にあなたを知り、「この方の作風がとても好きだ！」と思いました！特にアップのアイコンイラストがとても魅力的で美しく、ぜひイラストをお願いしたいと思いました🥰\n\n私のふわふわしたドラゴンの男の子を描いていただきたいです！彼は元気いっぱいで、カリスマ性があり、冒険心にあふれ、とても幸せそうな性格です。できれば、いたずらっぽいニヤリとした表情やドヤ顔で、歯を見せている感じにしていただけると嬉しいです！それ以外の点についてはすべてお任せいたします。\nあなたは本当に才能のある方ですので、きっと素敵なイラストに仕上げていただけると確信しています😆\n\nもしよろしければ、ぜひご検討ください。どうぞよろしくお願いいたします。そして素敵な一日をお過ごしください❤️💜\n\nhttps://drive.google.com/drive/folders/175SL7H91hYIrIsWqU6FdTguZo3Bag6aQ", "created_at": "", "completed_at": ""}, {"path": "/@skebinu/works/60", "thumbnail_src": "https://si.imgix.net/019efc5e/uploads/origins/c0309f02-9fda-42f7-aa92-a58f6376e441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=535db8db5aebe4ba9781224e7a6a976a", "thumbnail_srcset": "https://si.imgix.net/019efc5e/uploads/origins/c0309f02-9fda-42f7-aa92-a58f6376e441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=535db8db5aebe4ba9781224e7a6a976a, https://si.imgix.net/019efc5e/uploads/origins/c0309f02-9fda-42f7-aa92-a58f6376e441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81c2d775ccc0538ca6419f3a8f2beb3b 2x, https://si.imgix.net/019efc5e/uploads/origins/c0309f02-9fda-42f7-aa92-a58f6376e441?bg=%23fff&auto=format%2Cco