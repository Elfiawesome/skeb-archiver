uto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=384f7958bfc53c2b805e7daf7f86a8f7 2x, https://si.imgix.net/55e88d67/uploads/origins/8c205d33-a048-48f8-83e5-136d032766cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=678ada74fff807325672796b58fcead5 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。懲りずに申し訳ありません、\nてんで性悪キューピッドのまりあのカラーイラストを描いて頂きたいです。\nパーティー会場に立てられた十字架に磔というシチュエーションをお願いします。\nドレスは誕生パーティーに参加した時の衣装でお願いします。。\n（強い光で照らされて、ドレスが透けて中の下着が見えている。）\n両腕は水平に、両足はぴったり閉じられ、腕・足共に弛みなく延ばされた姿勢とし、\n手足の先まで映る構図で描いて下さい。\n表情は眠らされやや斜め後ろに傾いた表情です。\n（以上、サンプル参考）\n手足首を金属製の枷で十字架に固定してください。十字架は特に装飾無くて構いません。\n\nhttps://i.imgur.com/0xIZeSA.jpg", "created_at": "", "completed_at": ""}, {"path": "/@yamadaa175/works/42", "thumbnail_src": "https://si.imgix.net/bae3bea4/uploads/origins/cfb67bde-95df-4370-ac01-55332d5aefa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cb9e7f3df9890aa11b7c8ed37d149c6", "thumbnail_srcset": "https://si.imgix.net/bae3bea4/uploads/origins/cfb67bde-95df-4370-ac01-55332d5aefa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cb9e7f3df9890aa11b7c8ed37d149c6, https://si.imgix.net/bae3bea4/uploads/origins/cfb67bde-95df-4370-ac01-55332d5aefa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22fa960a2d958a9efeee151dc87785fa 2x, https://si.imgix.net/bae3bea4/uploads/origins/cfb67bde-95df-4370-ac01-55332d5aefa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=513d69630b74dfca613847af3fc3fd5d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yamadaa175/works/41", "thumbnail_src": "https://si.imgix.net/97ec034b/uploads/origins/100022cd-4840-406f-b5aa-2bc3b8109524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e66cedc2ffe8d3e840c966c7f7aa75", "thumbnail_srcset": "https://si.imgix.net/97ec034b/uploads/origins/100022cd-4840-406f-b5aa-2bc3b8109524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e66cedc2ffe8d3e840c966c7f7aa75, https://si.imgix.net/97ec034b/uploads/origins/100022cd-4840-406f-b5aa-2bc3b8109524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fa002462b0bc21ffea255ea60c9ffcb 2x, https://si.imgix.net/97ec034b/uploads/origins/100022cd-4840-406f-b5aa-2bc3b8109524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f7bde1cc489d5465bdbf0f028179d76 3x", "genre": "art", "nsfw": true, "body": "こんにちは。絵の依頼をさせて頂きます。\nやまだあさんの乳首舐め手コキの絵が好みなので、スーパーリアル麻雀PVの早坂晶でお願いします。\n服装は制服、半脱ぎでブラをずらして乳首露出、ショーツも見せてください。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamadaa175/works/40", "thumbnail_src": "https://si.imgix.net/65e97aec/uploads/origins/43dc3d85-d2f5-4eb7-83a1-07f234cd5a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9990acab9471a574a1f032bd3bdf841d", "thumbnail_srcset": "https://si.imgix.net/65e97aec/uploads/origins/43dc3d85-d2f5-4eb7-83a1-07f234cd5a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9990acab9471a574a1f032bd3bdf841d, https://si.imgix.net/65e97aec/uploads/origins/43dc3d85-d2f5-4eb7-83a1-07f234cd5a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a30e5cf0df47d535c61e499f5c1a654 2x, https://si.imgix.net/65e97aec/uploads/origins/43dc3d85-d2f5-4eb7-83a1-07f234cd5a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56b9a98984582ee881f98c16ddefb338 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて下さい。\nキャラは、ときめきメモリアルの藤崎詩織。\nイラスト構図はhttps://www.pixiv.net/artworks/96350989#big_0こんな感じでお願い致します。服装は、公式の冬制服。パンツは、イエローベースの花柄パンツ。屈んだ制服の隙間から胸チラ(ノーブラ)を希望します。可能でしたら差分でブルマ(水色)着用バージョンをお願いしたいです。\nリクエスト承認、何卒、検討して頂けたら嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@yamadaa175/works/39", "thumbnail_src": "https://si.imgix.net/02f0211a/uploads/origins/9fd7ff8f-a44a-4acc-892f-cb284a8264d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a1942289dacb813de10f336a509063", "thumbnail_srcset": "https://si.imgix.net/02f0211a/uploads/origins/9fd7ff8f-a44a-4acc-892f-cb284a8264d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a1942289dacb813de10f336a509063, https://si.imgix.net/02f0211a/uploads/origins/9fd7ff8f-a44a-4acc-892f-cb284a8264d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70674f91153c4b6fbb393c672807d022 2x, https://si.imgix.net/02f0211a/uploads/origins/9fd7ff8f-a44a-4acc-892f-cb284a8264d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2dbc820e2d9a15e5203644373aa78ce 3x", "genre": "art", "nsfw": true, "body": "やまだあ様、お世話になっております。\nまたまたてんで性悪キューピッドまりあ、お願いします。\n今回は吸ケツ鬼回の過激版です。\n\n十字架を持っていないことを示すため服を脱ぐまりあ。\nパンツを下ろしたところで、原作とは逆に竜次の中で\n理性と吸血鬼のシーソーが吸血鬼側に傾く。\n全裸になったまりあ。羞恥をこらえているという表情。\n「全部みせれば…信じてくれるのね」\n腰を前に突き出し、くぱぁ。\n竜次の理性が完全に吹き飛ぶ。\n「もう辛抱たまらーん！」とまりあに襲い掛かる竜次。\nむさぼりつこうとした満の前にしっぽで持った十字架。\n後は原作と同じ。\n\nまりあ続きで恐縮ですが、なにとぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamadaa175/works/38", "thumbnail_src": "https://si.imgix.net/2aeb499d/uploads/origins/c1d844ef-c937-463c-a36d-f2cfc375796c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c1b9cd31d9a96088dc0098246bce71", "thumbnail_srcset": "https://si.imgix.net/2aeb499d/uploads/origins/c1d844ef-c937-463c-a36d-f2cfc375796c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c1b9cd31d9a96088dc0098246bce71, https://si.imgix.net/2aeb499d/uploads/origins/c1d844ef-c937-463c-a36d-f2cfc375796c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e323e20597bee19c261ca5e4d2219e8 2x, https://si.imgix.net/2aeb499d/uploads/origins/c1d844ef-c937-463c-a36d-f2cfc375796c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c07f13e6c8a66e55b1b9d8b578d6ecb 3x", "genre": "art", "nsfw": true, "body": "またお願いできればと思います。\n以前の「みづきの格闘シーン」「勝利後のオナニー」の続きです。\n倒したモブ男を乳首舐め、手コキで射精させるシーンで、射精直前、射精の瞬間で可能であれば差分お願いします。無理でしたら射精の瞬間をお願いしたいです。\nみづきはウェアを着たまま、股間にオナニーの時の愛液のシミが見える状態です。楽しそうに挑発するような表情です。\n台詞は\n射精直前\n「女の子の汗のにおいが好きなの？しょうがないなあ…。」\n射精の瞬間\n「いっぱい出たね。気持ちよかったんだ…。また強くなってきたらヌイてあげるね。…あたしを倒すのは無理だと思うけど」\n以上、ご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamadaa175/works/37", "thumbnail_src": "https://si.imgix.net/ead882e7/uploads/origins/7a9c3932-fae7-47e4-a685-da45b42c6fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81fd00764897972bed032e8c8080fc14", "thumbnail_srcset": "https://si.imgix.net/ead882e7/uploads/origins/7a9c3932-fae7-47e4-a685-da45b42c6fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81fd00764897972bed032e8c8080fc14, https://si.imgix.net/ead882e7/uploads/origins/7a9c3932-fae7-47e4-a685-da45b42c6fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a109b46e0f836e57cafc685dce97e9f5 2x, https://si.imgix.net/ead882e7/uploads/origins/7a9c3932-fae7-47e4-a685-da45b42c6fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30b1014bd5086ff654dd1dcb44e4d788 3x", "genre": "art", "nsfw": true, "body": "山田さん、フランスからボンジュール!\n\n私はあなたのスタイルとイラストが大好きです\n私はあなたの才能に声をかけたいと思います。\n\nhttps://mega.nz/file/K91FDIyR - LqIQqv9R7u7q6wGPY3Zcj2zBnuvgOeqXPdjGU_kEHGg\n\n厳しい要求で申し訳ないです...。\nどうか、私の要求を受け入れてください\n\nありがとうございます!\n頑張ってください\nがんばってください\n\nhttps://mega.nz/file/K91FDIyR#LqIQqv9R7u7q6wGPY3Zcj2zBnuvgOeqXPdjGU_kEHGg", "created_at": "", "completed_at": ""}]}