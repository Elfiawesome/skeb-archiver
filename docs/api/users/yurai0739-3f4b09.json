origins/5f21e7d7-8ae4-4016-8ddc-cc0ff386174e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3967793014e81c642ee299b2b3547f8", "thumbnail_srcset": "https://si.imgix.net/73697f86/uploads/origins/5f21e7d7-8ae4-4016-8ddc-cc0ff386174e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3967793014e81c642ee299b2b3547f8, https://si.imgix.net/73697f86/uploads/origins/5f21e7d7-8ae4-4016-8ddc-cc0ff386174e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9137f105046c110b0cc41cf94c16405b 2x, https://si.imgix.net/73697f86/uploads/origins/5f21e7d7-8ae4-4016-8ddc-cc0ff386174e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3e3e8a69dedef2577495fd3d81a39cc 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！前回購入したスケブがとても気に入ったので、もう一本購入したいと思っています。\n\n高梨キアラの絵をお願いしたいです。シナリオはハイティーデートです。視点はPOVで、ポーズはケーキをフォークにのせてPOVに食べさせてみるような、可愛らしく遊び心のある口調でお願いします。キャラ絵のみのバージョンもお願いします。\n\nありがとうございました！\n\n参考資料\nhttps://drive.google.com/drive/folders/1a060Ybc-4opi6b7TO9GuURqiWQ1L6JzM?usp=sharing\n\nhttps://drive.google.com/drive/folders/1a060Ybc-4opi6b7TO9GuURqiWQ1L6JzM?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yurai0739/works/44", "thumbnail_src": "https://si.imgix.net/99de6013/uploads/origins/c9e33d1d-d14c-457c-ad75-df29f59d3bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3fde8405a68eacd5f599a0dd4a6109e", "thumbnail_srcset": "https://si.imgix.net/99de6013/uploads/origins/c9e33d1d-d14c-457c-ad75-df29f59d3bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3fde8405a68eacd5f599a0dd4a6109e, https://si.imgix.net/99de6013/uploads/origins/c9e33d1d-d14c-457c-ad75-df29f59d3bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f64fcb1ea4ba069e8d018426274acd4 2x, https://si.imgix.net/99de6013/uploads/origins/c9e33d1d-d14c-457c-ad75-df29f59d3bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro