4567e7-e024-4adb-bdb9-dad1cbe3b4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2616fb0bab56e640059fcdc14db98f18", "thumbnail_srcset": "https://si.imgix.net/bd509753/uploads/origins/604567e7-e024-4adb-bdb9-dad1cbe3b4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2616fb0bab56e640059fcdc14db98f18, https://si.imgix.net/bd509753/uploads/origins/604567e7-e024-4adb-bdb9-dad1cbe3b4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3375d7a77cd8e17ed7f128a77492713c 2x, https://si.imgix.net/bd509753/uploads/origins/604567e7-e024-4adb-bdb9-dad1cbe3b4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1f8e48d29ab880f15a8174741107562 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@beyond_asterisk/works/4", "thumbnail_src": "https://si.imgix.net/611398c3/uploads/origins/ce4c249f-0a9b-4ce2-85e1-f32754e27695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a31d43814ebc5dd4ab8a9c396ac9521", "thumbnail_srcset": "https://si.imgix.net/611398c3/uploads/origins/ce4c249f-0a9b-4ce2-85e1-f32754e27695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a31d43814ebc5dd4ab8a9c396ac9521, https://si.imgix.net/611398c3/uploads/origins/ce4c249f-0a9b-4ce2-85e1-f32754e27695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f20b14ae12d4c9419018895dd0f5d5d 2x, https://si.imgix.net/611398c3/uploads/origins/ce4c249f-0a9b-4ce2-85e1-f32754e27695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7abc1aa987a21e9469c0ceeb84bca46c 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n前skebイラストの舌出しがすごい好みでリクエスト送らさせていただきます。\n\n●キャラクター\nバーチャルYoutuberの丹羽にわこさんのイラスト(新モデル)をお願いします。\n\n●シチュエーション\n・前skebイラストと同じように舌出してる\n・顎の下でピースしてる\n・上目遣い\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rV-IuEfGPgVGlURuQ__N9gs0ygyoMi5g?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@beyond_asterisk/works/3", "thumbnail_src": "https://si.imgix.net/7b36dc9a/uploads/origins/743b2a87-f627-41d3-9571-db45ea9bb813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d372ba92420150f39da5726521e49d", "thumbnail_srcset": "https://si.imgix.net/7b36dc9a/uploads/origins/743b2a87-f627-41d3-9571-db45ea9bb813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d372ba92420150f39da5726521e49d, https://si.imgix.net/7b36dc9a/uploads/origins/743b2a87-f627-41d3-9571-db45ea9bb813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70f6545d0e4a27f62d1efbc7857c3fb3 2x, https://si.imgix.net/7b36dc9a/uploads/origins/743b2a87-f627-41d3-9571-db45ea9bb813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe9c28419d6833581bdb1c9a9fcb4b48 3x", "genre": "art", "nsfw": true, "body": "初めまして、あゆたき🔞様。絵を拝見して是非依頼したく。\nキャラ：聖剣伝説3　リース（光クラス_ヴァナディースの状態）下のメインキャラ資料を参考に。\n構図：可能なら頭から足先まで全身見える構図で。\nシチュエーション\n強力なモンスターに苦戦するが大技で反撃。複数の光の槍を放ち相手にダメージを与えている、という描写をお願いします。\n●槍や鎧（兜や胸部鎧、肩部鎧の宝玉など）にヒビ割れなどの描写を入れて中破状態の感じに。\n●脚部や腰鎧、腰の白い布、ストッキングは少し破れやヒビがある程度で、欠落部はあまり無い感じに。\n●槍にバフ魔法を掛け強化している感じに。\n●身体は傷ついて少し血が滲み、残り体力70％位のイメージで。\n●シチュエーションは参考資料を参考に（雰囲気の参考程度に使って下さい、構図やポーズ、詳細はお任せします。お好きにアレンジして下さい）\n●モンスターは下のモンスター資料を参考に（詳細はお任せします）\n注文内容多くて申し訳ありません。もし気が向いた時受けて頂ければうれしいです。\n\nhttps://drive.google.com/drive/folders/1SM_6iQTQz3NQbZw0Scaqa_q6tT541GZI", "created_at": "", "completed_at": ""}, {"path": "/@beyond_asterisk/works/2", "thumbnail_src": "https://si.imgix.net/a4b7f954/uploads/origins/bd644039-8cd8-4fc7-9edb-b14f664e66ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13437773edcc8207765e8885455a25e", "thumbnail_srcset": "https://si.imgix.net/a4b7f954/uploads/origins/bd644039-8cd8-4fc7-9edb-b14f664e66ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13437773edcc8207765e8885455a25e, https://si.imgix.net/a4b7f954/uploads/origins/bd644039-8cd8-4fc7-9edb-b14f664e66ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e48b3b0d81f37af6e0b5b21e111f93d 2x, https://si.imgix.net/a4b7f954/uploads/origins/bd644039-8cd8-4fc7-9edb-b14f664e66ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce1586477d6f8aa10492d28d2d844b78 3x", "genre": "comic", "nsfw": true, "body": "こんにちは！あなたの絵が大好きです。僕の友達のOCを描いてくれない？2人分の参考資料を用意したから、好きな方を選んで。ヴァイはヴァンパイア・ドラゴン。404はウサギ。\n\nもしヴァイを描くなら、胸を小さくして、髪をおろして描いてください。どちらも参考資料にあります。こんな体型がいい。\nhttps://x.com/beyond_asterisk/status/1846679681078382621\n \nこんな感じのシーンが欲しいです。\nhttps://drive.google.com/file/d/1eKqmdfrfDoQMX0dCovHVcuFw37yAQace\n\n詳細はお任せしますので、お好きなポーズを描いてください。提案があれば、種付けプレスやバックでもいいです。\n\n男性は一人だけでお願いします。画像に写っている場合は、無表情、ハゲのままで構いません。\n\n私の要望を考慮していただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1sH8Ov-1EIAm2Ts_YEDGrazkVKmD6_iKx", "created_at": "", "completed_at": ""}, {"path": "/@beyond_asterisk/works/1", "thumbnail_src": "https://si.imgix.net/4bffe1ab/uploads/origins/78a123d4-6cbb-456b-bdf3-6d3f58024d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9de2e50744b6e91f2452d0eb824f99bd", "thumbnail_srcset": "https://si.imgix.net/4bffe1ab/uploads/origins/78a123d4-6cbb-456b-bdf3-6d3f58024d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9de2e50744b6e91f2452d0eb824f99bd, https://si.imgix.net/4bffe1ab/uploads/ori