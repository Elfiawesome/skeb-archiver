043-0bbab366eabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=432255558d406c983f6eef614f0fe7d8", "thumbnail_srcset": "https://si.imgix.net/76e77191/uploads/origins/c992e5f1-75af-484f-8043-0bbab366eabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=432255558d406c983f6eef614f0fe7d8, https://si.imgix.net/76e77191/uploads/origins/c992e5f1-75af-484f-8043-0bbab366eabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c1a4e1dbb1d4a584e4b9559b0d0f086 2x, https://si.imgix.net/76e77191/uploads/origins/c992e5f1-75af-484f-8043-0bbab366eabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b32acf4ef27c79e8bff7575115023135 3x", "genre": "art", "nsfw": true, "body": "2人のFuta WereFox（unicorn overlord）がRailanor（unicorn overlord）を攻撃し、レイプする様子を3ページ描いてくれないか？\n\n1ページ目：アクションポーズ＋2匹のWereFoxがRailanorを攻撃している＋全キャラクターが鎧を着ている。\n\n2ページ目: 1体のWereFoxが後ろからRailanorの胸を触り、もう1体のWereFoxがそれを見ている。\n\nページ3: 2匹の風太のWereFoxがRailanorをレイプしている https://freeimage.host/i/24nLKN4 + すべてのキャラクターがヌードであるべき。\n\n参考にしてください：\n\nWereFox 1(Dinah): https://freeimage.host/i/24n8mns\n\nウェアフォックス2: https://freeimage.host/i/24ngcaR\n\nRailanor: https://freeimage.host/i/24n4BeV", "created_at": "", "completed_at": ""}, {"path": "/@komin_namihara/works/223", "thumbnail_src": "https://si.imgix.net/82f60d8b/uploads/origins/a69b809d-8dae-49be-bc58-2c222d2434c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f0d1c076e2bc6035c14daebbc1d9637", "thumbnail_srcset": "https://si.imgix.net/82f60d8b/uploads/origins/a69b809d-8dae-49be-bc58-2c222d2434c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f0d1c076e2bc6035c14daebbc1d9637, https://si.imgix.net/82f60d8b/uploads/origins/a69b809d-8dae-49be-bc58-2c222d2434c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f7df9c5cacfdc77204af8abade7709a 2x, https://si.imgix.net/82f60d8b/uploads/origins/a69b809d-8dae-49be-bc58-2c222d2434c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c29ca31afdf1d617f6eda261f94ad7be 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。ユリシーズに肌色面積の多い衣装を実装したので、ぜひ先生の作品で拝みたいと思い、リクエストさせて頂きました。\n\n◆シチュエーション\nモンク(格闘士)で、キサナドゥとの手合わせに勝って、メスガキムーブで挑発したら、そのままわからされる内容でお願いします。\nわからせフェーズはチンコを股に当てられる→腹ボコするくらい突かれる→大量に中出しされてボテ腹という流れで。体位はお任せします！\n\n◆台詞と流れ\n｢ふふっ、俺の勝ち〜♪キサナったら俺の動きに翻弄されちゃってるんだもん！体格差有利〜♪｣\n手合わせに勝利して煽るユリシーズ。動き回った後なので汗だく\n↓\n｢なら第2ラウンドといこうか｣\n｢ふえっ！？ちょっとキサナ…！？｣\nチンコを押し当てられるユリシーズ。ユリシーズの腰布とパンツは無し、上着はたくしあげるか脱がせておっぱい露出で\n↓\n｢体格差有利なんだろう？抵抗してみろ、ユリィ｣\n｢おﾞひっ♡むりっ、むりぃっ♡ごめんなひゃッ♡｣\nめちゃくちゃ突かれて喘ぎまくるユリシーズ。前々回のように喘ぎやオノマトペ多めだと嬉しいです\n↓\n｢ッ…出すぞ、しっかり受け止めろ…！｣\n｢〜〜〜〜ッ♡｣\n大量に中出しされてボテ腹に\n\n欲望盛り盛りになってしまったので、金額での再送要請をして頂ければ幸いです。\nご検討の程、どうかよろしくお願いします。\n\n◆作画資料\nユリシーズ(モンク)\nhttps://drive.google.com/drive/folders/1-QzR3II_i6SlGvzy_anCtgx71UA5fen8\n\nキサナドゥ(モンク)\nhttps://drive.google.com/drive/folders/1-c1RSdkAPKc4sYp4pxcI9FkebdJ7ijIT\n\n手描き資料/口調サンプル\nhttps://drive.google.com/drive/folders/1-6nOvXM5_CrahSL56WrEbk6vsCDg6vWp\n\n裸体\nhttps://drive.google.com/drive/folders/1-vGQtXkkBs3R4tpeD3y9p7jScx7RVTOz", "created_at": "", "completed_at": ""}, {"path": "/@komin_namihara/works/222", "thumbnail_src": "https://si.imgix.net/7e0c3b40/uploads/origins/999d4b4e-feab-4432-830b-7cc29901877f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8de54481a247d84279ea0a9a5e2bf90f", "thumbnail_srcset": "https://si.imgix.net/7e0c3b40/uploads/origins/999d4b4e-feab-4432-830b-7cc29901877f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8de54481a247d84279ea0a9a5e2bf90f, https://si.imgix.net/7e0c3b40/uploads/origins/999d4b4e-feab-4432-830b-7cc29901877f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0b79cef19dc081d38f7587703dbff5e 2x, https://si.imgix.net/7e0c3b40/uploads/origins/999d4b4e-feab-4432-830b-7cc29901877f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7434d8b12856afa59a437c77db33f2ae 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ファイナルファンタジー14のキャラクターの淫らな写真を撮るにあたって、知り合いから勧められたんだ！    彼女はララフェルですが、普通よりちょっとカーブしています。\n\n逆バニースーツ（参考写真）を着ているアイデアはあったのですが、乳首とアソコを覆っているシールが剥がれてしまいました。これは刺激的で淫らな写真になると思ったんだ。下の乳首を垂らしながら持たせるとか。彼女は恥ずかしがりながらも、興奮するだろう！   彼女はバーでこのような服を着ているのだろう。   それ以外のことは君に任せるよ。君はかわいらしさとセクシーさを際立たせるのがうまいね！\n\nhttps://drive.google.com/drive/folders/1lELJhkIG2adEPCMRKNupuyKmQuT1nMtN?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@komin_namihara/works/221", "thumbnail_src": "https://si.imgix.net/9baadb58/uploads/origins/70989122-1a53-4478-8141-b4184b53c654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd5e2772965ea865d0f28d43219640d", "thumbnail_srcset": "https://si.imgix.net/9baadb58/uploads/origins/70989122-1a53-4478-8141-b4184b53c654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd5e2772965ea865d0f28d43219640d, https://si.imgix.net/9baadb58/uploads/origins/70989122-1a53-4478-8141-b4184b53c654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d163b0ec29a539fd0cf0aac3ab79f9f9 2x, https://si.imgix.net/9baadb58/uploads/origins/70989122-1a53-4478-8141-b4184b53c654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d3d7408809b46a2d83a5cfe4a2a610d 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\n今回もよろしくお願いします\n\n今回はクソメイド研修中からクッキングメイドの目隠れギザ歯の内村さんで\nメイド服のまま性処理に使われてるとこをお願いします\nとりあえず最初は頭を掴まれてのイラマチオで\n内村さんはご主人に頼まれたら笑顔でなんでも手伝ってくれるキャラだそうです\n\n作者のバラキーさんには許可をもらっていますのでどうかよろしくお願いします\nhttps://seiga.nicovideo.jp/comic/48265\nhttps://www.pixiv.net/user/10743492/series/2664\nhttps://skeb.jp/search?q=%E3%82%AF%E3%82%BD%E3%83%A1%E3%82%A4%E3%83%89%E7%A0%94%E4%BF%AE%E4%B8%AD&t=works", "created_at": "", "completed_at": ""}]}