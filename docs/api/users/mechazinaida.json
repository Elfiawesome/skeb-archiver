-4a0f-9c91-53199df66fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53f68bb1478f6ecb2a5a35598a2b77c3 2x, https://si.imgix.net/1127d57f/uploads/origins/e7109017-82ef-4a0f-9c91-53199df66fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a5b01c82e2cf826d76bfb249103fe9d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mechazinaida/works/28", "thumbnail_src": "https://si.imgix.net/bc887661/uploads/origins/7ac02119-8e6b-408d-a56b-b2f31dbff3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7f571bf8000229f05ef927d741ad2d", "thumbnail_srcset": "https://si.imgix.net/bc887661/uploads/origins/7ac02119-8e6b-408d-a56b-b2f31dbff3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7f571bf8000229f05ef927d741ad2d, https://si.imgix.net/bc887661/uploads/origins/7ac02119-8e6b-408d-a56b-b2f31dbff3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffb61daf0e98245670159ef7fc380f82 2x, https://si.imgix.net/bc887661/uploads/origins/7ac02119-8e6b-408d-a56b-b2f31dbff3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58f9ce9dbac408f4f05f32109a1a54c0 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました！\n早速ですが、またリクエストさせていただきます。\n\nキャラ\n崩壊：スターレイルのサフェル\n画像…資料URLのとおり\n\nシチュ\n複数のモブ男達に囲まれて和姦\n\n構図\n資料URLの構図イメージのような感じの、膝立ち騎乗位+膣に挿入している竿役と手を恋人つなぎ\n胸揉み等なし\n追加の要素として、\n・サフェルの後ろに竿役を置き、尻又は腰を掴み尻穴に挿入した２穴状態\n・既にサフェルへ中出し済みで、竿から精液を漏らしている竿役を数人、周囲に配置\nの２点をお願いします\n\n表情\n気持ち良さそうに感じて恍惚としているイメージ\n顔の向きは膣に挿入している竿役、目線は尻に挿入している竿役に向けてください\n目は閉じないようお願いします\n\n服装\nキャラ画像のものを半脱ぎ状態\n資料URLの脱ぎ具合イメージのようになっていればOKです\n\n台詞類\n・サフェルから竿役へ中出しを促す台詞や、中出しされたのを喜ぶ台詞\n・竿役の台詞\n・行為中のサフェルの喘ぎ声や擬音、射精音\nをお願いします\n\nその他\n・サフェルの胸は以前描いていただいたホタル前後ぐらいの大きさにしてください\n・以下の２種のカットインをお願いします\n①膣内・尻への射精時のカットイン（膣外から見た状態を希望、膣内の描写は不要）\n②膣と尻から竿を抜き精液が漏れ出る様子のカットイン\n\n以上、よろしくお願いいたします！\n\nhttps://pbs.twimg.com/media/G_lYx-nakAAhlCU?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@mechazinaida/works/27", "thumbnail_src": "https://si.imgix.net/c507accc/uploads/origins/00775b22-089d-43b3-8f27-a9f4548c6873?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8df4bf4996ae0808c35185d96fdabe61", "thumbnail_srcset": "https://si.imgix.net/c507accc/uploads/origins/00775b22-089d-43b3-8f27-a9f4548c6873?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8df4bf4996ae0808c35185d96fdabe61, https://si.imgix.net/c507accc/uploads/origins/00775b22-089d-43b3-8f27-a9f4548c6873?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd5ccb16a83cfedaa161ba52b904db3d 2x, https://si.imgix.net/c507accc/uploads/origins/00775b22-089d-43b3-8f27-a9f4548c6873?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e524c2ad28819ba05d756c52edfc6026 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mechazinaida/works/26", "thumbnail_src": "https://si.imgix.net/60fd4e42/uploads/origins/52c17f88-3a8d-4eb2-a1c5-4e20957296e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9ca6062cf45cde872cf0ede8d8217be", "thumbnail_srcset": "https://si.imgix.net/60fd4e42/uploads/origins/52c17f88-3a8d-4eb2-a1c5-4e20957296e0?bg