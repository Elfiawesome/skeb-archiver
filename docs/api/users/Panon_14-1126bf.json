-00c7b166b493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18a821e8aa0699fcbbda67e5f54aa05c", "thumbnail_srcset": "https://si.imgix.net/9b539efc/uploads/origins/d47c9e64-4001-4878-8e42-00c7b166b493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18a821e8aa0699fcbbda67e5f54aa05c, https://si.imgix.net/9b539efc/uploads/origins/d47c9e64-4001-4878-8e42-00c7b166b493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62c534fba858ed48c0381dd31273ee06 2x, https://si.imgix.net/9b539efc/uploads/origins/d47c9e64-4001-4878-8e42-00c7b166b493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=971ae9769cb2cfa1f80894180efcfe79 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Panon_14/works/28", "thumbnail_src": "https://si.imgix.net/aae0a599/uploads/origins/8ea00202-cd78-4f11-85bb-750c335525cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82517aaee2af36b413b1488d64e96810", "thumbnail_srcset": "https://si.imgix.net/aae0a599/uploads/origins/8ea00202-cd78-4f11-85bb-750c335525cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82517aaee2af36b413b1488d64e96810, https://si.imgix.net/aae0a599/uploads/origins/8ea00202-cd78-4f11-85bb-750c335525cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d38d831ace7a47fb9192813c89710cf9 2x, https://si.imgix.net/aae0a599/uploads/origins/8ea00202-cd78-4f11-85bb-750c335525cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce0947c31c15ac38411a580d9e8c864b 3x", "genre": "art", "nsfw": true, "body": "初めまして。いつも素敵な絵を拝見させていただいています。ありがとうございます。\n今回、依頼したいのはFF14の自キャラのイラストです。1枚絵でお願いします。\nキャラのイメージはお姉さん、年上(高校学年で表すと一つ先輩くらい)、見た目は真面目だけど中身はちょいギャルぽい感じです。\n目の色が微妙に違いますが、右目の色で統一してください。\n髪型はポニーテールをさらによく見えるよう改変していただき(例、前髪が自然に見えるように)、髪色は青がほんの少しだけ混ざった限りなく白に近い水色でお願いします。\n表情は挑発的(もしくは誘っているような)、か\n赤面しているが余裕そうに見せているのどちらか\nでお願いします。\n服装は下は柄のないTバックかセクシーな下着で上はお任せします。特になければ彼シャツでお願いします。\n\n構図は\n1.ベッドの上でエモート、パントマイム(参考画像ffxiv_20230203_025049_422)のようなポーズ。顔は前で。\n2.ベッドの上で四つん這いになってお尻の方から見て顔がこっちを向いているポーズ\n3.ベットの淵に座って片足だけ上にのせて開脚しているポーズ\n4.ぱの先生のお好きなように。\nのいずれか一つを書いていただきたいです。\n\n差分で上の服がはだけていたり、脱げかけていて胸が見えるのと一緒に股から太ももあたりに水が垂れている表現をお願いします。\nもし、見えるような状況であれば参考画像(エモート、休め)の◯のあたりにほくろを１つと\n首にキスの痣を2箇所ほどお願いします。\n宛名がありとなしで分けていただけるとありがたいです。\n\nPCの壁紙や鑑賞目的で使用させていただきます。\n\n長々と失礼いたしました。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1uEclJSXlY_BEIGq_op3eoOxo8acoYrQG", "created_at": "", "completed_at": ""}]}