ていただく事は可能でしょうか。\n元気がよく明るい性格で、いろいろな意味で無防備な子です。\n\n(※とあるユーザー参加型のゲームで使用していた自キャラです)\n\n詳細はお任せいたします。\n可愛く描いて頂けると幸いです。\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/eu9euzvvsh69so5ihe772/kunoichi_.png?rlkey=no5a35k0yve0lg7wu72c44dde&st=ybaza8ie&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@hanayanagoyaka/works/17", "thumbnail_src": "https://si.imgix.net/859d9068/uploads/origins/09f4bd27-f54d-4c21-8d43-3784b758ddd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9744041d268c5cf561c0985a6e4f97c3", "thumbnail_srcset": "https://si.imgix.net/859d9068/uploads/origins/09f4bd27-f54d-4c21-8d43-3784b758ddd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9744041d268c5cf561c0985a6e4f97c3, https://si.imgix.net/859d9068/uploads/origins/09f4bd27-f54d-4c21-8d43-3784b758ddd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55d5fc242a08f1342401b429e1490cc4 2x, https://si.imgix.net/859d9068/uploads/origins/09f4bd27-f54d-4c21-8d43-3784b758ddd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f04cec8b19de9b2d2ac1ffe0baf9b3ec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hanayanagoyaka/works/16", "thumbnail_src": "https://si.imgix.net/21bc5fdf/uploads/origins/f76de252-fdd4-45ed-bd25-f09bb78c735d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aae84674aa4d30995d2751ad42f3f32", "thumbnail_srcset": "https://si.imgix.net/21bc5fdf/uploads/origins/f76de252-fdd4-45ed-bd25-f09bb78c735d?bg=%23fff&auto=format%2Ccompress&fm=web