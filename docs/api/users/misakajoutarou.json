adf2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af66a06689372869a88812cc9707b7f3, https://si.imgix.net/4a5e5771/uploads/origins/f79bf0b0-a83a-4bf0-9592-13eeadadf2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c427373af156284adb9019ea57bfc7bf 2x, https://si.imgix.net/4a5e5771/uploads/origins/f79bf0b0-a83a-4bf0-9592-13eeadadf2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea37a8b1b470fdfeaee5234af8430926 3x", "genre": "art", "nsfw": true, "body": "モンストのガブリエルが大蛇に締め付けられているイラストをお願いします。\n\n・蛇に巻きつかれて地面に倒れた状態で強く締め上げられている。顔と足のみ出ている状態で靴が脱げて靴下のみ履いている状態。\n\n1.蛇の尻尾で首を強く絞められ、全身をぎちぎちに締め付けられて苦しそうな表情。\n\n2.意識がなくなりかけのガブを締め付けたまま足先に蛇が噛み付く。\n\n以上の内容でよろしければお願いします。\n\nhttps://anime.monster-strike.com/fadingcosmos/character/22.html\n\n↑ガブリエル参考資料", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/99", "thumbnail_src": "https://si.imgix.net/095f84fb/uploads/origins/53eabbaf-94f8-41bf-8851-2e1d144bb15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9e6bd19de18f0583059cebed96f8db", "thumbnail_srcset": "https://si.imgix.net/095f84fb/uploads/origins/53eabbaf-94f8-41bf-8851-2e1d144bb15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9e6bd19de18f0583059cebed96f8db, https://si.imgix.net/095f84fb/uploads/origins/53eabbaf-94f8-41bf-8851-2e1d144bb15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb622e4257f7b05c354928eea921cb27 2x, https://si.imgix.net/095f84fb/uploads/origins/53eabbaf-94f8-41bf-8851-2e1d144bb15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7579b60b83ba7e34ccf43a42800bc051 3x", "genre": "art", "nsfw": true, "body": "マリア・カデンツァヴナ・イヴで衣装はギア\n両目閉じと失禁あり以外はお任せします\nあなたのイラストに元気を貰いたい\n検討をお願いします\n\nhttps://www.goodsmile.info/ja/product/13358/ACT+MODE+%E3%83%9E%E3%83%AA%E3%82%A2+%E3%82%AB%E3%83%87%E3%83%B3%E3%83%84%E3%82%A1%E3%83%B4%E3%83%8A+%E3%82%A4%E3%83%B4.html", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/98", "thumbnail_src": "https://si.imgix.net/d92c0cab/uploads/origins/90bd8029-f22b-4014-972f-c899a30f8130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495282b2a02d3b954ebb7653094647cb", "thumbnail_srcset": "https://si.imgix.net/d92c0cab/uploads/origins/90bd8029-f22b-4014-972f-c899a30f8130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495282b2a02d3b954ebb7653094647cb, https://si.imgix.net/d92c0cab/uploads/origins/90bd8029-f22b-4014-972f-c899a30f8130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9121fa7a9d4a3f35a1f500c7bd5c83c 2x, https://si.imgix.net/d92c0cab/uploads/origins/90bd8029-f22b-4014-972f-c899a30f8130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b4412e360c19d7ac552a23d49817eae 3x", "genre": "art", "nsfw": true, "body": "以前、ウェディングアップルを依頼した者です。\n再びですがアップルをお願いします。\nウェディングアップルのバトルコスチュームが、東京ミュウミュウ11話の蛇の魔物に拘束され締め付けられる絵をお願いします。\n\nhttps://weddingapple.com/", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/97", "thumbnail_src": "https://si.imgix.net/013c9e6c/uploads/origins/6efd13e1-f41d-4a9d-bb35-daf98cfa8f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=293b60fd5c0453fc215d2e1d2dcef6be", "thumbnail_srcset": "https://si.imgix.net/013c9e6c/uploads/origins/6efd13e1-f41d-4a9d-bb35-daf98cfa8f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=293b60fd5c0453fc215d2e1d2dcef6be, https://si.imgix.net/013c9e6c/uploads/origins/6efd13e1-f41d-4a9d-bb35-daf98cfa8f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc3f70fd192902431b52da43c5f49fdc 2x, https://si.imgix.net/013c9e6c/uploads/origins/6efd13e1-f41d-4a9d-bb35-daf98cfa8f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57cdfdb9fed688a00ec6204e42221e5b 3x", "genre": "art", "nsfw": true, "body": "転生したらスライムだった件よりシュナをお願いします。\nシチュエーションは異形存在（スケルトン系、人形スライム系、いつぞやの魔人ブウ悪、純粋系）による片手首絞め。\n見た目はリムルに名前を付けてもらった後で、服装も名付け後よく着ている巫女服っぽいやつで、首周りが肩辺りまで破れたり、脱げかけたり等で露出している形。\n失禁は無しでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/96", "thumbnail_src": "https://si.imgix.net/1586d5e1/uploads/origins/f9eedf11-4462-4810-ae9d-b37de3f6c966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def1d6ddce593c167878b68497b9584a", "thumbnail_srcset": "https://si.imgix.net/1586d5e1/uploads/origins/f9eedf11-4462-4810-ae9d-b37de3f6c966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def1d6ddce593c167878b68497b9584a, https://si.imgix.net/1586d5e1/uploads/origins/f9eedf11-4462-4810-ae9d-b37de3f6c966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37ca2c17f6b3adee54785ff3fd870b1e 2x, https://si.imgix.net/1586d5e1/uploads/origins/f9eedf11-4462-4810-ae9d-b37de3f6c966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98d406dcb82ab9e02de9a76c39f14868 3x", "genre": "art", "nsfw": true, "body": "デート・ア・ライブより四糸乃の首絞めをお願いします。\nゴーストハンドによる片手首絞めで腕の拘束はおまかせ、足の拘束は無し。\n服装は首から肩辺りまでが露出しているもの（ワンピース系やスク水等）か、精霊時の姿でフード等が破れ、上記周りが露出している状態のどちらか。\n失禁は無しでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/95", "thumbnail_src": "https://si.imgix.net/dd39017a/uploads/origins/62d1431d-4807-4b94-ba4a-c859eaca8217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd82ee66c345bd16340df6dd0342e69", "thumbnail_srcset": "https://si.imgix.net/dd39017a/uploads/origins/62d1431d-4807-4b94-ba4a-c859eaca8217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd82ee66c345bd16340df6dd0342e69, https://si.imgix.net/dd39017a/uploads/origins/62d1431d-4807-4b94-ba4a-c859eaca8217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08b0030a8a2bc57ef620a05177390d1b 2x, https://si.imgix.net/dd39017a/uploads/origins/62d1431d-4807-4b94-ba4a-c859eaca8217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1096116b7f7e5e4c71843be53e8c637 3x", "genre": "art", "nsfw": true, "body": "シンフォギアの立花響が大男にチョークスリーパーをかけられるイラストをお願いします\n衣装はギアで失禁あり以外は任せます\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/94", "thumbnail_src": "https://si.imgix.net/7acfba76/uploads/origins/1e029890-ffb7-4ea5-b399-def865b7b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a63865536d8beccb549af01625d140", "thumbnail_srcset": "https://si.imgix.net/7acfba76/uploads/origins/1e029890-ffb7-4ea5-b399-def865b7b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a63865536d8beccb549af01625d140, https://si.imgix.net/7acfba76/uploads/origins/1e029890-ffb7-4ea5-b399-def865b7b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad810866c4bd9d49204ec2fee90eda62 2x, https://si.imgix.net/7acfba76/uploads/origins/1e029890-ffb7-4ea5-b399-def865b7b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01127999c36df66bfce9cabb6f45b21b 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\nホロライブの白銀ノエル。\n【衣装】\nhttps://kirisamehare.com/wp-content/uploads/image-364-1.jpg\nこれの一番右。\n【シチュ】\n蛇締め\n【詳細】\n①壁に背をもたれて女の子座りで地面に座り込んでいる。\n胸から下の胴体と首を締めあげられ涎を垂らして悶え苦しんでいる。\n両腕に大蛇のしっぽの先が手錠をするように巻き付いており、頭上に持ち上げられて抵抗できずにいる。\n\n②真綿で首を絞めるように締め上げが強くなっている。\n酸欠で目のハイライトが消えかかっており、少しずつ脱力していっている。\n両腕は頭上に持ち上げられたまま、体が前に傾き首が項垂れて下を突き出しで苦しんでいる。\n\n③完全に脱力し、両腕が解放され垂れ下がっている。\n両腕に巻きついていた胴体がノエルの首に巻き付き締め上げの強さが上がる。\n目にハイライトはなく気絶寸前で失禁している。\n絞め殺されるかもしれない恐怖に怯えている。\n\n④地面に横倒しにされ、数時間に窒息死寸前まで締めあげられては緩められる行為を繰り返され、両腕を垂らして。ぐったりしている。\nもはや蚊の鳴くような声で呻くことしかできなくなっている。\n\n全体的に胸を強調する感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/93", "thumbnail_src": "https://si.imgix.net/d84dc6f8/uploads/origins/9274584b-5551-493d-83c8-7f8ffc84ccc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b28bbcc08a108a16dcf4d27acdd52b52", "thumbnail_srcset": "https://si.imgix.net/d84dc6f8/uploads/origins/9274584b-5551-493d-83c8-7f8ffc84ccc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b28bbcc08a108a16dcf4d27acdd52b52, https://si.imgix.net/d84dc6f8/uploads/origins/9274584b-5551-493d-83c8-7f8ffc84ccc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=551872c8cc1416e96138c469ae42d5ac 2x, https://si.imgix.net/d84dc6f8/uploads/origins/9274584b-5551-493d-83c8-7f8ffc84ccc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=975d731e5ce34687c7200e189aaac9a6 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました\n\n【キャラ】\n常陸茉子［千恋*万花］\n\n【シチュ】\n触手+首絞め+拘束\n\n【触手拘束参考】\nhttps://www.pixiv.net/artworks/96295461\n\n【キャラ資料】\nhttps://www.aliceglint.com/figure/fig_mako/\nhttps://www.broccoli.co.jp/figure/figure37-sr_mako/\n以上です。何卒ご検討の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/92", "thumbnail_src": "https://si.imgix.net/aef4f972/uploads/origins/52b39541-d849-4a4a-80b5-d4d352ca53f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef03b1d91d8da15d67bf96498ac3e222", "thumbnail_srcset": "https://si.imgix.net/aef4f972/uploads/origins/52b39541-d849-4a4a-80b5-d4d352ca53f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef03b1d91d8da15d67bf96498ac3e222, https://si.imgix.net/aef4f972/uploads/origins/52b39541-d849-4a4a-80b5-d4d352ca53f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81b9155ff6aa5cf08b6f98c77ce64887 2x, https://si.imgix.net/aef4f972/uploads/origins/52b39541-d849-4a4a-80b5-d4d352ca53f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a74a2cd712f570ae6defae02bd79c384 3x", "genre": "art", "nsfw": true, "body": "戦姫絶唱シンフォギアより暁切歌の首絞めをお願いいたします。\nシチュエーションはゴーストハンドによる片手首絞めで手の拘束はおまかせ。\n服装は３期GX第1話のクリス宅にてライブを見てた時の服か、GXの時によく着ていた私服で肩や脇が見えるくらい破れた状態のどちらか。\n失禁は無しでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/91", "thumbnail_src": "https://si.imgix.net/e46adbc4/uploads/origins/9ac4c2b1-8acc-491e-bb07-fcf13265d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cae05e29025c021b9191d05dbdc7802", "thumbnail_srcset": "https://si.imgix.net/e46adbc4/uploads/origins/9ac4c2b1-8acc-491e-bb07-fcf13265d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cae05e29025c021b9191d05dbdc7802, https://si.imgix.net/e46adbc4/uploads/origins/9ac4c2b1-8acc-491e-bb07-fcf13265d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84b85f044f42f3d1668d53352106ea13 2x, https://si.imgix.net/e46adbc4/uploads/origins/9ac4c2b1-8acc-491e-bb07-fcf13265d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f52ce2aac618dcd27fcb9b153d773bf6 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nリクエストをお送りさせて頂きます。\n\n下記のキャラクターでイラスト作成のご検討をお願い致します。\n\n登場作品:英雄伝説　黎の軌跡\nキャラクター：アニエス・クローデル（https://www.falcom.co.jp/kuro/character/agnes.html）\n\n【希望シチュエーション＆備考】\n・背後から白い大蛇に全身を締め付けられて苦しみ悶える様をお願いします。イメージとしては下記参考イラストのような感じでお願いします。\n\n参考イラスト：https://www.pixiv.net/artworks/134291316\n\n・尻尾の先端（首に巻き付いている部分）については完全なリング状にして頂きたいです。\n\n・アニエスの服装は帽子とコートを脱いだ状態（頭のリボンは付けたまま）にして下さい。\n\n・表情は両目を閉じつつ、口を開けて悶えている感じにして欲しいです。※差分についてはお任せで大丈夫です。\n\n是非ともご検討のほど、宜しくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/90", "thumbnail_src": "https://si.imgix.net/e0be06ad/uploads/origins/c81e2796-93f1-4f2c-9e89-12e7b881c4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fecff96556f7aa23d2fcaf9354a61a9", "thumbnail_srcset": "https://si.imgix.net/e0be06ad/uploads/origins/c81e2796-93f1-4f2c-9e89-12e7b881c4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fecff96556f7aa23d2fcaf9354a61a9, https://si.imgix.net/e0be06ad/uploads/origins/c81e2796-93f1-4f2c-9e89-12e7b881c4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cf5c4d21f64214bd5fa8f444b654110 2x, https://si.imgix.net/e0be06ad/uploads/origins/c81e2796-93f1-4f2c-9e89-12e7b881c4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d3545a6dc2b0d256b71fb39a911bfd9 3x", "genre": "art", "nsfw": true, "body": "https://youtube.com/@wepleofficial\n上記作品、ウェディングアップルのアップルが植物に拘束されている絵をお願いします。\n\nhttps://youtu.be/ajRTzd192Gg?si=NhECn03-ZNhKuFfj\nこちらの動画の最初の方がイメージです。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/89", "thumbnail_src": "https://si.imgix.net/6d9b5463/uploads/origins/28c39f5b-0b60-471e-a1f0-0a7690664917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc44b48ce2f0f6fd2942c7bf99b77da0", "thumbnail_srcset": "https://si.imgix.net/6d9b5463/uploads/origins/28c39f5b-0b60-471e-a1f0-0a7690664917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc44b48ce2f0f6fd2942c7bf99b77da0, https://si.imgix.net/6d9b5463/uploads/origins/28c39f5b-0b60-471e-a1f0-0a7690664917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b96137ca528e82c7847459af83a153b 2x, https://si.imgix.net/6d9b5463/uploads/origins/28c39f5b-0b60-471e-a1f0-0a7690664917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=901c2430c07cf8cb3b6d8b91e41a48e8 3x", "genre": "art", "nsfw": true, "body": "ミュウレタス(2002年版)の首絞めをお願いします\n涙や涎､失禁あり以外は全てそちらにお任せします\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/88", "thumbnail_src": "https://si.imgix.net/cf054312/uploads/origins/83dd5c2c-d371-4c9d-8d73-e62c8c890077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2db594a57af0478013584bee06b64bf", "thumbnail_srcset": "https://si.imgix.net/cf054312/uploads/origins/83dd5c2c-d371-4c9d-8d73-e62c8c890077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2db594a57af0478013584bee06b64bf, https://si.imgix.net/cf054312/uploads/origins/83dd5c2c-d371-4c9d-8d73-e62c8c890077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfcc383f4420c59b12dcb8c38f5b2f91 2x, https://si.imgix.net/cf054312/uploads/origins/83dd5c2c-d371-4c9d-8d73-e62c8c890077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dad374753780ae1b23e0052356a3d01b 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n【キャラ】\nホロライブReGLOSSの音乃瀬奏ちゃんです。\n身長は153cmと小柄です。\n詳細は資料URLをご覧下さい。\n【シチュエーション】\n細い触手での首絞めをお願い致します。\n初めに首から締められ、次第に手足を縛られていき抵抗ができなくなるという形でお願いしたいです。\n最後には抵抗する力もないくらい脱力しているとありがたいです。\nキュアスカイ、ハレワタールちゃんの4枚目の片目を開き涎を垂らし苦しむ姿がとても魅力的でした。似たような描写をぜひお願い致します。\n長文失礼しました。ご検討の程、よろしくお願い致します。\n\nhttps://hololive.hololivepro.com/talents/otonose-kanade/\n\nhttps://hololive.hololivepro.com/talents/otonose-kanade/", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/87", "thumbnail_src": "https://si.imgix.net/5c23a632/uploads/origins/daf794df-bb06-41ad-abae-5d6e28b78426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=046e4d39ca184f28c3de4e31478c4ae2", "thumbnail_srcset": "https://si.imgix.net/5c23a632/uploads/origins/daf794df-bb06-41ad-abae-5d6e28b78426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=046e4d39ca184f28c3de4e31478c4ae2, https://si.imgix.net/5c23a632/uploads/origins/daf794df-bb06-41ad-abae-5d6e28b78426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a00e9d9aabd402742b49c2c78386e57d 2x, https://si.imgix.net/5c23a632/uploads/origins/daf794df-bb06-41ad-abae-5d6e28b78426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=606808033e583007a23ce11b33675481 3x", "genre": "art", "nsfw": true, "body": "ひろがるスカイ！プリキュアよりソラ・ハレワタールの触手首絞めをお願いします。\n見た目は変身前、服装は夏服(公式サイトで見れます)\nシチュエーションとしまして、本編第4話のキノコランボーグによる触手拘束のIF展開として、最初は首だけに触手を1巻きし絞め上げる形。その後は本編通りかお好きな様に手も拘束する感じでお願いします。また本編ではその後ガムテープのようなもので口を塞いでいましたがそれは無し、失禁も無しでお願いします。\n長文失礼しました。ご一考お願いします", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/86", "thumbnail_src": "https://si.imgix.net/5c4becd2/uploads/origins/18545e16-c153-4baf-95e8-d1347527ba10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95d87423862120dee2f7cb1cbd95962b", "thumbnail_srcset": "https://si.imgix.net/5c4becd2/uploads/origins/18545e16-c153-4baf-95e8-d1347527ba10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95d87423862120dee2f7cb1cbd95962b, https://si.imgix.net/5c4becd2/uploads/origins/18545e16-c153-4baf-95e8-d1347527ba10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=355e21f47af4ea044abed4f81d09fef0 2x, https://si.imgix.net/5c4becd2/uploads/origins/18545e16-c153-4baf-95e8-d1347527ba10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a40f69011d20f988750360d40bfb4f8 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ失礼致します。\nリクエストを送らせて頂きます。\n下記キャラクターでイラスト作成のご検討をお願い致します。\n\n登場作品:学園アイドルマスター\nキャラクター:姫崎莉波\n※服装は学生服姿でお願いします。\n\n【シチュエーション】\n・白い体をした大蛇に締め付けられて苦しみ喘ぐ様を描いて頂きたいです。\n\n・イメージとしては下記の参考イラストのような感じでお願いします。また、尻尾の先端（首に巻き付いている部分）は完全なリング状にして描いて下さい。\n\n参考イラスト:https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRuMm_ciqfFFrlVcDPqC5BgLpsCKB0cbneQm6YWFd9wmyXLnv2e_A3689A&s=10\n\n是非ともご一考のほど、宜しくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@misakajoutarou/works/85", "thumbnail_src": "https://si.imgix.net/dfb1ca58/uploads/origins/277f67c8-ef13-4afc-bde1-091e8a508d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad473b05218b85e6dd38961421bedd75", "thumbnail_srcset": "https://si.imgix.net/dfb1ca58/uploads/origins/277f67c8-ef13-4afc-bde1-091e8a508d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad473b05218b85e6dd38961421bedd75, https://si.imgix.net/dfb1ca58/uploads/origins/277f67c8-ef13-4afc-bde1-091e8a508d56?bg=%23fff&auto=format%2Ccompress&fm=webp