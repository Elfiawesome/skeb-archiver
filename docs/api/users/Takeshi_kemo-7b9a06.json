-483f-8996-e86d50067e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a1e35f693fb850ba129d15d789c4c3a 3x", "genre": "art", "nsfw": true, "body": "takeshiさん、こんにちは。私のキャラクターであるリリーが、白と青の袴を着て、胸の谷間を見せているところを描いていただけると嬉しいです。ポーズは、机に座ってパソコンを使おうとしているが、胸が大きすぎて邪魔になっている、片手を胸の上に置き、もう片方の手は開いた口の近くに置いて、恥ずかしそうに慌てている、というものにします。彼女の袴のレフリーはこちらです： https://media.discordapp.net/attachments/937198923192352768/937207042513461288/434713-1.output.png?width=656&height=669\n\nhttps://media.discordapp.net/attachments/937198923192352768/937209788448788490/01.png?width=909&height=670", "created_at": "", "completed_at": ""}, {"path": "/@Takeshi_kemo/works/21", "thumbnail_src": "https://si.imgix.net/2b23f852/uploads/origins/1ed62ffc-54e3-4071-8c6b-0abf90963bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a644cfc4fef6e745e9eee16b2fcbdcb", "thumbnail_srcset": "https://si.imgix.net/2b23f852/uploads/origins/1ed62ffc-54e3-4071-8c6b-0abf90963bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a644cfc4fef6e745e9eee16b2fcbdcb, https://si.imgix.net/2b23f852/uploads/origins/1ed62ffc-54e3-4071-8c6b-0abf90963bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a3214acf7685a3af4db8c88e3377f2f 2x, https://si.imgix.net/2b23f852/uploads/origins/1ed62ffc-54e3-4071-8c6b-0abf90963bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12994717f40e0ba65bdc7fc96bea5120 3x", "genre": "art", "nsfw": true, "body": "寅年ということなので、ホワイトタイガーモチーフのぽっちゃり爆乳ケモロリちゃんをお願いします。\n衣装:濡れ透け制服、下着の代わりにスク水着用\nオプション性癖:乳輪大きめ、陥没乳首、母乳\nシチュ案:田舎の川で友達と水遊び中におしっこしたくなり木陰に隠れて放尿…ドキドキしながら搾乳オナニーもしちゃった…。\n\nシチュの方は案なので他に思いつくものがありましたらそれで全然大丈夫です！\nこんな感じで可能でありましたら、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Takeshi_kemo/works/20", "thumbnail_src": "https://si.imgix.net/386f96a4/uploads/origins/2f050bd4-6590-41b1-b239-0128c9c9b621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=488a44f42172519eea508ce10eba5e2a", "thumbnail_srcset": "https://si.imgix.net/386f96a4/uploads/origins/2f050bd4-6590-41b1-b239-0128c9c9b621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=488a44f42172519eea508ce10eba5e2a, https://si.imgix.net/386f96a4/uploads/origins/2f050bd4-6590-41b1-b239-0128c9c9b621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=173fceb238eb56e293623d0b6ca44e88 2x, https://si.imgix.net/386f96a4/uploads/origins/2f050bd4-6590-41b1-b239-0128c9c9b621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6d5a749456a12298942ad52c12bfbc1 3x", "genre": "art", "nsfw": true, "body": "二人ともセータードレスを着て、片方の胸を潰しながら、エルビアは魅惑的な表情で、リリーはキツネのお面をかぶって開放的な笑顔で、片方の手は自分の胸に当てて、もう片方の手は脇に添えるというものです。\n\n両者の参考文献\n\nリリー: https://imgur.com/a/VwvL4gw\n\nエルビア： https://imgur.com/a/HRe0TCS", "created_at": "", "completed_at": ""}, {"path": "/@Takeshi_kemo/works/19", "thumbnail_src": "https://si.imgix.net/26699aff/uploads/origins/dbcf8f44-5f93-4a5e-bf65-a9595c1b793a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e346cab81ba43f7b328153c6e2dea1a", "thumbnail_srcset": "https://si.imgix.net/26699aff/uploads/origins/dbcf8f44-5f93-4a5e-bf65-a9595c1b793a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e346cab81ba43f7b328153c6e2dea1a, https://si.imgix.net/26699aff/uploads/origins/dbcf8f44-5f93-4a5e-bf65-a9595c1b793a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5b7e104ba1e56846eeb4b6f49ac57d9 2x, https://si.imgix.net/26699aff/uploads/origins/dbcf8f44-5f93-4a5e-bf65-a9595c1b793a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5bff1ea2ed9a277004c34ce43d42643 3x", "genre": "art", "nsfw": true, "body": "たけしさん、こんにちは。また開いてくれて嬉しいです!私のキャラクターであるリリーは、紫の着物を着て、後ろを向いている姿を描いていただけると嬉しいです。大きなお尻に手を当て、尻尾を上げて濡れたアソコとお尻の穴を見せながら、恥ずかしそうに視聴者を見ている姿を描いていただけると嬉しいです。\n\nhttps://media.discordapp.net/attachments/584505424900784153/904430557516136528/516498-1.output.png", "created_at": "", "completed_at": ""}, {"path": "/@Takeshi_kemo/works/18", "thumbnail_src": "https://si.imgix.net/f384eb12/uploads/origins/73928cc7-a37d-4015-8591-cb492ca03299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d872fe0f6129ac4a00e4c12f8d6b8cf", "thumbnail_srcset": "https://si.imgix.net/f384eb12/uploads/origins/73928cc7-a37d-4015-8591-cb492ca03299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d872fe0f6129ac4a00e4c12f8d6b8cf, https://si.imgix.net/f384eb12/uploads/origins/73928cc7-a37d-4015-8591-cb492ca03299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=839d51132c59a03340499b796ab209f7 2x, https://si.imgix.net/f384eb12/uploads/origins/73928cc7-a37d-4015-8591-cb492ca03299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=958c18e5022951ddad1463f9d5928263 3x", "genre": "art", "nsfw": true, "body": "たけしさん、こんにちは。遅くなりましたが、よろしくお願いします。私のキャラクターであるリリーは、黒の裸エプロンを身につけ、テーブルの隅で恥ずかしそうに、そして照れくさそうに見る人を見ながら、写真のように彼女のジュースでちょっとした混乱を残しているところを描いていただきたいです。彼女の片方の腕は横にあり、もう片方の腕は彼女の大きな胸の下にあって、もう片方の腕を掴んでいるはずです。私はこのようなものを期待していました。https://media.discordapp.net/attachments/750415980701679739/870814859539906591/Screenshot_20210118-124715_Twitter.jpg?width=480&height=670\n\nhttps://media.discordapp.net/attachments/584505424900784153/838131579577958450/lilycommission28421.png?width=503&height=670", "created_at": "", "completed_at": ""}]}