c97f/uploads/origins/38b8abbd-469d-4c70-ba9a-e34153203ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1547c67f5804aaacfae2770d5c16f174", "thumbnail_srcset": "https://si.imgix.net/f4b8c97f/uploads/origins/38b8abbd-469d-4c70-ba9a-e34153203ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1547c67f5804aaacfae2770d5c16f174, https://si.imgix.net/f4b8c97f/uploads/origins/38b8abbd-469d-4c70-ba9a-e34153203ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54a2ad6f9785a6bdc676c83615551163 2x, https://si.imgix.net/f4b8c97f/uploads/origins/38b8abbd-469d-4c70-ba9a-e34153203ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d3350e31ee5b03f4351ebae6e55a6dc 3x", "genre": "art", "nsfw": false, "body": "どの程度まで指定しても良いか存じ上げないため参考程度で構いませんが、白か銀髪のウルフカットが好みなので要素としてあったら嬉しいです。（ご参考までに申し上げるなら鶴丸国永というキャラのビジュアルが個人的好みです）\n\n個人的にアクリルブロックにして飾りたいため110mm×110mm 300dpi以上でお願いしたいのですが、ご都合悪ければご自由にしていただいて構いません。\n\nゆっくりで構いませんので楽しみにしております。", "created_at": "", "completed_at": ""}, {"path": "/@75ri_ch/works/8", "thumbnail_src": "https://si.imgix.net/bbcdfbb5/uploads/origins/780b1a43-76fd-4fbd-8139-0ffb9de67104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23b963b135a925f321462f2cd38cc66b", "thumbnail_srcset": "https://si.imgix.net/bbcdfbb5/uploads/origins/780b1a43-76fd-4fbd-8139-0ffb9de67104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23b963b135a925f321462f2cd38cc66b, https://si.imgix.net/bbcdfbb5/uploads/origins/780b1a43-76fd-4fbd-8139-0ffb9de67104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05b7e432658766486eb9fe6a66c793c3 2x, h