9ef-4c6a-8031-f95268ba1383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de113a32f17eb98892f82d8b9b55a576, https://si.imgix.net/d1a0e790/uploads/origins/496faef2-09ef-4c6a-8031-f95268ba1383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11afad5505261c930273ea9fe4339ac4 2x, https://si.imgix.net/d1a0e790/uploads/origins/496faef2-09ef-4c6a-8031-f95268ba1383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=857a95fa2049c443130e60c01775a47f 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nお洒落で綺麗な雰囲気のイラスト拝見しております。\nこの度は自分の創作キャラクター「椎奈」のイラストをお願いしたく、リクエストを送らせていただきました。\n\n・明るい性格の、小柄な女の子です。\n・小豆色のふんわりした髪は右側の横髪が長くなっており、緑色の目は中央にもハイライトが入っています。\n・基本的な服装は黒・赤・茶色を基調としたベレー帽・ワンピース等ですが、細部に関してはある程度自由に解釈して頂ければと思います。\n・赤色の薔薇等の花をモチーフに、クラシカルでお洒落な雰囲気にして頂けると嬉しいです。\n\n何卒よろしくお願いいたします。\n\n・https://dl.dropboxusercontent.com/s/nu1170hlbcvfz58/%E6%A4%8E%E5%A5%88_%E8%B3%87%E6%96%99_20221022.zip", "created_at": "", "completed_at": ""}, {"path": "/@75ri_ch/works/5", "thumbnail_src": "https://si.imgix.net/d77c7593/uploads/origins/baabb5e9-95ff-48cf-ba92-6937da7118e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9fd77487570d25761b51d26fb60995", "thumbnail_srcset": "https://si.imgix.net/d77c7593/uploads/origins/baabb5e9-95ff-48cf-ba92-6937da7118e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9fd77487570d25761b51d26fb60995, https://si.imgix.net/d77c7593/uploads/origins/baabb5e9-95ff-48cf-ba92-6937da7118e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b0c7536631ff017dedfef3f798743ac 2x, https://si.imgix.net/d77c7593/uploads/origins/baabb5e9-95ff-48cf-ba92-6937da7118e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=588f5ba6ffe90331d52c89d608ba691e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n・ 私の参考資料の中から好きなキャラクターを選んでください\n・ 好きなことをしてください！\n・ 背景をお願いします\n・ .clipファイルではレイヤーを分離しておいてください　(.psdもOK)\n\nhttps://drive.google.com/drive/folders/1rngNTNwLzHxK81-PV3HJ5tS9vHGivpcI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@75ri_ch/works/4", "thumbnail_src": "https://si.imgix.net/72dd90b0/uploads/origins/fd23d4da-1b9d-4e6d-a8ac-51ed54ead2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f5345f756f05d6f429b708123c60e85", "thumbnail_srcset": "https://si.imgix.net/72dd90b0/uploads/origins/fd23d4da-1b9d-4e6d-a8ac-51ed54ead2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f5345f756f05d6f429b708123c60e85, https://si.imgix.net/72dd90b0/uploads/origins/fd23d4da-1b9d-4e6d-a8ac-51ed54ead2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=955c92e1fef8173240d9ce7fcaa4d5e6 2x, https://si.imgix.net/72dd90b0/uploads/origins/fd23d4da-1b9d-4e6d-a8ac-51ed54ead2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15fd5e5f0c602091f01f0b39c8f8954c 3x", "genre": "art", "nsfw": false, "body": "私のオリジナルキャラクターを描いていただきたいです。キャラクターデザインはお手数ですが資料URLから私のツイートを見ていただきたいです。分からなかった箇所は想像で構いません。\n何もかもおまかせにさせていただきたいです…！よろしくお願いします。\n\nhttps://twitter.com/ashita_0401/status/1531284535433826305?t=BV3doqIRLn6Y_Ro3dTfZbg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@75ri_ch/works/3", "thumbnail_src": "https://si.imgix.net/7c822757/uploads/origins/f0cbdb4b-c817-4ef2-ba82-cf145eaff9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab9306d452ed3dc075d3aad00c28bef", "thumbnail_srcset": "https://si.imgix.net/7c822757/uploads/origins/f0cbdb4b-c817-4ef2-ba82-cf145eaff9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab9306d452ed3dc075d3aad00c28bef, https://si.imgix.net/7c822757/uploads/origins/f0cbdb4b-c817-4ef2-ba82-cf145eaff9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a201a00245314de8dab1f67050cea0e0 2x, https://si.imgix.net/7c822757/uploads/origins/f0cbdb4b-c817-4ef2-ba82-c