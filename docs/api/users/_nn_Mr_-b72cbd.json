ませんか？その年、彼は34歳で、ティーン・タイタンズのスレイドと同じ顔の髪型で、このような服装とポーズをしています: https://static.wikia.nocookie.net/teentitans/images/4/40/Slade%27s_face.jpg/revision/latest?cb=20140206212705 。彼の両腕はそのままに描いてください。\nまた、肌は青白く、髪は前髪なしの乱れた短髪で描く。左目は青。", "created_at": "", "completed_at": ""}, {"path": "/@_nn_Mr_/works/28", "thumbnail_src": "https://si.imgix.net/680175b5/uploads/origins/a80fa87c-8c1b-4df6-b34b-f804bbff29b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2119689bd85c407c152d9f50016d0ad9", "thumbnail_srcset": "https://si.imgix.net/680175b5/uploads/origins/a80fa87c-8c1b-4df6-b34b-f804bbff29b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2119689bd85c407c152d9f50016d0ad9, https://si.imgix.net/680175b5/uploads/origins/a80fa87c-8c1b-4df6-b34b-f804bbff29b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edfd08d0795972ffd33b568cdaf7e9eb 2x, https://si.imgix.net/680175b5/uploads/origins/a80fa87c-8c1b-4df6-b34b-f804bbff29b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=912be3b28c21f757cbbda0eee1426bae 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_nn_Mr_/works/27", "thumbnail_src": "https://si.imgix.net/c5113736/uploads/origins/464fb82c-599a-4ac8-909b-68aed2e1af4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2a6cbec8d47330ff5b6cd8fae22d57", "thumbnail_srcset": "https://si.imgix.net/c5113736/uploads/origins/464fb82c-599a-4ac8-909b-68aed2e1af4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2a6cbec8d47330f