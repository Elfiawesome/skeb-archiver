a6c03f6b4867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45d9034db4ff109681d27b300dcd6439 2x, https://si.imgix.net/311c08e3/uploads/origins/3b0781e0-feec-49c8-8975-a6c03f6b4867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bb03962d97ec1eb5305acf450537875 3x", "genre": "art", "nsfw": true, "body": "いつもMisskeyでお世話になってます。\n前回は素敵なイラストありがとうございました。\nまたうちの子のルェルちゃんを描いて頂きたいと思いリクエストします。\n\n・リクエスト内容　\nR-15くらいのえちかわなベビードール姿(デザインはお任せします)をお願いします。\n\n\n\n・参考画像\nhttps://drive.google.com/drive/folders/1TTx5n1ye5_nFn9bz7XUWBh7xN-DiPru6\n\n・設定\n身長：155cm(けもみみ含めず)\n好きな物：チョコミント\n性格：おっとり\n基本的には怒らないけどチョコミントのことを歯磨き粉って言うと、ほっぺをぷくーとさせて怒る\n　\n以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/22", "thumbnail_src": "https://si.imgix.net/27056c4c/uploads/origins/3ad05657-2c73-4a17-b4b4-d6505f21e6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de05c8866467ad452508521b58cc0caf", "thumbnail_srcset": "https://si.imgix.net/27056c4c/uploads/origins/3ad05657-2c73-4a17-b4b4-d6505f21e6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de05c8866467ad452508521b58cc0caf, https://si.imgix.net/27056c4c/uploads/origins/3ad05657-2c73-4a17-b4b4-d6505f21e6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99d13f00ecade66e6a0021ced3038d37 2x, https://si.imgix.net/27056c4c/uploads/origins/3ad05657-2c73-4a17-b4b4-d6505f21e6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20e06ed32ea833140badb5cad6066a25 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\nうちの子である尻尾の生えた褐色黒猫娘のひじき子のイラストをお願いします。\n\nシチュエーションですが、せっかくミスキー経由でアピール頂いたので、沢山のにゃんぷっぷーと一緒にいるひじき子と猫の方のひじきをお願いします。\n衣装はお任せしますので、着せてみたい服を自由に着せて頂けたら幸いです。\n\n宛名はpsdレイヤーでon.offできるとありがたいです。\n必要かは分かりませんがひじき子の元になった猫の写真は自分のツイッター垢のメディア欄に概ねあります。\n尻尾の描き忘れが時々起こるので最後に確認よろしくお願いします。\n\n\n今まで描いて頂いた衣装資料\nhttps://min.togetter.com/qFzftqS\n\nひじき子の資料と依頼一覧\nhttps://min.togetter.com/KnUvwjq", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/21", "thumbnail_src": "https://si.imgix.net/a5d01d29/uploads/origins/96da2700-9f59-4277-8958-87ad8bcf3331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34d3a5ed04fdc9c9c67c0a60dc9f40ea", "thumbnail_srcset": "https://si.imgix.net/a5d01d29/uploads/origins/96da2700-9f59-4277-8958-87ad8bcf3331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34d3a5ed04fdc9c9c67c0a60dc9f40ea, https://si.imgix.net/a5d01d29/uploads/origins/96da2700-9f59-4277-8958-87ad8bcf3331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9d55dde610a97c44c7f0e4e4097df42 2x, https://si.imgix.net/a5d01d29/uploads/origins/96da2700-9f59-4277-8958-87ad8bcf3331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f489db84550444997c05c171b3774a8e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Misskeyでイラストを拝見させて頂いてます。\n\nこちらのイラスト(https://misskey.io/notes/9zayv7z42qso02wm)の服装が可愛いので、地雷系の服装したうちのこのルェルちゃんのイラストをお願いしたいです。\n表情はウィンクでポーズ等その他はお任せします。\n\n・参考画像\nhttps://drive.google.com/drive/folders/1TTx5n1ye5_nFn9bz7XUWBh7xN-DiPru6\n\n・設定\n身長：155cm(けもみみ含めず)\n好きな物：チョコミント\n性格：おっとり\n基本的には怒らないけどチョコミントのことを歯磨き粉って言うと、ほっぺをぷくーとさせて怒る\n　\n以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/20", "thumbnail_src": "https://si.imgix.net/793665b2/uploads/origins/abb95608-3353-4e9c-a74c-9e356887d10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f9815af507703a0f063511aa07d48b", "thumbnail_srcset": "https://si.imgix.net/793665b2/uploads/origins/abb95608-3353-4e9c-a74c-9e356887d10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f9815af507703a0f063511aa07d48b, https://si.imgix.net/793665b2/uploads/origins/abb95608-3353-4e9c-a74c-9e356887d10f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca6339a1bd0ac6e208eb41c36b73fdf 2x, https://si.imgix.net/793665b2/uploads/origins/abb95608-3353-4e9c-a74c-9e356887d10f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c209f9ab7f9f0bcb0ff2ee5ea3394c81 3x", "genre": "art", "nsfw": false, "body": "前回のリクエスト(公園おでかけしている、米沢焼擬人化の少女)はお世話になりました。\n「デレマスも描けますのでまたよかったらお願いします～」との事でしたので、↓のリクエストをさせて頂きます。\n\n■作品・キャラクター：アイドルマスターシンデレラガールズの今井加奈ちゃん\n\n■衣装：横浜ワールドポーターズとのコラボ衣装(久川颯ちゃん着用の衣装)\n元イラストの緑色(リボンなど)の部分は黄色で\n\nワールドポーターズコラボで描き下ろされた衣装がとても可愛かったので、その衣装を着た加奈ちゃんのイラストを見てみたく、リクエストします。\n\n・参考URL：https://idolmaster-official.jp/news/01_12446\n\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/19", "thumbnail_src": "https://si.imgix.net/8ed4956b/uploads/origins/ac888ee0-9018-4ff7-8eda-598998b4a96d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995adb89196cd231347c8c8d88728603", "thumbnail_srcset": "https://si.imgix.net/8ed4956b/uploads/origins/ac888ee0-9018-4ff7-8eda-598998b4a96d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995adb89196cd231347c8c8d88728603, https://si.imgix.net/8ed4956b/uploads/origins/ac888ee0-9018-4ff7-8eda-598998b4a96d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=384cd48960a137f12d2ffc6326938942 2x, https://si.imgix.net/8ed4956b/uploads/origins/ac888ee0-9018-4ff7-8eda-598998b4a96d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72b885c5419b8401a53cc347a228b90d 3x", "genre": "art", "nsfw": false, "body": "くるみるみ🐱さん!はじめまして！\nお世話になっています。\nお橙色と申します。\n\nリアクションありがとうございます。\nフォロワーさんが1000人突破したので記念イラストを描いていただきたくてリクエストさせていただきます。\n\n・要望\n「フォロワーさん1000人突破！」と言う字が入っていて、私お橙色が喜んでいるイラストをお願いします。\n構図シチュエーション等はおまかせします。\n服装なども自由に改変して大事です。\nできれば字あり字なしの差分もあれば幸いです。\n\n以上、よろしくお願いいたします。\n\n詳細な資料などはリンクを貼っておきます。\n\nhttps://misskey.io/notes/9lwvu0vj3f", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/18", "thumbnail_src": "https://si.imgix.net/bf188adb/uploads/origins/659bef45-e9b9-4f08-8b60-18aa498685fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ecea8b196a1dc5c26d06b4bdf27c3f", "thumbnail_srcset": "https://si.imgix.net/bf188adb/uploads/origins/659bef45-e9b9-4f08-8b60-18aa498685fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ecea8b196a1dc5c26d06b4bdf27c3f, https://si.imgix.net/bf188adb/uploads/origins/659bef45-e9b9-4f08-8b60-18aa498685fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a098c6b4c066dbe61bbe600fac507e2 2x, https://si.imgix.net/bf188adb/uploads/origins/659bef45-e9b9-4f08-8b60-18aa498685fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ad855a398e6091189587ce9784716fa 3x", "genre": "art", "nsfw": false, "body": "初めまして、リクエストさせて頂きます。\n\nXなどで見かけた、「米沢焼の擬人化(https://www.pixiv.net/artworks/116133793)」の女の子がとても可愛かったです。\n\n他の方のリクエストで描かれたキャラのリクエストになって恐縮なのですが、\nもしよろしければ、その娘が公園にお出かけしているシチュエーションなイラストをお願いしてもよろしいでしょうか？\n\n構図など、その他諸々はお任せします。ご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/17", "thumbnail_src": "https://si.imgix.net/4f653aa2/uploads/origins/819b2ab8-e074-4433-a3af-314d567dd201?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8695905475e38d2f6b47c053dd4a7584", "thumbnail_srcset": "https://si.imgix.net/4f653aa2/uploads/origins/819b2ab8-e074-4433-a3af-314d567dd201?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8695905475e38d2f6b47c053dd4a7584, https://si.imgix.net/4f653aa2/uploads/origins/819b2ab8-e074-4433-a3af-314d567dd201?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79a571d506471fe327fcb3ee62d76b6f 2x, https://si.imgix.net/4f653aa2/uploads/origins/819b2ab8-e074-4433-a3af-314d567dd201?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edc7df7756c8c4b34f2908ab7dde659c 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！！\nもしよろしければ自創作の男女キャラをリクエストさせていただいてもよろしいでしょうか？\nURLに資料や作品を繋げておりますのでご参考ください。\n\n◆キャラ\n女の子「藤森潤」\n・クールな見た目に反して中身ポンコツな女の子です。\n・タレ眉毛でツリ目、表情豊かで少しポワポワした性格です。\n・イメージカラー：水色\n\n男の子「墨染千晃」\n・わかりやすいツンデレキャラ。\n・目付きが悪く、基本的に無表情か不機嫌そうなムスッとした顔をしています。\n・イメージカラー：赤\n\n※URL資料の記事をスクロールしていただくと該当のキャラが出てきます。\nお手数ですがオリジナルサイズで大きいサイズを表示した上でご確認下さい。\n\n◆服装\nおまかせします。資料にあるものから好きなものを選んでください。\nまたはご自由に似合いそうな服を着せていただいてもかまいません。\n\n◆その他\nポーズや構図などは特に指定ございませんので、お好きに描いていただければと思います。\n可能であればキャラの周りが透過されたデータもいただけると嬉しいです。\n \n何卒ご検討よろしくお願いいたします！\n\nhttps://tasomorera.fanbox.cc/posts/5139351", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/16", "thumbnail_src": "https://si.imgix.net/256d9498/uploads/origins/3d9ef63a-07eb-4340-a58c-e0644edd3534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f35bb30c0a69f75887375ac009d597ef", "thumbnail_srcset": "https://si.imgix.net/256d9498/uploads/origins/3d9ef63a-07eb-4340-a58c-e0644edd3534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f35bb30c0a69f75887375ac009d597ef, https://si.imgix.net/256d9498/uploads/origins/3d9ef63a-07eb-4340-a58c-e0644edd3534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccd0b506c7d841b428f1ba37077ec0a4 2x, https://si.imgix.net/256d9498/uploads/origins/3d9ef63a-07eb-4340-a58c-e0644edd3534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62f4355e73d69940aa06b6028059c9a3 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです\n今回はヒシアケボノのイラストをお願いします\n\n資料の様な服を着て料理をしているイラストをお願いします\n構図やポーズはお任せします\n宜しければお願いします\n\nhttps://static.wikia.nocookie.net/gensin-impact/images/b/ba/NPC_Katheryne.png/revision/latest?cb=20230102023015", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/15", "thumbnail_src": "https://si.imgix.net/c40b6964/uploads/origins/8beba059-d23f-4efd-b152-8a327d810d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c78f6854e0746e172e2135358207d4", "thumbnail_srcset": "https://si.imgix.net/c40b6964/uploads/origins/8beba059-d23f-4efd-b152-8a327d810d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c78f6854e0746e172e2135358207d4, https://si.imgix.net/c40b6964/uploads/origins/8beba059-d23f-4efd-b152-8a327d810d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4daf3725d3a0436c06b3be3d4dc01ac9 2x, https://si.imgix.net/c40b6964/uploads/origins/8beba059-d23f-4efd-b152-8a327d810d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af7f8b2fccc7dada8b47cdea83266191 3x", "genre": "comic", "nsfw": false, "body": "いつもイラスト拝見しております&お世話になっております。\n拙作「セイウンスカイは正論男に褒められたい」上巻から、18〜22ページにわたって記述されております、幼少期のセイウンスカイのエピソードをお願いしたいです。\nこのエピソードはTVアニメ一期の特典小説を引用にならない程度に原型を残して改変した、初期のものとはいえ公式設定のお話であり、あまり認知されていないこのお話を、「アニメ一期BD特典の小説を引用にならないようリファインしたもの」（つまり、公式にこういうお話があったという事実）という言葉を添えて、セイウンスカイファンの方々に伝えられたら…と思います。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/14", "thumbnail_src": "https://si.imgix.net/c6803ad8/uploads/origins/e3afc275-0872-4341-b6f2-6e5f91a18a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafdf98b6f0378a8127e78d5f82b7b02", "thumbnail_srcset": "https://si.imgix.net/c6803ad8/uploads/origins/e3afc275-0872-4341-b6f2-6e5f91a18a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafdf98b6f0378a8127e78d5f82b7b02, https://si.imgix.net/c6803ad8/uploads/origins/e3afc275-0872-4341-b6f2-6e5f91a18a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e67cc8cff573880fc8de71ef606e9d2 2x, https://si.imgix.net/c6803ad8/uploads/origins/e3afc275-0872-4341-b6f2-6e5f91a18a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c43b2a1ef29ee22d6642825631dd9b89 3x", "genre": "art", "nsfw": false, "body": "オリジナルキャラクターで、米沢焼のお皿の擬人化をお願いします。中学生くらいの女の子にしていただけると嬉しいです。\n\nhttps://twitter.com/draco_bless/status/1724390424486547947", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/13", "thumbnail_src": "https://si.imgix.net/69bfef24/uploads/origins/2506115a-1220-488c-b425-6343f77c9e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ad1c7f63158e6658934140e2258c34", "thumbnail_srcset": "https://si.imgix.net/69bfef24/uploads/origins/2506115a-1220-488c-b425-6343f77c9e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ad1c7f63158e6658934140e2258c34, https://si.imgix.net/69bfef24/uploads/origins/2506115a-1220-488c-b425-6343f77c9e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3e668130e6609868914cd293e9d5e99 2x, https://si.imgix.net/69bfef24/uploads/origins/2506115a-1220-488c-b425-6343f77c9e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00eedacd4671a87a18389db315ee8aec 3x", "genre": "art", "nsfw": true, "body": "リクエストよろしいでしょうか。\nKanonの沢渡真琴と祐一をお願いします。\n\n二人の初エッチシーンをお願いします。\n祐一のベッドで仰向けM字開脚の真琴。\n恰好は私服ジャケット無しで、服は捲り上げて胸を露出。\nスカートも捲って性器を露出。片足にはパンツが引っかかっている。\n手間なら裸でも問題無いです。\n\n挿入直前で、祐一が真琴の性器を広げている。\nこれが真琴の…とじっくり見てしまっていて、真琴がそんなに見られたら恥ずかしいよぉ…と恥ずかしそうに言う。\n祐一が慌ててごめんと謝り、じゃあ…入れるよ…と言って竿を性器に当てる。\n\n真琴が涙を浮かべて不安そうにして、怖いよ…祐一ぃ…といった感じの台詞。\n祐一が真琴の頭を撫でて、出来るだけ優しくするから…といい、真琴がこくんと頷く。\n\nそのままゆっくりと挿入していく。\n真琴はだんだんと痛みを感じてきゅっと目を閉じて痛みに耐えていくも、\n祐一の竿が真琴の初めてを貫いて痛いっと辛そうにする。\n破瓜血をお願いします。多い程嬉しいです。性器から垂れたり、シーツに染みが出来たり。\n\n全部入って辛そうに荒く呼吸をする真琴を見て、慌てて大丈夫か！真琴！と声をかける祐一。\n辛そうだけど幸せそうな顔をして、大丈夫だよ…今、とっても幸せとほほ笑む真琴。\n\n痛くて辛いけど幸せそうな初めてという感じでお願いします。\nある程度やり易いように変えてもらって大丈夫です。\n\n真琴はアンダーヘアー無し。肉付き少な目の細めで胸もあまり大きくせずにお願いします。\n台詞などの文字はレイヤー分けをお願いします。\n\n血描写あるので無理でしたらすみません。\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/12", "thumbnail_src": "https://si.imgix.net/1bbc1085/uploads/origins/6a7009a6-3ccc-47b7-a071-445b8c7dd0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23387711910c081b9d62ac2aeb5ff6a4", "thumbnail_srcset": "https://si.imgix.net/1bbc1085/uploads/origins/6a7009a6-3ccc-47b7-a071-445b8c7dd0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23387711910c081b9d62ac2aeb5ff6a4, https://si.imgix.net/1bbc1085/uploads/origins/6a7009a6-3ccc-47b7-a071-445b8c7dd0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aab186b286720841356407ee588db38d 2x, https://si.imgix.net/1bbc1085/uploads/origins/6a7009a6-3ccc-47b7-a071-445b8c7dd0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5577f217da16375af302b8143e184b3c 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです\n今回は前にお願いしたオリキャラの麗歌ちゃんをお願いします\n\nシチュ\n麗歌ちゃんがどうしても彼氏の光太郎とフラウンスコスをしたいとお願いし\n通常勝負服、ドロワと花嫁でお願いするも\n光太郎に通常服ではすね毛\nドロワ衣装だと股間部がもっこりした上にすね毛が見えると苦笑いしながら断れて\n凹んでしまう麗歌ちゃんに、お互いフラウンスの私服姿で写真を撮ろうと光太郎から提案され\n麗歌ちゃんは喜んで了承、二人で写真を撮ってSNSに上げたら\n「スカイさんデカい」「フラワーの人ちっちゃい」「これはリアルフラウンス」\n等プチバズしていて麗歌ちゃんが驚く漫画をお願いします\n\nセリフ等はお任せします（サイレント漫画でもOKです\n\n麗歌ちゃんの見た目の資料も提示します\nhttp://bbs1l.net4u.org/sr3_bbss/19945r14a85i/56_1.png\n\n恋人の見た目は資料を参考にして下さい\n身長対比として、麗歌ちゃんと光太郎君の身長も提示します\nhttp://bbs1l.net4u.org/sr3_bbss/19945r14a85i/73_1.png\n\n宜しければお願いします\n\nhttp://bbs1l.net4u.org/sr3_bbss/19945r14a85i/59_1.png", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/11", "thumbnail_src": "https://si.imgix.net/cc63af37/uploads/origins/001a3378-a00c-4c8b-b86b-6c55472f6c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91d29ea88359d753fc9001fa3e0465c0", "thumbnail_srcset": "https://si.imgix.net/cc63af37/uploads/origins/001a3378-a00c-4c8b-b86b-6c55472f6c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91d29ea88359d753fc9001fa3e0465c0, https://si.imgix.net/cc63af37/uploads/origins/001a3378-a00c-4c8b-b86b-6c55472f6c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38b77620607645968266c2435f933dcb 2x, https://si.imgix.net/cc63af37/uploads/origins/001a3378-a00c-4c8b-b86b-6c55472f6c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34ada679c392fd274b174ae4fd4bbcf6 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見しております。自作品の「ニシノフラワーの乳歯が抜ける話」https://www.pixiv.net/novel/show.php?id=17944879\nについて、以前大変気に入っていただいたので、簡単な抜粋でも良いので、表情やセリフの変化など好きな解釈を入れていただいて構いませんので、この作品をテーマに漫画を描いていただけたらな、と思います。\nご検討よろしくお願いします。\n\nhttps://www.pixiv.net/novel/show.php?id=17944879", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/10", "thumbnail_src": "https://si.imgix.net/3e6ae79c/uploads/origins/4a5151b0-6701-4f5c-9598-ce7987313fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168ec589670272f5e8d2354f8f8aa4af", "thumbnail_srcset": "https://si.imgix.net/3e6ae79c/uploads/origins/4a5151b0-6701-4f5c-9598-ce7987313fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168ec589670272f5e8d2354f8f8aa4af, https://si.imgix.net/3e6ae79c/uploads/origins/4a5151b0-6701-4f5c-9598-ce7987313fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82cfbb8c62ac4671283596dcc91c947e 2x, https://si.imgix.net/3e6ae79c/uploads/origins/4a5151b0-6701-4f5c-9598-ce7987313fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c86a30c770551b8bab52ef271bfb30ba 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです\nまたフラウンスの漫画をお願いします\n\n二人でウマネストをプレイする事になった二人\nいざクエストに出かけようとしたら二人とも後衛職\nどちらかが前衛をやろうと話になり、まずフラワーからジョブチェンジ\nフラワーがいざジョブチェンジするとちょっとセクシーな格好になってしまい、スカイが前衛職をやる事に…今度はスカイが前衛職にジョブチェンジするとカッコいい姿になって\nフラワーがドキッとする漫画をお願いします\n\n二人のコスチュームのイメージは\nスカイ\n後衛　ブラッディスカイ（これは公式画像を参考にして下さい\n前衛　FF5　バッツの魔法剣士\n\nフラワー\n後衛　FF5　クルルの白魔導士（猫耳フード\n前衛　FF5　レナの魔法剣士\nのようなイメージでお願いします\n\nコマ割りやセリフはお任せします\n可能でしたらお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/9", "thumbnail_src": "https://si.imgix.net/812df370/uploads/origins/98c4c9cf-dc74-4220-8b39-eb29d266101a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2631390f032831296111c400006e9117", "thumbnail_srcset": "https://si.imgix.net/812df370/uploads/origins/98c4c9cf-dc74-4220-8b39-eb29d266101a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2631390f032831296111c400006e9117, https://si.imgix.net/812df370/uploads/origins/98c4c9cf-dc74-4220-8b39-eb29d266101a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5c16f010e1ef8d59f96e7f0318983f0 2x, https://si.imgix.net/812df370/uploads/origins/98c4c9cf-dc74-4220-8b39-eb29d266101a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c09276c2b39be2c7c707b9e1b44641c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/8", "thumbnail_src": "https://si.imgix.net/1bc03051/uploads/origins/07eec4c0-a541-4415-8192-75e41cce44a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69d5a8a352bec9e48fa14d28f2bb496a", "thumbnail_srcset": "https://si.imgix.net/1bc03051/uploads/origins/07eec4c0-a541-4415-8192-75e41cce44a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69d5a8a352bec9e48fa14d28f2bb496a, https://si.imgix.net/1bc03051/uploads/origins/07eec4c0-a541-4415-8192-75e41cce44a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=417b58572a2d48947057e9d560b45a8b 2x, https://si.imgix.net/1bc03051/uploads/origins/07eec4c0-a541-4415-8192-75e41cce44a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d1ef870dab21779c01190ee0c894eac 3x", "genre": "art", "nsfw": false, "body": "セイウンスカイをお願いします\n前回お願いしたプリファイフラワーのシリーズでフラワーのピンチに駆けつける\nお助けキャラのようなイメージで、白いタキシード姿に変身しているイラストをお願いします\n\n雰囲気的には、タキシード仮面または怪盗キッドの様なコスチュームでお願いします\nお時間があればお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/7", "thumbnail_src": "https://si.imgix.net/f9a4c887/uploads/origins/8939f9d3-f20f-4a63-8380-4c7093417297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf514cfacfb747fdd16dfc9eb492fffa", "thumbnail_srcset": "https://si.imgix.net/f9a4c887/uploads/origins/8939f9d3-f20f-4a63-8380-4c7093417297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf514cfacfb747fdd16dfc9eb492fffa, https://si.imgix.net/f9a4c887/uploads/origins/8939f9d3-f20f-4a63-8380-4c7093417297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4749bb02c9dc699f17c37bc44bc07e3c 2x, https://si.imgix.net/f9a4c887/uploads/origins/8939f9d3-f20f-4a63-8380-4c7093417297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d29010a9b712b0491786cfdcd58b14c 3x", "genre": "art", "nsfw": false, "body": "お手数おかけして申し訳ありませんでした。\n以前もリクエストにお応えいただきありがとうございます、とても嬉しかったです！\n\nさて、今回のリクエストなのですが、私の新しいTwitterアカウント（@yamadori197）のアイコンに利用させていただきたく思います。その際はプロフィールにくるみるみ先生の作品であることと、Twitterリンクを併記させていただき、権利を明示いたします。\n\nもし上記の通りでお許しいただけるのであれば、\n・ウマ娘のセイウンスカイが熱いものを食べて悶絶しているイラスト\nをお願いしたく思います。くるみるみ先生のウンスは勇気をくれます！\n\nどうかご検討ください、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/6", "thumbnail_src": "https://si.imgix.net/84d16bb4/uploads/origins/5d66f8e7-b31e-403c-8e4a-2999f3d11993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e16f1d13f60fb96bf38652cbfd15252", "thumbnail_srcset": "https://si.imgix.net/84d16bb4/uploads/origins/5d66f8e7-b31e-403c-8e4a-2999f3d11993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e16f1d13f60fb96bf38652cbfd15252, https://si.imgix.net/84d16bb4/uploads/origins/5d66f8e7-b31e-403c-8e4a-2999f3d11993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c427988d3435f942ac11b56999a2ded 2x, https://si.imgix.net/84d16bb4/uploads/origins/5d66f8e7-b31e-403c-8e4a-2999f3d11993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d2c315d7a445b6d8f83a271219affec 3x", "genre": "art", "nsfw": false, "body": "ニシノフラワーをお願いします\n\nフラワーはプリファイが好きなので\nピリキュアの様な魔法少女に変身した雰囲気のイラストをお願いします\n\nチューリップをモチーフにしたピンク色のドレスを着て、ふわふわなポニーテールみたいな姿の様なイメージでお願いします\n\n細部や髪型がしっくりこない場合は\n勝負服のピンクバージョンでもokです\n\nお時間あればよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/5", "thumbnail_src": "https://si.imgix.net/cb986ac1/uploads/origins/bbfe92ba-79f8-4302-992f-4b1bcb655eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b270baee5c5b35cfd1d9f1b5cb629b9", "thumbnail_srcset": "https://si.imgix.net/cb986ac1/uploads/origins/bbfe92ba-79f8-4302-992f-4b1bcb655eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b270baee5c5b35cfd1d9f1b5cb629b9, https://si.imgix.net/cb986ac1/uploads/origins/bbfe92ba-79f8-4302-992f-4b1bcb655eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f77bea0eb6b104da80a1e5d2cc942677 2x, https://si.imgix.net/cb986ac1/uploads/origins/bbfe92ba-79f8-4302-992f-4b1bcb655eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cecb6984c84312d08ff3df3b5b58a75a 3x", "genre": "art", "nsfw": false, "body": "前回の漫画ありがとうございました\n今回もフラウンスの漫画形式でお願いします\n\n黄金世代が借り物走をしていて\nキング｢薙刀｣　スぺ｢コンドル」　グラス｢マスク」　エル｢猫」\n\nみたいな状況で混迷を極める中セイウンスカイの借りる物は\n｢いつも笑顔でいてほしい人、または好きな人｣(最初、この内容は見えない様に)\nフラワーに｢ちょっと一緒に来て｣と声をかけゴールへ向かう二人\n\nゴール前の借り物チェックでデジタルが現れ\n｢借り物の読み上げて下さ～い」とお願いされ照れながら借り物を読み上げるセイウンスカイ\nとその借り物の答えを聞いて真っ赤になるニシノフラワー\nみたいな漫画をお願いします\n\nコマ数やオチはお任せします\nよろしければお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/4", "thumbnail_src": "https://si.imgix.net/c75157ce/uploads/origins/adf34aaa-0d39-45d6-b2b7-685bec7f730f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99b6b2b9e2f2077bb021841fc235b42", "thumbnail_srcset": "https://si.imgix.net/c75157ce/uploads/origins/adf34aaa-0d39-45d6-b2b7-685bec7f730f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99b6b2b9e2f2077bb021841fc235b42, https://si.imgix.net/c75157ce/uploads/origins/adf34aaa-0d39-45d6-b2b7-685bec7f730f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a83c7f48bc8e8abf64446aa44e6af882 2x, https://si.imgix.net/c75157ce/uploads/origins/adf34aaa-0d39-45d6-b2b7-685bec7f730f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8d916dc897e7a2a519c27136d23c6c8 3x", "genre": "art", "nsfw": false, "body": "前回のフラウンスイラストありがとうございました。\n\n同期のみんなと模擬レースをすることになったセイウンスカイ\nお弁当を持ってきたニシノフラワーが\n｢とっておきのお弁当、作って待ってますから！」\nそう言ったフラワーの耳元で周囲に聞こえないように\n｢愛しているよ｣\nと囁いて返しウマ(コースを走るウォームアップ)に向かうセイウンスカイ\n\nみたいな漫画をお願いします\nコマ数、ページ数や落ちはお任せします\n\n可能でしたらお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/3", "thumbnail_src": "https://si.imgix.net/405580b5/uploads/origins/e82bc022-339c-4231-a275-b0a007ada734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be51a66d51759c92b9353622f4f1e9d", "thumbnail_srcset": "https://si.imgix.net/405580b5/uploads/origins/e82bc022-339c-4231-a275-b0a007ada734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be51a66d51759c92b9353622f4f1e9d, https://si.imgix.net/405580b5/uploads/origins/e82bc022-339c-4231-a275-b0a007ada734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0dbb8aa3a7ad44c7f85a49d48697c578 2x, https://si.imgix.net/405580b5/uploads/origins/e82bc022-339c-4231-a275-b0a007ada734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b60b313700f5663158e092a5c7065211 3x", "genre": "art", "nsfw": false, "body": "くるみるみさん、いつもお世話になっております。😌\n「愛しきベジランド」の野菜ドレスを着た持田亜里沙をお願いできますでしょうか？\nあと、「愛しきベジランド」企画へのご関心誠にありがとうございました。😊🙇‍♂️", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/2", "thumbnail_src": "https://si.imgix.net/d1a2d5d0/uploads/origins/fd562c35-9bbd-4e5c-908d-76d758ac5cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e1866eedcb2885b5530c2d68411e424", "thumbnail_srcset": "https://si.imgix.net/d1a2d5d0/uploads/origins/fd562c35-9bbd-4e5c-908d-76d758ac5cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e1866eedcb2885b5530c2d68411e424, https://si.imgix.net/d1a2d5d0/uploads/origins/fd562c35-9bbd-4e5c-908d-76d758ac5cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4398d6a74c12c4c2b276a039717ca5ba 2x, https://si.imgix.net/d1a2d5d0/uploads/origins/fd562c35-9bbd-4e5c-908d-76d758ac5cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dec803261e985640c3aa587429d6931a 3x", "genre": "art", "nsfw": false, "body": "【キャラ】\n寧海&平海（アズールレーン）\n\n\n【イラスト内容】\n\n「姉妹の休憩時間」というシチュエーションで、\n服装は艤装を纏った状態ではなく、軽装でお願いします。\n\n仲の良さがわかる明るい雰囲気だと嬉しいです。\n\n\n\n【要望補足】\n\n・服装はチャイナ風の、暖かい季節のものであればなんでもOKです。\n(公式に丁度いい私服がないので自由に描写して下さい)\n\n・髪型は通常時(結っている)でお願いします。\n\n・シチュエーションは、姉妹がメインであれば他の描写はすべておまかせします。\nくるみさんがアズレン世界観の中で描いてみたいものがあれば自由に入れて下さい。\n\n・キャンバスサイズは問いませんが、スマホの待受画面に使わせて頂きたいです。\n\n\n\nくるみさんの描かれる光の柔らかな絵柄で描いてほしい題材をあれこれ熟考していたのですが、\n以前描かれていた寧海がとてもよかったのと、キャラ性や日常観に理解が深いと思い是非お願いしたいと思いました！\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@sakusenbest/works/1", "thumbnail_src": "https://si.imgix.net/7124f1fd/uploads/origins/13af7e30-377e-4afd-aa7f-3b7a5e708886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a644fcb7ace7dbaab1a06358b22560", "thumbnail_srcset": "https://si.imgix.net/7124f1fd/uploads/origins/13af7e30-377e-4afd-aa7f-3b7a5e708886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a644fcb7ace7dbaab1a06358b22560, https://si.imgix.net/7124f1fd/uploads/origins/13af7e30-377e-4afd-aa7f-3b7a5e708886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=706d36879d24e17d96f605148f4b5914 2x, https://si.imgix.net/7124f1fd/uploads/origins/13af7e30-377e-4afd-aa7f-3b7a5e708886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ac24f406889ed231aa36d47da9d4b84 3x", "genre": "art", "nsfw": false, "body": "初めまして\n綺麗な絵柄に惹かれお願いしたいと思います\nもうすぐ11月22日、良い夫婦の日です\n花嫁衣装（ドレス）に身を包んだニシノフラワーと\n花婿衣装（タキシード）に身を包んだセイウンスカイが一緒に歩いているようなイラストをお願いします\n\nお時間のある時にでもお願い致します", "created_at": "", "completed_at": ""}]}