fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0588da09f5efa6d5fc34813ef0203717 3x", "genre": "art", "nsfw": false, "body": "うちのこ 構図・ポーズもろもろおまかせで！\n\n↓服等参考↓\nhttps://x.com/iruma3802/status/1820848749473874387", "created_at": "", "completed_at": ""}, {"path": "/@__Iz8/works/9", "thumbnail_src": "https://si.imgix.net/81aa2130/uploads/origins/c52d1f7d-eed9-4a1e-b3db-d27af84a0ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4d3af7a2b3fcb7effb5a3043d92fc6", "thumbnail_srcset": "https://si.imgix.net/81aa2130/uploads/origins/c52d1f7d-eed9-4a1e-b3db-d27af84a0ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4d3af7a2b3fcb7effb5a3043d92fc6, https://si.imgix.net/81aa2130/uploads/origins/c52d1f7d-eed9-4a1e-b3db-d27af84a0ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1337061b5e1d2774bda516e24c589bda 2x, https://si.imgix.net/81aa2130/uploads/origins/c52d1f7d-eed9-4a1e-b3db-d27af84a0ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a40ba86afe189b680609db217e3ddfa 3x", "genre": "art", "nsfw": false, "body": "ねずみ様\n過日は王様あおちゃんのファンアートありがとうございました。\nアレンジ制服がとても可愛かったと好評でしたので、\nこの衣装のままで別イラストをお願いしたいです。\nhttps://skeb.jp/@__Iz8/works/7\n\n金の狼耳と金のふさふさな尻尾をつけて（色合い的に派手になりすぎるようであればマットな質感で合わせてください）をつけて、\n食べちゃうぞポーズ（ねずみ様の作品で言うと上半身は以下のような感じがイメージ近いです）で描いて欲しいです。\nhttps://x.com/__Iz8/status/1733568455570530613/photo/1\n\n太もものリボンなどのアレンジが素晴らしかったので\n今回も全身描いていただけると嬉しいです。\nまた、フォールガイズというゲームで金の狼のコスチュームを入手した記念FAなのですが、\n通常時もサムネ等で使えるよう耳と尻尾の無い差分をいただけると嬉しいです。\nゲームの尻尾は小さめなのですが、狐のしっぽくらいの大きさ希望です。\n\n▼使用用途\n・Twitter等のSNSでの使用\n・YouTube配信のサムネイル等\n▼備考\n背景透過版や左右見切れがないとサムネイル等で使いやすいのでありがたいです。", "created_at": "", "completed_at": ""}, {"path": "/@__Iz8/works/8", "thumbnail_src": "https://si.imgix.net/3ca50c5e/uploads/origins/cb825a4a-51ab-4d62-b5cf-48da3b6d8fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f592533095d0b0cd2aa1b2849a6987b", "thumbnail_srcset": "https://si.imgix.net/3ca50c5e/uploads/origins/cb825a4a-51ab-4d62-b5cf-48da3b6d8fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f592533095d0b0cd2aa1b2849a6987b, https://si.imgix.net/3ca50c5e/uploads/origins/cb825a4a-51ab-4d62-b5cf-48da3b6d8fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6810cc1049f000a25aeb217a75753ec 2x, https://si.imgix.net/3ca50c5e/uploads/origins/cb825a4a-51ab-4d62-b5cf-48da3b6d8fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42b647b93c6e88391d882908d0549263 3x", "genre": "art", "nsfw": false, "body": "ねずみ様、はじめまして。\nPixivにある作品の表情や構図が素敵だったので依頼させていただきました。\n\nVTuberの沙汰ナキアさんのイラストを描いていただけないでしょうか。\n（二次創作公認プログラムに登録されております）\n\n【リクエスト内容】\n・ホグワーツ風のローブ姿で、杖を振って魔法をかけている様子をお願いしたいです。\n・架空の寮ということで、シンボルカラーは紫、紋章の動物はウサギでお願いします。\n・ローブの下の服装はお任せします（三面図と同じ、ホグワーツ風、オリジナル等）。\n・魔法の表現はお任せしたいのですが、「声」や「音」を連想できる感じだと嬉しいです。\n・可能であれば全身が見切れずに描かれている構図でお願いします。\n・レイヤーが分かれているPSDファイルで納品お願いします。\n・沙汰ナキアさん本人が活動の中でSNSやYouTube等でイラストを使用する許可もお願いします。\n\n以上です。\n\n沙汰ナキアさんはハリーポッターシリーズが好きということで、喜んでもらいたい気持ちもあり依頼させていただきました。どうぞよろしくお願いいたします。\n\n※資料URLに公式の三面図が格納されています\n\nhttps://drive.google.com/drive/folders/1ClHsJHvwZ4jomvIkKrE2EGrrkEw4QwW3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@__Iz8/works/7", "thumbnail_src": "https://si.imgix.net/72eb0f8d/uploads/origins/77f323c4-65a1-47fd-86d9-995141716216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6974a711757c7ba6436b4a83c15c9569", "thumbnail_srcset": "https://si.imgix.net/72eb0f8d/uploads/origins/77f323c4-65a1-47fd-86d9-995141716216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6974a711757c7ba6436b4a83c15c9569, https://si.imgix.net/72eb0f8d/uploads/origins/77f323c4-65a1-47fd-86d9-995141716216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d80d0aedc06bdca98a71122ae36c812 2x, https://si.imgix.net/72eb0f8d/uploads/origins/77f323c4-65a1-47