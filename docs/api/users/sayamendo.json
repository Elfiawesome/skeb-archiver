d-edc69a6c12f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be1245eec3c3f7f519d2347987b50ebf 3x", "genre": "art", "nsfw": true, "body": "始めまして。\n\nhttps://www.pixiv.net/artworks/137011030\nの続き。\n翌日に先生が水着ではなくブルマを履いてきた場合にはどうなるのか？\nというか藤宮さんはどうするのか？\n\nお題のようなリクエストの仕方になってしまいましたが、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/7", "thumbnail_src": "https://si.imgix.net/07392689/uploads/origins/27570644-64cb-4523-b5ee-2e8995bc264d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839f861210afc8db369e1e00efd53047", "thumbnail_srcset": "https://si.imgix.net/07392689/uploads/origins/27570644-64cb-4523-b5ee-2e8995bc264d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839f861210afc8db369e1e00efd53047, https://si.imgix.net/07392689/uploads/origins/27570644-64cb-4523-b5ee-2e8995bc264d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dc10465fcdabdb51935c6b81f778b01 2x, https://si.imgix.net/07392689/uploads/origins/27570644-64cb-4523-b5ee-2e8995bc264d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e69d9e19aa395fdd9444ca23aeb558d0 3x", "genre": "art", "nsfw": false, "body": "陸上のセパレートユニフォーム（ゼッケンNG、下はレーシングブルマ）を着ている\n巨乳なJKのイラストをお願いします\n\n背景ありで\nシチュなどはおまかせしますが\nお腹（重要）と胸と服装がはっきり見えるポーズで\n前が（手や髪などで）隠されないようにお願いします\n\n胸のサイズはこちらのイラスト\n（https://www.pixiv.net/artworks/120706796）\nと同じくらいで\nそれ以外はおまかせします\n\npsdで\n宛名などをあり/なしの両方か\nレイヤーでON/OFFできるようにお願いします\n\nご検討いただけますと幸いです", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/6", "thumbnail_src": "https://si.imgix.net/e76f6d8b/uploads/origins/22947590-a017-4072-88d0-7d5e22af0dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fda25a78374b92581df0a95dfa69633e", "thumbnail_srcset": "https://si.imgix.net/e76f6d8b/uploads/origins/22947590-a017-4072-88d0-7d5e22af0dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fda25a78374b92581df0a95dfa69633e, https://si.imgix.net/e76f6d8b/uploads/origins/22947590-a017-4072-88d0-7d5e22af0dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1e8f92df195e6356e87afa56180a2f4 2x, https://si.imgix.net/e76f6d8b/uploads/origins/22947590-a017-4072-88d0-7d5e22af0dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f056b44c6166590e53ea00ddcb6ee1df 3x", "genre": "art", "nsfw": true, "body": "原田さんも叡智だったので続け様に失礼します。\n\n原田さんが森川さんを押し倒して(https://www.pixiv.net/artworks/130195952)\nこんな感じにおっぱい…特に乳首をコリコリ重ねてキスする、横からアングル騎乗位貝合わせの体勢をお願いします。\n\n森川さんは感じすぎてか大粒の涙を流して下さい、宜しければどうか。", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/5", "thumbnail_src": "https://si.imgix.net/4fbce626/uploads/origins/3115eaf9-2eb8-49f0-b495-894f5f34a770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb71aabae35da27fb26e3f0fc3c231ad", "thumbnail_srcset": "https://si.imgix.net/4fbce626/uploads/origins/3115eaf9-2eb8-49f0-b495-894f5f34a770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb71aabae35da27fb26e3f0fc3c231ad, https://si.imgix.net/4fbce626/uploads/origins/3115eaf9-2eb8-49f0-b495-894f5f34a770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7027182e4513d7898623d68aa3093e0c 2x, https://si.imgix.net/4fbce626/uploads/origins/3115eaf9-2eb8-49f0-b495-894f5f34a770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b381ae6945e65692b3cf823349896290 3x", "genre": "art", "nsfw": true, "body": "先ほどはご納品頂き有難う御座いました。\n余りにも叡智すぎたので続きものをリクエストします！\n\n城見さんが森川さんを押し倒して(https://www.pixiv.net/artworks/100109289)のように着衣でグリグリと貝合わせしています。\n※胸ポチが勃起乳首を希望です。\n\nどんな表情になるのかメチャメチャ楽しみです！", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/4", "thumbnail_src": "https://si.imgix.net/8e154f16/uploads/origins/a3d608a3-0045-4104-a881-7227c5db2e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb11ae673ff8e07cc10f19ac49365253", "thumbnail_srcset": "https://si.imgix.net/8e154f16/uploads/origins/a3d608a3-0045-4104-a881-7227c5db2e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb11ae673ff8e07cc10f19ac49365253, https://si.imgix.net/8e154f16/uploads/origins/a3d608a3-0045-4104-a881-7227c5db2e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ec7fd020f9c854292c73c6f2b6d977d 2x, https://si.imgix.net/8e154f16/uploads/origins/a3d608a3-0045-4104-a881-7227c5db2e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e207dd6cc126370a80acd123c68861a0 3x", "genre": "art", "nsfw": true, "body": "先日はご承認ありがとうございました。\n勢い余ってこちらもリクエストします。\n\nブルマ森川さんがスク水城見さんor他のブルマ4天王の内の1人と参考画像(したから10枚目)のように女相撲をとっています。\n\n今回は女相撲なので、森川さんらブルマ四天王はブルマのみ着用しておっぱいは丸出しです。\nスク水城見さんの場合は胸がポロリするくらい脱いでいます。\n\n森川さんらブルマ四天王はブルマのみ引っ張られるのでパンチラで食い込まされています。\n乳首は勃起しており互いに「くりゅっ♡」と責めあって下さい。\n\nスケジュール宜しければどうか。\n\nhttp://game.anmo.info/game/view/10555", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/3", "thumbnail_src": "https://si.imgix.net/a39c14ee/uploads/origins/3f5961be-35b6-4967-aabc-f01075e58b6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98222c8e3fabbd599370f60e514a147b", "thumbnail_srcset": "https://si.imgix.net/a39c14ee/uploads/origins/3f5961be-35b6-4967-aabc-f01075e58b6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98222c8e3fabbd599370f60e514a147b, https://si.imgix.net/a39c14ee/uploads/origins/3f5961be-35b6-4967-aabc-f01075e58b6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb55de849b7321efd6701ba4715a5c72 2x, https://si.imgix.net/a39c14ee/uploads/origins/3f5961be-35b6-4967-aabc-f01075e58b6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94c8eb74f63ac5f09e38f4311ba5f192 3x", "genre": "art", "nsfw": false, "body": "開設記念リクエストです！\n\n・遊戯王のブラック・マジシャン・ガール\n・特に指定等なくお任せしますが、かわいく描いてくれると嬉しいです\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/2", "thumbnail_src": "https://si.imgix.net/4259780f/uploads/origins/85a73071-1745-4a37-8374-6c34e4c6a565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b41994e6f66fd8c2efee7977492b5b", "thumbnail_srcset": "https://si.imgix.net/4259780f/uploads/origins/85a73071-1745-4a37-8374-6c34e4c6a565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b41994e6f66fd8c2efee7977492b5b, https://si.imgix.net/4259780f/uploads/origins/85a73071-1745-4a37-8374-6c34e4c6a565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beed7e0729803948ae32b5269ca79fac 2x, https://si.imgix.net/4259780f/uploads/origins/85a73071-1745-4a37-8374-6c34e4c6a565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c68a039b6e826536758fec71cf12a7f1 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n\nブルコンより、ブルマ体操服姿の森川さんがスク水姿の城見さんから(https://www.pixiv.net/artworks/79834844)のように、ブルマだけ引っ張られてパンチラ股間食い込ませ&胸を揉まれるイタズラをされます。\n\n宜しければどうか。", "created_at": "", "completed_at": ""}, {"path": "/@sayamendo/works/1", "thumbnail_src": "https://si.imgix.net/4a9ffb68/uploads/origins/c3738a00-0276-4b41-b846-666f9dd1a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce6ddc0488150f7906654218aefa6d8f", "thumbnail_srcset": "https://si.imgix.net/4a9ffb68/uploads/origins/c3738a00-0276-4b41-b846-666f9dd1a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce6ddc0488150f7906654218aefa6d8f, https://si.imgix.net/4a9ffb68/uploads/origins/c3738a00-0276-4b41-b846-666f9dd1a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c21b0b56154c516931040bc8eaf704a 2x, https://si.imgix.net/4a9ffb68/uploads/origins/c3738a00-0276-4b41-b846-666f9dd1a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e436aa95b278c5b0c05fcb285dc2fc9b 3x", "genre": "art", "nsfw": false, "body": "チアガール衣装の退魔士少女のイラストをお願いします\n\n・女の子\n黒髪セミロング～ショートボブの凛とした感じの巨乳美少女チア衣装退魔士\n真面目で正義感の強い性格\n素手で怪物を華麗に切り裂く感じのファイトスタイル\n一人称は「私」\n他作者様に描いていただいた作品ですが、下記イラストのイメージです\nhttps://skeb.jp/@AgohigeX/works/55\n\n・衣装\n資料URLのかなり昔のチア衣装\n白ショート手袋&白ショート靴下&白スニーカー着用\n企業ロゴは削除\n\n・シチュ\nお任せします\n\nhttps://www.dropbox.com/scl/fo/ma93e1xzfc799mwz1uh3t/ADVOfFY3SjIoPJomnyFHAO8?rlkey=085h8bkz6e9m25wtf55ra6np2&dl=0", "created_at": "", "completed_at": ""}]}