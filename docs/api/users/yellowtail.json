fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdd966c542d5ce21bd8b0a72666158d4 3x", "genre": "art", "nsfw": false, "body": "おはようございます。\n随分前にアピールをいただいてましたので、ご依頼をさせていただきます。\n私が『ミストトレインガールズ』を元に作っている二次創作の『ミストトレインガールズ　蜉蝣奇譚別幕』及び一次創作『夜毎の末事』（仮称）に登場するオリジナルキャラ『ツキ■■■』のskebを依頼したいです。\n\n特徴につきましては\n・周囲には自動筆記してくれるメモ帳\n・人間体はぺたりとした兎耳を持った少女\n・近くに『シロ』と呼ばれる白い虎（設定上ツキとシロについてはどんな姿にもなれるキャラです）\n\n服装について\n・先生が似合いそうと思った服装及び髪型でお願いします。\n元ネタ\n・山月記\n・つきのみや駅\n\n参考にまで普段の服装等の資料の方を添付させていただきますので、ご確認をいただけたらと思います。\n\n以上の条件以外については、お好きにしてもらっても構いません。\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1rVn1hoYqsRYNoFVUAVdds4SDfUF82HXd", "created_at": "", "completed_at": ""}, {"path": "/@yellowtail/works/437", "thumbnail_src": "https://si.imgix.net/1ecd900f/uploads/origins/ddc77ce4-546e-4ba7-8e44-bfdbe0309b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edfb464d686c5f6de76930b8dd6495a9", "thumbnail_srcset": "https://si.imgix.net/1ecd900f/uploads/origins/ddc77ce4-546e-4ba7-8e44-bfdbe0309b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edfb464d686c5f6de76930b8dd6495a9, https://si.imgix.net/1ecd900f/uploads/origins/ddc77ce4-546e-4ba7-8e44-bfdbe0309b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae060114aa1f018b78ef15798bfee865 2x, https://si.imgix.net/1ecd900f/uploads/origins/ddc77ce4-546e-4ba7-8e44-bfdbe0309b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=492c853bbd61a68b11b378f997316115 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yellowtail/works/436", "thumbnail_src": "https://si.imgix.net/6b5c71fa/uploads/origins/b89408fd-8ef7-4ca0-b686-41e42c2c85d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fcc6363ba3b2dca58ceb96811ad6790", "thumbnail_srcset": "https://si.imgix.net/6b5c71fa/uploads/origins/b89408fd-8ef7-4ca0-b686-41e42c2c85d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fcc6363ba3b2dca58ceb96811ad6790, https://si.imgix.net/6b5c71fa/uploads/origins/b89408fd-8ef7-4ca0-b686-41e42c2c85d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a25723f7ae0401cb4d884695db535c8 2x, https://si.imgix.net/6b5c71fa/uploads/origins/b89408fd-8ef7-4ca0-b686-41e42c2c85d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42da880a4f239b0d9f14707a23d0faa9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールしてくれてありがとう！\n\n画風がカッコイイので、機械いじりをしている私のモスリンのキャラをぜひ描いていただきたいです。デザインが少し変わったので、参考URLをご確認ください。ありがとうございました！\n\nhttps://imgur.com/a/0mySdN3", "created_at": "", "completed_at": ""}, {"path": "/@yellowtail/works/435", "thumbnail_src": "https://si.imgix.net/93544ffb/uploads/origins/f0fb4315-c6db-4e27-b07c-6e392bc99d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e463b71e9fd187832cffa1fa0df0a16", "thumbnail_srcset": "https://si.imgix.net/93544ffb/uploads/origins/f0fb4315-c6db-4e27-b07c-6e392bc99d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e463b71e9fd187832cffa1fa0df0a16, https://si.imgix.net/93544ffb/uploads/origins/f0fb4315-c6db-4e27-b07c-6e392bc99d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4793810fe3248e7a74d9603d63c96d15 2x, https://si.imgix.net/93544ffb/uploads/origins/f0fb4315-c6db-4e27-b07c-6e392bc99d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed3bf13d85a63beb4b73a3d22fb31abb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして！アピールを送ってくださり、本当にありがとうございます！\n\nリクエスト\nあなたのアートスタイルがとても好きです！\n表情、ポージング、構図、全てあなた次第です！\n\nキャラクターについて\n未来から来たアンドロイドの女の子。\n特徴\n目は紫のグラデーション 前歯がうさぎのように出ている 髪はツインテールで長い 濃い青に紫のグラデーション URLに参考資料を載せておきます！\n\n使用方法\nソーシャルへの投稿（X、bluesky）｜アイコンとして使用\nYouTubeサムネイル/背景/コミュニティ投稿｜キャプションにクレジットを入れる｜説明文\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/12P5HyfkpztCbnYrQ3YwQzatydpFqIeCo?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yellowtail/works/434", "thumbnail_src": "https://si.imgix.net/41f5e380/uploads/origins/3fe39309-e1d2-475e-adcb-5a58fb1d867d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c68dd0d4408b696b49d35408214a85", "thumbnail_srcset": "https://si.imgix.net/41f5e380/uploads/origins/3fe39309-e1d2-475e-adcb-5a58fb1d867d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c68dd0d4408b696b49d35408214a85, https://si.imgix.net/41f5e380/uploads/origins/3fe39309-e1d2-475e-adcb-5a58fb1d867d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67574b730a17e6a9f27eeeb2d7477691 2x, https://si.imgix.net/41f5e380/uploads/origins/3fe39309-e1d2-475e-adcb-5a58fb1d867d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=facf60bf99f9cc46e2e6e32ea994195e 3x", "genre": "art", "nsfw": false, "body": "重音テトのためにヤンデレでヴァンパイアをテーマにした曲を書いた。ボーカロイドの曲には必ずキャラクターがいるので、新しいキャラクターデザインを考えました。\nこのデザインのイラストバリエーションをお願いしたいです。この曲のリリックビデオ用のイメージバリエーションが欲しいです。カナリアの王様やエンヴィーベイビーに似ています。\nアスペクト比は16:9です。\nイラストの背景は赤。\n重音テトは色白のヴァンパイア。\n彼女の服装は\n赤いプリーツのミニスカート、\n赤い太もものハイヒール、\n赤いレザージャケット\n赤いバンドゥ、\n両手に黒いフィンガーレス・グローブ、\n鎖のついたスパイクカラー、\n黒いマントが赤い背景と彼女を際立たせている。\n赤いマニキュアの爪。\n髪のリボンは黒。\n腰から黒と赤のコウモリの羽が伸びている。尻尾は黒。赤い背景と区別するために黒いマントを羽織っている。\n赤い口紅をつけ、少し大人っぽい。24～25歳くらいに見える。\n吸血鬼の牙と大きな犬歯があり、舌は黒い。\n2つのバリエーションがある：\n1、普通の笑顔。彼女はあまり威嚇的に見えてはいけない。口を開けて笑っているはずだ。口の外から黒い舌が見えるようにする。\n2.黒い舌を出しながら微笑み、赤く光る目をしている。彼女はあなたの血に飢えているように見えるはずだ。皮膚には血がついている。NSFWポリシーに反する場合は、血を描く必要はありません。\nまた、それぞれの画像は赤い背景なしでお願いします。可能であれば、PSDファイルの別レイヤーに背景を入れてください。\n参考のためにAI画像をいくつか用意しました。これらの画像では彼女の舌は黒くありませんが、イラストでは彼女の舌は黒くする必要があります：\nhttps://drive.google.com/drive/folders/1Rr8xku7QNC9QVCRfSxR7R5ZM-ybh5jgW?usp=sharing\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yellowtail/works/433", "thumbnail_src": "https://si.imgix.net/f1f7555a/uploads/origins/a16433c5-82af-4ae8-bc5b-09c9dcd0a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabdfd293ca494cd20739f4167e734b7", "thumbnail_srcset": "https://si.imgix.net/f1f7555a/uploads/origins/a16433c5-82af-4ae8-bc5b-09c9dcd0a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabdfd293ca494cd20739f4167e734b7, https://si.imgix.net/f1f7555a/uploads/origins/a16433c5-82af-4ae8-bc5b-09c9dcd0a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40e82895aa50fa18e44ac721ca1453f3 2x, https://si.imgix.net/f1f7555a/uploads/origins/a16433c5-82af-4ae8-bc5b-09c9dcd0a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fd678ac0b48ecbbeda4824160da185f 3x", "genre": "art", "nsfw": false, "body": "やあ、僕のVtubeモデルを描いてほしいというリクエストありがとう！Yoojaがメッセージをくれたんだけど（サプライズでもう一人描いてくれたんだ^^）、君が僕のモデルを描きたいって！あなたのアートスタイルが大好きです！\n\n私のモデルはタフで、仕事（彼女は暗殺者/忍者です）を通して、彼女は血を気にしないし、少し残忍ですが、仕事以外では、彼女は時々少し不器用で迷子になるので、彼女の一族のメンバーは彼女を気にする必要があります。\n\nもちろんクレジットを入れて、SNSやメンバーシップに使いたい。\n\nhttps://drive.google.com/drive/folders/1HxSUXM0pjStDOWT4tM4LeBvHxV5jOED9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yellowtail/works/432", "thumbnail_src": "https://si.imgix.net/cddddbd2/uploads/origins/66079a80-7414-484b-8119-fca4de2b04a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f598f7b7a568242a26548141d7cfee08", "thumbnail_srcset": "https://si.imgix.net/cddddbd2/uploads/origins/66079a80-7414-484b-8119-fca4de2b04a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f598f7b7a568242a26548141d7cfee08, https://si.imgix.net/cddddbd2/uploads/origins/66079a80-7414-484b-8119-fca4de2b04a3?bg=%23f