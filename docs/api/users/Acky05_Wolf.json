ae990683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f025a8fe851dfd36fc677ae554c5084, https://si.imgix.net/c648e741/uploads/origins/95440955-c962-410a-bef9-ee9fae990683?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbeb59f77a8c859127edb3fae0afac41 2x, https://si.imgix.net/c648e741/uploads/origins/95440955-c962-410a-bef9-ee9fae990683?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d42e6f71bf1a9c325ca177902f71c07 3x", "genre": "art", "nsfw": false, "body": "こんにちは！友人の絵を依頼したいです。緑茶オオカミの友人が鋭い歯を見せている様子を描いてください。全ての歯に、参考画像のように可能な限り正確に矯正装置を描いてください。\n各歯には色付きゴムバンドが装着され、金属ワイヤーが全ての歯をつないでいます。色を交互にしたり、全て緑色にしても構いません。可能であれば、絵の主眼を歯列矯正装置の見せ方に置きたいです！https://drive.google.com/drive/folders/1LMqddsbQh5hREjCurGYF0yG2dIXHC2ox?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/works/243", "thumbnail_src": "https://si.imgix.net/3c3dc84f/uploads/origins/7a1d1c09-2c9d-4e3e-b4ba-da57aa0cc40f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211d969ad04f20f5e010571faa01d4f6", "thumbnail_srcset": "https://si.imgix.net/3c3dc84f/uploads/origins/7a1d1c09-2c9d-4e3e-b4ba-da57aa0cc40f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211d969ad04f20f5e010571faa01d4f6, https://si.imgix.net/3c3dc84f/uploads/origins/7a1d1c09-2c9d-4e3e-b4ba-da57aa0cc40f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cd404c12727d2df656fd153bf012734 2x, https://si.imgix.net/3c3dc84f/uploads/origins/7a1d1c09-2c9d-4e3e-b4ba-da57aa0cc40f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3024a189ad379c1d4def127701546733 3x", "genre": "art", "nsfw": false, "body": "私のリンドウキャラがベッドで寝ていて、大きないびきをかいている。参照 - https://drive.google.com/file/d/17jYexEkXguBoeNooFjrCE_SixntYmmk9/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/works/242", "thumbnail_src": "https://si.imgix.net/099577a8/uploads/origins/b22cdbba-21bd-49d3-972d-fe529ba20fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1c176e08c5c958ec88ef45991428ccb", "thumbnail_srcset": "https://si.imgix.net/099577a8/uploads/origins/b22cdbba-21bd-49d3-972d-fe529ba20fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1c176e08c5c958ec88ef45991428ccb, https://si.imgix.net/099577a8/uploads/origins/b22cdbba-21bd-49d3-972d-fe529ba20fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c47aa9ffad21d5ff1cff6f91253444b 2x, https://si.imgix.net/099577a8/uploads/origins/b22cdbba-21bd-49d3-972d-fe529ba20fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19057f05080a2ff1afa5d71ac83ebb04 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私は私のOCを描画するように要求するのが大好きで、あなたの芸術のスタイルで見るのが大好きalaoはここから始めましょう私は1つの通常を持っているのが大好きで、あなたの心でオリジナルの何かを作るために完全な創造性を与える。\n\nhttps://drive.google.com/file/d/1_NbQbbsvVK7SetNjEdJsQJQpN9EJXBqJ/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/works/241", "thumbnail_src": "https://si.imgix.net/b196c0c3/uploads/origins/919605df-fc47-4fd8-b9be-11ff3ec6ab3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615037a35ad029ed338f3c217ea3bc5c", "thumbnail_srcset": "https://si.imgix.net/b196c0c3/uploads/origins/919605df-fc47-4fd8-b9be-11ff3ec6ab3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615037a35ad029ed338f3c217ea3bc5c, https://si.imgix.net/b196c0c3/uploads/origins/919605df-fc47-4fd8-b9be-11ff3ec6ab3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dac83efcef0166a4f2c71841bdd9f41e 2x, https://si.imgix.net/b196c0c3/uploads/origins/919605df-fc47-4fd8-b9be-11ff3ec6ab3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=059308e8b898d1d622e1391fd6555e89 3x", "genre": "art", "nsfw": true, "body": "アッキー！私の女の子がベッドに横たわり、両手で胸にハートを作っている絵を描いてくれる？彼女には、ウインクしながら舌を出すような、誘惑的でからかうような表情をつけてね。ありがとう！\n\nhttps://drive.google.com/file/d/1NzY78FqmqTjzoqr-g0GyAoa21sBPiZzE/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/works/240", "thumbnail_src": "https://si.imgix.net/3d085c63/uploads/origins/f50d1735-c94b-427b-b12f-05f2456f936e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93552697eb07c184d1b625ad82092930", "thumbnail_srcset": "https://si.imgix.net/3d085c63/uploads/origins/f50d1735-c94b-427b-b12f-05f2456f936e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93552697eb07c184d1b625ad82092930, https://si.imgix.net/3d085c63/uploads/origins/f50d1735-c94b-427b-b12f-05f2456f936e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a23e1f968c80c28c57e09a45747066d6 2x, https://si.imgix.net/3d085c63/uploads/origins/f50d1735-c94b-427b-b12f-05f2456f936e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d8e8d6db8d72fd167d2ed99b02e3eb4 3x", "genre": "art", "nsfw": false, "body": "ハロウィンのお知らせが書かれた紙をこちらに見せながら、じりじりと迫ってくる着ぐるみ君のイラストをお願いします。\n\nシチュエーションとしては、\nわざとらしく「こんなイベントやるんだって」と紙をぴらぴらさせつつ、\n「ボクといっしょにイベントを楽しもうよ（ボクを着てよ）」と、着ぐるみ君が「お願い」しながら近づいてくる感じです。\n\n可能であれば、表情差分（「笑顔」と「笑顔以外」）の2種類があると嬉しいです。\n\n雰囲気など、その他の細部はおまかせでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/works/239", "thumbnail_src": "https://si.imgix.net/de0a6566/uploads/origins/0c94c4e3-d176-4770-b1e8-b5b3af9c4d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e230b4d524c34ba7db29a715ac52d2", "thumbnail_srcset": "https://si.imgix.net/de0a6566/uploads/origins/0c94c4e3-d176-4770-b1e8-b5b3af9c4d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e230b4d524c34ba7db29a715ac52d2, https://si.imgix.net/de0a6566/uploads/origins/0c94c4e3-d176-4770-b1e8-b5b3af9c4d56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1dc6ded6be471cd34fefefb05b432744 2x, https://si.imgix.net/de0a6566/uploads/origins/0c94c4e3-d176-4770-b1e8-b5b3af9c4d56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=928c51fc4469894ef8e0f6a93b97b2b3 3x", "genre": "art", "nsfw": false, "body": "ゲス顔の着ぐるみ君がニンゲンに自分を着せているイラストをお願いします。\n\n依頼したい内容としては、大体以下のような感じでお願いしたいです。\n・ニンゲンは片腕を必死に伸ばして脱出しようと足掻いている\n・着ぐるみ君はゲス顔で足掻くニンゲンを見下ろしている\n・着ぐるみ君のポーズとしては以下のどちらかに近いものでお願いしたいです\n　-出ているニンゲンの腕をつかんで押し込もうとしている（アグレッシブ系）\n　-自分の腰に手を当ててニンゲンが足掻く様を眺めている（パッシブ系）\n\nイメージ的には、以前にお描きになられたこのイラストのような感じでお願いしたいです。\nhttps://x.com/Acky05_Wolf/status/1268496901462097920\n\n\n\nまだ残暑厳しい時期だからこそ、着ぐるみ君にモフモフ蒸し蒸しされたくなりまして。", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/works/238", "thumbnail_src": "https://si.imgix.net/f0253bc5/uploads/origins/d1ffa310-0a67-4ec0-95bb-288444101632?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc996d30d5e899ad95b478eb63f5bc6a", "thumbnail_srcset": "https://si.imgix.net/f0253bc5/uploads/origins/d1ffa310-0a67-4ec0-95bb-288444101632?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc996d30d5e899ad95b478eb63f5bc6a, https://si.imgix.net/f0253bc5/uploads/origins/d1ffa310-0a67-4ec0-95bb-288444101632?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=228280bee6da658ceb5650ea87735432 2x, https://si.imgix.net/f0253bc5/uploads/origins/d1ffa310-0a67-4ec0-95bb-288444101632?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=978000f2faacaf1aed2f9e910568f8a5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Acky05_Wolf/wor