4cc-4555ccd6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f23bf7f8f7df136ea8a108cc0c779a9, https://si.imgix.net/4b8cf7fc/uploads/origins/a4bf25eb-2d6e-4448-84cc-4555ccd6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af62bb4a0a5964b82e8cc6f65fa1b7cf 2x, https://si.imgix.net/4b8cf7fc/uploads/origins/a4bf25eb-2d6e-4448-84cc-4555ccd6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98cf9e8a2c057efd451d6696c03052e9 3x", "genre": "art", "nsfw": false, "body": "初めまして\nVtuberのあしさんりと申します\n\n複数をイラストをみて素敵だなと思いリクエストしました！\n私のキャラのイラストを描いていただきたいです。\n\nキャラのイメージは少しガタイがいい感じです！\nまた４畳半の狭い部屋に住んでいる設定があります。\n\n正面を向いている構図で、\nよろしければ何かごはんを食べているか料理をしているような描写があると嬉しいです！\n\nもし、難しければ服装や構図に関しては、ナヒーダ無事保護(課金)様の思うように描いていただいて構いません！\n\n使用用途はYOUTUBEのサムネイルに使わせていただければと存じます。\n頂く際はキャラのみの透過のPNGもいただけるとありがたいです。\n\nご検討よろしくお願いいたします\n\nhttps://drive.google.com/drive/u/0/folders/1Vp7L8KqITU-nQ1y5bU5SqHGspGytYE7k", "created_at": "", "completed_at": ""}, {"path": "/@kototon88/works/11", "thumbnail_src": "https://si.imgix.net/99aa4ca7/uploads/origins/1ba11695-f844-4642-acd7-5b47b005f92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09cffa18a35563fcfbbb19dd1eacdab6", "thumbnail_srcset": "https://si.imgix.net/99aa4ca7/uploads/origins/1ba11695-f844-4642-acd7-5b47b005f92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09cffa18a35563fcfbbb19dd1eacdab6, https://si.imgix.net/99aa4ca7/uploads/origins/1ba11695-f844-4642-acd7-5b47b005f92f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10efc4dcc87f648e5feb661007963f02 2x, https://si.imgix.net/99aa4ca7/uploads/origins/1