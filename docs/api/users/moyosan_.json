d-47d5-be2f-0993eb00a3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96f229bd4614eb631557a7399b5731a4", "thumbnail_srcset": "https://si.imgix.net/b36ffb89/uploads/origins/6ffcf5d1-585d-47d5-be2f-0993eb00a3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96f229bd4614eb631557a7399b5731a4, https://si.imgix.net/b36ffb89/uploads/origins/6ffcf5d1-585d-47d5-be2f-0993eb00a3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80d80f290edc150334ecd520e092c410 2x, https://si.imgix.net/b36ffb89/uploads/origins/6ffcf5d1-585d-47d5-be2f-0993eb00a3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07374427752de73c78b9e4aac619fee1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、シオン・エルトナムのイラストに興味があります。ただし、ゲーム『Rabbit & Steel』に登場する「グレナディエ」というキャラクター風に描いてください。ゲームではキャラクターごとに異なるカラーパレットが用意されており、彼女に最も似合うと思われる色と、お好みのポーズを選んでいただいて構いません。ただし、ウサギの耳、サッチェル、銃、そして彼女を取り巻く魔法陣は必ず残してください。 キャラクターのスプライトシートを添付しました。お時間をいただき誠にありがとうございます。https://imgur.com/a/5tdfQX4", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/7", "thumbnail_src": "https://si.imgix.net/02c94e6c/uploads/origins/d07a3a9f-e69d-4424-ba11-5ac2bd5a7156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d24121f45e10c45c8ad8e8447d1c88c", "thumbnail_srcset": "https://si.imgix.net/02c94e6c/uploads/origins/d07a3a9f-e69d-4424-ba11-5ac2bd5a7156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d24121f45e10c45c8ad8e8447d1c88c, https://si.imgix.net/02c94e6c/uploads/origins/d07a3a9f-e69d-4424-ba11-5ac2bd5a7156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12cb0a22e9489d05534be2d2797ad46d 2x, https://si.imgix.net/02c94e6c/uploads/origins/d07a3a9f-e69d-4424-ba11-5ac2bd5a7156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33e81a50b44f2af3e80a8357b2eac5a3 3x", "genre": "art", "nsfw": false, "body": "こんにちはもよ！\n\nバゼットとリーズバイフェをこの寝姿で描いてください\nhttps://imgur.com/a/nKDzdnz\n\nリーズは上のオレンジ色の方です。髪は下ろした状態で、よだれを垂らしながら微笑んでいるようにしてください\n（参考画像はこちらです https://imgur.com/Q7wCC7t）\n\nリーズは白い団長シャツを着用させてください\nhttps://imgur.com/BwuQxdE\n\nバゼットは下で白いトップスを着用\nhttps://imgur.com/ugX5mXm\n\nバゼットの夢の中では、通常の猫の頭ではなく、巨大なネコアルクの頭が彼女の上に載っているようにしてください。\nhttps://imgur.com/a/nKDzdnz\n\nその他については、お好きなように自由に描いて楽しんでください。", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/6", "thumbnail_src": "https://si.imgix.net/064274fb/uploads/origins/618892a7-4043-4328-8111-8440db5c6829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09844e99f99b3cf69e6ee6acf57791e4", "thumbnail_srcset": "https://si.imgix.net/064274fb/uploads/origins/618892a7-4043-4328-8111-8440db5c6829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09844e99f99b3cf69e6ee6acf57791e4, https://si.imgix.net/064274fb/uploads/origins/618892a7-4043-4328-8111-8440db5c6829?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d0b56d0d732162c844d8e89720a0cb9 2x, https://si.imgix.net/064274fb/uploads/origins/618892a7-4043-4328-8111-8440db5c6829?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ab13e777ff0addb35463f6116c00bf5 3x", "genre": "art", "nsfw": false, "body": "あなたの画風、大好きです！特にType-Moonのアート作品が気に入っています。私のキャラクターのイラストを描いてほしいです。彼女は内気だけど好奇心旺盛な女の子で、世界を探検してもっと知りたいと思っているんです！ポーズや表情はあなたに任せます。まだ参考画像はあまり持っていません。こちらが画像です：https://imgur.com/a/MYbu8se", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/5", "thumbnail_src": "https://si.imgix.net/e54f4029/uploads/origins/53ed5963-7561-4b5b-b468-961b6506ebd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e59ba3b871021426983d46aa706d21", "thumbnail_srcset": "https://si.imgix.net/e54f4029/uploads/origins/53ed5963-7561-4b5b-b468-961b6506ebd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e59ba3b871021426983d46aa706d21, https://si.imgix.net/e54f4029/uploads/origins/53ed5963-7561-4b5b-b468-961b6506ebd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b94568bd214ada4c5cac5900d623af5 2x, https://si.imgix.net/e54f4029/uploads/origins/53ed5963-7561-4b5b-b468-961b6506ebd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=492f026f7e254693b3dd3b48ca5a4b53 3x", "genre": "art", "nsfw": false, "body": "初めまして、初めての依頼です！楽しみにしています！久遠寺アリスとイリヤスフィール・フォン・アインツベルンを一緒に描いていただけませんか？参考画像はこちらです：https://drive.google.com/drive/folders/17xlaqKQJAanDyywpdfmtwgdfVhl5J0gu?usp=drive_link\n\n冬のアウターで似たような見た目ですが、性格は全く異なります。表情やボディランゲージでその違いを表現していただけませんか？また、私が気に入っている冬の背景もいくつか添付しました。これらのキャラクターに合うかもしれません。ただし、これらの選択は全てお任せします——お二人が一緒にいる姿を、どのように描かれるのか楽しみにしています！よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/4", "thumbnail_src": "https://si.imgix.net/514ffec7/uploads/origins/96f7e179-0650-49f8-8ce4-d61da8495758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e51b113d42d9121c036f81ac77494ce9", "thumbnail_srcset": "https://si.imgix.net/514ffec7/uploads/origins/96f7e179-0650-49f8-8ce4-d61da8495758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e51b113d42d9121c036f81ac77494ce9, https://si.imgix.net/514ffec7/uploads/origins/96f7e179-0650-49f8-8ce4-d61da8495758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=367d53458891c77663243356c0f20598 2x, https://si.imgix.net/514ffec7/uploads/origins/96f7e179-0650-49f8-8ce4-d61da8495758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57582972bf1a667a919282f5cb3889d3 3x", "genre": "art", "nsfw": false, "body": "もよしさん、こんにちは！お願いしたいのは、下記参照画像のように描かれた青子青崎（魔法使いの夜）、イリヤ・フォン・アインツベルン（Fate/Stay Night）、遠野アキハ（月姫）のイラストです。\nご検討ありがとうございます！参考：https://www.pixiv.net/en/artworks/115598746", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/3", "thumbnail_src": "https://si.imgix.net/74ad4d51/uploads/origins/930af572-dbb1-40af-ae15-317e85934525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e2f7407d548135359c451ae593ff9d8", "thumbnail_srcset": "https://si.imgix.net/74ad4d51/uploads/origins/930af572-dbb1-40af-ae15-317e85934525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e2f7407d548135359c451ae593ff9d8, https://si.imgix.net/74ad4d51/uploads/origins/930af572-dbb1-40af-ae15-317e85934525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88eae493fcccf592b3c54d3886072626 2x, https://si.imgix.net/74ad4d51/uploads/origins/930af572-dbb1-40af-ae15-317e85934525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9839da60ad928a96cd41296c0ea481b8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、オリジナルキャラクターのコミッション依頼をさせていただきたいです。彼女は水をモチーフにした人魚の騎士です。元騎士で現在はジャーナリストの護衛として放浪する剣士です。正義感に溢れ、愛する者のために戦います。いつか引退して歌手になりたいと願っています。性格は神経質で静か、内向的ですが、とても優しく甘えん坊でもあります。\n\nポーズと表情はご自由にお決めください。参考資料やフォルダ内のものから選択しても、彼女の性格に合うと思われる独自のものをご考案いただいても結構です。ご依頼をご検討いただきありがとうございます。https://imgur.com/a/lorelei-wendler-reference-images-nb71kvD", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/2", "thumbnail_src": "https://si.imgix.net/a3923bd2/uploads/origins/1578e244-f8b8-4a38-ad36-b826165a1f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad0be4ee7880360db20340395fe24ed", "thumbnail_srcset": "https://si.imgix.net/a3923bd2/uploads/origins/1578e244-f8b8-4a38-ad36-b826165a1f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad0be4ee7880360db20340395fe24ed, https://si.imgix.net/a3923bd2/uploads/origins/1578e244-f8b8-4a38-ad36-b826165a1f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=356dc6ccc75ba951afc158a9095b918b 2x, https://si.imgix.net/a3923bd2/uploads/origins/1578e244-f8b8-4a38-ad36-b826165a1f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07268628c3fdb88f7ca3e5040199fbea 3x", "genre": "art", "nsfw": false, "body": "はじめまして。普段ヘルメットを被ったキャラクターを描かれないのは承知していますが、今回の作品を最近の作風で見てみたいです！モデルは参考画像「2」の女性パイロットですが、配色は「1」に近いものにしてください。参考画像「3」は全く同じスーツではありませんが、参考になれば幸いです。 \n\n参考画像の色や細部の正確さは必須ではありません。ポーズや構図もご自由に決めてください！ご検討いただきありがとうございます。https://drive.google.com/drive/folders/1_ofWSB5G6Uu5N15PayWR0Dd7q7W4vxt9", "created_at": "", "completed_at": ""}, {"path": "/@moyosan_/works/1", "thumbnail_src": "https://si.imgix.net/02d2cd66/uploads/origins/f0c18faa-0712-46a1-9719-736b3b868dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c5b1ecad59217399508cc94f528788", "thumbnail_srcset": "https://si.imgix.net/02d2cd66/uploads/origins/f0c18faa-0712-46a1-9719-736b3b868dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c5b1ecad59217399508cc94f528788, https://si.imgix.net/02d2cd66/uploads/origins/f0c18faa-0712-46a1-9719-736b3b868dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e76afc51717bfb2ec13ad62551f99e2 2x, https://si.imgix.net/02d2cd66/uploads/origins/f0c18faa-0712-46a1-9719-736b3b868dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af07f25ad539c67f2aa5bbccbcb295b7 3x", "genre": "art", "nsfw": false, "body": "バーやレストランでリーズバイフェとバゼットが一緒に飲んでいる絵を描いていただけますか？\n\nできればリーズはメルブラXのスーツを着ていると嬉しいです。こちらを参照：\nhttps://imgur.com/a/LSTmUHR\n\nリーズがバゼットにロックのドリンクを注いでいると尚良し。酔ったリーズの性格からすると、おそらくバゼットに言い寄っていて、バゼットはタダ酒を受け入れているでしょう。\n\n少々奇妙な組み合わせですが、自由に描いてください。ポーズ、表情、背景はご自由に選択ください。\n\n仕事帰りの一杯（一方は仕事後、もう一方は無職です）。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}]}