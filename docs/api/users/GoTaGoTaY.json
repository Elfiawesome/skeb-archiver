f-9b67-82b098cd2e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a979252646bf31cd1fa4078c353694fc", "thumbnail_srcset": "https://si.imgix.net/b22e88d6/uploads/origins/dbc3d2a8-b470-454f-9b67-82b098cd2e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a979252646bf31cd1fa4078c353694fc, https://si.imgix.net/b22e88d6/uploads/origins/dbc3d2a8-b470-454f-9b67-82b098cd2e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=774a0a67cc35c59888f1987da996b23f 2x, https://si.imgix.net/b22e88d6/uploads/origins/dbc3d2a8-b470-454f-9b67-82b098cd2e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20e744479bb6094c0ab7de4eb57e8f2f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n私はあなたのアートスタイルがとても好きです。私は東方Projectの鷺沼綺心の絵を依頼したいのですが、この最初の写真( https://imgur.com/a/I07PIdL )のような服を着て、普段の服と同じ色で、この写真( https://imgur.com/a/5GW17nV )のようなポーズと髪型をしてほしいのです。\nまた、彼女の顔には、遊び心のある微笑みがあるといいですね。\nご検討ありがとうございました。私はこの作品をSNSのアバターとして使いたいのですが、問題ないでしょうか？\n回答をお待ちしております。", "created_at": "", "completed_at": ""}, {"path": "/@GoTaGoTaY/works/23", "thumbnail_src": "https://si.imgix.net/bc6b5565/uploads/origins/9560bbd9-1d6c-4474-8953-6b2a06479a95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f43faa1753a085e45ce456898a169a5e", "thumbnail_srcset": "https://si.imgix.net/bc6b5565/uploads/origins/9560bbd9-1d6c-4474-8953-6b2a06479a95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f43faa1753a085e45ce456898a169a5e, https://si.imgix.net/bc6b5565/uploads/origins/9560bbd9-1d6c-4474-8953-6b2a06479a95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=405de653eb8a831aebff4e8a3fa4ab67 2x, https://si.imgix.net/bc6b5565/uploads/origins/9560bbd9-1d6c-4474-8953-6b2a06479a95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee23922a24daa3665e4bb7061cefba6f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n私のオリジナルキャ