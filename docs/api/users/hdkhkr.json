/photo/1\n指揮官が射精すると、大鳳は絶頂の表情を見せ、舌を突き出し、涙を流し、その瞳には愛が宿っていた。\n最後に、大鳳は眼鏡をかけているかいないかの違いがあったほうがいいです。", "created_at": "", "completed_at": ""}, {"path": "/@hdkhkr/works/48", "thumbnail_src": "https://si.imgix.net/3fb822ba/uploads/origins/2a184b80-f877-4c6c-b0bf-7ed8aca7d35a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=172d63539108c48621dcc4d1034c2298", "thumbnail_srcset": "https://si.imgix.net/3fb822ba/uploads/origins/2a184b80-f877-4c6c-b0bf-7ed8aca7d35a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=172d63539108c48621dcc4d1034c2298, https://si.imgix.net/3fb822ba/uploads/origins/2a184b80-f877-4c6c-b0bf-7ed8aca7d35a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76e18e23c214883555bc91cbcdb921cd 2x, https://si.imgix.net/3fb822ba/uploads/origins/2a184b80-f877-4c6c-b0bf-7ed8aca7d35a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f98025a21596548d44477800998dc93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hdkhkr/works/47", "thumbnail_src": "https://si.imgix.net/8d91b1c5/uploads/origins/9a868d35-70d3-40ec-bc2d-f0a176668f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a86c71b793cedb73f0f12c9937ced18", "thumbnail_srcset": "https://si.imgix.net/8d91b1c5/uploads/origins/9a868d35-70d3-40ec-bc2d-f0a176668f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=