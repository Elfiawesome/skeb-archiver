e7a/requests/227603_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c2ed7db1ec50284b267224b72201788 2x, https://si.imgix.net/d7105e7a/requests/227603_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bfdbc44f45fc5a9ccb9b6a7b264abc8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hekonda_kan/works/41", "thumbnail_src": "https://si.imgix.net/b5f3eeba/requests/225225_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5dc0e4a8927ceee9e8904f336621c0", "thumbnail_srcset": "https://si.imgix.net/b5f3eeba/requests/225225_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5dc0e4a8927ceee9e8904f336621c0, https://si.imgix.net/b5f3eeba/requests/225225_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c29c438ec83bce343a34fc0069dbb581 2x, https://si.imgix.net/b5f3eeba/requests/225225_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9112325e9ea61835e7a664d6eea7c8dd 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n\n今回は私のFF14でのキャラクターのイラストを描いて貰いたく依頼させていただきました。\nポーズ、背景はおまかせします。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/k93Oyan", "created_at": "", "completed_at": ""}, {"path": "/@hekonda_kan/works/40", "thumbnail_src": "https://si.imgix.net/9dad9afc/requests/222249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cd6fd4b648f0bd4e97856798f927752", "thumbnail_srcset": "https://si.imgix.net/9dad9afc/requests/222249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cd6fd4b648f0bd4e97856798f927752, https://si.imgix.net/9dad9afc/requests/222249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f81b