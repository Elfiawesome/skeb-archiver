f4cf3ea373b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ebb8078096da0316212c47b4213b8909", "thumbnail_srcset": "https://si.imgix.net/82939ae0/uploads/origins/6100a3c5-f851-4f51-ad7c-1f4cf3ea373b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ebb8078096da0316212c47b4213b8909, https://si.imgix.net/82939ae0/uploads/origins/6100a3c5-f851-4f51-ad7c-1f4cf3ea373b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7df613f9564aee1ea838c7974715600 2x, https://si.imgix.net/82939ae0/uploads/origins/6100a3c5-f851-4f51-ad7c-1f4cf3ea373b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=09299b7145dc17ec0a62c4922c178861 3x", "genre": "art", "nsfw": true, "body": "どうも、匿名で失礼します。\n\n今回リクエストしたいのは、ヒャクさんのオリジナルキャラクターのボルトさんが、フル勃起している仁王立ちのGIFアニメーションです。\n\nトレーニングウェアとして着ているパンツ(ボクサーパンツ(？))を着用した着衣勃起でお願いします。\n\nシチュエーションは、とてもワイルドな表情でパンツの中で獰猛している男根をピクッピクッと脈打たせているアニメーションでお願いします。\n筋肉量と勃起力で、漢としてのたくましさと威厳さを誇示している感じです。\n\nその他背景等はそちらにお任せします。\n\n内容に問題なければ、しばらくの間よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1652", "thumbnail_src": "https://si.imgix.net/c2f3d163/uploads/origins/72492a5f-f164-4bdd-b59c-f4a48b88c290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebe215cbbb25e2275b6c8b84414fa96b", "thumbnail_srcset": "https://si.imgix.net/c2f3d163/uploads/origins/72492a5f-f164-4bdd-b59c-f4a48b88c290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebe215cbbb25e2275b6c8b84414fa96b, https://si.imgix.net/c2f3d163/uploads/origins/72492a5f-f164-4bdd-b59c-f4a48b88c290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84885b030f35e0f4ccdcefac73b610b0 2x, https://si.imgix.net/c2f3d163/uploads/origins/72492a5f-f164-4bdd-b59c-f4a48b88c290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0e6b478df5491b6aceae0d883a9d321 3x", "genre": "art", "nsfw": false, "body": "百さん、こんにちは、\n虎と猪と犬（サモエド）のシーンのリクエストです。\n\n羽織袴を着た3人が神社でデートしているシーンを描いてください(布.png)\n\nサモエドの両脇でトラとイノシシがじゃれあい、サモエドが楽しそうに笑っています。あけましておめでとうございます！\n\nhttps://drive.google.com/drive/folders/1SsBJVKMKyNPaclY6NTn_mcErOc6GFfMN?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1651", "thumbnail_src": "https://si.imgix.net/9c0ce5af/uploads/origins/fde82fd0-5c06-4fbd-8dd4-d6d93ddd542f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=384c283bcc26eaceb4cf4f638b437c40", "thumbnail_srcset": "https://si.imgix.net/9c0ce5af/uploads/origins/fde82fd0-5c06-4fbd-8dd4-d6d93ddd542f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=384c283bcc26eaceb4cf4f638b437c40, https://si.imgix.net/9c0ce5af/uploads/origins/fde82fd0-5c06-4fbd-8dd4-d6d93ddd542f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=203ce23d2325b3aa31636497a21f9cfa 2x, https://si.imgix.net/9c0ce5af/uploads/origins/fde82fd0-5c06-4fbd-8dd4-d6d93ddd542f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0e43dfb938100fb8e6078033cc3886c 3x", "genre": "art", "nsfw": true, "body": "また会ったね、百！\n\n私のシロクマのキャラクターが、きつすぎるズボンをはこうとしている後ろ姿を描いてほしい。彼のお尻は大きくて、太くて、ふっくらしているはずなので、彼はそうするのに苦労している。\n\n参考までに、私のキャラクターは、あなたのサモエドのキャラクターのように太っていて柔らかいはずです！\n\nhttps://drive.google.com/drive/folders/1dYyho9wIIzZKQ6W5Cdu-b_B8JmW3iOrJ\n\nhttps://drive.google.com/drive/folders/14qNXSdyE6rgYRdO98RG35XO-54kXwvSE", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1650", "thumbnail_src": "https://si.imgix.net/9d020bc1/uploads/origins/6527884a-1781-4047-a31c-a06986863808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33214a6d00baeb0168741f4ab16fbb9", "thumbnail_srcset": "https://si.imgix.net/9d020bc1/uploads/origins/6527884a-1781-4047-a31c-a06986863808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33214a6d00baeb0168741f4ab16fbb9, https://si.imgix.net/9d020bc1/uploads/origins/6527884a-1781-4047-a31c-a06986863808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d76c0b72435c485af52a3e429318b635 2x, https://si.imgix.net/9d020bc1/uploads/origins/6527884a-1781-4047-a31c-a06986863808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e06122c394d4a817b743b79fcd51c1e 3x", "genre": "art", "nsfw": true, "body": "ヒャクさんあけましておめでとうございます。今年も宜しくお願いします。\n\n新年と言うことでレッパパさんとママさんの姫始めおせっせのシチュをお願いします。\n可能であればパパさん攻めとママさん攻めの２つのシチュをお願いしたいです。\nパパさん攻めは積極的で優しい攻め。ママさん攻めは乳首攻め＋言葉攻め。\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1649", "thumbnail_src": "https://si.imgix.net/2555a0fa/uploads/origins/5b652a0c-21e9-4153-a856-b73e2f3881cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54d41dde0466f07069be2678ae94a067", "thumbnail_srcset": "https://si.imgix.net/2555a0fa/uploads/origins/5b652a0c-21e9-4153-a856-b73e2f3881cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54d41dde0466f07069be2678ae94a067, https://si.imgix.net/2555a0fa/uploads/origins/5b652a0c-21e9-4153-a856-b73e2f3881cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e934b2a72efdfa29a45d7bdcd295ebd9 2x, https://si.imgix.net/2555a0fa/uploads/origins/5b652a0c-21e9-4153-a856-b73e2f3881cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fffb6f652fd129dae32f09c0a90a7ae 3x", "genre": "art", "nsfw": false, "body": "ヒャクさん、初めまして！\nYouTubeでVTuberとして配信活動してます、十六夜レゴシと言います！\n\nヒャクさんの描く僕を見てみたく依頼をさせて頂きました！\n\n雑談配信のサムネで使えるようなイラストをお願い出来ないでしょうか🙏\n\n頬に片手を付いてニッと笑ってる表情で描いてくれると嬉しいです！\n\nhttps://x.com/izayoi_legoshi?s=21&t=Gy-d23T-fYSedjQ25I4fpA", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1648", "thumbnail_src": "https://si.imgix.net/4bffdc71/uploads/origins/2675b584-1246-4980-95b7-b967be75b44f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b3f702e6b21d690f825b0e7eea0718de", "thumbnail_srcset": "https://si.imgix.net/4bffdc71/uploads/origins/2675b584-1246-4980-95b7-b967be75b44f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b3f702e6b21d690f825b0e7eea0718de, https://si.imgix.net/4bffdc71/uploads/origins/2675b584-1246-4980-95b7-b967be75b44f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=9df156e30201b398bcfb1c9c26bb2282 2x, https://si.imgix.net/4bffdc71/uploads/origins/2675b584-1246-4980-95b7-b967be75b44f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe8cd80ab11d3f50e743549cd2e8759f 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私のキャラクター「ムーンライズ」を使って、ツイッターに投稿された例のようなGIFアニメーションを作っていただけないでしょうか？\n\nムーンライズ\n\nhttps://x.com/Magical_Pudding/status/1925420883260104769?s=20\nhttps://x.com/Magical_Pudding/status/1890532522741682593?s=20\n\n例\nhttps://x.com/hyaku1063/status/1992446806161326174?s=20\n\nhttps://x.com/hyaku1063/status/1996054405163221459?s=20", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1647", "thumbnail_src": "https://si.imgix.net/32ab8d5b/uploads/origins/11aec2bd-45d0-4de9-9e2b-58cb027ee3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=305595f7ae6f3e959ee640bb87a1b8c8", "thumbnail_srcset": "https://si.imgix.net/32ab8d5b/uploads/origins/11aec2bd-45d0-4de9-9e2b-58cb027ee3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=305595f7ae6f3e959ee640bb87a1b8c8, https://si.imgix.net/32ab8d5b/uploads/origins/11aec2bd-45d0-4de9-9e2b-58cb027ee3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41a0494395492d6923f2f1d7ce95c1c4 2x, https://si.imgix.net/32ab8d5b/uploads/origins/11aec2bd-45d0-4de9-9e2b-58cb027ee3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b45d61b056e0a455074217a54213a11 3x", "genre": "art", "nsfw": true, "body": "こんにちは、百さん！赤虎と白熊の依頼をお願いします。\n\n二人はベッドの上に座っている。赤虎は白熊の肩に腕をかけ、カメラをまっすぐ見るようにからかっています。(ポーズ.png)\nシロクマは俯き、慌て、恥ずかしがり、顔を赤らめる。\n遊び心のある表情で、トラは彼をからかって楽しんでいるように微笑んでいる。\n\nトラは黒いレザージャケットを着ている。\nシロクマはセーターを着ている。(cloth01.jpg または cloth02.jpg)\n\n背景は、エロビデオの撮影に適したもの、あるいはプライベートな医療室やプレイルームのようなものを選んでください。\n(エロギャグ漫画のワンシーンのように、ペペジェルやコンドーム、ディルドなど、小さなセックストイ・アイコンが背景に浮かんでいるのも雰囲気に合うかもしれません。必ずしもこのアイデアを使う必要はない)\n\n彼らの体格の差は非常に大きい！(シロクマは背が低くてずんぐりむっくり！）。\n\nhttps://drive.google.com/drive/folders/10Te4D3lAzwADlNyWasTfa6i2lV6Ci-li?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1646", "thumbnail_src": "https://si.imgix.net/d15e517b/uploads/origins/0e786487-63da-460b-b9cb-505b9dcaf9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f13f7e35bce4784b90a84366d3d6db6b", "thumbnail_srcset": "https://si.imgix.net/d15e517b/uploads/origins/0e786487-63da-460b-b9cb-505b9dcaf9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f13f7e35bce4784b90a84366d3d6db6b, https://si.imgix.net/d15e517b/uploads/origins/0e786487-63da-460b-b9cb-505b9dcaf9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e2c6504ae0afc23a5691eaf620db913 2x, https://si.imgix.net/d15e517b/uploads/origins/0e786487-63da-460b-b9cb-505b9dcaf9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77028bfe318725fd789881abe35c9dab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hyaku1063/works/1645", "thumbnail_src": "https://si.imgix.net/0a503e08/uploads/origins/48843909-4e6a-4f1a-974a-b4d853b355b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=