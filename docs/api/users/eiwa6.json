net/85df4e7d/uploads/origins/8a5319ff-6017-4d67-809d-2cca7dfc9cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bda08f30ac519da74913d460f57f88e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eiwa6/works/97", "thumbnail_src": "https://si.imgix.net/d2ea85b8/uploads/origins/7a379a9d-30ed-4103-9cad-295785cd280b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac9bc119077af3de27cfe5773acb86d", "thumbnail_srcset": "https://si.imgix.net/d2ea85b8/uploads/origins/7a379a9d-30ed-4103-9cad-295785cd280b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac9bc119077af3de27cfe5773acb86d, https://si.imgix.net/d2ea85b8/uploads/origins/7a379a9d-30ed-4103-9cad-295785cd280b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=406316c1cfd0dcb23bde43f3739bd97c 2x, https://si.imgix.net/d2ea85b8/uploads/origins/7a379a9d-30ed-4103-9cad-295785cd280b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=757016812aea2e40726106a004317ca8 3x", "genre": "art", "nsfw": false, "body": "初めまして、リクエストをさせて頂きます。\n\n■主な内容\n赤毛のストレートヘア。\n上半身は露出がほとんどないガチガチの鎧、足首やふくらはぎも鎧ががっちりしているのに、下半身はハイレグ&Tバック（あるいはレオタード&Tバック）なアンバランスが感じ。\n可愛いよりのお姉さん系。\n細かいデザインは全部お任せします。\n\n■武器（可能な範囲）\n武器はモーニングスター。鉄球にトゲトゲがないまん丸なタイプ。玉の色は金色か黒。\n\n武器を振り回しながら可愛いセクシーかっこいい感じに。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@eiwa6/works/96", "thumbnail_src": "https://si.imgix.net/22cf3d6a/uploads/origins/35767496-c61b-4f15-9701-7cd0a9f8caec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6343f174cad1cd47f3feeec0740ccbb0", "thumbnail_srcset": "https://si.imgix.net/22cf3d6a/uploads/origins/35767496-c61b-4f15-9701-7cd0a9f8caec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6343f174cad1cd47f3feeec0740ccbb0, http