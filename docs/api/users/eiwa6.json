ad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea4442cc388d54b7ff35a6fbcc312f50 2x, https://si.imgix.net/dcde3f67/uploads/origins/8d50fa9b-e141-42a0-bc52-71a3ba9afd19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=952ead655940ae30b2a1264bda4b3a84 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eiwa6/works/83", "thumbnail_src": "https://si.imgix.net/37a18430/uploads/origins/7b3f938b-167f-4b2e-ad0c-11ec8e23dc4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f7cc6ca8c7399c0784beffbf4241e3", "thumbnail_srcset": "https://si.imgix.net/37a18430/uploads/origins/7b3f938b-167f-4b2e-ad0c-11ec8e23dc4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f7cc6ca8c7399c0784beffbf4241e3, https://si.imgix.net/37a18430/uploads/origins/7b3f938b-167f-4b2e-ad0c-11ec8e23dc4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e307495203176d56d6062cdcce66448c 2x, https://si.imgix.net/37a18430/uploads/origins/7b3f938b-167f-4b2e-ad0c-11ec8e23dc4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0865a9b1460396efb4f936da1822a28 3x", "genre": "art", "nsfw": false, "body": "いつもありがとうございます。\nまた同じキャラで恐縮ですが、リクエストさせていただいてもよろしいでしょうか。\n\n【キャラ】黒髪・ポニーテール\nhttps://skeb.jp/@eiwa6/works/20\n\nこれまで同様、ムチムチした感じで、胸や太ももを大きく描いていただけると嬉しいです。\n\n＜服装＞チューブトップビキニ（青） ※光沢のあるもの\n先日描かれていたこちらのイラストの水着でお願いします。\nhttps://skeb.jp/@eiwa6/works/81\n\nデザインもまったく同じにしていただけますでしょうか？\nただ、色は「青」でお願いします。\n\n青色サンプル\nhttps://drive.google.com/file/d/1St9CJTTYxCIscq0bOtrdlxqeZxzaBYis/view?usp=drive_link\n\nもし可能であれば、光沢のある感じにしていただけると嬉しいです。\nhttps://drive.google.com/file/d/1_Uv1Z91QA9o7hFCw7cCcTduSxl1H6n2U/view?usp=drive_link\n\n【内容】プールサイドで座って、こちらに微笑んでいる。\n\n他の方のイラストで恐縮ですが、構図のイメージとしては、こんな感じです。（少し上から見ている感じ）\nhttps://drive.google.com/file/d/1SL0ghHlLqMagzVm_BCGr--rXehhx0ogA/view?usp=drive_link\n\n手の位置等の細かい点については、先生にお任せします。\n\nこちらのイラストのように、膝下あたりから上を描いていただけると嬉しいです。\n\n表情については、\n①笑顔でこちらに微笑んでいる（口は開けた状態）\n②ニコっと目を閉じて微笑んでいる（口は閉じた状態）\nの２種類をお願いできますか？\n\n今回は背景をプールサイドでお願いしようと考えておりますが、上のイラストのように\n簡易的なもので構いません。\n\n塗り方については、これまでの依頼させていただいたイラストと同じような感じで、「厚めの塗り方」でお願いできると嬉しいです。\n例：https://skeb.jp/@eiwa6/works/52\n\n毎度細かくリクエストしてすみません。\nご検討のほど、何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@eiwa6/works/82", "thumbnail_src": "https://si.imgix.net/d73938c3/uploads/origins/57804a26-63d6-4fa6-b938-e5847bf74512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a779cbce75d900d949a7befa432d034", "thumbnail_srcset": "https://si.imgix.net/d73938c3/uploads/origins/57804a26-63d6-4fa6-b938-e5847bf74512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a779cbce75d900d949a7befa432d034, https://si.imgix.net/d73938c3/uploads/origins/57804a26-63d6-4fa6-b938-e5847bf74512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0794ef1985400044efeec1adfde5c4ff 2x, https://si.imgix.net/d73938c3/uploads/origins/57804a26-63d6-4fa6-b938-e5847bf74512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f2388ca9f0705e623b351809c38d44e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eiwa6/works/81", "thumbnail_src": "https://si.imgix.net/8934238e/uploads/origins/2598302d-564f-4335-a745-be4d0e03868e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f268743f0523ca5441074db52543a95", "thumbnail_srcset"