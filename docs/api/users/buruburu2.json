in": 4000, "max": 4000}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@buruburu2", "name": "buruburu2"}, {"label": "Twitter", "url": "https://x.com/buruburu2", "name": "buruburu2"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/6839", "name": "6839"}], "flags": {}, "works": [{"path": "/@buruburu2/works/451", "thumbnail_src": "https://si.imgix.net/9f3de717/uploads/origins/2e93c38a-9926-4b1b-b795-2790f6971566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f70dfcff5fc9f84dbffc56345224bb88", "thumbnail_srcset": "https://si.imgix.net/9f3de717/uploads/origins/2e93c38a-9926-4b1b-b795-2790f6971566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f70dfcff5fc9f84dbffc56345224bb88, https://si.imgix.net/9f3de717/uploads/origins/2e93c38a-9926-4b1b-b795-2790f6971566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b888d84bae0e1974124dbcc68d7cab5 2x, https://si.imgix.net/9f3de717/uploads/origins/2e93c38a-9926-4b1b-b795-2790f6971566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fdd7534ed6a21b667a33ec89951dd43 3x", "genre": "art", "nsfw": true, "body": "音声作成ソフトの紲星あかり（きずなあかり）ちゃんのエッチなイラストをリクエストします。\nあかりちゃんが、おちんちんの形のグッズを使って全裸でオナニーしている姿を見たいです。\nおっぱいを大きく描いていただけると嬉しいです。\nご検討よろしくお願いします。\n\nキャラクターの資料URLをのせておきます。\nまた、以下の依頼と同じキャラクターです。\nhttps://skeb.jp/@buruburu2/works/402\n\nhttps://vocalomakets.com/gallery-akari", "created_at": "", "completed_at": ""}, {"path": "/@buruburu2/works/450", "thumbnail_src": "https://si.imgix.net/6c794dc7/uploads/origins/b30479f7-0958-4d36-aa7d-c25d3ef3aae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fa136224820a82f2aa50a50982d70fa", "thumbnail_srcset": "https://si.imgix.net/6c794dc7/uploads/origins/b30479f7-0958-4d36-aa7d-c25d3ef3aae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fa136224820a82f2aa50a50982d70fa, https://si.imgix.net/6c794dc7/uploads/origins/b30479f7-0958-4d36-aa7d-c25d3ef3aae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df97c9bccff3cfed75b2dd462f732689 2x, https://si.imgix.net/6c794dc7/uploads/origins/b30479f7-0958-4d36-aa7d-c25d3ef3aae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81b942213119dd43ff98445a87916fbd 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです、あるえさん！長い時間が経ちましたが、ごちうさの理世と千夜がお互いに乳合わせしている姿を描いていただいて誠にありがとうございました。今回もリクエストを受け取ることを聞いたのでさっそく申し込もうと思いました！\n\n今回はAチャンネルに登場する百木るんちゃんの水着のスタイルでお願いしたいです。キャラクターは正面を眺めながらビーチボールを投げる準備をする姿で、水着姿は公式で公開された水着にして、夏っぽいな雰囲気でお願いします！\n\n今回もとても忙しいと思いますが、何卒ご検討お願い申し上げます！\n\nhttps://drive.google.com/drive/folders/1gs_DZCUF1_ohnX3i579ks7g1Oy5MNwfc?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@buruburu2/works/449", "thumbnail_src": "https://si.imgix.net/3e8930ad/uploads/origins/be06ed64-f366-406c-ae43-2797fc541a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd1c95b9ee5c9fbc35d0b9264048679", "thumbnail_srcset": "https://si.imgix.net/3e8930ad/uploads/origins/be06ed64-f366-406c-ae43-2797fc541a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd1c95b9ee5c9fbc35d0b9264048679, https://si.imgix.net/3e8930ad/uploads/origins/be06ed64-f366-406c-ae43-2797fc541a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d022cec6cfe5f2aa2e279c94cfe9648 2x, https://si.imgix.net/3e8930ad/uploads/origins/be06ed64-f366-406c-ae43-2797fc541a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bd581f2b91d4dedacdc5bc4a606f89e 3x", "genre": "art", "nsfw": true, "body": "僕がbeatmaniaIIDXという音楽ゲームで使っているアバターキャラ4人(さなえ、アカネ、ラピス、エメラダ)をお願いします。\n衣装は、さなえ→バニー衣装+白タイツ、アカネ→バニー衣装(生足)、ラピス→バニー衣装+ニーハイ、エメラダ→バニー衣装+網タイツでお願いします。\nタイツ・ニーハイ・網タイツ無し差分、旧スク水バニー(ゼッケン付き・ひらがな記名)差分、競泳型スク水バニー(いずれも、さなえ→黒スク水、アカネ→白スク水、ラピス→紺スク水、エメラダ→赤スク水でお願いします)差分、マイクロビキニバニー差分表情差分、逆バニー差分、全裸差分もお願いします。\n表情、ポーズ等その他諸々はおまかせでお願いします。\n\n資料(さなえ)\nhttps://www.dropbox.com/scl/fi/2f6fb6ljw454g7ncykthh/.png?rlkey=00znbdcvjzct13wot6m83kqu2&dl=0\n\n資料(アカネ)\nhttps://www.dropbox.com/scl/fi/4yrc8flg4mfn6wywd0n6b/.png?rlkey=oe3zbs5n7fam640lb8g16z2v8&dl=0\n\n資料(ラピス)\nhttps://www.dropbox.com/scl/fi/6wxgl0iurozu2g5h97w1m/.png?rlkey=tcvwmh1u78q8cln8k41pzf48f&st=bi809miv&dl=0\n\n資料(エメラダ)\nhttps://www.dropbox.com/scl/fi/7nme7p6fqu11erq9s8d66/ver.A.png?rlkey=ihryunqvadxp2zej5xg1vw5ay&st=r29c7hip&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@buruburu2/works/448", "thumbnail_src": "https://si.imgix.net/c796ccf3/uploads/origins/60fbabb3-7c68-4ed7-af0c-76a3cb72707d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=694064f3786b62ce753dcbac7f84b6db", "thumbnail_srcset": "https://si.imgix.net/c796ccf3/uploads/origins/60fbabb3-7c68-4ed7-af0c-76a3cb72707d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=694064f3786b62ce753dcbac7f84b6db, https://si.imgix.net/c796ccf3/uploads/origins/60fbabb3-7c68-4ed7-af0c-76a3cb72707d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cdea624ab856bc5ad5c64b1d99b18a8 2x, https://si.imgix.net/c796ccf3/uploads/origins/60fbabb3-7c68-4ed7-af0c-76a3cb72707d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd5e02d740f9b76b962cded490821e6b 3x", "genre": "art", "nsfw": true, "body": "今回もアーボック時津風をお願いします。\n\n寒くて運動不足を感じた時津風が、アーボックにポケモンバトルみたいに勝負してほしいとお願いし勝負を始めたが、アーボックのほうが素早さが高く、まきつく攻撃を受けたという設定でお願いします。\n\nシーンや表情ですが\n①「巻き付かれちゃった・・・でもこっちも攻撃を・・・」と時津風は苦しみながらも反撃しようとする。\n②しかし攻撃ができず「あれ？攻撃できない・・・？」と時津風は混乱している。\n③「もしかして・・・初代のまきつく攻撃・・・！？」と時津風は気が付き、逃げようと抵抗するがアーボックの攻撃は続いている。\n④アーボックの攻撃が終わり、締め付けがなくなり（身体は拘束されている）「やっと終わった・・・今度はこっちが・・・！」と時津風は苦しみながら攻撃しようとする。\n⑤再度アーボックのまきつく攻撃が始まり、時津風は勝てない事を察し「ごめん！私も負けでいいから許して！」と攻撃をやめるようにお願いする。\n⑥しかしアーボックの攻撃をやめず、何回もまきつく攻撃を繰り返し、時津風は体力がつきる寸前で弱い呼吸ながらも必死に息をしている。\n\n今回⑥のみ目を閉じ、それ以外は開いて下さい。\n\n構図はバトルという事で巻き付き具合や構図は先生が好きなようにお願いします。悩んだ場合は今までのように3～4巻でお願いします。\n又、今回差分が大丈夫でしたら先生が好きな構図でしたら巻きつかれている箇所の追加を、今までと同じ構図でし