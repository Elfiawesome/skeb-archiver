FFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=264e4da94dc365f82320850fbb0bf501 2x, https://si.imgix.net/97d83f52/uploads/origins/e85a332f-11a5-4661-8d01-629324d72977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1deb68959d1726e66b3192da1ca27952 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/38", "thumbnail_src": "https://si.imgix.net/7d937864/uploads/origins/228586cf-410f-498b-a8a2-c52b60589f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c79ce3687ff45a535774de6596e54dd", "thumbnail_srcset": "https://si.imgix.net/7d937864/uploads/origins/228586cf-410f-498b-a8a2-c52b60589f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c79ce3687ff45a535774de6596e54dd, https://si.imgix.net/7d937864/uploads/origins/228586cf-410f-498b-a8a2-c52b60589f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8d4670e156ac55ec17a16d6ed9264de 2x, https://si.imgix.net/7d937864/uploads/origins/228586cf-410f-498b-a8a2-c52b60589f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9c81d0310d3aa1e3b94cef0c2a3e34a 3x", "genre": "art", "nsfw": false, "body": "初めまして！仕込むさんの作品が特に資料のイラストが好きで今回依頼させていただきました！\nシスター姿で右手を頬に添えて親指は口の中に入れられている女の子をお願いしたいです。瞳は資料と同じ様にお願いしたいです。\n他の細かい所はお任せいたします。\n使用用途はdiscordのアイコンに使用したいなと思っております\n改めてよろしくお願いします！\n\nhttps://x.com/com_shicom/status/1941448212637941789?s=46&t=e4QtvSDtD792bPWcKH5iwg", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/37", "thumbnail_src": "https://si.imgix.net/c3c2a02c/uploads/origins/1a7518d6-685d-41a6-bbd8-bb4e1161b147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=517083f33dfb53a75d05127e88a6ff8c", "thumbnail_srcset": "https://si.imgix.net/c3c2a02c/uploads/origins/1a7518d6-685d-41a6-bbd8-bb4e1161b147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=517083f33dfb53a75d05127e88a6ff8c, https://si.imgix.net/c3c2a02c/uploads/origins/1a7518d6-685d-41a6-bbd8-bb4e1161b147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99718ac6dd44d3d7c0539c03d5d5a2cd 2x, https://si.imgix.net/c3c2a02c/uploads/origins/1a7518d6-685d-41a6-bbd8-bb4e1161b147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23aefcedce9d680ed743d704487fd20d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵にはたくさんの感情が込められている。\n\nvtuberの「ねみめやね」を描いていただけませんか？\nねみみは、大きな耳と長いしっぽが特徴のねずみの女の子です。\nネミミは不器用で、時々あざを作ってしまいます。包帯を巻いたり、アザを作ったりして緊張しているねみみを描いてほしいです。楽しく描いてください。\n\n参考資料のリンクも貼っておきます：\nhttps://x.com/NemimiYane/status/1896298563468132492\nショートヘアにメガネの新しいスタイルもあります：\nhttps://x.com/NemimiYane/status/1949325755013292406\nこのメガネをかけた彼女を描いてほしい。", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/36", "thumbnail_src": "https://si.imgix.net/0e213095/uploads/origins/d7dcb823-2581-4eeb-a976-27870e925e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c88f66cb49a582bc835530a8def754a9", "thumbnail_srcset": "https://si.imgix.net/0e213095/uploads/origins/d7dcb823-2581-4eeb-a976-27870e925e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c88f66cb49a582bc835530a8def754a9, https://si.imgix.net/0e213095/uploads/origins/d7dcb823-2581-4eeb-a976-27870e925e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1380b3cf48b77513cdbb942ed78ba17d 2x, https://si.imgix.net/0e213095/uploads/origins/d7dcb823-2581-4eeb-a976-27870e925e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86ef124ca25b920ed183e7e8adbc71a3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/35", "thumbnail_src": "https://si.imgix.net/7eb2af88/uploads/origins/e0f3c961-abe1-4752-a1aa-133ece7c07fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5163c894cc635e57b4a44ce4056e08", "thumbnail_srcset": "https://si.imgix.net/7eb2af88/uploads/origins/e0f3c961-abe1-4752-a1aa-133ece7c07fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5163c894cc635e57b4a44ce4056e08, https://si.imgix.net/7eb2af88/uploads/origins/e0f3c961-abe1-4752-a1aa-133ece7c07fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a480a9fba6f37ca4be22dfa1b65ea436 2x, https://si.imgix.net/7eb2af88/uploads/origins/e0f3c961-abe1-4752-a1aa-133ece7c07fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7644f976584b15455005f92535a61852 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！あなたが作ってくれたアバターが大好きで、もっとアバターのアートを依頼したいと思っています。銛を持ち、魚を釣る準備をしているアーティックを描いてください！帽子とシャツのボタンは外してください。代わりにストライプのタンクトップを着せてください。この依頼を検討していただきありがとうございます。今まであなたの作品をとても楽しんでいます。\n\nキャラクターとシャツの参考資料です。https://drive.google.com/drive/folders/1gCnchOocn_7flgEWVKlyZJFM_dv7A8WV?usp=sharing\n\nhttps://drive.google.com/drive/folders/1gCnchOocn_7flgEWVKlyZJFM_dv7A8WV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/34", "thumbnail_src": "https://si.imgix.net/73a89104/uploads/origins/8cf77ac8-f561-4efa-bd42-37a041ecadab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734f452a78a1f6140d93adaeb13b24b5", "thumbnail_srcset": "https://si.imgix.net/73a89104/uploads/origins/8cf77ac8-f561-4efa-bd42-37a041ecadab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734f452a78a1f6140d93adaeb13b24b5, https://si.imgix.net/73a89104/uploads/origins/8cf77ac8-f561-4efa-bd42-37a041ecadab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbd9e2e0ef63b7d16410fa59ca56b625 2x, https://si.imgix.net/73a89104/uploads/origins/8cf77ac8-f561-4efa-bd42-37a041ecadab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e1f40f16e5327bee12743915a2c288c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！とても美しい作品をもらって嬉しいです。よろしければ、今回も私のocを依頼したいです。この前依頼した少女とペアになるキャラクターで、191cmくらいの丈夫な長身で 黒髪で肩くらいの長さのハーフアップヘア、子犬のようになだらかな垂れ目の男性です。対外的には誰に対しても穏やかで優しく、柔らかいイメージの男性ですが、実際の性格はその正反対で、誰よりも陰険で歪んだ内面の持ち主という設定です。そんな穏やかな表面とその水面下の歪みを先生の表現で描き出していただければ嬉しいです。また、職業がカメラマンなので、デジタルカメラを身につけている様子を描写していただけるとありがたいです。先生が描いてくださる真っ黒な瞳の男が本当に好きなので反映してくださると嬉しいです。衣装はリンクの中の「衣装」というタイトルがついた画像を参考にしていただければいいです。\n外観の資料はリンクをご参照ください！\n\n[資料]\nhttps://drive.google.com/drive/folders/1m9XAo7g8S2im1B4geWrvqVIVxix0SHlG", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/33", "thumbnail_src": "https://si.imgix.net/aab39a52/uploads/origins/0ce28f12-07d6-4744-837a-d346779bce3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c219ae58fdef79dd0dbc12ca5173a4", "thumbnail_srcset": "https://si.imgix.net/aab39a52/uploads/origins/0ce28f12-07d6-4744-837a-d346779bce3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c219ae58fdef79dd0dbc12ca5173a4, https://si.imgix.net/aab39a52/uploads/origins/0ce28f12-07d6-4744-837a-d346779bce3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87b75e234b255dd75535697c8544bc43 2x, https://si.imgix.net/aab39a52/uploads/origins/0ce28f12-07d6-4744-837a-d346779bce3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e4fed7caa4174504cd02398fe0a08fe 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！いつも作品を拝見しております。先生の繊細かつ荒々しい画風と、苦悶や困惑、切なさを感じさせるキャラクターの表情描写が本当に美しいです。もしよろしければ、私のOCを依頼させていただきたいです。キャラクターの特徴は、精神的に脆く、壊れやすくて儚い少女というイメージです。苦しそう、困惑しているよう、あるいは虚無的な表情で、鼻から血を流し、タバコを吸っている姿だと嬉しいです。ボディタイプは低体重で、胸がほとんどない体型です。衣装はレースの装飾が付いたノースリーブのワンピースを着せて頂けるとありがたいです。外見の参考資料はリンクをご覧ください。\n\n[資料] https://drive.google.com/drive/folders/1gIoj53iTgzYWUj21XFm1ojADWX3zoNrt", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/32", "thumbnail_src": "https://si.imgix.net/5d8126e6/uploads/origins/1566d757-4898-4009-b6c7-17b7e767df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dede860da9c1dadcf42d4cf4f5cf4b0f", "thumbnail_srcset": "https://si.imgix.net/5d8126e6/uploads/origins/1566d757-4898-4009-b6c7-17b7e767df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dede860da9c1dadcf42d4cf4f5cf4b0f, https://si.imgix.net/5d8126e6/uploads/origins/1566d757-4898-4009-b6c7-17b7e767df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c89c92c8cf6863f9ca9cf9a016733056 2x, https://si.imgix.net/5d8126e6/uploads/origins/1566d757-4898-4009-b6c7-17b7e767df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01a56e1a3bb9fe5adad7c1f5ba4b537b 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！あなたが作ってくれたアーティックのアバターが素晴らしくて、使い始めることができました。同じキャラクターを描いてください。頭の上に落ちてきた大きな魚に殴られているところを描いてください。あなたの絵がとても好きです。リクエストに応えてくれてありがとう。\n\nこれらのリファレンスは、あなたがすでに描いているものにすぎませんので、ご自由に無視してください。https://drive.google.com/drive/folders/1gCnchOocn_7flgEWVKlyZJFM_dv7A8WV?usp=sharing\n\nhttps://drive.google.com/drive/folders/1gCnchOocn_7flgEWVKlyZJFM_dv7A8WV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/31", "thumbnail_src": "https://si.imgix.net/ef3f165a/uploads/origins/8f8c02f6-eb50-46c8-a037-b30a60c7cee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f0a2e084b9d324331803fd5a9c558df", "thumbnail_srcset": "https://si.imgix.net/ef3f165a/uploads/origins/8f8c02f6-eb50-46c8-a037-b30a60c7cee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f0a2e084b9d324331803fd5a9c558df, https://si.imgix.net/ef3f165a/uploads/origins/8f8c02f6-eb50-46c8-a037-b30a60c7cee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=183774b0a8d8551723387662d6fd92f9 2x, https://si.imgix.net/ef3f165a/uploads/origins/8f8c02f6-eb50-46c8-a037-b30a60c7cee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=451e9edbf3ba445c847831997066271f 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！Gloomiのイラストは素晴らしく、とても感謝しています。この度、自分用にイラストをお願いしたいと思います。キャラクターは肩まである髪の乱れた男の子でお願いします。船長がかぶるようなボタン付きのシャツに帽子をかぶっています。表情は自由です。目の開閉、口の開閉は同じイメージのバリエーションをお願いします。あなたのアートスタイルが大好きなので、この依頼を引き受けてくれることを心から願っています。参考画像はございません。ご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/30", "thumbnail_src": "https://si.imgix.net/1c38c688/uploads/origins/1618b004-e4b2-44a4-aec9-5b438eb99b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee4668c0b6143f4f8e6c9fe58bfc59ac", "thumbnail_srcset": "https://si.imgix.net/1c38c688/uploads/origins/1618b004-e4b2-44a4-aec9-5b438eb99b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee4668c0b6143f4f8e6c9fe58bfc59ac, https://si.imgix.net/1c38c688/uploads/origins/1618b004-e4b2-44a4-aec9-5b438eb99b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46108e5996909b547e68d16cce864c35 2x, https://si.imgix.net/1c38c688/uploads/origins/1618b004-e4b2-44a4-aec9-5b438eb99b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12b4bf11bd270d46de335f080760bfec 3x", "genre": "art", "nsfw": false, "body": "私の好きなVtuberの絵を依頼したい。彼女は長い髪の悲しげな猫の女の子で、黒いドレスを着ています。顔と首に包帯を巻いていて、あざや怪我をしているように描けます。悲しそうな表情でタバコを吸い、鼻血を出している彼女を描いてほしい。鼻血が気になるようなら描かなくてもいい。\n\nありがとうございました。\n\nhttps://drive.google.com/file/d/1xATqV6_s58QvW83wG6CV7BddX95U6fTB/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@com_shicom/works/29", "thumbnail_src": "https://si.imgix.net/ee223cb0/uploads/origins/d3f5115d-4f5c-4ad4