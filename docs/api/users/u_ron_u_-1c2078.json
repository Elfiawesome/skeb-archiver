f69-4b3b-9567-f925add6e18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15bf14d0127cb7a47b3ce93f9360d4be 2x, https://si.imgix.net/2ea18bc4/uploads/origins/e404bbfb-af69-4b3b-9567-f925add6e18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77c9bf5bb2d50db3a62bd3ced608cbde 3x", "genre": "art", "nsfw": false, "body": "TRPGで使用予定の立ち絵をお願い致します🙇‍♀️\n\n詳細\n\n・男\n・175cm\n・STR12\n・APP18\n・黒髪\n・腰より下まで伸びた長髪(髪留め等は特に使っていない)\n・左目 赤(カラーコード#e60012)\n・右目 紫(カラーコード#B276CD)\n・使用武器 ナイフ\n・トレンチコートにワイシャツ(色指定はなし)\n・ループタイ(アクセントに紫)\n・表ではエンターテイナーとしてピエロを演じているため、ピエロ要素があると喜びます🙇‍♀️‪‪💦‬\n・表情としては、少し人を舐めてる感じだとありがたいです\n\n構図\n\nhttps://media.discordapp.net/attachments/1209884997574725672/1240715964606185482/62_20240517022152.png?ex=66483b09&is=6646e989&hm=9d2bd0bb81460f67bae20dd2a657c9bb393b6761327d2a7a817ee03e2a6c6854&\n\n※ピクセル数をなるべく相方に合わせたいため、こちらの構図の画像を元に作っていただけますととても助かります🙇‍♀️\n\n参考用ソファのURLは資料URLの方に記載させていただきます🙏\n\nその他は特に希望はないため、お任せしたいです🙇‍♀️‪‪💦‬\n\n使用シナリオ『Title Lost 』\nHO:天使\n「天使の加護」を得た殺人鬼\n\nこの度はどうぞよろしくお願い致します🙏✨️\n\nhttps://booth.pm/ja/items/4202556", "created_at": "", "completed_at": ""}, {"path": "/@u_ron_u_/works/4", "thumbnail_src": "https://si.imgix.net/dad3132b/uploads/origins/d065412c-b163-429c-a82f-bc6762864c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=125c4b93c79b836b5e1f961f32b5af75", "thumbnail_srcset": "https://si.imgix.net/dad3132b/uploads/origins/d065412c-b163-429c-a82f-bc6762864c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=125c4b93c79b836b5e1f961f32b5af75, https://si.imgix.net/dad3132b/uploads/origins/d065412c-b163-429c-a82f-bc6762864c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26620d407c843fe45f256f0b8ee3e606 2x, https://si.imgix.net/dad3132b/uploads/origins/d065412c-b163-429c-a82f-bc6762864c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fee729cbe604105f2666bfa2d675f25 3x", "genre": "art", "nsfw": false, "body": "立ち絵依頼です‼️\n粘着質そうな男をお願いしたいです🙇‍♂️\n髪は基本的にあんまり整えないのでとても長いです‼️一つくくりくらいはしてます‼️\n片目男です、横髪長めな男です！パーカー着てるといいなァという気持ちで…‼️", "created_at": "", "completed_at": ""}, {"path": "/@u_ron_u_/works/3", "thumbnail_src": "https://si.imgix.net/fe37b5d6/uploads/origins/014b4e48-4401-4f87-8f88-3a04055cdfdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2984ef96ab3d76d5e1d6937dadabc152", "thumbnail_srcset": "https://si.imgix.net/fe37b5d6/uploads/origins/014b4e48-4401-4f87-8f88-3a04055cdfdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2984ef96ab3d76d5e1d6937dadabc152, https://si.imgix.net/fe37b5d6/uploads/origins/014b4e48-4401-4f87-8f88-3a04055cdfdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a19e73540a1be76e81205e83dde801b4 2x, https://si.imgix.net/fe37b5d6/uploads/origins/014b4e48-4401-4f87-8f88-3a04055cdfdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b9d99de5adac2992d66146dfa966bc4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、カジュアルでモダンな衣装で下の2人のキャラクターをお願いしたいのですが。\n\n赤毛はワイルドで、強く、情熱的で、激しく忠実です。フォックス・イヤーズに憑依しており、フォックス・イヤーズを深く愛している。  \n\nフォックス・イヤーズは赤毛の最も信頼できる親友であり、幼なじみである。金持ちで、狡猾で、勝つためには卑怯な手段も厭わず、まるで自分がすべてを支配しているかのように、いつも穏やかな笑みを浮かべている。赤毛によく甘え、甘やかしている。\n\n構図はあなた次第。でもできれば、赤毛がフォックス・イヤーをもっと愛しているという全体的な雰囲気・感情が欲しいです\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1hCFcS8HMwXMzE0JyKrTK0D9Jb6tLXqhG", "created_at": "", "completed_at": ""}, {"path": "/@u_ron_u_/works/2", "thumbnail_src": "https://si.imgix.net/6d6eab67/uploads/origins/26e69f90-0553-4e5d-9baa-e4ed012cc97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40731d2a437734fdadba4ab5ae65c2d7", "thumbnail_srcset": "https://si.imgix.net/6d6eab67/uploads/origins/26e69f90-0553-4e5d-9baa-e4ed012cc97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40731d2a437734fdadba4ab5ae65c2d7, https://si.imgix.net/6d6eab67/uploads/origins/26e69f90-0553-4e