5c9/uploads/origins/589d47fb-dbeb-4090-a6f4-e1d6d531da3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2729aa6b44addbfbe2cab68dca3d6119", "thumbnail_srcset": "https://si.imgix.net/53a425c9/uploads/origins/589d47fb-dbeb-4090-a6f4-e1d6d531da3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2729aa6b44addbfbe2cab68dca3d6119, https://si.imgix.net/53a425c9/uploads/origins/589d47fb-dbeb-4090-a6f4-e1d6d531da3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75c71a10a034c575dc2ebe0027b6d8e9 2x, https://si.imgix.net/53a425c9/uploads/origins/589d47fb-dbeb-4090-a6f4-e1d6d531da3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6701f885e9fea6cc99080cc7ee7d1775 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのスタイル、超かわいいです\n\n私と弟のモチの絵が欲しいです。私たちの参考画像はこちらです。https://we.tl/t-2F9xBFMG4Y\n\n要望：透明（背景なし）でお願いします！ポーズや表情はお任せします。\n用途：バナー/サムネイル/一定数を超えた視聴者へのお礼のカードとして使用する予定です^^。", "created_at": "", "completed_at": ""}, {"path": "/@kotorigi/works/16", "thumbnail_src": "https://si.imgix.net/c31bb8c1/uploads/origins/f79d55fe-01ee-4dee-abd1-79f5e7b11f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85a4bba4c490de8578e466daa9e0613d", "thumbnail_srcset": "https://si.imgix.net/c31bb8c1/uploads/origins/f79d55fe-01ee-4dee-abd1-79f5e7b11f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85a4bba4c490de8578e466daa9e0613d, https://si.imgix.net/c31bb8c1/uploads/origins/f79d55fe-01ee-4dee-abd1-79f5e7b11f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78358f7d19b3843ae2235ebd8dc50cae 2x, https://si.imgix.net/c31bb8c1/uploads/origins/f79d55fe-01ee-4dee-abd1-79f5e7b11f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efca4d6706bd1adb884b297a289e0b83 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵が本当に大好きです。私のVTuberのキャラクターがコンピュータを作っていて、コンピュータのドライバーを口にくわえているところを描いてもらえませんか？彼女はテクノロジーを愛するハッカーです。私のハートのロゴが入ったオーバーサイズの無地の白いシャツを着た、ちょっとクドいというか、感情のない彼女を描いてください。\n1980×1080のサイズに合うように描いてください。私のキャラクターが背景とは別のレイヤーにあることを確認してください。宜しくお願いします。\n\nhttps://imgur.com/a/J36KuGY\n\nhttps://imgur.com/a/J36KuGY", "created_at": "", "completed_at": ""}, {"path": "/@kotorigi/works/15", "thumbnail_src": "https://si.imgix.net/85b300b4/uploads/origins/12929022-93df-486f-bd66-e09492f1aabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d5ad54f9ad0cccbe787ac57b36ff31", "thumbnail_srcset": "https://si.imgix.net/85b300b4/uploads/origins/12929022-93df-486f-bd66-e09492f1aabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d5ad54f9ad0cccbe787ac57b36ff31, https://si.imgix.net/85b300b4/uploads/origins/12929022-93df-486f-bd66-e09492f1aabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f76f9fc288db833a442438ee0e7e255e 2x, https://si.imgix.net/85b300b4/uploads/origins/12929022-93df-486f-bd66-e09492f1aabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75c92534b12c8e4eb24379544fffb257 3x", "genre": "art", "nsfw": false, "body": "初めまして！鈴音舞夢と申します！\nバーチャルYoutuberをしています。\nいつも素敵なイラスト拝見しております。\n\nこのたび、配信のサムネなどで使用するイラストをご依頼したいと思い、リクエストを送らせていただきました。\n「アイドルをしている鈴音舞夢」をテーマに描いていただきたいです。\n\n衣装や構図はよつばさんのお好きに描いていただけたら幸いです。\nもし背景があるようでしたら、キャラクターのみのレイヤーをご用意していただけると大変嬉しいです！\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kotorigi/works/14", "thumbnail_src": "https://si.imgix.net/c97407b0/uploads/origins/4cedee9a-d17c-4086-974c-7dbca4ac276e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9abf02a18da9458a75327a6159daf7", "thumbnail_srcset": "https://si.imgix.net/c97407b0/uploads/origins/4cedee9a-d17c-4086-974c-7dbca4ac276e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9abf02a18da9458a75327a6159daf7, https://si.imgix.net/c97407b0/uploads/origins/4cedee9a-d17c-4086-974c-7dbca4ac276e?bg=%23fff&auto=format%2Ccomp