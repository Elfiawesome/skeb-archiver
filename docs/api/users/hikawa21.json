-8b0e-4553-97e9-7eab17a8ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6cf351d84d484f52c8860c27be79499d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hikawa21/works/80", "thumbnail_src": "https://si.imgix.net/8147e6d6/uploads/origins/6765e3a4-984f-46b9-add9-b6284fb21f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23cd8889d131acf7bdd127b0a063154", "thumbnail_srcset": "https://si.imgix.net/8147e6d6/uploads/origins/6765e3a4-984f-46b9-add9-b6284fb21f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23cd8889d131acf7bdd127b0a063154, https://si.imgix.net/8147e6d6/uploads/origins/6765e3a4-984f-46b9-add9-b6284fb21f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0122806e181673c0947a644d3a8ea6d4 2x, https://si.imgix.net/8147e6d6/uploads/origins/6765e3a4-984f-46b9-add9-b6284fb21f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a573a83480f55a36a3142d8126743318 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのVtuber漫画が大好きです！\n\n私の友達のVtuberモデル、早乙女ニーナの依頼を受けることはできますか？\n\n彼女のリファレンスシートはこちら：https://x.com/NinanininVT/status/1718653432293142535?t=d75MnBvWbckKay2zTUDt4w&s=19\n\nポーズとしては、「私はかわいくない！私はパワフルな魔法少女よ\"\n\nありがとうございました！\n\nhttps://x.com/NinanininVT/status/1718653432293142535?t=d75MnBvWbckKay2zTUDt4w&s=19", "created_at": "", "completed_at": ""}, {"path": "/@hikawa21/works/79", "thumbnail_src": "https://si.imgix.net/2ab75aee/uploads/origins/1822f252-fd22-4f34-bb82-2266ed1b02ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93758d5f3b2f2fdddd88a90285b3d1b3", "thumbnail_srcset": "https://si.imgix.net/2ab75aee/uploads/origins/1822f252-fd22-4f34-bb82-2266ed1b02ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93758d5f3b2f2fdddd88a90285b3d1b3, https://si.imgix.net/2ab75aee/uploads/origins/1822f252-fd22-4f34-bb82-2266ed1b02ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84ae266545124174751253d1e7b40c37 2x, https://si.imgix.net/2ab75aee/uploads/origins/1822f252-fd22-4f34-bb82-2266ed1b02ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edd0dc68e8b681a78e0f9fbf0d51dba5 3x", "genre": "art", "nsfw": false, "body": "初めまして、Xで「大好きな親友がVチューバーの自分にガチ恋してた話」などいつも楽しく拝見させていただいてます。\n\n私の推しの個人で活動しているVtuberの桃奈みゆいさんのファンアートを依頼させていただきたいです(背景透過もあると使用しやすいかなと思います)。\nそしてそのファンアートに関して、桃奈さんが配信やCi-enなどのサムネイルなどの桃奈さんが活動で使用する旨の許可を頂ければと思います。\n\n依頼したいシチュエーションとしては、配信をやる前でみゆいん(桃奈さんのファンネ)に会えるのが楽しみ！嬉しい！っていう雰囲気の可愛らしい表情でお願いします。\n桃奈さんはいくつか衣装がありますが今回はお出掛け衣装の白で袖ありのコートなしでお願いします。\n(参考:https://www.youtube.com/live/x1ti3hPxYGo?si=DAqAecp8dx5nVGZ9&t=5582)\nまた桃奈さんは髪型も色々とありますが、やはり桃奈さんと言えば三つ編みツインテが一印象深いのでこちらでお願いします。\n(考:https://www.youtube.com/live/x1ti3hPxYGo?si=gQIX708s20zys)\nまた桃奈さんは自身の生誕祭にて新しいお部屋を公開していて、費用の中で対応できる範囲で構いませんので一部意匠を入れ込んでもらえると嬉しいです。\n(参考:https://www.youtube.com/live/gq42c4ZGLLw?si=B1FMx-gA1wI7x1Xj&t=2711)\n\nポーズなどは特に指示はないので氷川様が描きやすいように書いていただければと思います。\n\nhttps://lit.link/MomonyaMiyui", "created_at": "", "completed_at": ""}, {"path": "/@hikawa21/works/78", "thumbnail_src": "https://si.imgix.net/3fb9bfbe/uploads/origins/7c144785-77b7-4dee-a2d5-881f4813a760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a9d0d935de34d51458fafb28fe532dd", "thumbnail_srcset": "https://si.imgix.net/3fb9bfbe/uploads/origins/7c144785-77b7-4dee-a2d5-881f4813a760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a9d0d935de34d51458fafb28fe532dd, https://si.imgix.net/3fb9bfbe/uploads/origins/7c144785-77b7-4dee-a2d5-881f4813a760?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2fab57b5b01357a4d8be1a331987af0 2x, https://si.imgix.net/3fb9bfbe/uploads/origins/7c144785-77b7-4dee-a2d5-881f4813a760?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ffcc4d8ac45a607a811de178f073394 3x", "genre": "art", "nsfw": false, "body": "氷川翔　先生\nいつも元気なイラストありがとうございます。\n私の推しであるラブライブ！のキャラクター矢澤にこちゃんの2024バースデーイラストをリクエストさせてください。\n詳しい要望は以下のとおりです。\n\n・キャラクター： 矢澤にこ（ラブライブ！/μ's）\n・どこかに「Happy Birthday」などの誕生日を祝う文言と「2024/7/22」などの日付\n・構図：おまかせ\n　・ハンドサイン等、手に表情を付ける場合はにっこにっこにーのポーズにしていただけると幸いです\n・衣装：以下のどれか\n　　　 アニメ１期OP（公式chに動画があります）\n　　　 チア服（タカラモノズのジャケットのもの）\n　　　 スクフェス・スクフェス２・スクスタの実装イラストからアイドル性の高いもの\n　　　 おまかせ（可能であるならば以前描いていただいたもの以外）\n\n・利用用途\n　Twitterの矢澤にこちゃんの2024バースデータグに投稿したり、印刷して眺めたりします\n\n以上です、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@hikawa21/works/77", "thumbnail_src": "https://si.imgix.net/576c0b12/uploads/origins/9d80851b-1be0-4193-a0b9-bbd69deed723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8e5c8671e91beea32d8e51710cae10", "thumbnail_srcset": "https://si.imgix.net/576c0b12/uploads/origins/9d80851b-1be0-4193-a0b9-bbd69deed723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8e5c8671e91beea32d8e51710cae10, https://si.imgix.net/576c0b12/uploads/origins/9d80851b-1be0-4193-a0b9-bbd69deed723?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cfae26f839cb4cc749a46fec60d6a51 2x, https://si.imgix.net/576c0b12/uploads/origins/9d80851b-1be0-4193-a0b9-bbd69deed723?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ef6d181aa6d8402be7fa2b066b6993f 3x", "genre": "art", "nsfw": false, "body": "氷川翔先生こんにちは。いつもXでホロライブメンバーのFAや「大好きな親友がVチューバーの自分にガチ恋してた話」を楽しませていただいている1ファンです。\n\n・リクエスト内容\n私の推しイラストレーター兼Vtuberの「ちろ」様を描いていただきたいです。\nシチュエーションとしては、「ちろ」様の推しである「さくらみこ」さんが好きすぎて限界化している様子をお願いします。\nまた、背景は限界化している感情を文字化させて全体に敷き詰められているものにしてほしいです。\n台詞に関しては、FAや漫画における上記演出のワードセンスに感動して依頼させて頂いているので、「さくらみこ」さんに限界化している35Pのお気持ちだと思う熱い台詞を是非考えて頂きたいです。\n他、それ以外のポーズや構図等もお任せ致します。\n\nご本人様にお渡ししてSNSでの投稿・サムネイル等で使用して頂けるように、人物の背景透過もお願いいたします。\n形式は、人物と背景を分けたPSDファイルで頂けると幸いです。\n\n以上、ご検討のほどよろしくお願い致します。\n\n・資料\nhttps://twitter.com/chiro_chirororo/status/1771089055054234042", "created_at": "", "completed_at": ""}, {"path": "/@hikawa21/works/76", "thumbnail_src": "https://si.imgix.net/294a0518/uploads/origins/1e59461a-9a10-404f-b4c5-9a167c37043f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d41c9f22e750ce071e0e2260d428d08", "thumbnail_srcset": "https://si.imgix.net/294a0518/uploads/origins/1e59461a-9a10-404f-b4c5-9a167c37043f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d41c9f22e750ce071e0e2260d428d08, https://si.imgix.net/294a0518/uploads/origins/1e59461a-9a10-404f-b4c5-9a167c37043f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02caf340c6afa07e1e163fed05f2a83a 2x, https://si.imgix.net/294a0518/uploads/origins/1e59461a-9a10-404f-b4c5-9a167c37043f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5597e94004fd09c6fbba21b06ef064af 3x", "genre": "art", "nsfw": false, "body": "こんにちは、前回は素敵なイラストをありがとうございました！\n今回もうちの子のイラストを依頼させていただきたくご連絡いたしました。\n\n主な使用用途は個人鑑賞、Xやミスキーでのアイコン・ヘッダーでの使用とニコニコ動画で投稿中の実況動画（https://www.nicovideo.jp/user/11483402/series/234051）内で使用させていただきたいです（クレジットを明記します）\n\nイラストの内容は……\n金髪の獣耳っ娘が白髪の子にギルティギアシリーズのポチョムキンの必殺技の「ポチョムキンバスター」か、ブレイブルーシリーズのテイガーの必殺技の「キングオブテイガー」を使用してるような感じでお願いします（空中で掴まれたまま叩き落されそうになってる感じであれば上記の必殺技と似てなくても問題ございません）\n表情は金髪の子が怒っていて、白髪の子が涙目になってると嬉しいです。\n\n動画での使用をさせていただきたいので画像のサイズが1980×1080か1280×720の比率にあう感じでお願いいたします。\n\n資料絵は以下になります\n\nhttps://i.imgur.com/KNIbYSl.png（白髪の子）\n\nhttps://i.imgur.com/ajzgq2y.png（金髪の子）\n\n白髪の子のイラストは箱舟みかん様(@hako_orange)に依頼で描いていただいたものを使用させていただいております。\n金髪の子のイラストはポテノキ様(@potenoki)のキャラ販売で購入した子を使用させていただいております。\n\n以上が依頼させていただきたい内容となります。\nぜひご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hikawa21/works/75", "thumbnail_src": "https://si.imgix.net/4c295d08/uploads/origins/e201c02e-953c-48b6-8bcb-46647e22896b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d52e420a5d060313cdd91f