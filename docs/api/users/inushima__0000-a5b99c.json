bs/512367", "name": "512367"}], "flags": {"from_archive": true}, "acceptable": true, "works": [{"path": "/@inushima__0000/works/10", "thumbnail_src": "https://si.imgix.net/edd2fd3f/uploads/origins/23eae293-52bc-41ec-9a5b-20f2fa60986a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ea8ebecf49757a5b254aa6ac8685f2", "thumbnail_srcset": "https://si.imgix.net/edd2fd3f/uploads/origins/23eae293-52bc-41ec-9a5b-20f2fa60986a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ea8ebecf49757a5b254aa6ac8685f2, https://si.imgix.net/edd2fd3f/uploads/origins/23eae293-52bc-41ec-9a5b-20f2fa60986a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b60a433087e88c4c5d5694af3af3f2c 2x, https://si.imgix.net/edd2fd3f/uploads/origins/23eae293-52bc-41ec-9a5b-20f2fa60986a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4ee27629ef400381d1386b5270c4c88 3x", "genre": "art", "nsfw": true, "body": "禅幸亭おねえさん、後背位で、お尻のホクロが見えるような視点・角度で、以前描いていただいたイラストのようにお尻を大きくしてほしい。\n\nこの画像と同じようなスタイルで、お尻のテカリも好きです！\nhttps://x.com/Luv__0000/status/1762795130283806926/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@inushima__0000/works/9", "thumbnail_src": "https://si.imgix.net/f6ecab8d/uploads/origins/9924c088-cc7b-4d0e-84ea-32a3470bd91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3749a81a1df298583e060165fedcb7ee", "thumbnail_srcset": "https://si.imgix.net/f6ecab8d/uploads/origins/9924c088-cc7b-4d0e-84ea-32a3470bd91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3749a81a1df298583e060165fedcb7ee, https://si.imgix.net/f6ecab8d/uploads/origins/9924c088-cc7b-4d0e-84ea-32a3470bd91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bae69bf81a19caeb2571385309c0d807 2x, https://si.imgix.net/f6ecab8d/uploads/origins/9924c088-cc7b-4d0e-84ea-32a3470bd91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf91215a43538916352b6b29927a3b9a 3x", "genre": "art", "nsfw": false, "body": "こんばんは！いつもお世話になってております。\nあなたの描くイラストの肌や胸の質感が好きです！\nSkebを募集されていると知り、ぜひ推しCPのイラストを描いていただきたく、ここでイラストのリクエストをさせていただきます。\n\n○キャラ\n・『悪魔のリドル』の「首藤涼」と「神長香子」\n○シチュ・構図\n・資料URLの構図のフォルダ内にあるラフ画及び写真のような構図でお願いします\n…腕を上げて敬礼のようなポーズをする涼と、眼鏡を指で押し上げるポーズをする香子\n・百合っぽい感じの雰囲気でお願いします\n・いぬしまさんのイラストで例えるとこちらが近いです\nhttps://www.pixiv.net/artworks/109672233\n\n○衣装\n・資料URLのフォルダに入っている水着\n・黒い水着を涼、白い水着を香子に着せてください\n\n以上です。\nいぬしまさんの『僕の夏』というイラストに感銘を受け、今回のリクエストをさせていただきました。\n細かい注文が多くなってしまい申し訳ありません。お忙しいとは思いますが、何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1z4IALczYlTn9oRNd0VpqU2N9TaZZVLYD?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@inushima__0000/works/8", "thumbnail_src": "https://si.imgix.net/a2d0ba27/uploads/origins/bc49860c-7c2c-4a32-a38c-2a40e63918ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eaf54f16c1f7d471ddf4038f0771750", "thumbnail_srcset": "https://si.imgix.net/a2d0ba27/uploads/origins/bc49860c-7c2c-4a32-a38c-2a40e63918ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eaf54f16c1f7d471ddf4038f0771750, https://si.imgix.net/a2d0ba27/uploads/origins/bc49860c-7c2c-4a32-a38c-2a40e63918ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7184e90ecdf417d9007e51b2c6d7714f 2x, https://si.imgix.net/a2d0ba27/uploads/origins/bc49860c-7c2c-4a32-a38c-2a40e63918ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d5444be66bb50d16d179efd13aabbe8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at