-36c9-4ac9-8b81-68bf48fd153b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85343c072283dbe5e13090b2754bc861", "thumbnail_srcset": "https://si.imgix.net/ef4bfa75/uploads/origins/635cbf9e-36c9-4ac9-8b81-68bf48fd153b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85343c072283dbe5e13090b2754bc861, https://si.imgix.net/ef4bfa75/uploads/origins/635cbf9e-36c9-4ac9-8b81-68bf48fd153b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b716fbbbb85b2e49cd97c2f6712ee4d 2x, https://si.imgix.net/ef4bfa75/uploads/origins/635cbf9e-36c9-4ac9-8b81-68bf48fd153b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a80d3ad777e7a5af51f37739cfea197 3x", "genre": "art", "nsfw": false, "body": "るる実 様、こんばんは。\n萌留みみんです。\nるる実様のイラスト、絵柄全て可愛くて大好きです。\n\nいつも陰で依頼したいと思ってましたので、今回はこのチャンスがあってすごく嬉しいです。\n\n今回は年末になる予定の3.0の姿を描いて欲しいです。\n（今の姿とかなり違います。）\n\n・使用用途 : \nショート動画、ディザーPV、配信サムネ、Xでの投稿など\n\n・依頼について \n設定は電子天使です。\n構図やポーズは好きなように描いてください。\n\n\n忙しい中、申し訳ございませんがよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1l7MN49c6pk3r3MGfygLkmyf6lnVl9lF8?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nuilulumi/works/22", "thumbnail_src": "https://si.imgix.net/b8991c66/uploads/origins/f6ab0613-12eb-4b09-9bf2-2ea713ce4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50893fbf62a0fd4060c96b9b5e13ae72", "thumbnail_srcset": "https://si.imgix.net/b8991c66/uploads/origins/f6ab0613-12eb-4b09-9bf2-2ea713ce4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50893fbf62a0fd4060c96b9b5e13ae72, https://si.imgix.net/b8991c66/uploads/origins/f6ab0613-12eb-4b09-9bf2-2ea713ce4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&tx