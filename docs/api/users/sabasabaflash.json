f1-ce32b15a1c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3669d9c708b6e61ec6c8c4907c491996, https://si.imgix.net/00199661/uploads/origins/1074d6f6-f4b2-4289-bbf1-ce32b15a1c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=128c0a0dd33502ba519b342fc374822a 2x, https://si.imgix.net/00199661/uploads/origins/1074d6f6-f4b2-4289-bbf1-ce32b15a1c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4db087c5ff8c58874e93e80cfde5ef21 3x", "genre": "art", "nsfw": false, "body": "さばな先生、はじめまして。\n私は先生のイラストが大好きで、どの作品もとても可愛くて魅力的だと思っています。\nぜひ、私のオリジナルキャラクター（OC）の全身立ち絵を描いていただきたく、ご連絡させていただきました。\nポーズや構図などの演出は、すべて先生にお任せしたいと考えております。\nこちらがOCの参考リンクです：https://photos.app.goo.gl/TaGXTpSjroxv4QJg9\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/TaGXTpSjroxv4QJg9", "created_at": "", "completed_at": ""}, {"path": "/@sabasabaflash/works/35", "thumbnail_src": "https://si.imgix.net/20550343/uploads/origins/9a9b576f-fb71-4cf3-b81b-87c318a5bff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f3e89cf437302e2cdb3872b79ea2b4", "thumbnail_srcset": "https://si.imgix.net/20550343/uploads/origins/9a9b576f-fb71-4cf3-b81b-87c318a5bff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f3e89cf437302e2cdb3872b79ea2b4, https://si.imgix.net/20550343/uploads/origins/9a9b576f-fb71-4cf3-b81b-87c318a5bff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca8a9f3da5b099ec8c825af66da0d45f 2x, https://si.imgix.net/20550343/uploads/origins/9a9b576f-fb71-4cf3-b81b-87c318a5bff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7776554ba48bf82ae72164c2d8177425 3x", "genre": "art", "nsfw": false, "body": "先生 こんばんは、twitter で先生の絵を拝見しました、先生に画風が気に入ったので、イラストを依頼したい。\n\n作品は魔法使いと黒猫のウィズに金アイです。\n\n使用用途\nパソコンとスマホの背景利用\nTwitter等snsでの利用 （商用ではありません）\nリクエスト:\n\nhttps://drive.google.com/file/d/1fPpPdblQXN8oAF07kRQlgfNuu-cqu4p9/view?usp=drivesdk\n\n参考資料:\nhttps://drive.google.com/drive/folders/1wsW2mo4RWxZfUOgdq7-cZxf_RsZLqYQu", "created_at": "", "completed_at": ""}, {"path": "/@sabasabaflash/works/34", "thumbnail_src": "https://si.imgix.net/ff936821/uploads/origins/a6193ab9-2f2b-4a0b-a56a-c0d991132806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e38c78dabb3a5be1fcab47ca65b6364b", "thumbnail_srcset": "https://si.imgix.net/ff936821/uploads/origins/a6193ab9-2f2b-4a0b-a56a-c0d991132806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e38c78dabb3a5be1fcab47ca65b6364b, https://si.imgix.net/ff936821/uploads/origins/a6193ab9-2f2b-4a0b-a56a-c0d991132806?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1adc4a7faa5548599db805e0512630ea 2x, https://si.imgix.net/ff936821/uploads/origins/a6193ab9-2f2b-4a0b-a56a-c0d991132806?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a22326f1725ee59a189faa94347c6f81 3x", "genre": "art", "nsfw": true, "body": "はじめまして。Skebに納品されている立ち絵イラストが好みでしたのでリクエストします。\nPCゲーム『おしえて!唯子先生【エッチ】を覚える大人の性教育レッスン!!』の寺川唯子先生を描いて頂けないでしょうか。\n服装はキャラ紹介やゲームのパッケージで着ている白と青を基調とした服で。肩にいるマスコットキャラは描かないで大丈夫です。\n\nイラストはパンチラ（青と白の縞パン）している立ち絵が希望で、細かいポーズはおまかせします。\n明るく楽しそうな雰囲気にして頂けるとありがたいです。\nよろしくお願いします。\n\n\n「参考　キャラクター、公式HP」\nhttp://squeez-soft.jp/soft/yuiko/chara.html\nhttp://squeez-soft.jp/soft/yuiko/img/ss_01.jpg\nhttp://squeez-soft.jp/soft/yuiko/img/pos_smp.jpg\nhttp://squeez-soft.jp/\nhttp://squeez-soft.jp/soft/yuiko/index.html\n\n「参考　イラスト」\nhttps://skeb.jp/search?q=%E5%AF%BA%E5%B7%9D%E5%94%AF%E5%AD%90&t=works", "created_at": "", "completed_at": ""}, {"path": "/@sabasabaflash/works/33", "thumbnail_src": "https://si.imgix.net/834cfe6d/uploads/origins/c981e85e-c2be-4df2-b728-a6ed5235202c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8979e80075fceaecdc2246fc9234023", "thumbnail_srcset": "https://si.imgix.net/834cfe6d/uploads/origins/c981e85e-c2be-4df2-b728-a6ed5235202c?bg=%2