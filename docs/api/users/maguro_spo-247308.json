-b4f1-048076bac5d7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7b5d391e0a6d398018e77c7304d4b53a", "thumbnail_srcset": "https://si.imgix.net/cf4a0f03/uploads/origins/2fce6a73-6c27-493e-b4f1-048076bac5d7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7b5d391e0a6d398018e77c7304d4b53a, https://si.imgix.net/cf4a0f03/uploads/origins/2fce6a73-6c27-493e-b4f1-048076bac5d7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=7383723122cc80b2a43396d8f6afafcd 2x, https://si.imgix.net/cf4a0f03/uploads/origins/2fce6a73-6c27-493e-b4f1-048076bac5d7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc217a1c408322a99245584df9c84d0f 3x", "genre": "art", "nsfw": false, "body": "失礼します。最近あるけみすとをプレイしているヴィルカというものです。\n自キャラのアイコンを決めるにあたって「これいいな」と思ったアイコンがほぼ輪廻様作のもので、これはもうご依頼するしかないと思ったのでご依頼させていただきました。\n\n【キャラクターイメージ】\n名前：ヴィルカ\n性別：女\nかつてある世界で「瞳の魔女」と呼ばれ恐れられていた存在。\n少女のような姿をしているが実際の年齢は不詳。\n元の世界でのやらかしが原因で記憶を封印されたまま次元のはざまに幽閉されていたが、何らかの拍子であるけみすとの世界に放り出されることになる。\n\n詳しい見た目は参考資料を添付するので、そこから全体の雰囲気と上部にある瞳以外は描きやすいように好きにアレンジしていただければと思います！(イメージ写真は少し露出高めなので出来れば下げていただけると幸いです。)\n杖か天球儀はお好きなほうを持たせていただければ嬉しいです！\n\n【構図・モーション】\n構図・モーションの細かいところはお任せします！出来れば浮遊感あるものだと嬉しいです。\nそれと、一瞬上部の瞳ではなく本人が目を開けるモーションもあると助かります！！\n【使用用途】\nあるけみすとでのキャラアイコンとして使用\nTwitterやディスコードでのアイコンとしての使用(クレジットは必ず表記します)\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1koTUyJzJyRDZr4ol8R8uZvUt9cXtjuIt?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1koTUyJzJyRDZr4ol8R8uZvUt9cXtjuIt?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@maguro_spo/works/52", "thumbnail_src": "https://si.imgix.net/a7653963/uploads/origins/326187f0-fd78-43bc-8321-c060cab53e8c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=34eba3cd66ecc2dc8cf5882934077e5e", "thumbnail_srcset": "https://si.imgix.net/a7653963/uploads/origins/326187f0-fd78-43bc-8321-c060cab53e8c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=34eba3cd66ecc2dc8cf5882934077e5e, https://si.imgix.net/a7653963/uploads/origins/326187f0-fd78-43bc-8321-c060cab53e8c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3254451077894a0534587a2be7dfc646 2x, https://si.imgix.net/a7653963/uploads/origins/326187f0-fd78-43bc-8321-c060cab53e8c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=47b997183f348c8bca7cc7e4ce6b093e 3x", "genre": "art", "nsfw": false, "body": "はじめまして。 はーすとと申します。 あるけみすとにはまり、輪廻さんのキャラアイコンを眺め綺麗だな、美しいなと常々感じており今回依頼させていただければと思いご連絡差し上げました。\nご依頼の詳細を下記に記載させていただきます。 条件等難しい場合はキャンセルいただいても大丈夫です。 何卒ご検討の程よろしくお願い致します。  \n【構図やイメージ】  僕の別ゲーでの自キャラ（うちの子）の作成をお願いいたします。髪は白と銀の間くらいの狼っ子で、年齢は幼めです。狼耳は横に倒すような耳（イカ耳）だと嬉しいです。尻尾はふわふわでお願いいたします。衣装は白のドレスで、靴は黒のヒール、首に黒のチョーカーでお願いいたします。装飾や姿勢、動作はお任せさせていただければと思います。輪廻さんの絵柄が大好きなので、ご自由にお描きいただければ幸いです。添付資料に参考画像を載せさせていただきます。どうぞよろしくお願いいたします。\n【使用用途】・あるけみすとのキャラアイコン\n・twitch、YouTubeなど配信内での使用の可能性\n・Xでの広報での使用の可能性\n\n改めまして、どうぞよろしくお願いいたします。\n\nhttps://x.com/kokoromi_hast/status/2008488332796547202?s=46&t=cZdFOWXKJQlixkfB2yN15g", "created_at": "", "completed_at": ""}, {"path": "/@maguro_spo/works/51", "thumbnail_src": "https://si.imgix.net/d8aec5bf/uploads/origins/6c772e20-15aa-476b-b3ac-f54faa9294c6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a499fb1ae04668055f65c2205138a204", "thumbnail_srcset": "https://si.imgix.net/d8aec5bf/uploads/origins/6c772e20-15aa-476b-b3ac-f54faa9294c6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a499fb1ae04668055f65c2205138a204, https://si.imgix.net/d8aec5bf/uploads/origins/6c772e20-15aa-476b-b3ac-f54faa9294c6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e70df55cf8b66d1368a37b27dc70183 2x, https://si.imgix.net/d8aec5bf/uploads/origins/6c772e20-15aa-476b-b3ac-f54faa9294c6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=a03586c4a3ff23c7e360eae23b36d545 3x", "genre": "art", "nsfw": false, "body": "始めましてあるけみすと内であなたが描いたアイコンを見て、自分もアイコンを描いて欲しくて筆を取りました\nご依頼したいのは先ほど言った通り、あるけみすと内のアイコンです\nキャライメージ  性別女の子・体型 中背 細身\n髪色 黒と暗い青のツートンカラー・髪型 お任せします・服装 できれば暗い青色のスカーフを付けて欲しいです。それ以外はお任せします\n雰囲気 暗い感じでお願いします\n\n始めて依頼をしたので至らないところはあると思いますがお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@maguro_spo/works/50", "thumbnail_src": "https://si.imgix.net/7fa6fcff/uploads/origins/a0896ad1-67c3-4d2c-957b-1584a564273e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1f9604bfe5863d031da5f6c589c1951", "thumbnail_srcset": "https://si.imgix.net/7fa6fcff/uploads/origins/a0896ad1-67c3-4d2c-957b-1584a564273e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1f9604bfe5863d031da5f6c589c1951, https://si.imgix.net/7fa6fcff/uploads/origins/a0896ad1-67c3-4d2c-957b-1584a564273e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2e0ab04cd386de62c72ead6c0845c35 2x, https://si.imgix.net/7fa6fcff/uploads/origins/a0896ad1-67c3-4d2c-957b-1584a564273e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f128372a74cc703de107597e02506865 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maguro_spo/works/49", "thumbnail_src": "https://si.imgix.net/e15eb799/uploads/origins/c178a8b4-d67f-410a-afd9-d775603f135a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32bc98da7aae03e3d5f971f0c24f5091", "thumbnail_srcset": "https://si.imgix.net/e15eb799/uploads/origins/c178a8b4-d67f-410a-afd9-d775603f135a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32bc98da7aae03e3d5f971f0c24f5091, https://si.imgix.net/e15eb799/uploads/origins/c178a8b4-d67f-410a-afd9-d775603f135a?bg=%23fff&auto=format%2C