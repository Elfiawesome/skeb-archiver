36e7ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4dc62c845caf0e0562a72d54316a7a", "thumbnail_srcset": "https://si.imgix.net/aa68912e/uploads/origins/e90b6e89-8db2-433c-805f-cb69436e7ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4dc62c845caf0e0562a72d54316a7a, https://si.imgix.net/aa68912e/uploads/origins/e90b6e89-8db2-433c-805f-cb69436e7ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=392c823af506785272bf13c74a34402f 2x, https://si.imgix.net/aa68912e/uploads/origins/e90b6e89-8db2-433c-805f-cb69436e7ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3936bfd6c3968554a2b56b6a92e7618 3x", "genre": "art", "nsfw": false, "body": "こんにちは！🐇 twitterから来ました！ミクさん、お誕生日おめでとうございます！✨\n私のOCのティアナ描きませんか？\n\nかわいいものが好きで、特にぬいぐるみとお人形が好きなおとなしい女の子です。読書とお菓子作りも好きです。\n\nお任せしたいです。複数の衣装があるので、好きなものを選んで描いてください！\n\nありがとうございました！🙇️\n\nhttps://toyhou.se/1123122.tiana?key=3tERTgSBPZP0oal", "created_at": "", "completed_at": ""}, {"path": "/@076_usa/works/55", "thumbnail_src": "https://si.imgix.net/4735c901/uploads/origins/4e0d60ad-490b-41d0-8615-2cd3d215bef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e16afcdf69425d46caec68270e68a7e", "thumbnail_srcset": "https://si.imgix.net/4735c901/uploads/origins/4e0d60ad-490b-41d0-8615-2cd3d215bef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e16afcdf69425d46caec68270e68a7e, https://si.imgix.net/4735c901/uploads/origins/4e0d60ad-490b-41d0-8615-2cd3d215bef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f40e4c5a40ac0244336b212654092ce4 2x, https://si.imgix.net/4735c901/uploads/origins/4e0d60ad-490b-41d0-8615-2cd3d215bef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3b8dc0f82a4c4300da55548e869965d 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n新人vtuberの真宵と言います。\n\n兎莵様のシンフォギアのイラストに惹かれて\nリクエストさせていただきました！\n\nぜひ、私を描いてくださると嬉しいです！\n等身、デフォルメはお任せします。\n\nサムネイルやアイコンなどに使用させて頂きたいので\n背景と人物が分けられるPSD形式で納品してくださると幸いです！\n\nhttps://drive.google.com/drive/folders/1-hplSMh6qxXKKof0WAQdA51qhhWRsTOg\n\n何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@076_usa/works/54", "thumbnail_src": "https://si.imgix.net/c5ce6763/uploads/origins/4704a129-7049-43fa-95ff-e40ed07e3df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10eeba66abca1217347e5d9407126be0", "thumbnail_srcset": "https://si.imgix.net/c5ce6763/uploads/origins/4704a129-7049-43fa-95ff-e40ed07e3df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10eeba66abca1217347e5d9407126be0, https://si.imgix.net/c5ce6763/uploads/origins/4704a129-7049-43fa-95ff-e40ed07e3df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffe05c233bcabe166698482a066b028e 2x, https://si.imgix.net/c5ce6763/uploads/origins/4704a129-7049-43fa-95ff-e40ed07e3df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35e7989451a69f92e35e2206fdd75e59 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nVTuberとして活動しております、猫目みっけと申します。\n是非私のイラストを描いていただきたく、ご連絡差し上げました。\n\n●キャラクター\n白猫を連れた、オッドアイの女の子。\n口を開くと、正面から見て右側に八重歯があります。\n参考資料として立ち絵3種をアップしたURLをお送りいたしますので、ご確認ください。\n\n●構図\nメスガキのイメージで、猫目みっけの等身イラストを描いていただきたいです。\n構図や衣装などはお任せいたします。\n可能であれば、髪や装飾品などのパーツを画面内に収めていただきたいです。\n\n●使用用途\nTwitter・YouTubeのアイコンやサムネなど、動画・配信活動での使用を想定しております。\n\n●その他\nサインや背景を分けたPSDデータでいただけますと幸いです。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1tMWC3Nb_5Wsmrl0VDHlw_TSNwKTwvlQj?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@076_usa/works/53", "thumbnail_src": "https://si.imgix.net/aa5e8a92/uploads/origins/8373479c-2491-48d1-9799-e001fe188d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99b69abd38e56287d2c675cba721e7f0", "thumbnail_srcset": "https://si.imgix.net/aa5e8a92/uploads/origins/8373479c-2491-48d1-9799-e001fe188d