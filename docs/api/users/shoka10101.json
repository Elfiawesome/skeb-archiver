4-b328-0365f55f495f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6722fb1bbcdf213aa0e69b0f67930e6, https://si.imgix.net/e6470ff7/uploads/origins/488fd74b-4b95-4804-b328-0365f55f495f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f23b4f4d623e484169bab4b09b18f3db 2x, https://si.imgix.net/e6470ff7/uploads/origins/488fd74b-4b95-4804-b328-0365f55f495f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40bc6178a4fdf294ad61b1b60f94c149 3x", "genre": "art", "nsfw": false, "body": "前回のリクエストがとても気に入りました！！！また同じOCの絵をお願いしてもいいですか？ダメなら遠慮なくお断りしてください！\n\n今回は正装でお願いします！\n\n参考画像：https://drive.google.com/file/d/1MetkJHxF94yrG0aoqpvmqfabZyu0JpTY/view?usp=sharing\n\nできれば、彼の正式な武器である刺股（さすまた）も入れてほしい！金属製の銀色のやつです。あと、片方の髪を後ろに流しています！\n\n服装の細かい変更はご自由に！もちろん、何か問題があれば遠慮なく断ってください！ありがとうございました", "created_at": "", "completed_at": ""}, {"path": "/@shoka10101/works/24", "thumbnail_src": "https://si.imgix.net/5cbb1bb0/uploads/origins/5637052e-0794-48b9-9d18-6104b8e93028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f37e3a937af1935b387eae7c414b6ec", "thumbnail_srcset": "https://si.imgix.net/5cbb1bb0/uploads/origins/5637052e-0794-48b9-9d18-6104b8e93028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f37e3a937af1935b387eae7c414b6ec, https://si.imgix.net/5cbb1bb0/uploads/origins/5637052e-0794-48b9-9d18-6104b8e93028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a444a28665b3152f94d2d6543e3f1bf4 2x, https://si.imgix.net/5cbb1bb0/uploads/origins/5637052e-0794-48b9-9d18-6104b8e93028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c16bddfbc0d9bbbc774878a8732f1646 3x", "genre": "art", "nsfw": false, "body": "これは私のキャラクターであるグアコのもので、彼は腐敗の龍神であり、非常に生意気でサディスティックで、赤い稲妻の力を持っている。\n\nどんなポーズを選ぶかは、すべて君に任せるよ。お疲れ様でした。\n\nhttps://drive.google.com/drive/folders/1QLwYCyO5xHEAtxjqjUFURVG-a1TJT3SZ?usp=sharing", "created_at": "", "comp