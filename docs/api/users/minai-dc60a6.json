9b9b-bcdc-4f3c-9cf4-fbb090f6c36d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2933088fa35bb3ce68a22e311f033ac 2x, https://si.imgix.net/3443b6ab/uploads/origins/22be9b9b-bcdc-4f3c-9cf4-fbb090f6c36d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=143338d22bfbe4eea84a9aea6d547f75 3x", "genre": "art", "nsfw": false, "body": "とうじです。\n月虹まごちゃんのイラストを依頼させていただきたいです。\n歌のステージでファンサ的なことをしてくれているまごちゃんをお願いします（手を振っているとかウィンクしているとか…）。ポーズ・構図等はお任せします。\n利用用途は観賞用で、まごちゃん成分を補充したい時に見てニコニコする目的です。\n依頼に問題なければ、お時間あるときでかまいませんのでよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@minai/works/5", "thumbnail_src": "https://si.imgix.net/63cf390a/uploads/origins/343db53c-72f4-4d31-be4a-1bb9680596bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dcadab4d9679bf69c1cbfd384cd6b0d", "thumbnail_srcset": "https://si.imgix.net/63cf390a/uploads/origins/343db53c-72f4-4d31-be4a-1bb9680596bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dcadab4d9679bf69c1cbfd384cd6b0d, https://si.imgix.net/63cf390a/uploads/origins/343db53c-72f4-4d31-be4a-1bb9680596bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9eb5db85659c9629536d4c2f823497a 2x, https://si.imgix.net/63cf390a/uploads/origins/343db53c-72f4-4d31-be4a-1bb9680596bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e0ff20c7ae11657219d3075530a098c 3x", "genre": "art", "nsfw": false, "body": "薬袋ミル様こんにちは！\n下記添付資料の弊サークルのキャラクター「月知らずのヤドカ」のイラストをお願いいたします！\n\n資料は添付いたしますが、ミル様の解釈で容姿にアレンジ・省略等が加わっても大丈夫です。\n\n◆提案シチュエーション\n特に沿う必要はありませんが、雨天を駆け回るシーンが可愛いかもしれません。\n\n◆使用用途\n主にVRChatなどのVRSNSのワールド内への配置、また私のSNSアカウント上や配信・動画サムネイルへの使用、イベント用ポスターへの使用の許可を頂きたいです。\nまたプラットフォームや用途に応じた加工編集を行う可能性があります。\n\n◆その他\n人物と背景がレイヤー分けされている形式ですと助かります\n\n◆その他資料\nhttps://twitter.com/Sakazuki_naigi/status/1644666704302333952\nhttps://sakazuki.booth.pm/items/4390139\n\n何卒ご検討のほどよろしくお願いいたします！\n\nhttps://misskey.io/notes/9qgl9oyaskyx0d5i", "created_at": "", "completed_at": ""}, {"path": "/@minai/works/4", "thumbnail_src": "https://si.imgix.net/54805503/uploads/origins/409a89e4-710c-4926-92da-e4ba9c781415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d572629498eb40f40c401654101a01", "thumbnail_srcset": "https://si.imgix.net/54805503/uploads/origins/409a89e4-710c-4926-92da-e4ba9c781415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d572629498eb40f40c401654101a01, https://si.imgix.net/54805503/uploads/origins/409a89e4-710c-4926-92da-e4ba9c781415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a22db8cad047c06d8f6ac7f7427ba181 2x, https://si.imgix.net/54805503/uploads/origins/409a89e4-710c-4926-92da-e4ba9c781415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7bd311c7711517729d0375c855e560c 3x", "genre": "art", "nsfw": false, "body": "まごちゃんとミルちゃんが一緒に何かやっている絵を描いて頂きたいです。２人で遊んでいてもイラスト描いていても歌っていても配信していてもそれ以外でもよいのですが、２人で一緒に楽しそうなところが見たいです。構図等はお任せします。ふわっとした依頼ですみません。\n利用用途は、自分で見てにこにこするのと、お友達に見せて自慢するのと、可能ならTwitterに載せたいです。\nお時間ある時で構いませんので、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@minai/works/3", "thumbnail_src": "https://si.imgix.net/613f9e0f/uploads/origins/937003bc-497b-4cf0-a1c1-fadece244ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ba381d81ea41175fdb2bfdd63c4830", "thumbnail_srcset": "https://si.imgix.net/613f9e0f/uploads/origins/937003bc-497b-4cf0-a1c1-fadece244ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ba381d81ea41175fdb2bfdd63c4830, https://si.imgix.net/613f9e0f/uploads/origins/937003bc-497b-4cf0-a1c1-fadece244ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86e402dd0cb10b290d934109b31f8675 2x, https://si.imgix.net/613f9e0f/uploads/origins/937003bc-497b-4cf0-a1c1-fadece244ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&