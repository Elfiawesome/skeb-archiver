e447-466e-9bef-902c47a235a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bccc6c30571652b156722a070833e38 3x", "genre": "art", "nsfw": true, "body": "https://www.pixiv.net/artworks/136036595\nこちらのメスドラが肥満化した状態でビルよりも巨大化した状態でこちらのヒーローロボ（ドラゴンから見ればおもちゃサイズ）https://www.pixiv.net/artworks/122920915\nと戦うも太った体のせいで汗だくで苦戦してるところをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/123", "thumbnail_src": "https://si.imgix.net/41e8fb4d/uploads/origins/47b0d08d-6a89-4409-8ec4-8f338ddd421d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d5ba6a855412b680f8608d9e85e3bff", "thumbnail_srcset": "https://si.imgix.net/41e8fb4d/uploads/origins/47b0d08d-6a89-4409-8ec4-8f338ddd421d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d5ba6a855412b680f8608d9e85e3bff, https://si.imgix.net/41e8fb4d/uploads/origins/47b0d08d-6a89-4409-8ec4-8f338ddd421d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b63b15662c8185f01389f6f2cfaa1440 2x, https://si.imgix.net/41e8fb4d/uploads/origins/47b0d08d-6a89-4409-8ec4-8f338ddd421d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85714e229baf12992f8a4d1c6c03be6f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/122", "thumbnail_src": "https://si.imgix.net/042fe67e/uploads/origins/7afdbbf3-1cf3-4376-8736-da25fe543471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddea7b8710b8c95a1a21fb022a20e449", "thumbnail_srcset": "https://si.imgix.net/042fe67e/uploads/origins/7afdbbf3-1cf3-4376-8736-da25fe543471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddea7b8710b8c95a1a21fb022a20e449, https://si.imgix.net/042fe67e/uploads/origins/7afdbbf3-1cf3-4376-8736-da25fe543471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9acfbdf15570051093a95a763007a762 2x, https://si.imgix.net/042fe67e/uploads/origins/7afdbbf3-1cf3-4376-8736-da25fe543471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2c64ceb35831762f19f9cdf1d65eafe 3x", "genre": "art", "nsfw": false, "body": "あなたの描くふわふわした絵が本当に好き！\n私の友人には、犬のocに私のウサギのocを抱きしめて温めてもらうのが好きな人がいます。私のウサギのocは普段は人間なんだけど、万が一のために毛皮のaltを追加したの。\n 私のウサギのocの上にベッドを置いて、犬の毛皮で彼を包み込むようなアートピースはできますか？もっとふやかす必要があっても大丈夫です。\nまた、彼の超超でかくてフワフワのaltも作ってもらえますか？\n\nhttps://drive.google.com/drive/folders/1wu1Yr4usdfda1WVqZ-1knhW_K7snKBOe?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/121", "thumbnail_src": "https://si.imgix.net/fc2bea20/uploads/origins/0cef551a-9dd9-4298-a243-7271a6de5f0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc8df75976fef0905ef473c84f7f886d", "thumbnail_srcset": "https://si.imgix.net/fc2bea20/uploads/origins/0cef551a-9dd9-4298-a243-7271a6de5f0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc8df75976fef0905ef473c84f7f886d, https://si.imgix.net/fc2bea20/uploads/origins/0cef551a-9dd9-4298-a243-7271a6de5f0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e08a5907e59f25b0b21e5e11b3cb0e8c 2x, https://si.imgix.net/fc2bea20/uploads/origins/0cef551a-9dd9-4298-a243-7271a6de5f0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec9eb12594851d0cd0a6d876951ae6ed 3x", "genre": "art", "nsfw": false, "body": "こんにちは！大きなお腹の描き方がすごく好きです！\n私のキャラクターが、ビーズクッションの椅子みたいに尻尾の上に座ってチーズバーガーを食べているところを描いてください。大きなお腹とつま先が丸見えの、ゆったりとした座り方をしてほしいんです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1oytpCGUGm02OXXWa7pKux6-PpGtxqevq?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/120", "thumbnail_src": "https://si.imgix.net/d49fac87/uploads/origins/410eaa70-ef93-4777-a7cb-8f3755e6062b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0c340f830307dd51dc4e4892b84461", "thumbnail_srcset": "https://si.imgix.net/d49fac87/uploads/origins/410eaa70-ef93-4777-a7cb-8f3755e6062b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0c340f830307dd51dc4e4892b84461, https://si.imgix.net/d49fac87/uploads/origins/410eaa70-ef93-4777-a7cb-8f3755e6062b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=911392835dd2d9922406ac0a0ef55eba 2x, https://si.imgix.net/d49fac87/uploads/origins/410eaa70-ef93-4777-a7cb-8f3755e6062b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ece55363b6e3c8a6ef981cd9c276fcdd 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ あなたの作品が大好きです!! 人だらけの電車に僕のOCを描いてください! 私のOCの体型はとても太っています 同時に、私の被写体のOCも描いてください、私の被写体のOCは私の前でトラムのドアに押し付けられることしかできないように押し付けられ、同時に非常に太っていたので、周りのみんなが絞られましたが、みんな強迫観念な表情を見せて、最後に私のOCの胸をもう少し大きく描いてください、私の被写体のOCは私のOCの胸の谷間に押し込まれました、私のOCは恥ずかしがり屋で少しエロい表情をしていました、そしてとても太っていたので、ひび割れるまで服を伸ばしました、ありがとう!\n\nhttps://drive.google.com/file/d/1cybtjEj6qIaKcaoSixRFgLKAhwzZ64_R/view?usp=drivesdk\n\nこれが私のオブジェクトのocです!\nhttps://drive.google.com/file/d/18gp5PsEk4TuJO1hlPBPHwEAh0xo4mc4v/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/119", "thumbnail_src": "https://si.imgix.net/75fb6ac2/uploads/origins/cd692e06-b1a9-40d3-88ce-f1a78e5d1157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6195fcf0b4748784bbe29872897147", "thumbnail_srcset": "https://si.imgix.net/75fb6ac2/uploads/origins/cd692e06-b1a9-40d3-88ce-f1a78e5d1157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6195fcf0b4748784bbe29872897147, https://si.imgix.net/75fb6ac2/uploads/origins/cd692e06-b1a9-40d3-88ce-f1a78e5d1157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=433b03ffcfa3010611e5bd3239d91a3c 2x, https://si.imgix.net/75fb6ac2/uploads/origins/cd692e06-b1a9-40d3-88ce-f1a78e5d1157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e1941473d35a905c2a3a4cbcbe955f1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nいつもイラストを楽しく拝見しています！\n\nサメドラゴンDequeとウサギTiramiが一緒に太りながら膨らむ様子を見たいです。\n\n二つのキャラクターがシャワー室に閉じ込められ、口にホースを縛られた状態で互いの腹をくっつけたまま、非常にきつく強制的に膨らまされる状況であれば幸いです。\n\nDequeはホースを通じて空気を注入され、風船のようにパンパンに膨らみ、Tiramiはホースを通じて食べ物を注入され、揺れ動くように太った姿で太っていく様子を希望します。\n\nhttps://skeb.jp/@hoshino_kedama/works/88\n全体の雰囲気は、上記のイラストを参考にしていただければ幸いです。\n\nDeque: https://drive.google.com/drive/folders/1zlK3nAZUxRGB-lBUtx04WyBnBOJbMvuW?usp=sharing\n\nTirami: https://drive.google.com/drive/folders/11b0PMsXXtlpTfuNS9-w7lVdPXOdYkL4D?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/118", "thumbnail_src": "https://si.imgix.net/ec00f60a/uploads/origins/7b3fb541-b3f4-44bc-8d09-db0a3c8ad451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3028bd5f2423fbcbfffeb95240f3a297", "thumbnail_srcset": "https://si.imgix.net/ec00f60a/uploads/origins/7b3fb541-b3f4-44bc-8d09-db0a3c8ad451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3028bd5f2423fbcbfffeb95240f3a297, https://si.imgix.net/ec00f60a/uploads/origins/7b3fb541-b3f4-44bc-8d09-db0a3c8ad451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95602e90e040d5cd5b32ed625fdeaa6e 2x, https://si.imgix.net/ec00f60a/uploads/origins/7b3fb541-b3f4-44bc-8d09-db0a3c8ad451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54972464c291b24cb8a9bc3196a09f9f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの絵がとても好きなので、私のスカルドラゴンのキャラクターがクッキーをたくさん食べてお腹を膨らませてくつろいでいる姿をリクエストしたいです！できれば、このジャケットを着せたいです。https://www.dropbox.com/s