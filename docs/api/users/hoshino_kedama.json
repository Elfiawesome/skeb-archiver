0f-b65b-52208ba9a88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e47c8c97ae4d689a7914d5789f5a2b3 2x, https://si.imgix.net/78d920e8/uploads/origins/0bde50ac-3ca8-470f-b65b-52208ba9a88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6a3f95d572ac908b735ecdb2e0424aa 3x", "genre": "art", "nsfw": true, "body": "私のキャラクターが水でどんどん膨らんでいく様子を描いてください！黒い水着を着せてください！動かなくなるまでの成長の違いを見せてください！\n\nhttps://www.dropbox.com/scl/fo/n3whohxuo2i57dxtjl1qf/ACAjTZo6o6YeVJahJJk-_Qg?rlkey=j0002bx3eafashup9dmgwhpwy&st=tb3e7ufa&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/115", "thumbnail_src": "https://si.imgix.net/ae2bb987/uploads/origins/ec97e572-773b-427c-8716-4852309e3cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c89f93cad35344d6c8a2041b830fab", "thumbnail_srcset": "https://si.imgix.net/ae2bb987/uploads/origins/ec97e572-773b-427c-8716-4852309e3cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c89f93cad35344d6c8a2041b830fab, https://si.imgix.net/ae2bb987/uploads/origins/ec97e572-773b-427c-8716-4852309e3cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9b3d94ffeea2154bdee21328caf281d 2x, https://si.imgix.net/ae2bb987/uploads/origins/ec97e572-773b-427c-8716-4852309e3cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ec7adea4f0b7b0ea0f1391d63d409aa 3x", "genre": "art", "nsfw": true, "body": "hiii!! I've been looking at your art for a long time!! I love your chubby characters!!I'd like you to make an obese female Salazzle doing this pose, If you could make it fatter and softer that would be great!\nhttps://x.com/hoshino_kedama/status/1918623142932804053", "created_at": "", "completed_at": ""}, {"path": "/@hoshino_kedama/works/114", "thumbnail_src": "https://si.imgix.net/32de8d2b/uploads/origins/7cb34a8c-3dba-4c7e-b6c4-563a0807c390?bg=%23fff&auto=format%2Ccompress&fm=webp&