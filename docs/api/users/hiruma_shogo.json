58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a160f5f7e3c1613c832d7d81e09385ad 2x, https://si.imgix.net/e73dc412/uploads/origins/a7ebaa11-ab5b-483b-a4e8-9dd29ce2b58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39d99a129cf5a7cd21827ca74fd6ef29 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hiruma_shogo/works/81", "thumbnail_src": "https://si.imgix.net/799851a8/uploads/origins/088cd7fa-637e-4f3a-b527-0aeb93f25cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b010c1935dd55c2e4680daac94c2e448", "thumbnail_srcset": "https://si.imgix.net/799851a8/uploads/origins/088cd7fa-637e-4f3a-b527-0aeb93f25cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b010c1935dd55c2e4680daac94c2e448, https://si.imgix.net/799851a8/uploads/origins/088cd7fa-637e-4f3a-b527-0aeb93f25cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6b2732f54e99c1fa923d4a1976aebcc 2x, https://si.imgix.net/799851a8/uploads/origins/088cd7fa-637e-4f3a-b527-0aeb93f25cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc7f2b121677355ce6b638a693cf7f99 3x", "genre": "art", "nsfw": false, "body": "昼間正午先生、こんにちは。\n先生の作品を拝見するたびに、キャラクターの表情や動きの豊かさに惹かれています。色使いやシンプルな背景との組み合わせもとても美しく、画面全体がすっきりとして清涼感があり、本当に素敵だと感じます。ぜひ先生に私のオリジナルキャラクターを描いていただきたく、ご依頼させていただきました。\n\n■キャラクター紹介\n32歳／182cm\n犯罪心理学の教授。知的で落ち着いた雰囲気を持ち、礼儀正しく穏やかに人と接します。しかし過去に抱えた重荷があり、大切な家族や現在の生活を失いたくない思いから秘密を守り続け、内心では大きな葛藤と自己受容の苦しみを抱えています。外見や態度は成熟し信頼できる人物に見えますが、その裏には孤独や疲弊が潜んでいます。\n\n■ご依頼内容\nオリジナルキャラクターのイラストを1枚お願いいたします。ポーズ、構図、衣装はすべて先生にお任せいたします。人前で見せる穏やかで頼れる姿でも、私生活での疲れや苦悩をにじませた姿でも、どちらを描いていただいても大変嬉しいです。\n\n■注意事項\n左耳にルーン文字「ᚺ」のイヤリングをつけています。\n\n■参考資料\nhttps://drive.google.com/drive/folders/1ctnlo5U5BxLoeJX62hT51_MldEYZqFmF\n\n■使用用途\n個人利用を目的としており、今後Skebでの依頼参考として使用する可能性があります。\n\nもしご提示金額と合わない場合は、先生のご都合に合わせて金額をご指定いただければ再送いたします。\nこの度ご縁をいただけますと大変嬉しく思います。どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hiruma_shogo/works/80", "thumbnail_src": "https://si.imgix.net/28628c5e/uploads/origins/698944f7-0321-4560-8a59-ad995d1db627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a41460dc685996ed47c93c31c82f134", "thumbnail_srcset": "https://si.imgix.net/28628c5e/uploads/origins/698944f7-0321-4560-8a59-ad995d1db627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a41460dc685996ed47c93c31c82f134, https://si.imgix.net/28628c5e/uploads/origins/698944f7-0321-4560-8a59-ad995d1db627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c775de6ad990210a20d6f92627c29e4a 2x, https://si.imgix.net/28628c5e/uploads/origins/698944f7-0321-4560-8a59-ad995d1db627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c21d7171a69c9e2d526d9e976e467b86 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hiruma_shogo/works/79", "thumbnail_src": "https://si.imgix.net/34386c47/uploads/origins/424a4a94-5b61-46af-bcc4-ef31bdb741d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a12911367e98112e50cd14b4288b8c65", "thumbnail_srcset": "https://si.imgix.net/34386c47/uploads/origins/424a4a94-5b61-46af-bcc4-ef31bdb741d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a12911367e98112e50cd14b428