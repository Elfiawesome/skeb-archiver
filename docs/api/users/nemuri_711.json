す。もし男性キャラクターとして描くことに不安がある場合は、平胸の女性として表現していただいても構いません。\n【使用用途】 個人コレクションとして大切にします。また、完成した作品をSNS（Twitter、Instagram）に掲載させていただく可能性がございます。\nご多忙のところ最後までお読みいただき、誠にありがとうございます。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14kYJ6_aQHFhWgCWooWWDoLNyspvpsTNb", "created_at": "", "completed_at": ""}, {"path": "/@nemuri_711/works/6", "thumbnail_src": "https://si.imgix.net/a8cd0692/uploads/origins/16142ae2-0708-4bf3-8e6d-666a34abfb14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1aeb9deccbcad78358af39f7bf918bd", "thumbnail_srcset": "https://si.imgix.net/a8cd0692/uploads/origins/16142ae2-0708-4bf3-8e6d-666a34abfb14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1aeb9deccbcad78358af39f7bf918bd, https://si.imgix.net/a8cd0692/uploads/origins/16142ae2-0708-4bf3-8e6d-666a34abfb14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dab765203e77e130ff48fb502a295990 2x, https://si.imgix.net/a8cd0692/uploads/origins/16142ae2-0708-4bf3-8e6d-666a34abfb14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b7687bd2adfdf55e3007e56f03858c9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}