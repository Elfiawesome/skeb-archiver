c3-aeea-055af46a729e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5cd864f63eb502b2c69803ad09148aa", "thumbnail_srcset": "https://si.imgix.net/0f1d210c/uploads/origins/786c1f64-f43f-41c3-aeea-055af46a729e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5cd864f63eb502b2c69803ad09148aa, https://si.imgix.net/0f1d210c/uploads/origins/786c1f64-f43f-41c3-aeea-055af46a729e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c29fb5bbb8f68a53908aebb61b2c9c7 2x, https://si.imgix.net/0f1d210c/uploads/origins/786c1f64-f43f-41c3-aeea-055af46a729e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79c9bbad3f2ae1d86685f44c65333fca 3x", "genre": "art", "nsfw": true, "body": "2434の星川サラをお願いします。\n\n洗脳されて闇配信サイトで金儲けのために配信させられる\nバニーガール風衣装(露出度おまかせ)\n鼻フック\n\nセリフ素案\n・はーい！今日も鼻フック一番豚！豚川サラでーす！\n・星川…じゃなかった、豚川が人間じゃなくて豚だったことに気づかせてくれたご主人様のために精一杯頑張ります！\n・豚川にしてほしいことあったらスパチャで…あっ、○○さん早速ありがとうございまーす♡えーっと？「豚が人間の言葉を喋るな」…\n・はいっ！豚の分際で人間様の真似をしてしまい大変申し訳ありませんでしたっ！フゴッ！フゴフゴッ♡\n\nその他の要素はお任せします。\nよければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@6FHSHjvT12/works/191", "thumbnail_src": "https://si.imgix.net/6136bd7d/uploads/origins/873ab181-9e8e-4adc-adeb-a2ed7ea67661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=476a757c6db60916d2f3edad19c05c4e", "thumbnail_srcset": "https://si.imgix.net/6136bd7d/uploads/origins/873ab181-9e8e-4adc-adeb-a2ed7ea67661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=476a757c6db60916d2f3edad19c05c4e, https://si.imgix.net/6136bd7d/uploads/origins/873ab181-9e8e-4adc-adeb-a2ed7ea67661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fd5fc4d65232289f3dbacb5e447f9a9 2x, https://si.imgix.net/6136bd7d/uploads/origins/873ab181-9e8e-4adc-adeb-a2ed7ea67661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=796b613d9340993ee174dc700ca6823c 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\n以前描かれていた四肢収納リングを依頼したいです\nhttps://www.fanbox.cc/@mashingehyul/posts/7580691\n\n誘拐したライバーを四肢収納リングで腹パンサンドバッグ兼オナホに加工、吊るして飾ってる\n首輪に繋がれた縄で吊るされてるが魔法の力で命に影響はなく、絞首の苦痛も快楽に変換される\nオナホに相応しい肉々しい体に改造されてる\n口枷と鼻フックを着けられてる\n\n真正面の構図\n後から追加で並べられるように\n\n上から優先的に可能な人数お願いします\nリゼ・ヘルエスタ\n星川サラ\n栞葉るり\nフレン・E・ルスタリオ\n\nよろしければお願いします", "created_at": "", "completed_at": ""}, {"path": "/@6FHSHjvT12/works/190", "thumbnail_src": "https://si.imgix.net/80c55fba/uploads/origins/a368562d-b69a-4570-839a-e5a23a0a008f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b380a6f9189cb9ea26df083602e17ad", "thumbnail_srcset": "https://si.imgix.net/80c55fba/uploads/origins/a368562d-b69a-4570-839a-e5a23a0a008f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b380a6f9189cb9ea26df083602e17ad, https://si.imgix.net/80c55fba/uploads/origins/a368562d-b69a-4570-839a-e5a23a0a008f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d43003d24410f5a90e5a50e51862c4fb 2x, https://si.imgix.net/80c55fba/uploads/origins/a368562d-b69a-4570-839a-e5a23a0a008f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f4e1b3efeec3c6eff3ab2b3e6c8560f 3x", "genre": "art", "nsfw": true, "body": "にじさんじの山神カルタさんが「セックス・中出しがダンス練習になる」と思い込まされている常識改変シチュをお願いします。\n前回依頼させていただいた↓の内容の続きのイメージでお願いしたいです。\nhttps://skeb.jp/@6FHSHjvT12/works/178\n制服衣装の髪型で、今回は全裸で、陰毛・落書き・鼻フック等は無しでお願いします。\n(何度か中出しされた後)「中々フィニッシュ合わないね～…今度はやまが動いて気持ちいい所に当てるから、君も合わせてね！」と、騎乗位で挿入し、激しく腰を振る。\n絶頂と同時に中出しされ「感覚忘れない内に、もう一回しようね」で終了。\nご検討、よろしくお願いします。\n\nhttps://x.com/Karuta_Yamagami/status/1847230643304026235", "created_at": "", "completed_at": ""}, {"path": "/@6FHSHjvT12/works/189", "thumbnail_src": "https://si.imgix.net/dc0defc9/uploads/origins/a784c23c-4bec-4a9f-9683-f71e5ba1ecf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=031704dfa9b572e90ccbeba344214820", "thumbnail_srcset": "https://si.imgix.net/dc0defc9/uploads/origins/a784c23c-4bec-4a9f-9683-f71e5ba1ecf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=031704dfa9b572e90ccbeba344214820, https://si.imgix.net/dc0defc9/uploads/origins/a784c23c-4bec-4a9f-9683-f71e5ba1ecf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efec67d057929e0ab2df41b6b0594c78 2x, https://si.imgix.net/dc0defc9/uploads/origins/a784c23c-4bec-4a9f-9683-f71e5ba1ecf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=554c357cc63c237391d9d9df762f637c 3x", "genre": "art", "nsfw": true, "body": "催眠モノで依頼させて頂きます。\n\nキャラ：\n元にじさんじの安土桃(新デザ姿)\n\nシチュ：\nフルネルソンの状態でアナルにはめられており、\n催眠を掛けられ道でトイレをするのもフルネルソンをされた状態ですることも当たり前とされおしっこを当然のように行い、\nまた自身の尻穴もトイレとして提供することも当然なのでおしっこを注がれている。\n表情は無意識に羞恥心で赤面しておりアナルはめで感じてもいる。\n道でおしっこすることや尻穴におしっこすることなどを尋ねられ答えている描写も入れて頂きますと幸いです。\n\n以上よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@6FHSHjvT12/works/188", "thumbnail_src": "https://si.imgix.net/6d9635d4/uploads/origins/21d135e0-a2a4-4f31-b689-31b0bf3d6943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=892b293fa4e6c78a1f40c85d79cd43d1", "thumbnail_srcset": "https://si.imgix.net/6d9635d4/uploads/origins/21d135e0-a2a4-4f31-b689-31b0bf3d6943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=892b293fa4e6c78a1f40c85d79cd43d1, https://si.imgix.net/6d9635d4/uploads/origins/21d135e0-a2a4-4f31-b689-31b0bf3d6943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d67c5049ee6292b10fe8288199bfbc2 2x, https://si.imgix.net/6d9635d4/uploads/origins/21d135e0-a2a4-4f31-b689-31b0bf3d6943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&tx