n=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31241d117d2d9ddecbfadb6986ce6cc8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sokytk2/works/49", "thumbnail_src": "https://si.imgix.net/555dbf24/uploads/origins/f6d2428f-cdb4-454d-a452-7a9d2508d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=039afc4b9a35ce8ba91c30779a965bdc", "thumbnail_srcset": "https://si.imgix.net/555dbf24/uploads/origins/f6d2428f-cdb4-454d-a452-7a9d2508d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=039afc4b9a35ce8ba91c30779a965bdc, https://si.imgix.net/555dbf24/uploads/origins/f6d2428f-cdb4-454d-a452-7a9d2508d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c38a113b43e531b90cc50e3a312170 2x, https://si.imgix.net/555dbf24/uploads/origins/f6d2428f-cdb4-454d-a452-7a9d2508d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9f57adcc580031d88f0e427c553689a 3x", "genre": "art", "nsfw": false, "body": "柳ゆうと様\n\nいつもステキなイラストを拝見させていただいております。\nこの度、スケブのご機会を頂くことができ大変うれしく思います。\n是非、柳様にスケブをお願いできればと思い、創作キャラクターの設定を準備してみました…！\n差し支えなければ、創作キャラクターのリクエストをお願いできますと幸いです。\n---\n[ジャンル]\nオリジナル創作キャラクター\n[キャラクター名]\nソニア（女性キャラ）/身長:170cm程\n[参考URL]\nhttps://cyanoooon.tumblr.com/post/711583135862767616/\n[構図など]\n柳様の描きやすい構図にてお願いできますと幸いです。\n---\nお忙しい中、大変恐縮ではございますが、\nご検討頂けますと幸いです。\n何卒、よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@sokytk2/works/48", "thumbnail_src": "https://si.imgix.net/7cc271a5/uploads/origins/9c9713e2-c8e2-404f-92e1-d085d0a1d90d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b9a1f5be673db1009d560e37c6ece8b", "thumbnail_srcset": "https://si.imgix.net/7cc271a5/uploads/origins/9c9713e2-c8e2-404f-92e1-d085d0a1d90d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b9a1f5be673db1009d560e37c6ece8b, https://si.imgix.net/7cc271a5/uploads/origins/9c9713e2-c8e2-404f-92e1-d085d0a1d90d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd3d8ee431d643158a48b9a1f70fe25f 2x, https://si.imgix.net/7cc271a5/uploads/origins/9c9713e2-c8e2-404f-92e1-d085d0a1d90d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38eb29e629af498a632329f5c7d70efc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sokytk2/works/47", "thumbnail_src": "https://si.imgix.net/8b4283ba/uploads/origins/5cf6712f-a901-4ab5-a4d8-eb47b69d031b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=384fa4ceff5f43101e9d042dae37b947", "thumbnail_srcset": "https://si.imgix.net/8b4283ba/uploads/origins/5cf6712f-a901-4ab5-a4d8-eb47b69d031b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=384fa4ceff5f43101e9d042dae37b947, https://si.imgix.net/8b4283ba/uploads/origins/5cf6712f-a901-4ab5-a4d8-eb47b69d031b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd047ffdcf6ca20b1b757431aed5a68e 2x, https://si.imgix.net/8b4283ba/uploads/origins/5cf6712f-a901-4ab5-a4d8-eb47b69d031b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=145491111e06979156219d8d97ada5e5 3x", "genre": "art", "nsfw": false, "body": "初めまして、ゆうと先生の絵が好きでご依頼に来ました！ 今回は私のオリジナルキャラクター三人の日常を漫画になりたいの提案です。\n\n  設定について：\n この三人は実、並行世界の同じ人です。でも元の居場所は終焉を迎え、終わり前の瞬間で 今の世界に飛び込みました、原因は不明。名前は同じ「梅野」を認識されて同時に、 「１号」「２号」「３号」でお互いを呼べます。 残念ながら、この世界も既に何もなかった、他の人はいません。 奇妙なのは、この世界に生まれたAI達が人間の真似をして、不思議な文明を維持しています。 三人は生きるため、廃墟の中で屋敷を作る、毎日AI達と過ごしている、同時にこの世界に来た理由を探しています。  \n\n「１号」 最初でこの世界に来た「梅野サクラ」、いつも元気満々で乱暴なロボット娘。AI達と仲良くして諜報収集の担当者。 \n\n「２号」 次にこの世界に来た「梅野玄太郎」、前の世界て傭兵をやっています。いつも「面倒くせぇぇ」の顔で危険な AI達を倒すの担当者。\n\n 「３号」 最後に来た「梅野メイ」、実は何回の終焉を知り、年齢は千歳を超え、何故か子供の姿でこの世界に来た。いつも屋敷で情報整理の担当者。ロリババアの性格が持てる（「ワシ」と「のじゃ」の喋方が好き）  \n\n今回ほしいストーリーは： 三人は水のような敵と戦い、ポーズと顔はお任せします、場所は廃棄の都市的な場所でおk。できれば漫画連載第一回最後のページの雰囲気でお任せします！\n\n  今後vtuberになるかもしれませんの三人なので、SNSの宣伝用意があります、 どうぞご検討の程よろしくお願いいたします。  \n\nhttps://drive.google.com/drive/folders/1Lsc9H4co_HRzfZwV9PdtjNvuGccz7JDu?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@sokytk2/works/46", "thumbnail_src": "https://si.imgix.net/d47bc6ed/uploads/origins/7aab7053-d97c-4600-b467-07a02b5a587d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ad4d8433e89c32d88e25b6b3baa7483", "thumbnail_srcset": "https://si.imgix.net/d47bc6ed/uploads/origins/7aab7053-d97c-4600-b467-07a02b5a587d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ad4d8433e89c32d88e25b6b3baa7483, https://si.imgix.net/d47bc6ed/uploads/origins/7aab7053-d97c-4600-b467-07a02b5a587d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7ba7f8ebd1137ee698bf9c5bd8581fb 2x, https://si.imgix.net/d47bc6ed/uploads/origins/7aab7053-d97c-4600-b467-07a02b5a587d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94ed627f62af44a943ae2d8804986719 3x", "genre": "art", "nsfw": false, "body": "柳ゆうとさん、はじめまして。Vtuberの月夜猟介と申します。\n今回はカラーイラストのリクエストは受け付けておりますでしょうか？もし募集されていましたら、ぜひ自身のカラーイラストを描いていただきたく、リクエストをさせていただきます。\n\n【ご依頼したい内容】\nキャラクター：月夜猟介(下記に参考画像URLを添付いたします)\n衣装：上半身は白のタンクトップ、下半身は参考資料内にある豹柄のボクサーパンツでお願いします。\n表情、ポーズ、構図、背景など：\n朝起き抜けに鏡に向かって、T字カミソリで顎の髭剃りをしている月夜猟介のイラストを描いていただきたいです。顎にクリームを塗り顎髭を剃っている途中で、顎鬚はクリームでほぼ見えないもしくはよく見れば少しだけ生えている程度でOKです。口髭はなしで、鼻下のクリームも無しでお願いします。前髪は少しかき上げたような感じになっていると嬉しいです。\n描画範囲は膝もしくは腰から上の範囲で、パンツが少しでも含まれるような構図でお願いしたいです。腕や肩、胸や首などの筋肉を強調した、セクシーで男らしいイラストに描いていただきたいです。そのほかについてはお任せとさせてください。\nもし予算内で可能であれば、上半身のタンクトップをoffした差分もいただけると嬉しいです。\n\n下記の使用用途のため、キャラクターの上と左右(髪や腕など)はできる限り途切れていないと助かります(可能な範囲で構いません)。またキャラクターと、背景やサインなどは別レイヤーに分けていただけると大変助かります。\n\n〇使用用途：SNSのアイコンや告知画像、Youtube等の配信やそのサムネイルでの使用などを考えております。そのほかもし可能であれば個人観賞用に印刷をする許可もいただければ嬉しいです(頒布・販売等は致しません。難しければ大丈夫です)。\n\n〇形式など：psd形式でいただけると嬉しいです。\n\n〇参考画像： Twitterアカウントとgoogle driveを記載いたします。\n①https://twitter.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sokytk2/works/45", "thumbnail_src": "https://si.imgix.net/fc038243/uploads/origins/7bf5c56c-bbf1-48e1-8f46-2c50c8a2642b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76980e5f91d97eaf937e10765b2d2c77", "thumbnail_srcset": "https://si.imgix.net/fc038243/uploads/origins/7bf5c56c-bbf1-48e1-8f46-2c50c8a2642b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76980e5f91d97eaf937e10765b2d2c77, https://si.imgix.net/fc038243/uploads/origins/7bf5c56c-bbf1-48e1-8f46-2c50c8a2642b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9806e5dca5d475144e85d600c1a650ef 2x, https://si.imgix.net/fc038243/uploads/origins/7bf5c56c-bbf1-48e1-8f46-2c50c8a2642b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3758eb8bcc783234d1de1bf5fe6b9383 3x", "genre": "art", "nsfw": false, "body": "こんにちわ！\n前回は、とてもかっこ良くてセクシーなMAXIMAをありがとうございました！\nもしも希望が叶うなら、今回もリクエストをしたい思います。\nよろしくお願いします。\n書いて欲しいキャラクターは、日本の人気アニメであるSLAMDUNKに登場する牧紳一という人物です。\nこのキャラクターは、髪形が２種類あります。髪の毛をオールバックのようなしているものと、髪を下ろしているものです。\nどちらでも書きやすい方を選んでください。\n衣装は試合のユニフォームを着せてもらえると嬉しいです。\n表情は、試合の最中のような、凛々しい表情が素敵です。\nもしも可能であるとすれば、横顔よりも顔が全体が見えるものだと嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sokytk2/works/44", "thumbnail_src": "https://si.imgix.net/a0e57b4a/uploads/origins/03d27cbb-cd61-4552-bc34-f64fde1dcf29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s