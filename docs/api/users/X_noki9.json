c0-bc50-70904c853251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85ee46ca1975d39868ca37227c522a6c, https://si.imgix.net/62313e21/uploads/origins/3174e61a-157e-41c0-bc50-70904c853251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90c9aef2c0b83ea091a39bb5e39af096 2x, https://si.imgix.net/62313e21/uploads/origins/3174e61a-157e-41c0-bc50-70904c853251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f0e17d8795d16cff0ded1b3937a5591 3x", "genre": "art", "nsfw": false, "body": "小人さんが、あくびで大きく開いた明麗ちゃんのお口をのぞいているイラストをお願いします！\n\n小人さんは明麗ちゃんの口元(下唇の真ん中付近)にいて、\n明麗ちゃんが布団で横になった状態で大欠伸している感じの姿勢です。\n\nイラストは2コマ構成で\n\n1コマ目は\n大きなお口を開けて大欠伸している明麗ちゃんを上から見た様子。\n描く範囲は顔から布団を被った胸付近まででお願いします。また、口元には先述したように小人さんがいる描写もお願いします。\n\n2コマ目は\n小人さんから見えている景色。\n資料URLの「喉」と書かれた画像のような構図で喉穴がはっきりと見えている明麗ちゃんのお口の中をコマいっぱいに描いて欲しいです！\n\nまたお口ネタで申し訳ないですが、よろしくお願いします！\n\nhttps://x.com/zivavorefan/status/1884197995991957707?s=46&t=EvkjwesGN-bdahugIKUCcQ", "created_at": "", "completed_at": ""}, {"path": "/@X_noki9/works/75", "thumbnail_src": "https://si.imgix.net/2f96dde9/uploads/origins/fca80f0c-8cd5-4d86-bad5-ed40a0819e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf142a23cc281e19b4187eeb8d8a57e1", "thumbnail_srcset": "https://si.imgix.net/2f96dde9/uploads/origins/fca80f0c-8cd5-4d86-bad5-ed40a0819e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf142a23cc281e19b4187eeb8d8a57e1, https://si.imgix.net/2f96dde9/uploads/origins/fca80f0c-8cd5-4d86-bad5-ed40a0819e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87b6cea4d18f49d6ab249197e9090cff 2x, https://si.imgix.net/2f96dde9/uploads/origins/fca80f0c-8cd5-4d86-bad5-ed40a0819e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=508e4cbeba37062f12bff69372ac3293 3x", "genre": "art", "nsfw": true, "body": "ラブライブ!蓮ノ空スクールアイドルクラブの徒町小鈴が女児制服とランドセル姿で防犯ブザーと帽子をつけながら男の人(20代半ば以上、4,50代も可)と対面座位(男の人視点)でエッチして気持ちよくなってるイラストをお願いします。\nシチュエーションはエッチしてみたい小鈴がハタチと偽って男の人(幼く見える成人女性を探していた)に会い、男の人の頼みで小学生姿(+子ども下着)になってエッチする感じです。\n男の人は(会う前から幼く見えるとは思っていたものの)小鈴が思ってた以上に幼く見えた上に小学生とエッチしてる気分になっているため(元々、小学生とエッチしてみたかったのもある)、かなり興奮して必死に犯しており、小鈴もその姿でいるのもあいまって、必死に犯されて気分的にもかなり気持ちよくなってる感じで描いてくだされば嬉しいです。\n小鈴の身体は未成熟な感じで、胸はぺったんこか膨らみかけぐらいで、できるだけ幼く見える感じでお願いします。\n場所や描き方に関してはお任せします。\n\nあと、前述のハタチと偽ってる部分がわかるようにお願いします。\n(エッチしている最中の会話や会う前のDMなどのやり取り\n男「ホ、ホントに20歳…？」\n小鈴「ハタチです♡」)\n(内容は追加したり、ある程度改変しても大丈夫です)\n\n他にも描いてみたいものがあれば自由にお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@X_noki9/works/74", "thumbnail_src": "https://si.imgix.net/a559fa76/uploads/origins/9834e35d-10d3-43bc-ac35-496f8e7ccf25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=797b21a3dc2248ad64eeff24a14749e6", "thumbnail_srcset": "https://si.imgix.net/a559fa76/uploads/origins/9834e35d-10d3-43bc-ac35-496f8e7ccf25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=797b21a3dc2248ad64eeff24a14749e6, https://si.imgix.net/a559fa76/uploads/origins/9834e35d-10d3-43bc-ac35-496f8e7ccf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d3e1cd187c58754dd01ed45724f7b65 2x, https://si.imgix.net/a559fa76/uploads/origins/9834e35d-10d3-43bc-ac35-496f8e7ccf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71d86f113e30d249b703b6e487f2b59a 3x", "genre": "art", "nsfw": true, "body": "小林さんちのメイドラゴンのカンナちゃんのえっちなイラストをお願いします。\n\n・シチュとしてはすやすや寝てるカンナちゃんを犯しながら中出ししているところ。\n・構図としては正面からか一人称視点で。\n・服装としてはいつもの私服からぱんつとスカートを脱がせた状態で、角としっぽは有りでお願いします。\n・その他として断面図を横に添えていただいて、おちんちんは根元まで挿入して中出ししているような感じでお願いします。\n\n良かったらお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@X_noki9/works/73", "thumbnail_src": "https://si.imgix.net/21a3d396/uploads/origins/2925003a-a7f9-47c1-8bf9-6b4ad6717c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVA