らパンツが見えているイラストをお願いします。\n・いずれのイラストもパンツが見えていることに気づき焦るアオイちゃんをお願いします。\n　グルグル目・恥ずかしそうな表情でお願いします。\n・パンツの色、柄はおまかせしますが、アオイちゃんはボッチ・13歳という設定のため、\n　そのキャラ設定にあったパンツでお願いします。\n・上記で指定したこと以外に関してはおまかせします。\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tanakaminos/works/40", "thumbnail_src": "https://si.imgix.net/c7a42b9b/uploads/origins/862ab7ed-5375-44b2-9284-ac8791e3b920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=098c9b1cbf54596a4dc1325b3f4c44ab", "thumbnail_srcset": "https://si.imgix.net/c7a42b9b/uploads/origins/862ab7ed-5375-44b2-9284-ac8791e3b920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=098c9b1cbf54596a4dc1325b3f4c44ab, https://si.imgix.net/c7a42b9b/uploads/origins/862ab7ed-5375-44b2-9284-ac8791e3b920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67fb2cd8c0eaa33b62535ed8020d6de5 2x, https://si.imgix.net/c7a42b9b/uploads/origins/862ab7ed-5375-44b2-9284-ac8791e3b920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17dd0704f0aafd550e698c5775bf0917 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tanakaminos/works/39", "thumbnail_src": "https://si.imgix.net/e210d1f7/uploads/origins/ab06c698-e9b4-462f-8d2a-1395d0d05702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00379a5f90557c1640daa2ffa8866504", "thumbnail_srcset": "https://si.imgix.net/e210d1f7/uploads/origins/ab06c698-e9b4-462f-8d2a-1395d0d05702?bg=%2