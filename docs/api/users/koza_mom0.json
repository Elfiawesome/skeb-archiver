-31cef54e3e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d27f3600ff089354ba0e9ab028da08e1 3x", "genre": "art", "nsfw": false, "body": "はじめまして。いつも素敵なイラスト拝見しております。\n\nもしよろしければ私が普段SNSで使用している、おさげ髪と赤いリボン、赤い目が特徴のオリジナルキャラクターを描いて頂けますでしょうか。\nテーマとしては春を意識した感じでお願いしたいです。キャラクターの衣装や詳細な点についてはおまかせいたしますので、かわいい感じにして頂けますと幸いです。\n使用用途としては、私のSNSアカウントのプロフィール画像として使用させて頂きたい他に、私的利用として壁紙やSkebの印刷してお届け機能を使用させて頂きたいです。\n\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/7KbV8fHBbLVxve697", "created_at": "", "completed_at": ""}, {"path": "/@koza_mom0/works/36", "thumbnail_src": "https://si.imgix.net/35e2416f/uploads/origins/af265c59-2039-4552-9372-5a28a8b4f3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e09c8bf19ab0c627b32356d5c541f2b8", "thumbnail_srcset": "https://si.imgix.net/35e2416f/uploads/origins/af265c59-2039-4552-9372-5a28a8b4f3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e09c8bf19ab0c627b32356d5c541f2b8, https://si.imgix.net/35e2416f/uploads/origins/af265c59-2039-4552-9372-5a28a8b4f3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45e497425f54f333f41269abe7c7db60 2x, https://si.imgix.net/35e2416f/uploads/origins/af265c59-2039-4552-9372-5a28a8b4f3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=faacf4c7b72b6359429494e6935e2864 3x", "genre": "art", "nsfw": false, "body": "いつもイラストを楽しみにしています！\n\n今回は前と別なアバターのコニカちゃんをお願いします。\nデフォルメ体型の子なので、頭身が高くなっても大丈夫です。\nむしろ描きやすい形で描いて頂ける方がありがたいです！\n(実際長身もあります)\n\n構図などは今まで通りこざくらさんにお任せしたいです……！\n\nhttps://drive.google.com/drive/folders/1ex9jIoz4_uuqBn4XvZQvqRDSR0SQzWYL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@koza_mom0/works/35", "thumbnail_src": "https://si.imgix.net/0e6c1a9c/uploads/origins/2c7671fa-2822-40a3-897b-77eb1cde7c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa36d4362d782ab48b76a43b7da1d1b6", "thumbnail_srcset": "https://si.imgix.net/0e6c1a9c/uploads/origins/2c7671fa-2822-40a3-897b-77eb1cde7c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa36d4362d782ab48b76a43b7da1d1b6, https://si.imgix.net/0e6c1a9c/uploads/origins/2c7671fa-2822-40a3-897b-77eb1cde7c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57f9e4183bf834185a5a66784fc343ef 2x, https://si.imgix.net/0e6c1a9c/uploads/origins/2c7671fa-2822-40a3-897b-77eb1cde7c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62a88d6ec70970e4e4f3a5cf67614e2e 3x", "genre": "art", "nsfw": false, "body": "こざくら先生！先日はとてもかわいいイラストをありがとうございました。\nとても気に入ったため再度リクエストさせていただきます。\n\n今回は新衣装のわたしを描いていただきたいです。三面図をお付けします。\n構図やポーズはお任せします。\n等身はお姉さんになりすぎないようご留意いただけますと幸いです。\n\n三面図をお付けします。\n\n百瑠璃せいらんのプロモーション全般（SNSでの投稿や配信・動画のサムネイル・ファンクラブ特典・ネップリ配布・販売用グッズ等）に使用させていただきます。\n\n--\n\n身長　152cm\n年齢　18歳（見た目は15歳ぐらい）\n種族　人間\n\n見た目\n・髪色のグラデーション\n・前髪のばってんくせ毛\n・アホ毛\n・←目の下のホクロ\n・瞳の中のお花\n・髪飾りに乗っている鳥さんはどこかに入れてほしい（生きてます！）\n・胸は控えめで太ももはむっちり\n\nキャラクター\n・アイドル見習い\n・清らかで明るい\n\nhttps://www.dropbox.com/scl/fo/5udd243n80sqxbzq81wsb/AO4RDR-0wT6uIgZ_J8B7na4?rlkey=u9kawi606w5q0uhm6xyjydsyb&st=khu9ubw4&dl=0\n\nhttps://www.dropbox.com/scl/fo/5udd243n80sqxbzq81wsb/AO4RDR-0wT6uIgZ_J8B7na4?rlkey=u9kawi606w5q0uhm6xyjydsyb&st=khu9ubw4&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@koza_mom0/works/34", "thumbnail_src": "https://si.imgix.net/379eb7ac/uploads/origins/41467e81-2405-47fe-9eb0-2cf4330cab24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=129fa1de7fe07fb747924d15882cd176", "thumbnail_srcset": "https://si.imgix.net/379eb7ac/uploads/origins/41467e81-2405-47fe-9eb0-2cf4330cab24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=129fa1de7fe07fb747924d15882cd176, https://si.imgix.net/379eb7ac/uploads/origins/41467e81-2405-47fe-9eb0-2cf4330cab24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3d1890bb48e6772e5d03af8a5b0ea07 2x, https://si.imgix.net/379eb7ac/uploads/origins/41467e81-2405-47fe-9eb0-2cf4330cab24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91591a19583f99c6e043ca04dbc95b53 3x", "genre": "art", "nsfw": false, "body": "はじめまして！ \n🌸👼こざくら👼🌸様の描く絵が本当に大好きで、ぜひご依頼したいと思い、リクエストを送らせてもらいました。 私のキャラクターを描いていただきたいです。  \n\n【参考資料】 https://drive.google.com/drive/folders/1yzIGYgVK6tHsjwu-kuy6TRG6zGCLxu30 \n\n ポーズや表情はおまかせしますが、お嬢様な雰囲気を出してもらいたいです。\n東方ダンマクカグラのキャラクターイラストのような全身絵と背景を描いて頂けると嬉しいです。\nキャラクターのイメージは「魔法」「宝石」「お姫様」「リボン」です。\n\n お忙しい中恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yzIGYgVK6tHsjwu-kuy6TRG6zGCLxu30", "created_at": "", "completed_at": ""}, {"path": "/@koza_mom0/works/33", "thumbnail_src": "https://si.imgix.net/ece95de5/uploads/origins/a9579c4e-aa5d-4dbb-b199-7bfc8b33d344?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c46f6116c106dca8712c8baf2d9db054", "thumbnail_srcset": "https://si.imgix.net/ece95de5/uploads/origins/a9579c4e-aa5d-4dbb-b199-7bfc8b33d344?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c46f6116c106dca8712c8baf2d9db054, https://si.imgix.net/ece95de5/uploads/origins/a9579c4e-aa5d-4dbb-b199-7bfc8b33d344?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=579088555e17adb54c9a2d8350ef9b61 2x, https://si.imgix.net/ece95de5/uploads/origins/a9579c4e-aa5d-4dbb-b199-7bfc8b33d344?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12c5487ee6761ccfba84ad01854e6451 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n個人Vtuberの百瑠璃せいらんと申します。\n以前よりこざくら先生のイラストを拝見しており、今回のSkeb開放を心待ちにしておりました！私自身を描いていただきたくリクエストさせていただきます。\n\n衣装や構図、ポーズはおまかせします。\n15歳ぐらいの見た目で等身低めなのでご留意いただけますと幸いです。\n\n【キャラクター】\n・18歳 152cm アイドル見習い\n・清らかで明るい性格\n・少し寂しがり屋\n・青と水色と可愛いものが好き\n・食いしん坊\n\n【見た目の特徴】\n・髪色のグラデーション\n・前髪のばってんくせ毛\n・アホ毛\n・←目の下のホクロ\n・瞳の中のお花\n・髪飾りに乗っている鳥さんはどこかに入れてほしい（生きてます！）\n・胸は控えめで太ももはむっちり\n・手元が映る場合は三面図に載っているネイルを描いていただけると嬉しい\n\n使用範囲は百瑠璃せいらんのプロモーション全般（SNSでの投稿や配信・動画のサムネイル・ファンクラブ特典・ネップリ配布等）です。\n\n納品はPNGかPSDデータでおねがいできますでしょうか。その際、人物のみレイヤーもいただきたく、髪の横や頭の上部分も描画していただけますとサムネイル等に使用しやすくとても有難いです。\n\n何卒ご検討の程よろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/safz8o8rwja0gz2xpzxg1/ALdlJvvlaqWoFn3hIiBCRkw?rlkey=gpo19jvha3vmij1q9shvrxr2h&st=shay0mbz&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@koza_mom0/works/32", "thumbnail_src": "https://si.imgix.net/f182d5d6/uploads/origins/f4061e7e-71b3-42ff-944c-988055913924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4316ba0a7792a886c560ba4ff650bfc3", "thumbnail_srcset": "https://si.imgix.net/f182d5d6/uploads/origins/f4061e7e-71b3-42ff-944c-988055913924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4316ba0a7792a886c560ba4ff650bfc3, https://si.imgix.net/f182d5d6/uploads/origins/f4061e7e-71b3-42ff-944c-988055913924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4abc6374eef56dddf3dcacc4611c758a 2x, https://si.imgix.net/f182d5d6/uploads/origins/f4061e7e-71b3-42ff-944c-988055913924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81f595ac1c3a8c53ec368c4041f78bf6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回のリクエストのうちの子たちの素敵なイラスト、本当にありがとうございます！\n\nもしよろしければ、今回もうちの子たちのイラストをお願いできますか？\n今回は「シューティングゲームVer.」の衣装でお願いしたいです！\n基本的に銃器類は一切表現されていないか、ケースだけ表現される方向もOKなので、楽な方向で自由に表現していただければ幸いです！\nその他にも難しい部分があれば自由にアレンジしてくださってもいいですよ！\nポーズや表情などの細かいことはお任せします！\n\n今回もご縁になりましたら、よろしくお願いいたします！\n\n\n▷Cream\nhttps://drive.google.com/drive/folders/1zwrfsEverL18kGwBuP1VkqdMSRUazkaG\n\n▷Mary\nhttps://drive.google.com/drive/folders/1XjUG5ISpTnzEVbT_xScCpYO4rAGIBRxO", "created_at": "", "completed_at": ""}, {"path": "/@koza_mom0/works/31", "thumbnail_src": "https://si.imgix.net/3fd192e3/uploads/origins/97a1ab2a-0095-4f41-98cb-11a9421fd992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce5c44f5e8e6dc876c7b688690c7f7e", "thumbnail_srcset": "https://si.imgix.net/3fd192e3/uploads/origins/97a1ab2a-0095-4f