1-4c42-94cb-8b1348c4992e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd57796260fdbed65c45c58f72193cde, https://si.imgix.net/9f158787/uploads/origins/2371b932-8641-4c42-94cb-8b1348c4992e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=455728c39c9728ad089ad62fe32f5881 2x, https://si.imgix.net/9f158787/uploads/origins/2371b932-8641-4c42-94cb-8b1348c4992e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c2bb4318c6df2dcd014cb187a936009 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@miyabi_fujieda/works/40", "thumbnail_src": "https://si.imgix.net/ca94b436/uploads/origins/9853bd37-597e-4382-a4d2-fba843eae380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c015e644457d9abb73b042c054b68f77", "thumbnail_srcset": "https://si.imgix.net/ca94b436/uploads/origins/9853bd37-597e-4382-a4d2-fba843eae380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c015e644457d9abb73b042c054b68f77, https://si.imgix.net/ca94b436/uploads/origins/9853bd37-597e-4382-a4d2-fba843eae380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91c4efbf6b3c592674eaa1d5f14c6718 2x, https://si.imgix.net/ca94b436/uploads/origins/9853bd37-597e-4382-a4d2-fba843eae380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d1adbaa4630e7f595e0f9f3127cce7c 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n以前から素晴らしいイラストを拝見していました\nいい機会とおもったのでリクエストしました\n\nキャラクター：早瀬ユウカ、生塩ノア（ブルーアーカイブ）\nシチュエーション：同じベッドで手を繋いで寝ている\n二人ともパジャマ姿で互いに見つめあっている\n\nその他細かい部分はお任せします。\nやりにくい部分があれば変更してもらってかまいません。\nそれでは、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@miyabi_fujieda/works/39", "thumbnail_src": "https://si.imgix.net/80129faa/uploads/origins/a7c8138b-ca6e-456b-be17-2eaa2d1915fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79939d47606e5281ce0a419d6fb97a7f", "thumbnail_srcset": "https://si.imgix.net/80129faa/uploads/origins/a7c8138b-ca6e-456b-be17-2eaa2d1915fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79939d47606e5281ce0a419d6fb97a7f, https://si.imgix.net/80129faa/uploads/origins/a7c8138b-ca6e-456b-be17-2eaa2d1915fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57ed65ca25fe3f9af1b14df3ea38ee41 2x, https://si.imgix.net/80129faa/uploads/origins/a7c8138b-ca6e-456b-be17-2eaa2d1915fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50e23a8e01db4150c8c8aeeca950df83 3x", "genre": "art", "nsfw": false, "body": "以前はAliceQuartetのイメージでの素敵な衣装ありがとうございました！\nぜひ追加で依頼させてください。\n\n個人VTuber「六原小森」さんのイラストをお願いします。\n六原小森さんの見た目、三面図などはツイッターの固定ツイートや画像欄などをご参照ください。\nhttps://twitter.com/666hara_k\n\n【依頼内容】\n・六原小森さんがラジオ収録している場面のイラストを、オリジナルの私服の衣装でお願いします\n  三角形の髪飾りは付けていただきたいです\n・「乙女色StayTune」のような声優さんのスタジオでのラジオ収録のイメージで、ヘッドホンをできれば付けていただきたいですが機種はお好みで大丈夫です。\n  構図や詳細もお任せいたします！\n\n【ご注意事項】\nこちらも前回と同様でお願いいたします。\n・背景と人物が分かれたPSDデータもいただけるとありがたいです。\n・いただいた作品は、私と六原小森さんがSNSやYouTubeのチャンネルのサムネイルで使用する場合があります。\n\nご検討いただければ幸いです。年末はお忙しいと思いますので落ち着いたタイミングでも問題ございません。何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@miyabi_fujieda/works/38", "thumbnail_src": "https://si.imgix.net/20f93745/uploads/origins/c653d379-a6f6-49fc-b4dc-69621752f545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5fca749e27f2a60e361f266910a2082", "thumbnail_srcset": "https://si.imgix.net/20f93745/uploads/origins/c653d379-a6f6-49fc-b4dc-69621752f545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5fca749e27f2a60e361f266910a2082, https://si.imgix.net/20f93745/uploads/origins/c653d379-a6f6-49fc-b4dc-69621752f545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7d2f3a1142653c9a68ef490f875206e 2x, https://si.imgix.net/20f93745/uploads/origins/c653d379-a6f6-49fc-b4dc-69621752f545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd4a5acbf14bc4f832afebca4f4a2679 3x", "genre": "art", "nsfw": true, "body": "藤枝雅先生、予てより『It’s MyGO!!!!!』の睦と祥子のイラストリクエストでお世話になっております。\n今回も同じ二人のイラストをご依頼したいです。\n\nリクエストしたいイラストの内容：祥子の服がはだけていて（もしくは衣服無し）、睦が祥子の胸に直接顔を埋めながら眠り、祥子が眠ってる睦の頭を撫でている。\n\n今回はご依頼内容から肌露出が多くなるためNSFW設定でのご依頼を致しましたが、そういう要素が無い方がイラストを描きやすければ、無くても大丈夫です。\nまた、NSFW要素のあるイラストでも、以前に製作して頂いたイラストと同じようにTwitterなどの藤枝先生が利用されているサイトに掲載して頂いて大丈夫です。\n\n長くなりましたが、またご検討を頂けますようお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@miyabi_fujieda/works/37", "thumbnail_src": "https://si.imgix.net/50db4f32/uploads/origins/16573b08-9665-4c73-8d33-c3832e2794ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5228d53bbd34240fe9992e224adf27c1", "thumbnail_srcset": "https://si.imgix.net/50db4f32/uploads/origins/16573b08-9665-4c73-8d33-c3832e2794ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5228d53bbd34240fe9992e224adf27c1, https://si.imgix.net/50db4f32/uploads/origins/16573b08-9665-4c73-8d33-c3832e2794ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e289b3f2f96c302112a92732c08d9063 2x, https://si.imgix.net/50db4f32/uploads/origins/16573b08-9665-4c73-8d33-c3832e2794ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fe69d849193fc90c1e49aa498dabde8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@miyabi_fujieda/works/36", "thumbnail_src": "https://si.imgix.net/d8dfc0a7/uploads/origins/ee4c1f60-dffa-46f0-8c0e-d2d51ef768c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fc1d8e3c2382a03451da0f605d38ade", "thumbnail_srcset": "https://si.imgix.net/d8dfc0a7/uploads/origins/ee4c1f60-dffa-46f0-8c0e-d2d51ef768c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fc1d8e3c2382a03451da0f605d38ade, https://si.imgix.net/d8dfc0a7/uploads/origins/ee4c1f60-dffa-46f0-8c0e-d2d51ef768c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62713ca009373416417f253042e27ae2 2x, https://si.imgix.net/d8dfc0a7/uploads/origins/ee4c1f60-dffa-46f0-8c0e-d2d51ef768c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a3ff7d87d7f51f3f8d3f8ac6fb6e759 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエストをさせていただきます。\n\n『プリンセス・プリンシパル』という作品に登場するキャラクター、\"アンジェ\"と\"プリンセス\"のふたりがお互いのことを見つめているイラストをリクエストさせていただきます。\nキャラクターの容姿などは公式サイトが参考になるかと存じます。\n\n至らない点があるかもしれませんが、なにとぞご検討いただき、承認していただければ幸いです。よろしくお願いいたします。\n\nhttps://pripri-anime.jp/character/", "created_at": "", "completed_at": ""}, {"path": "/@miyabi_fujieda/works/35", "thumbnail_src": "https://si.imgix.net/d561995f/uploads/origins/f3d033de-6a81-4113-bbcf-2cbc8d69ebe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2042de6825e2d9e26cfb6cdb96d3679", "thumbnail_srcset": "https://si.imgix.net/d561995f/uploads/origins/f3d033de-6a81-4113-bbcf-2cbc8d69ebe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2042de6825e2d9e26cfb6cdb96d3679, https://si.imgix.net/d561995f/uploads/origins/f3d033de-6a81-4113-bbcf-2cbc8d69ebe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c347224930ca5ecfddb2d60b4be200b 2x, https://si.imgix.net/d561995f/uploads/origins/f3d033de-6a8