43a5963c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b90c65ab54af8cd32c6fcbec9642406, https://si.imgix.net/d54ea5a9/uploads/origins/4e234686-fde7-4736-bc4b-03a443a5963c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab831c30847ed68601b38fd747683bea 2x, https://si.imgix.net/d54ea5a9/uploads/origins/4e234686-fde7-4736-bc4b-03a443a5963c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b61eff34e6187da39d71173b97eaf5e 3x", "genre": "art", "nsfw": false, "body": "ひらおさんこんにちは！青木です！\nひらおさんの絵柄が大好きなので、私のocと一緒にぶーちゃんを描いて頂きたくリクエストを送らせて頂きました...！！あまり距離が近くないですが夢絵なのでご不快に思われたらすみません...！！\n \n 資料は↓をご確認ください。\n https://drive.google.com/drive/folders/1ufltXu2oJNZqXLjr69ej7HQh4211HdsZ\n \n 表情や構図などおまかせいたしますので、自由に描いて頂けたらと思います...！！\n\n使用目的は \n\n・SNSでのアイコン \n・iPhoneの壁紙\n・キャラクターの資料\n\nなどを予定しております。\n もしご不快に思われましたらキャンセルして頂いて構いません...！\n お忙しい中恐れ入りますが、ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ufltXu2oJNZqXLjr69ej7HQh4211HdsZ", "created_at": "", "completed_at": ""}, {"path": "/@Boke_Aho_Nara/works/10", "thumbnail_src": "https://si.imgix.net/3f8f88a9/uploads/origins/e7899fad-8642-42c3-a227-f4c10deee5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffefd5ba31d066294f4e2dab416d298", "thumbnail_srcset": "https://si.imgix.net/3f8f88a9/uploads/origins/e7899fad-8642-42c3-a227-f4c10deee5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffefd5ba31d066294f4e2dab416d298, https://si.imgix.net/3f8f88a9/uploads/origins/e7899fad-8642-42c3-a227-f4c10deee5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c2bb35ebc2c847daeb617cafa9e1f4d 2x, https://si.imgix.net/3f8f88a9/uploads/origins/e7899fad-8642-42c3-a227-f4c10deee5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e118c65a0f114b1d4da64f54355b123 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ひらおさん！あなたの絵、特にブートヒル💕💕の大ファンです。私のOCを描いていただけませんか？\n\n自我の強いキツネ男。金持ちのマフィア一家の一員。自分の弱さを人に見せたくないので、とても生意気で迷惑な振る舞いをする。片目しか見えないが、射撃の腕は確かで、スナイパーライフルを使っている。テディベアのようなかわいいものを集めるのが好き。\n\nその他、彼について\n- 身長は175cm。\n- アイパッチなしで描かないでください。\n- 目はつぶらで、白い輝きがない。\n- かわいくもあり、かっこよくもあり...。\n\n自由に描いてください！\n\n何かありましたら、リジェクトでもアピールでも構いません。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13FtFxu1lHSpjdG6rPFG7z1b4jvMyfrzW?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Boke_Aho_Nara/works/9", "thumbnail_src": "https://si.imgix.net/0f4c17de/uploads/origins/4479def3-2dad-4e18-8cd6-c8626ca1b405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc9dec7a230a8781af65f854eb7f1bdc", "thumbnail_srcset": "https://si.imgix.net/0f4c17de/uploads/origins/4479def3-2dad-4e18-8cd6-c8626ca1b405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc9dec7a230a8781af65f854eb7f1bdc, https://si.imgix.net/0f4c17de/uploads/origins/4479def3-2dad-4e18-8cd6-c8626ca1b405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=881bbd84d1398c119e4a971c5d7b54e9 2x, https://si.imgix.net/0f4c17de/uploads/origins/4479def3-2dad-4e18-8cd6-c8626ca1b405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12cf726395fad97e90d51ce48ef3be0f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Boke_Aho_Nara/works/8", "thumbnail_src": "https://si.imgix.net/a4b302cf/uploads/origins/dd4be254-13dd-4c8f-b134-04cce7046c59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05d99a9ea30b88ddf36234d92426cbc2", "thumbnail_srcset": "https://si.imgix.net/