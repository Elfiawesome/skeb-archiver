etsubaki/status/1598069803042111488?s=46&t=dLccmLy76rzIPNEWWDnQBw", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_25f/works/13", "thumbnail_src": "https://si.imgix.net/fdbb2254/uploads/origins/0176d840-b986-427c-9b1c-0b20ccc41c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff3447cb79120bbdd625e64d1a5adbe", "thumbnail_srcset": "https://si.imgix.net/fdbb2254/uploads/origins/0176d840-b986-427c-9b1c-0b20ccc41c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff3447cb79120bbdd625e64d1a5adbe, https://si.imgix.net/fdbb2254/uploads/origins/0176d840-b986-427c-9b1c-0b20ccc41c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb8a63dddf0c200f93bc10ef9acefa0f 2x, https://si.imgix.net/fdbb2254/uploads/origins/0176d840-b986-427c-9b1c-0b20ccc41c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=505859b33bb759da0077979542daae3c 3x", "genre": "art", "nsfw": false, "body": "申し訳ありません、添付するのを忘れていました。\n\nでも、そうなんです、あなたのレトロスタイルのアートでOCキャラのアートを依頼したいんです。\n\nイメージとしては、彼女がフードを下ろし、何かに寄りかかって立っているような感じでお願いします。片方の手を上に伸ばし、側頭部の髪をかき上げながら、幸せそうな表情をしています。\n\nありがとうございました。\n\nhttps://cdn.discordapp.com/attachments/834923516750462996/972953819036123226/skmb_full_25801734.jpg", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_25f/works/12", "thumbnail_src": "https://si.imgix.net/8c0ee869/uploads/origins/c3ba4f8e-2f52-4e63-9060-ec639151055c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a9757c435581a5632606304a1dff5a6", "thumbnail_srcset": "https://si.imgix.net/8c0ee869/uploads/origins/c3ba4f8e-2f52-4e63-9060-ec639151055c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a9757c435581a5632606304a1dff5a6, https://si.imgix.net/8c0ee869/uploads/o