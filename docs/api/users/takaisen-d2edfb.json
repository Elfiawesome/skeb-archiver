3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc9e9a6dc6058d7f7391d316cbe083e", "thumbnail_srcset": "https://si.imgix.net/5dbedfda/uploads/origins/a28f232f-be43-440b-b4b7-46e62fc3d3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc9e9a6dc6058d7f7391d316cbe083e, https://si.imgix.net/5dbedfda/uploads/origins/a28f232f-be43-440b-b4b7-46e62fc3d3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=469c6316c3323f268634ea02c519a7f0 2x, https://si.imgix.net/5dbedfda/uploads/origins/a28f232f-be43-440b-b4b7-46e62fc3d3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27f3a48e910a50e3bbf65e8a3b91e5ca 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今回も写真をお願いしたいのですが、友人のためです。\nhttps://i.imgur.com/CZM3Sqc.jpeg\nhttps://i.imgur.com/79cndSS.png\n\n村の中で巨大化している絵があれば最高です。ちょっと恥ずかしいけど、成長するのが楽しみな子です。胸もかなり大きいし、太ももやお尻も大きい。服が破れて、恥ずかしくてかぶっているのかも？", "created_at": "", "completed_at": ""}, {"path": "/@takaisen/works/36", "thumbnail_src": "https://si.imgix.net/5199de7d/uploads/origins/dd607151-6158-4baf-9ed1-a0efa9d704b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e819724fe6b851a00cda81e338d2aead", "thumbnail_srcset": "https://si.imgix.net/5199de7d/uploads/origins/dd607151-6158-4baf-9ed1-a0efa9d704b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e819724fe6b851a00cda81e338d2aead, https://si.imgix.net/5199de7d/uploads/origins/dd607151-6158-4baf-9ed1-a0efa9d704b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c9a4da6cf983f3f059b1abbbbb6e78a 2x, https://si.imgix.net/5199de7d/uploads/origins/dd607151-6158-4baf-9ed1-a0efa9d704b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f67a5db8237fbd1cb6159ac4e5bb088 3x", "genre": "art", "nsfw": true, "body": "黒いタンクトップとホットショーツを着た巨大な河城にとり（東方）が欲しいです。彼女はブーツの下で街の一部をつぶしている。手袋をはめた手には成長光線が握られていて、自分でも試している。全体的に、彼女は非常にバスティでセクシーで、邪悪でほくそ笑み、眼下の哀れな小さな人間たちを破壊しながら自惚れるのです。ポーズや構図は自由にしてください。\n\nhttps://imgur.com/a/EKff6SH", "created_at": "", "completed_at": ""}, {"path": "/@takaisen/works/35", "thumbnail_src": "https://si.imgix.net/be967e85/uploads/origins/f5f69c3c-4c61-42f0-91dd-b4ae90a395ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59bf06a5567fea85c7c3b7b1f2054325", "thumbnail_srcset": "https://si.imgix.net/be967e85/uploads/origins/f5f69c3c-4c61-42f0-91dd-b4ae90a395ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59bf06a5567fea85c7c3b7b1f2054325, https://si.imgix.net/be967e85/uploads/origins/f5f69c3c-4c61-42f0-91dd-b4ae90a395ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=604fcefc8d0e360e7a2c55a22cc8c70c 2x, https://si.imgix.net/be967e85/uploads/origins/f5f69c3c-4c61-42f0-91dd-b4ae90a395ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3cc361f81d8fe9509ca4b254c7e25bd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@takaisen/works/34", "thumbnail_src": "https://si.imgix.net/e401eee2/uploads/origins/6b0d2842-0fba-4955-ae2d-d88dc2b47795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c4abbcbddcc9e2aa1b124e5e136c63e", "thumbnail_srcset": "https://si.imgix.net/e401eee2/uploads/origins/6b0d2842-0fba-4955-ae2d-d88dc2b47795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c4abbcbddcc9e2aa1b124e5e136c63e, https://si.imgix.net/e401eee2/uploads/origins/6b0d2842-0fba-4955-ae2d-d88dc2b47795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e23b71ba8e0c1858019af13ed77eca 2x, https://si.imgix.net/e401eee2/uploads/origins/6b0d2842-0fba-4955-ae2d-d88dc2b47795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3aadd3b6f2f0c6c79a2eed7052a83d1 3x", "genre": "art", "nsfw": true, "body": "お世話になっています。\n\n今回は、ジムでトレーニングするボス子様に付き合わされて酷い目に遭うモブ少年、というイメージの作品をお願いします。\n\n具体的には、胸を鍛えるフライ系のトレーニングでおっぱいに挟まれたり、ダンベルカールで肘の内側に挟まれたり、バランスボールで尻に潰されたり、サイドレッグリフトで股に挟まれたり、ウェアのお尻の部分に入れられたままスクワットで圧迫されたり、といったものを考えています。上記はあくまで例なので、上記の中から描きやすいものを選んでいただいても、上記以外で何かあればそちらを描いていただいても、ご自由にお任せします。\n\nボス子様の服装については、赤もしくは黒のビキニタイプのトレーニングウェアで、汗ばんで湿度高めな雰囲気で描いていただけると理想です。モブ少年とのサイズ差についてはお任せします。\n\nご検討いただけると幸いです。宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@takaisen/works/33", "thumbnail_src": "https://si.imgix.net/4527f4a0/uploads/origins/5c12f9dc-e82b-4533-bbc0-055e4ae8012f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=364fb4a181543ce4a9f61075c4f458f2", "thumbnail_srcset": "https://si.imgix.net/4527f4a0/uploads/origins/5c12f9dc-e82b-4533-bbc0-055e4ae8012f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=364fb4a181543ce4a9f61075c4f458f2, https://si.imgix.net/4527f4a0/uploads/origins/5c12f9dc-e82b-4533-bbc0-055e4ae8012f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7d18b147db3fd4542124cfe317d30e4 2x, https://si.imgix.net/4527f4a0/uploads/origins/5c12f9dc-e82b-4533-bbc0-055e4ae8012f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c519c5270c39397e4f757157255e9be0 3x", "genre": "art", "nsfw": false, "body": "初めてのリクエスト失礼します。\n\nギガサイズの艦隊これくしょんの山城さんが、街を脚で囲むように腰を下ろし、足袋で蒸れた素足を見せつけているイラストを描いていただけないでしょうか？\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@takaisen/works/32", "thumbnail_src": "https://si.imgix.net/c09485fb/uploads/origins/d61713da-5e35-496b-b99d-aa7fd23c1896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2