42-4066-4d2f-b84c-7e64c4b57cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dee6f95ecdf7dafa2527506ea6c4bb1", "thumbnail_srcset": "https://si.imgix.net/61e5ace7/uploads/origins/54754942-4066-4d2f-b84c-7e64c4b57cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dee6f95ecdf7dafa2527506ea6c4bb1, https://si.imgix.net/61e5ace7/uploads/origins/54754942-4066-4d2f-b84c-7e64c4b57cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6741136b8ae377f608023192d7567b5 2x, https://si.imgix.net/61e5ace7/uploads/origins/54754942-4066-4d2f-b84c-7e64c4b57cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9b0ef96ddf000aa556ff7114d6f6e9b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n新作の発表おめでとうございます。\n\n【キャラクター】\n鈴谷（艦これ）\n\n【シチュ】\nエッグイビキニの日焼けした黒ギャル鈴谷が好みのショタを逆ナンしてトイレに連れ込んで、水着をズらして、マ〇コを開いて危険日でも気にせずに捕食する。（鈴谷はノリノリ）\n（以前の村雨ちゃんのイラストのように若干女性上位のイメージです）\n水着のデザイン等は資料のURL参照、隠しきれてない水着というイメージです。\n※構図のイメージ\nhttps://www.pixiv.net/artworks/114105507\nhttps://skeb.jp/@stem_720/works/46\n\n【容姿】\nむちむち、爆乳デカ尻、巨乳輪でお願いします。\n\n【その他差分希望】\nボテ差分\n通常のマ〇コ/グロマン\nアヘ顔\n\n是非ご検討よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/98444438", "created_at": "", "completed_at": ""}, {"path": "/@akisuke06080608/works/526", "thumbnail_src": "https://si.imgix.net/097c43ea/uploads/origins/2c06bcb3-089a-45b4-8875-b6778871e002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c1a0bd7ccfb411d5886f11168aa110e", "thumbnail_srcset": "https://si.imgix.net/097c43ea/uploads/origins/2c06bcb3-089a-45b4-8875-b6778871e002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c1a0bd7ccfb411d5886f11168aa110e, https://si.imgix.net/097c43ea/uploads/origins/2c06bcb3-089a-45b4-8875-b6778871e002?bg=%23fff