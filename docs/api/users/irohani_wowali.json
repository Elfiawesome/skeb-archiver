imgix.net/d2e15134/uploads/origins/0804b785-8138-4736-b6aa-539f949bcc14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa02f5a5dd07547f6555f5fcf9784f19", "thumbnail_srcset": "https://si.imgix.net/d2e15134/uploads/origins/0804b785-8138-4736-b6aa-539f949bcc14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa02f5a5dd07547f6555f5fcf9784f19, https://si.imgix.net/d2e15134/uploads/origins/0804b785-8138-4736-b6aa-539f949bcc14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f398c8f95d91b2d13b3874113e699fdd 2x, https://si.imgix.net/d2e15134/uploads/origins/0804b785-8138-4736-b6aa-539f949bcc14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d96fd3aa42e7b5dcf35f7373a7f8be55 3x", "genre": "art", "nsfw": false, "body": "ヲワリ様こぬばぬは。\n2頭身と3頭身イラストを1枚ずつ依頼させていただきたいです！\n構図や色合い等、ヲワリ様のイメージでお願いします。\nヲワリ様の絵が本当に大好きなので、今回の依頼再開とてもうれしいです。\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/MKv7K3HDVrF7U5xQ6", "created_at": "", "completed_at": ""}, {"path": "/@irohani_wowali/works/11", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9056a53627fd150cec7bce7918b4a89", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9056a53627fd150cec7bce7918b4a89, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=654c0486cef33a3cfe4e639809e8517c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f4b2b89194e5baa5d12c2798e075e98 3x", "genre": "voice", "nsfw": false, "body": "台詞リクエスト失礼いたします。\n寂しがりな迷い子が、不安で泣きながらヲワリ様の元へやってきて、最終的に寝かしつけるシチュの台詞をお願いします。\n変な所があれば直して読んでいただきたいです。言い聞かせるように、落ち着いた声色でゆったりめに読んでいただけるとさらに喜びます\n\n「おや、おかえり迷い子。……って、どうしたんじゃ、泣いておるの…？\nよしよし、寂しかったんか？それとも、何か怖いことでも考えてしもうた？\nこっちへおいで、ぎゅーしてあげよう。(少し近付いて)ほら、ぎゅー…\n\nよしよし、大丈夫大丈夫…怖くない、怖くない……寂しくない、もう寂しくないからな。僕がずっと、そばにおるから……\nあぁあぁ、こんなに目元を真っ赤に腫らして、可哀想にのう……\nん？なんだか眠たそうじゃな？……ふむ、抱き締められて、眠たくなってきた？\nよいよい、寝てしまおうな。沢山泣いて疲れたじゃろう。\n\n迷い子が寝付けるまで、僕がよしよししててやるからの。\n安心して眠りんしゃいね。\n(寝かしつけるように静かめの声で)大丈夫、焦らんくてええ。不安に思うことなど何もない……お主にはこの僕がついてるからの、怖いことも悪いことも、何も起きん、起きさせはせん。\n落ち着いて……そう、いい子じゃのう。\n\n……おやすみ、迷い子。僕の大事な 大事な 愛い子。」", "created_at": "", "completed_at": ""}, {"path": "/@irohani_wowali/works/10", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28f4b505ce6696ea4cb0a347c7d97aac", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28f4b505ce6696ea4cb0a347c7d97aac, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd44f24fa9aba564c4082c54a778277f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020356035350007808%2FEOJPnT_4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b02726c286cb1381