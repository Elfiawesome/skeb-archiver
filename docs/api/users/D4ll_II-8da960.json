4a-3f38-4c2b-9f39-fcc19b80f1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f30451d23ed5381ebe0ff7e818b60ff", "thumbnail_srcset": "https://si.imgix.net/91816b06/uploads/origins/fdbc094a-3f38-4c2b-9f39-fcc19b80f1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f30451d23ed5381ebe0ff7e818b60ff, https://si.imgix.net/91816b06/uploads/origins/fdbc094a-3f38-4c2b-9f39-fcc19b80f1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a561251d9c890c0e8eb4e9b6675afd7 2x, https://si.imgix.net/91816b06/uploads/origins/fdbc094a-3f38-4c2b-9f39-fcc19b80f1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01f529aa2018f2a6a0d7b354f6fc3091 3x", "genre": "art", "nsfw": false, "body": "先日納品されたイラストがとても素晴らしかったのでリピートです。\n\nお腹は程よく引き締めて、ちちしりふとももは盛りたいだけ盛ってください。\n構図・ポーズ等に関してはお腹が正面から見えていればあとはお任せします。\n\n用途としてskeb連携してないSNSやDiscordでも使用したいです。\n\n\n資料はこちらになります。\nhttps://drive.google.com/drive/folders/1kByiKRGSsW-_Y99il9RdKCahB3_ZEQlH?usp=sharing\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@D4ll_II/works/65", "thumbnail_src": "https://si.imgix.net/fabf27f7/uploads/origins/8bf768f4-5b20-4e3e-8971-f73d898d0c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ab7039964a2261b1730f4a533194115", "thumbnail_srcset": "https://si.imgix.net/fabf27f7/uploads/origins/8bf768f4-5b20-4e3e-8971-f73d898d0c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ab7039964a2261b1730f4a533194115, https://si.imgix.net/fabf27f7/uploads/origins/8bf768f4-5b20-4e3e-8971-f73d898d0c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b48d1a7ee3c6c0d1b203150b26bc81fb 2x, https://si.imgix.net/fabf27f7/uploads/origins/8bf768f4-5b20-4e3e-8971-f73d898d0c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e45cde6fdede8feeaaa90c98ab4cf10a 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとてもきれいで