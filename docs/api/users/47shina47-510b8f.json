e6e/uploads/origins/50f63384-6798-4a8e-90d0-0afcf7a2fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97875bc3615557bb4debe611dfef5b59", "thumbnail_srcset": "https://si.imgix.net/a14b2e6e/uploads/origins/50f63384-6798-4a8e-90d0-0afcf7a2fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97875bc3615557bb4debe611dfef5b59, https://si.imgix.net/a14b2e6e/uploads/origins/50f63384-6798-4a8e-90d0-0afcf7a2fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f363639d81e32e72584529ed88cb12e 2x, https://si.imgix.net/a14b2e6e/uploads/origins/50f63384-6798-4a8e-90d0-0afcf7a2fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcf978bd16978d8204baf85d4eb4ab41 3x", "genre": "art", "nsfw": false, "body": "しなを先生こんにちは！\n私の依頼をご覧いただきありがとうございます。私はしなを先生のイラストが大好きです！キャラクターの表現力がとても可愛いです。 今回は、私の鬼滅の刃のオリジナルキャラクターのイラストを依頼したいと思います。\n基礎設定は神社の娘、水の呼吸を使ってますw\n\nhttps://drive.google.com/drive/folders/1-CfjAxXWxlCMTc1pbShYuGkER5twhcI7\n\nこちらの参考資料の女性の服を自由に選んでお願いします～\nイラストの内容は、先生の自由にお任せします。表情/服装などは全ておまかせします。\n以上です。\n\n先生が私の依頼を引き受けてくださると、大変光栄です！  どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@47shina47/works/39", "thumbnail_src": "https://si.imgix.net/447890bf/uploads/origins/b6c4e06c-5950-4547-9b91-f30cd6e2d555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962e9146af7e52aad94943e9df57ed66", "thumbnail_srcset": "https://si.imgix.net/447890bf/uploads/origins/b6c4e06c-5950-4547-9b91-f30cd6e2d555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962e9146af7e52aad94943e9df57ed66, https://si.imgix.net/447890bf/uploads/origins/b6c4e06c-5950-4547-9b91-f30cd6e2d555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b422e76d3fcf79038342d74a5afac8c 2x, https://si.imgix.net/447890bf/uploads/origins/b6c4e06c-5950-4547-9b91-f30cd6e2d555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc0839609b54520489cfcbda674cced7 3x", "genre": "art", "nsfw": false, "body": "しなを様\n\nはじめまして、個人勢VTuberとして活動している依琉海ネイロと申します。\n可愛い絵柄と素敵な色使いのイラストに惹かれ、ぜひリクエストさせていただきたいなと思い、ご連絡させていただきました。\n\n 【ご依頼したい内容】\n YouTubeサムネイルやSNSでの使用を目的としたイラスト \n\n【資料】 \n三面図 https://drive.google.com/file/d/1KPATMO64RDBXhWYHL_Zw01FIN_VM6OKi/view?usp=sharing\nキービジュアル\nhttps://drive.google.com/file/d/1vs5V0tgwjhSqf6kFgN54uvLxLZ32b1vw/view?usp=sharing\n\n【その他要望など】 \n表情、ポーズ、構図などはすべてお任せいたします。 \nメガネは着けている状態だとありがたいです。 \n頭、髪の毛、上半身の見切れがない状態だとありがたいです。\n背景ありの場合は、キャラクターのみ（背景透過）のデータ、もしくはレイヤー分けされたpsdデータも頂けると嬉しいです。\nもし可能でしたら、表情差分なども描いていただけたらとても嬉しいです。\n\n不慣れなため、失礼な点があったら申し訳ありません。\nもしよろしければご検討いただけたら幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1KPATMO64RDBXhWYHL_Zw01FIN_VM6OKi/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@47shina47/works/38", "thumbnail_src": "https://si.imgix.net/2e8fa4f7/uploads/origins/6ca1854c-c3bf-4f9b-8ea1-275581a686ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84239af240ef9522e292ef21f233c306", "thumbnail_srcset": "https://si.imgix.net/2e8fa4f7/uploads/origins/6ca1854c-c3bf-4f9b-8ea1-275581a686ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84239af240ef9522e292ef21f233c306, https://si.imgix.net/2e8fa4f7/uploads/origins/6ca1854c-c3bf-4f9b-8ea1-275581a686ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4b0224701acbdbdedb3b8618dd44a68 2x, https://si.imgix.net/2e8fa4f7/uploads/origins/6ca1854c-c3bf-4f9b-8ea1-275581a686ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb75aaa57c1a9a33fda9185edcc3a859 3x", "genre": "art", "nsfw": false, "body": "しなを先生初めまして、あなたのイラストがとても気に入りました。キャラクターデザインの依頼をしたいです。\n\n自分の新しいOC（ユユ）のイラストを依頼したです。\n\n髪型：銀白色、短髪、巻き。小さ辮子があり、髪の内側は赤色。\n目：赤、ダイヤモンド形の瞳孔\n\nhttps://drive.google.com/file/d/1B7CjawBNbVNAYj8eI7SMl4AOJ5L84sat/view?usp=drivesdk\n\n\n性格は少し臆病で恥ずかしがり屋です。魔法の世界で魔法薬の調合をしています。普段はかわいい帽子をかぶり、斜め掛けのバッグを持っています。\n服の色は白と青がメインです。\nもし服の一部が隠れている場合、先生に簡単なスケッチで示していただけると嬉しいです。\n\n人物のみの透過データもいただけますと幸いです。 使用用途は個人観賞、SNSアイコンとなります。 リクエストをご検討いただき、ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@47shina47/works/37", "thumbnail_src": "https://si.imgix.net/0cbafe57/uploads/origins/e665a6a4-f821-4794-a038-3e4818a354e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7bfcec96807855e90b351e2157dad30", "thumbnail_srcset": "https://si.imgix.net/0cbafe57/uploads/origins/e665a6a4-f821-4794-a038-3e4818a354e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7bfcec96807855e90b351e2157dad30, https://si.imgix.net/0cbafe57/uploads/origins/e665a6a4-f821-4794-a038-3e4818a354e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=026290561d4f60677570ae95410af80f 2x, https://si.imgix.net/0cbafe57/uploads/origins/e665a6a4-f821-4794-a038-3e4818a354e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d0507cf12b217b28921cd54dd49ca5b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@47shina47/works/36", "thumbnail_src": "https://si.imgix.net/70049e3d/uploads/origins/0178b941-42dc-4fe2-9b87-655499b6170b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6cdc237970295d9e577492988b2774", "thumbnail_srcset": "https://si.imgix.net/70049e3d/uploads/origins/0178b941-42dc-4fe2-9b87-655499b6170b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6cdc237970295d9e577492988b2774, https://si.imgix.net/70049e3d/uploads/origins/0178b941-42dc-4