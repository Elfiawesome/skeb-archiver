子を放ってしまった\n驚愕、しまった、もうちょっとだったのに、勿体無いという表情の二人\n\n中出し外出し、また可能であれば今回もコンドーム射精差分をお願いできますでしょうか？\nもし絵的に映えない、描くのが難しい様のであればシチュエーション、体位やポーズ、構図などは自由に変更してください\nその他のことは全てお任せします\n台詞もひらうめ様の考えたストーリーに沿って自由に入れて下さい\nわからなかったり迷ったりする部分はひらうめ様の好きな様に解釈して下さい\n細かい部分などは自身の描きやすさとイメージを優先して自由に楽しく描いて下されば幸いです\nそれではよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1QzABKLw4K5FUfJOlyN01Cf1PQRb2ll4X", "created_at": "", "completed_at": ""}, {"path": "/@Hiraume42/works/28", "thumbnail_src": "https://si.imgix.net/9e3125b2/uploads/origins/1700d6b3-528f-4693-bfc5-d6ab2da37b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d7524d025e3fb2796a65642a36b6968", "thumbnail_srcset": "https://si.imgix.net/9e3125b2/uploads/origins/1700d6b3-528f-4693-bfc5-d6ab2da37b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d7524d025e3fb2796a65642a36b6968, https://si.imgix.net/9e3125b2/uploads/origins/1700d6b3-528f-4693-bfc5-d6ab2da37b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ad7f55d0952069a12d2a4188cbc88ce 2x, https://si.imgix.net/9e3125b2/uploads/origins/1700d6b3-528f-4693-bfc5-d6ab2da37b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8145599c08246e3eb7c0cdd14eff8e87 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hiraume42/works/27", "thumbnail_src": "https://si.imgix.net/ddc5327e/uploads/origins/f546ac04-f512-4913-9b55-30671a6b03b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=961e45cb208dd6d50252161d3217ed82", "thumbnail_srcset": "https://si.imgix.net