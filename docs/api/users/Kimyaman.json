chi/status/1637031921195847680?t=ujrEE4fEdD0TOA0KhjaBEA&s=19\n\n②よくしてくれている人\nFHセルリーダー。資金繰りのためにカフェを営んでいる。わけあって異形の子を拾うことに。可愛がってくれる。\nイラストの参考はこちら\nhttps://twitter.com/Trxx25/status/1637148890112856066?t=-cAGr03-zbUQzmwEgzKzMg&s=19\n\n2人がカフェにいるようなシチュエーションだと嬉しいですが、描きにくければ変えていただいても構いません。\n可愛い絵柄だなと思っていたので可愛い雰囲気のイラストだと嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kimyaman/works/10", "thumbnail_src": "https://si.imgix.net/74f5cacf/uploads/origins/fb899068-3177-4782-bf81-ce74a2426b95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56222d976afbc8cedc3948f64ddbacee", "thumbnail_srcset": "https://si.imgix.net/74f5cacf/uploads/origins/fb899068-3177-4782-bf81-ce74a2426b95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56222d976afbc8cedc3948f64ddbacee, https://si.imgix.net/74f5cacf/uploads/origins/fb899068-3177-4782-bf81-ce74a2426b95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de551643a21c884113e3a5260162f071 2x, https://si.imgix.net/74f5cacf/uploads/origins/fb899068-3177-4782-bf81-ce74a2426b95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d2af5c8ae01e2958e22a1a45830abf3 3x", "genre": "art", "nsfw": false, "body": "M14ちゃん", "created_at": "", "completed_at": ""}, {"path": "/@Kimyaman/works/9", "thumbnail_src": "https://si.imgix.net/27f8dc45/uploads/origins/464f0e0b-1c50-409a-8a1c-31472647ba2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44c92978683ece7061caaf38c7774838", "thumbnail_srcset": "https://si.imgix.net/27f8dc45/uploads/origins/464f0e0b-1c50-409a-8a1c-31472647ba2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44c92978683ece7061caaf38c7774838, https://si.imgix.net/27f8dc45/uploads/origins/464f0