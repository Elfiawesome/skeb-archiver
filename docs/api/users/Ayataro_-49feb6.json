8-b48a-c8b902aaa606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed9eaae264ee1b06a284f5727c95e283 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\nティオ・プラトの依頼をしたいのですが。\n\nティオを仰向けに寝かせて、片手でオナニーをさせてください。ティオのもう片方の手で、ロイド・バニングスが着ているジャケットを持たせてください（参考：https://imgur.com/a/zfdt4HX）。ジャケットの匂いを嗅ぎながらオナニーをさせてください。ティオはスカートやパンティをはいていない状態でお願いします。\n\nできれば、ロイドが部屋に入ってきて、ティオが恥ずかしそうに捕まるようなバリエーションが欲しいです。\n\nティオ・プラトン 参照：https://imgur.com/a/mJOCp9T", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/18", "thumbnail_src": "https://si.imgix.net/491b9e8a/uploads/origins/1fcfd4df-c0b2-4acd-8539-a359ad5cbeb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903ce6b8dfa8dd806ccc4dc68687e1d3", "thumbnail_srcset": "https://si.imgix.net/491b9e8a/uploads/origins/1fcfd4df-c0b2-4acd-8539-a359ad5cbeb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903ce6b8dfa8dd806ccc4dc68687e1d3, https://si.imgix.net/491b9e8a/uploads/origins/1fcfd4df-c0b2-4acd-8539-a359ad5cbeb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c165617c927624ddc4de83dd62b40f8e 2x, https://si.imgix.net/491b9e8a/uploads/origins/1fcfd4df-c0b2-4acd-8539-a359ad5cbeb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=455e927a961ad53de56ac69d171fed5e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私はこのキャラクターhttps://i.imgur.com/WKfi1eK.jpeg、ロリ巨乳のOLとして描いてもらいたいです。このスカートhttps://twitter.com/kuavera/status/1628190221958250498、魚網の太ももハイを持っています。また、かわいいコートとブラウスは、あなたがふさわしいと思う谷間があります。", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/17", "thumbnail_src": "https://si.imgix.net/c5d1a87d/uploads/origins/114622c3-1cfc-49c4-b40b-1ddebb5c1d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4735a6a45801a7dc56ea48a01478f41", "thumbnail_srcset": "https://si.imgix.net/c5d1a87d/uploads/origins/114622c3-1cfc-49c4-b40b-1ddebb5c1d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4735a6a45801a7dc56ea48a01478f41, https://si.imgix.net/c5d1a87d/uploads/origins/114622c3-1cfc-49c4-b40b-1ddebb5c1d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ed58880cdada39e1017c925903d8d5c 2x, https://si.imgix.net/c5d1a87d/uploads/origins/114622c3-1cfc-49c4-b40b-1ddebb5c1d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f6a0e1be6e89ba9433685a09d64c4ab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/16", "thumbnail_src": "https://si.imgix.net/4a7e5f7f/uploads/origins/eb9c0128-d8a6-498f-8177-6ddca8493348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa9a4093f8302fd97126b3a6709d9aa7", "thumbnail_srcset": "https://si.imgix.net/4a7e5f7f/uploads/origins/eb9c0128-d8a6-498f-8177-6ddca8493348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa9a4093f8302fd97126b3a6709d9aa7, https://si.imgix.net/4a7e5f7f/uploads/origins/eb9c0128-d8a6-498f-8177-6ddca8493348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a786872c41476c8bd2824d617ac1893 2x, https://si.imgix.net/4a7e5f7f/uploads/origins/eb9c0128-d8a6-498f-8177-6ddca8493348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=944b4b1871847c26afdaac7a4c65b832 3x", "genre": "art", "nsfw": true, "body": "はじめまして、小林です。\n二ノ前イナちゃん（hololive EN）の画像をお願いしたいのですが。\nバニーガールの格好で淫靡なクラブで働くイナちゃん。新しいお客様をお迎えする際、可愛らしくプロフェッショナルなオーラを出そうとするものの、前の接客で疲れているのが目に見えてわかる雰囲気です。股間からは前の客の性液がこっそり出ていて、口元から胸元へと伝っているのが見える。バニースーツのバストカップは液体が溢れ、垂れ下がって小さな胸を露わにしている。\nSFWバージョンが可能で、描きたいものがあれば、ぜひお願いします。\nこれで物足りなかったらごめんなさい。\nありがとうございました。\n\nhttps://static.wikia.nocookie.net/virtualyoutuber/images/2/22/Ninomae_Ina%27nis_Full_body.png/revision/latest?cb=20211228031652", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/15", "thumbnail_src": "https://si.imgix.net/c107a064/uploads/origins/253034c2-f39c-401e-912e-523101c96e11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e967452ace686db01fde21b6895307a", "thumbnail_srcset": "https://si.imgix.net/c107a064/uploads/origins/253034c2-f39c-401e-912e-523101c96e11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e967452ace686db01fde21b6895307a, https://si.imgix.net/c107a064/uploads/origins/253034c2-f39c-401e-912e-523101c96e11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca31fe36648e69e810b421485c9b2351 2x, https://si.imgix.net/c107a064/uploads/origins/253034c2-f39c-401e-912e-523101c96e11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3287d46169218bd6946f41d7512434d7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/14", "thumbnail_src": "https://si.imgix.net/99b939e6/uploads/origins/513bbf54-9cbe-4d03-87e5-9eac6a7b7815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3818cc9e5731dcd49aead8bc59577259", "thumbnail_srcset": "https://si.imgix.net/99b939e6/uploads/origins/513bbf54-9cbe-4d03-87e5-9eac6a7b7815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3818cc9e5731dcd49aead8bc59577259, https://si.imgix.net/99b939e6/uploads/origins/513bbf54-9cbe-4d03-87e5-9eac6a7b7815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfa6a171407c1408700641c888320f44 2x, https://si.imgix.net/99b939e6/uploads/origins/513bbf54-9cbe-4d03-87e5-9eac6a7b7815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a6cccadebc5e2d70312413abbb91c1e 3x", "genre": "art", "nsfw": true, "body": "初めまして！\nあやたろさんのえちかわなホロメンに惹かれまして、リクエストさせていただきました。\n\n具体的な要望は後述するのですが、エッチシーン詰め合わせ(複数構図)をお願いしたいと思っております。\nそのためご対応が難しいようでしたら、遠慮なくキャンセル・再送依頼等をしていただければ幸いです。\n\n■人物\n雪花ラミ○ちゃんをお願いします。\n衣装は参考urlにある、センシティブなキョンシー服を希望しますが、全裸でも構いません。\n\n■要望\n①恋人繋ぎしながらの騎乗位で、気持ちよさと幸せオーラあふれる表情。\n\n②二人揃って絶頂。片足上げ立ちバックでの中出し。(中出し断面図も描写いただけると嬉しいです)\n\n③まんぐり返し状態で、指で女性器をくぱぁし、もう一戦おねだり。\n\n複数構図での要望となりますので、背景指定はございません。\nまた、カラー有無や声(セリフや喘ぎ)といった部分については全てお任せいたします。\n\n以上となります。長くなり申し訳ありません。\nご検討のほど、よろしくお願いいたします。\n\nhttps://item.rakuten.co.jp/senmhs/sq354/", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/13", "thumbnail_src": "https://si.imgix.net/99efd1a4/uploads/origins/02b0dbeb-410c-4056-99d0-f1e45575289a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b40d027134e6c5a6484900b30773b1f", "thumbnail_srcset": "https://si.imgix.net/99efd1a4/uploads/origins/02b0dbeb-410c-4056-99d0-f1e45575289a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b40d027134e6c5a6484900b30773b1f, https://si.imgix.net/99efd1a4/uploads/origins/02b0dbeb-410c-4056-99d0-f1e45575289a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2d09ac5dea3eec3dca7971b25a426c6 2x, https://si.imgix.net/99efd1a4/uploads/origins/02b0dbeb-410c-4056-99d0-f1e45575289a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=560a4128d239cf7c95edc9fdaf5dea7f 3x", "genre": "art", "nsfw": true, "body": "はじめまして！(*´ω｀*)ホロライブハコスバエルツのエッチシーンを差し支えなければお願いしたいです。制服姿の騎乗位セックスシーンになると思います。イラストの中で彼女の胸をとても大きくしてください。できれば、シャツを着て谷間を見せたバージョンと、シャツを脱いで胸を丸出しにしたバージョンがあれば最高です。ご検討のほど、よろしくお願いいたします。\n参考：https://imgur.com/a/JolndyC", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/12", "thumbnail_src": "https://si.imgix.net/f3fa7c22/uploads/origins/5f9644f3-3316-4bc9-904d-ed0ffc6d6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9500d3ac89d93a5f65bdbf515ad3399", "thumbnail_srcset": "https://si.imgix.net/f3fa7c22/uploads/origins/5f9644f3-3316-4bc9-904d-ed0ffc6d6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9500d3ac89d93a5f65bdbf515ad3399, https://si.imgix.net/f3fa7c22/uploads/origins/5f9644f3-3316-4bc9-904d-ed0ffc6d6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=472a08674f9c4b8eed84ae9443ad4e66 2x, https://si.imgix.net/f3fa7c22/uploads/origins/5f9644f3-3316-4bc9-904d-ed0ffc6d6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c9c409164c5923c12401b4fa44bb90f 3x", "genre": "art", "nsfw": false, "body": "夜分のご依頼で失礼致します。二次創作の依頼となりますが、ウマ娘からミホノブルボンちゃんがいつもの勝負服を水着仕様に調整して水辺に横座りで佇むイラストを今回希望します。\n衣装のイメージ図としては下記の方のイラストを資料として参照頂けたらありがたいです。\n\nhttps://twitter.com/mug_orz/status/1424013636431794180?t=q6kaZeuTEk3aj81Rm_a3zA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Ayataro_/works/11", "thumbnail_src": "https://si.imgix.net/dccfad24/uploads/origins/0bf42061-f3e3-4ce6-b021-5b0ecb612c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62feddb2b7e175c831cd74bdb21918e1", "thumbnail_srcset": "https://si.imgix.net/dccfad24/uploads/origins/0bf42061-f3e3-4ce6-b021-5b0ecb612c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62feddb2b7e175c831cd74bdb21918e1, https://si.imgix.net/dccfad24/uploads/origins/