r=2&fit=crop&crop=top&w=200&h=200&s=339cb01196fb57056ca7d78621845b63 2x, https://si.imgix.net/7a687594/uploads/origins/d81448c4-3ce2-4232-8eb4-623627e2caed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e66e904b50a45c3c25d25ccb4928c48 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のOCを描いてくれませんか？名前はリッジ、とてもプライドが高くて攻撃的な狼の女の子です。どんなポーズでも自由に描いてください。唯一のお願いは、彼女の全身が作品に入っていることです。ありがとう！\n\nhttps://drive.google.com/drive/folders/1J2j7KTlm4lU1JjflQ3q9KMJtsnulfgLp?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@HANADA_SOMERI/works/6", "thumbnail_src": "https://si.imgix.net/d413cc8c/uploads/origins/ae56b8f1-7342-4695-a787-4841a787916f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8604235782b0804f824c9b886636ccb9", "thumbnail_srcset": "https://si.imgix.net/d413cc8c/uploads/origins/ae56b8f1-7342-4695-a787-4841a787916f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8604235782b0804f824c9b886636ccb9, https://si.imgix.net/d413cc8c/uploads/origins/ae56b8f1-7342-4695-a787-4841a787916f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9d3a4e0a4a2fe26d217a1fc27b2e519 2x, https://si.imgix.net/d413cc8c/uploads/origins/ae56b8f1-7342-4695-a787-4841a787916f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f16c5efc11e9bceb59b18ba0d65f475 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@HANADA_SOMERI/works/5", "thumbnail_src": "https://si.imgix.net/a60da67c/uploads/origins/0cd5e324-f18c-41cc-a12a-51dcb49a23b0?bg=%2