e%2Ccenter&txtsize=30&txt=PRIVATE&s=b51cd05531d6fa3a2d16964219b1b734, https://si.imgix.net/c36458ce/uploads/origins/5f1648a5-0661-4021-a66f-7fea44c582c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e54044ef179ee6cb6a4210f9eb686f7 2x, https://si.imgix.net/c36458ce/uploads/origins/5f1648a5-0661-4021-a66f-7fea44c582c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d9bd5db70c9a2d6fd94f6afd88fcb23 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/16", "thumbnail_src": "https://si.imgix.net/0650efc6/uploads/origins/c36fd37b-7f5e-4134-b3d1-43e4c09cb5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ea1eb026a38894f93e773696ca02fec", "thumbnail_srcset": "https://si.imgix.net/0650efc6/uploads/origins/c36fd37b-7f5e-4134-b3d1-43e4c09cb5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ea1eb026a38894f93e773696ca02fec, https://si.imgix.net/0650efc6/uploads/origins/c36fd37b-7f5e-4134-b3d1-43e4c09cb5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f32d069655d7fdb2f7fbdea5f6bfabab 2x, https://si.imgix.net/0650efc6/uploads/origins/c36fd37b-7f5e-4134-b3d1-43e4c09cb5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6363b8ece220e16a3ed597ba18fcc961 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私は本当にあなたの絵が好きです、あなたのスタイルで私のキャラクターを描いてください。何でも自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1s3-fNSTd-czndrW6DoQ83oP_enEDLvwB?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/15", "thumbnail_src": "https://si.imgix.net/0734a484/uploads/origins/cc0b7576-c248-442c-893f-c7cbbb815afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0807a88be73d0ee7a94869c0252d52b2", "thumbnail_srcset": "https://si.imgix.net/0734a484/uploads/origins/cc0b7576-c248-442c-893f-c7cbbb815afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0807a88be73d0ee7a94869c0252d52b2, https://si.imgix.net/0734a484/uploads/origins/cc0b7576-c248-442c-893f-c7cbbb815afb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afc2d734f78fc2005036fce2555d8606 2x, https://si.imgix.net/0734a484/uploads/origins/cc0b7576-c248-442c-893f-c7cbbb815afb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89da715a529377e55f9026f5e40aca15 3x", "genre": "art", "nsfw": false, "body": "私のオリジナルキャラクター、マラヴィのアートをお願いしたい。\n\nhttps://drive.google.com/drive/folders/1CJpdRY-dtYUmD5rzyxKH7PrSq0owzUQc?usp=sharing\n\nMaraviは働き者で、とても陽気な人です。彼女はポーションを作り、いつも新しいものを作ったり発見したりすることにわくわくしています。\n\nあなたのエレシュキガル（https://www.pixiv.net/en/artworks/71829429）のアートワークがずっと好きで、そのアートワークと同じような構図で、陽気な笑顔のマラヴィを描いていただけないでしょうか。それが無理なら、構図はお任せします。\n\nポージングはお任せしますので、彼女の服装を調整してください。スカートの色は紫ではなく青で、スカートのダイヤ模様はそのままか、それに近いものにしていただけるとありがたいです。\n\nhttps://drive.google.com/drive/folders/1CJpdRY-dtYUmD5rzyxKH7PrSq0owzUQc?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/14", "thumbnail_src": "https://si.imgix.net/b4e38ffc/uploads/origins/e4132c1c-5233-45b2-90dc-dcc024de15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36a74119c3ed21f1d4eb019c87ea5e63", "thumbnail_srcset": "https://si.imgix.net/b4e38ffc/uploads/origins/e4132c1c-5233-45b2-90dc-dcc024de15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36a74119c3ed21f1d4eb019c87ea5e63, https://si.imgix.net/b4e38ffc/uploads/origins/e4132c1c-5233-45b2-90dc-dcc024de15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40ed313e2f597f68b4a17ca02e3063ff 2x, https://si.imgix.net/b4e38ffc/uploads/origins/e4132c1c-5233-45b2-90dc-dcc024de15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42ee21d66640d0d236610f37429f5931 3x", "genre": "art", "nsfw": false, "body": "こんにちは！DOM先生のスタイリッシュなイラストが大好きで、リクエストを送らせていただきます。\n\n詳細はURLにありますが、二人は腐れ縁で幼馴染の二人です。\n服装はご自由に好きなものを着せてくださっても構いませんし、簡略化も問題ありません。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1jBqhwEb0yaH-r4Hmv0YFzPpIX4yeFvGJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/13", "thumbnail_src": "https://si.imgix.net/33dbb396/uploads/origins/40d96936-1dd3-4e04-83b6-5e6d0e72bb6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2821b3a03c6d44ca86596ed0d62d948b", "thumbnail_srcset": "https://si.imgix.net/33dbb396/uploads/origins/40d96936-1dd3-4e04-83b6-5e6d0e72bb6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2821b3a03c6d44ca86596ed0d62d948b, https://si.imgix.net/33dbb396/uploads/origins/40d96936-1dd3-4e04-83b6-5e6d0e72bb6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c7378e67d7cf1177bbef501b3aa53f4 2x, https://si.imgix.net/33dbb396/uploads/origins/40d96936-1dd3-4e04-83b6-5e6d0e72bb6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c065129fef750915d8b087d552135ab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/12", "thumbnail_src": "https://si.imgix.net/71958956/uploads/origins/07fcb7d5-93dc-4ee8-bbd6-19280c17521b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89672b5d9fa0d91aff2908515e11c418", "thumbnail_srcset": "https://si.imgix.net/71958956/uploads/origins/07fcb7d5-93dc-4ee8-bbd6-19280c17521b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89672b5d9fa0d91aff2908515e11c418, https://si.imgix.net/71958956/uploads/origins/07fcb7d5-93dc-4ee8-bbd6-19280c17521b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6396b5ad336c1054cc3b6535bee4e87b 2x, https://si.imgix.net/71958956/uploads/origins/07fcb7d5-93dc-4ee8-bbd6-19280c17521b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbae5923ddf64994211c654019961b53 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ᴰ‌ᴼ‌ᴹさまのイラストの大ファンです。\n早速ですが、ツシロメというocのイラストをリクエストしたいです！\n\nツシロメは山羊っぽい人外のキャラクターなので、ケモっぽいテイストだと尚更嬉しいです。\n（特に、髪（毛）と肌の色は白になります。）\n\nᴰ‌ᴼ‌ᴹさまの描きやすいように、デザインを多少アレンジしていただいても大丈夫です。\n服飾品もすべて描く必要はありません。\n\nよろしくお願いいたします。\n\nhttps://x.com/TSUSHIROME/status/1773687214020460982", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/11", "thumbnail_src": "https://si.imgix.net/58f4d737/uploads/origins/afda21f5-2e34-44af-a79d-7e6f89fbf09a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd12a5d3e4bbd461b27700ba227c6023", "thumbnail_srcset": "https://si.imgix.net/58f4d737/uploads/origins/afda21f5-2e34-44af-a79d-7e6f89fbf09a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd12a5d3e4bbd461b27700ba227c6023, https://si.imgix.net/58f4d737/uploads/origins/afda21f5-2e34-44af-a79d-7e6f89fbf09a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=220b5ce28a4aabcf0f5ecebcbfb2752e 2x, https://si.imgix.net/58f4d737/uploads/origins/afda21f5-2e34-44af-a79d-7e6f89fbf09a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f2548c4f3e1282e12517e1de6bc2ca9 3x", "genre": "art", "nsfw": false, "body": "Hello Dom-san! I've liked your illustrations for a long time! \nI would like to request art of my original characters.\n\nhttps://drive.google.com/drive/folders/1bz5EhwkmJq5WR--K26OBA71so5KRkXGW?usp=sharing\n\nThey are demon hunters. The male is a wolf demon and the girl is his master.\n\nThe male is sarcastic and smiles a lot. The girl is cool and quiet.\nTheir relationship is very close and care for each other a lot!\nThey are partners who like to travel and explore the unknown. \n\nI leave the pose and composition to you.\nFeel free to adjust their clothes into your style!\n\nThank you for considering my request.", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/10", "thumbnail_src": "https://si.imgix.net/6bf5f255/uploads/origins/0873a38b-7ceb-487e-9b27-e84393b29045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e9ffea226c66c24b5ead3be071ec7f9", "thumbnail_srcset": "https://si.imgix.net/6bf5f255/uploads/origins/0873a38b-7ceb-487e-9b27-e84393b29045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e9ffea226c66c24b5ead3be071ec7f9, https://si.imgix.net/6bf5f255/uploads/origins/0873a38b-7ceb-487e-9b27-e84393b29045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ad7cf5d666579b895df4a0eac10a163 2x, https://si.imgix.net/6bf5f255/uploads/origins/0873a38b-7ceb-487e-9b27-e84393b29045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ac7232af215ca0a0709a230d8b37533 3x", "genre": "art", "nsfw": false, "body": "ᴰ‌ᴼ‌ᴹ様、こんにちは！前回のリクエストは何から何まで最高すぎます本当にありがとうございます……（語彙力）\n良ければまた別のオリキャラのイラストを依頼したいです！\n\nキャラクターの容姿や性格はこちらになります：https://sta.sh/21e3rb9725fx?edit=1\n\n独り立ちを強く願う極道の娘です。世界観としては架空の現代日本で、混沌だった社会がようやく秩序を取り戻し始めるみたいな感じです。\n\n構図やシチュエーションなどは全てお任せいたします。\n\nキャラクターの衣装や髪型はどれを描いても、お好きにアレンジしても構いません。\n\n金額が足りなかった場合やこの依頼が難しく感じましたらお気軽にキャンセルしてください。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/9", "thumbnail_src": "https://si.imgix.net/33f23c3f/uploads/origins/9fa26548-1251-4a5e-85e0-84842e0196ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40e57c3deeac73dae2c2df51a0ab9438", "thumbnail_srcset": "https://si.imgix.net/33f23c3f/uploads/origins/9fa26548-1251-4a5e-85e0-84842e0196ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40e57c3deeac73dae2c2df51a0ab9438, https://si.imgix.net/33f23c3f/uploads/origins/9fa26548-1251-4a5e-85e0-84842e0196ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3c72016bfb3c4a3160055952ca18020 2x, https://si.imgix.net/33f23c3f/uploads/origins/9fa26548-1251-4a5e-85e0-84842e0196ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb4b72cfeca7d2a8156540b17555790e 3x", "genre": "art", "nsfw": false, "body": "Hello, I've loved your work for a long time and would love to apply for an illustration of these two characters here: https://drive.google.com/drive/folders/1r5_ig5AVTN7L8_zNKuwsb-2WtuG_BW_6?usp=sharing\n\nThe blue character is a boyish looking girl, both of them are sporty and free-spirited. They are partners who love the sky, and I will leave the pose and composition up to you. Feel free to simplify their outfit details or change anything that is hard to draw!", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/8", "thumbnail_src": "https://si.imgix.net/48314c48/uploads/origins/1ef53d7f-05df-4df8-a8eb-68fa0b9e8336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418988680330284393f0410cca966331", "thumbnail_srcset": "https://si.imgix.net/48314c48/uploads/origins/1ef53d7f-05df-4df8-a8eb-68fa0b9e8336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418988680330284393f0410cca966331, https://si.imgix.net/48314c48/uploads/origins/1ef53d7f-05df-4df8-a8eb-68fa0b9e8336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a79b896b410aa7b6820769e1a6bace8 2x, https://si.imgix.net/48314c48/uploads/origins/1ef53d7f-05df-4df8-a8eb-68fa0b9e8336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19fc58628e588356de2e5d1abf222ee7 3x", "genre": "art", "nsfw": false, "body": "ᴰ‌ᴼ‌ᴹ様、はじめまして！あなたのイラストをいつも楽しく拝見させていただいております。ご多忙中に申し訳ございませんがよければうちのオリジナルキャラクター二人のイラストを依頼したいと思います。\n\nキャラクターの容姿や性格はこちらになります：https://sta.sh/21mpb79whjw?edit=1\n\n二人はカップルではなくとにかく仲が悪いです。お互いをいろんな理由で嫌っておりますがいろんな場所で顔を合わせてしまう悪縁みたいな関係です。\n\n構図やシチュエーションなどは全てお任せいたします。ᴰ‌ᴼ‌ᴹ様の鮮やかな色使いが大好きです！\n\nキャラクターの衣装や髪型はどれを描いても、お好きにアレンジしても構いません。黒髪のキャラの方のマスクは着けてなくても大丈夫です。\n\n金額が足りなかった場合やこの依頼が難しく感じましたらお気軽にキャンセルしてください。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/7", "thumbnail_src": "https://si.imgix.net/d98135e7/uploads/origins/4fff70ab-a67f-470f-b80e-0b1e83c68d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11967a610238511b045485cdd4047f99", "thumbnail_srcset": "https://si.imgix.net/d98135e7/uploads/origins/4fff70ab-a67f-470f-b80e-0b1e83c68d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11967a610238511b045485cdd4047f99, https://si.imgix.net/d98135e7/uploads/origins/4fff70ab-a67f-470f-b80e-0b1e83c68d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a391b09ec2ed596a822d02945e90a364 2x, https://si.imgix.net/d98135e7/uploads/origins/4fff70ab-a67f-470f-b80e-0b1e83c68d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44676969a57a101a1afef876c0ed7c3d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n ご多忙中申し訳ありませんが、もし宜ければ個人観賞用のOCカップルのイラストをお願いしたいと思います。 \n容姿などの資料は、以下を参照お願いします。  \nhttps://drive.google.com/drive/folders/1-wgQhwOWWF0oBSsGRareIH6aIKVvfrQP?usp=sharing \n \n先生のスタイルはとても気に入って、描いていただければ嬉しいです。描きたいパロは自由にお選びくださいながら、構図や服装・髪型などもすべてお任せいたします。  \n\n迷惑をかけたら、気軽にキャンセルしてください。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@10domu08/works/6", "thumbnail_src": "https://si.imgix.net/4bdd684a/uploads/origins/75999cc9-cd5c-43f6-8e60-5526a615fdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=810731e248fbc77d1391f2d6c2424b5b", "thumbnail_srcset": "https://si.imgi