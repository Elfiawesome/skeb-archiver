had=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58d650af963dfa89bc804bf8c4f081ac, https://si.imgix.net/e5a7dac7/uploads/origins/35e09b1e-a639-489f-9140-dd2afd05e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d836d868f88d31c73bbb15b7edff8c2 2x, https://si.imgix.net/e5a7dac7/uploads/origins/35e09b1e-a639-489f-9140-dd2afd05e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c90a78c16f1f622c2358d3f3e884267b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@at__zes/works/12", "thumbnail_src": "https://si.imgix.net/ac3b9057/uploads/origins/f1f74624-309d-4c3c-a862-5260f41ad3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2153b3343d6fc42da5832741d40ac3ce", "thumbnail_srcset": "https://si.imgix.net/ac3b9057/uploads/origins/f1f74624-309d-4c3c-a862-5260f41ad3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2153b3343d6fc42da5832741d40ac3ce, https://si.imgix.net/ac3b9057/uploads/origins/f1f74624-309d-4c3c-a862-5260f41ad3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=483eac7e59a180d3007b17a301039417 2x, https://si.imgix.net/ac3b9057/uploads/origins/f1f74624-309d-4c3c-a862-5260f41ad3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8360835e8438dc82eeda0abd52d782aa 3x", "genre": "art", "nsfw": false, "body": "はじめまして！あなたの絵が好きです！\n\nこのキャラクターたちのイラストを描いていただけませんか？現代SFの設定です。ヒーローとヴィランという構図です。\n\nアロイス\n180cm。金髪の男性。とても痩せている。\nおしゃべりでお茶目な性格で、ずるがしこい。普段の表情は満面の笑み。\n超自然的な脅威と戦う組織のメンバーである。\nゲイブが悪役であるにもかかわらず、アロイスは彼に夢中になっている。\n\nゲイブ\n186cm。グレーヘアーの男性。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険な人物でもある。\nエイリアンの技術を利用した会社の悪役リーダーである。\n\nゲイブがアロイスをなじり、脅しているシーンを描いてください。雰囲気は威嚇的です。ポーズや構図はおまかせします。\n\nいずれにせよ、この依頼を読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1atjIzPqghGCslfuaHI8uE5rk5gzVuPSz", "created_at": "", "completed_at": ""}, {"path": "/@at__zes/works/11", "thumbnail_src": "https://si.imgix.net/ab533130/uploads/origins/eb4b12bf-bfb4-4e82-9f4f-87cf940492ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bb956b1ac3e71668c49b9bc989d1296", "thumbnail_srcset": "https://si.imgix.net/ab533130/uploads/origins/eb4b12bf-bfb4-4e82-9f4f-87cf940492ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bb956b1ac3e71668c49b9bc989d1296, https://si.imgix.net/ab533130/uploads/origins/eb4b12bf-bfb4-4e82-9f4f-87cf940492ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29e63387386232e72c8d381ba245bf83 2x, https://si.imgix.net/ab533130/uploads/origins/eb4b12bf-bfb4-4e82-9f4f-87cf940492ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41d7a70688b3728a5556597e8218cbe4 3x", "genre": "art", "nsfw": false, "body": "お邪魔します！子清さんのアートスタイルが大好きです!\nフォルダにあるこのキャラクターを描いてみませんか？\n\n宛名/表現の差分/ドラフトがあれば、psdに入れてどうもありがとうございました。\n構図とポーズはお任せします。\n服装はどちらでも構いません、できれば軍服が欲しいです。\n（条件が難しい場合は、無視して自由に描いてください......!）\n\n青い髪のキャラクターは、大学に通う軍の士官候補生で、過去に教会の聖歌隊に所属しており、クラシック音楽や光るものが好きで、陰気で内向的穏やかな性格、極端な利他主義者という設定です。それ以外にも、自分よりも他人に生きてもらいたい、そのためにいつも自分を傷つけている、そんな少し偏執的で本質的にクレイジーな性格のキャラクターです。\n彼は、他人の夢に入り込んで修正する能力を持っていると設定されています。しばしば他人の夢の中を探索する。血液のような液体を静脈注射することで、他人の夢を助けることができる。今、彼はこの能力を使って、夢を見ることができない人たちに生きる力を与えています。舞台は200年後の技術的に進歩した宇宙SF。\nなお、青の左目は白の瞳、緑の右目は黒の瞳になっています。\n自由に描いてください。\n\n*使用／必ず名前を明記して\n>SNSのアイコンとして使用したり、私のオリジナルキャラクターのサイトで紹介したりする\n*個人での使用やライブ配信での壁紙としての使用（非商用）\n>友人へのグッズ印刷\n\nhttps://drive.google.com/drive/folders/1uUD4tmIAvG_tq3OvBESWxmw1TKbBVgo7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@at__zes/works/10", "thumbnail_src": "https://si.imgix.net/96845086/uploads/origins/e9bc2bde-926b-4d28-bb26-fb0690f086b8?bg=%23fff&auto=format%2Ccompress