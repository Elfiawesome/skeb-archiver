ins/672881e9-c4c0-43a3-bab8-06b60c43cd10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ce698d45217feccec9b869c5dbb0ed6, https://si.imgix.net/d51ef2f3/uploads/origins/672881e9-c4c0-43a3-bab8-06b60c43cd10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e396f2be2215335128013c09e05f8d28 2x, https://si.imgix.net/d51ef2f3/uploads/origins/672881e9-c4c0-43a3-bab8-06b60c43cd10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1985b52da8fca2e199646fde5fab23a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rakugakiunkoman/works/19", "thumbnail_src": "https://si.imgix.net/310c971a/uploads/origins/7588ebe6-1bb4-4f24-ae56-f8540ebc823e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b34a7af09dc2e0cd4c5fa96cd35b824", "thumbnail_srcset": "https://si.imgix.net/310c971a/uploads/origins/7588ebe6-1bb4-4f24-ae56-f8540ebc823e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b34a7af09dc2e0cd4c5fa96cd35b824, https://si.imgix.net/310c971a/uploads/origins/7588ebe6-1bb4-4f24-ae56-f8540ebc823e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aff53bbb81df28e4343205d05c4e8de5 2x, https://si.imgix.net/310c971a/uploads/origins/7588ebe6-1bb4-4f24-ae56-f8540ebc823e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dd8637c28a8a664e566274e8e3faf96 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n日頃からシンフォギア関連、様々な作品の素晴らしいイラストの数々ご拝見させていただいております。\n5月〜6月初め頃に描かれていたクリスちゃんシリーズ等は特に更新を毎日楽しみにさせていただきまして、大変お世話になりました。\n前回のskeb募集時は残念ながらタイミングが合わず募集再開を心待ちにしておりました！\n\n\n以下よりシチュエーション内容をお送りさせていただきます。\nシンフォギアより マリア(ナイトドレス衣装)への乳責め\n①背後から胸揉み\n②揉みながら乳吸い\n\n\nマリア\n・自身の胸を弄る絡み相手の両手を抵抗するように掴む\n※https://twitter.com/Oppai_Dragon5/status/1541164017439633408?t=2SJPeYGKKklTugn7yiBNeA&s=19\nこちらのSSをご参考程度に活用していただけると有り難いです\n・可能であれば縦向きでマリアのニーハイ膝辺りまで描写していただきたいです\n\n\n絡み相手\n・背後からマリアの両胸を両手で揉みしだく\n・マリアの頬を舐める\n・性別やキャラは実在架空問わず先生の描きやすい人物設定でお願いします\n\n\n乳揉み後の続きとして②乳吸い責めもお願いします。\nどちらもマリアの目は開いて羞恥の表情でお願いします。\n\n\n以上の内容でお願い致します。\n制作期間の方はフルに使っていただいて、先生のペースで制作していただいて全然大丈夫です!!\n\nご検討いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@rakugakiunkoman/works/18", "thumbnail_src": "https://si.imgix.net/3d8bc532/uploads/origins/b6663d02-086a-408b-9c92-5c0a963e03c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8aa80f8e8283f98407b616f032f0e25", "thumbnail_srcset": "https://si.imgix.net/3d8bc532/uploads/origins/b6663d02-086a-408b-9c92-5c0a963e03c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8aa80f8e8283f98407b616f032f0e25, https://si.imgix.net/3d8bc532/uploads/origins/b6663d02-086a-408b-9c92-5c0a963e03c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6481ce419bd4c7af168b91a96da3be2a 2x, https://si.imgix.net/3d8bc532/uploads/origins/b6663d02-086a-408b-9c92-5c0a963e03c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eb1fb621d5d7c25e753211600c61ba3 3x", "genre": "art", "nsfw": true, "body": "山井さんの浜風ズリ絵\n「浜風のおっぱいを好きにしたい」 https://www.pixiv.net/artworks/70514100\n「最高だよ。」 https://www.pixiv.net/artworks/80612839\n浜風が嫌々従わされる暗い雰囲気が大好きです。\n心底嫌そうで諦めの表情をした浜風に馬乗りパイズリするバストアップ構図と、\n男がまたがって乳に体重をかけるように腰を打ちつける様子の全身図の2カットをお願いしたいです。\n金額内で可能であれば擬音と身勝手に罵る男のセリフ、あっさりめでいいので色がついていると嬉しいです。\n（注文が多くなってしまった・・・）よろしくご検討お願いします。\n\n次の依頼に繋がってほしいので、何らかの形で公開していただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@rakugakiunkoman/works/17", "thumbnail_src": "https://si.imgix.net/f6ab1a2b/uploads/origins/d3f5cf5f-0714-4654-b8d6-258a728a330e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb08cdf4834c502f177f9f3441fa1096", "thumbnail_srcset": "https://si.imgix.net/f6ab1a2b/uploads/origins/d3f5cf5f-0714-4654-b8d6-258a728a330e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb08cdf4834c502f177f9f3441fa1096, https://si.imgix.net/f6ab1a2b/uploads/origins/d3f5cf5f-0714-4654-b8d6-258a728a330e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb77522e91c5bb3a1843240e21316697 2x, https://si.imgix.net/f6ab1a2b/uploads/origins/d3f5cf5f-0714-4654-b8d6-258a728a330e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b2c83554d593e475033d28f8052994f 3x", "genre": "art", "nsfw": true, "body": "山井先生はじめまして！もし宜しければリクエストご検討お願いします！\n\nシチュ:セックスが上手くて顔が良いだけの悪い男にオナホ扱いされているシンフォギアのマリアさん(衣装はナイトドレスでお願いします)。\n\nリクエスト:対面座位で、マリアさんは男の首に腕を回しながら「ころしゅ…❤️ころしてやるぅ❤️❤️」と説得力の無いトロ顔で抗議しながらも腰が動いちゃって奉仕している感じでお願いします。男の方は両手で乳首をカリカリしながら、勝ち誇って見下すような悪い笑みでマリアさんの表情を堪能し、時折腰を動かして反応を楽しんでいる感じでお願いします。全体としては男は余裕でマリアさんをいじめているのに対し、マリアさんは汗だくで限界が近い感じだと嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@rakugakiunkoman/works/16", "thumbnail_src": "https://si.imgix.net/db251f42/uploads/origins/092f0a08-dde7-4bdf-855d-d22f3f060fd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=950741fd3fbae10360dd6c7b3074b7fa", "thumbnail_srcset": "https://si.imgix.net/db251f42/uploads/origins/092f0a08-dde7-4bdf-855d-d22f3f060fd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=950741fd3fbae10360dd6c7b3074b7fa, https://si.imgix.net/db251f42/uploads/origins/092f0a08-dde7-4bdf-855d-d22f3f060fd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11106f6361aaeb231b95b8e303ee3996 2x, https://si.imgix.net/db251f42/uploads/origins/092f0a08-dde7-4bdf-855d-d22f3f060fd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65dac0234ceab7568e5c10512c81a308 3x", "genre": "art", "nsfw": true, "body": "シンフォギアキャラのダブルフェラ絵が好きです\n\nせっかくなので翼とマリアでもお願いします\n個人的な嗜好で顔射後の2回戦目+愛おしそうな表情にして頂けると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@rakugakiunkoman/works/15", "thumbnail_src": "https://si.imgix.net/791c2d9c/uploads/origins/b0139c6d-3f4f-472d-8bb5-c54d01253438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6028c3f7d95a66593af296434c2490c", "thumbnail_srcset": "https://si.imgix.net/791c2d9c/uploads/origins/b0139c6d-3f4f-472d-8bb5-c54d01253438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6028c3f7d95a66593af296434c2490c, https://si.imgix.net/791c2d9c/uploads/origins/b0139c6d-3f4f-472d-8bb5-c54d01253438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6dc09480dbc0e6a95c7fd5437a4bed9e 2x, https://si.imgix.net/791c2d9c/uploads/origins/b0139c6d-3f4f-472d-8bb5-c54d01253438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=371ed2d355d36620c51c42e8e7c614d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}