at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdb88419703e9319b86cc714137d9b5c, https://si.imgix.net/9d593c22/uploads/origins/78bec0fd-507e-4050-a8be-445a772a15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=134438936a037a034f745868f7fc01cb 2x, https://si.imgix.net/9d593c22/uploads/origins/78bec0fd-507e-4050-a8be-445a772a15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=162f3a458bfbe0ac6008b490d7a2d4b2 3x", "genre": "art", "nsfw": true, "body": "ひなビタ♪から、ここなつ2.0の2人をお願いします。\n衣装\n・ttps://twitter.com/hinabitter/status/1207205458064183298\n・ttps://twitter.com/SOUNDVOLTEX573/status/1207208388632834049\n・ttps://twitter.com/SOUNDVOLTEX573/status/1207209280522219520\n\nR-18差分ありで、全裸差分をお願いします。\n表情、ポーズ等、そのほかおまかせいたします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/38", "thumbnail_src": "https://si.imgix.net/1904e975/uploads/origins/7c05cf4f-6767-44d6-870e-0ab82a46eaf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b697ccc47821153187694f68fb0c890f", "thumbnail_srcset": "https://si.imgix.net/1904e975/uploads/origins/7c05cf4f-6767-44d6-870e-0ab82a46eaf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b697ccc47821153187694f68fb0c890f, https://si.imgix.net/1904e975/uploads/origins/7c05cf4f-6767-44d6-870e-0ab82a46eaf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12d039faf5b442181b0211d0e532c7f3 2x, https://si.imgix.net/1904e975/uploads/origins/7c05cf4f-6767-44d6-870e-0ab82a46eaf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd49f8db5536595bee4d52b1fab9e691 3x", "genre": "art", "nsfw": true, "body": "ネヤ様の魅力的なイラストや漫画をいつも楽しませて頂いています！\n是非うちの子をリクエストさせてください！\n\n■キャラクター\nVRCのうちの子「あーくちゃん」です。\n全身にむちっと重量感がある体型で、特に胸が大きな子で、ゆったりめの性格です\n資料に三面図と画像をいくつか格納しております。\n\n■衣装・アクセサリー\n黄色セーター＋ニーハイの姿でお願いいたします。\n体型バランスはネヤ様の裁量で、大迫力を表現いただきたいです！\n\n■構図・ポーズ\n浮遊感のあるポーズの一枚絵をお願いいたします！\nふんわり優しめの表情で目線を向けている状態で、背景の描写は不要or単色で大丈夫です\n\nよろしくおねがいします！\n\nhttps://drive.google.com/drive/folders/1xUQYZy4jhp1i9-xfVPfLwowD47I5CagW?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/37", "thumbnail_src": "https://si.imgix.net/d6ace253/uploads/origins/33ec550e-2f39-4c6c-ac1f-edbcc5233bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27c2c3fee8f07d5c7c9958104c3570fc", "thumbnail_srcset": "https://si.imgix.net/d6ace253/uploads/origins/33ec550e-2f39-4c6c-ac1f-edbcc5233bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27c2c3fee8f07d5c7c9958104c3570fc, https://si.imgix.net/d6ace253/uploads/origins/33ec550e-2f39-4c6c-ac1f-edbcc5233bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=030e8bbaeb2a12649982ea46f7ffa422 2x, https://si.imgix.net/d6ace253/uploads/origins/33ec550e-2f39-4c6c-ac1f-edbcc5233bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b86647ec41235ca87f7640978bb9671 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/36", "thumbnail_src": "https://si.imgix.net/8c0e49fb/uploads/origins/6b0ac391-4062-41f9-961a-719d862f850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a5e0b06fe6151b64f56501caa441227", "thumbnail_srcset": "https://si.imgix.net/8c0e49fb/uploads/origins/6b0ac391-4062-41f9-961a-719d862f850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a5e0b06fe6151b64f56501caa441227, https://si.imgix.net/8c0e49fb/uploads/origins/6b0ac391-4062-41f9-961a-719d862f850e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cffb3c46b0a0054147d09a5b3f9b7ae5 2x, https://si.imgix.net/8c0e49fb/uploads/origins/6b0ac391-4062-41f9-961a-719d862f850e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d2b4c741190662e30b6006dd74bb70b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/35", "thumbnail_src": "https://si.imgix.net/6eed5c3c/uploads/origins/1c8fd26b-7074-4922-b252-7a36d100e87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4407457c888170b1d0b1b87039dc918d", "thumbnail_srcset": "https://si.imgix.net/6eed5c3c/uploads/origins/1c8fd26b-7074-4922-b252-7a36d100e87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4407457c888170b1d0b1b87039dc918d, https://si.imgix.net/6eed5c3c/uploads/origins/1c8fd26b-7074-4922-b252-7a36d100e87e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0409a584ada0913e46d944bf3fa9bf85 2x, https://si.imgix.net/6eed5c3c/uploads/origins/1c8fd26b-7074-4922-b252-7a36d100e87e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc7e1d79a21b2c2ed6b641f95bf66f55 3x", "genre": "comic", "nsfw": true, "body": "前回(https://skeb.jp/@akaneyasun/works/32)の続きのリクエスト失礼します。ぼっちちゃんがしょたくんの乳首を後ろから責めて耳元で「好き♡好き♡」と連呼しながらアナルバイブと乳首責めの気持ちよさにトロ顔ハート目になっちゃうしょたくんにセルフ顔射をさせて、敏感になってる所をラブ握りをしながら騎乗位をしてぼっちちゃんが「こんなにかわいくても男の子なんだね♡」と言ってお尻とち○ぽを両方気持ちよくさせてラブラブ搾精をするぼっちちゃんのおねしょたシチュお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/34", "thumbnail_src": "https://si.imgix.net/16f521c8/uploads/origins/814de95c-d4ab-4d4e-982a-43a18a4106e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b22ceb1960569d2a235eb0abe8ebfc1", "thumbnail_srcset": "https://si.imgix.net/16f521c8/uploads/origins/814de95c-d4ab-4d4e-982a-43a18a4106e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b22ceb1960569d2a235eb0abe8ebfc1, https://si.imgix.net/16f521c8/uploads/origins/814de95c-d4ab-4d4e-982a-43a18a4106e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=502c41a6170bf51a5d20496c2789cb61 2x, https://si.imgix.net/16f521c8/uploads/origins/814de95c-d4ab-4d4e-982a-43a18a4106e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eeb426242f4408eab10fd9c96b606d1 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております！\n\nもの凄く私事ですが、先日八段に合格したので自分へのお祝いにネヤさんにリクエストさせていただきます！\n\nビートマニアのSolar Eclipseという曲に登場する、通称｢そーらーえくりぷす子｣をお願いします！\n参考ムービー→https://youtu.be/tHDlW8rIq-8?si=y0uIlwiHEsE6o0Ix\n\nこちらをなでなでしているような雰囲気で｢八段合格おめでとう、よく頑張ったね♡｣という台詞、目にはハートマークが浮かんでいて、全体的にムチムチとした肉付きだと更に助かります！\n\nお忙しいとは思いますが、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/33", "thumbnail_src": "https://si.imgix.net/239e27f9/uploads/origins/6f1f3942-a91d-415c-9155-a6ebf90f83c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d05d604e3b22b1218fba1ac9923851", "thumbnail_srcset": "https://si.imgix.net/239e27f9/uploads/origins/6f1f3942-a91d-415c-9155-a6ebf90f83c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d05d604e3b22b1218fba1ac9923851, https://si.imgix.net/239e27f9/uploads/origins/6f1f3942-a91d-415c-9155-a6ebf90f83c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7e61536a6b5bc87115d0253cf9a1ad5 2x, https://si.imgix.net/239e27f9/uploads/origins/6f1f3942-a91d-415c-9155-a6ebf90f83c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c7845f79f4c2222655aab59aadf9e99 3x", "genre": "art", "nsfw": true, "body": "こんばんは、大分性癖闇なおねショタをもしよかったら２シーンほどお願いしてよろしいでしょうか。\n\nサキュバス戦記より、女王ミラージュ\n（https://drive.google.com/file/d/1fueE-NxWAimeCFgQ31JEMMBJnCmBXIPp/view?usp=sharing）\n胸は姫ワルクより盛っていいです。ムチムチ爆乳デカ女！\n性格はうふふ…♥とか言いそうなサキュバスって感じです（適当）\n\nショタ\nちっちゃくて幼い\n股間は巨根巨玉にされてる。玉には淫紋（巨玉参考　https://www.pixiv.net/artworks/103098616）\n\n■画面\npcで見るので４：３の画面にしてほしいです。\nコミックではなく、エッチなpcゲームの敗北シーンと堕ちた後のシーン的な感じです。\n\n■背景\n背景は（https://x.com/setonoyorimiti/status/1378342365820162053/photo/3）みたいなハート広がる魅了空間といった感じ\n\n■■シチュ１■■敗北レベルドレイン\nサキュバスの女王に負けた主人公がショタにされてしまう。さらには淫紋を股間に刻まれ股間が精液タンクにふさわしいモノへと変わってしまう。\nふらふらと近づいた主人公はミラージュに捕まり…的な感じ\n\n構図（画角は真横以外でお願いします。）\nショタは裸\n（https://www.pixiv.net/artworks/111981255）\nのように頭をずっぽりおっぱいに包み込まれフェロモン漬け。足も太ももに拘束されて、ピーンと弓なりに反りかえってる状態。\nおっぱいの中でメロメロにされながらショタは両手でシコシコとオナニー。\nミラージュは両手で巨玉をむぎゅっっと揉んでる状態。\nミラージュの身体からはピンクのオーラが出てショタのレベルを吸い取っていく\nイメージ（https://drive.google.com/file/d/1aTs6ffbVj2o_DQ_ccY2b9aTEkzj8_ojP/view?usp=sharing）\n大量に射精する差分をお願いします。\n\n■■シチュ２■■甘々ＢＡＤＥＮＤ\n体格差のイメージ（https://www.pixiv.net/artworks/66285969）\nレベルを吸われて小さくなって更に幼児化したショタが\n（https://ci-en.dlsite.com/creator/15362/article/1171002）\nの最後のようにおっぱいの上にのせられてぎゅ～っとしがみ付いて顔を谷間に埋めながらヘコヘコしている状態。股間は大きいまま。見えるのは玉ウラの方になると思いますがハートの淫紋。\nなでなでされながらぶびゅ～～～っと大量に射精。細かい構図はお任せ。\n\n真横以外で、フカン気味のカットでお願いしたいのですが、射精がわかりづらいので、上記の構図参考の下乳見上げ構図のカットイン（部分的でいい）をつけて射精を入れてほしいです。\n\nその他\n全体的な雰囲気としてはうわぁぁああ！（絶望）って感じではなく、\n邪悪おねショタで気持ちいいの止まんない…っやめられない…っ感じのイメージです。\n\nもし金額内で可能なら各シーン射精２回くらいでお願いしたいです。\n射精量は大量と言いましたが、バケツぶちまけるくらい大量でＯＫです。\n物理的な事はファンタジーなので気にしないでください。\nあとは金額内で自由に描写してくださって結構です。なんか細かいところ、こっちの方が！と何か思ったら改変自由でＯＫ。\n\n以上です。ニッチな依頼ですが、もし描きたいと思っていただけたらよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/32", "thumbnail_src": "https://si.imgix.net/8e1a60f5/uploads/origins/06c1536e-00a2-4d35-866e-5296aae86bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dad8a4261f004b5510227e041326081", "thumbnail_srcset": "https://si.imgix.net/8e1a60f5/uploads/origins/06c1536e-00a2-4d35-866e-5296aae86bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dad8a4261f004b5510227e041326081, https://si.imgix.net/8e1a60f5/uploads/origins/06c1536e-00a2-4d35-866e-5296aae86bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e3aa2102d19c3d93a02232ea4f30979 2x, https://si.imgix.net/8e1a60f5/uploads/origins/06c1536e-00a2-4d35-866e-5296aae86bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2375e101ac67d5a80a3153c9ecff9f08 3x", "genre": "comic", "nsfw": true, "body": "前回(https://skeb.jp/@akaneyasun/works/25)のおねショタぼっちちゃんが良かったので続きのリクエスト失礼します。ショタくんに牛柄ビキニからメイドビキニに着替えさせて恥ずかしがりながら勃起しちゃうショタくんにぼっちちゃんが「かわいい顔して勃起しちゃうなんていけない子だね...♡」と言ってラブ握りをしながら濃厚舌フェラ糸引きディープキスをしてパンツ越しに敗北射精させて、とろとろになってアヘ顔ハート目になっちゃってるショタくんにパイズリをして、寸止めをしても出ちゃう程の早漏ショタくんのかわいさにデレちゃって、アナルバイブをショタくんのお尻に入れて、女の子みたいに喘いじゃうショタくんに強制種付けプレスをさせて、出そうになった所をだいしゅきホールドでがっしり抑え込んで敗北射精をさせてだいしゅきホールドでぱんぱんと搾精させて連続でショタくんをアヘトロ顔ハート目をしながら無様射精をさせて、事後にはお互いにドロドロの精液まみれになってハート目になりながらビクビクして「好き♡しゅき♡」と言うショタくんに頭を撫でてショタを気持ち良くさせる体格差おねショタシチュをお願いします。ぼっちちゃんの体格は前回同様でも大丈夫です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/31", "thumbnail_src": "https://si.imgix.net/f3ab38c1/uploads/origins/45a1835b-e020-44f3-9b7f-c8c4001cc120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=725f5e0dcebb2d7a2f4be08eadea6943", "thumbnail_srcset": "https://si.imgix.net/f3ab38c1/uploads/origins/45a1835b-e020-44f3-9b7f-c8c4001cc120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=725f5e0dcebb2d7a2f4be08eadea6943, https://si.imgix.net/f3ab38c1/uploads/origins/45a1835b-e020-44f3-9b7f-c8c4001cc120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d25b6a0a77005c8e2d87a9e84e51c060 2x, https://si.imgix.net/f3ab38c1/uploads/origins/45a1835b-e020-44f3-9b7f-c8c4001cc120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ac56d8eb0fdb473594e1db47735f730 3x", "genre": "comic", "nsfw": true, "body": "初めまして。\n花騎士（フラワーナイトガール）のカトレアのおねショタイチャラブ着衣縦パイズリをお願いします。\n\nキャラと衣装は下記URL参照\nhttps://i.imgur.com/vWocYd5.jpeg\nhttps://i.imgur.com/IOJmO5E.jpeg\n\n・竿役はショタ化した巨根の団長\n\n・資料URLのようにカトレアの胸の大きさは頭1.5～2個分くらいで、ブラウスのボタンを全て閉じているが、ボタンの隙間から乳肉がはみ出るくらいギチギチの状態\n\n・まずショタがギンギンに勃起した巨根を曝け出し、カトレアがショタの目線の高さを合わせるように座り込む\n\n・ショタは自らの巨根をカトレアのおっぱいの正面のボタンの隙間からズブズブと無理矢理ねじ込み、縦パイズリをし始める\n\n・ショタはおっぱいを両手で持ち上げるように強く掴み、一心不乱に腰を激しく打ち付ける（この画は真横視点でお願いします）\n\n・可能でしたら胸の中に挿入されている竿の位置がシルエットでわかるようになっていると嬉しいです\n\n・そのままパイズリをしながら二人はディープキスをして乳内に大量射精\n\n・最後にまだ勃起が治まらないショタが下記作品のようにおっぱいに全身で抱きつき、腰を振り続け再び乳内射精して終了\nhttps://skeb.jp/@akaneyasun/works/24\n\n・衣装の細かい装飾などは省略して頂いても構いません\n\nもし可能でしたらご検討よろしくお願いします。\n\nhttps://skeb.jp/@Kloah13th/works/347", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/30", "thumbnail_src": "https://si.imgix.net/a5dfa7d8/uploads/origins/17c44efa-dd5a-4ddb-968a-03f0fbaa5a69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6054d9255ab032c6b5c5be16cdb028aa", "thumbnail_srcset": "https://si.imgix.net/a5dfa7d8/uploads/origins/17c44efa-dd5a-4ddb-968a-03f0fbaa5a69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6054d9255ab032c6b5c5be16cdb028aa, https://si.imgix.net/a5dfa7d8/uploads/origins/17c44efa-dd5a-4ddb-968a-03f0fbaa5a69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4d2a5cc27cd553edeb3ca10ef8d57c6 2x, https://si.imgix.net/a5dfa7d8/uploads/origins/17c44efa-dd5a-4ddb-968a-03f0fbaa5a69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=429c709fea180c51ee288624ce1b9ca5 3x", "genre": "comic", "nsfw": true, "body": "こんにちは！！！！！！\nいつもうちの子達に寄り添った景色を届けてくれてありがとうございます！！！！\n\n今回はうちの子2人、『透羽 優芽(ｽｸﾊ ﾕﾒ)』ちゃんと『陽珠 陸(ﾋﾀﾞﾏ ﾘｸ)』くんの一幕をお願いしたいです!!\n\n\nシチュエーションは、\n・優芽ちゃんは基本、左目(ハイライトの無い蒼い方)は閉じてる\n・優芽ちゃん→陸くんの呼び方「陸くん」\n・陸くん→優芽ちゃんの呼び方「優芽さん」\n\n\n『透羽寝具店』へと、喫茶『ひだまり』からの軽食セットの出前配達にやってきた陸くん\n入口で一度声を掛けるも応答なし\n\n「こんちわー、『ひだまり』でーす！」\n「御注文の商品お持ちしましたー……って、あれぇ？」\n↓\n店内に入って姿を探してると、ドアカーテンで仕切られた奥の部屋から物音がしたので陸くんが覗き込んだところ、優芽ちゃんがニットセーターを脱ぎかけてる場面に遭遇\n\n・脱ぎ方は交差脱ぎ\n・セーターの下は薄手の白いキャミソール+下着\n・下着の色は青系\n・キャミソールはセーターを脱ぐ時に引っ張られてずり上がってる\n・ちょっと汗ばんでる\n・体の周囲にうっすらと迸る電気(特にツノの周り)\n↓\n赤面しながら急いで引き返す陸くん\n動じてない優芽ちゃん\n「すすすｯ…すいませんｯｯ！！」\n「あらあら〜、今日も元気ねぇ〜」\n↓\n謝罪する陸くん\n宥める優芽ちゃん\n「すいませんでしたｯｯｯｯ！！！！！！！！！！」\n「気にしなくていいよぉ、こっちこそごめんね〜」\n「今日暖かかったでしょ？それでちょっと暑くなってきちゃって…」\n「お届けが来ちゃう前にぱぱーっと着替えちゃおって思ったんだけど…予想より速かったよぉ〜、流石だね!」\n↓\nフェードアウトしながら吹き出し内にデフォルメお顔\n「それより、配達お疲れ様!折角来てくれたんだしお茶でもどう〜？」\n「ぁ……喜んで…！」\n\n\n大筋は上記のような流れでお願いしたいです…!!\n進行の自然さや見えた景色があれば、適宜ピントを合わせて戴ければ…！！\n\n可能であれば、着替えシーンで左目が開いてるものと閉じてるものの2パターンあるととても嬉しいです……！！\n\n何卒よろしくお願いしますですっ…！！\n\nhttps://twitter.com/usaki_otome/status/1766552738329141405?t=qRmoQFMLQuPDXFQ_FNqS5A&s=19", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/29", "thumbnail_src": "https://si.imgix.net/182f1bcf/uploads/origins/26813e13-657a-48ce-ac14-b1edd22c6b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4ad6a795b1152b59e7ec8269cbca1e0", "thumbnail_srcset": "https://si.imgix.net/182f1bcf/uploads/origins/26813e13-657a-48ce-ac14-b1edd22c6b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4ad6a795b1152b59e7ec8269cbca1e0, https://si.imgix.net/182f1bcf/uploads/origins/26813e13-657a-48ce-ac14-b1edd22c6b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9e6cd34f884e432e80320af29077147 2x, https://si.imgix.net/182f1bcf/uploads/origins/26813e13-657a-48ce-ac14-b1edd22c6b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdfa510aa232f1fe0818da470bdc7177 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/28", "thumbnail_src": "https://si.imgix.net/caa7fa26/uploads/origins/76ea1f4f-e7ff-4d8d-a0ab-a8d564456ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f3d359dad9ca07f5708016be9135d97", "thumbnail_srcset": "https://si.imgix.net/caa7fa26/uploads/origins/76ea1f4f-e7ff-4d8d-a0ab-a8d564456ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f3d359dad9ca07f5708016be9135d97, https://si.imgix.net/caa7fa26/uploads/origins/76ea1f4f-e7ff-4d8d-a0ab-a8d564456ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f2c633b7e63e142a1df6cc491c22c6 2x, https://si.imgix.net/caa7fa26/uploads/origins/76ea1f4f-e7ff-4d8d-a0ab-a8d564456ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eca6c13284914da83e6a8e25913819d4 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n昔のアニメのキャラになりますが、ご検討いただければ幸いです。\n\n【キャラクター】\nスーパードール★リカちゃんより女悪魔ミスティ(https://files.catbox.moe/4vjv7q.png)\nアップ(https://files.catbox.moe/sia62v.png)\nと蕗谷トモノリ少年(https://files.catbox.moe/wbbjoq.png)\n\n・シチュエーション\n妊娠して臨月ボテ腹のミスティが、トモノリに跨り気持ち良さそうにおねショタえっち。\n2人とも全身汗だくで、ミスティの大きな乳房から母乳が吹き出している。\n台詞は「んふふっ、そんなにアタシのおっぱい美味しいのかい？」「坊やの赤ちゃん、ちゃんと産んであげるからね♡」という感じです。\n擬音はお任せします。\n\n・服装\nミスティ：上着を乳房の上へたくし上げ、黒のロングソックスを履いている。\nトモノリ：全裸。\n・背景\n子供部屋、白いシーツの上\n\nリクエストは以上です。\n問題が無ければ、是非ともよろしくお願いします。\n\nhttps://files.catbox.moe/vqk52z.jpg", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/27", "thumbnail_src": "https://si.imgix.net/ecea2808/uploads/origins/854df179-9796-42e2-a4ca-4b717308594f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cc61c2cfee29cf63d838e82e6c2c5ae", "thumbnail_srcset": "https://si.imgix.net/ecea2808/uploads/origins/854df179-9796-42e2-a4ca-4b717308594f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cc61c2cfee29cf63d838e82e6c2c5ae, https://si.imgix.net/ecea2808/uploads/origins/854df179-9796-42e2-a4ca-4b717308594f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3083243cb5248661b8930c0f6294104 2x, https://si.imgix.net/ecea2808/uploads/origins/854df179-9796-42e2-a4ca-4b717308594f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eed7d5b489b7d27dfc8725224e3957b5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！！！！！！！！！！！！\nお久しぶりになっちゃいましたが、ネヤさんの描いてくれるｳﾁｬﾉｺだいすきなのでまたお願いに参りました！！！！！！！\n\n今回は、うちの子のひとり『成那 月(ﾅﾙﾅ ﾙﾅ)』ちゃんをお願いしたいです！！！\n\n服装は「かじゅあるなちゃ」のツイートにあるような軽装で、微笑みを浮かべたお顔をしてる姿をお願いします！！！\n\n何卒よろしくお願いしますですっ……！！！！\n\nhttps://twitter.com/usaki_otome/status/1747233780061130793?t=QYNWefvDdOyjIR6kajmxQQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/26", "thumbnail_src": "https://si.imgix.net/7ca12090/uploads/origins/0b223b33-7d5b-4015-96fd-020d4e01f443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c4f6a52b437a6313ee112602be7791", "thumbnail_srcset": "https://si.imgix.net/7ca12090/uploads/origins/0b223b33-7d5b-4015-96fd-020d4e01f443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c4f6a52b437a6313ee112602be7791, https://si.imgix.net/7ca12090/uploads/origins/0b223b33-7d5b-4015-96fd-020d4e01f443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c59009e47bf30eed2ffac9a634bb0ea9 2x, https://si.imgix.net/7ca12090/uploads/origins/0b223b33-7d5b-4015-96fd-020d4e01f443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d7d8c3e44150fa5567c28e0ecff6d5e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、https://skeb.jp/@akaneyasun/works/20に出てきたショタくんが可愛いかったのでこの子の単体絵のリクエスト失礼します。夜に廃墟の屋敷に忍び込んで色々と探索し、「入るな」と書かれたドアを見つけてどうしても気になってドアを開けてしまい中に入ったら閉じ込められ急に催淫ガスが充満し、凄い勢いでズボン越しに射精をして自分の顔にかかってしまい、何もしてなくても射精が止まらなくなり、自分の精子の臭いと味で興奮しながらハート目でとろんとろんになっていた所に舌付き触手にズボンを破かれて、ショタくんのちんぽに勢いよくバキューム皮フェラをして更に搾精して、手足も縛られていないのに触手のお口マンコに抵抗せず足ピンしながら女の子みたいに喘ぎマゾイキしまくって、最終的に潮を吹いてしまう絵をお願いします。触手のデザインは、ネヤさんのお好みで描いても大丈夫です。\nよろしくおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/25", "thumbnail_src": "https://si.imgix.net/1e51864a/uploads/origins/b2645789-fba2-46ab-a599-44c3c2120d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf2ebead59dc85471ef8bd9884cdedd2", "thumbnail_srcset": "https://si.imgix.net/1e51864a/uploads/origins/b2645789-fba2-46ab-a599-44c3c2120d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf2ebead59dc85471ef8bd9884cdedd2, https://si.imgix.net/1e51864a/uploads/origins/b2645789-fba2-46ab-a599-44c3c2120d94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe945dcc8e3f975ac3ccefa283e15632 2x, https://si.imgix.net/1e51864a/uploads/origins/b2645789-fba2-46ab-a599-44c3c2120d94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fab2d947c9f0462acd226e11ef00e907 3x", "genre": "art", "nsfw": true, "body": "前回のおねショタぼっちちゃんがとても良かったので続きのリクエスト失礼します。(https://skeb.jp/@akaneyasun/works/19)\nぼっちちゃんがショタくんに牛柄ビキニを着せて更に乳首ローターを付けたり、エネマグラをアナルに入れてバキュームフェラをし、未だかつて無い程の快楽に襲われてアへトロ顔ハート目をしながら敗北射精をしてしまい、口移しザーメンディープキスでショタを蕩けさせてから、ラブ握り強制種付けプレスをさせて更に甘い声で「好き♡しゅきぃ♡」と言いながら喘いじゃうショタくんをだいしゅきホールドで搾精しながら頭を撫でて可愛いがる体格差おねショタぼっちちゃんをお願いします。\n\nぼっちちゃんの体格は前回同様顔に対して体がだらしないぽっちゃり爆乳体格でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/24", "thumbnail_src": "https://si.imgix.net/d411dcaf/uploads/origins/e80ea82c-82fb-431f-8f45-4d4121134d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a5b38650f56a5da50e77340c6ee7489", "thumbnail_srcset": "https://si.imgix.net/d411dcaf/uploads/origins/e80ea82c-82fb-431f-8f45-4d4121134d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a5b38650f56a5da50e77340c6ee7489, https://si.imgix.net/d411dcaf/uploads/origins/e80ea82c-82fb-431f-8f45-4d4121134d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82d9b8bfcf9c248249e13a4b60354ac0 2x, https://si.imgix.net/d411dcaf/uploads/origins/e80ea82c-82fb-431f-8f45-4d4121134d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=903468c382de533ad7ac91d514a33b40 3x", "genre": "art", "nsfw": true, "body": "無知なショタくんが吸血鬼が出ると噂の無人の路地裏に向かうと不幸にも姫アルク(メルブラAACC版 )に出くわしてしまい、魔術で魅了され自分から腰を振ってへこへこと姫アルクに可愛がりながらパイズリをされにいって乳内で精通してしまい、トロ顔になりながらへばってるショタくんのちんぽを魔術で感度を上げて早漏よわよわちんぽにして、女の子みたいに喘いで更に足ピンしながらマゾイキしちゃうショタくんをちんぐり騎乗位で搾精して、アへトロ顔ハート目になりながらショタくんを敗北マゾアクメ射精をさせまくる姫アルクの体格差おねショタシチュをお願いします。\n\n姫アルクの体格はお腹からお股までむちむちに盛って、おっぱいも爆乳くらいの大きさでお願いします。(資料も貼っておきます。)\n\nショタくんは可愛い系で小学4、5年生の年齢くらいでお願いします。\n\nhttps://youtu.be/GKtnTVWHRH0", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/23", "thumbnail_src": "https://si.imgix.net/1c209082/uploads/origins/75edfc6e-9b2b-429a-9cfe-eca0b58beede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da41a81147fec3f35da33908fa424ed9", "thumbnail_srcset": "https://si.imgix.net/1c209082/uploads/origins/75edfc6e-9b2b-429a-9cfe-eca0b58beede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da41a81147fec3f35da33908fa424ed9, https://si.imgix.net/1c209082/uploads/origins/75edfc6e-9b2b-429a-9cfe-eca0b58beede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ec43137ff3f4c3a1ffab5d226083acf 2x, https://si.imgix.net/1c209082/uploads/origins/75edfc6e-9b2b-429a-9cfe-eca0b58beede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e77f64b85640b5206cc6b4aba1110a0e 3x", "genre": "art", "nsfw": true, "body": "ちょっとニッチなリクエスト失礼します\n\nサキュバスが仕掛けた\n爆乳壁乳オナホエロトラップに無知なショタくんがトラップの催淫ガスを吸っただけで\n精通してしまい、自分から腰を振ってへこへことパイズリをされに行って、かわいいアへトロ顔であん♡あん♡喘ぎながら敗北射精をしてしまい、精液まみれになりながらも無様射精をしながらハート目で蕩けてマゾ堕ちしてしまうショタくんをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/22", "thumbnail_src": "https://si.imgix.net/2236012a/uploads/origins/701cce22-8e56-43fe-b1af-ba71e3a5dd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc84d75ec0c483b444196d6e65678ef", "thumbnail_srcset": "https://si.imgix.net/2236012a/uploads/origins/701cce22-8e56-43fe-b1af-ba71e3a5dd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc84d75ec0c483b444196d6e65678ef, https://si.imgix.net/2236012a/uploads/origins/701cce22-8e56-43fe-b1af-ba71e3a5dd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5921a6bcdfcbdb53c29dd7f86b7deaeb 2x, https://si.imgix.net/2236012a/uploads/origins/701cce22-8e56-43fe-b1af-ba71e3a5dd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=929d59bca3eca2192e08436673af083b 3x", "genre": "art", "nsfw": false, "body": "今回は、うちの子りこちゃんのパパとママ、『陽珠 星一(ﾋﾀﾞﾏ ｼｮｳｲﾁ)』さんと『陽珠 鈴(ﾋﾀﾞﾏ ﾘﾝ)』ちゃんを描いて戴きたいです!!\nシチュエーションとしては、\n・鈴ちゃんはうっとりとした笑顔\n・星一さんはちょっぴり照れてるようなはにかみ笑顔\n・お互いの左手薬指には結婚指輪\n・二人だけの時間に心から酔いしれている\nという感じでお願いしたいです!!\n\n何卒よろしくお願いしますです…!!!\n\nhttps://twitter.com/usaki_otome/status/1646648130136588288?t=nvQ5sI7-PpfSQX8Oo49snA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/21", "thumbnail_src": "https://si.imgix.net/ff58bc8b/uploads/origins/46654744-f978-4fd2-b80f-dfcf183d636a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49df328c3ccbbc6c4455a605b78a8a91", "thumbnail_srcset": "https://si.imgix.net/ff58bc8b/uploads/origins/46654744-f978-4fd2-b80f-dfcf183d636a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49df328c3ccbbc6c4455a605b78a8a91, https://si.imgix.net/ff58bc8b/uploads/origins/46654744-f978-4fd2-b80f-dfcf183d636a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46c80a0740e8310d3ac4b0cb2fc2848f 2x, https://si.imgix.net/ff58bc8b/uploads/origins/46654744-f978-4fd2-b80f-dfcf183d636a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88cb5fb30154822e75d519960322b106 3x", "genre": "art", "nsfw": true, "body": "ネヤさんに先日リクエストした梨子ちゃんの出産絵が非常に良かったので、再度リクエストを送ります。\nご検討いただければ幸いです。\n\n【キャラクター】\n朝香果林(ラブライブ!虹ヶ咲学園スクールアイドル同好会)\n\n【シチュエーション】\n妊娠して臨月の大きなお腹の果林さんが、スポットライトに照らされたステージ上で赤ちゃんを産み落とす出産ショー。\n果林さんはガニ股立ちで全身汗だく、両手は頭の後ろに組んでいます。\n\n以下の段落で出産の過程を希望します。\n①破水。観客へ微笑む。\n「ふふっ、今日は私の出産ショーに来てくれてありがとね♡」「この子ったら、さっきから『早く出たいよぅ』って暴れてるのよ。まったく、誰に似たのかしら♡」\n「とくんっ♡とくんっ♡」とお腹の赤ちゃんが胎動。\n②赤ちゃんの頭頂部が出てくる。陣痛の痛みに苦しむ。\n③赤ちゃんの全身が出てくる。絶頂し母乳がたくさん吹き出る。\n④出産を終えお腹が萎む。力尽き放心状態。母乳が弱々しく垂れている。\n\n【服装】\n資料画像のビキニのブラを胸の上にたくし上げ、パンティは片方の脚に引っ掛かったままです。\n\n【台詞・擬音】\n最初の段落以外はお任せします。\n\nリクエストは以上です。\n大丈夫そうであれば、是非ともよろしくお願いします。\n\nhttps://i.imgur.com/CU2tQqC.png", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/20", "thumbnail_src": "https://si.imgix.net/5308e612/uploads/origins/ac85eac8-62e5-42c8-b6cb-7c5bd55bc423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1e63fc52d8cec9ed68bc98f30ee8d7", "thumbnail_srcset": "https://si.imgix.net/5308e612/uploads/origins/ac85eac8-62e5-42c8-b6cb-7c5bd55bc423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1e63fc52d8cec9ed68bc98f30ee8d7, https://si.imgix.net/5308e612/uploads/origins/ac85eac8-62e5-42c8-b6cb-7c5bd55bc423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25f5d53dd44345eed38571c52b0b3ead 2x, https://si.imgix.net/5308e612/uploads/origins/ac85eac8-62e5-42c8-b6cb-7c5bd55bc423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2278b497834e2666d2aa5bc3fad0a1f1 3x", "genre": "art", "nsfw": true, "body": "無知で未精通なショタデュエリストが禁止カード、ユニオン・キャリアー(https://www.db.yugioh-card.com/yugiohdb/card_ )をリンク召喚してしまい、黒き森のウィッチ(https://www.db.yugioh-card.com/yugiohdb/card)がお仕置としてショタをパイズリで精通させて、強制種付けプレスでショタをへこへこさせてかわいい声で喘いで敗北射精をしてしまうショタに黒き森のウィッチが糸引きディープキスで調教しながら搾精し、マゾに堕とすあまあまおねショタ体格差シチュをお願いします。\n\nショタはデブやクソガキではなく、かわいい系で小学4年生から5年生位の年齢でお願いします。\n\n黒き森のウィッチの体格はお腹からお股までむちむち爆乳体格でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/19", "thumbnail_src": "https://si.imgix.net/e98ae76c/uploads/origins/1f75f96e-b414-4969-ae26-6be23472ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4337ee53331aa80c4f2d2bec881a5f2", "thumbnail_srcset": "https://si.imgix.net/e98ae76c/uploads/origins/1f75f96e-b414-4969-ae26-6be23472ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4337ee53331aa80c4f2d2bec881a5f2, https://si.imgix.net/e98ae76c/uploads/origins/1f75f96e-b414-4969-ae26-6be23472ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b1e513ff157c14c6a21b96264a485ad 2x, https://si.imgix.net/e98ae76c/uploads/origins/1f75f96e-b414-4969-ae26-6be23472ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fde1fa3cbbc744583092b6e7661e679 3x", "genre": "art", "nsfw": true, "body": "無知なショタが後藤ひとり(ぼっち・ざ・ろっく！)にパイズリで精通させられて、激しいお掃除皮フェラ＋前立腺責めでショタをかわいい声で喘がせて更に連続射精をさせて、だいしゅきホールドで逃げないように押さえ搾精し、最後にデイープキスだけで敗北射精させてショタをアへ顔ハート目にしてマゾに堕とすおねショタ体格差逆レイプシチュをお願いします。\n\nショタは小学4年生から5年生位で、可愛らしい感じでお願いします\n\n後藤さんはお腹からお股までのぽっちゃり体型で、顔に対して身体がだらしない形で(胸は爆乳くらいに盛って欲しいです)、責められちゃってるショタに「ふひひ...♡」という感じでデレちゃう感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/18", "thumbnail_src": "https://si.imgix.net/a385d919/uploads/origins/2514d4d6-2cd2-428c-8f39-f496f2bc4704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ed59743c2d67df58dba5437d2712f38", "thumbnail_srcset": "https://si.imgix.net/a385d919/uploads/origins/2514d4d6-2cd2-428c-8f39-f496f2bc4704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ed59743c2d67df58dba5437d2712f38, https://si.imgix.net/a385d919/uploads/origins/2514d4d6-2cd2-428c-8f39-f496f2bc4704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e732e48eb95d273203ff3b5203009fe 2x, https://si.imgix.net/a385d919/uploads/origins/2514d4d6-2cd2-428c-8f39-f496f2bc4704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e65f034339c5b517a98198a3b032d398 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！！！！！\n重ね重ね、持ち味たっぷりで素敵なｳﾁｬﾉｺを描いて戴いてるネヤさんにまたお願いしたくて参りました…!!\n\n今回はうちの仲良しうさちゃん姉妹、久留美 苺花ちゃんと久留美 華菜ちゃんの二人をお願いしたいのです…！\n\nシチュエーションは、\n\n・入店した此方を二人がお出迎えしてくれた場面\n・苺花ちゃんは天真爛漫な笑顔、華菜ちゃんはほんわかした笑顔\n(出来れば二人とも瞳の色が見える形での笑顔だと有り難いです…!)\n・店内は明るいフルーツパーラー様の内装\n\nという場面をお願いしたいです！\n\nなにとぞよろしくお願いしますです…！！\n\nhttps://twitter.com/usaki_otome/status/1608525212206919680?t=ZxFPZybK1PEpBAvELQ5nWA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/17", "thumbnail_src": "https://si.imgix.net/91f0c9db/uploads/origins/7273e82a-d2a6-4e5a-94d1-5c72dfa4352b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=399c0ccd72379d3295183daa0925943b", "thumbnail_srcset": "https://si.imgix.net/91f0c9db/uploads/origins/7273e82a-d2a6-4e5a-94d1-5c72dfa4352b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=399c0ccd72379d3295183daa0925943b, https://si.imgix.net/91f0c9db/uploads/origins/7273e82a-d2a6-4e5a-94d1-5c72dfa4352b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7b5b10cfddc33617659bc434243cd99 2x, https://si.imgix.net/91f0c9db/uploads/origins/7273e82a-d2a6-4e5a-94d1-5c72dfa4352b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cf0909c0c15568d17fcc5cdd421e397 3x", "genre": "art", "nsfw": true, "body": "前回の続きのリクエスト(https://twitter.com/akaneyasun/status/1568221412112072704?s=46&t=DoSss7-pPbMmSDDsR8em3Q)失礼します。\nすっかりマゾに堕ちたショタを強制種付けプレスで腰をへこへこさせてアヘトロ顔ハート目になりながらかわいい声で情けなくあん♡あん♡喘いで、出そうになって腰を引こうとしてるショタをだいしゅきホールドで逃がさないように押さえ込み、敗北射精をさせてまだ射精てるにも関わらずだいしゅきホールドでぱんぱん搾精してショタを膣内で男潮吹きをさせる暴走アルクェイド(メルブラ)をお願いします。\n\nもし描ければ事後差分にお互いに精液まみれになりながらショタを舌フェラディープキスをする差分もお願いします。\n\n前回同様暴走アルクェイドの体格はおっぱいやお股をむちむちに盛って大丈夫です。一応資料も載せておきます、よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/76050444", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/16", "thumbnail_src": "https://si.imgix.net/b7a5199d/uploads/origins/0c3b659d-b92e-485a-b3ef-4a8e782a7784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98e71337b15ba75a04ffa058e6fd0887", "thumbnail_srcset": "https://si.imgix.net/b7a5199d/uploads/origins/0c3b659d-b92e-485a-b3ef-4a8e782a7784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98e71337b15ba75a04ffa058e6fd0887, https://si.imgix.net/b7a5199d/uploads/origins/0c3b659d-b92e-485a-b3ef-4a8e782a7784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59e4871a607d473f9a2c671177e32c79 2x, https://si.imgix.net/b7a5199d/uploads/origins/0c3b659d-b92e-485a-b3ef-4a8e782a7784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a0a9b0a7a2f8a6fe36684d422950f54 3x", "genre": "art", "nsfw": true, "body": "【キャラクター】\n桜内梨子(ラブライブ!サンシャイン!!)\n\n【シチュエーション】\n妊娠して臨月の大きなお腹の梨子ちゃんが、白いシーツの上であおむけになって赤ちゃんを出産。\n梨子ちゃんは全身汗だくで、乳首から母乳が吹き出しています。また陣痛の痛みで大泣きしています。\n秘部から赤ちゃんの頭頂部が出てきており、髪の色は薄いオレンジ色を希望します。\n\n【服装】\n黒のロングソックスを履いています。\n薄いピンク色のパンティが片方の脚に引っかかったままです。\n\n【その他】\nレイヤー分けで簡単な擬音もお願いします。\n苦しそうな吐息、母乳が吹き出る音、「ぐぷっ♡ぐぷっ♡」と赤ちゃんが出てくる音、「とくんっ♡とくんっ♡」というお腹の赤ちゃんの胎動。\n\nリクエストは以上です。\n問題がなければ、是非ともよろしくお願いします。\n\nhttps://i.imgur.com/DlpB8tD.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@akaneyasun/works/15", "thumbnail_src": "https://si.imgix.net/49c73c62/uploads/origins/5344852d-384b-460c-815e-c404b1da1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c54027cf7a1ec64fdfb493bcd1539d39", "thumbnail_srcset": "https://si.imgix.net/49c73c62/uploads/origins/5344852d-384b-460c-815e-c404b1da1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c54027cf7a1ec64fdfb493bcd1539d39, https://si.imgix.net/49c73c62/uploads/origins/5344852d-384b-460c-815e-c404b1da1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f