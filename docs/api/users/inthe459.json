-923f-3e0101d7f38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a651dca1905b22af76a3830b40f49ef0", "thumbnail_srcset": "https://si.imgix.net/d7771253/uploads/origins/016b89f5-0d00-4fe9-923f-3e0101d7f38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a651dca1905b22af76a3830b40f49ef0, https://si.imgix.net/d7771253/uploads/origins/016b89f5-0d00-4fe9-923f-3e0101d7f38e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20ffe32050d459eb774fe761376956b6 2x, https://si.imgix.net/d7771253/uploads/origins/016b89f5-0d00-4fe9-923f-3e0101d7f38e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d50dd2c22212befad20a61e85ab9658 3x", "genre": "art", "nsfw": false, "body": "前回のリクエストに応えていただき、ありがとうございました。\nhttps://skeb.jp/@inthe459/works/90\n\nまたエステルを描いてください。\n\nhttps://drive.google.com/drive/folders/1EpWgIsdplVfwMe4HmfCDbpcRzOc7KhwD?usp=share_link\n\nエステルはエレガントで大人しく、内向的なOL。親しい人にはからかうこともある。\n\nこの衣装で彼女を描いてください：\nhttps://x.com/Soleilmtfbwy03/status/1870679582376103964\n\n上の資料では、衣装の露出の主な原因は左腕の位置にある。\nエステルについては、彼女の翼を衣装の露出の原因にしてほしい。\n\nこれをさらに詳しく説明するために、ラフ画を描いてみた：\nhttps://drive.google.com/file/d/1kj4sMIBcB_Y_f-xsRz1cjg1aRa473WWt/view?usp=drive_link\n\n衣装の色をエステルの配色に合うように編集してください。\n帽子の黒いバラを青い紫陽花に変えてください。\n\nミステリアスでいたずらっぽい雰囲気にしてほしい。背景は暗い路地でもいいかもしれません。\n\nポーズのアイデアとしては、彼女が魔法の本を持っていて、カードやしおりが魔法のように彼女の周りに浮かんでいる。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/94", "thumbnail_src": "https://si.imgix.net/d88e1ff3/uploads/origins/2477eec2-e775-4514-aaa3-735ec0a24bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c26bac0acac9a7d3542772d5bdcfe11c", "thumbnail_srcset": "https://si.imgix.net/d88e1ff3/uploads/origins/2477eec2-e775-4514-aaa3-735ec0a24bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c26bac0acac9a7d3542772d5bdcfe11c, https://si.imgix.net/d88e1ff3/uploads/origins/2477eec2-e775-4514-aaa3-735ec0a24bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c326c25e36fe1541e8a4760de3c7c43 2x, https://si.imgix.net/d88e1ff3/uploads/origins/2477eec2-e775-4514-aaa3-735ec0a24bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab1b9d3f9f1801804063251dd8d59ab0 3x", "genre": "art", "nsfw": false, "body": "\nうちの子もこんなポーズの作品お願いしたいです：\nhttps://x.com/hieumayart/status/1982422082349842709\n\n氷をテーマにしているので、作品自体も氷をテーマにしたものがあると嬉しいです～。\n表情や雰囲気は自由ですし、ポーズも彼女に合うように自由に修正してください！どんな作品に仕上がるか楽しみです～ :>。\n\nリクエストにお答えいただきありがとうございました！\n\nhttps://www.deviantart.com/stash/21uddkcwk32j", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/93", "thumbnail_src": "https://si.imgix.net/f6882c14/uploads/origins/e781f74c-63c9-4bdb-af98-e8c35e32691d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85d0e72233902346c6b4da24f236edcb", "thumbnail_srcset": "https://si.imgix.net/f6882c14/uploads/origins/e781f74c-63c9-4bdb-af98-e8c35e32691d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85d0e72233902346c6b4da24f236edcb, https://si.imgix.net/f6882c14/uploads/origins/e781f74c-63c9-4bdb-af98-e8c35e32691d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6047c87a54de150b65cdf44a61bfc65 2x, https://si.imgix.net/f6882c14/uploads/origins/e781f74c-63c9-4bdb-af98-e8c35e32691d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa4298f9881cc444ba769d6400555533 3x", "genre": "art", "nsfw": false, "body": "こんにちは！最近あなたの作品を知ったばかりで、あなたのアートスタイルの大ファンです。私の友人であるHolylemongodがあなたにアートピースの依頼を受けたのですが、その出来上がりがとても気に入ったので、彼女のキャラクターを使ってバイクレースをテーマにしたアートピースをまた依頼できないかと考えています。また、この作品は、グッズ用に、長さ31.5インチ×幅11.8インチのマウスパッドにする予定です。\n\n参考までにこれが彼女のキャラクターです：\nhttps://drive.google.com/file/d/1A2lqztbp6s79QeIAm5653sYTy1oSzpmZ/view?usp=sharing\n\n全体的なアートデザインとしては、彼女がバイクで「アキラバイクスライド」をしていて、おそらくレーサーのテーマに合うようにゴールラインを横切っているようなものを希望します：\nhttps://drive.google.com/file/d/1CagE_qSMS49gTdlVI7ynke-DmQz25pmV/view?usp=sharing\n\n彼女のキャラクターには、下の例のようなMotogpスタイルのレーシングスーツを着せたいのですが、トップスーツのファスナーを開けて、上のキャラクター例の写真にあるレモンのロゴが入った彼女のキャラクターの白いトップスを見せたいと思っています。\nレーシングスーツの参考例\nhttps://drive.google.com/file/d/1wthQ7_EqYcgW6-F7A-43sLRoQ8MuhIVM/view?usp=sharing\nレーシングスーツ上部のジッパーを開け、クロップトップデザインの参考例：\nhttps://drive.google.com/file/d/16mQQmd4Aq8WqamlGqh5wXOsNFpSCJ4We/view?usp=sharing\n\nスーツのカラーリングは、レモンのキャラクターのテーマ（イエロー、グレー、ホワイト、ブラック）に近づけてください。可能であれば、スーツにレモンをテーマにしたロゴをいくつか追加してください！\n\nバイク自体は、2016年ヤマハR6アニバーサリーエディションに似たルックスとカラーにしたいと思っていますが、自由に創造してください：\nhttps://drive.google.com/file/d/1ooKGLwNrcyXcKUhu34WU5I0pnRVq_Vep/view?usp=sharing\n\n私の依頼を検討していただきありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/92", "thumbnail_src": "https://si.imgix.net/597813c9/uploads/origins/ec4b110f-b23f-4b7d-b110-359ada3c64e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90e24b77e99c3f2e290675b450a1907", "thumbnail_srcset": "https://si.imgix.net/597813c9/uploads/origins/ec4b110f-b23f-4b7d-b110-359ada3c64e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90e24b77e99c3f2e290675b450a1907, https://si.imgix.net/597813c9/uploads/origins/ec4b110f-b23f-4b7d-b110-359ada3c64e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6df9163d012af79ecf9d8ce7c6b2810e 2x, https://si.imgix.net/597813c9/uploads/origins/ec4b110f-b23f-4b7d-b110-359ada3c64e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=293dfbace6dc61e15706f46ad0c80008 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵はとてもきれいなので、リクエストを送る気になりました！\n僕のOCを描いてくれたら嬉しいな！\n\n彼らのリファレンスは全部ここにあります: https://drive.google.com/drive/folders/1itrReBPo961cMLFCQjsvRkLDQzopBo-t?usp=drive_link\n\nイラストは好きな方を選んでください！\nその他、服装なども自由ですので、自由に変更してください！", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/91", "thumbnail_src": "https://si.imgix.net/b7e64683/uploads/origins/80677783-6fe4-4dd1-9e2c-2c5254673438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b09a34cc7762094495089a4ce57dc42c", "thumbnail_srcset": "https://si.imgix.net/b7e64683/uploads/origins/80677783-6fe4-4dd1-9e2c-2c5254673438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b09a34cc7762094495089a4ce57dc42c, https://si.imgix.net/b7e64683/uploads/origins/80677783-6fe4-4dd1-9e2c-2c5254673438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=058f3606765f8a45484095368faedb30 2x, https://si.imgix.net/b7e64683/uploads/origins/80677783-6fe4-4dd1-9e2c-2c5254673438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3b89c6f780a157694a392af73ea6816 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/90", "thumbnail_src": "https://si.imgix.net/9b54cd94/uploads/origins/ad587662-7d4a-485a-a459-7124cfb68a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6528d9b082c4da4d3e05dd3c522289b", "thumbnail_srcset": "https://si.imgix.net/9b54cd94/uploads/origins/ad587662-7d4a-485a-a459-7124cfb68a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6528d9b082c4da4d3e05dd3c522289b, https://si.imgix.net/9b54cd94/uploads/origins/ad587662-7d4a-485a-a459-7124cfb68a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00e5072964d5e28127e66be986a467ca 2x, https://si.imgix.net/9b54cd94/uploads/origins/ad587662-7d4a-485a-a459-7124cfb68a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cf6c14a52b4a6eeb7f48591b22d3049 3x", "genre": "art", "nsfw": false, "body": "前回のリクエストに応えてくれてありがとう。\n\n今回は私のキャラクター、ソフィアとエステルを描いてください。\n\nエステルは上品で大人しく、内向的なOL。親しい人にはいじわるなところもあります。\n\nhttps://drive.google.com/drive/folders/1EpWgIsdplVfwMe4HmfCDbpcRzOc7KhwD?usp=share_link\n\nエステルの服装\n\n1. https://drive.google.com/file/d/10fh1oSEYzDgdGV2unVjnxI66Kiqr544E/view?usp=drive_link\n2. https://drive.google.com/file/d/1Kvmw9VZDUb-Zjwn8dub-bjKbvyKoF0bg/view?usp=drive_link\n\nソフィアは水のエレメントを持つエルフで、明るく外向的な性格の歌姫です。\n\nhttps://drive.google.com/file/d/1TLN1E9wnJ3zEL_-7przubOELdcKQlNb-/view?usp=sharing\nhttps://drive.google.com/drive/folders/1Jd1mNM_i7s9De607ooJ5qa4OHTXwRhoe?usp=sharing\n\n\n下記の参考資料のように、コンサートで一緒に歌うシーンが見たい。\n\nhttps://drive.google.com/file/d/16VkCAwodV-zEDJIqrtSCwVMm9f330dHT/view?usp=drive_link\nhttps://x.com/Adochansukisuki/status/1720424409075532239 (2nd image)\nhttps://x.com/firstaid0/status/1792910756759150618\n\n背景はコンサートホールのように。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/89", "thumbnail_src": "https://si.imgix.net/2612b2b7/uploads/origins/76b17c0f-38cb-4966-a6b3-3d80dbbf048e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e5231a596f84817c3b0143a42ba79a7", "thumbnail_srcset": "https://si.imgix.net/2612b2b7/uploads/origins/76b17c0f-38cb-4966-a6b3-3d80dbbf048e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e5231a596f84817c3b0143a42ba79a7, https://si.imgix.net/2612b2b7/uploads/origins/76b17c0f-38cb-4966-a6b3-3d80dbbf048e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f85ee66811a8cfb2f4f3b0c0258ff79f 2x, https://si.imgix.net/2612b2b7/uploads/origins/76b17c0f-38cb-4966-a6b3-3d80dbbf048e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=863cb61e30bf23a6c26ad6af7d2b7c24 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートワークとアートスタイルが大好きです！商品として使いたいマウスパッド用の作品をお願いしたいのですが！マウスパッドのサイズは長さ31.5インチ x 幅11.8インチです。\n\n私のキャラクターはこちらです：\nhttps://drive.google.com/file/d/1XhcHWnxu0eT4Nf-RgVZWDwKxeRSTg-J5/view?usp=sharing\n楽しいことが大好きで元気なカオスな女の子です！もっと女性らしく（胸が大きく、女性のような顔立ち）描いてほしいです。彼女の表情は、決意に満ちていて、微笑んでいて、どんなことにも準備ができていてほしいです！\n\n服装はこんな感じでお願いします：\nhttps://drive.google.com/file/d/1FfUnYVld8ZxCmGO-NSDcWWQwhxQBWIHq/view?usp=sharing\nタクティカルギアっぽいもの！このようなミリタリースタイルの装備を描いても大丈夫だといいのですが！\n\nマウスパッドの右側には私のキャラクターを前面に、左側には彼女の後ろにいる3人のキャラクターをこのようなフォーメーションで描いてほしいです：\nhttps://drive.google.com/file/d/1AAAPefnOdKydv0t4Y6vPxJsVQ4XDDSBk/view?usp=sharing\nこの写真に写っている3人はそれぞれ同じハワイアンTシャツで、1人は盾を持っています！盾には \"POLICE \"の代わりに \"LAYING DOWN THE LEMON LAW \"と書いてほしい！盾を持った男以外は、それぞれ銃を持っている。左端の男を参考にしてほしい！\n\n背景は自由にしていい！背景には落書きがあってほしいけど、このシーンに似合うと思うものを自由に描いていいよ。\n\nご検討、本当にありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@inthe459/works/88", "thumbnail_src": "https://si.imgix.net/05e78236/uploads/origins/7477913f-8fa4-4e80-9c83-57828b7cbd90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f8d372b0b76beb3d3d80b49feb60e05", "thumbnail_srcset": "https://si.imgix.net/05e78236/uploads/origins/7477913f-8fa4-4e80-9c83-57828b7cbd90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f8d372b0b76beb3d3d80b49feb60e05, https://si.imgix.net/05e78236/uploads/origins/7477913f-8fa4-4e80-9c83-57828b7cbd90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fec2f32fee7aa73885adb9540867d4bd 2x, https://si.imgix.net/05e78236/uploads/origins/7477913f-8fa4-4e80-9c83-57828b7cbd90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e45c4e47ac0a598bda351c468b6fa83 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nまた私のOCアリーナを描いてください。\nhttps://skeb.jp/@inthe459/works/78\nhttps://drive.google.com/drive/folders/1uAAI1JYaQznC-NoanTrL75bZc4pmLl93?usp=drive_link\nアリーナは炎を好む外向的な獣の女の子。彼女の髪と尻尾は炎でできている。\n\n前回の依頼で作ってくれた炎の姿を使ってください。\n\n浜辺で猫のように伸びをするアリーナ。\nhttps://www.pixiv.net/en/artworks/132919215\nhttps://x.com/aragik3n/status/1779226048909226394\n\n彼女の体型がよくわかるセクシーなポーズであること。\n彼女は陽気な笑