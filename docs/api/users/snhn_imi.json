TubeやTwitchのチャンネル内での使用\n・SNSでの宣伝活動\n\n【描いていただきたいもの】\n\nこんな感じのものが欲しいです：\nhttps://skeb.jp/@chaya_e201/works/4\n\n【キャラクターの参考】\nhttps://drive.google.com/drive/u/2/folders/1L0k-CNys9omTZ8QxZZl6mpJqM9-I-Y7Y\n\nこの依頼を引き受けてくれたらうれしいです！よろしくお願いします！\n\nhttps://twitter.com/7YAnanaha", "created_at": "", "completed_at": ""}, {"path": "/@snhn_imi/works/6", "thumbnail_src": "https://si.imgix.net/23dc6c12/uploads/outputs/cf869cd7-4b80-4b55-8518-6857a49ab0db?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c965c389f4e8f27a1510e151d49ba2ed", "thumbnail_srcset": "https://si.imgix.net/23dc6c12/uploads/outputs/cf869cd7-4b80-4b55-8518-6857a49ab0db?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c965c389f4e8f27a1510e151d49ba2ed, https://si.imgix.net/23dc6c12/uploads/outputs/cf869cd7-4b80-4b55-8518-6857a49ab0db?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbf4b840355567d7aa3f549de3517e42 2x, https://si.imgix.net/23dc6c12/uploads/outputs/cf869cd7-4b80-4b55-8518-6857a49ab0db?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81993bc62a0cfb216a635bb57fe56941 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@snhn_imi/works/5", "thumbnail_src": "https://si.imgix.net/67b5258c/uploads/outputs/9793bc33-4139-4af4-9887-7ed6e42e3cf1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=71c697b97ed34ba7d5b20a7ecee4cde7", "thumbnail_srcset": "https://si.imgix.net/67b5258c/uploads/outputs/9793bc33-4139-4af4-9887-7ed6e42e3cf1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=71c697b97ed34ba7d5b2