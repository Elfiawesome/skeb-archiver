xiv.net/a/%E3%82%AB%E3%82%A4%28%E3%82%AB%E3%83%B3%E3%83%95%E3%83%BC%E3%83%91%E3%83%B3%E3%83%80%29\n\nhttps://kungfupanda.fandom.com/wiki/Kai_(Kung_Fu_Panda_3)\n\nhttps://www.youtube.com/watch?v=u3wsq_pMkag\n\nhttps://youtu.be/aq5NcuEOwjw?t=53\n\nhttps://youtu.be/yKokTx2jSCw?t=8", "created_at": "", "completed_at": ""}, {"path": "/@ginn_tnrnrngnsr/works/2", "thumbnail_src": "https://si.imgix.net/4384bcc2/requests/172861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4abf3b77c2dafdb03da074aa3bb4d0fa", "thumbnail_srcset": "https://si.imgix.net/4384bcc2/requests/172861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4abf3b77c2dafdb03da074aa3bb4d0fa, https://si.imgix.net/4384bcc2/requests/172861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=601e1d977d0391858c5a697c9553b1f4 2x, https://si.imgix.net/4384bcc2/requests/172861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4e953937acd22bc63c9495304900741 3x", "genre": "art", "nsfw": false, "body": "猋さん、いつも素敵な作品をありがとうございます！\n\n放サモで、猋さんの考える「シロウとトウジの共闘バトルシーン」を描いていただけたらと思います＞＜！\n一枚絵、漫画、カラー、モノクロなどの形式は問いません！\n猋さんの表現しやすい、描きやすい形式や戦闘状況でお願いします(^^)！\n\nざっくりとしたお題で申し訳ないのですが、是非とも猋さんの書かれるシロウとトウジのかっこいいバトルシーンを拝みたく…＞＜！\nご検討いただけますと幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@ginn_tnrnrngnsr/works/1", "thumbnail_src": "https://si.imgix.net/eff16e7b/requests/160832_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd7f76c10c5312e2ff70a2dec01b574", "thumbnail_srcset": "https://si.imgix.net/eff16e7b/requests/160832_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd7f76c10c5312e2ff70a2dec01b574, https://si.imgix.net/eff16e7b/requests/160832_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e356590a49e65203e2d3bbe94c5ca1d0 2x, https://si.imgix.net/eff16e7b/requests/160832_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93c5cd6ed0c13ff8b4f02209596cd39c 3x", "genre": "art", "nsfw": false, "body": "放サモのゴウリョウ×主1をお願いできますでしょうか？\n\n前提は\nゴウリョウと主1は恋愛関係。\nゴウリョウは話したことないけど、主人公は「ゴウリョウにはだれか前妻的な誰かがいた」と勘づいてる。\n主人公が「自分はいろんな人の継ぎはぎ」という自覚がある。\n\nシチュエーションは\n同じベッドでゴウリョウが主人公に背を向けて先に寝入ってしまう。\nそのゴウリョウの背中を(俺がその人を継いでたら…なんて言ったらどんな顔して俺だけに怒ってくれる？)と思いながらゴウリョウの背中に人差し指をなんとなく滑らす。\n\nみたいなやつをお願いします。\n1P漫画 or 1枚絵　主人公の心の声を入れる or 入れない　などはお任せします。", "created_at": "", "completed_at": ""}]}