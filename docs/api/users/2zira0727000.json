c4-8f5c-29badde3be86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04eca41fd970ae2731db7bad59271bfb, https://si.imgix.net/b7b18143/uploads/origins/8fbf303a-016c-49c4-8f5c-29badde3be86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3dabb80bb04bbb399d03c03d42a8c9f1 2x, https://si.imgix.net/b7b18143/uploads/origins/8fbf303a-016c-49c4-8f5c-29badde3be86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f735c0648a245363637eff75cb319809 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@2zira0727000/works/16", "thumbnail_src": "https://si.imgix.net/a2104e9a/uploads/origins/50a21990-018e-411c-aaa8-9bcd00877193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd69fede8f71d82d31e619d279941d7c", "thumbnail_srcset": "https://si.imgix.net/a2104e9a/uploads/origins/50a21990-018e-411c-aaa8-9bcd00877193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd69fede8f71d82d31e619d279941d7c, https://si.imgix.net/a2104e9a/uploads/origins/50a21990-018e-411c-aaa8-9bcd00877193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3936fd35f4e880678b8eb7415705f0e6 2x, https://si.imgix.net/a2104e9a/uploads/origins/50a21990-018e-411c-aaa8-9bcd00877193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a16ace8642826a926b2a263cad5d2b7 3x", "genre": "art", "nsfw": true, "body": "内容に不備がありましたので、再度送らせていただきました。\nゆにこ〜ん様の可愛らしいショタイラストや大変にえっちなイラストに惹かれて、是非私の創作CPの受けのイラストをお願いしたくリクエストさせていただきました…！\n\n■世界観 \n悪魔が存在する架空の大正時代\n\nキャラクター設定（受け）\n名前:七伏闇吾 （ななふしあんご）\n年齢:27歳 \n身長:173cm \n職業:祓魔師であり、大日本帝国陸軍所属の研究者 \n性格:偏屈な皮肉屋で人嫌い、高圧的でプライドが高く人を見下しがち、理論的で頭脳明晰、自他共に厳しく研究や祓魔師の仕事にストイック、研究以外に興味関心が薄い  \n一人称:私、二人称:お前\n攻めの呼び方:「九喰」「お前」揶揄う時は「少将殿」「貴殿」（幼少期は「おまえ」「くくい」）\nイメージ台詞\n大人\n「これはこれは少将殿、このような場所に貴殿が一体何の用向きで？」「九喰…私を子供扱いするのはいい加減にしろ」「私がお前と居て不快に思ったことは一度もない。覚えておき給え」\n幼少期\n「おまえが教えてくれるのは、わたしの知らないことばかりだ」「わたしの研究のせーかをおまえにも見せてやろう」「くくいはわたしのだ…！」\n\nキャラクター設定（攻め）\n名前:九喰迅 （くくいじん）\n年齢43歳 \n身長:185cm \n職業:最強の祓魔師であり、大日本帝国陸軍の少将 \n性格:強面で厳格、貫禄がある為誤解されやすいが意外とお茶目、義理人情に厚い、堅物で真面目だが若干天然、包容力がある落ち着いた大人の男性 \n一人称:俺、二人称:お前\n闇吾の呼び方:「闇吾」「お前」\nイメージ台詞\n現在\n「闇吾、お前なぁ…もう少し自分の身体を気遣いなさい」「す、済まない。昔の癖でつい撫でてしまった」「お前の事は俺が必ず護るよ」\n闇吾幼少期\n「闇吾は良い子だなぁ」「ずっと独りで辛かっただろう」「今から少し近所を歩いてみないか？今日は風が心地良いぞ」\n\n■CP設定 \n迅は暗殺が横行する殺伐とした家庭環境から両親の愛情をもらえず、独りで自室に引き篭もっている闇吾の事を心配し、彼が幼い頃から何かと世話を焼いてきた。 病弱で警戒心が強く、学問に没頭する性格もあって部屋に引き篭もりがちだった闇吾を迅は外に連れ出して自然の美しさや、些細な季節の変化を教え、眠れない夜には彼の頭を撫でながら抱きしめて添い寝をしてくれた。\n 闇吾は迅と出会った当初は、自分に近づいてくる彼の事を警戒して邪険に扱っていたが、迅の優しさや温もりに触れ、いつしか彼の事がかけがえのない存在となっていた。\n感情に疎い闇吾は情緒面をほぼ全て迅から教わって育っており、好きなものや趣味は彼の影響が大きく、幼い頃に迅から貰った金平糖、彼から教えてもらった囲碁や将棋（闇吾の方が強い）、夜に連れ出して見せてくれた星空がお気に入り。\n成長してからの闇吾は幼い頃よりも迅に対して素直になれないが、本当は幼い頃に世話を焼いてくれた恩を感じており、今でも彼の事がずっと一番で大好き。\n迅は闇吾を幼い頃から可愛がっているので、彼が成長した後も可愛い甥っ子のように思い可愛がる反面、彼から妙な色気を感じては劣情を抱いてしまい葛藤している。\n闇吾は迅にわざと無理難題を突きつけて彼を困らせたり焦らせたりするのが好き。\n迅は闇吾のそんな面も可愛いと思っており、生意気で天邪鬼な彼に振り回されるのを何だかんだ楽しんでいる。\n闇吾は研究一辺倒でどこか浮世離れしており、感情にも疎いため、無防備な振る舞いをする事も多いが、迅は彼のそんなところに心を乱されながらもなんとか子供扱いすることで劣情を押し込めている。\n 2人は兄弟とも親子とも友人とも言えない特別な関係。 互いに想い合っているが、闇吾は情に疎く、迅への気持ちをよく分かっておらず、迅は幼い頃から大切に見守ってきた闇吾への気持ちを認めてはいけないという思いからすれ違っている。  \n恋人同士となってからも2人の関係性はこれまでとあまり変わらないが、色恋に不得手で不慣れな闇吾は迅からの恋人扱いに慣れずに戸惑っている。迅と手を繋いだり抱きしめ合ったりは素直になれず要領も分からないなりに密かに嬉しいと思っている。\n\n幼い頃の闇吾は人並外れた頭脳を持っていたものの、病弱で生まれた環境ゆえに警戒心が強く、家族や人の温もりを知らずに育ってきた。\nそんな彼にとって唯一安心して甘えることのできる迅は何よりも特別な存在で、今までずっと独りで過ごしてきた孤独を埋めるように彼に対してだけは甘えん坊でいつも彼にくっついていた。\n独占欲も強く、自分以外の誰かが彼と親しそうにしていると「くくいはわたしの！」と迅に抱きついて相手を牽制したり、迅が仕事に忙しくしていると構ってほしくて後ろをついて回ったり…。\n闇吾は迅と一緒に天体や科学の図鑑を見たり、自身の研究の成果をまとめた資料を彼に披露したりするのが大好き。迅は闇吾が時折見せる子供らしい一面に愛おしさを感じている。\n\n設定が多くて申し訳ございません…。攻めの設定は参考として載せていますので、無視していただいて構いません。\n今回は料金の範囲内であれば、大人の受け（27歳）と幼少期の受け（7歳）のそれぞれ2枚のイラストを描い