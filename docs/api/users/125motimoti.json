rive.google.com/drive/folders/11Hnz8tlHzDUHxhi4MNIAyWJP5hTbXCVU", "created_at": "", "completed_at": ""}, {"path": "/@125motimoti/works/47", "thumbnail_src": "https://si.imgix.net/7fb61cdf/uploads/origins/bb2dbea4-83c7-47d9-a308-d893a3c418eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9f95c193e8a9e6463fb067f13795850", "thumbnail_srcset": "https://si.imgix.net/7fb61cdf/uploads/origins/bb2dbea4-83c7-47d9-a308-d893a3c418eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9f95c193e8a9e6463fb067f13795850, https://si.imgix.net/7fb61cdf/uploads/origins/bb2dbea4-83c7-47d9-a308-d893a3c418eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e86677d5025f496155cb2650791c7c1 2x, https://si.imgix.net/7fb61cdf/uploads/origins/bb2dbea4-83c7-47d9-a308-d893a3c418eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76c85a852bf21879dfad842edcf75613 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@125motimoti/works/46", "thumbnail_src": "https://si.imgix.net/1ba613c9/uploads/origins/abc9871e-c719-48be-b99b-0094701a03d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=323b267ece9dd50f081539c3d2f5d13d", "thumbnail_srcset": "https://si.imgix.net/1ba613c9/uploads/origins/abc9871e-c719-48be-b99b-0094701a03d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=323b267ece9dd50f081539c3d2f5d13d, https://si.imgix.net/1ba613c9/uploads/origins/abc9871e-c719-48be-b99b-0094701a03d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi