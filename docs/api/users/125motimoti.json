97-ae2a-e984e856b09d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d00d056311893225bdf3f929fcb4c2be, https://si.imgix.net/fcabad3a/uploads/origins/e47cd22e-9cfd-4097-ae2a-e984e856b09d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f37e0dc30d5446b4b4c0846091f85c00 2x, https://si.imgix.net/fcabad3a/uploads/origins/e47cd22e-9cfd-4097-ae2a-e984e856b09d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=166753a693927abc822439f1672b33b9 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵が大好きです。以前あなたにお願いした作品は、私のお気に入りのひとつです。今回も応募させていただきます。私のキャラクター【アモン】の全身イラストをお願いします。\n\n[アモン】は魅力的な王子様です。彼は王族であり、優雅で落ち着いた身のこなしをしています。占い魔法を得意とする魔法使いです。魔道書と、青い水晶のついた白い木の杖を持ち歩いている。杖は地面に届くくらいの長さがある。ペットに白い羽のカラスを飼っている。月の女神を崇拝している。\n\n依頼の詳細はぜひお任せしたい！\n\n参考文献：https://drive.google.com/drive/folders/1jYeiosNDbBI37wHHnH9A3DlCbad_5vYh?usp=sharing\n\n衣装：https://drive.google.com/drive/folders/1leL0VxFtCqzphcXjSfAVoG35kTLyg_LJ?usp=sharing\n\n服装のディテールは自由裁量で変更してください。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@125motimoti/works/40", "thumbnail_src": "https://si.imgix.net/ca53c0dc/uploads/origins/38291e57-495d-4bc9-abc6-a2553c5f18df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f02764ffb8f1dd5ece243de4962527d", "thumbnail_srcset": "https://si.imgix.net/ca53c0dc/uploads/origins/38291e57-495d-4bc9-abc6-a2553c5f18df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f02764ffb8f1dd5ece243de4962527d, https://si.imgix.net/ca53c0dc/uploads/origins/38291e57-495d-4bc9-abc6-a2553c5f18df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00ed944e82fc2efa036094e5ced79629 2x, https://si.imgix.net/ca53c0dc/uploads/origins/38291e57-495d-4bc9-abc6-a2553c5f18df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91cc449550b10a330d4c30046ab53fb8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの源信とあなたの碁の