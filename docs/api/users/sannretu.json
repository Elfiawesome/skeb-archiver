reated_at": "", "completed_at": ""}, {"path": "/@sannretu/works/18", "thumbnail_src": "https://si.imgix.net/7d3a32e0/uploads/origins/85bd19ca-91e1-4163-ae77-03dbdb4a5ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06925ac158b1acdfebb67ee722b7dacb", "thumbnail_srcset": "https://si.imgix.net/7d3a32e0/uploads/origins/85bd19ca-91e1-4163-ae77-03dbdb4a5ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06925ac158b1acdfebb67ee722b7dacb, https://si.imgix.net/7d3a32e0/uploads/origins/85bd19ca-91e1-4163-ae77-03dbdb4a5ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32fcb19dadb8ea27a2873703bb365c54 2x, https://si.imgix.net/7d3a32e0/uploads/origins/85bd19ca-91e1-4163-ae77-03dbdb4a5ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4713c830552baa60e4fd4a77bc4e156 3x", "genre": "art", "nsfw": true, "body": "はじめまして！アピールありがとうございます。\n東方の十六夜咲夜とイチャラブエッチしてる光景をお願い致します。\n\n・体位は男性に脚拡げられ正常位で胸や結合部は見えつつの上着、スカート着衣の半脱ぎで挿入から中出しまで愛し合ってる様子\n\n・可能であれば、隣に半脱ぎレミリアも寝転び3Pしていたりな構図で(順番待ちか手マンで男性に相手されてるなど自由なシチュエーションで)", "created_at": "", "completed_at": ""}, {"path": "/@sannretu/works/17", "thumbnail_src": "https://si.imgix.net/bd88418a/uploads/origins/3370174b-64d9-41bc-b2a1-0239995adfc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c96e35b22949f4a9cb0f329cf2c40353", "thumbnail_srcset": "https://si.imgix.net/bd88418a/uploads/origins/3370174b-64d9-41bc-b2a1-0239995adfc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c96e35b22949f4a9cb0f329cf2c40353, https://si.imgix.net/bd88418a/uploads/origins/3370174b-64d9-41bc-b2a1-0239995adfc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=875a215bcab9a88d0bfa2fa9cb45b60c 2x, https://si.imgix.net/bd88418a/uploads/origins/3370174b-64d9-41bc-b2a1-0239995adfc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09ca6e7db80c9ff69a9f344a85fbc700 3x", "genre": "art", "nsfw": true, "body": "特殊性癖にはなりますがご依頼させていただきました。\n受け入れられないなら、却下してください。\n\nキャラ\n・東方より好きなキャラ\n・胸は美乳～巨乳\n・人数は1人～2人\n\n・シチュエーション\n・催眠術か何かで体が勝手に動いてオナニーしている。\n（アリスの操り糸みたいなので操られてるのも素敵ですよね。）\n\n描画していただきたいこと\n・服装はお任せします。\n・片側の乳首に豆ローターがついている。（服の上から？）\n・片手は乳首を弄り、片手で電マ（バイブ）を持ってオナニーをしている。\n・困惑している台詞（表情）を出しながらも舌を突き出して感じている、といった矛盾したような感じを出してくれると嬉しいです。\n・周囲に「♡」を飛ばしてください", "created_at": "", "completed_at": ""}, {"path": "/@sannretu/works/16", "thumbnail_src": "https://si.imgix.net/8410e629/uploads/origins/b36c0f5c-1da2-4aed-b014-0c951ef3a204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09f9be6775d4ef28fda62939e694ae91", "thumbnail_srcset": "https://si.imgix.net/8410e629/uploads/origins/b36c0f5c-1da2-4aed-b014-0c951ef3a204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09f9be6775d4ef28fda62939e694ae91, https://si.imgix.net/8410e629/uploads/origins/b36c0f5c-1da2-4aed-b014-0c951ef3a204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cfa40f82fbcf780fdc917f06d2c8935 2x, https://si.imgix.net/8410e629/uploads/origins/b36c0f5c-1da2-4aed-b014-0c951ef3a204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4bdee8929415ec296b2b735abc130fc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sannretu/works/15", "thumbnail_src": "https://si.imgix.net/351f7b9b/uploads/origins/617589f8-7338-49fa-aeee-11f78b3466a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&