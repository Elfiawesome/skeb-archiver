db-8828-d44f9e218a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4501612b4d3482bbf5e6d06cca3dc13", "thumbnail_srcset": "https://si.imgix.net/be6c1ff2/uploads/origins/d3e87837-21ad-47db-8828-d44f9e218a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4501612b4d3482bbf5e6d06cca3dc13, https://si.imgix.net/be6c1ff2/uploads/origins/d3e87837-21ad-47db-8828-d44f9e218a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33e98071a13f6c560cf4bb2ea6a1a740 2x, https://si.imgix.net/be6c1ff2/uploads/origins/d3e87837-21ad-47db-8828-d44f9e218a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7b4aa46b6f8abddc7457228637d70c1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私が今考えているのは、私のキャラクターであるトリが[2]のような体勢で横たわるというものです。以下のように、全部で3つのバリエーションが欲しいです。\n\n- 1: 前。トリは一人で、[1b]のような控えめで幸せそうな表情で恋人を見ている。おそらく♀がほんの少し覗いている。\n- 2: 中。恋人とセックスをしている。トーリが処女を失ったことを象徴するように、小さな血がにじんでいるはずだ。初めてが愛する人とのものであることを非常に喜んでいるため、彼女は最初のバージョンよりも表情豊かで優しい微笑みを浮かべているはずだ。そして、初めてにもかかわらず、痛くもなく、不快感もない。指を絡めて彼と手をつないでほしい。恋人は細かくなくても、ペニスと手だけでも、仕事の手抜きに役立つ。\n- 3：アフター。トリは再び一人になり、とても満足そうな表情で余韻に浸っている。彼女のアソコからはザーメンが滴り落ちているはずだ。\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1U56VBz1sNkOO6sE0jn6_i2WQw80pZwUf?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mustee/works/33", "thumbnail_src": "https://si.imgix.net/cfd453b1/uploads/origins/7700f289-bf2f-42b8-817b-11139cd8aad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afb5540bb7330452866d82f93aee9c96", "thumbnail_srcset": "https://si.imgix.net/cfd453b1/uploads/origins/7700f289-bf2f-42b8-817b-11139cd8aad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afb5540bb7330452866d82f93aee9c96, https://si.imgix.net/cfd453b1/uploads/origins/7700f289-bf2f-42b8-817b-11139cd8aad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d2474199f7de266e16f263576017164 2x, https://si.imgix.net/cfd453b1/uploads/origins/7700f289-bf2f-42b8-817b-11139cd8aad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a6a257b6209ba6158a38c5dfaca77cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mustee/works/32", "thumbnail_src": "https://si.imgix.net/af443db0/uploads/origins/c4a7c711-8fa3-4011-b3c7-900c43702aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31b265575198f13644a2c48d1985ec65", "thumbnail_srcset": "https://si.imgix.net/af443db0/uploads/origins/c4a7c711-8fa3-4011-b3c7-900c43702aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31b265575198f13644a2c48d1985ec65, https://si.imgix.net/af443db0/uploads/origins/c4a7c711-8fa3-4011-b3c7-900c43702aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf5ea0ed0fd0f2be752830bdc2b99660 2x, https://si.imgix.net/af443db0/uploads/origins/c4a7c711-8fa3-4011-b3c7-900c43702aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52ee62a55636a013ac92e50afd52c660 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n私の案は、[1a,b,c,d]のゆずはが[2]のような体位とアングルで輪姦されるものです。彼女の両腕は[3]のように首に拘束され、全裸になります。アソコと肛門は[4]のように乾いて出血し、処女喪失とレイプが残酷であることを示している。彼女は[5]のように泣き叫ぶだろう。\n\n参考までに、ゆずはは[7]のような体つき、つまり平たい胸の大人であるべきだ。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/u/0/folders/1KL5HK--16xGDmlTs35BHsD1BnR9VldVt", "created_at": "", "completed_at": ""}, {"path": "/@mustee/works/31", "thumbnail_src": "https://si.imgix.net/59370af7/uploads/origins/f78f2154-52be-40b1-94f3-749ac17b2c82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a482a69e45cd739f18464fa42d36013", "thumbnail_srcset": "https://si.imgix.net/59370af7/uploads/origins/f78f2154-52be-40b1-94f3-749ac17b2c82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a482a69e45cd739f18464fa42d36013, https://si.imgix.net/59370af7/uploads/origins/f78f2154-52be-40b1-94f3-749ac17b2c82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46c32242e8d750bc90dbf61219a370ee 2x, https://si.imgix.net/59370af7/uploads/origins/f78f2154-52be-40b1-94f3-749ac17b2c82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de2f695a43c46310dc37a0cec6f9aa37 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mustee/works/30", "thumbnail_src": "https://si.imgix.net/9b9b6255/uploads/origins/e327214c-6d34-4390-9bc1-58f116bb23db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c0012486f0c682476765e72464456c8", "thumbnail_srcset": "https://si.imgix.net/9b9b6255/uploads/origins/e327214c-6d34-4390-9bc1-58f116bb23db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c0012486f0c682476765e72464456c8, https://si.imgix.net/9b9b6255/uploads/origins/e327214c-6d34-4390-9bc1-58f116bb23db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4875679e40ecda6881f842027a3327a8 2x, https://si.imgix.net/9b9b6255/uploads/origins/e327214c-6d34-4390-9bc1-58f116bb23db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6bbf58fc390b8d9d42b356d29d3f7e