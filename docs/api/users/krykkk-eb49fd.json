=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efc703c7fb6d5c32177f6c8fb79892ce 2x, https://si.imgix.net/7bbeb0af/uploads/origins/a3fbe9d5-301f-4bcf-9ee5-7033421c6c03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cce20b4387414296ba95dd146d150793 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/30", "thumbnail_src": "https://si.imgix.net/5a26a756/uploads/origins/e288aea1-232a-43cc-98b2-7aec66425422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abb68e97186a616021ae53a6ea8bfee0", "thumbnail_srcset": "https://si.imgix.net/5a26a756/uploads/origins/e288aea1-232a-43cc-98b2-7aec66425422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abb68e97186a616021ae53a6ea8bfee0, https://si.imgix.net/5a26a756/uploads/origins/e288aea1-232a-43cc-98b2-7aec66425422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d33c80817d4a72334112002cb6e4e95e 2x, https://si.imgix.net/5a26a756/uploads/origins/e288aea1-232a-43cc-98b2-7aec66425422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=422baafd616707a0d331b2f2b3ec216c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！以前頂いた作品がとても気に入り、絵柄もとても好きなので、今回もお願いします。キャラクターを2人お願いすることは可能でしょうか？前作はもう一人のキャラクターと一緒にお願いしたのですが、灰の金髪の方は彼の親しい知人です。金髪の方は神父さんで、昔からの知り合いで、よく共犯者として一緒に行動しています。金髪の方は真面目で冷静。内心では神々に懐疑的だが、青い髪の神官には恩義を感じている。青い髪の方は、もう一人をよくからかうのが好き。どんな風に描いてもいい！無理そうだったら遠慮なく断ってください。何でも嬉しいです。リクエストを見てくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1GMRdWlBucj-wkMb7krFmMB_-Micmt7RF?usp=sharing\nhttps://drive.google.com/drive/folders/1v-NaUAVT7ZAOtmQH2NJ4ykDrGzdaT2Y3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/29", "thumbnail_src": "https://si.imgix.net/cf379aff/uploads/origins/098ed2da-778d-458a-ba6c-ec3f3f623cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b127f9d6978fe53e5bccd92238dbb8e1", "thumbnail_srcset": "https://si.imgix.net/cf379aff/uploads/origins/098ed2da-778d-458a-ba6c-ec3f3f623cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b127f9d6978fe53e5bccd92238dbb8e1, https://si.imgix.net/cf379aff/uploads/origins/098ed2da-778d-458a-ba6c-ec3f3f623cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e40b20a28a625f0c8aadc74b145d3d31 2x, https://si.imgix.net/cf379aff/uploads/origins/098ed2da-778d-458a-ba6c-ec3f3f623cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e16cf6af47dbf7db22003163561bc98b 3x", "genre": "art", "nsfw": false, "body": "はじめまして、黒裄様。\nhttps://drive.google.com/file/d/1gqLeojbWVlAz4SFSmTJeH4_aLvVz5LOm/view?usp=sharing\nリンクの姿を描いてください。\n構図などをおまかせします。\n納品データpsd、キャラクターのみ透過版が必要です。\n以上となります、ご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/28", "thumbnail_src": "https://si.imgix.net/9897ed42/uploads/origins/8f9c70e7-774c-4af3-8848-deda86d6dc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33a076785405c4e549170f0f20ede429", "thumbnail_srcset": "https://si.imgix.net/9897ed42/uploads/origins/8f9c70e7-774c-4af3-8848-deda86d6dc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33a076785405c4e549170f0f20ede429, https://si.imgix.net/9897ed42/uploads/origins/8f9c70e7-774c-4af3-8848-deda86d6dc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0252f75e3f1b51a60b236b14965d8ae 2x, https://si.imgix.net/9897ed42/uploads/origins/8f9c70e7-774c-4af3-8848-deda86d6dc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be98b023db54e62289787c4c68556958 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/27", "thumbnail_src": "https://si.imgix.net/57bf2b67/uploads/origins/837a2731-dfed-4932-9a3b-9d2bb1fcf7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498274fe318edc37d06294a911c3d8d4", "thumbnail_srcset": "https://si.imgix.net/57bf2b67/uploads/origins/837a2731-dfed-4932-9a3b-9d2bb1fcf7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498274fe318edc37d06294a911c3d8d4, https://si.imgix.net/57bf2b67/uploads/origins/837a2731-dfed-4932-9a3b-9d2bb1fcf7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2b9e3a278effbad5223585cb93d5a89 2x, https://si.imgix.net/57bf2b67/uploads/origins/837a2731-dfed-4932-9a3b-9d2bb1fcf7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c903ac2e4b6b4d502a0e9cb8a8f718e 3x", "genre": "art", "nsfw": false, "body": "はじめまして!\n月華繚乱ROMANCEで黒裄さんの独特な雰囲気のイラストの大ファンになり、ずっと応援していました!\nいつか自分の固定キャラクターを黒裄さんに描いて頂きたいと思っており、今回やっとお願いさせて頂きます。\n\n資料の女の子が私の固定キャラクターになります。\n髪の色は少し明るめのグリーン、目の色は深めのブルーです。\nもし可能でしたら、この子には服装や髪型に細かい設定がないので、黒裄さんにお洋服を考えて頂けたら嬉しいなと思っています。\n希望としては、なるべく露出の少ないシックで女性らしい服装を想像しています。(洋服の色味は黒裄さんにおまかせしたいです)\n髪の長さはロング〜セミロングくらい、軽くウェーブがかかってる感じで、下ろしたままかハーフアップくらいが好みです。\n\n金額はどれくらいが良いかわからなかったので、この金額で設定しています。\nお洋服などの件もありますので、増額必要でしたらして頂いて大丈夫です!\n\n使用用途は主にSNSのアイコンや、個人で楽しむ範囲です。\n宜しくお願い致します!\n\nhttps://photos.app.goo.gl/KDuiQUQrwRWhyAfS7", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/26", "thumbnail_src": "https://si.imgix.net/010feda8/uploads/origins/abc4cbac-00c1-4643-a48c-fc721af1f4a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f13889178e91d2133298e9c6cbd0147", "thumbnail_srcset": "https://si.imgix.net/010feda8/uploads/origins/abc4cbac-00c1-4643-a48c-fc721af1f4a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f13889178e91d2133298e9c6cbd0147, https://si.imgix.net/010feda8/uploads/origins/abc4cbac-00c1-4643-a48c-fc721af1f4a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba1c0e1eece7447dc79a28e0c731eb5b 2x, https://si.imgix.net/010feda8/uploads/origins/abc4cbac-00c1-4643-a48c-fc721af1f4a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e00e8f6a8b908746002484ef331879ec 3x", "genre": "art", "nsfw": false, "body": "初めまして！Black Wolves Sagaで黒裄さんのイラストに出会ってから、ずっと黒裄さんのイラストが大好きです。今回、ぜひ黒裄さんに描いていただきたい子が2人います。お値段よくわからず、なんとなくで金額を書いております。足りないなどあればお伝えいただければ増額します。使用用途は主に観賞用として、個人的にアイコンやヘッダーなどに使ったり、友人同士で見せ合う程度になります。配信等の何かしらの利益が発生するような場所で使用することはありません。\n\n資料として送らせていただくキャラは1人目イヴちゃん(茶髪の女の子)。2人目エリシャくん(薄い髪色の男の子)です。\n友人達に描いてもらった夢絵などからで大変恐縮ですが、参考にしていただければ幸いです！\nイヴは設定付きの画像がないため、文章にて失礼します。\n(名前)イヴ/(年齢)24歳/(一人称)私/(職業)敵側のスパイ兼革命軍のサポーター\n(特徴)基本大人しい態度で表情も乏しく無口だけど、仕事(敵味方関係なく)に対する意識は高いのでしっかりやり遂げようとするタイプ。笑う時はちゃんと顔に出る。\n\n2人は小さい頃に生き別れた姉弟でありながら、同じ職業として出会った設定です。イヴは孤児として育ちスパイとして戦場に来たのに対し、エリシャは裕福な家庭で育ち親を殺されてから医者として戦場に来ました。\n\nBWSが大好きなので、それの現代版的なイメージです。構図や背景はお好きにしていただいて構いません。衣装なども簡略していただいて大丈夫です。黒裄さんの色々な色を使った水彩のような絵柄が大好きです。黒裄さんのイラストとしてぜひ見てみたいので、どうかご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1I9amf0wT6mHB4g-izdHoznqtAND_0twI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/25", "thumbnail_src": "https://si.imgix.net/e8bfa498/uploads/origins/ccfaa9c0-a5e7-424c-9c3e-46e0010b7b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfbbf717c2e5a227388310cbec6aaf7c", "thumbnail_srcset": "https://si.imgix.net/e8bfa498/uploads/origins/ccfaa9c0-a5e7-424c-9c3e-46e0010b7b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfbbf717c2e5a227388310cbec6aaf7c, https://si.imgix.net/e8bfa498/uploads/origins/ccfaa9c0-a5e7-424c-9c3e-46e0010b7b04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=232dc639d9b0bd0d833a5a64f52a94e4 2x, https://si.imgix.net/e8bfa498/uploads/origins/ccfaa9c0-a5e7-424c-9c3e-46e0010b7b04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c141986e03fbfb5d818ef5c29384b37b 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！前回の依頼がとても気に入ったので、また依頼をしたいと思います。今回は、いたずら好きで楽しいことで有名な魔女です。彼女は絵を描くこと、夕暮れの海辺を歩くこと、美味しいものを食べることが大好きです。できれば、ウエディングドレスを着て、白いバラのブーケを持った彼女を描いていただけませんか？ドレスのデザインは自由に描いていただいて構いません！ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/19Ag2xklMhgW5gDY8rfEYlYl5ZUST8QY2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/24", "thumbnail_src": "https://si.imgix.net/b76ee057/uploads/origins/2bc276c1-e5a6-424a-ab2f-981675ee8e0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=148e28fefc205a75b6eabddda388cc98", "thumbnail_srcset": "https://si.imgix.net/b76ee057/uploads/origins/2bc276c1-e5a6-424a-ab2f-981675ee8e0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=148e28fefc205a75b6eabddda388cc98, https://si.imgix.net/b76ee057/uploads/origins/2bc276c1-e5a6-424a-ab2f-981675ee8e0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=967cfcbb51e63ef1903157eac978988f 2x, https://si.imgix.net/b76ee057/uploads/origins/2bc276c1-e5a6-424a-ab2f-981675ee8e0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c7b8d0770cf7fdf9287ed21db1e46b0 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！前回の作品がとても気に入ったので、今回もお願いしたいと思いました。今回は私のキャラクターと友人のキャラクターを使った作品です。青い髪の方はマジシャンに変装して世界中を旅している神様で、全体的にのんびりしていて遊び好き。一方、茶髪の方は、幼稚なところもあれば、見かけによらず物知りなところもある少女です。薔薇のマークが描かれたクリスタルを渡すシーンはできますか？やりすぎだと感じたら、遠慮なく断っていただいて構いません！リクエストにお答えいただき、ありがとうございました！\n\n参考リンク\n\nhttps://drive.google.com/drive/mobile/folders/1GMRdWlBucj-wkMb7krFmMB_-Micmt7RF?usp=sharing\n\nhttps://drive.google.com/drive/folders/151Q7IzsDy4J1CbjDXuVqm_MTuTYorA-3", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/23", "thumbnail_src": "https://si.imgix.net/ce39047f/uploads/origins/ad5d0432-cd02-427d-9b61-30f53781983c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef04972af40976cc83b56ed27184104", "thumbnail_srcset": "https://si.imgix.net/ce39047f/uploads/origins/ad5d0432-cd02-427d-9b61-30f53781983c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef04972af40976cc83b56ed27184104, https://si.imgix.net/ce39047f/uploads/origins/ad5d0432-cd02-427d-9b61-30f53781983c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dcb1bde7d7a256755322339d043838b 2x, https://si.imgix.net/ce39047f/uploads/origins/ad5d0432-cd02-427d-9b61-30f53781983c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82e34fa71962efa7883b52a161c60ece 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートは素晴らしいです！私のオリジナルキャラクターの絵をお願いしたいのですが、可能でしょうか？彼女は笑顔の絶えない幼い子供です。ある時は子供っぽく、またある時は見た目以上に知っているように見えることもあります。読書とゲームが好き。手の甲にバラのタトゥーがあるのですが、できれば構図に登場させてほしいです。もしやりすぎと感じたら、遠慮なく断っていただいて結構です！私のリクエストを考慮していただき、ありがとうございました！\n\n衣装は5種類ありますが、どれを描いてもいいし、新しい衣装を作ってもいいですし、ご自由にどうぞ！\n\nhttps://drive.google.com/drive/folders/151Q7IzsDy4J1CbjDXuVqm_MTuTYorA-3", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/22", "thumbnail_src": "https://si.imgix.net/020f4438/uploads/origins/775ca86e-4111-4feb-b125-34acb3c8bdfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f002f7e84a0d4705ccdb6cdc633e0d81", "thumbnail_srcset": "https://si.imgix.net/020f4438/uploads/origins/775ca86e-4111-4feb-b125-34acb3c8bdfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f002f7e84a0d4705ccdb6cdc633e0d81, https://si.imgix.net/020f4438/uploads/origins/775ca86e-4111-4feb-b125-34acb3c8bdfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e58e9dfc884c72de87ff252adc70a5e 2x, https://si.imgix.net/020f4438/uploads/origins/775ca86e-4111-4feb-b125-34acb3c8bdfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fe2ca78dc010196549f4246ad61448b 3x", "genre": "art", "nsfw": false, "body": "黒裄さんはじめまして！\nいつも素敵な作品を拝見しております。\n黒裄さんの絵が大好きです。\nもしよろしければ、私のキャラを描いていただけませんか？\n\nキャラの参考資料はこちら：\nhttps://drive.google.com/drive/folders/1rDyXUwhu-LsXUi5GEGZbEIrfTBMUK0r7\n\n見た目\n　目：垂れ目、ピンク。\n　眉：垂れ眉。\n　髪型：黒髪、三つ編みドーナツ。\n\n性格\n　物静かで、いつも無表情。\n　綺麗なものが大好き。\n\n好きなもの\n　森、白色、宝石、クジャク、フリル、レース。\n\n服装、構図、ポーズなどは、お任せいたします。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1rDyXUwhu-LsXUi5GEGZbEIrfTBMUK0r7", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/21", "thumbnail_src": "https://si.imgix.net/59807687/uploads/origins/8709e7c8-8e95-40b8-b692-6673636501cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8bc978dfa24eea7043c585224cce14d", "thumbnail_srcset": "https://si.imgix.net/59807687/uploads/origins/8709e7c8-8e95-40b8-b692-6673636501cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8bc978dfa24eea7043c585224cce14d, https://si.imgix.net/59807687/uploads/origins/8709e7c8-8e95-40b8-b692-6673636501cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5305c6ec15c9ef783f68b7ed77c27520 2x, https://si.imgix.net/59807687/uploads/origins/8709e7c8-8e95-40b8-b692-6673636501cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82271dfc021cce22293ef82c09d94138 3x", "genre": "art", "nsfw": false, "body": "私はあなたの絵が多くの作品から好きでした!私のオリジナルキャラクターを依頼することは可能でしょうか？元邪神で、後に願いを叶える神となり、今はマジシャンに変装して世界中を飛び回っています。普段はのんびりとしていて自由気ままな性格ですが、たまに遊び心があり派手なこともあります。天使の羽を構図に入れることは可能でしょうか？構図はおまかせします。シンプルに、変更に、やりすぎと感じたらお断りするのも自由です。私のリクエストを見ていただきありがとうございました。\n\n衣装は2種類ありますが、お好きなように描いてください。参考までにリンクを貼っておきます。\n\nhttps://drive.google.com/drive/folders/1GMRdWlBucj-wkMb7krFmMB_-Micmt7RF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/20", "thumbnail_src": "https://si.imgix.net/4d2cea44/uploads/origins/07be4d96-3bd1-4052-8990-837162d4f922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48085e4f41be36c6c249e6e0d2c89e41", "thumbnail_srcset": "https://si.imgix.net/4d2cea44/uploads/origins/07be4d96-3bd1-4052-8990-837162d4f922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48085e4f41be36c6c249e6e0d2c89e41, https://si.imgix.net/4d2cea44/uploads/origins/07be4d96-3bd1-4052-8990-837162d4f922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da52f93bdf50a7a3119d669f2266aa35 2x, https://si.imgix.net/4d2cea44/uploads/origins/07be4d96-3bd1-4052-8990-837162d4f922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=210eba02f1d93aa0d06649b766b7f1f3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nもしよければオリカプのイラストを依頼したいと思っております。\nhttps://drive.google.com/drive/folders/1mvEYA5WbOLOAk5S5UNI5MhVQvAOPA_tF\n\n服装を簡単化・変更にしても構いません。全体はご自由に描ければ嬉しいです。\n\n迷惑をかけたら気軽にキャンセルしてください。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/19", "thumbnail_src": "https://si.imgix.net/3c9e5a80/uploads/origins/2cf758bd-89ce-4343-a7b3-3bb91302b60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14d92c024b64c7a00187f48701d39940", "thumbnail_srcset": "https://si.imgix.net/3c9e5a80/uploads/origins/2cf758bd-89ce-4343-a7b3-3bb91302b60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14d92c024b64c7a00187f48701d39940, https://si.imgix.net/3c9e5a80/uploads/origins/2cf758bd-89ce-4343-a7b3-3bb91302b60d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35e263423814a6b1ef77017611b6cea7 2x, https://si.imgix.net/3c9e5a80/uploads/origins/2cf758bd-89ce-4343-a7b3-3bb91302b60d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a96123f3e88d28d87d479ff24687290c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/18", "thumbnail_src": "https://si.imgix.net/aafe735e/uploads/origins/c42bf0b4-17bd-47b5-83bc-1cc6e45e2791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4684a82909f8911008a09e8da6908c", "thumbnail_srcset": "https://si.imgix.net/aafe735e/uploads/origins/c42bf0b4-17bd-47b5-83bc-1cc6e45e2791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4684a82909f8911008a09e8da6908c, https://si.imgix.net/aafe735e/uploads/origins/c42bf0b4-17bd-47b5-83bc-1cc6e45e2791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=361504dfef75d5ec137999ddd75d346a 2x, https://si.imgix.net/aafe735e/uploads/origins/c42bf0b4-17bd-47b5-83bc-1cc6e45e2791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=043c4ba82398e4018c0a04fc319cfe41 3x", "genre": "art", "nsfw": false, "body": "こんいちは黒裄先生!!!!\n私は何年も前から先生の作品のファンです。先生の絵は、いつも私のキャラクターの内容のインスピレーションになっています。\n\n私のキャラクター「レオーネ」と「アネット」のイラストを描いていただけませんか？容姿のよく似た二人のエルフ（アッシュブロンドヘア、ラベンダー色の瞳）です。\n\n不運な兄妹で、ライバル心や暗い悲劇的な背景があります。\n二人とも教会を中心に育っている。以下、二人のキャラクターを紹介する。\n\nレオーネ: :悲劇的な背景を持つ、強力な魔術師です。過去に問題を抱えたことで性格が悪くなってしまったが、一般人には普通の人間として映っている。心に闇を抱えており、下心を持った溺愛する兄である。\n\nアネット: 心優しい少女で、一族の後継者でもある。そのため、レオーネは彼女を過保護に守っていると主張する。しかし、レオーネは彼女に深い恨みを抱いており、非常に欺瞞的であった。裏では、世界を彼女に敵対させようとしているのだ。\n\nキャラクターのポーズはお任せします。ただし、「BLACK WOLVES SAGA」の悲劇をイメージしたものを希望します。\n\n背景は、大聖堂の美学、純白の花、血しぶきのようなものが好ましいと思います。\n\n参考：https://imgur.com/a/WvIoUj6\n（最初の2枚の画像は着こなしの参考にさせてください。） \n\n私の依頼を考慮していただき、本当にありがとうございました!!!", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/17", "thumbnail_src": "https://si.imgix.net/836f53bd/uploads/origins/a714d02f-7824-42e1-8359-3506d1184c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7c647cdf8837a3ee0429d68cfa0440", "thumbnail_srcset": "https://si.imgix.net/836f53bd/uploads/origins/a714d02f-7824-42e1-8359-3506d1184c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7c647cdf8837a3ee0429d68cfa0440, https://si.imgix.net/836f53bd/uploads/origins/a714d02f-7824-42e1-8359-3506d1184c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3c399e28b1bf8478a217c7547253ea2 2x, https://si.imgix.net/836f53bd/uploads/origins/a714d02f-7824-42e1-8359-3506d1184c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5100f735baefc3905b55f9e3734ff9f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、この男の子のアートワークをお願いしたいのですが、https://sta.sh/21mompzalk1f?edit=1。\n\n性別：男性\n年齢：22歳〜25歳\n彼はショタではありません。美少年です。年齢は、あなたが描いたこのキャラクターくらいです https://sta.sh/01njhyogqsoo\n\n邪悪な天使です。\nテーマはカジノとギャンブル。", "created_at": "", "completed_at": ""}, {"path": "/@krykkk/works/16", "thumbnail_src": "https://si.imgix.net/874eaddb/uploads/origins/872cf2e9-4109-4e64-81d3-55ae2804b615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b5c2ca9a1a8092500ae336aa882832d", "thumbnail_srcset": "https://si.imgix.net/874eaddb/uploads/origins/872cf2e9-4109-4e64-81d3-55ae2804b615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b5c2ca9a1a8092500ae336aa882832d, https://si.imgix.net/874eaddb/uploads/origins/872cf2e9-4109-4e64-81d3-55ae2804b615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80daf4