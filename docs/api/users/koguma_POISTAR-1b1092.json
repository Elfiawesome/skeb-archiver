5d-4ba6-b432-5c7de4ddde48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=899565977cdfa50427b45e10871ee685 2x, https://si.imgix.net/1cbfbe64/uploads/origins/a338f378-bf5d-4ba6-b432-5c7de4ddde48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d28ae3abfcb37a34b02aadc4e1a6dd2 3x", "genre": "art", "nsfw": false, "body": "はじめまして。TwitchでVstreamerとして活動している八束見そねみと申します。\nこぐま様の作品の雰囲気がとても魅力的で、ぜひお願いしたいと考え依頼いたしました。\n\n【依頼内容】\n・ネモフィラ(もしくは青い花)の花束を抱いている自身のイラスト\n・服装は設定の通り\n・もし可能でしたら表情の差分をいただけると嬉しいです\n・花束の持ち方や、立ち座りなどのポーズはお任せします(アップでも引きでも可能)\n・また、背景を透過したものもいただけると大変助かります。\n\n【使用用途】\n・デスクトップの壁紙/SNSのアイコン/Xでの告知\n\n以上となります。\nもし依頼内容が煩雑で引き受け難い場合、却下していただいても構いません。\nお忙しいところ恐れ入りますが、よろしくお願いいたします。\n\nhttps://twitter.com/yatsukamisonemi/status/1725134237819662543", "created_at": "", "completed_at": ""}, {"path": "/@koguma_POISTAR/works/14", "thumbnail_src": "https://si.imgix.net/10be9b63/uploads/origins/5ca03cfa-d6c9-44a8-8af5-9d74a1a0ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b530c82be19c7cd32a743bcf0521e2", "thumbnail_srcset": "https://si.imgix.net/10be9b63/uploads/origins/5ca03cfa-d6c9-44a8-8af5-9d74a1a0ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b530c82be19c7cd32a743bcf0521e2, https://si.imgix.net/10be9b63/uploads/origins/5ca03cfa-d6c9-44a8-8af5-9d74a1a0ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0efa464cf1e2796ce3c3c5a53a0ece6d 2x, https://si.imgix.net/10be9b63/uploads/origins/5ca03cfa-d6c9-44a8-8af5-9d74a1a0ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff2da90381855be29f4aff92ca89daac 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n台湾のVtuber個人勢のバキズと申します。\nメスガキな小悪魔です💗\n\n先生のイラストはいつも可愛いに癒されています。\nぜひ私を描いていただきたいです💗\n\n依頼内容は以下です：\n一ノ瀬志希【秘密のトワレ】歌ってみたのイラストを担当させて頂いております。\n提出形式はpsdファイルで人物と背景がレイヤー分けで描いている方でお願いいたします。\n\n【構図】\n｜構図、髪型はお任せいたします！服装も自由に変更してください\n｜科学者の白いガウンを着ています。身の回りにはいくつか美しい香水瓶があります。\n｜もし可能であれば表情差分があると嬉しいです\n｜人物、背景を別レイヤーにしていただけますと幸いです\n\n【使用用途】\n\n・YouTubeのサムネイルへの使用\n・配信内で絵の紹介\n・Twitter、FANBOX等のSNSへの投稿\n・アイコンやヘッダーへの使用\n・可能であれば、少量生産のグッズを作って販売させていただきたいです。\n(こちらNGの場合は、別レイヤーにその旨記載いただけますと幸いです。)\n\n条件が合いましたらぜひよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zQmM5yXHsZlzFquwHOWDT4LwrJIrszke", "created_at": "", "completed_at": ""}, {"path": "/@koguma_POISTAR/works/13", "thumbnail_src": "https://si.imgix.net/9347cf08/uploads/origins/e6b6127e-a149-449a-8510-82d93514a2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99f1ffaf635d5be71b1c51771cec5f90", "thumbnail_srcset": "https://si.imgix.net/9347cf08/uploads/origins/e6b6127e-a149-449a-8510-82d93514a2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99f1ffaf635d5be71b1c51771cec5f90, https://si.imgix.net/9347cf08/uploads/origins/e6b6127e-a149-449a-8510-82d93514a2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72ec9d15d124a210acd2df47610ffcd3 2x, https://si.imgix.net/9347cf08/uploads/origins/e6b6127e-a149-449a-8510-82d93514a2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b010e1f2bc1512e024bac78624ce9937 3x", "genre": "art", "nsfw": false, "body": "毒楽こぐまさん\nはじめまして\n私のオリジナルキャラクターを描いていただきたいです\n以下、キャラクターの資料のURLです。\n\nhttps://drive.google.com/drive/folders/11eaCjxXRkK0aX6V613m9cE4I4HfjQoUP\n\nお嬢様口調な怪盗の女の子のキャラクターです。\nナルシストでいつも自信満々ですが、ポンコツなアホの子です。\nカッコ付けながら悪い事をしますが、よくドジを踏んで失敗してしまいます。\n\n構図等はお任せします。\n長くなりましたが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@koguma_POISTAR/works/12", "thumbnail_src": "https://si.imgix.net/291b7a31/uploads/origins/b64f90ae-793f-4f0d-b9f2-b27b7285ba69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=947ab433cb3775bfe3450cdd72ec5d4a", "thumbnail_srcset": "https://si.imgix.net/291b7a31/uploads/origins/b64f90ae-793f-4f0d