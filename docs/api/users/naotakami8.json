at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=305c4c5c6132544475e34fede9bd8f81 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@naotakami8/works/409", "thumbnail_src": "https://si.imgix.net/a24aab36/uploads/origins/336dbdcd-d85c-45d4-82c3-bd6706ffe2d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c9145d860e8ef03d985cf0db5996d9", "thumbnail_srcset": "https://si.imgix.net/a24aab36/uploads/origins/336dbdcd-d85c-45d4-82c3-bd6706ffe2d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c9145d860e8ef03d985cf0db5996d9, https://si.imgix.net/a24aab36/uploads/origins/336dbdcd-d85c-45d4-82c3-bd6706ffe2d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bdc9d90a83fc2f45df3395a88e12486 2x, https://si.imgix.net/a24aab36/uploads/origins/336dbdcd-d85c-45d4-82c3-bd6706ffe2d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bc9eddc46ea10e402d316709929dbbe 3x", "genre": "art", "nsfw": true, "body": "おはようございます。お世話になります。今回は以下の内容でリクエストさせていただきますので、ご検討をお願いいたします。\n\n●キャラクター\n小早川美幸(逮捕しちゃうぞ)\n※資料URLにpixiv百科事典の記事を添付\n\n\n●状況\n悪漢に捕まった後に彼らの情婦に堕とされてしまい、事務所で見せ物に。\n\n●ポーズ\nエロ蹲踞。\n両手で前の穴を広げ、股下に置かれた身分証明の手帳に中出しされた精液を垂らしている。\n\n●服装\nあちこちが破損した制服を着用。\n胸元ははだけている。下着は乳首と局部の部分に穴が空いている。\n\n●表情\n媚薬や度重なる行為で堕ちた姿のため、恍惚とした笑みを浮かべている。\n\n●その他\n・上記以外の描写に指定はございません。また、アレンジしていただいて問題ございません。\n\n以上になります。\n\nまた、可能であれば差分としまして「身体に落書き、あるいはタトゥーが入った姿」をお願いいたします。\n\nよろしければご検討いただけますと幸いです。\n\nhttps://dic.pixiv.net/a/%E5%B0%8F%E6%97%A9%E5%B7%9D%E7%BE%8E%E5%B9%B8", "created_at": "", "completed_at": ""}, {"path": "/@naotakami8/works/408", "thumbnail_src": "https://si.imgix.net/d2e33af7/uploads/origins/65cacbff-23fd-43f5-bc2b-cd0fc775965c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad115dec172f4557ec930058e841a920", "thumbnail_srcset": "https://si.imgix.net/d2e33af7/uploads/origins/65cacbff-23fd-43f5-bc2b-cd0fc775965c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad115dec172f4557ec930058e841a920, https://si.imgix.net/d2e33af7/uploads/origins/65cacbff-23fd-43f5-bc2b-cd0fc775965c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a90bc89070af794d2874d5b2e327a81c 2x, https://si.imgix.net/d2e33af7/uploads/origins/65cacbff-23fd-43f5-bc2b-cd0fc775965c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ba3df971771fdef0d98ec73e8cf51da 3x", "genre": "art", "nsfw": true, "body": "尚たかみ様   その節はお世話になりました。 \nこの度、また新たにイラストを描いていただけたらと依頼を送らせていただきました。\n\n\n【キャラクター】\n版権無しの尚たかみ様のオリジナルデザイン。\nポニーテールの髪型で競泳水着を着た女性と、青い肌をした2匹のゴブリンタイプの亜人。\n\n\n【シチュエーション】\n女性が背後から亜人にしがみつかれ、腕ごと亜人の脚でホールドされて身動きが取れなくされた状態で、後ろから水着越しの胸を揉まれる。\n\n女性は膝から崩れ落ちそうになるも前面にいるもう1匹の亜人が立位を強制し、亜人は手に持ったいくつもの有線式ピンクローターを水着の脇から膣内へと捩じ込んでいく。\n\n\n\nといった内容で、競泳水着姿の女性が胸を揉まれながらローターを入れられ、股間から4つほどローターのリモコンがぶら下がっているイラストをお願いできないでしょうか？\n細かなデザイン、構図、ロケーションはお任せします。\n\nご都合がよければ、どうか宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@naotakami8/works/407", "thumbnail_src": "https://si.imgix.net/c6a527aa/uploads/origins/8f2a1be2-d320-4bdd-92ab-83b374bbd647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03012b69c2074fd14663cdb7907ef37e", "thumbnail_srcset": "https://si.imgix.net/c6a527aa/uploads/origins/8f2a1be2-d320-4bdd-92ab-83b374bbd647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03012b69c2074fd14663cdb7907ef37e, https://si.imgix.net/c6a527aa/uploads/origins/8f2a1be2-d320-4bdd-92ab-83b374bbd647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=