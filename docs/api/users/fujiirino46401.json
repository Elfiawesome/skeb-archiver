・また、表情の差し替えパーツ等ございましたら嬉しいです。\n\n【その他】\n・PSDデータで、キャラクターのレイヤーだけ分かれているととても助かります。\n\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@fujiirino46401/works/5", "thumbnail_src": "https://si.imgix.net/dd9d21d5/uploads/origins/ab240608-2324-4fc0-a203-eac92991657f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b88aaf2401515050cae72ccaf2dcbeb2", "thumbnail_srcset": "https://si.imgix.net/dd9d21d5/uploads/origins/ab240608-2324-4fc0-a203-eac92991657f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b88aaf2401515050cae72ccaf2dcbeb2, https://si.imgix.net/dd9d21d5/uploads/origins/ab240608-2324-4fc0-a203-eac92991657f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63db304aed810b9c8d569810446aaac2 2x, https://si.imgix.net/dd9d21d5/uploads/origins/ab240608-2324-4fc0-a203-eac92991657f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6659aa6e426212f231a39ea877cf205 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fujiirino46401/works/4", "thumbnail_src": "https://si.imgix.net/0f74f9e5/uploads/origins/c9909d1f-1f53-4d40-8348-33e879dbeb51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb8ebb4550fc2397068af56e96281a8c", "thumbnail_srcset": "https://si.imgix.net/0f74f9e5/uploads/origins/c9909d1f-1f53-4d40-8348-33e879dbeb51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb8ebb4550fc2397068af56e96281a8c, https://si.imgix.net/0f74f9e5/uploads/origins/c9909d1f-1f53-4d40-8348-33e879dbeb51?bg=%23fff&auto