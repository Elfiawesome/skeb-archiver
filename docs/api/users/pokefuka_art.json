.net/4554a30d/uploads/origins/7a793997-077c-4bed-8a67-0b5e5342ba9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=280cf4d02dc904610e65eee6df9ebc0c, https://si.imgix.net/4554a30d/uploads/origins/7a793997-077c-4bed-8a67-0b5e5342ba9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10141d3059c168458c7a8fd6102ecc27 2x, https://si.imgix.net/4554a30d/uploads/origins/7a793997-077c-4bed-8a67-0b5e5342ba9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d64a9d1b668f76a59b22f016004defbc 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとてもキュートで、とても気に入っています。\nまた何か作ってください。\nhttps://drive.google.com/drive/folders/199HMVypBmXD82KVq_E5sQg2WgHh225S5?usp=sharing\n\nhttps://drive.google.com/drive/folders/199HMVypBmXD82KVq_E5sQg2WgHh225S5?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pokefuka_art/works/26", "thumbnail_src": "https://si.imgix.net/ff525c64/uploads/origins/264cb0e9-4918-44a2-8661-b1d492f12b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a4985e9b7e3d619a886a281d27721c1", "thumbnail_srcset": "https://si.imgix.net/ff525c64/uploads/origins/264cb0e9-4918-44a2-8661-b1d492f12b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a4985e9b7e3d619a886a281d27721c1, https://si.imgix.net/ff525c64/uploads/origins/264cb0e9-4918-44a2-8661-b1d492f12b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=427fbf14d051d958b5f84341e689801b 2x, https://si.imgix.net/ff525c64/uploads/origins/264cb0e9-4918-44a2-8661-b1d492f12b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ee903aba58493855a1ced83279014f1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pokefuka_art/works/25", "thumbnail_src": "https://si.imgix.net/8b6de7ce/uploads/origins/2d593d96-c8ed-449a-afd1-ffebb7540096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a3f31949cb3151ddf62984b82310ee", "thumbnail_srcset": "https://si.imgix.net/8b6de7ce/uploads/origins/2d593d96-c8ed-449a-afd1-ffebb7540096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a3f31949cb3151ddf62984b82310ee, https://si.imgix.net/8b6de7ce/uploads/origins/2d593d96-c8ed-449a-afd1-ffebb7540096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2014c1476a83df45d1b390bba99f1f39 2x, https://si.imgix.net/8b6de7ce/uploads/origins/2d593d96-c8ed-449a-afd1-ffebb7540096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eaa84ba13296c5ee1d5dc2482940951 3x", "genre": "art", "nsfw": false, "body": "アピールしてくれて本当にありがとう!デイビスのバックストーリーを読んでくれて本当に光栄です!確かに彼はポケモンの生態学者です!彼はアローラのポケモンレーナー学校で勉強しました。そして現在、彼は奇妙なポケモンの研究と保護のために エーテル財団の支部で働いているんだ。\n\nデイビスの服装は、参考画像で自由に描いてください！主な相棒ポケモンはゴクリン。ゴクリンは幼い頃からずっと一緒で、大食漢でデイビスを困らせることも多いが、ゴクリンとデイビスはとても深い絆で結ばれている。\n\nゴクリンとデイビスはとても深い絆で結ばれていますが、もし他のポケモンを描きたいのであれば、デイビスと他のポケモンを一緒に描くこともできます！\n彼のポケモンをいくつか紹介しよう：ネイティオ、プテラ、ツボツボ、トリデプス\n\n今回もたくさんのご応募ありがとうございました！ダビスを描くことを楽しんでくださいね！素敵な一日を\n\nhttps://sta.sh/27tru1feqjx?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@pokefuka_art/works/24", "thumbnail_src": "https://si.imgix.net/bb8f3011/uploads/origins/4e2a67f3-a0a6-4e2b-b1dd-fd8b7378c81e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e058fc32edbfb6c1bce7b8ff2c644183", "thumbnail_srcset": "https://si.imgix.net/bb8f3011/uploads/origins/4e2a67f3-a0a6-4e2b-b1dd-fd8b7378c81e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e058fc32edbfb6c1bce7b8ff