=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94889cb64ec8cbe9f3dab9f2700be63d, https://si.imgix.net/4bef36f2/uploads/origins/0e653479-a59f-4cb8-bca6-3d517d92d28f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed6c162988706cae8642e4eee7050338 2x, https://si.imgix.net/4bef36f2/uploads/origins/0e653479-a59f-4cb8-bca6-3d517d92d28f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64917436b6216468402eae67713f80e1 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。紐さんに依頼したいイラストがあります。それは遊戯王GXに出てくる｢D-HERO Blue-D｣というモンスターです。私がやってる遊戯王マスターデュエルというカードゲームでのエースモンスターで、そのイラストが欲しいなというのが理由です。あとは誕生日が近いので自分へのプレゼントって事で...ポーズはかっこいい姿をお願いします!作画資料があるかはちと分かりません...", "created_at": "", "completed_at": ""}, {"path": "/@Himo_Red/works/6", "thumbnail_src": "https://si.imgix.net/687268f2/uploads/origins/023d800d-6d31-4ed0-81a3-702c8dfd4a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662596442b48038f50dec7145107ab6b", "thumbnail_srcset": "https://si.imgix.net/687268f2/uploads/origins/023d800d-6d31-4ed0-81a3-702c8dfd4a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662596442b48038f50dec7145107ab6b, https://si.imgix.net/687268f2/uploads/origins/023d800d-6d31-4ed0-81a3-702c8dfd4a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c8b58c4898abad3d0480b96d74bdea7 2x, https://si.imgix.net/687268f2/uploads/origins/023d800d-6d31-4ed0-81a3-702c8dfd4a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82c5a5180bd0dfd8cf40c30a46e531c8 3x", "genre": "art", "nsfw": false, "body": "初めまして。以前からKOS-MOSの絵を描かれていると知っていたのですがRe:も描いていると知り依頼させていただきました。\n\n今年の11/30はKOS-MOS Re:が初めて発表されて6周年でして、その記念絵を描いていただきたいです。\nKOS-MOS Re:の魅力、カッコよさ、美しさ、かわいさ、セクシーさを表現したイラストをお願いします。\nKOS-MOS Re:発表6周年と分かる文字を載せてください(KOS-MOS Re: 6th anniversaryなど)\n指定はありませんが表情とポーズはKOS-MOSらしいものでお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Himo_Red/works/5", "thumbnail_src": "https://si.imgix.net/4d5ace57/uploads/origins/0f7f17d0-fc8d-4adf-ac43-8e4fed56e1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccaaa422b0d30254138015b5b8c1c514", "thumbnail_srcset": "https://si.imgix.net/4d5ace57/uploads/origins/0f7f17d0-fc8d-4adf-ac43-8e4fed56e1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccaaa422b0d30254138015b5b8c1c514, https://si.imgix.net/4d5ace57/uploads/origins/0f7f17d0-fc8d-4adf-ac43-8e4fed56e1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=729d8e63fe4c0200b57a38c8721d1f71 2x, https://si.imgix.net/4d5ace57/uploads/origins/0f7f17d0-fc8d-4adf-ac43-8e4fed56e1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=503c63d78fe3c91790377e88f88bfc59 3x", "genre": "art", "nsfw": false, "body": "覇王大系リューナイトからパラディン姿のアデューをお願いしたいです。\n精霊石の剣を手に全身炎を纏い、傷つきながらも勇ましく果敢に敵に立ち向かうといった感じで描いてほしいです。\n鎧やインナーなど、適度に汚れや傷、ヒビや汗などダメージ感を出していただけるとありがたいです。\nなるべく全身に近い姿を入れてほしいですが、少年漫画的な躍動感のある、熱くかっこいい雰囲気を優先していただいて大丈夫です。\nタセット(腰当て)の隙間から覗くふとももや腹筋、二の腕などのインナーはタイトめに表現して筋肉感を出して欲しく、インナーの下の躍動感がわかるよう描いてほしいです。構図的に盾が邪魔な場合なくても大丈夫です。\n\nhttps://i.imgur.com/TEOU9NQ.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Himo_Red/works/4", "thumbnail_src": "https://si.imgix.net/b256fd70/uploads/origins/7afe8893-52de-47b2-aac7-dc41856a5e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2090e55bbb95c6b1a8aae02e4bd722a", "thumbnail_srcset": "https://si.imgix.net/b256fd70/uploads/origins/7afe8893-52de-47b2-aac7-dc41856a5e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2090e55bbb95c6b1a8aae02e4bd722a, https://si.imgix.net/b256fd70/uploads/origins/7afe8893-52de-47b2-aac7-dc41856a5e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cfcc81e0df34e2fe7a2dddd19a61f39 2x, https://si.imgix.net/b256fd70/uploads/origins/7afe8893-52de-47b2-aac7-dc41856a5e25?b