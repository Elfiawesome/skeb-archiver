4c78-925c-8884d0d9c566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce6b7a07f00c9f1a683fe4dfb3a5c7ab", "thumbnail_srcset": "https://si.imgix.net/630a3601/uploads/origins/3a0f025b-ca05-4c78-925c-8884d0d9c566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce6b7a07f00c9f1a683fe4dfb3a5c7ab, https://si.imgix.net/630a3601/uploads/origins/3a0f025b-ca05-4c78-925c-8884d0d9c566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20d5d59525e43c43f5265ef536f24134 2x, https://si.imgix.net/630a3601/uploads/origins/3a0f025b-ca05-4c78-925c-8884d0d9c566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf2c4512fb5d181a0e821f8e05cf544 3x", "genre": "art", "nsfw": false, "body": "はじめまして！またまたお忙しいところ大変申し訳ないのですが、もし可能であれば、私のもう一組のOOCのインタラクションを描いて頂きたいのです！元々男性なので、出来れば女性として描いて頂きたいかもしれません、リンク先（画像33）に女性の方の参考を載せておきました。\n 彼らの簡単な説明はこちら↓。\n\n龍之介：黒髪、緑の瞳、刑事課の警察官、身長187cm、性格は冷静沈着、怒った時に笑うと表情がとても怖くなる、椎名は同僚で鑑識課の警察官、龍之介の先輩でもある。龍之介は可愛いものが好きで、先輩として椎名には少し迷惑をかけているが、相手の綺麗な容姿とふっくらとした柔らかい体から徐々に椎名が好きになっていく。\n椎名（♀）：黒髪で赤目の鑑識官、身長168cm、どこか戸惑ったような垢抜けない表情の女性で、日頃はいつも元気のない表情をしている。龍之介をからかうのが好きで、自分の思い通りになるが、その後いつも龍之介にいじめられる。今では龍之介を怖がり、ペットとして飼われている。\n\nもし可能なら、椎名のバニーガールコスチュームを描いていただきたい！二人の性格の範囲内であれば、どんなやりとりでも自由に描いてください！詳しい設定や情報はリンク先に記載しました。もし金額に満たない場合は、再度リクエストを送っていただけると助かります！この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1si0qXG7Z7HBkuJkpGrP4VP42MaZHP5zr?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@TRNnmnm4/works/35", "thumbnail_src": "https://si.imgix.net/ec8b1381/uploads/origins/583633bd-d660-4853-9aa6-2b7a5efacbb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d558f996c64976c931cbede4944f672", "thumbnail_srcset": "https://si.imgix.net/ec8b1381/uploads/origins/583633bd-d660-4853-9aa6-2b7a5efacbb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro