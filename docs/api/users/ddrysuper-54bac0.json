FFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e75f2b972428c9c2a1b32f2a932dad6 2x, https://si.imgix.net/25194b58/uploads/outputs/5062e118-6db7-43a3-9645-6ce5245bc8dd?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ede3284a1178cb872499215928844320 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/22", "thumbnail_src": "https://si.imgix.net/3f9d4c3e/uploads/origins/1e239a5b-b6d8-42ba-a8ac-1998be5dafe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=984fffefab227cf9e864d445f08391bc", "thumbnail_srcset": "https://si.imgix.net/3f9d4c3e/uploads/origins/1e239a5b-b6d8-42ba-a8ac-1998be5dafe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=984fffefab227cf9e864d445f08391bc, https://si.imgix.net/3f9d4c3e/uploads/origins/1e239a5b-b6d8-42ba-a8ac-1998be5dafe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4e209be7b49d053b04bfa459f0024a5 2x, https://si.imgix.net/3f9d4c3e/uploads/origins/1e239a5b-b6d8-42ba-a8ac-1998be5dafe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8cd5a3ad9a301717ed3cb9f0077a67a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/21", "thumbnail_src": "https://si.imgix.net/d366d3c4/uploads/origins/0a96594c-b344-4708-8b68-19549419eef6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbd6f6e51f782a5230ed2b4ab42d0e3", "thumbnail_srcset": "https://si.imgix.net/d366d3c4/uploads/origins/0a96594c-b344-4708-8b68-19549419eef6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbd6f6e51f782a5230ed2b4ab42d0e3, https://si.imgix.net/d366d3c4/uploads/origins/0a96594c-b344-4708-8b68-19549419eef6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e469283340ce461af244ba4323fd22c4 2x, https://si.imgix.net/d366d3c4/uploads/origins/0a96594c-b344-4708-8b68-19549419eef6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15f96d590d32ed927f0bd8030a8a1c62 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVTuberのルイーズが描かれたファンの方の抽選をお願いしたいと思います：\nhttps://drive.google.com/drive/folders/19rouZz0A4yLEOgMUgvcRs02hFhrIA8u7?usp=sharing\n\n彼女はニートで、ひきこもりです。普段はとても怠惰で眠い！裸足が大好き！\n好きなことは、アニメを見ること、漫画を読むこと、ゲームをすること、ライブ配信をすること、インターネットをすること。\n\n描いてもらう内容を簡単にまとめるとこんな感じ：\n「汚れて穴の空いた靴下を履いた彼女の足をクローズアップして、POVで描く。さらに、彼女の長い足の爪の下も汚れている。\"\n\n靴下の種類は5本指ソックス。https://drive.google.com/drive/folders/1yteszlaOSXLy5y46gpQ_EVrKkkMjmlo4?usp=sharing\n\n可能であれば、靴下バージョンと裸足バージョンもお願いします。リクエストが多ければ、他のバージョンもお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/20", "thumbnail_src": "https://si.imgix.net/453314b0/uploads/origins/71202c71-c856-4c57-998a-a4d28ae9799f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7500f0d0447b1baa044d8e0c19f5052e", "thumbnail_srcset": "https://si.imgix.net/453314b0/uploads/origins/71202c71-c856-4c57-998a-a4d28ae9799f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7500f0d0447b1baa044d8e0c19f5052e, https://si.imgix.net/453314b0/uploads/origins/71202c71-c856-4c57-998a-a4d28ae9799f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bc5c521726050d3b7cde2fd60977650 2x, https://si.imgix.net/453314b0/uploads/origins/71202c71-c856-4c57-998a-a4d28ae9799f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7099ea0e25f0225a29288994568a8e4 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nリクエストさせていただきます。\n\n地味子にお願いして靴の臭いを嗅がせてもらうイラストをリクエストさせていただきます。\n\n地味子\nオーバル型の眼鏡に黒髪ポニテ\nベージュのパーカーにジーパン\n足裏は真っ黒に汚れた靴下\n履き潰して激臭で汚いスニーカー\n\nスニーカーはこちらのコンバース風の靴でお願いします。\nhttps://imgur.com/FMOpPLy\n可能な限り汚して、穴や破れも再現してほしいです。\n\n構図は、先生が以前fanboxに投稿されていた『西脇結子の臭い足押し付け』のローファーを持って足裏を見せているイラストと同じ構図でお願いします。\nhttps://www.fanbox.cc/@spdry/posts/8248380\n表情は困惑しつつ恥ずかしそうにしている感じでお願いします。\n出来ればスニーカーを大きく描いていただき、いかにもボロくて臭そうに描いていただきたいです。\n\n差分として、足型に汚れた中敷きのイラストもお願いしたいです。\n\nセリフはお任せします。無くても構いません。\n\n注文が多くて申し訳ありませんが、ご検討のほどよろしくお願いします。\n\nhttps://imgur.com/FMOpPLy", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/19", "thumbnail_src": "https://si.imgix.net/922cec1b/uploads/origins/d5130f51-99e2-4458-b72e-2b634bc466cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2da92d282ed9ad7e7db76e7a6f1f9296", "thumbnail_srcset": "https://si.imgix.net/922cec1b/uploads/origins/d5130f51-99e2-4458-b72e-2b634bc466cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2da92d282ed9ad7e7db76e7a6f1f9296, https://si.imgix.net/922cec1b/uploads/origins/d5130f51-99e2-4458-b72e-2b634bc466cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39a5fc5930d96829057f327b4f29769b 2x, https://si.imgix.net/922cec1b/uploads/origins/d5130f51-99e2-4458-b72e-2b634bc466cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c966c808ef7285f5330cdffc80a47fa0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/18", "thumbnail_src": "https://si.imgix.net/2872aeac/uploads/origins/ed7a805d-eb28-441b-9b42-a52878c0ab77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53728a62b870ecf60d361185161679c0", "thumbnail_srcset": "https://si.imgix.net/2872aeac/uploads/origins/ed7a805d-eb28-441b-9b42-a52878c0ab77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53728a62b870ecf60d361185161679c0, https://si.imgix.net/2872aeac/uploads/origins/ed7a805d-eb28-441b-9b42-a52878c0ab77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64f51618cb9d9400690663faf78b4748 2x, https://si.imgix.net/2872aeac/uploads/origins/ed7a805d-eb28-441b-9b42-a52878c0ab77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fef5f6ab3bc49646b07de5953b80ebc4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/17", "thumbnail_src": "https://si.imgix.net/c3a081ef/uploads/origins/3284968e-a7e6-4ff5-a567-1936820ae0e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d665863d9196190b30cc79e92c059ea2", "thumbnail_srcset": "https://si.imgix.net/c3a081ef/uploads/origins/3284968e-a7e6-4ff5-a567-1936820ae0e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d665863d9196190b30cc79e92c059ea2, https://si.imgix.net/c3a081ef/uploads/origins/3284968e-a7e6-4ff5-a567-1936820ae0e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7834682c8309248728bd01fe485f7c58 2x, https://si.imgix.net/c3a081ef/uploads/origins/3284968e-a7e6-4ff5-a567-1936820ae0e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2b4f34e0c5afc42e037e7c255288f9a 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n先日投稿されていたイリヤのイラストがとても可愛いかったのでリクエスト失礼します！\n\nプリズマイリヤのイリヤ(変身後の衣装)が限界まで蒸らしたブーツを脱ぎ足裏を見せて匂いも嗅がせてくれるシチュでお願いします。\n先日のイリヤのイラストのように困惑しながらも笑顔な感じでお願いします。\n\n細かな流れは\n事前にお願いされていて魔法少女に変身した状態で限界まで沢山体を蒸らしてくれているイリヤ。魔力は殆ど無く、変身もいつ強制解除されるか分からない状態(セリフでそのことに触れてください。苦しそうな感じは無しか控えめでお願いします)\nイリヤは全身がもの凄く激しく蒸れていて湯気が凄く出ています。そしてえげつなく汗臭くなってます。ただし、コスチュームの透け感は無しでお願いします\n\nブーツの中もとんでもないことになってるだろうけど本当にそれでもいいのかと確認するイリヤ。それでもいいと告げる\n\nブーツを脱ぐ(ホットピンクのオーバーニーソックスはそのまま)ブーツとブーツに包まれていた脚は凄まじい熱気の湯気とえげつない匂いになっていた。ニーソは透け無しでお願いします(脱いだブーツの描写があれば幸いです)\n\n匂いを指摘されて恥ずかしがる\n\n突然、見抜きを始められて驚く\n\nしごいてる様子を見つめる\n\n射精寸前なことを告げられる\n\n射精される\n\nその後の反応\n\nという流れでお願いします\n\nキャラ描写はイリヤのみでその他の人物は影や男性器等も一切無しでお願いします\n\nイリヤは魔法少女のコスチュームで完全着衣でお願いします\n\n通常イリヤはパンツですが今回はショートスパッツでお願いします。直穿きでお願いします。アームカバーやニーソと同じホットピンクでお願いします\n\nニーソやアームカバーのインナー、スパッツはテカテカな光沢感を出してください\n\n可能であれば上記シチュのニーソ無しの生足裏差分、そして嫌悪感、羞恥心ゼロで罪悪感を覚える程の純粋な笑顔(ノリノリ)で上記のシチュをしてくれているものをお願いします\n\nポーズや足の裏の見え方は先日のイリヤのような感じでお願いします\n\nすーぱーどらい様の考えるセリフが大好きなのでセリフを付けていただきたいです\n\n効果音や湯気、臭気、セリフ、精液表情などはレイヤーで切り替えられると幸いです\n\nすーぱーどらい様の凄く可愛いイリヤを再び見られることを楽しみにしてます", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/16", "thumbnail_src": "https://si.imgix.net/0e3384ff/uploads/outputs/285134fb-083d-4249-a980-d1316e69f900?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20e59eae0427c1d6272f242f08099a63", "thumbnail_srcset": "https://si.imgix.net/0e3384ff/uploads/outputs/285134fb-083d-4249-a980-d1316e69f900?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20e59eae0427c1d6272f242f08099a63, https://si.imgix.net/0e3384ff/uploads/outputs/285134fb-083d-4249-a980-d1316e69f900?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19b392a25de2262d5f75176840c9621b 2x, https://si.imgix.net/0e3384ff/uploads/outputs/285134fb-083d-4249-a980-d1316e69f900?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1bac5e1ea86df612d7d4feea6a663f4 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/15", "thumbnail_src": "https://si.imgix.net/92619011/uploads/origins/93695137-3af1-4e92-8851-ee3ad8eb1cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d15d743f1e4cc42bb63e719fa1b2e6c", "thumbnail_srcset": "https://si.imgix.net/92619011/uploads/origins/93695137-3af1-4e92-8851-ee3ad8eb1cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d15d743f1e4cc42bb63e719fa1b2e6c, https://si.imgix.net/92619011/uploads/origins/93695137-3af1-4e92-8851-ee3ad8eb1cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=116cec45512f4615998e241fe9856164 2x, https://si.imgix.net/92619011/uploads/origins/93695137-3af1-4e92-8851-ee3ad8eb1cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b54435846c64ed19141085bc1832a5b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/14", "thumbnail_src": "https://si.imgix.net/a8002e57/uploads/origins/1f1306a5-0465-4057-a386-a7d0f221a4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d7f758dc9d808996e5b50835c430ae", "thumbnail_srcset": "https://si.imgix.net/a8002e57/uploads/origins/1f1306a5-0465-4057-a386-a7d0f221a4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d7f758dc9d808996e5b50835c430ae, https://si.imgix.net/a8002e57/uploads/origins/1f1306a5-0465-4057-a386-a7d0f221a4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=709a415dc6c4134250d0650b3651c34a 2x, https://si.imgix.net/a8002e57/uploads/origins/1f1306a5-0465-4057-a386-a7d0f221a4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d83d6be012d183e04b41b321e37b1ca 3x", "genre": "art", "nsfw": false, "body": "こんにちは、前回の依頼で素晴らしい仕事をしていただいたので、また西脇裕子さんのイラストをお願いします。\n\n今回は、彼女が両足で誰かをもみくちゃにしているイラストをお願いします。また、ローファーのかかとがつぶれて、中敷きが極端にすり減っているようなイラストもお願いします。ポーズとシナリオはお任せします。\n\n彼女が裸足と靴下を履いている2つのバリエーションが欲しい。\n\n彼女の足ができるだけ不潔で、汚れていて、汗ばんでいるように見えるようにしてください。靴下もできるだけ汚く見えるようにしてください。\n\n足の裏は以前のように明るい色にしてください。\n\n台詞はあなた次第ですが、とても卑劣な台詞にしてください。\n\n必要なだけ時間をかけてください。", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/13", "thumbnail_src": "https://si.imgix.net/166e2b62/uploads/origins/af85cd6c-de10-4524-950c-2b594e93b652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14d1ed77fd03c9451f6d35d376827bd", "thumbnail_srcset": "https://si.imgix.net/166e2b62/uploads/origins/af85cd6c-de10-4524-950c-2b594e93b652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14d1ed77fd03c9451f6d35d376827bd, https://si.imgix.net/166e2b62/uploads/origins/af85cd6c-de10-4524-950c-2b594e93b652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e6e65cf097d4a56d0a09d5cd514203a 2x, https://si.imgix.net/166e2b62/uploads/origins/af85cd6c-de10-4524-950c-2b594e93b652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f47e54dbb7687e33123ab468d9412b52 3x", "genre": "art", "nsfw": true, "body": "Hi, I would like to request an artwork of Chisa Yukizome (Danganronpa 3 anime version): https://danganronpa.fandom.com/wiki/Chisa_Yukizome/Image_Gallery?file=Danganronpa_3_-_Character_Profiles_-_Chisa_Yukizome_%28Despair_Profile%29.png\n\nI would like to see her dirty, stinky sock soles similar to these works (https://www.pixiv.net/en/artworks/116570271 and https://www.pixiv.net/en/artworks/119223304).\n\nIt would be great to have variations featuring socks, short skin-color stockings (https://m.media-amazon.com/images/I/81qVuXpQLJL._AC_SX679_.jpg), and a footjob alter (if possible).\n\nThanks!\n\nhttps://danganronpa.fandom.com/wiki/Chisa_Yukizome/Image_Gallery?file=Danganronpa_3_-_Character_Profiles_-_Chisa_Yukizome_%28Despair_Profile%29.png", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/12", "thumbnail_src": "https://si.imgix.net/41d6e1b5/uploads/origins/71d5655a-aa45-474e-8753-85df1010928d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6ef31ccbec93740b4143c13be58ed31", "thumbnail_srcset": "https://si.imgix.net/41d6e1b5/uploads/origins/71d5655a-aa45-474e-8753-85df1010928d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6ef31ccbec93740b4143c13be58ed31, https://si.imgix.net/41d6e1b5/uploads/origins/71d5655a-aa45-474e-8753-85df1010928d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c5125955a09c8d9b6c4395156b5eabd 2x, https://si.imgix.net/41d6e1b5/uploads/origins/71d5655a-aa45-474e-8753-85df1010928d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edbd4a1af0e48a5f09d6bb164b6850f1 3x", "genre": "art", "nsfw": true, "body": "Hi, thank you so much for the Megumi Katou work! It is the best feet soles work I have ever seen.\n\nI hope to request an artwork of Irisviel von Einzbern (Fate/Zero). Her feet must be extremely stinky after wearing long boots for a long time! Feel free to draw her in any way you think is best.\n\nIt would be nice to have both long pantyhose and foot covers alter (example: https://www.pixiv.net/en/tags/%E3%83%95%E3%83%83%E3%83%88%E3%82%AB%E3%83%90%E3%83%BC/artworks)\n\nThank you!\n\nhttps://typemoon.fandom.com/wiki/Irisviel_von_Einzbern", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/11", "thumbnail_src": "https://si.imgix.net/d55245a6/uploads/origins/a0c74b5c-e6c2-4fe7-8f0c-687b30887e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7578f4fed6f1fddd02b3392913814a89", "thumbnail_srcset": "https://si.imgix.net/d55245a6/uploads/origins/a0c74b5c-e6c2-4fe7-8f0c-687b30887e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7578f4fed6f1fddd02b3392913814a89, https://si.imgix.net/d55245a6/uploads/origins/a0c74b5c-e6c2-4fe7-8f0c-687b30887e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cfaff6794a65d768fda5d979822170e 2x, https://si.imgix.net/d55245a6/uploads/origins/a0c74b5c-e6c2-4fe7-8f0c-687b30887e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddd6524987b24106e291db14dba539b2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/10", "thumbnail_src": "https://si.imgix.net/f8718267/uploads/origins/df022847-8eed-4874-9bd9-0a79dd9030f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc2aed6299687c6aa91d3c3aec6f965", "thumbnail_srcset": "https://si.imgix.net/f8718267/uploads/origins/df022847-8eed-4874-9bd9-0a79dd9030f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc2aed6299687c6aa91d3c3aec6f965, https://si.imgix.net/f8718267/uploads/origins/df022847-8eed-4874-9bd9-0a79dd9030f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b224bcd222aa148fb48cc25f24f315f 2x, https://si.imgix.net/f8718267/uploads/origins/df022847-8eed-4874-9bd9-0a79dd9030f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01c7f7818a685f6b28935c82a8a6dac4 3x", "genre": "art", "nsfw": true, "body": "こんにちは、お元気でしょうか。ペルソナ3に登場する西脇裕子（ゲーム内での姿：https://ibb.co/vv8nYJy、似顔絵：https://ibb.co/MCnyN7t）の夏服姿のイラストをお願いしたいのですが、足が汗で蒸れ、臭いと文句を言っています（これに近いポーズ：https://www.pixiv.net/en/artworks/111592986）。\n\nさらに、彼女が慌てふためき、恥ずかしがりながら、その匂いと光景を楽しんでいる視聴者を叱責してほしい。靴下を履いているものと履いていないもののバリエーションがあってもいいし、履き古したローファーが全ページに存在してもいい。性格的には、少し熱血漢だが、実はとても親切で慈悲深い。\n\nもうひとつ、もし可能なら、彼女の足の裏を他の肌より明るい色合いにしてほしい（https://www.pixiv.net/en/artworks/114094487 の女の子のように）。\n\nもちろん、ページ数や詳細はあなた次第です。\n\nごゆっくりどうぞ。", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/9", "thumbnail_src": "https://si.imgix.net/fbe295e2/uploads/origins/ed92b536-081a-4f0e-bd5c-00b924344b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c75ed34d11d5446329e47da2a3336df4", "thumbnail_srcset": "https://si.imgix.net/fbe295e2/uploads/origins/ed92b536-081a-4f0e-bd5c-00b924344b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c75ed34d11d5446329e47da2a3336df4, https://si.imgix.net/fbe295e2/uploads/origins/ed92b536-081a-4f0e-bd5c-00b924344b52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cac109948a461ca67abdbd510d3eb9c 2x, https://si.imgix.net/fbe295e2/uploads/origins/ed92b536-081a-4f0e-bd5c-00b924344b52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb2e7a644f9156ae50bb3e8e3e700b06 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/8", "thumbnail_src": "https://si.imgix.net/a907ed53/uploads/origins/506aeae2-1573-4de8-8aad-fb463e135de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202048640dfa2a7b4d59dd8f826d1cd2", "thumbnail_srcset": "https://si.imgix.net/a907ed53/uploads/origins/506aeae2-1573-4de8-8aad-fb463e135de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202048640dfa2a7b4d59dd8f826d1cd2, https://si.imgix.net/a907ed53/uploads/origins/506aeae2-1573-4de8-8aad-fb463e135de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f96f4dab58aa58b0ed159b3854fc747 2x, https://si.imgix.net/a907ed53/uploads/origins/506aeae2-1573-4de8-8aad-fb463e135de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8915e3a06eac38ce704ca2333c81e541 3x", "genre": "art", "nsfw": true, "body": "はじめまして！縮んだ南ことり（ラブライブ！）が高坂穂乃果（ラブライブ！）に踏まれるシーンを漫画やイラストで表現してみませんか？が高坂穂乃果（ラブライブ！）に踏まれるシーンをマンガやイラストで表現してみませんか？\n\n南ことりはとても小さくなり、体長は3～5cmほどしかない。このような服を着ている（https://card.niconi.co.ni/card/v4/1512.png）。面倒なら制服を着せてもいい。ほのかは制服に黒い靴下。\n\n縮んだことりは穂乃果の靴のかかと付近に入り込んだ。穂乃果が靴を履くと、かかとが完全にことりの体を覆った。\n\nことりの体は小さく柔らかかったので、穂乃果は足元の異物感を無視した。歩いたり、走ったり、ジャンプしたり。ことりは常に穂乃果のかかとに踏まれていた。\n\n縮んだ後のことりは耐圧性に優れているので、怪我をすることはない。しかし、穂乃果の巨大な体重は彼女に大きな苦痛を与えた。\n\nストーリー、詳細、ページ数など、すべて自由です。\n\nありがとうございました", "created_at": "", "completed_at": ""}, {"path": "/@ddrysuper/works/7", "thumbnail_src": "https://si.imgix.net/e4d97246/uploads/origins/70a00ad6-8f0d-44ce-81ac-56a592e9382e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c16d3dc5bf6b32bd52f93a2ad5bf489", "thumbnail_srcset": 