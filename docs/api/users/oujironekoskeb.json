7ef3563682fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80472d5c29447376b1bec8a404552742 2x, https://si.imgix.net/5340dfed/uploads/origins/75e8e5b0-7ce7-4435-9aee-7ef3563682fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03d8ff21d9979da28d4b5a6e16dd8db3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きです！私のキャラを描いてくれたら嬉しいです！💜よろしくお願いします\n\nhttps://photos.app.goo.gl/QjR7uT2g92z7LPRx9", "created_at": "", "completed_at": ""}, {"path": "/@oujironekoskeb/works/34", "thumbnail_src": "https://si.imgix.net/b6614e7c/uploads/origins/46ea62e6-f7c7-4a88-bf88-23d04135592a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697d78e65920ad068e868fb4742572b4", "thumbnail_srcset": "https://si.imgix.net/b6614e7c/uploads/origins/46ea62e6-f7c7-4a88-bf88-23d04135592a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697d78e65920ad068e868fb4742572b4, https://si.imgix.net/b6614e7c/uploads/origins/46ea62e6-f7c7-4a88-bf88-23d04135592a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f123ea99dc8b466d00b4e0a1da92b76 2x, https://si.imgix.net/b6614e7c/uploads/origins/46ea62e6-f7c7-4a88-bf88-23d04135592a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc56b10bef2c6de02d5f03ec071dc795 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵に出会って、とてもかわいいです！私の鯉も描いてください！\n\n表情やポーズはお任せします！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1pmr-S4Wm0FdQ9mdg1vwbsL1W77QNqGdn", "created_at": "", "completed_at": ""}, {"path": "/@oujironekoskeb/works/33", "thumbnail_src": "https://si.imgix.net/decfc2ba/uploads/origins/2425df89-a5b7-42da-9ced-e8d736e9cfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb679c59d49fa713b6496ecb5ba7bf2", "thumbnail_srcset": "https://si.imgix.net/decfc2ba/uploads/origins/2425df89-a5b7-42da-9ced-e8d736e9cfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb679c59d49fa713b6496ecb5ba7bf2, https://si.imgix.net/decfc2ba/uploads/origins/2425df89-a5b7-42da-9ced-e8d736e9cfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9007a7d99f724b3ddd7c362d73a2045e 2x, https://si.imgix.net/decfc2ba/uploads/origins/2425df89-a5b7-42da-9ced-e8d736e9cfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a715d30cf6a5c70a3091665ec88f4c4 3x", "genre": "art", "nsfw": false, "body": "尨犬すみかと申します。\n\n▼依頼内容\n私と友人の犬化をお願いしたいです。\n犬種はおまかせいたしますがもふもふしていると嬉しいです。\n細かい箇所は省略していただいたり、資料と差があっても問題ございません。\n2体分になりますので倍で申請しております。\n\n▼使用用途\n・SNSや配信での使用、印刷、グッズ制作を行う場合がございます。\nVライバー活動の中での範疇を超えた利用はいたしません。\n\n▼納品形式\n可能でしたらpsd形式またはpngにてご納品いただけますと幸いです。\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1CqFqAoBZaSGOVunoh09q0-LF0QZ1xMWp/view", "created_at": "", "completed_at": ""}, {"path": "/@oujironekoskeb/works/32", "thumbnail_src": "https://si.imgix.net/75b2a72c/uploads/origins/0f9a5dc0-e48f-463c-bdb8-9bf5eb07a87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93d8460c4bc7d1299de63ec81a5626a7", "thumbnail_srcset": "https://si.imgix.net/75b2a72c/uploads/origins/0f9a5dc0-e48f-463c-bdb8-9bf5eb07a87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93d8460c4bc7d1299de63ec81a5626a7, https://si.imgix.net/75b2a72c/uploads/origins/0f9a5dc0-e48f-463c-bdb8-9bf5eb07a87e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c78acd0aa05d1357d3a42d99b2cefc9d 2x, https://si.imgix.net/75b2a72c/uploads/origins/0f9a5dc0-e48f-463c-bdb8-9bf5eb07a87e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44fec0cfecf7c0b4d03dea3921d02fcd 3x", "genre": "art", "nsfw": false, "body": "先日は素晴らしいイラストをありがとうございます\nまたVtuberの方のFAを描いて頂けますでしょうか？\n詳細は以下に記します\n\n名前\nツナ缶\n【X】https://x.com/tunacan2525\n【youtube】https://www.youtube.com/@tunacan_2525\n【立ち絵など】https://x.com/tunacan2525/status/1583851918841241601/photo/1\n\nその他\n大型犬にしてくれると嬉しいです\n長毛の垂れ耳で、おっきくて優しい雰囲気にして頂きたいです\n以前に描いて頂いたフジさんと一緒に配信活動をしている方なので、二人を並べて見せることが主になるかと思います\n背景についての指定はありません\n背景を透過した物も頂ければ幸いです\n\nYoutubeで配信活動を行っている方のため、SNSや配信で画像を使用する可能性があります", "created_at": "", "completed_at": ""}, {"path": "/@oujironekoskeb/works/31", "thumbnail_src": "https://si.imgix.net/59fede77/uploads/origins/ee5b17fa-8e58-4f75-af70-fd1c99ef6f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a359c7c2da97d2e4686cb8b47e7130b", "thumbnail_srcset": "https://si.imgix.net/59fede77/uploads/origins/ee5b17fa-8e58-4f75-af70-fd1c99ef6f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a359c7c2da97d2e4686cb8b47e7130b, https://si.imgix.net/59fede77/uploads/origins/ee5b17fa-8e58-4f75-af70-fd1c99ef6f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c7f4c5a815cd57a5e1a718194151cba 2x, https://si.imgix.net/59fede77/uploads/origins/ee5b17fa-8e58-4f75-af70-fd1c99ef6f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=687936790521f4955ca2ad32c22bddbb 3x", "genre": "art", "nsfw": false, "body": "はじめまして。ゲーム制作をしている者です。\nおうじろー様の描かれる可愛い動物キャラに心惹かれ、依頼させて頂きました…！\n\n自作18禁(15禁版有)ゲーム「女攻めの国のアリス」のファンアートをお願い出来ますでしょうか。\n\n【使用可能性のある用途】\n・個人利用（壁紙・非商用のグッズ化等）\n・SNSアイコン・ヘッダー（依頼者本人の利用）\n・SNS告知（イラストを貼ったゲーム宣伝ポストの投稿）\n\n【ご依頼内容】　\n・参考イラストのバニー男性を『うさぎ化』したミニキャラクター\n┗見た目は青年ですが、幼い子供のような口調の、可愛く純粋な人物です。\n\n髪型・服装：うさぎ化するにあたり、デフォルメやアレンジをして頂いて構いません。\n表情：両目閉じ以外で、頬が赤く染まっている、可愛い印象だと嬉しいです。\n構図：正面向きではなく、ちょこんとした印象で少々上目遣いになるよう、\nおうじろーさぶ様の受けたリクエスト末尾「works/27」のような構図だと嬉しいです。\n納品物：背景透過のレイヤーも頂けると助かります。\nAI生成ツール：使用無希望です。\n\n▼参考イラスト２点▼\nhttps://x.com/zakurorain/status/1813232296180523156\nhttps://x.com/zakurorain/status/1824790608357347654\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oujironekoskeb/works/30", "thumbnail_src": "https://si.imgix.net/098c28d8/uploads/origins/c4cdc114-64f2-422c-9ff5-b2f13da262ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr