め、サディスティックで残酷なことを理解せずにやってしまうこともある。カブトムシをこよなく愛している（カブトムシはみんなおいしい。）\n\n大人っぽく描かれても、幼く描かれてもいい。\n\n参考：https://drive.google.com/drive/folders/1O08iiu5T5NMvnwD0tE262lJqEXd-mnRh?usp=sharing\n\nSNSで使いたい！\n\nhttps://drive.google.com/drive/folders/1O08iiu5T5NMvnwD0tE262lJqEXd-mnRh?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@wakame_dashi/works/45", "thumbnail_src": "https://si.imgix.net/2b5c74fc/uploads/origins/9782f0df-7d2e-472c-9fbf-848f5aa00e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49e057d2c46f2309fca6d4471a385f83", "thumbnail_srcset": "https://si.imgix.net/2b5c74fc/uploads/origins/9782f0df-7d2e-472c-9fbf-848f5aa00e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49e057d2c46f2309fca6d4471a385f83, https://si.imgix.net/2b5c74fc/uploads/origins/9782f0df-7d2e-472c-9fbf-848f5aa00e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81af022fbc2927ec84882f40dea00b59 2x, https://si.imgix.net/2b5c74fc/uploads/origins/9782f0df-7d2e-472c-9fbf-848f5aa00e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7201951ca1cc9591afaab06d5119380c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wakame_dashi/works/44", "thumbnail_src": "https://si.imgix.net/c5623f86/uploads/origins/c955056b-a170-42ff-a2ae-f43efff1a3da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45ba751d032d8b8796c5fd829930e0a0", "thumbnail_srcset": "https://si.imgix.net/c5623f86/uploads/origins/c955056b-a170-42ff-a2ae-f43efff1a3da?bg=%23fff&auto=for