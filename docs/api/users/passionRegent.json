op=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e78165999e003eee17d11c7d17a98e3", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@passionRegent/works/88", "thumbnail_src": "https://si.imgix.net/74fa6f9a/uploads/origins/5b974124-75e3-4b46-81d1-79a1a3ffcd9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b22cd56f1457dc6480d78ae26a7cf80", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@passionRegent/works/87", "thumbnail_src": "https://si.imgix.net/9993c88d/uploads/origins/be4c7cb5-6dfa-4f0a-bf70-5cf28715c613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cb5b3e0fb1efeaf0b20e01fa6cf50b3", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "ブラジリアンミクのイラストをお願いします：\nhttps://drive.google.com/drive/folders/1Trhmk5bo128X9acEmuNxbPsRXz-JjSOj\n\n- 足のポーズはこんな感じです：\nhttps://drive.google.com/file/d/1QePL80-kw24blS2vg81j2p6dfglF2GBz/view?usp=drivesdk\n\n- 臭いと汗のバリエーション。\n\n- 彼女のビーチサンダルはサイドにあり、インソールは黒っぽい。\n\n- 彼女の両足がフレームに入るように。\n\n- 靴底とシワにディテールを入れてください！", "created_at": "", "completed_at": ""}, {"path": "/@passionRegent/works/86", "thumbnail_src": "https://si.imgix.net/06956625/uploads/origins/89da64ff-98a1-41f3-9d7d-40405cd0ffc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21f4c2d0ccc5c2db46f675a38b63e84c", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@passionRegent/works/85", "thumbnail_src": "https://si.imgix.net/0041f53e/uploads/origins/65663245-f427-4db5-86b1-d0d2ce51c826?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d5fa7682357eae5b0e5dbfe51d9a387", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@passionRegent/works/84", "thumbnail_src": "https://si.imgix.net/c4c2ed96/uploads/origins/7e8262d5-6d31-4012-a17d-4054d1768e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e612430aeeb7e6f407d56db5993caf0", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@passionRegent/works/83", "thumbnail_src": "https://si.imgix.net/c8a89e29/uploads/origins/e8ca37bf-1b5a-4b5b-ab03-e7b951def64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ac974a16539246f38bac0ee2527c95d", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "ブルーアーカイヴ（https://drive.google.com/file/d/1kTIZ1vypXZ3CFALTnP104LVohNBc8S7N/view?usp=drivesdk）の角舘かれんさんの足の裏をテーブルの上に出しているイラストをお願いしたいです。彼女の足は裸足で、ハイヒールを同じ位置に置いてこのようなポーズ（https://drive.google.com/file/d/1jOp57FSkNnmfebJbSC4HcFhMMraQHfYc/view?usp=drivesdk）にしてほしい。参考画像のようにハイヒールがつま先からぶら下がっているものと、ハイヒールがつま先からぶら下がっていないもので、彼女が両足のつま先を丸めて、足の裏にしわが寄っているものが欲しい。ハイヒールのインソールはかなりすり減っていて、黒っぽい。彼女の黒い肌とは対照的に、靴底を青白くしてください。\n\n彼女の表情や仕草はあなた次第です。\n\n最後に、イラストの遠近感をこのような感じにしてみてください（https://drive.google.com/file/d/1jR0ceAxCknnBzgswiWomUZTIYQ3yx-b2/view?usp=drivesdk）。\n\nありがとうございました。", "created_at": "", "completed_at": ""}]}