8e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98fb09f2645baf260b82b09c460c7824, https://si.imgix.net/4085431e/uploads/origins/279f7fe0-2e94-4c5b-a503-6fae069b78e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82ab2c846bdeebc57f2361a87dacf44b 2x, https://si.imgix.net/4085431e/uploads/origins/279f7fe0-2e94-4c5b-a503-6fae069b78e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5694b5c3a87104e0f058b0ea92006f5 3x", "genre": "art", "nsfw": true, "body": "瀕死ミヅキちゃんイラストの続きみたいな感じで、レイプされそうになっている可哀想なミヅキちゃんをお願いしたいです。\n・内臓と欠損は無し\n・服は半脱ぎ状態\n・流血は元のイラストくらいで\n・涙目で必死に嫌がっている\nのような感じで描いてくださると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Marinekomina/works/33", "thumbnail_src": "https://si.imgix.net/16f4c70c/uploads/origins/7654d234-5340-42f8-b6fb-d1640ac9b15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfa77d6855e0e4f1234935e607e9e456", "thumbnail_srcset": "https://si.imgix.net/16f4c70c/uploads/origins/7654d234-5340-42f8-b6fb-d1640ac9b15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfa77d6855e0e4f1234935e607e9e456, https://si.imgix.net/16f4c70c/uploads/origins/7654d234-5340-42f8-b6fb-d1640ac9b15e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdb7eb83d596f262690d49e22cb0700f 2x, https://si.imgix.net/16f4c70c/uploads/origins/7654d234-5340-42f8-b6fb-d1640ac9b15e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa006a777e9aefd4ee35aa1199b2554f 3x", "genre": "art", "nsfw": true, "body": "はじめまして、シンフォギアの立花響が銃殺刑の死刑执行を漫画形式でお願いできませんでしょうか。\nhttps://www.symphogear-g.com/character/ch01.php\n服装は公式HPのキャラクター紹介のままで。\n\n下記のような要素を可能な範囲で入れていただきたいです。\n○無慈悲に刑場へ連行される、手首で縛られています。手首の縄は、首の縄とつながっていて、それを引っ張られる形でお願いします。\n○処刑台の上で必死にもがくが抵抗虚しくギチギチに縛られていく場面。（腕を刑場の柱の背もたれの後ろで組まされ、縄で縛られています。）\n○布で目隠しをした瞬間る絵コンテ、表情は涙を流し恐怖している表情であれば有難いです。\n○緊縛、目隠しをされています、銃口が彼女に向けられる。\n○死の恐怖に怯えて泣いている、震えている様子、全身/半身が見えるカットがあると最高ですが。\n\n\nという感じでお願いします。\nやりにくい所有れば変更していただいて大丈夫です、ご検討よろしくお願いします。\n\n【希望】\nもし余裕があれば、背景や絵コンテの中で他の一緒に処刑されるに奏者を描いて頂けないでしょうか。\n番号の優先順から、可能であれば三人いると嬉しいです、不可能な場合は下位の番号から省略願います。\n①小日向未来\nhttps://www.symphogear-g.com/character/ch04.php\n②風鳴翼\nhttps://www.symphogear-g.com/character/ch02.php\n③雪音クリス（ディアン音楽院制服（冬））\nhttps://www.symphogear-g.com/character/ch03.php\n以上、無くて大丈夫です。\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Marinekomina/works/32", "thumbnail_src": "https://si.imgix.net/a43358f4/uploads/origins/dc3a8340-638f-4011-bfa0-63ef46a43ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b635a4d3abf4301225ef184f582959a", "thumbnail_srcset": "https://si.imgix.net/a43358f4/uploads/origins/dc3a8340-638f-4011-bfa0-63ef46a43ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b635a4d3abf4301225ef184f582959a, https://si.imgix.net/a43358f4/uploads/origins/dc3a8340-638f-4011-bfa0-63ef46a43ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61189b526fec12398e5e71a78eb83c83 2x, https://si.imgix.net/a43358f4/uploads/origins/dc3a8340-638f-4011-bfa0-63ef46a43ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65f36d32a31f74cb32a79e5051cd3387 3x", "genre": "art", "nsfw": true, "body": "ポケモンレジェンズの女主人公、ショウちゃんが涙目で震えながら絶望しているイラストをお願いします。\n服はボロボロで、破れたタイツから太ももが見えちゃってると嬉しいです。\n内臓や欠損は無しで、流血はURL先のまりんさんのイラストぐらいの程度でお願いします。\n\nhttps://twitter.com/RuIna_Ne_537/status/1445426049102217223?t=I6AZ5jyYm7QNZ9zAJxijaw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Marinekomina/works/31", "thumbnail_src": "https://si.imgix.net/b2c39d86/uploads/origins/bcd17a54-483a-4e3a-871e-ffd89624d196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c4d572cb49d80134f9fec6e1570f442", "thumbnail_srcset": "https://si.imgix.net/b2c39d86/uploads/origins/bcd17a54-483a-4e3a-871e-ffd89624d196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w