7c6bb704d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25e46709a77a212039eefcb9adaf19b2 2x, https://si.imgix.net/4b2a63bb/uploads/origins/fe5744d4-b6ea-43a8-bd43-97c6bb704d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ce6e09463847caa95cd85b911ad6295 3x", "genre": "art", "nsfw": false, "body": "パソコンの壁紙に設定できるようなイラストをちあちゃんに描いてもらいたいです！\n1920*1080のフルHDのサイズでお願いしたいです。\n\n普段の仕事にも使うパソコンに設定したいと思ってます。\nオンライン会議中に画面が映ることがあるので、ちあちゃんのイラストがドカーンと大きくというよりも、ピンポイントで入ってるような感じだと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@tiatiach/works/6", "thumbnail_src": "https://si.imgix.net/0de82bfc/uploads/origins/dd686d03-8be3-41ae-807b-71ad8b23a444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc96eb6e8e487cabbd7f96053330d43c", "thumbnail_srcset": "https://si.imgix.net/0de82bfc/uploads/origins/dd686d03-8be3-41ae-807b-71ad8b23a444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc96eb6e8e487cabbd7f96053330d43c, https://si.imgix.net/0de82bfc/uploads/origins/dd686d03-8be3-41ae-807b-71ad8b23a444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06c76c62e9e84aefccceac174c71e88f 2x, https://si.imgix.net/0de82bfc/uploads/origins/dd686d03-8be3-41ae-807b-71ad8b23a444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebe3e9c27295ceb39f12f4e9bc42c53d 3x", "genre": "art", "nsfw": false, "body": "ちあちゃんが思うがままに描いたちあちゃんが見たいです！", "created_at": "", "completed_at": ""}, {"path": "/@tiatiach/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c2fddb2b922c5f12a0f874c7a31534", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c2fddb2b922c5f12a0f874c7a31534, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1043d85edf43e41c633e99d534d604c3 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=100f4a6a6c5e68c11d4730331f998efd 3x", "genre": "voice", "nsfw": false, "body": "プロ社畜としての生活を毎日送っています\nあまりにも仕事が終わらないので3年以上、会社に寝袋持参で泊まり込む修行僧みたいな生活をしているんですが、流石に体力も追いつかずにクタクタになることも多くなってきたので、応援したり慰めてください\n\n目覚ましのおかげでﾃﾞｭﾌﾌｗｗｗって笑いながら起きれるようになりました、ありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@tiatiach/works/4", "thumbnail_src": "https://si.imgix.net/b011cc93/uploads/origins/df0566b2-460a-4c3c-bd82-ff437d269b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa4f23f62e1144c78193f9a9e0ecb76b", "thumbnail_srcset": "https://si.imgix.net/b011cc93/uploads/origins/df0566b2-460a-4c3c-bd82-ff437d269b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa4f23f62e1144c78193f9a9e0ecb76b, https://si.imgix.net/b011cc93/uploads/origins/df0566b2-460a-4c3c-bd82-ff437d269b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d46971459492a84e5424a2353f45474a 2x, https://si.imgix.net/b011cc93/uploads/origins/df0566b2-460a-4c3c-bd82-ff437d269b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52b7400994e3c01d311e32b27a165bdf 3x", "genre": "art", "nsfw": false, "body": "twitterのヘッダーに使用するイラストをお願いしたいです。\n大きさは1500*500px対応、pngでの納品を希望です。\nちあちゃんが元気なポーズをしているバックに、ちあちあちゃんねるのアイテム(おへぱんやステッキなど)のアイコンがカラフルに散らばっているイメージです。\ntwitterのヘッダーだと左側は自アイコンが映るので真ん中か右側にちあちゃんの顔が来るレイアウトだと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@tiatiach/works/3", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c2fddb2b922c5f12a0f874c7a31534", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c2fddb2b922c5f12a0f874c7a31534, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1043d85edf43e41c633e99d534d604c3 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=100f4a6a6c5e68c11d4730331f998efd 3x", "genre": "voice", "nsfw": false, "body": "ちあちゃん初めまして、塚本穴骨と申します。\nちあちゃんの元気な声が大好きです。\n最近元気がなく、どうかちあちゃんの声で応援をしてほしいです。\n私は絵を描く仕事をしています。調子が悪いとき絵がなかなか進まないときに、ちあちゃんの声を聴いて\n元気を出したいです。\nどうかちあちゃんの元気な声で、「頑張れ！」と応援してほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@tiatiach/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c2fddb2b922c5f12a0f874c7a31534", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c2fddb2b922c5f12a0f874c7a31534, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1043d85edf43e41c633e99d534d604c3 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1599044446125199361%2FHC35yqP3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fi