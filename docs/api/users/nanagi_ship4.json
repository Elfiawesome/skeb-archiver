ns/60128bfa-2bf3-485e-9187-cad75649739f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26f04852f6755a15a6f395ddeabb6a29, https://si.imgix.net/429deb38/uploads/origins/60128bfa-2bf3-485e-9187-cad75649739f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fa4a84485c4bf2b9735548592d1af9a 2x, https://si.imgix.net/429deb38/uploads/origins/60128bfa-2bf3-485e-9187-cad75649739f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b95821511f9f6e3681e6b7af44328b75 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nanagi_ship4/works/186", "thumbnail_src": "https://si.imgix.net/5a158ed9/uploads/origins/768b33bb-a143-4a10-98fa-217b8e19f93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4520309ede15f7ef1bc9eac2743a3b5", "thumbnail_srcset": "https://si.imgix.net/5a158ed9/uploads/origins/768b33bb-a143-4a10-98fa-217b8e19f93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4520309ede15f7ef1bc9eac2743a3b5, https://si.imgix.net/5a158ed9/uploads/origins/768b33bb-a143-4a10-98fa-217b8e19f93d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cbd15d0b2d3b00ea61fc31976d20b92 2x, https://si.imgix.net/5a158ed9/uploads/origins/768b33bb-a143-4a10-98fa-217b8e19f93d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19fc3bbc535c6c68433224dc593d1c01 3x", "genre": "comic", "nsfw": true, "body": "先生はじめまして、以下の様なリクなのですがよろしいでしょうか？\n概要\n闇のデュエルで追い詰められた闇デュエリスト男が、対戦相手の少女と自分を対象にカード効果使い身体入れ替えて(強制転移等描写はお任せ)、形勢逆転させて勝利して少女の身体をそのまま奪う\n\nキャラ\n男:口調容姿お任せ\n\n少女:口調容姿お任せ(長髪だと良い)\n\nページ数やカラーモノクロかはお任せします。大まかな流れあってれば内容等やりやすい様に変更可能です\n\n要望\n・入れ替わった後男身体になった少女に、手に入れた少女身体を見せつける様にいやらしく触る描写有ると良い(やめて的な事言う少女に、トドメさして勝利する様な)\n・余裕有れば勝利後に身体弄り軽くイッた後に戻ってさらに楽しもうとする様な描写で終わると良い", "created_at": "", "completed_at": ""}, {"path": "/@nanagi_ship4/works/185", "thumbnail_src": "https://si.imgix.net/1293248a/uploads/origins/81dc951b-6ff4-49b1-a51d-5e4070aa5eff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b72a7a9e772bfff0bcf2cf11ee573dff", "thumbnail_srcset": "https://si.imgix.net/1293248a/uploads/origins/81dc951b-6ff4-49b1-a51d-5e4070aa5eff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b72a7a9e772bfff0bcf2cf11ee573dff, https://si.imgix.net/1293248a/uploads/origins/81dc951b-6ff4-49b1-a51d-5e4070aa5eff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13440faee6ecbd33b36c135c93257020 2x, https://si.imgix.net/1293248a/uploads/origins/81dc951b-6ff4-49b1-a51d-5e4070aa5eff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a03875c9acf877f264637a9a8ea11102 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nanagi_ship4/works/184", "thumbnail_src": "https://si.imgix.net/c3e81868/uploads/origins/f3945c45-56dd-434d-9b34-b22246e1e77d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0f020557ece0df3aa274e72baf5ae47", "thumbnail_srcset": "https://si.imgix.net/c3e81868/uploads/origins/f3945c45-56dd-434d-9b34-b22246e1e77d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0f020557ece0df3aa274e72baf5ae47, https://si.imgix.net/c3e81868/uploads/origins/f3945c45-56dd-434d-9b34-b22246e1e77d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c79f19583e6e7d1a723585883f65536 2x, https://si.imgix.net/c3e81868/uploads/origins/f3945c45-56dd-434d-9b34-b22246e1e77d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed4d27a8f7ee944a9ed55f70fad5771c 3x", "genre": "art", "nsfw": true, "body": "また玉砕アートワークをお願いしたい。今回は「Wuthering Waves」のフィービーが主人公だ：\nhttps://www.pixiv.net/en/artworks/126620526\nhttps://www.pixiv.net/en/artworks/126075782\n\nこの参考資料のようなシナリオを描いてください：\nhttps://www.pixiv.net/en/artworks/118734028\nフィービーは男性の股間に頭を近づけて横たわる。フィービーは片方の手で男性のペニスをつかみ、同時に男性の睾丸に噛みつく。フィービーは睾丸を噛んだり引っ張ったりしてください。両方のキャラクターをヌードで描いてください。男性は性器が大きく、痛がっているはずです。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@nanagi_ship4/works/183", "thumbnail_src": "https://si.imgix.net/cbd3b1f6/uploads/origins/e0e722e4-a372-4f91-aa51-926e7eddbce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91f78914ce4499668c0d3ca8ba48b835", "thumbnail_srcset": "https://si.imgix.net/cbd3b1f6/uploads/origins/e0e722e4-a372-4f91-aa51-926e7eddbce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91f78914ce4499668c0d3ca8ba48b835, https://si.imgix.net/cbd3b1f6/uploads/origins/e0e722e4-a372-4f91-aa51-926e7eddbce4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=120461a1862cbb7295cefcbcc730e728 2x, https://si.imgix.net/cbd3b1f6/uploads/origins/e0e722e4-a372-4f91-aa51-926e7eddbce4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a3ea8f739