97b7ab66, https://si.imgix.net/e923bdd9/uploads/origins/ab3c6310-053c-473b-b58b-7b54b45a88de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f1b0f0c01449d1db50011766d1e532c 2x, https://si.imgix.net/e923bdd9/uploads/origins/ab3c6310-053c-473b-b58b-7b54b45a88de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a615cd3e5fab95d989455f9300ede13 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oxSTL2/works/2", "thumbnail_src": "https://si.imgix.net/0683d5a8/uploads/origins/c1bcfd79-da95-4462-ab34-555fa075a228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fd42ce85ed34c4f54529fac5bdee4d", "thumbnail_srcset": "https://si.imgix.net/0683d5a8/uploads/origins/c1bcfd79-da95-4462-ab34-555fa075a228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fd42ce85ed34c4f54529fac5bdee4d, https://si.imgix.net/0683d5a8/uploads/origins/c1bcfd79-da95-4462-ab34-555fa075a228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9bfa781ecfaab2951edc06d60d0cc19 2x, https://si.imgix.net/0683d5a8/uploads/origins/c1bcfd79-da95-4462-ab34-555fa075a228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=437ed3de46ef065da43156eedd0c9122 3x", "genre": "art", "nsfw": false, "body": "はじめまして。作品を拝見しており、とても素敵だと思っております。\nこのたびミニキャラをお願いしたく、リクエストを送らせていただきました。\n\n▼キャラクター：うちの子\n資料URLをご参照ください。\n通常任務服でお願いします\n\nリクエストをご検討いただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1fB5IdALV479ClRTTIh2X_OOYepOnTXHG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oxSTL2/works/1", "thumbnail_src": "https://si.imgix.net/74b0809b/uploads/origins/85674f0a-d614-4d25-ae74-d86681badd6e?bg=%23fff&fm=webp&auto=compress