ins/2124d5e5-1ffc-4f3f-8c41-928274041c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60e2ece0be6602b5c925b126f5785c90 3x", "genre": "art", "nsfw": false, "body": "鈴かおすさん、こんにちは\n先日は素晴らしい作品をありがとうございました！\n立て続けですみませんが、また同じキャラで2枚、依頼をさせてください\n\n①前回描いていただいた船での作業中の事故で、倒れたorぶつけたかで腰の腕の片方が壊れてしまい（外装が破け、骨組みも壊れている）、傷口を見て驚いている表情\n\n②腰の腕がついている部分（ボディ中央のファンがある部分）の外板をはずし、根元部分の修理をしているシーン\n修理の際二発生する電流（漏電?）で、片目をつぶって軽く顔をしかめている表情（表情はあまり悲壮感がないようお願いします！）\n\nご検討、よろしくお願いしますmm", "created_at": "", "completed_at": ""}, {"path": "/@suzunomachi/works/37", "thumbnail_src": "https://si.imgix.net/8d998ef3/uploads/origins/160fa90f-23af-4833-abfc-787fa4df3af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60eea4392e7c3336b1d7b06c516a8b4a", "thumbnail_srcset": "https://si.imgix.net/8d998ef3/uploads/origins/160fa90f-23af-4833-abfc-787fa4df3af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60eea4392e7c3336b1d7b06c516a8b4a, https://si.imgix.net/8d998ef3/uploads/origins/160fa90f-23af-4833-abfc-787fa4df3af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04bb16732a810b728ea36c91dbd3d9e8 2x, https://si.imgix.net/8d998ef3/uploads/origins/160fa90f-23af-4833-abfc-787fa4df3af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0899ade896c2a16caa4b8b4b8a86f43 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suzunomachi/works/36", "thumbnail_src": "https://si.imgix.net/f2b7dbee/uploads/origins/ed12c758-0c7a-4d82-8563-da1ac01435c2?bg=%23fff&auto=format%2Ccom