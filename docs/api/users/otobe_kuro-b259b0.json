f6256ef2ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33072faaf8eb61dc6a1138fc580c55fe 2x, https://si.imgix.net/06595670/uploads/origins/e80ec757-7c48-44f2-8686-26f6256ef2ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=140f07cd9314fdbfe0c83d83c47b21ac 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/84", "thumbnail_src": "https://si.imgix.net/bcd93c6f/uploads/origins/4a2ccf79-c5d1-47ee-91be-b71d71684d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f233c0dea2338fcda09b1b1ee029e100", "thumbnail_srcset": "https://si.imgix.net/bcd93c6f/uploads/origins/4a2ccf79-c5d1-47ee-91be-b71d71684d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f233c0dea2338fcda09b1b1ee029e100, https://si.imgix.net/bcd93c6f/uploads/origins/4a2ccf79-c5d1-47ee-91be-b71d71684d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=232736ee4aa1744cc70b7f094681c4a1 2x, https://si.imgix.net/bcd93c6f/uploads/origins/4a2ccf79-c5d1-47ee-91be-b71d71684d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2ec7cff3b77ca16f9daece69f294ab3 3x", "genre": "novel", "nsfw": false, "body": "こんにちは。\nSkebの進捗でねぶくろさんの文章を拝見し、読みやすくかつ美しい描写や、心情の掬い取り方に感動させていただきました。もしよければ友人とのＴＲＰＧのキャラクターを執筆していただけないかと思い、リクエストを失礼いたします。\n\nTRPGのCoCシナリオ「ロトカ・ヴォルテラの愛堕討ち」の二人になります。\n以下シナリオ概要以上のバレはございません。\n\n（インナーカラーが）赤髪の極道者の男性（攻め）と、青髪の落語家の男性（受け）です。\n赤髪は目を引く伊達男で大型の猫、青髪は中性的で精緻な美人でよく吠える子犬みたいな感じです。\n二人は元々高校の同級生です。\n赤髪は高校在学中に母親が亡くなり、父親の借金を返すために、卒業式に参加せず極道に入りました。\n卒業式後の夜に赤髪が忘れ物を取りに教室に行った時に、赤髪がくるのを待っていた青髪と話をした思い出があります。\n\n今はお互い相手が嫌そうだったり悔しそうな顔をすると嬉しくなります。全体的に青髪の方が劣勢でよく吠えています。仲は悪いですが、一緒に食事をしたり、相手の家にお泊りをしたり、困ったら助け合ったりします。赤髪のおごりで青髪が甘いものを食べたり、青髪が不器用ながら勝手に料理を作って赤髪に押し付けたりなどします。\n肉体関係もありますが、赤髪は二人の関係が恋愛関係になるのがつまらないと考えており、\n青髪は相手を好きすぎるあまり、自分は相手を嫌いだと思い込んでいるため付き合ってはいません。\n恋愛感情というよりも、執着とか、他の人に渡したくないという独占欲が強いです。\nお互い第三者にモテます。赤髪は相手をしたりしますが、青髪は全部断ります。\n\n関係性の詳細は資料の中に入れております。\n参考用に会話例も失礼します。\n\n例1）出会った時\n青「あれ、嵩良くんじゃん。何か空気が悪いと思った。こんなところでどうしたの？目について仕方ないんだけど」\n赤「どうも。落語家様は随分、俺がお気に入りのようで」\n青「はあ？誰もそんなふうに言ってないでしょ。いい方に捉えないでくれる？不愉快なんだけど」\n赤「あーはいはい」\n青「適当に返事してるでしょ！この俺が話しかけてあげてるんだからさぁ、有難く聞いてよ！」扇子で叩く\n\n例2）二人で歩いている時\n赤「…」ぶつかりそうだったので無言で自分側に引き寄せる\n青「！？な、何？」\n赤「もう少し回り見て歩きな」\n青「なにが！？近い、離れて、煙草くさい、香水くさい、最悪、嫌い」\n赤「その口どうにかなんないかねぇ」すぐに離す\n\n例3）何かを教えてもらう時①\n青「なにそれ、どういうこと？」\n赤「人にものを頼むならもっと言い方ないの？」\n青「…」\n赤「よろしくお願いしますは？」\n青「…」そっぽを向く\n赤「どうしてそうなんかねぇ」\n青「うるさい。いいからとっとと言えよ」\n\n例4）何かを教えてもらう時②\n赤「何かわかったの？」\n青「わかったけど、知りたい？ちゃんとお願いするなら教えてあげてもいいよ」\n赤「あーはいはい…どうかこの俺に教えてくださいますか？天下の落語家様」\n青「ふん…しょうがないなあ」得意げ\n赤「…」まじかよ。適当に言ったのに、という顔\n\n\n使用用途として、個人観賞用に印刷、SNSに投稿などさせていただければなと思います。\nもしよければご検討ください。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1H3f3MIUI7eSjEf_mILTNzu1fDOB9e7jQ?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/83", "thumbnail_src": "https://si.imgix.net/cd2fb3f8/uploads/origins/015941a6-123e-468f-a523-5774e33f0b8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b0f4b3e619e2002a27c05019b14cd40", "thumbnail_srcset": "https://si.imgix.net/cd2fb3f8/uploads/origins/015941a6-123e-468f-a523-5774e33f0b8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b0f4b3e619e2002a27c05019b14cd40, https://si.imgix.net/cd2fb3f8/uploads/origins/015941a6-123e-468f-a523-5774e33f0b8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e78a7e8d3eb7672bdd0d540351cd61b 2x, https://si.imgix.net/cd2fb3f8/uploads/origins/015941a6-123e-468f-a523-5774e33f0b8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3dfc76cba678322f39d726d973936949 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/82", "thumbnail_src": "https://si.imgix.net/d6990d5a/uploads/origins/2f9f8019-ece4-4078-8592-d41fbfbc1240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7b01510ba914f139dabf77a4677283e", "thumbnail_srcset": "https://si.imgix.net/d6990d5a/uploads/origins/2f9f8019-ece4-4078-8592-d41fbfbc1240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7b01510ba914f139dabf77a4677283e, https://si.imgix.net/d6990d5a/uploads/origins/2f9f8019-ece4-4078-8592-d41fbfbc1240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85e2f765c7971c0adbdd910856451885 2x, https://si.imgix.net/d6990d5a/uploads/origins/2f9f8019-ece4-4078-8592-d41fbfbc1240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=840782088217bbfd58b18bba4ee998d5 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/81", "thumbnail_src": "https://si.imgix.net/c2fd0ae8/uploads/origins/04e01677-32d7-4134-af1b-65485e4800a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=002d2738096782c8c3f023e525d01cf7", "thumbnail_srcset": "https://si.imgix.net/c2fd0ae8/uploads/origins/04e01677-32d7-4134-af1b-65485e4800a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=002d2738096782c8c3f023e525d01cf7, https://si.imgix.net/c2fd0ae8/uploads/origins/04e01677-32d7-4134-af1b-65485e4800a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df8fa9ac306c06e7dc80ad375224253f 2x, https://si.imgix.net/c2fd0ae8/uploads/origins/04e01677-32d7-4134-af1b-65485e4800a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cc24dd7d61fe005c1dce4310388020c 3x", "genre": "novel", "nsfw": false, "body": "ねぶくろ様、こんにちは。\n前回は素敵な作品をありがとうございました！実在感を伴って存在する二人を見ることが出来て、何度読み返しても幸せな気持ちになります。\nぜひともまたOCのお話を書いて頂きたいと思い、再び依頼を送らせて頂きました。\nもしもご迷惑であったりご都合に合わない・苦手等ございましたらお気軽にキャンセルなさってください。\n\n【詳細】\n政春・駒鳥\nやくざの若頭とその妻の夫婦関係。\n政春は駒鳥のことを楽しませる・面白がらせることに強く楽しみを感じており、行動原理になっている愛妻家の男性です。基本的に穏やかな態度で他者と接しますが、駒鳥に対してはやや子供っぽく無邪気な面も見せます。\n駒鳥は、そんな政春のことを深く愛しており、自身の価値観の主軸としていると言って差し支えなく、政春を支えることに何よりの喜びを見出している女性です。また、政春と政春を深く取り巻く環境にしか大した興味を持っていない(それ以外には興味がなくやや冷淡、ただし礼節を過度に欠いたりはしない)という極端さを持ちます。\n\n\n上記は解釈の一助として頂ければと思いますが、ねぶくろ様の自由な解釈や描写を優先していただければと思います！\nシチュエーション、誰目線かなど全ておまかせいたしますので、お好きなように書いて頂ければ嬉しいです。\n\n資料に関してですが、数が多いので全てに目を通さずとも必要に応じて参照して頂く形で構いません。\n前回と同じく、広島弁についてもおおよそのニュアンスが合っていれば細かなニュアンスの差異など気になりませんので、どうぞお気軽によろしくお願いいたします。\n\nまた、もしも金額や資料の不備不足、お好みに合わない/苦手等がありましたら、大変お手数ではありますがキャンセルもしくは再送頂けると助かります。\n何卒ご検討をよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1MBSaOyBxXJu0aMi8fnWeLdXTrT4LxzNV", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/80", "thumbnail_src": "https://si.imgix.net/601443ea/uploads/origins/849a3676-9cad-4cb6-825a-9ba554c5ab7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f44c5ce2996eecf61ae002e0fff2bd80", "thumbnail_srcset": "https://si.imgix.net/601443ea/uploads/origins/849a3676-9cad-4cb6-825a-9ba554c5ab7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f44c5ce2996eecf61ae002e0fff2bd80, https://si.imgix.net/601443ea/uploads/origins/849a3676-9cad-4cb6-825a-9ba554c5ab7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a723c506244137c511b034d0bb9af4f8 2x, https://si.imgix.net/601443ea/uploads/origins/849a3676-9cad-4cb6-825a-9ba554c5ab7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1be94a6297a9c49b890620652a39812 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/79", "thumbnail_src": "https://si.imgix.net/2a5548e3/uploads/origins/cee18a78-a6fd-41b8-92d0-a37bd662104d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b11cb3b1963ec28a198af10f9d144e", "thumbnail_srcset": "https://si.imgix.net/2a5548e3/uploads/origins/cee18a78-a6fd-41b8-92d0-a37bd662104d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b11cb3b1963ec28a198af10f9d144e, https://si.imgix.net/2a5548e3/uploads/origins/cee18a78-a6fd-41b8-92d0-a37bd662104d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56cae44981bc3a7738970cbcf5dba390 2x, https://si.imgix.net/2a5548e3/uploads/origins/cee18a78-a6fd-41b8-92d0-a37bd662104d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb389eb764dbad7ce25d19783e97528c 3x", "genre": "novel", "nsfw": false, "body": "お世話になっております！\n今回もねぶくろ様に自創作のお話を書いていただきたくリクエストを送らせていただきました。\nねぶくろ様の文は関係性の奥行きや人間みが強く感じられて好きなので、気に入った関係性やキャラクターをお選びいただけたらと思います。\n\n【リクエスト内容】\n資料外の情報はお好きなように解釈していただいて構いません。\n全員登場させる必要はないです。\n\n【世界観】\n異形の怪物が人類を襲う「モンスター災害」が頻発する世界。この怪物たちは「デミスト」と呼ばれており、各都市は独自の防衛手段を発展させてデミストに対抗している。多様な思想と技術が交錯するこの世界では、都市ごとに異なる方法でデミストに立ち向かっているが、内部での争いも絶えない。\n\n【ストーリー】\n神が出現したことで、その恩恵を得るために各都市はひとつの思想(領土)に統一されるまで互いに争いを始めた。信仰の違いや利害関係が複雑に絡み合い、都市同士の領土争いが激化していく。神の信仰とデミストという脅威が絡み合う中で、都市同士の生存競争が繰り広げられる。\n\n\n【使用用途】\n・個人鑑賞\n・1部シーンをイラストに描き起こし、イラストをSNSに上げる場合があります。\n・作品の内容を設定として取り入れる場合があります。\n\n【その他】\n・形式に指定はありません。\n・創作初心者のため、設定に矛盾や誤りがあるかもしれません。その場合は作品内でご自由に変更していただいて構いません。\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請をお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1sAY1fBcg8vS5ezvi_lRkzR6FxgeB49_V", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/78", "thumbnail_src": "https://si.imgix.net/aac90151/uploads/origins/744315d5-2d33-458c-956c-cf48e922818f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70e31188b372956da0c5086760ae20dd", "thumbnail_srcset": "https://si.imgix.net/aac90151/uploads/origins/744315d5-2d33-458c-956c-cf48e922818f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70e31188b372956da0c5086760ae20dd, https://si.imgix.net/aac90151/uploads/origins/744315d5-2d33-458c-956c-cf48e922818f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee24c85fb6249b0836ac45caf033e0ce 2x, https://si.imgix.net/aac90151/uploads/origins/744315d5-2d33-458c-956c-cf48e922818f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bceb829f3070cdace1573af83b76128 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/77", "thumbnail_src": "https://si.imgix.net/d791bc45/uploads/origins/485fb1cd-e8ac-42e3-bb5c-527589b59e68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc1ba3fabe54b8f9bdbcb407182af154", "thumbnail_srcset": "https://si.imgix.net/d791bc45/uploads/origins/485fb1cd-e8ac-42e3-bb5c-527589b59e68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc1ba3fabe54b8f9bdbcb407182af154, https://si.imgix.net/d791bc45/uploads/origins/485fb1cd-e8ac-42e3-bb5c-527589b59e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b2cc26bee4d088339d0ec98f5a29786 2x, https://si.imgix.net/d791bc45/uploads/origins/485fb1cd-e8ac-42e3-bb5c-527589b59e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5522eaa7d7ed7fd32fcb928bb003ea2e 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/76", "thumbnail_src": "https://si.imgix.net/e86b1f0d/uploads/origins/e8684c21-217d-4076-95ad-78c31f1b47d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df7050300509c1a608195d442d0ba76", "thumbnail_srcset": "https://si.imgix.net/e86b1f0d/uploads/origins/e8684c21-217d-4076-95ad-78c31f1b47d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df7050300509c1a608195d442d0ba76, https://si.imgix.net/e86b1f0d/uploads/origins/e8684c21-217d-4076-95ad-78c31f1b47d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=852c72e13d982220f5b8a8d62fb0c4b6 2x, https://si.imgix.net/e86b1f0d/uploads/origins/e8684c21-217d-4076-95ad-78c31f1b47d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5674f5bc31b626b3858e7c19a1fec6d8 3x", "genre": "novel", "nsfw": false, "body": "ねぶくろ様、初めまして。\nねぶくろ様の書かれる、スっと頭に染み込むような文章とキャラやストーリーの解釈のきちんとしたお話に惹かれて依頼を送らせて頂きました。\n今回お願いしたいのは男女カプOCです。\n\n【詳細】\n夏京(男性)・冬雪(女性)\n世話好きで相手をリードすることの多い寡黙気味な男性と、おっとりした柔らかな物腰の女性の恋人関係です。\n男性は女性の事を深く愛しており、中でも特に自分にだけ見せてくれる表情・態度に対しての愛着やある種の執着を持っています。相手の女性を多少からかう事があるのもその一環です。\n隠していますが内心嫉妬深い一面があり、相手の女性にちょっかいを掛ける人間などに対して静かに威圧しがちです。(無意識的・意識的どちらもあります)\n\n女性は穏やかで包容力のある性質ですが、博愛的ではなく相手の男性や友人らなど自分が信頼し、愛しているものに対して特にそういった性質が出てくるような雰囲気です。\n\n上記は解釈の一助として頂ければ幸いですが、ねぶくろ様の表現したいものなどを優先なさって頂ければ嬉しく思います。\nまた、彼らの話す軽い広島弁について、大まかに合っていれば細かなニュアンスの差異など特に気になりませんので、どうかお気軽にお願いいたします！\n\nもしも金額や資料の不備不足、その他の至らぬ点がございましたらお手数ではありますが、キャンセルか再送をなさって下さると助かります。\n何卒ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/12VWcSTHfIhpijXfAbncWZpEojbZBUbWu", "created_at": "", "completed_at": ""}, {"path": "/@otobe_kuro/works/75", "thumbnail_src": "https://si.imgix.net/5db48996/uploads/origins/f15859c0-fc9c-4740-afcc-d2ccc0a4532f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db9f842b6a16393c627c8785ab294219", "thumbnail_srcset": "https://si.imgix.net/5db48996/uploads/origins/f15859c0-fc9c-4740-afcc-d2ccc0a4532f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db9f842b6a16393c627c8785ab294219, https://si.imgix.net/5db48996/uploads/origins/f15859c0-fc9c-4740-afcc-d2ccc0a4532f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfbbc39c95c9a06384c8688c86b3fe97 2x, https://si.imgix.net/5db48996/uploads/origins/f15859c0-fc9c-4740-afcc-d2ccc0a4532f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7ff040a