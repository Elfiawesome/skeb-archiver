50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eb0f6403e06b38aeffcc358ea80f2e9", "thumbnail_srcset": "https://si.imgix.net/7d196533/uploads/origins/0e9aa113-b801-4d9a-be90-d24b06d0c52c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eb0f6403e06b38aeffcc358ea80f2e9, https://si.imgix.net/7d196533/uploads/origins/0e9aa113-b801-4d9a-be90-d24b06d0c52c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a56f79d301f072258cf5a12baa5eb2 2x, https://si.imgix.net/7d196533/uploads/origins/0e9aa113-b801-4d9a-be90-d24b06d0c52c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c82d603918e325ad6ac74edf88387fe1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/31", "thumbnail_src": "https://si.imgix.net/101906fc/uploads/origins/bcf9132b-7abe-4945-b152-6e048db12d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=801da1c4d7b567b30871205012649303", "thumbnail_srcset": "https://si.imgix.net/101906fc/uploads/origins/bcf9132b-7abe-4945-b152-6e048db12d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=801da1c4d7b567b30871205012649303, https://si.imgix.net/101906fc/uploads/origins/bcf9132b-7abe-4945-b152-6e048db12d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d86c527d915deaeb650870fea328805 2x, https://si.imgix.net/101906fc/uploads/origins/bcf9132b-7abe-4945-b152-6e048db12d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2673b552ecbfc86a2989e7be69466bd2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！先生の絵が大好きです。私のキャラクターをリクエストしたいです！\n\nhttps://drive.google.com/drive/folders/1tk40WCjxUAFSbGv3yM4QaD1lJ83XBbPy?usp=drive_link\n\nふたりとも困難な生い立ちの持ち主。そのせいで、2人はお互いの面倒を見ることになる。\nそのおかげで二人は親密な絆で結ばれ、お互いをとても大切に思っている。\n\n---\n\n舞台は戦争で不毛の地と化した終末後の世界。寒い日が多く、雪や雨が降ることもある。(似たような世界設定に「少女終末旅行」がある。）\n彼らは通常、旅先で廃墟のような建物に自分たちのシェルターを見つける。廃墟と化したショッピングモールや古い縁日、空き家などに \"お宝 \"を探しに行く。\n\n子供バージョンもOK！\nhttps://drive.google.com/drive/folders/1fGGmYSgc6W9S8nPG2eslO1s-90aXh3Sg\n\n衣装は自由に変更してください。\n難易度が高かったり、量が少なかったりする場合はキャンセルしてください。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1tk40WCjxUAFSbGv3yM4QaD1lJ83XBbPy?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/30", "thumbnail_src": "https://si.imgix.net/09478d56/uploads/origins/1440ff70-923b-4167-ae1a-972d17b58c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3cd09f2bdcfb17032264d7787057db9", "thumbnail_srcset": "https://si.imgix.net/09478d56/uploads/origins/1440ff70-923b-4167-ae1a-972d17b58c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3cd09f2bdcfb17032264d7787057db9, https://si.imgix.net/09478d56/uploads/origins/1440ff70-923b-4167-ae1a-972d17b58c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b88a730405e16ea2244cd16621965cb3 2x, https://si.imgix.net/09478d56/uploads/origins/1440ff70-923b-4167-ae1a-972d17b58c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e7acb7c712ff738b5cb3444c694373d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのイラストがとても好きで、私のOCのためにコミッションを作りたいと思っています！\n女の子と男の子（〜12歳、同じ身長〜150cm）で、親友同士。リンク先で詳細を確認できます！\nhttps://drive.google.com/drive/folders/1LMztJ-ZvXvdNcrV-BYApjg_41kfdek5X\n\n布は自由に描いてください(変更/簡略化しても構いません)！\n読んでくれてありがとう！\nよろしくお願いします。\n角兔子", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/29", "thumbnail_src": "https://si.imgix.net/b4abed31/uploads/origins/51a1590a-789d-4383-a449-921384611383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5317efc9a76617bed72eedbb4e097318", "thumbnail_srcset": "https://si.imgix.net/b4abed31/uploads/origins/51a1590a-789d-4383-a449-921384611383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5317efc9a76617bed72eedbb4e097318, https://si.imgix.net/b4abed31/uploads/origins/51a1590a-789d-4383-a449-921384611383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d00a9479a69ec73d4d559f728bb1db 2x, https://si.imgix.net/b4abed31/uploads/origins/51a1590a-789d-4383-a449-921384611383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d5c08a357502275f691eb431b01107a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今来ワ様の絵が大好きです。よろしければ、私の2人のキャラクターを描いてほしいです。衣装やコンセプトを変えてもいいです。自由に描いてください！機会があればよろしくお願いします…！\n\nhttps://drive.google.com/drive/folders/113VLrAC2iWbeDjBDaV1oK_dXQrg4_RK9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/28", "thumbnail_src": "https://si.imgix.net/d83f83db/uploads/origins/33ebc740-9392-49ea-a365-512b06421c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63609d8d09e8f6a7b12c817d9b615c76", "thumbnail_srcset": "https://si.imgix.net/d83f83db/uploads/origins/33ebc740-9392-49ea-a365-512b06421c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63609d8d09e8f6a7b12c817d9b615c76, https://si.imgix.net/d83f83db/uploads/origins/33ebc740-9392-49ea-a365-512b06421c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e9d4de6bd563689ea96ac8e547f0f1a 2x, https://si.imgix.net/d83f83db/uploads/origins/33ebc740-9392-49ea-a365-512b06421c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04eff12a52b3ed012af856a38d642d46 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/27", "thumbnail_src": "https://si.imgix.net/05941059/uploads/origins/10d0d2d3-6245-4aff-bed7-e6662903182f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7308b038494363bdfe7b7233f9d8e822", "thumbnail_srcset": "https://si.imgix.net/05941059/uploads/origins/10d0d2d3-6245-4aff-bed7-e6662903182f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7308b038494363bdfe7b7233f9d8e822, https://si.imgix.net/05941059/uploads/origins/10d0d2d3-6245-4aff-bed7-e6662903182f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a7110cb24948d44d66ec6bb150cdec8 2x, https://si.imgix.net/05941059/uploads/origins/10d0d2d3-6245-4aff-bed7-e6662903182f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5a08d7b7daf3e13273fe0dedbc35f1f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！先生。私は先生の絵がとても好きで、私のOCを描いていただきたいと思います。\n彼らは皆、1980年代のアラスカの人里離れた町に住んでいた。雪の平原と針葉樹林の上に作られたこの小さな町では、様々な古代の謎や魔術の伝説が語り継がれている。\nドーン（赤い目）：167cm。無口な医師で、父親の魔術儀式の唯一の生き残り。過去の経験から、死は彼女にとって強い魅力となっている。\nコンスタンス（青い目）：174cm。黒狐か蛇のようなエレガントでミステリアスな魔女。魔女裁判で焼き殺され、今は魔術で復活し、幽霊のように町をさまよっている。\n二人は恋愛関係にはない。魔女は博士の周囲に留まり、彼女の日常生活に影響を及ぼしている。精神的に不安定な人間と、彼女の内なる悪魔との関係にすぎない。\n自由に描いてください。死や魔術、火に関連する要素を入れることもできる。\n彼らの服装を変えたり、シンプルにしたりするのも自由です。\n\nhttps://drive.google.com/drive/folders/1z-U7R_Adzn7hjvhNbnHRK8Mz0rV-TVNI", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/26", "thumbnail_src": "https://si.imgix.net/cc53e7bb/uploads/origins/50e754ee-5b3a-42b4-bad3-0bf70de0bd36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c9b53d82a3c80fc53269a15a0f731f", "thumbnail_srcset": "https://si.imgix.net/cc53e7bb/uploads/origins/50e754ee-5b3a-42b4-bad3-0bf70de0bd36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c9b53d82a3c80fc53269a15a0f731f, https://si.imgix.net/cc53e7bb/uploads/origins/50e754ee-5b3a-42b4-bad3-0bf70de0bd36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa814d07d835dac4490d711a5761a64a 2x, https://si.imgix.net/cc53e7bb/uploads/origins/50e754ee-5b3a-42b4-bad3-0bf70de0bd36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3c3306d2a331ea38bfdbb5754893bb2 3x", "genre": "art", "nsfw": false, "body": "Hello 今来ワ! I love the way you draw backgrounds and would like to see my OCs created by you. Please feel free to decline or request a new amount if you feel that my request is beyond the scope of your work. \n\nThe girl with black hair has a calm and mature personality. The girl with brown hair is rather immature and has a strong ego. They aren't friendly with each other, but they work together often. They are usually in an apocalyptic dystopian city, but any type of situation is fine.\n\nhttps://drive.google.com/drive/folders/1Sbl2eCb9GBSPK496ng2ygnOkE3ecRGoT?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/25", "thumbnail_src": "https://si.imgix.net/879c05bf/uploads/origins/c85ab52b-bc9d-4174-8e5e-732bc44d7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8137a12dc7b2eb2e8280ae4245383c3", "thumbnail_srcset": "https://si.imgix.net/879c05bf/uploads/origins/c85ab52b-bc9d-4174-8e5e-732bc44d7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8137a12dc7b2eb2e8280ae4245383c3, https://si.imgix.net/879c05bf/uploads/origins/c85ab52b-bc9d-4174-8e5e-732bc44d7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=004a8a33cd90c0745a4c604fd3818e15 2x, https://si.imgix.net/879c05bf/uploads/origins/c85ab52b-bc9d-4174-8e5e-732bc44d7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76cef993e282b0223b2ee79246ab655d 3x", "genre": "art", "nsfw": false, "body": "今来ワさん、こんにちは!私はとてもあなたの絵が好きで、あなたが下の役のために插图を描くことができることを望みます。 URLから画像をご覧いただけます。\nこの男は30歳で、身長は192センチです。彼は灰色の髪に青い目をしています。彼の髪は背中まで伸びていて、腰までは届きません。彼は会社員です。彼の性格は穏やかでしっかりしていて、時には活発です。 \n女の子は20歳で身長167センチです。彼女は浅黒い髪と金色の目をしています。耳の前の髪は後頭部よりも少し長く、小さく二つにしばられています。性格は見た目はクールですが、内面は温かいです。\n 二人の出会いは夢の中でした。夢の中で昭和のキャンパスにタイムスリップしてしまい、二人で手を取り合ってなんとか夢から現代に戻ってこなければなりません。夢の中で、女の子は男の子に疑いを持っているが彼と頼り合って、ゆっくりと彼に違う感情を生みます(男の子の方は感情に対して鈍感で、たとえ後期彼は女の子に対して保護欲以外の感じが生まれたとしても自分もすぐに明確ではありません)。彼女は悲しみの末に一人で戦い、夢から逃げ出しました。 男の子は本当の意味で死亡していないで、彼は現実に戻って、夢の中の記憶を失った(女の子が誰なことを覚えていないで、ただ彼女は見覚えがあると感じて、しかし記憶を失ったが、あの特殊な感じはまだあります)、女の子は彼を探し当てて、病院の屋上で彼のために夢の中のすべてを語って、彼女自身の感情の部分について話の間に隠しました。\n これは青春の痛みを抱えた物語です。月(男の子のシンボル)、忘れな草、明鏡(昭和の夢のシンボル)、ときめき(女の子は最後に男の子のときめきを聞いて落ち着く)、花札(夢から逃れるヒント)、春の風景、ドリームネット、医療機器、火、雪、告白の手紙などが私の原稿の中にあります。これらは彼らの物語に関連するものです。 \n二人の武器は、女の子のバットと男の子のピストルです。女の子が最後に夢から脱出するときに使った武器は、男の子が残していった狙撃銃でした。これらは必ずしも描かなくてはいけないわけではないので、自信がなければ武器を描かなくても構いません。 自由に描いていいです。ありがとうございます。 \n\nhttps://docs.qq.com/doc/DYW5rZXNmTFFrYnJF\n\nhttps://docs.qq.com/doc/DYW5rZXNmTFFrYnJF", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/24", "thumbnail_src": "https://si.imgix.net/b111d296/uploads/origins/c4aa5666-f3e7-4af6-b690-2bad242741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e0235e89665677a0a2a0a3282efd6b4", "thumbnail_srcset": "https://si.imgix.net/b111d296/uploads/origins/c4aa5666-f3e7-4af6-b690-2bad242741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e0235e89665677a0a2a0a3282efd6b4, https://si.imgix.net/b111d296/uploads/origins/c4aa5666-f3e7-4af6-b690-2bad242741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b4f92a0392b24f7dc83da90e9cd4c36 2x, https://si.imgix.net/b111d296/uploads/origins/c4aa5666-f3e7-4af6-b690-2bad242741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ed8a3fc6c325ac442cb573e5036f3d0 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n今来ワ様の絵がとても好きなので、私のオリキャラを描くことを依頼したいです。ここで、2人の参考です: https://drive.google.com/drive/folders/1-NBG-JVI3AM7P_evTpLVdIZY7_YirHGy\n\n構図はおまかせします。自由に服を選んでください、簡略化・変更可能です。新しいデザインの服も大歓迎です。\n\n依頼内容が金額と見合わない・その他不備などがあればお気軽に再送要請してください🙌🏻内容に問題がない場合は何卒よろしくお願い致します...！", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/23", "thumbnail_src": "https://si.imgix.net/454fc886/uploads/origins/05351d4f-7944-4ec6-bf81-abb230556234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f4919d241aaf506ccd22850db0e2fd", "thumbnail_srcset": "https://si.imgix.net/454fc886/uploads/origins/05351d4f-7944-4ec6-bf81-abb230556234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f4919d241aaf506ccd22850db0e2fd, https://si.imgix.net/454fc886/uploads/origins/05351d4f-7944-4ec6-bf81-abb230556234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f20a6081a73a887068dedb6220a0846d 2x, https://si.imgix.net/454fc886/uploads/origins/05351d4f-7944-4ec6-bf81-abb230556234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07963a2a7fb4e16e963f8cdba19d0360 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは！私はあなたが描いたキャラクターが大好きです。私のオリジナルキャラクターのイラストをお願いしたいです。\n\n【キャラクター設定】\n[夜白：茶髪の少女]：\n14歳、好奇心旺盛で活発な少女。彼女の趣味は自然観察で、よく持ち歩いているノートに記録している。\n夜白には顽皮な一面があり、明るい外見の下に悪戯好きで小悪魔のような表情をよく見せる。人をからかうのが好きで、特に純粋で内気な忍斗をからかうことが多いです。忍斗の反応が面白いと感じているようです。\n好奇心に駆られ、よく直感で行動するため、この性格が忍斗に多くのトラブルを引き起こす。\n\n[忍斗：赤髪の少年] ：\n14歳、感情を表に出すのが苦手で、実は人見知りしやすい穏やかな少年。未熟な扱いを受けたくないため、冷静で内気に見られないように振る舞うことを好むが、常に夜白に見抜かれ、からかわれることがある。\n彼は弓の扱いに非常に長けており、反応能力も敏感です。木登りや料理が得意。\n甘いものが好きだが、恥ずかしいので人に知られたくないと思っている。\n彼は夜白のことを、少し面倒でもあり、心配せずにはいられない大切な仲間だと思っています。\n\n二人は遭遇した超常現象を解決するため、街中を奔走します。\n以下のテーマから、描きたいものをお選びください：\n【恐竜化石博物館の冒険】\n【深夜図書館の不気味な事件】\n【時間旅行】\nもちろん、他のアイデアがあれば、ご自身の好みやインスピレーションに基づいて自由に描いてください！キャラクターの物語をさまざまな視点で解釈していただけることを心から嬉しく思います。\n\nPSDに線画や練習絵、没ラフ等があれば入れてくれると嬉しいです。\nもし、描きたくなければ、直接依頼をキャンセルしていただいて結構です。\n閲覧していただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1g3UbYgp8OjM6rTnG_wAEJM4by8XqGLy2", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/22", "thumbnail_src": "https://si.imgix.net/0d0c9ed3/uploads/origins/be3c9a02-727e-46cb-82e1-0632c27478a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a70ff07ab2d7f40c614b7f364427b650", "thumbnail_srcset": "https://si.imgix.net/0d0c9ed3/uploads/origins/be3c9a02-727e-46cb-82e1-0632c27478a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a70ff07ab2d7f40c614b7f364427b650, https://si.imgix.net/0d0c9ed3/uploads/origins/be3c9a02-727e-46cb-82e1-0632c27478a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a200e5ae55cba62d51780b8b988b346b 2x, https://si.imgix.net/0d0c9ed3/uploads/origins/be3c9a02-727e-46cb-82e1-0632c27478a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3297c560d69ce2408896f65243e570a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@iketaraikuw/works/21", "thumbnail_src": "https://si.imgix.net/12a3aa77/uploads/origins/e048b9c3-415b-4c57-8b28-8ebb31f8f193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a703edc2592ae62ab30226cc29b549", "thumbnail_srcset": "https://si.imgix.net/12a3aa77/uploads/origins/e048b9c3-415b-4c57-8b28-8ebb31f8f193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a703edc2592ae62ab30226cc29b549, https://si.imgix.net/12a3aa77/uploads/origins/e048b9c3-415b-4c57-8b28-8ebb31f8f193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ef65a011a79005d2c5120e31aa652ed 2x, https://si.imgix.net/12a3aa77/uploads/origins/e048b9c3-415b-4c57-8b28-8ebb31f8f193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d4f2a6800237daebfcf2c9e1b6393e5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生のイラストが好きで依頼させていただきました！\n私のオリキャラの絵を描いてもらえますか？\n\nキャラクター設定：\n- 異常現象を解決できる特別な声を持ち、ラジオアナウンサーとして夜勤を務める女性。\n- ピンク髪 / 黒い目 / 人懐っこいお姉さん\n- 彼女はいつも月のように明るい面だけを見せます\n- 遠出の旅行したいけど行けないので、 住んでいる港町をよく探索します\n- 他の特殊能力：糸電話を使って、他の人の本音を聞くことができます\n- キャライメージ要素：海 / 月の満ち欠け / 糸電話 / 蝉 / アンテナ/ 生活感 or 夏を連想させる要素\n\n構図等はお任せします、ご自由に描いてください！\n金額不足や難しいなどの場合、お気軽にキャンセルや再送要請をお願い致します。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iLH92c4n1QdNnsrfZb8eSmcdHRcHRg1X?usp=sharing", "created_at": "", "completed_at": ""}]}