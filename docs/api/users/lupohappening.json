": "https://si.imgix.net/fb0f8a54/uploads/origins/ca5ab504-f17c-448f-8336-e824429b1049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08bdf4f94ffafd18099cf67779894e61", "thumbnail_srcset": "https://si.imgix.net/fb0f8a54/uploads/origins/ca5ab504-f17c-448f-8336-e824429b1049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08bdf4f94ffafd18099cf67779894e61, https://si.imgix.net/fb0f8a54/uploads/origins/ca5ab504-f17c-448f-8336-e824429b1049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b42a2b34b4a1a503e76064bf57ecdde 2x, https://si.imgix.net/fb0f8a54/uploads/origins/ca5ab504-f17c-448f-8336-e824429b1049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8b9fbdd1e97b4859c04cced24446ddd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lupohappening/works/88", "thumbnail_src": "https://si.imgix.net/f217d7b5/uploads/origins/c8e43547-2e80-427c-bd99-b6ea6ae3fd12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dce454e5b7b993771ab52815bc3502", "thumbnail_srcset": "https://si.imgix.net/f217d7b5/uploads/origins/c8e43547-2e80-427c-bd99-b6ea6ae3fd12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dce454e5b7b993771ab52815bc3502, https://si.imgix.net/f217d7b5/uploads/origins/c8e43547-2e80-427c-bd99-b6ea6ae3fd12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd5aa11eea250504f2f29a7d941455b9 2x, https://si.imgix.net/f217d7b5/uploads/origins/c8e43547-2e80-427c-bd99-b6ea6ae3fd12?bg