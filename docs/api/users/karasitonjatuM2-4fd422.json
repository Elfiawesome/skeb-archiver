%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcd01872257356166992f0679e14600c, https://si.imgix.net/acf91e3e/uploads/origins/9a5699ed-c0af-4fa1-933b-76b43eb1e60e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=144e3cb9da740f94acde978eba245217 2x, https://si.imgix.net/acf91e3e/uploads/origins/9a5699ed-c0af-4fa1-933b-76b43eb1e60e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e68d4412264c01b5446da3ddc09f5363 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@karasitonjatuM2/works/47", "thumbnail_src": "https://si.imgix.net/3012cd12/uploads/origins/6c45b065-24b0-4818-9a7f-9f17e92b545e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cef982e2731577520d9ce562cee94e1", "thumbnail_srcset": "https://si.imgix.net/3012cd12/uploads/origins/6c45b065-24b0-4818-9a7f-9f17e92b545e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cef982e2731577520d9ce562cee94e1, https://si.imgix.net/3012cd12/uploads/origins/6c45b065-24b0-4818-9a7f-9f17e92b545e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c7c444d5dc3f35bfc7a69116f5282d5 2x, https://si.imgix.net/3012cd12/uploads/origins/6c45b065-24b0-4818-9a7f-9f17e92b545e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78266a90441bd8b2ad2bc3153a099f4f 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。くろつちです。\n\n私が同人誌で描いている『サキュバスシティ』に暮らすモブサキュバスのデザインを【3人】、依頼したく思います。\n\n基本的にデザインは手羽先サイクロン様の手癖、性癖を自由に込めていただいて構いません。モブサキュバス、と描きましたが、モブ顔やメカクレである必要もありません。「他の方のデザインを取り入れた方が楽しいよね」という意図でリクエストさせていただいています。\n\nデザインしていただく上での要望・注意事項は以下の通りです。\n\n・三面図や表情、ポーズ差分などは必要ありません。服装があまり隠れないポーズであれば問題ありません。\n\n・モブサキュバス、としましたが、モブ顔、メカクレにする必要はなく、髪型や服装などのデザインを必ずしも統一する必要はありません。\n\n・装飾類は華美になりすぎないように。つける場合もワンポイント程度が望ましいです。\n\n・衣服は踊り子風などのファンタジーによりのものでも、セーラー服風などの現代的なものでも問題ありません。露出度は高いとありがたいですが、乳首や局部が(通常時は)露出しないものでお願いします。水龍敬ランドまでの範囲内が望ましいです。\n\n・陰毛、脇毛はいずれも無しでお願いします。\n\n・全員ふたなりですが、skebの形式上、ちんぽのデザインは必ずしも必要ありません。魔法的なもので普段はちんぽを消し、女性と変わりない状態で振る舞うため、股間の膨らみや玉などは不要です。\n\n・デザインが気に入った場合は当該キャラクターのイラストや同人を描いたり、再びこのキャラクターのイラストリクエストをさせていただく場合がございます。\n\n\nデザインの参考に、漫画家、窓口基様がpixivなどに掲載されていた、「無自覚サキュバス化TS」内に登場するモブサキュバスのような、一般常識では外に着て歩くのに適さないものなどが好みです。\n\n\n●資料URL\n■サキュバスシティが舞台の自作同人誌のサンプル\nhttps://x.com/rezanoffffffu/status/1742866095420383568\n\n■窓口基様「無自覚サキュバス化TS」\nhttps://www.pixiv.net/user/15033/series/186658", "created_at": "", "completed_at": ""}, {"path": "/@karasitonjatuM2/works/46", "thumbnail_src": "https://si.imgix.net/0959da49/uploads/origins/69616c61-6a7e-4ff8-95c8-153802b5a659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf6574b5db23a969765073b1576b049", "thumbnail_srcset": "https://si.imgix.net/0959da49/uploads/origins/69616c61-6a7e-4ff8-95c8-153802b5a659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf6574b5db23a969765073b1576b049, https://si.imgix.net/0959da49/uploads/origins/69616c61-6a7e-4ff8-95c8-153802b5a659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aee03f3f7691f9c4d8058e82156abd90 2x, https://si.imgix.net/0959da49/uploads/origins/69616c61-6a7e-4ff8-95c8-153802b5a659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f03fef37c3d5004f0692b689206e2f5c 3x", "genre": "art", "nsfw": true, "body": "コンプソグナトゥス系の恐竜モチーフ和風人外娘ちゃんの着せ替えが楽しいので追加パーツを希望してみます。\n\n・ボテ腹\n・↓にあるような開脚ポーズと挿入時、中出し前後\n　https://www.pixiv.net/artworks/115768202\n\nあとは手羽先さんがよさげなものがあればご自由に。\n開脚ポーズは既存のパーツを流用できると着せ替えが捗るかと思いますが、面倒であれば処理はお任せします。\nそれではよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@karasitonjatuM2/works/45", "thumbnail_src": "https://si.imgi