cdb-4d89-9307-364a7a2d1c38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa492c474406f5d17ddc6a3ade6e9f81 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bals0164_2/works/189", "thumbnail_src": "https://si.imgix.net/9a762215/uploads/origins/24f2c4a3-dfe1-4be7-85fd-5bef694cfc97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ae1aec5e43555afaeafbd5fcd2d6e04", "thumbnail_srcset": "https://si.imgix.net/9a762215/uploads/origins/24f2c4a3-dfe1-4be7-85fd-5bef694cfc97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ae1aec5e43555afaeafbd5fcd2d6e04, https://si.imgix.net/9a762215/uploads/origins/24f2c4a3-dfe1-4be7-85fd-5bef694cfc97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=890b97fa9e7197816d378c8715e384e9 2x, https://si.imgix.net/9a762215/uploads/origins/24f2c4a3-dfe1-4be7-85fd-5bef694cfc97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e86a48a34a68eb2898f70d5ec04da56d 3x", "genre": "art", "nsfw": true, "body": "いつも楽しみに作品を拝見してます、また依頼お願いしたいです。\n\n【内容】全裸で廊下に立たされるフロウグロウ「輪堂 千速」「綺々羅々ヴィヴィ」「響咲 リオナ」「水宮 枢」「虎金妃 笑虎」\n\n【構図など】\n恰好は全員すっぽんぽんで靴下もなしでお願いします。背景は学校の廊下でお願いします。\n全員気をつけのポーズで、等間隔に並んでる感じでお願いします。全員過去に描いていたすいちゃんの廊下に立たされてる絵のように指を真っすぐ伸ばしてキレイに体の横につけてる感じ希望です。\n並びは左から上記の名前の通り順でお願いします。表情はリオナちゃん以外は全員恥ずかしそうな感じで、リオナちゃんはみんなとすっぽんぽんになれて嬉しそうな感じでお願いします。\n枢ちゃん以外は陰毛あり希望です。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bals0164_2/works/188", "thumbnail_src": "https://si.imgix.net/d19ded3a/uploads/origins/f678ccbf-bd72-4bec-8011-729ec2713180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c29c9618be0cc3df8c0370b387a4ea0", "thumbnail_srcset": "https://si.imgix.net/d19ded3a/uploads/origins/f678ccbf-bd72-4bec-8011-729ec2713180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c29c9618be0cc3df8c0370b387a4ea0, https://si.imgix.net/d19ded3a/uploads/origins/f678ccbf-bd72-4bec-8011-729ec2713180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c75f87ca71c1901c7a48f415cc7cd8f5 2x, https://si.imgix.net/d19ded3a/uploads/origins/f678ccbf-bd72-4bec-8011-729ec2713180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f7e34dda315a288b9376ea1dec05323 3x", "genre": "art", "nsfw": true, "body": "オリキャラのティレイラがトラブルに見舞われた姿のイラストをお願いしたいです。\n\nティレイラが迷宮探索中にトラップを発動させてしまい\n大慌てで逃げ出している最中に色々トラップを発動させてしまい\n瞬間的な突風が吹いたことで大きな翼に風が当たって身体が後ろによろめいて\n思わず驚きの声を上げた瞬間に石化の光を浴びて石化していき\nそのまま姿勢で動けないまま完全に石化してしまった様子でお任せでお願いします。\n\n・ティレイラ参考画像\nhttps://drive.google.com/file/d/1d5Vd_monXZg7CKuJUGziJ99AVW4BbIPy/view", "created_at": "", "completed_at": ""}, {"path": "/@bals0164_2/works/187", "thumbnail_src": "https://si.imgix.net/af4db501/uploads/origins/d8afe6fa-7ec6-4546-9d3d-df019c149f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd4e2ecdecf2a37fa4724e065ac34e3d", "thumbnail_srcset": "https://si.imgix.net/af4db501/uploads/origins/d8afe6fa-7ec6-4546-9d3d-df019c149f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd4e2ecdecf2a37fa4724e065ac34e3d, https://si.imgix.net/af4db501/uploads/origins/d8afe6fa-7ec6-4546-9d3d-df019c149f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6add7ae757c74fc50d9335db0cb6a13 2x, https://si.imgix.net/af4db501/uploads/origins/d8afe6fa-7ec6-4546-9d3d-df019c149f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e6e7b652e9027565d62990438e97a6b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bals0164_2/works/186", "thumbnail_src": "https://si.imgix.net/f2d7ef39/uploads/origins/df5f1f55-0683-4670-9bb0-e5b21974b038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ab5e605ef6727f5d66b95b5cc97aa2", "thumbnail_srcset": "https://si.imgix.net/f2d7ef39/uploads/origins/df5f1f55-0683-4670-9bb0-e5b21974b038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ab5e605ef6727f5d66b95b5cc97aa2, https://si.imgix.net/f2d7ef39/uploads/origins/df5f1f55-0683-4670-9bb0-e5b21974b038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99b4a168b510456d504f4a49c05bb071 2x, https://si.imgix.net/f2d7ef39/uploads/origins/df5f1f55-0683-4670-9bb0-e5b21974b038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83d7e8ca8e37a935f5048a1d4412cfdc 3x", "genre": "art", "nsfw": true, "body": "いつも楽しみに作品を拝見しております。またリクエストをお願いしたいです。\n\n【内容】プールではだかんぼを晒すねぽらぼ（桃鈴ねね、尾丸ポルカ、雪花ラミィ、獅白ぼたん）\n\n【構図など】\n背景は学校のプールでお願いします。恰好は全員すっぽんぽんで靴下も無しでお願いします。\n髪型は全員通常衣装準拠でお願いします。陰毛はねねちは無しで、他3人はありでお願いします。ラミィちゃんは普通で、ししろん、おまるんは濃いめがいいです。\n設定としては罰としてクラスメイトに裸を晒されているところってイメージです。\n構図は正面向きで横一列に立ってる感じで、全員体に巻いていたであろうラップタオルを手でガバっと広げて裸を見せつけてる感じでおねがいします。足はほどよく広げて立ってる感じでお願いします（ガニ股ではない版の変態が体を見せつけてるような感じと言えばわかりやすいですかね）。並びはね　ぽ　ら　ぼ　の順でお願いします。体全体が映り等間隔で並んでる感じでお願いします。\n全員顔を真っ赤に染めて、恥ずかしそうな感じでお願いします。体全体にほどよく汗を描いて頂いて、全員目を開けてて線目は無しでお願いします。\n\n少しご依頼料にプラスしますので、可能であれば差分でふたなり差分があると嬉しいです、おちんちんの大きさは少し大きめ希望です。", "created_at": "", "completed_at": ""}, {"path": "/@bals0164_2/works/185", "thumbnail_src": "https://si.imgix.net/4a8a7bf5/uploads/origins/bebccebf-643d-4a8a-a41e-f9dbf4488c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90f2e7f7ff9f042af54ea880ed82861e", "thumbnail_srcse