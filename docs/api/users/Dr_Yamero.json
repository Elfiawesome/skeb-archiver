f-9aac-a7ac2d5b37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ec4612ff79cc2a31fe7a63e337d0533, https://si.imgix.net/7d96c731/uploads/origins/f8e216a3-273a-4e1f-9aac-a7ac2d5b37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4719afdad2f4d425784d69b7cd385bb 2x, https://si.imgix.net/7d96c731/uploads/origins/f8e216a3-273a-4e1f-9aac-a7ac2d5b37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a27030b29bc1c10e7ce1f129ed79b2e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターを描いてくれませんか？\n\nケモノミミの警察官で、自分ではクールで上品だと思っているんだけど、実は大のおバカ。いつも手探りで事件を処理し、そのくせ自分が思っているクールなイメージを必死に保とうとする。そんな不器用な彼女だが、実は驚くほど運動神経がよく、機敏なのだ。\n\n私はあなたの作品の強烈な表情に憧れているので、彼女が気まずそうに見つめて見る人に何かを尋ねるシーンは完璧だと思う（最初に話す気にはなれないが）！\n\nhttps://photos.app.goo.gl/BhhjPiHWDXkAoEA5A", "created_at": "", "completed_at": ""}, {"path": "/@Dr_Yamero/works/343", "thumbnail_src": "https://si.imgix.net/1066f5bd/uploads/origins/f1d3cf1a-fbff-4dab-ba5f-04568e5a6604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=700db7a5835da42784ad0e50555ec96c", "thumbnail_srcset": "https://si.imgix.net/1066f5bd/uploads/origins/f1d3cf1a-fbff-4dab-ba5f-04568e5a6604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=700db7a5835da42784ad0e50555ec96c, https://si.imgix.net/1066f5bd/uploads/origins/f1d3cf1a-fbff-4dab-ba5f-04568e5a6604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=515adbadefcf2a9081053923765af9e8 2x, https://si.imgix.net/1066f5bd/uploads/origins/f1d3cf1a-fbff-4dab-ba5f-04568e5a6604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b441edb3450776061ea3042f2f69fe4 3x", "genre": "art", "nsfw": false, "body": "初めまして。いつも素敵なイラストを拝見させていただいております…！あなた様の描かれるキャラクターの表情が大好きです。\n\n今回はぜひ私のOCでイラストを描いていただけないかと思いリクエストさせていただきました。\n\n人を見下したような顔や、ゲス顔などの雰囲気で描いていただけると幸いです。それ以外はお任せいたします。\n\n金額・資料不足など不備があればお手数ですが再送、キャンセルをお願いいたします。ご多忙のところ大変申し訳ございませんが、ご縁がありましたら何卒ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-owVz34kOSoIyNV29KUntLs7h0CN3fJu", "created_at": "", "completed_at": ""}, {"path": "/@Dr_Yamero/works/342", "thumbnail_src": "https://si.imgix.net/8447d4f1/uploads/origins/ce4be3d6-7d3b-48b3-8f55-a0e607e98c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e351b8f39797ef4035a2667fc98b7a", "thumbnail_srcset": "https://si.imgix.net/8447d4f1/uploads/origins/ce4be3d6-7d3b-48b3-8f55-a0e607e98c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e351b8f39797ef4035a2667fc98b7a, https://si.imgix.net/8447d4f1/uploads/origins/ce4be3d6-7d3b-48b3-8f55-a0e607e98c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ead02e13c46596890c66858e2392508 2x, https://si.imgix.net/8447d4f1/uploads/origins/ce4be3d6-7d3b-48b3-8f55-a0e607e98c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5acf83cca33beac52d3b2739deb07cbf 3x", "genre": "art", "nsfw": false, "body": "初めまして\npixivで才羽姉妹の曇らせ作品を見た時から先生のファンでした！\n\nskeb募集開始の通知を見て、うちの子のイラストを見たくてリクエストをさせて頂きました。\n\n容姿の資料を添付しますが、先生の怖可愛い絵柄が本当に好きなのでそのままの作風で描いて頂けると嬉しいです。\n\nhttps://x.com/rule_rosepso2/status/1945536733589725482?s=46&t=dLRLKUrjoD4tS9AAfqi0sA\n\n構図は、「吸血鬼のこの子に襲われる前の視点」or「食事の後」の絵を希望します。\n返り血とギザギザ歯が反映されていると嬉しいです😆\n\nご検討を宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Dr_Yamero/works/341", "thumbnail_src": "https://si.imgix.net/7d4eb548/uploads/origins/6b6a825c-c3b6-416a-866f-a6dbebd6ef6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6066037230273a6f2a1495aea4b3305", "thumbnail_srcset": "https://si.imgix.net/7d4eb548/uploads/origins/6b6a825c-c3b6-416a-866f-a6dbebd6ef6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f