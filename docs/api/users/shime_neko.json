gle.com/drive/folders/1AkOPFzcu_7FdlvstMkbsMjWzENeW_VLj", "created_at": "", "completed_at": ""}, {"path": "/@shime_neko/works/40", "thumbnail_src": "https://si.imgix.net/3eb43105/uploads/origins/ad1259f5-adf7-414a-9a73-e569c426258b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e236f6b4ea8cefe9f56dc9cdfba750a0", "thumbnail_srcset": "https://si.imgix.net/3eb43105/uploads/origins/ad1259f5-adf7-414a-9a73-e569c426258b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e236f6b4ea8cefe9f56dc9cdfba750a0, https://si.imgix.net/3eb43105/uploads/origins/ad1259f5-adf7-414a-9a73-e569c426258b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e2dcd9f740e733d1829645c2cdb0a52 2x, https://si.imgix.net/3eb43105/uploads/origins/ad1259f5-adf7-414a-9a73-e569c426258b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d3913b747ce4c24f2404ada00a55d6b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shime_neko/works/39", "thumbnail_src": "https://si.imgix.net/34f78303/uploads/origins/1a5f7103-04dd-46cb-a904-262eaa27bbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d38b740c26fb52f5775e1fcd88f0b36", "thumbnail_srcset": "https://si.imgix.net/34f78303/uploads/origins/1a5f7103-04dd-46cb-a904-262eaa27bbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d38b740c26fb52f5775e1fcd88f0b36, https://si.imgix.net/34f78303/uploads/origins/1a5f7103-04dd-46cb-a904-262eaa27bbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro