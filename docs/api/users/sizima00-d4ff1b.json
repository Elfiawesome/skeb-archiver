6a6-4243-a518-87ab00c514f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=122e2feb307b31999284a750aac2f39c", "thumbnail_srcset": "https://si.imgix.net/e98a8f0a/uploads/origins/2f6b3ac9-d6a6-4243-a518-87ab00c514f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=122e2feb307b31999284a750aac2f39c, https://si.imgix.net/e98a8f0a/uploads/origins/2f6b3ac9-d6a6-4243-a518-87ab00c514f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e43a69d4f0cab5354e87f968d280f7d2 2x, https://si.imgix.net/e98a8f0a/uploads/origins/2f6b3ac9-d6a6-4243-a518-87ab00c514f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0b0122d743c51c4156426363741ebcf 3x", "genre": "art", "nsfw": false, "body": "Hello しじま sensei, I'm a big fan of your Identity V fan art! Can I request you to draw my original character? Here are some details about him:\n\n-Name: Proximity, age: ???\n-Scientist that was murdered but revived.  \n-Personality is quiet and reserved, but he have a dark side.\n-He is secretly conducting  experiments on someone close to him.\n\nElements you can draw: books, science equipments, research papers, medicines, blood.  \nHis glasses and lab coat is optional, you can choose wether you want to draw them or not.\nIf you want you can also draw the scars on his torso.\n\nI really like these illustrations you made here: (https://x.com/sizima00/status/1663070266543718400?s=20) ( https://x.com/sizima00/status/1628644153268781056?s=20) (https://x.com/sizima00/status/1733440026921624003?s=20)  I love when you draw dark illustrations with bright colors, so if you can, please create something with an atmosphere similar to that. \n\nThank you very much for considering my request ! <33\n\nhttps://drive.google.com/drive/folders/1-5Vzk75UG-Q21wUoRnQo9LjDthPtInqj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sizima00/works/11", "thumbnail_src": "https://si.imgix.net/886f6ed6/uploads/origins/342bc54f-e6a4-4560-af12-af04713d0c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de5c6fe52a88728197791de4b352b146", "thumbnail_srcset": "https://si.imgix.net/886f6ed6/uploads/origins/342bc54f-e6a4-4560-af12-af04713d0c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de5c6fe52a88728197791de4b352b146, https://si.imgix.net/886f6ed6/uploads/origins/342bc54f-e6a4-4560-af12-af04713d0c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ada0181df770306c1c60ba671cbbc990 2x, https://si.imgix.net/886f6ed6/uploads/origins/342bc54f-e6a4-4560-af12-af04713d0c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1408bf573f746522e623b2423355699c 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n新着でお見かけしたイラストに惹かれ、ぜひしじまさまの作風で私の創作キャラクターを拝見したく、リクエストさせていただきました。\n\n描いていただきたいのは『キイ』『カズタカ』という男性のどちらか、あるいは可能でしたらどちらともになります。\n●キイ\n面倒見の良いサディスト。自営業（人材紹介）／180cm前半。40代前半、見た目や言動はかなり若々しい／動物イメージ：オオカミ\n●カズタカ\n作品制作以外、無欲で無頓着な潜在マゾヒスト。画家／170cm前半。30歳前後／動物イメージ：ヒツジ\n\n○ふたりのキーワード「欠如・利害の一致・堕落・絵・アトリエ・寝室・モノクロ・深夜・月明かり・首輪・煙草・捕食者と被捕食者」\n\n\n用途：個人使用・鑑賞、SNSアイコンなど\n可能であれば、psdファイルでサイン・背景・人物レイヤーを分けていただけると助かります。\n\n構図やシチュエーション、服装等はお任せいたします。\nまた、よければ制作過程も見せていただきたく、ラフ・没ラフなどがありましたら金額内の範囲で構いませんので同封していただけると嬉しいです。\n\n以上になります。ご検討いただけると幸いです。\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/8vzhp4ibwlpi5vcttzaxt/h?rlkey=naxe7tfxry7s6pb0w5dqjzl63&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sizima00/works/10", "thumbnail_src": "https://si.imgix.net/7b0dbba5/uploads/origins/82b36681-e70d-4c0a-bfb9-1134e654016d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be78d7c77e0328d6cf76b0f3228b0262", "thumbnail_srcset": "https://si.imgix.net/7b0dbba5/uploads/origins/82b36681-e70d-4c0a-bfb9-1134e654016d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be78d7c77e0328d6cf76b0f3228b0262, https://si.imgix.net/7b0dbba5/uploads/origins/82b36681-e70d-4c0a-bfb9-1134e654016d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b385a01ee60b25c84affc1b0ad0c7f0 2x, https://si.imgix.net/7b0dbba5/uploads/origins/82b36681-e70d-4c0a-bfb9-1134e654016d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1455b32cc65b8abfedf4fda8f4923c1 3x", "genre": "art", "nsfw": false, "body": "しじまさん、初めまして。\n趣味で配信活動をしているちえると申します。\n\n今回は私のアバター、マフィアくんのイラストを描いていただきたくリクエストさせていただきました。\n構図・表情はすべてお任せします。\n\n▷マフィアくん\n性別：男 \n身長：192cm \n髪型・髪色：灰色～白っぽい感じ(皇帝とは逆のイメージ)\n目の色：赤\n爪は触ったら傷つきそうなくらい鋭い\n中華マフィアのボスで、性格としては邪智暴虐。無邪気で傲慢な性格です。\n人当たりがよく、人懐っこいですがこれは愛想がいいと物事が円滑に進むことを理解しているため。 \n人に取り入り利用することに長けています。\n \n以下は参考資料です。足りない部分は想像で補っていただけると助かります。\n参考資料\n世界観：https://lit.link/GreatChieru\nマフィアくん：https://drive.google.com/drive/folders/1s7mRAUL7_iYYFVKkcTag_UREyQijsoPO?usp=drive_link　\n\n使用用途としては、主にyoutubeやCAS等での動画素材・配信画面・サムネイルやSNS(X、Instagram)を考えていました。\nまた身内間とはなりますがネットプリント等で販売することになるかもしれません。\n商用利用の金額等で問題がありましたら再度金額提示をお願いします。\n商用利用が不可であれば、お手数ですがどこかのレイヤーに商用利用不可の旨をかいていただきたいです。\n\n可能な限り人物と背景レイヤー等を分けてPSDデータ、難しいようであればPNGデータで分けていただきたいです。\n\n何か不都合等があればキャンセルしていただいて結構です。\n以上です。長々とお読みいただきありがとうございました。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sizima00/works/9", "thumbnail_src": "https://si.imgix.net/59573378/uploads/origins/eda72a45-d3d8-46fd-861b-697031096cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ae498f3b6c7eaa29e158f412fe898b", "thumbnail_srcset": "https://si.imgix.net/59573378/uploads/origins/eda72a45-d3d8-46fd-861b-697031096cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ae498f3b6c7eaa29e158f412fe898b, https://si.imgix.net/59573378/uploads/origins/eda72a45-d3d8-46fd-861b-697031096cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=632cf0c14e605c774c362d8771fd7930 2x, https://si.imgix.net/59573378/uploads/origins/eda72a45-d3d8-46fd-861b-697031096cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top