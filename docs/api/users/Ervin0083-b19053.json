rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25f14b20ea4f838d807f0a136f423d0a 2x, https://si.imgix.net/6f4b712f/uploads/origins/fd642008-e41d-49d5-9874-03f8ad34dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b196d6a7ab44ed2e7eaa980b24132c01 3x", "genre": "art", "nsfw": false, "body": "YouTube配信中に規制シーンを隠す為用のイラストを描いていただきたいです。\nイラスト内容は、\n黒フード被ったゲーム実況者マバタキが見せられないよ看板を視聴者に見せてる姿を描いて欲しいです。\n（見せられないよ看板に『見せられないよ』と描かなくて大丈夫です。空白で看板を持ってる姿を描いて頂けたら大丈夫です）", "created_at": "", "completed_at": ""}, {"path": "/@Ervin0083/works/12", "thumbnail_src": "https://si.imgix.net/0e7ec1ae/uploads/origins/035a8feb-53cc-4a08-8879-652a959ac70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fd6ff4f0e0a4dd2051b9de8b5ecbddc", "thumbnail_srcset": "https://si.imgix.net/0e7ec1ae/uploads/origins/035a8feb-53cc-4a08-8879-652a959ac70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fd6ff4f0e0a4dd2051b9de8b5ecbddc, https://si.imgix.net/0e7ec1ae/uploads/origins/035a8feb-53cc-4a08-8879-652a959ac70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aea86fdcf2334d9e2f63ea0414df546c 2x, https://si.imgix.net/0e7ec1ae/uploads/origins/035a8feb-53cc-4a08-8879-652a959ac70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d29984dbc1d88ca40cd625e0ab89bba3 3x", "genre": "art", "nsfw": false, "body": "ゲーム実況者マバタキのアイコン、上半身しかないので\n全身を描いていただきたいです。\n\n肌の色と目元の影の色はアイコンのままの色でお願いします。美白が好きなので。\n目は描かないで欲しいです。\n顔もアイコンの様に小顔な感じでお願いします。\n\n斜めのイラストではなく、真正面から見たマバタキの全体画を描いていただきたいです。手は横で普通に真正面で立ってるイラストがいいです。\n\n上は黒のパーカー被ってる感じで、七分袖がいいです。\n下のズボンは黒い長ズボンで靴も全部黒がいいです。\n背景は無しでお願いします。\nカッコよく描いていただきたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Ervin0083/works/11", "thumbnail_src": "https://si.imgix.net/ca108c92/uploads/origins/fdef4ba7-6a17-4ebd-8845-5f5605717831?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65bc1bd71271215f02dee0b70e1d22c5", "thumbnail_srcset": "https://si.imgix.net/ca108c92/uploads/origins/fdef4ba7-6a17-4ebd-8845-5f5605717831?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65bc1bd71271215f02dee0b70e1d22c5, https://si.imgix.net/ca108c92/uploads/origins/fdef4ba7-6a17-4ebd-8845-5f5605717831?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12a1e157d7d89ef45000dfe6bf6021ae 2x, https://si.imgix.net/ca108c92/uploads/origins/fdef4ba7-6a17-4ebd-8845-5f5605717831?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24977d4ecdd2661ec9c1fbe769fb14ba 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます。\nはじめまして、朱島悠永です。\nVTuberをしておりまして、Youtubeのサムネ作成等に使用できる一枚絵をお願いしたいです。\n大きさは、フルHD画面いっぱいに大きく（バスト～顔だけ）映したときに荒くならない程度あれば十分で、1500×1500px以上になるかと思います。\nまた透過の背景無しがあると嬉しいです。\n\n資料URLはLive2Dモデルの立ち絵（ほぼ直立）です。\nhttps://x.com/yuna_akashima/status/1491076792173875200\n※上記が閲覧できない場合はこちらをご参照願います。\nhttps://x.com/yuna_akashima/status/1661802642694369280\n髪と目は立ち絵に使用されていない決めた色がありますので、こちらに記載いたします。\n髪：\n・真朱色\nhttps://irocore.com/shinshu/\n目：\n・真朱色（目の色、明るい部分等）\nhttps://irocore.com/shinshu/\n・葡萄色（影等の暗い部分）\nhttps://irocore.com/ebi-iro/\n・海老色（中間色として使用する色）\nhttps://irocore.com/ebi-iro2/\n\n以上です。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ervin0083/works/10", "thumbnail_src": "https://si.imgix.net/9e6e384e/uploads/origins/f935e55c-477c-42ee-90f6-7217b3b69f19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5f2d5daf70414c41db8c8bbe7ed567", "thumbnail_srcset": "https://si.imgix.net/9e6e384e/uploads/origins/f935e55c-477c-42ee-90f6-7217b3b69f19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5f2d5daf70414c41db8c8bbe7ed567, https://si.imgix.net/9e6e384e/uploads/origins/f935e55c-477c-42ee-90f6-7217b3b69f19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8953fc16b6143f912dfddde150da95f7 2x, https://si.imgix.net/9e6e384e/uploads/origins/f935e