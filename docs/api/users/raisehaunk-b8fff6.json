b36bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f6d84edba204d275b02e926a326be02", "thumbnail_srcset": "https://si.imgix.net/84e5ac31/uploads/origins/e5ccff3e-ca1b-4ccd-b961-c4193bb36bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f6d84edba204d275b02e926a326be02, https://si.imgix.net/84e5ac31/uploads/origins/e5ccff3e-ca1b-4ccd-b961-c4193bb36bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92cff38d584572b78a647207ac5760f8 2x, https://si.imgix.net/84e5ac31/uploads/origins/e5ccff3e-ca1b-4ccd-b961-c4193bb36bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2bfc686cd437c83d42f65f57b330c3f 3x", "genre": "art", "nsfw": false, "body": "Hey raisehaunk!\n\nI did want to infact send another back to back which is unexpected as I also have another OC that I'd like you to illustrate in a similar style like how you did with this; https://skeb.jp/@raisehaunk/works/11 ! That being my Cyberpunk OC, Astra!\n\nHer overall design is based on a rose. She is an introvert but friendly, fun and playful when you get to know her. As she’s a mercenary, she can also be cold and serious. She's more of a tomboy as well based on her clothing choices.\n\nCharacter reference(s): https://ibb.co/album/1zpsbJ\n\nAgain, you're free to design the pose, expression and background! You can also draw her without wearing the jacket as well if you'd like! I'll leave it up to you!\n\nThank you so much! Please don't feel pressured to forcefully accept on this approval if you can't!", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/30", "thumbnail_src": "https://si.imgix.net/a0eebe1b/uploads/origins/1fbd3ca8-37b6-45b1-abba-e782f8ae5acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e21c899c1842f1b1c1ce44af8487604", "thumbnail_srcset": "https://si.imgix.net/a0eebe1b/uploads/origins/1fbd3ca8-37b6-45b1-abba-e782f8ae5acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e21c899c1842f1b1c1ce44af8487604, https://si.imgix.net/a0eebe1b/uploads/origins/1fbd3ca8-37b6-45b1-abba-e782f8ae5acb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23cc36e3ceeb6c0cae87649cf4f49030 2x, https://si.imgix.net/a0eebe1b/uploads/origins/1fbd3ca8-37b6-45b1-abba-e782f8ae5acb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cec7383c290e34328f237889f16d578f 3x", "genre": "art", "nsfw": false, "body": "Hey raisehaunk!\n\nI would like to request if you can illustrate my FFXIV OC as I really love the illustrations that you do like how you did with this one; https://skeb.jp/@raisehaunk/works/11\n\n Character references: https://ibb.co/album/NT7d8Z\n(One thing to note, you'll notice that her flower hair accessory is floating. Please don't illustrate it floating!)\n\nYou're free to design the pose, expression and background!\n\nThank you!", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/29", "thumbnail_src": "https://si.imgix.net/262e1f50/uploads/origins/acb0386c-09e4-4660-9571-1b941c584468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc060ad8a3ee636cab935729e91fe511", "thumbnail_srcset": "https://si.imgix.net/262e1f50/uploads/origins/acb0386c-09e4-4660-9571-1b941c584468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc060ad8a3ee636cab935729e91fe511, https://si.imgix.net/262e1f50/uploads/origins/acb0386c-09e4-4660-9571-1b941c584468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=918f4a0d33c71bc2e48c8437eadd1071 2x, https://si.imgix.net/262e1f50/uploads/origins/acb0386c-09e4-4660-9571-1b941c584468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7a329fa4e2ae76cdbd2618dde8e707a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/28", "thumbnail_src": "https://si.imgix.net/81f79f3a/uploads/origins/54330ad5-279b-461a-9720-23cedea73bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6117c68773659646057ec6990f052541", "thumbnail_srcset": "https://si.imgix.net/81f79f3a/uploads/origins/54330ad5-279b-461a-9720-23cedea73bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6117c68773659646057ec6990f052541, https://si.imgix.net/81f79f3a/uploads/origins/54330ad5-279b-461a-9720-23cedea73bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ee7f64192b6c3c73d9c157a64ff6534 2x, https://si.imgix.net/81f79f3a/uploads/origins/54330ad5-279b-461a-9720-23cedea73bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c04fd4b9487381d3881017bb133307a2 3x", "genre": "art", "nsfw": false, "body": "Hello, I would like to request a portrait style drawing of my FFXIV character, Ruellia, as seen in one of your previous works: https://skeb.jp/@raisehaunk/works/11\n\nRuellia is a Viera with purple hair, red eyes, and dark blue facial tattoos. She has a reserved and quiet personality but cares deeply for her loved ones. I have provided references in the link.\n\nI will leave the pose and expression up to you. Thank you for your consideration.\n\nhttps://drive.google.com/drive/folders/1kJSobi5OdPnrkelWZBXwc9OJovqYTUTB", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/27", "thumbnail_src": "https://si.imgix.net/62c6a3e1/uploads/origins/edb4b163-4b86-46f3-b631-fb16a210f96d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9d55412fa260a0e0d9fce665ec6b0c", "thumbnail_srcset": "https://si.imgix.net/62c6a3e1/uploads/origins/edb4b163-4b86-46f3-b631-fb16a210f96d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9d55412fa260a0e0d9fce665ec6b0c, https://si.imgix.net/62c6a3e1/uploads/origins/edb4b163-4b86-46f3-b631-fb16a210f96d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de25910d13632b25763784a731dd2af3 2x, https://si.imgix.net/62c6a3e1/uploads/origins/edb4b163-4b86-46f3-b631-fb16a210f96d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d021de16b9c4dc75667020c10d561b81 3x", "genre": "art", "nsfw": false, "body": "It is a pleasure to meet you. I always look forward to seeing your illustrations.\nI love the people you draw, especially their beautiful faces...!\nIf it is possible, I would like to use this character...?\n\nPlease contact me if possible....\nhttps://drive.google.com/drive/folders/1-lw42mjyAg4WyXtk-uznCSa259KBZQoF\nShe is a cyborg woman who always acts aloof and smiles, and is good at agitating people. (The right half of her body is prosthetic eye and limb. Under the one wearing the mask, the prosthetic eye is broken.) Deep down, she is cautious and has a stubborn side that does not trust others easily. He is in his early 20s.\nHe is in his early 20s.\n\nThere are two patterns: one with her hair flowing to the side and the other with her hair in a half up-do.\nWe would be happy if you could draw her face, so you can remove her hat and other decorations if you like!\nAnyway, we would appreciate it if you could arrange it in a way that makes it easier to draw.\n\nI know this is a very impolite request, so please cancel if the price is not reasonable. I would appreciate it if you could at least consider my request.\n\nhttps://drive.google.com/drive/folders/1-lw42mjyAg4WyXtk-uznCSa259KBZQoF", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/26", "thumbnail_src": "https://si.imgix.net/3ba60cf9/uploads/origins/05183f80-ae5e-4eff-8461-56f2a3a56ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfdb5d7b0890f2d9ee02666731095799", "thumbnail_srcset": "https://si.imgix.net/3ba60cf9/uploads/origins/05183f80-ae5e-4eff-8461-56f2a3a56ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfdb5d7b0890f2d9ee02666731095799, https://si.imgix.net/3ba60cf9/uploads/origins/05183f80-ae5e-4eff-8461-56f2a3a56ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=099b6e88fb1ad6bbcfcb43abb54a5e02 2x, https://si.imgix.net/3ba60cf9/uploads/origins/05183f80-ae5e-4eff-8461-56f2a3a56ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a35cd878c662dc61ea1365b147ab1fea 3x", "genre": "art", "nsfw": false, "body": "Hello, I really love your art style! I hope you accept this request if you have time. I'd like you to draw Thoma and Yoimiya together from Genshin Impact. I want you to base it from the Sweets Paradise collaboration. I have uploaded everything in the folder for your references including the pose that I want. \n\nHere are some artworks from other artists with the same concept for you to have an idea what they look like. \nhttps://twitter.com/tamaya_yoi/status/1562128132647178241?s=20&t=fa66HMSvfVwg7U6tPPjeVg\nhttps://twitter.com/nanguatou4/status/1564552497603022848?t=8jQyys80tbw2EmBIskOhpw&s=19\nhttps://twitter.com/bobateadango/status/1565470746440536064?s=20&t=adrWd1iuF-fvUlj7SNkoLQ\n\nI also want you to put a simple background that will suit the theme. Maybe you can use black or any color and put gold butterflies or stars. It's up to you to choose that will look good on the art. Thank you so much!\n\nhttps://drive.google.com/drive/folders/1WyF8CNpyx3XXGS4I1tx6ftAwuyVbmgAv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/25", "thumbnail_src": "https://si.imgix.net/09e749c7/uploads/origins/ef484caa-afce-4026-be3a-33539bec45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04f9c2bd099e964a5e18172b6799182", "thumbnail_srcset": "https://si.imgix.net/09e749c7/uploads/origins/ef484caa-afce-4026-be3a-33539bec45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04f9c2bd099e964a5e18172b6799182, https://si.imgix.net/09e749c7/uploads/origins/ef484caa-afce-4026-be3a-33539bec45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ca543f52ff092d474a0401ecbf963d4 2x, https://si.imgix.net/09e749c7/uploads/origins/ef484caa-afce-4026-be3a-33539bec45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5103a662db51c6549728512af1268ca9 3x", "genre": "art", "nsfw": false, "body": "Hello Dr. Ma, my name is Urui. Thank you very much for your very nice illustration the other day. I look at it every day and feel happy...!\nI would like to make another request using the original character you drew last time. The appearance of the character should be the same.\n\nPose: I would like a smiling expression with her elbows on the armrests of a desk or chair, with cheekbones, but with a somewhat sexy impression.\nClothing: Over a white or black tank top, a slightly sporty hoodie is worn open in the front with the shoulders down (one shoulder down or both shoulders down, we leave it to you). The hoodie is mainly in cold colors and the design is left up to you. The skin on the shoulders is visible and looks a little sexy.\nNails are painted black.\nShe wears earrings, necklace, and rings as silver accessories. We will leave it to the teacher's taste.\n\nShe is a beautiful, neutral female (often mistaken for a handsome man. She looks about 21 years old. She should not have breasts for the illustration. Shoulders should not be too broad.)\nShe has a cat-like image and fair skin.\nHer hair color is black to dark purple, and it is long enough to cover one eye.\nEye color: clear purple. She has long eyelashes (with lower lashes).\nHer personality is fresh and aloof, with an occasional bewitching expression.\n\nWe are planning to distribute her in the future and would be happy to use her as an icon or background for distribution.\n\nThank you in advance for your time.", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/24", "thumbnail_src": "https://si.imgix.net/68eb713e/uploads/origins/07321631-890d-4e48-8433-bb41a7dd6d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5640de2ec916aec697f585b6fa22105c", "thumbnail_srcset": "https://si.imgix.net/68eb713e/uploads/origins/07321631-890d-4e48-8433-bb41a7dd6d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5640de2ec916aec697f585b6fa22105c, https://si.imgix.net/68eb713e/uploads/origins/07321631-890d-4e48-8433-bb41a7dd6d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71eed03a50469a847dc85acc57625b8b 2x, https://si.imgix.net/68eb713e/uploads/origins/07321631-890d-4e48-8433-bb41a7dd6d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a7ac4531f36005ba811228f189fb494 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you!\nMy name is Kanou, and I am the management support person for an individual artist named \"Raise\".\n\nI am an 18-year-old female singer who is trying her best in her music career.\nShe has not released any proper works on the Internet yet, so she is no different from ordinary people.\nHowever, she has a very wonderful voice and charm, and she has been approached by many people in the music industry, and we would like to start a full-fledged activity.\nWe would like to ask \"Numa,\" who has been a big fan of Kurose herself, if she would be willing to write an illustration to be used as an icon for our project.\n\nIf you accept, please use the following URL as a starting point\nIf you accept, would it be possible to use the following URL photo as a basis for your request?\n\nThank you very much for your consideration.\n\n＝＝＝＝＝＝\nKanou\nj_kanou@ve.jvcmusic.co.jp\n＝＝＝＝＝＝\n\nhttps://www.dropbox.com/s/aw0c0y0xg8yt6nt/S__30588934.jpg?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/23", "thumbnail_src": "https://si.imgix.net/9bb0eca3/uploads/origins/e461c83d-b1ac-458c-93b9-c2d365771477?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e629b3c693b30210a9738d3a7cc457bf", "thumbnail_srcset": "https://si.imgix.net/9bb0eca3/uploads/origins/e461c83d-b1ac-458c-93b9-c2d365771477?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e629b3c693b30210a9738d3a7cc457bf, https://si.imgix.net/9bb0eca3/uploads/origins/e461c83d-b1ac-458c-93b9-c2d365771477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18712f89dd93fa0b8e4e0f57c93be37a 2x, https://si.imgix.net/9bb0eca3/uploads/origins/e461c83d-b1ac-458c-93b9-c2d365771477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8efcc4b057cd99eb86803128f5a0a6b 3x", "genre": "art", "nsfw": false, "body": "Hello!\n\nCan you draw my friend's vtuber Ran (https://twitter.com/rancchu/status/1556049086209728512/photo/1) in this outfit and pose (https://drive.google.com/drive/folders/1lCqu4peokMba-qKUravYVXqkq-iSQxFz?usp=sharing), and my vtuber Chai (https://twitter.com/reixuu/status/1507902721608740866/photo/1) in this outfit and pose (https://drive.google.com/drive/folders/18QZXWz9MtKzFBGX2ZfUxUI56ftY4yjlW?usp=sharing)\n\nThank you!!", "created_at": "", "completed_at": ""}, {"path": "/@raisehaunk/works/22", "thumbnail_src": "https://si.imgix.net/5e2c2093/uploads/origins/94916b00-6832-449c-8136-cff5842f6e56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e763fdafbecf20101acf58648c394351", "thumbnail_srcset": "https://si.imgix.net/5e2c2093/uploads/origins/94916b00-6832-449c-8136-cff5842f6e56?bg=%23fff&auto=form