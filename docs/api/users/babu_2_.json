/si.imgix.net/10404ea6/uploads/origins/819c883b-bb18-46b0-93a7-b30374f084bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c945abc15e1017162f525fac268d9a22 2x, https://si.imgix.net/10404ea6/uploads/origins/819c883b-bb18-46b0-93a7-b30374f084bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3889c18046b6fe86568b7ff1b8dce45 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@babu_2_/works/65", "thumbnail_src": "https://si.imgix.net/be8ec873/uploads/origins/bd3de2ee-3add-45e6-9cdf-51b5dfa61779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb687ab4207fa9719a3cea5837712c91", "thumbnail_srcset": "https://si.imgix.net/be8ec873/uploads/origins/bd3de2ee-3add-45e6-9cdf-51b5dfa61779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb687ab4207fa9719a3cea5837712c91, https://si.imgix.net/be8ec873/uploads/origins/bd3de2ee-3add-45e6-9cdf-51b5dfa61779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b6e7af90b1ffcfb0d9f9a10381961bf 2x, https://si.imgix.net/be8ec873/uploads/origins/bd3de2ee-3add-45e6-9cdf-51b5dfa61779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8d7bee189851965a9dd46c12029a587 3x", "genre": "art", "nsfw": false, "body": "はじめまして！あんず様のイラストを拝見させていただき、ぜひ自宅キャラの立ち絵を描いていただきたいと思い、リクエストさせていただきました！\n戦国時代の武将様で、戦乱の世に在る存在としての儚さと強さを感じられるような雰囲気だと嬉しいです！\n\n瞳の色はオレンジ色で、クールな表情が多いです！\n\nまた、当方個人使用でアクスタなどを作りたいと考えているのですが、よろしいでしょうか？？ぜひ御検討よろしくお願いします！\n\nhttps://x.com/mt_tk_sm/status/1973950751606255996?s=46&t=cgXjYXhD-eWunszVwzFGmw", "created_at": "", "completed_at": ""}, {"path": "/@babu_2_/works/64", "thumbnail_src": "https://si.imgix.net/8510c172/uploads/origins/0de54af3-fe1e-4e00-bdf