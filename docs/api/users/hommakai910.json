62d29a/uploads/origins/f9d7282a-00ea-4f66-9d0f-1c1823f43003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ba2c3cc7a385048e6b0fafb05f10e8", "thumbnail_srcset": "https://si.imgix.net/2462d29a/uploads/origins/f9d7282a-00ea-4f66-9d0f-1c1823f43003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ba2c3cc7a385048e6b0fafb05f10e8, https://si.imgix.net/2462d29a/uploads/origins/f9d7282a-00ea-4f66-9d0f-1c1823f43003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65219a2c13e9e3d03fc91f776921b32f 2x, https://si.imgix.net/2462d29a/uploads/origins/f9d7282a-00ea-4f66-9d0f-1c1823f43003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19e5cc9f114a070905642ed1bdaee1f3 3x", "genre": "art", "nsfw": false, "body": "水星の加護を受けた愛と正義のセーラー服美少女戦士が、牛丼屋のカウンターで姿勢正しく牛丼を食べているイラストをお願いします。\nミニスカセーラーレオタードの中学生が格好に何ら恥じること無く、そこに居て食事をしているのが当然であると言う雰囲気のイラストです。\n見るからに育ちの良さがわかる正しい姿勢で凛とした佇まいで居る彼女を、となりのカウンターの席からまじまじと眺めている構図でお願いします。\n変にポーズを取ったりせず、自然に食事中のセーラー服美少女戦士をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hommakai910/works/23", "thumbnail_src": "https://si.imgix.net/ae00726c/uploads/origins/cdbda7d9-de37-4c92-b0fd-7da7e9feccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d2780399ed86dea13f093fef89384ab", "thumbnail_srcset": "https://si.imgix.net/ae00726c/uploads/origins/cdbda7d9-de37-4c92-b0fd-7da7e9feccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d2780399ed86dea13f093fef89384ab, https://si.imgix.net/ae00726c/uploads/origins/cdbda7d9-de37-4c92-b0fd-7da7e9feccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97c5