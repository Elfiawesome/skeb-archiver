4-8cdc-5f0c78d77da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f415c31b9b7d489b379f703b52586cc7", "thumbnail_srcset": "https://si.imgix.net/a5efb42c/uploads/origins/ad58d9c8-5428-4ed4-8cdc-5f0c78d77da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f415c31b9b7d489b379f703b52586cc7, https://si.imgix.net/a5efb42c/uploads/origins/ad58d9c8-5428-4ed4-8cdc-5f0c78d77da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ee9b4f4fd526a1459cfc8592c6f1686 2x, https://si.imgix.net/a5efb42c/uploads/origins/ad58d9c8-5428-4ed4-8cdc-5f0c78d77da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c9953a26019376b9d1ef6182e839565 3x", "genre": "art", "nsfw": true, "body": "うちの子(PSO2:NGS)のNSFWイラストをリクエストさせてください！\n●シチュエーション\n垂れ気味柔らかおっぱいが自慢の新米爆乳アークス。\n戦闘が不得手な彼女は唯一の武器を使って、先輩アークス達にご奉仕することに。\n『おっぱいメチャクチャにしてください♡』\n掲示板にそんな書き込みをして痴漢されるのを待つが、気分をあげるため服用していた媚薬の効果が強すぎて…軽く弄られただけでもイキまくってしまう。\n●内容\n・見ず知らずの♂アークスに、背後からおっぱい痴漢♡胸弄り\n・横乳から服の中に手を入れられ、乳首を容赦なくシコシコと責め扱かれる。\n・イッてもイッても執拗に乳首責め。集中攻撃。やめてと懇願するが、書き込み通りメチャクチャに。\n・イク度に扱く速さが増していき、アヘ顔や喘ぎはどんどん酷く。最終的には白目剥きかけ舌を伸ばしてびゅうううっと射乳イキ（媚薬の副作用）\n…こんな感じで、乳（乳首）責めに特化したイラストをお願いします！\n\nhttps://imgur.com/a/fQOo9SR", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/88", "thumbnail_src": "https://si.imgix.net/86320f79/uploads/origins/697fb628-466a-4b40-a244-2aaa717e8adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d0236f4f7d5f7fea2ac4f70140cf39", "thumbnail_srcset": "https://si.imgix.net/86320f79/uploads/origins/697fb628-466a-4b40-a244-2aaa717e8adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d0236f4f7d5f7fea2ac4f70140cf39, https://si.imgix.net/86320f79/uploads/origins/697fb628-466a-4b40-a244-2aaa717e8adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=333e0ff73b6c0709458e7786d07d1520 2x, https://si.imgix.net/86320f79/uploads/origins/697fb628-466a-4b40-a244-2aaa717e8adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47fb36854e995434e4eac23f3d4f9357 3x", "genre": "art", "nsfw": true, "body": "だつゆる様。\nいつもお世話になっております。\n早速依頼をさせて頂きます。\n\n御城プロジェクトのアーケシュフース城をお願い致します。\n\n恋人繋ぎをしながらの膝上パイズリをお願い致します。\n腕で胸を寄せ、胸がハートの形に押し上げられるようお願い致します。\n胸の大きさは頭2.5個分程度の超乳にお願い致します。\n\nご検討宜しくお願い致します。\n\nhttps://m.imgur.com/a/KI0gYLX", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/87", "thumbnail_src": "https://si.imgix.net/1f0cd0e8/uploads/origins/610b08d5-32ea-4012-8e5d-e9e88f016058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ae56b217db76a6d38107c512cde727", "thumbnail_srcset": "https://si.imgix.net/1f0cd0e8/uploads/origins/610b08d5-32ea-4012-8e5d-e9e88f016058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ae56b217db76a6d38107c512cde727, https://si.imgix.net/1f0cd0e8/uploads/origins/610b08d5-32ea-4012-8e5d-e9e88f016058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df37fbe2445008221cc931989b499a89 2x, https://si.imgix.net/1f0cd0e8/uploads/origins/610b08d5-32ea-4012-8e5d-e9e88f016058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c0333c9289dc360822b929a3300bf47 3x", "genre": "art", "nsfw": true, "body": "こんにちは\nガンダムOOのルイスのアメスクイラストを御願いします。\n\n・髪型は二期の頃のショートカットに一期の髪飾り付きで御願いします。\n\n・おっぱいは爆乳盛りでお尻も大きく盛ってください。\n\n・左腕の傷痕と左手薬指に指輪を御願いします。\n\n・お腹（だいたい子宮辺りの位置）に淫紋（イノベイドの改造で刻まれた設定でイノベイターモードに反応して光る仕様）を御願いします。\n\n・コスチュームはガンダムOOのMA「レグナント」のカラーリングでヘソだしルックで御願いします。\n\n・シチュエーションは沙慈とのデートで、デート中沙慈が女性に話しかけられそれを見ていて嫉妬したルイスが沙慈を路地裏に連行しヤンデレ気味な感じで壁ドン風に詰め寄り、説得しようとする沙慈の唇をディープキス気味に奪う流れを御願いします。\n沙慈を問い詰めているときのルイスは瞳はイノベイターモードの金色で淫紋はピンク色に光っている様子で御願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/86", "thumbnail_src": "https://si.imgix.net/1e0b1859/uploads/origins/dc41d526-94a0-4712-9b71-7afe7e2bf4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5b394aecd5bb534989b1998cd46e9dd", "thumbnail_srcset": "https://si.imgix.net/1e0b1859/uploads/origins/dc41d526-94a0-4712-9b71-7afe7e2bf4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5b394aecd5bb534989b1998cd46e9dd, https://si.imgix.net/1e0b1859/uploads/origins/dc41d526-94a0-4712-9b71-7afe7e2bf4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c59efc08eeccab94cee2ced906c490de 2x, https://si.imgix.net/1e0b1859/uploads/origins/dc41d526-94a0-4712-9b71-7afe7e2bf4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=429099b89e65153986c817f2455eef25 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n東方projectの綿月豊姫の抱き枕カバーの裏表2枚のイラストを作って頂きたいです。(配布はせず個人制作です)\n\n☆全体\n・背景は白シーツに寝そべっている状態\n・身体つきは先日描かれましたく死を届ける頭巾娘さんくらい\n・帽子は外している\n\n☆表\n・服は原作と同じ\n・体がむちむちで服の上からでも体のラインがわかる\n・表情はほわんと笑っている\n・服が胸によってパンパンに膨らんでいるが服の破れはない(乳テント)\n・紫のスカートの切れ目からパンツの股の部分が少し見え、そこから生足も伸びてる\n・足は白い靴下or裸足\n\n☆裏\n・服は薄い紫のバニースーツとうさみみのカチューシャ\n・体より少し小さめのバニースーツを着ている\n・赤面しつつもこちらを煽る感じの表情\n・胸の片方はバニースーツからさらけ出ている(生乳)\n・腰あたりに原作服のベルトが緩く留められている\n・脚は白いタイツ\n・靴は履いてない\n\n上記の内容はできる限りで大丈夫です。\nまた印刷の関係で\n裏表各寸法、横540mm×縦1640mm\n解像度、　　300dqi以上\nカラー、　　CMYK\n形式、　　　psd。　　　　でお願いします。\n\n難しい依頼となりますがですがよろしくお願いします。\nぜひご一考くださいませ。\n\n※こちらの手違いで決算エラーが発生してしまったそうですので再度依頼させていただきました", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/85", "thumbnail_src": "https://si.imgix.net/6482290d/uploads/origins/a362b347-1e88-473d-92aa-06646a859145?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=485cea55e690c82b249635b864315bea", "thumbnail_srcset": "https://si.imgix.net/6482290d/uploads/origins/a362b347-1e88-473d-92aa-06646a859145?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=485cea55e690c82b249635b864315bea, https://si.imgix.net/6482290d/uploads/origins/a362b347-1e88-473d-92aa-06646a859145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36a79cc08e7087f83843679db618f34c 2x, https://si.imgix.net/6482290d/uploads/origins/a362b347-1e88-473d-92aa-06646a859145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4116adcd65dd93cd24b63968163928c 3x", "genre": "art", "nsfw": true, "body": "オルタンシアサーガに出てくる「嗜虐の女神」デュケーヌをリクエストします。\n囚人に捕らえられ、バンザイの体勢で拘束。\n強力な媚薬効果がある魔物の粘液（スライム的な）塗れにされた丸出しの胸をオナホのように使われながら、乳首を弄られ、白目むきかけの無様アヘ顔で何度も何度も絶頂している。\n母乳も噴き出し、まるで「被虐の雌牛」\nデュケーヌの名前をもじって「でけー乳（にゅう）」などと嘲笑われながら、身も心も堕とされていく様子を描いてもらいたいです。\nよろしくお願いします！\n\nhttps://www.youtube.com/watch?v=hzdz5GWUJAg", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/84", "thumbnail_src": "https://si.imgix.net/0ca7f5e2/uploads/origins/a7f173af-a5cd-4866-98b7-fa5ef79471ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd141a0ee0258e0df39a9ada7a0574f8", "thumbnail_srcset": "https://si.imgix.net/0ca7f5e2/uploads/origins/a7f173af-a5cd-4866-98b7-fa5ef79471ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd141a0ee0258e0df39a9ada7a0574f8, https://si.imgix.net/0ca7f5e2/uploads/origins/a7f173af-a5cd-4866-98b7-fa5ef79471ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06f3c3ac746c4fd802dbc30ca4172e06 2x, https://si.imgix.net/0ca7f5e2/uploads/origins/a7f173af-a5cd-4866-98b7-fa5ef79471ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13a655ce8c7762ff037b7497cd4338fa 3x", "genre": "art", "nsfw": true, "body": "「ソードアート・オンライン」の「ストレア」が、ディープキスしながら裸で抱き合って対面座位でハメているイラストをお願い致します。\n相手の男は特徴のないマネキンのようなデザインでお願いします。\nセリフは甘々(「種付けザーメン出す？出しちゃうの？いいよっ、子宮にぜーんぶブチ撒けて♡」など)で擬音もお願いします。\n胸のサイズ感などの体格は普段描かれているくらいでお願いします。\nもし可能であれば、ディープキスとは別に相手の頭を抱き抱えるようにして自分の胸に埋めさせている差分と、中出しされて逆流した精液が溢れ出ている差分、埋めさせて中出しの差分で、計4枚の差分があると大変嬉しいです。\nストレアの外見は公式サイトのリンクを貼っておきます。\n以上、どうかよろしくお願い致します。\n\nhttp://sao-hf.bngames.net/chara/stlea.php", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/83", "thumbnail_src": "https://si.imgix.net/900f4d10/uploads/origins/f73aec53-b78b-40cb-a597-79d98795d0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a6fb103bfc89bb1b081ce681d04c2f8", "thumbnail_srcset": "https://si.imgix.net/900f4d10/uploads/origins/f73aec53-b78b-40cb-a597-79d98795d0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a6fb103bfc89bb1b081ce681d04c2f8, https://si.imgix.net/900f4d10/uploads/origins/f73aec53-b78b-40cb-a597-79d98795d0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68590db5394d6c5b47d34cda50385db9 2x, https://si.imgix.net/900f4d10/uploads/origins/f73aec53-b78b-40cb-a597-79d98795d0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5543655c3347260fd0a5e19a026d635 3x", "genre": "art", "nsfw": true, "body": "対魔忍ユキカゼの水城不知火をお願いします。\n\nシチュエーション\n日中に大きな窓ガラスに身体を押し付けての立ちバック。ガラス越しの視点。\n\n服装\n対魔忍スーツ。胸は露出。\n\n身体・表情\n黒乳輪にモントゴメリー腺。デカ乳首にはバーベル型のニップルピアス。\n胸の大きさはおまかせで大きくしていただいてOKです。\n濃いめの脇毛と陰毛。\n表情は白目をむいたアヘ顔。\n\n構図\n不知火は窓ガラスの額縁に立っており下品なガニ股、男は額縁の一段下から挿入。\n股間の部分の窓ガラスには、飛び散った潮や精液が流れる跡がついている。\n突き出した舌も窓ガラスにつけて、涎が窓ガラスに垂れている。\n胸が大きいので難しいと思いますが、可能な限り身体を窓ガラスに貼り付けるようにしてください。\n\nその他\nセリフもある場合は、外から大勢に見られて興奮しているようにしてもらえると嬉しいです。（その他のシチュエーションでも可）\n他に下品なセックスしている様になるようなシチュエーションがあれば、全ておまかせいたします。\n\nイメージサンプル\nhttps://www.pixiv.net/artworks/87161690\nhttps://www.pixiv.net/artworks/76182985", "created_at": "", "completed_at": ""}, {"path": "/@_____yttrium39/works/82", "thumbnail_src": "https://si.imgix.net/ebf74f4c/uploads/origins/90d3e0ff-b899-4833-81d4-04d87459b80b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6100c9337d7775d842fa405dea7d7cf8", "thumbnail_srcset": "https://si.imgix.net/ebf74f4c/uploads/origins/90d3e0ff-b899-4833-81d4-04d87459b80b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6100c9