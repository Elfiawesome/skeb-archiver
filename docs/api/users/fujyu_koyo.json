0e-55f2037a4ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3261b6f3d3605087dc79c1e745b01d", "thumbnail_srcset": "https://si.imgix.net/c44d402b/uploads/origins/e9936d21-f0bd-4c5a-ba0e-55f2037a4ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3261b6f3d3605087dc79c1e745b01d, https://si.imgix.net/c44d402b/uploads/origins/e9936d21-f0bd-4c5a-ba0e-55f2037a4ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=362074dc3eae00ae5605b18d961277bc 2x, https://si.imgix.net/c44d402b/uploads/origins/e9936d21-f0bd-4c5a-ba0e-55f2037a4ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=574aad6cff74c77e1d94755492922a3a 3x", "genre": "art", "nsfw": false, "body": "百獣戦隊ガオレンジャーより『もし大河冴がウラ究極体の妻（もしくは花嫁）になってしまったら』というIFをお願いします。\n仕様・差分はhttps://skeb.jp/@fujyu_koyo/works/145と同じでお願いします。\n参考なまでに前回依頼した通常のウラが以下のものです。\nhttps://skeb.jp/@fujyu_koyo/works/87", "created_at": "", "completed_at": ""}, {"path": "/@fujyu_koyo/works/171", "thumbnail_src": "https://si.imgix.net/27e4c190/uploads/origins/9ddc2711-5a78-4c27-b6e0-ff15d900fea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b966a43fb37d8cf95455f5e252144b8a", "thumbnail_srcset": "https://si.imgix.net/27e4c190/uploads/origins/9ddc2711-5a78-4c27-b6e0-ff15d900fea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b966a43fb37d8cf95455f5e252144b8a, https://si.imgix.net/27e4c190/uploads/origins/9ddc2711-5a78-4c27-b6e0-ff15d900fea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96211181c284d4cb37011212e1448f5c 2x, https://si.imgix.net/27e4c190/uploads/origins/9ddc2711-5a78-4c27-b6e0-ff15d900fea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eb3eae8d03167b1548a83db0e56cb67 3x", "genre": "art", "nsfw": false, "body": "ふうじゅさん、お久しぶりです。ryoubonです。いつも特撮関連の素晴らしいイラストを拝見させていただいています。\n今日はリクエストをお願いに上がりました。\n\n『仮面ライダーIF』\n（novel/5441961）\n\n私が書いたものですが、この作品の設定では、初代仮面ライダーのヒロイン、緑川ルリ子が蜂女に改造され、後に仮面ライダーのパートナーとして戦うヒロインになるという小説ですが、この女性ライダーとなった蜂女ルリ子を、描いて頂けますか。\n参考にですがいままで他の人に描いてもらった物です。\n\n（https://www.pixiv.net/artworks/120650634）\n（https://www.pixiv.net/artworks/120112504）\n（https://www.pixiv.net/artworks/103969592）\n\nこの蜂女ライダーのビジュアルは平成令和の女性ライダーのように、蜂女をリスペクトしつつも、セクシーで美しいオリジナル女性仮面ライダーを脳内でイメージしていますが、細かいデザインはふわっとしているので、デザインはお任せします。\nふうじゅさんのセンスと情熱が赴くままに描いてもらって構いません。\nポージングや構図も全面的にお任せします。\n可能でしたら、差分で変身前の緑川ルリ子さんのイラストをお願い致します。\n\n\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@fujyu_koyo/works/170", "thumbnail_src": "https://si.imgix.net/26c6cc4c/uploads/origins/12357e59-96cc-4d9b-b977-f5d36577f9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed544a5e19471d1e893ceee389f79cc2", "thumbnail_srcset": "https://si.imgix.net/26c6cc4c/uploads/origins/12357e59-96cc-4d9b-b977-f5d36577f9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed544a5e19471d1e893ceee389f79cc2, https://si.imgix.net/26c6cc4c/uploads/origins/12357e59-96cc-4d9b-b977-f5d36577f9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12fc21189f81142ff706bb2383739f45 2x, https://si.imgix.net/26c6cc4c/uploads/origins/12357e59-96cc-4d9b-b977-f5d36577f9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92e83d105e5b3a2f15ad4802c51198c5 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n特撮ヒーローのかっこいいイラスト作品、見させて頂いております。\nスーパーヒーロータイムも、いつも楽しく見ております。\n\n同じ特撮で、『海賊戦隊ゴーカイジャー』から7人目の追加戦士（ゴーカイジャーの仲間）の変身後・武器のイラストのリクエストをお願い致します。\n\n■設定\n名前：ゴーカイブラック\n外見：https://www.medicomtoy.co.jp/prod/dt/23/25/5479.html\nスーツカラー：黒\n\n■武器\nゴーカイセイバー(片手剣)&ゴーカイマグナム(拳銃)\n\n■構図\nhttps://skeb.jp/@fujyu_koyo/works/163\n上の画像のような、かっこいい立ちポーズで、ゴーカイセイバーを右手に、ゴーカイマグナムを左手に持ち、全身が見える感じでお願い致します。\n\n■概要\n元赤き海賊団の一員で、キャプテン・マーベラスの友人。\n\n可能でしたら、差分で変身前のイラストをお願い致します。\n\n■変身前\n名前：ジャン・ログナ\n容姿：20歳くらい。顔はイケメン。黒のセミショートヘア。黒茶色の瞳。海賊風の服、帽子と眼帯は無し、白いYシャツ、黒いベスト、黒いロングコート、黒ジーンズ、黒いブーツ着用。\n性格：クールなキャラ\n\nリクエストは以上でよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@fujyu_koyo/works/169", "thumbnail_src": "https://si.imgix.net/99cae0e3/uploads/origins/30cf4ad4-f9d0-4391-9276-faee61817734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0db1e0d118627bf0306eb91ea216e31", "thumbnail_srcset": "https://si.imgix.net/99cae0e3/uploads/origins/30cf4ad4-f9d0-4391-9276-faee61817734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0db1e0d118627bf0306eb91ea216e31, https://si.imgix.net/99cae0e3/uploads/origins/30cf4ad4-f9d0-4391-9276-faee61817734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7a8bb2bf6afbe2937dcdea70efe1597 2x, https://si.imgix.net/99cae0e3/uploads/origins/30cf4ad4-f9d0-4391-9276-faee61817734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f86ac67c0ee2f3640f64f74f944fb140 3x", "genre": "art", "nsfw": false, "body": "シャチモチーフの戦隊ブルーを依頼した者です。イラストの完成ありがとうございます。\nシャチモチーフの戦隊ブルーが怪人化したイラストをお願いします。\n戦隊ブルーの面影を残しつつ禍々しい姿、胸は一回り大きく、グローブとブーツは黒のラバーのニーハイグローブにニーハイピンヒールブーツ", "created_at": "", "completed_at": ""}, {"path": "/@fujyu_koyo/works/168", "thumbnail_src": "https://si.imgix.net/93aa3a18/uploads/origins/0a8a62d7-137a-426d-a256-75cf41fc5169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=150d8f0feca2e873f8c6755c76b57291", "thumbnail_srcset": "https://si.imgix.net/93aa3a18/uploads/origins/0a8a62d7-137a-426d-a256-75cf41fc5169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=150d8f0feca2e873f8c6755c76b57291, https://si.imgix.net/93aa3a18/uploads/origins/0a8a62d7-137a-426d-a256-75cf41fc5169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24e7340b9dfa5530be7eda66c44f1c93 2x, https://si.imgix.net/93aa3a18/uploads/origins/0a8a62d7-137a-426d-a256-75cf41fc5169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fac86d1429097ed137c5578fcc39933 3x", "ge