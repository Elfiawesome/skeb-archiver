ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2ed9cb0afbaff154f17aa23225db5b9", "thumbnail_srcset": "https://si.imgix.net/04066eb3/uploads/origins/5422f8d2-f4f1-49f1-95f2-f338ee79a332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2ed9cb0afbaff154f17aa23225db5b9, https://si.imgix.net/04066eb3/uploads/origins/5422f8d2-f4f1-49f1-95f2-f338ee79a332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7811ce245986198b8ff5b20a975b4796 2x, https://si.imgix.net/04066eb3/uploads/origins/5422f8d2-f4f1-49f1-95f2-f338ee79a332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cc27b015e6c4cfe2208a9b2f5f985a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KrKrGzGz/works/133", "thumbnail_src": "https://si.imgix.net/c835c0c1/uploads/origins/b662acaf-677f-402f-afca-436d62ed614e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f291b2106642561e80231278a8187a8", "thumbnail_srcset": "https://si.imgix.net/c835c0c1/uploads/origins/b662acaf-677f-402f-afca-436d62ed614e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f291b2106642561e80231278a8187a8, https://si.imgix.net/c835c0c1/uploads/origins/b662acaf-677f-402f-afca-436d62ed614e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c489bdf093327c80311d7f5aeb105b39 2x, https://si.imgix.net/c835c0c1/uploads/origins/b662acaf-677f-402f-afca-436d62ed614e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=915e3694e6e36fd38db85763a8b4f342 3x", "genre": "art", "nsfw": false, "body": "初めまして。KIRAAAAA先生の素敵なイラストに一目惚れし、是非イラストをお願いしたくリクエストを送らせていただきました。CoCTRPGの探索者であるOC２人の一枚絵をお願いしたく思います。\n\nシナリオ…「ようこそ！迷冥市役所都市伝説課へ！」\n関係性…先輩後輩/唯一無二\n\n【骸彼岸】…都市伝説課の先輩。荒っぽく眉間に皺を寄せていることが多い。貂から先生と呼ばれとても慕われている。\n骸骨面/195cm/筋肉質\n【貂】…都市伝説課の後輩。優しい性格だが勇気があり勇敢。先輩のことを慕っており懐いている。\n般若面/185cm/細マッチョ\n\n\n使用用途ですが、SNSアイコン、PC・スマホの壁紙、個人鑑賞の範囲内で非営利目的のグッズ化などで使わせていただきたいです。\n（友人から使用許可は頂いております。）\nグッズ化 例：シール、アクリルキーホルダー、アクリルスタンド、ポストカード、キャンバス…etc\n\n\n構図、表情、背景（シーン）はおまかせします。\n怪奇な雰囲気が加えられたKIRAAAAA先生らしいイラストに仕上げて頂けたら大変嬉しいです。\n何卒ご検討よろしくお願いします。\n\n（資料）\n\nhttps://drive.google.com/drive/folders/1RceDdkGXZVoSLZdAnu7o_9Y5zOgHyf4C", "created_at": "", "completed_at": ""}, {"path": "/@KrKrGzGz/works/132", "thumbnail_src": "https://si.imgix.net/29ae66e4/uploads/origins/e1c8cacf-329c-485b-be90-4c5f31c7d152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08d32b9cd535905a5f7f60b5c094c348", "thumbnail_srcset": "https://si.imgix.net/29ae66e4/uploads/origins/e1c8cacf-329c-485b-be90-4c5f31c7d152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08d32b9cd535905a5f7f60b5c094c348, https://si.imgix.net/29ae66e4/uploads/origins/e1c8cacf-329c-485b-be90-4c5f31c7d152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eb7de820ad6c5a91fb314b974c541c9 2x, https://si.imgix.net/29ae66e4/uploads/origins/e1c8cacf-329c-485b-be90-4c5f31c7d152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5f6dc8a70952fce440f9376dffb4352 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのページを見つけ、あなたの過去の仕事が大好きです！私のVtuberのイラストをお願いします。\n\n彼はとても自惚れ屋で、からかうのが好きです。\nペットのダンボ・タコも一緒にお願いします。\n\nイラストのフォーカスはお任せします。構図も自由です。絵柄は自由です。依頼を検討していただき、ありがとうございました。\n\n\nキャラクター参考：https://drive.google.com/drive/folders/1-dDpRp-vy4mjx30jrBcLb0tcfB_UbqT6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@KrKrGzGz/works/131", "thumbnail_src": "https://si.imgix.net/840b2e9e/uploads/origins/2afd5ce0-f72f-4582-8485-9c263b1f02b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006c86ccaaabcdf3c9a4b9792381a1bd", "thumbnail_srcset": "https://si.imgix.net/840b2e9e/uploads/origins/2afd5ce0-f72f-4582-8485-9c263b1f02b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006c86ccaaabcdf3c9a4b9792381a1bd, https://si.imgix.net/840b2e9e/uploads/origins/2afd5ce0-f72f-4582-8485-9c263b1f02b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2cf0001b5243d56f7c1acac8ef213b0 2x, https://si.imgix.net/840b2e9e/uploads/origins/2afd5ce0-f72f-4582-8485-9c263b1f02b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f3782e14f5f32f29915780a82deded8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのイラストの色使いが本当に素敵です！こちらは私の子犬キャラで、とても従順で幸せそうな子です :)。構図はお任せしますし、お好みで服を変えても構いません :)（ただし可能であれば、首輪は残していただけると嬉しいです）\n\nhttps://drive.google.com/drive/u/0/folders/1YhWRcBoeMmGzMpUo8w-zpBIGS7IMl52E", "created_at": "", "completed_at": ""}, {"path": "/@KrKrGzGz/works/130", "thumbnail_src": "https://si.imgix.net/82c7fdea/uploads/origins/245c791b-e4f2-4dbf-a259-ad3c341a48c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5c0ed7a0eab40bd40cc12033212d0dc", "thumbnail_srcset": "https://si.imgix.net/82c7fdea/uploads/origins/245c791b-e4f2-4dbf-a259-ad3c341a48c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5c0ed7a0eab40bd40cc12033212d0dc, https://si.imgix.net/82c7fdea/uploads/origins/245c791b-e4f2-4dbf-a259-ad3c341a48c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2e898949cb8ca2049b2954b3c6e0aea 2x, https://si.imgix.net/82c7fdea/uploads/origins/245c791b-e4f2-4dbf-a259-ad3c341a48c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dde9a480955267bd9cf94135abecebbe 3x", "genre": "art", "nsfw": false, "body": "Hello! Your artwork is gorgeous and I would love to get in illustration of myself in yo