2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93ccfae20595cc3dbd31e8688163fc77 2x, https://si.imgix.net/f060e557/uploads/origins/2fb9b85d-2a94-4516-abcb-bb274927c7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9912e1f4e53fdddcfa60bc6383016851 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nよろしければ今回は強殖装甲ガイバーという漫画を基にしたオリジナル獣化兵（ゾアノイド）のアストラ（人間名アニー）のイラストをお願いします。\n\n獣化前（人間形態）と獣化後（獣人化形態）二枚でお願いします。内容はエロでも非エロでも大丈夫ですのでお任せします。\n獣化前後の構図を同じにしても大丈夫です（その場合獣化後は体から湯気が立っていて体は汗ばんだ状態でお願いします）。\n\n設定資料：\nhttps://imgur.com/a/MbrSmYw\n\nキャラの性格を参考したい場合の漫画（ふたなり物です）：\nhttps://www.pixiv.net/artworks/94561313\n\nNG:アヘ顔、ボテ腹、大小スカ、涙目（ギャグ系はok）、唇や鼻穴が目立つ描き方。\nご検討宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@senzoc/works/185", "thumbnail_src": "https://si.imgix.net/593a267f/uploads/origins/3a466817-a76a-497b-9626-ff3c527f4521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8b2855000832c2a01e49b17aa8d4ed", "thumbnail_srcset": "https://si.imgix.net/593a267f/uploads/origins/3a466817-a76a-497b-9626-ff3c527f4521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8b2855000832c2a01e49b17aa8d4ed, https://si.imgix.net/593a267f/uploads/origins/3a466817-a76a-497b-9626-ff3c527f4521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=783e9197384c09189841d87c6f0ef098 2x, https://si.imgix.net/593a267f/uploads/origins/3a466817-a76a-497b-9626-ff3c527f4521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c66c624678181b87496c590765d8339 3x", "genre": "art", "nsfw": true, "body": "うちの子のイラストをお願いします。\n下記URLのイラストのような感じで別レイヤーで断面図(フィニッシュ時)がほしいです。\nhttp://rukaruko.nekonikoban.org/src/img43.png\n参考画像は女性の顔が隠れていますが隠す必要はないです。\n場所は薄暗い部屋のベッドの上\n周りに大人のおもちゃが散らばっている状態\n\nキャラクター\n■えす　風俗バーの従業員\nhttps://rukaruko.nekonikoban.org/character/s/\n■店長 　風俗バーの店長\nhttps://rukaruko.nekonikoban.org/character/manager/\n\n複数の構図のため必要であれば値段の調整も可能です", "created_at": "", "completed_at": ""}, {"path": "/@senzoc/works/184", "thumbnail_src": "https://si.imgix.net/0db45fdf/uploads/origins/14a0c551-79cf-4315-aa15-699766d71128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdcca8711f9095b5ace5a6050d46e00c", "thumbnail_srcset": "https://si.imgix.net/0db45fdf/uploads/origins/14a0c551-79cf-4315-aa15-699766d71128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdcca8711f9095b5ace5a6050d46e00c, https://si.imgix.net/0db45fdf/uploads/origins/14a0c551-79cf-4315-aa15-699766d71128?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7be7eafe6ac4760790d8f5852c4542d 2x, https://si.imgix.net/0db45fdf/uploads/origins/14a0c551-79cf-4315-aa15-699766d71128?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2bfa2b4da7aaf41cfc71471472d6efd 3x", "genre": "art", "nsfw": true, "body": "うちの子キャンペーンと言う事で私のOCを依頼させて頂きたいと思います。\n\n資料の銀髪褐色メスガキギザ歯貧乳刺青ロリダークエルフのカティちゃんについて、\n着エロイメージビデオの如くあからさまな性器の露出などを行わずに消しが必要にならない範囲で、\nおっぱい露出はアリの挑発するようなスケベイラストをお願いいたします。\n衣装の種類や状態、シチュエーションなど細かい点はお任せいたします。\n\nご検討よろしくお願いいたします。\n\n\nご参考資料\nhttps://twitter.com/wagunasu_TS/status/1298940810973470720\n\nhttps://drive.google.com/file/d/11-x3uJDFhD9mjA1cAxHH7zxIn1D7cNbM/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@senzoc/works/183", "thumbnail_src": "https://si.imgix.net/424c66a6/uploads/origins/f58fd52a-a01c-4254-ae20-6c4616e8e47f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4499b08f05f87d2f02ca9217342e27c9", "thumbnail_srcset": "https://si.imgix.net/424c66a6/uploads/origins/f58fd52a-a01c-4254-ae20-6c4616e8e47f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4499b08f05f87d2f02ca9217342e27c9, https://si.imgix.net/424c66a6/uploads/origins/f58fd52a-a01c-4254-ae20-6c4616e8e47f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0871dde5990340ba300d9f42f76010e3 2x, https://si.imgix.net/424c66a6/uploads/origins/f58fd52a-a01c-4254-ae20-6c4616e8e47f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48255ce229a088623afcb3d0706c130c 3x", "genre": "art", "nsfw": true, "body": "はじめまして、可愛い絵柄に惹かれましてリクエストします。\n\n『アイドルマスターシンデレラガールズ』に登場する\n・城ヶ崎莉嘉\n・諸星きらり\n・赤城みりあ\nを描いていただきたいです。\nこの3人は凸レーションというユニットを組んでいます。\n\n\n肌が触れ合うくらいに身を寄せ合って3人が並んでおり、\nこちらから見て左に莉嘉、真ん中にきらり、右にみりあがいる構図です。\nイメージとしまして、せんぞく先生がXに上げられていたイラストのような感じです。\nhttps://x.com/senzoc/status/1564310538104217600/photo/1\nhttps://x.com/senzoc/status/1835029888233095432/photo/1\nhttps://x.com/senzoc/status/1961804629613977866/photo/1\n\n元気なキャラ達なので明るい表情で活発そうな様子でお願いします。\n\n衣装は布面積が少なめなビキニです。\n\n\nまた、可能であれば差分として\n・金色ビキニ\n・全裸\nを描いていただけますと嬉しく思います。\n\n何卒ご検討のほどよろしくお願いします。\n\n\n参考資料：\nhttps://imas.gamedbs.jp/cg/idol/detail/169?h=a289fc73aa922d84f7917c8eb21428e0\nhttps://imas.gamedbs.jp/cg/idol/detail/166?h=79455fc3b740c160d1c1dc6d652b551a\nhttps://imas.gamedbs.jp/cg/idol/detail/141?h=03160f702f45fbdd3c17d910d80306d6\n\nMV：https://www.youtube.com/watch?v=JoLyKY01a3A", "created_at": "", "completed_at": ""}, {"path": "/@senzoc/works/182", "thumbnail_src": "https://si.imgix.net/78dfb3a2/uploads/origins/4ba2f24c-dd60-4e55-b5d8-3f39bf0f064e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b81c51581e13b4a1d15869f60c39b688", "thumbnail_srcset": "https://si.imgix.net/78dfb3a2/uploads/origins/4ba2f24c-dd60-4e55-b5d8-3f39bf0f064e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b81c51581e13b4a1d15869f60c39b688, https://si.imgix.net/78dfb3a2/uploads/origins/4ba2f24c-dd60-4e55-b5d8-3f39bf0f064e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdd1e1fa7b734dd2d73df2ff399e084b 2x, https://si.imgix.net/78dfb3a2/uploads/origins/4ba2f24c-dd60-4e55-b5d8-3f39bf0f064e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c299db23d1e47215579ea7f3125c76ff 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムのエイリークのイラストをお願いします。\n\nベッドに座って脇の下を手で広げています。\n\n全裸です。口を閉じた笑顔がかわいいです。\n\n脇の下に精液がついたバリエーションも欲しい。\n\n太ももは見えるようにしてほしいです。よろしくお願いします！\n\nhttps://drive.google.com/drive/u/0/folders/19UtNyA1mfTMWrg5_zq5uGH3qb3g_RzDG", "created_at": "", "completed_at": ""}, {"path": "/@senzoc/works/181", "thumbnail_src": "https://si.imgix.net/8780a9c5/uploads/origins/d9abcf86-942b-47b2-b53d-c4120d74aa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3811b0a5af31b6aa57447838124c75c4", "thumbnail_srcset": "https://si.imgix.net/8780a9c5/uploads/origins/d9abcf86-942b-47b2-b53d-c4120d74aa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3811b0a5af31b6aa57447838124c75c4, https://si.imgix.net/8780a9c5/uploads/origins/d9abcf86-942b-47b2-b53d-c4120d74aa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=597a10dc68c4360a7167735fdde91c6e 2x, https://si.imgix.net/8780a9c5/uploads/origins/d9abcf86-942b-47b2-b53d-c4120d74aa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c37e7e83ab65cd2388a0da05a53d1a9f 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nクイズマジックアカデミーのルキア・ユウののおねショタセックスイラストをお願いします。\nhttps://p.eagate.573.jp/game/qma/17/world/detail.html?c=100\nhttps://p.eagate.573.jp/game/qma/17/world/detail.html?c=006\n\nルキアはこちらの水着で、ブラはずり上げ胸を露出し、下はずらして挿入させてください。\nhttps://x.com/QMA_staff/status/1049847249071616000\nユウは全裸です。\n\nこれらのイラストの男は夢中・女が楽しみつつもショタをしっかり気にかけ慈しんでる空気がとても素晴らしく、これに近い雰囲気にして頂きたいです。\nhttps://skeb.jp/@senzoc/works/156\nhttps://skeb.jp/@senzoc/works/175\n体位は背面側位で、ユウがルキアの腰にしがみついてピストンしている状態と胸を揉みながら絶頂している状態をお願いします。\nルキアもユウと同じタイミングで絶頂し、どのタイミングにおいても乳首は見える構図・体位としてください。\n胸はかなり盛って頂けると嬉しいです。\n\nご検討頂ければ幸いです。よろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@senzoc/works/180", "thumbnail_src": "https://si.imgix.net/e79f87fb/uploads/origins/76462199-10f6-428c-9b1a-16e842326ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f59e31457b9cd9081dae1f49350c68b2", "thumbnai