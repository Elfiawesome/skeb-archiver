%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=717124182a2ab2eddaa3fe9ecead0d3d, https://si.imgix.net/ce592b80/uploads/origins/1108c68a-f3e8-460d-8e2d-5cf4b926d1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb51151706f331f78120a0b084fb93cb 2x, https://si.imgix.net/ce592b80/uploads/origins/1108c68a-f3e8-460d-8e2d-5cf4b926d1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=042dc5e121e83259fdf3af0b35335d84 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mzumBB/works/47", "thumbnail_src": "https://si.imgix.net/b4f2e3bc/uploads/origins/3dba612f-8b8d-4d8f-b2d2-beb4736055ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c7d1ce48abc74c901c5163ef67d4638", "thumbnail_srcset": "https://si.imgix.net/b4f2e3bc/uploads/origins/3dba612f-8b8d-4d8f-b2d2-beb4736055ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c7d1ce48abc74c901c5163ef67d4638, https://si.imgix.net/b4f2e3bc/uploads/origins/3dba612f-8b8d-4d8f-b2d2-beb4736055ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97958e2467b03f18c78e5ef4d5fb048b 2x, https://si.imgix.net/b4f2e3bc/uploads/origins/3dba612f-8b8d-4d8f-b2d2-beb4736055ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1403902f8fd3266ed31ea16bbfeffbb7 3x", "genre": "art", "nsfw": true, "body": "お久しぶりになります！\n以前に私のメイクアバターである褐色肌ミヅキちゃんの依頼を引き受けて頂き、誠にありがとうございました！（https://skeb.jp/@mzumBB/works/30）\n今回もその褐色ミヅキちゃんのイラストをお願いしたいと思います。\n\nお題は『褐色ミヅキちゃん精液まみれ、抱き枕カバー風イラスト』です。\n\n以下、詳細になります。\n●ミヅキは前の依頼と同様に、濃い褐色・黒髪・ツインテール(前髪おろし)でお願いします。\n※念のため以前の依頼同様、参考URLを記載いたします。\n●ミヅキの恰好は全裸で「仰向け」と「うつ伏せ」でお願いします。\n両方とも、頭から足まで全身精液まみれの状態にしてください。\n●イラストは横並びにする形でも、2枚の差分にする形でも大丈夫です。\n●「仰向け」のイラストは、特に細かな指定はございません。\n頭の向き、腕や足の位置など、描きやすい内容で大丈夫です。\n●「うつ伏せ」のイラストは、足裏が見える構図でお願いします。\n\n以上になります。\n何卒、よろしくお願いいたします。\n\nhttps://game8.jp/pokemon_sun_moon/102019", "created_at": "", "completed_at": ""}, {"path": "/@mzumBB/works/46", "thumbnail_src": "https://si.imgix.net/78ecbe57/uploads/origins/e6a8bb27-5e63-4f57-b610-26470fe928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6210d0ff3b39f1abc8b5357cb2979d0", "thumbnail_srcset": "https://si.imgix.net/78ecbe57/uploads/origins/e6a8bb27-5e63-4f57-b610-26470fe928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6210d0ff3b39f1abc8b5357cb2979d0, https://si.imgix.net/78ecbe57/uploads/origins/e6a8bb27-5e63-4f57-b610-26470fe928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7f9743982683fb85445503af5b360d7 2x, https://si.imgix.net/78ecbe57/uploads/origins/e6a8bb27-5e63-4f57-b610-26470fe928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c433a7e1210184a069debca11aec488c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mzumBB/works/45", "thumbnail_src": "https://si.imgix.net/5aa046c9/uploads/origins/80bad767-00c1-4bcc-af53-b11db0f10493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d022f8e569b9ccd3b86f6fe5be4aa0bc", "thumbnail_srcset": "https://si.imgix.net/5aa046c9