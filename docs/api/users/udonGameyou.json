=30&txt=PRIVATE&s=4b03b34e5d39aa0db11d0c70b56a5442", "thumbnail_srcset": "https://si.imgix.net/21eaa678/uploads/origins/7180426d-e3cf-4bdf-8580-532077e596e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b03b34e5d39aa0db11d0c70b56a5442, https://si.imgix.net/21eaa678/uploads/origins/7180426d-e3cf-4bdf-8580-532077e596e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a1155b330fbb6679af7874930bba7fc 2x, https://si.imgix.net/21eaa678/uploads/origins/7180426d-e3cf-4bdf-8580-532077e596e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd9c107a12bca97252a2529e36034efe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/20", "thumbnail_src": "https://si.imgix.net/62217c2a/uploads/origins/fa3981dc-d9bc-405b-8ebf-3fb4bf37a0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f04715553ba028d9959f8fdfb1673b76", "thumbnail_srcset": "https://si.imgix.net/62217c2a/uploads/origins/fa3981dc-d9bc-405b-8ebf-3fb4bf37a0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f04715553ba028d9959f8fdfb1673b76, https://si.imgix.net/62217c2a/uploads/origins/fa3981dc-d9bc-405b-8ebf-3fb4bf37a0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7349a5cac127b6bda7f1d971a919ac55 2x, https://si.imgix.net/62217c2a/uploads/origins/fa3981dc-d9bc-405b-8ebf-3fb4bf37a0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=650f7e572e94ba81211db7853ef592b3 3x", "genre": "art", "nsfw": true, "body": "こんにちは！絵がかわいいので、私のキャラクター「にいりん」を描いてくれませんか？\n\nしっぽを描くのは任意ですが、もし描くならしっぽのないバージョンもお願いします：[https://cdn.imgchest.com/files/739cx288n27.png]\n\n画像はこの画像にインスパイアされたものを希望します：[https://cdn.imgchest.com/files/y2pckgnn9l7.jpg]\nこのマントを着せますが、ドレスと靴下と靴は下には着せないでください。上の首も短くしてください。[https://cdn.imgchest.com/files/7w6c2appmjy.png]\nこの画像のようなボディストッキングを着せてください：[https://cdn.imgchest.com/files/4jdcvlmmwb4.png]\n\nもし面倒でなければ、マントとボディストッキングを別々のレイヤーにして、着たり脱いだりできるようにしてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/19", "thumbnail_src": "https://si.imgix.net/f2e25a2d/uploads/origins/7bdec511-2ba5-4c16-afe5-490941655581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3320ad59d4c35c279d06ac3fccc11375", "thumbnail_srcset": "https://si.imgix.net/f2e25a2d/uploads/origins/7bdec511-2ba5-4c16-afe5-490941655581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3320ad59d4c35c279d06ac3fccc11375, https://si.imgix.net/f2e25a2d/uploads/origins/7bdec511-2ba5-4c16-afe5-490941655581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2c8df994ca01acdf0baa9292101d5d3 2x, https://si.imgix.net/f2e25a2d/uploads/origins/7bdec511-2ba5-4c16-afe5-490941655581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f36e00bda7023c559477f63b99fee43e 3x", "genre": "art", "nsfw": true, "body": "初めまして宝箱と申します\n可愛らしい絵柄と優しいタッチに惹かれました\n\n身体検査で服を脱がされる女の子のイラストをお願いします\n\n警備員の前で立ったまま局部を広げさせられて恥ずかしがっている構図でお願いします\n\n女の子の特徴は以下から自由に拾ってお任せでお願いします\n・貧乳\n・猫耳\n・銀髪\n\n問題があれば再送依頼をお願いします\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/18", "thumbnail_src": "https://si.imgix.net/938958ff/uploads/origins/e371348f-3f06-4ce1-b6c0-a2a507e8becd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d07c28fa45007785915f00b398237f3e", "thumbnail_srcset": "https://si.imgix.net/938958ff/uploads/origins/e371348f-3f06-4ce1-b6c0-a2a507e8becd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d07c28fa45007785915f00b398237f3e, https://si.imgix.net/938958ff/uploads/origins/e371348f-3f06-4ce1-b6c0-a2a507e8becd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2041110f6022944bfaba74e9f4a6b94 2x, https://si.imgix.net/938958ff/uploads/origins/e371348f-3f06-4ce1-b6c0-a2a507e8becd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29ab0922d4dff04d20da6224b8bc1f5d 3x", "genre": "art", "nsfw": false, "body": "敬具最近ツイッターであなたのアートを発見して、すぐにあなたに依頼しなければと思いました！本当に美しいと思います！\n\nできれば、私のオリジナルキャラクターを描いてほしいのですが、アリエッタという名前の、ストイックだけど思いやりのあるボールジョイントの人形です。彼女の職業は、亡くなった霊が宿る人形を作り、彼らに家を与えることです。\n\nこの人形に関しては、2人の人形が彼女の最も親しい同僚である。彼女のそばには2体の人形がいる。カンタービレは彼女の右側に位置し、大胆で勇敢である。左側のカバレッタはその反対で、臆病だが少し賢い。\n\nアリエッタが着替えを手伝ったり、髪をとかしたり、好きなポーズで描いてください。ただ、私はこの2つが欲しい：\nアリエッタの右手をカンタービレに、左手をカバレッタに、人形遣いのように光る糸でつないでください。\nアリエッタはストイックなので、表情は微妙に。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-tWXoid65HGaVqYTZGdbdpNtyweX8naF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/17", "thumbnail_src": "https://si.imgix.net/64074699/uploads/origins/32b182e5-c714-4aa2-886e-06fefc537e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe95fce1eed8a539868f7acaab082780", "thumbnail_srcset": "https://si.imgix.net/64074699/uploads/origins/32b182e5-c714-4aa2-886e-06fefc537e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe95fce1eed8a539868f7acaab082780, https://si.imgix.net/64074699/uploads/origins/32b182e5-c714-4aa2-886e-06fefc537e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aead8c0c17d4694e265404324d3efcfb 2x, https://si.imgix.net/64074699/uploads/origins/32b182e5-c714-4aa2-886e-06fefc537e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59dc8ebd32ba6dae3eb08351f4eaba00 3x", "genre": "art", "nsfw": false, "body": "こんにちは、初めまして！ Skebの新着作品欄を見ていて絵柄にビビっときたのでリクエストさせていただきたいです！\n\nMMOゲーム内で作成した自分のキャラクターなんですが、いろんな衣装、表情、ポーズをしている姿を具現化したいなと思い、イラストを描いていただきたく依頼差し上げました。\n\n銀髪ショートヘア、オッドアイ、身長150cmくらいという条件で、\n現実世界の20代前半女性が着ているような私服姿を描いていただきたいです！\n\nゲーム内CGでの参考デザインがこちらです。\nhttps://drive.google.com/drive/folders/1V7vrRS9ZbtrEQuV7WpHGP_aQDKXIury2?usp=sharing\n(オッドアイのRGB値、髪の長さなど参考にしてください)\n\n過去にSkebで依頼したいろんな姿の例です。\n＜ゲーム内の衣装＞\nhttps://skeb.jp/@InabaReito/works/5\nhttps://skeb.jp/@maton_3110/works/49\nhttps://skeb.jp/@ammo21204760/works/17\n＜武装JK＞\nhttps://skeb.jp/@soruto_0W98e/works/20\nhttps://skeb.jp/@woodbbMod_0/works/6\n＜バーテンダー＞\nhttps://skeb.jp/@nyanyanyamituki/works/1\n＜別作品の衣装＞\nhttps://skeb.jp/@senri03151221/works/14\nhttps://skeb.jp/@namae11x/works/8\n\n構図などは特に指定ありません(全身が写っていると嬉しいです)。 うどんさんが似合いそうと思ったポーズや表情などで具現化お願いします！\npsdでいただけますと幸いです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/16", "thumbnail_src": "https://si.imgix.net/728d3d05/uploads/origins/d30c0e77-8b0d-457e-a051-1c0a1940ee76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47dee2b7bd4fb8d0ee5a7aead7592bba", "thumbnail_srcset": "https://si.imgix.net/728d3d05/uploads/origins/d30c0e77-8b0d-457e-a051-1c0a1940ee76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47dee2b7bd4fb8d0ee5a7aead7592bba, https://si.imgix.net/728d3d05/uploads/origins/d30c0e77-8b0d-457e-a051-1c0a1940ee76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb4aa68f93edf2ae60ccb896ab56ab4a 2x, https://si.imgix.net/728d3d05/uploads/origins/d30c0e77-8b0d-457e-a051-1c0a1940ee76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08101a35b7334c97d6924d1f63006649 3x", "genre": "art", "nsfw": false, "body": "ななゃんと申します、リクエスト失礼します。\nうちのミコッテちゃんをお願いします。\n\nうちの子は色白でのんびりでマイペースな性格です。\n【内容】\n・構図、背景等はおまかせです。\n・表情は構図に合わせたもので大丈夫です。\n・出来れば可愛い雰囲気でお願いします。\n・お洋服とアームカバーの組み合わせと、チラッと見える肩からの紐がお洋服の好きな所なので…そこが見えると嬉しいです。\n・イメージカラーはピンク、紫、白になります。\n・瞳は緑と青のオッドアイになっています。\n・描く時は胸が少し大きめ、装飾品などもなるべく合わせて描いていただけると嬉しいです。\n・もし可能でしたら傘を被ったペット(名前:コユキンコ)も一緒に描けたら嬉しいです。\n\n【使用用途】\n・SNS投稿への掲載等\n・SNSアイコン及びヘッダー\n・デスクトップ、携帯の待ち受け\n\n【資料】\nhttps://drive.google.com/drive/folders/1-Pq4A5ADuEutJ2IWRbGyNMbrcK_ttMEU\n\n今はミルクティー色にピンクのメッシュですが、\nその前が紫にピンクのメッシュでした。\n（ファイル名　顔周り＿○○　という名前です）\nもし可能でしたら紫の方も付けて頂くことは可能でしょうか？\n無理でしたら今の髪色（ミルクティー色）のみで大丈夫です。\n\n【データ種類】\nもし可能でしたらpsdでキャラと背景レイヤーを分けて頂けますと嬉しいです。\n\nリクエストが通りましたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/15", "thumbnail_src": "https://si.imgix.net/1650ec62/uploads/origins/b7f56c60-1ebf-4306-a3e9-3e0f33d62b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd5e16dfb1f6eb54d2a81b1bcc289f90", "thumbnail_srcset": "https://si.imgix.net/1650ec62/uploads/origins/b7f56c60-1ebf-4306-a3e9-3e0f33d62b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd5e16dfb1f6eb54d2a81b1bcc289f90, https://si.imgix.net/1650ec62/uploads/origins/b7f56c60-1ebf-4306-a3e9-3e0f33d62b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c93d162653b5ae04e9b1de0bfb6dcc05 2x, https://si.imgix.net/1650ec62/uploads/origins/b7f56c60-1ebf-4306-a3e9-3e0f33d62b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78aa8dea1fb16c059ac388890cec44f0 3x", "genre": "art", "nsfw": false, "body": "こんばんは、オリジナルキャラクターを描いてほしいです。https://www.notion.so/tacocatpatron/Autumn-ee9b273eea5d459ebaf3ccc2949f6010。\n 詳細はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@udonGameyou/works/14", "thumbnail_src": "https://si.imgix.net/4f0f94e9/uploads/origins/9a4d9dde-9a68-4007-86af-e062027cf24c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8457ab2c31d929681e7a3c7b6e376444", "thumbnail_srcset": "https://si.imgix.net/4f0f94e9/uploads/origins/9a4d9dde-9a68-4007-86af-e062027cf24c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8457ab2c31d929681e7a3c7b6e376444, https://si.imgix.net/4f0f94e9/uploads/origins/9a4d9dde-9a68-4007-86af-e062027cf24c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200