6ac5e9f6cb22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9835a710539172e2f95689c48c1d0fbc 2x, https://si.imgix.net/39fc7063/uploads/origins/ea0320f6-4d0a-497f-abff-6ac5e9f6cb22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d68fec7f62e1bb53f3a69b9ba5e3567 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/15", "thumbnail_src": "https://si.imgix.net/dba242f7/uploads/origins/b116dc15-c7a4-4361-86df-98bb16e4e905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b3b51bb690f7028905c2d4a37e70d81", "thumbnail_srcset": "https://si.imgix.net/dba242f7/uploads/origins/b116dc15-c7a4-4361-86df-98bb16e4e905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b3b51bb690f7028905c2d4a37e70d81, https://si.imgix.net/dba242f7/uploads/origins/b116dc15-c7a4-4361-86df-98bb16e4e905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=590022579bf32ceab182ce1b9c292986 2x, https://si.imgix.net/dba242f7/uploads/origins/b116dc15-c7a4-4361-86df-98bb16e4e905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a26d5326773aef672563ac2529dd2945 3x", "genre": "art", "nsfw": true, "body": "初めてのリクエストを失礼します。\n推しキャラの銀髪ちゃんには大変お世話になっております。\nということで、うちの子のまもりちゃんと、例の銀髪ちゃんのクロスオーバーな作品を描いて欲しいです。\n状況としてはいつもの洞窟で、二人で百合絡みしてる感じで。\nゴブリンたちは介入せず、優しく見守ってる感じにしてください。\n資料URLでは服を着ていますが、脱がせても大丈夫です。\nよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/126457436", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/14", "thumbnail_src": "https://si.imgix.net/0226c6e0/uploads/origins/72ad06f1-1594-4a4e-98ea-d7ecb0c388f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=622d73ac4c96e593fb316ff236d5bbbf", "thumbnail_srcset": "https://si.imgix.net/0226c6e0/uploads/origins/72ad06f1-1594-4a4e-98ea-d7ecb0c388f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=622d73ac4c96e593fb316ff236d5bbbf, https://si.imgix.net/0226c6e0/uploads/origins/72ad06f1-1594-4a4e-98ea-d7ecb0c388f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ab3acce1387810854ff171739494e1f 2x, https://si.imgix.net/0226c6e0/uploads/origins/72ad06f1-1594-4a4e-98ea-d7ecb0c388f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3d7aba38992f92ede6518eb168a9920 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nhttps://www.fanbox.cc/@nakatasio/posts/9215970等で描かれている娘が蛭型のクリーチャーに胸を吸われるというR18絵を描いて頂きたく依頼させていただきます。\n\n●シチュエーション\n・構図はバストアップで、服装は胸を開けた状態で。\n・蛭型のクリーチャーが両胸に吸い付いて、ジュルジュルと音を立てながら母乳を吸っており、飲みきれなかった母乳が下へ零れ落ちている。\n・それを引きはがそうと手で掴んで引っ張っているが、胸や肩に同じクリーチャーが次の順番を狙うように引っ付いている。\n・表情は落ち着いた様子で対処しているが、頬は紅潮し吐息が漏れ、快感に小さく声を漏らしている\n\nといった内容でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/13", "thumbnail_src": "https://si.imgix.net/59ee1c21/uploads/origins/6bd22e1a-c182-4fce-9033-f1d1d285cee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62552732f090d1743b86fed809028e31", "thumbnail_srcset": "https://si.imgix.net/59ee1c21/uploads/origins/6bd22e1a-c182-4fce-9033-f1d1d285cee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62552732f090d1743b86fed809028e31, https://si.imgix.net/59ee1c21/uploads/origins/6bd22e1a-c182-4fce-9033-f1d1d285cee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3205e89621913d626ea0eb57d7a32a8 2x, https://si.imgix.net/59ee1c21/uploads/origins/6bd22e1a-c182-4fce-9033-f1d1d285cee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fcdcf794e21250cdb054a90edda0642 3x", "genre": "art", "nsfw": true, "body": "初めまして、ブルーアーカイブの明星ヒマリを描いて頂きたいです。\n\nhttps://blue-utils.me/student-detail/himari&lang=Jp?server=jp\n\n明星ヒマリがベッドの端にぶら下げながら、正常位でセックスしている絵が欲しい。\nこんな感じ（https://files.catbox.moe/d2dobv.png）。\n\n男はベッドの端に座り、明星ヒマリは床に手をついてぶら下がっている。ヒマリの両足が大きく開き、ヒマリの足がベッドの上にあるのが見えるような広いキャンバスにする。男の手はヒマリの腰の両脇をつかんでいる。ヒマリの胴体が逆さまになっているため、ヒマリの小さな胸が頭のほうに盛り上がっている。\n\nヒマリも男も全裸である。\n\nお忙しいところ申し訳ございませんが、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/12", "thumbnail_src": "https://si.imgix.net/c3675cf0/uploads/origins/c9780798-3fd1-4685-8045-2d8f74dc2caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5193738685af48d4e1190be049e55a5d", "thumbnail_srcset": "https://si.imgix.net/c3675cf0/uploads/origins/c9780798-3fd1-4685-8045-2d8f74dc2caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5193738685af48d4e1190be049e55a5d, https://si.imgix.net/c3675cf0/uploads/origins/c9780798-3fd1-4685-8045-2d8f74dc2caf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2596e28656be2b515194f70b5f2c83bd 2x, https://si.imgix.net/c3675cf0/uploads/origins/c9780798-3fd1-4685-8045-2d8f74dc2caf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11516f6a9d8a9b7443af8e3c689e5b4e 3x", "genre": "art", "nsfw": true, "body": "マリナとメルのイラストがとても良かったので\nマリナとメルが静かに百合でいっちゃいちゃちゅっちゅしてるのをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/11", "thumbnail_src": "https://si.imgix.net/ecf2d772/uploads/origins/03bd27bb-2685-4927-9c35-f71510ad321c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3caa662e8b5fe03bc30d81253ad2097c", "thumbnail_srcset": "https://si.imgix.net/ecf2d772/uploads/origins/03bd27bb-2685-4927-9c35-f71510ad321c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3caa662e8b5fe03bc30d81253ad2097c, https://si.imgix.net/ecf2d772/uploads/origins/03bd27bb-2685-4927-9c35-f71510ad321c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=947e565a9eeae49bfb06a3b446de0947 2x, https://si.imgix.net/ecf2d772/uploads/origins/03bd27bb-2685-4927-9c35-f71510ad321c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3dff1489341e43f364692912860f3be 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nブルアカの蒼森ミネのイラストをお願いしたいです。\n\n希望プレイ内容としては中出しセックスで、結合部がよく見える構図であれば、体位や服装等(全裸でも可)は問いません。\nその他細かい内容は全てお任せしたいです。\n\n曖昧な内容ではありますが、よろしければご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/10", "thumbnail_src": "https://si.imgix.net/ec0ba259/uploads/origins/0301ca60-2b2f-4ce8-b1ff-2f4f0e28663f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31aff80eab842941dda31a3988abaef1", "thumbnail_srcset": "https://si.imgix.net/ec0ba259/uploads/origins/0301ca60-2b2f-4ce8-b1ff-2f4f0e28663f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31aff80eab842941dda31a3988abaef1, https://si.imgix.net/ec0ba259/uploads/origins/0301ca60-2b2f-4ce8-b1ff-2f4f0e28663f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3680f23c136a3d45030f05df2645127c 2x, https://si.imgix.net/ec0ba259/uploads/origins/0301ca60-2b2f-4ce8-b1ff-2f4f0e28663f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c711c7ecb22991782936d2bc03ef067 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/9", "thumbnail_src": "https://si.imgix.net/96984b2f/uploads/origins/b8466d08-0130-407d-9dfd-41c7b583399a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abac3abd3544a92b552bca790ae6e4ef", "thumbnail_srcset": "https://si.imgix.net/96984b2f/uploads/origins/b8466d08-0130-407d-9dfd-41c7b583399a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abac3abd3544a92b552bca790ae6e4ef, https://si.imgix.net/96984b2f/uploads/origins/b8466d08-0130-407d-9dfd-41c7b583399a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f78c1c72aa1debc6ecd830c6b235b6fe 2x, https://si.imgix.net/96984b2f/uploads/origins/b8466d08-0130-407d-9dfd-41c7b583399a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=023cf4228261aba1b368f457ecfa5e9c 3x", "genre": "art", "nsfw": true, "body": "拡張少女系トライナリー\n國政領火さんをお願いします\n普段は優しくて少しほわほわした雰囲気のお姉さん。研究職なので運動不足で柔らかそうな身体つきな感じでお願いします\n\n奥深くまで突き入れられて絶頂しているシーンをお願いしたいです\n裸で頭と太もものガジェットのみあり\n陰毛有り、無しの差分と中出し差分があると嬉しいです\n\nhttps://drive.google.com/drive/folders/13g9EvDmJ_ajMpO6uuFUF1uJdfiXl4kPY", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/8", "thumbnail_src": "https://si.imgix.net/1ae6ae9f/uploads/origins/31f44f82-df35-4e5d-8ba9-bf969143608c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=978b4142e952e7475d95d16375ac9def", "thumbnail_srcset": "https://si.imgix.net/1ae6ae9f/uploads/origins/31f44f82-df35-4e5d-8ba9-bf969143608c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=978b4142e952e7475d95d16375ac9def, https://si.imgix.net/1ae6ae9f/uploads/origins/31f44f82-df35-4e5d-8ba9-bf969143608c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c0567e3e1378158fe822bedb753b41b 2x, https://si.imgix.net/1ae6ae9f/uploads/origins/31f44f82-df35-4e5d-8ba9-bf969143608c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46c52676de151b672a8539f992493df7 3x", "genre": "art", "nsfw": true, "body": "私のオリジナルキャラクター、メアを描いていただけませんか。\n\n構図などは自由ですので、ご自由に描いてください。\n\nよろしくお願いいたします！\n\nhttps://x.com/ac8231/status/1774969507611881696?s=20", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/7", "thumbnail_src": "https://si.imgix.net/1ef021bf/uploads/origins/d1b5f305-80ef-4041-a364-0223b7c5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034332167b1ee2f49e0f3fbade7aa8f5", "thumbnail_srcset": "https://si.imgix.net/1ef021bf/uploads/origins/d1b5f305-80ef-4041-a364-0223b7c5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034332167b1ee2f49e0f3fbade7aa8f5, https://si.imgix.net/1ef021bf/uploads/origins/d1b5f305-80ef-4041-a364-0223b7c5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8828abda15bd5a2c251e090f7f9f9f57 2x, https://si.imgix.net/1ef021bf/uploads/origins/d1b5f305-80ef-4041-a364-0223b7c5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=570fb6bbe231af8847cc4f9a31822378 3x", "genre": "art", "nsfw": true, "body": "ブルアカのメルのイラストをお願いします。\n浴衣verでいちゃらぶえっちな感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/6", "thumbnail_src": "https://si.imgix.net/f2f94b73/uploads/origins/1d935a79-5e37-4fba-ada2-af3f645fb614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54b8021c713acf9ef5f98cd4054d6725", "thumbnail_srcset": "https://si.imgix.net/f2f94b73/uploads/origins/1d935a79-5e37-4fba-ada2-af3f645fb614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54b8021c713acf9ef5f98cd4054d6725, https://si.imgix.net/f2f94b73/uploads/origins/1d935a79-5e37-4fba-ada2-af3f645fb614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a872b0e08ea657e7bce90a7ac457fea1 2x, https://si.imgix.net/f2f94b73/uploads/origins/1d935a79-5e37-4fba-ada2-af3f645fb614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae168de9d6e3d3841524699859242b7e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\nBlue Archiveのカンナのイラストをお願いしたいのですが。\n\nセクシーな黒のビキニを着たカンナでお願いします。\n\n男が後ろからカンナを犯す。かんなは片足立ちで、男はもう片方の足を持ち上げる。かんなが快感に満ちた表情をするように。\n\nこの度はこのような要望を聞いていただきありがとうございました。\n\n参考：https://imgur.com/a/QYNUZws", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/5", "thumbnail_src": "https://si.imgix.net/bae9563f/uploads/origins/5c5e1f94-9a4c-49b6-b9f3-bbe9e1767150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e49d77df4bf0734ad183cb7efed4c33", "thumbnail_srcset": "https://si.imgix.net/bae9563f/uploads/origins/5c5e1f94-9a4c-49b6-b9f3-bbe9e1767150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e49d77df4bf0734ad183cb7efed4c33, https://si.imgix.net/bae9563f/uploads/origins/5c5e1f94-9a4c-49b6-b9f3-bbe9e1767150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e9743641328b30dbba26302a7b605db 2x, https://si.imgix.net/bae9563f/uploads/origins/5c5e1f94-9a4c-49b6-b9f3-bbe9e1767150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11c2fa75651032fef27f10921c134065 3x", "genre": "art", "nsfw": true, "body": "初めまして、良ければリクエストしたいです。\n可能であれば、ドールズフロントラインのG11をお願い致します。  \n参考 : https://wikiwiki.jp/dolls-fl/Gr%20G11 \n胸控えめで少し小柄な子です。下は無毛でお願いします。\n頭の帽子も何も無しの銀髪のみで、全裸でお願いします。\n\nG11が机などの上で平行に大きく開脚して両手を後ろについて座る机上位を描いて欲しいです。\n真横か斜めくらいの構図でお願いしたいです。\nねちゃねちゃの愛液が結合部間で沢山糸引いている描写があると嬉しいです。\nめちゃくちゃ発汗し、涙流して激しく感じて余裕がない表情でお願いします。\n出来れば中出しでイキ叫ぶような表情も見てみたいです。\n\n良ければご検討下さい。", "created_at": "", "completed_at": ""}, {"path": "/@nakatasio/works/4", "thumbnail_src": "https://si.imgix.net/edf0959f/uploads/origins/35e8d271-eaa5-47bb-bcde-aa1ba5679af1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9137491ea3b249df4e53cad398d3c9", "thumbnail_srcset": "https://si.imgix.net/edf0959f/uploads/origins/35e8d271-eaa5-47bb-bcde-aa1ba5679af1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9137491ea3b249df4e53cad398d3c9, https://si.imgix.net/edf0959f/uploads/origins/35e8d271-eaa5-47bb-bcde-aa1ba5679af1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c105fe76c7ad9d5a99f2c