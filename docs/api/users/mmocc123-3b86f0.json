dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c9ba49152792cb7d9bfa5e1b5c614a1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mmocc123/works/155", "thumbnail_src": "https://si.imgix.net/31decdb5/uploads/origins/833c694d-fa23-4615-b3ef-6d55e845ac8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cdbd3a832069a65a16c66dbc091496f", "thumbnail_srcset": "https://si.imgix.net/31decdb5/uploads/origins/833c694d-fa23-4615-b3ef-6d55e845ac8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cdbd3a832069a65a16c66dbc091496f, https://si.imgix.net/31decdb5/uploads/origins/833c694d-fa23-4615-b3ef-6d55e845ac8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd097a056fcbb2177b2dc95764ff89e4 2x, https://si.imgix.net/31decdb5/uploads/origins/833c694d-fa23-4615-b3ef-6d55e845ac8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70841342a4b34c5b1d8b6490471c4722 3x", "genre": "art", "nsfw": false, "body": "今回もよろしくお願いします！\nうちの子(OC)である山羊獣人騎士のシロとクロが映画やアニメの三銃士(っぽい)衣装を着た姿を描いて欲しいです。\nキャラ設定や時代背景は無視して構いませんので桜木様の絵柄と好きな雰囲気重視でお願いできたらと思います。\n\n三銃士(っぽい衣装)とキャライメージ \n17世紀フランスの貴族の服装を基調(それっぽさがあれば好みにアレンジしてください)\n(シャツ、ベスト、ズボン、帽子、マントなど)\n膝下までのロングブーツと長手袋\n細身の長剣と護剣(レイピアとマインゴーシュ)\nクロ : アトスイメージ、大人びたシックな雰囲気\nシロ : アラミスイメージ、上品でエレガントな雰囲気\n\nポーズ、構図、背景などは全てお任せします。\n桜木様の好きな要素やアクション、ポーズ、視点などを詰め込んでカッコ良く美形に描いていただけば嬉しいです。\nそれではよろしくお願いします\n\nhttps://drive.google.com/drive/mobile/folders/16RPNCwMclBvsqz3XfkN0_yaDegMpEFsk", "created_at": "", "completed_at": ""}, {"path": "/@mmocc123/works/154", "thumbnail_src": "https://si.imgix.net/ed7ed8d5/uploads/origins/24a1aedf-6615-47d2-90b8-70959d2c31d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4c5775a3881e447c410e3ddfe06