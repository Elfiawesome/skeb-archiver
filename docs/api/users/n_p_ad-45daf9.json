47f2-9363-476441bdcfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4007dc6c2ecc5276375302428b352a8d", "thumbnail_srcset": "https://si.imgix.net/d4cacfab/uploads/origins/b5bac7bb-e838-47f2-9363-476441bdcfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4007dc6c2ecc5276375302428b352a8d, https://si.imgix.net/d4cacfab/uploads/origins/b5bac7bb-e838-47f2-9363-476441bdcfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4da1e967ec2d400524b1c5ccc9d3924 2x, https://si.imgix.net/d4cacfab/uploads/origins/b5bac7bb-e838-47f2-9363-476441bdcfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2112ddb830004d6b06c4ae1e9367fb4e 3x", "genre": "art", "nsfw": true, "body": "アピールありがとうございます。\nせっかくなのでイラストをリクエストさせていただこうと思います。\n\nアイドルマスターDSに登場する水谷絵理のR18イラストを描いていただけますか。\n水着のトップをずり上げて胸を露出させ、ボトムを太腿の真ん中あたりまで下ろした状態でシーツの上に仰向けに寝ているところをお願いします。\n表情は恥ずかしそうな表情。胸は少し大きめに描いてください。\nHな抱き枕風のイラスト、というようなイメージです。\n\n可能なら胸や下腹部に精液をかけられている差分をお願いします。\n\n参考画像（初期の公式絵）\nhttps://i.imgur.com/WMnWH9h.jpg\n\n参考画像（水着）\nhttps://i.imgur.com/F44b5xH.jpg\n\n以上です。\nご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@n_p_ad/works/1", "thumbnail_src": "https://si.imgix.net/089695ae/uploads/origins/3cde1975-20e2-4e46-9fab-e4fa9ee56b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b16e1c2e162429021f6483d2da59e509", "thumbnail_srcset": "https://si.imgix.net/089695ae/uploads/origins/3cde1975-20e2-4e46-9fab-e4fa9ee56b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b16e1c2e162429021f6483d2da59e509, https://si.imgix.net/089695ae/uploads/origins/3cde1975-20e2-4e46-9fab-e4fa9ee56b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9f4c2e8723ad42e5f36d1e6433dec1e 2x, https://si.imgix.net/089695ae/uploads/origins/3cde1975-20e2-4e46-9fab-e4fa9ee56b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c