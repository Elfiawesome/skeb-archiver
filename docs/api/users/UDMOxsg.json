2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e020e5faad8874a714c2a7b9bb6ff311, https://si.imgix.net/10a62fa5/uploads/origins/28983283-f663-4153-b302-b80ae8fb7292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=897441b849656ec6f0e144f75e7e42b7 2x, https://si.imgix.net/10a62fa5/uploads/origins/28983283-f663-4153-b302-b80ae8fb7292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46fc1eab36f1325e657f1c26cfb7d6d9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！白南風翠雨と申します！ocのドラゴン、白南風翠雨を描いて頂けませんでしょうか？  タッチや構図はお好きなように、のびのびと描いていただけると幸いです！\n使用用途としては、SNS(アイコンやヘッダー、告知)です。 以下参考資料となります。 \nよろしくお願いします！\nhttps://photos.app.goo.gl/Qmat6P4KTxHbEGDTA\nhttps://photos.app.goo.gl/1AzfQf7sRVVFhQFJA", "created_at": "", "completed_at": ""}, {"path": "/@UDMOxsg/works/25", "thumbnail_src": "https://si.imgix.net/7cbb036a/uploads/origins/29dc1b87-d2a1-4a7e-9f6b-36b454afd1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3cc4c770a8d963539369017bba77ed6", "thumbnail_srcset": "https://si.imgix.net/7cbb036a/uploads/origins/29dc1b87-d2a1-4a7e-9f6b-36b454afd1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3cc4c770a8d963539369017bba77ed6, https://si.imgix.net/7cbb036a/uploads/origins/29dc1b87-d2a1-4a7e-9f6b-36b454afd1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf10ae2d8895acd47d127971c0e38cfb 2x, https://si.imgix.net/7cbb036a/uploads/origins/29dc1b87-d2a1-4a7e-9f6b-36b454afd1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4c8f27d890e7feea6e03b9cfb828bdf 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！\nあなたの絵柄が好きで、私のOCをお願いさせていただきたいです！\n性格はちょっとクールな子です。ポーズ等はお任せします。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ChR8fqaIh5yIs3oDuyyjeSQXLq9m7phy?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@UDMOxsg/works/24", "thumbnail_src": "https://si.imgix.net/170b26c3/uploads/origins/abac7b73-8814-487b-89e3-a24de6e3eb33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e91645455371d356ad5beb3396b335bb", "thumbnail_srcset": "https://si.imgix.net/170b26c3/uploads/origins/abac7b73-8814-487b-89e3-a24de6e3eb33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e91645455371d356ad5beb3396b335bb, https://si.imgix.net/170b26c3/uploads/origins/abac7b73-8814-487b-89e3-a24de6e3eb33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4f04b04e8807f860b1321383850c382 2x, https://si.imgix.net/170b26c3/uploads/origins/abac7b73-8814-487b-89e3-a24de6e3eb33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8cd926f11d0dfba41db513b9930720b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n今回はうちの子を描いていただきたく、リクエストを送らせていただきました。\nキャラクターは資料URL先の、ラグ（白い子）かリグ（黒い子）をどちらかで構いません\n\n下記のskebのようにラフなイラストの詰め合わせがとても素敵だと思ったので、同じように描いていただけると嬉しいです！構図はお任せします\nhttps://skeb.jp/@UDMOxsg/works/17\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Orc5e0c6fTMq_cnxrRHocPiv66wzf4Ly?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@UDMOxsg/works/23", "thumbnail_src": "https://si.imgix.net/f578f1a8/uploads/origins/ca82a3d4-fbd6-4838-bf62-2ee226ee60c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c703980f9b10ead3689e32133ed6287", "thumbnail_srcset": "https://si.imgix.net/f578f1a8/uploads/origins/ca82a3d4-fbd6-4838-bf62-2ee226ee60c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c703980f9b10ead3689e32133ed6287, https://si.imgix.net/f578f1a8/uploads/origins/ca82a3d4-fbd6-4838-bf62-2ee226ee60c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fb6129a6cc32d1bcf7e290c7121ba58 2x, https://si.imgix.net/f578f1a8/uploads/origins/ca82a3d4-fbd6-4838-bf62-2ee226ee60c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d22959e4a25e2790c54d028e25f1245 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。あなたの絵を見て、とても気に入りました！あなたの毛皮の絵はかっこよさとかわいさの両方を持っている！私のキャラクターにぴったりだと思いました。\n\n名前はリオ。原住民の部族の猫です。とても自信家。ハンター兼泥棒として生きており、大きなエゴを持っている。自分の主張に裏打ちされた技術を持っているが、それでも自信過剰なところがある。\n\n自信に満ちたポーズを描いてほしい。最初の参考画像の体型を維持するようにしてください。リオはとてもクールな人間かもしれないが、かわいらしさをおろそかにしないでほしい。参考画像は下の方にあります。もし槍が難しかったり、ポーズとぶつかったりしたら、遠慮なく削除してください。\n\n参考画像は下にあります。\nhttps://imgur.com/a/rio-NB51hZP\n\nありがとうございます^_^。", "created_at": "", "completed_at": ""}, {"path": "/@UDMOxsg/works/22", "thumbnail_src": "https://si.imgix.net/361167c6/uploads/origins/c9b54d7d-a199-4927-ab40-f624ba210e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=331d4daf8004150913d2ec0c6499fcc9", "thumbnail_srcset": "https://si.imgix.net/361167c6/uploads/origins/c9b54d7d-a199-4927-ab40-f624ba210e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=331d4daf8004150913d2ec0c6499fcc9, https://si.imgix.net/361167c6/uploads/origins/c9b54d7d-a199-4927-ab40-f624ba210e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad0efc28d87ff5253ad4f65f77a45f70 2x, https://si.imgix.net/361167c6/uploads/origins/c9b54d7d-a199-4927-ab40-f624ba210e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2351ce3438e77374ad24b34b6f5b2a71 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私はあなたのアートワークをとても気に入りました。1匹は頭に王冠をかぶったブルーベリー色のメスのスプリガティート、もう1匹は大きな緑のコートを着た薄黄色のオス猫です。私の頭の中では、この2匹の猫がドギースタイルでセックスをしていた。背中に黄色い猫、上にスプリガティート。\n\nスプリガティート： https://drive.google.com/file/d/1dRogBBOJ8Dr9FFFfhWmPIATwugqlZy5G/view?usp=drive_link\nイエローキャット：https://drive.google.com/file/d/1hfATf5W18-b3GROHRL31qt9ewuDux3se/view?usp=drive_link\n\nこんな感じ:https://pbs.twimg.com/media/Gnedv5LWMAAdXXq?format=jpg&name=medium", "created_at": "", "completed_at": ""}, {"path": "/@UDMOxsg/works/21", "thumbnail_src": "https://si.imgix.net/70801da9/uploads/origins/127ef594-2879-4bda-a9b5-ef4bfffc51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff14b2fdb89a46b75fc53b7c285ede6f", "thumbnail_srcset": "https://si.imgix.net/70801da9/uploads/origins/127ef594-2879-4bda-a9b5-ef4bfffc51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff14b2fdb89a46b75fc53b7c285ede6f, https://si.imgix.net/70801da9/uploads/origins/127ef594-2879-4bda-a9b5-ef4bfffc51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ee6b2073d81976a1c6bdb2d1ebbe8e7 2x, https://si.imgix.net/70801da9/uploads/origins/127ef594-2879-4bda-a9b5-ef4bfffc51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0020c10bb47d7cf3d981a4ad67d74a68 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n私のバット[Seele]と友達の猫[Kiu]のキャラクターのイチャイチャ画像が欲しいです。\n\nSeeleがKiuの後ろにいて、Kiuがちょっと露出の多いかわいい衣装でコウモリの格好をして、ふわふわしている。\n\nキウが着ている服は、袖やアームウォーマーがついていて、羽が生えているように見えるものがいい。キウの目には目隠しをして、目が見えないようにしてほしい。あとは全部お任せだけど、キウがシーレに仕えていることをかわいらしくアピールできるような感じにしてほしい。\n\nシーレ：https://drive.google.com/drive/u/0/folders/1fE9hg0I9p4R6nzzGNL5ZoJj2HrRtnU4x\nキウ： https://drive.google.com/drive/folders/1L6pHj6VKwUJvjsn8oLyhgDZvqGN4tSbz?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@UDMOxsg/works/20", "thumbnail_src": "https://si.imgix.net/7907717c/uploads/origins/ed28bb41-d7cc-4bab-972a-ba60c1dee928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683d34f8d71e65ab02a73b5098a3e150", "thumbnail_srcset": "https://si.imgix.net/7907717c/uploads/origins/ed28bb41-d7cc-4bab-972a-ba60c1dee928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683d34f8d71e65ab02a73b5098a3e150, https://si.imgix.net/7907717c/uploads/origins/ed28bb41-d7cc-4bab-972a-ba60c1dee928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e2577cf1a8e2d057b4e40d6787de671 2x, https://si.imgix.net/7907717c/uploads/origins/ed28bb41-d7cc-4bab-972a-ba60c1dee928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fc15e0857ffb6548109f9700d84c74e 3x", "genr