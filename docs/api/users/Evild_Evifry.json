425-934e-c0d4e60df1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0d3b05266ed9ea6905cd581f73e22be, https://si.imgix.net/e8ac9726/uploads/origins/1cbc5bdc-15e0-4425-934e-c0d4e60df1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79176f5aadfbccf671fa935e6a72e55a 2x, https://si.imgix.net/e8ac9726/uploads/origins/1cbc5bdc-15e0-4425-934e-c0d4e60df1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=539dfac30cadafc406f65c7bb52494c7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつもお世話になっております！前回描いて頂いた碧くんの絵があまりに素敵で、オマケで当方の探索者の腕までつけていただき、本当に嬉しくて何度も見返しており待ち受けにして毎日眺めております！仕事もエビ天さんの素敵なイラストに励まされ、頑張れております！！とても嬉しいです！！\nそこで、今回はぜひエビ天さんの絵で【立花に飛びついて大しゅきホールドになっている笑顔の碧くん】もしくは、【ソファで立花に後ろから抱っこされて一緒に映画を見ている碧くん】が見たいと思い、ご依頼させていただきました……！より描きやすい方どちらかを描いて頂きたいです！！お気が向きましたらどうぞよろしくお願いいたします……！！", "created_at": "", "completed_at": ""}, {"path": "/@Evild_Evifry/works/6", "thumbnail_src": "https://si.imgix.net/e7560ef2/uploads/origins/6a98ca10-b03a-4eeb-941e-c9017cc32738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7842b870a1ee2326b77d941ece8055e", "thumbnail_srcset": "https://si.imgix.net/e7560ef2/uploads/origins/6a98ca10-b03a-4eeb-941e-c9017cc32738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7842b870a1ee2326b77d941ece8055e, https://si.imgix.net/e7560ef2/uploads/origins/6a98ca10-b03a-4eeb-941e-c9017cc32738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32719f9564533cfe77b8e76579f1bcdf 2x, https://si.imgix.net/e7560ef2/uploads/origins/6a98ca10-b03a-4eeb-941e-c9017cc32738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efd16bdec08fc28c598bb20c94186232 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。いつも素敵なイラストを拝見しており、前々からぜひ弊うちよそを描いていただきたいと思っておりました。\n以下ご確認の上、ご検討いただきますと幸いです。どうぞよろしくお願いいたします。\n\n＜キャラクター＞\n■受け\nhttps://drive.google.com/file/d/1cf9znnEy6bGgEGy6P7SJp1fzh6rbc10G/view?usp=sharing\n■攻め\nhttps://drive.google.com/file/d/1SveO7x3pmssdWt8K3RaNscch7syDrfs5/view?usp=sharing\n\n＜内容＞\n攻めが受けをお姫様抱っこしているシチュエーションでお願いします。\n受け側はちょっと焦りつつ照れている顔、攻め側は笑顔orはにかみで、目線は合わせたいです。\n\n構図やロケーションはお任せします。背景も必須ではないため、エビ天様の描きやすいようにご調整ください。\n衣装の指定も特にございませんので、資料内容に添付・記載している内容を元にアレンジしていただいてもかまいません。", "created_at": "", "completed_at": ""}, {"path": "/@Evild_Evifry/works/5", "thumbnail_src": "https://si.imgix.net/fc043730/uploads/origins/1ed9ef5e-592f-4ec5-b14f-87395fd7af31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff55b3c8dca50caaf8bb297511b73f4", "thumbnail_srcset": "https://si.imgix.net/fc043730/uploads/origins/1ed9ef5e-592f-4ec5-b14f-87395fd7af31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff55b3c8dca50caaf8bb297511b73f4, https://si.imgix.net/fc043730/uploads/origins/1ed9ef5e-592f-4ec5-b14f-87395fd7af31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e1400f92fe84ba5e11c906d6ae837b5 2x, https://si.imgix.net/fc043730/uploads/origins/1ed9ef5e-592f-4ec5-b14f-87395fd7af31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e5c0b847805a0ad56ac2e59abc66c0f 3x", "genre": "art", "nsfw": false, "body": "こんばんは！たろうと申します！！！！！いつもお世話になっております！！！！！\nつきましては、もしよろしければ【お誕生日を一緒にお祝いしているStellaくんと木天】のイラストを依頼させていただけたらな……と…………！！！！！\nご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Evild_Evifry/works/4", "thumbnail_src": "https://si.imgix.net/348071e4/uploads/origins/cc4d46a2-878f-49dd-9ab1-ad6f12f5258a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77b13ec7a51f57a10e8cff3d0ec9cc06", "thumbnail_srcset": "https://si.imgix.net/348071e4/uploads/origins/cc4d46a2-878f-49dd-9ab1-ad6f12f5258a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77b13ec7a51f57a10e8cff3d0ec9cc06, https://si.imgix.net/348071e4/uploads/origins/cc4d46a2-878f-49dd-9ab1-ad6f12f5258a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91ac3e1f7fe726cc8871f5720a99a845 2x, https://si.imgix.net/348071e4/uploads/origins/cc4d46a2-878f-49dd-9ab1-ad6f12f5258a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=079229d976a5b46e68feeacaba2fe1ad 3x", "genre": "art", "nsfw": false, "body": "エビ天さんはじめまして！髆（はく）と申します。\nTwitterでイラストを見かけて素敵だと思いSkeb依頼を差し上げております。よろしければ下記ご検討ください。\n\n\n●依頼内容：\nOC（オリジナルシナリオNPC）の一枚絵\n\n●キャラクターについて：\n・髪の色：黒、襟足が少し長め。\n・瞳の色：赤\n・備考：両目に縦に切り傷がある（資料参照）\n・性格：\n「WILL」というCoCオリシのNPCです。\n※作者が私なので著作権関連は問題ありません。\n\n無表情ですが感情表現に乏しいだけで無感情ではありません。\nただ表情筋が終わっているため、稀に笑顔を作るときはぎこちなく、ちょっと気味が悪いです。\n基本的に無表情で過ごしていますが、特定の探索者に対してのみ時々当社比豊かな表情（戸惑う、困る、考えるそぶりを見せる程度のもの）を見せます。\n\n●希望構図：\n可能であれば、誰かのためにプレゼント（物、食べ物は問わない）を大量に買っている、もしくは大量のブランド品の荷物持ちをしている構図が望ましいです。\nよろしければその中にケーキやマカロンなども加えてください（依頼キャラクターが食べていても問題ありません）。\n\n●参考資料：\n・全身：\nhttps://drive.google.com/file/d/1HykUXXCUhNkUgeB9Y71FtcnQ3DacS8yp/view?usp=sharing\n・顔アップ：\nhttps://drive.google.com/file/d/1aQI5mBd099u01dv4Tp6aR_amtYQT6Hke/view?usp=sharing\n\n\n不備不足がありましたらキャンセルいただけますと幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1HykUXXCUhNkUgeB9Y71FtcnQ3DacS8yp/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Evild_Evifry/works/3", "thumbnail_src": "https://si.imgix.net/01e8be4f/uploads/origins/fb431675-de66-4877-bde0-acd253a52fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaf7b91a5ccb40360d35119b84531285", "thumbnail_srcset": "https://si.imgix.net/01e8be4f/uploads/origins/fb431675-de66-4877-bde0-acd253a52fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaf7b91a5ccb40360d35119b84531285, https://si.imgix.net/01e8be4f/uploads/origins/fb431675-de66-4877-bde0-acd253a52fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25711e820ece71188973be38e2fe8d07 2x, https://si.imgix.net/01e8be4f/uploads/origins/fb431675-de66-4877-bde0-acd253a52fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c821921c7d5845757acb7c230bda05fa 3x", "genre": "art", "nsfw": true, "body": "こんにちは、エビ天様。\n\nこの度はエビ天様の絵柄がとても好ましく、是非ともTRPGにて作成した一次創作のキャラクターを描いてほしくご依頼しにまいりました。\n\nイメージ画像につきましては別途資料の方を添付いたしましたのでそちらをご参照してください。\n\n髪がピンク＞黄色のグラデーションの殺人鬼ミツ君×メガネをかけたメカクレ高校生のツグ君の二人です。\n\nミツ君はツグ君の事をとても甘やかしており、はちゃめちゃ大好きでたまらないといった感じです。\n逆にツグ君は満更でもないけれどまったく素直でなく、ほとんど笑うことがありません。\n\nシチュエーションとしましては後ろからミツ君がツグ君を抱きしめてお腹辺りから服の中に手を入れている…というものが見たいなと思います。\n難しいようでしたらエビ天様の好きなようにお描きいただいて大丈夫です！！！！\n\n金額等問題がありましたら再送してくださいませ。何卒ミツ君×ツグ君をどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1H4YP6JSXc2NQkC3Qni_cPoxswpvt4xVO?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Evild_Evifry/works/2", "thumbnail_src": "https://si.imgix.net/fa943af8/uploads/origins/3c7c75fd-ffb9-4d2f-8802-4a5f1abc46d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57922f51090c5f55cdfbb2d6c664c002", "thumbnail_srcset": "https://si.imgix.net/fa943af8/uploads/origins/3c7c75fd-ffb9-4d2f-8802-4a5f1abc46d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57922f51090c5f55cdfbb2d6c664c002, https://si.imgix.net/fa943af8/uploads/origins/3c7c75fd-ffb9-4d2f-8802-4a5f1abc46d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07495bfbf554229389e613322c22b636 2x, https://si.imgix.net/fa943af8/uploads/origins/3c7c75fd-ffb9-4d2f-8802-4a5f1abc46d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba78945660fbae4d53b243490a67a5a6 3x", "genre": "art", "nsfw": false, "body": "こんばんは！\nまずは…あの……奇伝X、たいへんきもちよく回らせていただき、本当に本当にありがとうございました…！！！感謝の念に絶えません！！！\nつきましては、もしもしよろしければ【アイドルとして活動しているStellaくん】が見たいな……と思い……依頼させて頂きたいと…………！！！！！\n依頼というのがはじめてなのでわけのわからない文章になっていたらすみません！よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Evild_Evifry/works/1", "thumbnail_src": "https://si.imgix.net/2a10580e/uploads/origins/5f34382e-8764-465e-b00f-278431ed375e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5bab7e283f442184ee97e30a7ceae9e", "thumbnail_srcset": "https://si.imgix.net/2a10580e/uploads/origins/5f34382e-8764-465e-b00f-278431ed375e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5bab7e283f442184ee97e30a7ceae9e, https://si.imgix.net/2a10580e/uploads/origins/5f34382e-8764-465e-b00f-278431ed375e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ceeebbaca77c1d265732e976ac0a9c5 2x, https://si.imgix.net/2a10580e/uploads/origins/5f34382e-8764-465e-b00f-278431ed375e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2284f6bf85ad50505c73b36b31bb0b07 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつもお世話になっております！！\nもしよければ、立花の家で寛ぎながらイクラ丼を食べている湖城碧くんのイラストをお願いしたいです！！！どうぞご検討よろしくお願いします！！！", "created_at": "", "completed_at": ""}]}