0&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a3ca601d20ae6f3e2986c5f36a53460, https://si.imgix.net/f5aac9f1/uploads/origins/820ef04c-ad16-43f7-b535-85b13daeb2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e747f517dfd07f7f2e05c0efe168aed 2x, https://si.imgix.net/f5aac9f1/uploads/origins/820ef04c-ad16-43f7-b535-85b13daeb2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5abf246105156514fa99cae15eba4091 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuu_sagi/works/311", "thumbnail_src": "https://si.imgix.net/49ffea99/uploads/origins/edfb21e9-e569-4e70-900a-4c4f3914ada0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4fa0c7a395e573f371ec4ee46661eb2", "thumbnail_srcset": "https://si.imgix.net/49ffea99/uploads/origins/edfb21e9-e569-4e70-900a-4c4f3914ada0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4fa0c7a395e573f371ec4ee46661eb2, https://si.imgix.net/49ffea99/uploads/origins/edfb21e9-e569-4e70-900a-4c4f3914ada0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eedeea9790df559c6e9db81bd1b165f3 2x, https://si.imgix.net/49ffea99/uploads/origins/edfb21e9-e569-4e70-900a-4c4f3914ada0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdc293fccd5da4b6905951438f8c1c87 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuu_sagi/works/310", "thumbnail_src": "https://si.imgix.net/06d73f14/uploads/origins/fed8eb88-d6d9-4bdf-85a1-fd84d3fd11c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae31649d68ac109478452c48110d0a5d", "thumbnail_srcset": "https://si.imgix.net/06d73f14/uploads/origins/fed8eb88-d6d9-4bdf-85a1-fd84d3fd11c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae31649d68ac109478452c48110d0a5d, https://si.imgix.net/06d73f14/uploads/origins/fed8eb88-d6d9-4bdf-85a1-fd84d3fd11c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5a793fed6f3c76cf5bcdb618776f50b 2x, https://si.imgix.net/06d73f14/uploads/origins/fed8eb88-d6d9-4bdf-85a1-fd84d3fd11c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14c84d9f385631390b8980e2e74870b3 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n私のオリキャラを描いてもらいたいです。\n\n・オリキャラについて\n穏やかな清楚系少女\n年齢：17歳\n身長：160cm前半\nウエスト50くらいのスレンダーな体型\n胸はD~Eカップ程度\n健康的な白い肌\n銀髪\n明るい水色の瞳\n\n髪型の変更\n参考資料に載せている髪型に変更してください。長さはお尻ぐらいまで、髪色のグラデーションは無しでお願いします。\n\n衣装について\n参考資料に載せている衣装を着せてください。また、一部変更してもらいたい点があります。\n\n変更点\n・武器類は無し\n・トゲトゲした2本の尻尾も無し\n・左胸にあるエンブレム無し\n・メインカラーを白色に変更、髪と瞳の色に合わせた色使いにしてください。\n\n細部不明な箇所はユウサギさんのお好きにデザインして頂いて構いません。\n\n全身が見える立ち絵とデザインがわかる3面図、もしくは2面図を描いてもらいたいです。表情、ポーズおよび背景はお任せします。\n\n参考資料\nhttps://drive.google.com/drive/folders/1C_bmk-GNfaYeyGgNkNJQFS5KXEisW3o-?usp=sharing\n\nリクエスト内容は以上です。ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yuu_sagi/works/309", "thumbnail_src": "https://si.imgix.net/e5e152ca/uploads/origins/1f85c138-7bdc-4bab-a4e0-b7fccfcb8c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=813d9a6ba5e351fb0373e3b8c69861ea", "thumbnail_srcset": "https://si.imgix.net/e5e152ca/uploads/origins/1f85c138-7bdc-4bab-a4e0-b7fccfcb8c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=813d9a6ba5e351fb0373e3b8c69861ea, https://si.imgix.net/e5e152ca/uploads/origins/1f85c138-7bdc-4bab-a4e0-b7fccfcb8c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c45dc62e5cd29c7a4ff0a01c5835a30 2x, https://si.imgix.net/e5e152ca/uploads/origins/1f85c138-7bdc-4bab-a4e0-b7fccfcb8c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3a88bab144c644ac1f189309233f2e 3x", "genre": "art", "nsfw": true, "body": "今年はもうリクエストはおしまいと思っていたのですが、6colorsさんの新作とネタがかぶっているものがあったので、今年最後のリクエストをお願いしたいです。\n\n前回、ONAGONO QUEST EVEの主人公を人魚にしていただきましたが、今度は竜にしてもらえませんでしょうか。\n\n資料URLのような感じで、人間から竜に変化していく過程を\n出来れば、何段階かに分けて徐々に竜化させていただきたいです。\n\nhttps://www.pixiv.net/artworks/139111668", "created_at": "", "completed_at": ""}, {"path": "/@yuu_sagi/works/308", "thumbnail_src": "https://si.imgix.net/de998121/uploads/origins/d6f50379-3d7c-43cf-8610-ccb86943bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bb37113d6360f90235a491bd4ca9b42", "thumbnail_srcset": "https://si.imgix.net/de998121/uploads/origins/d6f50379-3d7c-43cf-8610-ccb86943bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bb37113d6360f90235a491bd4ca9b42, https://si.imgix.net/de998121/uploads/origins/d6f50379-3d7c-43cf-8610-ccb86943bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d231a3c2f0d50e949b38905174eb6b3 2x, https://si.imgix.net/de998121/uploads/origins/d6f50379-3d7c-43cf-8610-ccb86943bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a5c6fa53abd75dbb0b585b5e5871137 3x", "genre": "art", "nsfw": true, "body": "前回はお世話になりました。\n宜しければ下記イラストお願いできないでしょうか。\n\n【キャラ】\n「光翼戦姫エクスティア３」より、エクスティア(葛城真理奈)\n\n【シチュエーション・構図】\n敗北したエクスティアが、鎖付きの金属製の手枷をつけられ、\n鎖の先にある2機の円盤型の飛行物体によって連行される姿を全身絵でお願いします。\n連行のイメージは下記URLを参考\nhttps://www.pixiv.net/artworks/53592560\nhttps://www.pixiv.net/artworks/44820411\n\n●変身スーツは、スカートパーツと背中から伸びる布マフラーが取り外された状態\n●目・鼻・口が隠れないように、かつ若干ローアングル気味の視点だと嬉しい。\n●表情は、ハイライトの無い虚ろ目(開眼)の状態と、目を閉じ眠っている状態を希望\n●本作は、くちびるの下側の塗りが魅力なので、その塗りがあると嬉しいです。\n●円盤型の飛行物体はあまり大きくなく、全長が頭部ぐらいのサイズ。\n●構図はなるべく全体が入るよう、トリミング少なめを希望。\n\n【その他】\n背景、エフェクトや汗・汚れなどは、レイヤーでオン・オフできるようお願いします。\n\n以上、何卒ご検討下さいますよう宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/18WF8pyr-dFk6VALQulmyHzNQe_o5IURj?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yuu_sagi/works/307", "thumbnail_src": "https://si.imgix.net/6e81c607/uploads/origins/e9eb8bb2-8671-4f1b-83db-9e4e62dc8703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df54e72a8238ad0ea84cd8aa9f52216c", "thumbnail_srcset": "https://si.imgix.net/6e81c607/uploads/origins/e9eb8bb2-8671-4f1b-83db-9e4e62dc8703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df54e72a8238ad0ea84cd8aa9f52216c, https://si.imgix.net/6e81c607/uploads/origins/e9eb8bb2-8671-4f1b-83db-9e4e62dc8703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cb6a713632cc626bd88d819a4234da7 2x, https://si.imgix.net/6e81c607/uploads/origins/e9eb8bb2-8671-4f1b-83db-9e4e62dc8703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15e415f9be7388845f23e5c24e8c81e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuu_sagi/works/306", "thumbnail_src": "https://si.imgix.net/fac2d72d/uploads/origins/c36a3f8b-2d3f-4540-a0ad-8ffd88a660cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c94fdf38bb17070ef741777c5e521085", "thumbnail_srcset": "https://si.imgix.net/fac2d72d/uploads/origins/c36a3f8b-2d3f-4540-a0ad-8ffd88a660cf?bg=%23fff&au