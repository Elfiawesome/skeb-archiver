=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cc7262aadccf2ae392463f330907196 2x, https://si.imgix.net/a7b082d4/uploads/origins/a27a9fea-3e1d-4a2b-9f13-d371fa4093ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee6fd42639114306fd4b4fde86008db2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pmoufu/works/30", "thumbnail_src": "https://si.imgix.net/040acf1f/uploads/origins/82af1362-2efd-42ea-93bb-7495042598f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d58960104e77cd0613a90d0e673e708", "thumbnail_srcset": "https://si.imgix.net/040acf1f/uploads/origins/82af1362-2efd-42ea-93bb-7495042598f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d58960104e77cd0613a90d0e673e708, https://si.imgix.net/040acf1f/uploads/origins/82af1362-2efd-42ea-93bb-7495042598f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4cff504b42b8f9ad774e0fd0e0e0291 2x, https://si.imgix.net/040acf1f/uploads/origins/82af1362-2efd-42ea-93bb-7495042598f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b83d2e1c348da05155b40eeeb9bdac08 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pmoufu/works/29", "thumbnail_src": "https://si.imgix.net/3ce9c393/uploads/origins/8f7a12ae-64e2-402a-afd9-eb64e2f070e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c3004e253c9327e4ce152e24aa6c97d", "thumbnail_srcset": "https://si.imgix.net/3ce9c393/uploads/origins/8f7a12ae-64e2-402a-afd9-eb64e2f070e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c3004e253c9327e4ce152e24aa6c97d, https://si.imgix.net/3ce9c393/uploads/origins/8f7a12ae-64e2-402a-afd9-eb64e2f070e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a5a81c977567ab5773f021d89636357 2x, https://si.imgix.net/3ce9c393/uploads/origins/8f7a12ae-64e2-402a-afd9-eb64e2f070e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d4142f4915ec02ed289ed6825f217aa 3x", "genre": "art", "nsfw": true, "body": "新着でイラストを拝見しましてお願いしたく思いました。\nhttps://skeb.jp/@pmoufu/works/2　https://skeb.jp/@pmoufu/works/16\nなどで描かれていますパンツの感じがとても好みでしたので、以下の内容をお願いしたいと思います。\n\n描いて頂きたいのは「月刊少女野崎くん」の瀬尾結月です。\n\n上記の他のクライアント様のリクエストですと「パンチラ」でしたが、\n彼女がヤンキー座り、または膝立で座ってる状態でのパンモロをお願いします。\n\nポーズ指定については「ぱんつガッツリ見えてほしい」くらいのものなので、上記以外でも結構です。\n\nパンツについてはセクシーなものを履かせて頂けると嬉しいです。\n\nよろしくお願いいたします。\n\nhttps://nan-blog.com/wp-content/uploads/2022/01/IMG_0353-952x1024.jpg", "created_at": "", "completed_at": ""}, {"path": "/@pmoufu/works/28", "thumbnail_src": "https://si.imgix.net/727021fc/uploads/origins/4962df57-6eba-4a19-acba-53f66f09fffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce4ed98bb65b290516ff92c150c1780", "thumbnail_srcset": "https://si.imgix.net/727021fc/uploads/origins/4962df57-6eba-4a19-acba-53f66f09fffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce4ed98bb65b290516ff92c150c1780, https://si.imgix.net/727021fc/uploads/origins/4962df57-6eba-4a19-acba-53f66f09fffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86eb4ea60e29c8e66b10a87af1244fb7 2x, https://si.imgix.net/727021fc/uploads/origins/4962df57-6eba-4a19-acba-53f66f09fffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cb07ba25dbc3afa56e645e9feb73f03 3x", "genre": "art", "nsfw": true, "body": "以前はリクエストを描いていただき、本当にありがとうございました。\nよろしければ、再びリクエストさせてください。\n\n【描いて欲しいキャラ】\nアイドルマスターシャイニーカラーズに登場する、有栖川夏葉でお願いします。\nhttps://shinycolors.idolmaster.jp/idol/hokagoclimaxgirls/natsuha.html\n\n髪型は、上記の画像にあるロングヘアーでお願いします。（デフォルトの髪型です）\n\n【描いて欲しいコスチューム】\nセーラームーンＳに登場する敵キャラ、テルルの魔女服を着させてください。\n黒い服に、緑色のパンスト、黒いハイヒールをはいている画像がテルルの魔女服です。\nhttps://sailormoon.fandom.com/wiki/Tellu_(anime)\n\n【概要】\nあなたの絵柄で描かれる夏葉が見たいです。\nセーラームーンＳに登場する敵キャラ、テルルの魔女服を着た夏葉がプロデューサーめがけ、誘惑のポーズをとっている。\n\n【描いて欲しいシチュエーション】\n・テルルの魔女服を着た夏葉が、プロデューサーに対して誘惑するポーズをとっている。\n・作風に合わない場合は、キャンセルしていただいても構いません。\n\nそれでは、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pmoufu/works/27", "thumbnail_src": "https://si.imgix.net/3cf9802e/uploads/origins/89bdfb2d-13a3-40d7-84b0-127c7c582559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b291f6becc6d373041f5d98273ed171", "thumbnail_srcset": "https://si.imgix.net/3cf9802e/uploads/origins/89bdfb2d-13a3-40d7-84b0-127c7c582559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b291f6becc6d373041f5d98273ed171, https://si.imgix.net/3cf9802e/uploads/origins/89bdfb2d-13a3-40d7-84b0-127c7c582559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1f46cbd0f8bea5eb8cb2cfde5474b25 2x, https://si.imgix.net/3cf9802e/uploads/origins/89bdfb2d-13a3-40d7-84b0-127c7c582559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32c25b3630c0908c183e6d998ee88ab2 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\n喜多日菜子がお風呂場で全裸で体を洗っているシチュエーションのイラストをお願いできますでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@pmoufu/works/26", "thumbnail_src": "https://si.imgix.net/112b297c/uploads/origins/0b5fd21b-2f9e-4400-90c0-943ff857392f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c448e28cf7b4ea7076b2c44173a826c3", "thumbnail_srcset": "https://si.imgix.net/112b297c/uploads/origins/0b5fd21b-2f9e-4400-90c0-943ff857392f?bg=%23fff&auto=format%2Ccompress&fm=webp&f