5-41b9-8d48-9b9cdc8c08fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cb7d319eab799ab13dba9180afaf119", "thumbnail_srcset": "https://si.imgix.net/e511407e/uploads/origins/d8b61c7d-46d5-41b9-8d48-9b9cdc8c08fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cb7d319eab799ab13dba9180afaf119, https://si.imgix.net/e511407e/uploads/origins/d8b61c7d-46d5-41b9-8d48-9b9cdc8c08fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=840e2fc96172830e5c5f2ad1a68e8e01 2x, https://si.imgix.net/e511407e/uploads/origins/d8b61c7d-46d5-41b9-8d48-9b9cdc8c08fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ef6eeb1ebbbe94eca050fdf61954580 3x", "genre": "art", "nsfw": true, "body": "こんにちは、桜日ハルと申します！\nいつもム さまの可愛くてえっちなイラストを拝見しており、いつか私も描いていただきたいなと思っていたので今回リクエストいたしました…！\n\n伝えた内容が難しかったりわかりづらい場合や、こうしたい、こうした方がいい、などあれば、一部内容を省略・変更したり、内容を完全に無視してくださっても大丈夫なので、自由に描いていただけるとうれしいです…！\n\n内容としましては\nこちらのイラスト(https://x.com/muuu0o0/status/1792174141740925119)やこちらの作品(https://x.com/muuu0o0/status/1788933379305755122)がとても好きなので、同じような構図で私のOC兼アバターである、ひつじ娘の桜日ハルを描いていただきたいです…！\n\nシチュエーションは\n発情によって、勝手に溢れ出るくらい母乳がたくさん作られてしまっているが、搾乳機の準備ができておらず、仕方なく自分の手で搾っている、というもので\n搾っている方の胸は濃厚で重たそうな母乳がびゅ…っ とあまり勢いが無さげに噴出していて、乳首はしっかり出ている状態\n搾っていないもう片方は母乳が勝手にぴゅるぴゅるとろとろ溢れ出ている状態で、こちらのイラスト(https://x.com/muuu0o0/status/1751963136503218210)に近いような感じで、乳頭が少し見えるぐらいの陥没気味な胸にしていただきたいです…！\n\n表情などは、上気し、汗ばみ、少し熱っぽいような感じで、発情や胸の張りで辛そうに息が荒く、恥ずかしさの混じったような顔\n\n衣装は完全におまかせしますが、牛コスなどにする場合、耳標タグやカウベルなど、家畜っぽいアイテムも着けていただけると嬉しいです…！\n\nというもので、もしよろしければお願いします…！\n\n設定などはこちらのURL先、「桜日ハル(設定・資料)」という欄のもの\nhttps://profcard.info/u/T8qYyDkjSlTsUZ2PyqiHkKar1jK2\n\n資料はこちらのURL先、和メイド姿のものです\nhttps://x.com/halvital396/status/1753630932857483405?s=46&t=PhnHJnJyxv7in8tNnUZelA", "created_at": "", "completed_at": ""}, {"path": "/@muuu0o0/works/18", "thumbnail_src": "https://si.imgix.net/126e99d3/uploads/origins/5136d10b-a0ae-4120-aa99-d22131d95b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cad7bc7db69537d6c11fa1bfa6977a74", "thumbnail_srcset": "https://si.imgix.net/126e99d3/uploads/origins/5136d10b-a0ae-4120-aa99-d22131d95b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cad7bc7db69537d6c11fa1bfa6977a74, https://si.imgix.net/126e99d3/uploads/origins/5136d10b-a0ae-4120-aa99-d22131d95b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df3a58804f2968c479f6166fd1ada133 2x, https://si.imgix.net/126e99d3/uploads/origins/5136d10b-a0ae-4120-aa99-d22131d95b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51330e99354e8c06e30e70b2ba39a02f 3x", "genre": "art", "nsfw": true, "body": "こんにちは、muuuさん。ミルクを滴らせる巨乳の描き方が大好きです！\n\n私の娘のカリスタを描いてほしい！おっぱいがミルクでいっぱいになりすぎて、あちこちに漏れているので、きつすぎる服を着ることができる。\n\n私のお気に入りはこちら！\n\nhttps://x.com/muuu0o0/status/1796501636573257847\n\nhttps://x.com/muuu0o0/status/1688536540899901440\n\nhttps://x.com/muuu0o0/status/1771864566713950267\n\nhttps://x.com/muuu0o0/status/1750500541116104889\n\nhttps://x.com/muuu0o0/status/1719330553814724652\n\nhttps://x.com/muuu0o0/status/1677307096969408512\n\n恥ずかしがって顔を赤らめてほしい！\n\nhttps://kallista.carrd.co/#reference", "created_at": "", "completed_at": ""}, {"path": "/@muuu0o0/works/17", "thumbnail_src": "https://si.imgix.net/afcae214/uploads/origins/61a02d83-27db-4e18-a405-86aa160fc9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b423542189a33d40b1c4e49376d916c2", "thumbnail_srcset": "https://si.imgix.net/afcae214/uploads/origins/61a02d83-27db-4e18-a405-86aa160fc9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b423542189a33d40b1c4e49376d916c2, https://si.imgix.net/afcae214/uploads/origins/61a02d83-27db-4e18-a405-86aa160fc9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c01b217008bf3acfbd01914cf94d0bfd 2x, https://si.imgix.net/afcae214/uploads/origins/61a02d83-27db-4e18-a405-86aa160fc9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c9933c0a736ebc1c9f4e2e3db4f72e5 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの作品の大ファンで、イラストをお願いしたいです。\nドラガリアロストのラピスとチェルの情熱的なキスをお願いしたいです。ポーズは以前描いていただいたこのイラストのような感じです：\nhttps://skeb.jp/@muuu0o0/works/3\nチェル（金髪の方）がラピスの上に乗っています。あなたのイラストのように、二人は抱き合って舌と唾液でキスをしています。二人は裸ですが、脚タイツを履いています。ラピスがマスクをしていないバージョンもあれば最高ですが、その必要はありません。\nキスのズームもあれば最高です。\nキャラクターの画像をgoogle driveのリンクに添付します。\n量が足りない場合は再送をリクエストしてください。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1V_pr2eQn0PZ2m8Zb47iHrD33oXh5Pvx6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@muuu0o0/works/16", "thumbnail_src": "https://si.imgix.net/f639fce2/uploads/origins/87419cbd-fefe-4c10-ab48-84d13534a265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202a6588e7bfc05b9d6d3d3bbcfdf1c0", "thumbnail_srcset": "https://si.imgix.net/f639fce2/uploads/origins/87419cbd-fefe-4c10-ab48-84d13534a265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202a6588e7bfc05b9d6d3d3bbcfdf1c0, https://si.imgix.net/f639fce2/uploads/origins/87419cbd-fefe-4c10-ab48-84d13534a265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0529c7d04046a9438f671b1a87b4ec45 2x, https://si.imgix.net/f639fce2/uploads/origins/87419cbd-fefe-4c10-ab48-84d13534a265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7db37dc9e3e1b2ff17097892cfae8482 3x", "genre": "art", "nsfw": true, "body": "ニッケの登場人物\nエレグ\nアニス\n\nシナリオ\n2人のキャラクターが積極的な百合の時間を過ごしている。アニスは片方の手でエレグのアソコに指を入れ、片方の手でエレグの胸をもんでいる。エレッグは片方の手でアニスをディープキスで抱きしめ、もう片方の手でアニスの胸を撫でている。\n二人ともほとんど、あるいは完全に裸である。", "created_at": "", "completed_at": ""}, {"path": "/@muuu0o0/works/15", "thumbnail_src": "https://si.imgix.net/9ba6a7b0/uploads/origins/08655c88-d2cd-4d30-9768-4bcf9562f10d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdaeda3f9db48ea40c24cde53a299cb", "thumbnail_srcset": "https://si.imgix.net/9ba6a