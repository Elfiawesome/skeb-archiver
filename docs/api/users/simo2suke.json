f3c4518e7ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=809682b7c17743db24f351196cdc460d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/22", "thumbnail_src": "https://si.imgix.net/68886800/uploads/origins/fd415089-cd68-4c55-85dd-a260206321fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8f7f1a67f8bccee92aacdf9be13f4c7", "thumbnail_srcset": "https://si.imgix.net/68886800/uploads/origins/fd415089-cd68-4c55-85dd-a260206321fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8f7f1a67f8bccee92aacdf9be13f4c7, https://si.imgix.net/68886800/uploads/origins/fd415089-cd68-4c55-85dd-a260206321fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3351cffde914d90bc4037348809db642 2x, https://si.imgix.net/68886800/uploads/origins/fd415089-cd68-4c55-85dd-a260206321fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74142243951a1d912cd2525da16b82d3 3x", "genre": "art", "nsfw": false, "body": "ヴェスピッドとセーリスを描いてほしいね！\n二人とも、人類の楽しみのために月でテレビ中継される戦闘で戦うロボットだ。\n彼らは無人の月面施設に住んでいるので、ほとんどの時間は室内で過ごす。たまにこっそり外に出て、地球や星を眺めることもある。\n\n私は、ヴェスピッドとセーリスが施設の外壁の端に座り、手をつないで星を眺める姿を見たい。データ交換ケーブルで互いに接続し、親密な体験を共有するのもかわいいと思う。ケーブルは耳の近くのポートに接続する。二人の表情や星空が見えるように、正面から少し上を見ている！\n月面施設のデザインはまだ考え中なので、背景は好きなだけ自由に、そしてシンプルに！私は@lefko_dさんの絵にとてもインスパイアされているので、彼らの絵も参考文献に入れておきます。彼らの真っ白な建築はとても好きだけど、布がぶら下がっているのはなくてもいいかもしれない。とにかく、キャラクターがメインであるべきで、環境がメインではありません。\n\nもっと簡単なリクエストとしては、ヴェスピッドかセーリスが、画面の外からもう一人から愛情たっぷりのヘッドパットをもらうのもいいですね。彼らの髪にはたくさんのタッチセンサーがあるので、とても愛情深く反応するでしょうし、すべての感覚データを処理するためにグリッチアウトしてしまうかもしれません！ヴェスピッドは落ち着いていて控えめに振る舞うのに対し、セリースは声が大きく興奮しやすい。また、セーリスはどちらかというとショートスタックだ！\n\nキャラクターの調整は何でもOK！\n\nhttps://drive.google.com/drive/folders/1scarOzBeNzloKlKF2svf2iWLRbV1sg7a", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/21", "thumbnail_src": "https://si.imgix.net/2fb42b51/uploads/origins/65c69a8f-60ac-474f-bd49-92ebccf2eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c23a6e768860e187b036758a41a628", "thumbnail_srcset": "https://si.imgix.net/2fb42b51/uploads/origins/65c69a8f-60ac-474f-bd49-92ebccf2eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c23a6e768860e187b036758a41a628, https://si.imgix.net/2fb42b51/uploads/origins/65c69a8f-60ac-474f-bd49-92ebccf2eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=913f696ffe2617d1a4b5576594d05a5d 2x, https://si.imgix.net/2fb42b51/uploads/origins/65c69a8f-60ac-474f-bd49-92ebccf2eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85ea010573473ca68481aa5c278c4e3b 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです\n巨乳JKロボちゃんの依頼者です\n\n①JKちゃんが新人警察官になってレドナさんと戦う所\n②メンテ中のエッチな１枚絵をお願いします\n\n☆警察官の衣装\n上半身は普通の警察服\n下半身は、黒ニーソ+青いミニスカチャイナで関節の隙間とパンツが横から見える感じ\n\n①戦う所\n無線機で場所を教える新人警察官\nレドナさんが銃を撃つ\n\n②エッチな１枚絵\n描いてほしいのは腰下部分のみ\n斜めからのアングルで、関節稼働部分と性器のある筒が見える状態\nパンツは脱いである\n右上のコマに赤い顔の新人警察官\n両足を根本から外され欠損状態\nCRCスプレーで股関節のメカ部に油をかけられている\n胴体の裏側は肌色\n\n指定してない箇所はお任せします", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/20", "thumbnail_src": "https://si.imgix.net/33db819b/uploads/origins/093c2939-7b3d-4573-b9b0-dc4f834a088a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6babc710b78f68bd22d01f072d7876f3", "thumbnail_srcset": "https://si.imgix.net/33db819b/uploads/origins/093c2939-7b3d-4573-b9b0-dc4f834a088a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6babc710b78f68bd22d01f072d7876f3, https://si.imgix.net/33db819b/uploads/origins/093c2939-7b3d-4573-b9b0-dc4f834a088a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4555e13d3c2c3b9c0fbf4e503d74c01 2x, https://si.imgix.net/33db819b/uploads/origins/093c2939-7b3d-4573-b9b0-dc4f834a088a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=615bccce4b264f36c8f780d9767eb28f 3x", "genre": "art", "nsfw": true, "body": "しもすけ先生初めまして。\nこの度はお世話になります。\n白小俠と申します。\n\nいつもしもすけ先生の作品を拝見しております。\nこの度Skeb募集が再開されたということで、\n僕も大好きなしもすけ先生の素敵な作品に参加できること、とても嬉しく思います。\n\n---------------------------------------------------------------------------\n私のOCが捜査タスクを実行していることを願っていますが、OCに深刻な損傷があり、OCは任務を遂行してかろうじて動いている。\n煙を排出するための機械式狼耳放熱通気口が、煙を上げている。\n\nOC設定：\n　　　　人型白狼 偵察型機械 機械少年\n              番号:BZR-W-2\n　　　　中の電子脳を直接見ることができる超透明な後頭部があり\n　　　　全身メカニックな子，機械式狼耳、獣形脚、しっぽ、円形機械耳（吸気口，\n体つきが6頭身に比例する。\n\n\n\n初めての依頼ですので、失礼がありましたら指摘いただけますと幸いです。\n何卒、よろしくお願いいたします。\n\nURL接続にはOCの画像が添付されます:\nhttps://drive.google.com/drive/folders/16kSPBB2SCYdOzH4qt5p3_pwZTkgeXwek?usp=sharing\n\nhttps://drive.google.com/drive/folders/16kSPBB2SCYdOzH4qt5p3_pwZTkgeXwek?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/19", "thumbnail_src": "https://si.imgix.net/77f2cfa7/uploads/origins/5ebb2b40-240c-4b8d-91e2-ebfc74870d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e469eb37785c5c80dac0030735dc521", "thumbnail_srcset": "https://si.imgix.net/77f2cfa7/uploads/origins/5ebb2b40-240c-4b8d-91e2-ebfc74870d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e469eb37785c5c80dac0030735dc521, https://si.imgix.net/77f2cfa7/uploads/origins/5ebb2b40-240c-4b8d-91e2-ebfc74870d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=038bcfb5eecb3f9f15d13b497448543f 2x, https://si.imgix.net/77f2cfa7/uploads/origins/5ebb2b40-240c-4b8d-91e2-ebfc74870d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5302c1b074eb34128dafe0942ad300c4 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは。また三面図のモデルシートを作っていただけますか？キャラクターは、あなたが短編マンガの依頼で描いたような男性のロボット兵士です。すべてを排除しようとする敵対部隊のように見えるはずです。皮膚のような装甲はありません。全体的に機械的な外見です。\n\nこの依頼のために、2つの別々のシートが欲しい。一枚のモデルシートはロボットの内側の骨格フレーム用で、もう一枚のモデルシートは外側の装甲用である。\n\nロボットのデザインは自由ですが、私が求める唯一の条件は、ロボットがレドナと同じ世界に属しているように見えることです。ロボットが戦うために使う武器の図面もお願いできますか？銃がいいと思いますが、世界のテーマに合うより良い選択があると思えば、それを選んでください。\n\nhttps://twitter.com/simo2suke/status/1688386984665128960", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/18", "thumbnail_src": "https://si.imgix.net/84e61a77/uploads/origins/ae979bf2-a5a2-4e23-a408-4198cb8ce644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69acef52b52a9b6c2be8bceb475e31b9", "thumbnail_srcset": "https://si.imgix.net/84e61a77/uploads/origins/ae979bf2-a5a2-4e23-a408-4198cb8ce644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69acef52b52a9b6c2be8bceb475e31b9, https://si.imgix.net/84e61a77/uploads/origins/ae979bf2-a5a2-4e23-a408-4198cb8ce644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecc26382de3981c6a6d2a6efe3372c68 2x, https://si.imgix.net/84e61a77/uploads/origins/ae979bf2-a5a2-4e23-a408-4198cb8ce644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6fc5d111e1acecb337cfcf378843e38 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/17", "thumbnail_src": "https://si.imgix.net/f3ae8382/uploads/origins/c6050b11-e4e1-4cf1-9fc9-59f5a0e40bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcdd654332bc7aed786698b61fd1ca5a", "thumbnail_srcset": "https://si.imgix.net/f3ae8382/uploads/origins/c6050b11-e4e1-4cf1-9fc9-59f5a0e40bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcdd654332bc7aed786698b61fd1ca5a, https://si.imgix.net/f3ae8382/uploads/origins/c6050b11-e4e1-4cf1-9fc9-59f5a0e40bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3830cce2332014edc92a63e9415c64dd 2x, https://si.imgix.net/f3ae8382/uploads/origins/c6050b11-e4e1-4cf1-9fc9-59f5a0e40bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df47742a6522b80498f79aacdddf282c 3x", "genre": "art", "nsfw": true, "body": "犯された後に捨てられて、ぐったりとしている女兵士のイラストを描いていただきたいです。\n戦う格好のままエッチなことになっているところに敗北感を感じて好きです。\n\n格好はSF風で、全身ぴっちり戦闘スーツにプロテクターというような装備にしてください。\n全身を包むボディスーツが好きです。武器は描かれなくても構いません。\n\nボディスーツが好きなので、極力脱がせたり破ったりしないように描いていただけると嬉しいです。\n股間部分は開いていないと行為ができないと思うので、そこだけ切り開いたようにしてください。", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/16", "thumbnail_src": "https://si.imgix.net/31eda991/uploads/origins/8921ecb6-3868-4c4e-8f22-da440cb6de28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1d7bd853439baa6677765162d1da8ef", "thumbnail_srcset": "https://si.imgix.net/31eda991/uploads/origins/8921ecb6-3868-4c4e-8f22-da440cb6de28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1d7bd853439baa6677765162d1da8ef, https://si.imgix.net/31eda991/uploads/origins/8921ecb6-3868-4c4e-8f22-da440cb6de28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee59ca04467b095511e3320e6b7c1b31 2x, https://si.imgix.net/31eda991/uploads/origins/8921ecb6-3868-4c4e-8f22-da440cb6de28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0523b374158709ceb2cf13753ecaeb8c 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n貴方の描いたエアちゃんのイラストが凄く好みだったのでもしよければ依頼させて頂きたいです！\n\nシチュは、旧時代データ回収の依頼で支払う資産が無いので代わりにエッチな自撮りをくれるエアちゃんでお願いします。\n\n詳しい構図やその他の事はお任せしたいです。\n\nもし可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/15", "thumbnail_src": "https://si.imgix.net/98fe5c71/uploads/origins/762f6de6-5cc1-44ad-b0bb-4c3eff9c18ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1b0112018d8693c23e02857f5537e32", "thumbnail_srcset": "https://si.imgix.net/98fe5c71/uploads/origins/762f6de6-5cc1-44ad-b0bb-4c3eff9c18ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1b0112018d8693c23e02857f5537e32, https://si.imgix.net/98fe5c71/uploads/origins/762f6de6-5cc1-44ad-b0bb-4c3eff9c18ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0139bcc7483452f0adebe2a3e1ab1d31 2x, https://si.imgix.net/98fe5c71/uploads/origins/762f6de6-5cc1-44ad-b0bb-4c3eff9c18ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87d1ef1734c68042aa3490ad723351f8 3x", "genre": "art", "nsfw": true, "body": "遊戯王カードバトルみたいな戦いのエロ漫画が見たくなったので描いていただきたいです\nあなたの創作キャラがハードな目にあう展開ですがよろしくお願いします\n\n*キャラ\n・槍を持った子、以下A\nhttps://twitter.com/simo2suke/status/1292671460150923264\n↑この子\n通常、星4、攻撃力1,400守備1,200\n見た目が好みなので、ギザ歯かわいい、ひどい目に合ってるのが見たい\n\n・異形の足を持ったサイボーグ少女、以下B\nhttps://twitter.com/simo2suke/status/1604139755859415040\n↑この子みたいな感じ\n特殊効果持ち、星7、攻撃1,900守備1,100\n効果：撃破した相手の攻撃守備の半分を吸収し自らの値に加える\n\n敵を足で押さえつけ身動きを封じた後触手を出して相手の力をドレインしてしまう\n足とかパーツデザインはそれ用に追加や調整お願いします\n\n原作初代遊戯王のリョナが好き、振り子刃の拷問機械が手で相手を拘束して真っ二つにするシーンが好きなので大きな足アームで抑え込んでほしい\n\n*構図\n・登場人物は全員女性で、プレイヤーは顔が隠れていても良い\n・Aを場に召喚し敵のモブ敵1体を攻撃し破壊、ターンエンド\n・敵のターン、Bを生贄召喚\n・Bに攻撃を指示、Aに襲い掛かる。Aの両腕の二の腕部分を足パーツで踏んづけて地面にねじ伏せる、Aは悔しそうな表情\n・Bの身体から無数の触手が伸びてくる、Aの顔が恐怖にゆがむ\n・触手が首を締め上げ耳の中や膣内に侵入し吸収開始、Aは吸われてはいけないものを吸われてもがく\n強すぎる快楽や首締めで意識が飛びかかっているような表情だと嬉しいです。また、脳を直接イジられている影響なのか、涙やよだれなどが勝手に大量分泌されて垂れ流されていると嬉しいです。\n\nhttps://ameblo.jp/gxs/entry-11390752243.html\n吸い方は↑こんな感じ\nじゅるじゅると脳みそやら子宮から色々吸われたら駄目なものを吸い出されている感じ\nミイラ化とか干からびるような表現はなしで\n\n・吸われている間Aの攻撃守備がどんどん減少、逆にBの攻撃守備は増加していく\n・吸い尽くされ壊れたAは地面に捨てられる、力を吸ったBの武装が強化される\n\n以上です\n\nよろしくお願いしま", "created_at": "", "completed_at": ""}, {"path": "/@simo2suke/works/14", "thumbnail_src": "https://si.imgix.net/cdabe740/uploads/origins/4d57e692-eb45-4862-a65d-ef35130ff6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=318a7252900cca41df7a9