8-4fee-9e20-10124b386235?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edcbb492a5d61103a0b34080b4756901, https://si.imgix.net/67916f16/uploads/origins/a37a708d-7638-4fee-9e20-10124b386235?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fd7656c144c05c4d94795f164e8d682 2x, https://si.imgix.net/67916f16/uploads/origins/a37a708d-7638-4fee-9e20-10124b386235?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6448b9e5199e314d25f3578122d23507 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@binkyrex2/works/9", "thumbnail_src": "https://si.imgix.net/55e08a05/uploads/origins/d6b53dbf-b099-4a89-8e7c-2d5a3649faeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2640f071720e17312452a970608b4067", "thumbnail_srcset": "https://si.imgix.net/55e08a05/uploads/origins/d6b53dbf-b099-4a89-8e7c-2d5a3649faeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2640f071720e17312452a970608b4067, https://si.imgix.net/55e08a05/uploads/origins/d6b53dbf-b099-4a89-8e7c-2d5a3649faeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8427f8141079464dcf16adeb49df092a 2x, https://si.imgix.net/55e08a05/uploads/origins/d6b53dbf-b099-4a89-8e7c-2d5a3649faeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=358a56b19774d0059e7c1180e1de92de 3x", "genre": "art", "nsfw": true, "body": "キャラ：神谷奈緒\n衣装指定：君に贈るエール\nhttps://imas.gamedbs.jp/cg/idol/detail/73?h=c482479bf8df207d61ce15a3ce4ab3f0\n\n\nチアガール奈緒が可愛いので催眠人形にしてエッチしちゃいます。\n\n楽屋でチアガールに着替えた奈緒\n奈緒「またこんな恥ずかしい衣装を・・・まあ可愛いからいいけどさ」\n男「うーん相変わらずなんでも似合うね奈緒は」\n奈緒「ありがとう・・・って、あんた誰だ！？」\n男「君のご主人様だよ、\"催眠人形\"」男は指を鳴らし奈緒は催眠人形になる。\n\n催眠人形で無表情になった奈緒は男に抱きしめられたり\n服を脱がされおっぱいを吸われたりする。\n奈緒は無表情のままエッチされる。途中で母乳も出る。\n最後に奈緒に中出しエッチをして男は楽屋を去る。\n男「奈緒はもっと深く人形になるんだよ・・・」\n奈緒「はい・・・・」\n\n奈緒は催眠から目が覚めるが催眠中のことは忘れている\n奈緒「あれ？眠っちゃってた？最近疲れ溜まってるのかなー」\n\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@binkyrex2/works/8", "thumbnail_src": "https://si.imgix.net/49918938/uploads/origins/db9b587f-c460-49a2-9631-a16e3823de91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=216cabbd2e65abff7672fcb83233abee", "thumbnail_srcset": "https://si.imgix.net/49918938/uploads/origins/db9b587f-c460-49a2-9631-a16e3823de91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=216cabbd2e65abff7672fcb83233abee, https://si.imgix.net/49918938/uploads/origins/db9b587f-c460-49a2-9631-a16e3823de91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fc32cf15d278134acd4336416730a42 2x, https://si.imgix.net/49918938/uploads/origins/db9b587f-c460-49a2-9631-a16e3823de91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6203746822957c9517f0110ac0153e93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@binkyrex2/works/7", "thumbnail_src": "https://si.imgix.net/c2701a99/uploads/origins/f2101641-e61e-4b9e-ac76-d71ad9d4d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af1caa11c0a8d94138731625e4a184f6", "thumbnail_srcset": "https://si.imgix.net/c2701a9