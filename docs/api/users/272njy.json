-8f56-64bdd9591b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6fd07436635672580382601d3f38b2a 2x, https://si.imgix.net/4eabd242/uploads/origins/b2daa1ff-cfa9-48ea-8f56-64bdd9591b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db4365249fb593186cffeedd00c83ad7 3x", "genre": "art", "nsfw": true, "body": "東方の磐永阿梨夜をお願いします。\n隠れて見えない仮面や服の下に醜い痣がある様子をお願いしたいです。\nその部分を除けばかっこいい男装の麗人感があると助かります。\n下の毛は生やしてください。", "created_at": "", "completed_at": ""}, {"path": "/@272njy/works/5", "thumbnail_src": "https://si.imgix.net/bdf8ca2b/uploads/origins/016cb489-2926-49d8-b25b-ae87c0e99f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00bdd367e4b5147d67f090c7e176e335", "thumbnail_srcset": "https://si.imgix.net/bdf8ca2b/uploads/origins/016cb489-2926-49d8-b25b-ae87c0e99f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00bdd367e4b5147d67f090c7e176e335, https://si.imgix.net/bdf8ca2b/uploads/origins/016cb489-2926-49d8-b25b-ae87c0e99f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1126aad8c1a8b1244cd60960c5766d55 2x, https://si.imgix.net/bdf8ca2b/uploads/origins/016cb489-2926-49d8-b25b-ae87c0e99f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c5d75543d29ba3d373ed256f0e296ca 3x", "genre": "art", "nsfw": true, "body": "東方の宮出口瑞霊をお願いします。\n東方智霊奇伝、6章12話の妖怪の集団に囲まれたコマと血だまりになっているコマの間を補完する絵をお願いできませんか。\nなぶられいたぶられて惨殺される姿が見たいです。\nhttps://x.com/youkia2237/status/1893844140900720654?t=w9nfRImqDoda3do4e2VswA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@272njy/works/4", "thumbnail_src": "https://si.imgix.net/0e0cf637/uploads/origins/96aec845-96e6-494c-ad77-c9757c27267c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3d1ca3107885ddea498c611b3df37e", "thumbnail_srcset": "https://si.imgix.net/0e0cf637/uploads/origins/96aec845-96e6-494c-ad77-c9757c27267c?bg=%23fff&auto=format%2Ccompress&f