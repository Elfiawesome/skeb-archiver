t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cb3d9780fcc2a500707458cf2e0eaf1 2x, https://si.imgix.net/32c110e9/uploads/origins/bc089d9e-7bc3-4591-94f0-22b5e682ffc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d07fcbf19bd321beddd4246840069f5 3x", "genre": "art", "nsfw": true, "body": "老师您好，很喜欢老师的角色，希望可以约她们的三视图https://www.pixiv.net/artworks/136573221", "created_at": "", "completed_at": ""}, {"path": "/@taimanin_tauko/works/44", "thumbnail_src": "https://si.imgix.net/9f465c23/uploads/origins/6b5d87eb-d729-4b1e-8e36-916efe97caa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7008cc0bc11d549f8241074786ecf9f6", "thumbnail_srcset": "https://si.imgix.net/9f465c23/uploads/origins/6b5d87eb-d729-4b1e-8e36-916efe97caa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7008cc0bc11d549f8241074786ecf9f6, https://si.imgix.net/9f465c23/uploads/origins/6b5d87eb-d729-4b1e-8e36-916efe97caa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d5b3a834375386a7ec1eec129780363 2x, https://si.imgix.net/9f465c23/uploads/origins/6b5d87eb-d729-4b1e-8e36-916efe97caa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf370fdc330695702e29dfa8af29f86 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございます。新しいリクエストです。\n登場キャラ：τ子さんのオリキャラのエリートピンク(梨香)とエリートブルー(ナツキ)\n1枚目：悪の組織の総帥(セリフのみの描写)を追い詰めた梨香とナツキ。\n2枚目：総帥によってスーツに仕組まれた細工でスーツの首の部分が伸びて顔を覆われたナツキ。ナツキは台に仰向けでX字拘束され(総帥曰く意思が強いがゆえにしぶとく抵抗して厄介であるとのこと)、工作員(透明モブ。三枚目も同様)にバイブをスーツ越しに胸とオマンコ当てられくぐもった悲鳴をあげる。乳首とオマンコはスーツの表面からわかるほど浮き出る。ナツキの心情付き。\n3枚目：梨香も同様にスーツの首部分が伸びて顔を覆われている。工作員に素手で胸やオマンコをスーツ越しに愛撫され、くぐもった喘ぎ声を出しながら求めるかのように体をくねらせる梨香(総帥曰くナツキと違って抵抗せずむしろマゾになっていたため拘束する必要がなかったとのこと)。ナツキ同様乳首とオマンコはスーツの表面からわかるほど浮き出る。梨香の心情付き。", "created_at": "", "completed_at": ""}, {"path": "/@taimanin_tauko/works/43", "thumbnail_src": "https://si.imgix.net/dcce9d2b/uploads/origins/03473d49-f58b-4d9a-a041-3c296d8ad7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49c26c4c3c36cf430374d93a324c90b9", "thumbnail_srcset": "https://si.imgix.net/dcce9d2b/uploads/origins/03473d49-f58b-4d9a-a041-3c296d8ad7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49c26c4c3c36cf430374d93a324c90b9, https://si.imgix.net/dcce9d2b/uploads/origins/03473d49-f58b-4d9a-a041-3c296d8ad7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e36f11c38d97e98f3ffec5bdf016f2bc 2x, https://si.imgix.net/dcce9d2b/uploads/origins/03473d49-f58b-4d9a-a041-3c296d8ad7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eb33370db82c6286c3291d9883d422d 3x", "genre": "art", "nsfw": true, "body": "前回は大作をありがとうございました！\n同じ様なシチュで恐縮ですが、宜しくお願い致します。\n\n◆キャラ\n　経産婦レイン・ミカムラ（レイン・カッシュ）（32歳）【機動武闘伝Gガンダム】\n　https://x.com/gundam_45th/status/1887773794716295335\n◆コスチューム\n　ファイティングスーツ（レイン・ミカムラ仕様）（破損や破れは極力無し）（アンテナは省略してください）\n◆シチュエーション\n　資料URLの5枚目のように、敵に捕まって凌辱されて写真を撮影されたテイの作品をお願いします。\n\n　・目隠しされてよだれを垂らして快楽落ちの写真。顔は精液でベットリ\n　・カエルのように足を広げてうつ伏せで放心、アナルにバイブが刺さっている写真\n　・目隠しでひょっとこフェラチオさせられている写真\n　・ヌルヌルテカテカのムワムワで描いて頂けると嬉しいです\n\n強い女が男たちに屈服している様子を存分に描いて頂ければと思います。\n\n以上、宜しくお願い致します。\n\nhttps://skeb.jp/@taimanin_tauko/works/32", "created_at": "", "completed_at": ""}, {"path": "/@taimanin_tauko/works/42", "thumbnail_src": "https://si.imgix.net/6eed5158/uploads/origins/06e4092f-f18b-4b75-a809-bd5c940e1528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e487d916b5fdc89eacf9b98f1ac90606", "thumbnail_srcset": "https://si.imgix.net/6eed5158/uploads/origins/06e4092f-f18b-4b75-a809-bd5c940e1528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e487d916b5fdc89eacf9b98f1ac90606, https://si.imgix.net/6eed5158/uploads/origins/06e4092f-f18b-4b75-a809-bd5c940e1528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c863ac0d8f48cc5c3b453ba6cf1eb20 2x, https://si.imgix.net/6eed5158/uploads/origins/06e4092f-f18b-4b75-a809-bd5c940e1528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd07e0d70703457ca66fff4ef21d9427 3x", "genre": "art", "nsfw": true, "body": "また宜しくお願いします。\n\n◆キャラ\n　経産婦レイン・ミカムラ（レイン・カッシュ）（32歳）【機動武闘伝Gガンダム】\n　https://x.com/gundam_45th/status/1887773794716295335\n◆コスチューム\n　ファイティングスーツ（レイン・ミカムラ仕様）（破損や破れは極力無し）（アンテナは省略してください）\n◆シチュエーション\n　参考作品のような感じで、2～3ページほど黒モブに敗北して凌辱されるレイン・ミカムラを描いて頂きたいです。\n参考作品\nhttps://skeb.jp/@taimanin_tauko/works/41\nhttps://skeb.jp/@taimanin_tauko/works/32\n\n・ムレムレの湿度が高い状態で敵と戦っています。\n・強気で戦うもすぐに苦境に立たされる\n・ボディブロー、首締め、鯖折りなどで痛めつけられる（出血や青痣などの描写は無し）\n・脇の臭いを嗅がれたり、キスをされたり、好き勝手に女体を弄ばれる\n・ラストは精液まみれで放置\n\n以上、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@taimanin_tauko/works/41", "thumbnail_src": "https://si.imgix.net/6b8d4c09/uploads/origins/ddd0556e-65ac-418a-855f-2f0a51aeb5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1f5e416e54cb1f0362c9a4555a10679", "thumbnail_srcset": "https://si.imgix.net/6b8d4c09/uploads/origins/ddd0556e-65ac-418a-855f-2f0a51aeb5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1f5e416e54cb1f0362c9a4555a10679, https://si.imgix.net/6b8d4c09/uploads/origins/ddd0556e-65ac-418a-855f-2f0a51aeb5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce9b822f3662576cb307809bd3315613 2x, https://si.imgix.net/6b8d4c09/uploads/origins/ddd0556e-65ac-418a-855f-2f0a51aeb5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0af0e733506d353da2c3dd13636f3d9c 3x", "genre": "art", "nsfw": true, "body": "標的:　ハ幡海鈴　『BanG Dream! Ave Mujica』\n 衣装:ナイト　クロウのようなボディスーツ  普段には薄く黒いマスクを着いた「アニメでライブのような」\nイケメンのような感じにすればよかった  \n夜に常服「アニメのようなブラックジャケット」を着いた海鈴はいきなり戦闘員に襲われ、海鈴は勝利したが、男の幹部を見て、自信満々で来た「変身もなく」\nでも　後にははもう変身した海鈴は土下座で幹部に何かを乞いた。「中略で、何も出来なくて即敗の感じ」\n最後、海鈴は完全敗北し、マスクも幹部で外し「涎つきで濡れた」体の上には「八幡　海鈴」の名前と写真付きの「ヒロイン証」もあった「精液で完全白濁した」\n「彼女はヒロインのことは事前にバレた、幹部はこのように凌辱したい」", "created_at": "", "completed_at": ""}, {"path": "/@taimanin_tauko/works/40", "thumbnail_src": "https://si.imgix.net/39362ca1/uploads/origins/1c93103b-9b31-4da8-919e-f467d4191b27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bfbdfba9581902877a872d94bd716e1", "thumbnail_srcset": "https://si.imgix.net/39362ca1/uploads/origins/1c93103b-9b31-4da8-919e-f467d4191b27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bfbdfba9581902877a872d94bd716e1, https://si.imgix.net/39362ca1/uploads/origins/1c93103b-9b31-4da8-919e-f467d4191b27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0de4ac7d0ae7a342fe9c3d8657c6c8bc 2x, https://si.imgix.net/39362ca1/uploads/origins/1c93103b-9b31-4da8-919e-f467d4191b27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32392f12f7b546c35595ef6fcfd2b44e 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。前回はありがとうございます。 \n新しいリクエストを言います。\nキャラクターは戦隊ピンクの桐原梨香(スーツはマント付きのバージョン)。彼女以外のキャラは独白や台詞のみの言及。\n1枚目：新米ヒーローの少年に敵戦闘員たちの相手を任せ、敵幹部との戦いに行かんとする梨香。イラストは、新米ヒーローの方を振り返って笑顔とサムズアップを送る梨香の絵。新米ヒーローの独白と梨香の台詞付き。\n2枚目：敵戦闘員達を倒した新米ヒーローは心配になって梨香を探し見つけるが、思いもよらぬ彼女の姿に彼は興奮してしまう……イラストは、敵幹部の細工でスーツの首の部分が伸びて顔全体を覆われた梨香が仰向けに倒れてくぐもった喘ぎ声を出しながら着衣オナニー(スーツ越しに胸を揉み、スーツ越しにオマンコをいじる)してアクメを迎える絵。乳首もスーツの表面から分かるほど勃起している。新米ヒーローの独白と梨香の声付き。", "created_at": "", "completed_at": ""}, {"path": "/@taimanin_tauko/works/39", "thumbnail_src": "https://si.imgix.net/fbbdcffe/uploads/origins/78cf5d3e-50f1-4920-a050-3448f55e3cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d32473e35367919241f389f1a9b9e7da", "thumbnail_srcset": "https://si.imgix.net/fbbdcffe/uploads/origins/78cf5d3e-50f1-4920-a050-3448f55e3cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d32473e35367919241f389f1a9b9e7da, https://si.imgix.net/fbbdcffe/uploads/origins/78cf5d3e-50f1-4920-a050-3448f55e3cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e8e21c5e09de6ce3d1527e50766bbe4 2x, https://si.imgix.net/f