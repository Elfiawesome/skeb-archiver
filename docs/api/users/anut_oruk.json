66-41a7-bc71-4f243005cd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b4041782416307812220a99745873a1 2x, https://si.imgix.net/dc4790ce/uploads/origins/6cb33c0d-ef66-41a7-bc71-4f243005cd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26d31debd426742de9370cfa4c4c18c2 3x", "genre": "art", "nsfw": true, "body": "以前お題箱で描いて頂いた、怪盗王子チュ一リッパのリッパくんとアベルくんをリクエストさせてください！\n\n必要無いかとは思いますが、資料ファイルを添付します。\n書籍版にない挿絵もありますので、よければご覧ください。\n※リンク先は納品後削除いたします。\n\nhttps://drive.google.com/file/d/1725rwjkf7av-1EIYnpNsEcC2YjLVrOKo/view?usp=drivesdk\n\n指定はNSFWであることだけですので、シチュエーションや構図などはご自由にお描きください！\n↓夢中になってる二人の続きとかでもOKです！\nhttps://twitter.com/anut_oruk/status/1486349120726237184?t=5SPhf56PHBlLCQUMDDmLdQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@anut_oruk/works/4", "thumbnail_src": "https://si.imgix.net/e2344511/uploads/origins/bb385cfd-b50d-475d-bd07-9498a5d88c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9accf3edfc7d155824dc878b7e07e820", "thumbnail_srcset": "https://si.imgix.net/e2344511/uploads/origins/bb385cfd-b50d-475d-bd07-9498a5d88c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9accf3edfc7d155824dc878b7e07e820, https://si.imgix.net/e2344511/uploads/origins/bb385cfd-b50d-475d-bd07-9498a5d88c77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=087a2eb0ce094e11b443203c3e3918ea 2x, https://si.imgix.net/e2344511/uploads/origins/bb385cfd-b50d-475d-bd07-9498a5d88c77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ae13f1c32af891fbaebdfef1b8a3c41 3x", "genre": "art", "nsfw": false, "body": "例によってまた特殊なヘキのリクエストを恐れ入ります。\n\n画像を横長として、画面中央下寄りに枝木に引っ掛かった風船があり、その両サイド上寄りにおなかが風船の如く大きく膨らんだカクくん・イムラくんが浮いている様子を頂きたいです。\n\nこの様子に至るシナリオとしては、引っ掛かった風船を取ってほしいという謎仕事に「風船になって取りに行けば良い」という謎提案を強行された……のかも知れません。\n\n例によってカクくんは白おなかが映えるポーズで希望しており、これにより目的の風船には手が届いていない想定です。\nイムラくんは顔のサイズまで大きくしないよう留意いただければ膨らんだ感が出ると思います。\nまた、2人は膨満感でち