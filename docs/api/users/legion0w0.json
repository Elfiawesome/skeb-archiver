d21c91/uploads/origins/d8cead7f-bb6e-4cda-9e16-4d86c5bcb5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d192141569b0bf6e294854363e79878 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/52", "thumbnail_src": "https://si.imgix.net/218f245a/uploads/origins/bfd306a0-8c48-4818-8f01-2c0759b53d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6328f2dc05648db279115312c0a7f350", "thumbnail_srcset": "https://si.imgix.net/218f245a/uploads/origins/bfd306a0-8c48-4818-8f01-2c0759b53d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6328f2dc05648db279115312c0a7f350, https://si.imgix.net/218f245a/uploads/origins/bfd306a0-8c48-4818-8f01-2c0759b53d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9acdab164ca2c866c65caf9f59c8ad9 2x, https://si.imgix.net/218f245a/uploads/origins/bfd306a0-8c48-4818-8f01-2c0759b53d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23a68f4c9fe57b005ac96b7ac3b6fc96 3x", "genre": "art", "nsfw": true, "body": "黒谷ヤマメの毒で膨乳する赤蛮奇のイラストをお願いいたします。\n糸で四肢を拘束された蛮奇が後ろからヤマメに噛まれ(または刺され)て毒を入れられおっぱいが大きくなり母乳も噴き出してしまう感じでお願いします。おっぱいの大きさはおまかせします。好きなだけ盛って下さい。\n差し支えなければ大きくなったおっぱいに子蜘蛛(ロリヤマメ)達がしがみついてる様子もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/51", "thumbnail_src": "https://si.imgix.net/c5cf51a8/uploads/origins/02a44dc7-34fd-4a01-8660-dfc08272cd22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d94130408b21676a370b4bb2cd03cb4c", "thumbnail_srcset": "https://si.imgix.net/c5cf51a8/uploads/origins/02a44dc7-34fd-4a01-8660-dfc08272cd22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d94130408b21676a370b4bb2cd03cb4c, https://si.imgix.net/c5cf51a8/uploads/origins/02a44dc7-34fd-4a01-8660-dfc08272cd22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eaa1a4003a1ea97288a6641fd54b295f 2x, https://si.imgix.net/c5cf51a8/uploads/origins/02a44dc7-34fd-4a01-8660-dfc08272cd22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01b474096ea0436be94d36e00d3cfcf2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/50", "thumbnail_src": "https://si.imgix.net/cb9c0fd9/uploads/origins/073bc179-bba4-4181-abe5-bde97ed3c1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734a1f753b2f39706aa6bf384a186b39", "thumbnail_srcset": "https://si.imgix.net/cb9c0fd9/uploads/origins/073bc179-bba4-4181-abe5-bde97ed3c1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734a1f753b2f39706aa6bf384a186b39, https://si.imgix.net/cb9c0fd9/uploads/origins/073bc179-bba4-4181-abe5-bde97ed3c1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b27ed0af8007734b089f027ea85a12df 2x, https://si.imgix.net/cb9c0fd9/uploads/origins/073bc179-bba4-4181-abe5-bde97ed3c1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0a4ba4f6eb25bb4b783ace9d639ea77 3x", "genre": "art", "nsfw": true, "body": "【キャラクター】\n◆ファイアーエムブレム烈火の剣に登場するリン(水着衣装)をリクエストさせてもらいます。\n\n【シチュ】\n◆女性が発情してしまうエッチな地形効果がある異界のビーチで発情したリンがモブ男(普通体型)たちと乱交エッチする…というシチュでお願いします。\n\n【体位や構図】\n◆体位や構図はおまかせします.。\n　①竿役の数は2～3人ぐらいでお願いします。\n　②気持ちよさそうに乱交しているという風にお願いします。\n　③竿役の男たちは全身写さず下半身周辺が画面に入り込むぐらいの写り込みでお願いします。\n　④NG要素で　\n　　・過度なアヘ顔\n　　・口をすぼめたフェラ\n　　はNGでお願いします。\n\nhttps://guide.fire-emblem-heroes.com/06001002000396/", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/49", "thumbnail_src": "https://si.imgix.net/2f388492/uploads/origins/c21cc666-844c-45f8-8c5d-38278765e372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91ac9a82c972927deac9455cebd7634a", "thumbnail_srcset": "https://si.imgix.net/2f388492/uploads/origins/c21cc666-844c-45f8-8c5d-38278765e372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91ac9a82c972927deac9455cebd7634a, https://si.imgix.net/2f388492/uploads/origins/c21cc666-844c-45f8-8c5d-38278765e372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38a241e7fb9b27b297300068b1a462e0 2x, https://si.imgix.net/2f388492/uploads/origins/c21cc666-844c-45f8-8c5d-38278765e372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cf765aca4b2b4fb20ba641ab647c03f 3x", "genre": "art", "nsfw": true, "body": "はじめまして、\n\n過去に描かれていた下記のバニー紫様のラフイラストが非常に好きで\nhttps://x.com/legion0w0/status/1715351682824216582/photo/1\n\nどうしてもあの格好のえちち絵が見たいので描いていただけないでしょうか？\n\nできればいつも描かれているような、人里の男の子誑かすシリーズのような\n誘う女的な雰囲気だと嬉しいです。\n\nよろしければお願いします", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/48", "thumbnail_src": "https://si.imgix.net/09e1c1df/uploads/origins/426d1e15-f270-479e-896f-f439a196acf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ff89d07106cae4fb5d94190e2418edf", "thumbnail_srcset": "https://si.imgix.net/09e1c1df/uploads/origins/426d1e15-f270-479e-896f-f439a196acf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ff89d07106cae4fb5d94190e2418edf, https://si.imgix.net/09e1c1df/uploads/origins/426d1e15-f270-479e-896f-f439a196acf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8d142f4a28fad632c80fc925288e9fa 2x, https://si.imgix.net/09e1c1df/uploads/origins/426d1e15-f270-479e-896f-f439a196acf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ed8d0126b14a6bde8ce07de3043f55e 3x", "genre": "art", "nsfw": true, "body": "アトリエシリーズのリラの寝バック\n腹ボコマシマシでお願いします\nhttps://dic.pixiv.net/a/%E3%83%AA%E3%83%A9%E3%83%BB%E3%83%87%E3%82%A3%E3%82%B6%E3%82%A4%E3%82%A2%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/47", "thumbnail_src": "https://si.imgix.net/7c4dae32/uploads/origins/d8058246-64cf-4c72-8322-6bf9e7d57c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a20dd150c4651f78e3f5b95c65295fe4", "thumbnail_srcset": "https://si.imgix.net/7c4dae32/uploads/origins/d8058246-64cf-4c72-8322-6bf9e7d57c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a20dd150c4651f78e3f5b95c65295fe4, https://si.imgix.net/7c4dae32/uploads/origins/d8058246-64cf-4c72-8322-6bf9e7d57c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=883b96fda04e3045be6466c517856d40 2x, https://si.imgix.net/7c4dae32/uploads/origins/d8058246-64cf-4c72-8322-6bf9e7d57c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcf1395161eb94d344caf086b0fc772a 3x", "genre": "art", "nsfw": true, "body": "前回のパルスィありがとうございました\nまた依頼させて頂きたいと思います\nキャラ：メルラン・プリズムリバー\n今回は彼女の催眠撮影会をお願いします\nガニ股でアソコから精子を垂らしピースしながら彼女の右手には初Hの後にサイン色紙によくある手形の代わりにアソコから取られたマン拓が入った彼女の名前入り色紙を持たせてください\n竿役のオッさんは彼女のブラを持ちながら横か後ろに立ってる感じで\n彼女の表情差分としましては目をハートにしウィンクしながらの笑顔に加え催眠が解けて涙目で青ざめてる表情を\nそれと通常に加え以前のHで孕んでいるためボテ腹かつデカパイから母乳が出てる状態をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/46", "thumbnail_src": "https://si.imgix.net/b521c4d7/uploads/origins/97ab2380-026c-4017-8119-1db8f64a0e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24287a50149aae826ae6b7b9ffe81c00", "thumbnail_srcset": "https://si.imgix.net/b521c4d7/uploads/origins/97ab2380-026c-4017-8119-1db8f64a0e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24287a50149aae826ae6b7b9ffe81c00, https://si.imgix.net/b521c4d7/uploads/origins/97ab2380-026c-4017-8119-1db8f64a0e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ed6b6c03b1ca129db38ce44827df616 2x, https://si.imgix.net/b521c4d7/uploads/origins/97ab2380-026c-4017-8119-1db8f64a0e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caf62c43baf964d0d171d32852a05882 3x", "genre": "art", "nsfw": true, "body": "前回はメルランありがとうございます\nまた依頼させて頂きたいと思います\n今回は水橋パルスィは催眠Hをお願いします\nシチュエーションとしましてはおっさんに催眠をかけられた彼女が連れ込まれて催眠Hしてる場面をお願いします\nアングルはヘッドボードアングルでおっさんが彼女のデカパイに顔を埋めながら突きまくってる感じで\nパルスィの服装は普段着を着崩して上着の下のレオタードを谷間に寄せ胸が露出\n差分は中出しや受精\n表情は催眠顔やアヘ顔に加え途中催眠が解けて嫌がって泣き顔になってる表情をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/45", "thumbnail_src": "https://si.imgix.net/8eb79e71/uploads/origins/4f2fd2d5-054a-4183-ab63-0d1673bf6ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb5c3483382dae9f3347fdb2ebb509c", "thumbnail_srcset": "https://si.imgix.net/8eb79e71/uploads/origins/4f2fd2d5-054a-4183-ab63-0d1673bf6ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb5c3483382dae9f3347fdb2ebb509c, https://si.imgix.net/8eb79e71/uploads/origins/4f2fd2d5-054a-4183-ab63-0d1673bf6ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2c5b19bdbc68e998b39370d94666f2e 2x, https://si.imgix.net/8eb79e71/uploads/origins/4f2fd2d5-054a-4183-ab63-0d1673bf6ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c77a6ed1e031b7bfc75f6f9bbadc245c 3x", "genre": "art", "nsfw": true, "body": "レギヲン様以前は催眠メルランを描いて頂きありがとうございました\n今回も催眠メルランで依頼をさせていただきたいと思いますのでよろしくお願いします\n\nシチュエーション：お腹はまだ大きくなっていませんが前回の行為で孕んだメルランちゃんの母乳が出るデカパイにおっさんがむしゃぶりつきながらHしている場面をお願いします\n服装は前回と同じで\n体位は描きやすい物で大丈夫ですのでお任せいたします\n表情差分としましては催眠顔にアヘ顔それと可能であれば行為中に催眠解除されてからの絶望顔\nあとは断面図や中出しや潮吹きなど\nそれと周りにはデカブラなどの下着を置いて欲しいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/44", "thumbnail_src": "https://si.imgix.net/fecd6a00/uploads/origins/ba79d9ad-44c3-473b-b95c-0ddaa798facd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=529ccf065e0bbf18504605d125645c91", "thumbnail_srcset": "https://si.imgix.net/fecd6a00/uploads/origins/ba79d9ad-44c3-473b-b95c-0ddaa798facd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=529ccf065e0bbf18504605d125645c91, https://si.imgix.net/fecd6a00/uploads/origins/ba79d9ad-44c3-473b-b95c-0ddaa798facd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c20ef9c48d2b09d37469c476d9f27236 2x, https://si.imgix.net/fecd6a00/uploads/origins/ba79d9ad-44c3-473b-b95c-0ddaa798facd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae8445621de6a3c93b54c8e2484a3aef 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n東方キャラのムチムチエッチな絵に惹かれたので依頼させていただきます。\n\nエロボディのルーミアが性的に襲って来る感じのイラストをお願いしたいです。\n\n以下細かい要望です。\n・夏なので暑くて汗をかいている状態にして下さい。\n・夏なので暑くて局部丸出しのエロ衣装(もしくは全裸)にして下さい。\n・表情は捕食者の顔でお願いします。\n\n以上になります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@legion0w0/works/43", "thumbnail_src": "https://si.imgix.net/49854698/uploads/origins/9881cfc6-6180-4f2b-9840-23f8035d7f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39b01e2119c5a25eff9a1d5b0ced362a", "thumbnail_srcset": "https://si.imgix.net/49854698/uploads/origins/9881cfc6-6180-4f2b-9840-23f8035d7f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39b01e2119c5a25eff9a1d5b0ced362a, https://si.imgix.net/49854698/uploads/origins/9881cfc6-6180-4f2b-9840-23f8035d7f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc987fda01baaea69ba0e3a0f7f881d1 2x, h