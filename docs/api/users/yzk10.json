8-f31c78e8bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee109fcb935008053949992008c79e79, https://si.imgix.net/a56cfdcf/uploads/origins/96b418d0-1994-4cfe-abb8-f31c78e8bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abd088e322ea5784e584850ea083fdb7 2x, https://si.imgix.net/a56cfdcf/uploads/origins/96b418d0-1994-4cfe-abb8-f31c78e8bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe044da01747148e2831f00a1b9e1fec 3x", "genre": "art", "nsfw": true, "body": "ゆずきさん、こんにちは。また新たなビル裏野ションイラストをリクエストさせていただきます。\n①キミとアイドルプリキュアより蒼風なな(服装については後述します)、正面向き\n②シチュエーション：いつもと同じで大丈夫です(寒い中ビル裏にてパンツを膝上まで下ろしてしゃがみ野ション、地面には大きな黄色い水たまり)。\n③服装差分：前回と同様に私服(冬服)verとはなみち中学校制服姿verでお願いします。\n以上になります。今回もどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yzk10/works/469", "thumbnail_src": "https://si.imgix.net/5897e02b/uploads/origins/16476b0b-c7e9-4c27-8983-bb9264c40b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eddf8351413a7e1a22637985febe8fa", "thumbnail_srcset": "https://si.imgix.net/5897e02b/uploads/origins/16476b0b-c7e9-4c27-8983-bb9264c40b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eddf8351413a7e1a22637985febe8fa, https://si.imgix.net/5897e02b/uploads/origins/16476b0b-c7e9-4c27-8983-bb9264c40b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=311b3d6c0a7c5584189a8c49a6144b3f 2x, https://si.imgix.net/5897e02b/uploads/origins/16476b0b-c7e9-4c27-8983-bb9264c40b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=665d41b95b64ae6e7c511e4e89b2eea3 3x", "genre": "art", "nsfw": true, "body": "ホロライブの姫森ルーナのイラストを依頼します。突然裸で縮んでしまい、服は全て足元や周囲に散らばっています。胸と股間が露出し、恥ずかしさと困惑の表情を浮かべています。その他の詳細はご自由にお願いします。よろしくお願いします。https://imgchest.com/p/9p4nkorob4n", "created_at": "", "completed_at": ""}, {"path": "/@yzk10/works/468", "thumbnail_src": "https://si.imgix.net/74e399ae/uploads/origins/d99ccb56-5aa9-437d-a8db-caf7dc1bf6ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a7e447d70acb849bb54b9df4ea36fd7", "thumbnail_srcset": "https://si.imgix.net/74e399ae/uploads/origins/d99ccb56-5aa9-437d-a8db-caf7dc1bf6ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a7e447d70acb849bb54b9df4ea36fd7, https://si.imgix.net/74e399ae/uploads/origins/d99ccb56-5aa9-437d-a8db-caf7dc1bf6ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5383b652a823a72dc8eb458685e9c53f 2x, https://si.imgix.net/74e399ae/uploads/origins/d99ccb56-5aa9-437d-a8db-caf7dc1bf6ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3df40ac5fa9a0730f541e6f588cf41cb 3x", "genre": "art", "nsfw": true, "body": "いつも作品を楽しく拝見しております。\n\n以前よりパンツが脱げてしまったウルトラレディ・マインのイラストシリーズを依頼している者です。\n\n前回も素晴らしいイラストをありがとうございました。\n\n今回で一旦一区切りにしたいと思います。\n\n\n○シチュ\n\n・敵を倒してパンツを取り返し、恥ずかしげにパンツのサイドの紐を結んで穿き直しているウルトラレディ・マイン。\n\n・マインの足下には群衆が群がり、写真を撮っている。\n\n・マインはカラータイマーが赤く点灯した状態で、赤面して恥ずかしがっている。\n\n・群衆はシルエット処理等、最小限の描写で構いません。\n\n以上となります。\n\n是非よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yzk10/works/467", "thumbnail_src": "https://si.imgix.net/e3ec1b36/uploads/origins/54d43b39-bce9-4821-839b-c8c3b4a55d58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=014d7641e91798632ee3bc90895a98cd", "thumbnail_srcset": "https://si.imgix.net/e3ec1b36/uploads/origins/54d43b39-bce9-4821-839b-c8c3b4a55d58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=014d7641e91798632ee3bc90895a98cd, https://si.imgix.net/e3ec1b36/uploads/origins/54d43b39-bce9-4821-839b-c8c3b4a55d58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4efdb0ac3158ac3a08c42f7fb5bf6598 2x, https://si.imgix.net/e3ec1b36/uploads/origins/54d43b39-bce9-4821-839b-c8c3b4a55d58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37690caf09964ce6853908d32880fb60 3x", "genre": "art", "nsfw": true, "body": "いつも素敵な作品をありがとうございます。\n\nこちらの作品\n\nhttps://skeb.jp/@yzk10/works/459\n\nの続きをリクエストしたいです。\n\n○シチュ\n\n・恥を忍んで敵の宇宙人に逆転のハイキックを放つウルトラレディ・マイン。\n\n・マインはカラータイマーが赤く点灯した状態で、I字バランスの様な体勢で大股を開いて蹴りを繰り出して股間が丸見えの状態。勇ましい表情を浮かべているが、羞恥心を完全には捨てきれずに赤面して恥ずかしがっている。\n\n・マインの膝下のあたりで、敵の手から落ちたマインの紐パンがヒラヒラと宙を舞っている。\n\n・マインに蹴られている敵自体の描写は不要です。\n\n・背景はこれまで通り、白昼の市街地でお願い致します。\n\n以上です。\n是非よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yzk10/works/466", "thumbnail_src": "https://si.imgix.net/c21a45e5/uploads/origins/f3ded8ca-7304-44e0-a855-de9e020fd84b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48928a61b76c95a47f8d11349a3c8b99", "thumbnail_srcset": "https://si.imgix.net/c21a45e5/uploads/origins/f3ded8ca-7304-44e0-a855-de9e020fd84b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48928a61b76c95a47f8d11349a3c8b99, https://si.imgix.net/c21a45e5/uploads/origins/f3ded8ca-7304-44e0-a855-de9e020fd84b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f66aaafa9fd9ae9d4a03171cd75d2c71 2x, https://si.imgix.net/c21a45e5/uploads/origins/f3ded8ca-7304-44e0-a855-de9e020fd84b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02dd8e9a8586239e86f0f3a879d990de 3x", "genre": "art", "nsfw": true, "body": "ゆずきさん、こんにちは。また新たなビル裏しゃがみ野ションイラストをリクエストさせていただきます。\n①キャラクター：キミとアイドルプリキュアより咲良うた(服装については後述します)、正面向き\n②シチュエーション：いつもと同じで大丈夫です(寒い中でビル裏にてパンツを膝上まで下ろしてしゃがみ野ション、地面には大きな黄色い水たまり)。\n③服装差分について\n1、はなみち中学校制服姿\n2、私服(冬服)姿\n以上になります。今回もよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yzk10/works/465", "thumbnail_src": "https://si.imgix.net/ec96c094/uploads/origins/185a4212-7cfb-4f41-ba61-ae3b89d48dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d50023cf9052060fa5be737d10506e19", "thumbnail_srcset": "https://si.imgix.net/ec96c094/uploads/origins/185a4212-7cfb-4f41-ba61-ae3b89d48dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro