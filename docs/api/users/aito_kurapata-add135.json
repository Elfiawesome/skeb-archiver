f4-c79be2176ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dddac82beef27a9d8953173c2dd031b1, https://si.imgix.net/54c38823/uploads/origins/f52e58c0-bcd7-4230-a8f4-c79be2176ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10324c94bb636f8bbe59ad28a4fcd3b8 2x, https://si.imgix.net/54c38823/uploads/origins/f52e58c0-bcd7-4230-a8f4-c79be2176ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d75a715c8528d444bb4dbfab66e17f2b 3x", "genre": "art", "nsfw": false, "body": "平素よりお世話になっております。\nいつも配信楽しく拝見させて頂いてます。\n\n今回依頼したいのは、Vtuberの「夜空めぐる」（よぞらめぐる）さんという方のファンアートになります。\n\n濃い紫の方とピンクの派手な方の２種類の方がいると思いますが。ピンクの派手な方の方でお願いします。\n10月17日にデビュー1周年とのことで、それに合わせて何か素敵なサプライズを贈りたいなと思い、寿倉さんに依頼させて頂きました。\n今回は、２枚イラストを御依頼したく思います。\n\n普段は、相棒のウサギであるルナというキャラクターを隣に、アプリゲーム原神や音楽ゲームギタドラの配信をされてる方なので、ギターを弾いている姿のカッコいいイラストを１枚欲しいです。\nそれと、もう１枚は、時期が時期なのでハロウィンを意識したウサギの格好をしている可愛いイラストなどをお願いします。\n\n配信だったりでサムネとかで扱えるような大きさのイラストを願います。\nヨロシクお願い致します。\nTwitterのIDは　@yozorameguru02　になります。\n\nhttps://images.app.goo.gl/42wfoU9uHr8yh6XX6", "created_at": "", "completed_at": ""}, {"path": "/@aito_kurapata/works/5", "thumbnail_src": "https://si.imgix.net/5f78caee/uploads/origins/6f166803-2dc4-40f3-b052-08dadce24a01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a1fc5f73767f7efc78f62c59b9f804a", "thumbnail_srcset": "https://si.imgix.net/5f78caee/uploads/origins/6f166803-2dc4-40f3-b052-08dadce24a01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a1fc5f73767f7efc78f62c59b9f804a, https://si.imgix.net/5f78caee/uploads/origins/6f166803-2dc4-40f3-b052-08dadce24a01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d9cc57702544e6543787318a72dab06 2x, https://si.imgix.net/5f78caee/uploads/origins/6f166803-2dc4-40f3-b052-08dadce24a01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cc5609964026d8c0f3030c275c9c20d 3x", "genre": "art", "nsfw": 