c9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c4680f793980895d9460824b082ba3", "thumbnail_srcset": "https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c4680f793980895d9460824b082ba3, https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0949100733c15c03da28cdc12166d08f 2x, https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c3fa786d52383656b33376128f38af6 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼致します\n\n―――\n\nもし！よかったら！！虫干しのために屋内で本を広げて並べている最中の乙部江さん(いつもの大正ロマン系統なお姿)の絵を見たいです！！！\n亡夜様の古書店(兼住居？)のどこかに丁度いい和室があるようでしたら、畳にぺたんと座って本の山傍らにその作業をされているようなご様子だと嬉しいです、よろしくお願いします……！\n\n―――\n\n微力ながら栄養のあるものを召し上がるお力添えになれれば幸いです", "created_at": "", "completed_at": ""}, {"path": "/@sousaku_mafu/works/1", "thumbnail_src": "https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e83751350e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05c9edbea0d3ef9217e88062d685591a", "thumbnail_srcset": "https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e83751350e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05c9edbea0d3ef9217e88062d685591a, https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e83751350e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ba38ca212a1dfd0c98b0318eb192d80 2x, https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e83751350e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8e229988f9aff6ce97cc3446f49ca4a 3x", "genre": "art", "nsfw": false, "body": "ついに実際の肉体を得た豆腐の一枚絵が欲しいです！\n\n豆腐(邪神)(魔女)の隠れ家的な背景で、個人的にココフォリアのむつーさんの広告をイメージしてます。\n\n中世ヨーロッパ的な、RPGの薬屋みたいな感じですかね…\n中の人が本読むの好きで、法律系なので本と天秤とかあると個人的にテンション上がります…！\n\nあと「絹ごし豆腐」のアイコンも個人的に気に入ってるので「あの服」がチラリしてると舞います。\n\nーーーーーーーーーー\nあとここで言う事じゃないけど、美味しいもの食べて、良く寝て、いいメガネして(笑)6月乗り切ってね！\n\n※サイレンの立ち絵も別で頼みたいけど、そっちもしかしたら値引き交渉しちゃうかも…(土下座)\n\nhttps://twitter.com/mutuu24/status/1498319671707467777?s=21&t=ipifItYOACoZtxJC-o26Ww", "created_at": "", "completed_at": ""}]}