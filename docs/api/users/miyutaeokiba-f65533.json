8a-a0f9-04ad76e1bb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7df9ba912240615cf4978945b2b4a29 2x, https://si.imgix.net/a33393a9/uploads/origins/c5614b03-0f64-4d8a-a0f9-04ad76e1bb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3104ddfd797850ff80022c570e01605 3x", "genre": "art", "nsfw": false, "body": "初めまして！素敵な動物たちのイラストに惹かれリクエストさせて頂きました！\n\n✎︎＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n\n【依頼内容】\n・ジャンガリアンハムスター（グレー）とおにぎりのイラストを書いていただきたいです！\n\n・ハムスター、おにぎりのふたつの要素の他に特に構図などの指定は無く、お任せしたいです！\n\n【その他】\n・ハムスターは丸々としていて可愛らしい様子だと嬉しいです🌸\n\n・おにぎりについては一般的な人間用の大きなものでも、ハムスターが作ったような小さなおにぎりでも問題ありません…！具などもお任せします！\n\n【資料】\nハムスターの模様のイメージを資料内に入れています！\n【 https://drive.google.com/drive/folders/1iLKT6vLru43Zu0Q5FH2MBYW_C7owtuXv 】\n\n✎︎＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n\nぜひ、こまちみゆた様の絵柄でのハムスターとおにぎりのイラストが見たいです！上記の内容で問題がなければご検討いただけますと幸いです、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@miyutaeokiba/works/44", "thumbnail_src": "https://si.imgix.net/6c796db4/uploads/origins/a3bb025e-1112-4dbd-8ef7-0fd15da98c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e25631b3fc859ea217ba623d5880bc8c", "thumbnail_srcset": "https://si.imgix.net/6c796db4/uploads/origins/a3bb025e-1112-4dbd-8ef7-0fd15da98c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e25631b3fc859ea217ba623d5880bc8c, https://si.imgix.net/6c796db4/uploads/origins/a3bb025e-1112-4dbd-8ef7-0fd15da98c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93dab1eaa0bbcb256b58668709bf6b53 2x, https://si.imgix.net/6c796db4/uploads/origins/a3bb025e-1112-4dbd-8ef7-0fd15da98c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=20