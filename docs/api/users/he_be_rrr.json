前回は素晴らしい作品ありがとうございました\n\n今回もへーべーさんのオリキャラ侍娘の「半刻紅葉」をお願い致します。\n\nシチュエーション\n半刻紅葉が海辺の岩壁に鎖で拘束されている状態、でお願いします\n手は手枷付きの鎖で岩壁に繋がれ、足は膝上くらいまで海水に浸かっている\n資料参照(あくまでアングル等の参考なのでポーズ等のある程度の変更はお任せします)\n服はhttps://skeb.jp/@he_be_rrr/works/244のように鉢金と上着だけ着ていてる\n\n訪れた村の住人に騙され、海の妖怪の生贄にされているという設定\n足元の水中から長いタコの足のようなもの(もしくはスライム的なもの)が伸びて、足や胸等に絡みついている\n体中を色々触られて感じているが、何とか逃げようと抵抗している\n\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1qY_eiMAEMocTICzz0_lDjyEbd1KfwR6O/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@he_be_rrr/works/284", "thumbnail_src": "https://si.imgix.net/263a19a8/uploads/origins/327c77d1-187d-4c12-a9bd-34c8be626d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=989459112aebf811915b148c600d917c", "thumbnail_srcset": "https://si.imgix.net/263a19a8/uploads/origins/327c77d1-187d-4c12-a9bd-34c8be626d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=989459112aebf811915b148c600d917c, https://si.imgix.net/263a19a8/uploads/origins/327c77d1-187d-4c12-a9bd-34c8be626d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e88ef9a9da15fe73147466f2139bbac1 2x, https://si.imgix.net/263a19a8/uploads/origins/327c77d1-187d-4c12-a9bd-34c8be626d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b5795c154d61081438e5f4642384a99 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@he_be_rrr/works/283", "thumbnail_src": "https://si.imgix.net/0aeeb16c/uploads/origins/c252d9b1-b165-497e-a79e-12c727495641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&