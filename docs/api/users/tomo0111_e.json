をそれぞれ腕甲･ブーツサンダル(ベルト付きブーツ、ヒヨルムが履いてるものがそれ)に着替える\n\n・決闘なので二人ともある程度のダメージはあるといいかも\n・表情は2人とも勝負を楽しんでいる顔で\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tomo0111_e/works/157", "thumbnail_src": "https://si.imgix.net/db4af0c3/uploads/origins/9a54d85c-aabc-4f32-bb92-c3baf093f13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03c299fc1d79c59fa43fabb5ca401691", "thumbnail_srcset": "https://si.imgix.net/db4af0c3/uploads/origins/9a54d85c-aabc-4f32-bb92-c3baf093f13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03c299fc1d79c59fa43fabb5ca401691, https://si.imgix.net/db4af0c3/uploads/origins/9a54d85c-aabc-4f32-bb92-c3baf093f13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98c4d555219e776b1170d43d24d616e1 2x, https://si.imgix.net/db4af0c3/uploads/origins/9a54d85c-aabc-4f32-bb92-c3baf093f13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=423147cf92805df03d303d8e56f099f3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tomo0111_e/works/156", "thumbnail_src": "https://si.imgix.net/f8a84b02/uploads/origins/56819081-0a85-478b-ab6c-0bb7cb45470e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75dcd663e40a413e22bdf47654737e3f", "thumbnail_srcset": "https://si.imgix.net/f8a84b02/uploads/origins/56819081-0a85-478b-ab6c-0bb7cb45470e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75dcd663e40a413e22bdf47654737e3f, https://si.imgix.net/f8a84b02/uploads/origins/56819081-0a85-478b-ab6c-0bb7cb45470e?