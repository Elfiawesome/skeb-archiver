いです。\n\nサインなどを書かれる場合は、無しVerも頂けると助かります。\nそれと時々使用される光の効果は抑えて頂けると助かります（モザイクみたいになったときがあったので）。\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tanashi_mk2/works/9", "thumbnail_src": "https://si.imgix.net/11024763/uploads/origins/15aeeeec-20db-402e-b4a7-19cc8c0972e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03875a402c4b6fc7dbc3361cf1e1d67f", "thumbnail_srcset": "https://si.imgix.net/11024763/uploads/origins/15aeeeec-20db-402e-b4a7-19cc8c0972e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03875a402c4b6fc7dbc3361cf1e1d67f, https://si.imgix.net/11024763/uploads/origins/15aeeeec-20db-402e-b4a7-19cc8c0972e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f78556a2e854a69dd6e3fecf040f7dc 2x, https://si.imgix.net/11024763/uploads/origins/15aeeeec-20db-402e-b4a7-19cc8c0972e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38e1a71aa6790763ab6ea3fc644adc29 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tanashi_mk2/works/8", "thumbnail_src": "https://si.imgix.net/6aa59937/uploads/origins/c9258966-5b17-4cf9-a7ce-87a3d80b4731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0004ff4ff86d1c960b56e499cb0f0171", "thumbnail_srcset": "https://si.imgix.net/6aa59937/uploads/origins/c9258966-5b17-4cf9-a7ce-87a3d80b4731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=F