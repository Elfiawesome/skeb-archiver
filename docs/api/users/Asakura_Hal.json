fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f3a3d4c116bd6d6accc599d7757c596 3x", "genre": "art", "nsfw": true, "body": "東方より秦こころのパンチラ(パンモロ)をお願いします。\n\nスカートのスリットがいたずらでいつもより大きくなっていて、パンツ丸見えで街中を歩いています。イラストはそれに気が付いて顏を真っ赤にしているシーンをお願いします。可能であれば気が付く前のきょとん顔も描いてくださるとありがたいです。\n\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Asakura_Hal/works/51", "thumbnail_src": "https://si.imgix.net/25822360/uploads/origins/ae2d1cab-ee6a-420d-aa2d-98a472b23ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af91f9826ab708a88f8a64c655fdd9da", "thumbnail_srcset": "https://si.imgix.net/25822360/uploads/origins/ae2d1cab-ee6a-420d-aa2d-98a472b23ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af91f9826ab708a88f8a64c655fdd9da, https://si.imgix.net/25822360/uploads/origins/ae2d1cab-ee6a-420d-aa2d-98a472b23ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8edb000e6d6f35c96547f70544e3993 2x, https://si.imgix.net/25822360/uploads/origins/ae2d1cab-ee6a-420d-aa2d-98a472b23ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c3190f884166192c5e3278fc3bebb37 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつもナズーリンの素敵なイラストをありがとうございます！\n次のご依頼として、こちらのシチュエーションでナズーリンを描いていただけませんか？\nhttps://x.com/tatutaniyuuto/status/1919130157727514662\nこのような状況では、ナズーリンを好きなだけ可愛らしいコスプレで着せ替えてください！\n全てお任せします！\n本当にありがとうございます！\n\nHello!\nThank you always for your wonderful illustrations of Nazrin!\nFor my next request, would you be able to draw Nazrin in this type of situation?\nhttps://x.com/tatutaniyuuto/status/1919130157727514662\nI would like to see Nazrin with a book of cosplay!\nI'll leave everything up to you!\nThank you very much!", "created_at": "", "completed_at": ""}, {"path": "/@Asakura_Hal/works/50", "thumbnail_src": "https://si.imgix.net/49fa0dfe/uploads/origins/85e22284-9102-464e-8b76-90a8717bbccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5229f5debcbaac5b4156c33b3d4c1916", "thumbnail_srcset": "https://si.imgix.net/49fa0dfe/uploads/origins/85e22284-9102-464e-8b76-90a8717bbccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5229f5debcbaac5b4156c33b3d4c1916, https://si.imgix.net/49fa0dfe/uploads/origins/85e22284-9102-464e-8b76-90a8717bbccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cce0d1686941c3f42c73697cebcc34c8 2x, https://si.imgix.net/49fa0dfe/uploads/origins/85e22284-9102-464e-8b76-90a8717bbccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf11db832efa75419041868eb4d97173 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nリクエストなのですが、メスガキナズリンを描いていただけませんか？\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Asakura_Hal/works/49", "thumbnail_src": "https://si.imgix.net/be787ed8/uploads/origins/b52e3798-c184-4af3-b213-9396a4317662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28b06d5afb72c0b85e228959221735a1", "thumbnail_srcset": "https://si.imgix.net/be787ed8/uploads/origins/b52e3798-c184-4af3-b213-9396a4317662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28b06d5afb72c0b85e228959221735a1, https://si.imgix.net/be787ed8/uploads/origins/b52e3798-c184-4af3-b213-9396a4317662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=430a3a1a15b3ca66ae0fc15630832dc5 2x, https://si.imgix.net/be787ed8/uploads/origins/b52e3798-c184-4af3-b213-9396a4317662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=924cfae23e67cefe45b2c94b65ee2973 3x", "genre": "art", "nsfw": true, "body": "東方Project（東方紺珠伝）の稀神サグメのパンチラ絵を描いてください。\n\n・シチュエーションはスカートの切れ込みが深くなっていて普通に見えてしまっている状態のパンチラ。\n・ちょっと格好つけてるけど見えちゃってる感じの雰囲気と構図。\n・表情はサグメ様らしく澄ました雰囲気で、見えている事に気づいていないか気にしていない表情。\n・パンツは白系でフロントリボン付き、クロッチの縫い目の線が描かれている（スジと紐パンはNG）。\n\n以上、ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asakura_Hal/works/48", "thumbnail_src": "https://si.imgix.net/14693031/uploads/origins/45994718-147b-4c29-9f48-7e95fabe6951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f8dc518a2daf348f5f2aa76839997c", "thumbnail_srcset": "https://si.imgix.net/14693031/uploads/origins/45994718-147b-4c29-9f48-7e95fabe6951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f8dc518a2daf348f5f2aa76839997c, https://si.imgix.net/14693031/uploads/origins/45994718-147b-4c29-9f48-7e95fabe6951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0173c6247903d9e61d73ade1bb1fd73 2x, https://si.imgix.net/14693031/uploads/origins/45994718-147b-4c29-9f48-7e95fabe6951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dc759cdeb8ff17a821a5d3f85e0525e 3x", "genre": "art", "nsfw": false, "body": "始めてリクエストさせていただきます。\npixivやXに投稿されていたナズのイラストが可愛かったので、ぜひナズのイラストをお願いいたします。\n\n服装はデフォ服で、\nシチュエーションは知り合いの誰かから、怖いから肝試しに同行してほしい、と頼まれたナズーリンが\n「肝試し？別にいいけど、隣でちびらないでくれよ？」\nとニヤニヤとこちらを小馬鹿にしたような表情で台詞を言っているところ。\n\nそこからナズーリンに矢印を引いて\n「同行した肝試しで散々ちびったあげく寝る前トイレに行けなくなり翌朝盛大におねしょする賢将」\nという文字を入れていただきたいです。\n\nよろしければぜひお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asakura_Hal/works/47", "thumbnail_src": "https://si.imgix.net/112cd550/uploads/origins/c857f4fc-ca2c-4c07-acec-bbbf043f2e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=043e14ebb8c465b7ad774a02fc289f95", "thumbnail_srcset": "https://si.imgix.net/112cd550/uploads/origins/c857f4fc-ca2c-4c07-acec-bbbf043f2e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=043e14ebb8c465b7ad774a02fc289f95, https://si.imgix.net/112cd550/uploads/origins/c857f4fc-ca2c-4c07-acec-bbbf043f2e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59018f8fc2c9ca84b25969cea0eda736 2x, https://si.imgix.net/112cd550/uploads/origins/c857f4fc-ca2c-4c07-acec-bbbf043f2e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&