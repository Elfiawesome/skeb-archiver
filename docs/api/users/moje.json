af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04e2bcc51c3a070d8ca7e4601612224d, https://si.imgix.net/a9d47875/uploads/origins/b7838957-0358-4eb5-b8fe-cb47ffa1d1af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e2028ac199be59c72adf41fc42de69 2x, https://si.imgix.net/a9d47875/uploads/origins/b7838957-0358-4eb5-b8fe-cb47ffa1d1af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d067746842735b5aca478de016d88ec 3x", "genre": "art", "nsfw": true, "body": "依頼させていただきます。\nよろしくお願いします。\n\n●キャラクター\n・髪を下ろしたおさげちゃん\n・無地パーカー、絶対領域ニーソ、下着なし\n・ラグトレインのパーカー姿+私は雨のストレートロングの髪型でお願いします\n\n●内容\n・イチャラブ騎乗位で中出し\n・以前投稿していたこちらのイラストがとても良かったので、画角・構図はこのイメージでお願いします。https://www.pixiv.net/artworks/133350329\n・結合部はパーカーに隠れて見えない\n・男性はおさげちゃんの腰を両手で掴んでいる\n・おさげちゃんが動くのではなく、男性がおさげちゃんの腰を掴んで動かしているようにお願いします\n・おさげちゃんは男性の胴体に手をついている\n・背景は薄暗い室内\n・ピストン前はジト目でむすっとした表情、絶頂時は目をつむって涙を流し、口を開けて喘いでいる表情でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@moje/works/2", "thumbnail_src": "https://si.imgix.net/a8c15a10/uploads/origins/b32c3fa7-0bf8-417d-8ab0-54eded088f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f4059a2c98379d4b1f7a7da38d6dfe1", "thumbnail_srcset": "https://si.imgix.net/a8c15a10/uploads/origins/b32c3fa7-0bf8-417d-8ab0-54eded088f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f4059a2c98379d4b1f7a7da38d6dfe1, https://si.imgix.net/a8c15a10/uploads/origins/b32c3fa7-0bf8-417d-8ab0-54eded088f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11d79aebcbd8b85cf2d93d15a9703347 2x, https://si.imgix.net/a8c15a10/uploads/origins/b32c3fa7-0bf8-417d-8ab0-54eded088f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf3768a724c6fcd32b8d1d72fd88171 3x", "genre": "art", "nsfw": true, "body": "クーネル・エンゲイザーMVの琴葉葵ちゃんを依頼します。（https://www.nicovideo.jp/watch/sm34594493）\nサビのドット絵ではなく動画44秒〜等に出てくる1枚絵テイスト。\n資料が少なく大変かと思いますがよろ