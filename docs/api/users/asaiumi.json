f743765a589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18e704ccd608ac222c5198c193838115, https://si.imgix.net/3918836f/uploads/origins/b1d25a0f-c6c3-47b4-a50f-5f743765a589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3210d831bb20d52f627ee3722644beee 2x, https://si.imgix.net/3918836f/uploads/origins/b1d25a0f-c6c3-47b4-a50f-5f743765a589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d69260eb1347b26a8d2ee3a6639715a 3x", "genre": "art", "nsfw": false, "body": "初めまして、クラリネット演奏VTuberのさくらゆいと申します。\n浅井うみ様のイラストに惹かれ、いつか描いていただきたいな、とずっとSkeb再開を待ちわびておりました！ \n\n<構図希望>\n全身イラスト。吹奏楽部の合奏前、学校の椅子に座って楽器を持っているラフなポーズをイメージしています。\n楽器はクランポン・Festivalにオリジナルロゴが付いています。\nリガチャーはSilversteinのHEXA（6本ぐるぐるしている種類）のローズゴールドメッキを使用しています。\n可能でしたら表情差分もつけていただきたいです。\n（通常すまし顔、笑顔、泣き顔、リード咥え)\n学校の椅子、簡易的な背景（パターン模様でも可）がありますと嬉しいです。\n\n<衣装・髪型について>\n「制服衣装3面図」での髪型、衣装での制作をお願いします。\n\n<キャラクター詳細> \n三面図、立ち絵、構図参考をまとめたものはこちらです\n\n<使用用途> \n収益化済みのYouTubeチャンネル内での使用 Xなど各SNSで使用、グッズ利用も検討したいです \n\n <納品データ> \n人物、宛名、表情差分、楽器、背景、椅子、などレイヤー分けされたデータを納品していただきたいです。  ご検討をよろしくお願い致します…！\n\nhttps://drive.google.com/drive/folders/1FgcvDSr6MF5Ux1vs4L8SJjmggokNCZ9K?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@asaiumi/works/21", "thumbnail_src": "https://si.imgix.net/5b1d7e65/uploads/origins/5dbe1a7f-79f6-45bf-a2da-d78b41dbf898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=579dbccd4653c13eea0cdb72e2159ea2", "thumbnail_srcset": "https://si.imgix.net/5b1d7e65/uploads/origins/5dbe1a7f-79f6-45bf-a2da-d78b41dbf898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=579dbccd4653c13eea0cdb72e2159ea2, https://si.imgix.net/5b1d7e65/uploads/origins/5dbe1a7f-79f6-45bf-a2da-d78b41dbf898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9be510907c17996a49436186e6a9e4ab 2x, https://si.imgix.net/5b1d7e65/uploads/origins/5dbe1a7f-79f6-45bf-a2da-d78b41dbf898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70241043db19746f9c1f331b7c5dbbd1 3x", "genre": "art", "nsfw": false, "body": "浅井うみ様\nはじめまして！\nVtuberの村雲透音(むらくもとお)と申します。\nたくさんの音楽系Vの方々のイラストを描かれていて素敵だな…私もいつか描いていただきたい…と思っておりました。\n今回新衣装になるにあたり、ヴィオラを弾いている新衣装のイラストを描いていただきたいと思い、思い切ってリクエストさせていただきました。\n\n○村雲透音のイラスト\n資料の新衣装で描いていただけると嬉しいです！ポーズや髪型、背景等はお任せいたします！\nいちご、ヴィオラを弾くこと歌うこと、喋ることが大好きなとても明るいアイドルヴィオリストVです！\n\nサムネイル等で使わせていただきたいので頭部が切れていない、キャラのみの透過データをいただけると嬉しいです。\n\n\n○使用用途\n収益化済みのYouTubeのサムネイルや配信、XなどのSNS、SHOWROOMの配信の使用。できればグッズも…！\n\nリクエスト受けてくださるととても嬉しいです！\nご検討の程、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1SJbvaTCOqTn3_ZTM34EUMRL6kistailx", "created_at": "", "completed_at": ""}, {"path": "/@asaiumi/works/20", "thumbnail_src": "https://si.imgix.net/bc215014/uploads/origins/0f7416a5-4333-4bcc-95e6-bba4398a316c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104f895a570921e4bb5bd6ea1a90529e", "thumbnail_srcset": "https://si.imgix.net/bc215014/uploads/origins/0f7416a5-4333-4bcc-95e6-bba4398a316c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104f895a570921e4bb5bd6ea1a90529e, https://si.imgix.net/bc215014/uploads/origins/0f7416a5-4333-4bcc-95e6-bba4398a316c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9765b7b355fdeb2dfa32fc7d6836b9b9 2x, https://si.imgix.net/bc215014/uploads/origins/0f7416a5-4333-4bcc-95e6-bba4398a316c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=362d30e33bf465de74f5d18e44b24a8d 3x", "genre": "art", "nsfw": false, "body": "浅井うみ様\n\n初めまして、配信活動をしている白城小梅と申します。\n細かな楽器の構造まで詳しく描かれているイラストを多く拝見し、ホルンを吹いていた経験から是非をお願いしたくご連絡させていただきました。\n以下、ご依頼したい内容となります。\n◆内容\nホルンと少女\n◆構図や服装など\n資料URLにもございます、過去の浅井うみ様が投稿されていたトロンボーンの少女のような椅子に座った全身の構図をお願いいたします。(横向きでも正面でもお任せいたします)\nまた、衣装・髪型につきましてはお任せいたします。\nホルンは、ホルトン・ベルカットできるタイプでお願いいたします。\n◆キャラクター\n資料URLをご参照いただけますと幸いです。\n立ち耳スコティッシュフォールドの女の子になります(20代・人間の耳なし)\nチャームポイントは、特徴的な前髪です。\n\n◆使用用途 \n・Xでのアイコン使用  ・投稿\n・ネットプリント、グッズ等での商用利用\n◆その他\n背景ありの場合、キャラクター透過データもいただけますと幸いです\n\n以上になります。\nお忙しいと存じますが、ご検討の程よろしくお願いいたします。\n\nhttps://imgur.com/a/aImGTt1", "created_at": "", "completed_at": ""}, {"path": "/@asaiumi/works/19", "thumbnail_src": "https://si.imgix.net/9b181ab1/uploads/origins/f05feb8d-cbed-416a-81f0-bd5a565ea23b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e99afeeb7e9e2b83007b863014037c7", "thumbnail_srcset": "https://si.imgix.net/9b181ab1/uploads/origins/f05feb8d-cbed-416a-81f0-bd5a565ea23b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e99afeeb7e9e2b83007b863014037c7, https://si.imgix.net/9b181ab1/uploads/origins/f05feb8d-cbed-416a-81f0-bd5a565ea23b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db6f0da370c0bd3ac8c97a7babc1842a 2x, https://si.imgix.net/9b181ab1/uploads/origins/f05feb8d-cbed-416a-81f0-bd5a565ea23b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa65655ffe856433f6db9123a38cf3a8 3x", "genre": "art", "nsfw": false, "body": "昨年は素敵なイラストを納品頂きありがとうございました！\n先日モデルをリニューアルしたので、新しいお姿もぜひ浅井うみ様に描いていただきたくリクエスト送らせて頂きました。\n\n ■使用用途\n・動画やサムネイル、SNSなど\n・グッズ利用もさせていただきたいと考えています…！\n■内容  \n・癒し系フルート演奏Vtuber \n・お姉さん声のぽんこつ\n身長：155cm  \n髪：青みがかった黒髪のゆるふわヘアー、髪の長さは腰あたりまで、インナーカラーの青色  \n目：青色で少し横長 瞳は夜空  右目に泣きぼくろ  \n肌色：色白  \n\n・背景はおまかせいたします。\n・衣装は新しい2Dモデルの衣装でお願いします。\n・ヘアピン有りでお願いします。\n・猫耳差分がありますが、今回は猫要素の描き込みは無しでお願いします\n・ポーズ案はファイルに一緒に入れております。\n・表情差分をいくつか付けて頂けると嬉しいです。  \n・サムネイルに使用しやすいよう、頭部や体の一部(手など)が見切れない、腰あたりまでは映るサイズで描いていただけると幸いです。\n\n■納品形式\n・人物、背景、楽器、サインなどのレイヤーが分かれたPSD画像\n\nご多用のところ恐れ入りますが、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17NXCqzlhrDyfZ2C8lEPnvDNUnFiJxMZp", "created_at": "", "completed_at": ""}, {"path": "/@asaiumi/works/18", "thumbnail_src": "https://si.imgix.net/531adcb0/uploads/origins/213099cb-3749-45c3-8dcb-0b1887178509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=midd