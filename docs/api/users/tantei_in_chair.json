4643-84f5-ba9e98a83c47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6768f80ccc0e71d72f03701903f48e, https://si.imgix.net/b9d11c6b/uploads/origins/4db4932c-5fd6-4643-84f5-ba9e98a83c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e610eb6aab20cee656a7e9585f25308 2x, https://si.imgix.net/b9d11c6b/uploads/origins/4db4932c-5fd6-4643-84f5-ba9e98a83c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1df3030a9e737fabf1ded0e6d1fadbb3 3x", "genre": "comic", "nsfw": true, "body": "Twitterのイラスト等見ましてリクエスト致します。\n触手と戦う速水奏さんをお願いすることはできますでしょうか。\nシチュとしては、セーラームーン的な変身ヒロイン役をすることになった奏（コスは描きやすいor描きたい感じでしていただければ）が、番組内で触手と戦うことになり、締め上げとエナジードレインに苦しみ気を失って敗北してしまう…という「挿入等はなく体裁は全年齢だが、視聴者にはかなりエロく見える」という感じをお願いできれば幸いです（リクとしては一応NSFWつけました）。\nOKでしたら何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tantei_in_chair/works/78", "thumbnail_src": "https://si.imgix.net/bec96881/uploads/origins/f0ad4d97-97b6-4d36-9df0-954455db9190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327db2e42347aa221863a373a6d15301", "thumbnail_srcset": "https://si.imgix.net/bec96881/uploads/origins/f0ad4d97-97b6-4d36-9df0-954455db9190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327db2e42347aa221863a373a6d15301, https://si.imgix.net/bec96881/uploads/origins/f0ad4d97-97b6-4d36-9df0-954455db9190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4523dd527ece5d6b56323f4a19ad04aa 2x, https://si.imgix.net/bec96881/uploads/origins/f0ad4d97-97b6-4d36-9df0-954455db9190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a0ab9bc0873da6b4c72a6a57857edce 3x", "genre": "art", "nsfw": false, "body": "先生の前のbleachパロのミリオンライブの徳川まつりと天空橋朋花が大好きなのでお願いしたいです。今回依頼したいのは公式書風を模擬した星十字騎士団的徳川まつりと天空橋朋花の全身人物設定図です。朋花の聖文字は「L」。まつりの聖文字は「C」です。\nもし金額が希望に添えない場合調整していただけたら幸いです。よろしくお願いします！\n前回 https://skeb.jp/@tantei_in_chair/works/71", "created_at": ""