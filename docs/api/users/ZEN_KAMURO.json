oads/origins/24f2383d-3dcf-4f28-86f1-a069bb4c78f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=805c9962ea32d99ef7a299b49bc183fc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZEN_KAMURO/works/1259", "thumbnail_src": "https://si.imgix.net/d84a2091/uploads/origins/5d339b14-0d6f-43a7-a577-dde00790a43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7293e54bdbe4824121967d439d120cde", "thumbnail_srcset": "https://si.imgix.net/d84a2091/uploads/origins/5d339b14-0d6f-43a7-a577-dde00790a43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7293e54bdbe4824121967d439d120cde, https://si.imgix.net/d84a2091/uploads/origins/5d339b14-0d6f-43a7-a577-dde00790a43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ab46142049a46581896cc8dc1fbd68a 2x, https://si.imgix.net/d84a2091/uploads/origins/5d339b14-0d6f-43a7-a577-dde00790a43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=550c7d6131fe5d68a17d826c0b6db368 3x", "genre": "art", "nsfw": true, "body": "今回はニッケ勝利の女神よりシンデレラとグレイヴの新たなイラストを依頼します。シンデレラはグラスプリンセススキン、グレイヴはビューティフルユースキンを着用。ポーズは前回作品(https://skeb.jp/@ZEN_KAMURO/works/1122)と同様でお願いします。\nシンデレラが上、グレイブが下。グレイブは眼鏡未着用。グレイブのスーツとブラはベッドに脱ぎ捨てられ、シンデレラはトップスを胸の下まで引き下げられ、乳房が露わになっている。二人の露出した胸が互いに押し付け合っている。百年の時を経て再会した喜びに浸り、情熱的な愛を表現している様子。", "created_at": "", "completed_at": ""}, {"path": "/@ZEN_KAMURO/works/1258", "thumbnail_src": "https://si.imgix.net/78bbb7f7/uploads/origins/33d87de5-3ecb-4b61-98ae-d7ec8b56d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4888c071c757175502017daea3faba45", "thumbnail_srcset": "https://si.imgix.net/78bbb7f7/uploads/origins/33d87de5-3ecb-4b61-98ae-d7ec8b56d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4888c071c757175502017dae