fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0cde33cb810b5b5bbb03b5ba2d35613 3x", "genre": "art", "nsfw": false, "body": "亜美ちゃんのデザイン、ましろきママさんのスタイルを気に入っていただけてとても嬉しいです。ピアスや肌を見せるような露出度の高い衣装というアイデアはいいですね。ただ、うさぎをモチーフにした服ではなく、猫をモチーフにした服にしてほしいです。\n\nアミの参考画像のリストがあるグーグルドライブへのリンクを添付します。\nhttps://drive.google.com/drive/folders/1KQTHNZs3CD-pqCu1ckXdynZScAcxGejo?usp=sharing\n\nリクエストに応えていただき、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@10_No_Cut/works/48", "thumbnail_src": "https://si.imgix.net/684acec6/uploads/origins/1137d31f-2eb9-451a-bffd-bb1da3d2ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe9c729a8592256ee1268b5dae871fa", "thumbnail_srcset": "https://si.imgix.net/684acec6/uploads/origins/1137d31f-2eb9-451a-bffd-bb1da3d2ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe9c729a8592256ee1268b5dae871fa, https://si.imgix.net/684acec6/uploads/origins/1137d31f-2eb9-451a-bffd-bb1da3d2ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4702e276649ea3e9aea4dd45b64d150c 2x, https://si.imgix.net/684acec6/uploads/origins/1137d31f-2eb9-451a-bffd-bb1da3d2ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00d4e4366bbdafb142bcd0a7192add15 3x", "genre": "art", "nsfw": true, "body": "こんばんは、アピールいただきありがとうございます。\n作品の方見させていただき、素敵なイラストばかりなので、ぜひお願いしたいです。\n\nご提案いただいた通り、Vのくろいけもみみさん(X：@kuroikemomimi)のFAをお願いできますか？\n\nポーズや構図、服装についてはお任せできればと思います。\n\n資料URLの方に、三面図がありますので、ご参考ください。\nスケブ等での有償依頼の許可は、直接質問して問題ないことを確認しています。\n\nなお、描いていただいたイラストは、くろいけもみみさんのサムネや配信、SNS等で使用させていただく可能性があります。\n\nそれでは、差し支えなければ、よろしくお願いします。\n\nhttps://x.com/kuroikemomimi/status/1859202630817599817", "created_at": "", "completed_at": ""}, {"path": "/@10_No_Cut/works/47", "thumbnail_src": "https://si.imgix.net/fb36c258/uploads/origins/8cec3cfc-0b29-45eb-b0d0-577d6e982a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9b416da42cc55dda64d72c98bddedd7", "thumbnail_srcset": "https://si.imgix.net/fb36c258/uploads/origins/8cec3cfc-0b29-45eb-b0d0-577d6e982a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9b416da42cc55dda64d72c98bddedd7, https://si.imgix.net/fb36c258/uploads/origins/8cec3cfc-0b29-45eb-b0d0-577d6e982a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85871126d57a2e6719dd2d538f1b6bf6 2x, https://si.imgix.net/fb36c258/uploads/origins/8cec3cfc-0b29-45eb-b0d0-577d6e982a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=806e33c0aaf15b3ba3318602cefd6a11 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたのアートはとてもキュートです！\n\n私のキャラクターの参考資料です！ :3\nオカルトとフライドポテトが大好きなアンデッドバニーガールです！<3\nhttps://x.com/fukobunn/status/1972003873771655643?s=46&t=CfUAZp62qJFbqbgZMDixvw", "created_at": "", "completed_at": ""}, {"path": "/@10_No_Cut/works/46", "thumbnail_src": "https://si.imgix.net/5a8ecf45/uploads/origins/5aca1a54-8c25-46be-9904-d546fcbcb443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91e9ec54aee043ef61e0cd28cfce0bba", "thumbnail_srcset": "https://si.imgix.net/5a8ecf45/uploads/origins/5aca1a54-8c25-46be-9904-d546fcbcb443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91e9ec54aee043ef61e0cd28cfce0bba, https://si.imgix.net/5a8ecf45/uploads/origins/5aca1a54-8c25-46be-9904-d546fcbcb443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91100451878e013331b6bb3f5bd2ab11 2x, https://si.imgix.net/5a8ecf45/uploads/origins/5aca1a54-8c25-46be-9904-d546fcbcb443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=291be76defaabd01b38b2ae44d8692da 3x", "genre": "art", "nsfw": false, "body": "あなたのアートは超超超かわいいです！大好きです！アピールしてくれてありがとうございます！あなたのスタイルは完璧に私のタイプです！\n\n彼女は秋田犬の堕天使です！\n彼女はとても生意気で、胸がぺったんこです！\n怖がりで、すぐ泣きますが、とても真面目です。\n\n髪型は自由です！\n好きなように描いてください！\n\nhttps://drive.google.com/drive/folders/1o0IzkyuhIslpKE-6gvpPexjnVuyyowFP?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@10_No_Cut/works/45", "thumbnail_src": "https://si.imgix.net/f4372211/uploads/origins/f90d3b19-62c8-40e0-b543-4c16de8d5f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f3d2b87397ae644863b1bf680fb69e", "thumbnail_srcset": "https://si.imgix.net/f4372211/uploads/origins/f90d3b19-62c8-40e0-b543-4c16de8d5f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f3d2b87397ae644863b1bf680fb69e, https://si.imgix.net/f4372211/uploads/origins/f90d3b19-62c8-40e0-b543-4c16de8d5f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97aa742a72b2a6c5392c9a9dbe349361 2x, https://si.imgix.net/f4372211/uploads/origins/f90d3b19-62c8-40e0-b543-4c16de8d5f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bf91d0115b23403982fd41fd7392d5c 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\n再度、キャラクター(うちの子)に興味をもっていただきありがとうございます。\n\nアピール元と同様の女の子のイラストをお願いできればと思います。\nこちらは参考画像ですが、セーラー服のデザイン・表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容ですが、再掲ですので参考程度です。\nご提案いただいた「小さいツインテールで地雷系やサブカル感のある衣装」のイラストをお願いいたします。\n頬の絆創膏と右腕のギプス＋三角巾が維持されていれば、あとは自由となります。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "created_at": "", "completed_at": ""}, {"path": "/@10_No_Cut/works/44", "thumbnail_src": "https://si.imgix.net/1ed3fdf0/uploads/origins/bf18c7c5-193f-462f-bc61-49e4a2b4b7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f295bddb17fe5597a9a172a2f0513bd2"