mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=335134455d9ae1b29af0edab044fea9b 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@1101simotuki/works/56", "thumbnail_src": "https://si.imgix.net/d1b9031a/uploads/origins/dd7fb029-fa0c-417b-b3d3-bc1edc2ee74a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530a9373d381f8c09d3d518ae396bfd8", "thumbnail_srcset": "https://si.imgix.net/d1b9031a/uploads/origins/dd7fb029-fa0c-417b-b3d3-bc1edc2ee74a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530a9373d381f8c09d3d518ae396bfd8, https://si.imgix.net/d1b9031a/uploads/origins/dd7fb029-fa0c-417b-b3d3-bc1edc2ee74a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2be186cbcec1382f2da8d7cadd69d50 2x, https://si.imgix.net/d1b9031a/uploads/origins/dd7fb029-fa0c-417b-b3d3-bc1edc2ee74a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3e9b3ce293bf00aa0ca2f05a69fd5af 3x", "genre": "comic", "nsfw": false, "body": "こんにちは。いつも描く漫画を面白く見ています。 機会があって漫画作品を要請したいです。\n\n博士の食生活と健康を心配するライディアンが夜食を食べないように、博士に注意します。 でも、深夜に仕事をしている間にお腹が空いてきた博士はこっそりラーメンを食べようとするのですが、その様子をラジアンにバレて制裁を受ける状況の漫画をお願いしたいと思います。\n\nもし可能であれば、制裁の場面で怒ったライディアンがコミカルに博士の首をロボットアームで絞め、博士は手に持っていたラーメンの袋とやかんを落とすような演出があればと思います。\n\nそしてライディアンが「ママの感じ」のある優しさを見せる結末であってほしいです。\n\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@1101simotuki/works/55", "thumbnail_src": "https://si.imgix.net/19f0a86a/uploads/origins/a8f57bb4-bacb-4f92-8303-ac768a2a5919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4ef7615b34b5b889754b7d34eb8ac8a", "thumbnail_srcset": "https://si.imgix.net/19f0a86a/uploads/origins/a8f57bb4-bacb-4f92-8303-ac768a2a5919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4ef7615b34b5b889754b7d34eb8ac8a, https: