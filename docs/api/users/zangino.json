.net/c2466e20/uploads/origins/3b330aca-c36e-4907-8003-e019221fb869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0f0fbae3489606ffd326d0e566d2bb6 2x, https://si.imgix.net/c2466e20/uploads/origins/3b330aca-c36e-4907-8003-e019221fb869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51c935c041f9e63ed21ae3c6e6f28f72 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zangino/works/51", "thumbnail_src": "https://si.imgix.net/ddaf391e/uploads/origins/218de1cd-93a7-4101-9256-9c37e05f1df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b289179e24425ec53c0032d22ca365a", "thumbnail_srcset": "https://si.imgix.net/ddaf391e/uploads/origins/218de1cd-93a7-4101-9256-9c37e05f1df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b289179e24425ec53c0032d22ca365a, https://si.imgix.net/ddaf391e/uploads/origins/218de1cd-93a7-4101-9256-9c37e05f1df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a73f370668864457e338bb1f6f739d43 2x, https://si.imgix.net/ddaf391e/uploads/origins/218de1cd-93a7-4101-9256-9c37e05f1df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31d7c6ed513ef388133389949fdd803b 3x", "genre": "art", "nsfw": true, "body": "ざんぎさんはじめまして。以前からざんぎさんの描かれる筋ショタオス男子や筋肉娘のパワフルでセクシーでどすけべぇなイラスト、ずっと楽しませていただいておりました！\nぜひリクエストさせていただきたいです！\nどのキャラにしようかさんざん迷ったのですが、今回はFGOのアレキサンダーきゅんと、バーゲスト(ふたなり)が、ガン攻めえっちを楽しんでいるイラストをお願いできますでしょうか？\nざんぎさんの筋ショタオスとバーゲストがぜひ拝見したいです!!\n\nリクエストキャラ：バーゲスト(ふたなり攻)×アレキサンダー(受)(『Fate/GrandOrder』)\n体形：２人とも腋毛や下半身の毛は無毛 乳首やチンコはビンビンに勃起\nバーゲスト→ざんぎさんの描かれるバーゲストそのものでお願いします アレキサンダーのお腹をぼっこり膨らませる巨根\nアレキサンダー→ムキムキ細マッチョ シックスパック割れの腹筋 チンコはバーゲストの激しい突き上げに合わせて、勢いよく射精している ムキムチの太もも\n表情：\nバーゲスト→精神がせめぎあいつつ、えっちに全力なトロ顔\nアレキサンダー→えっちを楽しみまくっているアヘトロ笑顔\n服装：2人とも全裸\nバーゲスト→頭の飾りパーツは着用\n体位：フルネルソン\nシチュエーション：\n受けも攻めもえっち大好きなアレキサンダーが、バーゲストを誘ってえっちしている\nバーゲストは伝説の王に恐縮しつつも、どストライクの筋ショタ男子にタガがはずれかけている\nバーゲストがアレキサンダーを後ろからフルネルソンの体勢でガン攻めしている\nアレキサンダーはバーゲストの激しいピストンに合わせて射精しつつ、感じまくりイキまくっている\n擬音・セリフ：おまかせします 無くても大丈夫です\n\n指定が細かく申し訳ございません。ぜひよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@zangino/works/50", "thumbnail_src": "https://si.imgix.net/a8e2144a/uploads/origins/85c092d4-7638-42ee-993f-8c39e60c2c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2367d4ca58449dd36b3a2cac06ba307", "thumbnail_srcset": "https://si.imgix.net/a8e2144a/uploads/origins/85c092d4-7638-42ee-993f-8c39e60c2c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2367d4ca58449dd36b3a2cac06ba307, https://si.imgix.net/a8e2144a/uploads/origins/85c092d4-7638-42ee-993f-8c39e60c2c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1254e795c07f305984f7e77be787f4ec 2x, https://si.imgix.net/a8e2144a/uploads/origins/85c092d4-7638-42ee-993f-8c39e60c2c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4034a6435e695b199d88ecbe2b53705d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zangino/works/49", "thumbnail_src": "https://si.imgix.net/4a22a7a2/uploads/origins/3ccdf151-b421-4ce6-af57-0a3abc5711f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da498c46ec8c38d1065b693378ce2c21", "thumbnail_srcset": "https://si.imgix.net/4a22a7a2/uploads/origins/3ccdf151-b421-4ce6-a