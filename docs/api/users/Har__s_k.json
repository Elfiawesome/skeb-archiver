a/uploads/origins/a1fa4a6e-c74a-4f95-97c9-d81efbedb4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca795e7e2472c47c38610b2a3a8c0c9", "thumbnail_srcset": "https://si.imgix.net/7294a27a/uploads/origins/a1fa4a6e-c74a-4f95-97c9-d81efbedb4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca795e7e2472c47c38610b2a3a8c0c9, https://si.imgix.net/7294a27a/uploads/origins/a1fa4a6e-c74a-4f95-97c9-d81efbedb4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e96973aba675a9a84bab2a31cca8ff1 2x, https://si.imgix.net/7294a27a/uploads/origins/a1fa4a6e-c74a-4f95-97c9-d81efbedb4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e1d2a66747c297ef05132a3c899309d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、こんにちは！\nラブライブ！サンシャイン!! から国木田花丸ちゃんと声優の野中ここなさんをお願いしたいです！\n服装は2人とも浦の星女学院の1年の夏服でお願いします！\nポージングや背景などはお任せします！\nイラストの方はXなどのアイコンでの使用を考えてます！\nよろしくお願いします🙇", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/43", "thumbnail_src": "https://si.imgix.net/9ff6a064/uploads/origins/abbe5b11-53e5-4dd9-a7d6-1bb3284015b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd8ec69915d360ba0f743d76c02df1de", "thumbnail_srcset": "https://si.imgix.net/9ff6a064/uploads/origins/abbe5b11-53e5-4dd9-a7d6-1bb3284015b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd8ec69915d360ba0f743d76c02df1de, https://si.imgix.net/9ff6a064/uploads/origins/abbe5b11-53e5-4dd9-a7d6-1bb3284015b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caec4c6851bbcf31f054a0919e9313e1 2x, https://si.imgix.net/9ff6a064/uploads/origins/abbe5b11-53e5-4dd9-a7d6-1bb3284015b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3574f5a4820b2028752247d57b555992 3x", "genre": "art", "nsfw": false, "body": "こんにちは。先日はアピールくださりありがとうございます。提案していただいた千歌ちゃんのイラストが良いと思ったので、ぜひリクエストしたいです。\n・キャラ「高海千歌ちゃん」 \n・衣装 「想いよひとつになれ」 \n・キャラのアングル「正面」  \n・描写構図「等身イラスト」  \n・ポーズ「おまかせします」\n・表情「笑顔でウィンクしている」\n宜しくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/42", "thumbnail_src": "https://si.imgix.net/e6b5a498/uploads/origins/155254c5-c793-4ac8-b9b0-1dbcb1567c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fcee086c1b48439dfbe99ce71c182cb", "thumbnail_srcset": "https://si.imgix.net/e6b5a498/uploads/origins/155254c5-c793-4ac8-b9b0-1dbcb1567c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fcee086c1b48439dfbe99ce71c182cb, https://si.imgix.net/e6b5a498/uploads/origins/155254c5-c793-4ac8-b9b0-1dbcb1567c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=776dc57ae3ccddf00151680ec3b7e05d 2x, https://si.imgix.net/e6b5a498/uploads/origins/155254c5-c793-4ac8-b9b0-1dbcb1567c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db17855b6f79b479fc44c2a8a015ab29 3x", "genre": "art", "nsfw": false, "body": "こんにちは。実はもう一つ描いていただきたい千歌ちゃんのイラストがあるので、リクエストしました。\n ・キャラ「高海千歌ちゃん」 \n・衣装 「青空Jumping Heart」\n ・キャラのアングル「正面」 \n ・描写構図「キャラはしゃがみ、全身イラスト(ブーツ込みで)\n  ・ポーズ「ピースサイン」 \n ・表情「ウィンク、笑顔」 →https://i0.wp.com/xn--hckp3ac2l023wu2ve.com/wp-content/uploads/2021/04/chika-ur-8th.png?ssl=1 (このリンクのイラストのような笑顔を希望します) よければ、よろしくお願いします。 \n  ◆衣装の資料  https://www.suruga-ya.jp/database/pics_light/game/g3120769.jpg https://blog.goo.ne.jp/marie502502new/e/d8f0bb7c36582327253d4b24ea97f93e", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/41", "thumbnail_src": "https://si.imgix.net/3d2bb4dd/uploads/origins/14d13cb2-d900-4271-8b3d-6f64faa443d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd76465fe0eaaf858912903d8dc7944e", "thumbnail_srcset": "https://si.imgix.net/3d2bb4dd/uploads/origins/14d13cb2-d900-4271-8b3d-6f64faa443d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd76465fe0eaaf858912903d8dc7944e, https://si.imgix.net/3d2bb4dd/uploads/origins/14d13cb2-d900-4271-8b3d-6f64faa443d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bb01c571c221c27245aac843f586e5b 2x, https://si.imgix.net/3d2bb4dd/uploads/origins/14d13cb2-d900-4271-8b3d-6f64faa443d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2a9fb5521f09e433c4ec63e5203340b 3x", "genre": "art", "nsfw": false, "body": "はるさめすーぷ様\nはじめまして！\n可可ちゃんのイラストをお願いしたいと思います！今回は可可ちゃんのアイコン用のイラストをお願いしたいです。衣装は普段着のカジュアルな服装や、可愛らしい雰囲気が出る感じでお任せしたいです。どうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/40", "thumbnail_src": "https://si.imgix.net/c88889c9/uploads/origins/4570186a-b6bf-4243-9b63-cdad45917675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acc5da897d99c8da622883df17daf7fd", "thumbnail_srcset": "https://si.imgix.net/c88889c9/uploads/origins/4570186a-b6bf-4243-9b63-cdad45917675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acc5da897d99c8da622883df17daf7fd, https://si.imgix.net/c88889c9/uploads/origins/4570186a-b6bf-4243-9b63-cdad45917675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd45e3a610ca801e8cede69ac6d34594 2x, https://si.imgix.net/c88889c9/uploads/origins/4570186a-b6bf-4243-9b63-cdad45917675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7ac1feb8d120b8a8d4c76811508fc27 3x", "genre": "art", "nsfw": false, "body": "はじめまして。梅花（メイフォア）と申します。\nVTuberとして活動をしております。\n\nアピールありがとうございます！\nぜひうちの子を描いていただきたく、リクエストさせていただきます。\n\n明るい雰囲気で、二人が仲良くしているところを描いていただきたいです。\n細かい構図などはお任せいたします。\n\nYoutubeのサムネイル、各種SNSで使用させていただきます。\n可能でしたら、グッズ化への商用利用等で使わせていただきたいです。\n頭の先が見切れないように描いていただけますとありがたいです。\n\nキャラクターイメージ\n・のんびり、やわらかい、チャイナの黒い円ぶち眼鏡っ娘\n・瞳はオッドアイで、右目が紫、左目がピンクです。抱えているのは小李（シャオリー）という白猫です。\n\nキャラのみ透過で使用できるよう、PSDのデータか、透過のPNGファイルをいただけると助かります。\n長くなってしまいましたが、ご検討の上、どうぞよろしくお願いいたします。\n\nhttps://x.com/meihua0707/status/1805946412582179098/photo/1\n\nhttps://x.com/meihua0707/status/1805946412582179098/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/39", "thumbnail_src": "https://si.imgix.net/b8eab4c4/uploads/origins/bd04273e-555f-456e-b39e-93b05bafc63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ca428a16385925d613afce24fc4ed00", "thumbnail_srcset": "https://si.imgix.net/b8eab4c4/uploads/origins/bd04273e-555f-456e-b39e-93b05bafc63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ca428a16385925d613afce24fc4ed00, https://si.imgix.net/b8eab4c4/uploads/origins/bd04273e-555f-456e-b39e-93b05bafc63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4cf96cc5e17d850c43bd582507a6784 2x, https://si.imgix.net/b8eab4c4/uploads/origins/bd04273e-555f-456e-b39e-93b05bafc63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5500c97f9d7f984dd703d6db883db4a8 3x", "genre": "art", "nsfw": false, "body": "はるさめすーぷ様\n\n初めまして、VTuber準備中の牝羊、メアリー・オヴィサリエスと申します。\n遅ればせながらアピールありがとうございました！ コンセプトにも興味を持っていただけて嬉しいです。\nSkeb作品を拝見していると制服キャラが多いように感じたので、是非制服姿のイラストをお願いしたくリクエストに伺いました。\n\n𖦹内容𖦹\n学生服を着たメアリー・オヴィサリエス https://x.com/mary_ovisaries のイラスト\n(背景透過差分もいただけましたら幸いです) \n\n𖦹用途𖦹\nYouTubeでシチュエーションボイスshort動画への使用、透かしなど加工してSNSでの使用 \n\n𖦹構図等𖦹\nお任せします\nモデル：世話焼きの保健委員\n形式：PNG(PSDでも構いませんが、編集できないことが多いので念の為)\n\nご検討よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/38", "thumbnail_src": "https://si.imgix.net/276de0b7/uploads/origins/148f8d16-c566-48bc-bd6c-ab739270e0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a770a891954f9635044806ef3f32039f", "thumbnail_srcset": "https://si.imgix.net/276de0b7/uploads/origins/148f8d16-c566-48bc-bd6c-ab739270e0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a770a891954f9635044806ef3f32039f, https://si.imgix.net/276de0b7/uploads/origins/148f8d16-c566-48bc-bd6c-ab739270e0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9da92c55f7953a609df7240512de7f0 2x, https://si.imgix.net/276de0b7/uploads/origins/148f8d16-c566-48bc-bd6c-ab739270e0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b0ea344d1b5df0c0a5d7e226a5fc68c 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\n今回はパワプロ(栄冠ナインクロスロード)の咲道あかりをお願いします。\n\n衣装はセーラー服で表情はツンツンなイメージで。\n以前の七島麻美のようにリアル頭身とパワ体それぞれでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/37", "thumbnail_src": "https://si.imgix.net/98e52ed3/uploads/origins/4dcc4853-e9b4-44dd-ba11-892510e67145?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=569e15ad1bd9ea6376f8b2eaa988856b", "thumbnail_srcset": "https://si.imgix.net/98e52ed3/uploads/origins/4dcc4853-e9b4-44dd-ba11-892510e67145?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=569e15ad1bd9ea6376f8b2eaa988856b, https://si.imgix.net/98e52ed3/uploads/origins/4dcc4853-e9b4-44dd-ba11-892510e67145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a27c76ac68df47f44d8b6a59c0ebd085 2x, https://si.imgix.net/98e52ed3/uploads/origins/4dcc4853-e9b4-44dd-ba11-892510e67145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef25e83e76a751b387bbcf723b79f466 3x", "genre": "art", "nsfw": false, "body": "はじめまして、アピールしていただきありがとうございます。\n是非たぬきくんを描いていただきたいと思いリクエストを送らせてもらいます。\n内容に関しましてはぜひお任せでお願いしたいと考えています。\n\n参考資料を資料URLに記載しています、\n基本的なビジュアルや設定の他に、納品されたたぬきくんのイラストとシチュエーションのサンプルとして使えそうなスクリーンショットのファイルが入っています。\n衣装、アクセサリ等は一部省略、アレンジなどして頂いて問題ございません、ご検討のほどよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/usxzh5yikp1pleweg2sdb/h?rlkey=tq8y32nwbsgijr5qnuz6bhab1&st=sp9qka25&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Har__s_k/works/36", "thumbnail_src": "https://si.imgix.net/3f99aa63/uploads/origins/e414047a-f559-4731-a8c9-f243bffdb0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b95854509fe4854b5674cef64abb4938", "thumbnail_srcset": "https://si.imgix.net