2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0a564d9bef3330c3d0b3f33481fb8b8 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。前回はskebありがとうございました。\n\n今回、自分が描いたOCのキャラクターのイラストをおねがいしたいです。\nキャラクターはこちらhttps://x.com/kitsuneme31/status/1949206620598386971\n\n特にポーズの指定はないですが、性格が明るくて優しい子ですので、それにあった雰囲気\nスマホの壁紙にしたいので縦長の構図だとうれしいです。背景なども特に指定はありません。\n\nお受けいただいたら楽しみにまたせていただきます。よろしくおねがいいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/9", "thumbnail_src": "https://si.imgix.net/5311d365/uploads/origins/d808431f-7e05-4633-9d56-2de94c5b38eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56e5c4958ff982de097032d5c3efdf2c", "thumbnail_srcset": "https://si.imgix.net/5311d365/uploads/origins/d808431f-7e05-4633-9d56-2de94c5b38eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56e5c4958ff982de097032d5c3efdf2c, https://si.imgix.net/5311d365/uploads/origins/d808431f-7e05-4633-9d56-2de94c5b38eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d2b9580ef50ba6f6c1bd77a69189022 2x, https://si.imgix.net/5311d365/uploads/origins/d808431f-7e05-4633-9d56-2de94c5b38eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d2ced3a7f04501a61f30b6b8c52bcd3 3x", "genre": "art", "nsfw": false, "body": "おとめ先生こんにちは\n\nぶいすぽENの黒刃アリヤちゃんのイラストお願いします！\nポースや構図はおとめ先生に任せます\n\n三面図：https://x.com/aryakuroha/status/1852531109893906672\n\nよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/8", "thumbnail_src": "https://si.imgix.net/f411f2fc/uploads/origins/b5a2734c-74d2-41ab-86c9-0092c9d50b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e0515aded75b4e9eb0dc08e04bcc3a4", "thumbnail_srcset": "https://si.imgix.net/f411f2fc/uploads/origins/b5a2734c-74d2-41ab-86c9-0092c9d50b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e0515aded75b4e9eb0dc08e04bcc3a4, https://si.imgix.net/f411f2fc/uploads/origins/b5a2734c-74d2-41ab-86c9-0092c9d50b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c60b1904e13506441b845df411d3933 2x, https://si.imgix.net/f411f2fc/uploads/origins/b5a2734c-74d2-41ab-86c9-0092c9d50b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df99c042b38c298e6f6f062918fe5611 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。いつもイラストたのしませていただいております。\n\n今回は自分の作成したOCのイラストをかいていただきたいです。\n\nキャラクター\nhttps://x.com/kitsuneme31/status/1841044447863169042\n\n明るい正確の鬼の女子高生の設定の子です。\n\nイラストのイメージはスマホで自撮りをとっている場面で俯瞰視点のイメージです。\nめいっぱいかわいい雰囲気で描いていただけたらうれしいです。\n\nhttps://x.com/kitsuneme31/status/1841044447863169042", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/7", "thumbnail_src": "https://si.imgix.net/f86af5cb/uploads/origins/10ce8c32-6ae0-442c-93fa-6cb2ea421ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a962ae667c4d9fac6585a5a51caa7f5f", "thumbnail_srcset": "https://si.imgix.net/f86af5cb/uploads/origins/10ce8c32-6ae0-442c-93fa-6cb2ea421ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a962ae667c4d9fac6585a5a51caa7f5f, https://si.imgix.net/f86af5cb/uploads/origins/10ce8c32-6ae0-442c-93fa-6cb2ea421ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=033f6f19cd5ee04da2dcbe9650b4803d 2x, https://si.imgix.net/f86af5cb/uploads/origins/10ce8c32-6ae0-442c-93fa-6cb2ea421ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=963799be1675df1628c70d4c1ab7e0ce 3x", "genre": "art", "nsfw": false, "body": "はじめまして、サンプルで載せていた広とヒナが気になったのでリクエストしました。\n\nマイクを持って照れながらこちらを見ている『ららマジ』の九条紗彩をお願いします。\n\nポーズや衣装等にアレンジがありましたら全てお任せします。\nどうぞよろしくお願いします。\n\nhttps://x.com/tnzreg/status/1356578837769773056?s=46", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/6", "thumbnail_src": "https://si.imgix.net/01992231/uploads/origins/42e00a9e-8d5a-4d61-b2d8-d2f90581f085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8e86b2a5ae67793872527c1be039304", "thumbnail_srcset": "https://si.imgix.net/01992231/uploads/origins/42e00a9e-8d5a-4d61-b2d8-d2f90581f085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8e86b2a5ae67793872527c1be039304, https://si.imgix.net/01992231/uploads/origins/42e00a9e-8d5a-4d61-b2d8-d2f90581f085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b8ffc07f4091f25053a8a902353f5e1 2x, https://si.imgix.net/01992231/uploads/origins/42e00a9e-8d5a-4d61-b2d8-d2f90581f085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e38f0bbca0d4ff13dc161ec96eccb49 3x", "genre": "art", "nsfw": false, "body": "絵柄が大変好みなのでリクエストをさせていただきます｡ \nお手隙の際にでもご検討ください｡  \n\n・狐の耳､尻尾をもつほぼ人間の見た目のお姉さん \n・白いストレートの髪で前髪ぱっつん姫カット\n ・優しそうだけど妖艶な雰囲気の笑顔 \n・和服っぽい衣装\n ・大人っぽい等身で細すぎない身体 \n・かなり大きめな胸(キャラクター自身の手の平で覆えない程のサイズは最低限欲しい) \n ・夜の山奥の忘れられた神社の様な背景があると良いが､例えば夜空と寂れた鳥居があるくらいで可", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/5", "thumbnail_src": "https://si.imgix.net/ba7a58b3/uploads/origins/a64cc14e-686b-4d2e-95c6-854e45ea173f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c494911fd0280d6f29f2e94b68ce1a8", "thumbnail_srcset": "https://si.imgix.net/ba7a58b3/uploads/origins/a64cc14e-686b-4d2e-95c6-854e45ea173f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c494911fd0280d6f29f2e94b68ce1a8, https://si.imgix.net/ba7a58b3/uploads/origins/a64cc14e-686b-4d2e-95c6-854e45ea173f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f93ee67c2b9844c72ad769bbbc9fdab2 2x, https://si.imgix.net/ba7a58b3/uploads/origins/a64cc14e-686b-4d2e-95c6-854e45ea173f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40f0b8cd7582a250affa0f1197182de5 3x", "genre": "art", "nsfw": false, "body": "始めまして、鏡照魔と申します。\n作品一覧を見ているときに目に留まりこの度リクエストをさせていただきます！\n下記に詳しいことを書かせていただきます、ご検討のほどよろしくお願いいたします\n\n▼使用用途\n・YouTubeのサムネイル(予定表やライブのサムネ等)\n・YouTubeライブの配信画面に表示\n・X等SNSでの使用\n・グッズ作成(いつになるかは未定です)\n\n▼イラスト詳細\n・コーヒーを飲んでいるところを描いていただきたいです(配信でよくコーヒーを飲むので)\n・ポーズや表情などはおまかせします\n・可能であれば表情差分をいくつかお願いしたいです\n・お手数でなければ背景を透過したものもいただきたいです\n・縦横の比率は特に指定はありません\n\n▼参考資料\n・三面図：https://twitter.com/kagamisyoma/status/1720021634273485151\n・Live2Dの動作：https://www.youtube.com/live/bb8ax2H7jOQ?si=bGqZ4pZYOYcpk1lv \n　(14分から28分の間で表情差分や衣装などが確認できると思います)\n\n▼補足(三面図に言及されてない容姿など)\n・左の耳にピアスがついてます\n・髪の毛の中に銀カラーの髪(ライン)があります\n\n長文失礼しました。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/4", "thumbnail_src": "https://si.imgix.net/099a273c/uploads/origins/17be2241-1411-4b43-a298-d0ce061b5db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5df25b241925057a2ef2e9c0c7e503a", "thumbnail_srcset": "https://si.imgix.net/099a273c/uploads/origins/17be2241-1411-4b43-a298-d0ce061b5db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5df25b241925057a2ef2e9c0c7e503a, https://si.imgix.net/099a273c/uploads/origins/17be2241-1411-4b43-a298-d0ce061b5db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d3ec2352bb62dafa2b2f10f6570fd33 2x, https://si.imgix.net/099a273c/uploads/origins/17be2241-1411-4b43-a298-d0ce061b5db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fa10aee03d87676d5224ba391e122ee 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの絵がとても好きで、私のoc木内を描いてもらいたいと思っています！\nもしこのポーズが気に入らなければ、春の陽気で暖かく快適な雰囲気であれば、自由に修正してください！\n以下は私のOCの参考資料です： https://drive.google.com/file/d/1PoJqGjc-HMEKMwlzq0_hh-6Ry8mvi7G9/view?usp=sharing\n彼女は本当に優しい人で、いつも笑顔で、目はいつも楽しそうに輝いています。オーバーサイズのピンクのジャケット、茶色のクロップトップ、グレーのスカート、白いハイソックスを履いています。猫の尻尾には本当に大きなリボンがついていて、尻尾はグレーで、最後にブルーのグラデーションがかかっています。\n彼女の表情は、本当に幸せそうで微笑ましく、また、もし私があげたプリンシパルアイデアがあなたに合わないなら、どんなポーズでも自由に作ってください！\nもし私の依頼を受けることになったら、本当にありがとうございます！あなたの良い一日と健康を祈っています！", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/3", "thumbnail_src": "https://si.imgix.net/f2a7639e/uploads/origins/d55d6352-88f8-456c-8f73-0e5b1114db15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1428856926a717c76cb646a165b1881d", "thumbnail_srcset": "https://si.imgix.net/f2a7639e/uploads/origins/d55d6352-88f8-456c-8f73-0e5b1114db15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1428856926a717c76cb646a165b1881d, https://si.imgix.net/f2a7639e/uploads/origins/d55d6352-88f8-456c-8f73-0e5b1114db15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8502f1ba367c43834f03e5122d23344b 2x, https://si.imgix.net/f2a7639e/uploads/origins/d55d6352-88f8-456c-8f73-0e5b1114db15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ebc15ddc19930f63b550c2fa4b7e431 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風はとてもかわいいと思います！今日は私のキャラクターの絵をお願いします。夏も終わりに近づき、海辺で線香花火を持って暖かく微笑んでいる姿をお願いします。参考画像はフォルダをご覧ください。ありがとうございました。）\n\nhttps://drive.google.com/drive/folders/1rOTr49sraEq2DRB1XtBXzHYKQ_RB1I4S?usp=sharing\n\nhttps://drive.google.com/drive/folders/1rOTr49sraEq2DRB1XtBXzHYKQ_RB1I4S?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/2", "thumbnail_src": "https://si.imgix.net/74822dcd/uploads/origins/10625a9f-e963-4cf5-bf3d-fd6d66ca07fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=766a74541469290e1dd3e13357ccb53a", "thumbnail_srcset": "https://si.imgix.net/74822dcd/uploads/origins/10625a9f-e963-4cf5-bf3d-fd6d66ca07fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=766a74541469290e1dd3e13357ccb53a, https://si.imgix.net/74822dcd/uploads/origins/10625a9f-e963-4cf5-bf3d-fd6d66ca07fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67ac95cf37fa81cd9fa0665952561dd2 2x, https://si.imgix.net/74822dcd/uploads/origins/10625a9f-e963-4cf5-bf3d-fd6d66ca07fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97894758fc91493d6da0915f9b4f809b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)と恒一(168cm)をカップルらしく描いてください。\n詳細はお任せします。資料を参考にご自由にお描きください。\nなお作品の舞台は98年の北陸の田舎町(モデルは富山県)です。\n絵柄はなるべく公式に寄せてください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "created_at": "", "completed_at": ""}, {"path": "/@sumomo_otome/works/1", "thumbnail_src": "https://si.imgix.net/55aa898b/uploads/origins/feb1a2b4-b716-49f7-ab1d-b8fe3152e680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf5738cfbe5cb18334358424c0a6a8df", "thumbnail_srcset": "https://si.imgix.net/55aa898b/uploads/origins/feb1a2b4-b716-49f7-ab1d-b8fe3152e680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf5738cfbe5cb18334358424c0a6a8df, https://si.imgix.net/55aa898b/uploads/origins/feb1a2b4-b716-49f7-ab1d-b8fe3152e680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cab71cfb2c7846dba00503a75f68b14 2x, https://si.imgix.net/55aa898b/uploads/origins/feb1a2b4-b716-49f7-ab1d-b8fe3152e680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74c95ab9fd3793f177b63731ed914cde 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nSNSで見つけました！\n原神のディルックと自分のちびぐるみを持っているキャラクターを描いてください！\n表情やポーズはお任せします。\nありがとうございます。\n\nhttps://imgur.com/a/nY1HFr6", "created_at": "", "completed_at": ""}]}