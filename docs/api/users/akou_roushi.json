18-8ea2-df4b2b45a105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77563850d1026a7cd4942987d33e9ba7, https://si.imgix.net/fac097ef/uploads/origins/dad0903e-8479-4618-8ea2-df4b2b45a105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=369b4f87b77c127a65726e741f69a253 2x, https://si.imgix.net/fac097ef/uploads/origins/dad0903e-8479-4618-8ea2-df4b2b45a105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fe7954b236b1f19b52ce02c8644ac06 3x", "genre": "art", "nsfw": true, "body": "ご予定に余裕があれば\n以下のイラストをリクエストする事は可能でしょうか。\n\n登場作品　　：ToHeart\nキャラクター：宮内レミィ（PS版のデザイン）\nポーズ：恋人とのプレイ後にピースをしている\n場所：穴場のような体育倉庫\n差分１：顔にぶっかけられている\n差分２：レイヤー設定のみ黒目線の差分が作成できるのなら作成していただけるとありがたいです。\n\n可能であれば、下記の差分を作成してほしいです。\n・脅迫されて涙目かつ無理やりの笑顔で、ピースをしているところを撮影させられている。\n\nご検討のほどよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/58", "thumbnail_src": "https://si.imgix.net/5c2ce0f8/uploads/origins/a6fbdc82-b6a0-457c-a6e0-af26ec4a55ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5842f41e399c42e194fadc89a67ef3b3", "thumbnail_srcset": "https://si.imgix.net/5c2ce0f8/uploads/origins/a6fbdc82-b6a0-457c-a6e0-af26ec4a55ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5842f41e399c42e194fadc89a67ef3b3, https://si.imgix.net/5c2ce0f8/uploads/origins/a6fbdc82-b6a0-457c-a6e0-af26ec4a55ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4703e052a799743668cec024c09e54cf 2x, https://si.imgix.net/5c2ce0f8/uploads/origins/a6fbdc82-b6a0-457c-a6e0-af26ec4a55ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1075d12a7e7195100cdeb216f61c0587 3x", "genre": "art", "nsfw": true, "body": "前に二度、ウランちゃんを描いていただいた者です。またウランを描いていただけないでしょうか。\n\n今回は、服が破けてほぼ全裸になりながら戦っているところをお願いします。\nあられもない姿を晒していることに気付かないまま、例えば飛び蹴りやヒップアタックなどで格好良く戦っている、というようなイメージです。\n戦う相手は人間でもロボットでもマジックハンドでも良いですし、相手は描かずにウラン単独でも良いです。\n\nどうかよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/57", "thumbnail_src": "https://si.imgix.net/b1f6e90c/uploads/origins/b0158993-f0f4-4a1e-b045-cc3a61e34576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2f1c36c5e3e6025d36b98cf2cb7826", "thumbnail_srcset": "https://si.imgix.net/b1f6e90c/uploads/origins/b0158993-f0f4-4a1e-b045-cc3a61e34576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2f1c36c5e3e6025d36b98cf2cb7826, https://si.imgix.net/b1f6e90c/uploads/origins/b0158993-f0f4-4a1e-b045-cc3a61e34576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f64c4d42827765042713b502c1482360 2x, https://si.imgix.net/b1f6e90c/uploads/origins/b0158993-f0f4-4a1e-b045-cc3a61e34576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccb15568c79fa58f4495efca7b35471e 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしい作品をありがとうございました。またリクエストをさせて下さい。\n今回も『ボクカノ2～幼馴染に先輩に、迷えるオトコの三角関係』から、大沢潤と西野由宇の2人をお願いします。\n\nhttps://i.imgur.com/GwtcNWp.png（潤）\nhttps://i.imgur.com/b4B1Hbp.png（潤、女装前）\nhttps://i.imgur.com/581vxqk.png（由宇） \n\nhttps://skeb.jp/@akou_roushi/works/9\n前回は2人が電車の中で恋人の真治から痴漢されているシーンをお願いしましたが、今回は（真治の趣味で）真治に男の格好で痴漢されてしまう2人を正面から描いて下さい。\n潤は女装前の姿が本編にありますが、由宇の男子姿もぜひ見てみたいです。\nズボンのチャックからペニスを取り出され、扱かれてしまう2人をエロ可愛く描いて下さい。\n\n男装での痴漢は女装での痴漢より羞恥心マシマシでお願いします。\n前回同様、不安げな表情やアヘ顔など、表情や射精の差分もあると嬉しいです。\n\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/56", "thumbnail_src": "https://si.imgix.net/9f81335b/uploads/origins/02151031-caac-4a04-a463-34abe4419288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc8476dcfba4d220bb8bf1f0e5faa686", "thumbnail_srcset": "https://si.imgix.net/9f81335b/uploads/origins/02151031-caac-4a04-a463-34abe4419288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc8476dcfba4d220bb8bf1f0e5faa686, https://si.imgix.net/9f81335b/uploads/origins/02151031-caac-4a04-a463-34abe4419288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60fee01cd7d133df3b343348c443454d 2x, https://si.imgix.net/9f81335b/uploads/origins/02151031-caac-4a04-a463-34abe4419288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e899e3139ff7a94e9c2e64f12b4b74b5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/55", "thumbnail_src": "https://si.imgix.net/17f5089f/uploads/origins/73e4786f-efc8-4d78-ab50-472c0002e7b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=514fdb8e484591788272008072b8b84b", "thumbnail_srcset": "https://si.imgix.net/17f5089f/uploads/origins/73e4786f-efc8-4d78-ab50-472c0002e7b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=514fdb8e484591788272008072b8b84b, https://si.imgix.net/17f5089f/uploads/origins/73e4786f-efc8-4d78-ab50-472c0002e7b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf76311c0e2bfd8c2eedf720b3d58fdc 2x, https://si.imgix.net/17f5089f/uploads/origins/73e4786f-efc8-4d78-ab50-472c0002e7b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5f11dc7f9e8666ef0ed545d59c19f11 3x", "genre": "art", "nsfw": true, "body": "お世話になっております、牛の王子さまでち＠８６ｋです。\n今回もリクエストをお受けいただけたら幸いです。\n\n【作品】フラワーナイトガール\n【人物】ハツユキソウ（花騎士）\n【衣装】通常衣装（進化前）\nhttps://i.imgur.com/b2FNAPo.png\n正面首元はこちらになります\nhttps://i.imgur.com/HWi038U.png\n【キャラクター参考】\nhttps://imgur.com/VIYGRN9\n\n【シチュエーション】\nタイミング的にお正月ですので（「あけおめこ」ということです）おまんこを拡げて見せているハツユキソウを描いてください、お願いいたします。\n※一般的に指で拡げられる程度のくぱぁをお願いします、先生のイラストで言いますとこちら（https://skeb.jp/@akou_roushi/works/4）のイラスト程度のくぱぁが好みです\n\n具体的な要望は以下の通りです\n・体位と構図は先ほどの先生のイラストのような感じで正面向きにおまんこのアップが見える姿勢でお願いします。\n・衣装は半脱ぎで上部をはだけて乳首が見えるようにしてください、 ぱんつは白の綿タイプのシンプルなものを脚に引っ掛ける形で描写していただきますと嬉しいです。\n・表情は恥ずかしがっている表情でお願いします。\n※推しの着物姿でのおまんこくぱぁが見たいなぁと思ってのリクエストです\n・鑑賞時はスマホで見ますので、縦長、正面向きですと助かります。\n・自分で拡げさせてください、道具や他人の手は不要です。\n\n率直に言ってしまいますと前回のリクエストの衣装違いverが欲しいと言っていると思ってくださっても構いません\n（私の中では他に良い構図が思い浮かびませんでした、というのが主な理由です、先生がより良い構図があると思われるのであればそちらを優先していただいて結構です）\n\nまた、金額的に可能でございましたら全裸差分と、事後（という設定）でおまんこから精液が垂れて流れ出ている差分をいただけますと大変ありがたいです。\n\n以上が私の要望ですが、わかりにくい点や難しい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/54", "thumbnail_src": "https://si.imgix.net/283ddae9/uploads/origins/b2ab57ab-c10a-4621-8a8e-6bd13caf3baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a339b5878e72539c73dedce5339c89", "thumbnail_srcset": "https://si.imgix.net/283ddae9/uploads/origins/b2ab57ab-c10a-4621-8a8e-6bd13caf3baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a339b5878e72539c73dedce5339c89, https://si.imgix.net/283ddae9/uploads/origins/b2ab57ab-c10a-4621-8a8e-6bd13caf3baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4aee8caa0def2fa79ae1834ed9ae974 2x, https://si.imgix.net/283ddae9/uploads/origins/b2ab57ab-c10a-4621-8a8e-6bd13caf3baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4245c6d58d74ba5895f0782f38a03d4a 3x", "genre": "art", "nsfw": false, "body": "ご都合よろしければお願いします！\nロボガやMS少女の感じでドゥー・ムラサメを書いて頂きたいです。\n細かな指定はありませんのでおまかせします！", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/53", "thumbnail_src": "https://si.imgix.net/7171d561/uploads/origins/2a5c9940-4534-419e-8c7d-06a48d3ab594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d80256de54c49dfac0664d506c57c6f", "thumbnail_srcset": "https://si.imgix.net/7171d561/uploads/origins/2a5c9940-4534-419e-8c7d-06a48d3ab594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d80256de54c49dfac0664d506c57c6f, https://si.imgix.net/7171d561/uploads/origins/2a5c9940-4534-419e-8c7d-06a48d3ab594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20912fd4a19ca37c7951bf5fd4570183 2x, https://si.imgix.net/7171d561/uploads/origins/2a5c9940-4534-419e-8c7d-06a48d3ab594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=299234b3bed904e5f0a3d044e84d1bd7 3x", "genre": "art", "nsfw": true, "body": "以前は素敵なイラスト納品ありがとうございます赤穂老師先生、もしよろしければまた描いて頂きたくリクエストしました。\n\n■キャラは艦隊これくしょんから電ちゃんを\n■衣装はhttps://wikiwiki.jp/kancolle/%E9%9B%BBで艤装は無しで指輪有でお願いします\n〇ベットヤクザな電ちゃんが提督の精液を絞り取る女性上位シチュでの甘サドSEXイラスト\nを希望します\n☆接合部がスカートで隠れている見えない構図での騎乗位SEXイラストを希望します\n☆早漏な司令官さんには悪いのですけど電はまだイッテないのです的な台詞を希望します\n☆細かな構図やポーズ等はお任せします\n\nもしよろしければ検討していただけると嬉しいですよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/52", "thumbnail_src": "https://si.imgix.net/4c98ba58/uploads/origins/59c83f51-dda8-4e7c-9bbd-d980d92dd925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21071e731232c39123b36b2c95da2fd4", "thumbnail_srcset": "https://si.imgix.net/4c98ba58/uploads/origins/59c83f51-dda8-4e7c-9bbd-d980d92dd925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21071e731232c39123b36b2c95da2fd4, https://si.imgix.net/4c98ba58/uploads/origins/59c83f51-dda8-4e7c-9bbd-d980d92dd925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f5efab18dae730e822a22eaf0771ae2 2x, https://si.imgix.net/4c98ba58/uploads/origins/59c83f51-dda8-4e7c-9bbd-d980d92dd925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=683e0869c59694b403df12967a80304e 3x", "genre": "art", "nsfw": true, "body": "6歳くらいのとてもキュートな女の子が、3cmくらいの小人さんをつまみ上げてお口の中に入れようとしているイラストをお願いします！ \n\n喉の奥がはっきり見えるほど大きく開いた女の子のお口の描写は必ず入れて欲しいです！ \n\nかなりフェチ要素の強いイラストですが、\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/51", "thumbnail_src": "https://si.imgix.net/c2cf8d25/uploads/origins/a087057a-2342-412e-8e3d-28c21763f95d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23e0fe34bc20c2aa71d4c525b88d9f88", "thumbnail_srcset": "https://si.imgix.net/c2cf8d25/uploads/origins/a087057a-2342-412e-8e3d-28c21763f95d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23e0fe34bc20c2aa71d4c525b88d9f88, https://si.imgix.net/c2cf8d25/uploads/origins/a087057a-2342-412e-8e3d-28c21763f95d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c3d197e77f80535372977bf5e48d83f 2x, https://si.imgix.net/c2cf8d25/uploads/origins/a087057a-2342-412e-8e3d-28c21763f95d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cefcdac6a8eb48be89dc0c09b8df25dd 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n「オンゲキ」というゲームの藤沢柚子のHなイラストのリクエストさせてもらいたいです。\n柚子が触手に拘束され、犯される。最初は涙目で怖がりながらも気持ち良くなって絶頂してしまうシチュエーションでお願いしたいです。\n\n衣装はシュータードレス(黄色基調の魔法少女風？のもの)でお願いします。衣装の破れは無しでお願いしたいですが、職種の粘液が衣装や体についていると嬉しいです。\n胸は盛らず、陰毛もなしでお願いします。\nもし可能であれば①挿入前②挿入中③絶頂時のイラストをいただきたいですが、条件や金額で難しければ挿入中のものをお願いします。\n\n以上お願いします。\n\nhttps://ongeki.sega.jp/character/1020/\n\nhttps://ongeki.sega.jp/character/1020/", "created_at": "", "completed_at": ""}, {"path": "/@akou_roushi/works/50", "thumbnail_src": "https://si.imgix.net/5f0505b3/uploads/origins/710ae41b-075c-4285-8146-376c8a5a3642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3cd29ffbe2c900508f8572af9860cba", "thumbnail_srcset": "https://si.imgix.net/5f0505b3/uploads/origins/710ae41b-075c-4285-8146-376c8a5a3642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3cd29ffbe2c900508f8572af9860cba, https://si.imgix.net/5f0505b3/uploads/origins/710ae41b-075c-4285-8146-376c8a