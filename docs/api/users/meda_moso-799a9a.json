に胸（複乳）が大きくなり、胴体がヒューマンタウロスになり、足が増えた（たぶん6本？）彼女はついに自分の体の変化を目の当たりにし、恐怖を感じたが、すぐにオーガズムの快楽に没頭した。\n可能であれば、CG集にあるような台詞を加えて、改造の過程をより没入感のあるものにしてほしい！\n私のリクエストにご賛同いただけるなら、とてもありがたい！", "created_at": "", "completed_at": ""}, {"path": "/@meda_moso/works/72", "thumbnail_src": "https://si.imgix.net/82764f36/uploads/origins/6aeb2f86-e5b5-46b4-ae98-3d0e40db3ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f4897e3c94773ac4bb0ff75aeb5c14b", "thumbnail_srcset": "https://si.imgix.net/82764f36/uploads/origins/6aeb2f86-e5b5-46b4-ae98-3d0e40db3ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f4897e3c94773ac4bb0ff75aeb5c14b, https://si.imgix.net/82764f36/uploads/origins/6aeb2f86-e5b5-46b4-ae98-3d0e40db3ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f61a773961652ea336983c7bae681bf1 2x, https://si.imgix.net/82764f36/uploads/origins/6aeb2f86-e5b5-46b4-ae98-3d0e40db3ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ed41457d3bfee8b6c97fefa8831da7d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@meda_moso/works/71", "thumbnail_src": "https://si.imgix.net/1e35f5a5/uploads/origins/a00238c7-0f7b-436d-b2bc-f257fb9a2b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef82e820706e61613e3d37f677715f0b", "thumbnail_srcset": "https://si.imgix.net/1e35f5a5/uploads/origins/a00238c7-0f7b-436d-b2bc-f257fb9a2b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef82e820706e61613e3d37f677715f0b, https://si.imgix.net/1e35f5a5/up