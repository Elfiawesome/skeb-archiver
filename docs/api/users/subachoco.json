t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d3d47b78a57964ebd34d39401c6dd99 2x, https://si.imgix.net/a3c8ed34/uploads/origins/35aac7cf-f16d-4454-8d08-149037895766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a57a6a2dfead1ab7cd7d4558c22aeec 3x", "genre": "art", "nsfw": false, "body": "こんすば！アピールおよびリクエストの再送ありがとうございます。\n依頼しようと思っていたので嬉しいです！\n\n以下、お願いしたい点です。\nキャラはフランドール・スカーレット\n衣装はお任せします、露出が少ないものだと嬉しいです。\n太ももは許容範囲です。\n\nジト目かぱっちりでお願いします。\n\nその他は全てお任せします、アイコンやヘッダーなどに使用しやすいと嬉しいです。\n\nご検討お願いします！", "created_at": "", "completed_at": ""}, {"path": "/@subachoco/works/44", "thumbnail_src": "https://si.imgix.net/6a550eb0/uploads/origins/326a3156-fe79-4685-a8a2-65f635aafac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0055f8c316d89e2b2d1e9fbfc81f9a", "thumbnail_srcset": "https://si.imgix.net/6a550eb0/uploads/origins/326a3156-fe79-4685-a8a2-65f635aafac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0055f8c316d89e2b2d1e9fbfc81f9a, https://si.imgix.net/6a550eb0/uploads/origins/326a3156-fe79-4685-a8a2-65f635aafac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c1a11a44b5e6f75725f811bc67ebfa 2x, https://si.imgix.net/6a550eb0/uploads/origins/326a3156-fe79-4685-a8a2-65f635aafac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=035ccae9f87cd891a1a2e474d043c5f5 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。先日は素敵なイラストを描いていただき、ありがとうございました。\n今回は、ヤンデレな宇佐見蓮子とマエリベリー・ハーンが家に押しかけてくるイラストをお願いします。\n電話もメールも返ってこなくなって、痺れを切らした蓮子さんとメリーさんが家まで来て玄関を叩き続ける、又はインターホンを押し続けるというシチュエーションでお願いします。\n\n○以下、お願いしたい点です。\n・おっぱいは2人とも大きめでお願いします。\n・セリフ付きでお願いしたいのですが、「なんで電話もメールも返してくれないの？」や「早くここ開けてよ」、「まさか、他の女がいるの？」、「入れてくれるまで帰らないからね」みたいな感じでお願いします。\n・セリフなどの文字は表示、非表示で切り替えられるようにして欲しいです。\n\nご都合がよろしければ、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@subachoco/works/43", "thumbnail_src": "https://si.imgix.net/cbe213d0/uploads/origins/6faff4c2-ed18-42a4-b4f0-5e97ea3b6e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=855cd1076d162d3ca7df84681d21df36", "thumbnail_srcset": "https://si.imgix.net/cbe213d0/uploads/origins/6faff4c2-ed18-42a4-b4f0-5e97ea3b6e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=855cd1076d162d3ca7df84681d21df36, https://si.imgix.net/cbe213d0/uploads/origins/6faff4c2-ed18-42a4-b4f0-5e97ea3b6e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13552e5f52974a88adea252e6aaab264 2x, https://si.imgix.net/cbe213d0/uploads/origins/6faff4c2-ed18-42a4-b4f0-5e97ea3b6e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2015aef6d3bf73a6baed03fcc0bf7d4 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。先日は素敵なイラストを描いていただき、ありがとうございました。\n今回は、ヤンデレな宇佐見蓮子が包丁と手錠を持って迫ってくるイラストをお願いします。\n我慢できなくなった蓮子さんが包丁と手錠を持って、頬を赤くして息を荒くしながら脅すように迫ってくるシチュエーションでお願いします。\n\n○以下、お願いしたい点です。\n・右手に包丁、左手に手錠を持たせてください。\n・おっぱいは大きめでお願いします。\n・セリフ付きでお願いしたいのですが、「もう我慢できない…」や「痛いのが嫌だったら…わかるよね？」、「これから楽しいこと、しようね♡」みたいな感じでお願いします。\n・セリフなどの文字は表示、非表示で切り替えられるようにして欲しいです。\n\nご都合がよろしければ、よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}