hlqvlGBA4qPOf72YNtitsrB7bstpAGD7\n\nGoogle Driveの①がそれぞれのビジュアル基本資料になります。\n②が服装の参考画像です。お相手の服装につきましては画像のイメージですが、着崩さずきっちりと身に着けるタイプです。描きやすいように改変頂いても大丈夫です。\n③は夢主の帽子・靴になります。靴は描写範囲によっては見えないと思うので必須ではありません。\nまた、④の共通アイテムをお揃いで身に着けています。\n\n描写範囲や背景等、おまかせいたします。\nどうかご縁がありますように。", "created_at": "", "completed_at": ""}, {"path": "/@GMT441/works/46", "thumbnail_src": "https://si.imgix.net/7ad70c71/uploads/origins/db15c5a9-b311-4306-9722-3b2b180c7d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2ccdbdbf471addf8d2830f73a561e93", "thumbnail_srcset": "https://si.imgix.net/7ad70c71/uploads/origins/db15c5a9-b311-4306-9722-3b2b180c7d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2ccdbdbf471addf8d2830f73a561e93, https://si.imgix.net/7ad70c71/uploads/origins/db15c5a9-b311-4306-9722-3b2b180c7d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=269fabbbd21ec7abf1765cab44dacd47 2x, https://si.imgix.net/7ad70c71/uploads/origins/db15c5a9-b311-4306-9722-3b2b180c7d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ac8e343dc0cc8a98ec2b8a0daab3cb8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GMT441/works/45", "thumbnail_src": "https://si.imgix.net/65509c76/uploads/origins/d63c6d5f-c725-46b6-98d8-7e3e55d42c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a1aa06156cef58325a3bfb9c7363c82", "thumbnail_srcset": "https://si.imgix.net/65509c76/uploads/origins/d63c6d5f-c725-46b6-98d8-7e3e55d42c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&