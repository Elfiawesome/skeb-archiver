c8/uploads/origins/26b81959-a866-433b-9120-b03b980edadc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=715ee343e6de24a8384a58b3aeef4ccc 2x, https://si.imgix.net/f3462ec8/uploads/origins/26b81959-a866-433b-9120-b03b980edadc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9d1bf0e29587cca79dd6a74dd728a8e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_10shock/works/44", "thumbnail_src": "https://si.imgix.net/df3dc946/uploads/origins/91b92bfe-63a6-4f75-877a-bf29ebfe3ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caff477d91a95a5a9cf47ac03cb3e90f", "thumbnail_srcset": "https://si.imgix.net/df3dc946/uploads/origins/91b92bfe-63a6-4f75-877a-bf29ebfe3ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caff477d91a95a5a9cf47ac03cb3e90f, https://si.imgix.net/df3dc946/uploads/origins/91b92bfe-63a6-4f75-877a-bf29ebfe3ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7d4330abe1cd13c03db8dfcd2319a2d 2x, https://si.imgix.net/df3dc946/uploads/origins/91b92bfe-63a6-4f75-877a-bf29ebfe3ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24e6692011fda67cbe6039478208314b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！以前納品していただいた作品がとても素敵だったので、再び前回と同じ創作キャラで描いていただきたく依頼をさせていただきます。以下、希望要素です。\n\n以前の子が壊されて堕ちた後の話です。人扱いされていないけれど本人はモブに擦り寄っていくので、手酷く犯していただきたいです。\n・ヒトイヌ\n・フラット貞操帯\n・おもらし、嬉ションなど\n\nよろしくお願いいたします。\n\n\nhttps://www.dropbox.com/scl/fi/7bbueikvag4uq8qt4bqdx/.png?rlkey=2pqa8qr1v1gkbvf3bbcqgvyxh&dl=0\n\nhttps://www.dropbox.com/scl/fi/7bbueikvag4uq8qt4bqdx/.png?rlkey=2pqa8qr1v1gkbvf3bbcqgvyxh&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@_10shock/works/43", "thumbnail_src": "https://si.imgix.net/4e80d274/uploads/origins/963addd3-dd56-41de-943b-722559c0fa9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f91703b6f0055232eb603955e02d31a", "thumbnail_srcset": "https://si.imgix.net/4e80d274/uploads/origins/963addd3-dd56-41de-943b-722559c0fa9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f91703b6f0055232eb603955e02d31a, https://si.imgix.net/4e80d274/uploads/origins/963addd3-dd56-41de-943b-722559c0fa9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f731d1e02d381b728d3b2d2589f5ac8a 2x, https://si.imgix.net/4e80d274/uploads/origins/963addd3-dd56-41de-943b-722559c0fa9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5376503fc5ee7e50d7cde031b5e6da1 3x", "genre": "art", "nsfw": true, "body": "抵抗虚しく女の子にされちゃって、メスの快楽で堕とされちゃう系のTSシチュが大好きです。\n先生の作品はそこに無様エロや触手やダークで退廃的な雰囲気が織り込まれていてめちゃくちゃツボです。\n先生の描く男性はクールそうな青年もあどけない男の子もどちらも私に効きまくりです。\n\n昨年、先生がぴっちりスーツ描かれてるのを拝見しました。\nたとえばですが、いわゆる悪堕ち系とか、関連シチュで最近流行りの人格排泄とかお好きでしょうか？\n\nもし描けたりチャレンジ頂けるなら、変則的ですがこんな感じのシチュはいかがでしょうか。\n\n***\n\n捕まってしまい、男性成分を排泄させられることに。お尻と尿道口の両方から一本糞のようにケミカルな色でひり出てきてしまう。\n全部出したら女の子になってしまうのに、おちんちんもどんどん小さくなってるのに、おっぱいも膨らんできてるのに、便意や射精のような感覚とある種の快感は我慢しても止められず。\n喚き悶えてる間に結局男の子成分全部出してイってしまい、女の子の体で今まで感じたことのないような長い余韻に浸る。\n\n***\n\n人格排泄ではないですが、大事なものを排泄という無様な形で失うこととその絶望感でエロいかなと思っています。\n\n男性成分を排泄される原因は、経口薬か注射あたりかなと思っていますが、これはあくまで設定レベルなので描写問いません。\nその後はディルドや竿役によりメスの快楽を叩き込まれる絶望セックス展開をイメージしていますが、これも設定レベルになってしまうでも結構です。\n最後に射精の感覚味わわせてあげようと思いおちんちんからも排泄するようにしてますが、微妙そうであればお尻だけにしたり、おちんちんからは少しだけにしたり他のものにしてもよいです。\n\nまた男性成分が排出されるなら女性化ではなく無性化じゃないか？という疑問も少し持っているのですが、ここはファンタジーなのでツッコミなしで。ただやはり絵としてイマイチかもというようであれば、注射と一緒とか、別途乳首からとかで、女性成分注入も同時にやっている設定でもOKです。\n\nご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_10shock/works/42", "thumbnail_src": "https://si.imgix.net/295c5402/uploads/origins/c912578e-368d-490c-8af2-108b93fd1a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&