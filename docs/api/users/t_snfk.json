b3e-6628953339db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=729f98caed36c9e4b33e7c701da76ed6", "thumbnail_srcset": "https://si.imgix.net/eec04093/uploads/origins/4fb52d43-0bb0-4c77-bb3e-6628953339db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=729f98caed36c9e4b33e7c701da76ed6, https://si.imgix.net/eec04093/uploads/origins/4fb52d43-0bb0-4c77-bb3e-6628953339db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8dd74f30dcf3af3422e622ce9f27802 2x, https://si.imgix.net/eec04093/uploads/origins/4fb52d43-0bb0-4c77-bb3e-6628953339db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5099e3efa8d31ea29abc5072da414248 3x", "genre": "art", "nsfw": false, "body": "あなたのスタイルでヒロインを依頼したい。\nポーズの提案も含めて、あとはお任せします。\n\n重要な詳細\n\nキャラクターシューティングスター\n瞳： 美しい茶色の瞳\n髪: 非常に濃い茶色（真っ黒にならないようにしてください）\n肌：色白か少し日焼けしている\n\n参考ポーズ\nhttps://drive.google.com/file/d/1WKaxESTSeqKk5j1fnZhdzZ0P4Yullw2d/view?usp=drive_link\n\n参考衣装\nhttps://drive.google.com/file/d/1ibxYKHX-sFpJdbB0cQmyeXTsp7FaxGW8/view?usp=drive_link\nhttps://drive.google.com/file/d/13Ho1GRioNvrIvnb_9_nlNTG6W6KtC4lI/view?usp=drive_link\nhttps://drive.google.com/file/d/1WuFGGJO1eOB8jXhLDRZrVWR2nsN5VZrs/view?usp=drive_link\nhttps://drive.google.com/file/d/1OB68l_zWI1PFmcLGQWqF47XUAhroLDIr/view?usp=drive_link\n\n彼女の顔には2つの美点がある。\n\nhttps://drive.google.com/file/d/10nORbzD4yg7_RR7yGFWmQJbG4RTPW7N1/view?usp=drive_link\n\n参考文献\nhttps://drive.google.com/drive/folders/13wtVGKm2b50bf1tlGk3PDC7PcTZbCq0A?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@t_snfk/works/38", "thumbnail_src": "https://si.imgix.net/eabfd93b/uploads/origins/47944320-912e-4541-9257-beb73711d17e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9ea43d6e1dd3fcf0dea75e6fea2fb5", "thumbnail_srcset": "https://si.imgix.net/eabfd93b/uploads/origins/47944320-912e-4541-9257-beb73711d17e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9ea43d6e1dd3fcf0dea75e6fea2fb5, https://si.imgix.net/eabfd93b/uploads/origins/47944320-912e-4541-9257-beb73711d17e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4dcaac2e36e4f5e2b96d667654a375d 2x, https://si.imgix.net/eabfd93b/uploads/origins/47944320-912e-4541-9257-beb73711d17e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5105864865b7e7fd305a73747b843220 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お久しぶりです！私の鬼娘、聖華ちゃんを覚えていますか？青い悪魔に赤い獰猛な姿。これは新キャラクターのシロッコで、セイカの姉です。  ご覧の通り、妹より背が低く（152cm）、胸も小さい。セイカの時と同じようなイメージで、緑色の肌に白い髪、できれば風のようなオーラのある別フォームを希望します。できれば、風のようなオーラも欲しいです。聖華と比べると、彼女は落ち着いていて、冷静だ。緑のフォームでの彼女の表情は、怒ってはいないが真剣なものであるべきだ。また、知恵の漢字は上着の背中にあるが、ポーズは自由に選んでほしい。\n\nhttps://imgur.com/6ACR2sM", "created_at": "", "completed_at": ""}, {"path": "/@t_snfk/works/37", "thumbnail_src": "https://si.imgix.net/822e4b5b/uploads/origins/885824e5-4b5b-4e7b-86c1-d9ccd7eaad06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e576a42f2b358eabca0f6ac97306d16e", "thumbnail_srcset": "https://si.imgix.net/822e4b5b/uploads/origins/885824e5-4b5b-4e7b-86c1-d9ccd7eaad06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e576a42f2b358eabca0f6ac97306d16e, https://si.imgix.net/822e4b5b/uploads/origins/885824e5-4b5b-4e7b-86c1-d9ccd7eaad06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23861e1d848ca21a8662f971b0e3c131 2x, https://si.imgix.net/822e4b5b/uploads/origins/885824e5-4b5b-4e7b-86c1-d9ccd7eaad06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d23d0c92ab27cf2052dbde9ce92cdbcb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、砂吹さん、新しいお願いがあります。私の3人のOCをアクションポーズで、見る人の方を向いて描いて欲しいのです。もしよかったら、フォルダにある「アタック！」のポーズをそのまま再現していただいてもいいのですが、小さい方が真ん中、あとの2人は左右でお願いします。\n\n参考文献\nhttps://drive.google.com/drive/folders/1PpS12hfecH7FQpwCLqpjYVw_z6nPl1js?usp=sharing\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1PpS12hfecH7FQpwCLqpjYVw_z6nPl1js?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@t_snfk/works/36", "thumbnail_src": "https://si.imgix.net/0bca300b/uploads/origins/ebbc20fb-a2b5-4f4a-9135-3e11a1980541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afcaf505e854d525dd583c0febaf9520", "thumbnail_srcset": "https://si.imgix.net/0bca300b/uploads/origins/ebbc20fb-a2b5-4f4a-9135-3e11a1980541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afcaf505e854d525dd583c0febaf9520, https://si.imgix.net/0bca300b/uploads/origins/ebbc20fb-a2b5-4f4a-9135-3e11a1980541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78f00accf0a0dc7fb950bcd46b523515 2x, https://si.imgix.net/0bca300b/uploads/origins/ebbc20fb-a2b5-4f4a-9135-3e11a1980541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e54889f843dd7a44eb7bede80ef5b772 3x", "genre": "art", "nsfw": false, "body": "こんにちは～(^^)\n\nXであなたの女性ファイターのアートを見ました！\n\n私の持っているキャラクター、スーザン・グレースのかっこいい戦闘シーンやキックポーズのイラストをお願いしてもいいですか？\n\nここに彼女の参考資料があります：\n\ndrive.google.com/drive/folders/1EcgqOzpBVWfZBz7l3nzj_748-4nrUtXt\n\nまた、彼女に関する情報や昔の依頼などもありますので、お役に立てれば幸いです：\n\ndocs.google.com/document/d/1JKIeEf-vePC7x7vtTAoXwLNQLOQpeba8d29RbctfWKU\n\nスーザンは俊敏でアクロバティックな総合格闘家で、主に足を使って戦う。ムエタイとテコンドーの格闘スタイルに長けており、柔道の投げ技やサブミッションの知識もある。柔道の投げ技やサブミッションの知識もある。\n\ndrive.google.com/drive/folders/1rWWKOnTSMzfeaoTTIYQtn2nL2ZSAizdH\n\ndeviantart.com/jack31233/gallery/71289501/susan-grace\n\n詳細はお任せします。\n\n長い間読んでいただきありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@t_snfk/works/35", "thumbnail_src": "https://si.imgix.net/1dbcd1f9/uploads/origins/1b96648d-1a1a-40fe-8601-1516c2c1783f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec102a3d999b1cad3fdf24ea189a3d1e", "thumbnail_srcset": "https://si.imgix.net/1dbcd1f9/uploads/origins/1b96648d-1a1a-40fe-8601-1516c2c1783f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2