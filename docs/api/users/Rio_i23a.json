x.net/a3e2393d/uploads/outputs/14bcd1ef-dbcf-47a1-8e42-539c4f43e4c5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca9433f2ae15ab6aa035df3a7c65835e, https://si.imgix.net/a3e2393d/uploads/outputs/14bcd1ef-dbcf-47a1-8e42-539c4f43e4c5?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c750b663d8fcdd70a17a4aae6fce7e4c 2x, https://si.imgix.net/a3e2393d/uploads/outputs/14bcd1ef-dbcf-47a1-8e42-539c4f43e4c5?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bf81a857522eaf55365cc49532825b3 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/83", "thumbnail_src": "https://si.imgix.net/850f8f02/uploads/origins/5ec1adb2-6f4b-4995-b23f-3d14e18cd444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fa4dd6e47dcafdbd432487445a30f13", "thumbnail_srcset": "https://si.imgix.net/850f8f02/uploads/origins/5ec1adb2-6f4b-4995-b23f-3d14e18cd444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fa4dd6e47dcafdbd432487445a30f13, https://si.imgix.net/850f8f02/uploads/origins/5ec1adb2-6f4b-4995-b23f-3d14e18cd444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c938f95adecb67d3b93978adfe80492 2x, https://si.imgix.net/850f8f02/uploads/origins/5ec1adb2-6f4b-4995-b23f-3d14e18cd444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a360a478d0368be939850762a7ec6c9 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n前回の作品、本当にありがとう！大好きです :3\n\n私のキャラクターは新しい衣装が完成したばかりなので、もしよろしければまた描いていただけると嬉しいです！\n\nまた、この新衣装は「覚醒」状態で、体中に光るマークがあります。このマークがあるものとないものを描いてもらえるとうれしいです！でも、オプションでも構いません。\n\n細かいことはお任せします！^^\n\nありがとうございました！\nゼン\n\nhttps://drive.google.com/drive/folders/1vKZFt8jfRZtzfpIzJo4SfLwUzgykW9_6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/82", "thumbnail_src": "https://si.imgix.net/6ec0272b/uploads/outputs/d2612195-5f81-41a5-b749-9f7b6eb8fc09?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=caa40c30ef5d8fe5f9ce8e0bec9908c7", "thumbnail_srcset": "https://si.imgix.net/6ec0272b/uploads/outputs/d2612195-5f81-41a5-b749-9f7b6eb8fc09?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=caa40c30ef5d8fe5f9ce8e0bec9908c7, https://si.imgix.net/6ec0272b/uploads/outputs/d2612195-5f81-41a5-b749-9f7b6eb8fc09?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=06ec46a0cc8e333db0b2687c6122629c 2x, https://si.imgix.net/6ec0272b/uploads/outputs/d2612195-5f81-41a5-b749-9f7b6eb8fc09?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=050fe26e10ea6ac527725fa847cb5b16 3x", "genre": "video", "nsfw": true, "body": "李央さん、初めまして。( 'ω'   )\n反応が遅れて申し訳ありません。\nアピールにてうちの子ルビルくんを描きたい、と言ってくださりありがとうございます。\n今回はケモミミのヒト形態を取っているルビルくんを描いていただきたいです。\n資料は下に載せますので、キャラクターの参考として必ず見通してください。\n\nhttps://drive.google.com/drive/folders/10Gn-LLQNoqY9mM7Hy6XOovny8CQhFQ4X\n\nルビルくんの頭身と体型は李央さんが過去に受けたこのイラスト( https://skeb.jp/@Rio_i23a/works/56 )と同じくらいで描いてもらえると嬉しいです。\n\n短めなループアニメを希望しており、この作品( https://x.com/furkendonsfw/status/1798346105702469786?s=61&t=r2KUVpelirNUdwyFqyM1kA )と同じローアングルでセックスしている物を制作してほしいです。\n難しい場合は他の構図や体位でしてる感じで大丈夫です。\nまた、ルビルくんの衣装も上の作品と同じのを希望しています。\n\n【できれば欲しい要素】\n・背景色として夜か夕方と分かる薄暗い色\n・ハート目\n・(可能であれば)射精とか事後の動き\n・全体的にムーディーでえち可愛い感じ\n\n要望は以上です。何かあれば再送申請をください。\n李央さんが楽しくヒトのルビルくんを描いてもらえたら嬉しいです。\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/81", "thumbnail_src": "https://si.imgix.net/ba4e60b4/uploads/origins/0a72c466-9964-4a85-8e40-1c5d3c1fb281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edafc7779e6ea6c7b6bf7553e8cfa513", "thumbnail_srcset": "https://si.imgix.net/ba4e60b4/uploads/origins/0a72c466-9964-4a85-8e40-1c5d3c1fb281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edafc7779e6ea6c7b6bf7553e8cfa513, https://si.imgix.net/ba4e60b4/uploads/origins/0a72c466-9964-4a85-8e40-1c5d3c1fb281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e3bb34aeb50c46615666602acbdda19 2x, https://si.imgix.net/ba4e60b4/uploads/origins/0a72c466-9964-4a85-8e40-1c5d3c1fb281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aeaca1f0c09f960a64e9e8796fff6b86 3x", "genre": "art", "nsfw": false, "body": "はじめまして、アピールしていただきありがとうございます。\n是非たぬきくんを描いていただきたいと思いリクエストを送らせてもらいます。\n\n今回はアピールの際に衣装変更の提案をして頂いた中の「ジャージメイド」をお願いしたいと考えています、\nそれ以外の部分についてはお任せでお願いします。\n\n参考資料を資料URLに記載しています、\n基本的なビジュアルや設定の他に、納品されたたぬきくんのイラストとシチュエーションのサンプルとして使えそうなスクリーンショットのファイルが入っています。\nよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/usxzh5yikp1pleweg2sdb/h?rlkey=tq8y32nwbsgijr5qnuz6bhab1&st=sp9qka25&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/80", "thumbnail_src": "https://si.imgix.net/b36a9112/uploads/origins/5a761635-0ff7-414d-9f7a-1e0c1d1c3f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd78fe8d633ddbffa5b4adc7a2ce4cd", "thumbnail_srcset": "https://si.imgix.net/b36a9112/uploads/origins/5a761635-0ff7-414d-9f7a-1e0c1d1c3f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd78fe8d633ddbffa5b4adc7a2ce4cd, https://si.imgix.net/b36a9112/uploads/origins/5a761635-0ff7-414d-9f7a-1e0c1d1c3f38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b886c67bc119fb555d045f0f487941e5 2x, https://si.imgix.net/b36a9112/uploads/origins/5a761635-0ff7-414d-9f7a-1e0c1d1c3f38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04acd37f33f2575f554065cadfbf8bf9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールをありがとう！\n\nあなたの絵は素晴らしいので、私のキャラクターをどうするかぜひ見てみたいです！\n\nアピールにあったようなプラグスーツの使用も大歓迎です^^。\n\nゼンはアライグマの男の子で、船に乗って宇宙を旅し、惑星を訪れてテレビ番組やゲームなどの娯楽について学んでいます！やんちゃだけど正直で、誰かが傷つくのを見たくない。\n\n普段は宇宙船「スペース・トラッシュ・バージ」で旅をし、ネオンやサイバーパンクをテーマにした街で過ごすのが好きだ。\n\nあなたが最小限の指示しか求めないので、私はあなたにすべてを委ねます！ゼンで何をするか楽しみだ！^^\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-4qmzGJm168TgW7zbmezHKV1X1nWCqL3?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/79", "thumbnail_src": "https://si.imgix.net/8acd3ee0/uploads/origins/a3f599aa-79c0-4b58-90d2-144ca6fc12d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff921052f9674d278761b57cb79621f", "thumbnail_srcset": "https://si.imgix.net/8acd3ee0/uploads/origins/a3f599aa-79c0-4b58-90d2-144ca6fc12d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff921052f9674d278761b57cb79621f, https://si.imgix.net/8acd3ee0/uploads/origins/a3f599aa-79c0-4b58-90d2-144ca6fc12d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=595830542bd0dc99c4acecdd1a290e76 2x, https://si.imgix.net/8acd3ee0/uploads/origins/a3f599aa-79c0-4b58-90d2-144ca6fc12d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebe11116bfd345c6656e9c72395cc0dd 3x", "genre": "art", "nsfw": true, "body": "はじめまして、こんにちは\n\nうちの子タイクのイラストをお願いしたいです。\n\n白いTシャツを着て、競泳用のブリーフを履いてシャワーを浴びているところを描いていただけないでしょうか。シャワーはプールの近くの外のシャワーです。\n\n彼のスイムブリーフ姿の写真：https://f2.toyhou.se/file/f2-toyhou-se/images/92076533_Vt5laKARWs0mpCS.png\n彼の写真：https://f2.toyhou.se/file/f2-toyhou-se/images/61206358_iVaa5lHJVeioRzT.jpg\n\n写真にエロ要素を入れるのは自由。\n\n\n\nリクエストにお答えいただきありがとうございました。\n\nhttps://toyhou.se/6700524.tich-showers/gallery", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/78", "thumbnail_src": "https://si.imgix.net/faba433c/uploads/origins/e382eb5d-991b-4328-8b07-7425363dc634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8b02992341ff532af618b0979c9a483", "thumbnail_srcset": "https://si.imgix.net/faba433c/uploads/origins/e382eb5d-991b-4328-8b07-7425363dc634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8b02992341ff532af618b0979c9a483, https://si.imgix.net/faba433c/uploads/origins/e382eb5d-991b-4328-8b07-7425363dc634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba453c0b4e4f1d6f50b244563b4ecff3 2x, https://si.imgix.net/faba433c/uploads/origins/e382eb5d-991b-4328-8b07-7425363dc634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8a2cc73ccfba0fcb600b4571e643d63 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、ゲーム「黒の軌跡II」のクアルテとイクスの絵を描いていただけませんか？  \n\n参考文献\nhttps://drive.google.com/drive/folders/1MHy3ukyGGvklncoScfPMe-cLI97JwS_j?usp=sharing\n\n二人ともティーンエイジャーの男の子。  イクスはやんちゃで、クアトレはいい子。  クアトレを捕まえたイクスがクアトレを犯すところを見てみたい。  イクスは勝利の笑みを浮かべ、クアトレはペニスを硬くして喘ぐだろう。   二人がオーガズムに達した後、イクスがクアトレを淫乱少年と呼ぶシーンがあれば最高です。\nできればクアトレに黒いシャツを着せてください。  イクスは服を着ていても裸でも構いません。\n\n私のリクエストを考慮してくれてありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/77", "thumbnail_src": "https://si.imgix.net/8eabdd3d/uploads/origins/268fc53f-58f4-4c77-87f9-ada4f9fcd189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea2ee9f5e6d17869fcfa06fc655a46ec", "thumbnail_srcset": "https://si.imgix.net/8eabdd3d/uploads/origins/268fc53f-58f4-4c77-87f9-ada4f9fcd189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea2ee9f5e6d17869fcfa06fc655a46ec, https://si.imgix.net/8eabdd3d/uploads/origins/268fc53f-58f4-4c77-87f9-ada4f9fcd189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e935afc07889bf4cf4c91ecdcf6ae252 2x, https://si.imgix.net/8eabdd3d/uploads/origins/268fc53f-58f4-4c77-87f9-ada4f9fcd189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61f5093e0d49724aa94351ecb9c476f8 3x", "genre": "art", "nsfw": true, "body": "僕のキャラクター、パーソンの淫らなアートを探しているんだ。\n\nhttps://ibb.co/ftWDxNk", "created_at": "", "completed_at": ""}, {"path": "/@Rio_i23a/works/76", "thumbnai