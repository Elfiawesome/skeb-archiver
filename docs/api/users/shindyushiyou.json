gins/7a95bb42-4e30-4afe-92d4-9860811daa7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd50fa568e7e1197b98c3a19239582ec", "thumbnail_srcset": "https://si.imgix.net/181023e6/uploads/origins/7a95bb42-4e30-4afe-92d4-9860811daa7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd50fa568e7e1197b98c3a19239582ec, https://si.imgix.net/181023e6/uploads/origins/7a95bb42-4e30-4afe-92d4-9860811daa7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9650401e971cda9f2ca59b7b954c47b9 2x, https://si.imgix.net/181023e6/uploads/origins/7a95bb42-4e30-4afe-92d4-9860811daa7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab46def03320c8b5272a66ae26575efa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターkomoのアートワークをお願いします！イマジネーションはお任せします！\n\nhttps://drive.google.com/drive/folders/1QeckIqn7AzNfjviYcjYBiQM17kweoiah?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@shindyushiyou/works/39", "thumbnail_src": "https://si.imgix.net/f624c553/uploads/origins/4bb31324-2dd3-4af9-9917-96dc0cb4205e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10604f635c4b5eae720a10901c0220ab", "thumbnail_srcset": "https://si.imgix.net/f624c553/uploads/origins/4bb31324-2dd3-4af9-9917-96dc0cb4205e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10604f635c4b5eae720a10901c0220ab, https://si.imgix.net/f624c553/uploads/origins/4bb31324-2dd3-4af9-9917-96dc0cb4205e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=568ca741c0c6ec8625ee6c0a7774ee6e 2x, https://si.imgix.net/f624c553/uploads/origins/4bb31324-2dd3-4af9-9917-96dc0cb4205e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e72fb89ad63d446e27576310a1530b8 3x", "genre": "art", "nsfw": false, "body": "蒼色系様\n\n先日はとても素敵な作品をありがとうございました！\n以前の作品とても気に入っており、リスナー様にも大変好評でしたのでぜひまたお願いしたいと思いリクエスト失礼いたします。\n\n資料) https://drive.google.c