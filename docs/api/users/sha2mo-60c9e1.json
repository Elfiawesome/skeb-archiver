59363-c972-4015-b569-e88bfbf33b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8c88aaacd8755be8d36549995038136", "thumbnail_srcset": "https://si.imgix.net/40ea6e28/uploads/origins/f2f59363-c972-4015-b569-e88bfbf33b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8c88aaacd8755be8d36549995038136, https://si.imgix.net/40ea6e28/uploads/origins/f2f59363-c972-4015-b569-e88bfbf33b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ef6c62ce3ea8ed23a57c1a4f178b463 2x, https://si.imgix.net/40ea6e28/uploads/origins/f2f59363-c972-4015-b569-e88bfbf33b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9fb74a89720b4837fd153084e26bade 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nしゃしゃも先生の描くメイドに惹かれてリクエストしました！\n\n自キャラのイラスト描いていただけないでしょうか？\n\n衣装はメイド服で構図やポーズ、表情などはしゃしゃも先生にお任せし、お好きなように描いていただければと思っています。\nパンのぬいぐるみも一緒でお願いします。\n\n可能でしたら宛名有り無し、ラフなども残ってると嬉しいです！\n\nご検討のほどよろしくお願いします！🙇‍ \n\n☐資料\n\nhttps://twitter.com/pan_0x0/status/1446423137898270724?s=21", "created_at": "", "completed_at": ""}, {"path": "/@sha2mo/works/7", "thumbnail_src": "https://si.imgix.net/5b0b08d5/uploads/origins/ab5b0d23-1d77-4d68-9fa3-daadb03a68e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d92f4f91dda556746b66665255da474", "thumbnail_srcset": "https://si.imgix.net/5b0b08d5/uploads/origins/ab5b0d23-1d77-4d68-9fa3-daadb03a68e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d92f4f91dda556746b66665255da474, https://si.imgix.net/5b0b08d5/uploads/origins/ab5b0d23-1d77-4d68-9fa3-daadb03a68e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39d97b8a8736c77edcaf6cb94887a308 2x, https://si.imgix.net/5b0b08d5/uploads/origins/ab5b0d23-1d77-4d68-9fa3-daadb03a68e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1c21e5afc8c8d666cb45f599449de5e 3x", "genre": "art", "nsfw": false, "body": "こんにち