与えるが、過去の挫折から実は苦々しく悪意に満ちている。彼女は注目を渇望し、衝動的である。\n\n押し引きの関係。林檎はよそよそしく無神経だ、繁玥は独占欲が強く、べったりしている。それでも二人は離れられず、警戒心が解けた瞬間に優しい瞬間を共有する。\n\nご検討いただきありがとうございます!\n\nhttps://sunshainess.notion.site/FANRIN-ISEREMI-2e1739bd3ee3818c9143c9f8e0ca523c", "created_at": "", "completed_at": ""}, {"path": "/@trnoao/works/106", "thumbnail_src": "https://si.imgix.net/97f45045/uploads/origins/4c961a7d-43d6-4cbb-8dfe-d5adb458ed4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3d94de743b8e82d1e4f6fc79786292e", "thumbnail_srcset": "https://si.imgix.net/97f45045/uploads/origins/4c961a7d-43d6-4cbb-8dfe-d5adb458ed4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3d94de743b8e82d1e4f6fc79786292e, https://si.imgix.net/97f45045/uploads/origins/4c961a7d-43d6-4cbb-8dfe-d5adb458ed4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac24cbf9c57dec886bc18970a6165b49 2x, https://si.imgix.net/97f45045/uploads/origins/4c961a7d-43d6-4cbb-8dfe-d5adb458ed4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17caafce58e8706874f593ce5a9308a3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@trnoao/works/105", "thumbnail_src": "https://si.imgix.net/f7da2ff1/uploads/origins/5928181e-734d-408f-b805-bc38b33afb70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3e7df3e7646999e103eff5fe8e40c40", "thumbnail_srcset": "https://si.imgix.net/f7da2ff1/uploads/origins/5928181e-734d-408f-b805-bc