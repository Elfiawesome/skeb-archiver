efb746bc/uploads/origins/b6e72c25-86f0-4b58-acf5-5b420623b3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ecf04571242e8abc232748a6b905f5", "thumbnail_srcset": "https://si.imgix.net/efb746bc/uploads/origins/b6e72c25-86f0-4b58-acf5-5b420623b3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ecf04571242e8abc232748a6b905f5, https://si.imgix.net/efb746bc/uploads/origins/b6e72c25-86f0-4b58-acf5-5b420623b3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91dacf9eebad9143eda1b320656e9a82 2x, https://si.imgix.net/efb746bc/uploads/origins/b6e72c25-86f0-4b58-acf5-5b420623b3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33ebc0f69eb0dcb35fa99600b2cd0ed7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n私のオリキャラ達をデジモン バイタルブレスのようなドット絵を絵描いてお願いします！\n\nキャラ資料⬇️\n成長期、成熟期、完全体、究極体\n\nhttps://drive.google.com/drive/folders/1-18v3ZkZRHq28YeXoXgpjB7nuAXDaRLT", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/25", "thumbnail_src": "https://si.imgix.net/ea409ede/uploads/origins/7b22eca2-aa33-4e53-914d-34af144183ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d07a9820299b0399c6222bba7fb01269", "thumbnail_srcset": "https://si.imgix.net/ea409ede/uploads/origins/7b22eca2-aa33-4e53-914d-34af144183ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d07a9820299b0399c6222bba7fb01269, https://si.imgix.net/ea409ede/uploads/origins/7b22eca2-aa33-4e53-914d-34af144183ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcf120addbd572f01a9b67787fcf0514 2x, https://si.imgix.net/ea409ede/uploads/origins/7b22eca2-aa33-4e53-914d-34af144183ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca76ee989ca57f18c5a19d7a002ed663 3x", "genre": "art", "nsfw": false, "body": "もぺ様、初めまして。いつもXで拝見しております。\n32×32のイラストで以下のポケモン3匹をお願いしたいです。\n構図などはすべてお任せいたします。\n・ゴチミル\n・ハカドッグ\n・ゴルーグ\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/24", "thumbnail_src": "https://si.imgix.net/f4505ea9/uploads/origins/1d850e53-3506-44a7-93af-d8db150676d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a9056561c7e0c5723371f1425cb995", "thumbnail_srcset": "https://si.imgix.net/f4505ea9/uploads/origins/1d850e53-3506-44a7-93af-d8db150676d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a9056561c7e0c5723371f1425cb995, https://si.imgix.net/f4505ea9/uploads/origins/1d850e53-3506-44a7-93af-d8db150676d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8fdc66dcaf06cf3c826651cab1febd3 2x, https://si.imgix.net/f4505ea9/uploads/origins/1d850e53-3506-44a7-93af-d8db150676d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d09e85225158828363ca29a4995e933a 3x", "genre": "art", "nsfw": false, "body": "老師您好、很喜歡您這個作品\nhttps://skeb.jp/@mope_dotpict/works/17\n想委託類似的款式\n\n想用的角色站姿+胸前的右手拿著ギガトンボール\nhttps://i.imgur.com/UqiKWHZ.gif\n\n左下角的角色插入圖想用拉下帽子的姿勢\nhttps://imagizer.imageshack.com/v2/1057x932q90/922/ZM3zzj.png\n\n背景想用夜幕星空\n\n左上角顯示角色名字：アリス\n\n對話框想用（日文）：\n「挑戦者よ、あなたの最大の力を見せてください。」\n\n其他參考資料\nhttps://drive.google.com/drive/folders/1sK1KlpgzVyt_MmPMWRIntCdRkJuD3Y5P?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/23", "thumbnail_src": "https://si.imgix.net/1cdf7fe3/uploads/origins/479e1f78-bbe8-4a14-8038-9abb36feabcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11f2a4f3e6a8dae01207c0587b4b87c5", "thumbnail_srcset": "https://si.imgix.net/1cdf7fe3/uploads/origins/479e1f78-bbe8-4a14-8038-9abb36feabcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11f2a4f3e6a8dae01207c0587b4b87c5, https://si.imgix.net/1cdf7fe3/uploads/origins/479e1f78-bbe8-4a14-8038-9abb36feabcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7009ee29015e2b0e31218288de3eb41 2x, https://si.imgix.net/1cdf7fe3/uploads/origins/479e1f78-bbe8-4a14-8038-9abb36feabcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18a6b036e9f8f292a754f86e204902eb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n2種類の作品をお願いしたいのですが\n\n- 小作品1点 (32x32)\n- 中サイズ1点\n\n中作品は過去に制作した作品に近いものを希望します：\nhttps://skeb.jp/@mope_dotpict/works/17\n私のポケモンOCのレインのために作ってもらいたいです：\nhttps://x.com/everfei/status/1811121740933697632?s=46&t=DXk2AWmVCrYN4xmVSMuFvA\n性格は穏やかでクール。\n\n小さいほうのスプライトも同じOCでお願いしたいです！詳細はできるだけ簡略化してください！ありがとうございます！\n価格も調整お願いします🙏。", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/22", "thumbnail_src": "https://si.imgix.net/f65fe8e1/uploads/origins/c765b710-4caf-4e48-8de8-fc86fa73ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5be1111cad1d40a0efc62e3092df6b1", "thumbnail_srcset": "https://si.imgix.net/f65fe8e1/uploads/origins/c765b710-4caf-4e48-8de8-fc86fa73ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5be1111cad1d40a0efc62e3092df6b1, https://si.imgix.net/f65fe8e1/uploads/origins/c765b710-4caf-4e48-8de8-fc86fa73ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9009c78270bed41b684c61ccfcceb91 2x, https://si.imgix.net/f65fe8e1/uploads/origins/c765b710-4caf-4e48-8de8-fc86fa73ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c9cdac6b2e83e5e7d76de150d6ca656 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、前回のジオン残党軍があまりにも素晴らしすぎたので今回もたまらずご依頼させていただきました。\nおかげさまで写真を撮る以外にもボードゲームの駒などにしたりなど、とても楽しませていただいております。本当にありがとうございます。\n今回のも前回とほぼ同じなので何卒よろしくお願いします。\n(二回連続のご依頼申し訳ございません)\n\nhttps://drive.google.com/file/d/1oXOOGUqvKtFXe45T9qplBNSyjfO-i1nn/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/21", "thumbnail_src": "https://si.imgix.net/2985f9dc/uploads/origins/4e4984fe-9cfb-46ed-bd49-c21620727ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44f915aa08e0ec3e302303d68202fd3a", "thumbnail_srcset": "https://si.imgix.net/2985f9dc/uploads/origins/4e4984fe-9cfb-46ed-bd49-c21620727ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44f915aa08e0ec3e302303d68202fd3a, https://si.imgix.net/2985f9dc/uploads/origins/4e4984fe-9cfb-46ed-bd49-c21620727ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b35ffdebba7a6c63dbb535c31f75a5d 2x, https://si.imgix.net/2985f9dc/uploads/origins/4e4984fe-9cfb-46ed-bd49-c21620727ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce3065236ff634785b24e18c1aef9286 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、前回のジオン残党軍があまりにも素晴らしすぎたので今回もたまらずご依頼させていただきました。\nおかげさまで写真を撮る以外にもボードゲームの駒などにしたりなど、とても楽しませていただいております。本当にありがとうございます。\n今回のも前回とほぼ同じなので何卒よろしくお願いします。\n\nhttps://drive.google.com/file/d/12egrqONA2X7AqWtSGjTBpsxtu1o7-kbn/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/20", "thumbnail_src": "https://si.imgix.net/81060e20/uploads/origins/e6f8d605-8a5e-4766-889d-943d643475e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=598781efe1ef21d4eb63b6eec02a086e", "thumbnail_srcset": "https://si.imgix.net/81060e20/uploads/origins/e6f8d605-8a5e-4766-889d-943d643475e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=598781efe1ef21d4eb63b6eec02a086e, https://si.imgix.net/81060e20/uploads/origins/e6f8d605-8a5e-4766-889d-943d643475e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ebc3fdf4a4b79e7c7d6a30b2fba8d3b 2x, https://si.imgix.net/81060e20/uploads/origins/e6f8d605-8a5e-4766-889d-943d643475e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=029632ef5a8a2928a4459f988c13ac61 3x", "genre": "art", "nsfw": false, "body": "こちら（https://skeb.jp/@mope_dotpict/works/19）のリクエストを送信させていただいた者です。\n先日は素敵なドット絵をありがとうございました。OCと彼女を取り囲む手持ち達がドット絵で見事に表現されていて嬉しかったです。新規でドットを打ってもらった子も新たにリクエスト用にドットを打っていただいた子も可愛く……\n\n今回はOCの擬ポケ化をドット絵にしていただきたくリクエスト送信いたしました。\nもぺ様の創作が好きなので自由に表現いただけると幸いです。\n人物資料及び擬ポケ資料につきましてはURLご参照ください。\n料金不足等ありましたら再送くださいますようお願いします。\n\nhttps://drive.google.com/drive/folders/16hsaVwcw6TNlHCJaeBcbJUCIziqZA-5h", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/19", "thumbnail_src": "https://si.imgix.net/859a5308/uploads/origins/925cb026-9a5e-456f-bf32-d7d0802ccf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df42e618978dfa9e2230d56425a629b", "thumbnail_srcset": "https://si.imgix.net/859a5308/uploads/origins/925cb026-9a5e-456f-bf32-d7d0802ccf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df42e618978dfa9e2230d56425a629b, https://si.imgix.net/859a5308/uploads/origins/925cb026-9a5e-456f-bf32-d7d0802ccf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff7246bcb33c8eb07ad91693adccf838 2x, https://si.imgix.net/859a5308/uploads/origins/925cb026-9a5e-456f-bf32-d7d0802ccf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7553e19523e8748ea32ed473d55dd3a 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nもぺ様のドット絵を拝見して、是非私のOCと手持ち達もお願いできればと思い、リクエスト送信させていただきました。\n\nポケモンはURL内の「手持ち」▶︎「手持ち一覧」よりソウブレイズ、パッチール、ムクホーク、ドドゲザン、イッカネズミ（4匹家族）、グレンアルマをお願いしたいです。\n\n金額などの不足ありましたら再送していただけると助かります。ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15lJxGXDH3CHVyUwmn6I0KIIvL-CvNK4w", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/18", "thumbnail_src": "https://si.imgix.net/2fccef6d/uploads/origins/e0d25880-57f8-460e-9ca8-bc6ca520cb58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=297a7cbe927920153bd4bb6b09adda08", "thumbnail_srcset": "https://si.imgix.net/2fccef6d/uploads/origins/e0d25880-57f8-460e-9ca8-bc6ca520cb58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=297a7cbe927920153bd4bb6b09adda08, https://si.imgix.net/2fccef6d/uploads/origins/e0d25880-57f8-460e-9ca8-bc6ca520cb58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=598ff96e5f4c0de10393e7163ee6846e 2x, https://si.imgix.net/2fccef6d/uploads/origins/e0d25880-57f8-460e-9ca8-bc6ca520cb58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68cd76b76f34ae5331ff515abdadce3c 3x", "genre": "art", "nsfw": false, "body": "初めてまして、素晴らしいドット絵に感銘を受けましてご依頼を送らせていただきました。\n私は趣味でいろんなイラストをアクリルスタンド化(個人で写真を取ったりして楽しむ程度)させておりまして、この度はにわ様に\n『SDガンダム ジェネレーション』\nという作品内のSDデザインで他作の機体をデザインしてほしいのです。\nもちろんアクリルスタンド化するにあたって透過ですので、背景は結構です。\n中には少し複雑な機体もありますが、ある程度ゲーム内風に沿って簡略化してもらって問題ありません。\n何卒よろしくお願いします\n(資料ではいろいろ載ってますが、UCのみでお願いします)\n\nhttps://drive.google.com/file/d/1J2vR4aEvYg1w6Sgf3wpaXSPdreLU_lGA/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/17", "thumbnail_src": "https://si.imgix.net/fb123370/uploads/origins/8b7a4197-8eb0-40f2-90a6-5789e20434bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e5d19108a2bd3e5040c33098d7355d", "thumbnail_srcset": "https://si.imgix.net/fb123370/uploads/origins/8b7a4197-8eb0-40f2-90a6-5789e20434bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e5d19108a2bd3e5040c33098d7355d, https://si.imgix.net/fb123370/uploads/origins/8b7a4197-8eb0-40f2-90a6-5789e20434bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aeb17acfe60ae13a85a21c8b4bd8834a 2x, https://si.imgix.net/fb123370/uploads/origins/8b7a4197-8eb0-40f2-90a6-5789e20434bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ae328eef81ed322d45efb8c2d04982d 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n素敵なドット絵を拝見し、いつかご依頼をとフォローさせていただいておりました。\n\n依頼内容ですが、VTuberの いぬいぬい さんをお願いいたします。\nポケモンコンテンツ、特にポケモンカードゲームを中心に活動されている方です。\nそこで、カードを構えてポーズをとっている いぬいぬい のドット絵をお願いしたいのです。\nカッコいいポーズを想定していますが、かわいいポーズでも問題ありません。\n\n設定画やガイドラインはこちらをご覧いただければと思います。\nhttps://profcard.info/u/JNF5q1uMKQhkr7FBSMcgmjmTlJo1\nキービジュアルでもカードを持っていますが、デザインは同じでなくとも大丈夫です。\n\n活動内容の参考に、資料URLへピクシブ百科事典のURLを記載させていただきました。\n作成頂いた作品は、彼女の配信やSNSでの投稿に使用させて頂ければと思います。\n\n以上、よろしくお願いいたします。\n\nhttps://dic.pixiv.net/a/%E3%81%84%E3%81%AC%E3%81%84%E3%81%AC%E3%81%84", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/16", "thumbnail_src": "https://si.imgix.net/654bc60f/uploads/origins/458a8c16-0f31-4455-93f2-98d9967824c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bee2a23c6bb6b7aa697b98d02478fcb3", "thumbnail_srcset": "https://si.imgix.net/654bc60f/uploads/origins/458a8c16-0f31-4455-93f2-98d9967824c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bee2a23c6bb6b7aa697b98d02478fcb3, https://si.imgix.net/654bc60f/uploads/origins/458a8c16-0f31-4455-93f2-98d9967824c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df202a12c2b8480f8086c284c9fda827 2x, https://si.imgix.net/654bc60f/uploads/origins/458a8c16-0f31-4455-93f2-98d9967824c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af151743d60f21ddec099d5b65ae075e 3x", "genre": "art", "nsfw": false, "body": "初めまして玻璃舞人(はりまと)a.k.a.PANDORAMYLON(パンドラミロン)と申します。\nうちの子とポケモン達のポケモン風のドット絵をお願いします。\nポケモンはヤミラミ・ナックラー・ユキメノコ・ネイティオ・キルリア・ブラッキーの６匹\n\nうちの子はヤミラミの帽子が特徴です。\n\nうちの子資料URL\nhttps://twitter.com/matohari8901/status/1579725198672420865?s=46&t=Ckb-4Kuhl4nCqyN587HvjA\n\nご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/15", "thumbnail_src": "https://si.imgix.net/54121a08/uploads/origins/076c4cd8-312a-470a-86a5-fffeeb32693e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3adb54955a1d5a1815aea32418170ca3", "thumbnail_srcset": "https://si.imgix.net/54121a08/uploads/origins/076c4cd8-312a-470a-86a5-fffeeb32693e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3adb54955a1d5a1815aea32418170ca3, https://si.imgix.net/54121a08/uploads/origins/076c4cd8-312a-470a-86a5-fffeeb32693e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9075febdcba3d8ddfe0a17a6dd40c2e 2x, https://si.imgix.net/54121a08/uploads/origins/076c4cd8-312a-470a-86a5-fffeeb32693e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=240d5188d5c5162f2ffd536b5e064774 3x", "genre": "art", "nsfw": false, "body": "下記資料のキャラクターの全身ドットイラストを、48サイズいっぱいに作成お願いしたいです。SNSのアイコン用に使用希望です。  左向きで、構図などはお任せ致します。 背景は白一色で構いません。  どうぞご検討頂けますと幸いです。\n\nhttps://yuno-anime.com/character/shimazumio/", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/14", "thumbnail_src": "https://si.imgix.net/c37a7069/uploads/origins/5a473c0c-21f2-4b40-85fc-89dd84a0f7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be305aa6d99561062cd419ecbc43ee11", "thumbnail_srcset": "https://si.imgix.net/c37a7069/uploads/origins/5a473c0c-21f2-4b40-85fc-89dd84a0f7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be305aa6d99561062cd419ecbc43ee11, https://si.imgix.net/c37a7069/uploads/origins/5a473c0c-21f2-4b40-85fc-89dd84a0f7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=843a4c296ccc235bce816a08b0412ce1 2x, https://si.imgix.net/c37a7069/uploads/origins/5a473c0c-21f2-4b40-85fc-89dd84a0f7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38f201ea25700c50e20e2df3cf04fa76 3x", "genre": "art", "nsfw": false, "body": "もぺ様、初めまして。\n\n私がオンラインゲームで使用しているキャラクターをトレーナー風にアレンジしたドット絵と、そのキャラクターの色合いに合わせた色違いのワンパチの32×32のドット絵をリクエストさせて頂けないでしょうか？\nSNSのヘッダー用に1人と1匹を並べた構図で3:1のアスペクト比のサイズ画像も用意して頂けると嬉しいです。\n\nご一考の程よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/gbp3kqzz9lhw9si878toh/2024-01-25-17-27-22.mov?rlkey=6xfsk8j9k82lbuw780sdhwxpz&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/13", "thumbnail_src": "https://si.imgix.net/498c9c93/uploads/origins/ec3c0108-3117-43e1-beaf-87a4e0e455f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c3c453790c36de53523b820b43f59d", "thumbnail_srcset": "https://si.imgix.net/498c9c93/uploads/origins/ec3c0108-3117-43e1-beaf-87a4e0e455f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c3c453790c36de53523b820b43f59d, https://si.imgix.net/498c9c93/uploads/origins/ec3c0108-3117-43e1-beaf-87a4e0e455f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=539c798ea7937b51b06b1ee873eea641 2x, https://si.imgix.net/498c9c93/uploads/origins/ec3c0108-3117-43e1-beaf-87a4e0e455f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b085322211097eb586447a1fbfb2e29 3x", "genre": "art", "nsfw": false, "body": "ビクトリーベル（ウツボット）の32x32サイズのピクセルアートをお願いできますか？ヴィクトリーベルのリーフグリーンとハートゴールドのピクセルアートがとても好きです。この2つのピクセルアートを参考にして、32x32サイズのアートを作っていただけませんか？ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/12", "thumbnail_src": "https://si.imgix.net/74fc8bd2/uploads/origins/015ab43d-f4b2-4d4b-b772-4e099117d98d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e480c2d07fc1fe0184a9f1441100b5f", "thumbnail_srcset": "https://si.imgix.net/74fc8bd2/uploads/origins/015ab43d-f4b2-4d4b-b772-4e099117d98d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e480c2d07fc1fe0184a9f1441100b5f, https://si.imgix.net/74fc8bd2/uploads/origins/015ab43d-f4b2-4d4b-b772-4e099117d98d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c90a7b8aa27e6c7933830b893dd66ba 2x, https://si.imgix.net/74fc8bd2/uploads/origins/015ab43d-f4b2-4d4b-b772-4e099117d98d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0c1195614be1a460a6bf3ba64e90ef3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/11", "thumbnail_src": "https://si.imgix.net/7de4a85a/uploads/origins/a0bb3b84-2d78-4717-bade-2bd9b0b9987a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6355224398493b9bbaa5cbc8d8ee667", "thumbnail_srcset": "https://si.imgix.net/7de4a85a/uploads/origins/a0bb3b84-2d78-4717-bade-2bd9b0b9987a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6355224398493b9bbaa5cbc8d8ee667, https://si.imgix.net/7de4a85a/uploads/origins/a0bb3b84-2d78-4717-bade-2bd9b0b9987a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c91ed86d6fb36168fab2da150dcc085 2x, https://si.imgix.net/7de4a85a/uploads/origins/a0bb3b84-2d78-4717-bade-2bd9b0b9987a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98a68d00264d9cb4b0e6759362c0be89 3x", "genre": "art", "nsfw": false, "body": "はじめまして！VTuberとして活動している惑星ちると申します。\nドット絵のクリエイターさんを探していてとても素敵なイラストを拝見し、リクエストおくらせていただきました。\n32*32のポケモンイラストがすごくかわいくて、その雰囲気で私のちいさい似顔絵（全身）をおねがいできないでしょうか。\n\n資料URLを添付いたしました。\n衣装はかきやすい方で構いません。また改変や省略も大丈夫です。\n\nもともとの色に忠実でなくていいので、\n主線が黒以外＋色数すくなめ＋影色がビビッドな、もぺ様の色選びをしていただけるととってもうれしいです！\n\n個人的に鑑賞するほか、SNSやYouTubeにて掲載させていただく場合がございます。\nその際は出来る限り、お名前とXのアカウントをクレジットさせていただきます。\nそのような使用が不適切な場合は、お手数ですがリクエスト拒否してください。\n\nご検討よろしくおねがいいたします！\n\nhttps://x.com/madoboshi/status/1613192583320338436?s=20", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/10", "thumbnail_src": "https://si.imgix.net/23492c1a/uploads/origins/db2c4571-fd89-4671-9951-62d2303de58c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7673e3353a9a7177df33d290a20402e9", "thumbnail_srcset": "https://si.imgix.net/23492c1a/uploads/origins/db2c4571-fd89-4671-9951-62d2303de58c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7673e3353a9a7177df33d290a20402e9, https://si.imgix.net/23492c1a/uploads/origins/db2c4571-fd89-4671-9951-62d2303de58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=870af4c389641d11bf4dd0bbcf5a0708 2x, https://si.imgix.net/23492c1a/uploads/origins/db2c4571-fd89-4671-9951-62d2303de58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e07ab66a1186523c6ce1b775828e707 3x", "genre": "art", "nsfw": false, "body": "はじめまして。クオリティはさながら初代のドット絵のようなみっちり感と再現度がすごく気に入りました！！！\n\n今回リクエストしたいドット絵は　１、トレーナー風ドット絵と、２、３２×３２サイズのポケモンです。\n\nミニスカートやモブトレーナーの立ち絵っぽいイメージです。（サンプルに載っているナンジャモちゃんのドット絵のような感じ）\n\nポケモンは　トゲキッスとアローラライチュウです。アローラライチュウは既存のイラストにはないような例えば手にパンケーキをもったポーズ等違う構図だと嬉しいです。\n\nskebを利用するのが初めてなので至らない点等あるかもしれませんがどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mope_dotpict/works/9", "thumbnail_src": "https://si.imgix.net/d24f438f/uploads/origins/9752c3c1-c828-4bca-bd03-10589d90451f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=673c32f0efaed2e71b25e9040875a237", "thumbnail_srcset": "https://si.imgix.net/d24f438f/uploads/origins/9752c3c1-c828-4bca-bd03-10589d90451f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=673c32f0efaed2e71b25e9040875a237, https://si.imgix.net/d24f438f/uploads/origins/9752c3c1-c828-4bca-bd03-10589d90451f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20f3ec43b9d1fcfd221ff1eb24b695ca 2x, https://si.imgix.net/d24f438f/uploads/origins/9752c3c1-c828-4bca-bd03-10589d90451f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9da0936cd46f4b940e63c4d18fd786d8 3x", "genre": "art", "nsfw": false, "body": "Hello! Your pixel work is very beautiful and interesting! \nI would to commission you! \nI would like 2 Medium Size (64x64 80x80), there are 2 characters.\n\nRareel: https://www.dropbox.com/scl/fo/bxs5u3lks9wyj0rec5tcx/h?rlkey=l0qv82nj