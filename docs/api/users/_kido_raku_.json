it=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ba015eabb36eda830ddc8b1bb2ea58c, https://si.imgix.net/af0b3aad/uploads/origins/9b9eb170-f6e1-42bb-80c6-fee80329aac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c4238b96c9e4844eb0d24ffe6e89c62 2x, https://si.imgix.net/af0b3aad/uploads/origins/9b9eb170-f6e1-42bb-80c6-fee80329aac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=187fad10e708579b965f953e959f94b6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_kido_raku_/works/7", "thumbnail_src": "https://si.imgix.net/5a0710d0/uploads/origins/ee75851d-5ed5-40d0-9d39-c3445b87c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de72c7c476c6deab12cde3ad1d61b7e9", "thumbnail_srcset": "https://si.imgix.net/5a0710d0/uploads/origins/ee75851d-5ed5-40d0-9d39-c3445b87c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de72c7c476c6deab12cde3ad1d61b7e9, https://si.imgix.net/5a0710d0/uploads/origins/ee75851d-5ed5-40d0-9d39-c3445b87c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef37e6f83db1d423928755366fbf518d 2x, https://si.imgix.net/5a0710d0/uploads/origins/ee75851d-5ed5-40d0-9d39-c3445b87c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c0e4ffc7faa6a6e55b04716a1c88711 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_kido_raku_/works/6", "thumbnail_src": "https://si.imgix.net/cba6bdd9/uploads/origins/8c1612d0-7a5b-4246-aa96-b4a6cf7675df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ae9fc57da6c59f286529e9ad3ef22fd", "thumbnail_srcset": "https://si.imgix.net/cba6bdd9/uploads/origins/8c1612d0-7a5b-4246-aa96-b4a6cf7675df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ae9fc57da6c59f286529e9ad3ef22fd, https://si.imgix.net/cba6bdd9/uploads/origins/8c1612d0-7a5b-4246-aa96-b4a6cf7675df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=034596284c4bfff9b4f672ce4b922304 2x, https://si.imgix.net/cba6bdd9/uploads/origins/8c1612d0-7a5b-4246-aa96-b4a6cf7675df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0bc44850529cb57addac56a0ea38908 3x", "genre": "art", "nsfw": false, "body": "柑橘野郎さんこんにちは！\n前回は素敵なイラストをありがとうございました！\n今回も自宅キャラクター単体のイラストをお願いいたします。\n前回お願いさせていただいたキャラクターや祝福の塔3参加キャラクターの関係者で、桐箱、蝶の標本、カイコガ、医薬品などがモチーフです。\n\n柑橘野郎さんの描かれるプリーツスカートが本当に好きなため(かなのさんのCSが特に好きです！)、プリーツスカートを描写していただければと考えています。\n\n構図等を考えるのが苦手なのでお任せさせていただければと考えておりますが、指定が必要であれば蝶の標本風といったテイストでお願いできればと思います。\nもちろん柑橘さんが考えてくださったその他の構図でもとても嬉しいです！\n\n資料が少なく恐縮ですが、よろしくお願いいたします🙇‍♂️✨\n\nhttps://www.dropbox.com/scl/fo/02r03qckdnokuvhps49wo/ABjDa0083uFsjSrm0eshTVc?rlkey=j41novv3q0m1699iav2ulb4kv&st=qti1nbuz&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@_kido_raku_/works/5", "thumbnail_src": "https://si.imgix.net/8fb75a49/uploads/origins/5527a660-9dac-45f9-bf1e-c5aa6ddb60c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7d00ad1a483f65a366cd83e9c13e17c", "thumbnail_srcset": "https://si.imgix.net/8fb75a49/uploads/origins/5527a660-9dac-45f9-bf1e-c5aa6ddb60c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7d00ad1a483f65a366cd83e9c13e17c, https://si.imgix.net/8fb75a49/uploads/origins/5527a660-9dac-45f9-bf1e-c5aa6ddb60c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=714d81db39275dea6453d27ea1dd19ff 2x, https://si.imgix.net/8fb75a49/uploads/origins/5527a660-9dac-45f9-bf1e-c5aa6ddb60c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96bfbf6c237f58345d8092a1760263d8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、スケブ依頼をさせていただきます。よろしくお願いいたします。\n\n【依頼】\nリアルタイム企画『ユエヒト』の参加キャラクター「ラグナ」のイラストをお願いいたします。\n\n【設定】\nよくあるファンタジー世界の魔王です。\n普段は全ての魔物たちを統治していますが、優れた文明を持ちながら争いをやめない人間たちに憂いを抱き、「私が治める方が平和で効率的」という善意から人間の征服を企みました。\n一方、魔物同士の争いで両親や故郷を失った過去から、「“王”として全ての民を幸福にする」ことにのみ自分の存在意義を見出だしていたため、王の使命という名の呪縛にとらわれ、“ヒト”らしい心を失いつつありました。\nしかし、企画本編での経験や交流を経て、人間の持つ強さに気付き、自身から失われつつあった深い愛情を自覚しました。\n本編後は人間の征服を取りやめて和解の道を模索するようになり、数か国と国交を開きました。また、“ヒト”らしい心を取り戻したことで、自身が最もそばに仕えさせていた侍女への愛も自覚したため、彼女と正面から向き合って互いに本音を打ち明け、最終的に妻として迎えました。\n\n【お願い】\n服装については資料２～３枚目の「普段の服」でお願いします。\n玉座に座った正面の構図で、背景やフレームにラグナが使う魔法の属性である「炎」と「植物(主なモチーフはヤドリギとトネリコです)」の要素が含まれていると嬉しいです。\nその他、玉座のデザインなどはお任せします。\n\n長文で失礼いたしましたが、よろしくお願いいたします！\n\nアスより\n\nhttps://drive.google.com/drive/folders/1N1Y2-Kcw7UfCECYPjaHQI6f3NxJc2Jzv", "created_at": "", "completed_at": ""}, {"path": "/@_kido_raku_/works/4", "thumbnail_src": "https://si.imgix.net/b109999f/uploads/origins/68f90487-67a6-4f59-89f2-fe31fc907a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09be9524da5623e9c66aa1922efbbe0", "thumbnail_srcset": "https://si.imgix.net/b109999f/uploads/origins/68f90487-67a6-4f59-89f2-fe31fc907a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09be9524da5623e9c66aa1922efbbe0, https://si.imgix.net/b109999f/uploads/origins/68f90487-67a6-4f59-89f2-fe31fc907a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65ab6ebc405ab88d85fc3a925f561408 2x, https://si.imgix.net/b109999f/uploads/origins/68f90487-67a6-4f59-89f2-fe31fc907a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e55768ca2b780db31aa0a0199f87dfaf 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつも素晴らしい企画運営をありがとうございます！\n今回、初めて柑橘野郎さん宛のリクエストの門を叩かせていただきます！\n\n親から愛されない一人の女の子の別人格として生きてきた『靴屋さん』で、祝福の塔無印に参加しておりました。\n巡礼の旅で、にじいろさん宅の田後学美さんと『よだかの星』の話をして、星になれずとも、綺麗だと思う何かに生まれ変わろう！と誓い合います。\n愚者の祝福を受け取って、基本人格が最初から親に愛されている世界線に変わったことで、別人格は生まれる必要がなくなり、靴屋さんは消えてしまいました。\n\n全ての人を等しく愛せるが、誰のものにもなってくれない人として生まれ変わった田後さんは、存在しない靴屋さんを思い出すこともありません。\n存在しない感情で、靴屋さんは田後さんを愛しています。\n\nその後、ファビュラスなお茶会で靴屋さんと田後さんは再会しますが、もう巡礼者の時の田後さんではない彼は、靴屋さんを思い出しません。\n靴屋さんは、自分も生まれ変わるべき時だと感じて、田後さんにお願いして、存在のない自分に名前を付けてもらうことにしました。\n田後さんから貰った名前は『朝緋』\nその情熱を僕は愛そう、と田後さんは最後に靴屋さんを朝緋と呼び続けてくれました。\n\n\nこれが、靴屋さんと田後さんの関係の物語です。\n柑橘野郎さんの絵柄でぜひ、靴屋さんと田後学美さんを見たくて……！\n構図は、隣り合わせで対になるように地面に眠る二人に『これがよだかの最後でした。』というモノローグがつく絵でお願いしたいです。\n\nhttps://drive.google.com/drive/folders/1--uxDMwa909sKIZaQdn3y0YVrfDT4R_G", "created_at": "", "completed_at": ""}, {"path": "/@_kido_raku_/works/3", "thumbnail_src": "https://si.imgix.net/59782247/uploads/origins/4200e775-bf8b-466e-b5b6-b5d5d092b9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f14034abbc15cc5c9cdd9bea79d4fbc", "thumbnail_srcset": "https://si.imgix.net/59782247/uploads/origins/4200e775-bf8b-466e-b5b6-b5d5d092b9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f14034abbc15cc5c9cdd9bea79d4fbc, https://si.imgix.net/59782247/uploads/origins/4200e775-bf8b-466e-b5b6-b5d5d092b9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f82fd88e3bde4d293c152c78b16d2bc 2x, https://si.imgix.net/59782247/uploads/origins/4200e775-bf8b-466e-b5b6-b5d5d092b9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bfa24401245d9c98ed8e632b6dcb0c2 3x", "genre": "art", "nsfw": false, "body": "描いて欲しいキャラクター:資料にある二人\n稲坂大地(黒い方)　44歳　187cm\n雪本大我(黒くない方)　25歳　170cm\n\n雰囲気:ホビーアニメに登場する、ちょっとウザめのラブラブバカップルの敵役\n\n構図:二人の距離が近く、背景が爆発していると嬉しいです。\n\n備考:リバのカップルです。\n\n上記の通りにリクエストさせていただきたいで