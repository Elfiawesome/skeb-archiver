eted_at": ""}, {"path": "/@goatmacar00n/works/1", "thumbnail_src": "https://si.imgix.net/bcb1de61/uploads/origins/3beb3160-733b-4044-984d-3542c5bb795b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba947f109a94627a3d1269f879cb571", "thumbnail_srcset": "https://si.imgix.net/bcb1de61/uploads/origins/3beb3160-733b-4044-984d-3542c5bb795b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba947f109a94627a3d1269f879cb571, https://si.imgix.net/bcb1de61/uploads/origins/3beb3160-733b-4044-984d-3542c5bb795b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bd58edd22bed22f2d122a6521930d15 2x, https://si.imgix.net/bcb1de61/uploads/origins/3beb3160-733b-4044-984d-3542c5bb795b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3998ebfdc33b5c4b4569c87fabc28562 3x", "genre": "art", "nsfw": true, "body": "みすきーの投稿を拝見し、今のうちだ！と思いリクエストさせていただきました!\n先生が描くふわふわロリが見たいです……！\nスカートをたくし上げパンツを見せつけ、にやにや顔で誘惑しているところをお願いします！\n細かいデザインはおまかせとさせてください！ざっくりとしたリクエストとなり申し訳ございません、どうかよろしくお願いします……！", "created_at": "", "completed_at": ""}]}