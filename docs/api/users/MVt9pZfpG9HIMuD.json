6e-9cd1-90a020d68afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e6db74ed1f4108ce9d231d37c0278b8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MVt9pZfpG9HIMuD/works/6", "thumbnail_src": "https://si.imgix.net/df79bf42/uploads/origins/e723dbbe-2f5a-4515-8816-bae09e85672c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99e9fe21043897c4b1dcc74658f94ee", "thumbnail_srcset": "https://si.imgix.net/df79bf42/uploads/origins/e723dbbe-2f5a-4515-8816-bae09e85672c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99e9fe21043897c4b1dcc74658f94ee, https://si.imgix.net/df79bf42/uploads/origins/e723dbbe-2f5a-4515-8816-bae09e85672c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f58be2fe8682b34fdb8684bdaf91302f 2x, https://si.imgix.net/df79bf42/uploads/origins/e723dbbe-2f5a-4515-8816-bae09e85672c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fb2939806568778dc5e497f0684f89f 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、げろさん。先日のリクエストで赤西瑛梨華ちゃんと片桐早苗さんを描いていただいてありがとうございました。またリクエストを申し込もうと聞いて嬉しいですね。今回のリクエストもよろしくお願いします。\n\n今回のリクエストはデレステキャラクターじゃなくてアズールレーンキャラクターですが長良ちゃんという優しい幼馴染系KAN-SENです。\n\nその長良ちゃんに神戸屋の制服をコスプレしてみたという内容でリクエストをいただいてもよろしいでしょうか？\n\n右手にパントングを持って、左手にパンを入れることができる木製トレーを持っています。\n全身で描いていただいて、キャラクターの周りにいろんなパン(クロワッサンやショットケーキなど)を描いてください。その他に残りはお任せします。\n\nご検討をお願い申し上げます！\n\nhttps://drive.google.com/drive/folders/1EIF_l_ufLGEeJCMLJkf_6mDINAYXUx4G", "created_at": "", "completed_at": ""}, {"path": "/@MVt9pZfpG9HIMuD/works/5", "thumbnail_src": "https://si.imgix.net/2c3c0975/uploads/origins/d3b3facd-d8bd-45ab-8870-46bd4dfe7a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d6cfe2b4b6499bb36e9f182ae5d503", "thumbnail_srcset": "https://si.imgix.net/2c3c0975/uploads/origins/d3b3facd-d8bd-45ab-8870-46bd4dfe7a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d6cfe2b4b6499bb36e9f182ae5d503, https://si.imgix.net/2c3c0975/uploads/origins/d3b3facd-d8bd-45ab-8870-46bd4dfe7a63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72441be69f6d8635506d3467bc38fd52 2x, https://si.imgix.net/2c3c0975/uploads/origins/d3b3facd-d8bd-45ab-8870-46bd4dfe7a63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a9ce0f027bd1578e16d880b627cdc65 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n\n普段からげろさんの描かれる柔らかそうで可愛いイラストが大好きで\n今回是非リクエストさせていただきたいと思いました。\n\nミリシタの桜守歌織さんの水着イラストをお願いしたいです。\n\n私服の下にそのまま水着を着て来たという設定で、\n水着の上に私服のブラウスだけをボタンを掛けずに羽織り、\n多少恥ずかしがる顔で水着を見せてくる歌織さんをお願いします。\n\nビキニのデザインはスタマスの「ホシゾラミズギ」を黒くしたような感じの黒いフリルビキニでお願いします。\n\nいわゆる乳カーテン感を出していただけると大変嬉しいです。\n\nご検討の方よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@MVt9pZfpG9HIMuD/works/4", "thumbnail_src": "https://si.imgix.net/877bcd3d/uploads/origins/805631a6-a632-4484-9444-83ce1b2647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73081a6f69633010fc9ee949773817ec", "thumbnail_srcset": "https://si.imgix.net/877bcd3d/uploads/origins/805631a6-a632-4484-9444-83ce1b2647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73081a6f69633010fc9ee949773817ec, https://si.imgix.net/877bcd3d/uploads/origins/805631a6-a632-4484-9444-83ce1b2647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35b0da56c2e81e86e8b962b266f5b6c6 2x, https://si.imgix.net/877bcd3d/uploads/origins/805631a6-a632-4484-9444-83ce1b2647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f150b36464549e96263b2987c7f6a4d 3x", "genre": "art", "nsfw": false, "body": "十時愛梨と及川雫が少し胸のサイズがきつめのビキニとニーソを着て少し挑発的な笑顔をしているイラストを描いてもらえないでしょうか。（目は閉じずに開いている状態で）\n胸の谷間とくびれたウエストとふとももが見えるように、空いたスペースに正面ローアングルからの絶景を書いてもらえるとありがたいです\nまた、胸は大きめに書いてください", "created_at": "", "completed_at": ""}, {"path": "/@MVt9pZfpG9HIMuD/works/3", "thumbnail_src": "https://si.imgix.net/99f6517c/uploads/origins/4fa1eb9f-1b17-4ab0-8140-8da39d380b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=634e4e7c9e3413f41bf9a146923b6cdb", "thumbnail_srcset": "https://si.imgix.net/99f6517c/uploads/origins/4fa1eb9f-1b17-4ab0-8140-8da39d380b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=634e4e7c9e3413f41bf9a146923b6cdb, https://si.imgix.net/99f6517c/uploads/origins/4fa1eb9f-1b17-4ab0-8140-8da39d380b52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb0c04d446b65be878a7166e0cade0ec 2x, https://si.imgix.net/99f6517c/uploads/origins/4fa1eb9f-1b17-4ab0-8140-8da39d380b52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30bf46446c94c1a14f2ae2b9918116f7 3x", "genre": "art", "nsfw": false, "body": "初めまして、Dr.げろさん。いつもげろさんが描いた絵をご拝見させていただいています。\n\nご依頼したいんですが、赤西瑛梨華ちゃんと片桐早苗さんを描いていただきませんか？\n瑛梨華ちゃんの新SSR衣装が今日登場しました。いつもバッキュンしてる瑛梨華ちゃんがなんと西部劇に出演するなんてびっくりしました。なので西部劇のガンマンの瑛梨華ちゃんが早苗さんと一緒に並んでいればどんなイメージになろうかな？と思ってこのリクエストを依頼した理由です。\n\n詳しい内容を説明していると、\n\n1. 赤西瑛梨華は 必中☆GET YOU♪\n2. 片桐早苗は セクシーBANG☆BANG\n3. ポーズは片桐早苗のソロ曲 Can’t Stop！！の最後に登場するタイホしちゃうぞ！のポーズを二人全員がします。タイホしちゃうぞ！の あれというファイルをご参考に。\n4.  構図は正面から瑛梨華ちゃんは左側に、早苗さんは右側に並んで立っている状態で正面のカメラを狙っている。\n5. 背景はお任せします。\n6. よろしければ全身で描いていただけませんか？\n\n以上です。ご検討をお願いします。改めてよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1rwjB1Wh8YQO4eSWIutSuC6k0ZYtucep_?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@MVt9pZfpG9HIMuD/works/2", "thumbnail_src": "https://si.imgix.net/f720f891/uploads/origins/db977244-0f52-47d1-b482-2bfc3634d550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7222b0a4e6d10d32b17f440ab4b49472", "thumbnail_srcset": "https://si.imgix.net/f720f891/uploads/origins/db977244-0f52-47d1-b482-2bfc3634d550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7222b0a4e6d10d32b17f4