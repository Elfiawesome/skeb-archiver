7567-4b01-b726-546bd26209b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd1ac4d83a096e63b9ee03f32d09ff4", "thumbnail_srcset": "https://si.imgix.net/503359ed/uploads/origins/bbd56c99-7567-4b01-b726-546bd26209b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd1ac4d83a096e63b9ee03f32d09ff4, https://si.imgix.net/503359ed/uploads/origins/bbd56c99-7567-4b01-b726-546bd26209b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e11139af2f216ecadec3655133b5f140 2x, https://si.imgix.net/503359ed/uploads/origins/bbd56c99-7567-4b01-b726-546bd26209b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3d062772323c4190bebce3427afb6c8 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\nターンXが花（好きな花）を持っていて、その花の上に妖精サイズのターンAが座っている絵をお願いします。\nターンAには蝶の羽も描いてほしいです。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/11", "thumbnail_src": "https://si.imgix.net/5e09c35f/uploads/origins/21eba422-45d3-4b30-bce3-5b8727b64cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fac3c396e64c5a258b9e390d1aa9fb", "thumbnail_srcset": "https://si.imgix.net/5e09c35f/uploads/origins/21eba422-45d3-4b30-bce3-5b8727b64cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fac3c396e64c5a258b9e390d1aa9fb, https://si.imgix.net/5e09c35f/uploads/origins/21eba422-45d3-4b30-bce3-5b8727b64cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05a4d78ef2aee1e3f3179cdda89f625d 2x, https://si.imgix.net/5e09c35f/uploads/origins/21eba422-45d3-4b30-bce3-5b8727b64cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94919d407ae34c662e34c1d248ae4c7f 3x", "genre": "art", "nsfw": false, "body": "今年も熊本美和さん用の赤いフラスタのパネルA3をお願い致します。\nまた、メッセージカード用サイズも同じA3とデザイン一緒ので良いのでお願いします。なお、今年の生誕ステージは5月10日です。", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/10", "thumbnail_src": "https://si.imgix.net/0c42005e/uploads/origins/49bd390e-926d-493a-a7fa-8ec4c0000e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7ab8042f28019eb9e1c379833fe8c31", "thumbnail_srcset": "https://si.imgix.net/0c42005e/uploads/origins/49bd390e-926d-493a-a7fa-8ec4c0000e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7ab8042f28019eb9e1c379833fe8c31, https://si.imgix.net/0c42005e/uploads/origins/49bd390e-926d-493a-a7fa-8ec4c0000e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e89cb023c4d0178249df50613c83828 2x, https://si.imgix.net/0c42005e/uploads/origins/49bd390e-926d-493a-a7fa-8ec4c0000e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a789fdc116adad7bb7430ebf04fb21f 3x", "genre": "art", "nsfw": false, "body": "今週ちょうど=LOVEの新曲が発売されて、季節にピッタリの夏曲なので、MVの中に出てくる水玉ギンガムチェック柄の衣装の髙松瞳ちゃんのイラストをお願いします！後で、写真の画像も送るね！\n\nhttps://youtube.com/watch?v=Y1Bboo5KXL4&feature=share", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/9", "thumbnail_src": "https://si.imgix.net/23552d7e/uploads/origins/48831bd4-1684-43d7-8ec0-67be4666fd4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d1a6ef38beda0acfe0467f324c2eb5e", "thumbnail_srcset": "https://si.imgix.net/23552d7e/uploads/origins/48831bd4-1684-43d7-8ec0-67be4666fd4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d1a6ef38beda0acfe0467f324c2eb5e, https://si.imgix.net/23552d7e/uploads/origins/48831bd4-1684-43d7-8ec0-67be4666fd4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1929af02c4511912ddb0da0b6e155d6 2x, https://si.imgix.net/23552d7e/uploads/origins/48831bd4-1684-43d7-8ec0-67be4666fd4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d24d5b4b45e97e1454020c18e7e3b80e 3x", "genre": "art", "nsfw": false, "body": "こんにちは。先日の=LOVEのTシャツ衣装のイラスト、本人に見せれたよ！めっちゃ可愛いって言ってくれたよ！ということで、またお願いします！\n\n今回は、=LOVEの11枚目シングル「あの子コンプレックス」のMVの紫衣装の髙松瞳ちゃんをお願いします。今回も、6月のカレンダー付きバージョンも作ってくれたら嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/8", "thumbnail_src": "https://si.imgix.net/6b1b4da9/uploads/origins/5d2ba0cd-8cc9-4aa6-b69a-d33b7608bff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59089ba2f4d9c1df9268772c01f4912", "thumbnail_srcset": "https://si.imgix.net/6b1b4da9/uploads/origins/5d2ba0cd-8cc9-4aa6-b69a-d33b7608bff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59089ba2f4d9c1df9268772c01f4912, https://si.imgix.net/6b1b4da9/uploads/origins/5d2ba0cd-8cc9-4aa6-b69a-d33b7608bff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7810cb1d4e30c7b9e5eab26d98dd8b12 2x, https://si.imgix.net/6b1b4da9/uploads/origins/5d2ba0cd-8cc9-4aa6-b69a-d33b7608bff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68c535473c2fb1c6af36e60e04bd5094 3x", "genre": "art", "nsfw": false, "body": "エラバレシをご卒業される\n小熊めうちゃんに向けて\n小熊めうちゃんのイラストをお願いしたく\n\n可愛い感じで後はお任せでと言う\n大雑把なリクエストで申し訳ありませんが\nなにか形になるもの送ってあげたくて\nリクエストさせて頂いた次第です\n（すごいふとした感じの思いつきでリクエストしたので自由に描いてもらって大丈夫です）\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/7", "thumbnail_src": "https://si.imgix.net/aa5aa511/uploads/origins/f4ddc465-0ea5-4dc2-a9ba-8e429a4c6c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fbd3fadd5dae7f7a665d5686b9ea043", "thumbnail_srcset": "https://si.imgix.net/aa5aa511/uploads/origins/f4ddc465-0ea5-4dc2-a9ba-8e429a4c6c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fbd3fadd5dae7f7a665d5686b9ea043, https://si.imgix.net/aa5aa511/uploads/origins/f4ddc465-0ea5-4dc2-a9ba-8e429a4c6c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e30e9975deaba2bd6d775b9c673553c 2x, https://si.imgix.net/aa5aa511/uploads/origins/f4ddc465-0ea5-4dc2-a9ba-8e429a4c6c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09492b9240492b08e272a44df9ce9dd6 3x", "genre": "art", "nsfw": false, "body": "こんにちは。福。です。\n先日作成してもらったイラスト、昨日の結成6周年のお祝いとして髙松瞳ちゃんに見せたけど、めっちゃ可愛いって喜んでくれたよ！\n\nそれで、早速またお願いしたいんですが、今回はデビューシングル「=LOVE」のMVから最後のTシャツ衣装で=ポーズを取ってるところを全身でお願いしたいです。ポニテールがチャームポイントでもあるので、それがわかる感じも出してくれたら嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/6", "thumbnail_src": "https://si.imgix.net/78fa438f/uploads/origins/3928df0b-d62b-49df-a448-8b839a434e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89b373030522748e192a82714abd61c9", "thumbnail_srcset": "https://si.imgix.net/78fa438f/uploads/origins/3928df0b-d62b-49df-a448-8b839a434e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89b373030522748e192a82714abd61c9, https://si.imgix.net/78fa438f/uploads/origins/3928df0b-d62b-49df-a448-8b839a434e19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c27c8445400b51c18ec1ce496a97c79 2x, https://si.imgix.net/78fa438f/uploads/origins/3928df0b-d62b-49df-a448-8b839a434e19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc0e340f0dbf0f6038937be1c884f53b 3x", "genre": "art", "nsfw": false, "body": "熊本美和さん用の赤いいフラスタのパネルA3でお願いしましす。", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/5", "thumbnail_src": "https://si.imgix.net/8ddbd699/uploads/origins/74ef4137-634c-4f17-96e5-99e9f2a8943a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61bca064366c062a62e937606c1b2c6d", "thumbnail_srcset": "https://si.imgix.net/8ddbd699/uploads/origins/74ef4137-634c-4f17-96e5-99e9f2a8943a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61bca064366c062a62e937606c1b2c6d, https://si.imgix.net/8ddbd699/uploads/origins/74ef4137-634c-4f17-96e5-99e9f2a8943a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cf388135b97ad75c39b749a75b40c98 2x, https://si.imgix.net/8ddbd699/uploads/origins/74ef4137-634c-4f17-96e5-99e9f2a8943a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa8d89becd3491512c39fa379e530242 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\n\n=LOVEの髙松瞳ちゃんのキラキラ笑顔のイラストをリクエストします。「僕のヒロイン」というMVから矢田さんの目から見ていいなというシーンを切り取ってもらえると嬉しいですが、こんな依頼で大丈夫かな？笑\n\nhttps://youtu.be/AJ1GQ-iLyEM", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/4", "thumbnail_src": "https://si.imgix.net/ec23b9cc/uploads/origins/5b4a2bf9-af66-43b9-be7a-2a0619c3b603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2c6f758db54da1125027b10753796a", "thumbnail_srcset": "https://si.imgix.net/ec23b9cc/uploads/origins/5b4a2bf9-af66-43b9-be7a-2a0619c3b603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2c6f758db54da1125027b10753796a, https://si.imgix.net/ec23b9cc/uploads/origins/5b4a2bf9-af66-43b9-be7a-2a0619c3b603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70f86c4af3651ab7df515e1aefa5cfd2 2x, https://si.imgix.net/ec23b9cc/uploads/origins/5b4a2bf9-af66-43b9-be7a-2a0619c3b603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d15ac52f6c373a7482fb4cc8075666 3x", "genre": "art", "nsfw": false, "body": "初めまして、こんにちは。\n外鴨なきくと申します。\nツイッターで矢田さんの絵を見てファンになりました。\n∀ガンダムのファンですが年々新規絵の供給量が減っていく中で、矢田さんの∀イラストは大変ありがたく思っております。\nとても素敵な、個性に満ちた絵だと思います！\nそこで、似顔絵では無いのですが、もし可能でしたら、ツイッターの絵の感じで、ソシエ・ハイム嬢の絵を描いていただきたいと思います。\n\nお見合い写真のように、２０世紀初頭あたりのドレスのようなオシャレ着を着て、軽く笑っている感じで、椅子に座っているソシエ・ハイム、でお願いします。\n撮影者はロラン君のイメージです。", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/3", "thumbnail_src": "https://si.imgix.net/6936e858/uploads/origins/15deff8f-2043-4e37-bf73-bd5006937109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5a11f532710117acb29a89d57d4ceb", "thumbnail_srcset": "https://si.imgix.net/6936e858/uploads/origins/15deff8f-2043-4e37-bf73-bd5006937109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5a11f532710117acb29a89d57d4ceb, https://si.imgix.net/6936e858/uploads/origins/15deff8f-2043-4e37-bf73-bd5006937109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=630b6fe559cafa3eda7129a0402e1c9e 2x, https://si.imgix.net/6936e858/uploads/origins/15deff8f-2043-4e37-bf73-bd5006937109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c8bb52c2e85246ff4b79e8501b359ed 3x", "genre": "art", "nsfw": false, "body": "矢田喜多さん、こんにちは。私はあなたの作品の大ファンなので、skebであなたを見るのはうれしいです。\n\nロランくんとディアナ様の絵が欲しいです。二人は並んで、見る人に向かって立っています。二人はとても幸せそうです。二人の肩はお互いに触れ合っています。もしかしたら、顔も触れ合っているかもしれません。目も開いています。指を揃えて「ターンA」のポーズをとっています。つまり、片方が「V」のポーズをとっている間に、もう片方が指を伸ばしてポーズを完成させているのです。\n\nポーズの参考として、富野監督の写真をご覧ください。\nhttps://i.imgur.com/Ott94qG.jpg\n\nロランくんはこの服装\nhttps://i.imgur.com/jaGwpSK.jpeg\n\nディアナ様がこの衣装で登場\nhttps://i.imgur.com/2qjZe72.png\n\nその他の詳細については、あなたの判断にお任せします。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yattakita/works/2", "thumbnail_src": "https://si.imgix.net/7a958782/uploads/origins/55e03154-b8ca-49ef-ab1b-af4d3f3b59c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42be4b30342d01453e410e10e1e79ae0", "thumbnail_srcset": "https://si.imgix.net/7a958782/uploads/origins/55e03154-b8ca-49ef-ab1b-af4d3f3b59c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42be4b30342d01453e410e10e1e79ae0, https://si.imgix.net/7a958782/uploads/origins/55e03154-b8ca-49ef-ab1b-af4d3f3b59c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7af629afba345c4bc8a607893f107bfa 2x, https://si.imgix.net/7a958782/uploads/origins/55e03154-b8ca-49ef-ab1b-af4d3f3b59c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=983c28dc7d3ceb85f02863e6c8333ad6 3x", "genre": "art", "nsfw": false, "body": "Juice=Juiceの石山咲良さんが2/22にお誕生日を迎えるので、生誕お祝い用にかわいいイラストをお願いします。\n参考画像以外にも全身画像や動画はTikTokを参照ください。\n2種類欲しいので金額は2つ分です。\nよろ