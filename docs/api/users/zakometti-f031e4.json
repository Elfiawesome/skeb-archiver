dd-aac2098a933d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56f358e0999ae35791110f1e9732532e 2x, https://si.imgix.net/db8ec882/uploads/origins/819b75de-9086-4661-b2dd-aac2098a933d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f61eefd73feee3f22f8e0b807c52e415 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/34", "thumbnail_src": "https://si.imgix.net/54cc2848/uploads/origins/85abdee0-211a-4bd8-904b-72d8b81e3858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4960fdfd126c3aa4d690f4b4e64e597", "thumbnail_srcset": "https://si.imgix.net/54cc2848/uploads/origins/85abdee0-211a-4bd8-904b-72d8b81e3858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4960fdfd126c3aa4d690f4b4e64e597, https://si.imgix.net/54cc2848/uploads/origins/85abdee0-211a-4bd8-904b-72d8b81e3858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c33cb7e878f9b47028a09ed27a1712ce 2x, https://si.imgix.net/54cc2848/uploads/origins/85abdee0-211a-4bd8-904b-72d8b81e3858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2acb0350bc36f773f890d7a16c297f70 3x", "genre": "art", "nsfw": true, "body": "どうもです。実は今月もう１つリクエスト依頼をお願いします。\nリクエスト内容は超人学園ゴウカイザー、孫華鈴のエッチなオナニー姿の\nイラストです。\n\n全体図は頭から太もも、あるいは足の先まで、華鈴の状態は 正面に向かって\nこちらを見ている感じで、下に座り込んで両足を大きく開いて、股に食い込んだ\nエッチなパンツをこちらに見せつけてくる感じで、\n華鈴の格好は、戦闘コスチュームか、もしくは劇中のベルナール学園制服か、\nどちらかお任せします。\n\nこちらも差分として全裸バージョンのイラストもお願いいたします。\n全裸版は 股の(マンコ)とお尻の穴(アナル)を見せつける感じに、\n全裸バージョンでオナニーする差分として、\n(オナニーする時の華鈴の表情は最後以外はお任せします)\n(難しい構図がありましたらスルー、無しで構いません。)\n・左右の突起した乳首を強めに激しくつねって、痛みを感じながら乳首を\n　いじめるようにオナニーする。\n・突起した乳首の先を指の爪先でコリコリといじくり回す。\n・お尻の穴のアナルに指を入れて、掻き回すようにビクビク感じてるように、\n・マンコに指を入れて激しく掻き回して、絶頂寸前になる。\n・絶頂してマンコから潮、もしくは精液を吹き出す。\n・最後に 絶頂して気持ちよくなり、口を開いて口から舌を出し、\n　ヨダレを垂らしてアへ顔になる。\n　(アへ顔が難しいのであれば、顔はにやけて 口からヨダレを垂らしながら\n　 スッキリした気持ちいい感じの表情に、)\n\n以上でリクエスト依頼　よろしくお願いします。\n(追記　もし内容が難しいのであればキャンセルして頂いて構いません。)", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/33", "thumbnail_src": "https://si.imgix.net/cbb80706/uploads/origins/1a72123f-9799-47fe-807f-4a066916adac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1d18ea9e85555b71750eb7889b7325", "thumbnail_srcset": "https://si.imgix.net/cbb80706/uploads/origins/1a72123f-9799-47fe-807f-4a066916adac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1d18ea9e85555b71750eb7889b7325, https://si.imgix.net/cbb80706/uploads/origins/1a72123f-9799-47fe-807f-4a066916adac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6d42ac77aae3e51043b777417993d35 2x, https://si.imgix.net/cbb80706/uploads/origins/1a72123f-9799-47fe-807f-4a066916adac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=441ec599fb01eba54308870afb7672c3 3x", "genre": "art", "nsfw": true, "body": "前回は素敵なイラストをありがとうございました。事後の後ろ姿すごく良かったです。\n今回は「ファイアーエムブレム エンゲージ」のシトリニカを下記URLの服装でお願いします。\nhttps://guide.fire-emblem-heroes.com/14003007000977-2/\nこちらのURLに後ろ姿とドレスの上に羽織ってる上着を外した状態の資料があるのでご参考下さい。\nhttps://www.dropbox.com/scl/fi/ae8atbb12cq1ef4t33qpb/.JPG?rlkey=ljrrarbpolzt7znhm734vjikk&dl=0\n\nシチュはプライベートで付き合っていた貴族の若い男性と務めを終えた帰りに会っていた際に誘われ、応じてそのままベッドに寝かされてセックスを初めてしまう…の様なイメージで、側位のような横向きに寝て足を開く体位をとり、片方もしくは両方の胸を男性に揉まれながら挿入されセックスして射精される様子をお願いします。\nシトリニカのドレスはスリットの入ってる部分から広げ、足を開かせて挿入できる様にして頂ければと思います。下にタイツの様なものを履いていますが、サイハイソックスの様な解釈で残すか脱がすかはお任せします。下着については前回のようにずらしで挿入する形と脱がす形両方見れる様にして頂けたら嬉しいです。ドレスの上に羽織っている上着は描きにくければ脱がして頂いて構いません。胸を露出させる際はドレスの肩紐をずらすか外すか等して頂ければと思います。\nシトリニカの表情は急に求められて困ったりドキドキして恥じらってはいるけど嫌がってはいないイメージで、セックス中は気持ち良さそうな様子を、絶頂して射精された後まだ荒い呼吸しながら「もう…こんなに出して…」と満足げな顔で言ってそうな事後の様子をお願いします。\n男性の描写については今回も見える部分は引き締まった体型に、髪の毛もシンプルでいいので描写して頂ければと思います。\nその他はお任せします。服装の半脱ぎ具合もエッチに描きやすい形で描いて頂ければと思います。\n\n以上、よろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/32", "thumbnail_src": "https://si.imgix.net/820043e7/uploads/origins/aba1f331-5df2-4b7e-8e48-70f004c6ca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad6fc016813466357098dfc15c36d195", "thumbnail_srcset": "https://si.imgix.net/820043e7/uploads/origins/aba1f331-5df2-4b7e-8e48-70f004c6ca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad6fc016813466357098dfc15c36d195, https://si.imgix.net/820043e7/uploads/origins/aba1f331-5df2-4b7e-8e48-70f004c6ca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33121db2af09977ee793adee091e6cb7 2x, https://si.imgix.net/820043e7/uploads/origins/aba1f331-5df2-4b7e-8e48-70f004c6ca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89611fd493a5f7873dbb756675524897 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/31", "thumbnail_src": "https://si.imgix.net/df17955b/uploads/origins/aa8e3786-80a4-471f-a878-c6cfa4f3ad22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2917645b6976720f84f90357784b4128", "thumbnail_srcset": "https://si.imgix.net/df17955b/uploads/origins/aa8e3786-80a4-471f-a878-c6cfa4f3ad22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2917645b6976720f84f90357784b4128, https://si.imgix.net/df17955b/uploads/origins/aa8e3786-80a4-471f-a878-c6cfa4f3ad22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=141ac76dc67daeda4540bfa374c6e780 2x, https://si.imgix.net/df17955b/uploads/origins/aa8e3786-80a4-471f-a878-c6cfa4f3ad22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=917955fded3a86babf2ee63dbacc4366 3x", "genre": "art", "nsfw": true, "body": "どうもです。初リクエスト依頼、ありがとうございました。\nリクエストの依頼は、超人学園ゴウカイザー、孫華鈴のヒロインピンチ系の\nリョナイラストをお願いします。\n内容は、ドラマＣＤ第２巻のストーリーの闘いのシーンで、\n 孫華鈴が敵の女性キャラに胸板を踏みつけられ苦しむ絶体絶命の\nピンチシーンのイラスト化です。\n\n華鈴の全体図は頭から太もも辺りまで、華鈴の状態は地面に仰向けに\n倒れた状態に、コスチュームはボロボロで片方の胸の部分は破けて乳首が\n見える感じに、胸と肩のアーマー部分にヒビが入った感じに、\n華鈴の胸板に敵女性キャラの足のハイヒールがドスンと踏みつけ、グリグリと\n踏み潰すように押し付ける感じで、( 左右の胸が挟む形で、)\n華鈴の表現は、両目は閉じて、眉は歪んで、口は大きく歯を食い縛る感じに、\n\n敵女性キャラは、ドラマＣＤ２巻に出てくるネクロカイザーと言うキャラ。\nもしくは 同作品に出てくるプラトニックスレイブ( 朝比奈 鈴 )\nどちらか描ける方で構いません。お任せします。もしくは踏みつける足の\nハイヒール部分だけでも構いません。\n\n初リクエスト同様、こちらのイラストも差分で全裸バージョンのイラストを\nお願いいたします。全裸版イラストの華鈴には 戦闘で受けた傷かアザを\n付けてください。( 血や流血の表現は無しで、)\n\nこちらの華鈴の全裸版イラストで可能であれば 差分として、華鈴のお腹を\n踏みつけるバージョンのイラストをお願いいたします。\n全裸版の華鈴の腹に敵女性キャラの足のハイヒールがめり込む形でグイグイと\n踏みつける。こちらの華鈴の口は大きく開けて八重歯が見える感じに、\nこちらも可能であれば、華鈴の口から胃液、もしくはゲロを吐いて、\n口元に垂れて、胸元にかかり、こびりついた感じに、\n\n以上でリクエスト依頼、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/30", "thumbnail_src": "https://si.imgix.net/74747011/uploads/origins/26bfad1c-257d-4d0c-9dc0-6546a53221aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d72d543ebf65cbb1959b0414b7f8af19", "thumbnail_srcset": "https://si.imgix.net/74747011/uploads/origins/26bfad1c-257d-4d0c-9dc0-6546a53221aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d72d543ebf65cbb1959b0414b7f8af19, https://si.imgix.net/74747011/uploads/origins/26bfad1c-257d-4d0c-9dc0-6546a53221aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36ad252cbecdbe398fdc816ec9ad0287 2x, https://si.imgix.net/74747011/uploads/origins/26bfad1c-257d-4d0c-9dc0-6546a53221aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7aa6166dc7975f029ff3d81a543096cb 3x", "genre": "art", "nsfw": true, "body": "作品名：Tears To Tiara（ティアーズ・トゥ・ティアラ）\n\nキャラクターモーガン (モルガン)\n\nポーズ：とてもエロティックでハードコアなセックスシーン。精液をたくさん出してほしい。ポーズと背景はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/29", "thumbnail_src": "https://si.imgix.net/4db07932/uploads/origins/cc5f54b3-119d-4691-a878-ad821cb77b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f0de1cdf28eed4cda0ac107d2145da", "thumbnail_srcset": "https://si.imgix.net/4db07932/uploads/origins/cc5f54b3-119d-4691-a878-ad821cb77b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f0de1cdf28eed4cda0ac107d2145da, https://si.imgix.net/4db07932/uploads/origins/cc5f54b3-119d-4691-a878-ad821cb77b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ead822a613b7a364a6fe8c28d01b8cc 2x, https://si.imgix.net/4db07932/uploads/origins/cc5f54b3-119d-4691-a878-ad821cb77b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4f23b2056842871a991ef24ae2515d2 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n天野寧々とSlimecureという二人のVtuberの淫らな作品をお願いしたいです。この作品では、ネネが尼僧服を着て、参考ポーズのようにスリメキュアの上に騎乗位で乗っているところを描いてください。ネネは胸を弄りながらエロい表情をしてください。スリムキュアはいつものニヤニヤ顔で。\n\nご検討よろしくお願いします！\n\nネネの参考文献\nhttps://i.imgur.com/Z180uxR.jpg\nhttps://i.imgur.com/Rh8isuj.jpg\nhttps://i.imgur.com/NMltLWT.jpg\n\nSlimecureリファレンス：\nhttps://i.imgur.com/O67FRU8.jpg\n\nポーズの参考文献：\nhttps://i.imgur.com/Wc7uxe6.jpg", "created_at": "", "completed_at": ""}, {"path": "/@zakometti/works/28", "thumbnail_src": "https://si.imgix.net/83388baa/uploads/origins/9c7dbf1b-2b36-4110-88b6-0fa3f7a57d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec2e3bf91216ab5540742f5e0382c5be", "thumbnail_srcset": "https://si.imgix.net/83388baa/uploads/origins/9c7dbf1b-2b36-4110-88b6-0fa3f7a57d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20