e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b69cc914c9d385796fcdb2127ff55e8 3x", "genre": "art", "nsfw": true, "body": "良ければ下記内容が受理可能かご検討よろしくお願いします。\n\n◯キャラ\n下記のウチの子、エルフリンデ\nhttps://x.com/er450935/status/1891457520603922527?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n◯イラスト\n下記のような感じで、妖艶に舌を出しているエルフリンデ。\n向きや解釈などお任せします！（先生のイラスト、お顔や雰囲気がカッコイイので先生のセンスで解釈してお好きに描いてください…！）\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQLLZAaaHlW5p7LhMrpdFqBc17BPv6n9Hw-LTDNTbDhIfikvqDeiWo2uUAl&s=10", "created_at": "", "completed_at": ""}, {"path": "/@torakichijayo/works/21", "thumbnail_src": "https://si.imgix.net/900ea13b/uploads/origins/abb48bc7-3bec-4f5e-82c7-b3d6d6b463ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62545cba936775a4cb9fb4f229b7f078", "thumbnail_srcset": "https://si.imgix.net/900ea13b/uploads/origins/abb48bc7-3bec-4f5e-82c7-b3d6d6b463ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62545cba936775a4cb9fb4f229b7f078, https://si.imgix.net/900ea13b/uploads/origins/abb48bc7-3bec-4f5e-82c7-b3d6d6b463ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=363d2d89d379515727cc1f5d35ca2c80 2x, https://si.imgix.net/900ea13b/uploads/origins/abb48bc7-3bec-4f5e-82c7-b3d6d6b463ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2e1823024563606ac93cd958a5b476a 3x", "genre": "art", "nsfw": false, "body": "初めまして、Vsingerとして活動しておりますやんこと申します。\n叶多さんのイラストから存じ上げていたのですが、いつかご依頼してみたいと考えており今回ご連絡させていただきました。\n\n-用途\n・収益化未のYouTubeでのサムネイル\n・ネットプリントなど収益がないものへの使用\n・SNSでの使用\n\n-内容\n・私自身を描いていただきたいです。\n・出かけた先でふと写真を撮ったような　デートなう、のような感じの雰囲気\n・構図やポーズはお任せできればと思います。\n・描写範囲は左右全身見切れない感じでおねがいしたいです。\n・上半身、顔アップにしてもぼやけない程度\n\n-立ち絵参考\nwww.dropbox.com/scl/fo/ch6l5zujulf7pgr9n0pyr/AJWGFKofQR7BX24EYdziyBc?rlkey=jiq8srlga5239ojdtlbryxgh5&st=jzpr8d0w&dl=0\n\n初めてskebを利用するため、不備がございましたら申し訳ございません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@torakichijayo/works/20", "thumbnail_src": "https://si.imgix.net/411da948/uploads/origins/6712d69f-3b3d-40a2-9341-3603f91918d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b0c8069475802d5af57a0b95a3f0c81", "thumbnail_srcset": "https://si.imgix.net/411da948/uploads/origins/6712d69f-3b3d-40a2-9341-3603f91918d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b0c8069475802d5af57a0b95a3f0c81, https://si.imgix.net/411da948/uploads/origins/6712d69f-3b3d-40a2-9341-3603f91918d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=390c14e5d25e794dc256086ff89fd5fd 2x, https://si.imgix.net/411da948/uploads/origins/6712d69f-3b3d-40a2-9341-3603f91918d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a2c95bf335585dc94b8dcec2f24157f 3x", "genre": "art", "nsfw": false, "body": "個人Vtuberとして活動をしております。\n山田蓮と申します。\nXの方で、オススメで見かけたtora様のイラストが\nいろんな表情や雰囲気や構図を描かれていて\nあまりに素敵でしたので今回依頼した次第です。\n\n\n\n【用途】\n・収益化済みのyoutubeでの配信のサムネイル\n・SNSでの宣伝活動\n・商用利用はありません\n(ネットプリント等、収益が発生しないものに使用する可能性あり)\n\n\n\n【依頼内容】\n「山田蓮」本人のイラストをお願いします。\n構図の指定はありません。\nインスピレーションで思うまま\nペンを走らせて頂きたいです。\n欲を言えば、少し生意気そうな表情だと\n三点倒立して喜びます。\n\n主にサムネイルに使用するので\n左右でパーツが切れない様にしていただけると助かります。\n\n\n▶立ち絵資料　\nttps://twitter.com/Sana_ry03\n(固定に立ち絵があります。\n描きやすい髪型等でお願いします。)\n\n\n【最後に】\nデータはレイヤー分けした、PSDデータ又はPngデータで頂けると幸いです。\n\nhttps://twitter.com/Sana_ry03", "created_at": "", "completed_at": ""}, {"path": "/@torakichijayo/works/19", "thumbnail_src": "https://si.imgix.net/453fc107/uploads/origins/24fc14a5-df53-4e68-95a5-365f55bdeb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=380a4c37bf33ac829d0237aa09f6dcf0", "thumbnail_srcset": "https://si.imgix.net/453fc107/uploads/origins/24fc14a5-df53-4e68-95a5-365f55bdeb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=380a4c37bf33ac829d0237aa09f6dcf0, https://si.imgix.net/453fc107/uploads/origins/24fc14a5-df53-4e68-95a5-365f55bdeb79?bg=%23fff&auto=format%2Ccompress&f