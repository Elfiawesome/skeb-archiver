30&txt=PRIVATE&s=655840c9845b5f7f1d66cd57f7dbf2a3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/31", "thumbnail_src": "https://si.imgix.net/104d8518/uploads/origins/68ee1a06-58db-4bb2-bc3b-03b7b4be3d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c99ab50e074c62e48ca0a9a75e643db", "thumbnail_srcset": "https://si.imgix.net/104d8518/uploads/origins/68ee1a06-58db-4bb2-bc3b-03b7b4be3d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c99ab50e074c62e48ca0a9a75e643db, https://si.imgix.net/104d8518/uploads/origins/68ee1a06-58db-4bb2-bc3b-03b7b4be3d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9174a2a4617a0b84aff3a2dc348316e4 2x, https://si.imgix.net/104d8518/uploads/origins/68ee1a06-58db-4bb2-bc3b-03b7b4be3d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf120ffa099e2e07d0336909d276292 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/30", "thumbnail_src": "https://si.imgix.net/72d5de3e/uploads/origins/5e330050-4e9e-4bf9-9722-cd68321ba0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ffd90771845f1112c45ebc07117836", "thumbnail_srcset": "https://si.imgix.net/72d5de3e/uploads/origins/5e330050-4e9e-4bf9-9722-cd68321ba0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ffd90771845f1112c45ebc07117836, https://si.imgix.net/72d5de3e/uploads/origins/5e330050-4e9e-4bf9-9722-cd68321ba0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cebbb5d2710007de7b1f8dff2b70be01 2x, https://si.imgix.net/72d5de3e/uploads/origins/5e330050-4e9e-4bf9-9722-cd68321ba0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=786cd842e2246899252a2ec5f9b36752 3x", "genre": "art", "nsfw": false, "body": "たねいも様\nはじめまして、Xのおすすめに出てきて一目惚れしました。初リクエスト失礼致します…！\n\nフルフルちゃんとくっついているイラストが可愛すぎて、似たような配置でナルガとお昼寝してるイラストをお願いしたいです。\n\n可能であれば古代樹の森の木陰のような背景を希望しますが、難しい場合は背景なしか、たねいも様のセンスにお任せ致します。\n資料はURL先のドライブにありますのでご参考いただければと思います。\n\n宛名を書いていただける場合名前は｢ぞしちゃん｣でお願いいたします。\n初めてのリクエストのため不備や失礼がありましたら申し訳ございません。\nお忙しいとは思いますが、どうぞよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1-MpKdkUjOLWTSOlVhoINluZVF0wO4w0N", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/29", "thumbnail_src": "https://si.imgix.net/b25eef97/uploads/origins/fba5c5ea-eedd-41b4-9d7d-607dbf7b375e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970bda28079e17f4de3997f64daa285f", "thumbnail_srcset": "https://si.imgix.net/b25eef97/uploads/origins/fba5c5ea-eedd-41b4-9d7d-607dbf7b375e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970bda28079e17f4de3997f64daa285f, https://si.imgix.net/b25eef97/uploads/origins/fba5c5ea-eedd-41b4-9d7d-607dbf7b375e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3b54f330f5b83441fdbf2140f973b63 2x, https://si.imgix.net/b25eef97/uploads/origins/fba5c5ea-eedd-41b4-9d7d-607dbf7b375e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72936f65bbb03be32fbe083eb24acaab 3x", "genre": "art", "nsfw": true, "body": "前回はライネルをありがとうございました。\nまたライネルを依頼したく。詳細を以下に記します。\n\n■シチュエーション\n白髪のライネルが、ミファーの槍の突きを胸当てで受け止め、またその突き出した腕を光鱗の槍ごと掴んで拘束しつつ、串刺しにしようともう片方の腕で片手剣を突き出そうと力を溜めるように構えている。\n次の瞬間にはミファーの腹から胸にかけて、その背中に剣が突き出しているようなイメージです。\n\n■キャラクター\n■■白髪のライネル\nブレワイ準拠(角はシンプルな形)でお願いします。\n武器は片手剣(獣神シリーズ)です。\n\n全体的な風貌としては、既にゾーラ族を何体も屠っているかのような姿を表現して頂けると嬉しいです。\n・左腕に装備している盾の切先や、片手剣が血で汚れている\n・返り血で全身や髪の毛も血で汚れている\n・全身にゾーラ族の剣や槍で受けた傷はあり、自らも少なくない血を流してはいるが、命に別状はない程度\n\n表情としては、前回の冷徹さとは違い、殺しの愉悦に浸っているような、凶悪な笑みを浮かべているようにお願いしたいです。\n\nミファーを拘束しつつ、仕留めようとしている両腕に関してですが、以下のようなイメージでお願いします。\n左腕: ミファーの突き出した手を槍ごと掴んでいる、伸ばした左腕は、絶対に掴んで離さないように槍ごと握り潰してしまいそうな握力。\n右腕: ミファーを串刺しにしようと、片手剣を強く握り、勢いをつける為に引いて力を込めて、腕までが怒張している。\n\n■■ミファー\n以下の観点より重視しません。\n\n■構図\nミファーの一人称視点でお願いします。その為、ミファーの体で見えるのは、掴まれそのまま握り潰されつつあるような腕の先くらいで、ほぼほぼライネルのみがドアップで映るような形です。\n\n■背景\n重視しません。\n強いて言えば、ゾーラの里を戦場とし、既に幾多のゾーラ族が餌食になったような事が伺えると嬉しいです。\n\n■重視する点\n前回と比較すると、武人というよりは魔物らしい残虐さ、凶悪さを表現して頂けると嬉しいです。\n何人ものゾーラ族を既に仕留めている、血に塗れた風貌。\nゾーラ族の指折りの戦士を討伐出来る事への、魔物、侵略者としての、殺しそのものに愉悦を抱いている凶悪な愉悦に溢れた顔。\n\n■備考\n挿絵として使うかもです。\n\n可能であればお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/28", "thumbnail_src": "https://si.imgix.net/af53a63b/uploads/origins/58f111b2-979c-4365-a610-98488fe6c8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad758991d469a0fe9f1172d1036c22ed", "thumbnail_srcset": "https://si.imgix.net/af53a63b/uploads/origins/58f111b2-979c-4365-a610-98488fe6c8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad758991d469a0fe9f1172d1036c22ed, https://si.imgix.net/af53a63b/uploads/origins/58f111b2-979c-4365-a610-98488fe6c8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2950d1c4e1814aa9a1070bce60ad97f0 2x, https://si.imgix.net/af53a63b/uploads/origins/58f111b2-979c-4365-a610-98488fe6c8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4c549565306fb57d1af8fe9109670a5 3x", "genre": "art", "nsfw": false, "body": "いつもたねいも先生の絵が好きです。リクエストの機会を得られて本当に嬉しいで思います\n\n私たちはずっと先生のシャガルマガラの描写が大好きで、だから私たちの混沌ゴアマガラOCに単キャラーのイラストを依頼したいです\n\n彼が孤独に雪原の中央にとどまり、空中の舞い落ちる雪を翼爪で受け止める様子を描いた絵をリクエストしたいと思っています。この子は様々な悪いことを経験して、最終的に現在のようになりましたが、彼の孤独と懐かしい気持ちをイラストで表現してほしいです\n\n肩頸上は細かい氷の針があり、コートのような毛皮の襟の形になっています，うろこの色が少し青っぽいのもあえてデザインされています\n\nこのキャラの狂竜ウイルスの粉塵の色と黒い半身の発光の色は同じです\n必要に応じてその色に従って表現してください～～<(_ _)>\n\nhttps://drive.google.com/file/d/1-0LRPfu4crdqh8bzkOOBar8cCsLTHvWP/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/27", "thumbnail_src": "https://si.imgix.net/6f098b2e/uploads/origins/e9cac003-7faf-47bf-81e1-155910224eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba48fb4c9e9a01714b8581851bbb2df", "thumbnail_srcset": "https://si.imgix.net/6f098b2e/uploads/origins/e9cac003-7faf-47bf-81e1-155910224eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba48fb4c9e9a01714b8581851bbb2df, https://si.imgix.net/6f098b2e/uploads/origins/e9cac003-7faf-47bf-81e1-155910224eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30a580a9d9ee7df86d0c26a27ea0eb14 2x, https://si.imgix.net/6f098b2e/uploads/origins/e9cac003-7faf-47bf-81e1-155910224eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=521ca124982d4adcce687d1de8345414 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのアートワークが大好きで、私のモンスターハンターストーリー2のキャラクターの一人を手に入れられることを願っています。私のライダーが座っていて、ミズツネの頭を膝に乗せて、彼を撫でていて、ラサロスのラズウィングが彼の後ろで寝ているようなことは可能でしょうか？ビジュアルをもう少し簡単にするために、フォルダに参考資料を添付しました！\n\nhttps://drive.google.com/drive/folders/16l7FfSsAT8r-9PnT2zt_fMr6-_Gsu2P_", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/26", "thumbnail_src": "https://si.imgix.net/0ebecd50/uploads/origins/9bb33282-6abf-468a-8a35-9a67daa99681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de571ae06d81301fdff4214254b9d28", "thumbnail_srcset": "https://si.imgix.net/0ebecd50/uploads/origins/9bb33282-6abf-468a-8a35-9a67daa99681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de571ae06d81301fdff4214254b9d28, https://si.imgix.net/0ebecd50/uploads/origins/9bb33282-6abf-468a-8a35-9a67daa99681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=982dc0d6aaf225132ae6b448bc386e7b 2x, https://si.imgix.net/0ebecd50/uploads/origins/9bb33282-6abf-468a-8a35-9a67daa99681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb72b0c40fc53bc9b89803b87e919e25 3x", "genre": "art", "nsfw": false, "body": "お世話になっています！リクエスト初めてなので不備や失礼があればすみません！\n\n体格差のあるシャガルマガラ（最小金冠程度）と、バルファルク（最大銀冠程度）が同じ寝床でなかよくくっついて幸せそうに眠っているイラストをリクエストしたいです！\n\n構図に関してはおまかせします。\n参考になればと思い、2匹のイメージだけ記載します\n\nシャガルマガラはゲーム内のように腕枕をしていてもいいですが、以前Twitterで拝見したタマロア様の成長過程イラストでように頭を相手の身体に預けていたり、抱きついていてもいいです。幸せそうにしていたらとても嬉しいのでここはお任せします。\n\nバルファルクの方は年上のイメージなのですが、年下の子のわがままを許しながら横で穏やかに眠りつつ可能であれば尻尾が絡んでいたり好意をもっていることが感じ取れたらいいなと思っております\n\n依頼が初めてなので不足や失礼を申し出ていたらすみません。ご検討宜しくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/25", "thumbnail_src": "https://si.imgix.net/c0fd1a47/uploads/origins/c531d75e-4655-42de-ab47-31cb25449ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f27825d5876b7030c83ada7423daddb", "thumbnail_srcset": "https://si.imgix.net/c0fd1a47/uploads/origins/c531d75e-4655-42de-ab47-31cb25449ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f27825d5876b7030c83ada7423daddb, https://si.imgix.net/c0fd1a47/uploads/origins/c531d75e-4655-42de-ab47-31cb25449ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac183f386f8af41145965f263deb6629 2x, https://si.imgix.net/c0fd1a47/uploads/origins/c531d75e-4655-42de-ab47-31cb25449ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d20cd2da24098ab5e48259b6cfd356cb 3x", "genre": "art", "nsfw": true, "body": "ゼルダの伝説　ブレスオブザワイルドより、\n白銀ライネルに仕留められ命を刈り取られる寸前のリーバル、という敗北シチュエーションをお願いします。\n詳細を以下に記します。\n\n■シチュエーション\nリーバルは白銀ライネルの獣神の弓で射落とされ、這う這うの体で逃げようとしている。\n白銀ライネルは獣神の弓を仕舞い、獣神の槍を手に取って仕留めようと、悠々と後ろから歩いてきている。\n数秒後には槍を突き立てられて殺されるようなイメージです。\n\n■キャラクター\n■■リーバル\n腕や腹に矢を的中され、墜落。即死こそ免れたが致命傷を負っている。\n口から血を吐いている。\n最早飛べず、オオワシの弓も手元にはない。\n顔は絶望に染まっている。\n体が土で汚れていたり、手足が幾つか折れていたりすると嬉しいです。\n\n■■白銀ライネル\n体に矢は幾つか突き刺さっているが、意に介していない。血も僅かしか出ていない。\n弓を背中に戻し、獣神の槍を手に取り、冷徹な顔でリーバルを仕留めようと距離を詰めてきている。\n角の形はブレワイのシンプルな形状でお願いします。\n\n■構図\n這ってでも逃げようとするリーバルの前から、背後に追ってくる白銀ライネルの全身が入る形。\n\n■背景\n重視しません。\n\n■重視するもの\n最早、死を免られないリーバルと、それに迫ってくるライネルの強大さ、絶望。\n\nまあ、端的に言ってしまうと敗北シチュエーションとしての良さを活かして頂けると。\n・瀕死のリーバル\n　・絶望に染まる顔\n　・這う事しか出来ない瀕死の状態\n　・遠くに落ちて折れているオオワシの弓\n・冷徹に迫ってくる白銀ライネル\n　・勝者としての喜びも見せずに淡々と、純粋に殺意を拵えている冷徹な顔\n　・逃げる事は出来ないと判断した上で、余裕を持って歩いてきている\n　・矢こそ幾つか刺さっているが、無傷と言って良い程何も効いていないような強大さ\n　・死神の鎌の如く手に取られた獣神の槍\n　　・可能な限り全長を絵の中に収めて、その上で切先をより強調する形でお願いしたいです\n\n■備考\n挿絵のように使いたいです。\n\n可能であればお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/24", "thumbnail_src": "https://si.imgix.net/67233c11/uploads/origins/a58b82b8-2a4f-474d-9fa9-beca6123bede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9877c97c0f49f8f12c7b1039d484356d", "thumbnail_srcset": "https://si.imgix.net/67233c11/uploads/origins/a58b82b8-2a4f-474d-9fa9-beca6123bede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9877c97c0f49f8f12c7b1039d484356d, https://si.imgix.net/67233c11/uploads/origins/a58b82b8-2a4f-474d-9fa9-beca6123bede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d37a83972452be1d3839e4b018149fb 2x, https://si.imgix.net/67233c11/uploads/origins/a58b82b8-2a4f-474d-9fa9-beca6123bede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05508ca2a7b4aa3f7ce4adf8226ecba1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@taneimo_drop/works/23", "thumbnail_src": "https://si.imgix.net/80e41078/uploads/origins/f12cee91-c0d8-4f11-b87b-a3ff5a8ee71c?bg=%23fff&auto=form