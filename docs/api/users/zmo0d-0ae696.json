ということだ。）というストーリーは、おそらくこんな感じなのだろう！\n\n▼内容など：\n前回と同じく、茶色の大きなユキヒョウと黒いコーギーの半獣化した姿をまた見たいです——\n服のデザインは自由に変えることができます。ポーズや表情も自由です。\n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。\n私の依頼を考慮していただき、ありがとうございました~！🫶\n\nhttps://drive.google.com/drive/folders/1Bf64h9wMoueFd43YA-UAL-PjWzrUGVRE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@zmo0d/works/71", "thumbnail_src": "https://si.imgix.net/cca7b2ae/uploads/origins/fcecaad0-7a1a-42f9-a138-797161a7c62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1c3a51200400668e0f9f91f67a3f6b5", "thumbnail_srcset": "https://si.imgix.net/cca7b2ae/uploads/origins/fcecaad0-7a1a-42f9-a138-797161a7c62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1c3a51200400668e0f9f91f67a3f6b5, https://si.imgix.net/cca7b2ae/uploads/origins/fcecaad0-7a1a-42f9-a138-797161a7c62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22c1d4362fe573d25b299cc42f98bbfa 2x, https://si.imgix.net/cca7b2ae/uploads/origins/fcecaad0-7a1a-42f9-a138-797161a7c62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=decf223994edb798e56dd31e391eb9ff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zmo0d/works/70", "thumbnail_src": "https://si.imgix.net/4b8fbf7e/uploads/origins/64de9784-585e-4373-b771-89f8fc61eb3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f46d5ebed74e27bde4aceb3bb82cfd81", "thumbnail_srcset": "https://si.imgix.net/4b8fbf7e/uploads/origins/64de9784-585e-4373-b771-89f8fc61eb3b?bg=%23fff&auto=format%2Ccompress&fm=w