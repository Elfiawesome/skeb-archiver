8/uploads/origins/23d5455c-8f87-4545-8600-4dc9e7960e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a9fc9661b7d09d0d42395da5672549", "thumbnail_srcset": "https://si.imgix.net/ce1d2648/uploads/origins/23d5455c-8f87-4545-8600-4dc9e7960e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a9fc9661b7d09d0d42395da5672549, https://si.imgix.net/ce1d2648/uploads/origins/23d5455c-8f87-4545-8600-4dc9e7960e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d58d23045995f665df43fc6db976d0c6 2x, https://si.imgix.net/ce1d2648/uploads/origins/23d5455c-8f87-4545-8600-4dc9e7960e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60cb271c716ef1c577ef24c9792b7cf7 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。天川みるくと申します。\nアピールありがとうございます！\n\n先日、新衣装のお披露目をいたしまして、チャイナ服Ver.を描いていただけませんか？\n細かい構図などはお任せいたします。\n\nYoutubeのサムネイル、各種SNS、グッズ化への商用利用等で使わせていただきたいと思っております。\n頭の先が見切れないように描いていただけますとありがたいです。\n\nキャラクターイメージ\n・ふんわり、ほわほわ、赤フレーム眼鏡\n・髪は赤・瞳は緑になります。サイドの髪が長いのが特徴です。\n\nキャラのみの透過で使用できるよう、PSDのデータか、透過のPNGファイルをいただけると助かります。\nどうぞよろしくお願いいたします。\n\nhttps://vpl2023.com/player/mirurun/\n\nhttps://x.com/milkuru/status/1882847704725999686/photo/3\n\nhttps://x.com/milkuru/status/1882847704725999686/photo/3", "created_at": "", "completed_at": ""}, {"path": "/@naname1129/works/16", "thumbnail_src": "https://si.imgix.net/e1321593/uploads/origins/a0cfa261-a940-4adb-931d-383b43de5286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9626211db840da6f36eb94149c0f27ed", "thumbnail_srcset": "https://si.imgix.net/e1321593/uploads/origins/a0cfa261-a940-4adb-931d-383b43de5286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9626211db840da6f36eb94149c0f27ed, https://si.imgix.net/e1321593/uploads/origins/a0cfa261-a940-4adb-931d-383b43de5286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd13eb30f7b42366ab542fab68aa94a3 2x, https: