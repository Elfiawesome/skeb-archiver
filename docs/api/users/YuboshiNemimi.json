6a-68c6-4aa3-8e36-2c409391287d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdb6351003927136fd82fe626dac545f, https://si.imgix.net/5cc84125/uploads/origins/e7d65f6a-68c6-4aa3-8e36-2c409391287d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4909c90e3e192b0f5e6513c54178a15 2x, https://si.imgix.net/5cc84125/uploads/origins/e7d65f6a-68c6-4aa3-8e36-2c409391287d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a4c261339b7cd9d0ddf87a874094c55 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています 狐牛ぶなです！\nSkeb手数料無料キャンペーンとのことで丁度SDのイラストが欲しかったのでリクエストを送らせていただきました！\nまた、描いて頂いたイラストは後日アクリルキーホルダー等のグッズ制作に使用させて頂きたいと思っています。\n\n◇キャラクター\n狐牛ぶな\n添付したURLに資料があります。\n服装は新衣装で、ビーストモードの姿でお願いします。\n\n◇ポーズ、シチュエーション\nSDでの全身の立ち姿のイラスト。\n両手にナイフとフォークを持っていて目をキラキラさせてよだれを垂らしている。\n\n前述の通りグッズやその他活動に使用させて頂きたいので立ち絵は背景と別レイヤーにして透過状態にしておいて頂けると有り難いです。\n\nリクエスト内容は以上になります。\nそれではご検討よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/97727190", "created_at": "", "completed_at": ""}, {"path": "/@YuboshiNemimi/works/7", "thumbnail_src": "https://si.imgix.net/61f24a01/uploads/origins/c553da06-4e7b-4118-8533-08a9a187c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d0ba2234177e27dc80b60fe0468d10", "thumbnail_srcset": "https://si.imgix.net/61f24a01/uploads/origins/c553da06-4e7b-4118-8533-08a9a187c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d0ba2234177e27dc80b60fe0468d10, https://si.imgix.net/61f24a01/uploads/origins/c553da06-4e7b-4118-8533-08a9a187c446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05976d51657077e74ef2ae5d6abd8856 2x, https://si.imgix.net/61f24a01/uploads/origins/c553da06-4e7b-4118-8533-08a9a187c446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b144dd51dc73b767568fb04e6eb968f 3x", "genre": "art", "nsfw": false, "body": "癒星ねみみさん、こんにちは！\nイラスト依頼をしたく送らせていただきました！\n要望としては\n・私こと春流サメ(はるさめ)のSDイラストをお願いしたいです。\n・構図、ポージング等はお任せいたします。\n・配信サムネに使用したいので透過画像もお願いします。\n\nよろしくお願いします。\n\nhttps://x.com/samesame_toutoi/status/1698866218353185233", "created_at": "", "completed_at": ""}, {"path": "/@YuboshiNemimi/works/6", "thumbnail_src": "https://si.imgix.net/71a2a395/uploads/origins/452fe2a9-6c48-4c19-8316-fea35f8736bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0189030ce2af0997976a327fb88c2a9", "thumbnail_srcset": "https://si.imgix.net/71a2a395/uploads/origins/452fe2a9-6c48-4c19-8316-fea35f8736bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0189030ce2af0997976a327fb88c2a9, https://si.imgix.net/71a2a395/uploads/origins/452fe2a9-6c48-4c19-8316-fea35f8736bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c932f4ba6773617c694c25f98d8794b4 2x, https://si.imgix.net/71a2a395/uploads/origins/452fe2a9-6c48-4c19-8316-fea35f8736bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4c2442cc9aa7f379484e97ac1b171e4 3x", "genre": "art", "nsfw": false, "body": "こんねみです！\n前回のリクエストありがとうございました。未来翔くんもとても喜んでおりました！\n連続でのskeb依頼となってしまいますが、今回はいわゆる「うちの子」のデザインをお願いしたく思います。\n\nうちのこのテーマは私HeyBeyの顔アイコンを擬人化してみたもの\n\n下記の資料URLに自分でデザインしてみたものを貼らせていただきますが、もし可能であればで構わないのですが「褐色肌、黄色目、黒髪」という3点を最低条件に新たにデザインしていただけると幸いです。\nもちろん資料のものそのままのデザインでも全然大丈夫です。\n\n完成したものはTwitterなどSNSのアイコンや今後考えているVtuberの身体もしくはその参考として使わせていただこうかと思っています。\n\n長文と色々とめんどうな条件ではありますが、前回と同じく他の方のご依頼がございましたらそちらを優先していただいても問題ありません！急ぎでもないのでご自分のペースで進めていただければと思います。\n条件に合うようであればご一考よろしくお願いします！\n\nhttps://x.com/pixel_heybey/status/1805564992915489035?s=46&t=rvHGpcDdcZzrTai_o5jhnQ", "created_at": "", "completed_at": ""}, {"path": "/@YuboshiNemimi/works/5", "thumbnail_src": "https://si.imgix.net/492cf775/uploads/origins/22929345-8160-4c03-8894-0a954ec16b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=682178d8c052320b1a42366f8e993de6", "thumbnail_srcset": "https://si.imgix.net/492cf775/uploads/origins/22929345-8160-4c03-8894