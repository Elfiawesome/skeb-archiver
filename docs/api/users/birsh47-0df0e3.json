7c-cbfc-408a-8fe5-2c46eef43ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5aedd6128015b557d0872a88667a0b0 2x, https://si.imgix.net/5b746cef/uploads/origins/0413fa7c-cbfc-408a-8fe5-2c46eef43ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1cede6e333fb6f99d7f4a9a69c54ca7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@birsh47/works/21", "thumbnail_src": "https://si.imgix.net/59b4f267/uploads/origins/cde12038-6b23-4237-8e01-e612da08ff00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b8125e609a959b7a8d0fec8f359e41", "thumbnail_srcset": "https://si.imgix.net/59b4f267/uploads/origins/cde12038-6b23-4237-8e01-e612da08ff00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b8125e609a959b7a8d0fec8f359e41, https://si.imgix.net/59b4f267/uploads/origins/cde12038-6b23-4237-8e01-e612da08ff00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d0c825d78796671d218024c6ed704fa 2x, https://si.imgix.net/59b4f267/uploads/origins/cde12038-6b23-4237-8e01-e612da08ff00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31cf4eda4047f320b1471318b763edfc 3x", "genre": "art", "nsfw": true, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で爆乳化アへ顔アクメをキメる遊戯王OCGのRAI-MEIをリクエストします。\n\nキャラの造形は\n・頭身高めの全身むちむち\n・へそを超え下腹部がギリギリ隠れない程度の超乳寄り(大きい分には好きなだけ盛って下さい。ロ◯ロイで抑えた分をこちらにぶつけてもらえると嬉しいです)\n・服装は原作と同じ物で、乳首と乳輪は共に大きめかつ勃起状態&パフィーニップルが衣装越しにくっきり浮き出ている。\n・性格のイメージは優しくて少しSっ気もあるお姉さん\nといった感じでお願いします。\n\n構図は頭のてっぺんから股間までを写したバストアップを、以下のようなシチュエーションでセリフのテキスト付きの差分を用意して欲しいです。\n\n1枚目：ニヤけた表情でこちらを煽り、今からオナペットになることを宣言してオナニーを催促してくる。\n\n2枚目：目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂する。微かに残った意識で止めさせようとするも快楽に負け更に汚い淫語を満載したアへオホ声で絶叫しながらイキっぱなしになる。淫語をこれでもかと織り込んだ媚びるような喘ぎ声で射精を催促してくる。\n\n3枚目：射精後。勝手にカードを使った事に怒りながらも優しい態度で褒めてくれる。\n\nとにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@birsh47/works/20", "thumbnail_src": "https://si.imgix.net/26cc3864/uploads/origins/673f1a2a-f90f-4c18-8369-23378e5918db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c8b4ad1ec88bf4eb05321ad7017678", "thumbnail_srcset": "https://si.imgix.net/26cc3864/uploads/origins/673f1a2a-f90f-4c18-8369-23378e5918db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c8b4ad1ec88bf4eb05321ad7017678, https://si.imgix.net/26cc3864/uploads/origins/673f1a2a-f90f-4c18-8369-23378e5918db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ece1124f41f6b2c6c6c7e16568d62a88 2x, https://si.imgix.net/26cc3864/uploads/origins/673f1a2a-f90f-4c18-8369-23378e5918db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e126222b89b1abab02fb147239c043bc 3x", "genre": "art", "nsfw": true, "body": "[キャラクター]\n-水城ゆきかぜ\n\n彼女は全裸だ。嬉しそうな表情。\nダブルピースサインをしている。\n構図、体型.↓\nhttps://www.pixiv.net/en/artworks/115764117 (4番目の画像)\n上記参考画像と同じお尻サイズでお願いします。\nよろしくお願いします。\n\nキャラクター参考\nhttps://drive.google.com/drive/folders/1MYfZF_K7F3L0j1zhiQgzhxFov39mQ8xn?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@birsh47/works/19", "thumbnail_src": "https://si.imgix.net/c17f38bd/uploads/origins/a87cf17f-8a5c-413b-804f-ae8c2051ac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc447c33bf388bb430bb1632816bc11b", "thumbnail_srcset": "https://si.imgix.net/c17f38bd/uploads/origins/a87cf17f-8a5c-413b-804f-ae8c2051ac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=