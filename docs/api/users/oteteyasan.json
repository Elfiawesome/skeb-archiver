631340/uploads/origins/33c99c10-a307-42ad-ab87-75b86d1f632b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8a14daff1a308c4f897413640ce4077 2x, https://si.imgix.net/68631340/uploads/origins/33c99c10-a307-42ad-ab87-75b86d1f632b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=924c69344a9ebdd015f169c5ac47a6c8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/344", "thumbnail_src": "https://si.imgix.net/3a71d5dc/uploads/origins/1cfead8e-2685-4a3a-9729-66ff84117ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e78961103bc18f993302c879dbb8cfe6", "thumbnail_srcset": "https://si.imgix.net/3a71d5dc/uploads/origins/1cfead8e-2685-4a3a-9729-66ff84117ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e78961103bc18f993302c879dbb8cfe6, https://si.imgix.net/3a71d5dc/uploads/origins/1cfead8e-2685-4a3a-9729-66ff84117ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6559c93c495eac9d1d3825188ed02d6a 2x, https://si.imgix.net/3a71d5dc/uploads/origins/1cfead8e-2685-4a3a-9729-66ff84117ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=865316370f26184577f81f29a2650085 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n個人Vtuberの花柳りあと申します。\n\nこの度はおててやさんがご制作なさった手の様々な素材がとても素敵で可愛らしく、ぜひご制作いただけたらと思いリクエストをさせていただきました。\n\nお忙しいところ恐れ入りますが、\n以下の内容につきましてご確認のほどよろしくお願いいたします。\n\n今回ご制作いただきたいものは以下2点となります。\n①両手でマイクを握った手\n②右手で白いティーカップを持った手(紅茶を飲んでいる想定)\n\nマイクのデザインは可能でありましたら参考資料のお衣装を参考としていただけますと幸いです。(どこかに赤い薔薇の要素を入れていれていただけたらと思います)\n\nティーカップのイメージするデザインにつきましても、参考資料に格納しておりますのでよろしければご参考にしていただけますと幸いです。\n\n使用用途は以下のとおりとなります。\n・YouTube(現在未収益、将来的に収益化の可能性あり)での配信、動画へ使用\n・Xでの宣伝活動の際の動画や画像として使用\n\nもし内容や金額等条件に合わない場合は、恐れ入りますが再送いただけますと幸いです。\n※難しい場合は①のみでも構いません。\n\nご縁がございましたら、どうぞよろしくお願いいたします！\n\n花柳\n\nhttps://drive.google.com/drive/folders/1SE4AEoiUhcS20qs2OiJa3YvBHpmS8qz9", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/343", "thumbnail_src": "https://si.imgix.net/b4b75cbe/uploads/origins/5ce910d4-d56a-4bed-b957-ef9a94a3c89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96ebf2ca7f231d9e7b50f106c3116f8", "thumbnail_srcset": "https://si.imgix.net/b4b75cbe/uploads/origins/5ce910d4-d56a-4bed-b957-ef9a94a3c89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96ebf2ca7f231d9e7b50f106c3116f8, https://si.imgix.net/b4b75cbe/uploads/origins/5ce910d4-d56a-4bed-b957-ef9a94a3c89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7c43365fecb3d5b3974460b968ef689 2x, https://si.imgix.net/b4b75cbe/uploads/origins/5ce910d4-d56a-4bed-b957-ef9a94a3c89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dc16feda060cd240b4597b999ae8fd7 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nYouTubeで活動をしている 白兎よう と申します。\nおてての素材をお見かけして、とても素敵だと思いましてので、是非市クエストしたく連絡させて頂きました！\n\n▼依頼内容\n3個依頼\n1.片手マイク\n2.両手コントローラー\n3.両手HWMK財団を持っている\n\n上記内容をお願いします。\nまた、片手のみの物は視聴者側からみて左手でお願いします。\n３に関しては資料を2個同封しておりますので、お好きな方でお願いいたします。\n\n参考資料\nhttps://drive.google.com/drive/folders/1yBQhKilYWPvDrvrHOZUjfaHKrecUM_cl?usp=drive_link\n\n和装という事で大変かと思いますが、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yBQhKilYWPvDrvrHOZUjfaHKrecUM_cl?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/342", "thumbnail_src": "https://si.imgix.net/db02cc07/uploads/origins/c047d058-724b-4a67-8d93-c1bd1a3dd63b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58e0fecff5e75e912ece9ae8e83324f9", "thumbnail_srcset": "https://si.imgix.net/db02cc07/uploads/origins/c047d058-724b-4a67-8d93-c1bd1a3dd63b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58e0fecff5e75e912ece9ae8e83324f9, https://si.imgix.net/db02cc07/uploads/origins/c047d058-724b-4a67-8d93-c1bd1a3dd63b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48e1ffa5cc838bbc8e23242de4e26ee2 2x, https://si.imgix.net/db02cc07/uploads/origins/c047d058-724b-4a67-8d93-c1bd1a3dd63b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2a7ab12bfafac58c0616f22a0dc840a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n絵の依頼をしたいのですが。\n黒い眼鏡をかけていて、目は黒く、唇の左隅にほくろがあり、睡眠不足のため目の下に大きなクマがあります。胸はぺったんこ。ネズミの耳は大きく、尻尾もある。銃、昆虫、クモ、自然、飛行機、車、チーズ、ネズミが好き。黒いシャツには \"brat \"の文字。ジャケットはオーバーサイズ。\n\nVtuber ref : https://drive.google.com/drive/folders/1b9J0DCrVKou8TmEFO4y5PJYSbBEkrx4Z?usp=sharing\n\nhttps://skeb.jp/@oteteyasan/works/50、代わりに手にチーズを持っているような私を描いてもらえますか？\n\npsdと透過背景もお願いします！\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/341", "thumbnail_src": "https://si.imgix.net/92a9f632/uploads/origins/a8459119-bd3e-49bc-9b75-5e32750b718f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27cc5bf9d6a5755347f761b9ecc5fc86", "thumbnail_srcset": "https://si.imgix.net/92a9f632/uploads/origins/a8459119-bd3e-49bc-9b75-5e32750b718f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27cc5bf9d6a5755347f761b9ecc5fc86, https://si.imgix.net/92a9f632/uploads/origins/a8459119-bd3e-49bc-9b75-5e32750b718f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8c0483b00d6af653e8ea0c0bd320bdf 2x, https://si.imgix.net/92a9f632/uploads/origins/a8459119-bd3e-49bc-9b75-5e32750b718f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e99b57b81a6a77800c3332af83f6e2e 3x", "genre": "art", "nsfw": false, "body": "おててやさん🐾様\n\nはじめまして、主にTwitchやYouTubeで配信活動をしております楚白ぱきらと申します\nこの度おててやさん🐾様のイラストを拝見し、是非自分を描いていただきたくご連絡いたしました\n詳細は以下になります\n\n【内容】\n・マイクを持った手(マイクのデザインはおまかせしますが、双葉🌱、シロイルカ、目の中の瞳孔が菱形なのでそのあたりをモチーフ、色は白・緑(瞳の色)を基調としていただけると嬉しいです！)\n・レーファ(参考資料内のシロイルカのモチーフキャラ)のぬいぐるみを抱えている手\n・人差し指を立てている手(説明するときのようなポーズ)\n※どちらも参考資料内の旧衣装でお願いします\n※料金足りるようでしたら新衣装バージョンもあると嬉しいです\n\n【使用用途】\n①VTuber活動に伴う使用全般(アイコン・ヘッダー・SNS投稿等)\n②サムネイル使用\n③収益化済動画・配信プラットフォームでの配信・動画内使用\n④案件時の宣伝や動画・配信内でのイラスト使用\n⑤FANCLUBなどでのデジタル返礼品(壁紙やヘッダーなど)\n⑥FANCLUBなどでの特定個人へのリアルグッズ返礼品\n⑦不特定多数へ展開する販売用グッズ\n※どれもおてて素材単体での使用ではなくV体と合わせての使用想定です\n\nhttps://drive.google.com/drive/folders/1gnBE8NGVj9tMMdv8S3GH_rG-lMD22a4C?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/340", "thumbnail_src": "https://si.imgix.net/ebf6c9ab/uploads/origins/b3821341-29e5-4b9f-aaf8-dbf701896961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=040b105a41d5b75e915889f18baba1c0", "thumbnail_srcset": "https://si.imgix.net/ebf6c9ab/uploads/origins/b3821341-29e5-4b9f-aaf8-dbf701896961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=040b105a41d5b75e915889f18baba1c0, https://si.imgix.net/ebf6c9ab/uploads/origins/b3821341-29e5-4b9f-aaf8-dbf701896961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4094e66f71cda18386717b7a133c14e9 2x, https://si.imgix.net/ebf6c9ab/uploads/origins/b3821341-29e5-4b9f-aaf8-dbf701896961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e565fba9b6f812f5b4b84074727d0ed1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n来年VtuberReデビュー予定の者です。\n以前もお願いしたことがあり、とても素敵なおてて素材を納品していただきましたので、是非今回もと思いリクエストに参りました。\nお願いしたいものは以下４点です。\n\n・鍵🔑を持っている手(リスナーを檻に閉じ込める設定があるため)\n　鍵のデザインは特にこだわりはないのでお任せします。\n・マイク🎤を持っている手\n・コントローラーを持つ手\n　コントローラーのデザインもお任せできればと思います。\n・ぬいぐるみを持つ手(両手)\n　ぬいぐるみデザインについては、ドライブ内を参考にしてください。\n 　アレンジ等していただいても大丈夫です。\n\n金額等足りないようでしたら再送していただけますと幸いです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1OOnNqArGJ9YA-t31vsvE7hbiy65_CdCe?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/339", "thumbnail_src": "https://si.imgix.net/bc190487/uploads/origins/570fc8e8-2e63-49b7-9fca-02017a65e191?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3170bd153725266cb25fccbc89753c5f", "thumbnail_srcset": "https://si.imgix.net/bc190487/uploads/origins/570fc8e8-2e63-49b7-9fca-02017a65e191?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3170bd153725266cb25fccbc89753c5f, https://si.imgix.net/bc190487/uploads/origins/570fc8e8-2e63-49b7-9fca-02017a65e191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95ee0a91b0c61b580832d16ed844d20d 2x, https://si.imgix.net/bc190487/uploads/origins/570fc8e8-2e63-49b7-9fca-02017a65e191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ac329a07ce6aeba2823315da519bb10 3x", "genre": "art", "nsfw": false, "body": "おててやさん様始めまして、個人勢Vtuberの雪城ひよりと申します。先生の描かれる手の素材を見て、是非ともお作りして頂きたくリクエストを送らせて頂きました。\n\n私、雪城ひよりの【両手でコントローラーを持っている素材】をお作りして頂きたいです。コントローラーの柄等はお任せ致します。\n\n頂いたイラストを配信画面やサムネイルでの使用、SNS活動等、Vtuber活動をする上での使用を考えております\nご検討よろしくお願いします\n\n参考資料\nhttps://drive.google.com/drive/folders/1cvFrejSLoiqGLL6gFW2JwcnidQjAOzkg?usp=sharing\n\n細かな部分になりますが\n・ネイルは水色\n・左手中指にシルバーで装飾無しの指輪\nがあります。\n\nご検討よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/338", "thumbnail_src": "https://si.imgix.net/c7451fe5/uploads/origins/879113ee-cfb8-43cb-9582-276cbea84a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10844fcf1b3372b3946d5f1698b17bf7", "thumbnail_srcset": "https://si.imgix.net/c7451fe5/uploads/origins/879113ee-cfb8-43cb-9582-276cbea84a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10844fcf1b3372b3946d5f1698b17bf7, https://si.imgix.net/c7451fe5/uploads/origins/879113ee-cfb8-43cb-9582-276cbea84a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a1d878e3ccfc7d19c224b1d0f4b36e1 2x, https://si.imgix.net/c7451fe5/uploads/origins/879113ee-cfb8-43cb-9582-276cbea84a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af4498a6d04c680a4000295c45b59f4f 3x", "genre": "art", "nsfw": false, "body": "おててやさん様\n\n初めまして、VTuberとして活動をしております月光雪音(つきみゆきと)と申します！\n\n以前もおててやさん様の手のアセットイラストをお願いし、とても素敵だったのでこの度新モデルになる為改めてリクエストさせていただきます。\n\n使用用途\nYouTube、Twitter(X)、Bluesky等の収益が発生する配信媒体活動(サムネイル等)、SNSへの投稿\n可能であればアセットを使用したネットプリントやチェキ等グッズの販売\n\n二つのアセットイラストを袖付きでお願い出来れば幸いです。\n①ゲームのコントローラーを持つ手 (コントローラーの色はこちらの方の色が希望です！→https://skeb.jp/@oteteyasan/works/5)\n(こちらの方のようなワンポイントがあるととても嬉しいです…！→https://skeb.jp/@oteteyasan/works/62 月光雪音のワンポイント→氷の結晶、ネモフィラのブローチ、アクアマリン等)\n②片手でマイクを持つ手\n15歳の少年VTuberの為、少年らしい手ですととても嬉しいです。\n\n上記、ご無理な内容、もしくは金額の調整が必要であればご遠慮なく再送いただけますと幸いです。\n\nお忙しい中申し訳ございませんが、もし宜しければお手隙の際にお考えいただけますと幸いです。\n何卒、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/18VpDrVt9CbAYBYIGGuHsbqacrZs79xWh", "created_at": "", "completed_at": ""}, {"path": "/@oteteyasan/works/337", "thumbnail_src": "https://si.imgix.net/f2ca4f6a/uploads/origins/f99a12e8-6719-4e8d-9035-b95862fe225f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c2a5ba1207a5219f04e56dff0924984", "thumbnail_srcset": "https://si.imgix.net/f2ca4f6a/uploads/origins/f99a12e8-6719-4e8d-9035-b95862fe225f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c2a5ba1207a5219f04e56dff0924984, https://si.imgix.net/f2ca4f6a/uploads/origins/f99a12e8-6719-4e8d-9035-b95862fe225f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12d762da511bd87dcf5246082619ec1a 2x, https://si.imgix.net/f2ca4f6a/uploads/origins/f99a12e8-6719-4e8d-9035-b95862fe225f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c3