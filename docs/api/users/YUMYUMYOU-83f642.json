.net/485d9730/uploads/origins/89971c60-ed99-4aeb-af7f-afaf331e6024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41730b38aab7d39b487a96422171aef7", "thumbnail_srcset": "https://si.imgix.net/485d9730/uploads/origins/89971c60-ed99-4aeb-af7f-afaf331e6024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41730b38aab7d39b487a96422171aef7, https://si.imgix.net/485d9730/uploads/origins/89971c60-ed99-4aeb-af7f-afaf331e6024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9062aaeb406dc5ce53f723b835bf1d7 2x, https://si.imgix.net/485d9730/uploads/origins/89971c60-ed99-4aeb-af7f-afaf331e6024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42212dcb800cb0210218fee64012ac9d 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのアートスタイルがとても好きです！私のキャラクター「ルシア」をお願いしたいです。\n\n ◆ https://sta.sh/21wrpqjlq4zi\n\n本と魔法と戦いが大好きな女の子です。自分のためになることでしか人を助けない、クールな女の子。宝石やダイヤモンドなどの宝物を見つけるのが好きで、身だしなみにも気を配っている。  \n\n彼女の衣装は自由に選べ、ポーズ・表情も自由に描くことができます。武器は任意です。ありがとうございました。\n\nhttps://sta.sh/21wrpqjlq4zi", "created_at": "", "completed_at": ""}, {"path": "/@YUMYUMYOU/works/26", "thumbnail_src": "https://si.imgix.net/a88062b9/uploads/origins/0d4638af-d23f-494a-b6aa-5728415fac73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6ee5f2459744d6685c94a2b740d806f", "thumbnail_srcset": "https://si.imgix.net/a88062b9/uploads/origins/0d4638af-d23f-494a-b6aa-5728415fac73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6ee5f2459744d6685c94a2b740d806f, https://si.imgix.net/a88062b9/uploads/origins/0d4638af-d23f-494a-b6aa-5728415fac73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8063ee57003be0d6367f7163ebee5d0c 2x, https://si.imgix.net/a88062b9/uploads/origins/0d4638af-d23f-494a-b6aa-5728415fac73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e47704b007aa315de5d1c5fa6a6ab0f 3x", "genre": "art", "