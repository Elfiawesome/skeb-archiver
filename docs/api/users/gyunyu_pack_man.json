200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0faeca80a0125e464ccfc19e9392ba3e, https://si.imgix.net/59ce0907/uploads/origins/8f8bc0f0-09df-4ad7-882c-325d91ffac47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb8b76fb35c380018120c7ee9123a4cf 2x, https://si.imgix.net/59ce0907/uploads/origins/8f8bc0f0-09df-4ad7-882c-325d91ffac47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62ea492501d7c450ed908f4066060184 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gyunyu_pack_man/works/10", "thumbnail_src": "https://si.imgix.net/d66774d7/uploads/origins/746ecc3a-76a3-4bf9-88bc-a74ae2f7ba48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b81dbc43df4f33a4fb1b491c537fdd75", "thumbnail_srcset": "https://si.imgix.net/d66774d7/uploads/origins/746ecc3a-76a3-4bf9-88bc-a74ae2f7ba48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b81dbc43df4f33a4fb1b491c537fdd75, https://si.imgix.net/d66774d7/uploads/origins/746ecc3a-76a3-4bf9-88bc-a74ae2f7ba48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61a2f88402f9bb509e90168a437b3b9f 2x, https://si.imgix.net/d66774d7/uploads/origins/746ecc3a-76a3-4bf9-88bc-a74ae2f7ba48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be1356d16ae88115bc0e60e58e2a2151 3x", "genre": "art", "nsfw": false, "body": "こんにちは。舞（マイ）・シラヌイのSF6／リアルバウト餓狼伝説2の姿でのイラストをお願いしたいです。\nhttps://i.imgur.com/4oPCPFn.jpeg\n\n彼女が座っていて、足（つま先まで）がはっきり見えるように、遮られないようにしてほしいです。\n胸も同様に、できれば隠れないようにしていただけると嬉しいです。\nどのように座ってほしいかの参考画像を添付しました。\nhttps://i.imgur.com/pJkgaE3.jpeg\n\nこの通りでなくても構いませんが、だいたいこのような座り方にしていただけると嬉しいです。\n舞には温かくて親しみやすい表情をさせ、視聴者の方を向かせてください。\nどうもありがとうございます！！", "created_at": "", "completed_at": ""}, {"path": "/@gyunyu_pack_man/works/9", "thumbnail_src": "https://si.imgix.net/c60ba073/uploads/origins/82cfd0af-f430-47bc-acc3-203dc7f6fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=362eccb8da91616f398544cdb12d3006", "thumbnail_srcset": "https://si.imgix.net/c60ba073/uploads/origins/82cfd0af-f430-47bc-acc3-203dc7f6fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=362eccb8da91616f398544cdb12d3006, https://si.imgix.net/c60ba073/uploads/origins/82cfd0af-f430-47bc-acc3-203dc7f6fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0c16544fcea7029ae08e37ea433ad0c 2x, https://si.imgix.net/c60ba073/uploads/origins/82cfd0af-f430-47bc-acc3-203dc7f6fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44df32a6b3b18b3d91bf20d271372c1d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。Xで見かけた春麗があまりにも素晴らしかったのでリクエストお願いします。\n\nコスチュームは元祖のコスチュームでポーズはジャンプして着地した時の姿で、手の感じはスパイダーマンぽいイメージで脚は蹲踞のような体勢をお願いしたいです。凛々しい表情と太腿をしっかり筋肉質に描いて欲しいです。\nあと、前垂れが捲れてレオタードが見えているセクシーな感じも入れて欲しいです。\n\n色々と面倒な内容ではございますがご検討よろしくお願いいたします。\n\nhttps://x.com/gyunyu_pack_man/status/1987324260378157507?t=DcXBAk1bPFbzEi0EGiFFsw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@gyunyu_pack_man/works/8", "thumbnail_src": "https://si.imgix.net/ca08546e/uploads/origins/abc2ba66-9f3a-4489-9672-3d42da9efbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f4548a5eec0d427e0c9c70b727ee30f", "thumbnail_srcset": "https://si.imgix.net/ca08546e/uploads/origins/abc2ba66-9f3a-4489-9672-3d42da9efbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f4548a5eec0d427e0c9c70b727ee30f, https://si.imgix.net/ca08546e/uploads/origins/abc2ba66-9f3a-4489-9672-3d42da9efbab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6aae7d0f7d3ce2974abc59a63349ae3 2x, https://si.imgix.net/ca08546e/