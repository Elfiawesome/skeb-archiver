-4db9-8b06-69b1cfb2377d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cce4053ea88ae84a7e71a5f64abba602, https://si.imgix.net/fbb620ad/uploads/origins/86cffc3b-8223-4db9-8b06-69b1cfb2377d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36e2bcdc34d8fb2d3f42cc7367d4bb07 2x, https://si.imgix.net/fbb620ad/uploads/origins/86cffc3b-8223-4db9-8b06-69b1cfb2377d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9101ca1e4818730689280f837e7212e2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@minimoji/works/48", "thumbnail_src": "https://si.imgix.net/9172f095/uploads/origins/8cbc56b8-33e1-4cb3-a631-c100245560c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc4c84abebeb04c8266dc8ee8ad8198", "thumbnail_srcset": "https://si.imgix.net/9172f095/uploads/origins/8cbc56b8-33e1-4cb3-a631-c100245560c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc4c84abebeb04c8266dc8ee8ad8198, https://si.imgix.net/9172f095/uploads/origins/8cbc56b8-33e1-4cb3-a631-c100245560c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d52d003870b175d9a8995fe68888be8e 2x, https://si.imgix.net/9172f095/uploads/origins/8cbc56b8-33e1-4cb3-a631-c100245560c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba1f04b9bfdaec3384438c84786565d1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの絵がとても好きです。どれもとても美しいです\n\nできれば、私のFFXIVキャラクターの絵をお願いしたいです～。\n\n白い肌の猫娘です。\n白い髪としっぽが特徴です。\n右目は薄い黄色、左目は薄い青色です。\n体型は細身で、胸の大きさは中くらいです。\nキュートで活発な性格\n\n衣装や外見は写真を参考にしてください。\n可愛らしく、躍動感のあるポーズをとってもらえると嬉しいです。\n細かい部分はあなたのデ