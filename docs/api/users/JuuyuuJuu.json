627-ce8b0d8d867e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77bd53a11061a5f7f47f74dbc31132bb 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nけものフレンズのvore系を描いて頂きたいです。\n構図としては、巨大化したシャチ（通常衣装）が以下のURLのような感じの構図で、真下から大きな口とたくさんの牙を見せながら飛び掛かって戦闘機を食べようとしているところをお願いします。\nその他細かな構図などはお任せしますのでよろしくお願いします！\n\n参考画像URL https://x.com/UNGFCO_Tokoma/status/1768089035158040668/photo/1\n参考画像URL2 https://www.pixiv.net/artworks/117691500\n戦闘機の参考資料　https://uswarships.jounin.jp/f_fa-mcdonnell-FA-18EF.htm", "created_at": "", "completed_at": ""}, {"path": "/@JuuyuuJuu/works/3", "thumbnail_src": "https://si.imgix.net/7c54c8e2/uploads/origins/90b15049-c99d-4b70-8abc-312c1ac30bce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f02c0b8f1ce8a340484de3956fe477bc", "thumbnail_srcset": "https://si.imgix.net/7c54c8e2/uploads/origins/90b15049-c99d-4b70-8abc-312c1ac30bce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f02c0b8f1ce8a340484de3956fe477bc, https://si.imgix.net/7c54c8e2/uploads/origins/90b15049-c99d-4b70-8abc-312c1ac30bce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87ed7f3b76b5691531cb97e84290c52a 2x, https://si.imgix.net/7c54c8e2/uploads/origins/90b15049-c99d-4b70-8abc-312c1ac30bce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f797620cd48b6485829cd25d4772db2f 3x", "genre": "art", "nsfw": false, "body": "こんにちはん\n今回はけものフレンズからカンザシフウチョウちゃんが恋してるような感じのイメージのイラストをお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@JuuyuuJuu/works/2", "thumbnail_src": "https://si.imgix.net/fc4df947/uploads/origins/8794dd6f-4c09-4b7e-9638-d041d380282f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b6d42861bd623e27ff3db5588764b9e", "thumbnail_srcset": "https://si.imgix.net/fc4df947/uploads/origins/8794dd6f-4c09-4b7e-9638-d041d380282f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b6d42861bd623e27ff3db558