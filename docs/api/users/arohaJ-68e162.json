c8cc5ae1bce1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdcfd5bc2dc0f4d5126999f07a94d657 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arohaJ/works/79", "thumbnail_src": "https://si.imgix.net/246af22f/uploads/origins/551e4367-5e86-456a-ba37-ef6fd68b7e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6152b84cd8a2712c74fa31f576902610", "thumbnail_srcset": "https://si.imgix.net/246af22f/uploads/origins/551e4367-5e86-456a-ba37-ef6fd68b7e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6152b84cd8a2712c74fa31f576902610, https://si.imgix.net/246af22f/uploads/origins/551e4367-5e86-456a-ba37-ef6fd68b7e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f1666684fb401d43af13aeafaeae614 2x, https://si.imgix.net/246af22f/uploads/origins/551e4367-5e86-456a-ba37-ef6fd68b7e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4d254440374f62a6abf5785d1200791 3x", "genre": "art", "nsfw": false, "body": "はじめまして、pixivファンタジアSOZをはじめPFに度々参加させていただいております、己道丸（きどうまる）と申します。\n回を経る毎に出来ることが増え、楽しみながら実りある経験ができて感謝しております。\n\n今回は、pixivファンタジアSOZに投稿した私のキャラクター「エノシガ」のイラストを依頼できないかと思い、リクエストしました。\n作風やシチュエーションなどはお任せしますが、芝生の競馬場か馬の要素があるヴィネット風背景であると嬉しく思います。\n\nお忙しい時もあるかと思いますが、お願いできたらうれしく思います。\nご一考のほど、どうかよろしくお願いします。\n\nキャラクター：エノシガ\nhttps://www.pixiv.net/artworks/102103314", "created_at": "", "completed_at": ""}, {"path": "/@arohaJ/works/78", "thumbnail_src": "https://si.imgix.net/71de4d0f/uploads/origins/13510511-5812-4e7b-bff1-7e758d1a58d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3be535bf5ba4acddf83a1727d1034371", "thumbnail_srcset": "https://si.imgix.net/71de4d0f/uploads/origins/13510511-5812-4e7b-bff1-7e758d1a58d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3be535bf5ba4acddf83a1727d1034371, https://si.imgix.net/71de4d0f/uploads/origins/13510511-5812-4e7b-bff1-7e758d1a58d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee03c1648a0844525a8738a9cef743ef 2x, https://si.imgix.net/71de4d0f/uploads/origins/13510511-5812-4e7b-bff1-7e758d1a58d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=441aa6f2f36a3f4cb723d3b6b56f8202 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です、初めてリクエストさせて頂きます。\nPF3が15周年と大変めでたく参加者としても幸せな気持ちです。\n今回はそちらで参加させて頂いたメルリアをお願いしたいです。\n\n砂浜で海に向かって楽しそうに歌っているシーンでお願いします。少し風が感じられると嬉しいです。\n髪の長さは正確に決めてはいないので雰囲気で長く短くして頂けたらと思います。\nその他細かな設定などもお任せいたします。\n\nお手隙の際に、ご検討よろしくお願いします。\n\n\n【参考資料】\nメルリア\nhttps://www.pixiv.net/artworks/27604964　（2，3枚目　※目は緑色でお願いします）\nhttps://www.pixiv.net/artworks/22396239　（歌っている雰囲気参考）\nhttps://www.pixiv.net/artworks/90058616　（比較的新しい絵）", "created_at": "", "completed_at": ""}, {"path": "/@arohaJ/works/77", "thumbnail_src": "https://si.imgix.net/0e7b3b90/uploads/origins/9e03ce1d-02b6-40ed-9e2d-a012f76b3edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7809329f7b5923be68ab4edea3301956", "thumbnail_srcset": "https://si.imgix.net/0e7b3b90/uploads/origins/9e03ce1d-02b6-40ed-9e2d-a012f76b3edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7809329f7b5923be68ab4edea3301956, https://si.imgix.net/0e7b3b90/uploads/origins/9e03ce1d-02b6-40ed-9e2d-a012f76b3edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e5a0cad3991e41e4f22894062ddc4a3 2x, https://si.imgix.net/0e7b3b90/uploads/origins/9e03ce1d-02b6-40ed-9e2d-a012f76b3edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6158c34b11a662a699f2611c004f4e2d 3x", "genre": "art", "nsfw": false, "body": "こんばんはarohaJ様、PFSOZでは大変楽しませていただきました！\n今回はSOZにてメインで描いたキャラの\n『聖剣担ぎのフリック』URL：https://www.pixiv.net/artworks/101998641\n『聖剣の妖精エクセウス』URL：https://www.pixiv.net/artworks/103852785\n二人が並んでいるヴィネット風のイラストをリクエストさせていただきたいです\n聖剣のデザインはこちら【https://www.pixiv.net/artworks/103852827】を採用していただけるとありがたいです！\nその他構図や背景、表情等はお任せします\nご検討の程をよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@arohaJ/works/76", "thumbnail_src": "https://si.imgix.net/b9cf61a2/uploads/origins/f8b1a697-0445-4489-9f83-467b88b16a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a67202499919b3e3fe11a022e69e88b", "thumbnail_srcset": "https://si.imgix.net/b9cf61a2/uploads/origins/f8b1a697-0445-4489-9f83-467b88b16a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a67202499919b3e3fe11a022e69e88b, https://si.imgix.net/b9cf61a2/uploads/origins/f8b1a697-0445-4489-9f83-467b88b16a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1c354a0071c3913efabcaa7628c8fc3 2x, https://si.imgix.net/b9cf61a2/uploads/origins/f8b1a697-0445-4489-9f83-467b88b16a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1caba7534c916ac51ae84bd2e0a0b354 3x", "genre": "art", "nsfw": false, "body": "明けましておめでとうございます。\npixivファンタジアFKのネームドNPC全員をお願いすることは可能でしょうか？\n（トマ・メアリシア・グレイ・エドワルド・ブレア・バト・カラスの7名）\nあまりにも人数が多いので流石に無茶な依頼だと思いますが、\n今年はPFFK10周年なので、せめて依頼文だけでも送っておこうかと！\npixivファンタジアに参加するようになってから、とても楽しい人生を過ごしています。\nたくさんの学びと興奮がありました。これまでもこれからも感謝しています。\n奇跡的に描いていただけたらクソデカ吸着ポスターにして飾ります。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@arohaJ/works/75", "thumbnail_src": "https://si.imgix.net/469888d5/uploads/origins/e8180ecc-bd73-449f-978a-2217bb68b425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a44636d471c801d381333dfed44396f4", "thumbnail_srcset": "https://si.imgix.net/469888d5/uploads/origins/e8180ecc-bd73-449f-978a-2217bb68b425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a44636d471c801d381333dfed44396f4, https://si.imgix.net/469888d5/uploads/origins/e8180ecc-bd73-449f-978a-2217bb68b425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cae7b171d3762e1d6325762ec0c7a32e 2x, https://si.imgix.net/469888d5/uploads/origins/e8180ecc-bd73-449f-978a-2217bb68b425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6d3c76a67176e857ad91622eb59979 3x", "genre": "art", "nsfw": false, "body": "arohaJ様\n\nいつもお世話になっております。\npixivファンタジアをはじめ、arohaJ様の描かれるイラストや世界観にいつも心惹かれております。\nこの度はpixivファンタジアSOZで投稿いたしました『昏翳誓掌のジラ』のカラーイラストをarohaJ様に描いていただきたくリクエスト致しました。\n\n構図などの希望はございませんが、背景に月を浮かべていただければ幸いです。\nご多忙の中恐縮ではございますが、ご検討のほどよろしくお願い致します。\n\n参考URL\nジラ【https://www.pixiv.net/artworks/103477087】", "created_at": "", "completed_at": ""}, {"path": "/@arohaJ/works/74", "thumbnail_src": "https://si.imgix.net/049f6e35/uploads/origins/ac190c21-33f3-45f9-a366-794faef8a060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a13c08191f7c8a29f570262bdbc40e", "thumbnail_srcset": "https://si.imgix.net/049f6e35/uploads/origins/ac190c21-33f3-45f9-a366-794faef8a060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a13c08191f7c8a29f570262bdbc40e, https://si.imgix.net/049f6e35/uploads/origins/ac190c21-33f3-45f9-a366-794faef8a060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1121dd2483a3753d42c856309442693 2x, https://si.imgix.net/049f6e35/uploads/origins/ac190c21-33f3-45f9-a366-794faef8a060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2604b7a92bde2d94aa9ed20817716e2b 3x", "genre": "art", "nsfw": false, "body": "arohaJさんこんにちは。pixivファンタジアのシリーズ、いつも楽しませていただいています！\n今回も素敵な世界観とキャラクター、物語をありがとうございました。\nPFSOZではプロローグが出た瞬間にゼフィリア女王陛下の魅力にやられてしまいました。PFSOZの最推しです。\n\nPFSOZの生前のゼフィリア女王陛下と、レガード院長のお二人をリクエストさせてください！\nプライベートで、気の置けない友人として談笑もしくは食事をしているシーンを描いていただきたいです。\n\nそして、も、もし可能であれば、こちらのワインを飲んでいただけると嬉しいです。\nhttps://www.pixiv.net/artworks/103438858\n王室御用達の認定を目指していたけれど、ついぞ認められることなく\n陛下の亡くなる数年前にワイナリーを閉じて生産終了した二流のワインです。\n\nよろしくおねがいいたしますッ！\n\nhttps://www.pixiv.net/artworks/103438858", "created_at": "", "completed_at": ""}, {"path"