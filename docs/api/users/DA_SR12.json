gins/ded99793-ce89-41d1-9ea1-ee6518bfdff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=476cc73d8af0c0b5cef4dc366f536d2f 2x, https://si.imgix.net/8719ae85/uploads/origins/ded99793-ce89-41d1-9ea1-ee6518bfdff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78c1922a8e3d5fd66d4c44027d2600ff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DA_SR12/works/12", "thumbnail_src": "https://si.imgix.net/045eae27/uploads/origins/09b1027d-d7e4-4384-a80e-37ba008a38ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1197b1533976453075d2ae7a6005ae5e", "thumbnail_srcset": "https://si.imgix.net/045eae27/uploads/origins/09b1027d-d7e4-4384-a80e-37ba008a38ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1197b1533976453075d2ae7a6005ae5e, https://si.imgix.net/045eae27/uploads/origins/09b1027d-d7e4-4384-a80e-37ba008a38ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e22a3fe1d263b7c8a338197f20542b0c 2x, https://si.imgix.net/045eae27/uploads/origins/09b1027d-d7e4-4384-a80e-37ba008a38ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8725b42c221255d7edf099e131b8897 3x", "genre": "art", "nsfw": true, "body": "あじゃどうも(^O^)\n\nひっそりとイラスト楽しませて貰ってます。\nあおゆか（雫）の百合エッチをお願いします。ゆかり雫ちゃんが葵ちゃんに乳首責めされるやつを…\nシュチュは雫ちゃんがゲームをしていて、構ってほしい葵ちゃんがセクハラする…みたいな。\n最初は雫ちゃんの後ろから肩とかお腹とか撫でるだけだったけど、だんだんエスカレートしていって制服たくしあげ（カーデなし）でインナーの上からとインナー下から直で乳首責めする感じで。\n雫ちゃんは葵ちゃんを無視してゲームを決め込もうとするけど、葵ちゃんのスーパーテクニックで甘い声が我慢してる口から溢れ出ちゃう…そんな感じで\n\nそれなりに仲のいいふたりが、不期遭遇百合エッチしちゃう、序奏をみたいんです。よろしくお願いします。\n\nあ、葵ちゃんも雫ちゃんと同じ制服で！\nニーソだけは脱がさぬようお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@DA_SR12/works/11", "thumbnail_src": "https://si