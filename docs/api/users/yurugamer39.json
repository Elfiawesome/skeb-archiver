。 \n\n以上です。\n\n細かい指定が多く申し訳ありませんが是非受諾して頂けると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@yurugamer39/works/103", "thumbnail_src": "https://si.imgix.net/9b3ee2c8/uploads/origins/0815cb1e-8897-44dd-ab19-879358ccd1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee32545fd7e44cf98df57c04b2156365", "thumbnail_srcset": "https://si.imgix.net/9b3ee2c8/uploads/origins/0815cb1e-8897-44dd-ab19-879358ccd1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee32545fd7e44cf98df57c04b2156365, https://si.imgix.net/9b3ee2c8/uploads/origins/0815cb1e-8897-44dd-ab19-879358ccd1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09ef99d92dace7d196f8938323a06b92 2x, https://si.imgix.net/9b3ee2c8/uploads/origins/0815cb1e-8897-44dd-ab19-879358ccd1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f5c58f65f7b467b6e4c201adb6894fc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yurugamer39/works/102", "thumbnail_src": "https://si.imgix.net/ee8c5396/uploads/origins/924b9a3d-9e0f-4cd0-a837-8622158c583d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5892524c5fc0cbf72e23ddb26325c2b", "thumbnail_srcset": "https://si.imgix.net/ee8c5396/uploads/origins/924b9a3d-9e0f-4cd0-a837-8622158c583d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5892524c5fc0cbf72e23ddb26325c2b, https://si.imgix.net/ee8c5396/uploads/origins/924b9a3d-9e0f-4cd0-a837-8622158c583d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t