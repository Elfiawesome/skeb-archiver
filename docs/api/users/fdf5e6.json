4d-bd97-f0b969abe920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a47894afa7241fff0ab536e3af8bf57, https://si.imgix.net/632dbe99/uploads/origins/40c9d305-4119-424d-bd97-f0b969abe920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cb94e72327375b284f6a675de823acd 2x, https://si.imgix.net/632dbe99/uploads/origins/40c9d305-4119-424d-bd97-f0b969abe920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7379e498a7b3cd3ad9113027ff58f5a 3x", "genre": "art", "nsfw": false, "body": "うちの子をお願いします。\n可能でしたら衣装はオリジナルでお願いします。\nhttps://privatter.me/page/65f184c83393a", "created_at": "", "completed_at": ""}, {"path": "/@fdf5e6/works/60", "thumbnail_src": "https://si.imgix.net/219aa24e/uploads/origins/5ce08c15-4f7a-4184-a9ab-54e483fb9bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07144d8f495c742b8d75d5998f30c78f", "thumbnail_srcset": "https://si.imgix.net/219aa24e/uploads/origins/5ce08c15-4f7a-4184-a9ab-54e483fb9bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07144d8f495c742b8d75d5998f30c78f, https://si.imgix.net/219aa24e/uploads/origins/5ce08c15-4f7a-4184-a9ab-54e483fb9bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0b51c55382fde7eed9d3d01d10c1dfe 2x, https://si.imgix.net/219aa24e/uploads/origins/5ce08c15-4f7a-4184-a9ab-54e483fb9bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95a982e3c26f93fc574aad169537da86 3x", "genre": "art", "nsfw": false, "body": "以前、オリジナルキャラクターのリクエストをお願いした者です。\n前回のイラストもイメージ通りでとても嬉しかったです！\n\n今回も同じキャラクターで、以前よりも成長したすがたをお願いしたいです。\n前回は少年から青年の過渡期でしたが、殆ど青年といったような。\n服装デザインなどはechigoさんのお好みでお願いいたします。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@fdf5e6/works/59", "thumbnail_src": "https://si.imgix.net/48749a7d/uploads/origins/3f8a3008-af14-4ca3-8745-6bf26654b49d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37fe42ccc310e6df6e012af82b673ea8", "thumbnail_srcset": "https://si.imgix.net/48749a7d/uploads/origins/3f8a3008-af14-4ca3-8745-6bf26654b49d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37fe42ccc310e6df6e012af82b673ea8, https://si.imgix.net/48749a7d/uploads/origins/3f8a3008-af14-4ca3-8745-6bf26654b49d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0709e110465de4363db34289f70f59f 2x, https://si.imgix.net/48749a7d/uploads/origins/3f8a3008-af14-4ca3-8745-6bf26654b49d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bba16dc3963777eb634757804d37fe6 3x", "genre": "art", "nsfw": false, "body": "以下の要素でキャラクターをお願いします。\n\n聖歌隊衣装、イメージカラー白と青、怪しげな少年、眼鏡、オカリナ。", "created_at": "", "completed_at": ""}, {"path": "/@fdf5e6/works/58", "thumbnail_src": "https://si.imgix.net/32edc4ca/uploads/origins/3bd4b742-6b14-429b-83b3-919c2d7f20dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a511abd5a89a3f2c43a9cbd49bd0782", "thumbnail_srcset": "https://si.imgix.net/32edc4ca/uploads/origins/3bd4b742-6b14-429b-83b3-919c2d7f20dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a511abd5a89a3f2c43a9cbd49bd0782, https://si.imgix.net/32edc4ca/uploads/origins/3bd4b742-6b14-429b-83b3-919c2d7f20dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0f86c466f75adcae378e32a5875768c 2x, https://si.imgix.net/32edc4ca/uploads/origins/3bd4b742-6b14-429b-83b3-919c2d7f20dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05d28d52325c1b68355fa07149274102 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのキャラクターの描き方がとても好きなので、私のオリジナルキャラクターの服をデザインしていただけませんか？彼女はちょっと風変わりで、友達や同僚と一緒に超常現象を調査するのが趣味の遊び好きな女の子です。\n\nヘアアクセサリーのデザインは自由で、髪型を少し変えることもできますが、彼女の参考に近い髪型でお願いします。ジャケットを着た彼女をデザインされた服装で描くかどうかは、あなたが決めてください。制服のジャケットの下に着る服のデザインをお願いします。ジャケットを着る場合は、ジャケットを着ない場合の衣装も描いてください。キャラクターの詳細については、参考資料をご覧ください。\n\nもし問題があったり、量が足りないようでしたら、適切な量をご提案ください。ご検討のほど、よろしくお願いいたします！\n\nhttps://www.notion.so/koiyuu/VESPERS-Talia-Silverthorn-d25553c0cdd04c7dacc644f39cc378d1?pvs=4", "created_at": "", "completed_at": ""}, {"path": "/@fdf5e6/works/57", "thumbnail_src": "https://si.imgix.net/04176cb3/uploads/origins/b58050d3-cac4-4ab2-b69b-2d57e375d9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57e9c07684fe19925f5e69af02e9d4d7", "thumbnail_srcset": "https://si.imgix.net/04176cb3/uploads/origins/b58050d3-cac4-4ab2-b69b-2d57e375d9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57e9c07684fe19925f5e69af02e9d4d7, https://si.imgix.net/04176cb3/uploads/origins/b58050d3-cac4-4ab2-b69b-2d57e375d9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=090ef7c872a71802fd6f117cc40a3480 2x, https://si.imgix.net/04176cb3/uploads/origins/b58050d3-cac4-4ab2-b69b-2d57e375d9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=015afcc1b27617c1e46cf32a09597cdc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。echigoさんの描かれる男性キャラクターの身体つきや大人っぽい雰囲気、イラスト全体を構成する圧倒的な格好良さに一目惚れしてしまい、この度ぜひ貴方様の絵柄でTRPGの自探索者を拝見したいと思い、リクエスト失礼させていただきました。\n\nhttps://skeb.jp/@fdf5e6/works/42\nhttps://skeb.jp/@fdf5e6/works/47\n\n過去skeb作品のこちらのようなエフェクトがついた格好いい立ち絵が本当に素敵でしたので今回はもしよろしければクトゥルフ神話TRPG「胡桃炸裂症候群」のHO刑事で通過したPCの全身立ち絵差分を描いていただきたいです。\n\n衣装やポーズについては、先生のデザインが大好きなので、新しいスーツですととても喜びますが、資料の中にある衣装でもどちらでもうれしいのでお任せしたいです。金額の範囲内で可能な限り描写していただけたら幸いです。また基本的に男性としては可愛らしい雰囲気のキャラクターなのですが今回はかっこいい一面がみてみたい…！という趣旨で依頼させていただきましたので格好いい雰囲気ですとすごく嬉しいです。\n\n■キャラクターのプロフィール\n•30歳、男、顔がとても良い。\n•隠れている方の目の色は黄色でオッドアイ。\n•笑ったり泣いたり照れたり、感情表現が豊か。\n•基本的にツンデレ気質ですが信用した人にはデレが多くなります。\n•戦闘で扱うのは主に拳銃(ニューナンブM60)。\n•背が小さくてかなりの童顔。初見でいつも高校生に間違われていますが成人している。\n•本人は背が小さいのを気にしています。\n•デザインにおいて不明な点がございましたら簡略化等ご自由に描いていただいて大丈夫です。\n\nもしもお受けいただけるのであれば描いていただいた旨を記載の上、個人観賞用、ココフォリア上での駒としての使用、Twitterアイコンなどに使用させていただきたく思いますが、サイズ等はご自由にしていただきたいです。\n\n金額が足りない等ありましたら再送またはキャンセルしてください。ご縁がありましたら何卒宜しくお願い致します…！  \n\nhttps://www.dropbox.com/sh/fjz7a3bg52erdxn/AABkVOBrkc5xbZURGQDFeLEra?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@fdf5e6/works/56", "thumbnail_src": "https://si.imgix.net/48d04183/uploads/origins/d1b3ca24-27bb-426a-a7c0-daff49ddf6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bedc68c54b7a35de8e61f5ff2c095b3", "thumbnail_srcset": "https://si.imgix.net/48d04183/uploads/origins/d1b3ca24-27bb-426a-a7c0-daff49ddf6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bedc68c54b7a35de8e61f5ff2c095b3, https://si.imgix.net/48d04183/uploads/origins/d1b3ca24-27bb-426a-a7c0-daff49ddf6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3791e6423a357391448931021916d622 2x, https://si.imgix.net/48d04183/uploads/origins/d1b3ca24-27bb-426a-a7c0-daff49ddf6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40d7bbfb5e2ab5985256a2aeef4743b5 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nいつも素敵なイラストやYouTubeを拝見しています。\n\n今回は、私が飼っている猫をモチーフにした少年または青年のキャラクターのイラストを描いて頂きたいです。\n\n世界観、構図やデザインはechigoさんに是非お任せしたいです…！\n猫耳や尻尾は、デザインする際に生えていても生えていなくても大丈夫です。\nもし可能であればで良いのですが、設定画も拝見できると嬉しいです。\n描いていただいたイラストはスマホの待受や観賞用に使用させていただければと思います。\n（skebの依頼を送るのが初めてなので、不備がありましたら再送依頼をいただければと思います）\nご検討の程、どうぞよろしくお願いします。\n\n性別　オス\n名前　ラテ\n年齢　3歳（人間だと28歳くらいですが、反映しなくても大丈夫です）\n品種　スコティッシュフォールド　長毛種\n好きなこと… 寝ること、窓から空を眺めること、チュールをもらうこと\n苦手なこと… 初対面の人間は苦手、首輪をつけるのも苦手\n\nhttps://drive.google.com/drive/folders/1IDZWPa_bybztRGRy13-VUrnq0YKyTu65", "created_at": "", "completed_at": ""}, {"path": "/@fdf5e6/works/55", "thumbnail_src": "https://si.imgix.net/a6bc6a84/uploads/origins/32161d20-d927-46b7-b910-6948db60166d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6051056d1997cc6cc2aee7bce7b61ed", "thumbnail_srcset": "https://si.imgix.net/a6bc6a84/uploads/origins/32161d20-d927-46b7-b910-6948db60166d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6051056d1997cc6cc2aee7bce7b61ed, 