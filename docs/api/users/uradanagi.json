leted_at": ""}, {"path": "/@uradanagi/works/17", "thumbnail_src": "https://si.imgix.net/875022d3/uploads/origins/8c0bbe33-8665-4b13-881e-897f1c381a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6865510307b106f805dd4c2083ec8517", "thumbnail_srcset": "https://si.imgix.net/875022d3/uploads/origins/8c0bbe33-8665-4b13-881e-897f1c381a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6865510307b106f805dd4c2083ec8517, https://si.imgix.net/875022d3/uploads/origins/8c0bbe33-8665-4b13-881e-897f1c381a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aef314838e7a1247820e10dccc8f564d 2x, https://si.imgix.net/875022d3/uploads/origins/8c0bbe33-8665-4b13-881e-897f1c381a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14fb4cdc52f658934f3802eb3d102344 3x", "genre": "art", "nsfw": true, "body": "こんばんは、オリジナルキャラクターを描いてほしいです。https://www.notion.so/tacocatpatron/Autumn-ee9b273eea5d459ebaf3ccc2949f6010。\n\n褐色の大きなペニスが彼女の頭の上に置かれている。彼女は欲情してそれを見つめている。片手でシャフトを撫で、もう片方の手でボールを撫でている。ペニスの先端から精液が漏れている。\nhttps://x.com/uradanagi/status/1761077248453656958\nhttps://x.com/uradanagi/status/1740754895135994150", "created_at": "", "completed_at": ""}, {"path": "/@uradanagi/works/16", "thumbnail_src": "https://si.imgix.net/1d95009d/uploads/origins/be89aa52-ad35-448f-8c20-981ccc91238e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=982d9969989436d66f116b9f90dc982d", "thumbnail_srcset": "https://si.imgix.net/1d95009d/uploads/origins/be89aa52-ad35-448f-8c20-981ccc91238e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=982d9969989436d66f116b9f90dc982d, https://si.imgix.net/1d95009d/uploads/origins/be89aa52-ad35-448f-8c20-981ccc91238e?bg=%23fff&auto=format%2Ccompress