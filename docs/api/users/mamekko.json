-4ec3-9530-29f48548dd12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ebd5bdc557a2aaebba67a3309d2301a", "thumbnail_srcset": "https://si.imgix.net/6babca70/uploads/origins/3bbcb9c5-e9a5-4ec3-9530-29f48548dd12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ebd5bdc557a2aaebba67a3309d2301a, https://si.imgix.net/6babca70/uploads/origins/3bbcb9c5-e9a5-4ec3-9530-29f48548dd12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9944258363ca1d46dff7c018e4bd276 2x, https://si.imgix.net/6babca70/uploads/origins/3bbcb9c5-e9a5-4ec3-9530-29f48548dd12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dbc241773db06b94c3ef487f96324ee 3x", "genre": "art", "nsfw": true, "body": "天地と鷲羽ちゃんを絡めた作品がいいな。天地は鷲巣を抱きしめて、恋人同士になる準備をしている。天地は下着だけを身につけ、鷲羽はストッキング、パンティ、ブラジャー、ナースハット、ラテックス手袋など、ナース服の下の下着を身につける。", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/25", "thumbnail_src": "https://si.imgix.net/1d507375/uploads/origins/ac53c1cc-8bd4-4725-9a54-973e3f0c3ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=564528aceed25f2cf6ef805a413e205d", "thumbnail_srcset": "https://si.imgix.net/1d507375/uploads/origins/ac53c1cc-8bd4-4725-9a54-973e3f0c3ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=564528aceed25f2cf6ef805a413e205d, https://si.imgix.net/1d507375/uploads/origins/ac53c1cc-8bd4-4725-9a54-973e3f0c3ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74cb090c2afc27d865a372ae7a1b45f3 2x, https://si.imgix.net/1d507375/uploads/origins/ac53c1cc-8bd4-4725-9a54-973e3f0c3ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c2bb4eb7abe82e6e75f5841f96de264 3x", "genre": "art", "nsfw": false, "body": "こんにちは、mamekko先生！\n\n九羅密・美星とエクセレ・ブロウニングの衣装交換をお願いしたいです。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/24", "thumbnail_src": "https://si.imgix.net/e2f38060/uploads/origins/50cb809a-2d9c-433d-97bc-f8843d9b1676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af0a8ef4fd801be5cfef578fccf414b0", "thumbnail_srcset": "https://si.imgix.net/e2f38060/uploads/origins/50cb809a-2d9c-433d-97bc-f8843d9b1676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af0a8ef4fd801be5cfef578fccf414b0, https://si.imgix.net/e2f38060/uploads/origins/50cb809a-2d9c-433d-97bc-f8843d9b1676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=085de8bff5e525243381310762cb2fa4 2x, https://si.imgix.net/e2f38060/uploads/origins/50cb809a-2d9c-433d-97bc-f8843d9b1676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=183f5d79565d63a1c576b0dfbeebfe20 3x", "genre": "art", "nsfw": true, "body": "以前の依頼の続きが欲しいんだけど、具体的には、天地がテーブルに縛り付けられ、女の子たちが彼を診察する準備をしているところ。今回は、ササミとミホシが天地の胸の上に横たわり、両手で天地を撫でる。天地は呼吸が荒くなっている。\n\nこれは示唆的すぎるかもしれないので、この部分を含めるかどうかはあなたの判断に任せます。何組かの手袋をはめた手が、天地のお腹や骨盤をつついたり、突いたり、引っ張ったりする。\n\nhttps://drive.google.com/drive/folders/1-iUmNZ4yGbgRF5QrQz7TG_qI2DYHAVed", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/23", "thumbnail_src": "https://si.imgix.net/8f17aef5/uploads/origins/9f2d0d25-a001-4313-9931-89d0d0c8e62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc1a1876ef5c7ba441895eee4af7e45", "thumbnail_srcset": "https://si.imgix.net/8f17aef5/uploads/origins/9f2d0d25-a001-4313-9931-89d0d0c8e62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc1a1876ef5c7ba441895eee4af7e45, https://si.imgix.net/8f17aef5/uploads/origins/9f2d0d25-a001-4313-9931-89d0d0c8e62c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c9cc29234e4ca632465ab0f882d3ca3 2x, https://si.imgix.net/8f17aef5/uploads/origins/9f2d0d25-a001-4313-9931-89d0d0c8e62c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05cd489d06122680515a44320223a3f3 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n前回の配信 https://skeb.jp/@mamekko/works/20 を拝見しました。\n続きをお願いしたいです。遼子も鷲羽もスケバン不良娘としてもう一度見てみたいです。また、映像が写真に見えるという副テーマも好きです。\n\nこのリクエストには、前のリクエスト主も賛同してくれています。\n\nシナリオは、授業をサボって学校の屋上でタバコを吸うというもの。\n\n私の案は以下の通りである。\n写真1：涼子と鷲羽が屋上でタバコを吸う。\n写真2：涼子と鷲羽は、誰かが自分たちの写真をこっそり撮っていることに気づく。\n写真3：涼子と鷲羽は怒り、撮影者のところへ向かう。\n写真4：床に落とされたカメラからのアングル。\n\n金額が足りない場合は修正をお願いします。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/22", "thumbnail_src": "https://si.imgix.net/83ff9a4c/uploads/origins/b75c6cb3-d098-45dc-a1f0-d24541f4ee97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca1dcca902b792e68d055efadd736f4", "thumbnail_srcset": "https://si.imgix.net/83ff9a4c/uploads/origins/b75c6cb3-d098-45dc-a1f0-d24541f4ee97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca1dcca902b792e68d055efadd736f4, https://si.imgix.net/83ff9a4c/uploads/origins/b75c6cb3-d098-45dc-a1f0-d24541f4ee97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f18ebb0f6033377de0224c59b2a0517 2x, https://si.imgix.net/83ff9a4c/uploads/origins/b75c6cb3-d098-45dc-a1f0-d24541f4ee97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29418f5cb55c3c810f428ebaf345d812 3x", "genre": "art", "nsfw": true, "body": "鷲羽が天地からDNAサンプルを採取する場面をお願いしたい。鷲羽がまずゴム手袋をはめ、それから天地にフルコースを与え始めるのを後ろから見るだけでいい。\n\nポーズとアングルの参考はこちら：\nhttps://drive.google.com/file/d/1P4w85rZZSEcsCOCliVhqn_ijSXutO7ic/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/21", "thumbnail_src": "https://si.imgix.net/8b1bd1d3/uploads/origins/e1b386ac-8195-4868-af82-2e8ffb268c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f941a653a2fa7fc57b384f11b4a83703", "thumbnail_srcset": "https://si.imgix.net/8b1bd1d3/uploads/origins/e1b386ac-8195-4868-af82-2e8ffb268c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f941a653a2fa7fc57b384f11b4a83703, https://si.imgix.net/8b1bd1d3/uploads/origins/e1b386ac-8195-4868-af82-2e8ffb268c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b7341e39586394e9a2b1db9ab302ab0 2x, https://si.imgix.net/8b1bd1d3/uploads/origins/e1b386ac-8195-4868-af82-2e8ffb268c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6698e6124372f2ecb215fe609a034824 3x", "genre": "art", "nsfw": false, "body": "こんにちは以下の内容でリクエストさせていただきますよろしくご検討ください\n\nキャラ：\n天地無用！より魎呼　\n聖ルミナス女学院よりシャノン・デ・パイ（身長１７５～１７８ｃｍ程度　22歳＜自称2万22歳＞）\n\n魎呼にシャノンを見て言いそうなセリフをつけてください例えば「あたしより背も胸もでかい・・」とか「お前、阿重霞というより美星に似てる」等。この例をそのまま使っていただいても構いません\n以下シャノンの表情・制服等設定ですgif画像有ります一時停止して見てください\nhttps://twitter.com/KRANRSYFMAI/status/1411346031166459906\nhttps://twitter.com/KRANRSYFMAI/status/978996663095185409\nhttps://twitter.com/KRANRSYFMAI/status/1663558103672197122", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/20", "thumbnail_src": "https://si.imgix.net/e542f6d3/uploads/origins/cbbbedf0-eb7e-4ff3-9e47-b574df4771f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d225c805415f2fb26c7df813cb085a6f", "thumbnail_srcset": "https://si.imgix.net/e542f6d3/uploads/origins/cbbbedf0-eb7e-4ff3-9e47-b574df4771f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d225c805415f2fb26c7df813cb085a6f, https://si.imgix.net/e542f6d3/uploads/origins/cbbbedf0-eb7e-4ff3-9e47-b574df4771f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7b7b63049002471a7580b78c4c3729f 2x, https://si.imgix.net/e542f6d3/uploads/origins/cbbbedf0-eb7e-4ff3-9e47-b574df4771f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8092be5284b37a7a08f9c0db2b125dd1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私は少し前にあなたの作品を発見し、私はあなたの天地無用アートワークが本当に好きです。私はこのシリーズの大ファンなんです。\n\n天地無用に登場する涼子と鷲羽をスケバン/助平な不良少女に見立てて、全身で描いて欲しいです。背景自体は1980年代をテーマにした色でも構いません。腕組みのポーズでも、バットや木刀のような武器を持った姿でもOKです。表情は中性的なものから、少し怒ったようなものまであります。服装は、鷲羽の服は白、リョーコは黒でお願いします。\n\nhttps://drive.google.com/drive/folders/13lS7v4HNLb7K2pI1MBiTDpbT_WRz_hex?usp=share_link\n\nお忙しい中、どうもありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/19", "thumbnail_src": "https://si.imgix.net/7494b294/uploads/origins/adc92fe7-69e7-478f-b7d5-71cba404bdd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e0e17a57ef0e3608f4d561596160a6", "thumbnail_srcset": "https://si.imgix.net/7494b294/uploads/origins/adc92fe7-69e7-478f-b7d5-71cba404bdd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e0e17a57ef0e3608f4d561596160a6, https://si.imgix.net/7494b294/uploads/origins/adc92fe7-69e7-478f-b7d5-71cba404bdd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc72f3c1c77101606808a95c31c9cc76 2x, https://si.imgix.net/7494b294/uploads/origins/adc92fe7-69e7-478f-b7d5-71cba404bdd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6fd58400f7991f4071816a29795a1b4 3x", "genre": "art", "nsfw": false, "body": "5円玉で見る人に催眠術をかけるノースリーブ姿のNARUTOの春野サクラを描いていただけませんか？\n\n@@ 目で邪悪な笑顔を追加するだけです。\n\nマシューより Twitter", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/18", "thumbnail_src": "https://si.imgix.net/9059336c/uploads/origins/db6e3ea7-a23f-4660-a233-874f4b0e303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd7fcc5fa6fde4ce21392934705add18", "thumbnail_srcset": "https://si.imgix.net/9059336c/uploads/origins/db6e3ea7-a23f-4660-a233-874f4b0e303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd7fcc5fa6fde4ce21392934705add18, https://si.imgix.net/9059336c/uploads/origins/db6e3ea7-a23f-4660-a233-874f4b0e303d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1192272161be40f31a5f1405452ff71e 2x, https://si.imgix.net/9059336c/uploads/origins/db6e3ea7-a23f-4660-a233-874f4b0e303d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0baab49bc051c76556b2e56eb6b9b162 3x", "genre": "art", "nsfw": true, "body": "こんにちわ！まめ先生のイラスト、いつも楽しみに拝見させていただいています。 今回描いていただきたいイラストはVライバー「月銀緤」さん(@setsu_bond)です。 IRIAMで配信活動をされている方です。  お願いしたいイラストは横長のYoutubeのサムネイルやPCの壁紙に使用できるようなものを、 お願いしたいと思っています。状況は仕事中の緤さん、彼女のテレワーク環境は押し入れの中段を無くしてそこにこもっているとの事です。パソコンに向かって仕事中の姿をお願いします。普段コンタクトかメガネらしいので、メガネ差分も頂きたいです。タバコは吸ってても吸ってなくてもいいです(喫煙者で吸うのは電子らしいけど)\n配信用サムネイルに使用いただく可能性がありますことをご許可いただけると幸いです。 また、キャラクター、宛名はレイヤー分けしておいていただけると大変ありがたいです。 ご検討を宜しくお願い致します。\n\nhttps://twitter.com/setsu_bond/status/1539961277048508417?s=46&t=RZTkff1SIbgSMS-2dlxkMw", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/17", "thumbnail_src": "https://si.imgix.net/fd5289ba/uploads/origins/a5017226-ad82-496c-b50b-5139c64e547c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74fa202f856ee7027c3918b741fcfa9", "thumbnail_srcset": "https://si.imgix.net/fd5289ba/uploads/origins/a5017226-ad82-496c-b50b-5139c64e547c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74fa202f856ee7027c3918b741fcfa9, https://si.imgix.net/fd5289ba/uploads/origins/a5017226-ad82-496c-b50b-5139c64e547c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e13e0a54e1fcd6431dc7f3f5822423ab 2x, https://si.imgix.net/fd5289ba/uploads/origins/a5017226-ad82-496c-b50b-5139c64e547c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d6c564d21e51c504152eb9f042b4cc6 3x", "genre": "art", "nsfw": true, "body": "こんにちは、マメさん。またナースの作品をお願いしたいと思っていました。鷲羽と砂沙美がベッドに横たわり、見る人を見上げるようなイメージです。二人が着ているのは、参考までに特別なナース服です。鷲羽の腕は砂沙美に巻きつき、もう片方の手は視聴者の方に伸びています。砂沙美は鷲羽の側にいて、鷲羽の体に抱きついたり寄り添ったりしています。また、鷲羽の下着に手を入れて、砂沙美が鷲羽の様子をうかがうというのもいいなと思いますが、あまりに淫らすぎるということであれば、それはそれで結構です。\n\nポーズの参考はこちらhttps://gelbooru.com/index.php?page=post&s=view&id=3901606&tags=reaching_towards_viewer+lying+2girls+。\n\n衣装はこちら（https://gelbooru.com/index.php?page=post&s=view&id=6570246&tags=florence_nightingale_%28trick_or_treatment%29_%28fate%29）。\n\n(ブーツは履かず、ストッキングの下を見せるだけにしてほしいです）", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/16", "thumbnail_src": "https://si.imgix.net/7ddf8c10/uploads/origins/143d19b5-59da-4329-b9ed-c1b9245ef90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d41b354ffe4e1885125e0b7f7e5fc87", "thumbnail_srcset": "https://si.imgix.net/7ddf8c10/uploads/origins/143d19b5-59da-4329-b9ed-c1b9245ef90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d41b354ffe4e1885125e0b7f7e5fc87, https://si.imgix.net/7ddf8c10/uploads/origins/143d19b5-59da-4329-b9ed-c1b9245ef90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1604c519a99dc3d8d20efd62e5a39c57 2x, https://si.imgix.net/7ddf8c10/uploads/origins/143d19b5-59da-4329-b9ed-c1b9245ef90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73b544f416967a8a4cfb4a199bac101d 3x", "genre": "art", "nsfw": true, "body": "いつもありがとうございます。父君（とーくん）と申します。\n毎回最高の作品に仕上げて下さるので、またまたお願いしたく\nリクエストさせていただきました。。\n\nしばらくリクエスト再開するとTwitterで見かけたのでお願いしました。\n\nリクエスト内容に不備がないようでしたら、どうぞよろしくお願いします。\n\n□作品名\n　神秘の世界エルハザード　ＯＶＡ\n　異世界の聖機師物語\n\n□キャラクター\n　アレーレ・レレエライル\n　ワウアンリー・シュメ\n\n□シチュエーション\n　ワウもアレーレも最高だったので、今回は2人の絡み的なものをお願いしたいです。\n　二人がくんずほぐれつ・・とまではダメだとは思いますが、二人が寄り添うもしくは\n　頬すり合うみたいなイメージで\n\n　　◆ワウの方は、アレーレが普段の人以上にコミュニケーションを取ってくるのをうれしくも\n　　　ちょっとボディタッチが過剰だけど・・まぁいいか位の感じでお願いします。\n\n　　◆アレーレの方は、なかなかに・・そう、なかなかに性的な興奮を持ってしかも揉んだり\n　　　舐めたり触ったりそれ以上もっ！と思ってワキワキしてキちゃってる感じでお願いします。\n\n□その他希望\n　程よく育った体をしている二人です。\n　もちろん、あまりにも局部が見えまくっちゃってるとかNGとは思いますが\n　服装は是非ともエルハザードでアレーレが着ていた感じの貫頭衣でお願いします。\n\n　エルハザードの世界の方へ行ってしまったワウがアレーレに助けられて貫頭衣を\n　着せてくれるのだけども、アレーレとしては助ける以外の違う意味も存分にあった！！\n　・・みたいな感じで作ってくださると幸いです。\n　\n　あと、もちろん！もちろんではございますがワウがすごく敏感で感じすぎてしまうような\n　シチュエーションに移行してもこちらとしては大丈夫ですので、大丈夫ですので\n　なにとぞ・・なにとぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/15", "thumbnail_src": "https://si.imgix.net/d07d804c/uploads/origins/5c888dfd-827e-462e-9931-a8d8a0dd4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ddb662650e9214e743ceeebef46f58b", "thumbnail_srcset": "https://si.imgix.net/d07d804c/uploads/origins/5c888dfd-827e-462e-9931-a8d8a0dd4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ddb662650e9214e743ceeebef46f58b, https://si.imgix.net/d07d804c/uploads/origins/5c888dfd-827e-462e-9931-a8d8a0dd4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cfa84417588f83740c2ce5a3af322f8 2x, https://si.imgix.net/d07d804c/uploads/origins/5c888dfd-827e-462e-9931-a8d8a0dd4d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f3cd76cc45df356c0b262b60b70294f 3x", "genre": "art", "nsfw": false, "body": "ミュージカル「ロッキー・ホラー・ピクチャー・ショー」をモチーフにした風景画をお願いします。私が欲しいのは、「天地無用！」のキャラクターです。白美涼子、白美鷲、ワハンリーシュメ、雪音メア、マリアナナドン、キアイアフラン、ラシャラアース、リチアポチーナです。\n\nマリアと雪音は、キャスト写真のような画風が好きです。\n\nhttps://i.pinimg.com/736x/6a/f0/8b/6af08babf1f43d5f8962c2620284d6e6--japanese-horror-japanese-film.jpg", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/14", "thumbnail_src": "https://si.imgix.net/ef87e605/uploads/origins/6586b2d8-52d3-47a0-acaf-504bcfa18160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33c22d4acec3d5d4094aa06b3ac79cbd", "thumbnail_srcset": "https://si.imgix.net/ef87e605/uploads/origins/6586b2d8-52d3-47a0-acaf-504bcfa18160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33c22d4acec3d5d4094aa06b3ac79cbd, https://si.imgix.net/ef87e605/uploads/origins/6586b2d8-52d3-47a0-acaf-504bcfa18160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e068c53b7a24d15d9079273ba22a2277 2x, https://si.imgix.net/ef87e605/uploads/origins/6586b2d8-52d3-47a0-acaf-504bcfa18160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=961021345a35e46ba03f56c9673ca8a5 3x", "genre": "art", "nsfw": false, "body": "ゴム手袋をはめた看護師として、涼子、鷲羽、美星、アユカ、砂沙美が登場する通信が欲しいです。彼らは天地の周りを取り囲み、彼の体を調べる準備をしています。左から、手袋をはめる涼子、サンプルを採取する瓶を持つ砂沙美、手術用ライトを調整するあゆか、天地にからみつく鷲羽、クリップボードを持ちながら温かく微笑む三星。\n\nhttps://gelbooru.com/index.php?page=post&s=view&id=5465009", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/13", "thumbnail_src": "https://si.imgix.net/a8694454/uploads/origins/529be3e3-c07a-4218-89a4-91730f07cb1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ec4fc25019d9eb294531b465846663d", "thumbnail_srcset": "https://si.imgix.net/a8694454/uploads/origins/529be3e3-c07a-4218-89a4-91730f07cb1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ec4fc25019d9eb294531b465846663d, https://si.imgix.net/a8694454/uploads/origins/529be3e3-c07a-4218-89a4-91730f07cb1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791598bfddcd95607e119920bd26cf36 2x, https://si.imgix.net/a8694454/uploads/origins/529be3e3-c07a-4218-89a4-91730f07cb1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bc9fe9238bd51a11d127ddb42be7ec9 3x", "genre": "art", "nsfw": false, "body": "IRIAM内のライバー カニさんをお願いします。衣装を浴衣でカニ柄、いい大きさのカニがちりばめられてるような感じで\n背景はあってもなくてもいいのですが、夏祭りに来てるような感じ、うちわを扇ぎながら人混みを歩いてるようなと言えば分かりますでしょうか\n描いていただく際には、うちわでなくてもいいですがなにか持たしていただけると嬉しいです綿菓子、りんご飴とかね\n\nちなみに、カニさんは下記URLのTokiプロダクションに所属するライバーさんです\n\nhttps://toki-production.com/members-ka/kani", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/12", "thumbnail_src": "https://si.imgix.net/b3f460f7/uploads/origins/f2af9c46-b96f-489f-9860-d9d61b1f8fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=977f4e4db2392086c45f04b94def6a83", "thumbnail_srcset": "https://si.imgix.net/b3f460f7/uploads/origins/f2af9c46-b96f-489f-9860-d9d61b1f8fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=977f4e4db2392086c45f04b94def6a83, https://si.imgix.net/b3f460f7/uploads/origins/f2af9c46-b96f-489f-9860-d9d61b1f8fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a87e2a7baa0c657f1f202c4579fc6906 2x, https://si.imgix.net/b3f460f7/uploads/origins/f2af9c46-b96f-489f-9860-d9d61b1f8fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e20ab77b4d6543b273e9dfb372d839b9 3x", "genre": "art", "nsfw": false, "body": "まめさん、こんにちは。\n\nミュージシャンをテーマにした画像を作っていただけませんか？キャイア・フラン、ワウアン・リー・シュメ、白眉魎呼、リョーコ・バル。\n白眉鷲羽、リョーコ・バルタ。キャラクターは魅惑的でも、きわどいものでも、挑発的でも、コメディでも構いません。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/11", "thumbnail_src": "https://si.imgix.net/12d845e9/uploads/origins/66cbb7f0-9c09-4a03-b2bb-601394612f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d9f33a0ff27e783f72f5d4463ad124d", "thumbnail_srcset": "https://si.imgix.net/12d845e9/uploads/origins/66cbb7f0-9c09-4a03-b2bb-601394612f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d9f33a0ff27e783f72f5d4463ad124d, https://si.imgix.net/12d845e9/uploads/origins/66cbb7f0-9c09-4a03-b2bb-601394612f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70e4a71aaae4145634f7a0a74c7fbad7 2x, https://si.imgix.net/12d845e9/uploads/origins/66cbb7f0-9c09-4a03-b2bb-601394612f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05c79164940f8a1e3741b6f1b84dbe8c 3x", "genre": "art", "nsfw": false, "body": "2回目お願いさせていただきます。父君（とーくん）と申します。\n連続でお願いするとやらしいかな？と思いちょっと間を空けました。\n\nTwitterで「今年分止めるかも」とおっしゃっていたので、来年納品でもかまわない前提で\nお願いしました。\n\nリクエスト内容に不備がないようでしたら、どうぞよろしくお願いします。\n\n□作品名\n　神秘の世界エルハザード　ＯＶＡ\n\n□キャラクター\n　アレーレ・レレエライル\n\n□シチュエーション\n　OVAのエンディングに、杖の力で誠が現代に戻ってきたのに勝手についてきたのかアレーレが\nセーラー服でアイスを食べているシーンがあったので\n　「夏」に「夏セーラー服」で「アイスを食べている」感じでお願いします。\n\n□その他希望\n　元気たっぷりアレーレですが、エルハザードとは違って湿気の多い日本の夏にちょっと\nだれつつアイスを頬張っている。もしくは舐めている感じが高まります。\n　セーラー服というだけでハイテンションですが、もし・・もし、なにか見えてしまいそうに\nなった場合はストライプ柄でお願いしますっ！", "created_at": "", "completed_at": ""}, {"path": "/@mamekko/works/10", "thumbnail_src": "https://si.imgix.net/c982b413/uploads/origins/6f3fda9c-6