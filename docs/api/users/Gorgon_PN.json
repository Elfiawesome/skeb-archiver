w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=217b391a69d9ae76ebf22627ac9957fe 2x, https://si.imgix.net/e25b1124/uploads/origins/86c07643-5e1c-4eb4-a330-11dc94488cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09149c1d68feda243b032cbdb3707b5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/14", "thumbnail_src": "https://si.imgix.net/bbe5d6bf/uploads/origins/1928f723-47ae-4edb-85a1-c26482807ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=367794e4cbb9662685ce858b40f4660c", "thumbnail_srcset": "https://si.imgix.net/bbe5d6bf/uploads/origins/1928f723-47ae-4edb-85a1-c26482807ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=367794e4cbb9662685ce858b40f4660c, https://si.imgix.net/bbe5d6bf/uploads/origins/1928f723-47ae-4edb-85a1-c26482807ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faa425f61db7ea82847bca1da8de5a4d 2x, https://si.imgix.net/bbe5d6bf/uploads/origins/1928f723-47ae-4edb-85a1-c26482807ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa3b19b8598607b84557b6a2953b578f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/13", "thumbnail_src": "https://si.imgix.net/c55b5718/uploads/origins/aecdfffc-2970-4898-8a24-9a8e8aba54ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7667cf6ee1127b6382f0548aad2b701", "thumbnail_srcset": "https://si.imgix.net/c55b5718/uploads/origins/aecdfffc-2970-4898-8a24-9a8e8aba54ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7667cf6ee1127b6382f0548aad2b701, https://si.imgix.net/c55b5718/uploads/origins/aecdfffc-2970-4898-8a24-9a8e8aba54ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d160d5c255d9abe3f2325324fafeeabb 2x, https://si.imgix.net/c55b5718/uploads/origins/aecdfffc-2970-4898-8a24-9a8e8aba54ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de41d9839af9cd7b68ad8b3ee0b2590 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/12", "thumbnail_src": "https://si.imgix.net/2e035575/uploads/origins/c5615c5f-594a-455a-b045-564b6c68e46b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec4ede2c0622923c8d25f0c36c3726b", "thumbnail_srcset": "https://si.imgix.net/2e035575/uploads/origins/c5615c5f-594a-455a-b045-564b6c68e46b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec4ede2c0622923c8d25f0c36c3726b, https://si.imgix.net/2e035575/uploads/origins/c5615c5f-594a-455a-b045-564b6c68e46b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a4c4ebb216eb1d123aa0d321e2b9ab6 2x, https://si.imgix.net/2e035575/uploads/origins/c5615c5f-594a-455a-b045-564b6c68e46b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7913a43c0eef64be0e402e61cdd90e9 3x", "genre": "art", "nsfw": true, "body": "ご無沙汰しております。\n今回も美由希で、下記の内容でリクエストをしたいと思います。\n\n【シチュエーション】\n犬相手の獣姦をさせられ、犬相手の肉便器に堕ちる美由希\n　\nSMプレイルーム的な場所で四つん這いの姿勢で拘束され（期待する表情）、『今日はスペシャルゲストを用意した』と告げられてから目隠しをされる美由希（マンコは期待でマン汁垂れ流し状態）\n↓\n度重なる調教でユルマンというかガバマンといっても差し支えがないほどにマンコが緩くなっている事もあり、前戯も無しに犬チンポを容易に受け入れる美由希\n↓\n激しいピストンにオッパイを揺らしながら感じつつも、これまでの（人間）相手との違いに困惑する美由希\n↓\nネタバラシとばかりに目隠しを外され、犯している相手が人間ではなく犬である事に気付かせられる美由希\n↓\nネタバラシされた直後こそ嫌悪感が湧いたものの、犬に犯される背徳感と犬チンポから与えられる快感にすぐに堕ちる美由希、そこから更に後尾結合の姿勢になった犬からの大量な膣内射精で絶頂\n↓\n射精後、美由希の顔の前にお掃除フェラをしろと言わんばかりにチンポを向ける犬、そんな犬に対して躊躇する事なくお掃除フェラをする美由希と、更に別に用意された犬に再び犯される美由希（実は一部始終を撮影されており、その痴態をリアルタイムでネットにばら撒かれている設定）\n\n【背景】\n過去作品のプレイルーム的な場所\n\n【体型・装飾】\n前回から継続で巨乳・デカ乳首状態、\n乳首とマンコにリベットピアス装着、\nオッパイと下腹部に刻印あり\n革ベルト系の首輪（少し大きめ）、同様の手枷と足枷を装着、目隠しも革製の物を使用\n\n【その他】\n陰毛や腋毛は不要\n修正は黒海苔を希望\n配置・視点はお任せしますが、挿入部が直接見えなくなる場合はカットイン描写で挿入部が見える状態を希望\n犬の犬種は中型〜大型で、ファンタジー的な造形の物ではなく一般的な物を希望\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/11", "thumbnail_src": "https://si.imgix.net/215fbed5/uploads/origins/9b217d8f-7776-41f1-9d7a-0e625baeaaba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59f743ec8634177bda2ab216a7813f35", "thumbnail_srcset": "https://si.imgix.net/215fbed5/uploads/origins/9b217d8f-7776-41f1-9d7a-0e625baeaaba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59f743ec8634177bda2ab216a7813f35, https://si.imgix.net/215fbed5/uploads/origins/9b217d8f-7776-41f1-9d7a-0e625baeaaba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd17395cf72989c8ad590003e751cd03 2x, https://si.imgix.net/215fbed5/uploads/origins/9b217d8f-7776-41f1-9d7a-0e625baeaaba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1743153ea57984633212b64b2e601bb7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/10", "thumbnail_src": "https://si.imgix.net/76f7107e/uploads/origins/e5dc2f48-161e-4fcf-ba22-1f22917edbc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0683fb265d130dbaa45e6b73b76be12", "thumbnail_srcset": "https://si.imgix.net/76f7107e/uploads/origins/e5dc2f48-161e-4fcf-ba22-1f22917edbc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0683fb265d130dbaa45e6b73b76be12, https://si.imgix.net/76f7107e/uploads/origins/e5dc2f48-161e-4fcf-ba22-1f22917edbc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d233e86adce05a40ad50b7ff07820e77 2x, https://si.imgix.net/76f7107e/uploads/origins/e5dc2f48-161e-4fcf-ba22-1f22917edbc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f928214a9d9bb66a3f35e863f1ea4d2a 3x", "genre": "art", "nsfw": true, "body": "今回も早々な納品、有難う御座いました。\n引き続き美由希で、下記の内容でリクエストをしたいと思います。\n（今回はかなり内容が濃いめなので、抵抗があるようならキャンセルしてください）\n\n【シチュエーション】\n6月に因んでウェディングドレス（＋α）に身を包んだ美由希（立ち姿）\n前回同様に斜向かい視点\n　\nこちらに向けて笑顔を向ける美由希、前回のデカ乳＆デカ乳首化のせいで、ドレスの胸が窮屈＆盛大に胸ポチ状態（効果音等の特別な描写は無し）\n→股付近からバイブの振動音とお腹からギュルル…といった、事前に仕込まれている浣腸によるグル音の擬音描写と、頬の赤みを追加\n→着ている人間が欲情する毎に生地が透けていく謎技術でドレスが透過（50％程度）、\nマンコにバイブを咥え込んでいる（バイブは太め、布面積少なめの白レースの紐パンでバイブの抜け防止している状態）のと、\n身体に卑猥な刻印やピアスが施されているのを透けて見えている状態\n→更に透過が進んでドレスがほぼ全透けになり、自分に向けられた卑猥な視線により絶頂\n→絶頂による弛緩からの小便と大便を盛大に排泄、排泄音と美由希の足下に広がる排泄物で大惨事に\n\n【背景】\n教会風の屋外（晴天）を希望\n\n【衣装】\n色は純白指定\nウェディングドレスの意匠はお任せ\n（やや扇情的かつ性的な物を希望）\n\n【体型・装飾】\n前回から継続で巨乳・デカ乳首状態、\n乳首とマンコにリベットピアス装着、\nオッパイと下腹部に刻印あり\n\n【その他】\n陰毛や腋毛は不要\n修正は黒海苔を希望\n可能なら排泄物はボカシ無し、液状便だけでなく固形便も混じっている状態を希望\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/9", "thumbnail_src": "https://si.imgix.net/6d6efb96/uploads/origins/26deef99-7afa-4beb-8a31-e544d7caec91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca0487bee9c19b373e310700ada08b2a", "thumbnail_srcset": "https://si.imgix.net/6d6efb96/uploads/origins/26deef99-7afa-4beb-8a31-e544d7caec91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca0487bee9c19b373e310700ada08b2a, https://si.imgix.net/6d6efb96/uploads/origins/26deef99-7afa-4beb-8a31-e544d7caec91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab7a1d944c2d5086ce99cb8ed94441c1 2x, https://si.imgix.net/6d6efb96/uploads/origins/26deef99-7afa-4beb-8a31-e544d7caec91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=326298b7c0f38d75feb4575a48807851 3x", "genre": "art", "nsfw": true, "body": "早々な納品、有難う御座いました。\n今回も美由希で、下記の内容でリクエストをしたいと思います。\n\n【シチュエーション】\n前回同様に斜向かい視点で、姿勢は尻を上に向けたまんぐり返しで拘束されている状態（手は後ろ手に拘束）\nまたしても怪しい薬をまずは片方のオッパイに注射\n→シグナム以上の巨乳化＆デカ乳首が更に成長（長さ1.5〜2倍、太さ1.5倍ほどに更にサイズアップホルスタインのような乳首にデカ長乳首化）\n→続けてもう片方のオッパイにも注射してデカ乳＆デカ長乳首化、また薬物の影響でマンコが濡れている状態に\n→前戯も無しに、大きめサイズのバイブをマンコとアナルに挿入、それを苦も無く容易に受け入れる美由希\n→バイブを引き抜かれ、バイブの太さと同じ大きさでポッカリと開いたままのマンコとアナル\n→そんな開いたままの両穴に、今度は屈強な腕による両穴フィストファックを敢行、通常であれば悲鳴を上げてもおかしくない行為に対して喘ぎ声を上げる美由希\n→更に今度はアナルに突っ込んでいた腕もマンコに突っ込みWフィストによるマンコ拡張、盛大に潮を噴いて絶頂する美由希\n→腕を抜いて、ガバガバに拡がったままのマンコとアナル、これで終わりかというとそうでなく、開いたままの両穴へ向けて放尿開始、小便を嬉しそうに飲み込んでいく子宮と腸\n→やがて子宮も腸も小便で満タンになり、穴から溢れ出している様子に嬉しそうにしている、人間便器となった美由希\n\n【背景】\n詳細は薄暗い室内\n（希望はSMルームかラブホテル的な内装）\n\n【服装】\n前回の物を継続\n\n【装飾】\n前回の物を継続\n\n【表情】\n快楽堕ちした笑顔（アヘ顔はNG）\n\n【その他】\n陰毛や腋毛は不要\n修正は黒海苔を希望\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/8", "thumbnail_src": "https://si.imgix.net/5f800d17/uploads/origins/1cf52047-45ac-4199-bd27-b59ca3a9d539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=268d1825285d9b51649c86e73e9d3dae", "thumbnail_srcset": "https://si.imgix.net/5f800d17/uploads/origins/1cf52047-45ac-4199-bd27-b59ca3a9d539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=268d1825285d9b51649c86e73e9d3dae, https://si.imgix.net/5f800d17/uploads/origins/1cf52047-45ac-4199-bd27-b59ca3a9d539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c78134f2236cc04b5ef47cd11f6bd34e 2x, https://si.imgix.net/5f800d17/uploads/origins/1cf52047-45ac-4199-bd27-b59ca3a9d539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8fa44233b8b0bb1d74d0d5c53b49bad 3x", "genre": "art", "nsfw": true, "body": "先日の美由希のイラストの追加差分の早々な納品、有難う御座いました。\n今回も美由希で、下記の内容でリクエストをしたいと思います。\n\n【シチュエーション】\n美由希を性奴隷にするべく、マンコだけでなくフェラやアナルの開発・調教\n真正面ではなく斜向かい視点で、騎乗位でマンコにチンポを挿入した状態からフェラチオ（口に挿入）＆アナルに指を挿入\n→アナルにもチンポを挿入\n→マンコ、口、アナル共にザーメンを中出し（吹き出し型のカット描写で膣内＆腸内射精をしている断面図差分を希望）\n→更にザーメンだけでなく各穴に放尿（吹き出し型のカット描写で膣内＆腸内放尿をしている断面図差分を希望）\n※喉や子宮がザーメンや小便をゴクゴクと悦んで飲み込む効果音を希望\n\n【背景】\n詳細はお任せしますが、薄暗い室内\n（希望はSMルームかラブホテル的な内装）\n\n【服装】\n茶色系か黒の犬用の首輪（サイズは首の太さに対してやや大きめ）と、黒の革ベルト系手枷と足枷を着用で、身体は全裸または黒のハーネス系ボンデージを着用\n\n【装飾】\nピアスと刻印は前回依頼の内容を準拠\n（乳首とクリトリス、インナーラビアのリベットピアスと、胸と下腹部の刻印）\nレイヤーで眼鏡のON/OFFのほか、ラバー系目隠し（色は黒）のレイヤー差分を希望\n\n【表情】\n泣き顔と恍惚とした表情を希望\n\n【その他】\n陰毛や腋毛は不要\n修正は黒海苔を希望\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/7", "thumbnail_src": "https://si.imgix.net/3e538b63/uploads/origins/6ba75b26-4891-4240-82c9-17c5e2991ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d967415985a24f6dcc07b3af8563f6", "thumbnail_srcset": "https://si.imgix.net/3e538b63/uploads/origins/6ba75b26-4891-4240-82c9-17c5e2991ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d967415985a24f6dcc07b3af8563f6, https://si.imgix.net/3e538b63/uploads/origins/6ba75b26-4891-4240-82c9-17c5e2991ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f92452beb99e5e692593babc7904a5c 2x, https://si.imgix.net/3e538b63/uploads/origins/6ba75b26-4891-4240-82c9-17c5e2991ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bb0a23c873e626c9b3785a8c02b9982 3x", "genre": "art", "nsfw": true, "body": "ご無沙汰しております。\n今回は前回納品していただいた美由希のイラストの追加差分を依頼したいと思います。\nなお、少しハードめな内容になるため、抵抗があるようでしたらキャンセルして下さい。\n\n【シチュエーション】\n太ももに複数回中出しをした痕跡となる正の文字（複数）を油性マジック（黒）で書き込んでいる様子（ペンだけでなくペンを持つ手も必須）\n→乳首とクリトリスに直接怪しいクスリを注射（注射器だけでなく、ポンプを押す手も有り）\n→乳首とクリトリスが肥大化（乳首は前回の勃起乳首と比べて長さは三倍、太さは1.5〜2倍程度、クリトリスは太さはそのままで長さを1.5〜2倍程度に）\n→おっぱいにマンコマークを刻印（色は黒単色、線の太さはTOILETの文字と同程度、サイズは内側の円は乳輪より少し大きく、外側の円は乳首と内側の円のピッチと同程度、縦線は乳首ごと刻印（乳首で途切れさせない）、外周の放射線は数は10本程度で配置は縦線を含めて均等割）\n→乳首、クリトリス、インナーラビアに安全ピンでピアッシング。乳首は左右共に三連発（向きは統一で左右方向に貫通）、クリトリスは単発（左右方向に貫通）、インナーラビアは引っ張られた状態で左右共に5〜7発（数量は左右対象）\n→山が低めの丸頭リベット的な意匠のピアスを装着。リベットの色は無光沢のシルバーで統一。シャフトは見えずにリベット頭で対象物を挟み込んでいる状態\n→浴尿（前回の浴尿差分を今回の追加差分に合わせて調整）\n\n【表情差分】\n視線を自分の身体に向けつつ恍惚とした表情（マゾ性が開花した様子）\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/6", "thumbnail_src": "https://si.imgix.net/d0ba6b16/uploads/origins/db05d966-f86b-4d1a-96e9-8caad2266145?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0447a918a017f0b968c58062af6bed34", "thumbnail_srcset": "https://si.imgix.net/d0ba6b16/uploads/origins/db05d966-f86b-4d1a-96e9-8caad2266145?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0447a918a017f0b968c58062af6bed34, https://si.imgix.net/d0ba6b16/uploads/origins/db05d966-f86b-4d1a-96e9-8caad2266145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51209c802cfe71b4dac3464e22f527fa 2x, https://si.imgix.net/d0ba6b16/uploads/origins/db05d966-f86b-4d1a-96e9-8caad2266145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0159954b2826c044f61555513078419 3x", "genre": "art", "nsfw": true, "body": "前回に続きすずか＆アリサの納品有難う御座いました。\n今回は下記の内容でリクエストをしたいと思います。\nなお、今回は希望差分が多いため、依頼金額に見合わない場合は金額を提示して再送を希望です。\n\n【キャラクター】\n高町美由希(なのは1期 or innocent)\n\n【シチュエーション】\n腕押さえ輪姦(資料URL参照)による集団レイプ\n差分希望で、\n挿入前\n→挿入後\n→中出し(1発目)\n→中出し(複数発目、溢れたザーメンが床に滴っている)\n→チンポ外し(マンコがぽっかりと開いた状態)・大量の中出しザーメン垂れ流し状態\n→乳首＆クリトクリトリスにニードルピアッシング・肉便器の刻印墨入れ(施術中。希望は物理ですが、魔法的な表現でも可)\n→ 乳首＆クリピアス取付・肉便器の刻印完了→複数チンポからの浴尿(チンポの本数は5本程度、それぞれ顔面、左右胸、へそ付近(へそに小便が溜まっている)、マンコを的にしている状態)\n\n【背景】\nお任せしますが、希望は薄暗い倉庫的な場所で、申し訳程度に床にダンボールを敷いた状態\n\n【服装】\n1期のキャラ紹介の学生服か、他に私服の資料があるならそちらでも可\n胸は露出、下着(色は淡いグリーン系)は破り取られて床に投げ捨てられている状態\n\n【装飾】\n乳首とクリトリスにリングピアス装着\n(色はプラチナ系かシルバー系、光沢は弱めか無し)\n下腹部に男子トイレのピクトサインとTOILETの文字(両方とも黒単色)を刻印\n※刻印は基本的なデザインは過去依頼の物と同じにしつつ大型化、具体的には膀胱付近に大きめのピクトサイン、その下(恥丘付近)に同じく大きめのTOILETの文字(すずかの時だとTOIとLETが離れているのを、今回は離さない)を印字\n\n【表情】\nシチュエーションに合わせて、\n怒り(挿入前、抵抗)\n→泣き(抵抗虚しく挿入され)\n→驚き(最初の中出し)\n→快楽交じりの困惑(複数中出し)\n→恍惚(ザーメン垂れ流し)\n→苦痛(ピアッシング・墨入れ施術中)\n→泣き笑い(施術後)\n→悦び(浴尿)\n\n【その他】\n中出し複数発後からは乳首を大きめ(快楽による勃起状態、長乳首化)を希望\n陰毛は不要\n流血描写は不要\n修正は黒海苔または白海苔を希望\n眼鏡をON/OFFできるように眼鏡の別レイヤー化を希望\n\n以上の内容でご検討をよろしくお願いいたします。\n\nhttps://dic.pixiv.net/a/%E8%85%95%E6%8A%BC%E3%81%95%E3%81%88%E8%BC%AA%E5%A7%A6", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/5", "thumbnail_src": "https://si.imgix.net/ba133fa4/uploads/origins/f4347a9c-21a3-4e26-ada6-26b3081d53f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9601a1a976d36b6eb5d67fd84408b8c", "thumbnail_srcset": "https://si.imgix.net/ba133fa4/uploads/origins/f4347a9c-21a3-4e26-ada6-26b3081d53f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9601a1a976d36b6eb5d67fd84408b8c, https://si.imgix.net/ba133fa4/uploads/origins/f4347a9c-21a3-4e26-ada6-26b3081d53f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e324145252253f88098e91165d13738 2x, https://si.imgix.net/ba133fa4/uploads/origins/f4347a9c-21a3-4e26-ada6-26b3081d53f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74bee19ad68986f038018244f3ed51c7 3x", "genre": "art", "nsfw": true, "body": "すずか＆アリサの納品有難う御座いました。\n今回は下記の内容でリクエストをしたいと思います。\n\n【キャラクター】\nすずか＆アリサ（なのはinnocent）\n\n【シチュエーション】\n正面からの視点で、屋外で二人揃って手前に向けてしゃがみパンチラ（前回と同じくマンコとアナルに大人のオモチャを仕込んであるのを見せている様子、そしてそこから更に公開お漏らし\n\n【背景】\nお任せしますが、希望は日中の児童公園（背景に第三者がいるかどうかはお任せします）\n\n【服装】\n前回イラストと同じ\n今回は胸露出は無し、ただし胸ポチあり＆ピアスが着いたピンク乳首が薄っすらと透けて見えている様子を希望\n\n【装飾】\n前回イラストと同じ\n\n【バイブ】\n前回イラストと同じ\n\n【ローター】\n前回イラストと同じ\n\n【表情】\n羞恥心で赤面しつつも、色気混じりで微笑んでいる様子（合意のプレイ）\n\n【お漏らし】\nパンツを穿いたままの着衣お漏らしと、パンツ無しのお漏らし差分を希望\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/4", "thumbnail_src": "https://si.imgix.net/f9243459/uploads/origins/68ff121b-b98d-477b-a90f-488ba65d1c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f8e893b16701e556e6541673f723d2", "thumbnail_srcset": "https://si.imgix.net/f9243459/uploads/origins/68ff121b-b98d-477b-a90f-488ba65d1c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f8e893b16701e556e6541673f723d2, https://si.imgix.net/f9243459/uploads/origins/68ff121b-b98d-477b-a90f-488ba65d1c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=665d41039e48e1ab013d007856a369e5 2x, https://si.imgix.net/f9243459/uploads/origins/68ff121b-b98d-477b-a90f-488ba65d1c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c48636154b279e7b80c8b5081f6597a7 3x", "genre": "art", "nsfw": true, "body": "先日は納品有難う御座いました。\n今回は下記の内容でリクエストをしたいと思います。\n\n【キャラクター】\nすずか＆アリサ（なのはinnocent）\n\n【シチュエーション】\n正面からの視点で、屋外で二人揃って手前に向けて乳首にピアスを着けた胸を露出＆スカートをたくし上げてマンコとアナルに大人のオモチャを仕込んであるのを見せている様子\n（マンコにはバイブを挿入していてパンツでバイブが抜け落ちない用にしてあり、アナルにはローターを入れてあり左太腿にコントローラーとケーブルの余長をバンド的な物で保持している）\n\n【背景】\nお任せしますが、希望は日中の児童公園（背景に第三者がいるかどうかはお任せします）\n\n【服装】\n海聖の制服かバリアジャケットを希望、構造的に難しい場合は私服など他の衣装でもOKです\nブラジャーは無し、パンツの意匠は野暮ったい物でなければお任せします\n（サイド部は幅細めで腰に食い込み気味、上部はバイブに引っ張られてマンコがギリギリ見えない程度に下がっている状態を希望、色はすずかが淡い水色、アリサが淡いピンク辺りを希望）\nタイツやスパッツなどは未着用を希望\n\n【装飾】\n二人とも犬用の首輪（リードは無し）を装着、\n乳首にシルバーのリングピアスを装着\n恥丘部分に男子トイレのピクトサイン（●と▼のシンプルな物）と、その下にTOILETの文字のタトゥー（ピクトサイン、文字共に黒単色）を入れてある状態\n※TOILETの文字はパンツによって半分ほど隠れている状態か、全部見える状態かはお任せします\n\n【バイブ】\n外部リモコンが無い物で、握り手の色は白、竿部分の色はピンク系か紫系を希望\n（すずかとアリサで別々の色を採用希望）\n※バイブはパンツで隠れて見えないか、パンツの脇からチラ見えしている状態\n\n【ローター】\n色はバイブの竿部分と同色、コントローラー＆ケーブル余長を保持するバンドは白のシュシュ的な意匠の物か、革バンドを希望\n正面視点なので通常であればアナルは見えないものの、吹き出し型のカット描写で斜め下視点でおしりにローターのケーブルが入っている様子を希望（依頼金額をオーバーしているようならカット描写は無しでもOKです）\n\n【表情】\n羞恥心で赤面しつつも、色気混じりで微笑んでいる様子（合意のプレイ）\n\n以上の内容でご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/3", "thumbnail_src": "https://si.imgix.net/c786362a/uploads/origins/88b1f7fb-c73c-49d6-9134-b62fcb276fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89a104675a5a7bd3a07805a7f42c4d8e", "thumbnail_srcset": "https://si.imgix.net/c786362a/uploads/origins/88b1f7fb-c73c-49d6-9134-b62fcb276fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89a104675a5a7bd3a07805a7f42c4d8e, https://si.imgix.net/c786362a/uploads/origins/88b1f7fb-c73c-49d6-9134-b62fcb276fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e56289907f21d82294638701895aa83 2x, https://si.imgix.net/c786362a/uploads/origins/88b1f7fb-c73c-49d6-9134-b62fcb276fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=906faabacfad85b7b06998dfeec4b5c3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/2", "thumbnail_src": "https://si.imgix.net/322d6b46/uploads/origins/9f21657a-9e69-4797-a3d0-1d3cab28335e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6022b6143d0128cc8b099df8f6019652", "thumbnail_srcset": "https://si.imgix.net/322d6b46/uploads/origins/9f21657a-9e69-4797-a3d0-1d3cab28335e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6022b6143d0128cc8b099df8f6019652, https://si.imgix.net/322d6b46/uploads/origins/9f21657a-9e69-4797-a3d0-1d3cab28335e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8229f71f4b6ffd849ef207d8ce96070 2x, https://si.imgix.net/322d6b46/uploads/origins/9f21657a-9e69-4797-a3d0-1d3cab28335e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9908d97c1671131f65a35e3f25d5207d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorgon_PN/works/1", "thumbnail_src": "https://si.imgix.net/9c1d83c6/uploads/origins/ef89d3bc-1c32-4a33-8cef-417fe13363cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72559e1ba2cf61c62087678143c28eda", "thumbnail_srcset": "https://si.imgix.net/9c1d83c6/uploads/origins/ef89d3bc-1c32-4a33-8cef-417fe13363cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72559e1ba2cf61c62087678143c28eda, https://si.imgix.net/9c1d83c6/uploads/origins/ef89d3bc-1c32-4a33-8cef-417fe13363cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=529ed7d4fd87b2abe891026a823be7ad 2x, https://si.imgix.net/9c1d83c6/uploads/origins/ef89d3bc-1c32-4a33-8cef-417fe13363cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b4d0c1a2c5d0ab1758a21f6bbe8651d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}