-f196-4767-840f-fffff5c86de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220319f8c5037dacfb98c09c267b6ca0", "thumbnail_srcset": "https://si.imgix.net/09141cfe/uploads/origins/4bc27036-f196-4767-840f-fffff5c86de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220319f8c5037dacfb98c09c267b6ca0, https://si.imgix.net/09141cfe/uploads/origins/4bc27036-f196-4767-840f-fffff5c86de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2bbf2e0248b7c04a08bd43d75ece843 2x, https://si.imgix.net/09141cfe/uploads/origins/4bc27036-f196-4767-840f-fffff5c86de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2424a85e130cc1911a36af10c9f95e0f 3x", "genre": "art", "nsfw": false, "body": "麻雀ファイトガールのアマトテンシを宇宙サイズで描いていただいてもよろしいでしょうか？\n衣装はホーリーエンジェル(仮面なし)、表情は優しい笑顔で。資料URLに設定資料を添付しておきます。\n構図のイメージは4月28日にアップしていただいたオリキャラ巨大娘ちゃんの様な感じでお願いします。胸の大きさはメイド水着の巨大イヨのイラストくらいでお願いします。\n\n以下、セリフのイメージです。\n「安心して。あたしちゃんがぜ〜んぶ、守ってあげるから❤️」\n\nhttps://x.com/mfg573/status/1890566703941124562?s=46&t=528Ktey99NmXSF-nfQLIyw", "created_at": "", "completed_at": ""}, {"path": "/@taisyou_0721__/works/30", "thumbnail_src": "https://si.imgix.net/90d72d80/uploads/origins/516b30b3-1b51-4c36-abc0-ff9c94dc948a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5006b8be963a517f9c15ab3d0b219782", "thumbnail_srcset": "https://si.imgix.net/90d72d80/uploads/origins/516b30b3-1b51-4c36-abc0-ff9c94dc948a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5006b8be963a517f9c15ab3d0b219782, https://si.imgix.net/90d72d80/uploads/origins/516b30b3-1b51-4c36-abc0-ff9c94dc948a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2