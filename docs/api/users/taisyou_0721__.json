.net/bd45fe35/uploads/origins/1155f78a-7aab-4b15-aeee-4c2227ad3b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4b1f7acee7482277700e6f40fb8db93 2x, https://si.imgix.net/bd45fe35/uploads/origins/1155f78a-7aab-4b15-aeee-4c2227ad3b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfcff78b5178f06073a575850fa9c92f 3x", "genre": "art", "nsfw": true, "body": "画面は男の視界というイメージです。\n爆乳幼女が全裸で片方のおっぱいを持ち上げて男の顔（画面）にピンク乳首をチロチロと優しく乳首ビンタしてあげている絵をお願いします。\n全裸幼女は「ホレホレ〜♡」と嬉しそうな感じでお願いします。\n\n画面の横から男の腕が伸びていてもう片方の乳首を人差し指でスリスリしているのかはお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@taisyou_0721__/works/16", "thumbnail_src": "https://si.imgix.net/318616f1/uploads/origins/bb45ea05-c744-45e2-bafc-913b2a38d6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ff8f27b486a43ed8a299d3bef4abf7", "thumbnail_srcset": "https://si.imgix.net/318616f1/uploads/origins/bb45ea05-c744-45e2-bafc-913b2a38d6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ff8f27b486a43ed8a299d3bef4abf7, https://si.imgix.net/318616f1/uploads/origins/bb45ea05-c744-45e2-bafc-913b2a38d6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d1d865ef41e6bedeab4398b12c4d50e 2x, https://si.imgix.net/318616f1/uploads/origins/bb45ea05-c744-45e2-bafc-913b2a38d6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22b7443ff08c0e6b993880072df370b6 3x", "genre": "art", "nsfw": false, "body": "平均的な重さです。あなたのスタイルに合うようでしたら、ご自由に簡略化してください。\nhttps://drive.google.com/drive/folders/1JeLMfFBZaLD9hljWNTS0it8qw5OcHc-0?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@taisyou_0721__/works/15", "thumbnail_src": "https://si.imgix.net/b5eb5880/uploads/origins/f517e3f4-fcac-4106-8c96-54ff8b7fb0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7bf3412f120729ae9f2aff76411414", "thumbnail_srcset": "https://si.imgix.net