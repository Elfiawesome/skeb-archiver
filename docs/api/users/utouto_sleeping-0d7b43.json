t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02de0136b55a6626241501ed1535bcc9 2x, https://si.imgix.net/3c95348f/uploads/origins/2c8ac4bd-a600-41a5-99ba-5fe2d28bf870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e819b83ca61b37a19c1e1aa4cd3ec27 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/7", "thumbnail_src": "https://si.imgix.net/c50c2e63/uploads/origins/23fde3a1-3078-47c0-82ad-885fbd3b3606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ca02d43303da6e71f76aba17b15dc8b", "thumbnail_srcset": "https://si.imgix.net/c50c2e63/uploads/origins/23fde3a1-3078-47c0-82ad-885fbd3b3606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ca02d43303da6e71f76aba17b15dc8b, https://si.imgix.net/c50c2e63/uploads/origins/23fde3a1-3078-47c0-82ad-885fbd3b3606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a34cc7cdf355031c8596609b6603f407 2x, https://si.imgix.net/c50c2e63/uploads/origins/23fde3a1-3078-47c0-82ad-885fbd3b3606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c812810996f0f4980642a178af32429 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/6", "thumbnail_src": "https://si.imgix.net/b071ba38/uploads/origins/25b22413-db7f-4522-8d11-ac71e5e81f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddcf85ebd2713982fb53f41c5b836285", "thumbnail_srcset": "https://si.imgix.net/b071ba38/uploads/origins/25b22413-db7f-4522-8d11-ac71e5e81f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddcf85ebd2713982fb53f41c5b836285, https://si.imgix.net/b071ba38/uploads/origins/25b22413-db7f-4522-8d11-ac71e5e81f54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86f19e002231b0126717a3bc5dfff3f6 2x, https://si.imgix.net/b071ba38/uploads/origins/25b22413-db7f-4522-8d11-ac71e5e81f54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eae35182b97d4d596e7ee045f1c8cbed 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作風はとても美しく、もしあなたが私のocを描いてくれたらとても嬉しいです :)\n\n> PORTER (20) https://drive.google.com/drive/folders/1Ktes6UKu5kmbWj5ZYbROrh7YZYA-Uz5u\n\nポーターは心優しく、親切な農夫で、敬虔な宣教師である。彼は友人や家族だけでなく、飼っている動物たちも大切にする。意欲的で人を育て、長男であることを真剣に受け止めている。自然の中にいることと信仰を愛している。\n\nテーマ：犠牲の子羊、羊、運命、日光、聖人、運命への挑戦、堕落、失われた楽園、逆転、希望、逆境における優しさ、殉教者", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/5", "thumbnail_src": "https://si.imgix.net/69b1b39e/uploads/origins/dc76eed9-8463-4100-bb2f-480d5b7ee10b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb295500e3748f115eb7bcf2dc26360", "thumbnail_srcset": "https://si.imgix.net/69b1b39e/uploads/origins/dc76eed9-8463-4100-bb2f-480d5b7ee10b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb295500e3748f115eb7bcf2dc26360, https://si.imgix.net/69b1b39e/uploads/origins/dc76eed9-8463-4100-bb2f-480d5b7ee10b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5ab4a51e554e9bf90f1bfdf462b400d 2x, https://si.imgix.net/69b1b39e/uploads/origins/dc76eed9-8463-4100-bb2f-480d5b7ee10b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dbc5e304a4e6c29d530283de6294f7d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！先生の絵が大好きです！あなたの細部へのこだわりと考え抜かれた構図は、心温まるもので、見ていて本当に嬉しくなります。\n\n私のOCを先生のアートスタイルで見てみたいです。彼女は兄の死について自分を責め、兄のようになろうとする王子様タイプです。しかし、彼女は自分が良い人間ではないと感じており、このような類似性を達成することはできません。それでも彼女はいつも笑顔を絶やさない。一人でいることを深く恐れているが、手放すことを学びたいとも思っている。自分の悲しみを誰にも知られたくないが、思い出を煙にして吐き出す呪いをかけられている。\n\n彼女に似合うと思うモチーフがいくつかある：\n\n煙\n鏡\n水\n反射\n死\n春\n鎖\n\n彼女と相性の良い配色\n\n赤、黒、青、金、紫。暖色系\n\n肌の色に注意してください！彼らは日焼けしています！\n\nこれが十分な情報であることを願っています！本当にありがとうございました！\n\n私のOCの参考文献: https://drive.google.com/drive/folders/1b2_9a7mhwptG7ZjG9yZXOQATRjx8y1wT\n\n弟の参考文献\nhttps://drive.google.com/drive/folders/1Fq3RKI4I4o1KY9q11PlOwKtjPLQ5f6vo\n\n素敵なアートを世界に公開してくれて、本当にありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/4", "thumbnail_src": "https://si.imgix.net/7edb3d51/uploads/origins/783c7c6f-7ca3-4094-abbb-695384038cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f42de428d2231b8f99f8f1f16c66942", "thumbnail_srcset": "https://si.imgix.net/7edb3d51/uploads/origins/783c7c6f-7ca3-4094-abbb-695384038cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f42de428d2231b8f99f8f1f16c66942, https://si.imgix.net/7edb3d51/uploads/origins/783c7c6f-7ca3-4094-abbb-695384038cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dec6bbadcbbc2e64a256d844bafc8558 2x, https://si.imgix.net/7edb3d51/uploads/origins/783c7c6f-7ca3-4094-abbb-695384038cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d863c7b2587ccc5ecfe6dc704b38669c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生。先生の画風がとても好きです。もし可能であれば、私のリクエストを検討してください。\n\nキーワード：悲しみ、喪失感、無感覚、孤独、涙、青春。\n\n私のオリジナルキャラクターです：\n\n名前シアン\n身長：178cm\nシアンは裕福だが非常に厳格な家庭に生まれた。両親は離婚し、彼は母親に育てられたが、母親は彼に非常に大きな期待をかけていた。成績は常にトップだったが、そのプレッシャーから無口で引っ込み思案な性格になった。他人に心を開くことはなく、友人もほとんどいない。\n\nAは貧しい家庭の出身だが、陽気で明るく、生命力に満ちあふれている。私の言葉で \"夜明け \"という意味だ。しかし、高校時代、いろいろなことが起こり、二人の間に少しずつ溝ができ、まるで違う世界に住んでいるような感覚になった。\n\n卒業式の日、二人は学校の屋上で深刻な口論をした。その直後、Aは悲痛な決断を下した。\n\nシアンくんがバスタブに座り、服を着て（高校の制服）、あるいはシャツを脱いで（お好みで）、疲れきって無感覚になっているイラストをお願いしたい。頬に涙を浮かべ、まるで悲しみが静かに溢れ出てくるかのように。悲しみに溺れ、それを引き上げてくれる人が誰もいないような、重く孤独な感じにしてほしい。\n\nAについては、どちらかというと背景／NPCのキャラクターなので具体的な参考はありませんが、できれば栗色の短髪で中肉中背（背が高すぎず、体格ががっしりしていない）で描いてください。\n\n18歳（過去）と25歳（現在）の2つのバージョンを添付します。自由に選んで描いてください！\n\n読んでくれてありがとう。どんな絵の解釈や調整でも構いません。\n\nhttps://drive.google.com/drive/folders/1sOEdXH2cUhybZw4fXMXQqGbrQPOuIqnE", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/3", "thumbnail_src": "https://si.imgix.net/65171afc/uploads/origins/3021ffd3-85b0-46b6-ac03-7c4f5f1f49e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adc7904e90d2ad9a25dc1680f9304591", "thumbnail_srcset": "https://si.imgix.net/65171afc/uploads/origins/3021ffd3-85b0-46b6-ac03-7c4f5f1f49e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adc7904e90d2ad9a25dc1680f9304591, https://si.imgix.net/65171afc/uploads/origins/3021ffd3-85b0-46b6-ac03-7c4f5f1f49e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ddc11eb37691e5c74508286ffdaf53 2x, https://si.imgix.net/65171afc/uploads/origins/3021ffd3-85b0-46b6-ac03-7c4f5f1f49e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a845c261e8732a807306871570ddbeae 3x", "genre": "art", "nsfw": false, "body": "Hello! I love your art style and would like to request a drawing of my character.\n\nQuin (32):\n- A former villain who wants to repent, because he fears punishment from God, but doesn't know how.\n- His theme is a snake that is trying to shed its own skin, but gets stuck. Like an incomplete rebirth.\n- Sarcastic and apathetic, he often wears a condescending smile around people.\n- When he's alone, he's emotionless and hollow. He prefers to watch the world passively.\n- He works at an organization that fights supernatural creatures.\n- He has the power to destroy anything he touches, but his own body breaks down when he uses this ability. He lives in a lot of physical pain, believing he deserves it.\n- He burns photographs of his past.\n- Please note his missing fingers.\n\nA song that I associate with him: https://www.youtube.com/watch?v=JW3N-HvU0MA\n- He is filled with a lot of guilt for the people he cannot save. He wonders if he cannot save them because he was not born with enough kindness.\n- One suggestion is capturing the feeling of summer coming to an end.\n\nMotifs: decay, atrophy, regret, penance, burned photographs, scissors, and ouroboros\n\nThank you for considering my request! ٩(｡•́‿•̀｡)۶\t\n\nReference images: https://drive.google.com/drive/folders/1GqEaeurgmSPtar6TksJmF82P7nuf_j3q?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/2", "thumbnail_src": "https://si.imgix.net/c1a41aef/uploads/origins/aa3960d3-ef22-4048-9160-ec7caeec1b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90d5c227afc496c2e9663b9bead864b6", "thumbnail_srcset": "https://si.imgix.net/c1a41aef/uploads/origins/aa3960d3-ef22-4048-9160-ec7caeec1b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90d5c227afc496c2e9663b9bead864b6, https://si.imgix.net/c1a41aef/uploads/origins/aa3960d3-ef22-4048-9160-ec7caeec1b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67249abfeeca0cf08603dc3557228393 2x, https://si.imgix.net/c1a41aef/uploads/origins/aa3960d3-ef22-4048-9160-ec7caeec1b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=702c1d93095ff2c1062c42cd1711b443 3x", "genre": "art", "nsfw": false, "body": "真夏の青色が濃い日の空と太陽の光、その中に佇む人影の絵が見たいです。 空は水色が少なめで、濃い青色が広がっていると嬉しいです。 人影は太陽からの逆光で影になってシルエットしか見えておらず、性別も不明の雰囲気でお願いします。 咽せ返るような真夏の空気に嫌になりながら俯いて歩いていて、ふと顔を上げたら熱中症気味で揺れる視界の中に人影があった、というようなイメージです。  細かく書ききれていなかったらすみません。お時間があって気が向いたときにお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@utouto_sleeping/works/1", "thumbnail_src": "https://si.imgix.net/0307d080/uploads/origins/57dd069c-6765-4593-b766-367929bf6884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8108c4ce8c1ec3e8123a1aefaf332d40", "thumbnail_srcset": "https://si.imgix.net/0307d080/uploads/origins/57dd069c-6765-4593-b766-367929bf6884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8108c4ce8c1ec3e8123a1aefaf332d40, https://si.imgix.net/0307d080/uploads/origins/57dd069c-6765-4593-b766-367929bf6884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=287367a1d005ccf5b63aec7758673231 2x, https://si.imgix.net/0307d080/uploads/origins/57dd069c-6765-4593-b766-367929bf6884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f9512a0782abbef934b52d60b597a09 3x", "genre": "art", "nsfw": false, "body": "葬田さんこんにちは！\n葬田さんの描かれる光と影の表現が印象的で、いつも憧れております。\n\n今回はTRPGのキャラクターを依頼したく、リクエストさせていただきました！\n以下に概要を記載します。(TRPGのネタバレ等ありません)\n\n＊＊＊\n\n28歳/166cm　おっとりしたエレガントな雰囲気のお姉さん。かつて舞台役者をやっており、裏方に回った今でもまだ舞台上への憧れがある。主役としてスポットライトを浴びたい。\n\nいつもニコニコしているが、自分の望みのためなら仲間であっても切り捨てるような、利己的で幼い一面も持っている。\nレイピアを使った殺陣が得意。\n\n服装は資料の通りでなくても構いません。黒を基調とした、大人っぽいクラロリ風味の服を好みます。\n\n画像資料：https://drive.google.com/drive/folders/1GGQAYjWUE3qzDj60IcKjiItViOxOdmiS\n\n＊＊＊\n舞台上でスポットライトを浴びている(もしくは体の一部しか浴びられていない)ような姿をイメージしています。ニコニコとした笑みを浮かべていてほしいです。\nレイピアを持っていたり、血がついていたりと、不穏な雰囲気があっても嬉しいです。\n\n\nいろいろと書きましたが、葬田さんのお好きに描いていただけると幸いです！ぜひよろしくお願いします。", "created_at": "", "completed_at": ""}]}