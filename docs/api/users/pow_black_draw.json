8dbe336-ae5a-4f6c-b9b6-98f263c6d083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4973fe1c2d1fba868335fc291e2864", "thumbnail_srcset": "https://si.imgix.net/4645244b/uploads/origins/18dbe336-ae5a-4f6c-b9b6-98f263c6d083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4973fe1c2d1fba868335fc291e2864, https://si.imgix.net/4645244b/uploads/origins/18dbe336-ae5a-4f6c-b9b6-98f263c6d083?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded091f327799ab0d9894d7c67c28c62 2x, https://si.imgix.net/4645244b/uploads/origins/18dbe336-ae5a-4f6c-b9b6-98f263c6d083?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=614966eee611318baea9f70e0d9bba24 3x", "genre": "art", "nsfw": false, "body": "こんにちは！最近、私の友人であるGeitorのために、ビデオゲーム \"Hunt Showdown \"の中で彼がしたイタズラにちなんだ依頼をしましたね。\n\n彼は僕にその絵を見せてくれて、僕はそれが気に入ったんだ！だから、自分のために作品を依頼したいんだ！\n\nこのアートでは、私のキャラクターが恐怖で逃げ惑う彼のキャラクターにリボルバーを向けるようにしたい。私のキャラクターは足の周りに有刺鉄線を巻いて、彼が仕掛けた罠に私がはまったことを表現したい。\n\n僕のキャラクターと彼が使う銃のリファレンスは添付のグーグルドライブにあります。わかりやすくするために、ガイターがあなたに依頼したアートも添付しました。\n\nあなたの返事を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1T8zkyfDuBcMmCNRKJEvOGBCAhCWaqUWi?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pow_black_draw/works/32", "thumbnail_src": "https://si.imgix.net/9ea143f1/uploads/origins/52762191-9290-4f6c-a349-7cbcbc3134b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd0dfe9e0147bd4975432cd62e8e0131", "thumbnail_srcset": "https://si.imgix.net/9ea143f1/uploads/origins/52762191-9290-4f6c-a349-7cbcbc3134b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd0dfe9e0147bd4975432cd62e8e0131, https://si.imgix.net/9ea143f1/uploads/origins/52762191-9290-4f6c-a349-7cbcbc3134b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df792994f70b231ef109b6a2b1779a48 2x, https://si.imgix.net/9ea143f1/uploads/origins/52762191-9290-4f6c-a349-7cbcbc3134b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b616b4b7702819fab9e4152237230fe3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はゲームハント対決1896で自分の面白い写真を取得したかった。写真自体はモノトーンカラーで、黒と白の濃淡があります。参考画像のように、誘惑されているかのように額に汗を垂らしながら、心配そうな顔で鉄条網の罠を構えている僕だ。帽子はかぶっておらず、目は少し青ざめている。\n\n肩の後ろで耳元でささやくのも、シャツを着ていない別バージョンの私だ。目の下には黒い袋があり、顔はもっと邪悪でいたずらっぽい笑みを浮かべている。その \"邪悪な私 \"は帽子をかぶり、片目を覆いながら顔に暗い影を落としている。邪悪な私」は私の肩にしっかりと手を置いている。\n\nまるで、こう囁いているかのようだ。チームメイトがその上を走って気絶しても、それは注意を怠った彼らの責任であって、あなたの責任ではない！」。\n\nhttps://drive.google.com/drive/folders/14faCu6RI7YtVolBBvenXM5SSevFk3SW9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pow_black_draw/works/31", "thumbnail_src": "https://si.imgix.net/f3933f1c/uploads/origins/a568a05e-73f0-4bf1-86d1-d70ef045fc5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa99de916cc9bf19b37e4ab25037190", "thumbnail_srcset": "https://si.imgix.net/f3933f1c/uploads/origins/a568a05e-73f0-4bf1-86d1-d70ef045fc5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa99de916cc9bf19b37e4ab25037190, https://si.imgix.net/f3933f1c/uploads/origins/a568a05e-73f0-4bf1-86d1-d70ef045fc5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67476f870b8eb30b6d942eefbb4d9e68 2x, https://si.imgix.net/f3933f1c/uploads/origins/a568a05e-73f0-4bf1-86d1-d70ef045fc5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51911724795c0d1683576b14d54775ba 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのアートスタイルが大好きです。服装は刑務所の監視員の服です。彼女は不吉か邪悪であるべきです。よろしくお願いします。\n服装\nhttps://drive.google.com/drive/folders/1pUKuTLTRkYuMuzFU__vTnfL9U3bJzt_5\nOC：\nhttps://drive.google.com/drive/folders/1gFHeI86Nf0039bRDJsIdC_-nDsv-w6Gu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pow_black_draw/works/30", "thumbnail_src": "https://si.imgix.net/eada899a/uploads/origins/7ff00a87-5e09-4ff5-b2e2-bcf84fc6a767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro