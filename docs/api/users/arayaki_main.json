%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bd74113179aaee64a48e83582f8570e", "thumbnail_srcset": "https://si.imgix.net/d3efb853/uploads/origins/47746897-9526-4290-9417-5b2db86c74f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bd74113179aaee64a48e83582f8570e, https://si.imgix.net/d3efb853/uploads/origins/47746897-9526-4290-9417-5b2db86c74f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e5dbb7dae51fca45932003357331b5e 2x, https://si.imgix.net/d3efb853/uploads/origins/47746897-9526-4290-9417-5b2db86c74f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc571f5896e36c5c7990c9e5ae1c2ae5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お元気ですか。はい、「XV観客少女」の作品が欲しいです。\n\nhttps://drive.google.com/drive/folders/1f57HhhCVd3jEwpxK8w-4Lgu6D8peefm6\n\n水着かバニースーツでお願いします。\n\nhttps://x.com/arayaki_main/status/1849017931986055328\nhttps://x.com/arayaki_main/status/1854801829785395622?t=5YJoGBX9aEw_ekFCcjKTRQ&s=19\n\n怪我からの回復を意味する大きな傷跡を胸につけてほしい。\n\n肩には小さなコウモリの姿をしたミライアーク。\n\n彼らの表情は、あなたの芸術的解釈にお任せします。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/9", "thumbnail_src": "https://si.imgix.net/9a9f07b7/uploads/origins/4939d487-0bf8-4224-9ad9-7e94957b180d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ac2222fe24379708c48da72e53c8a1b", "thumbnail_srcset": "https://si.imgix.net/9a9f07b7/uploads/origins/4939d487-0bf8-4224-9ad9-7e94957b180d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ac2222fe24379708c48da72e53c8a1b, https://si.imgix.net/9a9f07b7/uploads/origins/4939d487-0bf8-4224-9ad9-7e94957b180d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85532d61574a201bae53b9fb14f7fb93 2x, https://si.imgix.net/9a9f07b7/uploads/origins/4939d487-0bf8-4224-9ad9-7e94957b180d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db02320fdf7a2c3b2e96e939b9e6aa56 3x", "genre": "art", "nsfw": false, "body": "どうも、前回はありがとうございました。今回もよろしくお願いします。\n\n　今回の依頼は、かつての食べフォギアの、以下のシーンのリアル等身&カラー化をお願いしたいのです。\n・切ちゃんが天ぷらのために蓮根掘りしてて「底なし沼デース！💦」てなってるシーン(腕の肘くらいから先が泥んこで体や顔も所々泥で汚れてるとありがたいです)\n・むつかけしてるマリア\n・ビッキーがクリームに埋もれまみれながら巨大ケーキ食べてるシーン\n・調ちゃんの夢の中で切ちゃんと調ちゃんがチョコ沼にはまってるシーン\n・落ちてきた巨大パイからクリームまみれになったマリアが「切歌ーーっ！！💢」と出てくるシーン(あのセクシーなボディラインがくっきりしてたら嬉しいです♥)\n\n以上の5シーンです。どうかよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/8", "thumbnail_src": "https://si.imgix.net/7e3a65a7/uploads/origins/ac6dc8ca-f471-4a0f-b2e0-0552f0e47e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d77ec29d7b0c38dabdc31d0b945249b1", "thumbnail_srcset": "https://si.imgix.net/7e3a65a7/uploads/origins/ac6dc8ca-f471-4a0f-b2e0-0552f0e47e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d77ec29d7b0c38dabdc31d0b945249b1, https://si.imgix.net/7e3a65a7/uploads/origins/ac6dc8ca-f471-4a0f-b2e0-0552f0e47e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e763c8ea86461d41edc7953b6a7005a9 2x, https://si.imgix.net/7e3a65a7/uploads/origins/ac6dc8ca-f471-4a0f-b2e0-0552f0e47e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=068ae9cc9035cbf130481263b392cff8 3x", "genre": "art", "nsfw": false, "body": "こんにちは。XV観客の少女」とミライアークの作品が欲しいです。\n\n続編が欲しいです。\n\nミライアークに片手に観客の女の子を持たせて、もう片方の手で点滴の機械を持たせる。\n二人は食堂に食事に行く。\n\nミライアークが観客の女の子と友達になろうとしている間、観客の女の子は食事をする。ミライアークは、自分が今ウェイトレスをしていることを話す。\n\n観客の女の子はまだ疑問を抱いているが、ミライアークの話を少しずつ聞き始める。\n\n看護師が到着し、点滴マシンに血液バッグを取り付ける時間だと言う。看護師は生理食塩水の入ったバッグを取り出し、血液の入ったバッグを取り付ける。\n\n観客の少女は、怪我のせいでまだ貧血気味だ。\n\nミライアークは、その血液が以前彼女が必要としていた珍しい血液型であることに気づく。彼女は驚く。\n\n看護師は立ち去るが、アラームが鳴る。彼女が戻ると、ミライアークが血を飲んでいるのが見えた。\n\n観客の少女は貧血のように見え、ミライアークに腹を立てる。観客の少女は不信感を抱いている。\n\nhttps://skeb.jp/@arayaki_main/works/6", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/7", "thumbnail_src": "https://si.imgix.net/7308e98c/uploads/origins/395591c5-965c-4631-a2f8-6f5d86e87328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca3df6ad1d6df4630021ad3a64e0e829", "thumbnail_srcset": "https://si.imgix.net/7308e98c/uploads/origins/395591c5-965c-4631-a2f8-6f5d86e87328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca3df6ad1d6df4630021ad3a64e0e829, https://si.imgix.net/7308e98c/uploads/origins/395591c5-965c-4631-a2f8-6f5d86e87328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d3c90ff882fe2f1d608839741e203bc 2x, https://si.imgix.net/7308e98c/uploads/origins/395591c5-965c-4631-a2f8-6f5d86e87328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30a824e837e61f86db19660a2cb84fe0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、依頼お願いします。\n今回は卵かけ雪音と響それぞれのスロットの7を狙えカットイン演出風のヘッダー用イラストをお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/6", "thumbnail_src": "https://si.imgix.net/b3312417/uploads/origins/a1a607f2-f1b9-4971-9b1f-e43eb558f6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10fc4c9b62670b0e927081cb30292a5f", "thumbnail_srcset": "https://si.imgix.net/b3312417/uploads/origins/a1a607f2-f1b9-4971-9b1f-e43eb558f6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10fc4c9b62670b0e927081cb30292a5f, https://si.imgix.net/b3312417/uploads/origins/a1a607f2-f1b9-4971-9b1f-e43eb558f6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=173927bd0ba78d4e392ddbb3f54a6833 2x, https://si.imgix.net/b3312417/uploads/origins/a1a607f2-f1b9-4971-9b1f-e43eb558f6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e41a68698e3c24a207392d13c3d9d39 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お元気ですか。はい、「XV観客少女」の作品が欲しいです。\n\nミライアークにも出てほしいです。\n\nこんな画風でお願いします：\nhttps://skeb.jp/@arayaki_main/works/2\n\nシンフォギアの漫画では、みんな生き返ったことになっていますね。\n\nXVの観客の女の子は、病院で療養中であってほしい。病衣を着てほしい。\n\nミライアークはウェイトレス姿であってほしい。\n\nミライアークがXVの観客の女の子にコンサートでのことを謝ろうとしているシナリオが欲しい。しかし、XVの観客の女の子はミライアークを許せず、無視している。\n\nミライアークはXVの観客の女の子の胸の包帯を変えるのを手伝う。\n\nXVの観客は車椅子に座り、ミライアークはそれを押して廊下を歩く。\n\n点滴棒を持って歩くXV観客の少女と、歩こうとする少女がバランスを保つのを助けるミライアーク。\n\nXVの観客の少女は何をすればいいのかわからない。基本的にミライアークは償いをしようとしている。\n\nhttps://drive.google.com/drive/folders/1f57HhhCVd3jEwpxK8w-4Lgu6D8peefm6", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/5", "thumbnail_src": "https://si.imgix.net/8f30bba7/uploads/origins/987c775f-300c-415a-ab92-d3c25cea3547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6596c9621bef06a0d0e780a94eeea26", "thumbnail_srcset": "https://si.imgix.net/8f30bba7/uploads/origins/987c775f-300c-415a-ab92-d3c25cea3547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6596c9621bef06a0d0e780a94eeea26, https://si.imgix.net/8f30bba7/uploads/origins/987c775f-300c-415a-ab92-d3c25cea3547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70db93684bbd5c9f08581a6ae2735926 2x, https://si.imgix.net/8f30bba7/uploads/origins/987c775f-300c-415a-ab92-d3c25cea3547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7386b28f88ac45675a7b2ca85031ae2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お元気ですか。はい、「XV観客少女」の作品が欲しいです。\nhttps://drive.google.com/drive/folders/1f57HhhCVd3jEwpxK8w-4Lgu6D8peefm6\n\nこっちのクリスを描いた服を着てほしいです：\nhttps://twitter.com/arakure2/status/1736014376191070483\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/4", "thumbnail_src": "https://si.imgix.net/319973cc/uploads/origins/e5664269-bf5f-46bb-b962-239bc7d2226b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=200ceba28c109b7b320331619caa21cc", "thumbnail_srcset": "https://si.imgix.net/319973cc/uploads/origins/e5664269-bf5f-46bb-b962-239bc7d2226b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=200ceba28c109b7b320331619caa21cc, https://si.imgix.net/319973cc/uploads/origins/e5664269-bf5f-46bb-b962-239bc7d2226b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=278ded0bad7214f1773e459466d1bc6a 2x, https://si.imgix.net/319973cc/uploads/origins/e5664269-bf5f-46bb-b962-239bc7d2226b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8b07b9b2c255e48421b62e207515e99 3x", "genre": "art", "nsfw": false, "body": "初に依頼いたします。\n\nシンフォギアXV11話で、精神内の未来が黒い包帯？で巻かれてるシーンがあるでしょう。あれをぜひあらやきさんの絵で、下記の差分付きで見てみたいのです！\n①　本編同様、胸から下と上腕から先が巻かれてる状態。表情はシェム・ハに耳舐めされた時みたく見開いた目に涙浮かべてる\n②　本編にもあった、①の片目が包帯に隠されたバージョン\n③　一瞬映った、②の両目バージョン\n\n（ここから本編にない私オリジナルの差分です(笑)）\n\n④　①の首から下全てが巻かれたバージョン\n⑤　鼻から下全てが巻かれてるバージョン（鼻は形のみ、口は凹みのみ）\n⑥　⑤に③の両目隠しを加えたの\n⑦　生え際から下全てが巻かれた状態（鼻形のみと口凹みに、目元の窪みのみを追加）\n⑧　頭のてっぺんまで巻かれ、坊主頭の所々から毛先の一部がはみ出している\n\n長くかつ細かくなってしまいすみません。どうかお願いします！\n\nhttps://youtu.be/MjnoFwKq-VE?si=h-EgIeymPlSPVxUv", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/3", "thumbnail_src": "https://si.imgix.net/e3cd1099/uploads/origins/0d704f2f-5a6d-4b60-a974-56222e096084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f5d00b65c8ab87e3f5f13edec949113", "thumbnail_srcset": "https://si.imgix.net/e3cd1099/uploads/origins/0d704f2f-5a6d-4b60-a974-56222e096084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f5d00b65c8ab87e3f5f13edec949113, https://si.imgix.net/e3cd1099/uploads/origins/0d704f2f-5a6d-4b60-a974-56222e096084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=757736ee35ca5ea1cc0523a9a85af434 2x, https://si.imgix.net/e3cd1099/uploads/origins/0d704f2f-5a6d-4b60-a974-56222e096084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3be664d39adb1cdc2a8b9cf615ce0210 3x", "genre": "art", "nsfw": false, "body": "こんばんは！以前食べフォギアでこちらのお題(https://twitter.com/arakure2/status/1693578700409717161?t=IYLshDjq9fWY9yGxoN8vyw&s=19)をさせていただいた者です！今回是非こちらの続きを是非ともお願いしたいと思います。\n\n内容としては、砂浜に座ってビールをグビグビ飲む巨大なマリア。その巨大な足裏にこびりついたアイスの残骸をみて抗議する調・切歌・クリスの3人。しかし酔ったマリアから見るとおつまみが喋っているようにしか見えず、「最近のおつまみはしゃべるのねぇ」と言いながら3人をつまみあげて食べちゃおうとするマリアと必死に食べないでと呼びかける3人をよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/2", "thumbnail_src": "https://si.imgix.net/5f1c91f3/uploads/origins/22a47f22-4a3f-41e9-b98b-c6076fb1f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=102c46a1f78cfc8ea51239bbd459ef51", "thumbnail_srcset": "https://si.imgix.net/5f1c91f3/uploads/origins/22a47f22-4a3f-41e9-b98b-c6076fb1f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=102c46a1f78cfc8ea51239bbd459ef51, https://si.imgix.net/5f1c91f3/uploads/origins/22a47f22-4a3f-41e9-b98b-c6076fb1f124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdb1356641a337d4f14d8b37087d1952 2x, https://si.imgix.net/5f1c91f3/uploads/origins/22a47f22-4a3f-41e9-b98b-c6076fb1f124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f13b7e1f2d7b8c8fe8654221182c606f 3x", "genre": "art", "nsfw": false, "body": "おはようございます！リクエストよろしいでしょうか？\nシンフォギアの切歌とクリスが洞窟？の中で雨宿りしてたけど、そこはセパレート水着の巨大な響のおへそ様の中で、響は「２人ともわたしのおへその中にいたんだね～」と呑気そうに呟き、切歌が「響のおへそだったデース♪」と笑いクリスがびっくりする光景をお願いします！３人とも食べフォギアみたいにデフォルメでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@arayaki_main/works/1", "thumbnail_src": "https://si.imgix.net/395ef259/uploads/origins/1c4b4d79-8801-4cba-9cce-dc7b6aedef4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0507013eb334546fa029ecf7a8c3eb", "thumbnail_srcset": "https://si.imgix.net/395ef259/uploads/origins/1c4b4d79-8801-4cba-9cce-dc7b6aedef4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0507013eb334546fa029ecf7a8c3eb, https://si.imgix.net/395ef259/uploads/origins/1c4b4d79-8801-4cba-9cce-dc7b6aedef4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8f3cc8c4300717752c82b265d5ad5b4 2x, https://si.imgix.net/395ef259/uploads/origins/1c4b4d79-8801-4cba-9cce-dc7b6aedef4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3744cf39c64ae54862c60762b35ea47b 3x", "genre": "art", "nsfw": false, "body": "こんばんは、依頼お願いします。\nあらやきさんの卵かけ装者が好きなのでそれを使ったヘッダーアイコンを描いて頂きたいです。\n内容は卵かけ翼でスロットの7を狙えカットイン演出風のイラストをお願いします。", "created_at": "", "completed_at": ""}]}