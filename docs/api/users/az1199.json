iscordapp.net/attachments/1316255268866228225/1453782180407804128/dream_ref22.png?ex=69569ca9&is=69554b29&hm=69b3aaae65bb43fb137dee253a3c5f5247f70ec7cc764b375fc6affa5327513f&=&format=webp&quality=lossless&width=1422&height=974", "created_at": "", "completed_at": ""}, {"path": "/@az1199/works/83", "thumbnail_src": "https://si.imgix.net/5262be44/uploads/origins/11deb786-53fc-4bab-860f-07426f16bb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98e0405b07cb0bebfdec8abf6ab0da11", "thumbnail_srcset": "https://si.imgix.net/5262be44/uploads/origins/11deb786-53fc-4bab-860f-07426f16bb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98e0405b07cb0bebfdec8abf6ab0da11, https://si.imgix.net/5262be44/uploads/origins/11deb786-53fc-4bab-860f-07426f16bb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=531c6f6e53d99d1d0712bda71f18bece 2x, https://si.imgix.net/5262be44/uploads/origins/11deb786-53fc-4bab-860f-07426f16bb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4994dd43e2f574a34c154b8539cdab7c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ あなたの画風がとても気に入っています。\n私のオリジナルキャラクター2人を描いていただけませんか？\n\nキャラクターの特徴\n\n● 男の子\n\n* 中性的な顔\n* 淡い茶色のボブヘア（肩あたりの長さ）\n* オレンジ色の瞳\n* キツネのアイコンが描かれた黒い帽子、黒い手袋\n* 赤系の制服、ベージュのズボン\n* 黒い靴下に茶色のローファー\n* 無口でツンデレ\n\n● 女の子\n\n* 薄い緑色の髪（毛先はピンク）\n* 赤い瞳\n* フード付きのグレーのレインコート\n* 花柄の白いスカート\n* 梨の花のヘアピン\n* 黒いストッキング、茶色のブーツ\n* 白い傘などの小物\n* 優しい性格の文学少女\n\n二人の身長はほとんど同じだが、男の子のほうが少しだけ高いです。衣装はURL内のオリジナルでも問題ありませんし、自由にアレンジしていただいても大丈夫です。\n形式はお任せします。\nURL 内の画像資料をご確認ください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1hCAJguKPhxH2SrSkTqeKcuUTGC7LjvOF\n\nhttps://drive.google.com/drive/folders/1hCAJguKPhxH2SrSkTqeKcuUTGC7LjvOF", "created_at": "", "completed_at": ""}, {"path": "/@az1199/works/82", "thumbnail_src": "https://si.imgix.net/32197816/uploads/origins/a76520f9-ecd5-4c3d-84de-2a782312fcfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7