2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4535462afafb39951c61f022a7d61a9b 2x, https://si.imgix.net/96eb2a39/uploads/origins/4af6c3d3-38e4-4f15-81b8-3735fce316ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8988b645dfec53e425052f70e58741b0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nyapo_22/works/41", "thumbnail_src": "https://si.imgix.net/da237bb1/uploads/origins/27fdaee8-c3f8-48f6-a4bb-cee4b8226bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1c5f1959bcbb78e5e07891c09ac7b2d", "thumbnail_srcset": "https://si.imgix.net/da237bb1/uploads/origins/27fdaee8-c3f8-48f6-a4bb-cee4b8226bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1c5f1959bcbb78e5e07891c09ac7b2d, https://si.imgix.net/da237bb1/uploads/origins/27fdaee8-c3f8-48f6-a4bb-cee4b8226bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca7ad7a3644f4d9676b9e203ada48776 2x, https://si.imgix.net/da237bb1/uploads/origins/27fdaee8-c3f8-48f6-a4bb-cee4b8226bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3c3c868cb81c9f9a0fa8294e0872264 3x", "genre": "art", "nsfw": false, "body": "にゃぽ様\n初めまして新人Vtuberの深層はてなと申します。\nこの度はVtuber活動に使用させて頂くイラストをご依頼したいと思いご連絡させて頂きました。\n使用用途はアイコン、サムネイル等を考えておりますので透過素材も頂ければ幸いです。\n私はにゃぽ様の描く表情やポーズがとても好きなので、それらはおまかせ致します。\n衣装は新ビジュ（黒と赤のワンピースのもの）でお願いしたいです。\nお忙しいとは思いますがご検討よろしくお願いします。\n\n資料\nhttps://drive.google.com/drive/folders/1rC6Gl3ONcatYxY_zXSVPuksJr9Zq1Zig\n\nhttps://drive.google.com/drive/folders/1rC6Gl3ONcatYxY_zXSVPuksJr9Zq1Zig", "created_at": "", "completed_at": ""}, {"path": "/@nyapo_22/works/40", "thumbnail_src": "https://si.imgix.net/84342e09/uploads/origins/c0660e1f-e845-443b-89e8-0fa5bd213bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8890afafb8f4cb2470b094678fcfb517", "thumbnail_srcset": "https://si.imgix.net/84342e09/uploads/origins/c0660e1f-e845-443b-89e8-0fa5bd213bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8890afafb8f4cb2470b094678fcfb517, https://si.imgix.net/84342e09/uploads/origins/c0660e1f-e845-443b-89e8-0fa5bd213bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da65d5e22327c89cd4bc4e6382f3e498 2x, https://si.imgix.net/84342e09/uploads/origins/c0660e1f-e845-443b-89e8-0fa5bd213bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d18b5cdd561f04086e929aaa87e88c15 3x", "genre": "art", "nsfw": false, "body": "はじめまして。あるぱかと申します。\n先生の描かれる暖かく優しい雰囲気のイラストを拝見し、私が考えているイラストを是非先生に描いて頂きたいと思いましたので依頼させて頂きます。\n\n《使用用途》\n現在配信活動休止中のらむ睡眠さんが復帰する際に復帰祝いとして、同じく配信者で友人の冬海かごめさんとのペアイラストをプレゼントしたいと考えております。\n本人へプレゼントする際のX（Twitter）への投稿や、本人が配信活動の一環として各プラットフォームのアイコンやヘッダー、配信サムネイル等に使用する可能性がございます。\nそのため、よろしければ人物は頭が見切れず、背景等をレイヤー分けして納品いただきたいです。\nNGな事がございましたら他レイヤーにて教えて頂けますと幸いです。\n\n《依頼詳細》\nらむ睡眠さん（以下A）と冬海かごめさん（以下B）のイラストを描いて頂きたいです。\n\n以下がふたりの関係と特徴です\nふたりは友人ですが姉妹のような関係で、BはAが配信活動を再開することを心待ちにしていました。\nAの特徴は\n・活発で明るい性格で妹みたいな雰囲気\n・薄いピンクみがかった白色の髪の毛\n・お団子ヘアー\nです\nBの特徴は\n・おしとやかでお姉さんのような雰囲気\n・ピンクの髪の毛\n・星型の髪留めと水色のリボン\nです\n\n次に構図ですが、復帰祝いということで再会というテーマで、時期は春ごろになりそうなので春の背景にしていただきたいです。\nまた、表情はAがうれし泣きをしていて、Bは微笑んでいると本人たちの雰囲気っぽくなると思いますが、難しいようであれば、表情はお任せいたします。\nその他の構図はお任せでお願いいたします。\n\n納品の形式に関しては\n解像度は壁紙サイズ（16:9）にして頂きたいです。\n可能であればPSDデータで頂きたいです。\n背景・サイン・人物等、レイヤーを分けて頂けますと幸いです。\n\n資料はこちらを（https://drive.google.com/drive/folders/1WzI6mPuWtrotgQqbeJwARTkU44IKAyO6?usp=sharing）ご参照ください。\n\nご多忙とは存じますが、ご検討頂けますと幸いです。\n以上よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WzI6mPuWtrotgQqbeJwARTkU44IKAyO6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nyapo_22/works/39", "thumbnail_src": "https://si.imgix.net/171180a9/uploads/origins/0281bb1e-c17e-40bb-827d-9fca20c40f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66851334c191830cafa6389374cef70a", "thumbnail_srcset": "https://si.imgix.net/171180a9/uploads/origins/0281bb1e-c17e-40bb-827d-9fca20c40f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66851334c191830cafa6389374cef70a, https://si.imgix.net/171180a9/uploads/origins/0281bb1e-c17e-40bb-827d-9fca20c40f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=043207606bfa3d912b406d93a4534f5e 2x, https://si.imgix.net/171180a9/uploads/origins/0281bb1e-c17e-40bb-827d-9fca20c40f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=238828c10ae5ab1ee9e9bc902acfdbe6 3x", "genre": "art", "nsfw": false, "body": "にゃぽさん はじめまして\n\nにゃぽさんの端正で美しくて優しいイラストがとても好きで、ご依頼をさせて頂きたく思いました。\n\n今回お願いしたいのが、クトゥルフ神話TRPGの『花冷えに亡く季節』というシナリオにて作成した、自分たちのキャラクターになります。\n\nエンディング・各HOの秘匿情報も含めた自キャラたちの詳細を記載致しました。\nネタバレされると...であればお断りいただいてももちろん大丈夫です。\nもしよろしければよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1279XfrVLIfqB7Qnzch_Pj5BHpl01Vj5L", "created_at": "", "completed_at": ""}, {"path": "/@nyapo_22/works/38", "thumbnail_src": "https://si.imgix.net/e4e51b7e/uploads/origins/48ddfe04-a8b8-4a2b-8f93-0dc392ef2bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1413fa42ce8ef348aa95de0480605e14", "thumbnail_srcset": "https://si.imgix.net/e4e51b7e/uploads/origins/48ddfe04-a8b8-4a2b-8f93-0dc392ef2bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1413fa42ce8ef348aa95de0480605e14, https://si.imgix.net/e4e51b7e/uploads/origins/48ddfe04-a8b8-4a2b-8f93-0dc392ef2bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4f3