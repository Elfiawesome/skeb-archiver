d7-47b2-8173-0471347e95f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e30941212ab550404111990f7d5d1341 2x, https://si.imgix.net/8f2fcbbd/uploads/origins/b6730e88-48d7-47b2-8173-0471347e95f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26edc87806eb959b93e1688b9a72aeaf 3x", "genre": "art", "nsfw": false, "body": "IRIAMで活動しております。万葉まよと申します。\n\n蛇ノ灰月ヨルさんへのプレゼントにイラストをご依頼させていただきたく連絡をいたしました。\n\nできればIRIAMでのサムネイル等活動にも使用したいと考えておりますので\n私と蛇ノ灰月ヨルさんは髪や衣装は見切れていない状態で、別々の透過データの納品があると嬉しいです。\n\n衣装や髪型、構図等は全てお任せにさせていただきます。\n記念のイラストなので、明るく華やかな雰囲気だと嬉しいです。\n\n私とご本人のXのURLを送付いたします。\nhttps://x.com/banbamayo\nhttps://x.com/yoru_heai\n\n是非描いていただけましたら嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@rb_crr/works/26", "thumbnail_src": "https://si.imgix.net/ff952c9b/uploads/origins/f9a7a0f7-129d-4366-90ed-d40a24ad1642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a797fffcf5f1b5e12cb18a20381fad02", "thumbnail_srcset": "https://si.imgix.net/ff952c9b/uploads/origins/f9a7a0f7-129d-4366-90ed-d40a24ad1642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a797fffcf5f1b5e12cb18a20381fad02, https://si.imgix.net/ff952c9b/uploads/origins/f9a7a0f7-129d-4366-90ed-d40a24ad1642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d392b97be97b7f8bde77e6accf1bc84e 2x, https://si.imgix.net/ff952c9b/uploads/origins/f9a7a0f7-129d-4366-90ed-d40a24ad1642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00c355cc2baeec5b91793c1b46035af9 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n\nRazzプロダクション所属  \nベル・ジェイドと申します。\n\nよもひろ様に描いて頂いた立ち絵の三面図を描いて頂きたくリクエストを送らせて頂きました。\n\n【内容】\n・立ち絵の三面図\nピアスや羽などのデザインや、カラーなども書いてくださるととても有難いです。\n見えない部分や後ろ側のデザインはお任せでお願いいたします。\n\n【使用用途】\n活動して行く上でのイラストやグッズの依頼、ファンアートを描いてくださる方への資料としてSNS等で使用させていただきます。\n\n以上となります。\n\nご多忙のところ、恐れ入りますが\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1v7k7omDR7Iz0uI9VwYQU5VitfvcdV5SS", "created_at": "", "completed_at": ""}, {"path": "/@rb_crr/works/25", "thumbnail_src": "https://si.imgix.net/3e575fba/uploads/origins/44e775d4-ad8d-4ccc-8705-80c0b01932ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe867b1a8a3f763f0cafbb12612cf8ee", "thumbnail_srcset": "https://si.imgix.net/3e575fba/uploads/origins/44e775d4-ad8d-4ccc-8705-80c0b01932ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe867b1a8a3f763f0cafbb12612cf8ee, https://si.imgix.net/3e575fba/uploads/origins/44e775d4-ad8d-4ccc-8705-80c0b01932ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=017b7e084da5385f7a6011f52c13cb3b 2x, https://si.imgix.net/3e575fba/uploads/origins/44e775d4-ad8d-4ccc-8705-80c0b01932ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b8af946a014113790a41f772894e885 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rb_crr/works/24", "thumbnail_src": "https://si.imgix.net/ebcd6413/uploads/origins/2df382fb-8151-4696-bd8a-6de60b70dc81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5559556493b6aef63c109ab97546d66b", "thumbnail_srcset": "https://si.imgix.net/ebcd6413/uploads/origins/2df382fb-8151-4696-bd8a-6de60b70dc81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5559556493b6aef63c109ab97546d66b, https://si.imgix.net/ebcd6413/uploads/origins/2df382fb-8151-4696-bd8a-6de60b70dc81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7592ee71321f36b91e3e88b4845c663d 2x, https://si.imgix.net/ebcd6413/uploads/origins/2df382fb-8151-4696-bd8a-6de60b70dc81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a63f8be390a58c9138cd5c4a3f167ce1 3x", "genre": "art", "nsfw": false, "body": "申し訳ありませんが、以前の依頼の3面図をリクエストすることはできますか？\n\n今後の依頼のためにキャラクターの詳細が必要なのですが。\n\n英語と日本語で添削します。\n\nシャミーラ\n\nhttps://skeb.jp/@rb_crr/works/23\n\nフロントビュー、サイドビュー、リアビュー、その他装備の詳細が必要。\n\n彼女の武器も含めて。", "created_at": "", "completed_at": ""}, {"path": "/@rb_crr/works/23", "thumbnail_src": "https://si.imgix.net/2ac899c3/uploads/origins/c78761ab-b87a-4bd3-a097-7a4faf5aaccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b58441a1099fdf7613c47db4583c485", "thumbnail_srcset": "https://si.imgix.net/2ac899c3/uploads/origins/c78761ab-b87a-4bd3-a097-7a4faf5aaccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b58441a1099fdf7613c47db4583c485, https://si.imgix.net/2ac899c3/uploads/origins/c78761ab-b87a-4bd3-a097-7a4faf5aaccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b1f8894fb7955a193761b8daa6283cb 2x, https://si.imgix.net/2ac899c3/uploads/origins/c78761ab-b87a-4bd3-a097-7a4faf5aaccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=856d2de2b35c5afbecb5e63e01ce858b 3x", "genre": "art", "nsfw": false, "body": "優秀な猫娘の魔法使いで、決して傲慢にならず、誰かを見下すこともなく、メンバーのために常に強くあろうとするオリジナルキャラクターを描いてほしい。\n\n魔法を研究し、魔法使いになりたい人たちに教えるのが好き。\n\n小説を読むのも好きだし、年下の孤児たちと遊ぶのも嫌いじゃない。\n\n名前：シャーミラ 16歳 身長165cm バストサイズD\n\n特に魔法を使うときに役立つような、武器として使える魔道書や杖を作ってあげてください。\n\n髪型はツインテール、髪と瞳の色は自由に選んでください。\n\n彼女の仲間とは違う色でなければならない。\n\n衣装デザインの参考\n\nhttps://files.catbox.moe/1xo5xx.png\n\nhttps://files.catbox.moe/j37939.jpg\n\nhttps://files.catbox.moe/ldqph1.jpg\n\nhttps://x.com/Black_White_SP/status/1642134823887327232\n\n彼女の仲間たち。\n\nhttps://files.catbox.moe/jh4pmo.png\n\nhttps://skeb.jp/@rb_crr/works/20\n\nhttps://skeb.jp/@fujijika/works/18", "created_at": "", "completed_at": ""}, {"path": "/@rb_crr/works/22", "thumbnail_src": "https://si.imgix.net/251b40dd/uploads/origins/f687e898-2561-4556-afd2-0eb737a77073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=228605bedac9695bc9adac92ef1d8df4", "thumbnail_srcset": "https://si.imgix.net/251b40dd/uploads/origins/f687e898-2561-4556-afd2-0eb737a77073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=228605bedac9695bc9adac92ef1d8df4, https://si.imgix.net/251b40dd/uploads/origins/f687e898-2561-4556-afd2-0eb737a77073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bf64eae4bd83925a1d91f1652c32506 2x, https://si.imgix.net/251b40dd/uploads/origins/f687e898-2561-4556-afd2-0eb737a77073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26d0a8e56bf5059b5dc4eb89bb2d9ad5 3x", "genre": "art", "nsfw": false, "body": "お久しぶりですお忙しい所申し訳ありませんがよろしくお願いします\nシアーミュージックVの\n魔ノ姫こあくさん　https://x.com/KoakuManohime\n戸根かすみさん　https://www.youtube.com/channel/UCknJpq8RDHDgpMn0gmXnITA\nのイラストをお願いします\n\nhttps://lit.link/SheerMusicV　こちらの一番下に三面図があります\n\n以前描いていただきましたこちら https://skeb.jp/@rb_crr/works/5 の様な雰囲気でおねがいします\n構図としてみことさん(赤い髪の子)とユッコさん(白い髪の子)の様に二人の体が少し中央側を向いていて顔は正面を向いていると良いです\n服装は公式イラスト(三面図)で大丈夫です\n背景は特に不要ですお任せ致します\n\n痛車用のイラストとして使用させていただきたい旨と配信者様のサムネ等に使用させていただくことのご了解を頂きたいです\n\nお時間よろしければよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@rb_crr/works/21", "thumbnail_src": "https://si.imgix.net/42f3ea83/uploads/origins/4ba896c2-21c9-4b19-a4d0-2fcf168483a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd07fccad87048116cea598a310d2a8", "thumbnail_srcset": "https://si.imgix.net/42f3ea83/uploads/origins/4ba896c2-21c9-4b19-a4d0-2fcf168483a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd07fccad87048116cea598a310d2a8, https://si.imgix.net/42f3ea83/uploads/origins/4ba896c2-21c9-4b19-a4d0-2fcf168483a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e8f53