d_at": ""}, {"path": "/@O_shirokumaru_O/works/10", "thumbnail_src": "https://si.imgix.net/46d1fab2/uploads/origins/aef58aa1-6590-4d86-a797-8a9bf21c46ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a725aabb55b28a36a74d9167d4ae2fa", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/9", "thumbnail_src": "https://si.imgix.net/36c1ab83/uploads/origins/691184cb-6dfc-4119-9b12-a9cca0e2405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c16de6fb7c5cf00ce5e1ceaf11b8495", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "アメリカからこんにちは！私はあなたのリリーのアート作品の大ファンで、私のために彼女のアート作品を描いてほしいのです。私が考えているのは、リリーが緋色の赤いセクシーなランジェリーを着て、見る人のためにストリップダンスをしているというものです。背景は特に決めていないので、もしあなたがこのアートに最適だと思うディテールがあれば、あなたの判断を信じます。", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/8", "thumbnail_src": "https://si.imgix.net/cddc9a89/uploads/origins/91083b8c-f385-44f8-863d-267e137cec35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0945dd4e9c0f3ee01ab1998b144d00ab", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/7", "thumbnail_src": "https://si.imgix.net/9ec34459/uploads/origins/09b7c9c8-3a83-48cb-a3d4-f3f6cc2456c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17c4dd7fde66d5149b7d9815f4caf53e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/6", "thumbnail_src": "https://si.imgix.net/48d11fc6/uploads/origins/65d3f90b-99bd-4c09-8f