p=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8f310790094bf22e8916473f2c4ed05 2x, https://si.imgix.net/2431bf12/uploads/origins/9cba40d7-2da9-48b4-92b6-61ff18460b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96b5f2b7323475ea940d67022669c65d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/11", "thumbnail_src": "https://si.imgix.net/fdb2fe09/uploads/origins/6e37844e-a4f8-4538-9234-0c7f2cdff612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35adcd42b06ba71c9fab06c4b4dbcef7", "thumbnail_srcset": "https://si.imgix.net/fdb2fe09/uploads/origins/6e37844e-a4f8-4538-9234-0c7f2cdff612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35adcd42b06ba71c9fab06c4b4dbcef7, https://si.imgix.net/fdb2fe09/uploads/origins/6e37844e-a4f8-4538-9234-0c7f2cdff612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b88d5bd03717103a0c84800441be317 2x, https://si.imgix.net/fdb2fe09/uploads/origins/6e37844e-a4f8-4538-9234-0c7f2cdff612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7a300055c5332304186a80e445c60e8 3x", "genre": "art", "nsfw": true, "body": "はじめまして。貴殿のリーリエイラストが好みで、リクエストさせていただきました。\n\nシチュエーションですが、リーリエの服装、髪型は下記URLのイラストそのままで、タイツではなく黒ニーハイソックスでお願いします。\nhttps://www.pixiv.net/artworks/127587557\n\nイラスト①\n外回り中にスカートの中を盗撮され、逆さ撮りのパンツが丸見えなイラスト。パンツは下記イラスト\nhttps://www.pixiv.net/artworks/127996887\nの水色リボンの白パンツで、クロッチありでお願いします。\nまた、下記イラストのように、右側に立ち絵、左側に盗撮イラスト(正面からとお尻側からの2種類)が有り難いです。\nhttps://www.pixiv.net/artworks/131110587\n立ち絵は下記イラストのような表情、ポーズでお願いします。\nhttps://www.pixiv.net/artworks/126379175\n\nイラスト②\nイラスト①の立ち絵差分として、\nリーリエ自身がスカートをたくしあげてパンツを見せている状態のイラスト。パンツの色はイラスト①と同じで、パンツのリボンが見えるほどスカートをたくしあげている状態でお願いします。\n表情は恥ずかしがっていて、イラスト右側にスカートをたくし上げたリーリエの立ち絵、左側にパンツ部分(正面側とお尻側両方)拡大イラストをお願いします。\n\n長文ではありますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/10", "thumbnail_src": "https://si.imgix.net/46d1fab2/uploads/origins/aef58aa1-6590-4d86-a797-8a9bf21c46ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a725aabb55b28a36a74d9167d4ae2fa", "thumbnail_srcset": "https://si.imgix.net/46d1fab2/uploads/origins/aef58aa1-6590-4d86-a797-8a9bf21c46ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a725aabb55b28a36a74d9167d4ae2fa, https://si.imgix.net/46d1fab2/uploads/origins/aef58aa1-6590-4d86-a797-8a9bf21c46ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab08c835da471caa78a6a78d3b59b8c2 2x, https://si.imgix.net/46d1fab2/uploads/origins/aef58aa1-6590-4d86-a797-8a9bf21c46ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf8540db60a15c2124207e19e1461120 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@O_shirokumaru_O/works/9", "thumbnail_src": "https://si.imgix.net/36c1ab83/uploads/origins/691184cb-6dfc-4119-9b12-a9cca0e2405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c16de6fb7c5cf00ce5e1ceaf11b8495", "thumbnail_srcset": "https://si.imgix.net/36c1ab83/uploads/origins/691184cb-6dfc-4119-9b12-a9cca0e2405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c16de6fb7c5cf00ce5e1ceaf11b8495, https://si.imgix.net/36c1ab83/uploads/origins/691184cb-6dfc-4119-9b12-a9cca0e2405c?bg=%23fff&auto=for