86-d9807f2731a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5471621602bc7e723772484d6188ee9f 2x, https://si.imgix.net/e59ec40b/uploads/origins/84defff5-dd58-4054-aa86-d9807f2731a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37d96c16940308495c5ee4141d29c851 3x", "genre": "art", "nsfw": false, "body": "川上先生こんにちは。\n今回初めて依頼します。\n\n依頼内容はあなたの週間ブリックの榎田ちゃんと蟻月くんとうちのRLコンビをリクエストします。\n\n構図としましては\n榎田ちゃんとLがメインで\n蟻月くんとRが隠れキャラみたいに奥にちっちゃくいる感じでお願いします。\n\nどや笑顔榎田ちゃんと満面笑みなLがふたりとも縦長なへそが見えるようなセクシーポーズを。\n榎田ちゃんの衣装は脱ぎかけ制服でお願いします。\n\n蟻月くんとRはこちらを見て、少々呆れ気味な表情でお願いします。\n\nhttps://twitter.com/ri9de74/status/1490245392147320839?t=89PTxiVbbbg6mYIxUFRiug&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kwkmbrick/works/6", "thumbnail_src": "https://si.imgix.net/72b43f1d/uploads/origins/4637a115-5a4b-40f9-bafb-53de10670928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eae636d24a424dc3dd77e39a38a6826e", "thumbnail_srcset": "https://si.imgix.net/72b43f1d/uploads/origins/4637a115-5a4b-40f9-bafb-53de10670928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eae636d24a424dc3dd77e39a38a6826e, https://si.imgix.net/72b43f1d/uploads/origins/4637a115-5a4b-40f9-bafb-53de10670928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b80046c735848fa002a5860552ff752b 2x, https://si.imgix.net/72b43f1d/uploads/origins/4637a115-5a4b-40f9-bafb-53de10670928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cbc82c913be096df1c9283d49b3c59e 3x", "genre": "art", "nsfw": false, "body": "クール敬語口調同級生が大好きで、\n同じぐらい戦場のヴァルキュリアのセルベリアが大好きなので\nハイブリットした感じのイラストをお願い致します\n\nクール敬語口調同級生の衣装のセルベリア or セルベリア水着のクール敬語口調同級生、\nみたいなイメージです\n\nセルベリア\nhttps://mobile.twitter.com/raita_z/status/1457684757106421761\n\nクール敬語口調同級生の衣装は下記とか大好きです。\nhttps://twitter.com/kwkmbrick/status/1435966825561419783\n1476888429548163072", "created_at": "", "completed_at": ""}, {"path": "/@kwkmbrick/works/5", "thumbnail_src": "https://si.imgix.net/d88098ed/uploads/origins/a47c0939-8658-45da-b030-59622d300e08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e71408b829bf3c8c44a8bd5887c0ce5", "thumbnail_srcset": "https://si.imgix.net/d88098ed/uploads/origins/a47c0939-8658-45da-b030-59622d300e08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e71408b829bf3c8c44a8bd5887c0ce5, https://si.imgix.net/d88098ed/uploads/origins/a47c0939-8658-45da-b030-59622d300e08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2bd458b664401731e5cd83b7c760c14 2x, https://si.imgix.net/d88098ed/uploads/origins/a47c0939-8658-45da-b030-59622d300e08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a629783226a2de244d85be498e2020ab 3x", "genre": "art", "nsfw": false, "body": "いつも週刊ブリックを楽しく読ませていただいております。私は3度の飯より競泳水着が好きなので、ぜひ榎田と柊木が競泳水着を着て並んでいるイラストをお願いしたいです。肩から脚へ繋がるラインが特に好きなので可能ならば足先までの全身を描いてほしいです。\n競泳水着のデザインは『アイドルマスターシンデレラガールズ』の新田美波が（ノーブルヴィーナス）で着ているものが至高と個人的に思うので似せてもらえれば幸いです。\n色はモノクロで構いません。\n他、具体的な構図等は三上三塁手先生にお任せします。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kwkmbrick/works/4", "thumbnail_src": "https://si.imgix.net/dc43e228/requests/151081_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a203602d30c6dfd4353413e1e847903b", "thumbnail_srcset": "https://si.imgix.net/dc43e228/requests/151081_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a203602d30c6dfd4353413e1e847903b, https://si.imgix.net/dc43e228/requests/151081_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c76631dd9b422fcd1f5a27c64ca35fc2 2x, https://si.imgix.net/dc43e228/requests/151081_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd282f4a38d2703c5f51ef104fbb511d 3x", "genre": "art", "nsfw": false, "body": "今日の芝草マット運動回再現お願いします。\n\nhttps://twitter.com/kuma_sakura_/status/13132570231