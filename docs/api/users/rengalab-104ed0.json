a46-41a9-b020-cb89bbb62d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd8834f4c91027acf46036b60057be2", "thumbnail_srcset": "https://si.imgix.net/c625a48f/uploads/origins/c4388d4b-8a46-41a9-b020-cb89bbb62d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd8834f4c91027acf46036b60057be2, https://si.imgix.net/c625a48f/uploads/origins/c4388d4b-8a46-41a9-b020-cb89bbb62d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6b00b1fbad40aafa104190e8d703221 2x, https://si.imgix.net/c625a48f/uploads/origins/c4388d4b-8a46-41a9-b020-cb89bbb62d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2cbcf55b4580135caaa61ebee584707 3x", "genre": "art", "nsfw": true, "body": "スワットとモトクロスの画像を拝見させていただいたので、モトクロスとモトクロスのイラストを書いて頂きたく、リクエストいたします。\n\n正常位とバックをタチウケ入れ替わりで、モトクロスギアフル装備でヤリ合っているのを楽しんでいる感じで。\nモトクロスギアは以下の物を装着。\nヘルメットはSHOEIのVFX-WRとAraiのMX-V（共にゴーグル有り）\nブーツはアルパインスターズとガエルネ。\nブレストガードはFOXとTHOR。\n（ブーツとブレストガードはマーク見えればＯＫなので、形状はお任せします）\nその他、ゴーグルやウェア等はお任せします。\n\n細かい指定ではありますが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/43", "thumbnail_src": "https://si.imgix.net/6bf238fd/uploads/origins/6a0d4af5-88f7-4910-8085-730ac5988d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b0414c0d5b723b5b1ee5f10e40f48bb", "thumbnail_srcset": "https://si.imgix.net/6bf238fd/uploads/origins/6a0d4af5-88f7-4910-8085-730ac5988d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b0414c0d5b723b5b1ee5f10e40f48bb, https://si.imgix.net/6bf238fd/uploads/origins/6a0d4af5-88f7-4910-8085-730ac5988d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8940b4d9ba6fa79fbd1729611cdd9c45 2x, https://si.imgix.net/6bf238fd/uploads/origins/6a0d4af5-88f7-4910-8085-730ac5988d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f00a0d68e944525dd7f1008cf436748 3x", "genre": "comic", "nsfw": true, "body": "いつもお世話になっております。\n\n今回な、前回リクエスト致しました、1・2編の続編を御願いしたく思います。\n\n金的で倒された二人のDAKSAVERの手首を拘束し吊し上げ、無謀になった競パンに包まれた急所を、二人同時に握り潰すライダー。\n\nその行為は、DAKSAVERの惨めな姿を晒すし見せしめとする為\n\nDARKSAVERの戦闘員は全て肉体改造手術をされた強化人間。\n肉体改造手術では睾丸を摘出され、代わりにダークエナジーと呼ばれるエネルギー源を精製するエナジータンクという腎臓器官を移植される。\n\nDAKSAVERの象徴を潰し、その戦闘員を晒すことは、DAKSAVERにとって最大の屈辱。\n\nいつものお願いになりますが、二人のDARKSAVERは、なるべく特徴である競パンが目立つアングルで描いていただけましたら幸いです。 \n今回のDARKSAVERモデルは、前回に引き続き\n以下の二人でお願いいたします。\n\nDARKSAVERモデル Takaya \n＊参考資料 Takayaをご参照ください。 https://photos.app.goo.gl/vse5jojphumJNkjQ9 \n \nDARKSAVERモデルたー \n＊参考資料 たーをご参照ください。 https://photos.app.goo.gl/J9z4ji2qSHJc197s8 \n\n\n後、前回に引き続き、細かいお願いになり恐縮いたしますが、競パン、ベストの背後にDARKSAVERロゴを入れて頂けましたら幸いです。\n ＊DARKSAVERロゴ資料をご参照ください。 https://photos.app.goo.gl/ZFwBKzkzdMZYBBUR6 \n\nまた、二人のコスチュームは前回と同様に、ベストまで着用した揃いのコスチュームでお願いいたします。 \n\nお忙しい中、申し訳ありませんが、ご検討の程、 よろしくお願いいたします。\n\nDAKSAVER", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/42", "thumbnail_src": "https://si.imgix.net/af9a4ebd/uploads/origins/e5f79d65-36ce-4e01-a1e2-d14b930e0a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23ac395d3c552d9eecfeeee502f1debd", "thumbnail_srcset": "https://si.imgix.net/af9a4ebd/uploads/origins/e5f79d65-36ce-4e01-a1e2-d14b930e0a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23ac395d3c552d9eecfeeee502f1debd, https://si.imgix.net/af9a4ebd/uploads/origins/e5f79d65-36ce-4e01-a1e2-d14b930e0a06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69ef91bfa220ef7bb67ea6df200d1cbf 2x, https://si.imgix.net/af9a4ebd/uploads/origins/e5f79d65-36ce-4e01-a1e2-d14b930e0a06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5c9c18a55550fc3f070c0e43b0ff14f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/41", "thumbnail_src": "https://si.imgix.net/7215a876/uploads/origins/5c906d95-2b36-440e-9cd5-ce4934eded90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6976ff3440fd60f982bcc28813b951ed", "thumbnail_srcset": "https://si.imgix.net/7215a876/uploads/origins/5c906d95-2b36-440e-9cd5-ce4934eded90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6976ff3440fd60f982bcc28813b951ed, https://si.imgix.net/7215a876/uploads/origins/5c906d95-2b36-440e-9cd5-ce4934eded90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7e2719f51cd1057a7c89a277cae8b96 2x, https://si.imgix.net/7215a876/uploads/origins/5c906d95-2b36-440e-9cd5-ce4934eded90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=914e2ec2076b74200c1417594811d116 3x", "genre": "art", "nsfw": true, "body": "煉瓦さんのこの作品の勇者さん（みたいなキャラ）の凌辱作品をリクエストしたいと思います。\nモブ盗賊に太い樹の幹に拘束されて（立ち姿で、幹を巻きながら両手を背後に縛られ）、服越しで股間を射精まで乱暴に揉まれて・射精後の粘り染みでそのまま布越し亀頭責められて潮吹かす、などの責め内容が欲しいです。\n作品中の勇者さんそのままでもいいし、また同じタイプのキャラ（短髪ツンツン頭、凛々しい顔の青年、冒険者らしくの金属もしくは革の胸当て、布の服やズボン、金属・革のブーツなど）もいいと思います\nできれば全身が見られる構図で、服を脱がさないでお願いします\n一次のみなのでアウトのリクエストであれば気軽に却下しても構いません。ご検討宜しくお願い致しますm(__)m\n\nhttps://www.pixiv.net/artworks/97621215", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/40", "thumbnail_src": "https://si.imgix.net/b5b33c62/uploads/origins/88a964b7-12ab-4d17-b7e5-4e4b169bd027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd325333f1d911ae17a12be0770604ed", "thumbnail_srcset": "https://si.imgix.net/b5b33c62/uploads/origins/88a964b7-12ab-4d17-b7e5-4e4b169bd027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd325333f1d911ae17a12be0770604ed, https://si.imgix.net/b5b33c62/uploads/origins/88a964b7-12ab-4d17-b7e5-4e4b169bd027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=218ff785ba6de5889b4d7f5804392653 2x, https://si.imgix.net/b5b33c62/uploads/origins/88a964b7-12ab-4d17-b7e5-4e4b169bd027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3032a00f0479425323b65cc94ff0371e 3x", "genre": "art", "nsfw": true, "body": "こんにちは先生、今回あなたにお任せしたいキャラクターは、Fate/Grand Orderの「千子村正」です。\n彼はロープで縛られ、ペニスと睾丸を足の指のロープに丁寧に縛り付けられてくっつけられ、片足を曲げられ、完全に固定されていた。\n亀頭は通行人にガーゼでこすられ、びしょびしょにされた。彼はまた、通行人に前立腺マッサージをされた（この部分は遠近法の関係で見せにくい場合は無視してよい）。\n願わくば野球ソックスを履いてほしいが、セックスと足の指をつなぐヒモを見せるためにソックスを履くことが不可能なら、もちろん裸足でも構わない。\n彼の精液を入れる容器が床に散らかっているといいのだが。", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/39", "thumbnail_src": "https://si.imgix.net/0fed2a8d/uploads/origins/8765d5c3-920f-452b-b251-9b546e7c8084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed83f06def4044317d54d8a236e31f5", "thumbnail_srcset": "https://si.imgix.net/0fed2a8d/uploads/origins/8765d5c3-920f-452b-b251-9b546e7c8084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed83f06def4044317d54d8a236e31f5, https://si.imgix.net/0fed2a8d/uploads/origins/8765d5c3-920f-452b-b251-9b546e7c8084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea51a3c055e3c942c72a296f5077173d 2x, https://si.imgix.net/0fed2a8d/uploads/origins/8765d5c3-920f-452b-b251-9b546e7c8084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5764fe3f53b4c631529ec2adbc29010d 3x", "genre": "art", "nsfw": true, "body": "前回のレッドヒーロー君大好きだったので、彼が四肢を触手で拘束されて、粘液にまみれながら凌辱されているシーンを描いて頂きたいです！首を絞められているカットと、性感攻撃に必死に耐えている表情のあるカットがあるとうれしいです。あと引き締まった尻が見えるアングルがあるとさらにうれしいです！", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/38", "thumbnail_src": "https://si.imgix.net/857eb035/uploads/origins/f927b0ff-6a80-4752-b6cb-593d7c963c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f16b6c9ca76ebcca22c2e6c7f3143990", "thumbnail_srcset": "https://si.imgix.net/857eb035/uploads/origins/f927b0ff-6a80-4752-b6cb-593d7c963c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f16b6c9ca76ebcca22c2e6c7f3143990, https://si.imgix.net/857eb035/uploads/origins/f927b0ff-6a80-4752-b6cb-593d7c963c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27c9caf9dccc09ade1849586ba3de648 2x, https://si.imgix.net/857eb035/uploads/origins/f927b0ff-6a80-4752-b6cb-593d7c963c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34c02398da320ecb4335321621d1d737 3x", "genre": "art", "nsfw": true, "body": "前回はサイボーグものを描いていただき、大変ありがとうございました。Xで野球部後輩と先輩の絡みを描かれているのを拝見して、シチュエーションが思い浮かびましたので、可能であればお願いいたしたく思います。\n\nサイボーグ化された少年が一方的に好意を寄せる先輩を拉致し、羽交い締めにする。そして、先輩も同じ体になってチカラを手に入れて気持ちよくなりましょうと誘惑する。そのまま、少年は拘束した先輩を強制的に改造された性器で犯して、ナノマシンを注入し、同化していく。先輩の身体は徐々に変化し、改造されていく。\nようなものです。\n\nその中で、今回描いていただきたいのは、拘束した先輩を犯す少年と、ナノマシンによって徐々に改造されつつある先輩です。\nサイボーグ化された少年の姿は前回描いていただいたものを流用していただいても構いません。また、改造されつつある先輩は、一部が機械化、装甲化、皮膚がラバー化しているような姿で、侵されて改造される快楽と苦痛でなんとも言えない表情になっているような感じです。\nなお、その他の構図、色などその他はすべておまかせします。\n\n重ね重ね、マニアックな内容で申し訳ありませんが、よろしくご検討くださいますようお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/37", "thumbnail_src": "https://si.imgix.net/a246dd59/uploads/origins/2e2a6463-72a4-41ad-8b70-39c2d94f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c83fac6c86cdd4303e1b3565d3970f4", "thumbnail_srcset": "https://si.imgix.net/a246dd59/uploads/origins/2e2a6463-72a4-41ad-8b70-39c2d94f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c83fac6c86cdd4303e1b3565d3970f4, https://si.imgix.net/a246dd59/uploads/origins/2e2a6463-72a4-41ad-8b70-39c2d94f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaedc6a0985ffd1a90745071795b9e34 2x, https://si.imgix.net/a246dd59/uploads/origins/2e2a6463-72a4-41ad-