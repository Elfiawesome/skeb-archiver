e%2Ccenter&txtsize=30&txt=PRIVATE&s=a0438e55a98593ab43731fe96aa0ea6b 2x, https://si.imgix.net/4a08906d/uploads/origins/645c74e5-0ee7-4fe3-91e5-57ab8751019e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e26c0654e448a8208a44b7c9436bfd3 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/48", "thumbnail_src": "https://si.imgix.net/f56b09fb/uploads/origins/63669e83-cd70-4803-bb38-769ab7b4cc80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aa0321aeef3cac3b45d74e5991c5d5b", "thumbnail_srcset": "https://si.imgix.net/f56b09fb/uploads/origins/63669e83-cd70-4803-bb38-769ab7b4cc80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aa0321aeef3cac3b45d74e5991c5d5b, https://si.imgix.net/f56b09fb/uploads/origins/63669e83-cd70-4803-bb38-769ab7b4cc80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26ed22f610de75ef32f83cc0ab650999 2x, https://si.imgix.net/f56b09fb/uploads/origins/63669e83-cd70-4803-bb38-769ab7b4cc80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a398b67ec885fe4a750c1a5d2cc0e8fa 3x", "genre": "art", "nsfw": true, "body": "可能ならば前回依頼のその後の話を描いていただきたく存じます。\n\n・先輩君、前回のイベントの恥辱の中で感じたものが忘れられず、前回とほぼ同じ格好（口と手は自由）でノーズクリップを着けて自慰をしている。\n\n・射精に至る前にいつの間にか近くにいた後輩くんに後ろ手拘束され、彼の手で口を塞がれながらイチモツを愛撫される。時折口から息継ぎはさせてもらえるが射精までは至らせてもらえない。\n\n・その後ノーズクリップはそのままに口を強力なガムテープで何重にも塞がれ、身を捩らせ勃起したイチモツを振るわせて悶える姿を観察される。上記の手加減呼吸制御の段階からこの完全窒息の段階まで一貫して、後輩君から拘束されて呼吸を管理される姿を見られることが好きなんだと囁かれ続ける。\n\n・先輩君、頭の中で否定し続けるも息止めの限界が近づくにつれ勃起している事実を強く認識してしまい、本当は嫌じゃないことに気づきながら盛大に射精する。\n\n\n以上のようなイメージでお願い致します。なお、先輩君があの服とノーズクリップを持っていたのは前回後に後輩君に押し付けられたから、2人が同じ場所にいるのはルームシェアか寮の共有スペースというイメージです。", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/47", "thumbnail_src": "https://si.imgix.net/097dfca3/uploads/origins/ebdd3f0a-2431-4baa-82e5-e22b3bc05274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9503dc951e971108c7661f42b7391b1", "thumbnail_srcset": "https://si.imgix.net/097dfca3/uploads/origins/ebdd3f0a-2431-4baa-82e5-e22b3bc05274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9503dc951e971108c7661f42b7391b1, https://si.imgix.net/097dfca3/uploads/origins/ebdd3f0a-2431-4baa-82e5-e22b3bc05274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b49388e08a601f16b9b5e87ad7b10fd 2x, https://si.imgix.net/097dfca3/uploads/origins/ebdd3f0a-2431-4baa-82e5-e22b3bc05274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34fccae3bfe6f306299fe28db7d2a04d 3x", "genre": "art", "nsfw": true, "body": "※金額変更のため、再送致します。\n\n小柄ながら引き締まった体型の青年が、直立姿勢で拘束され、口を大きな穴無しボールギャグで塞がれ、鼻を大きなノーズクリップでつままれた状態で見世物にされているイラストをお願いしたく存じます。 \n青年は鼻が高いというより大きく先端の丸っこい団子鼻で、その鼻が性感帯かつ本人は否定しているもののマゾ気質のため、拘束され呼吸を制限されながら晒し者にされている状況で勃起しているイメージです。  \n背景設定としては男女問わず平均身長が185センチはある世界で、身長160センチしかない青年は愛玩的な意味で主に同性にモテます。\n後輩にイベントの手伝いをしてほしいと頼まれ、チビの自分が頼られたという喜びからロクに内容を確認せず受けてしまい拘束展示された、というものになります。  拘束は分厚い革製の、服というより寝袋に近い作りで、両腕両脚共に気をつけの状態で一切動かせない形となります。\nイチモツは露出させられており、身長に反して巨根で、その意味でも注目を集めます。", "created_at": "", "completed_at": ""}, {"path": "/@rengalab/works/46", "thumbnail_src": "https://si.imgix.net/2ce4d047/uploads/origins/fc50d82b-08d7-4688-8edb-baf61726751c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98a205f00f5340a0a8ef56dc747a9044", "thumbnail_srcset": "https://si.imgix.net/2ce4d047/uploads/origins/fc50d82b-08d7-4688-8edb-baf61726751c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98a205f00f5340a0a8ef56dc747a9044, https://si.imgix.net/2ce4d047/uploads/origins/fc50d82b-08d7-4688-8edb-baf61726751c