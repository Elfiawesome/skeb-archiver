2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=089509929b329550a260e513ef9d8d11, https://si.imgix.net/1cd6b86a/uploads/origins/b3b95d57-745b-44bc-b206-78cb248a5437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e9b52d42396b97f3d828155c51092ee 2x, https://si.imgix.net/1cd6b86a/uploads/origins/b3b95d57-745b-44bc-b206-78cb248a5437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4a600e426dda9a86272ff83f450754e 3x", "genre": "comic", "nsfw": false, "body": "お忙しいところ失礼します\nリクエストの内容ですが\n「ド葛本社パロで水族館のふれあい水槽にほんひまが手を沈めるとリアルウミウシサイズの宇志海いちごがゆらゆら泳いできて手のひらにちょこんと乗ってくつろぎ始めてそれをドーラさんに「写真撮って」と大きな声を出して怖がらせるといけないで手のひらとドーラの顔を交互に見て口パクでお願いしてる」\nという感じの漫画をお願いしたいです\n長くなりましたがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@8775bono_e/works/20", "thumbnail_src": "https://si.imgix.net/e8b9c8c2/uploads/origins/a563b077-f1aa-469d-8b92-8dddedc59fce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=927d2fef33799b173680bd8fdee56784", "thumbnail_srcset": "https://si.imgix.net/e8b9c8c2/uploads/origins/a563b077-f1aa-469d-8b92-8dddedc59fce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=927d2fef33799b173680bd8fdee56784, https://si.imgix.net/e8b9c8c2/uploads/origins/a563b077-f1aa-469d-8b92-8dddedc59fce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd6e68505100bcd77e1c31aaf198b834 2x, https://si.imgix.net/e8b9c8c2/uploads/origins/a563b077-f1aa-469d-8b92-8dddedc59fce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95694826b3d923492f3dd3ccdd6da96b 3x", "genre": "art", "nsfw": false, "body": "Xのヘッダー用のイラストを描いて頂きたいです。\n\n資料の画像のパロディで、右から緑仙、加賀美ハヤト、社築、花畑チャイカ、夢追翔が並んでいる構図でお願いします。\n左上のロゴは無しで、下のテロップはあるverとないverの2通りを頂けるとありがたいです。\n\nhttps://i.imgur.com/LlNNeff.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@8775bono_e/works/19", "thumbnail_src": "https://si.imgix.net/6adbf645/uploads/origins/71b96cbf-20e7-406f-b390-280813742363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=212f88d8d78afef543c41a772ddfe15e", "thumbnail_srcset": "https://si.imgix.net/6adbf645/uploads/origins/71b96cbf-20e7-406f-b390-280813742363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=212f88d8d78afef543c41a772ddfe15e, https://si.imgix.net/6adbf645/uploads/origins/71b96cbf-20e7-406f-b390-280813742363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fca6fcea24e97ef78e110c2beec1928 2x, https://si.imgix.net/6adbf645/uploads/origins/71b96cbf-20e7-406f-b390-280813742363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5815d2b3077e2c1f607a341cd91151e5 3x", "genre": "art", "nsfw": false, "body": "こんばんは葛ひまイラストの依頼です\n\n葛葉とひまちゃんが自転車2人乗りで下校中(季節は夏)頑張って自転車漕いでる葛葉の後ろで横向きに座ったひまちゃんがご機嫌に歌ってる的なイメージでお願いします\n服装などは屋上に吸血鬼との後半の夏服でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@8775bono_e/works/18", "thumbnail_src": "https://si.imgix.net/020f940c/uploads/origins/38e34b52-813b-4b60-8764-9b1c7474fd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52027f8373e77b4a3a636ef746130751", "thumbnail_srcset": "https://si.imgix.net/020f940c/uploads/origins/38e34b52-813b-4b60-8764-9b1c7474fd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52027f8373e77b4a3a636ef746130751, https://si.imgix.net/020f940c/uploads/origins/38e34b52-813b-4b60-8764-9b1c7474fd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23bdea5a85503f0fb0568bc682924b73 2x, https://si.imgix.net/020f940c/uploads/origins/38e34b52-813b-4b60-8764-9b1c7474fd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6abc6620228f72069e4739319bcbe83 3x", "genre": "comic", "nsfw": false, "body": "いつも可愛いイラスト拝見せていただいています\n今回依頼したいのは「パソコンに向かってうんうん唸って絵の構想を練ってる宇志海いちごに後ろから文野環が頭の触角を触ったり、突っついたりしてはちょっかいをかけて放っておかれるとまた触ってきて最終的に遊んでしまう文野環と宇志海いちご」をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@8775bono_e/works/17", "thumbnail_src": "https://si.imgix.net/1444c972/uploads/origins/29da21d7-c795-4a3a-b6fd-14bced07a57a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4c662ded107e7edce787d2b72f3b3f", "thumbnail_srcset": "https://si.imgix.net/1444c972/uploads/origins/29da21d7-c795-4a3a-b6fd-14bced07a57a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4c662ded107e7edce787d2b72f3b3f, https://si.imgix.net/1444c972/uploads/origins/29da21d7-c795-4a3a-b6fd-14bced07a57a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb87fe1e4eafc2f6567721d57957127b 2x, https://si.imgix.net/1444c972/uploads/origins/29da21d7-c795-4a3a-b6fd-14bced07a57a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f90d7d1359fc7a93241a5a48c458e10 3x", "genre": "art", "nsfw": false, "body": "アリストロベルが見たいです…\n漫画形式だと嬉しいです。\nぼのさんが考える3人の絡みが見たい！", "created_at": "", "completed_at": ""}, {"path": "/@8775bono_e/works/16", "thumbnail_src": "https://si.imgix.net/b2e61953/uploads/origins/035d9e7e-af7d-4c7c-bc76-86c90763cdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=023f0de9e349b00583a3833f863b9cd5", "thumbnail_srcset": "https://si.imgix.net/b2e61953/uploads/origins/035d9e7e-af7d-4c7c-bc76-86c90763cdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=023f0de9e349b00583a3833f863b9cd5, https://si.imgix.net/b2e61953/uploads/origins/035d9e7e-af7d-4c7c-bc76-86c90763cdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c46caf54125da58d5d92877b1fa29961 2x, https://si.imgix.net/b2e61953/uploads/origins/035d9e7e-af7d-4c7c-bc76-86c90763cdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91ec7e47f1eb852fa9bd812dfc3725f5 3x", "genre": "art", "nsfw": false, "body": "こしへらクリスマスパーティのイラストをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@8775bono_e/works/15", "thumbn