b32-4ff6-aa43-0ec797b34aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6f8b7745354b43b8846961ab6c4747", "thumbnail_srcset": "https://si.imgix.net/348bd9e4/uploads/origins/86c00d1c-6b32-4ff6-aa43-0ec797b34aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6f8b7745354b43b8846961ab6c4747, https://si.imgix.net/348bd9e4/uploads/origins/86c00d1c-6b32-4ff6-aa43-0ec797b34aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=827151b134e1e3cdaf7be0f6f23b2242 2x, https://si.imgix.net/348bd9e4/uploads/origins/86c00d1c-6b32-4ff6-aa43-0ec797b34aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=648f696715d46895923433dd4beb0b93 3x", "genre": "art", "nsfw": false, "body": "不器用貧乏さん、こんにちは！\nいつも素敵なイラストを拝見しております。\n今回、アイコン用のイラストをお願いしたく、リクエストを送らせていただきました。\n\n\n● 依頼内容\n資料URLの画像のキャラクターを描いていただきたいです。\nポーズ等はお任せいたします。\n\n\n● 用途\nMisskey.ioやSteamのアイコンに使いたいと考えています。\n\n\n● 特徴（ざっくりですみません）\n・白髪\n・ロングヘア\n・つむじからアホ毛が1本\n・白いセーラー服（カラー、袖、スカートなど色がつく部分は濃いグレー）\n・赤い瞳\n・よく眠そうにしており、ジト目になりがち\n\n\n以上です。\nもしよろしければ、ご検討のほどよろしくお願いいたします ｍ(_ _)ｍ\n\nhttps://media.misskeyusercontent.jp/io/eafcbc44-5eb5-4e70-950d-a6f724cac6c3.webp", "created_at": "", "completed_at": ""}, {"path": "/@buki_binn/works/1", "thumbnail_src": "https://si.imgix.net/ef0e076b/uploads/origins/59761816-afd3-41a0-8422-b72887ce6908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1fe6c191694d225a4596008f9995f50", "thumbnail_srcset": "https://si.imgix.net/ef0e076b/uploads/origins/59761816-afd3-41a0-8422-b72887ce6908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1fe6c191694d225a4596008f9995f50, https://si.imgix.net/ef0e076b/uploads/origins/59761816-afd3-41a0-8422-b72887ce6908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d00e73dc2447ba948b85e544d3d5ad7 2x, https://si.imgix.net/ef0e076b/uploads/origins/59761816-afd3-41a0-8422-b72887ce6908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b76b3d79564b3a5e6cb558dc33994d6d 3x", "genre": "art", "nsfw": false, "body": "不器用貧乏様\nいつもmisskey.io、お絵描きすきーにてイラストを拝見させていただいております。\n今回は私のコイカツにてキャラメイクしたうちの子を描いていただきたいと思い、リクエストさせていただきました。\n\n■依頼内容\n・ポーズや表情などは自由です。お任せいたします。\n\n■備考\n名前:ガイロン\n身長:140cm\n\n■使用用途について\n・Skebにてリクエスト用の資料\n・X(twitter)、misskeyへの投稿\n・うちの子の紹介用イラスト\nとして使わせていただきたいと思っております。\n\n■納品\nサインあり、なし等を分けていただけたら大変幸いです。\n\nご検討の程、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1tEry9VVJNWJWQRpETq8l9LZnBa0keeUx", "created_at": "", "completed_at": ""}]}