at": ""}, {"path": "/@wasa_tsun/works/8", "thumbnail_src": "https://si.imgix.net/209ba818/uploads/origins/24b1a176-a846-46e0-a928-48b5a9238ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26ef8d368b8775645cc71d9d037b94a4", "thumbnail_srcset": "https://si.imgix.net/209ba818/uploads/origins/24b1a176-a846-46e0-a928-48b5a9238ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26ef8d368b8775645cc71d9d037b94a4, https://si.imgix.net/209ba818/uploads/origins/24b1a176-a846-46e0-a928-48b5a9238ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05e4f16a19c95502c9c3f0839d92aa28 2x, https://si.imgix.net/209ba818/uploads/origins/24b1a176-a846-46e0-a928-48b5a9238ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d95c7e8598324540913d8a52de4538e7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールありがとうございます！私のジライ系キャラを描いていただけたら本当に嬉しいです！❤️\n\nhttps://drive.google.com/drive/folders/1UZWoIjTUVnnA7_I4hfDiSHsJ07qB_4a8", "created_at": "", "completed_at": ""}, {"path": "/@wasa_tsun/works/7", "thumbnail_src": "https://si.imgix.net/cfae884a/uploads/origins/99a47c00-a78e-4c42-a3d3-29ffdac9cda7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8be19777e76a0b741cf62abee00de6ce", "thumbnail_srcset": "https://si.imgix.net/cfae884a/uploads/origins/99a47c00-a78e-4c42-a3d3-29ffdac9cda7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8be19777e76a0b741cf62abee00de6ce, https://si.imgix.net/cfae884a/uploads/origins/99a47c00-a78e-4c42-a3d3-29ffdac9cda7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c25dfd67f1341f4c2f94570be96ed6ca 2x, https://si.imgix.net/cfae884a/uploads/origins/99a47c00-a78e-4c42-a3d3-29ffdac9cda7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2f8cd0d64a8c6b372efc7c2320ea301 3x", "genre": "art", "nsfw": false, "body": "山葵つんさま\nいつも楽しく配信拝見しております！\n\n今回は、私鈴乃音にあ