3b6fb9907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a43bb2b380e45d3b2968de58af09e55e", "thumbnail_srcset": "https://si.imgix.net/3a77774c/uploads/origins/c9ea4a09-16a3-4599-a78d-bdc3b6fb9907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a43bb2b380e45d3b2968de58af09e55e, https://si.imgix.net/3a77774c/uploads/origins/c9ea4a09-16a3-4599-a78d-bdc3b6fb9907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81cc35204465f59f77ae20902db2ab62 2x, https://si.imgix.net/3a77774c/uploads/origins/c9ea4a09-16a3-4599-a78d-bdc3b6fb9907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6218b14dc8d30054368e5e522862962a 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nsuwasayaka先生の描かれるすらっとした体型やおしゃれで素敵なファッションにとても憧れております。\nもしよろしければ資料の創作キャラクター2名の全身立ち絵を描いていただけないでしょうか。\n\nキャラクター資料\nhttps://drive.google.com/drive/u/0/folders/1ptp0NWaxlM90dfHHB7bhDqi7l0wv3nAo\n金髪×黒髪のBLです。\n金髪が暴力や高圧的な態度で黒髪を支配しており、黒髪は逃れたいけど必要とされている事には変わりないので逃れられない共依存の関係性です。\n\nポーズなどはお任せで、是非とも2人に似合いそうな先生デザインのファッションや髪型で何でも自由に着飾ってくだされば大変嬉しく思います。\nまた、わがままを申しますがいただいた作品は印刷してアクリルスタンドなどにして飾りたいと思っているので、背景と人物が別レイヤーだと非常にありがたいです…！\n\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ssdraw/works/62", "thumbnail_src": "https://si.imgix.net/0bb89b76/uploads/origins/42bf1ff9-1d14-43a7-b113-b7bc265ed2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=070aee0c4ae63c0f5af843d2c2bdf41b", "thumbnail_srcset": "https://si.imgix.net/0bb89b76/uploads/origins/42bf1ff9-1d14-43a7-b113-b7bc265ed2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=070aee0c4ae63c0f5af843d2c2bdf41b, https://si.imgix.net/0bb89b76/uploads/origins/42bf1ff9-1d14-43a7-b113-b7bc265ed2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41b7dc9656ce33dbf07d2e2d68e37524 2x, https://si.imgix.net/0bb89b76/uploads/origins/42bf1ff9-1d14-43a7-b113-b7bc265ed2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66c65ea97af39916315eff82b1d45d9d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ssdraw/works/61", "thumbnail_src": "https://si.imgix.net/2e93245d/uploads/origins/794e83ac-b6e8-4321-84b6-1f4f8eed3cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=273257cd0d0818f907d5f7a684735f7c", "thumbnail_srcset": "https://si.imgix.net/2e93245d/uploads/origins/794e83ac-b6e8-4321-84b6-1f4f8eed3cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=273257cd0d0818f907d5f7a684735f7c, https://si.imgix.net/2e93245d/uploads/origins/794e83ac-b6e8-4321-84b6-1f4f8eed3cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abfe0e78d1da8bbe32582294e4c0c52c 2x, https://si.imgix.net/2e93245d/uploads/origins/794e83ac-b6e8-4321-84b6-1f4f8eed3cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de861412dfc9d136189be80fc1e50d54 3x", "genre": "art", "nsfw": false, "body": "初めまして！諏訪さんの描く絵の色彩や線、構図が大好きでいつも拝見しています。\n今回大好きな諏訪さんのタッチで、私が応援している人を描いていただける貴重な機会だと思い、ご連絡をさせていただきました…！\n\n描いていただきたいのは龍宮城のITARUくんです。\n（龍宮城は女王蜂のアヴちゃんがプロデュースを務めている7人組のボーイズグループです）\n\n今回、ITARUくんの誕生日の際に諏訪さんの描くITARUくんのイラストをSNSに添えて誕生日を祝うことができたらと考えています…！\nまた、もしよければその後は私のTwitterアイコンにも使用させていただけたら非常に嬉しいです…。\n\n【希望内容】\n・全身のイラスト（構図やポージングなどお任せします）\n・オーディション当時からずっと応援しているため、可能であればオーディション中～デビュー直後～現在の3つそれぞれの時期でのITARUくんが並んでいる姿がとても見たいです…！\n・グループの中で最年長（11月21日で21歳になります）なので、少し落ち着いた雰囲気を希望します\n・誕生日をお祝いする暖かい雰囲気があればもう十分幸せです！\n・もしケーキなどを描く場合があれば、彼の好きなチョコとフルーツ（特にオレンジとリンゴ）が使われたものだと嬉しいです\n（無理に入れる必要はありません、諏訪さんにお任せします！）\n\n【外見の特徴】\n・凛々しい太めの眉、柔らかく力強い印象的な目、ぽってりとした唇が顔の中で特に特徴的です\n・女性的～中性的～男性的と見た目のふり幅が大きいです（女性ものの服も、自分に合った“ファッション”のひとつとして取り入れるため、決して「女の子らしい」とも言い切れないような不思議な魅力があります）\n下記動画URL内に、彼のファッション感覚が光る回も入っています（0年0組／第5話「謎の転校生」より）\n\n【参考画像】\nhttps://drive.google.com/drive/folders/1rXiBxXa9USSGMnG7t6RN4rShrL8mqhtL?usp=drive_link\n\n【参考動画】\nhttps://youtube.com/playlist?list=PL5GxB_qeFE5lIClelFJUGHkJmkT_dx6ZS&si=1fyB0DLOdyNRFlPJ\n\n是非、よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@ssdraw/works/60", "thumbnail_src": "https://si.imgix.net/dbc451e3/uploads/origins/a95722c6-6515-45dd-99e0-9e457bd944f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a50a255e7832c1fc5fe23784b848d0e", "thumbnail_srcset": "https://si.imgix.net/dbc451e3/uploads/origins/a95722c6-6515-45dd-99e0-9e457bd944f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a50a255e7832c1fc5fe23784b848d0e, https://si.imgix.net/dbc451e3/uploads/origins/a95722c6-6515-45dd-99e0-9e457bd944f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e88a35f0c8bdd156a81c955ef0c8a9af 2x, https://si.imgix.net/dbc451e3/uploads/origins/a95722c6-6515-45dd-99e0-9e457bd944f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41101c9cb02644d732953a327d944399 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ssdraw/works/59", "thumbnail_src": "https://si.imgix.net/34d20022/uploads/origins/70350629-1cdc-4cce-abeb-0d9e4c48f17a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200