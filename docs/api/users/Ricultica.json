.net/3559b595/uploads/origins/b3c9fbfd-bd31-4af0-8448-77616c3d796d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1e2c51291b06ae08a78f87f207eed58 2x, https://si.imgix.net/3559b595/uploads/origins/b3c9fbfd-bd31-4af0-8448-77616c3d796d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63f76b9d3bf8ba4142ae27e5e5931c3f 3x", "genre": "art", "nsfw": false, "body": "棺の中で眠るティカ様をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Ricultica/works/40", "thumbnail_src": "https://si.imgix.net/45628088/uploads/origins/fe549590-9b31-4bfa-bd8f-167866c2efff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1caead73aa0e03a84d5774202b928358", "thumbnail_srcset": "https://si.imgix.net/45628088/uploads/origins/fe549590-9b31-4bfa-bd8f-167866c2efff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1caead73aa0e03a84d5774202b928358, https://si.imgix.net/45628088/uploads/origins/fe549590-9b31-4bfa-bd8f-167866c2efff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd2c86e0ac497859e7452458ff5cd4e7 2x, https://si.imgix.net/45628088/uploads/origins/fe549590-9b31-4bfa-bd8f-167866c2efff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc29dafd730ebda255ba01958ed70f47 3x", "genre": "art", "nsfw": false, "body": "氷の魔女になったティカ様をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Ricultica/works/39", "thumbnail_src": "https://si.imgix.net/522a5868/uploads/origins/3f2b8d82-37e2-49f3-b707-ac998cf4f622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24da65bf79e0bf8031fcb0fc064a1dfe", "thumbnail_srcset": "https://si.imgix.net/522a5868/uploads/origins/3f2b8d82-37e2-49f3-b707-ac998cf4f622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24da65bf79e0bf8031fcb0fc064a1dfe, https://si.imgix.net/522a5868/uploads/origins/3f2b8d82-37e2-49f3-b707-ac998cf4f622?bg=%23fff&auto=format%2Ccomp