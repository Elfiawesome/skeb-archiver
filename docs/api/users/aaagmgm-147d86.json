d66/uploads/origins/bccbb934-d312-4822-b42a-3e29850636f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738b6384d3eeef87e3df23b5108412a7", "thumbnail_srcset": "https://si.imgix.net/36e07d66/uploads/origins/bccbb934-d312-4822-b42a-3e29850636f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738b6384d3eeef87e3df23b5108412a7, https://si.imgix.net/36e07d66/uploads/origins/bccbb934-d312-4822-b42a-3e29850636f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56d9341f575a0f110a63c33d35229826 2x, https://si.imgix.net/36e07d66/uploads/origins/bccbb934-d312-4822-b42a-3e29850636f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43c1f1f7942c9d137cd10ca9c258153e 3x", "genre": "art", "nsfw": false, "body": "はじめまして！ジョニー様のイラストがとても可愛らしく、Vtuber活動に使用させて頂きたいと思い、今回リクエストを送らせていただきました。SNSに上げたり、サムネイル等に使用するかと思います。\n・背景が透過されたものも欲しいです。\n・左右と上が見切れていないもの(全身の場合は全身が見切れないもの)が欲しいです。\n\n\nキャラクターイメージ\nhttps://drive.google.com/drive/folders/1YF1dyxX-4iO5ivc-1NEiWQzwqBhzYn3Z?usp=sharing\n・緑髪で長い三つ編み。\n・横の髪は長め。\n・太眉\n・前髪は横の髪が外にはねている。\n・目は金色のような黄色のようなオレンジのような\n・胸は大きめ。\n・可能なら差分として眼鏡を描いてください。\n\n性格\n・元気ですが、メンタル弱め。\n・甘えん坊で子どもみたいなところがあります。\n\n表情・ポーズ\n・こちらに向かって子どもっぽく甘えている表情とポーズをさせてください。\n\n\nご検討の程、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aaagmgm/works/21", "thumbnail_src": "https://si.imgix.net/780f3dc8/uploads/origins/75a35c07-2d88-496d-8996-8ecd9f5e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9f9f3b744099da0d18370b6672022d", "thumbnail_srcset": "https://si.imgix.net/780f3dc8/uploads/origins/75a35c07-2d88-496d-8996-8ecd9f5e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9f9f3b744099da0d18370b6672022d, https://si.imgix.net/780f3dc8/uploads/origins/75a35c07-2d88-496d-8996-8ecd9f5e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17c5fff73932a8cbfdce7d75795c8da4 2x, https://si.img