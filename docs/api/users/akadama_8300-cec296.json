2-4c6a-bde9-6be016babc1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8c686b017cbc002d20bf7ab12945422 2x, https://si.imgix.net/703a0952/uploads/origins/6a222c11-3ee2-4c6a-bde9-6be016babc1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70dd49610178cd11d86b0c92638b3c9a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、HEY水と申します。お久しぶりにリクエストをおくらせて頂きます。\n\nキャラクター:CoC『GODARCA』HO力\n以前有償依頼させていただいたキャラクターのGODARCAコンバート版をお願いします。\n\n参考CS: https://iachara.com/view/11893568\n参考ビジュアル: https://drive.google.com/drive/folders/1WCoG320mXZhQjvijRMBNyFZ1R6yHqdlY\n\nシチュエーション:構図、ポージングはお任せ致します！セクシーめにして貰えたら嬉しいです！\n使用用途:Twitterアイコン、ヘッダーに利用させていただく予定です。\n\n何卒よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@akadama_8300/works/10", "thumbnail_src": "https://si.imgix.net/27a1027c/uploads/origins/2f44170e-7f1e-4f7e-bdde-ff38a1a9a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8c36f4b65851bb4e4d2b954fc4c88f3", "thumbnail_srcset": "https://si.imgix.net/27a1027c/uploads/origins/2f44170e-7f1e-4f7e-bdde-ff38a1a9a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8c36f4b65851bb4e4d2b954fc4c88f3, https://si.imgix.net/27a1027c/uploads/origins/2f44170e-7f1e-4f7e-bdde-ff38a1a9a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3df8447974f8e92fc0baac44f24564be 2x, https://si.imgix.net/27a1027c/uploads/origins/2f44170e-7f1e-4f7e-bdde-ff38a1a9a34c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f12b1e85e64b7ad04c3f67705a16e81a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも素敵なイラストを拝見させていただいております。\nよく見かける素敵なイケオジたちも大好きなのですが、あかだまさんのショタの絵も大好きなので是非ショタ絵を描いていただきたく存じます。\nキャラクターはお任せします。僕はどんなショタでも愛せます。成人済みで顔が幼い子もショタ判定です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akadama_8300/works/9", "thumbnail_src": "https://si.imgix.net/658acc03/uploads/origins/c30c62e5-8687-46a2-9a9a-bc1078b56f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8a649e2a19f4c74f2961cd456e93b28", "thumbnail_srcset": "https://si.imgix.net/658acc03/uploads/origins/c30c62e5-8687-46a2-9a9a-bc1078b56f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8a649e2a19f4c74f2961cd456e93b28, https://si.imgix.net/658acc03/uploads/origins/c30c62e5-8687-46a2-9a9a-bc1078b56f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8815e02ffe275867911bcd370cbf20ed 2x, https://si.imgix.net/658acc03/uploads/origins/c30c62e5-8687-46a2-9a9a-bc1078b56f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef0df90cd02386a2ffe9667769ad75ce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akadama_8300/works/8", "thumbnail_src": "https://si.imgix.net/1135efc0/uploads/origins/a2286171-320c-4856-8447-9826524310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed547c89345f05b4b6f94e995cfa96ec", "thumbnail_srcset": "https://si.imgix.net/1135efc0/uploads/origins/a2286171-320c-4856-8447-9826524310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed547c89345f05b4b6f94e995cfa96ec, https://si.imgix.net/1135efc0/uploads/origins/a2286171-320c-4856-8447-9826524310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=205d2efa2a778163d09ed4ba4e7508fd 2x, https://si.imgix.net/1135efc0/uploads/origins/a2286171-320c-4856-8447-9826524310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58d53fccad66a16c4ef8dffb9c42c201 3x", "genre": "art", "nsfw": false, "body": "こんばんは、いつもお世話になってます。\nあかだまさんのイラストが本当に好きで……！！是非イラストを描いて頂きたいと思い、リクエストを送らせていただきました。\nよろしければ以下のクトゥルフ神話TRPGのオリジナルキャクターのイラストをお願いしたいです。相方がいるキャラクターなのですが、お相手には許可を取っております。\n\n・A(梅原 詩音)\n黒髪、紅梅色の目、180cm、24歳、アイドル、攻め。\nヘラヘラしている陽キャタイプ。クラスのムードメーカーとして中心にいるタイプではあるが、本質はB以外はどうでもいいタイプ。綺麗なものを見るのが好きで趣味は芸術鑑賞。基本的にベタベタされるのが嫌いだが、Bだけは別で触りたいし、触られたい。Bの言いたいことや思っていることが大体わかるので、あまり気にしていない。むしろそこが可愛いと思っている。昔色々あったが、解決済みであり、解決に至れたのはBのおかげ。\n\n・B(犬戌 狸奴)\n浅緑の髪と目、170cm、25歳、エンジニア、受け。\nゆるっとしている面倒くさがりタイプ。ツンデレ。Aのことを好きだし愛して入るが、なかなか自分の気持ちをうまく言い出せないタイプ。それを気にして入るが、恥ずかしがり屋なので、いつも口ごもってしまう。そんな自分が嫌。親が毒親だった影響で、あまり自分に自信がない。Aの影響で音楽が好き。 \nとあるシナリオを通過後うちよそとして使っている継続探索者です。世界がどうなっても相手がいればそれでいいと言う感じのお互いが唯一無二であり、お互いが唯一の理解者という関係の恋人同士です。\n\n構図はお任せします。時期は冬で雪が降っている場所で服は冬服でお願いしたいです。服はお好きにアレンジしていただいて構いません。描きやすいように描いていただけましたら幸いです。\nイラストは横向きでお願いします。\n\n使用用途につきましては、壁紙等の個人的な使用、Twitterのヘッダー、個人的なグッズの作成などに使わせていただきたいと思っております。ヘッダーとしての使用の際にはあかだまさんのお名前とID記載させていただきます。\nまたうちよそのお相手とのイラストの共有を可能でしたらさせていただきたいと思っております。\n\nよろしければ、お受けしていただけると大変嬉しいです！\nご検討のほどどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jV563Udy7hdi8CeS73Qfd8jAwjRFFq_a", "created_at": "", "completed_at": ""}, {"path": "/@akadama_8300/works/7", "thumbnail_src": "https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a758641d48f121bc3b04298a75409a0c", "thumbnail_srcset": "https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a758641d48f121bc3b04298a75409a0c, https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=479d1ff615334e85f81f07ac4c07f357 2x, https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7663b4fd1