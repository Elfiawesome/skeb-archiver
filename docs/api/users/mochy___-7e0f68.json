=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cad6fe7ac8a2f09898cc05ea0390981", "thumbnail_srcset": "https://si.imgix.net/be6b6209/uploads/origins/95357719-4be7-41c6-b973-529ab66688a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cad6fe7ac8a2f09898cc05ea0390981, https://si.imgix.net/be6b6209/uploads/origins/95357719-4be7-41c6-b973-529ab66688a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=776b98ff6fad2f6f7ec6cbcb1a328d7d 2x, https://si.imgix.net/be6b6209/uploads/origins/95357719-4be7-41c6-b973-529ab66688a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4ef0c0557397eb43d5cb0ed3581f92e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mochy___/works/40", "thumbnail_src": "https://si.imgix.net/20b1bcff/uploads/origins/8297e006-1446-457a-9175-05b38c7425bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c209487bcf9094708ab7c7768f06b8", "thumbnail_srcset": "https://si.imgix.net/20b1bcff/uploads/origins/8297e006-1446-457a-9175-05b38c7425bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c209487bcf9094708ab7c7768f06b8, https://si.imgix.net/20b1bcff/uploads/origins/8297e006-1446-457a-9175-05b38c7425bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc47d43ca73cad85fd0d21ddcddd36c9 2x, https://si.imgix.net/20b1bcff/uploads/origins/8297e006-1446-457a-9175-05b38c7425bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=013b562d5cda07166c1ed1b0604e1950 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。以前赤蛮奇とほのお・ゴーストポケモンを依頼した者です。その節はありがとうございました。今回は水着姿の多々良小傘とみず・こおりタイプのポケモンが海で遊ぶイラストをお願いいたします。小傘の水着は下記リンクを参考にして下さい。\nhttps://x.com/Touhou_LW/status/1795384517328273489?t=N64e8pFj8dckDPSjoa9E4w&s=19\n小傘はジュゴンにまたがっていてパラソルの上には大道芸のようにタマザラシが転がっている。\n周りにはビーチボールで遊ぶパルシェン、ウオチルドン、テツノツツミがいる。テツノツツミはパルシェンかウオチルドンのどちらかに乗って放水してビーチボールを飛ばしている。ビーチボールのデザインはアビリティカード｢自由きままな生首｣の蛮奇ヘッドのデザイン(下記リンク参照)。\nhttps://ameblo.jp/iceblue-hs/entry-12776150013.html\n背景にはキョダイマックスラプラスの姿。\nといった感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mochy___/works/39", "thumbnail_src": "https://si.imgix.net/bc20aa5b/uploads/origins/d3dc9064-bfb5-424d-b481-b6370819df76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ae0b637024725749fdf9dda9e0f576", "thumbnail_srcset": "https://si.imgix.net/bc20aa5b/uploads/origins/d3dc9064-bfb5-424d-b481-b6370819df76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ae0b637024725749fdf9dda9e0f576, https://si.imgix.net/bc20aa5b/uploads/origins/d3dc9064-bfb5-424d-b481-b6370819df76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7979aa57fffff67f93a21cc80d7cede4 2x, https://si.imgix.net/bc20aa5b/uploads/origins/d3dc9064-bfb5-424d-b481-b6370819df76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61801d12f2b0f78b9c170f96a0f924b3 3x", "genre": "art", "nsfw": true, "body": "水着を流されたハピナスがクチートとクエスパトラに胸と股\nを隠すついでに手で触られているイラストをお願いします。\nクエスパトラはハピナスの胸を後ろから揉む様に隠している感じで、クチートは横から股と尻を撫でる様に触って隠している感じでお願いします。\nハピナスは二人に隠されながら恥ずかしそうに歩いている感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mochy___/works/38", "thumbnail_src": "https://si.imgix.net/110db405/uploads/origins/07582e2d-95ba-4992-a9fe-66dfe2f88b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73143abe362e937bce0148d65e5b7ddf",