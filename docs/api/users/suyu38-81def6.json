s/44c57f30-a343-4d3d-855c-c5d561c22fcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e66b9db4b77be39c9850e82a0297b7ce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suyu38/works/50", "thumbnail_src": "https://si.imgix.net/413d3a25/uploads/origins/c3aa5f99-b957-4e1f-813c-c36b91ca0879?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ae97d151e1e2501a10faff88a8e81a", "thumbnail_srcset": "https://si.imgix.net/413d3a25/uploads/origins/c3aa5f99-b957-4e1f-813c-c36b91ca0879?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ae97d151e1e2501a10faff88a8e81a, https://si.imgix.net/413d3a25/uploads/origins/c3aa5f99-b957-4e1f-813c-c36b91ca0879?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b48cbfd33830dd82ecd67883a7a35e8 2x, https://si.imgix.net/413d3a25/uploads/origins/c3aa5f99-b957-4e1f-813c-c36b91ca0879?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d86ef1b2ab802dbd43827a4bed7a96f4 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは、すーゆーさん！また依頼できるのをとても楽しみにしていました！\nまた私のFFXIVのOCをNPCと一緒に描いていただけませんか？\n今回は、夫のサンクレッドと一緒にいるリンを描いてほしいです。二人はとても愛し合っていて、幸せな夫婦です！イラストは「ポーズ」フォルダにある画像を参考にしてほしいです。キャラクターたちは結婚を祝っていて、抱き合いながら音楽に合わせてスローダンスをしています。サンクレッドはマイクを持って、凛と一緒に踊りながらセレナーデしている。彼は優しく微笑んでいる。凛はとても幸せそうだ！二人は結婚式の衣装を着て、髪にはおそろいの花をつけている。サンクレッドは黄色、凛は赤い花を持っている。結婚式の服装の参考資料も追加しました。もし複雑すぎたら、自由に簡略化してください。凛の髪型の参考資料も追加しました。髪型の裏側は長い三つ編みになっています。背景は自由に描いていただいて結構です！\n凛のそばかす、桜のピアス、髪の白いハイライトも忘れずに描いてください。\n本当にありがとうございました！\nhttps://drive.google.com/drive/folders/1OJFxi-JCXUqjMxDkKPDbXE2aNARw9OaA", "created_at": "", "completed_at": ""}, {"path": "/@suyu38/works/49", "thumbnail_src": "https://si.imgix.net/09be4310/uploads/origins/c8089c9c-0b44-4a96-9816-663b0f48a01d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20