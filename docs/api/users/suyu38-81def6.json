青と金の配色でベストとゆったりしたブラウス、タイトパンツを着てほしいです（衣装例：https://i.imgur.com/hTV6lae.png）。\n\n二人は恋愛関係にあり、とてもラブラブです。食事やお茶を楽しみながら、一緒に笑顔で笑っている姿が見たい。植物や花がたくさんある外のカフェにいるようなイメージです。\n\nご検討いただき、本当にありがとうございました！\n\nhttps://imgur.com/a/HjN39nf", "created_at": "", "completed_at": ""}, {"path": "/@suyu38/works/29", "thumbnail_src": "https://si.imgix.net/79d18711/uploads/origins/1799da2a-5429-4c17-b54b-a8c1093e1d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe52b253c48dac8c2938c8f1d3545fd0", "thumbnail_srcset": "https://si.imgix.net/79d18711/uploads/origins/1799da2a-5429-4c17-b54b-a8c1093e1d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe52b253c48dac8c2938c8f1d3545fd0, https://si.imgix.net/79d18711/uploads/origins/1799da2a-5429-4c17-b54b-a8c1093e1d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca3fca54126717958b1b7516395ef635 2x, https://si.imgix.net/79d18711/uploads/origins/1799da2a-5429-4c17-b54b-a8c1093e1d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e552121ed7b6d2c9e6854d5b858afd49 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suyu38/works/28", "thumbnail_src": "https://si.imgix.net/5f50cec5/uploads/origins/58fc4508-0bb1-4613-a24b-5a03ddc49df9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa9ad346b36945e6f91290b5318be1d", "thumbnail_srcset": "https://si.imgix.net/5f50cec5/uploads/origins/58fc4508-0bb1-4613-a24b-5a03ddc49df9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaa9ad346b36945e6f91290