origins/fa23b960-afe2-4326-8118-fbfa3ebc7f0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3545ea774315f84496b15d41ba96472 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@why_ball/works/63", "thumbnail_src": "https://si.imgix.net/1b391018/uploads/origins/06e633fa-1612-4b93-a8d9-62dcfb0ad65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77b63082e0fb2dacde949dce8bbaba9f", "thumbnail_srcset": "https://si.imgix.net/1b391018/uploads/origins/06e633fa-1612-4b93-a8d9-62dcfb0ad65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77b63082e0fb2dacde949dce8bbaba9f, https://si.imgix.net/1b391018/uploads/origins/06e633fa-1612-4b93-a8d9-62dcfb0ad65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=460e1758b047dcd269d84539f489f6e3 2x, https://si.imgix.net/1b391018/uploads/origins/06e633fa-1612-4b93-a8d9-62dcfb0ad65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eb530159ace13d05e68dcea7f853ef3 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！あなたの絵が私のタイムラインに出てきて、前の依頼がとても好きだったことを思い出しました！またお願いしたいです。\n\nまどのむこうがわ」の園藤圭を、添付のアルバムにある衣装のどれかで描いてほしいです。どれにするかは自由です。ポーズや構図はお任せします。\n\nキャラクターとシリーズは\n園藤京\nマドの向こう側\n\nhttps://imgur.com/a/66a5pyS", "created_at": "", "completed_at": ""}, {"path": "/@why_ball/works/62", "thumbnail_src": "https://si.imgix.net/ffad93fb/uploads/origins/6cc71234-dc9a-4281-b1a7-c7f844145618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93daa9b3d3d8f39c2e5131d8776bfce8", "thumbnail_srcset": "https://si.imgix.net/ffad93fb/uploads/origins/6cc71234-dc9a-4281-b1a7-c7f844145618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93daa9b3d3d8f39c2e5131d8776bfce8, https://si.imgix.net/ffad93fb/uploads/origins/6cc71234-dc9a-4281-b1a7-c7f844145618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa5db4551e50ce84f861eb60961776c4 2x, https://si.imgix.net/ffad93fb/uploads/origins/6cc71234-dc9a-4281-b1a7-c7f844145618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=935052a94908357f1b77561c46a8ef71 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@why_ball/works/61", "thumbnail_src": "https://si.imgix.net/3737cca3/uploads/origins/ca7b0856-e903-4ccc-8cd5-4b3b875c3740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7403f3dade8a521618bb5b6f1d920ceb", "thumbnail_srcset": "https://si.imgix.net/3737cca3/uploads/origins/ca7b0856-e903-4ccc-8cd5-4b3b875c3740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7403f3dade8a521618bb5b6f1d920ceb, https://si.imgix.net/3737cca3/uploads/origins/ca7b0856-e903-4ccc-8cd5-4b3b875c3740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41ef2539221e4668cdc9997c225819cd 2x, https://si.imgix.net/3737cca3/uploads/origins/ca7b0856-e903-4ccc-8cd5-4b3b875c3740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=076f2c8fd853624f9e0984ea51ddceee 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Fate Grand Orderのマッシュ・キリエライトのアートピースが欲しいです。彼女のセカンドビキニ姿（参考資料参照）だけでなく、彼女の頭にストライプのフラットキャップをかぶせてほしいです（https://i.etsystatic.com/7400102/r/il/5816cd/3117856880/il_fullxfull.3117856880_in5r.jpg）。帽子の色とビキニのストライプの色を合わせてください！\n\nポーズは自分で決めてください。ただし、彼女の胸を強調し、通常よりも胸を大きくしてください。\n\n背景は必要ありません。透過PNGがベストです。理由は、FGOの動画のYouTubeサムネイルに使いたいからです。その際には、これを