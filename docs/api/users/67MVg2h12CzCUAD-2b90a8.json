uto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01e6e5d9d63dc6c48b1c56f2db83d79b 2x, https://si.imgix.net/34d47c6e/uploads/origins/5bc64934-4409-48bd-8f47-b2b5a6bc3384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cd3ffb167c22228b459cd8d64bcdda8 3x", "genre": "art", "nsfw": true, "body": "まさふみさん、こんにちは！過去2回もメイを素敵に描いてくださり、改めて感謝します。今回は同じキャラクターで新たなリクエストをさせていただきたいです。\n\n今回は、メイが性的快楽を極度に味わった結果、簡単に避けられる罠に誘い込まれ、快楽に溺れるようなシチュエーションを描いてほしいです。ガストラップや股間を締め付ける縄結びなどが良いですが、お描きになりたいお気に入りのシチュエーションがあれば、そちらもぜひお願いします。よろしくお願いします！\n\n参考画像：https://drive.google.com/drive/folders/1umaqheYYAgHcP1JhXSveRoQI-UXPgqHL?usp=sharinghttps://drive.google.com/drive/u/0/folders/1h1SBD5JGyD1Xoa6cnmjhFmkwtmQXGfhV", "created_at": "", "completed_at": ""}, {"path": "/@67MVg2h12CzCUAD/works/13", "thumbnail_src": "https://si.imgix.net/7b6b2378/uploads/origins/c9cba173-b8d1-4c87-871f-f4783d3e0c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fabcbffec50241831096a981feb0070", "thumbnail_srcset": "https://si.imgix.net/7b6b2378/uploads/origins/c9cba173-b8d1-4c87-871f-f4783d3e0c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fabcbffec50241831096a981feb0070, https://si.imgix.net/7b6b2378/uploads/origins/c9cba173-b8d1-4c87-871f-f4783d3e0c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67bdb99c95c2bb1ad07892799b5be4db 2x, https://si.imgix.net/7b6b2378/uploads/origins/c9cba173-b8d1-4c87-871f-f4783d3e0c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a93a807df1330c16350bbd7b0f29b4b5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@67MVg2h12CzCUAD/works/12", "thumbnail_src": "https://si.imgix.net/47c48026/uploads/origins/ac8842f5-9646-4f97-bf62-ca70569f2ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaf58c2eeebadd57128641038b90d5ff", "thumbnail_srcset": "https://si.imgix.net/47c48026/uploads/origins/ac8842f5-9646-4f97-bf62-ca70569f2ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaf58c2eeebadd57128641038b90d5ff, https://si.imgix.net/47c48026/uploads/origins/ac8842f5-9646-4f97-bf62-ca70569f2ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b07e4644efefd9334923de56693e94dd 2x, https://si.imgix.net/47c48026/uploads/origins/ac8842f5-9646-4f97-bf62-ca70569f2ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6308765bfc6ce7590c16abf34760b8f7 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生\n\n私のフォックスガール二人のエロティックなレズバトル／キャットファイトのアートをお願いしたいです。\n\n「はな」＆「つき」 : https://catbox.moe/c/p4u8ae\n\n「花」（ピンクフォックス）：チャラチャラしていてライバルを馬鹿にするのが好きだが、ライバルに馬鹿にされると攻撃的になる。プライドが高く、負けず嫌い。\n\n「月」（ブルーフォックス）：ライバルをからかったり、侮辱したりするのが好きだが、ライバルに侮辱されると逆上する。傲慢で負けず嫌い。\n\nライバルの巫女であり、相手が反撃できなくなるまで強制的にオーガズムを味わわせることに重きを置くライバル関係。\n\nバトルはできるだけエロティックに、女の子を辱めたり、ポーズやアクションをラフにするのも自由！お互いの尻尾や耳を引っ張り合うのもOK。\n\n衣装の組み合わせ（全裸もOK）、構図、勝敗についてはお任せします！ダブルKO・同士討ちもOKです！", "created_at": "", "completed_at": ""}, {"path": "/@67MVg2h12CzCUAD/works/11", "thumbnail_src": "https://si.imgix.net/ec8a55c3/uploads/origins/ea0ecaee-46a5-4d37-abe5-3dabbe5bbbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b01649cd7bc35dac9126b87a4fbc27e", "thumbnail_srcset": "https://si.imgix.net/ec8a55c3/uploads/origins/ea0ecaee-46a5-4d37-abe5-3dabbe5bbbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b01649cd7bc35dac9126b87a4fbc27e, https://si.imgix.net/ec8a55c3/uploads/origins/ea0ecaee-46a5-4d37-abe5-3dabbe5bbbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8348487bee58d5e867ab467732957a2 2x, https://si.imgix.net/ec8a55c3/uploads/origins/ea0ecaee-46a5-4d37-abe5-3dabbe5bbbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b9ac8b1f3705f002f645f5ccb49a2d2 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@67MVg2h12CzCUAD/works/10", "thumbnail_src": "https://si.imgix.net/506c583b/uploads/origins/4cfacdd4-30be-402a-b8e6-3dac063e55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7efaab529ccce8875ec8cf4c5d6c7d7", "thumbnail_srcset": "https://si.imgix.net/506c583b/uploads/origins/4cfacdd4-30be-402a-b8e6-3dac063e55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7efaab529ccce8875ec8cf4c5d6c7d7, https://si.imgix.net/506c583b/uploads/origins/4cfacdd4-30be-402a-b8e6-3dac063e55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb78ad869d67ef879b88bdd0e010e825 2x, https://si.imgix.net/506c583b/uploads/origins/4cfacdd4-30be-402a-b8e6-3dac063e55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9c72efd76fa868cdcfea26b80be2a14 3x", "genre": "art", "nsfw": true, "body": "こんにちは、まさふみセカンドさん！\n\n今回もメイを上手に描いてくださってありがとうございますもしよろしければ、2回目もお願いしたいのですが...！\n\n今回は悪の組織のモブキャラ(女)に捕まって性的に嬲られるシナリオを希望します。\n\nメイが顔のない女性に奉仕させられるシーンや、機械やオモチャに苛められるシーンなど、どんなシーンでもいいので作っていただけたら嬉しいです！無理なお願いでなければいいのですが... 🙇‍♂️\n\n参考文献：https://drive.google.com/drive/folders/1umaqheYYAgHcP1JhXSveRoQI-UXPgqHL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@67MVg2h12CzCUAD/works/9", "thumbnail_src": "https://si.imgix.net/9ba56802/uploads/origins/a4bc0d15-a9ed-42ee-a3d5-afa771b7521a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bedb433ad70364e31da4b8f70c51fd39", "thumbnail_srcset": "https://si.imgix.net/9ba56802/uploads/origins/a4bc0d15-a9ed-42ee-a3d5-afa771b7521a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bedb433ad70364e31da4b8f70c51fd39, https://si.imgix.net/9ba56802/uploads/origins/a4bc0d15-a9ed-42ee-a3d5-afa771b7521a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3aed8e613a6f9736f045d9b3772b03d1 2x, https://si.imgix.net/9ba56802/uploads/origins/a4bc0d15-a9ed-42ee-a3d5-afa771b7521a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3039dae208c0daa5f70a81c3bf341c4 3x", "genre": "art", "nsfw": true, "body": "まさふみさん、こんにちは\nいつもお世話になっております\n\n前回のおねショタがとても良かったので\n補完としてお願い出来ますか\n\nキャラ\n冬木美春or高井さやか(好きな方\nでご自由に)\n\nシチュ \n1ページに左右2コマの対比で\nショタ相手によがり狂う/\nプライベートでのマグロ\n\n目がハート/冷ややかな目\nイキ顔/クール\n腟内射精/おへその周りに外出し\n四つん這いで乱れる/事務的正常位\n全裸もしくは制服半裸/シーツ・タオル等で裸を隠す\n頑張って射精ピュッピュしようね♡みたいな励ますセリフ/もう済んだ？みたいな淡々としたセリフ\n\nなどなど\n創造力でご随意にアレンジしてください\n\n今回はモノクロでお願いします\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@67MVg2h12CzCUAD/works/8", "thumbnail_src": "https://si.imgix.net/419246f0/uploads/origins/5ddc1dcc-41a0-4848-9e47-fd832df31cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40462136dad9763eb4dbc1f8ce1085a9", "thumbnail_srcset": "https://si.imgix.net/419246f0/uploads/origins/5ddc1dcc-41a0-4848-9e47-fd832df31cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40462136dad9763eb4dbc1f8ce1085a9, https://si.imgix.net/419246f0/uploads/origins/5ddc1dcc-41a0-4848-9e47-fd832df31cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6aa45f4867ea49e9e5a1361c6edea9b 2x, https://si.imgix.net/419246f0/uploads/origi