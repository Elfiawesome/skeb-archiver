9c373e8dc7a72978c0a2547 2x, https://si.imgix.net/1dc1d2f8/uploads/origins/eec1b08a-f579-4fc8-8365-a846ade84641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36a4a691e876704b323d116ed83abb72 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/21", "thumbnail_src": "https://si.imgix.net/315a4f20/uploads/origins/131ee7cb-a6fd-4516-ad79-32b41fef26b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f39cd1d3bf8a1e9f3efb065c952133a1", "thumbnail_srcset": "https://si.imgix.net/315a4f20/uploads/origins/131ee7cb-a6fd-4516-ad79-32b41fef26b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f39cd1d3bf8a1e9f3efb065c952133a1, https://si.imgix.net/315a4f20/uploads/origins/131ee7cb-a6fd-4516-ad79-32b41fef26b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f90cb5ce0db95c25b56ae3c900849d2a 2x, https://si.imgix.net/315a4f20/uploads/origins/131ee7cb-a6fd-4516-ad79-32b41fef26b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfcc05d1d23961582e66a3c2f8713810 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/20", "thumbnail_src": "https://si.imgix.net/ce24653c/uploads/origins/8a52764a-c288-4020-a7e6-64b24a629bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9411a5a91803377acb78e5d949dd94a4", "thumbnail_srcset": "https://si.imgix.net/ce24653c/uploads/origins/8a52764a-c288-4020-a7e6-64b24a629bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9411a5a91803377acb78e5d949dd94a4, https://si.imgix.net/ce24653c/uploads/origins/8a52764a-c288-4020-a7e6-64b24a629bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2010eab85dc8c9a3fdbe2d5a884feb9f 2x, https://si.imgix.net/ce24653c/uploads/origins/8a52764a-c288-4020-a7e6-64b24a629bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c4121b6fa00c1c6dcdf6adf395afa4 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエストさせて頂きます。\n詳細は以下のようになります。ご検討いただければ幸いです。\n\n○キャラ\n寿々奈鷹乃　(メモリーズオフ2)\n○コスチューム\n競泳水着　(3種類の内、書きやすいモノで大丈夫です)\n黒いロンググローブ\n黒いニーソックス\n髪型はポニーテール\n○参考\nhttps://imgur.com/a/DeYq8WZ\nhttps://imgur.com/a/7xI4Lyz\nhttps://imgur.com/a/E87pa8M\n\n〇シチュ\nローションマットプレイで失禁絶頂\n〇詳細\n参考資料の様な開脚姿勢で、太ももや尻を揉まれている状態。\n睨みつけている表情。\n\nそこから失禁。\n白目を剥きそうに、舌を出している表情。\n\n最後に、尿の水溜まりの上で放心。\n顔中を体液だらけに、白目を剥いた表情。\n\nもし可能でしたら、３種類の内の、別の水着差分(衣装差分)も頂ければ嬉しいです。\n\n〇参考\nhttps://imgur.com/a/5GH5e0a", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/19", "thumbnail_src": "https://si.imgix.net/8dda9b90/uploads/origins/53bf40df-91a8-41ef-bb59-55d0699c2450?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ff48538f96af68d925504b07615806", "thumbnail_srcset": "https://si.imgix.net/8dda9b90/uploads/origins/53bf40df-91a8-41ef-bb59-55d0699c2450?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ff48538f96af68d925504b07615806, https://si.imgix.net/8dda9b90/uploads/origins/53bf40df-91a8-41ef-bb59-55d0699c2450?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4379ab9ee7dd107547df3ca6b2d33472 2x, https://si.imgix.net/8dda9b90/uploads/origins/53bf40df-91a8-41ef-bb59-55d0699c2450?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5449b37423d3f43944353f134202f35b 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n先生の描かれるドスケベなおっぱいと乳首が好きなので、依頼させていただきたいです。\n\nアズールレーンのライプツィヒとニュルンベルクのイラストをお願いできないでしょうか。\n\nニュルンベルクに襲われてレズエッチしちゃうライプツィヒ。\n\nニュルンベルクはライプツィヒが好きすぎて我慢できなくなり襲いかかってしまいます。\n\nニュルンベルクひたすら乳首攻めされてしまうライプツィヒ。\n勃起した乳首を指でカリカリされたり摘んでひっぱられてしまう。\n\n「止めて」と懇願しても止めてもらえず、逆にニュルンベルクを興奮させてしまう。\n「いいよ、イッて、ライプツィヒちゃん。ライプツィヒちゃんが乳首でイクところ見せて」と攻め立て、余計激しく乳首をいじめて、\nとうとう、母乳を吹き出しながら絶頂してしまうライプツィヒ。\n\nという感じの内容をお願いします。\n\nひたすら乳首攻めしてほしいので、\nモノクロのほうがパターンを多く描いていただけるなら、モノクロでお願いします。\n\nよろしければ承認をお願いします。\n\nhttps://imgur.com/a/wHPjFaF", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/18", "thumbnail_src": "https://si.imgix.net/7678b8d1/uploads/origins/a714e778-ce2e-4cae-8ae7-59ec2d064bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78f282284635754a3837c0bb1e91fda", "thumbnail_srcset": "https://si.imgix.net/7678b8d1/uploads/origins/a714e778-ce2e-4cae-8ae7-59ec2d064bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78f282284635754a3837c0bb1e91fda, https://si.imgix.net/7678b8d1/uploads/origins/a714e778-ce2e-4cae-8ae7-59ec2d064bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db796e2b4d4eb218718b2b531e33a6a7 2x, https://si.imgix.net/7678b8d1/uploads/origins/a714e778-ce2e-4cae-8ae7-59ec2d064bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4f71d3f7e9e3c402793d69b8d83297a 3x", "genre": "art", "nsfw": true, "body": "氷室しゅんすけ様\n\nオリジナルキャラクターでの依頼が可能であれば\n以下のキャラクターを使ってお願いしたいと思っています\n・大間忍\nキャラクターにつきましては資料用URLにてご参照ください\n\n今回のリクエストなのですが\n自分の性癖が自分のオリジナルキャラクターが他人様の考えたシチュエーションでエロいめにあっているというもので\nもしよろしければうちの子を使って好きな様にして頂けますでしょうか\n基本全てを氷室しゅんすけ様にお任せしてしまう事\nまた此方のオリジナルキャラクターという事もあって\nツボにハマらないキャラであればそういった妄想もしにくく色々とお手間を取らせてしまう事になってしまうのですが\nジャンルはスカ、グロ以外であればNG要項は特に有りません。\nお好きなジャンルで描いて頂ければと思います。\n以上が依頼内容となります。\nご検討頂きそぐわないようであればキャンセルして頂けると幸いです。\n\nhttps://www.pixiv.net/artworks/90827916", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/17", "thumbnail_src": "https://si.imgix.net/6bab2a12/uploads/origins/af3bf0f7-1d41-4571-8d60-583ad922193e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd5d16ff806d6aaa89c165a500687774", "thumbnail_srcset": "https://si.imgix.net/6bab2a12/uploads/origins/af3bf0f7-1d41-4571-8d60-583ad922193e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd5d16ff806d6aaa89c165a500687774, https://si.imgix.net/6bab2a12/uploads/origins/af3bf0f7-1d41-4571-8d60-583ad922193e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00c435a622e7a4b22b0e9ccba0448be2 2x, https://si.imgix.net/6bab2a12/uploads/origins/af3bf0f7-1d41-4571-8d60-583ad922193e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c10c40c66cd29a7d788380fa2b3e219 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。\n先生の艶やかな色づかいと、甘くてエッチな雰囲気のイラストが好きで、ずっと依頼したいと思っていました。\n\nお願いしたいのは、魔法少女リリカルなのはStrikerSから、フェイト・T・ハラオウンのパイズリのイラストです。\n\n先生が以前描いた、恋鐘のような甘い雰囲気でのパイズリのイラストをお願いします。\nフェイトの表情は恥ずかしそうに頬を赤くしつつ、愛おしそうに上目遣いで。可能であれば、バストは大きめに。\n\n服装は特に指定はありませんので、全裸で構わないです。\n初描きのキャラクターだと思いますので、難しい場合はお手数ですがキャンセルでお願い致します。\n\nhttps://www.nanoha.com/archive3/character/images/fate_01-ImageMap_20_over.jpg", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/16", "thumbnail_src": "https://si.imgix.net/c7aec520/uploads/origins/90dd38b4-7163-4f18-970c-b8807a533aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c305a66712c160dc20f8f0dccdc6fa", "thumbnail_srcset": "https://si.imgix.net/c7aec520/uploads/origins/90dd38b4-7163-4f18-970c-b8807a533aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c305a66712c160dc20f8f0dccdc6fa, https://si.imgix.net/c7aec520/uploads/origins/90dd38b4-7163-4f18-970c-b8807a533aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4022bbc6b6f1195d7233ad896650965d 2x, https://si.imgix.net/c7aec520/uploads/origins/90dd38b4-7163-4f18-970c-b8807a533aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22fb499192a2929217522b94b4978061 3x", "genre": "art", "nsfw": true, "body": "初めまして、先生のイラストがとても好きでリクエスト開放していらしたのでリクエストさせていただきました。\n下記、可能でしたらご検討頂けると嬉しいです。\n\n・キャラ\n召使（原神）\nhttps://twitter.com/Genshin_7/status/1546349346001588224\n\n・衣装\nマリーローズ（デッドオアアライヴ）のバトルスーツに衣装チェンジ\nグローブとニーハイも描いていただけると嬉しいです。\nhttps://www.deviantart.com/photonlanccer/art/Marie-Rose-Casual-Beauty-7-848130159　https://www.pixiv.net/artworks/85120676\nマリーも召使いという設定なのでコンセプト合わせのリクエストとなります。\n\n・シチュ\n　・立ちバック　または　背面騎乗位でのずらし挿入 + 腟内射精\n　　　→　イメージは https://www.pixiv.net/artworks/99609585 のような感じ\n　　　胸は露出せず、レオタードの隙間から揉みしだかれている\n　　　乳首は衣装越しに勃起しているのがはっきりと分かる\n\n・表情\n　完全に陶酔しておりすっかりセックスにハマっているような感じで\n\n衣装の光沢感が目立つと嬉しいです。\n初出されたばかりのキャラで設定等無いと思いますので自由に描いて頂けると嬉しいです。\nその他細かい箇所はお任せいたします。\n\nご検討頂けると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/15", "thumbnail_src": "https://si.imgix.net/6ab91ede/uploads/origins/68e56378-d8ac-46df-967e-fa71e944e597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f4b20852737d0d45a0efc8a8807daf", "thumbnail_srcset": "https://si.imgix.net/6ab91ede/uploads/origins/68e56378-d8ac-46df-967e-fa71e944e597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f4b20852737d0d45a0efc8a8807daf, https://si.imgix.net/6ab91ede/uploads/origins/68e56378-d8ac-46df-967e-fa71e944e597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d63e90d33f1e6bbece825527d4cd7c7 2x, https://si.imgix.net/6ab91ede/uploads/origins/68e56378-d8ac-46df-967e-fa71e944e597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8d171f907c5ec0ae56f48509dd3110 3x", "genre": "art", "nsfw": true, "body": "作品はFGOでキャラクターはセイバー沖田総司（第三再臨）で\nシチュエーションは\n1、新選組屯所に侵入した二名の浮浪者(落ち武者風)に刀を奪われ、うち一人に背後から首へ刀を当てられ（出血等は無し）身動きが取れない状態でパンツの中に手を入れ手マンされ口の端からよだれを垂らしながら悔しそうな表情。\n※愛撫により愛液が垂れたり太ももを伝う。\nもう一人は沖田の横に居り、沖田にパンコキさせ先端からカウパーが染み出る。\n※片手で彼女へ乳首攻めを行い、もう片方にはパンツが握られる。\n※床には複数のパンツが散乱している\n２、トップレスでパンツのみ着用した状態で横にずらし男に後背位によって激しくビストンされるも口の中に自身の下着を突っ込まれ声が出せない状態で涙を流す。\n男のセリフは「これは中々な名器・・・！！あの一番隊隊長をヤれるとはなぁ・・・戦闘の度に男に下着を見せつけて誘うのだから本望だよなぁ？心に決めた相手じゃないがな!!」\n片手はもう一人へパンコキを行い続け男はパンツの中に射精する。\n※もしも可能ならで構いませんが男のセリフをイラストにしていただきたいです\n相手の視点で沖田が刀を振るっている際にミニスカートがめくれて黒色のパンツが（マンスジとクリトリスの形がくっきりしている）見えている状態（こちらは可能ならで構いません）\nご検討の程よろしくお願いします。\n\nhttps://www.wicurio.com/grand_order/index.php?plugin=ref&page=%E6%B2%96%E7%94%B0%E7%B7%8F%E5%8F%B8&src=06803.jpg", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/14", "thumbnail_src": "https://si.imgix.net/13ffbb9c/uploads/origins/4095a4ef-2647-4936-8e27-143080e1c0bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0b5367a6d4814b6f2491316bad66a34", "thumbnail_srcset": "https://si.imgix.net/13ffbb9c/uploads/origins/4095a4ef-2647-4936-8e27-143080e1c0bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0b5367a6d4814b6f2491316bad66a34, https://si.imgix.net/13ffbb9c/uploads/origins/4095a4ef-2647-4936-8e27-143080e1c0bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09adbcbf6ce46d603dad90993fb77644 2x, https://si.imgix.net/13ffbb9c/uploads/origins/4095a4ef-2647-4936-8e27-143080e1c0bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a27dcfa7fc29cc43ec71c293cedfc3d4 3x", "genre": "art", "nsfw": true, "body": "先生に、自分の考えた下記のヒロインの設定を形にして頂きたく、筆をとりました。\n\n\n【名前】クレスティリア・ミル・クニューヴァ\n【性別】♀\n【年齢】18歳\n【体形】身長159cm スリーサイズB98/W55/H89\n【外見】サラサラの金髪ロングヘアーをハーフアップツインにし、瞳は碧眼。年齢からは少し幼く見られる程度には童顔。\n【服装】白と金を基調にした、露出もそこそこ多めな衣装。(イメージとしては、グランブルーファンタジーの風属性SSR　[絢爛の紬手]コルワのような衣装)\n　　　　王族であることを示す小さめのティアラを付けていて、首には野生児のショタからプレゼントされた綺麗な原石を加工させて台座に嵌め込ませたチョーカーをつけています。\n【性格】優しくお淑やかで、知らないことへ対する好奇心は旺盛。\n【備考】クニューヴァ王国の王女で治癒魔法の使い手、聖女と呼ばれ国民からは慕われている。\n　　　　杖を用いての魔法が主だが、近接戦も訓練を積んでおり中々のもの。\n　　　　とあるゲームのヒロインの一人で、清楚だが胸が大きくエッチな服装なため読者の人気も結構ある。\n　　　　しかし、製作側が続編が出る度に付け替えパーツのように新しいヒロインを出すために最近は空気気味。\n\n表情は優しく微笑んでいて、バストはスリーサイズの通りかなりの大きさでお願いします。\n構図は、野生児のショタに目線を合わせるように少し身を屈めており、杖を両手で持ち、所謂「だっちゅーの」ポーズでバストが強調され、更にドレスの胸元から谷間が丸見えの状態でお願いしたいです。\n背景は森や泉などの屋外で構いません。\n差分を描いて頂けるのならば、おっぱいが見えている状態もお願いできれば幸いです。\n短い文章で申し訳ないですが、どうかご検討の程、宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/13", "thumbnail_src": "https://si.imgix.net/51bf4eed/uploads/origins/af7ae4c4-d9bf-4ccf-8856-8b89e687c3ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb92d8917c2fecace344def318136f7", "thumbnail_srcset": "https://si.imgix.net/51bf4eed/uploads/origins/af7ae4c4-d9bf-4ccf-8856-8b89e687c3ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb92d8917c2fecace344def318136f7, https://si.imgix.net/51bf4eed/uploads/origins/af7ae4c4-d9bf-4ccf-8856-8b89e687c3ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64c1bddf00b91262f573226baa1b8e46 2x, https://si.imgix.net/51bf4eed/uploads/origins/af7ae4c4-d9bf-4ccf-8856-8b89e687c3ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fd5579f7ff63c5a365a77937569cca9 3x", "genre": "art", "nsfw": true, "body": "いつもエロいイラストをありがとうございます！\nご依頼させていただきます。\n\n（作品）\nFate/GrandOrder\n\n（キャラ）\nBB\n\n（衣装）\n水着、通常の衣装、再臨段階などはお任せします。先生のエロいと思うもので！\n\n（シチュエーション）\nチャラ男に催眠2コマ堕ちさせられるBBちゃんをお願いします。\n1コマ目、もしくは1ページ目で\n「催眠なんてかかるわけないでしょう」的な台詞とドヤ顔、\n2コマ目、もしくは2ページ目で\nチャラ男に犯されてしまっているBBちゃん、\nというシチュエーションでお願いします。\n\n（構図、差分など）\n先生のおっぱいを強調する服の描き方がすごく好きなので、\n服の下からおっぱいを弄られ、揉まれながら犯されている構図でお願いします！\n\n\n（料金範囲でお願いしたい差分）\n・おっぱいを出している差分\n・チャラ男に馬鹿にされるような思考とか、台詞\n・差分で、「こんな男に犯されるなんて…」的な悔しそうな感じ\n→ハート目で堕ちちゃっている、という流れの表情と\nBBちゃん、チャラ男の台詞差分をお願いしたいです。\n（チャラ男サイドの台詞や思考は「雑魚」とか「チョロい」とかそんな感じだと嬉しいです）\n\n是非ご検討くださいませ。\n宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/12", "thumbnail_src": "https://si.imgix.net/22bd4194/uploads/origins/32a8d2e5-6d9d-43c4-8ba3-81f99f953bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d0b8e9f9eb23387e98ca4015debbb57", "thumbnail_srcset": "https://si.imgix.net/22bd4194/uploads/origins/32a8d2e5-6d9d-43c4-8ba3-81f99f953bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d0b8e9f9eb23387e98ca4015debbb57, https://si.imgix.net/22bd4194/uploads/origins/32a8d2e5-6d9d-43c4-8ba3-81f99f953bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c964cdb660a28dcab110643336a70cf 2x, https://si.imgix.net/22bd4194/uploads/origins/32a8d2e5-6d9d-43c4-8ba3-81f99f953bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d51e48ec34111179d864e7c9294b453a 3x", "genre": "art", "nsfw": true, "body": "アイドルマスターシャイニーカラーズの月岡恋鐘をリクエストさせていただきます。\n【うちのリボンは恋結び】の私服衣装で、着衣のままボタンを外して縦パイズリしているイラストをお願いします。隙間からブラが見えていると嬉しいです。\nよろしければ待機状態→パイズリ→射精→谷間から精液が溢れている様子を描いて頂けるとありがたいです。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/11", "thumbnail_src": "https://si.imgix.net/7604ccbb/uploads/origins/1a8927fd-34a5-49ff-b188-3e0d9a64f06f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69d30f33dc4888613d291281ee88810", "thumbnail_srcset": "https://si.imgix.net/7604ccbb/uploads/origins/1a8927fd-34a5-49ff-b188-3e0d9a64f06f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69d30f33dc4888613d291281ee88810, https://si.imgix.net/7604ccbb/uploads/origins/1a8927fd-34a5-49ff-b188-3e0d9a64f06f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28bc85bf6d70f2943749a1e70ce91e9a 2x, https://si.imgix.net/7604ccbb/uploads/origins/1a8927fd-34a5-49ff-b188-3e0d9a64f06f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=644ce3337464d99f37fb48b9d637cd5b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。イラストリクエスト募集中ということでリクエストをします。\n\nグランブルーファンタジーのイシュミールとレ・フィーエで、衣装は二人とも通常のドレス姿。\nドレスのスカートがふんわりとたっぷりなびくような感じにしてください。\n雰囲気な感じでなびかせるか、何らかのシチュエーションでなびくかはお任せします。\nドレス×２のフリフリなので、画面の大半はスカートで埋める勢いでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/10", "thumbnail_src": "https://si.imgix.net/6c656066/uploads/origins/3d92c313-5870-42ea-8825-0e3d11cd896d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ccba0151b41b7f542dc681b04e9cd9", "thumbnail_srcset": "https://si.imgix.net/6c656066/uploads/origins/3d92c313-5870-42ea-8825-0e3d11cd896d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ccba0151b41b7f542dc681b04e9cd9, https://si.imgix.net/6c656066/uploads/origins/3d92c313-5870-42ea-8825-0e3d11cd896d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71761286a7858dda4f846e5b44e69ddd 2x, https://si.imgix.net/6c656066/uploads/origins/3d92c313-5870-42ea-8825-0e3d11cd896d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4900ff633d0dedc1140493cc8d1ee3b3 3x", "genre": "art", "nsfw": true, "body": "いつもエロいイラストありがとうございます！\nシャニマスの恋鐘の絵が好きなので、下記のシチュでお願いしたいです！\n\n◎シチュエーション\n恋鐘とチャラ男のいちゃラブセックス\nただ、チャラ男の方は思考吹き出しで「恋鐘ちょろいわ」的な、遊び感覚のセックスという要素を入れていただきたいです。\n\n◎服装、構図など\nおまかせしますが、おっぱいは揉まれている吸われているなど、強調していただけると嬉しいです。\n\n◎できれば\n台詞あると嬉しいです。\n\nよろしくご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/9", "thumbnail_src": "https://si.imgix.net/88299ab9/requests/241077_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13f15c6843f6e1f49dcdd6a8ad335a4", "thumbnail_srcset": "https://si.imgix.net/88299ab9/requests/241077_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13f15c6843f6e1f49dcdd6a8ad335a4, https://si.imgix.net/88299ab9/requests/241077_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb0d1d2a950a95a0d9fc1713ac13f129 2x, https://si.imgix.net/88299ab9/requests/241077_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664f6e04ced4a04e557ed1f7b974c580 3x", "genre": "art", "nsfw": true, "body": "初めまして。氷室しゅんすけ様の素敵な絵を拝見し依頼をさせていただきました。\nご多忙の中大変恐縮ですが、ご検討よろしくお願い申し上げます。\n\n＜シチュエーション＞\nＦＧＯカーマに授乳手コキを受ける男マスター\nカーマは全員優しい表情でマスターの顔を見て、かつ全員上裸(片方、あるいは両方の乳首が見えていること)\n\nカーマ・男マスターのアクション及びセリフは以下の通りです。\n\n３：授乳(母乳が溢れている)されながら頭をなでなでする\n「ママのおっぱいおいちいでちゅか～？」\n２：乳首をいじりながらテコキ\n「我慢しなくていいんですよ～」\n１：マスターの顔の近くで、ガラガラをもってあやす\n「白いおしっこ、いっぱいびゅっびゅっしましょうね～」\n男マスター：長椅子に寝そべり、カーマのオッパイを必死に揉みながら吸っている\n（セリフはなし。表情は目は見えず、頬を赤らめ今にも射精しそうなのを我慢している）", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/8", "thumbnail_src": "https://si.imgix.net/8ff06efc/requests/213862_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4647856c3b275aca8e6357524fbea26", "thumbnail_srcset": "https://si.imgix.net/8ff06efc/requests/213862_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4647856c3b275aca8e6357524fbea26, https://si.imgix.net/8ff06efc/requests/213862_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f7f4330ce1a490aafb1efaae6f06755 2x, https://si.imgix.net/8ff06efc/requests/213862_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71cf06df186c9ed83b9f218bb8543b27 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@himuron/works/7", "thumbnail_src": "https://si.imgix.net/d761f24f/requests/150911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=403e8cc59aba9b044b9895aef1545c9b", "thumbnail_srcset": "https://si.imgix.net/d761f24f/requests/150911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=403e8cc59aba9b044b9895aef1545c9b, https://si.imgix.net/d761f24f/requests/150911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d78df2267687aa3ed8999fb9