fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f72c1145b860fbf941254ffde4e9b9a 3x", "genre": "art", "nsfw": false, "body": "資料や資料中のURLにあるような、琴葉姉妹のほのぼの両思いなやつをお願いします。\n\nhttps://skeb.jp/@tyokosukitarou/works/10", "created_at": "", "completed_at": ""}, {"path": "/@tyokosukitarou/works/13", "thumbnail_src": "https://si.imgix.net/769bfb95/uploads/origins/e9ab10d5-3b47-4349-b5e7-37dc37531bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=330d2f5ae01f0f7e99975388eb67dafd", "thumbnail_srcset": "https://si.imgix.net/769bfb95/uploads/origins/e9ab10d5-3b47-4349-b5e7-37dc37531bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=330d2f5ae01f0f7e99975388eb67dafd, https://si.imgix.net/769bfb95/uploads/origins/e9ab10d5-3b47-4349-b5e7-37dc37531bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0265824a933a339329b3846d7dbf2f7c 2x, https://si.imgix.net/769bfb95/uploads/origins/e9ab10d5-3b47-4349-b5e7-37dc37531bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83e6aa5e36572ebb50e6decbce701284 3x", "genre": "art", "nsfw": true, "body": "先日はこちらの絵をありがとうございました。\nhttps://skeb.jp/@tyokosukitarou/works/11\n良ければこちらの続きのエッチなのを描いていただきたく。\nもし続きがあまりイメージできないとかありましたら完全に別シチュでもOKです。\nいずれの場合も両思いで不穏な感じが一切ないやつでやつをよろしくお願いします。（エッチじゃなくてもOKです。以前のほのぼのしたのもとても良かったです）", "created_at": "", "completed_at": ""}, {"path": "/@tyokosukitarou/works/12", "thumbnail_src": "https://si.imgix.net/130ee453/uploads/origins/120c0454-c483-4e2b-8f00-4476b7ab440d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08543dbe9ccda4dc4690ca102e45673d", "thumbnail_srcset": "https://si.imgix.net/130ee453/uploads/origins/120c0454-c483-4e2b-8f00-4476b7ab440d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2