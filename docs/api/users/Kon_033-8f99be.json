a4f13d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490280088e81f4110e73b20fbbc9d810", "thumbnail_srcset": "https://si.imgix.net/2c0d13c9/uploads/origins/f86704c8-87d1-4e38-90dc-529ca4f13d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490280088e81f4110e73b20fbbc9d810, https://si.imgix.net/2c0d13c9/uploads/origins/f86704c8-87d1-4e38-90dc-529ca4f13d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00b3fddf09a00733d7241104209022d6 2x, https://si.imgix.net/2c0d13c9/uploads/origins/f86704c8-87d1-4e38-90dc-529ca4f13d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4eb70dc996e3711b82d5a3e09d9f9c49 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Kon_Tukumo033/works/3、嫌そうな表情で他のスカンクの女の子に顔にスプレーをかけられている。おそらく、顔面座位のポーズで、彼女の肛門から他のスカンクの顔に致命的なスプレーが放たれ、その衝撃が彼女の顔にも滴り落ちるのを見ることができるだろう。", "created_at": "", "completed_at": ""}, {"path": "/@Kon_033/works/10", "thumbnail_src": "https://si.imgix.net/b5081642/uploads/origins/edbd84fe-3219-4077-bb8e-14860a4b03ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b88d4d3c02ccc30b10277c6e62ce2e3c", "thumbnail_srcset": "https://si.imgix.net/b5081642/uploads/origins/edbd84fe-3219-4077-bb8e-14860a4b03ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b88d4d3c02ccc30b10277c6e62ce2e3c, https://si.imgix.net/b5081642/uploads/origins/edbd84fe-3219-4077-bb8e-14860a4b03ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69d80347eea7e3959445e17744cc081c 2x, https://si.imgix.net/b5081642/uploads/origins/edbd84fe-3219-4077-bb8e-14860a4b03ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fcd48eba379a1522e7693ca0d764621 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kon_033/works/9", "thumbnail_src": "https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e4632f513655d0a39ca44b91857f5a5", "thumbnail_srcset": "https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e4632f513655d0a39ca44b91857f5a5, https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78462fd72b0e076fcae1e4dadfbbd164 2x, https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57b67c75401fb643bc2580b11e803650 3x", "genre": "art", "nsfw": true, "body": "・状況\n　ブルアカのヒナタが簡易トイレで踏ん張って大きなおならを出しているシーン。傍らにはハナコがいます。\n\n・環境\n　砂浜近くの木陰に設置した簡易トイレの中。\n　参考写真を添付します。テント外観はこだわりませんが、座る椅子はぶらさげたゴミ袋が見えるタイプが望ましいです。\n　参考ページ[https://www.scrio.co.jp/fs/kaigo/12868]\n　テント内には入れ替え用のゴミ袋やトイレットペーパー、着替え置きがある設定ですが省きます。\n\n・服装\n　水着ヒナタの着用している水着です。\n　排尿ならともかく排便に適した格好ではないので、白いワンピース部分は全て脱いでいます（イラスト内に脱いだものがなくてもよいです）\n　下に着用している黒い水着はビキニタイプだと推測できますので、ブラトップだけ着用のままでパンツ部分は脱がせます。\n　ブラトップの布面積はわかりませんが、バストを大きく覆うものがよいかと（水着ウイよりは間違いなく広いでしょう）\n　帽子は外しています。\n　参考ページ[https://shop-list.com/women/dengding/kf1824/]\n\n・姿勢\n　排泄用の椅子に腰掛け、重心を落として思いっきり踏ん張っています。\n　脚は膝より下が開いている（地に足をつけて踏ん張っている）形であれば、太ももは閉じても開いていても問題ないです。\n　背をまっすぐ伸ばし、両手をみぞおち辺りでグーにしてお腹に力を込めている姿勢です。\n\n・表情\n　ぎゅっと目をつむり、顔を赤くして全力で踏ん張っている健気なヒナタがほしいです。\n　口元は「う～～～んっ！」と声に出して息んでいるイメージです。\n\n◇排泄物\n　お腹に溜まっていたガスが一気に噴出し、テント内に満ちています（見どころ）\n　臀部下の排泄袋に収まるはずがなく、太ももの間や椅子とお尻の隙間からあふれるイメージです（別レイヤであれば擬音歓迎します）\n　爆発するようなでっかい屁を楽しみにしています。排泄袋は不透明の黒だと思いますが、透けさせても大丈夫です。\n\n◇その他\n　陰部が見えても大丈夫です。モザイクや海苔がつく場合があります。毛は好みあると思うのでおまかせします。", "created_at": "", "completed_at": ""}, {"path": "/@Kon_033/works/8", "thumbnail_src": "https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab5ad9de77b758d8b15023da456914d", "thumbnail_srcset": "https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab5ad9de77b758d8b15023da456914d, https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c8adc9d6a7e9f6355e1bd17f94630b 2x, https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2dd20c937e5586b89dc8018587322f 3x", "genre": "art", "nsfw": true, "body": "先生が可能であれば、ここに出てくるキャラクターが(https://www.pixiv.net/artworks/112328495)巨大化して巨大なお尻を町に向けてとても大きいおならするシーンを見たいです。\n残りの事項は先生におまかせでお願いします。\n該当キャラクターの使用は該当作家(https://www.pixiv.net/users/85356024)に許可されました。\nよろしくお願いします。\nありがとうございます。\n2023.10.08\npark\n\nhttps://www.pixiv.net/artworks/112328495", "created_at": "", "completed_at": ""}, {"path": "/@Kon_033/works/7", "thumbnail_src": "https://si.imgix.net/6349aa1e/uploads/origins/b6ab060f-b13c-4619-80fc-ee749f88d854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90d6ec2ff661201ff88beea2fd43f359", "thumbnail_srcset": "https://si.imgix.net/6349aa1e/uploads/origins/b6ab060f-b13c-4619-80fc-ee749f88d854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90d6ec2ff661201ff88beea2fd43f359, https://si.imgix.net/6349aa1e/uploads/origins/b6ab060f-b13c-4619-80fc-ee749f88d854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff1da09918c97459588d4464c39e0