614-8ae9-0a9f324a40ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a262101e5fcc268312a66c56ace193b", "thumbnail_srcset": "https://si.imgix.net/2eb91d80/uploads/origins/bb281b34-ed4d-4614-8ae9-0a9f324a40ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a262101e5fcc268312a66c56ace193b, https://si.imgix.net/2eb91d80/uploads/origins/bb281b34-ed4d-4614-8ae9-0a9f324a40ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1306d989094cd1042082faf4db131fc 2x, https://si.imgix.net/2eb91d80/uploads/origins/bb281b34-ed4d-4614-8ae9-0a9f324a40ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fbc2ea18d95196b519bb37687a148a6 3x", "genre": "art", "nsfw": false, "body": "りたさん、初めまして。\nFF14のPCキャラが8月いっぱいまでと聞いたので、勇気を出して依頼させていただきます。こういったものを初めて依頼するので、不備があったらすみません。\n\n依頼の内容としては、FF14のキャラクターのイラストをお願いしたいです。資料は下記のURLを参考にお願いします。\nhttps://drive.google.com/file/d/1KKUOLCcskgQxx16vFD--KgIm0l6k4zAz/view?usp=drivesdk\n\n背景、ポーズ等おまかせです。明るめの性格をイメージしているので、イラストの雰囲気も明るくお願いします。SSだと照明で分かりにくいのですが、髪はほんの少し青い白です。それと、りたさんの描かれるもぐちょこさんのミコッテのくりくりした目が好きなので、サンシーカーの目の特徴を持たせつつ普段描かれている目の感じでお願いしたいです。\nついでにこちらは可能でしたらでよいのですが、学者がメインなのでフェアリーエオスを一緒に描いてもらえると嬉しいです。描いてくださる場合、フェアリー有と無の2種類で送ってくださると助かります(同じイラストで、フェアリーだけ消したverという意味です)。\n\n使用用途はSNSのアイコンや、スマホのホーム画面を想定しています。\n\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1KKUOLCcskgQxx16vFD--KgIm0l6k4zAz/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Rita_Lilie/works/16", "thumbnail_src": "https://si.imgix.net/01e5b5e1/uploads/origins/42989f2e-1535-4a8c-ae70-f1b3ead40c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0974edb8d4d7dd6c0b16aea02e0e62e4", "thumbnail_srcset": "https://si.imgix.net/01e5b5e1/uploads/origins/42989f2e-1535-4a8c-ae70-f1b3ead40c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0974edb8d4d7dd6c0b16aea02e0e62e4, https://si.imgix.net/01e5b5e1/uploads/origins/42989f2e-1535-4a8c-ae70-f1b3ead40c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62da18e9a1caa08782ab1657d7e69a47 2x, https://si.imgix.net/01e5b5e1/uploads/origins/42989f2e-1535-4a8c-ae70-f1b3ead40c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8d65aea195b84dc83102b4d4980b891 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リリア先生！私のff14のocを描いてくれませんか？あなたのスタイルで彼女を見たいです！\n\n彼女は19歳で、髪は黒く、肌は白いです。左目は紫、右目は青。優しくてエレガントでキュートな女の子で、ダンサーです。\n\nキャラクター・リファレンス\nhttps://drive.google.com/drive/folders/1UAI5wyQ6xoegbbSSQWUVdkn1huVAD-x4\n\nできれば扇子を持って踊っているところを描いてください。色は薄紫です。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1UAI5wyQ6xoegbbSSQWUVdkn1huVAD-x4", "created_at": "", "completed_at": ""}, {"path": "/@Rita_Lilie/works/15", "thumbnail_src": "https://si.imgix.net/c4e4a4da/uploads/origins/93a60253-9d58-4bb8-880a-c6247a612184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2460768379494aefe7c01e28b5e0d1a2", "thumbnail_srcset": "https://si.imgix.net/c4e4a4da/uploads/origins/93a60253-9d58-4bb8-880a-c6247a612184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2460768379494aefe7c01e28b5e0d1a2, https://si.imgix.net/c4e4a4da/uploads/origins/93a60253-9d58-4bb8-880a-c6247a612184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d31e93501cfe9f7dab9a6b70e6585bd8 2x, https://si.imgix.net/c4e4a4da/uploads/origins/93a60253-9d58-4bb8-880a-c6247a612184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f76e39b8ba4211419e9bd4d77b050b38 3x", "genre": "art", "nsfw": false, "body": "りた@skeb募集中先生、こんにちは。FF14のうちの子のイラストを依頼したいです。\n\nキャラクター紹介（参考までです、先生が思うイメージのままに描いていただければと思います）：\nアウラ娘です。白髪です。右目は赤色系で、左目は紫色系です。\n頑張り屋さんで、しっかりしてる子です。お姉さんぽくで、ヒロインみたいな華やかな雰囲気を放って、みんなを導く。\nオフの時は少女的な純真さがあって、普通の女の子みたいに不器用なところもある。\nメインジョブは赤魔導士。\n\nシチュエーション：\nシチュエーション、構図、アングル、表情、背景、差分、武器の有り無しなどはおまかします。資料のフォルダー色んな衣装をまとめています、ご好みの方を選んで書いていただければと思います（小物やデザインを全部厳守する必要はないです、組み合わせの変換や、新しいデザインとかもぜひ）。\nもしくは完全にご好みの衣装や武器を描いていただければと思います。\n\nレイヤ分けのｐｓｄと宛名有り無し差分もお願いします。\nでは、ぜひご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1dJfHI6XfIQhrg2055qu-3jgqIfZhcQWR?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Rita_Lilie/works/14", "thumbnail_src": "https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37d348ea3796ea4c3407a27f24ed325", "thumbnail_srcset": "https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37d348ea3796ea4c3407a27f24ed325, https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d0c2104c0dd13d95072f0aae76874d6 2x, https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af63c326b19ee40930bdf0f40a79452a 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとてもきれいです！FFXIVのOCのアートをお願いします。帽子をかぶっているか、かぶっていないか、どちらか選んでください。シャイなポーズやキュートなポーズが一番似合います。できればそばかすもお願いします。\n\nhttps://ibb.co/album/TYqDKp", "created_at": "", "completed_at": ""}, {"path": "/@Rita_Lilie/works/13", "thumbnail_src": "https://si.imgix.net/ac971339/uploads/origins/43bf409d-344e-484e-8403-bc3c33ab5399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1a75a8964f2d8c723fce18a02025969", "thumbnail_srcset": "https://si.imgix.net/ac971339/uploads/origins/43bf409d-344e-484e-8403-bc3c33ab5399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1a75a8964f2d8c723fce18a02025969, https://si.imgix.net/ac971339/uploads/origins/43bf409d-344e-484e-8403-bc3c33ab5399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68fc0dd28497259fd7cdb7289678529e 2x, https://si.imgix.net/ac971339