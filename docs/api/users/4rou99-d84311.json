0&h=200&s=8effd9cf63b388d6e97d0e6b8012f8ce 3x", "genre": "art", "nsfw": false, "body": "こんにちは！君の素晴らしい画風で僕と僕の友達を描いてくれないかな！二人ともカオスなカラス男です。ポーズ、服装、表情はお任せします。僕らのVtuberで何ができるか楽しみだよ！\n\n参考：https://drive.google.com/drive/folders/17xJxXeR7nN5F4-FTpI5-eg1LsmSrBDQX?usp=sharing\n\n彼のリファレンス：https://drive.google.com/drive/folders/1OKbK1GMNWCSUgI2dJhgWVTzjK_A9quZJ", "created_at": "", "completed_at": ""}, {"path": "/@4rou99/works/35", "thumbnail_src": "https://si.imgix.net/1e067f28/uploads/origins/675c931c-0510-4c6e-9371-e160590d4a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5804ad43b5cab7f4de7ea57ca0f9a09", "thumbnail_srcset": "https://si.imgix.net/1e067f28/uploads/origins/675c931c-0510-4c6e-9371-e160590d4a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5804ad43b5cab7f4de7ea57ca0f9a09, https://si.imgix.net/1e067f28/uploads/origins/675c931c-0510-4c6e-9371-e160590d4a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09c4606ae3b88b23dab2f96509a05f37 2x, https://si.imgix.net/1e067f28/uploads/origins/675c931c-0510-4c6e-9371-e160590d4a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ce42aa480e009a05285a49b3886f1d1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！天使と悪魔のコスチュームを着た僕と友達のハロウィン・アートを依頼したいんだ。アリスは天使。ブランは悪魔です。それぞれのコスチュームと参考資料を用意しました。参考ポーズも用意しました。それぞれの画像には、使用したい参考資料の名前をつけました。ブランは悪魔のコスチュームで、後ろ向きの大きな角と鋭い歯が欲しい。アリスは天使のコスチュームで、白い衣装に金の裏地と後光が欲しい。背景はお好みで。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1xbkrgmbfiV8jIwRyBJJNIzGJBGhpCXkT?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@4rou99/works/34", "thumbnail_src": "https://si.imgix.net/e680b17b/uploads/origins/ad32309f-bd1b-445a-988d-eae0bf9afae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3b76ce2b1164b3bbb5c81c0c55e27f0", "thumbnail_srcset": "https://si.imgix.net/e680b17b/uploads/origins/ad32309f-bd1b-445a-988d-eae0bf9afae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3b76ce2b1164b3bbb5c81c0c55e27f0, https://si.imgix.net/e680b17b/uploads/origins/ad32309f-bd1b-445a-988d-eae0bf9afae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a0294a5e245ba38aeaef16ca352acb6 2x, https://si.imgix.net/e680b17b/uploads/origins/ad32309f-bd1b-445a-988d-eae0bf9afae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5146240db26db0265c4592b32ab74685 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕と友達のVtuberを描いてくれないかな。彼女への誕生日プレゼントなんだけど、ケーキを渡すところを描いてくれないかな。私たちは姉妹みたいなものなの。黒髪のモデルの方が紫髪のモデルより背が高いんだ。ポーズはお任せします。\n\nhttps://sta.sh/21t2zumvd9l6?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@4rou99/works/33", "thumbnail_src": "https://si.imgix.net/617d1011/uploads/origins/418e39fd-c159-4223-8f10-ecb255b89cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01619ebbfd85af915bfbbf6bfbd2dd59", "thumbnail_srcset": "https://si.imgix.net/617d1011/uploads/origins/418e39fd-c159-4223-8f10-ecb255b89cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01619ebbfd85af915bfbbf6bfbd2dd59, https://si.imgix.net/617d1011/uploads/origins/418e39fd-c159-4223-8f10-ecb255b89cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bbb5edcd04aef5bf6e068c5eb9a76fa 2x, https://si.imgix.net/617d1011/uploads/origins/418e39fd-c159-4223-8f10-ecb255b89cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb22c83025917f529ef5d8ec9abe077b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "comple