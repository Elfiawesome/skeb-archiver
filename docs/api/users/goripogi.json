武器を地面に下ろした。カリファは倒れたヤマトをしごき続ける。また、ヤマトの衣装を改造して、赤いスカートなしで太ももが見えるようにしてもらえるとありがたい。\n\nhttps://drive.google.com/drive/u/0/folders/1PHGzktPjCjf8P0MCT6zZ-WMLGuXfuL2U", "created_at": "", "completed_at": ""}, {"path": "/@goripogi/works/119", "thumbnail_src": "https://si.imgix.net/9bdad350/uploads/origins/3653c105-3365-4cf4-8d2f-dc66ce5b45a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=418d87667a1256ffacc9a702de7bbc30", "thumbnail_srcset": "https://si.imgix.net/9bdad350/uploads/origins/3653c105-3365-4cf4-8d2f-dc66ce5b45a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=418d87667a1256ffacc9a702de7bbc30, https://si.imgix.net/9bdad350/uploads/origins/3653c105-3365-4cf4-8d2f-dc66ce5b45a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bc0802457fae781f3937b97eeabf658 2x, https://si.imgix.net/9bdad350/uploads/origins/3653c105-3365-4cf4-8d2f-dc66ce5b45a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc184a5b2dfc7c7fc3e7fb02fa64c9bc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@goripogi/works/118", "thumbnail_src": "https://si.imgix.net/b3284470/uploads/origins/f64ef5c0-38c1-4fff-b38c-0b999d3a3f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aff2e14a64cfec6d92e82667ac7abd0c", "thumbnail_srcset": "https://si.imgix.net/b3284470/uploads/origins/f64ef5c0-38c1-4fff-b38c-0b999d3a3f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t