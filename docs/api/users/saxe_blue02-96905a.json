04ad08a289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0b2aedab6d2b9516c5cee6d8d114cc5, https://si.imgix.net/f25d8c68/uploads/origins/0ea04046-ed9e-4559-ba33-6c04ad08a289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a48e33197a4321aa62ca15c056f2787c 2x, https://si.imgix.net/f25d8c68/uploads/origins/0ea04046-ed9e-4559-ba33-6c04ad08a289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9107da23751312945cba76451539a2fc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品の構図はとても美しいですね。私のキャラクターの絵をイラストにしていただけないでしょうか？\n\n彼女は152cmの小柄な女の子で、茶色の瞳とブロンドの巻き毛が特徴です。人生の目標を達成するためによく努力するが、失敗することも多い。人生の大半を室内で過ごしてきたため、まるで塔に閉じ込められたお姫様のような存在。外の世界へ出て、目的を持って愛する人と一緒に暮らすことを切望している。\n\n構図：私のキャラクターはヴィンテージの絵画のフレームを持ち、その内側に視聴者に向かって立っています。彼女の表情は、不機嫌で感情的であるように見えるはずです。絵の内部は炎に包まれたシンプルな寝室で、炎はゆっくりと額縁を焼き尽くしていくはずです。\n\n作品の外観と背景は、穏やかな夜空で、地面は白い蘭の花に囲まれ、空には流れ星があり、絵の中の炎のような細部の破壊と対照的であるべきである。\n\n彼女の服装は制服ではなく、パジャマを参考にしてください。\n\n構図参考： https://imgur.com/a/NaZathM\nキャラクター参考：https://imgur.com/a/XwvdyrH\n衣装参考：https://imgur.com/a/UMHLPri\n\n私の依頼を考慮していただき、ありがとうございました。もしお気に召さないようでしたら、遠慮なくキャンセルしてください。", "created_at": "", "completed_at": ""}, {"path": "/@saxe_blue02/works/2", "thumbnail_src": "https://si.imgix.net/15812529/uploads/origins/b3e1f6e5-dbdd-4d3a-9696-5832802356c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1224ed10283c4929bbb9b19d5e6ccd62", "thumbnail_srcset": "https://si.imgix.net/15812529/uploads/origins/b3e1f6e5-dbdd-4d3a-9696-5832802356c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1224ed10283c4929bbb9b19d5e6ccd62, https://si.imgix.net/15812529/uploads/origins/b3e1f6e5-dbdd-4d3a-9696-5832802356c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72414d98cfeb2389dfa8818c32f2ca3a 2x, https://si.imgix.net/15812529/uploads/origins/b3e1f6e5-dbdd-4d3a-9696-5832802356c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22ef4fadbe0d306f4ae32cb7365442bd 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nあなたのアートは本当に素晴らしいです。私はビクトリア時代の世界に彼女を追加したいので、ビクトリア朝の服を着て私のキャラクターを描くことができれば光栄です。https://i.imgur.com/vWxYfIw.jpg でも、ディテールやジュエリー、アクセサリーの追加や変更は大歓迎です。彼女はミュージックホール一座のメンバーで、演じることが大好きですが、ステージの外ではかなり恥ずかしがり屋です。歌ったり演奏したりするときが本当の姿です。自由に描いてください。\n\n読んでくださってありがとうございました。無理な場合はキャンセルしてください。", "created_at": "", "completed_at": ""}, {"path": "/@saxe_blue02/works/1", "thumbnail_src": "https://si.imgix.net/8248adbd/uploads/origins/f3498eb2-2666-479a-bd05-049d0f9051d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97692093995af0ed9cfd80fdec46d0bd", "thumbnail_srcset": "https://si.imgix.net/8248adbd/uploads/origins/f3498eb2-2666-479a-bd05-049d0f9051d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97692093995af0ed9cfd80fdec46d0bd, https://si.imgix.net/8248adbd/uploads/origins/f3498eb2-2666-479a-bd05-049d0f9051d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e233203792d6382c6532b4f36b435152 2x, https://si.imgix.net/8248adbd/uploads/origins/f3498eb2-2666-479a-bd05-049d0f9051d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c35f3414cede35e12a5adeac764663d7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生...!ご縁があって先生の作品に出会いましたが、とても素敵でした。\nもしよろしければ、私のオリジナルキャラクターを描いていただけませんか？災いをもたらす狂気の双子です。\n\nこの作品の雰囲気がとても好きなので、同じようなものをお願いしたいです！よろしくお願いします。\nhttps://twitter.com/saxe_blue02/status/1528352222723325952/photo/2\n\n詳しくは详情フォルダーをご覧ください。\nhttps://drive.google.com/drive/folders/1BZLO694WQE-qfjtVmJcCZs6-sj8S3gp0?usp=sharing\n\n双子のどちらを描いても構いませんし、服装も自由に変更してください。\nご考慮のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}