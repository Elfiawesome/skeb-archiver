fit=crop&crop=top&w=200&h=200&s=9febc8baa711962c0988a678ec6bea00 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見しております。\n私のオリジナルキャラクターを描いていただけないでしょうか。\n構図等全てイガナシさんのお好きなようにしていただいて構いません。\n服装は特に決まっていませんが、スタジャン、ジャージ、スニーカーを着せることが多いです。\nご検討いただけますと幸いです。\n\nhttps://www.pixiv.net/artworks/94373362", "created_at": "", "completed_at": ""}, {"path": "/@Iganashi1/works/38", "thumbnail_src": "https://si.imgix.net/2f7afbfb/uploads/origins/505a1eaa-219b-419b-8e02-327cdc602a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78f751efa9f4e28ec1c4a7723dbc9d73", "thumbnail_srcset": "https://si.imgix.net/2f7afbfb/uploads/origins/505a1eaa-219b-419b-8e02-327cdc602a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78f751efa9f4e28ec1c4a7723dbc9d73, https://si.imgix.net/2f7afbfb/uploads/origins/505a1eaa-219b-419b-8e02-327cdc602a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62df27991a361bba7f284631d7aeacff 2x, https://si.imgix.net/2f7afbfb/uploads/origins/505a1eaa-219b-419b-8e02-327cdc602a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60f3f18cd50a78741732cf5108664646 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Iganashi1/works/37", "thumbnail_src": "https://si.imgix.net/532d1403/uploads/origins/d19fe78e-8404-4613-9c03-2badfa4bcf06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aee94fdabe1e6480015f74ed8590419", "thumbnail_srcset": "https://si.imgix.net/532d1403/uploads/origins/d19fe78e-8404-4613-9c03-2badfa4bcf06?bg=%23fff&