at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f75e43116da0f87ca3ca6fece05d701 2x, https://si.imgix.net/f017b4bd/uploads/origins/6f360f1d-9ba0-42e9-bf69-802222f44b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1570626cd470d2b5cb982901f85bde1 3x", "genre": "art", "nsfw": false, "body": "いつもむむむ様の素敵な漫画と絵を拝見しております。\n\nなんだか楽しそうにしているうちの子「しおみ」を描いていただけますと幸いです。\n\n・シチュエーション・お洋服等はお任せ致します\n・お顔部分をSNSアイコンに使用させていただくことを考えております\n\nhttps://drive.google.com/drive/folders/1WDxZM7H9vAu4mEle_dNWAuicME2DrI7K?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@muryard/works/25", "thumbnail_src": "https://si.imgix.net/68906af7/uploads/origins/d6172be0-a32e-4f2d-93cd-76964963efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafc377921b91c751036c44cd73f2494", "thumbnail_srcset": "https://si.imgix.net/68906af7/uploads/origins/d6172be0-a32e-4f2d-93cd-76964963efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafc377921b91c751036c44cd73f2494, https://si.imgix.net/68906af7/uploads/origins/d6172be0-a32e-4f2d-93cd-76964963efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a691b533a1fa5611cc5ac9fdee11a35 2x, https://si.imgix.net/68906af7/uploads/origins/d6172be0-a32e-4f2d-93cd-76964963efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d92d7fc16e4692d68ec220b3f7bbaf65 3x", "genre": "art", "nsfw": false, "body": "私のファーソナであるキッドを描いていただきたいです。\n・小狐\n・大きい尻尾\n・目と爪は落ち着いた青、手先足先の毛色は黒\n・エスニック系の服装\nお忙しいところ大変恐縮なのですが、可能ならクリスマス絵としてブッシュドノエルを入れて欲しいです（ケーキでも、本物の木のように大きいものでも）。\n\nhttps://twitter.com/chtrmyas/status/1424173143040544770?s=21", "created_at": "", "completed_at": ""}, {"path": "/@muryard/works/24", "thumbnail_src": "https://si.imgix.net/6efe240d/uploads/origins/fcd21af7-0418-40a7-b584-71bf63ce9cae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e249175e9e64ef3b21242d87877a8a3", "thumbnail_srcset": "h