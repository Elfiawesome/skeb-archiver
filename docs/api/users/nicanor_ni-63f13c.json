drive/folders/16pj4burWNlP8PB3DP1pQwyDEyZ1fBqTR", "created_at": "", "completed_at": ""}, {"path": "/@nicanor_ni/works/4", "thumbnail_src": "https://si.imgix.net/aedfd275/uploads/origins/598d2f51-492b-4f24-83e4-befc25b936f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f65dbe36304f3dc80bb90a47440e501", "thumbnail_srcset": "https://si.imgix.net/aedfd275/uploads/origins/598d2f51-492b-4f24-83e4-befc25b936f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f65dbe36304f3dc80bb90a47440e501, https://si.imgix.net/aedfd275/uploads/origins/598d2f51-492b-4f24-83e4-befc25b936f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a98186d6421f36845709ca1b6bfc225 2x, https://si.imgix.net/aedfd275/uploads/origins/598d2f51-492b-4f24-83e4-befc25b936f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caaa979271a7ffbcbe19896b56f33893 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nうちの猫を描いていただきたいです。\n猫型、人型問いません。ニカさんにお任せいたします。\nよろしくおねがいします。\n\nhttps://twitter.com/f_nonen/status/1545247094289469440?t=cfCNR4ah60L-iaCme2ekZg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@nicanor_ni/works/3", "thumbnail_src": "https://si.imgix.net/d1dff7dd/uploads/origins/3e884ab7-8ac8-4165-83a4-824b104ae27f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4409f320611ae749744de061041ec977", "thumbnail_srcset": "https://si.imgix.net/d1dff7dd/uploads/origins/3e884ab7-8ac8-4165-83a4-824b104ae27f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4409f320611ae749744de061041ec977, https://si.imgix.net/d1dff7dd/uploads/origins/3e884ab7-8ac8-4165-83a4-824b104ae27f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f686357763ef3dd43ae1140df7ea21cb 2x, https://si.imgix.net/d1dff7dd/uploads/origins/3e884ab7-8ac8-4165-83a4-824b104ae27f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3374364191359d16a65266092c4a04ed 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nicanor_ni/works/2", "thumbnail_src": "https://si.imgix.net/8067e059/uploads/origins/84433e02-a5ab-479a-9b7e-6f48363b724a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e898c325059213f99ef8e16b920d4680", "thumbnail_srcset": "https://si.imgix.net/8067e059/uploads/origins/84433e02-a5ab-479a-9b7e-6f48363b724a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e898c325059213f99ef8e16b920d4680, https://si.imgix.net/8067e059/uploads/origins/84433e02-a5ab-479a-9b7e-6f48363b724a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca047a6539a3a2c412d99b8cf98cb10 2x, https://si.imgix.net/8067e059/uploads/origins/84433e02-a5ab-479a-9b7e-6f48363b724a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=966b7d1952f6d9268aec19a6bf90b69d 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！いつも素敵なイラスト拝見させていただいております‼\nSkebで依頼ということ自体が始めてで勝手がいまいち分かっておりませんが、リクエストさせていただきます。\n基本お任せでニカさんが楽しんで描ける絵をワクワクしてお待ちしようと思いますが、もし可能でしたら種族だけエルフにしていただけたら嬉しいです。（イケ爺エルフとかだと泣いて喜びます）\n宜しくお願いします!!", "created_at": "", "completed_at": ""}, {"path": "/@nicanor_ni/works/1", "thumbnail_src": "https://si.imgix.net/14d16609/uploads/origins/e9354dd0-e5a8-4e12-847d-b62918bac444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffedb21b4ac8443a836f93fcd72f4d9", "thumbnail_srcset": "https://si.imgix.net/14d16609/uploads/origins/e9354dd0-e5a8-4e12-847d-b62918bac444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffedb21b4ac8443a836f93fcd72f4d9, https://si.imgix.net/14d16609/uploads/origins/e9354dd0-e5a8-4e12-847d-b62918bac444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e063a97648b9689284f9308064681622 2x, https://si.imgix.net/14d16609/uploads/origins/e9354dd0-e5a8-4e12-847d-b62918bac444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62f3eb13596640075ee5dafbe93b8812 3x", "genre": "art", "nsfw": false, "body": "こんにちは、今スケブリクエストを開いてくれて本当に嬉しいです:)\n私のOCをデザインして描いていただけませんか？\n私のOCは文字だけの説明で申し訳ないのですが、あなたの想像力で素敵なデザインにしていただけると本当にありがたいです。\n[正体・背景］\n人の感情や気持ちも含めて「すべてを凍らせた悪魔」です。悪魔でありながら、人間と変わらない姿をしている。人と契約することで力を得ている。\n外見\n容姿は16歳の少年で、サラサラの白い短髪に灰色の瞳をしている。悪魔の翼と悪魔の角はない。\n額には3枚の花弁を持つ雪の結晶のような悪魔のマークがある。色は黒である。\n魔法の模様の入った白いガウンを着ていて、靴は履いていない。\n爪が長い。\n[特徴】。］\n他人を利用したり、人間をからかったりするのが好き。あまり笑わないが、笑うとサメの歯が見える。普通の調子で冷静に悪口を言うことができる。", "created_at": "", "completed_at": ""}]}