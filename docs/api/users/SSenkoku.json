いる順番待ちの触手たち。\n③①～②の背景差分。異形精子に群がられ受精しかけているサムス卵子。\n④挿入前差分。無防備な割れ目に迫りくる触手たちに「来るな・・・来ないで・・・っ・・！！」\n\n以上、対戦よろしくお願いいたします。\n\nhttps://www.youtube.com/watch?v=Iy-HyrhCxZk&t=122s", "created_at": "", "completed_at": ""}, {"path": "/@SSenkoku/works/109", "thumbnail_src": "https://si.imgix.net/b75d0455/uploads/origins/88f6ed2b-a1ee-4967-934c-f4c1956c61cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=497b725a05ab7f9ba21e66a934ab9400", "thumbnail_srcset": "https://si.imgix.net/b75d0455/uploads/origins/88f6ed2b-a1ee-4967-934c-f4c1956c61cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=497b725a05ab7f9ba21e66a934ab9400, https://si.imgix.net/b75d0455/uploads/origins/88f6ed2b-a1ee-4967-934c-f4c1956c61cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=444e1479a7fecbd7ef4e985c5d71c740 2x, https://si.imgix.net/b75d0455/uploads/origins/88f6ed2b-a1ee-4967-934c-f4c1956c61cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2d36e43d4e1fa56b1a839ae3d3b4245 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SSenkoku/works/108", "thumbnail_src": "https://si.imgix.net/ecf75566/uploads/origins/17e13d2d-637f-4f3d-877f-5e02d782e91d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d35c620a18196cf797f06a47121ad6e5", "thumbnail_srcset": "https://si.imgix.net/ecf75566/uploads/origins/17e13d2d-637f-4f3d-877f-5e02d782e91d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d35c620a18196cf797f06a47121ad6e5, https://si.imgix.net/ecf75566/