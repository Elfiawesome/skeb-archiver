fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a27b7d07825d5ca4a3c053085ca05e4c", "thumbnail_srcset": "https://si.imgix.net/d912fce0/uploads/origins/82d164a0-369c-41d2-bec9-e462c1c7b4cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a27b7d07825d5ca4a3c053085ca05e4c, https://si.imgix.net/d912fce0/uploads/origins/82d164a0-369c-41d2-bec9-e462c1c7b4cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bcf899930ed4a9572056d727939c0f9 2x, https://si.imgix.net/d912fce0/uploads/origins/82d164a0-369c-41d2-bec9-e462c1c7b4cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d49ce07f6329113ce1b58c292dbb642b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@misora_sorairo/works/25", "thumbnail_src": "https://si.imgix.net/ffcba25c/uploads/origins/1fb91cc9-7726-4a7a-b35b-3ba104b9d446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecc178917224a6b21ef1cc82c1b2426f", "thumbnail_srcset": "https://si.imgix.net/ffcba25c/uploads/origins/1fb91cc9-7726-4a7a-b35b-3ba104b9d446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecc178917224a6b21ef1cc82c1b2426f, https://si.imgix.net/ffcba25c/uploads/origins/1fb91cc9-7726-4a7a-b35b-3ba104b9d446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4202e2d11cf13f9d5de16fc649d6d37 2x, https://si.imgix.net/ffcba25c/uploads/origins/1fb91cc9-7726-4a7a-b35b-3ba104b9d446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6afd754dc24b61a3560f156e7732b411 3x", "genre": "art", "nsfw": true, "body": "こんにちは。アタストと申します。\nMisskey.ioでお見かけして、素敵なイラストに興味を抱きましたので、リクエストさせていただきます。\nうちのコ、矢印がモチーフの男の娘、「ベクトリア・サンセット」が、どこかの、フロート工場の広大な倉庫内の一角でこっそり、自分の何十倍何百倍もあり、倉庫をほとんど埋め尽くすぐらいのサイズの、参考画像のようなドラゴンのフロートを高出力で膨らまし続け、巨大化させ続けながら、乗り、ハグし、その大きさとその感触、そして膨張の感覚に気持ちよくなっていってしまうイラストをお願いします。\nデザインはすきな方でお願いします。\nフロートは、プールとかで見るサメとかシャチとかフラミンゴとかユニコーンとかの形をしたでっかい浮き輪みたいなやつのことです。\n可能であれば、さらにデカいサイズの差分が欲しいです。そうするとしたら、考えうるサイズより2段階上のサイズでお願いします。\n何卒よろしくお願いします。\n↓フロートのフェチポイント\n・丸っこいデザイン\n ・乗ることを想定したエッチな曲線 \n・ビニールの質感、シワ部分\n ・空気のクッションの感覚 \n・膨張するときの張っていく感触と形になっていく感触 \n・さらにデカくなっていく押し上げられる感触 \n・とにかくデカい 理解できないほどデカい \n・膨張の影響で周りに怪獣映画並みの被害がでる \n・ギャグ調なのが逆に萌える \n・空気がたっぷり…クッション性が高い…アッ…ハグしたい…埋もれたい… \n（補助）たくさんある…埋もれたい…\n・まだ膨らめる　という希望的観測も大事\nふわふわぎゅむぎゅむなのが 破壊するっていうのは　表現として大事 \n強いですよ　お前には勝てませんよ　甘えろ →すごくいい\n↑\nこちらを意識してほしいです。\n参考\nhttps://ul.h3z.jp/U9s2i89n.png\nhttps://ul.h3z.jp/b1jhePbc.png\nhttps://ul.h3z.jp/ZofKmUeQ.jpg\nhttps://x.com/Dio_Draco/status/1998330955354825166", "created_at": "", "completed_at": ""}, {"path": "/@misora_sorairo/works/24", "thumbnail_src": "https://si.imgix.net/c9a5fba2/uploads/origins/be65fca0-fff2-4370-893a-0c26c42aeb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=990ff587fcf1ce017085af4172fe7ed1", "thumbnail_srcset": "https://si.imgix.net/c9a5fba2/uploads/origins/be65fca0-fff2-4370-893a-0c26c42aeb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=990ff587fcf1ce017085af4172fe7ed1, https://si.imgix.net/c9a5fba2/uploads/origins/be65fca0-fff2-4370-893a-0c26c42aeb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c3b3cd57331ca2c4b1aa8f02371616b 2x, https://si.imgix.net/c9a5fba2/uploads/