99606708", "created_at": "", "completed_at": ""}, {"path": "/@0zz_uu/works/2", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/4f9aa284/uploads/origins/c84d7ead-ec6d-4cc4-aa54-737da16d8dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc30d49cedb13653f011c8c40a7eb4d7", "thumbnail_srcset": "https://si.imgix.net/4f9aa284/uploads/origins/c84d7ead-ec6d-4cc4-aa54-737da16d8dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc30d49cedb13653f011c8c40a7eb4d7, https://si.imgix.net/4f9aa284/uploads/origins/c84d7ead-ec6d-4cc4-aa54-737da16d8dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae1bc94d314a850eacc73ffb99bd36c9 2x, https://si.imgix.net/4f9aa284/uploads/origins/c84d7ead-ec6d-4cc4-aa54-737da16d8dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b96fc2f37bfb97f092003d766a02e2d2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@0zz_uu/works/1", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/8e50f87a/uploads/origins/8558d9cf-19fb-4be4-b889-88ea1e1e0c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aa2a0ea4090592a2bfd24f703b1a8c0", "thumbnail_srcset": "https://si.imgix.net/8e50f87a/uploads/origins/8558d9cf-19fb-4be4-b889-88ea1e1e0c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aa2a0ea4090592a2bfd24f703b1a8c0, https://si.imgix.net/8e50f87a/uploads/origins/8558d9cf-19fb-4be4-b889-88ea1e1e0c0d?bg=%23fff&auto=f