3a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b38cd0d5cdb47fe266b9d807788530df", "thumbnail_srcset": "https://si.imgix.net/a257f5c1/uploads/origins/998b6827-a293-4484-abe1-98dc1403a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b38cd0d5cdb47fe266b9d807788530df, https://si.imgix.net/a257f5c1/uploads/origins/998b6827-a293-4484-abe1-98dc1403a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cc060695dd187a0621e912bcbe18976 2x, https://si.imgix.net/a257f5c1/uploads/origins/998b6827-a293-4484-abe1-98dc1403a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e56b490102257dd0f567352bd27cf9c 3x", "genre": "art", "nsfw": false, "body": "ろってさんこんにちは。\n人生で初めてすけぶを依頼します。ろってさんにぜひ自宅キャラ久蛾をお願いしたく伺いました。\n背景込みで、荘厳な青っぽい教会にいるシーンか、神父らしく優しげで慕われている雰囲気のシーンだと嬉しいです。\n\n資料はこちらです。衣装はどれでも可、白の神父服など捏造でも構いません。\nhttps://twitter.com/kmysusk/status/1271944391439966208?s=21\nhttps://twitter.com/kmysusk/status/1411285835081678858?s=21", "created_at": "", "completed_at": ""}, {"path": "/@shushirotte/works/5", "thumbnail_src": "https://si.imgix.net/e30a7837/requests/175298_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a5540117353fac23a6a65301244741d", "thumbnail_srcset": "https://si.imgix.net/e30a7837/requests/175298_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a5540117353fac23a6a65301244741d, https://si.imgix.net/e30a7837/requests/175298_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2de2de12057aaf5e4e850bb664582cc 2x, https://si.imgix.net/e30a7837/requests/175298_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8a403b5a91f7c6857b1157099c33c17 3x", "genre": "art", "nsfw": false, "body": "ろって様\n\nお世話になっております。\nこの度はスマートフォンアプリ「黄昏のグラドシル」「流転のグリマルシェ」にて使用可能な新規イラストの製作をご依頼したくリクエストを送信させていただきました。\n本文に目を通していただき、ご検討いただければ幸いです。\n以下、概要となります。\n\nイラストサイズ：800×900　PNG形式\n解像度：360dpi\n構図：バストアップを希望。ポーズ自由、表情は はにかんだような笑顔を希望。\n\nイラスト原型：ツイッターアカウント@0055_s_long_inuの固定ツイートに表示されている画像のキャラクター。\n武器等の装飾品は不要です。\n\n以上です。\n\n何卒よろしくお願いいたします。\n\nゴリラ", "created_at": "", "completed_at": ""}, {"path": "/@shushirotte/works/4", "thumbnail_src": "https://si.imgix.net/30115b1d/requests/138677_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4716d9653300178c72c9ac99dbfe094", "thumbnail_srcset": "https://si.imgix.net/30115b1d/requests/138677_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4716d9653300178c72c9ac99dbfe094, https://si.imgix.net/30115b1d/requests/138677_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6614623ff958586c87f4a9973a19f4a3 2x, https://si.imgix.net/30115b1d/requests/138677_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=108757c6ab22e3e67137cbf0df9fa613 3x", "genre": "art", "nsfw": false, "body": "こんにちは。いつもろってさんの夢創作を楽しく拝見させて頂いています。今回の依頼ではうちの子を描いていただきたいです。\nONEPIECEのトラファルガー･ローお相手の固定夢主ちゃんで、とにかく優しい天使のような女の子という設定です。\n\n名前…ユキヨ･カスターニャ(22歳)\n添付した画像の通り髪は赤茶っぽい明るい色で胸の下あたりまである天然パーマ。ロリ巨乳の分類に入る子です。シマリスに変身できます。\nしっかり者で真面目でとても優しい子なのですが、かなりのヤキモチ妬きで独占欲が強めです。\nひなたぼっこが好きで、よくシマリスに変身してお昼寝してます。\n\n表情差分も添付しておきます。イラストの発想に役立てていただければ幸いです。\n\nhttps://drive.google.com/file/d/1kPNrxdDKz5KWvR4ffm0SH4fGdsv8RFrC/view?usp=drivesdk\n\nいつも楽しく夢絵を見させてもらっています。hrakのばっきりこまに惹かれてフォローしたのですが、最近描いてらっしゃるトレソノも可愛くてtwst沼にも沈みそうです。ろってさんの描くソノちゃん様は可愛いし先輩もかっこよくて…。\n今回の依頼もファンからの投げ銭だと思って気軽に描いていただければ…と思いながらさせていただいています。\n季節の変わり目で天気も不安定なので、お体ご自愛ください。ファンレターみたいになってしまいました。すみません…。\nよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1mMWhLfz_ZtCiX35mm_d9VBm9PNaW_63E/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@shushirotte/works/3", "thumbnail_src": "https://si.imgix.net/119613bb/requests/138600_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df