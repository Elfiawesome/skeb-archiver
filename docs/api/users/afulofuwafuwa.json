ed_at": "2026-03-16T23:44:47.231855+00:00"}]}, "current_prices": {"art": 12000}, "price_range": {"art": {"min": 5000, "max": 12000}}, "links": [{"label": "Twitter", "url": "https://x.com/afulofuwafuwa", "name": "afulofuwafuwa"}, {"label": "Misskey_io", "url": "https://misskey.io/@volvol", "name": "volvol"}, {"label": "Website", "url": "http://odaibako.net/u/afulofuwafuwa", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/555336", "name": "555336"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/508673", "name": "508673"}], "flags": {"from_archive": true}, "works": [{"path": "/@afulofuwafuwa/works/125", "thumbnail_src": "https://si.imgix.net/59cb07cf/uploads/origins/c3ffa419-1b8a-42b7-ab66-fad5d4ddce4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab7742eced35c8d801da0a0c4048e80", "thumbnail_srcset": "https://si.imgix.net/59cb07cf/uploads/origins/c3ffa419-1b8a-42b7-ab66-fad5d4ddce4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab7742eced35c8d801da0a0c4048e80, https://si.imgix.net/59cb07cf/uploads/origins/c3ffa419-1b8a-42b7-ab66-fad5d4ddce4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9a99c9d059a39356ca9c65b1602485e 2x, https://si.imgix.net/59cb07cf/uploads/origins/c3ffa419-1b8a-42b7-ab66-fad5d4ddce4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a13fe4d93dff11eb6c046b455a36b79e 3x", "genre": "art", "nsfw": false, "body": "依頼ですが、\nRimworld動画【罪とRim】のファンアートを再びお願いします\n\n絵の設定は7話以降の物になります\n\n＊概要\n主人公サイドのメンバーである、リソフとオークション男の1枚絵をお願いします\n\n＊構図\n①オークション男に寄り添うリソフ\n②リソフがメインで映るように描き、オークション男は腕や肩などの極一部のみが見える構図にして下さい\n③オークション男の服装はhttps://seiga.nicovideo.jp/seiga/im11116449?track=seiga_illust_keyword にしてください\n\n\n＊リソフについて\nゲーム中のグラフィックなどから、「左目がない豊満な体型の中年女性」な設定なわけですが、\n\n◉詳細\n3話（https://www.nicovideo.jp/watch/sm45479738?ref=nicoiphone_other）の\nや11:51〜12:27\n5話の（https://www.nicovideo.jp/watch/sm45681775?ref=nicoiphone_other）の\n24:06〜\n\nを\n\nとりあえず体型はhttps://www.nicovideo.jp/watch/sm45969606?ref=nicoiphone_other の22:17を基準に描いてください\n\n\n前回のイラストに続けて、完成品はファンアート紹介コーナーで紹介してもらおうと思ってます", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/124", "thumbnail_src": "https://si.imgix.net/3de32f26/uploads/origins/b956aa2a-3c2b-4a38-8626-4f9504b501fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53e58a1911d9ba93f3181b9868ad93f", "thumbnail_srcset": "https://si.imgix.net/3de32f26/uploads/origins/b956aa2a-3c2b-4a38-8626-4f9504b501fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53e58a1911d9ba93f3181b9868ad93f, https://si.imgix.net/3de32f26/uploads/origins/b956aa2a-3c2b-4a38-8626-4f9504b501fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a988be13c08ce7dfa5a88308e1c91c3 2x, https://si.imgix.net/3de32f26/uploads/origins/b956aa2a-3c2b-4a38-8626-4f9504b501fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e23454fc16cd47801a1f92885cabcfa 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nRimworldのファンアートの依頼ですが、\n\n【罪とRim】のこれを依頼した時点での最新話である7話（https://www.nicovideo.jp/watch/sm45894057?ref=nicoiphone_other）のワンシーンを描いてください\n\n\n＊詳細\n①怒りと悲しみの籠った表情で、ヤケになってAKYSをな ぐるAKNM\n②それに対し、無言で拳を受けるAKYS\n\n↑の両者の顔部分のアップを描いた大ゴマ2つの1P漫画でお願いします\n\n\n\nこの回はAKNM関連のシリアス描写がとても印象的だったので、依頼をしてみることにしました\n\n\nなお完成品は、作者のあんせむ氏に動画の最後のファンアート紹介コーナーで紹介してもらおうと思っています", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/123", "thumbnail_src": "https://si.imgix.net/c3ec43cd/uploads/origins/5c05c44b-390a-490c-9f96-88fd338f5dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10100e9759b1027ee5f3afbbeb56dc65", "thumbnail_srcset": "https://si.imgix.net/c3ec43cd/uploads/origins/5c05c44b-390a-490c-9f96-88fd338f5dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10100e9759b1027ee5f3afbbeb56dc65, https://si.imgix.net/c3ec43cd/uploads/origins/5c05c44b-390a-490c-9f96-88fd338f5dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56a19b69a4a936e3c6740ed73e055dca 2x, https://si.imgix.net/c3ec43cd/uploads/origins/5c05c44b-390a-490c-9f96-88fd338f5dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ce79687784a9d64eb3d16ba02a1630c 3x", "genre": "art", "nsfw": true, "body": "リクエストを可能でしたらお願いします。\n\n【キャラクター】秋山澪（けいおん！）\n【シチュ】部室で下着姿になっているイラストをお願いします。また、金額内で下着無しの差分の方も可能でしたらよろしくお願いします。\n\nご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/122", "thumbnail_src": "https://si.imgix.net/9289336e/uploads/origins/7c610689-08af-445c-bf57-b19b92db9721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8d32ecc5b8e29e29213e03245627db0", "thumbnail_srcset": "https://si.imgix.net/9289336e/uploads/origins/7c610689-08af-445c-bf57-b19b92db9721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8d32ecc5b8e29e29213e03245627db0, https://si.imgix.net/9289336e/uploads/origins/7c610689-08af-445c-bf57-b19b92db9721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07f7b5cc88ba9d2c9bb351158100a0f4 2x, https://si.imgix.net/9289336e/uploads/origins/7c610689-08af-445c-bf57-b19b92db9721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d4e8935fd101583929f30cd0b174607 3x", "genre": "art", "nsfw": true, "body": "昨年、秋山澪と桐ヶ谷直葉の下着姿のイラストを描いていただきありがとうございました。今回も可能でしたらよろしくお願い致します。\n〈リクエスト内容〉ガンダムビルドファイターズトライのホシノ・フミナとキャプテン・アースの夢塔ハナが更衣室で下着姿になっているイラストを可能でしたらお願い致します。  （今回もおっぱいは巨乳でお願い致します。また、金額内で下着無しの差分の方も可能でしたらよろしくお願い致します。 ）\n\nホシノ・フミナ\nhttps://www.gundam-bf.net/try/characters/03/\n\n夢塔ハナ\nhttps://neoapo.com/characters/20885", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/121", "thumbnail_src": "https://si.imgix.net/d52f198c/uploads/origins/a1002ed3-db04-4dff-955a-3bfb8ac3b714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b844cf82034c012167f20570e5f94ec6", "thumbnail_srcset": "https://si.imgix.net/d52f198c/uploads/origins/a1002ed3-db04-4dff-955a-3bfb8ac3b714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b844cf82034c012167f20570e5f94ec6, https://si.imgix.net/d52f198c/uploads/origins/a1002ed3-db04-4dff-955a-3bfb8ac3b714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b8f13cfad516ef04a0126630ef062e 2x, https://si.imgix.net/d52f198c/uploads/origins/a1002ed3-db04-4dff-955a-3bfb8ac3b714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb383329d2b2d6cd58c3b0a7690a20e6 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\n・キャラ　結城明日奈　桐ヶ谷直葉　（ソードアート・オンライン）\n・シチュ　下着姿のイラストをお願いします。また、可能でしたら全裸姿の差分もお願いします。 \n（2人の乳は同じ大きさの巨乳でお願いします。）\n\n結城明日奈\nhttps://www.swordart-online.net/sp/phantom/character/chara03.html\n\n桐ヶ谷直葉\n https://www.swordart-online.net/sp/fairy/character/chara02.html", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/120", "thumbnail_src": "https://si.imgix.net/8c09f688/uploads/origins/c1ae6204-4ec7-4769-b109-07a6323d86c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de681c60a617fbbc55ebebf8f489150", "thumbnail_srcset": "https://si.imgix.net/8c09f688/uploads/origins/c1ae6204-4ec7-4769-b109-07a6323d86c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de681c60a617fbbc55ebebf8f489150, https://si.imgix.net/8c09f688/uploads/origins/c1ae6204-4ec7-4769-b109-07a6323d86c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=739ec9a61dfe551dd8eeab90d34522cf 2x, https://si.imgix.net/8c09f688/uploads/origins/c1ae6204-4ec7-4769-b109-07a6323d86c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce582cb4d64431dbe12813cc0db8ed0a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/119", "thumbnail_src": "https://si.imgix.net/55c2d9fb/uploads/origins/b5da25b5-183f-4d8a-becb-af4bef854b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4389f416e31d987dcdad5b1f21b998c3", "thumbnail_srcset": "https://si.imgix.net/55c2d9fb/uploads/origins/b5da25b5-183f-4d8a-becb-af4bef854b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4389f416e31d987dcdad5b1f21b998c3, https://si.imgix.net/55c2d9fb/uploads/origins/b5da25b5-183f-4d8a-becb-af4bef854b50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b33dc68d54bd878015bd4d823696a236 2x, https://si.imgix.net/55c2d9fb/uploads/origins/b5da25b5-183f-4d8a-becb-af4bef854b50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68cba3e24558640f954a50947d07fdd9 3x", "genre": "art", "nsfw": true, "body": "匿名のリクエストで失礼致します。\n〈リクエスト内容〉けいおん！の秋山澪とソードアート・オンラインの桐ヶ谷直葉が更衣室で下着姿になっているイラストを可能でしたらお願い致します。 \n（2人のおっぱいは巨乳でお願い致します。また、金額内で下着無しの差分の方も可能でしたらよろしくお願い致します。 ）\n\nご検討の程よろしくお願い致します。\n\n秋山澪\nhttps://www.tbs.co.jp/anime/k-on/k-on_tv/chara/chara02.html\n\n桐ヶ谷直葉\nhttps://www.swordart-online.net/sp/fairy/character/chara02.html", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/118", "thumbnail_src": "https://si.imgix.net/e7731392/uploads/origins/b18c1a26-035f-45ef-93a2-fd16a819459d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cc0594f8113da718a7bc4ca71830a1b", "thumbnail_srcset": "https://si.imgix.net/e7731392/uploads/origins/b18c1a26-035f-45ef-93a2-fd16a819459d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cc0594f8113da718a7bc4ca71830a1b, https://si.imgix.net/e7731392/uploads/origins/b18c1a26-035f-45ef-93a2-fd16a819459d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb16d969cb566665d6914c9a089efb89 2x, https://si.imgix.net/e7731392/uploads/origins/b18c1a26-035f-45ef-93a2-fd16a819459d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc9cc4eb9224f84d129f688000aa0c05 3x", "genre": "art", "nsfw": true, "body": "キャラ\n『怪獣娘～ウルトラ怪獣擬人化計画～』の漫画版のゼットンさん(モノローグ共に常に丁寧語口調)\n\n服装\n何も着ておらず肌色を曝け出している。ぶっちゃけ言うと全裸(乳首が隠れるのはNG)\n\nシチュ\nパイズリ射精(生おっぱいや乳首・亀頭丸出し)+中出しセックスの同時併用\n\n竿役\n2人 デブ・ショタ・肌色が黒い・ふたなりの4つは完全NG\n\n内容\n恥ずかしがりながらも、訳あって発情したため収めるように頼み込んだゼットンさん。チンポの感触や体温でかなり感じるも気にしなくていいと言う\n↓\n動く度に軽くイキまくり、射精が近くなった事に気づいた時に早く出してほしいとねだる\n↓\nやがて大量射精。体全体を大量の精液で染められる\n↓\n目をハートにし、もっとしたいならいつでも続けていいと伝える\n\n以上です。検討の程よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/117", "thumbnail_src": "https://si.imgix.net/dcaeb106/uploads/origins/d720b9f7-07d3-43ca-b8b5-9177bcdd6812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59e9c4967ec1d37c475d63403940efcb", "thumbnail_srcset": "https://si.imgix.net/dcaeb106/uploads/origins/d720b9f7-07d3-43ca-b8b5-9177bcdd6812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59e9c4967ec1d37c475d63403940efcb, https://si.imgix.net/dcaeb106/uploads/origins/d720b9f7-07d3-43ca-b8b5-9177bcdd6812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8766a3b517634c00491cfa5c1df14e22 2x, https://si.imgix.net/dcaeb106/uploads/origins/d720b9f7-07d3-43ca-b8b5-9177bcdd6812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6887fec0879b80615441da8e0fb8bea 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。リクエスト再開お待ちしておりました。今回もうちの子と、その息子キャラのツーショットイラストをお願いします。\n資料用URL:https://x.com/CruindsKisarazu/status/1959826262228426821\n\n服装はURLのとおりで、親（ふたなり）と子（男の娘）のスカートをめくってのハート目、下腹部露出差分もお願いします。\n\nhttps://x.com/CruindsKisarazu/status/1959826262228426821", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/116", "thumbnail_src": "https://si.imgix.net/97e34c2f/uploads/origins/bcc73a44-5df7-44c9-8694-a762df0e846a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2b3f87d84dc02138b0b3cf8cee9050a", "thumbnail_srcset": "https://si.imgix.net/97e34c2f/uploads/origins/bcc73a44-5df7-44c9-8694-a762df0e846a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2b3f87d84dc02138b0b3cf8cee9050a, https://si.imgix.net/97e34c2f/uploads/origins/bcc73a44-5df7-44c9-8694-a762df0e846a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c111d24047949c7f1d784b9c4b5e75f 2x, https://si.imgix.net/97e34c2f/uploads/origins/bcc73a44-5df7-44c9-8694-a762df0e846a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f30736c9d718549990e0b488f24263e7 3x", "genre": "art", "nsfw": true, "body": "匿名のリクエストで失礼致します。\n〈リクエスト内容〉　時々ボソッとロシア語でデレる隣のアーリャさんのアリサ・ミハイロヴナ・九条、マリヤ・ミハイロヴナ・九条、更科茅咲の下着姿のイラストを可能でしたらお願い致します。 \n（3人のおっぱいは巨乳でお願い致します。また、金額内で下着無しの差分の方も可能でしたらよろしくお願い致します。 ）\n\nご検討の程よろしくお願い致します。\n\nアリサ・ミハイロヴナ・九条　https://roshidere.com/chara/alisa.html\nマリヤ・ミハイロヴナ・九条　https://roshidere.com/chara/mariya.html \n更科 茅咲　https://roshidere.com/chara/chisaki.html", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/115", "thumbnail_src": "https://si.imgix.net/abac06d6/uploads/origins/512187fe-a2d7-4895-bab4-cd90f88290cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29cc2234a9cf89742205fbfeca58551c", "thumbnail_srcset": "https://si.imgix.net/abac06d6/uploads/origins/512187fe-a2d7-4895-bab4-cd90f88290cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29cc2234a9cf89742205fbfeca58551c, https://si.imgix.net/abac06d6/uploads/origins/512187fe-a2d7-4895-bab4-cd90f88290cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3a443a69d7610e85482df64c4fc4e4e 2x, https://si.imgix.net/abac06d6/uploads/origins/512187fe-a2d7-4895-bab4-cd90f88290cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42ff656c96c18b190e60717b0de49687 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/114", "thumbnail_src": "https://si.imgix.net/8fc0a64a/uploads/origins/bf544c70-e62b-43a6-8275-9b0e5857e00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b967f59b5b7aa786bae1ed050d00d88", "thumbnail_srcset": "https://si.imgix.net/8fc0a64a/uploads/origins/bf544c70-e62b-43a6-8275-9b0e5857e00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b967f59b5b7aa786bae1ed050d00d88, https://si.imgix.net/8fc0a64a/uploads/origins/bf544c70-e62b-43a6-8275-9b0e5857e00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e4425a6852554249948fcae99e92bc0 2x, https://si.imgix.net/8fc0a64a/uploads/origins/bf544c70-e62b-43a6-8275-9b0e5857e00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff70c57425af40b74e81629008909b1a 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは！お元気ですか？\nまた緊縛作品のマイ・バレンタインを期待していました。願わくば、以前の素晴らしい作品であなたが扱わなければならなかったタフなトラップモンスターよりも、ずっと簡単であってほしいです。舞がフェアリーボックスか何かで四つん這いになることを期待しています。マイはバトルシティの服装で、大きな胸が露出していて、上半身は下に引っ張られています。参考までにリンクを貼っておきます：\n\nhttps://www.pixiv.net/en/artworks/111661700\n\nhttps://www.pixiv.net/en/artworks/119128940\n\nhttps://skeb.jp/@warukuriboo/works/47\n\nhttps://www.pixiv.net/en/artworks/119761281\n\nリングギャグでフェラチオをするマイが好きだった。原作では、挿入前、挿入中、挿入後と段階を追って楽しめました。他の細かい部分はお任せします。出来れば差分も。\n\nhttps://skeb.jp/@kojikatwo/works/18", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/113", "thumbnail_src": "https://si.imgix.net/409dae81/uploads/origins/2e411c0a-2acb-4de3-a046-05ecf6efc702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d5ae1147786b446156eeee18798bde8", "thumbnail_srcset": "https://si.imgix.net/409dae81/uploads/origins/2e411c0a-2acb-4de3-a046-05ecf6efc702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d5ae1147786b446156eeee18798bde8, https://si.imgix.net/409dae81/uploads/origins/2e411c0a-2acb-4de3-a046-05ecf6efc702?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2f001b637b91c5958a1a15a9935365b 2x, https://si.imgix.net/409dae81/uploads/origins/2e411c0a-2acb-4de3-a046-05ecf6efc702?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f8080197aad17d08709de5154ddf249 3x", "genre": "art", "nsfw": true, "body": "リクエストです\n\nキャラ\n『超次元ゲイムネプテューヌ』のパープルシスター(ネプギア)\n\n服装\nパープルシスターの姿で全裸(Hカップ〜Kカップの、ちょうど良くデカい巨乳)\n\nシチュ\nパイズリ射精(生おっぱいや乳首・亀頭丸出し)+中出しセックスの同時併用\n\n竿役\n2人\nデブ・ショタ・肌色が黒い・ふたなりの4つは完全NG\n\n内容\n照れ笑いしながらパイズリとセックスを同時に行うパープルシスター。『焦らなくても2人同時に奉仕しますから』みたいな事を言いながら、2人の竿役の腰の動きに合わせて身体を動かす\n↓\nやがて2人とも限界が近づいてきた事に気づき、ドキドキしながらも笑顔でいつでも射精していいと伝える\n↓\nやがて大量射精。身体全体を白く染め上げる程の量の精液が放たれる\n↓\n全身精液まみれになりながらも、パープルシスターは目をハートにする。そして何度でも相手するからもう一度勃起するようにとおねだりする\n\n以上です。検討の程よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@afulofuwafuwa/works/112", "thumbnail_src": "https://si.imgix.net/629534ad/uploads/origins/4886e397-2a78-482e-9ccf-e4d30c9816a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34a64314ca248fb46a3f49a0fde8cbf4", "thumbnail_srcset": "https://si.imgix.net/629534ad/uploads/origins/4886e397-2a78-482e-9ccf-e4d30c9816a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&t