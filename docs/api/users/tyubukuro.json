-14cc-4e4c-9914-38c3b15cf8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50c8616f5530cfa96db3c2455bb09c5b 2x, https://si.imgix.net/d31ff492/uploads/origins/709eeb4a-14cc-4e4c-9914-38c3b15cf8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4bc8db50472aa413088a19e834f9c57 3x", "genre": "art", "nsfw": false, "body": "はじめまして。うちの子を依頼しに来ました。\nキャラは、冥界のシャボン玉メイド、ガドリアージュです。\n内容は、「ハート形のシャボン玉で投げキッスをするガドリアージュ」になります。\n\nhttps://sta.sh/01a9oiuqocat", "created_at": "", "completed_at": ""}, {"path": "/@tyubukuro/works/2", "thumbnail_src": "https://si.imgix.net/44f0fadf/uploads/origins/8d0526f6-699a-41f3-ae74-af2ebf40d3f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56da7ef0bfcd8c232038bc4b2d66907e", "thumbnail_srcset": "https://si.imgix.net/44f0fadf/uploads/origins/8d0526f6-699a-41f3-ae74-af2ebf40d3f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56da7ef0bfcd8c232038bc4b2d66907e, https://si.imgix.net/44f0fadf/uploads/origins/8d0526f6-699a-41f3-ae74-af2ebf40d3f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6541fa32ff8a931cce3f603c052ca034 2x, https://si.imgix.net/44f0fadf/uploads/origins/8d0526f6-699a-41f3-ae74-af2ebf40d3f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62286c44369cfae12b8e5063b7f15429 3x", "genre": "art", "nsfw": false, "body": "前回はつーちゃんのイラストを描いてくださりありがとうございました。とてもかわいらしかったので、再度リクエストさせていただきます。今回は、ウマ娘のイクノディクタスがシャボン玉の中に入って楽しそうに空を飛んでいるイラストをお願いします。イクノちゃんの表情や、シャボン玉の形や質感はお任せします。よければよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tyubukuro/works/1", "thumbnail_src": "https://si.imgix.net/03bd41f9/uploads/origins/fde0c2f6-4029-4b54-81c1-d23a859b1c58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8431b11bf5bb341e696fd917d913dce6", "thumbnail_srcset": "https://si.imgix.net/03bd41f9/uploads/origins/fde0c2f6-4029-4b54-81c1-d23a859b1c58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8431b11bf5bb341e696fd917d913dce6, https://si.imgix.net/03bd41f9/uploads/origins/fde0c2f6-4029-4b54-81c1-d23a859b1c58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=007207f3530f32239648cdcb8e43b923 2x, https://si.imgix.net/03bd41f9/uploads/origins/fde0c2f6-4029-4b54-81c1-d23a859b1c58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed994f44134fe71f9e60be28719947b5 3x", "genre": "art", "nsfw": false, "body": "はじめまして。依頼内容ですが、バンドリの二葉つくしちゃんが、シャボン玉の中に入って楽しそうにしているイラストをお願いします。シャボン玉の形や質感はお任せします。衣装は下記のリンク先のものでお願いします。よければよろしくお願いします。\n\nhttps://bangdream.gamedbs.jp/images/chara/card/1659113157003_dletfp80.png", "created_at": "", "completed_at": ""}]}