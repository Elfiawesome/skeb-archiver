自身の多くのバージョンを見ているところを描いてください。これらのバージョンはCOSTUME 1とCOSTUME 2で、どちらも地面に倒れています。血だらけです。COSTUME 4はショックを受けているようです。\n\nさらに、不吉な存在がいるようです。その存在がこのバージョンである：\nhttps://toyhou.se/11307012.smecher/22230790.majara-of-the-moongate\n\n最後のバージョンはどのように表示されるかを選ぶことができる。しかし、この人物が微笑んでいても、安らぐ存在には見えない。\n\nあとはお任せします。構図に問題があればお断りしてください。金額が足りない場合は再送してください。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@po_ka_mann/works/15", "thumbnail_src": "https://si.imgix.net/f3038ea2/uploads/origins/32d16ce0-1777-463c-a28e-0eb9f9223e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b490adffb2fd5ba305d34c77f631bdf1", "thumbnail_srcset": "https://si.imgix.net/f3038ea2/uploads/origins/32d16ce0-1777-463c-a28e-0eb9f9223e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b490adffb2fd5ba305d34c77f631bdf1, https://si.imgix.net/f3038ea2/uploads/origins/32d16ce0-1777-463c-a28e-0eb9f9223e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfc01344911ac30ce27cb972b6c7cc3d 2x, https://si.imgix.net/f3038ea2/uploads/origins/32d16ce0-1777-463c-a28e-0eb9f9223e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ea1bf6c1b9e86385bda9d48278aa4f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@po_ka_mann/works/14", "thumbnail_src": "https://si.imgix.net/51b280d1/uploads/origins/4a8f301f-91fb-4f03-872d-810186ce979f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=535b8689d2193