t/9f6f98bc/uploads/origins/c68a5bcb-7e52-4601-84b1-157fa48eada1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d60851bd31984ae64fb10b34176c22e8 2x, https://si.imgix.net/9f6f98bc/uploads/origins/c68a5bcb-7e52-4601-84b1-157fa48eada1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b217f59de3d20e307362f0006c17bb0e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hasugasuki/works/14", "thumbnail_src": "https://si.imgix.net/774d89e8/uploads/origins/ab084ccf-9563-4087-81cd-2dfbb6b4ed53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e3e90b241c179ea913d236f920b61d6", "thumbnail_srcset": "https://si.imgix.net/774d89e8/uploads/origins/ab084ccf-9563-4087-81cd-2dfbb6b4ed53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e3e90b241c179ea913d236f920b61d6, https://si.imgix.net/774d89e8/uploads/origins/ab084ccf-9563-4087-81cd-2dfbb6b4ed53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ceb574aaf36c3638497e9018c785c3e 2x, https://si.imgix.net/774d89e8/uploads/origins/ab084ccf-9563-4087-81cd-2dfbb6b4ed53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9353fb1f802438866d98629cec677683 3x", "genre": "art", "nsfw": false, "body": "こんにちは。擽ル／ハスガスキ先生の透明感、ハイライトから感じる暖かさ、素晴らしいデザインとデッザン力に惚れ惚れしてしまい、ぜひ私のＶの姿を描いて頂きたいと思いました。\n猫耳と尻尾、少し先がとがった人間の耳、猫口、口を開いたら八重歯、顔に似合わないお胸が大きいのが特徴です。\n\nテーマは水中　くらげのような神秘的な少女　透明感、キラキラ、ふわふわ\n・深海ではなく明るい青い水中に浮いている少女、泡、水中でのハイライトキラキラなど\nくらげのように髪やスカートがふわふわしている姿\n髪の長さは長くして、ぶわっと広がって流れる感じにして頂いても大丈夫です(三つ編みもなくてもかまいません）。\nお洋服は、先生のオリジナルでお願いします。ふんわりで画像のようなミニ＋ふわふわのテイルロングスカートで画像のようにボリューミーな感じがよいです。\n足はみえてると嬉しいですがポーズ、表情、構図は全てお任せします。もし足先まで入る場合、裸足でも靴をはいていてもかまいません(くつの場合はお上品でセクシーなピンヒールでお願い