977a-42bc-90ca-fa84374cff72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71c838d1d84c515521b17aa9bf3f3ea7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/80", "thumbnail_src": "https://si.imgix.net/48200712/uploads/origins/0f10a075-17e8-4d9a-a71e-ede5857b4566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a3659f9cb6726c2a9cea45b269a10ae", "thumbnail_srcset": "https://si.imgix.net/48200712/uploads/origins/0f10a075-17e8-4d9a-a71e-ede5857b4566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a3659f9cb6726c2a9cea45b269a10ae, https://si.imgix.net/48200712/uploads/origins/0f10a075-17e8-4d9a-a71e-ede5857b4566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58b405c4fdd2c6dfe1f1d8e632ea9c1d 2x, https://si.imgix.net/48200712/uploads/origins/0f10a075-17e8-4d9a-a71e-ede5857b4566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc2ad27d38826ec3bef311eb297a04e1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/79", "thumbnail_src": "https://si.imgix.net/3d8d77ae/uploads/origins/e124e2a8-4f87-4084-a606-69b055ff1029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9f08e419ecfdd49556020ce9216c181", "thumbnail_srcset": "https://si.imgix.net/3d8d77ae/uploads/origins/e124e2a8-4f87-4084-a606-69b055ff1029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9f08e419ecfdd49556020ce9216c181, https://si.imgix.net/3d8d77ae/uploads/origins/e124e2a8-4f87-4084-a606-69b055ff1029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5d3accab69ff2f0d3ce120c8abe5ecf 2x, https://si.imgix.net/3d8d77ae/uploads/origins/e124e2a8-4f87-4084-a606-69b055ff1029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=880b838230acd85651c32188338007cb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\nあなたの最近の作品にインスパイアされました： https://skeb.jp/@Quitterie/works/77\n\nあなたの画風が大好きなので、私のキャラクター \"Annoying \"をかっこいいポーズで描いてほしいです。詳細はお任せします。\n\n\"迷惑 \"は、以前はとても悲しい女の子でしたが、最近新しい友達ができて、少し幸せになりました。自分ではおしゃれだと思っているが、知らないうちにバカになっていることもある。\n\nこのリクエストにご賛同いただけたらとても嬉しいです。\n\n名前は \"うっとうしい \"とも書けます。\n参考：https://i.imgur.com/sNt3XbN.png\n\nhttps://i.imgur.com/sNt3XbN.png", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/78", "thumbnail_src": "https://si.imgix.net/230023f2/uploads/origins/3d298a4e-fccd-4060-840a-80b6b0ce7972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e2a7310fb8fb1f018a46037ec30c344", "thumbnail_srcset": "https://si.imgix.net/230023f2/uploads/origins/3d298a4e-fccd-4060-840a-80b6b0ce7972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e2a7310fb8fb1f018a46037ec30c344, https://si.imgix.net/230023f2/uploads/origins/3d298a4e-fccd-4060-840a-80b6b0ce7972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f131501b5ac151d808cdeb28067b9734 2x, https://si.imgix.net/230023f2/uploads/origins/3d298a4e-fccd-4060-840a-80b6b0ce7972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68d872083a7f08e72d52136a61330efd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nまた自キャラのイラストのリクエストを依頼したいです。\n\n今回はピクトマンサーという、\n筆を武器に戦うジョブになっています。\n\n空中に絵を描きますが、\n「絵を描いている」ことにこだわらずに、\n躍動感あるポーズだとうれしいです。\n左手に持っているパレットはポーズ次第で省略してしまっても大丈夫です。\nまた、背景は単色で構いません。\n\n何度かリクエストを依頼していますが、\n特に1枚目の印象（表情、頭身、体型、肌の色）が\nまさに解釈一致なので、この感じでお願いします！\n\n参考画像はこちらになります。\nhttps://drive.google.com/drive/folders/1HXgASRIcn6uMfCK08uXB5asq5Shu4kx8\n\n\nどうぞよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1HXgASRIcn6uMfCK08uXB5asq5Shu4kx8", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/77", "thumbnail_src": "https://si.imgix.net/7a3ec45c/uploads/origins/942e725a-fb46-4252-b6e0-6832a3714c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eacc592595f39e8c74c4b74bfeb7e634", "thumbnail_srcset": "https://si.imgix.net/7a3ec45c/uploads/origins/942e725a-fb46-4252-b6e0-6832a3714c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eacc592595f39e8c74c4b74bfeb7e634, https://si.imgix.net/7a3ec45c/uploads/origins/942e725a-fb46-4252-b6e0-6832a3714c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26531945ebf7d5b56836b51df7860741 2x, https://si.imgix.net/7a3ec45c/uploads/origins/942e725a-fb46-4252-b6e0-6832a3714c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6e39ffd7a66b26d7796052f85a79ec4 3x", "genre": "art", "nsfw": false, "body": "はじめまして！FF14のキャラを描いて欲しいです！\n\nイメージは召喚士でドヤ顔している感じです。その他はお任せいたします！\n\n利用用途はX（Twitter）、Discordのアイコンです！\n\nよろしくおねがいします！\n\nhttps://imgur.com/a/VPBf1Y2", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/76", "thumbnail_src": "https://si.imgix.net/6d82d3fd/uploads/origins/97fff93e-1d76-4e48-8fea-32db8f7fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33615409873db3a0b71b87c71c5caef8", "thumbnail_srcset": "https://si.imgix.net/6d82d3fd/uploads/origins/97fff93e-1d76-4e48-8fea-32db8f7fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33615409873db3a0b71b87c71c5caef8, https://si.imgix.net/6d82d3fd/uploads/origins/97fff93e-1d76-4e48-8fea-32db8f7fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37e718dc59f5d83ae7f36e5661da6598 2x, https://si.imgix.net/6d82d3fd/uploads/origins/97fff93e-1d76-4e48-8fea-32db8f7fc958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaf32c2e4e32ea274d6c6b937a0ada04 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n前回の絵、ありがとうございました！\nもしよろしければ、私のFFXIVのキャラクター（シエル）をアリシエと一緒にもう一度描いてほしいです。\n彼女はおてんばな冒険者タイプ。ちょっと気まぐれで、いたずら好きな性格です。\n\nシナリオ彼女はスピンオフのエオルゼア学園（The Eorzea academy / The Studium）の生徒である。シエルとアリサエは授業をサボって、一緒に外でのんびりしている。\n\nポーズ：シエルは木に寄りかかって寝ている。帽子を目深にかぶって日差しを遮っている。アリサエは彼女に寄り添い、仲良し／親愛の情を表している。シエルとアリシエはとても仲が良く、一緒にいることをとても楽しんでいる。\n\n構図：天気はとてもよく、日差しの強いリラックスした午後。2人は素敵な木陰を見つけて座り、一緒に眠っている。\n\nあとはお好きなように描いてください！\n\nhttps://drive.google.com/file/d/1YETfQhGtBnAH8Bp8e5WHPjVNG4-M154w/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/75", "thumbnail_src": "https://si.imgix.net/402fbf16/uploads/origins/aae5a760-c180-4a48-8010-0e97badb5e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1af07ebfbc5f21e00bf730ddc2bc18ef", "thumbnail_srcset": "https://si.imgix.net/402fbf16/uploads/origins/aae5a760-c180-4a48-8010-0e97badb5e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1af07ebfbc5f21e00bf730ddc2bc18ef, https://si.imgix.net/402fbf16/uploads/origins/aae5a760-c180-4a48-8010-0e97badb5e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fc90cb70b01e464f076042651deb8cf 2x, https://si.imgix.net/402fbf16/uploads/origins/aae5a760-c180-4a48-8010-0e97badb5e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afa02880d87479a221e80ab948d8bd90 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私たちの双子のララフェルのキャラクターを描いていただけませんか？2人のリファレンスはリンク先にあります！\n\n設定としては、彼らは深夜の宿屋の部屋にいるはずです。二人とも同じ机に座っていて、ろうそくが部屋を照らしています。羽ペン、インク、羊皮紙が机の上にある。双子は故郷への手紙を書くために協力している！\n\n剣と盾を持ったキャラクターが書き物をし、姉が肩越しに見ているはずだ。机の上には封筒が置かれ、完成した手紙に封をするのを待っているのかもしれない。\n\n部屋の他の部分は複雑である必要はない。2人の後ろにベッドが2つ見えるかもしれない。星空が見える窓があってもいいかもしれない。\n\nご検討ありがとうございました\n\nhttps://imgur.com/a/Rr4k2LR", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/74", "thumbnail_src": "https://si.imgix.net/7d6e8b20/uploads/origins/c3990717-e3f6-4346-92e1-006acddf9914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f919e1ed4f52710e046f45090eb274de", "thumbnail_srcset": "https://si.imgix.net/7d6e8b20/uploads/origins/c3990717-e3f6-4346-92e1-006acddf9914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f919e1ed4f52710e046f45090eb274de, https://si.imgix.net/7d6e8b20/uploads/origins/c3990717-e3f6-4346-92e1-006acddf9914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18abd3e95d2ad4046da4555b09ff88a 2x, https://si.imgix.net/7d6e8b20/uploads/origins/c3990717-e3f6-4346-92e1-006acddf9914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8f49bf8eca77fda918c5151e16088b1 3x", "genre": "art", "nsfw": false, "body": "あけましておめでとうございます、キトリー先生いつもお世話になっております。\n前回も絶竜詩戦争の記念のイラストを描いていただきありがとうございます。\n\n今回、やっと絶オメガ検証戦をクリアし5絶済になることができました。\nそれを記念して絶オメガ武器（召喚）を持ったうちの子を描いていただけないでしょうか？\n\n資料URLにキャラクターと武器、前回前々回と先生に書いていただいたイラストをまとめております。\n背景は単色で前回描いていただいたようなピンクのカーバンクル、又は召喚獣のバハムートを一緒に描いていただけると嬉しいです。\n武器、召喚獣含め作画コストが高いと思いますので難しい場合は再送依頼か削っていただければと思います。\n\n髪色はSSですと結構くすんだピンクですがイラスト上では綺麗に見えるよう濃くしたり淡くしたり調整していただければと思います。\n\nイヤリングは前回と違いキャシーイヤリングをつけております、髪型で見えづらいですが描いていただける場合はよろしくお願いします！\n\n長々となってしまい申し訳ありません、お忙しいとは思いますが是非受けていただけると嬉しいです、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-KY5OVNjw4WbbmNwpfYJtIAyIi4ZNkrj", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/73", "thumbnail_src": "https://si.imgix.net/b4a35233/uploads/origins/d194aa81-f647-49f1-a42b-4369c5dc6739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d8698f16c7dcf843a6478c78e9d2b0", "thumbnail_srcset": "https://si.imgix.net/b4a35233/uploads/origins/d194aa81-f647-49f1-a42b-4369c5dc6739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d8698f16c7dcf843a6478c78e9d2b0, https://si.imgix.net/b4a35233/uploads/origins/d194aa81-f647-49f1-a42b-4369c5dc6739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec594a51c2eee863d446baf24e6626f3 2x, https://si.imgix.net/b4a35233/uploads/origins/d194aa81-f647-49f1-a42b-4369c5dc6739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e41849e7732d0fa70679938cb79f0f1 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\n前回ご依頼した作品があまりにも良くて、\n興奮が冷めやらぬまま、次のご依頼をさせて頂きたいです。\n\n今回は武器を持たず、海辺の砂浜で波と遊んでいる様子を描いて頂きたいです。\nポーズはお任せします。\n背景は海辺と分かる程度に描いてほしいです。\n\n上着はたくし上げて裾を結んで、おへその出ている状態にしてほしいです。\nまた、足元はサンダルではなく素足でお願いします。\n\n資料画像の後ろ2枚は上着で隠れてしまっている短パンの参考用です。\n（1枚タイミングをミスってすごい目つきになってしまいました）\n\nどうぞよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1gmA0fzELFsvyKrUzYItCB9JPrD0t3cxM", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/72", "thumbnail_src": "https://si.imgix.net/021c736e/uploads/origins/9b527160-099f-4249-b23e-19912137ef1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc032f691854b1fb4e2354ae87fc0b5e", "thumbnail_srcset": "https://si.imgix.net/021c736e/uploads/origins/9b527160-099f-4249-b23e-19912137ef1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc032f691854b1fb4e2354ae87fc0b5e, https://si.imgix.net/021c736e/uploads/origins/9b527160-099f-4249-b23e-19912137ef1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdffebab9a49a2813e1f56d710c19ae1 2x, https://si.imgix.net/021c736e/uploads/origins/9b527160-099f-4249-b23e-19912137ef1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c42d88352a98424436a95db28c078b5f 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nskebではこれが初めてのリクエストです。\nとても可愛いイラスト達で、依頼をさせて頂きたいと思いました。\n至らない点があるかもしれませんが、よろしくお願い致します。\n\nFF14の自キャラのララフェルを描いて頂きたいです。\n元気で躍動感のあるポーズだと嬉しいです。\n\n複雑な杖を持っていますが、適宜に簡略化して頂いて大丈夫です。\nまた、背景も単色で構いません。\n\nどうぞよろしくお願い致します！\n\n