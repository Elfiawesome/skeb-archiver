key=1bn0bbvk3igpn57hjn99r5h73&st=wp252zv0&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/85", "thumbnail_src": "https://si.imgix.net/3ee3ba3d/uploads/origins/d442681b-8d92-4156-9b9f-4f19c7d624ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1bb55165258fe22683d9210d976c5da", "thumbnail_srcset": "https://si.imgix.net/3ee3ba3d/uploads/origins/d442681b-8d92-4156-9b9f-4f19c7d624ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1bb55165258fe22683d9210d976c5da, https://si.imgix.net/3ee3ba3d/uploads/origins/d442681b-8d92-4156-9b9f-4f19c7d624ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33d56cd60f284d7bda91d4561789e4f2 2x, https://si.imgix.net/3ee3ba3d/uploads/origins/d442681b-8d92-4156-9b9f-4f19c7d624ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d61513ba0f35420f3b28ce16ee3a23f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nイラストをお願いします。\n紫の髪のララフェルの男の子の右頬にハート型のマークがあり、金髪のララフェルがニヤニヤしながら泡を吹いている。背景は花畑でお願いします。https://imgur.com/a/KlSHPAZ\n上の同じリンクに、両キャラクターの参考写真があります。\n参考写真をいくつか送りましたが、あなたが最適だと思う調整を自由に行ってください。", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/84", "thumbnail_src": "https://si.imgix.net/3de571cf/uploads/origins/040d4b22-f026-48cc-851c-710ce554b4ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684bc88c6f7d1732844bb6f735bee840", "thumbnail_srcset": "https://si.imgix.net/3de571cf/uploads/origins/040d4b22-f026-48cc-851c-710ce554b4ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684bc88c6f7d1732844bb6f735bee840, https://si.imgix.net/3de571cf/uploads/origins/040d4b22-f026-48cc-851c-710ce554b4ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05ee69254fa6a0444e4cb966e413adc5 2x, https://si.imgix.net/3de571cf/uploads/origins/040d4b22-f026-48cc-851c-710ce554b4ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=140bc823194be164bc7d0fa682f54857 3x", "genre": "art", "nsfw": false, "body": "やあ、僕は君の最後の作品がとても気に入ったんだ。\n\nキャラクター(1a,b)はgoogle driveの服を着て、カトラリーを持って、よだれを垂らして、食べたそうにしていてほしいです。また、キャラクターはサンダルを履いている必要はありません。\n例(example.png)のように全身サイズにしたいです。\n\nキャラクター背景の透過PSDデータをご提供いただけると幸いです。 ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1e1ZZzz4OeRrNK1QcBFlSShenMzvSLnaR?usp=sharing\n\nhttps://drive.google.com/drive/folders/1e1ZZzz4OeRrNK1QcBFlSShenMzvSLnaR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/83", "thumbnail_src": "https://si.imgix.net/239ef877/uploads/origins/ba69f3e4-8758-4061-bbc7-ac5577387269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fbb7615cbfdc56bcfe00d244664a09", "thumbnail_srcset": "https://si.imgix.net/239ef877/uploads/origins/ba69f3e4-8758-4061-bbc7-ac5577387269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fbb7615cbfdc56bcfe00d244664a09, https://si.imgix.net/239ef877/uploads/origins/ba69f3e4-8758-4061-bbc7-ac5577387269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=068d44fda508b101b23925f553d68ff7 2x, https://si.imgix.net/239ef877/uploads/origins/ba69f3e4-8758-4061-bbc7-ac5577387269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc1a53ea2014fa37a90ae8c97e6c367b 3x", "genre": "art", "nsfw": false, "body": "やあ、僕は君の最後の作品がとても気に入ったんだ。\n\nキャラクター(2a,b)はgoogle driveの服を着て、カトラリーを持って、よだれを垂らして、食べたそうに見えるようにしてほしいです。また、キャラクターはサンダルを履いている必要はありません。\n例(example.png)のように全身サイズにしたいです。\n\nキャラクターの背景の透過PSDデータをご提供いただけると幸いです。 ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1e1ZZzz4OeRrNK1QcBFlSShenMzvSLnaR?usp=sharing\n\nhttps://drive.google.com/drive/folders/1e1ZZzz4OeRrNK1QcBFlSShenMzvSLnaR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Quitterie/works/82", "thumbnail_src": "https://si.imgix.net/6c211da1/uploads/origins/ec1b1fc9-2d0f-4abf-86d8-42b3404a371c?bg=%23ff