14d-c23f68dd1898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5bddd31011960f3db7e6651badee92f 2x, https://si.imgix.net/a3b1b99a/uploads/origins/58a2dd21-a0a1-4db9-b14d-c23f68dd1898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fee712caf5842083efa87b03a067d0b 3x", "genre": "art", "nsfw": false, "body": "あなたのアートスタイルが本当に好きです\n\nバニーOCを依頼したい -Ruby\n元気で優しい、白いバニーガールです。\n髪に赤いストライプがあります。\n少し臆病で、パンケーキが大好き。\n錬金術師。\n背は高くないが、太ももがきれいな女性。\n長槍とポーションを駆使して戦います。\n\n長い槍を持った可愛らしい雰囲気にしたいです。\n背景や飾りに少しポーションを入れられたら完璧です。\n\nこのアイデアを気に入っていただけると幸いです。\nありがとうございます！\n\nメインレフ\nhttps://imgur.com/mSWXxXo\n\nその他参考\nhttps://imgur.com/a/gI5spem\n\nhttps://imgur.com/a/gI5spem", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/21", "thumbnail_src": "https://si.imgix.net/a3137920/uploads/origins/ee75fef5-fbc6-4bf9-8ae3-e98bb1ac5c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74d9a2dee1f5e9400c6375c3cf0e5b20", "thumbnail_srcset": "https://si.imgix.net/a3137920/uploads/origins/ee75fef5-fbc6-4bf9-8ae3-e98bb1ac5c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74d9a2dee1f5e9400c6375c3cf0e5b20, https://si.imgix.net/a3137920/uploads/origins/ee75fef5-fbc6-4bf9-8ae3-e98bb1ac5c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5061fe4cbe4863192a83f030be9d7ec1 2x, https://si.imgix.net/a3137920/uploads/origins/ee75fef5-fbc6-4bf9-8ae3-e98bb1ac5c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d971ecd5ddf32243d97a4797203641ba 3x", "genre": "art", "nsfw": false, "body": "メイド喫茶をテーマにした作品をお願いします!参考シートにあるような衣装は描かないでください。私のキャラのメイド服をデザインしてほしいですメイド服のイメージはこちらが参考になります。\nhttps://pin.it/3xk13IJ\nhttps://pin.it/4IWN21W\nhttps://pin.it/1tb7Czf\n\n私のキャラクターはこちらです。\nhttps://media.discordapp.net/attachments/988988045187514438/1062905971892047883/Untitled_Artwork.png\n\nもし、私のキャラクターについてもっと情報が必要なら、こちらを見てください。\nhttps://toyhou.se/14382002.minnie--", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/20", "thumbnail_src": "https://si.imgix.net/02c81b48/uploads/origins/28920905-bca2-4810-bf5f-65a443a4e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e97d3865f9f7735b770df3af2e8263b", "thumbnail_srcset": "https://si.imgix.net/02c81b48/uploads/origins/28920905-bca2-4810-bf5f-65a443a4e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e97d3865f9f7735b770df3af2e8263b, https://si.imgix.net/02c81b48/uploads/origins/28920905-bca2-4810-bf5f-65a443a4e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52a748c82af719d94483d2efad6f9130 2x, https://si.imgix.net/02c81b48/uploads/origins/28920905-bca2-4810-bf5f-65a443a4e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fe049afa16354688ff01c689b515050 3x", "genre": "art", "nsfw": false, "body": "こんにちは！明けましておめでとうございます！昨年はたくさんの素敵な作品を届けていただきありがとうございました！最初のリクエストで、猫のウェディングドレス姿を見たいと言ったので、この機会にぜひ！猫の名前は「みやび」です。\nお姫様のようなとても豪華なウェディングドレスのデザインをお願いします！髪型は必要であれば変更可能です。\nあとはあなた次第、今回も楽しく描いてくださいね。\nhttps://www.dropbox.com/sh/d8oby30jdpxure6/AACcab38dd7UYXmRUVu-1UqKa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/19", "thumbnail_src": "https://si.imgix.net/52dea743/uploads/origins/a66a0914-ba79-4960-a7a4-7ffcc43ade89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b5cd24a6f55a2d4d68d9c7835c3e70f", "thumbnail_srcset": "https://si.imgix.net/52dea743/uploads/origins/a66a0914-ba79-4960-a7a4-7ffcc43ade89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b5cd24a6f55a2d4d68d9c7835c3e70f, https://si.imgix.net/52dea743/uploads/origins/a66a0914-ba79-4960-a7a4-7ffcc43ade89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6a2ec43f53fab9dbee6c93cc5af8f60 2x, https://si.imgix.net/52dea743/uploads/origins/a66a0914-ba79-4960-a7a4-7ffcc43ade89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26aa43d0244f6d1e2483d0fde7165c99 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nたいたいくんさんが描いたうちの子「ユゥ」が見たいためコミッションを依頼したいです\n服装は資料のままで静を主眼にしたカッコいい感じにお願いします\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1-1Own42dhJrPPHhqhc6bWkJVAbaSVuYV?utm_source=en&pli=1&sort=13&direction=a", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/18", "thumbnail_src": "https://si.imgix.net/f380bee5/uploads/origins/105d350c-c88a-4494-bb15-cdbbc69a470d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ff98cf76c06293fb528df10d72c735f", "thumbnail_srcset": "https://si.imgix.net/f380bee5/uploads/origins/105d350c-c88a-4494-bb15-cdbbc69a470d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ff98cf76c06293fb528df10d72c735f, https://si.imgix.net/f380bee5/uploads/origins/105d350c-c88a-4494-bb15-cdbbc69a470d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bb7590746a052d65e05d4017feec702 2x, https://si.imgix.net/f380bee5/uploads/origins/105d350c-c88a-4494-bb15-cdbbc69a470d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74b44a211999beaec3e8493c7204f452 3x", "genre": "art", "nsfw": false, "body": "こんばんは、たいたいくんさんの描かれる獣人をいつも拝見させて頂いております。中でもたいたいくんさんの描かれるロリータ衣装のデザインや獣人の仕草や特徴を敷き詰めた可愛さを素晴らしく思っております。\n\n宜しければ私のソナであるウサギの擬獣化をロリータ衣装で描いて頂きたいです\n設定としては内気な性格で本を読んだり絵を描くことが趣味となっております\n\nポーズやシチュエーションは全てお任せしたいです。\nその他決めていないところは全てお任せします\n\nよろしければご検討の程よろしくお願いします\n\nキャラクター資料\nhttps://drive.google.com/drive/folders/1BndCn5akXrEBH5b_tWUEZKY60l7Lq0X3?usp=sharing\n\nコミッションを過去に依頼したイラストです\n参考までに良かったらどうぞ\nhttps://drive.google.com/drive/folders/1CxXj-ehXJvsuuUsY8qMtRuMGiV6XM9pg?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/17", "thumbnail_src": "https://si.imgix.net/289ec5b0/uploads/origins/fae6def1-c244-4c7e-9fd8-17df4d8b7601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8151039068cf26d68e3be5349186babb", "thumbnail_srcset": "https://si.imgix.net/289ec5b0/uploads/origins/fae6def1-c244-4c7e-9fd8-17df4d8b7601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8151039068cf26d68e3be5349186babb, https://si.imgix.net/289ec5b0/uploads/origins/fae6def1-c244-4c7e-9fd8-17df4d8b7601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e75315b0bbd7e0d17be8cf8e1665e0ed 2x, https://si.imgix.net/289ec5b0/uploads/origins/fae6def1-c244-4c7e-9fd8-17df4d8b7601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4ec3ac7bf220e00b6e66fb72af2e7b9 3x", "genre": "art", "nsfw": false, "body": "たいたいくんさんこんにちは！\nいつも素敵なイラストを楽しみにしております。\n\n私のキャラクターであるペニーのイラストをリクエストします！\n\n衣装は通常時で、「センパ〜イ！！」と飛びついてきそうな無邪気な元気な後輩キャラのイメージ描いてくださると助かる命があります。\n\nこの度はよろしくお願いいたします！！\n\n\nhttps://drive.google.com/drive/folders/1-0aBXNjB-7dfKszG_l2Ypk_x1bFpIso3", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/16", "thumbnail_src": "https://si.imgix.net/f0a4549e/uploads/origins/f201058c-117e-47ed-acca-3434646f8d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f80eb608fad8c8de311275048197a670", "thumbnail_srcset": "https://si.imgix.net/f0a4549e/uploads/origins/f201058c-117e-47ed-acca-3434646f8d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f80eb608fad8c8de311275048197a670, https://si.imgix.net/f0a4549e/uploads/origins/f201058c-117e-47ed-acca-3434646f8d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bee0b28a1938caa4636e3a66668cc34 2x, https://si.imgix.net/f0a4549e/uploads/origins/f201058c-117e-47ed-acca-3434646f8d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77a484205fb6ea111986eb5379173ef7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、くらんらん(CLαn)と申します。\n以前よりTwitterにてお見かけしましたけもふわな子の絵が気に入り、ご依頼をさせていただきました。\n\n-大まかな依頼内容\n・・創作キャラクターのケモノ化\n\n-構図\n・・手のひら及び肉球が見えるポーズ\n・・ポーズの人っぽさやケモっぽさはお任せにて、お願いします。\n\n-ケモノ部分について\n・・毛色はオレンジみのある黄色ベースで、内側の毛は白色でお願いします。\n・・口もとは猫型のお口で八重歯があると助かります。\n・・肌の出ている部分はフワっと毛がはみ出る感じでお願いします。\n\n-服装についての補足\n・・両手に付けている手袋は肉球を見せたいので外してください。\n\n-頭部について\n・・髪型は参考資料のイメージ図に記載したような丸みのあるショートヘアにてお願いします。\n▫︎▫︎耳について\n帽子を被っているキャラクターなので耳案として\n・・参考資料の通り帽子から黒い耳\n・・イメージ図資料のような帽子を突き破る耳\n・・オリジナルデザイン\n等どれかしらケモ耳を表現できるものにて、お願いします。\n\n-その他資料についての補足\n・・赤い小さな尻尾があることが記載されていますが、ふわふわの猫尻尾への変更や尻尾を表現しない等はお任せします。\n・・武器は不在でも大丈夫です。\n・・黒い猫も不在でも大丈夫です。\n\n・参考資料\n\nhttps://twitter.com/kakunin_ngs/status/1585395107775541249?s=21&t=LZ_dGfSa9IZr498ACWY3-w　\nTwitterID @ kakunin_ngs の固定ツイートにて載せさせていただいております。\n\n・使用用途\n　頂いたイラストはTwitterやその他のSNSのアイコン、スマートフォンやPCのデスクトップに掲載及び使用したいと考えております。\n\n以上です。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/15", "thumbnail_src": "https://si.imgix.net/b9e6ca53/uploads/origins/47901b71-b00d-4dcc-8dbf-890c71ee9cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91155c9bca86f99a97490afc95ceb90b", "thumbnail_srcset": "https://si.imgix.net/b9e6ca53/uploads/origins/47901b71-b00d-4dcc-8dbf-890c71ee9cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91155c9bca86f99a97490afc95ceb90b, https://si.imgix.net/b9e6ca53/uploads/origins/47901b71-b00d-4dcc-8dbf-890c71ee9cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c1b00b640b1c6a8e6f79fd5bd81b1fc 2x, https://si.imgix.net/b9e6ca53/uploads/origins/47901b71-b00d-4dcc-8dbf-890c71ee9cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ec99cde03955c6206c6f7cb8222cad7 3x", "genre": "art", "nsfw": false, "body": "ルートゥアちゃんのロリータ服のイラストをお願いします！ 服のデザイン・背景はお任せでお願いします！\n\nhttps://twitter.com/ppprant1121/status/1585244036147056643?s=21&t=z2R6eioGWt-KchqAUpTbBg", "created_at": "", "completed_at": ""}, {"path": "/@tai_tai_kun/works/14", "thumbnail_src": "https://si.imgix.net/bc5d248a/uploads/origins/2a8701b4-5ef2-4d66-8c20-3465a3969483?bg=%23fff&auto=forma