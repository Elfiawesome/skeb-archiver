{"screen_name": "NatsukageMinami", "file": "NatsukageMinami-685d75", "name": "みなみ🌸", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fed3905ea-6afe-4ea1-ade6-61a61ee57fe6.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-87cdf2d5-3155-4a45-a276-348077882484.png", "description": "色鉛筆で絵を描いています。優しい絵を描くことが好きです🌸\nファンアートや二次創作、オリジナル、動物イラストを描いてます　\n可愛いものや、心温まる物語、絵が好き✨\n夢は、個展を開くこと🌟\n\n温かなリアクションいつもありがとうございます💕💕\nフォローもお気軽にくださると喜びます:blobcataww:\nいつも励みになります:thank_you__i:\n\n成人済み｜グリムノーツ｜Fate/Samura…", "total_works": 7, "scraped_works": 7, "first_seen": "2026-03-20T09:26:51.326473+00:00", "last_updated": "2026-03-20T09:26:51.326473+00:00", "price_history": {"art": [{"amount": 8000, "recorded_at": "2026-03-20T09:26:51.326473+00:00"}]}, "current_prices": {"art": 8000}, "price_range": {"art": {"min": 8000, "max": 8000}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@minami_notes", "name": "minami_notes"}, {"label": "Website", "url": "https://xfolio.jp/portfolio/minami_notes1223", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/1618077", "name": "1618077"}, {"label": "BOOTH", "url": "https://minaminortes.booth.pm", "name": "minaminortes"}], "flags": {}, "acceptable": true, "works": [{"path": "/@NatsukageMinami/works/7", "thumbnail_src": "https://si.imgix.net/da8e626b/uploads/origins/ac90eb03-509e-4d96-a1ac-3fe338f7df5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=561e8d7e1e33f6a32ec153942559564b", "thumbnail_srcset": "https://si.imgix.net/da8e626b/uploads/origins/ac90eb03-509e-4d96-a1ac-3fe338f7df5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=561e8d7e1e33f6a32ec153942559564b, https://si.imgix.net/da8e626b/uploads/origins/ac90eb03-509e-4d96-a1ac-3fe338f7df5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9809d826d5f6e60103e6434876f0565d 2x, https://si.imgix.net/da8e626b