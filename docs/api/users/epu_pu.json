Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c1cadabc2f1e9e1b9ab0ea438dbbd67 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/16", "thumbnail_src": "https://si.imgix.net/4b0e5332/uploads/origins/6a9d4da5-4838-4e57-82a3-f59b959f85b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53365e1bd05769f7f53e52849f158e36", "thumbnail_srcset": "https://si.imgix.net/4b0e5332/uploads/origins/6a9d4da5-4838-4e57-82a3-f59b959f85b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53365e1bd05769f7f53e52849f158e36, https://si.imgix.net/4b0e5332/uploads/origins/6a9d4da5-4838-4e57-82a3-f59b959f85b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ca9c8745dd48f5f54da30248fdd407c 2x, https://si.imgix.net/4b0e5332/uploads/origins/6a9d4da5-4838-4e57-82a3-f59b959f85b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a753852f259bce44f75542c4734c4ab6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/15", "thumbnail_src": "https://si.imgix.net/13fb29dc/uploads/origins/e8fa4e92-7ccf-4afe-ab04-b4f02caaff92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49d0d0d621723d4b7cd74796aa219dda", "thumbnail_srcset": "https://si.imgix.net/13fb29dc/uploads/origins/e8fa4e92-7ccf-4afe-ab04-b4f02caaff92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49d0d0d621723d4b7cd74796aa219dda, https://si.imgix.net/13fb29dc/uploads/origins/e8fa4e92-7ccf-4afe-ab04-b4f02caaff92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e39bac90aebdc98ae242bdcaa238de40 2x, https://si.imgix.net/13fb29dc/uploads/origins/e8fa4e92-7ccf-4afe-ab04-b4f02caaff92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccad13977a3ac51924b24e28321bfa9c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのかわいいイラストが大好きです。\n\n私のキャラクターは、かわいくて、眠くて、いたずら好きで、ちょっとおバカなボイドキャットのマーフィーです。\n好きなポーズを選んでください。\n\n彼女のオレンジ色の目は、薄い黄色ではなく、「モデル」のリファレンスにあるような金色/オレンジ色で描いてください。\n白い目玉を描いてください。\n\nまだ彼女の絵があまりなくてごめんなさい！\n\nhttps://drive.google.com/drive/folders/1w2m9YiXXCrNtckwlWsPLbhUBcSZsj17T?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/14", "thumbnail_src": "https://si.imgix.net/2f0a6321/uploads/origins/6a891c2a-a13a-483b-9306-1daec84f3333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a584197201b55b0ae4009d0b300a3542", "thumbnail_srcset": "https://si.imgix.net/2f0a6321/uploads/origins/6a891c2a-a13a-483b-9306-1daec84f3333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a584197201b55b0ae4009d0b300a3542, https://si.imgix.net/2f0a6321/uploads/origins/6a891c2a-a13a-483b-9306-1daec84f3333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=704b42d1bd12e29f4581d54485e465cb 2x, https://si.imgix.net/2f0a6321/uploads/origins/6a891c2a-a13a-483b-9306-1daec84f3333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d6bc35272bc60fac43cc351fbaf111a 3x", "genre": "art", "nsfw": false, "body": "えぷ様\nはじめまして、みつなつと申します。\nskebで可愛らしい女の子のイラストが目にとまり、私のVtuberの姿も描いていただきたくてリクエストをいたします！\n\n私は読書系の個人VtuberとしてYouTubeで活動しています。\n穏やかで落ち着いたほのぼのタイプのキャラクターです。\n\nhttps://drive.google.com/file/d/1wgcqces_NiR-_OOK-6ofSwLbQdJzXYSa/view?usp=drive_link\n\n【服装・ポーズ・表情など】\n・服装は新しい衣装でも、既存デザインのアレンジも大丈夫です。\n・髪型はツインテール・お団子のどちらでも、おまかせします。\n・マスコットのオバケもつけていただけるととっても嬉しいです。\n・ポーズや表情はおまかせします！\n\n【使用用途】\n・YouTubeのサムネや動画、アイコンなど活動用\n・ブルースカイやクロスフォリオなどSNSのアイコン・週間スケジュールや告知画像などでの使用\nクロスフォリオ→https://xfolio.jp/portfolio/mitsunatsu\n\n【構図・背景など】\n・構図や背景はおまかせしますが、サムネイルなどに使用させていただきたいので髪が切れていないとありがたいです。\n・背景透過の人物のみのデータもいただけると嬉しいです。\n\nご検討いただければ幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/13", "thumbnail_src": "https://si.imgix.net/8a91258c/uploads/origins/91577070-39ed-4ced-8e6d-5c258261c6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d27bdc330b94ef5e29f99e5507b821", "thumbnail_srcset": "https://si.imgix.net/8a91258c/uploads/origins/91577070-39ed-4ced-8e6d-5c258261c6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d27bdc330b94ef5e29f99e5507b821, https://si.imgix.net/8a91258c/uploads/origins/91577070-39ed-4ced-8e6d-5c258261c6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b5fbcc2363b58caad0eb91f1cec2db9 2x, https://si.imgix.net/8a91258c/uploads/origins/91577070-39ed-4ced-8e6d-5c258261c6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7010a3c0bdaa3fdbf220cbd737e40aea 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの作品はとてもキュートで大好きです！ハンバーガーといろいろな種類のフライドポテトをモチーフにしたこの服で、私のオリジナルキャラクターを描いていただけませんか？\nhttps://drive.google.com/file/d/1czfPoQLE-ALkO2BW_TvS1YM1fc2WkPOZ/view?usp=drivesdk\n参考になるラベルがあれば幸いです。\n設定やポーズはお任せします。\nもしアイデアが必要なら、彼女は少し不器用なところがあるので注意してください。\nリクエストにお答えいただきありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/12", "thumbnail_src": "https://si.imgix.net/3bb22c6e/uploads/origins/2c9fc7b5-205f-49bf-95d0-ee6bbe1da56d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4cfa1cecf404e97cf47f6366faad2ee", "thumbnail_srcset": "https://si.imgix.net/3bb22c6e/uploads/origins/2c9fc7b5-205f-49bf-95d0-ee6bbe1da56d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4cfa1cecf404e97cf47f6366faad2ee, https://si.imgix.net/3bb22c6e/uploads/origins/2c9fc7b5-205f-49bf-95d0-ee6bbe1da56d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9e55b390dd2c0c266fb64c3c365b4e4 2x, https://si.imgix.net/3bb22c6e/uploads/origins/2c9fc7b5-205f-49bf-95d0-ee6bbe1da56d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0663fab4da030834b0a45abaa531c509 3x", "genre": "art", "nsfw": false, "body": "えぷ様 初めまして。 香港で活動準備中のAkihaと申します。えぷ様の素敵なイラストを拝見させていただき、イラストをご依頼したいと思います。 \n 【使用用途】\n ※商用利用の予定がございます。  ・SNSサムネイル、ヘッダー、宣伝ツイート ・配信サムネイル  \n【依頼内容 】\n  【Akiha】 \n銀髪の短い髪（ウルフカット） ウルフの獣の耳(ちょっと水色で入っています） \n 【構図】 \nいくつかのポーズと表情でお願いします。1つは狼のぬいぐるみを抱っこしてこちらを見る  【衣装】  \n水色のキャミソールのパジャマ､下半身は短く、両足が露出しています。\n  【表情】\n 右目の下でほくろがいます。口の側に八重歯。また価格内で口の表情差分が可能でしたらいただきたいです､表情はお任せします。\n\n  また可能でしたらデータはpsdで、キャラと背景のレイヤーを分けていただけると嬉しいです。\n\n  ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-6Hf52qgGoYPvN5lzamH9GjlJXc4PDZ-", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/11", "thumbnail_src": "https://si.imgix.net/2a37d252/uploads/origins/1bd67f59-e473-4d74-847a-97a1668d4185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3744264e0820ba7cb86e1597dc395d5f", "thumbnail_srcset": "https://si.imgix.net/2a37d252/uploads/origins/1bd67f59-e473-4d74-847a-97a1668d4185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3744264e0820ba7cb86e1597dc395d5f, https://si.imgix.net/2a37d252/uploads/origins/1bd67f59-e473-4d74-847a-97a1668d4185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=001619c41c7c39e3f47d885ba3384cd3 2x, https://si.imgix.net/2a37d252/uploads/origins/1bd67f59-e473-4d74-847a-97a1668d4185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a22d1134afd554ec7afa532672336374 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのかわいいイラストの一つに興味があります！私のキャラクターは天使の子犬の看護師で、彼女の名前はWhimsyです！彼女は少しおっちょこちょいで、彼女の仕事は最高ではありませんが、彼女のかわいさのレベルは致命的です！彼女はエナメルピン、包帯（全体的に大量のアクセサリー）、ぬいぐるみを収集するのが大好きです！私はあなたのマルチポーズのイラストの一つに興味があります！多分、彼女のハート形のアホゲを表示するために彼女のキャップを外したものがあります！私は何が適しているかについては、表現にお任せします！(≧◡≦) ♡\n\nhttps://drive.google.com/file/d/157LGptmPUSMCditK87-rslpO5LygjOtQ/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/10", "thumbnail_src": "https://si.imgix.net/a44c469a/uploads/origins/422c1bda-89e9-46a9-a801-eef7df98d3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ab1835b144079ede9bc6213e8826b3e", "thumbnail_srcset": "https://si.imgix.net/a44c469a/uploads/origins/422c1bda-89e9-46a9-a801-eef7df98d3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ab1835b144079ede9bc6213e8826b3e, https://si.imgix.net/a44c469a/uploads/origins/422c1bda-89e9-46a9-a801-eef7df98d3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=885debbea83a11381f5fa993d3907640 2x, https://si.imgix.net/a44c469a/uploads/origins/422c1bda-89e9-46a9-a801-eef7df98d3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=584e4695c1612db8caf685360607575c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルはとても愛らしいので、複数のポーズをとるスタイルの作品をお願いしたいです！\n\nサギキはお菓子やデザート通で、甘いものが大好きです！左目の下に小さなピンクのハートがあります。性格は甘えん坊で人懐っこく、茶色のタビーとジンジャーの猫を飼っています。彼女は歌うことも大好きで、お菓子やケーキがたくさんあるお菓子屋さん/スイーツカフェで働いています。\n\n他のディテールやポーズ、設定や表情など、あなたのスタイルに合わせて自由に創造してください！ありがとうございました！\n\nhttps://drive.google.com/file/d/150F4zkV8b7jRoQGRMzCQrHvymOslVWjn/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@epu_pu/works/9", "thumbnail_src": "https://si.imgix.net/90d67362/uploads/origins/68b3077c-d40b-48b6-a747-c73bd33aceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f8b0d2683d9f9858ef5f8efd30064a0", "thumbnail_srcset": "https://si.imgix.net/90d67362/uploads/origins/68b3077c-d40b-48b6-a747-c73bd33aceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f8b0d2683d9f9858ef5f8efd30064a0, https://si.imgix.ne