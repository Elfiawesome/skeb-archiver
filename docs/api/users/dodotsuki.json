https://x.com/dodotsuki", "name": "dodotsuki"}, {"label": "Misskey_io", "url": "https://misskey.io/@dodotsuki", "name": "dodotsuki"}, {"label": "Website", "url": "https://dodotsuki.booth.pm", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/28139165", "name": "28139165"}, {"label": "Fanbox", "url": "https://dodotsuki.fanbox.cc", "name": "dodotsuki"}], "flags": {}, "works": [{"path": "/@dodotsuki/works/65", "thumbnail_src": "https://si.imgix.net/0a54ba40/uploads/origins/c1dfc005-1763-4aaf-ad62-05683f91b947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74100c96475196bf6e5422a7e20a8b6e", "thumbnail_srcset": "https://si.imgix.net/0a54ba40/uploads/origins/c1dfc005-1763-4aaf-ad62-05683f91b947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74100c96475196bf6e5422a7e20a8b6e, https://si.imgix.net/0a54ba40/uploads/origins/c1dfc005-1763-4aaf-ad62-05683f91b947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec089fa1301067cea5633cd7e7ebc10d 2x, https://si.imgix.net/0a54ba40/uploads/origins/c1dfc005-1763-4aaf-ad62-05683f91b947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=435637dff17fcb3cb234a0e132f81599 3x", "genre": "art", "nsfw": true, "body": "いちげき！306話のようなバランスボールの上で楽しそうに片足バランスしている\nオンゲキの日向千夏ちゃんを以下のような形でお願いしたいです！\n\n衣装：ほぼ紐みたいなV字のスリングショット水着\n\n少しローアングル気味で水着が食い込んだ股間が見える\n\nもし可能であればお尻側のアングルもお願いしたいです\nご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@dodotsuki/works/64", "thumbnail_src": "https://si.imgix.net/56aaf6d1/uploads/origins/0a3c8f19-4f93-4105-b071-752d5c240c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20c3305568729c050418a9c6cf984c82", "thumbnail_srcset": "https://si.imgix.net/56aaf6d1/uploads/origins/0a3c8f19-4f93-4105-b071-752d5c240c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20c3305568729c050418a9c6cf984c82, https://si.imgix.net/56aaf6d1/uploads/origins/0a3c8f19-4f93-4105-b071-752d5c240c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1719e255db1c6455930746c7c7e0bea1 2x, https://si.imgix.net/56aaf6d1/uploads/origins/0a3c8f19-4f93-4105-b071-752d5c240c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bac19f691be74e87ed85d0aa908bdd35 3x", "genre": "art", "nsfw": false, "body": "前回の納品、ありがとうございました！ 私服のまま潜ったASTERISM、大変可愛かったです。\nまたどどつきさんの絵柄で見たいシチュができたので、3度目のリクエスト失礼します。\n\n概要：\nオンゲキの星咲あかりさんと日向千夏さんが水中で息を止めているイラストを描いてほしい。\n\n服装\nあかり：https://amnibus.com/products/detail/37928\n千夏：https://amnibus.com/products/detail/37941\n\n詳細：\n・二人とも口を膨らませ、とても苦しそうな表情をしながら水中で息を止めている（この時、漫画でよくある汗みたいなのを描かないでくれると嬉しいです）\n・場所はプールの中（水面が近い描写があると嬉しいです）\n・どちらの口からも大小の泡が出ている\n・二人とも手を繋ぎ、お互いの顔を見ている\n・全身（文字通り頭の頂点から足の先っぽまで）が映っていてほしい（構図やポーズはお任せします）\n\n季節外れかつ（恐らく千夏推しなはずの）どどつきさんにとっては不快に感じかねないリクエストで申し訳ありませんが、ご一考くださると幸いです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@dodotsuki/works/63", "thumbnail_src": "https://si.imgix.net/8384d059/uploads/origins/090ba360-2824-4700-b03c-00bbd12d696d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ef719625ee6bdf203d3862a60893d4", "thumbnail_srcset": "https://si.imgix.net/8384d059/uploads/origins/090ba360-2824-4700-b03c-00bbd12d696d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ef719625ee6bdf203d3862a60893d4, https://si.imgix.net/8384d059/uploads/origins/090ba360-2824-4700-b03c-00bbd12d696d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6aadc21dadcdf6ce879b804a4e32ae51 2x, https://si.imgix.net/8384d059/uploads/origins/090ba360-2824-4700-b03c-00bbd12d696d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbb0b358df2643d66bcc555118581c4e 3x", "genre": "art", "nsfw": false, "body": "どどつき様 \n\n以前は素敵なイラストを描いていただきありがとうございました。またイラスト依頼をさせていただきます。\n\n前回同様、SEGAの音楽ゲーム「オンゲキ」の藤沢柚子ちゃんのイラストをお願いいたします。 \n今回はSDVXに移植されたSOLAR ECLIPSEのMXM譜面のジャケットのそーらーえくりぷす子ちゃんの衣装・構図でお描きいただきたいです！", "created_at": "", "completed_at": ""}, {"path": "/@dodotsuki/works/62", "thumbnail_src": "https://si.imgix.net/9869f33e/uploads/origins/9dbd2c6e-146e-461f-8c0f-2d7af37c1475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a38aa66a63c1d56d3c39569c7045d5d", "thumbnail_srcset": "https://si.imgix.net/9869f33e/uploads/origins/9dbd2c6e-146e-461f-8c0f-2d7af37c1475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a38aa66a63c1d56d3c39569c7045d5d, https://si.imgix.net/9869f33e/uploads/origins/9dbd2c6e-146e-461f-8c0f-2d7af37c1475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97d98bd74b4de68c7d7ea91877b2685d 2x, https://si.imgix.net/9869f33e/uploads/origins/9dbd2c6e-146e-461f-8c0f-2d7af37c1475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2c3d723865b46ffb6480b634ab6cfb8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dodotsuki/works/61", "thumbnail_src": "https://si.imgix.net/59a455a1/uploads/origins/4ffadeaa-fc02-4a38-aa9e-12d729a62fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f7188a9511dc61689a56049dc144c5d", "thumbnail_srcset": "https://si.imgix.net/59a455a1/uploads/origins/4ffadeaa-fc02-4a38-aa9e-12d729a62fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f7188a9511dc61689a56049dc144c5d, https://si.imgix.net/59a455a1/uploads/origins/4ffadeaa-fc02-4a38-aa9e-12d729a62fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d771