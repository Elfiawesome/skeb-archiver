ix.net/a695484f/uploads/origins/655b8f91-3aa4-4abb-882e-c392d581fe02?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1cce72104cd0e9ee50ed38a07b00348e", "thumbnail_srcset": "https://si.imgix.net/a695484f/uploads/origins/655b8f91-3aa4-4abb-882e-c392d581fe02?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1cce72104cd0e9ee50ed38a07b00348e, https://si.imgix.net/a695484f/uploads/origins/655b8f91-3aa4-4abb-882e-c392d581fe02?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec26c3ce3ed0ecf3abaddfe73c400c9d 2x, https://si.imgix.net/a695484f/uploads/origins/655b8f91-3aa4-4abb-882e-c392d581fe02?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=23f81a6e3d8a0fd5ffcd4ab3d3d41a02 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクター、モノ・クロームを考えてくれませんか？\n彼は自分の色を探しているモノクロの少年です。\n\n背景、ポーズ、表情はお好みで。よろしくお願いします！\n\nhttps://toyhou.se/3439102.monochrome (バイオグラフィー＆アーツ)\n\nhttps://photos.app.goo.gl/KTMVSAruobxnUnaV6", "created_at": "", "completed_at": ""}, {"path": "/@nonnono_12/works/15", "thumbnail_src": "https://si.imgix.net/18f12fd7/uploads/origins/97c76188-603e-492a-93ea-6c7a39afd157?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1a834cd78b12641874e7e5cf70dc06fb", "thumbnail_srcset": "https://si.imgix.net/18f12fd7/uploads/origins/97c76188-603e-492a-93ea-6c7a39afd157?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1a834cd78b12641874e7e5cf70dc06fb, https://si.imgix.net/18f12fd7/uploads/origins/97c76188-603e-492a-93ea-6c7a39afd157?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc5aec048fc32b5f6e869bf2bd455613 2x, https://si.imgix.net/18f12fd7/uploads/origins/97c76188-603e-492a-93ea-6c7a39afd157?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=07be788d938ce799eed815fbaac5b2ad 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールをありがとうございます！\nあなたのアニメーションアイコンが大好きです！私のFF14のキャラクターを描いていただきたいです！\n18禁と書いてありますが、ヌードではなく水着のみです！笑っているところを見たいのですが、サング