4dca-aa43-59fcc572efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a171c8dd3fb84f22ec84c6942892e3ff", "thumbnail_srcset": "https://si.imgix.net/e8cd6eb0/uploads/origins/35983f74-2f75-4dca-aa43-59fcc572efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a171c8dd3fb84f22ec84c6942892e3ff, https://si.imgix.net/e8cd6eb0/uploads/origins/35983f74-2f75-4dca-aa43-59fcc572efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0d88b4d9e0d68ded606c62a8439c5b1 2x, https://si.imgix.net/e8cd6eb0/uploads/origins/35983f74-2f75-4dca-aa43-59fcc572efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=640aa6476f8fcad80b46adf946004079 3x", "genre": "art", "nsfw": true, "body": "先日……唐突に、\n\n(ひじゆめのバニーガールが見たい)\n\n…と思った時のことです。\n\nTwitterをはじめpixivなんかを検索しても、無い。ひじゆめのバニーガールイラストが無い！\n\n…という事態に陥りました。\n\n\nこれは、実に由々しき事態であると思い立ち、此度、また是非がもさんに現状意外と数少ないひじゆめバニーガールの世界を切り開いて頂きたく思い依頼させて頂きたく思います…！\n\n\n是非、切り開かれる世界の窓口は大きくあるべきと思いますので、通常のバニーガール衣装だけでなく、\n\nいわゆる「逆バニー」のひじゆめ\n\nそれから、バニーのカチューシャのみひじゆめと\n\n差分あわせて3枚お願い出来たらと思います…。", "created_at": "", "completed_at": ""}, {"path": "/@gamo_mk/works/80", "thumbnail_src": "https://si.imgix.net/9a239ed2/uploads/origins/eca58666-943e-4888-97ae-7ee491a3c0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a64f6cf2a4d32da7976822b711747ce", "thumbnail_srcset": "https://si.imgix.net/9a239ed2/uploads/origins/eca58666-943e-4888-97ae-7ee491a3c0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a64f6cf2a4d32da7976822b711747ce, https://si.imgix.net/9a239ed2/uploads/origins/eca58666-943e-4888-97ae-7ee491a3c0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ee215b0dd684db67f746653f43bd9cf 2x, https://si.imgix.net/9a239ed2/uploads/origins/eca58666-943e-4888-97ae-7ee491a3c0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bceda38cc9c34d94e27e063fe1090297 3x", "g