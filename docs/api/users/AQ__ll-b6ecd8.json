200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5bd2d550010b7754f0b049b3ce6a64e 2x, https://si.imgix.net/26019b20/uploads/origins/7c6207c4-13ef-4268-84f7-1d9ee258d78b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2eaa965be8081395aebf4496a755a38 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/27", "thumbnail_src": "https://si.imgix.net/3db9f541/uploads/origins/396c4930-e9f8-43b9-ac3a-a708b8d31ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d34a2e7b817ce44962cc58c88f8dc9", "thumbnail_srcset": "https://si.imgix.net/3db9f541/uploads/origins/396c4930-e9f8-43b9-ac3a-a708b8d31ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d34a2e7b817ce44962cc58c88f8dc9, https://si.imgix.net/3db9f541/uploads/origins/396c4930-e9f8-43b9-ac3a-a708b8d31ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=740bad168f84f4990c2625f5ed3c4d2e 2x, https://si.imgix.net/3db9f541/uploads/origins/396c4930-e9f8-43b9-ac3a-a708b8d31ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055f62db7d793531ae84b0ccefb2322d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n個人Vtuberの廿楽あまねと申します。\n\n雰囲気があってとても魅力的なイラストを描かれる鱈雲さんに、僭越ですが是非私自身を描いていただきたいと思いリクエスト送らせていただきました！\n\n鱈雲さんの世界観が大好きなので、構図や雰囲気等はお任せいたします。\nデザインや色味等も描きやすいようアレンジしていただいて大丈夫ですので、お好きなように描いてもらえたら嬉しいです！\n\n※イラストはYouTubeやtwitter等といったSNSのアイコンやヘッダーに使用させていただきたいと考えております。（もちろんクレジット表記させていただきます。）\n可能でしたら、イラストと宛名のレイヤーは分けてもらえますと有難いです。\n\nよろしければ引き受けていただけるととても嬉しいです！\n何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1s5C4MqpyHChsigs-4WmogwBWlt6dbjVm?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/26", "thumbnail_src": "https://si.imgix.net/ecf231fd/uploads/origins/1489ed6b-9894-4c21-b841-9261bf4f1b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10190cbcd5f859d91f338b437eeff61c", "thumbnail_srcset": "https://si.imgix.net/ecf231fd/uploads/origins/1489ed6b-9894-4c21-b841-9261bf4f1b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10190cbcd5f859d91f338b437eeff61c, https://si.imgix.net/ecf231fd/uploads/origins/1489ed6b-9894-4c21-b841-9261bf4f1b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36e1a9337fdacbe1641297a2f8eb33aa 2x, https://si.imgix.net/ecf231fd/uploads/origins/1489ed6b-9894-4c21-b841-9261bf4f1b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3559a206a9e599dbe3c5a7781ff28b1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも素敵な作品をありがとうございます。\n鱈雲さんの描かれるイラスト大好きです。\n\nよろしければ以前描かれていたオリジナルキャラクターの\nスピロspiroとプルモネムpulmonemの二人のイラストがまた見たいです。\n１人１人別ではなく１枚のイラストに２人がいる構図で見たいです。\nシチュエーションや服装など鱈雲さんの好きなように描いてくださると嬉しいです。\n\nサインですが、フォントでも大丈夫なのですが、よろしければ直筆だと嬉しいです。\n金額等問題ありませんでしたらよろしくお願いします。！", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/25", "thumbnail_src": "https://si.imgix.net/2c18e8a0/uploads/origins/41b41211-f7c7-4bd6-8389-1771ebd8c889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51d9327ee4794fadfd75f2f06075d3a", "thumbnail_srcset": "https://si.imgix.net/2c18e8a0/uploads/origins/41b41211-f7c7-4bd6-8389-1771ebd8c889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51d9327ee4794fadfd75f2f06075d3a, https://si.imgix.net/2c18e8a0/uploads/origins/41b41211-f7c7-4bd6-8389-1771ebd8c889?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09a917929f9bdf82b12a6e71f78250ba 2x, https://si.imgix.net/2c18e8a0/uploads/origins/41b41211-f7c7-4bd6-8389-1771ebd8c889?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acc1cbe65a96fc008219e4ba398d87a7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お元気ですか？\n\n私のVtuberキャラクターであるHeibiのアートをあなたのスタイルでリクエストしたいと思います。Heibiは台湾や中国の蛇の精霊で、性別はありません。1000年前に人間の姿になった後、Heibiは世界を旅して今まで見たことのない景色を見ることにしました。人間に魅了されているが、過去の経験から人間との交流には慎重になっている。現代のHeibiは落ち着いていますが、インターネットのバーチャルな世界を探求しています。\n\nあなたのスタイルでHeibiを想像してもらえたら嬉しいです。衣装もポーズも自由に変えてください。ただひとつお願いしたいのは、平兵衛の性別を曖昧にしておいてほしいということです。知識を貪る蛇である平兵衛をどのように解釈するか、楽しみにしています。\n\nhttps://drive.google.com/drive/folders/1-6XHG3s0xWLIty0IT7ChlIa35sDJO_Iv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/24", "thumbnail_src": "https://si.imgix.net/994d32e2/uploads/origins/c30c267e-812d-46eb-984d-53955f71075b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918322f54d78fd42cacbbe937cc71335", "thumbnail_srcset": "https://si.imgix.net/994d32e2/uploads/origins/c30c267e-812d-46eb-984d-53955f71075b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918322f54d78fd42cacbbe937cc71335, https://si.imgix.net/994d32e2/uploads/origins/c30c267e-812d-46eb-984d-53955f71075b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ce4942868f60ab284cc81ad35f379b7 2x, https://si.imgix.net/994d32e2/uploads/origins/c30c267e-812d-46eb-984d-53955f71075b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb7582694b880fe06ffcfa801b899896 3x", "genre": "art", "nsfw": false, "body": "hello, I love your artwork. I would like to request this character: https://imgur.com/a/yFnBcSX\n\nポーズや構図はお任せしますので、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/23", "thumbnail_src": "https://si.imgix.net/b7a4ed48/uploads/origins/8d17fef3-ab27-459a-afe0-88b3f2813399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2296623762ac3ea937e806edcf83d84", "thumbnail_srcset": "https://si.imgix.net/b7a4ed48/uploads/origins/8d17fef3-ab27-459a-afe0-88b3f2813399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2296623762ac3ea937e806edcf83d84, https://si.imgix.net/b7a4ed48/uploads/origins/8d17fef3-ab27-459a-afe0-88b3f2813399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bc339487fcdeda167879035891e802a 2x, https://si.imgix.net/b7a4ed48/uploads/origins/8d17fef3-ab27-459a-afe0-88b3f2813399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f789e5e01e760947bc44baa7dc5a0dd0 3x", "genre": "art", "nsfw": false, "body": "少し切ない女の子を描いてほしいです。\n\n白めのトップス(袖透けのもの)とスカート、髪色は明るめの茶褐色、目の色はお任せしたいです。頭には白いカスミソウの花冠を乗せてください。\n花冠なんですが輪っかとしては千切れていると嬉しいです。花言葉が幸福とかなので輪＝円(永遠のシンボル)が断ち切られているということで「幸福は永遠に続かない」という趣旨なのですが。\n女の子の手には水色の勿忘草を持たせてください。\n\n依頼、受けていただけると嬉しいです。\n宛名無しと宛名付きの差分もできれば……。", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/22", "thumbnail_src": "https://si.imgix.net/9023a5dc/uploads/origins/52bf651b-d871-4819-abe3-e9e49542a6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523ffe05afbcc523873d4494d2139a60", "thumbnail_srcset": "https://si.imgix.net/9023a5dc/uploads/origins/52bf651b-d871-4819-abe3-e9e49542a6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523ffe05afbcc523873d4494d2139a60, https://si.imgix.net/9023a5dc/uploads/origins/52bf651b-d871-4819-abe3-e9e49542a6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20a3bc45011887c361714f5d93f8602e 2x, https://si.imgix.net/9023a5dc/uploads/origins/52bf651b-d871-4819-abe3-e9e49542a6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46c50918e8b6eef094876f25476f23b8 3x", "genre": "art", "nsfw": false, "body": "Hello, please draw my OC in any clothes you want, some clothes type I like is:\n-ストリートウェア\n-サマードレス\n-チーパオ(チャイナドレス)\n-水着\n\n以下は、私のOCの参考資料です。アルバム内には成人向けの作品がありますのでご注意ください。\n\nhttps://m.imgur.com/a/R5BnekH", "created_at": "", "completed_at": ""}, {"path": "/@AQ__ll/works/21", "thumbnail_src": "https://si.imgix.net/e6a8496e/uploads/origins/a3625feb-18a7-44d0-8e79-4652bf6d31ce?bg=%23fff&auto=format%2Ccompress&fm=web