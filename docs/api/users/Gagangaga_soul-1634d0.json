si.imgix.net/44fb2193/uploads/origins/13be6689-e0fd-4d68-9322-2f02d31b2158?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdfb9ef0429b087b42ae434673107e8f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gagangaga_soul/works/50", "thumbnail_src": "https://si.imgix.net/316c5f51/uploads/origins/1e314cea-20d5-4a1b-bcf3-242d6578a552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5b41041a052c7f2b28e1821f58ee4e", "thumbnail_srcset": "https://si.imgix.net/316c5f51/uploads/origins/1e314cea-20d5-4a1b-bcf3-242d6578a552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5b41041a052c7f2b28e1821f58ee4e, https://si.imgix.net/316c5f51/uploads/origins/1e314cea-20d5-4a1b-bcf3-242d6578a552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fd5fe908c06f3ca66f3fb03b62bc9ef 2x, https://si.imgix.net/316c5f51/uploads/origins/1e314cea-20d5-4a1b-bcf3-242d6578a552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e033774663fde7522bb6dd9f88fcb833 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先日以下の大鳳パイズリ依頼させてもらったものです\nhttps://skeb.jp/@Gagangaga_soul/works/45\n\nブーストでも描きましたが、とても癖に刺さるイラストとシチュだったので\n前回の続きの絵をリクエストさせてもらいたいです。\n\n～\n\n前回の会話通りの続きで、お風呂にておっぱいで身体洗ってもらっている絵をリクエストさせてください\n\n\nおっぱいで胸板とかを洗いながら、キスしてるみたいな絵だと嬉しいです。\n（パイズリキスの、パイズリじゃない版的な)\n\nお任せするので、前回同様台詞が入ってると嬉しいです。\n（再度指揮官とパイズリエッチするために、キス・おっぱい・言葉で指揮官を誘惑して勃起させてくる感じの）\n\n最終的に誘惑されて再度フル勃起してしまった指揮官が\n「た、大鳳♡またパイズリさせて♡…乳内射精させてぇ♡」と情けなくおねだりしてしまい\n「ふふっ♡承知しました♡では続きはベッドで…」\n\nみたいな感じをお願いしたいです\n（もし可能であれば、またこの続きでベッドで膝上パイズリというのをリクエストさせてもらいたいと思っていますので、そちらにつながるような終わり方にしていただけるとです）", "created_at": "", "completed_at": ""}, {"path": "/@Gagangaga_soul/works/49", "thumbnail_src": "https://si.imgix.net/82c377db/uploads/origins/e945ec38-0f38-430d-b501-6cf547c2cb88?bg=%23fff&auto=form