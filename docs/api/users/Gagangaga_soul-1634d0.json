ogle.com/drive/folders/1itrReBPo961cMLFCQjsvRkLDQzopBo-t?usp=drive_link\n\nイラストは自由に選んでください！\nその他、服装なども自由ですので、自由に変えてください！\nまた、淫らなイラストにするのも自由です！", "created_at": "", "completed_at": ""}, {"path": "/@Gagangaga_soul/works/47", "thumbnail_src": "https://si.imgix.net/dfc92776/uploads/origins/ccc62927-d3fe-43fa-8c18-40394ef382f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7d78520743448a48f29468a6da52108", "thumbnail_srcset": "https://si.imgix.net/dfc92776/uploads/origins/ccc62927-d3fe-43fa-8c18-40394ef382f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7d78520743448a48f29468a6da52108, https://si.imgix.net/dfc92776/uploads/origins/ccc62927-d3fe-43fa-8c18-40394ef382f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48fb2cdf84f0946260578e4930d6091f 2x, https://si.imgix.net/dfc92776/uploads/origins/ccc62927-d3fe-43fa-8c18-40394ef382f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63dd160746e3ea0bc573f0378060d0ec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gagangaga_soul/works/46", "thumbnail_src": "https://si.imgix.net/83fbf6d9/uploads/origins/7f9f5b89-1a46-46c0-a1d3-5ca4abcb2c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2af5bcceec461fcc2d9f8ab1b52693dc", "thumbnail_srcset": "https://si.imgix.net/83fbf6d9/uploads/origins/7f9f5b89-1a46-46c0-a1d3-5ca4abcb2c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2af5bcceec461fcc2d9f8ab1b52693dc, https://si.imgix.net/83fbf6d9/uploads/origins/7