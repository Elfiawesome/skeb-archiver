a-40c1-ab4d-57e8bdcd0466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=799a85e47eebae23e58137a7d11b4fa2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/20", "thumbnail_src": "https://si.imgix.net/a1c785b4/uploads/origins/ea7b0cbd-c0df-4ab2-95b6-8c666ffab902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3acd08992f6aafa469ee5163954272ea", "thumbnail_srcset": "https://si.imgix.net/a1c785b4/uploads/origins/ea7b0cbd-c0df-4ab2-95b6-8c666ffab902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3acd08992f6aafa469ee5163954272ea, https://si.imgix.net/a1c785b4/uploads/origins/ea7b0cbd-c0df-4ab2-95b6-8c666ffab902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e571e0e2885ca6c553f9f807d67108d1 2x, https://si.imgix.net/a1c785b4/uploads/origins/ea7b0cbd-c0df-4ab2-95b6-8c666ffab902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41c4314f82f939e7c9ff60a15b61d758 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n前回も素敵なゆかりさんと葵ちゃんをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\n結月ゆかりに押し倒されて攻められる琴葉葵を描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\n数十日ぶりの帰宅で葵ちゃん成分に飢えていて、\n帰宅の挨拶もそこそこに、葵ちゃんに濃厚キスをするゆかりさん。\n姉に見られるという恥ずかしさから抵抗しようとする葵ちゃん。\n視線を誘導されると、自身と同じようにあかりちゃんに押し倒されてキスされる茜ちゃんが居て、\n姉に見る余裕がないと判断して、ゆかりさんの背中に手を回して受け入れる葵ちゃん。\nそのままゆかりさんに服も下着も剥かれ、されるがままの葵ちゃん。\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/19", "thumbnail_src": "https://si.imgix.net/724dd22b/uploads/origins/043cefc6-aaf9-4687-96e1-1abd20be0885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f6ddb1d2d63fb7fcec3812e617b35f5", "thumbnail_srcset": "https://si.imgix.net/724dd22b/uploads/origins/043cefc6-aaf9-4687-96e1-1abd20be0885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f6ddb1d2d63fb7fcec3812e617b35f5, https://si.imgix.net/724dd22b/uploads/origins/043cefc6-aaf9-4687-96e1-1abd20be0885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a11515732f473785c91e7afdfcdc71c8 2x, https://si.imgix.net/724dd22b/uploads/origins/043cefc6-aaf9-4687-96e1-1abd20be0885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc8021c0c5fbe2adbd73e0ebc1774c31 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nリクエストの募集を再開したとのことでしたので、\nまたご依頼させていただきました。\n\n全裸パーカーの結月ゆかりを襲う琴葉葵を描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■シチュエーション\n朝起きると全裸パーカーのゆかりさんを見つけて驚く琴葉葵。\n唇を尖らせて葵ちゃんがすぐ脱がしてくるからと答える結月ゆかり。\n脱がす楽しみがなくなったと不満を溢して、\nゆかりさんの耳を甘噛みしたり胸や膣を弄ったりして攻める葵ちゃん。\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/18", "thumbnail_src": "https://si.imgix.net/05abbf33/uploads/origins/248ac2fd-4c41-4fb4-8829-f4ba8e85fc9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307b376b045d3f84c0606d7650e66839", "thumbnail_srcset": "https://si.imgix.net/05abbf33/uploads/origins/248ac2fd-4c41-4fb4-8829-f4ba8e85fc9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307b376b045d3f84c0606d7650e66839, https://si.imgix.net/05abbf33/uploads/origins/248ac2fd-4c41-4fb4-8829-f4ba8e85fc9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3be9b81be73ce001265f48adf4cd8ec7 2x, https://si.imgix.net/05abbf33/uploads/origins/248ac2fd-4c41-4fb4-8829-f4ba8e85fc9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd9fc9e8182b555f47635b0981c349d 3x", "genre": "art", "nsfw": false, "body": "前回も素敵なゆかりさんと葵ちゃんのイラストをありがとうございました。\nいつも素敵なイラストを見させていただいております。\nリクエストの募集を再開したとのことでしたので、\nまたご依頼させていただきました。\n\nソファで仰向けの体勢で葵ちゃんを慰める結月ゆかりと\nゆかりさんのお腹を枕に不満そうな顔をしている琴葉葵のイラストを描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\nソファで仰向けになってソシャゲの周回をする結月ゆかりと、\nそんなゆかりさんに構ってもらおうと声を掛けたり周囲をうろちょろする琴葉葵。\nスマホに夢中で適当に相槌を打つゆかりさんの態度に腹を立てて、\nゆかりさんのお腹を枕にして不満を訴える葵ちゃん。\nそんな葵ちゃんの可愛さに負けて機嫌を取ろうと構いだすゆかりさん。\n\n■要望\n可能であれば差分をお願いいたします。\n・そのまま眠ってしまったゆかりさんと葵ちゃんの二人に\n　タオルケットを掛けて立ち去る茜ちゃん。\n　（タオルケットを掛けたのが茜ちゃんということが分かれば大丈夫です）\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/17", "thumbnail_src": "https://si.imgix.net/3333659c/uploads/origins/a6095984-c312-40f3-83a5-43bf4a72cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7821a7504cb20cf4309de38426b82856", "thumbnail_srcset": "https://si.imgix.net/3333659c/uploads/origins/a6095984-c312-40f3-83a5-43bf4a72cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7821a7504cb20cf4309de38426b82856, https://si.imgix.net/3333659c/uploads/origins/a6095984-c312-40f3-83a5-43bf4a72cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e3dd1378e552d3566b58aee0e0254d0 2x, https://si.imgix.net/3333659c/uploads/origins/a6095984-c312-40f3-83a5-43bf4a72cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d95037447726345165727acc24114ad3 3x", "genre": "art", "nsfw": true, "body": "うちの子（https://www.pixiv.net/artworks/93210952）の二人で、\n二人でマイクロビキニを着てツイスターゲームやってる絵をお願いします。\n\nシーンイメージは、陽菜ちゃんの家へ遊びに来て一緒に遊んでいる状態。\n※こちら（https://skeb.jp/@kashiki_main/works/29）の続きみたいなイメージ\nせっかく動きやすい服装になったから、身体を動かすゲームをやろうという流れ。\n\n雰囲気は、\nお互いふざけながらも、ワイワイと楽しそうに遊んでいる感じ。\n二人とも運動神経は良い方なので、多少無理な体勢で頑張っても大丈夫です。\n\n服装は二人ともマイクロビキニ。\n布面積は、こちら（https://skeb.jp/@kashiki_main/works/29）ぐらいのイメージでお願いします。\n細かいデザインは、変えて貰っても構いません。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/16", "thumbnail_src": "https://si.imgix.net/50ca44f0/uploads/origins/605b7d00-e7b0-49b0-8526-19d7566ad3bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbc9c633adfda5820e705d795817373d", "thumbnail_srcset": "https://si.imgix.net/50ca44f0/uploads/origins/605b7d00-e7b0-49b0-8526-19d7566ad3bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbc9c633adfda5820e705d795817373d, https://si.imgix.net/50ca44f0/uploads/origins/605b7d00-e7b0-49b0-8526-19d7566ad3bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6a4337d31dcacd4c842bcedb2c06e08 2x, https://si.imgix.net/50ca44f0/uploads/origins/605b7d00-e7b0-49b0-8526-19d7566ad3bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5160b32124ba8236572eb2b3114f76f9 3x", "genre": "art", "nsfw": true, "body": "先日は葵ちゃんのイラストありがとうございました。\n大変好みでしたので、またご依頼させていただきました。\n\nウェディング水着衣装の結月ゆかりを\n脱がそうとする琴葉葵をお願いします。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■服装\n　結月ゆかり：ウェディング水着（公式衣装）\n　琴葉葵　　：私服\n\n■シチュエーション\n（こんな感じを想定していますが、イメージと合わなければスルーしていただいても大丈夫です。）\n「次の衣装が決まったんです！」と衣装を見せびらかしに葵ちゃんの自室に訪れるゆかりさん。\n自室でくつろいでいる時にそんなゆかりさんがやってきて、\n（こんな恰好で部屋に来るとか襲ってくれって言ってるようなものでしょ）と\n内心で自己完結して脱がしに掛かる葵ちゃん。\n\n■要望\n・水着の下側の腰布は既に下げられていて、\n　水着の上側に葵ちゃんが手をかけていて、乳房と乳首が露になるようずらしている。\n\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/15", "thumbnail_src": "https://si.imgix.net/88266c5f/uploads/origins/6a71a277-f3ab-446b-84b6-30775e7b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5caaad341c3ec6a69eb0cd24a9afb1a", "thumbnail_srcset": "https://si.imgix.net/88266c5f/uploads/origins/6a71a277-f3ab-446b-84b6-30775e7b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5caaad341c3ec6a69eb0cd24a9afb1a, https://si.imgix.net/88266c5f/uploads/origins/6a71a277-f3ab-446b-84b6-30775e7b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=906f91fe3f9dce842156eb21fd79fe09 2x, https://si.imgix.net/88266c5f/uploads/origins/6a71a277-f3ab-446b-84b6-30775e7b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=747c76adfb15152387c9f59049061765 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@GuPisGOOD/works/13の葵ちゃんがゆかりさんにオナバレたシチュでゆか攻めあお受けいちゃラブゆりゆり貝合わせえっちピクチャーください", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/14", "thumbnail_src": "https://si.imgix.net/626635f7/uploads/origins/2abe5c4c-7082-4c90-a146-c845d546563a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5736591776a84b0150fbfb92e2c093", "thumbnail_srcset": "https://si.imgix.net/626635f7/uploads/origins/2abe5c4c-7082-4c90-a146-c845d546563a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5736591776a84b0150fbfb92e2c093, https://si.imgix.net/626635f7/uploads/origins/2abe5c4c-7082-4c90-a146-c845d546563a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8611d25f87033a93558b42623274417 2x, https://si.imgix.net/626635f7/uploads/origins/2abe5c4c-7082-4c90-a146-c845d546563a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=588e0574e4dfb1a0a2019f35e83358ab 3x", "genre": "art", "nsfw": false, "body": "学校から帰宅後、自宅で制服のまま二人でゲームをする琴葉姉妹をお願いしたいです。\n\n服装は々々（のまのま）さんの琴葉姉妹立ち絵のイメージです。\nhttps://seiga.nicovideo.jp/seiga/im8943263\nhttps://seiga.nicovideo.jp/seiga/im8948956\n\n髪型に関しては解釈でお任せしますが、髪飾りは日常用簡易版って感じでふたりともつけていて欲しいです。\n協力ゲーをやっているイメージで、ゲームコントローラーはPS4コンでお願いします。\n\nとにかく楽しげにしている琴葉姉妹が見たいです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/13", "thumbnail_src": "https://si.imgix.net/b6a1baaa/uploads/origins/fa45aae4-7e12-407d-ab10-6bdc64c20d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaed3caace860dc8be88cc5d4c593ef9", "thumbnail_srcset": "https://si.imgix.net/b6a1baaa/uploads/origins/fa45aae4-7e12-407d-ab10-6bdc64c20d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaed3caace860dc8be88cc5d4c593ef9, https://si.imgix.net/b6a1baaa/uploads/origins/fa45aae4-7e12-407d-ab10-6bdc64c20d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=401e1f1fd3d3e5e0abada6b6094ffec8 2x, https://si.imgix.net/b6a1baaa/uploads/origins/fa45aae4-7e12-407d-ab10-6bdc64c20d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1c0c75c678a00e211a0c90796bc14c0 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nいつも素敵なイラストを見させていただいております。\nこの度、リクエストの募集を再開したとのことでしたので、\nご依頼させていただきました。\n\n【キャラクター】琴葉葵\n【服装】全裸で、結月ゆかりのパーカーを抱きかかえている\n【背景】部屋の一室\n　　　（可能であればゆかりさんの部屋。家具等の具体的な指定はありませんのでお任せいたします）\n【構図】ベッドの上で自慰後、興奮した様子でパーカーを抱きかかえている。\n　　　　床の上に無造作に衣装が脱ぎ捨ててある。\n\n以上の内容のイラストでお願いいたします。\n指定していない部分はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/12", "thumbnail_src": "https://si.imgix.net/c543dd91/uploads/origins/ecc9cc04-7201-4723-8801-31eb079a5acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32cfcd256482cea35526956fda2691e1", "thumbnail_srcset": "https://si.imgix.net/c543dd91/uploads/origins/ecc9cc04-7201-4723-8801-31eb079a5acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32cfcd256482cea35526956fda2691e1, https://si.imgix.net/c543dd91/uploads/origins/ecc9cc04-7201-4723-8801-31eb079a5acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=273bc174704bdea582ae5438b2ad4553 2x, https://si.imgix.net/c543dd91/uploads/origins/ecc9cc04-7201-4723-8801-31eb079a5acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2c86dbae98a1f0b039fe1049a3e904f 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターの依頼をお願いしたいです。参考画像のような窓の上に寝そべっている姿を希望します。\nhttps://media.discordapp.net/attachments/866723796697088030/950447977263136818/74716845_p0.png 例として、彼女の靴を脱がせたい場合。ボーナス画像として、靴なしでもいいかもしれません。靴を履いているのは確定です。と決めておくといいでしょう。またポーズ画像は、ポケットに手を入れている。.お腹に手を当てているように変更できます。\n\n最近の作品例\nhttps://media.discordapp.net/attachments/866723796697088030/951216815076409444/677213-1.output.png\n\nhttps://media.discordapp.net/attachments/866723796697088030/951216815969800202/677213-2.output.png\n\nその他の参考資料\nhttps://media.discordapp.net/attachments/943394484987768834/949910053702492190/ffxiv_03062022_004945_474.png\n\nhttps://media.discordapp.net/attachments/943394484987768834/949910148577628200/ffxiv_03062022_005206_292.png\n\nhttps://media.discordapp.net/attachments/943394484987768834/94991035704\n\nhttps://media.discordapp.net/attachments/943394484987768834/949910056852418560/ffxiv_03062022_005037_683.png", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/11", "thumbnail_src": "https://si.imgix.net/be7c2948/uploads/origins/c6031ae3-c740-4cdc-933d-13d79b0da4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6eb77dd9da00a1dab09ad8ad92e5fad", "thumbnail_srcset": "https://si.imgix.net/be7c2948/uploads/origins/c6031ae3-c740-4cdc-933d-13d79b0da4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6eb77dd9da00a1dab09ad8ad92e5fad, https://si.imgix.net/be7c2948/uploads/origins/c6031ae3-c740-4cdc-933d-13d79b0da4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e28df268c2b2b88eef782468c5e914e5 2x, https://si.imgix.net/be7c2948/uploads/origins/c6031ae3-c740-4cdc-933d-13d79b0da4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=857fc4f3e0b27bac9b1015340692df0d 3x", "genre": "art", "nsfw": false, "body": "ウチのデブ猫をドヤ顔で見せつけてくるゆかり雫ちゃんをお願いします。\n\n服装は公式のものを。\nメガネは必須です。\n\nﾈｺﾁｬﾝはよっかさんが毎日あげてるひるねこを参照してください。結構でかい猫です。体重は5kgあります。猫種はノルウェー・ジャン・フォレストキャットです。\n\n背景は本棚と絵画がある室内で。\n本棚には｢罪と罰｣｢ドグラ・マグラ｣｢虚無への供物｣｢黒死館殺人事件｣｢匰の中の失楽｣｢殺意｣｢叔母殺人事件｣｢クロイドン発12時30分｣の8冊が納められているようにお願いします。\nミステリーが好きなゆかりさんなので、もしオススメあれば本棚に入れてくれたならよっかが読みます()\n\n絵画には｢ゆかり雫ちゃんが可愛い過ぎて川になった男の成れの果て｣と言うタイトルで怖い感じの絵で(こちらはあっても無くても。あれば楽しい)\n\n構図の事はよくわからないのでお任せします。ニコニコのアイコン用にしたいので、可愛くパンチが効いたものをお願いします(^o^)", "created_at": "", "completed_at": ""}, {"path": "/@GuPisGOOD/works/10", "thumbnail_src": "https://si.imgix.net/90b4be94/uploads/origins/fc2a2f73-dd31-42c7-bd6c-c248d4d8ad8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fcb0f678035618a29947ec9297afbae", "thumbnail_srcset": "