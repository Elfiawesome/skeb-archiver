txtsize=30&txt=PRIVATE&s=1f2d947b23a1b10a51c7bb276e44c782, https://si.imgix.net/c2894675/uploads/origins/b1978434-2062-426c-8cd9-5460b6f43afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4f4a9421738e689811981b0bcdebcbf 2x, https://si.imgix.net/c2894675/uploads/origins/b1978434-2062-426c-8cd9-5460b6f43afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d93acd4702511bd7c0b454439ddeca35 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@2gi0gi_/works/48", "thumbnail_src": "https://si.imgix.net/af665ae4/uploads/origins/e1ec348b-cc09-43c8-9b31-fa66cfe7e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c70abd7b015def8b47afc4ef25a43ccf", "thumbnail_srcset": "https://si.imgix.net/af665ae4/uploads/origins/e1ec348b-cc09-43c8-9b31-fa66cfe7e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c70abd7b015def8b47afc4ef25a43ccf, https://si.imgix.net/af665ae4/uploads/origins/e1ec348b-cc09-43c8-9b31-fa66cfe7e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64d9e778db8dc04ea2391f9395d18c4e 2x, https://si.imgix.net/af665ae4/uploads/origins/e1ec348b-cc09-43c8-9b31-fa66cfe7e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2afdc696f88958d4b201a60d78b39dd 3x", "genre": "art", "nsfw": false, "body": "もわちちさん\nはじめまして、はちかと申します\n以前からもわちちさんのイラストを拝見し、キラキラした塗りがとても綺麗で素敵だなと思っておりました\nとくに女の子のくりっとした宝石のような瞳が大好きです！\nもしよろしければ自創作キャラを描いていただきたくリクエストを送らせて頂きます\n\n▼参考画像\nttp://hachika120.web.fc2.com/niwa/skb1.png\nttp://hachika120.web.fc2.com/niwa/skb2.png\nttp://hachika120.web.fc2.com/niwa/taitoru2.png\nttp://hachika120.web.fc2.com/niwa/skb4.png \n（直リンク不可のサーバーのため頭のhを抜いて張っています）\n\nこちらの画像内の茶髪三つ編みの女の子と金髪の女の子をお願いしたいです\n\n金髪の女の子  17歳  165cm前後\n・元気で明るい天真爛漫なギャル\n・設定上では美少女\n・手先が器用で錬金術でのアクセサリーの自作が得意\n・分かりにくいのですが海色の石のネックレスを身につけている\n\n茶髪の女の子  17歳  身長160cm前後 \n・顔や表情はクールめな印象だが世話焼きで心優しい少女\n・好奇心旺盛でノリが良い\n\nこの二人は「庭騎士のスクールライフ」というフリーゲームのキャラクターでファンタジーな世界観の学生（同級生）です\n構図はお任せしたいのですが可能でしたら2人が仲良く楽しそうな明るい雰囲気のイラストをお願いしたいです\n背景の参考資料がありますが雰囲気の把握程度で大丈夫です\n服装など分かりにくい部分などはアレンジして頂ければ幸いです\nお値段やスケジュール、内容など難しい点がありましたら気軽にキャンセルして下さい\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@2gi0gi_/works/47", "thumbnail_src": "https://si.imgix.net/3a1a1412/uploads/origins/9d001268-0eeb-4a65-9b1e-238c90b5b1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31bce7c4a764c7d76ad913119693fa11", "thumbnail_srcset": "https://si.imgix.net/3a1a1412/uploads/origins/9d001268-0eeb-4a65-9b1e-238c90b5b1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31bce7c4a764c7d76ad913119693fa11, https://si.imgix.net/3a1a1412/uploads/origins/9d001268-0eeb-4a65-9b1e-238c90b5b1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebf71bf262307b67cadb3def83f3fade 2x, https://si.imgix.net/3a1a1412/uploads/origins/9d001268-0eeb-4a65-9b1e-238c90b5b1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95344170183c42c756fcb4cce5a23fac 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@2gi0gi_/works/46", "thumbnail_src": "https://si.imgix.net/9e0460e4/uploads/origins/f9d8fdc3-046e-47c0-8c10-d6e54aea2153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=5