dc7-44d1-8b1a-dedeae35d6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94dc8255f8b0a9279c619d66fa063cc6 2x, https://si.imgix.net/d7b8a72d/uploads/origins/c3983f4c-0dc7-44d1-8b1a-dedeae35d6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66227346a826476509738ef719e07ce0 3x", "genre": "art", "nsfw": false, "body": "T羅さんこんばんは！\n今回はT羅さんに好きなシチュのこいしちゃんを描いてもらいたく依頼させていただきました！\n\n暁Recordsの曲で「Bye Bye Love」と言う心を閉ざす直後のこいしちゃんの曲なんですが、それがとても良くて、最後の「前よりみんなを好きになったよ」って所を描いてもらいたいのです！閉じた瞳を抱える少し幼めなこいしちゃんをお願いしたいです！\n\n背景的には心が読めて皆から嫌われすぎて好きにはなれなかったけど、心を読めなくなったら少しはマシになったという意味だと思っているのです！\n\n最後に某SNSで描いてもらったものとして載せさせていただきたいです！ご検討お願いします！\n\nhttps://youtu.be/Gu-Vsmq8vh0?si=-CvOcucLmxDZc4Ft", "created_at": "", "completed_at": ""}, {"path": "/@equality_taira/works/10", "thumbnail_src": "https://si.imgix.net/b942135b/uploads/origins/15066d19-e9d7-493f-9477-50f15b67a8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d488c75acdc2c0b34c08fde6c3a42586", "thumbnail_srcset": "https://si.imgix.net/b942135b/uploads/origins/15066d19-e9d7-493f-9477-50f15b67a8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d488c75acdc2c0b34c08fde6c3a42586, https://si.imgix.net/b942135b/uploads/origins/15066d19-e9d7-493f-9477-50f15b67a8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b70fab4a6cd141b49c791be31081e698 2x, https://si.imgix.net/b942135b/uploads/origins/15066d19-e9d7-493f-9477-50f15b67a8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abd214e7a0f7a44030e674a351608fbb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、鍵山雛を現代風の服装で描いていただきたいのですが、制限なし。ぜひお好みに合わせて作ってみてください！", "created_at": "", "completed_at": ""}, {"path": "/@equality_taira/works/9", "thumbnail_src": "https://si.imgix.net/04e8cadd/uploads/origins/b99e0df7-3f85-4221-93aa-58fb5f71e8ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a79db1dfedf15