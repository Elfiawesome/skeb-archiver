nkaeru/works/5\nhttps://skeb.jp/@e_crsm/works/5\nhttps://skeb.jp/@miyakon22/works/27\nhttps://skeb.jp/@618kazeman/works/7\n\n10cmくらいのフィギュアを予定しており、細かいディテールは再現できないので全体のシルエット・表情・ポーズ等でキャラクターが表現されているとありがたい感じです\n\nシチュやポーズで「はいてない」「腋乳」等フェチポイントを表現してくれるとうれしいです\n\n衣服とフェチポイント以外の、キャラそのものはお任せします。\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n\n背景はありでもなしでもOK\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n\n\nよろしければご検討お願い致します", "created_at": "", "completed_at": ""}, {"path": "/@equality_taira/works/2", "thumbnail_src": "https://si.imgix.net/81a860b6/uploads/origins/a1cdfa7e-9adb-48bb-9a97-f25e48c2de9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84fce278c82ddc8ddb550123f67e3de2", "thumbnail_srcset": "https://si.imgix.net/81a860b6/uploads/origins/a1cdfa7e-9adb-48bb-9a97-f25e48c2de9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84fce278c82ddc8ddb550123f67e3de2, https://si.imgix.net/81a860b6/uploads/origins/a1cdfa7e-9adb-48bb-9a97-f25e48c2de9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e793333ffedf37b8d7dd3ae6ea82735 2x, https://si.imgix.net/81a860b6/uploads/origins/a1cdfa7e-9adb-48bb-9a97-f25e48c2de9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2e8529eab4dfdcfc89bb63cc9617cbd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@equality_taira/works/1", "thumbnail_src": "https://si.imgix.net/d9afa269/uploads/origins/78557200-5d52-42fa-8475-efff0652a9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=696948ccfd2ccc628c6dff8107ad4a52", "thumbna