7c7a3bc803c4 2x, https://si.imgix.net/98886776/uploads/origins/982cef56-eb90-4a95-b85f-d2c67d2400c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19c7865308e89b08bab10c191f68ec25 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またリクエストに来ちゃいました。\n初恋性ストックホルム症候群自陣の美原恋瑚子(PC)と大城春くん(KPC)で何かイラストお願い出来ますでしょうか…！\nシチュエーションや構図はたなさんにお任せします！\n描いていただいた絵は暮須のXやdiscordで、たなさんのお名前明記の上でお披露目させていただく可能性がございます。\nどうぞご検討のほどよろしくお願いします！\n\nhttps://x.com/cresson_mdms/status/1718218271206609292?s=46", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/7", "thumbnail_src": "https://si.imgix.net/67bdaefe/uploads/origins/5b549fd5-6e22-4054-b790-41f9768faf38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e2df64024910acbcab2610280733aa7", "thumbnail_srcset": "https://si.imgix.net/67bdaefe/uploads/origins/5b549fd5-6e22-4054-b790-41f9768faf38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e2df64024910acbcab2610280733aa7, https://si.imgix.net/67bdaefe/uploads/origins/5b549fd5-6e22-4054-b790-41f9768faf38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fadd68e0eb2497661727dae92421117 2x, https://si.imgix.net/67bdaefe/uploads/origins/5b549fd5-6e22-4054-b790-41f9768faf38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de9b42213c201fac88deb3c84a3c549f 3x", "genre": "art", "nsfw": false, "body": "「眩い指」最高でしたありがとうございます…ありがとうございます……噛み締め………\n最高素敵シナリオ書いて頂いてさらにお願いの上塗りなんですがもし良ければ授かったちいこ命(リーリウとアンゼル)をぜひ田中さん画で拝見したく…リクエスト送らせて頂きました…！\n俺が産んだ愛し命(ちいこエヴァ)も一緒であればめちゃくちゃ喜びますが田中さんにお任せします！田中さんちのちいこちゃん達が本当に激ラブで………\nよろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/6", "thumbnail_src": "https://si.imgix.net/031141bb/uploads/origins/e3f1ae78-1aa5-4d75-9fcf-78103753ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73f973681283391b113cfbdec1bd0701", "thumbnail_srcset": "https://si.imgix.net/031141bb/uploads/origins/e3f1ae78-1aa5-4d75-9fcf-78103753ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73f973681283391b113cfbdec1bd0701, https://si.imgix.net/031141bb/uploads/origins/e3f1ae78-1aa5-4d75-9fcf-78103753ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b065ea40119692833aa66d20c0337d3a 2x, https://si.imgix.net/031141bb/uploads/origins/e3f1ae78-1aa5-4d75-9fcf-78103753ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f4d8a5533249172611451af39cbe729 3x", "genre": "art", "nsfw": false, "body": "よるたつよるください…\n今一番田中さんが描きたいシチュエーションでいいです\nのんびりで大丈夫です", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/5", "thumbnail_src": "https://si.imgix.net/a87c81ab/uploads/origins/864336d1-c1d2-438e-8d8f-c2f55af24fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9034aafeb7245c8b7baf11461406cd", "thumbnail_srcset": "https://si.imgix.net/a87c81ab/uploads/origins/864336d1-c1d2-438e-8d8f-c2f55af24fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9034aafeb7245c8b7baf11461406cd, https://si.imgix.net/a87c81ab/uploads/origins/864336d1-c1d2-438e-8d8f-c2f55af24fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0217ef28f8f2964850ea2bd40abc849 2x, https://si.imgix.net/a87c81ab/uploads/origins/864336d1-c1d2-438e-8d8f-c2f55af24fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21e97084f70358add5411038650a95fe 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になってます！九枝 幸示さんを描いて頂ければ嬉しいです。ラフで十分ですので、色々な九枝さんが見れたらとってもっとっても嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/4", "thumbnail_src": "https://si.imgix.net/b4ab34a1/uploads/origins/d121c505-75fb-43af-8308-a2610c9d9016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d5e68ebe4018a4f1df63167bd0626b2", "thumbnail_srcset": "https://si.imgix.net/b4ab34a1/uploads/origins/d121c505-75fb-43af-8308-a2610c9d9016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d5e68ebe4018a4f1df63167bd0626b2, https://si.imgix.net/b4ab34a1/uploads/origins/d121c505-75fb-43af-8308-a2610c9d9016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e72e6e57593e72ab289dcb30fc4994c 2x, https://si.imgix.net/b4ab34a1/uploads/origins/d121c505-75fb-43af-8308-a2610c9d9016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdadf2d22dbe04b40ceef2c949d85165 3x", "genre": "art", "nsfw": false, "body": "いつも楽しくTwitter拝見させて頂いてます！よろしければ九壇ノ籠のジェンスさんをお願いしたいです。ジェンスさん本当に好きで未だに見返しております…！", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/3", "thumbnail_src": "https://si.imgix.net/5f5c5a04/uploads/origins/cc32ecd1-1e25-4fc8-8d5f-9e0c0e06a08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b69c6b2784b87a5de87de3904b66cebe", "thumbnail_srcset": "https://si.imgix.net/5f5c5a04/uploads/origins/cc32ecd1-1e25-4fc8-8d5f-9e0c0e06a08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b69c6b2784b87a5de87de3904b66cebe, https://si.imgix.net/5f5c5a04/uploads/origins/cc32ecd1-1e25-4fc8-8d5f-9e0c0e06a08f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb2eba9d1aafd0c012b91eac97ff91b5 2x, https://si.imgix.net/5f5c5a04/uploads/origins/cc32ecd1-1e25-4fc8-8d5f-9e0c0e06a08f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29f403c4fc1bf9c2f463b4f2fefc74ab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/2", "thumbnail_src": "https://si.imgix.net/0841079a/uploads/origins/b7fcb970-38a5-4ac4-880a-edc73ac83c66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0221e44012926e5fd43ca3a939a70f42", "thumbnail_srcset": "https://si.imgix.net/0841079a/uploads/origins/b7fcb970-38a5-4ac4-880a-edc73ac83c66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0221e44012926e5fd43ca3a939a70f42, https://si.imgix.net/0841079a/uploads/origins/b7fcb970-38a5-4ac4-880a-edc73ac83c66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c67962b26c99c97ee459b2b1f0d7298e 2x, https://si.imgix.net/0841079a/uploads/origins/b7fcb970-38a5-4ac4-880a-edc73ac83c66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3fb34b738b2b0f9fc8d6abd4ac31577 3x", "genre": "art", "nsfw": false, "body": "募集開始待ってましたァーーー！！！\n余裕があればで全然かまいませんので、魔従の国のゾネさんと可能であれば拙宅のラントユンカー（https://www.pixiv.net/artworks/54134802）を添えたイラストをお願いしたく存じます…！\n\nご負担多ければゾネさんだけで全然大丈夫ですので…！\nまたご依頼殺到されているようでしたらけっていただいて大丈夫です、宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@teru_bz/works/1", "thumbnail_src": "https://si.imgix.net/e552b0e3/uploads/origins/0d99986d-c8ec-4fbf-af88-022c25377d36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6eac8630f031b839790c3bd32d70a6", "thumbnail_srcset": "https://si.imgix.net/e552b0e3/uploads/origins/0d99986d-c8ec-4fbf-af88-022c25377d36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6eac8630f031b839790c3bd32d70a6, https://si.imgix.net/e552b0e3/uploads/origins/0d99986d-c8ec-4fbf-af88-022c25377d36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5364f6036ddbb3cd287e486c3052c22 2x, https://si.imgix.net/e552b0e3/uploads/origins/0d99986d-c8ec-4fbf-af88-022c25377d36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b995db66f4549e1999e24fe03d53e397 3x", "genre": "art", "nsfw": false, "body": "こんにちは〜！たなさんがskebを開いていることに気付いて飛んで参りました。\n九壇ノ籠無印の自キャラ「茜寿々賀」(id= 37483774)をリクエストさせてください！\n\n外見はいくつか種類がありますが、たなさん作品の内側から光輝くような神々しい色合いが好きなので、髪の赤が一番映える部分異形形態(CS1枚目の姿)を通常頭身で希望します。\nその他の構図・シチュエーション・背景の有無等は自由にご描写ください。\n\nご検討頂けますと幸いです。よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/37483774", "created_at": "", "completed_at": ""}]}