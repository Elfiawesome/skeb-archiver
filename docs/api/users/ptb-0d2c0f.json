a94-4492-8007-64bf3eea3147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f59aa5d9c280d3be291827b7c840f884", "thumbnail_srcset": "https://si.imgix.net/657dbbe2/uploads/origins/e4004f55-3a94-4492-8007-64bf3eea3147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f59aa5d9c280d3be291827b7c840f884, https://si.imgix.net/657dbbe2/uploads/origins/e4004f55-3a94-4492-8007-64bf3eea3147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2788bfb381dcaf10ffbe143ab5d08a3 2x, https://si.imgix.net/657dbbe2/uploads/origins/e4004f55-3a94-4492-8007-64bf3eea3147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63e380a6e4065bfd22f67cb04e2adca5 3x", "genre": "art", "nsfw": false, "body": "部屋干しさん、こんにちは。\nマイキャラクターのゼノをリクエストさせてください。\n\n三面図の資料の服装から、パーカーを脱がして、\nそれを肩越しに持っている立ち姿を見てみたいです。\n目つきは神田理くんのように鋭く、クールな感じを出して頂けると嬉しいです。\n腕は肩から手首まで同じ色です。\n\n\n納品はpsd形式で、宛名を別レイヤーにしていただけると幸いです。\n\nhttps://drive.google.com/drive/folders/16wPfQJ74ZB1vA5u6NoHxiwBskevwHDpd?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ptb/works/8", "thumbnail_src": "https://si.imgix.net/bf17ab90/uploads/origins/731d2318-78cc-4b65-b32f-bd078fc56c1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b34e2f479f0b7efda6eb7be5d8b80093", "thumbnail_srcset": "https://si.imgix.net/bf17ab90/uploads/origins/731d2318-78cc-4b65-b32f-bd078fc56c1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b34e2f479f0b7efda6eb7be5d8b80093, https://si.imgix.net/bf17ab90/uploads/origins/731d2318-78cc-4b65-b32f-bd078fc56c1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24b25d70bb860731fb0ccf8307db3182 2x, https://si.imgix.net/bf17ab90/uploads/origins/731d2318-78cc-4b65-b32f-bd078fc56c1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db71ffe3bb838d04493c1a77b5003ffc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のキャラクターを、あなたの好きなように、かっこいいと思うように描いてください。服を着ていても、着ていなくても構いません。\n\nhttps://drive.google.com/drive/folders/1-ozH63fO2ytVzQC00xPVJjfwprVSeKyl", "created_at": "", "completed_at": ""}, {"path": "/@ptb/works/7", "thumbnail_src": "https://si.imgix.net/3cca50c9/uploads/origins/997c319a-f30c-4ffb-9e71-343c0c1d9168?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62b6eaf4044cdbc9c08a07b0ce25c8f0", "thumbnail_srcset": "https://si.imgix.net/3cca50c9/uploads/origins/997c319a-f30c-4ffb-9e71-343c0c1d9168?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62b6eaf4044cdbc9c08a07b0ce25c8f0, https://si.imgix.net/3cca50c9/uploads/origins/997c319a-f30c-4ffb-9e71-343c0c1d9168?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62491e5f6e515c633a5de0ae7fcb552f 2x, https://si.imgix.net/3cca50c9/uploads/origins/997c319a-f30c-4ffb-9e71-343c0c1d9168?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=929cc6910a27ee85e21289f13e4f70b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ptb/works/6", "thumbnail_src": "https://si.imgix.net/b1e171dd/uploads/origins/fe920cfc-b3f7-4db8-98a7-b7c173efb704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ac46b57b9914ab06182a95ddb800a23", "thumbnail_srcset": "https://si.imgix.net/b1e171dd/uploads/origins/fe920cfc-b3f7-4db8-98a7-b7c173efb704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ac46b57b9914ab06182a95ddb800a23, https://si.imgix.net/b1e171dd/uploads/origins/fe920cfc-b3f7-4db8-98a7-b7c173efb704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47a6a29d88bb68fd248b7bfb933f30ce 2x, https://si.imgix.net/b1e171dd/uploads/origins/fe920cfc-b3f7-4db8-98a7-b7c173efb704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eed315ae806fad78830ec38260a5a3c9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの作品がとても好きです。私のオリジナルキャラクターを描いてくれませんか？\n銀色のドラゴンとスライムで、ラブラブのかわいいカップルです。スライムはピンクの目の活発な女の子で、ドラゴンはブルーの目の穏やかな男の子です。\n湖で一緒に水遊びをしているところを見てみたいですね。スライムはドラゴンよりもずっと小さいのですが、ドラゴンを小さくしたり、若いドラゴンを描いても構いません。気軽に描いてくださいね。\n\nhttps://drive.google.com/drive/folders/1-MBuTsZ11ErK1clwf1HR6eL5Q6uy10V1", "created_at": "", "completed_at": ""}, {"path": "/@ptb/works/5", "thumbnail_src": "https://si.imgix.net/cb228bed/uploads/origins/bbb2d79d-b736-4763-9035-1249afd030a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ebd73424b3c81780c5b68986a5eae4", "thumbnail_srcset": "https://si.imgix.net/cb228bed/uploads/origins/bbb2d79d-b736-4763-9035-1249afd030a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ebd73424b3c81780c5b68986a5eae4, https://si.imgix.net/cb228bed/uploads/origins/bbb2d79d-b736-4763-9035-1249afd030a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed81497d8107e75199c50ea18eef3006 2x, https://si.imgix.net/cb228bed/uploads/origins/bbb2d79d-b736-4763-9035-1249afd030a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abd969784ef15e6384e1a0bfc272dfba 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私の2匹の猫キャラクター、イミクとホシを描いていただけないでしょうか。場所やポーズは自由です。よろしくお願いします(*ﾟヮﾟ*)\n\nhttps://www.dropbox.com/sh/p3hdblofk6qf4jb/AAB_ujQ_8iNsxqAVeA5GNiRPa?dl=0", "created_at": "", "completed_at": ""}]}