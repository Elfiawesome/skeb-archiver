d5076/uploads/origins/3174ef46-e9c6-4518-b9ad-0a54a802faa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71b8960f9023e2d9bad04e316362c16f, https://si.imgix.net/a8ad5076/uploads/origins/3174ef46-e9c6-4518-b9ad-0a54a802faa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=302d83e506ab94b70ef74b5a8e5019c0 2x, https://si.imgix.net/a8ad5076/uploads/origins/3174ef46-e9c6-4518-b9ad-0a54a802faa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc5d6b8f1b8fd938ce67c4bebe5f40ed 3x", "genre": "art", "nsfw": false, "body": "リクエストよろしいでしょうか？\nアニメ・ONEPIECE・４４２話のインペルダウン編に出てくるイワンコフの技によって女性にされた看守のワンダー膨体をお願いします。\n表情は本当の自分に気付き更に新しい自分になれた喜びで嬉しそうな表情でお願いします。\n\n４４２話に出てくる女性になった看守\nhttps://bbs.animanch.com/arc/img/52393/52", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/36", "thumbnail_src": "https://si.imgix.net/0fa6112e/uploads/origins/7740c12b-4b67-4895-bac0-2b44ba202ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d70d048c0d80cdae091b91be6f9cc900", "thumbnail_srcset": "https://si.imgix.net/0fa6112e/uploads/origins/7740c12b-4b67-4895-bac0-2b44ba202ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d70d048c0d80cdae091b91be6f9cc900, https://si.imgix.net/0fa6112e/uploads/origins/7740c12b-4b67-4895-bac0-2b44ba202ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4235419fbcbc554ba985f20c4c3fc316 2x, https://si.imgix.net/0fa6112e/uploads/origins/7740c12b-4b67-4895-bac0-2b44ba202ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb9db78a29bc12a8df4dd4265ae58aa9 3x", "genre": "art", "nsfw": false, "body": "特撮番組『超電子バイオマン』のキャラクター「ファラ・キャット」が巨大なブルーベリーに変身する様子を、簡単な順序で描くことは可能ですか？\n\nhttps://www.deviantart.com/stash/22g0ujvpwgfa", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/35", "thumbnail_src": "https://si.imgix.net/7d697301/uploads/origins/c5d9f16f-bf77-4269-8bd6-815ae1813d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f1b54727aecc8fd8a772978a181283", "thumbnail_srcset": "https://si.imgix.net/7d697301/uploads/origins/c5d9f16f-bf77-4269-8bd6-815ae1813d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f1b54727aecc8fd8a772978a181283, https://si.imgix.net/7d697301/uploads/origins/c5d9f16f-bf77-4269-8bd6-815ae1813d57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2c529437e04c3fdde1e3590a79ff059 2x, https://si.imgix.net/7d697301/uploads/origins/c5d9f16f-bf77-4269-8bd6-815ae1813d57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4efddd173787fe84dc377fa9c537b26e 3x", "genre": "art", "nsfw": false, "body": "先日は素晴らしい作品を納品していただき、ありがとうございました。\n今回リクエストさせていただきたいのは「聖剣学院の魔剣使い」より「リーセリア・レイ・クリスタリア」と「レギーナ・メルセデス」のバルンガンマ膨体です。\nキャラクターのデザインについては、資料URLをご確認ください。\n\n膨らみ方やポーズ、アングルについては、先日依頼させていただいたこちらの作品( https://skeb.jp/@ensunder1129/works/28 )を参考にしていただきたいです。\n表情は両者とも、前回のエルフィーネのような「困り顔で恥ずかしがっている顔」でお願いします。\n\nまた、可能であれば両者とも、全身がイラスト内に収まるような形にしてくださるとありがたいです。\n\n依頼文は以上となります。\nご縁がございましたら、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iC829r10WqV1dlrflj6z7fY7SritjvCb?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/34", "thumbnail_src": "https://si.imgix.net/0594788f/uploads/origins/52b43fd5-c020-4963-b20e-765ac7dd7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79aac91d02e366d594672110c96e59d7", "thumbnail_srcset": "https://si.imgix.net/0594788f/uploads/origins/52b43fd5-c020-4963-b20e-765ac7dd7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79aac91d02e366d594672110c96e59d7, https://si.imgix.net/0594788f/uploads/origins/52b43fd5-c020-4963-b20e-765ac7dd7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf5d457093cace666b8257c4309ec382 2x, https://si.imgix.net/0594788f/uploads/origins/52b43fd5-c020-4963-b20e-765ac7dd7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a058fdb8c0670a595fb577c299a81224 3x", "genre": "art", "nsfw": false, "body": "女相撲のイラストのリクエストで巨乳の女力士(美形力士)をお願いします。\n上半身→スポーツブラかサラシを着けている\n下半身→廻しだけ(廻しの下には何も履いてない)\n廻しの色→ピンク\nサガリ有り無しはお任せします。\n顔には贅肉がつかない体質でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/33", "thumbnail_src": "https://si.imgix.net/e85b1c3f/uploads/origins/3511316f-1439-40b3-a0ab-6d8923397dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad3e44b6d514f0847b6e2f94411bc7b3", "thumbnail_srcset": "https://si.imgix.net/e85b1c3f/uploads/origins/3511316f-1439-40b3-a0ab-6d8923397dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad3e44b6d514f0847b6e2f94411bc7b3, https://si.imgix.net/e85b1c3f/uploads/origins/3511316f-1439-40b3-a0ab-6d8923397dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f2086a7dbdeb9229caaa90c339f037c 2x, https://si.imgix.net/e85b1c3f/uploads/origins/3511316f-1439-40b3-a0ab-6d8923397dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d64089840b508a3c5f0c869bb921db1b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/32", "thumbnail_src": "https://si.imgix.net/316927b0/uploads/origins/f52b098e-f41e-46e2-a5d0-2aadb454276c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=058e6fc029c24818f463a7ab12f69c84", "thumbnail_srcset": "https://si.imgix.net/316927b0/uploads/origins/f52b098e-f41e-46e2-a5d0-2aadb454276c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=058e6fc029c24818f463a7ab12f69c84, https://si.imgix.net/316927b0/uploads/origins/f52b098e-f41e-46e2-a5d0-2aadb454276c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91453f450537fb5528f4424c78ab8b0c 2x, https://si.imgix.net/316927b0/uploads/origins/f52b098e-f41e-46e2-a5d0-2aadb454276c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7072fcc205e0a98c2e50b3d870573b18 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nいつも素敵なイラストありがとうございます。\n今回は以前エンサンダさんが描かれていた『魔弾戦記リュウケンドー』の主人公、「鳴神剣二」が風船魔獣バルンガンマによって膨体するまでのシークエンスを依頼させていただきたいです。\n\n構図としてはこちらのリムル膨体シークエンスイラスト（https://www.pixiv.net/artworks/111955144）のように複数枚にわたるシークエンスを希望いたします。\n以下詳細です。\n\n1枚目:胡椒を投げつけようとするが、バルンガンマの緑色の光線を浴びる\n\n2枚目:リムル膨体シークエンスイラストの2枚目と同様の構図で腹部が丸みを帯びながら大きく膨らみだす。表情は驚き。露出やチャック破壊はなし。\n\n3枚目:こちらのGIF（https://imgur.com/a/arLqjmz）のような構図で臀部が丸みを帯びながら大きく膨らみだす。\n\n4枚目:以前描かれていた剣二（https://x.com/ensunder1129/status/1809215581612306458?s=46）と同様の体型でフワリと宙に浮かびだす。\n\n\n以上となります。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/31", "thumbnail_src": "https://si.imgix.net/ef26854f/uploads/origins/07af1f73-ded3-469a-b47c-ab0f7493aafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b73b2ca3ba6936e76191728273c09723", "thumbnail_srcset": "https://si.imgix.net/ef26854f/uploads/origins/07af1f73-ded3-469a-b47c-ab0f7493aafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b73b2ca3ba6936e76191728273c09723, https://si.imgix.net/ef26854f/uploads/origins/07af1f73-ded3-469a-b47c-ab0f7493aafc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f652936b42a0342330484279ed23673a 2x, https://si.imgix.net/ef26854f/uploads/origins/07af1f73-ded3-469a-b47c-ab0f7493aafc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=289dd3bfdfae20f2d64239e8375886fa 3x", "genre": "art", "nsfw": false, "body": "リクエストよろしいでしょうか？\nアニメ・遊戯王デュエルモンスターズ・DMクエスト編の４４話～４５話に登場したメアリー姫のワンダー膨体をお願いします。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/30", "thumbnail_src": "https://si.imgix.net/4de8a53a/uploads/origins/aecb07af-d988-419d-aa60-d6ca2e8b0362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95bd43e7041c6f59b091852f38e52295", "thumbnail_srcset": "https://si.imgix.net/4de8a53a/uploads/origins/aecb07af-d988-419d-aa60-d6ca2e8b0362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95bd43e7041c6f59b091852f38e52295, https://si.imgix.net/4de8a53a/uploads/origins/aecb07af-d988-419d-aa60-d6ca2e8b0362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31ba58592c7b2c869a6df43a8752748e 2x, https://si.imgix.net/4de8a53a/uploads/origins/aecb07af-d988-419d-aa60-d6ca2e8b0362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3913468d26d89c3238e73ac9f311047 3x", "genre": "art", "nsfw": false, "body": "アニメ『ドラゴンピンク』のピンクが、彼氏のサンタに転がされる巨大な熟しすぎたブルーベリーに変身するショートマンガを描いていただけませんか？\n(サンタは痩せた戦士タイプ、ピンクは猫娘）。\nhttps://www.deviantart.com/stash/21t7bnux2ih5\nhttps://www.deviantart.com/stash/0186hz2vvhps\nhttps://www.deviantart.com/stash/01pt085q2lac\nhttps://www.deviantart.com/stash/01d90udtljdw\nhttps://www.deviantart.com/stash/2wre5rcr4uo", "created_at": "", "completed_at": ""}, {"path": "/@ensunder1129/works/29", "thumbnail_src": "https://si.imgix.net/106fd8ab/uploads/origins/64243b03-8dcf-4f8b-80c9-d149010d51d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ce5c50df1869eb40591e594ddcaaa6c", "thumbnail_srcset": "https://si.imgix.net/106fd8ab/uploads/origins/64243b03-8dcf-4f8b-80c9-d149010d51d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign