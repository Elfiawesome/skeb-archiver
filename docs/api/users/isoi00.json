=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee75b22d2092dbeb6d848aae393082c7", "thumbnail_srcset": "https://si.imgix.net/7e264f5f/uploads/origins/17e37cdb-7fee-45fb-ad71-e35ea3a7ff23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee75b22d2092dbeb6d848aae393082c7, https://si.imgix.net/7e264f5f/uploads/origins/17e37cdb-7fee-45fb-ad71-e35ea3a7ff23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8066c94d87506bf2019a7616228a64b 2x, https://si.imgix.net/7e264f5f/uploads/origins/17e37cdb-7fee-45fb-ad71-e35ea3a7ff23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23201be9a23902c436edea3805b97a79 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@isoi00/works/508", "thumbnail_src": "https://si.imgix.net/863514a2/uploads/origins/925fbf89-ff20-4d85-880d-568d650fb6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67b090f82bc3a71a8b1f901cf766e3ab", "thumbnail_srcset": "https://si.imgix.net/863514a2/uploads/origins/925fbf89-ff20-4d85-880d-568d650fb6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67b090f82bc3a71a8b1f901cf766e3ab, https://si.imgix.net/863514a2/uploads/origins/925fbf89-ff20-4d85-880d-568d650fb6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c14d2f0f05d25e59fb8be0321e3bcd75 2x, https://si.imgix.net/863514a2/uploads/origins/925fbf89-ff20-4d85-880d-568d650fb6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f97dcd33e396c24af64eed572478e88 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエスト失礼します！\n\n希望内容\n・彼氏にほっぺをむにょーんと伸ばされてる状態（ちょっと嬉しい）\n・されるがままに受け入れてます。\n・ぼんやりおだやかマイペースな性格\n\nご検討よろしくお願いいたします！\n\nhttps://photos.app.goo.gl/ebq43jLUucPnems87", "created_at": "", "completed_at": ""}, {"path": "/@isoi00/works/507", "thumbnail_src": "https://si.imgix.net/8ae52714/uploads/origins/eec76013-2803-4ce5-8e8d-67b7740a7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f7444a2d71da58b07a25c85c2b2159", "thumbnail_srcset": "https://si.imgix.net/8ae52714/uploads/origins/eec76013-2803-4ce5-8e8d-67b7740a7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f7444a2d71da58b07a25c85c2b2159, https://si.imgix.net/8ae52714/uploads/origins/eec76013-2803-4ce5-8e8d-67b7740a7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7dab45af82a5d2012c7f8c2593a7e91 2x, https://si.imgix.net/8ae52714/uploads/origins/eec76013-2803-4ce5-8e8d-67b7740a7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c3e6bcdcc5bb3e9c807faa3fea67b3c 3x", "genre": "art", "nsfw": false, "body": "isoi先生、こんばんは！お世話になっております。いつも素敵な作品ありがとうございます！\nこの度isoi先生にぜひ描いていただきたい2人がいまして、リクエストさせていただきたく思います。\n\nhttps://drive.google.com/drive/folders/16vTihQEqUEpQQ1zAzI5aAtmoLaEb3dCd\n\n上記の2人をお願いしたいです。\n非常に仲が良く、ネットミームで喋ったりするような、インターネット中毒の2人です。\n可能であれば、ボブカットの方は②の衣装でお願いしたいです。\n\nお好きなように描いてくださいますと幸いです！よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@isoi00/works/506", "thumbnail_src": "https://si.imgix.net/0fafa049/uploads/origins/1ec8b99b-6772-4131-a5db-a415bd8eeba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1893d066e7e7f118c3bc54704355a33e", "thumbnail_srcset": "https://si.imgix.net/0fafa049/uploads/origins/1ec8b99b-6772-4131-a5db-a415bd8eeba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h