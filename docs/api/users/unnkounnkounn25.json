)\n\n\n人物と背景がレイヤー分けできるデータでいただけるとありがたいです。\nまた人物のみの透過素材もいただけるとありがたいです\n\nもし可能でしたらよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@unnkounnkounn25/works/62", "thumbnail_src": "https://si.imgix.net/3b58a4f1/uploads/origins/6026cc8e-97ea-4265-a6db-59d2e14e8dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9617ca588c6d4555ca28f393271eea1f", "thumbnail_srcset": "https://si.imgix.net/3b58a4f1/uploads/origins/6026cc8e-97ea-4265-a6db-59d2e14e8dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9617ca588c6d4555ca28f393271eea1f, https://si.imgix.net/3b58a4f1/uploads/origins/6026cc8e-97ea-4265-a6db-59d2e14e8dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28c35cd4828883c37cf5b861271c51fd 2x, https://si.imgix.net/3b58a4f1/uploads/origins/6026cc8e-97ea-4265-a6db-59d2e14e8dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24ed02b005e57ac96a81b8e42aca82f2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@unnkounnkounn25/works/61", "thumbnail_src": "https://si.imgix.net/1438374b/uploads/origins/248568e7-734e-4f33-baa8-287e95578e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5dc05e5a34bf0881d335459cda813bf", "thumbnail_srcset": "https://si.imgix.net/1438374b/uploads/origins/248568e7-734e-4f33-baa8-287e95578e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=