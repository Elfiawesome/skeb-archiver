e=30&txt=PRIVATE&s=6b2e6b3b4f252be70d89a08d382b2bd9 2x, https://si.imgix.net/560ea1f8/uploads/origins/027adb1e-822c-430d-a261-b4ab6786d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=047f86b0d53af1ac2f0a649bd451f439 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/12", "thumbnail_src": "https://si.imgix.net/eae4468b/uploads/origins/47f66898-cc73-40cc-bd54-ca2fb12cc8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a662772591c81ab4ff406a221a193476", "thumbnail_srcset": "https://si.imgix.net/eae4468b/uploads/origins/47f66898-cc73-40cc-bd54-ca2fb12cc8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a662772591c81ab4ff406a221a193476, https://si.imgix.net/eae4468b/uploads/origins/47f66898-cc73-40cc-bd54-ca2fb12cc8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f074ce6a299583e3daba3e7c27aa890c 2x, https://si.imgix.net/eae4468b/uploads/origins/47f66898-cc73-40cc-bd54-ca2fb12cc8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c270d3b9eb55861d488f1268a032e484 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/11", "thumbnail_src": "https://si.imgix.net/86838729/uploads/origins/2e9591ba-1601-4af8-9e2d-3b01dcd835b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5510edb8b1b949d0c6e62cf3660d37", "thumbnail_srcset": "https://si.imgix.net/86838729/uploads/origins/2e9591ba-1601-4af8-9e2d-3b01dcd835b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5510edb8b1b949d0c6e62cf3660d37, https://si.imgix.net/86838729/uploads/origins/2e9591ba-1601-4af8-9e2d-3b01dcd835b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c914b90aabdd5811dc1cddd03ec347f 2x, https://si.imgix.net/86838729/uploads/origins/2e9591ba-1601-4af8-9e2d-3b01dcd835b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de7e61c5b12a7542cfaa2644feb93b4c 3x", "genre": "art", "nsfw": true, "body": "どうも！私のオリキャラの画像をリクエストしたいのですが：\nhttps://catbox.moe/c/aaq7zd\n\n彼女はデカいなモブ顔お姉さん（226cm）です。お姉さんは特にドーナツ、洋菓子、ソフトクリームが大好きです。\n\nお姉さんは下着姿の体重計で自分の体重を測っている。体重計の数字は見る者には見えないが、お姉さんは体重が増えており、その結果に少々照れている。お姉さんは、前日にケーキをたくさん食べたことが体重増加につながったと振り返る。\n\nその他の詳細については、あなたの判断にお任せします。ご清聴ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/10", "thumbnail_src": "https://si.imgix.net/e1c72e11/uploads/origins/3ea9703f-e21c-4c97-9ef6-b4de8f43da69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee78229a3e6488d07466f3e21a33ab98", "thumbnail_srcset": "https://si.imgix.net/e1c72e11/uploads/origins/3ea9703f-e21c-4c97-9ef6-b4de8f43da69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee78229a3e6488d07466f3e21a33ab98, https://si.imgix.net/e1c72e11/uploads/origins/3ea9703f-e21c-4c97-9ef6-b4de8f43da69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80db099dd1b0c413ea48ec2a4c567c7b 2x, https://si.imgix.net/e1c72e11/uploads/origins/3ea9703f-e21c-4c97-9ef6-b4de8f43da69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ce524afb28f32ab44745b844e37cc2f 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\nいつも素敵な作品の数々、拝見しております。\n\nオリジナルキャラクターのぽっちゃりエルフを描いていただきたいです。\n外見年齢は20代前半くらい。\n身長は160cmちょっとで、体重は100kgを超えている設定です。\n体型は資料をご覧いただいて、これくらいかな？と思われたふくよかさでOKです。\n性格は温和でおっとりしていて、いつも微笑みを絶やさない設定です。\nまた、衣服などのデザインは描きやすいようアレンジいただいても構いません。\nシチュエーションは何か食べている様子を描いていただきたいです。\nお気兼ねなくキャンセルしていただいても大丈夫ですので、ご検討いただければ幸いです。\nそれでは、何卒よろしくお願い致します。\n\n・画像資料\n三面図：https://i.imgur.com/XIearkT.jpg\nバストアップ：https://i.imgur.com/yg4ThoQ.jpg\n3Dモデル：https://hub.vroid.com/characters/6436749062066804628/models/1540537871771610634", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/9", "thumbnail_src": "https://si.imgix.net/e468b626/uploads/origins/3fb61847-d62b-46ee-821a-d72ae4a65420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=500fcdb50ce2122efc8992df5dfa81a1", "thumbnail_srcset": "https://si.imgix.net/e468b626/uploads/origins/3fb61847-d62b-46ee-821a-d72ae4a65420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=500fcdb50ce2122efc8992df5dfa81a1, https://si.imgix.net/e468b626/uploads/origins/3fb61847-d62b-46ee-821a-d72ae4a65420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e51fe9941a6473fbab56825d11602bd5 2x, https://si.imgix.net/e468b626/uploads/origins/3fb61847-d62b-46ee-821a-d72ae4a65420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62cab53bb80726de4eeef20ca9fd0767 3x", "genre": "art", "nsfw": true, "body": "前回は素敵な作品をありがとうございました！！\nせっかくなので前回描いていただいた子達を今回もお願いします。\n\n◇場所：小太郎くんのお部屋\n◇シチュ：前回のことがあり、帰りに小太郎くんのおうちで初えっちすることに\n\nいつも遊びに来ていたはずの幼馴染が、今は下着姿で自分の前にいることに興奮し、自然とおちんちんをシコシコしてしまっていた。\n服を脱ぎ終わり一糸まとわぬ姿となった幼馴染から初めてのキスをされ、おちんちんから手が離れる。\n唇が離れると、さっきまでシコシコしていた手をおまんこに当て、\n「いつもそうやって私でしてくれてたのか？だけど今日はここに射精せ♡」と囁く。\nリビドーの限界を迎え、たまらずベッドに押し倒し、おまんこの入り口を探しおちんちんでくちゅくちゅさせていると、おまんこを広げながら「ここだぞ♡」と入り口を教えてくれ、その声に答え挿入した。\n\n「一生懸命おっぱい吸ってるこたろかわいい♡」「こたろ♡こたろ♡」\n「やべ‥気持ちよすぎてもう射精そう‥」\n「射精せ♡全部奥に射精せ♡」\nとイチャイチャえっちしてもらえると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/8", "thumbnail_src": "https://si.imgix.net/91241175/uploads/origins/c2c2f514-90a4-441e-8db4-834ba388ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5346f50b1718c0d7b250fb3194269eb", "thumbnail_srcset": "https://si.imgix.net/91241175/uploads/origins/c2c2f514-90a4-441e-8db4-834ba388ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5346f50b1718c0d7b250fb3194269eb, https://si.imgix.net/91241175/uploads/origins/c2c2f514-90a4-441e-8db4-834ba388ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ff5caf9e308efd5abde769c7f8e6f09 2x, https://si.imgix.net/91241175/uploads/origins/c2c2f514-90a4-441e-8db4-834ba388ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d72e059be037466d5b4c1d04459feae 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のOC（https://imgur.com/a/G7EviAv）が呪いのスイーツを食べて太るのをリクエストできないかと思ったのですが、そうすると周りから可愛いと思われるようになり、本人も楽しんでいます。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/7", "thumbnail_src": "https://si.imgix.net/ffd2511f/uploads/origins/f15d50e2-6880-4440-866c-af91d17f5986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c532144891053c6838b76f7c400a230c", "thumbnail_srcset": "https://si.imgix.net/ffd2511f/uploads/origins/f15d50e2-6880-4440-866c-af91d17f5986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c532144891053c6838b76f7c400a230c, https://si.imgix.net/ffd2511f/uploads/origins/f15d50e2-6880-4440-866c-af91d17f5986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deaae24d952e7588161d1fda80e29944 2x, https://si.imgix.net/ffd2511f/uploads/origins/f15d50e2-6880-4440-866c-af91d17f5986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd89f2e6a9622447bc6bd4eea92ff871 3x", "genre": "art", "nsfw": false, "body": "チンキさん、お世話になっております。\nサービス期間とのことなので、もう一つご依頼させていただければと思います。\n可能であれば、4枚の漫画にしていただけますと幸いです。難しければ値段を変えます。(白黒で大丈夫です)\n\n婚約間近(各々王位を継ぎ、両国が合併しようとしていた)だった国一番の美男美女だった両国の姫と王子(二人は愛し合っている)が両国の側近同士の結託で巻き起こった内政の実権争いや両国間の争いに巻き込まれ、騒動の火種として濡れ衣を着せられて命を狙われていたために決死の覚悟で二人だけで国から脱出。\n側近の悪事がバレて両国の関係は無事に修復するも、二人は事のけじめをつけるために二人は王位を辞退し、そのまま行方をくらます。\nそして二人は、変える場所もなく食べ物もなくもうダメだと思った中、豊満(肥満)と美食の国にたどり着き、国中でも美味しいと有名な料理屋の優しい大将に助けられ、うまい飯を食べさせてもらい美食に目覚める。\n二人はあてもないため、その人が住まわせてくれて、そこで住み込みではたらき暮らしながら修行をして食べて作る生活をして激太りしていく。\n数年後、二人は、豊満(肥満)と美食の国で独立した国一番とも言われる小さな飲食店を営む、これまた国一番と言われる巨漢のおデブの夫婦へと激太りの変貌をし、庶民としてひっそりラブラブに暮らしていた。\nという設定での姫と王子のビフォーアフター。\n\n\n体型は\n最初王子175cm65kg姫165cm48kg\n住み込みしてしばらく2枚目王子175cm90kg姫165cm73kg\n住み込み自分達も美味しい料理を提供でき大将にも認められてきたとき3枚目\n王子175cm140kg姫165cm123kg\n独立した超人気店で巨体過ぎるため客に驚かれる最後王子175cm185kg姫168kg\n\n漫画形式で太っていく過程を描いていただけますと幸いです。\nもし可能でしたら台詞も入れていただけますと幸いです。\n\n服装は、おデブ時は庶民の服装で国の最大サイズでもお肉がぎちぎちパンパンに張りつめ、料理を出してるから汗でびちょびちょに。ビフォーは姫と王子の格好で。\n\n出来れば、ビフォーアフターどっちも足元まで全身を見れると幸いです。\n\n唐突なご依頼ではございますが、リクエストについてご検討いただけますと幸いです。何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@c_mmdk/works/6", "thumbnail_src": "https://si.imgix.net/73581a04/uploads/origins/6ed35704-a29d-4cbf-8722-e6a0a3e57153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf82bd5c873ecd828f0d8df30a9f0b3", "thumbnail_srcset": "https://si.imgix.net/73581a04/uploads/origins/6ed35704-a29d-4cbf-8722-e6a0a3e57153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf82bd5c873ecd828f0d8df30a9f0b3, https://si.imgix.net/73581a04/uploads/origins/6ed35704-a29d-4cbf-8722-e6a0a3e57153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b4e0f24d4b8a275b66f5e6d152cf2be 2x, https://si.imgix.net/73581a04/uploads/origins/6ed35704-a29d-4cbf-8722-e6a0a3e57153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56e67b6e197e72d35a0613cf4541074e 3x", "genre": "art", "nsfw": false, "body": "チンキさん、お世話になっております。以前はとても素敵な作品を作っていただき、誠にありがとうございます！また、今月お誕生日だったとのこと、誠におめでとうございます！\n今月中サービスをされているとのことで、ギリギリではありますが、ご依頼をさせていただきたいと思います。\nもしギリギリすぎるので、NGであれば金額を変更いたします。\n\nご依頼内容は以下の通りで、可能であれば2ページ組でお願いしたいです。\n①以前にご依頼した二人のアイドルがそれぞれの仲の良かった元メンバー1人ずつ(もし難しければ女の子の方の元メンバー1人)と再開をして、前は自分と同じ体型だったのに、あまりの変わりようにドン引きされ腹をビンタされる様子。\nも