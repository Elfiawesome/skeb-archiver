dpr=2&fit=crop&crop=top&w=200&h=200&s=25721208c847a32f2db5f07e097b1bd2 2x, https://si.imgix.net/86ee7e21/uploads/origins/28a3d10c-422f-4426-b2ec-3f1df7045fff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99f8108b45ff1ccddc94daeb5ae10dbe 3x", "genre": "art", "nsfw": false, "body": "Hello, you have done wonderful work for me in the past, and I love your new things.\n\nI wanted to commission you to create a gift for a friend of mine, Tetra, of their VTuber model.\n\nSomething winter themed. Cold weather style, but cute. It can be flirtatious, but not lewd. \n\nI look forward to seeing whjat you come up with!\n\nThank you for your time and consideration.\n\nhttps://drive.google.com/drive/folders/1DR0-YVLbKJW-OKdQ9L9nkzxY7ujHYwOe?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kitaugetu/works/36", "thumbnail_src": "https://si.imgix.net/82b89825/uploads/origins/feaef188-2363-4ad3-83c9-66d1bc2d1382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bd4495a7080dfc4979482af73352d4e", "thumbnail_srcset": "https://si.imgix.net/82b89825/uploads/origins/feaef188-2363-4ad3-83c9-66d1bc2d1382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bd4495a7080dfc4979482af73352d4e, https://si.imgix.net/82b89825/uploads/origins/feaef188-2363-4ad3-83c9-66d1bc2d1382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39e9c781c80557a5f4526d6070ec0535 2x, https://si.imgix.net/82b89825/uploads/origins/feaef188-2363-4ad3-83c9-66d1bc2d1382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRI