Ccenter&txtsize=30&txt=PRIVATE&s=8a16d6321e0e84eaa43fd6470daa6b3c, https://si.imgix.net/5faa894e/uploads/origins/998fec9a-35f5-4bc2-b17b-85b5840cba9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0af5f17dd4da555b60b2ec43052a98c3 2x, https://si.imgix.net/5faa894e/uploads/origins/998fec9a-35f5-4bc2-b17b-85b5840cba9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e14af90cd017c11b7388f5cc49ec3d68 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/58", "thumbnail_src": "https://si.imgix.net/5ed0f55c/uploads/origins/5b005721-2569-4f5c-bb33-c4371249d2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02fe5b77bb3deeb98829b4752a133f1e", "thumbnail_srcset": "https://si.imgix.net/5ed0f55c/uploads/origins/5b005721-2569-4f5c-bb33-c4371249d2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02fe5b77bb3deeb98829b4752a133f1e, https://si.imgix.net/5ed0f55c/uploads/origins/5b005721-2569-4f5c-bb33-c4371249d2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5c70b225c9f176fe364fd8ddb65f556 2x, https://si.imgix.net/5ed0f55c/uploads/origins/5b005721-2569-4f5c-bb33-c4371249d2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0993d195eae76267cd56448be390a0c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵が好きで、お願いがあります。\n\n私のOC、セレンを描いてもらえませんか？彼女は20歳で、雪の王国の王女です。\n\n穏やかな表情でお願いします。服装やデザインは最初の2枚を参考にしてください。\n\n彼女はフルートを吹くのが好きですが、必ずしもフルートを吹く必要はありません。ポーズは自由ですが、できれば左手の甲のマークが見えるようにしてください。\n\n背景には星と三日月を入れてみてください。\n\nリクエストにお答えいただきありがとうございました。\n\nhttps://imgur.com/a/DB7Xx8O", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/57", "thumbnail_src": "https://si.imgix.net/deb573bc/uploads/origins/3abe56aa-daf3-4bcd-898e-71f145571684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=577160b3b13819edf0e8afa79c57bc40", "thumbnail_srcset": "https://si.imgix.net/deb573bc/uploads/origins/3abe56aa-daf3-4bcd-898e-71f145571684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=577160b3b13819edf0e8afa79c57bc40, https://si.imgix.net/deb573bc/uploads/origins/3abe56aa-daf3-4bcd-898e-71f145571684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=415e379e206eb87f14752e127eb64158 2x, https://si.imgix.net/deb573bc/uploads/origins/3abe56aa-daf3-4bcd-898e-71f145571684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39d78d5c859ce73b8d9441c40f353acb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの古いアニメのアートスタイルが本当に好きです！私のダンジョンズ＆ドラゴンのOCディアドラを描いてください！種族はハーフエルフで年齢は19歳、光の魔法を得意とする魔法の使い手です！服装や大まかなデザイン、肌の色などは7枚目の画像を参考にしてください！ポーズや背景は彼女に似合いそうなものを選んでください！ありがとうございます！Twitter(X)のアカウントで投稿します！\n\nhttps://imgur.com/a/2Njj1Bh", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/56", "thumbnail_src": "https://si.imgix.net/d3401350/uploads/origins/4a75c3d2-810e-4cef-a6df-c43dc0b77543?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0897bafcf6692b449d051fca118a2ad8", "thumbnail_srcset": "https://si.imgix.net/d3401350/uploads/origins/4a75c3d2-810e-4cef-a6df-c43dc0b77543?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0897bafcf6692b449d051fca118a2ad8, https://si.imgix.net/d3401350/uploads/origins/4a75c3d2-810e-4cef-a6df-c43dc0b77543?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e8a68c02e94d18bcfe8bab975fa450c 2x, https://si.imgix.net/d3401350/uploads/origins/4a75c3d2-810e-4cef-a6df-c43dc0b77543?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d485233b00d24144deb0836d88dba69d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアートをとても気に入りました！\n\nキャラクターファイアーエムブレム覚醒のモーガン（参考画像左）。  \n\n衣装：モーガンにルキナの聖なる女王の衣装（参考画像右）を着せてください。  \n\n表情・ポーズ・背景：あとは自由に決めてもらいます。自分がやりやすいものでお願いします。  \n\n重要な情報：\n- モーガンはルキナ（参考画像右の女性）と同じ青い色の髪と目をしていること。  \n- 参考画像の剣と盾も入れてほしい。できれば、盾の後ろに体があまり隠れないようにお願いします。  \n\nより参考になる参考画像やインスピレーションは、私が依頼した過去の例をご覧ください：\nhttps://drive.google.com/drive/u/1/folders/15vlgpWHqhG_XyIYrZw4_dPvMcCHr6Q8s\n\nありがとうございました。\n\nhttps://imgur.com/a/TSAs1uR", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/55", "thumbnail_src": "https://si.imgix.net/14e1c1be/uploads/origins/16108627-738d-4bd9-abb8-41bb38e6f00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f2d014ecc283e91b98f13d32f9a772", "thumbnail_srcset": "https://si.imgix.net/14e1c1be/uploads/origins/16108627-738d-4bd9-abb8-41bb38e6f00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f2d014ecc283e91b98f13d32f9a772, https://si.imgix.net/14e1c1be/uploads/origins/16108627-738d-4bd9-abb8-41bb38e6f00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e9e5d6572a394e1b766ae3077ce0284 2x, https://si.imgix.net/14e1c1be/uploads/origins/16108627-738d-4bd9-abb8-41bb38e6f00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7487b020ab11b183451b7f2f210fac5 3x", "genre": "art", "nsfw": false, "body": "初めまして！アイコス様のイラストは素敵です。私のオリジナルキャラクターのイラストを依頼してもよろしいでしょうか。\n\n【詳細】\n・ライーン、女性、16年、163㎝\n・次元の隙間の間を渡って色んな世界に出会う旅人の少女です。明るくて元気、親切な子です。歌うこととオシャレと花が好きです。目標はそれぞれの世界で人々と魔法の存在と出会い、宝石の花の花びらを集める。\n・髪色は紫がかった黒、目は灰色。やや褐色の肌色は気を付けてください\n・モチーフは花、宝石、音楽\n\n【参考】\nhttps://sta.sh/22215bjob54y\n\nポーズ、構図などはアイコス様にお任せしたいと思います。\n\nご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/54", "thumbnail_src": "https://si.imgix.net/329defb6/uploads/origins/825c9790-5184-4777-9f5e-0c657c34b3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6924c887a34d2858d819886220d3da0d", "thumbnail_srcset": "https://si.imgix.net/329defb6/uploads/origins/825c9790-5184-4777-9f5e-0c657c34b3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6924c887a34d2858d819886220d3da0d, https://si.imgix.net/329defb6/uploads/origins/825c9790-5184-4777-9f5e-0c657c34b3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27fb25f3e80c697e2c029dc7aa9fe3de 2x, https://si.imgix.net/329defb6/uploads/origins/825c9790-5184-4777-9f5e-0c657c34b3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=634d5c27dba00d15876b89ddedd0799d 3x", "genre": "art", "nsfw": false, "body": "こんにちは(^^)、私のオリジナルキャラクター、ローレライのアートを依頼したいのですが。\n\nキャラクターは？\n彼女は若い半吸血鬼の公爵夫人で、バレエダンサーです。  美しく、エレガントで、柔らかく、いつも微妙な微笑みを浮かべている。\nバレエダンサーなので、動きは蝶のように繊細。\nルックスの参考：https://drive.google.com/drive/folders/1-wJ6AhDwfkciKQPuEcSbTEUINTDKhkFf?usp=share_link\n\n構成：\nドレスはきらびやかに、スカートはバレリーナのようにふくらませる。リップとアイシャドウはソフトピンク。髪はロングで重めの密度。顔には2つのほくろがあり、目は猫のよう。\n\n白いバラと蝶が彼女のテーマ。\n\n\n背景が透明/分離したバージョンも欲しいです。\n\nあなたのアートが大好きで、Skebで見つけて嬉しいです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/53", "thumbnail_src": "https://si.imgix.net/f3768f74/uploads/origins/bf5c0410-520b-411d-b1f1-e396d72a59ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2cc55ea32c788be40ce7154671b4e6a", "thumbnail_srcset": "https://si.imgix.net/f3768f74/uploads/origins/bf5c0410-520b-411d-b1f1-e396d72a59ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2cc55ea32c788be40ce7154671b4e6a, https://si.imgix.net/f3768f74/uploads/origins/bf5c0410-520b-411d-b1f1-e396d72a59ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b6cd41ec98d3d3e83cae73d14fcbd58 2x, https://si.imgix.net/f3768f74/uploads/origins/bf5c0410-520b-411d-b1f1-e396d72a59ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83b66ff53515b7ea6323e039b4916670 3x", "genre": "art", "nsfw": false, "body": "Hello. I really enjoy the style of your artwork and would like to make a request, if possible. \n\nPlease draw Ishtar from Fire Emblem. \n\nCharacter References - https://imgchest.com/p/wl7lmarr3yx?grid \n\nAbout - She is royalty, a little complex but compassionate and elegant. \nShe uses thunder magic, due to her unmatched magical power, her title is \"Thunder Goddess\".\n\nThe composition, pose, outfit, and expression of the artwork can be decided by Teacher. \n\nFor helpful references and inspirations, please look at the commissions I've requested before- https://drive.google.com/drive/folders/1IpplGku6q_Ql3hkzTzMnEy_z7BEmGARr", "created_at": "", "completed_at": ""}, {"path": "/@icoooos/works/52", "thumbnail_src": "https://si.imgix.net/188152b4/uploads/origins/b5ec046c-6426-4e8b-b9fa-c0b6b4cbf857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb4800753151d695c8d84072acff116", "thumbnail_srcset": "https://si.imgix.net/188152b4/uploads/origins/b5ec046c-6426-4e8b-b9fa-c0b6b4cbf857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb4800753151d695c8d84072acff116, https://si.imgix.net/188152b4/uploads/origins/b5ec046c-6426-4e8b-b9fa-c0b6b4cbf857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fc129626f70fb158202e95fc42d4262 2x, https://si.imgix.net/188152b4/uploads/origins/b5ec046c-6426-4e8b-b9fa-c0b6b4cbf857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acab230114ca2413f2cb7c4756a8152c 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、また自創作キャラクターのイラストをお願いしたいです。今回は青年キャラになりますがよろしければお願いします！\n\n■キャラクター\n「匿名勇者」\n・20代半ば\n・とある時代で人類最強と謳われた勇者\n・伸び縮みする連接剣の使い手。得意魔法は雷系\n・相当なイケメン、ただし常に周囲を威嚇しているかのような表情\n・あまり喋らない。他人に心を開いていない\nキャラデザ資料はURL先にあります。衣装は多少のアレンジや省略OKです。\nhttps://drive.google.com/drive/folders/1qwjMwcwJcAMkjLDR_3yHy5E827mS-1-s?usp=drive_link\n\n■シチュエーション、構図\n基本的にお任せ致します！\nこのキャラらしい表情としてはツンとした無表情か、やや怒り気味のムスッとした不機嫌顔になります。\n自創作世界観において明確に美男子設定のキャラクターなのでクールな雰囲気だと嬉しいです。\n\nご検討のほど宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1qwjMwcwJcAMkjLDR_3yHy5E827mS-1-s?usp=drive_link", "created_at": "", "completed_at": ""}]}