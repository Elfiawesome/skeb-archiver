0&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=231513a4ab4e535290e56f4f86006c9e 2x, https://si.imgix.net/62f4d98b/uploads/origins/8af526a9-66e0-4b16-8a72-7e3ff04fc846?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=298da1586589f43a1ddde8c7ecde5d69 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/34", "thumbnail_src": "https://si.imgix.net/583e74c9/uploads/origins/cefe088f-911d-49d9-9086-89d290820335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b57acbd28fed7493794e2d5bdef2c8e1", "thumbnail_srcset": "https://si.imgix.net/583e74c9/uploads/origins/cefe088f-911d-49d9-9086-89d290820335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b57acbd28fed7493794e2d5bdef2c8e1, https://si.imgix.net/583e74c9/uploads/origins/cefe088f-911d-49d9-9086-89d290820335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b20e97abe9a174a1fd82a068f999d62 2x, https://si.imgix.net/583e74c9/uploads/origins/cefe088f-911d-49d9-9086-89d290820335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24cfe9a9290641c55a56c7f7783f286c 3x", "genre": "art", "nsfw": true, "body": "艦これの神州丸のイラストをお願いします\n以前描かれた資料URLの本が良かったのでこれの続きのような感じで\n\nシチュエーションとしては\n神州丸が男たちの仲間になって、頭のフード以外は男たちと似たラフな服装だが\nシャツは丈が短く乳房が丸出しで、パンツがチラ見えしている短パンをはいている\n体を触られたり胸を揉まれたりしながら、神州丸は笑みを浮かべているといった感じでお願いします\n可能な範囲で、神州丸が男たちの仲間になったことを喜んだり男たちもそれを受け入れる会話もお願いします\n細かい部分はお任せします。よろしくお願いします\n\nhttps://www.pixiv.net/artworks/110497067", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/33", "thumbnail_src": "https://si.imgix.net/d42a6c9c/uploads/origins/fa8297fc-0625-474d-a69e-3783e360a357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b10d3d5b6434fe0c23636912ec265cf7", "thumbnail_srcset": "https://si.imgix.net/d42a6c9c/uploads/origins/fa8297fc-0625-474d-a69e-3783e360a357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b10d3d5b6434fe0c23636912ec265cf7, https://si.imgix.net/d42a6c9c/uploads/origins/fa8297fc-0625-474d-a69e-3783e360a357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cb0c12c6a8b4def37f061a199a034f0 2x, https://si.imgix.net/d42a6c9c/uploads/origins/fa8297fc-0625-474d-a69e-3783e360a357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d97474f32aa2de3d8ad8e8aa8fea20b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/32", "thumbnail_src": "https://si.imgix.net/a15c98ee/uploads/origins/cf465ba5-4278-4f1c-8d5f-f541868de875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66590d8cdf005adcddfcb8510244e931", "thumbnail_srcset": "https://si.imgix.net/a15c98ee/uploads/origins/cf465ba5-4278-4f1c-8d5f-f541868de875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66590d8cdf005adcddfcb8510244e931, https://si.imgix.net/a15c98ee/uploads/origins/cf465ba5-4278-4f1c-8d5f-f541868de875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47ede19b6b843d1b4ab7f670878dac1a 2x, https://si.imgix.net/a15c98ee/uploads/origins/cf465ba5-4278-4f1c-8d5f-f541868de875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=432d511b2bde998fa963ed2e58e72d9b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/31", "thumbnail_src": "https://si.imgix.net/87500ae5/uploads/origins/bbf22aab-d9ac-4889-a31f-ba79ab579dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3503f3cbda372accea83fecf2f2c139", "thumbnail_srcset": "https://si.imgix.net/87500ae5/uploads/origins/bbf22aab-d9ac-4889-a31f-ba79ab579dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3503f3cbda372accea83fecf2f2c139, https://si.imgix.net/87500ae5/uploads/origins/bbf22aab-d9ac-4889-a31f-ba79ab579dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e02ff6e803f057b8c7948fcdee88c3f8 2x, https://si.imgix.net/87500ae5/uploads/origins/bbf22aab-d9ac-4889-a31f-ba79ab579dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=029c068204a25b8c4e13b5c3fc7c18f6 3x", "genre": "art", "nsfw": true, "body": "1984年にコミックボンボンという児童向け雑誌で連載されていた『ザ・トクサツ\nマン』という作品の「一之瀬留々」ちゃんの「別キャラのコスプレ」をお願いし\nます。\n\n　単行本等無く、ネットにも全くと言っていいほど画像も無く、依頼するにも資\n料が乏しくて大変申し訳ないのですが、こんな感じの女の子です。（ネコミミの\n女の子）\n　㋐ https://twitter.com/dcbiksg/status/1530554459629432832\n　㋑ https://twitter.com/dcbiksg/status/1530555182291234817\n　㋒ https://twitter.com/dcbiksg/status/1530555735448653824\n\n【キャラデザインについて】\n　一之瀬留々：中学1年生。肩幅小さく華奢ながら、力強いバネを実現できるし\nっかりした骨格に女性らしい丸みをもたせた身体、ウエストが無いロリ体型。手\n足が長くスタイル良し。右目の下にほくろ。おっぱいの大きさは膨らみかけ、標\n高は低いが土台面積が広く、スマートな体幹ゆえ胸があるように見える。\n\n【コスプレさせてほしい別キャラについて】\n　バンダイスピリッツのオリジナルガールズプラモデル『30ミニッツシスターズ』\nの『30MS オプションパーツセット18(サージェントコスチューム)[カラーC]』の\n格好をさせてください。\n［資料①］ https://bandai-hobby.net/item/01_5560/\n　①のお腹から腰周りを↓の➁のモデルを参照に≪おへそから腰にかけてヘソ出しし\nてる≫改造お願いします。下が超超ローライズのピッチリ。①の黒い島風パンツみ\nたいなメカパーツはナシで腰周りは全て布製イメージで。\n［資料➁］https://hobby.dengeki.com/news/2663339/2\n　関節はメカでなく、メカ風の意匠をプリントしたタイツ等のイメージで（コス\nプレですから）。\n\n【描いてほしい描写】\n　◆構図：立ち姿の全身。\n　◆表情：下記資料③の表情に口元を歯を見せつつ左右に開いての満面の笑みにし\nてください。\n　◆髪型：原作漫画『ザ・トクサツマン』での髪型のままで。『艦これ』の夕立\nちゃんのような位置に大きな赤い（コスチュームの首元や手首のパーツと同色）\nメカパーツっぽい「リボン」をつけてください。\n　◆衣装：大きく胸の空いた巨乳サイズの乳袋が潰れたりせずそのままの形を保\n持されていて、そのため空洞部分となって膨らみかけおっぱいが丸見えになって\nいる。資料①のプラモの頭頂部についているミミ付き帽子はナシで。\n　◆ポーズ：\n［資料③］ https://x.com/dcbiksg/status/1940402799000568027\n　「腕以外」を、このようなポーズでお願いします。\n　「腕」は、胸の下で軽く（手の平で肘を掴む）組んで、胸が強調されてる感じ\nに。乳袋も持ち上がり、膨らみかけおっぱいに谷間が出来て両乳首は身体に対し\n正面を向いている。\n　◆差分：\n［資料④］　https://store.wacoal.jp/disp/01_CFX370.html\n　おっぱい丸見えに加え、この黒い方のブラをつけている差分をお願いいします。\n　◆背景：暗く見えない赤っぽい黒色単色で。\n\nそれではよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/30", "thumbnail_src": "https://si.imgix.net/0838c5bc/uploads/origins/6a49caea-7c5c-479a-83f4-c90da3e4362e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06614113e1463b866424774cb51e799", "thumbnail_srcset": "https://si.imgix.net/0838c5bc/uploads/origins/6a49caea-7c5c-479a-83f4-c90da3e4362e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06614113e1463b866424774cb51e799, https://si.imgix.net/0838c5bc/uploads/origins/6a49caea-7c5c-479a-83f4-c90da3e4362e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ab82e4980647a45e9c601b8aba48fc8 2x, https://si.imgix.net/0838c5bc/uploads/origins/6a49caea-7c5c-479a-83f4-c90da3e4362e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f94b02f67ae5a2481d05bcb6cc44b8a7 3x", "genre": "art", "nsfw": true, "body": "リクエスト送らせていただきます！\n\nキャラは艦これのグレカーレとマエストラーレをお願いします。\nつるぺた体形で幼い感じでお願いできますでしょうか。\n\nグレカーレ\nhttps://wikiwiki.jp/kancolle/Grecale\n\nマエストラーレ\nhttps://cdn.wikiwiki.jp/to/w/kancolle/Maestrale/::ref/375_Valentine.jpg.webp?rev=cf76d31dbbc94f6143f32a252330f39c&t=20210301224253\n\n服装は全裸にランドセルだけ付けた状態で、\n2人とも肌に水着の日焼け後がある形でお願いを致します。\n\n・シチュエーション\n昼間の公園などで大勢の男たちと乱交。（明るめの場所ならどこでも。）\n\nグレカーレ（構図左）\n身体が少し左斜めに傾いた状態で、\n太ももを掴まれ持ち上げるようにして、アナルに挿入。\n前からは別の男がアソコに挿入。（男の身体は構図外で大丈夫です）\n横合いの男が差し出したペニスを、グレカーレは根本を握りながら手コキフェラ。\nもう片方の手はマエストラーレと合わせるようにピースサイン。\n楽しそうな表情でカメラ目線。\n\nマエストラーレ（構図右）\nグレカーレと左右対称のような形。\n太ももを掴まれ持ち上げるようにして、アナルに挿入。\n前からは別の男がアソコに挿入。\nフェラはイラマチオっぽく突っ込まれて、手は別の男のペニスを手コキ。\nもう片方の手はグレカーレと合わせるようにピースサイン。\n楽しそうな表情でカメラ目線。\n\n女の子2人がメインでアップ目に描写していただけると嬉しいです。\n\n可能であれば、以下の差分をお願い致します。\n・射精\n・事後に各穴から精液が溢れながらにっこり笑顔\n・再度挿入でレイプ目\n\n構図的に厳しそうな描写があれば、ある程度好きにしていただいて大丈夫です。\n\nご検討下さい。よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/29", "thumbnail_src": "https://si.imgix.net/254bc716/uploads/origins/a1e3016d-bae6-423e-97f1-97d5cb76fbfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4bbbfe2db9195a4fcf1ae5dd4faf65", "thumbnail_srcset": "https://si.imgix.net/254bc716/uploads/origins/a1e3016d-bae6-423e-97f1-97d5cb76fbfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4bbbfe2db9195a4fcf1ae5dd4faf65, https://si.imgix.net/254bc716/uploads/origins/a1e3016d-bae6-423e-97f1-97d5cb76fbfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20eca36760c7e7890fb0d91cc2434d94 2x, https://si.imgix.net/254bc716/uploads/origins/a1e3016d-bae6-423e-97f1-97d5cb76fbfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ba67863474ebea9ecfa0ea374d2c764 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n前回は、ヴェールヌイのリクエストを受けていただきましてありがとうございます。\n\n新たなリクエストなのですが、前回の続きということで、\n\n【ヴェールヌイが提督にお願いされて、パンツコキで精液まみれになった下着を穿いたあと「流石にこれは…….恥ずかしいな」と顔を紅くしながら、スカートをたくし上げて見せてくれる】\n\nというシチュエーションのイラストをお願いします。\n\n構図は提督目線でヴェールヌイの正面にしゃがんで、下から見上げるイメージでお願いします。\nまた、下着から精液が少し溢れて、太ももに垂れている描写があると嬉しいです。\n\nもし可能であれば以下の差分をお願いします。\n\n①提督に精液塗れの下着の上から愛撫される(描写は手のみでOKです)\n\n②愛撫されてびっくりする、必死に声を抑える、我慢できず絶頂、快楽で呆けてしまうの各種表情\n\n色々注文が多くて申し訳ありません。受けて頂ければ幸いです\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/28", "thumbnail_src": "https://si.imgix.net/065cd22d/uploads/origins/da303db9-60ee-43a7-904b-cd669775034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53edaaec4f5b0115d72418dfbd066c54", "thumbnail_srcset": "https://si.imgix.net/065cd22d/uploads/origins/da303db9-60ee-43a7-904b-cd669775034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53edaaec4f5b0115d72418dfbd066c54, https://si.imgix.net/065cd22d/uploads/origins/da303db9-60ee-43a7-904b-cd669775034f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d46dc0f3d4e41ab57daab81e776f759 2x, https://si.imgix.net/065cd22d/uploads/origins/da303db9-60ee-43a7-904b-cd669775034f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb633ff45d71ff9de5fad8684393940a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/27", "thumbnail_src": "https://si.imgix.net/c17a085a/uploads/origins/e17b05a7-c6ea-44ba-b8d1-89655b8be068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b691727e9d5700ba110cbd6c46b0e84d", "thumbnail_srcset": "https://si.imgix.net/c17a085a/uploads/origins/e17b05a7-c6ea-44ba-b8d1-89655b8be068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b691727e9d5700ba110cbd6c46b0e84d, https://si.imgix.net/c17a085a/uploads/origins/e17b05a7-c6ea-44ba-b8d1-89655b8be068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=decc8ebbcead047c025182d1335b1455 2x, https://si.imgix.net/c17a085a/uploads/origins/e17b05a7-c6ea-44ba-b8d1-89655b8be068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8835f87759ec139794f410d8c316187c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/26", "thumbnail_src": "https://si.imgix.net/dfc8ace0/uploads/origins/ce5bf169-21fd-4dc2-bac2-83928ea23456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5b847d6bd84b83e937339774d62470", "thumbnail_srcset": "https://si.imgix.net/dfc8ace0/uploads/origins/ce5bf169-21fd-4dc2-bac2-83928ea23456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5b847d6bd84b83e937339774d62470, https://si.imgix.net/dfc8ace0/uploads/origins/ce5bf169-21fd-4dc2-bac2-83928ea23456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e215462ef46b5af20bbe9f30c446b6fd 2x, https://si.imgix.net/dfc8ace0/uploads/origins/ce5bf169-21fd-4dc2-bac2-83928ea23456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c28e3aa3652cc0239c9b8ec927dbe49 3x", "genre": "art", "nsfw": true, "body": "先日はありがとうございました。\n再度お願いしたいと思います。\n\n・艦これの村雨\n・以前お願いしたこちら（https://skeb.jp/@makinaa00/works/14）の続きでシャワールームでべろちゅーしながらお互いに愛撫してるシチュエーションをお願いします。\n\n以上になります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/25", "thumbnail_src": "https://si.imgix.net/74b9d7ad/uploads/origins/787518d6-a4bd-44e7-9446-81560f0e8652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d242f30b45512bea4a45fec7c27d0b", "thumbnail_srcset": "https://si.imgix.net/74b9d7ad/uploads/origins/787518d6-a4bd-44e7-9446-81560f0e8652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d242f30b45512bea4a45fec7c27d0b, https://si.imgix.net/74b9d7ad/uploads/origins/787518d6-a4bd-44e7-9446-81560f0e8652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59f5585808719e93ed01e036fbdd0f36 2x, https://si.imgix.net/74b9d7ad/uploads/origins/787518d6-a4bd-44e7-9446-81560f0e8652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5523d65f2ed7665f12e733a9428aba09 3x", "genre": "art", "nsfw": true, "body": "オタク達の童貞を卒業させるグレカーレ\n\nクロッキー方式でお願いします\n左半分\n竿に囲まれている\n背後から両膝を持ち上げられ中出しされながら左右の竿を扱き全身ぶっかけされるグレカーレ\n表情\n片目ウインク笑顔\n竿役は竿、手、スマホのみでも可\n\n右上\nオタクに種付けプレス、ディープキスされながら中出し\n上から見た構図\n竿役は透明で輪郭のみ、若しくは竿と手のみ\n\n\n右下\n騎乗位中出しされながら両手で竿を扱き右竿をフェラ\n騎乗位の竿役以外は竿のみでも可\n\n服装は全裸\n髪は通常時のものでお願いします\n\n\n厳しければ左半分の所のみでも構いません\n\nhttps://kcwiki.blog.fc2.com/blog-entry-414.html\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/24", "thumbnail_src": "https://si.imgix.net/5d1e0863/uploads/origins/d99ac13c-9977-4fb0-b694-dbe4ab29aa43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db8589ecdcf2fdc70b45cbbf358348e6", "thumbnail_srcset": "https://si.imgix.net/5d1e0863/uploads/origins/d99ac13c-9977-4fb0-b694-dbe4ab29aa43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db8589ecdcf2fdc70b45cbbf358348e6, https://si.imgix.net/5d1e0863/uploads/origins/d99ac13c-9977-4fb0-b694-dbe4ab29aa43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cff20f2e4085bd97097f4214b3422a4e 2x, https://si.imgix.net/5d1e0863/uploads/origins/d99ac13c-9977-4fb0-b694-dbe4ab29aa43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33ebc9127d753bca32e75558174e4a8e 3x", "genre": "art", "nsfw": true, "body": "キャラ\n艦これ\nサラトガ\n\n白コートの中でショタに抱きつかれ中出しされる\n中出しした精液が膣から溢れ地面に垂れ地面に精液溜まり\n白コートは陰と輪郭のみで中が見える様に\n\nサラトガ\n汗だく\n白コートはサラトガ改二のもの\n白コートの下はガーターソックスのみ\n\nショタをハグしている\nショタの頭の後ろに右手\nショタの尻を左手\n\nガニ股(逆駅弁体位\n参考\nhttps://www.pixiv.net/artworks/109477042\n厳しければ座っているものでも構いません\n参考\nhttps://skeb.jp/@se_kitaku/works/7\n\nショタの足はコートからはみ出ていても可能\n白コートはサラトガ改二のもの\n白コートの下はガーターソックスのみ\n\n可能であればショタも濃い陰と輪郭のみにしてサラトガの身体が見える差分をお願いします\n\nよろしくお願いします\n\nhttps://blog-imgs-112-origin.fc2.com/k/c/w/kcwiki/No345_2_CD.jpg", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/23", "thumbnail_src": "https://si.imgix.net/4e261365/uploads/origins/a88ab347-9e66-4744-badc-e4c37b06645a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9e023e72419fb383d242b0048b9895", "thumbnail_srcset": "https://si.imgix.net/4e261365/uploads/origins/a88ab347-9e66-4744-badc-e4c37b06645a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9e023e72419fb383d242b0048b9895, https://si.imgix.net/4e261365/uploads/origins/a88ab347-9e66-4744-badc-e4c37b06645a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b233e20c6b38c4a786397b62e254ed9e 2x, https://si.imgix.net/4e261365/uploads/origins/a88ab347-9e66-4744-badc-e4c37b06645a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d90d200942b35998a033aacfbe3199e 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\n艦これのR-18イラストで「ヴェールヌイにパンツコキをしてもらう」をお願いします。\n\nヴェールヌイの表情は、普段通りにクールを装いながらも、少し興奮している様子\n\nパンツのデザインは白と水色の縞パン\n\nパンツコキはクロッチを亀頭に被せて手コキするタイプ\n\nヴェールヌイは上下共に着衣\n\n体勢はヴェールヌイが提督の正面に座り込んでる姿勢でお願いします。\n\n可能であれば、カウパー液でのパンツ濡れ差分と射精差分があるとありがたいです。\n色々注文が多くて申し訳ありませんが、受けていただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/22", "thumbnail_src": "https://si.imgix.net/66563721/uploads/origins/18b55683-4ecd-43b3-82c9-6312bbb4fc99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c595e7ac2945675dc3793b80ba38cd61", "thumbnail_srcset": "https://si.imgix.net/66563721/uploads/origins/18b55683-4ecd-43b3-82c9-6312bbb4fc99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c595e7ac2945675dc3793b80ba38cd61, https://si.imgix.net/66563721/uploads/origins/18b55683-4ecd-43b3-82c9-6312bbb4fc99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec95d39713ee7fe9b83f1d34f93f346e 2x, https://si.imgix.net/66563721/uploads/origins/18b55683-4ecd-43b3-82c9-6312bbb4fc99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fba98343855cef0f05ffbc7ae14ecb1 3x", "genre": "art", "nsfw": true, "body": "1984年にコミックボンボンという児童向け雑誌で連載されていた『ザ・トクサツマン』という作品の「一之瀬留々」ちゃんの「別キャラのコスプレ」をお願いします。\n\n　単行本等無く、ネットにも全くと言っていいほど画像も無く、依頼するにも資料が乏しくて大変申し訳ないのですが、こんな感じの女の子です。（ネコミミの女の子）\n　㋐ https://twitter.com/dcbiksg/status/1530554459629432832\n　㋑ https://twitter.com/dcbiksg/status/1530555182291234817\n　㋒ https://twitter.com/dcbiksg/status/1530555735448653824\n\n【キャラデザインについて】\n　一之瀬留々：中学1年生。肩幅小さく華奢ながら、力強いバネを実現できるしっかりした骨格に女性らしい丸みをもたせた身体、ウエストが無いロリ体型。手足が長くスタイル良し。右目の下にほくろ。おっぱいの大きさは膨らみかけ、標高は低いが土台面積が広く、スマートな体幹ゆえ胸があるように見える。\n\n【コスプレさせてほしい別キャラについて】\n　1987年に発売されたロッテの食玩『ネクロスの要塞』に登場する敵キャラ「マジョロス」の衣装を後述のように改造させたものを着せてほしいです。\nhttps://twitter.com/dcbiksg/status/1751150225631449419\n　（※ ステッキやベルトバックルなどフィギュアとイラストでデザインが違うところがありますが、イラストのデザイン優先でお願いします。）\n\n【改造してほしいポイントなど】\n　① 顔の右半分が青いのはナシで。全面留々ちゃんの顔で。\n　➁ 上半身をスリングショット風のブラに変更してください、股間ではなく胸元の五芒星デザインの金具につけて。五芒星から出てる首まわりの襟は残して別個につけて下さい。目と口の模様はナシで、肩や胸は素肌（肌色）です。ブラは後述⑥のカラー・水色で。\n　③ 網タイツは、この↓画像イメージの、目の粗い網タイツ、丈はヒザ下まで。マジョロスは青い靴下＋網タイツみたいなデザインですが、「生足＋網タイツ」で。靴はバレエシューズの爪先をカールさせたもので。\nhttps://www.amiami.jp/top/detail/detail?scode=FIGURE-164274&page=rt_11\n　④ マントデザインはマジョロスのまんまで。背中側から両方の二の腕に襟状のパーツとともに巻き付けて垂らし、お腹側に巻き付けベルトで締めてスカートにしている感じ。このときマントを腰の両脇から➁のブラ中央の五芒星につなげるているように再現お願いします。（お気に入りポイントなので）\n　⑤ ぱんつ、穿いてるかどうか曖昧に。\n　⑥ 衣装全体のカラーリングは青と赤から、女の子らしい「パステルカラーの水色とピンク」に変更してください。\n\n【描いてほしい描写】\n　構図：立ち姿の全身。\n　表情：画像㋐の2枚目のぶち抜き「あは」のコマみたいなちょっと照れた感じ。（珍しく女の子らしく扱ってもらえてうれしそう、みたいな。）\n　ポーズ：\nhttps://img.amiami.jp/images/product/review/234/FIGURE-164180_05.jpg\n　このようなポーズでお願いします、ホウキにまたがる魔女のイメージで。ステッキのコウモリデザインの部分がこっち。\n　ポーズ変更点：画像では膝立ちですが、伸ばした足で立っているポーズに。右足のみで立っていて左足はピンと伸ばして浮遊感を出して欲しいです。両手の人差し指をピンと立ててマジョロスらしく。\n　背景：マジョロスのイラストみたいな星空。周囲が白いのも同様に。\n\nそれではよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/21", "thumbnail_src": "https://si.imgix.net/f20c02fd/uploads/origins/501e25a9-53e0-4b6d-bca6-206ac1fb5db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d715c59b98b34b691ca0f1b13f6e697d", "thumbnail_srcset": "https://si.imgix.net/f20c02fd/uploads/origins/501e25a9-53e0-4b6d-bca6-206ac1fb5db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d715c59b98b34b691ca0f1b13f6e697d, https://si.imgix.net/f20c02fd/uploads/origins/501e25a9-53e0-4b6d-bca6-206ac1fb5db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9577fd22322765d400e6a606d57a62e6 2x, https://si.imgix.net/f20c02fd/uploads/origins/501e25a9-53e0-4b6d-bca6-206ac1fb5db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad467b934de454f43931d98925c05b56 3x", "genre": "art", "nsfw": true, "body": "艦これのGrecale(グレカーレ)とCappellini(カッペリーニ)に乳首を弄られながらW手コキをされているところをお願いします。\n\n衣装は二人ともハロウィンmode\n\n構図のイメージは、下記の作品を参考にしてください\nhttps://skeb.jp/@marumat_range/works/25\n\n可能な限り下記の内容を盛り込んでほしいです。\n\nグレカーレ\n・ニヤニヤしながら指で乳首を弄りながら手コキ\n・グレカーレは提督を弄ぶような感じ\n・提督を煽るようなセリフ(例：テートク、乳首でも気持ちよくなっちゃってるんだ？　やだぁ、かわいい♪)\n\nカッペリーニ\n・上目遣いで乳首を舐めながら手コキ\n・カッペリーニは性的なことはあまり知らず提督が喜んでそうだからしてあげている感じ\n・提督に気持ちいいか確かめるようなセリフ(例：提督さんよー、ここ舐められると気持ちいいのか？いいお！もっとやったげる！！)\n\nセリフは上記のようなイメージのものなら何でも構いません。\n\n射精後二人が白濁液まみれになる差分もお願いしたいです。\n\n上記以外はお任せします。\n描きにくい部分は描きやすいようアレンジしていただいて構いません。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/20", "thumbnail_src": "https://si.imgix.net/a111e12c/uploads/origins/22e2e003-dc31-4b24-905c-55a95e45319f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e99863b1988b8b26ca79f70bb1d5c120", "thumbnail_srcset": "https://si.imgix.net/a111e12c/uploads/origins/22e2e003-dc31-4b24-905c-55a95e45319f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e99863b1988b8b26ca79f70bb1d5c120, https://si.imgix.net/a111e12c/uploads/origins/22e2e003-dc31-4b24-905c-55a95e45319f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ced4f2c989306b152c6a3b6e5fe6c8ec 2x, https://si.imgix.net/a111e12c/uploads/origins/22e2e003-dc31-4b24-905c-55a95e45319f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac5eed808045979176b12e24a9cd438a 3x", "genre": "art", "nsfw": true, "body": "キャラクター 艦隊これくしょん　夕雲改二\n状況　　輪姦\n\n服装は　金剛改二丙　\n\n髪型、髪飾りは服装に合わせず元のキャラクターのもの\n\n胸元がはだけブラがずらされての胸の露出と局部への下着ずらし挿入をお願いします　下着のデザインはセクシーな感じでお願いします\n\n挿入は膣 膣と肛門のいずれかであり、他の男性器は手に握らせられていたり顔や体の周りにあったりをお願いします（他の男性器は～の部分は構図的に難しいようならかまいません）\n\n表情は輪姦を前提としたもので大きな涙を流しながら泣き叫んでおり、差分として各レイヤー別で睨み顔、レイプ目で涙を流している無表情顔、無理やりイカされてしまった最中の顔、口内に男性器を挿入されて苦しんでいるような絵をお願いします\n\n強姦される際に殴られた赤い痣を口元に付けてください(痣の大きさははあまり大きくはないですがハッキリ分かるくらいに）\n\n片方の胸には力任せに揉みしだかれて全体的に赤くなった跡を\n\n揉みしだかれた側の胸の乳首,乳輪は強く噛まれて真っ赤に（噛み跡はいりません）\n\n差分として各レイヤー別で全ての竿、竿役が消えた状態と、顔や胸の痣、乳首と乳輪の変色がない差分、パンツを履いている状態(挿入されておらず正しく着用している状態です）の差分が欲しいです\n\n構図的に無理なく入りそうなら右手薬指に指輪を嵌めてください　無理そうなら嵌めなくても大丈夫です　　嵌める場合右手の衣装は要りません\n\n構図の邪魔になり体が隠れるようなら竿役は半透明\n\n陰毛はなし\n\n構図、体位はお任せしますがどのような形であれ顔と胸と挿入部が良く見えるように　　 構図、体位的に難しければ別カット　断面図などをお願いします\n　\n画面サイズ3840×2160の16：9かそれに近いサイズの横長\n\nPSDでの納品\n\n金額面などでの不都合があれば再送お願いします", "created_at": "", "completed_at": ""}, {"path": "/@makinaa00/works/19", "thumbnail_src": "https://si.imgix.net/82b4cd57/uploads/origins/849c1019-8115-43ed-8713-d6904dac1a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=403891e0ade0c5b354cc30e9f608911e", "thumbnail_srcset": "https://si.imgix.net/82b4cd57/uploads/origins/849c1019-8115-43ed-8713-d6904dac1a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=403891e0ade0c5b354cc30e9f608911e, https://si.imgix.net/82b4cd57/uploads/origins/849c1019-8115-43ed-8713-d6904dac1a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a61a896c87cf160889edbd8e4c08c1db 