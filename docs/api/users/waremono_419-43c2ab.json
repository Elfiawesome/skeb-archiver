b466-10cd8d729c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b8040daaf0f289f873ae6255aee278, https://si.imgix.net/e2113ce4/uploads/origins/3bbe8651-a7ac-4b60-b466-10cd8d729c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=829aa710333b8274a0ed816a465459c0 2x, https://si.imgix.net/e2113ce4/uploads/origins/3bbe8651-a7ac-4b60-b466-10cd8d729c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc297085792bbbb013718606ca34bc97 3x", "genre": "comic", "nsfw": false, "body": "前回素晴らしいイラストを描いていただきありがとうございました。\n\n再度リクエストさせていただきたいと思います\n前回と同じく自キャラの変化絵をお願いしたいです\n\n・自信満々の顔で挑みその顔のまま白い粘土に変化させられ、顔以外をカマキリに作り直され色付けされ展示されてしまう\n\n検討のほどよろしくお願いします\n\nhttps://pbs.twimg.com/media/FCjWFfbUUAIq3lI?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/121", "thumbnail_src": "https://si.imgix.net/04a08883/uploads/origins/fbf4cb05-f133-415d-b65a-99159864f885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5dd2510fc72020ec6e8d99edcd39683", "thumbnail_srcset": "https://si.imgix.net/04a08883/uploads/origins/fbf4cb05-f133-415d-b65a-99159864f885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5dd2510fc72020ec6e8d99edcd39683, https://si.imgix.net/04a08883/uploads/origins/fbf4cb05-f133-415d-b65a-99159864f885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f098238b0c939860acf3a0e46c606cb 2x, https://si.imgix.net/04a08883/uploads/origins/fbf4cb05-f133-415d-b65a-99159864f885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ecd3451edd27ff5d74edd1954ff64f8 3x", "genre": "art", "nsfw": true, "body": "初リクエストです。\nラグナドールの､のっぺらぼう(着衣のまま)が強制的に踊らされている状態のイラストを依頼したいです。\n\n悔しそうな表情で「身体が勝手に」や「油断した」等の抵抗している台詞でお願いします。\n\nまた､もし可能であれば､踊りの虜になりハート目で踊る差分付きでご検討の程宜しくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/120", "thumbnail_src": "https://si.imgix.net/14c15542/uploads/origins/c457d7e2-20d9-4305-8287-09fd8dfc2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f733d81a9ff5f63bd55234f96c87235", "thumbnail_srcset": "https://si.imgix.net/14c15542/uploads/origins/c457d7e2-20d9-4305-8287-09fd8dfc2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f733d81a9ff5f63bd55234f96c87235, https://si.imgix.net/14c15542/uploads/origins/c457d7e2-20d9-4305-8287-09fd8dfc2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94dbb89c430d1ce3d8c0c81c465d28c2 2x, https://si.imgix.net/14c15542/uploads/origins/c457d7e2-20d9-4305-8287-09fd8dfc2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4bfe56831bb231074222465db99671e 3x", "genre": "art", "nsfw": true, "body": "以前の作品の新規差分とその前日端的な新規イラストで即堕ち二コマ的作品を制作していただけるでしょうか？\n一コマ目は敵の本拠地で敵に対して見栄を切るぴっちりスーツを着たフェリアさんを正面から全身を映したものでお願いします。ポーズはこちらの二枚目のものでお願いします　https://www.pixiv.net/artworks/127377237\n二コマ目はこちらの作品 https://www.pixiv.net/artworks/119686790 の二枚目の改変で表情のみを快楽堕ちした感じに変更したもの（目と口は開いている感じでお願いします）をお願いします。\n\nhttps://www.pixiv.net/artworks/119686790", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/119", "thumbnail_src": "https://si.imgix.net/6540da5d/uploads/origins/9fbf8642-b4ef-49ed-ac0c-1c609ef79068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f6d8e80ab161099efbe78d0751e4eb", "thumbnail_srcset": "https://si.imgix.net/6540da5d/uploads/origins/9fbf8642-b4ef-49ed-ac0c-1c609ef79068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f6d8e80ab161099efbe78d0751e4eb, https://si.imgix.net/6540da5d/uploads/origins/9fbf8642-b4ef-49ed-ac0c-1c609ef79068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=348c920f43f1af6e03468310a9e7d974 2x, https://si.imgix.net/6540da5d/uploads/origins/9fbf8642-b4ef-49ed-ac0c-1c609ef79068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81811fd49d5b219691c5c5fdb19b065f 3x", "genre": "art", "nsfw": true, "body": "黒工房さんの宝来琉煌ちゃんと狼跡雷佳ちゃんが2人仲良く黄昏ルガルガンスウツをきていわゆる「服従のポーズ」をとっている絵を描いて欲しいです。\n2人は敵に敗北してとっ捕まってしまって、黄昏ルガルガンスウツを着せられて調教されていくうちに2人共折れてしまい、最早抵抗する気力も無くなりただただペットの様に振る舞っている、といったシチュエーションでお願いします。\n室内でブルーシートが敷かれていて、2つのご飯皿も置かれていて欲しいです。\nマスクやレンズやレンズ透過の有無といった差分も欲しいです。\nどうかご検討の方よろしくお願いします。\n\nhttps://drive.google.com/file/d/1GE7WlruIlnRK9u7BXNHCm2xhwkttdnu9/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1s1uDER1Ke2mIlZzabQh4rWutDH_11N9N/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1l5qpvE-vmFTOPzNuE79u7uJjRgVat4E0/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/118", "thumbnail_src": "https://si.imgix.net/c66ce9a0/uploads/origins/a20eb3aa-d49a-4776-bbdd-6ad88fd10802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bff2a7d8a1a882a9b41d635214b27cd", "thumbnail_srcset": "https://si.imgix.net/c66ce9a0/uploads/origins/a20eb3aa-d49a-4776-bbdd-6ad88fd10802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bff2a7d8a1a882a9b41d635214b27cd, https://si.imgix.net/c66ce9a0/uploads/origins/a20eb3aa-d49a-4776-bbdd-6ad88fd10802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e6f084d1ba1ad31d99a18b09e8d0882 2x, https://si.imgix.net/c66ce9a0/uploads/origins/a20eb3aa-d49a-4776-bbdd-6ad88fd10802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e44df3bbc7733c250130d93ceada29a 3x", "genre": "art", "nsfw": true, "body": "特務兵ファリアがある屋敷で置物兼門番としてライオンの顔出し着ぐるみを着て門の前に犬座りをしているシチュをお願いします。\n内容としては、ファリアの仲間が屋敷へ向かう。そこには着ぐるみをきたファリアが座っていた。近づくと「誰だ貴様は」と警戒されている様子。迎えにきたことを伝えると、「何を言う。私は生まれてからずっとここで門番をしていたのだ。貴様らなど知らん」と拒絶する。\n・そんな中、屋敷の主人が現れ、ファリアは「ご主人様おかえりないませ」と目をハートににさせてとても嬉しそうだった。「ファリア、このまま門番を頑張ります！ガオーン！」と鳴き真似をする程であった。\n以上です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/117", "thumbnail_src": "https://si.imgix.net/2a18ed64/uploads/origins/e3a4b167-82ce-4448-bfa3-4c6e8ec7176f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89ecb5b038b797bd6e79e79648176ff", "thumbnail_srcset": "https://si.imgix.net/2a18ed64/uploads/origins/e3a4b167-82ce-4448-bfa3-4c6e8ec7176f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89ecb5b038b797bd6e79e79648176ff, https://si.imgix.net/2a18ed64/uploads/origins/e3a4b167-82ce-4448-bfa3-4c6e8ec7176f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68b449cde643fc05ec669e975d8ef46c 2x, https://si.imgix.net/2a18ed64/uploads/origins/e3a4b167-82ce-4448-bfa3-4c6e8ec7176f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb780905318f91675faa78d618a3c5a4 3x", "genre": "comic", "nsfw": true, "body": "初めまして\n自キャラの変化絵を描いて頂きたくリクエストを送らせて頂きました。\n\n・頭はそのままで体を蛇に改造、洗脳されたのち全身を使ってフェラチオしている\n\n検討の程よろしくお願いいたします。\n\nhttps://pbs.twimg.com/media/FCjV7T2VEAY_d4M?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/116", "thumbnail_src": "https://si.imgix.net/6b56f324/uploads/origins/5be71e67-3622-4393-8454-7188ae2b5814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=436ee5f136a17bc446cbeb03e4118452", "thumbnail_srcset": "https://si.imgix.net/6b56f324/uploads/origins/5be71e67-3622-4393-8454-7188ae2b5814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=436ee5f136a17bc446cbeb03e4118452, https://si.imgix.net/6b56f324/uploads/origins/5be71e67-3622-4393-8454-7188ae2b5814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93443ceb1a73b85b49bfebc134047ce7 2x, https://si.imgix.net/6b56f324/uploads/origins/5be71e67-3622-4393-8454-7188ae2b5814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=131fec47e246cb11029e247b537c5201 3x", "genre": "art", "nsfw": true, "body": "初めまして、いつも応援しています。\nフェリアがシャチの顔出し着ぐるみを飼育員怪人（特務兵フェリアに登場）に無理やり着せられて、フェラチオ芸をするシチュを希望します。着ぐるみは、特務兵フェリアのものと同様に、シャチの腹部から顔を出しているものでお願いします（別添URL）。また、イラストのアングルは顔が良く見えるように、斜め顔でお願いします。\nシチュは下記で考えておりますが、基本的にはお任せしたいと思います。\n\n■シチュ（案）\n①フェリアが着ぐるみを着せられたことに憤慨する。飼育員怪人にフェラチオ芸をするように言われ、”誰がお前の言うことを聞くものか”みたいなことを言って抵抗する。\n②着ぐるみに操られて、舌で最後の抵抗をしつつも、やりたくもないフェラをしてしまう。\n③最初は、嫌々フェラをしていたものの、段々と快楽に溺れてしまう。\n\n　もし、可能であれば、無抵抗な仰向けの姿勢で、ご褒美のフェラを欲しがるようなシチュを入れて頂けると嬉しいです。\n\nご検討の程よろしくお願いいたします。\n\nhttps://x.com/kig_kaodashi/status/1251875699473870848?lang=ar", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/115", "thumbnail_src": "https://si.imgix.net/8db3dea2/uploads/origins/9a02caca-974a-4170-bcd3-21b7caad7cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bffcfc7021ba00d878d1959b1130719", "thumbnail_srcset": "https://si.imgix.net/8db3dea2/uploads/origins/9a02caca-974a-4170-bcd3-21b7caad7cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bffcfc7021ba00d878d1959b1130719, https://si.imgix.net/8db3dea2/uploads/origins/9a02caca-974a-4170-bcd3-21b7caad7cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=174033b44be6e29ff8a652bd6e23b905 2x, https://si.imgix.net/8db3dea2/uploads/origins/9a02caca-974a-4170-bcd3-21b7caad7cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d095051182ee18f3c877abae19de5ea7 3x", "genre": "comic", "nsfw": true, "body": "リクエスト失礼します。\n長い黒髪の女性の頭から下がタコの触手に変化している漫画をお願いしたいです。\n・モンスターの設定\nタコ型で体内に取り込んだ女性を人の意識を残したまま触手の先にジンメンのように取り込み、生き餌として獲物を誘う習性、、みたいな感じです。\n・漫画の内容\n①水面から女性の顔だけが出てきており外部の人からはモンスターがいると気づけない状況。\n女性はこれ以上被害者が出ないように「私のことは気にしないで、早く逃げなさい」と伝えるも頭部から下の触手部分が徐々に水面から出てきて\n②自分の意志とは裏腹に触手は横に振り回され女性は涙ぐみ悲鳴を上げながら、自分はもう助からないから再度逃げるよう伝えている\n、、みたいなシチュでお願いしたいです。よろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/114", "thumbnail_src": "https://si.imgix.net/1ce9974c/uploads/origins/b6dc7a24-70b8-4b15-83d1-a3386e38e6c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addb6e81c17009bf2b7cd2a13c01bed4", "thumbnail_srcset": "https://si.imgix.net/1ce9974c/uploads/origins/b6dc7a24-70b8-4b15-83d1-a3386e38e6c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addb6e81c17009bf2b7cd2a13c01bed4, https://si.imgix.net/1ce9974c/uploads/origins/b6dc7a24-70b8-4b15-83d1-a3386e38e6c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=049b8c817573a25560abc1ddeaa60497 2x, https://si.imgix.net/1ce9974c/uploads/origins/b6dc7a24-70b8-4b15-83d1-a3386e38e6c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd6600d7668ce99b75da8a053d5b110 3x", "genre": "art", "nsfw": true, "body": "前回も素敵なイラストありがとうございました。\n \n再度リクエストさせていただきます。 \n \nキャラクターは前回と同じくポケットモンスターのジーナで同じ衣装でお願いします。\n \n表情は顔を赤らめてほしいです。\n \n下記URLはフラジィルさんに描いて頂いたイラストです。 \n \nhttps://skeb.jp/@waremono_419/works/96\n \n上記URLのようなガラスでコーティングをお願いします。\n \n差分で結晶化とチョコ化もお願いしたいです。\n \n胸の谷間やおへそやふとももがみえるようにしてほしいです。\n（乳◯をみえるようにしてほしいという意味ではございません）\n \n下記のフラジィルさんの描いたイラストのようなポーズで全身を描いてほしいです。\n \nhttps://www.pixiv.net/artworks/78610449#big_0\n \n可能なら上記のポーズでお願いしたいです。\n \nまたはこちらのポーズでお願いします。\n \nhttps://www.pixiv.net/artworks/66743101\n \nどちらかのポーズで全身を描いていただきたいです。\n \nやりやすいように変更していただいて大丈夫です。おまかせいたします。\n \n前回のイラストの、効果音やエフェクトや表情もすごくよかったです。\n \nポーズ以外は前回と同じとお考えいただいて大丈夫です。\n \n可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/113", "thumbnail_src": "https://si.imgix.net/057a59f0/uploads/origins/412d7ba7-f9f6-4adb-965f-401c77c2f4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32acf1518f802ddb7759d6830187511a", "thumbnail_srcset": "https://si.imgix.net/057a59f0/uploads/origins/412d7ba7-f9f6-4adb-965f-401c77c2f4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32acf1518f802ddb7759d6830187511a, https://si.imgix.net/057a59f0/uploads/origins/412d7ba7-f9f6-4adb-965f-401c77c2f4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0af011f408ddef5e053de551aee53b8 2x, https://si.imgix.net/057a59f0/uploads/origins/412d7ba7-f9f6-4adb-965f-401c77c2f4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b77eb86e07d8665028ccf0c53723be8 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです！\nうちの子Cちゃんの石化や粘土コスプレイ絵を依頼してお願いします。\n彼女が罠に捕まった、体が強制ポーズに石化した（ポーズはこう:https://assets.clip-studio.com/ja-jp/detail?id=2071084）。顔が驚かされていた、出来れば笑顔の差分もお願いします！\nそしてその状態で衣服を砕かれて、粘土の旧スク水ネコミミのコスプレとエロチア服に強制着せられた！\nCの参考はこちら: https://www.pixiv.net/artworks/119401151\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/112", "thumbnail_src": "https://si.imgix.net/6e206fba/uploads/origins/146d0e43-db1f-47cb-851c-86d2b0008d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d68a3d7d005bdf59d78e806023922a69", "thumbnail_srcset": "https://si.imgix.net/6e206fba/uploads/origins/146d0e43-db1f-47cb-851c-86d2b0008d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d68a3d7d005bdf59d78e806023922a69, https://si.imgix.net/6e206fba/uploads/origins/146d0e43-db1f-47cb-851c-86d2b0008d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34bec868f50af51701a0ba9b40da56a 2x, https://si.imgix.net/6e206fba/uploads/origins/146d0e43-db1f-47cb-851c-86d2b0008d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b61375fa7da10ac66d386623400fd48c 3x", "genre": "art", "nsfw": true, "body": "新年あけましておめでとうございます。\n年明けいきなりの依頼になりますが黒工房さんの狼跡　雷佳ちゃん(https://drive.google.com/file/d/1s1uDER1Ke2mIlZzabQh4rWutDH_11N9N/view?usp=drivesdk , https://drive.google.com/file/d/1l5qpvE-vmFTOPzNuE79u7uJjRgVat4E0/view?usp=drivesdk ,\nhttps://x.com/Black_atelier09/status/1485546879794376705)がジャローダスウツを着せられた状態で身じろぎしてる絵をお願いしたいです。\n室内で床にはスウツの箱や接着剤、研磨剤といったものが置いてあって欲しいです。\nマスク無し、マウスエントリー、レンズ無し、レンズ半透明、レンズ不透明、顔に接着剤が付着した状態といった差分も欲しいです。\n何卒宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/111", "thumbnail_src": "https://si.imgix.net/3680966e/uploads/origins/ce87634e-ccb8-4ca2-b7e7-6838ff304207?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4cfb3ea64af2aad284556d59ec74195", "thumbnail_srcset": "https://si.imgix.net/3680966e/uploads/origins/ce87634e-ccb8-4ca2-b7e7-6838ff304207?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4cfb3ea64af2aad284556d59ec74195, https://si.imgix.net/3680966e/uploads/origins/ce87634e-ccb8-4ca2-b7e7-6838ff304207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f5bd8ba040853e366192867ff61927d 2x, https://si.imgix.net/3680966e/uploads/origins/ce87634e-ccb8-4ca2-b7e7-6838ff304207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c17344557110886576e04e046218fc5c 3x", "genre": "art", "nsfw": true, "body": "こんにちわ。フェリアさんとうちの子キャラの聖女(セイント)フーロンとのコラボSSの挿絵イラストをご依頼させていただきます。\n\nフェリアさんとフーロンがドームバウンサーになってしまったイラストで、構図や表情は下記のリンクを参考にお願いします。\nhttps://www.pixiv.net/artworks/124175466#big_65\n出入口には「ふわふわフーロン」「ふわふわフェリア」等の名前を記載もしくはプレートなどがある感じでお願いします。\n\nわれもの注意さんの好みや描きやすさでアレンジなどを加えるのは問題ありません。よろしくお願いします。\n\nフーロン参考\nhttps://www.pixiv.net/artworks/125157227", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/110", "thumbnail_src": "https://si.imgix.net/968b18d4/uploads/origins/cc93a8e0-531a-469f-bf26-e94f2fe4a1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fcd072a50019efd23ed224cf6d0b202", "thumbnail_srcset": "https://si.imgix.net/968b18d4/uploads/origins/cc93a8e0-531a-469f-bf26-e94f2fe4a1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fcd072a50019efd23ed224cf6d0b202, https://si.imgix.net/968b18d4/uploads/origins/cc93a8e0-531a-469f-bf26-e94f2fe4a1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=607993fa087606820148509b128210dc 2x, https://si.imgix.net/968b18d4/uploads/origins/cc93a8e0-531a-469f-bf26-e94f2fe4a1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=619cd6f04eefeb311acde94b80b8661f 3x", "genre": "art", "nsfw": false, "body": "特務兵フェリアのどじょう怪人敗北シーンにある【どじょう怪人はフェリアを手元に手繰り寄せ、身体を持ち上げて民間人に見えるようにした】の部分をイラスト化して頂きたいです\nセリフはその後のどじょう怪人の「ゲゲゲッ！ほらほら言ってみろよ！\"わたしはただのどじょうです\"って！」を入れて貰えると助かります\n\n身体を持ち上げて民間人に見えるようにしたの部分ですが、どじょうの着ぐるみを着せられたフェリアがどじょう怪人に釣り上げられた感じのイメージでお願い出来ればと思います", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/109", "thumbnail_src": "https://si.imgix.net/64dcd5f2/uploads/origins/2799eade-c140-4f04-915b-41c2875229c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1a12f3e62c71e349e6c5186db27ed38", "thumbnail_srcset": "https://si.imgix.net/64dcd5f2/uploads/origins/2799eade-c140-4f04-915b-41c2875229c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1a12f3e62c71e349e6c5186db27ed38, https://si.imgix.net/64dcd5f2/uploads/origins/2799eade-c140-4f04-915b-41c2875229c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da4bd5f82a4b79d1296483eca2a36a05 2x, https://si.imgix.net/64dcd5f2/uploads/origins/2799eade-c140-4f04-915b-41c2875229c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a2fd2f1820675915e579da0cb3ee1fc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/108", "thumbnail_src": "https://si.imgix.net/b30051be/uploads/origins/2828d9d0-ae95-454c-a467-8a9ec9583c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=170b87f066f2aeeb551b8c722b7d42a1", "thumbnail_srcset": "https://si.imgix.net/b30051be/uploads/origins/2828d9d0-ae95-454c-a467-8a9ec9583c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=170b87f066f2aeeb551b8c722b7d42a1, https://si.imgix.net/b30051be/uploads/origins/2828d9d0-ae95-454c-a467-8a9ec9583c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=378369916f338added0a7a44050c5cf3 2x, https://si.imgix.net/b30051be/uploads/origins/2828d9d0-ae95-454c-a467-8a9ec9583c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dc0cde4327f3a6dc89e7a17a0fd8750 3x", "genre": "art", "nsfw": false, "body": "前回イラストを描いていただいてありがとうございます。今回もお願いします。\n\nポケモン（ダイヤモンド・パール）のマーズ（防寒着、着膨れ）の球体化をお願いします。\n\n・頭の上に雪ウサギ（大福みたいな形）がチョコンと載ってる感じでお願いします。\n\n・防寒着のデザインは、スマブラのアイスクライマーと同じような服で、グレーを基調としたカラーリングでお願いします。\n\n・表情は少し寒がってる感じで、頬が寒さで少し赤くなってる感じでお願いします。\n\n・雪がしんしんと静かに降っており、周りには雪が積もってる感じでお願いします。\n\n球体化参考\n（https://youtu.be/7qLWPDdJQOw?si=MQxYEnKxyaArmETB）球体化3Dモデル\n\nhttps://twitter.com/se7cond/status/1326920910582984707?t=eGJM0xeaLv0DaEvH7DH9QQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/107", "thumbnail_src": "https://si.imgix.net/c43d7373/uploads/origins/3ddac035-8cbd-4e0e-94a7-8caf215c373a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9580948844f9460b9bc6341617cfbc4", "thumbnail_srcset": "https://si.imgix.net/c43d7373/uploads/origins/3ddac035-8cbd-4e0e-94a7-8caf215c373a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9580948844f9460b9bc6341617cfbc4, https://si.imgix.net/c43d7373/uploads/origins/3ddac035-8cbd-4e0e-94a7-8caf215c373a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6daf1e318cad4a44539ed5329f656c1a 2x, https://si.imgix.net/c43d7373/uploads/origins/3ddac035-8cbd-4e0e-94a7-8caf215c373a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffb645c136164b5c6eedc5d53e3fe12d 3x", "genre": "art", "nsfw": true, "body": "原神の凝光と北斗のミルタンクの顔出し着ぐるみをお願いします。差分で被り物を被っておらざる着ぐるみを着ているだけをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/106", "thumbnail_src": "https://si.imgix.net/8ebc29ce/uploads/origins/d904f99b-9c38-4765-9ffb-b1e113c235cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48bc4fccc576b5eed9e5501135606d8", "thumbnail_srcset": "https://si.imgix.net/8ebc29ce/uploads/origins/d904f99b-9c38-4765-9ffb-b1e113c235cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48bc4fccc576b5eed9e5501135606d8, https://si.imgix.net/8ebc29ce/uploads/origins/d904f99b-9c38-4765-9ffb-b1e113c235cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fe04ae3052f0ceb849be20906129918 2x, https://si.imgix.net/8ebc29ce/uploads/origins/d904f99b-9c38-4765-9ffb-b1e113c235cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72db97eb89ad75c538dd8a6ba99ec764 3x", "genre": "art", "nsfw": false, "body": "先日リクエストしたものです。\n金額が合わなかったと思い増額して再送します。\n\nさて、早速ですがリクエストさせていただきたいです。\n\nクロマキータコの主婦二人が役を事前に聞かされずに撮影のエキストラとして参加するのですが、\nドラ/ゴン/ボールの魔人/ブ/ウに吸収されて体内で肉繭に閉じ込められている役で表情、セリフ差分含めて5枚ほどお願いしたいです。\n撮影はクロマキーではなく作り物の肉繭を想定しています。\n\n1枚目は原作通り眠っている状態を再現しセリフなし\n2枚目は撮影の合間に起きてる状態で配役に不満があり愚痴をいうセリフ\n3枚目は実際に吸収されたら気持ちいいのか疑問に思うセリフ\n4枚目はこれも旦那と子供にみせられない旨のセリフ\n5枚目は1枚目の差分で繭内に収まっている体を透過した状態\n\nこれからも陰ながら応援しています。\nイラストの制作ご検討よろしくお願いいたします。\n\nhttps://www.lancers.jp/work/proposal/6949889", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/105", "thumbnail_src": "https://si.imgix.net/faf2ad4b/uploads/origins/bb6dcf22-09c4-4189-978f-57d6a3e3d718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=949662b65ba56f59345469b89503b2a9", "thumbnail_srcset": "https://si.imgix.net/faf2ad4b/uploads/origins/bb6dcf22-09c4-4189-978f-57d6a3e3d718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=949662b65ba56f59345469b89503b2a9, https://si.imgix.net/faf2ad4b/uploads/origins/bb6dcf22-09c4-4189-978f-57d6a3e3d718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f78b0c1f86e1601f6b6d92850354ff94 2x, https://si.imgix.net/faf2ad4b/uploads/origins/bb6dcf22-09c4-4189-978f-57d6a3e3d718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d55fc7a6b718c8911779c5949a01f32 3x", "genre": "art", "nsfw": false, "body": "もしよろしければ、犬走紅葉がDeinoの人間ドッグスーツを着ているところを見てみたいです。\n\n紅葉がスーツを着ている過去のイラストはこちらです：\nhttps://www.pixiv.net/en/artworks/98689262\nhttps://www.pixiv.net/en/artworks/98924561\nhttps://www.pixiv.net/en/artworks/108205248\nhttps://www.pixiv.net/en/artworks/110033263\nhttps://www.pixiv.net/en/artworks/118644415\n\nこのマスクのバリエーションも図解してほしい：\n1.マスクなし。\n2.マスク着用、大きく開いて紅葉の顔を見せる。\n3.マスク着用、少し開いていて紅葉の顔がほとんど見えない。\n4.マスクを完全に閉じた状態。\nこれは、マスクのバリエーションがどのように見えるかを示す追加の参考資料です：\nhttps://www.pixiv.net/en/artworks/95812673\n\n最後に、バリアントによってセリフが変わるような、イラストの中のセリフがあってもいいと思いますが、それはオプションでしょう。\n\n以上が、このリクエストに対する私の仕様です。それ以外は自由に決めていただいて構いません。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/104", "thumbnail_src": "https://si.imgix.net/be424df1/uploads/origins/11a8cd6e-e8ed-40f5-982d-3a769d6aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0aaf93fdd1a852b520fdff103068795", "thumbnail_srcset": "https://si.imgix.net/be424df1/uploads/origins/11a8cd6e-e8ed-40f5-982d-3a769d6aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0aaf93fdd1a852b520fdff103068795, https://si.imgix.net/be424df1/uploads/origins/11a8cd6e-e8ed-40f5-982d-3a769d6aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3495ff491aed5f7fc71842e05e4a4fa4 2x, https://si.imgix.net/be424df1/uploads/origins/11a8cd6e-e8ed-40f5-982d-3a769d6aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=671d92fe29c5f07cf6d5d7c5898fc166 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/103", "thumbnail_src": "https://si.imgix.net/d01cb5ad/uploads/origins/373907f7-c981-4433-b2e4-2c681c92115f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecfc4366f3908fac62c3aa6794bda340", "thumbnail_srcset": "https://si.imgix.net/d01cb5ad/uploads/origins/373907f7-c981-4433-b2e4-2c681c92115f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecfc4366f3908fac62c3aa6794bda340, https://si.imgix.net/d01cb5ad/uploads/origins/373907f7-c981-4433-b2e4-2c681c92115f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7183500eb20c8bf418da90a559b9eb48 2x, https://si.imgix.net/d01cb5ad/uploads/origins/373907f7-c981-4433-b2e4-2c681c92115f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5717a303aa53b079a83b56999698575 3x", "genre": "art", "nsfw": true, "body": "前回はとても素敵な絵をありがとうございました。\n今回も再び大●豪●大●民●/ V●ン●ィ（https://twitter.com/CareerPoker）のエロイラストをお願いします。\n\n・スペース性癖破壊ンベーダーの宇宙人にやられて、エッチな絵画にされるシチュ\n・衣装はメイド服、胸部は完全に丸出しで、両手で胸を持ち上げて強調させるポーズ\n・乳首からは母乳があふれている\n・絵画の題名には「宇宙人様専用ミルクサーバー」と書かれている\n・表情は絵画になれたことが嬉しそうに\n・まもる君がこの絵画を見て性癖が破壊される所もよければ描いてほしい\n\nその他細かい所はお任せします。　よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/102", "thumbnail_src": "https://si.imgix.net/a0caaa19/uploads/origins/f39ef470-746e-4b7f-b184-21dbf6d2aaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6760a489156db8cbb25a6805eb4aafe", "thumbnail_srcset": "https://si.imgix.net/a0caaa19/uploads/origins/f39ef470-746e-4b7f-b184-21dbf6d2aaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6760a489156db8cbb25a6805eb4aafe, https://si.imgix.net/a0caaa19/uploads/origins/f39ef470-746e-4b7f-b184-21dbf6d2aaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e1971426f8ed8d4d1855b5beda6e871 2x, https://si.imgix.net/a0caaa19/uploads/origins/f39ef470-746e-4b7f-b184-21dbf6d2aaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3375b88140f0a7acb0a10f4628cb742d 3x", "genre": "comic", "nsfw": true, "body": "※過去にプリコネの依頼を受けたことがあると勘違いしておりました。改めて別のキャラでリクエストさせていただきます。\n\nブルアカのウイ(水着)が、遺跡探索中にトラップで強制ダンス→黄金化のコンボをくらってしまう漫画をリクエストさせてください！ \n\n 以下のよう流れでお願いします！\n\n①遺跡探索に夢中になり強制ダンストラップを踏んでしまい、恥ずかしい踊りを踊ってしまう。\n\n②近くにあった衣服消失トラップを踏んでしまいすっぽんぽんで踊らされる羽目に。\n\n③踊っているせいで何度も強制ダンストラップを踏んでしまい、その度に次々とヘンテコで間抜けなポーズで踊らされてしまう。\n\n④そのままおもらしガスと黄金化ガスのトラップまで踏んでしまい、間抜けな踊りの格好のまま固められて黄金小便少女にされ、晒し者に。  \n\n⑤探しに来た他の生徒(ヒナタ、ハナコ、コハル)に発見され、皆の前で醜態を晒す羽目に...\n\nウイ以外はセリフのみで大丈夫です！", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/101", "thumbnail_src": "https://si.imgix.net/2917b933/uploads/origins/cd6215f0-6e57-4264-93cf-314cc418a7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02db20faa97cc53dad5f644a1a1547df", "thumbnail_srcset": "https://si.imgix.net/2917b933/uploads/origins/cd6215f0-6e57-4264-93cf-314cc418a7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02db20faa97cc53dad5f644a1a1547df, https://si.imgix.net/2917b933/uploads/origins/cd6215f0-6e57-4264-93cf-314cc418a7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74877bbb2fa316382537701d9f7c0496 2x, https://si.imgix.net/2917b933/uploads/origins/cd6215f0-6e57-4264-93cf-314cc418a7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf563beb184c260b785043ce2642b45f 3x", "genre": "art", "nsfw": false, "body": "また瑠璃のイラストをお願いしたいのですが、よろしいでしょうか？\nhttps://x.com/matsukura_d/status/1733335347097182255\nhttps://skeb.jp/@waremono_419/works/78\n\nその際、過去のイラストのようにインナー(A)のボディースーツのみを着用してほしいです：\nhttps://x.com/kig_kaodashi/status/1737825800643285161\nhttps://x.com/kig_kaodashi/status/1738537911031832881\n\nこれ以上の指定はありませんので、またお好きなように描いてください。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/100", "thumbnail_src": "https://si.imgix.net/8f98164a/uploads/origins/fdf08160-2029-48b8-bd12-598b3edca6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879a18fe9d596ab7643ba7a37c74d0e6", "thumbnail_srcset": "https://si.imgix.net/8f98164a/uploads/origins/fdf08160-2029-48b8-bd12-598b3edca6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879a18fe9d596ab7643ba7a37c74d0e6, https://si.imgix.net/8f98164a/uploads/origins/fdf08160-2029-48b8-bd12-598b3edca6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd37470d36566049d7a6494380ddd291 2x, https://si.imgix.net/8f98164a/uploads/origins/fdf08160-2029-48b8-bd12-598b3edca6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52ba866f0950708b1c16e11832966685 3x", "genre": "art", "nsfw": false, "body": "黒工房さんの狼跡　雷佳ちゃん(https://drive.google.com/file/d/1s1uDER1Ke2mIlZzabQh4rWutDH_11N9N/view?usp=drivesdk ,\nhttps://drive.google.com/file/d/1l5qpvE-vmFTOPzNuE79u7uJjRgVat4E0/view?usp=drivesdk)がルクシオスウツを着てその上からポケまぜ(https://www.poke-maze.jp/)の帽子とエプロンをつけてカフェで接客するシチュエーションの絵をお願いしたいです(許可は降りています)\n恥ずかしがってたり、笑顔で接客出来ていたりして欲しいです\nエプロン、帽子、マスク、レンズ、レンズ透過の有無といったバリエーションも欲しいです\n何卒よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/99", "thumbnail_src": "https://si.imgix.net/1c7e190c/uploads/origins/bccd4898-319d-410d-83e8-0e6c15564e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e4413220d570bca2ed29725a3c44970", "thumbnail_srcset": "https://si.imgix.net/1c7e190c/uploads/origins/bccd4898-319d-410d-83e8-0e6c15564e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e4413220d570bca2ed29725a3c44970, https://si.imgix.net/1c7e190c/uploads/origins/bccd4898-319d-410d-83e8-0e6c15564e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b8b0a366ef8d9f3082eaf86755fb0c9 2x, https://si.imgix.net/1c7e190c/uploads/origins/bccd4898-319d-410d-83e8-0e6c15564e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=639bf6306269c4316e4f3a732113ac0c 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回は、以前依頼させていただいたファリアとジャスミンのお面化イラストを別のキャクターで描いていただきたいと思います。\n\n●キャラクター\n\nフリーナ\nhttps://x.com/Genshin_7/status/1706247173887684645\n\nナヴィア\nhttps://x.com/Genshin_7/status/1721467492076572897\n\nクロリンデ\nhttps://x.com/Genshin_7/status/1782348645423366610\n\n内容としては、人間の顔をお面のように剥がして奪う怪人によって顔を奪われる3人。怪人によって三つの額縁に顔を貼り付けられ、フリーナは困惑し、ナヴィアは激しく、クロリンデは静かながら怒りの表情を見せている。しかし文字通り手も足も出ない為、怪人のコレクションの一つとして飾られるのであった…。\n\n以上となります。 3人の顔が額縁に貼り付けられている描写は正面のアングルでお願いします。 可能であれば、2枚程の差分をお願いします。 1枚は瞳のハイライト無し、無表情の2人の顔を。もう1枚は瞳にハートマークのついた笑顔の表情固定です。瞳のハイライトはありで問題ないです。 再びかなり尖ったシチュエーションとなりますが、ご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/98", "thumbnail_src": "https://si.imgix.net/d173abd2/uploads/origins/9b5e225c-b330-47e0-b80a-c901d7d69f43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26a1c2f6d297c6cba510528f43b91f84", "thumbnail_srcset": "https://si.imgix.net/d173abd2/uploads/origins/9b5e225c-b330-47e0-b80a-c901d7d69f43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26a1c2f6d297c6cba510528f43b91f84, https://si.imgix.net/d173abd2/uploads/origins/9b5e225c-b330-47e0-b80a-c901d7d69f43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ae565b56508daa9f74d2fa9e7901ad9 2x, https://si.imgix.net/d173abd2/uploads/origins/9b5e225c-b330-47e0-b80a-c901d7d69f43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aed7dca9451051a95d76a1ec8594e930 3x", "genre": "art", "nsfw": true, "body": "こんにちは。頭から下が蛇になった女性2人が互いに顔を近づけ見つめ合いながら、しめ縄のように螺旋状に絡み合っているイラストをお願いします。女性の顔や髪型は二人とも黒髪で\n①おかっぱボブの少女\n②おでこが見えるように髪を後ろでお団子縛りしてる大人の女性\nの二人でお願いします。\n\n．表情や台詞差分など\n①、おかっぱ少女は申し訳無さそうな顔で「ごめんなさい、体が言うこときかなくて」と伝えています。お団子ヘアの女性は「気にしないでいいのよ、コントロールできないのは私も同じだからさ。それにしても、パワフルね。おばさんくたくたよ。」と汗だくになりながら励ましています。\n\n②おかっぱ少女は自分の状況に気づき「ちょっと待って！？これってもしかして、、」顔を真赤にし驚いた表情に。お団子女性は「気づいちゃったか、どうやら私達交尾しちゃってるみたいね。」とバツの悪そうな苦笑いを浮かべています。\n\n③おかっぱ少女は顔を赤らめつつ口を開け「あん！ごめんなさいっ！！強く締め付けちゃってますよね？んあっ！？」と謝罪しつつ喘いでしまいます。お団子女性は頬を赤らめながら苦しそうな表情で「お、おぉぅ！どうやら、本格的に始まったみたいね。大丈夫よ、すぐ終わるからね〜、、ぐぁっ！？」励ましながら少女と異なり獣みたいな低い声で喘いでしまいます。\n\n発注内容は以上になります。よろしければお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@waremono_419/works/97", "thumbnail_src": "https://si.imgix.net/0cda5092/uploads/origins/9802aa55-94e6-4985-b511-5eca24d4faf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afcc91216d6e040ddc6942f09bc70050", "thumbnail_srcset": "https://si.imgix.net/0cda5092/uploads/origins/9802aa55-94e6-4985-b511-5eca24d4faf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afcc91216d6e040ddc6942f09bc70050, https://si.imgix.net/0cda5092/uploads/origins/9802aa55-94e6-4985-b511-5eca24d4faf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28333b315e22b74a73e79c7cabb98bdc 2x, https://si.imgix.net/0cda5092/uploads/origins/9802aa55-94e6-4985-b511-5eca24d4faf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4e22edd0da6eed6a0584ae4aee007e9 3x", "genre": "art", "nsfw": true, "body": "リクエストを失礼します。\nフェリアシリーズに出てくるフェリアさんのリクエストを、ぜひお願い出来ましたら嬉しいです。\n\n■シチュエーション\n「特務兵フェリア」の幽霊怪人に憑依されたフェリアさんが、その時たまたま地下道に迷い込んだ一般人の男を騎乗位で逆レイプするシチュをお願いします。\n憑依する幽霊は作中でフェリアさんの身体を乗っ取っていた女性口調の霊で、作中では評判を落とそうとしていましたが、\n今回はifの世界線な感じで、フェリアさんの身体を使って性欲を発散するとか、他人の身体で生中出しをさせて取り返しがつかない事になるのを楽しんでいるとかそんな感じの方向性で是非……。\n\n■差分希望\n・もし可能でしたら、下記の差分をお願い出来ますと嬉しいです。\n①射精差分\n②擬音の有無\n\n■その他\n・記載にない点やアドリブ、セリフなど是非何でもお任せします。", "created_at": "", "completed_at": ""}]}