b-bd7e-2d0d26997e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4776065f2390c8e88d68c61de5c40d6, https://si.imgix.net/8191965a/uploads/origins/8612e37f-6a31-40cb-bd7e-2d0d26997e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=025f8f3575d877266bea843cbaf64bb9 2x, https://si.imgix.net/8191965a/uploads/origins/8612e37f-6a31-40cb-bd7e-2d0d26997e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c91cdb3e736acf8a2be64cf7cbce87c9 3x", "genre": "art", "nsfw": false, "body": "また会ったね、\n\n\n今月は有咲の誕生日なのですが、もし彼女がリアルタイムで歳をとっていたら、今年で23歳になります。そこで、彼女の年上バージョンを描いてほしい。ただ一つ指定があるとすれば、髪が長いこと。どうぞ楽しんでください。\n\nいつもありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/56", "thumbnail_src": "https://si.imgix.net/4b85c2d6/uploads/origins/b02a961a-c77b-4241-be48-f74895b8b342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f9b08b7287b68f26eed4076a9e5a662", "thumbnail_srcset": "https://si.imgix.net/4b85c2d6/uploads/origins/b02a961a-c77b-4241-be48-f74895b8b342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f9b08b7287b68f26eed4076a9e5a662, https://si.imgix.net/4b85c2d6/uploads/origins/b02a961a-c77b-4241-be48-f74895b8b342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c7d7410bd291272b83212f4ae219f12 2x, https://si.imgix.net/4b85c2d6/uploads/origins/b02a961a-c77b-4241-be48-f74895b8b342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00a4bc457dc86a3b8882c961f7d056dd 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n前回のリクエストの続編です。今回は、有咲のお嫁さんになりたい女の子が何人か登場しました。\n\nりみは大和撫子の名にふさわしいドレスを。\n鰐部七菜は、この中で最年長であることを強調するような、大人っぽい、ちょっとセクシーなドレスを着ている。眼鏡をかけていることもある。\n他の二人の花嫁は紗綾と燐子で、どんなドレスが一番似合うかはあなたが決めてください。\n\n彼女たちに嫉妬はない。有咲はもちろん、たくさんの愛情を注がれてとても動揺している。\n\n\nいつもながら、ご配慮ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/55", "thumbnail_src": "https://si.imgix.net/19f9d863/uploads/origins/19ed1301-1c9a-4b3c-aaf3-5b3739e37e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c42b97bd894b8b1a3df026a443eea97", "thumbnail_srcset": "https://si.imgix.net/19f9d863/uploads/origins/19ed1301-1c9a-4b3c-aaf3-5b3739e37e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c42b97bd894b8b1a3df026a443eea97, https://si.imgix.net/19f9d863/uploads/origins/19ed1301-1c9a-4b3c-aaf3-5b3739e37e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6bc37169e9a02640fd294402c1fdc0c 2x, https://si.imgix.net/19f9d863/uploads/origins/19ed1301-1c9a-4b3c-aaf3-5b3739e37e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee5bbb1e01a4fe4f50e4bb7a4f1e1d14 3x", "genre": "art", "nsfw": false, "body": "花嫁月間だ！\n\n現実の世界では有咲はもう22歳になっているはずだから、ブライダルコスチュームを着た彼女を描いてほしいんだ。彼女がもう一人花嫁を持てるかどうかは、君に任せるよ。\n\nどうぞ楽しんでください。\n\nいつもありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/54", "thumbnail_src": "https://si.imgix.net/3112d50b/uploads/origins/63bd8be6-7faf-4cd1-822c-3d12a8c6e69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c099cedd70f115b5c6207601eba699ae", "thumbnail_srcset": "https://si.imgix.net/3112d50b/uploads/origins/63bd8be6-7faf-4cd1-822c-3d12a8c6e69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c099cedd70f115b5c6207601eba699ae, https://si.imgix.net/3112d50b/uploads/origins/63bd8be6-7faf-4cd1-822c-3d12a8c6e69e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bebedce22da1a49984e2a0802f2ff40 2x, https://si.imgix.net/3112d50b/uploads/origins/63bd8be6-7faf-4cd1-822c-3d12a8c6e69e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3feb52dda52f1caa7cb717f66902f832 3x", "genre": "art", "nsfw": false, "body": "匿名にて失礼します。\n以下のリクエストを受けていただけないでしょうか。\n\n【キャラクター】\n　うちの子、千遥（ちはる）。\n　※容姿、体型は資料画像をご覧ください。\n\n【シチュエーション】\n　友達と美術館やショッピングへお出かけ中。楽しそうな様子でお願いします。\n\n【服装・ポーズ】\n・服装\n　私服。パステルカラーを基調に清楚な感じでお願いします。\n　なお、あまり露出の多い服は好まない性格です。\n\n【資料】\n・うちの子 全身\n（身長、スリーサイズあり）\nhttps://d23zy2d3xuicqc.cloudfront.net/materials/beks/01-2_%E5%88%B6%E6%9C%8D2.png\n\n・うちの子 顔アップ\nhttps://d23zy2d3xuicqc.cloudfront.net/materials/beks/03_%E9%A1%94.png\n\nhttps://d23zy2d3xuicqc.cloudfront.net/materials/beks/01-2_%E5%88%B6%E6%9C%8D2.png", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/53", "thumbnail_src": "https://si.imgix.net/c9540e3e/uploads/origins/1d086a2b-b3cf-4ae1-b19f-7dcfab63d91a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75e76baedbd7b343c64bbf4570ce5e93", "thumbnail_srcset": "https://si.imgix.net/c9540e3e/uploads/origins/1d086a2b-b3cf-4ae1-b19f-7dcfab63d91a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75e76baedbd7b343c64bbf4570ce5e93, https://si.imgix.net/c9540e3e/uploads/origins/1d086a2b-b3cf-4ae1-b19f-7dcfab63d91a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991f2b9c9aad52165e62ed355f7ea3f0 2x, https://si.imgix.net/c9540e3e/uploads/origins/1d086a2b-b3cf-4ae1-b19f-7dcfab63d91a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d4bacff99d964a6bd8cb978abadc575 3x", "genre": "art", "nsfw": false, "body": "また会ったね\n\nパレオちゃん、物語ではまだ13～14歳なんだけど、もし物語が現実の時間に合わせていたら、今年大学2年生になってるはずだから、今のパレオちゃんを描いてほしいんだ。フリルのついたフェミニンな服装はそのままに、少し大人っぽくすると思います。\n髪もピンクとティールで長めにして、ツインテールにはしない。また、人前でメガネをかける自信がついたと思いたい。\nバストも中学時代より少し大きくなっているだろう。\n\nあとはあなたにお任せします。楽しんで描いてください。\n\nいつもありがとうございます。\n\nhttps://bestdori.com/assets/en/characters/resourceset/res034014_rip/card_after_training.png", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/52", "thumbnail_src": "https://si.imgix.net/a2b19d4b/uploads/origins/47fa9916-fd39-4c5a-9750-1c4b44ee129c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1e0dfc841054432ff6e74627c1f4ca", "thumbnail_srcset": "https://si.imgix.net/a2b19d4b/uploads/origins/47fa9916-fd39-4c5a-9750-1c4b44ee129c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1e0dfc841054432ff6e74627c1f4ca, https://si.imgix.net/a2b19d4b/uploads/origins/47fa9916-fd39-4c5a-9750-1c4b44ee129c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cfdd1c55b4990699c54a61d9da369da 2x, https://si.imgix.net/a2b19d4b/uploads/origins/47fa9916-fd39-4c5a-9750-1c4b44ee129c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1f5344260008f9a857e220bf713a2ac 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです！\n\nもうすっかり季節外れになってしまいましたが、以前描いていただいた衣装でメイコとルカが一緒にデートしているところをまだ描いていただけませんか？相変わらず百合感は大歓迎です。\n\nよろしくお願いします。\n\nhttps://skeb.jp/@sokosokomichi/works/50\n\nhttps://skeb.jp/@sokosokomichi/works/30", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/51", "thumbnail_src": "https://si.imgix.net/13e7f694/uploads/origins/6e15a3bf-6f40-4e75-87bf-a0642340881f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2a1010153527605a3a4d05a9d13a6e", "thumbnail_srcset": "https://si.imgix.net/13e7f694/uploads/origins/6e15a3bf-6f40-4e75-87bf-a0642340881f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2a1010153527605a3a4d05a9d13a6e, https://si.imgix.net/13e7f694/uploads/origins/6e15a3bf-6f40-4e75-87bf-a0642340881f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2611c04c9dedbfead9dd03209562b1ce 2x, https://si.imgix.net/13e7f694/uploads/origins/6e15a3bf-6f40-4e75-87bf-a0642340881f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4252ffab628e18620e26c3d8fb80413c 3x", "genre": "art", "nsfw": false, "body": "また会ったね\n\nギルティギアにエルフェルトが追加されてびっくりしたので、描いていただけませんか？\n\n彼女はブリジットの気を引こうとしてヨーヨーの技を学んでいるんだけど、とても不器用だからヨーヨーが絡まっちゃうんだ。ブリジットは彼女がヨーヨーの絡まりをほどくのを手伝う。\n\nそしてまたエルフェルトを元気づけるために、ブリジットは彼女に小さなキスをする。\n\nElphelt: https://cdn.discordapp.com/attachments/1149679473680207873/1182883784748716102/image.png\n身長はブリジットより10センチ高い。もうちょっと冬に似合う服にしてあげて。\n\nブリジット：https://pbs.twimg.com/media/FlDeSWxXkAAm7Qk?format=jpg&name=medium\nメガネはちょっと気づきにくいかも。黒のショートパンツは、やや長めのスカートに変えてもいいかも。胸元はもう少し強調してもいいかも。\n\nいつもありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/50", "thumbnail_src": "https://si.imgix.net/c04c6d40/uploads/origins/34ffe02f-f0c7-4204-b258-899cbd8434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0533c626427f445a37519733afc23e9d", "thumbnail_srcset": "https://si.imgix.net/c04c6d40/uploads/origins/34ffe02f-f0c7-4204-b258-899cbd8434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0533c626427f445a37519733afc23e9d, https://si.imgix.net/c04c6d40/uploads/origins/34ffe02f-f0c7-4204-b258-899cbd8434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70677b4d2d28544de42f869960b644d8 2x, https://si.imgix.net/c04c6d40/uploads/origins/34ffe02f-f0c7-4204-b258-899cbd8434c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e83b803aaecad8882818ea8ed5c4db9e 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n昨年は素敵なイラストを描いてくださったので、今年はメイコにも同じようなイラストを描いていただけませんか？\n\n今年もよろしくお願いします。\n\nhttps://skeb.jp/@sokosokomichi/works/30", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/49", "thumbnail_src": "https://si.imgix.net/0894a010/uploads/origins/9a3050ce-b86e-4341-a2dd-72d675b951d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c3889e74b1fdbe3751f803b2eaa3b5b", "thumbnail_srcset": "https://si.imgix.net/0894a010/uploads/origins/9a3050ce-b86e-4341-a2dd-72d675b951d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c3889e74b1fdbe3751f803b2eaa3b5b, https://si.imgix.net/0894a010/uploads/origins/9a3050ce-b86e-4341-a2dd-72d675b951d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a90394d514b45d34590800616cabf213 2x, https://si.imgix.net/0894a010/uploads/origins/9a3050ce-b86e-4341-a2dd-72d675b951d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1509a3668586fe6f20bcd58bf43010d 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！Aqoursの津島善子さんにポケモントレーナーのカヒリのコスプレをお願いしたいです。添付資料の翼のアタッチメントとお団子ヘアの黒い羽根もお願いします。ポーズや表情はお任せします。ご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1fQXgEhYLviwbB9lVuU77f5oot6aCUVP_", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/48", "thumbnail_src": "https://si.imgix.net/f2f9243d/uploads/origins/b5519c81-0c6a-4e9c-b7a5-9f9a70a4fe1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1acff0d0d059435892a228759ce7289b", "thumbnail_srcset": "https://si.imgix.net/f2f9243d/uploads/origins/b5519c81-0c6a-4e9c-b7a5-9f9a70a4fe1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1acff0d0d059435892a228759ce7289b, https://si.imgix.net/f2f9243d/uploads/origins/b5519c81-0c6a-4e9c-b7a5-9f9a70a4fe1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1000707be373c74faa729f37f17c4ce 2x, https://si.imgix.net/f2f9243d/uploads/origins/b5519c81-0c6a-4e9c-b7a5-9f9a70a4fe1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a21a42e8d40c67aba1b17f1fb6da07e 3x", "genre": "art", "nsfw": false, "body": "フィナーレの時間だ！\n\n今回は有咲と希のイラストでいい。有咲が希の胸元に寄り添い、抱き合う。希は胸元を一部露出させ、抱き合いをより良いものにしているのかもしれない。  有咲は顔を赤らめているが、止めたくなさそうだ。\n\n\n詳細はあなたにお任せします。\n\nいつも私のくだらないアイデアを描いてくれてありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/47", "thumbnail_src": "https://si.imgix.net/a97a4275/uploads/origins/5d36ac93-f438-4593-9e61-554c767c9afd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb019b85d7ebcf7729a34473feabaa8b", "thumbnail_srcset": "https://si.imgix.net/a97a4275/uploads/origins/5d36ac93-f438-4593-9e61-554c767c9afd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb019b85d7ebcf7729a34473feabaa8b, https://si.imgix.net/a97a4275/uploads/origins/5d36ac93-f438-4593-9e61-554c767c9afd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d244ec3bd6b9bbe43d30215b67de7ac5 2x, https://si.imgix.net/a97a4275/uploads/origins/5d36ac93-f438-4593-9e61-554c767c9afd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36ed3b973ded7f5038b384bdc7063f3a 3x", "genre": "art", "nsfw": false, "body": "その続編の時間だ！\n今回は有咲が神田明神に行くのだが、彼女はサンハットにサングラス、髪型もいつもと違うスタイルで目立たないようにしている。しかし、彼女の健康的なバストは隠すのが難しく、イタズラに出くわしたと思った矢先、希が現れ、いつでも可愛い女の子だとわかるよと告げる。さらに彼女は有咲に、もし探しに来たのなら、ビーチでの経験の後、もう一度触れたいに違いないと言う。最初は否定しようとする有咲に、希は、彼女のようなかわいい女の子はもっと自分に正直になるべきだと言う。有咲は少しためらった後、飲み込んでうなずいた。希は満足そうに微笑み、仕事が終わったら一緒に素敵な時間を過ごそうと告げる。隅に「つづく」があることもある。\n\nいつもご配慮ありがとうございます。\n\nhttps://skeb.jp/@sokosokomichi/works/43", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/46", "thumbnail_src": "https://si.imgix.net/eb00c8cd/uploads/origins/445a4273-f506-4583-a11b-15a353f7bc17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5510b68207df240f07e87e16c46d3b", "thumbnail_srcset": "https://si.imgix.net/eb00c8cd/uploads/origins/445a4273-f506-4583-a11b-15a353f7bc17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5510b68207df240f07e87e16c46d3b, https://si.imgix.net/eb00c8cd/uploads/origins/445a4273-f506-4583-a11b-15a353f7bc17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8aa18b83bccfb1eeebf412e7576938da 2x, https://si.imgix.net/eb00c8cd/uploads/origins/445a4273-f506-4583-a11b-15a353f7bc17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0b5a7e657a192ffd2a0dc76eda4d755 3x", "genre": "art", "nsfw": false, "body": "こんにちは、コバヤシ先生！\n\nあなたのギャラリーを拝見しました！私はあなたのキャラクターポートレート周りの仕事が本当に好きです！もしよければ、私のVtuberのキャラクターにリクエストをして、TwitterやTwitch、ウェブサイトで使いたいです！\n\n彼女は遊び好きで、よく笑い、きれいな風景を見るために旅行するのが好きです！花柄の袴を着てほしいです！具体的なデザインや柄はお任せしますが、デザインに興味がなければ参考のもので構いません！できれば、冬や雪がテーマでもいいですか？ポーズやディテールはお任せします！\n\n本当にありがとうございました！よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1EhppDOWX40JDKs4Yf9AvQRkD4RMRLNX4", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/45", "thumbnail_src": "https://si.imgix.net/8e3fb30d/uploads/origins/bacd11ec-6c9d-4ce6-bf87-089a60639e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2334a7a6c9cd7ec16a9c62ba330dc0b4", "thumbnail_srcset": "https://si.imgix.net/8e3fb30d/uploads/origins/bacd11ec-6c9d-4ce6-bf87-089a60639e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2334a7a6c9cd7ec16a9c62ba330dc0b4, https://si.imgix.net/8e3fb30d/uploads/origins/bacd11ec-6c9d-4ce6-bf87-089a60639e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6169ff227560bda333bc4c936f05bb6 2x, https://si.imgix.net/8e3fb30d/uploads/origins/bacd11ec-6c9d-4ce6-bf87-089a60639e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9895404805c44ad6ba65027cdac10fb 3x", "genre": "art", "nsfw": false, "body": "本日描いていただいた短髪りみりんですが、別バージョンをどうしても見たく、立て続けのリクエストになってしまい申し訳ありません。\n\nりみりんが手で抑えている元の髪の長さを保っているサイドの髪（もみあげ？）を完全に無くしてより短髪を際立たせていただきたいのですが、髪留めはそのまま付けていだき、特徴的な跳ねてる髪含めて他の髪は長さや形は今日いただいた絵と同じでお願いします（サイドの髪のみ無くせば大丈夫です）\n \nその上で、着ている服は変えずそのままで、キャラの向きを正面前向きにしていただき、両手で口を抑えて驚いているポーズを描いていただけたら幸いです。\n\n短髪りみりん立て続けで大変申し訳ありませんが、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/44", "thumbnail_src": "https://si.imgix.net/dab125b8/uploads/origins/5f0fe0c9-b391-4af2-9514-8aa0539492ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa650bac0093dd4fca3227a48a65681", "thumbnail_srcset": "https://si.imgix.net/dab125b8/uploads/origins/5f0fe0c9-b391-4af2-9514-8aa0539492ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa650bac0093dd4fca3227a48a65681, https://si.imgix.net/dab125b8/uploads/origins/5f0fe0c9-b391-4af2-9514-8aa0539492ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d46aa0ab57d8708629ca3fc54e8ebf29 2x, https://si.imgix.net/dab125b8/uploads/origins/5f0fe0c9-b391-4af2-9514-8aa0539492ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90402b622391dd3640ca4c433e89b780 3x", "genre": "art", "nsfw": false, "body": "久しぶりにリクエストさせていただきます。\n元々髪は短めのキャラですが、牛込りみが美容院で髪を短く切られすぎて、μ'sの凛と同じ長さかそれより短いかなりのショートカットになってしまい、恥ずかしがってる絵をお願い出来ますでしょうか？\n服装は夏の私服であるとありがたいですが、帽子等頭が隠れてしまう被り物はなしで、頭がくっきり見えるようお願いしたいのと、りみりんの特徴である横に跳ねてる髪は一切切られず、そのままでお願いします。\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/43", "thumbnail_src": "https://si.imgix.net/89157ccb/uploads/origins/568fc9ff-c2b4-470c-a7f3-93c0a504754d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586c1af354a9e39e934551a5ae6e88f4", "thumbnail_srcset": "https://si.imgix.net/89157ccb/uploads/origins/568fc9ff-c2b4-470c-a7f3-93c0a504754d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586c1af354a9e39e934551a5ae6e88f4, https://si.imgix.net/89157ccb/uploads/origins/568fc9ff-c2b4-470c-a7f3-93c0a504754d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d9e289a511a4a20bf2c1fc3d9ac7a87 2x, https://si.imgix.net/89157ccb/uploads/origins/568fc9ff-c2b4-470c-a7f3-93c0a504754d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf6a66af19b6d7e77a776450eb94c0b9 3x", "genre": "art", "nsfw": false, "body": "まだ夏だ！\n\nというわけで、海辺で希ちゃんを困らせる習慣を続けよう。今年は有咲でもいい。\n希ちゃんは胸の谷間が見える服を着ている。有咲は携帯を見ながら歩いていて、偶然希とぶつかる。しかし、有咲は下を向いていて、身長が7cmほど低いため、彼女の胸元に顔が当たってしまう。一瞬の呆然とした沈黙の後、有咲は一歩下がって顔を真っ赤にしながら深く謝り始める。しかし希は、かわいい女の子がぶつかってきてくれたことをとても喜び、もう一度やり直そうと提案するが、有咲は恥ずかしくてそのまま帰ってしまう。希は、もし気が変わったら神田明神で探せばいいと怒鳴る。\n\n前回同様、日本語はOK。\n\nいつもながら、ご配慮ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@sokosokomichi/works/42", "thumbnail_src": "https://si.imgix.net/ddfce506/uploads/origins/e627aae5-f7b7-4627-b9f8-dc2449ccf390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c0ca7a7e2c87cba67e8f55585ccd54", "thumbnail_srcset": "https://si.imgix.net/ddfce506/uploads/origins/e627aae5-f7b7-4627-b9f8-dc2449ccf390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c0ca7a7e2c87cba67e8f55585ccd54, https://si.imgix.net/ddfce506/uploads/origins/e627aae5-f7b7-4627-b9f8-dc2449ccf390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d58ae5e202c9e17b872b51d224c3da0 2x, https://si.imgix.net/ddfce506/uploads/origins/e627aae5-f7b7-4627-b9f8-dc2449ccf390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40faf6ee07f97483ae7eb8069bea09e7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！可能であれば、Aqoursの津島善子さんに、添付リンクのサッカーユニフォームを着ていただき、参考画像のような青いリボンを頭につけていただきたいです。アートディレクションはお任せします。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Y8d4dDAGX9GKutSZPMOgqNY6GwVnlhjz", "created_at": "", "completed_at": ""}]}