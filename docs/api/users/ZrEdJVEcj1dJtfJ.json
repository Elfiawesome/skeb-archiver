7d03378d1a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dff4901b234a738fcb5af9223a2eedef, https://si.imgix.net/a35c4e61/uploads/origins/2988832a-905f-413e-a0d8-7d03378d1a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5135f62ce95aa3d343b07f65f1c829ce 2x, https://si.imgix.net/a35c4e61/uploads/origins/2988832a-905f-413e-a0d8-7d03378d1a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2cb4e92ade72ea69f0c7c11f3e914a6 3x", "genre": "art", "nsfw": true, "body": "コンテキスト[漫画・アニメ「フリーレン」の登場人物フリーレンが、白馬と性行為をする：フリーレンは白馬と性行為をする。彼女の呪文書によれば、胸を大きくするための主成分は馬の精液である]。\nイラスト[馬小屋でフリーレンは馬の下に身を置き、足を使って馬のペニスを搾乳する。馬の注意を引くために全裸になるのは屈辱的だと彼女は言い、その顔は固く無表情だ。彼女は両足を使って、見事なテクニックで馬のペニスをオナニーする。馬は彼女の裸体（腹と胸）に大量に射精する。彼女は次にしなければならないことが不愉快だと叫ぶ。困ったような厳しい表情で、彼女は腹に溜まったザーメンを手ですくい上げ、膣に深く挿入する。指を奥に押し込みながら、膣はザーメン（クレーミー）でにじみ、彼女は言う。「この呪文は翻訳するのが面倒だった。読む気にならなかった」。］", "created_at": "", "completed_at": ""}, {"path": "/@ZrEdJVEcj1dJtfJ/works/32", "thumbnail_src": "https://si.imgix.net/f65e8f5b/uploads/origins/d7ec29c9-92c8-4c45-a6f1-171a23080d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a4be9ae977196478856cc677ddb0f55", "thumbnail_srcset": "https://si.imgix.net/f65e8f5b/uploads/origins/d7ec29c9-92c8-4c45-a6f1-171a23080d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a4be9ae977196478856cc677ddb0f55, https://si.imgix.net/f65e8f5b/uploads/origins/d7ec29c9-92c8-4c45-a6f1-171a23080d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e6330bb028ad1f802bb52c5b38eb401 2x, https://si.imgix.net/f65e8f5b/uploads/origins/d7ec29c9-92c8-4c45-a6f1-171a23080d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9af6c02723c5d8fd3a15fd1f57567f9f 3x", "genre": "art", "nsfw": true, "body": "こんにちは、いつも可愛くてエッチなイラストをありがとうございます\n大きな仕事が片付いたとの事でまたリクエストさせて頂きます。\n\nキャラクターは前回に引き続き藤林すずちゃんをお願いします\n服装は現代風の服を着せて下さい、色やデザインはお任せします。\n\n塗りは昔塗り、もしくは普通塗りで、風凛さんがやりやすい方でお願いします。\n\nシチュは二人でスマホゲームで対戦しているという内容で\n下記リンクのキャロルちゃんのように\n男の膝の上に座ってスマホ片手に足コキと手での先っぽ責めで妨害、勝利している所をお願いします。\n（男は全く集中できなくてスマホを持つ事すらできない状態）\n\nhttps://www.pixiv.net/artworks/119693104\n\nその後、勝者の権利として分身の術（正式には忍法写身）の練習台として、二人のすずちゃんから搾り取られるという感じでお願いします（プレイ内容はお任せしますが、風凛さんが描く男性器に絡みつくような指の輪っか、足指、舌などが好きなので、見えなくなる本番や深いフェラ以外でお願いします）\n\n前回ちょっと台詞注文が多すぎたので今回の台詞は全て風凛さんにお任せします。\n\n最後に、可能であれば文字なし差分もお願いしたいです\n\n以上です、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ZrEdJVEcj1dJtfJ/works/31", "thumbnail_src": "https://si.imgix.net/dc2cc5a5/uploads/origins/fad6b5e0-ed5e-4864-8d5d-001a2ad5f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70c687663ca914968c479c765799a604", "thumbnail_srcset": "https://si.imgix.net/dc2cc5a5/uploads/origins/fad6b5e0-ed5e-4864-8d5d-001a2ad5f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70c687663ca914968c479c765799a604, https://si.imgix.net/dc2cc5a5/uploads/origins/fad6b5e0-ed5e-4864-8d5d-001a2ad5f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcb6c15ad550fae45cc524a7fcf648cf 2x, https://si.imgix.net/dc2cc5a5/uploads/origins/fad6b5e0-ed5e-4864-8d5d-001a2ad5f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12c3c028dd0a8ed3a53ed0eff3537ea5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZrEdJVEcj1dJtfJ/works/30", "thumbnail_src": "https://si.imgix.net/e1551364/uploads/origins/1b9e2cfc-8843-4ed3-ae60-32290d60dc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200