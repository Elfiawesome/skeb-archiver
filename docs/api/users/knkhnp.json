FF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e4314b0ed5fee373dddb20c0e23c5cd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/313", "thumbnail_src": "https://si.imgix.net/ca84d20f/uploads/origins/def5c1e8-2532-4966-869f-e538043e9f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bf81cbe98cd56ba410f316d6eeb9fea", "thumbnail_srcset": "https://si.imgix.net/ca84d20f/uploads/origins/def5c1e8-2532-4966-869f-e538043e9f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bf81cbe98cd56ba410f316d6eeb9fea, https://si.imgix.net/ca84d20f/uploads/origins/def5c1e8-2532-4966-869f-e538043e9f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=848b91e359ed13ce48addad095a196e0 2x, https://si.imgix.net/ca84d20f/uploads/origins/def5c1e8-2532-4966-869f-e538043e9f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08d4da30ae2164ac24f2bb80eb5791fd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/312", "thumbnail_src": "https://si.imgix.net/a9dbe131/uploads/origins/8ec355f2-f54b-4239-85f7-520a44c351e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a601b525426dbf7b2eb4faeb74be0471", "thumbnail_srcset": "https://si.imgix.net/a9dbe131/uploads/origins/8ec355f2-f54b-4239-85f7-520a44c351e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a601b525426dbf7b2eb4faeb74be0471, https://si.imgix.net/a9dbe131/uploads/origins/8ec355f2-f54b-4239-85f7-520a44c351e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=628c6d20475a73f3293f56a97c3a38a0 2x, https://si.imgix.net/a9dbe131/uploads/origins/8ec355f2-f54b-4239-85f7-520a44c351e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6229de393f9dfdcc9976dddcc901a171 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私の2人のプロレスキャラクター、スパロウとサリーMのイラストをまたお願いしたいのですが。\n\nこのシナリオでは、サリーMがスパロウを消耗させ、タイトなヘッドシザースで彼を閉じ込めることを希望します。  スパロウの頭はサリーMの力強い太ももの間にきつく挟まれ、サリーMはスパロウの体の上に自分の体を重ね、スパロウを動けなくする。  サリーMはスパロウをなすがままにしながら、彼のトランクスに手を伸ばし、執拗にストロークする。  スパロウには苦痛に満ちた表情で目を閉じさせ、サリーMにはスパロウをいとも簡単に支配したことに大喜びするような表情をさせたい。  できれば、スパロウの口にも猿ぐつわを入れてもらいたい。  \n\n背景についてはどんな解釈でも受け入れる。\n\nhttps://www.dropbox.com/scl/fo/dvqvkqadr0oyy5kn280tc/AC04voJjvLr0h0eM69fOFtI?rlkey=9db3ufdqr8iwtkzn9exnxlly8&st=waoy8rj3&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/311", "thumbnail_src": "https://si.imgix.net/45019d13/uploads/origins/f247ea54-e5dc-41c7-9f75-e46d84ab91eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9fd29a59904ca24610946fc86e0fce0", "thumbnail_srcset": "https://si.imgix.net/45019d13/uploads/origins/f247ea54-e5dc-41c7-9f75-e46d84ab91eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9fd29a59904ca24610946fc86e0fce0, https://si.imgix.net/45019d13/uploads/origins/f247ea54-e5dc-41c7-9f75-e46d84ab91eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e392d908c6f589ed428a339b66e04aa9 2x, https://si.imgix.net/45019d13/uploads/origins/f247ea54-e5dc-41c7-9f75-e46d84ab91eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5701e92d2f50640188daf456991e1afd 3x", "genre": "art", "nsfw": true, "body": "先日はありがとうございました。\n他の方のリクエストで筋肉娘を描かれていたのを見てぐっと来ましたので、今回は鬼っ子ハンターついなちゃんの後鬼さんが人間態から服ビリを経て鬼形態に変身するシチュをリクエストいたします。\n\n●後鬼(ごき)\n公式紹介：https://xn--n8jychz0k1d.com/character/ の「前鬼・後鬼」の下の方\n[人間態]\n体型：身長170cmの爆乳(鬼形態より若干控えめ)・引き締まったおなか・安産型 (参考：https://www.pixiv.net/artworks/119214897)\n服装：公式の女教師風のスーツ姿(＋パンスト型のタイツ、(服ビリの瞬間などに)下着の描写がある場合は黒色のブラジャー＋黒色のショーツ)\n[鬼形態]\n体型：身長180～190cmの爆乳・筋肉ムキムキ・やや青白い肌・二本の角 (https://www.pixiv.net/artworks/119187386)\n服装：公式の山伏風の戦闘服\n●シチュエーション・差分\n・(1)～(4)の順番で人間態から服ビリ全裸を経て鬼形態に変身するイメージです\n　・メガネは(2)で割れたり吹き飛んだりせずそのまま、(3)以降はかけていないと嬉しいです\n・(1)～(4)が1枚にまとめられているか、人間態の(1)(2)と鬼形態の(3)(4)の2枚にまとめられているか、前回(https://skeb.jp/@knkhnp/works/283)のような差分形式×2かはお任せします\n(1)人間態・女教師風のスーツ姿\n(2)人間態・身体から放出される力のようなもので着衣全てをビリビリに破いて裸を露わにした瞬間\n(3)鬼形態・全裸\n(4)鬼形態・山伏風の戦闘服\n●他\n・R-18の検索除けワードは「えっちなのはいけないと思うんやで」「えっついなちゃん」です(https://xn--n8jychz0k1d.com/guideline/)\n\nよろしくお願いいたします。\n\nhttps://xn--n8jychz0k1d.com/character/", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/310", "thumbnail_src": "https://si.imgix.net/d7d4cdf6/uploads/origins/d3715f9b-7de7-47e2-aac5-5e065a113b77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a937729f31b3b266b50fcf849d416497", "thumbnail_srcset": "https://si.imgix.net/d7d4cdf6/uploads/origins/d3715f9b-7de7-47e2-aac5-5e065a113b77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a937729f31b3b266b50fcf849d416497, https://si.imgix.net/d7d4cdf6/uploads/origins/d3715f9b-7de7-47e2-aac5-5e065a113b77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5b91d07715eb5ab351f8082c6d61f92 2x, https://si.imgix.net/d7d4cdf6/uploads/origins/d3715f9b-7de7-47e2-aac5-5e065a113b77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b109f555c06232e717ab722cf39d4304 3x", "genre": "art", "nsfw": true, "body": "いつもオリキャラのイラストの件でお世話になっております。\n前回のオリキャラ同士の百合イラストの件はありがとうございました。\n今回はオリキャラかつ実質複数人（メインとサブの2人）の依頼になりますが、ご都合が宜しければ宜しくお願いします。\n\n今回はやや活発系魔女っ娘（メイン、資料URL欄）がパンツにローターを入れられて、喘いでいるイラストをお願いしたいと思います。\n\nローターを入れた犯人が寡黙シスコン妹（サブ、別のオリキャラ　https://www.dropbox.com/scl/fo/tcccv4wmjsdjdk3yl53za/AEkvRTTjt2faPHupR--soBc?rlkey=6sw19lg2nrmfhh398jd6awow1&st=kaoyowv8&dl=0）である事を知っている感じでお願いしたいと思います。\n\n・追加希望点\n今回もパンツのアップカットをお願いしたいと思います。（アングルはお任せで大丈夫です。）\nまた、絶頂時と「今日も良い物が見れた…」みたいな表情をした寡黙シスコン妹のカットも希望します。（こちらは表情が分かる程度で大丈夫です。）\n※以前のクールキャラの依頼（https://skeb.jp/@knkhnp/works/239）の様な感じです。\n\n・備考\nパンツは資料の様な太めな縞の緑色縞パンでお願いします。\n\nサイベルトの有無や、体勢・その他キャラデザイン上の不明点は全てお任せで大丈夫です。\n\nhttps://www.dropbox.com/scl/fo/8e3fcr63ggtb3feb60544/AGHHI2-TSBYl2JZUfMMEIAc?rlkey=cdatlyxhk4hv6isdu0q2twrxu&st=wo1l564j&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/309", "thumbnail_src": "https://si.imgix.net/ee424fea/uploads/origins/359bebb0-9330-42f9-b716-0a0a519a5fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4cda1288691e73befe61b946b3dd349", "thumbnail_srcset": "https://si.imgix.net/ee424fea/uploads/origins/359bebb0-9330-42f9-b716-0a0a519a5fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4cda1288691e73befe61b946b3dd349, https://si.imgix.net/ee424fea/uploads/origins/359bebb0-9330-42f9-b716-0a0a519a5fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61205b3e118f094f6be80d56d6685443 2x, https://si.imgix.net/ee424fea/uploads/origins/359bebb0-9330-42f9-b716-0a0a519a5fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d730ad120e902359aa4520a377c7b4b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！プロレス少女サリーMと、私の2人のオーク、スパロウとヒート、そしてファイナルファイトのキャラクター、ポイズンのイラストをまたお願いしたいです。\n\nシナリオは、前回のシナリオ(https://skeb.jp/@knkhnp/works/305)でサリーMにあっさり倒され、釘付けにされた後、スパロウを捕らえ、アンドリューの十字架にきつく拘束しています。  彼は全裸で、口には猿ぐつわをはめられ、発泡スチロールのスパイクのついた貞操帯をつけられている。  サリー・Mは檻の中のチンコを触りながら、鞭で彼を打つ。\n\n手前では、ポイズンとヒートが互いに情熱的なセックスをしていて、スパロウはそれを見ることを余儀なくされ、なすすべもなくそこにぶら下がったまま二人の女性が愛し合っている光景に、檻の中で痛いほど興奮している。\n\nポイズンとヒートはスパロウより背が高く、かなり筋肉質であってほしい。  背景についてはどんな解釈も受け入れる。\n\nhttps://www.dropbox.com/scl/fo/x1jjn36hhgici1sv66rr9/AOB4WnsOZFcKLaSuTCzuEyE?rlkey=mhqvt8un17eh7cioe23etzpi8&st=9c4lsc0e&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/308", "thumbnail_src": "https://si.imgix.net/f6be15ff/uploads/origins/1eeb1949-c10f-4c61-bb92-5b4e686c6c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37617a42864d8a0ff1446f2bd23466cb", "thumbnail_srcset": "https://si.imgix.net/f6be15ff/uploads/origins/1eeb1949-c10f-4c61-bb92-5b4e686c6c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37617a42864d8a0ff1446f2bd23466cb, https://si.imgix.net/f6be15ff/uploads/origins/1eeb1949-c10f-4c61-bb92-5b4e686c6c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=105136271b2b9923ff2447677e9083f7 2x, https://si.imgix.net/f6be15ff/uploads/origins/1eeb1949-c10f-4c61-bb92-5b4e686c6c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae588655fbb4a96f3c823c62018c43f6 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ファイナルファンタジーVのトレントのモンスター少女（https://skeb.jp/@knkhnp/works/292）とバーツ・クラウザー（https://skeb.jp/@knkhnp/works/273、https://skeb.jp/@knkhnp/works/285）のイラストをお願いしたいです。\n\nシナリオとしては、バーツを全裸にして根元から挟み込むようにしたい。バーツの腕を上に引っ張り、枝のような腕で拘束する。  バーツの顔をトレントの胸に埋めて、バーツの体をトレントの胸に押し付けて情熱的に犯してほしい。  できれば、バーツよりもトレントの方が少し背が高く、筋肉質であってほしい。  \n\n背景はどんな解釈でもOK。\n\nhttps://www.dropbox.com/scl/fo/a7ekhogsiacvdyxtopkon/ADbKNdWtdsz6S7RKMBdAQoM?rlkey=tx2vmflmyq3uneycb71t0ugqm&st=28dee3v6&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/307", "thumbnail_src": "https://si.imgix.net/3b2afe89/uploads/origins/be3f7fa5-d3a4-42d1-b332-3927fcb9d1c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3a68f43f52d40fa9e497866f813086", "thumbnail_srcset": "https://si.imgix.net/3b2afe89/uploads/origins/be3f7fa5-d3a4-42d1-b332-3927fcb9d1c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3a68f43f52d40fa9e497866f813086, https://si.imgix.net/3b2afe89/uploads/origins/be3f7fa5-d3a4-42d1-b332-3927fcb9d1c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2c2322fb28863dc3d8aff89eb6ac6de 2x, https://si.imgix.net/3b2afe89/uploads/origins/be3f7fa5-d3a4-42d1-b332-3927fcb9d1c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5e74a63a9e8aa801597d2ec6482dc8c 3x", "genre": "art", "nsfw": true, "body": "リクエストさせていただきます\n\nキャラ：愛宕\n衣装：全裸\n\n結構前ですが以下の続きをお願いします\nhttps://skeb.jp/@knkhnp/works/89\n\n催眠オナホになった愛宕だが提督は目覚めないようにより強くかけておく\n愛宕おっぱいを揉みながら目を合わせている\n提督「愛宕、目を見て・・・そう、もう言葉はいらないね」\n愛宕「・・・・・」\n提督「すべてを忘れるお人形になりなさい」\n\n瞳が黒く濁った愛宕\n提督には抱きしめれながらおっぱいを吸い付き、揉まれて母乳もいただく\n提督「やっぱりこの乳最高すぎる」\n愛宕「・・・・・」\n\n無表情無反応の愛宕は中出しエッチされる\n顔も赤くならないほど強力に掛けられている\n提督「ほら、でかぱい揺らしながらエッチされる気分はどうだ！」\n愛宕「・・・・・・・」\n提督「お人形のまま全部受け止めろ！」\n愛宕はおっぱいを揺らし、母乳を散らしながらエッチされます\n\n細かいセリフ等はおまかせします。\nご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/306", "thumbnail_src": "https://si.imgix.net/6c042f0b/uploads/origins/e5663a69-0a52-4018-bf69-9bda6136e620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cf3caca76f92e093e7adcf41f8936f5", "thumbnail_srcset": "https://si.imgix.net/6c042f0b/uploads/origins/e5663a69-0a52-4018-bf69-9bda6136e620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cf3caca76f92e093e7adcf41f8936f5, https://si.imgix.net/6c042f0b/uploads/origins/e5663a69-0a52-4018-bf69-9bda6136e620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38f7f9512fbcf9c97ff53ced19d9326f 2x, https://si.imgix.net/6c042f0b/uploads/origins/e5663a69-0a52-4018-bf69-9bda6136e620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f3513e9848617e42678511330029bf3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@knkhnp/works/305", "thumb