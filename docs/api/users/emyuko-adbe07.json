yuko/works/52", "thumbnail_src": "https://si.imgix.net/7c98c4e1/uploads/origins/c84a50a8-bab6-41eb-9649-718b9c584b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e65b08eea0aabcec257fd2173034918", "thumbnail_srcset": "https://si.imgix.net/7c98c4e1/uploads/origins/c84a50a8-bab6-41eb-9649-718b9c584b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e65b08eea0aabcec257fd2173034918, https://si.imgix.net/7c98c4e1/uploads/origins/c84a50a8-bab6-41eb-9649-718b9c584b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=567719ae0caf51b3f17751a48bf1e8da 2x, https://si.imgix.net/7c98c4e1/uploads/origins/c84a50a8-bab6-41eb-9649-718b9c584b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=436f6c6e7476603e26fef067f8c18808 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@emyuko/works/51", "thumbnail_src": "https://si.imgix.net/be98cb11/uploads/origins/8134b033-afe9-4e93-bd6e-92d4500686aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7288f3edd2f2b90058ef19c05ac3841a", "thumbnail_srcset": "https://si.imgix.net/be98cb11/uploads/origins/8134b033-afe9-4e93-bd6e-92d4500686aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7288f3edd2f2b90058ef19c05ac3841a, https://si.imgix.net/be98cb11/uploads/origins/8134b033-afe9-4e93-bd6e-92d4500686aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8866171f6ef69335af35b5760c71324d 2x, https://si.imgix.net/be98cb11/uploads/origins/8134b033-afe9-4e