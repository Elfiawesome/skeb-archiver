-4886-42de-be31-60daa4d3250f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60aab64ecd72c8f9a24d543d62fc73df, https://si.imgix.net/37100fd5/uploads/origins/fd7ae3dd-4886-42de-be31-60daa4d3250f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=099599dd5aa00dcbeb9d7e85e5e971e1 2x, https://si.imgix.net/37100fd5/uploads/origins/fd7ae3dd-4886-42de-be31-60daa4d3250f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=401c81c1ea6dfc809647eaf6896ff4ba 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nka2co6さんの儚くて、芯が温かいイラストが大好きです。\n\n私が大切にしている曲が2つあるのですが、\nそれらをka2co6さんが聴いてイメージされた子を、描いていただけませんでしょうか...\nhttps://youtu.be/ofKzs7Ik92M\nhttps://youtu.be/j6Hs8Q2G-x4\n\n以下は自分が描くイメージですが、無視していただいても大丈夫です。\n・初音ミクとは無関係\n・白背景\n・メインカラーは紺～明るめの緑\n・両目が閉じている\n・画角は腰から上\n\nお忙しいのは重々承知しているのですが、どうしても見たいです...\nどうかよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/19", "thumbnail_src": "https://si.imgix.net/fdd7e340/uploads/origins/51d0e9df-bb73-4b34-8929-f72dc69debf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342832303acb3a30acff8f2c6e49df7d", "thumbnail_srcset": "https://si.imgix.net/fdd7e340/uploads/origins/51d0e9df-bb73-4b34-8929-f72dc69debf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342832303acb3a30acff8f2c6e49df7d, https://si.imgix.net/fdd7e340/uploads/origins/51d0e9df-bb73-4b34-8929-f72dc69debf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9191c469b5f7277740e91e9c434f303c 2x, https://si.imgix.net/fdd7e340/uploads/origins/51d0e9df-bb73-4b34-8929-f72dc69debf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05ae66366ca1daf2f5d38534957d352a 3x", "genre": "art", "nsfw": false, "body": "はじめまして、Xにて素敵な絵を見て依頼しようと思いました！\n自分のオリキャラを描いていただきたいです。詳細の資料は貼っておきます。\n\n-要望-\n鮭のネックレスをつけて欲しいです。\n髪型はボブくらいの長さでいくらの髪飾りをつけて欲しいです。\nあとの構図等はおまかせでお願いします。\n\n-使用用途-\nSNSのアイコン、YouTubeのサムネイルで使用する予定です\n\n楽しみに待っていますのでご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-C-0QXVarh71ohn5r5OzQFCqncOgd-US?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1-C-0QXVarh71ohn5r5OzQFCqncOgd-US?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/18", "thumbnail_src": "https://si.imgix.net/1bc951e6/uploads/origins/22591612-d74b-45d7-8e7d-d3b565aab670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e5809523a1848b14dd92a791b74e73", "thumbnail_srcset": "https://si.imgix.net/1bc951e6/uploads/origins/22591612-d74b-45d7-8e7d-d3b565aab670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e5809523a1848b14dd92a791b74e73, https://si.imgix.net/1bc951e6/uploads/origins/22591612-d74b-45d7-8e7d-d3b565aab670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=784bfc09cac726415368d5777db21393 2x, https://si.imgix.net/1bc951e6/uploads/origins/22591612-d74b-45d7-8e7d-d3b565aab670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e679eef61eb4d268d9e628a399bec52a 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n数学を愛する会という会の会長をしております、ikkunと申します。\nいつもTwitterで素敵な投稿を拝見しています。\ndesmosでかわいい女の子を絵を描かれているのを拝見して、もし可能であればdesmosでなにかキャラクターの絵を描いていただけると嬉しいなと思い、skebリクエストを送らせていただきました。\n印刷して部屋に飾ったり、Twitterのアイコンやヘッダーとして利用したいです。\ndesmosで書くのが難しければ、イラストでもうれしいです。\n（初めてskebを利用したので何か失礼な点があればすみません。）\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/17", "thumbnail_src": "https://si.imgix.net/e5c42807/uploads/origins/150b5649-93cd-4839-821f-9634074f50b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbdae853dc95cd386e50d3516cf5c979", "thumbnail_srcset": "https://si.imgix.net/e5c42807/uploads/origins/150b5649-93cd-4839-821f-9634074f50b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbdae853dc95cd386e50d3516cf5c979, https://si.imgix.net/e5c42807/uploads/origins/150b5649-93cd-4839-821f-9634074f50b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19aee507258b2dd024d59be68a86d6e0 2x, https://si.imgix.net/e5c42807/uploads/origins/150b5649-93cd-4839-821f-9634074f50b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ee17eb779c514fe05bdeb2b4b45c92e 3x", "genre": "art", "nsfw": false, "body": "霧の中のハリネズミのモノクロ線画（https://i.imgur.com/JHkvqWf.jpg）をあなたのスタイルで描いてほしい。抽象的な線画の背景が部分的にキャラクターの線と一体化しており、https://twitter.com/_k256/status/1702327555553202609 や https://twitter.com/_k256/status/1683210290555682817 のような感じだ。\n\nこれをGitHubのアバターとして使いたいです。", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/16", "thumbnail_src": "https://si.imgix.net/f055f4f0/uploads/origins/452402ba-be54-4931-b7c3-f70758269975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7240241ee4741721d6bdf50bea2f46f", "thumbnail_srcset": "https://si.imgix.net/f055f4f0/uploads/origins/452402ba-be54-4931-b7c3-f70758269975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7240241ee4741721d6bdf50bea2f46f, https://si.imgix.net/f055f4f0/uploads/origins/452402ba-be54-4931-b7c3-f70758269975?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=801d5a344a4df1cbf5964d264daa0b76 2x, https://si.imgix.net/f055f4f0/uploads/origins/452402ba-be54-4931-b7c3-f70758269975?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3991fd8108cf4c744065933abb54eb32 3x", "genre": "art", "nsfw": false, "body": "はじめまして！個人VTuberをしている宮乃やみと申します。  \n\nTwitterで流れてきたイラストを拝見し、柔らかなタッチと幾何学……と言っていいのかわかりませんが、模様とキャラクターが溶け合うようなアーティスティックな作品に目を奪われました……！\nぜひ私をモチーフにしたイラストも描いていただけないかと思いリクエストさせていただきました。\n\n【内容】\n宮乃やみをモチーフにしたイラスト\n\n曖昧なリクエストで恐縮ですが、ka2co6様のセンスで自由に描いていただけると嬉しいです。\n頂いたイラストは雑談配信の背景やサムネイルなどに利用させていただきたく存じます。\nそのため、背景については白〜淡い色をベースとしていただけますと幸いです。\n\n参考までに私の構成要素・好きなものなどのキーワードを列挙させていただきます。\n\n* コンピューター・計算・数学\n* 眼鏡\n* 星・夜\n* 冬・雪・氷\n\n\nご検討いただけますと幸いです！\n\n  【資料】\n宮乃やみ\n https://drive.google.com/drive/folders/1Rl-2M_dk39_PYYUCVaOnZeZP1Q7uNCEt  \n\n【配信チャンネル】 \n宮乃やみ\nhttps://www.youtube.com/c/miyanoyami", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/15", "thumbnail_src": "https://si.imgix.net/f608e637/uploads/origins/19550a86-62b4-4c93-8cf4-aa93e518fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fca70e21ff7cfaec2f36865c366ab8e", "thumbnail_srcset": "https://si.imgix.net/f608e637/uploads/origins/19550a86-62b4-4c93-8cf4-aa93e518fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fca70e21ff7cfaec2f36865c366ab8e, https://si.imgix.net/f608e637/uploads/origins/19550a86-62b4-4c93-8cf4-aa93e518fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd0afbf7fcf1e240d34aacae62974ce4 2x, https://si.imgix.net/f608e637/uploads/origins/19550a86-62b4-4c93-8cf4-aa93e518fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92d202428816a9389cbfad0376d36b84 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ka2co6先生！私はあなたに私のためにアバターを描いていただきたいと思っています。あなた自身のアバターや以前@Bozimoさんのために描かれたものと同じようなものが理想です。特に特別な要望はありません（なぜならka2co6先生の描く絵はどれもとても可愛いからです）、あなた自身のスタイルと創作のインスピレーションを大切にして、自由に描いていただければと思います！もし私の依頼を受けていただけるのであれば、本当に助かります。どうもありがとうございます〜\n\nhttps://pbs.twimg.com/media/F05MeJHaMAASl2Z?format=webp&name=900x900", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/14", "thumbnail_src": "https://si.imgix.net/eb84ef0e/uploads/origins/9c899943-6a1d-46f8-84ab-6c1c446c986b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30ff8919821f8b060bb4e801b2280d5f", "thumbnail_srcset": "https://si.imgix.net/eb84ef0e/uploads/origins/9c899943-6a1d-46f8-84ab-6c1c446c986b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30ff8919821f8b060bb4e801b2280d5f, https://si.imgix.net/eb84ef0e/uploads/origins/9c899943-6a1d-46f8-84ab-6c1c446c986b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a51f520005f223ab4551b530f4971219 2x, https://si.imgix.net/eb84ef0e/uploads/origins/9c899943-6a1d-46f8-84ab-6c1c446c986b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5df0f8305a6c9a5c23851cdd3104ec2f 3x", "genre": "art", "nsfw": false, "body": "ka2co6さんの絵が大好きです！\n\nよければ私のオリジナルキャラクターを描いて頂きたいと思いリクエストを送らせていただきました\n自然とゲームが大好きな14歳の女の子です\n\nご検討よろしくお願いいたします、！\nhttps://drive.google.com/drive/folders/1v_UUvxl_lk0tYLhUWql_vGbGe1-99hci?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/13", "thumbnail_src": "https://si.imgix.net/5e2241a1/uploads/origins/5d5266ff-fe8a-48c4-8849-3ad0419cb125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e4c92202aca112c70c5841910d30a56", "thumbnail_srcset": "https://si.imgix.net/5e2241a1/uploads/origins/5d5266ff-fe8a-48c4-8849-3ad0419cb125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e4c92202aca112c70c5841910d30a56, https://si.imgix.net/5e2241a1/uploads/origins/5d5266ff-fe8a-48c4-8849-3ad0419cb125?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba1d3173d0bd9abf0d438726319925c4 2x, https://si.imgix.net/5e2241a1/uploads/origins/5d5266ff-fe8a-48c4-8849-3ad0419cb125?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a85edc786bb6708314dff140c75af7e0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_k256/works/12", "thumbnail_src": "https://si.imgix.net/c1958a3a/uploads/origins/c3ae5cd9-534f-42d6-8fe8-1d14d327a9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&f