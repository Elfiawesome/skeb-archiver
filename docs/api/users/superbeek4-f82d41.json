-f882d5f9adf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df3b4c875ab22d1d0556acad615b6eb", "thumbnail_srcset": "https://si.imgix.net/329e6d48/uploads/origins/2c5e5a90-954f-4351-a148-f882d5f9adf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df3b4c875ab22d1d0556acad615b6eb, https://si.imgix.net/329e6d48/uploads/origins/2c5e5a90-954f-4351-a148-f882d5f9adf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59a7a9beb80ca92d90f4191c0d84dcce 2x, https://si.imgix.net/329e6d48/uploads/origins/2c5e5a90-954f-4351-a148-f882d5f9adf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=370bb6c09ce8d819a5774a9e51b694fd 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。\nハチさんの描くカッコいい表情が好きで今回連絡させていただきました。\n\nキャラクター：「サガ：デフォルト衣装（アークナイツ）」\n雰囲気としては力強く凛々しい感じでお願いします。\n（イメージとしてURLにサガのテーマBGMがあります。）\n\nもし依頼文や金額に問題があるようでしたら、再送依頼を掛けて頂けると助かります。\nご多忙でしたらキャンセルして頂いて構いません。\n御一考の程よろしくお願いします。\n\nhttps://youtu.be/D0CAc2vqtvs", "created_at": "", "completed_at": ""}, {"path": "/@superbeek4/works/10", "thumbnail_src": "https://si.imgix.net/93a6eae1/uploads/origins/5b15db24-9a6d-483c-adb6-fe6feb24a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aaef17827f908390847d01f158c5b92", "thumbnail_srcset": "https://si.imgix.net/93a6eae1/uploads/origins/5b15db24-9a6d-483c-adb6-fe6feb24a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aaef17827f908390847d01f158c5b92, https://si.imgix.net/93a6eae1/uploads/origins/5b15db24-9a6d-483c-adb6-fe6feb24a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9cb68c97e781d9790b5609c42910f24 2x, https://si.imgix.net/93a6eae1/uploads/origins/5b15db24-9a6d-483c-adb6-fe6feb24a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88d1056ae53f75fa495a1e232c792bf8 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラスト楽しく拝見しております。私のオリジナルキャラクターを描いていただきたく依頼させていただきます。\n\n〜要望〜\nオリジナルキャラクター : ルーセ (資料URL参照)  \n\n縦長めの構図になるようにお願いしたいです。\nハチさんの武器とキャラが組み合わさった構図がとてもかっこよくて好きなので、武器を持たせた(添えた)姿をぜひお願いしたいです。 \n\n装飾などの細部は描きやすいようにアレンジや省いていただいても大丈夫です。\n背景はハチさんにお任せします。\n\nご都合が悪い場合等、キャンセルしていただいて構いません。よろしくお願いします。\n\nhttps://twitter.com/nabeoec/status/1665217639013031939?s=46&t=6Lpd4k2qxpcRjzl-gY292A", "created_at": "", "completed_at": ""}, {"path": "/@superbeek4/works/9", "thumbnail_src": "https://si.imgix.net/2de65987/uploads/origins/24e4ac88-367d-4c00-ba48-e6d587902dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db40d478c2ac663d616850ffdd8be403", "thumbnail_srcset": "https://si.imgix.net/2de65987/uploads/origins/24e4ac88-367d-4c00-ba48-e6d587902dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db40d478c2ac663d616850ffdd8be403, https://si.imgix.net/2de65987/uploads/origins/24e4ac88-367d-4c00-ba48-e6d587902dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e20d3932d20f54135233f170df187509 2x, https://si.imgix.net/2de65987/uploads/origins/24e4ac88-367d-4c00-ba48-e6d587902dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=420d40ad09767e215d9b6b3ec1683759 3x", "genre": "art", "nsfw": false, "body": "この度依頼をさせて頂きます、タクマです\nアークナイツのジェシカの誕生日(3月3日)絵とカッターちゃんを描いてもらいたいです！\n\nキャラと衣装\n・ひな祭りのお雛様の装いのジェシカ(色は君子蘭のコーデのような紅に近い感じ)\n\n・随身(お雛様の護衛役)の格好のカッター(なるべく和装で色は黒を基調に紅を一部分。周りか背中にカッターの武器が有ると嬉しいです)\n\nシチュエーション、台詞\n・ひなあられや菱餅を食べたり、お雛様を見守るカッターなど、、お任せでも大丈夫です\n・ジェシカおめでとう等の言葉を添えるなどで\n\n以上となります、アクナイ3周年とジェシカの誕生日を華やかに祝う為に宜しくお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@superbeek4/works/8", "thumbnail_src": "https://si.imgix.net/567f9edc/uploads/origins/38ee989e-bf9e-40cc-a7bd-330c7ce85cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=990f45a4e4ae8d27f43131c2944c57cc", "thumbnail_srcset": "https://si.imgix.net/567f9edc/uploads/origins/38ee989e-bf9e-40cc-a7bd-330c7ce85cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&