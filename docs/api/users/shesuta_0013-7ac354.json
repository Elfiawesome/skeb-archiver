c18/uploads/origins/1821a5ad-d885-45f0-8e5c-9c1ea8b2eab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f429072a5a253f1c6b41e2b10fbf3dfe, https://si.imgix.net/88af8c18/uploads/origins/1821a5ad-d885-45f0-8e5c-9c1ea8b2eab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10742c503f5ddff63a8837392ccfc24c 2x, https://si.imgix.net/88af8c18/uploads/origins/1821a5ad-d885-45f0-8e5c-9c1ea8b2eab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4336decb416e10455f9bf614d4b9876f 3x", "genre": "art", "nsfw": false, "body": "前回も素晴らしい絵をありがとうございました。\nもう一度描いてほしいなと思いリクエストさせていただきます。\n\n・キャラクター\n前回のセクシーな恰好の女刑事さん\nhttps://skeb.jp/@shsuta_0013/works/18\n\n・シチュエーション\n1.https://skeb.jp/@shsuta_0013/works/18　こちらの作品の続きで、\n無事仕事を終えて、ちょっと怒りながら報告してるシーン\n\nポーズはシェスターさんにお任せします\n表情は、ちょっと怒ってるような感じで\n\n\n2．仕事を終えて、自宅で椅子かソファに座りながら、カフェオレを飲んでリラックスしているシーンをお願いします\n\n飲み物の位置ですが、手に持っているだけ、テーブルの上に置かれているだけでも問題ありません\n椅子に座ってるポーズはシェスターさんにお任せします\n表情は、ほっと一息ついてるようなリラックスしてる感じで\n\n\nセリフですが、どちらも無しで大丈夫です\n\n以上の2つのシーンを描いて欲しいです。\n\n金額に不足があれば「再送要請」をお願い致します。\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@shesuta_0013/works/20", "thumbnail_src": "https://si.imgix.net/4fbe90c0/uploads/origins/7e6b4e4e-fb72-4d56-af09-26546de6c7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c90fe08e8de044c7d788a7ec34f034c4", "thumbnail_srcset": "https://si.imgix.net/4fbe90c0/uploads/origins/7e6b4e4e-fb72-4d56-af09-26546de6c7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c90fe08e8de044c7d788a7ec34f034c4, https://si.imgix.net/4fbe90c0/uploads/origins/7e6b4e4e-fb72-4d56-af09-26546de6c7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40149fa269cf12a13e92504dd73edc0f 2x, https://si.imgix.net/4fbe90c0/uploads/origins/7e6b4e4e-fb72-4d56-af09-26546de6c7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6e3d1b9a6d96b8df0f8ad7dfd2dd157 3x", "genre": "art", "nsfw": true, "body": "素晴らしい作品を誠にありがとうございます。\nリョナ絵になりますが以下の通りにお願いいたします。\n\n・キャラクター\n前回のセクシーな恰好の女刑事さん\nhttps://skeb.jp/@shsuta_0013/works/18\n\n・シチュエーション\n1.https://skeb.jp/@shsuta_0013/works/18　こちらの作品の続きで、\n　飛び出すタイミングを誤ってしまい、アサルトライフルで１発左胸を撃たれて血飛沫が噴出してるようなシーン\n　表情は片目が閉じていて、被弾時の「う\"ッ」というセリフ\n　└差分　血飛沫が無く、傷口からは血がとめどもなく流れてるシーン\n　　表情も虚ろな目をして、死にかけている\n\n参考作品\nhttps://www.pixiv.net/artworks/50828060\n\n2．仰向けに倒れ込み瀕死になっているシーン\n　 虚ろな目をして、痙攣してるような感じで\n　 床に広がる血も程々に\n　└差分　死亡し、大量出血しているシーン\n　　痙攣も無く、既に死亡している\n　※床に広がる血の量、傷口の出血を多くして頂ければ嬉しいです\n\n以上2つのシーンをお願いしたいです。\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@shesuta_0013/works/19", "thumbnail_src": "https://si.imgix.net/a9fe084e/uploads/origins/ddb3afd1-c92f-40f1-8201-7f42b1df8319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d59009a7889cf01918c0865768421a", "thumbnail_srcset": "https://si.imgix.net/a9fe084e/uploads/origins/ddb3afd1-c92f-40f1-8201-7f42b1df8319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d59009a7889cf01918c0865768421a, https://si.imgix.net/a9fe084e/uploads/origins/ddb3afd1-c92f-40f1-8201-7f42b1df8319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92e349856cee6b80a967f86f9cc83184 2x, https://si.imgix.net/a9fe084e/uploads/origins/ddb3afd1-c92f-40f1-8201-7f42b1df8319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65d16f3b0542861821c152e2fb6921ce 3x", "genre": "art", "nsfw": true, "body": "・キャラクター  成熟冷静な女性刑事、黒髪ロングで真面目な性格。\n\n服装： https://imgur.com/MLsrJPm   https://imgur.com/6hX1wpA\n白い長袖襟付きシャツ+ベルト付きビジネスパンツ+足の甲が見えるハイヒール\n\n姿勢参考：\nhttps://pbs.twimg.com/media/F8rQJmpa4AAkMu8?format=jpg\nhttps://imgur.com/brvV5W8\n参考画像と同様の動作、キャラクターの手は上向きに縛られています、足を広げて軽くしゃがみます、つま先立ちで立つ。先生にキャラクターの全身を描いてもらいます。キャラクターの姿を際立たせるために、真正面からのアングルではなく、少し横からのアングルで撮影してください。\n\n\nシチュエーション：\n1、敵に拘束された女刑事は冷酷かつ不敵な表情を浮かべた\n2、女性刑事のシャツのボタンが外され、ブラジャーが露出していた。ズボンのベルトとファスナーが外されて下着が露出していましたが、ズボンは履いたままでした。ハイヒールは脱がされて脇に置かれ、つま先立ちで立っている素足が露出した。歯を食いしばって忍耐強く不屈の表情を浮かべます。https://imgur.com/hRNWdMD\n\nキャラクターの足を詳しく書いてください、足が好きなので、足の爪を描きます。服、パンツ、靴、表現のさまざまなオプションを別のレイヤーとしてリストしてください，差分を自由に組み立てられるようPSDをお送りください。", "created_at": "", "completed_at": ""}, {"path": "/@shesuta_0013/works/18", "thumbnail_src": "https://si.imgix.net/84817853/uploads/origins/223d2ff7-d7b8-47ec-a4f6-0bd9c75c0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f5d47870dc0b461c554657497e4e39", "thumbnail_srcset": "https://si.imgix.net/84817853/uploads/origins/223d2ff7-d7b8-47ec-a4f6-0bd9c75c0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f5d47870dc0b461c554657497e4e39, https://si.imgix.net/84817853/uploads/origins/223d2ff7-d7b8-47ec-a4f6-0bd9c75c0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6739ef5bd7ae849fc8ce2f951bc4ed5 2x, https://si.imgix.net/84817853/uploads/origins/223d2ff7-d7b8-47ec-a4f6-0bd9c75c0a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a324b7be7bc9102141391ca41690eac 3x", "genre": "art", "nsfw": false, "body": "前回も素晴らしい絵をありがとうございました。\n新規に新しく描いてほしいなと思いリクエストさせていただきます。\n\n・キャラクター\nセクシーな恰好の女刑事さん\n\n髪型：黒髪ロングヘア（画像のような前髪で）\n目：茶色\n胸：大きめ\n服装：白いワイシャツ（ボタンを開けている）、黒のブラジャー（見せつけている感じ）、ジーンズ、黒ブーツ\n\nAIで出力した画像及び他作者さんに依頼した絵を添付します。こちらも参考になりましたら幸いです。\nhttps://snipboard.io/6ZL4oq.jpg\nhttps://snipboard.io/gdzkfW.jpg\nhttps://snipboard.io/8OWNzX.jpg\nhttps://snipboard.io/kOzvht.jpg\n\nhttps://imgur.com/a/mebJNYk\n\n▽シチュエーション\n・女刑事さんが銃撃戦中、近くの壁に隠れて飛び出すかどうか考えてる場面（流れ弾が飛んできているなどはお任せします）\n\n・飛び出して銃を構えている場面（発砲させるかはお任せします）\n\n※こちらシチュエーションの参考画像です。ご参考になれば幸いです。\nhttps://imgur.com/a/lomU0ZI\n\nポーズに関してですが、シチュエーションの参考画像をそのままトレースしてもらっても構いません。\nまた、飛び出して銃を構えている場面の方ですが、全身でもカウボーイショットでもシェスターさんが良いなと思う構図でお任せします。\n\n以上の2つのシーンを描いて欲しいです。\n\n難しい内容で申し訳ありませんが、ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@shesuta_0013/works/17", "thumbnail_src": "https://si.imgix.net/89cb080b/uploads/or