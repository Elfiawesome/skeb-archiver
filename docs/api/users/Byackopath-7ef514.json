2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a0ba5652b60a47833e8ab6856bfe8d2 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nいつもXで作品を拝見しております。\n清潔感のある画風とエキセントリックな発想のギャップが個性的で、どの作品もとても大好きです！\n\nこの度は、私のOC2名、またはどちらか1名のイラストをリクエストしたくご連絡しました。\nびゃッこパス先生の独特な視点で描かれる作品が好きなため、細かな解釈等はお任せしたく思います。\nギャグっぽい空気感があるとなお嬉しいです。\n\nキャラクターシート内の情報がかなり多いですが、こちらは私の趣味で埋めているだけなので深く読み込んでいただく必要はございません。\n\n以上になります。情報の不備等がございましたら、内容を改めたものを再度お送りします。\nお手隙の際にご確認いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1oyw_d-4bbQ7uqVfihNSRLjgTVrWy-LJg", "created_at": "", "completed_at": ""}, {"path": "/@Byackopath/works/15", "thumbnail_src": "https://si.imgix.net/0a85bc8d/uploads/origins/97b56bf0-e6b6-4050-b260-f63e9fe0a7a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f593ac940242634ccbee5e0652b3570a", "thumbnail_srcset": "https://si.imgix.net/0a85bc8d/uploads/origins/97b56bf0-e6b6-4050-b260-f63e9fe0a7a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f593ac940242634ccbee5e0652b3570a, https://si.imgix.net/0a85bc8d/uploads/origins/97b56bf0-e6b6-4050-b260-f63e9fe0a7a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6601297b79c1e9191c7b371d2eb9cbec 2x, https://si.imgix.net/0a85bc8d/uploads/origins/97b56bf0-e6b6-4050-b260-f63e9fe0a7a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=337545fc8b40c81591161b93c99c7a48 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nいつもニコニコ静画やXで投稿されるイラスト楽しみにしています。\n世界観や絵のタッチがすごく好きです。\n\nリクエストなのですが私のアバターである黒羽イリスをチャールズ国王の赤い肖像画チックな感じで描いていただけませんでしょうか。\n（服装は参考URL内の立ち絵のまま赤く染まった感じでレイピア的な剣を持たせてほしいです。肩の蝶は不要です。）\n\nご都合よろしければ、ぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ArTe3b8OsZDLSvEibOkUUpF_HwbHXCM-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Byackopath/works/14", "thumbnail_src": "https://si.imgix.net/8fbc620a/uploads/origins/29050120-6756-4b8e-bf24-b1e48876b73c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=726a034c92db3f33208e3c2c178ddfe8", "thumbnail_srcset": "https://si.imgix.net/8fbc620a/uploads/origins/29050120-6756-4b8e-bf24-b1e48876b73c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=726a034c92db3f33208e3c2c178ddfe8, https://si.imgix.net/8fbc620a/uploads/origins/29050120-6756-4b8e-bf24-b1e48876b73c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c604a68833ed1802fca49f73c444120b 2x, https://si.imgix.net/8fbc620a/uploads/origins/29050120-6756-4b8e-bf24-b1e48876b73c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2b137b6b4e36a5f9c160da14748da43 3x", "genre": "art", "nsfw": false, "body": "かるかのイラストをお願いします。\n動画で使いたいと考えているので、16:9の1080Pぐらいの画像サイズでお願いします。全体的に仄暗いようなサイバーな雰囲気もあるようなイメージです。先日のこちら→ https://skeb.jp/@Byackopath/works/13 のイラストのようなキラキラした雰囲気もあれば嬉しいです。\n詳しくは資料URLや固定ツイートをご参考にして頂きたいですが、衣装などアレンジもお任せします。かわいく描いて頂けたら嬉しいです！\nちなみにイメージソングはこちらです→ https://youtu.be/o5go3Es8gA8?si=MposkiESFG4YRATy\n\n追記\n先日のツイートの方を拝見させていただき、背景事情について調べて理解しました。自分の思慮の浅さを恥じる思いです。今までのデザインに愛着もありましたが、今後の自分の作品や頂いたイラストなどをより沢山の人に見ていただけるようになりたいと思い、この機にデザインを改めました。今回はどうしてもびゃッこパス様にイラスト製作をお願いしたく、改めて依頼を送らせて頂きます。もしまた他の問題点などがあれば、今回のリクエストを却下して頂いても構いません。何卒よろしくお願い致します。\n\nhttps://x.com/CRC_601/status/1816748398097392002?t=W5IQlv8wfX-RYu-sRUN3mw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Byackopath/works/13", "thumbnail_src": "https://si.imgix.net/b8a0bdce/uploads/origins/5309dd6d-98bd-43e0-bdd7-8be42578f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fc7cbc0df19442750e4ed183edecba1", "thumbnail_srcset": "https://si.imgix.net/b8a0bdce/uploads/origins/5309dd6d-98bd-43e0-bdd7-8be42578f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fc7cbc0df19442750e4ed183edecba1, https://si.imgix.net/b8a0bdce/uploads/origins/5309dd6d-98bd-43e0-bdd7-8be42578f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1596c913812d51795be116776964203b 2x, https://si.imgix.net/b8a0bdce/uploads/origins/5309dd6d-98bd-43e0-bdd7-8be42578f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbfeaa5aecf850e13f339639888f8fba 3x", "genre": "art", "nsfw": false, "body": "初めまして、Za9Roと申します。\n先日の個展お疲れ様でした。\nフターシィとトロビヤスのイラストは今私の目の前におり、いつも元気を分けてくれます。\n\n今回のイラストに関してですが、終生の推しの1人、アインスエクスアウラをお願いしたいです。\n資料等はこちらにまとめましたが、もし足りない場合はお手数をおかけしますが適宜指示していただけると幸いです。\n\nttps://docs.google.com/document/d/1EQOH0eQXnF1QJMXpSTDiD_46R8_ZhYC3cGXLqRskKes/edit?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Byackopath/works/12", "thumbnail_src": "https://si.imgix.net/c862e8bf/uploads/origins/4b84b61b-6121-49d4-849c-3996fb27b4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9ce9680e2f37f6c08b96deb2c9e7f8d", "thumbnail_srcset": "https://si.imgix.net/c862e8bf/uploads/origins/4b84b61b-6121-49d4-849c-3996fb27b4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9ce9680e2f37f6c08b96deb2c9e7f8d, https://si.imgix.net/c862e8bf/uploads/origins/4b84b61b-6121-49d4-849c-3996fb27b4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8906592aa8bc059198f2a54ef2c84cea 2x, https://si.imgix.net/c862e8bf/uploads/origins/4b84b61b-6121-49d4-849c-3996fb27b4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5b44509aad665e5ac772ac24d703f93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Byackopath/works/11", "thumbnail_src": "https://si.imgix.net/c629c16d/uploads/origins/4538a4d6-242e-45