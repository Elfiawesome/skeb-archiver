.net/18725c85/uploads/origins/63e81488-023e-4f50-893b-77202f52a4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed019413d33a8c78f02840e2de88459, https://si.imgix.net/18725c85/uploads/origins/63e81488-023e-4f50-893b-77202f52a4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff176a7fb60fabd88f005e1e7ab64a6a 2x, https://si.imgix.net/18725c85/uploads/origins/63e81488-023e-4f50-893b-77202f52a4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa8d715a2844ebb0c0d5edb3f0e028d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Azusa1019/works/20", "thumbnail_src": "https://si.imgix.net/4873e249/uploads/origins/d111a603-1cab-4fbf-9250-068e1df9ff47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=648b5935f9173a4fb18dbc75b5e6a1fc", "thumbnail_srcset": "https://si.imgix.net/4873e249/uploads/origins/d111a603-1cab-4fbf-9250-068e1df9ff47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=648b5935f9173a4fb18dbc75b5e6a1fc, https://si.imgix.net/4873e249/uploads/origins/d111a603-1cab-4fbf-9250-068e1df9ff47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=389c8a89ab72a8611068d24c471f62dc 2x, https://si.imgix.net/4873e249/uploads/origins/d111a603-1cab-4fbf-9250-068e1df9ff47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad5fb46d47486bd581c4d4d153da3427 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\nAzusaさんがSkebで描かれていた\n褐色で勝気なアンナミラーズの制服姿のお姉様のイラストが好きなのでリクエストさせてください。\n\nリクエスト内容に関しましては、案A or 案B のどちらかを選択ください。\n\n案A\n・ギャル\n・褐色肌\n・美少女戦士セーラームーン×PEACH JOHNコラボシリーズ\n　「Newセーラームーン なりきりブラセット」を着用\n　※セーラー戦士およびスカートの着用有無はおまかせいたします。\n　　また可能であれば衣装はナイロン素材のテカテカ感を出していただければ、と思います。※\n\n案B\n・ギャル\n・褐色肌\n・チャイナドレス\n　※また可能であれば衣装はシルク素材のテカテカ感を出していただければ、と思います。※\n\n両案ともにSkebの印刷機能を使用予定のため、印刷映えする感じの構図を希望いたします。\n\n以上、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Azusa1019/works/19", "thumbnail_src": "https://si.imgix.net/0b582614/uploads/origins/5a6c48cf-375d-473d-9e2e-6839aa86383e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385287db1159cc5ca3e9ae6c10b4b6f2", "thumbnail_srcset": "https://si.imgix.net/0b582614/uploads/origins/5a6c48cf-375d-473d-9e2e-6839aa86383e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385287db1159cc5ca3e9ae6c10b4b6f2, https://si.imgix.net/0b582614/uploads/origins/5a6c48cf-375d-473d-9e2e-6839aa86383e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76f3a99ea8e247311924e8e5ce231241 2x, https://si.imgix.net/0b582614/uploads/origins/5a6c48cf-375d-473d-9e2e-6839aa86383e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=478e45b4d17ab92dd1f55688c04ab52b 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\nあなたが描いたカイニスの絵が大好きで、コミッションを申し込みます。\n\n私のオリジナルキャラクターを描いてください。\n\n以下のリンクにキャラクターの例と設定があります。\n\nhttps://drive.google.com/drive/folders/1mUYIAT_xajI_DFCXKjyQFiFqrPBcb_70?usp=sharing\n\n作品の使用目的は、個人的な感想とコミッションの例のサンプルです。\n\nそのためキャラクターの特徴がよく現れる姿勢が欲しいです。\n\n以下の姿勢のいずれかを選択して描くことをお勧めします。\n\nhttps://drive.google.com/file/d/1wgHdT5E1d6Qep6mFUgO8Iu_ELJ8K6Q03/view?usp=drive_link\n\n2番, 16番,24番のポーズをお勧めしますが、望まない場合は別のポーズを選んでもいいです。\n(選択肢の中にないポーズを描いてもOKです。)\n\n他の作家との重複を避けるために選択したポーズを私に教えてください。\n\n選択したポーズがSOLD OUTとして表示されます。\n\n**キャラクターの全身がすべて絵の中に入るようにしてください。(重要!)\n\n**オリジナルファイルからキャラクターレイヤー/サングラスレイヤー/ベルトレイヤー/バックグラウンドレイヤーは必ず！必ず！分離してください(重要!)\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Azusa1019/works/18", "thumbnail_src": "https://si.imgix.net/96781952/uploads/origins/01a1707b-1328-4b89-92bb-502e6fc71657?