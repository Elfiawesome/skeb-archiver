=200&h=200&s=0124a14aba0022ddf81294d776dc7b08 3x", "genre": "voice", "nsfw": false, "body": "格ゲーだてんち\n\nはぁっ！はッ！せいっ！えいっ！ええい！でやっ！たぁッ！よいしょそここのぉいっくよーくらえあったれ発射！もらった！隙あり！いけゆあこんやっつけて\n\nあッ！ああッ！うっ！うぐッ！…っ いたッ！いたた痛～いくッ！うぅーいやッ！やだそんなやめてぐぬぬも～んも！まだまだ！", "created_at": "", "completed_at": ""}, {"path": "/@datenti_yua/works/13", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3b4ab46468061db3a3e260a7475392", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3b4ab46468061db3a3e260a7475392, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17ea4c456154f8388899bc82633206ed 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0124a14aba0022ddf81294d776dc7b08 3x", "genre": "voice", "nsfw": false, "body": "ヤンデレゆあちゃんがみたいです", "created_at": "", "completed_at": ""}, {"path": "/@datenti_yua/works/12", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3b4ab46468061db3a3e260a7475392", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3b4ab46468061db3a3e260a7475392, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1890324247798792192%2FV1PFF6UC.jpg?bg=%23fff&auto=format%2Ccom