ix.net/476fabf6/uploads/origins/2bf8d454-d0f4-49db-9b62-8728c5c09196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b088b4c31f3906218fa8833a903c66c", "thumbnail_srcset": "https://si.imgix.net/476fabf6/uploads/origins/2bf8d454-d0f4-49db-9b62-8728c5c09196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b088b4c31f3906218fa8833a903c66c, https://si.imgix.net/476fabf6/uploads/origins/2bf8d454-d0f4-49db-9b62-8728c5c09196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3944d11f76990e005158038c2dffc1bc 2x, https://si.imgix.net/476fabf6/uploads/origins/2bf8d454-d0f4-49db-9b62-8728c5c09196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4d22fdd2f076d4e0b20ba70da348d1a 3x", "genre": "art", "nsfw": false, "body": "初めましてつかもとたかし先生、先生の同人誌のファンです。\n一度先生にイラスト依頼をしてみたいと思い先生の絵柄でもしよろしければ「粛聖!! ロリ神レクイエム☆」 の防犯ブザーを引くシーンのパロディイラストを描いて頂きたくリクエストします。\n\n■キャラは魔法少女リリカルなのはシリーズからヴィータちゃんを\n■衣装は騎士服か私服か動画にある衣装どれかからをお願いいたします。\n\n〇表情は動画のゴミを見るような表情でお願いいたします。\n\n面倒な指定かもしれませんが、もしよろしければ受けて頂けると嬉しいですよろしくお願いいたします。\n\nhttps://www.youtube.com/watch?v=Ci_zad39Uhw&ab_channel=%E3%81%97%E3%81%90%E3%82%8C%E3%81%86%E3%81%84", "created_at": "", "completed_at": ""}, {"path": "/@tsukamotea/works/18", "thumbnail_src": "https://si.imgix.net/2ba5f197/uploads/origins/3d2b4890-7d9e-471c-ae85-bb74531af710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffcd02a3eecc6bfe07400df16f94a469", "thumbnail_srcset": "https://si.imgix.net/2ba5f197/uploads/origins/3d2b4890-7d9e-471c-ae85-bb74531af710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffcd02a3eecc6bfe07400df16f94a469, https://si.imgix.net/2ba5f197/uploads/origins/3d2b4890-7d9e-471c-ae85-bb74531af710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd6642ba5ec92f752d4e821d66875b40 2x, https://si.imgix.net/2ba5f197/uploads/origins/3d2b4890-7d9e-471c-ae85-bb74531af710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35a8cf944caaa462eb60b59e0fb99354 3x", "genre": "art", "nsfw": true, "body": "とある科学の超電磁砲のキャラクター、御坂美琴のイラストをお願い致します。\n\n服装は資料の突撃天使かのん、アレンジコスチューム。\n\nシチュエーションは武器のトンファーを構え格好良く触手と戦ってるシーン、そのシーンの背後に触手に敗北しコスチュームはあちこち破られオッパイが乳首まで丸見え、全身精液まみれ状態で触手に凌辱されるシーン。\n\n以上のリクエストをお願い致します。\n\nhttps://www.pixiv.net/artworks/74205525", "created_at": "", "completed_at": ""}, {"path": "/@tsukamotea/works/17", "thumbnail_src": "https://si.imgix.net/036c2d52/uploads/origins/5f619bbb-6ae5-4a39-bb75-eb4b47336928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=038c7ce951cb139c96d6a1f7224a7004", "thumbnail_srcset": "https://si.imgix.net/036c2d52/uploads/origins/5f619bbb-6ae5-4a39-bb75-eb4b47336928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=038c7ce951cb139c96d6a1f7224a7004, https://si.imgix.net/036c2d52/uploads/origins/5f619bbb-6ae5-4a39-bb75-eb4b47336928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13a6934d401e6f1726d028d4b69f16ec 2x, https://si.imgix.net/036c2d52/uploads/origins/5f619bbb-6ae5-4a39-bb75-eb4b47336928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c73027be9b6f926cc44f1fd5c2e7e0a3 3x", "genre": "art", "nsfw": true, "body": "つかもとたかし様\n前回は素晴らしいフェイトさんを描いて頂きありがとうございました。\n\n今回も魔法少女リリカルなのはstrikersの\nフェイト・T・ハラオウンをカラーでお願いします。\n\n衣装は真ソニックフォーム\n差分が可能ならば公式の下着姿と戦闘機人スーツをお願いしたいです。\n難しければ、戦闘機人スーツのみか両方無しでも構いません。\n\nシチュエーションはガジェットドローンの触手に拘束されている状態。\n等身高めの凄いムチムチな感じで\nお尻もTバックになっていると嬉しいです。\nポーズは資料URLと同じ様にお尻を強調してお願いします。\n\n表情は\n恥ずかしがりながらも悔しそうな表情\n戦闘機人は洗脳された無表情でお願いします。\n\nまたも、注文が多く申し訳ありませんが\nご検討の程よろしくお願い致します。\n\nhttps://pbs.twimg.com/media/Fo6kRDZaYAEbHd1?format=jpg&name=medium", "created_at": "", "completed_at": ""}, {"path": "/@tsukamotea/works/16", "thumbnail_src": "https://si.imgix.net/9f642c1f/uploads/origins/2e37c82a-ee5e-4b0b-bd92-c910171bae58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=770028b5baf5ce1eaba50bfddcdf7e63", "thumbnail_srcset": "https://si.imgix.net/9f642c1f/uploads/origins/2e37c82a-ee5e-4b0b-bd92-c910171bae58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=770028b5baf5ce1eaba50bfddcdf7e63, https://si.imgix.net/9f642c1f/uploads/origins/2e37c82a-ee5e-4b0b-bd92-c910171bae58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b336b106361d3dfb82140fb4234a301f 2x, https://si.imgix.net/9f642c1f/uploads/origins/2e37c82a-ee5e-4b0b-bd92-c910171bae58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82e31b903f1b399bbcd5d38b21c2fca8 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nなのはDetonationより大人化イリスをお願いします。\nシチュエーション\nDetから数年後、エルトリア復興の目処がついたところで管理局から保護観察の終了とスカウトを受けたイリス。装備試験隊に配属され、なのはたちを驚かせようと新型のヘッドギア装備の試験を名目に模擬戦を挑んでくる。\n衣装 武装侵攻形態アスタリア\n可能でしたら以下のシュテルのようなヘッドギアを差分(着脱、バイザー下の眼透過)でお願いします。\n https://www.pixiv.net/artworks/24948637\n体型  スタイル抜群の巨乳でお願いします。\n構図等\n武器のムチを構えた、少年誌程度のセクシーでかっこいいポーズであれば何でもかまいません。\n可能でしたら差分でパンチラして赤面するシーンをお願いします。\nこちらも少年誌のエッチピンチシーン程度の描写でお願いします。\n細かい装飾は省略して大丈夫です。\n壁紙にしたいので、3840×2160程度の横長キャンバスレイヤー未統合PSDでお願いします。\n\nよろしくお願いします。\n\nhttps://www.nanoha.com/archive7/character_iris.html", "created_at": "", "completed_at": ""}, {"path": "/@tsukamotea/works/15", "thumbnail_src": "https://si.imgix.net/aa7cf1e8/uploads/origins/5f5338d0-cb8e-4b2b-9c97-ec3173faea9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3947ea503c96ea4478e129a1afca5ea5", "thumbnail_srcset": "https://si.imgix.net/aa7cf1e8/uploads/origins/5f5338d0-cb8e-4b2b-9c97-ec3173faea9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3947ea503c96ea4478e129a1afca5ea5, https://si.imgix.net/aa7cf1e8/uploads/origins/5f5338d0-cb8e-4b2b-9c97-ec3173faea9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e596aff40b7ca62cef76b9b75b0ea29 2x, https://si.imgix.net/aa7cf1e8/uploads/origins/5f5338d0-cb8e-4b2b-9c97-ec3173faea9c?bg=%23fff&auto=