format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b263dcb9efec556d7fbfabe999aebe7f 2x, https://si.imgix.net/3ded8c26/uploads/origins/10fc242d-005a-4daa-bce9-6a600821b507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79fdfb009f4808cdfae5314b0bdfe266 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お忙しいところ失礼いたします！先生の画風と作品がとても好きで、ぜひ私のOCを描いていただきたいと思いまして…！\n\n【キャラクター設定】  \n種族：黒猫  \n身長：165cm  \n年齢：14歳  \n\n詳細：  \nとある極道の御曹司で、裏では闇の魔法使いとして活動しています。  \n優雅で冷たい性格で、命を弄ぶことを楽しみにしています。  \n\n【ご希望】  \n・服を着たバージョンでお願いします  \n・キャラクターの性格を考慮した上で自由に描いていただいて結構です\n\nもし提示した金額が不適切な場合は、改めてリクエストを送信させていただきます。  \nこのお願いをお受けいただけましたら大変嬉しく思います。  \n\n最後までお読みいただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1GYrAGXR_6PAvvmpnY24nc815BP3Qnsek", "created_at": "", "completed_at": ""}, {"path": "/@sue36v/works/169", "thumbnail_src": "https://si.imgix.net/ea153437/uploads/origins/d7fc5107-a03c-4db8-af92-7c6b8902c3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=997b0b190bcb867e9c47e82fd3b84063", "thumbnail_srcset": "https://si.imgix.net/ea153437/uploads/origins/d7fc5107-a03c-4db8-af92-7c6b8902c3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=997b0b190bcb867e9c47e82fd3b84063, https://si.imgix.net/ea153437/uploads/origins/d7fc5107-a03c-4db8-af92-7c6b8902c3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=494c4e55e1b74e713ba6c3c89fb95b6c 2x, https://si.imgix.net/ea153437/uploads/origins/d7fc5107-a03c-4db8-af92-7c6b8902c3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e595d314ed12de9ac9eddfd732d9ece2 3x", "genre": "art", "nsfw": false, "body": "キスしているシーンを描いていただけますか？\nタイガー・スネークはウィッシュ・ドラゴンよりもサイズが小さいが、ずる賢くて遊び好きな性格で、しばしばウィッシュ・ドラゴンに言い寄ってくる。\nウィッシュ・ドラゴンはサイズが大きく、内気でストイックな性格です。\n\nキスの直後のシーンでも構いません！\n\n参考文献\nウィッシュ・ドラゴン：\nhttps://drive.google.com/drive/folders/13BJZJ0-PUii5Gb7MgCOZ3UluzEw3okRi\nタイガースネーク : https://drive.google.com/drive/folders/1PR00eLVGz_nWMa1cruXwH6Ug3ov-zOT6", "created_at": "", "completed_at": ""}, {"path": "/@sue36v/works/168", "thumbnail_src": "https://si.imgix.net/e28e9356/uploads/origins/c7204ee6-6f80-4c1d-83bd-04a73eb75771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0f4cc08b683b601f5dd5c6602930c5", "thumbnail_srcset": "https://si.imgix.net/e28e9356/uploads/origins/c7204ee6-6f80-4c1d-83bd-04a73eb75771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0f4cc08b683b601f5dd5c6602930c5, https://si.imgix.net/e28e9356/uploads/origins/c7204ee6-6f80-4c1d-83bd-04a73eb75771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a2d9fa8c7e50afd4ecfbf76ae343b1e 2x, https://si.imgix.net/e28e9356/uploads/origins/c7204ee6-6f80-4c1d-83bd-04a73eb75771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a34a9c74784fe1ca03dfdefc185b3d3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のボーイフレンドと一緒に作品を描いていただけませんか？二人とも着物か浴衣を着ていたら超カッコイイと思います。着物や浴衣のデザインは自由です。ポーズは隣同士で手をつないで立っているとか。何かかわいい。\n\n私、青龍は鬣狼より背が低く、物静かで内気です。私のボーイフレンドである鬣狼は背が高く、とても気遣いができる。どちらも体重は普通。\n\nたてがみ狼のデザインを少し変更してください。手足の先を白ではなく黒に変えてください。そして尻尾は本物のたてがみ狼に合うように、先端が白いものに変えてください。デザインは本物のたてがみオオカミとほぼ完全に一致するはずです。\n\nありがとうございました！\n\nたてがみオオカミ\nhttps://drive.google.com/drive/folders/12zCXZ1xOVwpzphH_n2c4UnhftzUKBhEu\n\nブルー・ドラゴン\nhttps://drive.google.com/drive/folders/1C2qD5sVQfrrHbXoCINaIpW5WdoBWONZJ\n\nhttps://drive.google.com/drive/folders/1C2qD5sVQfrrHbXoCINaIpW5WdoBWONZJ", "created_at": "", "completed_at": ""}, {"path": "/@sue36v/works/167", "thumbnail_src": "https://si.imgix.net/083ec04b/uploads/origins/17c85752-3f3f-41b0-82b6-9488d2a877fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2683e349912a16dc80567c3ae9aee6b", "thumbnail_srcset": "https://si.imgix.net/083ec04b/uploads/origins/17c85752-3f3f-41b0-82b6-9488d2a877fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2683e349912a16dc80567c3ae