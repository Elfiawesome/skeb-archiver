-bc0a-548c9d9cdc68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d2fc496562f717d8502bfba284b28be", "thumbnail_srcset": "https://si.imgix.net/e8521342/uploads/origins/f763d999-f9cd-44be-bc0a-548c9d9cdc68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d2fc496562f717d8502bfba284b28be, https://si.imgix.net/e8521342/uploads/origins/f763d999-f9cd-44be-bc0a-548c9d9cdc68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d96d5b815146cb991ac1d6545bbbae65 2x, https://si.imgix.net/e8521342/uploads/origins/f763d999-f9cd-44be-bc0a-548c9d9cdc68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=416e257dd25213a59a9b1704861f112a 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。続いての依頼失礼します。\n『StarGazer』のハマルとキファのイラストをお願いしても大丈夫でしょうか？\nできれば海に行っている感じですと、とても嬉しく思います。\n\n以前参加した村でこの二人で一緒に海を見に行ったため、季節のこともあって見てみたいなと思いリクエストしました（ログなどは見なくても大丈夫です……！）\nまた、ラフやらくがきなどCONBEさんが描きやすいもので大丈夫です。\nスケジュールが厳しければ断っていただいても構いません。\n\nお忙しい中続けての依頼ですみません。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@M_gametweet/works/16", "thumbnail_src": "https://si.imgix.net/bb876e5c/uploads/origins/c1459805-c8fb-44e4-b4a4-72461eb3db3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=810deb4d073451a8643f0408d935a117", "thumbnail_srcset": "https://si.imgix.net/bb876e5c/uploads/origins/c1459805-c8fb-44e4-b4a4-72461eb3db3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=810deb4d073451a8643f0408d935a117, https://si.imgix.net/bb876e5c/uploads/origins/c1459805-c8fb-44e4-b4a4-72461eb3db3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79fd0aac87d83d181115458de8a9806c 2x, https://si.imgix.net/bb876e5c/uploads/origins/c1459805-c8fb-44e4-b4a4-72461eb3db3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1d3a8a90d4b05876c7097b8a6dfd4a2 3x", "genre": "art", "nsfw": false, "body": "先日はとても素敵なイラストをありがとうございました。\nCONBEさんの絵柄と描き込みが本当に素敵で、またリクエストさせていただきたくご連絡しました。\n\n今回はCoCの自探索者のふたりをお願いいたします。長く使っており愛着のあるふたりです。\nキャラの概要と簡単な見た目についてはこちらをご査収下さい。\n\nhttps://ajitama-gohan.tumblr.com/post/657996610774630400\n\nイチャイチャするよりはくっつきながらケンカしているようなカップルで、まはるは笑顔とリアクションの大きな元気タイプ、ロビンは表向きはちょっと冷めてて意地悪な男です。が、お互いへの感情の大きさはロビン≧まはるです。\nCONBEさんの絵柄でふたりを見せてもらえましたら幸いです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@M_gametweet/works/15", "thumbnail_src": "https://si.imgix.net/39c94984/uploads/origins/399e037e-de91-4b46-b7ec-74e2f8005b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1a551e5be6bde27d991f438ac233b61", "thumbnail_srcset": "https://si.imgix.net/39c94984/uploads/origins/399e037e-de91-4b46-b7ec-74e2f8005b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1a551e5be6bde27d991f438ac233b61, https://si.imgix.net/39c94984/uploads/origins/399e037e-de91-4b46-b7ec-74e2f8005b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=102f8ffb1b60858d2196cbb3177584e9 2x, https://si.imgix.net/39c94984/uploads/origins/399e037e-de91-4b46-b7ec-74e2f8005b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2fa9f34a28bb7c3663e24fc1c32a65f 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n先日、キャラチップ「StarGazer」を使ったマンション人狼にて遊ばせて頂く機会があり、大変楽しい思い出を作ることができました。\nもしよろしければ、同キャラチップより、攻撃指揮ダビー、技術指揮シトゥラのイラストをお願いしたく、リクエストをお送りしました。\n推しの新規絵が見たい一心ですので、構図など諸々お好きに描いて頂ければと思います。\nもし迷われるようでしたら、実際のやりとりの抜粋をお付けしますので、必要に応じてご参照下さい。\nよろしくお願い致します。\n\nhttps://moo-tyaunen.ssl-lolipop.jp/txiloda/picture.php?user=beniii&file=sglog3.png\nhttps://moo-tyaunen.ssl-lolipop.jp/txiloda/picture.php?user=beniii&file=sglog4.png\nhttps://moo-tyaunen.ssl-lolipop.jp/txiloda/picture.php?user=beniii&file=sglog5.png", "created_at": "", "completed_at": ""}, {"path": "/@M_gametweet/works/14", "thumbnail_src": "https://si.imgix.net/31f39b24/uploads/origins/9f3b547e-c6d4-42c0-b009-4187c2b4347b?bg=%23fff&auto=format%2Ccompress&fm=webp&f