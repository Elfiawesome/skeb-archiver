93c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3f31a3bd81366129aee39d3ff0a2c10 3x", "genre": "art", "nsfw": true, "body": "初めてリクエストします。\n\n『聖騎士アンジェリーナの屈辱』から姫様のif後日談お願いします。\n\n竿役はアンと姫様を犯していた太めの巨漢男\n\n姫様を一旦預かり(アンは仲間に)、宿の一室で体を重ねる。最初はただの肉便器扱いしていた巨漢男だが、姫様の美貌と感じる声に次第に惚れ、本気で嫁にするために愛のセックスをする。\n\n姫様も次第に甘い声を出し、巨漢男に身を委ねる。\n\n以上です。二人とも最初から全裸です。ご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@craft_kim/works/9", "thumbnail_src": "https://si.imgix.net/4dc1147d/uploads/origins/718dc2fa-d641-41d4-b42d-5cad347fdebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63b37ed49e765b99e381aec2ac66cddf", "thumbnail_srcset": "https://si.imgix.net/4dc1147d/uploads/origins/718dc2fa-d641-41d4-b42d-5cad347fdebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63b37ed49e765b99e381aec2ac66cddf, https://si.imgix.net/4dc1147d/uploads/origins/718dc2fa-d641-41d4-b42d-5cad347fdebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4858d848e70262a4201b83dc64cb659b 2x, https://si.imgix.net/4dc1147d/uploads/origins/718dc2fa-d641-41d4-b42d-5cad347fdebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a1309e39720d143e33d46a16dc774ae 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@craft_kim/works/8", "thumbnail_src": "https://si.imgix.net/d71dbe29/uploads/origins/7689aa9d-ee1f-4a84-9d35-95110ac965d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554a8c8be97f16097d6b7623b36d9db8", "thumbnail_srcset": "https://si