841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c951be49655407b8f2210e5f9038dc3f, https://si.imgix.net/7b8a6d6f/uploads/origins/8f5ad4e0-e751-49c5-9b75-0d64b5c3c841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa2034681c601c413c4d1e8949c1eb89 2x, https://si.imgix.net/7b8a6d6f/uploads/origins/8f5ad4e0-e751-49c5-9b75-0d64b5c3c841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df5f5a9bc379eb05145c8cfb69be3776 3x", "genre": "art", "nsfw": false, "body": "夜分遅くにこんばんは\nハロウィンかサマーっぽいかみあくのGMが見たいです。\n立ち絵だと後々頒布できたりして便利かなと思ったのですが立ち絵の依頼を受け付けていなかったら一枚絵だとありがたいでう。構図などはお任せします！\n\n何卒よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@river1060_2/works/19", "thumbnail_src": "https://si.imgix.net/55c28ab9/uploads/origins/8719a442-427a-42c1-a8cf-c8f53c3e2111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e33fe010252fc97c003116b8b3f2ad", "thumbnail_srcset": "https://si.imgix.net/55c28ab9/uploads/origins/8719a442-427a-42c1-a8cf-c8f53c3e2111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e33fe010252fc97c003116b8b3f2ad, https://si.imgix.net/55c28ab9/uploads/origins/8719a442-427a-42c1-a8cf-c8f53c3e2111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c39510ded0b7aea56c367310bc56f0a1 2x, https://si.imgix.net/55c28ab9/uploads/origins/8719a442-427a-42c1-a8cf-c8f53c3e2111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c95327b100eb0d4eb1efd72fee92006 3x", "genre": "art", "nsfw": false, "body": "ろとあだ極道の探索者の顔を書いていただきたいです～！\n赤髪のヤクザでキック85より経理57の方が出目の良い人です\n昔ながらのものが好きで義理人情が好きな保守派　相方落語家の師匠のファンです\n若頭として面倒見は良い方で、昔飢えた経験もあり、特に食に困ることがあれば飯を奢るたちです\n\n自由に書いてください！　刺青とかの正確性は気にしないでいいです　炎っぽい感じです\n\n■参考資料\nhttps://x.com/KG3it/status/1819307091309613327\n\n■CS（長いので読まなくて大丈夫です！）\nhttps://charasheet.vampire-blood.net/ma0ba2ecdd0ed0a4c1687b24c10556aa0", "created_at": "", "completed_at": ""}, {"path": "/@river1060_2/works/18", "thumbnail_src": "https://si.imgix.net/a973720d/uploads/origins/c940c8cb-fe5d-43a6-9f34-73e113884f87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8600856c4698d60694f754a153f59ef7", "thumbnail_srcset": "https://si.imgix.net/a973720d/uploads/origins/c940c8cb-fe5d-43a6-9f34-73e113884f87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8600856c4698d60694f754a153f59ef7, https://si.imgix.net/a973720d/uploads/origins/c940c8cb-fe5d-43a6-9f34-73e113884f87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b8b76c83ce9aa61ea29897d4c48dc6d 2x, https://si.imgix.net/a973720d/uploads/origins/c940c8cb-fe5d-43a6-9f34-73e113884f87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad38f334fdf41912ee6a47199db533a2 3x", "genre": "art", "nsfw": false, "body": "トロ川さんお疲れ様です～！いつもお世話になっております。\n\n自宅の十二星座館殺人事件PCをぜひ描いていただきたいです。\nHO蠍座、顔面傷だらけの207cm38歳女性です！\n\nポーズや構図はお任せでお願いしたいです～\n思うがままに描いていただけると嬉しいです！よろしくお願いいたします！\n\n■立ち絵\nhttps://drive.google.com/drive/folders/18XSEzsXnrPnzyMFXiqYeYcwSJBOSCLtt?usp=sharing\n\n■CS\nhttps://iachara.com/view/4712638\n\n■細かい設定\nhttps://fusetter.com/tw/GvMKexKL\nhttps://fusetter.com/tw/a4D1uHyE", "created_at": "", "completed_at": ""}, {"path": "/@river1060_2/works/17", "thumbnail_src": "https://si.imgix.net/f07e1976/uploads/origins/81adada8-e66e-4434-b503-fc9b6d0cc5a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8cae5b6b2b4021c96e8c31404dd7c8", "thumbnail_srcset": "https://si.imgix.net/f07e1976/uploads/origins/81adada8-e66e-4434-b503-fc9b6d0cc5a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8cae5b6b2b4021c96e8c31404dd7c8, https://si.imgix.net/f07e1976/uploads/origins/81adada8-e66e-4434-b503-fc9b6d0cc5a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05bfd1d81461cf309febf55c2c86ca31 2x, https://si.imgix.net/f07e1976/uploads/origins/81adada8-e66e-4434-b503-fc9b6d0cc5a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cfd75b3a20c5359692d9dcdd7cf7d9d 3x", "genre": "art", "nsfw": false, "body": "トロ川さん こんばんは ねじです いつもお世話になっております\nリクエスト内容なのですが、ドロップアウトディスパイアというシナリオを通過した探索者を描いて頂きたいです。\nどんな形でも構いません！おまかせでお願いします🙏\n\n相方の顔↓\nhttps://twitter.com/harutarou_s/status/1684503155504193539?s=21&t=1NEZP5dltCI7O9s7eDxCTA\n自分の探索者↓\nhttps://drive.google.com/drive/folders/12sl3HnZ_nfF6TB25fy1__9yxbc3P2XNl\n自分の探索者のCS↓\nhttps://iachara.com/view/6287281", "created_at": "", "completed_at": ""}, {"path": "/@river1060_2/works/16", "thumbnail_src": "https://si.imgix.net/0eed6b7e/uploads/origins/0f415f25-e9f0-4cad-8982-7f8e18e5539b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d2fae0f95a408ef7f2081a45274fd2", "thumbnail_srcset": "https://si.imgix.net/0eed6b7e/uploads/origins/0f415f25-e9f0-4cad-8982-7f8e18e5539b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d2fae0f95a408ef7f2081a45274fd2, https://si.imgix.net/0eed6b7e/uploads/origins/0f415f25-e9f0-4cad-8982-7f8e18e5539b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e9ce7d660fca2cbb37a6a851162602f 2x, https://si.imgix.net/0eed6b7e/uploads/origins/0f415f25-e9f0-4cad-8982-7f8e18e5539b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0f99404d4b8998b095379fd4d633f35 3x", "genre": "art", "nsfw": false, "body": "トロ川様初めまして。\nいつもトロ川様のシナリオをとても楽しく遊ばせていただいております。\n先日『悪魔の唇』をPLとして通過させていただき、自陣をシナリオ作者様であるトロ川様に是非描いていただきたい…！と思い、リクエストをお送りいたしました。\n\n■依頼内容\nトロ川様作CoCシナリオ『悪魔の唇』自陣\n(KPPL様方承諾済)\n・構図・ポーズ全てお任せ\n・服装も自由に変更OK\n・資料に簡潔な関係性を記載しておりますが、考慮いただかなくても大丈夫です\n\n■探索者資料\nhttps://drive.google.com/drive/folders/11dJLYhj0RY66zbLb1L-wRkUoIhc3eDWX\n(秘匿内容を含んでおります)\n(PC個別資料がありますが不要でしたらご放念ください)\n\n【HO1】\n192cm/29歳/筋肉質\n黒髪・右目が黒灰で左目が黄\n物静かで寡黙\n【HO2】\n172cm/21歳/猫背細身\n黒髪で毛先がグレー　紫目に下睫毛\n根が暗くて自己肯定感が低い\n【HO3】\n178cm/27歳/標準体型\n黒髪で毛先が紫がかった青　かき上げ前髪　薄紫目\n優しそうに見えて大雑把でマイペース\n\nトロ川様の描かれるイラストから伝わる人物の質感や表情が凄く好きで、その人物の抱えている物語を感じる雰囲気にいつも見惚れております。\n悪魔の唇のPC様方を描かれているのも拝見しており、自身がPL通過した暁には絶対に自陣を描いていただきたい…！と強く思っておりました。\n\n依頼におきまして拙い部分や不足している部分などございましたら大変申し訳ありません…！\n決してご無理のない形で、何卒ご検討のほどよろしくお願いします。\n\nこれからもトロ川様の創作活動を応援しております！\n\nhttps://drive.google.com/drive/folders/11dJLYhj0RY66zbLb1L-wRkUoIhc3eDWX", "created_at": "", "completed_at": ""}, {"path": "/@river1060_2/works/15", "thumbnail_src": "https://si.imgix.net/22168fee/uploads/origins/148026a0-dc59-4554-b231-507262602ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81a2f76708c929ab59b670c121b68a49", "thumbnail_srcset": "https://si.imgix.net/22168fee/uploads/origins/148026a0-dc59-4554-b231-507262602ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81a2f76708c929ab59b670c121b68a49, https://si.imgix.net/22168fee/uploads/origins/148026a0-dc59-4554-b231-507262602ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a009f3b00056e8cdc4fa97f83d3eb83a 2x, https://si.imgix.net/22168fee/uploads/origins/148026a0-dc59-4554-b231-507262602ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e595b47d8bd22e211f6485a9275d1784 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@river1060_2/works/14", "thumbnail_src": "https://si.imgix.net/780058c8/uploads/origins/3b61671a-3f4b-4bc1-8419-dabd043961eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf662c514823925964b590ef74b1556", "thumbnail_srcset": "https://si.imgix.net/780058c8/uploads/origins/3b61671a-3f4b-4bc1-8419-dabd0