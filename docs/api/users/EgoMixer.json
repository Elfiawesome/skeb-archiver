auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccd7aa3e940cc8a08fd90e0c667d68f0 2x, https://si.imgix.net/2e1e3713/uploads/origins/3d2e1990-5f18-445c-b85b-169790294a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=477b0ba2ef35e5cb50fcbc446c311ba7 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。この度はイラストのご依頼させていただきたくおもいます。 \n依頼内容  \n「十二股全部フる」「ケートス号にまつわる記録」の東漸勝さんの軍の資料風イラストをお願いいたします。 \n使用用途\n ・個人鑑賞\n ・個人使用のグッズ制作 \n不備などございましたらお断りいただければ幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/72", "thumbnail_src": "https://si.imgix.net/18f1dcd2/uploads/origins/e0bf3781-fc0a-46ca-ab78-1d340dc71ad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29770aca090f843ddf60752f9d627d60", "thumbnail_srcset": "https://si.imgix.net/18f1dcd2/uploads/origins/e0bf3781-fc0a-46ca-ab78-1d340dc71ad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29770aca090f843ddf60752f9d627d60, https://si.imgix.net/18f1dcd2/uploads/origins/e0bf3781-fc0a-46ca-ab78-1d340dc71ad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc7d98507941f1148e6a02adeaf7da0a 2x, https://si.imgix.net/18f1dcd2/uploads/origins/e0bf3781-fc0a-46ca-ab78-1d340dc71ad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c7c5c314474f38217ab81c80a74e120 3x", "genre": "art", "nsfw": false, "body": "はじめまして、もちだいふくと申します\n\nイラストをお願いしたく依頼させていただきます\n\n【依頼内容】\n・東漸勝さん\n・iPhone15の壁紙として使用したいので縦長でお願いします\n・デートの待ち合わせで先に待ってくれているみたいな感じでお願いしたいです\n・服装等はお任せしたいです\n\n【使用用途】\nスマホの壁紙\n\nリクエストや金額に不備、不都合がありましたら再送要求等していただけると幸いです\nご検討のほどよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/71", "thumbnail_src": "https://si.imgix.net/fc391216/uploads/origins/af1f5a22-d21d-4887-823d-6f6b420907d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e3897f7813072b27482bf32c6cf2f65", "thumbnail_srcset": "https://si.imgix.net/fc391216/uploads/origins/af1f5a22-d21d-4887-823d-6f6b420907d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e3897f7813072b27482bf32c6cf2f65, https://si.imgix.net/fc391216/uploads/origins/af1f5a22-d21d-4887-823d-6f6b420907d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17e0769b6615d298e28facf5e37f806b 2x, https://si.imgix.net/fc391216/uploads/origins/af1f5a22-d21d-4887-823d-6f6b420907d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad4fdcd36dcd77159e028c1c97e0f436 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。この度はイラストのご依頼させていただきたくおもいます。 \n依頼内容  \n「十二股全部フる」「ケートス号にまつわる記録」の東漸勝さんとハルピュイアさんのイラストをお願いいたします。 東漸さんの衣装は戦闘服(軍服？)にしていただけますと幸いです。\n使用用途\n ・個人鑑賞\n ・個人使用のグッズ制作 \n不備などございましたらお断りいただければ幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/70", "thumbnail_src": "https://si.imgix.net/650d0bfb/uploads/origins/4b0ffe63-fd73-4ec1-aa44-71f62ddb9de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcb31f7dc0d6c77ca33a4c9d2a8dfd43", "thumbnail_srcset": "https://si.imgix.net/650d0bfb/uploads/origins/4b0ffe63-fd73-4ec1-aa44-71f62ddb9de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcb31f7dc0d6c77ca33a4c9d2a8dfd43, https://si.imgix.net/650d0bfb/uploads/origins/4b0ffe63-fd73-4ec1-aa44-71f62ddb9de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17e098acd389a82ab17cebfc304b2576 2x, https://si.imgix.net/650d0bfb/uploads/origins/4b0ffe63-fd73-4ec1-aa44-71f62ddb9de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5c11d8684dbf041d789ae41f3f3e55f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/69", "thumbnail_src": "https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d802b6900857e94de823b4bace7444", "thumbnail_srcset": "https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d802b6900857e94de823b4bace7444, https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e51b79cb02015c82d8b57d50bad61a0a 2x, https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a0c437997f99284eb1047c6dfbd948f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。いつもお世話になっています。\n今回もイラストの依頼をさせて頂きます。\n\n【依頼内容】\n・堂建進のラフな姿\n・ラフにしてる時の髪型はコレ！がなければハーフアップになっていたら嬉しいです\n・服装はシャツで腕まくりをしていたらいいなと思っていますが、全然ジャージとかでも嬉しかったりします。お好みでどうぞ！\n\n堂建のラフな姿や一面を見たいだけなので、何をしてるかの背景シチュエ ーションはお好みでお任せします。\nもしシチュエーション説明があればpsdのラフ内等に記載があれば幸いです。\n\n【希望サイズ】\n\n1番描きやすいサイズで構いません!比率も縦長、横長も特に考えていないのでお好みでお願いします。\n\n【用途】\n\n待ち受け\n個人的に印刷してフォトフレームで飾る等", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/68", "thumbnail_src": "https://si.imgix.net/322970c6/uploads/origins/e9a6b5ba-aa37-440b-9c09-2d0fc34548e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebe81da89b6a8e93d83ff005d80725cc", "thumbnail_srcset": "https://si.imgix.net/322970c6/uploads/origins/e9a6b5ba-aa37-440b-9c09-2d0fc34548e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebe81da89b6a8e93d83ff005d80725cc, https://si.imgix.net/322970c6/uploads/origins/e9a6b5ba-aa37-440b-9c09-2d0fc34548e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d36a406ccf1f81d03190dbb3e60f1c54 2x, https://si.imgix.net/322970c6/uploads/origins/e9a6b5ba-aa37-440b-9c09-2d0fc34548e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ca809e16c4c5af31dd7560ce0ba76a3 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。この度はイラストのご依頼させていただきたくおもいます。\n 依頼内容 \n ・「十二股全部フる」の東漸勝さんと南波卓さんのイラストをお願いいたします。 \n・お揃いの洋服(全体は黒を基調としたフォーマルスタイル。上はシャツにサスペンダーを装着してジャケットを羽織っているもの)でしたら嬉しいです。\n使用用途\n ・個人鑑賞\n ・個人使用のグッズ制作 \n不備などございましたらお断りいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/67", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb881f31e91c958fa04b3b088239d227 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=108172c840726590918aa038114d8cda 3x", "genre": "music", "nsfw": false, "body": "凡様はじめまして！\n十二股全部フる、その他シリーズプレイさせていただきました！！どれもストーリーはもちろん、雰囲気を盛り上げてくれる曲がとっても良くて...！\n\nもしよろしければ、私がTRPGで使用したOCのイメージ戦闘曲をお願いいたします！！よろしくお願いいたします...！\n┈┈┈┈┈┈┈┈┈┈\n■容姿参考\nhttps://photos.app.goo.gl/EZnnpnLb7Wtipo529\n\n■キャラクター設定\n‪🌱‬葉琥(ハク)\n「俺！俺、お前好き！」  「ハー！？俺、それヤダ」\n\n・人間を模倣した旧型アンドロイド。\n・アンドロイドっぽさは無く、犬のような人懐っこい性格。\n　孤独が嫌いなひっつき虫の甘えん坊。大好きな男性(飼い主的存在)が居るが、いつも仕事をしていて構ってくれないのでパソコンが嫌い。\n\n・好きなもの→ウォッカ、棒付きキャンディ、どんぐり、綺麗な石\n┈┈┈┈┈┈┈┈┈┈\n\n☆曲イメージ\n・アンドロイドなので、8bitのような音\n・頭の中がゴチャゴチャしてまとまらないイメージ\n・エレクトロスウィングが好きなので、愉快な雰囲気もあるとうれしいです...！", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/66", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb881f31e91c958fa04b3b088239d227 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=108172c840726590918aa038114d8cda 3x", "genre": "music", "nsfw": false, "body": "凡さま\n\nいつもあなたの作品を楽しみにしています。\n12股全部フるであなたを知り、どの作品も楽しく遊ばせていただいておりますた　。(堂建くんとウラルくんがすきです…)\nBGM集を何度も聴いていて、あなたの作るすこし毒っ気のあるような曲調が好きです。\n\n自分はVtuber活動をしており、絵などの作業配信を行うことがあります。\nその際に使用する曲を作っていただきたく存じます。\n\n○使用用途\nYouTubeの配信及びXなどのSNSでの使用\nまた、可能性は低いですが、音楽を再生できるグッズや自作作品(ゲームなど)内に使用させていただく可能性がございます。\n\n○内容\n下記のプロフィールから、似合いそうな曲の制作をお願いします\nあなたの作風のファンなので、特に内容の指定はありません\nワードセンスが好きなので、曲にタイトルもつけていただけたら嬉しいです。\n\n○プロフィール\n名前:眩ねも\n性別:不明\n基本情報:地球から離れた星に一人で住んでいる。ひとりでものを作ったりゲームしたりしていたが、なぜかインターネットが繋がったので配信活動をはじめた。この星が燃え尽きる前に誰かに知ってもらいたかったのかもしれません。\nキャッチフレーズ:ひとりぼっちの星より、かつて子どもだったきみへ。\n※星の王子さま冒頭文のオマージュ\nモチーフ:星の王子さま、夢、地球外生命体\n好きなもの:お絵描き、ゲーム、レモネード\n種族:人間\nイメージカラー:黄色、黄緑(カンラン石の色)\n※カンラン石(エメラルド)はまれに隕石に含まれていることがある\n性格:人前だと明るく喋るが、実際は根暗で臆病で粘着質。\n基本的に真面目だが地球外生命体なので一般常識とはややずれているときがある。\nその他:ふつうの人間みたいに地球で生活している動画や写真を「ゆめ」「ゆめにみたゆめ」などのタイトルでアップロードいる。本人の夢見た理想の姿をあげているのか、ほんとうはただの人間なだけかは不明。\n\nhttps://kuramunemo.tumblr.com/nemo", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/65", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb881f31e91c958fa04b3b088239d227 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=108172c840726590918aa038114d8cda 3x", "genre": "music", "nsfw": false, "body": "こんにちは。リクエスト失礼いたします。\n\n作曲していただきたいもの：戦闘用BGM\n曲のイメージ：アップテンポな曲。破局のテーマのような盛り上がりのある感じだと嬉しいです。\n使用用途：TRPGセッション。外部サイトのココフォリアにアップロードします。他にはアップロードしません。\n\n凡さんの作曲された音楽が好きなのでリクエストさせていただきました。\n金額や内容に不備があれば再送もしくはキャンセルしていただければと思います。\nお忙しいところ恐れ入りますが、宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/64", "thumbnail_src": "https://si.imgix.net/ad4517ae/uploads/origins/eaabe78b-7908-45b8-8306-9cc6e2b28a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed6b8e8a38d775a91f2bfae38512a6b", "thumbnail_srcset": "https://si.imgix.net/ad4517ae/uploads/origins/eaabe78b-7908-45b8-8306-9cc6e2b28a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed6b8e8a38d775a91f2bfae38512a6b, https://si.imgix.net/ad4517ae/uploads/origins/eaabe78b-7908-45b8-8306-9cc6e2b28a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eea5d8848e063ea53688d53260bf9fbb 2x, https://si.imgix.net/ad4517ae/uploads/origins/eaabe78b-7908-45b8-8306-9cc6e2b28a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3557a01fa3bead2149b7b11f05aa603e 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。 前回の東漸と西海の乗船手続きのコミック、本当にありがとうございました。二人とも名目上は誰かのサポートが目的という似たもの同士で、一瞬空気がピリつくことはあっても西海の視界には北神しか映っていないという感情の重さがとても嬉しかったです。重ね重ね、ありがとうございます。\n\n今回はイラストをお願いしたくリクエストいたします。\n昨年Blue skyであげられていた闇堕ちした堂建進および未必恋のイラストをお願いしたいです。\n以下が依頼内容の詳細です。\n 【内容】  \n・闇堕ちした堂建進と未必恋が会話しているシーン\n 【用途】  \n・個人鑑賞  (印刷して部屋で飾る)\n【サイズ】\nおまかせいたします\n※印刷にあたりこちらでサイズ調整をする可能性はあります。個人利用以外は致しません。\n\n以上となります。 内容等で不備がございましたら再送要求等をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/63", "thumbnail_src": "https://si.imgix.net/47b62539/uploads/origins/626318a2-740a-470e-85ac-504bdf31963d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4ca3ae8fd289e90134d38d69ab0959", "thumbnail_srcset": "https://si.imgix.net/47b62539/uploads/origins/626318a2-740a-470e-85ac-504bdf31963d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4ca3ae8fd289e90134d38d69ab0959, https://si.imgix.net/47b62539/uploads/origins/626318a2-740a-470e-85ac-504bdf31963d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35ee96db888117f3e724eeea65f4784a 2x, https://si.imgix.net/47b62539/uploads/origins/626318a2-740a-470e-85ac-504bdf31963d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d108922726f52f3cd1daf2307ed4e7aa 3x", "genre": "art", "nsfw": false, "body": "初めまして。しのみやび🍥と申します。\nこの度は、トレーディングカード化を目的とした東漸勝さんのイラストを依頼させていただきたいと思います。\n\n[依頼内容]\n1.\t東漸さんの「ガチ照れ顔」を描いていただきたいです。\n(軍人・駅員のどちらでも構いません）\n\n2.\tトレーディングカードに使用予定のため、表面と裏面をそれぞれ別に描いていただけますと幸いです。\n\n3.\t裏面のデザインには、東漸さんをイメージしたシンボルと、彼が書いた直筆風のサインを入れていただきたいです。\n(サインにつきましては、英語でも漢字でも、彼が自然に書きそうな方で描いていただければと思います)\n\n4.\t雰囲気については、明るい印象でも、静かに照れるような雰囲気でも大丈夫です。凡さんにお任せにしたいと思っております。\n\n[使用用途]\n・個人グッズとしてのトレーディングカード制作\n・硬質カードケース等に入れて楽しませていただく予定です\n\n[その他]\n・カード化を前提としておりますので、縦長の長方形サイズでの制作をお願いできればと思います。\n・セリフやシチュエーション、服装やポーズなどの希望は特にございませんが、上半身が写っている構図にしていただけると嬉しいです。\n・東漸さんが照れることがあるのかは分からないのですが、凡さんの解釈で描いていただければ嬉しいです。\n\n初めてのSkeb依頼となるため、金額の不足や文章の不備等ございましたら大変申し訳ございません。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/62", "thumbnail_src": "https://si.imgix.net/89c5887f/uploads/origins/950b2b70-142c-4c79-8dce-8f1260696be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce207084380476fa4ae6d5b21f6f853", "thumbnail_srcset": "https://si.imgix.net/89c5887f/uploads/origins/950b2b70-142c-4c79-8dce-8f1260696be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce207084380476fa4ae6d5b21f6f853, https://si.imgix.net/89c5887f/uploads/origins/950b2b70-142c-4c79-8dce-8f1260696be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0122027c1c4e230447bdf8b0b1f2241 2x, https://si.imgix.net/89c5887f/uploads/origins/950b2b70-142c-4c79-8dce-8f1260696be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c753c25acc9699485349407a2469dcc 3x", "genre": "art", "nsfw": false, "body": "リクエスト【ブカの全体図】\nお願いします( * ॑꒳ ॑*)！\n\n以下感想メモです…！\nマシュマロで\nキャラクター紹介が欲しいって\nお願いした者です…！\n\n隠れキャラクター燃えます❤️‍🔥\n\nゲームの説明書大好きなので\nめちゃくちゃ可愛いイラスト付きで\n大喜びしました…！\n丁寧な回答ありがとうございます…！\n優し…！\nこれからも応援してます✻*˸ꕤ*˸*⋆。✻*˸ꕤ*˸*⋆。✻*˸ꕤ*˸*⋆。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/61", "thumbnail_src": "https://si.imgix.net/298f5ebf/uploads/origins/0ee76292-075f-4b9d-bf06-9940ca56fd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef016d34b06b6f4e176498dad770fb62", "thumbnail_srcset": "https://si.imgix.net/298f5ebf/uploads/origins/0ee76292-075f-4b9d-bf06-9940ca56fd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef016d34b06b6f4e176498dad770fb62, https://si.imgix.net/298f5ebf/uploads/origins/0ee76292-075f-4b9d-bf06-9940ca56fd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e65bc2898ad7714db8e7c42944af7d7 2x, https://si.imgix.net/298f5ebf/uploads/origins/0ee76292-075f-4b9d-bf06-9940ca56fd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2935412d23539ca3c4618db30c8d809b 3x", "genre": "comic", "nsfw": false, "body": "お世話になっております。いつも素晴らしいイラスト、作品など楽しませていただいております。ありがとうございます。この度はコミックのご依頼させていただきたくおもいます。\n 依頼内容\n ・「ケートス号にまつわる記録」4人の学パロの漫画をお願いいたします。\n  ・東漸勝さんが主のお話でしたら嬉しいです。\n使用用途 \n・個人鑑賞 \n不備などございましたらお断りいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/60", "thumbnail_src": "https://si.imgix.net/a97efbe2/uploads/origins/d06b0834-6e0d-49af-b502-e41f0b411f41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e34604e09b2f8a4920d2c743d29537b", "thumbnail_srcset": "https://si.imgix.net/a97efbe2/uploads/origins/d06b0834-6e0d-49af-b502-e41f0b411f41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e34604e09b2f8a4920d2c743d29537b, https://si.imgix.net/a97efbe2/uploads/origins/d06b0834-6e0d-49af-b502-e41f0b411f41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35cdf13f83464b9deeacddaff888cf49 2x, https://si.imgix.net/a97efbe2/uploads/origins/d06b0834-6e0d-49af-b502-e41f0b411f41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71cc4f3fb1a0ef8f734f13c4086753c6 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n\n早速ですが、幼少期と大人の未必恋のイラストをお願い致します。\n以前幼少期のイラストを拝見してかわいいなと思っておりましたので……。もしNGでしたらお断りいただいて構いません。\n\n以下、具体的な内容となります。\nーーーーーーーーーーーーーーー\n[依頼内容]\n・幼少期と大人の未必恋のイラストをお願いします。\n・個別に描いていただくでも、1枚に収めていただくでもどちらでも構いません。ポーズ、構図も指定ありません。\n\n[用途]\n・印刷し、写真立てに飾る\n・グッズ発注\n※いずれも自分用であり、販売・譲渡は致しません。\n※上記の利用にあたり、サイズ調整のため加工する可能性がございます。\n\n[サイズ]\n・指定はございません。\nーーーーーーーーーーーーーーー\n依頼内容は以上となります。\n\n不備等がございましたら再送要求をいただけますと幸いです。\nご検討いただければ幸いですが、内容等のNGやその他不都合がございましたらご遠慮なくお断りいただいて結構です。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/59", "thumbnail_src": "https://si.imgix.net/00b505b6/uploads/origins/bea56da6-3db8-4c9c-a468-92ac73e24d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491b01f30b82ff15779b8fcae7184e1e", "thumbnail_srcset": "https://si.imgix.net/00b505b6/uploads/origins/bea56da6-3db8-4c9c-a468-92ac73e24d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491b01f30b82ff15779b8fcae7184e1e, https://si.imgix.net/00b505b6/uploads/origins/bea56da6-3db8-4c9c-a468-92ac73e24d25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1141aa4ef6cd514df7db04ca8e79c774 2x, https://si.imgix.net/00b505b6/uploads/origins/bea56da6-3db8-4c9c-a468-92ac73e24d25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a74fc5f56ae96cf6f8dd4c8ebcebb665 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、みかづきもと申します。 前回はイベントの準備などでお忙しい中リクエストにお答えいただき、誠にありがとうございました。毎日眺めて幸せに過ごさせていただいております。今回の依頼の内容は以下の通りです。\n\n\n【内容】 \n・『BuzzorDie』から、佐木島 翔と秋足 忍の2人をお願いしたいです。\n・シチュエーションなどはお任せします。\n・どのような会話をするのかより深く知りたいので、セリフがついているとありがたいです。\n（可能であればセリフありなしの差分、背景とキャラは別レイヤー、キャンバスサイズは縦長の3:4であるととても助かります。）\n\n【用途】 \n・個人鑑賞 \n・個人的なグッズの作成\n\n（上記の目的に応じてサイズの調整・加工などを行う場合があります。）\n\n\n内容の不備や金額の不足がありましたら、お手数お掛けしますが、再送をお願いいたします。また、不適切であると思われましたら、キャンセルをお願いいたします。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/58", "thumbnail_src": "https://si.imgix.net/ef19d34a/uploads/origins/04af4599-b286-4a68-990e-e0e1e83536dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7368bedbcc18324ec61e508c0857f56c", "thumbnail_srcset": "https://si.imgix.net/ef19d34a/uploads/origins/04af4599-b286-4a68-990e-e0e1e83536dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7368bedbcc18324ec61e508c0857f56c, https://si.imgix.net/ef19d34a/uploads/origins/04af4599-b286-4a68-990e-e0e1e83536dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5b3b78bbe798a00ba7d44297045a6f9 2x, https://si.imgix.net/ef19d34a/uploads/origins/04af4599-b286-4a68-990e-e0e1e83536dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=160842ce25c7f7099d1d8f446630f3e3 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n前回は素敵なイラストをありがとうございました！眺めては元気を貰っています。\n\n今回の依頼ですが、前回は明るい雰囲気の2人のイラストを頂いたので今回はまた違う雰囲気のイラストを描いて頂きたいと思い、依頼させて頂きました。\n\n【依頼内容】\n・落ち着いた雰囲気の氷上冬花さんのイラスト\n・星空の背景(窓からの風景等全体が星空でなくとも問題ありません...！)\n・全身または膝から上が入るような構図 \n・その他ポーズ、服装等はお任せします。\n・iPhone15(サイズ1179×2556)の壁紙として使用したいため、縦長のイラストでお願いします。\n\n【使用用途】\n・個人鑑賞用\n・スマホの壁紙\n・グッズ制作(個人用のみ、販売や譲渡はいたしません。)\n\nリクエストの不備や金額不足等ありましたら再送頂けますと幸いです。\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/57", "thumbnail_src": "https://si.imgix.net/01e39d6b/uploads/origins/914c74e5-c14c-4279-9dbf-00ba00c3f250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de7829755e09288868d2818e9cbdd97", "thumbnail_srcset": "https://si.imgix.net/01e39d6b/uploads/origins/914c74e5-c14c-4279-9dbf-00ba00c3f250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de7829755e09288868d2818e9cbdd97, https://si.imgix.net/01e39d6b/uploads/origins/914c74e5-c14c-4279-9dbf-00ba00c3f250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efa690bbdf0d802f35b6de49dba152bb 2x, https://si.imgix.net/01e39d6b/uploads/origins/914c74e5-c14c-4279-9dbf-00ba00c3f250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71360e791e50bfb0cccfcc1708058846 3x", "genre": "comic", "nsfw": false, "body": "はじめまして、メジェドマンと申します。いつも素晴らしい作品を公開していただきありがとうございます。いつもとても楽しく鑑賞しています。先日のケートス号2周年の楽曲で心がぐちゃぐちゃになり居てもたってもいられなくなって、依頼を送らせていただきました。\n\n【依頼内容】\n形式:モノクロ漫画(1ページでも)\n内容:平和な世界でのケートス組(以前呟かれていたシェアハウス、怪異探偵事務所などでも)(大変であれば全員が登場しなくても構いません)\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n以上となります。\n\n\n慣れないスケブ依頼のため、金額の不足や依頼文の不備等あれば、キャンセルして頂いても構いません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/56", "thumbnail_src": "https://si.imgix.net/0ac54e73/uploads/origins/14235793-f108-474c-aca0-351bade5bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceef5a85f134971be1eae99456b12767", "thumbnail_srcset": "https://si.imgix.net/0ac54e73/uploads/origins/14235793-f108-474c-aca0-351bade5bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceef5a85f134971be1eae99456b12767, https://si.imgix.net/0ac54e73/uploads/origins/14235793-f108-474c-aca0-351bade5bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30e341367a808d96aff9bd60e2fd2338 2x, https://si.imgix.net/0ac54e73/uploads/origins/14235793-f108-474c-aca0-351bade5bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6992b5cfc71926cf87b0d6ffa91a969a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、六一三(むい)です……！！\n前回もリクエストにお応え頂き誠にありがとうございました……！！\n前回は自分の欲に正直な煩悩まみれなリクエストとなっておりましたが公式が最大手とはこのことかと最高を拝ませていただき今も感動の涙が止まらず定期的に読み返しては口角がぶち上がりテンションもぶちあがり萌えのあまりスマホも上空に放り出されます本当に好きです寿命が千年延びます、本当にありがとうございました……！！\nまた試遊版も遊ばせていただき、より一層サギシマさんのことが更に好きになり探偵さんも本編ではどのような登場を果たすのか本編で二人の関係はどのようになるのかドキドキが止まらず夜も眠れず前回納品いただきました漫画を読み返しては朝を迎えております、サギシマさんの赤面で救われる命がここにあります、本当に好きですあの可愛い赤面顔……ッ！！\n本編のリリースも楽しみにお待ちしております、本当にご無理だけはなさらずお身体にお気をつけください……！！\nこれからも陰ながら応援しております。\n\n以下はこの度の依頼の詳細となります。\n\n───────────\n【依頼詳細】\n▽リクエスト内容\n・「十二股全部フる」の世界のウラルのイラスト\n\n・ネットプリント(ましかくクリップ)などでチェキ風のフレームを加えて印刷し、出来上がったものを眺めてはチェキを撮らせていただいた気分を味わいたく思いますのでウラルが写真を撮られている雰囲気(構図？)ですと大変とても嬉しいです。\n\n・先述の通りチェキ風の印刷をする予定なのですが、シチュエーション的にはこう、「十二股全部フる」の世界線で都市統制AIウラルに遭遇した都市統制AI隠れファン(？)限界オタクがウラルに写真を撮らせて欲しいと勢いのまま頼み込み、目の前に居る推し(ウラル)に感動と感激と日頃の感謝と色々な感情を爆発させてしまって泣きながらも「いつもありがとぉ……！！」「ｱｯ、めちゃくちゃ顔が良い……ｴｯ優勝……」「いつもこのAIに見守られてるんですよ我々人類……私にも見守らせてくれよ深淵をのぞく時、深淵もまたこちらをのぞいていると言うじゃないですかﾊｯいや待って今のぞき返せてると言っても過言じゃないですかﾔﾀﾞｰ嬉しい……このまま24時間覗き返させてくれよォ……！！」「ｳﾜｰｯ好き……」「今日も私含めこの都市の人間が幸せHappy順風満帆に生活できてるのは貴方がレジの支援だったり何だったり色々手伝ってくれてるおかげなんだワ……ありがとう……感謝……いや本当にいつもいつもありがとうウラル一生推す……都市統制AIしか勝たん……君がナンバーワンだよ……」「撮影してるだけで私のQOL今爆上がりしてるなこれ」「目線こっちにお願いしまｱｯｯｯｯｯ今目があっっっっっっ」「めっちゃすき……ほんますき……」「ありがとう……ありがとう……我々人類と居てくれてありがとう……ッ！！」など色々呟いたり叫んだりしながらシャッター切りまくってる状況となります。\n\n〜〜〜〜〜〜〜〜〜\n\n▽希望(こちらに関しては可能でしたらで構いません……！！)\n・レイヤーに関しまして\n┗後述用途によって位置調整やサイズ調整などを行う可能性があるためウラルのレイヤーと背景のレイヤーは別ですと大変とても嬉しいです……！！\n\n・写真を撮られている時のウラルの台詞\n┗妄想(存在しない記憶)の解像度を上げたいのでウラルからの言葉があると私の心が潤い大変とても助かります……！！また後述用途によって台詞のありなしの差分を使い分けたいためレイヤーが別だと大変嬉しいです……！！\n\n※希望に関しましては本当に全てもしも可能であればで構いません……！！\n\n〜〜〜〜〜〜〜〜〜\n\n▽ファイル形式\n・PSD\n\n〜〜〜〜〜〜〜〜〜\n\n▽用途\n・チェキ風に印刷したものを眺めて妄想(存在しない記憶)に浸る。\n・硬質デコケースに入れて持ち歩きます。\n・スマホケースにも挟みます。\n・その他グッズ(アクリル系のものなど)を作る可能性もあります。\n\n※上記目的に応じてサイズの調整、加工を行う場合があります。\n※全て私個人での使用・鑑賞目的のため販売などは行いません(恐らく大量に印刷の注文をしますが全て自分用です)。\n\n───────────\n\n以上がリクエスト詳細となります、何かしら不備などの方がありましたら申し訳ありません……！！\n\n凡さんが作られておりますゲームが本当に好きでいつも楽しませていただいており、キャラクター達が本当に好きで特にウラルが本当に本当に好きです……ッ！！\n人間が本当に好きなウラルが私も本当に大好きでッ……！！ウラルへの愛しさは爆発して止まることを知らず気がつけばもう一年以上が経過しておりました。\n「十二股全部フる」の世界は本編内で語られた通り百年後には滅ぶ世界でありウラルはその滅びを回避するために行動をしていて本当に最後まで人間の隣に居るべく頑張っていて……最初にskeb依頼しました漫画でもほぼ24時間ずっと人間の隣に居て……愛しくて涙が出てきました、ウラル本当に好きです……ウラルが報われてくれるならウラルが楽しそうならそれだけで私はもう嬉しいですの気持ちで毎日毎秒ノンストップでウラルに愛が止まらない愛を注ぎ続けております、ウラルが我々人類を愛するとき人類もまたウラルを愛しているのだ状態と言っても過言ではありません。\n……またウラルへの愛が爆発のあまりこのままでは依頼文以上に長く綴ってしまいかねないため断腸の思いで一旦ここで区切ります、ご検討いただけますと幸いです、勿論ご都合が悪ければお断りいただいても大丈夫ですのでご無理だけは本当になさらず……！！\nこの度もまたご縁がいただければ大変とても嬉しいです……！！", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/55", "thumbnail_src": "https://si.imgix.net/844c3af4/uploads/origins/d133133b-ef6b-4e9c-926f-93b97a4e9620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92174d8540f543b12e0c8732a42baaa", "thumbnail_srcset": "https://si.imgix.net/844c3af4/uploads/origins/d133133b-ef6b-4e9c-926f-93b97a4e9620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92174d8540f543b12e0c8732a42baaa, https://si.imgix.net/844c3af4/uploads/origins/d133133b-ef6b-4e9c-926f-93b97a4e9620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7522e13fe8ebf23375a7d41633874569 2x, https://si.imgix.net/844c3af4/uploads/origins/d133133b-ef6b-4e9c-926f-93b97a4e9620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b979bb70bc0b46f37c4c958b7562987a 3x", "genre": "comic", "nsfw": false, "body": "お世話になっております。 前回の東漸と北神のコミックをありがとうございました。本当に素敵でした……。まだ余韻に浸っては何度も見返しています。ありがとうございます。 Skeb依頼をまだ募集されているとのことでしたのでまたお願いしたく依頼させていただきます。  \n以下が依頼の内容です。\n 【内容】  ・『ケートス号にまつわる記録』の東漸勝と西海不成の二人の乗船直後の様子(初対面で挨拶を交わす様子など)を描いていただきたいです\n ・互いが互いをどう認識したのかについて触れてほしいです \n・ページ数はお任せいたします。金額が足りないようであればお手数ですが再送要請をください。\n 【用途】  ・個人鑑賞  \n以上となります。 内容等で不都合がございましたらご遠慮なくお断りください。 上記内容でご検討いただけましたら幸いです。 これから暑くなる季節ですのでご自身のご都合を優先していただければと思います。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/54", "thumbnail_src": "https://si.imgix.net/f1d26a2a/uploads/origins/c88581a1-4c68-4864-9f31-85cb253f3606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b11f6ade93abaa3173727b09e88f02e", "thumbnail_srcset": "https://si.imgix.net/f1d26a2a/uploads/origins/c88581a1-4c68-4864-9f31-85cb253f3606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b11f6ade93abaa3173727b09e88f02e, https://si.imgix.net/f1d26a2a/uploads/origins/c88581a1-4c68-4864-9f31-85cb253f3606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad5ec1982ab70e768b55b0ab347dfd37 2x, https://si.imgix.net/f1d26a2a/uploads/origins/c88581a1-4c68-4864-9f31-85cb253f3606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83dd9c48f717497482600d54949dd347 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。この度はイラストのご依頼させていただきたくおもいます。 依頼内容  ・「十二股全部フる」「ケートス号にまつわる記録」の東漸勝さんのファンタジーパロディのイラストをお願いいたします。 \n・肖像画のような雰囲気のイラストにしていただけましたら幸いです。\n使用用途\n ・個人鑑賞\n ・個人使用のグッズ制作 \n不備などございましたらお断りいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/53", "thumbnail_src": "https://si.imgix.net/036b8792/uploads/origins/344e7c9e-bc53-4db3-870d-eb73d735e40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=408efebaba8c37f904a3e1ffed672963", "thumbnail_srcset": "https://si.imgix.net/036b8792/uploads/origins/344e7c9e-bc53-4db3-870d-eb73d735e40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=408efebaba8c37f904a3e1ffed672963, https://si.imgix.net/036b8792/uploads/origins/344e7c9e-bc53-4db3-870d-eb73d735e40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2275500afa27600cf0cd5a3005350df 2x, https://si.imgix.net/036b8792/uploads/origins/344e7c9e-bc53-4db3-870d-eb73d735e40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc91479be01d936864e62a169ae54471 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n\n早速ですが、『公平なるは我がマキナ』の登場人物達の集合写真風のイラストをお願い致します。\n\n以下、具体的な内容となります。\nーーーーーーーーーーーーーーー\n[依頼内容]\n・『公平なるは我がマキナ』のポルスト、フール、ハンザイ、ソク、ザルソバの本編後の集合写真イメージのイラストをお願いします。\n・ポーズ、構図はおまかせします。全身だとうれしいですが、必須ではないので調整いただいて構いません。\n\n[用途]\n・PC等の壁紙\n・印刷し、写真立てに飾る\n・グッズ発注\n※いずれも自分用であり、販売・譲渡は致しません。\n※上記の利用にあたり、サイズ調整のため加工する可能性がございます。\n\n[サイズ]\n・1,732px×2,488px以上(横長希望）\nーーーーーーーーーーーーーーー\n依頼内容は以上となります。\n\n不備等がございましたら再送要求をいただけますと幸いです。\nご検討いただければ幸いですが、内容的に本編の核心に触れますので、NGやその他不都合がございましたらご遠慮なくお断りいただいて結構です。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/52", "thumbnail_src": "https://si.imgix.net/77efd5a7/uploads/origins/34514274-e500-4dbd-bac1-32cd329903c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3c45e8b925fe9edbabb010a504a91a2", "thumbnail_srcset": "https://si.imgix.net/77efd5a7/uploads/origins/34514274-e500-4dbd-bac1-32cd329903c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3c45e8b925fe9edbabb010a504a91a2, https://si.imgix.net/77efd5a7/uploads/origins/34514274-e500-4dbd-bac1-32cd329903c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e553b34c6d8d3fa2ecbb50c5cb0485be 2x, https://si.imgix.net/77efd5a7/uploads/origins/34514274-e500-4dbd-bac1-32cd329903c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fdb4578ac2ff7f415d1e9aca783d64f 3x", "genre": "art", "nsfw": false, "body": "お世話になっています。輪切りと申します。\n先生のおつくりになるゲーム・音楽・動画等をいつも楽しませていただいております。\n現在も新しいことに挑戦されているとのことで、BUZZ or DIEのSteam版含めてとても楽しみにしております。\n引き続き息災にお過ごしいただくことを心から願っています。\n\nイラストの依頼について、ケートス号にまつわる記録の西海 不也さんの一枚絵をいただけると嬉しいです。\n作中の北神 論利さんとの絡みが絶妙にすれ違っていて好きなので、可能なら北神さんもうつっているととてもうれしいです。\nゆっくりお待ちしているので納品時期等はお気になさらずで大丈夫です。\nどうぞよろしくお願いいたします。\n\n輪切り", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/51", "thumbnail_src": "https://si.imgix.net/95b5d8a4/uploads/origins/92945a7e-2d2c-4b97-936b-331b035a4942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c9e3e344f74b34f48f137e2d4cc9ad", "thumbnail_srcset": "https://si.imgix.net/95b5d8a4/uploads/origins/92945a7e-2d2c-4b97-936b-331b035a4942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c9e3e344f74b34f48f137e2d4cc9ad, https://si.imgix.net/95b5d8a4/uploads/origins/92945a7e-2d2c-4b97-936b-331b035a4942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67b5f5266b8fe9496d56516db4ea7c49 2x, https://si.imgix.net/95b5d8a4/uploads/origins/92945a7e-2d2c-4b97-936b-331b035a4942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e232ef7862586beea2a2d056916384a1 3x", "genre": "art", "nsfw": false, "body": "こんにちは。いつもお世話になっています。\n\n【依頼内容】\n平和な世界線の堂建進が得意げに料理を出している、作っているシーン（どちらでもお好きなシーンを！）（平和そうなら原作本編も大歓迎です）\n家族か、それ以外の友人等に振舞ってるかなどの背景シチュエーションもお好みでお任せします\n【希望サイズ】\n1番描きやすいサイズで構いません！\n・可能であれば縦長3:4の比率\n【用途】\n待ち受け\n個人的に印刷してフォトフレームで飾る等\n\n\n（以下蛇足）\nいつも堂建関連の情報や作品を常に美味しく楽しく摂取させて頂いています。本当にありがとうございます。正直これ以上何も望まねえ……くらいにはいつも満ち足りていますが折角支援と交流の場が開かれているので欲を出させていただきました。\n堂建がどんな料理をどういう風に振る舞うのか、彼の事をもっと知れるきっかけになれば幸いです。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/50", "thumbnail_src": "https://si.imgix.net/f555816b/uploads/origins/2326e826-2e29-45d9-8fd2-43975cbfde9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0e4d2c9538adf5839fd0d27bf75594f", "thumbnail_srcset": "https://si.imgix.net/f555816b/uploads/origins/2326e826-2e29-45d9-8fd2-43975cbfde9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0e4d2c9538adf5839fd0d27bf75594f, https://si.imgix.net/f555816b/uploads/origins/2326e826-2e29-45d9-8fd2-43975cbfde9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d71be5b3581548928e78b210d03587bc 2x, https://si.imgix.net/f555816b/uploads/origins/2326e826-2e29-45d9-8fd2-43975cbfde9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e13154933b52f2422bd2692777f39bef 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/49", "thumbnail_src": "https://si.imgix.net/9b5f2c45/uploads/origins/853505e3-57b5-4f1c-b1ef-8249aa12f54d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cc2fe6a2d68fb198f7d82990e7a79eb", "thumbnail_srcset": "https://si.imgix.net/9b5f2c45/uploads/origins/853505e3-57b5-4f1c-b1ef-8249aa12f54d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cc2fe6a2d68fb198f7d82990e7a79eb, https://si.imgix.net/9b5f2c45/uploads/origins/853505e3-57b5-4f1c-b1ef-8249aa12f54d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dc9b10439b75ac655c480617f22ee84 2x, https://si.imgix.net/9b5f2c45/uploads/origins/853505e3-57b5-4f1c-b1ef-8249aa12f54d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e5eae62610d188f3a9c67e6179e753d 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見させていただいたり、ゲームをプレイさせていただいております。素晴らしい作品をありがとうございます。また、この度は初めてイラストのご依頼させていただきたくおもいます。\n依頼内容 \n・「十二股全部フる」の東漸勝さんと西海不成さんのイラストをお願いいたします。\n・シチュエーションなどはお任せいたしますが、フォーマルな衣装ですと幸いです。\n使用用途\n・個人鑑賞\n・個人使用のグッズ制作\n不備などございましたらお断りいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/48", "thumbnail_src": "https://si.imgix.net/b0300379/uploads/origins/cd192ceb-4462-4da0-bf85-e87ab69d9fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8933bf526307c10947673c50814ded", "thumbnail_srcset": "https://si.imgix.net/b0300379/uploads/origins/cd192ceb-4462-4da0-bf85-e87ab69d9fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8933bf526307c10947673c50814ded, https://si.imgix.net/b0300379/uploads/origins/cd192ceb-4462-4da0-bf85-e87ab69d9fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65c4bf9f2c4b66118dc64113cae64a94 2x, https://si.imgix.net/b0300379/uploads/origins/cd192ceb-4462-4da0-bf85-e87ab69d9fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44c7d78a5bd5431fb68ffff87cee0f2c 3x", "genre": "art", "nsfw": false, "body": "はじめまして！凡さんの作品が大好きで、どのゲームもどのキャラクターも魅力的で心ときめく日々を過ごさせていただいております！\n\nその中でも『EgoMixer』の未必恋と『インタビュー・ウィズ・コンピュータ』のウラルが本当に魅力的で心を撃ち抜かれました！『十二股全部フる』での特殊会話などから伺える彼らの対照的な心の動きがとても好きです。\n\n────────\n\n【依頼内容】\n　\n今回依頼させていただきたいのは、『十二股全部フる』内のコマンドをイメージしたイラストで、\n・ウラルのコマンドである「いのる」をイメージしたイラスト\n・未必恋のコマンドである「のろう」をイメージしたイラスト\nの２つです。\n\n希望といたしましては、\n・タロットカード風の装飾がなされている\n・(キャラクターや背景などの)レイヤーが分かれている\nものであると嬉しいです！\n\n使用用途は個人用のグッズ制作(印刷等)を想定しております。\n\nサイズやファイル形式の指定は特にございません。\n金額等が不足しておりましたら、お手数ですが再送をお願いいたします。\nご縁がありましたらお引き受けいただけるととてもうれしいです！\n\n──────────\n\n凡さんが楽しく創作活動を続けてくださることが何よりうれしいので、凡さんのゲーム開発に対する熱意もものすごく好きなのですが(バズオアダイもとても楽しみにしています！！！)、どうかご無理しすぎずご自愛ください！", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/47", "thumbnail_src": "https://si.imgix.net/e78977dd/uploads/origins/d13ef580-8ae3-4846-82e2-dca28cc5a3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc890e2a1480c2488c9352836939b25d", "thumbnail_srcset": "https://si.imgix.net/e78977dd/uploads/origins/d13ef580-8ae3-4846-82e2-dca28cc5a3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc890e2a1480c2488c9352836939b25d, https://si.imgix.net/e78977dd/uploads/origins/d13ef580-8ae3-4846-82e2-dca28cc5a3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85ca40e069baf17719a2aceef65650fb 2x, https://si.imgix.net/e78977dd/uploads/origins/d13ef580-8ae3-4846-82e2-dca28cc5a3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecbd4bd6c207ba6a7ce93e4fa967fb34 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております。所縁です。\n初めてリクエストをさせていただきます。\n凡さんの作品の中でも、ウラルさんが大好きなので、イラストを依頼させていただけないでしょうか。\n\n【リクエスト詳細】 \n夢絵チックなリクエストとなりますが、以下の絵をお願いしたいです。\n不都合がありましたら、お気軽にお断りくださって構いません。\n\n「ウラルさんと『私』が、対面でお茶をしているのを、『私』の一人称視点で描いた絵」(『私』の写り込みはなくてOK)\n「画面全体にまばらにグリッチノイズがある」(ノイズの種類は何でも良いです)\n※サイズ・カラー/モノクロ・デフォルメレベルなどはお任せとさせていただきたいです。\n\n下記はリクエストではなく、上記リクエスト詳細が不十分だった場合に備えての補足です。\n読み飛ばしていただいても、全く問題ありません。(むしろお好きに描いていただければ嬉しいです。)\n---\nかつて『私』と『誰か』がお茶をした。\nその記憶を『私』はほとんど思い出せなくなってしまった。\nウラルにお願いして、無理やり記憶情報をサルベージして再現したけど、『誰か』像は欠落が多くて復元できず、やむなく『誰か』の人格を演算で補完し、見た目もウラルと同一にするしかなかった。\n---\nようなシチュエーションを想定しています。\n意味の通らない文章になっていたら、無視してください。\n\n凡さんの創作物のファンです。\nどうしようもない世界で、救われなくても、世界に一矢報いれたら勝ちみたいな、そういう部分に救われる気がしてて、好きです。(自分勝手な受け取り方かもしれません……)\n素敵な作品を作り続けてくださってありがとうございます。\n\nリクエストに不慣れのため、失礼がございましたら、たいへん申し訳ございません。\n相場を知らないため、金額の不足がありましたら、お手数ですが再送していただけますと幸いです。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/46", "thumbnail_src": "https://si.imgix.net/1152c0f9/uploads/origins/7e61bf3e-9939-444e-b6e7-0506482f0055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a214913d982f0972e6e70810b11a3675", "thumbnail_srcset": "https://si.imgix.net/1152c0f9/uploads/origins/7e61bf3e-9939-444e-b6e7-0506482f0055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a214913d982f0972e6e70810b11a3675, https://si.imgix.net/1152c0f9/uploads/origins/7e61bf3e-9939-444e-b6e7-0506482f0055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1439c23f06b725dc402f9c71d6b64531 2x, https://si.imgix.net/1152c0f9/uploads/origins/7e61bf3e-9939-444e-b6e7-0506482f0055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c02ec7b9a4166c10711493aaf57d6f1d 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。ラシェルと申します。前回は素晴らしい漫画をありがとうございました。\n\n早速ですが、今回お願いしたいのは天使イヨちゃんのイラストです。若くして懲罰課の、しかも天使長という地位にいる彼女の働きぶりを見たくなり依頼させていただきました。\n\n以下、具体的な内容となります。\nーーーーーーーーーーーーーーー\n[依頼内容]\n・懲罰課のお仕事中のイヨちゃんのイラスト\n・ポーズ、構図はおまかせします。\n・状況(仕事内容等)が分かるセリフがあるとありがたいです。\n・下記用途のため背景、キャラ、セリフのレイヤーを分けていただけると助かります。\n\n[用途]\n・スマホ、PC等の壁紙\n・印刷し、写真立てに飾る\n・アクリルブロック等のグッズ発注\n※いずれも自分用であり、販売・譲渡は致しません。\n※上記の利用にあたり、サイズ調整のため加工する可能性がございます。\n\n[サイズ]\n・1,732px×2,488px以上(縦長希望）\nーーーーーーーーーーーーーーー\n依頼内容は以上となります。\n\n不備等がございましたら再送要求をいただけますと幸いです。\nまた、内容のNGやその他不都合がございましたらご遠慮なくお断りいただいて結構です。ご自身のご予定、体調を第一優先としていただければと思います。", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/45", "thumbnail_src": "https://si.imgix.net/04135658/uploads/origins/8e6e5c80-05d7-479c-988a-53b2c8f26496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f07fb8bb208973c9e69830a71df06d8e", "thumbnail_srcset": "https://si.imgix.net/04135658/uploads/origins/8e6e5c80-05d7-479c-988a-53b2c8f26496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f07fb8bb208973c9e69830a71df06d8e, https://si.imgix.net/04135658/uploads/origins/8e6e5c80-05d7-479c-988a-53b2c8f26496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=282536f0b2bd87a4e52b4580b91a9f37 2x, https://si.imgix.net/04135658/uploads/origins/8e6e5c80-05d7-479c-988a-53b2c8f26496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3c618f95a5663a42e806272b4ffbd13 3x", "genre": "art", "nsfw": false, "body": "幸せウルトラハッピーエンドなウラルをお願い出来ますか？", "created_at": "", "completed_at": ""}, {"path": "/@EgoMixer/works/44", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cc6268c70c421176efb7a1c6843efa, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb881f31e91c958fa04b3b088239d227 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1711044996395360256%2FpXr59V2m.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=108172c840726590918aa038114d8cda 3x", "genre": "music", "nsfw": false, "body": "【依頼内容】\n①ケートス号にまつわる記録に登場する、北神論利のイメージBGM\n\n本編中の彼の心情を表したものをお願いしたいです。\n\n②上記のアレンジBGM\n\n上の①で作っていただいたものを、作業の時などにループで聞ける、アレンジしたBGMにしていただきたいです。\n\n①がローテンポであれば、②をアップテンポに、①がアップテンポなら、②はローテンポに、といった感じでなるべく2つのBGMの系統を分けてくださると嬉しいです。\n\n【使用用途】\n個人観賞用です。作業中や、移動中などに聞く予定です。\n\n\nはじめまして。色と申します。いつも素敵な作品を公開してくださり、ありがとうございます。\n凡さんの様々なゲームをプレイさせていただきまして、どのゲームも始まりから終わりまでストーリーが本当に素晴らしく、特にインタビュー・ウィズ・コンピュータの「一度も気持ちが変わったことなんかありませんでした」の1文や、egomixer2週目堂建の部分や、ケートス号のエンディングでは感情がぐちゃぐちゃになりました。\n結果、ウラル、堂建進、北神論利の3人の沼に落ち、ウラルと北神の香水を購入させて頂き毎日使っていたり、ゲームのスクショを見返したり、供給に狂喜乱舞しております。いつもありがとうございます。\n\n突然ですが、先日のCDの発売や、北神の漫画や、再掲祭りなどで、skeb依頼を迷っていた気持ちが吹っ飛んだため、依頼を送らせて頂きました。依頼内容や、金額に不備があればキャンセルなどして頂いて構いません。(金額については、2つのBGMをお願いさせていただいているため、少し上乗せしています。)\nまた、ゲムダンもあると思いますので、体調第一でお願いいたします。よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}