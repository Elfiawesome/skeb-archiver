ix.net/a395fe5f/uploads/origins/92316cfc-4659-475b-aa2d-87aff0eca750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8668fbfa1731b9a4d5dc3a331fa5717", "thumbnail_srcset": "https://si.imgix.net/a395fe5f/uploads/origins/92316cfc-4659-475b-aa2d-87aff0eca750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8668fbfa1731b9a4d5dc3a331fa5717, https://si.imgix.net/a395fe5f/uploads/origins/92316cfc-4659-475b-aa2d-87aff0eca750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9f8ba0130354a2bc6066b9a117e38c 2x, https://si.imgix.net/a395fe5f/uploads/origins/92316cfc-4659-475b-aa2d-87aff0eca750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=515d31c068f614bb0697696c8ce357e7 3x", "genre": "art", "nsfw": false, "body": "はじめまして。 素敵なイラストをお見かけし、ぜひ私のOCをお描きしていただきたく思いリクエストさせていただきました。\n\n  ●使用用途  \n・個人鑑賞  \n・SNSアイコンへの使用 、ポスト ・キャラクター資料への使用  \n・個人的な用途でシール、アクスタ印刷（非売） \n●構図、服装等 \n全ておまかせいたします。\n参考資料は下記のリンクからお願いいたします。  \n\nお忙しいところ大変恐縮ですが、ご検討のほどよろしくお願いいたします。再送失礼いたします。\n\nhttps://drive.google.com/drive/folders/1M-NHG4Kn917RzRI9SSCwwJ-TSpsMa2Jc", "created_at": "", "completed_at": ""}, {"path": "/@kuriskeb_2/works/49", "thumbnail_src": "https://si.imgix.net/c9df443b/uploads/origins/0986975e-d88b-441f-9ec2-c718dfe5e222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25f88866d9623e07efce4fe1922864ee", "thumbnail_srcset": "https://si.imgix.net/c9df443b/uploads/origins/0986975e-d88b-441f-9ec2-c718dfe5e222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25f88866d9623e07efce4fe1922864ee, https://si.imgix.net/c9df443b/uploads/origins/0986975e-d88b-441f-9ec2-c718dfe5e222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=baf8004151c457da82de88b8b4d4ab8a 2x, https://si.imgix.net/c9df443b/uploads/origins/0986975e-d88b-441f-9ec2-c718dfe5e222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2a23f364299eefbe681d647f6e939a4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuriskeb_2/works/48", "thumbnail_src": "https://si.imgix.net/f0ea219c/uploads/origins/ef599d5e-457c-425e-af2a-2cb6472ae9e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cb385f7a01c96a08cef16ae76988ad3", "thumbnail_srcset": "https://si.imgix.net/f0ea219c/uploads/origins/ef599d5e-457c-425e-af2a-2cb6472ae9e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cb385f7a01c96a08cef16ae76988ad3, https://si.imgix.net/f0ea219c/uploads/origins/ef599d5e-457c-425e-af2a-2cb6472ae9e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a024d49cfd4a852ab8b1329f0a7528e6 2x, https://si.imgix.net/f0ea219c/uploads/origins/ef599d5e-457c-425e-af2a-2cb6472ae9e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2332bce11561b954be921292c607fab 3x", "genre": "art", "nsfw": false, "body": "どんぐりさま、こんばんは🌙\n\n私のOCの男の子2人のリクエスト失礼いたします。\n\n《使用用途》\n個人鑑賞\n\n《キャラクター》\n①→ピンク髪の男の子\n②→茶髪の男の子\n詳しい容姿や設定は資料に入れさせていただいております。\n男の子ですがかわいいものが大好きな2人です！可愛らしく描いていただけると嬉しいです。\n\n《服装》\n資料にあるお洋服でも、アレンジでも、全く別のお洋服でも、なんでも嬉しいです！\n資料にあるお洋服の場合、簡略化や省略などしていただいても大丈夫です。\n\n《要望》\nもし可能であれば、過去リクエストにあるキャンディやパフェ、ドーナツやアイスなどの食べ物にキャラクターが入っているようなイラストですと嬉しいです！\n\n2人を1枚に描いていただいても、1人ずつ描いていただいても、どちらでも大丈夫です。\n\n\n受けていただくのが難しければ、遠慮なくお取り下げください。\n\nもしご縁がありましたら、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1yN0LOPOxYPM_aEfIVpWNKwoxtNCJSPXx", "created_at": "", "completed_at": ""}, {"path": "/@kuriskeb_2/works/47", "thumbnail_src": "https://