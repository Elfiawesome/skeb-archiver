87a59bc 2x, https://si.imgix.net/23ca8403/uploads/origins/01d8aed7-5d62-4c07-b5c8-b05476a5c3fe?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a28d6e50d23d30477643dcbfd5109b9b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/13", "thumbnail_src": "https://si.imgix.net/da4598f4/uploads/origins/75d0a6a0-40bc-4486-ad07-d11d4430f8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0404cef4e88b39420cd6e100851d4faa", "thumbnail_srcset": "https://si.imgix.net/da4598f4/uploads/origins/75d0a6a0-40bc-4486-ad07-d11d4430f8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0404cef4e88b39420cd6e100851d4faa, https://si.imgix.net/da4598f4/uploads/origins/75d0a6a0-40bc-4486-ad07-d11d4430f8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74a83d3452617675f85d26c71a7cf59e 2x, https://si.imgix.net/da4598f4/uploads/origins/75d0a6a0-40bc-4486-ad07-d11d4430f8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4ddc1fb54d09e4da2801b63c7ddb122 3x", "genre": "art", "nsfw": true, "body": "お世話になっております！\nこちらのスカル団堕ちマーマネ君（https://skeb.jp/@eruchubby/works/6）で、抱き枕風のイラストを描いていただけませんでしょうか…？\n仰向けになったマーマネ君の全身を収めてください。\n\n見た目の特徴は過去のイラストそのままでお願いします。\nパンツは履いたまま、かつ、勃起は無しで、股間のもっこりは大き目でお願いします！\n腋は少なくとも片方は全開でお願いします。\n靴は片方脱いでいて、臭い靴下があらわになっています。また、脱ぎ捨てられた靴を傍に転がしてください。", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/12", "thumbnail_src": "https://si.imgix.net/4ef46a23/uploads/origins/72368861-0f7b-420c-9ed0-f4322f7b98ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b74d10ac94098ba71764e77835e5ce", "thumbnail_srcset": "https://si.imgix.net/4ef46a23/uploads/origins/72368861-0f7b-420c-9ed0-f4322f7b98ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b74d10ac94098ba71764e77835e5ce, https://si.imgix.net/4ef46a23/uploads/origins/72368861-0f7b-420c-9ed0-f4322f7b98ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c17530dd46639918a48012469fc7e74f 2x, https://si.imgix.net/4ef46a23/uploads/origins/72368861-0f7b-420c-9ed0-f4322f7b98ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ed72b8845b8783b29fb6965b66938e4 3x", "genre": "art", "nsfw": true, "body": "希望您能尝试绘画我的oc的日常图，浑身赤裸插着导管排乳射精，然后吃着零食的样子！\n\nhttps://drive.google.com/file/d/1yhYV8BFbru6Bb6vVVJrG-dfiQzmbXBqx/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1Dlhl1duBmLUdndlIlC2uzxt8pemQ1Bsk/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/11", "thumbnail_src": "https://si.imgix.net/23556a38/uploads/origins/9679d1c8-c467-484e-818c-58e6626dab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d244b8455457cc0bde44411b0e52b169", "thumbnail_srcset": "https://si.imgix.net/23556a38/uploads/origins/9679d1c8-c467-484e-818c-58e6626dab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d244b8455457cc0bde44411b0e52b169, https://si.imgix.net/23556a38/uploads/origins/9679d1c8-c467-484e-818c-58e6626dab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=387af21b0ad4bd01994148e376b9eb7f 2x, https://si.imgix.net/23556a38/uploads/origins/9679d1c8-c467-484e-818c-58e6626dab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e46c3614847880388e9586680518572 3x", "genre": "art", "nsfw": true, "body": "こんにちは、太った男の子の絵を描いてください。 触手に弄ばれ、服が破れ、ペニスが射精するまで触手に弄ばれている太った男の子を描いてください。都合がつけば、絶え間なく涙を流し、よだれを垂らしながらオーガズムと快楽の限りを弄ばれている彼の顔を見てみたい。 ファットボーイは紫色の髪と目をしている。 もしご都合がよろしければ、ファットボーイの表情はこちらでご覧いただけます：\n\nhttps://twitter.com/Qishuisoda/status/1556766396285333505?t=aStt4ER0vNdzUIcY55FCag&s=19\n\nhttps://twitter.com/Qishuisoda/status/1556766396285333505?t=aStt4ER0vNdzUIcY55FCag&s=19", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/10", "thumbnail_src": "https://si.imgix.net/1ce6d132/uploads/origins/bd59e48e-4b47-45c4-8596-9cfd0049d4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=647046098ec6fd4b3816c8c8a349aa43", "thumbnail_srcset": "https://si.imgix.net/1ce6d132/uploads/origins/bd59e48e-4b47-45c4-8596-9cfd0049d4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=647046098ec6fd4b3816c8c8a349aa43, https://si.imgix.net/1ce6d132/uploads/origins/bd59e48e-4b47-45c4-8596-9cfd0049d4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53536e3fe6f0640a6747debf83084154 2x, https://si.imgix.net/1ce6d132/uploads/origins/bd59e48e-4b47-45c4-8596-9cfd0049d4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa0dc5877d97994354d47b2358d89375 3x", "genre": "art", "nsfw": true, "body": "はじめまして、いつも作品楽しみに拝見しております。\n\nリクエストしたいキャラはドラゴンボールのヤジロベー(悟空と初めて会った頃の姿)です。\n前垂れを持ち上げて、ふんどし姿を見せているところをお願いします。\n脇や股のムダ毛生えっぱなしで、むわっと汗ばんでいると嬉しいです\n\n可能でしたら、以下のようなパターンをお願いしたいです。\n・ふんどし一丁で通常ちんちん。\n・ふんどし一丁で勃起ちんちん。先走り汁で\n    染みが広がっている。\n・全裸で通常ちんちん。先っぽまで皮が\n    被っている。\n\nご検討よろしくお願いいたします!", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/9", "thumbnail_src": "https://si.imgix.net/9ed29cd6/uploads/origins/5090ffc0-ec77-40bf-8ffc-3e7045bee862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7c04dfc99291cb8c2ab557f843c6b72", "thumbnail_srcset": "https://si.imgix.net/9ed29cd6/uploads/origins/5090ffc0-ec77-40bf-8ffc-3e7045bee862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7c04dfc99291cb8c2ab557f843c6b72, https://si.imgix.net/9ed29cd6/uploads/origins/5090ffc0-ec77-40bf-8ffc-3e7045bee862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=993e93ff65078cd6c0b2b38fe11d039a 2x, https://si.imgix.net/9ed29cd6/uploads/origins/5090ffc0-ec77-40bf-8ffc-3e7045bee862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0171064bf9455fc7b35f693486925ecd 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n前回描いていただいた足を嗅がせてくるSデブくんが、自分でその臭いを嗅ぐのも好きという設定で、裸足になった自分の足裏に鼻を近づけてクンクンと深呼吸するようにその臭いを嗅いでいるイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/8", "thumbnail_src": "https://si.imgix.net/6dc875a4/uploads/origins/08c795a6-0307-43c0-882b-29ea03e9f4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b85c0b91190f739380f6c51c0cccfd", "thumbnail_srcset": "https://si.imgix.net/6dc875a4/uploads/origins/08c795a6-0307-43c0-882b-29ea03e9f4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b85c0b91190f739380f6c51c0cccfd, https://si.imgix.net/6dc875a4/uploads/origins/08c795a6-0307-43c0-882b-29ea03e9f4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d647ea6b0fe51fa3b32a6e258b20bd6c 2x, https://si.imgix.net/6dc875a4/uploads/origins/08c795a6-0307-43c0-882b-29ea03e9f4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1db8ffacecd7eaac50f1dec09ef4ac3f 3x", "genre": "art", "nsfw": true, "body": "はじめまして、いつも素晴らしいイラストをありがとうございます。\nリクエスト内容ですが、足のにおいを嗅がせてくる太め男子のイラストをお願いします。\n\n詳細：\n・肉厚な裸足の足裏を見せつけるような体勢で、つま先からかかとまで足裏全体が見えている構図\n・髪は短髪\n・いかにも悪ガキといったヤンチャな表情\n・上はタンクトップ、下は太腿が見えるくらいの丈の短パン\n・汗だく\n・体毛は無し\n・腕や太腿もむっちりと太い\n\nもし差分の対応が可能であれば、上半身だけ裸の差分もいただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/7", "thumbnail_src": "https://si.imgix.net/92f24a28/uploads/origins/818c129a-8ab3-4927-839b-e9f1a5a8b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff4dc1f6a7729a9121d36c9e4eedc823", "thumbnail_srcset": "https://si.imgix.net/92f24a28/uploads/origins/818c129a-8ab3-4927-839b-e9f1a5a8b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff4dc1f6a7729a9121d36c9e4eedc823, https://si.imgix.net/92f24a28/uploads/origins/818c129a-8ab3-4927-839b-e9f1a5a8b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72be6b2961a78e5fe0f7fc4991c7ba47 2x, https://si.imgix.net/92f24a28/uploads/origins/818c129a-8ab3-4927-839b-e9f1a5a8b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e37448c10d0079ed8cc3689f7e4cc3d2 3x", "genre": "art", "nsfw": true, "body": "再開お待ちしてました～！\n\nマーマネ君で、ニオイフェチが歓喜しそうな、とにかく臭そうでムワッとくる１枚をお願いします！\n\n衣装はこちらのイラストと全く同じパンツ１枚でお願いします！\n股間のもっこり具合や、乳輪のサイズ、肌の色白さなども、参考URLと同じにしてください！\nhttps://skeb.jp/@eruchubby/works/2\n\n勃起は無しでお願いします！\n\n差分で、える先生が一番臭そうに感じる肌の色をしたマーマネ君をお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/6", "thumbnail_src": "https://si.imgix.net/d6b572d0/uploads/origins/ebd5edd6-e9fd-4316-839a-c043c4f82c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac12692d8317cd516a61ab08dbdaad94", "thumbnail_srcset": "https://si.imgix.net/d6b572d0/uploads/origins/ebd5edd6-e9fd-4316-839a-c043c4f82c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac12692d8317cd516a61ab08dbdaad94, https://si.imgix.net/d6b572d0/uploads/origins/ebd5edd6-e9fd-4316-839a-c043c4f82c48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ba6dc85c1289be681b640b86da879ee 2x, https://si.imgix.net/d6b572d0/uploads/origins/ebd5edd6-e9fd-4316-839a-c043c4f82c48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1a6ecb5ba47bb41ff33cc9aa9dbd802 3x", "genre": "art", "nsfw": true, "body": "スカル団堕ちしたマーマネ君をお願いします！！\n\nマーマネ君の体型や色、もっこり具合はこちらの作品【https://skeb.jp/@eruchubby/works/2】をベースにしてください。\n今回はボーボーに伸びきった真っ黒な腋毛をもっさりと生やしてくれればと思います。\n\n衣装はアニメやゲームのスカル団のコスチュームを着せてください。\n以下の点だけ変更をお願いします。\n・タンクトップは丈が足りず、腹が出てへそが丸見えになっている\n・ズボンは穿いてなく、エナメル質の真っ黒でパツパツなビキニパンツのみ\n・靴下はダルダルのルーズソックス\n・スカーフは首元まで下げて、口が見えている\n\n汗だくで臭そうにしてください。\n表情も悪に染まりきった邪悪な顔をさせてください。\n\nあと、よろしければ、汚いゴミの山とドガース等の臭そうなポケモンを背景に描いてください。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@eruchubby/works/5", "t