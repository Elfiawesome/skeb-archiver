=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4a51678fe6ca17cead9a81175d4d0e, https://si.imgix.net/039433af/uploads/origins/564dd1b9-db45-4cf1-a256-71bc973eaa33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53f61d7df4cfd3e6733e09dfa7c5a2a4 2x, https://si.imgix.net/039433af/uploads/origins/564dd1b9-db45-4cf1-a256-71bc973eaa33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d68abc55d989e9ea6b46517950592daf 3x", "genre": "art", "nsfw": false, "body": "Hello!\n\nI'd love to request an illustration of my OC/Vtuber Liabell! She is a former delinquent turned alchemist, with a love of girls and the stars.\nI'd like her to be drawn in Elphelt's Strive outfit, with the appearance based on a color mod made for her! I love your art of Elphelt and thought you would be the best choice for this!\n\nLiabell: https://drive.google.com/file/d/10zrNXyrfb25wYBiiKqx-Gt9J6Q4zD39t/view?usp=sharing\nhttps://drive.google.com/file/d/1Pyf6y6tf1lUF5yVYTsW3x27RB09OkWSL/view?usp=sharing\n\nMod Reference:\nhttps://drive.google.com/file/d/1rLXi8G3EIsOScE1l2TdW8sddHeI-m5Rc/view?usp=sharing\n\nOnly difference is that I want Liabell's hair to have the color gradient of her normal design and the tied up hairstyle with the hairpin. (Since that couldn't be replicated in-game)\nI'll leave the pose and expression up to you!\n\nThank you for the opportunity!!", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/50", "thumbnail_src": "https://si.imgix.net/75241240/uploads/origins/78d00971-2aad-4f38-8342-e934130e56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a8efc75f370860e90405fe5c72b8781", "thumbnail_srcset": "https://si.imgix.net/75241240/uploads/origins/78d00971-2aad-4f38-8342-e934130e56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a8efc75f370860e90405fe5c72b8781, https://si.imgix.net/75241240/uploads/origins/78d00971-2aad-4f38-8342-e934130e56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94f278b1a00627541af2735eb563d2b5 2x, https://si.imgix.net/75241240/uploads/origins/78d00971-2aad-4f38-8342-e934130e56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6bd834667d5f12135eb66e78b04861c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、sugagです。ギルティギアのエルフェルトと、幻影異聞録のシンヤンのアートワークをお願いします。\n\nhttps://guiltygear.fandom.com/wiki/Elphelt_Valentine\n\nhttps://genshin-impact.fandom.com/wiki/Xinyan\n\n私のアイデアは、二人がコンサートで歌い、シンヤンが能力を使って二人の後ろに炎を作り、二人が歌うというものです！", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/49", "thumbnail_src": "https://si.imgix.net/cecd607f/uploads/origins/0422bd51-f72c-4af4-8804-b015b543e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7599f8ba53cb4b2af8b26c7b25ee9d47", "thumbnail_srcset": "https://si.imgix.net/cecd607f/uploads/origins/0422bd51-f72c-4af4-8804-b015b543e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7599f8ba53cb4b2af8b26c7b25ee9d47, https://si.imgix.net/cecd607f/uploads/origins/0422bd51-f72c-4af4-8804-b015b543e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0eeb8842ea62f7c119c936abebf0fff 2x, https://si.imgix.net/cecd607f/uploads/origins/0422bd51-f72c-4af4-8804-b015b543e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e23332f5c6c804249e854c5b14c9af5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\nSkebを使うのは初めてなので、間違いがあったらごめんなさい。ファイアーエムブレムエンゲージのロサドを依頼したいです。彼のカジュアルな服装がかわいくて、とても気に入っています。リンク先のポーズ（ポーズは最後の画像です）で描いていただけませんか？とてもかわいいので、前かがみになってスカートを上げてお尻を見せてほしいです。かわいい赤面顔で。ありがとうございました！\n\nhttps://imgur.com/a/qxCYaxS", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/48", "thumbnail_src": "https://si.imgix.net/d252eaf2/uploads/origins/0176cea5-1071-4f99-aee0-32cc5c1e111b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c128038eb6d1440028de4acbbf7f6d63", "thumbnail_srcset": "https://si.imgix.net/d252eaf2/uploads/origins/0176cea5-1071-4f99-aee0-32cc5c1e111b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c128038eb6d1440028de4acbbf7f6d63, https://si.imgix.net/d252eaf2/uploads/origins/0176cea5-1071-4f99-aee0-32cc5c1e111b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4772d5b5de07e2c2f8b20a14a071a94f 2x, https://si.imgix.net/d252eaf2/uploads/origins/0176cea5-1071-4f99-aee0-32cc5c1e111b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ef33e4ecf3f94d2341f7961a32a7271 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のOC、ヴィー（彼女/彼女）のルームウェアか寝間着をリクエストしたいです。服のスタイルやデザインはお任せしたいのですが、最近の「今週もお疲れ様でした」のブリジット作品に似たような、可愛くて魅力的なものを探しています。\n\nhttps://x.com/VirtualHeroVee/status/1762638386177728738", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/47", "thumbnail_src": "https://si.imgix.net/6957708e/uploads/origins/7165fa1b-2217-4639-9f1b-aa68d22b6e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=706446e74e5864b6fe4e47807ff71557", "thumbnail_srcset": "https://si.imgix.net/6957708e/uploads/origins/7165fa1b-2217-4639-9f1b-aa68d22b6e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=706446e74e5864b6fe4e47807ff71557, https://si.imgix.net/6957708e/uploads/origins/7165fa1b-2217-4639-9f1b-aa68d22b6e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff443ad5cfc6c83a4eddf8a9b47605b2 2x, https://si.imgix.net/6957708e/uploads/origins/7165fa1b-2217-4639-9f1b-aa68d22b6e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a01f7c1723887db15ed3fe002fb6ba6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、スガグ！\n\nラムレタールのイラストをお願いします！あなたのスタイルで見てみたいです！\n\nhttps://drive.google.com/file/d/1I117EfImkzkUxPQPa3-N43GoGtZ3zNJJ/view?usp=sharing\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/46", "thumbnail_src": "https://si.imgix.net/0712ecf4/uploads/origins/684c6dc4-5cc7-4add-b412-9b6deffb38ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9399a73de5d4208a9d5ed75c6efae3de", "thumbnail_srcset": "https://si.imgix.net/0712ecf4/uploads/origins/684c6dc4-5cc7-4add-b412-9b6deffb38ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9399a73de5d4208a9d5ed75c6efae3de, https://si.imgix.net/0712ecf4/uploads/origins/684c6dc4-5cc7-4add-b412-9b6deffb38ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2da2ac31e25d358b06faac1d966ee3b 2x, https://si.imgix.net/0712ecf4/uploads/origins/684c6dc4-5cc7-4add-b412-9b6deffb38ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c86a317c573fb35f79b07d98012391c0 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、Sugagです！僕のオーク、ガブリエルとドレイヴンを主人公にしたコミックをリクエストしたいんだ。\n\n漫画のアイデアはこんな感じです：\n\nhttps://drive.google.com/file/d/1dZR07iBiOYL7kn3bQVlA68f-P37P3Hb4/view?usp=drivesdk\n\nパネル1：ドレイヴンがガブリエルといちゃつこうとしている。ドレイヴンはドヤ顔で「男の子とキスするのが好きなんでしょ」と言う。\n\nパネル2：ガブリエルはドレイヴンのあごに手をやり、身を乗り出す。ドレイヴンはドヤ顔を崩し、慌てた様子を見せる。\n\nパネル3：唇にズームインしながらキスをする。\n\nパネル4：二人はキスをやめ、二人の間に唾液の跡が残る。\n\nパネル5：ガブリエルは満足げな表情で、\"イエス \"とだけ言って歩き始める。背後のドレイヴンはショックを受け、赤い顔をしている。\n\nガブリエル：https://drive.google.com/file/d/1dTkNt3h6k7QPedqwDONieNf_5UfRwMDz/view?usp=drivesdk\n\nドレイブン： https://drive.google.com/file/d/1VLtQYqtSHk8ndePunxRFg5KVq17WsKFM/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/45", "thumbnail_src": "https://si.imgix.net/48fcd8bb/uploads/origins/8aab6097-c9e2-4adb-a8fd-fb4e774f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15956ff209f84357c26c35789cb3078", "thumbnail_srcset": "https://si.imgix.net/48fcd8bb/uploads/origins/8aab6097-c9e2-4adb-a8fd-fb4e774f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15956ff209f84357c26c35789cb3078, https://si.imgix.net/48fcd8bb/uploads/origins/8aab6097-c9e2-4adb-a8fd-fb4e774f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d75e5a39a5b08d43d91f8ab7599672c 2x, https://si.imgix.net/48fcd8bb/uploads/origins/8aab6097-c9e2-4adb-a8fd-fb4e774f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db0d798a44ef9b8bbdd3a07c7c39f310 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\nファイアーエムブレムフェイト( https://static.wikia.nocookie.net/fireemblem/images/c/c1/Mozu_Heroes.png/revision/latest?cb=20240415044736 )に登場するモズが、ブリジットが着ているギルティギアストライブの衣装を、モズの配色に合わせて衣装の色を変えつつ、ウエストアップしたアートワークをお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/44", "thumbnail_src": "https://si.imgix.net/72c2ed8e/uploads/origins/1fa6a5d1-ed9b-45f0-ba2b-c66ac8026c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d6ce54a81c9c58ce31de6429a964b8", "thumbnail_srcset": "https://si.imgix.net/72c2ed8e/uploads/origins/1fa6a5d1-ed9b-45f0-ba2b-c66ac8026c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d6ce54a81c9c58ce31de6429a964b8, https://si.imgix.net/72c2ed8e/uploads/origins/1fa6a5d1-ed9b-45f0-ba2b-c66ac8026c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bfed777fb810bc6af7c5e707d5adf94 2x, https://si.imgix.net/72c2ed8e/uploads/origins/1fa6a5d1-ed9b-45f0-ba2b-c66ac8026c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42f2c19235484ba542042c6663f4e507 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のオリジナル・キャラクターを2人お願いしたいのですが！\n\nライラ・モンテブランは、ちょっと不器用で浮気性だけど、大切な人を大切にする優しい若い女性。ライラはダンサーであり、アクロバットでもあり、その特技で人々を楽しませている。https://imgur.com/a/jhCliRo\n\nルシア・プリチャードは少し年上の女性だが、ライラとは正反対だ。ルシアはもう少し抜け目がなく秘密主義で、ダンサーやエンターテイナーとしての仕事と同時に、スパイや情報提供者でもある。ルシアはしばしばライラを妹のように扱い、ライラがトラブルに巻き込まれることを恐れている。https://imgur.com/a/arHHncM\n\n中世の酒場を舞台にしたような雰囲気の舞台で、2人が一緒に踊るところが見てみたい！ https://pbs.twimg.com/media/GQjWS-HbsAAEocz?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/43", "thumbnail_src": "https://si.imgix.net/7880f122/uploads/origins/f7b17ddc-0146-4a42-acbb-250edaf8c282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1265fc844254e0db1631a430bacc5b3d", "thumbnail_srcset": "https://si.imgix.net/7880f122/uploads/origins/f7b17ddc-0146-4a42-acbb-250edaf8c282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1265fc844254e0db1631a430bacc5b3d, https://si.imgix.net/7880f122/uploads/origins/f7b17ddc-0146-4a42-acbb-250edaf8c282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6f9345d7fe8f0c58590a2c448e46b83 2x, https://si.imgix.net/7880f122/uploads/origins/f7b17ddc-0146-4a42-acbb-250edaf8c282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f85a170365ff3f9a11225fc2aca8318 3x", "genre": "art", "nsfw": true, "body": "私のOCを描いていただけませんか？\nソファに横たわって淫らなポーズをとっている可能性があります。\nディーラーが選びます。\n\nhttps://drive.proton.me/urls/33HBS6WH1R#PxK7eIf8lV5s", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/42", "thumbnail_src": "https://si.imgix.net/8ec353a1/uploads/origins/38a372f5-9c05-4c33-827c-e4dbcdb69d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a54335d190e99593badb206807c3064b", "thumbnail_srcset": "https://si.imgix.net/8ec353a1/uploads/origins/38a372f5-9c05-4c33-827c-e4dbcdb69d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a54335d190e99593badb206807c3064b, https://si.imgix.net/8ec353a1/uploads/origins/38a372f5-9c05-4c33-827c-e4dbcdb69d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c0a30b61bb675e4f5b1f58740fc2ee 2x, https://si.imgix.net/8ec353a1/uploads/origins/38a372f5-9c05-4c33-827c-e4dbcdb69d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=056b9bdf5218128791288dc9af06e6b1 3x", "genre": "art", "nsfw": true, "body": "ああ、こんなに早く終わるとは思いませんでした！どうもありがとう。両方同時に送りたかった。タワレコの恋乃にもまたへそをつつかれて同じことが起こってほしい。彼女にそれを行うキャラクターの選択については、ジャム、ラマサル、A.B.A. の中から選ぶことができます。一番最初のメイの顔が縮こまっている顔に似た恋乃の表情を2つ教えていただければ大変助かります。いつもありがとうございます。また、立て続けにお願いして申し訳ありません。", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/41", "thumbnail_src": "https://si.imgix.net/06843d16/uploads/origins/29705434-52aa-415a-8e1f-0845e8ff0044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=178346f5edc23d05905b3aafb386be2c", "thumbnail_srcset": "https://si.imgix.net/06843d16/uploads/origins/29705434-52aa-415a-8e1f-0845e8ff0044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=178346f5edc23d05905b3aafb386be2c, https://si.imgix.net/06843d16/uploads/origins/29705434-52aa-415a-8e1f-0845e8ff0044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=987ebe7e0ced7f4f62a398c85feac529 2x, https://si.imgix.net/06843d16/uploads/origins/29705434-52aa-415a-8e1f-0845e8ff0044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=117c5bee113487fc0ad2358580646b44 3x", "genre": "art", "nsfw": true, "body": "前回の依頼でやっていただいた作品が気に入ったので、タワーレコードの恋乃ちゃんのおへそをつついてもらいたいと思っていました。希望キャラクターはエルフェルト、ジャム、キャミィの中からお選びいただきたいです。特にこだわりはありませんが、ポーズは自由自在です。一番欲しいのは前作と似た表情だと思います。皆さんの尽力に感謝しており、今回がどうなるか楽しみです!", "created_at": "", "completed_at": ""}, {"path": "/@sugagsugag0524/works/40", "thumbnail_src": "https://si.imgix.net/657ec463/uploads/origins/2065c83b-2401-49fb-b454-c2963e211f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd37bfd639e569d9f889df6eabe7e94a", "thumbnail_srcset": "https://si.imgix.net/657ec463/uploads/origins/2065c83b-2401-49fb-b454-c2963e211f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd37bfd639e569d9f889df6eabe7e94a, https://si.imgix.net/657ec463/uploads/origins/2065c83b-2401-49fb-b454-c2963e211f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9af557105e4