2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9757b658ef0d57307257d9434099aa2 2x, https://si.imgix.net/1f821dfc/uploads/origins/5dae9b20-0ec2-4ffc-80c9-f3517b7f4736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d887a82e054928738dc0a5a80b86856 3x", "genre": "art", "nsfw": true, "body": "SKET DANCE(スケットダンス)の丹生美森をお願いします。乳輪ごと胸ポチした学生服を着たまま母乳が吹き出しています。boobs pocketという乳袋の状態にしてほしいです。胸の大きさはgifを参考に。\nhttps://imgur.com/JifEmDY\nhttps://imgur.com/gallery/t26q1\n学生服全体https://www.suruga-ya.jp/database/pics_light/game/501015426.jpg\n\nhttps://twitter.com/jamorbital/status/1174038598141849600?t=0q6o_ICxySo0KxLMfifLjA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Kan_TORI/works/102", "thumbnail_src": "https://si.imgix.net/513fa532/uploads/origins/67d7a13f-d61b-4e81-bad9-b103426a8805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe5d7bd9a2783f1d66de71089e086143", "thumbnail_srcset": "https://si.imgix.net/513fa532/uploads/origins/67d7a13f-d61b-4e81-bad9-b103426a8805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe5d7bd9a2783f1d66de71089e086143, https://si.imgix.net/513fa532/uploads/origins/67d7a13f-d61b-4e81-bad9-b103426a8805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b63955c5b0f7d5c3d6c4aa4703e73703 2x, https://si.imgix.net/513fa532/uploads/origins/67d7a13f-d61b-4e81-bad9-b103426a8805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92bfc97477e82ea07c1609ba6a6d454b 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n◎橘夏音でお願いします。\n※相手は、最小限で結構ですが、洸でお願いです\n「シチュ」\n全裸の夏音ちゃんが騎乗位で、乳首をつままれながら、激しく突かれてる様。\nアヘ顔、母乳あり\n 「構図・表情」 https://milkfactory.jp/products/hbunny/common/img/gallery/23/slide4.jpg \n(頭のバニーは無しで)\n \n「乳サイズ」https://x.com/Kan_TORI/status/1819002643085238633?s=19\n(向かって左から3番目、右から2番目の超乳)\n\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Kan_TORI/works/101", "thumbnail_src": "https://si.imgix.net/3b8c1f3c/uploads/origins/c4417cc1-6621-4a9f-93bd-9e58257c94c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247e01902c5b523de75e1abd2d9e0a17", "thumbnail_srcset": "https://si.imgix.net/3b8c1f3c/uploads/origins/c4417cc1-6621-4a9f-93bd-9e58257c94c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247e01902c5b523de75e1abd2d9e0a17, https://si.imgix.net/3b8c1f3c/uploads/origins/c4417cc1-6621-4a9f-93bd-9e58257c94c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1260b598e754397f57a02ea99bd2ec5 2x, https://si.imgix.net/3b8c1f3c/uploads/origins/c4417cc1-6621-4a9f-93bd-9e58257c94c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7864a32192f055142918a05849d6977c 3x", "genre": "art", "nsfw": true, "body": "風都探偵のときめお願いします。\n\nシーン：\n敵に捕らえられ、情報を吐かせるために電気責めを受け拷問されます。\n○参考URLの椅子拘束\n○膣と尻穴には特大ディルドとアナルプラグが挿入されており、乳と足の裏と太もも内側と下腹部に複数の電気パッド、乳首＆クリに電極クリップ挟み付け\n○隣のテーブルには自白剤や注射器などが置いてある\n○大量の汗、股間の下は尿で水たまりが出来てボタボタ椅子から垂れ落ちてる。\n○布で目隠しをされているが少しズレており、片目が見えている、涙を流しながら睨みつける表情\n○自殺防止の為に噛ませタオルの猿轡までされ。\n\n以上！\n構図の詳細はお任せします、自由に調整してください\n\nhttps://x.com/O05413785/status/1911786395821330653", "created_at": "", "completed_at": ""}, {"path": "/@Kan_TORI/works/100", "thumbnail_src": "https://si.imgix.net/8188dab3/uploads/origins/430a23f9-4c94-436e-938e-82c87e70699f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee5b146f46b4a22d8730091e16e36869", "thumbnail_srcset": "https://si.imgix.net/8188dab3/uploads/origins/430a23f9-4c94-436e-938e-82c87e70699f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee5b146f46b4a22d8730091e16e36869, https://si.imgix.net/8188dab3/uploads/origins/430a23f9-4c94-436e-938e-82c87e70699f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89bfb9e824cb4959abd63c60d257d1ed 2x, https://si.imgix.net/8188dab3/uploads/origins/430a23f9-4c94-436e-938e-82c87e70699f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7f9ec5bc019d83fc9b9ac30f2818ee6 3x", "genre": "comic", "nsfw": true, "body": "先日リクエストいたしました、橘夏音のコンパニオン風衣装イラストの後日談的な2ページのコミックをお願いします。\n大勢の来場者に露出の多い衣装を見られて興奮した夏音が、モーターサイクルショー会場内の人目につかないどこか（トイレや用具室など）で衣装のまま洸とがっつくようなセックスをしているというシチュエーションです。\n\n・不特定多数の男性にスケベな目で見られて興奮したことを洸に告白するようなセリフ\n・衣装のビキニ部分に染み出す母乳\n・レイカーズ3のCGのような、口元に片乳を持っていって二人で両側から乳首を舐める構図\n\nを2ページ内のどこかでお描きいただきたい以外はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Kan_TORI/works/99", "thumbnail_src": "https://si.imgix.net/914d0586/uploads/origins/57e83bd9-178a-48da-bd6c-01eb7d396b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23480c12b8c6d6e00812789e8e59081f", "thumbnail_srcset": "https://si.imgix.net/914d0586/uploads/origins/57e83bd9-178a-48da-bd6c-01eb7d396b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23480c12b8c6d6e00812789e8e59081f, https://si.imgix.net/914d0586/uploads/origins/57e83bd9-178a-48da-bd6c-01eb7d396b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=519184cdb5d95c58da705d3232476fce 2x, https://si.imgix.net/914d0586/uploads/origins/57e83bd9-178a-48da-bd6c-01eb7d396b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=005028b504d95cddb88c799997f7b621 3x", "genre": "comic", "nsfw": true, "body": "前回はリクエストにお答え頂きありがとうございました。\n\n今回も裏稼業巫女サツキの後日談をお願いしたいです。\n内容\n廃団地の一室、ボロボロの巫女装束で、色情霊の触手に拘束されたサツキ。色情霊の「退魔巫女ごっこ」の操り人形にされる。涎と涙を垂らしながら「悪鬼、滅殺」と虚ろに呪文を唱え、折れた刀をフラフラと振る。戦いながら犯され、射乳しつつ\n「ごめんなさい！ごめんなさい！！もう逆らいませんから、なんでもいうことききますから！」と泣き叫びながら絶頂。\n（できれば、サツキ本編であったようなサツキのモノローグを入れていただけるとうれしいです。）\n細かく注文申し上げすみません。宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kan_TORI/works/98", "thumbnail_src": "https://si.imgix.net/1e263ca2/uploads/origins/d671249e-9852-4c43-ae60-6916db3a11d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3031000a0e685f34e5919480ef74e8b", "thumbnail_srcset": "https://si.imgix.net/1e263ca2/upload