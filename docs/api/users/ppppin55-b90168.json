a33c4928703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9318522d1a9e6d1840b6ac1cafb0dd36", "thumbnail_srcset": "https://si.imgix.net/fb93917f/uploads/origins/2f765184-b324-419e-a764-ba33c4928703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9318522d1a9e6d1840b6ac1cafb0dd36, https://si.imgix.net/fb93917f/uploads/origins/2f765184-b324-419e-a764-ba33c4928703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64c505cb4f9428b01527b0449ada1de9 2x, https://si.imgix.net/fb93917f/uploads/origins/2f765184-b324-419e-a764-ba33c4928703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0968a38a6ddade17e01e51af124a69d6 3x", "genre": "art", "nsfw": false, "body": "こね田ぱんさま、はじめまして！\nアピールいただきありがとうございます\nVtuber 七八くまの さんのファンアートをお願いいたします！\n\n■情報など\n七八くまのさんのデザイン（三面図、バストアップ）は参考URLのご本人ツイートにございます\nhttps://twitter.com/kumano_78/status/1524788999704879104\n\n■リクエスト\n表情や構図に関しましては、こね田ぱんさんのイラストを見させていただきどのキャラクターもとてもかわいらしく描かれていたことから勝手ではありますが\n七八くまのさんのイメージである「かわいく元気いっぱい」のイメージのみをリクエストさせていただき、その他はおまかせでお願いしたいと思います\n（パステルカラーのやさしい色合いやポップなイメージはもちろん、七八くまのさん自身も配信内で食べ物の背景を使ってらっしゃったりしているので、こね田ぱんさんに描いていただければぴったりなのではと思っております）\n\n■お願い事項\n作成いただいたイラストについて、七八くまのさんの活動での使用可能性があることをご了承いただきたく思います\n\nよろしくお願いいたします！\n\nhttps://twitter.com/kumano_78/status/1524788999704879104", "created_at": "", "completed_at": ""}, {"path": "/@ppppin55/works/5", "thumbnail_src": "https://si.imgix.net/bf86412a/uploads/origins/f03c0f48-7a54-44a6-a666-9bad0aaae509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf97204471d25b9e7d9c8bdd882f0fee", "thumbnail_srcset": "https://si.imgix.net/bf86412a/uploads/origins/f03c0f48-7a54-44a6-a666-9bad0aaae509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf97204471d25b9e7d9c8bdd882f0fee, https://si.imgix.net/bf86412a/uploads/origins/f03c0f48-7a54-44a6-a666-9bad0aaae509?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce966314418317ccbdaee60e8cecb5aa 2x, https://si.imgix.net/bf86412a/uploads/origins/f03c0f48-7a54-44a6-a666-9bad0aaae509?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44f6e793f91a000e7a05767bd27aa60e 3x", "genre": "art", "nsfw": false, "body": "こんばんは。ふわふわとした絵柄と色遣いが素敵で、今回うちの子たちのイラストをリクエスト致します。\n『メーテライト・ルミエーラ』という変身ヒロインの女の子と相棒マスコットの『ウィル』で、下記デザイン資料はリクエストへの使用許可済です。\n\n【デザイン説明】\n主なデザインは最下部の資料URLをご参照ください。\n以下特徴的な要素です。\n▼ルミエーラ\n・性格や雰囲気は「人懐っこい・優しい・可愛らしい・清楚」のモチーフ。高校生くらいの純粋でまっすぐな女の子。\n・顔立ちはまつ毛がすらっと長い、少女から少し大人びた雰囲気。\n・瞳には黄色い星のハイライト。\n・頭部の髪飾りやティアラ、白いもふもふ装飾はそれぞれ独立してついている。\n・後髪は首元で内側にまとまってから、背中辺りから分け目が外側にふわっと広がる。後髪半ばのシルエットが天使の羽根のようにも見える意図。\n・胴のドレスと二の腕のフリルとはそれぞれ独立した装飾。\n・ドレスのロングスカートは下に向かってグラデーションで赤から淡いピンクになる。\n・前面の白ミニスカート側の両端に三段白リボンと真珠の装飾が付いている。\n▼ウィル\n・まんまる子竜。口は開かず目の表現や身体の動きで感情表現する。\n・額の宝石の他に、おしりの辺りの赤色も同じ宝石。目元の赤は模様。\n不明点や衣装・装飾の省略・簡易化などはすべておまかせ致します。\n\n【構図やポーズ】\n上記デザイン説明への解釈を含め、雰囲気・構図・ポーズなど最終的な判断をすべておまかせ致します。\nまた、元々アピール時の構想がある場合はそちらを優先希望。マスコット系キャラが不可の場合はルミエーラ(女の子)のみの描写で構いません。\n\n【使用用途】\nTwitterでのイラスト紹介・紹介ツイートを自身のモーメントへ追加。またアイコン・ヘッダーに利用する可能性があります。\n上記のモーメントを利用して第三者へリクエストする際にイラストを引用する場合があります。\n\n【その他】\nPSD形式でお願いします。キャラと背景のレイヤーを分けて、分離不可の場合は統合状態でも構いません。\n\n以上、検討のお時間をいただき恐縮ですが、どうぞよろしくお願いします！\n\n■参考資料\n一覧モーメント\nhttps://twitter.com/i/events/1504333386080731137\n\n『メーテライト・ルミエーラ＆ウィル』　資料\n\nhttps://drive.google.com/drive/folders/1BQq76eifAKcR-5nOzMmRwB8Koi4axmss?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ppppin55/works/4", "thumbnail_src": "https://si.imgix.net/09dd789f/uploads/origins/0353ba6f-2aec-48a8-8919-2f46bcecd305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbc6fff402030c2bdf698121ac007598", "thumbnail_srcset": "https://si.imgix.net/09dd789f/uploads/origins/0353ba6f-2aec-48a8-8919-2f46bcecd305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbc6fff402030c2bdf698121ac007598, https://si.imgix.net/09dd789f/uploads/origins/0353ba6f-2aec-48a8-8919-2f46bcecd305?bg=%23fff&auto=f