72-efd007076bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a993cac6ddcaf55f6d648d971937404d, https://si.imgix.net/c783d184/uploads/origins/6b3f640d-54f9-464e-9f72-efd007076bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5981256cc58766232f20485a973bc197 2x, https://si.imgix.net/c783d184/uploads/origins/6b3f640d-54f9-464e-9f72-efd007076bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e91f83bb8596a9ea20b6820ddff7f1c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の女の子たち、メグ（人間）とエミ（悪魔）についてお願いがあります。彼女たちが5歳くらいの子供だった頃、つまり出会った頃の姿を描いてほしいのです。二人を一緒にデザインしてください。子供の頃のメグはおてんばで、どんな冒険にも飛び込み、遊びで汚れるのも全く怖がりませんでした。髪が短かったため、男の子と間違えられることもありました。 エミは長い前髪で目と角を隠そうとしていました。角を恥ずかしがり、いじめられていました。いつもウサギのぬいぐるみを抱えていました。ある時、エミがいじめられているのを見たメグが彼女を守り、その日から二人は親友になりました。メグのおかげでエミは自信を持つようになりました。メグは明るい笑顔で、エミは照れたような笑顔でデザインしていただけませんか？\n\n衣装参考（変更可）：https://drive.google.com/drive/folders/1m-XsBpuInUP16Pg6MI-WuLzQzln1a7BW\n\n女の子たちの参考画像はこちら：https://drive.google.com/drive/folders/1k9TtbviFWXVvCBsd97VHSKy5Fc0RqBHN", "created_at": "", "completed_at": ""}, {"path": "/@omochimo300/works/242", "thumbnail_src": "https://si.imgix.net/4c5ab77f/uploads/origins/1e846454-e63c-4193-8c7a-3f7e7e4c6d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd582741835b35cc18fb7307b457ef11", "thumbnail_srcset": "https://si.imgix.net/4c5ab77f/uploads/origins/1e846454-e63c-4193-8c7a-3f7e7e4c6d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd582741835b35cc18fb7307b457ef11, https://si.imgix.net/4c5ab77f/uploads/origins/1e846454-e63c-4193-8c7a-3f7e7e4c6d72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e38614ea8d90aebfc95a9ff4bf383d1 2x, https://si.imgix.net/4c5ab77f/uploads/origins/1e846454-e63c-4193-8c7a-3f7e7e4c6d72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38e19fb46d673a23093e4327461c97af 3x", "genre": "art", "nsfw":