r&txtsize=30&txt=PRIVATE&s=1bb736b5f0f3a335bd81eb077a777458 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/21", "thumbnail_src": "https://si.imgix.net/f06a8573/uploads/origins/b4e77b93-dfdb-4367-9339-743e9e0c113a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13efcc035b474f1c7ca0f53a7a99d0da", "thumbnail_srcset": "https://si.imgix.net/f06a8573/uploads/origins/b4e77b93-dfdb-4367-9339-743e9e0c113a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13efcc035b474f1c7ca0f53a7a99d0da, https://si.imgix.net/f06a8573/uploads/origins/b4e77b93-dfdb-4367-9339-743e9e0c113a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac5212e863bddea23c370a5307a1a3a8 2x, https://si.imgix.net/f06a8573/uploads/origins/b4e77b93-dfdb-4367-9339-743e9e0c113a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6ec6e5475eddf81e3f7a2e1ffa4c006 3x", "genre": "art", "nsfw": true, "body": "こんにちは\nLILITHMONを描けますか？https://imgur.com/a/H0HZyQu\nhttps://imgur.com/a/QZulFuP\nhttps://imgur.com/a/yRhrRmL\n\nキャラクターがおっぱいを見せている。", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/20", "thumbnail_src": "https://si.imgix.net/3084ceca/uploads/origins/f8ba59d1-0e8c-4bad-a91d-f32f0a0692c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11263a6f7da618e9975055884749ade6", "thumbnail_srcset": "https://si.imgix.net/3084ceca/uploads/origins/f8ba59d1-0e8c-4bad-a91d-f32f0a0692c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11263a6f7da618e9975055884749ade6, https://si.imgix.net/3084ceca/uploads/origins/f8ba59d1-0e8c-4bad-a91d-f32f0a0692c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad0f9749e4deddc5d0c44717973f7e88 2x, https://si.imgix.net/3084ceca/uploads/origins/f8ba59d1-0e8c-4bad-a91d-f32f0a0692c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8be28bdf55a9d67a02da85475a4dd25 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/19", "thumbnail_src": "https://si.imgix.net/69ac16e4/uploads/origins/f316cb13-769c-434b-9493-0369ba602775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5045dcdba1e28f5bde2ec355e736473f", "thumbnail_srcset": "https://si.imgix.net/69ac16e4/uploads/origins/f316cb13-769c-434b-9493-0369ba602775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5045dcdba1e28f5bde2ec355e736473f, https://si.imgix.net/69ac16e4/uploads/origins/f316cb13-769c-434b-9493-0369ba602775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e214f6e85f29a62102ddb625321395f2 2x, https://si.imgix.net/69ac16e4/uploads/origins/f316cb13-769c-434b-9493-0369ba602775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e874db4f41cda8d833077724ed6fb0c1 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ゴリラ女の続編をモノクロ5-6ページでお願いします。\n最後のページはカラーでお願いします。\nもし色をつけたくなければ、あなたの決定を受け入れます。\n\n夫は今、研究室で妻の世話係をしている。\n妻はバナナを食べるのが大好きで、今でも夫にウンチを投げつけるのが好きだ。\nある日、科学者は別のゴリラの女性を作った。\n夫はそれが自分の姉（40）だと知ってショックを受ける。\n二人の女は互いを敵視し、胸を張り、怒鳴り合う。\n二人は戦うが、一人がKOされ、尻を上に向けて倒れる。  (勝敗はあなたにお任せします）。\n勝者は胸を叩いて勝利を祝う。\n彼女は敗者の露出したアソコを見て、オスゴリラの本能が彼女をムラムラさせる。\n彼女は自分のアソコを敗者のアソコで叩き始めるが、自分にはペニスがないことに気づく。\n彼女は辺りを見回し、地面に長いバナナを見つけた。\n彼女はバナナの半分を自分のアソコに挿入し、気持ちよくなる。\n彼女はもう半分をペニスのように使い、敗者の膣に何度も挿入し始める。\n敗者は最初戸惑い目を覚ますが、自分も興奮しているので勝者に突き続けさせる。\n夫は、妻と妹が人間として仲良くしていた頃のことを思い出す。(夫を描く必要はない）。\n両方の女性がついにオーガズムを迎え、片方の女性の膣にバナナが突き刺さったまま快感のあまり倒れる。", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/18", "thumbnail_src": "https://si.imgix.net/673cd322/uploads/origins/b36c44f1-6824-44ba-8e73-47f70ca051f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ec4b7e02e8ca702b2d4956d749fa70b", "thumbnail_srcset": "https://si.imgix.net/673cd322/uploads/origins/b36c44f1-6824-44ba-8e73-47f70ca051f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ec4b7e02e8ca702b2d4956d749fa70b, https://si.imgix.net/673cd322/uploads/origins/b36c44f1-6824-44ba-8e73-47f70ca051f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afae0270d3191af868cfa17b2ee4eadb 2x, https://si.imgix.net/673cd322/uploads/origins/b36c44f1-6824-44ba-8e73-47f70ca051f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0931c8afa7da99235157f8019dcad09a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/17", "thumbnail_src": "https://si.imgix.net/63f6d74b/uploads/origins/3793ecdc-37ff-4f36-b2b7-e4eddd0c1492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98b7c04fcc5a8d4a42878d87f9783bc3", "thumbnail_srcset": "https://si.imgix.net/63f6d74b/uploads/origins/3793ecdc-37ff-4f36-b2b7-e4eddd0c1492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98b7c04fcc5a8d4a42878d87f9783bc3, https://si.imgix.net/63f6d74b/uploads/origins/3793ecdc-37ff-4f36-b2b7-e4eddd0c1492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ace6d43e77816a3406f990533541e465 2x, https://si.imgix.net/63f6d74b/uploads/origins/3793ecdc-37ff-4f36-b2b7-e4eddd0c1492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0e3f9895b4a1abe2f96fab5cfe2c320 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/16", "thumbnail_src": "https://si.imgix.net/267b39ea/uploads/origins/e8c757ab-15f3-4ff7-81bc-6f2d64cd125d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=700116a0d40e86d112edb87153846e8e", "thumbnail_srcset": "https://si.imgix.net/267b39ea/uploads/origins/e8c757ab-15f3-4ff7-81bc-6f2d64cd125d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=700116a0d40e86d112edb87153846e8e, https://si.imgix.net/267b39ea/uploads/origins/e8c757ab-15f3-4ff7-81bc-6f2d64cd125d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff2b39b4366d71dfd35b09317f99e1b6 2x, https://si.imgix.net/267b39ea/uploads/origins/e8c757ab-15f3-4ff7-81bc-6f2d64cd125d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67b5ff870f29de91a5b7a2000c8f92c1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！悪の科学者に誘拐された夫と妻（30代）の3～4ページのモノクロ漫画が好きです。\n\n夫が目を覚ますと、科学者が妻の脳をオスのゴリラと取り替えていた。\n妻は裸で、額に縫い目があり、ゴリラのように振る舞っている。\n夫はショックを受け、妻を救おうとする前に妻を人間として思い出す。\n妻は夫をライバルだと思っている。妻は夫にウンチを投げつけるが、夫は近づき続ける。\n妻は激怒して夫に襲いかかり、夫はノックアウトされ、妻は胸を叩いて勝利を祝い、夫にウンコをかける。", "created_at": "", "completed_at": ""}, {"path": "/@hcupiko/works/15", "thumbnail_src": "https://si.imgix.net/709b93a0/uploads/origins/7923ffe4-9ac2-4cad-918c-66be79b40dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=