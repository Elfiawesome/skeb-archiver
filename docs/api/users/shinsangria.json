=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48097356aab95c8369c5a54bc77c902b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shinsangria/works/22", "thumbnail_src": "https://si.imgix.net/489873de/uploads/origins/27021f7b-6a08-4360-9abe-7ba8fc4a1748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f822132888aa60ae8c0ef00270b02b8", "thumbnail_srcset": "https://si.imgix.net/489873de/uploads/origins/27021f7b-6a08-4360-9abe-7ba8fc4a1748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f822132888aa60ae8c0ef00270b02b8, https://si.imgix.net/489873de/uploads/origins/27021f7b-6a08-4360-9abe-7ba8fc4a1748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dc5aa7130db5a971be1a01462fc0071 2x, https://si.imgix.net/489873de/uploads/origins/27021f7b-6a08-4360-9abe-7ba8fc4a1748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6358144c92064641f042a8c0fe7987dd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shinsangria/works/21", "thumbnail_src": "https://si.imgix.net/be2ed634/uploads/origins/d3b26165-8ccd-4c9f-a627-82dddc462afd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6cd78531cc178b78fd88fe99593236e", "thumbnail_srcset": "https://si.imgix.net/be2ed634/uploads/origins/d3b26165-8ccd-4c9f-a627-82dddc462afd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6cd78531cc178b78fd88fe99593236e, https://si.imgix.net/be2ed634/uploads/origins/d3b26165-8ccd-4c9f-a627-82dddc462afd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=905d8a8ba365bdd37a2f4e8afbb5828f 2x, https://si.imgix.net/be2ed634/uploads/origins/d3b26165-8ccd-4c9f-a627-82dddc462afd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52fbeb1687b71bfb4f221d5c0f35c75e 3x", "genre": "art", "nsfw": true, "body": "はじめまして、よろしければリクエストお願いします\n\n【キャラ】\nPSO2のアザナミ\n\n【服装】\n裸エプロン\n\n【シチュエーション】\nアザナミさんといちゃラブ同棲生活している前提\n朝、裸エプロン姿のアザナミさんが起こしにくるが、なかなか起きてくれないので朝勃ちを襲っちゃう感じ\n\n騎乗位で、接合部はエプロンの前掛け部分で隠れている\n\n\nたぶん不要だと思いますが、一応アザナミさんの資料も置いておきます\nhttps://drive.google.com/drive/folders/1iz0FrWwX7DuEmcQJs0JWSVZbnLlXRBWt?usp=drive_link\n\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@shinsangria/works/20", "thumbnail_src": "https://si.imgix.net/73afbc72/uploads/origins/beb0bf65-0749-45bb-b733-235c5805eac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b07388efa1398b7c0ee4319bb24abe8d", "thumbnail_srcset": "https://si.imgix.net/73afbc72/uploads/origins/beb0bf65-0749-45bb-b733-235c5805eac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b07388efa1398b7c0ee4319bb24abe8d, https://si.imgix.net/73afbc72/uploads/origins/beb0bf65-0749-45bb-b733-235c5805eac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99c737768d8a1a0559a0934737f799c0 2x, https://si.imgix.net/73afbc72/uploads/origins/beb0bf65-0749-45bb-b733-235c5805eac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b18b62fe756eb43e6f225113ad06355 3x", "genre": "comic", "nsfw": true, "body": "ご無沙汰しております\n以前ご制作いただきました「モブ彼氏が出来たシャインセイバーさん」の続き物をお願いしたく\n\n「男と相思相愛になった輝/シャインセイバー。最早結界も使わず秘密を共有し、必要な性欲処理は全て彼に頼っている健全(？)な状態で戦う日々。彼からの些か過激なお願いも恥ずかしがりつつ受け入れてしまっている」というシチュを想定しています\n\n・輝が男の部屋に通っているor同棲しているのがわかる描写をお願いしたく\n・学校制服姿のまま男と激しくヤっていたり、ひとしきりヤリ終えたあとは一緒にご飯orお風呂に入る等、幸せそうにしている\n・「この頃彼の\"お願い\"がどんどん遠慮なくなっているような…」「でもそれに応えてしまう自分も自分なのだけれど…♥」と自嘲気味のナレーション(※以降、色々な場面をオムニバス型式で見ているイメージです)\n\n・シャインセイバー姿でキメポーズ。ただしノーパンで、頬を赤らめている。「天界よりの使者」「あ…アナタだけの騎士♥　シャインセイバー」とキメ台詞を言う輝\n・我慢できなくなった彼に即エッチに持ち込まれているイメージで、以前の「モブ彼氏」依頼2作目の最終頁の左下のコマと同じ感じで駅弁体位で激しくエッチ。細かい点ですみませんが、シャインセイバーの青い衣装の背中の菱形の切れ込みが見える状態にしていただきたく\n\n・「輝がシャインセイバーのコスプレをしている状態でエッチしてみたいと頼まれた」イメージで、「IF02続」の5頁目に登場した「頭は輝、衣装はシャインセイバー」(可能ならカチューシャと羽飾りはアリ)に変身しており、喜ぶ男と対照的にちょっと呆れている輝\n・騎乗位or正常位(なるべく輝の身体の正面が全体的に見える形)でセックスに励む\n\n・また別の日という想定で、今度はシャインセイバーに変身した後に、わざわざ学校の制服に着替えるよう頼まれる。外で若干人目を気にしつつもデート\n・最終的に人けの無い場所で、立ちバックで青姦エッチにもつれ込んでしまう\n\n・エビルブレイン出現の報せを聞き変身して出動しようとするが、凛々しい雰囲気の彼女を見て興奮してしまった彼を鎮めるため一発ヤッてしまう。(IF02続とは違い)幸せそうな様子のシャインセイバー\n・最後に彼にキスをして飛び立っていく\n\nできるだけレイヤーが分割されているpsdファイルをいただけましたらありがたく存じます\n\nhttps://skeb.jp/@shinsangria/works/6", "created_at": "", "completed_at": ""}, {"path": "/@shinsangria/works/19", "thumbnail_src": "https://si.imgix.net/42520659/uploads/origins/4484b248-462c-49ad-86d3-46214e3e16ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51b2eaf2f566d49444e16c8b2f187900", "thumbnail_srcset": "https://si.imgix.net/42520659/uploads/origins/4484b248-462c-49ad-86d3-46214e3e16ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51b2eaf2f566d49444e16c8b2f187900, https://si.imgix.net/42520659/uploads/origins/4484b248-462c-49ad-86d3-46214e3e16ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36eae17a9ac8e4669548f0bf27820bc1 2x, https://si.imgix.net/42520659/uploads/origins/4484b248-462c-49ad-86d3-46214e3e16ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eee4af65e3b4df570d5af43