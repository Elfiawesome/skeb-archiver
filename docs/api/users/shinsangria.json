をテキストで付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、リリーベルはドSでオラついたメスガキ、といったイメージをベースにそれぞれお好きなように設定して頂いて構いません。\n\nかなり細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@shinsangria/works/9", "thumbnail_src": "https://si.imgix.net/f6cd8d79/uploads/origins/3c6a5134-17bc-4f7f-90e6-7ae751a90965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30acacccd64a19347e0108078fb8b938", "thumbnail_srcset": "https://si.imgix.net/f6cd8d79/uploads/origins/3c6a5134-17bc-4f7f-90e6-7ae751a90965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30acacccd64a19347e0108078fb8b938, https://si.imgix.net/f6cd8d79/uploads/origins/3c6a5134-17bc-4f7f-90e6-7ae751a90965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=528030027a2dd3d211c94d2df63b3234 2x, https://si.imgix.net/f6cd8d79/uploads/origins/3c6a5134-17bc-4f7f-90e6-7ae751a90965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=334b5259cba00c72696673cc0bc18604 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shinsangria/works/8", "thumbnail_src": "https://si.imgix.net/8584a6f6/uploads/origins/376cec11-1c6a-417c-9bcc-1f4edaa8ece7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab5a1fa1ab41d3159017d827eca30486", "thumbnail_srcset": "https://si.imgix.net/8584a6f6/uploads/origins/376cec11-1c6a-417c-9bcc-1f4eda