rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5819071ebda13928190602896cdcb326 2x, https://si.imgix.net/362f565c/uploads/origins/6c70b3f3-c9c9-4129-833a-7be03cae18da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9418e6fff272b63b6fe2c15edb29f5e5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/34", "thumbnail_src": "https://si.imgix.net/9baf6eb1/uploads/origins/74ed2440-9e40-4ee2-b8af-e513b5577628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71b1dfc2fd2ba830951c9f621d09032e", "thumbnail_srcset": "https://si.imgix.net/9baf6eb1/uploads/origins/74ed2440-9e40-4ee2-b8af-e513b5577628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71b1dfc2fd2ba830951c9f621d09032e, https://si.imgix.net/9baf6eb1/uploads/origins/74ed2440-9e40-4ee2-b8af-e513b5577628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=321836369ca71d6beae9a2a138f04c70 2x, https://si.imgix.net/9baf6eb1/uploads/origins/74ed2440-9e40-4ee2-b8af-e513b5577628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a64982cb3a9a5972149815f75d0aaa0d 3x", "genre": "art", "nsfw": false, "body": "そういえばまぉー。さんの絵で怒り顔や泣き顔をあまり見ないと思ったので、もしよろしければリクエストさせてください。\n『ウマ娘プリティーダービー』のヴ三姉妹をお願いします。\n【内容】\n姉に抱きついて泣いているヴィブロス。声を出すのもやっとなほど震えて泣きじゃくる。妹を泣かせた目の前の奴に対して無言でブチギレて睨みつけているヴィルシーナ＆シュヴァルグラン。\n\nというのをヴィブロスを泣かせた奴の一人称視点でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/33", "thumbnail_src": "https://si.imgix.net/8d705927/uploads/origins/7504bee6-fdf9-4958-82f5-fd9a5a75dde3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bb10c59b2138d7af6e26f3908bc902a", "thumbnail_srcset": "https://si.imgix.net/8d705927/uploads/origins/7504bee6-fdf9-4958-82f5-fd9a5a75dde3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bb10c59b2138d7af6e26f3908bc902a, https://si.imgix.net/8d705927/uploads/origins/7504bee6-fdf9-4958-82f5-fd9a5a75dde3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c906f58d9959fa26b1f02b9c44da3254 2x, https://si.imgix.net/8d705927/uploads/origins/7504bee6-fdf9-4958-82f5-fd9a5a75dde3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75f6fe93b940b58dbb482cdda6459045 3x", "genre": "art", "nsfw": false, "body": "『ウマ娘プリティーダービー』から、ウオッカがアストンマーチャンをおんぶしながらダイワスカーレットも抱っこしているイラストをお願いします。\n三人とも体操服にブルマ姿でお願いします。\n流石のウオッカも多分腕や脚が震えると思います。\nマーチャンはこちら側に目線を向けててほしいです。ウオッカとダスカは体勢の都合もあるので顔が見えなくても構いません。\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/32", "thumbnail_src": "https://si.imgix.net/38deacf1/uploads/origins/83d21f7c-526c-4461-b17f-5ebfdf4a5769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4392647ebfe692d075e99a150542c89d", "thumbnail_srcset": "https://si.imgix.net/38deacf1/uploads/origins/83d21f7c-526c-4461-b17f-5ebfdf4a5769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4392647ebfe692d075e99a150542c89d, https://si.imgix.net/38deacf1/uploads/origins/83d21f7c-526c-4461-b17f-5ebfdf4a5769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cc433aa36a220949dd12b552ce855bc 2x, https://si.imgix.net/38deacf1/uploads/origins/83d21f7c-526c-4461-b17f-5ebfdf4a5769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a134a28dd3f3f3b30f5f9d14835d53a6 3x", "genre": "art", "nsfw": false, "body": "はじめまして、あなたのアートワークは素晴らしく、私の依頼を受け入れてくれたら嬉しいです。私のFFXIVのmiqo'teの絵を依頼したいです。https://sta.sh/01w97z2xpy3w。服装はチャイナドレスを着てほしいです。https://sta.sh/0ugc84vadz0\n\n カラーリングは自由に変更できます。胸元を強調したセクシーなポーズにしてほしい。背景など細かい部分はお任せします。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/31", "thumbnail_src": "https://si.imgix.net/87763210/uploads/origins/c54ef4d5-844f-4d55-9b37-cb631ce0d489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1823bd66fabd96e702bc9f13fe1947", "thumbnail_srcset": "https://si.imgix.net/87763210/uploads/origins/c54ef4d5-844f-4d55-9b37-cb631ce0d489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1823bd66fabd96e702bc9f13fe1947, https://si.imgix.net/87763210/uploads/origins/c54ef4d5-844f-4d55-9b37-cb631ce0d489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e0bbb2ab7ba80c5dbaf8144fbad7348 2x, https://si.imgix.net/87763210/uploads/origins/c54ef4d5-844f-4d55-9b37-cb631ce0d489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ed1dde4da58dc9e46b7d6fba6b9d078 3x", "genre": "art", "nsfw": false, "body": "前回はカワカミプリンセスたちのマッサージ作品をありがとうございました。今回もウマ娘からリクエストお願いします。\n【内容】\nキャラクター\n・ダイワスカーレット\n・アストンマーチャン\n・ウオッカ（人形）\n②服装\n体操服\n③シチュエーション\nトレーニング中の二人。ベンチに座り、一つのスマホを二人で見てフォームの確認。二人の太ももにウォッカ人形が挟まれており、太ももで圧迫されて細くなっている。\n④構図\n正面から\n⑤表情\n二人はトレーニングに集中していて真剣な表情。ウオッカ人形の状況は気にしてない。\n\nよろしければお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/30", "thumbnail_src": "https://si.imgix.net/f51a5d9c/uploads/origins/eb63ff71-9ca5-4deb-9f8a-7d8847716f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac849b0e773e463f8a0e890418fd2aa5", "thumbnail_srcset": "https://si.imgix.net/f51a5d9c/uploads/origins/eb63ff71-9ca5-4deb-9f8a-7d8847716f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac849b0e773e463f8a0e890418fd2aa5, https://si.imgix.net/f51a5d9c/uploads/origins/eb63ff71-9ca5-4deb-9f8a-7d8847716f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fe22f2eac1f12706847555cb088b81e 2x, https://si.imgix.net/f51a5d9c/uploads/origins/eb63ff71-9ca5-4deb-9f8a-7d8847716f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edfe07549d347fbf5a2a11f58af45b98 3x", "genre": "art", "nsfw": false, "body": "初めまして、まぉーさん。\n　よろしければ、カワカミプリンセス（ウマ娘）トレーナーの手によって歯の手入れをされているイラストをお願いします。\n　構図は参考資料のようにお願いします。\n　表情は、嬉しさと苦しさが混同している感じにお願いします。\n服装やセリフの有無等、細かい部分はお任せします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1StPbDyO9aLPfF6XUALQSU_9AXY1OG_fL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/29", "thumbnail_src": "https://si.imgix.net/0e5e1f52/uploads/origins/cce5acbf-37b7-4d4a-ae0f-7993b4748f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a113c54830e64fe34cfa6185cb8a0a", "thumbnail_srcset": "https://si.imgix.net/0e5e1f52/uploads/origins/cce5acbf-37b7-4d4a-ae0f-7993b4748f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a113c54830e64fe34cfa6185cb8a0a, https://si.imgix.net/0e5e1f52/uploads/origins/cce5acbf-37b7-4d4a-ae0f-7993b4748f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe942700b7075ca02a3bf3cdd70ff61b 2x, https://si.imgix.net/0e5e1f52/uploads/origins/cce5acbf-37b7-4d4a-ae0f-7993b4748f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb811015cbfc85bc5d984850aac4592b 3x", "genre": "art", "nsfw": false, "body": "キャラ：ウマ娘のカワカミプリンセス\n衣装：マルゼンスキーの水着勝負服（サングラスの有無はお任せします）\nシチュエーションや構図などはお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/28", "thumbnail_src": "https://si.imgix.net/8a01489e/uploads/origins/1496afa8-c058-4755-b928-8a2abb962c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbdb95d69710f8cb814071bdc40ef5a", "thumbnail_srcset": "https://si.imgix.net/8a01489e/uploads/origins/1496afa8-c058-4755-b928-8a2abb962c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbdb95d69710f8cb814071bdc40ef5a, https://si.imgix.net/8a01489e/uploads/origins/1496afa8-c058-4755-b928-8a2abb962c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bd55823ab9bf75ca2533de187349aa1 2x, https://si.imgix.net/8a01489e/uploads/origins/1496afa8-c058-4755-b928-8a2abb962c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2981c0dc2bdea50ab0072da9cbe6fdd6 3x", "genre": "art", "nsfw": false, "body": "ウマ娘のビワハヤヒデのイラストをお願いします。\n・衣装はFGOの光のコヤンスカヤ（第一再臨）\n・表情やポーズ等ついてはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/27", "thumbnail_src": "https://si.imgix.net/05fb6b93/uploads/origins/79192777-c675-412f-8c45-103daced5376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=266bcf6fb0d7b341556f71d28a3d9d29", "thumbnail_srcset": "https://si.imgix.net/05fb6b93/uploads/origins/79192777-c675-412f-8c45-103daced5376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=266bcf6fb0d7b341556f71d28a3d9d29, https://si.imgix.net/05fb6b93/uploads/origins/79192777-c675-412f-8c45-103daced5376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bf36f9e882676479385888bf8c53912 2x, https://si.imgix.net/05fb6b93/uploads/origins/79192777-c675-412f-8c45-103daced5376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebeff7e0c8dc397a9667b566d7d43c08 3x", "genre": "art", "nsfw": false, "body": "自分のオリキャラのミヨちゃんを描いてほしいです\nダイナミックな構図が好きなので\nポーズは動きのあるものがいいです\n背景は特に指定はないです\n\nキャラ立ち絵\nhttps://gyazo.com/ad347226359971d3ccffa9c6bdcd3d69\nキャラの特徴・注意事項\nhttps://gyazo.com/5a28aaa9e33b8f5d7ab484ee2146ba6f", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/26", "thumbnail_src": "https://si.imgix.net/b03b9a69/uploads/origins/37b4b407-5a8b-4e6a-92c9-a2cf83db85f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74c7ba0c1c336636bb50429b514ed293", "thumbnail_srcset": "https://si.imgix.net/b03b9a69/uploads/origins/37b4b407-5a8b-4e6a-92c9-a2cf83db85f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74c7ba0c1c336636bb50429b514ed293, https://si.imgix.net/b03b9a69/uploads/origins/37b4b407-5a8b-4e6a-92c9-a2cf83db85f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2306623195e2d7dd0dbb0f1484d5448f 2x, https://si.imgix.net/b03b9a69/uploads/origins/37b4b407-5a8b-4e6a-92c9-a2cf83db85f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5ae153a66538f365ae073f5dc95c8d8 3x", "genre": "art", "nsfw": false, "body": "はじめまして！主にニコニコ静画でまぉー。さんのイラストを拝見しております。まぉー。さんの描かれるウマ娘が素敵ですのでぜひウマ娘のキャラでリクエストさせてください！人数の多いリクエストですがよろしければご一考ください！\n①キャラクター\n『ウマ娘プリティーダービー』の\n・カワカミプリンセス\n・ジェンティルドンナ\n・ヒシアケボノ\n・タイキシャトル\n②服装\n全員体操服\n③シチュエーション\nトレーナーにマッサージをしてあげるつもりの四人がベッドの横に立って待ち構えている。\nトレーナーの心境(これ本当にマッサージなんですか？)\n④構図\nトレーナーの一人称視点。前列にカワカミプリンセスとジェンティルドンナ。後列にタイキシャトルとヒシアケボノ。カワカミプリンセスがトレーナーに手を伸ばす。\n⑤表情\nカワカミプリンセスとタイキシャトルは爆発するようなスマイル。ジェンティルドンナとヒシアケボノは柔らかめのスマイル。\n\n以上です！どうかよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/25", "thumbnail_src": "https://si.imgix.net/1c27e7a4/uploads/origins/18353fd3-f981-4c9c-8556-d2c650ed3fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a2c4adb0e4572d8ad8b2e11890c9cd5", "thumbnail_srcset": "https://si.imgix.net/1c27e7a4/uploads/origins/18353fd3-f981-4c9c-8556-d2c650ed3fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a2c4adb0e4572d8ad8b2e11890c9cd5, https://si.imgix.net/1c27e7a4/uploads/origins/18353fd3-f981-4c9c-8556-d2c650ed3fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24f1b96620eee3f046bcbbec44da4b88 2x, https://si.imgix.net/1c27e7a4/uploads/origins/18353fd3-f981-4c9c-8556-d2c650ed3fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f81ecb0582b95c8130df967912cd214 3x", "genre": "art", "nsfw": false, "body": "初めてお世話になります。今回、まぉー。さんにお願いしたいのは水着のビワハヤヒデ(ウマ娘)です。\n\n水着は眼帯ビキニで色は黒。表情はジト目\n眼帯ビキニ(参考：https://skeb.jp/@MonteMasa/works/5)\n描写範囲は膝上まで\n背景は白。ポーズはお任せします。\n\n以上ですが、何卒ご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/24", "thumbnail_src": "https://si.imgix.net/b2315cec/uploads/origins/8a0db62c-4fb3-40d3-be46-32437fe833e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d1de8e51d6804897bc5e97621bd81e5", "thumbnail_srcset": "https://si.imgix.net/b2315cec/uploads/origins/8a0db62c-4fb3-40d3-be46-32437fe833e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d1de8e51d6804897bc5e97621bd81e5, https://si.imgix.net/b2315cec/uploads/origins/8a0db62c-4fb3-40d3-be46-32437fe833e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd282ca6b598ec202b3179fd6a7b5d39 2x, https://si.imgix.net/b2315cec/uploads/origins/8a0db62c-4fb3-40d3-be46-32437fe833e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37751613988ddfac77b4941c911bd78a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/23", "thumbnail_src": "https://si.imgix.net/aca2babf/uploads/origins/74c1f6ad-b727-4f4a-8447-7f3bf5eb34fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905ac876ce6a2f1948765af0edc683f9", "thumbnail_srcset": "https://si.imgix.net/aca2babf/uploads/origins/74c1f6ad-b727-4f4a-8447-7f3bf5eb34fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905ac876ce6a2f1948765af0edc683f9, https://si.imgix.net/aca2babf/uploads/origins/74c1f6ad-b727-4f4a-8447-7f3bf5eb34fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14db7f88fe77c16d7db6b146a4b6ae07 2x, https://si.imgix.net/aca2babf/uploads/origins/74c1f6ad-b727-4f4a-8447-7f3bf5eb34fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=249cce07c1abb1c7cafdca6e33d38bdd 3x", "genre": "art", "nsfw": false, "body": "初めまして\n今回お願いしたいのは、ウマ娘で私の推しのカワカミプリンセスに大好きなアニメの戦記絶唱シンフォギアの主人公、立花響が纏うシンフォギア『ガングニール』を装着したイラストを描いていただきたいです。\n\nとても躍動感あるかわいいカワカミのイラストを描いてくれるまぉー。さんに是非ともお願いしたく思います。", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/22", "thumbnail_src": "https://si.imgix.net/a8651320/uploads/origins/827271a2-065c-441a-87dc-a5cc7d21680e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24d0523ed47e8c8813334c121cf2e16", "thumbnail_srcset": "https://si.imgix.net/a8651320/uploads/origins/827271a2-065c-441a-87dc-a5cc7d21680e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24d0523ed47e8c8813334c121cf2e16, https://si.imgix.net/a8651320/uploads/origins/827271a2-065c-441a-87dc-a5cc7d21680e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a7f1ca2409e6bd0147133704f745341 2x, https://si.imgix.net/a8651320/uploads/origins/827271a2-065c-441a-87dc-a5cc7d21680e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5982cb9fa7a0beef1d3394a3143df18 3x", "genre": "art", "nsfw": false, "body": "可能であれば。ダイワスカーレット(ウマ娘)が、何かのお仕置きでくすぐられて、笑い悶えているイラストをお願い出来ますでしょうか。服装はお任せします。\n\n以上、ご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@maou_fuu/works/21", "thumbnail_src": "https://si.imgix.net/6158b671/uploads/origins/934ce31f-f908-469b-8aff-2523dd8c1a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83efbaf18efa472f5596d8ee00cb430", "thumbnail_srcset": "https://si.imgix.net/6158b671/uploads/origins/934ce31f-f908-469b-8aff-2523dd8c1a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83efbaf18efa472f5596d8ee00cb430, https://si.imgix.net/6158b671/uploads/origins/934ce31f-f908-469b-8aff-2523dd8c1a3f?bg=%23fff&auto=format%2Ccompress&