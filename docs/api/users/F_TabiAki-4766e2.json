0426bbb/uploads/origins/7e7f12dd-0b58-4201-abc0-edf5e3faecc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1985673534e4fbd2cd45bfd447e040e2", "thumbnail_srcset": "https://si.imgix.net/90426bbb/uploads/origins/7e7f12dd-0b58-4201-abc0-edf5e3faecc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1985673534e4fbd2cd45bfd447e040e2, https://si.imgix.net/90426bbb/uploads/origins/7e7f12dd-0b58-4201-abc0-edf5e3faecc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14653666f8ca9b8b269dd1507f71605a 2x, https://si.imgix.net/90426bbb/uploads/origins/7e7f12dd-0b58-4201-abc0-edf5e3faecc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ecf64592bde1baac65e2b554932175e 3x", "genre": "art", "nsfw": true, "body": "全裸で足袋だけのきりたんが蹲踞しているイラストをお願いできますでしょうか？\n背後からの構図で、きりたんは片手で肛門の辺りを隠しつつ、振り返ってこちらを意地悪そうな笑顔でみている感じでお願いします。足先に関しては、つま先だけ地面につけているような感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@F_TabiAki/works/1", "thumbnail_src": "https://si.imgix.net/d2182d06/uploads/origins/d0d94e36-4264-41d3-81a7-33521432b885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e6cfdbf636cfaebcb248e65c7d11b2d", "thumbnail_srcset": "https://si.imgix.net/d2182d06/uploads/origins/d0d94e36-4264-41d3-81a7-33521432b885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e6cfdbf636cfaebcb248e65c7d11b2d, https://si.imgix.net/d2182d06/uploads/origins/d0d94e36-4264-41d3-81a7-33521432b885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e44f53b8bd1fa679b556b949454c3a3 2x, https://si.imgix.net/d2182d06/uploads/origins/d0d94e36-4264-41d3-81a7-3352143