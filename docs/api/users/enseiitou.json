FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=658a1078e4c0b67cf33ef2aaed3ac3cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@enseiitou/works/35", "thumbnail_src": "https://si.imgix.net/c00526a3/uploads/origins/1c4cdafe-d853-4418-a2ce-18a4d29b1592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=679b5e49758b12af4d49b26847841d89", "thumbnail_srcset": "https://si.imgix.net/c00526a3/uploads/origins/1c4cdafe-d853-4418-a2ce-18a4d29b1592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=679b5e49758b12af4d49b26847841d89, https://si.imgix.net/c00526a3/uploads/origins/1c4cdafe-d853-4418-a2ce-18a4d29b1592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0aaa5d85c68fb3d930f7db1c15df771 2x, https://si.imgix.net/c00526a3/uploads/origins/1c4cdafe-d853-4418-a2ce-18a4d29b1592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8efb78c0e29daa1effd25b8ba87f001 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@enseiitou/works/34", "thumbnail_src": "https://si.imgix.net/7d812610/uploads/origins/2519cbda-b5eb-4968-ba9c-73627948ff04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fed2aaaa012a0afac05be3a313517a3a", "thumbnail_srcset": "https://si.imgix.net/7d812610/uploads/origins/2519cbda-b5eb-4968-ba9c-73627948ff04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&