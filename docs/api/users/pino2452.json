84e5-f1c95addd8e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6adb4a3909e41d3ff6282c5e97be63c7", "thumbnail_srcset": "https://si.imgix.net/062ff184/uploads/origins/f4333412-ef60-4b57-84e5-f1c95addd8e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6adb4a3909e41d3ff6282c5e97be63c7, https://si.imgix.net/062ff184/uploads/origins/f4333412-ef60-4b57-84e5-f1c95addd8e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5760c62aed91e9fb7660478f9dbeb439 2x, https://si.imgix.net/062ff184/uploads/origins/f4333412-ef60-4b57-84e5-f1c95addd8e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bee82e736973bbca091171cdae5b3dfe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルが大好きです！私のVTuberモデルのBonesyを描いてもらえたら嬉しいです！\n\n私のVTuberモデル、Bonesyを描いてもらえたら嬉しいです！彼女は軽薄で、ギラギラしていて、生意気な悪魔です。https://skeb.jp/@pino2452/works/15 このポーズが大好きです。\n\nその他は全てお任せします！ありがとう！\n\nhttps://imgur.com/gallery/bonesy-references-C1SmoV1\n\nhttps://imgur.com/gallery/bonesy-references-C1SmoV1", "created_at": "", "completed_at": ""}, {"path": "/@pino2452/works/29", "thumbnail_src": "https://si.imgix.net/5e8a402b/uploads/origins/5beebee4-402e-49ce-adfd-0e370f2849fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d753db5ad443bddda9637c3ab1e212d2", "thumbnail_srcset": "https://si.imgix.net/5e8a402b/uploads/origins/5beebee4-402e-49ce-adfd-0e370f2849fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d753db5ad443bddda9637c3ab1e212d2, https://si.imgix.net/5e8a402b/uploads/origins/5beebee4-402e-49ce-adfd-0e370f2849fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14144880eccd1da27bcd369a4584336e 2x, https://si.imgix.net/5e8a402b/uploads/origins/5beebee4-402e-49ce-adfd-0e370f2849fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dfe3a2b8ca4b1ff0c7a82b76783a96d 3x", "genre": "art", "nsfw": false, "