{"screen_name": "AsahiAsada", "file": "AsahiAsada-f795c3", "name": "あさだあさひ", "avatar_url": "https://pbs.twimg.com/profile_images/1457296593552818176/2WP55L8P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1394177592530411524/1632590275/1500x500", "description": "illustrator / Skeb: http://skeb.jp/@AsahiAsada / Mail: asada9d@gmail.com / 朝田旭", "total_works": 18, "scraped_works": 18, "first_seen": "2026-03-20T08:42:35.157238+00:00", "last_updated": "2026-03-20T08:42:35.157238+00:00", "price_history": {"art": [{"amount": 20000, "recorded_at": "2026-03-20T08:42:35.157238+00:00"}]}, "current_prices": {"art": 20000}, "price_range": {"art": {"min": 20000, "max": 20000}}, "links": [{"label": "Twitter", "url": "https://x.com/AsahiAsada", "name": "AsahiAsada"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/70497539", "name": "70497539"}], "flags": {}, "acceptable": true, "works": [{"path": "/@AsahiAsada/works/18", "thumbnail_src": "https://si.imgix.net/3cdaad63/uploads/origins/c81ba55a-9259-4286-839d-5862853282fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28ef3afd9000dd8c343d85c9fdb2dad7", "thumbnail_srcset": "https://si.imgix.net/3cdaad63/uploads/origins/c81ba55a-9259-4286-839d-5862853282fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28ef3afd9000dd8c343d85c9fdb2dad7, https://si.imgix.net/3cdaad63/uploads/origins/c81ba55a-9259-4286-839d-5862853282fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ff150401edcef52882ebef21f9a7f3d 2x, https://si.imgix.net/3cdaad63/uploads/origins/c81ba55a-9259-4286-839d-5862853282fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0192328c8ddad6dd424e548a9bf73ad8 3x", "genre": "art", "nsfw": false, "body": "水着姿の女の子をお願いします。\n水着の上にパーカーを羽織らせてください。", "created_at": "", "completed_at": ""}, {"path": "/@AsahiAsada/works/17", "thumbnail_src": "https://si.imgix.net/79580a4e/uploads/origins/fc7f894d-0d39-493b-8e08-b8