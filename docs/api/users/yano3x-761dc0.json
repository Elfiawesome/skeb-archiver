62f9-7c8e-4869-be81-5d3d2a55bbf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01089e2981e5dbf4532b957b98dd3b3a 2x, https://si.imgix.net/6ddfe751/uploads/origins/a25c62f9-7c8e-4869-be81-5d3d2a55bbf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=912d00751d0a31d1497d0de25a857b04 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品を見て、ぜひ依頼したいと思いました！\n\nキャラクターはハイエネルギーな錬金術師の猫耳娘です。瞳は紫がかった色。腰までの紫髪は根元から明るいピンクへとグラデーションし、後ろで三つ編みに結われています。髪にはフォルティッシモのヘアクリップをアクセサリーとして付け、眼鏡も着用。耳は4つあり、2つは猫耳、残り2つは人間の耳で髪に隠れています。\n\nあなたのスタイルで描いていただけると嬉しいです！背景あり・なしの両方と.psdファイルをお願いします！今後、配信/サムネイル/グッズに使用します！ご依頼ありがとうございます！https://drive.google.com/drive/folders/13c7_pOQ3aGISEfBsi7DNbmNyTEcc6BlX?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yano3x/works/7", "thumbnail_src": "https://si.imgix.net/a4414d26/uploads/origins/c9e93c46-7741-4582-8c97-752d220c9568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6d2f449fb6efca3432daeab78c2b690", "thumbnail_srcset": "https://si.imgix.net/a4414d26/uploads/origins/c9e93c46-7741-4582-8c97-752d220c9568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6d2f449fb6efca3432daeab78c2b690, https://si.imgix.net/a4414d26/uploads/origins/c9e93c46-7741-4582-8c97-752d220c9568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db20db42265546d884051430ec346bec 2x, https://si.imgix.net/a4414d26/uploads/origins/c9e93c46-7741-4582-8c97-752d220c9568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a3ef58f21ba364a4e1638bc1155c1fc 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのイラストはとても可愛いです♡ 可能であれば、私のキャラクター「リョウ」のイラストを描いていただけませんか？彼はクールでエキサイティングなバンドのボーカルです！明るい性格ですが、照れ屋な一面もあります。あなたが描いて楽しいと思う方法で描いていただけると嬉しいです！また、彼は片方の牙と目の下に二つのほくろがあります。将来サムネイル作成に使用するかもしれません。\n\nご検討いただきありがとうございます！https://drive.google.com/drive/folders/1yEvdxGIjQDcSo6elaX6gBMYpHSXb5Otk", "created_at": "", "completed_at": ""}, {"path": "/@yano3x/works/6", "thumbnail_src": "https://si.imgix.net/d4676d23/uploads/origins/270ec635-3853-4ae2-be72-667dc939f314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39927d3ab135f90f79f88ec0ecb28f4f", "thumbnail_srcset": "https://si.imgix.net/d4676d23/uploads/origins/270ec635-3853-4ae2-be72-667dc939f314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39927d3ab135f90f79f88ec0ecb28f4f, https://si.imgix.net/d4676d23/uploads/origins/270ec635-3853-4ae2-be72-667dc939f314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c10a338ab09b1a7910c8047a0acdf5f1 2x, https://si.imgix.net/d4676d23/uploads/origins/270ec635-3853-4ae2-be72-667dc939f314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc0042f40c4157cbe27ca453ace04329 3x", "genre": "art", "nsfw": false, "body": "Good day.\n\nI would like to request art for a Vtuber I follow in your art style.\nHer name is Collie Woolchaser\n\nCHARACTER DETAILS\n- Is a Border Collie girl (dog girl)\n- Gyaru style outfit\n- 5'4 Height \n- likes: conventions, spicy foods, Tea and biscuits, western comics\n- Loves: tennis balls to play fetch with.\n- Mascot of \"VExpo\" A UK Convention for vtubers\n\n\nthis will be used to show fan art and on X/Twitter\n\nI hope you will consider my request!\nThank you\n\nhttps://drive.google.com/drive/folders/1yyPJWKgsCET_zRwod8TKbgC6C8XKTzEh?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yano3x/works/5", "thumbnail_src": "https://si.imgix.net/d7bebf4a/uploads/origins/f5107727-1e54-4bc5-bdfa-defd8805bdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=306677e58a73278568069966f87f14a5", "thumbnail_srcset": "https://si.imgix.net/d7bebf4a/uploads/origins/f5107727-1e54-4bc5-bdfa-defd8805bdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=306677e58a73278568069966f87f14a5, https://si.imgix.net/d7bebf4a/uploads/origins/f5107727-1e54-4bc5-bdfa-defd8805bdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7aa3cad63717b301f6101852c5c10e6 2x, https://si.imgix.net/d7bebf4a/uploads/origins/f5107727-1e54-4bc5-bdfa-defd8805bdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbd854fdbffbb5972390cb3d4bb111f0 3x", "genre": "art", "nsfw": false, "body": "🐧様\n\n🐧様、はじめまして。\n偶然お見掛けしたミニキャラが可愛く、是非自陣を描いていただきたい！と思いましたのでリクエスト送らせていただきました🌸\n\nお願いしたいのはCoCTRPG「cRocK」の自陣PC達です。\n秘匿HOありシナリオのためネタバレなしの情報を以下に載せさせていただきます。\n\nHO1：放埒なロバ\n名前：藺月 理玖 (いづき りく)\n男/169cm/24歳\n性格：のんびりしていてたまに抜けているところがある。HO2のことをすぐ自慢する。\n\nHO2：落ちぶれたイヌ\n名前：幽天（ゆうてん）\n男/180∼185cm/26歳\n性格：しっかり者の苦労人。HO1を支える立場ということもあって常に傍にいる。\n特記：左腕がないです。\n\nHO3：老いぼれたネコ\n名前：多々良 弦（たたら ゆずる）\n男/193㎝/25歳\n性格：飄々としていて気まぐれな猫に近い。HO4のことを揶揄って遊ぶことがあるが、なんだかんだ気にかけている。\n特記：目は見辛いですが赤色の瞳をしています。\n\nHO4：後がないニワトリ\n名前：Liberty Peakes （リバティ ピークス）\n女/150㎝/22歳\n性格：ちょこまかとよく動き、元気で負けず嫌い。ちょろくて情にアツい。HO3によく突っかかる。\n\nもし余裕があれば、こちらのシナリオでお世話になっているKPさんの概念が黒猫なのでちょこんと描いていただけると嬉しいです🐈✨\n\n■関係性\nみんな同じマフィアに所属しており、その中でも同じ派閥にいる仲間になります。\nのんびりバーで話したりとアングラな世界に足を突っ込みながらも穏やかな関係値を作っている。\nHO1HO2、HO3HO4で行動することが多いですが、HO1HO4やHO2HO3で動くことも。\n\n■構図\nお好きに描いていただいて構いません！\n衣装などの簡略化やオリジナルなども気にしませんので、楽しく描いていただけますと幸いです。\n\n使用用途：鑑賞、身内用グッズ作成、SNSのアイコン、ヘッダーや壁紙に使用する予定です。\n\n何か不都合があったり、金額不足でしたら遠慮なく再送していただければ対応させたいただきたいと思っております。お忙しいところ恐縮ですが、よければご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1DVSIx05eDQc9d_SexFOI8FXhEaZifmOR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yano3x/works/4", "thumbnail_src": "https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f82b6785738a5d08eba7d31c7262b6eb", "thumbnail_srcset": "https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f82b6785738a5d08eba7d31c7262b6eb, https://si.imgix.net/b5897846/uploads/origins/37