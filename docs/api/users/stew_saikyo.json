gins/56286268-7b74-41cb-965a-52c53ee89901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee113d648407c0d54eb1975b3d4001f5", "thumbnail_srcset": "https://si.imgix.net/72e6a5e9/uploads/origins/56286268-7b74-41cb-965a-52c53ee89901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee113d648407c0d54eb1975b3d4001f5, https://si.imgix.net/72e6a5e9/uploads/origins/56286268-7b74-41cb-965a-52c53ee89901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f1b07c428f400d80520f04e4f909689 2x, https://si.imgix.net/72e6a5e9/uploads/origins/56286268-7b74-41cb-965a-52c53ee89901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=869284f6c13c18dba50482f301254e2b 3x", "genre": "art", "nsfw": false, "body": "Hello!\n\nThank you for reading my request!\nI'm sorry if it is sudden!\n\nI would like to request for you to draw my Vtuber Berry!\nShe is a fun-loving octopus girl.\nI love your adorable and squishy chibi style!\nIt is adorable!\n\nThank you so much!\nIf you cannot fulfill the request, that is ok!\nI appreciate your hard work!\n\nhttps://drive.google.com/drive/folders/14ss4mN_Fd5zo7EL5XjPbEbfqyvrV7OzR?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@stew_saikyo/works/43", "thumbnail_src": "https://si.imgix.net/de3e1c3c/uploads/origins/5b0924eb-2e45-4fa4-a2fd-639a6c0adfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12958c3dc1dc4f124a59ec0dc95cde2c", "thumbnail_srcset": "https://si.imgix.net/de3e1c3c/uploads/origins/5b0924eb-2e45-4fa4-a2fd-639a6c0adfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12958c3dc1dc4f124a59ec0dc95cde2c, https://si.imgix.net/de3e1c3c/uploads/origins/5b0924eb-2e45-4fa4-a2fd-639a6c0adfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e709efe9db185ec9cea974992dcccae1 2x, https://si.imgix.net/de3e1c3c/uploads/origins/5b0924eb-2e45-4fa4-a2fd-639a6c0adfa9?