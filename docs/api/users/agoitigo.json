=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d37067d7024e4f8f25eb41f1b9c4969, https://si.imgix.net/c809438c/uploads/origins/0854a843-6bb1-4738-abe9-2de0c3ad7418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a2a84da13bcfdd2ad0f542224eeaa89 2x, https://si.imgix.net/c809438c/uploads/origins/0854a843-6bb1-4738-abe9-2de0c3ad7418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d417c910eed727056b384261fa4434cf 3x", "genre": "art", "nsfw": true, "body": "顎苺さん\n\nこんにちは、しずねゆきです。\nいつもSkebありがとうございます！またリクエストしてもよろしいでしょうか？\n\n【作品】\nけものフレンズ３\n\n【キャラクター】\n・シロナガスクジラママ\n\n【お題】\nまたお願いしてみたシリーズの続編で、シロナガスママにお願いしてみたバージョンをお願いできないでしょうか！(ついに禁断のシロナガスママ)。フレンズ服をたくしあげて、おパンティとブラを見せてくれるママをお願いします！\n\n【設定、シチュエーションなど】\n・ママの表情、反応などおまかせします。\n・下着ふぇちなもので、下着のデザインについてはフレンズをイメージしたデザインにこだわったものにして頂けると嬉しいです！\n・その他、構図、背景ありなし等もおまかせします。\n\n【納品について】\n・可能であれば完成イラストの原寸PSDデータをご提供頂けないでしょうか。レイヤー統合前を希望しますが、もしNGであればレイヤー統合後でかまいませんのでよろしくお願いします。\n\n毎度Skebをお願いして恐縮ですが、今回もどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/10", "thumbnail_src": "https://si.imgix.net/541e7879/uploads/origins/1be105f0-1b40-4741-8900-0795367c0121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21512b5bed765489a9d1d72941231125", "thumbnail_srcset": "https://si.imgix.net/541e7879/uploads/origins/1be105f0-1b40-4741-8900-0795367c0121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21512b5bed765489a9d1d72941231125, https://si.imgix.net/541e7879/uploads/origins/1be105f0-1b40-4741-8900-0795367c0121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cac5669d611bf201c226e1358eb6d9a 2x, https://si.imgix.net/541e7879/uploads/origins/1be105f0-1b40-4741-8900-0795367c0121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=270e6e1bc6d204579d542840a30f583e 3x", "genre": "art", "nsfw": true, "body": "顎苺さん\n\nこんばんは、しずねゆきです。\nいつもSkebをお受けくださりありがとうございます！またリクエストしてもよろしいでしょうか？\n\n【作品】\nけものフレンズ３\n\n【キャラクター】\n・シナウスイロイルカちゃん\n\n【お題】\nまたお願いしてみたシリーズで、ナルカちゃんにお願いしてみたバージョンをお願いできないでしょうか。フレンズ服をたくしあげて、おパンティとブラを見せてくれるナルカちゃんをお願いできればと思います。\n\n【設定、シチュエーションなど】\n・ナルカちゃんの反応、表情はおまかせします！\n・下着について、かわいいナルカちゃんらしく、白いフリフリ付きで淡いピンク色のかわいいデザインでお願いできないでしょうか。(下着ふぇちなものでよろしくお願いします)\n・その他の、構図、背景ありなし等はお任せします。\n\n【納品について】\n・もし可能であれば完成イラストの原寸PSDデータをご提供頂けないでしょうか。レイヤー統合前を希望しますが、もしNGであればレイヤー統合後でかまいませんのでよろしくお願いします。\n\nいつも細かい指定をして恐縮ですが、どうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/9", "thumbnail_src": "https://si.imgix.net/b872e998/uploads/origins/a157662c-7cd4-4602-b988-c90cb495e028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df64f8a37fc9bc546f904321d2c99b3", "thumbnail_srcset": "https://si.imgix.net/b872e998/uploads/origins/a157662c-7cd4-4602-b988-c90cb495e028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df64f8a37fc9bc546f904321d2c99b3, https://si.imgix.net/b872e998/uploads/origins/a157662c-7cd4-4602-b988-c90cb495e028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4062efd9d07d746df03818ca6bc34491 2x, https://si.imgix.net/b872e998/uploads/origins/a157662c-7cd4-4602-b988-c90cb495e028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1b9937b1637e7ed963927d7b08510ec 3x", "genre": "art", "nsfw": true, "body": "ドルカちゃんにお願いしましたシリーズが刺さりまくったのでリクエストします！\n\nシリーズの趣旨からは離れるんですが、フレンズ衣装のドルカちゃんが服の上から片手でちっぱいをこねながらもう片方でパンツをずらして指入れオナニーするNSFWイラストをお願いしたいです。\n構図としては以前うpされていたM字開脚でくぱぁしてくれるイラストに似た感じでお願いします。\n絶頂差分があるとなお捗ります！\n\n不躾なリクで恐縮ですが何卒・・・", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/8", "thumbnail_src": "https://si.imgix.net/bdce78a0/uploads/origins/23c184f1-480f-4cd9-ab4b-7c1a8618e2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3ae147fc3e5d88e49603d00fb3ee342", "thumbnail_srcset": "https://si.imgix.net/bdce78a0/uploads/origins/23c184f1-480f-4cd9-ab4b-7c1a8618e2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3ae147fc3e5d88e49603d00fb3ee342, https://si.imgix.net/bdce78a0/uploads/origins/23c184f1-480f-4cd9-ab4b-7c1a8618e2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e39e3521f8900d1dc7e0d1417344e7f 2x, https://si.imgix.net/bdce78a0/uploads/origins/23c184f1-480f-4cd9-ab4b-7c1a8618e2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65a446af3f2e96135a5a669c521b5558 3x", "genre": "art", "nsfw": true, "body": "顎苺さん\n\nこんばんは、しずねゆきです。\n先日はSkebありがとうございました！またリクエストしてもよろしいでしょうか？\n\n【作品】\nけものフレンズ(けもフレ３)\n\n【キャラクター】\n・マイルカちゃん\n\n【お題】\nまたドルカちゃんにお願いしてみたシリーズの発展で、マイルカちゃんにお願いしてみたバージョンをお願いできないでしょうか。フレンズ服をたくしあげて、おパンティとブラを見せてくれるマイルカちゃんをお願いできればと思います。\n\n【設定、シチュエーションなど】\n・無知シチュでお願いします。\n・下着の色について、けもフレ３のようにサテン調のテカテカで蛍光水色にして頂けると嬉しいです。(お子さまらしからぬテカテカ蛍光色下着というギャップ！)\n・その他の、構図、背景ありなし等はお任せします。\n\n【納品について】\n・もし可能であれば完成イラストの原寸PSDデータをご提供頂けないでしょうか。レイヤー統合前を希望しますが、もしNGであればレイヤー統合後でかまいませんのでよろしくお願いします。\n\nいつも細かい指定をお願いしてしまい恐縮ですが、どうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/7", "thumbnail_src": "https://si.imgix.net/a8b39a2d/uploads/origins/ec80cc2e-ec81-4bf5-ac6b-eba1f423d653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dc5118612eea49b5b0e33e0c7438840", "thumbnail_srcset": "https://si.imgix.net/a8b39a2d/uploads/origins/ec80cc2e-ec81-4bf5-ac6b-eba1f423d653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dc5118612eea49b5b0e33e0c7438840, https://si.imgix.net/a8b39a2d/uploads/origins/ec80cc2e-ec81-4bf5-ac6b-eba1f423d653?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd9b202bf7964b6bc7a0d8b1224e31b5 2x, https://si.imgix.net/a8b39a2d/uploads/origins/ec80cc2e-ec81-4bf5-ac6b-eba1f423d653?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a6dd649e09d6a98846ab642734c18f7 3x", "genre": "art", "nsfw": true, "body": "前回はおでかけ服ギンギツネのイラストをありがとうございました！下着の質感を始め涙を浮かべた表情や口元の描写も細かくて素晴らしかったです！今回もおでかけ服ギンギツネをお願いします。\nシチュエーションとしましては前回のその後的な感じでぐったりしているギンギツネの背後からモブ男（単色、人型セルリアンでも可）に胸を揉まれていてください\n服装は前回の時よりも更に破れておりスカートはかなり短くパンモロ状態になっていて、ブラウスも派手に破かれて片方のブラをずらされ、露出した状態で揉まれもう片方はブラの上から胸を揉まれていてください\n表情も力無く涙が頬を伝って流れてクタっとしてる感じでお願いします\n前回描いていただいた顎苺さんの繊細な描写が素晴らしかったので、両足共に裸足になって足指や足爪の見えるポーズでお願いします（座り、立ちかは描きやすいようおまかせします）\nもし可能であれば痛がっている、気持ちよくなっている等の揉まれている時の表情の差分があれば嬉しいです\nhttps://twitter.com/not_beaver/status/1724379767854809420?t=uSaiMOhj8SU4GDmjrz8mjw&s=19\nhttps://twitter.com/not_beaver/status/1338412511121444867?t=566YqPtMst7dlWEIdHgWmw&s=19\n是非ともご検討のほど、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/6", "thumbnail_src": "https://si.imgix.net/d8b5cf86/uploads/origins/365e8dea-2b4f-42f3-811e-5f863fc8837c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6158cfb0c473047b6c087b7abe3da90", "thumbnail_srcset": "https://si.imgix.net/d8b5cf86/uploads/origins/365e8dea-2b4f-42f3-811e-5f863fc8837c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6158cfb0c473047b6c087b7abe3da90, https://si.imgix.net/d8b5cf86/uploads/origins/365e8dea-2b4f-42f3-811e-5f863fc8837c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cd0a58987edccc9272c894e86e6d0cf 2x, https://si.imgix.net/d8b5cf86/uploads/origins/365e8dea-2b4f-42f3-811e-5f863fc8837c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0ae7ae573484e3231ae471ec81caae8 3x", "genre": "art", "nsfw": true, "body": "顎苺さん\n\nこんばんは、初めまして、しずねゆきと申します。いつもイラスト楽しく拝見してます。Skebリクエストしてもよろしいでしょうか？\n\n【作品】\nけものフレンズ(けもフレ３)\n\n【キャラクター】\n・イッカクちゃん\n\n【お題】\nドルカちゃんにお願いしてみたシリーズのイッカクちゃん版をお願いできないでしょうか。恥ずかしがりながらワンピース(フレンズ服)をたくしあげて、おパンティとブラを見せてくれるイッカクちゃんをお願いします。\n\n【設定、シチュエーションなど】\n・下着デザインをイッカクちゃんの服装や模様をモチーフにしたデザインして頂けると嬉しいです。\n・その他の、構図、背景ありなし等はお任せします。\n\n【納品について】\n・もし可能であれば完成イラストの原寸PSDデータをご提供頂けないでしょうか。レイヤー統合前を希望しますが、もしNGであればレイヤー統合後でかまいませんのでよろしくお願いします。\n\nどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/5", "thumbnail_src": "https://si.imgix.net/c9162b20/uploads/origins/1fdd3564-6ab5-47a9-b99f-3891b9b99eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2243e768b3da78be1e1efe71f4b6949", "thumbnail_srcset": "https://si.imgix.net/c9162b20/uploads/origins/1fdd3564-6ab5-47a9-b99f-3891b9b99eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2243e768b3da78be1e1efe71f4b6949, https://si.imgix.net/c9162b20/uploads/origins/1fdd3564-6ab5-47a9-b99f-3891b9b99eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89bf1f32c239b17d7a2277026a23ddb8 2x, https://si.imgix.net/c9162b20/uploads/origins/1fdd3564-6ab5-47a9-b99f-3891b9b99eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45cc2ce0f9c10f8c534388faf671ed0d 3x", "genre": "art", "nsfw": true, "body": "初めまして‼️初めましてで初に失礼しますが…リクエスト致します‼️\n\n設定的にはドルカちゃんにお願いしましたシリーズの新バージョンで…\n\nフレンズ衣装で、困惑しながらも赤面で、見せつけてる様な感じでM字開脚でクパァを致してるドルカちゃんをお願い出来ますか??\n\nお忙しい中失礼しますがよろしくお願い致します(￣^￣ゞ💦", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/4", "thumbnail_src": "https://si.imgix.net/021211bd/uploads/origins/f39f3714-1510-41bd-9b9d-43954613cd13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c765e1cd83736db82064143c6e6ce9", "thumbnail_srcset": "https://si.imgix.net/021211bd/uploads/origins/f39f3714-1510-41bd-9b9d-43954613cd13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c765e1cd83736db82064143c6e6ce9, https://si.imgix.net/021211bd/uploads/origins/f39f3714-1510-41bd-9b9d-43954613cd13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df2664600001d432943b0b09fae69e4f 2x, https://si.imgix.net/021211bd/uploads/origins/f39f3714-1510-41bd-9b9d-43954613cd13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04fa251ccd52b4dbc4658ed7bee02d30 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nhttps://twitter.com/agoitigo/status/1618414812907851776 のイラストに触発され\n顎苺先生が描くはなまるチェンジ衣装姿のドールちゃんが見たいと思いリクエストを送りました\n\n発情期を迎えたドールが隊長を押し倒しスパッツ越しで顔面騎乗し擦り付けをするも気持ちよさで果ててしまうシチュエーション。\n乗る前は獲物を狩るメスの様、乗ったあとはとろけ気持ちよさそうにしている表情。\nスパッツは初めから秘部が濡れて染みがある状態。\n衣装ははなまるチェンジで指定しますが描いていただく過程で難しい場合は脱いだ状態でも構いません。\nスパッツは可能であれば脱ぎ差分があると嬉しいです。\nふとももは食い込みがあるやわからそうな程よく太い感じでお願いします。\n\nご検討いただけましたら幸いです\n何卒宜しくお願い致します\n\nhttps://twitter.com/kemono_friends3/status/1504322385188732935", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/3", "thumbnail_src": "https://si.imgix.net/23a1b00d/uploads/origins/3b43acc4-ad18-4a04-8b2d-6321102604d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ceadca6486b7ec2b06b5dc9cbd2b75", "thumbnail_srcset": "https://si.imgix.net/23a1b00d/uploads/origins/3b43acc4-ad18-4a04-8b2d-6321102604d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ceadca6486b7ec2b06b5dc9cbd2b75, https://si.imgix.net/23a1b00d/uploads/origins/3b43acc4-ad18-4a04-8b2d-6321102604d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c75987f471e2fa34c6c08f7a0e10a9c 2x, https://si.imgix.net/23a1b00d/uploads/origins/3b43acc4-ad18-4a04-8b2d-6321102604d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c445efee74c3ac3c470d9dd47ec95957 3x", "genre": "art", "nsfw": true, "body": "はじめまして！twitterに投稿されたイラストを拝見して依頼をさせて頂きました。\nリクエストなのですが、けものフレンズ3のはなまるチェンジ版おでかけ服ギンギツネをお願い致します。\nシチュエーションとしましては、モブ（単色や人型セルリアン等で簡略化しても大丈夫です）か触手セルリアンに手足や首を拘束されたおでギンの胸を乱暴に揉まれていてください（絞め落とされている感じではなく、少し苦しそうに涙目で嫌がっている感じでお願いします）。服装も所々破れていて胸元も片側だけ破れていてブラジャーが露出している状態で揉まれていて下さい。\nスカートも破れ、モブやセルリアンに足を揉まれていてパンツと生足が露出してヒールも脱げて裸足になっていて下さい（足指や足爪に気合いを入れて頂ければ幸いです…！）。\nおでかけ服ギンギツネの参考資料を貼っておきます\nhttps://twitter.com/ATK400DEF600/status/1472191958747840515?t=hxit-4qGgPapfaYkHvnNeg&s=19\nhttps://twitter.com/ATK400DEF600/status/1471246619983384577?t=zQDeQoSHHk2dFyOxpmoF8A&s=19\nhttps://twitter.com/ATK400DEF600/status/1628332161723154432?t=nrnRolKihgrWyZT-8ofEqQ&s=19\n長文失礼いたしました。よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@agoitigo/works/2", "thumbnail_src": "https://si.imgix.net/008800e9/uploads/origins/710358cd-b250-450b-9e3f-20b33d051a37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3105ab7094e680a96595ba61fb76d3f8", "thumbnail_srcset": "https://si.imgix.net/008800e9/uploads/origins/710358cd-b250-450b-9e3f-20b33d051a37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3105ab7094e680a96595ba61fb76d3f8, https://si.imgix.net/008800e9/uploads/origins/710358cd-b250-450b-9e3f-20b33d051a37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f954c606a03774a57730e7c793036464 2x, https://si.imgix.net/008800e9/uploads/origins/710358cd-b250-450b-9e3f-20b33d051a37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c310e6e649d58bf04342260e7bbf9da 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}