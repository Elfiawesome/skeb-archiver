074fd3/uploads/origins/a22c2197-a600-4dba-abea-07a203fb79f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057819567d40333f62e210208891c471", "thumbnail_srcset": "https://si.imgix.net/0f074fd3/uploads/origins/a22c2197-a600-4dba-abea-07a203fb79f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057819567d40333f62e210208891c471, https://si.imgix.net/0f074fd3/uploads/origins/a22c2197-a600-4dba-abea-07a203fb79f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a30adbd61ce3b736217ebd4e40f2f068 2x, https://si.imgix.net/0f074fd3/uploads/origins/a22c2197-a600-4dba-abea-07a203fb79f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17380ad1455365ca289c4bf1afb723b3 3x", "genre": "art", "nsfw": false, "body": "どうも竹千代さん！前回のリクエストのイラストのクオリティが良かったので、今回もリクエストを送ろうと思います！\n前回と同様に構図やポーズは自由に描いてくださっても構いません。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1IR8Qk1xhEWHy_0zLb8OSxVi5xUMBAxFo", "created_at": "", "completed_at": ""}, {"path": "/@Phyllosta_tiyo/works/8", "thumbnail_src": "https://si.imgix.net/baf1fe0e/uploads/origins/c6d0535f-76da-4de9-9278-a03c108baa01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce974fba76ee950d6287e4dac560bfab", "thumbnail_srcset": "https://si.imgix.net/baf1fe0e/uploads/origins/c6d0535f-76da-4de9-9278-a03c108baa01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce974fba76ee950d6287e4dac560bfab, https://si.imgix.net/baf1fe0e/uploads/origins/c6d0535f-76da-4de9-9278-a03c108baa01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3a001f12ed5e2e5738ed2936da9c722 2x, https://si.imgix.net/baf1fe0e/uploads/origins/c6d0535f-76da-4de9-9278-a03c108baa01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3621aa1da4a25e40be173e4088dbb22 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのかわいい絵がとても好きです。私のドラゴンの絵をリクエストしてもいいですか？かわいい表情でお願いします。ありがとうござ