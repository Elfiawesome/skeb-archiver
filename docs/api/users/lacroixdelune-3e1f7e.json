ad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94143b41f62255465fa4da567899a51e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/35", "thumbnail_src": "https://si.imgix.net/f9a3490d/uploads/origins/33a9f96b-3404-4210-9de6-73dff01b7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=749bd6b3ec9f11f0b5fe78dd3a48b504", "thumbnail_srcset": "https://si.imgix.net/f9a3490d/uploads/origins/33a9f96b-3404-4210-9de6-73dff01b7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=749bd6b3ec9f11f0b5fe78dd3a48b504, https://si.imgix.net/f9a3490d/uploads/origins/33a9f96b-3404-4210-9de6-73dff01b7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4646f3b2ce87c36d13c79368a99d2379 2x, https://si.imgix.net/f9a3490d/uploads/origins/33a9f96b-3404-4210-9de6-73dff01b7b73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d16fb2cd8d7da17f9de7214eb1a136 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/34", "thumbnail_src": "https://si.imgix.net/196d10f4/uploads/origins/9a6d0360-fb06-497b-8b2b-60f7a4b5dd37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f900111a829436f8fda4c750b4c84e6", "thumbnail_srcset": "https://si.imgix.net/196d10f4/uploads/origins/9a6d0360-fb06-497b-8b2b-60f7a4b5dd37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f900111a829436f8fda4c750b4c84e6, https://si.imgix.net/196d10f4/uploads/origins/9a6d0360-fb06-497b-8b2b-60f7a4b5dd37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=015aadd3448da05a86492b91d3f42b95 2x, https://si.imgix.net/196d10f4/uploads/origins/9a6d0360-fb06-497b-8b2b-60f7a4b5dd37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca96fad9af251c79bdf4728eb84a5bef 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/33", "thumbnail_src": "https://si.imgix.net/2bf50fba/uploads/origins/7f3c20b5-2cf3-4ac0-bb90-4a09fcc39eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ebca69ec2173de8de9e0a9910e66fb", "thumbnail_srcset": "https://si.imgix.net/2bf50fba/uploads/origins/7f3c20b5-2cf3-4ac0-bb90-4a09fcc39eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ebca69ec2173de8de9e0a9910e66fb, https://si.imgix.net/2bf50fba/uploads/origins/7f3c20b5-2cf3-4ac0-bb90-4a09fcc39eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=161f6d01d9d71611b6d37336740d7140 2x, https://si.imgix.net/2bf50fba/uploads/origins/7f3c20b5-2cf3-4ac0-bb90-4a09fcc39eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc8d265f021fd99320713587b9dfcb24 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。前回、リクエストを送りましたが、\nラクロワさんが苦悩していらっしゃった時期の\n最悪なタイミングで送ってしまい、物事が落ち着いて\n立ち直るまで申請をキャンセルしました。\n\nリクエストは過去送ったもの少しだけ弄ったものですが、\n今後はおまかせ金額を参照せず、15000を目安にします。\nとはいっても手数料CP無し、そして何かと苦労した時期の\n中での募集だったので、今回限りですが増額しておきました。\n\nーーーーーーーー\n\n◆キャラクター\nゲーム『アークナイツ』のW。\nhttps://arknights.wikiru.jp/index.php?plugin=attach&refer=W%28%A5%D7%A5%EC%A5%A4%A5%A2%A5%D6%A5%EB%29&openfile=W.png\nhttps://arknights.wikiru.jp/index.php?plugin=attach&refer=W%28%A5%D7%A5%EC%A5%A4%A5%A2%A5%D6%A5%EB%29&openfile=W%BE%BA%BF%CA.png\n\n◆内容：\n再三になりますが、前回依頼した”人工ゲル化チェン”の時と\n同じような”人工ゲル化”をお願いします。\n展開とシチュエーションも同じになります。\n\n今回は元のゲームには存在しない、\n【”緋色”カラーの人工ゲル化】を希望します。\n（Wが来ているスカート、ジャケットの内側の”赤色”と言えばわかりやすいかと思います）\n\n◆シチュエーション：\n彼女の経歴や性格から、”敵を作りやすい”彼女なので\n陵辱も激しいものを希望します。恨みつらみを\nオナホ化した彼女にぶつける感じです。\n\n背景：ゲーム内で登場したステージを参考程度に載せておきますが、\n面倒であれば省略して下さい。（適当な床で大丈夫です）\nhttps://arknights.wikiru.jp/index.php?plugin=attach&refer=img&openfile=ISW-NO_8.png\n\n◆差分\n基本絵（瞳有り、自我有り）：\n背後から犯されて（竿役は影のみで大丈夫です。何なら陰茎の影のみで大丈夫です）\n目を丸くしながら、殺意の感情むき出しで威喝している\n\n差分：\n両穴に口、乳首の穴、身体中を玩具のように使い潰され、\n先程の威勢とは異なり\n舌を突出させたオホ顔で硬直し、瞳が消える。\n前回同様に内部に溜まった汚濁を膨らんだ胸と口、\n穴から垂れ流してもらう以外に、\n可能であれば精液を外側に”ぶっかけ”て貰えれば嬉しいです。\n\nーーーーーーーーーーーー\n\nお手数をおかけしますが、どうか宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/32", "thumbnail_src": "https://si.imgix.net/600c3296/uploads/origins/b48c640a-12b0-4c94-b074-32e128556cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c82fffb3f29d035fa446e2e93cb331", "thumbnail_srcset": "https://si.imgix.net/600c3296/uploads/origins/b48c640a-12b0-4c94-b074-32e128556cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c82fffb3f29d035fa446e2e93cb331, https://si.imgix.net/600c3296/uploads/origins/b48c640a-12b0-4c94-b074-32e128556cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63cb2e710c88ff3986f0e6f65edb7814 2x, https://si.imgix.net/600c3296/uploads/origins/b48c640a-12b0-4c94-b074-32e128556cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24d91526a71fe64b9f9a62e1eea91547 3x", "genre": "art", "nsfw": true, "body": "はじめまして、的場無為と申します。\n\nこのたびはtwitterを拝見しまして、下記のイラストのキャラクター（霊能者のお姉さん）のオナホ化イラストをご依頼したく、お便り申しあげました次第です。\nhttps://twitter.com/matobamui/status/1485248733616869381?s=20&t=5TVBWETZU_hy0jQjpHImhQ\n前の方は下記のような、おでこを出したスタイルです。\nhttps://twitter.com/matobamui/status/1452244862648995842?s=20&t=5TVBWETZU_hy0jQjpHImhQ\n\nオナホは貫通式で色は紫寄りのピンク、シチュエーションは（大雑把で恐縮ですが）怪異によりあえなくオナホにされた雰囲気を出していただけると幸いです。\n表情は、使われてしまった後で、快楽に完全敗北し瞳が消え、穴という穴から液体が漏れ出てしまっている王道（？）パターンでお願いします。\nもし可能でしたら、瞳があって少し余裕がありそうな表情をしている、使われてしまう前（変化直後）のイラストもいただけるとありがたく存じます。\n\n背景等、細部はご一任申し上げます。\n以上、ご検討何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/31", "thumbnail_src": "https://si.imgix.net/74b69a60/uploads/origins/db290393-0da3-4fe3-bbc0-1b1891af0210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcd2baf20df0a1cc9630e02978327605", "thumbnail_srcset": "https://si.imgix.net/74b69a60/uploads/origins/db290393-0da3-4fe3-bbc0-1b1891af0210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcd2baf20df0a1cc9630e02978327605, https://si.imgix.net/74b69a60/uploads/origins/db290393-0da3-4fe3-bbc0-1b1891af0210?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f860bf19a505e0ca5700d42df8ee9798 2x, https://si.imgix.net/74b69a60/uploads/origins/db290393-0da3-4fe3-bbc0-1b1891af0210?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88f18f8b1683a9c955607261acce1b66 3x", "genre": "art", "nsfw": true, "body": "資料URL先のオリジナルキャラクターで、植物モンスターに取り込まれ、同化、植物化してしまうシチュエーションをリクエストしたいです。\n別の方のリクエスト(https://skeb.jp/@lacroixdelune/works/10)のように、\n・体内に入った蔓が口から伸び出ている\n・胸から蜜が溢れ出ている\nという内容は共通させてほしいです。\n\nhttps://www.dropbox.com/sh/08pqckwq99dib5p/AABwwWZIeLeBuchpB-2qqxcqa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/30", "thumbnail_src": "https://si.imgix.net/06bec0b0/uploads/origins/d4dcd21e-6214-482b-a374-36c2f461aeb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c59a44357feb34601afeaf58c9273a2", "thumbnail_srcset": "https://si.imgix.net/06bec0b0/uploads/origins/d4dcd21e-6214-482b-a374-36c2f461aeb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c59a44357feb34601afeaf58c9273a2, https://si.imgix.net/06bec0b0/uploads/origins/d4dcd21e-6214-482b-a374-36c2f461aeb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad333ffc00398ef5c53018bb8ffab053 2x, https://si.imgix.net/06bec0b0/uploads/origins/d4dcd21e-6214-482b-a374-36c2f461aeb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f44241f9b79893513e99aa1b4695427b 3x", "genre": "art", "nsfw": true, "body": "こちら（\nhttps://twitter.com/lacroixdelune/status/1361986011312443394）のようなイメージで、ＦＧＯの牛若丸が肉壁に取り込まれて同化されているシーンをお願いできますでしょうか。\n\nアニメ本編中では下記のような感じでしたが未遂に終わってしまいましたので「その先」という形で、紫色（赤黒？）の肉壁に取り込まれたイメージで。\nhttps://twitter.com/takohachibar1/status/1198252848338759681\nhttps://twitter.com/EmV8KVVRzzg3fvY/status/1198254032210419712\nhttps://twitter.com/graodakanri/status/1198253061178720257\n\n服は無し（裸）で構いません。口には何も入っていない・フリーで、表情はこちら（https://skeb.jp/@lacroixdelune/works/11）のような絶叫・絶望という感じでお願いできればと思います。\n可能でしたら事前（取り込まれる前・肌色）と紫色（同化された後）の２パターンをお願いできればと思いますが、予算的に見合わなければ事後だけで構いません。", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/29", "thumbnail_src": "https://si.imgix.net/fbca4cbb/uploads/origins/0521c2cb-5725-40dc-8afb-1bd23911c7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6e9e4d0d2cf7fd567072449514fe1b4", "thumbnail_srcset": "https://si.imgix.net/fbca4cbb/uploads/origins/0521c2cb-5725-40dc-8afb-1bd23911c7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6e9e4d0d2cf7fd567072449514fe1b4, https://si.imgix.net/fbca4cbb/uploads/origins/0521c2cb-5725-40dc-8afb-1bd23911c7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8a848b25e75d65a3c7955b442c4bdaf 2x, https://si.imgix.net/fbca4cbb/uploads/origins/0521c2cb-5725-40dc-8afb-1bd23911c7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a4b6fd6a88a6350d686a753573bd20b 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。募集再開、そしてSkebの手数料無料\nキャンペーンという事で、改めてラクロワさんに依頼を送ることにしました。\n内容は箱化+オナホ化になります。\n\n◆キャラクター\nゲーム『アークナイツ』のチェン。\nhttps://arknights.wikiru.jp/index.php?plugin=attach&refer=%A5%C1%A5%A7%A5%F3&openfile=%A5%C1%A5%A7%A5%F3.png\n\n◆簡単な設定\n敵の策にハマり、相手のアーツ能力で肉体を”人工ゲル”に変えられ、\n箱オナホとして犯される。\n…こういった内容です。\n\n補足:”人工ゲル”はゲーム内のキャラの強化素材で、ゲル状の\n物体の上下に金属のプレート、上部分に金属の円筒が貫通しているアイテムです\n（◇状のワイヤーは取手？）\n形状はこれです\nhttps://arknights.wikiru.jp/attach2/696D67_7067656C335F3178312E706E67.png\n（※上位素材に融合ゲルと言うのもありますが、参考資料としてこれも貼っておきます）\nhttps://arknights.wikiru.jp/attach2/696D67_7067656C345F3178312E706E67.png\n\n◆シチュエーション\n過去にラクロワさんが担当した箱オナホ化の依頼のように\nhttps://skeb.jp/@lacroixdelune/works/12\n全裸で胸と頭はそのままの状態で、残りの身体の部分を”人工ゲル”の\nゴテゴテした特徴を捉えた箱オナホ型に仕上げて下さい。\nカラーは恐らくクリアブルーだと思います。\n（円筒は横向きでお願いします。）\n\n背景は特にこだわりはありませんが、”何かの施設の内”感でお願いします。\n\n◆差分\n金額内で対応可能であれば、\nまだ自我が残ってあり反抗的な目付きで睨んでる、瞳有り＆使用前の\n基本絵に、希望差分として:\n\nオナホとして使い回され、口をだらしなく開いたアヘ顔の表情で固まり瞳が無くなる。\n口と後ろの穴から収まりきらない精液が零れ落ち、精液が溜まって一回り\n大きくなった胸の乳首からも汚濁が溢れ出してる感じの差分をお願いします。\n\nお手数をおかけしますが、どうか宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/28", "thumbnail_src": "https://si.imgix.net/3da72a6c/uploads/origins/d3961247-7896-4a49-aac1-2cb2b32967c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc2dde283ecdce34100774de96c60842", "thumbnail_srcset": "https://si.imgix.net/3da72a6c/uploads/origins/d3961247-7896-4a49-aac1-2cb2b32967c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc2dde283ecdce34100774de96c60842, https://si.imgix.net/3da72a6c/uploads/origins/d3961247-7896-4a49-aac1-2cb2b32967c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34ccc82cf2b4a00830fcb07d335a890b 2x, https://si.imgix.net/3da72a6c/uploads/origins/d3961247-7896-4a49-aac1-2cb2b32967c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a81c7e376b16bd7c9d915cbbaeac4c0b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/27", "thumbnail_src": "https://si.imgix.net/6c60a992/uploads/origins/650c4923-e21c-408d-be75-22f0a14e5611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7785427424cc9e80e9356e2e9c6790ed", "thumbnail_srcset": "https://si.imgix.net/6c60a992/uploads/origins/650c4923-e21c-408d-be75-22f0a14e5611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7785427424cc9e80e9356e2e9c6790ed, https://si.imgix.net/6c60a992/uploads/origins/650c4923-e21c-408d-be75-22f0a14e5611?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f83fc06e817fc03b2bc0e5470fea2ca 2x, https://si.imgix.net/6c60a992/uploads/origins/650c4923-e21c-408d-be75-22f0a14e5611?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a55f393466896e5da102da309ca97367 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/26", "thumbnail_src": "https://si.imgix.net/05db7e3a/uploads/origins/fed2c74d-f3ed-457b-a3da-2fc44f43fdd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9280a519d3318c6c81172119e2369e88", "thumbnail_srcset": "https://si.imgix.net/05db7e3a/uploads/origins/fed2c74d-f3ed-457b-a3da-2fc44f43fdd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9280a519d3318c6c81172119e2369e88, https://si.imgix.net/05db7e3a/uploads/origins/fed2c74d-f3ed-457b-a3da-2fc44f43fdd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba67f4afb8534ca10ac402c4b9f86d1e 2x, https://si.imgix.net/05db7e3a/uploads/origins/fed2c74d-f3ed-457b-a3da-2fc44f43fdd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4386dffa4f55a29c5d63d187568249a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/25", "thumbnail_src": "https://si.imgix.net/502c1f90/uploads/origins/b9161820-9cf4-4499-823b-e53cff7f3917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906f9f4f65a3e38b64d87cc0ab62f8a4", "thumbnail_srcset": "https://si.imgix.net/502c1f90/uploads/origins/b9161820-9cf4-4499-823b-e53cff7f3917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906f9f4f65a3e38b64d87cc0ab62f8a4, https://si.imgix.net/502c1f90/uploads/origins/b9161820-9cf4-4499-823b-e53cff7f3917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b572bc5ed4244b5436ab153321861b72 2x, https://si.imgix.net/502c1f90/uploads/origins/b9161820-9cf4-4499-823b-e53cff7f3917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9124ab6790dafbb96e10b68049be0708 3x", "genre": "art", "nsfw": true, "body": "ラクロワ様、いつもお世話になっております。\nskeb再開をずっと待っていたので、また機会があって嬉しいです。3度目の依頼で恐縮ですが、ラクロワ様の描くオナホ化が本当に好みでして、またリクエストさせてください。\n\n「Pokémon LEGENDS アルセウス」の「カイ(https://www.pokemon.co.jp/ex/legends_arceus/ja/character/211215_02/)」のオナホ化をお願いします。\n\n以下詳細です。\n・使用済みで捨てられており、苦しそうなアヘ顔で口などから精液が溢れている。\n・お腹には、精液だけでなくいくつものモンスターボールが詰められているのが透けて見えており、でこぼこしたボテ腹に。\n・下の穴からは、ドロっと粘る大量の精液とともに、卵を産むかのようにモンスターボールが出てきている。\n・もしも余力がありましたら使用前差分も見せてくださると、より無様さが際立ってありがたいです。抵抗するような表情でお願いします。\n・顔も身体も、お好きなだけ精液まみれにしちゃってください。\n\nどうかご検討をよろしくお願いします。\nゆっくりお待ちしています。", "created_at": "", "completed_at": ""}, {"path": "/@lacroixdelune/works/24", "thumbnail_src": "https://si.imgix.net/b57bcdb9/uploads/origins/962f2d7d-972a-424d-917a-133f2ed293bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ce739b95b29e78a5005ff2188568ed3", "thumbnail_srcset": "https://si.imgix.net/b57bcdb9/uploads/origins/962f2d7d-972a-424d-917a-133f2ed293bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ce739b95b29e78a5005ff2188568ed3, https://si.imgix.net/b57bcdb9/uploads/origins/962f2d7d-972a-424d-917a-133f2ed293bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adc4accae3d33686b6082e10b28d8174 2x, https://si.imgix.net/b57bcdb9/uploads/origins/962f2d7d-972a-424d-917a-133f2ed293bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec1424e06d1d9bad6a6c77f8c989bf4b 3x", "genre": "art", "nsfw": true, "body": "毎度素晴らしい状態変化絵をありがとうございます。\n募集再開とのことで早速依頼します！\n今回は石化をお願いしたいです。\n\n●キャラクター\n対魔忍うちの娘\nhttps://skeb.jp/@gomashio_ponz/works/6\n\n●かんたんなバックストーリー(参考程度にして頂ければと思います。)\n敵組織に捕まり犯され、孕み袋にされてしまった対魔忍。\n出産を繰り返したのちに用済みになり石化処理され、悪趣味な美術品として飾られてしまう。\n\n●シチュエーション\n石化&大量精液。\n・資料(小さいですが)のような、鎖にて腕&足を頭部の後ろで縛られ吊るされたポーズ。\n・全裸＋乳首ピアス＋ボテ腹でだらしない表情。\n・尻穴と膣から大量の精液が溢れ、垂れている。\n・美術品の説明のような感じで、女の子が捕まる前の写真が貼り付けられた立札もしくは看板を添えて頂きたいです。\n\n●その他\n精液ごと石化している差分をお願いしたいです。\n\n以上になります。\n何ぞと承認よろしくお願いします！\n\nhttps://taimanin-rpg.wikiru.jp/index.php?plugin=attach&refer=SR%2F%A5%A2%A5%F3%A5%EA%A1%BC%A5%C9%A1%A6%A5%DC%A5%CB%A1%BC&openfile=chr_0147_2a_r18.png", "created_at": "", "completed_at": ""}, {"path": 