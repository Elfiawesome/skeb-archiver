9-5506e44f11ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63bc7d49a7a2fc3ce06b29cdcc485c24", "thumbnail_srcset": "https://si.imgix.net/921e2748/uploads/origins/7d2f6901-b224-453f-ba49-5506e44f11ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63bc7d49a7a2fc3ce06b29cdcc485c24, https://si.imgix.net/921e2748/uploads/origins/7d2f6901-b224-453f-ba49-5506e44f11ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=598d356c9b0e73b0207ef2cf050facf1 2x, https://si.imgix.net/921e2748/uploads/origins/7d2f6901-b224-453f-ba49-5506e44f11ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5e95c4400715c83eb69aab1dba0f65e 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております！\n\n今回描いていただきたいのは「ぷよぷよ」シリーズに登場する「フェーリ」というキャラクターです。\nイラストの構図は基本おまかせしたいのですが、赤青黄緑紫ぷよ（ぷよは基本はこの5色です。）が登場して賑やかな感じにしてもらえると嬉しいです。\n\nまた、描いていただいたイラストはゲーム用のSNSアカウントのアイコンでの使用を考えています！\nもし良ければよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@illkoya/works/102", "thumbnail_src": "https://si.imgix.net/469901d0/uploads/origins/9722f2a4-068a-44e6-9baa-fbbc85dbd82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af4d4d43f5341fb27e7393fe6670c81", "thumbnail_srcset": "https://si.imgix.net/469901d0/uploads/origins/9722f2a4-068a-44e6-9baa-fbbc85dbd82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af4d4d43f5341fb27e7393fe6670c81, https://si.imgix.net/469901d0/uploads/origins/9722f2a4-068a-44e6-9baa-fbbc85dbd82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e841f4702f6c7dd9ce16cb5f1c462c5 2x, https://si.imgix.net/469901d0/uploads/origins/9722f2a4-068a-44e6-9baa-fbbc85dbd82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=706b4252210287dc1c818665277a72ca 3x", "genre": "art", "nsfw": false, "body": "こや様、いつもお世話になっております。\n先生の新サインがほしいのでリクエストをお送りいたします。\n\n『葬送のフリーレンのゼンゼのイラスト』\n\n●髪をモフモフに描いていた