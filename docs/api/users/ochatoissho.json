7-b825-09a09f06d7f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8693dee95c902b0edf625414a731119 2x, https://si.imgix.net/bbe2e646/uploads/origins/1f667eb2-5716-4f17-b825-09a09f06d7f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b559a027f4ef24755ae6372d7eec7baa 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品はとても素敵で、私のオリジナルキャラクターを描いていただけませんか？🎭 ヴェリタス（180cm）彼は美青年です。双子の妹「アレテア」が亡くなった後、母親は悲しみで正気を失いました。母親の精神状態を助けようと、彼はアレテアの身分を引き継ぎ、自身の正体を捨てたのです。 幼い頃から続けてきた偽りの姿で、真実を知る者はごくわずか。狡猾でからかい好き、警戒心が強いが、常に淑女にふさわしい優雅さを保っている。真実を知らぬ者には、美しく神秘的な女性として映る。妹の仮面を脱いだ時は、少しだけいたずら好きで遊び心のある一面を見せる。\n\n※唇の下にあるほくろにご注意ください必要に応じて、参照リンクにベリタスの詳細が記載されています！自由に描いてください！「ベリタス」として描くか「アレシア」として描くかは選択可能です。ポーズや構図はご自由に決めてください。別の衣装でも構いません。ご配慮ありがとうございます！お断りいただいても結構です。\n\nhttps://www.notion.so/omeurice/Veritas-Damaris-25f956154d7280cb985bf823590f8832?source=copy_link", "created_at": "", "completed_at": ""}, {"path": "/@ochatoissho/works/2", "thumbnail_src": "https://si.imgix.net/6a9fde11/uploads/origins/4e31b7ca-6016-4b0b-818f-693872b93fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02cbc687cf02737a72d97cdf05e1874d", "thumbnail_srcset": "https://si.imgix.net/6a9fde11/uploads/origins/4e31b7ca-6016-4b0b-818f-693872b93fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02cbc687cf02737a72d97cdf05e1874d, https://si.imgix.net/6a9fde11/uploads/origins/4e31b7ca-6016-4b0b-818f-693872b93fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8d168feb5d8fc95585eb0efa78a33f3 2x, https://si.imgix.net/6a9fde11/uploads/origins/4e31b7ca-6016-4b0b-818f-693872b93fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b48bcd251514d4bef1efbdda31c1427 3x", "genre": "art", "nsfw": false, "body": "常磐せいさ様はじめまして、ふぃらむと申します！\n貴方様のイラストをskebで見、その絵柄に一目惚れしてしまいました！是非私のキャラクター描いて欲しいと思っていたためリクエストを送らせていただきました！\n\n\n▽キャラクター詳細\n基本的にあまり表情筋が働いていない長寿の男です。\n\nhttps://drive.google.com/drive/folders/1RvmnxMyhIOshKaBj-pB1VBslJT1zlEAa\n\n世界観はファンタジーです。\n構図などはお任せします！\n\n○使用用途\n鑑賞、自慢\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ochatoissho/works/1", "thumbnail_src": "https://si.imgix.net/900e7776/uploads/origins/842a5184-a845-45f6-a045-f1daac5fd9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8acb44efab6359873b9f102012df2f6d", "thumbnail_srcset": "https://si.imgix.net/900e7776/uploads/origins/842a5184-a845-45f6-a045-f1daac5fd9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8acb44efab6359873b9f102012df2f6d, https://si.imgix.net/900e7776/uploads/origins/842a5184-a845-45f6-a045-f1daac5fd9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28dec165a02fbe29dcf18b387abf09b0 2x, https://si.imgix.net/900e7776/uploads/origins/842a5184-a845-45f6-a045-f1daac5fd9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97fa8cbb2e5feac6d3a0336499c32007 3x", "genre": "art", "nsfw": false, "body": "突然的委托十分抱歉，由于网站使用不熟练，可能会出现一些问题，如果造成困扰了有我这里先道歉！一直很喜欢您画的画，非常的美，有神圣的感觉。因此投递了委托，如果愿意接下的话会很高兴。这个oc的名字是李明澈，是一个神父（不相信神明的），是一个很温柔的孩子。以及，又一个作为邪神的对象（不重要）。本次委托的构图等方面完全交给你这么想着。可能会有失礼的地方，万分抱歉……  想要有些神圣的感觉的\n试着做了链接，不知道能否打开呢。如果打不开的话可以在我的rednote找到它，麻烦您了！\n\nhttps://b23.tv/jGihhd6", "created_at": "", "completed_at": ""}]}