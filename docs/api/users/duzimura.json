rop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69eda3b75420c28773597542acab2cac 2x, https://si.imgix.net/44311aa0/uploads/origins/5b74eb33-f2a6-499f-950b-c5247c370936?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8d7a1c70d5fad463b554e2fea361d0f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/57", "thumbnail_src": "https://si.imgix.net/67418527/uploads/origins/69cdce6e-656c-4809-864f-cded60808e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9296661eac35c7545b18eb3dfca166d4", "thumbnail_srcset": "https://si.imgix.net/67418527/uploads/origins/69cdce6e-656c-4809-864f-cded60808e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9296661eac35c7545b18eb3dfca166d4, https://si.imgix.net/67418527/uploads/origins/69cdce6e-656c-4809-864f-cded60808e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb29d010e8e8f50ee336a25bd1a3fbe3 2x, https://si.imgix.net/67418527/uploads/origins/69cdce6e-656c-4809-864f-cded60808e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e0bb0d1b8b4bc692005ab0f8909815c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/56", "thumbnail_src": "https://si.imgix.net/a95fdf9b/uploads/origins/9c89c679-f2a7-4156-a419-4651bddcb1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47db5a232faf005bd6d83572b5335c2c", "thumbnail_srcset": "https://si.imgix.net/a95fdf9b/uploads/origins/9c89c679-f2a7-4156-a419-4651bddcb1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47db5a232faf005bd6d83572b5335c2c, https://si.imgix.net/a95fdf9b/uploads/origins/9c89c679-f2a7-4156-a419-4651bddcb1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0478e3ebd8224990601b3f98607f98f 2x, https://si.imgix.net/a95fdf9b/uploads/origins/9c89c679-f2a7-4156-a419-4651bddcb1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8e898247b582418e91c83ec72d2534 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n状態変化系のイラストが大好きなのでリクエストさせていただきました。\n\nFF14の私のオリキャラを描いていただきたいです。\nhttps://drive.google.com/drive/folders/1hVC-Q9PPdh0fANCGkop9ajyCE1rOhWC_?usp=drive_link\n\n参考 https://www.pixiv.net/artworks/69373382\n上記イラストのような全裸で自分の手で胸でハートを作りそのまま石化している内容をお願いしたいです。\n\nhttps://www.pixiv.net/artworks/50542506\nまた、上記のような青い背景で怪しく光るような美術品のような感じをお願いしたいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/55", "thumbnail_src": "https://si.imgix.net/a290e1f8/uploads/origins/7b31babd-ebc7-4a38-9370-edd5d4c87609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc005ee14e847cc48fd29391d7a0510", "thumbnail_srcset": "https://si.imgix.net/a290e1f8/uploads/origins/7b31babd-ebc7-4a38-9370-edd5d4c87609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc005ee14e847cc48fd29391d7a0510, https://si.imgix.net/a290e1f8/uploads/origins/7b31babd-ebc7-4a38-9370-edd5d4c87609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eda56e515cc684fc21a2d1f1cfcedb8 2x, https://si.imgix.net/a290e1f8/uploads/origins/7b31babd-ebc7-4a38-9370-edd5d4c87609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5c86b1399627414f57a0f1d201d5020 3x", "genre": "art", "nsfw": true, "body": "初めまして、少し前ですがアピールありがとうございます。\nボテ腹絵などに惹かれてリクエストします。\n\n■キャラクター\n東方Projectの今泉影狼\nhttps://dic.pixiv.net/a/%E4%BB%8A%E6%B3%89%E5%BD%B1%E7%8B%BC\n\n狼女のお姉さんで胸は巨乳で尻尾も生えてます。\n分け目のある髪型はおでこが広くならないようお願いします。\n長い爪は普通の長さでＯＫです。\n\n■シチュエーション\n発情期の影狼が彼女を狙うおじさんに口説かれて\n汗だくムレムレな交尾をしておじさんと夫婦になります。\n\n交尾する場所はおじさんの家の寝室の布団(ベッド)の上\n体位は男性主観の正常位でお願いします。\n\n服は胸と結合部が見えれば全裸でも半脱ぎでもＯＫですが\n半脱ぎの場合は二次創作でよく見かけるオフショルダー(※)でお願いします。\n※「影狼　肩だし」で検索するとイメージ沸きます\n\n尻尾の描写ありで抵抗がなければ陰毛を生やしてください。\n\n擬音や喘ぎ声、可能なら台詞ありで\n以下のような差分形式でお願いします。\n\n①挿入前\n　寝室の布団(ベッド)の上で股を開いている影狼は\n　発情期を迎えて全身汗だくでフェロモンがムンムン中で\n「私の匂い…キツくないかしら？」と気にしていますが\n　おじさんからとても興奮するよと言われて\n（このおじさんならありのままの私のことを受け入れてくれるかも）と\n　おじさんに処女を捧げる決心をした影狼は\n「初めてだから優しくして❤」と迫る交尾にドキドキです。\n\n②挿入\n　挿入された影狼は破瓜の痛みを感じながら\n　おじさんと交尾してる❤処女を捧げちゃった❤とゾクゾク\n\n③ピストン中\n　激しい動きに喘ぎまくる影狼\n\n④ピストン中(射精直前)\n　射精が近いことを察した影狼は\n　発情期中で危険日であることをおじさんに伝えると\n　おじさんからこのまま中に出して孕ませる！俺の嫁になれと求婚され\n　おじさんが本気だと理解した影狼は求婚を承諾して\n「おじさんの赤ちゃん欲しい」「孕ませて」など\n　孕ませワードを囁いて、おじさんを更に興奮させます。\n\n⑤中出し絶頂\n　おじさんに中出しマーキングされて影狼は絶頂\n\n⑥中出し後の余韻中\n　中出しマーキングされた余韻に浸る影狼は\n「おじさんと番いになっちゃった❤」\n「元気な赤ちゃん産むわ❤」とドキドキで\n　おじさんから子供を１０人は作るぞと言われて\n「１０人も欲しいの？\n　いいわ…❤何人でも産んであげる❤」と約束します。\n\n⑦その後（ボテ腹差分）\n　その後、妊娠してボテ腹となった影狼は\n　イヌ科は多産のため影狼も複数の子供をお腹に宿したようで\n　何人産まれるのか楽しみねと嬉しそうで\n　目標の１０人はすぐに達成しそうで新しい目標を作るようです。\n\n以上、ご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/54", "thumbnail_src": "https://si.imgix.net/60a88855/uploads/origins/36c929fd-25b2-401b-aea1-805048bcbf70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54ad3d28414fc28a0bc1b7f0ed40e877", "thumbnail_srcset": "https://si.imgix.net/60a88855/uploads/origins/36c929fd-25b2-401b-aea1-805048bcbf70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54ad3d28414fc28a0bc1b7f0ed40e877, https://si.imgix.net/60a88855/uploads/origins/36c929fd-25b2-401b-aea1-805048bcbf70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e95b91ab93fcf9aadae77720cef5c24 2x, https://si.imgix.net/60a88855/uploads/origins/36c929fd-25b2-401b-aea1-805048bcbf70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbf57a12bfd31e37d5334d22b9532ce0 3x", "genre": "art", "nsfw": true, "body": "双葉シャロの石化をお願いします。\nhttps://twitter.com/futaba_sharo?t=YM-mVIEDYnbi73_6IaTkug&s=09\n今度は赤い触手に捕まる。アソコの視界を遮らない程度に亀頭を触ると、舌を出すまで気持ちよくなります。ポーズは下のリンクのような感じで、足の裏も見たい：\nhttps://x.com/takuminHdayo/status/1541273886242664449?t=wVQclgq1AZhLsPrQoaBd0Q&s=19\nさらに、粘液を追加することに興味があるなら、彼女の顔の前にもう1本触手を追加し、粘液が舌に垂れるようにすることができる。亀頭からの触手は、膣に挿入して粘液を垂らすように変更することができますが、その場合、最初に彼女の顔と膣を石化することもできます。\n最後に、Xに投稿する際、#えちしゃろのタグをつけるよう注意しなかったことをお詫びします。", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/53", "thumbnail_src": "https://si.imgix.net/dac4f943/uploads/origins/117341f0-a594-4171-93ad-511fa1f05e95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484f80a4985d139810812c1a8fb29bc4", "thumbnail_srcset": "https://si.imgix.net/dac4f943/uploads/origins/117341f0-a594-4171-93ad-511fa1f05e95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484f80a4985d139810812c1a8fb29bc4, https://si.imgix.net/dac4f943/uploads/origins/117341f0-a594-4171-93ad-511fa1f05e95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56124a7d9b681f64a095a1feaac80929 2x, https://si.imgix.net/dac4f943/uploads/origins/117341f0-a594-4171-93ad-511fa1f05e95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebcc41558d206f3c26d3b62871eee0fe 3x", "genre": "art", "nsfw": true, "body": "ヅジムラ 様 こんにちは。\nぽぴ子と申します。\n\nわたしのオリキャラの石化を描いていただきたくリクエストを送らせていただきました。ぜひご検討いただければと思います。\n\n\n◎キャラクター\nカチュア(立ち絵は資料URL)\n\n◎シチュエーション\n石化（全裸、瞳あり、ヒビあり）\n\n◎構図等の要望\n石化には慣れている(設定)キャラなので表情は自然な表情(恍惚でも問題ないくらい)、ポーズの方も身構えようとはせず可愛らしい自然なポーズ\n\n\nという感じでお願いしたいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-5GJKCdwg89oaO9Nx_vY2791hlP77Dx_", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/52", "thumbnail_src": "https://si.imgix.net/98d7a141/uploads/origins/082addb4-6948-440e-8ad2-ed4fbe84bf3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9939b4607bc46da29b4e482d464d2555", "thumbnail_srcset": "https://si.imgix.net/98d7a141/uploads/origins/082addb4-6948-440e-8ad2-ed4fbe84bf3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9939b4607bc46da29b4e482d464d2555, https://si.imgix.net/98d7a141/uploads/origins/082addb4-6948-440e-8ad2-ed4fbe84bf3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15c4ff3717066dce6a80f788f441c07b 2x, https://si.imgix.net/98d7a141/uploads/origins/082addb4-6948-440e-8ad2-ed4fbe84bf3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2be1a9e912193795955f16d3d65b7cc 3x", "genre": "art", "nsfw": true, "body": "初依頼失礼いたします！\n前回描かれていた石化がとても良かったので、是非とも石化を依頼させて頂きたく\n石化前差分は無し、背景無しの立ち絵のみという形式で2キャラお願いしたいです！\n\n●FGOよりアビゲイル\nhttps://drive.google.com/file/d/1J-j7gRUieroem3VjDXmsL4CNohAQTIU2/view?usp=sharing\n\n●FGOよりモルガン（水妃）\nhttps://drive.google.com/file/d/1t-81uBC6CGFmEU2cyD4VteAsoXDyJQru/view?usp=sharing\n\n希望の角度とは違うのですが正面の参考\nhttps://drive.google.com/file/d/1Ykko7N87uZ6Ehz-4hAAjOa6yEqDT5IZa/view?usp=sharing\n\n●構図は3Dで製作させて頂いた下記を参考に、\n二人とも真正面向きで画像の様に少しだけ身体をのけ反り気味で手足をピシッと揃えた直立で、全身見切れ無しで、身長差はアビゲイルはモルガンの肩ぐらいまでの高さのイメージです\nhttps://drive.google.com/file/d/1d4X3k1CsrRofvix-Ym8ZfO4UKQ-m0rqL/view?usp=sharing\n\n●石化につきまして瞳は無し、質感は前回描かれていた下記の作品と同じようなもので\n色はほんの少しだけ暗めにして頂けると！\nhttps://skeb.jp/@duzimura/works/45\n\n●二人とも帽子や髪飾り等を残して全裸、胸は上記3D資料のような爆乳\n表情は二人とも3Dサンプルのような目を見開いたアへ顔（瞳無し）\n固め前差分は必要ないのですが表情差分として洗脳されたような無表情（瞳無し）\nに加えボテ腹差分をお願い致します！\n\n2キャラ別々のファイルで背景が透過されていると嬉しいです！\n\n細かく指示してしまい大変申し訳ないのですが…よろしければお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@duzimura/works/51", "thumbnail_src": "https://si.imgix.net/9d7a12bd/uploads/origins/6193c2a8-741e-49e7-95e8-803105b109d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=