419e1ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b701753721d929c40dd3a0c556f65ed8", "thumbnail_srcset": "https://si.imgix.net/1acb469d/uploads/origins/398f71ec-95b1-495e-9b7d-4187419e1ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b701753721d929c40dd3a0c556f65ed8, https://si.imgix.net/1acb469d/uploads/origins/398f71ec-95b1-495e-9b7d-4187419e1ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d65586c06ae605bcbbd16ffada6cf2d 2x, https://si.imgix.net/1acb469d/uploads/origins/398f71ec-95b1-495e-9b7d-4187419e1ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bdc735c026f90e667b7b083f32ea85f 3x", "genre": "art", "nsfw": false, "body": "わたもにゃさんのマスカーニャ大好きなので、巨大化した胸盛りマジックマスカーニャを描いていただきたいです！\nシチュエーションは、東京タワー的な電波塔と並んで、展望台にいるであろうトレーナーにニッコニコの笑顔を向けながら、可愛いポーズを取って記念撮影してもらっている所をお願いします！\n胸はわたもにゃさんのできる限り、今までの一番の盛り具合にして欲しいです！\n服装の有り無し、デザインはお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@mocco_moo/works/5", "thumbnail_src": "https://si.imgix.net/b7c0f94c/uploads/origins/4e9f88b2-5f43-4391-9434-6f301f44bfb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb791dcb03a23188e9ac702cba332889", "thumbnail_srcset": "https://si.imgix.net/b7c0f94c/uploads/origins/4e9f88b2-5f43-4391-9434-6f301f44bfb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb791dcb03a23188e9ac702cba332889, https://si.imgix.net/b7c0f94c/uploads/origins/4e9f88b2-5f43-4391-9434-6f301f44bfb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02307e56f1c295580df31c768e24153d 2x, https://si.imgix.net/b7c0f94c/uploads/origins/4e9f88b2-5f43-4391-9434-6f301f44bfb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44f0fd8ef58e5401e621ff43435f00a1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！わたもにゃ様のイラストがとても好みだったのでリクエストさせて頂きました。リクエスト内容なのですが、メタモンに化けてるゾロア(尻尾出てる)とゾロアに変身しているメタモン(顔がメタモン顔)が一緒に寝ているのでお願いしたいです。宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mocco_moo/works/4", "thumbnail_src": "https://si.imgix.net/65ec74fd/uploads/origins/01ca19c4-d5fc-4f9a-8530-abcd60eac1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51e68256e7531fa57ed8bd05e7a92fc4", "thumbnail_srcset": "https://si.imgix.net/65ec74fd/uploads/origins/01ca19c4-d5fc-4f9a-8530-abcd60eac1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51e68256e7531fa57ed8bd05e7a92fc4, https://si.imgix.net/65ec74fd/uploads/origins/01ca19c4-d5fc-4f9a-8530-abcd60eac1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3ec036cf070dd1fa97f313ad333e07b 2x, https://si.imgix.net/65ec74fd/uploads/origins/01ca19c4-d5fc-4f9a-8530-abcd60eac1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8a7b0baad447324469d3f5563febf8e 3x", "genre": "art", "nsfw": false, "body": "私のポケOC「ニャースカラダのサブリナ」を描いてもらえますか？\n\nhttps://media.discordapp.net/attachments/1213742564826415164/1213744527970410556/IMG_0571.jpg?ex=6624bb2d&is=6612462d&hm=972b646f8824611f02df0989e1d62ebe1d100aa8b87a9689985d59c55fab05e0&", "created_at": "", "completed_at": ""}, {"path": "/@mocco_moo/works/3", "thumbnail_src": "https://si.imgix.net/8c62583e/uploads/origins/90127f30-dcc9-4494-97a4-f814522ce44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987a1309ee3ce999946c6ccee610b195", "thumbnail_srcset": "https://si.imgix.net/8c62583e/uploads/origins/90127f30-dcc9-4494-97a4-f814522ce44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987a1309ee3ce999946c6ccee610b195, https://si.imgix.net/8c62583e/uploads/origins/90127f30-dcc9-4494-97a4-f814522ce44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=065fe72d07a0b7862479df7e394c6c0c 2x, https://si.imgix.net/8c62583e/uploads/origins/90127f30-dcc9-4494-97a4-f814522ce44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c748c32440bbf38b1da62e5ec0c7ccc6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！あなたの画風はとても愛らしいですね！線が太くて、表情が可愛くて大好きです。ポーズの詳細はあなた次第ですが、私のファーソナがサイキックエネルギーでハートの形を作っているところを描いていただけませんか？サイキックパワーを使っているので、額の宝石は赤く光っているはずです。\n参考シートの一番上にある衣装のどれかを着て描いてください。\n\nhttps://file.garden/Zca2pBItAVk3K___/espeon_ref_2022_JP.png", "created_at": "", "completed_at": ""}, {"path": "/@mocco_moo/works/2", "thumbnail_src": "https://si.imgix.net/9d092630/uploads/origins/be31d208-b9c9-4527-8a27-9165fed5e113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9837cb7106e03f891e5c3fe47f63f1a1", "thumbnail_srcset": "https://si.imgix.net/9d092630/uploads/origins/be31d208-b9c9-4527-8a27-9165fed5e113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9837cb7106e03f891e5c3fe47f63f1a1, https://si.imgix.net/9d092630/uploads/origins/be31d208-b9c9-4527-8a27-9165fed5e113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bf0a8c6099bc1090495c75bf4fdd318 2x, https://si.imgix.net/9d092630/uploads/origins/be31d208-b9c9-4527-8a27-9165fed5e113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9fc6e52f72fe3371c1b9ca7b2237bf8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私はニャースカラダのあなたのアートスタイルがとても好きです！だから、私のゼラオラのキャラクターをあなたの画風で描いてほしいです。彼女はシャイでフレンドリーな性格なので、彼女の性格を表すかわいいポーズを自由に選んでください。\n\n細部で見落としがあるかもしれません。白い鼻、お腹の青いハート、しっぽは襟足から、手の甲には2本の縞模様があります。ゼラオラによく似ている！\n\nhttps://drive.google.com/drive/folders/1eTlK-CbYZZb09zZ9k5hum7JCOD1L1XcO?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mocco_moo/works/1", "thumbnail_src": "https://si.imgix.net/b325683f/uploads/origins/5300ded9-9780-4147-b24e-61ef3962eac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f7c1a384839876e05f8cc8f4345ad2e", "thumbnail_srcset": "https://si.imgix.net/b325683f/uploads/origins/5300ded9-9780-4147-b24e-61ef3962eac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f7c1a384839876e05f8cc8f4345ad2e, https://si.imgix.net/b325683f/uploads/origins/5300ded9-9780-4147-b24e-61ef3962eac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8ece3bf0e787cd5947cac481e580d20 2x, https://si.imgix.net/b325683f/uploads/origins/5300ded9-9780-4147-b24e-61ef3962eac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70b4bf09f0cab64da9c2500657c45efe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Skebを立ち上げてくれて本当に嬉しいです！あなたのアートワークが本当に大好きです！\n私のキャラクターも描いてもらえますか？ポーズにこだわりはないので、絵の自由度はお任せします。\n\nhttps://drive.google.com/drive/folders/1jx4LVqzIlLYoIq99S7Om_aOeDw1LXEqh", "created_at": "", "completed_at": ""}]}