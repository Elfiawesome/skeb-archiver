a13-24b0b7e96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed397504e88cc568a2b59a648c96728, https://si.imgix.net/8d555f5d/uploads/origins/10210d74-918a-422c-aa13-24b0b7e96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6f4d10b65968a0d98a91d9497d4ba31 2x, https://si.imgix.net/8d555f5d/uploads/origins/10210d74-918a-422c-aa13-24b0b7e96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ebd337562b5a77126ac39468b446333 3x", "genre": "art", "nsfw": false, "body": "ぽち🍋 ご依頼募集中さん　こんばんは\nいつも素敵なイラスト拝見させていただいています\n\n結城さくなさん🎀🐾をリクエストさせて下さい\n衣装は水着（できれば全身で）\nその他、背景・構図は全てお任せします\n\n【使用用途について】\nパソコンの壁紙、スマホの待ち受け画面\nSNSアイコン、ヘッダー\n\n立ち絵しか資料がありませんが、よろしくお願いします\nhttps://x.com/yuki_sakuna/status/1879468694998569369\n\nhttps://x.com/yuki_sakuna/status/1870377727846760953", "created_at": "", "completed_at": ""}, {"path": "/@poncho_poncho15/works/6", "thumbnail_src": "https://si.imgix.net/94203b3b/uploads/origins/326dca1f-c543-4028-ad8e-c878b3973a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a287f3bc5538620230382198ca886d", "thumbnail_srcset": "https://si.imgix.net/94203b3b/uploads/origins/326dca1f-c543-4028-ad8e-c878b3973a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a287f3bc5538620230382198ca886d, https://si.imgix.net/94203b3b/uploads/origins/326dca1f-c543-4028-ad8e-c878b3973a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a97f1cfcd0282f275807846f0336fb87 2x, https://si.imgix.net/94203b3b/uploads/origins/326dca1f-c543-4028-ad8e-c878b3973a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=deaa2b58d5e2a4d8dc0d6ccbc3a713cb 3x", "genre": "art", "nsfw": false, "body": "ぽち🍋 ご依頼募集中さん　こんにちは\nいつも可愛いあくたんのイラストありがとうございます\n湊あくあさんをリクエストさせて頂きます。\n\n湊あくあさん\n衣装はメイド服\n初配信から色々成長した姿でお願いします。\nその他、背景・構図は全てお任せします\n\n【使用用途について】\nパソコンの壁紙、スマホの待ち受け画面\nSNSアイコン、ヘッダー\n\nhttps://www.youtube.com/watch?v=fe0si3mul_E", "created_at": "", "completed_at": ""}, {"path": "/@poncho_poncho15/works/5", "thumbnail_src": "https://si.imgix.net/fd1b429d/uploads/origins/5ea4e53d-ad20-4ce6-972a-a08ec4853205?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e901610466b32a61cb52498f68ef8df", "thumbnail_srcset": "https://si.imgix.net/fd1b429d/uploads/origins/5ea4e53d-ad20-4ce6-972a-a08ec4853205?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e901610466b32a61cb52498f68ef8df, https://si.imgix.net/fd1b429d/uploads/origins/5ea4e53d-ad20-4ce6-972a-a08ec4853205?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f7317a7aeba30a2552fd9bdc872ac73 2x, https://si.imgix.net/fd1b429d/uploads/origins/5ea4e53d-ad20-4ce6-972a-a08ec4853205?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f72ca0a90d6a56dcf50b364fc6dfd5a 3x", "genre": "art", "nsfw": false, "body": "初めまして\n可愛いイラストを拝見して、是非とも依頼したいと思い、送らせていただきました。\n\n今回、依頼したいのは配信アプリ「IRIAM」で活動中のVライバーさん「天音しずく」さんの絵を描いていただきたいです。\nhttps://twitter.com/amaotoshizuku/status/1310529081495052289?s=46&t=eucrAj6RsnxGr4vXimTBTA\n\n3面図などの資料がないもので…本人のTwitterアカウントへのリンクを載せさせていただきます。\n\nしずくさんが、６月に誕生日を迎えるので\n祝う形の絵を描いていただけたら嬉しいです。\n\n衣装、背景などは、お任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@poncho_poncho15/works/4", "thumbnail_src": "https://si.imgix.net/65913a8f/uploads/origins/2ec3933d-4a1f-4f6a-aa80-72ef0ce2be5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bebdcb65b1ae0f69588a9768da97957f", "thumbnail_srcset": "https://si.imgix.net/65913a8f/uploads/origins/2ec3933d-4a1f-4f6a-aa80-72ef0ce2be5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bebdcb65b1ae0f69588a9768da97957f, https://si.imgix.net/65913a8f/uploads/origins/2ec3933d-4a1f-4f6a-aa80-72ef0ce2be5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b88a5e6d3473cb20c78f24774d338460 2x, https://si.imgix.net/65913a8f/uploads/origins/2ec3933d-4a1f-4f6a-aa80-72ef0ce2be5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a16346fa7f67999531a878a7012185f 3x", "genre": "art", "nsfw": false, "body": "ぽち先生、こんにちは！\n\n先生にイラストの依頼をさせていただきたいと思っています。お願いしたいのは、VTuberの「ルシエ」(ツイッター @Rucie_V)というキャラクターのイラストです。キャラクターのコンセプトは雪の狐です。描いていただいたイラストは、描いていただいたイラストは、TwitterなどのSNSに投稿したり、配信で紹介することができるよう活用させていただく予定です。\n\nリクエストの内容はシンプルで、ルシエのイラストを自由なポーズやシチュエーションで描いていただきたいと思っています。ただ、一点だけお願いがあって、胸の部分はフラットにしていただけると嬉しいです。\n\nルシエの画像は、下記のリンクからご確認いただけます：\nhttps://drive.google.com/drive/folders/16U8czPCPZE7UF4lSMPy4NWdAP18I9f4w?usp=sharing\n\nどんなイラストでも喜びますし、ぽち先生の独自のセンスで可愛らしい作品を楽しみにしています！\n\nどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@poncho_poncho15/works/3", "thumbnail_src": "https://si.imgix.net/958fc45f/uploads/origins/f35f15be-7524-4416-8092-2fd4d0edc3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=050417150f5197cfc97230f8d1941fe5", "thumbnail_srcset": "https://si.imgix.net/958fc45f/uploads/origins/f35f15be-7524-4416-8092-2fd4d0edc3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=050417150f5197cfc97230f8d1941fe5, https://si.imgix.net/958fc45f/uploads/origins/f35f15be-7524-4416-8092-2fd4d0edc3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3d27513572ff52cd0d71820384cce66 2x, https://si.imgix.net/958fc45f/uploads/origins/f35f15be-7524-4416-8092-2fd4d0edc3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d59b15c42f6f0ff2dc8b4a0a27c48d14 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ぽちさん！\n聖龍王ヴェリタスと申します。\nskebで、凄く可愛いイラストを描かれていたので、依頼をさせて頂きました！\n今回は、Vtuberの猫月みお（@Nekozuki_Mio)さんのイラストを描いていただきたいです！\n髪型や服装の組み合わせなどはお任せします！（服装はオリジナルでも大丈夫です！）\n\n資料のURLは、下記の通りとなります。\nhttps://twitter.com/Nekozuki_Mio/status/1581492092869562369\n通常のモデルの三面図等の資料も含まれていますので参考にしていただければと思います！\n\nそばにいる猫のななちゃんも一緒に描いて欲しいです！\nその他の構図や背景などはお任せします。\n\n・宛名・背景のオンオフができると嬉しいです。\n・もし可能であれば本人のVtuber活動（配信サムネイルやSNSでの告知など）での使用許可をいただきたいです。承諾いただける場合は宛名の○○さんへの横に星のマークを添えていだけると幸いです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@poncho_poncho15/works/2", "thumbnail_src": "https://si.imgix.net/73637bbf/uploads/origins/513bcd5e-55a3-4970-854e-38a9c2835ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde995eac371df669c72c38735a9a479", "thumbnail_srcset": "https://si.imgix.net/73637bbf/uploads/origins/513bcd5e-55a3-4970-854e-38a9c2835ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde995eac371df669c72c38735a9a479, https://si.imgix.net/73637bbf/uploads/origins/513bcd5e-55a3-4970-854e-38a9c2835ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=101a791217a0c6a8251c97bc4eaec090 2x, https://si.imgix.net/73637bbf/uploads/origins/513bcd5e-55a3-4970-854e-38a9c2835ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0cdbd969fac61b1b60255b87d01f04e 3x", "genre": "art", "nsfw": false, "body": "初めまして～Ardenと申します。\nうちの子「花丸リリィ」をリクエスト致します。\n\nイラストのサイズは16:9を希望します。\n衣装は参照画像の衣装でも、全く別の衣装でもかまいません。構図、背景等もおまかせします～\n\nキャラデザインの資料： https://blog.wtf.day/?page_id=559\n\n<使用用途> \n自分のTwitter やパソコンやブログの壁紙とイラスト。\n\nよろしければ是非お願いします。\n\nhttps://blog.wtf.day/?page_id=559", "created_at": "", "completed_at": ""}, {"path": "/@poncho_poncho15/works/1", "thumbnail_src": "https://si.imgix.net/4bfe32f7/uploads/origins/a1cb39bd-b701-4a4a-9aea-3252e4078943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2a443395a07c7a741747e7d395ddb7", "thumbnail_srcset": "https://si.imgix.net/4bfe32f7/uploads/origins/a1cb39bd-b701-4a4a-9aea-3252e4078943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2a443395a07c7a741747e7d395ddb7, https://si.imgix.net/4bfe32f7/uploads/origins/a1cb39bd-b701-4a4a-9aea-3252e4078943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b57d4e613edeca5ff92451867e2b370c 2x, https://si.imgix.net/4bfe32f7/uploads/origins/a1cb39bd-b701-4a4a-9aea-3252e4078943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=381a819fdce7cffb6e71edf91ca3961a 3x", "genre": "art", "nsfw": false, "body": "はじめまして。うちの子（桜田ハネ @SakuradaHane）をお願いしたく、リクエストさせていただきました！\n\nキャラクター（参考：https://imgur.com/a/KAw93dM）：\n- ヘア：ピンク\n- 瞳：青\n- カップ：B\n- 猫耳\n- 身長：155\n- ヘアアクセは注意 (>▽<)\n\n構図、背景等はおまかせしますが、可能な範囲で表情差分を描いていただけますとうれしいです。\n\nhttps://imgur.com/a/KAw93dM", "created_at": "", "completed_at": ""}]}