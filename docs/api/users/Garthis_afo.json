ca-42d4-8dc4-c475fe7cb9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bfd95dfe574268fcf8d358e799aa295, https://si.imgix.net/725b2aa3/uploads/origins/82458b1f-f9ca-42d4-8dc4-c475fe7cb9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b293d1603db96de03f0253495882f730 2x, https://si.imgix.net/725b2aa3/uploads/origins/82458b1f-f9ca-42d4-8dc4-c475fe7cb9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=619dc49dca78b48099bea22b61d7ec24 3x", "genre": "art", "nsfw": false, "body": "ファンタジスタみこちオナシャス！！\nいつものスマホ壁紙サイズで。\n後は任せた！！", "created_at": "", "completed_at": ""}, {"path": "/@Garthis_afo/works/25", "thumbnail_src": "https://si.imgix.net/945c57b2/uploads/origins/2643cb84-7191-434e-8dc8-85d429d6b555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50232b2ad0e547522d2a88eceb8d9697", "thumbnail_srcset": "https://si.imgix.net/945c57b2/uploads/origins/2643cb84-7191-434e-8dc8-85d429d6b555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50232b2ad0e547522d2a88eceb8d9697, https://si.imgix.net/945c57b2/uploads/origins/2643cb84-7191-434e-8dc8-85d429d6b555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=454bc3a49f1fab218c7c07a440098a1d 2x, https://si.imgix.net/945c57b2/uploads/origins/2643cb84-7191-434e-8dc8-85d429d6b555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfbdd867066a921cb4b17fa400013dd0 3x", "genre": "art", "nsfw": false, "body": "はじめまして、みこちの手描き切り抜き動画同時視聴を見た時、思い切った迫力のある顔面を見て、ぜひリクエストしたいと思い、リクエストさせていただきました。\n内容はマネージャーに作業部屋に閉じ込められたスバルがとある映像を見せられるという漫画で、\nマネちゃんの策略にハマりまた作業部屋に閉じ込められたスバル（作業がなかなか進まなかったせい）\n作業が終わるまでおうちに帰す気がないマネちゃんにスバルが「おい、倫理観どこ行った？」と言うもマネちゃんに「さぁ？地獄の底でランデブーでもしてるんじゃないですか？」と淡々と映像を見る準備を進められる。（コマの余裕があれば「え？スバルまだ死にたくないんだけど」と言うスバル）\nマネちゃんがスバルが作業を頑張るために応援メッセージ動画と評して見せたのは、スバルを応援するために結成された架空ユニット『あおそらわたいろ』（ときのそら、角巻わため、風真いろは、あおくゆ）による二時間に及ぶ応援メッセージ。\n目を輝かせて口をωにし、両手でガッツポーズをして純粋に応援する気のときのそら\n同じく純粋にお祝いしようと来たけど何をすればいいかわからず、とりあえずにへらと笑いながらダブルピースをするござること風真いろは\n完全にノープランだけど、『本日の主役』と書かれたタスキをつけて、口にバラをくわえて格好つけているあおくゆ\n完全にマネージャーの意図を理解し、わためぇ Night Fever!!のサングラスをつけ、にやりと悪い笑みを浮かべているぎりぎり悪くないわため（マネージャーに頼まれただけなので）\n「やめろぉーー！！（115㏈）」とすべての音に濁点をつけて、何なら背景もア゛ァ゛ァ゛って叫んで本気で拒絶している大空スバルと『ツッコみ不在の二時間の応援のおかげか作業は普段の1.2倍進んだ』というト書き\n\n架空ユニットあおそらわたいろをできれば、四人一つのコマに描いてもらいたく、コマのスペースがあれば、四人が手書きで書いたであろう『ガレんバ！スばル』の垂れ幕\n（本当はガンバレスバルと書きたかったが、一文字ずつ順番に書いた際にミスをした。なお、ひらがなの『ん』と『ば』はござるが担当なぜか達筆な黒文字で書かれていて、他のかわいくポップに書かれた文字と比べてういている）\nもしSNSで投稿していただける際にはファンアートタグもつけていただけると助かります\n日に日に気温が上がって大変だと思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Garthis_afo/works/24", "thumbnail_src": "https://si.imgix.net/249aa5e9/uploads/origins/7d87b8e9-c2fc-43c2-9742-ba24dc2bfd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85eb4c5db0cfc85bcc03ff42afce8ca5", "thumbnail_srcset": "https://si.imgix.net/249aa5e9/uploads/origins/7d87b8e9-c2fc-43c2-9742-ba24dc2bfd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85eb4c5db0cfc85bcc03ff42afce8ca5, https://si.imgix.net/249aa5e9/uploads/origins/7d87b8e9-c2fc-43c2-9742-ba24dc2bfd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f92126645145cd3636ead51553754dbb 2x, https://si.imgix.net/249aa5e9/uploads/origins/7d87b8e9-c2fc-43c2-9742-ba24dc2bfd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccd872873fc47edb29345783593aeec8 3x", "genre": "art", "nsfw": false, "body": "雨の季節になったので、\n「傘さした、振り向きぽにち」を\nお願いします。\n\nぽにち、いいよね。。。！", "created_at": "", "completed_at": ""}, {"path": "/@Garthis_afo/works/23", "thumbnail_src": "https://si.imgix.net/c5891cff/uploads/origins/ab4c72a2-19d8-4ee4-9dcc-8e8b4f8a9bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d6c4e2458a23122a04c3d54b23eb96a", "thumbnail_srcset": "https://si.imgix.net/c5891cff/uploads/origins/ab4c72a2-19d8-4ee4-9dcc-8e8b4f8a9bf2?bg=%23fff&auto=format%2Ccompress&fm