fb6be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70303b335d69a65d70bc6ad5ee9ad93a", "thumbnail_srcset": "https://si.imgix.net/08665e27/uploads/origins/19d42ff9-7d85-43f7-b0e1-340f94fb6be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70303b335d69a65d70bc6ad5ee9ad93a, https://si.imgix.net/08665e27/uploads/origins/19d42ff9-7d85-43f7-b0e1-340f94fb6be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77293b2fc2582d84f970ef6bb70511a5 2x, https://si.imgix.net/08665e27/uploads/origins/19d42ff9-7d85-43f7-b0e1-340f94fb6be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01b1aeb8f56f4546e66a427ea40bb77e 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。良ければイラストお願いします。  \n\nキャラ 乙女が彩る恋のエッセンス 朝倉千弘  服装 制服、私服、コック姿またはシャニシスのアイドル衣装  \n内容 タルトタタンを持ってお祝いを受ける(タスキ掛けて祝10年！もお願いします)\n\n背景その他はお任せします。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@n_contrail/works/93", "thumbnail_src": "https://si.imgix.net/adc5b1a5/uploads/origins/9d45d0c6-7acf-4cd1-be80-abb2fdce2127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34268bb92d7024e67a2bdfa673500aeb", "thumbnail_srcset": "https://si.imgix.net/adc5b1a5/uploads/origins/9d45d0c6-7acf-4cd1-be80-abb2fdce2127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34268bb92d7024e67a2bdfa673500aeb, https://si.imgix.net/adc5b1a5/uploads/origins/9d45d0c6-7acf-4cd1-be80-abb2fdce2127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b678955aef4cee74588156a45351b52c 2x, https://si.imgix.net/adc5b1a5/uploads/origins/9d45d0c6-7acf-4cd1-be80-abb2fdce2127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fca3283a6b127f75ca9296f0fc5e8cbb 3x", "genre": "art", "nsfw": true, "body": "いつもイラストを見ています。\nOCのリクエストをしたいのですがお願いします。\n\nキャラは文字だけで申し訳ありませんが\n女の人：URLの女の人と同一人物、JK、黒髪ショートヘア、体系はスレンダーで胸はA～B、陰毛なし、青がメインで星柄の競泳水着を着ている。\n男の人：URLの男の人と同一人物、女の人より年上の先輩キャラでお願いします。\n\nシチュエーションですが、\n欲求不満の女の人が男の人を興奮させるために新しい競泳水着を見せて男の人にお仕置きしてもらう内容です。\n\n内容ですが、\n男の人が攻めで、女の人が受け。\n女の人は涙目で恥ずかしいポーズをしている。\n男の人は競泳水着をずらさず、競泳水着ごと手マンをしており、女の人に絶頂したらお仕置きの挿入をすると言ってるが、わざと寸止めを何度もしており絶頂しないことを褒めている。\n女の人は気持ちよくなっているが絶頂できないことに戸惑っており、早く挿入してもらうように要求している。\n二人とも入水はしておらず、女の人の股間と太もも、男の人の手のみが濡れている。\n恥ずかしいポーズはお任せしますが、正面から青がメインで星柄の競泳水着がわかるようなアングルにしてください。\n\n可能であれば女の人のお尻と股間が見えるようなカットインもお願いします。\nカットインですが、水着越しに手マンをされて、水着が愛液によって染みになっており、水着越しに性器の形が浮き上がっている。\nお尻は完全に食い込んでおり、小さなお尻が露わになっている。\nカットインでの男の人は水着越しの性器の形がわかるように半透明にしてください。\nまた、愛液は白濁しており、太ももまで濡れて糸を引いてる状態にしてください。\n\n以上です。よろしくお願いします。\n\nhttps://skeb.jp/@n_contrail/works/90", "created_at": "", "completed_at": ""}, {"path": "/@n_contrail/works/92", "thumbnail_src": "https://si.imgix.net/4f3cf422/uploads/origins/a2de705f-01d6-4ccb-852a-367e96253010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94dbea38d5577c14987cd618e6f19f5c", "thumbnail_srcset": "https://si.imgix.net/4f3cf422/uploads/origins/a2de705f-01d6-4ccb-852a-367e96253010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94dbea38d5577c14987cd618e6f19f5c, https://si.imgix.net/4f3cf422/uploads/origins/a2de705f-01d6-4ccb-852a-367e96253010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=404bcdd56e9635ffe34bf5c6bf7316d2 2x, https://si.imgix.net/4f3cf422/uploads/origins/a2de705f-01d6-4ccb-852a-367e96253010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4a3a5c7b306415bd046e47a6e3bbcb3 3x", "genre": "art", "nsfw": true, "body": "ねずも様\n\nいつも大変お世話になっております。久しぶりのskeb開放とのことでご依頼申し上げます。\n\nキャラ：相原七海(RIDDLE JOKER\n服装：競泳水着(資料リンク参照\n\n2024年6月に発売された1/3.5フィギュアのポージングにて、スカートをたくしあげる代わりに、競泳水着のVゾーンか胸元を指で引っ張る仕草を入れていただけませんでしょうか。また、背景にヒップのアップをつけていただけますとありがたく、お手数でなければ、お任せで競泳水着のカラバリをいただけましたら幸いです。\n\nこの度も多くの依頼が予想されますが、何卒、ご一考の程ほど、よろしくお願い申し上げます。\n\nhttps://www.kyouei-mizugi.com/?pid=189033243", "created_at": "", "completed_at": ""}, {"path": "/@n_contrail/works/91", "thu