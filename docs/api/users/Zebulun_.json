fc00876aa2e5, https://si.imgix.net/5b1d52cd/uploads/origins/453bbe1f-6694-4e63-99fe-86d86c0256e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=299c4b258b384eef116d526523671e7f 2x, https://si.imgix.net/5b1d52cd/uploads/origins/453bbe1f-6694-4e63-99fe-86d86c0256e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9adfa557b285dfc6ba4f9dae106b2f5f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Zebulun_/works/792", "thumbnail_src": "https://si.imgix.net/346e2964/uploads/origins/7afc8d17-6a82-4674-8a9c-e647ee2fe5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52da9db043f667ec3eb8ab0790839680", "thumbnail_srcset": "https://si.imgix.net/346e2964/uploads/origins/7afc8d17-6a82-4674-8a9c-e647ee2fe5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52da9db043f667ec3eb8ab0790839680, https://si.imgix.net/346e2964/uploads/origins/7afc8d17-6a82-4674-8a9c-e647ee2fe5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d263faf659e09e628dfc0921121f4698 2x, https://si.imgix.net/346e2964/uploads/origins/7afc8d17-6a82-4674-8a9c-e647ee2fe5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feb471e74d7301dc7ea1fb8eff41693b 3x", "genre": "art", "nsfw": true, "body": "前回は咲迦(エミカ)のイラストをありがとうございました。また星の翼よりライン、ヴァルキア、無銘のバストショットイラストをお願いいたします。\n\n三名のキャラがマグショットを撮る時の様なポーズでオナホのような部品を両手で持って左からライン、ヴァルキア、無銘の順に横並びになっている。\n右上に白枠で『団長の趣味で彼女等機械の身体に生体膣パーツを装着した』と説明。\n三名とも胸を露出している。乳首や乳輪の大きさ、形はゼブルン先生にお任せします。胸の大きさは気持ち元キャラより大きくして欲しい。\nラインは少し頬を染めて恥ずかしそうな表情、ヴァルキアはよく分からずに首を傾げている無銘は威風堂々といった出で立ち。\nそれぞれの生体腟パーツに解説がされており、ラインは『縦横斜めのヒダがギッシリ詰まっていて、多彩な刺激をしっかり感じられる』。ヴァルキアは『極太なスパイラルヒダとザラザラした微細イボがペニスに絡みついてくる』。無銘は『ちんちん全面をかまいたちに遭ったかのようにゾリゾリ摩擦され、カリ首を突起イボにツブツブ引っかかる』と説明。\n\n可能なら持っている生体腟パーツから精液が垂れている差分もお願いいたします。面倒なら無くて結構です。\n\n\n\n以上よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Zebulun_/works/791", "thumbnail_src": "https://si.imgix.net/263363c1/uploads/origins/a7aa478e-b834-4e92-bada-c38ca08954f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58b318101e7485bf3485f1d6fdc050fa", "thumbnail_srcset": "https://si.imgix.net/263363c1/uploads/origins/a7aa478e-b834-4e92-bada-c38ca08954f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58b318101e7485bf3485f1d6fdc050fa, https://si.imgix.net/263363c1/uploads/origins/a7aa478e-b834-4e92-bada-c38ca08954f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2810727e7dbf4929ebe3dce36975a6e0 2x, https://si.imgix.net/263363c1/uploads/origins/a7aa478e-b834-4e92-bada-c38ca08954f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48aab240c1656ce2895637084507f461 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Zebulun_/works/790", "thumbnail_src": "https://si.imgix.net/a1a44510/uploads/origins/77fa4bdd-c9dd-4a8f-8faa-a73e12aeb743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d39614e42185088840086dfdc03a39d", "thumbnail_srcset": "https://si.imgix.net/a1a44510/uploads/origins/77fa4bdd-c9dd-4a8f-8faa-a73e12aeb743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d39614e42185088840086dfdc03a39d, https://si.imgix.net/a1a44510/uploads/origins/77fa4bdd-c9dd-4a8f-8faa-a73e12aeb743?