200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46d5533f9efbbd3575dbe8a37bf2eb3f", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/16", "thumbnail_src": "https://si.imgix.net/0363a506/uploads/origins/559f0709-3386-415a-b633-c977000f0192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9bdafc2fcba7ae47a18c18e74c4a28e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/15", "thumbnail_src": "https://si.imgix.net/39518986/uploads/origins/a312bced-65e7-465c-8229-d5822a59af32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f0268fbe027eb209379a258cc5a19ff", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "なんか……あの……\nマダラさんと亥吹の……なんか……\nなんかが……なんかがあると……嬉しいんですが………\n\nなんか………なんか……\n助けてください……命を……(断っていただいて構いません)", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/14", "thumbnail_src": "https://si.imgix.net/d20eda1a/uploads/origins/09492856-496e-4291-81db-ef9c5366ca79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8be7f5fdf6b825eac75966d946e86190", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "またしてもご依頼に来ました\nフラトリ自陣のもちもちを描いて欲しいです～！\n\nhttps://www.dropbox.com/scl/fo/ex1z2cbr52opsxv3q89bf/AGpVlXZhla73cDBC47rV4Ew?rlkey=52efkesh6ie77n17h9fd925pn&st=9v74zs9r&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/13", "thumbnail_src": "https://si.imgix.net/e39766ac/uploads/origins/6e7d9c08-d7eb-40d3-a1f3-37fe8c1529c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4049407f4b3b49a67f5900e711e90985", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "はい。さんのもちもちのファンです～！\n資料リンク内にあるお好きなキャラをもちもちにしてもらえると嬉しいです！\n※どいつでもうれしゅうございます　なにとぞ・・・\n\nhttps://www.dropbox.com/scl/fo/vplhbj8nc8g92qkwisywi/AEvDEh4mxJY3BUsT0wQ02II?rlkey=itwunqhl6f8htf1irmxazmx03&st=9dsgmk4h&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/12", "thumbnail_src": "https://si.imgix.net/ef98741c/uploads/origins/6ee349e2-2ac8-49d5-8eee-59984d71b54f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a44e2e396522b34f0e80e069a2a21991", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/11", "thumbnail_src": "https://si.imgix.net/8f87360c/uploads/origins/8305d432-2841-4f1e-9444-c9e5ead81604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=627f336b7a7bd0f686382f9e4c4203c6", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは\nリクエスト失礼します\nオリキャラの依頼になりますので、もしNGでしたらすみません\n\n■概要\nキャラ：うちの子\n名前：細石ひわ(ヒワ=サザレ)\n参考イラスト→(https://gyazo.com/935cbd013e73164b5e6078bfd005a5c9)、(https://gyazo.com/fa4aa83b443fd026034075aad4fe76b3)\n※依頼の際の参考資料として利用する許可はいただいております\n髪：氷イメージの水色ロングヘア\n髪型：ローポニー\n瞳：淡めの紫色\n体格：160cmで華奢(そこそこ胸はあるが、サラシで隠せるレベル)\n衣装：男装(黒色メイン)\n背景：路地裏(可能なら。なくてもよいです)\n設定(参考までに)：過去に男装して男子グループへの潜入任務を行ったが、危うくバレそうになったので、それ以来たまに男装して男子として振る舞う練習をするようになった\n\n■依頼詳細\n　うちの子ひわが、黒を基調とした目立ちにくい男装をして壁に寄りかかっているイラストをお願いします(男装は現代衣装でもファンタジー衣装でもどちらでも構いません)\n　性格的には決して強気な子ではなく顔立ちも可愛らしい系なのですが、経緯的に真剣に男装をしており、キャップを深く被って少しでも可愛らしい顔立ちを隠そうと努力しています(目元にキャップの影を作ってください。ただし目そのものは隠さないでください)\n　表情も笑顔ではなく真剣でキリッとした感じです(顔立ちの可愛らしさは強めに残してください)\n　また、どちらか片方の腕にだけ赤い宝石の腕輪をつけてください。腕が映らない場合は首輪や髪飾りでも良いので、どこかに１つだけ赤い宝石を必ず映してください\n　その他書いていない部分はお任せします\n\nご縁がありましたら嬉しいです\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/10", "thumbnail_src": "https://si.imgix.net/a8aa3d7b/uploads/origins/9e3f8348-91f9-40fc-b937-58ffa75b4292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf94092dcafd1511170d1f7f12f683c", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "お世話になってます！無糖紅茶です！\n\n▼依頼内容\n「NOBODY*2/Repli;C∀」と「トライアングルージュ」と「DUR:夢術師たちのララステス」の自陣のイラスト。\n前回と同じような感じで、モノクロ落書きの詰め合わせと(余裕があれば)漫画が欲しいです…！\n\n▼入れて欲しいやつ\n無糖紅茶の探索者が入っていればなんでもいいです！あと七夕先生とゆかりくんの落書きも欲しい♡耐えられなかったら描かなくても大丈夫です(？)\n\n以上、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/9", "thumbnail_src": "https://si.imgix.net/f1db1a04/uploads/origins/5a29ad7c-3f1b-427c-9bc8-460d0a986cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b7ed625a676aeb33140e3e680d148fa", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "とらぐる、もしくは家族の国自陣の落書きおなしゃす！！\nNPCでも可", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/8", "thumbnail_src": "https://si.imgix.net/c84e2140/uploads/origins/4bf674ee-8285-4df0-820f-0c48dfb171aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72f640430a04b36c4a6912eb2bab312a", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/7", "thumbnail_src": "https://si.imgix.net/92a291f6/uploads/origins/8ef6d9a3-38c0-4f8e-ba2f-8b56fd859dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=847a6148156a697b1d43c464a9d5ca82", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "こんばんは！探索者の漫画を描いてくださると聞いて駆けつけたすなです！！！！\n梧寓宮乙女さんと八ツ屋マダラさん、時々間宮京桐のギャグ漫画をお願いしたく参りました！！！！\n公式スピンオフでweb連載されてるタイプの間宮組が見たいです！！！！うそ、もう与えてもらえるならなんでもいい。\nよろしくお願いします！！！！！！！！！！！！", "created_at": "", "completed_at": ""}, {"path": "/@oreore___ore/works/6", "thumbnail_src": "https://si.imgix.net/eded25dc/uploads/origins/7de574c0-5036-487d-80fd-db749a312979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%