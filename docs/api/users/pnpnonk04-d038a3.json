-2f4c-4658-8fe2-1d63568b6ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16240c03cb77e789dec48d331fbaf3da 2x, https://si.imgix.net/0ff1a00e/uploads/origins/655593ed-2f4c-4658-8fe2-1d63568b6ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=014fb7210f7e4a06f09eadf07e73116f 3x", "genre": "art", "nsfw": false, "body": "初めまして、リクエスト差し上げます。\n東方Projectのレミリアお嬢様がロックマンXシリーズに出てくるようなレプリロイドになったイラストをお願いします。\nお顔や髪型等、頭部は元の彼女のままで、身体のコスチューム（アーマー）のデザインはロックマンXコマンドミッションのナナをベースにレミリアらしいアレンジを加えた感じで、頭にはいつも彼女が被っているナイトキャップの代わりに、ナビゲーターっぽいヘッドセットを付けてください。\nロボっぽい感じが欲しいので、胸の部分のアーマーのどこかに彼女の身体の状態が表示されているディスプレイを付けていただければと思います。\n体型は小柄でもセクシーな感じで、全体的にお嬢様らしく可愛らしい雰囲気でお願いします。\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pnpnonk04/works/100", "thumbnail_src": "https://si.imgix.net/504f6a17/uploads/origins/ff7e6f66-1f57-475f-aad7-c8d19c5aa399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23172a28c0352e1281658d4de9aae9b1", "thumbnail_srcset": "https://si.imgix.net/504f6a17/uploads/origins/ff7e6f66-1f57-475f-aad7-c8d19c5aa399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23172a28c0352e1281658d4de9aae9b1, https://si.imgix.net/504f6a17/uploads/origins/ff7e6f66-1f57-475f-aad7-c8d19c5aa399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d93ecf60b82cafd94174818344a3bfeb 2x, https://si.imgix.net/504f6a17/uploads/origins/ff7e6f66-1f57-475f-aad7-c8d19c5aa399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94d94190d2b4acff9a246ebf660d543f 3x", "ge