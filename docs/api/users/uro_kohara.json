します。\n・下着なし。つまり裸にブラウスのみとなります。\n・先に挙げた候補の下着の中から、異なるデザインもしくは色のもの。\n\n以上、毎回細かく記載してしまいすみませんが、\nもしよければお願いします……！\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%a4%a5%d9%a5%ea%a5%b9", "created_at": "", "completed_at": ""}, {"path": "/@uro_kohara/works/28", "thumbnail_src": "https://si.imgix.net/21512b08/uploads/origins/98a6a6f8-2726-4a3b-ba81-45d545bc6ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebfa807f59e6cdaca906060f71b85ea1", "thumbnail_srcset": "https://si.imgix.net/21512b08/uploads/origins/98a6a6f8-2726-4a3b-ba81-45d545bc6ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebfa807f59e6cdaca906060f71b85ea1, https://si.imgix.net/21512b08/uploads/origins/98a6a6f8-2726-4a3b-ba81-45d545bc6ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f81e20a31a6e4a43f0efc09804a51567 2x, https://si.imgix.net/21512b08/uploads/origins/98a6a6f8-2726-4a3b-ba81-45d545bc6ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43ab8ef3d889c83aa959b97358f1dc6d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uro_kohara/works/27", "thumbnail_src": "https://si.imgix.net/55f33cc3/uploads/origins/dc2d33ab-0efc-4520-a28d-8a12c4623b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86317324bbc4b1d03f7f07f18fabe5c2", "thumbnail_srcset": "https://si.imgix.net/55f33cc3/uploads/origins/dc2d33ab-0efc-4520-a28d-8a12c4623b50?bg=%23fff&auto=format%2Ccompress&fm