f7-49ca-89e3-a5992711f4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa54ef4e1a30ff8b2986e29b77d7c0e1", "thumbnail_srcset": "https://si.imgix.net/087deba7/uploads/origins/9695a458-5ef7-49ca-89e3-a5992711f4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa54ef4e1a30ff8b2986e29b77d7c0e1, https://si.imgix.net/087deba7/uploads/origins/9695a458-5ef7-49ca-89e3-a5992711f4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67930eaa24fff0ca5acb251e97a69326 2x, https://si.imgix.net/087deba7/uploads/origins/9695a458-5ef7-49ca-89e3-a5992711f4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=773a9541072421245d5289fc6cda359e 3x", "genre": "art", "nsfw": true, "body": "あすぱると様へ。\nあすぱると様のデカいめたんちゃんを拝見し依頼したく思いリクエストを送らせて頂きました。\n以下に内容を記載しますので確認お願い致します。\n\n・リクエスト\n衣装をキッチリ着込んだ爆乳めたんちゃんが男性と恋人繋ぎをしながらスカートで挿入部分を隠した状態でぺたん座りの騎乗位をしているのを斜めもしくは横から。\n挿入して座っているだけで動かず、とんでもない名器で男性を大量射精させて搾り取っている状態。\n情けなく蕩けて周囲に溢れるほど射精し続ける男性とそれを優しげな微笑みで見下ろすめたんちゃん、というシチュエーションをお願いします。\n\n※可能であれば全裸バージョンもお願いします。\n\n以上をお願いいたします。\nお忙しい中恐れ入りますがご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/37", "thumbnail_src": "https://si.imgix.net/ef2cf3f1/uploads/origins/37ea9edf-27d3-4f1b-902e-d2ad158cf407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25fdc9a8adca23d9c373e93ccbc54aa5", "thumbnail_srcset": "https://si.imgix.net/ef2cf3f1/uploads/origins/37ea9edf-27d3-4f1b-902e-d2ad158cf407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25fdc9a8adca23d9c373e93ccbc54aa5, https://si.imgix.net/ef2cf3f1/uploads/origins/37ea9edf-27d3-4f1b-902e-d2ad158cf407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44adc0158c9d98ff0248c598dc39924e 2x, https://si.imgix.net/ef2cf3f1/uploads/origins/37ea9edf-27d3-4f1b-902e-d2ad158cf407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73f0bc761a53043d23b0a5f8a9307a8c 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n前回は素敵なイラストをありがとうございます。\n是非うちの子のイラストを描いて頂ければと思い、依頼をさせて頂きました。\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願い申し上げます。\n\n＜依頼内容＞\n◆キャラ\nオリキャラ：黒ちゃん(仮名)\n※参考画像\nhttps://x.com/magunamu06060/status/1949293676397789334\n\n◆コスチューム\n資料の衣装でお願い致します。\n細かい部分は描きやすいように自由にアレンジして頂いて構いません。\n\nうちの子のポイントだと考えている、\n長くて柔らかそうな大きいおっぱいをアピールしたイラストを描いていただけると嬉しいです。\n\n細かな部分はお任せ致しますので、ご検討宜しくお願い致します。\nまた金額的に問題がなければ、NSFW差分もご用意くださると嬉しいです。\n\n◆使用方法\nTwitterアイコンや動画、生放送のサムネなどでの使用を想定しております。\n\n◆その他\n可能であれば、人物と背景、宛名が分かれているPSDデータでの納品を頂けると助かります。\n\nhttps://x.com/magunamu06060/status/1949293676397789334", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/36", "thumbnail_src": "https://si.imgix.net/c9b12b42/uploads/origins/30ad680b-f3ec-42f9-9eb2-99130e37263e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f903e5fbb0071838f4ed96b67aeb799c", "thumbnail_srcset": "https://si.imgix.net/c9b12b42/uploads/origins/30ad680b-f3ec-42f9-9eb2-99130e37263e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f903e5fbb0071838f4ed96b67aeb799c, https://si.imgix.net/c9b12b42/uploads/origins/30ad680b-f3ec-42f9-9eb2-99130e37263e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2a22c628c7bd378cb97fa8e67175ad2 2x, https://si.imgix.net/c9b12b42/uploads/origins/30ad680b-f3ec-42f9-9eb2-99130e37263e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a821a775d08077c6faf60de493e79bd 3x", "genre": "art", "nsfw": true, "body": "「マスターに押し倒されて犯される結月ゆかり」のイラストを、\n「長時間犯されて精液まみれになっている、抵抗はしているが、マスターのことは悪く思っていなかったので、形ばかりの抵抗になっている」というシチュエーションでお願いします。\n着衣は完全に裸ではなく、着ていたものがまくりあげられる・破かれるなどの感じでお願いします。\n体位・背景など、記載のない内容についてはお任せします。\n可能であれば、中出しされている差分をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/35", "thumbnail_src": "https://si.imgix.net/fd6ba12e/uploads/origins/f4863b40-8c27-400a-abe7-eabc328d31b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d69946418202b56ebe5714e30c07e9f", "thumbnail_srcset": "https://si.imgix.net/fd6ba12e/uploads/origins/f4863b40-8c27-400a-abe7-eabc328d31b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d69946418202b56ebe5714e30c07e9f, https://si.imgix.net/fd6ba12e/uploads/origins/f4863b40-8c27-400a-abe7-eabc328d31b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e5413d201673900ed719bb9f4559b52 2x, https://si.imgix.net/fd6ba12e/uploads/origins/f4863b40-8c27-400a-abe7-eabc328d31b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14929e81b11c5f7de51b21c7c5cd3406 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n前回も素敵なゆかりさんと葵ちゃん、茜ちゃんをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\nふたなり結月ゆかりに媚薬を盛って分からせられる琴葉葵を描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\nゆかりさんに媚薬を盛った所為で、朝まで犯されてボテ腹にされる葵ちゃんと、\n理性を失って尚も葵ちゃんを犯し続けるゆかりさん。\nゆかりさんに丸一日犯され続けて、更に精液を詰め込まれて受精自覚する葵ちゃん。\n\n■要望\n・葵ちゃんはハート目、精液塗れ\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/34", "thumbnail_src": "https://si.imgix.net/a3f50725/uploads/origins/b43d7392-bb45-456e-b728-8fd75a913a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07992506e3bb8c1c4507174b4f73c959", "thumbnail_srcset": "https://si.imgix.net/a3f50725/uploads/origins/b43d7392-bb45-456e-b728-8fd75a913a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07992506e3bb8c1c4507174b4f73c959, https://si.imgix.net/a3f50725/uploads/origins/b43d7392-bb45-456e-b728-8fd75a913a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=757f00f6ffe1a4a798141387677536fd 2x, https://si.imgix.net/a3f50725/uploads/origins/b43d7392-bb45-456e-b728-8fd75a913a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c36d0cf10da21c846b58bce9c4ef8b28 3x", "genre": "art", "nsfw": false, "body": "【本文】いつも素敵なイラストを拝見させていただいております。あすぱるとさんに是非お願いしたいと思いました。\n\n【依頼内容】あすぱるとさんのところの「亜角パルマ」ちゃんとでらさん（https://x.com/derasan3）のアバター「でらさん」の『衣装交換』をしたイラストをご依頼したいです。\n構図等に関してはほぼお任せになりますが、パルマちゃんのとあるお胸が大きいので多分でらさんの服のシャツのボタンが吹き飛んでると思うので可能でしたらお願いします。\n\n【用途】ファンアートとしてそういう絵が見たいと思いました。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/33", "thumbnail_src": "https://si.imgix.net/27a36441/uploads/origins/7d879ce1-f415-43b7-bbf0-5d40b0a13311?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815b883d25cb45e286bbf48ab4e00a8a", "thumbnail_srcset": "https://si.imgix.net/27a36441/uploads/origins/7d879ce1-f415-43b7-bbf0-5d40b0a13311?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815b883d25cb45e286bbf48ab4e00a8a, https://si.imgix.net/27a36441/uploads/origins/7d879ce1-f415-43b7-bbf0-5d40b0a13311?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07da32b190ef81dd57fdaa865400625e 2x, https://si.imgix.net/27a36441/uploads/origins/7d879ce1-f415-43b7-bbf0-5d40b0a13311?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=113251ce9fc7375b75b485a6d66eb58c 3x", "genre": "art", "nsfw": true, "body": "こんにちは、募集再開お待ちしておりました。\n下着姿の紲星あかりちゃんがずらしハメの正常位でマスターとエッチするイラストをお願いします。\n可能でしたら、全裸差分とアナルセックスの差分をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/32", "thumbnail_src": "https://si.imgix.net/d24027f3/uploads/origins/460eaeb5-5ef6-4a82-8a21-0cc976f4e449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b32eaf240098ac7e5d2237f7afa5467", "thumbnail_srcset": "https://si.imgix.net/d24027f3/uploads/origins/460eaeb5-5ef6-4a82-8a21-0cc976f4e449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b32eaf240098ac7e5d2237f7afa5467, https://si.imgix.net/d24027f3/uploads/origins/460eaeb5-5ef6-4a82-8a21-0cc976f4e449?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4d2af58e47d54281b6ff22dadcc16de 2x, https://si.imgix.net/d24027f3/uploads/origins/460eaeb5-5ef6-4a82-8a21-0cc976f4e449?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45c6e5474b59dcf1d124862cd3375988 3x", "genre": "art", "nsfw": true, "body": "始めましていつも絵を見させていただいてとてもえっちで可愛らしく好きなので依頼させていただきました\n\nキャラクター\nふたなりな紲星あかりちゃんと弦巻マキちゃん\n\nシチュエーション\nマキちゃんにキスされながらあかりちゃんのをしごかれ感じているシチュをお願いします\n\n服装\n指定出来るのであれば紲星あかりちゃんの衣装をボイロ6衣装でお願いします\n\n以上です残りはおまかせします\nよろしくお願いします\n\nhttps://www.ssw.co.jp/products/vocaloid6/kizunaakari/illust.html", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/31", "thumbnail_src": "https://si.imgix.net/43eee618/uploads/origins/e05baa6f-8ab4-4fef-9088-b6c30e34cfca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffc559d7fdf153b6f106d497dc7a019a", "thumbnail_srcset": "https://si.imgix.net/43eee618/uploads/origins/e05baa6f-8ab4-4fef-9088-b6c30e34cfca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffc559d7fdf153b6f106d497dc7a019a, https://si.imgix.net/43eee618/uploads/origins/e05baa6f-8ab4-4fef-9088-b6c30e34cfca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ebb0204d310b11b46d864a208de7a2f 2x, https://si.imgix.net/43eee618/uploads/origins/e05baa6f-8ab4-4fef-9088-b6c30e34cfca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=350f44b3bd3e019983357b38c1405796 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/30", "thumbnail_src": "https://si.imgix.net/b0f79ddf/uploads/origins/fbd9c51d-928a-4db9-9bbf-88797e29c805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9f58bb2afee7710ec2141e89d095d8", "thumbnail_srcset": "https://si.imgix.net/b0f79ddf/uploads/origins/fbd9c51d-928a-4db9-9bbf-88797e29c805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9f58bb2afee7710ec2141e89d095d8, https://si.imgix.net/b0f79ddf/uploads/origins/fbd9c51d-928a-4db9-9bbf-88797e29c805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42039e2ea16aaec65372e62db4ea8c89 2x, https://si.imgix.net/b0f79ddf/uploads/origins/fbd9c51d-928a-4db9-9bbf-88797e29c805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d811f48021207c8b6c8650722df2e093 3x", "genre": "comic", "nsfw": true, "body": "いつもお世話になっております。\n前回も素敵な葵ちゃんとゆかりさんのイラストをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\nふたなり結月ゆかりを押し倒して騎乗位で搾り取る琴葉葵を描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵、琴葉茜\n\n■キャラ背景(台詞の参考になれば)\n結月ゆかり：葵ちゃんの恋人。ふたなり。\n　　　　　　誘われたら断れない程度に茜ちゃんも好き。\n琴葉葵　　：ゆかりさんの恋人。\n　　　　　　姉もゆかりさんも好きだが、先を越されるのはイヤ。\n琴葉茜　　：妹もゆかりさんも好き。\n　　　　　　普段は恋人関係の二人を立てるが、性欲が我慢できず誘ってしまった。\n\n■シチュエーション\nボテ腹の姉を発見したことをゆかりさんに問いつめると、\n姉からの誘いを断らなかったことが判明し、\n「私がゆかりさんの彼女なのに」と怒ってゆかりさんを押し倒す葵ちゃん。\n姉よりも先に孕まされたい欲からゆかりさんを騎乗位で搾り取り、\n何度も射精されて、ボテ腹の状態で受精自覚する葵ちゃん。\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/29", "thumbnail_src": "https://si.imgix.net/bd8fdea9/uploads/origins/d5753fe8-8442-4d81-9576-44fb34a27782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ba6d2412d3c292f6d8f5d43fc23893b", "thumbnail_srcset": "https://si.imgix.net/bd8fdea9/uploads/origins/d5753fe8-8442-4d81-9576-44fb34a27782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ba6d2412d3c292f6d8f5d43fc23893b, https://si.imgix.net/bd8fdea9/uploads/origins/d5753fe8-8442-4d81-9576-44fb34a27782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96bb55baaeef705e9327b23f60171ded 2x, https://si.imgix.net/bd8fdea9/uploads/origins/d5753fe8-8442-4d81-9576-44fb34a27782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7759e7559216720be4f0be042d2e4a52 3x", "genre": "art", "nsfw": true, "body": "先日は納品ありがとうございました、またリクエスト失礼いたします。\n\nシチュエーション\nノリノリでバニーガール衣装を着てくれるウナちゃんと手コキで搾られるふたなりきりたん\n\nその他\n・ウナちゃんは終始ノリノリで、つい竿が反応しちゃったきりたんの竿を慰めてくれる\n・きりたんはウナちゃんが内心好きで竿が反応＆慰めてくれる流れになってどぎまぎしてる\n・もし可能であれば射精シーンと、射精してもまだ収まってなくてまだまだ続く雰囲気のシーンをいただけると嬉しいです\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/28", "thumbnail_src": "https://si.imgix.net/2b88505d/uploads/origins/aebf7c39-caee-46b2-8241-09ea810a10c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db09ce01912aeaf958706090e2f6706", "thumbnail_srcset": "https://si.imgix.net/2b88505d/uploads/origins/aebf7c39-caee-46b2-8241-09ea810a10c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db09ce01912aeaf958706090e2f6706, https://si.imgix.net/2b88505d/uploads/origins/aebf7c39-caee-46b2-8241-09ea810a10c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2399609ec1d6720f81fa4c0da563e5b6 2x, https://si.imgix.net/2b88505d/uploads/origins/aebf7c39-caee-46b2-8241-09ea810a10c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22a143ccf9886702240d2fbfa5c08c1b 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n早速ですが依頼いたします。\n\n・キャラ：京町セイカ\n・裸または下着にぶかぶかのYシャツだけを着ている\n・こちらを見て微笑んでいる\n・部屋に座って、温かい飲み物を持っている\n・時間は朝っぽい感じ\n\nその他詳細は全てお任せします。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/27", "thumbnail_src": "https://si.imgix.net/d73bc625/uploads/origins/c9b0bcb7-44b9-4bf2-ad77-39a70556ea53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14983d853f7fcae36611a4a21b86c492", "thumbnail_srcset": "https://si.imgix.net/d73bc625/uploads/origins/c9b0bcb7-44b9-4bf2-ad77-39a70556ea53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14983d853f7fcae36611a4a21b86c492, https://si.imgix.net/d73bc625/uploads/origins/c9b0bcb7-44b9-4bf2-ad77-39a70556ea53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc0adc7203647c0e54c9e6b84d913acd 2x, https://si.imgix.net/d73bc625/uploads/origins/c9b0bcb7-44b9-4bf2-ad77-39a70556ea53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edd877e174e056badf968db29408c99f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/26", "thumbnail_src": "https://si.imgix.net/b7507cfe/uploads/origins/056dab16-7715-4495-ab02-bf6f5b8b3f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=887e61cd503ca7679acc74ae18cc06d5", "thumbnail_srcset": "https://si.imgix.net/b7507cfe/uploads/origins/056dab16-7715-4495-ab02-bf6f5b8b3f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=887e61cd503ca7679acc74ae18cc06d5, https://si.imgix.net/b7507cfe/uploads/origins/056dab16-7715-4495-ab02-bf6f5b8b3f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edc100cd7fae554be336c253e8fc09db 2x, https://si.imgix.net/b7507cfe/uploads/origins/056dab16-7715-4495-ab02-bf6f5b8b3f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07b6d5fa3ae6e52363f0d580af26d4b4 3x", "genre": "art", "nsfw": true, "body": "先日は脱衣麻雀のリクエスト絵ありがとうございました。\n\n今回は\n識白シルク(https://x.com/sirusira/status/1658072224950272005)嬢と\n胡狼あき(https://x.com/jokaaki/status/1740663457085882637)嬢が\n向かい合っておふざけで胸の揉み合いをしているうちに\nだんだん欲情(発情)していって…みたいな感じの展開のイラストをお願いしたいです。\n\n前回同様に衣装の脱衣着衣、表情差分やセリフ差分等すべてお任せします。\n\n展開に悩まれましたら以下の展開を参考願います\n識白シルク「あきちゃん大きいね～」\n↓\n胡狼あき「シルクちゃんだって大きいじゃないか～」\n↓\n揉み合い\nどちらもお胸が大きい子なのでそれを強調する感じで\n↓\nどっちかが感じてビクッとする。\nそうなった方が受け側になりますが、\n可能でしたら差分でどっちが攻めでも行けるようにしてくれると助かります。\n↓\n揉む手つきが変わって雰囲気も変わる\n↓\n脱がすなどしつつ…蕩けた表情で見つめ合ったりとかいろいろ\n（口づけを交わしたと思わせるような唾液の橋差分もあるとなおいいです）\n(脱がすなど)", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/25", "thumbnail_src": "https://si.imgix.net/5b7c7699/uploads/origins/17edda66-b525-48c3-82c3-f39ee76323cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2373b77bd6e87aeb5dacebe963e2068c", "thumbnail_srcset": "https://si.imgix.net/5b7c7699/uploads/origins/17edda66-b525-48c3-82c3-f39ee76323cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2373b77bd6e87aeb5dacebe963e2068c, https://si.imgix.net/5b7c7699/uploads/origins/17edda66-b525-48c3-82c3-f39ee76323cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22688564676f939c627660dd87a1d6ec 2x, https://si.imgix.net/5b7c7699/uploads/origins/17edda66-b525-48c3-82c3-f39ee76323cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39578ae925938f23bf97b2d4bd1f2be4 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n前回も素敵な葵ちゃんとゆかりさんのイラストをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\nふたなり結月ゆかりにお仕置きックスされる琴葉葵を描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\nここ数日仕事の疲労でそのまま寝ていたが、起床しても全然疲労が取れておらず、\nその原因が葵ちゃんに搾り取られていたのだと気付いてお仕置きックスするゆかりさん。\nゆかりさんに何度も射精されてイかされ、イっている報告しても「お仕置きなので」と止めてもらえない葵ちゃん。\n\n■要望\n・射精されてボテ腹になる葵ちゃん\n・ずっとイかされ続けた所為で声を出す気力もない葵ちゃん\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/24", "thumbnail_src": "https://si.imgix.net/2df39557/uploads/origins/fd480007-d3dc-42b2-a697-06206cde93ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3f4ced79e2b2c7edfe6e6b758029c4", "thumbnail_srcset": "https://si.imgix.net/2df39557/uploads/origins/fd480007-d3dc-42b2-a697-06206cde93ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3f4ced79e2b2c7edfe6e6b758029c4, https://si.imgix.net/2df39557/uploads/origins/fd480007-d3dc-42b2-a697-06206cde93ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9946a063a09e165213178df37e9660b 2x, https://si.imgix.net/2df39557/uploads/origins/fd480007-d3dc-42b2-a697-06206cde93ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33db7db9bcffa5974c24fb6319b2bf1c 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼します。\n\nシチュエーション\nさとうささらにパイズリされて快楽にとろけちゃうふたなり東北きりたん\n\n詳細\n・ささらはバニーガール衣装、ちょっとSっ気のある顔でニヤニヤしてる感じ\n（TLでお見かけしたバニーささらちゃんがグッと来たもので・・・）\n・きりたんは公式衣装の着物がはだけた状態、快楽にとろけた顔、貧乳\n（魅力的なお姉さんにエッチなことされてとろけちゃう性知識の少ない子の雰囲気）\n・可能であれば射精差分があると嬉しいです\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/23", "thumbnail_src": "https://si.imgix.net/3d8c6569/uploads/origins/38413a0b-5097-4f7b-a221-00b89570b7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ef3da8d4bbe3c12671510088f15ed4", "thumbnail_srcset": "https://si.imgix.net/3d8c6569/uploads/origins/38413a0b-5097-4f7b-a221-00b89570b7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ef3da8d4bbe3c12671510088f15ed4, https://si.imgix.net/3d8c6569/uploads/origins/38413a0b-5097-4f7b-a221-00b89570b7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a907802a802b064ffa86d0c46c5ac19 2x, https://si.imgix.net/3d8c6569/uploads/origins/38413a0b-5097-4f7b-a221-00b89570b7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef31c3266f10165bfa5ae9796b44cf2e 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\n\n■概要\nキャラ：琴葉葵\n体型：長乳(かなりの巨乳)\n髪型：ショート\n衣装：お任せします\n場所：家の中またはひとけのない屋外\n\n■依頼詳細\n「さっき、他の子にデレデレしてましたよね」という感じでむすっとしている葵ちゃんに、お仕置きとばかりに無理やり襲われちゃうイラストをお願いします\n襲われる側はマスターでも他のトークソフトキャラでも構いませんが、男性またはふたなりで徹底的に搾り取られる感じでお願いします(※逆転なし)\n男性マスターの場合は目元は映さないか影などで隠し葵ちゃんのセリフのみで、その他の場合はお任せします\n効果音多めだと嬉しいです\nセリフは変更歓迎です\n\n■補足\nイメージとしては襲われた側も言うほどデレデレしてはいない(ショート葵ちゃんが独占欲強くて可愛い)というシチュエーションを想定しています\nまた、バストサイズは以下のイラストの大きい方と同じかそれ以上の大きさ希望です\nhttps://www.pixiv.net/artworks/101765393\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/22", "thumbnail_src": "https://si.imgix.net/6db7c92d/uploads/origins/b4d2bea1-e21a-4c7b-b5b7-68f7eca43010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed7c7359a9c70c4e0ab7893b8156c526", "thumbnail_srcset": "https://si.imgix.net/6db7c92d/uploads/origins/b4d2bea1-e21a-4c7b-b5b7-68f7eca43010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed7c7359a9c70c4e0ab7893b8156c526, https://si.imgix.net/6db7c92d/uploads/origins/b4d2bea1-e21a-4c7b-b5b7-68f7eca43010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaa1b6e8353c5139af5163c3e453b60e 2x, https://si.imgix.net/6db7c92d/uploads/origins/b4d2bea1-e21a-4c7b-b5b7-68f7eca43010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06b1771ede3d4a436555e69cc422f21e 3x", "genre": "art", "nsfw": true, "body": "シルシラさんが先日麻雀大会でハコにされたとのことでして、\n（参考URL：https://twitter.com/sirusira/status/1726623426847383901）\nシルシラさんのところの看板娘「識白シルク」嬢が脱衣麻雀で脱衣する絵をお願いしたいです。\n差分枚数、ポーズ等は完全にお任せします。\n脱衣麻雀ゲームの脱衣ムービーシーン風でお願いします。\n\nあまり脱衣麻雀をご存じないと配信の方でおっしゃられていたので\n適当に他所で書きなぐった駄文を添付しておきますので\nイメージの参考になれば幸いです。\n\n↓\n「どんだけ見たいのよもー…」\n心底あきれたような表情を浮かべ、識白シルクは挑戦者を睨む。\n挑発のつもりで先にブラジャーを中脱ぎしたことで\nかえって勢い付いた挑戦者に連続で和了を許す事態となってしまい、\n彼女は今パンツとシャツのみを残す姿となっていた。\nその状態で、挑戦者が和了したのだ。\n当然次に脱ぐことになるのは、パンツかシャツのいずれかとなる。\n「仕方ないわね…」\n長い溜息をついた後、観念した彼女はシャツをゆっくりと…\n\n以上です、なにとぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/21", "thumbnail_src": "https://si.imgix.net/0361387c/uploads/origins/93b3a50f-4915-45ad-87ba-611a2521c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b65559c16bfa0039a4842b098a6dca", "thumbnail_srcset": "https://si.imgix.net/0361387c/uploads/origins/93b3a50f-4915-45ad-87ba-611a2521c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b65559c16bfa0039a4842b098a6dca, https://si.imgix.net/0361387c/uploads/origins/93b3a50f-4915-45ad-87ba-611a2521c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=529470bf4933af23784788b816968e16 2x, https://si.imgix.net/0361387c/uploads/origins/93b3a50f-4915-45ad-87ba-611a2521c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cf60e2fabd7682b5aedb797172cd2f2 3x", "genre": "art", "nsfw": true, "body": "前回も素敵なゆかりさんと葵ちゃんのイラストをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\nセックスしないと出られない部屋に閉じ込められて、\n先に攻める琴葉葵と、反撃するふたなり結月ゆかりを描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■シチュエーション\nセックスしないと出られない部屋に閉じ込められたゆかりさんと葵ちゃん。\n即座にゆかりさんを押し倒して、騎乗位で攻める葵ちゃん。\n最初は葵ちゃんにされるがままだったが、\n開き直って自分から攻め始め、射精するゆかりさん。\n\n■要望\n・ボテ腹になるまで出されて嬉しがっている葵ちゃん\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/20", "thumbnail_src": "https://si.imgix.net/066945db/uploads/origins/d9554848-2e3f-4b0a-9985-6176f3c26bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c14d55a1bcfee33fe6d499b0d11b1fa", "thumbnail_srcset": "https://si.imgix.net/066945db/uploads/origins/d9554848-2e3f-4b0a-9985-6176f3c26bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c14d55a1bcfee33fe6d499b0d11b1fa, https://si.imgix.net/066945db/uploads/origins/d9554848-2e3f-4b0a-9985-6176f3c26bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a12363b806dd17c23188e34e98cf2828 2x, https://si.imgix.net/066945db/uploads/origins/d9554848-2e3f-4b0a-9985-6176f3c26bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=094876da2de73edf0fbc5b40bbb2a9ef 3x", "genre": "art", "nsfw": true, "body": "前回は素敵な葵ちゃんとゆかりさんのイラストをありがとうございました。\nリクエストの募集を再開したとのことでしたので、また依頼させていただきました。\n\n妊婦葵ちゃんを犯すふたなり結月ゆかりを描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■シチュエーション\nお腹が大きくなってきた葵ちゃんに気を遣って我慢していたゆかりさん。\n一方で我慢できなくなった葵ちゃんに誘惑されてしまい、我慢できずに犯すゆかりさん。\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/19", "thumbnail_src": "https://si.imgix.net/42a747cc/uploads/origins/53510114-878b-4cd1-8851-97a7a4a6bfb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b3e485bfb08a35c01831ddbf65a9c9d", "thumbnail_srcset": "https://si.imgix.net/42a747cc/uploads/origins/53510114-878b-4cd1-8851-97a7a4a6bfb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b3e485bfb08a35c01831ddbf65a9c9d, https://si.imgix.net/42a747cc/uploads/origins/53510114-878b-4cd1-8851-97a7a4a6bfb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a829138985bd40bf08ef9a46be2fa135 2x, https://si.imgix.net/42a747cc/uploads/origins/53510114-878b-4cd1-8851-97a7a4a6bfb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83651e24011e132ebbcd43a40e730d96 3x", "genre": "art", "nsfw": true, "body": "リクエストお願いします\n①\tキャラ：さとうささら、すずきつづみ\n同時が厳しければささらをメインで\n②\tモノクロ漫画\n③\tシチュ：室内で輪姦。基本的に中だしぶっかけをされ犯され続け（陵辱シーンメイン）そのまま十数人に一晩中休まずに犯され、何十回も中だしぶっかけされ、夜が明けるまで犯されるがそれでも男たちは犯したりずに犯し続け、２人は散々犯されて疲れ切った表情で男達の行為に弱弱しく反応しているという形でお願いします\n④\t希望する要素\n・二人とも腕を背中で拘束され多数の男たちに胸を揉まれながら（わしづかむように揉まれてる）、２，３穴を犯されて何度も中だしぶっかけをされる\n・男達の見た目はモブで基本的にセリフはなしか最低限（ささらとづづみを優先）\n・二人ともは終始「いや」「やめて」など終始嫌がるが犯されて感じてしまい、イかされてしまう（嫌がりながらも感じている）\n・擬音はかなり容赦なく激しめに犯している感じで\n・射精量は多めで精液まみれもかなり多めでお願いします\n・服装は二人ともシャツ１枚のみ（制服から脱がされてシャツ１枚にされている）前が開けて胸が露出\n・つづみも巨乳でささらより小さめ\n・殴るけるなどの暴力や流血表現はなし（ひたすらに犯す感じで）\n・ラストシーンは２人ならんで犯されてる状態\n\n以上、細かい希望が多いですがよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/18", "thumbnail_src": "https://si.imgix.net/169453f5/uploads/origins/ca58f7aa-49fb-4d73-8ab0-1e9ccea1b57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4354acc7c0405524ff456d42c32511", "thumbnail_srcset": "https://si.imgix.net/169453f5/uploads/origins/ca58f7aa-49fb-4d73-8ab0-1e9ccea1b57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4354acc7c0405524ff456d42c32511, https://si.imgix.net/169453f5/uploads/origins/ca58f7aa-49fb-4d73-8ab0-1e9ccea1b57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe25de9c357a1a471b5a6c20a4c3caf0 2x, https://si.imgix.net/169453f5/uploads/origins/ca58f7aa-49fb-4d73-8ab0-1e9ccea1b57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c370e6258980bd2b5fcf0e1dc89ab6b7 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n私の趣味趣向を詰めた、初めてのオリキャラを考えたので、\nあすぱるとさんの絵柄で見てみたいと思い、依頼させていただきました。\n\n＜依頼内容＞\n◆キャラ\nオリキャラ：黒ちゃん(仮名)\n※参考画像\nhttps://twitter.com/magunamu06060/status/1632398114597502976?s=20\nhttps://twitter.com/magunamu06060/status/1643124627890388994?s=20\nhttps://twitter.com/magunamu06060/status/1646923259475292161?s=20\n\n表情や雰囲気、シチュエーションなどはあすぱるとさんが思う\nこのキャラに合う内容で問題ございません。\nただ、大きいお胸verと普通のお胸verの2つをご用意頂けると助かります。\n\n大雑把な依頼となって申し訳ございませんが、お引き受け頂けると嬉しいです。\n宜しくお願いいたします。\n\nhttps://twitter.com/magunamu06060/status/1632398114597502976?s=20", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/17", "thumbnail_src": "https://si.imgix.net/b8274329/uploads/origins/f137a73e-9c68-4ac6-9515-2d3296afc996?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=243a7452b8b8761bde7188c6f8bf5f82", "thumbnail_srcset": "https://si.imgix.net/b8274329/uploads/origins/f137a73e-9c68-4ac6-9515-2d3296afc996?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=243a7452b8b8761bde7188c6f8bf5f82, https://si.imgix.net/b8274329/uploads/origins/f137a73e-9c68-4ac6-9515-2d3296afc996?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=697d393599fbf9af1081a56c17c8a818 2x, https://si.imgix.net/b8274329/uploads/origins/f137a73e-9c68-4ac6-9515-2d3296afc996?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d98afe705b1c380a766b1991e521c093 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/16", "thumbnail_src": "https://si.imgix.net/2fc15815/uploads/origins/19a9cd60-8dd4-4f7a-bf98-61e4e08d2b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0336817032836908d5c9914c34ce5540", "thumbnail_srcset": "https://si.imgix.net/2fc15815/uploads/origins/19a9cd60-8dd4-4f7a-bf98-61e4e08d2b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0336817032836908d5c9914c34ce5540, https://si.imgix.net/2fc15815/uploads/origins/19a9cd60-8dd4-4f7a-bf98-61e4e08d2b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fa4c61e6650dffb719a08b2de5f3f09 2x, https://si.imgix.net/2fc15815/uploads/origins/19a9cd60-8dd4-4f7a-bf98-61e4e08d2b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=890581a4c19f99c9e168d4d9dcad1b66 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nいつも素敵なイラストを見させていただいております。\n投稿されたイラストを見て、\n内容がとても好みでしたので依頼させていただきました。\n\nゆかりさんの胸を揉む琴葉葵と、\n反撃に葵ちゃんに挿入して射精するふたなり結月ゆかりのイラストを描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\nゆかりさんがイかされたまま終わるのが好きじゃないのを知っていて、\nわざと胸が弱点のゆかりさんを攻めて先にイかせる葵ちゃん。\n葵ちゃんの挑発に乗って挿入するゆかりさん。\n\n■要望\n・葵ちゃんより胸が大きいゆかりさん\n・ボテ腹になるまで出されて嬉しがっている葵ちゃん\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/15", "thumbnail_src": "https://si.imgix.net/2b328874/uploads/origins/7bf069bf-fad7-4613-bc18-e5eaa0f49474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cdc33209bffb47d28f2e1e1fc020e88", "thumbnail_srcset": "https://si.imgix.net/2b328874/uploads/origins/7bf069bf-fad7-4613-bc18-e5eaa0f49474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cdc33209bffb47d28f2e1e1fc020e88, https://si.imgix.net/2b328874/uploads/origins/7bf069bf-fad7-4613-bc18-e5eaa0f49474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7128050e18bb16894e1c4a833bc662e4 2x, https://si.imgix.net/2b328874/uploads/origins/7bf069bf-fad7-4613-bc18-e5eaa0f49474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=174c1c49e0398230859fcff1aa40a8cf 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっています。\nあすぱると先生の茜ママが好きなためリクエストさせていただきます。\n\n巨乳の琴葉茜ママが、ショタのマスターにいろんなエッチを実践で教えてあげているイラストをお願いします。\n茜ママの、いくつかの体位またはポーズが見られると嬉しいです。\nよろしければ、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/14", "thumbnail_src": "https://si.imgix.net/c7926e83/uploads/origins/e0a0c022-d7d3-47b3-8c5f-1f0e0495bf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68e789221ced536ff02be8b4c17abe85", "thumbnail_srcset": "https://si.imgix.net/c7926e83/uploads/origins/e0a0c022-d7d3-47b3-8c5f-1f0e0495bf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68e789221ced536ff02be8b4c17abe85, https://si.imgix.net/c7926e83/uploads/origins/e0a0c022-d7d3-47b3-8c5f-1f0e0495bf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6abb5c1f3d9b3db761e94f84b8c307f 2x, https://si.imgix.net/c7926e83/uploads/origins/e0a0c022-d7d3-47b3-8c5f-1f0e0495bf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7debac70ea885aa02bc01fcaff34c41d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/13", "thumbnail_src": "https://si.imgix.net/fc5bf1d8/uploads/origins/90deabdd-2df9-4ebe-b964-9073bb088445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b00e895e4b8ad66774a239f2d69ccfb9", "thumbnail_srcset": "https://si.imgix.net/fc5bf1d8/uploads/origins/90deabdd-2df9-4ebe-b964-9073bb088445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b00e895e4b8ad66774a239f2d69ccfb9, https://si.imgix.net/fc5bf1d8/uploads/origins/90deabdd-2df9-4ebe-b964-9073bb088445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0d2bf9ed9b809f0126ec5331c0890dc 2x, https://si.imgix.net/fc5bf1d8/uploads/origins/90deabdd-2df9-4ebe-b964-9073bb088445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f8c44cd614f5e3d8db71009ecccb758 3x", "genre": "art", "nsfw": false, "body": "こんにちは!\n天使の日に投稿されていたミリアルさんのイラストを見ていいなと思いリクエストさせて頂きました。\n東北きりたんのイラストをお願い出来ますでしょうか。 \n胸は大きめで、服の上から膨らみや柔らかさがわかるような微えちな感じをお願いします~。", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/12", "thumbnail_src": "https://si.imgix.net/b38e3dd7/uploads/origins/316992d6-ba44-4bbb-be09-f2ead2d8ca09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fe32a2093c7cb9f4f56671b4b8f70f2", "thumbnail_srcset": "https://si.imgix.net/b38e3dd7/uploads/origins/316992d6-ba44-4bbb-be09-f2ead2d8ca09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fe32a2093c7cb9f4f56671b4b8f70f2, https://si.imgix.net/b38e3dd7/uploads/origins/316992d6-ba44-4bbb-be09-f2ead2d8ca09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c85721f9a73309039c3d77d4a6357b4a 2x, https://si.imgix.net/b38e3dd7/uploads/origins/316992d6-ba44-4bbb-be09-f2ead2d8ca09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebc2eb138bdc55eae6e820419513154e 3x", "genre": "art", "nsfw": true, "body": "他の方の依頼したWパイズリ琴葉姉妹（https://skeb.jp/@aspart929/works/8）が非常にツボに入ったので、私からもリクエストさせてください。\n\n基本的には前回の依頼者さまのご要望を踏襲しつつ、何度も何度も琴葉姉妹にパイズリで射精させられる様子を複数カット集の形式で描いていただけないでしょうか？\n（あすぱると様のhttps://skeb.jp/@aspart929/works/11のような形式です）\n巨根を持っているにも関わらず、姉妹のパイズリに抗えずされるがまま、最後は姉妹の玩具になるよう命じられ、一滴残らず絞り尽くされてしまう、というシチュエーションでお願いします。\n\nマニアックで申し訳ありませんが、私の理想に非常に近いイラストだったのでリクエストせずにはいられませんでした。\n是非ともお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/11", "thumbnail_src": "https://si.imgix.net/570fe38c/uploads/origins/b7940cf9-8892-46b4-85c3-90171fca299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46d7d879490e7cbcd20dabbc61b9d81c", "thumbnail_srcset": "https://si.imgix.net/570fe38c/uploads/origins/b7940cf9-8892-46b4-85c3-90171fca299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46d7d879490e7cbcd20dabbc61b9d81c, https://si.imgix.net/570fe38c/uploads/origins/b7940cf9-8892-46b4-85c3-90171fca299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3118ccc3717f3867f4deb2864d165327 2x, https://si.imgix.net/570fe38c/uploads/origins/b7940cf9-8892-46b4-85c3-90171fca299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22c5f936d49415dbaa35ed9ac14fb441 3x", "genre": "art", "nsfw": true, "body": "上着にyシャツ一枚で下着は白いパンツ一丁で,もじもじしながらおまたを濡らしてハート目でイエスサインを送ってきたゆかりさんをたっぷり可愛がって,二穴たくさんぱこぱこしてお腹膨らむくらい注いたあとお掃除フェラして貰って,お口に出しながら精液とおしっこたらたら流れ出すゆかりさんのおまたとおしりを眺めて達成感を味わいたいのです よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/10", "thumbnail_src": "https://si.imgix.net/fc643dd6/uploads/origins/b658409d-6b01-4744-85e4-36ec281960da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f58bb7cc504c306893fae9e903d563e", "thumbnail_srcset": "https://si.imgix.net/fc643dd6/uploads/origins/b658409d-6b01-4744-85e4-36ec281960da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f58bb7cc504c306893fae9e903d563e, https://si.imgix.net/fc643dd6/uploads/origins/b658409d-6b01-4744-85e4-36ec281960da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36135d0430975b3988e0552f1785b26a 2x, https://si.imgix.net/fc643dd6/uploads/origins/b658409d-6b01-4744-85e4-36ec281960da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab72628fbc8a68a220caf8bc0f56d0a9 3x", "genre": "art", "nsfw": true, "body": "モノクロ漫画でのリクエストになります。\n\nキャラ：琴葉葵\n服装：全裸\nシチュ：触手に拘束された状態で口に触手を入れられそのままお尻まで貫通されて悶絶", "created_at": "", "completed_at": ""}, {"path": "/@aspart929/works/9", "thumbnail_src": "https://si.imgix.net/86695016/uploads/origins/81a37d7b-a59e-4cd5-b62c-1aef4d5f8dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60ea73bc8398760b2b9b7e57042ac753", "thumbnail_srcset": "https://si.imgix.net/86695016/uploads/origins/81a37d7b-a59e-4cd5-b62c-1aef4d5f8dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60ea73bc8398760b2b9b7e57042ac753, https://si.imgix.net/86695016/uploads/origins/81a37d7b-a59e-4cd5-b62c-1aef4d5f8dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3066cab2c61762ee5e1cab34af47b57b 2x, https://si.imgix.net/86695016/uploads/origins/81a37d7b-a59e-4cd5-b62c-1aef4d5f8dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b71e712487168ba5ee31e5f300d945f 3x", "genre": "art", "nsfw": true, "body": "レーシングゆかりさんの着衣姦イラストをお願いします！\n①体位\nゆかりさんが後ろから抱かれた状態でのプレイ\nスパッツを破いて挿入\n\n②ゆかりさんの服などの状態\n・アウター\nチャックは開いている状態\n肩が片側だけはだけている程度の脱げ具合\n・ビキニ\n紐が軽く緩んでいる\n片側が脱げておっぱいが見えていて\nもう片側はビキニの下から揉まれている\n・ズボン\n膝くらいまで脱げている\n・表情\n快楽に堕ちきったというよりもセックスを楽しみつつもまだ恥じらいが残った具合\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}]}