-4fc6-9209-16b439d95786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40fc24306a97d37e8b947bae6cc9183", "thumbnail_srcset": "https://si.imgix.net/8fa9310d/uploads/origins/cf626161-fa73-4fc6-9209-16b439d95786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40fc24306a97d37e8b947bae6cc9183, https://si.imgix.net/8fa9310d/uploads/origins/cf626161-fa73-4fc6-9209-16b439d95786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d483f78b8b8348ea015bb01719cc6da 2x, https://si.imgix.net/8fa9310d/uploads/origins/cf626161-fa73-4fc6-9209-16b439d95786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d5efe3fa7d47b005424cf838ddb7686 3x", "genre": "art", "nsfw": false, "body": "オリジナルキャラクターのイラストをお願いしたいです！！\n髪: 紫がかった黒のような灰色のような\n髪型: ぱっつんアシンメトリー、さらさら\n服: スーツ(ジャケットは長め、ベストやジャケットに金のラインが入っているもの。ベストは灰色)\n武器: バトルアックス\n\n武器を持っているポーズはお任せします！\nバトルアックスはあまりファンタジーすぎないものが良いです。\n黒手袋もついていたら助かります。\n\nよろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@Ri_pk_so/works/4", "thumbnail_src": "https://si.imgix.net/0ba618be/uploads/origins/3520cd5b-bc74-44b9-9ff8-158569f6c11f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1c22f8a51d2964ffb45e607a518607", "thumbnail_srcset": "https://si.imgix.net/0ba618be/uploads/origins/3520cd5b-bc74-44b9-9ff8-158569f6c11f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1c22f8a51d2964ffb45e607a518607, https://si.imgix.net/0ba618be/uploads/origins/3520cd5b-bc74-44b9-9ff8-158569f6c11f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16b8170feb5e63d14b94b68c3c61b044 2x, https://si.imgix.net/0ba618be/uploads/origins/3520cd5b-bc74-44b9-9ff8-158569f6c11f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fea145b56899ec8b290e8fe601dde1ef 3x", "genre": "art", "nsfw": false, "body": "（再送失礼いたします）\n初めまして、お見かけした絵を見てオリジナルキャラクターの立ち絵をご依頼させていただきたくメッセージをお送りしました。\n詳細は以下の通りです。\n\n☆パーソナルデータ\n男性、30代前半。身長200cm。やや痩身。\n\n☆顔\nやや顔を隠す前髪と長くまっすぐな黒髪、青みがかった銀灰色の切れ長の瞳。\n物憂げな雰囲気ですが、表情は柔和です。\n鹿の角に似た、枝分かれした角を2本持っています。\n\n☆服装\n青い水がイメージの着物で、足元は草履です。\n\n☆備考\n背は高いですが痩せ気味で、大人しめな雰囲気です。\n想定としては受けです。\n\nもし可能でしたらよろしくお願いいたします……！", "created_at": "", "completed_at": ""}, {"path": "/@Ri_pk_so/works/3", "thumbnail_src": "https://si.imgix.net/2929b599/uploads/origins/98f7b4b4-9729-4def-bb86-1c3c292004a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ce3aebfb7245ea6189c407be00f994e", "thumbnail_srcset": "https://si.imgix.net/2929b599/uploads/origins/98f7b4b4-9729-4def-bb86-1c3c292004a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ce3aebfb7245ea6189c407be00f994e, https://si.imgix.net/2929b599/uploads/origins/98f7b4b4-9729-4def-bb86-1c3c292004a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4b44ef1e2e4fa7f52fb52badadb5c06 2x, https://si.imgix.net/2929b599/uploads/origins/98f7b4b4-9729-4def-bb86-1c3c292004a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da9fc24dd8934bb5453ac78f44f15985 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。淕様の画風がとても好きです！オリジナルキャラクターのイラストをお願いしたいです。\n\n🍷 キャラクターの詳細です。身長187cm。30代後半。スペイン出身の神父で、エクソシストや悪魔ハンターとして働いている。普段は真面目で、特に仕事中は責任感が強い。しかし、好きな人をからかうのも好き。鋭い犬歯が特徴。筋肉質。\n\n笑顔で描いてください。できれば、資料フォルダの画像C01のようにライフルを持った姿で描いてください。\n\nよろしくお願いします！リクエストにそぐわない場合は、遠慮なくボツにしてください。\n\nhttps://drive.google.com/drive/folders/1h_-rr-bVw3FXSn-VbCDX5BbsiWaFLBZA", "created_at": "", "completed_at": ""}, {"path": "/@Ri_pk_so/works/2", "thumbnail_src": "https://si.imgix.net/e459fc61/uploads/origins/0f30fbe6-d595-486b-9ca8-0aed4fe2f31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d5ca1aff8f0bc35816b0de46fc14d22", "thumbnail_srcset": "https://si.imgix.net/e459fc61/uploads/origins/0f30fbe6-d595-486b-9ca8-0aed4fe2f31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d5ca1aff8f0bc35816b0de46fc14d22, https://si.imgix.net/e459fc61/uploads/origins/0f30fbe6-d595-486b-9ca8-0aed4fe2f31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6285a48720594bddf8ef36cefe8fcac 2x, https://si.imgix.net/e459fc61/uploads/origins/0f30fbe6-d595-486b-9ca8-0aed4fe2f31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62c4dc9ba6400a555d1a0dd0ae7d4da7 3x", "genre": "art", "nsfw": false, "body": "初めて依頼させていただきます！\n\n今回お願いしたいのはTRPGの立ち絵です。  以下詳細です。  \n\n【キャラクターの詳細】 \n性別：男 \n年齢：32 くらい\n身長：183cm \n容姿：短髪金髪、つり眉タレ目、エメラルドグリーンの瞳、やや褐色、左口下に黒子、八重歯 \n服装: カジノに行くような装い、スーツ(全体的に黒っぽい感じ)、黒手袋、ビジネスシューズ \nポーズ: 座っている、タバコを持っている\n表情：やや微笑んでいる感じで、少し不敵な笑みを浮かべている。\n\n何か不都合ありましたら再度申請してくださればと思います。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Ri_pk_so/works/1", "thumbnail_src": "https://si.imgix.net/cadd77a7/uploads/origins/6034c9cd-5e88-4537-90fb-34c6c36e2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d947cb877a3aa4e3b71828a76429c8b5", "thumbnail_srcset": "https://si.imgix.net/cadd77a7/uploads/origins/6034c9cd-5e88-4537-90fb-34c6c36e2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d947cb877a3aa4e3b71828a76429c8b5, https://si.imgix.net/cadd77a7/uploads/origins/6034c9cd-5e88-4537-90fb-34c6c36e2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e132f7855e2fd54ef0f39a1374f2edb8 2x, https://si.imgix.net/cadd77a7/uploads/origins/6034c9cd-5e88-4537-90fb-34c6c36e2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50cd5287990e8f4751b3ff7989d5687a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートとデザインを見て、本当に気に入りました！まず最初に、このデザインが将来VTuberモデルのインスピレーションになってもいいかどうか知りたいです。もしそうでなければ、心配しないで、遠慮なく私の依頼を断ってください！\n\n現在のモデル（ドキュメントに添付）のデザインを全面的に変更するつもりです。主なアイデアは、キャラクターが人形劇場のサーカスのリングマスターになることです。キャラクターは女の子ですが、男装の方がしっくりきます（イケメンガール）。服装はスーツで、髪の色やスタイルは自由で、目の虹彩は一人一人違うものにしてほしい（資料に例を添付）。\n\n\nhttps://drive.google.com/drive/folders/1CcfdXshnvGNEviWvOcZ86aTWp-uQy22K?usp=drive_link", "created_at": "", "completed_at": ""}]}