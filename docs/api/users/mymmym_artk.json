5211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19eb53746bab851dceb572b01c43e70d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8dc550abbbefb45b501a8fd38e4bd60a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=091ce13014c4bd7f1987d4cd0e83dfa1 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/48", "thumbnail_src": "https://si.imgix.net/08fefc2b/uploads/origins/d8c409e6-391d-43a0-a3c4-320662440138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d2c4dd30cc218f0d634dfa7f18e358", "thumbnail_srcset": "https://si.imgix.net/08fefc2b/uploads/origins/d8c409e6-391d-43a0-a3c4-320662440138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d2c4dd30cc218f0d634dfa7f18e358, https://si.imgix.net/08fefc2b/uploads/origins/d8c409e6-391d-43a0-a3c4-320662440138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed3622d714dff2d4e1184eef25599227 2x, https://si.imgix.net/08fefc2b/uploads/origins/d8c409e6-391d-43a0-a3c4-320662440138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67f24cebd90be8f7a1e718c21fe4a28b 3x", "genre": "art", "nsfw": false, "body": "こんみゃもございます\nいつもお世話になっております。蒼海です\nずっと依頼するか迷っていたのですが、みゃもさんとの思い出にとこの度依頼させていただきました\n【使用用途】『Twitter』でのアイコン利用\n【モデル】オリジナルキャラ（所謂うちの子です）\n【容姿】金髪で毛先のみ白。目の色は青…というより空色\n服装は赤をメインに。肘、もしくは肩が出ている衣装だと嬉しいです\nポーズや衣装の細かいデザイン、装飾品はみゃもさんにおまかせいたします\nそして最重要ポイントですが『球体関節』でお願いいたします！！\n\n恐らくほかの方も駆け込みで依頼をしていると思うので、みゃもさんのキャパシティの範囲ないで大丈夫です\n\nご一考のほど、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/47", "thumbnail_src": "https://si.imgix.net/0d15621f/uploads/origins/823f25ae-0196-4af0-ba0f-2468c5a83ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c1fbdf25274026324a75a2a6403e997", "thumbnail_srcset": "https://si.imgix.net/0d15621f/uploads/origins/823f25ae-0196-4af0-ba0f-2468c5a83ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c1fbdf25274026324a75a2a6403e997, https://si.imgix.net/0d15621f/uploads/origins/823f25ae-0196-4af0-ba0f-2468c5a83ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=452cd40faeef8b974bf311c8a509fb9e 2x, https://si.imgix.net/0d15621f/uploads/origins/823f25ae-0196-4af0-ba0f-2468c5a83ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3efecbedb7ae824960065195d239dfa3 3x", "genre": "art", "nsfw": false, "body": "今まで依頼出来ていなくて、今を逃すと今後チャンスが来ないかもしれないし、初任給も入ったので、依頼します。\n\n「PCの前でいつも通り、楽しそうに配信しているみゃもさん」を描いてください。\n\n忙しかったり、何かしらの理由で不快に思ったなら描かなくても大丈夫です。\n\nこれからのみゃもさんの新たな門出を応援しています。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/46", "thumbnail_src": "https://si.imgix.net/08c47cc0/uploads/origins/db73c8ad-c9a7-4286-a7a2-3eb738b13114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6542a7a9f63423d3b247accf6b721bb2", "thumbnail_srcset": "https://si.imgix.net/08c47cc0/uploads/origins/db73c8ad-c9a7-4286-a7a2-3eb738b13114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6542a7a9f63423d3b247accf6b721bb2, https://si.imgix.net/08c47cc0/uploads/origins/db73c8ad-c9a7-4286-a7a2-3eb738b13114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e62dac1372990d5f0ea20fd83824150 2x, https://si.imgix.net/08c47cc0/uploads/origins/db73c8ad-c9a7-4286-a7a2-3eb738b13114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab27fe4e4b107f32fc9f5a19fa4c3918 3x", "genre": "art", "nsfw": false, "body": "こんにちは！　みゃもさんにインディーRPG「Elin」に登場するキャラクター『開拓監査官ロイテル』のイラストを依頼したいです。\n\n参考画像URL\nhttps://x.com/elocat/status/1848675343441256522\n（Elin作者のtwitter（X）投稿、3枚目の画像のキャラクターです）\n\nこの男は、ファンタジー世界の野原を開拓しようとする主人公の元に開拓のアドバイスをするために王国から派遣された人物で、見た目通りにマジメだけど高慢、しかしプレイヤーと全く関係ないところで詐欺に合い2000万の借金を背負ってしまい、流れでプレイヤーに借金返済に協力させるという、苦労人だけど妙に図太い面白ぇ男です\n\nこの男が、好物のワインを片手に、趣味の希少花コレクションの一環で手に入れた空色（青色）のチューリップを愛でているイラストを描いてほしいです。\nこのチューリップが、後に偽物だと分かり、ロイテルの莫大な借金の原因になるということを踏まえて、何も知らずに優雅にチューリップの匂いを嗅いでるところを描いてください。よろしくお願いします。\n\n二次創作ガイドラインはネット上にはありませんが、ゲーム本体についてるノートによると特に二次創作の制限なし、許可や報告は不要となっています。\n\nhttps://x.com/elocat/status/1848675343441256522", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/45", "thumbnail_src": "https://si.imgix.net/9c645fe8/uploads/origins/3bea1959-9cc1-4dc8-9c00-398d13072286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f5ee6618d594098748f5eab5f8e202", "thumbnail_srcset": "https://si.imgix.net/9c645fe8/uploads/origins/3bea1959-9cc1-4dc8-9c00-398d13072286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f5ee6618d594098748f5eab5f8e202, https://si.imgix.net/9c645fe8/uploads/origins/3bea1959-9cc1-4dc8-9c00-398d13072286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=664e5c24433720c9ac3ee2204cffbfd6 2x, https://si.imgix.net/9c645fe8/uploads/origins/3bea1959-9cc1-4dc8-9c00-398d13072286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=983d34891c78b47cd53edd42ed129cca 3x", "genre": "art", "nsfw": false, "body": "平素よりお世話になっております。けいたまでございます。\n師走も折り返し、2024年もいよいよ押し迫ってまいりましたね。そこで自分へのクリスマスプレゼントとして、理想の女選手権勇者パーティー編より「ニコ・テスラ」ちゃんをサンタコスでみゃも様に絵を描いていただきたく、ご依頼申し上げます。\n具体的な構図や表情としては、少し照れながらも上目遣いでこちらにプレゼントを渡すサンタ衣装のニコちゃんを所望します。場所は雪の降る屋外でお願いします。\nますます寒くなっておりますので、どうか体調に気をつけてお過ごしください。どうぞ宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/44", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d556e8c28e5f908b53328b4ae63f6e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d556e8c28e5f908b53328b4ae63f6e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26926638186b9198c34c122663b7ee2f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f102f6c0a5c960b3eed53eb4941d45c2 3x", "genre": "voice", "nsfw": false, "body": "ののしってください2", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/43", "thumbnail_src": "https://si.imgix.net/1423c94e/uploads/origins/c761a5ec-582f-4be5-8ca3-72061198299c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ff7512f2146b223984cfb34b830c3f", "thumbnail_srcset": "https://si.imgix.net/1423c94e/uploads/origins/c761a5ec-582f-4be5-8ca3-72061198299c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ff7512f2146b223984cfb34b830c3f, https://si.imgix.net/1423c94e/uploads/origins/c761a5ec-582f-4be5-8ca3-72061198299c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26873a96e342c734358199ca1ca623a6 2x, https://si.imgix.net/1423c94e/uploads/origins/c761a5ec-582f-4be5-8ca3-72061198299c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=928429d4916af4651bce52e48d2c8260 3x", "genre": "art", "nsfw": false, "body": "平素より格別の配信賜り、誠にありがとうございます。\nお陰様で生きております。\nまた、先日は生誕祭おめでとうございました。\n\nさて、この度は僭越ながら拙僧も誕生日を迎えました。\nので！\nいつも最高に可愛いみゃも様でございますが、その中でも最★可愛最☆強みゃも様ください。\nなんでもしますから。\n以上検討のほど、よろしくお願いいたします。\n\n追伸、何がとは言いませんが拙僧の癖は長髪、和装、以下略です。\nおなかおへそも癖で・・・いえ、なんでもございません。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/42", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d556e8c28e5f908b53328b4ae63f6e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d556e8c28e5f908b53328b4ae63f6e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26926638186b9198c34c122663b7ee2f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f102f6c0a5c960b3eed53eb4941d45c2 3x", "genre": "voice", "nsfw": false, "body": "セリフは『私の名前は…？グルグルのグルグルと申します。あなたも私を姫と呼ぶことができます。ずっと愛してくれている人に付き添ってくれてありがとう…でも永遠には付き合えなくてごめんなさい。私はたくさんの人に嫌われているから…最低でしょう私もそう思います…とにかく私は私のプラットフォームのアカウントをログアウトします愛しています…’", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/41", "thumbnail_src": "https://si.imgix.net/4a48911a/uploads/origins/26e24d1e-9e79-4d0e-9547-baa0d0406149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae43e9c75791ceb9f84271ac18da4db", "thumbnail_srcset": "https://si.imgix.net/4a48911a/uploads/origins/26e24d1e-9e79-4d0e-9547-baa0d0406149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae43e9c75791ceb9f84271ac18da4db, https://si.imgix.net/4a48911a/uploads/origins/26e24d1e-9e79-4d0e-9547-baa0d0406149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cb81395a19a74600aa86e8d32ff7ff1 2x, https://si.imgix.net/4a48911a/uploads/origins/26e24d1e-9e79-4d0e-9547-baa0d0406149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=553687f4253c5d4d7397b2796bf661eb 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。。各務ユウセイです。\n今回もみゃもさんにイラストを依頼したく連絡させて頂きました。\n\n芸術の秋をテーマにしたいと思います。\n\n【依頼内容】\nモデル：みゃもさん\n\n構図：楽しそうに演奏するみゃもさん\n　　　\n衣装：カジュアルなドレス、バイオリン\n\n背景：イベント会場になっている噴水がある夜の公園\n　　　(周辺の明かりは電球色のようなオレンジ)\n　　　(中世のヨーロッパのような石畳の道、石造りの噴水）\n\n用途：個人観賞\n\nどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/40", "thumbnail_src": "https://si.imgix.net/b8c3f230/uploads/origins/7d7f0291-903d-448e-86ec-683d7fe4adc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70789229d52584b561ef226f0a780460", "thumbnail_srcset": "https://si.imgix.net/b8c3f230/uploads/origins/7d7f0291-903d-448e-86ec-683d7fe4adc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70789229d52584b561ef226f0a780460, https://si.imgix.net/b8c3f230/uploads/origins/7d7f0291-903d-448e-86ec-683d7fe4adc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a3be0fdb2ab3090f7072d12e85ce171 2x, https://si.imgix.net/b8c3f230/uploads/origins/7d7f0291-903d-448e-86ec-683d7fe4adc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97efc6dd8646261e7a54fb6c7973481c 3x", "genre": "art", "nsfw": false, "body": "ごきげんよう。\n猛暑厳しい昨今、いかがお過ごしでしょうか？\n先日も大変すばらしいものを賜りマジサイコー。\nお陰様でぽっきんしそうなガラスのハートをムキムキにして、今日も生き抜くことができます。\nさて、今回の御依頼としましては連日脳内議会にて熱い議論が交わされた結果\n先日チラ見されていた水着みゃもさんのリメイクをください。\n癖には勝てませんでした。（ﾍｷｯ\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/39", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d556e8c28e5f908b53328b4ae63f6e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d556e8c28e5f908b53328b4ae63f6e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26926638186b9198c34c122663b7ee2f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1840035211192741888%2Fb_I3bwcR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f102f6c0a5c960b3eed53eb4941d45c2 3x", "genre": "voice", "nsfw": false, "body": "ののしってください。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/38", "thumbnail_src": "https://si.imgix.net/c47b4add/uploads/origins/a212bf03-8cc6-45e3-86bc-421a7ade0018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=139a8322402878a9b269867cdb30e5d5", "thumbnail_srcset": "https://si.imgix.net/c47b4add/uploads/origins/a212bf03-8cc6-45e3-86bc-421a7ade0018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=139a8322402878a9b269867cdb30e5d5, https://si.imgix.net/c47b4add/uploads/origins/a212bf03-8cc6-45e3-86bc-421a7ade0018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27b98555d214865f137e7d01a0370058 2x, https://si.imgix.net/c47b4add/uploads/origins/a212bf03-8cc6-45e3-86bc-421a7ade0018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2cd6b7437e590176d60c2a1f655acd9 3x", "genre": "art", "nsfw": false, "body": "拝啓みゃもさん\n\n初めてのリクエスト故粗相がありましたら申し訳ありません。\n\n私、リリー・B・オポジットのマロ主でございます。\n\n今回は及ばずでしたが、みゃもさんの描くリリーが見たくリクエストをお送りいたしました。\n\n御姿\nモノクルを掛けていて髪は腰下まで長く髪色は藤色。クラシカルメイド服を着た高身長イケメンスレンダーお姉さん。\n※マロには書けなかった追記　瞳は紅色　メイド服に鈴蘭を模した刺繍あり\n\n\n構図\nおどろおどろしくも、妖艶な雰囲気を醸し出し獲物を狙ってる眼差しでこちらを見つめている\n背景は蜘蛛っぽく。\n\n情報足りなかったらすみません。その場合みゃもさんの思うままに描いていただければ幸いです。\n\n宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/37", "thumbnail_src": "https://si.imgix.net/605155fd/uploads/origins/d92ecd84-625d-4d0d-8811-451a79b2f376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381a483705eb7f00592c316280fe9c50", "thumbnail_srcset": "https://si.imgix.net/605155fd/uploads/origins/d92ecd84-625d-4d0d-8811-451a79b2f376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381a483705eb7f00592c316280fe9c50, https://si.imgix.net/605155fd/uploads/origins/d92ecd84-625d-4d0d-8811-451a79b2f376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9d22d2bd7ab442e75162460dfa506b9 2x, https://si.imgix.net/605155fd/uploads/origins/d92ecd84-625d-4d0d-8811-451a79b2f376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9ebc982384c3f8a902d6225cb5d776d 3x", "genre": "art", "nsfw": false, "body": "ごきげんよう。\n平素より愛情あふれるイラストを賜り、恐悦至極に存じます。\n\nさて先日、週末飯の折にて御狐の里を描いてみたいとのことでしたのでご依頼差し上げます。\n御狐の里は無数にありますからお好きに描いていただいて構いません。\n参考になるか分かりませんが、個人的に練っている構想を下記しておきます。\n\n　今は昔、日が昇らぬこの地に蒼穹より星が到りけり。\n　彼の星、現世の身体を持たざるが、御心内に宿りしか。\n　不運にも星の炎に焼かれたる2つの魂を掬い上げ、その身の写しと致しけり。\n　その御姿と、大いなる御業にてこの地を守る神とし祀りける。\n\n※ある日、文明も無い地に隕石が落ちました。\n　その隕石は地球外生命体でありますが、地球の環境に適した体を持ちませんでした。\n　生命体は隕石の落下に巻き込まれた狐と人の幼子に心を痛め、その身体を依り代とすることで生かそうとします。\n　その結果、狐耳と尻尾を持つ人のような見た目となります。\n　彼女は元来、自分が生きられるように環境を作り替える能力を持ちますが、犠牲者たちの身体と記憶を取り込んだ事で、守りたいと思うようになります。\n　しかしその世は乱世、戦火は彼女の座す地にも迫っていました。\n　彼女はその力を使い、自らを巫女と慕って着いてきてくれる者達と共にその地を霧の奥深くへと隠すことにしました・・・。\n　秘境として平和に存在していたある日、世界に変化が訪れます。\n　大崩壊によって、世界は人が生きるには過酷な環境となりました。\n　それは彼女にとっては取るに足りない変化でしたが、彼女の愛する人間たちにとっては致命的な変化でした。\n　そして彼女は今の状態では自分がほとんど動けなくなることを覚悟のうえで、人々を変わらず生かすために里とその周囲を元通りに作り替えるのでした・・・。\n　\n※里は一度管理局側と抗争状態に入りますが、地の利とゲリラ戦法によって撃退に成功しました。\n　その際簒奪した装備や機器によって里の文化水準は現代と遜色ない程度に向上しています。\n　しかしその文化基盤は科学と言うよりも陰陽に近く、土着信仰を根強くしています。\n　御狐様を頂点とし、5つの氏族が議会となり民衆を導くその里は、他者を徹底的に排除し、閉鎖的なコミュニティとすることで限られた土地空間でも変わらず存在することができています。\n姫巫女様は筆頭の娘です。\n文字数！", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/36", "thumbnail_src": "https://si.imgix.net/3a7fe5f2/uploads/origins/fc9b22fe-6109-41a0-b545-e03810895d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52bad31b175535f022908f512c08ad3f", "thumbnail_srcset": "https://si.imgix.net/3a7fe5f2/uploads/origins/fc9b22fe-6109-41a0-b545-e03810895d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52bad31b175535f022908f512c08ad3f, https://si.imgix.net/3a7fe5f2/uploads/origins/fc9b22fe-6109-41a0-b545-e03810895d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f56f8e4946b37ec17112e1d03ce58ff 2x, https://si.imgix.net/3a7fe5f2/uploads/origins/fc9b22fe-6109-41a0-b545-e03810895d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93c36fb76dd15201328c69bd2c2e03d2 3x", "genre": "art", "nsfw": false, "body": "こんみゃもごさまいます。\n【理想の女 選手権】より\n【東雲一途】をお願いしたいです！\n\n\n・赤髪ロングハーフアップ\n・長身スタイル◯\n・切れ長三白眼\n・おヘソの出ている動きやすい中華っぽい服\n・腕、おヘソに生傷\n\n表情、構図等はみゃもさんのイメージで描いてもらえたら幸いです。\n\n何卒、よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/35", "thumbnail_src": "https://si.imgix.net/594b9ec3/uploads/origins/e1ba4eaf-a0b7-4381-9955-ed114bcbdc10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f3b97c6fdf89deb9f3a7b64bb44fd0", "thumbnail_srcset": "https://si.imgix.net/594b9ec3/uploads/origins/e1ba4eaf-a0b7-4381-9955-ed114bcbdc10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f3b97c6fdf89deb9f3a7b64bb44fd0, https://si.imgix.net/594b9ec3/uploads/origins/e1ba4eaf-a0b7-4381-9955-ed114bcbdc10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ae67edbae06f45ae1b2e1e3b04d669c 2x, https://si.imgix.net/594b9ec3/uploads/origins/e1ba4eaf-a0b7-4381-9955-ed114bcbdc10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=064ffba218e68333f289ff2a32902794 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。けいたまです。\n　先日は理想の女選手権お疲れ様でした。私も待ち侘びた企画でしたので、とても楽しませていただきました。\n　そこでなのですが、企画にも投稿させていただいた「ニコ・テスラ」（銀髪ハーフアップ、翡翠の眼、額に螺旋の角、オフショルハイウェストのワンピース）のイラストを依頼したく思います。構図などはみゃもさんにお任せします（丸投げすみません）。あわよくば、まだ指や髪の先が若干透けているシチュエーションだと嬉しいです。\n　初めての依頼になりますので、拙い文章ですみません。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/34", "thumbnail_src": "https://si.imgix.net/0c655d75/uploads/origins/1153a2af-9129-45a8-9057-cd3c28f14b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47717474b66900cf9a4859de05c25aa2", "thumbnail_srcset": "https://si.imgix.net/0c655d75/uploads/origins/1153a2af-9129-45a8-9057-cd3c28f14b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47717474b66900cf9a4859de05c25aa2, https://si.imgix.net/0c655d75/uploads/origins/1153a2af-9129-45a8-9057-cd3c28f14b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab18c0a868e999a5cfa1a57637678a97 2x, https://si.imgix.net/0c655d75/uploads/origins/1153a2af-9129-45a8-9057-cd3c28f14b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3175544512eb711408de215cca0d3002 3x", "genre": "art", "nsfw": false, "body": "ごきげんよう。\n平素より格別の配信を賜り、誠にありがとうございます。\nさて、今月はジューン・ブライドと言うことで、黒無垢のみゃもさんでリクエストを送りたいと思います。\nそれ以外はご自由にしていただいて構いません。\nグッズ化も待ってます。\n待ちすぎて首が伸びるくらいには。\nあとボイスも頂戴できれば何よりでございます。\n\n気温も天気も安定せぬ頃、どうかご自愛くださり元気にお声を聞けることを願っています。", "created_at": "", "completed_at": ""}, {"path": "/@mymmym_artk/works/33", "thumbnail_src": "https://si.imgix.net/3a675751/uploads/origins/e2823e91-5204-4e84-a770-1fb6500e2778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d03c5d6834d508790e6a824182b2ef6", "thumbnail_srcset": "https://si.imgix.net/3a675751/uploads/origins/e2823e91-5204-4e84-a770-1fb6500e2778?bg=%23fff&auto=format%2Ccomp