-a5f898b4e4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d30b523e14892e9f1c59bf45bca8c55", "thumbnail_srcset": "https://si.imgix.net/b050a6a0/uploads/origins/ccaff561-a8b4-4601-b5bd-a5f898b4e4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d30b523e14892e9f1c59bf45bca8c55, https://si.imgix.net/b050a6a0/uploads/origins/ccaff561-a8b4-4601-b5bd-a5f898b4e4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af8a80e687137cbc609a63768a399613 2x, https://si.imgix.net/b050a6a0/uploads/origins/ccaff561-a8b4-4601-b5bd-a5f898b4e4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcd71583198e17f27802e06e629da39a 3x", "genre": "art", "nsfw": false, "body": "めいこさんアピールありがとうございます。\nイラストが絵本のようでかわいかったので依頼しますね。\n自分は東方のトレカを作っているのでそれ用のイラストをお願いします。\n\nキャラはフランちゃんでお願いします。\n春っぽいカラーがいいです。\n下記内容でご検討お願いします。\n\n内容：フランドール・スカーレット\n補足：可能ならタイトルとフレーバーテキスト(カード下部に表示するセリフや説明のこと)を考えて別レイヤーに書いてください。\n用途：トレカイラスト、トレカをまとめた本、カードサプライ、切手風シール、クリアファイル、これらのPR\nサイズ：2500*3200pixel 350dpi(または同比率のサイズ)\n\nイラストの二次利用・掲載・作業の配信は自由です。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@omochikomo/works/6", "thumbnail_src": "https://si.imgix.net/e6d09c3e/uploads/origins/50b0ad38-c300-4441-aee2-cc786ae6b2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5db3103a2c5f602cfa9b2f64cd5e7a9", "thumbnail_srcset": "https://si.imgix.net/e6d09c3e/uploads/origins/50b0ad38-c300-4441-aee2-cc786ae6b2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5db3103a2c5f602cfa9b2f64cd5e7a9, https://si.imgix.net/e6d09c3e/uploads/origins/50b0ad38-c300-4441-aee2-cc786ae6b2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=463fd334d6b2fd26948c24c87f6ccf1d 2x, https://si.imgix.net/e6d09c3e/uploads/origins/50b0ad38-c300-4441-aee2-cc786ae6b2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bca97b57c861ce9e47ea91b644567e3 3x", "genre": "art", "nsfw": false, "body": "めいこ様、\n初めまして、meiと申します。\nアピールありがとうございます！ぜひ依頼させて頂きたいです！\n\n衣装4種類あるので、参考リンクからお好きなものに描いて頂ければ嬉しいです！\n\nキャラクターのモチーフは：星、銀河、星座\n元気いっぱいな女の子です！ポーズや表情等お任せ致します。\n\n使用用途について：\nSNSのアイコンやヘッダー、YouTubeの歌ってみた動画・サムネ（収益無し）\n\n可能であれば、背景と人物とレイヤー分けをされたデータ(PSD等)もいただきたいです。\n\n何卒ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1jqW5UInD2lS03Ze2K_96XOnNYZyhOUMm?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@omochikomo/works/5", "thumbnail_src": "https://si.imgix.net/45f84e79/uploads/origins/ae4615e0-87b2-4942-8125-5446fadc8997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ad3db83fb132666ece3349172d5e10", "thumbnail_srcset": "https://si.imgix.net/45f84e79/uploads/origins/ae4615e0-87b2-4942-8125-5446fadc8997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ad3db83fb132666ece3349172d5e10, https://si.imgix.net/45f84e79/uploads/origins/ae4615e0-87b2-4942-8125-5446fadc8997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50a1bc01d2f96a5d29c0f81418e22330 2x, https://si.imgix.net/45f84e79/uploads/origins/ae4615e0-87b2-4942-8125-5446fadc8997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2be994b4143959111e0aa31efa7698ba 3x", "genre": "art", "nsfw": false, "body": "めいこさん、はじめまして！\nアピールしてありがとうございます！\n\n私のオリジナルキャラクターのエマちゃんを描いて頂きたいです。\n下のURLでは三面図と設定シートと他の衣装を載せているツイートスレッドです！\n\n詳細などお任せします！\n\nありがとうございます！\n\nhttps://twitter.com/kazakuri/status/1397562595662512130", "created_at": "", "completed_at": ""}, {"path": "/@omochikomo/works/4", "thumbnail_src": "https://si.imgix.net/7e29c889/uploads/origins/b441aea0-adc8-49a8-944d-231f2c088a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7358486ce767e2852021e22553d76f10", "thumbnail_srcset": "https://si.imgix.net/7e29c889/uploads/origins/b441aea0-adc8-49a8-944d-231f2c088a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7358486ce767e2852021e22553d76f10, https://si.imgix.net/7e29c889/uploads/origins/b441aea0-adc8-49a8-944d-231f2c088a76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c07cd4206dce4340e8f24f2612f3f3d 2x, https://si.imgix.net/7e29c889/uploads/origins/b441aea0-adc8-49a8-944d-231f2c088a76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f1f91e6d007251393df342bfebb9552 3x", "genre": "art", "nsfw": false, "body": "うちの子のローズ・カーマイン\n（出来たらクマのぬいぐるみを抜いてる）の絵をお願いしたいです！\n注文多くてごめん😢🙏🏻🙏🏻\n\nhttps://twitter.com/TdnSzk1__Y0/status/1625032861920428035?s=20", "created_at": "", "completed_at": ""}, {"path": "/@omochikomo/works/3", "thumbnail_src": "https://si.imgix.net/81afeac2/uploads/origins/993732b2-40be-4783-b49c-304c35a4d38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e97175c634888a1638d978364204059", "thumbnail_srcset": "https://si.imgix.net/81afeac2/uploads/origins/993732b2-40be-4783-b49c-304c35a4d38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e97175c634888a1638d978364204059, https://si.imgix.net/81afeac2/uploads/origins/993732b2-40be-4783-b49c-304c35a4d38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71d705470e7e28008d7d9d72d5911ee4 2x, https://si.imgix.net/81afeac2/uploads/origins/993732b2-40be-4783-b49c-304c35a4d38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a8b09d770637f6f65d3dfd7acdf1acd 3x", "genre": "art", "nsfw": false, "body": "千多めいさん、こんにちは\nこの度はとても可愛い姉妹を描いて頂き本当にありがとうございます。\nもう1件お願いしたいと思いますので、よければよろしくお願いします。\n\n①前回描いて頂いた姉妹を今度は水着姿で描いてもらいたいです。\n　（水着の練習にどうぞ！胸の盛り加減は盛り過ぎない範囲で自由にお任せします）\n②水着についてはお任せします。\n　千多めいさんの思い描く姉妹に似合う水着を描いてもらえたらと思います。\n➂構図や表情についてもお任せします。\n\nでは、今回も何卒よろしくお願いします！\n\nhttps://imgur.com/a/VE8KUDZ", "created_at": "", "completed_at": ""}, {"path": "/@omochikomo/works/2", "thumbnail_src": "https://si.imgix.net/aa87f5e2/uploads/origins/d7229d33-7f5f-484b-a617-6f423a21093c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9f2dd33158897fa8ad3f398c639661a", "thumbnail_srcset": "https://si.imgix.net/aa87f5e2/uploads/origins/d7229d33-7f5f-484b-a617-6f423a21093c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9f2dd33158897fa8ad3f398c639661a, https://si.imgix.net/aa87f5e2/uploads/origins/d7229d33-7f5f-484b-a617-6f423a21093c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09b5303a366c30d1bc2147840ad6fa45 2x, https://si.imgix.net/aa87f5e2/uploads/origins/d7229d33-7f5f-484b-a617-6f423a21093c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2da23f05e060a029ba452e61c955895 3x", "genre": "art", "nsfw": false, "body": "千多めいさん、こんにちは\nアピールありがとうございます！\n早速ですが、ぜひうちの子をお願いします。\n\n①資料のうちの子（年子の姉妹）をお願いします。\n②水色の衣装がひめ（妹：お姉ちゃん大好きな大人しめの子）\n　ピンクの衣装がひな（姉：妹大好きな優しくて少し明るめな子）\n➂構図や表情等はお任せしますので描きやすいように描いてもらえればと思います。\n　（姉妹の仲の良さが全力で伝わってくる内容だととても嬉しいです）\n④衣装はドレスと制服の2種類がありますが、描きやすい方で描いてもらえればと思います。\n⑤細々とした装飾品等は簡略化していただいて大丈夫です。\n\nでは、何卒よろしくお願いします！\n\nhttps://imgur.com/a/VE8KUDZ", "created_at": "", "completed_at": ""}, {"path": "/@omochikomo/works/1", "thumbnail_src": "https://si.imgix.net/9b135ffc/uploads/origins/09e2e074-293f-41fa-ac17-c0c71f15620d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c33a506a19809a1323019d6f240bf0be", "thumbnail_srcset": "https://si.imgix.net/9b135ffc/uploads/origins/09e2e074-293f-41fa-ac17-c0c71f15620d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c33a506a19809a1323019d6f240bf0be, https://si.imgix.net/9b135ffc/uploads/origins/09e2e074-293f-41fa-ac17-c0c71f15620d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a439e2b1933dde0729129fac4e4adab 2x, https://si.imgix.net/9b135ffc/uploads/origins/09e2e074-293f-41fa-ac17-c0c71f15620d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e911b62f5996927306d5805bb9ea3890 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nこの度めいさんに自創作の絵を描いて頂ければと思い、リクエストを送付させていただきました。\n\n資料に送付した糸目の男の子を描いて頂けますと幸いです。\n髪色は薄い青に近いグレーでヘアアレンジをしています。今回は天使風に描いて頂きたいので、黒い天使の輪と黒い羽は必須でお願い致します。\n構図は資料参照でお願いします。\n\nよろしければ描いて頂けるとありがたいです。\nご検討よろしくお願い致します。\n\nhttps://photos.app.goo.gl/iEXmYuJnxCE4gL7e8", "created_at": "", "completed_at": ""}]}