e7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=112cbb1e9b1345837041a7029445e663 2x, https://si.imgix.net/5b70a5a5/uploads/origins/25afb63a-78b0-4eaf-a339-08d7ec4fe7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84eec984d6c2a6fea28f0a1171fe6cdc 3x", "genre": "novel", "nsfw": true, "body": "はやさか先生どうも初めまして\nサークルハースニール様の同人誌に掲載されていた無限のフロンティアの小説の描写がとても好きでファンになってしまった者です\nこの度是非にご依頼したく送信させて戴きます\n\n■キャラ：ドラゴンクエストVより「ビアンカ」「フローラ」\n\n■シチュ：ニプルセックス\n※資料先参照、女性同士で行う乳頭を相手の乳腺内に挿入するレズニプルファックプレイ\n・挿乳する役の竿乳首はビアンカ、挿乳され役のマンコ乳首はフローラ\n\n■背景：\n・舞台はビアンカの故郷「山奥の村」\n・時系列は魔王を倒し平和を取り戻した後\n・ビアンカはフローラの悩み※1を解消させる為に、主婦同士二人きりで山奥の村に温泉旅行にフローラを誘って来訪\n※１：ビアンカは子宝に恵まれたが自分（フローラ）はまだ、このままでは夫のアンディに愛想を尽かされてしまうかもと少し消沈気味\n・温泉内を貸し切りにし、夫をメロメロにする為の乳腺開発＝会得した新しいプレイで誘惑してもっともっと小作りに励む＝乳腺を開発する事は子供の為にも良い（母乳量増加）＝乳首同士であれば浮気にならない（夫への操も守れる）と一石三鳥？の作戦\n\n■流れ：\n・オラクルベリー※2で調達した特別製の秘薬（乳頭先端の拡張、乳腺感度の増加、母乳量も増える等ニプルファックに特化した薬）を飲んだ上で手指や道具（スライムピアスを連結させたニプルパールや魔物（ケンタウロス等）のペニスを象ったディルド）を使っての乳頭への前戯\n※2：「らしさ」があればオラクルベリーではない別の街の名前でも構いません、また他のニプルの為の良い道具のアイデア等御座いましたらそちらも先生にお任せします\n・ニプルセックス開始、実は山奥の村における伝統（村の女同士で密かに流行していた、幼少期のビアンカもそれに巻き込まれる形で年上の女性達からニプル快楽を覚えさせられてしまっていた、主人公（夫）にはニプルファックをさせてあげているがどこでそれをマスターしたのかは内緒にしている）もあり、久しぶりのニプルセックスプレイにノリノリのビアンカ\n・フローラは全く思考の外である未知の快楽に終始翻弄（ニプルの素質はアリアリで初めてにも関わらず滅茶苦茶に感じてしまっている）\n・乳頭の結合部から漏れ出る特濃母乳に顔面を含めた全身をベトベトにしながら、ビアンカは自身の母乳をフローラの乳腺内に射乳\n・フローラは自分の乳腺内を逆流してくるビアンカの母乳の勢いの良さに気持ち良すぎて悶絶\n・やがて互いの乳腺内に母乳の逃げ場がなくなり、蓋が外れる様にして乳頭同士の結合が外れ、火山の噴火の様に乳頭孔から吹き出た混合母乳をうっとりしながら全身で浴びる\n※最初に互いの夫に申し訳ないので「キスはなし」と取り決めをしていたが、なんだかんだ感極まって舌を絡め合わせ母乳と唾液を送り合ってしまう\n・事が終わり、身体を清めて露天風呂から出ようとするフローラだったが、ビアンカの姿が見当たらず…そこに何故か貸し切りにも関わらず女性（山奥の村の村民）が複数人（男性の姿は一人も無し、女性オンリー、歳はそこそこ行ってるが皆かなりのデカパイ）ずけずけと風呂場に入って来て…フローラは可愛らしい悲鳴を上げる（続きを感じさせる風味のEND）\n\n■NG描写：\n・陥没乳首、ただ乳頭を押し付け合っているだけ\n※勃起乳頭でのガチのニプルファック描写で何卒お願い致します\n・黒色の乳首、くすんだ赤色乳首\n※ビアンカ、フローラ共に十年近く経って（ビアンカは子供を産んでいるにも関わらず）も一向に垂れず張りも良い乳房、ぷっくり肉厚な乳輪と太めの勃起乳頭、色味も綺麗目\n・下半身（膣やアナル）の責め描写は不要です\n※乳房乳頭乳腺への快楽攻めに終始願います\n\n※以上の「流れ」等は飽く迄も私の希望です、ニプルファック、ニプルセックス描写においてもっと良い物があれば展開やオチごと自由に差し替えて下さって構いません\n\n以上です\nふたなり等の依頼では無くて誠に恐縮なのですが、上記の御本内にありました神夜とシャオムゥのニプルファック描写がなによりもどシコかったので是非にニプルオンリーでお願いしたく思っておりました\n御予算や先生のスケジュール等合いましたらご一考の程何卒宜しくお願い致します\n※予算等少なすぎるなどございましたら、誠にお手数ですがキャンセル戴いて一向に構いません\n\nhttps://x.com/isago_s/status/1429014402867499008/photo/1\nhttps://www.pixiv.net/artworks/84301963\nhttps://www.pixiv.net/artworks/89000915\n\nhttps://www.pixiv.net/artworks/94251818", "created_at": "", "completed_at": ""}, {"path": "/@utane_h/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1126904049410797569%2FKRbuylNW.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b058af4ad92ecc49646b55e471df0528", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1126904049410797569%2FKRbuylNW.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b058af4ad92ecc49646b55e471df0528, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1126904049410797569%2FKRbuylNW.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af3a205a87978beab654e9ef4d746a17 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1126904049410797569%2FKRbuylNW.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fa2e904a943873b240036467d22d86f 3x", "genre": "novel", "nsfw": true, "body": "はじめまして。\nクンペロ、漫喫、アクマでおしおきなどでめちゃくちゃお世話になってました。\n\n今さらながらsk