0c9-5d4cd0ccf8c4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=90b73a4d701b92a92f11381be50f84d1, https://si.imgix.net/0c50659b/uploads/origins/1e488a2e-cd46-4d0f-a0c9-5d4cd0ccf8c4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ca855c91b2b7585c97572dba74bb1bc 2x, https://si.imgix.net/0c50659b/uploads/origins/1e488a2e-cd46-4d0f-a0c9-5d4cd0ccf8c4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=03489e2c055e92f7d7f20763a6cd4fc9 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私のスニビーと友達のエモルガでヴォアのテーマをリクエストしたいです\n\nエモルガの大きくてやわらかいマシュマロのおなかにスニビーが押し込まれ、ゴロゴロと音がして、オレンジ色に赤くなって振動しているのを感じる。ドヤ顔でよだれを垂らすベルの顔。\n\n次のコマは、ウィンテの尻尾がゴクゴクと飲み込まれ、ベルのおなかが目に見えて大きくなっていく。ベルは顔を赤らめながら、満足したため息のような空気を吐き出す。ウィンテは丸くなり、きつく締まり、オレンジ色に顔を赤らめている。\n\nベルのエモルガの参考文献 - https://drive.google.com/drive/folders/1DdCx5p262cXdEoquaDVPyj5hnu0KjGqy\n\nウィンテのスニビーの参考文献 - https://drive.google.com/drive/folders/1INQDD95OI-6tIX335sKI0ic5UcCDB5ke", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2768", "thumbnail_src": "https://si.imgix.net/97575361/uploads/origins/637ca3f2-9aa1-4ec2-94e7-4acd6d952398?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=21f34e03be57a614b976474695bb5649", "thumbnail_srcset": "https://si.imgix.net/97575361/uploads/origins/637ca3f2-9aa1-4ec2-94e7-4acd6d952398?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=21f34e03be57a614b976474695bb5649, https://si.imgix.net/97575361/uploads/origins/637ca3f2-9aa1-4ec2-94e7-4acd6d952398?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=d65606c9be722031afa3761425e8c8c2 2x, https://si.imgix.net/97575361/uploads/origins/637ca3f2-9aa1-4ec2-94e7-4acd6d952398?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=efd23c256d711163ac7c897c8b1edc68 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕と僕の彼女のオッチの絵を依頼したいんだ。私のは見るからにぽっちゃりしたゾロアで、彼女のはギョロッとしたヴァポロンです。ゾルアの大きなお腹をヴァポロンが戯れるように撫でたりして、二人がナデナデしているところを描いてもらえますか？前もってありがとうございます！\n以下に参考資料をリンクします。\n\nhttps://imgur.com/a/c6OPXz6", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2767", "thumbnail_src": "https://si.imgix.net/589e19a3/uploads/origins/13dccb47-f075-4bc5-82e4-a033c308106b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f74fab447cb7b6697be5931ed3634022", "thumbnail_srcset": "https://si.imgix.net/589e19a3/uploads/origins/13dccb47-f075-4bc5-82e4-a033c308106b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f74fab447cb7b6697be5931ed3634022, https://si.imgix.net/589e19a3/uploads/origins/13dccb47-f075-4bc5-82e4-a033c308106b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e462b052cebf8d539b04f26b867dd133 2x, https://si.imgix.net/589e19a3/uploads/origins/13dccb47-f075-4bc5-82e4-a033c308106b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=078a8cb1b4e85c47067362361ef7093b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2766", "thumbnail_src": "https://si.imgix.net/befc403c/uploads/origins/095429da-d6e2-4a3d-bac3-e468bfa313f8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=190d1975d94fbeb32ef6347143d2e00d", "thumbnail_srcset": "https://si.imgix.net/befc403c/uploads/origins/095429da-d6e2-4a3d-bac3-e468bfa313f8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=190d1975d94fbeb32ef6347143d2e00d, https://si.imgix.net/befc403c/uploads/origins/095429da-d6e2-4a3d-bac3-e468bfa313f8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec8c84481f74beca495e8ebf6cb65aa0 2x, https://si.imgix.net/befc403c/uploads/origins/095429da-d6e2-4a3d-bac3-e468bfa313f8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=733bf5b1d9c2fd1ff4e8c4bee3fba454 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアニメーションはとても楽しいです！私のコボルドがエレメンタルエネルギーでパワーアップし（胸の虹色の宝石からです）、その代わりに膨らんでぽっちゃりした形になり、また元に戻るという短いループアニメーションをお願いしたいです。彼は自慢したいのですが、その結果に驚いています。\n\nhttps://drive.google.com/file/d/1HUEKoutzYOTdAgNy-5HmdifbnnI8IiOx/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2765", "thumbnail_src": "https://si.imgix.net/899fb523/uploads/origins/621fa373-c8f6-409e-b8a2-ddb4c2b490fb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cff9a31e1610516b6932dbb7365f44fe", "thumbnail_srcset": "https://si.imgix.net/899fb523/uploads/origins/621fa373-c8f6-409e-b8a2-ddb4c2b490fb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cff9a31e1610516b6932dbb7365f44fe, https://si.imgix.net/899fb523/uploads/origins/621fa373-c8f6-409e-b8a2-ddb4c2b490fb?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb583474f2f32f83ec05d4802230cad8 2x, https://si.imgix.net/899fb523/uploads/origins/621fa373-c8f6-409e-b8a2-ddb4c2b490fb?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e38b08b3e065d0d926bc7f3b290a1a8 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵が大好きです！\n僕のキャラクター、イッピーを描いてくれませんか？特に指定はないのですが、楽しく描いてもらえると嬉しいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1fINiFCLt6w5h-BPdO1EWLHvrrsN9TISs?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2764", "thumbnail_src": "https://si.imgix.net/1be88783/uploads/origins/e874063e-3768-44dc-9041-a34d23a8c752?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8bef216b6b5375699b63b20c72edb0e3", "thumbnail_srcset": "https://si.imgix.net/1be88783/uploads/origins/e874063e-3768-44dc-9041-a34d23a8c752?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8bef216b6b5375699b63b20c72edb0e3, https://si.imgix.net/1be88783/uploads/origins/e874063e-3768-44dc-9041-a34d23a8c752?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=23f93bdf8590244c330994de1d352133 2x, https://si.imgix.net/1be88783/uploads/origins/e874063e-3768-44dc-9041-a34d23a8c752?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dbc1de16a0ee4a4ee76bd390dcfd890 3x", "genre": "art", "nsfw": false, "body": "こんにちは、このアートワークをシルビオンに置き換えてリメイクしてもらえないかと考えていました。必要であれば、ブイゼルはそのままでも構いません。\nhttps://drive.google.com/file/d/1hn_60G6Nt_5jYCnji7TweXBnWLIKIwkU/view?usp=drivesdk\nブイゼルへの言及、確かに。\nhttps://drive.google.com/file/d/1hrQuXEBCttgBQxERj-D8nZFuBQu6V-Bh/view?usp=drivesdk\nシルビオンに代わるキャラクターのリファレンス\nhttps://drive.google.com/file/d/1hrZqI-_qlr9vIEYByL8R0IiBwz3JOIgT/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2763", "thumbnail_src": "https://si.imgix.net/b99c1b18/uploads/origins/f64e111e-2531-45b9-a802-6965eb7f4a44?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=500a7a15ccd5ef90910af7afba25e18b", "thumbnail_srcset": "https://si.imgix.net/b99c1b18/uploads/origins/f64e111e-2531-45b9-a802-6965eb7f4a44?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=500a7a15ccd5ef90910af7afba25e18b, https://si.imgix.net/b99c1b18/uploads/origins/f64e111e-2531-45b9-a802-6965eb7f4a44?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e66498a84684d16206c1c5b473bb038f 2x, https://si.imgix.net/b99c1b18/uploads/origins/f64e111e-2531-45b9-a802-6965eb7f4a44?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=941c8194f86a0ea01e0fd1d5f4c916ef 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアニメーションは本当にかわいいですね！\n\nもし可能なら、私のドラゴンがこの猫ダンスを踊っているところを描いてもらえますか？ https://drive.google.com/file/d/1RuyOqCWC9YaCUnJ7Jzs3QNiETQXbsKH7/view?usp=drive_link\nメガネはかけたままでお願いします。必要であれば、彼のコートは取り除くことができます。\n\nありがとうございます！\n\nhttps://drive.google.com/file/d/1yteaHfeK04DxT7qECL9Lk9fxXZu2np1H/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2762", "thumbnail_src": "https://si.imgix.net/2f192dde/uploads/origins/1074d719-ae12-4343-9bf4-b1928197ebd7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d8f2fe74b8a6f8feb500e5d8eff7a477", "thumbnail_srcset": "https://si.imgix.net/2f192dde/uploads/origins/1074d719-ae12-4343-9bf4-b1928197ebd7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d8f2fe74b8a6f8feb500e5d8eff7a477, https://si.imgix.net/2f192dde/uploads/origins/1074d719-ae12-4343-9bf4-b1928197ebd7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ae20d192c1b41c74cdbb25b94dac9d5 2x, https://si.imgix.net/2f192dde/uploads/origins/1074d719-ae12-4343-9bf4-b1928197ebd7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=37c5d4880dfdc6ebb0f1e144293825d0 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n私と私のパートナーのために、リーフェオンとシルヴィオンのアートワークが欲しいです。\nリーフェオンはヘビーボールで、シルヴィオンはヒールボールでプレイしてほしい。\nアニメーションは、リーフェオンがヘビーボールで遊ぶと重すぎて苦戦し、シルヴィオンがヒールボールで軽い怪我を治すという感じです。\n本当にかわいく、軽快にお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2761", "thumbnail_src": "https://si.imgix.net/76a9d6b7/uploads/origins/17456892-9952-4fcd-9ea1-6f1822f2ae1c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=80b36947f354b77d12de503629367310", "thumbnail_srcset": "https://si.imgix.net/76a9d6b7/uploads/origins/17456892-9952-4fcd-9ea1-6f1822f2ae1c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=80b36947f354b77d12de503629367310, https://si.imgix.net/76a9d6b7/uploads/origins/17456892-9952-4fcd-9ea1-6f1822f2ae1c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b162756d9bf45cebc58afcde3b44d478 2x, https://si.imgix.net/76a9d6b7/uploads/origins/17456892-9952-4fcd-9ea1-6f1822f2ae1c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec1da0cfcaf0be95e1fa53229f556a05 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ぜひまたアニメーションをお願いします！\n\nニャースカラダが私のカワウソのスポビーを抱きしめて撫でているアニメーションをお願いしたいのです！\nニャースカラダの表情は柔らかい笑顔で、スポビーは顔を赤くしてリラックスした幸せそうな表情をしています。\nスポビーの服装は、リファレンスシートの一番右にある帽子をかぶらずに、タートルネックのセーターを着ることができます。\n\nスポビーの参考資料\nhttps://drive.google.com/file/d/195ppuDdxbhYcDaSwcvN_zpFbG0-B2p0X/view?usp=drivesdk\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2760", "thumbnail_src": "https://si.imgix.net/de0c14d3/uploads/origins/92e1bede-e520-49cb-8d2a-c600de2e4209?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17205854c2f7f33df67cb25ea205bda3", "thumbnail_srcset": "https://si.imgix.net/de0c14d3/uploads/origins/92e1bede-e520-49cb-8d2a-c600de2e4209?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17205854c2f7f33df67cb25ea205bda3, https://si.imgix.net/de0c14d3/uploads/origins/92e1bede-e520-49cb-8d2a-c600de2e4209?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7478258bce3d353061a9d7448bb11375 2x, https://si.imgix.net/de0c14d3/uploads/origins/92e1bede-e520-49cb-8d2a-c600de2e4209?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb47b458afdc5258cc80d1f6d1280866 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2759", "thumbnail_src": "https://si.imgix.net/4337339d/uploads/origins/cf69978e-e394-4381-adb3-27809989eb15?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7ea551612185635782138d08bab32a87", "thumbnail_srcset": "https://si.imgix.net/4337339d/uploads/origins/cf69978e-e394-4381-adb3-27809989eb15?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7ea551612185635782138d08bab32a87, https://si.imgix.net/4337339d/uploads/origins/cf69978e-e394-4381-adb3-27809989eb15?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=741f2796619ad2aebfd1f7b17f518d15 2x, https://si.imgix.net/4337339d/uploads/origins/cf69978e-e394-4381-adb3-27809989eb15?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4775a920de0ad356bf58664a05918c3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！参考画像付きの依頼です。今回の依頼には2体のフラガトーが登場します。区別するため、一方を「R」、もう一方を「L」と呼びます。Rは成人女性で、人間からフラガトーに変身したポケモントレーナーです。LはRのポケモンの一体です。 Rはポケモンボールを手に、自身の変身に喜び、Lに新しい姿を見せようと待ちきれない様子です！ポケモンボールから送り出されたLは、トレーナーがポケモンに変身していることに驚いています！Rの近くには、人間だった頃の姿（添付リファレンスに基づく）の小さな落書きがあり、そこから矢印が伸びて新しいフローラガートの姿を指しています。Lは典型的なフローラガートの姿です。\n\nRは人間時の特徴を引き継いだフローラガートで、以下の点が異なる：- 長い茶色の人の髪（毛皮は緑のまま）- 茶色の瞳- 帽子（フローラガートの耳が帽子の新穴から突き出ている）- ベスト（シャツなし）- 肩掛けバッグ- ポケボール付きベルト- フローラガート形態のためシャツ・ズボン・靴なし\n\nhttps://imgur.com/a/pkjgtSC", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2758", "thumbnail_src": "https://si.imgix.net/8b9a955b/uploads/origins/79271768-cf5b-4cd7-bd89-d961098efa3b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfb99a08f2ba262406d1083c169f6185", "thumbnail_srcset": "https://si.imgix.net/8b9a955b/uploads/origins/79271768-cf5b-4cd7-bd89-d961098efa3b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfb99a08f2ba262406d1083c169f6185, https://si.imgix.net/8b9a955b/uploads/origins/79271768-cf5b-4cd7-bd89-d961098efa3b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e399efd88fe0b0dcd90ce8f86a658c5e 2x, https://si.imgix.net/8b9a955b/uploads/origins/79271768-cf5b-4cd7-bd89-d961098efa3b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02311b8d09b0e7b4cd85fca5f8ce3293 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2757", "thumbnail_src": "https://si.imgix.net/3a84bb20/uploads/origins/27ebf941-7a46-4199-af73-b1b0243e43a5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=3a2612dc3b3f07c7a5e8e8596a479bc7", "thumbnail_srcset": "https://si.imgix.net/3a84bb20/uploads/origins/27ebf941-7a46-4199-af73-b1b0243e43a5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=3a2612dc3b3f07c7a5e8e8596a479bc7, https://si.imgix.net/3a84bb20/uploads/origins/27ebf941-7a46-4199-af73-b1b0243e43a5?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=17fc80a99fae23112610e37976d4f5ad 2x, https://si.imgix.net/3a84bb20/uploads/origins/27ebf941-7a46-4199-af73-b1b0243e43a5?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9c91d1c2b5eaf3fd5af0a729fa7512d 3x", "genre": "art", "nsfw": false, "body": "「レイ」と「プディング」は寄り添い、愛情を込めて顔をこすり合わせると、ハートが現れる。二匹ともしっぽを振っている。プディングの興奮したしっぽと足がレイの大きな腹を軽く叩くと、レイの柔らかい体がわずかに波打つ。プディングのゼリーのような体は少し滴り落ち、形を保とうともがくが、それでも愛に満ちている。\n\n「レイ」参照:https://drive.google.com/file/d/1dgy9kYu51tf2OsFxBhHC0DyeXflp4hds/view?usp=drivesdk\n注：「レイ」の目はニンフィアの目に似ている。\n\n「プディング」参照：https://drive.google.com/file/d/18V6hCQh7APKqcWCUKq0ds83o9YYQVMb2/view?usp=drivesdk\n\nどうもありがとうございます！!\n\nhttps://drive.google.com/drive/folders/1hHrfPJX2vyPUT8cQWfnzQLAj_127lk3q", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2756", "thumbnail_src": "https://si.imgix.net/db8e20e0/uploads/origins/b8542467-93b0-4fed-a10b-fdb6b39241f4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=bd7a22414b22e5b3878882736c3d9ddd", "thumbnail_srcset": "https://si.imgix.net/db8e20e0/uploads/origins/b8542467-93b0-4fed-a10b-fdb6b39241f4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=bd7a22414b22e5b3878882736c3d9ddd, https://si.imgix.net/db8e20e0/uploads/origins/b8542467-93b0-4fed-a10b-fdb6b39241f4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=caea95c6e53b5b462378138a219cb384 2x, https://si.imgix.net/db8e20e0/uploads/origins/b8542467-93b0-4fed-a10b-fdb6b39241f4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5e793f2ef710c0fada9bf831f429176 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの作品の大大大ファンです！\n\nあなたのスタイルで私の虎のキャラクターを見てみたいです。\n\n以下の参照フォルダにある \"Dance.gif \"として、彼にダンスをさせてください。\n\nこの度はありがとうございました。\n\nhttps://drive.google.com/drive/u/0/folders/1RLrGXaaQQSjZ_9lkLtnocVqWKvtpwTYL", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2755", "thumbnail_src": "https://si.imgix.net/9377ad0e/uploads/origins/154b12a7-51bd-4c05-a944-b878083050d9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2ef6d43552fc5aca426fc30399d71be1", "thumbnail_srcset": "https://si.imgix.net/9377ad0e/uploads/origins/154b12a7-51bd-4c05-a944-b878083050d9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2ef6d43552fc5aca426fc30399d71be1, https://si.imgix.net/9377ad0e/uploads/origins/154b12a7-51bd-4c05-a944-b878083050d9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=370dc00f1a32489db95a2059b4582bd5 2x, https://si.imgix.net/9377ad0e/uploads/origins/154b12a7-51bd-4c05-a944-b878083050d9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb6b6cf570ad21aca66f6e4ead50c63d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ねこたろさん\n\n私のキャラクターdadoがマジックをするアニメーションを依頼したいのですが。\n\nコンセプトはこんな感じです：\n\ndadoは燕尾服を着て、マジシャンの帽子からウサギを出す。\n\nしかし、帽子から出てくるウサギの数が多すぎる。\n\nウサギは完全に画面を埋め尽くしている。\n\nウサギの数が増えるにつれ、ダドの表情は自信に満ち溢れたものから、ショックを受け怯えたものへと徐々に変化していく。\n\nリンク先の動画を参考にしてください。\n\n例のビデオ通りにする必要はありません。あくまで私が考えていることを説明するためのサンプルです。\n\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1z077l5g39ym9rJzdcOk_s8fk5XWnByYc?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2754", "thumbnail_src": "https://si.imgix.net/d98df2e6/uploads/origins/89c407f6-90be-4bb1-8e86-edb9515507c9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f377811149836da2152bd04143409083", "thumbnail_srcset": "https://si.imgix.net/d98df2e6/uploads/origins/89c407f6-90be-4bb1-8e86-edb9515507c9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f377811149836da2152bd04143409083, https://si.imgix.net/d98df2e6/uploads/origins/89c407f6-90be-4bb1-8e86-edb9515507c9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=540d75c4d3416db82405fc8e6520df6f 2x, https://si.imgix.net/d98df2e6/uploads/origins/89c407f6-90be-4bb1-8e86-edb9515507c9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c133bdb8b70d4658fa0d5ac6f0c4111f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつもお世話になっております！\n今回はうちの子のレオンハルトがガラス越しでこちらを舐め回すアニメーションお願い出来ますでしょうか…！詳細や構図などについてはおまかせします。よろしくお願いします！\n\nhttps://x.com/electeclair/status/1672973171790843911", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2753", "thumbnail_src": "https://si.imgix.net/f139ce29/uploads/origins/95a9f315-ea8a-48dd-bbfb-db950b1aa044?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=23afa2fcf52e6923914c359ef7c3f519", "thumbnail_srcset": "https://si.imgix.net/f139ce29/uploads/origins/95a9f315-ea8a-48dd-bbfb-db950b1aa044?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=23afa2fcf52e6923914c359ef7c3f519, https://si.imgix.net/f139ce29/uploads/origins/95a9f315-ea8a-48dd-bbfb-db950b1aa044?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e18f296217d47b55ccc1074312bb147a 2x, https://si.imgix.net/f139ce29/uploads/origins/95a9f315-ea8a-48dd-bbfb-db950b1aa044?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=03d9a573e47f082e7ba2f39caebb0b38 3x", "genre": "art", "nsfw": false, "body": "再び依頼させていただきます！ドラガリアロストのドラゴンのブリュンヒルデのかわいいイラストをお願いします。動きなどはお任せでよろしくお願いします。\n\nhttps://dragalialost.com/sp/jp/dragon/brunhild/", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2752", "thumbnail_src": "https://si.imgix.net/97b37a29/uploads/origins/68a276bc-7155-44e1-bb6f-22244bb386f7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4a30245d30d6b12b5add0adeb0b4f759", "thumbnail_srcset": "https://si.imgix.net/97b37a29/uploads/origins/68a276bc-7155-44e1-bb6f-22244bb386f7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4a30245d30d6b12b5add0adeb0b4f759, https://si.imgix.net/97b37a29/uploads/origins/68a276bc-7155-44e1-bb6f-22244bb386f7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2a4743f154b2d4cb642ed39c242cf31 2x, https://si.imgix.net/97b37a29/uploads/origins/68a276bc-7155-44e1-bb6f-22244bb386f7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff21d6bd089e7fe7e3b64d66adc854fc 3x", "genre": "art", "nsfw": false, "body": "前回は本当にありがとうございました！\n今回は、もう一つの膨張アニメーションを見たいのですが、前回のリクエストとは少し異なります。たまごっちのピアニっちが見たいです、下半身が大きくなったせいで、足取りが重くて地面が割れてしまう！本当に恥ずかしい表情をしてほしいです！\n海外では下半身だけが膨らむ「monobutt」（頬のないお尻の意味）というニッチなサブジャンルの膨張があります。ここにいくつか例を挙げますが、構成は各自にお任せします：https://imgur.com/a/drbulwG。\n残りの詳細はあなたにお任せします！本当に楽しみにしてます…！！", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2751", "thumbnail_src": "https://si.imgix.net/2693868d/uploads/origins/5b539abd-91e6-4697-912a-edcc87a8c6df?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=730b7891e4ba67d4d4900bd9a2b0eb8f", "thumbnail_srcset": "https://si.imgix.net/2693868d/uploads/origins/5b539abd-91e6-4697-912a-edcc87a8c6df?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=730b7891e4ba67d4d4900bd9a2b0eb8f, https://si.imgix.net/2693868d/uploads/origins/5b539abd-91e6-4697-912a-edcc87a8c6df?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e125bbacef18824e1e7cb2b0fd89437a 2x, https://si.imgix.net/2693868d/uploads/origins/5b539abd-91e6-4697-912a-edcc87a8c6df?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d77ccdc7ee632b6690a880f23f235955 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2750", "thumbnail_src": "https://si.imgix.net/63fd6a24/uploads/origins/c0109b21-79df-4122-aacf-02621772c004?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9eda447d456b6d61fdd8becf2251314c", "thumbnail_srcset": "https://si.imgix.net/63fd6a24/uploads/origins/c0109b21-79df-4122-aacf-02621772c004?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9eda447d456b6d61fdd8becf2251314c, https://si.imgix.net/63fd6a24/uploads/origins/c0109b21-79df-4122-aacf-02621772c004?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ec4fbb16613217196e929c28cd227c1 2x, https://si.imgix.net/63fd6a24/uploads/origins/c0109b21-79df-4122-aacf-02621772c004?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=13e01a60b4dcf066a94bb4cf0fdac70c 3x", "genre": "art", "nsfw": false, "body": "依頼失礼します,自力で動けるか怪しいぐらい丸々と太ったイーブイとニンフィアをお願いしたいです。\n構図は仰向け状態のニンフィアの大きなお腹の上にイーブイが乗ってお腹合わせ状態になっている。表情は二匹とも丸々と太った事を恥ずかしがってる感じでお願いしたいです〜。\nよろしくお願いします〜", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2749", "thumbnail_src": "https://si.imgix.net/26b06f5e/uploads/origins/415266de-2fc4-4612-8c35-34e0bdf00b55?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2bc5b2bc2a5148999d4ee873dc3f3131", "thumbnail_srcset": "https://si.imgix.net/26b06f5e/uploads/origins/415266de-2fc4-4612-8c35-34e0bdf00b55?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2bc5b2bc2a5148999d4ee873dc3f3131, https://si.imgix.net/26b06f5e/uploads/origins/415266de-2fc4-4612-8c35-34e0bdf00b55?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=cff000341174062a52d2df8c329bdd60 2x, https://si.imgix.net/26b06f5e/uploads/origins/415266de-2fc4-4612-8c35-34e0bdf00b55?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ca66da55ef7d06f55c7488872af5685 3x", "genre": "art", "nsfw": false, "body": "こんにちは。僕のOC、スティービーとホニーを君のスタイルで見てみたいんだ。\n\nStevieは黒のコッカースパニエルで、Honnieは金色のオカメインコです。\n\nHonnieが興奮して左右に飛び回り、Stevieと遊びたがっているのに、Stevieは座って彼女を見つめているところを見たいんだ。\n\nhttps://drive.google.com/drive/folders/1si99J1-BVInt_sMfVjHoGhqlmYSqoVZu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2748", "thumbnail_src": "https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2c5b937c0429099ff78ecb51cb67c18a", "thumbnail_srcset": "https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2c5b937c0429099ff78ecb51cb67c18a, https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e78a808c84cc1898a17dd83da7baf85e 2x, https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=12cb854dc4c94d6c6b9dea0356efc008 3x", "genre": "art", "nsfw": false, "body": "こんにちは！時兔と申します。\nTwitter（X）であなたのアニメーション作品を見つけ、とても気に入りました！\n\n私のキャラクターを描いて、アニメーションで命を吹き込んでいただけませんか？\n一番見てみたいのは、しっぽがゆるやかに揺れるところです。\n\nそれ以外の動きに関しては、あなたの創造力にお任せしたいと思っています。\nありがとうございました！\n\n参考リンクはこちらです：\nhttps://drive.google.com/file/d/1LTWg-F-k1MguXkJ_TjH8iZmR9JluhS6m/view?usp=sharing\n\nhttps://drive.google.com/file/d/1rowJ4cFzDRh4zJH5RFJ0kRb8GckzZ0r5/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2747", "thumbnail_src": "https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dcc7c934b9a3f8d75c36f6b8b85bbe09", "thumbnail_srcset": "https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dcc7c934b9a3f8d75c36f6b8b85bbe09, https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7e88a16c2f414e17b6dcb6e19404baa 2x, https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=32c947a8fd07ab0b53a9bbaa2b96104a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵は素晴らしくて素晴らしいので、私の犬のOCを描いてもらえないかと思っています！\n\nもしリファレンスよりもう少しぽっちゃりしてくれたら嬉しいな :3\n\nポーズとしては、彼が腹ばいになって、床に近いところでチャブフラップの折り目が見えるようにするとか！あるいは、あなたが望むなら、あなた自身のアイデアを作ることもできる :>\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1PVRuf2mP6COcmEQuAbdnAauvmohHBtzP", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2746", "thumbnail_src": "https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc266c03e2b92eb2839e043b97bc9432", "thumbnail_srcset": "https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc266c03e2b92eb2839e043b97bc9432, https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e558ca1a1a36ce12d9a1aa82187acb22 2x, https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=c