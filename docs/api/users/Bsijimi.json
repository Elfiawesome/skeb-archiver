0f96a2-37d0-4b86-8606-6d668a87ffdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=072c62b8796f459abdbf6ac9b0688246", "thumbnail_srcset": "https://si.imgix.net/4faf4fff/uploads/origins/0f0f96a2-37d0-4b86-8606-6d668a87ffdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=072c62b8796f459abdbf6ac9b0688246, https://si.imgix.net/4faf4fff/uploads/origins/0f0f96a2-37d0-4b86-8606-6d668a87ffdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6af067ccfb48bdbdc302614369aaf01 2x, https://si.imgix.net/4faf4fff/uploads/origins/0f0f96a2-37d0-4b86-8606-6d668a87ffdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=226ef698691c5dba8af77447211e099f 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\n遅ればせながらリクエストさせていただきます。\n\n依頼内容ですが、おまかせでソプルくんを描いていただきたいと思います。\nシチュとか服装とか、すべておまかせでお願いいたします。\n\nソプルくんは紫色の右目と緑色の左目を持つ水色のセミロングヘアの男の娘です。壮大な魔力により、シャボン玉が変形して生まれたため、全身が瑞々しく肌は少し白い。普段は水色のハーフパンツに白いTシャツ、家から出る時は犬耳犬尻尾付きの光の当たり具合で所々が虹色に輝く白い撥水レインコートとレインブーツを着用している。元シャボン玉ということもあり、暑さも寒さも全く感じないため、季節に関係なくこの姿でいることが多い。紫色の右目には、異性を魅了する力があるため、普段は前髪で隠している。ちなみに、傘が好きで色んな傘を集めているらしい。詳細はpixivの設定資料をご覧ください。\n\nあと、宛名については、ゆゆにゃんへ、とさん付けなしでお願いいたします。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/123502936", "created_at": "", "completed_at": ""}, {"path": "/@Bsijimi/works/1", "thumbnail_src": "https://si.imgix.net/693edfc3/uploads/origins/2ecb73ab-40d6-4296-9ca5-0ffd0b49fee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da8df95f2432c26905582dce75324687", "thumbnail_srcset": "https://si.imgix.net/693edfc3/uploads/origins/2ecb73ab-40d6-4296-9ca5-0ffd0b49fee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da8df95f2432c26905582dce75324687, https://si.imgix.net/693edfc3/uploads/origins/2ecb73ab-40d6-4296-9ca5-0ffd0b49fee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fd4ed3b2134f94d0b8271e3c2c53172 2x, https://si.imgix.n