5b-afb4-593f98a30b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e832f9d91f34be2f6eeace64e3fbef", "thumbnail_srcset": "https://si.imgix.net/37b445f4/uploads/origins/f19d2d72-e479-4e5b-afb4-593f98a30b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e832f9d91f34be2f6eeace64e3fbef, https://si.imgix.net/37b445f4/uploads/origins/f19d2d72-e479-4e5b-afb4-593f98a30b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53b0d31e1b760038bf73c4cd6c64fba7 2x, https://si.imgix.net/37b445f4/uploads/origins/f19d2d72-e479-4e5b-afb4-593f98a30b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de10b1a1912404181f54d468f65fcefd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつも素敵なイラストをありがとうございます！あなたの創作物が更新されるのをいつも楽しみにしています！\n\nリクエストなのですが、うちの飼い猫の獣人化イラストをお願いしたいです。\nメスのアビシニアンで”サクラ”といいます、落着きとお転婆さが入り混じった子です。\n構図やお衣装などはお任せでお願いします！\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-8heBoo1M31TO27nhmNDEBd0RLcdu-oJ", "created_at": "", "completed_at": ""}, {"path": "/@namagakiokami/works/39", "thumbnail_src": "https://si.imgix.net/5b4b03da/uploads/origins/22d1a77d-4fc3-4d35-94fc-e45d5baaa1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73ee53a9aa50556c70bd3392404f068", "thumbnail_srcset": "https://si.imgix.net/5b4b03da/uploads/origins/22d1a77d-4fc3-4d35-94fc-e45d5baaa1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73ee53a9aa50556c70bd3392404f068, https://si.imgix.net/5b4b03da/uploads/origins/22d1a77d-4fc3-4d35-94fc-e45d5baaa1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e19facf68005f1e96b1987dcfed7fd2d 2x, https://si.imgix.net/5b4b03da/uploads/origins/22d1a77d-4fc3-4d35-94fc-e45d5baaa1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa5599553aca03726c30882798312e17 3x", "genre": "art", "nsfw": false, "body": "こんにちは、枯れ葉です。\n先日は水着クロノをありがとうございました。\nこの度はうちの子で私の代理を元にした派生キャラのバルキリーカレハというユキヒョウの女の子をお願いしたいと思います。\n川沿いの岩場で槍を近くの大きな岩に立て掛けて、余裕たっぷりの笑顔を見せながら岩に腰かけて休息を取っている姿を描いていただきたく思います。\n槍は穂先まで描かれていると助かります。\nまた、爪先は写っておりませんが、サンダルを履いております。\nご一考のほど、よろしくお願いいたします。\n\nhttps://twitter.com/KarehaGz/status/1439969673676668929?t=7j91TzjM3oqqOPjEh9NgfQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@namagakiokami/works/38", "thumbnail_src": "https://si.imgix.net/25c052ea/uploads/origins/cb6eef2f-43fa-4692-ba16-a079a29d804e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8107c2d46fb613e59a35ec36d66e0b4d", "thumbnail_srcset": "https://si.imgix.net/25c052ea/uploads/origins/cb6eef2f-43fa-4692-ba16-a079a29d804e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8107c2d46fb613e59a35ec36d66e0b4d, https://si.imgix.net/25c052ea/uploads/origins/cb6eef2f-43fa-4692-ba16-a079a29d804e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daffc9066ef5cfd05720b0ddfc61f1f7 2x, https://si.imgix.net/25c052ea/uploads/origins/cb6eef2f-43fa-4692-ba16-a079a29d804e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=362fb81d5a6674a33462b1bde9d530fe 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、枯れ葉です。\n以前描いていただいたことのあるオリキャラのクロノの水着イラストをリクエストしたく、ご連絡をさせていただきました。\nアイスキャンディで隠れていますが、黒いシンプルなブロック型のペンダントを身に付けています(こちらのツイートのイラストの、腰布衣裳版のものと同じペンダントです【https://twitter.com/KarehaGz/status/1419181351509499905?t=BN0UAmn3M6Tevc_UASnejQ&s=19】)\nアイスキャンディを片手に待ち合わせをしているような構図でお願いしたく思います。(待ち合わせ相手が来たときのリアクションとしては「あ、来た」程度の軽めの感じでお願いしたいです。)\nご一考のほど、よろしくおねがいします。\n\nhttps://twitter.com/KarehaGz/status/1424004582301077508?t=oaCNvgKyPy4n7iUCxFkoOw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@namagakiokami/works/37", "thumbnail_src": "https://si.imgix.net/1b25b0ee/uploads/origins/69d9726e-175b-4601-8ea6-d1ac0a25d5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3897a424f0939f971118c00cc5de757", "thumbnail_srcset": "https://si.imgix.net/1b25b0ee/uploads/origins/69d9726e-175b-4601-8ea6-d1ac0a25d5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3897a424f0939f971118c00cc5de757, https://si.imgix.net/1b25b0ee/uploads/origins/69d9726e-175b-4601-8ea6-d1ac0a25d5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee569e6526a0ae39c1cff9017c88e389 2x, https://si.imgix.net/1b25b0ee/uploads/origins/69d9726e-175b-4601-8ea6-d1ac0a25d5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c975d97d00edb98c957257a5db057b22 3x", "genre": "art", "nsfw": false, "body": "あなたの毛皮のようなキャラクターアートが大好きです。\n僕のOCのイーライを君のスタイルにしてもらえないかな？\n彼はイヌ科の人間です。メガネをかけていて、クリスタルのペンダントを持っている。いつも短パンに襟付きのTシャツを着ている。彼の大まかなイメージを作るのにベストを尽くしたよ。\n彼は自然な感じで何をしていてもよく、全体的にのんびりしています。\nリクエストに応えてくれてありがとう。\n\nhttps://drive.google.com/file/d/1T8DxMg1XBhXnr3o7EkGFaaqvmfRUVfO2/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@namagakiokami/works/36", "thumbnail_src": "https://si.imgix.net/cfc9c615/uploads/origins/dba95711-a6a2-4694-94c5-79d45801a0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8d4d52ba7c359fe6606e07f6488c018", "thumbnail_srcset": "https://si.imgix.net/cfc9c615/uploads/origins/dba95711-a6a2-4694-94c5-79d45801a0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8d4d52ba7c359fe6606e07f6488c018, https://si.imgix.net/cfc9c615/uploads/origins/dba95711-a6a2-4694-94c5-79d45801a0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bfa8df14e64e2d6a44e65c2847c769f 2x, https://si.imgix.net/cfc9c615/uploads/origins/dba95711-a6a2-4694-94c5-79d45801a0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d574e7ec91f0578da0fb8f0f5dcfe8b 3x", "genre": "art", "nsfw": false, "body": "いい日だ！\n私はあなたのアートが大好きです！\n私の2人のOCをかわいい画像で見てみたいです。\n狼女ラチルダ: https://i.lensdump.com/i/ECMI3c.png\nウサギ男フランツ： https://lensdump.com/a/EF3Ta\n\nイメージとしては、フランツはラチルダより背が低いので、お姫様抱っこをしているようなイメージです。\nそこで、大柄な女性が小柄な男性をお姫様のように抱っこしているイメージで、https://i.imgur.com/9KyAnlC.png。\n\nラチルダはフランツをよく可愛がっているので、このようなイメージになるのかなと思います。\n元々ラチルダはフランツの敵だったのですが、戦った結果、ラチルダは代わりにフランツを守ることにしたそうです。\n\nポーズは自由に調整してください。\n\n細かいところは、皆さんの判断にお任せします！\n\n複雑な背景は必要ありません。", "created_at": "", "completed_at": ""}, {"path": "/@namagakiokami/works/35", "thumbnail_src": "https://si.imgix.net/1bb26bb6/uploads/origins/1e46b60b-46ea-47f2-8e50-802f0d031f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2379298b968e89cf85424744eff5ca3", "thumbnail_srcset": "https://si.imgix.net/1bb26bb6/uploads/origins/1e46b60b-46ea-47f2-8e50-802f0d031f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2379298b968e89cf85424744eff5ca3, https://si.imgix.net/1bb26bb6/uploads/origins/1e46b60b-46ea-47f2-8e50-802f0d031f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d244d04bb2088974bf54006e2e146b27 2x, https://si.imgix.net/1bb26bb6/uploads/origins/1e46b60b-46ea-47f2-8e50-802f0d031f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ecd8333cb6b720254e1f6c181e4ea6c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私を受け入れてくれてありがとう。ウサギと犬が混ざった男の人ですが、かわいいスタイルで描いても大丈夫です。 4枚目の画像の服装でファンタジーに登場するプリースト感でお願いします。描画する際の注意点は次のとおりです。上体が小さく、下半身が大きい。 /大きな眉毛がない。 /ジト目/ウサギなので肉球が無い。 /歯はウサギではなく犬の歯/指4本。 /ネックレスは必須です。よろしくお願いします！\n\nhttps://twitter.com/Leuro_v/status/1624035681747226624?s=20", "created_at": "", "completed_at": ""}, {"path": "/@namagakiokami/works/34", "thumbnail_src": "https://si.imgix.net/a773d8bd/uploads/origins/d7ee3904-60d4-44e2-b005-7cc3a2d19738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c5d1674e1283e4cc17753f4c71aafc9", "thumbnail_srcset": "https://si.imgix.net/a773d8bd/uploads/origins/d7ee3904-60d4-44e2-b005-7cc3a2d19738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c5d1674e1283e4cc17753f4c71aafc9, https://si.imgix.net/a773d8bd/uploads/origins/d7