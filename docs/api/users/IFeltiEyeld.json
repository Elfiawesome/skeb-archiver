2-a1ed-4ec4-8f81-0f3aff29a2ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=723addede9c07271b9f8226f9dcbe003", "thumbnail_srcset": "https://si.imgix.net/c0d49c51/uploads/origins/de9607a2-a1ed-4ec4-8f81-0f3aff29a2ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=723addede9c07271b9f8226f9dcbe003, https://si.imgix.net/c0d49c51/uploads/origins/de9607a2-a1ed-4ec4-8f81-0f3aff29a2ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dbd2eb92597fac54b94b1007a820ab2 2x, https://si.imgix.net/c0d49c51/uploads/origins/de9607a2-a1ed-4ec4-8f81-0f3aff29a2ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e896c7571ed9464d285c203ae704911b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！twitchで配信している時にあなたの絵を見て、とても驚きました！私のvtuberのペルソナを描いてほしいです！今の服か新しい服、もしくはユニークな服を描いてください！ポーズも自由です！以下に参考画像のリンクを貼っておきます！\n\nhttps://imgur.com/a/HfphOax", "created_at": "", "completed_at": ""}, {"path": "/@IFeltiEyeld/works/33", "thumbnail_src": "https://si.imgix.net/6d4ecdd6/uploads/origins/7e94a762-7a0f-4389-a4c1-60d61ef82a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42414d1f27f562ccd500f3f7c279cd1c", "thumbnail_srcset": "https://si.imgix.net/6d4ecdd6/uploads/origins/7e94a762-7a0f-4389-a4c1-60d61ef82a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42414d1f27f562ccd500f3f7c279cd1c, https://si.imgix.net/6d4ecdd6/uploads/origins/7e94a762-7a0f-4389-a4c1-60d61ef82a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c121461dce95bc9c3e8e3c826eaac61b 2x, https://si.imgix.net/6d4ecdd6/uploads/origins/7e94a762-7a0f-4389-a4c1-60d61ef82a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b17eef22c8acc2e9264b1a6db335f434 3x", "genre": "art", "nsfw": false, "body": "こんにちは、以下のツイートの画像のようにトリミングできる可能性のあるドローイングをお願いしたいのですが。\n\nhttps://x.com/LLR_ONI/status/1804645529139265798\n\n具体的には、少なくとも真正面からのポーズで、胸を強調したものが欲しいです。欲しいキャラクターデザインは以下のツイートにありますが。\n\nhttps://x.com/LLR_ONI/status/1632901401541058560\n\n服装に関しても、胸元が強調されたものがいいですね。ファスナーの開いてないパーカーの下にビキニトップとか。夏っぽい感じで。プールサイドとか。バニースーツみたいなのもいいかもしれないけど。もともとのアイデアは、実はブルー・アーカイブのバニー・ネルをこういう絵にすることだったので、そのプランにハマりそうです。\n\nいずれにせよ、お任せします。また、デザイン参考画像にはないディテールをいくつか挙げると、袖の下の包帯の端はセーターと同じロゴが入っていますが、赤色です。腕自体は上腕の真ん中まで赤色で、指の爪は黒色です。細かいところではありませんが、セーターのロゴ（または似たようなもの）が胸の真ん中あたりにあるといいかもしれません。基本的に胸骨の上とかね。でも、それは必須のディテールではありません。\n\n作業を検討してくれてありがとう。もし私がこれを使いたいコントローラーの具体的なリファレンスで作業したいのであれば、それはHaute42 T13です。彼らのウェブサイトにそのPSDがあると思います。\nhttps://haute42.com/", "created_at": "", "completed_at": ""}, {"path": "/@IFeltiEyeld/works/32", "thumbnail_src": "https://si.imgix.net/0575a3a8/uploads/origins/268e45ef-5d35-4373-85b6-dffb0ab7df06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdb796aca54640d9e55ce35dd96b33cc", "thumbnail_srcset": "https://si.imgix.net/0575a3a8/uploads/origins/268e45ef-5d35-4373-85b6-dffb0ab7df06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdb796aca54640d9e55ce35dd96b33cc, https://si.imgix.net/0575a3a8/uploads/origins/268e45ef-5d35-4373-85b6-dffb0ab7df06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c1af541f74b035b763710fd74cd29a8 2x, https://si.imgix.net/0575a3a8/uploads/origins/268e45ef-5d35-4373-85b6-dffb0ab7df06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc83c5628824162bb2e06ddf809eedf3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私の猫娘ルマのイラストを依頼したいと思いました。彼女は誰もが動物の耳と尻尾を持っている世界のアイドルなので、彼女の猫耳と尻尾は本物で、人間の耳はありません。\n\n私は、ルマがフリフリの花柄の服を着せられて、恥ずかしがったり、その服のせいで視聴者に怒られたりするイメージを撮りたかった。彼女は注目されるのは好きだけど、着せ替え人形のように扱われるのは好きじゃないんだ。\n\n彼女のベースデザインのキャラクターリファレンスと一緒に、いくつかの服のリファレンスを添付しました。彼女の髪で少し遊ぶこともできると思っていて、おさげとしっぽに大きなフリフリのリボンをつけて、見た目にアクセントを加えようと思っているんだ。彼女の主なアイドル・カラーはオレンジと黄色だが、この作品ではピンクや赤を着せてみようかと考えている。また、彼女の周りにぬいぐるみなどのかわいいものを置いて、美的感覚を高めることもできるだろう。\n\nポーズや表情、おさげのスタイルも自由に変えてみてください。\n\nhttps://imgur.com/a/BikcRpc", "created_a