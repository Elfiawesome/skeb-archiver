45-b0f8-54e89f9928bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c71c3e24d2292ef91291a89ab5e9514 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@doinakaLB5SGI/works/28", "thumbnail_src": "https://si.imgix.net/6d0bf39f/uploads/origins/2a292bde-852c-44cf-a364-22afda973a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7707b07595fb934141b6e5979711a88", "thumbnail_srcset": "https://si.imgix.net/6d0bf39f/uploads/origins/2a292bde-852c-44cf-a364-22afda973a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7707b07595fb934141b6e5979711a88, https://si.imgix.net/6d0bf39f/uploads/origins/2a292bde-852c-44cf-a364-22afda973a06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30903e7a230abd54b034dca9c7ee48a5 2x, https://si.imgix.net/6d0bf39f/uploads/origins/2a292bde-852c-44cf-a364-22afda973a06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aee2801187ca7dc97c50e3291fafb582 3x", "genre": "art", "nsfw": true, "body": "こんにちは！前回のアートが好きだった！ということで、また別の作品もお願いしたいと思います！\n\nキヤトルは裸エプロン姿で、食事の準備をしている最中だ。\nhttps://catbox.moe/c/pmcgdw\n例 - https://files.catbox.moe/utplp0.png\n\nひょっとして彼女の腹筋の輪郭がエプロンから透けて見えたり、エプロンが彼女の大きな胸に垂れ下がって腹筋が見えてしまったりするかも？エプロンに牛のデザインもかわいいだろう！\n\n前回同様、彼女のポーズや表情を自由に選んでください。\n\n改めて、お時間をいただきありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@doinakaLB5SGI/works/27", "thumbnail_src": "https://si.imgix.net/c754f0f7/uploads/origins/7bfac123-c4ad-4226-9521-63cdf217f9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18779784584e0e064192851d648885a5", "thumbnail_srcset": "https://si.imgix.net/c754f0f7/uploads/origins/7bfac123-c4ad-4226-9521-63cdf217f9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18779784584e0e064192851d648885a5, https://si.imgix.net/c754f0f7/uploads/origins/7bfac123-c4ad-4226-9521-63cdf217f9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e75e16800c4b5f092d493e6a77b090c 2x, https://si.imgix.net/c754f0f7/uploads/origins/7bfac123-c4ad-4226-9521-63cdf217f9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2536a374a948abb7f441884a61912cfd 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！\n前回の私のキャラクターの写真は素晴らしかったです！また絵をお願いしたいのですが、私のキツネの女の子、スズとの仕事に興味はありますか？\n\n彼女は本当に音楽を演奏するのが大好きな内気な狐の女の子です！\n彼女の胸をガラスに押し付けて、店の窓越しに音楽の本をじっと見ているようなシチュエーションが見てみたいです。彼女の胸はとても大きいので、ガラスに押し付けられている間、胸の谷間がはっきりと見えるはずだ。\n\nご配慮ありがとうございました！\nすずさんのリファレンスはこちらに置かせていただきます：\nhttps://skeb.jp/@suhey345/works/34", "created_at": "", "completed_at": ""}, {"path": "/@doinakaLB5SGI/works/26", "thumbnail_src": "https://si.imgix.net/899c89fa/uploads/origins/7fea8a08-4e9f-4913-88da-f553cc0a9b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31c0023b2fc07430518e2e570c02c016", "thumbnail_srcset": "https://si.imgix.net/899c89fa/uploads/origins/7fea8a08-4e9f-4913-88da-f553cc0a9b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31c0023b2fc07430518e2e570c02c016, https://si.imgix.net/899c89fa/uploads/origins/7fea8a08-4e9f-4913-88da-f553cc0a9b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=959b94b9dc11527a4e5dbfd64334e821 2x, https://si.imgix.net/899c89fa/uploads/origins/7fea8a08-4e9f-4913-88da-f553cc0a9b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea88444a39ad4be3480d0316df5e09eb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！モンスター娘のいる日常』のキャトルが水着を着ているアートをリクエストしたい。\nhttps://catbox.moe/c/pmcgdw\n\n水着もこれと似たような感じで、牛柄の模様が入っています。\nhttps://files.catbox.moe/zzl59d.jpg\n\n彼女のポーズや表情はあなた次第。\n彼女はあなたのこれまでの作品と同じように、非常に大きなプロポーションを持つことができる。\n\nお時間とご配慮をありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@doinakaLB5SGI/works/25", "thumbnail_src": "https://si.imgix.net/9f6e7a46/uploads/origins/b14b19c4-41f2-4acd-8f22-470350166690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40306083312dda5f2770d266c4e2ddd", "thumbnail_srcset": "https://si.imgix.net/9f6e7a46/uploads/origins/b14b19c4-41f2-4acd-8f22-470350166690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40306083312dda5f2770d266c4e2ddd, https://si.imgix.net/9f6e7a46/uploads/origins/b14b19c4-41f2-4acd-8f22-470350166690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3089c02f31a817e2124d2eea9ece164f 2x, https://si.imgix.net/9f6e7a46/uploads/origins/b14b19c4-41f2-4acd-8f22-470350166690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=482a14432fc087151670982e5013697c 3x", "genre": "art", "nsfw": false, "body": "以前描いて貰った、るかちゃんまりりんちゃんのママみあるイラストを再度リクエストさせてください!\n2人が裸エプロンで母性剥き出しでにじり寄ってくる構図でお願いします。\n\nるかちゃん\n右側で左手でおしゃぶりを摘まんで見下ろしている\nまりりんちゃん\n左側で両手で紙オムツを持って上目遣い\n両者ともエプロンをはだけて片乳を露出させている(るかちゃん右乳、まりりんちゃん左乳)\n露出している乳同士がむにゅりむにゅりと触れ合うことで曲線を描く状態に\n露出している乳にはニップルシールで片乳全体が隠れた状態に\n「ママ達がぁ♥」　「たぁっぷり可愛がってあげる♥」　「こんなにおっきくしちゃって♥」\nといった雰囲気が伝わるようにして下さい。全体的にピンク系の強い配色だと嬉しいです。\n余力があれば差分で、両者の目のハイライトの消えた、全体的に暗めのトーンのバージョンもお願いします。\n100%改変OKです。\nどうかご検討のほどお願いします。", "created_at": "", "completed_at": ""}]}