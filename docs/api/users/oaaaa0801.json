mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f1130b18a2f5a907b7c4e4d5b0ed3f4 2x, https://si.imgix.net/fbc9137a/uploads/origins/efff38ea-96b8-4a92-aea3-5280012c0a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da6b1d3c67444c211a7552c72878eb8d 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\nアピールありがとうございます。一人または複数の黒人男性が登場するNTRシナリオをお願いしたいのですが......。\n\nこの水着を着たエマ・ヴェルデとのNTRシナリオをお願いします。あまり参考資料がないので、下は想像にお任せします。ヒールも履いてほしい。\n\nhttps://drive.google.com/drive/folders/1FIMtpojWVN3AesOpGGbdUXOSikl17vU9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oaaaa0801/works/102", "thumbnail_src": "https://si.imgix.net/1a94cbe7/uploads/origins/f7c29e5a-24a3-4645-84c3-739ce284de75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2e180884f8e2fd8b224bf1634552c1c", "thumbnail_srcset": "https://si.imgix.net/1a94cbe7/uploads/origins/f7c29e5a-24a3-4645-84c3-739ce284de75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2e180884f8e2fd8b224bf1634552c1c, https://si.imgix.net/1a94cbe7/uploads/origins/f7c29e5a-24a3-4645-84c3-739ce284de75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79bfc19d8694b41013e76033123d0f55 2x, https://si.imgix.net/1a94cbe7/uploads/origins/f7c29e5a-24a3-4645-84c3-739ce284de75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=531f95cd5dc81bd8a852525fd4043893 3x", "genre": "art", "nsfw": true, "body": "こんばんは\n今回も描いて頂きたいのはメギド72のゼパルですhttps://megido72wiki.com/index.php?%E3%82%BC%E3%83%91%E3%83%AB\n\nシチュエーションですが、水で服が濡れて胸が透けて見えてるゼパルをお願い致します\n\nご検討の程よろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@oaaaa0801/works/101", "thumbnail_src": "https://si.imgix.net/5ae601df/uploads/origins/9581c788-fd6e-4ecf-9b47-85bda6d7a4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf85f05cbbc1adc3314f6c637ab159e8", "thumbnail_srcset": "https://si.imgix.net/5ae601df/uploads/origins/9581c788-fd6e-4ecf-9b47-85bda6d7a4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf85f05cbbc1adc3314f6c637ab159e8, https://si.imgix.net/5ae601df/uploads/origins/9581c788-fd6e-4ecf-9b47-85bda6d7a4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e661de483d4c4ae5274dcc3fbd3ce92a 2x, https://si.imgix.net/5ae601df/uploads/origins/9581c788-fd6e-4ecf-9b47-85bda6d7a4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cbe74560c8f7d85581d785d95c49096 3x", "genre": "art", "nsfw": true, "body": "東方旧作の赤髪魔理沙のひょっとこフェラをお願いします。\n・ひょっとこフェラ中、目元は1.2.3の資料のように真剣そうな感じに\n・口はハティミツさんの可能な限り伸ばしてほしい。一枚目の赤いチャイカがすごく良かったです\n・耳飾り、長い耳をお願いしたくほんの少しでもピッチリ衣装が見えて着てることが分かれば更に嬉しい。帽子などは省略可\n・構図は二枚目の綾波のような感じでお願いしたい。難しい場合は描きやすい構図で\nhttps://hatelimitu.fanbox.cc/posts/8536842\nhttps://hatelimitu.fanbox.cc/posts/2707400\nhttps://skeb.jp/@hatelimitu/works/52\nhttps://skeb.jp/@hatelimitu/works/7\n\nhttps://ibb.co/LDQZDZx7\nhttps://ibb.co/99Zy6Fq4\nhttps://ibb.co/1GBpGynR\nhttps://ibb.co/xqXTng2J\nhttps://ibb.co/WNLPp0R1", "created_at": "", "completed_at": ""}, {"path": "/@oaaaa0801/works/100", "thumbnail_src": "https://si.imgix.net/84ca7630/uploads/origins/42655a01-75c8-4cfe-b2ab-b4397087130a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69dcb5ea9ea4592a3c9cf2de287438d0", "thumbnail_srcset": "https://si.imgix.net/84ca7630/uploads/origins/42655a01-75c8-4cfe-b2ab-b4397087130a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69dcb5ea9ea4592a3c9cf2de287438d0, https://si.imgix.net/84ca7630/uploads/origins/42655a01-75c8-4cfe-b2ab-b4397087130a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3281c2fae92dfc01f83a3a54b44f01d6 2x, https://si.imgix.net/84ca7630/uploads/origins/42655a01-75c8-4cfe-b2ab-b4397087130a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c40d3f66d1721c5092b20f9cbb967c99 3x", "genre": "art", "nsfw": true, "body": "Hello、前回の依頼の続きをお願いしたいです！\n前回の依頼：https://skeb.jp/@oaaaa0801/works/99\n\nハスミの生徒手帳風のH profile page2のイラストをリクエストします。\n\n今回の依頼構圖：https://drive.google.com/file/d/1O7RsKJFmBreAK_0c4pZKFrMuTilPp8H-/view?usp=drivesdk\n\n左側のページは前回の写真をそのまま使用しますが、母乳を追加して(母乳が陥没乳首から溢れ出してる表現をお願いしたいです)、空白部分に乳首の異なる状態の比較を入れてください。\n（乳暈の測定値は28~30cmです。乳頭はあまり大きく描かないでください。）\n\n右のページは横面図です。\n空白の部分には、彼女の子宮口と膣を測定している図が展示されています。\n今回の子宮口の撮影中に彼女が突然オーガズムに達したため、今回は膣内に白濁マン汁が多量に滞留、膣全体が愛液で満たされています。\n膣は8cmしかありません。\n\n今回の表情は前回と同じで、まるで学生写真のようだ。（彼女は勝手に絶頂してしまったが、すぐに気分を整え、ただ汗と蒸気が増えただけだった。）\n\n長い文章となって申し訳ありません。どうかよろしくお願いします。\nThank you\n\nhttps://drive.google.com/drive/folders/15EtrhapXHdbAatPEHEnHp2ZVtCxz3T0D", "created_at": "", "completed_at": ""}, {"path": "/@oaaaa0801/works/99", "thumbnail_src": "https://si.imgix.net/94bf4594/uploads/origins/6ba0e8a6-80e6-40d7-ada7-2f5e7caa49ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f56de32942e3ab6ea65b584ccd9e38", "thumbnail_srcset": "https://si.imgix.net/94bf4594/uploads/origins/6ba0e8a6-80e6-40d7-ada7-2f5e7caa49ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f56de32942e3ab6ea65b584ccd9e38, https://si.imgix.net/94bf4594/uploads/origins/6ba0e8a6-80e6-40d7-ada7-2f5e7caa49ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=570cffa8606c3d873194e74a1efb1216 2x, https://si.imgix.net/94bf4594/uploads/origins/6ba0e8a6-80e6-40d7-ada7-2f5e7caa49ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71f70637657324dd861d5cb9271368be 3x", "genre": "art", "nsfw": true, "body": "アピールありがとうございました!\nごめんなさい、資料を準備するためにこんなに遅く返信してしまいました。\n\nハスミの生徒手帳風のH profileのイラストをリクエストします。\n\nprofile:\nhttps://drive.google.com/file/d/1RRbgNudyYEG_CY570L8mTRazOxLRoK1Q/view?usp=drivesdk\n\n左の写真、まるで学生手帳の撮影時のような表情だね。自分が全裸であることを全く気にしない、無表情。爆乳、陥没乳首、超巨乳輪、乳首乳輪の色は色素沈着した茶色、乳輪20cm+（閱覽注意）：\nhttps://drive.google.com/drive/folders/1furNw1k8Fawsgs2jY24f-HH9i8gFeK7D\n\n右側の子宮口の写真は、「白いヨーグルト状」膣分泌液追加、子宮頸部から分泌され。撮影時が排卵期であったため、分泌液が比較的多いです。説明がなければ、それが精液だと思うかもしれません。\nよくデザートを食べる彼女の分泌物は、きっと甘くて美味しいに違いない。\n\n\n右側には、彼女の人生で初めて排出された卵子と、最近の大量採卵の写真があります。\n\n長い文章となって申し訳ありません。どうかよろしくお願いします。\nThank you\n\nhttps://drive.google.com/drive/folders/1r0kTegSPsz634Ll-v03sAFOG4JfjI0Kc", "created_at": "", "completed_at": ""}, {"path": "/@oaaaa0801/works/98", "thumbnail_src": "https://si.imgix.net/cc430c74/uploads/origins/a491fff7-743f-4e59-8cd4-f6edb2879aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67289825f567a1b1cdd3db37def0005a", "thumbnail_srcset": "https://si.imgix.net/cc430c74/uploads/origins/a491fff7-743f-4e59-8cd4-f6edb2879aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67289825f567a1b1cdd3db37def0005a, https://si.imgix.net/cc430c74/uploads/origins/a491fff7-743f-4e59-8cd4-f6edb2879aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcd8a513935a1c20959d37cfe51ffac6 2x, https://si.imgix.net/cc430c74/uploads/origins/a491fff7-743f-4e59-8cd4-f6edb2879aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d01d4c01199427013e55eaa44b9fce40 3x", "genre": "art", "nsfw": true, "body": "連続して申し訳ないのですがVtuberのChumuNoteさんのアナル舐め手コキを描いてください。\n可能でしたら男のケツに『ちゅむ主優待』の文字を入れてください。\n\nChumuNote\nhttps://chumunote.info/wp/wp-content/themes/ChumuNote/images/zu.png\nhttps://chumunote.info/wp/wp-content/themes/ChumuNote/images/zu2.png\nhttps://x.com/tmgnrei\nhttps://chumunote.info/", "created_at": "", "completed_at": ""}, {"path": "/@oaaaa0801/works/97", "thumbnail_src": "https://si.imgix.net/20d31016/uploads/origins/62c41539-ca8c-4dd2-8c08-f70b278bbae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04cafe617d14218c71a8e1b11ac1b2ec", "thumbnail_srcset": "https://si.imgix.net/20d31016/uploads/origins/62c41539-ca8c-4dd2-8c08-f70b278bbae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04cafe617d14218c71a8e1b11ac1b2ec, https://si.imgix.net/20d310