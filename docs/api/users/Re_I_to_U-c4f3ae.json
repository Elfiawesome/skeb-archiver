FF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68bf36fd46e2b5bceb9963084ffaa5b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/29", "thumbnail_src": "https://si.imgix.net/360b60ba/uploads/origins/e9d34bf3-3532-4976-8ff0-00432a7cdee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e1718d64ba11a1f94c567fce22d3435", "thumbnail_srcset": "https://si.imgix.net/360b60ba/uploads/origins/e9d34bf3-3532-4976-8ff0-00432a7cdee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e1718d64ba11a1f94c567fce22d3435, https://si.imgix.net/360b60ba/uploads/origins/e9d34bf3-3532-4976-8ff0-00432a7cdee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aba73e6402e4a9ed62130cc6f182a885 2x, https://si.imgix.net/360b60ba/uploads/origins/e9d34bf3-3532-4976-8ff0-00432a7cdee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79c1f0f4eac63fa332d93b412da37fc3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/28", "thumbnail_src": "https://si.imgix.net/13930a7a/uploads/origins/f22c051c-6d07-49bd-b06a-b76b8ed5427c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca5ebd088a2757dc1fca4d3e7dd275a", "thumbnail_srcset": "https://si.imgix.net/13930a7a/uploads/origins/f22c051c-6d07-49bd-b06a-b76b8ed5427c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca5ebd088a2757dc1fca4d3e7dd275a, https://si.imgix.net/13930a7a/uploads/origins/f22c051c-6d07-49bd-b06a-b76b8ed5427c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8e55db2e0e617856ce79a2e93e414a5 2x, https://si.imgix.net/13930a7a/uploads/origins/f22c051c-6d07-49bd-b06a-b76b8ed5427c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3949757fe5fd45b00d9311ea97b1a6d9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！猫娘Vtuberのアイラです！特に指定はないので、好きなように描いてください。性格は可愛くて、甘えん坊で、シャイで、ウェルカムです。PSDでキャラクターと背景を分けていただけると助かります。彼女のリファレンスシートのリンクを貼ったので、1:1に従ってください。私は彼女に同じ服装と髪型をしてもらいたいです。ハートの瞳と星のクリップは重要です。これらはストリーミングとコンテンツ目的でのみ使用します。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1DFbbkpZxPzzXgjn2DhAVtFvXEU1LYD-G", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/27", "thumbnail_src": "https://si.imgix.net/b110b2ce/uploads/origins/9a7ac14d-9c15-4f36-bb58-f58de94159ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c34e6c84f4591392416fe3b7b0d682a8", "thumbnail_srcset": "https://si.imgix.net/b110b2ce/uploads/origins/9a7ac14d-9c15-4f36-bb58-f58de94159ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c34e6c84f4591392416fe3b7b0d682a8, https://si.imgix.net/b110b2ce/uploads/origins/9a7ac14d-9c15-4f36-bb58-f58de94159ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=037c923cc95a3992e63f7898e5710426 2x, https://si.imgix.net/b110b2ce/uploads/origins/9a7ac14d-9c15-4f36-bb58-f58de94159ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75f108745e7ce3476110638841f65c38 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。前回は素晴らしい作品を納品頂きありがとうございました。\n最近新しい服が増え、是非またReItoUさんに描いて頂きたいという気持ちが湧いたため参りました。\n\n[リクエスト]\n僕をリクエストさせてください。ポーズや構図等の指定は特にありません。\n\n[僕について。]\nこの衣装で描いて頂きたいです。 ※簡略化してもアレンジしても大丈夫です。\nhttps://drive.google.com/drive/folders/1u08BCOOsQQkJJWxHopO-mNWMMUp-5MPI?usp=sharing\n\n参考までに簡単なプロフィールです。\nhttps://twitter.com/ShigaYohira/status/1488519194547453953\n\n[使用用途]\nSNSや動画共有サイトで使用させて頂く可能性がございます。", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/26", "thumbnail_src": "https://si.imgix.net/4015c512/uploads/origins/7a28157c-e0cc-4260-98bc-e60c78049cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4ca1c448cd2db271cff41f14dd298d", "thumbnail_srcset": "https://si.imgix.net/4015c512/uploads/origins/7a28157c-e0cc-4260-98bc-e60c78049cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4ca1c448cd2db271cff41f14dd298d, https://si.imgix.net/4015c512/uploads/origins/7a28157c-e0cc-4260-98bc-e60c78049cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c56c31faded63ab36cf8671d4973a67c 2x, https://si.imgix.net/4015c512/uploads/origins/7a28157c-e0cc-4260-98bc-e60c78049cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88b8b65d033156fc7a516691269f7617 3x", "genre": "art", "nsfw": false, "body": "初めまして。VTuberをしている四娥夜片と申します。\nアピールで頂いた言葉がとても嬉しく、そこから冷凍さんの作品たちを拝見すると、髪の毛の塗り方や瞳の輝きが大変自分の好みに合っていた為、是非１枚ご依頼させてください。\n\n[リクエスト]\n僕をリクエストさせてください。ポーズや構図等の指定は特にありません。\n\n[僕について。]\nお気に入りの衣装が３着あるので、以下のリンク先からお好きなものを１着選んで自由に描いて頂ければと思います。 ※簡略化してもアレンジしても大丈夫です。\nhttps://drive.google.com/drive/folders/15baskKY3AN1vMSPzMs14Omr-n7EGVngL?usp=sharing\n\n参考までに簡単なプロフィールです。\nhttps://twitter.com/ShigaYohira/status/1488519194547453953\n\n[使用用途]\n動画のサムネイルや配信内、SNSで使用させて頂く可能性がございます。", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/25", "thumbnail_src": "https://si.imgix.net/72b3f4aa/uploads/origins/2aa96ef0-e580-4094-b52e-730d6ef93ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c4c9ccce069a3ad35707adf3edcd437", "thumbnail_srcset": "https://si.imgix.net/72b3f4aa/uploads/origins/2aa96ef0-e580-4094-b52e-730d6ef93ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c4c9ccce069a3ad35707adf3edcd437, https://si.imgix.net/72b3f4aa/uploads/origins/2aa96ef0-e580-4094-b52e-730d6ef93ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d86639ee8c8ac84bf97063b5f31b7fb0 2x, https://si.imgix.net/72b3f4aa/uploads/origins/2aa96ef0-e580-4094-b52e-730d6ef93ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80d2fef4270fbabc91a2c28a886dade0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのソフトなアートスタイルが大好きです、私のVtuber Litaのためにあなたに依頼したいです！\n彼女は独りよがりの火猫です！\n\nこの作品と同じようなものが欲しいです https://skeb.jp/@Re_I_to_U/works/11\n\nありがとうございます、そして楽しんでください！\n\nhttps://drive.google.com/drive/folders/1ZbEYFkSzZkcHR25pAflyN6zbqgvk59mv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/24", "thumbnail_src": "https://si.imgix.net/ebc8a235/uploads/origins/5ac3fd7a-68b8-4529-965f-39ed2f3ca5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=109bed7dd52e3b150f2a9621d07299ff", "thumbnail_srcset": "https://si.imgix.net/ebc8a235/uploads/origins/5ac3fd7a-68b8-4529-965f-39ed2f3ca5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=109bed7dd52e3b150f2a9621d07299ff, https://si.imgix.net/ebc8a235/uploads/origins/5ac3fd7a-68b8-4529-965f-39ed2f3ca5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca50bb161608856226c24875368f8032 2x, https://si.imgix.net/ebc8a235/uploads/origins/5ac3fd7a-68b8-4529-965f-39ed2f3ca5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bac5b85b4c5b9b113217bf7fa4c5321e 3x", "genre": "art", "nsfw": false, "body": "訴えていただき、ありがとうございます！お返事がかなり遅くなってしまい申し訳ありません。\n私のVTuberをとにかく好きに描いてください！\nリスクオブレイン2の風景に近い設定にしていただけるとうれしいです：\nhttps://riskofrain2.fandom.com/wiki/Environments\n\n16:9の比率が望ましい、サムネイルとしてYouTube上やSNS全般（スケジュールなど）で使えると嬉しいです。\n必須ではありませんが、目を閉じたレイヤーやPSD分離があるとありがたいです。\n\n私のVtuberです：\nhttps://imgur.com/a/ChLVZ39\nオリジナル衣装です。\nうさぎの耳の長さはあごまでで、髪に馴染んでいます。\n耳は目立ちにくく、あまり出っ張らないようになっています。\n\n彼女の目には花が描かれている。\n目の色は、水色、青、緑、黄色。\n\n--\n他の衣装がお好みの方は、どうぞお気軽にご利用ください。\n\nhttps://imgur.com/a/xHY7ecj\n参考資料です：\nhttps://i.imgur.com/1rxiJ6J.jpg\n\n---\nカジュアルな服装参考\nhttps://imgur.com/a/ZciKjZQ", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/23", "thumbnail_src": "https://si.imgix.net/bf99dfc5/uploads/origins/3a94d551-9673-41f1-bb5d-02d21ba48a96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effba7c66a4f5254504acdeb92ba9f4c", "thumbnail_srcset": "https://si.imgix.net/bf99dfc5/uploads/origins/3a94d551-9673-41f1-bb5d-02d21ba48a96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effba7c66a4f5254504acdeb92ba9f4c, https://si.imgix.net/bf99dfc5/uploads/origins/3a94d551-9673-41f1-bb5d-02d21ba48a96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47c2f8e0e127fefaf7cdd6830cf630c9 2x, https://si.imgix.net/bf99dfc5/uploads/origins/3a94d551-9673-41f1-bb5d-02d21ba48a96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15af4247e75df231bb0108536aa0f0a0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！モニカを描いてみたいというアピール、興味を持っていただきありがとうございます。\n\nモニカの個性、大きな白いリボン、ゆるく巻いたポニーテール、そして穏やかなグリーンの瞳がとても素敵です！ありがとうございます！\n\nあなたのページを見て、あなたの画風が大好きになりました。ぜひ彼女を描いてほしいです！\n\n見る人に向けて優しい笑顔で描いてください。\n\n服装はカジュアルなもので良いのですが、太もものハイソックスも一緒にお願いします。\n\n参考URLのパレットのピンク、ホワイト、グリーンの色を使用してください！\n\nポーズやその他の部分は、お客様の判断にお任せしています。\n\nオフィシャルアートワークの参考資料です：\nhttps://www.pixiv.net/en/artworks/67288653\nhttps://www.pixiv.net/en/artworks/76922677\nhttps://twitter.com/lilmonix3/status/1321873684366127104\nhttps://twitter.com/lilmonix3/status/1001946080957911043\nhttps://twitter.com/TeamSalvato/status/1628454574083170304\n\nご検討のほど、よろしくお願いいたします。\n\nを描くのが楽しみです！\n\nhttps://i.ibb.co/wQM2xtW/pomo-pallette.png", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/22", "thumbnail_src": "https://si.imgix.net/93570956/uploads/origins/bc168392-7517-4f2f-bdb1-dc9fe9324212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8491f6c354ef1a9d5f5095aff2c7675e", "thumbnail_srcset": "https://si.imgix.net/93570956/uploads/origins/bc168392-7517-4f2f-bdb1-dc9fe9324212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8491f6c354ef1a9d5f5095aff2c7675e, https://si.imgix.net/93570956/uploads/origins/bc168392-7517-4f2f-bdb1-dc9fe9324212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a24193a843bf040f9226fb03aaa202b3 2x, https://si.imgix.net/93570956/uploads/origins/bc168392-7517-4f2f-bdb1-dc9fe9324212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38b4e9749fe7b2732c3f3c35c0a412d0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールありがとうございます！絵がとてもかわいいですね！ぜひ私のffxivの猫娘を描いてください！\n\nとてもシャイな女の子ですが、時間をかけて仲良くなると、おバカなところもあり、いつも友達を喜ばせることができます。彼女は夢想家で、何事にもベストを見ようとする。かわいいもの、食べ物、旅行、テーマパークとかが大好き。何を選ぶか迷ったら、参考資料の衣装5を使用してください！ポーズや表情、背景など、自由に描いていただいて構いません^-^ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1RyTLEjXNb0Ti8nvnkyTz-3UvTcZp0h3k?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/21", "thumbnail_src": "https://si.imgix.net/cf70b042/uploads/origins/667a8aaa-daaa-45ab-8033-9a08b5053d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb49c7c3421c9fa761b89c9f5684560a", "thumbnail_srcset": "https://si.imgix.net/cf70b042/uploads/origins/667a8aaa-daaa-45ab-8033-9a08b5053d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb49c7c3421c9fa761b89c9f5684560a, https://si.imgix.net/cf70b042/uploads/origins/667a8aaa-daaa-45ab-8033-9a08b5053d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59956f4057bd89c96d3d9fec650080bf 2x, https://si.imgix.net/cf70b042/uploads/origins/667a8aaa-daaa-45ab-8033-9a08b5053d4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba10dd24524556fa0a931c98a35b4b9b 3x", "genre": "art", "nsfw": false, "body": "Hello! I love your artwork! \n\nPlease could you draw my VTuber! I'm a demon bunny, and I love being comfortable + relaxed!\nMy personality is kind, relaxed and happy. I love the colours pink, purple, light blue + yellow!\nI like clouds, stars, flowers, moons, tea and rabbits! My hair is a very light grey, almost white. Please make sure to include my beauty mark next to my eye!\n\nPlease draw me however you would like in a similar format to these works and in a 16:9 ratio:\nhttps://skeb.jp/@Re_I_to_U/works/18 https://skeb.jp/@Re_I_to_U/works/15\n\nI would like you to include the PSD file with the layers separated, have my glasses on a separate layer and a version with a transparent background please! \nThe work will be used on Twitter, Twitch and Youtube!\nThank you for your time!\n\nhttps://drive.google.com/drive/u/6/folders/1HBzHajohYP0GTQ4-rWojPkbjctLSBpq6", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/20", "thumbnail_src": "https://si.imgix.net/ec709439/uploads/origins/06adec52-9e44-4d0e-8060-b0a4a4ac19f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b59dee19e3911b5ed4018361b57dac41", "thumbnail_srcset": "https://si.imgix.net/ec709439/uploads/origins/06adec52-9e44-4d0e-8060-b0a4a4ac19f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b59dee19e3911b5ed4018361b57dac41, https://si.imgix.net/ec709439/uploads/origins/06adec52-9e44-4d0e-8060-b0a4a4ac19f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae61a5c9c0895e746badb18477830aa1 2x, https://si.imgix.net/ec709439/uploads/origins/06adec52-9e44-4d0e-8060-b0a4a4ac19f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b3f1a3f4c25c3580bd9ab77f8c5a9a2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/19", "thumbnail_src": "https://si.imgix.net/a17d8f92/uploads/origins/43ab8ed3-4260-4a56-8b3d-084099ee227e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99bc8910673010cedabd80203b15cd33", "thumbnail_srcset": "https://si.imgix.net/a17d8f92/uploads/origins/43ab8ed3-4260-4a56-8b3d-084099ee227e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99bc8910673010cedabd80203b15cd33, https://si.imgix.net/a17d8f92/uploads/origins/43ab8ed3-4260-4a56-8b3d-084099ee227e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d5e11f9262c34c66330cbdf150540b1 2x, https://si.imgix.net/a17d8f92/uploads/origins/43ab8ed3-4260-4a56-8b3d-084099ee227e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b75ab98feb0e497c9881449b7b67af2 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートワークが大好きで、依頼したいです。   \n\n大人の女性で、うさ耳とゴールドのアクセントが特徴です。性格は真面目で堂々としていて、権威がある感じです。胸囲を大きくして描いてください。全身像が主な参考資料です。ディテールは全て同じです。ポーズや表情はこんな感じでお願いします。https://pin.it/7htBWEz。\n\n参考資料が低品質で申し訳ないです。芸術的な自由があります!背景は自由です。また、透明バージョンもお願いしたいです。   \n\nお疲れ様でした。どんな作品が出来上がるか楽しみです\n\nhttps://sta.sh/2dptfzhq84i?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/18", "thumbnail_src": "https://si.imgix.net/99f3b7cd/uploads/origins/608fcb14-b33a-4a2f-83d3-3bc112964fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8ad4abede3fe9146c3f8317d7f54d06", "thumbnail_srcset": "https://si.imgix.net/99f3b7cd/uploads/origins/608fcb14-b33a-4a2f-83d3-3bc112964fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8ad4abede3fe9146c3f8317d7f54d06, https://si.imgix.net/99f3b7cd/uploads/origins/608fcb14-b33a-4a2f-83d3-3bc112964fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dd327ac2e15f9d7d02334d53f6c424b 2x, https://si.imgix.net/99f3b7cd/uploads/origins/608fcb14-b33a-4a2f-83d3-3bc112964fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b547829a6c894dfcb0c04ed47de4853 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの画風が大好きで、私のVTuberを描いて欲しいです!彼女は月と星と花と紫色が大好きな天女のような猫の女の子です!好きなように描いてください。https://skeb.jp/@Re_I_to_U/works/15 https://skeb.jp/@Re_I_to_U/works/14 https://skeb.jp/@Re_I_to_U/works/11 将来的に文字を入れることができるように、私のキャラクターは中心でなく（横に近い）描かれていることが唯一の要求です。アスペクト比は16:9が望ましいです\n\nできれば、背景が透明でレイヤーが分かれているバージョンをお願いしますこのアートはTwitchやTwitterで使いたいと思います。本当にありがとうございました。\n\nキャラクター参考：https://imgur.com/a/M8E0Shi", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/17", "thumbnail_src": "https://si.imgix.net/886d8cbc/uploads/origins/4400688e-1b47-40e6-b05d-9f9d4b047d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b68aa86212eaa686f78571b99b57bdf5", "thumbnail_srcset": "https://si.imgix.net/886d8cbc/uploads/origins/4400688e-1b47-40e6-b05d-9f9d4b047d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b68aa86212eaa686f78571b99b57bdf5, https://si.imgix.net/886d8cbc/uploads/origins/4400688e-1b47-40e6-b05d-9f9d4b047d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c65187b59e88630300207f9498fc3f7d 2x, https://si.imgix.net/886d8cbc/uploads/origins/4400688e-1b47-40e6-b05d-9f9d4b047d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ae1c62525cc04bf2b66d6cf9ce1876b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのアートワークが本当に大好きです。\n私のキャラクター「レン」の絵をお願いしたいです。とてもかわいくて、ゆったりしていて、明るい子です。\n細かい絵はお任せします。\n\n衣装はこれを使いたいと思います。\nhttps://drive.google.com/drive/folders/1-P07hVj66O72cmZKyW-xyt7jlSCcqJlN\n\nレンのリファレンスです。\nhttps://drive.google.com/drive/folders/1-LPJiJrLbFMxvzVYi1VSEuVnn5PIUMC5\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Re_I_to_U/works/16", "thumbnail_src": "https://si.imgix.net/b7dc49a1/uploads/origins/71f7ff85-9a0c-4195-b158-870e8f56