_at": ""}, {"path": "/@namaste_koboo/works/7", "thumbnail_src": "https://si.imgix.net/9998f222/uploads/origins/7a7c6120-1d9d-49e9-94ba-b8bedbdad9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d500fed1d6c810c3887adc290a55515c", "thumbnail_srcset": "https://si.imgix.net/9998f222/uploads/origins/7a7c6120-1d9d-49e9-94ba-b8bedbdad9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d500fed1d6c810c3887adc290a55515c, https://si.imgix.net/9998f222/uploads/origins/7a7c6120-1d9d-49e9-94ba-b8bedbdad9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db9af1818f8cd2db6417b6bb85e79aa0 2x, https://si.imgix.net/9998f222/uploads/origins/7a7c6120-1d9d-49e9-94ba-b8bedbdad9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2fa071ae9351475f94ed767bd22bfb6 3x", "genre": "art", "nsfw": false, "body": "なますてさんこんにちは！\n\nオリジナルのキャラクターもリクエスト可能のようですので、自分もオリジナルのキャラをリクエストさせていただきます！\n\n内容は自分のオリジナルキャラを、まほルナの戦闘グラフィックのような感じの敵側の立ち位置で描いていただきたいです！\n大した資料は無いですが、こちらを参考にお願いします！\n\nhttps://twitter.com/RyoTomosaka/status/1510753581405995010\n\n名前はククリといいます\nあとおまけみたいな感じで、戦闘画面内にルナちゃんも一緒にいてくれるととても嬉しいです！\n\n\nもしゲーム作製の権利や規定などでそのリクエストが不可能な場合は別案として…\nうちの子（ククリ）がルナちゃんに糸を付けて操り人形みたいにもてあそんでるシチュを全身が見える形でお願いします！\n\nskeb初リクエストゆえ、至らない点がありましたら申し訳ないです…\n\n\nゲーム製作のため、多忙かと思いますのであまり無理をしないでくださいませ\nそしてゲーム完成も楽しみにしてます！", "created_at": "", "completed_at": ""}, {"path": "/@namaste_koboo/works/6", "thumbnail_src": "https://si.imgix.net/8b0f3188/uploads/origins/69c874a8-3f89-4a64-94a5-005bef35a443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a31508c5ecc888cd7100847b0d19b9c", "thumbnail_srcset": "https://si.imgix.net/8b0f3188/uploads/origins/69c874a8-3f89-4a64-94a5-005bef35a443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a31508c5ecc888cd7100847b0d19b9c, https://si.imgix.net/8b0f3188/uploads/origins/69c874a8-3f89-4a64-94a5-005bef35a443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0613a7ca1b282665050c3e21b5a23f3 2x, https://si.imgix.net/8b0f3188/uploads/origins/69c874a8-3f89-4a64-94a5-005bef35a443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61f755c5d49a3b497f8a59809aa508d2 3x", "genre": "art", "nsfw": false, "body": "こんにちは。前に発売されたゲームの作品が大好きです。妖精たちが超かわいいです！\n\n私のキャラを妖精に倒してシチュをお願いします。催眠術をかけたり、縛ったりしてください。彼女はバニーガールで魔法の使い手です。自信はあるのですが、本当に弱いです。数人の妖精がいれば簡単に倒せます。\n\nあとはお任せします。ありがとうございます！\n\nhttps://imgur.com/a/VGDS0c4", "created_at": "", "completed_at": ""}, {"path": "/@namaste_koboo/works/5", "thumbnail_src": "https://si.imgix.net/499f36c0/uploads/origins/5d1ae6d9-9f1a-4f18-a9a8-55454671f5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7a79f1ec531c7d3aad41e7f09a4fbf3", "thumbnail_srcset": "https://si.imgix.net/499f36c0/uploads/origins/5d1ae6d9-9f1a-4f18-a9a8-55454671f5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7a79f1ec531c7d3aad41e7f09a4fbf3, https://si.imgix.net/499f36c0/uploads/origins/5d1ae6d9-9f1a-4f18-a9a8-55454671f5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b99b60abddcb46e6f6478cc5133e4954 2x, https://si.imgix.net/499f36c0/uploads/origins/5d1ae6d9-9f1a-4f18-a9a8-55454671f5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84627774891687e53bfc8cfed1c3b018 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@namaste_koboo/works/4", "thumbnail_src": "https://si.imgix.net/05307697/uploads/origins/4eda368b-fdac-406c-9ad9-2482ffd8982f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7109bb0689378da91eafd5c6d0838c8", "thumbnail_srcset": "https://si.imgix.net/05307697/uploads/origins/4eda368b-fdac-406c-9ad9-2482ffd8982f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7109bb0689378da91eafd5c6d0838c8, https://si.imgix.net/05307697/uploads/origins/4eda368b-fdac-406c-9ad9-2482ffd8982f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63c69a8dc8fcd9a6c897dbb1c2df925e 2x, https://si.imgix.net/05307697/uploads/origins/4eda368b-fdac-406c-9ad9-2482ffd8982f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c1faed0ee8f214a7424a1b1006277b3 3x", "genre": "art", "nsfw": true, "body": "こんにちは、クーロです。\n初すけぶリクエストさせていただきます。\n\n内容はセカンドライフのうちの子、シャメアちゃんをアラクネさんの蜘蛛糸でネバネバと拘束して貰いたいなと。\n\n詳細\n両腕は後ろ手か頭上で組むように、両足は軽く広げて内股にする感じで蜘蛛の巣に貼りつけて拘束。\n全身が見えていると嬉しいです。\n糸で縛り付ける感じよりもできたら粘液感多めでお願いします。\nアラクネさんに弄ばれてもがいてる感じでも...良いかもです。\nもし差し支えなければ少なくても良いので拘束段階もいくつかお願いしたいですー。\n\nシャメアちゃん資料\nhttps://www.dropbox.com/s/db4vwhbf9n9glhh/Snapshot_069.png?dl=0\nhttps://www.dropbox.com/s/i0pvrcyj23sbyxq/Snapshot_066.png?dl=0\nhttps://www.dropbox.com/s/zv70zvxfvaofvhk/Snapshot_068.png?dl=0\nhttps://www.dropbox.com/s/fw5a4faej2awnro/Snapshot_067.png?dl=0\nhttps://www.dropbox.com/s/8184mylp2czk8ky/Snapshot_070.png?dl=0\n\n最後に、ゲームの製作応援しております。完成したら真っ先に購入したいと思っていますので、無理しすぎない程度に頑張ってください！\n内容の修正で何度かキャンセルしてしまい申し訳ないです。", "created_at": "", "completed_at": ""}, {"path": "/@namaste_koboo/works/3", "thumbnail_src": "https://si.imgix.net/e6bd6306/uploads/origins/fe928ea4-da7b-461b-9480-c2f237c3c090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3731bab82e5f1d18a42cb3a9eefcbfb6", "thumbnail_srcset": "https://si.imgix.net/e6bd6306/uploads/origins/fe928ea4-da7b-461b-9480-c2f237c3c090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3731bab82e5f1d18a42cb3a9eefcbfb6, https://si.imgix.net/e6bd6306/uploads/origins/fe928ea4-da7b-461b-9480-c2f237c3c090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f259e5333c313263a356f1e71672e63 2x, https://si.imgix.net/e6bd6306/uploads/origins/fe928ea4-da7b-461b-9480-c2f237c3c090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bd8e397765fbceb2d53b0d507b1d8aa 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n私のオリジナルキャラクターがラバーメイドに捕獲されることをリクエストしたいと思います\n\nシチュエーションはお任せしますが、エッチなのがいいですね\n\nhttps://i.imgur.com/49hc5FT.jpg", "created_at": "", "completed_at": ""}, {"path": "/@namaste_koboo/works/2", "thumbnail_src": "https://si.imgix.net/7f049ab9/uploads/origins/c5d75d3d-f9b6-42f6-b453-3010424222c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e620bce53c6d7303ace16750b8cfdef", "thumbnail_srcset": "https://si.imgix.net/7f049ab9/uploads/origins/c5d75d3d-f9b6-42f6-b453-3010424222c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e620bce53c6d7303ace16750b8cfdef, https://si.imgix.net/7f049ab9/uploads/origins/c5d75d3d-f9b6-42f6-b453-3010424222c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04d3376ccf84d7292db380d08322f46c 2x, https://si.imgix.net/7f049ab9/uploads/origins/c5d75d3d-f9b6-42f6-b453-3010424222c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=970911d25d8546e56bd8bfa00568698a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}