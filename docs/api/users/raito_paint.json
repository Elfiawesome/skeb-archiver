ix.net/1b721ef4/uploads/origins/2d5e53dd-d303-487c-b045-c4f62843b380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2407a3a1d7c4371775ef47d0f7bbe836 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターのヘッドショットを描いていただけませんか？\n彼はキュートでエレガントなものが大好きなフェミニンなキャットボーイ！アクセサリーは彼のルックの重要な部分です。\nできれば、できるだけかわいく仕上げてください！♥️\nありがとうございました！\n\nhttps://drive.google.com/file/d/1sxzwUHmvwcGC2NecU_UDVe7Sn3sjdXg8/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@raito_paint/works/13", "thumbnail_src": "https://si.imgix.net/9bdbaf5a/uploads/origins/02801755-abaa-41e3-8847-cabe5ff9acb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26955629820445713b8778d4b699d2a8", "thumbnail_srcset": "https://si.imgix.net/9bdbaf5a/uploads/origins/02801755-abaa-41e3-8847-cabe5ff9acb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26955629820445713b8778d4b699d2a8, https://si.imgix.net/9bdbaf5a/uploads/origins/02801755-abaa-41e3-8847-cabe5ff9acb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d9c4be59974e8d80c0b0ae212a35718 2x, https://si.imgix.net/9bdbaf5a/uploads/origins/02801755-abaa-41e3-8847-cabe5ff9acb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9521382e45bc0363c5d37f807ae66bf 3x", "genre": "art", "nsfw": false, "body": "ライト/絵描き様\n初めまして。個人でVTuberをしております、漆杜果珠(うるしもり はす)と申します。\nこの度、ライト/絵描き様の素敵なイラストをXとskebで拝見し、是非とも私を描いていただきたいと思ったので、リクエストを送らせていただきます。\n\n【使用用途】\nXに投稿\nYouTubeのサムネイル(後に収益化する可能性があります)\nコミュニティ、動画内での使用、ネットプリント、フリー素材と合わせての使用\nグッズ化して販売等(商用利用)も考えております。\n何かNG項目がございましたらお手数をお掛けしますが別レイヤーに記載をお願いいたします。\n\n【キャラクター特徴】\nマンゴーが大好き\n楽しいことが大好き\n好奇心旺盛でゲームや歌、雑談が大好き\n\n【要望】\n私、漆杜果珠を描いていただきたいです。\nお供が居るため、お供も描いていただきたいです。\n色々な所で使わせていただきたいため、頭やお供が切れていないと嬉しいです。\nもし背景があるのでしたら、背景ありと背景なしの人物透過版をいただけるとありがたいです。\n瞳にちょうちょのハイライトがあります。\n構図や表情、服装等全て、ライト/絵描き様のおまかせで描いていただきたいです。\n\nskeb初心者のため、なにか不備がありましたら申し訳ありません。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1vVhQ6ViVQumhyoJzgr1FnYz0V2o8fT72", "created_at": "", "completed_at": ""}, {"path": "/@raito_paint/works/12", "thumbnail_src": "https://si.imgix.net/71d4d1c1/uploads/origins/0d007f8c-d5a2-4f82-954f-195ccbc6e180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a2fc1505d92f9174548cda6f473fae", "thumbnail_srcset": "https://si.imgix.net/71d4d1c1/uploads/origins/0d007f8c-d5a2-4f82-954f-195ccbc6e180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a2fc1505d92f9174548cda6f473fae, https://si.imgix.net/71d4d1c1/uploads/origins/0d007f8c-d5a2-4f82-954f-195ccbc6e180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01dce24bede3d136fc70529f4075c785 2x, https://si.imgix.net/71d4d1c1/uploads/origins/0d007f8c-d5a2-4f82-954f-195ccbc6e180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c26c0e5e9358e9dcfdaf585b05e27097 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nVライバーとして活動中の町田あそびと申します。\n\nskebを見ていたら主様の素敵なイラストを拝見し、是非町田あそびを描いて頂きたくリクエスト送らせて頂きました！\n\n┈┈┈┈┈┈┈┈┈┈\n\n描写人物▷ 町田あそび (@asobiwin)\nドライブをご覧下さい\n変えて欲しくないところ▷ 髪色 髪型 八重歯 アホ毛 貧乳\n\n服装や構図はお任せ致します。\n\n使用用途▽\nツイート、アイコン、サムネ、収益化のある配信アプリでの返礼品（デジタルグッズ（アイコンリング、ヘッダー、待ち受け等）、リアルグッズ化）\n※直接利益の得るグッズ販売は致しません\n\n上記使用用途の為、頭の先や横毛、指などが見切れないように描いて頂きたいです。\n\n人物のみの透過データも頂きたいです。\n\nhttps://drive.google.com/drive/folders/1-CA9uQhia1a23AgHGmLm6s30HOkCAXjP", "created_at": "", "completed_at": ""}, {"path": "/@raito_paint/works/11", "thumbnail_src": "https://si.imgix.net/567a7714/uploads/origins/34c51d1d-264d-4676-b4cd-8c9fc57c29e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efd4cce7737dcb22f9d6773ccad41138", "thumbnail_srcset": "https://si.imgix.net/567a7714/uploads/origins/34c51d1d-264d-4676-b4cd-8c9fc57c29e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efd4cce7737dcb22f9d6773ccad41138, https://si.imgix.net/567a7714/uploads/origins/34c51d1d-264d-4676-b4cd-8c9fc57c29e4?bg=