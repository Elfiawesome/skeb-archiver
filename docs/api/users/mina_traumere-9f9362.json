ix.net/07fca6dc/uploads/origins/36b874e7-cf47-4484-9353-20f4840264b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d689fd39c7711297d4ee180a0e3fcd0, https://si.imgix.net/07fca6dc/uploads/origins/36b874e7-cf47-4484-9353-20f4840264b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5aa21f980b368123a659f9ad679a723 2x, https://si.imgix.net/07fca6dc/uploads/origins/36b874e7-cf47-4484-9353-20f4840264b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b8a6c646c68582986ab71bda3f42fd7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mina_traumere/works/20", "thumbnail_src": "https://si.imgix.net/e767df5a/uploads/origins/c2ee5984-3b69-4e7d-a033-78d26905999a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e8067a619e6fd5b681cd12cb00ef3d", "thumbnail_srcset": "https://si.imgix.net/e767df5a/uploads/origins/c2ee5984-3b69-4e7d-a033-78d26905999a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e8067a619e6fd5b681cd12cb00ef3d, https://si.imgix.net/e767df5a/uploads/origins/c2ee5984-3b69-4e7d-a033-78d26905999a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dcecec1a70ca3d2d4f31c5b43dae04e 2x, https://si.imgix.net/e767df5a/uploads/origins/c2ee5984-3b69-4e7d-a033-78d26905999a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ab382fb3467ced19fe39651269b4c5a 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n卯月みな様のイラストが好きで、是非描いていただきたく依頼させていただきました。\n\nVRChatというゲームで私が普段使用しているアバターを描いてください。\n服装（ノーマルカーディガンorだぼゆるカーディガン）、髪型（ロングorショート）は資料の中から描きやすいもので構いません。\n構図、背景等全てお任せで、アバターの雰囲気に合わせ自由に描いていただけますと嬉しいです。\n服装や装飾品など、わかりにくい部分は自由にアレンジしていただいて構いません。\n\n描いて頂いた作品はVRChat、およびSNSで利用させて頂きたく存じます。\n　・SNS, VRChat上のアイコン\n　・VRChatワールドへの設置\nなどを予定しております。※商用利用はいたしません。\n\n背景、文字などレイヤーで分けたデータがいただけますと嬉しいです。\n\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aJHSqqmusv6auVAIXW-rdzEkXhJBxy-0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mina_traumere/works/19", "thumbnail_src": "https://si.imgix.net/8c10941d/uploads/origins/050ea107-8419-4c42-9bd7-ae41eb040719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdb2833c637cf8f3fe40247f895f0387", "thumbnail_srcset": "https://si.imgix.net/8c10941d/uploads/origins/050ea107-8419-4c42-9bd7-ae41eb040719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdb2833c637cf8f3fe40247f895f0387, https://si.imgix.net/8c10941d/uploads/origins/050ea107-8419-4c42-9bd7-ae41eb040719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5c03cb3d33a66ad74847eee97b48572 2x, https://si.imgix.net/8c10941d/uploads/origins/050ea107-8419-4c42-9bd7-ae41eb040719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05b194d74d70c727c5529ed32fafbc92 3x", "genre": "art", "nsfw": false, "body": "Hello I love your art!\n私のOCを描いてくれませんか？\nイチゴ抹茶ラテやお花見団子など、ピンクと緑のスイーツをイメージしたうさぎさんです。\n自由に描いてください。どちらの衣装でも良いですし、新しい衣装を作っても構いません。\nご検討よろしくお願いします^^。\n\nhttps://imgur.com/a/GMNuPor", "created_at": "", "completed_at": ""}, {"path": "/@mina_traumere/works/18", "thumbnail_src": "https://si.imgix.net/7d38708c/uploads/origins/e1077944-c301-4bef-a6a7-bb12ead43416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c1d219fbe041bcc11473a473d51468", "thumbnail_srcset": "https://si.imgix.net/7d38708c/uploads/origins/e1077944-c301-4bef-a6a7-bb12ead43416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c1d219fbe041bcc11473a473d51468, https://si.imgix.net/7d38708c/uploads/origins/e1077944-c301-4bef-a6a