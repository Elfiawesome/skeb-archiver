h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fb3cd027ac2de036b2f93accd2f9f48 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@charon_mog_kero/works/26", "thumbnail_src": "https://si.imgix.net/4af0a95f/uploads/origins/ddbcb162-2477-41a7-8cc1-b2f3822c97ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef206b6a278b4dc250516e67495efe76", "thumbnail_srcset": "https://si.imgix.net/4af0a95f/uploads/origins/ddbcb162-2477-41a7-8cc1-b2f3822c97ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef206b6a278b4dc250516e67495efe76, https://si.imgix.net/4af0a95f/uploads/origins/ddbcb162-2477-41a7-8cc1-b2f3822c97ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=610849c6e581887f623db60ab4f587e0 2x, https://si.imgix.net/4af0a95f/uploads/origins/ddbcb162-2477-41a7-8cc1-b2f3822c97ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=052177daab8c29bbc3d4c7ba9b2fb0c1 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nイラストをご依頼させていただきます。\n\n【キャラクター】\n秤アツコ （ブルーアーカイブ）\n\n【概要】\n以前ツイートされていた内容(資料URL参照)に準じますが、先生と死別したアツコをお願いしたいです。\n\n【構図】\n基本的にお任せしますが、\n瀬奈先生の描く目が好きなので目が見える構図だとなお嬉しいです。\n\n【表情】\nメモロビ雑談時に見せるような伏し目でお願いします。\n感情等は瀬奈先生の解釈にお任せします。\n\n【シチュエーション】\nシチュを以下に2つ例示しますので、どちらか1つ選択して描く形でお願いします。\nあくまで例なので瀬奈先生の好きなように改変するか、\n全く別のシチュエーションにしてもらって大丈夫です。\n\n1.\nアツコは先生の亡骸を膝に乗せて、頭部を抱きかかえている。\nまた背景で桜がまばらに舞っている。\n\n2.\n先生の亡骸を埋めている途上、アツコが花を供えている。\n\n以上、よろしくお願いいたします。\n\nhttps://twitter.com/charon_mog_kero/status/1566672619256295428", "created_at": "", "completed_at": ""}, {"path": "/@charon_mog_kero/works/25", "thumbnail_src": "https://si.imgix.net/74a5649c/uploads/origins/aa3b9372-3f79-41f9-a57d-d562f73ca1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b239b585fe806646801c2498630c46", "thumbnail_srcset": "https://si.imgix.net/74a5649c/uploads/origins/aa3b9372-3f79-4