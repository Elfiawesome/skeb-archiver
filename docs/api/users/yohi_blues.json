ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5af6adf640b1204ff842230c29a14e33 2x, https://si.imgix.net/f45af578/uploads/origins/a5b89762-b50f-4992-a704-84a86f5a3544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8772ca27871a27414bc12928f527c254 3x", "genre": "art", "nsfw": true, "body": "こちらのキャラクターをむちむちの教師姿にしていただけないでしょうか。\n\n教師らしいタイトスーツで、スーツの上着およびワイシャツは胸下の前ボタンで留めながら、胸元は大きく開いてワイシャツの下から黒い下着が見え、それらがはち切れそうなくらい爆乳にしていただければと思います。\n下はタイトスカートに、ニーハイストッキングとハイヒールで、構図としては教卓に腰掛けて足を組みショーツをちらりと見せながら、教鞭や指示棒を手に、こちらに豊満な身体を披露している感じでお願いします。\n\n眼鏡はありでお願いします。\n構図が難しければ上半身に絞っていただくなど自由に調整いただいて問題ございません。\n\nhttps://akuochi.com/vampire/character/maroka/", "created_at": "", "completed_at": ""}, {"path": "/@yohi_blues/works/515", "thumbnail_src": "https://si.imgix.net/17288166/uploads/origins/76441f48-4632-4f71-a5b4-6d8d82f3998a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b1bdf970e0af0b3ef1eedceaf1914f9", "thumbnail_srcset": "https://si.imgix.net/17288166/uploads/origins/76441f48-4632-4f71-a5b4-6d8d82f3998a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b1bdf970e0af0b3ef1eedceaf1914f9, https://si.imgix.net/17288166/uploads/origins/76441f48-4632-4f71-a5b4-6d8d82f3998a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc33d9218ec05340bc1ade46c176e4f3 2x, https://si.imgix.net/17288166/uploads/origins/76441f48-4632-4f71-a5b4-6d8d82f3998a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2eaf7ed3c2f8b23f07fc3d0be86f9799 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました！白金美玲のイラストを送らせて頂いた者です。今回も白金美玲のパイズリイラストの依頼を送らせて頂きたいと思います\n\n可能であれば以下の点を希望します\n・おっぱいのサイズは前回と同じくらい\n・衣装も同じで、胸の部分がはだけて乳首が完全に見えている\n・本人の表情も同様に楽しんでいるような感じ\n・https://skeb.jp/@yohi_blues/works/491のような正面からの圧迫パイズリ\n・既に全身精液まみれ。竿は精液が勢いよく吹き出る射精中(後者を優先して頂きたいです)\n・「おちんぽ噴水みたいですわねぇ❤あぁん❤ザーメンくっさいですわ～❤」といった感じの台詞を\n\nhttps://skeb.jp/@yohi_blues/works/395", "created_at": "", "completed_at": ""}, {"path": "/@yohi_blues/works/514", "thumbnail_src": "https://si.imgix.net/5c53d261/uploads/origins/cacfcf2e-f59b-45ad-a13e-0026773dd075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c2a00c1812c5fed66905d8889c353c", "thumbnail_srcset": "https://si.imgix.net/5c53d261/uploads/origins/cacfcf2e-f59b-45ad-a13e-0026773dd075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c2a00c1812c5fed66905d8889c353c, https://si.imgix.net/5c53d261/uploads/origins/cacfcf2e-f59b-45ad-a13e-0026773dd075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeb512a0294ba839a93c8ec69a0578c8 2x, https://si.imgix.net/5c53d261/uploads/origins/cacfcf2e-f59b-45ad-a13e-0026773dd075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ba02b1a2fd864350528a45defda14eb 3x", "genre": "art", "nsfw": true, "body": "艦これのFletcher(フレッチャー)に頭を撫でられながら膝枕で授乳手コキしてもらうところをお願いします。\n\nFletcherの表情は困り顔であやしているセリフを入れて欲しいです。\nセリフ例：「よしよし」「いいこいいこ」「しょうがないですねぇ」など\n上記の雰囲気に合っていれば、これ以外でも構いません。\n\n描きにくいところはアレンジしていただいても構いません。\n\n可能であれば、下記の差分を作成してほしいです。\n・射精\n・母乳の噴き出し\n・表情：母乳を吸われ感じている表情\n・表情：満足げな笑顔\n\n上記以外はお任せいたします。\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yohi_blues/works/513", "thumbnail_src": "https://si.imgix.net/5d3fe83c/uploads/origins/b5c94015-6886-43d9-935b-9c87aa828539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3539f719fd4ee7dbacc06be1d839f924", "thumbnail_srcset": "https://si.imgix.net/5d3fe83c/uploads/origins/b5c94015-6886-43d9-935b-9c87aa828539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3539f719fd4ee7dbacc06be1d839f924, https://si.imgix.net/5d3fe83c/uploads/origins/b5c94015-6886-43d9-935b-9c87aa828539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1586f10d99903e03b433f76904ad047 2x, https://si.imgix.net/5d3fe83c/uploads/origins/b5c94015-6886-43d9-935b-9c87aa828539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0668c2516febc336b25de342a597ea4 3x", "genre": "art", "nsfw": true, "body": "よーひさんはじめまして！\n過去のイラストを見て絵のタッチや塗りが素敵と思い、是非私の好きなキャラたちも描いて貰いたいと思い今回初めて依頼させて頂きました。\n\n・キャラ:マギサ（グランブルファンタジー）\n・体型:原作基準のスタイルだけど胸は盛る感じで\n・構図やポーズ：セクシーでエッチな雰囲気が分かる感じでポーズはお任せします\n・衣装: 添付したURL内にある最終上限解放前の赤色の衣装\n・細かい設定：通常イラストとは別に差分として胸を完全に露出して赤面し感じている表情の2パターンお願いします\n・使用用途：SNSのアイコンや個人的観賞用として使います\n\n是非ご検討宜しくお願い致します！！\n\nhttps://gbf-wiki.com/?%E3%83%9E%E3%82%AE%E3%82%B5+%28SSR%29", "created_at": "", "completed_at": ""}, {"path": "/@yohi_blues/works/512", "thumbnail_src": "https://si.imgix.net/60b58803/uploads/origins/1586306e-4fbb-4c66-8d78-8dc8ccf604bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=861631f7cf3a93316a32c07bc36a01b2", "thumbnail_srcset": "https://si.imgix.net/60b58803/uploads/origins/1586306e-4fbb-4c66-8d78-8dc8ccf604bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=861631f7cf3a93316a32c07bc36a01b2, https://si.imgix.net/60b58803/uploads/origins/1586306e-4fbb-4c66-8d78-8dc8ccf604bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63b42b0089ce5d14c4bdc641e03eb442 2x, https://si.imgix.net/60b58803/uploads/origins/1586306e-4fbb-4c66-8d78-8dc8ccf604bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aab4a2a1b7a8024a701adc8f09baa212 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n「『八月のシンデレラナイン』の『河北智恵』が主人公(監督)とガニ股エロ蹲踞騎乗位セックスしている」イラストをお願いします\n\n以下のURLが河北の資料です\n\nhttps://m.imgur.com/c7ag9kf\n\n・河北は制服(長袖)を着用し、半脱ぎの状態で爆乳が露出している\n\n・河北は爆乳、太ももムチムチの陰毛濃い目\n\n・河北はいやらしく舌を出し嬉しそうな表情をしている\n\n・男のチンポは黒ずんだ茶色でグロテスクな巨根\n\n・左上に腟内断面図をお願いします\n\n・「◯◯くんのカリ高絶倫チンポいつもよりおっきくて気持ちいいよっ♡」\nの様な下品でエロい台詞の導入をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@yohi_blues/works/511", "thumbnail_src": "https://si.imgix.net/40505d4b/uploads/origins/c9fda0c4-37ba-4643-9186-c64700fe7608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20