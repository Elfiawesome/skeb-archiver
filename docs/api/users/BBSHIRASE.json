72-9f8a-a865ec72a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c560b9d1164d5ea6679d36109cfb9bd 2x, https://si.imgix.net/725e1456/uploads/origins/75fef293-1148-4472-9f8a-a865ec72a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcfc8656818abfa82204ddeaa7cfed8c 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nサキュバスお姉さんのイラストをお願いしている者です。\nhttps://skeb.jp/requests/3433746\n前回もありがとうございました。\n\nよろしければ、またサキュバスお姉さん関連のイラストをリクエストしたく存じます。\n\nサキュバス化したシラセちゃん＆サキュバスお姉さんが、\n2人で女の子を(性的に)襲っているイラストをお願いしたいです。\n\n下記２パターンをお願いしたいです。\n①チアキちゃんが襲われる。\n②クロセちゃんが襲われる。\n\nご検討いただけますと幸いです。\nよろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@BBSHIRASE/works/107", "thumbnail_src": "https://si.imgix.net/7f25445c/uploads/origins/5b20ee2b-0b50-402d-845a-7742bd551a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c19b202b89b26382fee8ff9de219d81c", "thumbnail_srcset": "https://si.imgix.net/7f25445c/uploads/origins/5b20ee2b-0b50-402d-845a-7742bd551a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c19b202b89b26382fee8ff9de219d81c, https://si.imgix.net/7f25445c/uploads/origins/5b20ee2b-0b50-402d-845a-7742bd551a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd32fac0199363412ae31c45073dfb81 2x, https://si.imgix.net/7f25445c/uploads/origins/5b20ee2b-0b50-402d-845a-7742bd551a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf7fb00c835024ebcaa2e7264affa494 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at