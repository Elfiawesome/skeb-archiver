=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17267c9a5d718a905e230692311e899b 2x, https://si.imgix.net/068b9e2e/uploads/outputs/2c8402d9-c1f4-4406-a73c-6bcd58e08dff?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ac77f4db24bbc63c2e9d15c41e85ee0 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/64", "thumbnail_src": "https://si.imgix.net/41ec0a78/uploads/outputs/56fcbb8c-d567-4d87-b72c-dfbbe5eff71f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b46b52577125df4ef3f38c99be8152e", "thumbnail_srcset": "https://si.imgix.net/41ec0a78/uploads/outputs/56fcbb8c-d567-4d87-b72c-dfbbe5eff71f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b46b52577125df4ef3f38c99be8152e, https://si.imgix.net/41ec0a78/uploads/outputs/56fcbb8c-d567-4d87-b72c-dfbbe5eff71f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92487406c1f2cb6bc8c2d09d815b8f38 2x, https://si.imgix.net/41ec0a78/uploads/outputs/56fcbb8c-d567-4d87-b72c-dfbbe5eff71f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be371ac1cf8b604e90f9757c4dca44b0 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/63", "thumbnail_src": "https://si.imgix.net/20d737fa/uploads/outputs/fb9312b6-7b20-476a-bbfb-3ce769d302d8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5498cac655747eef849ac71e7892443d", "thumbnail_srcset": "https://si.imgix.net/20d737fa/uploads/outputs/fb9312b6-7b20-476a-bbfb-3ce769d302d8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5498cac655747eef849ac71e7892443d, https://si.imgix.net/20d737fa/uploads/outputs/fb9312b6-7b20-476a-bbfb-3ce769d302d8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bf36b7213adc1b6b112976dee680c58 2x, https://si.imgix.net/20d737fa/uploads/outputs/fb9312b6-7b20-476a-bbfb-3ce769d302d8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6aaa7e8fc0d75cb08c9fb8f13f4dec6 3x", "genre": "video", "nsfw": false, "body": "栗田くろまめ（KuromamE)様、\nはじめまして！\nVtuberとして活動をしている\n兎月ネチェトアと申します。\n\n栗田くろまめ（KuromamE)様の\nムービー作品を\nskebの新着作品でお見かけし、\n生き生きとした動きと表情に\n魅せられて\nこの度はリクエストを送らせていただきました！\n\n《依頼内容 》\n私「兎月ネチェトア」の\nトランジションを\n制作していただきたいです！\n\n・お喋りが大好きなうさぎの豊穣の女神です。\n（デザインのモチーフは月兎とエジプトのウェネト神です）\n・基本はゲラで元気いっぱい。\nゲームが下手なポンコツですが、\n物語の感想のお喋りなどを楽しんで沢山遊んでます。\n\n制作していただきたい雰囲気は\n「元気に跳ねて画面いっぱいに\n飛び出して来るうさぎと女神」です。\n\n参考画像の\n羽衣つき和風衣装の方のネチェトアを\nリスナーさんもちうさぎと一緒に\n描いていただくことは\n可能でしょうか？\n細やかなポーズ、動き、\n構図はおまかせでお願いしたいです！\n予算的に厳しかったら\nネチェトアだけで大丈夫です！\n\n画面の比率は16:9で\n背景を緑か透過できる物を\n制作していただけると嬉しいです。\n\n\n《使用用途》\n収益化済みのYouTubeチャンネルの\n動画、配信で\nシーンの切り替えムービーとして\n使用させていただきたく思っております。\n\nご検討いただけると幸いです！\nよろしくお願いいたします。\n\nhttps://x.com/nechetoa/status/1841121158877626808?s=46&t=Oa4ZKTCLf4v-MQwGGYFJGA\n\nhttps://x.com/nechetoa/status/1841121271335305336?s=46&t=Oa4ZKTCLf4v-MQwGGYFJGA", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/62", "thumbnail_src": "https://si.imgix.net/c71b8a8c/uploads/outputs/62b16e94-d916-4ab2-b191-2386e5296d8b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=95535d7d56e6094c1a1b46954dfc2b95", "thumbnail_srcset": "https://si.imgix.net/c71b8a8c/uploads/outputs/62b16e94-d916-4ab2-b191-2386e5296d8b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=95535d7d56e6094c1a1b46954dfc2b95, https://si.imgix.net/c71b8a8c/uploads/outputs/62b16e94-d916-4ab2-b191-2386e5296d8b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7eb5b1afd844bc571d62dcc32b13c1c 2x, https://si.imgix.net/c71b8a8c/uploads/outputs/62b16e94-d916-4ab2-b191-2386e5296d8b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8afc97501073144d2f5147eff6df99c 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたのスティンガーが大好きです！私のキャラクターで作ってくれませんか？\n\n彼の名前は大神九郎で、短剣と弓の扱いに長けた泥棒だ。\nアートやアニメーションのクリエイティブな自由は与えるよ！ベストを尽くして、今までで一番好きなスティンガーにしてね。）それは可能だと思いますか？\n\nhttps://drive.google.com/drive/folders/1txD55lTIMF5FRslDg1EwS84mU4-feGwj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/61", "thumbnail_src": "https://si.imgix.net/1d88e797/uploads/outputs/05e579d0-8814-4a59-b644-3508555788fa?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1e9516b48a8017e03993ed146b2186de", "thumbnail_srcset": "https://si.imgix.net/1d88e797/uploads/outputs/05e579d0-8814-4a59-b644-3508555788fa?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1e9516b48a8017e03993ed146b2186de, https://si.imgix.net/1d88e797/uploads/outputs/05e579d0-8814-4a59-b644-3508555788fa?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d04dd4e5bdc6b58558db414ef5af7b6 2x, https://si.imgix.net/1d88e797/uploads/outputs/05e579d0-8814-4a59-b644-3508555788fa?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6fce370a6384743cd2b570689785f5f 3x", "genre": "video", "nsfw": false, "body": "こんにちは！私はあなたのシーンの切り替えが大好きです！\n\n16:9のアスペクト比で、トランジションとして使用するために緑色の背景が必要です。\n\nジャケットを持っているポーズを考えているのですが、それをカメラに向かって投げて、スティンガーにしようと思っています。\n\nこれは参考資料です（帽子は含めないでください）。\nhttps://drive.google.com/file/d/1T_lfiLNSA61sLOb0eCbK7jh5OueD2MMf/view?usp=drive_link\n\n彼は、自分に敵対する側を選んだ幼なじみが関係する事件を解決するよう命じられた覆面私立探偵である。", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/60", "thumbnail_src": "https://si.imgix.net/9c582bed/uploads/outputs/745cf4d0-8e7a-4e63-bc08-07328490ad35?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c84251418506ae34ec90dcb107950ab2", "thumbnail_srcset": "https://si.imgix.net/9c582bed/uploads/outputs/745cf4d0-8e7a-4e63-bc08-07328490ad35?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c84251418506ae34ec90dcb107950ab2, https://si.imgix.net/9c582bed/uploads/outputs/745cf4d0-8e7a-4e63-bc08-07328490ad35?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=339d0acbf7f6a18a2d5965efce4a215e 2x, https://si.imgix.net/9c582bed/uploads/outputs/745cf4d0-8e7a-4e63-bc08-07328490ad35?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=21f690618d30f32fe825ae5b5e1134ec 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたのビデオが大好きなので、お願いがあります。\n\nhttps://drive.google.com/drive/folders/105jOifcBYJmbbzlOcMFfKhCYA6DVbdv1?usp=sharing\n\nラックスの手のひらのタトゥーにズームインする前に、ラックスが手を動かすようなアニメーションを作ってほしいです。五條サトルがパープルを使っているような感じで。https://drive.google.com/drive/folders/1dNlSwJADv6IDo-sAcuYiUXx6oLJz-71y?usp=sharing\n\n彼の表情は自信と威厳のあるものであるべきだ。他にふさわしいアイデアがあれば、お任せします :)\n\n16:9くらいの映像で、ストリームの時のスティンガーとして使いたい。\n\nありがとうございました。）", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/59", "thumbnail_src": "https://si.imgix.net/47fc0fc7/uploads/outputs/d63a1ccb-958c-4927-bf20-96c410618361?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=435f50adbe22da9acead22d915857018", "thumbnail_srcset": "https://si.imgix.net/47fc0fc7/uploads/outputs/d63a1ccb-958c-4927-bf20-96c410618361?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=435f50adbe22da9acead22d915857018, https://si.imgix.net/47fc0fc7/uploads/outputs/d63a1ccb-958c-4927-bf20-96c410618361?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=199c418765647bf541d97b63bd3effc0 2x, https://si.imgix.net/47fc0fc7/uploads/outputs/d63a1ccb-958c-4927-bf20-96c410618361?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=654deead2ae2c652ea72cdc21dd7469c 3x", "genre": "video", "nsfw": false, "body": "はじめまして！昨年の依頼はとても満足のいくものでしたので、今回もアズールレーンのキャラクターで同じようなものをお願いしたいと思います。\n\nアズールレーンのストラスブールの目のズームスティンガーのトランジションをお願いしたいです。彼女の目の瞳孔の中をカメラがズームし（どちらの目でも構いません）、瞳孔の中にグリーンスクリーンを追加して別のシーンに移行してほしいです。瞳孔の内側にズームする際、彼女の虹彩を美しく細部まで表現し、ズームの移行はスムーズにしてほしい。背景は完全なグリーンスクリーンにする。瞳のズーム遷移前の彼女の動作はあなた次第です。\n\n全身のリファレンス：\nhttps://drive.google.com/file/d/1G_CHlsvqjnDiYdRg9jH6B0ki7NzT0_kG/view?usp=drivesdk\n\n顔のリファレンス：\nhttps://drive.google.com/file/d/1G_uENGq2guYrlDtYN1fBmrG1Ej0xPh8X/view?usp=drivesdk\n\n私の要望を検討していただけるなら、とてもありがたい。", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/58", "thumbnail_src": "https://si.imgix.net/98b08217/uploads/outputs/11dddbcf-2f11-4e5f-8707-53d1c195613a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f504944cca7b9076761b73080c6e6dc9", "thumbnail_srcset": "https://si.imgix.net/98b08217/uploads/outputs/11dddbcf-2f11-4e5f-8707-53d1c195613a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f504944cca7b9076761b73080c6e6dc9, https://si.imgix.net/98b08217/uploads/outputs/11dddbcf-2f11-4e5f-8707-53d1c195613a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5216404b28bc536516d5c37662db858 2x, https://si.imgix.net/98b08217/uploads/outputs/11dddbcf-2f11-4e5f-8707-53d1c195613a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=15c6a8489c83bee5906afc916c1aa6bc 3x", "genre": "video", "nsfw": false, "body": "こんにちは！私はあなたのビデオがとても好きです。もし私の依頼がお気に召さないようでしたら、遠慮なくお断りください。\n\n私はこの猫のミームのようなかわいくて愚かなものが大好きです： https://imgur.com/a/hea6Drm\n\n彼女はとてもかわいく、好奇心旺盛に \"カメラ \"を見て、ゆっくりと近づき、そして \"カメラ \"にかわいく平手打ち/スマックをします。彼女がカメラを叩くとき、前足に豆があるのが見え、画面全体が叩かれるようなトランジションができたらいいなと思います。\n\n髪型はどちらでも構いません。どちらも大好きです。\n\n私の名前がないバージョンと、背景/緑の画面がないバージョンをお願いできますか？自分のストリームのスティンガーとして使いたいです。できれば16:9（1920x1080以上）のイラストを希望します。\n\n私のキャラクターデザインはこちら：https://drive.google.com/drive/u/2/folders/1wjuse5INMDx-G2LJ78YhoBi2-KacsZ3d?dmr=1&ec=wgc-drive-globalnav-goto\n\nhttps://drive.google.com/drive/u/2/folders/1wjuse5INMDx-G2LJ78YhoBi2-KacsZ3d?dmr=1&ec=wgc-drive-globalnav-goto", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/57", "thumbnail_src": "https://si.imgix.net/887fef54/uploads/outputs/6ce153fd-756a-4f05-bf64-313c30683277?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=566eed68268c05b32bc835cf36837a2a", "thumbnail_srcset": "https://si.imgix.net/887fef54/uploads/outputs/6ce153fd-756a-4f05-bf64-313c30683277?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=566eed68268c05b32bc835cf36837a2a, https://si.imgix.net/887fef54/uploads/outputs/6ce153fd-756a-4f05-bf64-313c30683277?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43fd2a15e7d56c24f495f36b90e91f42 2x, https://si.imgix.net/887fef54/uploads/outputs/6ce153fd-756a-4f05-bf64-313c30683277?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a07e87bb87f5ce205465e7639b699ad 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/56", "thumbnail_src": "https://si.imgix.net/8e2c8a9b/uploads/outputs/0d1514a3-f595-4eb0-b21a-25751bd23335?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=24eea8b33c6991f2c0bf5d11867b4e66", "thumbnail_srcset": "https://si.imgix.net/8e2c8a9b/uploads/outputs/0d1514a3-f595-4eb0-b21a-25751bd23335?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=24eea8b33c6991f2c0bf5d11867b4e66, https://si.imgix.net/8e2c8a9b/uploads/outputs/0d1514a3-f595-4eb0-b21a-25751bd23335?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c014a4300dd3a6b58c025d7cd1c6d2 2x, https://si.imgix.net/8e2c8a9b/uploads/outputs/0d1514a3-f595-4eb0-b21a-25751bd23335?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe5a185608dbd9918e3321de3beb54eb 3x", "genre": "video", "nsfw": false, "body": "私の名前はMeMoです。あなたのアートスタイルが本当に大好きです！もしあなたが私のリクエストを受け入れてくれたら、私の一日が楽しくなるでしょう。\n\n私のキャラクターとマスコットです。https://drive.google.com/drive/folders/1FTU0y_D7QCAloVR0iWdWMn1pGN1LFSpt?usp=sharing\n\nメモが髪を風になびかせながら携帯でメールをしていて、客席の方を見て顔を赤らめ、ツンデレになって恥ずかしがり、ミーモが慌てて携帯をスクリーンに投げつける。スマホがスクリーンを覆い、メモがスクリーンに向かって走ってきてスマホを拾い、申し訳なさそうな顔で可愛く泣きながら赤面してほしい！\n\n 私の名前がないバージョンと、背景/緑の画面がないバージョンをお願いできますか？自分のストリームのスティンガーとして使いたいです。できれば16:9（1920x1080以上）でお願いします。\n\nhttps://drive.google.com/drive/folders/1FTU0y_D7QCAloVR0iWdWMn1pGN1LFSpt?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/55", "thumbnail_src": "https://si.imgix.net/d889d874/uploads/outputs/68f2de9e-32c2-4de5-8bd6-bc762abf4568?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=982129392787166edf146d099e1ff6f9", "thumbnail_srcset": "https://si.imgix.net/d889d874/uploads/outputs/68f2de9e-32c2-4de5-8bd6-bc762abf4568?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=982129392787166edf146d099e1ff6f9, https://si.imgix.net/d889d874/uploads/outputs/68f2de9e-32c2-4de5-8bd6-bc762abf4568?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0882b01b943778d00f2be2dce498078 2x, https://si.imgix.net/d889d874/uploads/outputs/68f2de9e-32c2-4de5-8bd6-bc762abf4568?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f1f95d7bc84e569507ea2e25bab1442 3x", "genre": "video", "nsfw": false, "body": "16:9のトランジションを緑か透明の背景で作っていただけませんか？これはTwitchかYoutubeでストリーミングするために使用されます。\n\nhttps://skeb.jp/@kuromamekurita/works/26やhttps://skeb.jp/@kuromamekurita/works/47など、あなたの過去のトランジションスティンガー作品がとても好きです。\nいくつかアイデアはあるのですが、似合いそうなもので作っていただけませんか？私のキャラクターは、外見はクールなタイプですが、内面は照れたり恥ずかしがったりしやすい感情です。月明かりや寒さをテーマにしたものもありますが、嫌なら使わなくても構いません。\n\nキャラクター参考：https://imgur.com/a/EreQ3Um\n\n帽子は残してほしいですが、アニメーションをごちゃごちゃさせないため、あるいは簡単にするために取り外しても構いません。", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/54", "thumbnail_src": "https://si.imgix.net/80ea738f/uploads/outputs/461a0c3e-ced5-4232-89e5-5d0753d5c504?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ab92c75b219bc35dd7a460bcdc0cca83", "thumbnail_srcset": "https://si.imgix.net/80ea738f/uploads/outputs/461a0c3e-ced5-4232-89e5-5d0753d5c504?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ab92c75b219bc35dd7a460bcdc0cca83, https://si.imgix.net/80ea738f/uploads/outputs/461a0c3e-ced5-4232-89e5-5d0753d5c504?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8fd4377b031d0cfda3589f5b1cd57e1 2x, https://si.imgix.net/80ea738f/uploads/outputs/461a0c3e-ced5-4232-89e5-5d0753d5c504?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac1a59463837b6e34c2a96046e475480 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたの作品がとても好きです！私のVTuberのキャラクターのために、グリーンスクリーンのトランジションスティンガービデオを作っていただけませんか？\n\n 彼は星、宇宙、未来、仮面ライダーをモチーフにしたエイリアンの暗殺者です。\n\nこれが僕の新しいモデルの写真だよ。https://imgur.com/20FMvuM\nこれが僕のキャラクターの大まかなリファレンスシートです: https://imgur.com/7CnUHuz\n\n仮面ライダーに関連した動きに見えるようにしてほしい。ライダーキックとかライダーパンチとか、ポーズとか。ナイフで画面を切るとか。\n\nあなたの作品がとても好きです：\nhttps://skeb.jp/@kuromamekurita/works/41\nhttps://skeb.jp/@kuromamekurita/works/43\nhttps://skeb.jp/@kuromamekurita/works/47\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/53", "thumbnail_src": "https://si.imgix.net/e484fc31/uploads/outputs/174951fe-fd05-40f7-81d4-458f38858b8a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=14f2444f3a34f2ee831f3a4dcafe1207", "thumbnail_srcset": "https://si.imgix.net/e484fc31/uploads/outputs/174951fe-fd05-40f7-81d4-458f38858b8a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=14f2444f3a34f2ee831f3a4dcafe1207, https://si.imgix.net/e484fc31/uploads/outputs/174951fe-fd05-40f7-81d4-458f38858b8a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=f35b7198ff86c0dd55177ef72b1964fd 2x, https://si.imgix.net/e484fc31/uploads/outputs/174951fe-fd05-40f7-81d4-458f38858b8a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab13b321660dc7971e4aeb98b85e5d39 3x", "genre": "video", "nsfw": false, "body": "こんにちは！\n\n私のキャラクターが髪を振り乱すアニメーションをお願いしたいです。例えば、彼女が微笑みながら髪に手を通す。\n\n具体的な内容はお任せしますが、髪を自慢しているような感じにしていただけるとありがたいです。\n\n私のウェブサイトやYoutubeのミュージックビデオで使いたいと思います。グリーンスクリーンを使ったバージョンも含めていただけると助かります。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1p2pfw0yulEVbGRoGy0xZ2cKIAEv9VcHJ?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/52", "thumbnail_src": "https://si.imgix.net/058132a0/uploads/outputs/61267526-1c91-4c51-b1bd-1e551c0bd94d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ec9a417a4f006efc6a9e9076a33595f6", "thumbnail_srcset": "https://si.imgix.net/058132a0/uploads/outputs/61267526-1c91-4c51-b1bd-1e551c0bd94d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ec9a417a4f006efc6a9e9076a33595f6, https://si.imgix.net/058132a0/uploads/outputs/61267526-1c91-4c51-b1bd-1e551c0bd94d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd0802a9c68db7a97940c829e111152e 2x, https://si.imgix.net/058132a0/uploads/outputs/61267526-1c91-4c51-b1bd-1e551c0bd94d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=66b755475b1eafc3c9fe9a1aacfb8a45 3x", "genre": "video", "nsfw": false, "body": "こんにちは、アニメーションをお願いしたいのですが。\n\n参考動画（参考動画はgoogleドライブフォルダにあります）と同じ動きと表情をする私のキャラクターをアニメーション化してください。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1HIBS0u4km0KhmzAzXqfI92sQ4ZN76Ags?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1HIBS0u4km0KhmzAzXqfI92sQ4ZN76Ags?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/51", "thumbnail_src": "https://si.imgix.net/86d2d389/uploads/outputs/8d7e53e0-9d5a-44c3-9cdc-4ef60063625a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c983b120f99f8be91a7db696d57d7639", "thumbnail_srcset": "https://si.imgix.net/86d2d389/uploads/outputs/8d7e53e0-9d5a-44c3-9cdc-4ef60063625a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c983b120f99f8be91a7db696d57d7639, https://si.imgix.net/86d2d389/uploads/outputs/8d7e53e0-9d5a-44c3-9cdc-4ef60063625a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dffe07a8758d853aa1c788a2481f148 2x, https://si.imgix.net/86d2d389/uploads/outputs/8d7e53e0-9d5a-44c3-9cdc-4ef60063625a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=18d341a518900fe4fff7ef9376b2cc95 3x", "genre": "video", "nsfw": false, "body": "あなたの作品はどれも大好きです！シンプルで目に美しい！素敵な作品をお願いします！次のシーンに移るために、彼女がポーッとして、画面に向かってダンゴ🍡を投げるポーズを作ってもらえますか？背景はあなたのスタイルで構いません！ファイルも分けてもらえますか？ありがとうございました！\n\nマキアート麗子さんの参考画像です：\nhttps://x.com/ReikoMacchiato/status/1811173561702211727", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/50", "thumbnail_src": "https://si.imgix.net/c3b78124/uploads/outputs/54fad32b-fd14-4b75-9cdf-dbe6fef7e917?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=50a1dbfde36d4e2386db3a4ff12895f8", "thumbnail_srcset": "https://si.imgix.net/c3b78124/uploads/outputs/54fad32b-fd14-4b75-9cdf-dbe6fef7e917?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=50a1dbfde36d4e2386db3a4ff12895f8, https://si.imgix.net/c3b78124/uploads/outputs/54fad32b-fd14-4b75-9cdf-dbe6fef7e917?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ed29e4a059a37f97271db06e1b3b34e 2x, https://si.imgix.net/c3b78124/uploads/outputs/54fad32b-fd14-4b75-9cdf-dbe6fef7e917?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4b4deb2aa88374aef4da02c6ead3155 3x", "genre": "video", "nsfw": false, "body": "KuromamEさん、こんにちは！\n\n私は英語VtuberのMegumiです！めぐみは明るくてポジティブ！アイドルになる夢を追いかけて人間になったアヒルです。\n\nあなたの作品が大好きで、\"starting soon \"のループ画面の依頼を引き受けていただけませんか？シーンのアイデアはあります：\n\n- 日当たりの良いアヒルの池で、他のアヒルに囲まれてプカプカ浮いているめぐみ。\n- 大きなプールの筒の中に入って、腕から気持ちよさそうにぶら下がっていてほしいです。\n- 彼女がカメラに気づいて微笑むような演出もお願いします。\n\n彼女の髪はホワイトブロンド、目はグリーン！髪のリボンがチャームポイント！アヒルはちょっとおどけた感じ。\n\nこのアートはソーシャルメディアやストリーミングで使う予定です！\n\nこの度は本当にありがとうございました\n\n参考：https://drive.google.com/drive/folders/1cBrSLnesostzGOx1s0uEus4tYQawh3ZL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/49", "thumbnail_src": "https://si.imgix.net/677c34dd/uploads/outputs/04bbc409-b9bc-499c-806b-c5bc9844545a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc7669ecabf5bb8b2c9fc2725787e024", "thumbnail_srcset": "https://si.imgix.net/677c34dd/uploads/outputs/04bbc409-b9bc-499c-806b-c5bc9844545a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc7669ecabf5bb8b2c9fc2725787e024, https://si.imgix.net/677c34dd/uploads/outputs/04bbc409-b9bc-499c-806b-c5bc9844545a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21421bba90db526a5b3fbbd80ba25cbb 2x, https://si.imgix.net/677c34dd/uploads/outputs/04bbc409-b9bc-499c-806b-c5bc9844545a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abbcc4427c3548e514828963d0feed43 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/48", "thumbnail_src": "https://si.imgix.net/9f686238/uploads/origins/a97a8aa2-593d-481f-bb1a-47d96f8ab0ca?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9792fe1d166b1ef132f63ab4129556e", "thumbnail_srcset": "https://si.imgix.net/9f686238/uplo