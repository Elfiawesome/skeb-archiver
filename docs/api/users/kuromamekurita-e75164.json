reen\n\nIdea 2: I would really love this one, but if idea 1 is easier please feel free to choose that one! I would love if she could be smug and step on/kick the screen as a transition, so it looks like the viewer is being stepped on\n\nPlease note, for the character she has blue hair and gold eyes like gems. She has sharp canines and a beauty mark under her right eye!\n\nhttps://drive.google.com/drive/folders/1m6Cm-pF7TiEGje19MVc5SOBMM24gtTO0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/40", "thumbnail_src": "https://si.imgix.net/950c277f/uploads/outputs/3886a5fe-7c34-43cb-8278-9798336336ff?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92101a1ef912157114158c7b8e4a1998", "thumbnail_srcset": "https://si.imgix.net/950c277f/uploads/outputs/3886a5fe-7c34-43cb-8278-9798336336ff?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92101a1ef912157114158c7b8e4a1998, https://si.imgix.net/950c277f/uploads/outputs/3886a5fe-7c34-43cb-8278-9798336336ff?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c426a0aaa30f54485565fda63bd4976 2x, https://si.imgix.net/950c277f/uploads/outputs/3886a5fe-7c34-43cb-8278-9798336336ff?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=906a58059b0b336b442abe55712fc01e 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromamekurita/works/39", "thumbnail_src": "https://si.imgix.net/12d92b6c/uploads/outputs/1ca62b77-4b90-417b-8ced-a0cb88ecff86?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&t