=200&h=200&s=62c40bd2c749624d3f09535da711c408, https://si.imgix.net/91891ec4/uploads/origins/1f3a308b-7b18-42ef-bf53-e4a185508434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8b36b7a5f1722d7596efa2b4132cd8c 2x, https://si.imgix.net/91891ec4/uploads/origins/1f3a308b-7b18-42ef-bf53-e4a185508434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72f0b3a349d37bf3dba7ff09474c0637 3x", "genre": "art", "nsfw": true, "body": "ご依頼失礼します\n\n今回は原神の公式二次創作キャラ？ヒナさんのR18イラストをお願いします\n\n体型はヨーコさんのようにムッチリ目、陥没乳首で、母乳を垂らしながら触手に犯されて感じてしまっているイメージの物をお願いします\n\nもしよろしければお願い致します\n\nhttps://genshin.gamestlike.com/186467", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/46", "thumbnail_src": "https://si.imgix.net/5545629b/uploads/origins/d1c39868-b826-455a-80c4-8f45d4d9989c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c61d24907716ee3fba28b597e440a88", "thumbnail_srcset": "https://si.imgix.net/5545629b/uploads/origins/d1c39868-b826-455a-80c4-8f45d4d9989c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c61d24907716ee3fba28b597e440a88, https://si.imgix.net/5545629b/uploads/origins/d1c39868-b826-455a-80c4-8f45d4d9989c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ae70721298fb6291ae98ee995a14d33 2x, https://si.imgix.net/5545629b/uploads/origins/d1c39868-b826-455a-80c4-8f45d4d9989c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=731bb7b52b8d596269473da5d02e590d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの女の子の描き方が好きなので、私のバニーガールのアートをあなたからもらえたらと思いました！\n\n褐色の肌に大きな胸、太ももの太い背の低い女の子です。\n参考資料のように、ドヤ顔でギャルっぽく描いてほしいです。\nhttps://i.imgur.com/n3GC1bN.png\nhttps://i.imgur.com/CNxQVHg.png", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/45", "thumbnail_src": "https://si.imgix.net/3241cf2b/uploads/origins/3596f11f-831c-4289-bbab-9150a5fc1a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=735e97a439d77e7e739901f85750da3d", "thumbnail_srcset": "https://si.imgix.net/3241cf2b/uploads/origins/3596f11f-831c-4289-bbab-9150a5fc1a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=735e97a439d77e7e739901f85750da3d, https://si.imgix.net/3241cf2b/uploads/origins/3596f11f-831c-4289-bbab-9150a5fc1a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be8fc6d802c433261bb647161d6b647a 2x, https://si.imgix.net/3241cf2b/uploads/origins/3596f11f-831c-4289-bbab-9150a5fc1a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70164f7493ccf50d317aa94d5bd1e545 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/44", "thumbnail_src": "https://si.imgix.net/4a23fdd6/uploads/origins/35ad1c42-93d9-4604-acbd-1cf14a21822a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f4fba335a89f99698a7ff5bee8edecc", "thumbnail_srcset": "https://si.imgix.net/4a23fdd6/uploads/origins/35ad1c42-93d9-4604-acbd-1cf14a21822a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f4fba335a89f99698a7ff5bee8edecc, https://si.imgix.net/4a23fdd6/uploads/origins/35ad1c42-93d9-4604-acbd-1cf14a21822a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b5e62b9f23ec802ea702297d0d36f8e 2x, https://si.imgix.net/4a23fdd6/uploads/origins/35ad1c42-93d9-4604-acbd-1cf14a21822a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08800620f5b4fd1326f1d5e1b8af5940 3x", "genre": "art", "nsfw": true, "body": "よろしければ、艦これのビスマルク（もしくはうちの子のヨーコさん）が立ちバックで犯されている絵をお願いします。\n上半身に白いＴシャツをおっぱいをたくし上げた状態で着用（先日納品された警官狐娘みたいなものを）。\n下半身は裸で、へそが縦へそに、陰毛は描かない方向で。\n参考URL先のイラストのような構図でお願いします。\n可能であればレイヤー分けで帽子の着脱があると嬉しいです。それ以外の要素は全てお任せします。\n以上、この内容でよろしければご検討よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/101707868", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/43", "thumbnail_src": "https://si.imgix.net/e1c83780/uploads/origins/014e0ee9-323e-4ba2-9541-56841e6bcd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28c00d33c267af395be645242dfbc9df", "thumbnail_srcset": "https://si.imgix.net/e1c83780/uploads/origins/014e0ee9-323e-4ba2-9541-56841e6bcd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28c00d33c267af395be645242dfbc9df, https://si.imgix.net/e1c83780/uploads/origins/014e0ee9-323e-4ba2-9541-56841e6bcd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2b5e9970676445ebf8cfdc0f37f9f4e 2x, https://si.imgix.net/e1c83780/uploads/origins/014e0ee9-323e-4ba2-9541-56841e6bcd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83d839d26f318c0bed5a8a08aa638cb5 3x", "genre": "art", "nsfw": true, "body": "いつも大変お世話になっております。\n久々にうちの子をお願いできないでしょうか。\n\n■コスチューム\n資料URLの衣装+狐耳で、対魔忍風に描いてください。\nぴっちり感を強調し、デザインは自由にアレンジしていただいて構いません。\n\n■シチュエーション\n敗北して仰向け+大の字のポーズで拘束され、お腹の上にこれから挿入される肉棒を押し付けられて大きさを見せつけられている…といった感じでお願いします。（竿役の描写は最小限でOKです）\nその後の挿入まで描くかどうかはお任せします。\n・服はできるだけ脱がさないでください\n・竿役は別レイヤーにして消せるようにしてください\n\nhttps://twitter.com/pizza_kanon/status/1533416168597651461", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/42", "thumbnail_src": "https://si.imgix.net/aa1acd3e/uploads/origins/529dfce0-ad4a-4227-8fec-e0b483d647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ec66068225a6c6c83d23436ba55207", "thumbnail_srcset": "https://si.imgix.net/aa1acd3e/uploads/origins/529dfce0-ad4a-4227-8fec-e0b483d647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ec66068225a6c6c83d23436ba55207, https://si.imgix.net/aa1acd3e/uploads/origins/529dfce0-ad4a-4227-8fec-e0b483d647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e97749376ceef80155f8e04b84c827a 2x, https://si.imgix.net/aa1acd3e/uploads/origins/529dfce0-ad4a-4227-8fec-e0b483d647a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6e981399d504b99e9807c30302795dd 3x", "genre": "art", "nsfw": true, "body": "今回もお気に入りの性奴隷のショタを種搾りプレスで搾り尽くす惨華様をお願いします\n今までと同じ一枚絵でも、白黒の短い漫画形式でも構いません\n\n・体位は密着騎乗位\n・惨華様の両手足は触手に変化し、地面は触手で埋め尽くされている(もしくは肉壁)\n・表情は悪っぽいけど少し優しげだと嬉しい(発情して蕩けた感じ?)\n・胸は前回(資料URL)と同じくらい(ヨーコさんより大き目に)\n・陰毛は無しか、見えない角度で\n・ショタは触手でがんじがらめになっている、触手で殆ど見えなくなっててもいい\n・惨華様が自身の舌を触手に変化させてディープキスで口内も犯して欲しい(一枚絵ならカットイン、漫画ならそういうシーンを)\n\nhttps://skeb.jp/@kiraki_machine/works/34", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/41", "thumbnail_src": "https://si.imgix.net/a90a2fe6/uploads/origins/11839e8e-a5f3-4d15-857a-22e10e2ac189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4fbb2ea93734ea943da133b6836618", "thumbnail_srcset": "https://si.imgix.net/a90a2fe6/uploads/origins/11839e8e-a5f3-4d15-857a-22e10e2ac189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4fbb2ea93734ea943da133b6836618, https://si.imgix.net/a90a2fe6/uploads/origins/11839e8e-a5f3-4d15-857a-22e10e2ac189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a5878070a86d6cdca5124380f257518 2x, https://si.imgix.net/a90a2fe6/uploads/origins/11839e8e-a5f3-4d15-857a-22e10e2ac189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66fcb1e0846ee726b088b64d5b491021 3x", "genre": "art", "nsfw": true, "body": "サラシ＋ふんどし姿の風霊使いウィンちゃん（遊戯王OCG）をまたお願いしたいです！今回は後ろ向きで、ふんどしはお尻に食い込んでいる状態でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/40", "thumbnail_src": "https://si.imgix.net/f4ce30c4/uploads/origins/e5891a51-60ae-40e0-9853-14f98700c039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3590936a2b461439b668cfc8c4cfcda", "thumbnail_srcset": "https://si.imgix.net/f4ce30c4/uploads/origins/e5891a51-60ae-40e0-9853-14f98700c039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3590936a2b461439b668cfc8c4cfcda, https://si.imgix.net/f4ce30c4/uploads/origins/e5891a51-60ae-40e0-9853-14f98700c039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c0fb3fe46cfad94b3561ae8b016005c 2x, https://si.imgix.net/f4ce30c4/uploads/origins/e5891a51-60ae-40e0-9853-14f98700c039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e04b9ae6beabf7855b9e54417578e263 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしいイラストを有難うございました。\n今回も、前回描いていただいた我が家の警官狐娘をお願いしたく思います。\n\n今回はちょっと過激なシチュエーションで…所謂”敗北モノ”を依頼させていただきたく思います。\n\n大雑把なシチュエーションとしては、\n「とあるワルい組織（集団）の摘発に向かったものの、待ち伏せと不意打ちを受けた結果無力化され装備も奪われ（壊され）ピンチに…」\n「それじゃあ今までの”お礼”をしなきゃねぇ？」\nといった雰囲気のものになれば嬉しいです。\n詳しい構図やポーズなど詳細は全てお任せしたいと思いますが、衣服にはR-18な破損表現があると幸いです\n\n何卒よろしくお願いいたします。\n\nhttps://twitter.com/DarksidePot/status/1537739831165349890?s=20&t=BHr8oweC45h_FKlRlZSQnQ", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/39", "thumbnail_src": "https://si.imgix.net/2727e872/uploads/origins/d1d612ce-6272-4c3c-a7a3-7fea2cd9f78e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f1afc36576c4425ea78400337061013", "thumbnail_srcset": "https://si.imgix.net/2727e872/uploads/origins/d1d612ce-6272-4c3c-a7a3-7fea2cd9f78e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f1afc36576c4425ea78400337061013, https://si.imgix.net/2727e872/uploads/origins/d1d612ce-6272-4c3c-a7a3-7fea2cd9f78e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecb6474d5e1fd8cba70673826c3b1479 2x, https://si.imgix.net/2727e872/uploads/origins/d1d612ce-6272-4c3c-a7a3-7fea2cd9f78e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00c503dd5a333db76176215f04262b7c 3x", "genre": "art", "nsfw": true, "body": "ご依頼失礼します\n\nまたヨーコさんのR18イラストをお願いします\n\n今回のシチュエーションは以前上がっていたハロウィン衣装ヨーコさんが素晴らしかったので、あの衣装を着た状態で騎乗位でご奉仕交尾している感じの物をお願い致します\n\n以上です、可能な範囲で構いませんので宜しくお願いします\n\nhttps://www.pixiv.net/artworks/93790626", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/38", "thumbnail_src": "https://si.imgix.net/d2f39582/uploads/origins/3fed57c5-820f-46b0-b49d-8489ca23b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6558b3df9305c1955bd21514fca3a1b4", "thumbnail_srcset": "https://si.imgix.net/d2f39582/uploads/origins/3fed57c5-820f-46b0-b49d-8489ca23b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6558b3df9305c1955bd21514fca3a1b4, https://si.imgix.net/d2f39582/uploads/origins/3fed57c5-820f-46b0-b49d-8489ca23b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de4fe6d1e5752a9ff010c7d88de9c962 2x, https://si.imgix.net/d2f39582/uploads/origins/3fed57c5-820f-46b0-b49d-8489ca23b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d48c94b5fe8cf71ce8a620ff54959d7b 3x", "genre": "art", "nsfw": true, "body": "初めましてアーシスと言います、もしよろしければリクエストをおねがいできないでしょうか？\n\n水色でながいぽにてが特徴の爆乳エルフを描いてほしいです\n下記の画像の衣装に\nhttps://twitter.com/arsisuponite/status/1562993030231392257\n下記の画像で持っている剣を持たせた絵をお願いしたいです\nhttps://twitter.com/arsisuponite/status/1570932840501760001\n\nポーズ等はお任せで是非よろしくおねがいします＞＜", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/37", "thumbnail_src": "https://si.imgix.net/809dbb31/uploads/origins/7caa6db6-7d10-41ae-9d94-1416e0ef5d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc17d41905a218e5fe9bd64f303687d", "thumbnail_srcset": "https://si.imgix.net/809dbb31/uploads/origins/7caa6db6-7d10-41ae-9d94-1416e0ef5d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc17d41905a218e5fe9bd64f303687d, https://si.imgix.net/809dbb31/uploads/origins/7caa6db6-7d10-41ae-9d94-1416e0ef5d37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2fb91a06e71f0e79439b4897c834683 2x, https://si.imgix.net/809dbb31/uploads/origins/7caa6db6-7d10-41ae-9d94-1416e0ef5d37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1e2cf5677f837cd35966b5fd0164e4c 3x", "genre": "art", "nsfw": false, "body": "サラシ＋ふんどし姿の風霊使いウィンちゃんをお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/36", "thumbnail_src": "https://si.imgix.net/b8c7a299/uploads/origins/bdd96a10-b04e-43a7-9775-c83d7a2d8f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b578c72fea434b4584d7bdfdd54e03f", "thumbnail_srcset": "https://si.imgix.net/b8c7a299/uploads/origins/bdd96a10-b04e-43a7-9775-c83d7a2d8f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b578c72fea434b4584d7bdfdd54e03f, https://si.imgix.net/b8c7a299/uploads/origins/bdd96a10-b04e-43a7-9775-c83d7a2d8f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7437a608d79c9161331000a51d90c6a 2x, https://si.imgix.net/b8c7a299/uploads/origins/bdd96a10-b04e-43a7-9775-c83d7a2d8f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14bcea1883d21379a9cca61c5b736f76 3x", "genre": "art", "nsfw": false, "body": "こんにちは。バストアップしたキツネの描き方が好きです。\n\n私の絵もお願いできますか？\n\nミラワ： https://imgur.com/a/T8l5VBK\n\nhttps://imgur.com/a/fL2Pj0Z\nhttps://imgur.com/a/prRKydw\n\n彼女はいくつかの衣装を再利用しています、あなたが最も好きなものを選択してください。", "created_at": "", "completed_at": ""}, {"path": "/@kiraki_machine/works/35", "thumbnail_src": "https://si.imgix.net/cce3fd33/uploads/origins/9bb2839b-a44e-40e0-867d-519e19082551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PR