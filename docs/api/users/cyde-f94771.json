fb32-822c-4c84-a953-e3e3ce89e4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e6edfae3e6022c01a4fea545e01860", "thumbnail_srcset": "https://si.imgix.net/d2324df9/uploads/origins/060efb32-822c-4c84-a953-e3e3ce89e4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e6edfae3e6022c01a4fea545e01860, https://si.imgix.net/d2324df9/uploads/origins/060efb32-822c-4c84-a953-e3e3ce89e4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b41a529215743df64387fdc5bb2b3038 2x, https://si.imgix.net/d2324df9/uploads/origins/060efb32-822c-4c84-a953-e3e3ce89e4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3fe258fb83a38e1293bf3d0c0f39d52 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n\nアイドルマスターシンデレラガールズより、\n乙倉悠貴さんのイラストをリクエストさせて頂きます。\n\nシチュエーション\nちょっとえっちなグラビア撮影をしている感じで、\nベッドの上に下着姿で寝転がった乙倉さんを描いて頂きたいです。\n\n下着のデザインについては身体のラインがわかりやすい\nぴったりした感じのスポーツブラ・女性用ボクサーパンツ、\n淡いピンク色であまり飾り気のないもの。\n\nポーズについては差分込みで2種類お願いしたいのですが、\n①基本のパターン\n上半身は両腕を伸ばして頭より上で交差するような感じで、両腋がよく見えるポーズ。\nうっすらと肋骨が浮いている描写をして頂きたいです。\n下半身は膝を曲げて足を揃えた状態。\n表情は少し恥ずかしそうな笑顔。\n\n②えっち差分\n①の状態から下半身は股を開いた状態にして頂いて、\n少し汗ばんだような感じで腋・股のあたりに蒸気のエフェクトを加えて頂きたいです。\n表情は上気してぼーっとした感じでお願いします。\n\nアングルについてはベッドの真上から、\n乙倉さんを正面から撮影している感じで、\n背景についてはベッドシーツのしわの描写をお願い致します。\n\n以上、ご検討頂ければ幸いです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@cyde/works/15", "thumbnail_src": "https://si.imgix.net/531e8bfc/uploads/origins/43857c0a-2e26-40a1-8895-f66fa7b33721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f13da839d6bbffb2c156dcd2d173ee6", "thumbnail_srcset": "https://si.imgix.net/531e8bfc/uploads/origins/43857c0a-2e26-40a1-8895-f66fa7b33721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f13da839d6bbffb2c156dcd2d173ee6, https://si.imgix.net/531e8bfc/uploads/origins/43857c0a-2e26-40a1-8895-f66fa7b33721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=736cf23163095fb574cdd57c12fa0426 2x, https://si.imgix.net/531e8bfc/uploads/origins/43857c0a-2e26-40a1-8895-f66fa7b33721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be6ad43f974dae8ea0953c3445754d7d 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n秋めいてDDDのバニー衣装を着ている北条加蓮をお願いします。\n\n構図などはお任せいたします。\nよろしくお願いします！", "created_at": "", "completed_at": ""}]}