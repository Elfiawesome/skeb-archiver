px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdf5e7c190e193dcf08c01bcb4439a62 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/142", "thumbnail_src": "https://si.imgix.net/6629a45e/uploads/origins/dbf399db-44d8-4c18-a491-1732b9f9fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a798e0a14895756ec611e4c7f1f0ad42", "thumbnail_srcset": "https://si.imgix.net/6629a45e/uploads/origins/dbf399db-44d8-4c18-a491-1732b9f9fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a798e0a14895756ec611e4c7f1f0ad42, https://si.imgix.net/6629a45e/uploads/origins/dbf399db-44d8-4c18-a491-1732b9f9fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3362c2633ed682ddba82aefcf2e0f2df 2x, https://si.imgix.net/6629a45e/uploads/origins/dbf399db-44d8-4c18-a491-1732b9f9fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00d07ca6b96a40a826777f6cbba8ed34 3x", "genre": "art", "nsfw": false, "body": "ローゼンメイデンの真紅を描いていただきたいです。\n紅茶を飲んでいるような日常的「ではない」イラストが希望です。それ以外はおまかせいたします。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/141", "thumbnail_src": "https://si.imgix.net/e4756479/uploads/origins/3be1477f-5d4f-4981-81f9-8faaf597c56a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f31e91ba38553482fa1b2de9f30eaef", "thumbnail_srcset": "https://si.imgix.net/e4756479/uploads/origins/3be1477f-5d4f-4981-81f9-8faaf597c56a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f31e91ba38553482fa1b2de9f30eaef, https://si.imgix.net/e4756479/uploads/origins/3be1477f-5d4f-4981-81f9-8faaf597c56a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a12f60c40c71a65efccdb46f88a5b84 2x, https://si.imgix.net/e4756479/uploads/origins/3be1477f-5d4f-4981-81f9-8faaf597c56a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=119f90a02b2d0d1323b408334260ca12 3x", "genre": "art", "nsfw": false, "body": "前回は幸せいっぱいニンジンいっぱいのいつものうさちゃんをありがとうございました\n下僕の誕生日をお祝いしてくれるいつものうさちゃんをぜひ描いて頂きたくリクエスト致しました。\n下僕の姿はなくてOKです\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/140", "thumbnail_src": "https://si.imgix.net/e13c8cca/uploads/origins/3b268b35-5ae3-4f2d-b0c0-e1da33088e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879bdfd7de3abf3aa700f854b64cdba6", "thumbnail_srcset": "https://si.imgix.net/e13c8cca/uploads/origins/3b268b35-5ae3-4f2d-b0c0-e1da33088e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879bdfd7de3abf3aa700f854b64cdba6, https://si.imgix.net/e13c8cca/uploads/origins/3b268b35-5ae3-4f2d-b0c0-e1da33088e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc36b8e265dff6a65a2b32071564833a 2x, https://si.imgix.net/e13c8cca/uploads/origins/3b268b35-5ae3-4f2d-b0c0-e1da33088e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fb913de00467e77cd16a6c598c4dc82 3x", "genre": "art", "nsfw": false, "body": "初めまして、Rosetta（ロゼッタ）と申します。\nもしよろしければ私自身を描いていただきたく、下記内容是非ご検討いただけますと幸いです。\n\n【用途】\nVsinger活動の配信画面やSNS、ネップリ、グッズなどに使用予定です（現時点で個人利用の範囲内ですが、将来的に活動が収益化された場合も同一用途での継続使用が可能かご確認いただけますと幸いです）\n\n【サイズ】\n横長（1920×1080）のイラストで、配信のサムネ背景として使用できるような一枚をお願いできればと考えております\n\n【キャラクターデザイン・設定】\n・「極北の古城に住み着いている長寿の薔薇の精霊」\n・髪は青みがかかった薄いピンクで毛先にかけてグラデーション\n・瞳はグレーのかかったアイスブルーでクリスタルのように煌めいている\n・住み着いている古城でお茶会を開いたり朗読会をするのが趣味で、普段は図書やアンティークに囲まれてのんびりと歌っている\n・性格は大人しく控えめでマイペース、黙っているとミステリアス、外見年齢は20代前半\n\nご縁がございましたら大変嬉しく存じます。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1opraTI0Blw8Enbp01ix9I5hagUNX2EJ6?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/139", "thumbnail_src": "https://si.imgix.net/a114c3e6/uploads/origins/b2e77e82-f191-4a20-a58e-64062544a1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c6b9b93b735a1be738b047a2084d887", "thumbnail_srcset": "https://si.imgix.net/a114c3e6/uploads/origins/b2e77e82-f191-4a20-a58e-64062544a1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c6b9b93b735a1be738b047a2084d887, https://si.imgix.net/a114c3e6/uploads/origins/b2e77e82-f191-4a20-a58e-64062544a1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9048207a782a5212b00a176e3b251ad 2x, https://si.imgix.net/a114c3e6/uploads/origins/b2e77e82-f191-4a20-a58e-64062544a1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b5af09301f99ea41dc8c4469bc90607 3x", "genre": "art", "nsfw": false, "body": "Hello! It's been quite a while since I last commissioned you! Your artistic talent always brings a smile to my face. 😊\n\nThis time around, I'd like to commission you for a piece of my favorite character from LIVE A LIVE (ライブ・ア・ライブ)—Oersted (オルステッド). Here's his reference sheet: https://drive.google.com/drive/folders/1z0cKEanxYii9_qIxSN_pjX6tsLkrYrl2?usp=sharing\n\nI have an idea for the piece. Having shed the last of his humanity, Oersted's expression is cold, bearing immense hate and misanthropy. The Lord of Dark's statue (as seen in the fourth picture) stands behind him, blurred.\n\nhttps://drive.google.com/drive/folders/1z0cKEanxYii9_qIxSN_pjX6tsLkrYrl2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/138", "thumbnail_src": "https://si.imgix.net/86774344/uploads/origins/f32bd7c6-da61-4e58-9e01-d285c835bd56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f441790629af440f297a3c40bcfd150", "thumbnail_srcset": "https://si.imgix.net/86774344/uploads/origins/f32bd7c6-da61-4e58-9e01-d285c835bd56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f441790629af440f297a3c40bcfd150, https://si.imgix.net/86774344/uploads/origins/f32bd7c6-da61-4e58-9e01-d285c835bd56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=872fce59aee61bd10b45bd07191462d0 2x, https://si.imgix.net/86774344/uploads/origins/f32bd7c6-da61-4e58-9e01-d285c835bd56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=424090a6d61c5406c8ff25177f609c13 3x", "genre": "art", "nsfw": false, "body": "ギルティギアの飛鳥R#が奮闘", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/137", "thumbnail_src": "https://si.imgix.net/61ee78e5/uploads/origins/30e62ecc-e99a-4fa2-b777-d42d13fb2bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eac863b2bf8222746849370597f8490", "thumbnail_srcset": "https://si.imgix.net/61ee78e5/uploads/origins/30e62ecc-e99a-4fa2-b777-d42d13fb2bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eac863b2bf8222746849370597f8490, https://si.imgix.net/61ee78e5/uploads/origins/30e62ecc-e99a-4fa2-b777-d42d13fb2bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41f5163837bd365e56c456b1cdf7bdcf 2x, https://si.imgix.net/61ee78e5/uploads/origins/30e62ecc-e99a-4fa2-b777-d42d13fb2bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42f10c83ed4de48efb73ab981219768c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@miyama_BB/works/136", "thumbnail_src": "https://si.imgix.net/73997ce7/uploads/origins/cede70a4-59d2-4272-b9e4-f3fdc6a2db40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be7bd1552c0a041fe95d9b5d28ff5a8f", "thumbnail_srcset": "https://si.imgix.net/73997ce7/uploads/origins/cede70