る　透明\n・肉体を完全に立体の形にしてください、その上にシンプルでわかりやすい筋肉があるイメージ\n・場合によっては筋肉を省略しても大丈夫です、（ティッシュ箱型なら骨盤部分はないなど）\n・グリフォンマスクの目は黒目に黄色の瞳\n\nhttps://imgur.com/a/hmuRvAw", "created_at": "", "completed_at": ""}, {"path": "/@LITEU/works/160", "thumbnail_src": "https://si.imgix.net/dd37cd58/uploads/origins/57a00ab9-6609-432e-b308-dbc2be6078a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06a918a309ffddc18566128161dee357", "thumbnail_srcset": "https://si.imgix.net/dd37cd58/uploads/origins/57a00ab9-6609-432e-b308-dbc2be6078a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06a918a309ffddc18566128161dee357, https://si.imgix.net/dd37cd58/uploads/origins/57a00ab9-6609-432e-b308-dbc2be6078a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e912e9c5fe5acc89f114d5be910e6e8 2x, https://si.imgix.net/dd37cd58/uploads/origins/57a00ab9-6609-432e-b308-dbc2be6078a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22933e88093a0f4dc014b32a8f825401 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@LITEU/works/159", "thumbnail_src": "https://si.imgix.net/efccb0f3/uploads/origins/ed955a9f-9c25-48e2-838c-c1be2abb7f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aea88c508f48097be5f819c4de51e240", "thumbnail_srcset": "https://si.imgix.net/efccb0f3/uploads/origins/ed955a9f-9c25-48e2-838c-c1be2abb7f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=