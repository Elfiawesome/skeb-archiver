4-8b99-a36f7591bc68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a345d2c853c44d2ff0536637cb9e6722, https://si.imgix.net/0c2f8cd4/uploads/origins/389981e1-f6f3-42c4-8b99-a36f7591bc68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=956aa2db431e1509ab05aebdec6753d2 2x, https://si.imgix.net/0c2f8cd4/uploads/origins/389981e1-f6f3-42c4-8b99-a36f7591bc68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c9a2fc2fff46054574ebf065a485466 3x", "genre": "art", "nsfw": false, "body": "前回の依頼がとても良かったので、今回もお願いすることにしました。\n\nこのアートと対になるものをお願いしたい\nhttps://skeb.jp/@umigame_2000/works/2\n\nDIAというOCのアートを頼みたいと思っています。怠け者だけど、いざというときは頼りになるかっこいいお姉さんという雰囲気。彼女は思慮深く、行動を起こす前に綿密な計画を立てることを好む。DIAはハンドガンと、爪や大砲などの武器に変形できる腕を使って戦います。趣味は探偵小説。彼女は甘いペストリーとブラックコーヒーが好きだ。ふっくらとした大きな胸と柔らかそうな体。\n\n好きなように作曲してください。先生がかっこいいと思うものなら何でもいいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi", "created_at": "", "completed_at": ""}, {"path": "/@umigame_2000/works/6", "thumbnail_src": "https://si.imgix.net/c5a0ad28/uploads/origins/c32b19a8-2a26-4a41-886c-d90e96ada33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8e82eb03a93778c1706ebfa69c2476d", "thumbnail_srcset": "https://si.imgix.net/c5a0ad28/uploads/origins/c32b19a8-2a26-4a41-886c-d90e96ada33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8e82eb03a93778c1706ebfa69c2476d, https://si.imgix.net/c5a0ad28/uploads/origins/c32b19a8-2a26-4a41-886c-d90e96ada33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9516780405a1edf143234f93a0fb0d29 2x, https://si.imgix.net/c5a0ad28/uploads/origins/c32b19a8-2a26-4a41-886c-d90e96ada33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d009a805007416d0c5072ce4022b9308 3x", "genre": "art", "nsfw": false, "body": "オレンジ色のビキニを着た私のオリジナルキャラクターを描いてください。セクシーなポーズで。\n目の色：グレー\n\n身長: 5'9 \"\n\n年齢: 20\n\n犬耳\n\nアクセサリー：赤い首輪\n\n背景: ビーチ\n\nポーズ: セクシー\n\n表情：浮気\n\n私のオリジナルキャラクターの参考文献はこちら: https://www.deviantart.com/citrusanime/art/My-Offical-DA-Mascot-290687270\n\n他のアーティスト 1. https://sta.sh/023ht6z36vqf 2. https://sta.sh/0278r2mg6ixd 3. https://sta.sh/0k1ja8v3adq\n\nポーズの参考文献 1. https://sta.sh/0ufsyy8di0d 2. https://sta.sh/0sozjsty4p7 3. https://sta.sh/01hzsy3ciyyy\n\nセクシーに描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@umigame_2000/works/5", "thumbnail_src": "https://si.imgix.net/16c33f14/uploads/origins/71b4c1af-8fbc-47d4-8ff4-7ae185c81442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a95a3333d956bff6ae5e0065c149dbd9", "thumbnail_srcset": "https://si.imgix.net/16c33f14/uploads/origins/71b4c1af-8fbc-47d4-8ff4-7ae185c81442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a95a3333d956bff6ae5e0065c149dbd9, https://si.imgix.net/16c33f14/uploads/origins/71b4c1af-8fbc-47d4-8ff4-7ae185c81442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c802073459d7fcf2f3a7f16553a4a88c 2x, https://si.imgix.net/16c33f14/uploads/origins/71b4c1af-8fbc-47d4-8ff4-7ae185c81442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07e8dfd054525871315f8453e9859693 3x", "genre": "art", "nsfw": false, "body": "SKIMAでいつもお世話になっております。\nSkebもやっておられるとのことで、\n今回はSkebからリクエストしてみます。\n\n例のごとく当方小説に登場するOCなのですが、\nいずれかいちばん興味のあるものをお選びいただいて、\nuMiさんの得意とする雰囲気やポージング、アングル等々にて、\nイラストに描いていただけるとありがたいです。\nSKIMAと違って、それ以上の指定事項や条件はありません！\n背景の有無等もおまかせします。\n\nもしかしたら、キャラ紹介の立ち絵や、\n説明用資料として使わせていただくかもしれません。\n\nご検討いただけるとありがたいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_bvAiXDbKCxRJ16x2QWPEG5MHHPjEEyi", "created_at": "", "completed_at": ""}, {"path": "/@umigame_2000/works/4", "thumbnail_src": "https://si.imgix.net/5b4a9974/uploads/origins/39e1f66b-9256-4d52-968d-0ab2c161831a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57851aa9301c93346987d9664030dfd8", "thumbnail_srcset": "https://si.imgix.net/5b4a9974/uploads/origins/39e1f66b-9256-4d52-968d-0ab2c161831a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57851aa9301c93346987d9664030dfd8, https://si.imgix.net/5b4a9974/uploads/origins/39e1f66b-9256-4d52-968d-0ab2c161831a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8157dcd8dcbc05844e05efd8ee0c973 2x, https://si.imgix.net/5b4a9974/uploads/origins/39e1f66b-9256-4d52-968d-0ab2c161831a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e914ab82574cb33f044a3b14007c4df 3x", "genre": "art", "nsfw": false, "body": "こんにちは！オリジナルキャラクターのイラストを描いていただきたいです！\n\nキャラクター\n・ナシュワ（188cm）新米ファイヤーマジシャン\n・シャール（177cm）氷のベテランマジシャン\n・悪魔の手先\n\n背景\nナシュワとシャールは超自然的な殺人事件の捜査を任される。彼らは地元の大学で事件が起きたという情報を得る。\n\n現場に到着すると、悪魔の手先がいた。シャールはすぐさま氷の魔法を使い、彼らを動けなくする。しかしナシュワは新米のため、感情に任せて炎の魔法を使ってしまう。その結果、炎が凍った悪魔に当たり、霧が発生して視界が遮られる。霧が晴れると、悪魔たちは消えていた。\n\n備考\n・舞台は廊下です。廊下のサンプル画像を添付します。\n・悪魔の手先は、demon.pngに描かれている悪魔が召喚した手下です。つまり、demon.pngよりも小さく、威嚇していないように見えるはずです。\n\nよろしくお願いいたします！\n\nhttps://ln5.sync.com/dl/7ec4d4f60/hk7njsbg-ne86viib-ikjkjcz9-kud6yts7", "created_at": "", "completed_at": ""}, {"path": "/@umigame_2000/works/3", "thumbnail_src": "https://si.imgix.net/bb7bc3c1/uploads/origins/211e06b6-0c72-4fd9-8cde-8f232ad01952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bd5979d4fa92fc73b866f951a8f3b2", "thumbnail_srcset": "https://si.imgix.net/bb7bc3c1/uploads/origins/211e06b6-0c72-4fd9-8cde-8f232ad01952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bd5979d4fa92fc73b866f951a8f3b2, https://si.imgix.net/bb7bc3c1/uploads/origins/211e06b6-0c72-4fd9-8cde-8f232ad01952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c19d7be43ba385dd60964572f815eeda 2x, https://si.imgix.net/bb7bc3c1/uploads/origins/211e06b6-0c72-4fd9-8cde-8f232ad01952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6adfd9c4775ae30853b6955f1