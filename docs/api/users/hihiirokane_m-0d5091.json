a318ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9ab829dcb7fd5b404c8792897e18c05", "thumbnail_srcset": "https://si.imgix.net/5d985f57/uploads/origins/96e5bfeb-998f-4ba6-a302-9fdbdaa318ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9ab829dcb7fd5b404c8792897e18c05, https://si.imgix.net/5d985f57/uploads/origins/96e5bfeb-998f-4ba6-a302-9fdbdaa318ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f079e92df7a876d44a6abe07de81a67 2x, https://si.imgix.net/5d985f57/uploads/origins/96e5bfeb-998f-4ba6-a302-9fdbdaa318ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f9594f8706cd04540e26775db71a07d 3x", "genre": "art", "nsfw": true, "body": "リクエストお願いします\n花騎士のアネモネとアプリコット\n服装はパラレル学園\n内容は先生（団長）が窓開けた時、風で書類がバラけたりアネモネとアプリコットのスカートがめくれパンツ丸見えになっているシーンをお願いします\n下着はアネモネ青のスケスケ\n　　　アプリコットは白のレースでお願いします\n可能であれば表情差分をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/324", "thumbnail_src": "https://si.imgix.net/2756caed/uploads/origins/98867be6-1c01-4fd9-b5e2-5e9c74bca0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9efd9c3a17b2578c08f66642d612ef5", "thumbnail_srcset": "https://si.imgix.net/2756caed/uploads/origins/98867be6-1c01-4fd9-b5e2-5e9c74bca0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9efd9c3a17b2578c08f66642d612ef5, https://si.imgix.net/2756caed/uploads/origins/98867be6-1c01-4fd9-b5e2-5e9c74bca0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4d989180cc6ffd315c2963eafbc0227 2x, https://si.imgix.net/2756caed/uploads/origins/98867be6-1c01-4fd9-b5e2-5e9c74bca0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5b0a137605e8713171bab7e633bcfc1 3x", "genre": "art", "nsfw": true, "body": "ご多忙のところ失礼します。リクエスト再開、楽しみにしておりました。\n前回は素晴らしいイラストありがとうございました。\n改めてリクエストさせていただきます。\n\n【キャラクター】（作品）\n・タケ（フラワーナイトガール）\n・フィオナ（ティンクルスターナイツ）\n・ヴァネッサ（天啓パラドクス）\n【服装】\n全裸\nタケの髪型は姫カットでお願いします。\n\n【シチュエーション】\n快晴の河原にて、全裸で水遊びしているシーンをお願いします。\n構図は資料URLを参考にしてください。\n\nそのほかはお任せします。\n\nhttps://www.pixiv.net/artworks/94040079", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/323", "thumbnail_src": "https://si.imgix.net/7877de80/uploads/origins/2c114f77-cecd-4513-956b-0a7d51ae6613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b84016d22ed19dec256b2e429461c32", "thumbnail_srcset": "https://si.imgix.net/7877de80/uploads/origins/2c114f77-cecd-4513-956b-0a7d51ae6613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b84016d22ed19dec256b2e429461c32, https://si.imgix.net/7877de80/uploads/origins/2c114f77-cecd-4513-956b-0a7d51ae6613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57fc2e7b54997cf808046666cd2aca4b 2x, https://si.imgix.net/7877de80/uploads/origins/2c114f77-cecd-4513-956b-0a7d51ae6613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea39a010dc5b829074b894ab79d08e11 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/322", "thumbnail_src": "https://si.imgix.net/c353d467/uploads/origins/2b611246-73ab-497d-888f-1f8a8b7ac49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c52e4ea0a6b499579a7e9afd98326447", "thumbnail_srcset": "https://si.imgix.net/c353d467/uploads/origins/2b611246-73ab-497d-888f-1f8a8b7ac49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c52e4ea0a6b499579a7e9afd98326447, https://si.imgix.net/c353d467/uploads/origins/2b611246-73ab-497d-888f-1f8a8b7ac49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c7d5a5add5e8eef5f9078dcbded0288 2x, https://si.imgix.net/c353d467/uploads/origins/2b611246-73ab-497d-888f-1f8a8b7ac49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=458d462630da048ec53706ec265081ae 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のリクエストを考慮していただき、ありがとうございます。\n\nこのMCを、オリジナルデザインのスーパーヒーローの格好で描いていただけませんか？デザインは自由にお願いします！足とバストを太くしてください！\n\nhttps://drive.google.com/drive/folders/1CdmWtz9hf6VzgNdCSpavRT6VlPEdqDb7?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/321", "thumbnail_src": "https://si.imgix.net/1f5d8aa0/uploads/origins/5a64bd9b-6515-4dc9-806a-fdffef64dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=395fa84321890dee76127941543c33b6", "thumbnail_srcset": "https://si.imgix.net/1f5d8aa0/uploads/origins/5a64bd9b-6515-4dc9-806a-fdffef64dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=395fa84321890dee76127941543c33b6, https://si.imgix.net/1f5d8aa0/uploads/origins/5a64bd9b-6515-4dc9-806a-fdffef64dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=798f10f109c20a78ea96f0f20794246c 2x, https://si.imgix.net/1f5d8aa0/uploads/origins/5a64bd9b-6515-4dc9-806a-fdffef64dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=263300d1c15ce04366d92fae37e23566 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/320", "thumbnail_src": "https://si.imgix.net/d2fcae81/uploads/origins/308eb133-070e-4f36-a2fd-6b9255f3c14c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b55d22cbf7927de25d0e91bd6a9e0cdb", "thumbnail_srcset": "https://si.imgix.net/d2fcae81/uploads/origins/308eb133-070e-4f36-a2fd-6b9255f3c14c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b55d22cbf7927de25d0e91bd6a9e0cdb, https://si.imgix.net/d2fcae81/uploads/origins/308eb133-070e-4f36-a2fd-6b9255f3c14c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfa07e7d3ffd6789498145c9c4693eca 2x, https://si.imgix.net/d2fcae81/uploads/origins/308eb133-070e-4f36-a2fd-6b9255f3c14c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a90b1b908264f87c5657b9310bd3ef3c 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。\n今回は私のOCを2人描いてほしいの。おそろいのランジェリーhttps://www.deviantart.com/stash/2taqez4hs9l。\n\n最初のOC https://www.deviantart.com/stash/2syiqctj58a\n二人目のOC https://www.deviantart.com/stash/2mju3srmdfu\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/319", "thumbnail_src": "https://si.imgix.net/069c9880/uploads/origins/c6d60a27-1c7e-4caa-becd-726150e06952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb9e0cc14ed686a74860b95cc9e074ae", "thumbnail_srcset": "https://si.imgix.net/069c9880/uploads/origins/c6d60a27-1c7e-4caa-becd-726150e06952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb9e0cc14ed686a74860b95cc9e074ae, https://si.imgix.net/069c9880/uploads/origins/c6d60a27-1c7e-4caa-becd-726150e06952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00b520dc39d9d2922fea016eaa6e3b0d 2x, https://si.imgix.net/069c9880/uploads/origins/c6d60a27-1c7e-4caa-becd-726150e06952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9291539de34b240b8f23a075497beda1 3x", "genre": "art", "nsfw": false, "body": "こんにちは まかろにさん！\n久しぶりにまたご連絡いたします\n今回、前の作業とペアになるレーシングガールを依頼したいです\n(https://skeb.jp/@hihiirokane_m/works/165)\nよろしければ、次はリクエストの詳細です\n\n1.キャラクター\nドルフロのMG15をお願いします\n(https://iopwiki.com/wiki/MG15)\n\n2.服装\n下記のデザインに従って\nhttps://skeb.jp/@hihiirokane_m/works/111\n(※スカートオン/オフの両方でお願いします)\n\n○服装の配色はブラック50%、レッド50%の感じで\n○頭には原本イラストのギャリソン帽\n○今回は傘を持っているものでお願いします\n○グラマーな体つき\n\n3.ポーズ\nポーズは前の作業と対称な感じで自由にお願いします\n(https://skeb.jp/@hihiirokane_m/works/165)\n\n※ 膝上の全身絵でお願いします\n\n4.表情\n自信満々に笑っている表情でお願いします\n\n背景は自由にお願いします\n\n以上です。\nではご検討 宜しくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/318", "thumbnail_src": "https://si.imgix.net/ecfbd620/uploads/origins/e7a076df-ceb2-42d5-8538-2b35ff0d94a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c22ea48b00d5db08f35e5756146c108b", "thumbnail_srcset": "https://si.imgix.net/ecfbd620/uploads/origins/e7a076df-ceb2-42d5-8538-2b35ff0d94a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c22ea48b00d5db08f35e5756146c108b, https://si.imgix.net/ecfbd620/uploads/origins/e7a076df-ceb2-42d5-8538-2b35ff0d94a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9da8e5ecb6a09f7e094017a418de0c5 2x, https://si.imgix.net/ecfbd620/uploads/origins/e7a076df-ceb2-42d5-8538-2b35ff0d94a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6d4f0a7587ebb50f624c67b3ddf3a83 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/317", "thumbnail_src": "https://si.imgix.net/00ac5801/uploads/origins/f52fc56c-9561-4a30-864f-f413cfd6d2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9613877782a510288981e4c09d567bd1", "thumbnail_srcset": "https://si.imgix.net/00ac5801/uploads/origins/f52fc56c-9561-4a30-864f-f413cfd6d2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9613877782a510288981e4c09d567bd1, https://si.imgix.net/00ac5801/uploads/origins/f52fc56c-9561-4a30-864f-f413cfd6d2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=338750652a398fac7c9f080b48474421 2x, https://si.imgix.net/00ac5801/uploads/origins/f52fc56c-9561-4a30-864f-f413cfd6d2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50ace96ef458f13037ecb81a9dc441aa 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストありがとうございます\nリクエスト再開と聞いて、またお願いできますでしょうか。\n\n今年もフリューネの誕生月の時期が来たので\n\n【クリエイティブＲＰＧ　蒼空のフロンティア】\n『一匹狼の義賊』フリューネ・ロスヴァイセ\n『駆け出し義賊』リネン・エルフト\n\n２ショットのお祝いイラストでリクエストします\n\n昨年は正統派のドレス姿をご披露いただけたので、今年はペアのバニーガール風で。\nお祝いイラストということでちょっと華やかな感じのデザインだとうれしいです\nパーティの１シーンという感じでお願いします。今回も構図やシチュエーションはお任せです。\n\n\nリネンのデザイン設定はＵＲＬの方をご確認ください（こちらも過去にお願いしたのと同じ感じで大丈夫です）\nhttps://drive.google.com/file/d/1J-w7C-YrtPWfrfH8JJfIUwJK2LETWZH6/view?usp=sharing\n\nコスチュームは資料のものでも、ドレスや普段着などアレンジいただいても構いません。よろしくお願いします\n\nhttps://drive.google.com/file/d/1y0ZZBte5ZCBALp5SsEeL68_YlrcbM9uk/view?us", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/316", "thumbnail_src": "https://si.imgix.net/09897b54/uploads/origins/4ceee264-774b-44d4-b19c-ef35ccf55ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acf96ef99cec69be7c15569a39a45329", "thumbnail_srcset": "https://si.imgix.net/09897b54/uploads/origins/4ceee264-774b-44d4-b19c-ef35ccf55ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acf96ef99cec69be7c15569a39a45329, https://si.imgix.net/09897b54/uploads/origins/4ceee264-774b-44d4-b19c-ef35ccf55ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcded58b969f7f9f7c014f1a4d6a1e9a 2x, https://si.imgix.net/09897b54/uploads/origins/4ceee264-774b-44d4-b19c-ef35ccf55ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f7360bfaeab2755462815a8109f8452 3x", "genre": "art", "nsfw": true, "body": "うちの子のイラスト作成をお願いしたく存じます。\nキャラクリできるゲームで決まって作るキャラクターで外見設定等は固まっておりますが特にこれといった立ち絵はありませんので、\n資料URL内プロフィールの容姿欄を参考にしていただければと存じます。\n\n■資料URL\nhttps://drive.google.com/drive/folders/13P3Ppfz4NWW2yTI8RJhDKWkmdtYVve6J?usp=sharing\n\nえっちな格好でえっちなポーズでお願いします。内容はお任せします。\n可能であれば全裸、衣服のずれや透けなどの差分をお願いしたく存じます。\n\n以上、ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/315", "thumbnail_src": "https://si.imgix.net/bb910bdb/uploads/origins/2eec56bb-483d-43a9-8f27-03c0e3306405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bdab4ddb2e24135f8166e646e427b42", "thumbnail_srcset": "https://si.imgix.net/bb910bdb/uploads/origins/2eec56bb-483d-43a9-8f27-03c0e3306405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bdab4ddb2e24135f8166e646e427b42, https://si.imgix.net/bb910bdb/uploads/origins/2eec56bb-483d-43a9-8f27-03c0e3306405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=971184605c6195e4aa1d2e280d756f7d 2x, https://si.imgix.net/bb910bdb/uploads/origins/2eec56bb-483d-43a9-8f27-03c0e3306405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac5a1fa3ddcad20d52150b0967326532 3x", "genre": "art", "nsfw": true, "body": "まかろにさん、はじめまして。\nFF14のミコッテOCAyaのセクシーなチアガールのイラストをお願いしたいです。\n\nAyaについて\n・ミコッテ(サンシーカー)です。\n・髪色はほぼ黒に近い紫に赤いメッシュ。\n・尖った形の猫耳。人耳はありません。\n・瞳は右目が黄色、左目が青。猫目のような縦長の瞳孔。\n・薄いアイシャドウとルージュ、頬にライン。\n・尻尾は長めで先端まで太さ・毛色が変わらないタイプ。\n・普段は真面目ですが、根はいたずら好き。\n\nチアリーディングのスタイルで、デザインやポーズはお任せします。\nセクシーなインナーにわれめが浮き出ているのが見えていると嬉しいです。\nもし可能ならPSDのレイヤーでコスチュームのパーツごとにオンオフできると嬉しいです。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1hggx9VEIfwXimqSH5cv2qgCz6LNQj8Ll?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/314", "thumbnail_src": "https://si.imgix.net/3a5c1bb6/uploads/origins/b1a9a030-bb96-4d69-820e-8f47aa72ae00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd12c65ee778f6f2784d4b82ed3e0a3", "thumbnail_srcset": "https://si.imgix.net/3a5c1bb6/uploads/origins/b1a9a030-bb96-4d69-820e-8f47aa72ae00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd12c65ee778f6f2784d4b82ed3e0a3, https://si.imgix.net/3a5c1bb6/uploads/origins/b1a9a030-bb96-4d69-820e-8f47aa72ae00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14372d3242f90343f70be5058c3c9099 2x, https://si.imgix.net/3a5c1bb6/uploads/origins/b1a9a030-bb96-4d69-820e-8f47aa72ae00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4aeeeb64e215f11ffda30586f75bad9 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。\n今回も私のOCを描いてほしいんだけど、下にビキニを着た透け透けのサマードレスを着ているんだ。https://www.deviantart.com/stash/2udp515pomu、ビキニはhttps://www.deviantart.com/stash/0ewrttdf4py、色はピンク。できれば、ドレスを着ているバージョンと着ていないバージョンも欲しいです。\nありがとうございました。\n\nhttps://www.deviantart.com/stash/2syiqctj58a", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/313", "thumbnail_src": "https://si.imgix.net/f6584ef5/uploads/origins/cef8eeed-54fc-4644-84a6-33e9ad71cbd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2613326e10e682ddf011dff707f5a735", "thumbnail_srcset": "https://si.imgix.net/f6584ef5/uploads/origins/cef8eeed-54fc-4644-84a6-33e9ad71cbd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2613326e10e682ddf011dff707f5a735, https://si.imgix.net/f6584ef5/uploads/origins/cef8eeed-54fc-4644-84a6-33e9ad71cbd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=722da6598c6c789c8b2328758c03a0b6 2x, https://si.imgix.net/f6584ef5/uploads/origins/cef8eeed-54fc-4644-84a6-33e9ad71cbd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=239fe40710210a07ddfc66f336d6cbab 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます\nまたリクエストさせてください\n\nキャラクター\n参考資料の漫画に登場する少女\n\n衣装\n･作中で着用している制服。ただし黒色のニーソックスはひざ下丈の紺色のハイソックスに変更する\n･飾りのない白いフルバックのパンツ(クロッチは省略しないでください)\n\nシチュエーション等\nいわゆるMtUウィルスのイラストをお願いします\n･立ち絵の表情は両目を開け口を閉じた照れた感じの微笑み顔で、ハイソックスを履いているのがわかるようにひざ下かふくらはぎあたりまで描く\n･背景のパンツはお尻側から見たもの\n･差分として\n　･パンツがお尻に食い込んでいるもの\n　･白地に水色の星柄の入ったパンツを着用したもの\n　･お尻の穴に入れられたバイブでパンツが膨らんでいるもの(こちらはもしも描くことに問題があれば無視してください)\nを作っていただきたいです\n･psd形式での納品を希望します\n\nhttps://book.dmm.co.jp/detail/b121ahita00415/", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/312", "thumbnail_src": "https://si.imgix.net/9b166aab/uploads/origins/bcec302e-1d40-4e7d-a4c5-fa9501454572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da38e1b4651e19bcdb0a52ba60badc77", "thumbnail_srcset": "https://si.imgix.net/9b166aab/uploads/origins/bcec302e-1d40-4e7d-a4c5-fa9501454572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da38e1b4651e19bcdb0a52ba60badc77, https://si.imgix.net/9b166aab/uploads/origins/bcec302e-1d40-4e7d-a4c5-fa9501454572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c59aaf7a64a980553d69e75fa8446804 2x, https://si.imgix.net/9b166aab/uploads/origins/bcec302e-1d40-4e7d-a4c5-fa9501454572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be5e0657f55fa32a635ade4ccb19d905 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/311", "thumbnail_src": "https://si.imgix.net/f4bf55c3/uploads/origins/b77d8ff9-455d-46f3-a2e6-431441564abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88382cb1989234d30ae573260bc4b2b9", "thumbnail_srcset": "https://si.imgix.net/f4bf55c3/uploads/origins/b77d8ff9-455d-46f3-a2e6-431441564abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88382cb1989234d30ae573260bc4b2b9, https://si.imgix.net/f4bf55c3/uploads/origins/b77d8ff9-455d-46f3-a2e6-431441564abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a364ab212a0dd7f57ac4e98b05975138 2x, https://si.imgix.net/f4bf55c3/uploads/origins/b77d8ff9-455d-46f3-a2e6-431441564abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b14804525f88e5b20d0bb3f7f16d6dd 3x", "genre": "art", "nsfw": false, "body": "リクエスト再開聞いて伺いました。\n今期もよろしくお願いします\n\n今回は【クリエイティブＲＰＧ　蒼空のフロンティア】より自PC『カナンの天馬騎兵』フェイミィ・オルトリンデをお願いします\n\nhttps://drive.google.com/file/d/1Q159zvKWw1Yb9NmjyUBkatZ5TYEaYFaE/view?usp=drive_link\n\n容姿イメージは資料URLをご参照ください。\n設定は以下のような感じです\n\n悪の王に征服された砂塵の国『カナン』から落ち延びた亡国の騎士で、\n国を無くした戦いで心身に深い傷を負い、メインPCのリネンに助けられ彼女を追うためのパートナーとなる。\n（以前にお願いしたフリューネとは遠縁の関係で、リネンとしては先にカナンへと冒険に出たフリューネに近づこうとする打算・見せつけもあっての選択）\nリネンとは戦友のようであり喪失・不満を慰めあう爛れた関係\n\n以前にお願いしたフリューネやユーフォリアと同じような立ち絵で、今回は基本絵でお願いします。\n表情はお任せ、コスチュームはフル装備、鎧無しのどちらでもOKです\n\nhttps://drive.google.com/file/d/1Q159zvKWw1Yb9NmjyUBkatZ5TYEaYFaE/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@hihiirokane_m/works/310", "thumbnail_src": "https://si.imgix.net/fd783618/uploads/origins/c0ac6bbd-119c-4796-86ca-20ef40a77f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d2a976cacff9e89b5cae33605ceb1e", "thumbnail_srcset": "https://si.imgix.net/fd783618/uploads/origins/c0ac6bbd-119c-4796-86ca-20ef40a77f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d2a976cacff9e89b5cae33605ceb1e, https://si.imgix.net/fd783618/uploads/origins/c0ac6bbd-119c-4796-86ca