.com/drive/folders/1GzAfHLWsos6D47uJPWLEy8ueHRK1qjUz?usp=sharing\n\n衣装は資料内の私服姿で胸は強調するようにお願いします。\nデートのシチュエーションで、こちらに向かって「あ～ん♡」としてくるような場面をお願いします。\n背景はお任せしたいと思います。\n\n縦向きのイラストでお願いします。\n\nそれではご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Herohero_illust/works/171", "thumbnail_src": "https://si.imgix.net/ae3da4e9/uploads/origins/40fe47fc-1c71-4dd0-af3c-40f3e6f79020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44d9617f6358fb570a83aa507e5e0713", "thumbnail_srcset": "https://si.imgix.net/ae3da4e9/uploads/origins/40fe47fc-1c71-4dd0-af3c-40f3e6f79020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44d9617f6358fb570a83aa507e5e0713, https://si.imgix.net/ae3da4e9/uploads/origins/40fe47fc-1c71-4dd0-af3c-40f3e6f79020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cccf2773f62f30a84804b8fb7b4e0a6 2x, https://si.imgix.net/ae3da4e9/uploads/origins/40fe47fc-1c71-4dd0-af3c-40f3e6f79020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ce286247ea9da02f1add68eacd9a343 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Herohero_illust/works/170", "thumbnail_src": "https://si.imgix.net/6bb54088/uploads/origins/3407ae2a-8b66-4f36-9881-3453bf8d42ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e444074215ef9710cd8f9eaca25dd88b", "thumbnail_srcset": "https://si.imgix.net/6bb54088/uploads/origins/3407ae2a-8b66-4f36-9881-3453bf8d42