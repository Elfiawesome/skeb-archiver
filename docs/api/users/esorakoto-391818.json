r&txtsize=30&txt=PRIVATE&s=276c08964cb2bc6e66517a2ff9d80dbb 2x, https://si.imgix.net/fd261158/uploads/origins/2d2a0d43-cdb5-448c-81b6-828be2b536f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=879e3d1c9a5e65c9d6a65cfb30073c94 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/49", "thumbnail_src": "https://si.imgix.net/e35ca0a7/uploads/origins/7162d856-3dfc-4203-bf23-97e295cc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9eb88a69b770f48035b2a6e8789dd1ce", "thumbnail_srcset": "https://si.imgix.net/e35ca0a7/uploads/origins/7162d856-3dfc-4203-bf23-97e295cc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9eb88a69b770f48035b2a6e8789dd1ce, https://si.imgix.net/e35ca0a7/uploads/origins/7162d856-3dfc-4203-bf23-97e295cc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92bbf5abf4578b6afa422294dc14d2d 2x, https://si.imgix.net/e35ca0a7/uploads/origins/7162d856-3dfc-4203-bf23-97e295cc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0454aa9c5ac3f5dfe6e64d11508a6230 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/48", "thumbnail_src": "https://si.imgix.net/0a2e332e/uploads/origins/ee64da5c-c035-4fd9-91cf-ce66344df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff7cd5ae4f9d5f17938e4bc430fed09", "thumbnail_srcset": "https://si.imgix.net/0a2e332e/uploads/origins/ee64da5c-c035-4fd9-91cf-ce66344df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff7cd5ae4f9d5f17938e4bc430fed09, https://si.imgix.net/0a2e332e/uploads/origins/ee64da5c-c035-4fd9-91cf-ce66344df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af38b864b957632bf9844d70a47bae97 2x, https://si.imgix.net/0a2e332e/uploads/origins/ee64da5c-c035-4fd9-91cf-ce66344df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcd0d589eaebe6de160ec516c853c972 3x", "genre": "art", "nsfw": true, "body": "＜依頼概要＞\n女の子が裸で踊っているイラストを作成してください。\n＜キャラクター＞\nアイドルマスターシャイニーカラーズの小宮果穂\n＜シチュエーションなど＞\n・「オーディション中に、審査項目のひとつであるダンスを審査員に見せている」場面を描いてください。\n・果穂は何故か裸で踊ることになっているが、その異常さに気付いていない。\n・踊っているせいで、おっぱいがぷるぷると激しく揺れている。\n＜備考＞\n・おっぱいの揺れは、資料URLの貴方の作品と近い形で描いてください。\n・金額の範囲内で可能であれば、揺れるおっぱいのアップを複数カット描いていただけると嬉しいです。\n\nよろしくお願いします。\n\nhttps://skeb.jp/@esorakoto/works/20", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/47", "thumbnail_src": "https://si.imgix.net/b920a58a/uploads/origins/6e4a4ffc-4674-43d6-b193-a787ceb6caa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04c7c41efe27d3839c797552cbd4343", "thumbnail_srcset": "https://si.imgix.net/b920a58a/uploads/origins/6e4a4ffc-4674-43d6-b193-a787ceb6caa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04c7c41efe27d3839c797552cbd4343, https://si.imgix.net/b920a58a/uploads/origins/6e4a4ffc-4674-43d6-b193-a787ceb6caa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2ca6116103ef4ee6e2aacf505a6cb99 2x, https://si.imgix.net/b920a58a/uploads/origins/6e4a4ffc-4674-43d6-b193-a787ceb6caa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16222f44c8c70c3d034010c9573649b7 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回は「機動戦士ガンダムZZ」の「プルツー」ちゃんをお願いいたします。\n\n・戦闘訓練後の設定で、資料URLのスーツ着用＋汗だく\n・正面アングルでモブ男性（マスター）の膝に乗せられ、ほぼ全身が見える\n・背後からスーツ越しに胸やクリを揉みしだかれる\n・睨みつける表情で、ロリコン、変態等と強い口調で罵り、男の手を掴んで嫌がるポーズをしているが、抵抗するフリをした方がマスターに興奮してもらえるから演技しているだけで、内心では愛されて悦んで感じている（強化人間は精神が不安定なので、マスターに必要とされて求められることに喜びを感じて依存するように「調整」されている設定）\n\nhttps://photos.app.goo.gl/iVEHdfhfEGCfbPjx5", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/46", "thumbnail_src": "https://si.imgix.net/a9ab8efd/uploads/origins/2a20fe35-cf4c-4582-b9c2-01789a4d106f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9cf732b0beceebf6ad79a4f6e8b5dbf", "thumbnail_srcset": "https://si.imgix.net/a9ab8efd/uploads/origins/2a20fe35-cf4c-4582-b9c2-01789a4d106f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9cf732b0beceebf6ad79a4f6e8b5dbf, https://si.imgix.net/a9ab8efd/uploads/origins/2a20fe35-cf4c-4582-b9c2-01789a4d106f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a381714216c208cf6807e7280d674aba 2x, https://si.imgix.net/a9ab8efd/uploads/origins/2a20fe35-cf4c-4582-b9c2-01789a4d106f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e7d74317ab3225aa14c769ca85cd6e8 3x", "genre": "art", "nsfw": true, "body": "お世話になっております\n今回も「テイルズオブファンタジア」の「藤林すず」ちゃんで、前回より数ページ前のシチュをお願いします\n\n１．巨漢に鯖折りされる\n・横からのアングル\n・別コマで大ダメージに苦しむ表情アップ\n・勢いよく失禁\n２．片手で摘み上げられる\n・涙目で悶え苦しんで敗北\n・ズボンの内股がびっしょり地面まで滴るほどお漏らし\n・脱衣無し\n\nもしSkebでリョナはNGでしたら、代わりで前回の続きのシチュをお願いします\nA．中出しフィニッシュ＆快楽堕ちトロ顔絶頂\nB．地面にうつ伏せダウン\n・腕拘束＆重りは有り\n・別コマで絶頂の余韻に震える表情のアップ（涙＆涎あり）\n\nご検討よろしくお願い致します\n\nhttps://photos.app.goo.gl/yT8jUtC4vBTbrTcj7", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/45", "thumbnail_src": "https://si.imgix.net/955a70e6/uploads/origins/068b8e3c-775c-4c3a-98e0-bb6a0189ed6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b31b35ca89a1db300af8fe6f56ad947b", "thumbnail_srcset": "https://si.imgix.net/955a70e6/uploads/origins/068b8e3c-775c-4c3a-98e0-bb6a0189ed6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b31b35ca89a1db300af8fe6f56ad947b, https://si.imgix.net/955a70e6/uploads/origins/068b8e3c-775c-4c3a-98e0-bb6a0189ed6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab40f0b75cf855ee8389a8ecc3d1908b 2x, https://si.imgix.net/955a70e6/uploads/origins/068b8e3c-775c-4c3a-98e0-bb6a0189ed6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cc6db18d22c01bbadd5191f4dfb602b 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n「テイルズオブファンタジア」の「藤林すず」ちゃんでリクエストさせていただきたく、ご検討よろしくお願いいたします。\n\n下記ＵＲＬの春麗ちゃんのシチュが希望です。\nhttps://www.pixiv.net/artworks/7829084\n\n１．局部にぴったりチンコが当たっている＋涙目で怯えている表情\n２．支えを失い２ｔの重りで一気に挿入＋驚いたような表情で涙が流れている\n３．180度開脚で無防備なマンコを突き上げられている＋喘ぎまくっている表情\n\nすずちゃんの着衣は、上半身は胸が見えるように着崩れていて、下半身は膝より上の生地を大きく破られている感じだと嬉しいです。\n\nhttps://photos.app.goo.gl/yT8jUtC4vBTbrTcj7", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/44", "thumbnail_src": "https://si.imgix.net/7c7c4347/uploads/origins/101cb24a-8092-46b6-be06-d1dc0867e6bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feaa0af22c351940ffadc5c17e33c000", "thumbnail_srcset": "https://si.imgix.net/7c7c4347/uploads/origins/101cb24a-8092-46b6-be06-d1dc0867e6bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feaa0af22c351940ffadc5c17e33c000, https://si.imgix.net/7c7c4347/uploads/origins/101cb24a-8092-46b6-be06-d1dc0867e6bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fe504604adc96e1b8642af4873269db 2x, https://si.imgix.net/7c7c4347/uploads/origins/101cb24a-8092-46b6-be06-d1dc0867e6bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc49f49b50884d8c4c3d315a14acfb28 3x", "genre": "art", "nsfw": true, "body": "久びさに依頼に参りました\nキャラクター：イングリッド（ブリス後、プルンプルン揺れるほどのがっつりロリ巨乳）\nシチュ：もうこどもボディで犯されるのがくせになってきちゃったイングリッドで、エッチに抵抗もせず気持ちいいのじゃっ♡あっもうすぐ中出し来ちゃうのじゃあっ♡みたいな感じで喜んで受け入れちゃう\n体位など：体位は立ちバック、モブは太ってるよりは標準的または筋肉質な感じでお願いします。竿役モブ男性とイングリッドのサイズ差はこちらの依頼（https://skeb.jp/@esorakoto/works/36）のロイドとベッキーくらいで。視点も同じように横からでお願いします。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/43", "thumbnail_src": "https://si.imgix.net/d252c72b/uploads/origins/5f7e3eb7-da5c-454d-9186-a3b498bf54da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a253a1924b6b4467616a7579d222d49", "thumbnail_srcset": "https://si.imgix.net/d252c72b/uploads/origins/5f7e3eb7-da5c-454d-9186-a3b498bf54da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a253a1924b6b4467616a7579d222d49, https://si.imgix.net/d252c72b/uploads/origins/5f7e3eb7-da5c-454d-9186-a3b498bf54da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a4722a87d103cae035ac3d2cdfb5a8c 2x, https://si.imgix.net/d252c72b/uploads/origins/5f7e3eb7-da5c-454d-9186-a3b498bf54da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=988fb34dd63b6e6bfbd309142abb45b4 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nミニマムの魔法でロリ化した「ファイナルファンタジー７」の「ユフィ・キサラギ」ちゃんが、触手に拘束されながら2穴責めされて中出しされまくりイカされまくりで、全身にぶっかけられまくりで快楽堕ちしているイラストをリクエストさせていただきたく、ご検討よろしくお願いいたします。\n\n着衣はオリジナルのＦＦ７のもので、下記は着けたままでお願いしたいです。\n・頭の鉢がね\n・左足の網タイツ\n・ルーズソックス\n・右腕のグローブ等の防具\n左腕の防具は無しでお願いいたします。（左肩の防具やそれを支えるベルトの有無はお任せします。その他の着衣についても有無はお任せいたします。）", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/42", "thumbnail_src": "https://si.imgix.net/40730661/uploads/origins/0752e3fe-663a-4020-9460-fec282f9614d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32818fbac27d1a4ae5e0a95c50da860a", "thumbnail_srcset": "https://si.imgix.net/40730661/uploads/origins/0752e3fe-663a-4020-9460-fec282f9614d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32818fbac27d1a4ae5e0a95c50da860a, https://si.imgix.net/40730661/uploads/origins/0752e3fe-663a-4020-9460-fec282f9614d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f96c0cfe799435dccd2a67aeb282475 2x, https://si.imgix.net/40730661/uploads/origins/0752e3fe-663a-4020-9460-fec282f9614d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96c8e9119a469e3667cf597370593bda 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nミニマムの魔法でロリ化した「ファイナルファンタジー７」の「ユフィ・キサラギ」ちゃんが、触手に愛撫されてぐったり動けなくなるまでイカされまくってしまった事後のイラストをリクエストさせていただきたく、ご検討よろしくお願いいたします。\n\n髪や顔、全身が白濁液まみれで、絶頂の余韻が抜けきらず気持ちよさそう＆疲労してそうな表情でお願いいたします。\n着衣はオリジナルのＦＦ７のもので下記は残していただきたいです\n・頭の鉢がね\n・左足の網タイツ\n・ルーズソックス\n・右腕のグローブ等の防具\n逆に、左腕の防具は無しでお願いいたします。（左肩の防具やそれを支えるベルトはお任せします）", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/41", "thumbnail_src": "https://si.imgix.net/4195955c/uploads/origins/3e96bac3-d27e-47fb-86ee-c8f01bc615a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8c1b5b06e1bb4f32a44d7ca4111370", "thumbnail_srcset": "https://si.imgix.net/4195955c/uploads/origins/3e96bac3-d27e-47fb-86ee-c8f01bc615a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8c1b5b06e1bb4f32a44d7ca4111370, https://si.imgix.net/4195955c/uploads/origins/3e96bac3-d27e-47fb-86ee-c8f01bc615a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1ed05261768932826499336b54a7184 2x, https://si.imgix.net/4195955c/uploads/origins/3e96bac3-d27e-47fb-86ee-c8f01bc615a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0ad6302aeb1f5f4ee6b1216b0fb89ea 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nミニマムの魔法でロリ化した「ファイナルファンタジー７（Final FantasyⅦ）」の「ユフィ・キサラギ」ちゃんが、触手に愛撫されてイカされまくっているイラストをリクエストさせていただきたく、ご検討よろしくお願いいたします。\n\n触手に拘束されながら、胸やクリ等のいろんな性感帯を責められて喘ぎ声が止まらないような感じでお願いいたします。挿入は無しでお願いいたします。\n服装はオリジナルのＦＦ７のもので緑の縦セーターのような上着はずり上げられて胸が見えており、ホットパンツはずり降ろされていたり片足に引っかかっている、ルーズソックス・網タイツは履いたままが希望です。", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/40", "thumbnail_src": "https://si.imgix.net/30b44819/uploads/origins/1ec9593f-e15f-42c6-8402-6d38118c04a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec4658d74e5aa2dedc6656af6cff876", "thumbnail_srcset": "https://si.imgix.net/30b44819/uploads/origins/1ec9593f-e15f-42c6-8402-6d38118c04a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec4658d74e5aa2dedc6656af6cff876, https://si.imgix.net/30b44819/uploads/origins/1ec9593f-e15f-42c6-8402-6d38118c04a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dcfb9f1264c9abaa4c756114ce9cec1 2x, https://si.imgix.net/30b44819/uploads/origins/1ec9593f-e15f-42c6-8402-6d38118c04a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6ac624766a75287d161424d8417e3a8 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n期限切れになってしまったので再送させていただきます。\n「ファイナルファンタジー７（Final FantasyⅦ）」の「ユフィ・キサラギ」ちゃんをお願いいたします。\n\nユフィちゃんが触手に拘束されて、服越しor服の中に入ろうとしている触手にエッチに触られているor触られそうになっているピンチなシチュでお願いいたします。\n以前お描きになっている同人誌であったと思うのですが、ユフィちゃんはミニマムの魔法を受けていい感じにロリ化しているようにお願いいたします。服装もFF7本編のものでお願いいたします。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/39", "thumbnail_src": "https://si.imgix.net/b37c9069/uploads/origins/630a44a3-5a42-4e50-b601-c3cd280da619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffdb473474181fd33dc5c765deee9402", "thumbnail_srcset": "https://si.imgix.net/b37c9069/uploads/origins/630a44a3-5a42-4e50-b601-c3cd280da619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffdb473474181fd33dc5c765deee9402, https://si.imgix.net/b37c9069/uploads/origins/630a44a3-5a42-4e50-b601-c3cd280da619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b5ff1b32f50dd72f4b9635bd9f0d992 2x, https://si.imgix.net/b37c9069/uploads/origins/630a44a3-5a42-4e50-b601-c3cd280da619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=027af69c2da7bc3598d75fecf6471681 3x", "genre": "art", "nsfw": true, "body": "先生初めまして。\n宜しければ、陰の実力者になりたくて！　のイプシロンを描いて頂きたいです。\n\nイプシロン\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQOfu1isBMZn0cIeucbU1cXwBOEgzFo1Pd9zw&usqp=CAU\n\n\n対面座位でロリパイを捏ねて乳首を舐め啜る構図で、おまかせになりますが台詞か矢印で体の具合、名器さを入れて頂きたいです（数の子天井、締め付け、うねり等）\n先生のお餅みたいに伸びるロリおっぱいが大好きです。\n\nいつも応援しております。御一考頂けたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/38", "thumbnail_src": "https://si.imgix.net/45345548/uploads/origins/9e9cd2df-ffd6-4e2b-93a6-a91c45b55202?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad73cc989894d2df64b7de971868e60b", "thumbnail_srcset": "https://si.imgix.net/45345548/uploads/origins/9e9cd2df-ffd6-4e2b-93a6-a91c45b55202?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad73cc989894d2df64b7de971868e60b, https://si.imgix.net/45345548/uploads/origins/9e9cd2df-ffd6-4e2b-93a6-a91c45b55202?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07f56b6c77f730a3893d0e77f89a94ac 2x, https://si.imgix.net/45345548/uploads/origins/9e9cd2df-ffd6-4e2b-93a6-a91c45b55202?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae5e76a27758ab269afd41e0f2c4d645 3x", "genre": "art", "nsfw": true, "body": "はじめまして。是非オリキャラで差分イラストをリクエストさせてください。\n\n■キャラクター\nオリキャラ「小柳津　瑞樹」\nhttps://onl.sc/Ut5Pyi8\n\n■リクエストしたいシチュ\n触手に囲まれて粘液まみれにされお腹いっぱいになるもの\n\n■リクエストしたい内容\n①触手に大量の白濁液でぐちゃぐちゃとシャンプーされて嫌がる\n②口に触手が挿入されて、白濁液を大量に飲まされる\n②時間が経って、大量の白濁液にまみれてボテ腹になり快楽を感じながらゴクゴク飲み続けている\n\n■備考\n是非、セリフ付きでお願いします。最初は嫌がりつつ、最後は口を犯されて気持ちよくなっている流れだと嬉しいです。\n\nhttps://note.com/minarai_report/n/n8209a75f7934", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/37", "thumbnail_src": "https://si.imgix.net/d0aebe7f/uploads/origins/60f6f877-365e-4c51-ad6b-4aa55b558a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f87a64e3340c3b54688a76fa5e9339", "thumbnail_srcset": "https://si.imgix.net/d0aebe7f/uploads/origins/60f6f877-365e-4c51-ad6b-4aa55b558a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f87a64e3340c3b54688a76fa5e9339, https://si.imgix.net/d0aebe7f/uploads/origins/60f6f877-365e-4c51-ad6b-4aa55b558a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce5f7a647a8ac6e97391407aecaccbaf 2x, https://si.imgix.net/d0aebe7f/uploads/origins/60f6f877-365e-4c51-ad6b-4aa55b558a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7fdb95de59ca57b6dc285cbecb68a3e 3x", "genre": "art", "nsfw": true, "body": "絵空コト先生こんにちは、前のベッキーとロイドの作品本当にありがとう、今回は続きシーンをお願いします！\n\nこの構図をお願いします: https://skeb.jp/@esorakoto/works/16\n\n・二人は全裸\n・激しディープキス\n・お腹の膨らみ感\n・ロイドはベッキーのピンク乳首をつねる\n\nベッキーのセリフはセックス中毒ないやらしいメスガキ感じ、ロイドは紳士的な口調を保っていたが、ベッキーの性欲の強さには少し怖かった。\n\n可能であれば射精前後の差分をお願いします。\n\n長くなりましたが以上です。宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/36", "thumbnail_src": "https://si.imgix.net/08e91fb1/uploads/origins/35f6bc80-c95e-465e-8237-49806b11ac1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b2803dde21b04559faaa8dc5dc59b1d", "thumbnail_srcset": "https://si.imgix.net/08e91fb1/uploads/origins/35f6bc80-c95e-465e-8237-49806b11ac1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b2803dde21b04559faaa8dc5dc59b1d, https://si.imgix.net/08e91fb1/uploads/origins/35f6bc80-c95e-465e-8237-49806b11ac1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b998061c42ab1a2ada2f44c19e10c3b2 2x, https://si.imgix.net/08e91fb1/uploads/origins/35f6bc80-c95e-465e-8237-49806b11ac1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac840d6ffb1da367ebdc3b6d094e9c07 3x", "genre": "art", "nsfw": true, "body": "先生こんにちは、よければ今回はspyXfamilyのベッキーとロイドのイラストをお願いします。任務を遂行するため、ロイドは家庭教師としてベッキーの邸宅に入った。ロイドはベッキーに盗聴器をこっそり隠すように命令し、ベッキーはロイドに夢中だったので従った。\n全身を抱きしめてバックセックスシーンをお願いします\nセリフはお好みでご自由に(ベッキーは生意気メスガキぽい、ロイドは紳士な感覚)\n\nベッキーは8歳ぐらいの幼女、ロイドは20cm以上な巨根の持ち主。お腹の膨らみ感をお願いします。\n\n長くなりましたが以上です。宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/35", "thumbnail_src": "https://si.imgix.net/fb42a1bc/uploads/origins/f5cc3e88-f7c3-482a-81f5-dd6a92a5198a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0e55b732362edcf26e644fda2ba80e6", "thumbnail_srcset": "https://si.imgix.net/fb42a1bc/uploads/origins/f5cc3e88-f7c3-482a-81f5-dd6a92a5198a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0e55b732362edcf26e644fda2ba80e6, https://si.imgix.net/fb42a1bc/uploads/origins/f5cc3e88-f7c3-482a-81f5-dd6a92a5198a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71384a7c8b146d8731c522ec481a56a9 2x, https://si.imgix.net/fb42a1bc/uploads/origins/f5cc3e88-f7c3-482a-81f5-dd6a92a5198a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=969e61650f7dcd3888802abdb3d3d35b 3x", "genre": "art", "nsfw": true, "body": "はじめまして、素晴らしい触手責めのイラストに惹かれ依頼させていただきます。\nスーパーロボット大戦OGシリーズの「ラトゥーニ・スゥボータ」が触手責めを受けているイラストをお願いします。\n\n眼鏡着用の制服がはだけての乳首、ストッキングを破られて秘所に触手責めを受けているような感じで。（面倒であれば全裸でも構いません）\n表情はなんとか触手責めに耐えようとするも快感には抗えず、赤面しながら感じている様子で。\n触手は同作品の敵キャラのこちらの様な感じで（https://www.youtube.com/watch?v=KfDIMCl9fG8）お願いします。\n\nよろしければご検討のほどよろしくお願いします。\n\nhttps://skeb.jp/@rilelile/works/19", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/34", "thumbnail_src": "https://si.imgix.net/077e0bcb/uploads/origins/334554b3-dfb7-4014-84ed-2e577d22378e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa4722485adbde17d2fbefd953b928c8", "thumbnail_srcset": "https://si.imgix.net/077e0bcb/uploads/origins/334554b3-dfb7-4014-84ed-2e577d22378e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa4722485adbde17d2fbefd953b928c8, https://si.imgix.net/077e0bcb/uploads/origins/334554b3-dfb7-4014-84ed-2e577d22378e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32797e91182166567f11e2df7132b89c 2x, https://si.imgix.net/077e0bcb/uploads/origins/334554b3-dfb7-4014-84ed-2e577d22378e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf5037c0014334c1b78af9f867fe5f4 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n「テイルズオブシンフォニア」の「プレセア・コンバティール」ちゃんのイラストをお願いいたします。\n\n触手の巣にお持ち帰りされて、2穴挿入されて中に出されまくり、ぶっかけられまくりで快楽堕ちしているシチュでお願いいたします。指ぬきグローブ、ブーツ、胸元のアクセサリは着けたままでお願いいたします。スパッツは履いたままで、破かれて前後に挿入されており、ボロボロになっていると嬉しいです。\n\n私からのリクエストは、似たようなシチュで何回も依頼させていただいているので構図被りがあっても大丈夫です。\nご検討よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/Vx1Y6zFN6Rs2wVYc9", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/33", "thumbnail_src": "https://si.imgix.net/2bdb5e37/uploads/origins/e033ed2e-087d-47da-863e-d29fd1226777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62774e31db69a1be4dfb423095765dcc", "thumbnail_srcset": "https://si.imgix.net/2bdb5e37/uploads/origins/e033ed2e-087d-47da-863e-d29fd1226777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62774e31db69a1be4dfb423095765dcc, https://si.imgix.net/2bdb5e37/uploads/origins/e033ed2e-087d-47da-863e-d29fd1226777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd5d4a6382e8a0891bb636d410e15e20 2x, https://si.imgix.net/2bdb5e37/uploads/origins/e033ed2e-087d-47da-863e-d29fd1226777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d93be01ed1f3b8886750ee3ea4c947a4 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n「テイルズオブシンフォニア」の「プレセア・コンバティール」ちゃんのイラストをお願いいたします。\n\n触手の愛撫で何度も絶頂してしまい、白濁液まみれでぐったりしているシチュでお願いいたします。挿入はまだ無しでお願いいたします。指ぬきグローブ、ブーツ、胸元のアクセサリは着けたままでお願いいたします。スパッツも履いたままで少し破れているようにお願いしたいです。\n\nご検討よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/Vx1Y6zFN6Rs2wVYc9", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/32", "thumbnail_src": "https://si.imgix.net/f16f412b/uploads/origins/362d35a4-c123-40ac-935c-d42107708b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c03e57ef35cb7bf074e45fb4e8b71e96", "thumbnail_srcset": "https://si.imgix.net/f16f412b/uploads/origins/362d35a4-c123-40ac-935c-d42107708b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c03e57ef35cb7bf074e45fb4e8b71e96, https://si.imgix.net/f16f412b/uploads/origins/362d35a4-c123-40ac-935c-d42107708b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=808408d9eb8127ea8897a865827466a1 2x, https://si.imgix.net/f16f412b/uploads/origins/362d35a4-c123-40ac-935c-d42107708b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f18266e1b45998167d301da3534165c 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n「テイルズオブシンフォニア」の「プレセア・コンバティール」ちゃんのイラストをお願いいたします。\n\nベルトを外され上着を半脱ぎにされて、ちっぱいが見えちゃっているプレセアちゃんが、触手に全身のいろんな性感帯を責められて喘いじゃっているシチュでお願いいたします。スパッツは履いたまま、スパッツ越しに責められていて欲しく、指ぬきグローブ、ブーツ、首元のアクセサリは最後まで着けたままでお願いいたします。\n\nご検討よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/Vx1Y6zFN6Rs2wVYc9", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/31", "thumbnail_src": "https://si.imgix.net/5a04dafd/uploads/origins/5e07789f-2d33-4a41-8a0d-d79039fa89e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ed75d5fc323d7a61435a6df2b5e51a", "thumbnail_srcset": "https://si.imgix.net/5a04dafd/uploads/origins/5e07789f-2d33-4a41-8a0d-d79039fa89e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ed75d5fc323d7a61435a6df2b5e51a, https://si.imgix.net/5a04dafd/uploads/origins/5e07789f-2d33-4a41-8a0d-d79039fa89e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42eec1186b8a9d754191b247890b1527 2x, https://si.imgix.net/5a04dafd/uploads/origins/5e07789f-2d33-4a41-8a0d-d79039fa89e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070527c4fd171341f7c663b520e04c03 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n今回も手数料無料期間ということで、「テイルズオブシンフォニア」の「プレセア・コンバティール」ちゃんのイラストをお願いいたします。\n\n触手に拘束され、エッチに触られて恥ずかしがったりピンチで焦っているような感じのシチュでお願いいたします。脱衣は無しでお願いいたします。\n\n前回と同様に、全部で4枚ぶんリクエストさせていただきたいのですが、トラブル等ですべて納品が難しい場合でも手数料無料キャンペーンが少しでも使えるように、１件ずつ分けて依頼させていただきます。また、似たようなシチュで何度も依頼させていただいているので構図被りがあっても大丈夫です。\nご検討よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/Vx1Y6zFN6Rs2wVYc9", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/30", "thumbnail_src": "https://si.imgix.net/defe4c78/uploads/origins/1ee760cf-b255-45bc-8656-d5477583b902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918504f19929d57d86bd0488184f8874", "thumbnail_srcset": "https://si.imgix.net/defe4c78/uploads/origins/1ee760cf-b255-45bc-8656-d5477583b902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918504f19929d57d86bd0488184f8874, https://si.imgix.net/defe4c78/uploads/origins/1ee760cf-b255-45bc-8656-d5477583b902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d69d3622f53eb89c55b79e92a34368c 2x, https://si.imgix.net/defe4c78/uploads/origins/1ee760cf-b255-45bc-8656-d5477583b902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e97eb204bc872213cf74ac5fde9fa7e0 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n今回も舞ちゃんで依頼致します。\n\n・資料のような構図・体位で校長と汗だくセックス。舞ちゃんは頭から足まで全体が見えるように。\n\n・前回の事後イラスト後、校長のことは好きではないが校長とのセックスは文句を言いながらも満更でもないといった感じで。\n　校長は舞ちゃんを呼び捨て敬語無しで。\n　セリフも付けてください。\n\n・イラスト隅に挿入断面図（別レイヤーで表示有無）\n\n・差分もお願いします。\n　中出し、事後、各シーンの表情\n　舞ちゃんは舌出しアクメ顔になり、校長の指を口の中に入れてください。\n\n・消しは海苔\n・カラー絵\n\n要望が多くて恐縮ですが、ご検討の程よろしくお願い致します。\n\nhttps://skeb.jp/@ahashi_tk/works/90", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/29", "thumbnail_src": "https://si.imgix.net/edfa6dbb/uploads/origins/8d5de499-0c63-47aa-bf95-309959646045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06f2454ef7c1c5e76432022f5dd3633c", "thumbnail_srcset": "https://si.imgix.net/edfa6dbb/uploads/origins/8d5de499-0c63-47aa-bf95-309959646045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06f2454ef7c1c5e76432022f5dd3633c, https://si.imgix.net/edfa6dbb/uploads/origins/8d5de499-0c63-47aa-bf95-309959646045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=497a1654cd81c7ce1d17c347482ddc3b 2x, https://si.imgix.net/edfa6dbb/uploads/origins/8d5de499-0c63-47aa-bf95-309959646045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68df35314ae48f07a4fb4bae9f2d8fc4 3x", "genre": "art", "nsfw": true, "body": "お世話になっております\n今回は「ドラゴンクエスト５」の「タバサ」ちゃん（グランバニア王女）をリクエストさせていただきたく、ご検討よろしくお願いいたします\n以前のように、\n１．触手に拘束＆服越しに愛撫\n２．服が破られて性感帯を直接責められてイキまくっている（挿入無し）\n３．白濁液まみれでぐったり\n４．巣にお持ち帰りされて2穴責めで中に出されまくり、体中ぶっかけられまくりで快楽堕ち\nという流れで複数イラストが希望です。\n\n手袋、靴、マント、ベルトは残ったまま、ベルトに挟まった布の切れ端がちょっと残って見えるのが希望です。\n一度の作業量が多いようでしたら、キャンセルいただけたら半分に分けて再送します\n\nhttps://photos.app.goo.gl/264a3axxDETX5MUJ6", "created_at": "", "completed_at": ""}, {"path": "/@esorakoto/works/28", "thumbnail_src": "https://si.imgix.net/f95a9320/uploads/origins/dc154487-9328-4893-a9d5-3d80b84762f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94bdb6f2c3776ee5520a2337e03d22aa", "thumbnail_srcset": "https://si.imgix.net/f95a9320/uploads/origins/dc154487-9328-4893-a9d5-3d80b84762f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94bdb6f2c3776ee5520a2337e03d22aa, https://si.imgix.net/f95a9320/uploads/origins/dc154487-9328-4893-a9d5-3d80b84762f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3c851957173263578889e16565a9b25 2x, https://si.imgix.net/f95a9320/uploads/origins/dc154487-9328-4893-a9d5-3d80b84762f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a09cea5c550311bf07a7051cf4163057 3x", "genre": "art", "nsfw": true, "body": "ご無沙汰しております\n「悪魔城ドラキュラ黙示録」の「キャリー・ヴェルナンデス」ちゃん（１２）の触手エッチイラストを４点お願いできますでしょうか？\n\n衣装は資料１のデフォルト衣装でお願いいたします\nＢ～Ｄは資料２のような着衣の残し方が希望です\n\nＡ．触手に拘束＆服越しに軽く愛撫されているピンチ状態\nＢ．全身の性感帯をいじられてイキまくっている（挿入無し）\nＣ．白濁液まみれでぐったり\nＤ．触手の巣にお持ち帰りされて、２穴責めで快楽堕ちしている＋黒タイツがさらに破れて残骸が足にまとわりついている状態\n\n以前お願いしたすずちゃんやリディアちゃんのような感じが希望です\nご検討よろしくお願いいたします\n\nh