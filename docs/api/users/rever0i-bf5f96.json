a0d2629b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d28535fa85d2274b20f769cac1994f", "thumbnail_srcset": "https://si.imgix.net/28ceab2c/uploads/origins/e29b2b92-1678-4ee4-bcf8-bb64a0d2629b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d28535fa85d2274b20f769cac1994f, https://si.imgix.net/28ceab2c/uploads/origins/e29b2b92-1678-4ee4-bcf8-bb64a0d2629b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af6feb4f3722a32d20eea7da41e1d678 2x, https://si.imgix.net/28ceab2c/uploads/origins/e29b2b92-1678-4ee4-bcf8-bb64a0d2629b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4196485b213bc6ed087b5db871b213c 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています！\nエマさんが描かれるシュッとした目元の男性キャラが大好きなので宜しければ1枚リクエストをさせてください。\n\n刀剣乱舞より五月雨江と女審神者を描いてはいただけないでしょうか？\n2人の容姿については資料URLをご覧ください。\n\n【キャラ詳細】\n五月雨：好奇心旺盛で少しおちゃめな性格だが、薄く微笑む程度しか表情筋が動かないタイプ。目に感情が出やすい。仕事中の審神者に放置されてはよく拗ねる。\n審神者：明るい性格でよく笑うタイプ。自分の本丸の刀剣男士が可愛くて仕方がないけれど内番衣装の五月雨があまりにも好きで直視できない。\n\n【衣装等指定】\n五月雨：内番衣装\n審神者：淡い紫の着物\n\n構図：少し拗ねた表情の五月雨に迫られる審神者。甘めの雰囲気だととっっっても嬉しいです。\n上記指定以外は全てお任せ致します。\n\n可能であれば宛名はイラストとは別レイヤーにし、表示のオンオフが出来るようにしていただけると嬉しいです。\nニトロプラスの二次創作ガイドライン範囲内かとは思いますが、不安であればキャンセルでお願い致します。\nhttps://www.nitroplus.co.jp/license/faq_touken\n\nhttps://drive.google.com/drive/folders/11u5DfD8-mzBoHzZWJoBf2WKqJUbqsHC4?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@rever0i/works/3", "thumbnail_src": "https://si.imgix.net/efa0e213/uploads/origins/3880b23e-62d2-4a80-acf7-027dd819bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7997b4c1e2819357333c648b5d4bbf1e", "thumbnail_srcset": "https://si.imgix.net/efa0e213/uploads/origins/3880b23e-62d2-4a80-acf7-027dd819bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7997b4c1e2819357333c648b5d4bbf1e, https://si.imgix.net/efa0e213/uploads/origins/3880b23e-62d2-4a80-acf7-027dd819bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6596ea69705c069df1232052ce28b35f 2x, https://si.imgix.net/efa0e213/uploads/origins/3880b23e-62d2-4a80-acf7-027dd819bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8613b4aa9b5a30b051a7b360b4f0614 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートワークとスタイルが本当に大好きです。FFXIVの男性キャラクターを2人描いていただけないでしょうか。二人は最高のパートナーであり、仲間として接しています。衣装は参考画像のままでお願いできますか？(武器は省略可)。表情・ポーズは自由です。個人SNSのアバターとして使用させていただきます。ありがとうございました。\n\n参考画像：https://drive.google.com/drive/folders/1LzjhCP-p0k5DSoIHsImFZzvsu5SrXD3L\n\nhttps://drive.google.com/drive/folders/1LzjhCP-p0k5DSoIHsImFZzvsu5SrXD3L", "created_at": "", "completed_at": ""}, {"path": "/@rever0i/works/2", "thumbnail_src": "https://si.imgix.net/13bd2418/uploads/origins/6219fbac-ae93-460a-bece-232795df36a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe5449982c2c63620e8cff94c3b2b0db", "thumbnail_srcset": "https://si.imgix.net/13bd2418/uploads/origins/6219fbac-ae93-460a-bece-232795df36a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe5449982c2c63620e8cff94c3b2b0db, https://si.imgix.net/13bd2418/uploads/origins/6219fbac-ae93-460a-bece-232795df36a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bcde4be7f166f4b95a831623b7e4a8e 2x, https://si.imgix.net/13bd2418/uploads/origins/6219fbac-ae93-460a-bece-232795df36a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25f235ef26382013f4564b5561fc69d7 3x", "genre": "art", "nsfw": false, "body": "初めまして、突然のリクエスト失礼します！個人でVTuber活動をしているティナ・ブラックタイガーと申します。\nエマ様のイラストをTwitter経由で知り、とても素敵なイラストを描いていらっしゃったので、ぜひご依頼させていただきたくリクエスト送らせてもらいました。\n\nYouTubeなどの配信のサムネイルやED用に使用できるイラストを描いていただきたいです。(差分で背景透過済みのものがあると嬉しいです)\n褐色で金髪金眼、ストリート系で、上着と帽子を被らせて欲しいです。また爪には黄色いネイルをしています。\n\n構図やポーズはお任せさせていただければなと思うのですが、カッコイイ感じだとうれしいです！\n\nまた、もし描いたイラストをTwitterで宣伝することがありましたら \n#黒虎戯画 とつけて頂けると大変助かります！\n\n資料画像にツイッターのURLを載せておりますので、ご参考にしていただければと思います。\nご検討の程よろし