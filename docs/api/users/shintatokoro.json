いです。\n雄獣人との関係は恋人同士でどちらもドスケベのアラサー同士\nということで意気投合した感じでお願いします。\n女体化獣人のほうは姉御肌な感じの口調でお願いします。\n相手の雄獣人のほうは犬太様にお任せしたいです。\n今回もマニアックな内容ですが問題なさそうでしたら承認よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fi/3w2162glgubu7zy4g92wa/.png?rlkey=wg45qjhg20pcumd57nx6mbx59&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@shintatokoro/works/13", "thumbnail_src": "https://si.imgix.net/1e5f78aa/uploads/origins/96ed06b7-711a-4bf6-9c05-798a04489074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd3a4ce393dd830ff703a61b3eee4d2d", "thumbnail_srcset": "https://si.imgix.net/1e5f78aa/uploads/origins/96ed06b7-711a-4bf6-9c05-798a04489074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd3a4ce393dd830ff703a61b3eee4d2d, https://si.imgix.net/1e5f78aa/uploads/origins/96ed06b7-711a-4bf6-9c05-798a04489074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fb296c46cd6eb4b09804c20421db1d6 2x, https://si.imgix.net/1e5f78aa/uploads/origins/96ed06b7-711a-4bf6-9c05-798a04489074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=849563f1863076cb79e490b352882adf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shintatokoro/works/12", "thumbnail_src": "https://si.imgix.net/4de4b36f/uploads/origins/5d897596-7eb4-48ac-a4ec-3bd6be270737?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6260183349a766ac7ac04649090b4fe", "thumbnail_srcset": "https://si.imgix.net/4de4b36f/uploads/orig