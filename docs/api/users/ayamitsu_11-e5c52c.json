2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9a15251781c65e93539be54a884c45, https://si.imgix.net/5978aeaf/uploads/origins/81cce503-b056-49eb-84ea-db40e0261523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=882f9604c1ef77ef39573a138b1167a6 2x, https://si.imgix.net/5978aeaf/uploads/origins/81cce503-b056-49eb-84ea-db40e0261523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb19b25eb7589c89fb52a9ccdd866964 3x", "genre": "art", "nsfw": false, "body": "こんにちは！鬼武羅です！！\nGuchico先生の新刊の表紙を見て、とても感動した。でもその後、ある考えが浮かんで、先生に依頼をします。\n\nカメラを持って前を向くGuchico先生の笑顔を描いてほしい。それはまるで、娘たちの写真を撮ったときの満足げな笑顔のようだ。\n同じように星空とオーロラを背景にしてほしい。\n\nよろしくお願いします!", "created_at": "", "completed_at": ""}, {"path": "/@ayamitsu_11/works/16", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9054d1689c719fd453ff069d73bbc774", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9054d1689c719fd453ff069d73bbc774, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31b43737af6f5b5519c7471a4e7f647f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4503fa7a182cc0696c6edcd93a3bb45f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは！鬼武羅です！！\n今回先生には2つのクリップを録音してもらいたい。\n\n一つは”お風呂にする ご飯にする それともあ、や、氏?\"\n\n二つは\"バカ！変態！うるさい！もう知らない！”\n\nこの2つの録音は、もちろん商業目的ではないが、いくつかの映画で使われるかもしれない。\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@ayamitsu_11/works/15", "thumbnail_src": "https://si.imgix.net/28754e4a/uploads/origins/3272e096-ea9c-49dc-a0ce-35f76c1627f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabc06a783d88c2fae28c12b9fce92cd", "thumbnail_srcset": "https://si.imgix.net/28754e4a/uploads/origins/3272e096-ea9c-49dc-a0ce-35f76c1627f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabc06a783d88c2fae28c12b9fce92cd, https://si.imgix.net/28754e4a/uploads/origins/3272e096-ea9c-49dc-a0ce-35f76c1627f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49cb4a2038a2db880f3e66ab5ffbab64 2x, https://si.imgix.net/28754e4a/uploads/origins/3272e096-ea9c-49dc-a0ce-35f76c1627f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcbd8ff421bfa12ded2572aba59e9d64 3x", "genre": "art", "nsfw": false, "body": "こんにちは！鬼武羅です！！\nジューン・ブライド！\nちょっと失礼かもしれないけれど，ウエディングドレス姿のGuchico先生を見たい！\n\n白いウエディングドレスで、少し恥ずかしそうな表情をでお願いします。あとはあや先生にお任せします。\nGuchico先生が関与しているので、2人の先生のどちらかが依頼に同意しない場合は、依頼を返却してください。\n私は他の依頼も検討する。\n\nよろしくお願いします!", "created_at": "", "completed_at": ""}, {"path": "/@ayamitsu_11/works/14", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9054d1689c719fd453ff069d73bbc774", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9054d1689c719fd453ff069d73bbc774, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31b43737af6f5b5519c7471a4e7f647f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907049393284628480%2FcMcyzO_X.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4503fa7a182cc0696c6edcd93a3bb45f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは！\n朱さんの声で起こしてもらいたい！いつものパパ蜂と蜂の子君へのモーニングコールで録画したいと思います\n。\nそうでない場合は、例もあります\n-------\n''おはよう～起きた？も、まだ寝てるのか。まだ寝ているなら、キスしてやるぞ！\n三、二、一。............まったく、そんなに私にキスされたくないの？さて、朝食の時間だ！今日は大好きなハンバーグステーキです！\"\n\n以上!\n音声はTwitterでも投稿可能です，fanpickも投稿可能です。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ayamitsu_11/works/13", "thumbnail_src": "https://si.imgix.net/2f95a675/uploads/origins/9104335a-7476-48a8-93f6-7469012c4da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ee918b6b5c360c8603a1b28bd415b3", "thumbnail_srcset": "https://si.imgix.net/2f95a675/uploads/origins/9104335a-7476-48a8-93f6-7469012c4da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ee918b6b5c360c8603a1b28bd415b3, https://si.imgix.net/2f95a675/uploads/origins/9104335a-7476-48a8-93f6-7469012c4da2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=013a827a537785922a0e5a69034ef6ac 2x, https://si.imgix.net/2f95a675/uploads/origins/9104335a-7476-48a8-93f6-7469012c4da2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51d56faf09e8bef29bfd6b10cc9f4f29 3x", "genre": "art", "nsfw": false, "body": "改めましてこんにちは、この度はご依頼をご検討いただきありがとうございます。\nこのイラストは、贈られた方が使うことを想定しています（ライブ配信のサムネイルなど）。\n\n2022年4月に発売されたアーティスト兼vtuberの@ukyo_rst小型フォームモデルが、前回のセーター着用モデルに抱かれる様子を描いてください。\n\nもしかしたら、セーターの方はハートアイで、セーターのハグに飲み込まれる小さい方は赤面しているのでしょうか。\n\n最近、マグロナさんはBlue Archiveを楽しんでいるようです。もしかしたら、セーターを着たオネエちゃんにBlue Archive風の後光が差すかも？ゲヘナ派になるかな？\n\nhttps://virtualyoutuber.fandom.com/wiki/Magrona ＜- セーター着用モデル\nhttps://twitter.com/ukyo_rst/status/1515650946532982789 <- 2022年4月\n\nhttps://twitter.com/ukyo_rst/status/1515650946532982789", "created_at": "", "completed_at": ""}, {"path": "/@ayamitsu_11/works/12", "thumbnail_src": "https://si.imgix.net/ad9da437/uploads/origins/347929db-cc3b-459e-931d-445faa1fc99f?bg=%23fff&auto=format%2Cco