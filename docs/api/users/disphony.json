b97-e11f-4400-9c10-1eb868b0a0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f24f089283203f0f820b65efee1c9658 3x", "genre": "art", "nsfw": false, "body": "またまたリクエストさせていただきます！\n\n私の分身少佐ちゃんの服装違いを描いていただければと思っています！\n\n髪色は白髪\n髪型はポニーテールの左片目メカクレ\nハーフリムメガネをかけたダウナー系女の子\n服装は黒のチノパンに灰色のセーター、紺色のトレンチコートを羽織ってる姿\n身長は160cm程度、体型はスリム\nポーズや表情などはお任せします！\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@disphony/works/53", "thumbnail_src": "https://si.imgix.net/c31c67d0/uploads/origins/e815b6f6-f020-4f69-aacc-25a71bf48196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0e262351f698fb39a9b198ee1807715", "thumbnail_srcset": "https://si.imgix.net/c31c67d0/uploads/origins/e815b6f6-f020-4f69-aacc-25a71bf48196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0e262351f698fb39a9b198ee1807715, https://si.imgix.net/c31c67d0/uploads/origins/e815b6f6-f020-4f69-aacc-25a71bf48196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8534a9bccf64a4241135b67e3087cf5f 2x, https://si.imgix.net/c31c67d0/uploads/origins/e815b6f6-f020-4f69-aacc-25a71bf48196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e8728e548b53f6006f0f59d3d36be93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@disphony/works/52", "thumbnail_src": "https://si.imgix.net/b7f49a54/uploads/origins/6f6cc957-a64e-4ef1-a9aa-d4fe3e2600f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccente