27ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd422fb82ca2abfee70f6b87b3a3e28", "thumbnail_srcset": "https://si.imgix.net/c01b7d56/uploads/origins/491865d1-69a5-411d-8308-728424c827ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd422fb82ca2abfee70f6b87b3a3e28, https://si.imgix.net/c01b7d56/uploads/origins/491865d1-69a5-411d-8308-728424c827ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19d42b030d60f586593d14da79e09d34 2x, https://si.imgix.net/c01b7d56/uploads/origins/491865d1-69a5-411d-8308-728424c827ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9e9490a9a49574a6b6395cc1db2f876 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！\n絵柄が好みでしたので、リクエストを遅らせていただきます。\n魅力的と言っていただいた、わたしのオリキャラの変気創一を描いてもらいたいです。\n構図等はお任せします、お好きなように調理してください！\n基本設定は資料にあります。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1lqWodEnwKgJEoFahO4L5QHRj9_bE7MSI", "created_at": "", "completed_at": ""}, {"path": "/@fuwafuwawaland/works/32", "thumbnail_src": "https://si.imgix.net/0778c715/uploads/origins/030d2ef9-2f2d-4c52-9566-a94754764fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d530817b8fc0600c56506860378fbccb", "thumbnail_srcset": "https://si.imgix.net/0778c715/uploads/origins/030d2ef9-2f2d-4c52-9566-a94754764fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d530817b8fc0600c56506860378fbccb, https://si.imgix.net/0778c715/uploads/origins/030d2ef9-2f2d-4c52-9566-a94754764fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5dafb8886d9bec9137bc10af1831095 2x, https://si.imgix.net/0778c715/uploads/origins/030d2ef9-2f2d-4c52-9566-a94754764fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f72ca864f621c753824de0ad10ba29a8 3x", "genre": "art", "nsfw": false, "body": "はじめまして。アピールありがとうございます。VTuberの牙城論莉と申します。\nいただいたアピールとイラストを拝見し、ふわ様が描かれる牙城論莉を見たいと思い、リ