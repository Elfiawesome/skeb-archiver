d_at": "2026-03-15T05:20:27.704413+00:00"}]}, "current_prices": {"art": 11000}, "price_range": {"art": {"min": 8000, "max": 13000}}, "links": [{"label": "Twitter", "url": "https://x.com/9uruminn", "name": "9uruminn"}, {"label": "Misskey_io", "url": "https://misskey.io/@guruminnsuB", "name": "guruminnsuB"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/858737", "name": "858737"}], "flags": {}, "works": [{"path": "/@guruminnSuB/works/1173", "thumbnail_src": "https://si.imgix.net/ba53d7b7/uploads/origins/895f7a34-4f47-4e35-b41b-91982c414d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c1b529db459d7065cbd5e4e910dc0a", "thumbnail_srcset": "https://si.imgix.net/ba53d7b7/uploads/origins/895f7a34-4f47-4e35-b41b-91982c414d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c1b529db459d7065cbd5e4e910dc0a, https://si.imgix.net/ba53d7b7/uploads/origins/895f7a34-4f47-4e35-b41b-91982c414d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=083ff7e7400961456af0547da90bf72a 2x, https://si.imgix.net/ba53d7b7/uploads/origins/895f7a34-4f47-4e35-b41b-91982c414d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aebd1049c7a9fc4c052580bfdd1d3fd 3x", "genre": "art", "nsfw": false, "body": "こんにちは～\nSFWのイラストを依頼したいです。\n \n体は正面を向いている状態で、\n目を閉じて笑っている、口は閉じたままでお願いします。\n手は片手でハートを作っている感じで～\n \n服装と設定は参考画像のリンクを参照してください：https://drive.google.com/drive/folders/1ZjmN7dTM7KZReigypjyWg_GwqCKHfs-7?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1ZjmN7dTM7KZReigypjyWg_GwqCKHfs-7?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1172", "thumbnail_src": "https://si.imgix.net/7dc1914c/uploads/origins/92c960d9-1ace-4935-bf69-b65e0ebf04f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e19c0674d8a182861004e26cf154bf5c", "thumbnail_srcset": "https://si.imgix.net/7dc1914c/uploads/origins/92c960d9-1ace-4935-bf69-b65e0ebf04f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e19c0674d8a182861004e26cf154bf5c, https://si.imgix.net/7dc1914c/uploads/origins/92c960d9-1ace-4935-bf69-b65e0ebf04f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d319ad705339fc76ae5f7d27ba461c02 2x, https://si.imgix.net/7dc1914c/uploads/origins/92c960d9-1ace-4935-bf69-b65e0ebf04f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab293352cac3727cc6cb291ca73461af 3x", "genre": "art", "nsfw": false, "body": "こんにちは。前回の作品が大好きで、ぜひまた依頼を申し込みに参りました。お引き受けいただければ幸いです！\n\n今回のイラストは、全て先生にお任せしたいと考えております。形式や服装に指定はございません。二人が愛し合っている様子を描いていただければ幸いです。\n\n参考までに過去の依頼作品もいくつか載せておきますので、ご確認のほどよろしくお願いいたします！\n\n1. オレンジ色の犬（Mir）の顔の模様と特徴\nhttps://drive.google.com/drive/folders/1Qo1otNzEsD_UUkd9UpN0k49vr_imxZ9I\n\n2. 白狼（Owens）の身体の模様、顔（眉間）、オッドアイ、モノクル、イヤリング、および耳の上部にあるリング状の模様。\nhttps://drive.google.com/drive/folders/1ltGYd-eXBtUwwXrLGJOvwt4DnIgjI6YC", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1171", "thumbnail_src": "https://si.imgix.net/20ce018d/uploads/origins/7bc58fa1-d98c-4e56-9f9f-4895fb593b51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=803639ba5ff1134838d06663646fb153", "thumbnail_srcset": "https://si.imgix.net/20ce018d/uploads/origins/7bc58fa1-d98c-4e56-9f9f-4895fb593b51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=803639ba5ff1134838d06663646fb153, https://si.imgix.net/20ce018d/uploads/origins/7bc58fa1-d98c-4e56-9f9f-4895fb593b51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7728561999c6b947a525a267442534a3 2x, https://si.imgix.net/20ce018d/uploads/origins/7bc58fa1-d98c-4e56-9f9f-4895fb593b51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9e01ef187c72c16fb5658d2832ae982 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1170", "thumbnail_src": "https://si.imgix.net/70571704/uploads/origins/f3a376e6-5b5c-44cc-b7f4-928284100e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8704a1dc60cef989781b15195732f5cb", "thumbnail_srcset": "https://si.imgix.net/70571704/uploads/origins/f3a376e6-5b5c-44cc-b7f4-928284100e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8704a1dc60cef989781b15195732f5cb, https://si.imgix.net/70571704/uploads/origins/f3a376e6-5b5c-44cc-b7f4-928284100e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ceaa8ecd84760d0612cb479430a2e87 2x, https://si.imgix.net/70571704/uploads/origins/f3a376e6-5b5c-44cc-b7f4-928284100e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de70b1f598720cf07953c3b4ac39bf87 3x", "genre": "art", "nsfw": false, "body": "二人を並べて、二人とも制服姿で可愛い表情をしてほしいです。よろしくお願いします！https://drive.google.com/drive/folders/1UR6v9GlBZBNVgkrWxHCYAT8_Nu5RUswU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1169", "thumbnail_src": "https://si.imgix.net/1cbd0d82/uploads/origins/a4994afe-d206-4679-abe1-97d5ea7444e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b25163388eb055c8bdb15c4f2cffff03", "thumbnail_srcset": "https://si.imgix.net/1cbd0d82/uploads/origins/a4994afe-d206-4679-abe1-97d5ea7444e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b25163388eb055c8bdb15c4f2cffff03, https://si.imgix.net/1cbd0d82/uploads/origins/a4994afe-d206-4679-abe1-97d5ea7444e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0382ea0e7e398ec3d73aaffa44c3a047 2x, https://si.imgix.net/1cbd0d82/uploads/origins/a4994afe-d206-4679-abe1-97d5ea7444e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a87dbe4b23a758038a990a931ea92b9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1168", "thumbnail_src": "https://si.imgix.net/a13a3a9d/uploads/origins/c1173b2c-e35c-4895-ac37-f42816b7ad26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3674e657f4047e1afc71125fee40b65f", "thumbnail_srcset": "https://si.imgix.net/a13a3a9d/uploads/origins/c1173b2c-e35c-4895-ac37-f42816b7ad26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3674e657f4047e1afc71125fee40b65f, https://si.imgix.net/a13a3a9d/uploads/origins/c1173b2c-e35c-4895-ac37-f42816b7ad26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de52e19c6d35b60cf763d13646d9bc2c 2x, https://si.imgix.net/a13a3a9d/uploads/origins/c1173b2c-e35c-4895-ac37-f42816b7ad26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=677ed44239db1474e67bffb2b73e433a 3x", "genre": "art", "nsfw": false, "body": "キャプテン、またお会いできて嬉しいです！！猫を連れて参りました！背景はシンプルで、両手を広げた立ちポーズをお願いします！！\n\n  細かい部分はご判断にお任せします！！関連する参考資料は全てGoogleドライブにアップしておきます。ご依頼内容をご覧いただきありがとうございます！素晴らしい一日をお過ごしください！https://drive.google.com/drive/folders/1-t7gNUqP-kOR0kDIf7SnQqMYuSS3PpnR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1167", "thumbnail_src": "https://si.imgix.net/7013096d/uploads/origins/f034a409-a28c-4c75-8a03-8bbf5a536f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ad6a780fc7db9df3a8dd8f3f018b1d", "thumbnail_srcset": "https://si.imgix.net/7013096d/uploads/origins/f034a409-a28c-4c75-8a03-8bbf5a536f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ad6a780fc7db9df3a8dd8f3f018b1d, https://si.imgix.net/7013096d/uploads/origins/f034a409-a28c-4c75-8a03-8bbf5a536f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02ba9a550e529f9eecea70cfe3b48bf3 2x, https://si.imgix.net/7013096d/uploads/origins/f034a409-a28c-4c75-8a03-8bbf5a536f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe9f8f44cdb0a56bf9272a19e9e942df 3x", "genre": "art", "nsfw": false, "body": "您好！我非常喜欢您的作品，所以想委托您帮我创作一份作品\n\n我需要两张画，狐狸和龙不同框，龙向狐狸发射爱心，狐狸脸红接住。\n\n衣服请参考图1图2，另外麻烦您把龙的手套去掉漏出爪子，爪子参考图4，如有需要，其他细节可以参考图3\n\nhttps://drive.google.com/drive/folders/1mgDhR5ruH-eOiNAeFYqr1Suqe2Un29Oi?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1166", "thumbnail_src": "https://si.imgix.net/1d4e0ffc/uploads/origins/9ae1dd91-e51f-4df8-a11b-1efed514806d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca70b078cd494b19cedecda00c326925", "thumbnail_srcset": "https://si.imgix.net/1d4e0ffc/uploads/origins/9ae1dd91-e51f-4df8-a11b-1efed514806d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca70b078cd494b19cedecda00c326925, https://si.imgix.net/1d4e0ffc/uploads/origins/9ae1dd91-e51f-4df8-a11b-1efed514806d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ece5d87e8bd7194b675629de70ab88a 2x, https://si.imgix.net/1d4e0ffc/uploads/origins/9ae1dd91-e51f-4df8-a11b-1efed514806d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95ab49d400fd63e8332e0cefea5ceef7 3x", "genre": "art", "nsfw": true, "body": "こんにちは。絵がとても可愛くて、コミッションをお願いしたいです！希望の構図は特にありませんので、自由に描いていただけると嬉しいです！キャラクターデザイン https://drive.google.com/file/d/188lOXv6GNXmTPYWVFNtb8KLoa4wIAagt/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1165", "thumbnail_src": "https://si.imgix.net/21e23c41/uploads/origins/07cf59ad-c393-44d9-87f5-baa681bf58f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f84c50548659096bc06fea2d2644a3b", "thumbnail_srcset": "https://si.imgix.net/21e23c41/uploads/origins/07cf59ad-c393-44d9-87f5-baa681bf58f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f84c50548659096bc06fea2d2644a3b, https://si.imgix.net/21e23c41/uploads/origins/07cf59ad-c393-44d9-87f5-baa681bf58f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6b1b00aad6f968f1c410a1b19e43f31 2x, https://si.imgix.net/21e23c41/uploads/origins/07cf59ad-c393-44d9-87f5-baa681bf58f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ab83a4cbae5111b082e7f17a846fd39 3x", "genre": "art", "nsfw": false, "body": "こんにちは、鍾銘と申します。\n2人のキャラが依頼したいです\n以下依頼内容です。\n\n【キャラクター資料】\n・鍾銘：\nhttps://drive.google.com/drive/folders/1a7Cbr7qHf50Ca2sCYj8V-ChQx0oe1o4S?usp=sharing\n・Benben：\nhttps://drive.google.com/drive/folders/1n_AF4-TkNxm4FPO4iG_6fI2IGB_Mazl0?usp=sharing\n\n【ご希望】\n・恋人らしい雰囲気のポーズで描いていただけますと嬉しいです。\n・二人の薬指が赤い糸でつながっている表現を入れていただけますと嬉しいです。\n・服装はなしでお願いします。\n(リンク資料内「服なし」設定図を参加できます)\n\n上記以外はすべておまかせします。\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@guruminnSuB/works/1164", "thumbnail_src": "https://si.imgix.net/884c1c80/uploads/origins/55ecc118-029f-48bc-b881-202169122514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d9bf0c3645ef27326b5ef2925d89216", "thumbnail_srcset": "https://si.imgix.net/884c1c80/uploads/origins/55ecc118-029f-48bc-b881-202169122514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d9bf0c3645ef27326b5ef2925d89216, https://si.imgix.net/884c1c80/uploads/origins/55ecc118-029f-48bc-b881-202169122514?bg=%23fff&auto=for