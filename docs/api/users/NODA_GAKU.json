-4ded-b5d4-f98702fa0692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70f55d73d39828a8f6640b8430e1aad0", "thumbnail_srcset": "https://si.imgix.net/a127e396/uploads/origins/22e3a73a-cbc7-4ded-b5d4-f98702fa0692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70f55d73d39828a8f6640b8430e1aad0, https://si.imgix.net/a127e396/uploads/origins/22e3a73a-cbc7-4ded-b5d4-f98702fa0692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e41f3ef18e76a57c5f5bca23792515b 2x, https://si.imgix.net/a127e396/uploads/origins/22e3a73a-cbc7-4ded-b5d4-f98702fa0692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8073ccf53752aad39234c784ebb14802 3x", "genre": "art", "nsfw": true, "body": "ギリシア神話より、アンタイオスと戦うヘラクレスを題材にしたイラストをお願いします。\n\n大地に体が着いている限り不死身の巨人アンタイオスをヘラクレスが持ち上げて締め殺すというのが本来の展開ですが、それをヘラクレスが駅弁スタイル（四十八手の櫓立ち）でアンタイオスを激しく犯し、何度もメスイキさせて衰弱させるという展開に改変して下さい。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/20", "thumbnail_src": "https://si.imgix.net/023ba6ad/uploads/origins/ff3a4b2c-36f5-4c33-9a7b-835851742054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64601a6d676f0e0c92853631b65408d5", "thumbnail_srcset": "https://si.imgix.net/023ba6ad/uploads/origins/ff3a4b2c-36f5-4c33-9a7b-835851742054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64601a6d676f0e0c92853631b65408d5, https://si.imgix.net/023ba6ad/uploads/origins/ff3a4b2c-36f5-4c33-9a7b-835851742054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=939b019c38229416cc408247991a8488 2x, https://si.imgix.net/023ba6ad/uploads/origins/ff3a4b2c-36f5-4c33-9a7b-835851742054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b7d55755dfaed1bb7727c8d0d69dac0 3x", "genre": "art", "nsfw": false, "body": "ギリシア神話のヘラクレスの12の難業より、7番目の「クレタの雄牛の生捕り」を題材にしたイラストをお願いします。\n\n暴れる雄牛の背中にロデオのようにヘラクレスが跨っているという構図を希望します。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/19", "thumbnail_src": "https://si.imgix.net/5c27fcb4/uploads/origins/df7d4e91-acc0-4053-a119-e7d93e4acca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7628f654bad25a7f9a662b701ee000f1", "thumbnail_srcset": "https://si.imgix.net/5c27fcb4/uploads/origins/df7d4e91-acc0-4053-a119-e7d93e4acca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7628f654bad25a7f9a662b701ee000f1, https://si.imgix.net/5c27fcb4/uploads/origins/df7d4e91-acc0-4053-a119-e7d93e4acca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74daeb1b29104d1a82d1d6c006a7a475 2x, https://si.imgix.net/5c27fcb4/uploads/origins/df7d4e91-acc0-4053-a119-e7d93e4acca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48eadf317b10533c82553ca2e028f2ed 3x", "genre": "art", "nsfw": false, "body": "ギリシア神話のヘラクレスの12の難業より、６番目の難業「ステュムパロスの怪鳥退治」を題材にしたイラストをリクエストさせていただきます。\n\nエミール=アントワーヌ・ブールデルの「弓を引くヘラクレス」の構図で、怪鳥たちを狙って弓を引き絞っている場面をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/18", "thumbnail_src": "https://si.imgix.net/1936068c/uploads/origins/baa0dc95-136b-47c1-9480-7f1b97d252a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc9cf88d36f3d6f286b4c5e4d1beab51", "thumbnail_srcset": "https://si.imgix.net/1936068c/uploads/origins/baa0dc95-136b-47c1-9480-7f1b97d252a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc9cf88d36f3d6f286b4c5e4d1beab51, https://si.imgix.net/1936068c/uploads/origins/baa0dc95-136b-47c1-9480-7f1b97d252a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78e05dd89fb588d0040e831c38bec8a3 2x, https://si.imgix.net/1936068c/uploads/origins/baa0dc95-136b-47c1-9480-7f1b97d252a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6323b2d8f152a698b094299896a6239 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/17", "thumbnail_src": "https://si.imgix.net/33057acd/uploads/origins/e34fdaad-05bf-462f-a26b-75f18e1728fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09b0e1497ca031da72ccff8b59a0615b", "thumbnail_srcset": "https://si.imgix.net/33057acd/uploads/origins/e34fdaad-05bf-462f-a26b-75f18e1728fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09b0e1497ca031da72ccff8b59a0615b, https://si.imgix.net/33057acd/uploads/origins/e34fdaad-05bf-462f-a26b-75f18e1728fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa4547d643bc93d07923d2af24de739 2x, https://si.imgix.net/33057acd/uploads/origins/e34fdaad-05bf-462f-a26b-75f18e1728fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=570bf777b9085c37e25509e8695c5d22 3x", "genre": "art", "nsfw": false, "body": "ギリシア神話の「ヘラクレスの12の難業」より、５番目の難業である「アウゲイアース王の家畜小屋掃除」を題材にしたイラストをお願いします。\n\n状況設定としては、ヘラクレスが河の神を脅して強引に河の流れを変えさせ、巨大な家畜小屋に激流を流し込ませているという感じで。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/16", "thumbnail_src": "https://si.imgix.net/1e76061c/uploads/origins/f4297521-08c2-4bd4-977b-652f444004da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=774ef7be51bae4ca0bbf9b61ef9dc993", "thumbnail_srcset": "https://si.imgix.net/1e76061c/uploads/origins/f4297521-08c2-4bd4-977b-652f444004da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=774ef7be51bae4ca0bbf9b61ef9dc993, https://si.imgix.net/1e76061c/uploads/origins/f4297521-08c2-4bd4-977b-652f444004da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=682e531a519e7832f9784f7793a0ada2 2x, https://si.imgix.net/1e76061c/uploads/origins/f4297521-08c2-4bd4-977b-652f444004da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8131abb9802ed4497f3ee668dd30f7c7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/15", "thumbnail_src": "https://si.imgix.net/a3062ec0/uploads/origins/558a8bd2-73f4-4650-b00b-bc0361597f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59c1f19a7b91458cf082fead65775b8b", "thumbnail_srcset": "https://si.imgix.net/a3062ec0/uploads/origins/558a8bd2-73f4-4650-b00b-bc0361597f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59c1f19a7b91458cf082fead65775b8b, https://si.imgix.net/a3062ec0/uploads/origins/558a8bd2-73f4-4650-b00b-bc0361597f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db190e851bad55e6124f26f45f7c236f 2x, https://si.imgix.net/a3062ec0/uploads/origins/558a8bd2-73f4-4650-b00b-bc0361597f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3233700aee13806c74f62917bc5ad6e8 3x", "genre": "art", "nsfw": false, "body": "ギリシア神話の「ヘラクレスの12の難業」より、4番目の難業「エリュマントスの猪の生け捕り」を題材にしたイラストをお願いします。 \n\n猪を乙事主級の大きさに描いて頂ければ、猪の扱いや捕らえ方、その他の場面や構図に関しては全てお任せ致します。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/14", "thumbnail_src": "https://si.imgix.net/87370c97/uploads/origins/2b3541c8-7cb2-4ec2-9506-6eefc6fd6b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e46fa8c10b87fd812c82906541e3f1d", "thumbnail_srcset": "https://si.imgix.net/87370c97/uploads/origins/2b3541c8-7cb2-4ec2-9506-6eefc6fd6b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e46fa8c10b87fd812c82906541e3f1d, https://si.imgix.net/87370c97/uploads/origins/2b3541c8-7cb2-4ec2-9506-6eefc6fd6b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b490dbc860e631f4b796ab2eee9d736f 2x, https://si.imgix.net/87370c97/uploads/origins/2b3541c8-7cb2-4ec2-9506-6eefc6fd6b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11007bc2c490df4a0c526cc196da5acb 3x", "genre": "art", "nsfw": true, "body": "今回は神格化した後のヘラクレスが立ち小便をするという設定のイラストをお願いします。\n\n神々の酒宴でしこたま酒を飲み酔っ払ったヘラクレスが尿意を催し、天上界の雲の上から下界に向けて、その巨根から盛大に放尿し、それが黄金の雨となって地上に降り注ぐという感じで。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/13", "thumbnail_src": "https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce6edf9d6fd413f5c2cbda20856fa45", "thumbnail_srcset": "https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce6edf9d6fd413f5c2cbda20856fa45, https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c326505909101d7c7f903a7b435eb188 2x, https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6aad4f183d9643229fa27ec5e15e085d 3x", "genre": "art", "nsfw": true, "body": "いつも御世話になっております。\n\n4番目の課題が終了した記念に……となれたら良かったのですが、それにはまだ時間が掛かりそうなので、再度「ヘラクレスによるレルネーのヒュドラー退治」を題材にしたイラストをリクエストさせて頂きます。\n\nヒュドラーが1本の首を切り落とされると、そこから2本の首が再生するという場面を、「ネメアの獅子退治」と「ケリュネイアの鹿の生け捕り」の時のような絵柄でお願いします。\n\n首を切り落とされた傷口から、先が膨らんだ2本の肉茎がムクムクと膨張して蛇の首になっていく様子を見たヘラクレスが何かを連想してしまい、その股間の大蛇が対抗心を燃やして鎌首をもたげ、腰巻きの前垂れを大きく持ち上げるという状況設定でよろしくお願い致します。\n性器部の露出は無い構図を希望しますが、念の為にNSFW設定で。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/12", "thumbnail_src": "https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f859584060684e65cff8e0e0a0d6f03c", "thumbnail_srcset": "https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f859584060684e65cff8e0e0a0d6f03c, https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=469772791f5c96e47dae22c8b63ddb5a 2x, https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2ca65af7afdb413df0e3ca33bcc9e1 3x", "genre": "art", "nsfw": false, "body": "3つめの課題が片付いた記念に、ヘラクレスの12の難業の3つめ「ケリュネイアの鹿の捕獲」を題材としたイラストを依頼させて頂きます。\n\n青銅の蹄と黄金の角を持つ、狩猟の女神アルテミスの聖獣である駿足の鹿を追いかけ、獅子の毛皮をはためかせて全力疾走するヘラクレスの姿をお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/11", "thumbnail_src": "https://si.imgix.net/72d6b2e6/uploads/origins/e2a08f61-d07d-4f7c-87cf-46f0a253256f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7e20e0f4709b426b99e76b251aef26a", "thumbnail_srcset": "https://si.imgix.net/72d6b2e6/uploads/origins/e2a08f61-d07d-4f7c-87cf-46f0a253256f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7e20e0f4709b426b99e76b251aef26a, https://si.imgix.net/72d6b2e6/uploads/origins/e2a08f61-d07d-4f7c-87cf-46f0a253256f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d14d48ba651a934296e00b0c899a6a6 2x, https://si.imgix.net/72d6b2e6/uploads/origins/e2a08f61-d07d-4f7c-87cf-46f0a253256f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cffb6c725977076446e17998c7504503 3x", "genre": "art", "nsfw": false, "body": "前回は有難うございました。\n続けて「ヘラクレスの12の難業」の2つ目、レルネーのヒュドラー退治を題材にしたイラストをお願い致します。\n\n切り落とされた蛇の首が散乱する中、最後に残った不死の首を封印する為、前回の難業で手に入れた獅子の毛皮を纏ったヘラクレスが、ザンギエフ型の胸毛ともっさりとした脇毛を晒しながら、ヒュドラーの上に載せる為に大岩を持ち上げているという状況設定で宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/10", "thumbnail_src": "https://si.imgix.net/3f818ef5/uploads/origins/9e420917-af53-46e5-ac40-0466e9ceb16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb5dbfc34ac8eff42e2b640e3ff3033a", "thumbnail_srcset": "https://si.imgix.net/3f818ef5/uploads/origins/9e420917-af53-46e5-ac40-0466e9ceb16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb5dbfc34ac8eff42e2b640e3ff3033a, https://si.imgix.net/3f818ef5/uploads/origins/9e420917-af53-46e5-ac40-0466e9ceb16b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23be88fa524853757a461daa48608bbb 2x, https://si.imgix.net/3f818ef5/uploads/origins/9e420917-af53-46e5-ac40-0466e9ceb16b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2daa356da0b1d39ed41d2deadbbbeb2 3x", "genre": "art", "nsfw": false, "body": "12段階の課題の1つめを完了した記念に、ギリシア神話の「ヘラクレスの12の難業」のひとつ目である「ネメアの獅子退治」を題材にしたイラストを依頼させて頂きます。\n\n野人系剛毛髭熊バルクマッチョなヘラクレスが獅子を締め上げている場面を、pixiv FANBOXで発表されているカレンダーのような絵柄でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NODA_GAKU/works/9", "thumbnail_src": "https://si.imgix.net/58f52a83/uploads/origins/ffc301ab-7500-4306-b15c-081f8c708253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd876d231b0a17eee4ae41f3efe6a80", "thumbnail_srcset": "https://si.imgix.net/58f52a83/uploads/origins/ffc301ab-7500-4306-b15c-081f8c708253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd876d231b0a17eee4ae41f3efe6a80, https://si.imgix.net/58f52a83/uploads/origins/ffc301ab-7500-4306-b15c