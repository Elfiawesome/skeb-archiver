2-a8ad-6d8f644527fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dae3e2db313e95a31bc3a7bc3378d00b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hiyori_bana/works/33", "thumbnail_src": "https://si.imgix.net/7ec171d3/uploads/origins/b42c9581-279b-462a-a515-a43195b1ecd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6c9ee58d9689724b04ead1ece51788", "thumbnail_srcset": "https://si.imgix.net/7ec171d3/uploads/origins/b42c9581-279b-462a-a515-a43195b1ecd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6c9ee58d9689724b04ead1ece51788, https://si.imgix.net/7ec171d3/uploads/origins/b42c9581-279b-462a-a515-a43195b1ecd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f261ffbd2ca0a45cf2d99a1014f0ec0f 2x, https://si.imgix.net/7ec171d3/uploads/origins/b42c9581-279b-462a-a515-a43195b1ecd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=122bffdf37ab438ce4efc550ae0f49f5 3x", "genre": "art", "nsfw": false, "body": "はじめまして、手塚悠生と申します。\n以前から橘ひより様のやさしいタッチが大好きで、夫を～のイラスト等いつも拝見しておりました。\n今回は活動で使用するイラストをご依頼させていただきたくリクエストをお送りしました。\n\n○使用予定：配信サムネイルやSNS活動、ヘッダー等\n〇モチーフ：本・草花・夜・犬・和　\n\n私側での公開は、とあるお祝い事にポストに添えて公開することになります。\n（誕生日や収益化記念等で考えていただければと思います）\n\nポーズや表情など基本的な部分はおまかせしたいのですが、\n橘ひより様の描かれる恋人や夫婦の雰囲気がとても大好きなので、\nできれば少し距離間の近い雰囲気でお願いしたいです。\n\n初公開後は基本的にサムネイル等で使用させていただきますので、\n毛先や肩を範囲に収めていただけますでしょうか。\n背景については、透過版PNGを併せていただけるととても嬉しいです。\n\n上記問題などございませんでしたら、お受けいただけますと幸いです。\nお忙しい中大変恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yBdvvxkhGBY9Ut0Jg7fwa-dhOi0nZKEj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hiyori_bana/works/32", "thumbnail_src": "https://si.imgix.net/21a64ce7/uploads/origins/5c31b79b-9194-4641-abe9-4fe108f91c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr