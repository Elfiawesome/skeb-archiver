42a648cfe11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3a67a0aa53a61d2e90a3231b4b5a50b 2x, https://si.imgix.net/0fd2d823/uploads/origins/04a17b9b-32cf-4e40-8aac-e42a648cfe11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9edbfebf3b9efbda4080502e1cd3d28 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n埋没毛先生のパイズリ絵の質感に凄く惹かれたためリクエスト送らせていただきます。\n\n■キャラクター名／作品名\nクリス・ベルナル／ポップアップストーリー(ポプスト)\n\nエルフの女の子になります。\n\n■容姿\n・全裸(額のアクセサリと両耳のイヤリングのみ装着)\n・おっぱいは爆乳、乳首と乳輪はぷっくりとしたパフィーニップル。\n\n■シチュエーション\n・女の子側が主導のスタンダードなパイズリ。\n・正面アングルでおっぱいの北半球側の谷間が良く見える構図。\n・谷間から亀頭が半分ほど出ている。\n・自身のおっぱいで気持ち良くなってくれていることに喜んでいるような表情。\n・狭射前と、狭射後勢いよく噴水のように射精して顔やおっぱいが精液まみれの状態の差分をお願いします(精液量は多ければ多いほど嬉しいです)。\n\n以上となります、ご検討よろしくお願いいたします。\n\nhttps://www.dropbox.com/s/4yx655in8zh4pqa/chris.png\n\nhttps://wikiwiki.jp/popupstory/%E7%94%9F%E5%BE%92%E3%83%97%E3%83%AD%E3%83%95%E3%82%A3%E3%83%BC%E3%83%AB/%E3%82%AF%E3%83%AA%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@uOM6iYbcbigfUlH/works/50", "thumbnail_src": "https://si.imgix.net/3b85fbe7/uploads/origins/0eda3708-1c9a-4261-9a91-78f7bdecb4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3bce7a94301f7fc330172c6295a8aec", "thumbnail_srcset": "https://si.imgix.net/3b85fbe7/uploads/origins/0eda3708-1c9a-4261-9a91-78f7bdecb4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3bce7a94301f7fc330172c6295a8aec, https://si.imgix.net/3b85fbe7/uploads/origins/0eda3708-1c9a-4261-9a91-78f7bdecb4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c625ed77073d2144b78c17beda64a1b6 2x, https://si.imgix.net/3b85fbe7/uploads/origins/0eda3708-1c9a-4261-9a91-78f7bdecb4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2e3ebce11a2298f422dd30551924a96 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uOM6iYbcbigfUlH/works/49", "thumbnail_src": "https://si.imgix.net/192f59ad/uploads/origins/c0efb820-d7a3-4b54-acb7-ae135d7f0edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f43f6586a57becaab952c46e90a599", "thumbnail_srcset": "https://si.imgix.net/192f59ad/uploads/origins/c0efb820-d7a3-4b54-acb7-ae135d7f0edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f43f6586a57becaab952c46e90a599, https://si.imgix.net/192f59ad/uploads/origins/c0efb820-d7a3-4b54-acb7-ae135d7f0edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fa41aee6f0edddfe7a8f412bc1fbc4d 2x, https://si.imgix.net/192f59ad/uploads/origins/c0efb820-d7a3-4b54-acb7-ae135d7f0edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57473b550f98f3b23082115c75af9583 3x", "genre": "art", "nsfw": true, "body": "前回はとってもえっちなセリナをお描きいただきましてありがとうございました。\n今回もセリナをリクエストしたいのですが、前回の続きシチュエーションで（下記URL）\n\nhttps://skeb.jp/@uOM6iYbcbigfUlH/works/25\n\n恋人繋ぎをしながら気持ち良さそうな表情で絶頂しているセリナをお願いします。\n\n体位は埋没毛さんにお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@uOM6iYbcbigfUlH/works/48", "thumbnail_src": "https://si.imgix.net/aefbb370/uploads/origins/2e9e86c6-b486-4d22-8ba3-0d17cd3d2ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1a6849defadcef2ab1bf8f2027c29b", "thumbnail_srcset": "https://si.imgix.net/aefbb370/uploads/origins/2e9e86c6-b486-4d22-8ba3-0d17cd3d2ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1a6849defadcef2ab1bf8f2027c29b, https://si.imgix.net/aefbb370/uploads/origins/2e9e86c6-b486-4d22-8ba3-0d17cd3d2ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f81945cede606e7deb168a117daffc2b 2x, https://si.imgix.net/aefbb370/uploads/origins/2e9e86c6-b486-4d22-8ba3-0d17cd3d2ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=081e22640ae990a939545fb6f5f2b64c 3x", "genre": "art", "nsfw": true, "body": "佐城トモエ（チーパオ）と先生が乳首当てゲームをしているイラストをお願いできないでしょうか\n\n・向かい合って乳首当てゲームをしている。トモエは腕でおっぱいを挟んで胸を強調してる感じのポーズで、笑顔で楽しんでいる\n・トモエの服は汗で肌に張り付いていて、乳首と乳輪の位置が分かるぐらいにおっぱいが透けて見えている。\n・先生は乳首と乳輪を避けて片側のおっぱいを鷲掴みし、もう片方も見当違いの所を指で突いている\n\n細かい構図等はお任せします。ご検討の程よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@uOM6iYbcbigfUlH/works/47", "thumbnail_src": "https://si.imgix.net/aec95898/uploads/origins/9b8fbee2-b29a-437e-97ad-69708e01a961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6396df2a808a4648d0a8821f4c76ec", "thumbnail_srcset": "https://si.imgix.net/aec95898/uploads/origins/9b8fbee2-b29a-437e-97ad-69708e01a961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6396df2a808a4648d0a8821f4c76ec, https://si.imgix.net/aec95898/uploads/origins/9b8fbee2-b29a-437e-97ad-69708e01a961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81ebd3f66c2f2f32133cde3fa3782f9f 2x, https://si.imgix.net/aec95898/uploads/origins/9b8fbee2-b29a-437e-97ad-69708e01a961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd6dd2088d273edd7272cb2827c849c8 3x", "genre": "art", "nsfw": true, "body": "ブルアカのシュンのセックス絵をお願いします。\n\n構図は↓の感じで腕を掴むロールスロイス(膝立ちバック)で、でかいおっぱいをぶるんぶるん揺らしまくる激しいセックスをお願いしたいです。\nhttps://twitter.com/_anannex/status/1520163907725570049?\n\n衣装はほぼ裸、表情はイカされてる様子のアヘオホ顔系だと嬉しいです。\nよろしければご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@uOM6iYbcbigfUlH/works/46", "thumbnail_src": "https://si.imgix.net/d8efac1a/uploads/origins/cd02c780-104c-4efb-9439-1a3af94ae11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a37f45a87142ee46b8d9705c7c6d058