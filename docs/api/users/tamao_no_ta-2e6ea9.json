2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e512e3e912c91c757bf316a988703bb, https://si.imgix.net/95763363/uploads/origins/6346afd6-6eea-465d-85bc-6a5b94b37687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f6ccf9375ab7edbfa23930634c72378 2x, https://si.imgix.net/95763363/uploads/origins/6346afd6-6eea-465d-85bc-6a5b94b37687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f669dac172d33468c6bb2d71d4f97f59 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のOCの2人と一緒にハロウィンをテーマにした写真を依頼したいんだ！キャサリンとヘイゼルはハロウィンのために怪盗の格好をしているんだけど、強盗に成功したかのようなポーズをとってほしいな。\n\nキャサリン：https://imgur.com/a/katherine-hollyday-CpSOQ72\n\nヘイゼル：https://imgur.com/a/hazel-andromeda-89YnWzi\n\n怪盗ヘーゼルの衣装：https://imgur.com/a/952ZQXz\n\n怪盗キャサリン衣装：https://imgur.com/a/uXMz7LE", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/12", "thumbnail_src": "https://si.imgix.net/74417a39/uploads/origins/3fb6a7c8-3742-4223-a9db-0f1664140b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b227864421e47c22e4637cc4df2c839d", "thumbnail_srcset": "https://si.imgix.net/74417a39/uploads/origins/3fb6a7c8-3742-4223-a9db-0f1664140b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b227864421e47c22e4637cc4df2c839d, https://si.imgix.net/74417a39/uploads/origins/3fb6a7c8-3742-4223-a9db-0f1664140b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4ea7a805b97cebae61b2f46c9f1129c 2x, https://si.imgix.net/74417a39/uploads/origins/3fb6a7c8-3742-4223-a9db-0f1664140b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2589a21c1a887d88cda9a6e98e7ba419 3x", "genre": "art", "nsfw": false, "body": "はじめまして♪ ギルティギアの「アリエルス」でOCを描いてほしいです！\n\nOCは一見任侠っぽく見えますが、実はかなりアンモラルで集中力がありません。眉毛の切れ込みと口の下のホクロに注目してください！\n「エーアリス」は冷静で高潔に見えるが、本当は劇的な人間嫌い。\nGGSTと書かれた外見に2人を描いてください！(アリルス」の後ろの檻の設定は無視してください笑）。\n二人ともGGXRDと書かれた登場人物で描いてください、よろしくお願いします！\n\nOCは「アリルス」を溺愛し、しばしば「アリルス」に執着する。OCの振る舞いを見ていると、「アリエルス」が存在するだけで、彼女の人生に意味があるかのようだ。\n「アリルス」はOCを自分勝手な愚か者と見ているが、それにもかかわらず、「アリルス」はOCのことをよく考えている自分に気づき、OCを少しずつ好きになっている。\n\nSCENE-1と書かれた画像の噴水でのロマンチックなシーンが欲しい。それ以外の構図はお任せします！\n\n足りなければ再送してください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1MOCR8aASxG2o5qZHoio2cZrzpNNZWQRg", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/11", "thumbnail_src": "https://si.imgix.net/fab46b34/uploads/origins/c8ee272e-e4ac-4e94-817f-8daf4c4392fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e51f95c1f61e921f188e2b9ccd09230", "thumbnail_srcset": "https://si.imgix.net/fab46b34/uploads/origins/c8ee272e-e4ac-4e94-817f-8daf4c4392fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e51f95c1f61e921f188e2b9ccd09230, https://si.imgix.net/fab46b34/uploads/origins/c8ee272e-e4ac-4e94-817f-8daf4c4392fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8a016edb360eae10cd3ffd9531074db 2x, https://si.imgix.net/fab46b34/uploads/origins/c8ee272e-e4ac-4e94-817f-8daf4c4392fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e82d6223b1042cb4c8f32c7437a8799 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ 「ハーゼル」のパートナー「ソング」を描いてください！ ガールズラブ（GL）感が強くて、お互いを甘やかしたり、愛情たっぷり！ あなたの見たいシチュエーションや衣装を描いてください！可能であれば、「ソング」が何らかの方法で「ヘイゼル」を誘惑するようにしてください。\n\nhttps://www.dropbox.com/sh/k49y11h9q99asrg/AACioS2Vqk8gnN1hlxEGxZlVa?dl=0\n\nhttps://www.dropbox.com/sh/2rcuixhg9bw824b/AABi4DtkRK3EQDRWmzfeTDJja?dl=0\n\nhttps://www.dropbox.com/sh/z7uz7rkv7hsp1fs/AACxqIlesJvPyKxC3tsMHfRBa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/10", "thumbnail_src": "https://si.imgix.net/a7a5fa4b/uploads/origins/a07e58a7-94a2-4921-92b0-a3ffe37c778c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6cbda6cc40f2b3aabfd5ab73289ddf8", "thumbnail_srcset": "https://si.imgix.net/a7a5fa4b/uploads/origins/a07e58a7-94a2-4921-92b0-a3ffe37c778c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6cbda6cc40f2b3aabfd5ab73289ddf8, https://si.imgix.net/a7a5fa4b/uploads/origins/a07e58a7-94a2-4921-92b0-a3ffe37c778c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8b36c14bf258f0f48864ec452faf065 2x, https://si.imgix.net/a7a5fa4b/uploads/origins/a07e58a7-94a2-4921-92b0-a3ffe37c778c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2ae029042c44c00ceb690f8614d6c61 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のオリジナル・キャラクターを2人お願いしたいのですが！\n\nライラ・モンテブランは、ちょっと不器用で浮気性だけど、大切な人を大切にする優しい若い女性。ライラはダンサーであり、アクロバットでもあり、その特技で人々を楽しませている。https://imgur.com/a/jhCliRo\n\nルシア・プリチャードは少し年上の女性だが、ライラとは正反対だ。ルシアはもう少し抜け目がなく秘密主義で、ダンサーやエンターテイナーとしての仕事と並行して、スパイや情報提供者でもある。ルシアはライラを妹のように慕い、しばしばライラをトラブルに巻き込まないようにしている。https://imgur.com/a/arHHncM\n\n二人のオリジナル衣装でも、二人に似合いそうな衣装でも描いてください！ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/9", "thumbnail_src": "https://si.imgix.net/6d45135d/uploads/origins/dfe24b74-c649-4b16-87bb-122552c84717?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=851ed4ac94f172209444f07748ceed73", "thumbnail_srcset": "https://si.imgix.net/6d45135d/uploads/origins/dfe24b74-c649-4b16-87bb-122552c84717?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=851ed4ac94f172209444f07748ceed73, https://si.imgix.net/6d45135d/uploads/origins/dfe24b74-c649-4b16-87bb-122552c84717?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69495f37b70169d7f3a4c366633fbfa2 2x, https://si.imgix.net/6d45135d/uploads/origins/dfe24b74-c649-4b16-87bb-122552c84717?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e9e59994e448069eea6a49a7f567ff9 3x", "genre": "art", "nsfw": false, "body": "たまお先生、こんにちは！\n最近描いていただいたイラスト、とても気に入っています！♥\n\nまたリクエストに応えてもらえたら嬉しいです。\n同じ2キャラ、OCとシャロンでお願いします！\n参考フォルダに添付されているローブを着て描いてください。 インナーランジェリーの追加は自由です！\n\nOCについて重要なことは\n-髪を耳の後ろで三つ編み\n-目は赤だが、青緑のハイライトがある。\n-左目の横に ほくろ \n-胸はぺったんこ\n-背中が見えている場合は、傷跡を描いてください\n\n参考リンク：https://drive.google.com/drive/u/2/folders/14HEFzl2CGQK7OhpfMoi1SHYjGBZjm9m-\n\nポーズが親密だといいですね！ロマンチックな雰囲気や少しセクシーな雰囲気があると嬉しいです。\n\nもしNGがあれば、再アピールやキャンセルをお願いします。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/8", "thumbnail_src": "https://si.imgix.net/03d249a0/uploads/origins/a05ec321-e0fa-4422-b6ff-373730aa05ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b37dcd12616501491ab27f10107445", "thumbnail_srcset": "https://si.imgix.net/03d249a0/uploads/origins/a05ec321-e0fa-4422-b6ff-373730aa05ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b37dcd12616501491ab27f10107445, https://si.imgix.net/03d249a0/uploads/origins/a05ec321-e0fa-4422-b6ff-373730aa05ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e398e077161c40b2435fe01df869114 2x, https://si.imgix.net/03d249a0/uploads/origins/a05ec321-e0fa-4422-b6ff-373730aa05ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51aa74c26ab6899740cef6235d88a899 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの画風と色使いが大好きです。私のFFXIVのキャラクター、アイリスを描いてくれたら嬉しいな。アイリスは気立てのいいお姉さんタイプで、スポーティでキュート、そして自分にとても自信があります。頬のハートに注目してください。\n\n髪型はストレートでもサイドポニーテールでも構いません。\n\nよろしくお願いします。\n\nhttps://sta.sh/2h093g7zrci", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/7", "thumbnail_src": "https://si.imgix.net/51ede8a7/uploads/origins/2c6035f0-4ddf-44a3-85e1-509bc1c746c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83fab60e8230c7d6db21051724a95b0", "thumbnail_srcset": "https://si.imgix.net/51ede8a7/uploads/origins/2c6035f0-4ddf-44a3-85e1-509bc1c746c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83fab60e8230c7d6db21051724a95b0, https://si.imgix.net/51ede8a7/uploads/origins/2c6035f0-4ddf-44a3-85e1-509bc1c746c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a50d6b6e8263687c15f7111c2151ec74 2x, https://si.imgix.net/51ede8a7/uploads/origins/2c6035f0-4ddf-44a3-85e1-509bc1c746c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19944648e300fdad637e6787d78dbcc5 3x", "genre": "art", "nsfw": false, "body": "はじめまして、たまお先生！\n先生の絵がとても好きで、リクエストさせていただきます。\nもしリクエストに抵抗があれば遠慮なくキャンセルしてください。\n\nGGSTのシャロンとOCを描いてくれませんか？\nかわいい系か、恋愛系が希望です！\n仲が良ければポーズやシチュエーションは自由です！(アイデアとしては、優雅なお茶会とか？）\n\nOCについて重要なことは\n-髪を耳の後ろで三つ編み\n-目は赤だが、青緑のハイライトがある。\n-左目の横にモグラ\n-胸はぺったんこ\n-背中が見えている場合は、傷跡を描いてください！\n\n参考リンク：https://drive.google.com/drive/u/2/folders/1gdvrs6lA4KoOWKEeW3gQvZ2leT1VVyNw\n\n何かNGな点があれば、遠慮なく再アピールやキャンセルを。\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/6", "thumbnail_src": "https://si.imgix.net/147833c4/uploads/origins/47c982ed-1d06-4bc0-bf7f-113c7a55f197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4852fd2ab09c73f0e0fc01aa7ace50d", "thumbnail_srcset": "https://si.imgix.net/147833c4/uploads/origins/47c982ed-1d06-4bc0-bf7f-113c7a55f197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4852fd2ab09c73f0e0fc01aa7ace50d, https://si.imgix.net/147833c4/uploads/origins/47c982ed-1d06-4bc0-bf7f-113c7a55f197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e11bd8c70b4be916618b4e69682e166 2x, https://si.imgix.net/147833c4/uploads/origins/47c982ed-1d06-4bc0-bf7f-113c7a55f197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be81f854d7263c979769867d6b13629b 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！ジュリとメナトのデートイラストをリクエストしてもいいですか？お好きな衣装でお願いします～。", "created_at": "", "completed_at": ""}, {"path": "/@tamao_no_ta/works/5", "thumbnail_src": "https://si.imgix.net/b19e8118/uploads/origins/783d33ca-0d06-45ce-bb3f-63c24ba80c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b84ab035fd3206392717a9a0853060", "thumbna