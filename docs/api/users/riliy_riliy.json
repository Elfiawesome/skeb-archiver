9-4bb8-abee-11d3759df363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8493882d76cf34d637b01108684018e", "thumbnail_srcset": "https://si.imgix.net/2610d9e5/uploads/origins/291f6bfc-54e9-4bb8-abee-11d3759df363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8493882d76cf34d637b01108684018e, https://si.imgix.net/2610d9e5/uploads/origins/291f6bfc-54e9-4bb8-abee-11d3759df363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a96c78a56dfc864e1030b9512b95bf1 2x, https://si.imgix.net/2610d9e5/uploads/origins/291f6bfc-54e9-4bb8-abee-11d3759df363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92c0ef0c07a838356abe0111b862e018 3x", "genre": "art", "nsfw": true, "body": "納品期限を超過していましたので再送します。\n\nRen Riliyさんこんにちは。天使羽ニアちゃんのイラストありがとうございました！ \nキャラクターは前回に引き続き天使羽ニアちゃん(褐色)、衣装は前回と同じ水着でお願いします。 \n\n希望のポーズ \n・座りポーズで、背中と足裏が見える構図でお願いします。 \nもしくは前回のイラストの姿勢の後ろから見た構図。 \n・後ろを振り返って上半身の膨らみが横から見える\n・手指で輪を作り、開けた口の前に置いて舌を出している感じでお願いします \n\n背中側から見えるほくろをRen Riliy先生のフェチに従って描き込んでほしいです。 \n髪と翼は背中が見えるよういい感じにアレンジもらいたいです。 \n\n表情差分、セリフ付き、水着の布面積、日焼けあと、汗や水滴あり、通常カラーなどの差分も可能でしたら作成お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@riliy_riliy/works/6", "thumbnail_src": "https://si.imgix.net/5a551d13/uploads/origins/d29902eb-42be-43f5-8791-2d0d121313c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b12fdfd367b2f14cce6f14d12c6a642", "thumbnail_srcset": "https://si.imgix.net/5a551d13/uploads/origins/d29902eb-42be-43f5-8791-2d0d121313c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b12fdfd367b2f14cce6f14d12c6a642, https://si.imgix.net/5a551d13/uploads/origins/d29902eb-42be-43f5-8791-2d0d121313c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=163127dc8c90fa95da68b0e50e92f8be 2x, https://si.imgix.net/5a551d13/uploads/origins/d29902eb-42be-43f5-8791-2d0d121313c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=042a8a2358508fea43f619c911db388a 3x", "genre": "art", "nsfw": true, "body": "Ren Riliyさんこんにちは。天使羽ニアちゃんのイラストありがとうございました！ \n\nキャラクターは前回に引き続き天使羽ニアちゃん(褐色)\n衣装は牛柄ビキニ(サイハイブーツ、アームカバー付き)でお願いします\n\nポーズは頭の後ろで手を組んでいる腋見せのポーズ\nおへそが見える構図だと助かります\n\nその他の要素はお任せいたします\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@riliy_riliy/works/5", "thumbnail_src": "https://si.imgix.net/85570079/uploads/origins/8ab93b45-1f5e-4a66-9e84-5a31e34fc257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=107dd8f28b50c615a08429848be6f5ae", "thumbnail_srcset": "https://si.imgix.net/85570079/uploads/origins/8ab93b45-1f5e-4a66-9e84-5a31e34fc257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=107dd8f28b50c615a08429848be6f5ae, https://si.imgix.net/85570079/uploads/origins/8ab93b45-1f5e-4a66-9e84-5a31e34fc257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fe05f18b20f61dc04d76f5d80c1f71b 2x, https://si.imgix.net/85570079/uploads/origins/8ab93b45-1f5e-4a66-9e84-5a31e34fc257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d124000f1169a016897132ab0c97eb6 3x", "genre": "art", "nsfw": false, "body": "Ren Riliyさんこんにちは！リピート依頼失礼します\n\nキャラクター\n前回に引き続き、\n褐色の天使羽ニアちゃん（水着）水着のデザインはお任せします！\n・ピアス追加、タトゥーの追加なども大丈夫です！\n\n\n希望ポーズ\n\n・紙タバコで喫煙中\n・参考URLの記事のトップ画像のように胸にスマホを乗せる\n\n希望シチュエーション\n\n・スマホ画面に写されている動画には、ニアちゃんと知らない男性が2人で映っている。\n※この男性との交際で煙草を始めたりギャルになってしまったというイメージ、チャラ男っぽいイメージでお願いします\n\n・スマホ動画内のニアちゃんの服装は前回か前々回の水着でお願いします\n・仲良さげにスキンシップを取っているお部屋デートムービー、構図はお任せします\n\n動画の進行が進んでいるようなイメージで、スマホ画面と表情の変化を差分にてお願いします\n\n・動画を全部見たい視点人物をからかっているような表情\n・軽蔑したような冷たい表情\n\nhttps://nlab.itmedia.co.jp/cont/articles/3260173/", "created_at": "", "completed_at": ""}, {"path": "/@riliy_riliy/works/4", "thumbnail_src": "https://si.imgix.net/2819a2b3/uploads/origins/eae11c9f-5867-4932-a8dd-851308d886cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4538c699efe48608005e68dc9cd4456", "thumbnail_srcset": "https://si.imgix.net/2819a2b3/uploads/origins/eae11c9f-5867-4932-a8dd-851308d886cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4538c699efe48608005e68dc9cd4456, https://si.imgix.net/2819a2b3/uploads/origins/eae11c9f-5867-4932-a8dd-851308d886cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02cad4560be7abb9ebd30ebf68479e7f 2x, https://si.imgix.net/2819a2b3/uploads/origins/eae11c9f-5867-4932-a8dd-851308d886cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b1666a48347af009e8c68db77aa4a91 3x", "genre": "art", "nsfw": false, "body": "Ren Riliyさんこんにちは。天使羽ニアちゃんのイラストありがとうございました。\nリピート依頼をさせていただきます。\n\n　キャラクター\n褐色の天使羽ニアちゃん（水着）\n水着のデザインは、資料URL先のようなギャルっぽい豹柄でお願いしたいです。\nへそピアス付き\n肌はテカリ強めでお願いしたいです。\n\n　希望のイメージ\nニアちゃんが動画を見せてくれる。反応を見てからかっている\n\n　希望のポーズ\n・ベッドに寝転がっているポーズ。\n・おへそ上くらいまででも大丈夫です。\n\n・胸と鎖骨の間あたりに横向きスマホを置いてスマホ画面で動画を見せつけている。\n\n・肘を曲げて両腕で胸を抱え込み、両手指で胸上のスマホを軽く抑えている。（胸下のほくろが隠れずに見えるようにお願いします）\n\n・スマホ画面の動画の１シーンにはニアちゃんと知らない男性が映っている。（男性はチャラ男っぽい目が髪で隠れた感じでお願いします）\n\n　表情\n①照れている風（演技）\n②からかっている、意地悪っぽい表情\n③　②の表情で舌をぺろっと出している\n\nhttps://www.pixiv.net/artworks/126423112", "created_at": "", "completed_at": ""}, {"path": "/@riliy_riliy/works/3", "thumbnail_src": "https://si.imgix.net/b98d2072/uploads/origins/5bfdd9e4-4084-4564-8149-203f8f7f025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b31bcce80d19f2d1e08a8d5cb31236f", "thumbnail_srcset": "https://si.imgix.net/b98d2072/uploads/origins/5bfdd9e4-4084-4564-8149-203f8f7f025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b31bcce80d19f2d1e08a8d5cb31236f, https://si.imgix.net/b98d2072/uploads/origins/5bfdd9e4-4084-4564-8149-203f8f7f025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=381c1de82dcdcc13589cc5edfc781ac8 2x, https://si.imgix.net/b98d2072/uploads/origins/5bfdd9e4-4084-4564-8149-203f8f7f025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=473dc4c116fd68acd3995fd49ac83660 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@riliy_riliy/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1780470193854296064%2FAcEktQV8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34beccc880538e15b515d994484011ef", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1780470193854296064%2FAcEktQV8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34beccc880538e15b515d994484011ef, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1780470193854296064%2FAcEktQV8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8658ab76bf1f171ab30b9a6cb32395a2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1780470193854296064%2FAcEktQV8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c7964193e863746f148f98f06213c3 3x", "genre": "voice", "nsfw": false, "body": "Ren Riliyさんこんにちは！\n今回は、ボイスジャンルにてリクエストを送信させていただきます。\nボイス収録していただきたいシチュエーションを用意してきましたので、よろしくお願いします！！ \n\n以下希望のシチュエーション \n\n・ゲーム友達(男)とボイスチャット・通話をよくしていることに対して嫉妬してしまう彼。\n\n・しかし、怒るでもなくしつこく聞きたがる彼の態度から、実は彼にそういった癖(NTR癖)があるとわかり、過去の経験談を話してほしいと迫られ、渋々要望に応えるために他の異性たちとのエピソードを話してあげるシチュエーション音声をお願いします。(内容はお任せします) \n\n・話していくうちに聞き手の反応が面白く、乗ってきてしまい、彼(聞き手)が初彼氏だと言っていたことに矛盾が生じ始めたり、過去にたくさん遊んでいたことをカミングアウトし出したりどんどん不穏な流れになっていき、今現在、それらの男性関係は既に無く(現在浮気はしてないが)、これらの話は全て過去のことだと分かりつつも悔しくて心がザワザワしている彼に対してあまあまなセリフをかけてENDという感じでお願いします。\n \n・話している途中で「大丈夫？辛くない？」や「聞いて後悔しない？」「私のこと嫌いになったりしない？」など確認を入れてほしいです。 \n途中からは「どうだと思う？」「この後どうなったと思う？」など焦らして妄想を掻き立ていじわるする感じでお願いします。\n\n・最初は乗り気ではなく、聞きたがっているから嫌々語っているが、後々反応が面白くなってきて、焦らしや囁きで緩急つけつつ最後はあまあまになる感じでお願いします。\n(途中で聞き手から主導権を奪うイメージです)\n\n 特殊なシチュエーションで再現が難しいと思いますが何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@riliy_riliy/works/1", "thumbnail_src": "https://si.imgix.net/cd5b3132/uploads/origins/fdf4e252-6fb6-43d2-b61a-0a5d097764ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85252e470ae1bf5b355a846fa88e9e98", "thumbnail_srcset": "https://si.imgix.net/cd5b3132/uploads/origins/fdf4e252-6fb6-43d2-b61a-0a5d097764ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85252e470ae1bf5b355a846fa88e9e98, https://si.imgix.net/cd5b3132/uploads/origins/fdf4e252-6fb6-43d2-b61a-0a5d097764ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a208a8e29afc456cb53457664016371e 2x, https://si.imgix.net/cd5b3132/uploads/origins/fdf4e252-6fb6-43d2-b61a-0a5d097764ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d732dcd9b9b18460b7e70aebf2f9c40 3x", "genre": "art", "nsfw": false, "body": "いつぞやの配信で褐色の天使羽ニアちゃんがめちゃくちゃ好みだったので褐色の天使羽ニアちゃんのイラストをお願いします\n\n・衣装\n金ビキニ\nへそピアス\n\n・イラストの雰囲気\nギャルっぽい\nおへそをピースで広げている\n\n口元と脚以外のほくろの位置(通常衣装で隠れていた箇所)はお任せでお願いします\n可能であれば水着用のほくろの設定図も付けていただけると助かります\n\n褐色じゃない通常カラーの差分もあると嬉しいです", "created_at": "", "completed_at": ""}]}