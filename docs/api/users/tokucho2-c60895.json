23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5864f4d6f4f18e2465fd12ab21b6de3, https://si.imgix.net/fff6337c/uploads/origins/53dd9036-689a-409b-88c5-e00a29c9cb95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e10b8313e38ae6a8fef3c41a0b052eb 2x, https://si.imgix.net/fff6337c/uploads/origins/53dd9036-689a-409b-88c5-e00a29c9cb95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b971b0699db6b4a14e05417e0f4f4f49 3x", "genre": "art", "nsfw": false, "body": "ちこはゲーセン一番星のメンバーがクレーンゲームでおのぼりたんを取ろうとしている描写をお願いします。メンバーに気づかれないようにいろんなしろたんのお友達が陰からそっと救出してくれるのを見守ってる的な。\n（チコゲーはとても大好きな作品でした。今クレーンゲームが大流行してるのでゲーセン漫画？のチコゲーをまた見たいです。）\nしろたんの二次創作がoutでしたらそれっぽい可愛いぬいぐるみに変更でも大丈夫です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tokucho2/works/13", "thumbnail_src": "https://si.imgix.net/45baa2ce/uploads/origins/537f25f1-48b1-4e92-8de7-05d3293fe0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb22be0be78c8051263b5cdae110096d", "thumbnail_srcset": "https://si.imgix.net/45baa2ce/uploads/origins/537f25f1-48b1-4e92-8de7-05d3293fe0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb22be0be78c8051263b5cdae110096d, https://si.imgix.net/45baa2ce/uploads/origins/537f25f1-48b1-4e92-8de7-05d3293fe0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0bfe77768fa04e58d30762b25cbb6f6 2x, https://si.imgix.net/45baa2ce/uploads/origins/537f25f1-48b1-4e92-8de7-05d3293fe0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04b3b1f661d18c491e00c94d05c25965 3x", "genre": "art", "nsfw": true, "body": "恋姫無双シリーズの孫尚香が寝てて、夢の中でロリ爆乳になってビキニ姿で見せつけるポーズをとっているイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tokucho2/works/12", "thumbnail_src": "https://si.imgix.net/dfe30667/uploads/origins/1100b942-6d5b-41a0-93e1-657a292dfa8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bcc97d51f5e2399f69fa88ed3538840", "thumbnail_srcset": "https://si.imgix.net/dfe30667/uploads/origins/1100b942-6d5b-41a0-93e1-657a292dfa8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bcc97d51f5e2399f69fa88ed3538840, https://si.imgix.net/dfe30667/uploads/origins/1100b942-6d5b-41a0-93e1-657a292dfa8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e20a9c24543ce3a0cbe0ad1858fa00cf 2x, https://si.imgix.net/dfe30667/uploads/origins/1100b942-6d5b-41a0-93e1-657a292dfa8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a70f71417421eea90793606da0553b4 3x", "genre": "art", "nsfw": true, "body": "「窓香さんの天然なゆーわく」に登場する窓香ちゃんが田上くんと悟くんと一緒にお風呂に入ってるときに二人の目の前で自慢気に自分で自分のおっぱいを吸って見せる絵をリクエストしてもよろしいでしょうか。\n\n希望する主な要素と内容は・・・\n・片方の手で片方のおっぱいを自分の口元まで寄せ、自分の乳首を丸ごと咥えながら自分のおっぱいを吸う\n・胸には唾液が少し垂れている\n・もう片方の手でもう片方のおっぱいを持ち上げる（乳首晒しがNGの場合、指一本か二本で乳首を隠し、乳輪がはみ出ている感じでお願いします）\n\n状況に合った台詞や擬音も入れて頂けたら嬉しいです。\n\nご検討のほど宜しくお願い致します。\n\n参考URL:\nセルフ乳吸い\nbit.ly/3E6GxqF\nbit.ly/3WV0SaR\nbit.ly/3EoWZ6S", "created_at": "", "completed_at": ""}, {"path": "/@tokucho2/works/11", "thumbnail_src": "https://si.imgix.net/8812cd05/uploads/origins/c61b333d-4b16-4138-86c1-c31a131069ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1adcde419ea632f6b98085811fffb8a7", "thumbnail_srcset": "https://si.imgix.net/8812cd05/uploads/origins/c61b333d-4b16-4138-86c1-c31a131069ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1adcde419ea632f6b98085811fffb8a7, https://si.imgix.net/8812cd05/uploads/origins/c61b333d-4b16-4138-86c1-c31a131069ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=323954cecb8dc9736881f93b8091700e 2x, https://si.imgix.net/8812cd05/uploads/origins/c61b333d-4b16-4138-86c1-c31a131069ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fd7203d358055aacdee347b13fdcfe4 3x", "genre": "art", "nsfw": false, "body": "とく村長先生\n\n「窓香さんの天然なゆーわく」の窓香ちゃんの下着姿のイラストをお願いします。\nシチュエーションは、またおっぱいが大きくなったので新しく買った下着を着用して見せてくれて、何カップでアンダーが何センチのブラなのか教えてくれるというものです。\n下着は上下おそろいで明るい色。少し大人っぽい。\n恥ずかしがったり誘惑したりする感じではなく、無邪気に胸の大きさをアピールする感じでお願いします。ブラのサイズも「よくわかってないけど、お店の人が言ってた数字をそのまま言ってる」感じです。\n\nよろしくおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@tokucho2/works/10", "thumbnail_src": "https://si.imgix.net/0ec3d0f3/uploads/origins/cf94afe7-5678-42cd-b75d-3561fd8ca0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaad8c478e589b7868a26fa2648bb06c", "thumbnail_srcset": "https://si.imgix.net/0ec3d0f3/uploads/origins/cf94afe7-5678-42cd-b75d-3561fd8ca0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaad8c478e589b7868a26fa2648bb06c, https://si.imgix.net/0ec3d0f3/uploads/origins/cf94afe7-5678-42cd-b75d-3561fd8ca0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=456f44a4423ee5767df5d96ce3ff5862 2x, https://si.imgix.net/0ec3d0f3/uploads/origins/cf94afe7-5678-42cd-b75d-3561fd8ca0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d190de1c8291d04ff72860d1316dd433 3x", "genre": "art", "nsfw": true, "body": "とく村長たん(しろたん刑事純情派)様\n\n寝室こもるのイラストをご依頼出来ないでしょうか\n\n【キャラ】\n寝室こもる\n立ち絵はグーグルドライブの寝室こもるをご覧ください。\n\nグーグルドライブにとく村長たん様用構図参考をご用意いたしました。\n軽い首絞めプレイで目にハートで気持ち良さそうな表情。\n顔や体には精液にまみれており\n正上位で挿入されていて奥へ中出しされていて溢れている描写\nご検討の程、どうかよろしくお願い致します。\n\n立ち絵が3種類ありますが、どの立ち絵かはお任せ致します。\n\nご検討の程、どうかよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1PrXM1eAfJWnsfb58DGm8YqGflf5q-WLt?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tokucho2/works/9", "thumbnail_src": "https://si.imgix.net/d6c833c8/uploads/origins/079c4917-d0b1-4e43-9b92-802f1a646107?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30207f6f2516227f0d0b0d4cb4e9d3b", "thumbnail_srcset": "https://si.imgix.net/d6c833c8/uploads/origins/079c4917-d0b1-4e43-9b92-802f1a646107?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=