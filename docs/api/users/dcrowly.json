0/uploads/origins/16ca37f4-4c09-42b7-bfb9-8b27b61f85ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4890197527823fa8b3236997709444d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dcrowly/works/35", "thumbnail_src": "https://si.imgix.net/721cd379/uploads/origins/87008790-68f7-4d32-96e5-92060813eeb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdab0f85c35823f614465d557f91cf8f", "thumbnail_srcset": "https://si.imgix.net/721cd379/uploads/origins/87008790-68f7-4d32-96e5-92060813eeb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdab0f85c35823f614465d557f91cf8f, https://si.imgix.net/721cd379/uploads/origins/87008790-68f7-4d32-96e5-92060813eeb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad027c3187285d76188fc1339fadfcc5 2x, https://si.imgix.net/721cd379/uploads/origins/87008790-68f7-4d32-96e5-92060813eeb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14375b47d63e9049b896061149235724 3x", "genre": "art", "nsfw": true, "body": "くろうり先生はじめまして！\nもともと先生のおっぱいの描き方や体つきの描き方がとても好きでしたので、先生のところの抱き枕イラスト（https://skeb.jp/@dcrowly/works/30等）を拝見しまして、もしよろしければ個人的に鑑賞する目的でのうちのこの抱き枕イラストも描いていただければ……と思い依頼させていただきました！\n\n全身図はこちら（https://drive.google.com/file/d/1v783tkGfUZtKMWKhzqLidVJdOC0YI6Wo/view?usp=sharing）で、脱衣時の衣装の雰囲気はこちら（https://drive.google.com/file/d/1172U-49Er_CCh4hAsaBj_Y7EncTsmkCW/view?usp=sharing）のような感じです。\n\n明るくはつらつとしたタイプの子ですが、だからこその気持ち若干股を開いて見せ付けようとしているような雰囲気にしていただけたらと思います。表情の一つに恥らってしおらしくなっているようなものがあればと思います。\n\nパターンとしては着衣・半脱ぎ・全脱ぎのものがあればいいなと思っています。\n陰毛なしで大丈夫です。納品はpsdで、可能であれば着せ替えできる状態になっていればなと思います。\n\nその他のポージングや表情に関してはお任せしたいと思います！先生の解釈でうちのこをえっちに描いてくれればと思います！よろしくお願いします！\n\nhttps://drive.google.com/file/d/1t-Lm6CLmXHN10eJol1JvsmAtrkGc_VNw/view?usp=sharing", "created_at": "", "completed_at": "