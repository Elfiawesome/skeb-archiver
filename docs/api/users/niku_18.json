5-4742-91eb-f09b6749debc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f214298868d646d0dc782f405aaf6a88 2x, https://si.imgix.net/55d40991/uploads/origins/06d12468-2685-4742-91eb-f09b6749debc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5194bfe74c0eb18c6a832ba318f9af6 3x", "genre": "art", "nsfw": true, "body": "一人称視点に近いお尻の穴と性器、男性臭、性器勃起、亀頭露出(体の色は赤)、後ろの穴は真っ黒。少し圧迫感があった方がいい。私のocの画像アドレ：https://x.com/Earth_Garon23/status/1903047222369124365\nhttps://x.com/Earth_Garon23/status/1895259527341318584\nhttps://x.com/Earth_Garon23/status/1898416179695493431", "created_at": "", "completed_at": ""}, {"path": "/@niku_18/works/27", "thumbnail_src": "https://si.imgix.net/150c1ba5/uploads/origins/2a9ca670-4ca9-4a0c-8875-f0205c2e5b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc18930b444863262f25213ac647b057", "thumbnail_srcset": "https://si.imgix.net/150c1ba5/uploads/origins/2a9ca670-4ca9-4a0c-8875-f0205c2e5b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc18930b444863262f25213ac647b057, https://si.imgix.net/150c1ba5/uploads/origins/2a9ca670-4ca9-4a0c-8875-f0205c2e5b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3032db94074f486aca95bb7d6b37000c 2x, https://si.imgix.net/150c1ba5/uploads/origins/2a9ca670-4ca9-4a0c-8875-f0205c2e5b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7d37d651ae04d645cddf3795fd9488c 3x", "genre": "art", "nsfw": true, "body": "いつも素敵な肉体美のイラストを楽しみにしています。\n\n肉良獣八様のイラストでどうしても見てみたいシチュエーションがあり今回の依頼を決意しました。\n\nキャラクター、放課後サモナーズのアルスラーン、レイヴ、魂これの相馬の誰か1人（肉良獣八様の好きなキャラを選んでいただけると嬉しいです）\n\nシチュエーション、ローアングルから見上げるような画角で決めていただいたキャラクターがモブの顔面を踏み締めて加虐心のある顔で見下ろしながらオナニーしている\n\n入れていただけると嬉しいポイント、足フェチなので踏み付ける脚に力強さを感じる、踏まれてるモブが顔面が軋むくらいの力で踏まれていて退かそうと無駄な抵抗をしている、デカマラの３つになります。\n\n普段2次創作のイラストを拝見しないので受けていただけるか不安ですが、ご検討いただけると幸いです。\n\nまた寒くなってきましたが体調に気を付けて活動なと頑張ってください。", "created_at": "", "completed_at": ""}, {"path": "/@niku_18/works/26", "thumbnail_src": "https://si.imgix.net/1b893273/uploads/origins/81e772c7-3e61-4761-9d5d-2cadcfa0f84e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ddd05f8a6a2bc116df148d8bb3fd9a", "thumbnail_srcset": "https://si.imgix.net/1b893273/uploads/origins/81e772c7-3e61-4761-9d5d-2cadcfa0f84e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ddd05f8a6a2bc116df148d8bb3fd9a, https://si.imgix.net/1b893273/uploads/origins/81e772c7-3e61-4761-9d5d-2cadcfa0f84e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=849c66a6145b55b1c8f59650d0c08511 2x, https://si.imgix.net/1b893273/uploads/origins/81e772c7-3e61-4761-9d5d-2cadcfa0f84e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f04f1d136632bb016942d35e4cf1d28 3x", "genre": "art", "nsfw": false, "body": "\"戒\"は地下組織のボスです，彼はMellivora capensisです。\n\n上半身は裸で、鬼のズボン（オレンジ色に黒の縞模様）を履いています。\n\n彼はメイスを後ろに抱えながら、自信に満ちた笑みを浮かべた。\n\n背景部分に関してはご自由に遊んでいただければと思います。\n\nhttps://www.photolibrary.jp/img379/277685_3555809.html (鬼のズボン)\n\nhttps://x.com/TigerWolf_Xlll/status/1886801539370721329 (戒-Kai)\n\nhttps://www.mokura.com.tw/products/m23090502 (ポーズのサンプル)", "created_at": "", "completed_at": ""}, {"path": "/@niku_18/works/25", "thumbnail_src": "https://si.imgix.net/35f2074c/uploads/origins/373f6cf6-414e-4cc5-a561-7b78bccc8d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9322af25a5d54bb26e3fed30d70286", "thumbnail_srcset": "https://si.imgix.net/35f2074c/uploads/origins/373f6cf6-414e-4cc5-a561-7b78bccc8d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9322af25a5d54bb26e3fed30d70286, https://si.imgix.net/35f2074c/uploads/origins/373f6cf6-414e-4cc5-a561-7b78bccc8d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=322cc4370c06d8e892958e10d61141a7 2x, https://si.imgix.net/35f2074c/uploads/origins/373f6cf6-414e-4cc5-a561-7b78bccc8d86?b