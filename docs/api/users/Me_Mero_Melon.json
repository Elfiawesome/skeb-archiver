OCの扱いに関しては全てmelonさんにお任せします。描くも描かないもmelonさんの自由です。勿論melonさんのOCでも大変喜びます‼️気軽に描いて頂けると幸いです。\n\nhttps://lit.link/haydenmcmaster", "created_at": "", "completed_at": ""}, {"path": "/@Me_Mero_Melon/works/191", "thumbnail_src": "https://si.imgix.net/faf30c1d/uploads/origins/d1c5bbea-ad75-4481-a04b-b3641f02857c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcc9ad5a58039c124b4949b0612b40f3", "thumbnail_srcset": "https://si.imgix.net/faf30c1d/uploads/origins/d1c5bbea-ad75-4481-a04b-b3641f02857c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcc9ad5a58039c124b4949b0612b40f3, https://si.imgix.net/faf30c1d/uploads/origins/d1c5bbea-ad75-4481-a04b-b3641f02857c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c2b959be11ed1a64a0e93f621549e91 2x, https://si.imgix.net/faf30c1d/uploads/origins/d1c5bbea-ad75-4481-a04b-b3641f02857c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03249464c3dd36fa36be5152b42bbdae 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Me_Mero_Melon/works/190", "thumbnail_src": "https://si.imgix.net/5b7743c2/uploads/origins/1747b433-ba67-40ae-bf1d-cc4a4cd5c683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63feb10a1c4d4f64399532e5b31a3954", "thumbnail_srcset": "https://si.imgix.net/5b7743c2/uploads/origins/1747b433-ba67-40ae-bf1d-cc4a4cd5c683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63feb10a1c4d4f64399532e5b31a3954, https://si.imgix.net/5b7743c2/uploads/origins/1747b433-ba67-40ae-bf1d