574_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe904771d0ef96d07f071fbfc717fa47 2x, https://si.imgix.net/62d5098d/requests/230574_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be964958edb115ebd1f6193e58a45757 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you 塩街teacher!\n\nI love 塩街teacher's art style and would love a new clothing design for my original character.\nI would like something traditional with a little bit of China-like design! I provided some references for ideas but I will leave everything to 塩街teacher's imagination! I would like the colour red to be incorporated into the outfit! If possible, I would also like accessories in her hair and a fan! \n\nI will be happy with anything!!\nよろしくお願いいたします！\n\nhttps://app.box.com/s/ohdmbbaxzbbdcuqbyo1d6u6g69145hxh", "created_at": "", "completed_at": ""}, {"path": "/@shio_666/works/13", "thumbnail_src": "https://si.imgix.net/7fb20fef/requests/187400_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1ac6fff0713c1ac56f1d55d70cb816", "thumbnail_srcset": "https://si.imgix.net/7fb20fef/requests/187400_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1ac6fff0713c1ac56f1d55d70cb816, https://si.imgix.net/7fb20fef/requests/187400_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67f6af067091d215c433d630e3a4d3ab 2x, https://si.imgix.net/7fb20fef/requests/187400_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac75e00a0a39bfa76c427e0b0c3a70c5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートが大好きです!\n\n私のキャラクターをダイナミックなポーズで描いてもらえませんか？ゲームとうどんとオオカミと桜が大好きな子です!\n\nhttps://imgur.com/a/pW4Go4C", "created_at": "", "completed_at": ""}, {"path": "/@shio_666/works/12", "thumbnail_src": "https://si.imgix.net/57963030/requests/154343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eb6b0853aec224c77d8f363d99