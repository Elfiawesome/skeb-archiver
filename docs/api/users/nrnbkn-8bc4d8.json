ix.net/7bc3c9bf/uploads/origins/5529fb09-a5b9-49a3-b94b-91b0b0f4bff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c463f337171bc795761950eff61a470b, https://si.imgix.net/7bc3c9bf/uploads/origins/5529fb09-a5b9-49a3-b94b-91b0b0f4bff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5465adf197fc602969bcf63a69f47e1 2x, https://si.imgix.net/7bc3c9bf/uploads/origins/5529fb09-a5b9-49a3-b94b-91b0b0f4bff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b077af17d9e2b73f521c6c91d7b918b2 3x", "genre": "art", "nsfw": true, "body": "兜合わせでチンコ比べしている男体化（女装）輝夜と男体化妹紅のイラストをお願いします。\n\n細かいポーズ等や、どちらのサイズが大きいのかはおまかせします。\n男体化が難しければ、ふたなりでも構いません。\n\n難しければ別のリクエストを考えるので、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nrnbkn/works/6", "thumbnail_src": "https://si.imgix.net/d40030bd/uploads/origins/768ab593-3e0d-4f0f-b447-85e0ff454edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4fc296883f8d8170e243e386d3b3ad5", "thumbnail_srcset": "https://si.imgix.net/d40030bd/uploads/origins/768ab593-3e0d-4f0f-b447-85e0ff454edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4fc296883f8d8170e243e386d3b3ad5, https://si.imgix.net/d40030bd/uploads/origins/768ab593-3e0d-4f0f-b447-85e0ff454edc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37fc627fdbc5c9b5ee6369287ce95439 2x, https://si.imgix.net/d40030bd/uploads/origins/768ab593-3e0d-4f0f-b447-85e0ff454edc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07101570efa88554b8de68fcfd1aaed0 3x", "genre": "art", "nsfw": false, "body": "河城にとりをお願いします\n\n表情は元気な感じの笑顔\n服は旧タイプのスクール水着、トレードマークの帽子はそのままで\n（リュックは無くて大丈夫です）\n絵柄はいつも通りのリアル寄りで、子どもらしさをのこした感じで可愛らしく\n\n可能なら、川辺の背景があると嬉しいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@nrnbkn/works/5", "thumbnail_src": "https://si.imgix.net/09ac5061/uploads/origins/e4042416-9f2e-4d3b-804c-33531d468028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b14e9ad7ab6672a20fe8ae924517f891", "thumbnail_srcset": "https://si.imgix.net/09ac5061/uploads/origins/e4042416-9f2e-4d3b-804c-33531d468028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b14e9ad7ab6672a20fe8ae924517f891, https://si.imgix.net/09ac5061/uploads/origins/e4042416-9f2e-4d3b-804c-33531d468028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2761760496524a011b2dda8c54d9545 2x, https://si.imgix.net/09ac5061/uploads/origins/e4042416-9f2e-4d3b-804c-33531d468028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51a176298c90b7a79b6c9898a1bad2ce 3x", "genre": "art", "nsfw": true, "body": "こんにちは！東方Projectの男体化キャラが好きです！男体化霊夢とアリスのNSFWセックスアートをお願いしたいです。霊夢が上で、アリスが下です。ポーズは自由です。アリスは服を着ていますが、パンツは下げています。射精の瞬間が映し出されます。", "created_at": "", "completed_at": ""}, {"path": "/@nrnbkn/works/4", "thumbnail_src": "https://si.imgix.net/37aed59e/uploads/origins/c7aa5763-e8d9-4513-8f53-bb686890664b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ccf326057288653570140930f93a450", "thumbnail_srcset": "https://si.imgix.net/37aed59e/uploads/origins/c7aa5763-e8d9-4513-8f53-bb686890664b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ccf326057288653570140930f93a450, https://si.imgix.net/37aed59e/uploads/origins/c7aa5763-e8d9-4513-8f53-bb686890664b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=114e6976a4cad5b60867a64ad67e6b72 2x, https://si.imgix.net/37aed59e/uploads/origins/c7aa5763-e8d9-4513-8f53-bb686890664b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=609b31a47a0480f25fd4c6d984b3888a 3x", "genre": "art", "nsfw": false, "body": "可愛い服を着せたいという旨のツイートを拝見して、逆にダサい服を着せてどこまで行けるかを見てみたくなってしまいまして、リクエストをお送りさせていただきます。\nお題箱くらいの気持ちで投げているので、気が向かなかったら放置して頂いて問題ありません。\n\n⚫︎魔理沙（少女でも男体化でもどちらでも可）\n⚫︎女性の服装の場合（ダサい服と書いたのですが）具体的なイメージがないので、URLを参考に自由に描いていただきたいです。意味不明なTシャツ一枚でもいいです。\n\nhttps://togetter.com/kiji/2015/08/22/26949\n\nhttps://renote.net/articles/4945\n\n⚫︎男体化の場合、テンプレオタクファッション\nhttps://www.upgrade-fashion.com/college-student-clothes-nerd/\n\nhttps://shunguitar.com/otaku-fushion-classic/\n\n本当に気が向いたらで大丈夫です。\n\nhttps://togetter.com/kiji/2015/08/22/26949", "created_at": "", "completed_at": ""}, {"path": "/@nrnbkn/works/3", "thumbnail_src": "https://si.imgix.net/1adc11ec/uploads/origins/a2540f4f-bde3-49b0-8dbb-7de3d41877b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1fdc4552ceed8dd24dc32978902ce1", "thumbnail_srcset": "https://si.imgix.net/1adc11ec/uploads/origins/a2540f4f-bde3-49b0-8dbb-7de3d41877b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1fdc4552ceed8dd24dc32978902ce1, https://si.imgix.net/1adc11ec/uploads/origins/a2540f4f-bde3-49b0-8dbb-7de3d41877b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39fe4c9469930052f73e6fc28d1be69f 2x, https://si.imgix.net/1adc11ec/uploads/origins/a2540f4f-bde3-49b0-8dbb-7de3d41877b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e2aae9a4bde496b2845dfccca4b90d5 3x", "genre": "art", "nsfw": false, "body": "のれさんこんにちは。\n今回は前回と異なり、デフォルメ？ゆるめ？の描き方のイラストをお願いしたくリクエストさせて頂きます！\n\nキャラクター：東方project  チルノ\nシーンや構図など：初夏、夏関連だと嬉しいですが、お時間取ってしまう場合はなんでも構いません。\n画風？：デフォルメ、ゆるめのイラスト希望です。\nその他記載していないものは全てお任せ致します。\nなお、skebの通常想定されている鑑賞等以外の使用目的はありません。\nご検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nrnbkn/works/2", "thumbnail_src": "https://si.imgix.net/8c94d6a6/uploads/origins/827a3053-c49e-44ee-9118-c91f0e552fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581240367e5bf356aff2596db874fcbf", "thumbnail_srcset": "https://si.imgix.net/8c94d6a6/uploads/origins/827a3053-c49e-44ee-9118-c91f0e552fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581240367e5bf356aff2596db874fcbf, https://si.imgix.net/8c94d6a6/uploads/origins/827a3053-c49e-44ee-9118-c91f0e552fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cd44957257f0284ecd4411124c211e7 2x, https://si.imgix.net/8c94d6a6/uploads/origins/827a3053-c49e-44ee-9118-c91f0e552fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f7146192afccc833624c1b03e44c084 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n是非のれさんに萃香ちゃんを描いて頂きたいです！希望のテーマは特にないと言いますか、萃香ちゃんというお題だけで何が出てくるか楽しみにしたいので好きに描いて頂きたいです！", "created_at": "", "completed_at": ""}, {"path": "/@nrnbkn/works/1", "thumbnail_src": "https://si.imgix.net/1f378a91/uploads/origins/de6798fb-0633-46a0-a96f-b9da3fddd25d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e3ebd7c2d14270ee1051e18cf161e7", "thumbnail_srcset": "https://si.imgix.net/1f378a91/uploads/origins/de6798fb-0633-46a0-a96f-b9da3fddd25d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e3ebd7c2d14270ee1051e18cf161e7, https://si.imgix.net/1f378a91/uploads/origins/de6798fb-0633-46a0-a96f-b9da3fddd25d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62c99ea2867415f6528a070426d144ff 2x, https://si.imgix.net/1f378a91/uploads/origins/de6798fb-0633-46a0-a96f-b9da3fddd25d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43005a60f67c790cdc6e75275c91696e 3x", "genre": "art", "nsfw": false, "body": "アリスソフトのランスシリーズに登場するリセット・カラーを描いていただきたいです。\nその他詳細はお任せします。\n\nもし可能でしたら宛名とサインを差分で入れていただけると嬉しいです。\nよろしくお願いします。\n\n●リセット・カラー資料\nhttps://min.togetter.com/kpx91f8", "created_at": "", "completed_at": ""}]}