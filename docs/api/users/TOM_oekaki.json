ので、適宜簡略化して頂ければと思います。\nもし頂いたイラストがサムネイルなどに使用可能でしたら、背景透過の差分等も入れて頂きたいです。\n\n資料URLより四面図などの資料をご確認くださいませ。\n今回は年末年始と年度末も近いこともございますので、スケジュール的に厳しいor金額に見合わないようであればキャンセルして頂いて構いません。\nご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1-POEGDelSQR8uq08wIZVBDKAvFsNwKxC\n\nhttps://drive.google.com/file/d/1-POEGDelSQR8uq08wIZVBDKAvFsNwKxC", "created_at": "", "completed_at": ""}, {"path": "/@TOM_oekaki/works/3", "thumbnail_src": "https://si.imgix.net/e579a31a/uploads/origins/97a629a3-96fb-407b-9f81-dff5507264eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0dc1cc14fc424cc3bbab272cb4479c1", "thumbnail_srcset": "https://si.imgix.net/e579a31a/uploads/origins/97a629a3-96fb-407b-9f81-dff5507264eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0dc1cc14fc424cc3bbab272cb4479c1, https://si.imgix.net/e579a31a/uploads/origins/97a629a3-96fb-407b-9f81-dff5507264eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2741675fc8dc786ce96c01760f64214b 2x, https://si.imgix.net/e579a31a/uploads/origins/97a629a3-96fb-407b-9f81-dff5507264eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d0247bb557d536913be95a21f58dfc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TOM_oekaki/works/2", "thumbnail_src": "https://si.imgix.net/25643a44/uploads/origins/dfc2c71c-d8bb-4732-9264-0824d26b82ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2834bc635af87461917ab947