4-4c35-9e1f-adbaaeafdc91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2e963dbac3869d97055c3a3b10d2f81", "thumbnail_srcset": "https://si.imgix.net/12b08fd2/uploads/origins/4a15ac07-5b44-4c35-9e1f-adbaaeafdc91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2e963dbac3869d97055c3a3b10d2f81, https://si.imgix.net/12b08fd2/uploads/origins/4a15ac07-5b44-4c35-9e1f-adbaaeafdc91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=810b63ceb9d4e4fa5c1ece646e42ea9f 2x, https://si.imgix.net/12b08fd2/uploads/origins/4a15ac07-5b44-4c35-9e1f-adbaaeafdc91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd1ebe72a79fe9af8ab4e29c0e285fb6 3x", "genre": "art", "nsfw": false, "body": "前の画像めちゃくちゃかわいかったのでありがとございました！\nすこしサイコティックなスマイルのかおでお願いしてもいいんですか？\n（逃げ出した実験体の暗殺者って設定です）\nhttps://twitter.com/4444Gage4/status/1297875461351936003?s=20\nかみのけはこのながさでお願いします＞＜\nめちゃいいので。。。しょっく\nhttps://twitter.com/honoao/status/1380903669026054148?s=20", "created_at": "", "completed_at": ""}, {"path": "/@honoao/works/19", "thumbnail_src": "https://si.imgix.net/031c0ead/uploads/origins/19b29d50-148e-459b-97de-f389d3abc478?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5185b95ac90598e1226739761c7b5a7f", "thumbnail_srcset": "https://si.imgix.net/031c0ead/uploads/origins/19b29d50-148e-459b-97de-f389d3abc478?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5185b95ac90598e1226739761c7b5a7f, https://si.imgix.net/031c0ead/uploads/origins/19b29d50-148e-459b-97de-f389d3abc478?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f26b7b7ce5a8b47dbfc4ce604dc62d47 2x, https://si.imgix.net/031c0ead/uploads/origins/19b29d50-148e-459b-97de-f389d3abc478?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11054624cc1d8ee8ee77b3c84115d923 3x", "genre": "art", "nsfw": false, "body": "honoao様初めまして。昔からpixiv等で絵を拝見しておりました。\nこのたび私の創作キャラを描いていただきたく依頼させていただきます。用途は鑑賞等の個人的な範囲を予定しております。 URL先に参考資料としてキャラクターの外観・簡単な説明を記載しておりますので、参考にしていただけますと幸いです。  https://twitter.com/irvkg_/status/1330883651513454593?s=21 https://twitter.com/irvkg_/status/1346427355573567488?s=21 \n\n参考資料以外に指定することはほとんどありませんが、(描きやすいように改変いただいても構いません)、全体的に暗いor怖い雰囲気で描いていただけるととても嬉しいです。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@honoao/works/18", "thumbnail_src": "https://si.imgix.net/6d6d9fa5/uploads/origins/1e53d0d5-b6f9-4616-a519-79b3f3d99603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ce068a4080992752350b601eda7bba", "thumbnail_srcset": "https://si.imgix.net/6d6d9fa5/uploads/origins/1e53d0d5-b6f9-4616-a519-79b3f3d99603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ce068a4080992752350b601eda7bba, https://si.imgix.net/6d6d9fa5/uploads/origins/1e53d0d5-b6f9-4616-a519-79b3f3d99603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=212171b1910202a3ada427a8e9f459ba 2x, https://si.imgix.net/6d6d9fa5/uploads/origins/1e53d0d5-b6f9-4616-a519-79b3f3d99603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36cd354875d7301e5af015e748ac807f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターがビールグラスを持っているかわいいポーズを描いていただけますか？あなたの作品が大好きです。\n\nhttps://drive.google.com/file/d/1MWgo1pghX6SRroeF5FUyLFXyf7TfobKG/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@honoao/works/17", "thumbnail_src": "https://si.imgix.net/1cefe87a/uploads/origins/ed17d124-a03c-474e-a595-b405d0ecbf68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a78799a655cc698be7efe7681b5db194", "thumbnail_srcset": "https://si.imgix.net/1cefe87a/uploads/origins/ed17d124-a03c-474e-a595-b405d0ecbf68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a78799a655cc698be7efe7681b5db194, https://si.imgix.net/1cefe87a/uploads/origins/ed17d124-a03c-474e-a595-b405d0ecbf68?bg=%23fff&auto=form