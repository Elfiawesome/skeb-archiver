使用用途】\n収益化済みチャンネルでのYoutube（配信・動画・サムネイル）での使用\n※使用の際はクレジット表記いたします！\n\n内容についてご確認頂き、問題なければお願いできればと思います。\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tkantkmn/works/81", "thumbnail_src": "https://si.imgix.net/2077841e/uploads/outputs/b543d159-a73d-4463-b460-d8f0533a35e4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea569a2e9f01cd024edf4f52c9e33224", "thumbnail_srcset": "https://si.imgix.net/2077841e/uploads/outputs/b543d159-a73d-4463-b460-d8f0533a35e4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea569a2e9f01cd024edf4f52c9e33224, https://si.imgix.net/2077841e/uploads/outputs/b543d159-a73d-4463-b460-d8f0533a35e4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed50fa87b9b276a67fb6a0ae0ed0cf9d 2x, https://si.imgix.net/2077841e/uploads/outputs/b543d159-a73d-4463-b460-d8f0533a35e4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0361998418e93236401af65e052801b 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tkantkmn/works/80", "thumbnail_src": "https://si.imgix.net/203b979f/uploads/outputs/823f7a5f-8284-4b85-8d68-a91e7ae53fca?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=82f7db5d3ab4304bf7924a2e0640ba87", "thumbnail_srcset": "https://si.imgix.net/203b979f/uploads/outputs/823f7a5f-8284-4b85-8d68-a91e7ae53fca?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=82f7db5d3ab4304bf7924a2e0640ba87, https://si.imgix.net/203b979f/uploads/outputs/823f7a5f-8284-4b85-8d68-a91e7ae53fca?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&