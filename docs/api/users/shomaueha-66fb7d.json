を着たk-9のイズナか、女の子ラクリモーサをお願いします。\n襟は首元までぴっちり覆い、しっかりと襟を閉めた物をお願いします。\n構図は襟と、ネクタイの結び目が見えれば大丈夫です。表情は恥ずかしながらも少し怒りがある表情だと嬉しいです。\n資料は下記に記します。\n変なリクエストですが、ご検討いただければ幸いです。\nhttps://gyazo.com/1634c5e8acae6d32ff15c8a9a0b00640\n\nhttps://gyazo.com/ef6825ac8b2f1206ea3131f151e3cdd0\n\nhttps://gyazo.com/aa35567175e26f0057ded06368e12330", "created_at": "", "completed_at": ""}, {"path": "/@shomaueha/works/81", "thumbnail_src": "https://si.imgix.net/d794cb64/uploads/origins/25bf2dd8-d002-4375-89fc-2043daa8e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=874ca1a240177d8c2ff2e79ae57ae05f", "thumbnail_srcset": "https://si.imgix.net/d794cb64/uploads/origins/25bf2dd8-d002-4375-89fc-2043daa8e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=874ca1a240177d8c2ff2e79ae57ae05f, https://si.imgix.net/d794cb64/uploads/origins/25bf2dd8-d002-4375-89fc-2043daa8e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac17a03a01b548bf927f28e2121d89c8 2x, https://si.imgix.net/d794cb64/uploads/origins/25bf2dd8-d002-4375-89fc-2043daa8e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=208f8444da80a6b7475285793b0eb479 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shomaueha/works/80", "thumbnail_src": "https://si.imgix.net/0563595b/uploads/origins/aa731fb1-cbb0-4dc0-84d3-b643bfbc83a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1853c85829d8839259b507926887daae", "thumbnail_srcset": "https://si.imgix.net/0563595b/uploads/origins/aa731fb1-cbb0-4dc0-84d3-b