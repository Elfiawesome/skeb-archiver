8d24-fa2498e2a316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd1cf8a45cc8cdd3877c081ae7dcf288 2x, https://si.imgix.net/2aab6154/uploads/origins/daa93ee4-97ec-4e11-8d24-fa2498e2a316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b9a430c22a76de2653957d817d5fc0c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Arieru_Satan/works/6", "thumbnail_src": "https://si.imgix.net/915b97c9/uploads/origins/259e8f56-6695-4ec6-8677-1cb63ed5e67e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23e9e02e864ec57104be4cccb1a5f674", "thumbnail_srcset": "https://si.imgix.net/915b97c9/uploads/origins/259e8f56-6695-4ec6-8677-1cb63ed5e67e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23e9e02e864ec57104be4cccb1a5f674, https://si.imgix.net/915b97c9/uploads/origins/259e8f56-6695-4ec6-8677-1cb63ed5e67e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a634a1eac96374fef25715be5eb945f 2x, https://si.imgix.net/915b97c9/uploads/origins/259e8f56-6695-4ec6-8677-1cb63ed5e67e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b281a90f554d6d5c2a2e63b01ead9d0b 3x", "genre": "art", "nsfw": false, "body": "大好きなりとるさんの絵柄で、是非私のオリジナルキャラクターを描いていただきたいです！\n\n・キャラクターの説明\n中学二年生の少年で、立ち位置は物語のラスボスです。\n物語世界で有数の大企業の跡継ぎ(養子。義両親に取り入り自分で掴んだ地位。)で、とてつもない権力を持っています。\nいつも笑っていて感情をあらわにせず、一見フレンドリーですが野心家で、目的のためなら平気で他人を踏みにじる手段を選ばない冷酷な性格です。\n※｢悪属性の権力者の少年｣と理解していただければ大丈夫です！\n\n衣装は資料にあるものでも、りとるさんが描きやすいものを着せていただいても大丈夫です。(できればフォーマルな服がよいですが、それもお任せします)\n\n足下まで描かれないだろうと思い資料には載せていませんが、ズボンの裾にはチャイナ服のような短いスリットが入っています。靴は白を基調とした革のスニーカーです。\nあとわかりにくいですが横髪はパッツンです。\n\n構図はりとるさんの描きたいように描いていただけたら嬉しいです。\n割に合わないなと感じた場合はお気軽に承認キャンセルしていただいて構いませんので、何卒よろしくお願いします。🙇\n\nhttps://x.com/October_301/status/1891558201050509608", "created_at": "", "completed_at": ""}, {"path": "/@Arieru_Satan/works/5", "thumbnail_src": "https://si.imgix.net/93429f28/uploads/origins/7ca8de85-6f7b-4438-84a8-154eda1cb468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1787a0da7249305ef15f008ab1de2cbd", "thumbnail_srcset": "https://si.imgix.net/93429f28/uploads/origins/7ca8de85-6f7b-4438-84a8-154eda1cb468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1787a0da7249305ef15f008ab1de2cbd, https://si.imgix.net/93429f28/uploads/origins/7ca8de85-6f7b-4438-84a8-154eda1cb468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfd69786d11269e980aa4dda2456dcbd 2x, https://si.imgix.net/93429f28/uploads/origins/7ca8de85-6f7b-4438-84a8-154eda1cb468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=406f209f191f894d61cdfd68e1456d08 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n苗乃りとる様のイラストは唯一無二の可愛さと、中毒性のある魅力があってすごく好きです。\nこの度は、ぜひ僕のキャラを描いていただきたく、リクエストさせていただきました。\n\n――――――――――――\n\n▼要望\n過度にセンシティブな描写だけ避けていただければ、特にNGは無いので、苗乃りとる様の好きなように描いていただきたいです！\n服装もおまかせします(資料内にある服装でも大丈夫です)\n\n▼注意\n複雑なキャラデザで申し訳ないのですが、間違われやすいので、下記特に気を付けていただけますと大変嬉しいです…！\n・前髪はぱっつん、目の半分にかかるくらいの長さ\n・左右で違うまつ毛の色\n・左右で違う目の瞳孔(模様)\n・ほくろ\n・八重歯\n・ピアスの位置、拡張ピアス\n\n――――――――――――\n\n・頂いたイラストは、SNSや配信等で使用する可能性があります。\n\n・PSDファイル、もしくは人物のみの透過pngを頂きたいです。\n\n・可能であれば頭や肩が見切れていないと、とても助かります。\n\n・また、特典品としての使用をしたいのですが、可能でしょうか…？(イラストを商用グッズ化するのではなく、特典としての頒布のみ)\n※難しければPSDレイヤー等でその旨をお伝え頂ければ、使用いたしません！\n\n――――――――――――\n\nご検討の程、よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/14o-aCVhUIE_Ci3zI-nQhY0Axt8MUx9zY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Arieru_Satan/works/4", "thumbnail_src": "https://si.imgix.net/f0f0ab53/uploads/origins/215874b1-0dc5-4dcd-97bb-5ffb856227b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d531fe0ec83b2a9d8bd0c4c4ab786029", "thumbnail_srcset": "https://si.imgix.net/f0f0ab53/uploads/origins/215874b1-0dc5-4dcd-97bb-5ffb856227b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d531fe0ec83b2a9d8bd0c4c4ab786029, https://si.imgix.net/f0f0ab53/uploads/origins/215874b1-0dc5-4dcd-97bb-5ffb856227b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65735a1c75c33d516c4ccb91cbab5a65 2x, https://si.imgix.net/f0f0ab53/uploads/origins/215874b1-0dc5-4dcd-97bb-5ffb856227b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e02ce8fb857f589c1659da00fa3bb4eb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Arieru_Satan/works/3", "thumbnail_src": "https://si.imgix.net/79000cca/uploads/origins/1b6f9e47-f654-4cd8-90d8-9c3bd322b5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b83db9072ef77130afd0f23f499359", "thumbnail_srcset": "https://si.imgix.net/79000cca/uploads/origins/1b6f9e47-f654-4cd8-90d8-9c3bd322b5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b83db9072ef77130afd0f23f499359, https://si.imgix.net/79000cca/uploads/origins/1b6f9e47-f654-4cd8-90d8-9c3bd322b5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3424473268573684d870ab5f71718d7 2x, https://si.imgix.net/79000cca/uploads/origins/1b6f9e47-f654-4cd8-90d8-9c3bd322b5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0c7d9104a9e064dce47785612962bfb 3x", "genre": "art", "nsfw": false, "body": "オレンジ色のビキニを着た私のオリジナルキャラクターを描いてください。セクシーなポーズで。\n目の色：グレー\n\n身長: 5'9 \"\n\n年齢: 20\n\n犬耳\n\nアクセサリー：赤い首輪\n\n背景: ビーチ\n\nポーズ: セクシー\n\n表情：浮気\n\n私のオリジナルキャラクターの参考文献はこちら: https://www.deviantart.com/citrusanime/art/My-Offical-DA-Mascot-290687270\n\n他のアーティスト 1. https://sta.sh/023ht6z36vqf 2. https://sta.sh/0278r2mg6ixd 3. https://sta.sh/0k1ja8v3adq\n\nポーズの参考文献 1. https://sta.sh/0ufsyy8di0d 2. https://sta.sh/0sozjsty4p7 3. https://sta.sh/01hzsy3ciyyy\n\nセクシーに描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@Arieru_Satan/works/2", "thumbnail_src": "https://si.imgix.net/8f1966b0/uploads/origins/fa9fa7ac-1b81-4a9d-b393-6a307d2e1161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a48fcf49af1dc5610853c1e1e1007e", "thumbnail_srcset": "https://si.imgix.net/8f1966b0/uploads/origins/fa9fa7ac-1b81-4a9d-b393-6a307d2e1161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a48fcf49af1dc5610853c1e1e1007e, https://si.imgix.net/8f1966b0/uploads/origins/fa9fa7ac-1b81-4a9d-b393-6a307d2e1161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8ac749e37c9469c0358d511e7cde3d8 2x, https://si.imgix.net/8f1966b0/uploads/origins/fa9fa7ac-1b81-4a9d-b393-6a307d2e1161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59c422b170e7f9b716db63fa65d3c6f4 3x", "genre": "art", "nsfw": false, "body": "創作物が好きなので、1枚絵というより、\n背景は簡単に。以下記述する要素を取り入れたキャラクターを希望したいです。全身像でお願いします。(アングル、構図は自由です。)\n\n・ツノ(鹿みたいなスベスベじゃなくて、羊みたいなゴツゴツした感じでお願いします。)\n・サブカルチャー(ジャージ)を希望したいです。中華、和、メルヘン等、寄りで描きやすい物があれば、そのジャンルに寄ってもらって大丈夫です。\n・少年でお願いします。\n\n用途はPCの背景です。\n1920×1080のフルHDなので、16:9であるのが理想なのですが、比率が違っても大丈夫です。縦でも。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Arieru_Satan/works/1", "thumbnail_src": "https://si.imgix.net/908f242e/uploads/origins/37c76e36-9a62-4327-bbb1-494f0bbe6217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b3d87b75b8d33736f05245abc8d1c53", "thumbnail_srcset": "https://si.imgix.net/908f242e/uploads/origins/37c76e36-9a62-4327-bbb1-494f0bbe6217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b3d87b75b8d33736f05245abc8d1c53, https://si.imgix.net/908f242e/uploads/origins/37c76e36-9a62-4327-bbb1-494f0bbe6217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44108f0243d34bd063c96d4ae8fb6fd6 2x, https://si.imgix.net/908f242e/uploads/origins/37c76e36-9a62-4327-bbb1-494f0bbe6217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3508a11be134b72d5ec7b17577cc12e3 3x", "genre": "art", "nsfw": false, "body": "はじめまして！iriamで配信活動をしています、「晨星(しんせい)あきら」と申します！\nりとるさんの描かれるほの暗く病みかわいいイラストが大好きです🙏🙏二次創作も好きですが、創作で描かれるイラストも衣装やキャラのデザインが独創的で好きです！\nずっとご依頼したいなとチラチラしていたのですがスケブされていると知ってリクエスト送信させていただきました！\n\nりとるさんの思うかわいい(可哀想も可)を詰めた晨星あきらを描いていただきたいです。\n参考資料を添付しますが、衣装はりとるさんが描きやすいよう新しいものを着せていただいてもかまいません。\n↓晨星あきらの基本情報↓\n天使に憧れるレベル1のAIで電脳世界にいます。\nAIなので無性別で体格は未発達の少年体型です。\n\n使用用途は配信でのサムネイル、または返礼品(リスナーにギフトのお礼として配布するヘッダーやネップリなど)の商用利用を考えています。\nもし可能でしたら人物のみを透過したものも一緒にくださると嬉しいです！\n\nこれからも応援しています！\nお身体に気をつけて活動されてください！\n\nhttps://drive.google.com/file/d/1V3_G0EFLJ1y2vMdyPkFyuIkAzfJcvA52/view?usp=drivesdk", "created_at": "", "completed_at": ""}]}