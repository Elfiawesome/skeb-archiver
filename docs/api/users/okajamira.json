4b15-802b-eba19da46fc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c8ac36cf248650d05296070ef544720, https://si.imgix.net/2b2abb4e/uploads/origins/69652dca-cae5-4b15-802b-eba19da46fc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24277e4674f79a22d65d638c906e1633 2x, https://si.imgix.net/2b2abb4e/uploads/origins/69652dca-cae5-4b15-802b-eba19da46fc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6867a8fdd2cce626925f47c073b89c10 3x", "genre": "art", "nsfw": true, "body": "こんにちは、丘者先生！\n先生の作品がとても好きで、ぜひリクエストさせていただきたく思いました。\n\nTRPGキャラクターの衣装デザインをお願いできましたら嬉しいです。\nキャラクターは2人で、1920年代のアメリカ人という設定になります。簡単な紹介は以下の通りです。\n\nレミュエル：探偵兼大学生\n可能でしたら、西洋ファンタジー風の衣装デザインを希望しています。\n\nウルスラ：医師\n可能でしたら、中世の黒死病医師（ペスト医師）を思わせるような西洋ファンタジー風の衣装デザインをお願いしたいです。\n\n参考資料：\nhttps://drive.google.com/drive/folders/121QNGmNtAQ17nXttlZTzAJvW1wiF82JL\n\n具体的なデザインは、先生のご自由な発想にお任せいたします。\n金額が不足している場合は、調整していただいて問題ありません。\n\nどうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/159", "thumbnail_src": "https://si.imgix.net/79136b80/uploads/origins/94667a90-e05b-41ac-9203-917b226073f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d9029ac35128b1829d78aa68be42981", "thumbnail_srcset": "https://si.imgix.net/79136b80/uploads/origins/94667a90-e05b-41ac-9203-917b226073f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d9029ac35128b1829d78aa68be42981, https://si.imgix.net/79136b80/uploads/origins/94667a90-e05b-41ac-9203-917b226073f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44fede11a1958efcdab9610f298e899b 2x, https://si.imgix.net/79136b80/uploads/origins/94667a90-e05b-41ac-9203-917b226073f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a0b0316d6f5a9ddeb495d1b1456a31f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/158", "thumbnail_src": "https://si.imgix.net/d07f5657/uploads/origins/3b5bda7e-abff-4937-ae66-15535b99c1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85e12d5de9a3857690411a181da0af9", "thumbnail_srcset": "https://si.imgix.net/d07f5657/uploads/origins/3b5bda7e-abff-4937-ae66-15535b99c1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85e12d5de9a3857690411a181da0af9, https://si.imgix.net/d07f5657/uploads/origins/3b5bda7e-abff-4937-ae66-15535b99c1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=687365d75ad928075aafb5c4e0a52899 2x, https://si.imgix.net/d07f5657/uploads/origins/3b5bda7e-abff-4937-ae66-15535b99c1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26ef281585826e2d0fc93d3ff12a83e8 3x", "genre": "art", "nsfw": false, "body": "はじめまして！私はあなたの絵がとても好きで、シンプルな背景や複雑な背景を含むイラストを描いていただきたいと思います！以下はキャラクターの詳細です。\nキャラクターは砂漠の冒険家の猫です！https://www.dropbox.com/scl/fo/5d3unrucg22x53x82t5cp/ACpAFoQLvYJZtfWtb_EZz9I?rlkey=thi5jliflwvawrki9y623bnw5&st=jrggg6dl&dl=0\n彼女の絵を参考にしていただければと思いますが、体についているリュックを細かく分解すると、おそらく酸素ボンベなどを収納できるリュックだと思われます！\n彼女はどちらかというと飄々としていて、絶望的なのに生きようとしていることを理解している。\n以前描いていただいた服もとても気に入っています！なので、また何か描いて頂けたらと思います。(⸝⸝>ᴗ<⸝⸝)今回も特にイケメンな冒険者の服を描いていただきありがとうございました！\n\nhttps://www.dropbox.com/scl/fo/5d3unrucg22x53x82t5cp/ACpAFoQLvYJZtfWtb_EZz9I?rlkey=thi5jliflwvawrki9y623bnw5&st=jrggg6dl&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/157", "thumbnail_src": "https://si.imgix.net/23969b20/uploads/origins/743eb96f-1867-4378-8a22-e52cdc915668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44d6c5f1fb550cea7d3ef065c72f6b2f", "thumbnail_srcset": "https://si.imgix.net/23969b20/uploads/origins/743eb96f-1867-4378-8a22-e52cdc915668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44d6c5f1fb550cea7d3ef065c72f6b2f, https://si.imgix.net/23969b20/uploads/origins/743eb96f-1867-4378-8a22-e52cdc915668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b867d251213db7aed31c2b0856678e6 2x, https://si.imgix.net/23969b20/uploads/origins/743eb96f-1867-4378-8a22-e52cdc915668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2465b12706e815f3f226f768f596951f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/156", "thumbnail_src": "https://si.imgix.net/b695f55c/uploads/origins/316cd8a3-47a4-4834-8551-06cfb53cbcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24611c44ca52d9dfa3bacea477a49f29", "thumbnail_srcset": "https://si.imgix.net/b695f55c/uploads/origins/316cd8a3-47a4-4834-8551-06cfb53cbcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24611c44ca52d9dfa3bacea477a49f29, https://si.imgix.net/b695f55c/uploads/origins/316cd8a3-47a4-4834-8551-06cfb53cbcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9177c2597e7c8cd6f6889bd93fad8e06 2x, https://si.imgix.net/b695f55c/uploads/origins/316cd8a3-47a4-4834-8551-06cfb53cbcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81694a389dbae70eda3bb12779a044b8 3x", "genre": "art", "nsfw": false, "body": "黒先生、こんにちは！初めてお目にかかります、System_Kuroと申します！というわけで、サイバーパンクを背景にした私のOOCのコスチュームデザインを先生に依頼したいと思います。\n\n名前はギリング、16歳、身長167cm、ピンクのロングヘアーに濃いピンクの瞳の少女です。彼女の原型は宇宙に浮かぶ6つの目を持つ獣です。\n\n彼女の参考リンクはこちら：\nhttps://drive.google.com/drive/folders/1JIuruP1p0oCOKXTS3cdHO0ykWdC3TZ16?usp=drive_link\n\nコスチュームスタイル：サイバーパンクの世界（おそらくゲーム「サイバーパンク2077」を参考にしている）の設定のスラム街でキャラクターが着ていそうなもので、機械的な義肢のデザインが含まれていれば完璧！\n\n用途：個人使用のみ。予算がある場合は、衣装の分割もお願いします。\n\n依頼を快く引き受けてくださる先生だと本当にありがたいです！\n(翻訳機を使っているので、表現に不備がありましたらご容赦ください)", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/155", "thumbnail_src": "https://si.imgix.net/4ac22695/uploads/origins/0275c318-140a-4ec6-9ab6-308269ac43d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=448b323622ee70e71abf9a0d749ec06e", "thumbnail_srcset": "https://si.imgix.net/4ac22695/uploads/origins/0275c318-140a-4ec6-9ab6-308269ac43d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=448b323622ee70e71abf9a0d749ec06e, https://si.imgix.net/4ac22695/uploads/origins/0275c318-140a-4ec6-9ab6-308269ac43d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2917632a17efc0f10d680eb9379228b3 2x, https://si.imgix.net/4ac22695/uploads/origins/0275c318-140a-4ec6-9ab6-308269ac43d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf1a9ac001a8bc5decd813a5d34475ca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/154", "thumbnail_src": "https://si.imgix.net/19ef1887/uploads/origins/e4440594-509c-41b2-a087-01fa48589ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc71c4ca1ece27aaf4a8a08988cbd871", "thumbnail_srcset": "https://si.imgix.net/19ef1887/uploads/origins/e4440594-509c-41b2-a087-01fa48589ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc71c4ca1ece27aaf4a8a08988cbd871, https://si.imgix.net/19ef1887/uploads/origins/e4440594-509c-41b2-a087-01fa48589ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40652c342cd2bf1e4ed81f6a1ff0bbba 2x, https://si.imgix.net/19ef1887/uploads/origins/e4440594-509c-41b2-a087-01fa48589ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1682cfc9bde15eff6e2b5d778a2f594e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの絵を見て、そのディテールの細かさに驚きました。僕のアークナイツOCの衣装のデザインを依頼したいんだ。\n\n彼はライタニエンに住む若くて控えめなウルサスです。彼はアシッドアーツを唱えるためにナイフを使い、彼には大きすぎる剣を背中に背負っている。寒い季節に似合いそうな服のデザインは自由に選んでください。\n\nよろしくお願いします。\n\n参考：https://drive.google.com/drive/u/0/folders/1UzbJ32KakgzLitUhbENv79DjFGwO0Wx9", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/153", "thumbnail_src": "https://si.imgix.net/a082344f/uploads/origins/f778d2fb-581a-431f-853d-51ee1c80e40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cee3c9543895f19586081888f6a1058", "thumbnail_srcset": "https://si.imgix.net/a082344f/uploads/origins/f778d2fb-581a-431f-853d-51ee1c80e40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cee3c9543895f19586081888f6a1058, https://si.imgix.net/a082344f/uploads/origins/f778d2fb-581a-431f-853d-51ee1c80e40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10c5fa0ccb38d20b2271860e02ddad0a 2x, https://si.imgix.net/a082344f/uploads/origins/f778d2fb-581a-431f-853d-51ee1c80e40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d18ba75c49ca8e28fe175c386adfc0fe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがかわいいので、オリジナルのキャラクターデザインを依頼したいです！\n\n身長は1メートルくらいで、とても表情豊かな若いフロッグマンが欲しいです。\n種は？アメリカウシガエル https://upload.wikimedia.org/wikipedia/commons/thumb/a/aa/North-American-bullfrog1.jpg/1200px-North-American-bullfrog1.jpg\nメインカラー緑と黄色\n\n養父のような釣り名人になりたいと思っている二足歩行の若いカエル男。人を助けること、特別な釣り竿と槍の武器で訓練すること、そして学ぶことが好き。\n\n父親と同じような服を着てほしいが、足には網があるのでブーツは履かない。https://skeb.jp/@kaninu_nosi/works/58。\n\nどんなディテールでも自由に追加してください！私の依頼を読んでいただきありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/152", "thumbnail_src": "https://si.imgix.net/77c736d6/uploads/origins/8970488c-0393-4d59-9c3b-d6f1b488279e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4488318223d57414b03729bb545d0316", "thumbnail_srcset": "https://si.imgix.net/77c736d6/uploads/origins/8970488c-0393-4d59-9c3b-d6f1b488279e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4488318223d57414b03729bb545d0316, https://si.imgix.net/77c736d6/uploads/origins/8970488c-0393-4d59-9c3b-d6f1b488279e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a68502c3fc68a692bfd3849050207336 2x, https://si.imgix.net/77c736d6/uploads/origins/8970488c-0393-4d59-9c3b-d6f1b488279e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8159b3c017357735794639fb51313210 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのデザインがとても好きです。  このキャラクターのためにファンタジークリーチャーをデザインしていただけるとなお嬉しいです。\n目的：個人サイトの展示と参考。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1hEn2cefRC6HFnkPh7jmRlLdp-AJTwazP/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@okajamira/works/151", "thumbnail_src": "https://si.imgix.net/cb1f3097/uploads/origins/24147155-c1f5-44e3-b914-846a4830adbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3965f6af0c75b1706f38fc9aaa7ad4f", "thumbnail_srcset": "https://si.imgix.net/cb1f3097/uploads/origins/24147155-c1f5-44e3-b914-846a4830adbb?bg=%2