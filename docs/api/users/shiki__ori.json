-9c1c0afe2f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d055a806507fcab53952b12d899fa39, https://si.imgix.net/106afa7c/uploads/origins/71345f4e-73a3-475f-b1bc-9c1c0afe2f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f73cbf7432fe7e5f99c1a3ad5716f2c 2x, https://si.imgix.net/106afa7c/uploads/origins/71345f4e-73a3-475f-b1bc-9c1c0afe2f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b854f87b14fba50b52f184e654e71d99 3x", "genre": "art", "nsfw": false, "body": "こんにちは！吸血鬼ドラゴンナースVTuberの紅桃あるとと申します。\n\n以前四季折さんに素敵なイラストを描いていただき今でもとても気に入っています！\n\nこの度新衣装を実装したので、今度はぜひ新衣装の姿で描いていただけたらなと思っています・・！\n\n【依頼内容】\n私(紅桃あると)のイラストをお願いしたいです。\n\nポーズなどはお任せします！メガネはなしの状態で描いていただければと思います…！\n\n完成したイラストはTwitterでの活動やYouTubeでの活動、ネットプリントなどで使わせていただければと思います！\n\n(データは人物部分の透過pngをつけていただくか、又はpsdデータでいただけると嬉しいです)\n\nお時間があれば是非よろしくお願いします！\n\nhttps://twitter.com/kurumi_alto/status/1695789878376870390?s=20", "created_at": "", "completed_at": ""}, {"path": "/@shiki__ori/works/2", "thumbnail_src": "https://si.imgix.net/37d4f9c5/uploads/origins/5254db95-e52d-4a4d-ab02-81380904b18e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030a754f921e118e4caa7fd58c891c40", "thumbnail_srcset": "https://si.imgix.net/37d4f9c5/uploads/origins/5254db95-e52d-4a4d-ab02-81380904b18e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030a754f921e118e4caa7fd58c891c40, https://si.imgix.net/37d4f9c5/uploads/origins/5254db95-e52d-4a4d-ab02-81380904b18e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ae81753ad3606187ac89a08de70e274 2x, https://si.imgix.net/37d4f9c5/uploads/origins/5254db95-e52d-4a4d-ab02-81380904b18e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b9269c8e5381d10f87870015e02f664 3x", "genre": "art", "nsfw": false, "body": "はじめまして！吸血ドラゴンナースの新人VTuber紅桃あるとです！   \n\nもしよろしければ私(紅桃あると)のイラストをお願いしたいです！構図、ポーズなどは全てお任せいたします！一応衣装の資料を添付いたしますがお好きに改変していただいて大丈夫です！  完成したイラストはTwitterでの活動やYouTubeでの活動、グッズ制作などに使わせていただければと思っています…！\n\nお時間があれば是非よろしくお願いします！\n\nhttps://twitter.com/kurumi_alto/status/1500048473097265153?s=21", "created_at": "", "completed_at": ""}, {"path": "/@shiki__ori/works/1", "thumbnail_src": "https://si.imgix.net/84768521/uploads/origins/40f22259-95ca-4847-bcb3-1d37a4dc3553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=964dc83f3175ca6b4982f0f96b9f93a6", "thumbnail_srcset": "https://si.imgix.net/84768521/uploads/origins/40f22259-95ca-4847-bcb3-1d37a4dc3553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=964dc83f3175ca6b4982f0f96b9f93a6, https://si.imgix.net/84768521/uploads/origins/40f22259-95ca-4847-bcb3-1d37a4dc3553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2db2fc21b63677f7aca1cba684baac3 2x, https://si.imgix.net/84768521/uploads/origins/40f22259-95ca-4847-bcb3-1d37a4dc3553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e788112d18d46cde88a66e7087b0450e 3x", "genre": "art", "nsfw": false, "body": "セキセイインコをイメージしたオリジナルキャラクター１人をお願いします。\n資料がなくて申し訳ないですが、私が以前保護して飼っていた子をイメージして描いてもらいたいです。\n頭が黄色、体は黄緑カラーで、頭や翼に黒い模様はありません。\nオス・メスは最後まで分からなかったので、男性キャラと女性キャラどちらでも構いません。\n怒りっぽく、でもそんなところが可愛い子だったので、少しムスっとした表情だと嬉しいです。\n余裕のある時に、気楽に楽しく落書きしてもらったものが欲しいです！\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}]}