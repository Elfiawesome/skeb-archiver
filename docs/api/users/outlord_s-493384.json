40b38a7c0891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c19c3af2bdf87137d07bd2751d0fbdd7", "thumbnail_srcset": "https://si.imgix.net/dbfbb87b/uploads/origins/1e86db26-c778-4346-98a2-40b38a7c0891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c19c3af2bdf87137d07bd2751d0fbdd7, https://si.imgix.net/dbfbb87b/uploads/origins/1e86db26-c778-4346-98a2-40b38a7c0891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0dc2ecee0b9baa0f931bb1cdc3aeb9e 2x, https://si.imgix.net/dbfbb87b/uploads/origins/1e86db26-c778-4346-98a2-40b38a7c0891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0177a4d0f412d99d47c77dd4984bd344 3x", "genre": "art", "nsfw": false, "body": "またリクエストさせていただきたく存じます。\n\n以前リクエストした竜人と野兎ドラゴンが一緒にいるところをお願いいたします。\n・竜人はあぐらをかいていてください。\n・野兎ドラゴンはあぐらの中に収まっていてください。\n・竜人は野兎ドラゴンを撫でているか、エサをあげている最中でお願いします。\n・竜人は何かにもたれていてください。\n・竜人：https://skeb.jp/@outlord_s/works/10\n・野兎：https://skeb.jp/@outlord_s/works/5\n\nお請けいただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/14", "thumbnail_src": "https://si.imgix.net/cdaa5532/uploads/origins/8fa24c0f-f33d-432c-a89c-cb3845c1955b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=338c6c5dd1208d85672c107911c0da08", "thumbnail_srcset": "https://si.imgix.net/cdaa5532/uploads/origins/8fa24c0f-f33d-432c-a89c-cb3845c1955b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=338c6c5dd1208d85672c107911c0da08, https://si.imgix.net/cdaa5532/uploads/origins/8fa24c0f-f33d-432c-a89c-cb3845c1955b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=257ec10ef6f7944e9b900dbc9e807f18 2x, https://si.imgix.net/cdaa5532/uploads/origins/8fa24c0f-f33d-432c-a89c-cb3845c1955b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d129d144a37214ccabd4ddb656a058f 3x", "genre": "art", "nsfw": false, "body": "はじめまして｡ Xionさんのかっこいいドラゴンイラストが大好きだから､今回リクエストしたいのです｡\n\nもしよかったら、私のキャラ (設定: https://drive.google.com/drive/folders/1GkNp5O5Z6KXQeVjFCjX00W-77P-kG_5q?usp=sharing)をDJしている姿描いていただけませんか｡ \n\n構図、背景、ポーズなどはXionさんにお任せ致します。 以上です、何卒お願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/13", "thumbnail_src": "https://si.imgix.net/11c8b164/uploads/origins/bafd3c10-9572-4e72-9a64-2a9cc67f63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b9b30dbb15f11324821222d58551bc", "thumbnail_srcset": "https://si.imgix.net/11c8b164/uploads/origins/bafd3c10-9572-4e72-9a64-2a9cc67f63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3b9b30dbb15f11324821222d58551bc, https://si.imgix.net/11c8b164/uploads/origins/bafd3c10-9572-4e72-9a64-2a9cc67f63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7a4613893f9b77b03c6db288cfc49f8 2x, https://si.imgix.net/11c8b164/uploads/origins/bafd3c10-9572-4e72-9a64-2a9cc67f63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf252cdbb6f66a64502890c38f809eba 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの作品が本当に大好きです私のキャラクター「ネオマ」を描くことを検討してください。\n\nhttps://i.imgur.com/MG3qS8R.jpg\n\n参考文献にあるように、彼女が魔法を使うようにお願いします。魔法をかけると目が青く光るようにしてください。それ以外は好きなようにしてください。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/12", "thumbnail_src": "https://si.imgix.net/e892e4e3/uploads/origins/18c03588-991f-4f46-a7e9-d50c73010011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9096cd9f6de007cdb422d5daa94e505d", "thumbnail_srcset": "https://si.imgix.net/e892e4e3/uploads/origins/18c03588-991f-4f46-a7e9-d50c73010011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9096cd9f6de007cdb422d5daa94e505d, https://si.imgix.net/e892e4e3/uploads/origins/18c03588-991f-4f46-a7e9-d50c73010011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ee5217ea84c49a0c6fb50585b8b2dd9 2x, https://si.imgix.net/e892e4e3/uploads/origins/18c03588-991f-4f46-a7e9-d50c73010011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=177c5772ab5073b0677cb5abc196f213 3x", "genre": "art", "nsfw": false, "body": "オリキャラ幼竜のティレイラがトラブルに見舞われた姿のイラストをお願いします。\n\nティレイラが知り合いの魔女にお願いされて魔女が取り仕切る大きな宿泊施設にきたら\n魔女の魔法で美しい石の彫像の姿に変えられて修理中の彫像の代理扱いで\n当分の間、飾られる羽目になり、えっと驚いたような様子のまま石像になっている姿の雰囲気で自由にお任せでお願いします。\n\n・ティレイラ参考画像\nhttps://drive.google.com/file/d/1YLn0d3EYO6Lg4vcV8cnMCgVnbZ8v2wLB/view", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/11", "thumbnail_src": "https://si.imgix.net/06703931/uploads/origins/a8e734cb-ea2e-46df-bde8-c811613c36fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81b05c5ce01a738edab06f0c49147a1b", "thumbnail_srcset": "https://si.imgix.net/06703931/uploads/origins/a8e734cb-ea2e-46df-bde8-c811613c36fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81b05c5ce01a738edab06f0c49147a1b, https://si.imgix.net/06703931/uploads/origins/a8e734cb-ea2e-46df-bde8-c811613c36fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff9c61162f23d0dc2833cd4efff73cd7 2x, https://si.imgix.net/06703931/uploads/origins/a8e734cb-ea2e-46df-bde8-c811613c36fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aebaaed8bf8a8b6b55fe6d9dd8062e58 3x", "genre": "art", "nsfw": false, "body": "初めまして、冬狼/Anfauglirと申します。\n\n今回依頼したい内容は：\n- うちの仔のイラストを描いてほしいです。\n彼は吹雪と烈風を自由自在に操れる、クリスタルから封じられた思いを読み取れる、\n探究心が強い、寒い所が大好きなドラゴンです。\n- 内容と構図などはおまかせです。\n\nよろしくおねがいします！\n\n資料URL: \nhttps://www2.cs.ccu.edu.tw/~lws98m/AFX_drg-v21.08-F_ja_220328a.png", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/10", "thumbnail_src": "https://si.imgix.net/a585ab39/uploads/origins/a4301aff-aaab-45c0-baab-a895ab35ba6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c15e14465ff521c0d58085221ebd8841", "thumbnail_srcset": "https://si.imgix.net/a585ab39/uploads/origins/a4301aff-aaab-45c0-baab-a895ab35ba6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c15e14465ff521c0d58085221ebd8841, https://si.imgix.net/a585ab39/uploads/origins/a4301aff-aaab-45c0-baab-a895ab35ba6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b97ea9ac1744e2c852f3edaa2ff9bdbc 2x, https://si.imgix.net/a585ab39/uploads/origins/a4301aff-aaab-45c0-baab-a895ab35ba6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0e1f92f3b1afd9cf872aaa619075ebe 3x", "genre": "art", "nsfw": false, "body": "またリクエストさせていただきたく存じます。\n\nファードラゴンの竜人をお願いいたします。\n・体毛の色は白。\n・顔は人よりではなくドラゴンそのもので、マズルがわかるようお願いいたします。\n・性別はお好みで。\n・槍を携えて、タセット、胸当て、籠手、脛当てを装備してください。\n　・イメージするタセットは、googleで「タセットベルト」で画像検索をしていただければ、検索結果の最初の方にこちらがイメージする画像がでてくるかとおもいます。\n　・参考までに「中世ヨーロッパ武具専門店 ナイツ オブ ラウンド」というショップのタセットのアドレスを貼っておきます。アクセスについて不安があれば参照していただかなくても結構です。http://knightsofround.zipangshokai.jp/ca80/251/p-r80-s/\n・手持ち無沙汰な（ゆるい？）感じを出していただきたいです。\n\nお請けいただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/9", "thumbnail_src": "https://si.imgix.net/1ef03bc9/uploads/origins/8f252163-2ed5-4642-8731-86ced9fe1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d6ac5aecd8355983095d29081a398e2", "thumbnail_srcset": "https://si.imgix.net/1ef03bc9/uploads/origins/8f252163-2ed5-4642-8731-86ced9fe1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d6ac5aecd8355983095d29081a398e2, https://si.imgix.net/1ef03bc9/uploads/origins/8f252163-2ed5-4642-8731-86ced9fe1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b0c83cea865eb5df4db039fb8ca2c87 2x, https://si.imgix.net/1ef03bc9/uploads/origins/8f252163-2ed5-4642-8731-86ced9fe1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b49ea8815341cf92a028e4ac2695ab88 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、マスターデュエルやDCGの配信でサムネイルに使用するイラストを依頼したいです。前回依頼したように背景の透過もよろしくお願いします。\nカードとドラゴガイストの組み合わせで、構図、表情はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@outlord_s/works/8", "thumbnail_src": "https://si.imgix.net/7828415a/uploads/origins/e224ab33-ce7c-47c6-9395-611422c28b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854bfce62991fed06bd038dfab72f8cf", "thumbnail_srcset": "https://si.imgix.net/7828415a/uploads/origins/e224ab33-ce7c-47c6-9395-611422c28b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854bfce62991fed06bd038dfab72f8cf, https://si.imgix.net/7828415a/uploads/origins/e224ab33-ce7c-47c6-9395-611422c28b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2b8a95068cad19fa85ec510e9113c92 2x, https://si.imgix.net/7828415a/uploads/origins/e224ab33-ce7c-47c6-9395-611422c28b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c92af00b6d06412e6caa97ba122f9054 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nオリキャラの幼竜ティレイラがトラブルに見舞われた姿のイラストをお願いします。\n\n好奇心旺盛なティレイラが興味深い異空間を見つけて入って魔物群と遭遇して殲滅していたら\n魔物の呪いでティレイラの身体が結晶のように変化して\n大慌てで逃げ出そうとした様子で完全に結晶の塊と化して幼竜を象った結晶の像になってしまっている姿\n\n・ティレイラ参考画像\nhttps://drive.google.com/file/d/1YLn0d3EYO6Lg4vcV8cnMCgVnbZ8v2wLB/view", "created_at": "", "completed_at": ""}]}