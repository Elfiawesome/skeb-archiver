e.com/file/d/17XQLcQtNeJufhd9I2xHbD_delDN65I8l/view?usp=drivesdk\n\n ♢﻿要望\n悪魔の方は八重歯が見えると嬉しいです。\n帽子でヘイローを隠してるという設定なので、帽子は外さないで頂けると助かります。\n天使と悪魔で対のような感じを出していただけると嬉しいです。\n\nまた、キャラクターをそれぞれ分けていただいて、その上背景も分けた形での納品が希望です。\n\n 使用用途等不可がありましたら、キャンセルしていただいて構いません。\n お忙しい中だと思いますがご検討いただけると幸いです。  \nこれからの活動も応援しております！ どうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@y_zp_113/works/48", "thumbnail_src": "https://si.imgix.net/33eea7b3/uploads/origins/5c8e2ce3-2a66-4ab0-a626-34d811d5bb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4a96b7043ee3080b3201830fdcbbad5", "thumbnail_srcset": "https://si.imgix.net/33eea7b3/uploads/origins/5c8e2ce3-2a66-4ab0-a626-34d811d5bb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4a96b7043ee3080b3201830fdcbbad5, https://si.imgix.net/33eea7b3/uploads/origins/5c8e2ce3-2a66-4ab0-a626-34d811d5bb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ac414c9a17166187d4e8422e0f913b4 2x, https://si.imgix.net/33eea7b3/uploads/origins/5c8e2ce3-2a66-4ab0-a626-34d811d5bb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2de9c32d45e2810fdc530590e2be36fa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@y_zp_113/works/47", "thumbnail_src": "https://si.imgix.net/706b3818/uploads/origins/bce11c40-1420-4aaf-a15d-1fc54e166b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a7b5ed2548cf001828f94700060ae3b", "thumbnail_srcset": "https://si.imgix.net/706b3818/uploads/origins/bce11c40-1420-4aaf-a15d-1fc5