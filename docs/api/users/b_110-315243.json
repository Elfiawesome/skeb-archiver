265e6b7d7e42efed4 2x, https://si.imgix.net/cc9e6316/uploads/origins/b96a95fc-cb97-4c02-9b8b-b962007d28a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ada08a70ef3e1ea15e85a96f9032ef8e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@b_110/works/20", "thumbnail_src": "https://si.imgix.net/055368db/uploads/origins/678af420-cc28-4a8c-a260-06e0bb9d2883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30158f83ad784d120ee50c1da8f15493", "thumbnail_srcset": "https://si.imgix.net/055368db/uploads/origins/678af420-cc28-4a8c-a260-06e0bb9d2883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30158f83ad784d120ee50c1da8f15493, https://si.imgix.net/055368db/uploads/origins/678af420-cc28-4a8c-a260-06e0bb9d2883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12944a3c5b60878e9e86e173959a0c9e 2x, https://si.imgix.net/055368db/uploads/origins/678af420-cc28-4a8c-a260-06e0bb9d2883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d23b01f5fb96829949c62d3a7d45422 3x", "genre": "art", "nsfw": false, "body": "伊富魚様、こんにちは。\n以前から伊富魚様の、男の子も女の子もみんな生き生きしていて可愛らしくて、いつまでも見ていられる\n魅力的な絵が大好きで、いつかskebをお願いできたらと思い続け、\n今回リクエストさせて頂きます。\n描いて頂きたいのは、西遊記の恵岸行者という登場人物をモチーフに個人的に創作したキャラクターです。\n（女の子に見えますが、男の子です）\n観音菩薩の弟子で、基本的にまじめですがアイドルオタクでちょっとめんどくさい性格という設定です。\n\n構図や表情等お任せいたします。元気な感じに描いて頂けると嬉しいです。\n（全身でなくても構いません）\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-46tbrwex39MyqaHeIiHUfpd75B1Jwkw?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@b_110/works/19", "thumbnail_src": "https://si.imgix.net/819015ca/uploads/origins/4379a7f5-0424-4cc1-bc65-5c4cf1360574?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txt