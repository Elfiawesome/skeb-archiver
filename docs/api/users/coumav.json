1b1-5f5aac2428e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f3b2de33753f040ae2bc2be9b6d0599, https://si.imgix.net/ee1c8136/uploads/origins/9293cc0e-11c2-49ea-91b1-5f5aac2428e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1d9555f0f838c79f7462df11d464c29 2x, https://si.imgix.net/ee1c8136/uploads/origins/9293cc0e-11c2-49ea-91b1-5f5aac2428e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d4e812a71291e6652fb2020a4957d43 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nskebを受け付けたと知りましたので、リクエストをさせていただきます。\n\nあおとちゃん(ウサダヒカリさん)とミーチャさん、そして私のキャラクター「ムーディ」が一緒にいる場面のイラストをお願いいたします。\nムーディは体がこんにゃくの様にやわらかく腕の多いクリーチャー系のキャラクターです。\n\n設定としては\n・お腹をすかせたあおとちゃんとミーチャさんがムーディに遭遇した場面。\nムーディはあおとちゃんの好物のカップ焼きそばを差し出している。\n(どの腕で持っていてもOK)\n\n・あおとちゃんは食べたそうにしている。\n・ミーチャさんはムーディを謎のクリーチャーと警戒してパニックになっている。\n\nというものを想像しています。\n\nお二人が共に行動している様子がとてもかわいらしいのと、未知の存在に出会った時のリアクションの差が気になることもありこういうテーマのリクエストをさせていただきました。\nムーディの頭身やポーズはお任せします。また、構造でわからない所などは描きやすい様にアレンジしても差し支えありません。\nその他特に指定のない部分に関しても、描きたい様に制作していただければと思います。\n\n気長にお待ちしておりますので時間のある時の制作で問題ありません。\nよろしくお願いいたします。\n\nhttps://twitter.com/SAFE_MODE_C/status/1692486803474055282", "created_at": "", "completed_at": ""}, {"path": "/@coumav/works/10", "thumbnail_src": "https://si.imgix.net/00249d6f/uploads/origins/7f76e02f-c8df-4fc0-ac6a-e417cff20560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fc25186312af5a2097ef4778e807e9", "thumbnail_srcset": "https://si.imgix.net/00249d6f/uploads/origins/7f76e02f-c8df-4fc0-ac6a-e417cff20560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fc25186312af5a2097ef4778e807e9, https://si.imgix.net/00249d6f/uploads/origins/7f76e02f-c8df-4fc0-ac6a-e417cff20560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b054772266f9e91ec52f938d79b92679 2x, https://si.imgix.net/00249d6f/uploads/origins/7f76e02f-c8df-4fc0-ac6a-e417cff20560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d47b66f9de34101ca0774089037c878 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nアートの依頼をしたいのですが。\n\nうちの子リブートくんが服(パーカー)をたくし上げてお腹を出すところを描いてください。ローアングルでお願いします。\n\nこの絵（左のキャラクター）がとても好きです→https://twitter.com/UkayHevel/status/1678321909375852545、同じようなシーンを描いてみてください！(照れくさそうな表情で、服をたくし上げている）。\n\nパーカーは、私の友人のキャラクター、ティギーくんのものを使ってください。彼の参考画像はこちら→ https://twitter.com/MyroTiggy/status/1157639972364660739\n\nあなたの絵も結構好きです→https://twitter.com/coumav/status/1666392055906553859、股のところからの蒸れの描き方も。\n\nリブートくんの参考画像→ https://drive.google.com/drive/folders/1PwTM3Gia_YmFn9zsPa4UxulWmKJ9iyfM?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@coumav/works/9", "thumbnail_src": "https://si.imgix.net/69321bf3/uploads/origins/93cba3b6-603a-433c-b68d-2fa5324eaa99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=849ab29dbf57667b2d81153eb5348892", "thumbnail_srcset": "https://si.imgix.net/69321bf3/uploads/origins/93cba3b6-603a-433c-b68d-2fa5324eaa99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=849ab29dbf57667b2d81153eb5348892, https://si.imgix.net/69321bf3/uploads/origins/93cba3b6-603a-433c-b68d-2fa5324eaa99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2755475e3b19424c4ab4a06e16418b42 2x, https://si.imgix.net/69321bf3/uploads/origins/93cba3b6-603a-433c-b68d-2fa5324eaa99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ddb8d7e375dc054a26568b6baccfabb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私の黄色いぽっちゃりしたキツネのアートを依頼したいのですが、シーンは考えていないので、芸術的な自由を十分に与えたいと思います！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1gcC6IWKUqHjd7Xa3Bn9Zy8R3AZ1dXrAN", "created_at": "", "completed_at": ""}, {"path": "/@coumav/works/8", "thumbnail_src": "https://si.imgix.net/17224f59/uploads/origins/1f487eb9-1956-4834-968f-fded8b1f6533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc