ba7e-a60ea42b9c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4387679a8b4adf812fe5c6b20247a969 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの描き方はとても特別だと思います。\nこの絵（https://twitter.com/Gomarucket/status/1645399145056993281）のタイトなズボンを履いたお尻の描き方が好きなので、私のOCがこのようなズボンを履いている絵が欲しいです。\n更衣室（体育の授業の前とか）で着替えて、横にいる同級生に恥ずかしそうに挨拶しているところを描いてほしい。彼のお尻はタイトなズボンで覆われていて、上半身は裸でも体操服を着ていても構いません。上半身は裸でも、体操服を着ていても、自由です。ただ、前に描いてくれた絵のように、後ろ姿にしてください。(https://twitter.com/Gomarucket/status/1645399145056993281)\n以下は私の参考資料です: https://www.pixiv.net/artworks/76201113\nありがとうございました！\n\nhttps://www.pixiv.net/artworks/76201113", "created_at": "", "completed_at": ""}, {"path": "/@Gomarucket/works/11", "thumbnail_src": "https://si.imgix.net/72f566cd/uploads/origins/e5c73059-e06d-47de-8c79-8566a0b6134b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=360b958b17eb11eb0b6fdb923e7c7f6b", "thumbnail_srcset": "https://si.imgix.net/72f566cd/uploads/origins/e5c73059-e06d-47de-8c79-8566a0b6134b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=360b958b17eb11eb0b6fdb923e7c7f6b, https://si.imgix.net/72f566cd/uploads/origins/e5c73059-e06d-47de-8c79-8566a0b6134b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97e7fd01fc9989e8533dd1874a1ca56b 2x, https://si.imgix.net/72f566cd/uploads/origins/e5c73059-e06d-47de-8c79-8566a0b6134b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=195a4049ce1753b7824ed63a32b4aa9b 3x", "genre": "art", "nsfw": false, "body": "スマートフォンゲーム「メルクストーリア」のキャラクター「獣に交じる者」ロニセラを描いてください。腹筋が少し見える程度でお願いします。その他は自由に描いていただいて構いませんが、可愛らしさのアピールとして膝と太ももの一部は見せてください。\n\nこの絵をSNSのプロフィール画像やバナーに使用する許可をお願いします。\n\nhttps://gamerch.com/mercstoria/entry/510692", "created_at": "", "completed_at": ""}, {"path": "/@Gomarucket/works/10", "thumbnail_src": "https://si.imgix.net/3b2c0354/uploads/origins/c339bfab-37d1-46e4-873e-ecc3dc6adb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a69ec4527ff6690c4a14c6eedca8534b", "thumbnail_srcset": "https://si.imgix.net/3b2c0354/uploads/origins/c339bfab-37d1-46e4-873e-ecc3dc6adb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a69ec4527ff6690c4a14c6eedca8534b, https://si.imgix.net/3b2c0354/uploads/origins/c339bfab-37d1-46e4-873e-ecc3dc6adb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=368d68eceb5e56c30f06393e726341ec 2x, https://si.imgix.net/3b2c0354/uploads/origins/c339bfab-37d1-46e4-873e-ecc3dc6adb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea22a0283fcff1c6355fac00517dd91d 3x", "genre": "art", "nsfw": false, "body": "吾丸さん初めまして。\nイラストをお願いしたいのですが。制服姿のキャラクターです。その他、表情などは自由です。以下のリンクが私のキャラクターです。ありがとうございました！\n\nhttps://drive.google.com/file/d/1Vp38f_vyQR6A3sLgKtOkkqYA0b3jTTJv/view", "created_at": "", "completed_at": ""}, {"path": "/@Gomarucket/works/9", "thumbnail_src": "https://si.imgix.net/36ac598c/uploads/origins/73aae59a-3a74-4a8c-9225-1dfdd5e085ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17e40a85b691a31644c8a8c7de99eb88", "thumbnail_srcset": "https://si.imgix.net/36ac598c/uploads/origins/73aae59a-3a74-4a8c-9225-1dfdd5e085ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17e40a85b691a31644c8a8c7de99eb88, https://si.imgix.net/36ac598c/uploads/origins/73aae59a-3a74-4a8c-9225-1dfdd5e085ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ad6e17171720c986fd0394ce7ce8083 2x, https://si.imgix.net/36ac598c/uploads/origins/73aae59a-3a74-4a8c-9225-1dfdd5e085ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf0511d97b834a530871da6a479d7ce3 3x", "genre": "art", "nsfw": false, "body": "吾まるさん、こんにちは！\n先日はとても可愛い作品をありがとうございました！！\n\nそして、よろしければまたお願いできませんでしょうか？\n依頼内容は前回と同じく、ワタシのVRChatアバターのウサギ娘、マロンちゃんです。\n\n前回とても可愛らしく元気に描いていただいたので、今回は吾まるさん的なちょっと男の子っぽく元気でやんちゃ感？を出していただけると嬉しいです。\n衣装は前回と同じキャミとスカートを希望ですが、吾まるさん流にぜんぜんアレンジしていただいて（むしろ違う衣装でも）かまいません！！\n\nぜひ、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1y_l1CgdnZgvHj9PI7fngOuVME8vC4QzD?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Gomarucket/works/8", "thumbnail_src": "https://si.imgix.net/211afbe7/uploads/origins/befe7b9b-6efa-43ce-8bef-05df19b56721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae1a117fc8b09fd71d2b530f1d8bfdf", "thumbnail_srcset": "https://si.imgix.net/211afbe7/uploads/origins/befe7b9b-6efa-43ce-8bef-05df19b56721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae1a117fc8b09fd71d2b530f1d8bfdf, https://si.imgix.net/211afbe7/uploads/origins/befe7b9b-6efa-43ce-8bef-05df19b56721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=239b0676f53b67edb7d429048a6f6219 2x, https://si.imgix.net/211afbe7/uploads/origins/befe7b9b-6efa-43ce-8bef-05df19b56721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a2beb8b4d83008fba513964ba6d3ddc 3x", "genre": "art", "nsfw": false, "body": "吾まる先生、お世話になっております。\n前回の絵は本当に素晴らしかったです！\n今回またイラストを描いていただきたくて依頼しました。\n\n前回と同じ、自分のオリジナルキャラクター「風羽翼」のイラストをお願いしたいです。\n風羽翼は、雪国（北海道みたいな感じ）に住む人間の世界に興味を持つ15歳のアカギツネ少年です。\n学校ではいつも成績優秀な生徒ですが、とてもやんちゃな一面も持っています。\nちなみに、左目は水色、右目は紺色です。\n今回使用したい衣装は前回と異なります。 よりお行儀の良い学生服風の衣装です。 先生にはもっと可愛くてヤンチャで活発と描いて頂きたいです。\n\n具体的な構図とポーズなどはお任せします。\n先生のインスピレーションをすごく楽しみにしています。\n\n今回の用途について、\nSNSへの掲載やサムネイルでの利用を考えています。\nまた、（販売用ではないですが）グッズの作成と印刷を考えています。\n金額について、先生が自由に調整して再送してもかまいません。\n可能であれば人物と背景は分けていただきたいです。\n\nご検討のほど、よろしくお願いいたします。\nありがとうございました。\n\nhttps://drive.google.com/file/d/1uZvy2r5iBiEmcCB4pJ8TEl8Z1rc72_lN/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Gomarucket/works/7", "thumbnail_src": "https://si.imgix.net/7731acfc/uploads/origins/2c84b6f1-e068-4e49-9729-17f567e99dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55847519f544e9834277cebbe0ff5e37", "thumbnail_srcset": "https://si.imgix.net/7731acfc/uploads/origins/2c84b6f1-e068-4e49-9729-17f567e99dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55847519f544e9834277cebbe0ff5e37, https://si.imgix.net/7731acfc/uploads/origins/2c84b6f1-e068-4e49-9729-17f567e99dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06a5bf61a52efea7a61b0c463dfc1ab0 2x, https://si.imgix.net/7731acfc/uploads/origins/2c84b6f1-e068-4e49-9729-17f567e99dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ace62d0bb7ea3806ee802f96027775f 3x", "genre": "art", "nsfw": false, "body": "吾まる先生、初めまして、風羽と申します。\n先生のキラキラの絵が大好き、いつも特別な素敵なイラスト拝見しております。\n今回イラストを描いていただきたくて依頼しました。\n\n自分のオリジナルキャラクター「風羽翼」と友達「中中」一緒にいるのイラストをお願いしたいです。\n風羽翼は、雪国（北海道みたいな感じ）に住む人間の世界に興味を持つ15歳のアカギツネ少年です。\nちなみに、左目は水色、右目は紺色です。\n「中中」はスポーツが好きな優等生の12歳の人間少年で、体操服と白いパンストが好きです（赤面しますが）。\n\n可能であれば、背景や要素は星空感のあるものをお願いしたいです。\n構図とポーズなどはお任せします。\n先生のインスピレーションをすごく楽しみにしています。\n\nイラストはSNSへの掲載やサムネイルでの利用を考えています。\n可能であれば人物と背景は分けていただきたいです。\n\nご検討のほど、よろしくお願いいたします。\n\n「風羽翼」https://drive.google.com/file/d/1Ds_PB566WRp6narHALLelIkK59IGUXNy/view?usp=share_link\n「中中」https://drive.google.com/file/d/1Hr_bPMOc001NInhDejr22C-AROH6fdqc/view?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Gomarucket/works/6", "thumbnail_src": "https://si.imgix.net/246a27a7/uploads/origins/386865d5-4c19-451a-82a1-bace5006b91b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4719d9347feb9f0cd401a744b99f867", "thumbnail_srcset": "https://si.imgix.net/246a27a7/uploads/origins/386865d5-4c19-451a-82a1-bace5006b91b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4719d9347feb9f0cd401a744b99f867, https://si.imgix.net/246a27a7/uploads/origins/386865d5-4c19-451a-82a1-bace5006b91b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35a3ec24034035a91e1bbe3849782478 2x, https://si.imgix.net/246a27a7/uploads/origins/386865d5-4c19-451a-82a1-bace5006b