d2d9bd9f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a5b17c8d6ffb29995091af1adf1266, https://si.imgix.net/25907bf5/uploads/origins/c3d3ea48-5432-48bf-9cb0-4d2d9bd9f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b16dac9cccf83bebfa51c1b688007ef 2x, https://si.imgix.net/25907bf5/uploads/origins/c3d3ea48-5432-48bf-9cb0-4d2d9bd9f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bed050635d4a52c4913485d8d930c8e9 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。再度ご依頼させていただきます。\n今回ご依頼したいキャラクターは、別の時間軸（パラレル）でのイメージとなります。\n\n【シーン詳細】\n状況: 睡眠姦\n描写のポイント:\n服装、髪、口元に体液が付着している様子をご描写ください。\n下腹部がペニスの挿入によってわずかに膨らんだ状態\n【ポーズ指定】\nうつ伏せで寝ている姿勢。\n顔は横を向いている状態。\n\n今回、新たなキャラクターを追加しました。彼は支配欲の強い白髪の黒肌の少年です。彼に睡眠中に犯され、貞操帯を装着され、エネルギー摂取の方法まで支配されるシチュエーションを創作してください。（貞操帯の様式は衣服上のエネルギー紋様です）\n\n中出し後、目を見開くと同時に、体内からエネルギーを吸い取られる描写をお願いします。\n\n必要であれば資金を調達することもできる。\nごゆっくりお楽しみください！\n\n攻：https://drive.google.com/drive/folders/1a6jhEJRvmT7dFHxDzsqdyt0cAaO5p6ex?sort=11&direction=d\n受：https://drive.google.com/drive/folders/1V_m9HxELvwy2sbTMTSznsABA0j76Xj5t?sort=11&direction=d", "created_at": "", "completed_at": ""}, {"path": "/@XXX_o000/works/46", "thumbnail_src": "https://si.imgix.net/f94704ad/uploads/origins/60768ef8-a6cd-408c-9989-edba71075a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e420f0de2aad5df249ada00f5365f4", "thumbnail_srcset": "https://si.imgix.net/f94704ad/uploads/origins/60768ef8-a6cd-408c-9989-edba71075a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e420f0de2aad5df249ada00f5365f4, https://si.imgix.net/f94704ad/uploads/origins/60768ef8-a6cd-408c-9989-edba71075a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dc7f4a27f7c1249e222603c0c0981b8 2x, https://si.imgix.net/f94704ad/uploads/origins/60768ef8-a6cd-408c-9989-edba71075a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba0dbe6395246132f33fb1df120df85f 3x", "genre": "art", "nsfw": true, "body": "こんにちは、前回は素敵なイラストありがとうございます。今回も依頼のほどよろしくお願いします。\n\n悪堕ち形態のイラストを依頼したい\nシーン：私はタイトスーツを着たイケメンの通行人を捕まえ、路傍の茂みに連れ込む。\n体位：https://drive.google.com/drive/folders/1Vs_MyZYmyC8XYDwXthDlOhWhbl3ppHyM?sort=11&direction=d\n表情指定：通行人は最初は抵抗する表情、次第に快楽に溺れ、最後は仰向けに解放される。悪堕ちした私は最初は不敵な笑み、その後は絶頂眼に変化する。\n\n场景：我抓住一个穿着紧身衣的帅哥路人后去到路边的草丛中。\n体位：https://drive.google.com/drive/folders/1Vs_MyZYmyC8XYDwXthDlOhWhbl3ppHyM?sort=11&direction=d\n表情指定：路人一開始有掙扎的表情、後面越來越享受過程，最後仰面釋放。恶堕的我則开始是不懷好意的笑容、後面变化为高潮眼。\n\n白黒キャラの差をつけて欲しい\n必要であれば資金を調達することもできる。\nごゆっくりお楽しみください！\n\nhttps://drive.google.com/drive/folders/1-7DHOIBkb7sEQXiWl9EOi6w2v-4xo67d?sort=11&direction=d", "created_at": "", "completed_at": ""}, {"path": "/@XXX_o000/works/45", "thumbnail_src": "https://si.imgix.net/7b9d7eac/uploads/origins/0779f5cd-ae48-417f-a65c-d084a64d58a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfdcc1997ce6dab3e743c2f61a41c6e7", "thumbnail_srcset": "https://si.imgix.net/7b9d7eac/uploads/origins/0779f5cd-ae48-417f-a65c-d084a64d58a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfdcc1997ce6dab3e743c2f61a41c6e7, https://si.imgix.net/7b9d7eac/uploads/origins/0779f5cd-ae48-417f-a65c-d084a64d58a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc41940808831240e2787def51f956a9 2x, https://si.imgix.net/7b9d7eac/uploads/origins/0779f5cd-ae48-417f-a65c-d084a64d58a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecdab49b51766ea00ca98707ddc3e90c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@XXX_o000/works/44", "thumbnail_src": "https://si.imgix.net/8f523dbe/uploads/origins/7fcccaf0-e929-4528-8e8f-8f2539020fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab11dd78830ec9db3e554b07f32b25be", "thumbnail_srcset": "https://si.imgix.net/8f523dbe/uploads/origins/7fcccaf0-e929-4528-8e8f-8f2539020fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab11dd78830ec9db3e554b07f32b25be, https://si.imgix.net/8f523dbe/uploads/origins/7fcccaf0-e929-4528-8e8f-8f2539020fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f7612ae5a5d2bdfc92dbf0be7a3ed6a 2x, https://si.imgix.net/8f523dbe/uploads/origins/7fcccaf0-e929-4528-8e8f-8f2539020fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bfe26b757eb9c7807fca38e976ca62f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@XXX_o000/works/43", "thumbnail_src": "https://si.imgix.net/e0b70c3b/uploads/origins/c4bc9613-9145-4df4-b812-ce5247301be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2498b6d503829bbd4579b73803e755b5", "thumbnail_srcset": "https://si.imgix.net/e0b70c3b/uploads/origins/c4bc9613-9145-4df4-b812-ce5247301be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2498b6d503829bbd4579b73803e755b5, https://si.imgix.net/e0b70c3b/uploads/origins/c4bc9613-9145-4df4-b812-ce5247301be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96a4565f94cf48b082ab3236c7c6ea44 2x,