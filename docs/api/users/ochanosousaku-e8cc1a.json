a5d-4fdb-43b1-b5f2-5cd854e3c955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23f78da1cc820cfed84cafee1641363b", "thumbnail_srcset": "https://si.imgix.net/6e5abf8a/uploads/origins/462f1a5d-4fdb-43b1-b5f2-5cd854e3c955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23f78da1cc820cfed84cafee1641363b, https://si.imgix.net/6e5abf8a/uploads/origins/462f1a5d-4fdb-43b1-b5f2-5cd854e3c955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f045ce34227afabacb6c474eac15ef6c 2x, https://si.imgix.net/6e5abf8a/uploads/origins/462f1a5d-4fdb-43b1-b5f2-5cd854e3c955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7398b53fc8b258d02111204fec15bb2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのアートスタイルがとても好きで、あなたのスタイルで私のVtuberのアートワークを受け取りたいと思っていました。\n\nレミーはオオカミ少年の漁師で、とてもおバカで陽気で怠け者です。彼が夏の終わりを祝う夜祭で太鼓を叩いている夏のアートを期待していたいです。本当にありがとうございました。\n\nSNSへの掲載、販促用グラフィックへの使用、スケジュール表への併記などを予定しています。画像は他の様々な活動に使用することがありますが、決して営利目的ではなく、必ずクレジットを表示します。\n\nhttps://imgur.com/a/pqNDK84", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/23", "thumbnail_src": "https://si.imgix.net/73590f67/uploads/origins/c36d74db-6fb7-4212-91ba-c31a084c76da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9be2065e50afdaf6425e1494c3de53e", "thumbnail_srcset": "https://si.imgix.net/73590f67/uploads/origins/c36d74db-6fb7-4212-91ba-c31a084c76da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9be2065e50afdaf6425e1494c3de53e, https://si.imgix.net/73590f67/uploads/origins/c36d74db-6fb7-4212-91ba-c31a084c76da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=343ccd71033a9136cd980c5598d81f6e 2x, https://si.imgix.net/73590f67/uploads/origins/c36d74db-6fb7-4212-91ba-c31a084c76da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c04f207ae91419eef8bceecdb658b86 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/22", "thumbnail_src": "https://si.imgix.net/0a5b25fe/uploads/origins/0532dce0-cf1d-4c97-89fd-05b43a34864f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf25b3a2775bb789668352ec3082c62", "thumbnail_srcset": "https://si.imgix.net/0a5b25fe/uploads/origins/0532dce0-cf1d-4c97-89fd-05b43a34864f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf25b3a2775bb789668352ec3082c62, https://si.imgix.net/0a5b25fe/uploads/origins/0532dce0-cf1d-4c97-89fd-05b43a34864f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccebc7f58c066940fe76e5302413c86d 2x, https://si.imgix.net/0a5b25fe/uploads/origins/0532dce0-cf1d-4c97-89fd-05b43a34864f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2b233aa51bec142d9ff44361e5a01eb 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nクトゥルフ神話TRPG「アンダーデッドテイカー」というシナリオのPC2人を描いていただけないでしょうか(PLには許可頂いてます)\n\n◾︎希望\n・可能であれば、紫百三の誕生日を自宅でケーキ囲んでお祝いしているようなシーンだと嬉しいです。\n・構図、服装等、お任せいたします。(好きに変えていただいて問題ありません)\n\n◾︎人物設定\n藤蜜(HO不死身)\n男/見た目22歳/197cm\n大型犬気質な活発な人間。諦めが悪く執着心が強め。\n紫百三 (HO葬儀屋)\n男/32歳/170cm\n中性的な美人。物腰柔からな面倒見の良い人間。印象よりメンタルタフ。 \n\n◾︎使用用途\n・相方PLとのデータ共有\n(skebでの依頼であることを共有したうえで行います。)\n・個人的なグッズ制作(利益の発生しないもの)\n・trpgでの使用(スチルのようなイメージ)\n\nもし金額が足りないようであれば、適当な金額でのアピールをお願いします。\n何卒ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Jn-1MRsKY5lDyoQkpLq0qlVomQZjLQvZ", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/21", "thumbnail_src": "https://si.imgix.net/948ab8bb/uploads/origins/49a2544c-a1e8-4997-b253-f7f1f45c6ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d9244b2f54ff636e3bd4663bf060ce", "thumbnail_srcset": "https://si.imgix.net/948ab8bb/uploads/origins/49a2544c-a1e8-4997-b253-f7f1f45c6ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d9244b2f54ff636e3bd4663bf060ce, https://si.imgix.net/948ab8bb/uploads/origins/49a2544c-a1e8-4997-b253-f7f1f45c6ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c259bb975963939d04012ecdffc22513 2x, https://si.imgix.net/948ab8bb/uploads/origins/49a2544c-a1e8-4997-b253-f7f1f45c6ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc7f11be88d725359a6cea8c7e3f7bd0 3x", "genre": "art", "nsfw": false, "body": "はじめまして。ocha様のイラストを拝見し、とても心を惹かれぜひ友人とTRPGで遊んだ際に使用したキャラクター二人を描いていただきたいと思いリクエストに参りました！\n\n下記の二人をお願いしたいです。\n\n▼デザイン外観\n❖A\n身長174cm\nシルバーブロンドの髪に紫の瞳\nピアスが向かって右側に二つ、左に一つ(デザインはなんでも大丈夫です)\n\n❖B\n身長181cm　\n紫の髪色/髪の下部は黒　はちみつ色の瞳\n凶悪なギザギザの歯が特徴的です。\nピアスが左右三つずつ、計六つ\n\n▼性格/関係性\n妖精と蜂蜜がモチーフの小さなお菓子屋さんで働くオーナーシェフとアルバイトで恋人同士。\n\nA：いつも穏やかな笑顔を浮かべている。 Bを子犬のように可愛がっている。\n\nB：真面目で優秀だが、元ヤンなのでたまに口が荒くなる。Aが大好き。\n\nAは穏やかに微笑んでいることが多く基本的に上品ですが、朗らかに笑うこともあります。Bは真面目ですがAの前だと笑顔や喜怒哀楽の表現が増えます。\n\n▼構図/シチュエーション/衣装など\nこちらocha様の自由に表現をしていただければとっても嬉しいです！\n\n金額、リクエスト内容等問題があれば調整、再送の方をさせていただければと思います。生活に無理のない範囲で御一考よろしくお願いいたします。\n\nhttps://www.notion.so/skeb-182cc4018b558014a600dadaca0b49ad?pvs=4", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/20", "thumbnail_src": "https://si.imgix.net/047736bd/uploads/origins/bb629f16-3365-47c0-9b7c-75e22a12cff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84150c5f6b3d5c157dfdaac40d0de05f", "thumbnail_srcset": "https://si.imgix.net/047736bd/uploads/origins/bb629f16-3365-47c0-9b7c-75e22a12cff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84150c5f6b3d5c157dfdaac40d0de05f, https://si.imgix.net/047736bd/uploads/origins/bb629f16-3365-47c0-9b7c-75e22a12cff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be6dbc6e80041d7ffddca84dc0acb5e9 2x, https://si.imgix.net/047736bd/uploads/origins/bb629f16-3365-47c0-9b7c-75e22a12cff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92645da273995a90fb349e31e8a512d8 3x", "genre": "art", "nsfw": false, "body": "ochaさま、はじめまして。\nキャラクターの空気感が伝わるやわらかいイラストに惹かれ、TRPGで遊んでいるうちよそOCをリクエストさせていただきます。\n\nキャラの説明：\n💛探偵（玉木奈胡）：身長161cm。29歳。一人称は私。\nローテンションでマイペース、ゆるゆるっとした探偵。\n独特な感性で集めた石碑的なオブジェやゆるキャラなどのぬいぐるみを事務所に飾っている。\n自分の趣味のグッズを買うために事務所の経費で落としており、助手に叱られている（が、なんだかんだ許してもらっている）。\n鏡に頼ることが多いものの、自分のことも頼って欲しい。\n中高生時代には鏡を異性として意識する瞬間もあったが、関係性を壊したくなくて適度な距離感を保っていた。\n\n💚助手（鏡遙真）： 身長174cm。30歳。一人称は俺。\nエリート街道真っ只中の弁護士で、副業で探偵業（主に事務）を手伝っている。\n自分が優秀であることを自覚していて尊大な性格。\n他人には猫かぶって穏やかな性格を装っているが、玉木といるときは自然体。\n玉木に対し「助手が優秀で良かったな」などと言うことが多い。\n幼少時より自分を気にかけてくれた玉木一家には感謝しており、また口にはしないが玉木本人にも感謝している。\n表面上は玉木に手厳しい態度をとっているものの、なんだかんだ甘い。\n\n2人の関係性：\n気のおけない幼馴染で、幼い頃に探偵ごっこをやっていた延長線で探偵と助手をしている。\n鏡が中学生時代に両親を亡くしており、玉木の両親が天涯孤独となった鏡を気にかけ、食卓を共にするなど家族ぐるみの付き合い。\n互いを大切に思っているが、相手の情について幼馴染・腐れ縁の情だと思っており、両片想い。\n付き合いが長くお互い無意識に距離感が近い。\n\n💛→💚　鏡呼び。家族だと思っているし信頼している。恋愛は終わりを迎えると関係が切れると思っているので幼馴染・探偵助手の関係を続けていたい。\n\n💚→💛　玉木呼び。ずっと一緒にいたいけど、相手が恋愛関係になることを望んでなさそうな雰囲気を察しているため、自分が恋愛感情を抱いていることに罪悪感がある。\n\n服装などに関してはお任せしたいです！\nもうすぐ玉木の誕生日のため、お祝いの雰囲気があるイラストであると嬉しいです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1akQwxRmdIM9hVzTLOL4rqRhnrv-1q1OR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/19", "thumbnail_src": "https://si.imgix.net/8a4d8a29/uploads/origins/26f2f707-e7be-4b08-a584-3b0a2a221a67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58acc5ac13f3d5a98c82392b853a336", "thumbnail_srcset": "https://si.imgix.net/8a4d8a29/uploads/origins/26f2f707-e7be-4b08-a584-3b0a2a221a67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58acc5ac13f3d5a98c82392b853a336, https://si.imgix.net/8a4d8a29/uploads/origins/26f2f707-e7be-4b08-a584-3b0a2a221a67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da1208e6412e0b9b3cf16913dbf63497 2x, https://si.imgix.net/8a4d8a29/uploads/origins/26f2f707-e7be-4b08-a584-3b0a2a221a67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b981845242e02ade3b7286dcf2e4002 3x", "genre": "art", "nsfw": false, "body": "ocha 様、ご無沙汰しております。\n再びOCをリクエストさせていただきます。\n\nOC①\nシイハ(19)男、171cm\n・黒髪、前髪あり、さらさら、伸びかけの耳掛けレイヤーボブ\n・真っ黒な瞳の中に、夜空の星が散ったような金色が所々入った不思議な虹彩(魔力過多の影響)\n・垂れ目、いつも眠そうな伏し目、睫毛バサバサ\n・儚げ美青年、色白、華奢\n・魔王を倒した勇者一行の魔法使い\n・口数は少ない、ぼーっとしてる、表情に割と出る(嫌なことは特に)\n\n\nOC②\nサイラス(22)男、184cm\n・金髪、襟足刈り上げ短髪\n・快晴の空色の瞳、吊り目、鋭い\n・ヤンチャしてそう(してる)、顔がいい、躾のなってない大型犬\n・鍛え上げられた細マッチョ体型\n・魔王を倒した勇者\n・シイハを絶対囲い込むという固い決意を長年持っている重い男。シイハの身の回りのことを全てやりたがる(できる)\n\n\n※二人は同じ孤児院の出身、幼馴染、恋人\n※魔法が使える中世ファンタジーな世界観\n※揃いの銀のブレスレット(シンプル)を着用、これはシイハからの贈り物\n※『穏やかな休日』をテーマに描いていただきたいのですが、顔がよく見える近接でも引き目の離れた感じでも構いません。ocha様にお任せします。\n\n\n使用目的として、小説投稿アプリ(表紙、出版等の予定なし)、印刷して個人鑑賞を予定しています。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/18", "thumbnail_src": "https://si.imgix.net/542d23ad/uploads/origins/6c0153f9-79db-4cc4-8604-f06252eba18a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b63d0d6bd7b4184e6e9023ba19e09125", "thumbnail_srcset": "https://si.imgix.net/542d23ad/uploads/origins/6c0153f9-79db-4cc4-8604-f06252eba18a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b63d0d6bd7b4184e6e9023ba19e09125, https://si.imgix.net/542d23ad/uploads/origins/6c0153f9-79db-4cc4-8604-f06252eba18a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66cfe6c12358988d21fe1ad05dd16ca0 2x, https://si.imgix.net/542d23ad/uploads/origins/6c0153f9-79db-4cc4-8604-f06252eba18a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1d2bb457d6d5836356ff8d6fc57a55d 3x", "genre": "art", "nsfw": false, "body": "ocha先生、こんにちは \n毎回とても素敵なイラストありがとうございます\n今回も前回と同じOC2人のイラストをお願いしたいです。   \nイラスト使用目的と前回と同じです   \n\n資料\n\nhttps://drive.google.com/drive/folders/1-2FjRC3vjaElyMN9qXnj1GDVmD8D2qMf\n\n(petitster先生がアップした自用テンプレートを使ったocイメージ図、得られた許可も資料に更新されました）\n\nシーン：\n庭院で紅葉を眺めながら、お茶を飲み、お茶菓子を楽しむ二人のデートシーンが欲しいです。\n\n服、構図、ポーズなとは自由に決めてください。\n\n今回もよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1-2FjRC3vjaElyMN9qXnj1GDVmD8D2qMf", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/17", "thumbnail_src": "https://si.imgix.net/ce66f4db/uploads/origins/53c6339b-45e7-40ec-ac40-84d6e33e16b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6daf667ada68d9e6f39ab193d5a3290", "thumbnail_srcset": "https://si.imgix.net/ce66f4db/uploads/origins/53c6339b-45e7-40ec-ac40-84d6e33e16b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6daf667ada68d9e6f39ab193d5a3290, https://si.imgix.net/ce66f4db/uploads/origins/53c6339b-45e7-40ec-ac40-84d6e33e16b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9f576f6e47639da8dc7afd923dc8f41 2x, https://si.imgix.net/ce66f4db/uploads/origins/53c6339b-45e7-40ec-ac40-84d6e33e16b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65fc0b55f583cbb2b3b3aff91f32a383 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ochanosousaku/works/16", "thumbnail_src": "https://si.imgix.net/95eac8f5/uploads/origins/1a477ea8-c112-445a-aee9-76b97f5eabb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e139a43171059694a8f9e686df98b6a", "thumbnail_srcset": "https://si.imgi