&s=7e5f838658ca9c9f3ba140a870a0c23e 2x, https://si.imgix.net/46781be2/uploads/origins/02f3e3d3-10e4-4724-a9ac-1fd73b277a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee4d342d0f18467359909a7e9d97c2cb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nakano0829/works/148", "thumbnail_src": "https://si.imgix.net/9856f0d9/uploads/origins/20f0a9ed-c050-4b48-a6da-db704bdf1c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d22c2d2248680139e3bb8a7a44ce6f2a", "thumbnail_srcset": "https://si.imgix.net/9856f0d9/uploads/origins/20f0a9ed-c050-4b48-a6da-db704bdf1c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d22c2d2248680139e3bb8a7a44ce6f2a, https://si.imgix.net/9856f0d9/uploads/origins/20f0a9ed-c050-4b48-a6da-db704bdf1c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=185c91ff663547c6cc14635a2decb756 2x, https://si.imgix.net/9856f0d9/uploads/origins/20f0a9ed-c050-4b48-a6da-db704bdf1c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09a644e73b878a609d9b83cbebe61aab 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの作品、特にペルソナのアートが大好きです！\n\n私のペルソナ5のOC、赤羽姫美子（あかばね きみこ）を明智吾郎と一緒に描いてくれたら光栄です。彼女は彼のアシスタントであり、メタバースにおける共犯者です。二人は仕事のパートナーであると同時に、王子様とお姫様のようなダイナミックなロマンチックな関係でもあります。\n\n明智はクロウプリンスの衣装で、姫美子は怪盗プリンセスの衣装で、二人のロマンチックなポーズやクールなポーズを描いていただけませんか？\n\n物足りないようでしたら、お値段をアピールしてください！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1BWJwsLbq0y9kJW95cIBhCndLU03PH2jW?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nakano0829/works/147", "thumbnail_src": "https://si.imgix.net/96bf3283/uploads/origins/1082d236-af25-407f-9ee9-d676fb418faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5f6f0d400c2174190116b92f84e4cfd", "thumbnail_srcset": "https://si.imgix.