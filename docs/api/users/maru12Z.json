w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04b642bef91e66bb1d08eba885e4869f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/15", "thumbnail_src": "https://si.imgix.net/8b8a499c/uploads/origins/3cbe4d77-fb02-466c-a7ca-3dc393ee56d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d8bd6e8d2ac1b85fb44e63c1d81b20a", "thumbnail_srcset": "https://si.imgix.net/8b8a499c/uploads/origins/3cbe4d77-fb02-466c-a7ca-3dc393ee56d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d8bd6e8d2ac1b85fb44e63c1d81b20a, https://si.imgix.net/8b8a499c/uploads/origins/3cbe4d77-fb02-466c-a7ca-3dc393ee56d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48369639b6be8ea9986ac0d2df76c1e3 2x, https://si.imgix.net/8b8a499c/uploads/origins/3cbe4d77-fb02-466c-a7ca-3dc393ee56d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac66b43780f0314008ff2d3b8a36118c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/14", "thumbnail_src": "https://si.imgix.net/27560cc3/uploads/origins/55fafa75-50ec-4b9c-acd5-7532ca5f16e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74e53c4da5c42c7d7ec49b3c04731afe", "thumbnail_srcset": "https://si.imgix.net/27560cc3/uploads/origins/55fafa75-50ec-4b9c-acd5-7532ca5f16e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74e53c4da5c42c7d7ec49b3c04731afe, https://si.imgix.net/27560cc3/uploads/origins/55fafa75-50ec-4b9c-acd5-7532ca5f16e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51a651a95350da36bd7ddc58dad06220 2x, https://si.imgix.net/27560cc3/uploads/origins/55fafa75-50ec-4b9c-acd5-7532ca5f16e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90f7d5200402b1ee4cb5b1d25109845f 3x", "genre": "comic", "nsfw": true, "body": "初めまして。いつもほんわかしてエッチなイラストをありがとうございます。\nこの度初めてリクエストさせていただきます。\n\nVOICEVOXの音声ライブラリのキャラクター、猫使アルと猫使ビィの無知シチュ初エッチのコミックをお願いします。\n\n公式設定になかったり複数種類ある設定は、今回は以下の設定を採用してください。\n●アル・ビィ共通\n種族：半有機物・半無機物の人工生命体\n性知識：皆無\n●アル\n性別：男\n一人称：おれ\nおちんちん：小さくて皮被り\n●ビィ\n性別：女\n一人称：私\n\n内容は以下の流れでお願いします。\nアルとビィが偶然野良猫の交尾を見てしまう。\n湧き上がる性的興奮に戸惑う。\nお互いの性器を愛撫する。\n本能的に後背位エッチする。\n二人同時に絶頂して、中出しフィニッシュする。\n\n流れに書いていない部分はお任せします。\n\nご検討よろしくお願いします。\n\nhttps://nekotukarb.wixsite.com/nekonohako", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/13", "thumbnail_src": "https://si.imgix.net/f0c2b82c/uploads/origins/20cf4a31-901d-4853-8d01-58463f637232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9009adb8dd424d2cc381a95c01e1aca8", "thumbnail_srcset": "https://si.imgix.net/f0c2b82c/uploads/origins/20cf4a31-901d-4853-8d01-58463f637232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9009adb8dd424d2cc381a95c01e1aca8, https://si.imgix.net/f0c2b82c/uploads/origins/20cf4a31-901d-4853-8d01-58463f637232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbe7452a599a5fd8d512e3922cd97f43 2x, https://si.imgix.net/f0c2b82c/uploads/origins/20cf4a31-901d-4853-8d01-58463f637232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=092cb270b32dc7204c0c52940fb3723d 3x", "genre": "comic", "nsfw": true, "body": "はじめまして、\n\nアズレン大鳳のえっち絵は依頼可能でしょうか？\n（大鳳に関しては健全絵が多いようだったので、だめであればスイマセン。。）\n\n\nもし可能であれば、下記のようなシチュの漫画を描いていただけないでしょうか？\n\n\n◎大まかなシチュ\n\n性欲溜まってて断れないタイミングで指揮官を誘惑してくる大鳳と\n誘惑に負けてイチャラブ搾り取られエッチしてしまう\n\n\n◎プロット\n\n１週間ほど立て込んでいた業務が片付いて、やっとゆっくり寝れるぞと\n自室に戻ったら、大鳳が部屋の中にいる（衣装はお任せします）\n\nなんで部屋に？と問いかけると\n「仕事でお疲れの指揮官様を、大鳳の身体で癒してあげたいと思い♡」という感じで誘惑\n\n疲れマラとしばらく忙しさで抜けてないので誘惑に屈しそうになるが\n最後の理性で、「指揮官とKAN-SENでこんなことダメだよ…」と断ろうとするが\n大鳳を服を脱ぎ、裸体を見せつけてきながら\n「本当によろしいのですか？…大鳳のこの身体好きにしていいですよ♡」と再押し誘惑で理性決壊して結局ヤってしまう\n\n\nプレイおまかせします。\n画として、恋人つなぎ騎乗位があるとうれしいです。\n\n終わり方として、こってり絞られて「も、もう射精でないよ大鳳…」と止めようとするが\nパイズリで強制勃起させられて\n「ふふっ♡嘘はいけませんわ指揮官様♡　指揮官様のおちんちんはまだまだ大鳳に射精したいと言ってますわ♡」\nという感じで\n\n「その後、夜明けまで絞られ続けた」…的な終わり方だと嬉しいです。\n\n\n----\n\n金額感合わないようでしたら、再送依頼かキャンセルしていただればです\nもしよろしければお願いします", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/12", "thumbnail_src": "https://si.imgix.net/d578ad03/uploads/origins/d37f9d38-e1d9-45d2-885f-d36b25a075c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1646942255948b01a3254d0a46e2b110", "thumbnail_srcset": "https://si.imgix.net/d578ad03/uploads/origins/d37f9d38-e1d9-45d2-885f-d36b25a075c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1646942255948b01a3254d0a46e2b110, https://si.imgix.net/d578ad03/uploads/origins/d37f9d38-e1d9-45d2-885f-d36b25a075c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8f773ee529f1a659e8f99b0f348f51e 2x, https://si.imgix.net/d578ad03/uploads/origins/d37f9d38-e1d9-45d2-885f-d36b25a075c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45fd81c74f5fc2f4df7c0e008a9b1fcc 3x", "genre": "comic", "nsfw": true, "body": "お久しぶりです〇先生、先生にはいつか色々後々頼む予定があったのですが今現在ネットで\n『お前それ次やったらマジで〝これ〟だからな\n(パイズリのジェスチャー)』というパイズリの言葉なのに各企業も乗っかる一大ブームに発展致しましたので旬に乗っかりたく緊急で\n　前と同じくうちの子（たくみきゃっと）とのパイズリセックスで\n　①南の島のビーチにカップルで旅行に来たうちの子（ビキニ👙付けている）とショタ彼氏くん（海パン１枚）2人で浜辺でラブラブに海を満喫する。\n　②ショタ彼氏くんはうちの子含め年上のお姉さんにモテモテな体質のため他の観光客のお姉さんに逆ナンパされてすり寄られる。彼氏くんは女性の免疫が無いので恥ずかしさとまんざらでもないように照れてしまう\n見てしまったうちの子が彼氏くんにむすっと嫉妬混じりな怒りの表情で「次やったら〝これ〟だからね」と言い両手でおっぱいをパイズリ風にセルフパイ揉みしパイズリのジェスチャーを行う。\n彼氏くんはうちの子の凶悪なおっぱいと爆乳パイズリ責めに恐怖を感じてしまう。\nが…しかしまた目を離した束の間また彼氏くんは別のお姉さんに抱きつかれる大胆な逆ナンパを受けうちの子の怒りが頂点に達する。\n　③（場面が切り替わり夜、リゾートラブホテルのカップル客室のベッドへ）\nうちの子と彼氏くんはすでに全裸、言いつけを守れず他の女の子に色目を使う（形になってしまった）彼氏くんにお仕置き逆レイプパイズリセックスが始まる。\n彼氏くんが恐怖に怯えながらうちの子の膝上パイズリが 「次やったら''これ''だって言ったよね」と言う台詞と冷酷な怒りの表情と共に開始される。彼氏くんがおっぱい暴力パイズリにおちんちんを激しく責めたてられ喘ぎ許しを請い続けるも耐えられず情けなく不様に射精してしまう。\nパイズリだけで怒りは収まらずうちの子は騎乗位逆レイプで彼氏くんの腰を掴みおまんこにちんちんを呑み込み精子を搾り取る。\n　④アフターピロートーク\n彼氏くんはうちの子に精子を搾り取られてぐったりしてしまう、2人は裸のままベッドに入り布団の中で抱き合って（おっぱいの乳首が見える部分から少し下まで布団を被っている。うちの子は彼氏くんのお顔をおっぱいに埋め愛おしそうに抱きしめる\n\nhttps://x.com/a07812810/status/1900486822540747118", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/11", "thumbnail_src": "https://si.imgix.net/0c439b7c/uploads/origins/7339adb6-ecf4-4857-8bcb-29343f169acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d74978a9cad8d8d8904e34f3d73839c", "thumbnail_srcset": "https://si.imgix.net/0c439b7c/uploads/origins/7339adb6-ecf4-4857-8bcb-29343f169acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d74978a9cad8d8d8904e34f3d73839c, https://si.imgix.net/0c439b7c/uploads/origins/7339adb6-ecf4-4857-8bcb-29343f169acc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7ba3faecc63d54fb0f44870869a5c4f 2x, https://si.imgix.net/0c439b7c/uploads/origins/7339adb6-ecf4-4857-8bcb-29343f169acc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d7cb2d28b91a884329ebeb00b1fa571 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、前回は紲星あかりちゃんの乱交パーティーのコミックをありがとうございます。またお願いしたいシチュを思いついたのでリクエストさせていただきます。\nデリヘルを利用するとデリヘル嬢が高校のクラスメイトだった紲星あかりちゃんだった。というシチュでコミックを６ページでお願いします。\n\nキャラ：紲星あかり\n\nシチュエーション\n一人暮らしの青年がデリヘルを利用して指名したデリヘル嬢は、高校のクラスメイトのあかりちゃんだった。\n気まずいながらもサービスを受ける青年。長時間コースを頼んだせいで時間が半分余ってしまい、あかりちゃんの「どうする？」の一言に本番行為してたいと言ってしてしまう青年とそれを断るあかりちゃん。青年の懇願に根負けしたあかりちゃんと本番行為をしてしまう。という感じでお願いします。\n\nストーリーの流れ\n１ページ目\n一人暮らしの青年（仮名：古林）が自宅（マンション）で、スマホを使ってデリヘル嬢を検索している。スマホの画面には目元を隠された下着姿のあかりちゃんが映っている\n↓\n奮発して１２０分コースでデリヘル嬢「ひかり」を指名する\n↓\n「あわよくば、本番行為ができないかな？」と思いながら到着を待つ古林青年\n↓\nチャイムが鳴り、ドアを開けると高校のクラスメイトだった紲星あかりちゃんが立っている\n\n\n２ページ目\nお互いの名前を呼びながら驚く二人\n↓\n場面変って寝室、古林青年は全裸、あかりちゃんはタオルを巻いて並んでベッドに腰掛けている。準備万端だが気まずい雰囲気\n↓\n意を決したあかりちゃんが手コキを始める\n↓\n手コキからパイズリに変えるあかりちゃん\n↓\nパイズリからフェラに変えて、古林青年の男根を咥えるあかりちゃん\n\n\n３ページ目\nフェラで射精する古林青年、１回戦終了\n↓\n「まだ１時間残ってるけど･･･どうする？」と聞かれた古林青年は、思わず「本番やりたい」と言ってしまう。当然、断るあかりちゃん\n↓\n必死に懇願する古林青年、諦めて承諾するあかりちゃん。\n\n\n４ページ目\nあかりちゃんにバックで挿入して激しく腰を振る古林青年（二人を真横から見ている構図で、大きなコマでお願いします）\n↓\n体位を背面座位に変えて行為を続ける二人（大きなコマでお願いします）\n\n\n５ページ目\n体位を立ちバックに変更して行為を続ける。壁に手を突いたあかりちゃんと、激しく腰を振る古林青年（あかりちゃんのおっぱいがブルンブルン揺れている描写、大きなコマでお願いします）\n↓\n体位を正常位に変更してフィニッシュ、膣内出しされて絶頂するあかりちゃん\n\n\n６ページ目\n事後、ベッドに寝転んで絶頂の余韻を感じているあかりちゃん\n↓\n一ヶ月後、古林青年がソファーに座っていると、チャイムの音が聞こえる\n↓\n「またのご指名ありがとうございます」と言いながら、玄関前に立っているあかりちゃん\n↓\nＥＮＤ\n\n要望\n・１ページ目の最初のコマは、青年が持っているスマホの画面のアップでお願いします。\n\n・あかりちゃんの衣装はA.I.VOICE版の公式衣装でお願いします。\n\n・４～５ページのシーンは、何度も体位を変えて１回の性行為を続けているというイメージ\n\n\n今回はストーリーを重視したかったので、前回以上に指定や要望が細かいのですが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/10", "thumbnail_src": "https://si.imgix.net/3f76e4f8/uploads/origins/6f536fbf-a7e1-4b03-80ab-09f7724026f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8565ce7fd036c5a997be5e2aa8b5168a", "thumbnail_srcset": "https://si.imgix.net/3f76e4f8/uploads/origins/6f536fbf-a7e1-4b03-80ab-09f7724026f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8565ce7fd036c5a997be5e2aa8b5168a, https://si.imgix.net/3f76e4f8/uploads/origins/6f536fbf-a7e1-4b03-80ab-09f7724026f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=895d9df5eea6417b1ae80098efc10788 2x, https://si.imgix.net/3f76e4f8/uploads/origins/6f536fbf-a7e1-4b03-80ab-09f7724026f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=240aba301033848a88d2d7e6a47b2dea 3x", "genre": "art", "nsfw": true, "body": "初めてのリクエストを失礼します。\nMisskeyでのにゃんぷっぷー絵と、pixiv等でのえち絵のコラボが見たいと思ったので、うちの子のまもりちゃんが全裸でにゃんぷっぷーを愛でてるイラストを描いてほしいです。\nベッドの上で、頬ずりしながら愛でてる感じでお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/9", "thumbnail_src": "https://si.imgix.net/44874b68/uploads/origins/4387cbda-72fc-4b65-888b-d7b85ea2f9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab4eaacce01eeaa7303c5667effb6a3a", "thumbnail_srcset": "https://si.imgix.net/44874b68/uploads/origins/4387cbda-72fc-4b65-888b-d7b85ea2f9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab4eaacce01eeaa7303c5667effb6a3a, https://si.imgix.net/44874b68/uploads/origins/4387cbda-72fc-4b65-888b-d7b85ea2f9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d908f316c502cc39f77ca3df778025 2x, https://si.imgix.net/44874b68/uploads/origins/4387cbda-72fc-4b65-888b-d7b85ea2f9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=898c5be6d957cf2e049f26077b95fccb 3x", "genre": "art", "nsfw": true, "body": "アズールレーンのミカサが普通の男性とセックスしているところを描いてください。\nミカサ：https://azurlane.wikiru.jp/?%E4%B8%89%E7%AC%A0\nミカサはhttps://www.pixiv.net/artworks/78528825。\nセックスのためにパンティを脇に押しやる。\n\nミカサはベッドに横たわって、宣教師姿勢でセックスしている。", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/8", "thumbnail_src": "https://si.imgix.net/1cc72e56/uploads/origins/df1da56d-5d41-427a-adeb-c64f5b07b189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9427d51228347d3ea86289e28722364", "thumbnail_srcset": "https://si.imgix.net/1cc72e56/uploads/origins/df1da56d-5d41-427a-adeb-c64f5b07b189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9427d51228347d3ea86289e28722364, https://si.imgix.net/1cc72e56/uploads/origins/df1da56d-5d41-427a-adeb-c64f5b07b189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=318683b27441b6e1492736c04819fffc 2x, https://si.imgix.net/1cc72e56/uploads/origins/df1da56d-5d41-427a-adeb-c64f5b07b189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3456d45f168d6e6223a64ad9b368f386 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/7", "thumbnail_src": "https://si.imgix.net/3b48f722/uploads/origins/590827d2-0f0f-451c-88da-238474d9aa00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4331ea44f408b17c23217d40bb2c0c0f", "thumbnail_srcset": "https://si.imgix.net/3b48f722/uploads/origins/590827d2-0f0f-451c-88da-238474d9aa00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4331ea44f408b17c23217d40bb2c0c0f, https://si.imgix.net/3b48f722/uploads/origins/590827d2-0f0f-451c-88da-238474d9aa00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1d18e0e2b4ac61170835e0138262849 2x, https://si.imgix.net/3b48f722/uploads/origins/590827d2-0f0f-451c-88da-238474d9aa00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cde4f5c21031dc51ec57e1aea33fc04 3x", "genre": "comic", "nsfw": true, "body": "前回と設定を参照で同じくうちの子漫画また女性リードのセックスお願いします\nパイズリ→対面座位べろちゅー中出し、おっぱい顔埋めてなでなで→そのまま男を押し倒して密着おっぱい顔埋め騎乗位中出し…→ピロートーク,ベッドで2人で横向きになって下半身シーツ被って射精の疲れで先に寝ちゃった男におっぱいに顔埋めて抱きしめて頭なでなで\n…途中で授乳手コキも挟む…でもページ数負担になりそうなので全体的な範囲も先生の無理ない範囲で\n\nhttps://x.com/a07812810/status/1850345871050932618/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/6", "thumbnail_src": "https://si.imgix.net/00fe68a2/uploads/origins/fc73df5a-e54e-4121-b686-d8e18a5118f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2869c2c6c82667552913409cb06507c1", "thumbnail_srcset": "https://si.imgix.net/00fe68a2/uploads/origins/fc73df5a-e54e-4121-b686-d8e18a5118f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2869c2c6c82667552913409cb06507c1, https://si.imgix.net/00fe68a2/uploads/origins/fc73df5a-e54e-4121-b686-d8e18a5118f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7d0e6373439f5ca7fb1e9fe3f421ac6 2x, https://si.imgix.net/00fe68a2/uploads/origins/fc73df5a-e54e-4121-b686-d8e18a5118f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9552760947d9aa51011a7c807a621952 3x", "genre": "comic", "nsfw": true, "body": "初めましてこんにちは、Ｐｉｘｉｖの「紲星あかりのエロマンガ」を拝見して依頼したくなったのでリクエストさせていただきます。\n紲星あかりちゃん（女子大生という設定）がサークルの呑み会に参加して夜遅くまで呑んでいると、ふとしたきっかけで乱交パーティーが始まってしまい、場の雰囲気と酒に酔っていたこともあって、多数の男達とエッチしてしまうというシチュエーションのコミックをお願いします。\n\n\nキャラ：紲星あかり（A.I.VOICE公式衣装）\n\n\n大まかなストーリー\nシーン１：サークルの飲み会が突然乱交パーティーになってしまい戸惑うあかりちゃん。背後にいる男（サークルの先輩）に服の上から胸を揉まれながら「あかりちゃんとエッチしたい」と口説かれて、乱交パーティーに参加してしまう。\nこのシーンは服を着ている描写でお願いします。\n\nシーン２：一人目の男とのエッチ（乱交パーティー序盤のイメージ）\n\nシーン３：二人目の男とのエッチ（乱交パーティー中盤のイメージ）\n\nシーン４：三人目の男とのエッチ（乱交パーティー中盤以降のイメージ）\n\nシーン５：絶頂するあかりちゃん\n\nシーン６：乱交パーティーはまだまだ終わらないという感じで終了\n\n・１ページ目でシーン１～２　２ページ目でシーン３～４　３ページ目でシーン４の続き～６くらいのイメージです。\n\n\n要望\n・実際には十人前後の男達とエッチしているが、作中ではその中から抜粋して三人の男達とのエッチの様子を見ているというイメージ。\n\n・一人目はあかりちゃんの胸を揉んでいた男を想定しています。\n\n・二人目と三人目は台詞かモノローグで相手が別の男に変わったのがわかるようにしてください。\n\n・あかりちゃんはいきなり始まった乱交パーティーに戸惑っているものの、周りの雰囲気にのまれている上に酔っているせいもあって、まんざらでもない様子で抵抗しない。\n\n・一人目と二人目のエッチに関しては、体位や描写はお任せします。三人目の男とのエッチは背面座位でアナルに挿入されている感じでお願いします。\n\n・エッチ中の男の台詞とあかりちゃんの台詞もお願いします。\n\n\n提示した金額は指定や要望が多いためです。お忙しいとは思いますが、ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/5", "thumbnail_src": "https://si.imgix.net/f3a26703/uploads/origins/5fd5acf3-471a-460d-9278-eb43fce54723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113317b0af32cf42ec3431cd1bb3c022", "thumbnail_srcset": "https://si.imgix.net/f3a26703/uploads/origins/5fd5acf3-471a-460d-9278-eb43fce54723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113317b0af32cf42ec3431cd1bb3c022, https://si.imgix.net/f3a26703/uploads/origins/5fd5acf3-471a-460d-9278-eb43fce54723?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1407901dc9372333ac0ac84c591c87b6 2x, https://si.imgix.net/f3a26703/uploads/origins/5fd5acf3-471a-460d-9278-eb43fce54723?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0ebb5c64ddb7ee1e37f62d48fc3cff7 3x", "genre": "comic", "nsfw": true, "body": "pixivでイラストを見かけたのでリクエストさせていただきます\nキャラクター　鏡音リン　鏡音レンでおねショタH\n\n鏡音リン　大人状態で頭２つぶんほどの爆乳、レン君との体格差は２倍ほど\n鏡音レン　見た目八歳くらいでちんちんの大きさはそれなり\n\n大人になった爆乳をみせつけパイズリ。レン君が挟まれた瞬間暴発\nそのままパイズリ継続で大量射精\nまだぎんぎんなおちんちんを見ておそいかかるようにちんぐり騎乗位気味で中出し\n\n状況にあったセリフをリンレンともにおねがいします。、（見た目おねショタですが中身は１４歳のまま）　よろしくおねがいします", "created_at": "", "completed_at": ""}, {"path": "/@maru12Z/works/4", "thumbnail_src": "https://si.imgix.net/cd086ec6/uploads/origins/a2e19da3-eda3-4b26-81d6-db42f2f2cce3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=424e583c54324b79162f7ae81cd0ab40", "thumbnail_srcset": "https://si.imgix.net/cd086ec6/uploads/origins/a2e19da3-eda3-4b26-81d6-db42f2f2cce3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=424e583c54324b79162f7ae81cd0ab40, https://si.imgix.net/cd086ec6/uploads/origins/a2e19da3-eda3-4b26-81d6-db42f2f2cce3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecbf5c90c67223470ad10224049b8ff7 2x, https://si.imgix.net/cd086ec6/uploads/origins/a2e19da3-eda3-4b26-81d6-db42f2f2cce3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4342e902084976f45eafdc52b65a1bb5 3x", "genre": "comic", "nsfw": false, "body": "", "created_at