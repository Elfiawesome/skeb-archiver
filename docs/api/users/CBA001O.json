3-47d5-b612-62962890db14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c94c976943516b2dd9fd1a56c277617", "thumbnail_srcset": "https://si.imgix.net/a88ed1c2/uploads/origins/52ff446a-6073-47d5-b612-62962890db14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c94c976943516b2dd9fd1a56c277617, https://si.imgix.net/a88ed1c2/uploads/origins/52ff446a-6073-47d5-b612-62962890db14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0a88ef4acacf540489b3a8c803eab70 2x, https://si.imgix.net/a88ed1c2/uploads/origins/52ff446a-6073-47d5-b612-62962890db14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19dc73f3086213bd1ace8f3953f246c4 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nうに先生のイラストがとてもタイプでいつか依頼したいと考えておりました！\n\n今回、私の友人のVtuberが新衣装発表したことと、3月に誕生日が近いということで友人の誕生日イラストをお願いしたくリクエストさせていただきます。\n友人の新衣装と友人の雰囲気が分かるようなムービーを参考資料として添付します\nhttps://twitter.com/rumomon/status/1606647681996443652?s=20&t=1JWecmr_vjHRX2LP2vyH_g\nhttps://twitter.com/n_syusi/status/1606642950158843905?s=20&t=C3RgHKPj2A1HNdiXYNeyAQ\n髪型はツインテールとロングどちらでも大丈夫です。\nできれば、誕生日おめでとう！やhappybirthdayなどの文字を入れた差分もお願いします\n構図はお任せします\nただ、誕生日付近に渡したいなと考えていて3月11日までの納品が難しければお手数ですがリクエストのキャンセルをお願いいたします。\nかなり厳しいリクエストをしてしまってるとは思うのですが、ご一考ください", "created_at": "", "completed_at": ""}, {"path": "/@CBA001O/works/36", "thumbnail_src": "https://si.imgix.net/d6071557/uploads/origins/c86386f6-ef12-4ba1-b903-b4d48c287039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85993d80ff34d01fb875874288adb51f", "thumbnail_srcset": "https://si.imgix.net/d6071557/uploads/origins/c86386f6-ef12-4ba1-b903-b4d48c287039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85993d80ff34d01fb875874288adb51f, https://si.imgix.net/d6071557/uploads/origins/c86386f6-ef12-4ba1-b903-b4d48c287039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72ac516b8a67be6e263c8274b3829e2d 2x, https: