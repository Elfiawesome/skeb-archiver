2-92ad-2bd0f97f72d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8de193715622a95b123c477049044b60 2x, https://si.imgix.net/a9f23013/uploads/origins/e1df026b-a00e-4892-92ad-2bd0f97f72d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22041b87df210fa7d7e6ca30d3a56cfb 3x", "genre": "art", "nsfw": false, "body": "以下の依頼をお願いしたいです！\n忙しさとやる気次第で後回しにしていただいても構いません！\n\n形態　：ヘッダー（主にXに使用）\nキャラ：ジンクス（カフェキューティスキン）\n背景等：お任せします\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momiko_dayo/works/19", "thumbnail_src": "https://si.imgix.net/972986a4/uploads/origins/e3ac81d7-01bd-4fd9-86e4-6c3d83708055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0557b225b02ad2a39ed661e4b6efa236", "thumbnail_srcset": "https://si.imgix.net/972986a4/uploads/origins/e3ac81d7-01bd-4fd9-86e4-6c3d83708055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0557b225b02ad2a39ed661e4b6efa236, https://si.imgix.net/972986a4/uploads/origins/e3ac81d7-01bd-4fd9-86e4-6c3d83708055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88d644357f8fffc47ed01e89a85922a4 2x, https://si.imgix.net/972986a4/uploads/origins/e3ac81d7-01bd-4fd9-86e4-6c3d83708055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=336da429353e4f8588948bded06d769f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@momiko_dayo/works/18", "thumbnail_src": "https://si.imgix.net/9158da70/uploads/origins/d0e67cc4-8587-4ebc-b9fd-6d1bac229c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78438fb887d9554dbd1b518d6cc920a1", "thumbnail_srcset": "https://si.imgix.net/9158da70/uploads/origins/d0e67cc4-8587-4ebc-b9fd-6d1bac229c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78438fb887d9554dbd1b518d6cc920a1, https://si.imgix.net/9158da70/uploads/origins/d0e67cc4-8587-4ebc-b9fd-6d1bac229c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fcc144162df7153ad5dfe6cd5034ba1 2x, https://si.imgix.net/9158da70/uploads/origins/d0e67cc4-8587-4ebc-b9fd-6d1bac229c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1171d81a08014f6181f550060350914 3x", "genre": "art", "nsfw": false, "body": "はじめまして！Vtuber活動をしております、桜桃ぽぽと申します。\n椛子様の絵柄が大好きでよく拝見させていただいておりました！\n是非わたしのキャラクターと大好きなLoLキャラクターのアーリのイラストを描いていただきたく思い、リクエストを送らせていただきました。\n\n使用用途はアイコンや、LoL配信のサムネイルにしたいと考えておりますので透過したものも併せていただけたら嬉しいです。\n\nお忙しい中恐れ入りますが、よろしくお願い致します。\n\nhttps://x.com/_hinapi_/status/1784815270839947277?s=46", "created_at": "", "completed_at": ""}, {"path": "/@momiko_dayo/works/17", "thumbnail_src": "https://si.imgix.net/b183cc3a/uploads/origins/986bad64-58cf-4cb9-9456-81a3986742b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=269caaf63f631ce919e07f7ca027e287", "thumbnail_srcset": "https://si.imgix.net/b183cc3a/uploads/origins/986bad64-58cf-4cb9-9456-81a3986742b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=269caaf63f631ce919e07f7ca027e287, https://si.imgix.net/b183cc3a/uploads/origins/986bad64-58cf-4cb9-9456-81a3986742b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=906f83f9674ea3b1c8060a0186ab285f 2x, https://si.imgix.net/b183cc3a/uploads/origins/986bad64-58cf-4cb9-9456-81a3986742b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdbd8b7892980d6d170731d00cb58564 3x", "genre": "art", "nsfw": false, "body": "はじめまして！かわいいLOLのイラストの魅力でリクエストさせていただきました。\n\nスモルダー(天なる龍スキンのピンクorスキン無しでも可)と\nユーミ(EDGスキン)が一緒にいるところを椛子様の絵柄で描いていただきたいです！\n\n背景透過もあると嬉しいです。\n\n【参考画像】\nスモルダー\nhttps://gyazo.com/bd46e2dcbbe0a19e3da94def43d6fc9d\nhttps://gyazo.com/bd5b50ac667b427fc37144be8f4aa651\nhttps://gyazo.com/ed0427a8e3a8f5d9808f6a12aa66e021\nhttps://gyazo.com/96d519dbead9089ca75793892aeed949\nhttps://gyazo.com/724b5cb6ed683e88debdd6afb19dd203\nユーミ\nhttps://gyazo.com/edfa88142af915591eb895a83ece3e3f\nhttps://gyazo.com/b7fc9616a28bd804a6347250d485da35\nhttps://gyazo.com/b0cb179f2116a105b3acb58ab2252a9f\n\nご検討のほど何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@momiko_dayo/works/16", "thumbnail_src": "https://si.imgix.net/169f537f/uploads/origins/f568ff72-6f65-4976-adf1-92a6640d1885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac4c21a56b1ab2636dbf84c9f116393", "thumbnail_srcset": "https://si.imgix.net/169f537f/uploads/origins/f568ff72-6f65-4976-adf1-92a6640d1885?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac4c21a56b1ab2636dbf84c9f116393, https://si.imgix.net/169f537f/uploads/origins/f568ff72-6f65-4976-adf1-92a6640d1885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5565a240866ff2d2ccd053b8fad8afe3 2x, https://si.imgix.net/169f537f/uploads/origins/f568ff72-6f65-4976-adf1-92a6640d1885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa34450e94827cf1c2938acbfc39caf 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもXにて素敵なイラストを拝見させていただいております。\nよろしければ是非と思い、今回リクエストを送らさせていただきます。\n\n【キャラクター】\n資料URLのうちの子「ルピス（1枚目）」\n\n【シチュエーション等】\nLoLのグウェンの衣装を着させていただきたいです。\nまたぬいぐるみサイズ感覚のレネクトンのスキン「レネクトイ」を抱えているというようなイラストでお願いしたいです。\n\nよろしければアイコン等で使用させていただきく思います。\n\n難しい場合などはお気軽にキャンセルしていただければと思います。\n是非ご検討いただけると幸いです。\n\nhttps://twitter.com/terrorzero02/status/1706345154171580841", "created_at": "", "completed_at": ""}, {"path": "/@momiko_dayo/works/15", "thumbnail_src": "https://si.imgix.net/b9430fa7/uploads/origins/f357e520-8218-45c8-877