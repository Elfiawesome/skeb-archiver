m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9bb239e878711483bddeb2a0cb9c233 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mxm_404/works/9", "thumbnail_src": "https://si.imgix.net/823164c6/uploads/origins/423ccc28-031b-4f52-b66c-7e0e2f5a9bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22ce901a007c1d8297b0f94d88fb9e16", "thumbnail_srcset": "https://si.imgix.net/823164c6/uploads/origins/423ccc28-031b-4f52-b66c-7e0e2f5a9bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22ce901a007c1d8297b0f94d88fb9e16, https://si.imgix.net/823164c6/uploads/origins/423ccc28-031b-4f52-b66c-7e0e2f5a9bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74205b242f3a7853556a3282628774b3 2x, https://si.imgix.net/823164c6/uploads/origins/423ccc28-031b-4f52-b66c-7e0e2f5a9bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a69ae097d768466922e029c2e0ff1fcb 3x", "genre": "art", "nsfw": true, "body": "らもさんこんにちは！\n今回はわたしのキャラクターの衣装をデザインしていただきたいです！\n和装もとい韓服がモチーフの中国国籍キャラクターをイメージしていますが、洋装でも構いません。\nらもさんの思うように描いてください！\n多少露出などがあっても大丈夫です！\n名前:韋蠢痴(ウェイ・チュンチー)\n年齢:13歳\n職業:宗教教祖\n性格:邪悪で無邪気。13歳にして宗教を設立できるほどの知能の高さを持った洗脳の天才だが、世間知らず。生き物が大好きで、趣味は蠱毒と呪術まがいのお遊びです。\nhttps://drive.google.com/drive/folders/1KAATTuwZ0A7cT1zqzt2MLg0QTesRnYxY?usp=sharing\n\nhttps://drive.google.com/drive/folders/1KAATTuwZ0A7cT1zqzt2MLg0QTesRnYxY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mxm_404/works/8", "thumbnail_src": "https://si.imgix.net/debad22b/uploads/origins/0f1de5fd-fa32-459c-bddb-56db537d73d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9aede851e62e3db18f182b00a4b62bc", "thumbnail_srcset": "https://si.imgix.net/debad22b/uploads/origins/0f1de5fd-fa32-459c-bddb-56db537d73d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&