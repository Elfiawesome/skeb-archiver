5-430f-a276-ad2892bc2515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c50f35640bc932763c6d300fa469c2d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Dyginguar/works/56", "thumbnail_src": "https://si.imgix.net/3151ac41/uploads/origins/d975bdfb-22b0-4d1d-942f-6fe0127b6269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104f631334b384d7db01c72a30eb36b8", "thumbnail_srcset": "https://si.imgix.net/3151ac41/uploads/origins/d975bdfb-22b0-4d1d-942f-6fe0127b6269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104f631334b384d7db01c72a30eb36b8, https://si.imgix.net/3151ac41/uploads/origins/d975bdfb-22b0-4d1d-942f-6fe0127b6269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df6fa25ae4d779bdbbf673a146a918cf 2x, https://si.imgix.net/3151ac41/uploads/origins/d975bdfb-22b0-4d1d-942f-6fe0127b6269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=680c5a6e7392a39413a50ee89664f1f2 3x", "genre": "art", "nsfw": true, "body": "ONE PIECEナミ、NARUTO綱手、BLEACH松本乱菊のジャンプ爆乳キャラからのHサービスを\nリクエストしたいと思います。\n\nhttps://gyazo.com/9a2ea3f4d4e104a82ea85af28accc2dc\n\n参考図の構図で、左からナミ、中央綱手、右に乱菊の並びで、\nナミ→乱菊→綱手の順でパイズリをしていって欲しいです。\n綱手パイズリの番で、ナミの右乳と乱菊の左乳を鷲掴みで寄せて綱手パイズリで射精\n→綱手ひょっとこフェラでお掃除。\n\n三人とも質量たっぷりの美爆乳おっぱいで、ナミと乱菊は同じくらい。\n綱手は二人よりちょっとだけ大きいカンジでお願いします。\n\n検討宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Dyginguar/works/55", "thumbnail_src": "https://si.imgix.net/ea40084c/uploads/origins/6422f923-87e9-4b04-9f22-c1fe2b3a356c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15782753f3b7ba526615b21a8d0fbbc7", "thumbnail_srcset": "https://si.imgix.net/ea40084c/uploads/origins/6422f923-87e9-4b04-9f22-c1fe2b3a356c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15782753f3b7ba526615b21a8d0fbbc7, https://si.imgix.net/ea40084c/uploads/origins/6422f923-87e9-4b04-9f22-c1fe2b3a356c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae4eb40541239235ef0b32ca6a5c200c 2x, https://si.imgix.net/ea40084c/uploads/origins/6422f923-87e9-4b04-9f22-c1fe2b3a356c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c57f2ceccd66b4f070674bca49000163 3x", "genre": "art", "nsfw": true, "body": "ノリノリで淫語連発応援付きバイブ咥え込みガニ股腰ヘコデカパイ揺らしして自分の持ち主であるマスター(竿役)のオナサポをしてくれる遊戯王のRAI-MEIをリクエストします。\n\n1枚目：乳揺らし前。バイブが挿入される。少しニヤついた表情でオナニーを促してくる\n\n2枚目：腰を前後を振り乳揺らし中。眼前のチンポに夢中といった様子で一枚目から更に崩れ恍惚とした表情になり、淫語を羅列した応援をしてくる\n\n3枚目：バイブによる刺激で絶頂する。大きく白目を剥いたキツめのアへ顔で濁点混じりの汚いアへオホ声を絶叫する。\n\n…といった3シーンの差分をお願いします。視点は竿役の一人称視点で正面寄りから見た姿を膝下まで写して欲しいです。竿役と書きましたが一枚目の手以外は男性の体や男性器は写さず、RAI-MEI単体で大丈夫です。\n\n服装はカードのイラストと同じ物をベースに1枚目のみ完全着衣、2枚目以降は股間と胸部先端がハート型に切り取られ、バイブ挿入及びパフィーニップル気味で大きめサイズの乳首と乳輪が完全に露出している状態です。\n\n乳のサイズは頭の倍は大きく、かつ臍の少し上まで届き服のデザインが隠れすぎない位を目安に、超乳クラスにして下さい。\n\nまた、それぞれの状況に合わせたRAI-MEIのセリフを付けて下さい。キャラの性格は｢ビッチっぽいけどマスター一途なイチャラブ系｣をベースにダイギンガーさんの想像したお好きなイメージで、とにかく下品な内容で画面を埋めて欲しいです。\n\nかなり細かい注文が多くなってしまい申し訳ありませんが何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Dyginguar/works/54", "thumbnail_src": "https://si.imgix.net/a52e2463/uploads/origins/9682ffda-fb3f-4824-a770-9386d10a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c826ceb05547e42088021e49853f76e9", "thumbnail_srcset": "https://si.imgix.net/a52e2463/uploads/origins/9682ffda-fb3f-4824-a770-9386d10a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c826ceb05547e42088021e49853f76e9, https://si.imgix.net/a52e2463/uploads/origins/9682ffda-fb3f-4824-a770-9386d10a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e9eff42da1aec44013735fafaecd84f 2x, https://si.imgix.net/a52e2463/uploads/origins/9682ffda-fb3f-4824-a770-9386d10a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a13c8eccfe198bd67b49c5bcbcc3f2a 3x", "genre": "art", "nsfw": true, "body": "爆乳おっぱいで馬乗りの形でパイズリ抜きしてくれる八意永琳をお願いしたいです。\n\nおいで❤️の形から、胸にフル勃起の竿をセットで、じゃあ挟むよ❤️と圧迫パイズリ→交互パイズリ→抜きにかかるズリ上げパイズリで射精。\n射精はゆっくりマグマのようなどくどく乳内射精。\n\nおっぱいサイズは仰向けでもボリューム感たっぷりなKカップ超え。\n竿修正は黒線修正でお願いします。作者さんの竿描写がすごく好きです。\n\n可愛くエッチに抜き抜きしてくれる永琳をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Dyginguar/works/53", "thumbnail_src": "https://si.imgix.net/5eb6a09c/uploads/origins/7d7dfe82-7924-423b-b1b9-90cef5b3732a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a8c4759f23aae35c83adab882c0d12d", "thumbnail_srcset": "https://si.imgix.net/5eb6a09c/uploads/origins/7d7dfe82-7924-423b-b1b9-90cef5b3732a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a8c4759f23aae35c83adab882c0d12d, https://si.imgix.net/5eb6a09c/uploads/origins/7d7dfe82-7924-423b-b1b9-90cef5b3732a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=739247f16ac2b31645f642f7905aff52 2x, https://si.imgix.net/5eb6a09c/uploads/origins/7d7dfe82-7924-423b-b1b9-90cef5b3732a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bff8d5ae191b0d116417009f74e802ae 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Dyginguar/works/52", "thumbnail_src": "https://si.imgix.net/03a553ec/uploads/origins/4e07727a-ac85-47ea-ba72-781472bc9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddedeaf08300e783e3ab288d4bc68fb3", "th