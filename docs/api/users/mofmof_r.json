4ed5-a8be-876ab16c9c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1295296f10e5355a0d291835300df0a0, https://si.imgix.net/4a90af06/uploads/origins/d0fd4055-393e-4ed5-a8be-876ab16c9c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4667f1c601052d8c803cce3fbbc1ff4 2x, https://si.imgix.net/4a90af06/uploads/origins/d0fd4055-393e-4ed5-a8be-876ab16c9c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2693f2142fb908e53b7f0229c37580e 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです!何度もお世話になっております。\n今回も引き続き粘着拘束のイラストのリクエストで、構図としては以前のももこやみたまさんと似たようなものです。今回粘着拘束の対象はマギアレコードの神楽燦ちゃんで、魔法少女時の衣装としてください。\nシチュエーションとしては、魔女の攻撃で両足を含む体のあちこちをネバネバだらけにさせられたというもので、両手や頭のガトリング砲も銃口がネバネバで塞がれてしまったものとしてください。\nネバネバの質感はこれまでと同様とし、色もピンクとしてください。セリフや表情はお任せします。\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mofmof_r/works/156", "thumbnail_src": "https://si.imgix.net/13c3cabd/uploads/origins/1f3beae6-3709-4d85-b9a5-28bfa01212a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46641c2eab1aee11ee1cdc1a9145d8b4", "thumbnail_srcset": "https://si.imgix.net/13c3cabd/uploads/origins/1f3beae6-3709-4d85-b9a5-28bfa01212a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46641c2eab1aee11ee1cdc1a9145d8b4, https://si.imgix.net/13c3cabd/uploads/origins/1f3beae6-3709-4d85-b9a5-28bfa01212a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b7abe3b388d2c18895fd648d9e9f710 2x, https://si.imgix.net/13c3cabd/uploads/origins/1f3beae6-3709-4d85-b9a5-28bfa01212a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67bd7325dac28317b38e0e5df858c305 3x", "genre": "art", "nsfw": true, "body": "かりんさん、リクエストさせてください！\n\nキャラ\n東北きりたん\n\n衣装\nうちの子制服のブレザーで、体内シーンではベストでお願いします！\n\n以前書いてもらった｢メスガキきりたんの丸呑みシチュ｣を、ワーム側に少し設定追加した状態で新しく描いてほしいです！\nhttps://x.com/i/status/2017154477716099575\n\nワーム 設定\n\n｢ノミコミサマ｣\n\n・食べ物を渡すとなんでも願いを叶える神様と言われている\nその本性は｢お願いしてきた女の子も苗床としてお願いを叶える怪物｣\nちゃんとお願いは叶えるが、その間はワームの体内でエネルギーを吸収され続けてしまう\n\nシチュ 内容\n\nサムネのシーン\n説明だけ描いているシーンをお願いします！\n【ノミコミサマ】\n・何でも願いを叶える神様\n・食べ物と■■をもって｢ノミコミサマ、食べてください｣と唱える\n・あなたの願いは神の■の中で、、\n\nという説明セリフをお願いします！\n\nここからシチュの内容になります！\n\n①モブ女子を描いて貰って、ノミコミサマの噂の紙を渡すシーンをお願いします！\n\nhttps://x.com/i/status/2017158967026393311\n構図はこんな感じで、うちの子制服を着たモブの女の子が、表情は見えないで、口元だけ笑っている\nが｢ノミコミサマ｣と描かれた紙を渡すイメージです！\n\nセリフもお願いします！｢あなたも気になる？\n食べ物を渡せばなんでも叶える神様の話♪｣ってセリフをお願いします！\n\n②【放課後】\nって場面転換を入れてもらって\n食べ物(簡単なチョコとかパンみたいな)を持ったきりたんが、汗をひとつかいて｢ノミコミサマ、、怖いけど友達に会えるなら、、！｣ってセリフを言\nう、きりたんのシーンをお願いします！\n\n③｢ノミコミサマ、食べてください｣\n｢ノミコミサマ、食べてください、、！｣\nと目を閉じてお願いしているきりたんのシーンをお願いします！\n正面アングルで上半身を描いて貰えれば大丈夫です！\n\n④真っ黒背景に、ノミコミサマのセリフだけのシーンをお願いします！\n｢我を呼んだのはお前か、、｣\n｢その身体、願いのために頂くぞ、、｣\nってセリフをお願いします！\n\n⑤コマを2つに分けてもらって、きりたんが後ろを振り向いて｢！？｣となるシーンを上のコマで、下のコマにワーム型の口が｢グワッ！｣と目の前に迫っているシーンをお願いします！\n\n⑥きりたんが頭から丸呑みされて、｢んむぅ！？｣とくぐもった悲鳴をあげるシーンをお願いします！\n\n⑦足をバタバタさせながら抵抗しているシーンをお願いします！\n｢んむぅ！ むぐぅ！｣ってセリフと(気持ち悪いっ、、)って心の声もお願いします！\n\n⑧全身呑まれて膨らみにされ、｢モゴッ、モゴォ！｣と抵抗しているきりたんのシーンをお願いします！\n(嫌っ、、助けて、、)って心の声もお願いします！\n\n⑨ノミコミサマのお腹の中に収まって｢ゴックン、、｣\nとなるシーンをお願いします！\n｢美味い、、｣\n｢さて、少女の願いを聞いてやるとしよう、、｣ってセリフをお願いします\n\nここから体内シーンをお願いします！\nきりたんは制服ネバネバまみれで、肉壁だけあまり光沢がないイメージでお願いします！\n\n⑩https://x.com/i/status/2017179797789831558\nこんな感じで肉壁が広めの状態で、いつもより遠めの等身で拘束されているきりたんのシーンをお願いします！\n｢嫌ぁっ、、なんでこんなことに、、っ｣セリフを、涙目でお願いします！\n\n⑪ノミコミサマのセリフと涙目のままのきりたんのシーンをお願いします！\n｢お前の願いは亡き友人に会いたい、か、、｣\n｢難しい願いだからな、、1年ほど体力を吸収させて貰う。\n我の腹の中でな｣\nってセリフをお願いします！\n\n⑫ドクン、ドクンって体内の音と一緒に、きりたんのセリフのシーンをお願いします！\n｢何の話なのっ、、｣\n｢私は食べ物をあげたらなんでも願いを叶えてくれるって、、｣\nってセリフをお願いします！\n\n⑬ノミコミサマが説明するシーンをお願いします！\n\n｢それは違う、あれは人を集めるための方便だ｣\n｢我はお前のような少女を取り込み、エネルギーを溜め願いを叶える怪異よ｣ \nってセリフをお願いします！\n\n⑭きりたんが真実を知ってさらに抵抗するシーンをお願いします！\n｢全然動けないっ、、泣｣\n｢ヤダヤダっ！！  ここから出してぇ！｣\nってセリフをお願いします！\n\n⑮ノミコミサマのセリフと、触手が伸びてくるシーンをお願いします！\n｢にゅる、、ジュルル、、｣って効果音と、\n｢フフッ、そう抵抗し続けてくれ、、我もその方が吸収しがいがある、、｣\n｢では、始めるぞ、、｣ってセリフをお願いします！\n\n⑯ワームの外側がモゴモゴと激しく蠢いて、きりたんのくぐもった声が漏れるシーンをお願いします！\n｢おごっ！？｣｢んぶぅ、、！｣｢んむむっ！！｣\nってイメージでお願いします！\n\n⑰また体内のシーンに戻って、口に触手が突っ込まれて喘いでるきりたんのシーン