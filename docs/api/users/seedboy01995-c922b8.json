c2d74/uploads/origins/e0742e84-abaa-45fb-8a9d-a40fcb5df817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab9d93d66197d81bd0788c135453c3d", "thumbnail_srcset": "https://si.imgix.net/ca4c2d74/uploads/origins/e0742e84-abaa-45fb-8a9d-a40fcb5df817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab9d93d66197d81bd0788c135453c3d, https://si.imgix.net/ca4c2d74/uploads/origins/e0742e84-abaa-45fb-8a9d-a40fcb5df817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c05e1033e845b7babf43f2f2d12db18 2x, https://si.imgix.net/ca4c2d74/uploads/origins/e0742e84-abaa-45fb-8a9d-a40fcb5df817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dec62b18abfe9b6aa454c5998dce28ad 3x", "genre": "art", "nsfw": false, "body": "おはようございます、種田優太さん。\n\n今回は種田優太さんにイラストの依頼を申請に来ました。\nお題は「好きになった瞬間」です。\n誰かを好きに、あるいは好かれた経験を皆さんもあったはず。結果はいずれにしましても、きっと一生の大事な思い出...\nそんな甘酸っぱいな青春の1ページを種田優太さんに頼みたいです、メインキャラの設定は思春期の男子二人で、そのほかのシチュエーションや人物など種田優太さんにお任せします。\n個人的に規制されるべき内容ではありませんっと判断しましたが、種田優太さんも同じ捉え方でしたら幸いです。\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@seedboy01995/works/35", "thumbnail_src": "https://si.imgix.net/4adf2c18/uploads/origins/6ad70e1e-bb05-4915-9f45-05d9df121ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdfed7767a8e545a1a2dc936957f46a", "thumbnail_srcset": "https://si.imgix.net/4adf2c18/uploads/origins/6ad70e1e-bb05-4915-9f45-05d9df121ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdfed7767a8e545a1a2dc936957f46a, https://si.imgix.net/4adf2c18/uploads/origins/6ad70e1e-bb05-4915-9f45-05d9df121ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c827d04a21386309fa9a47cadd4fafd 2x, https://si.imgix.net/4adf2c18/uploads/origins/6ad70e1e-bb05-4915-9f45-05d9df121ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fb0ff23e8d743182c953cb282eb20f7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのかわいいアートスタイルが本当に大好きです!\n私と友達のFFXIVのララフェルのイラストをお願いしたいです!\n朝、一緒に登校しているところを描いてください。\n男の子は両腕を胸に当てて教科書を持っているような感じでお願いします。\n内気な性格ですが、とても優しく、女の子と仲良しです。今、彼女が言ったことに笑っているところを描いてください。\n女の子はとても高慢な性格ですが、男の子には特に優しい一面もあります。好きで、ツンデレなんです。照れくさそうに顔を赤らめて目をそらし、男の子が彼女の言ったことに笑っているところを描いてください。\nまた、サメのような鋭い歯を持っています。\n背景は校門か、田舎の町並みを歩いているような感じでお願いします。季節は春です。\nありがとうございました。\n男の子： https://i.imgur.com/EkpECtv.png\n女の子： https://i.imgur.com/5JTtCek.png", "created_at": "", "completed_at": ""}, {"path": "/@seedboy01995/works/34", "thumbnail_src": "https://si.imgix.net/d047d97a/uploads/origins/82c05db9-64c3-4094-84f3-787603ba0a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=794fdb15e762d29c9b5de9565ec2778c", "thumbnail_srcset": "https://si.imgix.net/d047d97a/uploads/origins/82c05db9-64c3-4094-84f3-787603ba0a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=794fdb15e762d29c9b5de9565ec2778c, https://si.imgix.net/d047d97a/uploads/origins/82c05db9-64c3-4094-84f3-787603ba0a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7898951aa3dacee40e9c8b2b30459a53 2x, https://si.imgix.net/d047d97a/uploads/origins/82c05db9-64c3-4094-84f3-787603ba0a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74e4df882dbb3e08c67124dbb0477b90 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n種田さんの柔らかい雰囲気のイラストが本当に好きで、いつも陰ながら見させていただいています。\n\nファイナルファンタジーXIVの自分のキャラクターのイラストを描いていただきたいです。\n参考(SS): \nhttps://twitter.com/Eve_atk/status/1509546610757316615\n\nポーズは参考ツイートの1枚目のような、優しく微笑みかけているようなものでお願いいたします。\n衣装の色は、「こんな色が似合うのではないか」などあれば変更いただいて構いません。\n\nSNSのアイコンなどに利用させていただきたいと思っています。", "created_at": "", "completed_at": ""}, {"path": "/@seedboy01995/works/33", "thumbnail_src": "https://si.imgix.net/5fc45c99/uploads/origins/61e1e9be-341a-4417-b5d5-6a6f5858a822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ae65962d2afbf303d905e62f28163e7", "thumbnail_srcse