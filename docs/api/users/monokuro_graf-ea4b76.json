8998d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02f1c0eb1d445dd93029ed7c02463ba0, https://si.imgix.net/62682581/uploads/origins/da68b9da-db6f-4e51-bab7-545c78998d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba6f1ccdd66241237fe4967b17ce6a71 2x, https://si.imgix.net/62682581/uploads/origins/da68b9da-db6f-4e51-bab7-545c78998d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39dfececd4d4c97386da5832879c0da3 3x", "genre": "art", "nsfw": false, "body": "こんばんは！ひよこです！\n\n坂本美緒さんのアイドル衣装を何卒よろしくお願い致します！！！\n引退している設定で、ポニテの耳と尻尾は付けている(カチューシャ等)感じでお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@monokuro_graf/works/14", "thumbnail_src": "https://si.imgix.net/0ffe3dbb/uploads/origins/68ef2a79-1fde-41b7-ad7d-6fc6fd4072d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ede10e56b773526c15c7429e6b41de98", "thumbnail_srcset": "https://si.imgix.net/0ffe3dbb/uploads/origins/68ef2a79-1fde-41b7-ad7d-6fc6fd4072d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ede10e56b773526c15c7429e6b41de98, https://si.imgix.net/0ffe3dbb/uploads/origins/68ef2a79-1fde-41b7-ad7d-6fc6fd4072d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ea493d32106399da4c001072f355b56 2x, https://si.imgix.net/0ffe3dbb/uploads/origins/68ef2a79-1fde-41b7-ad7d-6fc6fd4072d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c96ca2605170f9776d93221226739475 3x", "genre": "art", "nsfw": false, "body": "初リクエスト失礼します。\n\nブレイブウィッチーズのエディータ・ロスマンさんが居室いっぱいに巨大化してしまい、困惑しているイラストを描いていただけないでしょうか。\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@monokuro_graf/works/13", "thumbnail_src": "https://si.imgix.net/42875058/uploads/origins/f070693b-df0d-404b-af55-f5b3f5f17048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73b4425df7d90eb03f4014111ec6ebe", "thumbnail_srcset": "https://