31d3f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69d4ca17984539a50e92b174eb919371 2x, https://si.imgix.net/bfe2df4f/uploads/origins/0d4f9af9-5a76-417e-9be1-ff7ef31d3f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ba6c92b7cdd52c61d0fca565fedb723 3x", "genre": "novel", "nsfw": false, "body": "いつもお世話になっております。そうべにさんの文章のファンです。\n深夜暴走トリオともんじゃ焼き屋の話が見たいです。文字数などお任せします。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@wabisabi_WSB/works/7", "thumbnail_src": "https://si.imgix.net/66cd59d9/uploads/origins/491d9aee-fbee-451a-9955-3c68cf7ccf58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a04d61596386a6129d6af2944758cf1b", "thumbnail_srcset": "https://si.imgix.net/66cd59d9/uploads/origins/491d9aee-fbee-451a-9955-3c68cf7ccf58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a04d61596386a6129d6af2944758cf1b, https://si.imgix.net/66cd59d9/uploads/origins/491d9aee-fbee-451a-9955-3c68cf7ccf58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeff5c564c03f252c8534958b95cd4b5 2x, https://si.imgix.net/66cd59d9/uploads/origins/491d9aee-fbee-451a-9955-3c68cf7ccf58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5deb2e422c88ef77ddb4046887bf68bf 3x", "genre": "art", "nsfw": false, "body": "そうべに様、リクエスト失礼します。\nアピールを送って頂きありがとうございます！もしよろしければお願いしたいと思いリクエストさせて頂きます！\n\nお題はアピールで頂いた通り「ロングヘアのデュラハンの女の子」です。\n以下詳細を記しておりますので、内容ご確認の上でご検討・ご対応頂ければ幸いです。\n色んなクリエイターの方の発想力・想像力・創作力にお任せしたいので、詳細文のほとんどは他の方と同じ内容になっております。その点ご容赦くださいませ。\nご都合が合わない等ということがありましたら遠慮なくキャンセルしてください。\n\n【詳細】\n・髪の長さは頭３つ分かそれ以上の長さが好ましいです。長い髪を描くとなるとご負担がかかると思いますが宜しくお願いします。\n\n・ヘアアレンジに関しては、お団子やシニヨンなどのまとめ髪系は避けてください。\n　髪の長さが分かる状態であれば、一部分や全体を結ぶ・巻く（ウェーブやカール等）・編み込むなどのアレンジはOKです。キャラのイメージに合わせてお好みで決めてください。\n\n・服装に関してはキャラに合わせてお好みでお願いします。\n\n・首の表現に関しては\n　①肌色で塗る\n　②タートルネックのような首元が隠れる・襟のある服装や画角・構図の関係で見えなくする\n　③アクセサリーやチョーカー等による着飾り・装飾品で隠す\n　などの方法を用いたマイルドな表現をお願いします。別アイデアでも構いません。\n　ただし、性的表現や猟奇的表現・「首から炎や煙が出ている」という表現は避けてください。\n　首部分を描かれる場合は頭側と体側に半々に分かれるように描かれていると嬉しいです。\n\n・頭の持ち方・位置・扱いについては、過去に私がリクエストして描いて頂いた子たち（https://skeb.jp/@hima_ttsu）やSkebの該当キーワードの検索のURL（下記参照）を記載するので、そちらをアイデアの参考にして頂くか、「こういうのもアリでは…？」と思えばそちらでも構いません。\n\n・可能であれば描いて頂いた際の没ラフや、創作時のコンセプト・こだわりポイント等を書いて頂けると嬉しいです！\n\n・納品はPSD形式でお願いします。\n\n・ご不明点等があった際はお好みで判断して描いて下さい。\n\n長文になりましたが、内容以上になります。\nお忙しい中恐縮ですが、お時間のある時に是非ご検討くださいませ。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "created_at": "", "completed_at": ""}, {"path": "/@wabisabi_WSB/works/6", "thumbnail_src": "https://si.imgix.net/951dfa83/uploads/origins/69f20d2b-3ecf-4f2a-a5d8-59ed63cbfcb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa2e810580aed930bad6c162ea1ecf53", "thumbnail_srcset": "https://si.imgix.net/951dfa83/uploads/origins/69f20d2b-3ecf-4f2a-a5d8-59ed63cbfcb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa2e810580aed930bad6c162ea1ecf53, https://si.imgix.net/951dfa83/uploads/origins/69f20d2b-3ecf-4f2a-a5d8-59ed63cbfcb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0074a92439f9ef23dee0fbd30805969e 2x, https://si.imgix.net/951dfa83/uploads/origins/69f20d2b-3ecf-4f2a-a5d8-59ed63cbfcb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e11afc942a0af1c688fe240dd495d139 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wabisabi_WSB/works/5", "thumbnail_src": "https://si.imgix.net/80c88bf0/uploads/origins/37ab7fad-6902-4666-ba99-7eb0de