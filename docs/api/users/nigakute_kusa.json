3d-5d9917c667ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=475d22a69872b0d2c418acb5c6cecd28 2x, https://si.imgix.net/9b76dcef/uploads/origins/ecab4214-c1c3-49cd-8f3d-5d9917c667ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=865cc631cf5d3faa12df52e86de5f73e 3x", "genre": "art", "nsfw": false, "body": "はじめまして、個人で配信活動をしている 冥土 と申します。  \n命メモ様の書くイラストに惹かれ、リクエストを送らせていただきました。 \n私が活動で使用している OC のイラストを書いていただきたいです。   \n\n使用用途：各種SNS、配信でのサムネイルへの使用、自作グッズへの利用、FANBOXなど支援者に対しての配布 等  \nお願いしたいこと：pixivFACTORYというサイトで、自作マグカップを作りたいのですが、その際に命メモ様のイラストを使用させて頂きたいと考えております。\nですので、横 3590×縦 1494 px サイズのものを納品していただきたいです。\nまた、衣装デザインもしていただきたく、していただける際はゴシック・パンク系統でお願いいたします。\n詰め込み風のイラストがとても素敵ですので詰め込み風のイラストをお願いしたいのですが、マグカップにそのまま使用できるデザインのイラストでも嬉しいです。\nサムネイル等にも使用したいと思っておりますので、人物のみ透過されているものを納品して頂きたいです。\n\nお願いしたいことが多くてすみません。  \n資料の不備等ございましたら、再送していただけると幸いです。  \n可愛く仕上げていただけると嬉しいです！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Km2zrbS6z5AJil_l63LxZO1CPN97nKm7", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/157", "thumbnail_src": "https://si.imgix.net/a2b13498/uploads/origins/2857fa9b-6c1d-481b-9f22-c22219977537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a06258ab46c11db568b91c7026ba527", "thumbnail_srcset": "https://si.imgix.net/a2b13498/uploads/origins/2857fa9b-6c1d-481b-9f22-c22219977537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a06258ab46c11db568b91c7026ba527, https://si.imgix.net/a2b13498/uploads/origins/2857fa9b-6c1d-481b-9f22-c22219977537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960c5764fce388f9affcc4ef97bbbb60 2x, https://si.imgix.net/a2b13498/uploads/origins/2857fa9b-6c1d-481b-9f22-c22219977537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f867a356d8a0b3364e44e29a031d61b 3x", "genre": "art", "nsfw": false, "body": "命メモさんはじめまして。今回は私のOCを描いていただきたくリクエスト失礼いたします。\n\nhttps://drive.google.com/drive/folders/119wc1d1OnvOBTZrogPPISdSsyDw6rRl6\n\n基本的に元気で明るく、でも時々病んだりする精神面にブレがある女の子です。明るい笑顔の絵とヒステリックに泣いたり怒ったりしている絵があると嬉しいです。\n構図や服装などはおまかせいたします。\n\n使用用途:個人的鑑賞、印刷、SNSのアイコンやキャラクターシートへの使用\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/156", "thumbnail_src": "https://si.imgix.net/86b4be45/uploads/origins/48828c42-47d9-4100-9e07-775d481df82e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12de138cbbc8bd7e03f3351a40381432", "thumbnail_srcset": "https://si.imgix.net/86b4be45/uploads/origins/48828c42-47d9-4100-9e07-775d481df82e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12de138cbbc8bd7e03f3351a40381432, https://si.imgix.net/86b4be45/uploads/origins/48828c42-47d9-4100-9e07-775d481df82e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deec37c36d36531c4681a5591980d535 2x, https://si.imgix.net/86b4be45/uploads/origins/48828c42-47d9-4100-9e07-775d481df82e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd2288772f5fa7751cb82383d8b4861c 3x", "genre": "art", "nsfw": false, "body": "命メモ様\nこれまでに2回スケブを依頼させていただいた者です。\nどちらも素晴らしいイラストをありがとうございました。\nまた私のocを描いていただきたいと思い、リクエストを送らせていただきます。\n以下は依頼の詳細となります。\n ------\n◼︎キャラ説明\nオカルトが好きな男子高校生です。\nアーモンド型の目をしていて、色はオレンジと茶の中間くらいです。目が悪く、細い金縁の眼鏡をかけています。\n髪の毛は全体的にミルクティー色に染めていて、毛先は青くしています。猫っ毛っぽい感じで全体的にふわふわした感じの髪の毛です。\n襟足部分が少し長くて、ひとつ結びにしています。\n資料のURLを添付いたしますので、詳細なキャラデザインはそちらをご確認ください。\n家庭環境が複雑でストレスが溜まっていて、心霊スポットに行ったりひとりかくれんぼなどの降霊術を行うことで発散しています。その過程で危険な目にあったり呪われてしまっても構わない、むしろ呪われたい、というようなスリルジャンキーな面があります。\n物腰は穏やかですが、拒絶されない限りは初対面の人相手にも遠慮なく話しにいける図々しさもあります。 \n◼︎構図など\nfanboxのskebに関する記事を読ませていただいたのですが、詰め込み構図が本当に可愛かったのでぜひocでも見たいです。\n冬らしい防寒している格好でお願いします。服装についてはお任せいたします。\n下記に提示しております作品内にコートの設定画はあるのですが、同じものでなくて構いません。\n◼︎資料URL\npixivのアカウントに投稿した作品になります。\n基本設定はこちらになります。\n・https://www.pixiv.net/artworks/87323164\n・https://www.pixiv.net/artworks/87580452\n性格や表情などの資料が必要であれば、下記をご確認ください。\n・https://www.pixiv.net/artworks/88393046\n-------\n長くなってしまいましたが、ご検討いただけますと幸いです。\n文末にはなりますが、命メモ様の活動を見ていて、自分もまた絵を描きたいと思うようになれました。これからも命メモ様の活動を応援しております。", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/155", "thumbnail_src": "https://si.imgix.net/c296268f/uploads/origins/74509a54-50b5-45c5-ab3b-9419507670cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c321c9895d37004f86aa598c58b2a8e", "thumbnail_srcset": "https://si.imgix.net/c296268f/uploads/origins/74509a54-50b5-45c5-ab3b-9419507670cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c321c9895d37004f86aa598c58b2a8e, https://si.imgix.net/c296268f/uploads/origins/74509a54-50b5-45c5-ab3b-9419507670cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75035f4c12d62ab929164c299b715681 2x, https://si.imgix.net/c296268f/uploads/origins/74509a54-50b5-45c5-ab3b-9419507670cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7d523744973dfeceacfb07798d37228 3x", "genre": "art", "nsfw": false, "body": "命メモ先生はじめまして。この度はぜひ私のOCを描いていただきたく、リクエストを送らせていただきます。\n\nメサイアコンプレックス気味の中性的な男の子です。\n・参考資料\nhttps://drive.google.com/drive/folders/1QTpGinIL8PQbcXcMa-sV0WMiQP7QwRYm?usp=sharing\n\n資料には服装や髪型が複数ありますが、どの姿でもアレンジしていただいても構いません。\nポーズや表情等もお任せいたします。\n少し不穏でかわいらしい感じに描いていただけるとうれしいです。\n\nよろしければご一考お願いいたします…！", "created_at": "", "completed_at": ""}]}