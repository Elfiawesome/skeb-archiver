2:27.786193+00:00"}, {"amount": 32000, "recorded_at": "2026-02-15T12:43:14.797671+00:00"}, {"amount": 20000, "recorded_at": "2026-02-16T18:09:12.278019+00:00"}, {"amount": 17000, "recorded_at": "2026-02-17T03:33:41.620349+00:00"}, {"amount": 33000, "recorded_at": "2026-02-20T18:18:04.539979+00:00"}, {"amount": 34000, "recorded_at": "2026-02-21T02:46:27.568113+00:00"}, {"amount": 35000, "recorded_at": "2026-02-21T12:12:38.488404+00:00"}]}, "current_prices": {"art": 8000, "comic": 35000}, "price_range": {"art": {"min": 5000, "max": 12000}, "comic": {"min": 14000, "max": 35000}}, "links": [{"label": "Twitter", "url": "https://x.com/oosawagidays", "name": "oosawagidays"}, {"label": "Website", "url": "https://lit.link/inochimemodes", "name": ""}], "flags": {}, "works": [{"path": "/@nigakute_kusa/works/184", "thumbnail_src": "https://si.imgix.net/6514e4e3/uploads/origins/f882f65a-f55a-4d04-8717-abebe62caddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6e6014baaca4223cd8324ea3fba522", "thumbnail_srcset": "https://si.imgix.net/6514e4e3/uploads/origins/f882f65a-f55a-4d04-8717-abebe62caddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6e6014baaca4223cd8324ea3fba522, https://si.imgix.net/6514e4e3/uploads/origins/f882f65a-f55a-4d04-8717-abebe62caddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ca0e35b0e4042eae1393c9e11e3ef8d 2x, https://si.imgix.net/6514e4e3/uploads/origins/f882f65a-f55a-4d04-8717-abebe62caddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf428e515da3dbe872e320eec204d559 3x", "genre": "art", "nsfw": false, "body": "命メモ様、はじめまして。リクエスト失礼します。\n\n私のOC（オリジナルキャラクター）のイラストを描いていただきたくリクエストさせていただきました。\n\n（https://drive.google.com/drive/folders/1a16mCsY8HzcMsp6uH49uI97wLdxIcvoQ）\n上記の保存先のふたりのイラストをお願いしたいです。\n\n\n鳩田かなめ：25歳前後の女性、身長161cm。表情の変化に乏しい。右目を眼帯か伸ばした髪で隠している。赤いアンダーリムの眼鏡をかけている。左腕が無く袖をひらひらさせている。ひなのについては執着されてることには気付いてるが便利なので放置している。\n\n棺原ひなの：21歳の女性、身長176cm。いつも糸目で笑顔。かなめに執着していて高頻度で家に来て世話をしている。目に小さいハートマークがある。\n\n\nポーズ、構図等についてはおまかせします。\n\n\nご都合よろしければよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1a16mCsY8HzcMsp6uH49uI97wLdxIcvoQ", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/183", "thumbnail_src": "https://si.imgix.net/423f6d45/uploads/origins/f56a0644-8122-4d57-b0a0-48a8772472c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f21b9efebf05f84ca81edc282a2682", "thumbnail_srcset": "https://si.imgix.net/423f6d45/uploads/origins/f56a0644-8122-4d57-b0a0-48a8772472c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f21b9efebf05f84ca81edc282a2682, https://si.imgix.net/423f6d45/uploads/origins/f56a0644-8122-4d57-b0a0-48a8772472c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c731c456c026892803fb36e2faed8d99 2x, https://si.imgix.net/423f6d45/uploads/origins/f56a0644-8122-4d57-b0a0-48a8772472c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69f2c87f7cfd0e0e821b984a368dc4c5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きなので、私のキャラクターを描いていただけませんか？\n\nリンクの中のキャラどちらか1人、好きなほうを選んで描いてください。\n\nピンク髪（♂）とブルー髪（♂）\n\n■ ピンクは明るくて元気、ブルーは落ち着いてる。幼なじみで、同い年（14歳）。ピンクは身長150cm、ブルーは152cm。\n■超能力者で、6歳のときに出会って。ピンク髪は周りから「百年に一度の天才」と呼ばれ、ブルー髪はその天才の隣にいる「普通の人」と見られている。しかし本当は、ブルー髪には時間を巻き戻す能力があり、何度もピンク髪を何度も危ない目から助けてきた。それはみんな知らないけど、ピンクだけは知ってて、普段からブルーに頼りっぱなし。\n■戦う以外に、普通の中学生っぽいことも一緒にしてる。学校生活を送り、ゲーセン行ったり、食べ歩きしたり、遊んだり。（学ラン姿）\n■関係性：親友。お互いに友情を超えた想いを抱いているが、どっちも告白してない。両片思い。\n\nピンク髪：自信家で、遊ぶのが大好き。ちょっと反抗的。趣味はサボってゲーセンに行くこと。戦いの天才、不死身だからどんなに重い傷を負っても死なない。\nモチーフ：いちご、星、リボン、剣、ゲームコイン。\n\nブルー髪：目の形はまるくて、性格はクール。\nモチーフ：ブルーベリー、懐中時計、時計の針、蝶、星空。\n\nピンク髪 → ブルー髪\n100％の信頼を寄せており、「世界で一番頼りになる人だと思ってる。大人から無理やり使命を押しつけられてて、唯一自分を理解してくれる幼なじみ（ブルー髪）を心の支えにしてる。\n\nブルー髪 → ピンク髪\nかつてピンク髪に命を助けられたことがあって、彼を憧れのヒーローみたいに思ってる。それで近づいて、今は一番の友達になった。だからこの関係をすごく大事にしてる。ピンク髪なら何でもできると思ってて、盲目的なまでに守りたいって気持ちが強い。時間を巻き戻すたびに代償を払う必要があるが、ピンク髪のためなら迷わずやる。たとえ自分を犠牲にしてでも守りたい、そんな重い想いを抱えてる。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1rF5rGylnpjVyVIWxehJdsSNzhWnMrXdh", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/182", "thumbnail_src": "https://si.imgix.net/849b2ced/uploads/origins/4b359b58-ea47-42ca-9841-3c5ffd16e121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad225f92c62d304b52be398974953971", "thumbnail_srcset": "https://si.imgix.net/849b2ced/uploads/origins/4b359b58-ea47-42ca-9841-3c5ffd16e121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad225f92c62d304b52be398974953971, https://si.imgix.net/849b2ced/uploads/origins/4b359b58-ea47-42ca-9841-3c5ffd16e121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b9603ca4c7de02ad354d758e0fbb6e8 2x, https://si.imgix.net/849b2ced/uploads/origins/4b359b58-ea47-42ca-9841-3c5ffd16e121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ccb1adfbce52aff748eba1b2c84c861 3x", "genre": "art", "nsfw": false, "body": "初めまして、 命メモ先生の作品が大好きで。\n私のOCをお願いします。\nキャラクターの設定につきましては、こちらにまとめております： https://drive.google.com/drive/u/0/mobile/folders/1pXld9K3eSrJm71h2NsCNV5_NnNdmlsv6?usp=drive_link&sort=13&direction=a\n構図、表情全ておまかせいたします、先生のご自由な発想で描いていただけたら嬉しいです。 どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/181", "thumbnail_src": "https://si.imgix.net/677a950d/uploads/origins/36d36fe9-3546-4442-8c6b-f44d623be0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e323a5a892ca79770c5f9e5217743dc0", "thumbnail_srcset": "https://si.imgix.net/677a950d/uploads/origins/36d36fe9-3546-4442-8c6b-f44d623be0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e323a5a892ca79770c5f9e5217743dc0, https://si.imgix.net/677a950d/uploads/origins/36d36fe9-3546-4442-8c6b-f44d623be0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2acadf1feecc74af8d7cfa2ad9c90353 2x, https://si.imgix.net/677a950d/uploads/origins/36d36fe9-3546-4442-8c6b-f44d623be0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c37d8bc74c98e99e6e2d00833fb4935 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/180", "thumbnail_src": "https://si.imgix.net/c03e74ee/uploads/origins/29a9ed67-052a-48e9-86f4-03f7202e6a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67ea48e4355fe5bf45aea1efc5f68d12", "thumbnail_srcset": "https://si.imgix.net/c03e74ee/uploads/origins/29a9ed67-052a-48e9-86f4-03f7202e6a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67ea48e4355fe5bf45aea1efc5f68d12, https://si.imgix.net/c03e74ee/uploads/origins/29a9ed67-052a-48e9-86f4-03f7202e6a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e856e0db6cdf49655702f5e186729b7a 2x, https://si.imgix.net/c03e74ee/uploads/origins/29a9ed67-052a-48e9-86f4-03f7202e6a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a45779bba2c1718b025fba3193c70c6 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n命メモ様のキュートなイラストに一目惚れしました！\nもしよろしければ、一次創作のキャラクター(和泉真白という男性)を描いていただくことは可能でしょうか？\n何卒よろしくお願いいたします！\n\n----------------------------------------------------------\n納品形式：png・psd\nサイズ：W154×H216mm\n色：モノクロ\n解像度：600dpi\n補足：\nもし依頼内容を引き受けていただける場合、命メモ様のイラストを発行予定の冊子に掲載してもよろしいでしょうか？\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/131RxhVGeqDIE3zwbhUroa8AavGoax11U?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/179", "thumbnail_src": "https://si.imgix.net/8be5dead/uploads/origins/a6f4b455-ff2d-4114-aa06-703b254d5a91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6015176af34d2b4b700d3443b399cf18", "thumbnail_srcset": "https://si.imgix.net/8be5dead/uploads/origins/a6f4b455-ff2d-4114-aa06-703b254d5a91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6015176af34d2b4b700d3443b399cf18, https://si.imgix.net/8be5dead/uploads/origins/a6f4b455-ff2d-4114-aa06-703b254d5a91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cec2d54ac06fcf03ab2ad6c7cb92e5c4 2x, https://si.imgix.net/8be5dead/uploads/origins/a6f4b455-ff2d-4114-aa06-703b254d5a91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c1e75a652b8af30d53e4d778a1e3754 3x", "genre": "art", "nsfw": false, "body": "命メモさん、こんにちは！いつも素敵なイラストを拝見させていただきます。よろしければ私のOCを描いていただきたいです…！🙇‍♀️\n\n▶OCの特徴や性格\n参考資料にある衣装は彼女が演じているドラマのキャラの衣装です。今回はそのドラマのキャラの設定に基づいたイラストを描いていただきたいです\nキャラ設定：\n・20代／女性／154cm\n・ピンクと黒のまつ毛／牙（口を閉じているときは見えない）／少し尖った耳\n・探偵ドラマの悪役\n・裕福な家庭の長女。長女であるものの、家庭は古い考え方なので彼女の弟が財産などを相続することになっている。それに不満を抱えて、家を財産するために弟を殺した。ですが実際に欲しかったものは財産ではなく、家庭の膨大な蔵書です\n・子供の時に友達がいなかったので蔵書の中から本を読んでばかりいた。そのため、本だけが彼女にとって唯一の宝物であり、誰にも譲りたくないと思っている\n・弟殺害の容疑者として捜査されているが、アリバイ以外に証拠はない\n・性格：知的、狡猾、利己的、表情豊か、子供っぽくて負けず嫌い。嘘をつくのが得意\n・モチーフ：📚🪓🦊🎴\n\n構図とポーズはお任せします！髪型や衣装を変化していただいても構いません。命メモさんのセンスが大好きなので、自由に描いていただけますと嬉しいです🙇‍♀️🙇‍♀️\n\nお忙しい所で申し訳ございませんが、ご検討いただけますと幸いです！よろしくお願いします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1fl6QH14Q3ZJgr9x26yPBmb3BBVcb9IBD?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nigakute_kusa/works/178", "thumbnail_src": "https://si.imgix.net/467f8978/uploads/origins/2ebe0990-5518-4a93-b845-e2898a78592b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ab44f088caef719d2c52adffeaa2828", "thumbnail_srcset": "https://si.imgix.net/467f8978/uploads/origins/2ebe0990-5518-4a93-b845-e2898a78592b?bg=%23fff&auto=format%2Ccomp