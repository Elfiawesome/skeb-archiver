ign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc26be94785ace3a9b7447c202179794 2x, https://si.imgix.net/0d8688eb/uploads/origins/67f64f6a-ab99-4d6c-8276-1445a08e2df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b7a145d06b23d964783b2f64f82544a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yoko2yuray/works/13", "thumbnail_src": "https://si.imgix.net/ad777797/uploads/origins/1e13e34f-31df-4fac-9b7f-0f4cf7690271?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6f038d95f90e81c782a69b85046f3b9", "thumbnail_srcset": "https://si.imgix.net/ad777797/uploads/origins/1e13e34f-31df-4fac-9b7f-0f4cf7690271?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6f038d95f90e81c782a69b85046f3b9, https://si.imgix.net/ad777797/uploads/origins/1e13e34f-31df-4fac-9b7f-0f4cf7690271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e84a807e5acc0f72491d24a60b0dc3ca 2x, https://si.imgix.net/ad777797/uploads/origins/1e13e34f-31df-4fac-9b7f-0f4cf7690271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b35faa524c5c568342f3e1183f6e08ff 3x", "genre": "art", "nsfw": true, "body": "よこゆら様、お久しぶりでございます！\n今回も私の願望を叶えていただきたく、リクエストを送らせてくださいませ。\n\n・キャラクター\n○アークナイツよりゴールデングロー\n\n・シチュエーション\n○ロドスに来てから実はウタゲやシデロカ以上の爆乳に成長しつつあったが色々と邪魔になるので小さく見えるブラでギッチギチに無理矢理抑え込んで隠しているゴールデングロー(本人は隠せているつもりだが以前より胸が大きくなっているのがわかってしまうレベル)\n\n○圧迫による息苦しさと暑さに耐えつつ秘書業務をこなすも、偶然にもついにサラシが質量に耐えきれなくなり、ドクターの前でブラのホックが壊れ始めてしまう。\n\n○息も絶え絶えに「ドクター！！　コレ(胸)の事はドクターと私だけのヒミツでお願いしま・・」と必死に言い訳をするも、更にホックが壊れていき徐々に大きさを増していく胸に布地がとられてヘソがチラ見え、胸にベルトが食い込んでいき大きさがより際立っていく。\n\n○「ギギ ・・ギギギ・・・」\n　「ん？まさか・・？  」\n　「ダッ・・ダメ！これ以上は本当にダメェ！！」バツンッッ！\n残っていたホックも壊れてしまい、ぱっつぱつのぎちぎちに弾けてしまいそうな衣服、所々破れてしまった服の隙間からみっぢみぢに詰まった胸や底が見えない程の深い谷間が見えてしまう\n\n○恥ずかしながらもドクターに「ドクターは・・胸の大きな女のコはお好みですか・・・？♡」と服を捲って胸を寄せ上げながらアピールをするオチで\n\nその他\n・胸が段階を踏んで大きくなっていく様にしていただきたいです。\n・サイズの合わない衣服とブラのせいで服に無理矢理パツパツのギチギチに押し込まれてる感を重視してもらえると幸いです。\n・ギチギチ、ミチミチといった擬音も付けてくださると嬉しいです。\n・解放されたてで汗蒸れむれな感じで\n\nご検討の程よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@yoko2yuray/works/12", "thumbnail_src": "https://si.imgix.net/020d3399/uploads/origins/ca3c34a8-6b04-4e73-8b85-f29a07a44d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720593cca7fa93fc0486773e86d3bb75", "thumbnail_srcset": "https://si.imgix.net/020d3399/uploads/origins/ca3c34a8-6b04-4e73-8b85-f29a07a44d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720593cca7fa93fc0486773e86d3bb75, https://si.imgix.net/020d3399/uploads/origins/ca3c34a8-6b04-4e73-8b85-f29a07a44d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4192d563e4438b7ac660397d4e9f5b8 2x, https://si.imgix.net/020d3399/uploads/origins/ca3c34a8-6b04-4e73-8b85-f29a07a44d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00b263e9c5fde6b098232f7e3dfd5911 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yoko2yuray/works/11", "thumbnail_src": "https://si.imgix.net/a2c5b295/uploads/origins/0beb587c-7373-40cd-89e4-476fe925d423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163f516090f04f1098f3347f83cb021a", "thumbnail_srcset": "https://si.imgix.net/a2c5b295/uploads/origins/0beb587c-7373-40cd-89e4-476fe925d423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163f516090f04f1098f3347f83cb021a, https://si.imgix.net/a2c5b2