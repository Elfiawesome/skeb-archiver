-b3b3-daecebcfcfdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=568a202199a8e3511d21348ef9f78c84 2x, https://si.imgix.net/18a5afc8/uploads/origins/9860543e-2c6f-4767-b3b3-daecebcfcfdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e802d71b84e5088848be0c7c6a2317c 3x", "genre": "art", "nsfw": true, "body": "お疲れさまです。\nどうやら納品期限が過ぎてしまい、勝手にキャンセルになってしまっていたのようなので再送致します。\n\n「ローゼンメイデン」の「水銀燈」の肉塊肥満化絵(差分あり)をお願いします。\n\n内容としまして、最初は催眠を受けたような感じで目に光がなく一心不乱に乳酸飲料を飲み続けていてげっぷや放屁を気にしていないような感じの絵と催眠が溶け、自分の体の重さや体臭に焦るも体が重すぎて動けず無様に全身の贅肉を揺らしげっぷや放屁を垂れ流しているような感じの絵をお願いします。\nまた、出来ればで良いのですがお腹中心に太っているとありがたいです。\n\nもしお時間等の余裕がありましたら、再度依頼受注のご検討を宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@lowproteinhighf/works/184", "thumbnail_src": "https://si.imgix.net/4989c3a1/uploads/origins/ebcae546-174c-4815-a7b3-b7729bf2b5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba795f2ddf6dd7d6c4a6bb9b12c82c9f", "thumbnail_srcset": "https://si.imgix.net/4989c3a1/uploads/origins/ebcae546-174c-4815-a7b3-b7729bf2b5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba795f2ddf6dd7d6c4a6bb9b12c82c9f, https://si.imgix.net/4989c3a1/uploads/origins/ebcae546-174c-4815-a7b3-b7729bf2b5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9ab6d1226efb7db351df818bc9e4a27 2x, https://si.imgix.net/4989c3a1/uploads/origins/ebcae546-174c-4815-a7b3-b7729bf2b5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c03cb10ff321a7a9365ab28bc45d0986 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lowproteinhighf/works/183", "thumbnail_src": "https://si.imgix.net/df67b305/uploads/origins/c1686f23-422a-4faa-9183-ac8c0844c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e39db440fdaad3cc6e9ebf13808a057", "thumbnail_srcset": "https://si.imgix.net/df67b305/uploads/origins/c1686f23-422a-4faa-9183-ac8c0844c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e39db440fdaad3cc6e9ebf13808a057, https://si.imgix.net/df67b305/uploads/origins/c1686f23-422a-4faa-9183-ac8c0844c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b59625e378e0e2144ae683755f26af0d 2x, https://si.imgix.net/df67b305/uploads/origins/c1686f23-422a-4faa-9183-ac8c0844c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0bca20ba509cc25af920af2eb223f92 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。手数料無料キャンペーンという事なので、よろしければイラストを2カット分リクエストお願いします。\n\n現実を書き換えられて肥満化させられてしまった高校生さん（https://x.com/lowproteinhighf/status/1137352366812831744）の、中学生時代のイラストとなります。\n\n◯1カット目依頼詳細\n\n・白い長袖のセーラー服と紺のスカート、白のハイソックスに上履きという服装で笑顔で歩いている。\n・時期は入学直後の中学1年生で、身長が伸びる事を見越した大きめサイズの制服、あまり発達していないバスト等、まだ小学生らしさが残る雰囲気。髪型はロングヘア。\n・彼女を見て談笑する男子生徒達の会話をフキダシで描写してください。背景は省略してしまって問題ありません。\n\n以下が会話テキストの内容となります。ホニさん様のお好みで修正、または削除していただいても問題ありません。\n\n「入学式の時に見て思ったけどよぉ、××さんって滅茶苦茶可愛いよなぁ」\n「俺昨日廊下ですれ違ったけど、すげぇいい匂いしたわ」\n「何嗅いでんだよオメェ変態だろw」\n\n◯2カット目詳細\n\n・制服を着て歩いているシチュエーションは同じだが、認識書き換えの影響で重度の肥満児となっており、大量に汗をかきながら息を切らせている。\n・バストは1カット目と比べて脂肪がついて大きくなっているものの、それ以上に腹が前に突き出た肥満体型。首は二重顎に埋もれて見えない状態。身長は1カット目と同じ。\n・セーラー服の丈はギリギリで肌の露出を防いでいるが、とてもキツそうなサイズ感となっており、汗染みが所々にできている。\n・髪質は縮れたものに変化しており、眉毛も太くなっている。\n・1カット目同様に、彼女を見てヒソヒソと会話する生徒達の会話をフキダシで描写してください。内容もお好みで修正・削除をしていただいて問題ありません。\n\n以下、会話テキスト\n\n「入学式の時に見て思ったけど…××さん太り過ぎててヤバいよな…」\n「俺昨日廊下ですれ違ったけど、すげぇ汗臭くてビビった…」\n「……お前らあんまりデリカシー無い事言わない方がいいぞ」\n「私あの子と小学校一緒だったけど　そん時からめっちゃ太ってたよw」\n「（…やたら嬉しそうに話すな　この女子）…へー」\n\n以上となります。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@lowproteinhighf/works/182", "thumbnail_src": "https://si.imgix.net/837568ac/uploads/origins/e161bb84-de58-4636-8418-c0c50d59c3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e95d6453d8aa9d0578b7c270798fb387", "thumbnail_srcset": "https://si.imgix.net/837568ac/uploads/origins/e161bb84-de58-4636-8418-c0c50d59c3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e95d6453d8aa9d0578b7c270798fb387, https://si.imgix.net/837568ac/uploads/origins/e161bb84-de58-4636-8418-c0c50d59c3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=332ebcbf2fa3aa7ff96ae5df1118c93c 2x, https://si.imgix.net/837568ac/uploads/origins/e161bb84-de58-4636-8418-c0c50d59c3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db84f8f07fb924cc7652725796f45f8c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lowproteinhighf/works/181", "thumbnail_src": "https://si.imgix.net/178b3dfe/uploads/origins/7485b4d9-12de-4abe-9f0f-db9c36065abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a3a0bfac272847de2b1b7a6f5f74ad", "thumbnail_srcset": "https://si.imgix.net/178b3dfe/uploads/origins/7485b4d9-12de-4abe-9f0f-db9c36065abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a3a0bfac272847de2b1b7a6f5f74ad, https://si.imgix.net/178b3dfe/uploads/origins/7485b4d9-12de-4abe-9f0f-db9c36065abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a718879b7071807e28be12c49a5e7187 2x, https://si.i