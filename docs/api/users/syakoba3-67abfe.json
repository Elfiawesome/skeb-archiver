456?t=oHPGbFgvRFW9Cz0xhiGOOg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@syakoba3/works/10", "thumbnail_src": "https://si.imgix.net/9dff9a24/uploads/origins/e3087bdc-3114-42a4-b5a4-b4cad65708a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cda8c358c5e8b2ae7eb9f3a7f4b3f3d6", "thumbnail_srcset": "https://si.imgix.net/9dff9a24/uploads/origins/e3087bdc-3114-42a4-b5a4-b4cad65708a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cda8c358c5e8b2ae7eb9f3a7f4b3f3d6, https://si.imgix.net/9dff9a24/uploads/origins/e3087bdc-3114-42a4-b5a4-b4cad65708a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c15b5ec9a6cf2eeda0549bdaa052743 2x, https://si.imgix.net/9dff9a24/uploads/origins/e3087bdc-3114-42a4-b5a4-b4cad65708a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e3fb0a72808ed528ac03e750e7829a2 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のVtuberのアバターの絵をお願いしたいのですが、彼女はクリタリン・ヒューマンです。\nhttps://twitter.com/DiffusedRiven_/status/1427464160250564612?s=20\n\n彼女には、リファレンスシートにあるように、パーツや塊が欠けている「ダメージ」があります。\n\n芸術的には自由ですが、オリジナルのデザインを維持することだけをお願いします。\n\n絵が完成したら、私のアートタグ(#Diffusedart)を使っていただけると助かります。\n\nありがとうございました！これからも素晴らしい仕事を続けてください\n\nhttps://twitter.com/DiffusedRiven_/status/1427464160250564612?s=20", "created_at": "", "completed_at": ""}, {"path": "/@syakoba3/works/9", "thumbnail_src": "https://si.imgix.net/d5897b5f/uploads/origins/0e77ab1e-3662-4734-9e9c-8b33f08b031f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fc9a47747a1534e2904116e05293cb3", "thumbnail_srcset": "https://si.imgix.net/d5897b5f/uploads/origins/0e77ab1e-3662-4734-9e9c-8b33f08b031f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fc9a47747a1534e2904116e05293cb3, https://si.imgix.net/d5897b5f/uploads/origins/0e77ab1e-3662-4734-9e9c-8b33f08b031f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17e8ccc09dc0