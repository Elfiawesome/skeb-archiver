-966c-a80a43ab6182?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f131014ea7dee8cff67384ca6720ba2e 3x", "genre": "art", "nsfw": false, "body": "はじめまして！先生のpixivでナギサの絵が可愛くてリクエストさせていただきます。\n｢ブルーアーカイブ｣の桐藤ナギサでウエディングドレス姿でお願いします！\n表情は見つめられて恥ずかしくなって少し照れている感じで、どうですか先生っていう風に見てる感じでお願いします。\n他はおまかせしますので何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/7", "thumbnail_src": "https://si.imgix.net/bf0c4a22/uploads/origins/06d44bc9-4cd7-4fda-920b-879f5f0eb0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6569cffa53065197d1d5cba5fe00fd8", "thumbnail_srcset": "https://si.imgix.net/bf0c4a22/uploads/origins/06d44bc9-4cd7-4fda-920b-879f5f0eb0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6569cffa53065197d1d5cba5fe00fd8, https://si.imgix.net/bf0c4a22/uploads/origins/06d44bc9-4cd7-4fda-920b-879f5f0eb0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e79818cec9083246a59d63095e3ea58 2x, https://si.imgix.net/bf0c4a22/uploads/origins/06d44bc9-4cd7-4fda-920b-879f5f0eb0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b79b9858a6f23fa44aeba2fb5a2bba4d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたのイラストは素晴らしく、ポートフォリオもとても気に入っています。  ゼノブレイドクロニクル』のメリアのイラストを描いていただけたら嬉しいです。  ポーズはお任せしますが、甘かったり、可愛かったり、魅力的なものがあれば最高です！参考にさせていただきます！\n\nhttps://drive.google.com/drive/folders/1QlHWZzLW_FDBYrQPbixJ6VGUG_QtSced", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/6", "thumbnail_src": "https://si.imgix.net/60ed1092/uploads/origins/89021d91-99c8-4edf-97b2-5e28398db705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcf8d23619a9f46d2d4ed34434d24ca5", "thumbnail_srcset": "https://si.imgix.net/60ed1092/uploads/origins/89021d91-99c8-4edf-97b2-5e28398db705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcf8d23619a9f46d2d4ed34434d24ca5, https://si.imgix.net/60ed1092/uploads/origins/89021d91-99c8-4edf-97b2-5e28398db705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f643c4aeaf56f324a3601f97896924e8 2x, https://si.imgix.net/60ed1092/uploads/origins/89021d91-99c8-4edf-97b2-5e28398db705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f17fce712a8104ca69a7b9cf6fa2ff9e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/5", "thumbnail_src": "https://si.imgix.net/05d4c517/uploads/origins/44f22875-ae91-42b2-8b98-6db1bceda085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16cac64ea56f42dc21b8481b0456cf95", "thumbnail_srcset": "https://si.imgix.net/05d4c517/uploads/origins/44f22875-ae91-42b2-8b98-6db1bceda085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16cac64ea56f42dc21b8481b0456cf95, https://si.imgix.net/05d4c517/uploads/origins/44f22875-ae91-42b2-8b98-6db1bceda085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ce50c2003c97d55edd3d509384d9f76 2x, https://si.imgix.net/05d4c517/uploads/origins/44f22875-ae91-42b2-8b98-6db1bceda085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c02bfc35c97335eef8ff3b7762706144 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイブの聖園ミカが学校指定の水着を着ているイラストをお願いします。（下に記載した画像の水着です）\nhttps://pbs.twimg.com/media/FnPsk66agAE37Ix?format=jpg&name=large\n\nポーズは頭の後ろで肘をつかんでストレッチして、足を少し開いて立っている様子をひざの方まで写した構図で正面からのアングルでお願いします。下の参考画像の左側のようなイメージです。\nhttps://thumb.ac-illust.com/57/57e301266fb76b6b1440a93b60413759_w.jpeg\n\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/4", "thumbnail_src": "https://si.imgix.net/008a2ea3/uploads/origins/33c73f81-9063-4768-a678-11562f406b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e0f57a1bd9931da174093b22858b5e6", "thumbnail_srcset": "https://si.imgix.net/008a2ea3/uploads/origins/33c73f81-9063-4768-a678-11562f406b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e0f57a1bd9931da174093b22858b5e6, https://si.imgix.net/008a2ea3/uploads/origins/33c73f81-9063-4768-a678-11562f406b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b9bba400ef404ec1fc9516f865d30c6 2x, https://si.imgix.net/008a2ea3/uploads/origins/33c73f81-9063-4768-a678-11562f406b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ed9374547f4789f21b9af1a00e500d9 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n竜胆様のイラストがとても好きです。\nよろしければうちの子を描いてください！\n\n◆使用用途\ntwitter等SNSでの使用\n\n◆三面図・キャラ参考資料\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n\n◆構図等\n制服（素足）のうちの子をこんな構図でお願いしたいです。\nhttps://www.pixiv.net/artworks/102098324\n\nまた、足爪の描写が好きなので、両足の爪がほぼ全て見えるように描いてもらえると嬉しいです。\n\n◆納品\nPSDとPNG形式\n\nよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/3", "thumbnail_src": "https://si.imgix.net/b33c7dd0/uploads/origins/11f91ac6-f8a6-4ef3-ab61-987afc7f5eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6c14ecd246453b30ea2cee0c1972e8", "thumbnail_srcset": "https://si.imgix.net/b33c7dd0/uploads/origins/11f91ac6-f8a6-4ef3-ab61-987afc7f5eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6c14ecd246453b30ea2cee0c1972e8, https://si.imgix.net/b33c7dd0/uploads/origins/11f91ac6-f8a6-4ef3-ab61-987afc7f5eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a18f28e2fc7b64582ed65df5baf1d83 2x, https://si.imgix.net/b33c7dd0/uploads/origins/11f91ac6-f8a6-4ef3-ab61-987afc7f5eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01c5fa90f700fff69957d573b44c0487 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nいつもツイッターで素敵な作品を拝見しています。\n今回ご依頼をさせて頂きたいと思いまして、ご連絡を差し上げました。\n\nご依頼したいのは、魔女の旅々のイレイナさんです。\nお願いしたいのは、イレイナさんに夏服のセーラー服を着せて頂きたいのです。\n竜胆さんのセーラー服作品がちょう好きなので、ぜひイレイナさんに着せていただけたらと思います。\nお願いが一点ありまして、イレイナさんの魔女としての記号のブローチを左胸に付けて頂きたいのです。\n\n構図やポーズはお任せいたします。\n\n創作などで大変忙しいと思いますが、どうかよろしくお願いいたします。\n\nhttps://images.app.goo.gl/BzSTMc185XoAxZTs8", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/2", "thumbnail_src": "https://si.imgix.net/ceaf5994/uploads/origins/217a4d02-3971-4fe9-8517-54537a6281d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b4539403567237e57baf69da84dd107", "thumbnail_srcset": "https://si.imgix.net/ceaf5994/uploads/origins/217a4d02-3971-4fe9-8517-54537a6281d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b4539403567237e57baf69da84dd107, https://si.imgix.net/ceaf5994/uploads/origins/217a4d02-3971-4fe9-8517-54537a6281d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac394846823291c582f6e9ec0c6a7588 2x, https://si.imgix.net/ceaf5994/uploads/origins/217a4d02-3971-4fe9-8517-54537a6281d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8864d3979c4904e3cfbe29668a1c6252 3x", "genre": "art", "nsfw": false, "body": "初めまして！　イラストが好みだったので依頼させていただきたいと思います。\n\nもしよろしければビーナスイレブンびびっど！の巽ちあきちゃんをお願いします。\n\n・衣装はネコミミメイド服\n・主観視点であーんしてくれてるシチュエーションでお願いします！\n・その他細かい構図やシチュエーション、小物等はおまかせします\n\nキャラ資料\nhttps://drive.google.com/drive/folders/1b6Ck3oLlp_u2otmgr3NocHzK7yZFlvsi", "created_at": "", "completed_at": ""}, {"path": "/@rindou_ringdong/works/1", "thumbnail_src": "https://si.imgix.net/9391a327/uploads/origins/bfbc1631-9e46-47e5-b052-8ff122c71fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f634fb81545055a3b7b57d144d212624", "thumbnail_srcset": "https://si.imgix.net/9391a327/uploads/origins/bfbc1631-9e46-47e5-b052-8ff122c71fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f634fb81545055a3b7b57d144d212624, https://si.imgix.net/9391a327/uploads/origins/bfbc1631-9e46-47e5-b052-8ff122c71fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ead8f8fca8c800d2c44403639d38c1d5 2x, https://si.imgix.net/9391a327/uploads/origins/bfbc1631-9e46-47e5-b052-8ff122c71fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e12a0d8ad96c4793c5558af9a00359a 3x", "genre": "art", "nsfw": false, "body": "プリズマ☆イリヤのクロエを描けるか？\n詳細はこちら\n- 恥ずかしそうな表情がかわいい\n- 手で押さえつけられている様子\n- 一人称視点\n- 全身が望ましい\n- 衣装はお任せします。露骨なものではなく、露出度の高いものを希望します。", "created_at": "", "completed_at": ""}]}