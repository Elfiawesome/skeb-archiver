2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59b43ad6f6f5eb6d0c365b0a43659011 2x, https://si.imgix.net/f5dbad76/uploads/origins/433ee7e9-d376-4077-a008-ee33697a7cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbb87deea120aa26857694da41fda3fb 3x", "genre": "art", "nsfw": true, "body": "いつもエッチなイラストありがとうございます！\n今回、人妻妊婦イタリアオオカミさんのボテ腹えっちをリクエストさせていただきます！\n\nシチュエーションのイメージや雰囲気としては、以前赤イストさんが描かれたこちらの作品\nhttps://skeb.jp/@fzr332211/works/29 \nの後日談で「めでたく3つ子を妊娠した人妻イタリアオオカミさんが、赤ちゃんが出やすくなるようにという建前で旦那さんとえっちをする」といった感じになります。あくまでイメージなので、年齢や設定は変えていただいて大丈夫です。\nえっち前立ち絵の服装はゆったりめなマタニティウェアで、えっち前も後も左手の薬指には結婚指輪があると嬉しいです。\nイタリアオオカミさんの体格は前と同じくぽっちゃり気味且つお股や腋には毛が生えていて、お腹は3つ子を妊娠しているためかなり大きめ(期間は妊娠30週〜臨月イメージ)でお願いします…！\nセリフやえっちシーンでの細かい描写はお任せします！\n\n宜しければ、以上の内容でお願いします！\n\nhttps://skeb.jp/@fzr332211/works/29", "created_at": "", "completed_at": ""}, {"path": "/@akaist332211/works/38", "thumbnail_src": "https://si.imgix.net/cbe28572/uploads/origins/5facfc95-9aa6-4fad-9e39-2685c319e73b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a9a52c97f7be7d00a5e8e9e3af4be7c", "thumbnail_srcset": "https://si.imgix.net/cbe28572/uploads/origins/5facfc95-9aa6-4fad-9e39-2685c319e73b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a9a52c97f7be7d00a5e8e9e3af4be7c, https://si.imgix.net/cbe28572/uploads/origins/5facfc95-9aa6-4fad-9e39-2685c319e73b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b5aaa4a834320ca4cd3e0f99deebfcf 2x, https://si.imgix.net/cbe28572/uploads/origins/5facfc95-9aa6-4fad-9e39-2685c319e73b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a7dc9de374aca57d276aeecd12a5e9e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akaist332211/works/37", "thumbnail_src": "https://si.imgix.net/2018c185/uploads/origins/557053fb-4218-43e7-99f3-b4e64c92df9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94581057b71c5325706b1a88e74803ea", "thumbnail_srcset": "https://si.imgix.net/2018c185/uploads/origins/557053fb-4218-43e7-99f3-b4e64c92df9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94581057b71c5325706b1a88e74803ea, https://si.imgix.net/2018c185/uploads/origins/557053fb-4218-43e7-99f3-b4e64c92df9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e021659f04fab91092ccb6ce54463d7a 2x, https://si.imgix.net/2018c185/uploads/origins/557053fb-4218-43e7-99f3-b4e64c92df9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b3f2e79eeb77f1567ee34be115fc1ab 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です！赤イストさんの素敵な作品を拝見させていただいております！\n赤イストさんが描かれている三十路フレンズが好きなのでリクエストさせていただきます。\nシチュエーションは、人妻ホッキョクギツネちゃん(年齢はお任せします)がキツくなったフレンズの服を着て、そのまま夫とエッチしている様子と事後をお願いしたいです。\n雰囲気は赤イストさんが以前描かれていた作品　\nhttps://skeb.jp/@fzr332211/works/29 \nに近い感じでお願いしたいです。\nホッキョクギツネちゃんの体型はややぽっちゃり気味でお願いします。\nセリフや仕草等はお任せいたします。\nお忙しいと思いますが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaist332211/works/36", "thumbnail_src": "https://si.imgix.net/f88976e6/uploads/origins/0818f61d-ea3c-4c59-83c0-2544137b9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf91847f3de318e493507c1ceea1f5f", "thumbnail_srcset": "https://si.imgix.net/f88976e6/uploads/origins/0818f61d-ea3c-4c59-83c0-2544137b9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf91847f3de318e493507c1ceea1f5f, https://si.imgix.net/f88976e6/uploads/origins/0818f61d-ea3c-4c59-83c0-2544137b9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2e20dabd94dab03071c1d6ee28643cd 2x, https://si.imgix.net/f88976e6/uploads/origins/0818f61d-ea3c-4c59-83c0-2544137b9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c3d8897db49c5265fe39b65e7cb9eca 3x", "genre": "art", "nsfw": true, "body": "こんにちは、いつもエッチなけもフレ絵ありがとうございます\nけもフレ３のお姉ショタをリクエストしたいです、可能であればマンガ形式で欲しいです\n\nキャラクター：ピーチパンサー\n相手　：おとなしそうなショタ（小学生高年生っぽい）\nその他：胸が美乳、適当にセリフと擬音、ピーチパンサーはハート型のニップレス貼ってる\n\nシチュエーション\nピーチパンサーの店には「ピーチ味のキャンディー好きですか」という秘密の合言葉があって、それを言ってジャパリコインを渡せば裏マッサージが受けられる噂がある\n\nでも、どんなマッサージなのはピーチパンサーの気分次第。ショタは噂を確かるために人がいない時合言葉を言った。それを聞いたピーチパンサーはまるで捕食者な表情でショタの股間を見ながらショタの手を引いて茂みの方に消えてた\n\nショタのズボンをおろし、胸をさらけ出してその歴戦の大人でも瞬イキのテクでフェラしてる、経験のないショタはすぐ射精したが止まる気配がまったくなく、ショタは立たなくなるまでフェラで射精させられた。\n\nよかったら受けてもらえるとうれしいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@akaist332211/works/35", "thumbnail_src": "https://si.imgix.net/a617f282/uploads/origins/e0c031dc-ba60-4a77-a7ca-99c3aadc05b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2390e0e2b0a0bf62e631579001f2fe1e", "thumbnail_srcset": "https://si.imgix.net/a617f282/uploads/origins/e0c031dc-ba60-4a77-a7ca-99c3aadc05b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2390e0e2b0a0bf62e631579001f2fe1e, https://si.imgix.net/a617f282/uploads/origins/e0c031dc-ba60-4a77-a7ca-99c3aadc05b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2e0455d6c09ed56ed9b3822c28929cc 2x, https://si.imgix.net/a617f282/uploads/origins/e0c031dc-ba60-4a77-a7ca-99c3aadc05b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b360d44b3dac48a9a157f867b6e54932 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。ぜひお願いしたい絵があります。\n\n発情期に突入してムラムラが限界に達したセイリュウさまが隊長に交尾をお願いして激しいセックスをする絵を描いていただきたいのです。\n発情して太ももを伝うほど濡れて青タイツにシミを作って、それでも高圧的に交尾をおねだりするセイリュウ様の立ち絵から始まり、体位はロールスロイス（腕を掴んで腰を反らせる後背位）で爆乳が激しく揺れるカットと、事前に禁止していたのに膣内射精されてガチイキするカットを入れて欲しいです。膣内射精は断面図がついていると助かります。中出しされたことは口では叱りつつもまんざらでもない感じで締めていただけると嬉しいです。(画面に収めるのが難しい場合は乳揺れのカットを省略していただいても大丈夫です)\n服装は青ブラ青ショーツ半脱ぎ、体型は少しお肉が余っている感じで爆乳、乳輪デカめ、陰毛は無しでお願いします。\n\n細かい指定が多くなってしまい申し訳ありませんが、ぜひよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaist332211/works/34", "thumbnail_src": "https://si.imgix.net/2be796ec/uploads/origins/6d770db0-588d-421d-b71e-b5a08bb0ee2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f24aeca441d12c82c2463505df6ad75", "thumbnail_srcset": "https://si.imgix.net/2be796ec/uploads/origins/6d770db0-588d-421d-b71e-b5a08bb0ee2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f24aeca441d12c82c2463505df6ad75, https://si.imgix.net/2be796ec/uploads/origins/6d770db0-588d-421d-b71e-b5a08bb0ee2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=344d5539ee7ebc00f2c70a5a4db75437 2x, https://si.imgix.net/2be796ec/uploads/origins/6d770db0-588d-421d-b71e-b5a08bb0ee2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a70e6aaf5c79c8b6a12d037bdc2b1cb 3x", "genre": "art", "nsfw": false, "body": "イラスト楽しく拝見しております。\n\nけもフレからイタリアオオカミ(ともし金額的に許すならタイリクオオカミ)をお願いできないでしょうか。服装をアンツ○オの制服風（イタ○ア少女団風）にしてもらえると嬉しいです（帽子の有無はお任せします）。あとの構図などもお任せできればと思います。背景は単色など簡略したもので問題ありません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaist332211/works/33", "thumbnail_src": "https://si.imgix.net/1cf59b07/uploads/origins/1d432488-039a-42e3-ba84-ea803deeeb3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09acc9d9e82361fe6e5dd2f9b53ba7a4", "thumbnail_srcset": "https://si.imgix.net/1cf59b07/uploads/origins/1d432488-039a-42e3-ba84-ea803deeeb3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09acc9d9e82361fe6e5dd2f9b53ba7a4, https://si.imgix.n