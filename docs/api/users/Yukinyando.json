a-b9e1-39fd289d15e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4521923d28c6a7f440635f73fd0a462 3x", "genre": "art", "nsfw": true, "body": "うるし原先生のハロウィン水着の娘のお二人が百合セックスするのイラストをお願いします。\n構図はお任せします。\nhttps://images-na.ssl-images-amazon.com/images/I/81xr+tG+BjL.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Yukinyando/works/16", "thumbnail_src": "https://si.imgix.net/f3fb2cc9/uploads/origins/b8e89af1-f495-4bf0-9139-32020f57f23b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d40cbe990b4a0cc13ef64119bcfa383", "thumbnail_srcset": "https://si.imgix.net/f3fb2cc9/uploads/origins/b8e89af1-f495-4bf0-9139-32020f57f23b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d40cbe990b4a0cc13ef64119bcfa383, https://si.imgix.net/f3fb2cc9/uploads/origins/b8e89af1-f495-4bf0-9139-32020f57f23b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c45b970ea4e3d4e4c24f9b57fd007581 2x, https://si.imgix.net/f3fb2cc9/uploads/origins/b8e89af1-f495-4bf0-9139-32020f57f23b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f30f913ade7abd68207298b0ada92b0a 3x", "genre": "art", "nsfw": true, "body": "吹石花がローターをつけてポールダンスをしているイラストをお願いします。\n不安げな表情をして、愛液が滴り落ちています。\nキャラ参考：\nhttps://skytube.jp/item/ax1077hana.html\nhttps://images-na.ssl-images-amazon.com/images/I/91TJgTW5gFL.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Yukinyando/works/15", "thumbnail_src": "https://si.imgix.net/54bb7247/uploads/origins/eaaf2ea1-f7ab-4934-93c5-330d5559221d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff540a0ade91139c3132edb6cb7f2521", "thumbnail_srcset": "https://si.imgix.net/54bb7247/uploads/origins/eaaf2ea1-f7ab-4934-93c5-330d5559221d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff540a0ade91139c3132edb6cb7f2521, https://si.imgix.net/54bb7247/uploads/origins/eaaf2ea1-f7ab-4934-93c5-330d5559221d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77e6f0968bdac69c09d307c28263ff4d 2x, https://si.imgix.net/54bb7247/uploads/origins/eaaf2ea1-f7ab-4934-93c5-330d5559221d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ab1b5cfee5bcebca7eac2ffb9ea18fc 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n市ヶ谷有咲（中）と牛込み（左）のイラストを描いていただけないでしょうか？と牛込み（左）です。\n市ヶ谷有咲（中）と牛込りみ（左）は内気な女の子ですが、お互いに好きだということがわかってからは繊細なキスをしたり、服を脱がせたりしています。\n\nどちらも参考資料よりも少し胸を強調することができます。\n\nご協力ありがとうございました。\n\nhttps://static.wikia.nocookie.net/bandori/images/1/16/Comic_Market_92_Booth_No.1231.jpg/revision/latest?cb=20180524125721", "created_at": "", "completed_at": ""}, {"path": "/@Yukinyando/works/14", "thumbnail_src": "https://si.imgix.net/ef8bbb22/uploads/origins/0633022c-72f7-4b7b-98e1-d077a938ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70a667bc0ce105d25b9fa0f8a3f3c4cb", "thumbnail_srcset": "https://si.imgix.net/ef8bbb22/uploads/origins/0633022c-72f7-4b7b-98e1-d077a938ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70a667bc0ce105d25b9fa0f8a3f3c4cb, https://si.imgix.net/ef8bbb22/uploads/origins/0633022c-72f7-4b7b-98e1-d077a938ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b918670963de90aa5332911b26c90238 2x, https://si.imgix.net/ef8bbb22/uploads/origins/0633022c-72f7-4b7b-98e1-d077a938ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d4a8140a4040667c30c9fc5cdf3a888 3x", "genre": "art", "nsfw": true, "body": "前作のお嬢様（https://skeb.jp/@Yukinyando/works/11）と紫のショートヘアの猫娘メイドが百合えっちをします。\nエルフのメイドが嬢様のベッドのシーツを持ち上げて、その下で猫娘が嬢様にクンニリングスをしているところを見せています。\n猫娘は驚いて頭を持ち上げ、その顔には愛液が付着している。\nエルフのメイドは困った表情をしています。", "created_at": "", "completed_at": ""}, {"path": "/@Yukinyando/works/13", "thumbnail_src": "https://si.imgix.net/417a0d0a/uploads/origins/34a2a4bb-b146-4119-9201-9d2f5a757d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be751e329ccb6fd44ffe5d2f69c3d21a", "thumbnail_srcset": "https://si.imgix.net/417a0d0a/uploads/origins/34a2a4bb-b146-4119-9201-9d2f5a757d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be751e329ccb6fd44ffe5d2f69c3d21a, https://si.imgix.net/417a0d0a/uploads/origins/34a2a4bb-b146-4119-9201-9d2f5a757d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=883165aa88a6df513ba33c68d27ec9ae 2x, https://si.imgix.net/417a0d0a/uploads/origins/34a2a4bb-b146-4119-9201-9d2f5a757d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f5d860bc936718c295853a4d2558d8b 3x", "genre": "art", "nsfw": true, "body": "私が以前お願いしたOLさんが、資料と同じブラとショーツのみ着用して、モデルさんのように少し恥ずかしそうなカメラ目線の笑顔で、下着が腕や手で隠れないポーズを取っている絵をリクエストします。ひざの少し上まで見えるように描いてほしいです。\n\nhttps://www.pixiv.net/artworks/85275188", "created_at": "", "completed_at": ""}, {"path": "/@Yukinyando/works/12", "thumbnail_src": "https://si.imgix.net/56b94fc9/uploads/origins/f93f398c-88ca-4b36-890a-11b843ae71d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cad47c6125ba5f2b240654c065f70f52", "thumbnail_srcset": "https://si.imgix.net/56b94fc9/uploads/origins/f93f398c-88ca-4b36-890a-11b843ae71d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cad47c6125ba5f2b240654c065f70f52, https://si.imgix.net/56b94fc9/uploads/origins/f93f398c-88ca-4b36-890a-11b843ae71d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0e13d094fe20f926d2d67b64175846d 2x, https://si.imgix.net/56b94fc9/uploads/origins/f93f398c-88ca-4b36-890a-11b843ae71d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aafcb0d2b67ea42dceff9a3d5938c62d 3x", "genre": "art", "nsfw": true, "body": "こんなに早く次のリクエストを送ることを申し訳ありません\n「フロントイノセント」から3人のメイドを描いていただけますか？ ソフィア、アイネ、とエイチェルです。\n全人は胸と股間を露わにしたメイド服を着て、視点は真上でベッドの上に横になります。\n状況については百合でもオナニーでもどちらでもいいです。\nポーズはお任せしますが、ソフィアを真ん中にしてお願いします。\nできれば、うるし原先生風にしていただけませんか？\n\n参考資料