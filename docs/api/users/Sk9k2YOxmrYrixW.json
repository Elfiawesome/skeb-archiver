recorded_at": "2026-03-07T13:44:19.663333+00:00"}, {"amount": 7000, "recorded_at": "2026-03-08T01:29:36.227542+00:00"}]}, "current_prices": {"art": 7000}, "price_range": {"art": {"min": 6000, "max": 13000}}, "links": [{"label": "Twitter", "url": "https://x.com/Sk9k2YOxmrYrixW", "name": "Sk9k2YOxmrYrixW"}, {"label": "Misskey_io", "url": "https://misskey.io/@chichinomori", "name": "chichinomori"}, {"label": "Website", "url": "https://koitoelf.fanbox.cc", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/24329281", "name": "24329281"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/490613", "name": "490613"}], "flags": {}, "works": [{"path": "/@Sk9k2YOxmrYrixW/works/302", "thumbnail_src": "https://si.imgix.net/f2e68a5b/uploads/origins/3989220d-8a90-4c81-9853-5370b80fe266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83740f7ecc8bfd079f8deba50f9f6c0", "thumbnail_srcset": "https://si.imgix.net/f2e68a5b/uploads/origins/3989220d-8a90-4c81-9853-5370b80fe266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83740f7ecc8bfd079f8deba50f9f6c0, https://si.imgix.net/f2e68a5b/uploads/origins/3989220d-8a90-4c81-9853-5370b80fe266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfb6cef8f9dbdaeddb4463a4dbbde993 2x, https://si.imgix.net/f2e68a5b/uploads/origins/3989220d-8a90-4c81-9853-5370b80fe266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4897a09e9d18edefb128e17ee5de5267 3x", "genre": "art", "nsfw": true, "body": "はじめまして。素晴らしい爆乳でしたのでリクエストさせていただきます。\n\n◆キャラクター\nアイドルマスターシャイニーカラーズ\n八宮めぐる\n\n◆容姿\nバスト188cmの爆乳\n黒マスク(ウレタンタイプのやつ)と黒ネイル、黒地雷系服\n耳にピアス多数\n※服は資料URLのを参考にしていただけると\n\n◆希望イラスト\n以前描かれたガルパンのケイのような立ち絵と立ちバック、後は受精してお腹を擦っているイラストをお願い致します\nテキストは下記のものを載せていただけると助かります。\n\n──────\n待ち合わせ場所に現れためぐるはいわゆる地雷系ファッションに身を包んでいた\n\nバスト188cmを何とか支えているデカブラのシルエットが浮かぶブラウス、黒マスクと黒ネイルという格好で爆乳を揺らしながらプロデューサーに手を振る\n\n大きな尻がスカートを持ち上げ、今にもパンツが見えそうな太ももには黒のサイハイソックスが食い込んでおり、柔らかさと中のしっかりした筋肉が感じられる\n\n我慢ならないプロデューサーはめぐるを路地裏へ連れ込み、後ろから挿入する\n\nいわゆる立ちバックの体勢で何度も精液を吐き出し、めぐると自分の血が混じったクォーター赤ちゃんをねだる\n\nめぐるは既にプロデューサーとの赤ちゃんを何人も出産しており、一度に五つ子以上は必ずできてしまう多胎体質だった\n\n「早く愛するプロデューサーの赤ちゃんを産みたい」「あの子達に弟と妹をプレゼントしたい」とめぐるはプロデューサーの精子を卵子で受け入れ、爆乳遺伝子たっぷりの優秀な子孫を残すのであった\n\nhttps://amzn.asia/d/iDgxbID", "created_at": "", "completed_at": ""}, {"path": "/@Sk9k2YOxmrYrixW/works/301", "thumbnail_src": "https://si.imgix.net/f60a6213/uploads/origins/9ab9a838-9a61-4ee5-b378-382656730a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb3fd204b2fe33019c2dd2c9297b6029", "thumbnail_srcset": "https://si.imgix.net/f60a6213/uploads/origins/9ab9a838-9a61-4ee5-b378-382656730a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb3fd204b2fe33019c2dd2c9297b6029, https://si.imgix.net/f60a6213/uploads/origins/9ab9a838-9a61-4ee5-b378-382656730a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f30f9b75fc14f9efbb550a2db2165424 2x, https://si.imgix.net/f60a6213/uploads/origins/9ab9a838-9a61-4ee5-b378-382656730a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0aff57862dad6cecab8d03c729ef2d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Sk9k2YOxmrYrixW/works/300", "thumbnail_src": "https://si.imgix.net/7fe55f00/uploads/origins/c91f3733-2eb2-42dc-aea1-3be48dec974c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b805368cf180ec88eb773529f88a3f52", "thumbnail_srcset": "https://si.imgix.net/7fe55f00/uploads/origins/c91f3733-2eb2-42dc-aea1-3be48dec974c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b805368cf180ec88eb773529f88a3f52, https://si.imgix.net/7fe55f00/uploads/origins/c91f3733-2eb2-42dc-aea1-3be48dec974c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37d3dd13fe5b3ee1fefd40c38cd67e35 2x, https://si.imgix.net/7fe55f00/uploads/origins/c91f3733-2eb2-42dc-aea1-3be48dec974c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37c27965f846e5f336c6e8fa07e3c5b3 3x", "genre": "art", "nsfw": true, "body": "自分の持ち主であるマスターの見抜き用オナペットになり、ディルドスクワットでアへ顔アクメをキメる遊戯王OCGの《RAI-MEI》と《閃刀姫ｰレイ》、《K9-17号 イズナ》の三人をリクエストします。\n\nキャラの造形は\n・全員頭身高めのむちむち、へそが隠れ股間がギリギリ見えるくらいの超乳(大きい分には可能な限り盛って下さい)\n・服装はカードと同じ物(レイの方は制服と戦闘服のどちらかお好みの物をお選び下さい)で、大きめかつ勃起したパフィーニップルな乳首と乳輪が布地越しにくっきり浮き出た状態になる。\n・性格のイメージはそれぞれお好きなようにお願いします。\n\n三人が横並び(中央はRAI-MEI固定)している姿を頭から太ももまで写し、以下のようなストーリーで台詞付きの差分を用意して欲しいです。\n\n挿入前。淫語混じりの嘘喘ぎや扇情的な表情など、いかにも余裕のある態度でこちらを挑発しながら、三人でマスターに自分達の痴態を見てもらうよう声を掛ける。また三人それぞれの斜め手前に馬ぺニス型の巨大なディルドが置かれている。\n↓\n挿入時。三人とも立ったままの姿勢からスクワットの要領でディルドを挿入し、その衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しく腰を振りながらディルドのピストンにより全員軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n同時絶頂。ディルドが根本まで完全に挿入され三人とも汚い口調で淫語を絶叫しながらイき、思い切り白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1RxErfHKIlZ2Wtir4kvfPIw3cxECBO84j", "created_at": "", "completed_at": ""}, {"path": "/@Sk9k2YOxmrYrixW/works/299", "thumbnail_src": "https://si.imgix.net/1e256e57/uploads/origins/21fb34e8-74c1-4a4e-b662-a8c3050b0634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3ade3acbe07b320745a4300a13ca1f4", "thumbnail_srcset": "https://si.imgix.net/1e256e57/uploads/origins/21fb34e8-74c1-4a4e-b662-a8c3050b0634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3ade3acbe07b320745a4300a13ca1f4, https://si.imgix.net/1e256e57/uploads/origins/21fb34e8-74c1-4a4e-b662-a8c3050b0634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d124d8a009c3b03e84658e166042eef4 2x, https://si.imgix.net/1e256e57/uploads/origins/21fb34e8-74c1-4a4e-b662-a8c3050b0634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d87bfdba803be58d34dfdb167e03fc4b 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n\n以下の設定のセリフ付イラストをお願いします。\n\nシチュエーションは　https://doget.fanbox.cc/posts/3023538 の続きである。咲-saki-の原村和が妊娠し、ボテ腹になり、爆乳が大きくなり、母乳を出す黒い巨乳輪ができた。妊娠しても、和ちゃんは小学生専用オナホールとして奉仕し続ける。\n\n和ちゃんの衣装は清澄高校セーラー服にニーソックス、ノーパン、ノーブラ。上着もスカートも短すぎて、爆乳と乳首とオマ〇コとお尻が見えている。髪型はツインテールです。\n\nセリフあり版もセリフなし版もお願いします。\n\nセリフなど、詳細ははお任せします。\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Sk9k2YOxmrYrixW/works/298", "thumbnail_src": "https://si.imgix.net/412a58e6/uploads/origins/9d4f4597-9dbd-485e-ac5a-f9df40eaa5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6b1f921a10a04324ee6798ede96fa7", "thumbnail_srcset": "https://si.imgix.net/412a58e6/uploads/origins/9d4f4597-9dbd-485e-ac5a-f9df40eaa5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6b1f921a10a04324ee6798ede96fa7, https://si.imgix.net/412a58e6/uploads/origins/9d4f4597-9dbd-485e-ac5a-f9df40eaa5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d353b00aacaecf495f36aafe78fa411 2x, https://si.imgix.net/412a58e6/uploads/origins/9d4f4597-9dbd-485e-ac5a-f9df40eaa5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ffe4e87627663df7f4cb713bcf78553 3x", "genre": "art", "nsfw": true, "body": "こんにちは\nハンドレッドのヴィタリーの着衣パイズリイラストをお願いします\n\n・おっぱいは爆乳盛りでお尻も大きく盛ったラスオリ体型な感じ\n\n・左手薬指に指輪\n\n・御主人様の所有物(おんな)な感じ(残りの人生及び人権その他諸々買い取られたイメージ)\n\n・おっぱいにバーコードと番号、刺青(トネリコとイトシャジンの花と蛇の刺青)、乳首ピアス(ストレートバーベルタイプでコスチューム越しにシルエットが分かる感じ)\n\n・イケメスな雰囲気\n\n構図はhttps://drive.google.com/file/d/1LleZj5_vmDYtTE3J5kJ66rTa1QCaNpMd/view?usp=drivesdkをベースに立ち絵風とパイズリ絵をお願いします(御主人様にパイズリ奉仕しているイメージ)\n\n・竿役の逸物は馬並で極太、カリ太の凶悪な感じ\n\n・差分で射精、眼鏡、リード付き首輪をお願いします\n\n・キャラ及びコスチューム資料https://drive.google.com/drive/folders/1aLR5CN2pIW6ISArK6oIObUG1hTlvhw1K", "created_at": "", "completed_at": ""}, {"path": "/@Sk9k2YOxmrYrixW/works/297", "thumbnail_src": "https://si.imgix.net/f0b4bd05/uploads/origins/09979cf4-c723-4279-9147-b4b9a5b4b2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03e3b6ccfbc33de9d2d85d252f4ffd01", "thumbnail_srcset": "https://si.imgix.net/f0b4bd05/uploads/origins/09979cf4-c723-4279-9147-b4b9a5b4b2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03e3b6ccfbc33de9d2d85d252f4ffd01, https://si.imgix.net/f0b4bd05/uploads/origins/09979cf4-c723-4279-9147-b4b9a5b4b2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad63d0d63d7a9fcb6c71a66636a50cb6 2x, https://si.imgix.net/f0b4bd05/uploads/origins/09979cf4-c723-4279-9147-b4b9a5b4b2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e17c4bb699f9566273b5fe1abdc237e 3x", "genre": "art", "nsfw": true, "body": "初めまして！pixivにて柔らかそうで超ド級のおっぱいに惹かれて参りました！\nもし良ければリクエストをお願い致します。\n\n【キャラクター】\n・深夢(霊媒師いずなAscension)\nhttps://drive.google.com/drive/folders/1qSqaygwHpcz1QSsIXndVNIGPk4VVZTRk?usp=drive_link\n・高橋律子先生(地獄先生ぬ～べ～)\n\n内容\n深夢は他人の夢に入る能力があり、律子先生共々淫夢に囚われて弄られてしまうシチュでお願いできればと思います。(原作では2人の絡みはありませんが)\n構図的には、以前描かれていた\nhttps://skeb.jp/@Sk9k2YOxmrYrixW/works/250\nのようにただでさえ大きい胸と尻を夢の中で超乳巨尻にされてしまった深夢と律子先生が真ん中に隆起している身の丈ほどもある巨大な肉棒に恋人つなぎでWパイズリフェラをしている感じでお願いします。\n陰部は極太のバイブが刺さっている感じでお願いします。\n律子先生は快楽に堕ちてしまっており、まだ堕ちていない深夢が正気に戻るように話しかけているようなフレーバーテキストがあると嬉しいです。\n又二人ともおっぱいを押し付け合っていますが律子先生の乳首が深夢の乳輪にめり込み、母乳で濡らしながら律子先生の乳首が深夢の乳首を犯しているようにみえると嬉しいです。\n\n長々とした文章申し訳ありません。\nご検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Sk9k2YOxmrYrixW/works/296", "thumbnail_src": "https://si.imgix.net/7e5d9b49/uploads/origins/4c50ab6a-c5c6-4c49-8a93-ef9ed20efb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a34ec9d0bb867f45f69dda521414071d", "thumbnail_srcset": "https:/