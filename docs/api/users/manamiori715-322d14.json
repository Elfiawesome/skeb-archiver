Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52f0d0b3f48134ac3f912213df5500d3 2x, https://si.imgix.net/9f191c5e/uploads/origins/901a8a75-29a8-476a-b7a7-2b0bbe331a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f948c79f3f9abf471ecb28353fc1c3f 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\n少し前にTwitterで見た佐久間まゆのイラスト大好きです。\n\nもしよければ自宅でお化粧をする佐久間まゆを描いていただきたいです。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@manamiori715/works/4", "thumbnail_src": "https://si.imgix.net/e3c2dfd3/uploads/origins/0e4fcc16-b0c4-4a76-9975-f9a4d75b1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=504a1f1aeef36a0661d2263f2683d9e3", "thumbnail_srcset": "https://si.imgix.net/e3c2dfd3/uploads/origins/0e4fcc16-b0c4-4a76-9975-f9a4d75b1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=504a1f1aeef36a0661d2263f2683d9e3, https://si.imgix.net/e3c2dfd3/uploads/origins/0e4fcc16-b0c4-4a76-9975-f9a4d75b1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b9e3e52edb132c98482c80c20af614 2x, https://si.imgix.net/e3c2dfd3/uploads/origins/0e4fcc16-b0c4-4a76-9975-f9a4d75b1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f4bb2291aa90685c4f4c45a13caa9e7 3x", "genre": "art", "nsfw": true, "body": "リクエストお願いします。\nアイドルマスターシンデレラガールズの棟方愛海が猫ランジェリーを着て、pixivで描かれていた佐久間まゆのイラスト（https://www.pixiv.net/artworks/94724489）のような表情で挑発的な笑顔を浮かべて、手の指をグーのように丸めて猫の手(猫の前足)を模した猫ポーズをしているイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@manamiori715/works/3", "thumbnail_src": "https://si.imgix.net/a7d55d01/uploads/origins/34b2fd03-42d0-4568-8655-094801ce441e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0a04babde4f60713ba86eb92dd4c1d9", "thumbnail_srcset": "https://si.imgix.net/a7d55d01/uploads/origins/34b2fd03-42d0-4568-8655-094801ce441e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0a04babde4f60713ba86eb92dd4c1d9, https://si.imgix.net/a7d55d01/uploads/origins/34b2fd03-42d0-4568-8655-094801ce441e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f76d10d2174ccb1955b94c44e126978 2x, https://si.imgix.net/a7d55d01/uploads/origins/34b2fd03-42d0-4568-8655-094801ce441e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcc2e60ff8fdd83bd52fa9cb65c3cf5a 3x", "genre": "art", "nsfw": false, "body": "初めまして、アピール頂いたのでリクエストさせていただきます。\n\n〇キャラ\n　東方の東風谷早苗さん\n\n〇内容\n・基本的にお任せ\n・可愛いけどちょっとセクシーな要素もある（例：巨乳など）感じだと嬉しいです\n\nご検討、お願いします", "created_at": "", "completed_at": ""}, {"path": "/@manamiori715/works/2", "thumbnail_src": "https://si.imgix.net/81fbba59/uploads/origins/212528ff-8265-4302-bb00-b425bc453924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f8480812774ffca7c8b2ac9fcebd74c", "thumbnail_srcset": "https://si.imgix.net/81fbba59/uploads/origins/212528ff-8265-4302-bb00-b425bc453924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f8480812774ffca7c8b2ac9fcebd74c, https://si.imgix.net/81fbba59/uploads/origins/212528ff-8265-4302-bb00-b425bc453924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b4d67c55c6775c40948f8429ed3a4c3 2x, https://si.imgix.net/81fbba59/uploads/origins/212528ff-8265-4302-bb00-b425bc453924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=013a3acafae12014d2f43f1fde5f60a8 3x", "genre": "art", "nsfw": false, "body": "はじめまして、むらちきです。アピールありがとうございます!\n自分は東方トレカ企画を運営しているのでそちらのイラストをお願いしたいです。\nなまみさんの好きなキャラの中ですとぬえのイラストを持ってないのでお願いしたいです。\n詳細は下記の通りです。\n\n内容：ぬえ\n補足：テーマ自由。可能ならタイトルとフレーバーテキスト(カード下部に表示するセリフや説明のこと)を考えて別レイヤーに書いてください。\n用途：トレカイラスト(東方トレカ制作企画「東之国の花絵札」)、トレカをまとめた本、カードサプライ、ステッカー、クリアファイル、これらのPR\nサイズ：2500*3200pixel 350dpi\n\nイラストの二次利用・掲載・作業の配信は自由です。制作されたイラストは2022年秋～1年以内に頒布開始します。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@manamiori715/works/1", "thumbnail_src": "https://si.imgix.net/1cbe56fd/uploads/origins/ec14d1a5-4e7f-4d39-9a3b-aa5a3410549e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7749fd626ad063ec97c5d1eac740981", "thumbnail_srcset": "https://si.imgix.net/1cbe56fd/uploads/origins/ec14d1a5-4e7f-4d39-9a3b-aa5a3410549e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7749fd626ad063ec97c5d1eac740981, https://si.imgix.net/1cbe56fd/uploads/origins/ec14d1a5-4e7f-4d39-9a3b-aa5a3410549e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02db0fada889d9f2f1744b3c54221b85 2x, https://si.imgix.net/1cbe56fd/uploads/origins/ec14d1a5-4e7f-4d39-9a3b-aa5a3410549e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0f5a02354acbb680836d2d11e594d2d 3x", "genre": "art", "nsfw": true, "body": "はじめまして、アピールありがとうございます\n\n・作品名/アイドルマスターシンデレラガールズ\n\n・キャラクター/赤西瑛梨華ちゃん\n\n・服装/ブラジャーとパンツ（色はピンク可愛い柄でお願いします）\n　　　\n・場所/ライブの着替え室\n\n・シチュエーション/野外ライブ終了後、着替え室のドアの鍵を掛け忘れて衣装を脱ぎ下着姿になっていた赤西瑛梨華ちゃん。突然ドアが開いて花束を持った子供のファンに下着姿を見られてしまった\n\n・表情/恥ずかしさで顔真っ赤\n\n以上、宜しくお願いします。", "created_at": "", "completed_at": ""}]}