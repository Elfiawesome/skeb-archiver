e55-a7e7-0c6b8d8d0601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcea56644287411dc42970f5c99188fd 2x, https://si.imgix.net/b2d1ccef/uploads/origins/f7221a65-e670-4e55-a7e7-0c6b8d8d0601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5594d8e96b368c171cf84453a1614f8 3x", "genre": "art", "nsfw": false, "body": "初めまして。突然のイラスト依頼失礼いたします。この度、4月に行われる蓮ノ空4thライブ石川公演にて個人でのフラスタ贈呈を考えており、その際フラスタの中心に飾る藤島慈ちゃんのイラストをじん様に制作いただけないかと思いご連絡させていただきました。お声がけさせていただいた理由ですが、じん様の力強く訴えてくるような目の描き方が個人的に好きで、特に藤島慈ちゃんの表情についてはこれ以上なく一目を置いているので、今回私の求めるイラストにピッタリだと考えたためです。skeb以外の公でない連絡手段が見受けられなかったので、このような形でのご連絡となったことをお許しください。\n\nイメージしているイラストの構図ですが、下記のように考えております。\n・ 全身\n・ 衣装、髪型は「ジョーショーキリュー」のリリックビデオやリンクラのカードと同様のもの\n・ ジャンプしながら手や表情は｢ハロめぐ〜！｣のように(学校を跳び出して世界中に自分の存在と｢愛してるよ♡｣を伝えているイメージ)\n\nこのようなイラストボードの両肩に天使の羽をイメージした白い花を、さらにその周りに青空をイメージした水色の花を敷き詰めたものをフラスタの全体像としようと考えています。\n\n今回の依頼につきまして、ご承認の可否やイラストの詳細、依頼料の調整など、まずはお返事いただけますと幸いです。お忙しいところ恐縮ですが、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@OihLf/works/6", "thumbnail_src": "https://si.imgix.net/090ebaa7/uploads/origins/d407c04b-ef3f-4732-a4d6-91f06689a593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14510d79afca5f9a465684a67d0387b", "thumbnail_srcset": "https://si.imgix.net/090ebaa7/uploads/origins/d407c04b-ef3f-4732-a4d6-91f06689a593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14510d79afca5f9a465684a67d0387b, https://si.imgix.net/090ebaa7/uploads/origins/d407c04b-ef3f-4732-a4d6-91f06689a593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86902e2410b1c794302e842e709d0839 2x, https://si.imgix.net/090ebaa7/uploads/origins/d407c04b-ef3f-4732-a4d6-91f06689a593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42e62fe357e7218bd7ba31249e3938a6 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nいつも目を惹く美しいイラストを拝見させて頂いております。\n\nよろしければ、リクエストさせて下さい。\nキャラクター:藤島慈\n服装:かほめぐ♡じぇら