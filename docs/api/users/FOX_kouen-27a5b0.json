6-ba7e-dbae2ec486f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a51eac87ba2c2a2cf8468c882625de5", "thumbnail_srcset": "https://si.imgix.net/670e1a10/uploads/origins/d336f711-37f8-4d86-ba7e-dbae2ec486f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a51eac87ba2c2a2cf8468c882625de5, https://si.imgix.net/670e1a10/uploads/origins/d336f711-37f8-4d86-ba7e-dbae2ec486f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51ebbaede05836345f37d86aa8b623a5 2x, https://si.imgix.net/670e1a10/uploads/origins/d336f711-37f8-4d86-ba7e-dbae2ec486f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9d29d1edd95c55a28465b8344a0f4d4 3x", "genre": "art", "nsfw": true, "body": "拝啓　狐ノ紅焔様\n\n陽春の候、貴社ますますご繁栄のこととお慶び申し上げます。\n平素は格別のご厚情を賜り厚くお礼申し上げます。\n\nさて、依頼の件につきまして、私スレッカーJ7のイラストを描いていただきたくご依頼しました。\nポーズなどは書斎など本のたくさんある場所で椅子に座りながら本を読んでいる(本の種類はお任せします。教科書や漫画でもR-18でもなんでも構いません)様にと思います。\nが、紅焔様の描きたいものがごさいましたら、そちらを優先して下さいませ。(指定したものを書くのも良し、指定関係なく、描きたいポーズ、練習したいポーズなどあればそちらを優先してください)\n\n近年のご活躍の末、ご多忙中のところ誠に恐縮ですがよろしくお願い致します。\n末筆ながらますますのご活躍をお祈り申し上げます。\n\n敬具", "created_at": "", "completed_at": ""}, {"path": "/@FOX_kouen/works/3", "thumbnail_src": "https://si.imgix.net/715cf848/uploads/origins/15e3adce-4c38-4d3b-a90d-111a88e1b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e916df204bbf1c3ebb952a1e4c0172f3", "thumbnail_srcset": "https://si.imgix.net/715cf848/uploads/origins/15e3adce-4c38-4d3b-a90d-111a88e1b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e916df204bbf1c3ebb952a1e4c0172f3, https://si.imgix.net/715cf848/uploads/origins/15e3adce-4c38-4d3b-a90d-111a88e1b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9197aedf3229116ad4b60537765590a4 2x, https://si.imgix.net/715cf848/uploads/origins/15e3adce-4c38-4d3b-a90d-111a88e1b0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3eba65e69bb4dfdede6d5174f34b659b 3x", "genre": "art", "nsfw": false, "body": "拝啓　時下ますますご清栄のこととお喜び申し上げます。平素は格別のご高配、誠にありがとうございます。\n\nさて、依頼の件につきまして、\nこの度は最高にいきがっていて尚且つカッコいいレビンを絵をご依頼したく思います。\n\nご多忙中のところ誠に恐縮ですがよろぴくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@FOX_kouen/works/2", "thumbnail_src": "https://si.imgix.net/bb05f2ab/uploads/origins/ad4843b6-066c-4339-ab56-704997067cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a1883a7c8b3b52ed2d707502948b6d", "thumbnail_srcset": "https://si.imgix.net/bb05f2ab/uploads/origins/ad4843b6-066c-4339-ab56-704997067cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a1883a7c8b3b52ed2d707502948b6d, https://si.imgix.net/bb05f2ab/uploads/origins/ad4843b6-066c-4339-ab56-704997067cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8636287b0385b41a0ae155ddfd4d2c28 2x, https://si.imgix.net/bb05f2ab/uploads/origins/ad4843b6-066c-4339-ab56-704997067cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66995285c6dd936519dc825b683867ad 3x", "genre": "art", "nsfw": false, "body": "紅焔さんこんばんはです！\n\n今回イラストを頼みたくリクエスト送らせて頂きました！\n\nイラストはポージングや服装はすべてお任せします！\nそう、丸投げです！\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@FOX_kouen/works/1", "thumbnail_src": "https://si.imgix.net/cc87cf94/uploads/origins/f3026249-b4bd-48a0-bbf8-0eabdfb477a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a900df0ccba3c7c1a9f6365190892866", "thumbnail_srcset": "https://si.imgix.net/cc87cf94/uploads/origins/f3026249-b4bd-48a0-bbf8-0eabdfb477a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a900df0ccba3c7c1a9f6365190892866, https://si.imgix.net/cc87cf94/uploads/origins/f3026249-b4bd-48a0-bbf8-0eabdfb477a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4c64287b7737f0aaf5db5f52bfc51c6 2x, https://si.imgix.net/cc87cf94/uploads/origins/f3026249-b4bd-48a0-bb