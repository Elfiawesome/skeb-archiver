=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26090c674d7fcc288218f30851782210 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/295", "thumbnail_src": "https://si.imgix.net/729ab14e/uploads/origins/af93ddbc-ef59-41a0-9a3e-6f5b58209db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa3e560908cce4386ed5471062b62132", "thumbnail_srcset": "https://si.imgix.net/729ab14e/uploads/origins/af93ddbc-ef59-41a0-9a3e-6f5b58209db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa3e560908cce4386ed5471062b62132, https://si.imgix.net/729ab14e/uploads/origins/af93ddbc-ef59-41a0-9a3e-6f5b58209db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26a84b383daf94cdf019dd01616ca9c6 2x, https://si.imgix.net/729ab14e/uploads/origins/af93ddbc-ef59-41a0-9a3e-6f5b58209db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58cff8915451d5ce352ad7ad56d24ed5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/294", "thumbnail_src": "https://si.imgix.net/baad63ca/uploads/origins/cae0ff17-d860-43b6-8670-6e12add3ea5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aa9a82c57f9e39ebf520b867c03c3fc", "thumbnail_srcset": "https://si.imgix.net/baad63ca/uploads/origins/cae0ff17-d860-43b6-8670-6e12add3ea5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aa9a82c57f9e39ebf520b867c03c3fc, https://si.imgix.net/baad63ca/uploads/origins/cae0ff17-d860-43b6-8670-6e12add3ea5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c116f60b9ab401f28e1ca52ed5e46420 2x, https://si.imgix.net/baad63ca/uploads/origins/cae0ff17-d860-43b6-8670-6e12add3ea5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718f21574381001fc4783d04dd5a9d6d 3x", "genre": "art", "nsfw": true, "body": "こんにちは、こんにちは、\n前回のリクエストはありがとうございました。\n今回は私のOCの一人のバッドエンドをお願いしたいと思います。\n165cmでHカップです。\nhttps://drive.google.com/file/d/1OxxL_r4L3tgBEs0EZdAyCrtK2jhdpsYq/view?usp=sharing\n鬼人か盗賊に捕まって強引に犯されたいです。\n1.1.膣にペニスを押し当てながら、パニックになって恐怖に怯える。\n2.男性は彼女を挿入し、レイプする。ショックと快感で彼女はもがくはずだ。\n3.二人目の男性が、ペニスを喉に詰まらせながら、彼女の喉を犯す。\n4.両方の男性が彼女の中に大量に射精する。\n5.膣と口から精液が漏れるので、二人に抜いてもらい、彼女の顔と胸にさらに精液をかける。彼女の表情は崩れ、委縮しているはずだ。\n6.6.新しい男たちに彼女を犯す準備をさせ、彼女の表情は悲しみに変わる。\n精液と淫らな表情をふんだんに盛り込んでください。\nご検討ありがとうございました。\n\nhttps://drive.google.com/file/d/16FXf5LkTusGxfBvL76wP893XP-ih3zo2/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/293", "thumbnail_src": "https://si.imgix.net/b52c657b/uploads/origins/4523b316-5af5-46d1-91f2-2fa9d1bb72fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=056760d4120008247dbbd4e0c5602823", "thumbnail_srcset": "https://si.imgix.net/b52c657b/uploads/origins/4523b316-5af5-46d1-91f2-2fa9d1bb72fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=056760d4120008247dbbd4e0c5602823, https://si.imgix.net/b52c657b/uploads/origins/4523b316-5af5-46d1-91f2-2fa9d1bb72fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a55ffff472a2c6f97ed96f41ca89a83c 2x, https://si.imgix.net/b52c657b/uploads/origins/4523b316-5af5-46d1-91f2-2fa9d1bb72fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41627fc540c2d49fdd0db6d583777add 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/292", "thumbnail_src": "https://si.imgix.net/e510b091/uploads/origins/e1fba5fb-af16-4fe8-a937-46b7b4b58a26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bc1477c146659c1512e52c0009165d9", "thumbnail_srcset": "https://si.imgix.net/e510b091/uploads/origins/e1fba5fb-af16-4fe8-a937-46b7b4b58a26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bc1477c146659c1512e52c0009165d9, https://si.imgix.net/e510b091/uploads/origins/e1fba5fb-af16-4fe8-a937-46b7b4b58a26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5455f7d6309192de0202cb6b03e88f09 2x, https://si.imgix.net/e510b091/uploads/origins/e1fba5fb-af16-4fe8-a937-46b7b4b58a26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfefae7943bc7313e6b108cedfd05f32 3x", "genre": "art", "nsfw": true, "body": "作品　ヘブンバーンズレッド\nキャラ　東城つかさ(覚醒)\n\n覚醒verでは記憶喪失前の人格になっている。\nクールでハイスペックだが高飛車で周りの人間を見下している。\n\nシチュエーション\n失踪した母の情報を探るため諜報員として敵の組織に潜入していたが捕まってしまう。\n拘束されたつかさはパンツのクロッチを横にずらされて手マンされている。\n男の描写は腕とセリフのみ。男はやや痩せている。\nアングルは正面からで、以下のようは椅子に四肢拘束されている。\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTYGv7PaDsuoxG7ZEXqQBeNRXtvv555PCYFwA&usqp=CAU\n\n衣装\n制服姿だがタイツだけ脱がされている。\n制服は着衣状態でパンツは紺色。\n\n1枚目\n少し感じていることがバレないよう気丈に振る舞っている。\n\n男「そろそろ感じてきたかな？」\nつかさ「は？こんなので感じるわけないじゃない」\n\n2枚目\n弱いところを責められクチュクチュと音を立てている。つかさはイキそうだが強気な態度でなんとか耐えており、必死にガチャガチャと拘束を解こうとする。\n\nつかさ「さっきからネチネチと...！いい加減にっ...しなさい...！」\n男「素直じゃないなー。本当はイキそうなんだろ？」\nつかさ「そんなわけ...ないでしょ...！」\n\n3枚目\nつかさはなんとか我慢しようとするが声が漏れている。\n男「そろそろ限界かな？ここだ♫」\nついに大きな喘ぎ声を出して手マンされたまま豪快に潮吹き絶頂。\n\n4枚目\n愛液を指で引き延ばして見せつけられている。\n憎き男の前で醜態を晒してしまったつかさは悔しそうな表情。\n盛大に絶頂したことを男に揶揄され、つかさは必死に反論している。\n\n以上、よろしくお願いします。\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTYGv7PaDsuoxG7ZEXqQBeNRXtvv555PCYFwA&usqp=CAU", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/291", "thumbnail_src": "https://si.imgix.net/03d641c6/uploads/origins/dca8a561-52cd-4b7b-98c5-a650f9f2f399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff33c905cb12cb278c29e920743caeb1", "thumbnail_srcset": "https://si.imgix.net/03d641c6/uploads/origins/dca8a561-52cd-4b7b-98c5-a650f9f2f399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff33c905cb12cb278c29e920743caeb1, https://si.imgix.net/03d641c6/uploads/origins/dca8a561-52cd-4b7b-98c5-a650f9f2f399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4592433b3997cc869f09e6d289779171 2x, https://si.imgix.net/03d641c6/uploads/origins/dca8a561-52cd-4b7b-98c5-a650f9f2f399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d39e09117f27e9ff238d5f7eba261ce3 3x", "genre": "art", "nsfw": true, "body": "いつもありがとうございます。\n\n今回はフェアリーテイルのエルザ・スカーレットがバックで突かれながら鎖で首を絞められているイラストをお願いします。\n\nエルザは全裸。髪を下した状態。両手首は腰の後ろで縛られている。\n鎖をグイっと引かれ、背を少し反らせた状態。\n絞めている後ろの男の方を向いて、苦しそうな表情。\n差分で、両目を硬く閉じているものをお願いします。\n\n男は手首と鎖、チンポだけ描いていただければいいです。\n\n鎖と男は映っていない状態の差分もお願いします。\n\n背景不要です。真っ黒にしてください", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/290", "thumbnail_src": "https://si.imgix.net/6106757f/uploads/origins/d277889b-2016-49c0-9add-45b15652d4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d808c24f5d5ef2249058bbb3ed9a3ba2", "thumbnail_srcset": "https://si.imgix.net/6106757f/uploads/origins/d277889b-2016-49c0-9add-45b15652d4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d808c24f5d5ef2249058bbb3ed9a3ba2, https://si.imgix.net/6106757f/uploads/origins/d277889b-2016-49c0-9add-45b15652d4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e078de56bd9de33a60607f87e9a13f9b 2x, https://si.imgix.net/6106757f/uploads/origins/d277889b-2016-49c0-9add-45b15652d4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a75452a7e6f6d3c1c3f734ed051a045f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/289", "thumbnail_src": "https://si.imgix.net/a96590f2/uploads/origins/52b10d5a-65a0-4473-80b1-3a2a05eac113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e704e9b898ef01dc34bc50cdf7308c8", "thumbnail_srcset": "https://si.imgix.net/a96590f2/uploads/origins/52b10d5a-65a0-4473-80b1-3a2a05eac113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e704e9b898ef01dc34bc50cdf7308c8, https://si.imgix.net/a96590f2/uploads/origins/52b10d5a-65a0-4473-80b1-3a2a05eac113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=018ba3d9abba52ffb831ea98d4aeca1a 2x, https://si.imgix.net/a96590f2/uploads/origins/52b10d5a-65a0-4473-80b1-3a2a05eac113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1121422f6838f254d2751823be6be08b 3x", "genre": "art", "nsfw": true, "body": "こんばんは\nhttps://skeb.jp/@KMMYmymy/works/285\n前回の続きをお願いします\n\n■キャラクター\nダンまちのヤマト・命\n\n■シチュエーション\n命がベルくんの勃起した陰茎に気づき抜いてあげる\n\n■構図\n前回のあと命が尻が剥き出しになってたことに気づき振り向くとベルくんの勃起した陰茎を見つけてしまい、そのままでは温泉に入れないだろうからと責任を取って抜くような導入です\n2コマに分けていただき、命が拙い性知識でベルくんの陰茎を手でしごいてあげているところと風呂桶のような容器に射精させているところをお願いします\n\n命もベルくんの陰茎が思いの外大きいことと初めてさわったところからドキドキしてるような表情だと嬉しいです\n射精させる時はお湯に精液が入らないように慌てて風呂桶かなにかに射精させている感じでお願いします\n命は恥ずかしがりながらも初めての陰茎に興味がある感じでお願いします\nお尻は剥き出しのままだと嬉しいです\n前回同様、二人共陰毛無しムダ毛無しで肌のテカリが強めのつやつやだと嬉しいです\nベルくんの陰茎は特別大きいわけではないものの張りツヤがあってとにかく固く精液の量が多い感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/288", "thumbnail_src": "https://si.imgix.net/dadf7c4a/uploads/origins/e194029e-9bfe-42af-b4cd-e61bfa386dba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=070ac6c1a75dea0684271780e26b17d2", "thumbnail_srcset": "https://si.imgix.net/dadf7c4a/uploads/origins/e194029e-9bfe-42af-b4cd-e61bfa386dba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=070ac6c1a75dea0684271780e26b17d2, https://si.imgix.net/dadf7c4a/uploads/origins/e194029e-9bfe-42af-b4cd-e61bfa386dba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87f2f1479e252040f62469b672e7f57d 2x, https://si.imgix.net/dadf7c4a/uploads/origins/e194029e-9bfe-42af-b4cd-e61bfa386dba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22d6455e3564d7f31402160f39b21d2d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KMMYmymy/works/287", "thumbnail_src": "https://si.imgix.net/c8984542/uploads/origins/f916a6c2-c502-4f06-8dab-c8f3e96d3042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72b950991eb806b82870dd9485511b8e", "thumbnail_srcset": "https://si.imgix.net/c8984542/uploads/origins/f916a6c2-c502-4f06-8dab-c8f3e96d3042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFF