6d0-519d60785c23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f681d1a80ca5a7c4b3204a9d629a100 2x, https://si.imgix.net/35f809d0/uploads/origins/4a1f5e75-aac0-451c-a6d0-519d60785c23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08997ba9349c0eaa6b33a7dad2f48b62 3x", "genre": "art", "nsfw": false, "body": "hello! I love your art and have been following you for a while, I was wondering if you could please draw my cat-girl. she is super pale, has light pink hair in a super long wavy ponytail, white cat eyes, and a fluffy tail and fluffy cat ears. I've attached a sample outfit but feel free to draw her wearing whatever you think looks nice! if you could draw her looking melancholic and demure that would be great! she has a bit of an angelic vibe. i love your aesthetic and style so really do whatever you want!\n\nreferences:\nhttps://imgur.com/a/ZO0c9eq\nhttps://imgur.com/a/lwklDsp\n\noutfit: https://www.daz3d.com/dforce-co-sweet-outfit-for-genesis-8-and-81-females\n(white top, pink plaid skirt, but you can draw her wearing something else if you would prefer!)\n\nthank you so much for considering!", "created_at": "", "completed_at": ""}, {"path": "/@Bambyumi/works/4", "thumbnail_src": "https://si.imgix.net/7bd9c664/uploads/origins/eec2d45e-4ba7-43e0-92dd-dbdee782b60a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae7f0316b1cf2ddfdf685f5dcd618b4", "thumbnail_srcset": "https://si.imgix.net/7bd9c664/uploads/origins/eec2d45e-4ba7-43e0-92dd-dbdee782b60a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae7f0316b1cf2ddfdf685f5dcd618b4, https://si.imgix.net/7bd9c664/uploads/origins/eec2d45e-4ba7-43e0-92dd-dbdee782b60a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f74ff6b0c9941b53aaa192ae14694fce 2x, https://si.imgix.net/7bd9c664/uploads/origins/eec2d45e-4ba7-43e0-92dd-dbdee782b60a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f3b3aa364bcc3afd98f44b62144aaf1 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの作品はとても美しいです。私のキャラクターのイラストをお願いできればと思いました。\n\n頬にそばかすがある子です。表情は不思議な笑みを浮かべて描いてください。また、モチーフは星でお願いします。\n\nポーズはおまかせします。複雑すぎて描けないものは、自由に調整・簡略化してください。ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WECOoYHDerZR4lMxMXSSZFjOBQ_whAZG", "created_at": "", "completed_at": ""}, {"path": "/@Bambyumi/works/3", "thumbnail_src": "https://si.imgix.net/3c179b1c/uploads/origins/7cf109d0-64d6-41d9-95c1-4c0d877719ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3592b7d9c9e3e3718f04f3124f095817", "thumbnail_srcset": "https://si.imgix.net/3c179b1c/uploads/origins/7cf109d0-64d6-41d9-95c1-4c0d877719ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3592b7d9c9e3e3718f04f3124f095817, https://si.imgix.net/3c179b1c/uploads/origins/7cf109d0-64d6-41d9-95c1-4c0d877719ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2c4c52869c55cb9ab771b965a24906b 2x, https://si.imgix.net/3c179b1c/uploads/origins/7cf109d0-64d6-41d9-95c1-4c0d877719ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f8427add2474ece37b55887dc10f3b5 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートは本当にクールだと思います。私はその美学が大好きです。私のVTuberをあなたのスタイルで描いて頂きたいのです。彼女は元気でかわいいレースクイーンです。どんなポーズ、服装、髪型、表情でも可愛いと思えば自由に描いてください。\n\nhttps://toyhou.se/13540888.-", "created_at": "", "completed_at": ""}, {"path": "/@Bambyumi/works/2", "thumbnail_src": "https://si.imgix.net/0cfa6931/uploads/origins/8c1eebc4-1e25-4cff-a9a7-74ac8664c29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eccd0aa1952533aec7bd67d3d806dcee", "thumbnail_srcset": "https://si.imgix.net/0cfa6931/uploads/origins/8c1eebc4-1e25-4cff-a9a7-74ac8664c29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eccd0aa1952533aec7bd67d3d806dcee, https://si.imgix.net/0cfa6931/uploads/origins/8c1eebc4-1e25-4cff-a9a7-74ac8664c29e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=276930541abe41f52f0a4dc7fe870e71 2x, https://si.imgix.net/0cfa6931/uploads/origins/8c1eebc4-1e25-4cff-a9a7-74ac8664c29e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84e5ae5a1f018bd7c482c19b466a320a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのアートスタイルが本当に好きです - 私の要求を考慮してもらえますか？\n\n私のキャラクターを描いていただけませんか？服は好きなものを選んでいいし、デザイン変更もOK!ファッションセンスが超カワイイ!あなたの作品に表れる感情がとても好きです。\nキャラの髪の長さは、短髪の写真とほぼ同じ長さに切ってほしいです。悲しい顔、泣き顔。キャラが笑ってない。\n\nこのような作品を見て、自分の好みのイメージを膨らませることができ、とても刺激を受けています。\nhttps://twitter.com/Bambyumi/status/1495658094789263362?s=20&t=eIwKgjep28cBHuc7rr4veQ\nhttps://twitter.com/Bambyumi/status/1476428683242242050?s=20&t=eIwKgjep28cBHuc7rr4veQ\n\nキャラクター参考： https://imgur.com/a/b0eoaVH\n\n私のリクエストを考慮していただき、ありがとうございます！素晴らしい一日をお過ごしください。", "created_at": "", "completed_at": ""}, {"path": "/@Bambyumi/works/1", "thumbnail_src": "https://si.imgix.net/26d5ebdb/uploads/origins/35da3b04-3e10-402c-aa4c-cee152c8e583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b28bb7df9edee4b4fdfdc1d33e928d7", "thumbnail_srcset": "https://si.imgix.net/26d5ebdb/uploads/origins/35da3b04-3e10-402c-aa4c-cee152c8e583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b28bb7df9edee4b4fdfdc1d33e928d7, https://si.imgix.net/26d5ebdb/uploads/origins/35da3b04-3e10-402c-aa4c-cee152c8e583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f92fc006710ac45624d5d43b1338d725 2x, https://si.imgix.net/26d5ebdb/uploads/origins/35da3b04-3e10-402c-aa4c-cee152c8e583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74c19739727c8ba2ec371fb362f41685 3x", "genre": "art", "nsfw": false, "body": "HELLO! I am so excited to see that you have started skeb! It would be an honor if you could draw my character, Lumi. She is a star who is far away from home. I love love love the dark atmosphere