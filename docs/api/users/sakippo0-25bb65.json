-a298-4e4c-9e21-c937c8dbfc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a16e76e3644c768dc219f9c89d7b53d7", "thumbnail_srcset": "https://si.imgix.net/71210a29/uploads/origins/c21ced20-a298-4e4c-9e21-c937c8dbfc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a16e76e3644c768dc219f9c89d7b53d7, https://si.imgix.net/71210a29/uploads/origins/c21ced20-a298-4e4c-9e21-c937c8dbfc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9b44d59ffebeb28415683bf4014053b 2x, https://si.imgix.net/71210a29/uploads/origins/c21ced20-a298-4e4c-9e21-c937c8dbfc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdb195c5ead5fd7ad0bd4c36175673f0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakippo0/works/43", "thumbnail_src": "https://si.imgix.net/843f5e5f/uploads/origins/5ee28e92-2c06-4fc9-9a4f-ef3f11956ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23bb49ab48c07b0b6f0274f725ca1ee1", "thumbnail_srcset": "https://si.imgix.net/843f5e5f/uploads/origins/5ee28e92-2c06-4fc9-9a4f-ef3f11956ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23bb49ab48c07b0b6f0274f725ca1ee1, https://si.imgix.net/843f5e5f/uploads/origins/5ee28e92-2c06-4fc9-9a4f-ef3f11956ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a67725484cbdc9ae4191cf9e1d853d0 2x, https://si.imgix.net/843f5e5f/uploads/origins/5ee28e92-2c06-4fc9-9a4f-ef3f11956ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&