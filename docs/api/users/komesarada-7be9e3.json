ーリフレクション帝より宮内伶那と金城勇希の結婚式のイラストを描いて頂きたいです。二人ともウェディングドレスで、お互いを向き合って頬を少し赤らめながら微笑んでる様子でお願いします。\nウェディングドレスのデザインはお任せしますが、伶那さんのリフレクター姿のフォルムが一部ドレスっぽいので、伶那さんのドレスはリフレクター姿の要素が少し入ってるようなデザインだと嬉しいです。\n背景やその他要素はお任せします。\n\nブルリフで一番好きなカップリングなので、ぜひ藤原のあ先生の可愛らしいイラストで見てみたいです。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@komesarada/works/19", "thumbnail_src": "https://si.imgix.net/ac16a4eb/uploads/origins/5a28a940-2538-44ae-8413-07c5eb997f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c46dba489c9029a4fa84d8b4b39edd7", "thumbnail_srcset": "https://si.imgix.net/ac16a4eb/uploads/origins/5a28a940-2538-44ae-8413-07c5eb997f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c46dba489c9029a4fa84d8b4b39edd7, https://si.imgix.net/ac16a4eb/uploads/origins/5a28a940-2538-44ae-8413-07c5eb997f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5bc1dea11428fe6bab622bc1d5e4893 2x, https://si.imgix.net/ac16a4eb/uploads/origins/5a28a940-2538-44ae-8413-07c5eb997f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65f1ccbb33bdac94936384dbaadfe891 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@komesarada/works/18", "thumbnail_src": "https://si.imgix.net/729534c0/uploads/origins/b3906e5c-6132-4520-b747-f171cf882ce1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b66b353dd00395c0557a34fb60b2e9b", "thumbnail_srcset": "https://si.imgix.net/729534c0/uploads/origins/b3906e5c-6132-4520-b747-f171cf882ce1?bg=%23fff&auto=format%2Ccompress