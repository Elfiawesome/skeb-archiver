-a68a-3846d6d6d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1081307b5a1ec8313ffe3f2a35f9b0eb", "thumbnail_srcset": "https://si.imgix.net/54942524/uploads/origins/f5164d49-f020-4026-a68a-3846d6d6d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1081307b5a1ec8313ffe3f2a35f9b0eb, https://si.imgix.net/54942524/uploads/origins/f5164d49-f020-4026-a68a-3846d6d6d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfbd99f99c6ac7eb33785624bdf964d2 2x, https://si.imgix.net/54942524/uploads/origins/f5164d49-f020-4026-a68a-3846d6d6d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee19c7410fafa3243f3f2c14b0cce6d6 3x", "genre": "comic", "nsfw": true, "body": "原崎先生はじめまして！\n早速リクエストなのですが\n東方のレミリアとフランで\nシチュは「二人共生きたまま胸元を解剖されて、無理やり心臓を堪能されられる二人」をお願いします。\n\n二人共十字架に貼り付けにされた状態で正面から見てレミリアが左、フランが右に横に並び、着衣はしているものの胸元を開いていて\n胸元が見えている状態で二人共胸元を切り開かれて、心臓を露出させられる。\n\n露出させられた二人の心臓は恐怖と痛みで激しく脈打っている\nその心臓を引き釣りだされ、そのあと二人がそれぞれ自身の心臓を眼の前に見せつけられたあと、「戻して…」と懇願した瞬間に心臓の血管を切られ、脈打つ二人の心臓から血が吹き出す。\n\n取り出されても徐々に弱っていく相手の心臓の音(レミリアは左耳にフランの心臓、フランは右耳にレミリアの心臓)を直接耳に押し当てられ、お互いの心臓が弱っていくのを、意識が遠のく中聴かせられる。\n\n二人の意識が落ちても、二人の心臓が仲良く隣で弱々しく脈打っている…\nという作品をお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/21", "thumbnail_src": "https://si.imgix.net/d8ae4857/uploads/origins/a97a9c69-3a19-45c4-be72-aafe1ed741d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e41bfabfa4b7140e6aac0bb35864f22", "thumbnail_srcset": "https://si.imgix.net/d8ae4857/uploads/origins/a97a9c69-3a19-45c4-be72-aafe1ed741d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e41bfabfa4b7140e6aac0bb35864f22, https://si.imgix.net/d8ae4857/uploads/origins/a97a9c69-3a19-45c4-be72-aafe1ed741d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72f39b89b1c4638b10861123e629f3bd 2x, https://si.imgix.net/d8ae4857/uploads/origins/a97a9c69-3a19-45c4-be72-aafe1ed741d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b0ac6a5b03cd05c41648b2b3db5cfe7 3x", "genre": "comic", "nsfw": true, "body": "Hello, I like your guro works. I would like to see a comic series of Professor Niyaniya experiencing various ryona/guro scenarios. \n\n\nDetails\n- She constantly awakens to find herself in a predicament to where she is shortly tortured, killed, or brutally raped. Examples can be hanging, amputation, stabbings, enema gangbangs etc.\n-However, it later turns out the scenarios she is experiencing are all false realities and hallucinations by Sensei. She is amputated and strapped onto a machine where he can view and enjoy her suffering.\n -Numerous diodes are inserted into her head.  She is fully sensory deprived by a vr headset that blocks sight and hearing and is unaware her reality is much crueler. \nexample: https://files.catbox.moe/l8t8nv.jpg\n- The machine has functions to keep her alive and remove bodily waste, administer aphrodisiacs etc.\n- Please have no viscera or scat when depicting the guro scenes.\n- I would like to see torn pantyhose in one of the guro scenes you decide to go with.", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/20", "thumbnail_src": "https://si.imgix.net/08470c70/uploads/origins/54ed2424-0c65-411f-83bb-3869730aaf43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fab530edc2ba8c0d3bde0a5fa773c1b6", "thumbnail_srcset": "https://si.imgix.net/08470c70/uploads/origins/54ed2424-0c65-411f-83bb-3869730aaf43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fab530edc2ba8c0d3bde0a5fa773c1b6, https://si.imgix.net/08470c70/uploads/origins/54ed2424-0c65-411f-83bb-3869730aaf43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02e0820136842c53ed73194b1a439984 2x, https://si.imgix.net/08470c70/uploads/origins/54ed2424-0c65-411f-83bb-3869730aaf43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=957b4ab040768a9f3a778a8d23e6d343 3x", "genre": "comic", "nsfw": true, "body": "艦これのレーベレヒト・マースで頭部破壊をお願いします。\n\n晒し台に固定し、上から鉄塊を吊るします\n鉄塊を制御するロープを噛むようにします\n落下する鉄塊で頭を潰す方法で処刑します\n\n処刑前、恐怖の表情を浮かべて泣いている  \n処刑中、鉄の塊が頭を潰し、肉片が飛び散る  \n処刑後、体がわずかに痙攣し、失禁する", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/19", "thumbnail_src": "https://si.imgix.net/2f2c045b/uploads/origins/6c98be62-565f-4642-82c6-730a4de161a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d1b85cbe6af4f8d78234e82f5b0521", "thumbnail_srcset": "https://si.imgix.net/2f2c045b/uploads/origins/6c98be62-565f-4642-82c6-730a4de161a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d1b85cbe6af4f8d78234e82f5b0521, https://si.imgix.net/2f2c045b/uploads/origins/6c98be62-565f-4642-82c6-730a4de161a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=617276c46bbd9fd225803a491fbd2226 2x, https://si.imgix.net/2f2c045b/uploads/origins/6c98be62-565f-4642-82c6-730a4de161a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08aa14a8ac37a4decc2e3e0fd002ce10 3x", "genre": "art", "nsfw": true, "body": "原作『メタルスラッグ』\nキャラクター\n『フィオ・ジェルミ』\nシチュエーション\n『死体置場に置かれたフィオの死体袋が漁られ死体を犯される』\n・死体袋の中のフィオの死体は全裸（髪は下ろされメガネも外されている）\n・首にドッグタグが掛けられている\n・片目や首、腹部に包帯やガーゼが巻かれている（血まみれ\n・目と口が半開きで微睡んでいるような顔", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/18", "thumbnail_src": "https://si.imgix.net/ae4893c3/uploads/origins/0d7314f2-f75f-45bc-ace7-ae04ca76d0b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9436ad1ee984a0ef2cda6cb3575c6378", "thumbnail_srcset": "https://si.imgix.net/ae4893c3/uploads/origins/0d7314f2-f75f-45bc-ace7-ae04ca76d0b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9436ad1ee984a0ef2cda6cb3575c6378, https://si.imgix.net/ae4893c3/uploads/origins/0d7314f2-f75f-45bc-ace7-ae04ca76d0b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a61f99dea81fde62bdf4e367d6307bac 2x, https://si.imgix.net/ae4893c3/uploads/origins/0d7314f2-f75f-45bc-ace7-ae04ca76d0b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23ffd062644cbc20e287fb3ee70be154 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/17", "thumbnail_src": "https://si.imgix.net/1857cf54/uploads/origins/cc4abbe9-f04d-4d24-aa5d-3e8723c95c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b782bbe127c64f6634cd702550d07d", "thumbnail_srcset": "https://si.imgix.net/1857cf54/uploads/origins/cc4abbe9-f04d-4d24-aa5d-3e8723c95c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b782bbe127c64f6634cd702550d07d, https://si.imgix.net/1857cf54/uploads/origins/cc4abbe9-f04d-4d24-aa5d-3e8723c95c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32941aad97f65f90241431a626ccbe52 2x, https://si.imgix.net/1857cf54/uploads/origins/cc4abbe9-f04d-4d24-aa5d-3e8723c95c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=173fa7d1fa3a19179dea746053f46b91 3x", "genre": "comic", "nsfw": true, "body": "リクエスト再開お待ちしていました。斬首ゲロ！いいですよね！\nということでリクエストさせていただきます\n\nキャラクター：カサンドラ（ソウルキャリバーより。恰好は２の水色と白のやつでお願いしますまたグラマラスでむちむち感もあるといいです）\nシチュ：\n上記の意通り、斬首ゲロで。イメージとしては戦いに負けて\n拉致監禁され好き放題犯されはらまされてその状態でもさらに雌奴隷にされる。\n出産直前になるも飽きられ斬首ゲロで処分されてしまう。みたいな\n\n・完全に心が折れて雌奴隷化（口調なども）\n・お手入れを許されていないので腋毛ありや下の毛も下着（替えもあまり許されないので染みパンだと嬉しいです）からはみ出ていたり。\n・流れとしては着衣ボテのまま中出しされる（媚びるようなセリフとかも）→\n　「お前ももう飽きてきたなー処分するか」みたいな処刑宣告→\n　→以前の勝気感はもう全くなく情けなく命乞い（恐怖で失禁なども\n　→命乞いむなしく斬首ゲロしみっともないがに股痙攣ボテ腹で下着の中に盛大に大小おもらし、着衣噴出乳など\n　→可能ならばそのまま赤子も死後ひりだす感じで\n　→その様子を周りの男たちにあざ和られている。\n\n細かい所はお任せ（料金に見合わない等あればどんどん省略してもらってかまいません）します。\nご検討お願いします", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/16", "thumbnail_src": "https://si.imgix.net/a108133a/uploads/origins/9f01a25d-195e-471a-8e3b-dcaf499b60c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f992134250cd2bcf920a6c51d40a624", "thumbnail_srcset": "https://si.imgix.net/a108133a/uploads/origins/9f01a25d-195e-471a-8e3b-dcaf499b60c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f992134250cd2bcf920a6c51d40a624, https://si.imgix.net/a108133a/uploads/origins/9f01a25d-195e-471a-8e3b-dcaf499b60c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=052c7e3b3309d4678b7d3794c51d284c 2x, https://si.imgix.net/a108133a/uploads/origins/9f01a25d-195e-471a-8e3b-dcaf499b60c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0aba249a647a32f8ebc50d4fe5c38333 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kihyahya/works/15", "thumbnail_src": "https://si.imgix.net/12cdc359/uploads/origins/8e907bc2-7b98-41b1-b8d6-0c6d6b4a363f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e84515ad7156f408ba569f02f6c54da", "thumbnail_srcset": "https://si.imgix.net/12cdc359/uploads/origins/8e907bc2-7b98-41b1-b8d6-0c6d6b4a363f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e84515ad7156f408ba569f02f6c54da, http