4806-bf16-707090f13f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a904ebeedcd9c37665e064824964e8d, https://si.imgix.net/02ecc76c/uploads/origins/fb84b3a1-9243-4806-bf16-707090f13f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20a46240d70fa5f833c95a5f32bd30d5 2x, https://si.imgix.net/02ecc76c/uploads/origins/fb84b3a1-9243-4806-bf16-707090f13f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a5a4d3bd2264d463d353c21bdb5826e 3x", "genre": "art", "nsfw": true, "body": "twitterで見たミラアルクとヴァネッサのイラストが非常に良かったのでリクエストさせていただきます。二人がふたなりの翼さんを搾精しているイラストをお願いします。\n表情ですが、ミラアルクとヴァネッサはtwitterに挙げられていたもののように少しニンマリとお願いします。翼さんは二人から与えられる快楽によってすっかり蕩けているようにお願いします。\n構図やプレイはお任せします。3人のうち誰か1人の顔が隠れてしまっても構いません。ただ、優に十数回は搾りだされているとわかるように、零れる白濁液の描写があると嬉しいです。\nよろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@MG_LyricalDenko/works/30", "thumbnail_src": "https://si.imgix.net/1b775912/uploads/origins/a91404f8-b5d7-4282-9c4d-abe7882e5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e33978954b7160868bfcb5c360c21b3", "thumbnail_srcset": "https://si.imgix.net/1b775912/uploads/origins/a91404f8-b5d7-4282-9c4d-abe7882e5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e33978954b7160868bfcb5c360c21b3, https://si.imgix.net/1b775912/uploads/origins/a91404f8-b5d7-4282-9c4d-abe7882e5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c25dde26f5a00b4d76104ae558420d2 2x, https://si.imgix.net/1b775912/uploads/origins/a91404f8-b5d7-4282-9c4d-abe7882e5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aed844afbd47a8602a91646f1983b92 3x", "genre": "art", "nsfw": true, "body": "キャラ:小日向未来(シンフォギア)\n\n内容:シェム様に乗っ取られた未来だが、響への愛(ヤバい)により逆にシェム様を支配し、シャムの能力を使い肉体を改造し響に性的な意味で食おうとしている未来さまのイラストをお願いします！(笑)\n\n服装:全裸\n\n詳細としましては、未来が怖すぎて腰を抜かした響の視点で、(響のイラストは描かなくて大丈夫です。)肉体を改造し身長も190cm、爆乳、長乳首(色はピンクでチンポ並みの強靭な化け物サイズ)、そして股間からタマ無しの凶悪なデカチ〇ポを生やし(根本の部分に女性器もちゃんとついている)、口、乳首、チ〇ポ、マ〇コからそれぞれ汁を垂れ流し、野獣のような表情で立っている。", "created_at": "", "completed_at": ""}, {"path": "/@MG_LyricalDenko/works/29", "thumbnail_src": "https://si.imgix.net/636ae113/uploads/origins/a9cc8c35-1d82-4772-90cd-55ec3d105dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7767346787c348e7f77259056364d8fd", "thumbnail_srcset": "https://si.imgix.net/636ae113/uploads/origins/a9cc8c35-1d82-4772-90cd-55ec3d105dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7767346787c348e7f77259056364d8fd, https://si.imgix.net/636ae113/uploads/origins/a9cc8c35-1d82-4772-90cd-55ec3d105dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e164e80a36518fbb5ca720a30e089a76 2x, https://si.imgix.net/636ae113/uploads/origins/a9cc8c35-1d82-4772-90cd-55ec3d105dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b32357bbb26209d16f4b80e3137682cd 3x", "genre": "art", "nsfw": true, "body": "こんばんは凹凸でんさん。\n\nケムリクサからりんとわかばで正常位のえっちをしているイラストをお願いします。\n2人とも全裸で気持ち良さそうな感じだと嬉しいです。\n\nよろしければで構いませんのでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@MG_LyricalDenko/works/28", "thumbnail_src": "https://si.imgix.net/ee90f109/uploads/origins/13ff786c-d0b7-491d-a933-a8668ca5791a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef35613859f7e6c7bc821bfdf7cdb316", "thumbnail_srcset": "https://si.imgix.net/ee90f109/uploads/origins/13ff786c-d0b7-491d-a933-a8668ca5791a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef35613859f7e6c7bc821bfdf7cdb316, https://si.imgix.net/ee90f109/uploads/origins/13ff786c-d0b7-491d-a933-a8668ca5791a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfde3f32cee77015a34bbd87607e3345 2x, https://si.imgix.net/ee90f109/uploads/origins/13ff786c-d0b7-491d-a933-a8668ca5791a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6e94a22878df583257cc5da804a1cca 3x", "genre": "art", "nsfw": true, "body": "はじめまして、ロリセレナと大人セレナのイラストをお願いします\n\n温泉卓球メモリアのセレナの続きというシチュで、リベンジしたいロリセレナが条件として最初からSEX前提、エロい女を連れてくる。と言われたので、大人セレナ(自称経験豊富)を連れて部屋に乗り込んでSEX勝負！→チンポには勝てなかったよ…というイラストをお願いします。\n\nまだ可能なら温泉卓球メモリアのイラストと同じ形式、ダメなら一枚絵で同人の温泉卓球メモリアのラストページみたいな構図で浴衣と台詞付でお願いします。\n\n2人は敗北が映える様、とにかく根拠もなく自信満々な感じで敗北後はイキっぱなしでガクガクしている感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@MG_LyricalDenko/works/27", "thumbnail_src": "https://si.imgix.net/732d1fe5/uploads/origins/e118a671-8da7-4248-bb26-50784cac40eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a049b4e4aaa5a2cda736362dcc8d7a93", "thumbnail_srcset": "https://si.imgix.net/732d1fe5/uploads/origins/e118a671-8da7-4248-bb26-50784cac40eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a049b4e4aaa5a2cda736362dcc8d7a93, https://si.imgix.net/732d1fe5/uploads/origins/e118a671-8da7-4248-bb26-50784cac40eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faeb36d811bf7f3438e01aedd39a32c0 2x, https://si.imgix.net/732d1fe5/uploads/origins/e118a671-8da7-4248-bb26-50784cac40eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7cfc041a205168817d1a95c9a7adfb9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MG_LyricalDenko/works/26", "thumbnail_src": "https://si.imgix.net/b7df445e/uploads/origins/3cf0ac74-8551-4d6a-95ef-1650f6b8f331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3ad731e89f06964fb2901e0c0c39a15", "thumbnail_srcset": "https://si.imgix.net/b7df445e/uploads/origins/3cf0ac74-8551-4d6a-95ef-1650f6b8f331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3ad731e89f06964fb2901e0c0c39a15, https://si.imgix.net/b7df445e/uploads/origins/3cf0ac74-8551-4d6a-95ef-1650f6b8f331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db5b0d868cdd8f4380b7abff8b32c850 2x, https://si.imgix.net/b7df445e/uploads/origins/3cf0ac74-8551-4d6a-95ef-1650f6b8f331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ee7b8539c3fd9b26d4d04c62dd7edb7 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n2枚のアートワークをお願いしたいと思います。何を描いても構いません。熱くてもいいし、セックスが絡んでいてもいいし、過激でもいいし、その他いろいろ...。\n唯一のリクエストは、小日向ミクさんが出てくることです。", "created_at": "", "completed_at": ""}]}