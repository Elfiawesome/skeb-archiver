oUQ04GT6GLaCxl", "created_at": "", "completed_at": ""}, {"path": "/@esuma22/works/9", "thumbnail_src": "https://si.imgix.net/a57d961c/uploads/origins/eb508472-385b-43e2-a4c6-96f9b0213850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a293769cdb6270aa533608e04e73e8", "thumbnail_srcset": "https://si.imgix.net/a57d961c/uploads/origins/eb508472-385b-43e2-a4c6-96f9b0213850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a293769cdb6270aa533608e04e73e8, https://si.imgix.net/a57d961c/uploads/origins/eb508472-385b-43e2-a4c6-96f9b0213850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd3963bd40b0520127b5a97415b1929 2x, https://si.imgix.net/a57d961c/uploads/origins/eb508472-385b-43e2-a4c6-96f9b0213850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be66e81ff572581efca6f12c4894abda 3x", "genre": "art", "nsfw": false, "body": "こんにちは、返事が遅くなってごめんなさい！\n彼女の参考文献はこちら：https://drive.google.com/drive/folders/1itrReBPo961cMLFCQjsvRkLDQzopBo-t?usp=drive_link\n\n他のOCもここにあるので、もし気が変わったら、好きな方を描いてください！\nその他、服装やポーズなども自由ですので、自由に変更してください！", "created_at": "", "completed_at": ""}, {"path": "/@esuma22/works/8", "thumbnail_src": "https://si.imgix.net/8017b4ec/uploads/origins/e4f09320-4a20-4057-bb4c-523524a29fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ece39d5f54bc5d4e449c5b4595e9d790", "thumbnail_srcset": "https://si.imgix.net/8017b4ec/uploads/origins/e4f09320-4a20-4057-bb4c-523524a29fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ece39d5f54bc5d4e449c5b4595e9d790, https://si.imgix.net/8017b4ec/uploads/origins/e4f09320-4a20-4057-bb4c-523524a29fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0ff20d21e7cfa46cfb874d15d83c7f6 2x, https://si.imgix.net/8017b4ec/uploads/origins/e4f09320-4a20-4057-bb4c-523524a29fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=656eaa