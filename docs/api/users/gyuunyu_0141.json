aranormal Crime」で使用したHO5探索者です。\n\n簡単なプロフィール\n30歳/男/178cm\n金髪青眼\n朗らか。愛想が良いというか基本的にそれなりの機嫌を保っている。家族も仲間も好き。\n\nお願いしたいシチュエーションなど\n屋台で好物のホットドッグを食べている/仕事の資料確認/記者会見対応  など\n描きやすいものを選んでいただければ嬉しいです！勿論他のシチュエーションでも構いません。服装も好きに変更して頂ければと思います。\n\nよろしくお願いします。\n何かありましたら再送/キャンセルして頂いて構いません。\n\nhttps://drive.google.com/drive/folders/1-l3bD3qNrzsVfr9mnJECE9quljmlk-uh", "created_at": "", "completed_at": ""}, {"path": "/@gyuunyu_0141/works/50", "thumbnail_src": "https://si.imgix.net/57a5d68a/uploads/origins/3f22339e-b75a-4772-aed5-905689a68f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe16342d7371828d4c5f66695fc501ec", "thumbnail_srcset": "https://si.imgix.net/57a5d68a/uploads/origins/3f22339e-b75a-4772-aed5-905689a68f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe16342d7371828d4c5f66695fc501ec, https://si.imgix.net/57a5d68a/uploads/origins/3f22339e-b75a-4772-aed5-905689a68f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e54f8f7f165c92e73aedc7b0e722650 2x, https://si.imgix.net/57a5d68a/uploads/origins/3f22339e-b75a-4772-aed5-905689a68f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be024e30c82ec83e4f4d7caf0f76755c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gyuunyu_0141/works/49", "thumbnail_src": "https://si.imgix.net/3e680aa0/uploads/origins/ee1ed81b-d3b0-4326-8608-7787b5911bc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&