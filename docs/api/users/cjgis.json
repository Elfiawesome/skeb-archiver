08-82e1-1759e190bc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1db58b0d15fd015c919371d810d4e86", "thumbnail_srcset": "https://si.imgix.net/5cf5aa43/uploads/origins/4f389f60-e280-4008-82e1-1759e190bc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1db58b0d15fd015c919371d810d4e86, https://si.imgix.net/5cf5aa43/uploads/origins/4f389f60-e280-4008-82e1-1759e190bc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1dba598ddee3f0f2ab6e0815b773ad1 2x, https://si.imgix.net/5cf5aa43/uploads/origins/4f389f60-e280-4008-82e1-1759e190bc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4735ff725fa6595d82d803ce15572723 3x", "genre": "art", "nsfw": true, "body": "shuu様、はじめまして。  \n君の素晴らしい絵を見て、連絡を取りたくなりました：  \nhttps://www.pixiv.net/artworks/139445731\n\nぺぺろちゃんとぽこちゃんが指を絡ませて情熱的にキスをしている絵を描いていただけませんか？  \nぽこちゃんの体には噛み跡やキスマークを含めてください。  \n\n参考リンク:  \nhttps://cafe-masquerade.com/casts/006pepero-nekoda\nhttps://skeb.jp/@Honda_poko\nhttps://x.com/Honda_poko\n\n構図やその他の詳細は君の創造性にお任せしますので、楽しんでいただければと思います。  \n\nもしよろしければ、その絵をSNSで共有したいと思います。\nご検討ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@cjgis/works/8", "thumbnail_src": "https://si.imgix.net/38920a31/uploads/origins/7fd6db69-6f08-4707-869b-5c0f7d0b36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8fe600fab72175adbcb8a127eae7841", "thumbnail_srcset": "https://si.imgix.net/38920a31/uploads/origins/7fd6db69-6f08-4707-869b-5c0f7d0b36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8fe600fab72175adbcb8a127eae7841, https://si.imgix.net/38920a31/uploads/origins/7fd6db69-6f08-4707-869b-5c0f7d0b36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=218178efa746a80e6aa485c9d24282ee 2x, https://si.imgix.net/38920a31/uploads/origins/7fd6db69-6f08-4707-869b-5c0f7d0b36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33c3da4e432864a7ff5768ee637ba08b 3x", "genre": "art", "nsfw": true, "body": "明けましておめでとうございます。\n\nステラソラからの女魔王ちゃんとチトセが全裸で一緒に寝ているイラストを描いていただけますか？\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cjgis/works/7", "thumbnail_src": "https://si.imgix.net/63b44d3c/uploads/origins/aceab37a-c377-48ff-813e-67c1e662042d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756b7d013bb62f588ef9800f915db35a", "thumbnail_srcset": "https://si.imgix.net/63b44d3c/uploads/origins/aceab37a-c377-48ff-813e-67c1e662042d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756b7d013bb62f588ef9800f915db35a, https://si.imgix.net/63b44d3c/uploads/origins/aceab37a-c377-48ff-813e-67c1e662042d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40fca39702c984a4886f4172be9e63a0 2x, https://si.imgix.net/63b44d3c/uploads/origins/aceab37a-c377-48ff-813e-67c1e662042d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4af5ae1080866824f6c1a8a60d7184d3 3x", "genre": "art", "nsfw": true, "body": "リクエストを再開していただきありがとうございます。\nまたDOAXVVのイラストを依頼したいです。\nほのかがプールサイドでオーナーさんとセックスしているイラストを描いていただけませんか？　\n体位は立ちバックでください。\n\n差分：\nおっぱいが露わになります\nピストン運動が強まると、ほのかのおっぱいが揺れ始めます。\nオーナーさんが中に出して、絶頂の後ほのかは満足そうな表情を浮かべています。\n\n衣装の参考は以下のURLで\nhttps://www.famitsu.com/article/202501/31471\n\nもし金額が差分を含めても足りない場合は、アピールしてください。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cjgis/works/6", "thumbnail_src": "https://si.imgix.net/9d3fd01f/uploads/origins/7daeeb3e-b6fc-4ed1-a2dc-901c5abd4072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24b6d9bc6c4f770419d3d2872771b368", "thumbnail_srcset": "https://si.imgix.net/9d3fd01f/uploads/origins/7daeeb3e-b6fc-4ed1-a2dc-901c5abd4072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24b6d9bc6c4f770419d3d2872771b368, https://si.imgix.net/9d3fd01f/uploads/origins/7daeeb3e-b6fc-4ed1-a2dc-901c5abd4072?bg=%23fff&auto=fo