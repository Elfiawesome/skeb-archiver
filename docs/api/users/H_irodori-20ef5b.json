e%2Ccenter&txtsize=30&txt=PRIVATE&s=f370d7f62c60a1545cd3be038174d1ee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@H_irodori/works/4", "thumbnail_src": "https://si.imgix.net/8fae1ad7/uploads/origins/7e4ecd62-3fe3-479d-a0ef-19fe2e64815e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c308fed2d6c486c2c45a7bc6901ec0b", "thumbnail_srcset": "https://si.imgix.net/8fae1ad7/uploads/origins/7e4ecd62-3fe3-479d-a0ef-19fe2e64815e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c308fed2d6c486c2c45a7bc6901ec0b, https://si.imgix.net/8fae1ad7/uploads/origins/7e4ecd62-3fe3-479d-a0ef-19fe2e64815e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bd5cb1325149c530bc4be3fbfd3276c 2x, https://si.imgix.net/8fae1ad7/uploads/origins/7e4ecd62-3fe3-479d-a0ef-19fe2e64815e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fb380ef73175185df64eb05d656c859 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@H_irodori/works/3", "thumbnail_src": "https://si.imgix.net/afa4c35a/uploads/origins/081b354d-2d64-4a8e-a853-90a329a04c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86aed97f22fa4a1b895d1e42140b6a70", "thumbnail_srcset": "https://si.imgix.net/afa4c35a/uploads/origins/081b354d-2d64-4a8e-a853-90a329a04c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86aed97f22fa4a1b895d1e42140b6a70, https://si.imgix.net/afa4c35a/uploads/origins/081b354d-2d64-4a8e-a853-90a329a04c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=338b49cf624ca54a8aac468ab0ede0b7 2x, https://si.imgix.net/afa4c35a/uploads/origins/081b354d-2d64-4a8e-a853-90a329a04c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54de3e6a3ed7a63d341b63fcc7933232 3x", "genre": "art", "nsfw": true, "body": "はじめまして、いつもイロドリ先生の作品に癒しをいただいています。\n先生の作品は絵の肉感や艶っぽさ、息づかいを感じる表情が魅力的なのはもちろん、更に女の子の魂を感じるといいますか、細部の女の子に対する解像度がとっても高くて、常にときめいています。（特に青い苺の千苺花ちゃんが肌を気にするが故にタートルネックを着ているところなど本当に）大好きです。\n\n前置きが長くなってしまい申し訳ありません。私は個人バーチャルYouTuberのトォルと申します。\nバ美肉をしたらイロドリ先生に描いていただくのが夢だったため、もし宜しければ私、トォルを描いて頂けないでしょうか。\n参考画像は下記の通りです。\n\n（画像）\nhttps://twitter.com/tor106tor/status/1375105251020169216?s=21\n（動画）\nhttps://www.youtube.com/channel/UCqOPA9ZQ7uB4OXmCw1jTAPQ\n\n\nポーズや表情はおまかせいたしますが、足を強調する構図であると更に嬉しいです。お胸は先生の「君だけに光る」に登場するひかるちゃんくらいのサイズ感です。\nまた帽子の有無や衣装のはだけ具合、エロの度合いについてもおまかせいたします。（青少年も見れるようなイラストも、えっちなイラストも、どちらも見たく自分では選べなかったのでお任せしたいです…）\n\nまた、描いていただいたイラストをもし配信のサムネイル等に利用することが可能であれば、宛名の横に☆（星のマーク）を描いていただければ幸いです。不可であれば必ず個人鑑賞として利用しますので、お手数おかけしてしまい恐縮ですが判別できるよう印だけご対応いただきたく存じます。\n\n最後になりましたが、イロドリ先生の活動を今後も陰ながら応援しております。いつも素敵な作品を生み出してくださり感謝しかありません。単行本の販売も心から楽しみにしております。\nイロドリ先生がお元気で過ごされますようお祈り申し上げます。\n\nhttps://twitter.com/tor106tor/status/1375105251020169216?s=21", "created_at": "", "completed_at": ""}, {"path": "/@H_irodori/works/2", "thumbnail_src": "https://si.imgix.net/0fb6ae3d/uploads/origins/cd8a6dd9-5425-47e0-9dc1-1f09da32dc6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13019628311ba646e7442a76898fc44", "thumbnail_srcset": "https://si.imgix.net/0fb6ae3d/uploads/origins/cd8a6dd9-5425-47e0-9dc1-1f09da32dc6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13019628311ba646e7442a76898fc44, https://si.imgix.net/0fb6ae3d/uploads/origins/cd8a6dd9-5425-47e0-9dc1-1f09da32dc6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7369822619e9d2f5faf620780368e28b 2x, https://si.imgix.net/0fb6