 https://si.imgix.net/94d96a72/uploads/origins/75825278-6c7d-480c-82d9-199f2cfbbf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=122ef2b29472f8a4ec5c32d2fb9129f6 2x, https://si.imgix.net/94d96a72/uploads/origins/75825278-6c7d-480c-82d9-199f2cfbbf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dce0a8797fbc17532f6c8beef9594fa0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@YMKW3641/works/8", "thumbnail_src": "https://si.imgix.net/5a9b47f0/uploads/origins/d7fd9c72-2fd7-4334-8b9f-80e9f4dda55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=846f43ed083dff1d12a000140cc4897f", "thumbnail_srcset": "https://si.imgix.net/5a9b47f0/uploads/origins/d7fd9c72-2fd7-4334-8b9f-80e9f4dda55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=846f43ed083dff1d12a000140cc4897f, https://si.imgix.net/5a9b47f0/uploads/origins/d7fd9c72-2fd7-4334-8b9f-80e9f4dda55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc1803d3c1d7c76091324829005a8f49 2x, https://si.imgix.net/5a9b47f0/uploads/origins/d7fd9c72-2fd7-4334-8b9f-80e9f4dda55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a773d396bafc9a7601c78e678a51aaf0 3x", "genre": "art", "nsfw": false, "body": "山川 様\n\nアピールありがとうございます、甕下 星辰と申します。\n作品、拝見致しました。流麗なタッチで日本画的な幽玄な美を纏い、且つ淡白には成り得ない滲み出る色気に圧倒されました。\n\n今回はご提案なされた通りに拙宅の篝 六連(カガリ ムツラ)のイラストをお願いしたく思います。\n\n（簡単な設定）\n・妖怪や神仏などを討伐、もしくは保護する職に就いている。\n・六つの光が宿る、星空の様な瞳をしている。（両目併せて十二個・『六連星の瞳』）\n・鈍い青色をした一升(イッショウ)・灰色の一斗(イット)という二挺拳銃使い。\n・近接戦にはナイフや日本刀も使用。\n・力強く華やかな美丈夫。長髪・睫毛が長いなど女性的とも思える要素はあるが、そちらに傾き過ぎているわけではない。（男性的な印象の方が強い）\n\n流麗な美しさと無骨過ぎない男性的な美を兼ね備えた様子で描いて頂けるとありがたく思います。\n\nまた可能でありましたら、Xなど他サイトにてSKEBでの依頼を明記・山川様のIDを記載の上で紹介させて頂きたく思います。\n\nよろしくお願い致します。\n\nhttps://www.pixiv.net/artworks/98791537", "created_at": "", "completed_at": ""}, {"path": "/@YMKW3641/works/7", "thumbnail_src": "https://si.imgix.net/accb8c81/uploads/origins/81fa1f67-3c58-420f-9f63-77c6f1251aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb9e2af467792d37f20a6b4c25b245df", "thumbnail_srcset": "https://si.imgix.net/accb8c81/uploads/origins/81fa1f67-3c58-420f-9f63-77c6f1251aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb9e2af467792d37f20a6b4c25b245df, https://si.imgix.net/accb8c81/uploads/origins/81fa1f67-3c58-420f-9f63-77c6f1251aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1918bb7eed560a8ff540ead6ee052407 2x, https://si.imgix.net/accb8c81/uploads/origins/81fa1f67-3c58-420f-9f63-77c6f1251aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e0aca292c2e9705849caee23441d798 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@YMKW3641/works/6", "thumbnail_src": "https://si.imgix.net/60dfe9c6/uploads/origins/238f025d-fda6-4d18-8a15-f18e999bb170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6c1247f7968680b5ff24b002c02d89", "thumbnail_srcset": "https://si.imgix.net/60dfe9c6/uploads/origins/238f025d-fda6-4d18-8a15-f18e999bb170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6c1247f7968680b5ff24b002c02d89, https://si.imgix.net/60dfe9c6/uploads/origins/238f025d-fda6-4d18-8a15-f18e999bb170?bg=%23fff&auto=format%2Ccompress&fm=we