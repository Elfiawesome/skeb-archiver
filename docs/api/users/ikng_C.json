の1枚をありがとうございました。\nまたお願いしたくリクエストを送ります。\nブルーリフレクション澪の羽成瑠夏のイラストをお願いします。\n資料：https://drive.google.com/drive/folders/1tbYeCWiy70dvCe699uRioCyQ-UP97BqV?usp=sharing\n衣装は紺色や青色を使った競泳水着を…早い話が瑠夏の変身姿をモチーフにしたデザインのものをお願いします。\n前回の見事な陽桜莉の変身風競泳水着をデザインして頂いた釘煮さんにしかお願いできません！\n変身資料：https://drive.google.com/drive/folders/1TGBABeZX2q4jGhSo1QNqphzeOcgNJ21Z?usp=sharing\n\n構図など基本的におまかせしますが、陽桜莉のイラストと並べたいのでそれを意識したイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ikng_C/works/77", "thumbnail_src": "https://si.imgix.net/70c0fb2f/uploads/origins/ba390799-c3f1-4a1f-a819-9216a2a37921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f99fd78b512029fda971e84237956ff", "thumbnail_srcset": "https://si.imgix.net/70c0fb2f/uploads/origins/ba390799-c3f1-4a1f-a819-9216a2a37921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f99fd78b512029fda971e84237956ff, https://si.imgix.net/70c0fb2f/uploads/origins/ba390799-c3f1-4a1f-a819-9216a2a37921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4a5bb6a5b016b0df046b2e7c884aa92 2x, https://si.imgix.net/70c0fb2f/uploads/origins/ba390799-c3f1-4a1f-a819-9216a2a37921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d30e2816883cfe15c66d25c6f61b404 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ikng_C/works/76", "thumbnail_src": "https://si.imgix.net/a35c6ca1/uploads/origins/9d76e3b5-6a0b-49b4-8f44-39716ae52afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44e9e241cf3e65579a9608f581d0054d", "thumbnail_srcs