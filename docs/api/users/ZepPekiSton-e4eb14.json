76-a7f6-98a7e5b7d397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47f7643df026854346b4d081f26e75ee 2x, https://si.imgix.net/d570512d/uploads/origins/d8f9e68b-de8e-4e76-a7f6-98a7e5b7d397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=521c1d289c8eee6dacc634e03d106a11 3x", "genre": "art", "nsfw": true, "body": "泥どねる様、初めまして。riguruと申します。\n今回の依頼なのですが、オスのネネルコちゃんを描いてほしいです。\n構図は下記のイラストのような主観視点でよろしくお願いします。\nhttps://www.dropbox.com/s/soly6k4a362kczp/skeb.png?dl=0\n差分を含めて合計で5枚描いてほしいのですが\n見知らぬオスのモブケモ相手に正常位で責めている感じでお願いします。\nネネルコちゃんに簡単な台詞も入れてもらえると幸いです。\n1枚目はゆっくりとピストン\n2枚目は高速でピストン\n3枚目は高速ピストンしながらイキそうになっている状態\n4枚目では性器が射精準備に入ってしまって止められないような状態\n5枚目で互いに射精している状態\n差分では主に表情と台詞を変えていただけると幸いです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ZepPekiSton/works/21", "thumbnail_src": "https://si.imgix.net/b87a3032/uploads/origins/7a980410-4804-4b13-8af4-80e31a378eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93e93fec4a53ff861732d3c43b030013", "thumbnail_srcset": "https://si.imgix.net/b87a3032/uploads/origins/7a980410-4804-4b13-8af4-80e31a378eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93e93fec4a53ff861732d3c43b030013, https://si.imgix.net/b87a3032/uploads/origins/7a980410-4804-4b13-8af4-80e31a378eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5901e6986c0d0a0714593041fbf90a6 2x, https://si.imgix.net/b87a3032/uploads/origins/7a980410-4804-4b13-8af4-80e31a378eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ed98774837a62d4c32b89ed07584b30 3x", "genre": "art", "nsfw": true, "body": "写真は、龍野の兄弟とアドニス、六花。それぞれの兄弟が四つんばいになってアドニスや六花とファックしています。横から見たので向かい合い、アドニスと六花はキスをしています。キスが途切れたり、表情が変わったりしているザーメンバージョンもあります。背景はベッドの上の彼らだけ。", "created_at": "", "completed_at": ""}, {"path": "/@ZepPekiSton/works/20", "thumbnail_src": "https://si.imgix.net/b9934d9e/uploads/origins/004d2986-ebd9-4fbd-988c-1642c8023a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2db61b8d85be161d470a583af79f0a", "thumbnail_srcset": "https://si.imgix.net/b9934d9e/uploads/origins/004d2986-ebd9-4fbd-988c-1642c8023a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2db61b8d85be161d470a583af79f0a, https://si.imgix.net/b9934d9e/uploads/origins/004d2986-ebd9-4fbd-988c-1642c8023a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7012e0a4ff33ccf6d800e3490b4f4fe8 2x, https://si.imgix.net/b9934d9e/uploads/origins/004d2986-ebd9-4fbd-988c-1642c8023a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19c72bfc108dcb23bf0c4f28d3741309 3x", "genre": "art", "nsfw": true, "body": "負ける度に脱ぐルールのゲームをしていて、罰ゲームで全裸で精液まみれにされているクライヴくんとケモショタをお願いします。ケモショタくんの見た目等はお任せします！二人とも勃起と射精をしていて、表情は恥ずかしそうな感じで、二人のちんちんが体のパーツ等で隠れず完全に見えているようなアングルでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ZepPekiSton/works/19", "thumbnail_src": "https://si.imgix.net/5338f2eb/uploads/origins/cd613ce2-f20a-4e06-b121-2a67263286b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc56f10ae085641e1ba69967a287e8de", "thumbnail_srcset": "https://si.imgix.net/5338f2eb/uploads/origins/cd613ce2-f20a-4e06-b121-2a67263286b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc56f10ae085641e1ba69967a287e8de, https://si.imgix.net/5338f2eb/uploads/origins/cd613ce2-f20a-4e06-b121-2a67263286b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc12df96696fa30999f42615a167ff22 2x, https://si.imgix.net/5338f2eb/uploads/origins/cd613ce2-f20a-4e06-b121-2a67263286b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c107ee4092a3ba5a5c4444740986975c 3x", "genre": "art", "nsfw": true, "body": "こんにちは、友人です。私はいつもあなたのキャラクターが好きで、私のゴブリンキャラクターがあなたのアートスタイルで見られることを望んでいました。\nAmereeは唯一の男性ゴブリンで、彼らが好きなものを身に着けています。他のゴブリンはそれぞれ女性で、彼とは違った方法で遊びます。ヴィクトリーヌは吸血鬼の一員で、彼の後ろから手のような足と長い舌を使っています。リトルパノマはグループの中で一番小さく、旅行が大好きです。彼女はオナホールやアナルビーズなど、さまざまなエキゾチックな玩具を彼に使います。  Tar-Tarはこのグループの中で一番タフな女性です。彼女のプレイ方法はシンプルで、ラフな交尾です。アマゾンの体位が一番いいと思います。もし、これらを変更したり、追加したりしたいのであれば、どうぞご自由にどうぞ。\n\nhttps://1drv.ms/u/s!AiPr7tfZO8qos2lN2AqqjBsAfm-V?e=EeqGKp", "created_at": "", "completed_at": ""}, {"path": "/@ZepPekiSton/works/18", "thumbnail_src": "https://si.imgix.net/351d1d54/uploads/origins/79d8c7eb-8429-4973-84e2-ca777d7bd77e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fa0aff8fe4844d9eea24e8ad8930c55", "thumbnail_srcset": "https://si.imgix.net/351d1d54/uploads/origins/79d8c7eb-8429-4973-84e2-ca777d7bd77e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fa0aff8fe4844d9eea24e8ad8930c55, https://si.imgix.net/351d1d54/uploads/origins/79d8c7eb-8429-4973-84e2-ca777d7bd77e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e493d95acd919904c2bf6e55fa0b9be2 2x, https://si.imgix.net/351d1d54/uploads/origins/79d8c7eb-8429-4973-84e2-ca777d7bd77e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d65373edf799bac5d5dbfb31caa65b3 3x", "genre": "art", "nsfw": true, "body": "こんにちは、いつもターニィちゃんたちの絵や漫画を楽しませて貰っています。泥さんにうちの比較的ロリ枠の「アセルテ＝キルテ」の絵をお願いしたく依頼させていただきました。\nこれと言ったシチュエーションは無いのですが、いわゆるメスガキっぽい感じの表情でポーズもそれらしいものでおまかせしてよろしいでしょうか？もし特に思いつかなければよくある口の前で手を広げて見下している感じの表情のアレでお願いします。\n衣装は資料内aselte準拠でお願いします、ただし足はaselte_summerの様なケモ足型でお願いいたします。\n\nそれともし良ければ全裸差分もお願いできますでしょうか？特にエロい追加要素無しで裸体版という感じでお願いします。\n玉ありふたなりでおちんちん部分は犬みたいな鞘に収まってるタイプの形状です。\nおっぱいはロリサイズですが、腕を上げてもはっきり女の子のおっぱいだな、とわかる位のサイズ感でお願いします。\n\n以上よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fAgHycRrBt3TgvIKOw1En_I2CtqLsxUo?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZepPekiSton/works/17", "thumbnail_src": "https://si.imgix.net/30b7c3f4/uploads/origins/82c03aee-b6a7-448c-bd08-5a31a90e71bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65ae28b2ceb1fb64aca521bc0593e9f", "thumbnail_srcset": "https://si.imgix.net/30b7c3f4/uploads/origins/82c03aee-b6a7-448c-bd08-5a31a90e71bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65ae28b2ceb1fb64aca521bc0593e9f, https://si.imgix.net/30b7c3f4/uploads/origins/82c03aee-b6a7-448c-bd08-5a31a90e71bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04cb873ecc20a5c21143da223872e378 2x, https://si.imgix.net/30b7c3f4/uploads/origins/82c03aee-b6a7-448c-bd08-5a31a90e71bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cfdd827ad508c0ea88818057599b902 3x", "genre": "art", "nsfw": true, "body": "写真はこのアングルでもこんな感じ https://cdn.discordapp.com/attachments/590637693248077824/964578609941581855/df36cw1-b2f90b59-e766-49b0-982c-ca6088c389fb.png\n登場人物は、ハクリ、レンジュ（ジェリクの弟）、名無しのキツネです。\nThis fox: https://cdn.discordapp.com/attachments/386527268945526794/387577118927618048/3b0128e04cc39fc41545e7951d1146a0.png\nhttps://cdn.discordapp.com/attachments/386527268945526794/387089832117272576/fox_boy.jpg\n真ん中が蓮寿です。キツネに吸われながら、ハクリに吸い付いている。ハクリとキツネのお尻、肛門も見えています。全員全裸で包茎チンコ、表情が違うザーメンバージョン、お互いの顔にザーメンをかけて口元からチンコを出します。お寺の中のような背景。", "created_at": "", "completed_at": ""}, {"path": "/@ZepPekiSton/works/16", "thumbnail_src": "https://si.imgix.net/4cbf271b/uploads/origins/61ed2fb4-1839-40b5-882b-db55009b115e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86092c22de9ef15c0786f503f0481605", "thumbnail_srcset": "https://si.imgix.net/4cbf271b/uploads/origins/61ed2fb4-1839-40b5-882b-db55009b115e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86092c22de9ef15c0786f503f0481605, https://si.imgix.net/4cbf271b/uploads/origins/61ed2fb4-1839-40b5-882b-db55009b115e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=390dd736773b1a50a7b4ac23e1df72e4 2x, https://si.imgix.net/4cbf271b/uploads/origins/61ed2fb4-1839-40b5-882b-db55009b115e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w