び髪\n　ライブ衣装(金髪)：【資料URL】右側\n\nまたこの金額で可能であれば、髪型は同じまま色を変更した下記差分をお願いします。\n　1.通常色：【資料URL】左側\n　2.超サイヤ人ゴッド超サイヤ人をイメージしたオリジナル色(配色はおまかせします)\n\nご検討よろしくお願いします。\n\nhttps://kizunaai.com/wp/wp-content/uploads/2020/06/%E3%83%95%E3%82%A3%E3%82%AE%E3%83%A5%E3%82%A2_%E5%91%8A%E7%9F%A50629-scaled.jpg", "created_at": "", "completed_at": ""}, {"path": "/@moonsidekanade/works/8", "thumbnail_src": "https://si.imgix.net/2f2dfb77/requests/143857_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b35beed1c98270229a6ad459b2e06f19", "thumbnail_srcset": "https://si.imgix.net/2f2dfb77/requests/143857_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b35beed1c98270229a6ad459b2e06f19, https://si.imgix.net/2f2dfb77/requests/143857_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d17cbf84413fa78be9cec3b0689cfdb 2x, https://si.imgix.net/2f2dfb77/requests/143857_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba7f99de719bf9c709a3ff1e08a8a540 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@moonsidekanade/works/7", "thumbnail_src": "https://si.imgix.net/35822f9e/requests/113058_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f352645193fd25a110b72cf4ef8c45ab", "thumbnail_srcset": "https://si.imgix.net/35822f9e/requests/113058_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc