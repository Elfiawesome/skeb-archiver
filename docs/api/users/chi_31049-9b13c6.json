x.net/aa47c045/uploads/origins/99cd9460-44b7-434a-b7fa-84af1c3a27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f86c5512f36b4b1f28a6b5b71541d966", "thumbnail_srcset": "https://si.imgix.net/aa47c045/uploads/origins/99cd9460-44b7-434a-b7fa-84af1c3a27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f86c5512f36b4b1f28a6b5b71541d966, https://si.imgix.net/aa47c045/uploads/origins/99cd9460-44b7-434a-b7fa-84af1c3a27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9e8cb761e6ab748d8bd2a93b35eb557 2x, https://si.imgix.net/aa47c045/uploads/origins/99cd9460-44b7-434a-b7fa-84af1c3a27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b4cf6b25d851c3f81b0cba30f2d5aa0 3x", "genre": "art", "nsfw": false, "body": "川島瑞樹と高垣楓の二名がダンスを踊っているシーンをお願いします。\n衣装は［レディ・ウィズダム］川島瑞樹と［暁のシュヴァリエ］高垣楓でお願いします。\nイメージは「煌びやかな舞踏会」の中でお願いします。\n構図、背景などはご自由に描いていただいて結構です（背景モブなどもご自由で大丈夫です、二人だけ踊っているのでも問題ないです）\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/15", "thumbnail_src": "https://si.imgix.net/96e8644f/uploads/origins/84f9846a-5927-4cda-b06f-7e345e6797c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c02aa61889efc2ecdbca021c3615a91", "thumbnail_srcset": "https://si.imgix.net/96e8644f/uploads/origins/84f9846a-5927-4cda-b06f-7e345e6797c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c02aa61889efc2ecdbca021c3615a91, https://si.imgix.net/96e8644f/uploads/origins/84f9846a-5927-4cda-b06f-7e345e6797c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c02a017f45b2c8a20f300f86a8a11748 2x, https://si.imgix.net/96e8644f/uploads/origins/84f9846a-5927-4cda-b06f-7e345e6797c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f64cd74f478c4182aaaa5d38a275b93 3x", "genre": "art", "nsfw": false, "body": "アニバーサリーLIVEのフィナーレで、全員で繋いだ手を上げてファンからの大歓声に応えるブルーナポレオン（川島瑞樹　松本沙理奈　荒木比奈　上条春菜　佐々木千枝）をお願いします。\n各自の表情や並びの順番はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/14", "thumbnail_src": "https://si.imgix.net/a1e281dd/uploads/origins/3d3bfd04-f7a4-4405-ad90-346b902e166c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea1855a8901756085839a7ff880d094", "thumbnail_srcset": "https://si.imgix.net/a1e281dd/uploads/origins/3d3bfd04-f7a4-4405-ad90-346b902e166c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea1855a8901756085839a7ff880d094, https://si.imgix.net/a1e281dd/uploads/origins/3d3bfd04-f7a4-4405-ad90-346b902e166c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=712b694205ebe312e7d914bda751ac9e 2x, https://si.imgix.net/a1e281dd/uploads/origins/3d3bfd04-f7a4-4405-ad90-346b902e166c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02b20361e2845dbf90b46ef0c636aabf 3x", "genre": "art", "nsfw": false, "body": "初リクエスト送らせていただきます。野坂さんが描くイラストが好きで、ぜひアイドルマスターシンデレラガールズの『水野翠』を描いて頂きたくリクエストを送ります。ブルナポのメンバーとはあまり縁のない(強いて言うなら温泉アイプロで川島さんと共にしたことがあるくらい)アイドルで、恐縮ですがご検討のほどよろしくお願いします。構図などはおまかせいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/13", "thumbnail_src": "https://si.imgix.net/05fb1d86/uploads/origins/d8a944f7-222d-4e23-bb47-a4e9b5a8f7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0e02382f992f986865a418226684af3", "thumbnail_srcset": "https://si.imgix.net/05fb1d86/uploads/origins/d8a944f7-222d-4e23-bb47-a4e9b5a8f7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0e02382f992f986865a418226684af3, https://si.imgix.net/05fb1d86/uploads/origins/d8a944f7-222d-4e23-bb47-a4e9b5a8f7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f906650829af907136154700477d583 2x, https://si.imgix.net/05fb1d86/uploads/origins/d8a944f7-222d-4e23-bb47-a4e9b5a8f7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=909ee700d16e502eec76a07e9a8e5a8f 3x", "genre": "art", "nsfw": false, "body": "あなたのアートが好きです。このキャラクター（https://twitter.com/AuriviaRyuna/status/1579894156595691520）と私のキャラクター（https://drive.google.com/file/d/1Cri9l1boBaqva0YsZ6qMzV9mrkuBR2QC/view?usp=sharing）がこの衣装を着た写真（https://twitter.com/AuriviaRyuna/status/1579581036161536000）をお願いできますか？\n\n読んでくれてありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/12", "thumbnail_src": "https://si.imgix.net/4d62cb9d/uploads/origins/e49e4387-6a2a-4854-9624-29d5257ef9dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8632d1effbe23572637601940ba5d1dd", "thumbnail_srcset": "https://si.imgix.net/4d62cb9d/uploads/origins/e49e4387-6a2a-4854-9624-29d5257ef9dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8632d1effbe23572637601940ba5d1dd, https://si.imgix.net/4d62cb9d/uploads/origins/e49e4387-6a2a-4854-9624-29d5257ef9dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd15e527ecca4655950c567d3ce85cc8 2x, https://si.imgix.net/4d62cb9d/uploads/origins/e49e4387-6a2a-4854-9624-29d5257ef9dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56130df2a5247b6fa09872c5689cb65e 3x", "genre": "art", "nsfw": false, "body": "オーバーサイズのニットベストとベレー帽と眼鏡でお揃いコーデしてるさりひな（松本沙理奈と荒木比奈）をリクエストさせて頂きます。\nそれ以外のファッションは丸投げでも良いでしょうか？よろしければお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/11", "thumbnail_src": "https://si.imgix.net/a20304c3/uploads/origins/139aa87c-d585-4d2d-9996-67d0ca901daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e778048877e64e593f12f4e81231a85e", "thumbnail_srcset": "https://si.imgix.net/a20304c3/uploads/origins/139aa87c-d585-4d2d-9996-67d0ca901daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e778048877e64e593f12f4e81231a85e, https://si.imgix.net/a20304c3/uploads/origins/139aa87c-d585-4d2d-9996-67d0ca901daf?bg=%23fff&auto=format%