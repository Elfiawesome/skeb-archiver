cb8/uploads/origins/b466a115-f0bb-4e93-85e4-318b806120b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ffb57cbaba320ad6a1de3991c9ad95a", "thumbnail_srcset": "https://si.imgix.net/75053cb8/uploads/origins/b466a115-f0bb-4e93-85e4-318b806120b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ffb57cbaba320ad6a1de3991c9ad95a, https://si.imgix.net/75053cb8/uploads/origins/b466a115-f0bb-4e93-85e4-318b806120b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76fb7c69d2fc6d0f45f3ea4c42657b90 2x, https://si.imgix.net/75053cb8/uploads/origins/b466a115-f0bb-4e93-85e4-318b806120b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08fcd4993ee384e23214e31b21711b14 3x", "genre": "art", "nsfw": false, "body": "松本沙理奈さんからアイスをいただくライラさんをお願いします。\n服装等指定は特にございません。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/4", "thumbnail_src": "https://si.imgix.net/1d0de512/uploads/origins/a1cfc8d8-d22f-4976-b8b7-c5d0dd916d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca1fcff99f3db3a4d10d3acb140d3b85", "thumbnail_srcset": "https://si.imgix.net/1d0de512/uploads/origins/a1cfc8d8-d22f-4976-b8b7-c5d0dd916d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca1fcff99f3db3a4d10d3acb140d3b85, https://si.imgix.net/1d0de512/uploads/origins/a1cfc8d8-d22f-4976-b8b7-c5d0dd916d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fca16587abacbde07a6f95ccbf89e8ab 2x, https://si.imgix.net/1d0de512/uploads/origins/a1cfc8d8-d22f-4976-b8b7-c5d0dd916d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71d2f5178fad23d317bc1a993c196e17 3x", "genre": "art", "nsfw": false, "body": "以下の内容でお願いします。\n・男　大学生(19歳)\n・ガタイがいい、ショートポニテ、南国的な感じの服　クール目な顔\n・かしこくない(良い意味で)\n・ココアシガレットを吸って刑事ドラマみたいなポーズを取ってる", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/3", "thumbnail_src": "https://si.imgix.net/7e356ec4/uploads/origins/60e99a5b-a339-4bb3-86af-b1bb8a901fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d6a97fe9a9e23ab3782e2eb786470e7", "thumbnail_srcset": "https://si.imgix.net/7e356ec4/uploads/origins/60e99a5b-a339-4bb3-86af-b1bb8a901fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d6a97fe9a9e23ab3782e2eb786470e7, https://si.imgix.net/7e356ec4/uploads/origins/60e99a5b-a339-4bb3-86af-b1bb8a901fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3707957bd90755c3068a436fa535915 2x, https://si.imgix.net/7e356ec4/uploads/origins/60e99a5b-a339-4bb3-86af-b1bb8a901fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8d51e6f0d2df7448125c42985912632 3x", "genre": "art", "nsfw": false, "body": "いつもツイートや同人誌を楽しく拝見しています。\nコミケ最終日終了後に、ビッグサイトのレストラン街のスタバでフラペチーノを飲みながら早速コミケの想い出を語り合う荒木比奈と鷺沢文香をお願いできますでしょうか。\n私のコミケ最終日終了後のいつもの過ごし方なのですが、全日程を無事終えて満足感と喪失感の綯い交ぜになった素敵な時間です。久しぶりに参加したコミケはとても楽しくて、文香と比奈にも味わわせてあげたいと思いました。\nよろしくご検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@chi_31049/works/2", "thumbnail_src": "https://si.imgix.net/a6b475c8/uploads/origins/dbe9909c-104f-4ae0-9cb7-81ae32c09538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add9c270a02229d62054cf25715a84d5", "thumbnail_srcset": "https://si.imgix.net/a6b475c8/uploads/origins/dbe9909c-104f-4ae0-9cb7-81ae32c09538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add9c270a02229d62054cf25715a84d5, https://si.imgix.net/a6b475c8/uploads/origins/dbe9909c-104f-4ae0-9cb7-81ae32c09538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b79f9866aa62c1e59cc9e8f5cd44affa 2x, https://si.imgix.net/a6b475c8/uploads/origins/dbe9909c-104f-4ae0-9cb7-81ae32c09538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed00e093db41a98d5125cf2949bed965 3x", "genre": "art", "nsfw": false, "body": "紺ブレザー系