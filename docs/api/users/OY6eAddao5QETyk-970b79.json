らである。\n武器として短剣を使うが、それはあくまで儀式や血抜きの道具に過ぎない。彼らの実際の戦い方は、自らの血から凝縮された様々なフォーメーションや武器が登場する。\n \n片足を上げ、観客にそっと微笑む姿を見てみたい。静かだが危険な雰囲気を醸し出してほしい！\n\nリクエストに応えていただき、ありがとうございました！\n\n参考： https://imgur.com/a/VgKtjBQ", "created_at": "", "completed_at": ""}, {"path": "/@OY6eAddao5QETyk/works/13", "thumbnail_src": "https://si.imgix.net/4c7904ec/uploads/origins/333f98ff-118c-49e7-ae90-39dcef34a01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48b5a7ff33eeb3219524e1b1b4ee77f4", "thumbnail_srcset": "https://si.imgix.net/4c7904ec/uploads/origins/333f98ff-118c-49e7-ae90-39dcef34a01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48b5a7ff33eeb3219524e1b1b4ee77f4, https://si.imgix.net/4c7904ec/uploads/origins/333f98ff-118c-49e7-ae90-39dcef34a01b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af6768ff475e1d38990a36709b8ec9ed 2x, https://si.imgix.net/4c7904ec/uploads/origins/333f98ff-118c-49e7-ae90-39dcef34a01b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fbadf3a3db13ec83b9b59d0d6f0fe9b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OY6eAddao5QETyk/works/12", "thumbnail_src": "https://si.imgix.net/44eba84c/uploads/origins/886ea083-3a9e-43a4-9741-97304943d169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e18051b3ce73731657f026cf741a028", "thumbnail_srcset": "https://si.imgix.net/44eba84c/uploads/origins/886ea083-3a9e-43a4-9741-97304943d169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e18051b3ce73731657f026cf