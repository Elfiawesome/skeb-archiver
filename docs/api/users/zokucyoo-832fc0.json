=61cdf3c94abcba5b4947c42ee42647ee 2x, https://si.imgix.net/6a6a57c6/uploads/origins/319f7336-a793-4188-8eda-909ab2516f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6560beb3abe3ce640dc7edc656e0a08 3x", "genre": "comic", "nsfw": true, "body": "以前描いていただいた、温泉でのケモモブ子さんたちのイラストのその後で、部屋に戻った後、モブ子さんの友人のお母さんが\n自分に代わって我が子に授乳してるモブ子さんを少し羨ましそうに見ているのに気づいた女の子が、代わりに自分が、と\nその母親の乳房の傷跡を吸ったり摘まんだりして、母親は少し戸惑いながらも微笑んで受け入れる、というものをお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@zokucyoo/works/22", "thumbnail_src": "https://si.imgix.net/f26dc046/uploads/origins/9ab83fea-1bfb-49fe-954c-8e28d1fe84be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e06dd9fd17282917f7ea270a149c828", "thumbnail_srcset": "https://si.imgix.net/f26dc046/uploads/origins/9ab83fea-1bfb-49fe-954c-8e28d1fe84be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e06dd9fd17282917f7ea270a149c828, https://si.imgix.net/f26dc046/uploads/origins/9ab83fea-1bfb-49fe-954c-8e28d1fe84be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b68abbee168946b79f5133e0bf028ae 2x, https://si.imgix.net/f26dc046/uploads/origins/9ab83fea-1bfb-49fe-954c-8e28d1fe84be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8340cfdfedcd6aeeaef32dc697ab4519 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zokucyoo/works/21", "thumbnail_src": "https://si.imgix.net/2bf76a42/uploads/origins/4af23289-0ac4-42cf-a818-6bd8b9036468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200