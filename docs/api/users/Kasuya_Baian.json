s/origins/8f690efa-36f0-456c-9688-3a6e40959945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e5b75b740d723d22bff2d66024ed0f9", "thumbnail_srcset": "https://si.imgix.net/8ac26500/uploads/origins/8f690efa-36f0-456c-9688-3a6e40959945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e5b75b740d723d22bff2d66024ed0f9, https://si.imgix.net/8ac26500/uploads/origins/8f690efa-36f0-456c-9688-3a6e40959945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bce91a8a0e08ce2463c8a51d94e639d6 2x, https://si.imgix.net/8ac26500/uploads/origins/8f690efa-36f0-456c-9688-3a6e40959945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e79ef10cdc5fd553fbfecc1a87a906b6 3x", "genre": "art", "nsfw": false, "body": "Hello, I love your art style!\nI’d love my OC tomboy drawn with my blue 1988 Suzuki Samurai (open top, no soft cover) and the ship cruise ship Queen Mary in the background!\nI trust your expertise for angle and pose, she could be sitting on the hood, trunk, or leaning, whatever you think looks best.\nIf possible, I’d love to use it for a t-shirt, if possible having the girl and car as separate layers/files would be amazing.\n\nhttps://drive.google.co m/drive/folders/1pyGIRBcbna1pUuKau-HQpd6pdvXmvg-T?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/303", "thumbnail_src": "https://si.imgix.net/efa50fb4/uploads/origins/ef041188-4845-49eb-9106-183f4d2310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce152e5b14f2a56f341158b453dfc284", "thumbnail_srcset": "https://si.imgix.net/efa50fb4/uploads/origins/ef041188-4845-49eb-9106-183f4d2310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce152e5b14f2a56f341158b453dfc284, https://si.imgix.net/efa50fb4/uploads/origins/ef041188-4845-49eb-9106-183f4d2310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b234b622b87df67fe0d833631b6ce99 2x, https://si.imgix.net/efa50fb4/uploads/origins/ef041188-4845-49eb-9106-183f4d2310ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0181fe5fac05b63056ac201d75f52306 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n絵の依頼をしたいのですが。\n黒い眼鏡をかけていて、目は黒く、唇の左隅にほくろがあり、睡眠不足のため目の下に大きなクマがあります。胸はぺったんこ。耳は大きく、尻尾もある。銃とお酒とチーズとネズミが好き。黒いシャツには \"brat \"の文字。ジャケットはオーバーサイズ。\n\nVtuber ref : https://drive.google.com/drive/folders/1poSraUedyg2YUibGOBY1H7k2UmFSz4B8?usp=drive_link\n\nHONDA PRELUDE 3rd GEN 1990 バルバドスイエローで描いてくれませんか？\n\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1poSraUedyg2YUibGOBY1H7k2UmFSz4B8?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/302", "thumbnail_src": "https://si.imgix.net/5a53788e/uploads/origins/301d7ae7-e4f5-4532-ae1b-f5600419d9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61243822f059f45210342365e61e98cf", "thumbnail_srcset": "https://si.imgix.net/5a53788e/uploads/origins/301d7ae7-e4f5-4532-ae1b-f5600419d9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61243822f059f45210342365e61e98cf, https://si.imgix.net/5a53788e/uploads/origins/301d7ae7-e4f5-4532-ae1b-f5600419d9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0465332ed12381444474923a986573fb 2x, https://si.imgix.net/5a53788e/uploads/origins/301d7ae7-e4f5-4532-ae1b-f5600419d9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38eaf7eca923bf2c06863f12deccb57b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/301", "thumbnail_src": "https://si.imgix.net/807c1fe5/uploads/origins/5e4b058b-f256-4c23-b057-3dcd80225cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6c2b66bcab6d175a00ef2a613c73da1", "thumbnail_srcset": "https://si.imgix.net/807c1fe5/uploads/origins/5e4b058b-f256-4c23-b057-3dcd80225cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6c2b66bcab6d175a00ef2a613c73da1, https://si.imgix.net/807c1fe5/uploads/origins/5e4b058b-f256-4c23-b057-3dcd80225cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97347488533e3dd84ed487aa049fe0c0 2x, https://si.imgix.net/807c1fe5/uploads/origins/5e4b058b-f256-4c23-b057-3dcd80225cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee5b47c4e771b5e36320109dba486a72 3x", "genre": "art", "nsfw": false, "body": "はじめまして、いつも楽しくイラスト見させていただいております！\nデロリアン DMC-12で雪道を走る上白沢慧音を描いていただきたいです。天候は晴れ、時間帯は昼でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/300", "thumbnail_src": "https://si.imgix.net/6950f111/uploads/origins/e5aab447-207f-481f-835e-410403b32ce7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a5a00a3894ab164a435e80d8173103", "thumbnail_srcset": "https://si.imgix.net/6950f111/uploads/origins/e5aab447-207f-481f-835e-410403b32ce7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a5a00a3894ab164a435e80d8173103, https://si.imgix.net/6950f111/uploads/origins/e5aab447-207f-481f-835e-410403b32ce7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a6a54d5706669ebdc9956b071ae91a0 2x, https://si.imgix.net/6950f111/uploads/origins/e5aab447-207f-481f-835e-410403b32ce7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=474416f9c0cb79819e8a2170932dbf51 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お元気ですか？\nお願いなのですが、食べ物がいっぱいのテーブルと一緒にナズーリンを描いていただけませんか？\nよろしくお願いします！\n\n\nHello! I hope you are doing well!\nFor my request, would you be able to draw Nazrin with a table full of food?\nThank you!", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/299", "thumbnail_src": "https://si.imgix.net/c258b765/uploads/origins/7090a873-5adf-4aa4-97a2-365b8f3c0961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae11c7ee6c6eff0de8e5b0af4b310f7", "thumbnail_srcset": "https://si.imgix.net/c258b765/uploads/origins/7090a873-5adf-4aa4-97a2-365b8f3c0961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae11c7ee6c6eff0de8e5b0af4b310f7, https://si.imgix.net/c258b765/uploads/origins/7090a873-5adf-4aa4-97a2-365b8f3c0961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0684f9a0ff9a1c2120ced012d4906f55 2x, https://si.imgix.net/c258b765/uploads/origins/7090a873-5adf-4aa4-97a2-365b8f3c0961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=759182741b77c2d2dabdf2457d7e6d2c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はギャラリーからこの写真を見つけた、それは自分自身を作成した長い時間前からあった。この写真の改良を手伝ってください！加えて、私は写真に姉を追加したいです！\n\n参考\n元の写真：https://drive.google.com/file/d/1ToR8e5GsKfPysc5M32vbGC2y0usat6Mj/view?usp=sharing\n\n朱和（赤毛、屋根の上に座っている？173cm）：https://drive.google.com/drive/folders/1mUccn-LIGAmL9AOdwcwyaJJMAsc7pw9V?usp=sharing\n\n卯河（ロゼ金髪、原画は165cm）：https://drive.google.com/drive/folders/1Sk0Adez58vvdvXmJ-Fd92xUdUwBrv42c?usp=sharing\n\nポラリス・ライティングエール2044 フェイスリフト：https://drive.google.com/drive/folders/1BVbMaf_amYmIQlhPSpYF8wm11x5coTKV?usp=sharing\n\n世界：\nhttps://drive.google.com/drive/folders/1y6PQKzTEKJHsS-7oULZgDV6YCfXcWubp?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/298", "thumbnail_src": "https://si.imgix.net/70d47943/uploads/origins/e229943f-3a36-4590-93f4-61514ba03a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a676fddd9cf8c15486a052cb56add69", "thumbnail_srcset": "https://si.imgix.net/70d47943/uploads/origins/e229943f-3a36-4590-93f4-61514ba03a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a676fddd9cf8c15486a052cb56add69, https://si.imgix.net/70d47943/uploads/origins/e229943f-3a36-4590-93f4-61514ba03a80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a06b778d0922e7e35145ede2e8238353 2x, https://si.imgix.net/70d47943/uploads/origins/e229943f-3a36-4590-93f4-61514ba03a80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=622c4ce87d2ba10a02bf8d5957e2bb56 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\nあなたの絵と車の描き方がとても好きです。\n\n私のFFXIVのOCにスズキのジムニー、できればA6G415（1.5lエンジンのGJ）のキネティックイエローを描いてほしいです。\n私のOC、セレスは内気でおてんばなAuRaです。\n\nシナリオはキャンプシーンかオフロード全般で、セレスがジムニーの横に立っています。\n正確なポーズや背景などの調整はお任せします。\n\n私のOCの参考文献はこちら：https://drive.google.com/drive/folders/1NoyEozHg_-NlYDO4uEE5hLX8n_UgPot4?usp=sharing\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/297", "thumbnail_src": "https://si.imgix.net/6a4dc26b/uploads/origins/865c819b-e2fb-41d1-b86d-902a83deb6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09546bc8a43312410ead9c63bc5d3f96", "thumbnail_srcset": "https://si.imgix.net/6a4dc26b/uploads/origins/865c819b-e2fb-41d1-b86d-902a83deb6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09546bc8a43312410ead9c63bc5d3f96, https://si.imgix.net/6a4dc26b/uploads/origins/865c819b-e2fb-41d1-b86d-902a83deb6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72b43bf208eca5a1096433b6e0c07224 2x, https://si.imgix.net/6a4dc26b/uploads/origins/865c819b-e2fb-41d1-b86d-902a83deb6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7881e007a64f173871564c878935bda3 3x", "genre": "art", "nsfw": false, "body": "粕家梅庵さん、こんにちわ。ワンダーランドウォーズのミクサが広い屋外駐車場に斜め左向きに停めてあるクロストレックのフロントバンパー前に微笑んで右手振って立っていて左後輪前に不思議の国でアリスと のアリスが笑顔で立っているイラストをお願い出来ないでしょうか?  イメージは広い屋外駐車場の斜め左向きに停めてあるクロストレックのフロントバンパー前にミクサが微笑んで右手を振って立っていて左後輪前にアリスが笑顔で右手でピースをして立っているとゆう感じです(クロストレックの白ナンバーは[東京 160 あ 18-65]でお願いします)  ご検討お願いします\n\nーミクサの姿ー\nhttps://x.com/RSOE393_wlw/status/1812773352219754987?t=j4-YyiVkpvLeeyK6BrWy-w&s=19\nーアリスの姿ー\nhttps://share.google/images/O4A0wtPB2aIFUtpIt\nースバル クロストレックー\nhttps://share.google/images/AmoXkQRjlfnuRsZdG", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/296", "thumbnail_src": "https://si.imgix.net/6ea67348/uploads/origins/d4f4f6d9-d325-4e90-939a-d6115b188460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47e1e8a8b78ca141a4d507e3120a656e", "thumbnail_srcset": "https://si.imgix.net/6ea67348/uploads/origins/d4f4f6d9-d325-4e90-939a-d6115b188460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47e1e8a8b78ca141a4d507e3120a656e, https://si.imgix.net/6ea67348/uploads/origins/d4f4f6d9-d325-4e90-939a-d6115b188460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66ec81481e7e47dbbd3c7b7cb36fead8 2x, https://si.imgix.net/6ea67348/uploads/origins/d4f4f6d9-d325-4e90-939a-d6115b188460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0236413637e27819d4ae2b9f36deb640 3x", "genre": "art", "nsfw": false, "body": "初めまして。 \nVtuberでゲーム配信を中心に活動してます、雷々ヨウと申します。\n\n素敵な乗り物とキャラクターイラストに惹かれたので今回リクエストさせていただきました！！ \n♦キャラクター詳細➞ 参考画像のリンク先を記入してます。色やポーズはおまかせでお願いします。\n♦構図➞スーパーカブに乗ったイラストをお願いします。ヘルメットかゴーグルを付けていると嬉しいです。\n♦使用用途➞ XなどのSNSでの投稿、Twitch配信(収益化済)にて使用、可能であれば商用グッズなども行いたいです。\n\nご検討よろしくお願いします！！\n\nhttps://drive.google.com/drive/folders/1APGW0PxctLvUcnrezo5nhEnkMGZb2xQv", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/295", "thumbnail_src": "https://si.imgix.net/a406eb15/uploads/origins/5e7e08fe-bd14-4a91-8a7a-fcbcfc6568cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1c6ed0125777230d7d22b7d2a5774d", "thumbnail_srcset": "https://si.imgix.net/a406eb15/uploads/origins/5e7e08fe-bd14-4a91-8a7a-fcbcfc6568cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1c6ed0125777230d7d22b7d2a5774d, https://si.imgix.net/a406eb15/uploads/origins/5e7e08fe-bd14-4a91-8a7a-fcbcfc6568cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e15ee47df46f2cd59b70fb37bd03e2d 2x, https://si.imgix.net/a406eb15/uploads/origins/5e7e08fe-bd14-4a91-8a7a-fcbcfc6568cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0c736022bb200e8784e1ee8e22459a9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お元気ですか？彼女の乗り物アートが大好きで、僕のカスタムレーシングカーを描いてもらえないかと思っていたんだ。シューティングスター（白と黒のやつ）。アングルの参考としてもう一台の車も載せておきました。  背景は何でも構いません！\n\nhttps://drive.google.com/drive/folders/1Ntdu6trBhUiDQuliVtm8DqKKg4SyxgBc?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/294", "thumbnail_src": "https://si.imgix.net/6fc02a7b/uploads/origins/9e833651-0105-4b21-b9d6-8829220797d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f151d86c7d5b338790060ac3fe5371ef", "thumbnail_srcset": "https://si.imgix.net/6fc02a7b/uploads/origins/9e833651-0105-4b21-b9d6-8829220797d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f151d86c7d5b338790060ac3fe5371ef, https://si.imgix.net/6fc02a7b/uploads/origins/9e833651-0105-4b21-b9d6-8829220797d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b34a919e451f9632f302d34613f820d 2x, https://si.imgix.net/6fc02a7b/uploads/origins/9e833651-0105-4b21-b9d6-8829220797d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27403fedaf7a725e7384d52d47fa06f3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品を見つけ、車やキャラクターのある風景がとても気に入りました。\n\n可能であれば、あなたの作品をお願いしたいです。キャラクターはとてもユニークですが、私の依頼を考慮していただけると嬉しいです。\n\nキャラクター\nマイキャラ（CMM - スキムライブ） [提供された絵で、少し背が低く、ずんぐりした体型のキャラを描いてください].\nアヴェナ - ホルスタウルOL\nシャルネ - オークシスターOL\nブンフ - オークシスターメイド\n\n構図：アヴェナと私は外で、ヒュンダイのグランデールという車の後部座席の近くにいて、スケジュールを話し合っている。一方、バンプは開いた運転席側のドアの上で眠そうにあくびをしながら休んでいる。助手席側からは、姉のシャーンがボンネットにもたれかかって迷惑そうに、指をさして「もっとプロらしくしなさい」と説教している。車は午前中に参照したのと同じような住宅街沿いに駐車している。\n\n必要であれば再送してください。ご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1RpGfEPgn06AHJ6aG4rbNOe9c0ro0q9nk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/293", "thumbnail_src": "https://si.imgix.net/1227a90e/uploads/origins/2beb1cbb-db74-485b-a908-4ce30da8ae78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf9dacc207cad54417c9084077c486d6", "thumbnail_srcset": "https://si.imgix.net/1227a90e/uploads/origins/2beb1cbb-db74-485b-a908-4ce30da8ae78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf9dacc207cad54417c9084077c486d6, https://si.imgix.net/1227a90e/uploads/origins/2beb1cbb-db74-485b-a908-4ce30da8ae78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cf1944e1115e16413f07d46033f11f9 2x, https://si.imgix.net/1227a90e/uploads/origins/2beb1cbb-db74-485b-a908-4ce30da8ae78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60b155916a00a3b1554489031c5b2119 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n検索で乗り物のカッコ良いイラストをお見かけしぜひリクエストしたく、お送りさせていただいた次第です。\n\n私の擬人化として「PNDRちゃん」というキャラクター(OC)がいるのですが、そちらをお願いしたいです。\n参考資料\n・https://x.com/pengdrm/status/1429098249260986370\n・https://x.com/pengdrm/status/1351343296153489409\n\n【描いて頂きたい内容】\nモトコンパクトを運転して登校するPNDRちゃん\n\n【細かいシチュエーションなど】\n・衣装は資料通りの服装。\n・モトコンパクト→(https://global.honda/jp/design/award/2024motocompacto/) ボディカラーは白。\n・学校に遅刻しそうになってモトコンパクトにまたがり街角を疾走している。\n・表情は焦り気味で口に朝ご飯の食パンを咥えている。\n・遅刻しそうなので焦って立ち乗り気味(ステップに足は乗っているがおしりはシートから離れている)。\n・スクールバッグを背負っている。下記イメージ(https://shop-list.com/women/black-queen/bqjk012-00m10-170330/)のデザインをベースに、写真のように背中に背負っている感じで。\n・走っている街角はちょっと小洒落た商店街なイメージ。\n・モトコンパクトの車体にはシティポップなステッカーを複数枚貼っている。\n・背景とキャラはレイヤーで別れるようにしてください。\n\n\n注文の方非常に多くなってしまい申し訳ございませんが、何卒ご検討の方していただけますと幸甚です。\nどうぞよろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/292", "thumbnail_src": "https://si.imgix.net/65c0a5b7/uploads/origins/8cb959ea-f9cb-49db-b7a5-4628edfeed30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50e9587813d5e356e957cf4edd62b13e", "thumbnail_srcset": "https://si.imgix.net/65c0a5b7/uploads/origins/8cb959ea-f9cb-49db-b7a5-4628edfeed30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50e9587813d5e356e957cf4edd62b13e, https://si.imgix.net/65c0a5b7/uploads/origins/8cb959ea-f9cb-49db-b7a5-4628edfeed30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86426c96c86e6f0ce7f486495c5b7a7a 2x, https://si.imgix.net/65c0a5b7/uploads/origins/8cb959ea-f9cb-49db-b7a5-4628edfeed30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=233142c9e25a1fc0f3cbb528a210fbad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/291", "thumbnail_src": "https://si.imgix.net/9609f342/uploads/origins/6d21ec07-93d0-45d6-bafc-0f3e98f51455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d64f32e33214a4fd8a0db5eb58cbb2", "thumbnail_srcset": "https://si.imgix.net/9609f342/uploads/origins/6d21ec07-93d0-45d6-bafc-0f3e98f51455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d64f32e33214a4fd8a0db5eb58cbb2, https://si.imgix.net/9609f342/uploads/origins/6d21ec07-93d0-45d6-bafc-0f3e98f51455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71eab2e3a02e36647e3e2f4ba4d43d52 2x, https://si.imgix.net/9609f342/uploads/origins/6d21ec07-93d0-45d6-bafc-0f3e98f51455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cab627e05b6833f178b1943db2dc7bbd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVtuberキャラクター、マーゴが1995年のトヨタ・セリカに寄りかかっている姿をリクエストしたいです。色は何でもいいです。背景は山とか森があるところがいいです。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1R8h2Nn55xUEA7S3LAetSZ6hBlAb3dFp2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/290", "thumbnail_src": "https://si.imgix.net/3f3f6c75/uploads/origins/66165274-8eaf-4214-b28d-f132d203e31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e0971551a98e23f5b9ee94df93decbd", "thumbnail_srcset": "https://si.imgix.net/3f3f6c75/uploads/origins/66165274-8eaf-4214-b28d-f132d203e31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e0971551a98e23f5b9ee94df93decbd, https://si.imgix.net/3f3f6c75/uploads/origins/66165274-8eaf-4214-b28d-f132d203e31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24678663844f985a9b6fdd5f2b3521e2 2x, https://si.imgix.net/3f3f6c75/uploads/origins/66165274-8eaf-4214-b28d-f132d203e31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2348b6e0a1f3b9881d90fbc966c3ac95 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n夜明け時間、大黒PAで赤いキア·スティンガーマイスター(韓国のナンバで나204 0815)を駐車した後、ドアの横で缶コーヒーを飲む永夜抄の服装の鈴仙\n\n車の写真 : https://drive.google.com/drive/folders/1AVs9WKq-jF_6CixIqP9dAsPhzK_zUHih?usp=drive_link\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kasuya_Baian/works/289", "thumbnail_src": "https://si.imgix.net/7f2162b4/uploads/origins/2b042afc-b9b8-498d-a895-bcda4081e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9380c4df0010a9f37db64d4400c24f27", "thumbnail_srcset": "https://si.imgix.net/7f2162b4/uploads/origins/2b042afc-b9b8-498d-a895-bcda4081e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2