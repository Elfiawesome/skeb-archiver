ox.cc", "name": "howa4"}], "flags": {"from_archive": true}, "works": [{"path": "/@howa___4/works/1084", "thumbnail_src": "https://si.imgix.net/c193d2a0/uploads/origins/9746883b-bb21-408f-ba7a-bded59fb532c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a87cc1c9efc30f945e28a20820cfc7a", "thumbnail_srcset": "https://si.imgix.net/c193d2a0/uploads/origins/9746883b-bb21-408f-ba7a-bded59fb532c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a87cc1c9efc30f945e28a20820cfc7a, https://si.imgix.net/c193d2a0/uploads/origins/9746883b-bb21-408f-ba7a-bded59fb532c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ccc9ae12afdab09ca7f10a3996a57c4 2x, https://si.imgix.net/c193d2a0/uploads/origins/9746883b-bb21-408f-ba7a-bded59fb532c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3016c812d7d57d0f6ce0ba91482c17e 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！またあなたに絵を描いてほしいと思っていて、今回は良いアイデアがあると思うんです。モズミ「モズ」ピチが、背の高い黒肌の男性（巨根）にフェラチオをしている絵です。彼女は『Nikke』のメイド・マストのコスプレをしていてほしいです。バレンタインデーは過ぎましたが、彼女が体調を崩して大きなイベントを主催できなくなったので、彼女のためにテーマに沿った絵を描きたかったんです。 モズは愛情表現豊かな女の子なので、親密なシーンにしてください。ペニスにチョコレートが付着し、口から精液と共に胸へ垂れ流す様子が素敵だと思います。ペニスと睾丸全体に彼女のキスマークを散りばめ、可能であればフェラ中に自慰行為や睾丸愛撫の描写も加えてください。 モズは着色していただけると助かります。男性側は未着色でも構いませんので、その場合は料金を調整してください。背景は自由です。参考資料とポーズ案のリンクを添付しました。ボンデージ要素の追加も自由ですので、お好きなように作品をお作りください！リンクが機能しない場合はお知らせください。\n\nご検討いただきありがとうございます！https://imgur.com/a/mozzu-maid-mast-Cy2uT39", "created_at": "", "completed_at": ""}, {"path": "/@howa___4/works/1083", "thumbnail_src": "https://si.imgix.net/315664ea/uploads/origins/b70cc136-169d-42cd-b785-b10c17d01366?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00995008d580cfdcde4919446cbdabfe", "thumbnail_srcset": "https://si.imgix.net/315664ea/uploads/origins/b70cc136-169d-42cd-b785-b10c17d01366?bg=%23fff&auto=format%2Ccompre