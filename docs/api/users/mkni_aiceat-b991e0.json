%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a059401a09c7ea3aee6b296e2199a55a 2x, https://si.imgix.net/8400c084/uploads/origins/16e0607e-a3e8-4afe-a7e4-12a0a5b17bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23359d086491e33b6549efce2fb3cc4a 3x", "genre": "art", "nsfw": false, "body": "はじめまして!\n先生の作品は本当に素晴らしくて、私はとても気に入っているので!今回お願いしたいのは、 TRPGのオリジナルキャラクターのイラストです。\n佐師野戸留\n25歳 180ぐらい\n明るく活発な性格で、自己中心的で効率を重視する人。\n気楽そうで誰とでも話ができて、チャラチャラしたいい人のようにだが、実際は周囲から孤立していて、親しい友人もあまりいない\n彼は心強い公安警察です。しかし、彼もまた、過剰な殺人衝動を持っていた\n自分の基準で正義と正しさを裁き、罪人を殺すことに執着している。道徳観が弱く、自分の衝動を抑える意思がない。危険な奴。\n頭は良いが、非常に冒険的である。結果を顧みずに行動する傾向がある。\n服装や設定は下記リンクをご参照ください。\nhttps://drive.google.com/drive/folders/11F6ZyhLGqzMV8DuVr7V0p7OsaeYv48ij\nご自由にお任せ致します…!", "created_at": "", "completed_at": ""}, {"path": "/@mkni_aiceat/works/1", "thumbnail_src": "https://si.imgix.net/1445cf6d/uploads/origins/d4b5e475-4ab1-4637-90cc-cbae7b90e5bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2696f3b3437464ad350efbe63795fdc8", "thumbnail_srcset": "https://si.imgix.net/1445cf6d/uploads/origins/d4b5e475-4ab1-4637-90cc-cbae7b90e5bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2696f3b3437464ad350efbe63795fdc8, https://si.imgix.net/1445cf6d/uploads/origins/d4b5e475-4ab1-4637-90cc-cbae7b90e5bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81bfab7a2e319e128ea6791f29199f71 2x, https://si.imgix.net/1445cf6d/uploads/origins/d4b5e475-4ab1-4637-90cc-cbae7b90e5bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f30e0daaf78eac7f0f75a01a2b9179cb 3x", "genre": "art", "nsfw": false, "body": "はじめまして、先生の作品は超素晴らしいです！色や光、素敵な表情が本当に大好きです！私のOCの誕生日プレゼントにイラストを描いていただけないでしょうか？\nこの作風と同じように、彼に関する複数のグリッド（様々な表情や日常の風景など）を描いていただけると大変ありがたいです：\nhttps://twitter.com/mkni_aiceat/status/1471776023427829761\nhttps://twitter.com/mkni_aiceat/status/1697262989441970408\n他のパロも参考にしてください：\nhttps://drive.google.com/drive/