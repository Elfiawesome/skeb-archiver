c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee6243997d94525c010fb76958c113c", "thumbnail_srcset": "https://si.imgix.net/f1ba7940/uploads/origins/56dcc71c-f79f-48d1-8c1d-d64e23beac3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee6243997d94525c010fb76958c113c, https://si.imgix.net/f1ba7940/uploads/origins/56dcc71c-f79f-48d1-8c1d-d64e23beac3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5b77c4338b1e015d68ac94a4e5429b4 2x, https://si.imgix.net/f1ba7940/uploads/origins/56dcc71c-f79f-48d1-8c1d-d64e23beac3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c893d2aaa88ea4e70b22920e06a55fa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターを可愛いと言ってくれてありがとう。描いてくれたら本当に嬉しいです。イラストの描き方はお任せします。どんな作品になるかとても楽しみです。https://imgur.com/gallery/gwyn-ref-1-txCxYEi", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/404", "thumbnail_src": "https://si.imgix.net/9699410a/uploads/origins/eaa8e7eb-6416-412c-8025-4bd90be73c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0442c38a226af19de580fc8c87fc25", "thumbnail_srcset": "https://si.imgix.net/9699410a/uploads/origins/eaa8e7eb-6416-412c-8025-4bd90be73c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0442c38a226af19de580fc8c87fc25, https://si.imgix.net/9699410a/uploads/origins/eaa8e7eb-6416-412c-8025-4bd90be73c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a3d0b5b644ea80f30b5f0d12ee7ff5f 2x, https://si.imgix.net/9699410a/uploads/origins/eaa8e7eb-6416-412c-8025-4bd90be73c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c7341a57299c881ca7144419fe26a9e 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエスト失礼いたします。 \n\nイナズマイレブンのクィールが蒸れた裸足の両足裏を見せつけてくるイラストをお願いします。\n\n 下記URLの画像のキャラクターおよび服装でお願いします。\nhttps://drive.google.com/file/d/160KaMQHrmSwy_AZIrSGJqNodIAvH_tEx/view?usp=drive_link\n\n可能であれば白ソックス差分、黒タイツ差分をお願いいたします。\n\n下記URLはキャラクターの画像を集めたフォルダへのリンクとなります。\n\nhttps://drive.google.com/drive/folders/151lF6ahmszZWvbz41XazLYcf6YIipwlo?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/403", "thumbnail_src": "https://si.imgix.net/725b07f9/uploads/origins/0fce51d1-5829-4216-996e-46208f22febc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4c8e382c8efb034c5f2a6bd19314e4", "thumbnail_srcset": "https://si.imgix.net/725b07f9/uploads/origins/0fce51d1-5829-4216-996e-46208f22febc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4c8e382c8efb034c5f2a6bd19314e4, https://si.imgix.net/725b07f9/uploads/origins/0fce51d1-5829-4216-996e-46208f22febc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1540b0a05ec7bedd3e1063be08b8da2b 2x, https://si.imgix.net/725b07f9/uploads/origins/0fce51d1-5829-4216-996e-46208f22febc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60a874bf112c3889d0c28d93a925bfcd 3x", "genre": "art", "nsfw": false, "body": "初めましてさくらうめさん、\nアピール＆ドットを気に入って頂けてありがとうございます！\n頂いてから遅くなってしまい申し訳ありませんが、\nドットをリクエストさせてください！\n\n服装ですがアピール内容にあった\n魔法少女（茶色を基調とした、ワンピース風のアイドル衣装風）\nの恰好の全身立ち絵でお願いします。\n\nデザインに関して、資料ページにある腰のベルトとバックルさえ描いて頂ければ、\nお好きにデザインしていただいて構いません。\n\n使用用途としては主に\n・個人的に観賞\n・X等のSNSで宣伝\n・バースセイバーというゲームにて、立ち絵のバリエーションとして実装（検討レベル）\nになります。\n\nもちろんさくらうめさんが作成した事を明言しますので、ぜひご検討をお願いします。\n\nhttps://wiki3.jp/yoidukian_hind/page/6", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/402", "thumbnail_src": "https://si.imgix.net/c3b4a89d/uploads/origins/29662e95-6839-46f1-b958-0e7c59281ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2299baedf42fc62388bce4724258d3a1", "thumbnail_srcset": "https://si.imgix.net/c3b4a89d/uploads/origins/29662e95-6839-46f1-b958-0e7c59281ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2299baedf42fc62388bce4724258d3a1, https://si.imgix.net/c3b4a89d/uploads/origins/29662e95-6839-46f1-b958-0e7c59281ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06f0b07b003a8b9800f0c88012b2ce09 2x, https://si.imgix.net/c3b4a89d/uploads/origins/29662e95-6839-46f1-b958-0e7c59281ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd5028d8b3cb0f515d55ec870cf378f4 3x", "genre": "art", "nsfw": false, "body": "初めまして！アピールありがとうございます！\n\n「ギルティギアストライブ」の「エルフェルトヴァレンタイン」をお願いしたいです。ポーズと表情をおまかせしますけど、できれば表情はウインクを入れていただけると嬉しいです!\n\nこれは彼女のゲーム内ポートレート、グッズ、コンセプト アートからの参考資料です：\nhttps://drive.google.com/drive/folders/15UwydJXBQWM2RLA6HFIpa_YXUIuXLOjc?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/401", "thumbnail_src": "https://si.imgix.net/d60e17e5/uploads/origins/98b3a3b3-ae19-4b87-b326-9fb0687276dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08daab7dfaed358d55d2afc7f5f902b", "thumbnail_srcset": "https://si.imgix.net/d60e17e5/uploads/origins/98b3a3b3-ae19-4b87-b326-9fb0687276dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08daab7dfaed358d55d2afc7f5f902b, https://si.imgix.net/d60e17e5/uploads/origins/98b3a3b3-ae19-4b87-b326-9fb0687276dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d86ef253eff2bb081edf11f1adf1e33e 2x, https://si.imgix.net/d60e17e5/uploads/origins/98b3a3b3-ae19-4b87-b326-9fb0687276dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6f6eb97c570a6ac0cac514edc497b3 3x", "genre": "art", "nsfw": false, "body": "お久しぶりにリクエストさせていただきたいと思います。\n\n依頼内容ですが、バレンタインが近いので、シャボン玉の中に座りながら、こちらに向かって恥ずかしそうにハート型のバレンタインチョコを両手で差し出しているゆゆにゃんをお願いいたします。\n服装や背景は冬っぽい感じにしていただけると幸いです。\n\nゆゆにゃんは、シャボンで出来た猫耳と猫尻尾を持った黒髪ロングツインテールのJKです。\nシャボン玉や風船などのふわふわしたものが大好きな元気っ娘！という感じになります。\n詳しくは、資料URLやskebの送信リクエストを参考にしていただければ幸いです。\n\nあと、宛名については、ゆゆにゃんへ、とさん付けなしでお願いいたします。\n\nご検討の程よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/123502936", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/400", "thumbnail_src": "https://si.imgix.net/3d2b1392/uploads/origins/641813d7-c1a8-4393-b633-9f878a49fef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a3fa6fe86481b30e5f2eb3b3c52712f", "thumbnail_srcset": "https://si.imgix.net/3d2b1392/uploads/origins/641813d7-c1a8-4393-b633-9f878a49fef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a3fa6fe86481b30e5f2eb3b3c52712f, https://si.imgix.net/3d2b1392/uploads/origins/641813d7-c1a8-4393-b633-9f878a49fef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be24f25259f74b73c51b916f8f931d57 2x, https://si.imgix.net/3d2b1392/uploads/origins/641813d7-c1a8-4393-b633-9f878a49fef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef4a5d39cbe6a6883b917ef5f160f56f 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n先日は( https://skeb.jp/@sakuraumesan/works/391 )にて「スーパードール★リカちゃん」に登場する女悪魔「ミスティ」の着物姿を描いてくださりありがとうございました！\n\n今回はミスティ様が黒いウェディングドレスを着ているイラストをリクエストしたく思います。\n参考資料（黒いウェディングドレス姿）は本文末尾に記載となります。\n\n黒いウェディングドレス姿となったミスティ様が偽りの結婚式の幻覚を見せてこちらを誘うようなシチュエーションが希望となります。\n衣装や装飾品などについて適宜アレンジ頂いても問題ございません。\n\n差し支えなければ、全身が映る構図だと嬉しいです。\n内容的にはおそらく全年齢で問題無いかと思いますので、今回は全年齢としております。\n\nその他、特記の無い事項についてはお任せします（こちらがNGとする要素や表現は特にございません）。\n宜しければご検討をお願いします。\n\nhttps://imgur.com/6IRoexH.jpg", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/399", "thumbnail_src": "https://si.imgix.net/14d93b93/uploads/origins/972c93b2-258c-46f6-b9df-5f8f98e20422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94063bd8491ca3783cd9527e7c3cfcd5", "thumbnail_srcset": "https://si.imgix.net/14d93b93/uploads/origins/972c93b2-258c-46f6-b9df-5f8f98e20422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94063bd8491ca3783cd9527e7c3cfcd5, https://si.imgix.net/14d93b93/uploads/origins/972c93b2-258c-46f6-b9df-5f8f98e20422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3bb83310d233f797c6e4fc34fc5638c 2x, https://si.imgix.net/14d93b93/uploads/origins/972c93b2-258c-46f6-b9df-5f8f98e20422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38f81de47e5b6f3cf7c90253018c05f7 3x", "genre": "art", "nsfw": false, "body": "ご依頼ありがとうございます！私のオリジナルキャラクター（OC）を自由にアレンジしていただけると嬉しいです。創作の自由は完全に委ねます。キラキラしたひげはそのままに、女性的な胸は付けないでください。女性らしい曲線はOKです！\n\nポーズ・設定・衣装はご自身で選んでください！追加リファレンス・コミッション作品（職場閲覧可/不可は別フォルダ）、キャラクター情報はGoogleドライブでご確認ください：https://drive.google.com/drive/folders/1cn-Cli83XP2h5aoHZB86Q4_wjYNbaDYM", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/398", "thumbnail_src": "https://si.imgix.net/146f8003/uploads/origins/7df940d9-70d8-4d76-a732-2f9eecc3f8ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52c991d25e695473d26c984d0b4fd6da", "thumbnail_srcset": "https://si.imgix.net/146f8003/uploads/origins/7df940d9-70d8-4d76-a732-2f9eecc3f8ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52c991d25e695473d26c984d0b4fd6da, https://si.imgix.net/146f8003/uploads/origins/7df940d9-70d8-4d76-a732-2f9eecc3f8ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f75f0c8f217780ad1de88a7341eafad7 2x, https://si.imgix.net/146f8003/uploads/origins/7df940d9-70d8-4d76-a732-2f9eecc3f8ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bec6198d757bdd13136b8654421bc543 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/397", "thumbnail_src": "https://si.imgix.net/0e12420d/uploads/origins/aa69df21-fba1-4245-a4f9-f54313fea026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc9689e4f340b1bde916622af354caa5", "thumbnail_srcset": "https://si.imgix.net/0e12420d/uploads/origins/aa69df21-fba1-4245-a4f9-f54313fea026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc9689e4f340b1bde916622af354caa5, https://si.imgix.net/0e12420d/uploads/origins/aa69df21-fba1-4245-a4f9-f54313fea026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eac589e1065989a116b4cbfcf2a5f419 2x, https://si.imgix.net/0e12420d/uploads/origins/aa69df21-fba1-4245-a4f9-f54313fea026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccd81d471b26135b6e135b96de0911cd 3x", "genre": "art", "nsfw": false, "body": "またこんにちは！前回描いてくださったイラスト、本当に嬉しかったです、どうもありがとうございました！今度は私のオリジナルキャラクターをもう一人描いていただけませんか？彼女はカフェで働いていて、デザートやペイストリーを全て手作りしています。そして空き時間には物語を書くのが大好きなんです。お好きなように描いていただいて結構です、楽しみにしています。ありがとうございます！\n\n参考画像 - https://drive.google.com/file/d/1z708_e8GJ77SCo06Jjm-k737DOoXdBjC/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/396", "thumbnail_src": "https://si.imgix.net/1b43e951/uploads/origins/e7d15b16-2da1-4a1c-a9c0-2e1f6251214a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bd9625620154d8ab999f49274f86d1e", "thumbnail_srcset": "https://si.imgix.net/1b43e951/uploads/origins/e7d15b16-2da1-4a1c-a9c0-2e1f6251214a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bd9625620154d8ab999f49274f86d1e, https://si.imgix.net/1b43e951/uploads/origins/e7d15b16-2da1-4a1c-a9c0-2e1f6251214a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da79c910c0773947d83289a0d0dbbdd1 2x, https://si.imgix.net/1b43e951/uploads/origins/e7d15b16-2da1-4a1c-a9c0-2e1f6251214a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8ffd1f6f20a5acf769e9e5e6498e253 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたのこの作品で描かれた足の裏の表現がすごく好きです：https://skeb.jp/@sakuraumesan/works/182ゲーム／アニメ『シェンムー』のキャラクター「芳美」を、同じようなタッチで描いてほしいです。彼女は明るく働き者の女の子で、よく掃除をしています。服は着ている状態で、でも裸足で足の裏が見えるように描いてください。\n可能であれば、代わりに裸のバリエーションもお願いします。https://static.wikia.nocookie.net/shenmue/images/6/69/Xun2.png https://static.wikia.nocookie.net/shenmue/images/8/87/Shen2LDaYA-04.JPG\n\nhttps://static.wikia.nocookie.net/shenmue/images/1/13/FSm0EryagAEPSSr.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/395", "thumbnail_src": "https://si.imgix.net/0103cd03/uploads/origins/d79be439-c28a-4a7e-8a59-ad93d6c82c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cfe72271bfb6c91eee479ebe488fd50", "thumbnail_srcset": "https://si.imgix.net/0103cd03/uploads/origins/d79be439-c28a-4a7e-8a59-ad93d6c82c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cfe72271bfb6c91eee479ebe488fd50, https://si.imgix.net/0103cd03/uploads/origins/d79be439-c28a-4a7e-8a59-ad93d6c82c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7999170d6d73e2b6862ca8212c050871 2x, https://si.imgix.net/0103cd03/uploads/origins/d79be439-c28a-4a7e-8a59-ad93d6c82c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ba3f70afb3dd58efd7d91ed2ac0ba45 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/394", "thumbnail_src": "https://si.imgix.net/515cdba8/uploads/origins/4a615417-4476-49ac-ac0d-19dbddf6bf03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=900cfc88859f89a23740850c2b60a61e", "thumbnail_srcset": "https://si.imgix.net/515cdba8/uploads/origins/4a615417-4476-49ac-ac0d-19dbddf6bf03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=900cfc88859f89a23740850c2b60a61e, https://si.imgix.net/515cdba8/uploads/origins/4a615417-4476-49ac-ac0d-19dbddf6bf03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05aca864400ad0ae91b2674da0040179 2x, https://si.imgix.net/515cdba8/uploads/origins/4a615417-4476-49ac-ac0d-19dbddf6bf03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3eca2e82ec59d90aea1680d20f5724b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ご依頼ありがとうございます！フォローしているVTuberからあなたの作品を知りました。アデレードが魔法を唱える姿を描いていただけると嬉しいです。アデレードは自慢好きでかなり自信過剰な女の子ですが、よく圧倒されて慌てふためくこともあります。アデレードは火・水・地・雷・闇の属性の魔法を使えますので、お好きなものを選んでください。 ポーズや表情、細部の描写はご自由に決めてください。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1aZxORWdxRzS4_t7AHDgMze6_hIRmHqQ8?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/393", "thumbnail_src": "https://si.imgix.net/e1854846/uploads/origins/43b91533-aebe-44a9-a6c8-6d8644b10891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=062fb2691c497a6ceea55a6bae497127", "thumbnail_srcset": "https://si.imgix.net/e1854846/uploads/origins/43b91533-aebe-44a9-a6c8-6d8644b10891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=062fb2691c497a6ceea55a6bae497127, https://si.imgix.net/e1854846/uploads/origins/43b91533-aebe-44a9-a6c8-6d8644b10891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c39283df0aebe29192f120cabf4671a 2x, https://si.imgix.net/e1854846/uploads/origins/43b91533-aebe-44a9-a6c8-6d8644b10891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19bc5eced885070556abe13fde285ffd 3x", "genre": "art", "nsfw": false, "body": "さくらうめ様あけましておめでとうございます。\n昨年は大変素晴らしいイラストを描いて頂きありがとうございます。\n度々恐縮ですが、よろしければリクエストをお願いしたいです。\n\nFGOの男主人公の藤丸立香君（ぐだ男）(♂)とアルトリア・キャスター（術）（第２再臨）のイラストをリクエストしたく思います。\n立香の衣装は【魔術礼装･カルデア】を希望です。前回と同じになります。\n\nベッドで眠りながら幸せな夢を見ているアルトリアと、彼女がまた悪夢にうなされないよう傍らの椅子に座り寝ずの番をしている立香のワンシーンです。\n\nまた、よろしければ私がPixivにて投稿している二次創作小説の挿絵にさせて頂けると幸いです。\n対象作品のページについて、URLをご送付させていただきます。\n恐れ入りますが、ご作製ご検討の程、何卒宜しくお願い致します。\n\nhttps://www.pixiv.net/novel/show.php?id=18398507", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/392", "thumbnail_src": "https://si.imgix.net/735d169f/uploads/origins/5de1a2ba-31ca-42f7-a7fe-a9193fa97c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc613c023f5e62472e649fd4695deb5", "thumbnail_srcset": "https://si.imgix.net/735d169f/uploads/origins/5de1a2ba-31ca-42f7-a7fe-a9193fa97c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc613c023f5e62472e649fd4695deb5, https://si.imgix.net/735d169f/uploads/origins/5de1a2ba-31ca-42f7-a7fe-a9193fa97c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a8d96082153a6c994a3046f6c970263 2x, https://si.imgix.net/735d169f/uploads/origins/5de1a2ba-31ca-42f7-a7fe-a9193fa97c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4991dac6d6635126b84478ee73df48dd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ご応募ありがとうございます！メイヴをルピナスの花と一緒に描くというアイデア、素敵ですね。ルピナスの花は彼女の母親の愛を象徴しているので、彼女にとってとても大切なものです。https://imgur.com/a/Qat9ead この機会をいただき、誠にありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/391", "thumbnail_src": "https://si.imgix.net/6b52bea8/uploads/origins/5c920421-af4a-4e86-82fe-40f57914196a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ce6197c2072f60809b58fe26e85ed3e", "thumbnail_srcset": "https://si.imgix.net/6b52bea8/uploads/origins/5c920421-af4a-4e86-82fe-40f57914196a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ce6197c2072f60809b58fe26e85ed3e, https://si.imgix.net/6b52bea8/uploads/origins/5c920421-af4a-4e86-82fe-40f57914196a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdc57ed04a97b5b463e8e3eecaa2c4b4 2x, https://si.imgix.net/6b52bea8/uploads/origins/5c920421-af4a-4e86-82fe-40f57914196a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7be5655826785e00f5fe2e309d9da1ab 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\n前回描いて頂いた( https://skeb.jp/@sakuraumesan/works/366 )をはじめ、こちらこそいつも素敵なイラストを描いてくださり大変嬉しく思います。\n\n今回は「スーパードール★リカちゃん」に登場する女悪魔「ミスティ」の着物姿を描きたいとのこと、こちらからも是非お願いしたく思います。\nシチュエーションについてもご提案頂いた通り「目の色に映える真っ赤な彼岸花が咲き誇る花畑の中で、深い紫色の着物を纏ったミスティ様が、どこか妖しく微笑んでいる」シーンを是非お願いしたく思います。\n\n差し支えなければ、全身が映る構図が希望となります。\n内容的にはおそらく全年齢で問題無いかと思いますので、今回は全年齢としております。\nその他、特記の無い事項はお任せします（こちらがNGとする要素や表現は特にございません）。\n\nさくらうめ様が描かれるミスティ様の和装を心より楽しみにしております。\n以上宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sakuraumesan/works/390", "thumbnail_src": "https://si.imgix.net/54df6d79/uploads/origins/0228de99-88ac-4db6-b991-587517bff9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7614ad25347adc250eb7296a61627f4", "thumbnail_srcset": "https://si.imgix.net/54df6d79/uploads/origins/0228de99-88ac-4db6-b991-587517bff9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7614ad25347adc250eb7296a61627f4, https://si.imgix.net/54df6d79/uploads/origins/0228de99-88ac-4db6-b991-587517bff9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=957e27dc52dcd200e32e8a5e4be3241b 2x, https://si.imgix.net/54df6d79/uploads/origins/0228de99-88ac-4db6-b991-587517bff9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39a128717a0930450f54ee4914f2cd75 3x", "genre": "art", "nsfw": false, "body": "こんばんは、アピールありがとうございます。\n今年に入ってアピールが20件ほど来ていますが、ついお応えしたくなる内容でしたので選ばせていただきます。\n\nhttps://x.com/Skeb74863772/status/1450020619228106753　参照1\n\n冬コーデご希望とのことですのでそちらでお願いします。着こなしにもよりますがかなり着こまないと胸が大きい