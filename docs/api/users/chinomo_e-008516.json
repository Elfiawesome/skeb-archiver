f-79b8adcd9f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5772467d2ce28ff00620d751e5562f4a 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chinomo_e/works/1", "thumbnail_src": "https://si.imgix.net/bd4186b5/uploads/origins/413ab221-d789-4108-9618-ae301b090db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=761e52eebf1c80d52fc6d867d09d37b6", "thumbnail_srcset": "https://si.imgix.net/bd4186b5/uploads/origins/413ab221-d789-4108-9618-ae301b090db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=761e52eebf1c80d52fc6d867d09d37b6, https://si.imgix.net/bd4186b5/uploads/origins/413ab221-d789-4108-9618-ae301b090db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=659d2e68922cb6d487ad9020805ba9c2 2x, https://si.imgix.net/bd4186b5/uploads/origins/413ab221-d789-4108-9618-ae301b090db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be5aec393a4d20ae933f2fa666b36344 3x", "genre": "comic", "nsfw": false, "body": "ちのももの様、はじめまして。\npixivのイラストを拝見し、\n貴方の描かれる変顔イラストが\nツボにハマりまして、\nぜひ描いていただきたく\nリクエストさせていただきました。\n受けていただけると嬉しいです。\n\n変顔以外にも「白塗りフェチ」\n「羞恥シチュ」を\n含んだリクエストになります。\nもし不可でしたらキャンセルいただければ\n幸いです。\n\n・キャラクター\n\nパライバ・トルマリン\n\n・シチュエーション\n\n①舞妓変身体験で白塗りメイクを施される\n②メイク途中を見られて恥ずかしい思いをする\n\n・服装等\n\n浴衣や襦袢などを肩を出して着崩している\n(白粉がつかないよう)\n頭にはヘアバンドをして額を出している。\n(もし髪が肩につくようでしたらまとめ髪を\nお願い致します。)\n\n\n・以下詳細\n\n①座ってメイクを施されているパライバ\n\n目を瞑って白粉を板刷毛で塗られていく\n(胸元→顔)\n\nスポンジやパフで叩く\n→真っ白な顔に(眉毛やまつ毛も真っ白)\n\n刷毛で塗られている時かパフで叩かれて\nいる時に、ムラなく白くするために\n鼻の下を伸ばした変顔をお願い致します。\n(イメージがつきづらいと思いますので、\n資料をご参照ください)\n\n塗られている時は基本的に\n目を瞑っていますが、\n塗り終えた後に\n「すごい・・・真っ白」\nみたいに自分の白い顔にビックリする\n描写をお願いできますでしょうか。\n\n②メイク途中で誰か友達が入ってくる\n\n顔が真っ白＋肩をはだけた状態を恥ずかしがる\n「まだ途中だから見ないで〜」\nみたいな感じです。\n\n以上になります。\nキャラに関しては見た目だけで\n選びましたので、\n別の女性キャラに変更していただいても\n大丈夫です。\n\n書いていない部分のセリフや\nポーズ、構図等は全てお任せします。\n\nひとつだけこだわりとして、\n生え際や耳は白粉を塗らないようにだけ\nお願いできますでしょうか。\n\n最後に、参考動画のURLを\n載せますのでよかったら参照ください。\n\nhttps://youtu.be/wMLyvtnRjG4?si=Kx9BKYXRzWUxjXr3\n\n\nそれでは、よろしくご検討お願いします。\n\nhttps://www.dropbox.com/scl/fo/sz21csrlhvcce9qzhtiyz/AMeSXnV9hZNonpIgxmvT_Oc?rlkey=8opqmz0mgf9dka5x4d7knxts6&st=6ed435vr&dl=0", "created_at": "", "completed_at": ""}]}