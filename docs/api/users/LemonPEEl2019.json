a-9cdd34af994b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01367fc80134b588167803ce4c9fd2e, https://si.imgix.net/b11b541b/uploads/origins/21cf2a01-cab1-46ca-952a-9cdd34af994b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aeab8408924ab118a0e62a6310219033 2x, https://si.imgix.net/b11b541b/uploads/origins/21cf2a01-cab1-46ca-952a-9cdd34af994b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a22d306c04c44614cd9000bc29e16b49 3x", "genre": "art", "nsfw": false, "body": "こんにちは、これはNeryuuからの妖精キャラクターの立ち絵についてのリクエストです。 以下が私がキャラクターのデザインについて希望する詳細です：\n\n- 身体的には、15歳の少女のように見えます。彼女は若い妖精で、まだ魔法をうまく制御できません。\n\n- 彼女は人間の大きさで、よく見かけるような小さな妖精ではありません。\n\n- 彼女は緑色の髪をしており、先端に向かって黄色になっています。\n\n- 彼女の目は青いです。\n\n- 彼女の胸のサイズは小さいです。\n\n- 彼女はゲームの主人公のライバルを自称しており、主人公の宿敵のような性格をしています。しかし、彼女は若いので、少し間抜けなところもあります。\n\n- 彼女にどのような髪型にしたいか、羽のタイプ、靴下のタイプの参考写真をお送りします！（彼女は靴を履いていません）。彼女に合う服を考えてもらえますか、それとも参考写真も探したほうがよいでしょうか？\n\n以下は、彼女の髪型、私が望む羽のタイプ、および靴下のタイプの参考資料を含むGoogleドライブファイルへのリンクです！ https://drive.google.com/drive/folders/1bkdVD5TL2i8q_7PdxWXDIdExzSsZDUrv \n\n-髪型については、2人の女の子と一緒に写っている紫色の髪の女の子のようなものです。 \n\n-羽については、妖精と一緒に写っている羽のようなものです。 \n\n-靴下については、白と緑の服を着た小さな女の子のようなものです。靴下は白ではなく紫で、右足の靴下は左足の靴下よりも長くなります。参考画像の模様の代わりに、花柄になります。 \n\n私が思いつくのは以上です！どうもありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@LemonPEEl2019/works/2", "thumbnail_src": "https://si.imgix.net/b2f79cd6/uploads/origins/18e1702a-6f12-4bc6-ac60-6c87cad5fcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920332aacaf8534a7d9cd0e8438ad43e", "thumbnail_srcset": "https://si.imgix.net/b2f79cd6/uploads/origins/18e1702a-6f12-4bc6-ac60-6c87cad5fcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920332aacaf8534a7d9cd0e8438ad43e, https://si.imgix.net/b2f79cd6/uploads/origins/18e1702a-6f12-4bc6-ac60-6c87cad5fcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19c25992cd301e97ef2cadb5e2c95175 2x, https://si.imgix.net/b2f79cd6/uploads/origins/18e1702a-6f12-4bc6-ac60-6c87cad5fcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bb41dd444245f6f9b57d8c43699fb36 3x", "genre": "art", "nsfw": false, "body": "始めまして。リクエストさせていただきます。\n\nキャラクター:モンスター娘TD -【戯楽祭ドラゴンゾンビ娘】ディフォーラ\n\n作家さんが描いたニッドラのとてもかわいいイラストを見て、こうリクエストしてみました。\nドラゴン娘っていうの本当にいいと思いますが···\nもしかしてディフォーラも描いていただけますか？\n演奏中にウィンクして、投げキッスを飛ばす姿勢で描いてほしいです！\n\n\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@LemonPEEl2019/works/1", "thumbnail_src": "https://si.imgix.net/5f6bcd09/uploads/origins/8d984302-f2a5-428d-a472-adce1a0734b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63b2e0efb4b23f4df740b0b11d247236", "thumbnail_srcset": "https://si.imgix.net/5f6bcd09/uploads/origins/8d984302-f2a5-428d-a472-adce1a0734b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63b2e0efb4b23f4df740b0b11d247236, https://si.imgix.net/5f6bcd09/uploads/origins/8d984302-f2a5-428d-a472-adce1a0734b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89aac8f9168da7b9dc1a098464ff3129 2x, https://si.imgix.net/5f6bcd09/uploads/origins/8d984302-f2a5-428d-a472-adce1a0734b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4625660a2c0540e5b036d9ead799567 3x", "genre": "art", "nsfw": false, "body": "遊砲RUSHのキャラクターナナセ様をお願いします", "created_at": "", "completed_at": ""}]}