ze=30&txt=PRIVATE&s=f689729c060ae2a449cde43f42c49291 2x, https://si.imgix.net/e88c0ed1/uploads/origins/798a73d6-9ef9-4099-8e18-6db0dac8527d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62a27ee886885c9ec0237a5f34e64267 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/119", "thumbnail_src": "https://si.imgix.net/c9fbf09e/uploads/origins/2efcea96-2ddb-425f-9b6b-cd9ad866fe30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8d58aaf4bab8c5817eca25aafbe94e2", "thumbnail_srcset": "https://si.imgix.net/c9fbf09e/uploads/origins/2efcea96-2ddb-425f-9b6b-cd9ad866fe30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8d58aaf4bab8c5817eca25aafbe94e2, https://si.imgix.net/c9fbf09e/uploads/origins/2efcea96-2ddb-425f-9b6b-cd9ad866fe30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=085a5db17c9b0b3b14a647fba34fec18 2x, https://si.imgix.net/c9fbf09e/uploads/origins/2efcea96-2ddb-425f-9b6b-cd9ad866fe30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ea7476c8333f253907eb7e1b8ced3c0 3x", "genre": "art", "nsfw": false, "body": "Hello again,\nI would like to request more umas doing uma things. 7 umas this time; Haru Urara, El Condor Pasa, Nakayama Festa, Tokai Teio, Oguri Cap, Gold Ship and Daiwa Scarlet.\nThey are happily partying at karaoke. Haru Urara and Tokai Teio are singing together and if it is ok, they're drunk from drinking alcohol, otherwise just have them drinking juice. Nakayama Festa and Gold Ship are playing cards in the background. El Condor Pasa is happily and tightly hugging an embarassed Daiwa Scarlet. Oguri Cap is munching on food in the background.\nAs always, please make it look like a chaotic group of friends and feel free to make adjustments as you see fit.\nThank you very much in advance!\n\nUmas: https://photos.app.goo.gl/GBSgwP29ZdZTqZhDA", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/118", "thumbnail_src": "https://si.imgix.net/cfcc0b41/uploads/origins/b737f007-5832-4ab3-b404-511188c1d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e140920f499f77955ebbe52531a7280a", "thumbnail_srcset": "https://si.imgix.net/cfcc0b41/uploads/origins/b737f007-5832-4ab3-b404-511188c1d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e140920f499f77955ebbe52531a7280a, https://si.imgix.net/cfcc0b41/uploads/origins/b737f007-5832-4ab3-b404-511188c1d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=672bdd94747a952e78ea6683476a8451 2x, https://si.imgix.net/cfcc0b41/uploads/origins/b737f007-5832-4ab3-b404-511188c1d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95e070c56ddc6c527afbe08fb2d60305 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はマッチ3ゲームに取り組んでおり、報酬としてゲーム終了時にアート作品を用意したいと考えています。携帯電話の壁紙のようなものです！\n\n私の名前はRidleyで、ゲーム内でファーストフード店を経営しているvtuberです。他にもスタッフがいます。ゲーム内の衣装とゲームアートを添付します。また、ゲームのプレイヤーを表す空白のキャラクターフィギュアを追加したいと思っています。あるいは、プレイヤーキャラクターの顔を見えなくすることもできます。\n\nアートでは、スタッフとプレイヤー・キャラクターが仕事の成功を祝っています！背景はシンプルなファーストフードをテーマにしてもいいのですが、誰かが休憩室や食堂で写真を撮ったように見えるといいなと思いました。ポーズのアイデアもフォルダに添付しました。\n\n近いうちにご一緒できればと思います！金額が足りない場合は依頼を送り返してください！\n\nhttps://drive.google.com/drive/folders/1GntBMVYkoILUunS8M0s3oifqS7e6XgjC\n\nhttps://drive.google.com/drive/folders/1GntBMVYkoILUunS8M0s3oifqS7e6XgjC\n\nhttps://drive.google.com/drive/folders/1GntBMVYkoILUunS8M0s3oifqS7e6XgjC", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/117", "thumbnail_src": "https://si.imgix.net/774845b8/uploads/origins/5c92c17f-ee10-41b8-b83c-7a5e15b3c0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ffff962a72e804cef56278749c159e0", "thumbnail_srcset": "https://si.imgix.net/774845b8/uploads/origins/5c92c17f-ee10-41b8-b83c-7a5e15b3c0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ffff962a72e804cef56278749c159e0, https://si.imgix.net/774845b8/uploads/origins/5c92c17f-ee10-41b8-b83c-7a5e15b3c0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dacee046f8edce90c83f8c84e7b59652 2x, https://si.imgix.net/774845b8/uploads/origins/5c92c17f-ee10-41b8-b83c-7a5e15b3c0dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55058a505a1f103deed37c659b4b0c5d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/116", "thumbnail_src": "https://si.imgix.net/c7cee072/uploads/origins/91e543b3-3de8-4443-9580-6f47a9bf2253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b4aa28368992ee47829ffac4cf42c8f", "thumbnail_srcset": "https://si.imgix.net/c7cee072/uploads/origins/91e543b3-3de8-4443-9580-6f47a9bf2253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b4aa28368992ee47829ffac4cf42c8f, https://si.imgix.net/c7cee072/uploads/origins/91e543b3-3de8-4443-9580-6f47a9bf2253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a97a1930f5cb09213b3ccf2355a4831c 2x, https://si.imgix.net/c7cee072/uploads/origins/91e543b3-3de8-4443-9580-6f47a9bf2253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=365cf5ad505af304f8d334fe4b1a24af 3x", "genre": "art", "nsfw": false, "body": "Hello again,\nI would like to request another group picture of 6 umas from Uma Musume; Haru Uraru, El Condor Pasa, Nakayama Festa, Narita Brian, Marvelous Sunday and Neo Universe.\nThey are having dinner at a Japanese restaurant. El Condor Pasa is lifting her ramen bowl up to drink the ramen soup while Haru Urara is more elegantly eating her ramen.  Neo Universe is quietly eating an onigiri while having her sleeves over her hands. Marvelous Sunday is cheerfully enjoying her drink through a straw. Narita Brian and Nakayama Festa are fighting over a shared dish in the middle of the table with their chopsticks. Please make it look like a chaotic dinner with friends.\nFeel free to make adjustments if you see fit. I look forward to your work!\n\nUmas: https://photos.app.goo.gl/GBSgwP29ZdZTqZhDA", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/115", "thumbnail_src": "https://si.imgix.net/f969e990/uploads/origins/4228e44a-6083-4d42-8049-2fad75153bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c617d9a72dfebb983b31c4bb4d3fe75e", "thumbnail_srcset": "https://si.imgix.net/f969e990/uploads/origins/4228e44a-6083-4d42-8049-2fad75153bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c617d9a72dfebb983b31c4bb4d3fe75e, https://si.imgix.net/f969e990/uploads/origins/4228e44a-6083-4d42-8049-2fad75153bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a659f5b962c28798a5bf5fed465d049 2x, https://si.imgix.net/f969e990/uploads/origins/4228e44a-6083-4d42-8049-2fad75153bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31abc565837b496d708e7eb1dc1cc261 3x", "genre": "art", "nsfw": false, "body": "こんにちは。イラストをお願い出来ないかと参りました。\n\nキャラクターは、艦これから『熊野改二』ウマ娘から『ライスシャワー』をお願いしたいです。\n熊野改二は制服姿で、ライスシャワーは大豊食祭の衣装を着ていて、喫茶店のテーブルに座っている熊野の元にライスシャワーがパフェかサンドイッチを運んで来たシーンをお願い出来ないでしょうか。その際、二人の視線が軽く合っていると嬉しいです。\n\nご検討いただけますと幸いです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/114", "thumbnail_src": "https://si.imgix.net/a08696fa/uploads/origins/a14a2860-5b9c-400c-946b-50e5d2513a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f76a88fc990eb4235153df0036ca51bc", "thumbnail_srcset": "https://si.imgix.net/a08696fa/uploads/origins/a14a2860-5b9c-400c-946b-50e5d2513a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f76a88fc990eb4235153df0036ca51bc, https://si.imgix.net/a08696fa/uploads/origins/a14a2860-5b9c-400c-946b-50e5d2513a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11dc2dd24060590d9a4bd288636623f 2x, https://si.imgix.net/a08696fa/uploads/origins/a14a2860-5b9c-400c-946b-50e5d2513a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea95ee81c8bef337e3ad0f4b203565e4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\nシュヴァルグラン、八重野無敵、堂東名阪、春うらら、エルコンドルパサの5人のウマ娘の集合写真をお願いします。\n彼らは室内で一緒にたむろし、カジュアルな服装で、お互いにゲーム、特に格闘ゲームで遊んでいる。アーケードスティックで遊んでいる2人のウマはあなた次第。他の3人は、いろいろな興奮状態で彼らの後ろに立っていることができる。ただたむろして楽しんでいる友人たちのように見えるようにお願いします。\nよろしくお願いします！\n\nウマス：https://photos.app.goo.gl/GBSgwP29ZdZTqZhDA", "created_at": "", "completed_at": ""}, {"path": "/@hamu_koutarou/works/113", "thumbnail_src": "https://si.imgix.net/501b168f/uploads/origins/5dc0c397-a686-4689-82ce-cc0aaade2b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=348d60b6797b515cf613a0250636aae0", "thumbnail_srcset": "https://si.imgix.net/501b168f/uploads/origins/5dc0c397-a686-4689-82ce-cc0aaade2b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=348d60b6797b515cf613a0250636aae0, https://si.imgix.net/501b168f/uploads/origins/5dc0c397-a686-4689-82ce-cc0aaade2b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVA