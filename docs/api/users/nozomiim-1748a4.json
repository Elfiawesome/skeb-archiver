mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d87f269c791835b2a13b651bff7aeb1 2x, https://si.imgix.net/d099c840/uploads/origins/37f9fab5-b0f7-4a4b-b336-370ef0b93cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=213c98a3cc3c811ac9125183ff910a7b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。先生の絵柄が好きで依頼させていただきました。 この度オンラインゲームの自キャラの絵をお願いしたいと思っています。 キャラの画像、は下記URLにありますので、お手数ですが参照よろしくお願いいたします。 ・イメージ クールなイメージです。 ・使用用途 PCの壁紙 、動画のサムネ 、アイコン・納品形式 PSD形式で大丈夫です。レイヤー分け可能ならお願いしたいです ・構図 構図はお任せします。 よろしくお願いいたします。\n\nhttps://twitter.com/LilliUni/status/1397545456935211011/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@nozomiim/works/12", "thumbnail_src": "https://si.imgix.net/6075984b/uploads/origins/6ef836f0-2863-4e24-bd6a-f38566169078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=361c7377392849a75b90d88e0e9400cb", "thumbnail_srcset": "https://si.imgix.net/6075984b/uploads/origins/6ef836f0-2863-4e24-bd6a-f38566169078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=361c7377392849a75b90d88e0e9400cb, https://si.imgix.net/6075984b/uploads/origins/6ef836f0-2863-4e24-bd6a-f38566169078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2f7a11a1d835293f24f48d0202f8edd 2x, https://si.imgix.net/6075984b/uploads/origins/6ef836f0-2863-4e24-bd6a-f38566169078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9f550071c0d1761b743aa2569c97d79 3x", "genre": "art", "nsfw": false, "body": "先回はうちの妹ちゃんをかわいく仕上げていただきありがとうございました。\n 再びで申し訳ありませんが、うちの妹ちゃんをもう一枚お願いしたいです。 \n\nhttps://twitter.com/sae_pso2/status/1489871769750368257s=20&t=FVtKpxZkTC3AjG4KfZ2NfQ \n\nこちらが参考資料となります。\n こんな感じのウェイトレスさんか、メイドさんのアルバイト中というイメージでお願いします。 よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nozomiim/works/11", "thumbnail_src": "https://si.imgix.net/474c3d39/uploads/origins/02fff22a-d08c-4a79-abfa-39d1bf4902ca?bg=%23fff&auto=format%2Ccompress&f