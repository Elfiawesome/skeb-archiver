c70326f2e24a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dac1262e4b4511efcc6bbc7bd1f43dee", "thumbnail_srcset": "https://si.imgix.net/f8ebab3c/uploads/origins/f69c4d51-8cd0-4be6-bc11-c70326f2e24a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dac1262e4b4511efcc6bbc7bd1f43dee, https://si.imgix.net/f8ebab3c/uploads/origins/f69c4d51-8cd0-4be6-bc11-c70326f2e24a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=67f279f1e07420af660657347ca95456 2x, https://si.imgix.net/f8ebab3c/uploads/origins/f69c4d51-8cd0-4be6-bc11-c70326f2e24a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dd64abafd53e6631581a7f930315901 3x", "genre": "art", "nsfw": false, "body": "たいと様はじめまして！\nアピールありがとうございます！キャラデザ褒めていただけてうれしいです！\n是非描いていただきたいと思いましたのでリクエストさせていただきます！\n\nロリポップキャンディを咥える柚葵のことを描いていただけますでしょうか？\n構図や背景はお任せ致します！\n\n使用用途としてはアイコンやサムネイル、動画素材として利用させていただこうと考えております。\n納品形式としましては、可能であればキャラクターと背景を分けたPSDでいただけたらと思います。\n\nご参考までに下記URLに設定資料を載せておりますのでご確認ください。\n\nhttps://drive.google.com/drive/folders/1pCBNMp2Hq12ZXVTg7N9NlI06eVelhUrb?usp=sharing\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1pCBNMp2Hq12ZXVTg7N9NlI06eVelhUrb?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kobo_ruru/works/9", "thumbnail_src": "https://si.imgix.net/c4001809/uploads/origins/c2c64324-437d-4c4f-aac9-a3bcd230c4ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a63d967bacc8d8abb11ea84970a19dc", "thumbnail_srcset": "https://si.imgix.net/c4001809/uploads/origins/c2c64324-437d-4c4f-aac9-a3bcd230c4ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a63d967bacc8d8abb11ea84970a19dc, https://si.imgix.net/c4001809/uploads/origins/c2c64324-437d-4c4f-aac9-a3bcd230c4ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cb7e66cad17fff89bb9547855028fec 2x, https://si.imgix.net/c4001809/uploads/origins/c2c64324-437d-4c4f-aac9-a3bcd230c4ae?bg=%23fff&auto=forma