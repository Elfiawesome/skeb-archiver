5a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a21997bba1a408cdf1b7a7247151b14 2x, https://si.imgix.net/dc18b7f3/uploads/origins/7870fb0d-27b2-4bf4-b30f-9983af4455a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1eb3f11e1c45b9ea9ba1648e3c52e2c 3x", "genre": "art", "nsfw": true, "body": "はじめまして！あなたの絵がとても好きです！できれば、この2つのキャラクターを描いてほしいです！\n青い毛のオオカミとパンダの赤ちゃんです。二人とも三角形の海水パンツだけを着て、浜辺で遊んでいます。\nオオカミは黄色、レッサーパンダは水色の水着を着ています。\nいろいろなスタイルの水泳パンツの差分があればアルバムの参考になるのに。\nこの差分では、チビパンダのスイムパンツとオオカミのスイムパンツは同じスタイルだが、黒のサンドイッチにスカイブルーの組み合わせ。\nもし価格が足りない場合は、修正リクエストを送ることができます。\nありがとうございました！\nhttps://drive.google.com/drive/folders/1nfKZGfvO9WHsZFBSPX-G6Qoc_I-f6GQ7?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@dinogaize_sub/works/134", "thumbnail_src": "https://si.imgix.net/7f636a0e/uploads/origins/cdee8f2a-fe33-428e-98f6-2c566ddbeb59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de6d4cae73f805f36fabfa062404bf80", "thumbnail_srcset": "https://si.imgix.net/7f636a0e/uploads/origins/cdee8f2a-fe33-428e-98f6-2c566ddbeb59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de6d4cae73f805f36fabfa062404bf80, https://si.imgix.net/7f636a0e/uploads/origins/cdee8f2a-fe33-428e-98f6-2c566ddbeb59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94daf860a102bae6850a873a25da402c 2x, https://si.imgix.net/7f636a0e/uploads/origins/cdee8f2a-fe33-428e-98f6-2c566ddbeb59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e47d73c66516dff8de2a43d6c46b239e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dinogaize_sub/works/133", "thumbnail_src": "https://si.imgix.net/bef4b1a0/uploads/origins/2ce36567-3e3e-43bc-a6b4-5bf13db7a239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f02e16f25aa1c7b6019f62f4e5620439", "thumbnail_srcset": "https://si.imgix.net/bef4b1a0/uploads/origins/2ce36567-3e3e-43bc-a6b4-5bf13db7a239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f02e16f25aa1c7b6019f62f4e5620439, https://si.imgix.net/bef4b1a0/uploads/origins/2ce36567-3e3e-43bc-a6b4-5bf13db7a239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55e1b063b9b8798fb062db848186e0a0 2x, https://si.imgix.net/bef4b1a0/uploads/origins/2ce36567-3e3e-43bc-a6b4-5bf13db7a239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cbca224a45b6ba6a539e3c66c0df732 3x", "genre": "art", "nsfw": true, "body": "こんにちは。彼の体型は、あなたがよく描いているような、少しぽっちゃりした体型のように描くことができます。目は前と同じように描いて、あなたの描く縦長の瞳孔が好きです。\n.彼の顔は、見られたときの喜びや驚きの表情でもいい。\n私のキャラクター\nhttps://drive.google.com/drive/folders/1AkHlbq0JcUIQDaZ-dDcVjftzAEFc_uze?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1AkHlbq0JcUIQDaZ-dDcVjftzAEFc_uze?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@dinogaize_sub/works/132", "thumbnail_src": "https://si.imgix.net/aa212117/uploads/origins/b43ecda1-69b3-4577-8044-aa4ef957c6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccfbff1ef94027506e7132b699637721", "thumbnail_srcset": "https://si.imgix.net/aa212117/uploads/origins/b43ecda1-69b3-4577-8044-aa4ef957c6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccfbff1ef94027506e7132b699637721, https://si.imgix.net/aa212117/uploads/origins/b43ecda1-69b3-4577-8044-aa4ef957c6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=304b2330806c641d91ed9ec47288a6a0 2x, https://si.imgix.net/aa212117/uploads/origins/b43ecda1-69b3-4577-8044-aa4ef957c6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07b57506ebf885f17073035e598c6275 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生！先生の画風が特に好きなので、私のOOCを描いてください！小さなオレンジの尻尾を持った小さな虎で、犬のようなしゃがんだポーズとしばりの表情が希望です！ありがとう！\nこれが僕のOOCの作例です：\nhttps://drive.google.com/file/d/1B4opJfoDUDMDiEp9HNfRLPoNyXwAfxPQ/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@dinogaize_sub/works/131", "thumbnail_src": "https://si.imgix.net/868157ae/uploads/origins/ba0159c5-1fa7-4bbd-87b9-b02cffb3683c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a8fa345144afdcffb29baca9de11e9", "thumbnail_srcset": "https://si.imgix.net/868157ae/uploads/origins/ba0159c5-1fa7-4bbd-87b9-b02cffb3683c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a8fa345144afdcffb29baca9de11e9, https://si.imgix.net/868157ae/uploads/origins/ba0159c5-1fa7-4bbd-87b9-b02cffb3683c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a605e4fd4d6f202044da872ce7b5fb34 2x, https://si.imgix.net/868157ae/uploads/origins/ba0159c5-1fa7-4bbd-87b9-b02cffb3683c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd50493820275660b1901892f31ed4ac 3x", "genre": "art", "nsfw": true, "body": "あなたの作品が本当に好きなので、依頼をしたいです。\n私のOCはふわふわの猫ドラゴンです。\n私のOCがスク水（2番目のリンクにある布）を着ているかわいいイラストが見たいです。\n詳しいキャラクターデザインは\nhttps://imgur.com/a/ndoA8oQ\nhttps://imgur.com/a/QGNEMiE", "created_at": "", "completed_at": ""}, {"path": "/@dinogaize_sub/works/130", "thumbnail_src": "https://si.imgix.net/32d51049/uploads/origins/27aeffc5-8db9-4a67-a780-a26bfa699ef7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1db7e3c77d3caba2de39053d51258499", "thumbnail_srcset": "https://si.imgix.net/32d51049/uploads/origins/27aeffc5-8db9-4a67-a780-a26bfa699ef7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1db7e3c77d3caba2de39053d51258499