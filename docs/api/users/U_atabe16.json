200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6247c27fd5ea6873e7557c8ba912e695, https://si.imgix.net/d2201119/uploads/origins/2e4f5239-8b11-43db-a9db-75a92f892cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba642f3ef2b0192116c253d9aca7db5b 2x, https://si.imgix.net/d2201119/uploads/origins/2e4f5239-8b11-43db-a9db-75a92f892cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64854de4cd60c076148d2cf870689ee6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/13", "thumbnail_src": "https://si.imgix.net/b8952574/uploads/origins/baf0a2dc-9794-4ff9-877e-45f69cb550db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f8a85f7bd70c2af508795f5b79c11e9", "thumbnail_srcset": "https://si.imgix.net/b8952574/uploads/origins/baf0a2dc-9794-4ff9-877e-45f69cb550db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f8a85f7bd70c2af508795f5b79c11e9, https://si.imgix.net/b8952574/uploads/origins/baf0a2dc-9794-4ff9-877e-45f69cb550db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96e4c029df504e604564c231c074bfb4 2x, https://si.imgix.net/b8952574/uploads/origins/baf0a2dc-9794-4ff9-877e-45f69cb550db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b8c6e69b92e8a054254564fe2752761 3x", "genre": "art", "nsfw": false, "body": "Hi sorry i denied resent cancel request last  but this time I will not cancel this accept for my request can you draw Yuu and setsuna as in school idol  :) : for the post I want to see Yuu and setsuna hugging each other as if Yuu is happy to perform in the same stage as setsuna Yuu and Setsuna wearing same nijro  iro passion dress https://i.imgur.com/Z52WCVy.jp thank you 😊", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/12", "thumbnail_src": "https://si.imgix.net/74f25cbd/uploads/origins/3f2ebb9f-18b4-4f9c-bd81-b7871e1069da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199e5c822cfc8f9de0952d4d2c08a1bc", "thumbnail_srcset": "https://si.imgix.net/74f25cbd/uploads/origins/3f2ebb9f-18b4-4f9c-bd81-b7871e1069da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199e5c822cfc8f9de0952d4d2c08a1bc, https://si.imgix.net/74f25cbd/uploads/origins/3f2ebb9f-18b4-4f9c-bd81-b7871e1069da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e98f6ee3f95262ef878d62a599a5fc0 2x, https://si.imgix.net/74f25cbd/uploads/origins/3f2ebb9f-18b4-4f9c-bd81-b7871e1069da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3afd8ff712ce18475000c0526cc39a3 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストを拝見させていただいております。まさみ様の描かれているラブライブ！シリーズのキャラクターにとても魅力を感じ、以下のリクエストをさせていただきます。\n【キャラクター】\nラブライブ！シリーズでまさみ様が選んだキャラクター二名\n※無印、サンシャイン、虹ヶ咲、スーパースター、幻日のヨハネ、蓮ノ空の中であれば、どの作品でも大丈夫です。また、二人の登場シリーズは統一しなくても大丈夫です。まさみ様が推している二名でも、現在描きたい二名でも、ご自由にお選びいただきたく思います。また、巨乳貧乳は問いません。\n\n【シチュエーション】\nダブルパイズリ\n\n【衣装】\n両者とも全裸に制服のリボンを着用\n\n【その他】\n二人の乳首は見えた状態でお願いいたします。また、可能であれば射精・ぶっかけ差分、表情差分についてもお願いできればと思います。予算の範囲内で、また、射精差分を優勢してください。上記以外についてはおまかせいたします。\n\nここまでお読みいただき、ありがとうございました。興味のない依頼だったり、条件に合わない場合は遠慮なくキャンセルいただければと思います。ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/11", "thumbnail_src": "https://si.imgix.net/c9351423/uploads/origins/195503cc-9b5b-49e6-99ae-c28e8f453791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75f7e210c34d0f2c0c901be3e3cc7cf1", "thumbnail_srcset": "https://si.imgix.net/c9351423/uploads/origins/195503cc-9b5b-49e6-99ae-c28e8f453791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75f7e210c34d0f2c0c901be3e3cc7cf1, https://si.imgix.net/c9351423/uploads/origins/195503cc-9b5b-49e6-99ae-c28e8f453791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7b637fe8e78d3dc8184c111fb1e410b 2x, https://si.imgix.net/c9351423/uploads/origins/195503cc-9b5b-49e6-99ae-c28e8f453791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92616609ae848878d521c46954049fbf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/10", "thumbnail_src": "https://si.imgix.net/26665fd2/uploads/origins/1e40056f-3e5b-41fa-8510-cd513f6e5ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6926a0294a30d6d845aee46e65a233a", "thumbnail_srcset": "https://si.imgix.net/26665fd2/uploads/origins/1e40056f-3e5b-41fa-8510-cd513f6e5ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6926a0294a30d6d845aee46e65a233a, https://si.imgix.net/26665fd2/uploads/origins/1e40056f-3e5b-41fa-8510-cd513f6e5ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c98a5ba5d84072f39f8457b1f814da4 2x, https://si.imgix.net/26665fd2/uploads/origins/1e40056f-3e5b-41fa-8510-cd513f6e5ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b286500028efa80c365d9baeffd7428b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nラブライブ虹ヶ咲の結城せつ菜ちゃんの依頼をお願いしたいです！\n\n裸で温泉に浸かっているところをお願いします。胸が少し浮いていて、片方の胸を軽くマッサージしています。\n\nキャラクターリファレンス - https://imgur.com/a/Mrd9HDv\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/9", "thumbnail_src": "https://si.imgix.net/73c7ec37/uploads/origins/64c6a2c2-0f10-4282-9d1f-6b8d41f116ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f587829e5266820ef4b1fbef6f70eb79", "thumbnail_srcset": "https://si.imgix.net/73c7ec37/uploads/origins/64c6a2c2-0f10-4282-9d1f-6b8d41f116ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f587829e5266820ef4b1fbef6f70eb79, https://si.imgix.net/73c7ec37/uploads/origins/64c6a2c2-0f10-4282-9d1f-6b8d41f116ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82aa5ca924f7f3fa11a6943a75708aa1 2x, https://si.imgix.net/73c7ec37/uploads/origins/64c6a2c2-0f10-4282-9d1f-6b8d41f116ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1102e354258df625f3e681305bba92e 3x", "genre": "art", "nsfw": false, "body": "初めまして。いつも素晴らしい絵を拝見しております。\n\n今回は三船栞子の絵をお願いしたいと思います。\n服装は旧スク水で、髪型はNEXT SKYに登場したようなポニーテールです。\n構図・アングルは先生が2022年8月に描かれていたスク水彼方のような形式でお願いします。\nポーズや背景はお任せいたします。\n\nご多忙かとは思いますが、何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/8", "thumbnail_src": "https://si.imgix.net/224c601a/uploads/origins/60f7f41e-a0a3-4846-be18-9b90c704373f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79200e854bcab9b6e6ec4738d59f1b93", "thumbnail_srcset": "https://si.imgix.net/224c601a/uploads/origins/60f7f41e-a0a3-4846-be18-9b90c704373f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79200e854bcab9b6e6ec4738d59f1b93, https://si.imgix.net/224c601a/uploads/origins/60f7f41e-a0a3-4846-be18-9b90c704373f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59cacfd03af53e96f719f99113f5758c 2x, https://si.imgix.net/224c601a/uploads/origins/60f7f41e-a0a3-4846-be18-9b90c704373f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c073c09764fda65997cf9ee73f523268 3x", "genre": "art", "nsfw": false, "body": "こんにちは、正己あたべです。）優と刹那が抱き合っているところが見たくて、背景はお化け屋敷のような暗いところ、かぼちゃのジャック・オー・ランタンのようなところ、コウモリのようなところ、こんな感じです :) https://i.imgur.com/0syUB2S.jpg 優と刹那が一緒にオールスターアプリゲームのドレスのハロウィンの特別なドレスを着ているところ、twitterに投稿してみんなに見てもらえるかな、本当に優雪が大好きなtwitterの人たちのために https://i.imgur.com/052eLXp.jpg", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/7", "thumbnail_src": "https://si.imgix.net/e298cfb9/uploads/origins/d362022c-9b0e-436d-a130-a37811c3954e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaaa114c4e36e485eb5abac081dd971a", "thumbnail_srcset": "https://si.imgix.net/e298cfb9/uploads/origins/d362022c-9b0e-436d-a130-a37811c3954e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaaa114c4e36e485eb5abac081dd971a, https://si.imgix.net/e298cfb9/uploads/origins/d362022c-9b0e-436d-a130-a37811c3954e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cdf4810214a9a986b87ed330c1c692b 2x, https://si.imgix.net/e298cfb9/uploads/origins/d362022c-9b0e-436d-a130-a37811c3954e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d498cc7f65dc0d344c438dc512db3b04 3x", "genre": "art", "nsfw": false, "body": "初めまして、素敵なイラストを拝見させていただいたので、今回リクエストさせていただきました。\n\nラブライブ！サンシャイン！！の桜内梨子が空腹で、大きな音でお腹が鳴ってしまい、赤面するイラストをお願いいたします。\n\n衣装は「恋になりたいAQUARIUM」で、お腹・おへそが強調されるよう腰を前に突き出す感じで、お願いします。\n\nポーズの希望はありませんが、もしポーズ付きで描いていただける場合は、おへそが隠れないようお願いします。\n\n「ぐぅぅぅぅ〜」や「ぎゅるるるるる」といったお腹の音の擬音もお願いします。\n\nお忙しい中お手数ですが、ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@U_atabe16/works/6", "thumbnail_src": "https://si.imgix.net/d832ce61/uploads/origins/5db9c259-2e1b-4634-82ac-aeb90ef90ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cec6cf3188a387c9e3fbb3e683de872f", "thumbnail_srcset": "https://si.imgix.net/d832ce61/uploads/origins/5db9c259-2e1b-4634-82ac-aeb90ef90ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cec6cf3188a387c9e3fbb3e683de872f, https://si.imgix.net/d832ce61/uploads/origins/5db9c2