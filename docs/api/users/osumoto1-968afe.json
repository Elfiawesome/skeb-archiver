4be1-b668-64f2e2c1c3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0442da95d415522c41be1cd7c606b6c1", "thumbnail_srcset": "https://si.imgix.net/b6532dd3/uploads/origins/6332808c-03af-4be1-b668-64f2e2c1c3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0442da95d415522c41be1cd7c606b6c1, https://si.imgix.net/b6532dd3/uploads/origins/6332808c-03af-4be1-b668-64f2e2c1c3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87c047827daad72bf78887429bfc6835 2x, https://si.imgix.net/b6532dd3/uploads/origins/6332808c-03af-4be1-b668-64f2e2c1c3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a265f08b66ae3bf0e83b7004e60c269 3x", "genre": "art", "nsfw": true, "body": "おすもと様\nこんにちは！\n黒木父母（もこパパともこママ）と吉田母の学生時代の漫画を描いていただけないでしょうか？\n\n・シチュエーション：高校生時代の黒木父、黒木母、吉田母の学校生活。三人とも同じ学校の同じクラス（吉田母まで同学年・同クラスと言うのは現実的ではないでしょうが、あくまでもifということで）\n・服装：男子は黒詰学ラン、女子はセーラー服。時代的には1990年代あたりということで、女子は二人ともミニスカ・ダボダボルーズソックス（膝丈やロンスカなど、二人のキャラに合わせて変えてくださってもOKです。さすがにガングロギャルにはしないでください）。それ以外の時代考証は適当で構いません\n・外見：基本は原作をベースにしてください。黒木母の30歳頃は公式絵（意外と美人）で出ていますので、これをもっと若くするという感じでお願いします。吉田母は原作のままでも制服を着て違和感があまりないような気が…\nhttps://horobijiji.blog.fc2.com/img/watamote11tokuten_tora.jpg/\nhttps://horobijiji.blog.fc2.com/img/mo102-36.png/\n・キャラ：黒木父は智貴似のスポーツマンでそれなりにイケメンだが、鈍重でややコミュ障気味（ただ、初期のもこっちほどではない）。黒木母はいちおう常識人だが、思い込みが激しく、とくにヤンキーには偏見。吉田母はかなりの美人だがヤンキー気味。あくまでもおおよそですので、おすもとさんのお好みで変えてくださっても構いません\n・黒木母の旧姓は「里崎」で。吉田母の旧姓はロッテの選手名であれば何でもOKです\n・ストーリー展開：ほぼお任せしますが、黒木父による吉田母へのラキスケ要素を入れてくださるとうれしいです（血は争えない的な感じで）。念のためNSFWにしておきますが、まったくの非エロでもOKです\n\n三人の外見がとくに手間だと思われますので、遠慮なさらずに再送要請を出していただければと存じます。\nご検討いただけると幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/30", "thumbnail_src": "https://si.imgix.net/a1f6dc44/uploads/origins/23e526ef-74f5-450c-b6e4-744342379a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIV