1-4eb1-bdff-d1bee97fbe27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85c54bf803045160863b31f29a53cfdb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/28", "thumbnail_src": "https://si.imgix.net/581c6734/uploads/origins/0b4dc8b5-8013-4f0d-a1fa-3786983832b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05ad6f86948471fefcd89be17beb9a31", "thumbnail_srcset": "https://si.imgix.net/581c6734/uploads/origins/0b4dc8b5-8013-4f0d-a1fa-3786983832b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05ad6f86948471fefcd89be17beb9a31, https://si.imgix.net/581c6734/uploads/origins/0b4dc8b5-8013-4f0d-a1fa-3786983832b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee999d7d86955817e4af967acefd2287 2x, https://si.imgix.net/581c6734/uploads/origins/0b4dc8b5-8013-4f0d-a1fa-3786983832b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e92804ae401a4fd5271361e1a94e465f 3x", "genre": "art", "nsfw": false, "body": "お時間ございましたら、黒木先生をお願いしたいですが、如何でしょうか？\n\n通勤で使用している愛車に乗ろう、又は降りようとしてるシーンを見てみたいのですが\n愛車は2シーターのスポーツカーでお願いしてもいいですか？\n\nあと\n明日香「うーん、カッコいいけどもう少し人数乗れるのにしたら？」\n智子「え？明日香しか乗せないし良いんじゃない？」\nという一言で説得して購入した、という裏設定などつけてみたり(なお、雫が乗りたがったり成田先生が普通に乗って送ってもらったりしてる)", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/27", "thumbnail_src": "https://si.imgix.net/adbb52a8/uploads/origins/cbbdebda-8b9f-4cc4-aac8-e4592b8dabf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33abad24dfdd70d45bf358ea02423c67", "thumbnail_srcset": "https://si.imgix.net/adbb52a8/uploads/origins/cbbdebda-8b9f-4cc4-aac8-e4592b8dabf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33abad24dfdd70d45bf358ea02423c67, https://si.imgix.net/adbb52a8/uploads/origins/cbbdebda-8b9f-4cc4-aac8-e4592b8dabf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cdff3bf72e49d1113acec00b6720d50 2x, https://si.imgix.net/adbb52a8/uploads/origins/cbbdebda-8b9f-4cc4-aac8-e4592b8dabf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65cf15a18cc05d63a46cddaebd075f61 3x", "genre": "art", "nsfw": false, "body": "先日は素晴らしい漫画をありがとうございました！\n以下のような感じのわたモテの漫画を描いていただけないでしょうか？\n\n・もこっちが街を歩いていると、加藤さんが爽やかイケメンと仲良く連れ立っているのを見かける。どこから見ても恋人同士にしか見えない。もこっち、大ショック\n・加藤さんがもこっちに気が付く。なんとイケメンは加藤さんのお兄さんだった。嬉しそうにもこっちにお兄さんを紹介\n・「君があの智子ちゃん？明日香がいつもお世話になっています」という感じでお兄さんがもこっちに挨拶すると、もこっち、イケメンを前に真っ赤になってキョどりまくる（初期のもこっちっぽく）\n・二人を見ていた加藤さんの心の声（あら、私いまどっちに嫉妬していたのかしら？）\n\n加藤さんのお兄さんの外見については、「ライト姉妹」中の空想シーンをイメージしていますが、おすもとさんのお好みで変えていただいてもＯＫです。https://twitter.com/harutoka373/status/1122185385184874496\n\nともかく加藤さんのブラコンぶりが見たいので、細部についてはおすもとさんにお任せいたします。\n\nご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/26", "thumbnail_src": "https://si.imgix.net/841cf879/uploads/origins/94ddb8da-c1e7-45f8-88c4-76b521208c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf182ccd905d368be991c09193e5bce6", "thumbnail_srcset": "https://si.imgix.net/841cf879/uploads/origins/94ddb8da-c1e7-45f8-88c4-76b521208c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf182ccd905d368be991c09193e5bce6, https://si.imgix.net/841cf879/uploads/origins/94ddb8da-c1e7-45f8-88c4-76b521208c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89f4a909ebc5a12dbeae6fe89112cca9 2x, https://si.imgix.net/841cf879/uploads/origins/94ddb8da-c1e7-45f8-88c4-76b521208c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39b7387f9d1bcd06efd1a65179ef2ce4 3x", "genre": "art", "nsfw": true, "body": "いつもわたモテのイラスト楽しませていただいております。\n22巻のおまけ（かともこのメイク）の二次創作をリクエストいたします。\n\n加藤さんがメイクのために目を閉じた所で「ふふ、これだとキスをねだってるみたい」と思っていたら、智子から頬に両手を添えられドキッとする。\n目を閉じたままドキドキしている中、智子の顔が近づく気配と吐息が顔に当たるのを感じて、ときめいてしまう。\n智子の小さくも熱のこもった「明日香」というつぶやきに、覚悟を決めて「いいよ」とキス待ち。智子の唇が近づき…。\n\n帰り道、歩きながら。二人とも赤い顔でうつむいたまま恥ずかしそうに「智ちゃん、また『メイク』してくれる？」「うん」「智ちゃんの部屋でもいい？」「うん」「次は優しくしてね？」「…はい」\n\nみたいなのを是非ともお願いします。\nキスしてるところは描写が無い方が逆にエロい気もするのですが、おすもと様にお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/25", "thumbnail_src": "https://si.imgix.net/685fa859/uploads/origins/56cec1aa-ccf4-41a7-9a19-22c72267f296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e117850ce8b8c1b0a634fd169c5cbd5", "thumbnail_srcset": "https://si.imgix.net/685fa859/uploads/origins/56cec1aa-ccf4-41a7-9a19-22c72267f296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e117850ce8b8c1b0a634fd169c5cbd5, https://si.imgix.net/685fa859/uploads/origins/56cec1aa-ccf4-41a7-9a19-22c72267f296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67a935b29aac504af89df6686e3d2817 2x, https://si.imgix.net/685fa859/uploads/origins/56cec1aa-ccf4-41a7-9a19-22c72267f296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91dddbda8681ad1d9ef1c2e267a99771 3x", "genre": "art", "nsfw": false, "body": "はじめまして、とぺぺと申します。\nおすもとさんの素晴らしいイラストをいつも楽しませていただいております。\n以前、智貴とつき合っている設定の吉田さんをもこっちがからかうイラストに大変感銘を受けましたので、依頼させていただきます。\n\n2年生のヤンキーもこっち（ヤンもこ）が吉田さんに対して、智貴とつき合っていることをネタにいじりまくるも（「茉咲～弟とはもうパコったのか～」「ちゃんとゴムつけろよ～」「この年であたしを伯母さんにさせんなよ～」等々）、真っ赤になった吉田さんに制裁を食らう、といったシチュエーションでお願いします。ヤンもこのロンスカと吉田さんのミニスカ・ルーズソックスは彼女らのアイデンティティなので、（上半身だけでなく）ぜひとも描いて下さい。杏奈さんや麗奈さんも（「やれやれ、こいつらまたやってるよ」という感じで）登場させてくれると嬉しいです。その他の点に関してはずべてお任せします。\n\n以上、注文が多くなってしまい申し訳ありませんが、どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/24", "thumbnail_src": "https://si.imgix.net/1c564c39/uploads/origins/b18ca022-4c97-4315-846d-11a600eceb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04adf26e4f71057a4f8e43b93a414c3a", "thumbnail_srcset": "https://si.imgix.net/1c564c39/uploads/origins/b18ca022-4c97-4315-846d-11a600eceb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04adf26e4f71057a4f8e43b93a414c3a, https://si.imgix.net/1c564c39/uploads/origins/b18ca022-4c97-4315-846d-11a600eceb64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fddf0ccb8cf4908055b0d4c058f1befc 2x, https://si.imgix.net/1c564c39/uploads/origins/b18ca022-4c97-4315-846d-11a600eceb64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=873ac48cd25a353658ec74ba18d7c53e 3x", "genre": "art", "nsfw": true, "body": "おすもと様\nかともこでリクエストさせてください\n\nえっちになるとベッドヤクザになるもこっちと、もこっちになすがままにされる加藤さん\n\nをお願いしたく思います。\n普段は強キャラの加藤さんがベッドの上では弱々になるギャップが見たいです。\nこれまで何度も体を重ねているのにいつまで経っても初々しく恥じらう加藤さんにゾクゾクとS気に興奮するもこっちがあるとなお良いです。\n\nいつものおすもと様のかともことは関係性は違いますが、宜しければお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/23", "thumbnail_src": "https://si.imgix.net/e1188a48/uploads/origins/3f74c19b-bb4e-4f34-ad74-1ccdc7600f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5da29e12f97825de26da04c364ac51", "thumbnail_srcset": "https://si.imgix.net/e1188a48/uploads/origins/3f74c19b-bb4e-4f34-ad74-1ccdc7600f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5da29e12f97825de26da04c364ac51, https://si.imgix.net/e1188a48/uploads/origins/3f74c19b-bb4e-4f34-ad74-1ccdc7600f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db39b2b366eb29c712dd2cf5bada32cb 2x, https://si.imgix.net/e1188a48/uploads/origins/3f74c19b-bb4e-4f34-ad74-1ccdc7600f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cd60d6007a209c1401a91fdd74fa5cb 3x", "genre": "art", "nsfw": false, "body": "おすもと様\nいつもわたモテのイラスト楽しませていただいています。\nよろしければ、以下のお題でリクエストお願い致します。\n\n【私がモテないのはどう考えてもお前らが悪い!】\n黒木智子、黒木智香（加藤さん）の疑似姉妹によるイチャイチャデート。（智子が姉側）\n喪210（前編）のニコニコ加藤さんが可愛かったので、加藤さんには笑顔で幸せそうにしてほしいです。\n\nよろしければ、おすもと様の雫ちゃんが好きなので、「妹なら下級生の私がいるのに…」とうっちーみたいに後ろからストーキングしている雫ちゃんがいると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/22", "thumbnail_src": "https://si.imgix.net/67a119af/uploads/origins/d4cdfd05-6855-4843-a5ec-f8e1d63c0912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2c78cbbcca0fdc56f1689152ebc10a", "thumbnail_srcset": "https://si.imgix.net/67a119af/uploads/origins/d4cdfd05-6855-4843-a5ec-f8e1d63c0912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2c78cbbcca0fdc56f1689152ebc10a, https://si.imgix.net/67a119af/uploads/origins/d4cdfd05-6855-4843-a5ec-f8e1d63c0912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=213aa1b304251f92f83dc90c48d27651 2x, https://si.imgix.net/67a119af/uploads/origins/d4cdfd05-6855-4843-a5ec-f8e1d63c0912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4f72d6957ca69b6836c6c0955572fb0 3x", "genre": "art", "nsfw": true, "body": "いつもわたモテのイラストやマンガ楽しませていただいています。\nよろしければ下記のかともこのマンガをお願い致します。\n\nもこっちの部屋で２人での勉強会の休憩中に膝枕をしてもらう加藤さん。\n頭をなでてくれるもこっちの優しい表情にドキッとして顔をそらす加藤さん。\n顔をそらした先にある棚の中に隠れた電マ（１年生のときに景品で当てたの）に気付き、色々と妄想して顔を真っ赤にする加藤さん。\n「急にエロい顔して発情してんのか？」と考えていたら加藤さんが見てる電マに気づいて真っ青になるもこっち。\n頭をなでていたもこっちの手に指を絡めながら「智ちゃん…私…」と潤んだ目でせつなそうに見上げてくる加藤明日香さん。\n\nが見たいです。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/21", "thumbnail_src": "https://si.imgix.net/643f7e95/uploads/origins/0fa433c6-7418-4fee-81dc-c3687fee47f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9513f82f6dab38c077064dec9c07a86a", "thumbnail_srcset": "https://si.imgix.net/643f7e95/uploads/origins/0fa433c6-7418-4fee-81dc-c3687fee47f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9513f82f6dab38c077064dec9c07a86a, https://si.imgix.net/643f7e95/uploads/origins/0fa433c6-7418-4fee-81dc-c3687fee47f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db175f4d4be840fe7a314a6fea208b17 2x, https://si.imgix.net/643f7e95/uploads/origins/0fa433c6-7418-4fee-81dc-c3687fee47f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f49f2ff1b9dbfcd04b9e3fc494cf44e1 3x", "genre": "art", "nsfw": false, "body": "おすもとさんいつも応援しております！\nまたskeb依頼お願い致します！！\n\n(作品) わたモテ\n\n(お題)もこっちと2人でプリクラを撮るのを巡り加藤さんと平沢雫ちゃんが火花を散らす中抜け駆けしてちゃっかりもこっちとプリクラを撮る成田美保をお願い致します\n\nお題から好きに改変しちゃって全然OKです！！！！！！！！！！！！！", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/20", "thumbnail_src": "https://si.imgix.net/65a49a34/uploads/origins/710ef4d0-9232-4946-983b-6101e926ca34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d13f14d45eefdc83280dfac347a7f6e6", "thumbnail_srcset": "https://si.imgix.net/65a49a34/uploads/origins/710ef4d0-9232-4946-983b-6101e926ca34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d13f14d45eefdc83280dfac347a7f6e6, https://si.imgix.net/65a49a34/uploads/origins/710ef4d0-9232-4946-983b-6101e926ca34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81af167172dd941a4b6c17844d3feee7 2x, https://si.imgix.net/65a49a34/uploads/origins/710ef4d0-9232-4946-983b-6101e926ca34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65f42d283a439677a63f0e90942698e0 3x", "genre": "art", "nsfw": false, "body": "わたモテの黒木智子と成田美保をお願いします。\n\n内容は\n・二人が後に母校の教師になった設定(もこっちは以前お描きになられた先生の感じ)\n・美保が生徒達に「成田先生と黒木先生、同級生だったんですよね？」「学生時代どんな感じだったの？」みたいに聞かれる\n・美保は思い出し笑いしながら、もこっちがアソコの毛を染めたエピソードを話そうとする\n・それを怖い笑顔で(青筋立てて怒ってる)止めに入るもこっち\n\nというのは如何でしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/19", "thumbnail_src": "https://si.imgix.net/6991a1ce/uploads/origins/e5764f80-cb2c-4b97-8560-10d15d580c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad8bd15122436ffdc1ac7f425036d61", "thumbnail_srcset": "https://si.imgix.net/6991a1ce/uploads/origins/e5764f80-cb2c-4b97-8560-10d15d580c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad8bd15122436ffdc1ac7f425036d61, https://si.imgix.net/6991a1ce/uploads/origins/e5764f80-cb2c-4b97-8560-10d15d580c12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=035e86c0d5425d97a17896d89a339c3f 2x, https://si.imgix.net/6991a1ce/uploads/origins/e5764f80-cb2c-4b97-8560-10d15d580c12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c6cf83d51aa2a6d9c36d1130a4bbaef 3x", "genre": "art", "nsfw": false, "body": "おすもとさんいつも素敵な作品を拝見させていただいております。\n今までの感謝とおすもとさんのこの絵が見たいという欲求が混ざり合って今回skeb依頼に踏み込みました。\n\n(お題)\nわたモテ\nハロウィンの仮想をしたキバ子をサチがいじってイチャついてるイラスト\n\nふんわりとしたお題で申し訳ありませんがどうかお願い致します。(お題からガッツリ改変しちゃっても全然オッケーです。)", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/18", "thumbnail_src": "https://si.imgix.net/5f3c3be5/uploads/origins/e87224df-dbb5-454c-86a3-8efba64f3cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38caf2fe8358f9d442d45a90f65c310e", "thumbnail_srcset": "https://si.imgix.net/5f3c3be5/uploads/origins/e87224df-dbb5-454c-86a3-8efba64f3cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38caf2fe8358f9d442d45a90f65c310e, https://si.imgix.net/5f3c3be5/uploads/origins/e87224df-dbb5-454c-86a3-8efba64f3cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3826ff3057b0b6d0890d98e66fe29738 2x, https://si.imgix.net/5f3c3be5/uploads/origins/e87224df-dbb5-454c-86a3-8efba64f3cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ad9475115a37575ba466fb8d7079787 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ご都合合いましたら宜しくお願いします。人目をしのんでイチャつくかともこなイラストをお願いします。\nもこっちの髪をかきあげ顔を覗き込む加藤さん。もこっちの耳には加藤さんとお揃いのピアス。永遠と見てられる、といった幸せそうな加藤さんに、もう昼休みが終わるんだけど､､､言いながらも目を逸らせないもこっち。といったシーンをお願いします。　\n加藤さんにピアスを開けてもらったもこっち。学校では外していたが加藤さんに学校にも付けてくるように言われて、バレないようにヒヤヒヤしているもこっちを嬉しそうに見ている加藤さん。昼休みにチェックと称してイチャつくのが日課となっているというシチュエーションです。宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/17", "thumbnail_src": "https://si.imgix.net/55e2d602/uploads/origins/291239da-aeac-4302-a6a6-7bf1be6aa052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41576d982f1d1cd4afe8f2fc9c65b6d9", "thumbnail_srcset": "https://si.imgix.net/55e2d602/uploads/origins/291239da-aeac-4302-a6a6-7bf1be6aa052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41576d982f1d1cd4afe8f2fc9c65b6d9, https://si.imgix.net/55e2d602/uploads/origins/291239da-aeac-4302-a6a6-7bf1be6aa052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07ff4351fe8e0c848035a3cede2fa001 2x, https://si.imgix.net/55e2d602/uploads/origins/291239da-aeac-4302-a6a6-7bf1be6aa052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b9e5ac40690287ada2a3ef458a9302c 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n\n・大学生になったもこっちが調子に乗って舌ピアスにする。\n・それを加藤さんに見せる。\n・恥ずかしながら舌を見せる姿がえっちすぎて加藤さんに襲われるイラストをお願いします\n・ピアスの数は１個でお願いします。\n\nお忙しいとは思いますがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/16", "thumbnail_src": "https://si.imgix.net/cf505205/uploads/origins/22f4298f-364a-411b-a1c9-7e908316f7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04634414a3c4a6aa5f8e2fb1e89b1608", "thumbnail_srcset": "https://si.imgix.net/cf505205/uploads/origins/22f4298f-364a-411b-a1c9-7e908316f7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04634414a3c4a6aa5f8e2fb1e89b1608, https://si.imgix.net/cf505205/uploads/origins/22f4298f-364a-411b-a1c9-7e908316f7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95a1305e03176d70a35e133401cfbfca 2x, https://si.imgix.net/cf505205/uploads/origins/22f4298f-364a-411b-a1c9-7e908316f7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95f5e8f10642e758ad4559daa0b85d22 3x", "genre": "art", "nsfw": false, "body": "いつもとても素敵な絵を描いて投稿して頂いてありがとうございます。おすもとさんが描くみんなが可愛くて可愛くて惚れ直しました。\n\n最近わたモテを読み返したら、やっぱり今江先輩ともこっちが高校時代に付き合っている世界線が見たかったんだなぁ、と思いました。\n\nそれで、今江先輩は実は甘えん坊でみんなの期待を応えようとしているように無理してます。いつも放課後にもこっちのベッドでギューしたりキスしたりしてもらってます。一年生のぼっちのもこっちだったらさらに可愛いと思います。\n\nこんな雑な依頼ですが、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/15", "thumbnail_src": "https://si.imgix.net/8ed89102/uploads/origins/c8fa80de-1128-4a42-81a2-b5829c14e38d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489de69c3718dbcfebabe86841b68ba7", "thumbnail_srcset": "https://si.imgix.net/8ed89102/uploads/origins/c8fa80de-1128-4a42-81a2-b5829c14e38d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489de69c3718dbcfebabe86841b68ba7, https://si.imgix.net/8ed89102/uploads/origins/c8fa80de-1128-4a42-81a2-b5829c14e38d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d5aa1d377f4b66c020826c385907bb0 2x, https://si.imgix.net/8ed89102/uploads/origins/c8fa80de-1128-4a42-81a2-b5829c14e38d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=917e0b35800704a4fa3edcf35744f25c 3x", "genre": "art", "nsfw": false, "body": "お世話になります！\nわたモテのイラストをお願いいたします！\n\n・ゆりもこよしまこでドライブ&お出掛けするシチュエーション。\n(吉田さん運転で助手席は真子ちゃん、後部座席にゆりもこ。)\n\n・全体的に楽しそうで和やかな雰囲気\n\n・4人でお出掛けする事になり、凄く幸せそうなゆりちゃんの表情を入れて頂きたいです。\n\n宜しくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/14", "thumbnail_src": "https://si.imgix.net/c23eb8b8/uploads/origins/4538b0f9-9494-435b-ac66-9942685a2835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2faaa9e3b49e1fb85b127cc4c297765", "thumbnail_srcset": "https://si.imgix.net/c23eb8b8/uploads/origins/4538b0f9-9494-435b-ac66-9942685a2835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2faaa9e3b49e1fb85b127cc4c297765, https://si.imgix.net/c23eb8b8/uploads/origins/4538b0f9-9494-435b-ac66-9942685a2835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d0da952e820b177f63e92131bc2fb70 2x, https://si.imgix.net/c23eb8b8/uploads/origins/4538b0f9-9494-435b-ac66-9942685a2835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e59e7340bf32e97900f98284e3ae0a1f 3x", "genre": "art", "nsfw": true, "body": "おすもとさんのかともこ漫画、いつも楽しませてもらっております～！\n（≧ω≦）\n\nもこっちの下着脱がせ漫画の前フリエピソードが読みたく・・・！\n\nナレーション【今回のあらすじ：女性衣料品店の福引を一緒に回したら、高級ランジェリーショップのギフトカード（高額）が当たったので、「お互いに選び合いっこして買おう？」（加藤さん発案）という流れになった】\n\nもこっち（おおガーター！・・・これとか明日香が着るとスゴそう・・・！）\n加藤さん「智ちゃん、選んでくれた？」\nもこっち「あ・・・うん、これとか、ドウカナ？」\n遠慮して、清楚無難な下着を示すもこっち。\nそして鋭敏にそれを察知し、むーっとご不満な加藤さん。\nそしてもこっちの耳元で、頬を赤く染めながらささやく加藤さん。\n加藤さん「・・・本当にそれでいいの？智ちゃんだけが見て、智ちゃんだけが脱がせる下着なんだよ・・・？///」\nもこっち「～～～っっっ！///　じゃ、じゃあ、こっちの、ガーター付きの・・・///」←湯気出るほど真っ赤になりつつ\n加藤さん「♪///」←満面の笑み\n\nナレーション【このあと自分も透け透けのスゴいのを選ばれるもこっちであった】\n\n・・・っていうのを、読みたいです・・・！\nよろしくお願いします・・・！", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/13", "thumbnail_src": "https://si.imgix.net/1340b158/uploads/origins/98157d05-9e50-49a0-8dc3-fc52c780c6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae7e8fc6e8348f5f80b9d2f116ab6e3", "thumbnail_srcset": "https://si.imgix.net/1340b158/uploads/origins/98157d05-9e50-49a0-8dc3-fc52c780c6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae7e8fc6e8348f5f80b9d2f116ab6e3, https://si.imgix.net/1340b158/uploads/origins/98157d05-9e50-49a0-8dc3-fc52c780c6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e5af142cf6a62512e01292ccc42d9d 2x, https://si.imgix.net/1340b158/uploads/origins/98157d05-9e50-49a0-8dc3-fc52c780c6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ceef8bdfaf0a75afe06b7745f077d4d1 3x", "genre": "art", "nsfw": true, "body": "簡単な絵で良いのですが\n・下着上下とガーターベルト着用の加藤さん\n・加藤さんに勧められて甘ロリ、又はゴスロリっぽい可愛い下着上下&ガーターベルトを着てみたもこっち\nというイラストをお願いできませんか？\n\n「智ちゃん良く似合ってる♪」「そ、そうかな。へへ・・・」という感じのウキウキした加藤さんと、ちょっと恥ずかしそうにしてるもこっち、という感じで見てみたいです。", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/12", "thumbnail_src": "https://si.imgix.net/f0944cf2/uploads/origins/ce58a42c-33ce-489f-b9e4-ebeea8de7b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09654725f2254a0f639be02db995c5f4", "thumbnail_srcset": "https://si.imgix.net/f0944cf2/uploads/origins/ce58a42c-33ce-489f-b9e4-ebeea8de7b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09654725f2254a0f639be02db995c5f4, https://si.imgix.net/f0944cf2/uploads/origins/ce58a42c-33ce-489f-b9e4-ebeea8de7b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d5cf86597186a86f2fb0058a09135ee 2x, https://si.imgix.net/f0944cf2/uploads/origins/ce58a42c-33ce-489f-b9e4-ebeea8de7b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0f768165b956022cc5f170fd4ea913b 3x", "genre": "art", "nsfw": true, "body": "すみません、誤字ったのであげ直します！\n\nもこっちの部屋でもこっちと加藤さんがえっちしてたら、知らずに「智子ー、遊ぼうぜー」と入ってきた吉田さん。\nふたりの姿を見て真っ赤になって絶句する吉田さん、慌てるもこっち、何故か落ち着いてる加藤さん、というシチュエーションをお願い出来ますか？\n\n又は、吉田さんが智貴くんに「部活あるから、先帰って姉ちゃんと遊んどいて」と、部屋に入ろうと声をかけようとしたら、中からふたりのえっちしてる声が聞こえて、ドアの前で真っ赤になって混乱してる、というのはどうでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@osumoto1/works/11", "thumbnail_src": "https://si.imgix.net/ce55c097/uploads/origins/eccdcade-be5c-4798-8b15-36f5079894f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efdac0ddfcc5373de4e6bf2fbfe81bd6", "thumbnail_srcset": "https://si.imgix.net/ce55c097/uploads/origins/eccdcade-be5c-4798-8b15-36f5079894f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efdac0ddfcc5373de4e6bf2fbfe81bd6, https://si.imgix.net/ce55c097/uploads/origins/eccdcade-be5c-4798-8b15-36f5079894f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2405a18261b443999d16db9d11ab0fd7 2x, https://si.imgix.net/ce55c097/uploads/origins/eccdcade-be5c-4798-8b15-36f5079894f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b18852eb6a18bc6e0017d54c3aba1e42 3x", "genre": "art", "nsfw": true, "body": "以前描かれていた「吉田さんと智貴が付き合ってる世界線」の設定がとても良い感じでしたので、それをお願いしても良いですか？\n\nもこっちに何か余計な事吹き込まれた吉田さんが\n「まだエッチは怖いから出来ないけど、智貴がガマンするの辛いなら、フェラ・・・なら、やってみる」\nと、涙目で顔を真っ赤にしてとんでもない事を言い出して\n智貴はドキドキしつつも「(あの馬鹿、何吹き込んだんだ・・・殺す！)」\nと心の中で怒ってる\n\nというようなシーンをお願いします！", "created_at": "", "completed_at": ""}]}