ed_at": "", "completed_at": ""}, {"path": "/@kazamimimi/works/19", "thumbnail_src": "https://si.imgix.net/97c349a0/uploads/origins/73d00f71-485d-4747-99f4-22a0c1b16e79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=726bb2cbc9670c4255c91e40c9ec1753", "thumbnail_srcset": "https://si.imgix.net/97c349a0/uploads/origins/73d00f71-485d-4747-99f4-22a0c1b16e79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=726bb2cbc9670c4255c91e40c9ec1753, https://si.imgix.net/97c349a0/uploads/origins/73d00f71-485d-4747-99f4-22a0c1b16e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be56d9ba7d563cd136709703fbac0720 2x, https://si.imgix.net/97c349a0/uploads/origins/73d00f71-485d-4747-99f4-22a0c1b16e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f4d2030cac7d21e84a1fde159f0ee2b 3x", "genre": "art", "nsfw": true, "body": "初めまして、初めてリクエストを送らせていただきます。 数年前にあなたの描かれていたミコッティさんのイラストをお願いしてもよろしいでしょうか？  シチュエーションや構図などとしましては、 ・水操作の練習をしている時に、何故かいつもより粘りが強くなってしまい、全身ネバネバで動けない状態 ・服装はいつもの魔道士的な服(資料)か、イメチェン後(https://twitter.com/kazamimimi/status/974754427436453888?s=21)、もしくは裸 ・ギャグ的な顔よりは、上手くいかずにムスッとした表情か、不甲斐なく苦笑いといった表情で、恥ずかしいのか頬を赤くさせてる ・宛名やメッセージなどは絵に入れない  といった感じでお願いしたいです。  初めてのリクエストですが、何卒よろしくお願い致します。\n\n設定ミスで、一度再送させて頂きました。\n\nhttps://twitter.com/kazamimimi/status/761177735649632257?s=21", "created_at": "", "completed_at": ""}, {"path": "/@kazamimimi/works/18", "thumbnail_src": "https://si.imgix.net/07868516/uploads/origins/e25087cf-b3e2-47f2-b378-be5b9afc98a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=669e611f31cb02995e526313cf771d67", "thumbnail_srcset": "https://si.imgix.net/07868516/uploads/origins/e25087cf-b3e2-47f2-b378-be5b9afc98a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&t