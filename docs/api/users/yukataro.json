描きましたが、責め手の描写は最低限で大丈夫です（描いても良いです）\n着衣電マって良いですよね……（Fanbox見ました）", "created_at": "", "completed_at": ""}, {"path": "/@yukataro/works/144", "thumbnail_src": "https://si.imgix.net/29079f55/uploads/origins/a5b161a1-4ad5-41e1-ab00-4f6d230fa4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a729121417d2e5ca134148849ed8e36", "thumbnail_srcset": "https://si.imgix.net/29079f55/uploads/origins/a5b161a1-4ad5-41e1-ab00-4f6d230fa4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a729121417d2e5ca134148849ed8e36, https://si.imgix.net/29079f55/uploads/origins/a5b161a1-4ad5-41e1-ab00-4f6d230fa4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5a5b6f70be59ef9f73f574492384ada 2x, https://si.imgix.net/29079f55/uploads/origins/a5b161a1-4ad5-41e1-ab00-4f6d230fa4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f180ebf0a800fa2fdcc5b02a97b30d4 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yukataro/works/143", "thumbnail_src": "https://si.imgix.net/69a04424/uploads/origins/a9cca2e5-ed0a-4d6a-98d5-caa137959f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7adc41bda523bcd1f98f9262b43ce65a", "thumbnail_srcset": "https://si.imgix.net/69a04424/uploads/origins/a9cca2e5-ed0a-4d6a-98d5-caa137959f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=3