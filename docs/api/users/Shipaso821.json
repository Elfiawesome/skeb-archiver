e%2Ccenter&txtsize=30&txt=PRIVATE&s=582350b373f106ce4901d2a8a63a81f4 2x, https://si.imgix.net/428c2075/uploads/origins/ddf851b8-0669-408b-b281-c99a61699f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1ffa173630fce031ac2af6afafef076 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Shipaso821/works/95", "thumbnail_src": "https://si.imgix.net/54698d29/uploads/origins/3d5a85ca-70c4-470f-8a37-214abaf14724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cc05fabb2e795024a5347edd332f685", "thumbnail_srcset": "https://si.imgix.net/54698d29/uploads/origins/3d5a85ca-70c4-470f-8a37-214abaf14724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cc05fabb2e795024a5347edd332f685, https://si.imgix.net/54698d29/uploads/origins/3d5a85ca-70c4-470f-8a37-214abaf14724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27654a65a6bc4bf3037bc722bd3cafbe 2x, https://si.imgix.net/54698d29/uploads/origins/3d5a85ca-70c4-470f-8a37-214abaf14724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d82ff6d55a2cdbf0303bd72c9463018 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nキタカミ姉弟とメダロットのイラストを拝見してリクエストしました。\nポケモンSVのダウンロードコンテンツで出てきたゼイユを描いて欲しいです。詳細は以下のとおり\n・ゲームで出てきた甚平姿\n・縁側でお祭り用のペディキュアを塗っている姿\n（色やデザインはお任せします）\n※本編中でネイルしてる描写はありませんが、脚長いからペディキュア似合うかなと思いました。", "created_at": "", "completed_at": ""}, {"path": "/@Shipaso821/works/94", "thumbnail_src": "https://si.imgix.net/04c37359/uploads/origins/8d7929aa-e105-414e-b19c-65590357a08b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9d8ee2274c63803a638e3d7f91f0f23", "thumbnail_srcset": "https://si.imgix.net/04c37359/uploads/origins/8d7929aa-e105-414e-b19c-65590357a08b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9d8ee2274c63803a638e3d7f91f0f23, https://si.imgix.net/04c37359/uploads/origins/8d7929aa-e105-414e-b19c-65590357a08b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd859153b7105f82ceec99a98d7dba83 2x, https://si.imgix.net/04c37359/uploads/origins/8d7929aa-e105-414e-b19c-65590357a08b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c383ea20d29a982ea0e7f2fbbfc4f79 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n\nまた依頼をしてもよろしいでしょうか？\n\nこちらの糸式博士なのですが、\nhttps://x.com/sadant_voiro/status/1808235809042227358?s=46&t=cpxqYo4We82DPalmvZiQWQ\n\n水着の全身イラストをお願いしたいと思います。\n•見た目\n白衣を羽織っている水着で、水着のデザインは緑と黒の大人っぽいデザインでお任せします。\n胸に掛けてるメガネは頭にかけて、今回は髪型をポニーテールでお願いします。\n片腕にメダロッチを付けて、どちらかの手にポケモンのダイブボールを所持。\n\nポーズ\nアングルは最初に描いて頂いた様に正面\n表情は両目を開けたにっこり笑顔\nポーズは最初描いて頂いたような真っ直ぐ立ちで、なるべく水着が全部見える様な可愛いポーズをお任せします。\n\n•可能なら差分\n黄金ビキニ\nダイブボール無し\nメダロット無し\n\nすみません、また宜しければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Shipaso821/works/93", "thumbnail_src": "https://si.imgix.net/af729780/uploads/origins/0eb8c4d9-3eef-48af-af61-57355570a42c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effdfec349a9847f830d693719c51fb3", "thumbnail_srcset": "https://si.imgix.net/af729780/uploads/origins/0eb8c4d9-3eef-48af-af61-57355570a42c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effdfec349a9847f830d693719c51fb3, https://si.imgix.net/af729780/uploads/origins/0eb8c4d9-3eef-48af-af61-57355570a42c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8142606e435fc75766f807eee6fb9029 2x, https://si.imgix.net/af729780/uploads/origins/0eb8c4d9-3eef-48af-af61-57355570a42c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54e02ef03b53115b2dace423a87bf45d 3x", "genre": "art", "nsfw": false, "body": "pixivで見るポケモンと閃乱カグラのクロスオーバー、「ポケモンカグラ」\nキャラクターは\n・飛鳥(閃乱カグラ)\n・ゲッコウガ\n・焔(閃乱カグラ)\n・ガブリアス♂\n水着は白ビキニ\n場所は温水プールではしゃいでるイラストをお願いします\n輪郭線極力細目\n※pixivでタグを付ける時に(閃乱カグラ