fFZD36t-vXdttrnsRHvSYz18xQ46ZHsTdu）の僕が改変したおデブ体型のフォシュニアくんにぴっちりバニースウツを着せたイラストをお願いしたいです\n\nバニースウツのデザインなどはお任せします\nメガネなど着けちゃったり細かいアクセサリーとか自由にしてもらって大丈夫です！\n細かいフェチ要素として バニースウツ越しにお腹のだらしなみのある感じがあれば良いです…！\n体型が大きく 描きづらい等あれば多少体型を変えて頂いても大丈夫です！\nあとは細かい構図表情などお任せします！\n\n良ければ依頼の方検討よろしくお願いします！🙏\n 資料用デブフォシュです （https://drive.google.com/drive/folders/1HO9LXG1N8lpH4GUEpi-DtG_--ToKfW8Q?usp=drive_link）", "created_at": "", "completed_at": ""}, {"path": "/@yuppi_TBTB2/works/31", "thumbnail_src": "https://si.imgix.net/dcf7f525/uploads/origins/a53436cb-7c25-4baa-9706-7ef047b3fa0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08f81a7418917647750be551489e4c9f", "thumbnail_srcset": "https://si.imgix.net/dcf7f525/uploads/origins/a53436cb-7c25-4baa-9706-7ef047b3fa0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08f81a7418917647750be551489e4c9f, https://si.imgix.net/dcf7f525/uploads/origins/a53436cb-7c25-4baa-9706-7ef047b3fa0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8413ceeb9a65c563ed7cad27cf0ee6 2x, https://si.imgix.net/dcf7f525/uploads/origins/a53436cb-7c25-4baa-9706-7ef047b3fa0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46f31b1a3146105532675110f9cd248d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuppi_TBTB2/works/30", "thumbnail_src": "https://si.imgix.net/7607359e/uploads/origins/89dec68e-1a6b-4cd8-a9e3-c6359465d1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2