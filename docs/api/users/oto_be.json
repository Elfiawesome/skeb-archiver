E」を描いてほしいです。ギターはヘッドレスで、シールや絵の具で自由にデコレーションしてください。\n\n参考資料\nキャラクター：https://drive.google.com/drive/folders/1nxCHloSD3wvnYDQvTmXzrKKfya6LYfcJ?usp=sharing\nギター：https://strandbergguitars.com/product/boden-original-nx-6-natural-flame/", "created_at": "", "completed_at": ""}, {"path": "/@oto_be/works/13", "thumbnail_src": "https://si.imgix.net/b4dca537/uploads/origins/63b2f978-1205-4f5f-934e-34036941e8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ef3252f9c3568e77c24829e976b5468", "thumbnail_srcset": "https://si.imgix.net/b4dca537/uploads/origins/63b2f978-1205-4f5f-934e-34036941e8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ef3252f9c3568e77c24829e976b5468, https://si.imgix.net/b4dca537/uploads/origins/63b2f978-1205-4f5f-934e-34036941e8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b5fd43ce901ad4d4afff9a61797d6a2 2x, https://si.imgix.net/b4dca537/uploads/origins/63b2f978-1205-4f5f-934e-34036941e8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb51ddad108859f18ad9fa5c1988b881 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oto_be/works/12", "thumbnail_src": "https://si.imgix.net/a0d3340b/uploads/origins/02213d5f-b470-4f23-a630-b4191aa87a50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29665a9ad2b4e6118778c51e2b8c1c32", "thumbnail_srcset": "https://si.imgix.net/a0d3340b/uploads/origins/02213d5f-b470-4f23-a630-b4191aa87a50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29665a9ad2b4