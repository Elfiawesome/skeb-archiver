.net/0ac0b8cf/uploads/origins/fe77f76e-7ab1-4ed9-946e-50daa1deb026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11088a62cda8c6d6dddf1c14f14a4061", "thumbnail_srcset": "https://si.imgix.net/0ac0b8cf/uploads/origins/fe77f76e-7ab1-4ed9-946e-50daa1deb026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11088a62cda8c6d6dddf1c14f14a4061, https://si.imgix.net/0ac0b8cf/uploads/origins/fe77f76e-7ab1-4ed9-946e-50daa1deb026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d0fa172619a269f848ce4c5988f2691 2x, https://si.imgix.net/0ac0b8cf/uploads/origins/fe77f76e-7ab1-4ed9-946e-50daa1deb026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46129a119891eb77c3cbd868ce2754d3 3x", "genre": "art", "nsfw": false, "body": "お世話になっております\n前回・前々回ともに素敵なイラストを\n描いてくださいましてありがとうございました\n\nさて今回は\n風斬はなこ、来たる三月に\nデビュー一周年用のイラストを\nお願いしたく思います\n\n構図等は以前同様お任せ致します\n若干お時間がタイトとなってしまい\n大変申し訳こざいませんが\n何卒宜しくお願い申し上げます\n\nなお、以前も申し上げましたが\n依頼者は「りゅーけい」名義にて\nお願い申し上げます", "created_at": "", "completed_at": ""}, {"path": "/@oto_be/works/3", "thumbnail_src": "https://si.imgix.net/4f569ad9/uploads/origins/ee967557-653d-4014-b4c3-d551272bd1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5d0b6ed33644a391f51d1863ed0522", "thumbnail_srcset": "https://si.imgix.net/4f569ad9/uploads/origins/ee967557-653d-4014-b4c3-d551272bd1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5d0b6ed33644a391f51d1863ed0522, https://si.imgix.net/4f569ad9/uploads/origins/ee967557-653d-4014-b4c3-d551272bd1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6784aee012fbf62781a37866c1fd5f4 2x, https://si.imgix.net/4f569ad9/uploads/origins/ee967557-653d-4014-b4c3-d551272bd1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7aada04bacd455a91f0ff2e268ffea4 3x", "genre": "art", "nsfw": false, "body": "音部屋様\n\n初めまして、Vtuber活動をしておりますTY TY TYと申します。\nこの度は音部屋様の素晴らしいイラストが気に入り、ぜひとも私「TY TY TY」のイラストを描いていただきたく、リクエストを送らせていただきました。\n依頼内容は下記にて記載いたしますので、ご確認よろしくお願いいたします。\n\n\n【ご依頼内容】\n1.リクエストキャラクター\n「TY TY TY」\n\n\n2.構図、ポーズ等\n目を閉じギターを弾いている姿\n全身を描いてほしい\n胸をギターで隠さないでほしい\n音部屋様へ参考資料.jpg\nhttps://drive.google.com/file/d/1X5PEFrS1x4OcUjSdij_t7gWuJj8TF9a7/view?usp=share_link\n\n\n3.表情\n目をつぶり優しく微笑んでいる\n\n\n\n4.その他\n・YoutubeのサムネやTwitterなどのSNSなどで使用する予定です\n・頭の先や左右の両サイドは見切れないようにお願いします\n・縦長サイズで背景の透過されたPNG形式ファイルも同封していただけると助かります\n\n\n以上、お手数ですがご確認及びご検討をよろしくお願いいたします。\n\nhttps://www.nicovideo.jp/watch/sm6247714\nhttps://drive.google.com/drive/folders/1U7gMZ8nLZd58DymOm20G_mOG9IRvFP59\nhttps://www.youtube.com/channel/UCbwzwmai1fcjhLXtotbH63g\nhttps://twitter.com/hitorihhh\n\nhttps://drive.google.com/file/d/1X5PEFrS1x4OcUjSdij_t7gWuJj8TF9a7/view?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@oto_be/works/2", "thumbnail_src": "https://si.imgix.net/3a06c794/uploads/origins/b463c44b-5f0e-4e03-a44e-11d08f18766b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e039507b78c892817d25d5e9426077", "thumbnail_srcset": "https://si.imgix.net/3a06c794/uploads/origins/b463c44b-5f0e-4e03-a44e-11d08f18766b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e039507b78c892817d25d5e9426077, https://si.imgix.net/3a06c794/uploads/origins/b463c44b-5f0e-4e03-a44e-11d08f18766b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92133ebea1fc21a2886b3a44062e859f 2x, https://si.imgix.net/3a06c794/uploads/origins/b463c44b-5f0e-4e03-a44e-11d08f18766b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=887ff5c10bfd5306df3820edd7e87f94 3x", "genre": "art", "nsfw": false, "body": "お世話になっております\n\n先日は素敵なイラストを描いてくださり\nありがとうございました\n\nつきましては前以てという形になりますが\n登録者数１００００人達成記念配信が\nこの先あると見越した上で、その際に使用する\nイラストを依頼させていただきます\n\nなにやら…実写化という方向に\n進む様相を呈しておりますが、そこはそれ\nやはり二次元描写も大事ですよね、と\nいうことで\n\nお忙しいなかお手数おかけ致しますが\nどうぞ宜しくお願い申し上げます\n\n\n\n追伸\n先日同様、依頼者は「りゅーけい」名義にて\nご対応いただけますでしょうか", "created_at": "", "completed_at": ""}, {"path": "/@oto_be/works/1", "thumbnail_src": "https://si.imgix.net/957da5fb/uploads/origins/b27a715a-4210-4f4b-a836-30499568c52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fed5b50d252c478f598fe7b8723a1e1", "thumbnail_srcset": "https://si.imgix.net/957da5fb/uploads/origins/b27a715a-4210-4f4b-a836-30499568c52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fed5b50d252c478f598fe7b8723a1e1, https://si.imgix.net/957da5fb/uploads/origins/b27a715a-4210-4f4b-a836-30499568c52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5580b578d51d3f1888500df248a447ee 2x, https://si.imgix.net/957da5fb/uploads/origins/b27a715a-4210-4f4b-a836-30499568c52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05a00cd50fe8340f1c9fe69380fe3e57 3x", "genre": "art", "nsfw": false, "body": "音部屋さま\n\nお世話になります\nツイッターではこういち\nグーグルアカウントではりゅーけいと名乗っている者です\n\n風斬はなこちゃんのところなどでイラストを拝見させていただいて\nとても素敵な絵師さんだなと感服しております\n\nつきましてはイラストの依頼をさせていただきたく思いまして\nこうしてコンタクトさせていただきました\n\nいま考えているのは八月七日の誕生日配信の際に使用するであろうものと\n10000人突破記念配信の際に使用すると思われるものの二点です\nとはいえ、こういった依頼をさせていただく機会がなかったもので\n予算がいかほどといったことも含め分からないことだらけでして\nお手数なのですがお見積もりをお願いできればと思います\n\nそれでは用件のみで恐縮ではございますがこの辺にて失礼致します", "created_at": "", "completed_at": ""}]}