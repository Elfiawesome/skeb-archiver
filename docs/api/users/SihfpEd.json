9a7-af9e-af49e153e3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35022145c3d64f7cf10c351839e19c4f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/7", "thumbnail_src": "https://si.imgix.net/5a234b34/uploads/origins/8d0cabb5-ef77-4e03-a991-5dc8067f2c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca6e2489c6cacb14b9be53a1471c8cbd", "thumbnail_srcset": "https://si.imgix.net/5a234b34/uploads/origins/8d0cabb5-ef77-4e03-a991-5dc8067f2c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca6e2489c6cacb14b9be53a1471c8cbd, https://si.imgix.net/5a234b34/uploads/origins/8d0cabb5-ef77-4e03-a991-5dc8067f2c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fb968ac10a7625ab5951c3a9c8b8e27 2x, https://si.imgix.net/5a234b34/uploads/origins/8d0cabb5-ef77-4e03-a991-5dc8067f2c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29c1268367d496dffef929c728c304b9 3x", "genre": "art", "nsfw": false, "body": "ユーレイ様初めまして。\n仄暗くスタイリッシュな色遣いや素敵な構図に惹かれてリクエストさせていただきました。\n\nよろしければ私と友人のOCを描いていただきたいです。\n構図など全てお任せで、描きやすいように描いていただければ幸いです。資料を添付しておりますが、わからない点は好きに描いていただいて構いません。\n簡単な設定はいかに記載いたしました。\n金額不足などございましたらお手数ですが再送いただければ修正致します。\n何卒ご検討いただけましたら幸いです。よろしくお願いいたします。\n\n\n＜詳細＞\n・赤髪の少女\n148cm/10代後半/国家公務員\n体型はほどよく引き締まっていて豊満。瞳孔は常に開いており、顔は包帯で半分ほど隠されている。\n\n戦闘狂。国家権力として働くにつれて強きを挫くことに愉しみを見出していった。\n休暇も鍛錬と研究に時間を費やしている。人に戦いを仕掛けるのが好きで、よく殺し合おうとする。男前。\n\n\n・金髪の少女\n17〜19歳くらい\nくすんだ金髪にくすんだ金眼、目の下にはクマ、体型は痩せ型。\n\nなかなか口が悪く態度も悪い。可憐な容姿を歯牙にもかけず、あぐらをかいてガニ股で歩いて足ガン開きで座るような性格。しかしその実メンヘラっぽいところがある。男前。\n\n\n<関係性>\n協力したり殺し合いかけたりする妙な関係性だが、互いに信頼があり、唯一無二の相棒のようなもの。\n\nhttps://drive.google.com/drive/folders/1AKiR7-4wzCYWiVWNgOpf6zXfkzb7od9X", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/6", "thumbnail_src": "https://si.imgix.net/1f4fe923/uploads/origins/2de99cee-e265-4641-b693-a412e69e8011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29db368d96f296b79e9589412dc9b222", "thumbnail_srcset": "https://si.imgix.net/1f4fe923/uploads/origins/2de99cee-e265-4641-b693-a412e69e8011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29db368d96f296b79e9589412dc9b222, https://si.imgix.net/1f4fe923/uploads/origins/2de99cee-e265-4641-b693-a412e69e8011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47f801b02b5fbf60e31e3ad675b1718d 2x, https://si.imgix.net/1f4fe923/uploads/origins/2de99cee-e265-4641-b693-a412e69e8011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dbf83231b9bd8de8762371d6fa822c6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、また来ました！この前のイラストはとても素晴らしいので、是非もう一度私のキャラクターを描いてください。今回依頼したいのは、「VOID」のPCです。\n\n人物設定\n30歳の警察官で、いつも微笑んでいます。仕事も上手にこなしていますし、困ったときにはすぐに助けてくれますし、後輩の面倒もよく見てくれます。他の人から見ると、かっこよくて優しくて、頼りがいのある女性に見えます。\n彼女は大人っぽくて頼もしい感じがします。\n胸カップはBカップくらいです。\n\n依頼内容\nよければ、https://skeb.jp/@SihfpEd/works/5のように、等身一枚とSD一枚を描いていただけますか。\n構図、ポーズ等は自由に決めてください！服の色や細かい所も変更してもいいです。\n可能でしたらい制服を着ている（外は制服、中は白いシャツに黒いネクタイ、ボトムスはパンツスーツ、靴は革靴です）と着ていないの差分はあればとても嬉しいです。\n\n資料\nhttps://drive.google.com/drive/folders/121EKrAVzxee6hJHuQ5g9IjPsyap3KSmb\n\n可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。\n日本人ではないので、失礼なことを言ったら申し訳ありません。どうかよろしくお願いします！もし、お気に召さない場合は、キャンセルしても構いませんです。金額的に無理でしたら、変更して下っさて構いません", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/5", "thumbnail_src": "https://si.imgix.net/9fa83291/uploads/origins/f1c279d3-a8e0-4557-8b9d-d55b55f4b597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b07eda9d40db9964bdf22b66f9764beb", "thumbnail_srcset": "https://si.imgix.net/9fa83291/uploads/origins/f1c279d3-a8e0-4557-8b9d-d55b55f4b597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b07eda9d40db9964bdf22b66f9764beb, https://si.imgix.net/9fa83291/uploads/origins/f1c279d3-a8e0-4557-8b9d-d55b55f4b597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6da4cec3a3857ce12cc4ba721b3fd674 2x, https://si.imgix.net/9fa83291/uploads/origins/f1c279d3-a8e0-4557-8b9d-d55b55f4b597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d7cdda097c0b081ac2dcb81aeb63c29 3x", "genre": "art", "nsfw": false, "body": "こんにちは、また来ました！手数料無料期間なのでリクエストしたいです。よければ、キャラクターのイラストを描いていただけますか？\n\n人物設定\n警察官で、男性だが中性的で細身であるため、時々女性と間違えられることがある。雰囲気的にはかっこいいお姉さんという感じ。(かっこいいお姉さんのような描けばいいです)\n仕事に対して全くまじめである。普段は笑顔で誰にでも優しいが、犯罪者には凶暴な面を見せる。\n\n依頼内容\nよければ、https://skeb.jp/@SihfpEd/works/2のように、等身一枚とSD一枚を描いていただけますか。\n構図、ポーズ等は自由に決めてください！服の色や細かい所も変更してもいいです。\n可能でしたらい制服を着ていると着ていないの差分はあればとても嬉しいです。\n\n資料\nhttps://drive.google.com/drive/folders/121EKrAVzxee6hJHuQ5g9IjPsyap3KSmb\n\n可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。\n日本人ではないので、失礼なことを言ったら申し訳ありません。どうかよろしくお願いします！もし、お気に召さない場合は、キャンセルしても構いませんです。金額的に無理でしたら、変更して下っさて構いません", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/4", "thumbnail_src": "https://si.imgix.net/ce86b9a9/uploads/origins/98863b17-1af5-4d4e-9186-2a208ae1b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba667848592a027badb3ee9660da7b4a", "thumbnail_srcset": "https://si.imgix.net/ce86b9a9/uploads/origins/98863b17-1af5-4d4e-9186-2a208ae1b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba667848592a027badb3ee9660da7b4a, https://si.imgix.net/ce86b9a9/uploads/origins/98863b17-1af5-4d4e-9186-2a208ae1b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff907be6270e51d11b6d0523990ab89b 2x, https://si.imgix.net/ce86b9a9/uploads/origins/98863b17-1af5-4d4e-9186-2a208ae1b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d1603c6e0dba0d5d116824479eba0ae 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。ユーレイさんの作品はとても素晴らしいです！もしよければ、私のオリジナルキャラクターの新しいの服をデザインしてくれませんか？\n\n人物設定\n男ですか見た目は女（男の娘のような、女性として描くでいい）。黒に近い濃紺の髪にピンク色の瞳。\n丸縁の眼鏡をかけている\nいつもにこにこしていて、親しみやすく優しい感じがします。\n家は除霊の家系で、見た目は普通の女学生だがとても強い除霊師である。\n武器は日本刀。\n\n可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。\n日本人ではないので、失礼なことを言ったら申し訳ありません。どうかよろしくお願いします！もし、お気に召さない場合は、キャンセルしても構いませんです。\n\nhttps://drive.google.com/drive/folders/17hlKlqu8NdCSzulr9xd2GglfU_90rcwl", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/3", "thumbnail_src": "https://si.imgix.net/e24aea11/uploads/origins/baf0f470-cc03-4261-b357-f69c7d6ecf41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8218ee3c339fd768770ed549bffde95", "thumbnail_srcset": "https://si.imgix.net/e24aea11/uploads/origins/baf0f470-cc03-4261-b357-f69c7d6ecf41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8218ee3c339fd768770ed549bffde95, https://si.imgix.net/e24aea11/uploads/origins/baf0f470-cc03-4261-b357-f69c7d6ecf41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fd2c9bcc1d238e8adc2a697340cf6f7 2x, https://si.imgix.net/e24aea11/uploads/origins/baf0f470-cc03-4261-b357-f69c7d6ecf41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=565d10d294cdd866049f661112efb28b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/2", "thumbnail_src": "https://si.imgix.net/1b31a1e5/uploads/origins/845a9f35-238d-43b2-a498-78f89d9a04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2debf69642fd19186c00c36822055e21", "thumbnail_srcset": "https://si.imgix.net/1b31a1e5/uploads/origins/845a9f35-238d-43b2-a498-78f89d9a04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2debf69642fd19186c00c36822055e21, https://si.imgix.net/1b31a1e5/uploads/origins/845a9f35-238d-43b2-a498-78f89d9a04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=313a6469f99dd76248bbdcf29dbbf9e7 2x, https://si.imgix.net/1b31a1e5/uploads/origins/845a9f35-238d-43b2-a498-78f89d9a04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ad29e165902ec9ee1d7a05ce586032a 3x", "genre": "art", "nsfw": false, "body": "どうも初めまして！\n新着イラストでとても素敵なイラストでしたので是非ともお願いいたします。\n\nよろしければうちの子のイラストをお願いいたします。\nシチュエーション構図等全てお任せします。\n\n用途としましては私のSNSのアイコンやヘッダーなどを想定しております。\n\n可能であれば宛名、背景、キャラクターを分けたデータで納品して頂けると幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/173XhG-nuwYB7vMZr1yR5TfqXQbxFJHbA?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@SihfpEd/works/1", "thumbnail_src": "https://si.imgix.net/d5cabf66/uploads/origins/b666b717-efc6-44d3-b460-908713ce15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb56b7fd6717ce3c00901e76fcdd72e", "thumbnail_srcset": "https://si.imgix.net/d5cabf66/uploads/origins/b666b717-efc6-44d3-b460-908713ce15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb56b7fd6717ce3c00901e76fcdd72e, https://si.imgix.net/d5cabf66/uploads/origins/b666b717-efc6-44d3-b460-908713ce15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=733c5437833e4a88a94a20b900e094fd 2x, https://si.imgix.net/d5cabf66/uploads/origins/b666b717-efc6-44d3-b460-908713ce15e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d683d359e885ba52f9d0fdbfa07e6cb0 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\ntwitterで雰囲気や表情が刺さる素敵なイラストを拝見し、\n依頼させていただきました。\n依頼内容はVRChatで使用しているアバターのイラストになります。\n\n構図などはお任せしますが、雰囲気はミステリアスで一人称がぼくの女の子、をイメージしていただけると嬉しいです。\n服装や髪型、アクセサリー等はアレンジしていただいてもかまいません。\n\n資料は以下になります。\n\nhttps://twitter.com/no_oyatsu/status/158451