mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3b181c82a5285913ddc4576552c456f 2x, https://si.imgix.net/9af6ee0e/uploads/origins/11020f2a-a104-4608-a417-1786dc15ae9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f05357496a0e4c9e3a181574e30ae255 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@482_air/works/38", "thumbnail_src": "https://si.imgix.net/20719b60/uploads/origins/d8b41942-ef88-4178-b58a-d380792452b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c68f057d5ff7a761829b44b03e097a4", "thumbnail_srcset": "https://si.imgix.net/20719b60/uploads/origins/d8b41942-ef88-4178-b58a-d380792452b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c68f057d5ff7a761829b44b03e097a4, https://si.imgix.net/20719b60/uploads/origins/d8b41942-ef88-4178-b58a-d380792452b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb4a0053f4f7ad58776010cc28f61ea5 2x, https://si.imgix.net/20719b60/uploads/origins/d8b41942-ef88-4178-b58a-d380792452b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=942a3f4b25abb68688f474abaae4ff89 3x", "genre": "art", "nsfw": false, "body": "わたしのOCキャラ2人のイラストをお願いします。\n\n・1人目　都織\n28歳の女性です。ルーズな格好を好みます。\n\n・2人目　ルビ\n年齢不詳の「猫」です。猫耳が生えているのかどうかはわからないし、人耳が生えているかどうかもわかりません。\n\n2人が寄り添うなど簡単な絡みをしているイラストをお願いしたいです。暗めのニュアンスだと嬉しいです。\n\nまた、服装は参考資料の通りでなくても構いません。渦さんが似合うと感じる服を着せてもらえると嬉しいです。\n\nもし引き受けていただけた場合、秋頃に発行する同人誌に掲載する可能性があります（主体はこの二人のオリジナル小説で、こちらのイラストのためにお金を取ることはありません）\n\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-9PMX0u84r-t7tY_owN0k41Rc5IuuHwt", "created_at": "", "completed_at": ""}, {"path": "/@482_air/works/37", "thumbnail_src": "https://si.imgix.net/38e2c1fa/uploads/or