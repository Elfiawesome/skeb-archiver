nhttps://charaforio.com/ja/ip/sugu_donguri?wiki=%E3%82%A4%E3%83%A9%E3%82%B9%E3%83%88%E9%9B%86", "created_at": "", "completed_at": ""}, {"path": "/@Chien_ao_wan/works/60", "thumbnail_src": "https://si.imgix.net/6e23f27f/uploads/origins/0ab2efcc-8610-46cf-aeaf-583587e86b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=878bc79acec0675d4fb0fa659ea721c0", "thumbnail_srcset": "https://si.imgix.net/6e23f27f/uploads/origins/0ab2efcc-8610-46cf-aeaf-583587e86b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=878bc79acec0675d4fb0fa659ea721c0, https://si.imgix.net/6e23f27f/uploads/origins/0ab2efcc-8610-46cf-aeaf-583587e86b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3d4162ddf4908cacbf582a56778e6e1 2x, https://si.imgix.net/6e23f27f/uploads/origins/0ab2efcc-8610-46cf-aeaf-583587e86b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3304205901ef0b8afcc2d63012fd38f8 3x", "genre": "art", "nsfw": false, "body": "しあんさんお疲れ様です(^^)\n前のオリジナルキャラの文章を参考にして考えて来ましたのでご依頼をさせていただきます(^^)\n髪型は「ショートボブ」髪色は「黒」\n目は「つり目」表情は「ちょっと微笑んでる」感じでお願いします(^^)", "created_at": "", "completed_at": ""}, {"path": "/@Chien_ao_wan/works/59", "thumbnail_src": "https://si.imgix.net/a1fa3feb/uploads/origins/f29fbdcf-1633-46d4-9c1e-fe42a8f189b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=795e0a85ce12f4e713030aa7da218221", "thumbnail_srcset": "https://si.imgix.net/a1fa3feb/uploads/origins/f29fbdcf-1633-46d4-9c1e-fe42a8f189b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=795e0a85ce12f4e713030aa7da218221, https://si.imgix.net/a1fa3feb/uploads/origins/f29fbdcf-1633-46d4-9c1e-fe42a8f189b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14bc904f6b99ecf12e854fb25bc347d7 2x, https://si.imgix.net/a1fa3feb/uploads/origins/f29fbdcf-1633-46d4-9c1e-fe42a8f189b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=