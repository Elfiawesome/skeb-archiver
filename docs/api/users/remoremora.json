54e8/uploads/origins/bedc29e5-9176-4411-b690-d407e48caa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=738fa4d00631b3f5ae5eebc54934eed3 3x", "genre": "art", "nsfw": true, "body": "リクエストをお願いします。\n\nコーヒーをいれるメイドロボさん\n(普段描かれているメイドロボさんでも、他のメイドロボでもかまいません)\n\nメイドロボさんがコーヒー豆を咀嚼して飲み込み、水を飲む\nお腹の中でお湯を沸かしコーヒーを抽出する\nコーヒーカップをスカートの中に入れてコーヒーをそそぐ\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/79", "thumbnail_src": "https://si.imgix.net/d455336e/uploads/origins/b649b4f9-e83d-419f-a36f-d473bbb74b88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca110ac7f4caad34a2f3e39388dbc14c", "thumbnail_srcset": "https://si.imgix.net/d455336e/uploads/origins/b649b4f9-e83d-419f-a36f-d473bbb74b88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca110ac7f4caad34a2f3e39388dbc14c, https://si.imgix.net/d455336e/uploads/origins/b649b4f9-e83d-419f-a36f-d473bbb74b88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9d619dc8c09aa390a386b954174431a 2x, https://si.imgix.net/d455336e/uploads/origins/b649b4f9-e83d-419f-a36f-d473bbb74b88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a610817e58a1f179f7464599a2dea5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/78", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1190533942098714625%2FXFYE4Fxh.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc087c785598db2d10509265412b670a", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1190533942098714625%2FXFYE4Fxh.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc087c785598db2d10509265412b670a, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1190533942098714625%2FXFYE4Fxh.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83837f467055e6182d3c0b8763e37e00 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1190533942098714625%2FXFYE4Fxh.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=096af922c1fa1a7595f92f9d06d37530 3x", "genre": "novel", "nsfw": true, "body": "以下のポストでおっしゃっていた尿意は感じるし我慢は出来るが、「排尿の仕方」だけがわからなくなる催眠の話をお願いします。\nhttps://x.com/remoremora/status/1887674592640258256\n以下のポストに出てきた学園一の美少女であり全校生徒の憧れの生徒会長に催眠をかけておもらしをさせて下さい。汚言症にはかかってない状態でお願いします。\nhttps://x.com/remoremora/status/1994956458266640670\nおもらしするところを人に見られてかわいそうな目に遭ってほしいです。\n誰にどのように催眠をかけられるかはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/77", "thumbnail_src": "https://si.imgix.net/ef7d447c/uploads/origins/d29e278c-c704-4f39-af4b-4afa9a669a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a3632969fbfdf2673c2a9e4cdc1485", "thumbnail_srcset": "https://si.imgix.net/ef7d447c/uploads/origins/d29e278c-c704-4f39-af4b-4afa9a669a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a3632969fbfdf2673c2a9e4cdc1485, https://si.imgix.net/ef7d447c/uploads/origins/d29e278c-c704-4f39-af4b-4afa9a669a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=966ab4e4421f10165b06643e31c2ee4b 2x, https://si.imgix.net/ef7d447c/uploads/origins/d29e278c-c704-4f39-af4b-4afa9a669a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8d9c2e72ca077e922056865e2dce45b 3x", "genre": "art", "nsfw": false, "body": "はじめまして！AZuSaと申します！\n\n今回は、アークナイツのオリジナルオペレーター(二次創作キャラクター)であるオルフェンを描いて頂きたく、依頼させて頂きました！\n\n・本日のログインボーナスと同じ絵柄、同じ雰囲気でお願いしたいです。\n・左上の文字に「毎月一日のログインボーナス」\n・右下に「釜揚げうどん(半額)」\n(毎月一日に丸亀製麺の釜揚げうどんが半額になるため、その日用の物です。)\n\n・中央のオルフェン(資料はURLに添付しております)が、横にいる蟹と一緒に大きな器に入ったうどんを啜っている場面。\n(オルフェンはそもそもうどんが好きで、尚且つ見た目が蟹っぽいとよく言われる為隣に蟹を配置しております。)\n\nもしよろしければですが、描いてくださると嬉しいです！また、毎日のログインボーナスいつも面白くて大好きです！\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1CG3eNREtRdl4B8JFaNOVffQitNB2R3Ph", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/76", "thumbnail_src": "https://si.imgix.net/306f82f3/uploads/origins/57e2a66d-a31a-4c19-8114-f082e1a1e400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9081085181c88ac4e1420c89689a911c", "thumbnail_srcset": "https://si.imgix.net/306f82f3/uploads/origins/57e2a66d-a31a-4c19-8114-f082e1a1e400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9081085181c88ac4e1420c89689a911c, https://si.imgix.net/306f82f3/uploads/origins/57e2a66d-a31a-4c19-8114-f082e1a1e400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c22988fd9e0cc42ac3bf2e3b6ca86be6 2x, https://si.imgix.net/306f82f3/uploads/origins/57e2a66d-a31a-4c19-8114-f082e1a1e400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1cd66b4a83b775987790fa68932d866 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/75", "thumbnail_src": "https://si.imgix.net/aec25ab0/uploads/origins/4158bcbd-fb3f-41eb-aab7-491b8e1771cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d315c3a055135c4101a61ebbc9e1fe", "thumbnail_srcset": "https://si.imgix.net/aec25ab0/uploads/origins/4158bcbd-fb3f-41eb-aab7-491b8e1771cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d315c3a055135c4101a61ebbc9e1fe, https://si.imgix.net/aec25ab0/uploads/origins/4158bcbd-fb3f-41eb-aab7-491b8e1771cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ec0a4d8e81d561a8dfecaab86263044 2x, https://si.imgix.net/aec25ab0/uploads/origins/4158bcbd-fb3f-41eb-aab7-491b8e1771cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4446029555111535b8f42652634f88fe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/74", "thumbnail_src": "https://si.imgix.net/52629c75/uploads/origins/9e4c3f1f-73b4-407d-aa8f-8d946997a6ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baacfcefea34a754d280b08dcbde07d0", "thumbnail_srcset": "https://si.imgix.net/52629c75/uploads/origins/9e4c3f1f-73b4-407d-aa8f-8d946997a6ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baacfcefea34a754d280b08dcbde07d0, https://si.imgix.net/52629c75/uploads/origins/9e4c3f1f-73b4-407d-aa8f-8d946997a6ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d0b55507d7c2dcae63aa84e8047a546 2x, https://si.imgix.net/52629c75/uploads/origins/9e4c3f1f-73b4-407d-aa8f-8d946997a6ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b443e3c7021e1e4baf6b472e8cd059d1 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\nアストラルパーティーよりジャスミンをお願いします。\nナンシー・ローのサイバー攻撃を受け、体内の部品がそこかしこで爆発を起こし、\n特に頭部において後頭部外装が弾け飛んで砕けたマザーボードやHDD・SSD等が飛び出して完全に機能を停止するさまを描いてほしいです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/73", "thumbnail_src": "https://si.imgix.net/3c476de1/uploads/origins/51dd7d66-c07f-4d3e-8743-30eb0d345ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6abd9e0494fe77d2249a029ed2b084", "thumbnail_srcset": "https://si.imgix.net/3c476de1/uploads/origins/51dd7d66-c07f-4d3e-8743-30eb0d345ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6abd9e0494fe77d2249a029ed2b084, https://si.imgix.net/3c476de1/uploads/origins/51dd7d66-c07f-4d3e-8743-30eb0d345ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc30bc1e69502f60b8b7c4fcc8b3c123 2x, https://si.imgix.net/3c476de1/uploads/origins/51dd7d66-c07f-4d3e-8743-30eb0d345ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc52bdc7c588b3128976a5ff27f45af6 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっています。\n\nこちら（https://x.com/remoremora/status/1972292722531963094）の続きで命が助かった安心と混乱とで感情がぐちゃぐちゃになった複雑な笑顔を作った瞬間に床が抜けて今度は本当に吊られてしまうところをお願いします。\n\nそれではご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/72", "thumbnail_src": "https://si.imgix.net/cfa94a28/uploads/origins/b3b3d27d-3d35-43be-afbf-88b6f7efb66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8629d64287083b2de50ba611638c238f", "thumbnail_srcset": "https://si.imgix.net/cfa94a28/uploads/origins/b3b3d27d-3d35-43be-afbf-88b6f7efb66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8629d64287083b2de50ba611638c238f, https://si.imgix.net/cfa94a28/uploads/origins/b3b3d27d-3d35-43be-afbf-88b6f7efb66f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31909e9c37ad15b60d6a18945160e1e8 2x, https://si.imgix.net/cfa94a28/uploads/origins/b3b3d27d-3d35-43be-afbf-88b6f7efb66f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05a13292e555ab017d138b634d524581 3x", "genre": "art", "nsfw": false, "body": "すみません！自動翻訳がなぜかオフになってしまったので再送します！\n\n再びこんにちは。\n\n狐のOC描いてください。またまた角折(ツノ折り)依頼です。\n\n詳細\nサキュバスのコスプレをしています。\n以下の服を着ています。\nhttps://x.com/NiniiDawns/status/1598310494649065472\n両手に壊れたツノを持っている。\n角(ツノ)を頭で支えている。彼女は自分の衣装に合うかどうかを決めている。\n角（ツノ）は不釣り合いだ。\n角（ツノ）は折れたばかり。\n彼女は満足げな笑みを浮かべている。\n\n基本的には、私のキツネが最近、パーティーのサキュバスのコスチュームの一部として使うために、角のある2人からツノを折って盗んできたというツノの折り依頼だ。\n\nそれ以外の細かいことはあなたの自由です。\n\nおまけの狐メモ\nキャラクターメモ\n152cm\n胸は小さいが平らではない（小さめのBカップ）\n氷の魔法と黒魔術の達人\nカリスマ的悪役\n傲慢\n独りよがり\nタバコと無糖紅茶とサディズムが好き\n\nご検討ありがとうございました。\n\nhttps://catbox.moe/c/th7fug", "created_at": "", "completed_at": ""}, {"path": "/@remoremora/works/71", "thumbnail_src": "https://si.imgix.net/63505721/uploads/origins/a852bf5b-05a2-4ce0-bccd-fb24212982e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f298affb08392e261e9962f911e90f54", "thumbnail_srcset": "https://si.imgix.net/63505721/uploads/origins/a852bf5b-05a2-4ce0-bccd-fb24212982e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f298affb08392e261e9962f911e90f54, https://si.imgix.net/63505721/uploads/origins/a852bf5b-05a2-4ce0-bccd-fb24212982e1?bg=%23fff&auto=format%