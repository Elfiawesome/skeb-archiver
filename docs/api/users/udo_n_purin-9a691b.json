7d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f27d651c1db264ea3aaae1dc06a9f49, https://si.imgix.net/34dcb264/uploads/origins/72e8ccd1-f0a1-43b3-9622-59baa260b7d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4e66211bbcd2c11f0ed0eba4bd66f85 2x, https://si.imgix.net/34dcb264/uploads/origins/72e8ccd1-f0a1-43b3-9622-59baa260b7d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02a70f2fc206aa7bb5f7199bfce492b4 3x", "genre": "art", "nsfw": false, "body": "ワタシ御伽ばなシの2DリッチMVに出てくるサラリーマンライラさんを等身サイズで描いてもらえませんでしょうか。\n表情は疲れた感じで、ポーズ等はお任せします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/43", "thumbnail_src": "https://si.imgix.net/bfe55aef/uploads/origins/1599a3e7-fc09-4961-8962-b806d546b686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d064cfe42a17e6685deb107e3bb3a8", "thumbnail_srcset": "https://si.imgix.net/bfe55aef/uploads/origins/1599a3e7-fc09-4961-8962-b806d546b686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d064cfe42a17e6685deb107e3bb3a8, https://si.imgix.net/bfe55aef/uploads/origins/1599a3e7-fc09-4961-8962-b806d546b686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61e211a5447cf8eaca017a21327cfa24 2x, https://si.imgix.net/bfe55aef/uploads/origins/1599a3e7-fc09-4961-8962-b806d546b686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9729a799c9e0bcbe3b8041b7137ae8b5 3x", "genre": "art", "nsfw": false, "body": "はじめまして!\nTwitterで素敵なイラストを拝見しましたので、ぜひ依頼させてください。\n\n個人VTuber ミソラソラさんのイラストを依頼したいです。\n\n使用用途：ファンアートとしてご本人にお渡しします。その後収益化済みのYouTubeチャンネルでのサムネイル、及びTwitterなどへの投稿(スケジュール画像に貼り付ける等の多少の加工も含みます)\n\n\n構図：マイクを持って歌っている姿をお願いします。\n髪の毛の上下左右が切れていない構図だと大変ありがたいです。\n追加でキャラクターのみの透過データもいただけますと幸いです。\nもし予算内であればウインク等の表情差分いただけると嬉しいです！\n\n\n\n資料としてHPとYouTubeCHのURLを添付します。\nHPには三面図や詳細が記載してあります。\nHP：https://lit.link/misorasora\nCH：https://youtube.com/@misorasoraCH\n\n受けていただけると嬉しいです、よろしくお願いします。\n私の名前の記載は不要です。", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/42", "thumbnail_src": "https://si.imgix.net/766e3fb3/uploads/origins/8209167a-f798-42f8-9ee1-7a2b087dff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db5aecaa18d56d7708b24e73a8b45f3", "thumbnail_srcset": "https://si.imgix.net/766e3fb3/uploads/origins/8209167a-f798-42f8-9ee1-7a2b087dff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db5aecaa18d56d7708b24e73a8b45f3, https://si.imgix.net/766e3fb3/uploads/origins/8209167a-f798-42f8-9ee1-7a2b087dff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e6184eb33d363f7b994ddb313335ccb 2x, https://si.imgix.net/766e3fb3/uploads/origins/8209167a-f798-42f8-9ee1-7a2b087dff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62627832d5544ac67aa3f2d7ba20b14d 3x", "genre": "art", "nsfw": false, "body": "いつもイラストを拝見させていただいております。\n前回描いていただいたイラストがとても良かったのでまたお願いをさせてください。\n\n描いていただきたいのはアイドルマスターシャイニーカラーズの大崎甜花ちゃんです。\n『甜ing Room』大崎 甜花のカード絵のライブ衣装を着た姿を藤間さんのイラストで見てみたいです。\n\n資料として公式Youtubeのリンクを記載させていただきます。\n\n見ている側もほっこりとしてしまうような笑顔が素敵な子ですので。笑顔で描いて欲しいくらいで、後の構図等はお任せいただいます。\n\n可能であれば、プロデューサー名刺に使用できる許可も頂けると嬉しいです。\n\nhttps://www.youtube.com/watch?v=GJUrKmvzIhA", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/41", "thumbnail_src": "https://si.imgix.net/67a4218d/uploads/origins/c81b72c4-9f20-42a2-8a09-8a1dbf9d1e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68c56ab4d7e8561be14526e766a7b65", "thumbnail_srcset": "https://si.imgix.net/67a4218d/uploads/origins/c81b72c4-9f20-42a2-8a09-8a1dbf9d1e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68c56ab4d7e8561be14526e766a7b65, https://si.imgix.net/67a4218d/uploads/origins/c81b72c4-9f20-42a2-8a09-8a1dbf9d1e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d7c2109290e1d0e947c8d280b8c657a 2x, https://si.imgix.net/67a4218d/uploads/origins/c81b72c4-9f20-42a2-8a09-8a1dbf9d1e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1901e1a9332b863c13cb803d12bcd8e5 3x", "genre": "art", "nsfw": false, "body": "前回は大変満足する作品をありがとうございました。\n\n今回は悠久のミルククラウン衣装のデレマスの及川雫をお願いします\n依頼理由は藤間さんの及川雫を見てみたいこと\nたぶん５月のデレライブ用の名刺に使うこと（その際はバストアップかなーと考え中）\n\n他詳細な希望（守られていないくてもOKなレベルです）\n・表情はウィンク\n・薄めのリップ\n・ポーズは両手で作るハート（位置などは任せます）\n　　　ここまでは強めのこだわり\n・小物などは足したり引いたりしてもらっても構いません\n・前回みたいな背景パターンあると喜びます", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/40", "thumbnail_src": "https://si.imgix.net/ba52495b/uploads/origins/f3b8b6d8-df56-4289-8850-864b1b33ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deefdbe17adaa597023c6dbe442d58cc", "thumbnail_srcset": "https://si.imgix.net/ba52495b/uploads/origins/f3b8b6d8-df56-4289-8850-864b1b33ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deefdbe17adaa597023c6dbe442d58cc, https://si.imgix.net/ba52495b/uploads/origins/f3b8b6d8-df56-4289-8850-864b1b33ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=895621af55846ba4df0b4a1cda79d3cf 2x, https://si.imgix.net/ba52495b/uploads/origins/f3b8b6d8-df56-4289-8850-864b1b33ae44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=478da14e70f7845eb192a7b1a281417d 3x", "genre": "art", "nsfw": false, "body": "いつもイラストを拝見させていただいております。\n藤間さんが描く大槻唯ちゃんがとても好きなので依頼募集タイミングをずっと待ってました。\n\n描いていただきたいのはグロリアス☆フィーバー！の唯ちゃんをお願いしたいです。\nあの衣装でツインテールの唯ちゃんが可愛すぎるので藤間さんのイラストでぜひ見てみたいです。\n構図はお任せしますが、もしよろしければ、自分のプロデューサー名刺に使用できる許可も頂けると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/39", "thumbnail_src": "https://si.imgix.net/3cb7587f/uploads/origins/d1fb4a22-4cf8-476e-a587-d780fb90567e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9381d7eccabbb77e26fb680094b641a4", "thumbnail_srcset": "https://si.imgix.net/3cb7587f/uploads/origins/d1fb4a22-4cf8-476e-a587-d780fb90567e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9381d7eccabbb77e26fb680094b641a4, https://si.imgix.net/3cb7587f/uploads/origins/d1fb4a22-4cf8-476e-a587-d780fb90567e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f6e024dd841fcb0cf7768f4e3e1368b 2x, https://si.imgix.net/3cb7587f/uploads/origins/d1fb4a22-4cf8-476e-a587-d780fb90567e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86df6207fa210eecc5fc41d45fec0511 3x", "genre": "art", "nsfw": false, "body": "はじめて依頼させていただきます。\n藤間さんの描かれる表情豊かでキラキラした女の子たちが大好きです！\n\n★リクエスト内容\n\nブルーアーカイブの聖園ミカちゃんを、藤間さんの考える『ミカに似合いそうなアイドル風衣装』を着せて描いていただきたいです。\n\n衣装の系統はすべておまかせです。\nミカの羽にある月や星のモチーフがはいっていると嬉しいです！\n\n個人利用、スマホの壁紙に設定したいので『スマホの壁紙にしたいアイドルの写真』のイメージで構図やポーズを決めていただきたいです。\n許可がいただければSNSのアイコンにも利用させていただきまいと思っています！\n\n普段描かれるアイドルたちのように自由に楽しく描いていただけたら幸いです(*^^*)\n\n以上になります。\n是非ご検討よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/38", "thumbnail_src": "https://si.imgix.net/fa4b18a5/uploads/origins/373c49a3-111c-4ecb-b2a8-607cbfccf9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ecc5e799260b3e494f24a48a6deb06c", "thumbnail_srcset": "https://si.imgix.net/fa4b18a5/uploads/origins/373c49a3-111c-4ecb-b2a8-607cbfccf9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ecc5e799260b3e494f24a48a6deb06c, https://si.imgix.net/fa4b18a5/uploads/origins/373c49a3-111c-4ecb-b2a8-607cbfccf9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62d5960bae12f218bab7abadd3b5fb86 2x, https://si.imgix.net/fa4b18a5/uploads/origins/373c49a3-111c-4ecb-b2a8-607cbfccf9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbb2e31e070ae3e238137926eb0ce8c7 3x", "genre": "art", "nsfw": false, "body": "アイドルマスターシンデレラガールズより、綾瀬穂乃香ちゃんをお願いします。ポーズや衣装などはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/37", "thumbnail_src": "https://si.imgix.net/d834dd0c/uploads/origins/8931f0f3-e72c-4057-bd93-8d984db4c95c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55a78847504428102ffa4e1862400d47", "thumbnail_srcset": "https://si.imgix.net/d834dd0c/uploads/origins/8931f0f3-e72c-4057-bd93-8d984db4c95c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55a78847504428102ffa4e1862400d47, https://si.imgix.net/d834dd0c/uploads/origins/8931f0f3-e72c-4057-bd93-8d984db4c95c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=450df0b5f769edafeb0ad33fe2553a91 2x, https://si.imgix.net/d834dd0c/uploads/origins/8931f0f3-e72c-4057-bd93-8d984db4c95c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8794d84d30e4ed2d01b7629d5967ec2f 3x", "genre": "art", "nsfw": false, "body": "初めての依頼になります。\n藤間さんの描く唯ちゃんの瞳の虜になった一人です。\n\nバニー姿で仰向けで足を上げている格好の大槻唯ちゃんを希望です。\nツイッターのヘッダー使用が目的の依頼になります。なのでサイズもそれぐらいの横尺を意識してもらえると助かります。\nもし許可いただけるならアイマスのイベントで配る名刺でも使わせてもらえればなと思ってます。こちらの条件は拒否いただいたうえでの依頼了承いただいてOKです\n\n他詳細な希望（守られていないくてもOKなレベルです）\n・ガーターリングorベルトあり\n・網タイツ（オーバーニーソックスくらいまで）\n　　　ここまでは強めのこだわり\n・スーツの色は黒希望ですが、出来次第で藤間さんがいいと思った色でOKです。むしろもっといい色があったら歓迎\n・ウサ耳は白系や明るい色希望\n・レース付の手袋あるとよい\n・靴はお任せします。迷ったらハイヒールくらい\n・髪型任せます。\n色々注文してますので増額していただいて可です。", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/36", "thumbnail_src": "https://si.imgix.net/3c69ed46/uploads/origins/76eeb85f-6e95-41e5-b828-769fe4198a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769dff9e2fbe9c19452d437e5512dbac", "thumbnail_srcset": "https://si.imgix.net/3c69ed46/uploads/origins/76eeb85f-6e95-41e5-b828-769fe4198a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769dff9e2fbe9c19452d437e5512dbac, https://si.imgix.net/3c69ed46/uploads/origins/76eeb85f-6e95-41e5-b828-769fe4198a63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42684600f50824edb3e02e2ca26ef721 2x, https://si.imgix.net/3c69ed46/uploads/origins/76eeb85f-6e95-41e5-b828-769fe4198a63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d022bafdf80346f30a7d719391b2a21 3x", "genre": "art", "nsfw": false, "body": "藤間さんの描く小関麗奈ちゃんが見たいです！\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/35", "thumbnail_src": "https://si.imgix.net/92e3b22e/uploads/origins/692c081d-9be6-4b7f-a8b9-b50d884c57af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4376ba83374768e9ca34e51f204effab", "thumbnail_srcset": "https://si.imgix.net/92e3b22e/uploads/origins/692c081d-9be6-4b7f-a8b9-b50d884c57af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4376ba83374768e9ca34e51f204effab, https://si.imgix.net/92e3b22e/uploads/origins/692c081d-9be6-4b7f-a8b9-b50d884c57af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bcf597fcbdb835db6f1c67ff9cfbf50 2x, https://si.imgix.net/92e3b22e/uploads/origins/692c081d-9be6-4b7f-a8b9-b50d884c57af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbe412eaeeb259ee94e3d1bba0f985f5 3x", "genre": "art", "nsfw": false, "body": "藤間さんのイラストいつもドキドキ拝見させていただいております🥴\nデレマスの浅利七海ちゃんを描いていただけないでしょうか？\n衣装は、カードイラストの中から藤間さんの好きなものを選んでいただくか、お好きに描いていただくかお任せいたしますm(_ _)m\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/34", "thumbnail_src": "https://si.imgix.net/ea3d3a47/uploads/origins/a462f03f-be41-4f3b-9561-999bdf1ae954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9dd0905a7c276e99ea42c008b9d871a", "thumbnail_srcset": "https://si.imgix.net/ea3d3a47/uploads/origins/a462f03f-be41-4f3b-9561-999bdf1ae954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9dd0905a7c276e99ea42c008b9d871a, https://si.imgix.net/ea3d3a47/uploads/origins/a462f03f-be41-4f3b-9561-999bdf1ae954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=168bc68df9e8bede1a953b05a76be23b 2x, https://si.imgix.net/ea3d3a47/uploads/origins/a462f03f-be41-4f3b-9561-999bdf1ae954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2f8f720e22be7ff82aaeb641b9cd3c4 3x", "genre": "art", "nsfw": false, "body": "Hello, I saw the art you did of my friend Boowow and loved your style!!\n\nI wanted to commission you for a commission of Tomo (me) and my friend Philomena. I would like the pose to be a \"kabedon\" pose of Philomena pushing Tomo against the wall. Tomo is taller than Philomena. Tomo is gyaru, Philomena is a succubus.\n\nPhilomena's facial expression looks flirtatious.\n\nTomo's facial expression looks smug and even more flirtatious, as if she's even more confident than Philomena despite being the one being pushed up against the wall.\n\nTomo is 183cm tall. Philomena is 170cm tall.\n\nThank you so much!\n\n------\n\nこんにちは、私はあなたが私の友人のBoowowの芸術をしたのを見て、あなたのスタイルが大好きになりました！私はTomo（私）と私の友人のフィロメナ(Philomena)を依頼したいと思いました！\n\nTomo（私）と友人のフィロメナ(Philomena)の絵を依頼したいのですが、いかがでしょうか？ポーズは、PhilomenaがTomoを壁に押し付ける「カベドン」のようなポーズを希望しています。にもかかわらずTomoはPhilomenaより背が高い。Tomoの身長は183cm。Philomenaの身長は170cm。Tomoはギャルそして、Philomenaはサキュバスです。\n\nPhilomenaの表情はチャラチャラしているように見える。\n\nTomoの表情はドヤ顔で、Philomena以上にチャラチャラしているように見えますね。\n\nありがとうございます！\n\nhttps://imgur.com/a/kjrBQoC", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/33", "thumbnail_src": "https://si.imgix.net/db970d69/uploads/origins/be2bb111-952a-4d7a-83d9-b2c3e6e628be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54925ac7e2f579d383a4203c5963ef19", "thumbnail_srcset": "https://si.imgix.net/db970d69/uploads/origins/be2bb111-952a-4d7a-83d9-b2c3e6e628be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54925ac7e2f579d383a4203c5963ef19, https://si.imgix.net/db970d69/uploads/origins/be2bb111-952a-4d7a-83d9-b2c3e6e628be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=773b94dc175f0d9a4e127279fa27384d 2x, https://si.imgix.net/db970d69/uploads/origins/be2bb111-952a-4d7a-83d9-b2c3e6e628be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32d9e7d07cb17e366e4e5d3948240677 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\n私のOCであるジゼルとリリーの作品が欲しいです。\n敵対関係にありながら、様々な作戦で何度も出会ううちに、お互いに惹かれ合っていく。\n\nジゼルはスニーキングスーツ、リリーはスパイスーツを着て、作戦中にセックスしてほしいです。武器はオプションでお好みで。\n\nできれば、スーツが開いていたり破れていたりして、胸や性器が露出しているバージョンもお願いします。\n\nその他、細かいことはお任せします。\n\nありがとうございました！\n\nジスール\nhttps://imgur.com/a/aTWHSAL\n\nリリー\nhttps://imgur.com/a/W8WgLMK", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/32", "thumbnail_src": "https://si.imgix.net/d0b0aa1b/uploads/origins/5eb5d12f-1eb5-42bd-9386-66f3dd35d050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cba5f4fc2e984b8630802d37cb578c6", "thumbnail_srcset": "https://si.imgix.net/d0b0aa1b/uploads/origins/5eb5d12f-1eb5-42bd-9386-66f3dd35d050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cba5f4fc2e984b8630802d37cb578c6, https://si.imgix.net/d0b0aa1b/uploads/origins/5eb5d12f-1eb5-42bd-9386-66f3dd35d050?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30879e66deb9b4ce0a83f321d51a6599 2x, https://si.imgix.net/d0b0aa1b/uploads/origins/5eb5d12f-1eb5-42bd-9386-66f3dd35d050?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5074cd14ceabe095a6a48e756e910ab 3x", "genre": "art", "nsfw": false, "body": "はじめてskebお願いします。使用用途はスマホの待ち受けにして愛でる用です。描いて欲しいキャラとシチュですが万が一苦手だったり、描きたくないキャラだった場合に備えて三通り書いておきます(当然現在の作業量やスキルで描けるものどれか1つで大丈夫です)。\n\n①アリスギアアイギスの兼志谷シタラちゃん。エレン(同ゲーム内登場のゾウのキャラクター、アリスギア エレンで検索すれば出ます)のぬいぐるみを抱いているポーズ。服はお任せします(なんならオリでも)。\n\n②NIKKEのルピーちゃん。通常衣装で。ギャルピースだと嬉しいです。\n\n③唯ちゃん。トップスは透け感あってインナーは赤系。ボトムスはパンツなら短パン、スカートなら長めの花柄フレアだと喜びます。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/31", "thumbnail_src": "https://si.imgix.net/8481e175/uploads/origins/4e727773-bd2f-4555-b324-b30bf30208be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a69b56daf8718cee083fb972447770e9", "thumbnail_srcset": "https://si.imgix.net/8481e175/uploads/origins/4e727773-bd2f-4555-b324-b30bf30208be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a69b56daf8718cee083fb972447770e9, https://si.imgix.net/8481e175/uploads/origins/4e727773-bd2f-4555-b324-b30bf30208be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45512fc8809864a24b40d6e4f5a42aef 2x, https://si.imgix.net/8481e175/uploads/origins/4e727773-bd2f-4555-b324-b30bf30208be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71d01676188f40eb96cd911dbc82bf87 3x", "genre": "art", "nsfw": false, "body": "藤間げる様 IRIAMで配信活動をしております、cozoru所属の綿飴めあると申します。Twitterの方で藤間げる様のイラストを見かけ、目がちゅるちゅるなとこ、色使いが好きだなと思い依頼させていただきたくご連絡しました！\n【参考資料】\nこちら私の立ち絵になります！\nhttps://twitter.com/gus4hv/status/1562660907012227072?s=21&t=nWUznktEEI6uwNv_fHOivQ\n\n私のTwitterです↓\nTwitter@Gus4Hv\n\n【利用用途について】\nTwitterのアイコン、配信サムネ、イベントの返礼品、こちらはできればなんですが配信立ち絵で使わせていただきたいと思っております。\n\n 【イラストのイメージについて】\n全身絵(こちら厳しそうでしたら腰上か膝上で大丈夫です)で、服は夏に着る私服をイメージしたものを着させていただきたく思います！！ギャルアイドルなのでお顔はギャルっぽさ全開で、他の部分はすべて藤間げる様にお任せします！\n\n【希望納品形式について】\nイラストと署名なし背景透過イラストをいただけると嬉しいです！\n\nお忙しいと思いますがよろしくお願い致します！\n\nhttps://twitter.com/gus4hv/status/1562660907012227072?s=21&t=nWUznktEEI6uwNv_fHOivQ", "created_at": "", "completed_at": ""}, {"path": "/@udo_n_purin/works/30", "thumbnail_src": "https://si.imgix.net/d8e63127/uploads/origins/8794d91f-2213-4aae-bba6-bc4144d5b587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c22c0cde54835ac5c0b2b148f9592726", "thumbnail_srcset": "https://si.imgix.net/d8e63127/uploads/origins/8794d91f-2213-4aae-bba6-bc4144d5b587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c22c0cde54835ac5c0b2b148f9592726, https://si.imgix.net/d8e63127/uploads/origins/8794d91f-2213-4aae