, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@riraca111/works/38", "thumbnail_src": "https://si.imgix.net/61eb3563/uploads/origins/187bfefa-afe0-4410-ada7-9c3fcddd677b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a266076ca9f341279269dcf7b29900", "thumbnail_srcset": "https://si.imgix.net/61eb3563/uploads/origins/187bfefa-afe0-4410-ada7-9c3fcddd677b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a266076ca9f341279269dcf7b29900, https://si.imgix.net/61eb3563/uploads/origins/187bfefa-afe0-4410-ada7-9c3fcddd677b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eee7935e86992d94256553a867cc0656 2x, https://si.imgix.net/61eb3563/uploads/origins/187bfefa-afe0-4410-ada7-9c3fcddd677b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a276a298f2401c446b7fa3c24c4f824 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつも金子さんの創作やTwitterなど楽しく拝見しております。\n 今回は“52ヘルツの鯨”モチーフでキャラクターデザインをしてほしいと思い、リクエストに伺いました。今巷で流行っている小説とは関係なく、この“52ヘルツの鯨”という概念がとても好きなので、是非金子さんのイラストで拝見したいと思いました。\n ただキャラデザなのに元になるビジュアルがないのと、検索しても小説の方がいっぱい出てくると思うので、ちょっと難しいな、割に合わないな、と感じたら無理せず断ってください。本当はもっと資料があればよかったのですが、こう…探してもいい感じの資料がなくてですね…。\nなので金子さんの『世界でもっとも孤独な鯨』に対する解釈を拝見できたら嬉しいな～という感じです！もしお時間がございましたらご検討のほどよろしくお願いします…！\n\nhttps://ja.wikipedia.org/wiki/52%E3%83%98%E3%83%AB%E3%83%84%E3%81%AE%E9%AF%A8", "created_at": "", "completed_at": ""}, {"path": "/@riraca111/works/37", "thumbnail_src": "https://si.imgix.net/34978286/uploads/origins/8b038d03-95c2-4d63-8a86-3ed219325d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2c9d28a1e28aa0d5c60d8a73a3c080", "thumbnail_srcset": "https://si.imgix.net/34978286/uploads/origins/8b038d03-95c2-4d63-8a86-3ed219325d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2c9d28a1e28aa0d5c60d8a73a3c080, https://si.imgix.net/34978286/uploads/origins/8b038d03-95c2-4d63-8a86-3ed219325d33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9e61fed4e152870fe19de8e51d605c9 2x, https://si.imgix.net/34978286/uploads/origins/8b038d03-95c2-4d63-8a86-3ed219325d33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a340e6a36c660c68b45c20c8049ee13 3x", "genre": "art", "nsfw": false, "body": "私に優しくしてくれる貴様の夢絵を描いて欲しいです\nTwitterのヘッダーに使おうと思っています", "created_at": "", "completed_at": ""}, {"path": "/@riraca111/works/36", "thumbnail_src": "https://si.imgix.net/2603d3d1/uploads/origins/4cf7af20-5581-43b2-bca9-e32e658b7462?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90b2b5cc4f58de3b017efb0e96b2b25d", "thumbnail_srcset": "https://si.imgix.net/2603d3d1/uploads/origins/4cf7af20-5581-43b2-bca9-e32e658b7462?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90b2b5cc4f58de3b017efb0e96b2b25d, https://si.imgix.net/2603d3d1/uploads/origins/4cf7af20-5581-43b2-bca9-e32e658b7462?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=effe4e464cbef2433d73d949cae9db25 2x, https://si.imgix.net/2603d3d1/uploads/origins/4cf7af20-5581-43b2-bca9-e32e658b7462?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=006349857e7046f0749928f8b31824bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}