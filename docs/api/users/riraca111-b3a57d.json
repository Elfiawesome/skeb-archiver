nキャラクターのプロフィール\n年齢:15歳\n性別:女性\n攻撃系の術で敵を一掃する、魔法使いポジション。得意なのは火属性。\n第一印象ではクールで淡々としているが、実は世話焼きで面倒見がいい。\nパーティメンバーの中で最年少だが、しっかり者、冷静、落ち着いているといった点から実年齢より大人びている印象を受ける。\n\n可愛さとカッコ良さを兼ね備えた、芯の通った女の子という印象があります。\n靴の資料が見当たらないので、お手数ですがお任せしたいです。\n\n御検討いただけますと幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/171_kXa2iosGxuXo43O-DTpYCpIJL7_Av", "created_at": "", "completed_at": ""}, {"path": "/@riraca111/works/44", "thumbnail_src": "https://si.imgix.net/f7872168/uploads/origins/75d7aa64-6988-45ee-bef1-050f7cb6ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0ef4bfba88fb373ccc9e633d8ed5248", "thumbnail_srcset": "https://si.imgix.net/f7872168/uploads/origins/75d7aa64-6988-45ee-bef1-050f7cb6ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0ef4bfba88fb373ccc9e633d8ed5248, https://si.imgix.net/f7872168/uploads/origins/75d7aa64-6988-45ee-bef1-050f7cb6ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d108113c5024a5db927d32a7412bbee4 2x, https://si.imgix.net/f7872168/uploads/origins/75d7aa64-6988-45ee-bef1-050f7cb6ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cbca972d15011b9edea49e7093fa0e0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@riraca111/works/43", "thumbnail_src": "https://si.imgix.net/8a88d019/uploads/outputs/c0de4b3b-7377-4eae-8322-8dfbe29154ea?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e5ebcff2c6cf9181d3510206c