891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3634594f5ecf321a387dcbeaab5c1ee9 3x", "genre": "art", "nsfw": false, "body": "また依頼させていただきます。\nVTuberの【さくらみこ】さんをお願いします。衣裳はルームウェア衣装で、バストとヒップはとにかく大きくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sakura_ssd/works/157", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/7377011d/uploads/origins/6bea1194-fc42-4578-bdcd-0dfd99099cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3c4d700c4be35eae96e9baac24741f", "thumbnail_srcset": "https://si.imgix.net/7377011d/uploads/origins/6bea1194-fc42-4578-bdcd-0dfd99099cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3c4d700c4be35eae96e9baac24741f, https://si.imgix.net/7377011d/uploads/origins/6bea1194-fc42-4578-bdcd-0dfd99099cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d67be1b4481cce58716cb81b2faf034c 2x, https://si.imgix.net/7377011d/uploads/origins/6bea1194-fc42-4578-bdcd-0dfd99099cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f26ce8dc3142dc71f371a91ea74aed69 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakura_ssd/works/156", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/bc26252f/uploads/origins/974c8646-93f1-4c18-bb38-51fe6a40bfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc6419fcc0399487bc1ce2398f9caaef", "thumbnail_srcset": "https://si.imgix.net/bc26252f/uploads/origins/974c8646-93f1-4c18-bb38-51fe6a40bfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc6419fcc0399487bc1ce2398f9caaef, https://si.imgix.net/bc26252f/uploads/origins/974c8646-93f1-4c18-bb38-51fe6a40bfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b957c8a8ca45f06c842f4960a98ae53 2x, https://si.imgix.net/bc26252f/uploads/origins/974c8646-93f1-4c18-bb38-51fe6a40bfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab95f3a3c265e56fef721e5ad873fc60 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしいイラストありがとうございます。\n手数料無料とのことでまた依頼させていただきます。\n\n【キャラ】\nモン娘☆は～れむのスウィルとリューネイ\n（胸の大きさは大きく、二人とも同じくらい）\n\n【衣装】\n上半身は裸、下半身はタイツ（以前と同じ感じでお願いします。）\n\n【構図】\n向き合った状態で、それぞれの片乳を合わせた密着状態で、\n画面の向こうにいる主人に対して手を広げて間に挟まってほしいと誘っている構図でお願いします。\nそれぞれの胸からは母乳が溢れてると嬉しいです。\n\n【表情】\n目はハート目で、お姉さんの余裕が溢れる微笑み\n\nそれぞれのキャラ資料は下記になります。\nスウィル：https://w.atwiki.jp/monmusuharlem/pages/400.html\nリューネイ：https://w.atwiki.jp/monmusuharlem/pages/418.html\n\n是非ともよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sakura_ssd/works/155", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/dbf2bf09/uploads/origins/13c4bfd2-32ca-4dce-8989-e5c4508e69e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4fcb95e7a29317def4dd12f12af529a", "thumbnail_srcset": "https://si.imgix.net/dbf2bf09/uploads/origins/13c4bfd2-32ca-4dce-8989-e5c4508e69e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4fcb95e7a29317def4dd12f12af529a, https://si.imgix.net/dbf2bf09/uploads/origins/13c4bfd2-32ca-4dce-8989-e5c4508e69e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f83a61574aca3d7c1726b8b4738deb6 2x, https://si.imgix.net/dbf2bf09/uploads/origins/13c4bfd2-32ca-4dce-8989-e5c4508e69e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ab02c3abdab9d5af2f490f1526ca5b2 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ 宍戸沙玖来さん。\nVRChatできつねのバーチャルお姉ちゃんをやっていますSANSYOといいます。当方がVRChatで使用しているアバター、SANSYOのイラストをお願します。\nなんでも包めてしまいそうなデカペェとやさしさをいつもありがとうございます！\n\n今回は宍戸沙玖来さんの手癖のままに依頼させていただきます。\nNSFWをオンにしていますが選択肢を広めるためのものですので全年齢でもかまいません。\nポーズ構図、描写範囲もおまかせでお願いいたします。背景は単色グラデ等で省力してください。\n\nアルファ透過で使用することがありますので、「キャラ単体レイヤー表示（背景をアルファ透過で抜いての使用）」が含まれているとうれしいです。\nバーチャルお姉ちゃん SANSYO の文字入れをキャラにかぶらない位置にお願いします。※「へ」は不要です。\n\nhttps://x.com/LiSansyo/status/1621211401665777664", "created_at": "", "completed_at": ""}, {"path": "/@sakura_ssd/works/154", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/8a350812/uploads/origins/42513791-96e8-4c80-91f0-2b585fa1e3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=113f712748442715dcdab47c8e8e5e1d", "thumbnail_srcset": "https://si.imgix.net/8a350812/uploads/origins/42513791-96e8-4c80-91f0-2b585fa1e3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=113f712748442715dcdab47c8e8e5e1d, https://si.imgix.net/8a350812/uploads/origins/42513791-96e8-4c80-91f0-2b585fa1e3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2eeca761c086a9c0f1ba6df558439ea 2x, https://si.imgix.net/8a350812/uploads/origins/42513791-96e8-4c80-91f0-2b585fa1e3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=529174802262f007c8f473e4a68f843f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakura_ssd/works/153", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/62d5e346/uploads/origins/da5b72ae-30b