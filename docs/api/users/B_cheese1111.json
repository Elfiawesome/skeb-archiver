d2fd2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c198939a99884e3e0b3d2e45542f9832", "thumbnail_srcset": "https://si.imgix.net/772ca9b9/uploads/origins/42bfb999-85fa-419e-b35c-28bb50d2fd2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c198939a99884e3e0b3d2e45542f9832, https://si.imgix.net/772ca9b9/uploads/origins/42bfb999-85fa-419e-b35c-28bb50d2fd2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95bc78a0aa19c7f8f0ca35a125b9f78c 2x, https://si.imgix.net/772ca9b9/uploads/origins/42bfb999-85fa-419e-b35c-28bb50d2fd2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f81fc01b21f218206ba38ee2a96d87e2 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nBチーズさんの描かれたナンジャモの生ハメSEXが素敵だったので、以下の内容の漫画をリクエストしたいです。\n●キャラクター\nバンドリの氷川紗夜(催眠で常識改変済み)\n※おっぱいのサイズ感や乳輪の大きさは、Bチーズさんが以前描かれたナンジャモと同じくらいの大きさでお願いします。\n\n●シチュエーション\n・放課後、学校の体育倉庫内の体操マットの上で\n・小太りなデカチン用務員おじさんと\n・個別の性指導として様々な体位で生ハメする\n※竿役は顔無し・下半身周りのみなど、簡易的な描写で構いません。\n※背景もまた、描写は簡略 or 省略でよいです。\n\n●大まかな流れ\n【導入】\n制服姿で立った状態で、自ら上半身をまくっておっぱいを露出させ、スカートをめくり上げ、オマンコを見せる。\n紗夜「今日も性指導よろしくお願いします……♡」\n\n【生ハメ性指導】(★ここからは全裸でお願いします)\n・仰向けに横たわる竿役の上に跨がり、自分からちんぽを挿入して、騎乗位で自ら頑張って腰を振る。\n・体操マットにうつ伏せになり、お尻を突き上げ、自らおまんこを片手の指2本で拡げて「もっともっと、おちんぽをおまんこに教えてください」と息を荒くしながら誘惑する。\n・竿役が亀頭でちゅぷちゅぷとおまんこの入り口を弄った後、一気に奥まで挿入する。\n・そのままバックの体位で激しいピストンで犯し、竿役がどんどん主導権を握っていく。\n・竿役がリードし、他にも色々な体位でおまんこに徹底的にちんぽを教え込む。\n\n【ラスト】\n・正常位で腰を掴まれ、若干腰を持ち上げられた状態で、ちんぽを子宮口へ密着させられながら大量に中出しされる\n※竿役で女の子が隠れないような構図でお願いします。\n※可能でしたら、子宮へ大量に精液を注がれ、精液で子宮がたぷたぷになる断面図の描写があると嬉しいです。\n\nページ数や、【生ハメ性指導】のパートの取り込む体位やシチュエーションなどは、金額から可能な範囲までで構いません。\nご検討のほど、どうかよろしくお願いします！\n\nhttps://www.youtube.com/watch?v=0prfta59Sy8", "created_at": "", "completed_at": ""}, {"path": "/@B_cheese1111/works/78", "thumbnail_src": "https://si.imgix.net/0c1aab0b/uploads/origins/62f8a307-b77a-4db9-b98d-86c44250739d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc1bf5a02e0c8ca2ce29d8e2b73239f6", "thumbnail_srcset": "https://si.imgix.net/0c1aab0b/uploads/origins/62f8a307-b77a-4db9-b98d-86c44250739d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc1bf5a02e0c8ca2ce29d8e2b73239f6, https://si.imgix.net/0c1aab0b/uploads/origins/62f8a307-b77a-4db9-b98d-86c44250739d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f096f0e3c880f6b9ef246ee8d7aeafab 2x, https://si.imgix.net/0c1aab0b/uploads/origins/62f8a307-b77a-4db9-b98d-86c44250739d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b429d22a252ec4d1ff4bc0b9a4ef88d 3x", "genre": "art", "nsfw": true, "body": "よろしければ、アニメ版ポケモンから、ヒカリがロケット団のムサシにお尻ペンペンされているイラストをお願いします。\nヒカリが危ない目に遭いかけた所を偶然ムサシが助けてあげて、その流れで叱られているという感じです。\nロケット団員だけど、何だかんだ人の好い姉御肌なムサシなんで、危ないことする悪ガキはきっちりと叱るという展開です。", "created_at": "", "completed_at": ""}, {"path": "/@B_cheese1111/works/77", "thumbnail_src": "https://si.imgix.net/9e395f3f/uploads/origins/b85e8c04-b3bc-4259-b729-8b895d9fceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d243c02eb655701911b874e639b26918", "thumbnail_srcset": "https://si.imgix.net/9e395f3f/uploads/origins/b85e8c04-b3bc-4259-b729-8b895d9fceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d243c02eb655701911b874e639b26918, https://si.imgix.net/9e395f3f/uploads/origins/b85e8c04-b3bc-4259-b729-8b895d9fceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=652e5c09f549d1f6e90461bc0b1e9fe8 2x, https://si.imgix.net/9e395f3f/uploads/origins/b85e8c04-b3bc-4259-b729-8b895d9fceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dfc7eb176b201bfe3f79aaf2c20ec24 3x", "genre": "art", "nsfw": true, "body": "以前したっぱちゃんのくすぐり絵をリクエストした者です。\nまた良ければリクエストをさせてください。\nもしキャラが分かればですが、葬送のフリーレンに出てくるアウラが辱められつつくすぐられ大笑いするという内容をお願いしたいです。\n以下、イメージです。\n\n○何者かに敗北し服従させられ、笑顔でパンツを見せるよう命令されるアウラ。\n○体が勝手に動き、顔を真赤にしつつ涙目で悔しそうにスカートをたくし上げパンツを見せる。\n○アウラが笑顔じゃなかったので、何者かはくすぐりの魔法を使いマジックハンドを出し、アウラは後ろから　　　　　　\n　両腋の下に入った手にくすぐられ、たくし上げ状態で大笑いしてしまう。\n○最終的に倒れた状態で茶巾縛りにされ、マジックハンドに体をあちこちくすぐられ、大笑いしつつもがいている。\n\nたくし上げのときは、両腋の下にスペースができるようなたくし上げ方でお願いします。\n腋の下をくすぐる手は、したっぱちゃんの5コマ目で左腋をくすぐっていた手が触れていた、\nあの「胸の後ろ腋の奥」…とでも言えるような辺りに優しく触れてくすぐっている感じでお願いします。\nまた、くすぐる手は体から離れておらず、ちゃんと皮膚に触れているように見える描写であると助かります。\n茶巾縛りのときは顔は見えず、無様にあがいている感じがあると嬉しいです。\n\nもし上記内容でリクエストが可能でしたら、ぜひぜひお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@B_cheese1111/works/76", "thumbnail_src": "https://si.imgix.net/5bd00ceb/uploads/origins/df832e95-6ca9-4ef5-a508-472ac196ca71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=998cbd110e921180bc66dd3edf78253e", "thumbnail_srcset": "https://si.imgix.net/5bd00ceb/uploads/origins/df832e95-6ca9-4ef5-a508-472ac196ca71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=998cbd110e921180bc66dd3edf78253e, https://si.imgix.net/5bd00ceb/uploads/origins/df832e95-6ca9-4ef5-a508-472ac196ca71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5125909f6af6e895abaa103c41ef01d8 2x, https://si.imgix.net/5bd00ceb/uploads/origins/df832e95-6ca9-4ef5-a508-472ac196ca71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ea749145383c27adcb652b03fe8d32b 3x", "genre": "art", "nsfw": true, "body": "はじめまして、よろしければリクエストお願いします\nキャラクターはルビーサファイアのマグマ団幹部カガリ（リメイク前）でシチュエーションはルビーサファイアの男主人公に臭い攻め逆レイプするシチュをお願いします。\nシチュとしては蒸れた生足で足コキしながら蒸れたブーツを嗅がせる→騎乗位挿入で逆レイプという形になります。\n詳細\n・男主人公君は描かなくて良いです。（もしくはシルエット様）\n・マグマ団の制服はリメイク前をベースにムサシコスのようなへそ出しの物にしたもの。フードは外している\n・騎乗位挿入時の上部の服は半脱ぎ状態で胸が露出している（胸は大きめで）\n・生足は赤のマニキュアが施されており、足・ブーツ共に蒸れは強めで、股が開かれており、白黒の縞パンが見えている（カガリも感じていて湿っている）\n・表情は攻めるのを楽しんでいるようなSっ気な表情で\n・言葉攻めしつつ騎乗位挿入→射精後、男主人公にディープキス。口を放して唾液が糸轢く描写もお願いします。\n\nhttps://drive.google.com/file/d/1FZc4fuKJw0G1x2ZMCJoWHW4byP83mH6O/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@B_cheese1111/works/75", "thumbnail_src": "https://si.imgix.net/cdef218f/uploads/origins/3c58e5f0-19eb-4231-b019-0f58f875a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3bc04b3e92725f59a8fdd51636c78e", "thumbnail_srcset": "https://si.imgix.net/cdef218f/uploads/origins/3c58e5f0-19eb-4231-b019-0f58f875a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3bc04b3e92725f59a8fdd51636c78e, https://si.imgix.net/cdef218f/uploads/origins/3c58e5f0-19eb-4231-b019-0f58f875a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcd7b06c0ae03c22a0a0e1aee17ec9a7 2x, https://si.imgix.net/cdef218f/uploads/origins/3c58e5f0-19eb-4231-b019-0f58f875a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d3b20528a8b8262a6d45ef5d4e6784b 3x", "genre": "art", "nsfw": true, "body": "ポケモンXYの「おとなのおねえさん」のイラストをお願いします。\n【シチュエーション】\n・少年のトレーナーにポケモンバトルで負け、体で払えと服越しに胸を揉まれており呆れ顔\n・「いつもこんなことやってるの？」といった感じに窘めるも、片方の胸は鷲掴みにされ、もう片方は根本または中間あたりを握りしめられて先端をしゃぶりつかれ声が上ずる\n・胸に吸い付いたまま少年が後ろに倒れるように体重をかけられて胸を引き伸ばされ、女の子が前のめりの体勢になって母乳を溢れさせながら絶頂(胸を引き伸ばす形なら他の体勢でも)\n・胸を服から引っ張り出され、胸がVの字を描くように持ち上げられながら握りしめられ、更に母乳をまき散らし、涙目になってやめるように懇願するも絶頂させられる\n【外見】\n・服装はゲームと同じサングラス、キャミソールのような服、ズボン、ハイヒール姿\n・体つきはhttps://skeb.jp/@B_cheese1111/works/61くらいに\n・女の子の表情と胸まわりがメインに写る構図\n・少年は目元が影、服装はTシャツに短パンなどでゲーム中に登場する服装に合わせたものでなくても差し支えありません\n以上、ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@B_cheese1111/works/74", "thumbnail_src": "https://si.imgix.net/fa436970/uploads/origins/f2bcfc15-9275-4711-8271-474596aeeab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15bff5df8a4312db8729419a136b5922", "thumbnail_srcset": "https://si.imgix.net/fa436970/uploads/origins/f2bcfc15-9275-4711-8271-474596aeeab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15bff5df8a4312db8729419a136b5922, https://si.imgix.net/fa436970/uploads/origins/f2bcfc15-9275-4711-8271-474596aeeab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ee9c1215cb8241e31d339238def158a 2x, https://si.imgix.net/fa436970/upl