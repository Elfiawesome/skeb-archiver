Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3325e47f8ffda3c95efab0f8293487ee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/47", "thumbnail_src": "https://si.imgix.net/b75ce1d2/uploads/origins/e680f73f-6b52-41b4-bc94-4f4981770e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ed363275e0b42a153713d581581697", "thumbnail_srcset": "https://si.imgix.net/b75ce1d2/uploads/origins/e680f73f-6b52-41b4-bc94-4f4981770e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ed363275e0b42a153713d581581697, https://si.imgix.net/b75ce1d2/uploads/origins/e680f73f-6b52-41b4-bc94-4f4981770e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a0c63e282f876851e82f80cdcfb00e6 2x, https://si.imgix.net/b75ce1d2/uploads/origins/e680f73f-6b52-41b4-bc94-4f4981770e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5550eb2223a2f9f70807df9fc01389b1 3x", "genre": "art", "nsfw": true, "body": "Vtuberとして活動しております「如月せり」と申します。\n先生の千夜イチヤさんとまどろみ姉さんのイラストがとても素敵だったので、ぜひ私のイラストも政策をお願いしたくご連絡いたしました。\n\nR18イベント「withnyFesta3」用のクラウドファンディング返礼品（正方形マウスパッド）として使用するイラストの制作をお願いしたいです。\nまた、同イラストは音声作品のパッケージ画像や配信サムネイルなどにも使用させていただきたいと考えております。\n\n▼依頼内容\n・キャラクター：如月せり（キャラクター資料を添付いたします）\n・ポーズ：誘い受けのイメージがほしいです（別途ポーズ案を添付いたします）\n・構図：正方形のキャンバスでお願いいたします（縦3151px × 横2579px）\n・雰囲気：R18寄りのセクシーなイメージでお願いします（露出や表情などの詳細も画像で共有いたします）\n・背景：キャバクラの店内風の背景を希望します\n・解像度：350dpi\n・納品形式：PSDまたはPNG形式でお願いいたします\n・納品内容：キャラクター単体と背景付きの両方をお願いできれば幸いです\n\n▼使用用途\n・withnyFesta3 クラファン返礼品（正方形マウスパッド）\n・音声作品のパッケージ画像\n・配信サムネイル（YouTube・Fantia・Booth等）\n\n※用途の都合上、商用利用・加工（文字入れ・トリミング等）・複数媒体での使用の許諾をお願いできればと思っております。もちろんクレジット表記や作品紹介などは可能な範囲で対応させていただきます。\n\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1GQCEykuG1yReZaciPzRKdGFk-RSKn0bO?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/46", "thumbnail_src": "https://si.imgix.net/851c7853/uploads/origins/6edec100-2d02-497a-b68b-044f905424cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90effed137e9145ab6248acfb2da9d45", "thumbnail_srcset": "https://si.imgix.net/851c7853/uploads/origins/6edec100-2d02-497a-b68b-044f905424cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90effed137e9145ab6248acfb2da9d45, https://si.imgix.net/851c7853/uploads/origins/6edec100-2d02-497a-b68b-044f905424cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b95001733f0aade819a0f2c4ad578813 2x, https://si.imgix.net/851c7853/uploads/origins/6edec100-2d02-497a-b68b-044f905424cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d63ed9ab69c36cc9e58466ce3b16e8e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/45", "thumbnail_src": "https://si.imgix.net/32b88f28/uploads/origins/cb1690b7-01fe-4d06-a371-ab1101aac9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5342945d51b8c04cd4c466d82542eea1", "thumbnail_srcset": "https://si.imgix.net/32b88f28/uploads/origins/cb1690b7-01fe-4d06-a371-ab1101aac9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5342945d51b8c04cd4c466d82542eea1, https://si.imgix.net/32b88f28/uploads/origins/cb1690b7-01fe-4d06-a371-ab1101aac9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f0a7a51bf537ee2e1bf39adcefcbcdf 2x, https://si.imgix.net/32b88f28/uploads/origins/cb1690b7-01fe-4d06-a371-ab1101aac9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e1a2a3611b0aae3d02c84bb7296550d 3x", "genre": "art", "nsfw": true, "body": "こんばんわですキクタ先生。\nリクエストさせていただいてもよろしいでしょうか？\n\n戦場のヴァルキュリア２のユリアナさんが魔法少女シリーズの倉本エリカの魔法少女コスグラビアに興奮してた恋人に濃厚エッチしているイラストをお願いさせてください。\n精一杯エリカに似せた服装や髪型で画面を見ている私が竿役としてされている感じでお願いいたします。\n\nご検討をよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/44", "thumbnail_src": "https://si.imgix.net/6647cdc0/uploads/origins/f4ab464a-9bd2-41f1-bbe7-822871e38d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a5f7ae8b59fccaba0b6aa8ff8dacd9", "thumbnail_srcset": "https://si.imgix.net/6647cdc0/uploads/origins/f4ab464a-9bd2-41f1-bbe7-822871e38d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a5f7ae8b59fccaba0b6aa8ff8dacd9, https://si.imgix.net/6647cdc0/uploads/origins/f4ab464a-9bd2-41f1-bbe7-822871e38d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf74d0e21597f2294b934ec15a648b22 2x, https://si.imgix.net/6647cdc0/uploads/origins/f4ab464a-9bd2-41f1-bbe7-822871e38d73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c358e8b8b8cc4834ea428257610cd6c8 3x", "genre": "art", "nsfw": true, "body": "お世話になります\n\n以前よりキクタ先生の作品を拝見しております\nぜひ私にも描いていただきたいと思いリクエストします\n\n・今回は私のVの姿「乙羽衣 乃音(おっぱい のおと)」をお願いします\n・立ちバックでプレイ後、背中に射精されているものを横から見た構図で描いていただきたいです\n・衣装は脱がせずに胸だけ露出させてください\n・表情やその他細かい部分はお任せします\n・描いていただいたイラストはTwitterへの投稿等、個人利用の範囲で使用させていただきたいです\n\n上記の内容で何卒ご検討の程よろしくお願いします\n\nhttps://drive.google.com/file/d/1PQsIBur3pousfL17Na7Vt4oXPq5N2vlM/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/43", "thumbnail_src": "https://si.imgix.net/7af7f37a/uploads/origins/52465d29-3acb-44f1-9df5-8feb95631482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=585094a653837283cef235b0f890282f", "thumbnail_srcset": "https://si.imgix.net/7af7f37a/uploads/origins/52465d29-3acb-44f1-9df5-8feb95631482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=585094a653837283cef235b0f890282f, https://si.imgix.net/7af7f37a/uploads/origins/52465d29-3acb-44f1-9df5-8feb95631482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73682218a6fe63d91f18ed25318e845b 2x, https://si.imgix.net/7af7f37a/uploads/origins/52465d29-3acb-44f1-9df5-8feb95631482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1652620929e290f71a8547003843ec7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。るくさんと申します。\n今回はイラストの依頼をさせていただきたく、連絡させていただきました。\n\nさっそくイラストの内容ですが、\n「FGOで2024夏に実装されたBBドバイの第一再臨衣装(あのファビュラスなドレス)を着たまどろみ姉さん(@amanosakatu)と千夜イチヤさん(@senya_1ya)」\nを希望させていただきたく思います。\nポーズはお任せします。\nただし、姉さんとイチヤさんが一緒のイラスト(A)、できたらそのイラストの中の姉さん(B)、イチヤさん(C)それぞれを個別で抜き出せるようであると嬉しいです。(伝わるでしょうか)\nA.B.Cの3点の納品をお願いしたく思います。\n\nそして、その作品をまどろみ姉さん、千夜イチヤさんのご両名にプレゼントしたいと思っており、イラストをサムネや配信などに使う権利をご両名に差し上げたいということを了承していただきたく思います。\n\nそれでは、よろしくおねがいいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/42", "thumbnail_src": "https://si.imgix.net/0a343f54/uploads/origins/5428155b-ca15-4465-baac-11ba4257589e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae458fb74af5c710d667a1692514f6b", "thumbnail_srcset": "https://si.imgix.net/0a343f54/uploads/origins/5428155b-ca15-4465-baac-11ba4257589e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae458fb74af5c710d667a1692514f6b, https://si.imgix.net/0a343f54/uploads/origins/5428155b-ca15-4465-baac-11ba4257589e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cabf86323aea07cc1d4ad664444b6381 2x, https://si.imgix.net/0a343f54/uploads/origins/5428155b-ca15-4465-baac-11ba4257589e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7aecece15f1e21736c582c9a8cf62b5e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、まどろみ姉さんが千夜イチヤに騎乗位をしているイラストが欲しいです。まどろみ姉さんとふたなり • 千夜イチヤさん。裸。汗だく。40cmちんぽ。中出し。受精卵が映し出される。次のシーンは、まどろみ姉さんとイチヤさんがベッドに横たわっている。まどろみ姉さんは満足そうな顔で寝ている。イチヤさんは憔悴した表情で寝ている。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/41", "thumbnail_src": "https://si.imgix.net/d7e14489/uploads/origins/1a65818e-3f08-4487-a035-72392090f67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2032ce27944f78c3c260e61120d6783f", "thumbnail_srcset": "https://si.imgix.net/d7e14489/uploads/origins/1a65818e-3f08-4487-a035-72392090f67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2032ce27944f78c3c260e61120d6783f, https://si.imgix.net/d7e14489/uploads/origins/1a65818e-3f08-4487-a035-72392090f67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0e73ea7683ce84d5c9c868c51c06a3c 2x, https://si.imgix.net/d7e14489/uploads/origins/1a65818e-3f08-4487-a035-72392090f67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe81d4b597ac07fe7ad457fbf198e9b7 3x", "genre": "art", "nsfw": false, "body": "キクタ様\n\nリクエスト失礼いたします！\n個人Vtuberの百雲みやと申します！\nSNSを拝見し、キクタ様の描かれる女の子がセクシーで可愛らしく大変素敵でしたので是非私のキャラクターも描いていただきたくリクエストしました。\nご確認よろしくお願いいたします！\n\n〇詳細\n・表情、ポーズ等お任せいたします。\n・キャラクターの設定は添付したURLを参考にしていただければと思います。\n　(ビジュアルで分かりづらい部分は簡略化やアレンジしていただいて大丈夫です)\n・いただいたイラストはサムネイルにも使用させていただきたいと考えているため、頭部や髪の毛、腕等バストアップが見切れないようにお願いいたします。\n・可能であれば背景を透過した人物のみのデータもいただけると嬉しいです。\n\n〇使用用途\n・YouTube動画やサムネイル\n・Xへの投稿\n・ファンボックスへの投稿\n\nお忙しいとは存じますが、ご検討の程よろしくお願いいたします！\n\nhttps://x.com/mogumo_miya/status/1776010666966704508", "created_at": "", "completed_at": ""}, {"path": "/@kikuta256/works/40", "thumbnail_src": "https://si.imgix.net/a265f781/uploads/origins/ece28964-b3c6-418d-9b95-7ba4b3c15388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2127c7342852c810d0f5c75092f661d", "thumbnail_srcset": "https://si.imgix.net/a265f781/uploads/origins/ece28964-b3c6-418d-9b95-7ba4b3c15388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=