oto/works/9", "thumbnail_src": "https://si.imgix.net/ce4bb3c7/uploads/origins/07c945c5-a8d9-427d-8ec8-8fb5f983da39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c26c740ace3a0e1f9a8516e9e2e0b88c", "thumbnail_srcset": "https://si.imgix.net/ce4bb3c7/uploads/origins/07c945c5-a8d9-427d-8ec8-8fb5f983da39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c26c740ace3a0e1f9a8516e9e2e0b88c, https://si.imgix.net/ce4bb3c7/uploads/origins/07c945c5-a8d9-427d-8ec8-8fb5f983da39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3fd2b3f1fcc2d9ea2db8fc84fdb058f 2x, https://si.imgix.net/ce4bb3c7/uploads/origins/07c945c5-a8d9-427d-8ec8-8fb5f983da39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67138331af2c80c4a3962fb8f2de57f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mineduka_koto/works/8", "thumbnail_src": "https://si.imgix.net/b86fae90/requests/236903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4700e7602593af7548354fe46f75f2e3", "thumbnail_srcset": "https://si.imgix.net/b86fae90/requests/236903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4700e7602593af7548354fe46f75f2e3, https://si.imgix.net/b86fae90/requests/236903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=603bda743a439b4e2b79328dfd8f6835 2x, https://si.imgix.net/b86fae90/requests/236903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=962ac3f9b279304135414109c2b00d79 3x"