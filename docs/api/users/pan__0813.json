w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e6642e9bd568f10fc51ed1d103aea4a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pan__0813/works/5", "thumbnail_src": "https://si.imgix.net/6308abdf/uploads/origins/8e2a4013-9965-4ca4-91ba-94db534f7792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=babd2fe7d1b97c3f6a819224a32c5583", "thumbnail_srcset": "https://si.imgix.net/6308abdf/uploads/origins/8e2a4013-9965-4ca4-91ba-94db534f7792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=babd2fe7d1b97c3f6a819224a32c5583, https://si.imgix.net/6308abdf/uploads/origins/8e2a4013-9965-4ca4-91ba-94db534f7792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f92fc4404350781d2324fc1ffb543269 2x, https://si.imgix.net/6308abdf/uploads/origins/8e2a4013-9965-4ca4-91ba-94db534f7792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df9d4294aa3d74e5cf83a34c30679bbc 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n暖かく美味しそうな食べ物のイラストいつも楽しく拝見しています\n\n今回「キャラと食べ物」のイラスト制作リクエストさせていただきます。以下詳細です。\n\n使用用途：SNSでの利用\nキャラ：久里ルモ\n設定：化学を使う呪術師（魔術師）\n構図：おまかせします。\n背景：ショートケーキ\n\n全体の構図おまかせします。\nキャラの立ち絵URL添付させていただきます。\nわかりづらい箇所ございましたらアレンジしていただいて問題ありません。\nご都合悪ければキャンセルお願いします。\n\n以上、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1IqeQ2tuTKHG2rxVHgm3GhdLTrvi51iDc?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pan__0813/works/4", "thumbnail_src": "https://si.imgix.net/60cf6764/uploads/origins/0611410d-aa27-404a-b49d-bd327335000f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ab6d3006be2ce7a8dd4956a26344cf", "thumbnail_srcset": "https://si.imgix.net/60cf6764/uploads/origins/0611410d-aa27-404a-b49d-bd327335000f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ab6d3006be2ce7a8dd4956a26344cf, https://si.imgix.net/60cf67