c90fec7a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f552ce22dfc3dd33ec9b534cb12f388d", "thumbnail_srcset": "https://si.imgix.net/870016e8/uploads/origins/add23958-1ff9-402c-ae0b-b2c90fec7a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f552ce22dfc3dd33ec9b534cb12f388d, https://si.imgix.net/870016e8/uploads/origins/add23958-1ff9-402c-ae0b-b2c90fec7a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=623a9632db13bcc4dded59513116ea2d 2x, https://si.imgix.net/870016e8/uploads/origins/add23958-1ff9-402c-ae0b-b2c90fec7a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5bc5cc41f27a80288887da0fb84a0d4 3x", "genre": "art", "nsfw": false, "body": "⚫︎カラー希望\n⚫︎全体的なイメージはバレエ『白鳥の湖』のバレリーナ。\n⚫︎バレエ『白鳥の湖』のバレリーナのポーズ（沢山あると思うのでその中でも両腕を上げているものならなんでもokです）。\n⚫︎両腕の前腕のガラスにヒビが入って一部割れている（ヒビの合間は赤くなっている、血をイメージ）。\n⚫︎割れてガラスが無い部分は赤くなっている（血をイメージ）。\n⚫︎瞳は伏目がちでまつ毛は長め。\n⚫︎すみれ糸星様のイラストはガラスの体の少女ということで硬質なイメージがあるので、無理に身体を曲げたり（足をあげたり）する必要はありません。ただ腕だけあげて欲しいです。\n⚫︎髪の毛はショートカット（カール無し）。\n⚫︎衣装は必ずしも白鳥の湖のドレスでなくても構いません。全体的なイメージと合っている状態がいいです。\n⚫︎百合の花を作品のどこかへ入れてください。量は問いません。1輪でも、大輪でもいいです。\n⚫︎表情は柔らかめ、口はほんの少し空いている。\n⚫︎羽が生えていたら嬉しいです。\n⚫︎天使の輪っかが入れれたらお願いします。\n⚫︎その他のイメージ\n　孤独であるけれどそれに満足している。\n　周りから見たら痛々しく見える。\n　夜の湖面で踊っているイメージ。\n　青白いイメージと、腕の赤色の対比。", "created_at": "", "completed_at": ""}, {"path": "/@sumireshisei/works/3", "thumbnail_src": "https://si.imgix.net/ac7a0ab0/uploads/origins/40865cf5-d3a7-4b72-8a63-d75d0a9b58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c38ae7829c34e77fd35b7738c7aff4d3", "thumbnail_srcset": "https://si.imgix.net/ac7a0ab0/uploads/origins/40865cf5-d3a7-4b72-8a63-d75d0a9b58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c38ae7829c34e77fd35b7738c7aff4d3, https://si.imgix.net/ac7a0ab0/uploads/origins/40865cf5-d3a7-4b72-8a63-d75d0a9b58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d2d6055806d0c