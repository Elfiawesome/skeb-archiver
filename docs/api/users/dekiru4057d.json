れました。\nぜひ自創作物語の子をカタチにしていただけたらとリクエストです。\n\n●人物（URLは人物画像）\n男性ロクサーヌ／金髪青眼。にこにこ穏やかな少年王。陰陽師のような符術師系の魔法使い。\nhttps://drive.google.com/file/d/1hAN34QLFxg8I_bA5aSPs0qmYzL5xK2dp/view?usp=sharing\n\n●内容\n等身大の姿がみられたらうれしいです。\nカッコイイ様子でも、カワイイ様子でもお任せ。\n不明点お任せ。自由にかわいがっていただけたら嬉しいです。\n\n●用途\n基本個人観賞用（作者としてうちの子が見たい）\nその他、わたしが本作関係者への公開のためSNS投稿、作品置場（※無料エリア）で紹介\n投稿公開のためのサムネイル等への加工権希望\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@dekiru4057d/works/13", "thumbnail_src": "https://si.imgix.net/9f56dec6/uploads/origins/f8b5ce0d-7fa1-4cf7-a752-7f9ec72e199a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c9ecf9ba8b1dd95b28536c18129cc8f", "thumbnail_srcset": "https://si.imgix.net/9f56dec6/uploads/origins/f8b5ce0d-7fa1-4cf7-a752-7f9ec72e199a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c9ecf9ba8b1dd95b28536c18129cc8f, https://si.imgix.net/9f56dec6/uploads/origins/f8b5ce0d-7fa1-4cf7-a752-7f9ec72e199a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9611f40405481675288fe63d4fb2ffff 2x, https://si.imgix.net/9f56dec6/uploads/origins/f8b5ce0d-7fa1-4cf7-a752-7f9ec72e199a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cadd6bd3145658921f7b6c3562f6dd4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dekiru4057d/works/12", "thumbnail_src": "https://si.imgix.net/c78a0b86/uploads/origins/fab19d5b-3410-4c7e-9f48-ec96699f8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16919d6ced2d32ec4e6df163a6e6b8dd", "thumbnail_srcset": "https://si.imgix.net/c78a0b86/uploads/or