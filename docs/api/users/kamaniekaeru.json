5-f23bf64dbc20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64c8495e772cf6af316fbfbdea516ba9 2x, https://si.imgix.net/a7a59af8/uploads/origins/6aeb7cae-36ea-4c02-96b5-f23bf64dbc20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0aff3b6aa3c0cea6fd01a09b4988a38f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kamaniekaeru/works/146", "thumbnail_src": "https://si.imgix.net/ab17a290/uploads/origins/f26c096f-797a-44a3-a32f-7d864502e221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad14db5cce21e21276b0e5779109496d", "thumbnail_srcset": "https://si.imgix.net/ab17a290/uploads/origins/f26c096f-797a-44a3-a32f-7d864502e221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad14db5cce21e21276b0e5779109496d, https://si.imgix.net/ab17a290/uploads/origins/f26c096f-797a-44a3-a32f-7d864502e221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fc4f6fcf033fd0aab1b885a705b7f66 2x, https://si.imgix.net/ab17a290/uploads/origins/f26c096f-797a-44a3-a32f-7d864502e221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33131bc93fd2e3b438bf7f857bee4ebb 3x", "genre": "art", "nsfw": true, "body": "久しぶりにミア姫の肉壁触手R-18イラストをリクエストしたいです。\nだいたい、前のこのリクエスト (https://skeb.jp/@kamaniekaeru/works/72) のリメイクのようになります。\n今回も、全体的な構図はこのようにお願いします。https://www.pixiv.net/artworks/104030241#18\n\n今回は、こうやって上を見ながら口に触手を挿入されている状態でお願いしたいです。(表情と涙もこうやって) 尖った鼻の描写をよろしくお願いいたします。https://www.pixiv.net/artworks/116232823\n\n肉壁の天井から腰を巻きつけて引っ張る触手もそのままです。追加で、天井のより多くの触手が姫のお腹をなめるように触れ (https://x.com/Typpo8/status/1968722693395476985)、胸も絞っている描写をお願いします。\n\n片方の胸はつぼみ型触手によって母乳を吸収され、もう一方の胸は、巻きつける触手によって母乳を噴出する様子でお願いしたいです。https://www.pixiv.net/artworks/131700708\n\n股間の周囲が完全に露出しており、下から近づいてきた3体ぐらいの触手が挿入されている描写でお願いします。https://www.pixiv.net/artworks/115713221\n\n肉壁の色は、こんな「病んだ肉」という感じのピンク+グレーでお願いします。https://www.pixiv.net/artworks/80724669\nそして姫の肌を濃い茶色 (https://x.com/mushikera_hoi2/status/1686656090220724224) にして、姫の健康な体と肉壁の気味の悪い白の対比される姿を見たいです。\n\n完全に精液まみれの肉壁と姫の肌がぬるぬるしてつやのある描写と、精液が天井から流れ落ちたり、触手から姫の体に噴出する描写もよろしくお願いします。\n\n複雑な要請の多いリクエストですが、どうぞよろしくお願いします。\n\nhttps://imgur.com/a/RjfSh8R", "created_at": "", "completed_at": ""}, {"path": "/@kamaniekaeru/works/145", "thumbnail_src": "https://si.imgix.net/e64eb806/uploads/origins/23e1ba45-ed02-4dc1-b9b8-28d22d77f1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6b657129c417dffccc9ec718e2e3229", "thumbnail_srcset": "https://si.imgix.net/e64eb806/uploads/origins/23e1ba45-ed02-4dc1-b9b8-28d22d77f1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6b657129c417dffccc9ec718e2e3229, https://si.imgix.net/e64eb806/uploads/origins/23e1ba45-ed02-4dc1-b9b8-28d22d77f1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d49adb2c323497b084ffbf79f3b359b 2x, https://si.imgix.net/e64eb806/uploads/origins/23e1ba45-ed02-4dc1-b9b8-28d22d77f1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f49e3d80bfc767867c2a9cda74169063 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは。テンタクルナイトの話を続けたいと思います。\n\nドレスを断った商人は、代わりに新鮮な食べ物を触手騎士に贈り、二人は別々の道を歩む。騎士はその日の食事と休息のためにキャンプを用意することにする。騎士と触手は料理を作るが、触手は食材を準備したり鍋をかき混ぜたりするのを手伝い、その万能ぶりに騎士は感心する。\n\nこのシーンでは、騎士はガントレットとブーツを脱ぎ、触手と一緒に全裸になる。触手も戦闘中と比べるとリラックスし、ゆるく彼女の体を掴んでいる。\n\n周囲に人間がいなくなった今、彼女は友人と自由にくつろいでいる。彼女は商人との恥ずかしさをすぐに忘れ、触手のパートナーとの裸の生活に戻る。\n\nhttps://skeb.jp/@kamaniekaeru/works/133\nhttps://skeb.jp/@kamaniekaeru/works/51。", "created_at": "", "completed_at": ""}, {"path": "/@kamaniekaeru/works/144", "thumbnail_src": "https://si.imgix.net/35096fef/uploads/origins/aa832148-0423-425b-a3c6-999ab14b8605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t