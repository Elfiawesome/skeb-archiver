て精子まみれでハート目アヘ顔でこちらに媚びている描写をお願いしたいです\nその他眼鏡のON/OFFを切り替えできるようにして欲しいです\n可能なら台詞もお願いします\n\nまた衣装に関しては資料URLのとおりですが、\n胸と結合部は破ったりキャストオフさせて露出させてほしいです\nまた前垂れはずらして結合部を見せてください\n衣装の詳細に関しては資料にない部分等や装飾や小物が多く分かりにくい部分が多い為\nアレンジや省略してかまいません\n\nその他指定のない詳細はおまかせします\n以上が依頼内容になりますが筆が乗るように自由にやって頂いて構いません\nこうしたほうが良くなるなと思われたなら体位やシチュを始めとして\n描きやすいようにアレンジしてもらいたいです\n\n御手数おかけしますがご検討ください\n\nhttps://drive.google.com/drive/folders/1rJVzhWA05DFIM9rc-nTbf1KNn6Y7rGsw?hl=ja", "created_at": "", "completed_at": ""}, {"path": "/@asumaewokaku/works/7", "thumbnail_src": "https://si.imgix.net/e98df072/uploads/origins/ea86603b-8dc9-4cd6-9a5b-b7a76f42bd0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef779bf3d7c49bbff8af306b5ddc5e0f", "thumbnail_srcset": "https://si.imgix.net/e98df072/uploads/origins/ea86603b-8dc9-4cd6-9a5b-b7a76f42bd0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef779bf3d7c49bbff8af306b5ddc5e0f, https://si.imgix.net/e98df072/uploads/origins/ea86603b-8dc9-4cd6-9a5b-b7a76f42bd0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae1d048d635634c3d904d0d38689e20c 2x, https://si.imgix.net/e98df072/uploads/origins/ea86603b-8dc9-4cd6-9a5b-b7a76f42bd0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95f7147bdc529fbb86dba339197449b6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@asumaewokaku/works/6", "thumbnail_src": "https://si.imgix.net/802e6843/uploads/origins/de2e6bbf-673b-4e50-a696-9590c76c947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab24