o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ca6f364ccb643f62ef1440734f024e0 2x, https://si.imgix.net/e60f2b4b/uploads/origins/3e3db69a-1a83-4c3f-abed-1c9b47986196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfe1f8f6ac58641244c9b5ad3bbfd42c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nはるみき(天海春香と星井美希)をお願いしたいです。\n\n清楚な衣装を着て、距離近めでポーズを取っている感じでしたら嬉しいです。\n\n参考：\nhttps://news.dwango.jp/idol/61518-2105\n\n宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/16", "thumbnail_src": "https://si.imgix.net/24142a37/uploads/origins/8c161802-5b1a-446d-a19d-489e8f67a8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=258e1690648b18b023ecbbd03d0b1f38", "thumbnail_srcset": "https://si.imgix.net/24142a37/uploads/origins/8c161802-5b1a-446d-a19d-489e8f67a8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=258e1690648b18b023ecbbd03d0b1f38, https://si.imgix.net/24142a37/uploads/origins/8c161802-5b1a-446d-a19d-489e8f67a8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e47a8d76469b610ea7ebfe890d5d46dd 2x, https://si.imgix.net/24142a37/uploads/origins/8c161802-5b1a-446d-a19d-489e8f67a8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34b50a8a6826f2cc6f83c22e83203041 3x", "genre": "art", "nsfw": false, "body": "いつもありがとうございます。\n今回はTwitterアイコンに使用するイラストをお願いしたいです。\n今回も上条春菜さんと望月聖ちゃんの2人で聖ちゃんには眼鏡をかけていただきたいです。\n2人が両手を眼鏡に添えて得意気にどや顔をしているイメージでお願いいたします。\n服装等はおまかせいたします。\nよろしければ、今回も素敵なイラストをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/15", "thumbnail_src": "https://si.imgix.net/58dab554/uploads/origins/2a093c48-5a92-4c66-b97b-bf2f68495a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9adef456a66e8a44ceb8ab342ff6ff1a", "thumbnail_srcset": "https://si.imgix.net/58dab554/uploads/origins/2a093c48-5a92-4c66-b97b-bf2f68495a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9adef456a66e8a44ceb8ab342ff6ff1a, https://si.imgix.net/58dab554/uploads/origins/2a093c48-5a92-4c66-b97b-bf2f68495a32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=832628252297d4b747e97b5fda75138a 2x, https://si.imgix.net/58dab554/uploads/origins/2a093c48-5a92-4c66-b97b-bf2f68495a32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78a6798b4b28cdb03a01476ee68075ff 3x", "genre": "art", "nsfw": false, "body": "桜咲舞をお願いいたします。\n構図等はお任せします。\n\n納品時に差分データは必要ないのですが、Twitterでサムネ等に利用できる形で透過データを「#まいまいあーと」で投稿していただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/14", "thumbnail_src": "https://si.imgix.net/6e6acf98/requests/231654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d1f64f2b393345c822e7cd03ce6dcd", "thumbnail_srcset": "https://si.imgix.net/6e6acf98/requests/231654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d1f64f2b393345c822e7cd03ce6dcd, https://si.imgix.net/6e6acf98/requests/231654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69a78aff25a9499f6a0a3b32b8304956 2x, https://si.imgix.net/6e6acf98/requests/231654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89749ab00f3625446ab42e8dc437e01c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！\n\n上条春菜ちゃんのシンデレラマスターをイメージしたイラストをお願いしたいです。\n既存のシンデレラマスターシリーズのジャケットを参考にして頂ければと思います。\nシンプル目な背景、全身が入る構図(最低限足より上？)、衣装はCM用のオリジナルな\nことが多いですが新規でデザインというのも大変だと思うので既存衣装でもOKです。\n\nお題としてキャラ熱が入りすぎて重いかもしれないですが…いろんな上条春菜ちゃんのCM\nのデザイン案があって、その中の一つくらいの気持ちで気軽に描いて頂ければと思います！", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/13", "thumbnail_src": "https://si.imgix.net/8c38a368/requests/231903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15ce2ca88fdcf8c0142108a90fa3d00d", "thumbnail_srcset": "https://si.imgix.net/8c38a368/requests/231903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15ce2ca88fdcf8c0142108a90fa3d00d, https://si.imgix.net/8c38a368/requests/231903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ff75c1860c1faf1ed3a8577e0b8c47f 2x, https://si.imgix.net/8c38a368/requests/231903_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbc7a4ffe45241bbe8ffb72ee59327f4 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております。\n早速ですが、今回はTwitterに使用するヘッダのイラストをお願いしたいです。\n今回も上条春菜さんと、望月聖ちゃんの2名、望月聖ちゃんには眼鏡をかけていただきたいです。\n\n今回は「春先でのお出かけ」をテーマでお願いします。\n服装、構図、塗り等はおまかせします。\nよろしければ、今回もよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/12", "thumbnail_src": "https://si.imgix.net/2b6536fa/requests/231765_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73c333370ad004d7a2d9d3eaf28be17", "thumbnail_srcset": "https://si.imgix.net/2b6536fa/requests/231765_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73c333370ad004d7a2d9d3eaf28be17, https://si.imgix.net/2b6536fa/requests/231765_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca7ac11aeaca271f9843bc662f45413c 2x, https://si.imgix.net/2b6536fa/requests/231765_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf60817434f9d8bf119139d04cab124b 3x", "genre": "art", "nsfw": false, "body": "Twitterアイコン用に全力！チアガール(閃光☆HANABI団の衣装名)を着た高坂海美ちゃんのイラストをお願いします！\n詩音さんの水彩が好きなので水彩テイストだと嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/11", "thumbnail_src": "https://si.imgix.net/eeee0234/requests/205331_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=087b777cfd9474ca137aff5ec17ee7d4", "thumbnail_srcset": "https://si.imgix.net/eeee0234/requests/205331_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=087b777cfd9474ca137aff5ec17ee7d4, https://si.imgix.net/eeee0234/requests/205331_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfd4a76466916e3b563861345c66116b 2x, https://si.imgix.net/eeee0234/requests/205331_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4351bdd3c5778ba833a399985a92b1e 3x", "genre": "art", "nsfw": false, "body": "アイドルマスター　アニメイト日本横断フェアで大分県代表に選ばれた首藤ちゃんのイラストをお願いします。\n現在衣装イラストは出てないので、公式のイラストが出た後に同じ衣装でのイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shion_mnkm/works/10", "thumbnail_src": "https://si.imgix.net/f9d33684/requests/182415_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0099090d2f4673c06949db5a37b94cd", "thumbnail_srcset": "https://si.imgix.net/f9d33684/requests/182415_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0099090d2f4673c06949db5a37b94cd, https://si.imgix.net/f9d33684/requests/182415_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=363a863610cae2d76102aefd34248361 2x, https://si.imgix.net/f9d33684/requests/182415_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a87861b40a1d4731264322358f41a2b 3x", "genre": "art", "nsfw": false, "body": "お疲れさまです。\n今回はTwitterアイコンに使用するイラストをお願いしたいです。\n例によって上条春菜さんと望月聖ちゃん、聖ちゃんには眼鏡をかけてください。\n今回は、「何かを見つけた2人」というコンセプトでお願いします。見つけたもの、及びリアクションはおまかせします。\n服装はできれば冬の装いでお願いします。\nその他構図等はおまかせします。\nよろしければ今回もよろしくお願いします。", "created_at": "", "completed_at": ""}]}