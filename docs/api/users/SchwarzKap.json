2e5-b758-bdde3e1d9460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f206505f1d33e90be47c700e98b74c6f 2x, https://si.imgix.net/293a4741/uploads/origins/2949838e-f6a4-42e5-b758-bdde3e1d9460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3dafaa45d36a8d5aecafcd3abe03810 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SchwarzKap/works/69", "thumbnail_src": "https://si.imgix.net/d86b6ad0/uploads/origins/b93ea54a-6738-4f21-ad10-f64e8462998a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd5b9d5ef9119992c35b708a8d3d83a3", "thumbnail_srcset": "https://si.imgix.net/d86b6ad0/uploads/origins/b93ea54a-6738-4f21-ad10-f64e8462998a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd5b9d5ef9119992c35b708a8d3d83a3, https://si.imgix.net/d86b6ad0/uploads/origins/b93ea54a-6738-4f21-ad10-f64e8462998a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df8ae7c799be2748bcea78666695d12b 2x, https://si.imgix.net/d86b6ad0/uploads/origins/b93ea54a-6738-4f21-ad10-f64e8462998a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6ef3f0b5375691f5de6ec786821fefc 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。受託頂ければ幸いです。\n以下仕様です（顔はこれでもかって言うくらいかわいく）。\n・テーマは「理系女子高校生とギャル女子高生の化学反応・・・その裏側」です。\n・制服女子（リボンは色を水色に変更しておおきく。ブラウスのみ着用。首元のボタンは開いている。リボンはゆるゆるで、首元のボタンは開いている。）実験用の白衣を着ていて、ボタンはしていない。（開放状態）\n・丸眼鏡（はっきりわかるように、）\n・着衣セックス（騎乗位）\n・首からはネームストラップ（学生証）\n・髪の毛の色（金髪）\n・髪型（ツインテール・リボンは淡い黄色でかわいい物）\n・靴下はルーズソックス\n・スカートはピンク色でチェック柄で短め\n…。女の子を大きく。\n・パンティは片足の途中で丸まっている\n※英智な言葉をふんだんに入れる。\n・（おまけでめがね付近に顔射バージョンもあれば非常にありがたいです。）\n・上下左右見切れがないようにお願いします。\n・サイズは横1920*縦1080ピクセル（16対9）厳守でお願いします(サイズ・方向の間違えにご注意下さい。）納品ファイル形式は、psd（レイヤー未結合状態）、jpgでお願いします。ご検討の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@SchwarzKap/works/68", "thumbnail_src": "https://si.imgix.net/4a291ce3/uploads/origins/5a1b79ce-554f-4b50-b0f0-5ca44c5cf7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67db3c218769db98bdcc76b33380fd78", "thumbnail_srcset": "https://si.imgix.net/4a291ce3/uploads/origins/5a1b79ce-554f-4b50-b0f0-5ca44c5cf7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67db3c218769db98bdcc76b33380fd78, https://si.imgix.net/4a291ce3/uploads/origins/5a1b79ce-554f-4b50-b0f0-5ca44c5cf7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54a38cb929c4bfb6cbed2932d7759b58 2x, https://si.imgix.net/4a291ce3/uploads/origins/5a1b79ce-554f-4b50-b0f0-5ca44c5cf7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7168ace1011d8be885e6fe6617d599f9 3x", "genre": "art", "nsfw": true, "body": "初めまして\n\n内容が特殊ですので気のりしなければキャンセルしていただいて構いません。\n\nオリジナルキャラで、昔の農家の20歳前後の\n純朴そうな黒髪女性の拘束イラストをリクエストしたいです。\n顔だち、体型、髪型等はお任せします。\n全体的に悲壮感が漂う雰囲気のイラストをお願いします。\n\n恰好\n野良着、もんぺ、地下足袋履きで、\n胸をだしてX字に拘束されています。\n表情は拘束されて、羞恥のため泣いている感じにしてほしいです。\n頭から爪先までを描いてほしいです。\n\n服装\n野良着の色、模様は適当に、\nもんぺはへその辺りで紐を結ぶ袴式、\n全体の長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&dl=0\n\nまた\nもんぺの股間部分を破られ、陰部に張型が挿入され\n表情も痛さで苦しそうに目をつぶり涙を流して絶叫している状態もお願いします。\n\nつたない説明で恐縮ですが説明不足な点、構図など自由に\n変更、アレンジしていただいて構いませんが、\nもんぺと地下足袋の描写はできるだけ細部まで、また\n必ずもんぺが破れていない状態と破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/obnrrwlde7y6hyf4etijl/x2.png?rlkey=q67zqh19q9f8z3cg11nmd20ws&st=xi6k2hvb&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@SchwarzKap/works/67", "thumbnail_src": "https://si.imgix.net/e5523f6e/uploads/origins/d8967485-748b-4df2-ab41-2f12155a5614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=352c25fc6e58aba352c7b69fe0b85434", "thumbnail_srcset": "https://si.imgix.net/e5523f6e/uploads/origins/d8967485-748b-4df2-ab41-2f12155a5614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=352c25fc6e58aba352c7b69fe0b85434, https://si.imgix.net/e5523f6e/uploads/origins/d8967485-748b-4df2-ab41-2f12155a5614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b8f3c0e0723abfde1e24f1cf6a41f39 2x, https://si.imgix.net/e5523f6e/uploads/origins/d8967485-748b-4df2-ab41-2f12155a5614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b97f6af888c8aff488569bdc0baeacf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SchwarzKap/works/66", "thumbnail_src": "https://si.imgix.net/74795892/uploads/origins/0f66c5ef-e2a7-4130-8b8f-4e673aaa63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f46cd07dc946f60fb90aa60848ed855", "thumbnail_srcset": "https://si.imgix.net/74795892/uploads/origins/0f66c5ef-e2a7-4130-8b8f-4e673aaa63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f46cd07dc946f60fb90aa60848ed855, https://si.imgix.net/74795892/uploads/origins/0f66c5ef-e2a7-4130-8b8f-4e673aaa63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6651a23e60b85988d0343dc80da11820 2x, https://si.imgix.net/74795892/uploads/origins/0f66c5ef-e2a7-4130-8b8f-4e673aaa63b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6554b5ffc8b