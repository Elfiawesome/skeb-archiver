ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae18774fd2671c68a3dcda2e08761ef6, https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=809ffb266e28330846c46c14536693af 2x, https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f888053e2431231d239cbc0b8e84cf84 3x", "genre": "art", "nsfw": false, "body": "初めまして、香港VtuberのAotukiと申します。\nイ又好先生の作品を拝見しました、ほんとに素敵と思います。\n\n【依頼内容】\n・ポーズや構図などはお任せいたします！\n\n【使用用途】\n・YouTubeやTwitterなどでの使用\n・無料、グッズなどに使用する可能性がございます\n\n【備考】\n可能であれば、レイヤーを人物透過版もご準備いただけると助かります。\n文字有り・文字無しの差分をいただけると嬉しいです！\n\n【キャラクターの資料】\nhttps://drive.google.com/file/d/11Tp6igMDs7u57zj5LRn3idYWWXdniBap/view?usp=drive_link\n\nお忙しい中大変恐縮ですが、ご検討ほどよろしくお願い致します。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/11Tp6igMDs7u57zj5LRn3idYWWXdniBap/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mafura_00/works/6", "thumbnail_src": "https://si.imgix.net/07f3cc09/uploads/origins/8e453495-17bc-4c1c-993e-a068efca6d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e08a227876d9aec52663fbf6f827ad9", "thumbnail_srcset": "https://si.imgix.net/07f3cc09/uploads/origins/8e453495-17bc-4c1c-993e-a068efca6d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e08a227876d9aec52663fbf6f827ad9, https://si.imgix.net/07f3cc09/uploads/origins/8e453495-17bc-4c1c-993e-a068efca6d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80837e46076c66518329bf571fd6b328 2x, https://si.imgix.net/07f3cc09/uploads/origins/8e453495-17bc-4c1c-993e-a068efca6d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57f71a2d4090514469ca12c51f75b882 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵を見て、アートスタイルが気に入ったので、私のocの絵をリクエストしたいと思います。ht