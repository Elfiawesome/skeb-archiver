c7e7bd/uploads/origins/ebbd102c-b9d8-4c30-999d-0f5514a86f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cb408fd8e8c4c220ce045f613285e39", "thumbnail_srcset": "https://si.imgix.net/90c7e7bd/uploads/origins/ebbd102c-b9d8-4c30-999d-0f5514a86f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cb408fd8e8c4c220ce045f613285e39, https://si.imgix.net/90c7e7bd/uploads/origins/ebbd102c-b9d8-4c30-999d-0f5514a86f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dc02600c3ebb93c126a326ed03bb948 2x, https://si.imgix.net/90c7e7bd/uploads/origins/ebbd102c-b9d8-4c30-999d-0f5514a86f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05b0730ea19bf42b3960770e405d5976 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ホロライブのパヴォリア・レーヌの2nd衣装の髪型をカウキニで描いていただきたいです。よろしくお願いします！\n\n2nd衣装はこちら：\nhttps://drive.google.com/drive/folders/1uDwXwAb5C_KmMKMw0P3bl-kv4LGi6ha8", "created_at": "", "completed_at": ""}, {"path": "/@nel4685/works/24", "thumbnail_src": "https://si.imgix.net/1e50e163/uploads/origins/53aa69d1-e210-4030-88a3-caae21096645?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32dfefdae4ccb4f045cdc8bd78b793a0", "thumbnail_srcset": "https://si.imgix.net/1e50e163/uploads/origins/53aa69d1-e210-4030-88a3-caae21096645?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32dfefdae4ccb4f045cdc8bd78b793a0, https://si.imgix.net/1e50e163/uploads/origins/53aa69d1-e210-4030-88a3-caae21096645?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=959cbbc3a1ea54fd7b64e39fd56b23c1 2x, https://si.imgix.net/1e50e163/uploads/origins/53aa69d1-e210-4030-88a3-caae21096645?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bee135ea7c3c702cb42d9333b8d118c5 3x", "genre": "art", "nsfw": false, "body": "はじめまして。pixivでイラストを拝見し、良いなと思いリクエストさせていただきました。\n\n私が考えたオリキャラ（https://skeb.jp/@suica_mgmg/works/34 ）の青色バニー