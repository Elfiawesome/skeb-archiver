bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=094b6d438c211b676d9e024016c66844", "thumbnail_srcset": "https://si.imgix.net/9d1eae63/uploads/origins/4cbe8918-d4e5-4e6e-b853-b944ba231245?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=094b6d438c211b676d9e024016c66844, https://si.imgix.net/9d1eae63/uploads/origins/4cbe8918-d4e5-4e6e-b853-b944ba231245?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2eec0d0ad5ce132216b1e91f555c95be 2x, https://si.imgix.net/9d1eae63/uploads/origins/4cbe8918-d4e5-4e6e-b853-b944ba231245?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9669f16e859d283a5ccb402ca88354c3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shinashite/works/73", "thumbnail_src": "https://si.imgix.net/adfe50bf/uploads/origins/803e678c-c151-4f72-871e-1eaffd9787e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e5cd6a0c61ce573451adb5b666e3d4", "thumbnail_srcset": "https://si.imgix.net/adfe50bf/uploads/origins/803e678c-c151-4f72-871e-1eaffd9787e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e5cd6a0c61ce573451adb5b666e3d4, https://si.imgix.net/adfe50bf/uploads/origins/803e678c-c151-4f72-871e-1eaffd9787e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f8f1e8b1ea222ef1d19f25cf7d2312d 2x, https://si.imgix.net/adfe50bf/uploads/origins/803e678c-c151-4f72-871e-1eaffd9787e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6b23f6ff389c29a9c4d515c58819370 3x", "genre": "art", "nsfw": true, "body": "はじめまして。以前作成されていたVtuberの楠栞桜さんのイラストを拝見しまして、クオリティの高さに驚愕しました。それと同時に、是非あの作品の続きを描いていただきたいと思いリクエストを投稿させていただきました。\n\n気長にお待ちしておりますので、もしよろしければお願いいたします。\n\nシチュエーション\n監禁され、散々弄ばれた前回のイラストの続き。ついに膣内を犯され、襲い来る快感を必死に耐え抜こうとするも、抵抗むなしく絶頂を迎える。\n\n構図\n楠さんの正面が見える構図。目隠しをされて背面騎乗位の態勢で両足を開脚させられ、結合部が見える状態。上半身は脱衣の着衣。ニーソは履いたままで、脱がされたパンツが片足に引っかかっている形でお願いしたいです。（できれば手錠や、脚の拘束は前回のものを活かせたらなと思いますが、構図的に難しいようでしたら無しでも大丈夫で、おまかせ致します。）\n\n状態\n①背面騎乗位の態勢から散々焦らされた膣内をガンガン突かれている。目隠しをされて快感に無理やり意識を集中させられ、体が仰け反っている。喘ぎ声を出すまいと必死に耐え、フーッフーッと荒い息を立てている状況（ボールギャグをつけてても良いかなと思いますが、おまかせします）。\n②差分が可能であれば、押し寄せる快感の波に耐え切れず、最後には仰け反り絶頂して潮吹きをする姿をお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@shinashite/works/72", "thumbnail_src": "https://si.imgix.net/80ccc544/uploads/origins/c74ddd3d-2593-4ac0-a0d0-057ec0dbceb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6708a1250349a10a8bdfc319a6fc7f8", "thumbnail_srcset": "https://si.imgix.net/80ccc544/uploads/origins/c74ddd3d-2593-4ac0-a0d0-057ec0dbceb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6708a1250349a10a8bdfc319a6fc7f8, https://si.imgix.net/80ccc544/uploads/origins/c74ddd3d-2593-4ac0-a0d0-057ec0dbceb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17089a5da7e36c516a28e73221e4e375 2x, https://si.imgix.net/80ccc544/uploads/origins/c74ddd3d-2593-4ac0-a0d0-057ec0dbceb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b1bdb528420fe8e4b0c931073781d81 3x", "genre": "art", "nsfw": true, "body": "先生こんにちは！\nVTuberの一ノ瀬うるはが拘束されて電気アンマされているイラストが欲しいです！\n\n詳細\n・ベッドに大の字で拘束されている\n・電気アンマの指が膣に入っている&普通に電気アンマの差分が頂けると嬉しいです\n・服は半分脱がされている状態で乳首とクリトリスにはローターが付けられている状態\n他の細かいところは先生にお任せします！\n\n\n\n参考資料等は出せないので、イメージが湧かなかったらこの依頼は無視してもらって構いませんm(_ _)m\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@shinashite/works/71", "thumbnail_src": "https://si.imgix.net/f670c32e/uploads/origins/9ba11db2-004d-431a-8260-c762cb7bf94f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=175c00be547e7bb43e2142685189394a", "thumbnail_srcset": "https://si.imgix.net/f670c32e/uploads/origins/9ba11db2-004d-431a-8260-c762cb7bf94f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=175c00be547e7bb43e2142685189394a, https://si.imgix.net/f670c32e/uploads/origins/9ba11db2-004d-431a-8260-c762cb7bf94f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed1aa0e6436896f06278b39147247f7b 2x, https://si.imgix.net/f670c32e/uploads/origins/9ba11db2-004d-431a-8260-c762cb7bf94f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cee694e9bea781760ecc54d7da98ef2 3x", "genre": "art", "nsfw": true, "body": "キャラ　加藤段蔵（FGO）\n\nシチュ　事後（股間部を巨大ドリルで破壊されて敗北した後）\n　　　　完全に機能停止して地面に倒れている\n　　　　破損によって股間部や体の各所から潤滑液かなにかが漏れている\n　　　　股間部周りは破損が激しく、液が噴き出して小さな水たまりができている\n\nポーズ　うつ伏せ\n　　　　関節が壊れてかろうじて繋がっている、がに股みたいになった足\n\n表情　　地面に押し付けられて少し歪んだ頬\n　　　　力なく垂れた舌\n　　　　ほとんど白目を剥いた、輝きを失った濁った眼\n　　　　汚れか漏れ出た液体かで、涙を流しているように見える\n　　　　\nバッドエンドとかゲームオーバーみたいな、「もう助からない」というようなイメージでお願いします。\n以前リクエストしました加藤段蔵の絵が素晴らしかったので、その事後をリクエストさせていただきます。", "created_at": "", "completed_at": ""}, {"path": "/@shinashite/works/70", "thumbnail_src": "https://si.imgix.net/146523fe/uploads/origins/dc026340-9559-4bce-ab93-443bae503acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32091ef7c70d6e074deef474959fee64", "thumbnail_srcset": "https://si.imgix.net/146523fe/uploads/origins/dc026340-9559-4bce-ab93-443bae503acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32091ef7c70d6e074deef474959fee64, https://si.imgix.net/146523fe/uploads/origins/dc026340-9559-4bce-ab93-443bae503acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d920427e5b0ade9edfa7dcd96621569 2x, https://si.imgix.net/146523fe/uploads/origins/dc026340-9559-4bce-ab93-443bae503acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d72cf49a3b39873652e0a86f1124a176 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nポートフォリオ、pixivの作品を拝見して大変素晴らしく思いました！\n是非ともお願いしたいイラストがありまして、「艦これ」のフルカラーのＲ-18イラストをお願い致します\n\n◆大まかなシチュ\n「ふたなりの女性提督が暁に拘束され、膣をバイブ責めされながらオナホでペニスを扱かれる」というものです。\n\n※　女性提督、とは「艦隊これくしょん -艦これ-」に登場する、設定のない女性主人公です。\n\n◎女性提督のイメージ\n髪型・髪色のイメージ\nhttps://i.imgur.com/B2JdEyn.jpg\n服のイメージ\nhttps://i.imgur.com/RqiLKL4.jpg\n靴は黒いパンプス、靴下類は黒色のタイツです\n胸のボリュームは髪型・髪色のイメージとして挙げましたイメージの娘のように控えめです\n未奈來さんという方にイメージイラストを描いて頂いたことがありますがこちらも参考になればと思います\nhttps://skeb.jp/works/117506\n\n★シチュエーションの詳しいイメージ\n\n・かつて敵に捕まり、助平な拷問をされた女性提督はその際にペニスを生やされます\n　その後救出されますが、女性提督は毎晩ペニスの疼きに苦しみます\n・センズリを知らず、ペニスの疼きに苦しむ女性提督を助けたいという純粋な気持ちを抱く暁は抵抗する女性提督を馬力で押さえつけ、縛って拘束します(拘束の手段、道具はお任せします)\n・拘束を解けと言いながら暴れ、生やされたペニスでスカートが少し膨らんでいる女性提督を前にして暁は嬉しそうです\n・暁はバイブで女性提督の膣を刺激しながらオナホールで女性提督のペニスを扱いて吐精させます\n・バイブの形状や種類はお任せします(リモコン式 or 持ち手を握って操作するもの)\n・女性提督と暁の衣服は全て脱がさない様お願いします（プレイの都合上女性提督の衣服が乱されていたり、タイツの股間部分に穴が開けられているのは構いません）\n・行為中と女性提督絶頂(射精)後の差分をお願いします\n・背景や体位はお任せします　女性提督は下の毛は無しです\n・二人の表情もお任せしますが、絶頂後の女性提督には悔し涙を流して欲しいです\n\n是非ともご検討くださいます様、お願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@shinashite/works/69", "thumbnail_src": "https://si.imgix.net/87aeb92d/uploads/origins/22c1f33e-ee49-41ca-8cb4-8fd70b634a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c905dd12733d27c59a72d65047cab448", "thumbnail_srcset": "https://si.imgix.net/87aeb92d/uploads/origins/22c1f33e-ee49-41ca-8cb4-8fd70b634a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c905dd12733d27c59a72d65047cab448, https://si.imgix.net/87aeb92d/uploads/origins/22c1f33e-ee49-41ca-8cb4-8fd70b634a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31a4a4c1be9014f67569e79dac666bb3 2x, https://si.imgix.net/87aeb92d/uploads/origins/22c1f33e-ee49-41ca-8cb4-8fd70b634a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f67b8934f03f29e51c4ee1ecdcfd2204 3x", "genre": "art", "nsfw": true