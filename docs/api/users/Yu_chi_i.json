ter.com/Somen_Lucario/status/1263261203809239040", "created_at": "", "completed_at": ""}, {"path": "/@Yu_chi_i/works/3", "thumbnail_src": "https://si.imgix.net/1d103445/requests/269913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f28a7afa550bdd379a1db9d935be48", "thumbnail_srcset": "https://si.imgix.net/1d103445/requests/269913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f28a7afa550bdd379a1db9d935be48, https://si.imgix.net/1d103445/requests/269913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61410689c223791817c8e9931a988a34 2x, https://si.imgix.net/1d103445/requests/269913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94d8b5bdcbb0fdd23f36e5ff5a96584a 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nオリキャラ（リュガロ）が得意の格闘術で格好良い感じに構えている様子のイラストをスタイルにお任せしますので自由にどんな雰囲気でも構いませんのでお願いしたいです。\n\n参考画像\nhttps://drive.google.com/file/d/1FiGmonsltgfLreYDUyzKa-ub61HGXmEz/view", "created_at": "", "completed_at": ""}, {"path": "/@Yu_chi_i/works/2", "thumbnail_src": "https://si.imgix.net/38e05970/requests/229039_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e23232984fc6b2d2bc750e1965bfeab", "thumbnail_srcset": "https://si.imgix.net/38e05970/requests/229039_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e23232984fc6b2d2bc750e1965bfeab, https://si.imgix.net/38e05970/requests/229039_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecc9f267764146547d5e2c56648f1e16 2x, https://si.imgix.net/38e05970/requests/229039_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px