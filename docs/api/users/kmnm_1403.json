22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04dd4e7abb957a643b30d108d30c344", "thumbnail_srcset": "https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04dd4e7abb957a643b30d108d30c344, https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e27163c6925c2b506a3a31574d30d07 2x, https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95876b08aaaaa503d45bcb163e7359ec 3x", "genre": "art", "nsfw": true, "body": "こんにちは！前回の配信、本当にありがとうございました。もしよろしければ、また別のキャラクターを演じてほしいです。\n\n彼女は物静かな少女で、巨大な刃物を持っている。それは彼女の最愛の人の背骨をモデルにしたもので、だから彼女は剣と一緒に悪人を切り倒すことで、剣に近づこうとする。この復讐の旅は明らかに独りよがりなので、彼女の旅の荒々しさと最終的な憂鬱さを強調するようなものがいい。\n\nあなたのこの前の作品（https://x.com/kmnm_1403/status/1962456645273014674）のトーンが好きなので、彼女が髪を下ろして剣を引きずりながら歩く後ろ姿が描けたら素晴らしいです。たぶん背景は白で、彼女の剣が残した跡は血まみれです。もしよければ、どんなものができるか見てみたいです。\n\n資料の右端にある服を着た彼女を描いてほしい。たぶん、少し切り傷や涙がある。ここでも、ご自由にどうぞ。\n\nありがとうございました！\n\nhttps://photos.app.goo.gl/tnVep7ztKsJHszj18", "created_at": "", "completed_at": ""}, {"path": "/@kmnm_1403/works/7", "thumbnail_src": "https://si.imgix.net/cd4c0213/uploads/origins/df2c60cb-9af9-43c6-af1a-fbfc83aa6dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6490cf74f47005a2a92176f0786d5945", "thumbnail_srcset": "https://si.imgix.net/cd4c0213/uploads/origins/df2c60cb-9af9-43c6-af1a-fbfc83aa6dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6490cf74f47005a2a92176f0786d5945, https://si.imgix.net/cd4c0213/uploads/origins/df2c60cb-9af9-43c6-af1a-fbfc83aa6dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=545f2bcd222d84f28c0a106531a697b9 2x, https://si.imgix.net/cd4c0213/uploads/origins/df2c60cb-9af9-43c6-af1a-fbfc83aa6dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83b512da312d2c4dd47815b933abfffa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Xを見ていてあなたの作品を見つけ、ファンアート・ミームをとても楽しみました。Skebのリクエストも受け付けていることに気づいたので、送ってみることにしました。\n\n私の2人のOCがドアをノックしている「No, I'm not a Human」の世界のシーンを描いてほしいです。今までのSkebの作品のように、不気味でクレイジーな雰囲気で、私のOCがドアの前に立ち、中にいる人に「一人ですか？\n\n以下に2人のOCの参考資料とゲームのスクリーンショットを載せておきます。どちらも人間ではありません。もし何か不明な点があれば、遠慮なくリクエストを再送してもらって構わない。\n\n読んでくれて本当にありがとう！また機会がありましたら、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1dlaF3qBSQc6IXFPZq1hsXGfK29TKmQyR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kmnm_1403/works/6", "thumbnail_src": "https://si.imgix.net/9993719e/uploads/origins/988323eb-ae66-4949-a6d9-e6998c03e93a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f30195f33d748a6ad9102a0cb6c558e", "thumbnail_srcset": "https://si.imgix.net/9993719e/uploads/origins/988323eb-ae66-4949-a6d9-e6998c03e93a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f30195f33d748a6ad9102a0cb6c558e, https://si.imgix.net/9993719e/uploads/origins/988323eb-ae66-4949-a6d9-e6998c03e93a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e62b28e9176f4c342dffaf80270fe8f 2x, https://si.imgix.net/9993719e/uploads/origins/988323eb-ae66-4949-a6d9-e6998c03e93a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23e7eea62fd94328aa56b2805106b577 3x", "genre": "art", "nsfw": false, "body": "ハロー57！\n\nあなたが描いたゲームのアートワーク「No, I'm not a Human」を見つけました！57さんが描かれたゲーム「No.I'm not Human」の絵を見つけました。\nhttps://skeb.jp/@kmnm_1403/works/2\n\n「セリル」 https://drive.google.com/file/d/1RNv0ZqOJ2L-38ZMCISlTZ_4CzX0u_Tsu/view\nhttps://drive.google.com/file/d/1XFco8OLdE_zkSn5YpAnF4x8sqdVdhfua/view?usp=drive_link\n\nナイフを持っているところ、あるいはナイフを隠しているところを描いていただけませんか？後光はなくても構いません。キャプションは「癒しとヘッドパットが欲しい。入れてくれませんか？」「どうぞ、お入りください」「今すぐお帰りください」。\n\nこの写真をソーシャルメディアで使いたい。クレジットさせていただきます。\