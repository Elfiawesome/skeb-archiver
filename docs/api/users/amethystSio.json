leted_at": ""}, {"path": "/@amethystSio/works/13", "thumbnail_src": "https://si.imgix.net/10fbad2d/uploads/origins/a8f7db5f-cbad-472f-afe0-04630f89e4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9607c54b9c0f69a722b62afbf10aa8d0", "thumbnail_srcset": "https://si.imgix.net/10fbad2d/uploads/origins/a8f7db5f-cbad-472f-afe0-04630f89e4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9607c54b9c0f69a722b62afbf10aa8d0, https://si.imgix.net/10fbad2d/uploads/origins/a8f7db5f-cbad-472f-afe0-04630f89e4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67c5d1d5c0e0799f38a9e29b686d586f 2x, https://si.imgix.net/10fbad2d/uploads/origins/a8f7db5f-cbad-472f-afe0-04630f89e4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=309d49272143f6c93857771a38a22fd8 3x", "genre": "art", "nsfw": false, "body": "はじめまして、アピールをありがとうございます！　\nとてもきれいな筆のタッチに心惹かれてリクエストをお送りさせて頂きました！よろしければうちの子ドラゴンを描いて頂きたいです！\n\nお願いしたい子は、秋空かぐねと言う東洋龍です！\n出来れば全身像を描いて頂きたいです！\nポーズや構図などは全てお任せでお願い出来ます！\n\nご縁がありましたら是非よろしくお願い致します……！！\n\nlit.linkのツイフィールにこのキャラの詳しい設定等がありますのでそちらもご参考にお願い致します！\n\n秋空かぐね参照X（元Twitter）URL\nhttps://x.com/kagune_dragon12/status/1763843318608466250\n\nhttps://lit.link/kagune01414", "created_at": "", "completed_at": ""}, {"path": "/@amethystSio/works/12", "thumbnail_src": "https://si.imgix.net/1fd8b0df/uploads/origins/94f01014-d5ad-4fd0-9186-3e4e23acb2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88227559ffa9b739721fa2b6e2562f6d", "thumbnail_srcset": "https://si.imgix.net/1fd8b0df/uploads/origins/94f01014-d5ad-4fd0-9186-3e4e23acb2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88227559ffa9b739721fa2b6e2562f6d, https://si.imgix.net/1fd8b0df/uploads/origins/94f01014-d5ad-4fd0-9186-3e4e23acb2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a65b0db10ec48ae939d6ca8710f44ed2 2x, https://si.imgix.net/1fd8b0df/uploa