52-40c0-8514-5114f35d3563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f57f663ae9a92c63e6611c6871c5f1a", "thumbnail_srcset": "https://si.imgix.net/13168adb/uploads/origins/cff3d59d-8952-40c0-8514-5114f35d3563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f57f663ae9a92c63e6611c6871c5f1a, https://si.imgix.net/13168adb/uploads/origins/cff3d59d-8952-40c0-8514-5114f35d3563?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d5a16da6db1b319839c3df2ea7044bf 2x, https://si.imgix.net/13168adb/uploads/origins/cff3d59d-8952-40c0-8514-5114f35d3563?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58ce5e0e19a49177e7bee268c4581abf 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私はあなたの以前の作品が大好きです！\n\n参考画像の「ポーズ」のように四つん這いになってほしい。その下にある街は大きく傷ついていてほしい。街を破壊した後、体を持ち上げているように。遊び心のある表情で。街はミサイルやジェット機で彼女を攻撃しようとしている。\n\nあとはパースや構図はお任せします。お好きなように服の一部を活用して楽しんでください！\n\nhttps://drive.google.com/drive/folders/1Xy0jKG_ewlWhc7D5D-5y_f-IxVbRUMJw?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/54", "thumbnail_src": "https://si.imgix.net/65a23b9f/uploads/origins/d9928d1c-a63c-4ce9-bc12-ee9a26c1f0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60602c9d60c87a3eb356efa78155b4d5", "thumbnail_srcset": "https://si.imgix.net/65a23b9f/uploads/origins/d9928d1c-a63c-4ce9-bc12-ee9a26c1f0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60602c9d60c87a3eb356efa78155b4d5, https://si.imgix.net/65a23b9f/uploads/origins/d9928d1c-a63c-4ce9-bc12-ee9a26c1f0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc8edd2496358e29cd7a19a4cbe06b46 2x, https://si.imgix.net/65a23b9f/uploads/origins/d9928d1c-a63c-4ce9-bc12-ee9a26c1f0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e546ce3123d531f8cff17eff7faadf65 3x", "genre": "art", "nsfw": true, "body": "kkさんこんにちは。\n津島善子のイラストをお願いします。\n街の中にいる巨大な善子ちゃんを描いてください。暴れ回ったばかりで、今は欲情しています。彼女は街中に全裸で座り込み、高層ビルを使って自慰行為にふけります。片手で自慰に使うビルを握りしめ、もう片方の手で体を支えるため、街の一部を押しつぶしています。周囲のビルは、彼女のオナニー中の不注意と、それ以前の暴れ回った結果、破壊されています。\n以上ご検討の程よろしくお願い致します。\n\nhttps://imgur.com/a/MtFTio2", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/53", "thumbnail_src": "https://si.imgix.net/a2c86570/uploads/origins/81dfdbec-8dbb-44d5-a5c7-1070f3b8766a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42309c3a7f7a65c1d4204c9932510591", "thumbnail_srcset": "https://si.imgix.net/a2c86570/uploads/origins/81dfdbec-8dbb-44d5-a5c7-1070f3b8766a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42309c3a7f7a65c1d4204c9932510591, https://si.imgix.net/a2c86570/uploads/origins/81dfdbec-8dbb-44d5-a5c7-1070f3b8766a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a72c76b55f7c7e5a33c5159b4867c5e 2x, https://si.imgix.net/a2c86570/uploads/origins/81dfdbec-8dbb-44d5-a5c7-1070f3b8766a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecaaefc932e06e319c58fcef33275cff 3x", "genre": "art", "nsfw": true, "body": "初めまして、ナーヴと申します。\n描かれているイラストに惹かれたのでリクエストをさせてください。\n\nキャラクター：\n珊瑚宮 心海（原神のキャラクター）\nhttps://wiki.hoyolab.com/pc/genshin/entry/25\nhttps://dic.pixiv.net/a/%E7%8F%8A%E7%91%9A%E5%AE%AE%E5%BF%83%E6%B5%B7\n\nシチュエーション：\nビル街や都市部を微笑みながら楽しそうに踏み荒らしているところをお願いします。\n\n大きさ：\n数千倍サイズ\n\n詳細：\nとにかく破壊描写が好きなので、\n街が破壊されて建物が壊れていたり火事になっていたりという様子や踏みつぶされた地形が分かる描写が多いと嬉しいです。\n足裏や靴裏を描かれる際はしっかり土や瓦礫などで汚れていると嬉しいです。\n履物については靴有りでも無しでも素足でも問題ないのでお任せします。\n\n構図：\nキャラクターと破壊されている地上がバランスよく見える構図か、やや見上げ系の構図を希望します。\n\n個人的なお願い：\n小人が直接映っていたり戦車や戦闘機が居たりの描写が苦手なので、そこは省略していただけると助かります。\nちなみに自動車や電車、旅客機などは人が映っていなければ問題ありません。\nまた、オノマトペや吹き出しは不要です。\n\n\n以上、問題なければよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/52", "thumbnail_src": "https://si.imgix.net/fb4e1956/uploads/origins/ff07c748-6258-4ceb-95db-6e9eac4061ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba237b2321e2ac750bf0d1e07e4afbb0", "thumbnail_srcset": "https://si.imgix.net/fb4e1956/uploads/origins/ff07c748-6258-4ceb-95db-6e9eac4061ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba237b2321e2ac750bf0d1e07e4afbb0, https://si.imgix.net/fb4e1956/uploads/origins/ff07c748-6258-4ceb-95db-6e9eac4061ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2362b9cbc8d05de7f182859fc76a05d6 2x, https://si.imgix.net/fb4e1956/uploads/origins/ff07c748-6258-4ceb-95db-6e9eac4061ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad6c926c8d88f8711e2cc9242fa877ff 3x", "genre": "art", "nsfw": true, "body": "こんなに早く再開するとは思わなかった！\n天使の女の子のアートピースがまた欲しかったんだ。\nギガサイズの彼女が大陸に腹ばいになって横たわっているのが欲しかったんだ。\n少し足を広げて横たわっている彼女の股間に近い街。\nフォルダの中の「ポーズ・リファレンス」画像に似ている。\n股間の近くにある都市のクローズアップを示す小さなパネルを追加できれば最高だ！\n片足の膝を曲げて足を上に向ける。\n笑顔でカメラを振り返る。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1qJMhNQqsuBS_JVTw1_RzFPzmf2AyrmL_", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/51", "thumbnail_src": "https://si.imgix.net/9572a87f/uploads/origins/b5800e44-cd40-43ad-b8bd-6c447000cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd20746ff2dfa4a811f2d99553d1099c", "thumbnail_srcset": "https://si.imgix.net/9572a87f/uploads/origins/b5800e44-cd40-43ad-b8bd-6c447000cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd20746ff2dfa4a811f2d99553d1099c, https://si.imgix.net/9572a87f/uploads/origins/b5800e44-cd40-43ad-b8bd-6c447000cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12c05c8dfb3907603368f397f0bb7449 2x, https://si.imgix.net/9572a87f/uploads/origins/b5800e44-cd40-43ad-b8bd-6c447000cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32a04a92d4d0e9d1f46089d0842ae532 3x", "genre": "art", "nsfw": true, "body": "私はあなたの芸術を愛しています！\n\nキャラクターは金色のドラゴンレディ。彼女のおさげ髪にはドラゴンの生命が宿っている。  彼女はとてもミニマムな金色のチーパオを着ています。  彼女が巨大な胸を持ち上げて、おっぱいを中心に、いくつかの街や山の向こうのギガサイズでお願いします。  裸バージョンもお願いします。\n\nよろしくお願いします！\n\n参考文献\n\nhttps://drive.google.com/drive/folders/1mUJax2Yx8oa_4eL7Qevb_UTyw1Elg2ag?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/50", "thumbnail_src": "https://si.imgix.net/26aa6497/uploads/origins/a03ba1b0-282a-435b-bd65-ed8a99c3a408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906537a876f000d35eceea50ca5ec8c9", "thumbnail_srcset": "https://si.imgix.net/26aa6497/uploads/origins/a03ba1b0-282a-435b-bd65-ed8a99c3a408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906537a876f000d35eceea50ca5ec8c9, https://si.imgix.net/26aa6497/uploads/origins/a03ba1b0-282a-435b-bd65-ed8a99c3a408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cebb54c0d0a3c00ed17615f288cd6197 2x, https://si.imgix.net/26aa6497/uploads/origins/a03ba1b0-282a-435b-bd65-ed8a99c3a408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7594509e802c580c08e32c1fc817ff47 3x", "genre": "art", "nsfw": true, "body": "私は、宇佐美すみれ子が〜200kmで巨大化し、風景の上を歩き、カメラアングルは下から彼女を見上げるような写真が欲しい。彼女の身体は資料のようにとても曲線的で、手袋をはめた手に携帯電話を持ち、ドヤ顔で微笑んでいる。彼女の靴は蹴り飛ばされ、太ももまである靴下のような足が眼下の街やビルを押し潰し、白と紫のストライプのパンティーの中からカモシカの爪が見える。ご清聴ありがとうございました！\n\nhttps://files.sizecraft.net/~catadioptrictrap/commission_refs/kk528956/2025-11-13_Sumireko/", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/49", "thumbnail_src": "https://si.imgix.net/659dafc6/uploads/origins/f23377b3-665a-4f08-b899-53685b3e3b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9f1d1db5a599f8c89a52d429d8795d", "thumbnail_srcset": "https://si.imgix.net/659dafc6/uploads/origins/f23377b3-665a-4f08-b899-53685b3e3b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9f1d1db5a599f8c89a52d429d8795d, https://si.imgix.net/659dafc6/uploads/origins/f23377b3-665a-4f08-b899-53685b3e3b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c2b7ae7c0c104703d9924456ab8d1c 2x, https://si.imgix.net/659dafc6/uploads/origins/f23377b3-665a-4f08-b899-53685b3e3b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ec80165ea08e52197d3d67763723a0 3x", "genre": "art", "nsfw": true, "body": "kkさんこんにちは。\nブルアカのイチカで依頼します。\n\nサイズは東京をお尻で全て覆う程で、ローアングル視点で東京をお尻で踏み潰し、瓦礫たちが全体にこびりついたお尻と潰した東京を見るイチカをお願いします。表情はお任せします。\n犠牲者数(1000万以上)も載せてくださると嬉しいです。\n\n別イラストも可能であれば、素足姿でしゃがみながらクレーター化した東京を見るイチカもお願いします。こちらも表情はお任せして犠牲者数も載せてくださると嬉しいです。\n\n是非よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/48", "thumbnail_src": "https://si.imgix.net/d4651a6c/uploads/origins/ec17b570-a374-4e01-8dd7-9aac9584d554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=133b8111cfbfcc47ea289609767b6198", "thumbnail_srcset": "https://si.imgix.net/d4651a6c/uploads/origins/ec17b570-a374-4e01-8dd7-9aac9584d554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=133b8111cfbfcc47ea289609767b6198, https://si.imgix.net/d4651a6c/uploads/origins/ec17b570-a374-4e01-8dd7-9aac9584d554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccd0005f739cbb0d4c30efe4bc24da50 2x, https://si.imgix.net/d4651a6c/uploads/origins/ec17b570-a374-4e01-8dd7-9aac9584d554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbae69f328909d78ce8ce650e99032e0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kk528956/works/47", "thumbnail_