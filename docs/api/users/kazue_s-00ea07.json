-4a54-a28c-223d2cac9a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf298e9c40a1259aa5c3c3a7c31dce3", "thumbnail_srcset": "https://si.imgix.net/3bdf6510/uploads/origins/5af63dfa-6afa-4a54-a28c-223d2cac9a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf298e9c40a1259aa5c3c3a7c31dce3, https://si.imgix.net/3bdf6510/uploads/origins/5af63dfa-6afa-4a54-a28c-223d2cac9a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=065f99782286612927e66f3c03c4a53c 2x, https://si.imgix.net/3bdf6510/uploads/origins/5af63dfa-6afa-4a54-a28c-223d2cac9a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87beacf05eb6f07c2050e6fb9152d87c 3x", "genre": "art", "nsfw": false, "body": "前作の神夜のヒロピン作品の対となる内容を依頼します\n\n大まかな依頼内容\nネージュの戦闘中のヒロピン一枚絵\n\nキャラ\n無限のフロンティア　ネージュ・ハウゼン\n\n衣装等\n通常の衣装で一部破損\n\n対戦相手(シルエット、腕だけ等、省略可能)\n無限のフロンティア　毒馬頭\n\n細部\n・ネージュと毒馬頭の一対一の戦闘\n・ネージュは武器を落され素手で抵抗中(落とされた武器の描写必要無し)\n・ネージュの怪我等は無し\n\nその他\n記載以外の内容及び細部はお任せします", "created_at": "", "completed_at": ""}, {"path": "/@kazue_s/works/51", "thumbnail_src": "https://si.imgix.net/07c33211/uploads/origins/959e9e21-8c4d-4e21-8997-781eb5770ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b270e65cf9dcaacafb586a6158c244", "thumbnail_srcset": "https://si.imgix.net/07c33211/uploads/origins/959e9e21-8c4d-4e21-8997-781eb5770ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b270e65cf9dcaacafb586a6158c244, https://si.imgix.net/07c33211/uploads/origins/959e9e21-8c4d-4e21-8997-781eb5770ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9a05f1837009b9a6ba7e374d197beb5 2x, https://si.imgix.net/07c33211/uploads/origins/959e9e21-8c4d-4e21-8997-781eb5770ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b820f2bbe8d0a5b5e95e840ec4268659 3x", "genre": "art", "nsfw": false, "body": "過去作の神夜のヒロピン作品が良かったので依頼します\n\n大まかな依頼内容\n神夜の戦闘中のヒロピン一枚絵\n\nキャラ\n無限のフロンティア　楠舞神夜\n\n衣装等\n通常の衣装、髪は下ろした状態\n\n対戦相手(シルエット、腕だけ等、省略可能)\n無限のフロンティア　毒牛頭\n\n細部\n・神夜と毒牛頭の一対一の戦闘\n・神夜は武器を落され素手で抵抗中(落とされた武器の描写必要無し)\n・戦闘により神夜の髪止めが飛ばされて、髪は下ろした状態\n・嫁にするのが目的の毒牛頭は、神夜を傷つけるつもりはないため、神夜の怪我等は無し\n\nその他\n記載以外の内容及び細部はお任せします", "created_at": "", "completed_at": ""}, {"path": "/@kazue_s/works/50", "thumbnail_src": "https://si.imgix.net/6aaa2bf8/uploads/origins/d72d1ef3-fa4e-456f-a6b4-3f604bbefce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=007daa0317d5146a507d71e81d353aea", "thumbnail_srcset": "https://si.imgix.net/6aaa2bf8/uploads/origins/d72d1ef3-fa4e-456f-a6b4-3f604bbefce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=007daa0317d5146a507d71e81d353aea, https://si.imgix.net/6aaa2bf8/uploads/origins/d72d1ef3-fa4e-456f-a6b4-3f604bbefce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3412c7dc31a8c8e76aa438fe79c8b9bc 2x, https://si.imgix.net/6aaa2bf8/uploads/origins/d72d1ef3-fa4e-456f-a6b4-3f604bbefce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be20cd2ac99ce57dde962ddfbe552740 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazue_s/works/49", "thumbnail_src": "https://si.imgix.net/ad9a5eb1/uploads/origins/211d23dc-6405-436d-90a1-5092ce7040e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a4a19fb839470096826cc81d3833114", "thumbnail_srcset": "https://si.imgix.net/ad9a5eb1/uploads/origins/211d23dc-6405-436d-90a1-5092ce7040e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w