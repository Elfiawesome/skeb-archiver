8db2-cda26d0e5ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58c769d0ea7cec544e266eae587c56b5 2x, https://si.imgix.net/f26ed67b/uploads/origins/bad2419c-0691-4bc2-8db2-cda26d0e5ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38981d8c2e47cb8be70e4bcfdfddd518 3x", "genre": "art", "nsfw": false, "body": "前回も素敵なイラストをありがとうございました。\n別のシチュエーションのスメラギ君を見たいと思いまして、リクエスト差し上げました。\n\nスメラギ君が任務と剣の修行のために海を隔てた大陸に向かう途中、船の縁に立って、初めて訪れる異国の地に期待を馳せているような、明るい表情で船の進行方向を眺めている……といった感じでお願いできないでしょうか。\n着衣は前回までと同様で、額のハチマキが海風を受けてふわっと揺れているような感じで。\n（資料URLにおおまかな位置など記載していますので、ご参照ください。\n船はお手間がかからない範囲で、スメラギ君の周囲だけ描いていただければ問題ございません）\n\nご検討くださいましたら幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KexlkXqoteOqxa_RqtmGr1WSqbj71XEv?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@asaumelove2/works/36", "thumbnail_src": "https://si.imgix.net/21d673c2/uploads/origins/5af700f2-64d4-4c40-b0f1-3ed233fb87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b1851ce69b9d0f54cdbefaefc41d707", "thumbnail_srcset": "https://si.imgix.net/21d673c2/uploads/origins/5af700f2-64d4-4c40-b0f1-3ed233fb87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b1851ce69b9d0f54cdbefaefc41d707, https://si.imgix.net/21d673c2/uploads/origins/5af700f2-64d4-4c40-b0f1-3ed233fb87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1012f0b8c8238c2854f1b121562cbb8 2x, https://si.imgix.net/21d673c2/uploads/origins/5af700f2-64d4-4c40-b0f1-3ed233fb87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d4a911e6dc53dd54df826bc47407bc4 3x", "genre": "art", "nsfw": false, "body": "やあ、アサ、\n\nあなたの絵がとても気に入ったので、私のキャラクターの絵をお願いしたいと思います！\nテーマはハロウィンです。\n\n衣装ハロウィン衣装（ヴァンパイア、ゴーストなど）\nポーズカボチャを彫ってハロウィンの準備をしている様子\n\nこのアートはソーシャルメディア（Twitter）の投稿やストリームの目的で使用する予定です。可能であれば背景透過のpngバージョンもお願いします。ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1CHNL5xKKG6s0AGx2OdQwXM9vm1Y9nbJe?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@asaumelove2/works/35", "thumbnail_src": "https://si.imgix.net/75dbafaa/uploads/origins/e5166ac4-fd6f-47ea-a60f-35b2a3b5ca3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7bd1545298f03a9ed283924e08a44a", "thumbnail_srcset": "https://si.imgix.net/75dbafaa/uploads/origins/e5166ac4-fd6f-47ea-a60f-35b2a3b5ca3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7bd1545298f03a9ed283924e08a44a, https://si.imgix.net/75dbafaa/uploads/origins/e5166ac4-fd6f-47ea-a60f-35b2a3b5ca3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c99c3292f7149db0c1914714d224133e 2x, https://si.imgix.net/75dbafaa/uploads/origins/e5166ac4-fd6f-47ea-a60f-35b2a3b5ca3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4706c886b870ae32c3b352c0820532a4 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n\n前回依頼して書いていただいたイラストがとてもよかったので再度イラストをお願いできればと思います。\n\n今回お願いしたいのはクリスマス用のイラストになります。\n\n前回はソラのみだったのですが、先日、弟（男の娘）のりくもデビューしたので、その2人を描いていただきたいです。\nクリスマスがテーマでお願いしたくて、詳細なシチュエーションはお任せしますが、今回はネップリにてリスナーにも提供したいと考えております。\n\n利用用途は、個人観賞、PC壁紙への利用、SNSや配信での紹介、ネップリによるリスナーへの提供　になります。\n\nご検討宜しくお願い致します。\n\n\n【キャラクター資料】\n\n①犬走ソラ\nhttps://drive.google.com/file/d/1uHURYCbhcNdkXGLHDUysiretb6v1TMPa/view?usp=sharing\nhttps://drive.google.com/file/d/1bgz5LFbVLu0dvYnWjNyXr4E76S5rAV4b/view?usp=sharing\n\n②犬走りく\nhttps://drive.google.com/file/d/1ppEry0jOcklpQNczaHg6ApXWsBwoqY-h/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@asaumelove2/works/34", "thumbnail_src": "https://si.imgix.net/52dd487d/uploads/origins/be158236-de45-4e4b-8a4f-abcf7666ec3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=affb938a5dc706a6176d7f9e35cfd04c", "thumbnail_srcset": "https://si.imgix.net/52dd487d/uploads/origins/be158236-de45-4e4b-8a4f-abcf7666ec3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=