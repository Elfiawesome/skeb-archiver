loads/origins/de7a34b2-ba9f-4ee8-bfd8-ece78f8d4eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=448a67f9d4711636af7e3341a371a56b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hisashiyo_0705/works/81", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/cf455318/uploads/origins/9e4b2db3-08a0-4655-9fe5-c747f23ae965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e928890fc8899a096f2f73845a847d18", "thumbnail_srcset": "https://si.imgix.net/cf455318/uploads/origins/9e4b2db3-08a0-4655-9fe5-c747f23ae965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e928890fc8899a096f2f73845a847d18, https://si.imgix.net/cf455318/uploads/origins/9e4b2db3-08a0-4655-9fe5-c747f23ae965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13d9780d801664b38aac8c9813fb5f77 2x, https://si.imgix.net/cf455318/uploads/origins/9e4b2db3-08a0-4655-9fe5-c747f23ae965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=621bb1f409443a65a14a207d081f8046 3x", "genre": "art", "nsfw": true, "body": "街に突如として出現した巨大触手を退治する為、権能を使い巨大化し、触手に立ち向かうも返り討ちに遭い無様に敗北するギュウマオウCEO（登場作品：東京放課後サモナーズ）をリクエストします。\n手足を捕まれ大の字で宙吊りにされ身動きが取れなくなったギュウマオウCEOが、\n逞しい大胸筋に佇む2つの黒乳首に、先端が針のついた触手が襲い掛かりブスリと乳首を刺され、淫毒をドクドク流し込まれて乳首はサイズも感度も倍倍倍化し、乳首がスカイベリー位に膨れ上がった所で針を引き抜かれ、その数秒後に時間差でギュウマオウが雄叫びを上げながら股間の火焔山が噴火してしまう、というシチュエーションです。\n何卒お願い致します", "created_at": "", "completed_at": ""}, {"path": "/@hisashiyo_0705/works/80", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/ebad012f/uploads/origins/c18a3dda-2b0d-469b-b61b-591743e362ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a932e51e860da89b1f9b5796f4206527", "thumbnail_srcset": "https://si.imgix.net/ebad012f/uploads/origins/c18a3d