す。\n\nその後、先ずはおしっこを瞳にかけ、そこから瞳に脱糞をするといった流れでお願いします。\nまた、ウンチは硬くもなくビチビチでもない、健康的なモノが良いです。\n\nアニメでは夕暮れでしたが、見やすくするために日中にして頂いて構いません\n\nまた、カットインで瞳からの視点をお願いしていたのですが、\nトイレ盗撮でカメラの上にかける的な“いつものやつ”をお願いいたします。\n初めてのskeb利用なので、至らない文章になってしまいましたが、どうぞ検討の程よろしくお願いいたします。\n\nこれからも応援させていただきたいと思います", "created_at": "", "completed_at": ""}, {"path": "/@ISSAgaJlEk47HLk/works/181", "thumbnail_src": "https://si.imgix.net/8ea9de8c/uploads/origins/811d7070-7a29-4e6e-a677-cf9be6662414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cef44e5c4f37afedcdd45553e7a8f24f", "thumbnail_srcset": "https://si.imgix.net/8ea9de8c/uploads/origins/811d7070-7a29-4e6e-a677-cf9be6662414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cef44e5c4f37afedcdd45553e7a8f24f, https://si.imgix.net/8ea9de8c/uploads/origins/811d7070-7a29-4e6e-a677-cf9be6662414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=150c7a57f7766dcaf23652b17e4af902 2x, https://si.imgix.net/8ea9de8c/uploads/origins/811d7070-7a29-4e6e-a677-cf9be6662414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a669eeea88e4b9c94315a4e643f3b6dc 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ISSAgaJlEk47HLk/works/180", "thumbnail_src": "https://si.imgix.net/5de08582/uploads/origins/73e20571-0f49-4ffe-832c-dc162b56a12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecb76a5b803ffa9e48153b496dfe38c9", "thumbnail_srcset": "https://si