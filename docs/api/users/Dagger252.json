r=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25611bb0b38349a1910245ba81ac1e8a 2x, https://si.imgix.net/a9f25a05/uploads/outputs/2c0b46cf-f545-467f-894b-35e95df9162a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=435d3f926f82610d123aa9394b00ec95 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Dagger252/works/52", "thumbnail_src": "https://si.imgix.net/2ef288e0/uploads/outputs/aee37d6f-962e-4ff9-a5f5-75e3516e74b0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=0396a2c3114c452bade222cc76d8a342", "thumbnail_srcset": "https://si.imgix.net/2ef288e0/uploads/outputs/aee37d6f-962e-4ff9-a5f5-75e3516e74b0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=0396a2c3114c452bade222cc76d8a342, https://si.imgix.net/2ef288e0/uploads/outputs/aee37d6f-962e-4ff9-a5f5-75e3516e74b0?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=db84a8423dae15c9bf5993213a7a2b80 2x, https://si.imgix.net/2ef288e0/uploads/outputs/aee37d6f-962e-4ff9-a5f5-75e3516e74b0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=698aca9ed1fbb4d062937e8336c40751 3x", "genre": "video", "nsfw": false, "body": "はじめまして！あなたの素晴らしい戦闘モーションのスプライトアニメーションを見ました。私のキャラクター \"Amp \"の一人にベアハッグアタックをさせたいと思っています！https://drive.google.com/drive/folders/117jw6ZxafXbcRArXTdJIB9_kBxLBLMKv、彼女は体が小さいにもかかわらず、超強力にパワーアップすることができます！\n私のアイデアは、彼女が攻撃（パンチなど）をブロックしてカウンターし、相手を4重のベアハッグアタックで引っ張るというものです。攻撃は毎回強くなり、相手は力で曲がる。最初の2回は同じだけど、その後の2回はより強力になる。\n\nできれば、「アンプ」の技は、普段の対戦相手である「ルティア」（小柄だがふくよかな体型）や、扇風機を使うOCにも使ってもらいたい。\nルティアの審判 https://drive.google.com/drive/folders/1dTB_oJ2L-tjfCYBpc-rMNFNLhoIdmLl_\n内気で消極的な性格で、争いごとが嫌いだが、武術の才能があるので \"アンプ \"とよく練習している。「ルティア」が望ましい。", "created_at": "", "completed_at": ""}, {"path": "/@Dagger252/works/51", "thumbnail_src": "https://si.imgix.net/b30a9f69/uploads/origins/933d1f35-0b19-4adf-af57-c3a98b54c084?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f5820fc56d07f8c6c8aadcaec5eecea", "thumbnail_srcset": "https://si.imgix.net/b30a9f69/uploads/origins/933d1f35-0b19-4adf-af57-c3a98b54c084?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f5820fc56d07f8c6c8aadcaec5eecea, https://si.imgix.net/b30a9f69/uploads/origins/933d1f35-0b19-4adf-af57-c3a98b54c084?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6d7765e0e255cf422cd4c97a89f54bb 2x, https://si.imgix.net/b30a9f69/uploads/origins/933d1f35-0b19-4adf-af57-c3a98b54c084?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4a4cc3279eb2cb68f908a114446cbd9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Dagger252/works/50", "thumbnail_src": "https://si.imgix.net/47732aae/uploads/origins/1636d143-8d98-4a38-a0c9-c30058d1a2c3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e44b8600b5d3d3936bfae5ccbf4f818f", "thumbnail_srcset": "https://si.imgix.net/47732aae/uploads/origins/1636d143-8d98-4a38-a0c9-c30058d1a2c3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e44b8600b5d3d3936bfae5ccbf4f818f, https://si.imgix.net/47732aae/uploads/origins/1636d143-8d98-4a38-a0c9-c30058d1a2c3?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fd2515db3efd833088ef054ecf0ca55 2x, https://si.imgix.net/47732aae/uploads/origins/1636d143-8d98-4a38-a0c9-c30058d1a2c3?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=52ea32cfaae708fe3bbca4bdc78c954d 3x", "genre": "art", "nsfw": false, "body": "ダガー麺さん、はじめまして！\nこれまでのスプライトやアニメーションの作品を拝見し、とても素晴らしいと感じました。ぜひ僕のキャラクター「ネコ」を描いていただきたく、ご依頼いたします。\n\n彼はプロレスラーで、特に圧倒的な強敵を倒すことに非常に興奮します。彼は非常に強いプロレスラーで、筋肉質な体格をしており、相手をサブミッションホールドで屈服させることを楽しんでいます。対戦相手が「ギブ！」と叫ぶのを聞くことが、彼にとって最大のスリルです。彼は猫のような特徴（微笑んだときに見える小さな牙）を持っていますが、瞳孔は人間らしい形をしています。特に際立っている特徴は、光を反射して美しく輝く青い目と、腰の「アポロの帯」（V字ライン）が際立つ筋肉質な体格です。\n\n今回お願いしたいのは二つのポーズです。\n1つ目は立ち姿のアイドルアニメーションで、戦闘ポーズを取っている姿です。スタンスは「ネコのスタンス」という画像のように、動きや全体の雰囲気はRock Howard（例１）のような感じを希望します。このポーズではレスリングベストは着用せずにお願いいたします。\n\n2つ目は「例２」に近いイメージで、リングイン時にポーズではレスリングベストを勢いよく脱ぎ捨て、相手を自信満々に見据えるシーンをお願いしたいです。\n\nどちらのポーズも、力強さと自信に満ち溢れ、まるで自分の実力に絶対の確信を持っているような雰囲気で表現していただければ幸いです。ネコをとても逞しく描いていただけると嬉しいです！\n\nご検討のほど、どうぞよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/lkyp4hacjpx8usxn8v3y0/AH9-R05tTVKhZVTy9zisAGo?rlkey=9y4r9mfus6ni3nu7ezkd1s1tb&st=e2sagbmp&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Dagger252/works/49", "thumbnail_src": "https://si.imgix.net/57af15be/uploads/origins/fcfbe48b-d424-4665-8a53-6d52bca56e6e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7af1bb18db0c3fe4a955b4642df522d0", "thumbnail_srcset": "https://si.imgix.net/57af15be/uploads/origins/fcfbe48b-d424-4665-8a53-6d52bca56e6e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7af1bb18db0c3fe4a955b4642df522d0, https://si.imgix.net/57af15be/uploads/origins/fcfbe48b-d424-4665-8a53-6d52bca56e6e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b0213668b3ed40d450c3e705d75db1a 2x, https://si.imgix.net/57af15be/uploads/origins/fcfbe48b-d424-4665-8a53-6d52bca56e6e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=97ad96756382033527ac86e45a8caced 3x", "genre": "art", "nsfw": false, "body": "Hello there,\nI'd like to request a looping animation of my cowgirl OC, Sabrina.\nShe's kneeling down on one knee, ready to fire an expendable anti tank launcher (EATL). When she fires it, there is a large backblast from the back. Afterwards, Sabrina will discard the EATL and then pull a new one out of her large cleavage, as if there's an infinite number of them in her cleavage.\nPlease it seem somewhat comedic and completely normal for her. If possible, please highlight the fact that she is 230cm tall, so the EATLs look a bit small, as they're made for regular people. The design of the EATL can be any, preferably an AT4.\nFeel free to make any adjustments as you see fit.\nI look forward to your work!\n\nSabrina: https://photos.app.goo.gl/DFmVSrj8HnNHuPjr5\nIdea: https://photos.app.goo.gl/9nZDeoiXhr8HmT1s5", "created_at": "", "completed_at": ""}, {"path": "/@Dagger252/works/48", "thumbnail_src": "https://si.imgix.net/d1e423b5/uploads/origins/aff7c82f-ea03-47ca-87e5-790466903ca7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=50c4688deda29e2e199fed5d9d4ff449", "thumbnail_srcset": "https://si.imgix.net/d1e423b5/uploads/origins/aff7c82f-ea03-47ca-87e5-790466903ca7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=50c4688deda29e2e199fed5d9d4ff449, https://si.imgix.net/d1e423b5/uploads/origins/aff7c82f-ea03-47ca-87e5-790466903ca7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a1490837f1cc13d268af65dd1a284d 2x, https://si.imgix.net/d1e423b5/uploads/origins/aff7c82f-ea03-47ca-87e5-790466903ca7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=52e345fd8030487cfd0f473508a26599 3x", "genre": "art", "nsfw": false, "body": "あなたの作品が大好きです！私のキャラクター、ヘウォンをリクエストしたいです。彼女は闇の怪物（まどか☆マギカのような）と戦う魔法少女です。彼女は歌で味方の感情をコントロールし、戦闘を有利にします（心の琴線や吟遊詩人のインスピレーションを調整する）。\n\n彼女の周りに音符の矢を飛ばしてもらえると嬉しい。彼女の武器を入れるかどうかは自由です。他にポーズのアイデアがあれば、お任せします！\n\nhttps://drive.google.com/drive/folders/1SbONj1xme0l5hxaTazKrhVm0SqnUEPls?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Dagger252/works/47", "thumbnail_src": "https://si.imgix.net/c19662fa/uploads/origins/050a0e4c-9f78-4d66-a2af-d1d9d6aa88be?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=