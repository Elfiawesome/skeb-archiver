77bd/uploads/origins/2c5c3efe-2ffb-4a03-ac43-bb2b44e7ba8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da934b7878cd5daa9734f153217450f6 2x, https://si.imgix.net/228377bd/uploads/origins/2c5c3efe-2ffb-4a03-ac43-bb2b44e7ba8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd90d8259c702fc24a9dc67d98cad33 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/34", "thumbnail_src": "https://si.imgix.net/2a4bdf84/uploads/origins/43bcca61-3983-4f23-b1de-529029bcaaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3d15a742326027cf32fc5db3153b906", "thumbnail_srcset": "https://si.imgix.net/2a4bdf84/uploads/origins/43bcca61-3983-4f23-b1de-529029bcaaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3d15a742326027cf32fc5db3153b906, https://si.imgix.net/2a4bdf84/uploads/origins/43bcca61-3983-4f23-b1de-529029bcaaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7bfe2b8d88ddaa31d583f2d75fd0c15 2x, https://si.imgix.net/2a4bdf84/uploads/origins/43bcca61-3983-4f23-b1de-529029bcaaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcb411816e7b9f691497a765638f7d2a 3x", "genre": "art", "nsfw": true, "body": "こんばんは。\n謎の力で上衣が破けて、ブラジャーとショーツが露わになっている葛城華ちゃんをお願いしたいです。下着はノーダメージでお願いします。\n最近の公式イラストでは初期と比べて胸盛られてる気がしますが、大きい方を標準にしてください。\n\n表情…驚きまたは羞恥。顔を真っ赤にして目を見開いている。\nポーズ…腕などでプライベートゾーンが隠されないようにしてください。\nアングル…背後や高所からのアングルは避けていただきたいです。（お乳の下半分が見づらいと悲しいので）\n\nその他の事項はお任せします。\nまたよろしければですが、異常に気付く直前の表情も描いてくださると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/33", "thumbnail_src": "https://si.imgix.net/13f4ae35/uploads/origins/86dcbd39-b9d8-48bb-a964-f0e63bbcfe4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168d38c601211ee066fe01d6bed2ee8b", "thumbnail_srcset": "https://si.imgix.net/13f4ae35/uploads/origins/86dcbd39-b9d8-48bb-a964-f0e63bbcfe4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168d38c601211ee066fe01d6bed2ee8b, https://si.imgix.net/13f4ae35/uploads/origins/86dcbd39-b9d8-48bb-a964-f0e63bbcfe4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28bb9414e63e85b4e0af63e0f9b5ce6f 2x, https://si.imgix.net/13f4ae35/uploads/origins/86dcbd39-b9d8-48bb-a964-f0e63bbcfe4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecadeb599ee4d5b622cd7001f032d601 3x", "genre": "art", "nsfw": false, "body": "CHUNITHMのエリシャ・ムルシアちゃんのイラストを描いて頂きたいです\n\n構図や差分等はお任せします\n\n良ければお願いします🙇‍♀️\n\nhttps://twitter.com/senmudayo/status/1628658413470371841?s=46&t=0ZCJ5eHxLjJyqNvhlmeybA", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/32", "thumbnail_src": "https://si.imgix.net/1ef548d5/uploads/origins/6e688b45-2696-4177-ada6-b241c9323026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3aa9e5543008c76afbf6fe0c37b176c", "thumbnail_srcset": "https://si.imgix.net/1ef548d5/uploads/origins/6e688b45-2696-4177-ada6-b241c9323026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3aa9e5543008c76afbf6fe0c37b176c, https://si.imgix.net/1ef548d5/uploads/origins/6e688b45-2696-4177-ada6-b241c9323026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13f618861a4c4bc423b666f560513f74 2x, https://si.imgix.net/1ef548d5/uploads/origins/6e688b45-2696-4177-ada6-b241c9323026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=649d43a1c5037acf94d598390ec28c22 3x", "genre": "art", "nsfw": true, "body": "こんにちは。 \n2回目の依頼になります。\n\n Chunithmの御手洗千里ちゃんをちょっとだけえっちな感じで描いていただきたいです。  \n・部活前、制服から運動着に着替えているシーン  \n・下半身はブレザーのスカート、上半身はスポーツブラの状態  \n・可能であれば、スカートを脱いだパンツ差分もお願いしたいです  \n・このほかはお任せします   \nよろしくお願いします！   \n\n参考資料 https://chunithm.gamerch.com/御手洗%20千里", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/31", "thumbnail_src": "https://si.imgix.net/0c6160d6/uploads/origins/4c7ae0be-aa02-4272-80e9-bc5f5d7e1997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8b2ddea4e37e2247d038ea1baca11fc", "thumbnail_srcset": "https://si.imgix.net/0c6160d6/uploads/origins/4c7ae0be-aa02-4272-80e9-bc5f5d7e1997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8b2ddea4e37e2247d038ea1baca11fc, https://si.imgix.net/0c6160d6/uploads/origins/4c7ae0be-aa02-4272-80e9-bc5f5d7e1997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43f29229a365f932317dc975218014c4 2x, https://si.imgix.net/0c6160d6/uploads/origins/4c7ae0be-aa02-4272-80e9-bc5f5d7e1997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709c053db8ddd882247fa7c05e2a97ea 3x", "genre": "art", "nsfw": true, "body": "Ag₂O🍀さん こんにちは!\n忘れてしまって本当に申し訳ございません..\nもし今からでもよろしければ申し込みたいです\nキャラは前と同じようにhttps://blazblue.fandom.com/wiki/Platinum_the_Trinityこのキャラでお願いします! 服装はビキニサンタにあとはお任せします\n\n本当に申し訳ございませんそしてご検討お願いします\n\n※可能であればビキニサンタ服装なしの差分をお願いしてもいいですか?\n(念のためnsfwかけておきます)", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/30", "thumbnail_src": "https://si.imgix.net/50cd83d1/uploads/origins/90444717-46b5-4677-9e52-1caa208ac635?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a29637c4f8a571c48fd1accc089f990b", "thumbnail_srcset": "https://si.imgix.net/50cd83d1/uploads/origins/90444717-46b5-4677-9e52-1caa208ac635?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a29637c4f8a571c48fd1accc089f990b, https://si.imgix.net/50cd83d1/uploads/origins/90444717-46b5-4677-9e52-1caa208ac635?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7aa9429605ee9052a16273dd45fee10 2x, https://si.imgix.net/50cd83d1/uploads/origins/90444717-46b5-4677-9e52-1caa208ac635?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ec904e8093c9df9790ad5fcf13fb6ed 3x", "genre": "art", "nsfw": false, "body": "Ag₂Oさん、こんにちは！ いつもオンゲキの絵楽しく見ています！\nオリキャラ（うちの子）のリクエストが出来るかどうかよく知りませんが、Ag₂Oさんの絵が本当に気に入って、オリキャラ二人のリクエストをお願いしたいです！（もし困難なリクエストだったら、キャンセルしてください！）\n資料と構図は下記のドライブのリンクに添えました！頼みたい資料は２番の資料(パーカー)ですが、１番の方がお気に入ったらそっちでもいいですね。白いワンピースもいいです！\nねこみみの子：ホットピンク色の髪と目、耳は白く、いつも笑顔\nうさみみの子：紫色の髪と目、耳は片方が曲がっている、ちょっと無表情、しっぽは元の絵より小さく \nそして、両方ともスレンダーな体型でお願いいたします！\n構図は、ポーズに簡単な参考になったら嬉しいです。Ag₂Oさんがお好きなようにお願いいたします。左(青い方)をうさみみの子で、右(赤い方)をねこみみの子で頼みます！ \nでは、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1w5mpQmEx57h4m7fkHBvF5P9U35dUAiwA", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/29", "thumbnail_src": "https://si.imgix.net/8c4e968c/uploads/origins/340467bf-ba63-4791-a43e-ee667af65a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f0cc175b43d0b29196c484af26bc10", "thumbnail_srcset": "https://si.imgix.net/8c4e968c/uploads/origins/340467bf-ba63-4791-a43e-ee667af65a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f0cc175b43d0b29196c484af26bc10, https://si.imgix.net/8c4e968c/uploads/origins/340467bf-ba63-4791-a43e-ee667af65a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b42c22e8091200b86385c6ed24f8d24 2x, https://si.imgix.net/8c4e968c/uploads/origins/340467bf-ba63-4791-a43e-ee667af65a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d80c4ceec077f762daede55c3b124794 3x", "genre": "art", "nsfw": true, "body": "Epic7に登場する2人のワイフの淫らなコミッションを探しています。\nできれば、ベッドの上で下半身をシースルー（透明）のシーツで覆い、上半身を完全に露出させた状態で2人を並べて上から見たイメージがあれば。\n\nhttps://imgur.com/a/QXzSXNn", "created_at": "", "completed_at": ""}, {"path": "/@Argentum_2O/works/28", "thumbnail_src": "https://si.imgix.net/47cc10b1/uploads/origins/0437971a-117f-440d-ab51-f1ebc1552bad?bg=%23fff&auto=format%2Ccompre