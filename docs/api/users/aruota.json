mount": 9000, "recorded_at": "2026-03-11T02:26:40.154636+00:00"}, {"amount": 15000, "recorded_at": "2026-03-12T00:28:35.686393+00:00"}]}, "current_prices": {"art": 15000}, "price_range": {"art": {"min": 6000, "max": 15000}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@aruota", "name": "aruota"}, {"label": "Twitter", "url": "https://x.com/Oy91FwHEp241869", "name": "Oy91FwHEp241869"}], "flags": {"from_archive": true}, "works": [{"path": "/@aruota/works/25", "thumbnail_src": "https://si.imgix.net/e59d72d4/uploads/origins/1dead814-3d1d-47a4-8eda-bc7de12f7ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a7d91806fc89fcab1746313029c75da", "thumbnail_srcset": "https://si.imgix.net/e59d72d4/uploads/origins/1dead814-3d1d-47a4-8eda-bc7de12f7ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a7d91806fc89fcab1746313029c75da, https://si.imgix.net/e59d72d4/uploads/origins/1dead814-3d1d-47a4-8eda-bc7de12f7ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2d6f7285e5292024fe9070e59876077 2x, https://si.imgix.net/e59d72d4/uploads/origins/1dead814-3d1d-47a4-8eda-bc7de12f7ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5833d2fb394e96a2e5faef4cb6b88b5d 3x", "genre": "art", "nsfw": false, "body": "見たい内容が浮かんだのでリクエストしますっ！\nただ既にリクエストを送っているのでキャンセルしていただいて構いません。\n\nうちの子の鈴音ちゃんか桜あにさん(https://www.pixiv.net/users/201323)の子のほまれちゃんどちらか描きたい方の制服姿を描いていただきたいです！\n\n\n鈴音ちゃんは元気で明るい狐っ子でデザインは下記のURLをご確認ください。\nhttps://x.com/septersound/status/1984769984493732124?s=46\n\nほまれちゃんはツンデレで面倒見が良いお姉ちゃん子でデザインは下記のURLをご確認ください。\nhttps://imgur.com/a/T4d7zcW\n\n服装は鈴音ちゃんは資料の狐っ子姿にJKの制服姿、ほまれちゃんは元絵のセーラー服。\nもしくはあるおたさんが描きたい制服があればデザインお任せでお願いします。\n\n構図やポーズはお任せします。\n\n以上となります。\nもしよろしければご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/24", "thumbnail_src": "https://si.imgix.net/d28b2c8d/uploads/origins/87857578-0235-45f1-ad52-4d3b16e850ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc2da51ffff67b04cb0dad01a92f602d", "thumbnail_srcset": "https://si.imgix.net/d28b2c8d/uploads/origins/87857578-0235-45f1-ad52-4d3b16e850ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc2da51ffff67b04cb0dad01a92f602d, https://si.imgix.net/d28b2c8d/uploads/origins/87857578-0235-45f1-ad52-4d3b16e850ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=290df612e91be400250b9d1bb6c54c40 2x, https://si.imgix.net/d28b2c8d/uploads/origins/87857578-0235-45f1-ad52-4d3b16e850ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96d8a7fb63ca95613d758223e8b0469a 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n\nイベントに伴い、依頼に参りました。\nリハビリということで、何か新鮮な依頼をと思い、いくつか考えました。\nだいぶ無茶振りですので、もし余裕があれば、採用いただければ幸いです。\n\n①あるおたさんのオリキャラ（キャラはお任せ）\n②うちの子のSDイラスト\n③うちの子イラスト（落書きスタイル）\n\nいずれも雑にサクサクっとしたものでお願いします。\nうちの子を描かれる場合、その扱いも適当で大丈夫です。\n\nうちの子の資料\n■神峰うるか\nhttps://drive.google.com/drive/folders/1kKjBX6jI3xkWn6luAT6IZS4E3SNYj3U2\nhttps://drive.google.com/drive/folders/1PChVc-90fXVmT-drHtuPmwipFjs97dzZ\n■ランシェ\nhttps://drive.google.com/drive/folders/1-X_0PlaIdTEiLGDbPqAgu9jtuqeUsquC\n■キアナ\nhttps://drive.google.com/drive/folders/1rgfH4YxlDcEc3StLtkIqzKkoCtPgvMi7\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/23", "thumbnail_src": "https://si.imgix.net/ebf22d55/uploads/origins/448fcc50-956c-44bb-a5d5-763ca708a673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e978e78569e72e96463d258b337b8d", "thumbnail_srcset": "https://si.imgix.net/ebf22d55/uploads/origins/448fcc50-956c-44bb-a5d5-763ca708a673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e978e78569e72e96463d258b337b8d, https://si.imgix.net/ebf22d55/uploads/origins/448fcc50-956c-44bb-a5d5-763ca708a673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08d5ace935f7d3c4a15c74143c921a97 2x, https://si.imgix.net/ebf22d55/uploads/origins/448fcc50-956c-44bb-a5d5-763ca708a673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=002999cc2dd7d2876de370c57bd8b337 3x", "genre": "art", "nsfw": true, "body": "うちの子を描いて頂きたくリクエストさせていただきました！\n\n衣装は資料の中のお気に入りってタイトルになってるものだと嬉しいですが、他のものでも全く違う衣装でも構いません！\n構図は基本におまかせしますが、可能ならば\n・南半球\n・素足\nその2点を描いていただけたらとても嬉しいです！\n\nhttps://drive.google.com/drive/folders/1XMVD7lS6xOAy61klmpYREZisD5IZswnU", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/22", "thumbnail_src": "https://si.imgix.net/31a81103/uploads/origins/81be2f79-eb21-48fa-bcb3-a93e844b6b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=402b32ce6b9a6ea2ac580dd62320168f", "thumbnail_srcset": "https://si.imgix.net/31a81103/uploads/origins/81be2f79-eb21-48fa-bcb3-a93e844b6b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=402b32ce6b9a6ea2ac580dd62320168f, https://si.imgix.net/31a81103/uploads/origins/81be2f79-eb21-48fa-bcb3-a93e844b6b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e29a1f21aed2abda4203a014d40eba0d 2x, https://si.imgix.net/31a81103/uploads/origins/81be2f79-eb21-48fa-bcb3-a93e844b6b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f2fe0d346eec1083c6ba44dd7261b96 3x", "genre": "art", "nsfw": false, "body": "いつも配信楽しく拝見しております\n私のOCのイラストをリクエストをしたいです\n\nブレザーの学生服（冬服）を着せて下さい\nリボンなどは制服に合わせて変更可\n体型、髪型なども多少変更可\n白ストか黒タイツ着用（ガーター等でも可）\nポーズなどはお任せますが出来れば全身が欲しいです\n\n下記が今のところ決まっている設定になります\n名前：ルナ=ヴェスペルティーナ（由来は宵闇の月）\n種族：猫型亜人と吸血鬼ハーフ（耳と尻尾、コウモリ羽根も出せるが隠せる）\n性格：大人しめで従順だが猫寄り、甘い物が好き\n服装：普段着はメイド服（下着は大人っぽいのを好み、かつガーターか白スト）\n来歴：幼いころに両親と引き離され感情が薄めのため\n表情に乏しいが美味しいものを食べたりすると表情がほころぶくらいの表情変化はする\nご主人様に拾われ一般常識を学ぶついでにメイドをしている\n\n使用用途としてはSNSのヘッダーやアイコン、デスクトップ画像、もしくは個人向け印刷サービス（skebの印刷機能など）を使用した自分用のグッズ印刷（非商用）になります\n\nhttps://drive.google.com/drive/folders/1osbpgkNzwM4b5IT4UyaofM4ykCvx9gYz?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/21", "thumbnail_src": "https://si.imgix.net/b17e42c4/uploads/origins/b577d64f-21d9-473b-8973-c3a66b817cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5c16f9b9e0daf2308d74aa4336204e", "thumbnail_srcset": "https://si.imgix.net/b17e42c4/uploads/origins/b577d64f-21d9-473b-8973-c3a66b817cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5c16f9b9e0daf2308d74aa4336204e, https://si.imgix.net/b17e42c4/uploads/origins/b577d64f-21d9-473b-8973-c3a66b817cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acd37eac9ba9bc1717ecf514da3ebaec 2x, https://si.imgix.net/b17e42c4/uploads/origins/b577d64f-21d9-473b-8973-c3a66b817cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d21604cf1acb19df1f10548b1bccc4d8 3x", "genre": "art", "nsfw": false, "body": "初めまして！再送失礼します。\n\n私のVRChatのアバターを描いていただけないでしょうか？\n眠そうにしている感じで描いていただけると嬉しいです！\n\nSNSのアイコンやVRCワールドへの掲示に使用する予定です。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Q49vPaqdYABLdZU66UkZiXQdF3tfPD5M?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/20", "thumbnail_src": "https://si.imgix.net/1d900d6c/uploads/origins/10b5de6d-db80-4a21-a5c7-e53eb1dd2966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7de76f6369ef6135af67fd90aeba3c72", "thumbnail_srcset": "https://si.imgix.net/1d900d6c/uploads/origins/10b5de6d-db80-4a21-a5c7-e53eb1dd2966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7de76f6369ef6135af67fd90aeba3c72, https://si.imgix.net/1d900d6c/uploads/origins/10b5de6d-db80-4a21-a5c7-e53eb1dd2966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db1487026c342f8fdf0e01c973171901 2x, https://si.imgix.net/1d900d6c/uploads/origins/10b5de6d-db80-4a21-a5c7-e53eb1dd2966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d69c8a9254fedc4254e8496722ea57c8 3x", "genre": "art", "nsfw": true, "body": "オリキャラのサキュバスを描いてもらいたいです。\n着るものや角や羽等の変更・アレンジは自由にしてもらって大丈夫です。\n\nhttps://drive.google.com/drive/folders/1fiq_LoqyKnIQ_3MBDKseU2yLMXHj1Ese?usp=sharing\n\n構図や表情等はお任せいたします。\n資料で不明な部分は自由に描いていただいて構いません。\n\nもし可能であればPSDファイルを頂けると嬉しいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fiq_LoqyKnIQ_3MBDKseU2yLMXHj1Ese?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/19", "thumbnail_src": "https://si.imgix.net/81328566/uploads/origins/347c18d6-2105-4648-8f1a-557dcd53fe7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=064f01026c62da1d4f72ec3a70f5e323", "thumbnail_srcset": "https://si.imgix.net/81328566/uploads/origins/347c18d6-2105-4648-8f1a-557dcd53fe7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=064f01026c62da1d4f72ec3a70f5e323, https://si.imgix.net/81328566/uploads/origins/347c18d6-2105-4648-8f1a-557dcd53fe7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39fe681a002566d29f32d9a753e31585 2x, https://si.imgix.net/81328566/uploads/origins/347c18d6-2105-4648-8f1a-557dcd53fe7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d43633028cb66dccaae8873747200930 3x", "genre": "art", "nsfw": false, "body": "はじめまして！先生のイラストが大好きで以前よりSkebでの募集を心待ちにしておりました！\n\n【依頼内容】\n自作曲のために制作したオリキャラのイラストを描いていただきたいです！\n\n【キャラクター資料】\nhttps://drive.google.com/drive/folders/1HMZCXq9EGGvU30AJ_RaXVMdSHUQHrrwb?usp=drive_link\n\n構図やポーズはお任せいたします！\n衣装につきましても、アレンジしていただいて構いません！\n拙いイラストですがよろしくお願いします。\n\n【使用用途】\nTwitter（現X）やYouTubeのプロフィールアイコンとしての使用、家宝として大切にさせていただきます。\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HMZCXq9EGGvU30AJ_RaXVMdSHUQHrrwb?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@aruota/works/18", "thumbnail_src": "https://si.imgix.net/bf4123b2/uploads/origins/3451cc46-268b-4a5f-9b7d-cc8611fbff4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d975baf6