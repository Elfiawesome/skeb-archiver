d562-1422-471f-84a5-e3759c97f99c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ce8148231c2d01bc04c8aedec17ab3a", "thumbnail_srcset": "https://si.imgix.net/3e21839b/uploads/origins/04d6d562-1422-471f-84a5-e3759c97f99c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ce8148231c2d01bc04c8aedec17ab3a, https://si.imgix.net/3e21839b/uploads/origins/04d6d562-1422-471f-84a5-e3759c97f99c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4553604be24503df0a03f7716ac3cbe8 2x, https://si.imgix.net/3e21839b/uploads/origins/04d6d562-1422-471f-84a5-e3759c97f99c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e5764c335e9f716cda37af073b34e48 3x", "genre": "art", "nsfw": false, "body": "突然の依頼失礼します。\nタダシ様の絵を拝見して依頼したいと考えリクエストを送らせて頂きます。\n確認お願い致します。\n\n・キャラクター\nウマ娘登場人物サトノダイヤモンド(勝負服Natural Brilliance)\n\n\n・シチュエーション\n当該キャラのバストを大盛りにして衣装の胸部分が弾けそうなくらい張り詰めているシチュをお願いします。\n表情は得意気な感じでお願いします。\n\n\nお忙しい中恐れ入りますが検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cell_for/works/105", "thumbnail_src": "https://si.imgix.net/6bbc7f7e/uploads/origins/7ba5f4ff-ee0b-4e2f-8e69-9e023d028536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6baf6042dcb52192d42eaff95a57e24", "thumbnail_srcset": "https://si.imgix.net/6bbc7f7e/uploads/origins/7ba5f4ff-ee0b-4e2f-8e69-9e023d028536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6baf6042dcb52192d42eaff95a57e24, https://si.imgix.net/6bbc7f7e/uploads/origins/7ba5f4ff-ee0b-4e2f-8e69-9e023d028536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0027f9d0fefc185ddf900b4c7e7e5e6e 2x, https://si.imgix.net/6bbc7f7e/uploads/origins/7ba5f4ff-ee0b-4e2f-8e69-9e023d028536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52035133569cff2205a8109f71b8989c 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは！前回の聖マーサのイラストありがとうございました！もしご面倒でなければ、またR18のイラスト