b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a993daa94c1135f292a257da3adc5dd7 2x, https://si.imgix.net/c9014aa2/uploads/origins/5a59fff6-4924-4c16-b82d-6f1afd5311b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5df880f0ac4477540764e3ece34870b0 3x", "genre": "art", "nsfw": true, "body": "以前七尾百合子のおしっこイラスト(https://skeb.jp/@kuragezakana100/works/5)を依頼したものです。\n素敵なイラストをありがとうございました。\n\n前回のイラストがとても好みで、似たようなシチュエーションでリクエストさせていただきたいのですがよろしいでしょうか。\n\n○シチュエーション\n百合子が怖がりながら立ちションするイラストをお願いしたいです。\n\n以下、詳細です。\n「寝室で寝ていた百合子が尿意で目を覚ますも、怖くてトイレへ行けず、布団横のおまるにビビりながら慌てて立ちションをしてしまい、おしっこの狙いが定まらずに床や障子におしっこを飛び散らせてしまう」場面をお願いしたいです。\n\n服装はパジャマでお願いします。\n(参考にミリカンの画像を資料URLに添付します。)\n\n表情は「おしっこが早く終わってほしい」と怖がりながら焦っている感じでお願いしたいです。\n\n慣れない女の子の立ちションで、おまるを狙いきれずに豪快におしっこを外し撒き散らす様子をお願いできればと思います。\n\n前回のイラストのリアリティやおしっこの描き方がとても好みで、またお願いしたく存じます。\n是非ともご検討よろしくお願い致します。\n\nhttps://mltd.matsurihi.me/cards/1339", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/8", "thumbnail_src": "https://si.imgix.net/cb134c2f/uploads/origins/387b30bc-4166-4cf4-bc0d-7c3c13287572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c164e89d327dc7bf48c7cf538593c2", "thumbnail_srcset": "https://si.imgix.net/cb134c2f/uploads/origins/387b30bc-4166-4cf4-bc0d-7c3c13287572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c164e89d327dc7bf48c7cf538593c2, https://si.imgix.net/cb134c2f/uploads/origins/387b30bc-4166-4cf4-bc0d-7c3c13287572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc9b589304e0993209346269b3653fda 2x, https://si.imgix.net/cb134c2f/uploads/origins/387b30bc-4166-4cf4-bc0d-7c3c13287572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5543831b3dfec3a547b13ad4ce05621e 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nスレンダーボディと大きめの胸のバランス感が好きで依頼させていただきました\nアイドルマスター シャイニーカラーズ の小宮果穂でリクエストさせてください。\n\n・バストサイズ\n普段よく描かれている七尾百合子ちゃんくらいの感じでお願いします。\n\n・シチュエーション\n服装は資料先にある私服でロングTシャツのみ着用\nロングTシャツもめくられて胸が見えた状態\n正常位or騎乗位のどちらかでPとイチャラブエッチをしているシチュ\n\n何卒よろしくお願いします。\n\n・資料\nhttps://shinycolors.idolmaster.jp/idol/hokagoclimaxgirls/kaho.html", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/7", "thumbnail_src": "https://si.imgix.net/53e559ff/uploads/origins/d908f268-bdb4-423f-b0af-38630f816127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30294855907fe731295ff9bbb5283f35", "thumbnail_srcset": "https://si.imgix.net/53e559ff/uploads/origins/d908f268-bdb4-423f-b0af-38630f816127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30294855907fe731295ff9bbb5283f35, https://si.imgix.net/53e559ff/uploads/origins/d908f268-bdb4-423f-b0af-38630f816127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=374548da6c9b3b52601f5b69df944f65 2x, https://si.imgix.net/53e559ff/uploads/origins/d908f268-bdb4-423f-b0af-38630f816127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf642fde3fcd57e9c12b7b8a9334204d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/6", "thumbnail_src": "https://si.imgix.net/2bdd33b5/uploads/origins/7d1540fc-a69e-4f59-ac7b-468897d86c76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e47ece663e1f99ec135e66221da66f11", "thumbnail_srcset": "https://si.imgix.net/2bdd33b5/uploads/origins/7d1540fc-a69e-4f59-ac7b-468897d86c76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e47ece663e1f99ec135e66221da66f11, https://si.imgix.net/2bdd33b5/uploads/origins/7d1540fc-a69e-4f59-ac7b-468897d86c76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=589a007d6161bd2c2491d09fc8969735 2x, https://si.imgix.net/2bdd33b5/uploads/origins/7d1540fc-a69e-4f59-ac7b-468897d86c76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c5a9fa34c414720e0ad304e5d1485eb 3x", "genre": "art", "nsfw": false, "body": "初めまして、リクエスト失礼します！\n\n海月魚先生のイラストが可愛かったので、リクエストさせていただきました。\n以下に詳細を記載します。\n\n・キャラクター\nフォルダ内のキャラ画像を参考にお願いします。\n衣装も画像の通りにしてください。\n\n・表情\nフォルダ内の表情画像を参考にお願いします。\n\n・ポーズ\nベットに押し倒されてへなってるような様子を描いてほしいです。\n\n・備考\nファイル形式はPNGで、背景は透過してください。\n\n・使用用途\nSNSでの宣伝や告知、アイコンに使用\nYoutubeのサムネイルや動画内での使用\n\n以上になります。検討の程よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/19g38UBxNPiZHcuMgv7nGUsNZ-2L0kCue?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/5", "thumbnail_src": "https://si.imgix.net/a4f489cf/uploads/origins/d9975903-5c21-4b75-9ebd-5c5c6b519372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56624e1d98d1751eb9c94bb2c94574d4", "thumbnail_srcset": "https://si.imgix.net/a4f489cf/uploads/origins/d9975903-5c21-4b75-9ebd-5c5c6b519372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56624e1d98d1751eb9c94bb2c94574d4, https://si.imgix.net/a4f489cf/uploads/origins/d9975903-5c21-4b75-9ebd-5c5c6b519372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98c3bb1d304db64f519ecf652cd11bab 2x, https://si.imgix.net/a4f489cf/uploads/origins/d9975903-5c21-4b75-9ebd-5c5c6b519372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07d832cf01d965f3af1253a202262ecd 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n海月魚様の描かれる百合子がとても可愛く、またR-18イラストもとてもエッチで興味を惹かれ、\nリクエストさせていただきました。\n\n七尾百合子ちゃんがトイレでおしっこ(ハミション)をしているイラストをお願いします。\n\n服装は夏服制服でお願いします。(資料URL欄に画像を添付します。)\n\n構図としてはトイレの個室を上から見たようなアングルで、\n表情は我慢に我慢を重ね漏れそうだったおしっこを間に合わせることが出来てほっとしたような、とろんとした可愛い顔でお願いします。\n(表情のイメージとしては、以前海月魚様が描かれていたこちらのイラスト：\nhttps://www.pixiv.net/artworks/111514549#big_0)\n\nトイレは洋式・和式トイレのどちらでも大丈夫です。\nただ、以下のようにハミションさせて欲しいです。\n洋式の場合→おしっこが噴水のように飛び出してしまい、扉や床に飛び散っている\n和式の場合→おしっこが金隠しを超えてしまい、壁や床に飛び散っている\n\nまた、可能であればパンツにおしっこをチビったシミがあると嬉しいです。\n\n依頼内容は以上となります。\n性癖詰め詰めのリクエストになってしまいましたが、描いていただけますと幸いです。\nご検討よろしくお願いします。\n\n(以下はあくまで私のイメージもとい妄想なので、読み飛ばしていただいても大丈夫です。)\n修学旅行中、サービスエリアに立ち寄りトイレ休憩を取ることになるが、本を読んでいて出遅れてしまった百合子。\n後から並ぶも女子トイレは長蛇の列な上、気付かないうちにおしっこが溜まっていたようで途中で尿意が限界に。\n次は自分というところでチビってしまい絶体絶命であったがようやく個室のドアが開き、一目散に駆け込み限界放尿。\nそのせいでとんでもないハミションで個室を濡らしてしまうが全く気が付いておらず、百合子はとろんとした顔で気持ちよさそうに放尿する。\n\nhttps://imas.gamedbs.jp/mlth/image/card/img/1621836639009_yl49u7j3.png", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/4", "thumbnail_src": "https://si.imgix.net/90099cb3/uploads/origins/c23e05d5-74a4-4efd-8ab5-bde7c992a5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bad785509abed5cf1b263cd3b593a7c9", "thumbnail_srcset": "https://si.imgix.net/90099cb3/uploads/origins/c23e05d5-74a4-4efd-8ab5-bde7c992a5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bad785509abed5cf1b263cd3b593a7c9, https://si.imgix.net/90099cb3/uploads/origins/c23e05d5-74a4-4efd-8ab5-bde7c992a5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eedc9a6dab7f1f9d3be099dd30f81877 2x, https://si.imgix.net/90099cb3/uploads/origins/c23e05d5-74a4-4efd-8ab5-bde7c992a5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40f4607f04bc7872b03f0f96461c5ae2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/3", "thumbnail_src": "https://si.imgix.net/46c11d80/uploads/origins/30ce4313-944b-45db-bb81-6da9c22a1825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1754866c15fa727dea2c7a72cd5bd7a3", "thumbnail_srcset": "https://si.imgix.net/46c11d80/uploads/origins/30ce4313-944b-45db-bb81-6da9c22a1825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1754866c15fa727dea2c7a72cd5bd7a3, https://si.imgix.net/46c11d80/uploads/origins/30ce4313-944b-45db-bb81-6da9c22a1825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b82d241a579dca7f909507be35a7ef08 2x, https://si.imgix.net/46c11d80/uploads/origins/30ce4313-944b-45db-bb81-6da9c22a1825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07f844d182306ceae1ba70e7a142102a 3x", "genre": "art", "nsfw": true, "body": "はじめまして。海月魚さんの描かれる百合子ちゃんがとても可愛すぎるのでリクエストさせてください。\n\n七尾百合子ちゃんが全裸にされて首輪をはめられ、縄で緊縛されているイラストをお願いします。\nhttps://drive.google.com/file/d/1h78-qmz-5K22bem-f6dmXvxWfnsrrbV6/view?usp=sharing\n構図としてはこんな感じで。海月魚さんの絵柄にして顔をとびきり可愛くお願いします。\n表情は涙目で、怯えながら男の顔を上目遣いで覗き込むように。\n胸は少し大きめにしてあるのでこれぐらいでお願いします。\n肩幅は小さくして華奢な少女を縄でぎゅっと縛っているような感じに。\n\n縄は胸の上下とも4本ずつでお願いします。軽く斜線を入れる程度でも構わないので縄目を入れてください。\nhttps://drive.google.com/file/d/1MQ_uZeqhC9oTq4lz1L31dA9LTQZ-zrdU/view?usp=sharing\nこちら真正面からのアングルになりますが縛り方の参考画像です。\n縄はゆるく見えないようしっかり張ってください（特に上側）\n\n背景は適当でいいです。地下牢みたいなイメージで。\nキャラと背景はレイヤー分けていただけると嬉しいです。\n\nそれでは、よろしくお願いします。\n\nhttps://drive.google.com/file/d/1h78-qmz-5K22bem-f6dmXvxWfnsrrbV6/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kuragezakana100/works/2", "thumbnail_src": "https://si.imgix.net/5107f89f/uploads/origins/7c91a7e3-212f-4892-ac45-070395a96948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4698d2b2de68686253fd270c50e08ba2",