8b-8c34-c1ef7f8aa3d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e964b654ce670b77fc29114f9bcbe0, https://si.imgix.net/b1cd6def/uploads/origins/6981e99c-39c3-4c8b-8c34-c1ef7f8aa3d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fb3eb936664c24f7b579fa7ec671672 2x, https://si.imgix.net/b1cd6def/uploads/origins/6981e99c-39c3-4c8b-8c34-c1ef7f8aa3d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e85daf11a6b4e4a557f9fb8b8365dd7 3x", "genre": "art", "nsfw": true, "body": "こんにちは。以前ソーサラーのハルトリーネさんを依頼した者です。\n手数料無料ということもありリピートしたくなりました。\n（ファンブックのヘッダーお疲れさまでした。キャラクターそれぞれの個性が出ていてとても良いと思いました）\n\n[内容]\nラグナロクオンライン 4次職 トルヴェール(赤色)さんが\nスカートをたくしあげてパンツを見せてくれて ⇒ 脱いでくれる「見抜きシーン」をお願いします。\n\nキャラクターイメージはこちら \n⇒ https://m.inven.co.kr/board/ro/4228/361\n・髪型や衣装の色はサンプル通り\n・パンツの色は[無地]で、衣装のようなワインレッド[b33e5c] みたいな赤を希望します\n\n今回、それ以外の構成はお任せいたします。\n金額にあった範囲で大丈夫ですのでよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumaguma_m/works/14", "thumbnail_src": "https://si.imgix.net/dce1cd40/uploads/origins/8d4f9b98-4a92-49fe-b006-f3ee85860020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35f30486bbac930360adc9161be13de8", "thumbnail_srcset": "https://si.imgix.net/dce1cd40/uploads/origins/8d4f9b98-4a92-49fe-b006-f3ee85860020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35f30486bbac930360adc9161be13de8, https://si.imgix.net/dce1cd40/uploads/origins/8d4f9b98-4a92-49fe-b006-f3ee85860020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59ae23ea090d5585ea4ffca709913ee6 2x, https://si.imgix.net/dce1cd40/uploads/origins/8d4f9b98-4a92-49fe-b006-f3ee85860020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7556c9a87a95d432fa01add2b029ca8 3x", "genre": "art", "nsfw": true, "body": "うちの子クリエちゃん🐰🎩🧪でもう一枚、えっちなやつお願いします！！\n\n課題で白いの…が必要になってお願いするも、交換条件で見抜きさせられちゃうシチュで！\n丸め込まれてスカートたくしあげてかわいいぱんつ丸見えに・お胸も見せちゃっておかずにされちゃう…😭\n\nいたずら元気っ子な感じでキャラ付けしていただいてセリフ差分と、試験管🧪に出してほしかったのにいっぱいかけられて怒っちゃう😡差分をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@gumaguma_m/works/13", "thumbnail_src": "https://si.imgix.net/e836ecde/uploads/origins/00b39548-6d7f-471d-9148-e3c1394669f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50d1e0d0a479002f85db01c903a7d6ad", "thumbnail_srcset": "https://si.imgix.net/e836ecde/uploads/origins/00b39548-6d7f-471d-9148-e3c1394669f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50d1e0d0a479002f85db01c903a7d6ad, https://si.imgix.net/e836ecde/uploads/origins/00b39548-6d7f-471d-9148-e3c1394669f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4cc9dc83ef2680f84ba0924a33fdee6 2x, https://si.imgix.net/e836ecde/uploads/origins/00b39548-6d7f-471d-9148-e3c1394669f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b36ce373f4743a4828e76da79b1bcac 3x", "genre": "art", "nsfw": false, "body": "うちの子にROのクリエの衣装着せてあげてください！🐰🎩🧪\nhttps://imgur.com/a/RtYWuGD", "created_at": "", "completed_at": ""}, {"path": "/@gumaguma_m/works/12", "thumbnail_src": "https://si.imgix.net/746ab737/uploads/origins/8d8aca7d-9c21-4667-8ada-d69e9764184e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd268c2bf334439d5329b0e38a29b484", "thumbnail_srcset": "https://si.imgix.net/746ab737/uploads/origins/8d8aca7d-9c21-4667-8ada-d69e9764184e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd268c2bf334439d5329b0e38a29b484, https://si.imgix.net/746ab737/uploads/origins/8d8aca7d-9c21-4667-8ada-d69e9764184e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d38f298cf9742d8d789036b1c2e3b02 2x, https://si.imgix.net/746ab737/uploads/origins/8d8aca7d-9c21-4667-8ada-d69e9764184e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eaf4641f243cac801a5a14eac70b71d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gumaguma_m/works/11", "thumbnail_src": "https://si.imgix.net/0c492c37/uploads/origins/537238fc-8624-495b-8ea8-d8d0e51fbf0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3dda608b82d4caeb3d9b9d92a4d64ec", "thumbnail_srcset": "https://si.imgix.net/0c492c37/uploads/origins/537238fc-8624-495b-8ea8-d8d0e51fbf0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3dda608b82d4caeb3d9b9d92a4d64ec, https://si.imgix.net/0c492c37/uploads/origins/537238fc-8624-495b-8ea8-d8d0e51fbf0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c463866a104ee2cf3cd4d3a5b27e766 2x, https://si.imgix.net/0c492c37/uploads/origins/537238fc-8624-495b-8ea8-d8d0e51fbf0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59aa1858cfc967294a778297f1dfa8de 3x", "genre": "art", "nsfw": true, "body": "こんにちは。以前こちらを依頼したときのものです\n⇒ https://skeb.jp/@gumaguma_m/works/10\n\n前回構図が最高に良かったので、続きとして同じような展開をまたお願いできますでしょうか？\n\n◆衣装について\n・ソーサラーのセカンドコスチューム(水色)でお願いします。\n・真正面の立ち絵\n・パンツは最初からはいてない\n・スリッドの位置はおへその位置くらい高めで、ふとももやＶらいんが見えやすいようにお願いします。\n\n◆流れ\n（通常コスはスケスケが気になるので、今度はソーサラーのセカンドコスチューム(水色)に着替えてきたというハルトリーネさん）\n\n①「わかってるわよ。ソーサラーはパンツはいちゃダメなんでしょ。最初から脱いでるわ」\n\n②「確認するって？」と、ウォーターボールをぶっかけられて、結局前掛けの白い布の部分がスケスケになってしまい、はいてない所が見えてしまう\n胸は隠れたままの方が良いので、下半身だけ透過率70%くらい濡らしてスケさせて下さい。\n\n③「ちゃんと見せてあげるから、水をかけるのはやめて」\nといいながら、白い前掛けをおへそが見える位置まで、両手を使ってたくし上げてくれる。\n\n④「・・・」\n\n⑤「・・・ほら・・・かけるのは水だけでいいの？」と、逆にハルトリーネさんから誘ってきてくれて、結局見抜されるという流れでお願いします。\n\n背景は前回の使いまわしで大丈夫です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumaguma_m/works/10", "thumbnail_src": "https://si.imgix.net/a9b1268f/uploads/origins/07310931-1b54-40a8-8171-ffb018ccf9ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7cc415b508051443eb87c4264cc329c", "thumbnail_srcset": "https://si.imgix.net/a9b1268f/uploads/origins/07310931-1b54-40a8-8171-ffb018ccf9ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7cc415b508051443eb87c4264cc329c, https://si.imgix.net/a9b1268f/uploads/origins/07310931-1b54-40a8-8171-ffb018ccf9ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3adb30acbad52379613a78aac302257 2x, https://si.imgix.net/a9b1268f/uploads/origins/07310931-1b54-40a8-8171-ffb018ccf9ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e744645f054cc7fa37a6f7feeddfcbe 3x", "genre": "art", "nsfw": true, "body": "匿名で失礼します。先日の同人誌を拝見し、ハルトリーネさんの性格やキャラデザがかわいらしく、魅力的でとても気に入りました。\n\nハルトリーネさんが新キャラを作ったことにして、ソーサラーの衣装を着たところ\n「ソーサラーはパンツ履いてはいけない」と適当なことを教えられて信じ、そのまま見抜きされてしまうシュチュエーションをお願いできますか？\n\n◆ソーサラーの衣装について\n・通常ソーサラー　衣装のカラーは髪の色に似せて、青でお願いします。\n・頭衣装は同じ\n・正面を向いて立っている絵でお願いします。\n・前掛けや白い布の部分は透過率７０％くらいで、おへそやパンツ(脱いだ時のVライン)がわりとスケ見えるようにして下さい。\n・肩の羽やアクセサリーは大きすぎず控え目で大丈夫です。\n・腰にあるベルトはいっそ無くして描かなくていいです。\n・場所はプロ南のような青空下のフィールド\n・手の位置はボディーラインに重ならないように、横に添えるかして下さい。\n\n◆流れについて\n①最初の段階では無地でシンプルなパンツを履かせて下さい。\nセリフ「えっ、ソーサラーってパンツ履いちゃいけないの？」「わかったわ。脱げばいいのね・・・」\n\n②パンツだけ脱がせて下さい。ブラは脱がさず胸が隠れたままがよいです。\n「ただでさえスケスケなのに恥ずかしい・・・」と照れつつも、更に適当なことを言われて見抜きに答えてくれる。\n\n③[そのまま服を脱ぐ] or [布をたくし上げる]かして、ちゃんと履いてないところを確認させてくれてるハルトリーネさん。そのまま見抜きされて精液をかけられてしまう。\n\nという流れをお願いします。\n\n※セリフについては全く一緒でなくてよいので、ハルトリーネさんの性格に合わせて言ってみてください。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gumaguma_m/works/9", "thumbnail_src": "https://si.imgix.net/6b914c97/uploads/origins/8dd6175b-38e3-478d-bcb9-538012cbc7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=343a08c37ba4d2bfa5d5218825700af0", "thumbnail_srcset": "https://si.imgix.net/6b914c9