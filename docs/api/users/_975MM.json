olders/1-6aNUKWsUz4IGMO3OKP64wjt4GLBY0B8", "created_at": "", "completed_at": ""}, {"path": "/@_975MM/works/25", "thumbnail_src": "https://si.imgix.net/6cf440b6/uploads/origins/f757ef77-6682-4a1c-ba60-ddaee1d6caad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ce3095819956bb36ded2e875923f82e", "thumbnail_srcset": "https://si.imgix.net/6cf440b6/uploads/origins/f757ef77-6682-4a1c-ba60-ddaee1d6caad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ce3095819956bb36ded2e875923f82e, https://si.imgix.net/6cf440b6/uploads/origins/f757ef77-6682-4a1c-ba60-ddaee1d6caad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10f3f182b0ce4036b6669d1c3f4f7619 2x, https://si.imgix.net/6cf440b6/uploads/origins/f757ef77-6682-4a1c-ba60-ddaee1d6caad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40b600d1f24d64b9f98a7b539cf3ccce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_975MM/works/24", "thumbnail_src": "https://si.imgix.net/017e25cb/uploads/origins/8cd54e1c-292a-41f0-9766-627024cce393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3fae879c5d512591691c65f33bf771b", "thumbnail_srcset": "https://si.imgix.net/017e25cb/uploads/origins/8cd54e1c-292a-41f0-9766-627024cce393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3fae879c5d512591691c65f33bf771b, https://si.imgix.net/017e25cb/uploads/origins/8cd54e1c-292a-41f0-9766-627024cce393?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aed378b421f1a36caf962cca2d4754aa 2x, https://si.imgix.net/017e25cb/uploads/origins/8cd54e1c-292a-41f0-9766-627024cce393?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=048ac5a7f3598ee8e94620259f0715fc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、なこ先生。先生の画風をとても尊敬しているのですが、私のOCカップルのイラストを描いていただけませんか？\n登場人物は42歳の厳格な教授と22歳の博士課程の学生です。教授は身長185cmで、飄々としていて、いつもしかめっ面で、仕事に没頭していて、他のことにはほとんど興味を示さない。身長160cmの学生は教授の最も優秀な教え子で、教授に憧れを抱いているが、その感情を表に出すことはない。服装は自由です！ありがとうございました。\n\nhttps://drive.google.com/drive/folders/19M3RRK0Tf7GVf5wDrYYK1lWvSrEwcsRq?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@_975MM/works/23", "thumbnail_src": "https://si.imgix.net/5e693441/uploads/origins/01f81046-24fb-4d63-a0d8-e7158d514d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c83dda6dd12c19dee980a5b90064d9", "thumbnail_srcset": "https://si.imgix.net/5e693441/uploads/origins/01f81046-24fb-4d63-a0d8-e7158d514d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c83dda6dd12c19dee980a5b90064d9, https://si.imgix.net/5e693441/uploads/origins/01f81046-24fb-4d63-a0d8-e7158d514d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4c9af6abc22a9df9fd5bd0396fd2ccd 2x, https://si.imgix.net/5e693441/uploads/origins/01f81046-24fb-4d63-a0d8-e7158d514d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2679c00341a4f2a8231b7fca0a804b08 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！Skebで先生の最新作を拝見し、その美しい画風に驚きました❤️。\n私のOCの絵をリクエストすることは可能でしょうか？\n\nストーリーはファンタジーの世界です。\n\nナイトシェード：黒髪、猫のような瞳、全身黒ずくめの16歳の美少年。身長172cm。幻術を使う若き魔道士。幼少期の嫌な経験から、性格は皮肉屋で皮肉屋。一般的に人間不信で、肉体的接触を嫌う（ただし動物は好き）。\n\n*爪も黒く塗られている。目の下は金色（顔もURL）。\n*モチーフはダチュラの花、割れた鏡の破片、幸運の蹄鉄。\n\n\n自由に描いてください！\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-KsWSeDyJb7BaAhlW_ZVjwymRZxH5YKy", "created_at": "", "completed_at": ""}, {"path": "/@_975MM/works/22", "thumbnail_src": "https://si.imgix.net/a0303331/uploads/origins/56bef0e2-90b8-439d-a861-a9c94e670bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d2e48844e21742a2483e69148c77b5f", "thumbnail_srcset": "https://si.imgix.net/a0303331/uploads/origins/56bef0e2-90b8-439d-a861-a9c94e670bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d2e48844e21742a2483e69148c77b5f, https://si.imgix.net/a0303331/uploads/origins/56bef0e2-90b8-439d-a861-a9c94e670bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7da471888278b52b468ab65d979073e6 2x, https://si.imgix.net/a0303331/uploads/origins/56bef0e2-90b8-439d-a861-a9c94e670bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8030941493dd71078b2520dc845d7dbb 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nいつもななこ様のイラスト楽しんで見させて頂いております…！\nななこ様の構図や色使いが大好きでいずれリクエスト送らせて頂きたい…！と思っておりましたので、今回送らせていただきました…！！\n\n宜しければななこ様に私と友人のうちよそキャラクターのイラストをお願いしたいです…！\n構図やカラー、シチュエーションなどはななこ様にお任せします…！！着ているものもそれに合わせて変えていただいて問題ありません！\n茶髪の方のキャラクターは左腕を欠損しておりますが義手でも問題ないです…！\n\nよろしくお願い致します…！！\n\nhttps://drive.google.com/drive/folders/1-3jdVRcvTJb9KQuv4pVxtXnZTw29G9UC", "created_at": "", "completed_at": ""}, {"path": "/@_975MM/works/21", "thumbnail_src": "https://si.imgix.net/0b85a8f1/uploads/origins/6fbcdd53-efb6-41ab-82c9-67be7706891f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d3c26b4b72a9c918d3a37a9ab466ed", "thumbnail_srcset": "https://si.imgix.net/0b85a8f1/uploads/origins/6fbcdd53-efb6-41ab-82c9-67be7706891f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d3c26b4b72a9c918d3a37a9ab466ed, https://si.imgix.net/0b85a8f1/uploads/origins/6fbcdd53-efb6-41ab-82c9-67be7706891f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5e09f23ad59a9747338ef649c1272e6 2x, https://si.imgix.net/0b85a8f1/uploads/origins/6fbcdd53-efb6-41ab-82c9-67be7706891f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200