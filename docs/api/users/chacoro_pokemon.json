えることを願う！\nそれに、私はあなたの落書きペインティングがとても好きです。もし可能なら、私のキャラクターの落書き風の絵を描いてもらえませんか？落書きは、あなたの依頼したプレゼントの絵と同じようなスタイルで、簡単な色を塗るだけです！\nこの2つの絵は、どちらも特定のアクションや表現を要求するものではありません。自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1R714_Gb4lFWpNxaT9bZXhrRUbshBT7Z5", "created_at": "", "completed_at": ""}, {"path": "/@chacoro_pokemon/works/105", "thumbnail_src": "https://si.imgix.net/d0ee0739/uploads/origins/3bf7784f-305e-48f2-adba-c0051e685a25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=460c441dfcff2e367dd080eb3366d904", "thumbnail_srcset": "https://si.imgix.net/d0ee0739/uploads/origins/3bf7784f-305e-48f2-adba-c0051e685a25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=460c441dfcff2e367dd080eb3366d904, https://si.imgix.net/d0ee0739/uploads/origins/3bf7784f-305e-48f2-adba-c0051e685a25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=883f6acc0812aa97884dca0f4ec2420f 2x, https://si.imgix.net/d0ee0739/uploads/origins/3bf7784f-305e-48f2-adba-c0051e685a25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe3dda7e3c4e84899617dd3df3663e42 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chacoro_pokemon/works/104", "thumbnail_src": "https://si.imgix.net/2aa9a13c/uploads/origins/114a4bd7-1298-4853-8e8a-765092274d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bae78667874bd2dbde284fafa43cca3", "thumbnail_srcset": "https://si.imgix.net/2aa9a13c/upload