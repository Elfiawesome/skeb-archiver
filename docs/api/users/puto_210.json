200-b914-b8640ccbcb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79569ce87206130fc91412bb58722693 3x", "genre": "art", "nsfw": false, "body": "こんにちは先生、先生の画風がとても好きです。\nhttps://drive.google.com/drive/folders/1Keloq1kAIQkJCuO8_ByVvj25PaReWsJ3?usp=drive_link\nメイド服を着てほしいです。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Keloq1kAIQkJCuO8_ByVvj25PaReWsJ3?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@puto_210/works/2", "thumbnail_src": "https://si.imgix.net/ed7b6a46/uploads/origins/c4515bf9-2425-4b14-92c4-4bb48157102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8d00f1b1c6f21d0c1df9bccb1f9fdc", "thumbnail_srcset": "https://si.imgix.net/ed7b6a46/uploads/origins/c4515bf9-2425-4b14-92c4-4bb48157102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8d00f1b1c6f21d0c1df9bccb1f9fdc, https://si.imgix.net/ed7b6a46/uploads/origins/c4515bf9-2425-4b14-92c4-4bb48157102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e9b171d11b83cb14d5e25a8039af7bf 2x, https://si.imgix.net/ed7b6a46/uploads/origins/c4515bf9-2425-4b14-92c4-4bb48157102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9db9bc944a59965adb38b8c34475337 3x", "genre": "art", "nsfw": false, "body": "メスケモ化した私（ライラと言いますhttps://www.dropbox.com/sh/gam2wv1rsik6nff/AABxwGhFM9nXwe_bOPiiZp1va?dl=0）を描いていただけませんか？\n ちょっと内気でインドア派、天然なところもあるけど食べること（特にパンケーキ）が大好きで普通の大きさから惑星サイズ以上にも巨大化もできる不思議な女の子です！（資料では真顔ですが、笑顔や恥ずかしがる顔も可愛いのです！）\nポーズや服装などはお任せします！通常のぶかぶかなシャツはもちろん、VRで使い始めたギャル風のホットパンツつきジャケット、その他流行りの服装やぷとぷとさんのお好きなコーデなどで飾り付けてやってください！\nただ、もし可能であればなのですが、巨大化していることがわかりやすいように何か建物や惑星など、比較物を描いて頂けると嬉しいです！\n\nhttps://www.dropbox.com/sh/gam2wv1rsik6nff/AABxwGhFM9nXwe_bOPiiZp1va?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@puto_210/works/1", "thumbnail_src": "https://si.imgix.net/e0087ac9/uploads/origins/ea09cca2-9a2a-4ea9-80c5-f11ae2185e93?bg=%23fff&auto=format%2Cco