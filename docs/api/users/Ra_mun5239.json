.net/a3510670/uploads/origins/f8a79805-f98a-417e-a9b5-2c581f513ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=510d986613caa8926f9250fefd1bc31f", "thumbnail_srcset": "https://si.imgix.net/a3510670/uploads/origins/f8a79805-f98a-417e-a9b5-2c581f513ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=510d986613caa8926f9250fefd1bc31f, https://si.imgix.net/a3510670/uploads/origins/f8a79805-f98a-417e-a9b5-2c581f513ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=478c556ac8a111c43c44b6ad8bff5069 2x, https://si.imgix.net/a3510670/uploads/origins/f8a79805-f98a-417e-a9b5-2c581f513ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c4d70d80fa6befd82efebc34a9ecbd7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ra_mun5239/works/10", "thumbnail_src": "https://si.imgix.net/54955f8c/uploads/origins/1361a85d-09ef-48b6-9e36-67c5d9980018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c6c83cda008096f74bd41fc394e48b3", "thumbnail_srcset": "https://si.imgix.net/54955f8c/uploads/origins/1361a85d-09ef-48b6-9e36-67c5d9980018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c6c83cda008096f74bd41fc394e48b3, https://si.imgix.net/54955f8c/uploads/origins/1361a85d-09ef-48b6-9e36-67c5d9980018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29520f9016e0f9e41a86d739265b027b 2x, https://si.imgix.net/54955f8c/uploads/origins/1361a85d-09ef-48b6-9e36-67c5d9980018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48ecfae922341bc375d84f8d526ea510 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nいつもXやPixivにて御作を拝見しております\n早速ですが、リクエストをさせて下さい\n\n[キャラ名]\n　陽夏木ミカン：まちカドまぞく\n[服装]\n　温泉宿の浴衣：浴衣の柄は指定なし、羽織は橙色にて\n[場所]\n　温泉宿の和室\n[状況]\n　・ほろよい〈白桃とみかん〉でへべれけ\n　・缶を差し出しつつ「あなたも呑みなさいよ～」のポーズ\n[小物類]\n　・雪見障子から降雪\n　・こたつとみかん\n[備考]\n　・アスペクト比は16：9でお願いします\n　・先日拝見したミカのおへそがとても良かったので\n　　出来れば浴衣がはだけて、おへそやおなかが見えていると最高なのですが\n　　浴衣の構造上NSFWになりそうな場合は、この要望の不採用含め適宜ご判断下さい\n\n拝見する限り、あまり縁の無い作品かとはお見受けします\nただ出来れば貴下にお願いを致したく、ご連絡した次第です\nどうかご一考を頂ければ幸いです\n\n以上、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@Ra_mun5239/works/9", "thumbnail_src": "https://si.imgix.net/683bf017/uploads/origins/f942aeb2-3912-48bf-b240-b74ddabe71f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f9ad8f7a1d16890d23c0d727695089b", "thumbnail_srcset": "https://si.imgix.net/683bf017/uploads/origins/f942aeb2-3912-48bf-b240-b74ddabe71f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f9ad8f7a1d16890d23c0d727695089b, https://si.imgix.net/683bf017/uploads/origins/f942aeb2-3912-48bf-b240-b74ddabe71f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a778c38e14f868526bf97da78ae644 2x, https://si.imgix.net/683bf017/uploads/origins/f942aeb2-3912-48bf-b240-b74ddabe71f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06810ea38f446f98bdfc99680cfe581e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！リクエストの募集をずっと待っていました。\n以前、2枚（それぞれ蓮子(東方)、二矢(ブルーアーカイブス)として公開）リクエストさせていただきましたが、今回、改めて、羞恥心彩の画像をリクエストさせていただきます。\n中将一華（ブルーアーカイヴ）は、性格、階級、上司や手下との関係、秘めたる力など、綾と共通する部分が多いと思う。そして、綾が一華の服を着ると、本当にすんなり馴染む。というわけで、一華の服を着た彩をリクエストします。\n概要\nキャラクター射命丸綾\n服装：中正一華のもの。後光は描いても描かなくても構いませんが、綾のトーキンハットがないと本当に混乱するかもしれないので、残しておいてください。\nポーズと構図：指定なし\n表情：一華のトレードマークの笑顔とか？表情は好きなように描いてください。\nモブ天狗の有無も特に指定しません。\n期待しています。", "created_at": "", "completed_at": ""}, {"path": "/@Ra_mun5239/works/8", "thumbnail_src": "https://si.imgix.net/26aacdd8/uploads/origins/b76a8149-f731-4768-aeab-b8efd8382b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e763bc63519e553ac41b35c95b594662", "thumbnail_srcset": "https://si.imgix.net/26aacdd8/uploads/origins/b76a8149-f731-4768-aeab-b8efd8382b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e763bc63519e553ac41b35c95b594662, https://si.imgix.net/26aacdd8/uploads/origins/b76a8149-f731-4768-aeab-b8efd8382b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa7deff8390363693dc56b674189a24 2x, https://si.imgix.net/26aacdd8/uploads/origins/b76a8149-f731-4768-aeab-b8efd8382b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=130f3fce2d77dce81d4ab90782cd11ee 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵は本当にかっこよくてかわいいです\nヘキサデジタルを描いてくれませんか？\nhttps://twitter.com/Hexadigital_/status/1591249261160648704\nありがとうございます。\n\nhttps://twitter.com/Hexadigital_/status/1591249261160648704", "created_at": "", "completed_at": ""}, {"path": "/@Ra_mun5239/works/7", "thumbnail_src": "https://si.imgix.net/49790d11/uploads/origins/e514f1fd-9cae-4b84-b2f1-a66ac811586e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36b5d8d53eec7eb3497f5f83a042a92c", "thumbnail_srcset": "https://si.imgix.net/49790d11/uploads/origins/e514f1fd-9cae-4b84-b2f1-a66ac811586e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36b5d8d53eec7eb3497f5f83a042a92c, https://si.imgix.net/49790d11/uploads/origins/e514f1fd-9cae-4b84-b2f1-a66ac811586e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c79e9d8d8f3634848808d4596adc484 2x, https://si.imgix.net/49790d11/uploads/origins/e514f1fd-9cae-4b84-b2f1-a66ac811586e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e510ea0fac81904a18bc5f22c78bc0a9 3x", "genre": "art", "nsfw": false, "body": "ウマ娘のマンハッタンカフェのイラストをリクエストさせていただきます。\nポーズは「ARTFX J 闇遊戯 (フィギュア)」のポーズで、衣装は勝負服(上着は着た状態)でお願いします。\nなお、デュエルディスクとカードは持たせて千年パズルは不要です。", "created_at": "", "completed_at": ""}, {"path": "/@Ra_mun5239/works/6", "thumbnail_src": "https://si.imgix.net/23a0a1af/uploads/origins/56a1fb77-8508-4dcc-babb-de72478836df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9259caeffbedd00cba5a1804b5213fd", "thumbnail_srcset": "https://si.imgix.net/23a0a1af/uploads/origins/56a1fb77-8508-4dcc-babb-de72478836df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9259caeffbedd00cba5a1804b5213fd, https://si.imgix.net/23a0a1af/uploads/origins/56a1fb77-8508-4dcc-babb-de72478836df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4b051d8ca87cc80c32ad1fbac97b255 2x, https://si.imgix.net/23a0a1af/uploads/origins/56a1fb77-8508-4dcc-babb-de72478836df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f364131f64d82b4e69e6e2cf9d86041 3x", "genre": "art", "nsfw": false, "body": "Hello らーむん-san,\nPlease draw Nazrin again however you wish!\nThank you very much!\n\nらーむんさん、こんにちは。\nまた好きなようにナズーリンを描いてください\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Ra_mun5239/works/5", "thumbnail_src": "https://si.imgix.net/08d4c8d1/uploads/origins/2b884eb8-a92d-4704-95e2-b9a95e0d281d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40590da3bc0647c6bd268d5fcdf9257c", "thumbnail_srcset": "https://si.imgix.net/08d4c8d1/uploads/origins/2b884eb8-a92d-4704-95e2-b9a95e0d281d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40590da3bc0647c6bd268d5fcdf9257c, https://si.imgix.net/08d4c8d1/uploads/origins/2b884eb8-a92d-4704-95e2-b9a95e0d281d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a6ba090ec64374a4f651a2943d957c3 2x, https://si.imgix.net/08d4c8d1/uploads/origins/2b884eb8-a92d-4704-95e2-b9a95e0d281d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5011ec