いる。乳房は溶解と劣化が進行中だ。サンダルは黒く革製のまま（チョコレート化されていない）。細部の描写はご自由にお任せします。ご検討いただきありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@cacaodecocoa/works/1026", "thumbnail_src": "https://si.imgix.net/0ea27a3d/uploads/origins/78e66b23-5833-4357-a37d-117be0ac1cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30ba030a4dd67427fa958bf3b34759c4", "thumbnail_srcset": "https://si.imgix.net/0ea27a3d/uploads/origins/78e66b23-5833-4357-a37d-117be0ac1cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30ba030a4dd67427fa958bf3b34759c4, https://si.imgix.net/0ea27a3d/uploads/origins/78e66b23-5833-4357-a37d-117be0ac1cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd6a649f72d094c4923c1e4f8bc16a59 2x, https://si.imgix.net/0ea27a3d/uploads/origins/78e66b23-5833-4357-a37d-117be0ac1cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d703fb265805510cdd026efb04ed822 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@cacaodecocoa/works/1025", "thumbnail_src": "https://si.imgix.net/3c160814/uploads/origins/17f5d8d1-9b72-4a13-bf8e-dcc59ca804a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=001858de7926c6c129cd73452381d671", "thumbnail_srcset": "https://si.imgix.net/3c160814/uploads/origins/17f5d8d1-9b72-4a13-bf8e-dcc59ca804a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=001858de7926c6c129cd73452381d671, https://si.imgix.net/3c160814/uploads/origins/17f5d8d1-9b72-4a13-bf8e-dcc59ca804a2?bg=%23fff&auto=format%2Cco