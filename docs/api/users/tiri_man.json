ix.net/d88a13ba/uploads/origins/52d2d384-b3d6-4251-a558-8921776b0f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0a4a6042d7b876c17ab2c57bc388063", "thumbnail_srcset": "https://si.imgix.net/d88a13ba/uploads/origins/52d2d384-b3d6-4251-a558-8921776b0f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0a4a6042d7b876c17ab2c57bc388063, https://si.imgix.net/d88a13ba/uploads/origins/52d2d384-b3d6-4251-a558-8921776b0f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=711a762adfe37bb98cb3a438b1c0ce7f 2x, https://si.imgix.net/d88a13ba/uploads/origins/52d2d384-b3d6-4251-a558-8921776b0f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d0f4ce37f38d4e1452b455fa6ce88f8 3x", "genre": "art", "nsfw": true, "body": "ちりまん先生、こんにちは。うちの子のイラストを依頼したいと思っております。\n\nキャラクター：うちの子「リリス」/ Lilyth\n赤と紫のオッドアイで、白色の長い髪。若い少女の見た目で、自信と優しさが兼備する上位存在の女王様。「普通にやっているだけですよ」と言っても、見せられた絶対的な強さとそれを見せつけるためでもない余裕によって、誰もリリスのことを上位的な存在だと思っている。  \n女の子らしい「いたずら」をすることもあります。 リリスにはちょっとした遊び程度ですが、いじわるされる方からだと、絶対的な余裕で支配されてる感じがします。\n\nシチュエーションや衣装：\nお胸の大きさは、爆でお願いいたします。衣装は本来の衣装の露出度高めのアレンジ、もしくは豪華な大胆な下着姿(深い色、ガーターベルトやストッキングとかも似合いそうですが、必ずではありませんので、おまかせします)でお願いいたします。女王様の攻め攻めな、優位からのいたずらなお誘いみたいな感じでお願いいたします。\n\n細部：\n髪型や前髪、アクセサリーや細部のデザインはご自由にアレンジしてください。キャラクターの雰囲気やシチュエーションも、「こういう1面がえちち」などのアイデアがございましたら、以上の点より先生のアイデアを優先して大丈夫です。\n\n宛名有り無し差分とレイヤー分けのPSDファイルも可能でしたらお願い致します。\n\nでは、ぜひご検討をお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1kXkcGn7wPFgeyLpuor3Kcs3JCmN0z5ec", "created_at": "", "completed_at": ""}, {"path": "/@tiri_man/works/108", "thumbnail_src": "https://si.imgix.net/d8002dd8/uploads/origins/59bd190f-4828-4051-84cf-876c9ca38c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a76621e176657d5a78a6d3b86643be93", "thumbnail_srcset": "https://si.imgix.net/d8002dd8/uploads/origins/59bd190f-4828-4051-84cf-876c9ca38c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a76621e17665