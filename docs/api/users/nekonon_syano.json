4e3e-bb69-d802a40d2138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=803048d32961e4766037005f7b7bba83", "thumbnail_srcset": "https://si.imgix.net/0d46a479/uploads/origins/600215df-d12f-4e3e-bb69-d802a40d2138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=803048d32961e4766037005f7b7bba83, https://si.imgix.net/0d46a479/uploads/origins/600215df-d12f-4e3e-bb69-d802a40d2138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3e1cec4254f3102cc8bfcd9b475a73b 2x, https://si.imgix.net/0d46a479/uploads/origins/600215df-d12f-4e3e-bb69-d802a40d2138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=798291a0ed594652495031bc7c103fa0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたのスタイルが大好きで、私の虎のOCがそれを着ているのをとても見たいわ！\n\n特に指定はないので、自由に描いてください。\n服を着せてください。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1RLrGXaaQQSjZ_9lkLtnocVqWKvtpwTYL?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nekonon_syano/works/92", "thumbnail_src": "https://si.imgix.net/7e06cf67/uploads/origins/b4ce08ca-e775-4a03-b9ec-8e3844375767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0007ae42aedb87c1d136d94cb10b559e", "thumbnail_srcset": "https://si.imgix.net/7e06cf67/uploads/origins/b4ce08ca-e775-4a03-b9ec-8e3844375767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0007ae42aedb87c1d136d94cb10b559e, https://si.imgix.net/7e06cf67/uploads/origins/b4ce08ca-e775-4a03-b9ec-8e3844375767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e123b3f859a5aaf24393d57aeca4f607 2x, https://si.imgix.net/7e06cf67/uploads/origins/b4ce08ca-e775-4a03-b9ec-8e3844375767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4605c115fc0edd095b31bc9b82049a95 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n絵のスタイルがすごく素敵で可愛いですね！大好きです❤️！\n私のキャラクターのとっても可愛い絵を描いてもらえませんか？お願いします🥺！\n私のキャラクターのエッチで誘惑的な性格を描いていただけると嬉しいです🥰！\nそれと、いつものように足の裏と肉球を綺麗に描いてください🐾。\nどんなポーズでも大丈夫です！ありがとうございます！あ、そうそう！赤い紐の飾りと白い髪は描かないでくださいね！\n参考までに：\nhttps://drive.google.com/file/d/1TO5Pcm3Fy5fxger2J7Hq8y9uyfJ3M54K/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nekonon_syano/works/91", "thumbnail_src": "https://si.imgix.net/36da870c/uploads/origins/2c2b02d7-b235-4515-a284-dd6c3c512648?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0231124d9d19fb9659167fe9e67714dc", "thumbnail_srcset": "https://si.imgix.net/36da870c/uploads/origins/2c2b02d7-b235-4515-a284-dd6c3c512648?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0231124d9d19fb9659167fe9e67714dc, https://si.imgix.net/36da870c/uploads/origins/2c2b02d7-b235-4515-a284-dd6c3c512648?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7f1f8cce30b8223da40093efa94dd2e 2x, https://si.imgix.net/36da870c/uploads/origins/2c2b02d7-b235-4515-a284-dd6c3c512648?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1d8a592d977c38a00abe83cff64bfe7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。この度、絵を依頼させていただくことになりました！自由に描いていただいて大丈夫です！\nあなたの画風が好きです！自由に好きなように描いてください╰(*´︶`*)╯。\n\n頬の濃い紫のひし形模様は薄紫と白の間なのでご了承ください。\n\nマイキャラ(お絵かきメモ含む)\nhttps://imgur.com/a/LoxXF9N\nその他の写真\nhttps://toyhou.se/17383922.--yanaqi/18677877.ssr\n\n参考までに私の好きな要素を紹介します；\n前足(肉球)、六芒星(✡)、輝く星(✨️)、星空、紫、ハロウィン、魔法、魔女、魔法の杖、ファンタジー、ドリーミー、かわいい要素、雪の結晶、森、ユリ。", "created_at": "", "completed_at": ""}, {"path": "/@nekonon_syano/works/90", "thumbnail_src": "https://si.imgix.net/bde1d496/uploads/origins/c3be9542-75bb-4c78-9bc6-c44505387add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67c0d57bb2d766d7e507a06135ae8d12", "thumbnail_srcset": "https://si.imgix.net/bde1d496/uploads/origins/c3be9542-75bb-4c78-9bc6-c44505387add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67c0d57bb2d766d7e507a06135ae8d12, https://si.imgix.net/bde1d496/uploads/origins/c3be9542-75bb-4c78-9bc6-c44505387add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=239fe41cf18f1c1fb89d8a84e35e17fb 2x, https://si.imgix.net/bde1d496/uploads/origins/c3be9542-75bb-4c78-9bc6-c44505387add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=621e1ad87a5f75ee17553b03e16454b1 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nあなたの作品に出会って、キャラクターごとに短いストーリーを作っているところが気に入りました。くだらないものが一番笑えました。また、あなたのアートスタイルも大好きです。私の日陰のフクロウのキャラクターが、あなたのスタイルで描かれているのを見たかったんです。私のキャラクターは、ふだんは慌てやすく、内気で遊び好きなのですが、すべてお任せします。\n\n私のOC\nhttps://drive.google.com/file/d/1Jq-9-D_PyUgQ4M3NHhZqKL9qkhRYxkv3/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1JkeLDCGRKLOy3AdiG_Gm7AKBBfkjw18Y/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1S_p3Mcas7dhGhn1fjpZiWhIcyQaVqmFR/view?usp=drivesdk\n\nこのたびは、本リクエストをご検討いただき、誠にありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@nekonon_syano/works/89", "thumbnail_src": "https://si.imgix.net/cdea2316/uploads/origins/91051070-9fda-4f59-8997-bbb1cbfc423a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bce687a46e898f9126753fea17e4945", "thumbnail_srcset": "https://si.imgix.net/cdea2316/uploads/origins/91051070-9fda-4f59-8997-bbb1cbfc423a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bce687a46e898f9126753fea17e4945, https://si.imgix.net/cdea2316/uploads/origins/91051070-9fda-4f59-8997-bbb1cbfc423a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=359e57af91d108dbfc8bebc880521091 2x, https://si.imgix.net/cdea2316/uploads/origins/91051070-9fda-4f59-8997-bbb1cbfc423a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aef86f35f318c4c86d0505215f5ee96 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！\n私とボーイフレンドを主人公にした、かわいくてほのぼのとした漫画が好きです：\n\n私（男性）：私（男）：私のボーイフレンドより少し背が低い、小さな毛皮の青いドラゴン（翼はない）。柔らかくて表情豊かで、寄り添うのが大好き。\n\n私のボーイフレンド（オス）：思いやりがあり、愛情深く、心が温かく、守ってくれる。\n\nシーンのアイデア\n私（ブルー・ドラゴン）は長い一日の疲れを癒すため、一人で家まで歩いている。\n私がドアの鍵を開けて中に入ると、空は柔らかいオレンジと紫に輝いている。\n私のボーイフレンド（たてがみオオカミ）はすでに家の中にいて、たぶんくつろいでいるのだろう。私の姿を見るやいなや、彼は温かい笑顔で歩み寄り、私をそっと抱きしめた。\n私たちはソファやベッドに寄り添って一日を終える。私は彼に寄り添い、彼の腕は完璧な心地よさで私を包み込む。やっと帰ってきた」という安らかな気持ちになる。\n\n服の有無にかかわらず、私たちを描いてください。服を入れる場合は、ジョガーパンツに厚手のシャツやプルオーバーパーカーのような、ゆったりとしたカジュアルな服装が好みです。\n\nキャラクター紹介（別ファイル2つ）：\n私：https://drive.google.com/drive/folders/1C2qD5sVQfrrHbXoCINaIpW5WdoBWONZJ?usp=drive_link\r\n\r\nBF: https://drive.google.com/drive/folders/12zCXZ1xOVwpzphH_n2c4UnhftzUKBhEu?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1C2qD5sVQfrrHbXoCINaIpW5WdoBWONZJ?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nekonon_syano/works/88", "thumbnail_src": "https://si.imgix.net/135fd73f/uploads/origins/106d2d02-2602-4afc-85f8-38b1febd051c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46871b9d19c9ad89b883596271319e98", "thumbnail_srcset": "https://si.imgix.net/135fd73f/uploads/origins/106d2d02-2602-4afc-85f8-38b1febd051c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46871b9d19c9ad89b883596271319e98, https://si.imgix.net/135fd73f/uploads/origins/106d2d02-2602-4afc-85f8-38b1febd051c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c884b211f9eab6dbd6aa7ee244c437f7 2x, https://si.imgix.net/135fd73f/uploads/origins/106d2d02-2602-4afc-85f8-38b1febd051c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09867faff84a30d76741f4d3f4cb6d9a 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！二人のキャラクターの漫画をお願いしたいです。二人が散らかった家の掃除屋をするのですが、初心者なのでよくつまずいたり、失敗したりします。結末は、家が水浸しになるなど、さらに大混乱になる可能性があります。\nありがとうございました！\n\nシオン\nhttps://drive.google.com/drive/folders/12annRmLX6LBL8h24OQ-sZtJxmwnMGB6p\nぽるぴー：\nhttps://drive.google.com/file/d/1FuKYRuskgR0yf39hwMRY2ayY5S5KFnQn/view", "created_at": "", "completed_at": ""}, {"path": "/@nekonon_syano/works/87", "thumbnail_src": "https://si.imgix.net/f15b7934/uploads/origins/90344960