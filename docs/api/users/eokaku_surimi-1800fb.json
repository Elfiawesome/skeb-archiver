e%2Ccenter&txtsize=30&txt=PRIVATE&s=c712086cc6efd363a79a320b4bece6fc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eokaku_surimi/works/49", "thumbnail_src": "https://si.imgix.net/24bd2614/uploads/origins/12cc2bc7-9c2d-42a5-87e3-b0f7bd317e66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f3a749063c3129de58ec05a22bfe314", "thumbnail_srcset": "https://si.imgix.net/24bd2614/uploads/origins/12cc2bc7-9c2d-42a5-87e3-b0f7bd317e66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f3a749063c3129de58ec05a22bfe314, https://si.imgix.net/24bd2614/uploads/origins/12cc2bc7-9c2d-42a5-87e3-b0f7bd317e66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad8074f46f81936031184fabb5a0354c 2x, https://si.imgix.net/24bd2614/uploads/origins/12cc2bc7-9c2d-42a5-87e3-b0f7bd317e66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93f7c356e6380dae56db9125183cab40 3x", "genre": "art", "nsfw": false, "body": "すり身先生こんにちは！また私のオリジナルキャラクターをお願いしてもよろしいでしょうか？\n\nシナ / Cinna / 170cm / 21歳：静かで大人しい人。一見無表情で冷たそうな人に見えるけど、シナはとても暖かくて優しいし、素直で前向きな頑張り屋。とてもいい子。でも、他人と話すのは少し苦手で、自分の無表情さで人上手く繋がれないのが不安。趣味は美術で友達に描いた絵と手作りをプレゼントするのは好き。\n\nカーネリアン / Carnelian / 180cm / 27歳 ：柔らかい雰囲気をしている優しい人。激しい表情をしないし、いつも優しい笑顔しているのに、内緒が多くて、滅多に本音を言わないタイプ。ずっと前から家族と知り合いとの関係が深めなくて、人と一緒にするのは苦手と思い込んでいる。子供時代、カーネリアンは親の言いなりにピアノを習って、ピアノが全然好きにならなかった。\n\n二人の関係：アパートのお隣さんから始まる関係。カーネリアンはトラウマのせいでシナのことをあまり近づきたくないけど、シナの素直さと優しさのおかげで自然と近づいてしまう。シナに出会ってから、カーネリアンの日々がちょっと明るくなって、カーネリアンがいると、シナは笑うようになりました。\n\n時間が経って、家族のような形になる。別々のアパートに住んでいても、一緒にご飯を食べたり、お互いの部屋に時間を過ごすことが多い。カーネリアンはピアノを苦しいことだと思って、もう練習しないのに、シナが弾く度に嬉しそうに見えれからピアノをやっと好きになった。シナが絵を描いている時に弾きます。他人に関係を説明するのは難しいけど二人は特別で愛おしい関係と思っている。\n\nモチーフ：春／冬、傘、花（赤いカメリアと雛菊）、羊と狼\n\n日常のスナップショットの絵を描いていただいたら嬉しくて、心地良い雰囲気が好きです。以前描いリクエスト\nhttps://skeb.jp/@eokaku_surimi/works/13\nのような二人の嬉しい姿が見たいです。\n\nキャラの参考：https://drive.google.com/drive/folders/1WF0B_43EjakOs3KmWrW2FEztp99bEIg3?usp=sharing\n\n金額が足りない場合はアピールかキャンセルをどうぞお願いします。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@eokaku_surimi/works/48", "thumbnail_src": "https://si.imgix.net/7bde7b53/uploads/origins/e4e0829e-ae5f-44ec-82c9-34992e822062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eba0ccd660a8110e88cf4507368cf84", "thumbnail_srcset": "https://si.imgix.net/7bde7b53/uploads/origins/e4e0829e-ae5f-44ec-82c9-34992e822062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eba0ccd660a8110e88cf4507368cf84, https://si.imgix.net/7bde7b53/uploads/origins/e4e0829e-ae5f-44ec-82c9-34992e822062?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e98d6f83faa3ddb3116ed37c40bc8c54 2x, https://si.imgix.net/7bde7b53/uploads/origins/e4e0829e-ae5f-44ec-82c9-34992e822062?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11cf9f0bdaedc8bfa85a65e4023c2cfd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eokaku_surimi/works/47", "thumbnail_src": "https://si.imgix.net/03bb4926/uploads/origins/68040ad9-8fa9-41fa-b0f5-d26ee0ebb733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c94a78d33a419453cbc0ede250c3790", "thumbnail_srcset": "https://si.imgix.net/03bb4926/uploads/origins/68040ad9-8fa9-41fa-b0f5-d26ee0ebb733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsi