Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8cf22068efd6ab3710add8c188fc10d 3x", "genre": "art", "nsfw": true, "body": "秋空先生、お久しぶりです！　それではリクエストの程を、お願い申し上げます！\n\n内容は前回の続きで、ベレト×シャミアのいちゃラブセックス、体位は松葉崩しでお願いします！\n\n前回のレトシャミ騎乗位、本当に最高でした！　素晴らしいご執筆です！\nお忙しい中、恐縮ではございますが、何卒ご検討いただければ幸いに存じ上げます！\nよろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/9", "thumbnail_src": "https://si.imgix.net/8bb6ea00/uploads/origins/0219ab78-fa11-49cf-b8cf-ca64180ef1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90613b4910c00bf597ef71a84845894f", "thumbnail_srcset": "https://si.imgix.net/8bb6ea00/uploads/origins/0219ab78-fa11-49cf-b8cf-ca64180ef1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90613b4910c00bf597ef71a84845894f, https://si.imgix.net/8bb6ea00/uploads/origins/0219ab78-fa11-49cf-b8cf-ca64180ef1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5fda783fbb3b5e72ddb11b59e857263 2x, https://si.imgix.net/8bb6ea00/uploads/origins/0219ab78-fa11-49cf-b8cf-ca64180ef1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2974ed01238faa1f73aada33d3d80cb 3x", "genre": "art", "nsfw": true, "body": "秋空先生、お久しぶりです。前回はありがとうございました！\n\n前回の続きで、ベレト×シャミアのいちゃラブセックス、体位は騎乗位でお願いします！\n\nいつも素晴らしい絵をありがとうございます！\n年末年始にさしかかり、お忙しいところ恐縮ですがご検討のほどよろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/8", "thumbnail_src": "https://si.imgix.net/9a88f7d7/uploads/origins/da205d71-7e95-4d35-902d-a82edce9d742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02d9ac9381ae555431d80fec84d0f44a", "thumbnail_srcset": "https://si.imgix.net/9a88f7d7/uploads/origins/da205d71-7e95-4d35-902d-a82edce9d742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02d9ac9381ae555431d80fec84d0f44a, https://si.imgix.net/9a88f7d7/uploads/origins/da205d71-7e95-4d35-902d-a82edce9d742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=368ad90b0bdc1e95079ce60169c08e5a 2x, https://si.imgix.net/9a88f7d7/uploads/origins/da205d71-7e95-4d35-902d-a82edce9d742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ca732d9ddeb5db681548c43a6e0641d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/7", "thumbnail_src": "https://si.imgix.net/7877ddbb/uploads/origins/95a5d90d-1580-4ea7-a3f6-42702fb69d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dea12f51125ad33d73c1868af94bcb5", "thumbnail_srcset": "https://si.imgix.net/7877ddbb/uploads/origins/95a5d90d-1580-4ea7-a3f6-42702fb69d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dea12f51125ad33d73c1868af94bcb5, https://si.imgix.net/7877ddbb/uploads/origins/95a5d90d-1580-4ea7-a3f6-42702fb69d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bb5229080af9202fc6d51bd25c80931 2x, https://si.imgix.net/7877ddbb/uploads/origins/95a5d90d-1580-4ea7-a3f6-42702fb69d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0bf5b70a58ff7521dc9b47b65f3868a 3x", "genre": "art", "nsfw": true, "body": "はじめまして。絵柄や表情が好みで、いつも拝見しています。\n早速ですが以下の通りリクエストさせていただきます。\n\n■キャラクター\n七海千秋\n\n■シチュエーション\n・ガラスの壁にくっつけたディルドで、立ったままガニ股でアナニーをする全裸の七海\n・怒り眉に口を尖らせたアヘ顔が、資料のようにワイプで見えている\n・汚いオホ声をあげている\n\n可能であれば剛毛でお願いしたいです。\nよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/120157751", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/6", "thumbnail_src": "https://si.imgix.net/5059d0cf/uploads/origins/64f4b113-2fd6-46da-acf4-39277953ff3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab2e095cf61b03991778323cf168b205", "thumbnail_srcset": "https://si.imgix.net/5059d0cf/uploads/origins/64f4b113-2fd6-46da-acf4-39277953ff3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab2e095cf61b03991778323cf168b205, https://si.imgix.net/5059d0cf/uploads/origins/64f4b113-2fd6-46da-acf4-39277953ff3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd40e26fad5166da17a48a78fdb04a68 2x, https://si.imgix.net/5059d0cf/uploads/origins/64f4b113-2fd6-46da-acf4-39277953ff3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57dcbe7940e7983e09eea4ac064df56b 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nキャラクター\nワンパンマンの地獄のフブキをお願いします。\n\nシチュエーション\n以前、秋空さんが描かれた即堕ちする霧切さんのイラスト(https://www.pixiv.net/artworks/103058324)と同じような感じで、催眠術を操る怪人を追い詰めたフブキだったが、怪人に催眠術をかけられ、即堕ちひょっとこフェラしてしまうというシチュエーションをお願いします。\n\n台詞は、簡単な台詞を入れて欲しいです。\n\n可能でしたら、フブキがフェラする時は、上記の霧切さんのイラストと同じように、ひょっとこフェラしながら、舌でチンポを舐めまわしている感じで描いて貰えるととても", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/5", "thumbnail_src": "https://si.imgix.net/a232cb3f/uploads/origins/6e7512f2-0622-4ccf-866e-d78b0c3e4926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d65dcf34396bf0c906bcb7782cadf54", "thumbnail_srcset": "https://si.imgix.net/a232cb3f/uploads/origins/6e7512f2-0622-4ccf-866e-d78b0c3e4926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d65dcf34396bf0c906bcb7782cadf54, https://si.imgix.net/a232cb3f/uploads/origins/6e7512f2-0622-4ccf-866e-d78b0c3e4926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05de8074fbd183b05a41d7b22380aed1 2x, https://si.imgix.net/a232cb3f/uploads/origins/6e7512f2-0622-4ccf-866e-d78b0c3e4926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc1a81a2f0bea03912bd230715cc4a52 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/4", "thumbnail_src": "https://si.imgix.net/60dbd879/uploads/origins/48738ae9-3ebc-4fc6-975c-dfdc178ef1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b12e301ed9d9ebdd90b15d98d3b4dc17", "thumbnail_srcset": "https://si.imgix.net/60dbd879/uploads/origins/48738ae9-3ebc-4fc6-975c-dfdc178ef1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b12e301ed9d9ebdd90b15d98d3b4dc17, https://si.imgix.net/60dbd879/uploads/origins/48738ae9-3ebc-4fc6-975c-dfdc178ef1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7e0c6f6e6dd79b3b8b25852e23be805 2x, https://si.imgix.net/60dbd879/uploads/origins/48738ae9-3ebc-4fc6-975c-dfdc178ef1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89ae3309d96f61cdb94fb9eeae179ed5 3x", "genre": "art", "nsfw": true, "body": "秋空先生、お久しぶりです！　\n以前、pixivの方でベレト×シャミアのイチャラブセックス絵をリクエストした者です。\nリクエスト関係はこちらをメインで行っておりまして、先生がskebにおかれましてもご開設なされたということで、こちらでお願い申し上げます！\n\n前回の続きで、ベレト×シャミアのいちゃラブセックス、体位は後背位でお願いします！\n\n前回はとても素晴らしい愛を感じる一枚をありがとうございました！\n先生のご執筆が、今後更に奮われますように！", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/3", "thumbnail_src": "https://si.imgix.net/287f175a/uploads/origins/e7a86bee-4541-47e6-b682-32a3b29ab0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285bb1675d7a88ca0e24bcbfc8713137", "thumbnail_srcset": "https://si.imgix.net/287f175a/uploads/origins/e7a86bee-4541-47e6-b682-32a3b29ab0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285bb1675d7a88ca0e24bcbfc8713137, https://si.imgix.net/287f175a/uploads/origins/e7a86bee-4541-47e6-b682-32a3b29ab0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a6f44d8f9c64c2b636616684fbf9f49 2x, https://si.imgix.net/287f175a/uploads/origins/e7a86bee-4541-47e6-b682-32a3b29ab0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=723e5ad647ccc7c4e63ae7f70a61a1a1 3x", "genre": "art", "nsfw": true, "body": "淫らな夏服を着た綾瀬さんを描いてください。ホットパンツ、タイトブラ、ハイレグTバック（紐）、覗く陰毛、勃起乳首、乳首ピアス。予算が許せば、ノーパン、使用済みコンドーム、はみ出た陰毛「抜け陰毛」、精液などの差分もお願いします。\n\nhttps://x.com/i/status/1771807154359726545", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/2", "thumbnail_src": "https://si.imgix.net/3a914dc0/uploads/origins/d2b8ade9-6d16-4c93-a60f-072870a4917c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88843aa355697592e292630473a26fe4", "thumbnail_srcset": "https://si.imgix.net/3a914dc0/uploads/origins/d2b8ade9-6d16-4c93-a60f-072870a4917c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88843aa355697592e292630473a26fe4, https://si.imgix.net/3a914dc0/uploads/origins/d2b8ade9-6d16-4c93-a60f-072870a4917c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25a6fa5170c3cdc0e9900f61d171cdf8 2x, https://si.imgix.net/3a914dc0/uploads/origins/d2b8ade9-6d16-4c93-a60f-072870a4917c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d347535ce1b55ec0f52325b6a9a649c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@re_akisora/works/1", "thumbnail_src": "https://si.imgix.net/b72f3809/uploads/origins/966f0ce2-e07b-425b-bee0-4a21aabbd5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6442bb21a010068f4502cd954b40bb", "thumbnail_srcset": "https://si.imgix.net/b72f3809/uploads/origins/966f0ce2-e07b-425b-bee0-4a21aabbd5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6442bb21a010068f4502cd954b40bb, https://si.imgix.net/b72f3809/uploads/origins/966f0ce2-e07b-425b-bee0-4a21aabbd5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56eb259fcef4295873ea83d3701980e6 2x, https://si.imgix.net/b72f3809/uploads/origins/966f0ce2-e07b-425b-bee0-4a21aabbd5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17464d6c0409ed5148df5332a28ed85e 3x", "genre": "art", "nsfw": true, "body": "レイプ犯のちんちんを泣きながらお掃除フェラする我那覇響を描いてください", "created_at": "", "completed_at": ""}]}