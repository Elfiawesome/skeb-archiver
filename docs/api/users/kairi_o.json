had=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e640c273c3c52628e1b2cce8e8ed24d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kairi_o/works/20", "thumbnail_src": "https://si.imgix.net/e18205b9/uploads/origins/f34e4b2f-894e-4ace-b00f-c59a180234bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c0dfb111ad6c7aad0763e2c14a174d", "thumbnail_srcset": "https://si.imgix.net/e18205b9/uploads/origins/f34e4b2f-894e-4ace-b00f-c59a180234bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c0dfb111ad6c7aad0763e2c14a174d, https://si.imgix.net/e18205b9/uploads/origins/f34e4b2f-894e-4ace-b00f-c59a180234bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=237fa4dbc515f8cc6a9f4bd4446dce63 2x, https://si.imgix.net/e18205b9/uploads/origins/f34e4b2f-894e-4ace-b00f-c59a180234bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd4da8fbb0bad79aa1860007a9d80cea 3x", "genre": "art", "nsfw": true, "body": "前回の絵が最高でしたので、またリクエストさせてください。\n\nこちらと似たような仕様で\nhttps://skeb.jp/@kairi_o/works/14\n\nロマサガMSのミリアムの立ち絵をお願いします\nレイヤーめくると通常→服破け→裸になるやつです\n(膝上まで、背景なし)\n\nもちろん女の子なので今回おにんにんは不要です。\n依頼内容を考えて少し盛りましたが条件など厳しければご遠慮なくキャンセルしてください。\nお読みいただきありがとうございました。\n\nhttps://sites.google.com/view/sryo/miriamu%E3%81%AE%E3%82%B3%E3%83%94%E3%83%BC", "created_at": "", "completed_at": ""}, {"path": "/@kairi_o/works/19", "thumbnail_src": "https://si.imgix.net/12c5781c/uploads/origins/5a953d6b-2784-4af0-85d8-be8960b38379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87260d9860259b4efba4430af46935c7", "thumbnail_srcset": "https://si.imgix.net/12c5781c/uploads/origins/5a953d6b-2784-4af0-85d8-be8960b38379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign