mpleted_at": ""}, {"path": "/@kairi_o/works/17", "thumbnail_src": "https://si.imgix.net/1edce429/uploads/origins/667e3c43-ac44-4995-a339-6d4ae58d3294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd080671d8ef615dc17a909c698e775", "thumbnail_srcset": "https://si.imgix.net/1edce429/uploads/origins/667e3c43-ac44-4995-a339-6d4ae58d3294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd080671d8ef615dc17a909c698e775, https://si.imgix.net/1edce429/uploads/origins/667e3c43-ac44-4995-a339-6d4ae58d3294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c3a67b4eeef55cd801be1792d1a103f 2x, https://si.imgix.net/1edce429/uploads/origins/667e3c43-ac44-4995-a339-6d4ae58d3294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=727e0e7aec9b2258100c2a802530c19a 3x", "genre": "art", "nsfw": true, "body": "FGOの酒呑童子をお願いします。 \n設定：\nカルデアで唯一絆15のサーヴァントである酒呑は、大好きなマスターのため、どんな性癖でも満たしてあげる。夜マイルームに戻ると、酒呑は全裸でベッドの上で座り、腕を上げて汗だくの脇を見せる同時、蒸れて匂そうな足裏を見せながらM字開脚し、びしょびしょのまんこは愛液が溢れるような状態で、ど淫乱な顔でマスターを誘惑している。\n\n構図は主観視点で、特に脇と足裏を重んじて描いてくださったら嬉しいです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kairi_o/works/16", "thumbnail_src": "https://si.imgix.net/56e2fc7f/uploads/origins/37aa5d12-c720-49d8-905b-280f5dd921c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cad056ba10b4e25e5b36dacef3e9d3e", "thumbnail_srcset": "https://si.imgix.net/56e2fc7f/uploads/origins/37aa5d12-c720-49d8-905b-280f5dd921c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cad056ba10b4e25e5b36dacef3e9d3e, https://si.imgix.net/56e2fc7f/uploads/origins/37aa5d12-c720-49d8-905b-280f5dd921c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txt