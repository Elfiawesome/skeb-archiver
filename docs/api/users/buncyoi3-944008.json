3-b1a0-6a1770dcddae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07bc27213e211975c2a798cd37518b6d 2x, https://si.imgix.net/f4b670f0/uploads/origins/c1363b9f-e8e4-4fb3-b1a0-6a1770dcddae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b410b920e1c066736172953e5947a4f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！最近のイラストがとても好きなので、こんにちは！私はあなたの絵がとても好きです。 私のオリジナルキャラクター2人を一緒に描いていただけませんか？、絵を購入させていただきました。🙇🏻‍♂️🙏🏻 😿\n\n  血の繋がらない兄妹です、男の子は20～24歳で青年です、現在社会人です、表情はほとんどありません、青年として描いて頂ければと思います。 彼は実の妹のことがとても好きです。 彼の妹は10歳で、日本の小学生ですが、とても活発です！彼女の顔はいつも微笑んでいる。  二人の身長差があるので、🙇🏻‍♂️🙇🏻‍♂️🙏🏻\n\n 行動やキャラクターのやり取りなど、具体的な部分は自由に描いていただいて構いませんが、男の子はもう少しハンサムに、(お妹さんはもう少し年齢を若くして、できれば体や顔のプロポーションを整えていただければと思います！）ありがとうございました。🙇🏻‍♂️🙇🏻‍♂️   \n\n私のリクエストを考慮していただき、ありがとうございます！ もし検討していただけたら幸いです。よろしくお願いします！ 🙏🏻 🙇🏻‍♂️🙇🏻‍♂️\n\n 「キャラクターリファレンス」 \n\nhttps://drive.google.com/drive/folders/19axD8ceEFX2GdVhqZgkSvUYBgsalNywX", "created_at": "", "completed_at": ""}, {"path": "/@buncyoi3/works/13", "thumbnail_src": "https://si.imgix.net/78ad79fa/uploads/origins/a850d68c-9fd3-4fcd-bd19-2a85db14e03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42aab5a4390328dd9c08b749564266ec", "thumbnail_srcset": "https://si.imgix.net/78ad79fa/uploads/origins/a850d68c-9fd3-4fcd-bd19-2a85db14e03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42aab5a4390328dd9c08b749564266ec, https://si.imgix.net/78ad79fa/uploads/origins/a850d68c-9fd3-4fcd-bd19-2a85db14e03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06e4b26a1a0519fe0ce98edac95bd91f 2x, https://si.imgix.net/78ad79fa/uploads/origins/a850d68c-9fd3-4fcd-bd19-2a85db14e03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=592a0feafb2b5a324a23a4f7b96321cb 3x", "genre": "art", "nsfw": false, "body": "はじめまして、リクエスト失礼します。 ハルさんの高い画力で描きこなされるキャラクターを捉えた物語性のある作品がとても大好きです！ TwitterでハルさんのSkebの作品を拝見して是非描いていただきたいと思っていました！   \nリクエスト文に誤りがありましたので再送失礼致します！\n\nもしよろしければ私のオリジナルキャラクターの戌角(黒いほう)と虎渡(白いほう)を描いて頂きたいです。 キャラクターの資料はURLをご参照ください。\n  虎渡はお金持ちのボンボンでずる賢くプライドが高いですが、媚を売るのも得意な世渡り上手な性格です。 好奇心旺盛で、庶民のものにも流行りのものにも興味があります。\n 猫とショッピングと人をからかうのが好きです。 \n庶民の戌角をおもちゃのように連れ回しています。\n  戌角は喧嘩が強い不良高校の生徒です。\n 本人は正義感が強く真面目なつもりですが、頭があんまりよくなく治安の悪い環境で育ったので基本的に暴力で解決しようとしてしまいます。\n 虎渡のわがままにわりとうんざりしていますが、弱みを握られていて面倒見がよいので付き合ってくれています。\n\n  イメージが湧きやすければと設定を書いていますがあまり意識して頂かなくてもかまいません！ 構図、服装や表情等も全てお任せします、ハルさんが楽しんで描けるよう自由にしてく頂きたいです。 もし承認可能なリクエストであればどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/mobile/folders/1df3i_qHGi5K33EVuzoc169izg0RwFZqb", "created_at": "", "completed_at": ""}, {"path": "/@buncyoi3/works/12", "thumbnail_src": "https://si.imgix.net/22b8d171/uploads/origins/7dfca3b4-3f6f-4185-8dc4-b200f2e20b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=954926b7d9937b01784b26e8b25eaac6", "thumbnail_srcset": "https://si.imgix.net/22b8d171/uploads/origins/7dfca3b4-3f6f-4185-8dc4-b200f2e20b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=954926b7d9937b01784b26e8b25eaac6, https://si.imgix.net/22b8d171/uploads/origins/7dfca3b4-3f6f-4185-8dc4-b200f2e20b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7e8db26df9b55e3a48a42a2205d6788 2x, https://si.imgix.net/22b8d171/uploads/origins/7dfca3b4-3f6f-4185-8dc4-b200f2e20b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fac6203465fcad6ce694be0c8cbefcc 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラスト拝見しております！\n以前描かれていらしたベルベットとリフィル先生のイラストから大ファンです！\n\n是非オリジナルキャラクターを描いていただきたくリクエストさせていただきます\n二人は同い年の大学生で恋人同士です。黒髪は人当たりがいいです。白髪は素っ気ないです。\n構図や衣装はお任せ致します！どんな二人でもうれしいです。\n何卒宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1hQL99YAgorFjcF2BVqje68Hgh-hbQw1P?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@buncyoi3/works/11", "thumbnail_src": "https://si.imgix.net/99481d8b/uploads/origins/8b5fe557-8c5e-4e42-af08-2e85af58c055?bg=%23fff&auto=format%2Ccompres