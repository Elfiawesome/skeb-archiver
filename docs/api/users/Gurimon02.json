ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91da1facba65ac0fe506ee85c78b6dfb", "thumbnail_srcset": "https://si.imgix.net/b3403c15/uploads/origins/26e85f9c-bc2e-401e-8250-a01d99c3b5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91da1facba65ac0fe506ee85c78b6dfb, https://si.imgix.net/b3403c15/uploads/origins/26e85f9c-bc2e-401e-8250-a01d99c3b5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07cac7dc40b2bb90df2d51f59d867767 2x, https://si.imgix.net/b3403c15/uploads/origins/26e85f9c-bc2e-401e-8250-a01d99c3b5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=debad646a9d3c8d583bb4b143269cea1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gurimon02/works/2", "thumbnail_src": "https://si.imgix.net/0d44fd5b/uploads/origins/a4517403-15be-4014-85f5-dce766b49043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d25c5c91157cac346f4459aa09cae13", "thumbnail_srcset": "https://si.imgix.net/0d44fd5b/uploads/origins/a4517403-15be-4014-85f5-dce766b49043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d25c5c91157cac346f4459aa09cae13, https://si.imgix.net/0d44fd5b/uploads/origins/a4517403-15be-4014-85f5-dce766b49043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b049fe233b793f3ab91e5f9567e8ed22 2x, https://si.imgix.net/0d44fd5b/uploads/origins/a4517403-15be-4014-85f5-dce766b49043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95ed032125a9463fda2553f0fab5291d 3x", "genre": "art", "nsfw": true, "body": "個人Vtuber獏乃あどでシコりたいのでえっちなイラストをお願いします。\n\nお兄ちゃんにアナル調教されるあど。\nベッドの上、全裸、ペット用首輪&ボールギャグ着用。\n手足は拘束されてまんぐり返し。アナルがよく見えるポーズ。\n胸は資料通りの貧乳ではなく巨乳。\n全身汗だく。\n周りにはアナル拡張グッズ(色んなアナルパールやアナルバイブ)が散乱している。\n\n●状況\n1枚目\n閉じたアナル。ひくひくしている。\nあどは怯えたような表情。\n\n2枚目\nアナルパールを奥まで突っ込まれる。\nボールギャグで喋れないが大きな喘ぎ声をあげている。\n\n3枚目\nアナルパールを激しく出し入れされる。\n涙を流しながら声にならない喘ぎ声を出している。\n\n4枚目\nアナルパールを引っこ抜かれてぽっかりアナルに。\n放心状態で涙とよだれでぐちゃぐちゃ。\n\n5枚目\nぽっかりアナルにお兄ちゃんのおちんちんが先っぽだけ入ろうとしている。\nあどは首を振って嫌がっている。\n\n6枚目\nぽっかりアナルでお兄ちゃんのおちんちんを奥まで咥えている。\nあどは涙を流しながらの絶頂。\n\n7枚目\nアナル大量中出し。別カットインで断面図。\nあどは連続絶頂で意識が飛びそうになっている。\n\n8枚目\nぽっかりアナルから精液が垂れている。\nあどは意識が飛んで放心状態。\n\n\n本人はキャラクターとしてえっちなイラストを嫌がっているように振る舞っていますが、ファンボックスにて自分のえっちなイラストを公開しておりますので、問題ございません。\n\nよろしくお願いします。\n\nhttps://twitter.com/ado_bakuno/status/1408132006202929155", "created_at": "", "completed_at": ""}]}