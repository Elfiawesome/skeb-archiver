9358-47074b5882d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c2f1ce5afab9809d711fe219ca168b4 2x, https://si.imgix.net/84527f9f/uploads/origins/eecbc2af-2042-4a57-9358-47074b5882d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdb09322f019cd4d30d608dd7e26c6a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/15", "thumbnail_src": "https://si.imgix.net/11a2c97c/uploads/origins/dae147e9-7962-434b-b022-422cb21ebb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=305443d1c3009c5a4890af3240861abd", "thumbnail_srcset": "https://si.imgix.net/11a2c97c/uploads/origins/dae147e9-7962-434b-b022-422cb21ebb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=305443d1c3009c5a4890af3240861abd, https://si.imgix.net/11a2c97c/uploads/origins/dae147e9-7962-434b-b022-422cb21ebb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6aa077c979d5b243cfe60145592932a8 2x, https://si.imgix.net/11a2c97c/uploads/origins/dae147e9-7962-434b-b022-422cb21ebb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abcc5a76850cd3a182c3fa9229345e93 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私はあなたの絵が大好きで、私のキャラクターを描いてもらいたいと思っていました！\n\n特にリクエストはないのですが、\"ポロス \"を使って何か描いてほしいです。\"ポロス \"はLeague of Legendsに出てくる動物で、私のキャラクターと一緒にどう描いてくれるのか見てみたいです！❤️\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/10rhIojiCuV5i1KminDdu3rdEl4RGoiVF", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/14", "thumbnail_src": "https://si.imgix.net/ac5c640c/uploads/origins/4373cec3-87bc-4be5-a778-900430707058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fbfae52efd664dce00ac52f0832c734", "thumbnail_srcset": "https://si.imgix.net/ac5c640c/uploads/origins/4373cec3-87bc-4be5-a778-900430707058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fbfae52efd664dce00ac52f0832c734, https://si.imgix.net/ac5c640c/uploads/origins/4373cec3-87bc-4be5-a778-900430707058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe208c6e0de3ebe65178393b6b3ee494 2x, https://si.imgix.net/ac5c640c/uploads/origins/4373cec3-87bc-4be5-a778-900430707058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e32830ba1e300f509b503e4d3018d065 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートワークは素敵です！あなたのスタイルで私のグレイフォックスのキャラクターを見てみたいです。おそらくリラックスしたビーチや夏をテーマにして、ポーズや表現はあなた次第です！ありがとうございます！\n\nhttps://www.dropbox.com/scl/fo/yu9y9ialeuhv8muvbnjn4/ALvRjSL9PNgBXbzempWnOE8?rlkey=clsm585b2vx4poxaqoa9cku27&st=dcqjzf3t&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/13", "thumbnail_src": "https://si.imgix.net/e65fcf35/uploads/origins/1561be78-ebce-41f5-8809-58e6121f9fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10843878f11912941ee1760d7b3375e9", "thumbnail_srcset": "https://si.imgix.net/e65fcf35/uploads/origins/1561be78-ebce-41f5-8809-58e6121f9fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10843878f11912941ee1760d7b3375e9, https://si.imgix.net/e65fcf35/uploads/origins/1561be78-ebce-41f5-8809-58e6121f9fad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9441d596185e78960b68ba1079562381 2x, https://si.imgix.net/e65fcf35/uploads/origins/1561be78-ebce-41f5-8809-58e6121f9fad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dd3884d49063be61df4cb36fba9f2b7 3x", "genre": "art", "nsfw": false, "body": "I'd appreciate if you drew my sandslash character in a mechanical / industrial themed painting, with a background that looks like a sunset.  Purple and orange are great!  But I also like dull, colorless environments and objects.\n\nThank you very much for your time!  I look forward to the artwork.\n\nhttps://drive.google.com/drive/folders/1NeM4dm9odiWEtq2NVsCO34v7dvwwQJUi", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/12", "thumbnail_src": "https://si.imgix.net/40ddba9d/uploads/origins/1fd1995e-0950-4ec3-82d5-c5ef23c7cc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb7a94ba086412d79e33cbb25666d29", "thumbnail_srcset": "https://si.imgix.net/40ddba9d/uploads/origins/1fd1995e-0950-4ec3-82d5-c5ef23c7cc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb7a94ba086412d79e33cbb25666d29, https://si.imgix.net/40ddba9d/uploads/origins/1fd1995e-0950-4ec3-82d5-c5ef23c7cc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a180e43db912959e825579dc5319908 2x, https://si.imgix.net/40ddba9d/uploads/origins/1fd1995e-0950-4ec3-82d5-c5ef23c7cc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d867443ffdf5d768d6a8a0e4ce6476c 3x", "genre": "art", "nsfw": false, "body": "やあやあ、また僕だよ！この二人のキャラクターで（https://silentblue.remywiki.com/HECATONCHEIR）のジャケットをもう一回作ってくれませんか（https://drive.google.com/drive/folders/1t5bOKsJ0LukkVNf4WdvZc43croqx9G70 > 参照フォルダ）。\n\nLiaは、服装は参考資料と同じにして、HECATONCHEIRのジャケットのローラースケートと短剣を追加してください。 Lavenriteは、服装は参考資料と同じにして、HECATONCHEIRのジャケットと同じようにクロスボウと顔を覆うスカーフを追加してください。", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/11", "thumbnail_src": "https://si.imgix.net/62ba2f44/uploads/origins/362688be-c49d-49a8-8d58-d798e054c3dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f0ec96de5360dff6f5cd056dddfa0e", "thumbnail_srcset": "https://si.imgix.net/62ba2f44/uploads/origins/362688be-c49d-49a8-8d58-d798e054c3dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f0ec96de5360dff6f5cd056dddfa0e, https://si.imgix.net/62ba2f44/uploads/origins/362688be-c49d-49a8-8d58-d798e054c3dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a5be66cbe389351f0a8b0de1785f071 2x, https://si.imgix.net/62ba2f44/uploads/origins/362688be-c49d-49a8-8d58-d798e054c3dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbfb72efe18c7b280f76a42b7d7d6041 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたのアートワークと背景が大好きです。私のキャラクターが夜の街でポーズをとるのをお願いしたいです。私のキャラクターに関しては、リファレンスにあるような黒と緑のパーカーを着てほしいです。ポーズや表情はお任せします！ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1qTBPPGFdP4s6MmwJYaMryn2M5R_pPyLu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/10", "thumbnail_src": "https://si.imgix.net/63cf5045/uploads/origins/4a200b61-d44d-47f1-bd6c-af7e3f6dbd61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e8983823276b55c6412a84c51f956e5", "thumbnail_srcset": "https://si.imgix.net/63cf5045/uploads/origins/4a200b61-d44d-47f1-bd6c-af7e3f6dbd61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e8983823276b55c6412a84c51f956e5, https://si.imgix.net/63cf5045/uploads/origins/4a200b61-d44d-47f1-bd6c-af7e3f6dbd61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68c16366cec16d13cfddbffcafb37b3e 2x, https://si.imgix.net/63cf5045/uploads/origins/4a200b61-d44d-47f1-bd6c-af7e3f6dbd61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e128ef51f7aff878211ea987b75563db 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n私のニャースの別の作品に興味があります。\n\n夏服で、水泳パンツをはいてほしいです。さらに、パーカーの黄色いバンダナも一緒にお願いします。ポーズはお任せします！\n\nありがとうございました！\n\nhttps://www.dropbox.com/scl/fo/v4ag7qm5tk1e73upsndhe/APkUFtgEyLokQ2H9xqBYZ8g?rlkey=c908hoj9x98wotipihgvj5hy0&st=wwnkpm3e&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/9", "thumbnail_src": "https://si.imgix.net/3c9bddb3/uploads/origins/fdec1bb4-f56e-414a-89cf-1e290e942ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662a137db310cf84daedbb7cd7943744", "thumbnail_srcset": "https://si.imgix.net/3c9bddb3/uploads/origins/fdec1bb4-f56e-414a-89cf-1e290e942ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662a137db310cf84daedbb7cd7943744, https://si.imgix.net/3c9bddb3/uploads/origins/fdec1bb4-f56e-414a-89cf-1e290e942ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=048443e064e40e03230d08fb06170123 2x, https://si.imgix.net/3c9bddb3/uploads/origins/fdec1bb4-f56e-414a-89cf-1e290e942ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad6472fdb6fe2c68fc66632baf58bb47 3x", "genre": "art", "nsfw": false, "body": "I would really appreciate it if you could draw my sandslash character in a depressing, sad, but colorful environment.  I always draw my own art when listening to music, and I pick a song to guide my work.  I'd like you to use the song that I attached to help with knowing what to create.  My favorite emotion is helplessness.\n\nThank you very much for your time!  I look forward to the artwork.\n\nhttps://drive.google.com/drive/folders/1NeM4dm9odiWEtq2NVsCO34v7dvwwQJUi", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/8", "thumbnail_src": "https://si.imgix.net/0d2e45fe/uploads/origins/a1a46c3f-7087-4463-8b82-d403eca2d187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beb23eafb8d8509742c74982bc74249c", "thumbnail_srcset": "https://si.imgix.net/0d2e45fe/uploads/origins/a1a46c3f-7087-4463-8b82-d403eca2d187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beb23eafb8d8509742c74982bc74249c, https://si.imgix.net/0d2e45fe/uploads/origins/a1a46c3f-7087-4463-8b82-d403eca2d187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc2f78c24b515cfd6983f25e1f0387b0 2x, https://si.imgix.net/0d2e45fe/uploads/origins/a1a46c3f-7087-4463-8b82-d403eca2d187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3af366b7a8472b87639a797e971ec25 3x", "genre": "art", "nsfw": false, "body": "やあ、また僕だよ\n\nもう一枚、今度は僕の新しい相手、シェイミでお願いできますか？彼女は下の歌のジャケットを着ていて、傘を持っている以外の服装は同じにしてほしいです。\n\n天文台：https://en.namu.wiki/w/Observatory\n\nキャラクター（リア）：https://drive.google.com/drive/folders/1wCAYnEhQJQZFSWFl_QKBZh9JjtErw9ba\n\nhttps://drive.google.com/drive/folders/1wCAYnEhQJQZFSWFl_QKBZh9JjtErw9ba", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/7", "thumbnail_src": "https://si.imgix.net/44b8a358/uploads/origins/b68c7c4d-d2ff-4b02-be7d-4e82ad2adb77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11d72f6d50a085acd15c4e9b55abdeb1", "thumbnail_srcset": "https://si.imgix.net/44b8a358/uploads/origins/b68c7c4d-d2ff-4b02-be7d-4e82ad2adb77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11d72f6d50a085acd15c4e9b55abdeb1, https://si.imgix.net/44b8a358/uploads/origins/b68c7c4d-d2ff-4b02-be7d-4e82ad2adb77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07bb1f0ab8f2bb31ca5f907e830936bf 2x, https://si.imgix.net/44b8a358/uploads/origins/b68c7c4d-d2ff-4b02-be7d-4e82ad2adb77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a6c01999c1085ed3e5f06a28a677218 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のシェイミキャラクターに何かクールなもの、かわいいものを作っていただけませんか？\n\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1h8_MdQ62gHzdetOpGstLFQJHNPlo6ap0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@watashigu_/works/6", "thumbnail_src": "https://si.imgix.net/6dd38052/uploads/origins/46d1ff2a-f9ca-4a0b-93ec-3b93f12160b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc12dceecd9ea413dc1d46faf43a59d", "thumbnail_srcset": "https://si.imgix.net/6dd38052/uploads/origins/46d1ff2a-f9ca-4a0b-93ec-3b93f12160b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc12dceecd9ea413dc1d46faf43a5