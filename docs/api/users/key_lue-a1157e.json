75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7405a3dc693f43995702dc7c42717776 2x, https://si.imgix.net/46f5519f/uploads/origins/5dc208f1-6175-4938-9446-3396b0858f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=215373df4ac5f7ddb96ce676b38611e0 3x", "genre": "art", "nsfw": false, "body": "桐生先生、初めまして。\nインクを使われた絵がとても素敵で美麗で、別垢でひっそりフォローさせていただいております密やかなファンの者です…m(__)m\nすごく格好良くて、スタイリッシュなタッチが魅力的で、もし宜しければうちのこを描いていただけたらと思い、このたびは申請をさせていただきました。\n\n闇稼業出身の双剣使いの青年で、30代なかばくらいです。\nざっくばらんな性格ながら戦いでは鋭い感じなため、目のハイライトは無しで描いていただけましたら嬉しく思いますが、桐生先生の自由に描いていただけましたらと思います。\n宜しければご検討お願い致します。\n\nhttps://x.com/domitaorurosan/status/1864583480744792563?t=FWPG2RoWn2XOPnVuQEbr6w&s=19", "created_at": "", "completed_at": ""}, {"path": "/@key_lue/works/20", "thumbnail_src": "https://si.imgix.net/95de30bb/uploads/origins/4b2d389a-3fdf-413b-ba00-3e5ab20cd9af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a4d948a46a096b7211f3c2da88a6fbf", "thumbnail_srcset": "https://si.imgix.net/95de30bb/uploads/origins/4b2d389a-3fdf-413b-ba00-3e5ab20cd9af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a4d948a46a096b7211f3c2da88a6fbf, https://si.imgix.net/95de30bb/uploads/origins/4b2d389a-3fdf-413b-ba00-3e5ab20cd9af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07ee870f109a4fbbe9d6148ff1d151e8 2x, https://si.imgix.net/95de30bb/uploads/origins/4b2d389a-3fdf-413b-ba00-3e5ab20cd9af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b36a0d95635f986a113cc6a72bfefda6 3x", "genre": "art", "nsfw": false, "body": "以前は素敵なイラストをありがとうございました！\n原画もいただいてしまって感謝感激です…！額に入れて飾って眺めてはニヤニヤしております。\nアルパちゃんの支援も兼ねて、改めてご依頼をさせていただきたく今回参りました。\nダークトヨタ・ライジングさんのPFAOSのキャラクター、リヴェンジさんのイラストをお願いしたいです。(ご本人からスケブ等に依頼していいご許可はいただいております)\n前回ご依頼させていただきましたジートとうちよそ関係を結ばせていただいているキャラクターさんなので、可能であればインクや水彩を使用して、対になるような構図で描いていただけると嬉しいです。可愛くはにかんだ笑顔だともっと嬉しいです…！\nお手隙の際でよろしいので、どうぞよろしくお願いいたします！\n\n元キャラシ→\nhttps://www.pixiv.net/artworks/79056190\n最新イラスト→\nhttps://x.com/siina_pf/status/1741831846386893227/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@key_lue/works/19", "thumbnail_src": "https://si.imgix.net/ad978385/uploads/origins/337d10b3-d879-447d-a38d-dfa6c7ce840c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9df554ffc65d6a5d80d61bb0f3f2f1f", "thumbnail_srcset": "https://si.imgix.net/ad978385/uploads/origins/337d10b3-d879-447d-a38d-dfa6c7ce840c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9df554ffc65d6a5d80d61bb0f3f2f1f, https://si.imgix.net/ad978385/uploads/origins/337d10b3-d879-447d-a38d-dfa6c7ce840c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a80ae9075d62e2dcb872fdfec8503430 2x, https://si.imgix.net/ad978385/uploads/origins/337d10b3-d879-447d-a38d-dfa6c7ce840c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10fafd19204d71073e78a59a1cff2c44 3x", "genre": "art", "nsfw": false, "body": "初めまして。いつもイラストやポストをたのしみにしております。\nイラストのリクエストをお願いしたく、ご連絡します。\n\n◼︎希望内容\nバンジョーちゃんとアルパちゃんのイラスト\n\n急いではありませんので、よろしければお受けくださいますと幸いです。\nアルパちゃんが元気になりますよう祈っております。\n梅雨冷えが始まる時期ですし、桐生様もどうかご自愛ください。\n今後のご活躍も楽しみにしております。", "created_at": "", "completed_at": ""}, {"path": "/@key_lue/works/18", "thumbnail_src": "https://si.imgix.net/050de5f7/uploads/origins/71e4d614-c1fe-4811-a64d-e7e8cbe4e8f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d6136976e4c41e1736be35999d85226", "thumbnail_srcset": "https://si.imgix.net/050de5f7/uploads/origins/71e4d614-c1fe-4811-a64d-e7e8cbe4e8f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d6136976e4c41e1736be35999d85226, https://si.imgix.net/050de5f7/uploads/origins/71e4d614-c1fe-4811-a64d-e7e8cbe4e8f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52b41652ce324478f9a325fafcaff6d2 2x, https://si.imgix.net/050de5f7/uploads/origins/71e4d614-c1fe-4811-a64d-e7e8cbe4e8f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c78f97b1d718b8772616f21b18443883 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@key_lue/works/17", "thumbnail_src": "https://si.imgix.net/ab277cee/uploads/origins/8f97fe1d-5b83-40b8-9dc8-730ea1d59fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b2cd72866eac5266afbb9729b0fd1a", "thumbnail_srcset": "https://si.imgix.net/ab277cee/uploads/origins/8f97fe1d-5b83-40b8-9dc8-730ea1d59fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b2cd72866eac5266afbb9729b0fd1a, https://si.imgix.net/ab277cee/uploads/origins/8f97fe1d-5b83-40b8-9dc8-730ea1d59fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a395f6f48e9cacb13e6f4fca212b68e 2x, https://si.imgix.net/ab277cee/uploads/origins/8f97fe1d-5b83-40b8-9dc8-730ea1d59fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ed37ce4b2f65de335e294080e0f37a4 3x", "genre": "art", "nsfw": false, "body": "こんばんは。アルパちゃんの愛らしさに、日々癒されている者です。\n二次創作しかしていないので、自分に版権のあるキャラはいません。なので、アルパちゃんの絵をお願いいたします。成猫になって、菊の花を愛でている姿が見たいです。長生きして、桐生さんのおうちで幸せに暮らせるように。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@key_lue/works/16", "thumbnail_src": "https://si.imgix.net/51c9c41a/uploads/origins/f4a0f126-c4ff-4d1c-b8ab-66fd7d3c9932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3da871f9b5f3dc6d2787a12031b1e4b7", "thumbnail_srcset": "https://si.imgix.net/51c9c41a/uploads/origins/f4a0f126-c4f