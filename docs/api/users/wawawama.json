middle%2Ccenter&txtsize=30&txt=PRIVATE&s=923e6ae1cf2a7a9cf10f04ffdbaaef8f", "thumbnail_srcset": "https://si.imgix.net/76705a70/uploads/origins/ad758026-9b8d-40c9-9553-134178175401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=923e6ae1cf2a7a9cf10f04ffdbaaef8f, https://si.imgix.net/76705a70/uploads/origins/ad758026-9b8d-40c9-9553-134178175401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec3d372c5cdd97f49426f30bb836b83a 2x, https://si.imgix.net/76705a70/uploads/origins/ad758026-9b8d-40c9-9553-134178175401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c9fbf31f6efd74dec8eb318fb87153c 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/176", "thumbnail_src": "https://si.imgix.net/b8c5af15/uploads/origins/c7876529-14fd-47cf-a704-267cad03ccc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f81b1b9699c7a8a44b552af459201f", "thumbnail_srcset": "https://si.imgix.net/b8c5af15/uploads/origins/c7876529-14fd-47cf-a704-267cad03ccc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f81b1b9699c7a8a44b552af459201f, https://si.imgix.net/b8c5af15/uploads/origins/c7876529-14fd-47cf-a704-267cad03ccc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b67ab9362de7a5f7361d9faf3dbaaed 2x, https://si.imgix.net/b8c5af15/uploads/origins/c7876529-14fd-47cf-a704-267cad03ccc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24bc44ffe2d3dc3216766e8ffa7266c4 3x", "genre": "art", "nsfw": true, "body": "モスクワさん、こんにちは！\n\n以前、悟空のうーざるtf実験について何枚か写真をお願いしたことがあります。最近、この完成した作品を見て、どうしてももっとうーざるをテーマにした絵をお願いしたいと急に思いました。https://skeb.jp/@wawawama/works/154\n\nこの作品に直接続く作品をお願いしたいです。\n\n構図も2つの瞬間で構成してほしい。まず、悟飯がオーガズムに達しようとしているので、絵はほとんどそのままで(その他、多少の変更は自由)、悟飯が次のような表情をするようにしてほしい。https://drive.google.com/file/d/1z-FFk7quFgIar90nWgfV24kkeqMk7fD0/view?usp=sharing\n\n悟飯が咆哮し、オーガズムに達すると、悟飯の全身が反応し、悟飯を成長させる。彼は一瞬でこのように成長する。https://drive.google.com/file/d/1RJQNlcJpv8bsVIBkVFMAHSC7ANW2BV4Y/view?usp=sharing この顔をしながら：https://drive.google.com/file/d/19XqaQiS59kWfTMBhm8qKMOHb0WV6tFx-/view?usp=sharing\n\n前作の悟飯のポーズが好きなので、このままでいいと思います。ただ、悟飯が大きく重くなったので、それも反映させたいので、構図の関係で変える必要があればOKです。送った画像にはありませんが、爪が長くなって、足も猿のものに変わっていたらいいですね。尻尾がとても好きなので、尻尾も太くなったことを表現してほしいです。悟飯はもちろん、ミルクの中も急に大きくなったので、表情にも反映させてほしいです。その他、より良い作品になりそうであれば、自由に変更していただいて構いません。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/175", "thumbnail_src": "https://si.imgix.net/aac1cfef/uploads/origins/3ac7709f-5ad4-415a-8b4c-1d49366682a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5fe485412cb3a233fd9566a3cb6d6cb", "thumbnail_srcset": "https://si.imgix.net/aac1cfef/uploads/origins/3ac7709f-5ad4-415a-8b4c-1d49366682a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5fe485412cb3a233fd9566a3cb6d6cb, https://si.imgix.net/aac1cfef/uploads/origins/3ac7709f-5ad4-415a-8b4c-1d49366682a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ad674b5675f00652517579cf89996bf 2x, https://si.imgix.net/aac1cfef/uploads/origins/3ac7709f-5ad4-415a-8b4c-1d49366682a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a103bce0478aa3050d3909f3ef0477bd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/174", "thumbnail_src": "https://si.imgix.net/c306c092/uploads/origins/b6e65247-6d1a-4862-8351-abbc11d343bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73aa3273b3dcabc91de6e0128e88e380", "thumbnail_srcset": "https://si.imgix.net/c306c092/uploads/origins/b6e65247-6d1a-4862-8351-abbc11d343bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73aa3273b3dcabc91de6e0128e88e380, https://si.imgix.net/c306c092/uploads/origins/b6e65247-6d1a-4862-8351-abbc11d343bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef67e3858cf150e915f30b010f50eb43 2x, https://si.imgix.net/c306c092/uploads/origins/b6e65247-6d1a-4862-8351-abbc11d343bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d03f1db60f0232a94be17f94c6e73d1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/173", "thumbnail_src": "https://si.imgix.net/a587cedc/uploads/origins/274d5134-63e7-4361-93c3-1366471922cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ec65068c4c28b94d9c229f3b114f5aa", "thumbnail_srcset": "https://si.imgix.net/a587cedc/uploads/origins/274d5134-63e7-4361-93c3-1366471922cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ec65068c4c28b94d9c229f3b114f5aa, https://si.imgix.net/a587cedc/uploads/origins/274d5134-63e7-4361-93c3-1366471922cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb590315d80b46b41a5e51e936dc02d3 2x, https://si.imgix.net/a587cedc/uploads/origins/274d5134-63e7-4361-93c3-1366471922cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=234f0a82f47db1d50000cb5a14192204 3x", "genre": "art", "nsfw": true, "body": "怪獣娘クエスト』の \"大天使マリエル \"をヌードで、主人公の上に乗って \"アマゾンポジション \"で描いていただきたい。できれば、ペニスを挿入する前に主人公をいじめるバージョンもお願いします。\n\n参考 -できればこの視点でお願いしたい- https://drive.google.com/file/d/1C1lha4ILi2XdxSUg0l-L1jNqYIFH80Ru/view?usp=drive_link\nありがとうございました！\n\nhttps://drive.google.com/file/d/1C1lha4ILi2XdxSUg0l-L1jNqYIFH80Ru/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/172", "thumbnail_src": "https://si.imgix.net/52bbe732/uploads/origins/7f97f1fe-57d1-4d00-9ba7-2a3b3f4b8178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37334b0ebe8cee8c8cc6d024504bd1a2", "thumbnail_srcset": "https://si.imgix.net/52bbe732/uploads/origins/7f97f1fe-57d1-4d00-9ba7-2a3b3f4b8178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37334b0ebe8cee8c8cc6d024504bd1a2, https://si.imgix.net/52bbe732/uploads/origins/7f97f1fe-57d1-4d00-9ba7-2a3b3f4b8178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=345c02299b719135aa0f25fe32e7e0f9 2x, https://si.imgix.net/52bbe732/uploads/origins/7f97f1fe-57d1-4d00-9ba7-2a3b3f4b8178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc077691bee668ec019de7cc2488bbee 3x", "genre": "comic", "nsfw": true, "body": "過去作に挿絵で描かれていたキャラクターやシチュエーションが好きだったので、それについてリクエストさせてください。\n\n「女子寮に侵入した男子が徹底的にお仕置きされる話」の登場人物より、くすぐり合う京谷と八戸をお願いします。\n\n•ひょんなことから、お風呂上がりで両者裸の状態で、八戸から京谷に対してくすぐり合いしませんかと持ちかけて、私全然聞かないからいいわよと自信満々になっている所を、両手をバンザイで拘束して仰向けに寝転がせて、その両腕の上にまたがって、八戸の大きなおっぱいが京谷の顔の真上に来るくらいの位置で、脇の下をくすぐる。\n\n•京谷はくすぐられて爆笑してしまう。「先輩脇の下弱いっすねー」や「こちょこちょー」などの言葉責めをされながら脇の下や脇腹をこちょこちょされて大爆笑させる。\n\n•今度は京谷の番になり、八戸を同じ様なバンザイの様に両手を拘束して、仰向けに寝かせた所を、京谷のお尻で両腕に乗り、腕を固定した所を、脇の下をこちょこちょとくすぐる。\n\n•八戸は爆笑してしまい、さらに同じ様に脇腹もくすぐり、京橋はお返しと言わんばかりにくすぐり、八戸はさらに大笑いしてしまう。\n\n以上でお願いします。\nセリフ等は、京谷は淡々と攻めて八戸は元気に笑う。八戸は元気に攻めて京谷は意外と声大きく笑ってしまう。でお願いします。\n構図については、それぞれ男の人にお仕置きしていた構図でそのまま自分たちがくすぐられる様な感じでイメージしました。\n逆転物とくすぐりが好きで、元の同人誌も好きだったので依頼させていただきました。\n\n是非よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/171", "thumbnail_src": "https://si.imgix.net/dd3d75f4/uploads/origins/47fc8fea-d10d-49fe-b88c-e38443ba9ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ff03b887c55f436114d5cf06818ae24", "thumbnail_srcset": "https://si.imgix.net/dd3d75f4/uploads/origins/47fc8fea-d10d-49fe-b88c-e38443ba9ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ff03b887c55f436114d5cf06818ae24, https://si.imgix.net/dd3d75f4/uploads/origins/47fc8fea-d10d-49fe-b88c-e38443ba9ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55edb969cd1d3cd47733bdbc73ab31f2 2x, https://si.imgix.net/dd3d75f4/uploads/origins/47fc8fea-d10d-49fe-b88c-e38443ba9ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=045da28d0918571b48533b05b81fda47 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/170", "thumbnail_src": "https://si.imgix.net/8b9cec83/uploads/origins/4db9d5ba-a690-4b61-93a7-6bd29170f18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9065488b5403cc7ebb93de7bcb53ef", "thumbnail_srcset": "https://si.imgix.net/8b9cec83/uploads/origins/4db9d5ba-a690-4b61-93a7-6bd29170f18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9065488b5403cc7ebb93de7bcb53ef, https://si.imgix.net/8b9cec83/uploads/origins/4db9d5ba-a690-4b61-93a7-6bd29170f18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ee3af5ce4bf2b8a51e4d535c1691a99 2x, https://si.imgix.net/8b9cec83/uploads/origins/4db9d5ba-a690-4b61-93a7-6bd29170f18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd9ca94e329865889395fc11e30942d1 3x", "genre": "art", "nsfw": true, "body": "前回のロックマンXが素晴らしかったので\nまたリクエストさせていただきます。\n受理可能かご検討ください。\n\nR-18 ロックマンX3 マックスアーマー\n\n・触手に拘束され、モブキャラ(女性)に亀頭を攻められ潮吹き敗北する場面\n\n  •胸のアーマーは乳首部分のみ破壊されボディスーツ越しに乳首の形がくっきりで触手に弄られている\n\n•パンツアーマーは股間部分のみ破損し、フル勃起したちんこと玉が露出され触手が絡みついている(うっすらちん毛が生えていて臭そうな感じ)\n\n•擬音、台詞あり\n女性「エックスのおちんちん　ムレててすごくオス臭いね♡\nたくさん虐めてあげる♡\n亀頭くにくに♡ ごしごし♡\nエックスってヒーローのくせに情けないねー♡\nすごい勢いで潮吹きしてるー♡\nまだまだやめないよー♡」\n\n\nX「あがぁッ　よせッ　それやばいッ　もうやめッ　おおッ　んおオ゛おおオ゛ッーーーーーーー……」\n\n•涙は不用、よだれあり\n\n•希望イメージです\nhttps://skeb.jp/@wawawama/works/137\n\n•出来れば差分で白目を剥きかけショートしてしまい\n女性「あらら♡\n気持ちよすぎて電子頭脳がショートしちゃった♡」\n\nX「あああaaあ----------,.:;,.:;--------,.;---」\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/169", "thumbnail_src": "https://si.imgix.net/1737c5c1/uploads/origins/cf315ce7-4da3-4e1f-80aa-7f42fe67f0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a25984d6c69e4fc281a3e924ae290ab", "thumbnail_srcset": "https://si.imgix.net/1737c5c1/uploads/origins/cf315ce7-4da3-4e1f-80aa-7f42fe67f0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a25984d6c69e4fc281a3e924ae290ab, https://si.imgix.net/1737c5c1/uploads/origins/cf315ce7-4da3-4e1f-80aa-7f42fe67f0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a26888b22936f55f84ede14d539d954c 2x, https://si.imgix.net/1737c5c1/uploads/origins/cf315ce7-4da3-4e1f-80aa-7f42fe67f0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb30223816af352aa33d7cb3a6196038 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております！\n\nお忙しい所恐縮では御座いますが、下記の内容のリクエストをさせて頂きます。\n\n資料のうちの子テレサちゃんと、モスクワ様の焔くんで、うちよそつがいじめ、状態変化系のエッチなシチュエーションをご依頼したいです。\nいくつかシチュエーションのイメージを書き出してみますので、いずれかを好みのもの、書きやすいもので選んでいただければ幸いです。\n\n①\nテレサちゃんと焔くんが悪どい者達を討伐に訪れるものの、卑怯な罠にハマって返り討ち。テレサちゃんが孕んでお腹がパンパンに大きくなるまで2人で交尾させられた挙句、最後は合体した状態で石化させられます。\nテレサちゃんは母乳を、焔くんは精液を時々噴き出す生きた淫らなつがいの像となって、永遠にその姿を晒され楽しまれるのでした。\n\n②\n怪しい組織の撃破に挑んだ焔くんとテレサちゃん。罠によって捉えられ、統一されたスーツに組織のマーク入り全頭マスクを被せられた、無個性下級戦闘員にされてしまいました。\n生体ユニット、特攻、通常悪事、性処理、様々な2人の扱いを考える幹部の前で、楽しませるための交尾に興じるのでした。\n\n③\n悪の魔術師に挑んだ焔くんとテレサちゃん。一瞬の隙を突かれ敗北し、2人の人格はゼリーとしてアナルからぶちまけられてしまいました。\n身体を魔術師の奴隷にされ（ゾンビのような状態だったり、人形になっていたり、もう戻れなさそうな状態のイメージです）、魔術師の命令で交尾させられており、ゼリーとなった2人はまとめて瓶詰めにされた状態で、身体から伝わる快感を魂で受け止めてビクビクと震えるしかできないのでした。\n\n\n以上のいずれかを元にしたシチュエーションが希望です。\nイメージは1枚にビフォーアフターでしたが、そういった詳細もお任せ致します。\nテレサちゃんの衣装について、資料1枚目か、焔くんとお揃いのぴっちり忍者スーツのどちらかでお願いしたいです。\n\nお忙しい所恐縮ではございますが、何卒ご検討頂けますと幸いで御座います。\n\nhttps://www.pixiv.net/artworks/130432580", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/168", "thumbnail_src": "https://si.imgix.net/6191017e/uploads/origins/575123d9-9bb1-4546-8d2c-ca617b999af1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63ab223687ac585699935eca8ca9f9fd", "thumbnail_srcset": "https://si.imgix.net/6191017e/uploads/origins/575123d9-9bb1-4546-8d2c-ca617b999af1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63ab223687ac585699935eca8ca9f9fd, https://si.imgix.net/6191017e/uploads/origins/575123d9-9bb1-4546-8d2c-ca617b999af1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=653b217ebd3671b464e37c1ecd99377e 2x, https://si.imgix.net/6191017e/uploads/origins/575123d9-9bb1-4546-8d2c-ca617b999af1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d4f0cebd2d2bac1f1baefc874b7d381 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/167", "thumbnail_src": "https://si.imgix.net/bcc8d5f8/uploads/origins/d6d1d61e-393c-47a3-8dc5-d31deec57a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=079874a219f1ca0e2abbeae03425d11e", "thumbnail_srcset": "https://si.imgix.net/bcc8d5f8/uploads/origins/d6d1d61e-393c-47a3-8dc5-d31deec57a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=079874a219f1ca0e2abbeae03425d11e, https://si.imgix.net/bcc8d5f8/uploads/origins/d6d1d61e-393c-47a3-8dc5-d31deec57a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e48a07f46d81233adce2621e27e40e6 2x, https://si.imgix.net/bcc8d5f8/uploads/origins/d6d1d61e-393c-47a3-8dc5-d31deec57a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=821f163bb1dcce500a63427ab0dd62af 3x", "genre": "art", "nsfw": true, "body": "リクエストお願いしてもよろしいでしょうか？\n\nフェチ全開の依頼になります。もしよろしければ以下のテーマでお願いしたいです。\nお尻叩きと羞恥罰を合わせた私の性癖全開の依頼になります！\n\nポケモンレジェンズアルセウスから主人公のテル君が村の広場で任務失敗の罰としてショウ先輩からお尻を叩かれるというシチュエーションでお願いしたいです！\n\n広場の真ん中で下半身裸で脚を大きく開いて足首を持ってこちら側にお尻を突き出しています。股の間から顔が見えている状態です。\n性器と肛門もすべて丸見えになっています。\n性器は剥けてはいますが色はほかの肌と同じ程度の白めでお願いします。\n\nお尻ですがしっかりとお仕置きされてリンゴのように真っ赤に腫れ上がらせていただきたいです。\n表情は恥ずかしさとお尻の痛さから涙以外にも涎や鼻水までだらだらの恥ずかしいお顔でお願いしたいです。\n\n恥ずかしがったりお尻叩きの痛みに泣きながら必死に許しを請うテル君と\nしっかり叱りつけながらも自分も同じ罰を受けたときの恥ずかしい記憶を内心思い出しテル君に同情するショウ先輩のセリフをお願いしたいです。\n\nテル君がメインでショウ先輩は最低限の描写で構いません。\n\nどうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@wawawama/works/166", "thumbnail_src": "https://si.imgix.net/466656fc/uploads/origins/14c59cea-5ada-4c9c-9718-0b8f584eebba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc