60be6fb-0429-4cfc-b2aa-b72a8a640fff?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=661158f2008e2a9c1c9d2b8f67e3d2fb 3x", "genre": "video", "nsfw": false, "body": "またまたこんにちは！もし時間があれば、僕の2番目のキャラクターのビデオも欲しいな！\n\nhttps://drive.google.com/drive/folders/1tfqBg67fqPsycAjyTcA1rx9mGCFWZzvd\n\nモンスターエナジーの缶を持って、よだれを垂らしているところを描いていただけませんか？または、それを飲むかもしれません、それはあなた次第です！\n\nhttps://drive.google.com/drive/folders/1nN8Kmemhd7uRc53wrimh5iORg8OfWXj3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/20", "thumbnail_src": "https://si.imgix.net/f12bd719/uploads/outputs/2cc742e4-2057-4aab-a70d-2b967e0370c1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=997721eb57ae4bf6b99e21945555dd0e", "thumbnail_srcset": "https://si.imgix.net/f12bd719/uploads/outputs/2cc742e4-2057-4aab-a70d-2b967e0370c1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=997721eb57ae4bf6b99e21945555dd0e, https://si.imgix.net/f12bd719/uploads/outputs/2cc742e4-2057-4aab-a70d-2b967e0370c1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6602c08ed9069e227bb9ea92f7c01762 2x, https://si.imgix.net/f12bd719/uploads/outputs/2cc742e4-2057-4aab-a70d-2b967e0370c1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e2842fe94db95855c89eef7143f27cc 3x", "genre": "video", "nsfw": false, "body": "こんにちは！前回作っていただいたビデオ、とても気に入っています！私のパートナーにも作ってもらえませんか？\n\nhttps://drive.google.com/drive/folders/1czxAJ11iKYRFkcKoIF3X4nge6YWbtMjK?usp=sharing\n\nもし彼が唇を舐めているところも描いてくれたら、でもこんな風にモンスターハンター風のお肉も描いてくれたら最高なんだけどな: https://drive.google.com/drive/folders/1E3TzcZYV4p4jgjO9Ql_Bwa0UYALKBKhE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/19", "thumbnail_src": "https://si.imgix.net/fd3146c3/uploads/outputs/b12e3a28-d970-4cd4-9f2d-dadf2d39d55d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e6cceb7f1c512ae4a1a098a983391274", "thumbnail_srcset": "https://si.imgix.net/fd3146c3/uploads/outputs/b12e3a28-d970-4cd4-9f2d-dadf2d39d55d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e6cceb7f1c512ae4a1a098a983391274, https://si.imgix.net/fd3146c3/uploads/outputs/b12e3a28-d970-4cd4-9f2d-dadf2d39d55d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=944cb5f79c6fc0405aadcc313f7b1328 2x, https://si.imgix.net/fd3146c3/uploads/outputs/b12e3a28-d970-4cd4-9f2d-dadf2d39d55d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=18b6e5de68f4665287e81ffb0e61ba99 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたのアートはとても素敵です。）\n\n僕のキャラクターを描いてほしいんだ。彼女はドーベルマンと縞ハイエナのハーフなんだ。https://drive.google.com/drive/folders/1rwmU0Os8G85RUKSWLxQ4HVTEeZepQZ4v?usp=drive_link (髪の毛はオプションじゃないけど、顔のマークが見えるように髪の毛なしのバージョンも追加したよ)\n\n\n彼女は何か肉を持っていて、たぶん生のステーキを食べようとしていて、よだれを垂らしていたり、唇を舐めていたりします。", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/18", "thumbnail_src": "https://si.imgix.net/f49ce64d/uploads/origins/3dd2e88f-1fff-4165-8b6c-f58c97420b93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90d8e28576d069a856ac9dab302324d", "thumbnail_srcset": "https://si.imgix.net/f49ce64d/uploads/origins/3dd2e88f-1fff-4165-8b6c-f58c97420b93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90d8e28576d069a856ac9dab302324d, https://si.imgix.net/f49ce64d/uploads/origins/3dd2e88f-1fff-4165-8b6c-f58c97420b93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=037594be8b20b7d191e7f518724a7fcb 2x, https://si.imgix.net/f49ce64d/uploads/origins/3dd2e88f-1fff-4165-8b6c-f58c97420b93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fe35d43bd9b5ed2fd7f923a2f8bf72e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアピールを見ました！もし興味があるなら、僕の新しいキャラクター、ボバを描いてもらえないかな？ポーズとしては、グレープソーダを画面に向けて、青い舌を出しながら、冷ややかな表情で描いてほしいです。シャツ姿も描いてほしいです。このリクエストに応えてくれるなら、ありがとう！\n\nhttps://drive.google.com/drive/folders/1INgoghsZSDS2RTdw7hvEt_ID-TMjcSxE", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/17", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=929aaffe53fdaddb2264e89162f99b9c", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=929aaffe53fdaddb2264e89162f99b9c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96021a6307464ece9f9b240ca23450da 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2965d328bc8255af2e3dcd522b98990 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/16", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac9318b2a62f71eba8b5469227417cc3", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac9318b2a62f71eba8b5469227417cc3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49cdc4cd19b8506f0038a108f9d42f95 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=519bb38ae31e6eacfe23331315191f01 3x", "genre": "voice", "nsfw": false, "body": "いわゆる前口上的なもののリクエストです\n\n\nさぁて皆さんお立合い\n此処(ここ)は終わらぬ迷い路(みち)\n巡れど巡れど出口なし\n影は嗤(わら)いて舞い踊る\n\n進めば試練が待ち受ける\n戻れば奈落が口開く\n選べる道はただ一つ\n遊戯の果てを見届けよ\n\n死もまた戯(たわむ)れ、繰り返す\n破るは核か、汝の意志か\nさぁて皆さん御武運を\n廻(まわ)る廻るは死の回廊\n\n\nそしてhttps://skeb.jp/@asumi_art/works/1に繋がります\n飄々とした、とか悪者みたいな感じのイメージです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/15", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac9318b2a62f71eba8b5469227417cc3", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac9318b2a62f71eba8b5469227417cc3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49cdc4cd19b8506f0038a108f9d42f95 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774821874314403840%2FSlnjoHNI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=519bb38ae31e6eacfe23331315191f01 3x", "genre": "voice", "nsfw": false, "body": "お世話になっております。久里です。\nジャンル ボイスの制作をお願いします。以下イメージです。\n\nイメージ：ボイスロイドのExボイス\n例：琴葉 茜・葵「exVOICE」\nこちら音声一覧の掛け声、挨拶を参考に合わせて10個程度お願いします。\n文章の通りでなくても問題ありません。\n音声イメージ：そぼろ忍\n納品方法：ファイル分けをお願いします。\n音声ファイル形式：指定なし\n\nUTAUあるならExボイスも欲しい！と思いリクエストさせていただきました。\n対応難しければrejectして下さい。\n\n以上、宜しくお願い致します。\n\nhttps://www.ah-soft.com/voiceroid/kotonoha/#exvoice", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/14", "thumbnail_src": "https://si.imgix.net/d5c467a0/uploads/origins/ae97f5f9-4f3d-44e4-a242-2ffe1544e5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=556419e491ed3995d51dceb2003d06db", "thumbnail_srcset": "https://si.imgix.net/d5c467a0/uploads/origins/ae97f5f9-4f3d-44e4-a242-2ffe1544e5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=556419e491ed3995d51dceb2003d06db, https://si.imgix.net/d5c467a0/uploads/origins/ae97f5f9-4f3d-44e4-a242-2ffe1544e5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfb517ba6a9dc99a034567e65f4048f8 2x, https://si.imgix.net/d5c467a0/uploads/origins/ae97f5f9-4f3d-44e4-a242-2ffe1544e5ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b942535eb1680f52f055937cd3e9c848 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターをダイナミックなポーズで描いてほしい！\n\nhttps://drive.google.com/drive/folders/1IUfiTFwgFMkolQOMrMG4DRQjZIbOUhJx?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/13", "thumbnail_src": "https://si.imgix.net/2239ef09/uploads/origins/625da787-269d-4eee-975c-64edec47dab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af27943730205a20b55d6ae1c9b69c3a", "thumbnail_srcset": "https://si.imgix.net/2239ef09/uploads/origins/625da787-269d-4eee-975c-64edec47dab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af27943730205a20b55d6ae1c9b69c3a, https://si.imgix.net/2239ef09/uploads/origins/625da787-269d-4eee-975c-64edec47dab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3282a26fa2985a99684663bb6fafb54b 2x, https://si.imgix.net/2239ef09/uploads/origins/625da787-269d-4eee-975c-64edec47dab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05659d09cfd287c3c9614eab9fc9674d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/12", "thumbnail_src": "https://si.imgix.net/358fbb66/uploads/origins/d15f49a0-eff9-44ba-bed8-f58875ca9632?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c48db4d1d179a0aca4a160ca7bb5afc", "thumbnail_srcset": "https://si.imgix.net/358fbb66/uploads/origins/d15f49a0-eff9-44ba-bed8-f58875ca9632?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c48db4d1d179a0aca4a160ca7bb5afc, https://si.imgix.net/358fbb66/uploads/origins/d15f49a0-eff9-44ba-bed8-f58875ca9632?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=649fe1dd77df07c90d937dbc73a0aa65 2x, https://si.imgix.net/358fbb66/uploads/origins/d15f49a0-eff9-44ba-bed8-f58875ca9632?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06ce70afe2e01009782642f871315edd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/11", "thumbnail_src": "https://si.imgix.net/f0c63019/uploads/origins/8a3c939a-912e-4ecf-8364-f7dd9d2d2295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=462a5eb3c42e4d23c6f66bd87b6a2376", "thumbnail_srcset": "https://si.imgix.net/f0c63019/uploads/origins/8a3c939a-912e-4ecf-8364-f7dd9d2d2295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=462a5eb3c42e4d23c6f66bd87b6a2376, https://si.imgix.net/f0c63019/uploads/origins/8a3c939a-912e-4ecf-8364-f7dd9d2d2295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca355542e5e6a283a397b3bbb7441fcd 2x, https://si.imgix.net/f0c63019/uploads/origins/8a3c939a-912e-4ecf-8364-f7dd9d2d2295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7e5659bcb9a15cdaa3d92f1eb1971b7 3x", "genre": "art", "nsfw": false, "body": "また会ったね、ソボローニン！\n\n忍者じゃないけど、もう一人のOC、レイナを描いてほしいんだ！\n\n彼女の参考資料です：\nhttps://drive.google.com/drive/u/0/folders/1U13CUNcJCU63DwkZw887IZWN5mqyeVqY\n\n玲奈は騎士を目指していて、そのために修行をしている。彼女はちょっと中二病で、剣で強くなることよりも、かっこよく見せることに重点を置いているので、あなたのスタイルでこんなポーズをとったら素敵に見えると思いました！\n\nhttps://drive.google.com/file/d/1f8gMaRXNkytDC9uNojIwOT4JLSBohewO/view\n\n目をキラキラさせる必要はありませんが、剣はいつもリバースグリップで持っています！\n\n背景なしのバージョンもお願いします！\n\nちょっと難しいポーズですが、ご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/10", "thumbnail_src": "https://si.imgix.net/608382bf/uploads/outputs/90876690-1b69-41eb-a84b-cb8d7c6585e7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c6ca8c3ed03cc7270d35e54f72159d9f", "thumbnail_srcset": "https://si.imgix.net/608382bf/uploads/outputs/90876690-1b69-41eb-a84b-cb8d7c6585e7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c6ca8c3ed03cc7270d35e54f72159d9f, https://si.imgix.net/608382bf/uploads/outputs/90876690-1b69-41eb-a84b-cb8d7c6585e7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2936e4296de091c4355dad35457bcf66 2x, https://si.imgix.net/608382bf/uploads/outputs/90876690-1b69-41eb-a84b-cb8d7c6585e7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4dd948c1b98eb1661cb92eb57066964 3x", "genre": "video", "nsfw": false, "body": "こんにちは、ソボローニン。\n\n私のモンスターハンターワイルドのストリーム用に、あなたからアニメーションを貰いたいと思っていました。\n\n私のOCであるニャンが、リファレンスにあるような鎧を着ているアニメーションが欲しいのです。彼はゲームに登場するBBQの串を使って、串を回転させながら肉を焼いています。\n\n可能であれば、フードと帽子がないバージョンで、頭がもっと見えるようにしてほしいです。また、可能であれば、フードを耳のためのポイントがあるように修正し、アーマーを私のオリジナルデザインの赤に近い色にしていただけないでしょうか。\n\n可能であれば、フードに耳のポイントがあるように修正し、アーマーに私のオリジナルデザインの赤に近い色をつけていただけませんか？\n\nまた、将来的にストリームのアラートとして使えるように、背景なしのバージョンもお願いできますか？(グリーンスクリーンの背景のように、違う色の方がより効果的です）。\n\nこのリクエストがあなたの興味を引くことを願っています。\n\nhttps://drive.google.com/drive/folders/1odhAeQcHO8MSYlwnJdcE9XDtmHZapVoa", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/9", "thumbnail_src": "https://si.imgix.net/b071235e/uploads/origins/c98a6136-5079-45c5-997b-d88694fff2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ade775f18622153e34bd227bbb49b28", "thumbnail_srcset": "https://si.imgix.net/b071235e/uploads/origins/c98a6136-5079-45c5-997b-d88694fff2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ade775f18622153e34bd227bbb49b28, https://si.imgix.net/b071235e/uploads/origins/c98a6136-5079-45c5-997b-d88694fff2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=081912ec89bf8bb468f28fc1dbc9dff2 2x, https://si.imgix.net/b071235e/uploads/origins/c98a6136-5079-45c5-997b-d88694fff2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709a17f3a1b0d6c6c7dec2dc60a27038 3x", "genre": "art", "nsfw": false, "body": "初めまして個人Vtuberをしているドミノと申します。\nアピールありがとうございます。\n\n配信サムネ用のイラストを発注できればと思いリクエストいたしました。\n背景透過でサムネに汎用的に使えるものでポーズ等はお任せいたします。\n\nTwitter固定ツイートやヘッダー等に参考にしていただければと思います。\nhttps://twitter.com/domino_sandayo\nよろしくお願いいたします。\n\nhttps://twitter.com/domino_sandayo", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/8", "thumbnail_src": "https://si.imgix.net/611b891a/uploads/origins/fd6c388f-f978-43a6-8206-6f73ec6df9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66fc0560f8be16630031ead860fd8f20", "thumbnail_srcset": "https://si.imgix.net/611b891a/uploads/origins/fd6c388f-f978-43a6-8206-6f73ec6df9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66fc0560f8be16630031ead860fd8f20, https://si.imgix.net/611b891a/uploads/origins/fd6c388f-f978-43a6-8206-6f73ec6df9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ee1e2136eb22b4acca2ca4461b8a91b 2x, https://si.imgix.net/611b891a/uploads/origins/fd6c388f-f978-43a6-8206-6f73ec6df9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a963f69ff428af057367582564dfd9a 3x", "genre": "art", "nsfw": false, "body": "僕のキャラクターのアートが欲しいんだ！\n英雄的なポーズをとってほしいんだ！\n素晴らしい作品をありがとう\n\nhttps://drive.google.com/drive/folders/1QLpnEOe_JnjaUx0KkvTP8wot4ojSlwb2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/7", "thumbnail_src": "https://si.imgix.net/369edc3f/uploads/outputs/ee1f619f-d3ef-48fb-b0b4-4d6d0a6953b2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e93b29a78d9c30c03d38405cd1d531bf", "thumbnail_srcset": "https://si.imgix.net/369edc3f/uploads/outputs/ee1f619f-d3ef-48fb-b0b4-4d6d0a6953b2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e93b29a78d9c30c03d38405cd1d531bf, https://si.imgix.net/369edc3f/uploads/outputs/ee1f619f-d3ef-48fb-b0b4-4d6d0a6953b2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ddcb888baa5e1fad261f77a492879e2 2x, https://si.imgix.net/369edc3f/uploads/outputs/ee1f619f-d3ef-48fb-b0b4-4d6d0a6953b2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b65ae9909397bae2bc6421cab2ef42c8 3x", "genre": "video", "nsfw": false, "body": "ツイッターであなたが持っていたキャラクターの小さなGIFアニメを見ました！もしアピールする必要があれば、してください！\n\nhttps://drive.google.com/drive/folders/12wOK3jBzCY5ILfCV4JQ2R_b-Efio2xuz?usp=sharing\n\n私が持っているスケッチのポーズのように、目隠しを上げて片目を見せ、観客に向かって舌を出してからかうようなことをしてほしい！彼らは青い目をしています。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/6", "thumbnail_src": "https://si.imgix.net/a0341fba/uploads/origins/c14151c9-132e-4394-a352-516e14f749d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6bc43fb9135785f6ab96ba26e18a0d0", "thumbnail_srcset": "https://si.imgix.net/a0341fba/uploads/origins/c14151c9-132e-4394-a352-516e14f749d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6bc43fb9135785f6ab96ba26e18a0d0, https://si.imgix.net/a0341fba/uploads/origins/c14151c9-132e-4394-a352-516e14f749d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ff40b537d7e20125773582b803a1c57 2x, https://si.imgix.net/a0341fba/uploads/origins/c14151c9-132e-4394-a352-516e14f749d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9da040fe5079385105966b7d92705bbe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして。あなたのアートスタイルを見たとき、とても興奮しました！とてもクールです。OCもかっこいいし！アピールしてくれて嬉しいです。\n\n全部任せるよ！リファレンスを見ながら、自由に描いてください。\n\n彼は少年で、施設内で残酷な実験を受けている。そのため感情が乏しく、自分の気持ちがよくわからない。でも、彼はたくましく、生きているということがどういうことなのかを経験するために生き延びたいと思っている！\n\nhttps://drive.google.com/drive/folders/1_QKR6Qqvc8jHcPrey5Ifi81cG4zAksw_", "created_at": "", "completed_at": ""}, {"path": "/@soboronin/works/5", "thumbnail_src": "https://si.imgix.net/8c9e37e2/uploads/origins/f9df4654-4a57-4a2c-86a7-47345a9522a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=446fe9326141d737052bfca574556d4f", "thumbnail_srcset": "https://si.imgix.net/8c9e37e2/uploads/origins/f9df4654-4a57-4a2c-86a7-47345a9522a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=446fe9326141d737052bfca574556d4f, https://si.imgix.net/8c9e37e2/uploads/origins/f9df4654-4a57-4a2c-86a7-47345a9522a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaa702c6220f6b7928a60fe42f10856c 2x, https://si.imgix.net/8c9e37e2/uploads/origins/f9df4654-4a57-4a2c-86a7-47345a9522a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro