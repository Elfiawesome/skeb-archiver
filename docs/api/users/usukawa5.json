2Ccenter&txtsize=30&txt=PRIVATE&s=72bd6b2bfc9e376ef8d5ba0542b8c9cf 2x, https://si.imgix.net/fc3a7f94/uploads/origins/f7477301-aea5-4ae7-bb26-736bd9855d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d7f3a3bcc65d391c82930cd05854286 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@usukawa5/works/59", "thumbnail_src": "https://si.imgix.net/e3c4172f/uploads/origins/d534533d-9282-4b94-8eb3-67892d5929d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7c63cd3797c848dd80398675fa16d8", "thumbnail_srcset": "https://si.imgix.net/e3c4172f/uploads/origins/d534533d-9282-4b94-8eb3-67892d5929d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7c63cd3797c848dd80398675fa16d8, https://si.imgix.net/e3c4172f/uploads/origins/d534533d-9282-4b94-8eb3-67892d5929d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e933a8c402c1629dcbdfbfd78789969e 2x, https://si.imgix.net/e3c4172f/uploads/origins/d534533d-9282-4b94-8eb3-67892d5929d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8a01921ab42ae6b569b5e076204295a 3x", "genre": "art", "nsfw": true, "body": "前回はイラストありがとうございました。\n今回もリクエストをお願いしたいです。\nキャラクターは前回と同じ\nKOS-MOS Ver.4：作品「XenosagaⅢ(ゼノサーガ3)」\n\nシチュエーション\n今回は男に犯されているシーンで体位に関しては\n絵師様にお任せします。\n衣装は体位に合わせて脱がしたり簡略化されても構いません。\nまた差分として射精されボテ腹になるのと\n周りの男達からザーメンシャワーを浴びせられるのをお願いしたいです。\n(周りの男達に関しては全身ではなくペニスだけ描くなど簡略化して頂いて構いません。)\n\nキャラクター参考用URL\nhttp://www.alter-web.jp/products/341/\nhttps://alter-web.jp/products/331/\nhttps://www.bandainamcoent.co.jp/cs/list/xenosaga3/character/kosmos.php\n\nお忙しいところ恐縮ですがご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@usukawa5/works/58", "thumbnail_src": "https://si.imgix.net/54369702/uploads/origins/d16e4865-2138-4309-8c82-3507bedb6b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98f0d0235b2b47b98fa7f3d25d368243", "thumbnail_srcset": "https://si.imgix.net/54369702/uploads/origins/d16e4865-2138-4309-8c82-3507bedb6b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98f0d0235b2b47b98fa7f3d25d368243, https://si.imgix.net/54369702/uploads/origins/d16e4865-2138-4309-8c82-3507bedb6b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dcf8191382b34ae672ca7af351434fc 2x, https://si.imgix.net/54369702/uploads/origins/d16e4865-2138-4309-8c82-3507bedb6b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f48c09321d4f81c468f0f0b7f6701f30 3x", "genre": "art", "nsfw": true, "body": "さて、この度ですが「ロボ娘な下級武士」なイラストを見たいと思いましてご依頼となりました。\n\n以下は要望の箇条書きとなります\n全体\n「ガラの悪そうな、粗末な装備の武士もしくは追剥風なロボ娘」\nロボ娘としてのデザイン\n　1.ボディ形状としてはロボ僧侶と同じ系統で、ロボ僧侶さんより安価な感じ\n　2.肌の色合いとしては、褐色までいかないものの少し日に焼けた感じで土などで汚れている感じ\n　3.他、素体のデザイン\n　　1).胸の辺りは白サラシをまいたように見える感じ\n　　2).股間部分は赤フンドシに見えるような感じ\n　4.髪は短めの黒で、ギザ歯ですさんでいる感じ\n　5.装備品\n　　1).腹当風のボディアーマ\n　　https://www.touken-collection-nagoya.jp/armor-introduction/haraate-haramaki/\n　　2).腰蓑\n　　3).長巻\n　6.他、色などはお任せいたします\nその他\n　1.もし差分を描いていただけるなら、装備品がない全裸を描いていただければ\n\n\nお手数ですが、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@usukawa5/works/57", "thumbnail_src": "https://si.imgix.net/ef5c7ca5/uploads/origins/79cae5fa-7acf-49de-8aba-0d3bae38e5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56191820eeb18b032cafdb629c3ccd4", "thumbnail_srcset": "https://si.imgix.net/ef5c7ca5/uploads/origins/79cae5fa-7acf-49de-8aba-0d3bae38e5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56191820eeb18b032cafdb629c3ccd4, https://si.imgix.net/ef5c7ca5/uploads/origins/79cae5fa-7acf-49de-8aba-0d3bae38e5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b421f1d3d27fc5c105a4a0ad468867a3 2x, https://si.imgix.net/ef5c7ca5/uploads/origins/79cae5fa-7acf-49de-8aba-0d3bae38e5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86e397ec3f4b067a85a6127ee83681b5 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今回は、キャラクターデザインのリクエストをさせていただきます。\nキャラクターの概要：\n・長身、筋肉質、褐色肌のグラマラスな体形の女戦士。\n・牛のような黒い鎧をがっちりと着こんでいる。（ヘルムヴィーゲ・リンカー風）\n・鎧は胸の片側が割れており、鋼の様に変色、硬質化した乳房が露出している。\n・変化した原因は、乳首に呪われた杭を挿し込まれたため。\n・鎧で覆う必要がなくなったが、度重なる戦いの中で乳房や乳首に傷跡がついている。\n以上となります。よろしくお願いします。", "created_at": "", "completed_at": ""}]}