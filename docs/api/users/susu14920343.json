it=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9443d38a01b325a93446e86feaeb6081 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/58", "thumbnail_src": "https://si.imgix.net/b422a9e4/uploads/origins/033fc136-d522-458b-84a2-af595637155a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f48a61032bbd3fc303b93b8a7593f9f0", "thumbnail_srcset": "https://si.imgix.net/b422a9e4/uploads/origins/033fc136-d522-458b-84a2-af595637155a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f48a61032bbd3fc303b93b8a7593f9f0, https://si.imgix.net/b422a9e4/uploads/origins/033fc136-d522-458b-84a2-af595637155a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acd3bda33aae121e2687dcf3c0722f1a 2x, https://si.imgix.net/b422a9e4/uploads/origins/033fc136-d522-458b-84a2-af595637155a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9a0387648f1f800fc446b5e4d235063 3x", "genre": "art", "nsfw": false, "body": "susu3先生、こんにちは！\n前回のリクエスト、本当にありがとうございました！\nもしよろしければ、またお願いしたいです。\n\n文小ちゃんが微笑みながら膝の上に頭を乗せて耳掃除を誘う、このポーズに似ています。https://www.pixiv.net/artworks/126826355 。\n今度はメガネをかけて描いてください。\n\nキャラクター参照：\nx.gd/uZlOM\n\nそれ以上の詳細はお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/57", "thumbnail_src": "https://si.imgix.net/85902ed7/uploads/origins/fdb8fe3f-7a9d-4d24-b07a-01b96b32eb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79635b07b8fefb1a07d37739db9cff92", "thumbnail_srcset": "https://si.imgix.net/85902ed7/uploads/origins/fdb8fe3f-7a9d-4d24-b07a-01b96b32eb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79635b07b8fefb1a07d37739db9cff92, https://si.imgix.net/85902ed7/uploads/origins/fdb8fe3f-7a9d-4d24-b07a-01b96b32eb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=641f1d8fc0a148323ca2732f8c26c1ff 2x, https://si.imgix.net/85902ed7/uploads/origins/fdb8fe3f-7a9d-4d24-b07a-01b96b32eb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9b0b6d6a69ee85f19d018c3483b6a88 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。以前描いていただいた跡取り娘ちゃんと宿泊客の男の子のイラスト(https://skeb.jp/@susu14920343/works/6)の続きとして、2人が夜に旅館の庭先か駐車場の一角を借りて一緒に手持ち花火で遊んでいるところを描いていただけないでしょうか。\n構図は2人の足元まで映っており、後ろの方で女将さんか男の子の母親が見守っている感じのものを想定しています。また、跡取り娘ちゃんの格好は褌一枚+さらし着用、男の子の格好は浴衣姿もしくは紺~藍色の甚平姿でお願いします。その他については金額の範囲内でsusuさんの描きたいようにお任せします。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/56", "thumbnail_src": "https://si.imgix.net/e664bb4f/uploads/origins/6e313100-871b-4b56-a8b5-d54c96e850e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ecd7766e6af2033dccc265c2ad3a6a5", "thumbnail_srcset": "https://si.imgix.net/e664bb4f/uploads/origins/6e313100-871b-4b56-a8b5-d54c96e850e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ecd7766e6af2033dccc265c2ad3a6a5, https://si.imgix.net/e664bb4f/uploads/origins/6e313100-871b-4b56-a8b5-d54c96e850e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36867812a8381c7dffc5f4fb2cc8b525 2x, https://si.imgix.net/e664bb4f/uploads/origins/6e313100-871b-4b56-a8b5-d54c96e850e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f151589c4c0216a508e90ed561ba199 3x", "genre": "art", "nsfw": true, "body": "こんにちは!\n可愛らしい絵柄に惹かれてリクエストさせて頂きました\n主な内容としては女の子のスカートたくし上げをお願いしたいです\n\n●キャラクター\nSUSU様のこちらの作品の女の子\n\nhttps://www.pixiv.net/artworks/110985724\n\n●服装\n丈が短いデニムスカート\n上は描きやすいものでおまかせ\n\n●ポーズ①\n足を閉じた状態での直立\n片手で少しだけスカートをめくってパンチラさせている\n\n●ポーズ②\n同じく直立で両手でスカートをオヘソが見える位置まで持ち上げてパンツを見せつけている\n\n●体格\n身長が低く、肉付きが良いムチロリ\n\n●表情\n明るい笑顔\nキョトン顔\nドヤ顔\nメ◯ガキの様な二ヘラ顔\nジト目で不機嫌そう顔\n\n●下着\n布面積が広く、スジが浮き出ないお子様パンツ\n・赤いリボンが付いた白\n・明るい色のお子様パンツ(デザインおまかせ)\n\n以上です!\n可能な範囲で構いません!\nどうかよろしくお願いいたします!", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/55", "thumbnail_src": "https://si.imgix.net/2088a211/uploads/origins/6f22fc19-4c7e-4d00-b5e1-47d3a7db9b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edc2185debdfc69ddc0aa8aed93bd8b3", "thumbnail_srcset": "https://si.imgix.net/2088a211/uploads/origins/6f22fc19-4c7e-4d00-b5e1-47d3a7db9b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edc2185debdfc69ddc0aa8aed93bd8b3, https://si.imgix.net/2088a211/uploads/origins/6f22fc19-4c7e-4d00-b5e1-47d3a7db9b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d62da05b26bbee51f547b342a3590a68 2x, https://si.imgix.net/2088a211/uploads/origins/6f22fc19-4c7e-4d00-b5e1-47d3a7db9b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4eeb7d88407992d03caf30343a0dac7 3x", "genre": "art", "nsfw": true, "body": "はじめまして、susu先生！\n先生の絵はとてもかわいくて癒されます。\n\n私のオリジナルキャラクター冬月文小（冬月綾子）を描いていただけませんか？\n田舎の本屋で働く、優しくてのんびりした女の子です。\nキャラクター参考\nx.gd/uZlOM\n\n服装は自由です。\n\nこんなポーズで、嬉しそうな表情の綾子ちゃんが見たいです：\nhttps://www.pixiv.net/artworks/126752814\n\nそれ以上の詳細はお任せします。\n\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/54", "thumbnail_src": "https://si.imgix.net/c4a56314/uploads/origins/b4e1614a-84bd-4d0c-9c20-0718fdd4f10c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeb3f08a141eaa90e9b507218054c15c", "thumbnail_srcset": "https://si.imgix.net/c4a56314/uploads/origins/b4e1614a-84bd-4d0c-9c20-0718fdd4f10c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeb3f08a141eaa90e9b507218054c15c, https://si.imgix.net/c4a56314/uploads/origins/b4e1614a-84bd-4d0c-9c20-0718fdd4f10c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c02758b05a2bd1d64f3ca88803175f74 2x, https://si.imgix.net/c4a56314/uploads/origins/b4e1614a-84bd-4d0c-9c20-0718fdd4f10c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3e85e5e7678c3c00c1d6ca5de4c55fc 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます\nまたリクエストさせてください\n\nキャラ\n「帰宅中によく会う近所の子」(https://www.pixiv.net/artworks/123143190)の女の子\n\n衣装\n･元絵で着用しているものと同じ服\n･紺色のハイソックス(ひざ下あたりまでの丈のものをお願いします)\n･飾りのない純白のフルバックのパンツで、いわゆるお子様パンツではないもの(クロッチは省略しないでください)\n\nシチュエーション等\n立ち絵と背景のパンツとの組み合わせ(いわゆるMtUウィルスと呼ばれるものです)のイラストをお願いします\n\n･立ち絵の表情は両目を開けた笑顔で、ハイソックスを履いているのがわかるようにひざ下かふくらはぎあたりまで描く\n･背景のパンツはお尻側から見たもの\n･差分として\n　･パンツがお尻に食い込んでいるもの\n　･白地に水色の星柄の入ったパンツを着用したもの\n を作っていただきたいです\n･psd形式での納品を希望します\n\n描くのが困難もしくは割に合わないと判断されましたら、即キャンセルしていただいて構いませんので改めてよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/53", "thumbnail_src": "https://si.imgix.net/5ce848c9/uploads/origins/6266e23a-700e-4ecf-b291-f75f19dcad40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ebc3554ab82d27adde860b1aa36b92", "thumbnail_srcset": "https://si.imgix.net/5ce848c9/uploads/origins/6266e23a-700e-4ecf-b291-f75f19dcad40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ebc3554ab82d27adde860b1aa36b92, https://si.imgix.net/5ce848c9/uploads/origins/6266e23a-700e-4ecf-b291-f75f19dcad40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f8ef54b42cde96be3ee78614477f2f9 2x, https://si.imgix.net/5ce848c9/uploads/origins/6266e23a-700e-4ecf-b291-f75f19dcad40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f05d31fb1287e2b287ac0e6320ab198f 3x", "genre": "art", "nsfw": true, "body": "vtuberのララベル・ララバイを描いてください。  \n\n揺れるコインに催眠術をかけられ、スカートを上げて下着を見せるララを描いてください。\n-催眠術をかけられた螺旋状の目\n-微笑み、困惑した表情\n-常識の変化\n-かわいい子供っぽい下着\n-設定・背景は重要ではありません。\n\n可能であれば、彼女のパンティが下ろされ、アソコが濡れている別バージョンもお願いします。\n\n彼女の衣装が複雑すぎて描けない場合は、セーラー服の衣装で代用してください。\n\nhttps://drive.google.com/drive/folders/1u3DE0xgOsog8qCH21IsDzB5gsJKTd3lG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/52", "thumbnail_src": "https://si.imgix.net/71db2938/uploads/origins/b6e3c6c8-ea98-411e-a111-1d5ff9a6c10b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dc2d509f0eadd06624d95caacd551d4", "thumbnail_srcset": "https://si.imgix.net/71db2938/uploads/origins/b6e3c6c8-ea98-411e-a111-1d5ff9a6c10b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dc2d509f0eadd06624d95caacd551d4, https://si.imgix.net/71db2938/uploads/origins/b6e3c6c8-ea98-411e-a111-1d5ff9a6c10b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38e41dffba387d90a9fc3367e54f8b98 2x, https://si.imgix.net/71db2938/uploads/origins/b6e3c6c8-ea98-411e-a111-1d5ff9a6c10b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=761d960a9548565d42a817ad657d1a51 3x", "genre": "art", "nsfw": true, "body": "前回は飛行機で隣になった子のイラストをありがとうございました\nまた同じ子でリクエストさせてください\n\nキャラ\n「飛行機で隣になった子」(https://www.pixiv.net/artworks/110985724)の女の子\n\n衣装\n･元絵で着用しているものと同じ服\n･紺色のハイソックス(ひざ下あたりまでの丈のものをお願いします)\n･飾りのない純白のフルバックのパンツで、いわゆるお子様パンツではないもの(クロッチは省略しないでください)\n\nシチュエーション等\n立ち絵と背景のパンツとの組み合わせ(いわゆるMtUウィルスと呼ばれるものです)のイラストをお願いします\n\n\n･立ち絵はしゃがみパンチラを正面から見たもの(床に座って作業している自分と向き合っているイメージです)\n･表情はhttps://www.pixiv.net/artworks/95339492と同じ感じのもの\n･背景のパンツは正面から見たもので、脚を開いてパンツがはっきり見えるようにする(他の絵師様の絵となりますが、開き具合はhttps://www.pixiv.net/artworks/76875287のような感じでお願いします)\n･差分として、白地に水色の星柄の入ったパンツを着用したものを作っていただきたいです\n･psd形式での納品を希望します\n\nその他\nもし可能でしたら、元絵で着用している首掛けのパスケースとhttps://www.pixiv.net/artworks/111929611で着用しているヒトデの首飾りをレイヤーで切り替えできるようにしていただきたいです\n\n描くのが困難もしくは割に合わないと判断されましたら、即キャンセルしていただいて構いませんので改めてよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/51", "thumbnail_src": "https://si.imgix.net/62e9251b/uploads/origins/e843bea0-f8bd-4aed-b71e-f2aa62076fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c1622eb1b669c3ac30c979fd271d68b", "thumbnail_srcset": "https://si.imgix.net/62e9251b/uploads/origins/e843bea0-f8bd-4aed-b71e-f2aa62076fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c1622eb1b669c3ac30c979fd271d68b, https://si.imgix.net/62e9251b/uploads/origins/e843bea0-f8bd-4aed-b71e-f2aa62076fff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0978a97e8b9e560eb6ce05f2193a3f32 2x, https://si.imgix.net/62e9251b/uploads/origins/e843bea0-f8bd-4aed-b71e-f2aa62076fff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43195a92770d4897b53522380ca7c753 3x", "genre": "art", "nsfw": true, "body": "susuさんの◯リキャラや柔らかそうなパンツ、クロッチやおしっこ絵が好きで依頼させて頂きました\n\n■お題\npixiv.net/artworks/94854169\npixiv.net/artworks/100917332\n跡取り娘ちゃんで、未洗濯ふんどしやパンツフェチな絵をお願いします\n上の洗濯を「お得意様」に見られたifで、いつものご奉仕やじゃれ合いセ◯ハラのノリで「今穿いてるのは洗わなくていいの？」と聞かれてふんどしの汚れ具合をチェックされる、みたいな　「パンツあやとり」的な羞恥シチュの文法です\n\n①skeb.jp/@susu14920343/works/35\n②skeb.jp/@manideletevoice/works/49\n①のような正面立ち姿を大人目線で軽く見下ろす(足元の洗濯桶が見える角度あるいはより引いた画角)+②の左上のように解いたふんどしを暖簾のように掲げている　シミてるのを自覚して恥じらい、バツが悪そうに目を逸らしたり誤魔化し笑いするイメージを跡継ぎちゃんのキャラ解釈に合わせて\n\nふんどしは股間～お尻に食い込んでた跡がよれたり皺になったり脱ぎたてで湿ってくたっとなったような質感、体温の高さを感じさせる脱ぎたての蒸れ表現、すじが密着していた辺りには恥ずかしい黄色いシミを\n\nシチュエーションに合わせた台詞もできれば欲しいです(このシミは何かな？とかどれぐらいの時間穿いてた、とかに言及されて自白したり、おしっこ臭を嗅がれて恥ずかしがる言葉責め羞恥プレイ的なじゃれ合い感だと嬉しいです)\n\nその他、おまけで是非お願いしたく\npixiv.net/artworks/88922600\npixiv.net/artworks/111553060\nこれらのように足元の洗濯桶に積まれたりこぼれ落ちた「他のお客様の洗濯物」としてsusuさんの子達の使用済みクロッチを優先度順に最大5枚描けるだけ描いて頂きたいです！\n\nskeb.jp/@susu14920343/works/20\nskeb.jp/@susu14920343/works/47　(おもらし)\npixiv.net/artworks/104636437\nskeb.jp/@susu14920343/works/15　(青の星柄)\nskeb.jp/@susu14920343/works/31　(おもらし)", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/50", "thumbnail_src": "https://si.imgix.net/bfbd3538/uploads/origins/256a5675-1f3a-4954-975d-c2d40354c100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=653c3fa8410e6ac9670be270868c6f18", "thumbnail_srcset": "https://si.imgix.net/bfbd3538/uploads/origins/256a5675-1f3a-4954-975d-c2d40354c100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=653c3fa8410e6ac9670be270868c6f18, https://si.imgix.net/bfbd3538/uploads/origins/256a5675-1f3a-4954-975d-c2d40354c100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4d183f1bbd37d426d54ae9b1823c92f 2x, https://si.imgix.net/bfbd3538/uploads/origins/256a5675-1f3a-4954-975d-c2d40354c100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30aeaa71fd80ad0d3ac7da3e0e50b002 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@susu14920343/works/49", "thumbnail_src": "https://si.imgix.net/abc8bee9/uploads/origins/86cbf089-b4fb-4fae-ae95-f240f3870b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99bd0e1e90671fdd59fd100a56ed22c4", "thumbnail_srcset": "https://si.imgix.net/abc8bee9/uploads/origins/86cbf089-b4fb-4fae-ae95-f240f3870b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99bd0e1e90671fdd59fd100a56ed22c4, https://si.imgix.net/abc8bee9/uploads/origins/86cbf089-b4fb-4fae-ae95-f240f3870b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43e390f86efd3909690c6cd41b81a855 2x, https://si.imgix.net/abc8bee9/uploads/origins/86cbf089-b4fb-4fae-ae95-f240f3870b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05ca03468334afb6b6e46418ee0b9c54 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}