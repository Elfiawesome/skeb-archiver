press&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=071c91ae426a91a990d5486ace86b41b 3x", "genre": "art", "nsfw": false, "body": "skeb再開嬉しいです！\n今回も丹羽仁美ちゃんをお願いします。\nストリート系の服装をお願いします。かっこいい感じいいです。\nその他全ておまかせします。\n可能であれば宛名ありとなし2枚頂けると幸いです。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@meknumber/works/40", "thumbnail_src": "https://si.imgix.net/ff611fcc/uploads/origins/c11cc8d8-4039-46cd-a886-f4fed1f6be63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6e670afeed461dcb2df657fa5347c92", "thumbnail_srcset": "https://si.imgix.net/ff611fcc/uploads/origins/c11cc8d8-4039-46cd-a886-f4fed1f6be63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6e670afeed461dcb2df657fa5347c92, https://si.imgix.net/ff611fcc/uploads/origins/c11cc8d8-4039-46cd-a886-f4fed1f6be63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7c1eb84f0f93d9592dc57a13e33515d 2x, https://si.imgix.net/ff611fcc/uploads/origins/c11cc8d8-4039-46cd-a886-f4fed1f6be63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=808b6d28ade19d9aa1d6360e98523a2b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nアイドルマスターシンデレラガールズ丹羽仁美をお願いします。\n服装はクール、かっこいい感じがいいです。\nその他全ておまかせします。\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@meknumber/works/39", "thumbnail_src": "https://si.imgix.net/9e0fc490/uploads/origins/6df5a9e3-209a-4f63-ac61-91c3ad16297f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23137c360a9e66d5747a2995a65325b", "thumbnail_srcset": "https://si.imgix.net/9e0fc490/uploads/origins/6df5a9e3-209a-4f63-ac61-91c3ad16297f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23137c360a9e66d5747a2995a65325b, https://si.imgix.net/9e0fc490/uploads/origins/6df5a9e3-209a-4f63-ac61-91c3ad16297f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c9568518ef9799268d80c9534b24cae 2x, https://si.imgix.net/9e0fc490/uploads/origins/6df5a9e3-209a-4f63-ac61-91c3ad16297f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61cefcc4894c479fff483f7dcf7492d6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、絵がカッコよくて好きです。シャニマスの芹沢あさひを描いて欲しいです。\n\nPCの壁紙にしたいので横長の3000x2000、もしくは同等の縦横比でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@meknumber/works/38", "thumbnail_src": "https://si.imgix.net/4cb4caec/uploads/origins/f9737a33-9408-4175-8fc4-3c72d82d841f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad4a274be81958fb63e45c830f76aa34", "thumbnail_srcset": "https://si.imgix.net/4cb4caec/uploads/origins/f9737a33-9408-4175-8fc4-3c72d82d841f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad4a274be81958fb63e45c830f76aa34, https://si.imgix.net/4cb4caec/uploads/origins/f9737a33-9408-4175-8fc4-3c72d82d841f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4ba856bc1630118962a07610ff0a911 2x, https://si.imgix.net/4cb4caec/uploads/origins/f9737a33-9408-4175-8fc4-3c72d82d841f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce98f0ab21134f3f4ae9591e2ec05df2 3x", "genre": "art", "nsfw": false, "body": "こんにちは!\n私はあなたのアートが大好きです!そこで、Elfen Liedのファンアートをリクエストすることにしました。\n\nマユと一緒に座っているナナが犬と一緒にアイスクリームを食べているところを描いてほしいです。エルフェンリートを見たことがない人は、ナナがアイスクリームを食べるのは初めてなので、エラの顔は喜びと驚きの表情で、ルビが振ってあるべきです。まゆゆは、友達が好きになることを知っていたので、喜んでいます。\nナナのドレスは夏用のキュートなもの、マユはもっとカジュアルなもの、または学校の制服にすることもできます。\n背景は、公園やアイスクリーム屋さんなどがいいでしょう。\n\nナナとマユの画像があります。\nhttps://imgur.com/a/JxAXEPU\nナナはダイクロニカスなので、耳のような2本の白い突起である2本の角を持っています。最初のナナの画像では、角を隠すためにネクタイをしています。ネクタイをしてもしなくても、お好きなように描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@meknumber/works/37", "thumbnail_src": "https://si.imgix.net/2e22149d/uploads/origins/eec16b5d-f8b3-417f-82cb-225903cb3768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d64910987bbad6990722728d6db1ab0", "thumbnail_srcset": "https://si.imgix.net/2e22149d/uploads/origins/eec16b5d-f8b3-417f-82cb-225903cb3768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d64910987bbad6990722728d6db1ab0, https://si.imgix.net/2e22149d/uploads/origins/eec16b5d-f8b3-417f-82cb-225903cb3768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64abdc80f05a59a77ac855950dc2ad45 2x, https://si.imgix.net/2e22149d/uploads/origins/eec16b5d-f8b3-417f-82cb-225903cb3768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94b5ba0b9ca3dcbd2547b4cf66b55459 3x", "genre": "art", "nsfw": false, "body": "アイドルマスターシンデレラガールズの｢冴島清美｣のイラストをお願いします。\n\n｢冴島清美｣は作品内で特訓後と言われている、メガネなし、髪を解いている状態。\n\n服装はクールな感じで。\n\nTwitter等SNSのアイコン用に使う予定です。", "created_at": "", "completed_at": ""}, {"path": "/@meknumber/works/36", "thumbnail_src": "https://si.imgix.net/48a44dfc/uploads/origins/be42c369-ab31-408c-8fa6-3dd1a9f1aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80380b77845235f4704ce0673c29b77", "thumbnail_srcset": "https://si.imgix.net/48a44dfc/uploads/origins/be42c369-ab31-408c-8fa6-3dd1a9f1aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80380b77845235f4704ce0673c29b77, https://si.imgix.net/48a44dfc/uploads/origins/be42c369-ab31-408c-8fa6-3dd1a9f1aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=980d5943b885d574479c91b2fb18b3c2 2x, https://si.imgix.net/48a44dfc/uploads/origins/be42c369-ab31-408c-8fa6-3dd1a9f1aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=294b9143e99eec97417361b186066d6d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nアイドルマスターシンデレラガールズに登場する「浜口あやめ」のイラストをお願いします。\nモバマスの方のカード［月影の刺客］浜口あやめ＋の衣装でクールな感じに描いていただければ嬉しいです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@meknumber/works/35", "thumbnail_src": "https://si.imgix.net/a38fcc45/uploads/origins/ebe3fb63-e8a9-4b97-9aae-9f0a4101473c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr