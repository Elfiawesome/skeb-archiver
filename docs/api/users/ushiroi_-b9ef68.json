やあざとさがあると明日井さんのイラストのテイストにもマッチしていて素敵になると思っています … ！\n\n明日井さんのイラスト、本当に大好きです！これからも応援させて頂きます\nもしご縁がありましたらよろしくお願い致します ✿\n\nhttps://drive.google.com/drive/folders/1-2jk3YHVgVl1wYb44KXjOrGI4HPU8VfK", "created_at": "", "completed_at": ""}, {"path": "/@ushiroi_/works/3", "thumbnail_src": "https://si.imgix.net/e67adfd5/uploads/origins/eb96fc51-3a10-4602-a2b1-3ebcecb6439f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f11064c49ecf6a7b33f0661309f3e45b", "thumbnail_srcset": "https://si.imgix.net/e67adfd5/uploads/origins/eb96fc51-3a10-4602-a2b1-3ebcecb6439f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f11064c49ecf6a7b33f0661309f3e45b, https://si.imgix.net/e67adfd5/uploads/origins/eb96fc51-3a10-4602-a2b1-3ebcecb6439f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e062eac05aff9ca2a94f7424a2d7350a 2x, https://si.imgix.net/e67adfd5/uploads/origins/eb96fc51-3a10-4602-a2b1-3ebcecb6439f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecffbcb71605e101577633789e31101a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ushiroi_/works/2", "thumbnail_src": "https://si.imgix.net/df284919/uploads/origins/01ae71bd-e466-4441-b8b2-680857b995a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6537bcc6ff615b938a5101ff0de70ee4", "thumbnail_srcset": "https://si.imgix.net/df284919/uploads/origins/01ae71bd-e466-4441-b8b2-680857b995a2?bg=%23fff&auto=format%2Ccomp