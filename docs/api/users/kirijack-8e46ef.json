2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f703442b9c99b1de7226013da734011", "thumbnail_srcset": "https://si.imgix.net/2e470a71/uploads/origins/3a167404-c646-4b5e-b4db-68f559d92f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f703442b9c99b1de7226013da734011, https://si.imgix.net/2e470a71/uploads/origins/3a167404-c646-4b5e-b4db-68f559d92f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a436b36bdc4571e3df36bafafd166e4f 2x, https://si.imgix.net/2e470a71/uploads/origins/3a167404-c646-4b5e-b4db-68f559d92f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d93efd3f34df45e3e2398ae267b72cfe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kirijack/works/23", "thumbnail_src": "https://si.imgix.net/59f1e638/uploads/origins/6951e071-028f-4ff5-9bb8-9f14f7acb29a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c627bd8886953dd3ba1bd694bb2f2ba4", "thumbnail_srcset": "https://si.imgix.net/59f1e638/uploads/origins/6951e071-028f-4ff5-9bb8-9f14f7acb29a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c627bd8886953dd3ba1bd694bb2f2ba4, https://si.imgix.net/59f1e638/uploads/origins/6951e071-028f-4ff5-9bb8-9f14f7acb29a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=527a5ac151b786996a3a5723fda6754a 2x, https://si.imgix.net/59f1e638/uploads/origins/6951e071-028f-4ff5-9bb8-9f14f7acb29a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21cf083ea822125859476854743874ec 3x", "genre": "art", "nsfw": true, "body": "こんにちは！もしまた依頼を引き受けていただけるのであれば、私のキツネがもう一度敗北する作品をお願いしたいです。\n\nPSO2 NGSの最新バトルでは、地上数キロメートルで戦うことになります。 プレイヤーが倒されると、重力がないため宙に浮いたままになってしまいます。参考動画はこちら：https://drive.google.com/drive/folders/16-uW4oyP69twRThj1EZZycun5BYOP3pl\n\n私のキツネが決定的な攻撃を受けて、まさにこの状態になるシナリオが欲しい。彼女が浮いている間、明らかに意識不明で、目が開いたままか、白目をむいているようなアングルが欲しい。気絶したまま、敵にもう一度殴られ、さらに侮辱される。ボスの腕がダメージを受けているのを見せるだけなら、まったく問題ない。 殴られた後、彼女はさらに宇宙へ飛び、無造作にスペースデブリの塊に着地する。身体はまだ無傷で、お尻を浮かせたり、口を大きく開けたまま足を広げたりと、かなり見苦しいポーズをとっている。\n\n彼女のプリッとしたお尻と曲線を生かしながら、彼女の失敗を描いてください\n\nまたの依頼をぜひ検討してほしい。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1YP9961D5a9KKLe6lIJz7CLc8N6PnmrPK", "created_at": "", "completed_at": ""}, {"path": "/@kirijack/works/22", "thumbnail_src": "https://si.imgix.net/74a2ee07/uploads/origins/5d102bba-83cd-425d-8ef3-a2b5d3828e72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df6434a8970dec503e1e2cd5ae0f6062", "thumbnail_srcset": "https://si.imgix.net/74a2ee07/uploads/origins/5d102bba-83cd-425d-8ef3-a2b5d3828e72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df6434a8970dec503e1e2cd5ae0f6062, https://si.imgix.net/74a2ee07/uploads/origins/5d102bba-83cd-425d-8ef3-a2b5d3828e72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4108a249ebabbfa815aef91db1e03b58 2x, https://si.imgix.net/74a2ee07/uploads/origins/5d102bba-83cd-425d-8ef3-a2b5d3828e72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06a1750503d2a3d217d5bc52092265e9 3x", "genre": "art", "nsfw": true, "body": "お世話になっております！今回は複数キャラで失礼致します\nなお、金額に見合わない場合はキャンセルいただいても大丈夫です！\n\n■キャラクター\n泉こなた+柊かがみ　レースクイーンver（らき☆すた）\nhttps://drive.google.com/drive/folders/1dmHb4CoQYCevzeOA-hQK4X0ia5VZntcS\n\n■概要\n赤い植物が吐き出した種がへそに入った後お腹の中に根を張られ、苗床となって死亡するシチュエーションを2枚のイラストでお願い致します！\n※前回までと同様、出血描写は無しでお願い致します\n\n苦しみ方参考→https://drive.google.com/file/d/1NmFTJb3xQVvps8JZNuH17kMtIJSVOMFN\n\n基本的に前作までと同じ構成となりますが、一部変更点等がございますので以下をご確認くださいますようお願い致します\n\n▼1枚目\n構図参考→https://drive.google.com/file/d/1cXkejXf-MwnR1Cxh_I1I2wb2CUNCe7et\n・構成はほぼ上記画像の通りです\n・各要素はそれぞれ以下のようにお願い致します\n　☆こなた\n　・片手でへそをほじり、もう片方の手は助けを求めるように前へ伸ばされている\n　・かなりの前傾姿勢で、顔周りは目と垂れ下がった舌以外ほぼ見えない状態\n　\n　☆かがみ\n　・両手でへそをほじっている\n　・お腹を突き出すように身体を反らしている\n\n　☆共通\n　・両目はそれぞれ違う方向を向いており、口からは長い舌が垂れ下がっている\n　・がに股でヨタヨタと歩いている\n　・乳首が勃起している（長乳首気味でお願い致します）\n　・大量の涙、よだれ、鼻水を垂れ流している\n　・それぞれのへそ付近のアップ\n\n▼2枚目\n構図参考→https://drive.google.com/file/d/1OdQo_39L0FNwxbTV2HJaEb_WLTW_JmoG\n・ポーズは上記の構図通りです\n・ポーズ以外の要素は2名とも共通で以下の通りでお願い致します\n　＞大量のゲロに顔を埋めている状態\n　＞胸から母乳が出ており、胸の下に白い水溜まりが出来ている\n　＞糞尿が垂れ流され、お尻の部分が大便で膨らんでいる\n　　※こなたはズボン越し、かがみは下着から漏れ出ている状態）\n\nhttps://drive.google.com/drive/folders/1X-9ietKImbJ80huaB2eiX-RGQITaL-de?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kirijack/works/21", "thumbnail_src": "https://si.imgix.net/75fdc3b6/uploads/origins/5cf1b4ba-3b63-4e6d-b4d0-dffc31cb52d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff545e590bb2a65a536b89f9904f502", "thumbnail_srcset": "https://si.imgix.net/75fdc3b6/uploads/origins/5cf1b4ba-3b63-4e6d-b4d0-dffc31cb52d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff545e590bb2a65a536b89f9904f502, https://si.imgix.net/75fdc3b6/uploads/origins/5cf1b4ba-3b63-4e6d-b4d0-dffc31cb52d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=981915ca78e86d671b09c28fefd9aba1 2x, https://si.imgix.net/75fdc3b6/uploads/origins/5cf1b4ba-3b63-4e6d-b4d0-dffc31cb52d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a04c33f07544137066fb9882595b34b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kirijack/works/20", "thumbnail_src": "https://si.imgix.net/f4136920/uploads/origins/5ad7a3cb-dd61-4928-a712-80e7882c8b90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=181d925dd6cd4766951901c53209bea7", "thumbnail_srcset": "https://si.imgix.net/f4136920/uploads/origins/5ad7a3cb-dd61-4928-a712-80e7882c8b90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=181d925dd6cd4766951901c53209bea7, https://si.imgix.net/f4136920/uploads/origins/5ad7a3cb-dd61-4928-a712-80e7882c8b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e421fe1cd1d8f3a12b12e7d391036be1 2x, https://si.imgix.net/f4136920/uploads/origins/5ad7a3cb-dd61-4928-a712-80e7882c8b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dd5d45fa5230dd5bc74b96e58e4f31e 3x", "genre": "art", "nsfw": true, "body": "お世話になっております！今回も同じ内容のリクで失礼致します\n\n■キャラクター\nイドラ・アーヴォルン（戦隊レッド 異世界で冒険者になる）\nhttps://drive.google.com/drive/folders/1d2R8Kg5xUsRWtSJPwj8TIu-423EIo9zl\n\n■概要\n赤い植物が吐き出した種がへそに入った後お腹の中に根を張られ、\n苗床となって死亡するシチュエーションを2枚のイラストでお願い致します！\n※前回までと同様、出血描写は無しでお願い致します\n\nシチュ参考→https://drive.google.com/file/d/1SAC9TN0IGa2rxfcnMK7Ojx6ooLcKgEYE\n苦しみ方参考→https://drive.google.com/file/d/15R4v-Qx3I0crJXnwhjt-xtP8ew0J8Hcq\n\n基本的に前作までと同じ構成となりますが、一部変更点等がございますので以下をご確認くださいますようお願い致します\n\n▼1枚目\n参考→https://drive.google.com/file/d/11Om0hI54IrSS4XIm1kNjEQcAlGQb8kiD\n・構成はほぼ上記画像の通りでお願い致します\n・両手でおへそをほじりながら、がに股でヨタヨタと歩いている状態\n・元の作品の時点で表情が豊かな為、驚いた顔やオエッとえづいている顔、\n　苦しんでいる場面の顔の崩れ方も大きめにしていただきたいです\n・舌を以前よりも過剰に長く垂れ下げていただきたいです（体液描写も遠慮無くお願いします！）\n・1枚目の苦しむ場面の時点で乳首が勃起しており、衣服を押しのけて乳首が露出している状態\n\n▼2枚目\n参考→https://drive.google.com/file/d/157MzuM2hafPKB7nrYxZ6wZlzLnUKGzg7\n※一部画像からの変更点あり\n・両足はまっすぐ伸ばしている状態\n・両手はおへそに指を突っ込んだままの（お腹の下敷きになっている）状態\n・乳房が身体と地面に圧されて左右に広がっており、勃起した乳首から勢いよく母乳を噴き出している\n・口から出たゲロ、失禁後の尿が水溜まりのように地面に広がっている\n・大量の大便によってお尻の部分がこんもりと盛り上がっている（マントの影響で難しい場合は無くても大丈夫です！）\n\nhttps://drive.google.com/drive/folders/1SC0v_ccTiqkDxc0PhO_KjxxC4XQAj6dQ?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kirijack/works/19", "thumbnail_src": "https://si.imgix.net/7ea7c004/uploads/origins/3ca723d3-ad80-45f7-b06a-4652df09c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b7acb67bb4f3429abe5982acd82d165", "thumbnail_srcset": "https://si.imgix.net/7ea7c004/uploads/origins/3ca723d3-ad80-45f7-b06a-4652df09c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b7acb67bb4f3429abe5982acd82d165, https://si.imgix.net/7ea7c004/uploads/origins/3ca723d3-ad80-45f7-b06a-4652df09c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b55f4ceb935117f6cbc7600de4ff6cec 2x, https://si.imgix.net/7ea7c004/uploads/origins/3ca723d3-ad80-45f7-b06a-4652df09c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb72942e7a175a9fdd48eb4050548e7 3x", "genre": "art", "nsfw": true, "body": "こんにちは。バンダナちゃんのNTRをリクエストしたいです。\n\n不倫交尾でエロガキに孕まされた出産寸前のバンダナちゃん（ムキムキ爆乳）がガニ股ポーズでガキに出産を強いられるシチュ。\n\nガキのガキなんて絶対に産むものかと悪態をつきながら必死に我慢する強気なバンダナちゃん。\nするといきなりエロガキに孕み腹に抱きつきかれながらハメられてオホってしまう。\nエロガキの出産催促ガチピストンに対して負けるものかとブッサイクな必死我慢ヅラで鼻息荒げながら耐えるバンダナちゃん。\n結局我慢できずにゴリラのようなきったないオホ声あげて舌出し仰け反りアクメ。\nチ◯ポを抜くエロガキ。舌をベロンと垂らしたマヌケな無様アヘ顔のバンダナちゃん。我慢し過ぎた反動によりガチイキでマ◯コを思いっきり緩められてしまいせっかくの我慢を台無しにされて悔しそうに負け惜しみを並べ立てる。\n屈辱の赤ちゃんひり出し変態出産アクメ。悔しすぎてブチギレながら怪獣のような雄叫びのゴリオホ仰け反り完全敗北アクメ。\nだらしないアヘオホ顔のバンダナちゃん。朦朧とした意識でエロガキの言いつけ通りダブルピース寝取られ宣言で完堕ち。\n\n以上な感じでお願いします。内容は描きやすいよう多少変更してくださって構いません。よろしければお願いし致します。", "created_at": "", "completed_at": ""}, {"path": "/@kirijack/works/18", "thumbnail_src": "https://si.imgix.net/f9d86cfe/uploads/origins/3736224e-fc2c-40fb-9f26-0da2c052c595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09e405ddb36918c1a16109ee3e932cc", "thumbnail_srcset": "https://si.imgix.net/f9d86cfe/uploads/origins/3736224e-fc2c-40fb-9f26-0da2c052c595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2