48bb/uploads/origins/fb65101f-c790-45b9-aede-b8d53beb9f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e84de636f5dbae9bcf314dd8ee4882f6 2x, https://si.imgix.net/fe0548bb/uploads/origins/fb65101f-c790-45b9-aede-b8d53beb9f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2feb5e2c2ea9c6ce6c08c38ee55284f1 3x", "genre": "art", "nsfw": true, "body": "遠北千南のイラストをリクエストさせていただきます。\n\n以前描かれていたパパ活する遠北千南の続きのような形でお願いします。\nhttps://skeb.jp/@kamkam_grape/works/5\n\n・使用済みゴムを持ってピース（手は顔の横）\n・胸が見えるように服はたくし上げたままで\n・表情は行為後の火照った感じが出ている\n・口元はおそうじフェラ後でザーメンや唾液が付いている\n・姿勢は立ちでも座りでも構いませんが、陰毛は見えるように\n\n検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/28", "thumbnail_src": "https://si.imgix.net/29b5730e/uploads/origins/21783e72-af57-46f6-a2ef-08de652827bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ef08f1db2662c7d0624bd90e97ca156", "thumbnail_srcset": "https://si.imgix.net/29b5730e/uploads/origins/21783e72-af57-46f6-a2ef-08de652827bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ef08f1db2662c7d0624bd90e97ca156, https://si.imgix.net/29b5730e/uploads/origins/21783e72-af57-46f6-a2ef-08de652827bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c622a2a4c6288ebb4d791e020254e9b 2x, https://si.imgix.net/29b5730e/uploads/origins/21783e72-af57-46f6-a2ef-08de652827bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea5681346974dd06673dc18d9b901a74 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/27", "thumbnail_src": "https://si.imgix.net/2d7d0e83/uploads/origins/3a7c2b41-69b9-40ec-9cc9-55c2c2dbf284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97d3e2b2b6de1a42333b73400170868", "thumbnail_srcset": "https://si.imgix.net/2d7d0e83/uploads/origins/3a7c2b41-69b9-40ec-9cc9-55c2c2dbf284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97d3e2b2b6de1a42333b73400170868, https://si.imgix.net/2d7d0e83/uploads/origins/3a7c2b41-69b9-40ec-9cc9-55c2c2dbf284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbf02fa0aea6b32f00542a42c0daa105 2x, https://si.imgix.net/2d7d0e83/uploads/origins/3a7c2b41-69b9-40ec-9cc9-55c2c2dbf284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08469325752b562bad1d5cad471c32f9 3x", "genre": "art", "nsfw": true, "body": "にじさんじののバン・ハダ、新衣装の上着るボトムスとアクセサリー全部を着るでずらし挿入背面座位姿勢で椅子の上で彼氏と性交する新装披露目同時に生中継して視聴者に見せるお願いします\n左端のスタイルを使用してください  ありがとう!\nhttps://twitter.com/clash_crash/status/1500817594940784640", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/26", "thumbnail_src": "https://si.imgix.net/6f23be74/uploads/origins/3abdc920-c5d8-43b2-83be-d160a88e8aae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1334a376152ab84945ec9f3acc757907", "thumbnail_srcset": "https://si.imgix.net/6f23be74/uploads/origins/3abdc920-c5d8-43b2-83be-d160a88e8aae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1334a376152ab84945ec9f3acc757907, https://si.imgix.net/6f23be74/uploads/origins/3abdc920-c5d8-43b2-83be-d160a88e8aae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73d1b4fedc1fb68c6cd9b0f4b5487505 2x, https://si.imgix.net/6f23be74/uploads/origins/3abdc920-c5d8-43b2-83be-d160a88e8aae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fab23128cda3bb22c816def8e5788add 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n以前描かれていたオリジナルキャラの子（https://skeb.jp/@kamkam_grape/works/24）とうちのオリジナルキャラわんこいんちゃん（ふたなり）との漫画をお願いいたします。（依頼そのものや内容についてご本人の了承済みです）\n\n内容は以前の寝取らせの続きになります。\n流れは大まかに、二人で並んで撮影開始→見せ槍→行為\n撮影開始\n・二人で並んで撮影開始、つきねちゃんは控えめな笑顔でわんこいんちゃんがにこにこ乗り気な笑顔\n\n見せ槍\n勃起前の竿をつきねちゃんに見せる。勃起前のサイズが勃起時の彼氏くんとのサイズがほぼ同じなため安心するが、勃起して大きくなった竿とその匂いで子宮が疼く描写。\nわんこいんちゃんは大丈夫そうというつきねちゃんの言葉に安心した様子。\n\n本番\n体位はバック。二人の身体が見えるアングル。わんこいんちゃんはめちゃくちゃ気持ちよさそうだが余裕はあるのに対し、つきねちゃんは巨根で激しく犯されているため汚い喘ぎ声が出るくらい感じている様子。つきねちゃんがボディが薄いためお腹の上から竿が入って若干腹ボコしていると嬉しいです。\n\n希望としては以上の通りですが、話の流れや描写の都合上多少の変更があっても大丈夫です。\nご検討よろしくお願いいたします。\n\nhttps://twitter.com/11coiiin/status/1581246876300365824?s=20&t=qXuNiS0pHmSfAHcK5zEYLw", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/25", "thumbnail_src": "https://si.imgix.net/25c189cc/uploads/origins/52b2ebcd-ad72-49cb-83d9-c407607a27ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2429404bfe6156ec6c29d54e23793eae", "thumbnail_srcset": "https://si.imgix.net/25c189cc/uploads/origins/52b2ebcd-ad72-49cb-83d9-c407607a27ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2429404bfe6156ec6c29d54e23793eae, https://si.imgix.net/25c189cc/uploads/origins/52b2ebcd-ad72-49cb-83d9-c407607a27ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc0281b5fcebce6c18ac7767e1916270 2x, https://si.imgix.net/25c189cc/uploads/origins/52b2ebcd-ad72-49cb-83d9-c407607a27ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=023332282b89a9e0df8e42da7147b2b3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/24", "thumbnail_src": "https://si.imgix.net/59da1e2f/uploads/origins/4cf8a444-e2c4-4218-afcd-9ea6977d4961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7103e726101a75fab6fc96b5c799251d", "thumbnail_srcset": "https://si.imgix.net/59da1e2f/uploads/origins/4cf8a444-e2c4-4218-afcd-9ea6977d4961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7103e726101a75fab6fc96b5c799251d, https://si.imgix.net/59da1e2f/uploads/origins/4cf8a444-e2c4-4218-afcd-9ea6977d4961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b68e7dcc96263558b09c755daba6f61 2x, https://si.imgix.net/59da1e2f/uploads/origins/4cf8a444-e2c4-4218-afcd-9ea6977d4961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb6e5153b778f6c221626ed276b8dda6 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです、いつもじょん先生の描くイラストと漫画にお世話になっております。\n先生の絵が大好きでリクエストさせていただきました\n今回はいつもと違い変則になるのですが僕のオリジナルキャラクター(衣装は陰毛アリの全裸)の漫画をお願いします\nURL：https://www.pixiv.net/artworks/102255641\n\nシチュエーション\n彼氏君との前置きセックスをお願いします\n\n・彼氏君とのいちゃらぶ騎乗位セックス\n・気持ちよくなってはいるが余裕のある表情\n・けどめちゃくちゃ気持ちよくなってる彼氏君が愛おしいという気持ちが強い、愛を確かめ合うセックス\n・避妊はしっかりしておりゴム有中出しセックス\n・膣奥(膣長は9.5cm程)までチンコ(7cm)が届いていない断面図\n・断面図はじょん先生がいつも描いてる感じと違ってほかの人の作品で申し訳ないのですが\n↓みたいな背景に主線がはっきりした感じでお願いします\n・URL：https://twitter.com/kakuntekun/status/1559447543012294656\n・バック系の体位は短小だと抜けやすいくテクニックが必要な為ひかえていただけると嬉しいです\n・彼氏君がイった後にお掃除フェラ\n・｢えぇ～前言ってた寝取らせ？そんなにやりたいの？！｣「わかった、分かりましたー」\n「仕方ないな、一度だけだよー」\n・「そんなに期待されても私●●以外じゃ多分気持ちよくならないしつまらないと思うだけどな」\n\n以上が概要となります、竿役の彼氏はセリフ無しでコストが掛かりそうなら白ハゲでも大丈夫です\nご提示した金額で時間やテンションが厳しい様ならキャンセルして下さい\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/23", "thumbnail_src": "https://si.imgix.net/79fd64af/uploads/origins/0c2969e3-c360-4206-a78f-6aeb0d37653d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a627e0c4bc4c261de13955b49ceb7af", "thumbnail_srcset": "https://si.imgix.net/79fd64af/uploads/origins/0c2969e3-c360-4206-a78f-6aeb0d37653d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a627e0c4bc4c261de13955b49ceb7af, https://si.imgix.net/79fd64af/uploads/origins/0c2969e3-c360-4206-a78f-6aeb0d37653d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be1feb450346ccd20eb326503a9d8e2b 2x, https://si.imgix.net/79fd64af/uploads/origins/0c2969e3-c360-4206-a78f-6aeb0d37653d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc580098a28758b288998e914a69ddae 3x", "genre": "art", "nsfw": true, "body": "どっとライブ所属のヤマトイオリさんのイラストを依頼いたします。\n衣装は初期3D衣装で谷間から亀頭がのぞいている。\n亀頭を指でツンツンと触りながら「ギュ～ってして欲しいんだ？」と悪戯っ子のように笑っている。\nご検討のほどよろしくお願いします。\n\nhttps://seesaawiki.jp/siroyoutuber/d/%a5%e4%a5%de%a5%c8%a5%a4%a5%aa%a5%ea%a1%da%bb%b2%b9%cd%bb%f1%ce%c1%a1%bf%bb%b2%b9%cd%b2%e8%c1%fc%a1%db#iori-3D", "created_at": "", "completed_at": ""}, {"path": "/@kamkam_grape/works/22", "thumbnail_src": "https://si.imgix.net/8e8fd613/uploads/origins/1432e47c-5cec-4fcf-bac4-c1f46ded1c21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=730b6b344d4888d3018269dc02590102", "thumbnail_srcset": "https://si.imgix.net/8e8fd613/uploads/origins/1432e47c-5cec-4fcf-bac4-c1f46ded1c21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=730b6b344d4888d3018269dc02590102, https://si.imgix.net/8e8fd613/uploads/origins/1432e47c-5cec-4fcf-bac4-c1f46ded1c21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54f1c64e78cfd76455751f6211230579 2x, https://si.imgix.net/8e8fd613/uploads/origins/1432e47c-5cec-4fcf-bac4-c1f46ded1c21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a00e1e29ba1ea39ff11b128cfe02cf6d 3x", "genre": "art", "nsfw": true, "body": "新人Vtuberの白夜ルナと申します。\nじょん様のpixivを拝見いたしましてご依頼したいと考え連絡いたしました。\n白夜ルナのハロウィンイラストをお願いしたいです。\n構図や衣装のデザインはじょん様にお任せいたします。\nこちらの要望は\n①使用用途はYouTubeのサムネイルや動画、配信での使用、Twitterでのアイコンを考えております。\n②背景透過画像