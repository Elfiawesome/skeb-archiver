fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c3f8fab36583a571eaa9f196d0241bb 3x", "genre": "art", "nsfw": false, "body": "こんにちはあるうららさん\nめっちゃ綺麗なソフィアちゃんのイラストを依頼したいです。テーマは豪華なドレスに身を包むソフィアちゃんでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/98", "thumbnail_src": "https://si.imgix.net/43b5dc5d/uploads/origins/976ed1d9-3700-4b24-b957-085e9e52ef14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0bbcad89b9bfef79d1f483d73435e0", "thumbnail_srcset": "https://si.imgix.net/43b5dc5d/uploads/origins/976ed1d9-3700-4b24-b957-085e9e52ef14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0bbcad89b9bfef79d1f483d73435e0, https://si.imgix.net/43b5dc5d/uploads/origins/976ed1d9-3700-4b24-b957-085e9e52ef14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5991a898c467c1cc389fe87d647255f 2x, https://si.imgix.net/43b5dc5d/uploads/origins/976ed1d9-3700-4b24-b957-085e9e52ef14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e27e28d1d5713471ceb1378ac635522 3x", "genre": "art", "nsfw": false, "body": "こんにちは、前回描いていただいたハロウィンの絵の続きの依頼を引き受けていただけませんか？\n怪物との遭遇から時が経ち、キツネとタヌキは家から逃げ出した。しかし、たぬきはその恐怖からケモノの姿に戻ることができず、現在は動物の姿のまま動けなくなっている。\nキツネはタヌキにいたずらをしてこのような事態を招いたことを心から謝罪し、タヌキはキツネを激しく非難する。\nたぬきが怒っている間、招き猫のような小さなクッションの上にいるイメージだ。\n背景では、キツネの小さな手下たちが、タヌキがケモノの姿に戻るのを助けるために、加護や道具、鍼治療など、さまざまな方法を試している。\nキツネとタヌキの友情は続く。\nキツネとタヌキの友情は続く。このシナリオの舞台は彼らの家の中でもいいし、あなたが一番うまくいくと思う場所でもいい。\n\nhttps://www.dropbox.com/scl/fo/4sfebq1rkeckrigd9w1y9/AKb5O_ruR4-R5guQqa-ZvfQ?rlkey=b4pyrglhd9roqbnlmk34mx7si&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/97", "thumbnail_src": "https://si.imgix.net/5521c6bd/uploads/origins/133125e4-48e4-4792-8241-2ac5a5c41383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26550dea3d693d95ab6a4ae4e37478ea", "thumbnail_srcset": "https://si.imgix.net/5521c6bd/uploads/origins/133125e4-48e4-4792-8241-2ac5a5c41383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26550dea3d693d95ab6a4ae4e37478ea, https://si.imgix.net/5521c6bd/uploads/origins/133125e4-48e4-4792-8241-2ac5a5c41383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d2b9696dac99fc2688fadacfd77c660 2x, https://si.imgix.net/5521c6bd/uploads/origins/133125e4-48e4-4792-8241-2ac5a5c41383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05fd4e9f03f9b95f9edbb52fee306864 3x", "genre": "art", "nsfw": false, "body": "またまたあるららさん、こんにちは！私のキャラクター、フレイアの新しい絵をあなたに依頼したいです。前回のフレイアの描き方がとても気に入りました！<3<3<3\n\nフレイアのビキニ・ビーチの絵をお願いしたいです。私はあなたのビキニの絵が大好きで大好きで、ぜひフレイヤの絵を見てみたいです。\n\n残りのデザインはあなたに任せます。芸術的な自由を存分に発揮してください。）\n\nもし可能なら、ビキニの生地はマリメッコのウニッコ柄でお願いできますか？配色はあなたが決めてください。\n\nこのアイデアを気に入ってもらえるとうれしいです！\n\nhttps://drive.google.com/drive/folders/1VHtMtR-5C8CcJSX6EFhqPzbZn4CWtTxW", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/96", "thumbnail_src": "https://si.imgix.net/f21f2209/uploads/origins/79bff447-fa07-4e35-badb-61c89f2159a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f09e2202e975bbc354ceb89f08b07f1", "thumbnail_srcset": "https://si.imgix.net/f21f2209/uploads/origins/79bff447-fa07-4e35-badb-61c89f2159a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f09e2202e975bbc354ceb89f08b07f1, https://si.imgix.net/f21f2209/uploads/origins/79bff447-fa07-4e35-badb-61c89f2159a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f00f1d3fae206b298241bf0a0fdf5e9 2x, https://si.imgix.net/f21f2209/uploads/origins/79bff447-fa07-4e35-badb-61c89f2159a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fea23a2c9edf95f30b3979777922c9c0 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\nいまVRChatで使ってるアバターのイラストを描いてほしいです（資料URL参照）\n最近スケボーギミックを使っているので、スケボーしてる姿とかだと嬉しいです。\nhttps://x.com/Kenomo_Vworker/status/1888645053901635774\n滑ってる最中であってもなくてもどちらでも良いです。\n\n参考までに、着てる服はこれです\nhttps://chiy00000ya.booth.pm/items/5476338\n\nhttps://drive.google.com/drive/folders/1qCHPpz0uBBAj-N2uO12ps7V18qpVLbb0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/95", "thumbnail_src": "https://si.imgix.net/c8c4bf2f/uploads/origins/60157a3f-5a8a-45b9-839f-394f93e11004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a5a10dc0e6817aaabd86c234939f28", "thumbnail_srcset": "https://si.imgix.net/c8c4bf2f/uploads/origins/60157a3f-5a8a-45b9-839f-394f93e11004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a5a10dc0e6817aaabd86c234939f28, https://si.imgix.net/c8c4bf2f/uploads/origins/60157a3f-5a8a-45b9-839f-394f93e11004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff7ac27c06380f1c304bdc6a00c66c40 2x, https://si.imgix.net/c8c4bf2f/uploads/origins/60157a3f-5a8a-45b9-839f-394f93e11004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d88c2f6e17151b6f60dd738f661c28fe 3x", "genre": "art", "nsfw": false, "body": "こんにちはあるうららさん\nいつも素敵なイラストに癒されてます。とくにソフィアちゃんとレト君が大大大好きです！\n今回はソファに座って本を読んでいるソフィアちゃんを描いていただきたいです。服装はベビードールを着せてほしいです。よろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/94", "thumbnail_src": "https://si.imgix.net/00ba967f/uploads/origins/2ace7104-f291-487c-87d7-7d104a68574c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdaf5369e5157d519831e0a61437cdb3", "thumbnail_srcset": "https://si.imgix.net/00ba967f/uploads/origins/2ace7104-f291-487c-87d7-7d104a68574c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdaf5369e5157d519831e0a61437cdb3, https://si.imgix.net/00ba967f/uploads/origins/2ace7104-f291-487c-87d7-7d104a68574c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=113233d9f543cb1eea81bb5ee642c883 2x, https://si.imgix.net/00ba967f/uploads/origins/2ace7104-f291-487c-87d7-7d104a68574c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c21e2275b6424cc1871b9dde2d133b10 3x", "genre": "art", "nsfw": false, "body": "いつもお疲れ様です。\n今回は「Five Nights at Freddy's Security Breach」の \"Glam Rock Roxy \"のファンアートを描いていただけませんか？\"\n公演を成功させた後、楽屋で楽しそうにくつろいでいるような、ファンからの愛を表すアイテムを持った、よりハッピーなバージョンのキャラクターを希望します。\nアニマトロニクス・ヴァージョンではなく、かわいいケモノ・キャラクターにするのも自由。\nポーズとしては、ソファに寝そべって飲み物を飲んだり、テーブルに足を乗せたり、鏡の前で屈伸したり、お好きなように。\nセッティングは彼女のドレッシングルームになるだろう。彼女のキャラクターと部屋の両方をゲームからいくつか参考にしたものを載せておいた。ゲームではかなり暗いので、部屋を明るくするのはご自由に。\n最後に、ウィンドウズのデスクトップ用壁紙のアスペクト比（16:9など）に合わせて画像をフォーマットしてください。\n\nhttps://imgur.com/a/q5UQJgH", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/93", "thumbnail_src": "https://si.imgix.net/2dcaace9/uploads/origins/8cc72814-515d-4f79-a612-071b72064594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a2d09843df5eff58dc22d3e5007f65", "thumbnail_srcset": "https://si.imgix.net/2dcaace9/uploads/origins/8cc72814-515d-4f79-a612-071b72064594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a2d09843df5eff58dc22d3e5007f65, https://si.imgix.net/2dcaace9/uploads/origins/8cc72814-515d-4f79-a612-071b72064594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=342511eab691d38b5d2102c0b30049e7 2x, https://si.imgix.net/2dcaace9/uploads/origins/8cc72814-515d-4f79-a612-071b72064594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9329cfae1440e4e300e95a68cae401c3 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Aruurara！フィンランドから来たあなたのゴージャスなアートの大ファンです。\n\n私のOCフレイヤの写真が欲しいです。彼女は大きな愛すべき高原牛のママです。あなたの絵が見たいわ。\n\nフレイアには日本の伝統的な着物を着て欲しい。彼女は華やかな桜の季節に外にいて、それを楽しんでいる。また、背景には古くて美しい日本の建築物を見てみたい。多分、彼女はお寺や神社にいるのでは？\n\nもしこの写真に合うなら、横長の2.35:1のアスペクト比にできますか？\n\n彼女の着物スタイル、ヘアスタイル、アクセサリー、その他もろもろのデザインはお任せします。着物の生地はマリメッコのウニッコを使いたいですね。生地の花のサイズと配色を選ぶことができます。公式の配色を選ぶか、より絵に合う新しい配色を作る！ウニッコの生地は、他の着物の生地にも使えます。\n\n他の部分はすべてあなたにデザインしてもらい、芸術的な自由を与えます！楽しんでください！<3\n\nhttps://drive.google.com/drive/folders/1a-Ac_nWFBStyl7y1uh2f00uaJE1_iz46?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/92", "thumbnail_src": "https://si.imgix.net/b8fce1f5/uploads/origins/7ea2968b-8cbd-49a5-b088-1a59ceca035d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56624aec72951edd223d4be639ed27dc", "thumbnail_srcset": "https://si.imgix.net/b8fce1f5/uploads/origins/7ea2968b-8cbd-49a5-b088-1a59ceca035d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56624aec72951edd223d4be639ed27dc, https://si.imgix.net/b8fce1f5/uploads/origins/7ea2968b-8cbd-49a5-b088-1a59ceca035d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b766caf4b5c2c8f8e1df3f946535f56 2x, https://si.imgix.net/b8fce1f5/uploads/origins/7ea2968b-8cbd-49a5-b088-1a59ceca035d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22a3c4439f62964912fd4b0bceb1e3d3 3x", "genre": "art", "nsfw": false, "body": "どうもあるうららさん\n最高に可愛いソフィアちゃんのイラストを1枚描いていただきたいです。テーマは「バニーガール」でお願いします。バニーガールの衣装は水色を基調としたデザインでお願いします。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/91", "thumbnail_src": "https://si.imgix.net/270a9e14/uploads/origins/5627b1e5-21bf-47eb-b157-57e167e7d1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863cf508e4b3a26c9ba694ef285cef8b", "thumbnail_srcset": "https://si.imgix.net/270a9e14/uploads/origins/5627b1e5-21bf-47eb-b157-57e167e7d1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863cf508e4b3a26c9ba694ef285cef8b, https://si.imgix.net/270a9e14/uploads/origins/5627b1e5-21bf-47eb-b157-57e167e7d1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b971e33742fcf6015d632b22b89c6b9 2x, https://si.imgix.net/270a9e14/uploads/origins/5627b1e5-21bf-47eb-b157-57e167e7d1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ee2bf2c7b81c9cc8b731845d30ae90d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！UNDERTALE』のトリエルが \"OL \"のような格好をしている絵を描いていただけませんか？\n彼女がお行儀の悪い複合機（コピー機）と戦っている／壊しているようなイメージで、コピー機が彼女のお尻（スカートの中）をスキャナーの上に座っているように撮影して、その結果できた画像のコピーを打ち出すのを止めようとしているような感じです。\n\nありがとう。ちょっとわかりにくかったらごめんなさい。\n(参考文献：https://imgur.com/a/kV3o0Y2)", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/90", "thumbnail_src": "https://si.imgix.net/73106da9/uploads/origins/3f1f8f8a-ff8f-43dd-8ef4-2d13109f16f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae256f8437b61fe9eff85c02a60ce09", "thumbnail_srcset": "https://si.imgix.net/73106da9/uploads/origins/3f1f8f8a-ff8f-43dd-8ef4-2d13109f16f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae256f8437b61fe9eff85c02a60ce09, https://si.imgix.net/73106da9/uploads/origins/3f1f8f8a-ff8f-43dd-8ef4-2d13109f16f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd2e68c272f4171d4b9f6fa62918b70c 2x, https://si.imgix.net/73106da9/uploads/origins/3f1f8f8a-ff8f-43dd-8ef4-2d13109f16f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45782bbfd0dda2506cf7dffb9113c8df 3x", "genre": "art", "nsfw": false, "body": "ビーチでのダイアンの写真のように、おちゃらけたポーズで彼女のアートを撮りたいね！\n\nhttps://drive.google.com/file/d/1bxjG9JXlXpvpBiyOZA6YZ1tXvQNMRyOO/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/89", "thumbnail_src": "https://si.imgix.net/ac52a2af/uploads/origins/a0d2571f-87ec-4339-916e-12f2e0f50334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08fd359f11a67ef46193cee7407711bd", "thumbnail_srcset": "https://si.imgix.net/ac52a2af/uploads/origins/a0d2571f-87ec-4339-916e-12f2e0f50334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08fd359f11a67ef46193cee7407711bd, https://si.imgix.net/ac52a2af/uploads/origins/a0d2571f-87ec-4339-916e-12f2e0f50334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40100a