ds/origins/ce7b7bd7-efc1-480e-acda-0e514b32da0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f1a0bece7f31fd8d78c0bfeffdb7df0, https://si.imgix.net/36cdffea/uploads/origins/ce7b7bd7-efc1-480e-acda-0e514b32da0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72b6cdf32e5e263f586cca58be9d71b5 2x, https://si.imgix.net/36cdffea/uploads/origins/ce7b7bd7-efc1-480e-acda-0e514b32da0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=583dbd5e903fd1b7b2fcc014dd26ec1a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/77", "thumbnail_src": "https://si.imgix.net/e38e3333/uploads/origins/b693572c-4bcf-47df-8b67-8f906b9a755a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4514cbcd1f67d9c6d95766c0f274cc7a", "thumbnail_srcset": "https://si.imgix.net/e38e3333/uploads/origins/b693572c-4bcf-47df-8b67-8f906b9a755a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4514cbcd1f67d9c6d95766c0f274cc7a, https://si.imgix.net/e38e3333/uploads/origins/b693572c-4bcf-47df-8b67-8f906b9a755a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a92425d8e7830cbdad9dba82a52a827c 2x, https://si.imgix.net/e38e3333/uploads/origins/b693572c-4bcf-47df-8b67-8f906b9a755a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f538a29ac48989c2019d44ef6f874892 3x", "genre": "art", "nsfw": false, "body": "クリスとスージーは屋外でピクニックをしていて、一緒に毛布の上に座っています。クリスとスージーは二人とも裸足で、足が触れ合っています。季節は春です。\n\nスージーはクリスを後ろから抱きしめ、クリスの後頭部の匂いを嗅いでいます。スージーはリンゴのことを考えています。クリスは顔を赤くして微笑んでいます。\n\nここに二人が一緒に座っている例があります。\n\nhttps://imgur.com/a/4tc6zjI", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/76", "thumbnail_src": "https://si.imgix.net/140f86cd/uploads/origins/d05e44f2-ecd4-4091-ab02-ccf2c8f22e15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aeed205781d734304227e3234905198", "thumbnail_srcset": "https://si.imgix.net/140f86cd/uploads/origins/d05e44f2-ecd4-4091-ab02-ccf2c8f22e15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aeed205781d734304227e3234905198, https://si.imgix.net/140f86cd/uploads/origins/d05e44f2-ecd4-4091-ab02-ccf2c8f22e15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4f7e4c2ddfd4a8778ce70643961cf66 2x, https://si.imgix.net/140f86cd/uploads/origins/d05e44f2-ecd4-4091-ab02-ccf2c8f22e15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcacb572953e7d3b3474c0eff652f85f 3x", "genre": "art", "nsfw": false, "body": "どうもあるうららさん！\n今回はウエディングドレス姿のソフィアちゃんとタキシード姿のレトリバー君を描いてほしいです...！よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/75", "thumbnail_src": "https://si.imgix.net/4bb475c5/uploads/origins/686f2a64-79cd-4527-947c-49b31bf0a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f0fc1878a6dcaa6893b9568d30a60c", "thumbnail_srcset": "https://si.imgix.net/4bb475c5/uploads/origins/686f2a64-79cd-4527-947c-49b31bf0a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f0fc1878a6dcaa6893b9568d30a60c, https://si.imgix.net/4bb475c5/uploads/origins/686f2a64-79cd-4527-947c-49b31bf0a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7e8663530af39bcbaee74d054c839a9 2x, https://si.imgix.net/4bb475c5/uploads/origins/686f2a64-79cd-4527-947c-49b31bf0a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=463f7746a728c9eb2476c1418bc0064f 3x", "genre": "art", "nsfw": false, "body": "あるらら先生、また私の虎を描いていただけたら光栄です。今回は、ファンタジーゲームのフィギュアとして描いて頂ければと思います。ダークな木製の台座の上に、参考資料と同じような四角い形をしています。ブロンズ製のサイコロも、彼女の周りに置いてください。照明や背景も暗くて幻想的な感じにしていただければ完璧です。ありがとうございました。\n\nhttps://sta.sh/250w0dm0n6b", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/74", "thumbnail_src": "https://si.imgix.net/cf84bf60/uploads/origins/6e23cd73-67a5-4b3e-bb9d-a18c992e16c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea0cb9670440e2d9210a62651aedc6ce", "thumbnail_srcset": "https://si.imgix.net/cf84bf60/uploads/origins/6e23cd73-67a5-4b3e-bb9d-a18c992e16c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea0cb9670440e2d9210a62651aedc6ce, https://si.imgix.net/cf84bf60/uploads/origins/6e23cd73-67a5-4b3e-bb9d-a18c992e16c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb83e17187f6724b367efc29563af3e5 2x, https://si.imgix.net/cf84bf60/uploads/origins/6e23cd73-67a5-4b3e-bb9d-a18c992e16c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27db6e9367363cb6294a72768d9366c1 3x", "genre": "art", "nsfw": false, "body": "あるさん、こんにちは。これらは私のOCです。それぞれウサギの人形と青い尻尾の妖精です。私はあなたが彼らが遊園地で遊んでいるところを描いてほしい。青い尻尾の妖精はウサギより小さいです。ウサギは可愛い形の風船を手に持ってほしいです。\nこれらは、参考文献です。\nhttps://www.pixiv.net/artworks/101774025\n\nhttps://www.pixiv.net/artworks/101773968\n\nhttps://twitter.com/kuo0/status/1576546712339914753\nお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aruurara/works/73", "thumbnail_src": "https://si.imgix.net/1bc45c8f/uploads/origins/469115a4-d143-4c3b-9369-b69daae6b111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99aa5f88ea4faea7f3d03687fd22a14c", "thumbnail_srcset": "https://si.imgix.net/1bc45c8f/uploads/origins/469115a4-d143-4c3b-9369-b69daae6b111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99aa5f88ea4faea7f3d03687fd22a14c, https://si.imgix.net/1bc45c8f/uploads/origins/469115a4-d143-4c3b-9369-b69daae6b111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=297783fb9f95de8fc676019509087251 2x, https://si.imgix.net/1bc45c8f/uploads/origins/469115a4-d143-4c3b-9369-b69daae6b111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfaa804bdf0a4872b8b2ec9f46b71b72 3x", "genre": "art", "nsfw": false, "body": "こんにちは。すいすいと申します。\nお忙しいなかで恐縮ですが、オリジナルキャラのイラストをリクエストしたいです。\nかいて欲しいのは、ぶち猫の女の子のラナです。\n（参考資料）https://www.pixiv.net/artworks/101017609\nけだるげでダウナー、つんつんしていてわがままな子です。\n一応ワルなジャーナリストという設定があります。絵の題材など迷ったら使っていただけたら幸いです。\n構図や雰囲気などはお任せします。よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}