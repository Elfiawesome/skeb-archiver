b0-c247-4673-94cd-2acfa5c367e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=217e85e045e83d7ec90d7e9330cc7d5d, https://si.imgix.net/31b1ff51/uploads/origins/6fff72b0-c247-4673-94cd-2acfa5c367e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07f2881a2faf648f340f96c0285a5f7d 2x, https://si.imgix.net/31b1ff51/uploads/origins/6fff72b0-c247-4673-94cd-2acfa5c367e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=660505e114ebcdf2803d8b608fa9b9c2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またまたお願いがあります。\n今回は魔法使いの約束のリコリスとファウストのカップルポートレートが欲しいです。具体的には、リコリスの誕生日が近いので、2023年の誕生日衣装でお願いしたいです。\nリコリスはファウストに対してかなり独占欲が強いのですが、本人はそれほど目立っていないつもりです。しかし、本人はそれほど意識していないようで、純粋にファウストを愛しています。ファウストは一人で抱え込むことが多く、呪いを得意とする魔法使いである。真面目だが、優しい人だ。リコリスとは何世紀もの付き合いなので、かなり気にかけている。\nパーティーのような、カジノのような明るい雰囲気にしたいです。ファウストカード.pngを参考にするとよいでしょう。具体的なポーズや表情はあなた次第です。参考までに身長比較も載せておきます。\nリコリスの主な参考資料も載せましたが、着ているものはOUTFIT_IDEAとOUTFIT_MAINでお願いします。ジュエリーがあれば。(チョーカーや指輪など）はゴールド。髪は編み込み\n\nhttps://drive.google.com/drive/folders/1dQGnUgQgl05a8OkDmqWAFo3QYEsvbIuL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@IzLiebe/works/8", "thumbnail_src": "https://si.imgix.net/a9a04c50/uploads/origins/ffa3012d-fa51-4abf-9048-438e04b2a2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32a2159f947dc77d622860dea22092f", "thumbnail_srcset": "https://si.imgix.net/a9a04c50/uploads/origins/ffa3012d-fa51-4abf-9048-438e04b2a2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32a2159f947dc77d622860dea22092f, https://si.imgix.net/a9a04c50/uploads/origins/ffa3012d-fa51-4abf-9048-438e04b2a2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9efba4434e7f1f62eadf701a2bcbd077 2x, https://si.imgix.net/a9a04c50/uploads/origins/ffa3012d-fa51-4abf-9048-438e04b2a2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04b632276db3177aafa62ae4dc1836ae 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターのアートをお願いしたいのですが、いかがでしょうか？\n\nアスタルテは、失恋を直す魔女です。彼女は169cmで、大人っぽい体つきをしています。ハートの模様が入ったピンクの服を好んで着ています。彼女の髪は、何箇所もハートにカールしています。\n\n笑顔が多く、ノリがいい。しかし、人からからかわれると、とても動揺してしまう。人を応援するのが好きだが、本人は自尊心が低い。\n\n背景やポーズはお任せします。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/107R-0M6HuFZwaI2sMHmUWBzl-Wt8ZQ4x", "created_at": "", "completed_at": ""}, {"path": "/@IzLiebe/works/7", "thumbnail_src": "https://si.imgix.net/106e5dc6/uploads/origins/0a13910a-52b1-45c2-b887-1c779e5c1f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a536030a2c5041195b728ab4e1c9771", "thumbnail_srcset": "https://si.imgix.net/106e5dc6/uploads/origins/0a13910a-52b1-45c2-b887-1c779e5c1f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a536030a2c5041195b728ab4e1c9771, https://si.imgix.net/106e5dc6/uploads/origins/0a13910a-52b1-45c2-b887-1c779e5c1f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03a5472997ae341648e477472f99986c 2x, https://si.imgix.net/106e5dc6/uploads/origins/0a13910a-52b1-45c2-b887-1c779e5c1f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e68186ce555a1fd668b9ebe2fee14ad 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が素敵なので、リクエストを送らせていただきます！アニメ「ブルーロック」のキャラクターと夢のカップルをお願いしたいです。\n\nこれは私のオリジナルキャラクター、イヴです。頑張り屋さんで、妹を支えたいと思っています。明るい性格だが、時に冷たい態度をとることもある。\n\nもう一人のキャラクターはカイザーという名前です。才能はあるがわがままな性格で、他の人からは意地悪な皇帝と呼ばれている。彼の青いバラのタトゥーにご注目ください！\n\nシンデレラと王子様のような、ロマンチックなおとぎ話のようなシーンにしたいです。衣装はリンク先に載せています。青いバラも入れてもらえるとありがたいです！ポーズ、表情、背景は自由に描いていただいて構いません。\n\n私の要望を考慮していただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/104e7IXPPO5EQkbookuzdUs-ukQw9Lv_7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@IzLiebe/works/6", "thumbnail_src": "https://si.imgix.net/028b8753/uploads/origins/1718723b-08bf-4b4a-bf04-cce47d1d7e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c85050a0d4e9697325884e670fd4956", "thumbnail_srcset": "https://si.imgix.net/028b8753/uploads/origins/1718723b-08bf-4b4a-bf04-cce47d1d7e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c85050a0d4e9697325884e670fd4956, https://si.imgix.net/028b8753/uploads/origins/1718723b-08bf-4b4a-bf04-cce47d1d7e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7945f3d8bc536edff0d1087d31903716 2x, https://si.imgix.net/028b8753/uploads/origins/1718723b-08bf-4b4a-bf04-cce47d1d7e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec960de00a5549699f74b403efe8bb6e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターを描いていただけませんか？彼女は大学生で、トリビアのエキスパートです。内向的な性格で、しばしば部外者のように感じられる。モチーフは、霧の朝、テープレコーダー、バス停、雑学、質問、1970年代ファッション、タロットなど。私が彼女を連想するタロットカードは \"月 \"です。そんな彼女と一緒に、これらの側面を取り入れた作品を描いていただけませんか？ポーズや表情にこだわりはありません。楽しんできてください！\n\nhttps://drive.google.com/drive/folders/1IKxIVKqLkROichp2POgAH7JOs3FwQ2lm?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@IzLiebe/works/5", "thumbnail_src": "https://si.imgix.net/16b79c83/uploads/origins/8679d411-d725-4674-b803-f7993203bfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1fcd12da9dbd0f5fb665dd6862401b", "thumbnail_srcset": "https://si.imgix.net/16b79c83/uploads/origins/8679d411-d725-4674-b803-f7993203bfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1fcd12da9dbd0f5fb665dd6862401b, https://si.imgix.net/16b79c83/uploads/origins/8679d411-d725-4674-b803-f7993203bfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a51af4feae15ecd523e945b72a7dadb 2x, https://si.imgix.net/16b79c83/uploads/origins/8679d411-d725-4674-b803-f7993203bfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e313a7c55b7faf5c30643ccf1928928 3x", "genre": "art", "nsfw": false, "body": "前回描いていただいたものがとても気に入ったので、2人分の作品をお願いしたいのですが、「魔法使いの約束」のアナヒータとミスラの作品です。\n\nアナヒタは、リンク先にあるドレス（上下）を着て描いてほしいということ以外は、同じです。彼女は胸が大きい。\n\nミスラは黒魔術を得意とする魔法使いで、とても疲れている人です。   \n\n作品は二人の結婚式ということで、ロマンチックでありながらゴシックな雰囲気にしたいです。\n二人のポーズを載せておきますが、二人は微笑み合っていることが望ましいですが、アナヒタが160cm、ミスラが187cmと身長差があるので注意してください。\n\n黒い蝶々も入れていただけると嬉しいです。\n\nありがとうございました!!!૮꒰ ˶- ༝ -˶꒱ა ♡\n\nアナヒタ： https://drive.google.com/drive/u/1/folders/1Xe0dmJGWtadcyouIg0dmKjnf1lI5hhKu\nミスラ: https://drive.google.com/drive/u/1/folders/1oK1fxamG2lB6I7CD0efD01ia13Pbu7SO\nポーズ: https://imgur.com/1claNxL", "created_at": "", "completed_at": ""}, {"path": "/@IzLiebe/works/4", "thumbnail_src": "https://si.imgix.net/23a07c08/uploads/origins/cf4b5ae0-645a-498a-b031-6ce2f5ee59ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510dc61ea39a5ebd529448fa2b8592cd", "thumbnail_srcset": "https://si.imgix.net/23a07c08/uploads/origins/cf4b5ae0-645a-498a-b031-6ce2f5ee59ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510dc61ea39a5ebd529448fa2b8592cd, https://si.imgix.net/23a07c08/uploads/origins/cf4b5ae0-645a-498a-b031-6ce2f5ee59ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=875fa4c86a6e277e0747389ae13daa33 2x, https://si.imgix.net/23a07c08/uploads/origins/cf4b5ae0-645a-498a-b031-6ce2f5ee59ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7591ceae25653682a2558bb48a59de6 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは!前回、私のためにしてくれた仕事と、私の友人Kaineのためにしてくれた仕事が大好きです。\n\n今回は、グランブルーファンタジーのニーアの衣装で、リコリスを描いてほしいです。具体的には、歌の衣装です。大まかな内容は前回のリクエストと同じです。できれば、ちょっと不気味な雰囲気でお願いします。それ以外の細かい部分はお任せします。\n\nあなたの作品が大好きなので、また一緒に仕事ができることを楽しみにしています。\n\nまた、参考としてライブの映像を添付しますので、衣装のイメージと合わせて使っていただけると幸いです。\nライブの様子：https://youtu.be/NepqYn7wSZA\nhttps://drive.google.com/drive/folders/1dYCNevBUjdCAIBSoqIeUsurJbL_WZg_V?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@IzLiebe/works/3", "thumbnail_src": "https://si.imgix.net/4323c37d/uploads/origins/42a94da6-8f31-4ee8-bd24-4747f6e227c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&