6327b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d05442074851adcf98487453e0230465, https://si.imgix.net/042ce894/uploads/origins/7187f7f4-7303-4c8a-8489-29ab4b6327b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=452a040143f5f1410aa1f804d28eeb79 2x, https://si.imgix.net/042ce894/uploads/origins/7187f7f4-7303-4c8a-8489-29ab4b6327b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ce3ee1ed8cb6ff0ad73cfbd99949df4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！株式に関するアートワークを2点お願いします。有名な「ストンクス」ミームです。「ストンクス」と「ノット・ストンクス」の2種類が必要です。例：https://drive.google.com/drive/folders/15kOLMoKLDzGFm311SmKreYHq5-_NK3IN これらのポーズは主にステッカーとして使用されます。\n誰かが良い投資や悪い投資をした時に使われます。「not stonks」の表情はパニック状態で、低品質でも構いません。背景には上向きまたは下向きの矢印を描いてください。例の画像に厳密に従う必要はありません。あくまで私のイメージを伝えるためのサンプルです。よろしくお願いします！\n\n参考: Sanu: https://drive.google.com/drive/folders/1tLcnvB3jQ0uS3zZuv3IstshOGOR8z2or", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/62", "thumbnail_src": "https://si.imgix.net/11a8e179/uploads/origins/9f6c6eea-108f-4a25-985b-09c2e9ebcb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c21b6fe562c27db4bc7fe70e91646efe", "thumbnail_srcset": "https://si.imgix.net/11a8e179/uploads/origins/9f6c6eea-108f-4a25-985b-09c2e9ebcb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c21b6fe562c27db4bc7fe70e91646efe, https://si.imgix.net/11a8e179/uploads/origins/9f6c6eea-108f-4a25-985b-09c2e9ebcb40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76a25ddf25e3b72d9b1135c847196c88 2x, https://si.imgix.net/11a8e179/uploads/origins/9f6c6eea-108f-4a25-985b-09c2e9ebcb40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75dccfa64ea1a7093238d9114bd7e26d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！あなたの作品がとっても可愛くて生き生きしていて大好きです。私のイチゴザンゴースを描いていただけませんか？https://toyhou.se/25803965.ichigo/gallery 彼女はとても不器用なんです！衣装を着せた状態でも、脱いだ状態でもどちらでも構いません。お時間をいただきありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/61", "thumbnail_src": "https://si.imgix.net/96e1fbf2/uploads/origins/71447080-aea7-41bf-9f1d-3804d1e148b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7017ea61c13b0f280a3981e802d957", "thumbnail_srcset": "https://si.imgix.net/96e1fbf2/uploads/origins/71447080-aea7-41bf-9f1d-3804d1e148b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7017ea61c13b0f280a3981e802d957, https://si.imgix.net/96e1fbf2/uploads/origins/71447080-aea7-41bf-9f1d-3804d1e148b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28f36517cb75201cf9bf62bfd9bc5f3a 2x, https://si.imgix.net/96e1fbf2/uploads/origins/71447080-aea7-41bf-9f1d-3804d1e148b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=531925b9eaea835adca1f1a3c99c4977 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのスタイルがとても気に入ったので、私のキャラクターを描いていただきたいです。彼は可愛くて元気いっぱいな猫とキツネのハイブリッドです姿勢はあなた次第です。\n\n参照する：https://drive.google.com/file/d/1ZTd0mMz6dyTdaieBGz3_sqzk7-Vy_GCd/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/60", "thumbnail_src": "https://si.imgix.net/bb664f58/uploads/origins/0ee00aa3-1bd7-477d-b50d-520604360954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb1de1d51f15e76c5162ef0fcd773713", "thumbnail_srcset": "https://si.imgix.net/bb664f58/uploads/origins/0ee00aa3-1bd7-477d-b50d-520604360954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb1de1d51f15e76c5162ef0fcd773713, https://si.imgix.net/bb664f58/uploads/origins/0ee00aa3-1bd7-477d-b50d-520604360954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4b047caade16109d2f4dacb2b221f1a 2x, https://si.imgix.net/bb664f58/uploads/origins/0ee00aa3-1bd7-477d-b50d-520604360954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fba6faaeb259bbb8f716080426e42faf 3x", "genre": "art", "nsfw": false, "body": "ふーさんこんにちは！\n先生の絵がとても好きです!\nもし可能でしたら、私のキャラクターも描いていただけないでしょうか？\n---\n数枚のスタンプ用イラストをお願いしたいです。\nそのうちの一枚は、何かを食べているシーンだと嬉しいです。\n他の内容については、先生のご自由な発想にお任せします。\n\n枚数も先生にお任せいたします。\n---\n参考リンクは私のキャラクターです。\n本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1AdVy-qx2lEO0dPV0O2LpeEGiqjJCX0vS?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/59", "thumbnail_src": "https://si.imgix.net/2910bc30/uploads/origins/7d57b737-6ce7-491d-810c-9d26eb7f33b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1a2148aba158f02bf36c99b46150ae", "thumbnail_srcset": "https://si.imgix.net/2910bc30/uploads/origins/7d57b737-6ce7-491d-810c-9d26eb7f33b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1a2148aba158f02bf36c99b46150ae, https://si.imgix.net/2910bc30/uploads/origins/7d57b737-6ce7-491d-810c-9d26eb7f33b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57bb4901e424610ee3ddf8631d351565 2x, https://si.imgix.net/2910bc30/uploads/origins/7d57b737-6ce7-491d-810c-9d26eb7f33b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb239e22379bc4514fc786c6c4363f3c 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nふーさんの素敵な絵柄に興味を惹かれ、リクエストさせていただきました！\nもしよろしければ、\nうちのこのスコンくんをお願いします！\n\nhttps://x.com/sannatu67/status/1884912750381670637?s=46&t=L6hX_qoK9lN2eJ5WRI8Rjg", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/58", "thumbnail_src": "https://si.imgix.net/333771a0/uploads/origins/cadf540a-a7aa-4c8b-9e32-012ed8baf46c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=912c76b55978ca0fd895dd547b360181", "thumbnail_srcset": "https://si.imgix.net/333771a0/uploads/origins/cadf540a-a7aa-4c8b-9e32-012ed8baf46c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=912c76b55978ca0fd895dd547b360181, https://si.imgix.net/333771a0/uploads/origins/cadf540a-a7aa-4c8b-9e32-012ed8baf46c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3edcc4d5a9c5a00b76a98f1668b557c 2x, https://si.imgix.net/333771a0/uploads/origins/cadf540a-a7aa-4c8b-9e32-012ed8baf46c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98e39f64c6a36a12604aa03969587aae 3x", "genre": "art", "nsfw": false, "body": "またこんにちは！小さな泣き顔のイラストをリクエストしたいです。例えばこちら：https://drive.google.com/drive/folders/1eMYrmOTGjtH4TqgJkBBeI4jU-6ZlyTse このイラストは主にスタンプとして使用されるので、あまり細かく描かないでください。\n\n参考画像はあくまでイメージです。厳密に再現する必要はありません。よろしくお願いします。参考：Sanu: https://drive.google.com/drive/folders/1tLcnvB3jQ0uS3zZuv3IstshOGOR8z2or", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/57", "thumbnail_src": "https://si.imgix.net/5770d4c3/uploads/origins/638d076e-419c-4aa3-b36b-ae447e78e6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f0e792c126ccfb7cf7d947054504249", "thumbnail_srcset": "https://si.imgix.net/5770d4c3/uploads/origins/638d076e-419c-4aa3-b36b-ae447e78e6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f0e792c126ccfb7cf7d947054504249, https://si.imgix.net/5770d4c3/uploads/origins/638d076e-419c-4aa3-b36b-ae447e78e6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48b4e157a6d54aaa856d33775374f1ea 2x, https://si.imgix.net/5770d4c3/uploads/origins/638d076e-419c-4aa3-b36b-ae447e78e6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66b9fd7338c1e71f9b23ae45475a1ca5 3x", "genre": "art", "nsfw": false, "body": "ふさん、こんにちは。また私です。私のオリジナルキャラクター（OC）のイラストを数点お願いしたいです。特定のテーマはありません。どんな感情でも自由に描いてください。この価格なら妥当だと思う枚数を描いていただいて結構です。\n\nhttps://drive.google.com/file/d/1wJuDz3i0wjkChEu4XhohT50Jv88aG_kC/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/56", "thumbnail_src": "https://si.imgix.net/752aa30f/uploads/origins/bf12d854-dd5a-4c31-b5be-693f3aa6e6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27fe263919f848a2af5a1ec5d39422a", "thumbnail_srcset": "https://si.imgix.net/752aa30f/uploads/origins/bf12d854-dd5a-4c31-b5be-693f3aa6e6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27fe263919f848a2af5a1ec5d39422a, https://si.imgix.net/752aa30f/uploads/origins/bf12d854-dd5a-4c31-b5be-693f3aa6e6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8f2d64547a69ac8772cf2bc7a5e3410 2x, https://si.imgix.net/752aa30f/uploads/origins/bf12d854-dd5a-4c31-b5be-693f3aa6e6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3137104ac60ef4eef714f799cbcea52 3x", "genre": "art", "nsfw": false, "body": "こんにちは、このポーズの制作を依頼したいです。BKが床の何かをじっと見つめているように見え、非常に興味深そうなV字型の笑顔を浮かべている様子を描いてください。目は参考画像sanushock.pngのものに似せてください。ただし、より強い興味を表現するため瞳孔を大きく描いてください。口元はcapohappy.pngのようなV字型の笑顔にしてください。\n\nキャラクター参考画像はoc.pngとglasses.pngです。https://drive.google.com/drive/folders/18jFoDt5gef4yoOI8_PAUrPtPCgHvX-d2", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/55", "thumbnail_src": "https://si.imgix.net/f09a2a82/uploads/origins/d270b05c-e49e-4c6b-b1a1-1e72efca598a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27f97bb7a6f45eb20e3ff38a38f01531", "thumbnail_srcset": "https://si.imgix.net/f09a2a82/uploads/origins/d270b05c-e49e-4c6b-b1a1-1e72efca598a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27f97bb7a6f45eb20e3ff38a38f01531, https://si.imgix.net/f09a2a82/uploads/origins/d270b05c-e49e-4c6b-b1a1-1e72efca598a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74103c2aa714d3d01eb452df2b756ca 2x, https://si.imgix.net/f09a2a82/uploads/origins/d270b05c-e49e-4c6b-b1a1-1e72efca598a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e55dbd8c97ea44697bb60f6da94f7935 3x", "genre": "art", "nsfw": false, "body": "こんにちは、このポーズの制作を依頼したいです。BKを、donishock.ongさんのスタイルに似た、驚きとパニックの表情、そして瞳孔が拡大した状態で描いてください。キャラクターの参考画像はoc.pngとglasses.pngです。https://drive.google.com/drive/folders/1_VHccHenk1dLatb-KYthOEIf4FOwdFnp", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/54", "thumbnail_src": "https://si.imgix.net/2e28b61c/uploads/origins/135794c4-4ae2-47a4-8a89-8636dae4f28e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7edb409487c2b90ceb5c2af2b69d385a", "thumbnail_srcset": "https://si.imgix.net/2e28b61c/uploads/origins/135794c4-4ae2-47a4-8a89-8636dae4f28e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7edb409487c2b90ceb5c2af2b69d385a, https://si.imgix.net/2e28b61c/uploads/origins/135794c4-4ae2-47a4-8a89-8636dae4f28e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f2d04f18444b0fab2b9737bd5083a36 2x, https://si.imgix.net/2e28b61c/uploads/origins/135794c4-4ae2-47a4-8a89-8636dae4f28e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=395292fadc156ae47cc01621ef6da1da 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ステッカーを2種類お願いしたいです。参考はこちらです。https://drive.google.com/file/d/1zQvX-dUM1VhAn3sU96RRr3ZXmOqV7VL0/view?usp=drivesdk よろしくお願いします！\n\nhttps://drive.google.com/file/d/1BzrjMUfBhiYt8BMAmj-pcQsA-QkQCkcg/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@hatimitu_v/works/53", "thumbnail_src": "https://si.imgix.net/6a02be73/uploads/origins/2d02113a-c93c-4077-8173-b6db0acf437d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f34c3adf7dd4f47bba6236dc573b908", "thumbnail_srcset": "https://si.imgix.net/6a02be73/uploads/origins/2d02113a-c93c-4077-8173-b6db0acf437d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f34c3adf7dd4f47bba6236dc573b908, https://si.imgix.net/6a02be73/uploads/origins/2d02113a-c93c-4077-8173-b6db0acf437d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a961fac07b3952b640c4d5