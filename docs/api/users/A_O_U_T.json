er&txtsize=30&txt=PRIVATE&s=13dbc3acb4e6e6b3ed848a14b49fa056 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@A_O_U_T/works/10", "thumbnail_src": "https://si.imgix.net/a5bcfe38/uploads/origins/4a2719e6-1393-44c9-8e9a-726680b4501c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09be66a2f4e94e23f031a59c5d31dfeb", "thumbnail_srcset": "https://si.imgix.net/a5bcfe38/uploads/origins/4a2719e6-1393-44c9-8e9a-726680b4501c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09be66a2f4e94e23f031a59c5d31dfeb, https://si.imgix.net/a5bcfe38/uploads/origins/4a2719e6-1393-44c9-8e9a-726680b4501c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb50156b707dcf52d3ba18de5ce739f2 2x, https://si.imgix.net/a5bcfe38/uploads/origins/4a2719e6-1393-44c9-8e9a-726680b4501c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd30028c59925902bb4824bf04f8878d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@A_O_U_T/works/9", "thumbnail_src": "https://si.imgix.net/e1a60cdb/uploads/origins/01ef440f-d855-4270-94cb-554e27596074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcaa3ae474054965ae8d5eae92be410f", "thumbnail_srcset": "https://si.imgix.net/e1a60cdb/uploads/origins/01ef440f-d855-4270-94cb-554e27596074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcaa3ae474054965ae8d5eae92be410f, https://si.imgix.net/e1a60cdb/uploads/origins/01ef440f-d855-4270-94cb-554e27596074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=904f62fb3fe542a15d0290afbdca8357 2x, https://si.imgix.net/e1a60cdb/uploads/origins/01ef440f-d855-4270-94cb-554e27596074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39a302782032596fd57673a68975a30e 3x", "genre": "art", "nsfw": false, "body": "ウッス！\nブルーリフレクション燦の安住菜々花と森崎アレシア優のアイドルグループ「ナナシア」がステージで踊ってる場面の絵が欲しいッス！\n\n観客にきららや詩帆や愛央詩がいるのも良いと思うんですけど、こちらは難しいとか手間がかかるなら描かなくても大丈夫です。\n\nアイドル衣装はナナシアのフラグカードの衣装でも良いですし、兄貴が考えたオリジナルの衣装でも、好きなように描いてくれよな〜頼むよ〜。\n\n\nまま、ステージで踊ってるナナシアを描いてもらえれば、あとはどんなのでも問題無いです。\n兄貴に任せるぜ！\n\nよろしくオナシャス！", "created_at": "", "completed_at": ""}, {"path": "/@A_O_U_T/works/8", "thumbnail_src": "https://si.imgix.net/aecac23e/uploads/origins/b7638114-dde8-4771-aa54-d5d2061cdd91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa113be947d2b911f291da7a07147f6", "thumbnail_srcset": "https://si.imgix.net/aecac23e/uploads/origins/b7638114-dde8-4771-aa54-d5d2061cdd91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa113be947d2b911f291da7a07147f6, https://si.imgix.net/aecac23e/uploads/origins/b7638114-dde8-4771-aa54-d5d2061cdd91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a221b30a2d361c15615ab091da6b9952 2x, https://si.imgix.net/aecac23e/uploads/origins/b7638114-dde8-4771-aa54-d5d2061cdd91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4d0b9fe88daeef5ffa548c4aecbcf1b 3x", "genre": "art", "nsfw": true, "body": "モブ子が美弦の股の間の割れ目に指を入れる。\n　くちゅりと水音を立てて、指が膣内へと埋まっていく。\n　連日の行為の所為で、身体はすっかりモブ子の愛撫に感じるようになっていた。\n　\n美弦「んんっ…！」\nモブ子「もう濡れてるねw期待してたの？」\n美弦「そんな訳無いわ…！あなたのせいで…！」\nモブ子「私の『せい』？私のおかげで気持ちよくなれてるんでしょ？」\n美弦「私は別にそんなの求めて……ふぁっ！♡」\nモブ子「アハハ♪甘い声が出てる。本当に美弦さんって可愛い♡」\n\n　美弦は下半身からの甘い痺れに耐えているが、モブ子の指がとある一点を擦り上げると、途端に激しく身体を痙攣させる。\n\n美弦「はぁぁぁっ……！」\nモブ子「美弦さんってココ弱いんだよね〜♪」\n\n〜〜〜〜\n\nこの平原美弦がモブの女の子にレズレ◯プされているシーンの絵を描いてください！オナシャス！\n\n場面としてはモブの女の子が美弦をホテルに呼び出して、ベッドの上で美弦が仰向けになっている感じです。\n\n美弦もモブの女の子も全裸です！\nモブの子の容姿は兄貴の好きなように描いていただいて大丈夫です！", "created_at": "", "completed_at": ""}, {"path": "/@A_O_U_T/works/7", "thumbnail_src": "https://si.imgix.net/de3c950b/uploads/origins/a324e223-0af3-49c7-a774-68fc2b268288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3e4ba9e0df0b4eb983facf2e89cf1b8", "thumbnail_srcset": "https://si.imgix.net/de3c950b/uploads/origins/a324e223-0af3-49c7-a774-68fc2b268288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3e4ba9e0df0b4eb983facf2e89cf1b8, https://si.imgix.net/de3c950b/uploads/origins/a324e223-0af3-49c7-a774-68fc2b268288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93c7f4681b1491c3a4bb81d798757987 2x, https://si.imgix.net/de3c950b/uploads/origins/a324e223-0af3-49c7-a774-68fc2b268288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da6196bdf995a34ac1d3a6b229d84fb8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@A_O_U_T/works/6", "thumbnail_src": "https://si.imgix.net/0794f060/uploads/origins/31ef4657-9c9f-4bf9-bb2f-b56de618f10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb928f9ed73d4eab715e0dea46f57fea", "thumbnail_srcset": "https://si.imgix.net/0794f060/uploads/origins/31ef4657-9c9f-4bf9-bb2f-b56de618f10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb928f9ed73d4e