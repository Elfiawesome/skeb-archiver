t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e75b608cd9c9b3558bce01d1d43ae52d 2x, https://si.imgix.net/1ef354ec/uploads/origins/4cdccd70-07f0-475c-99f7-55023fc0c103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ef20cd9c983e8a4258e851ccf624ce9 3x", "genre": "comic", "nsfw": true, "body": "はじめまして、作酸アメさんの濃厚なえっちイラストに大変お世話になっております……！  以下のような内容でイラストをリクエストしたく、よろしくお願いします！   \n・キャラクターとシチュエーション  \nもんむすくえすとのファーコートを着ている状態のクィーンエヴァが、 竿役の白念くんを尻コキで射精させたり、椅子に裸体の状態対面座位で覆い被さり抱きしめながら一日中、逆レイプしたりしている 絵をお願いします。\nできればこの時終始、エヴァは、地雷系女子が着ているようなフサフサの地雷系ファーコートを着ている感じでお願いします。\nクィーンエヴァ\nhttps://x.com/koakuma623/status/1856397784762724588/photo/1\n白念\nhttps://x.com/Missile101023/status/1276637911169896448/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/14", "thumbnail_src": "https://si.imgix.net/fb76ba0d/uploads/origins/f99fd9ff-8dfb-4ad3-8752-55664c45f2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c148f219e11f4429ccc1f6f8549770", "thumbnail_srcset": "https://si.imgix.net/fb76ba0d/uploads/origins/f99fd9ff-8dfb-4ad3-8752-55664c45f2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c148f219e11f4429ccc1f6f8549770, https://si.imgix.net/fb76ba0d/uploads/origins/f99fd9ff-8dfb-4ad3-8752-55664c45f2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4da677cd8624665094abe3a45b1f7848 2x, https://si.imgix.net/fb76ba0d/uploads/origins/f99fd9ff-8dfb-4ad3-8752-55664c45f2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71236475f714da90395d5023a479aee3 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ゲーム「SHRIFT」の大地のイラストをお願いしたいです！ポーズは問いません！\n\nhttps://x.com/yami_toubatuki/status/1267802058205216769?t=kvubR_cqPFPD0M0DCczZQg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/13", "thumbnail_src": "https://si.imgix.net/2d2c420b/uploads/origins/e2dd4902-c865-4f7d-803d-ab57acabd224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9ec50eef0f7465660b47a81ab22190", "thumbnail_srcset": "https://si.imgix.net/2d2c420b/uploads/origins/e2dd4902-c865-4f7d-803d-ab57acabd224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9ec50eef0f7465660b47a81ab22190, https://si.imgix.net/2d2c420b/uploads/origins/e2dd4902-c865-4f7d-803d-ab57acabd224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dff18bf4f7d82a0cae44dfe9cf589558 2x, https://si.imgix.net/2d2c420b/uploads/origins/e2dd4902-c865-4f7d-803d-ab57acabd224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a846ef265506abd422cd48c52cb8a617 3x", "genre": "comic", "nsfw": true, "body": "再びこんにちは。\nモン娘クエストのタマモとルカの漫画をお願いしたいです。\n\nシナリオは続編です。細かいことはお任せします。プロットは自由です。\n\n玉藻\nhttps://catbox.moe/c/ejxeqq\nルカ\nhttps://catbox.moe/c/xxzf93\n\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/12", "thumbnail_src": "https://si.imgix.net/6c827c7d/uploads/origins/bef03d17-b517-4a37-8e82-9e274cc878a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a335953a98e795998d96004f509590f", "thumbnail_srcset": "https://si.imgix.net/6c827c7d/uploads/origins/bef03d17-b517-4a37-8e82-9e274cc878a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a335953a98e795998d96004f509590f, https://si.imgix.net/6c827c7d/uploads/origins/bef03d17-b517-4a37-8e82-9e274cc878a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e8a3e7b3aa01c1c68d2081da87365b8 2x, https://si.imgix.net/6c827c7d/uploads/origins/bef03d17-b517-4a37-8e82-9e274cc878a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cea725ab8c126346fe86b830f4fc5f03 3x", "genre": "comic", "nsfw": true, "body": "プリコネミソラのスパンキング、特に手袋の描写に大変興奮しましたので、手袋メインで再度依頼させていただきます！\n\n・ミソラの膝の上でひっくり返されて仰向けにされる騎士君（騎士さん）\n・出し尽くして萎えてしまったおちんちんを片手で全体を握られ、もう片方の掌を亀頭に乗せる\n・その状態で激しく扱かれ、掌で亀頭を擦り潰す勢いで亀頭責めされる\n・硬い手袋の皺がおちんちんや亀頭に引っ掛かり、ミソラの膝の上で腰を浮かして泣き喚く騎士くん\n・ミソラは相変わらず楽しそうにお仕置き（拷問）を続ける\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/11", "thumbnail_src": "https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70402d1845db3413da4bdecfc937a3d8", "thumbnail_srcset": "https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70402d1845db3413da4bdecfc937a3d8, https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4d87dd50a8dda1741c70b0e73ee7473 2x, https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37081668c112e2bdfd85b6a09dc1775d 3x", "genre": "art", "nsfw": true, "body": "はじめまして、作酸アメさんの濃厚なえっちイラストに大変お世話になっております……！ \n以下のような内容でイラストをリクエストしたく、よろしくお願いします！  \n\n◯キャラクターとシチュエーション \nもんむすくえすとのマキュバスが、 竿役のモブ少年に覆い被さり、濃厚なディープキスでエナジードレイン＋搾精しているイラスト\n\n◯詳細（予算の許す範囲でお願いします）\n・構図のイメージは、空崎ヒナのキスドレインの1枚目右のような横からの構図でお願いします。\n　（こちらではヒナの方が低身長だったので下からのキスになっていますが、今回はマキュバスの方を高身長にして上からのキスにしてください。）\nhttps://skeb.jp/@tank1000ml/works/9\n\n・イラスト全体の雰囲気は、エヴァのように暗めの感じでお願いします。\nhttps://skeb.jp/@tank1000ml/works/3\n\n・マキュバスは全身が大量の精液まみれでドロドロになっていて欲しいです。可能であればディープキス中の口内も、他の男から搾り取った精液でいっぱいだと嬉しいです。また、胸は原作より大きめでお願いします。\n\n・竿役はルカではない貧相なモブ少年(ショタ寄り)のイメージであることが分かれば、詳細な描写は必要ありません。\n\nご多忙の中で細かい希望が多く恐縮ですが、可能な範囲で何卒ご一考いただけますと幸いです。 よろしくお願いいたします……！", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/10", "thumbnail_src": "https://si.imgix.net/06017d1d/uploads/origins/6a958bd2-d1f8-4e78-825d-5847dea8b0df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f950dfb327df107f6971a646bb15e9e", "thumbnail_srcset": "https://si.imgix.net/06017d1d/uploads/origins/6a958bd2-d1f8-4e78-825d-5847dea8b0df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f950dfb327df107f6971a646bb15e9e, https://si.imgix.net/06017d1d/uploads/origins/6a958bd2-d1f8-4e78-825d-5847dea8b0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40809b8d355b9f5ceaecd08d22cf2fce 2x, https://si.imgix.net/06017d1d/uploads/origins/6a958bd2-d1f8-4e78-825d-5847dea8b0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=702dd477033b659a8cfb0a762f84ccc2 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n\n情報部の調査で、アコのおっぱいに負けまくってることバレた先生が\nサツキに万魔殿に忠誠誓えパイズリされるシチュを描いてもらえないでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/9", "thumbnail_src": "https://si.imgix.net/dcda8472/uploads/origins/3784e92d-1393-4899-a860-2852efd07a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad99044f71c36ba7a1e002090fd50d7", "thumbnail_srcset": "https://si.imgix.net/dcda8472/uploads/origins/3784e92d-1393-4899-a860-2852efd07a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad99044f71c36ba7a1e002090fd50d7, https://si.imgix.net/dcda8472/uploads/origins/3784e92d-1393-4899-a860-2852efd07a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63e84eaaf9903a658226ad6e5cd3c5d4 2x, https://si.imgix.net/dcda8472/uploads/origins/3784e92d-1393-4899-a860-2852efd07a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad8d5cbf65c8fa0c6952d5780e40f711 3x", "genre": "comic", "nsfw": true, "body": "作酸アメ様へ\n作酸アメ様の絵を拝見し依頼したく思いリクエストを送らせて頂きました\n以下に内容を記載しますので確認お願い致します\n\n・キャラクター\nブルーアーカイブ登場キャラ「空崎ヒナ」\n衣装は通常の軍服風制服でお願いします\n体が成長したイメージで、身長160前後、100超-55程-80後半くらいに盛って翼も大きめにしてください\n\n同「先生」\n身長170後半くらいのしっかり鍛えられているイメージでお願いします\n\n・シチュエーション\n大人ヒナが先生をエナジードレインしている感じで徹底的に搾り尽くすシチュをお願いします。\n\n1、片手で軽々先生の両手を押さえ付けて壁際に追い詰め、キスをだけで先生を大量射精させる場面\n先生は腰砕けで足ガクガク状態\nヒナは余裕綽々な感じでで先生を味わっている\n\n2、両手を恋人繋ぎしながらのぺたん座り騎乗位を斜めもしくは横からの構図で。\nヒナは動かない状態で、挿入しているだけで先生は過剰な快楽で蕩けながら痙攣し大量射精する場面\nヒナは汗1つ無く優しげな微笑みで先生を見下ろしている\n\n以上をお願いします。\nお忙しい中恐れ入りますが検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/8", "thumbnail_src": "https://si.imgix.net/0b49c95f/uploads/origins/fc156283-8f8e-433b-b349-f4ed67297d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=016c02ee7de2755f76b103891c6a7648", "thumbnail_srcset": "https://si.imgix.net/0b49c95f/uploads/origins/fc156283-8f8e-433b-b349-f4ed67297d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=016c02ee7de2755f76b103891c6a7648, https://si.imgix.net/0b49c95f/uploads/origins/fc156283-8f8e-433b-b349-f4ed67297d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1b99d914b7444625274c1e7c6da0e8b 2x, https://si.imgix.net/0b49c95f/uploads/origins/fc156283-8f8e-433b-b349-f4ed67297d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1507f4145bb8619c00c7a01223101dad 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、はじめまして。\nモン娘クエストのタマモとルカの漫画をお願いしたいです。\n\nシナリオは、タマモが夜ルカのベッドに忍び込み、たくさんのキツネのしっぽでルカの体を拘束するというものです。\n\nタマモはルカを嘲笑し、からかったり、尻尾でルカのチンコを弄んだりする。\n\nルカをイカせた後、タマモはルカに馬乗りになり、一晩中レイプする。\n\n朝、疲れ果てたルカと寄り添う全裸で眠っているタマモをアリス16世が歩いているシーンを入れてください。\n\nタマモ\nhttps://catbox.moe/c/ejxeqq\nアリス\nhttps://catbox.moe/c/6nvtxk\nルカ\nhttps://catbox.moe/c/xxzf93\n\n詳細はご自由に変更してください。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tank1000ml/works/7", "thumbnail_src": "https://si.imgix.net/922b1791/uploads/origins/87293bbd-f946-4710-8197-14c8574cbd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0a433f616e738f9daed50e035cd1787", "thumbnail_srcset": "https://si.imgix.net/922b1791/uploads/origins/87293bbd-f946-4710-8197-14c8574cbd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bol