れた地下室のような感じで、詳細の設定はお任せします。\n\n相手側の男達の人数と体型は「構図」の画像と同じ感じで、その他の設定はお任せします。\n\n可能であれば演出字幕と音声字幕もお願いします。\n\nリクエストは以上でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@manamin2023/works/21", "thumbnail_src": "https://si.imgix.net/c1bc9acf/uploads/origins/07e15ffc-d6a5-4c0e-bc04-25f8ce42f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19fa421a219b0c6198e9b0bca5ea96a5", "thumbnail_srcset": "https://si.imgix.net/c1bc9acf/uploads/origins/07e15ffc-d6a5-4c0e-bc04-25f8ce42f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19fa421a219b0c6198e9b0bca5ea96a5, https://si.imgix.net/c1bc9acf/uploads/origins/07e15ffc-d6a5-4c0e-bc04-25f8ce42f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2698cbc1925a22966c62a36f8c6dadb9 2x, https://si.imgix.net/c1bc9acf/uploads/origins/07e15ffc-d6a5-4c0e-bc04-25f8ce42f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a91ec5d328902f3551c030c0beea015 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@manamin2023/works/20", "thumbnail_src": "https://si.imgix.net/64186966/uploads/origins/0bac47ba-1944-4a48-b1be-f6b39ce6ba98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1120abf6d1774c41a0aa2f0c20bd33d", "thumbnail_srcset": "https://si.imgix.net/64186966/uploads/origins/0bac47ba-1944-4a48-b1be-f6b39ce6ba98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1120abf6d1774c41a0aa2f0c20bd33d, https://si.imgix.net/64186966/uploads/origins/0bac47ba-1944-4a48-b1be-f6b39ce