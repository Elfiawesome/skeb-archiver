ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=214ef405a72e9d2f697177a5da4010b1 2x, https://si.imgix.net/2cf0dfc6/uploads/origins/575b6bd5-7db1-416f-a8f7-2b57ad10bcfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c07ad4660f492d0a2401a751544bcdf6 3x", "genre": "art", "nsfw": false, "body": "中将康次様\n\n中将様の創作であるレイラインをこえたむこうに、の美しい世界観や魅力的なキャラクター達のイラストをいつも楽しみに拝見しています！\nまた、作画を担当していらっしゃるカノンレディの連載開始もおめでとうございます！\n私が敬愛しております中将様に今回、はじめてskebを送らせていただきます。\n\n内容は、私のうちの子である女帝陛下が側近の重力騎士を伴って、中将さんのオリキャラである皇帝ちゃんことアンネローゼ陛下と\"お茶会\"と題した首脳会談をしているというイラストをお願いします。\n\n女帝陛下\nhttps://www.pixiv.net/artworks/97759532\n\nhttps://www.pixiv.net/novel/show.php?id=17432064\n\n重力騎士\nhttps://www.pixiv.net/artworks/97759491\n\nhttps://www.pixiv.net/novel/show.php?id=17432061\n\n神聖ツァルヴェルト帝国\nhttps://www.pixiv.net/novel/show.php?id=22241634\n\n会談の会場は、映画ハ○ルの動く城に登場するガラス張り天井の温室のような植物園。\nテーブルの上には紅茶が注がれたカップと、お菓子を乗せたがケーキスタンドが並んでいます。\nアンネローゼ陛下の随行員として、近衛メイド長さんが彼女の側に控えていると嬉しいです。\n\nこの会談は、アンナがアンネローゼ陛下と個人的な親睦を深めたくて設けたプライベートなものです。なのでアンナは基本的には穏やかな笑顔で、アンネローゼ陛下にいろいろ質問したりとかしています。アンネローゼ陛下がどんな態度で会談に臨んでいるかはお任せします！\n\n以上になります。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/18", "thumbnail_src": "https://si.imgix.net/480061c2/uploads/origins/cf1a5472-88b6-4f31-8b4e-5b20144c3189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06efc81404a3f160dcbd1a00efdcb8a0", "thumbnail_srcset": "https://si.imgix.net/480061c2/uploads/origins/cf1a5472-88b6-4f31-8b4e-5b20144c3189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06efc81404a3f160dcbd1a00efdcb8a0, https://si.imgix.net/480061c2/uploads/origins/cf1a5472-88b6-4f31-8b4e-5b20144c3189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22f90c2228ab7474826c6df3db17453e 2x, https://si.imgix.net/480061c2/uploads/origins/cf1a5472-88b6-4f31-8b4e-5b20144c3189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=068d7e0d35ed936fe61136882cd8b30b 3x", "genre": "art", "nsfw": false, "body": "いつもTwitterではお世話になっております\n\n現制Twitterアイコンの改正を主旨として依頼を致したく思います\n\n描いていただきたいキャラクターは過去に私が石川重工さんに依頼したもので、以下のURLのとおりです\nhttps://skeb.jp/@T72BV/works/5\n\n但し服装に関しては以下のとおりのふいんきです\nhttps://x.com/C11katao/status/1808435686825152889?t=VyQ3Q3s1JdVyJ5SWtckvqw&s=19\n\n携行する小銃は三八式歩とします\n着剣銃を考えていますが、脱剣銃でも差し支えないです\n\n姿勢としては現制アイコンの雰囲気に寄せて装填のために挿弾子を銃に挿したところをイメージしています\nできれば視線は的方にあると私の心が浮き立ちます\nhttps://x.com/C11katao/status/1808435924734517576?t=S-qeOvrRAWa5Jhw-F_ODAA&s=19\n\n装填される弾薬は白銅色の弾丸だと嬉しいです\nhttps://x.com/C11katao/status/1808436606233428258?t=bfCqBXkt-nuMyxCincXgwg&s=19\n\n襟章などの詳細についてはこちらです\nhttps://x.com/C11katao/status/1808441594397475164?t=EnxSNCR5AC5w8pc8pU5Efw&s=19\n\n色々七面倒くさい変な依頼になってしまいましたが、よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/17", "thumbnail_src": "https://si.imgix.net/ce5e1179/uploads/origins/1cd58999-a11e-4f0e-ae0c-42430962f123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147c588c5e4783a5eb50ae3b88529e81", "thumbnail_srcset": "https://si.imgix.net/ce5e1179/uploads/origins/1cd58999-a11e-4f0e-ae0c-42430962f123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147c588c5e4783a5eb50ae3b88529e81, https://si.imgix.net/ce5e1179/uploads/origins/1cd58999-a11e-4f0e-ae0c-42430962f123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d3eb48f1aae96ab09a728741e1b8b00 2x, https://si.imgix.net/ce5e1179/uploads/origins/1cd58999-a11e-4f0e-ae0c-42430962f123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eee24afa0101e565e11848cecd9e1e7 3x", "genre": "art", "nsfw": true, "body": "こんばんは。\n以前SKIMAにてこちらのオリジナルキャラクター（https://drive.google.com/drive/folders/1iPtxHaCfOvRNk0xwun-jSn9eiGTo85xa?usp=sharing）を依頼させていただいたものです。（現在のユーザー名はXに合わせていますが、依頼当時のユーザー名はアンノウンです）\n今回、こちらのキャラクターのイラストを描いていただきたくリクエストを送らせていただきました。\n\n・概要\n狂犬ちゃん（オリキャラ仮称）が戦闘終了後戦場から基地などに帰還した際に自身の昂ぶりを発散するため、そのあたりにいた女モブ兵士をおいしく頂こう（意味深）と襲い掛かっている様子をお願いいたします。\n\n記載の無い箇所・不明点などは絵師様にお任せいたします。\n難しい、気乗りしないようであれば遠慮なくキャンセルなどの対応をしていただいて構いません。\n\nhttps://drive.google.com/drive/folders/1iPtxHaCfOvRNk0xwun-jSn9eiGTo85xa?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/16", "thumbnail_src": "https://si.imgix.net/639048e9/uploads/origins/b2bb2afe-1643-48b8-952f-2393f1c2f881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36a40ffcb4b981dbad6f84d5f16da2cc", "thumbnail_srcset": "https://si.imgix.net/639048e9/uploads/origins/b2bb2afe-1643-48b8-952f-2393f1c2f881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36a40ffcb4b981dbad6f84d5f16da2cc, https://si.imgix.net/639048e9/uploads/origins/b2bb2afe-1643-48b8-952f-2393f1c2f881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40801a155c19b2f17c914528e24998d4 2x, https://si.imgix.net/639048e9/uploads/origins/b2bb2afe-1643-48b8-952f-2393f1c2f881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23ef6c13668bf8bb6fa722f50d708dab 3x", "genre": "art", "nsfw": false, "body": "まず前回うちの子を書いてくださりありがとうございました！もしよければまたうちの子を描いて貰いたくご依頼させてもらいます\n\n【うちの子たち】\n①【名前】カイ・ハスティング\n【性別】男\n【一人称】俺\n【身長】175cm\n【役職】陸軍元帥\n【好きなもの】日本文化 戦車 刀\n【内面】冷静を装ってるが好奇心が高く嬉しくなると自然と笑顔になる\n戦場においては先陣を駆け抜け、無駄な犠牲はなるべく減らし、捕虜にたいしてもぞんざいに扱わない武士道精神を持つ\n【好きなもの】\n戦車\n最近は重戦車なるものの開発に力を入れている\n\n②【名前】ユンカー・シュトラッサー\n【性別】女\n【一人称】僕\n【身長】165cm\n【役職】海軍元帥\n【好きなもの】空母 カレー\n【内面】常に笑顔で周りを明るくするムードメーカー\n海上では常に警戒を解かず、敵を決して逃がさず撃沈させる容赦がない面を持つ\n【好きなもの】\n一番は空母だが戦艦も好き\nというか軍艦全般が好き\n\n【シチュエーション】\n新造された戦艦を目を輝かせながらカイに自慢するユンカーを書いてください\nカイは若干うんざりしてそうな表情でお願いします\n戦艦のデザインなどについてはお好きなようにして構いませんなんなら無理でしたら別の軍艦でもいいです\n\nキャラデザに関しては以前描いてくださいましたデザインと同じで大丈夫です\n\nhttps://drive.google.com/drive/folders/1dDtFQXESQO5gTq3HdhS9lko93k3LHJTu\n\nご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/15", "thumbnail_src": "https://si.imgix.net/9c312a31/uploads/origins/2571bc54-cd2b-4128-9515-771646de2863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c2f47517fc16017ac595fc63809d345", "thumbnail_srcset": "https://si.imgix.net/9c312a31/uploads/origins/2571bc54-cd2b-4128-9515-771646de2863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c2f47517fc16017ac595fc63809d345, https://si.imgix.net/9c312a31/uploads/origins/2571bc54-cd2b-4128-9515-771646de2863?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b671f5f6d337fce222b290da0ce23900 2x, https://si.imgix.net/9c312a31/uploads/origins/2571bc54-cd2b-4128-9515-771646de2863?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=538de21b8d6bc4d28cea034417813976 3x", "genre": "art", "nsfw": false, "body": "始めまして。魅力的でカッコいい絵柄に惚れました！\nもしよければ、私のうちの子を二人描いていただければ非常に嬉しいです！\n\n【うちの子たち】\n①【名前】カイ・ハスティング\n【性別】男\n【一人称】俺\n【身長】175cm\n【役職】陸軍元帥\n【武器】アサルトライフル\n【好きなもの】日本文化 戦車 刀\n【内面】冷静を装ってるが好奇心が高く嬉しくなると自然と笑顔になる\n戦場においては先陣を駆け抜け、無駄な犠牲はなるべく減らし、捕虜にたいしてもぞんざいに扱わない武士道精神を持つ\n【ユンカーのこと】\n料理も上手いし一緒にいて楽しいと思ってる\nユンカーさえいれば海上は安全だと信頼してる\n予算の配分でめっっちゃ喧嘩している\n\n②【名前】ユンカー・シュトラッサー\n【性別】女\n【一人称】僕\n【身長】165cm\n【役職】海軍元帥\n【武器】サブマシンガン\n【好きなもの】空母 カレー\n【内面】常に笑顔で周りを明るくするムードメーカー\n海上では常に警戒を解かず、敵を決して逃がさず撃沈させる容赦がない面を持つ\n【カイのこと】\nプライベートではよく会うしなんなら家にも招いているぐらいの仲\nカイなら陸の方も大丈夫と戦場においても信頼している\n予算の配分でいっっつも喧嘩してる\n\n【シチュエーション】\n会議室で二人が予算の配分でギャーギャーと滅茶苦茶揉めてる様子をお願いします\nもしよければ「時代は戦車なんだよ！！」「陸を走る鉄屑なんぞに予算なんぞ渡すかぁ！！」みたいな台詞もあると嬉しいです\n\n世界観としては1930年代で魔法のあるいわば異世界の地球みたいな世界です。\nまた、キャラデザ、服装等に関しては描きやすいようアレンジしても構いません。\n\n上手くないですが二人の立ち絵を用意したので参考になればうれしいです\n\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1_b0WB5BI3DPm6Scj0QM2qD6spYI8KCcC", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/14", "thumbnail_src": "https://si.imgix.net/acc0b664/uploads/origins/a93974d9-6304-4b65-86f5-3fd1ba0b66d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fbb762f89b27fc83eacd4a1ac795374", "thumbnail_srcset": "https://si.imgix.net/acc0b664/uploads/origins/a93974d9-6304-4b65-86f5-3fd1ba0b66d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fbb762f89b27fc83eacd4a1ac795374, https://si.imgix.net/acc0b664/uploads/origins/a93974d9-6304-4b65-86f5-3fd1ba0b66d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e324b1c4c99e2e9f1fafe2ef61975bc 2x, https://si.imgix.net/acc0b664/uploads/origins/a93974d9-6304-4b65-86f5-3fd1ba0b66d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69d5180267f35d46d66b9d8cb3f302be 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/13", "thumbnail_src": "https://si.imgix.net/17d2a25c/uploads/origins/a65423e0-17b5-4590-990a-ad5b8a343af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=572764fa007bbd74f68ee13ee0fd2533", "thumbnail_srcset": "https://si.imgix.net/17d2a25c/uploads/origins/a65423e0-17b5-4590-990a-ad5b8a343af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=572764fa007bbd74f68ee13ee0fd2533, https://si.imgix.net/17d2a25c/uploads/origins/a65423e0-17b5-4590-990a-ad5b8a343af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=682f0e0a0c083264fd6cc2e442634928 2x, https://si.imgix.net/17d2a25c/uploads/origins/a65423e0-17b5-4590-990a-ad5b8a343af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ee9eb87958b5ed8e8cf6ffa4adcce0b 3x", "genre": "art", "nsfw": false, "body": "初めまして、是非先生にうちのこを描いて頂きたく依頼しました！\n\nキャラクターの容姿は\n髪は黒色、前髪を左右に分け、耳の周りはツーブロック風に。髪は後ろで纏める。\n眼は三白眼気味の縦長、黄色。リンク先に資料集があります。腰に羽と尻尾(どちらもイメージはカラスのもの)が生えています。\n\n服装はWW2時のアメリカ陸軍航空隊風のもので、A-4フライトスーツにA-2フライトジャケット、黒い革の手袋、AN6519-1ライフジャケット、AN6510パラシュートハーネス(羽根の描写の邪魔になる場合はハーネス背面を切り取っていただいて大丈夫です)に革製の拳銃用ホルスターを装着。\n右足にはクリップ式のニーボード、左足にドイツ国防空軍が使用したような信号弾用ベルトを装備。ディテールは装備の雰囲気に合わせ、独自のもので構いません。\nあくまでもアメリカ陸軍航空隊“風”なので、細かいディテールは独自に省略や追加をしていただいても構いません。フライトスーツには膝下丈のブーツを合わせ、足のシルエットは細めに。逆にA-2ジャケットは少し着ぶくれしている感じでお願いします。国籍や部隊のワッペンなどは無しです。\n\nポーズや構図は完全にお任せします。\n大変長くなってしまいましたが依頼については以上になります、是非ご一考頂けたら幸いです。\n\nhttps://photos.app.goo.gl/FYfARvybGv45Rpj36", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/12", "thumbnail_src": "https://si.imgix.net/c0aa0660/uploads/origins/2e42ac73-5048-4bbb-bc52-b4c95541daab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e84dd2267d03a6df9594bc7feee510f7", "thumbnail_srcset": "https://si.imgix.net/c0aa0660/uploads/origins/2e42ac73-5048-4bbb-bc52-b4c95541daab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e84dd2267d03a6df9594bc7feee510f7, https://si.imgix.net/c0aa0660/uploads/origins/2e42ac73-5048-4bbb-bc52-b4c95541daab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9386d7480ffc57efe142ba8f5990cf1 2x, https://si.imgix.net/c0aa0660/uploads/origins/2e42ac73-5048-4bbb-bc52-b4c95541daab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb4897e5cd578af653017ccadaed4c4e 3x", "genre": "art", "nsfw": false, "body": "中将慶次様\n\n初めまして、以前から非常に気になっておりました...！恐縮ではございますが、この度はリクエストを失礼いたします。当リクエストが難しいようでしたり、気乗りしないようであれば、どうかご遠慮なくキャンセルや金額の再送等のご対応をしてくださればと思います。\n\n可能であれば、当方の自創作をお願いしてしまい大変申し訳ありませんが、下記の内容を先生の絵柄でお願いさせて頂けないでしょうか？もしお引き受けいただける場合は、描写具合や範囲などご負担にならない範囲でご調整くだされば幸いです。以下、失礼いたします。\n\n●キャラ：桐島紘一(大礼服モチーフの方)\n●特徴:目にハイライトがない、真ん中分けの髪型\n●設定：昭和時代の青年将校\n●イメージ：畏れ多くも三島氏の『憂国』『英霊の聲』から着想を得させて頂いているキャラクターなので、お手数をおかけしてしまい申し訳ないのですが、先生に是非お任せさせて頂きたいです。どんなイメージでも構いません\n●仕様：PSD納品/宛名や人物などが分離できると嬉しいです\n\nhttps://www.yuu-koku.com/", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/11", "thumbnail_src": "https://si.imgix.net/7ca9c395/uploads/origins/0dff5219-3c3e-4caf-b2d0-d73b802770dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50c6814fde08fdb33ff685bba559642d", "thumbnail_srcset": "https://si.imgix.net/7ca9c395/uploads/origins/0dff5219-3c3e-4caf-b2d0-d73b802770dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50c6814fde08fdb33ff685bba559642d, https://si.imgix.net/7ca9c395/uploads/origins/0dff5219-3c3e-4caf-b2d0-d73b802770dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1022c2175dd8f7ac171cef75f7290f3 2x, https://si.imgix.net/7ca9c395/uploads/origins/0dff5219-3c3e-4caf-b2d0-d73b802770dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9be270ce9a9cbd9a4cb2bd44aebca2ca 3x", "genre": "art", "nsfw": false, "body": "こんにちは。K7サブマシンガンを振り回す武装JKを描いてください。細かいところは自由に決めてください。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/10", "thumbnail_src": "https://si.imgix.net/fe96f669/uploads/origins/64df5f8d-0ee2-49cd-8bb6-8474e3bd084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1223c30d116aad2483e5e93a2e8e45e6", "thumbnail_srcset": "https://si.imgix.net/fe96f669/uploads/origins/64df5f8d-0ee2-49cd-8bb6-8474e3bd084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1223c30d116aad2483e5e93a2e8e45e6, https://si.imgix.net/fe96f669/uploads/origins/64df5f8d-0ee2-49cd-8bb6-8474e3bd084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f52c70a8888499a18a9a6af34d25b140 2x, https://si.imgix.net/fe96f669/uploads/origins/64df5f8d-0ee2-49cd-8bb6-8474e3bd084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec1c9326ca597d8ed5032c011d274611 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも素敵なイラストを楽しみに拝見させて頂いております。\n\n軍服と装備を身に纏い、銃器を持った私のオリジナルキャラクターを描いて頂きたく依頼させて頂きます。キャラクターの外見は資料に纏めてあります。\n\n装備は第一次インドシナ戦争のディエンビエンフーの戦いのフランス外人空挺部隊の物を描いて頂きたいです。\n資料は資料用URLにありますが、申し訳ありませんが多くを集めることが出来ずに不足しているかもしれません。なので詳細な部分や不明瞭な部位等は随意に省略して頂いて構いません。\n顔がよく見えるよう、ヘルメットは被らず脇に置いて置くか抱えているようにして頂けると嬉しいです。\n\n銃器はM2カービンの空挺部隊モデルで、資料にあるように30連弾倉とショートバレルにして頂きたいです。\n\n構図やポーズはお任せ致しますが、連戦と激戦続きで疲れているような表情や全体の雰囲気だとありがたいです。\n\n\n資料URL\n\nhttps://photos.app.goo.gl/TSCSD56gKiCSBofz9", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/9", "thumbnail_src": "https://si.imgix.net/270d93ae/uploads/origins/1bf6179b-1de2-4992-9daa-695e01d3f37d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a65460e6051a7713aeda25cd29210aa6", "thumbnail_srcset": "https://si.imgix.net/270d93ae/uploads/origins/1bf6179b-1de2-4992-9daa-695e01d3f37d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a65460e6051a7713aeda25cd29210aa6, https://si.imgix.net/270d93ae/uploads/origins/1bf6179b-1de2-4992-9daa-695e01d3f37d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10efc7d7d72bd0b463935f499290e519 2x, https://si.imgix.net/270d93ae/uploads/origins/1bf6179b-1de2-4992-9daa-695e01d3f37d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bace0a3fea2af349c6ab45dd053e6c2b 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。この度依頼をさせていただきます、あるぱかと申します。\n軍服とは少し違うとは思いますが、似顔絵サイズにて西南戦争期警視庁の制服警察官娘を描いて頂きたく存じます。\nキャラデザインとしては\n・日本刀携行\n・ポニーテール\n・ツリ目\n・蒼髪\n・巡査\nにてお願いを申し上げます。\n初めてのskeb依頼である故至らぬ点も多々あるかと存じますが、何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/8", "thumbnail_src": "https://si.imgix.net/d57b4833/requests/186750_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61899ed893fb0954c88225ca5952e8e6", "thumbnail_srcset": "https://si.imgix.net/d57b4833/requests/186750_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61899ed893fb0954c88225ca5952e8e6, https://si.imgix.net/d57b4833/requests/186750_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21dce0f6adda4f99e79d520ffd6f7a13 2x, https://si.imgix.net/d57b4833/requests/186750_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d04eb8544702570ad473f8bb9ac2541 3x", "genre": "art", "nsfw": false, "body": "先日はWW1米兵と現用米兵との邂逅場面の続きを作成頂き誠にありがとうございました。\n連続になってしまい申し訳ありませんが、さらに続きの作成をお願いいただけますでしょうか。一応こちらで区切りとなっております。\n\n〇WW1米兵は過去の軍隊名簿等の記録や写真、DNA鑑定などで本人照会ができ、これからの処遇について決定されるまでの間、貴重な異世界転移経験者かつWW1を経験した最後の生き証人であるという事もあるため米軍のゲート施設で身柄を預かることになった設定。\n\n①\tシーン1\nブリーフィングルーム的な場所で米軍士官（女性米兵とは別のモブ）にWW１以降の歴史についてのスライドショー（WW2、冷戦、アポロ計画、9.11等各時代の象徴になりそうな出来事、手間軽減のため写真素材を加工したもの等を使用していただければ幸いです）を見せられながら状況を説明され、もはや元居た時代に戻ることが出来ないことを理解するWW1米兵\n②\tシーン2\n絶望し悲観にくれるWW1米兵を優しく慰めてあげる現行女性米兵\n③\tシーン3\nその後『世話役』として彼に付き添いPCの操作方法を教えたり、現用銃器について教えたりするなど（お互いの銃を交換し合う感じで）、現代の知識についてレクチャーする女性米兵。交流を通じて二人は徐々に親しくなっていく。\n④\tシーン4\n時は巡り（基地内のクリスマスパーティーをイメージ）、女性米兵に小さな花束を差し出してプロポーズするWW1米兵、女性米兵は戸惑いつつも嬉しそうな表情。周囲の同僚たちは二人を冷かしつつ祝福してる様子（周囲の同僚たちは簡略化していただいて構いません）", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/7", "thumbnail_src": "https://si.imgix.net/60a51baa/requests/177995_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d4f1eba01faea403a80dd74408c3b39", "thumbnail_srcset": "https://si.imgix.net/60a51baa/requests/177995_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d4f1eba01faea403a80dd74408c3b39, https://si.imgix.net/60a51baa/requests/177995_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fced5f56c262315ffb9f7d1aa0d18350 2x, https://si.imgix.net/60a51baa/requests/177995_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f67d67c8450e14d8c93391141ac230f4 3x", "genre": "art", "nsfw": false, "body": "先日はリクエストを受けて頂き誠にありがとうございました！\nもし差し支えなければ下記内容にて続きの場面をお願いいただけますでしょうか？\n\n〇基本構図は前回作成頂いた異世界WW1の米兵と現行の女性米兵の邂逅場面の続き\n①\tシーン1\nWW1の米兵が女性米兵に連れられゲートを抜けた先はとある米軍のゲート施設（スターゲート的な施設のイメージ）であった。自分の小銃（M1903）を抱え（向けはせず）ここはどこか周囲に問いただすWW1米兵と彼をなだめようとする現行の女性米兵\n②\tシーン2\n開けっ放しになってたゲートからゴブリンが一匹侵入し、たまたま近くにいた女性米兵に剣を振り上げ襲い掛かってきた。\n③\tシーン3\nとっさの事に銃を使えず必死にゴブリンを抑えるしかない女性米兵\n④\tシーン4\nゴブリンを射〇し女性米兵を救うWW1米兵\n\n※シーン1～3までは出来る限り簡略化していただいても構いません。", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/6", "thumbnail_src": "https://si.imgix.net/b4a201d4/requests/171353_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=010ae239a434d9fdf0fb4bafbbeaef02", "thumbnail_srcset": "https://si.imgix.net/b4a201d4/requests/171353_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=010ae239a434d9fdf0fb4bafbbeaef02, https://si.imgix.net/b4a201d4/requests/171353_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=481f247df5e6feb3329d322a86cfe14b 2x, https://si.imgix.net/b4a201d4/requests/171353_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=622c97634450c06b231697324cd0b696 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のオリジナルキャラクターを描いていただけますか？元気でボーイッシュな女の子です。軍服を着ている姿を描いていただきたいです。\n\nhttps://sta.sh/01chjhcrl6sg - 彼女の制服。ワイマール共和国のライヒスヴァイヤーをモチーフにしている。彼女は伍長 (ウンターオフィジエ) に格付けされています。しかし、それはより現代的に見えるように意図されています。スカートも少し長めに描いてください。\n\n好きなポーズで描いてください！でもカッコいいポーズがいいですね\n\nありがとうございます！\n\nhttps://sta.sh/01xyg40f55cl", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/5", "thumbnail_src": "https://si.imgix.net/4cf05123/requests/162637_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d005683f7ec4b5314179b2c617ef45e", "thumbnail_srcset": "https://si.imgix.net/4cf05123/requests/162637_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d005683f7ec4b5314179b2c617ef45e, https://si.imgix.net/4cf05123/requests/162637_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74bbac1bdadfe557ae4d43d551b42c19 2x, https://si.imgix.net/4cf05123/requests/162637_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2ff1d8601e23a41694302742fcac3da 3x", "genre": "art", "nsfw": false, "body": "諸事情により一時的に取り下げをしてしまい申し訳ありません。\n改めまして下記内容にてイラスト作成の程お願いいただけますでしょうか。\n\n昔書こうと考えて結局書けなかった異世界転送小説のアイデアからとなりますが、異世界に迷い込んだＷＷ1時代の米兵と、後から（例えばスターゲートのような）ＳＦ的なやり方で転移してきた現用装備の米兵とが邂逅する場面をお願いします。現用装備の米兵はＷＷ1の米兵に向けて自分たちは敵ではないと言う仕草をしており、またそこが異世界である事を強調するため倒されたゴブリン等クリーチャーが転がっていると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/4", "thumbnail_src": "https://si.imgix.net/883ae77f/requests/158793_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c6415b1116a1ea6ebe57ae26a9e2d47", "thumbnail_srcset": "https://si.imgix.net/883ae77f/requests/158793_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c6415b1116a1ea6ebe57ae26a9e2d47, https://si.imgix.net/883ae77f/requests/158793_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a787b912c5fef9ef0c1d452160e1833 2x, https://si.imgix.net/883ae77f/requests/158793_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba10d3b86aebe4042a0df8aac9c736e4 3x", "genre": "art", "nsfw": false, "body": "皇道派をテーマにしたイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/2", "thumbnail_src": "https://si.imgix.net/238281a5/requests/138774_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b146bd849117b9ea4e8b18155cc7665", "thumbnail_srcset": "https://si.imgix.net/238281a5/requests/138774_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b146bd849117b9ea4e8b18155cc7665, https://si.imgix.net/238281a5/requests/138774_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c50f355e6d4af0b90d1decfd01210f23 2x, https://si.imgix.net/238281a5/requests/138774_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85ae6477151fd24a959d1d6339620066 3x", "genre": "art", "nsfw": false, "body": "中将様のお好きなデザインのWWI〜戦間期位の軍装の、以下の特徴を持つ、歴戦の有翼の若い女性の兵士のイラストをお願いします。\n・銀髪\n・髪長め\n・大きな翼は白色の羽根\n「自分」は衛生兵の視点から、包囲下の仮包帯所に医薬品を届けにきた英雄的な彼女①と、\nその後、(日本軍でいうところの)「あお剤」に曝露し、仮包帯所にて肺をやられて非常に弱った彼女②の、両場面の入ったイラストを、お手数ですがお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@marineviceadmir/works/1", "thumbnail_src": "https://si.imgix.net/5e805480/requests/67147_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a93083764ad77a58ba6b748ff28c508", "thumbnail_srcset": "https://si.imgix.net/5e805480/requests/67147_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a93083764ad77a58ba6b748ff28c508, https://si.imgix.net/5e805480/requests/67147_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=477d1d88dafff9bd0e47ab8ccb0a8dbe 2x, https://si.imgix.net/5e805480/requests/67147_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa304ba838509cebd4aefb694397613b 3x", "genre": "art", "nsfw": false, "body": "突然のリクエスト失礼いたします。可能であるならばうちのこのユーリヤちゃんの旧制服姿を描いていただきたく(資料は添付URLを誤算書ください)\n\nhttps://twitter.com/a_machun/status/995987558663254016", "created_at": "", "completed_at": ""}]}