.net/b67855e5/uploads/origins/1dda2420-b4a7-4ded-9ba2-db08e470664f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f827878f8a7a4488f5af921ad6382b3d", "thumbnail_srcset": "https://si.imgix.net/b67855e5/uploads/origins/1dda2420-b4a7-4ded-9ba2-db08e470664f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f827878f8a7a4488f5af921ad6382b3d, https://si.imgix.net/b67855e5/uploads/origins/1dda2420-b4a7-4ded-9ba2-db08e470664f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e85beb42903dcdb5556c3c40986a7adc 2x, https://si.imgix.net/b67855e5/uploads/origins/1dda2420-b4a7-4ded-9ba2-db08e470664f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7344927a3a0c71857c3030f2a73342a 3x", "genre": "art", "nsfw": false, "body": "yokozawa様、はじめまして。\nご友人の紹介で作品を拝見し、絵柄がとても素敵で個人的に大変好みだったため、イラストをご依頼させていただきたくご連絡いたしました。\n\n私のOCのイラスト制作をご依頼したいと考えております。\nキャラクターは審神者で、名前は「御虚（ごこ）」です。\n生い立ちの影響で少し体が弱いものの、明るく外向的な19歳の少女です。\n身長は145cm（ヒール込みで150cm）になります。\n\nポーズや表情につきましては、yokozawa様のご自由にお任せいたします。\nよろしくお願いいたします。\nhttps://drive.google.com/drive/folders/1XnYwgMqDI9gdXID5dgoTqSZMWQGEhB5f?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@000000yoko/works/12", "thumbnail_src": "https://si.imgix.net/930bea40/uploads/origins/85cbe88f-2c0a-4fe5-8aac-a150afc3ecfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d62140e5c3ce004f0fd0063db0481ef", "thumbnail_srcset": "https://si.imgix.net/930bea40/uploads/origins/85cbe88f-2c0a-4fe5-8aac-a150afc3ecfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d62140e5c3ce004f0fd0063db0481ef, https://si.imgix.net/930bea40/uploads/origins/85cbe88f-2c0a-4fe5-8aac-a150afc3ecfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59cd8e2074a2bb39a93390d9071b8b93 2x, https://si.imgix.net/930bea40/uploads/origins/85cbe88f-2c0a-4fe5-8aac-a150afc3ecfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=581741847f5a05531f3f2504845aac87 3x", "genre": "art", "nsfw": false, "body": "はじめまして、Vtuber準備中の彩澄にこです。  \n\nyokozawa様のイラストがTLに流れてきまして、お顔の描き方と布の描き方がとても好みだったので是非依頼をお願いしたく今回ご連絡させていただきました。 \n以下、当方の希望を記載致します。  \n\n【依頼内容】 \n●使用用途 \n・X等のSNSやYouTubeなど配信サイトでの使用 (おはV、アイコン、ヘッダー、サムネイル、動画、配信、宣伝等)  \n\n●人物のイメージ　 \nキャラクターデザインについては資料URLを添付しますのでそちらをご確認ください。 \n以下(描写範囲内であれば)必ず入れて欲しい点です。 \n・瞳の中に✖︎ \n・瞳の色は水色とピンク \n・左目の下にほくろ \n・右鎖骨部分にほくろ \n・左八重歯 \n・太ももはムチムチ \n・赤と黒のグラデーションネイル  \n\n●構図 \nギャル感のあるポーズにしていただきたいです。両目はどちらも開いている状態でお願いします。\n頭頂部と左右を見切れないようにお願いしたいです。  \n\n●納品データに関して \n・サムネイル等に使用したいため、背景透過版もいただけると助かります。  \n\nお忙しいところ恐縮ですが、ご検討の程どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1TYevnSW25Lfkvmbj9CHkpQBPFdul0Scz", "created_at": "", "completed_at": ""}, {"path": "/@000000yoko/works/11", "thumbnail_src": "https://si.imgix.net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eee4f4db6c9ef141bb0028b840cfd5f3", "thumbnail_srcset": "https://si.imgix.net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eee4f4db6c9ef141bb0028b840cfd5f3, https://si.imgix.net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=316ff8166f7f716d929d264c440af855 2x, https://si.imgix.net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d696f5f6258127c70e29c60dbdc8c18d 3x", "genre": "art", "nsfw": false, "body": "yokozawa様、はじめまして！\nデザイン活動をしている「Que」と申します。(X: @9ue0w0)\n\nyokozawa様の絵柄がとても素敵で自身のOCイラストを描いていただきたく今回依頼させて頂きました。\n\n●使用用途\n自身が制作したサムネイルデザインなどのモデル、SNSアイコン\n\n●納品形式\nよろしければPSD形式でお願いいたします\n\n●イラストイメージ\nURLにて共有させていただきます。\nポーズ・構図・表情などはおまかせ致します！\n服装などyokozawa様が描きやすいように変更いただいても構いません。\n\nリクエスト金額で上記の内容が難しいようであれば再送要請をお願いいたします。\nお忙しい中恐縮ですがご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1kfMum87xmvUlXBHgi7oC8GVFx2T5Wn0C", "created_at": "", "completed_at": ""}, {"path": "/@000000yoko/works/10", "thumbnail_src": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c021c54b81d57497736b4c9c2cc01a8d", "thumbnail_srcset": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c021c54b81d57497736b4c9c2cc01a8d, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e146a2d5fff85f8111a14d579db1546 2x, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb05ad798e4dfe45fa2cc10bdd2858d7 3x", "genre": "art", "nsfw": false, "body": "はじめまして、チャイナ服のocを描いていただきたく思い、リクエスト失礼します。\n\nチャイナ服の全体のイメージは資料の中にあるロングのスリットが入っているもので、胸元、腕周り、色味をもうひとつのチャイナ服のように描いていただきたいです。靴は資料のようなものでお願いいたします。\n\n・全体の色味➡️白\n・胸元➡️谷間が見えるくらいの深さに開いている\n・腕周り➡️シアー素材の布多めのイメージ\n・立ち絵構図➡️特に希望なし\n\n髪型差分で描いていただきたいものも資料に入れていますが、金額不足などありましたら髪型はoc資料のものと同じ、黒髪前髪ぱっつんのストレートロングでお願いしたいです。もし差分で描いていただける際にも、前髪だけはoc資料と同じものでお願いいたします。\n\nまた、資料の中に服装イメージ図を添付しておりますので、そちらを参考にしていただけるとありがたいです。\n\nocの容姿についてなのですが、眉は困り眉(八の字眉でも可)、瞳の色は黒でも明るい紫でもなく、黒に近い暗い紫でお願いいたします。\n\n金額不足や資料不足などありましたら、再送またはキャンセルをしていただけるとありがたいです。ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wDBgAmedd4-vVhv4YDMeFePpzCzKehEn", "created_at": "", "completed_at": ""}, {"path": "/@000000yoko/works/9", "thumbnail_src": "https://si.imgix.net/a31a6d89/uploads/origins/f3a34606-3f52-453a-9c47-c6f8c5acf95e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=657ec88b74eabf8bd81d31f85f