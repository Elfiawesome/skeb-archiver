ストをお願い致します。\nシチュエーションとしてはこちらを参考に…　\nhttps://twitter.com/commission_docu/status/1567313684443299840?t=LJvHY75hJJJZP1DiSiMalg&s=19\n\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@neu_2dai/works/51", "thumbnail_src": "https://si.imgix.net/21eef7f1/uploads/origins/6d373149-934b-4745-88b3-125c6c14b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eacf8ff25556125cd192e88cabd83a1d", "thumbnail_srcset": "https://si.imgix.net/21eef7f1/uploads/origins/6d373149-934b-4745-88b3-125c6c14b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eacf8ff25556125cd192e88cabd83a1d, https://si.imgix.net/21eef7f1/uploads/origins/6d373149-934b-4745-88b3-125c6c14b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9134eeca23e1ceb6ba31bececd9cd60a 2x, https://si.imgix.net/21eef7f1/uploads/origins/6d373149-934b-4745-88b3-125c6c14b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ac927aa48cc8539ac39b5d10f066292 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@neu_2dai/works/50", "thumbnail_src": "https://si.imgix.net/0652b06c/uploads/origins/5f1e7bd5-c7df-49da-90ff-514d4955f438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680685eb4f716728f69852298c1083dd", "thumbnail_srcset": "https://si.imgix.net/0652b06c/uploads/origins/5f1e7bd5-c7df-49da-90ff-514d4955f438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680685eb4f716728f69852298c1083dd, https://si.imgix.net/0652b06c/uploads/origins/5f1e7bd5-c7d