h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32fb366654557c14d405fe80947268b9 2x, https://si.imgix.net/c431efe8/uploads/origins/856ddca5-c510-410d-889b-b18a8bf5eaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbee0ac615955d9b2dd4c5614838e251 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kokollet316/works/46", "thumbnail_src": "https://si.imgix.net/abbed722/uploads/origins/804bc86c-33eb-4747-a385-7b0a901c9c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0029caf4b490f4fc7ab8931c4351a6c9", "thumbnail_srcset": "https://si.imgix.net/abbed722/uploads/origins/804bc86c-33eb-4747-a385-7b0a901c9c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0029caf4b490f4fc7ab8931c4351a6c9, https://si.imgix.net/abbed722/uploads/origins/804bc86c-33eb-4747-a385-7b0a901c9c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52bfd469483270299b5e43b7cb3fba75 2x, https://si.imgix.net/abbed722/uploads/origins/804bc86c-33eb-4747-a385-7b0a901c9c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fe7330c669c94aaadbab330b7d75084 3x", "genre": "art", "nsfw": false, "body": "こんにちは!私はあなたの絵が大好きで、私のOCであるレンゲを描いていただけませんか？\n\n身長187cmで、ブロンドのロングヘアをポニーテールに結っています。グリーンの瞳と鼻筋のソバカスが特徴です。胸はぺったんこ。\n\nできれば、アルケミースターズのヒイロと同じような服装で描いていただけませんか？\nhttps://www.pixiv.net/en/artworks/91982523\n\nイクメン、クールビューティー的な魅力が欲しいです。\n\nご検討のほど、よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/18IzenBlP6gfBIIGSGSjajCiE2h6tOdYK?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@kokollet316/works/45", "thumbnail_src": "https://si.imgix.net/e875eeea/uploads/origins/fe5c2669-07c2-49d3-88c3-b411ca285f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9f3c59a9137e885997f3f6ce6826414", "thumbnail_srcset": "https://si.imgix.net/e875eeea/uploads/origins/fe5c2669-07c2-49d3-88c3-b411ca285f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9f3c59a9137e885997f3f6ce6826414, https://si.imgix.net/e875eeea/uploads/origins/fe5c2669-07c2-49d3-88c3-b411ca285f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f9eeb0aa5c893220b5a056757954f67 2x, https://si.imgix.net/e875eeea/uploads/origins/fe5c2669-07c2-49d3-88c3-b411ca285f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b094cc496cd421b94e562ea8d5b18d62 3x", "genre": "art", "nsfw": false, "body": "Hello koko-san! Thank you again for an amazing commission.\n\nCould you please draw Medea from Fate in style of Deedlit? I left some references, but I leave the general idea to you. \n\nDeedlit: https://imgur.com/a/H6QpovT\n\nMedea: https://imgur.com/a/7Tn9Fsl\n\nThank you!\n\nkokoさん、こんにちは。今回も素晴らしい依頼をありがとうございます。\n\n運命のメデイアをディードリット風に描いていただけませんか？いくつか参考文献を残していますが、大まかなイメージはお任せします。\n\nDeedlit: https://imgur.com/a/H6QpovT\n\nメデア: https://imgur.com/a/7Tn9Fsl\n\nありがとうございます。\n\nhttps://imgur.com/a/H6QpovT", "created_at": "", "completed_at": ""}, {"path": "/@kokollet316/works/44", "thumbnail_src": "https://si.imgix.net/7eb4284a/uploads/origins/64f21413-1a2a-4a24-810b-239c86a0b82a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549a6cbcad53dfdceabc02bd59c29a15", "thumbnail_srcset": "https://si.imgix.net/7eb4284a/uploads/origins/64f21413-1a2a-4a24-810b-239c86a0b82a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549a6cbcad53dfdceabc02bd59c29a15, https://si.imgix.net/7eb4284a/uploads/origins/64f21413-1a2a-4a24-810b-239c86a0b82a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46ef905962a904ecf1a5947a5932f1bb 2x, https://si.imgix.net/7eb4284a/uploads/origins/64f21413-1a2a-4a24-810b-239c86a0b82a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36fe61e15bbb15db4462a43663d0f0bc 3x", "genre": "art", "nsfw": false, "body": "こんばんは！(*^_^*)\nずっと前からお願いしたかったんです!\n私のキャラのコハル（蛍ver.）を描いてほしいです。\nデザインはもっと見せていただけると嬉しいです。\nポーズや表情は自由です。\nありがとうございました。\n\nhttps://imgur.com/a/FdV9vX5", "created_at": "", "completed_at": ""}, {"path": "/@kokollet316/works/43", "thumbnail_src": "https://si.imgix.net/70485ed9/uploads/origins/21ba885a-a4f0-4eec-af6c-a3d4d8decbda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=492029e876e609c6c89f0d1edbe5e9e2", "thumbnail_srcset": "https://si.imgix.net/70485ed9/uploads/origins/21ba885a-a4f0-4eec-af6c-a3d4d8decbda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=492029e876e609c6c89f0d1edbe5e9e2, https://si.imgix.net/70485ed9/uploads/origins/21ba885a-a4f0-4eec-af6c-a3d4d8decbda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61db28f3bf2f9aafbf06d2ee00e33f5e 2x, https://si.imgix.net/70485ed9/uploads/origins/21ba885a-a4f0-4eec-af6c-a3d4d8decbda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=098fcacaa2583b933172ef699e022375 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの絵がとても好きです\n私は私のオリジナルキャラクターをお願いしたいです。\n下の「画像」タブをクリックすると、他の画像も見ることができます。\n髪は淡い緑色。彼の目は明るい赤です。\n細身ですが、健康的でスポーツマンです。\n\n彼は人を操ることができ、狡猾な人間である。\n普段は何かを企んでいるような、悪戯っぽい笑みを浮かべている。\n両手を長袖の中に入れている。\n鎖を操る力を持っている。\nまた、非常にアクロバティックで、武術に長けている。\nポーズを決めるのはあなたです。\nクールでちょっと悪そうな感じにしたいです。\n(でも、あまり邪悪すぎないように！）。\n鎖骨が見えているのであれば、それを強調したい。\n\nありがとうございました。\n\nhttps://www.kirostyle.net/neros.html", "created_at": "", "completed_at": ""}, {"path": "/@kokollet316/works/42", "thumbnail_src": "https://si.imgix.net/a3f054d8/uploads/origins/fde861ac-f119-46ab-9a99-3771266679a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7941732dafe58b9efdcb8b71f0e0aea", "thumbnail_srcset": "https://si.imgix.net/a