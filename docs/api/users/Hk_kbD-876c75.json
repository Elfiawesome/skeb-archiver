2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a3d94961eb36eaa0d55dcd810444496 3x", "genre": "art", "nsfw": false, "body": "はじめまして☺\nTwitterでHkr様のAPEXイラストを拝見してとてもかわいくてぜひイラストをお願いしたくご連絡させていただきました。\nYoutubeのサムネやYoutubeと17の配信中の画面に使用できますでしょうか？（17Liveはクレジット表記できる場所がありませんが、Youtubeの方にはクレジット表記させていただきます。）\n可能でしたら、オクタン（トナカイスキン）とブラハ（かぼちゃスキン）がリンゴを持っているイラストをお願いしたいと思っておりますので、再度お支払いさせていただき、合計２つ分お支払いさせていただきます。\n\nお忙しいところ恐縮ですが、ご確認のほどよろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@Hk_kbD/works/8", "thumbnail_src": "https://si.imgix.net/95e4122d/requests/149658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5329eea93a71fd068995c9fa710eb90a", "thumbnail_srcset": "https://si.imgix.net/95e4122d/requests/149658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5329eea93a71fd068995c9fa710eb90a, https://si.imgix.net/95e4122d/requests/149658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ce56608e8ebab17c577622f0199844b 2x, https://si.imgix.net/95e4122d/requests/149658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17beea6e403a805d0051d5a2b98bd0e8 3x", "genre": "art", "nsfw": false, "body": "FF14のうちのこ2人のイラストを描いて頂きたいです。\n衣装パターンはいくつか資料用URLに入ってますが、この中に無いものやオリジナルにして頂いても大丈夫です。\nまた、構図やシチュエーションもおまかせ致します。\nご検討のほどよろしくお願い致します。\n\nhttp://30d.jp/blueright250/2", "created_at": "", "completed_at": ""}, {"path": "/@Hk_kbD/works/7", "thumbnail_src": "https://si.imgix.net/28b25ae4/requests/149465_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cb1cf87e77af88b0150eeb2ae0578ae", "thumbnail_srcset": "https://si.imgix.net/28b25ae4/requests/149465_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cb1cf87e77af88b0150eeb2ae0578ae, https://si.imgix.net/28b25ae4/requests/149465_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0353db2abe0e05c837f28ecaa5cb8e09 2x, https://si.imgix.net/28b25ae4/requests/149465_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a92a81c1f604a5a58e81555dffefe35 3x", "genre": "art", "nsfw": false, "body": "Skeb開設おめでとうございます、と共に再開ありがとうございます！\n早速恐縮ですが、デフォルメイラストで以下をお願いできたらと思います。\n【キャラクター】\nFF14自キャラミコッテ\n【内容】\n服装はプチペックスイラストからレイスで、できればスキンをピンクレイスって呼ばれてる[虚空を織る者]\nもし厳しそうであれば検疫スキンでも全然大丈夫です！無理のない範囲でお願いできればと。\n姿は立ちで、可能であればクナイ持たせてくれてると嬉しいです！\n\n頭14、身体APEXみたいなちょっと難しいオーダーで申し訳ないです；検討いただければ幸いです！\n一応知ってると思うけど、ある程度参考になりそうなミコッテSSを参考URLに置いておきます！\n【使用用途】\nDiscord、twich等のプロフィール用アイコン目的\n\nhttps://twitter.com/Accele542/status/1312241963484151808?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Hk_kbD/works/6", "thumbnail_src": "https://si.imgix.net/98af0160/requests/148090_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6245e880ecabf6d80f1ea024ff26b136", "thumbnail_srcset": "https://si.imgix.net/98af0160/requests/148090_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6245e880ecabf6d80f1ea024ff26b136, https://si.imgix.net/98af0160/requests/148090_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2398c391ba1c1ed6f6992535e21dcce9 2x, https://si.imgix.net/98af0160/requests/148090_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f41adf98cf7e7059c78b0775bc3e05f2 3x", "genre": "art", "nsfw": false, "body": "Twitterのヘッダー画像を作成して頂きたいです。\nAPEXのライフライン(パイレートクイーンスキン)、レイス(エアシップアサシンスキン)、ワットソン(サイバーパンクスキン)を使って欲しいです。\n現在お借りしているヘッダー画像（ライフラがイチゴを抱えている）の上記３人版のようなものが欲しいです。\nパステル系の優しめ色で、表情（ライフラは丸目＆ウインク・レイスは丸目＆少し険しめ（虚空に入りそうな）顔・ワットソンは丸目＆微笑み）をつけていただきたいです。\n優先順位は①ライフラ丸目②ワットソン微笑み③レイスの丸目④ライフラウインク⑤ワットソン丸目⑥レイス少し険しめ顔\n画像内に入らない等あれば下から削る（身体だけ表示等）していただけるとありがたいです。\nレイアウトはヘッダー画像がとても気に入っているのであれを基にしていただきたいのですが、TOP画像と一部被ってしまう箇所があるので、そこへのキャラの配置はせず、描いて頂いたキャラすべてが見えるようにして頂きたいです。\nまた、三人のスキンの色　緑・黄色？・ピンクの三本線をお借りしている画像のようにHkrさんのセンスで並べて頂けると嬉しいです。\nキャラポーズに指定ができるのであれば、ライフラインはDOCを抱っこ、ワットソンはウルトのパイロンに座る、レイスはクナイに乗ってる（スノーボード的）でお願いしたいです。\n背景色は、暖色系で、上記のキャラたちが可愛く写ってくれる色にお願いします。\n\n以上\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Hk_kbD/works/4", "thumbnail_src": "https://si.imgix.net/7952cfd6/requests/130195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5002f91bbe55551a3788446147d74ebb", "thumbnail_srcset": "https://si.imgix.net/7952cfd6/requests/130195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5002f91bbe55551a3788446147d74ebb, https://si.imgix.net/7952cfd6/requests/130195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e688e924d39a6f3ed89937c8a2d6627 2x, https://si.imgix.net/7952cfd6/requests/130195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50b50b25068087062308eb8902ef98e1 3x", "genre": "art", "nsfw": false, "body": "ミラージュのキャラ選択画面の時のデコイが腰に手を当てて、本物が人差し指をたてて口の前に運んでいるイラストを希望します。\n本物の右目をウインクさせて頂けるとうれしいです。\nデコイと本物の間に少しだけ空間があると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Hk_kbD/works/3", "thumbnail_src": "https://si.imgix.net/0861e362/requests/129916_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c60abcd20f60df802c18c27de1a0fdd", "thumbnail_srcset": "https://si.imgix.net/0861e362/requests/129916_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c60abcd20f60df802c18c27de1a0fdd, https://si.imgix.net/0861e362/requests/129916_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3ad88ed18770e8fdc9a336a64337aba 2x, https://si.imgix.net/0861e362/requests/129916_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=482b1e5c6d9a9f79186050d676c10ceb 3x", "genre": "art", "nsfw": false, "body": "こんばんわ！\n\n使用用途\nAPEX仲間達とお揃いの待ち受け画面として使用したく御依頼させて頂きました！\n\n描いて欲しいキャラ\nライフライン、オクタン、ブラッドハウンド、クリプト\n\n描いて欲しい内容\nライフラインを中心に他キャラと一緒にワイワイしてる感じ\n(ヒールドローンで回復中に武器の話してる様なイメージ)\n\nもし、武器まで描いて下さるのが可能でしたら、ライフライン→フラットライン、オクタン→トリプルテイク、ブラッドハウンド→プラウラー、クリプト→マスティフでお願いしたいです。\n\n以上