-870c-e46d1e1d3aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66ede81bdb2a19fd5660a739b4f22891", "thumbnail_srcset": "https://si.imgix.net/1b69c2da/uploads/origins/d06199bf-6b02-4c2d-870c-e46d1e1d3aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66ede81bdb2a19fd5660a739b4f22891, https://si.imgix.net/1b69c2da/uploads/origins/d06199bf-6b02-4c2d-870c-e46d1e1d3aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b486ec799fc96d203514f0d31cca7ed 2x, https://si.imgix.net/1b69c2da/uploads/origins/d06199bf-6b02-4c2d-870c-e46d1e1d3aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d4092ef7fa30e15e4888aa7e402a01a 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております！\nはゅこさんのイラストが大好きです！！\n\n今回は正霊針の3人を是非描いて頂きたいです！✨️\n\n段々暑くなってきましたので、はゅこさんの夏を感じれるようなイラストを見たいです！\n残暑にバテた2人と1匹が、博麗神社の居間の畳の上に仰向けで横たわっているシーンをお願いします！\n3人が寝転がってる間に、団扇や溶けかけの氷水の入った桶と濡れた手ぬぐい、「ハズレ」の文字が入ったアイスの棒や、河童印の扇風機などの小物が転がっていて、暑さ対策を頑張っていた形跡があるといいなと思います…！\n服装ですが、\n霊夢は腕絹なしのいつもの服、\n針妙丸はいつもの着物に袖部分だけ透明の薄い生地でできた夏仕様の衣装(鈴奈庵2巻第8話目等に小鈴ちゃんや阿求が着ていた夏服の袖をイメージして頂けると嬉しいです)、\n正邪は長袖でお願いします！\n\nご検討頂けますと幸いです！是非よろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@HaYuk0/works/14", "thumbnail_src": "https://si.imgix.net/8459a040/uploads/origins/d8bea37c-69e6-4cbd-a9c0-6f0199c2a178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4615d50b589b33e4994b9cba5b767100", "thumbnail_srcset": "https://si.imgix.net/8459a040/uploads/origins/d8bea37c-69e6-4cbd-a9c0-6f0199c2a178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4615d50b589b33e4994b9cba5b767100, https://si.imgix.net/8459a040/uploads/origins/d8bea37c-69e6-4cbd-a9c0-6f0199c2a178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit