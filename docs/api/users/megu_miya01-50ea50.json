//si.imgix.net/5ab38808/uploads/origins/c9f6dae3-d675-4ca6-bdbf-961d2628ddcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b83e3528ea5592331b2bdcf5242c209e 2x, https://si.imgix.net/5ab38808/uploads/origins/c9f6dae3-d675-4ca6-bdbf-961d2628ddcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d32d5f83d7a9e8d35b742f05b485d13a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n私は、あなたのアートスタイルで、あなたと一緒にコミッションをしたいと思っています。こんな感じにしたいと思っています。\n\nhttp://puu.sh/Hswh9/4f05aee8ce.jpg\n\nポーズや背景はあなたの想像力にお任せします。^^", "created_at": "", "completed_at": ""}, {"path": "/@megu_miya01/works/11", "thumbnail_src": "https://si.imgix.net/a03f87a4/requests/268075_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c37e82695a28864e2d9c303814c398b3", "thumbnail_srcset": "https://si.imgix.net/a03f87a4/requests/268075_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c37e82695a28864e2d9c303814c398b3, https://si.imgix.net/a03f87a4/requests/268075_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e85eb3a37fe9c79cc0e1f018fba24f 2x, https://si.imgix.net/a03f87a4/requests/268075_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=609d98a3fee03f3efa32034ede42ebb8 3x", "genre": "art", "nsfw": false, "body": "ちびっこイラストを作ってください!!! できればステッカーにしてほしいです。\n\nhttps://drive.google.com/folderview?id=1ZA2R1LkCObIhblp8-5qL5I2MbikYwe3s", "created_at": "", "completed_at": ""}, {"path": "/@megu_miya01/works/10", "thumbnail_src": "https://si.imgix.net/df34caa0/requests/232022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dcb2da420d6a011837bc5d132439e3a", "thumbnail_srcset": "https://si.imgix.net/df34caa0/requests/232022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dcb2da420d6a011837bc5d132439e3a, https://si.imgix.net/df34caa0/requests/232022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit