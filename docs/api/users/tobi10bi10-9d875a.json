5f5-44ea-99af-b7e75a31df9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68576caa224f559477565e0dae325e91 2x, https://si.imgix.net/8bfc64cf/uploads/origins/a1cb0c69-35f5-44ea-99af-b7e75a31df9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=783640a200dca50220bd17653d2bd3e6 3x", "genre": "art", "nsfw": false, "body": "鳶職人さん、こんにちは。以前に描いていただいた作品がとても気に入りました。ルーンファクトリー5」の「アリス」に扮したVTuberアバターを描いていただけますか？ポーズや表情はお任せしますが、鍬を持っているようなイメージでお願いします。\n\nこちらはアリスです。https://static.wikia.nocookie.net/harvestmoonrunefactory/images/4/4f/Chara_alice.png\n\nYouTubeのサムネイルに使用したいと思いますこの作品にはクレジットが入り、すべての使用は非営利です。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1Ul8RfaSkkDTu2sC09fa8iQIpGsyhQzSY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tobi10bi10/works/5", "thumbnail_src": "https://si.imgix.net/1ae43eab/uploads/origins/e61d567d-6455-43f9-9fbc-ac28053ef557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=323312969038fb467466dd2e7fedde79", "thumbnail_srcset": "https://si.imgix.net/1ae43eab/uploads/origins/e61d567d-6455-43f9-9fbc-ac28053ef557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=323312969038fb467466dd2e7fedde79, https://si.imgix.net/1ae43eab/uploads/origins/e61d567d-6455-43f9-9fbc-ac28053ef557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1aa90f2e964aca4182c4f819b677c288 2x, https://si.imgix.net/1ae43eab/uploads/origins/e61d567d-6455-43f9-9fbc-ac28053ef557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=435dd0fbe8c2febb3072df41ab0b84c6 3x", "genre": "art", "nsfw": false, "body": "1月まで従来の料金での依頼が可能というツイートを拝見したので\n滑り込みに来ました！\n\n今回も前回と同じくオリジナルキャラの立ち絵をお願いします。\n(表情差分も幾つかお願いします)\n\n■性別・容姿\n女性\n年齢は20歳前後　身長、体型は年相応なイメージ。\nキャラクター：傭兵や戦闘もこなせる探偵っぽい感じで考えています。\n\n■服装\n服装のイメージは資料URLのような感じで考えています。\n複数枚ありますが、こんな感じという私の勝手なイメージなので、あまり気にせずデザインのほうはお任せします。\n\nhttps://mobile.twitter.com/sabuakadesu00/status/1486740596002009088", "created_at": "", "completed_at": ""}, {"path": "/@tobi10bi10/works/4", "thumbnail_src": "https://si.imgix.net/9a49228e/uploads/origins/91b58a69-b399-4547-8bfc-b7f740774120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e476c77f7e0470d7a510720fd2edcc9", "thumbnail_srcset": "https://si.imgix.net/9a49228e/uploads/origins/91b58a69-b399-4547-8bfc-b7f740774120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e476c77f7e0470d7a510720fd2edcc9, https://si.imgix.net/9a49228e/uploads/origins/91b58a69-b399-4547-8bfc-b7f740774120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=718d5860c5099f45fdde97e538d5055e 2x, https://si.imgix.net/9a49228e/uploads/origins/91b58a69-b399-4547-8bfc-b7f740774120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6cff4612b8e2c0d2cda76ced07a2357 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tobi10bi10/works/3", "thumbnail_src": "https://si.imgix.net/bfbd19ea/uploads/origins/171382bd-f182-4160-9072-be7a453c8cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e922b6fc673e2a89ea11948cea484945", "thumbnail_srcset": "https://si.imgix.net/bfbd19ea/uploads/origins/171382bd-f182-4160-9072-be7a453c8cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e922b6fc673e2a89ea11948cea484945, https://si.imgix.net/bfbd19ea/uploads/origins/171382bd-f182-4160-9072-be7a453c8cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7e4bfb123bcd78018f782763192bbe2 2x, https://si.imgix.net/bfbd19ea/uploads/origins/171382bd-f182-4160-9072-be7a453c8cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be92d2ace1ecaee4d96ffa2afb7554fc 3x", "genre": "art", "nsfw": false, "body": "初めまして、立ち絵の依頼をお願いします！\n\n使用用途は身内でやるTRPGの立ち絵、ツイッターのアイコン利用、その為の加工です。\n\nオリジナルの子をお願いします。\n外見、年齢はローティーン中学生程度の少女\n髪は銀髪ロング、ワンポイントでメッシュを入れてもらって水色です。\n顔はクール系で少し小悪魔チックな感じでお願いします。\n目は所謂オッドアイ、黄色(黄緑に近い感じ)とオレンジです。\n体型、身長は年齢通りっぽいのでお願いします。\n武器は人形使いか何かを召喚するという設定でいこうと思うので、なしで大丈夫です。\n服装はURL先の子の服装でお願いします。(荒くて申し訳ないです)\n服の装飾はアシンメトリーになる部分は削っていただいてOKです。\nhttps://mobile.twitter.com/sabuakadesu00/status/1471458779204325381\n構図はお任せします。\n属性盛り盛りで申し訳ないですが、よろしくお願いします。\n\n表情差分はとびとびとさんがよく使うような種類の差分とジト目、あとはお任せします。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tobi10bi10/works/2", "thumbnail_src": "https://si.imgix.net/d7821bfd/uploads/origins/46daae51-d5a6-441a-9be6-5b0bed19ff43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad02a46a56516a014459a9bad4437f3e", "thumbnail_srcset": "https://si.imgix.net/d7821bfd/uploads/origins/46daae51-d5a6-441a-9be6-5b0bed19ff43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad02a46a56516a014459a9bad4437f3e, https://si.imgix.net/d7821bfd/uploads/origins/46daae51-d5a6-441a-9be6-5b0bed19ff43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8539d8db8106a7adfdc7e7ccc9277ce2 2x, https://si.imgix.net/d7821bfd/uploads/origins/46daae51-d5a6-441a-9be6-5b0bed19ff43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f36342640aa87ef2d0755922d701435a 3x", "genre": "art", "nsfw": false, "body": "はじめまして。ポケボールを持ったVTuberのアバターを描いていただけませんか？性格は、やんちゃなお姉さんタイプです。ポーズはお好きなものでお願いします\n\nYouTubeのサムネイルに使用したいと思います!宜しくお願いします。\n\nhttps://drive.google.com/folderview?id=1Ul8RfaSkkDTu2sC09fa8iQIpGsyhQzSY", "created_at": "", "completed_at": ""}, {"path": "/@tobi10bi10/works/1", "thumbnail_src": "https://si.imgix.net/0ede1f35/