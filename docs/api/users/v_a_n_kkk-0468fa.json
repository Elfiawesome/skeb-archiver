c4092fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580957b3d6ab56a9e9bc8b21117c5470", "thumbnail_srcset": "https://si.imgix.net/b9a9aefa/uploads/origins/017a8420-82ac-4987-ab9f-70fa1c4092fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580957b3d6ab56a9e9bc8b21117c5470, https://si.imgix.net/b9a9aefa/uploads/origins/017a8420-82ac-4987-ab9f-70fa1c4092fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b743bb0dabfd802d0c65aafae9325f5b 2x, https://si.imgix.net/b9a9aefa/uploads/origins/017a8420-82ac-4987-ab9f-70fa1c4092fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d9bc8bb889695c926a1355e586cf644 3x", "genre": "art", "nsfw": false, "body": "再びお願いします！\n以前描いていただいたOC龍人をまた描いていただけませんでしょうか？\nhttps://skeb.jp/@v_a_n_kkk/works/4\n蛮犬様の絵柄で描かれたどっしりとしたアーマー姿が最高に格好良くて今でも何かある度に眺めてしまうほど最高に気に入ってます！\n\n今回は↓の絵の様に一つのポーズを違う視点で見た構図でお願いします！\nhttps://skeb.jp/@v_a_n_kkk/works/15\nそれ以外の事は全てお任せします。\nもし資料のアーマーやキャラクターが絵的に映えない、描くのが難しい様でしたら自由に変更したりアレンジを加えてください。\nわからなかったり迷ったりする部分は蛮犬様の好きな様に解釈してカッコよく描いてくださいれば幸いです。\nそれではよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1to1GnJbPq80WEIRULg6Blo-MKQTLhJ-z", "created_at": "", "completed_at": ""}, {"path": "/@v_a_n_kkk/works/25", "thumbnail_src": "https://si.imgix.net/1dd1144d/uploads/origins/d8e45c62-122d-4fc8-86c9-8004f3077fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bf54ae81b506450d128ac84bdb934a7", "thumbnail_srcset": "https://si.imgix.net/1dd1144d/uploads/origins/d8e45c62-122d-4fc8-86c9-8004f3077fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bf54ae81b506450d128ac84bdb934a7, https://si.imgix.net/1dd1144d/uploads/origins/d8e45c62-122d-4fc8-86c9-8004f3077fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bb9aef2c6b1656de9330cafe45c7e84 2x, https://si.imgix.net/1dd1144d/uploads/origins/d8e45c62-122d-4fc8-86c9-8004f3077fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5ba6955754a10fa7a274eda304ef555 3x", "genre": "art", "nsfw": false, "body": "はじめまして！あなたの作品はとてもクールですね！\n\nこのキャラクターのイラストを描いていただけませんか？現代のSF設定です。\n\nアロイス\nディンゴ。180センチ。金髪の男性。とても痩せている。\n性格はおしゃべりでいたずら好き。普段の表情は満面の笑み。\nゲイブの忠実な部下。\n\nゲイブ\nホッキョクグマ。186センチ。グレーヘアーのオス。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険な人物でもある。\nエイリアンのテクノロジーを利用・開発する会社の悪役リーダー。\nアロイスを素行の悪い部下のように扱う。\n\n服装や体型の参考として、人間バージョンのみを掲載した。\n\n二人がエイリアンの怪物と戦うかっこいいアクションイラストを描いてください！\nポーズや構図はお任せします。\n\nいずれにせよ、リクエストを読んでいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Zovag9J6SWh0jPvzh-SwAMHRSSJlVgUV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@v_a_n_kkk/works/24", "thumbnail_src": "https://si.imgix.net/404be540/uploads/origins/dec80ecd-9026-4366-8944-cf6cbaa7b549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47abc97e7f82fc752c0f7dbc791bc35", "thumbnail_srcset": "https://si.imgix.net/404be540/uploads/origins/dec80ecd-9026-4366-8944-cf6cbaa7b549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47abc97e7f82fc752c0f7dbc791bc35, https://si.imgix.net/404be540/uploads/origins/dec80ecd-9026-4366-8944-cf6cbaa7b549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9df1716d21df65a9d022beba66810298 2x, https://si.imgix.net/404be540/uploads/origins/dec80ecd-9026-4366-8944-cf6cbaa7b549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31e5ce1c62905624aeb9c65f4a418323 3x", "genre": "art", "nsfw": false, "body": "初めまして！Skeb開放していただいてありがとうございます・・・！\n今回、フレンドにプレゼントするイラストを依頼したいです。\n\nこの↓フレンドのキャラと、\nhttps://www.getamped.jp/sns/img.php?filename=a_1079_1_1704631745.jpg&m=pc\nhttps://www.getamped.jp/sns/img.php?filename=a_1079_2_1704631745.png&m=pc\n遊戯王の《魔導獣マスターケルベロス》、《ハロハロ》が並んでるイラストをお願いします！\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@v_a_n_kkk/works/23", "thumbnail_src": "https://si.imgix.net/927cf3fe/uploads/origins/f3d60f13-0f69-4cf9-95c6-596e1ac2f893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6fa39edc0cb3b5f68dab8e7c43e11df", "thumbnail_srcset": "https://si.imgix.net/927cf3fe/uploads/origins/f3d60f13-0f69-4cf9-95c6-596e1ac2f893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6fa39edc0cb3b5f68dab8e7c43e11df, https://si.imgix.net/927cf3fe/uploads/origins/f3d60f13-0f69-4cf9-95c6-596e1ac2f893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b343484ccc0f73ac39e33b42f12ef2c 2x, https://si.imgix.net/927cf3fe/uploads/origins/f3d60f13-0f69-4cf9-95c6-596e1ac2f893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60e46b3fe7f78c206494abc2f980c77b 3x", "genre": "art", "nsfw": false, "body": "はじめまして！男の子魂を震わせるカッコいいイラストの数々に惹かれて、この度リクエストをお送りさせて頂きました！　もしケモノのオリキャラのリクエストがＯＫでしたら、以下の私のキャラクターを描いて頂く事は可能でしょうか？\nhttps://www.dropbox.com/s/u2ps0vnuf47gaav/main_ref.jpg?dl=0\n\n絵の内容はかっこよさげに纏めて頂けたら（可能であれば全身が入っていると有り難いです）、残りの詳細についてはご自由に描いて頂ければと思います。\n\n※以下は上記の設定で見えていないところの補足などの、念のための補足資料です。あまり訳立たないと思います。\nhttps://www.dropbox.com/s/3xn9d031t0sp20d/Alternative_1.jpg?dl=0\nhttps://www.dropbox.com/s/kt32kkqxfquckiz/Alternative_2.jpg?dl=0\nhttps://www.dropbox.com/s/0kmanfnmijyxrkv/Carmine_LightArrow.jpg?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@v_a_n_kkk/works/22", "thumbnail_src": "https://si.imgix.net/ba5b207f/uploads/origins/04cd0afc-7a2c-4063-a29c-bd5fab34b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bf88eabe490d1fd8ffa4b089bcd26f0", "thumbnail_srcset": "https://si.imgix.net/ba5b207f/uploads/origins/04cd0afc-7a2c-4063-a29c-bd5fab34b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bf88eabe490d1fd8ffa4b089bcd26f0, https://si.imgix.net/ba5b207f/uploads/origins/04cd0afc-7a2c-4063-a29c-bd5fab34b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25e8d5ac2895f68f624a744fe35226f5 2x, https://si.imgix.net/ba5b207f/uploads/origins/04cd0afc-7a2c-4063-a29c-bd5fab34b3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c575c4000f62e6c2ff204f2840f0ffb 3x", "genre": "art", "nsfw": false, "body": "Hello, I love your Yu-Gi-Oh art!\nI am wondering if you can draw my yugioh OC (green outfit) with 空牙団の大義 フォルゴ. If you want, you can also add other  空牙団 monsters as well.\nThank you!\nhttps://twitter.com/rukuluc/status/1603953604179918848?s=20&t=66lweJCdiqrAKdwI72NSiA", "created_at": "", "completed_at": ""}, {"path": "/@v_a_n_kkk/works/21", "thumbnail_src": "https://si.imgix.net/425c0f21/uploads/origins/b8987f1e-944d-4cda-bb75-f3bb6a4eb347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab1cdfe94775b287516b464ce5b54bd7", "thumbnail_srcset": "https://si.imgix.net/425c0f21/uploads/origins/b8987f1e-944d-4cda-bb75-f3bb6a4eb347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab1cdfe94775b287516b464ce5b54bd7, https://si.imgix.net/425c0f21/uploads/origins/b8987f1e-944d-4cda-bb75-f3bb6a4eb347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0a6bd163edc838f8173803c1e1c058c 2x, https://si.imgix.net/425c0f21/uploads/origins/b8987f1e-944d-4cda-bb75-f3bb6a4eb347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=095558fc25b3b76ff20d1c7fb00d8343 3x", "genre": "art", "nsfw": false, "body": "早速依頼させていただきます！\n\n空牙団のヘルマーが抱っこしている空牙団のレクスに顔をベロベロ舐められているイラストをお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@v_a_n_kkk/works/20", "thumbnail_src": "https://si.imgix.net/6048af7d/uploads/origins/cda881f6-8bbc-4706-b7e4-d141c175c5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=432f38552049ac92e1655b665a043774", "thumbnail_srcset": "https://si.imgix.net/6048af7d/uploads/origins/cda881f6-8bbc-4706-b7e4-d141c175c5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=432f38552049ac92e1655b665a043774, https://si.imgix.ne