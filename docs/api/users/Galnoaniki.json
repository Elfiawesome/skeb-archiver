rks/6 に描かれているシナリオに沿った画像が欲しいです。\n彼女が売られた結果、一番面白い、あるいはエロティックだと思うシナリオなら何でも構いません。例えば、誰かのセックス・ペットとして飼い慣らされるとか、彼に仕える動物の女の子のグループの中で誰かのお気に入りの女の子になるとか、単に誰かのよく調教された従順な、でも時々性的におもちゃにされるメイドとして仕えるとか、そういうのも面白い結果になるだろう。ただ、私が挙げたアイデアのどれである必要もまったくなく、あなたが描いていて楽しいと思うものであれば、私はそれでいいと思います。\nその他、何でも結構です。\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Galnoaniki/works/7", "thumbnail_src": "https://si.imgix.net/0a0dd738/uploads/origins/a199a29c-8a6b-41d3-90f0-0547f5d9cd90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92849514211fa4b980f959675dddf84", "thumbnail_srcset": "https://si.imgix.net/0a0dd738/uploads/origins/a199a29c-8a6b-41d3-90f0-0547f5d9cd90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92849514211fa4b980f959675dddf84, https://si.imgix.net/0a0dd738/uploads/origins/a199a29c-8a6b-41d3-90f0-0547f5d9cd90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6336fc4bbbb9ab85532e27365deb191 2x, https://si.imgix.net/0a0dd738/uploads/origins/a199a29c-8a6b-41d3-90f0-0547f5d9cd90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9684174f39cbfe5becbfb30f9daf226c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Galnoaniki/works/6", "thumbnail_src": "https://si.imgix.net/5e1b78df/uploads/origins/f55b036d-95b6-4e32-aafa-8407acda16e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aff56feb4a92ebb3e53317e150e68af4", "thumbnail_srcset": "https://si.imgix.net/5e1b78df/uploads/origins/f55b036d-95b6-4e32-aafa-8407acda16e7?bg=%23fff&au