a81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd8c553e47f8d6af0195fb05668ee28a", "thumbnail_srcset": "https://si.imgix.net/684af00a/uploads/origins/d82a73fc-3d75-410d-bc8e-3f54e6746a81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd8c553e47f8d6af0195fb05668ee28a, https://si.imgix.net/684af00a/uploads/origins/d82a73fc-3d75-410d-bc8e-3f54e6746a81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9405a207cd1e890f1cd9063f96d4cb0 2x, https://si.imgix.net/684af00a/uploads/origins/d82a73fc-3d75-410d-bc8e-3f54e6746a81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f444deeba6005d93c8bfa45b3d9a7f21 3x", "genre": "art", "nsfw": false, "body": "ウィッチクラフトマスター・ヴェールさんとウィッチクラフト・ポトリーさんが\n二人で楽しく雪だるまを作るイラストをお願いします。\n普段の衣装だと寒そうなので暖かい服装にしていただくようお願いします。\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ishii_13kaidann/works/27", "thumbnail_src": "https://si.imgix.net/4fe199da/uploads/origins/7d6ac73d-6710-4421-9e3d-b7de9b8e0226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9331b3c41b21d48cf5bfefe230b5c2ae", "thumbnail_srcset": "https://si.imgix.net/4fe199da/uploads/origins/7d6ac73d-6710-4421-9e3d-b7de9b8e0226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9331b3c41b21d48cf5bfefe230b5c2ae, https://si.imgix.net/4fe199da/uploads/origins/7d6ac73d-6710-4421-9e3d-b7de9b8e0226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=970c5ac4adef06f259a1147f3580081e 2x, https://si.imgix.net/4fe199da/uploads/origins/7d6ac73d-6710-4421-9e3d-b7de9b8e0226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95ea57c0f34e1066ddcde8aa102dc6aa 3x", "genre": "art", "nsfw": false, "body": "私のマジシャン・ガールを描いてくれる？\n\n彼女の名前はアッコ・ハースラ・エトストップ。姉のマーケを尊敬しているオタク少女で、大の恥ずかしがり屋だけどね。\n\nhttps://www.dropbox.com/scl/fi/tylt71sbx8cog8vl7620g/Bunny-Witch-Girl.png?rlkey=mqinogmhr7kfu3872skox4o42&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ishii_13kaidann/works/26", "thumbnail_src": "https://si.imgix.net/469e8bbf/uploads/origins/7fce0814-8398-476b-b56d-403ff1aec1c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095551e86cc974c3394ba3cdac5e566f", "thumbnail_srcset": "https://si.imgix.net/469e8bbf/uploads/origins/7fce0814-8398-476b-b56d-403ff1aec1c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095551e86cc974c3394ba3cdac5e566f, https://si.imgix.net/469e8bbf/uploads/origins/7fce0814-8398-476b-b56d-403ff1aec1c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acc408f7c2d9e7a332798bce258dc0b4 2x, https://si.imgix.net/469e8bbf/uploads/origins/7fce0814-8398-476b-b56d-403ff1aec1c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fce31996b11af47071c6c05e94bbbde 3x", "genre": "art", "nsfw": false, "body": "このかわいい女の子を描いていただけませんか？デザインは自由に修正してください。あなたに似合っていればそれでいいんです。\n\nもし可能なら、彼女にレイジングストームアタックをお願いできますか？\n\nレイジングストーム：https://snk.fandom.com/wiki/Raging_Storm\n\nレイジングストームのビデオ：https://www.youtube.com/watch?v=K1rzZxImN8I\n\nhttps://www.dropbox.com/s/tcei4lr92eykqh4/Frieda%20Brocken%20References.png?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ishii_13kaidann/works/25", "thumbnail_src": "https://si.imgix.net/e3f52130/uploads/origins/be48f1dd-21cb-4e14-8e53-b71c106f0ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ed4296090bcb042216581faad813508", "thumbnail_srcset": "https://si.imgix.net/e3f52130/uploads/origins/be48f1dd-21cb-4e14-8e53-b71c106f0ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ed4296090bcb042216581faad813508, https://si.imgix.net/e3f52130/uploads/origins/be48f1dd-21cb-4e14-8e53-b71c106f0ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=030048ae5cefd9e1a6366063558732c2 2x, https://si.imgix.net/e3f52130/uploads/origins/be48f1dd-21cb-4e14-8e53-b71c106f0ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33f80c4fca3337110abe7649a1036e9a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！このOCを描いていただけませんか？\n\n金髪に赤のハイライト、マルーンのドレス、紫の月のヘアクリップ、グレーのネクタイ、グレーのスカート、黒の手袋、茶色のストッキング、そして変色した目をしています。身長は約180cmです。\n\nもし可能であれば、雷光拳で敵を攻撃する彼女を描いていただけませんか？\n\n雷光拳: https://www.youtube.com/watch?v=D9pQTkivZcI\n\nhttps://www.dropbox.com/s/brhs8tjzdm9ykvj/Nimue%20References%20Online.png?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ishii_13kaidann/works/24", "thumbnail_src": "https://si.imgix.net/ca562813/uploads/origins/c2ecabb8-f1e9-40c7-b71f-fd7672b11a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ba5c935086e2fbb071eb64f794e9285", "thumbnail_srcset": "https://si.imgix.net/ca562813/uploads/origins/c2ecabb8-f1e9-40c7-b71f-fd7672b11a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ba5c935086e2fbb071eb64f794e9285, https://si.imgix.net/ca562813/uploads/origins/c2ecabb8-f1e9-40c7-b71f-fd7672b11a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd6a7dfd246d5813b50b72b9c6eb7bb0 2x, https://si.imgix.net/ca562813/uploads/origins/c2ecabb8-f1e9-40c7-b71f-fd7672b11a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c29a493da76876ed6742b2c218ff17b0 3x", "genre": "art", "nsfw": false, "body": "私の考えたイラストをかいてほしいです！\n\nhttps://1drv.ms/f/s!AoVaR0CJZTy2oShX42nKF1tlObHk\nキャラクターと構図をのせました、\n構図のように見下ろすようなアングルで顔は構図の絵よりも少し横を見てて、表情は照れてるような感じで\nキャラクターも送った絵と髪や服など同じように描いて欲しいです、よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ishii_13kaidann/works/23", "thumbnail_src": "https://si.imgix.net/0b97624f/uploads/origins/752ca343-dce0-4a92-8da1-3896f71c0109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bef0394aa0247e856aadcec75a944959", "thumbnail_srcset": "https://si.imgix.net/0b97624f/uploads/origins/752ca343-dce0-4a92-8da1-3896f71c0109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bef0394aa0247e856aadcec75a944959, https://si.imgix.net/0b97624f/uploads/origins/752ca343-dce0-4a92-8da1-3896f71c0109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49f3eae70478091c48b5f8a35c077ca7 2x, https://si.imgix.net/0b97624f/uploads/origins/752ca343-dce0-4a92-8da1-3896f71c0109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d981e7d482992000544d20d3d7d0803 3x", "genre": "art", "nsfw": false, "body": "戦場で傷ついた侍女を描いていただけませんか？日本酒を飲んでいるような感じでもいいです。\n\nBattle-Scarred Samurai Girl Reference: https://www.dropbox.com/s/6hkbybcvq1od083/Photo%20May%2007%202023%2C%2012%2039%2046%20AM.jpg?dl=0\n\n戦国武将サムライガールの衣装 参考：https://www.dropbox.com/s/isdmbf09vg19g5r/Photo%20May%2007%202023%2C%209%2057%2041%20AM.jpg?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ishii_13kaidann/works/22", "thumbnail_src": "https://si.imgix.net/c044ae63/uploads/origins/96abf523-c774-44a1-ac62-47184e1fccb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edfa552e251c67f4ec64398462a053c3", "thumbnail_srcset": "https://si.imgix.net/c044ae63/uploads/origins/96abf523-c774-44a1-ac62-47184e1fccb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edfa552e251c67f4ec64398462a053c3, https://si.imgix.net/c044ae63/uploads/origins/96abf523-c774-44a1-ac62-47184e1fccb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8c38b0b24a1897cf61b1aff6e2a31e4 2x, https://si.imgix.net/c044ae63/uploads/origins/96abf523-c774-44a1-ac62-47184e1fccb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39d28346a501af8d85e1e52488d9e764 3x", "genre": "art", "nsfw": false, "body": "こんにちは！これを描いてもらえますか？\n\nダストバニーは、褐色の肌、黒いウサギの耳、毛の入った灰色の髪、灰色の綿毛の尻尾、そして紺色の目をしたウサギの女の子です。矢をモチーフにした服とグレーの口紅を身に着けています。\n\nできれば、ウサギの女の子のぬいぐるみを抱いているところを描いていただけませんか？\n\nダストバニーに抱かれたラビットガールぬいぐるみ https://www.dropbox.com/s/3tepo7koho5bpv6