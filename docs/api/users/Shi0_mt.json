2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bdec384b19b89b6d0ea42663422d4c0 2x, https://si.imgix.net/8d5ab73d/uploads/origins/90318b11-b1e4-4df6-94b4-ab2eb61e896a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16f659c3acfa9738f67d02c5ef94ae50 3x", "genre": "art", "nsfw": false, "body": "こんにちは、サオラです！(サオラ)\n\nサオラさんの作風が大好きで、私のVTuberモデルを描いていただけたらとても嬉しいです！\nクラゲのような性格で、甘えん坊。\nよく寝ること、バブルティー、歌うこと、そして友達が大好き。\n\n表情、ポーズ、背景はあなた次第！\nあと、帽子を入れてもらえるとうれしいです！帽子がなくても大丈夫です！\n顔のマークも忘れずに！目の下のマーク、目、体のマークは暗闇で光ります。\n\n彼女はこんな感じです：\nhttps://imgur.com/a/uNwzmTY\n\n本当にありがとう！感謝します！", "created_at": "", "completed_at": ""}, {"path": "/@Shi0_mt/works/11", "thumbnail_src": "https://si.imgix.net/167838b7/uploads/origins/36fc473a-1ee0-4934-83f5-3608ae989959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aefcb7353f05d24837ff0f58303b4648", "thumbnail_srcset": "https://si.imgix.net/167838b7/uploads/origins/36fc473a-1ee0-4934-83f5-3608ae989959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aefcb7353f05d24837ff0f58303b4648, https://si.imgix.net/167838b7/uploads/origins/36fc473a-1ee0-4934-83f5-3608ae989959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8047b545837e3ac305c870790c0e46f 2x, https://si.imgix.net/167838b7/uploads/origins/36fc473a-1ee0-4934-83f5-3608ae989959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e6bf648fcbc23d1085b859bacb969e4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のキャラクターのために作ってくれた前回のアートワークがとても気に入ったんだ！今回は、グリッチな風景の中に私のキャラクターを登場させた作品を作っていただけませんか？ポーズや表情は、今回もお任せします！\n\n16:9で作ってもらえると、曲のカバーになるので、より好ましいです！\n\nありがとうございました！\n\nキャラクター参照：https://drive.google.com/file/d/1bWn5X5nUp1_E7PUrzuXhCGP4PNQiPwda/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Shi0_mt/works/10", "thumbnail_src": "https://si.imgix.net/d7a3e11c/uploads/origins/30e3b1af-2e68-4064-b3c4-b86d685848d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4039480bf8ea9cc8918001fff364b778", "thumbnail_srcset": "https://si.imgix.net/d7a3e11c/uploads/origins/30e3b1af-2e68-4064-b3c4-b86d685848d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4039480bf8ea9cc8918001fff364b778, https://si.imgix.net/d7a3e11c/uploads/origins/30e3b1af-2e68-4064-b3c4-b86d685848d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ef8bbed1f1beaccb0f76b6b75d6f51d 2x, https://si.imgix.net/d7a3e11c/uploads/origins/30e3b1af-2e68-4064-b3c4-b86d685848d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25167c4d70e155d8f15e3c45072d6e80 3x", "genre": "art", "nsfw": false, "body": "汐沫様\n初めまして、ましゃと申します。\nイラストを拝見し素敵なイラストだったため、是非描いて頂きたく思いリクエストを送らせて頂きます。\n\nこの度は個人VTuberの兎彷魂あみゅちゃん(@usatama_amyu )のイラストをお願い致します。\nプレゼントとして贈りたいと考えております。\n\n資料urlは4面図等となります。\n\n構図等はおまかせでお願いします。\n\n金額不足等ありましたら返送お願いします。\n\nskeb等で依頼する許可は本人より得ております。\n(https://lit.link/usatamaamyu)\n\nSkebの二次創作公認プログラムに登録済みです。\n\nキャラと背景で分けてPSDデータで頂けますと嬉しいです。透過差分などありますととても助かります。\n\nまた、イラストについて兎彷魂あみゅちゃんご本人が Twitterにてアイコンやツイート、配信内、サムネイル等で使用する許可を頂けますと幸いです。\nご検討の程お願いいたします。\n\nhttps://usatama-amyu.fanbox.cc/posts/6177435", "created_at": "", "completed_at": ""}, {"path": "/@Shi0_mt/works/9", "thumbnail_src": "https://si.imgix.net/0782a282/uploads/origins/27fb5ae6-7c37-4151-8d65-eba97af5c2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a18ddc160a6a3448d1b86410537ddd", "thumbnail_srcset": "https://si.imgix.net/0782a282/uploads/origins/27fb5ae6-7c37-4151-8d65-eba97af5c2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a18ddc160a6a3448d1b86410537ddd, https://si.imgix.net/0782a282/uploads/origins/27fb5ae6-7c37-4151-8d65-eba97af5c2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=005a05b2256b1440ea44b8df7469cf07 2x, https://si.imgix.net/0782a282/uploads/origins/27fb5ae6-7c37-4151-8d65-eba97af5c2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4268890698fe2fa6c5c9a0ecbecdf2d 3x", "genre": "art", "nsfw": false, "body": "Hello! I was recommended your artwork and I'd love to request you! Can you please draw my VTuber character?\n\nHer name is Admyra. She is a military android. She has a cold and serious external personality, but internally she is very lighthearted and caring. I will let you decide all of the details and which personality you would like to depict. She also has a purple teddy bear that you can include if you'd like.\n\nPlease pay special attention to the symbols in her eyes, and please be sure that she is wearing her hat.\n\nThank you very much! 💜\n\nhttps://drive.google.com/drive/u/0/folders/1yKkhpfG1Z_3BzjlcwPEHVZh9Duoj1aIx", "created_at": "", "completed_at": ""}, {"path": "/@Shi0_mt/works/8", "thumbnail_src": "https://si.imgix.net/66304e3b/uploads/origins/90b248fe-e9c4-4862-89c2-a35c0ce9f68e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be181a39798dd9ab1dd3f16b02fb1856", "thumbnail_srcset": "https://si.imgix.net/66304e3b/uploads/origins/90b248fe-e9c4-4862-89c2-a35c0ce9f68e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be181a39798dd9ab1dd3f16b02fb1856, https://si.imgix.net/66304e3b/uploads/origins/90b248fe-e9c4-4862-89c2-a35c0ce9f68e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3827356eb98553bcecfb6cfef328eabc 2x, https://si.imgix.net/66304e3b/uploads/origins/90b248fe-e9c4-4862-89c2-a35c0ce9f68e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46e1749537b7acc2f299a4da335dedba 3x", "genre": "art", "nsfw": false, "body": "汐沫様はじめまして。\nみぴと申します。\n\n先日新着作品欄で拝見し、とても素敵なイラストに惹かれリクエストをお送りさせていただきました…！\n\n□使用用途\nSNSアイコン.参考資料の1部\n\nポーズ、構図や背景等はお任せしたいです。\n\nご検討頂けますと幸いです。\nよろしくお願い致します。\n\nhttps://drive.google.com/file/d/102iDyyVvPgHOz3MzGxe5HjI5FyOpqbN0/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@