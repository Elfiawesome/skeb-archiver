！自分もリクエストしたいです！！\n\nリクエスト内容は、漫画家「三ツ森あきら」様の「わんるーむ」三巻に出てくる超巨乳UKOの超乳イラストが見てみたいです！\n\n正面から直立した全身立ち絵で、原作サイズのバランスボールのようなまん丸球体の超乳で乳首丸出しのイラストが見てみたいです！\n\nもし可能なら超巨乳UKOの超乳おっぱいからさらに膨乳したイラストも見てみたいです！\n\nあまりなれてないskeb依頼ですが、どうぞよろしくお願いいたします！\n\n(もし良ければですがpixivとかにも出来上がった作品をのせてほしいです。)", "created_at": "", "completed_at": ""}, {"path": "/@OgakuzuJhon/works/10", "thumbnail_src": "https://si.imgix.net/6e47b25d/uploads/origins/5a72411f-fbd3-4599-8197-18f62add65fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=269d0dc8f45adda0f5462dc912bf6153", "thumbnail_srcset": "https://si.imgix.net/6e47b25d/uploads/origins/5a72411f-fbd3-4599-8197-18f62add65fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=269d0dc8f45adda0f5462dc912bf6153, https://si.imgix.net/6e47b25d/uploads/origins/5a72411f-fbd3-4599-8197-18f62add65fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cafca76d3fa29f2b723a39ff85769cd1 2x, https://si.imgix.net/6e47b25d/uploads/origins/5a72411f-fbd3-4599-8197-18f62add65fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=487d58c2944ca0c85a883389909e35cb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OgakuzuJhon/works/9", "thumbnail_src": "https://si.imgix.net/b5de49ad/uploads/origins/5f4b98a0-0520-48f2-9ca4-056886b20779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58c93e2722bd1190e2fddfb6b2593fc7", "thumbnail_srcset": "https://si.imgix.net/b5de4