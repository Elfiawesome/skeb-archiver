さい。キャラクター像はお好きなようイメージで書いて頂ければ幸いです。\n\n細かい指示が多くて申し訳ありませんがどうかよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@OgakuzuJhon/works/16", "thumbnail_src": "https://si.imgix.net/beb9fac4/uploads/origins/d6152e55-22b3-42df-a7db-d8db5fde5cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee46b140f5e1cef84e21b6c5216f38bc", "thumbnail_srcset": "https://si.imgix.net/beb9fac4/uploads/origins/d6152e55-22b3-42df-a7db-d8db5fde5cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee46b140f5e1cef84e21b6c5216f38bc, https://si.imgix.net/beb9fac4/uploads/origins/d6152e55-22b3-42df-a7db-d8db5fde5cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e67dc25094742adc35d23bfdcf683a5 2x, https://si.imgix.net/beb9fac4/uploads/origins/d6152e55-22b3-42df-a7db-d8db5fde5cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1985e9f75c46ee587fafcaf6f7698b35 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OgakuzuJhon/works/15", "thumbnail_src": "https://si.imgix.net/3c93812e/uploads/origins/22ad8bc2-32c9-465b-9ff7-0888afebd47b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51ae616066be02a557f67bee0f437c6", "thumbnail_srcset": "https://si.imgix.net/3c93812e/uploads/origins/22ad8bc2-32c9-465b-9ff7-0888afebd47b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51ae616066be02a557f67bee0f437c6, https://si.imgix.net/3c93812e/uploads/origins/22ad8bc2-32c9-465b-9ff7-0888afebd47b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b123f0d621887d64c3dd7e8844ffd07b 2x, https://si.imgix.net/3c93812e/uploads/origins/22ad8bc2-32c9-465b-9ff7-0888afebd47b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54282d5e025d296f2ed4547a1d9bd53f 3x", "genre": "art", "nsfw": true, "body": "初めまして、サンサンLABさん。skebのhttps://skeb.jp/@OgakuzuJhon/works/11　わんるーむの超乳UKOを拝見し依頼しました。\n\n内容ですが\n漫画だとUKOが巨乳おすそわけマシ～ンで貧乳の葵ちゃんに超乳を与えるシーンがあり、マシーン取り付けのが緩くて失敗し、全体に脂肪が届いて醜く肥満化してしまうのですが。\nちゃんと成功して、葵ちゃんの胸に脂肪が届き魔乳になるverを膨乳シークエンスで描いて欲しいです。\nUKOと葵ちゃんが巨乳おすそわけマシ～ンで繋がっている状態を、膨乳シークエンスは描ける可能な枚数の範囲で頼みます。\n最初、葵ちゃんは巨乳なって喜んでいたのが、爆乳辺りで焦り始め、超乳で青ざめた表情になり、魔乳で胸が大きすぎて苦しい表情へと変化があると嬉しいです。巨乳おすそわけマシ～ンも胸が大きくなるにつれて乳にグイグイ食い込ませて欲しいです。セリフや効果音はお任せします。参考なるか分かりませんが資料です。↓　よろしくお願いいたします。\n\nhttps://i.imgur.com/9NkXpHL.jpg\nhttps://i.imgur.com/pepdkbY.jpg\nhttps://i.imgur.com/doWuZGD.jpg\nhttps://i.imgur.com/TLtnXxY.jpg\nhttps://i.imgur.com/4mAFpa4.png", "created_at": "", "completed_at": ""}, {"path": "/@OgakuzuJhon/works/14", "thumbnail_src": "https://si.imgix.net/1799aba7/uploads/origins/ddcc2300-d717-46d8-8003-95385052ae77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca0cb8b6bcbe8ffb56c7d1e6ede5ed3c", "thumbnail_srcset": "https://si.imgix.net/1799aba7/uploads/origins/ddcc2300-d717-46d8-8003-95385052ae77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca0cb8b6bcbe8ffb56c7d1e6ede5ed3c, https://si.imgix.net/1799aba7/uploads/origins/ddcc2300-d717-46d8-8003-95385052ae77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb891da9cedd17df3f0b2f0d4a72e077 2x, https://si.imgix.net/17