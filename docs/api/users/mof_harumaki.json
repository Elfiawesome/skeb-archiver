mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=051fcdca516df7f12a94c492576cd8f1 2x, https://si.imgix.net/450619d7/uploads/origins/96e5f9f5-d552-4140-8bdc-83f57e542173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4674181cd73b70cd051be2e04551b2da 3x", "genre": "art", "nsfw": false, "body": "スプリングロールさん、こんにちは！\nお元気ですか？自分のキャラクターでも、ファンアートでも、あなたの創造力を刺激するものなら何でも描いてほしいです。どうぞ楽しんでください！\n\n近いうちにまた依頼するかもしれませんが、今はこの作品を、あなたと一緒に依頼する機会を与えてくれたことへのささやかなお礼にしたいと思います。\n\nどうぞ楽しんでください！", "created_at": "", "completed_at": ""}, {"path": "/@mof_harumaki/works/6", "thumbnail_src": "https://si.imgix.net/690358fc/uploads/origins/ae563d80-9301-490d-8b35-46d1db23192b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eb5ef9debe4a7bb908b991b5e0c12e0", "thumbnail_srcset": "https://si.imgix.net/690358fc/uploads/origins/ae563d80-9301-490d-8b35-46d1db23192b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eb5ef9debe4a7bb908b991b5e0c12e0, https://si.imgix.net/690358fc/uploads/origins/ae563d80-9301-490d-8b35-46d1db23192b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=281b85d231dcc87ecbb9269158d28293 2x, https://si.imgix.net/690358fc/uploads/origins/ae563d80-9301-490d-8b35-46d1db23192b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcf6f79b605c3fccd73474ae94ce5c6e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ あなたの作品がとても好きです。\n私の獣舎の絵を描いてほしいです＞＜。\nhttps://drive.google.com/file/d/1WamC4McvDS7tJ0kD2KWvysSOHF1w5QTo/view?usp=drive_link\nまた、以下の部分にも注意が必要です。\nhttps://drive.google.com/file/d/13PxH-5gwR_E3ROyDt8_RzsRJevfvTxuz/view?usp=drive_link\n\n服装：セットのビキニとは違うものを着てほしい。\nアクションと背景は自由！\n\nありがとうございます :3", "created_at": "", "completed_at": ""}, {"path": "/@mof_harumaki/works/5", "thumbnail_src": "https://si.imgix.net/1f9518f7/uploads/origins/1f9a3822-4654-4cb0-b32f-1345fe9a2980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0099f555e8c2a35f6baf46a610b2ead3", "thumbnail_srcset": "https://si.imgix.net/1f9518f7/uploads/origins/1f9a3822-4654-4cb0-b32f-1345fe9a2980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0099f555e8c2a35f6baf46a610b2ead3, https://si.imgix.net/1f9518f7/uploads/origins/1f9a3822-4654-4cb0-b32f-1345fe9a2980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb6348eef919aa0116d76dce0275804c 2x, https://si.imgix.net/1f9518f7/uploads/origins/1f9a3822-4654-4cb0-b32f-1345fe9a2980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1bd655e392c435b4c0a9eed78cff0c1 3x", "genre": "art", "nsfw": false, "body": "下記資料のシロクマの子を描いて頂けないでしょうか?\n服装等はハロウィンに関連したものでお願いしたいです。\nご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1wuH00NRpCdu3WI65Np2FWKxj45eYYFxY", "created_at": "", "completed_at": ""}, {"path": "/@mof_harumaki/works/4", "thumbnail_src": "https://si.imgix.net/f1047e54/uploads/origins/44be98da-ad72-45eb-8070-0b6036074780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b94f60190212bc995c55bc834ddfea1", "thumbnail_srcset": "https://si.imgix.net/f1047e54/uploads/origins/44be98da-ad72-45eb-8070-0b6036074780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b94f60190212bc995c55bc834ddfea1, https://si.imgix.net/f1047e54/uploads/origins/44be98da-ad72-45eb-8070-0b6036074780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fcc896649dd2a3f57c7d47ca668a20b 2x, https://si.imgix.net/f1047e54/uploads/origins/44be98da-ad72-45eb-8070-0b6036074780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfd2751028299688872a4bcf8ee51711 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアートスタイルがとても好きです！\n 私のOC「ユナ」を依頼したいと思っています。\n彼女は星を見るのが大好きな狼の女の子で、尻尾と髪に青から紫の星空の美しいグラデーションがかかっています。\n参考資料はこちら :3\nhttps://imgur.com/a/cpwz9Zl\n*手には肉球がありません。\n*足にはピンクの肉球があります。\n*デフォルトはミニスカート。\n-----\n\n背景、表情、ポーズなどすべて自由に描けます！\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@mof_harumaki/works/3", "thumbnail_src": "https://si.imgix.net/3ee7e737/uploads/origins/25e413dd-32dc-4eec-b7ce-5c02de0b70dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e9edf91f03cd3c226eda312725b264", "thumbnail_srcset": "https://si.imgix.net/3ee7e737/uploads/origins/25e413dd-32dc-4eec-b7ce-5c02de0b70dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e9edf91f03cd3c226eda312725b264, https://si.imgix.net/3ee7e737/uploads/origins/25e413dd-32dc-4eec-b7ce-5c02de0b70dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77b1dedadb8feda4a8632d689b528f56 2x, https://si.imgix.net/3ee7e737/uploads/origins/25e413dd-32dc-4eec-b7ce-5c02de0b70dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbad9024b37ee63df3a92e0aef530466 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のドラゴンのキャラクター、カエンを見てみたい！\n肌触りのいいセーターを着ているところが見たい。他のディテールやポーズも自由に選んでください！\n\nhttps://drive.google.com/drive/folders/16y_aP2KIwC7WtE9ujoObrcm9OA6Sc7vs", "created_at": "", "completed_at": ""}, {"path": "/@mof_harumaki/works/2", "thumbnail_src": "https://si.imgix.net/072aeb44/uploads/origins/31ce5f29-ffba-41f3-8d7b-bfde6219f593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b868dd39da7f855ab5ac7d9f04bc445", "thumbnail_srcset": "https://si.imgix.net/072aeb44/uploads/origins/31ce5f29-ffba-41f3-8d7b-bfde6219f593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b868dd39da7f855ab5ac7d9f04bc445, https://si.imgix.net/072aeb44/uploads/origins/31ce5f29-ffba-41f3-8d7b-bfde6219f593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=133341fd7bba16be4c27f6ca1b44af4d 2x, https://si.imgix.net/072aeb44/uploads/origins/31ce5f29-ffba-41f3-8d7b-bfde6219f593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8de193a4d2bd145c1960f4d3cd57cfcd 3x", "genre": "art", "nsfw": false, "body": "こんにちは!\nいつもイラスト拝見しています!!\n\n今回は東京放課後サモナーズというゲームに登場する\n『スネグーラチカ』というキャラを描いて頂きたいです\n(本当はデカいケモ描いてもらおうと思っていたのですが、知ってるキャラは大体FA描いていたので...)\n\nシチュエーションは時期に合わせて初詣とか...\n勿論他のシチュでも構いません!\n自由にお描きいただければと思います\nまた、服装は添付資料の中からどれか1つ選んで頂けると幸いです\n\nよろしくお願いします!\n\n以下参考資料です\nhttps://cdn.wikiwiki.jp/to/w/housamo/%E3%82%B9%E3%83%8D%E3%82%B0%E3%83%BC%E3%83%A9%E3%83%81%E3%82%AB/::attach/snegurochka_3_skin2.jpg?rev=49587512992c4550637dfa3f729578f6&t=20241215112230\n\nhttps://cdn.wikiwiki.jp/to/w/housamo/%E3%82%B9%E3%83%8D%E3%82%B0%E3%83%BC%E3%83%A9%E3%83%81%E3%82%AB/::attach/snegurochka_3_skin1.jpg?rev=fe40cc06d659af2650865e679d122cd3&t=20241215112218\n\nhttps://cdn.wikiwiki.jp/to/w/housamo/%E3%82%B9%E3%83%8D%E3%82%B0%E3%83%BC%E3%83%A9%E3%83%81%E3%82%AB/::attach/snegurochka_3_skin5.jpg?rev=cc048402117af5ac3c4a8a892c9b64ba&t=20241215112304", "created_at": "", "completed_at": ""}, {"path": "/@mof_harumaki/works/1", "thumbnail_src": "https://si.imgix.net/46174dbd/uploads/origins/361ae0a6-03a2-4e06-a9d2-57266d0d25b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77023838f3c888261f2e8752ec2ad563", "thumbnail_srcset": "https://si.imgix.net/46174dbd/uploads/origins/361ae0a6-03a2-4e06-a9d2-57266d0d25b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77023838f3c888261f2e8752ec2ad563, https://si.imgix.net/46174dbd/uploads/origins/361ae0a6-03a2-4e06-a9d2-57266d0d25b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52edfe56005adfe2643e4d75431733ee 2x, https://si.imgix.net/46174dbd/uploads/origins/361ae0a6-03a2-4e06-a9d2-57266d0d25b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6feb638cc93f23590f3ec66ee0ed2bc6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターをリクエストしたいです！バーテンダーの格好で飲み物を出してほしいです！どのような服装にするか、参考資料を用意しました。タイトルは「衣装」です。  参考資料のような豊満なボディをお願いします！表情も明るく親しみやすいものにしてください！あとはお任せします。\n\n細かいディテールはお任せします。尻尾はお尻の上ではなく、襟足の毛のところから始まっています。手の甲に2本のストライプがあります。鼻は白い。\n\nhttps://drive.google.com/drive/folders/1f2cLU_D_uPZc0F5S9MmW-aKoGuSZ5AqF?usp=sharing", "created_at": "", "completed_at": ""}]}