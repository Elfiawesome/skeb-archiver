uploads/origins/92537f87-4222-42ad-9687-6c0a232419db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0224a7d7aa2eac1e69c968adc980199, https://si.imgix.net/d9a7fd1f/uploads/origins/92537f87-4222-42ad-9687-6c0a232419db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bcbdb4043be81c1cdd64fd31c2c9bc1 2x, https://si.imgix.net/d9a7fd1f/uploads/origins/92537f87-4222-42ad-9687-6c0a232419db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb753e00a897321cc5ace87b9e21d2cb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@red_cornea_blue/works/520", "thumbnail_src": "https://si.imgix.net/2098b87a/uploads/origins/5e833f4e-725d-4b84-8360-3bb0bce35765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a1331d96265ca87869ff1160664a7a6", "thumbnail_srcset": "https://si.imgix.net/2098b87a/uploads/origins/5e833f4e-725d-4b84-8360-3bb0bce35765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a1331d96265ca87869ff1160664a7a6, https://si.imgix.net/2098b87a/uploads/origins/5e833f4e-725d-4b84-8360-3bb0bce35765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06e1d14b1ae36b949a7a235a48205c5b 2x, https://si.imgix.net/2098b87a/uploads/origins/5e833f4e-725d-4b84-8360-3bb0bce35765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7513ba8c818a9f3d9953f7af086b411e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@red_cornea_blue/works/519", "thumbnail_src": "https://si.imgix.net/ddb08181/uploads/origins/747fa31c-e5d1-4eea-9a7b-e003faf2a287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60018ea9b72c22687466ac21de953e0", "thumbnail_srcset": "https://si.imgix.net/ddb08181/uploads/origins/747fa31c-e5d1-4eea-9a7b-e003faf2a287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60018ea9b72c22687466ac21de953e0, https://si.imgix.net/ddb08181/uploads/origins/747fa31c-e5d1-4eea-9a7b-e003faf2a287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af8d05ed978f461a7cec2d7dbb3ab472 2x, https://si.imgix.net/ddb08181/uploads/origins/747fa31c-e5d1-4eea-9a7b-e003faf2a287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5228d0b1b4f770b5a9c31c4121837d14 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\n\nキャラクター：レーシングミク2022\nhttps://www.goodsmileracing.com/racingmiku2022/\n一番上の、白いジャケットに黒いインナーのコスチュームです。\nレイプ時はレオタードの股の部分のみ切り裂かれた状態。着衣はなるだけ乱さず、ほぼ完全着衣セックスでお願いします。\n\nシチュエーション：健全絵からのレイプ絵という構成。\n撮影会という名目で連れ込まれ、二人の男に串刺しファックされる。物として犯し捨てる感じで。\nストーリー仕立てでお願い致します。難しいシーンがあれば描きやすく変えて頂いて構いません。\n\n①「わぁ、カッコイイ衣装です！今日の撮影会宜しくお願いします！」\nコスチュームに身を包み、笑顔で愛嬌をふりまくミクさん。\n\n②違う意味の撮影会とは思わなかったミクさん、不意打ちで力任せの腹パンを受け、悶絶。\n\n③崩れ落ちて跪いたミクの頭をガッチリ掴み、喉奥まで犯すイラマチオ。\nもう一人の男はツインテールを手綱のように引っ張りながらバックでガン突き。\n「自慢の喉を犯されてる気分はどうだ！？」「中出ししても孕まねえんだろ？都合がいい等身大オナホだな！」\n前後同時に射精され目を見開かせる。\n\n④倒れこんだミクにチョークスリーパーのように首に腕を巻き付け、締めあげながら寝バック。\n失神寸前で苦痛から逃げようとするミクをガッチリとホールドし、潰すような勢いで犯して中出し。\n\n⑤仰向けにひっくり返して、今度は正常位レイプと仰向けイラマ。華奢な体は弓なりにそり返る。\n口を犯す方は喉を絞めながら、正常位で犯す方は時折腹を殴りながらオモチャを壊すような扱い。\n男達は「さすがご自慢の喉だ、よく締まる。楽しみたいからまだ壊れるんじゃねえぞ」「こっちも殴ったら締まりやがる。満足するまで使ってやるよ」と身勝手なセリフ。ミクは意識が飛びかけていて僅かに呻きながら、ビクンビクンと痙攣するのみ。\nやがて前後に射精されて、声にならない悲鳴をあげる。\n\n⑥事後。何度も精液を吐き出され、艶のある黒いレオタードをぐちょぐちょにされて仰向けに横たわるミクを真上から視点で。\n\n下腹部に子宮をノックするような効果音や、擬音や濁った呻き・喘ぎ声を適宜添えて頂けるととても嬉しいです。\n\n以上、宜しければお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@red_cornea_blue/works/518", "thumbnail_src": "https://si.imgix.net/9db4327a/uploads/origins/eaaf9245-610d-4000-96aa-f36693f0721b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d210f0bbca557a49fd5c0bd969c4a4", "thumbnail_srcset": "https://si.imgix.net/9db4327a/uploads/origins/eaaf9245-610d-4000-96aa-f36693f0721b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d210f0bbca557a49fd5c0bd969c4a4, https://si.imgix.net/9db4327a/uploads/origins/eaaf9245-610d-4000-96aa-f36693f0721b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=775942f002abdc9fedabdab1d7b1ec23 2x, https://si.imgix.net/9db4327a/uploads/origins/eaaf9245-610d-4000-96aa-f36693f0721b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29d5dc9c504303d76a945525f619de6f 3x", "genre": "art", "nsfw": true, "body": "以前に↓のイラストをリクエストさせて頂いた者です。\nhttps://skeb.jp/requests/980818\n\n今回は同じキャラクターともう一人、下記リンク先のキャラクターの２名のイラストをリクエストさせていただきます。\nhttps://www.pixiv.net/artworks/83633750\nhttps://www.pixiv.net/artworks/92901088\n\n以下、希望です。\n・両腕を掴まれた立ちバックの状態でキスをさせられるシチュエーション\n（下記リンク先のイラストが希望にピッタリの構図でした）\nhttps://skeb.jp/@red_cornea_blue/works/469\n・２名とも全身が痣と傷だらけで、流血アリ、精液まみれ\n・前回のリクエストと同様に、カラータイマーは２名とも赤色\n・２名の間で身長差をつけてください（サイドポニーが155cm、三つ編みが145cmぐらいのイメージです）\n\n何卒よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@red_cornea_blue/works/517", "thumbnail_src": "https://si.imgix.net/6d91669f/uploads/origins/0897ba6e-93e1-451e-8733-c4fba0f4a23e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30f86981f0b3ed2e83b0b75a9a76083f", "thumbnail_srcset": "https://si.imgix.net/6d91669f/uploads/origins/0897ba6e-93e1-45