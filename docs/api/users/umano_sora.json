ed_at": "", "completed_at": ""}, {"path": "/@umano_sora/works/3", "thumbnail_src": "https://si.imgix.net/d6bda315/uploads/origins/2258379e-28e3-420a-8d98-2b8b9f4ce7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549d272f641f6c3eeb75f1bdc2f19565", "thumbnail_srcset": "https://si.imgix.net/d6bda315/uploads/origins/2258379e-28e3-420a-8d98-2b8b9f4ce7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549d272f641f6c3eeb75f1bdc2f19565, https://si.imgix.net/d6bda315/uploads/origins/2258379e-28e3-420a-8d98-2b8b9f4ce7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74efe4b70765eb2eafba7a309eca6f0f 2x, https://si.imgix.net/d6bda315/uploads/origins/2258379e-28e3-420a-8d98-2b8b9f4ce7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d40f781461525dd69e47ae04fb2b57e9 3x", "genre": "art", "nsfw": false, "body": "umanoさん、こんにちは！\n主にMisskeyでお世話になってます、ばるぶＣです。いつもありがとう！\n\n◆リクエスト内容\nうちの子の「フェリス」を描いて頂けたら嬉しいです。黒猫がモチーフで、デザインは下記の参考資料を参照ください。\n雨模様あるいは薄暗い曇天で、ディストピアっぽい雰囲気の、やや無機質的な建物の並ぶ街並みにいる姿を希望します。umanoさんの描く、ライティングで大胆に構図をとりながらも丁寧に細部を描かかれる風景描写がとても好きなので、背景の割合が大きくても大歓迎です。キャンバスのアスペクト比16:9の横長構図であると嬉しいです。\nその他、ポーズ及びシチュエーションはお任せします。\n\nhttps://media.misskeyusercontent.jp/io/afe6d9c0-cd54-4976-9d83-6af3f7db9103.webp", "created_at": "", "completed_at": ""}, {"path": "/@umano_sora/works/2", "thumbnail_src": "https://si.imgix.net/beb69c7c/uploads/origins/b2b3fbbe-8319-469b-8c92-3b00ebe2fed1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f4c6943d3d0cc1695787756726c7d2", "thumbnail_srcset": "https://si.imgix.net/beb69c7c/uploads/origins/b2b3fbbe-8319-469b-8c92-3b00ebe2fed1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f4c6943d3d0cc1695787756726c7d2, https://si.imgix.net/beb69c7c/uploads/origins/b2b3fbbe-8319-469b-8c92-3b00ebe2fed1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbdac63febd61baa6cccb0c2db9b1df4 2x, https://si.imgix.net/beb69c7c/uploads/origins/b2b3fbbe-8319-469b-8c92-3b00ebe2fed1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18b0e7c3ea5f4084cf54692627e6fd6f 3x", "genre": "art", "nsfw": false, "body": "umanoさん、こんにちは。最近、あなたの美しいトロロの絵を見つけたばかりで、その描き方にとても魅了されました！\n\nもしご迷惑でなければ、私のOCであるイナのイラストをお願いしてもよろしいでしょうか？彼女はクールな物腰で、植物学を勉強しています。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1ADqeHxWize-XHZaJqU5NcwkoXzszrHVU", "created_at": "", "completed_at": ""}, {"path": "/@umano_sora/works/1", "thumbnail_src": "https://si.imgix.net/cb3b1149/uploads/origins/f9c9b9b7-35e4-451f-8412-a4f6a0631c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3460f0ea7dcddeae6f834e2a7834d758", "thumbnail_srcset": "https://si.imgix.net/cb3b1149/uploads/origins/f9c9b9b7-35e4-451f-8412-a4f6a0631c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3460f0ea7dcddeae6f834e2a7834d758, https://si.imgix.net/cb3b1149/uploads/origins/f9c9b9b7-35e4-451f-8412-a4f6a0631c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f7f5b4c98b1e90b9756b1938da306b4 2x, https://si.imgix.net/cb3b1149/uploads/origins/f9c9b9b7-35e4-451f-8412-a4f6a0631c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=465c82ccf723afac6e429b7123fe1ebc 3x", "genre": "art", "nsfw": false, "body": "はやさかあいのドローイングをお願いします。", "created_at": "", "completed_at": ""}]}