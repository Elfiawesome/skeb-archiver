8fcf-7ce2832ad1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcfec9dde91cf99b9808e2ad6aa7ab20", "thumbnail_srcset": "https://si.imgix.net/279d61e6/uploads/origins/4a33cb1e-311c-47b4-8fcf-7ce2832ad1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcfec9dde91cf99b9808e2ad6aa7ab20, https://si.imgix.net/279d61e6/uploads/origins/4a33cb1e-311c-47b4-8fcf-7ce2832ad1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd8d395d05fbba182b42a39de9530646 2x, https://si.imgix.net/279d61e6/uploads/origins/4a33cb1e-311c-47b4-8fcf-7ce2832ad1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84386088ec858954565d1d7f1dff7f82 3x", "genre": "art", "nsfw": true, "body": "はじめまして！今回の依頼は先生に私のキャラクターを描かせたいと思います！\n　先生の絵はとても好きだから、絵のテーマは任せたい、どんな主題でも構いません。できれば、絵はsfwとnsfwの二つの差分がほしい。\n　私のキャラクター: https://drive.google.com/file/d/1Sx8yAlCo34Gdy2YbyTkbXYs7GQSUw2sD/view?usp=drivesdk\n　参考用のもの: https://drive.google.com/file/d/1NjgWNUtTK5Ga2_sFg4AXJC6mo4h_M93c/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1R4ZbA1iCihBd2cak1uGorI0UqIGkx0cq/view?usp=drivesdk\n　よろしくお願いします🥺", "created_at": "", "completed_at": ""}, {"path": "/@_steelwire/works/6", "thumbnail_src": "https://si.imgix.net/10cc973f/uploads/origins/55e8d004-6081-4580-9f61-f63b2d2b4600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e289df7466b1576750b158a17e5e1b3", "thumbnail_srcset": "https://si.imgix.net/10cc973f/uploads/origins/55e8d004-6081-4580-9f61-f63b2d2b4600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e289df7466b1576750b158a17e5e1b3, https://si.imgix.net/10cc973f/uploads/origins/55e8d004-6081-4580-9f61-f63b2d2b4600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75bb9982eaf630bfd7f2c79a20264d73 2x, https://si.imgix.net/10cc973f/uploads/origins/55e8d004-6081-4580-9f61-f63b2d2b4600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7293865744ff435cbde1b2ca111226d 3x", "genre": "art", "nsfw": true, "body": "上半身は裸、下半身はビキニパンツとニーパッド姿で\nマッスルポーズをとる\n筋肉少年プロレスラーくんのイラストをリクエストしたいです！🙇‍♂️", "created_at": "", "completed_at": ""}, {"path": "/@_steelwire/works/5", "thumbnail_src": "https://si.imgix.net/c0d0d8c9/uploads/origins/a787abc1-aeda-411e-8fef-eb56a3b8eb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a80aa758ea5c9f78866ea898c082ad3", "thumbnail_srcset": "https://si.imgix.net/c0d0d8c9/uploads/origins/a787abc1-aeda-411e-8fef-eb56a3b8eb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a80aa758ea5c9f78866ea898c082ad3, https://si.imgix.net/c0d0d8c9/uploads/origins/a787abc1-aeda-411e-8fef-eb56a3b8eb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75bdadd5d371b8e56f959a8fc2b7d2ad 2x, https://si.imgix.net/c0d0d8c9/uploads/origins/a787abc1-aeda-411e-8fef-eb56a3b8eb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4cc51b8eb4f4c7362feaf2ee838b6c4 3x", "genre": "art", "nsfw": true, "body": "おはようございますこんにちはこんばんは!\n\n鉄線さんのとこの親方さんがとても好きなので、親方さんのNSFWが見たいです!\n\n内容としては、仕事の合間に汗だくで性処理を済ませるという感じで...セリフないしは擬音ありでお願いしたいです!\n差分で全裸があると嬉しいです!\nあと、無理でなければ、落書きでいいので、後日談...?みたいな感じで、チタンくんに目撃されたところもお願いしたいです...!\n\nよろしくお願いします...!", "created_at": "", "completed_at": ""}, {"path": "/@_steelwire/works/4", "thumbnail_src": "https://si.imgix.net/8390d2ae/uploads/origins/8033f4f0-1f37-4e2d-b67a-8e2b1dfcd6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d19e7d605426e68a29eb80bf663f2321", "thumbnail_srcset": "https://si.imgix.net/8390d2ae/uploads/origins/8033f4f0-1f37-4e2d-b67a-8e2b1dfcd6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d19e7d605426e68a29eb80bf663f2321, https://si.imgix.net/8390d2ae/uploads/origins/8033f4f0-1f37-4e2d-b67a-8e2b1dfcd6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca9afb29ce3d6c88c0b3a1a1762ee78c 2x, https://si.imgix.net/8390d2ae/uploads/origins/8033f4f0-1f37-4e2d-b67a-8e2b1dfcd6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88cffcc0790d3f8febd71797999524a0 3x", "genre": "art", "nsfw": true, "body": "こんにちは。私はいつもあなたの少年のイラストを高く評価しています。エロさと可愛らしさが絶妙にミックスされていますよね。あなたのスタイルで私のOCを描くのを見てみたいです。\n\nキャラクターの名前は、白夜 チラ（Tira）です。彼はかわいいタイプの男の子です。ちょっとツンデレです。安倍晴明のもとで白虎の式神を務めていました。雷はこのキャラクターの大きな要素の一つです。好きな構図、好きな服装で描いてください。せっかくお上手なのだから、ちょっとエッチなシーンも見てみたいなぁ...。^_^ (公開されるので、R15でお願いします！)\n\nご検討の程、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1PzE5DxmuznSx-E3fIgkbb4qkJ6JAJE7a", "created_at": "", "completed_at": ""}, {"path": "/@_steelwire/works/3", "thumbnail_src": "https://si.imgix.net/208359f4/uploads/origins/10c662fa-c4ed-4a23-8daa-6df0f0d5650f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147ae06e22ff55a4d14979d9519a614e", "thumbnail_srcset": "https://si.imgix.net/208359f4/uploads/origins/10c662fa-c4ed-4a23-8daa-6df0f0d5650f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147ae06e22ff55a4d14979d9519a614e, https://si.imgix.net/208359f4/uploads/origins/10c662fa-c4ed-4a23-8daa-6df0f0d5650f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfc21caff03d88787fcfb28ed5490074 2x, https://si.imgix.net/208359f4/uploads/origins/10c662fa-c4ed-4a23-8daa-6df0f0d5650f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=572f0ab4150d2249188341aac83a5863 3x", "genre": "art", "nsfw": false, "body": "いつもお疲れさまです\nうちの子リュール・ガイハードくんをお願いします\nトランクスOKです！\n\nhttps://www.pixiv.net/users/1655296", "created_at": "", "completed_at": ""}, {"path": "/@_steelwire/works/2", "thumbnail_src": "https://si.imgix.net/af2fced9/uploads/origins/1d7d0377-0d1b-43d2-a410-3933cc7a7b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9f5d95b96dbca5d6355ffbea903fd7", "thumbnail_srcset": "https://si.imgix.net/af2fced9/uploads/origins/1d7d0377-0d1b-43d2-a410-3933cc7a7b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9f5d95b96dbca5d6355ffbea903fd7, https://si.imgix.net/af2fced9/uploads/origins/1d7d0377-0d1b-43d2-a410-3933cc7a7b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3102b164457aea57289cd8a9db221b64 2x, https://si.imgix.net/af2fced9/uploads/origins/1d7d0377-0d1b-43d2-a410-3933cc7a7b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6550ebf0629e0de08b04b0b07995ad57 3x", "genre": "art", "nsfw": true, "body": "steelwireさん、こんにちは。\n\n二人のショタ超人が一緒にエッチなことをするのをリクエストしてもいいですか？\n\nできれば彼の膨らみとおへそが見たいのですが、あとはあなたのアイデア次第です。\n\nありがとうございます！あなたの作品が大好きです\n\nhttps://drive.google.com/folderview?id=17XakmBFLpMhsqk701T5FF-_q7q42D0DS", "created_at": "", "completed_at": ""}, {"path": "/@_steelwire/works/1", "thumbnail_src": "https://si.imgix.net/33860f4d/uploads/origins/f7a4968d-0e1c-4874-b360-ce3e99afbfe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef2c0b11767371f08fb8c8ea07d9e37", "thumbnail_srcset": "https://si.imgix.net/33860f4d/uploads/origins/f7a4968d-0e1c-4874-b360-ce3e99afbfe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef2c0b11767371f08fb8c8ea07d9e37, https://si.imgix.net/33860f4d/uploads/origins/f7a4968d-0e1c-4874-b360-ce3e99afbfe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed6795448fb794de7989761adf5fa976 2x, https://si.imgix.net/33860f4d/uploads/origins/f7a4968d-0e1c-4874-b360-ce3e99afbfe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=226f21f7be142f59d8fa7e13aba2e545 3x", "genre": "art", "nsfw": false, "body": "鉄線さんこんにちは、二人の男の子一緒にいるのイラストがお願いいします、用は最大限には自分用と限れます。姿勢と表情はうーるさん一番気楽のしてください。この上で人に幸せと快楽と感じれる絵なら一番素敵だと思います。 具体的なキャラクターモデルはこちらです：https://weibo.com/5023532853/Jo9wFvua4?pcfrom=msgbox&type=comment#_rnd1602229707581この中の 青いセーターを着ってる子　と　緑色スウェットを着ってる子、二人が一緒にいるの絵でお願いします。ありがとうございます。\n\nhttps://weibo.com/5023532853/Jo9wFvua4?pcfrom=msgbox&type=comment#_rnd1602229707581", "created_at": "", "completed_at": ""}]}