db31eac8efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=947d9ec08e04d13a316a931c241e9c2d", "thumbnail_srcset": "https://si.imgix.net/f138fd7a/uploads/origins/d4a9c026-ca87-491e-8038-fdb31eac8efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=947d9ec08e04d13a316a931c241e9c2d, https://si.imgix.net/f138fd7a/uploads/origins/d4a9c026-ca87-491e-8038-fdb31eac8efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2d5b1376f46001c19139f634ee28c04 2x, https://si.imgix.net/f138fd7a/uploads/origins/d4a9c026-ca87-491e-8038-fdb31eac8efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8be8b638a7b41f7f3424aac49027259b 3x", "genre": "art", "nsfw": true, "body": "初めまして！あなたの作品が大好きなので、私のオリジナルキャラクターを描いてほしいです。キャラクターの具体的な設定はURLリンクにあります。\n\n内容\n· 触手を題材にしているが、あまり多くの触手が画面を占めてほしくない。\n\n· 主な構図はスカートをめくってパンツが漏れることで、触手に身体を拘束される。キャラクターの全身を必ず描いてください。\n\n· できるだけ本来の服装設定を維持し、少しでもダメージを与えることができますが、あまり多くはありません。\n\n· キャラクターの表情はご自由にどうぞ、楽しみにしています。\n\n· NSFWとしてカウントされるかわからない内容だったのでタグ付けしました、性描写は必要ありませ\n\n·背景についても何の考えもありませんので、ご自由にお役立てください。\n\n·キャラクターは天然ボケの性格なので、参考になるかどうかはわかりませんが。\n\n参考資料です:\nhttps://imgur.com/a/BKJC4K0\nhttps://imgur.com/a/VJQhd6b\n\nどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@llcbluckg_c004/works/174", "thumbnail_src": "https://si.imgix.net/8c493280/uploads/origins/3e452df4-d10a-44ef-bdaa-16a50fe17c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=531b5396d24a6acfc1c70402d0022540", "thumbnail_srcset": "https://si.imgix.net/8c493280/uploads/origins/3e452df4-d10a-44ef-bdaa-16a50fe17c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=531b5396d24a6acfc1c70402d0022540, https://si.imgix.net/8c493280/uploads/origins/3e452df4-d10a-44ef-bdaa-16a50fe17c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1025fccdccbd754d14e3f5ccb9e42bb1 2x, https://si.imgix.net/8c493280/uploads/origins/3e452df4-d10a-44ef-bdaa-16a50fe17c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6aa0af66b3c5999fb3e5cfc7e7ac7d0 3x", "genre": "art", "nsfw": true, "body": "2006年TVSP『ルパン三世 セブンデイズ・ラプソディ』ミシェル・キューイックのエロイラストをお願いします。 \n・全裸陰毛あり \nシチュエーション  \n背面座位の状態でキャラクターが犯されている状態（肥満体の大柄な男に身体を後ろからロックされ、キャラクターの足は開き気味で挿入部がよく見える状態）  \n内容　差分  \n①基本的に嫌がり、号泣状態で挿入から中出し。体格差のある男に犯されてるので、精液は多めで溢れてる描写（中出しは2回希望です）  \n②途中に他の男にちんぽを顔に近づけられ、怯えた表情をしつつ顔射される  \n以上になります。 \nよろしくお願いいたします。  \n参考ミシェル\nhttps://www.google.co.jp/search?q=%E3%83%AB%E3%83%91%E3%83%B3%E4%B8%89%E4%B8%96%E3%80%80%E3%83%9F%E3%82%B7%E3%82%A7%E3%83%AB&udm=2&tbs=rimg:CWVnNDE2Bb_18YeHA-rtRVdCWsgIaCgIIABAAKAE6BAgBEAFAAVWqOD8_1beJqoj7AAgDYAgHgAgA&hl=ja&sa=X&ved=0CBgQuIIBahcKEwig7-jJkt", "created_at": "", "completed_at": ""}, {"path": "/@llcbluckg_c004/works/173", "thumbnail_src": "https://si.imgix.net/6014c03b/uploads/origins/e20fbad1-da95-4ea8-a536-f532dbe99ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4277a657ab61b367f252ba45ca0da010", "thumbnail_srcset": "https://si.imgix.net/6014c03b/uploads/origins/e20fbad1-da95-4ea8-a536-f532dbe99ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4277a657ab61b367f252ba45ca0da010, https://si.imgix.net/6014c03b/uploads/origins/e20fbad1-da95-4ea8-a536-f532dbe99ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf7338f3e2915552f4beb217a6aeb5db 2x, https://si.imgix.net/6014c03b/uploads/origins/e20fbad1-da95-4ea8-a536-f532dbe99ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43b08b926014fd35d73054f99293e2c0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ルーナノヴァとフィリピーノに登場する注目の魔女キャラ、リトルウィッチアカデミアのスーシィ・マンババランです！以下リンクでスーシーの姿をどうぞ：\nhttp://littlewitchacademia.jp/tv1st/chara/03.html\nhttps://little-witch-academia.fandom.com/wiki/Sucy_Manbavaran/Gallery\n\n紫の魔女服にルーナノヴァの帽子をかぶり、ポーションと毒キノコを持ち、足が幽霊の形をしているため幽霊のように浮いていて、いつものつまらなそうな表情で視聴者を見ていて、さらにサメの歯を見せて微笑んでいるオマケの変顔をしているスーシーの全身を見てみたい。\n\n背景は紫系がいいのですが、それとポーズはお任せします。ご検討のほど、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@llcbluckg_c004/works/172", "thumbnail_src": "https://si.imgix.net/063ab4ab/uploads/origins/64acb55f-38fc-4c9e-8a5e-a0cf6c7e9292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3171b95dadef949d735c8e7069bdb23", "thumbnail_srcset": "https://si.imgix.net/063ab4ab/uploads/origins/64acb55f-38fc-4c9e-8a5e-a0cf6c7e9292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3171b95dadef949d735c8e7069bdb23, https://si.imgix.net/063ab4ab/uploads/origins/64acb55f-38fc-4c9e-8a5e-a0cf6c7e9292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2de9aee70c254b04ee35cfb8cd2e1381 2x, https://si.imgix.net/063ab4ab/uploads/origins/64acb55f-38fc-4c9e-8a5e-a0cf6c7e9292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67dd44cfd0b9abc98a9f76ae2ca66722 3x", "genre": "art", "nsfw": false, "body": "初めまして、リクエストさせて頂きます。\n\n他の方のリクエストで描かれた、\nhttps://skeb.jp/@llcbluckg_c004/works/163\nこちらの女の子ですが、ツインテールと胸元のリボンが特徴的な制服姿がとても可愛かったです。\n\n元絵の1コマ目は上半身だけですが、\nもしよろしければ、同じ娘のイラストで、下半身まで含めたイラストをお願いしてもよろしいでしょうか？\n\n表情は明るい表情でお願いします。\n髪型、服装、アクセサリー等は元絵と同じでお願いします。\nまた、スカートなど、元絵に描かれていない箇所の色・柄などはおまかせします。\n\n構図など、その他諸々はお任せします。ご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@llcbluckg_c004/works/171", "thumbnail_src": "https://si.imgix.net/ee6674ab/uploads/origins/20635a42-bc35-45ae-a683-c3327e56aba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddcb48cf31c8451cfd920f3b388346a1", "thumbnail_srcset": "https://si.imgix.net/ee6674ab/uploads/origins/20635a42-bc35-45ae-a683-c3327e56aba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddcb48cf31c8451cfd920f3b388346a1, https://si.imgix.net/ee6674ab/uploads/origins/20635a42-bc35-45ae-a683-c3327e56aba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58709c