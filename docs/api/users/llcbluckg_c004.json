&filetype=msword\n\nhttps://docs.google.com/file/d/1HNjFHvclqTcoWXwunFOFOO5ewPsMwWqC/edit?usp=docslist_api&filetype=msword", "created_at": "", "completed_at": ""}, {"path": "/@llcbluckg_c004/works/166", "thumbnail_src": "https://si.imgix.net/94097016/uploads/origins/d8f8a513-833d-4726-a1ae-8bab0ccd6ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb9686b837f84c0d99cb203a10ef41b3", "thumbnail_srcset": "https://si.imgix.net/94097016/uploads/origins/d8f8a513-833d-4726-a1ae-8bab0ccd6ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb9686b837f84c0d99cb203a10ef41b3, https://si.imgix.net/94097016/uploads/origins/d8f8a513-833d-4726-a1ae-8bab0ccd6ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27d0b371c2b988aa3af04b52899e0f0e 2x, https://si.imgix.net/94097016/uploads/origins/d8f8a513-833d-4726-a1ae-8bab0ccd6ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13ac0b3720f81c9f14ab144389904c70 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@llcbluckg_c004/works/165", "thumbnail_src": "https://si.imgix.net/fe65a17f/uploads/origins/96c11dc1-061b-4de4-9ad7-a678228c40fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f38369cec06d2284b80f4944d6fc8054", "thumbnail_srcset": "https://si.imgix.net/fe65a17f/uploads/origins/96c11dc1-061b-4de4-9ad7-a678228c40fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&t