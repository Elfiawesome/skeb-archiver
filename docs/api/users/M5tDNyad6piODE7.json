e%2Ccenter&txtsize=30&txt=PRIVATE&s=b6041b4147fb7ae40a84ff02560c6866 2x, https://si.imgix.net/265eb448/uploads/origins/5bfaa100-3d4f-4935-91f4-a64863505171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74c99899edad7ad0def96bb0654467d2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@M5tDNyad6piODE7/works/26", "thumbnail_src": "https://si.imgix.net/a5ec9c85/uploads/origins/4dad001e-aa71-4649-b33e-28863bbd16d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44dc5294820e4497b25d69e94093a66f", "thumbnail_srcset": "https://si.imgix.net/a5ec9c85/uploads/origins/4dad001e-aa71-4649-b33e-28863bbd16d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44dc5294820e4497b25d69e94093a66f, https://si.imgix.net/a5ec9c85/uploads/origins/4dad001e-aa71-4649-b33e-28863bbd16d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63c3d762fb776b90817c27c348192d21 2x, https://si.imgix.net/a5ec9c85/uploads/origins/4dad001e-aa71-4649-b33e-28863bbd16d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0198d2ad8de121407bdadaf9e231ac22 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品には神秘的なエネルギーがあふれていて、とても楽しいです。特に目の描き方が魅力的です！\n\n私のOC、レオをお願いしたいです。彼は森の精霊で、怪物のような外見を甘い人間の姿に隠しています。彼はとても狡猾で、彼の森を旅する人々にすぐに執着します。\n\n彼をどのように描くかは、あなたにお任せしたい。彼はモンスターの姿と人間の姿を持っていて、私はその両方にあなたをリンクさせる。人間の姿のまま、首の口の「封印」を解くこともできる。左目の下にビューティーマークがあることに注意してください！着替えは自由です。\n\nありがとうございました！\n\n参照フォルダ: https://drive.google.com/drive/folders/1JG6iWNrmZxu8sxuDjcB9FM8d1c1XZk15?usp=drive_link\nバイオグラフィー: https://toyhou.se/11336460.leo-emrys", "created_at": "", "completed_at": ""}, {"path": "/@M5tDNyad6piODE7/works/25", "thumbnail_src": "https://si.imgix.net/90bd5353/uploads/origins/6856b7ec-75ec-4a8b-b256-56da7bf74e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b7ec519be5b4b3003306890faf8483", "thumbnail_srcset": "https://si.imgix.net/90bd5353/uploads/origins/6856b7ec-75ec-4a8b-b256-56da7bf74e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b7ec519be5b4b3003306890faf8483, https://si.imgix.net/90bd5353/uploads/origins/6856b7ec-75ec-4a8b-b256-56da7bf74e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3f093a62eba6d59a0e82261244cd303 2x, https://si.imgix.net/90bd5353/uploads/origins/6856b7ec-75ec-4a8b-b256-56da7bf74e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1e9770d0e497f1895b61c8a7e1e3eb7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！\n\n私のスーパーヒーローOCをぜひお願いしたいです。名前はアスター。彼女はコウモリの一部です。彼女はとても遊び好きで、昼間はよく眠そうにしています。彼女の目の下に袋を描いてもいいよ。白目は黒っぽい。赤い羽根を首から下げている。スーパーヒーロー・スーツの質感は光沢のある革のよう。牙がある。\n\n自由に描いてください！\n\n使用方法：ソーシャルメディアにアイコンとして使用することができます。個人的な使用のためにプリントアウトすることもできます。\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1DuWZkqf8o78y4q1RBvsakCsoWbq0Lb8_", "created_at": "", "completed_at": ""}, {"path": "/@M5tDNyad6piODE7/works/24", "thumbnail_src": "https://si.imgix.net/3c8650a0/uploads/origins/192339e4-903e-49df-bae9-16dc29175b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac706e86ed55ee8d8d187572295abccb", "thumbnail_srcset": "https://si.imgix.net/3c8650a0/uploads/origins/192339e4-903e-49df-bae9-16dc29175b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac706e86ed55ee8d8d187572295abccb, https://si.imgix.net/3c8650a0/uploads/origins/192339e4-903e-49df-bae9-16dc29175b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe6bf52cd4c2fce96690e39a95892337 2x, https://si.imgix.net/3c8650a0/uploads/origins/192339e4-903e-49df-bae9-16dc29175b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=767c3021835457b2688ae9fa4fafbb11 3x", "genre": "art", "nsfw": false, "body": "こんにちは！良い一日をお過ごしですか？あなたのアートスタイルがとても好きで、ぜひ依頼したいと思っています。\n\n私のオリジナルキャラクター、オータムを見てみたいです。\nオータムに関する参考文献：https://drive.google.com/drive/folders/1clS8LqCFU7P-k9zvMO-OpOC-D8i345wA?usp=drive_link\nオータムは優しくて、とても思いやりのある女性です。彼女はよく微笑みます。両耳にシルバーのイヤリング、ふわふわのミドルレングスのジンジャーヘア。そばかすが目立ちます。彼女の服装については、あなたが望むものを自由に与えてください！\nポーズについては、あなたの好きなように創造的な自由を与えたいと思います。\nお値段が足りない場合や、私のリクエストにご納得いただけない場合は、再送またはキャンセルをお申し付けください。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@M5tDNyad6piODE7/works/23", "thumbnail_src": "https://si.imgix.net/dc933990/uploads/origins/e712f51e-de81-401b-be1c-a8d13fc729cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985a35081e03257cd1b2d1041bc9f12c", "thumbnail_srcset": "https://si.imgix.net/dc933990/uploads/origins/e712f51e-de81-401b-be1c-a8d13fc729cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985a35081e03257cd1b2d1041bc9f12c, https://si.imgix.net/dc933990/uploads/origins/e712f51e-de81-401b-be1c-a8d13fc729cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91ccfe695e55f12a46daf979dd14af3c 2x, https://si.imgix.net/dc933990/uploads/origins/e712f51e-de81-401b-be1c-a8d13fc729cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78e6290fd0cb3d07dfd3eafa53d2ead0 3x", "genre": "art", "nsfw": false, "body": "雛豆さん！お久しぶりです！\nもう一つのイラストめっちゃ可愛かったです！\n僕は、すごく嬉しかった！！！！ヾ（｡✪ω✪｡）ｼ\n雛豆さんのイラストスタイルはめっっっっっっっっっっっっちゃ綺麗だよ！！！♡\n\nポイポヨくんをもう一度描いてください？\nたい焼きアイスを抱えたポイポヨくんの胸像が欲しいです。\nスプリンクルをたくさんください！⋆⭒˚。⋆\n\n僕の別のリクエストを読んでいただき本当にありがとうね！ฅ՞•ﻌ•՞ฅ⋆⭒˚。⋆\n\nこれリンクにはキャラクターのレファレンスイラストあります。\nhttps://drive.google.com/drive/folders/1s0uy7yHtXhwaoQYSfDrnJIeZDaeexlgJ?usp=sharing\n\nhttps://drive.google.com/drive/folders/1s0uy7yHtXhwaoQYSfDrnJIeZDaeexlgJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@M5tDNyad6piODE7/works/22", "thumbnail_src": "https://si.imgix.net/02637611/uploads/origins/54e007b2-0a4c-4ea9-9b31-ae485adb4ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&