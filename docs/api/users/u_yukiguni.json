&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5aefcd314fb6c6218677057afdfff35 3x", "genre": "art", "nsfw": false, "body": "鏡の前で身支度をする涼月をリクエストさせていただきます。\n秘書官担当の日、待ちきれずに早く起きすぎて(午前3時頃)、ウキウキと少し気持ちが昂ってる…ような感じのシチュでお願いします。\n鏡に眠そうな表情で後ろから様子を見ている姉妹艦を誰か1人写してください。(誰かはお任せします。)", "created_at": "", "completed_at": ""}, {"path": "/@u_yukiguni/works/5", "thumbnail_src": "https://si.imgix.net/91ace4e8/requests/83684_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25e256f1d3e923b1f6191df4bc2cad74", "thumbnail_srcset": "https://si.imgix.net/91ace4e8/requests/83684_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25e256f1d3e923b1f6191df4bc2cad74, https://si.imgix.net/91ace4e8/requests/83684_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0021e8846e549af3a28e4961424e9bbe 2x, https://si.imgix.net/91ace4e8/requests/83684_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c24102d5c5bc4b90b796983420b4f71 3x", "genre": "art", "nsfw": true, "body": "グラブルのフェリちゃんのフェラ絵をお願いします。発情期でフェラに夢中しているフェリはストップとか言われてもやめません。できれば射精差分もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@u_yukiguni/works/4", "thumbnail_src": "https://si.imgix.net/837a533d/requests/70986_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe09167624512fb959cfccb6cf46c3f0", "thumbnail_srcset": "https://si.imgix.net/837a533d/requests/70986_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe09167624512fb959cfccb6cf46c3f0, https://si.imgix.net/837a533d/requests/70986_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c4af2cbe158170642e1398c5a17a86a 2x, https://si.imgix.net/837a533d/requests/70986_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0addba1123f368fe169e45302cd4295 3x", "genre": "art", "nsfw": true, "body": "艦これの早霜でc96のおまけ本の水着でパイズリしているイラストをお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@u_yukiguni/works/3", "thumbnail_src": "https://si.imgix.net/5fa4df89/requests/35440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbd135cde3cdd2a6fd398c80f98a678d", "thumbnail_srcset": "https://si.imgix.net/5fa4df89/requests/35440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbd135cde3cdd2a6fd398c80f98a678d, https://si.imgix.net/5fa4df89/requests/35440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d0c2eed42d98f7398018a40755853c1 2x, https://si.imgix.net/5fa4df89/requests/35440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54a6d05b93125104de49563c26bc33ec 3x", "genre": "art", "nsfw": false, "body": "冬のデートがテーマの艦これ天津風をお願いしたいです。\n照れ笑顔で八重歯が見えていて、ミニ丈のすこし露出度高めの私服を着た天津風をどうかお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@u_yukiguni/works/2", "thumbnail_src": "https://si.imgix.net/b17d025d/requests/35537_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f70fe52ef7b11203e96f25e7a5824a", "thumbnail_srcset": "https://si.imgix.net/b17d025d/requests/35537_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f70fe52ef7b11203e96f25e7a5824a, https://si.imgix.net/b17d025d/requests/35537_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=875de00c4ab9d25705afa6f246c41091 2x, https://si.imgix.net/b17d025d/requests/35537_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abda6533cc1ff21954bc5ff834ecc40c 3x", "genre": "art", "nsfw": true, "body": "壁に手をついて少し振り返り妖艶な口元で、立ちバックをおねだりしている、背中やお尻やポニーテールが綺麗な、ガーターなどのエッチな下着をつけた、デレマスの若林智香ちゃんをお願いします。19歳くらいに成長したイメージだとなお嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@u_yukiguni/works/1", "thumbnail_src": "https://si.imgix.net/3ff43c7a/requests/35400_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=123c9fda66ed8a0ed440fa6edf2b6f9a", "thumbnail_srcset": "https://s