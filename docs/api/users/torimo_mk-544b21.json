efe-b9767186060b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af12cf99f89998872a97b3709b197f53 2x, https://si.imgix.net/a865a5c4/uploads/origins/df90b7c4-5f46-4deb-aefe-b9767186060b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=404e6dcf6312343bef3239f0733193d8 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\n今回はうさだヒカルのラ・ビ・アン・ローズの姿でお願いします。\nおっぱいマシマシで腕を組んで胸の谷間が強調された図を希望しています。\n表情はツンデレのツン状態、少しプンプンしている感じでお願いします。\n後、眼鏡も掛けさせてください。フチなしでテンプルが赤系でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@torimo_mk/works/21", "thumbnail_src": "https://si.imgix.net/f0168776/uploads/origins/b956fbbb-0722-4b51-b2ff-cc414e7e6aac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0ef6c22771f1c9fec6e3ff9f3c4713d", "thumbnail_srcset": "https://si.imgix.net/f0168776/uploads/origins/b956fbbb-0722-4b51-b2ff-cc414e7e6aac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0ef6c22771f1c9fec6e3ff9f3c4713d, https://si.imgix.net/f0168776/uploads/origins/b956fbbb-0722-4b51-b2ff-cc414e7e6aac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51461fe9d04ce5badb40ac4165c0d4bd 2x, https://si.imgix.net/f0168776/uploads/origins/b956fbbb-0722-4b51-b2ff-cc414e7e6aac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=276d8e8c79f16c53ca0797b5f03add96 3x", "genre": "art", "nsfw": false, "body": "（リクエスト再送失礼します）\n\n松本救助先生、こんにちは。\n\n以前、『超速変形ジャイロゼッター』という作品の「松堂言葉さん」をリクエストした者です。\n\nその節は、オシャレでセクシーなお姉さん成分たっぷりなイラストに仕上げて頂き、有難うございました…！見返す度にドキドキがぶり返します…！\n\n改めまして、リクエスト失礼致します。\n\n先生は、艶のあるキャラに限らず、可愛らしいキャラも沢山描いてらっしゃる様にお見受け致します。\n\nこの度は、ある可愛らしいお姉さんキャラに関して、是非腕を振るって頂けたらな…と思った次第です。\n\n以下、詳細となります。ご検討の程、宜しくお願い致します。\n\n\n作品名：『特等添乗員αの難事件』\n\nキャラクター名：「浅倉 絢奈（あさくら あやな）」\n（小悪魔っぽい魅力を秘めた、ツアーコンダクターのお姉さんです。）\n\n構図・表情：お任せ致します。\n\nその他：特にメガネをかけているキャラクターではないのですが、やはりメガネ要素が大好きなので…松本先生が「この子には、こういう色・形の眼鏡が似合うのでは？」と、ピンときたチョイスがあれば、是非拝見できると大変嬉しいです。\n\n（前回リクエストの際にも、先生にメガネを選んで頂きましたが…セルわっぱな眼鏡といった、素敵なチョイスをして頂けて、非常に嬉しかったです…！）\n\n\n・キャラクター資料　\n※下記ページ、いずれも「試し読み」ボタンから、少し大きい画像をご確認いただけます。\n\nhttps://bookwalker.jp/de2aa85399-6dcf-48d3-874e-6db0a8d15f77/\nhttps://bookwalker.jp/dea09b3d8a-4d96-4085-9cdb-95cfa1ec772f/\nhttps://bookwalker.jp/de2ebfbc57-6853-4947-b35e-09efd1be3bfb/\nhttps://bookwalker.jp/decffdad3e-9ab2-4099-bd5e-10d033664c1e/\nhttps://bookwalker.jp/de41998b75-a9d5-4156-9af7-963267ce5eb7/", "created_at": "", "completed_at": ""}, {"path": "/@torimo_mk/works/20", "thumbnail_src": "https://si.imgix.net/9e0fd597/uploads/origins/bbccdd2c-da27-440d-8ba7-5572d6396c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0e1ed55e97eb503ec2f17669ab8bbbf", "thumbnail_srcset": "https://si.imgix.net/9e0fd597/uploads/origins/bbccdd2c-da27-440d-8ba7-5572d6396c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0e1ed55e97eb503ec2f17669ab8bbbf, https://si.imgix.net/9e0fd597/uploads/origins/bbccdd2c-da27-440d-8ba7-5572d6396c31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abb600b867cf6707d7e79e262a471b63 2x, https://si.imgix.net/9e0fd597/uploads/origins/bbccdd2c-da27-440d-8ba7-5572d6396c31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c32aec2741848deb562fbc5c1c480fc 3x", "genre": "art", "nsfw": false, "body": "はじめまして。私はYouTubeやIRIAMにてVliverとして活動をしている寿々華(すずか)と申します。\n松本先生のイラストや漫画、眼鏡を以前から拝見しております。\nとても大好きな松本先生がskebをされているとのことでして、クエストさせていただきました。\n\n●構図\n着物を着ている寿々華をお願いしたいです。\n構図や着物の色柄等はお任せさせてください。\n衣装等資料URLに載せておりますが、特徴が合っていればヘアアレンジ等問題ありません。\n●使用用途\nYoutubeやIRIAMでの配信用のサムネイル\n各種SNS\nファンの方に配布するヘッダーやネットプリント\nもしよろしければ描いて頂いたイラストを用いて眼鏡拭きやクリアファイル等にさせて頂きたいと思っております。(商用利用)\n●形式\n可能であれば背景とキャラは分けたデータ(背景透過)も納品頂けると嬉しいです。\n\nどうぞよろしくお願い致します。\n\n寿々華(すずか)\nTwitter：https://twitter.com/suzuka_mell?t=yC9HxrIW_FCHJaGUYPOkWw&s=09\nYouTube：https://youtube.com/channel/UCl-gSAtzmHI1gOJwBSysSjQ\nIRIAM：https://web.iriam.app/s/user/WK54aj\n年齢：20代\n身長：166cm\n性別：女\n容姿：紫の前髪ぱっつ