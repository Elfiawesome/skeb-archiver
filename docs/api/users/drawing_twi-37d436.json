3880a523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f357e001ac9fef20fefab58575512fd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@drawing_twi/works/13", "thumbnail_src": "https://si.imgix.net/e1624280/uploads/origins/ae1474c4-cb1e-4200-8b84-5c85ea93eb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f17d238136c44a2e965ac4f1bbf9faa", "thumbnail_srcset": "https://si.imgix.net/e1624280/uploads/origins/ae1474c4-cb1e-4200-8b84-5c85ea93eb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f17d238136c44a2e965ac4f1bbf9faa, https://si.imgix.net/e1624280/uploads/origins/ae1474c4-cb1e-4200-8b84-5c85ea93eb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e08cea79e2c399d5fad01a4a539cdfe 2x, https://si.imgix.net/e1624280/uploads/origins/ae1474c4-cb1e-4200-8b84-5c85ea93eb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e02808c900996fb09f07450a9ec89de0 3x", "genre": "art", "nsfw": true, "body": "描く専さん\n\nこんにちは。しずねゆきです。\nまたリクエストよろしいでしょうか？\n\n【作品】\nオリフレ\n\n【キャラクター】\n・アラビアオオカミちゃん\n・アラスカオオカミちゃん\n・ユーコンオオカミちゃん\n\n【お題】\n・秋の野原で隊長さんが寝転んでいるときにオオカミちゃんズが遊びたくて近づいてきて、目を開けると顔の上あたりに立ってて、ローアングルでパンティ丸見えになってる３人を隊長さん視点でお願いします。\n・パンティは各オオカミちゃんの服をモチーフにしたデザインでお願いします。(毎度で申し訳ありませんが下着フェチなものでデザインにこだわって頂けると嬉しいです！)\n・差分で、スカートの中が丸見えなのに気づいてあわててスカートを押さえる絵もお願いできればと思います。\n\n・その他、細かい構図、ポーズ、背景などはおまかせします。\n\n【成果物】\n・完成イラストの原寸PSDデータをご提供頂きたくお願いできないでしょうか。レイヤー統合前を希望しますが、もしNGであればレイヤー統合後でかまいませんので何卒よろしくお願いします。\n\nどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@drawing_twi/works/12", "thumbnail_src": "https://si.imgix.net/e6a617bf/uploads/origins/9b157237-f4fa-454e-8e6a-44136dec1341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a88d5076fa57d0ae91ba450c74a9f5bf", "thumbnail_srcset": "https://si.imgix.net/e6a617bf/uploads/origins/9b157237-f4fa-454e-8e6a-44136dec1341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a88d5076fa57d0ae91ba450c74a9f5bf, https://si.imgix.net/e6a617bf/uploads/origins/9b157237-f4fa-454e-8e6a-44136dec1341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f186e8e331a31ef90ce24e0fe4895a8e 2x, https://si.imgix.net/e6a617bf/uploads/origins/9b157237-f4fa-454e-8e6a-44136dec1341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62f442b8d18fb1cdec7de812a60c7e6d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@drawing_twi/works/11", "thumbnail_src": "https://si.imgix.net/1724908e/uploads/origins/e09894c7-dea2-4371-8807-128b8b9db8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ba4b5258baa7c0a7998d250873231d", "thumbnail_srcset": "https://si.imgix.net/1724908e/uploads/origins/e09894c7-dea2-4371-8807-128b8b9db8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ba4b5258baa7c0a7998d250873231d, https://si.imgix.net/1724908e/uploads/origins/e09894c7-dea2-4371-8807-128b8b9db8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7641e19d1b7cf2a050af14d6d98e80c5 2x, https://si.imgix.net/1724908e/uploads/origins/e09894c7-dea2-4371-8807-128b8b9db8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a03445bd434e089bde9035a4fb5e414 3x", "genre": "art", "nsfw": true, "body": "描く専さんのイラストが大好きです、是非イラストをご依頼させてください。\nけものフレンズ３　から　ブラックサーバルちゃんのイラストをお願いしたいです。\n\nNSFWな依頼です、可能な範囲で描いて頂ければと思います。\nシチュエーションはホテルに連れ込まれて半ば強引に抱かれてしまっている様なイメージです。\n\nベッドの上におまたを広げて仰向けになっている感じで手は力なくバンザイしている様なポーズでお願いします。\n服装は普段の黒いフレンズ服から手袋と靴下だけ付けていて、表情は嫌がりながらも真っ赤に紅潮して涙目になりながら快感に歪んでいる感じを希望します。\n過去に描かれているカワラバトちゃんの依頼の様なアングルで、竿役も下半身と手だけ見えているイメージでお願いします。\n竿役の手はブラックサーバルちゃんの手首をつかんでベッドに押し付けている感じでお願いします。\n\n細かい指定は可能な範囲で大丈夫です、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@drawing_twi/works/10", "thumbnail_src": "https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f031910b512fa9db8bc51a3182c9c1d", "thumbnail_srcset": "https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f031910b512fa9db8bc51a3182c9c1d, https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abeede41a4ea616ef1c30085d7140156 2x, https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0553f81e7c6a0bcf1191057925af69cd 3x", "genre": "art", "nsfw": true, "body": "新凪先生\n\nこんにちは。しずねゆきです。\nまた追加でリクエストしてもよろしいでしょうか？\n\n【作品】\nオリフレ\n\n【キャラクター】\n・アラスカオオカミちゃん\n\n【お題】\n・アラスカオオカミちゃんのアラスカオオカミランジェリー姿をお願いします。\n・下着はフレンズとのコラボ商品的な感じで、アラスカオオカミちゃんの姿や服をモチーフにしたデザインのものとして頂きたくお願いします。(下着フェチなものでデザインにこだわって頂けると嬉しいです！)\n・その他、細かい構図、ポーズ、背景などはおまかせします。\n\n【成果物】\n・完成イラストの原寸PSDデータをご提供頂きたくお願いできないでしょうか。レイヤー統合前を希望しますが、もしNGであればレイヤー統合後でかまいませんので何卒よろしくお願いします。\n\nどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@drawing_twi/works/9", "thumbnail_src": "https://si.imgix.net/d2b330db/uploads/origins/ecea909b-61dc-4b69-993d-45f85271d3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&tx