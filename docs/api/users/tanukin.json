ix.net/5a667854/uploads/origins/5cc62881-9e27-43c9-b771-a9050c9643af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a58f4d9f35bc4bb98801147def2a030 2x, https://si.imgix.net/5a667854/uploads/origins/5cc62881-9e27-43c9-b771-a9050c9643af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b9e82eb67bceebdc460b66785113725 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tanukin/works/28", "thumbnail_src": "https://si.imgix.net/37353490/uploads/origins/2f954cb8-c1a6-4acd-ac83-ec454a62af4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4cbf7a3f2ddf78155f5aead5d1969a", "thumbnail_srcset": "https://si.imgix.net/37353490/uploads/origins/2f954cb8-c1a6-4acd-ac83-ec454a62af4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4cbf7a3f2ddf78155f5aead5d1969a, https://si.imgix.net/37353490/uploads/origins/2f954cb8-c1a6-4acd-ac83-ec454a62af4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d704b86f7af4e33afe0ff10769f30aa4 2x, https://si.imgix.net/37353490/uploads/origins/2f954cb8-c1a6-4acd-ac83-ec454a62af4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f91fef84e620cf018322afd212e3bb7c 3x", "genre": "art", "nsfw": true, "body": "こんにちは、たぬ助さん！\n前回描いていただいた作品がとても気に入っていて、毎日携帯の壁紙で見ているくらい気に入っています。今度は大胆な絵をお願いしたいです！彼は武器を描く必要はありません、体だけに集中してください。できればいくつかの差分が欲しいです。あなたは彼をより強く描くことができます、村正みたいに。\n彼は邪悪な博士に負けた、彼は箱の中に閉じ込められていたのですが、頭は露出しています。彼は貞操帯に閉じ込められていた、胸から下の服が破れて傷んでいた、下半身に無数の触手が絡みつく、触手から何かを注入され、感覚遮蔽な状態になった。いくつかの触手によって分泌される粘液により、彼のペニスと睾丸が拡大し、大量の精液が射精されます。\n長い時間が経って、彼の感覚遮蔽な状態は解除されました、敏感な亀頭を撫でられる。長時間射精の快感で彼は倒れてしまった、彼は壊れた表情を見せた、胸のコアの色が青から赤に変わります(一番外側の円)。\nその他の細かい要件はあなたの選択に委ねられます。私の依頼を受け入れていただければ幸い