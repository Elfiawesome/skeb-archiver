せん。\n\n性格的には、ルナは天才的だが器用である。Wagglewompyは人懐っこくて純情だけど、どこか犬っぽい。\n\nできれば、Twitterのタグ「#ShowFeesh」を使ってください。\n\nhttps://virtualyoutuber.fandom.com/wiki/Luna_the_Magikarp/Gallery\n\nhttps://leaflit.fandom.com/wiki/Professor_Wagglewompy\n\nhttps://youtu.be/bIfCMgZqcgs?t=113", "created_at": "", "completed_at": ""}, {"path": "/@oldrose_rose/works/14", "thumbnail_src": "https://si.imgix.net/4311ec7c/requests/258389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=300c966dc331c3ced937701f1db5ddb6", "thumbnail_srcset": "https://si.imgix.net/4311ec7c/requests/258389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=300c966dc331c3ced937701f1db5ddb6, https://si.imgix.net/4311ec7c/requests/258389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea3a87941ede1d6f3ae7370b15236857 2x, https://si.imgix.net/4311ec7c/requests/258389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b58b50a1bacfb9f5dbbed4a99c802c8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oldrose_rose/works/13", "thumbnail_src": "https://si.imgix.net/b165dd26/requests/254205_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deef6b206da5a9ab98f25c2442742c0f", "thumbnail_srcset": "https://si.imgix.net/b165dd26/requests/254205_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deef6b206da5a9ab98f25c2442742c0f, https://si.imgix.net/b165dd26/requests/254205_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ccf7748c145e