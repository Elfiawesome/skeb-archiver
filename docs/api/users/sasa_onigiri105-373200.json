8870-4ad6-92d6-d4a2fba294b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844c386c34d5cd91bc997582ce950634", "thumbnail_srcset": "https://si.imgix.net/3853c1a5/uploads/origins/358df6dd-8870-4ad6-92d6-d4a2fba294b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844c386c34d5cd91bc997582ce950634, https://si.imgix.net/3853c1a5/uploads/origins/358df6dd-8870-4ad6-92d6-d4a2fba294b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a93829c5990837a6a65fcafe11137e1f 2x, https://si.imgix.net/3853c1a5/uploads/origins/358df6dd-8870-4ad6-92d6-d4a2fba294b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3d2e5333a23496edbf805a7a7715d1b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、また私のFFXIVのOCを描いていただけませんか？\n\n可愛くてかっこいい笑顔の彼女を描いてください。  \n\n彼女のカーバンクルも絵の中に入れてもらえると嬉しいです。  参考アルバムにカーバンクルの写真を載せています。\n\nその他はおまかせします。  ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1bfo5B19_gjGQyyghQU8L7ZngBUhrdo4g", "created_at": "", "completed_at": ""}, {"path": "/@sasa_onigiri105/works/122", "thumbnail_src": "https://si.imgix.net/5115f2cd/uploads/origins/7203ba49-ef66-4b93-8428-4f4d870beeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=621abc159c81ba44a4718f4bb1560fb3", "thumbnail_srcset": "https://si.imgix.net/5115f2cd/uploads/origins/7203ba49-ef66-4b93-8428-4f4d870beeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=621abc159c81ba44a4718f4bb1560fb3, https://si.imgix.net/5115f2cd/uploads/origins/7203ba49-ef66-4b93-8428-4f4d870beeda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaad6302f566f7f4866abe4dadfc8ece 2x, https://si.imgix.net/5115f2cd/uploads/origins/7203ba49-ef66-4b93-8428-4f4d870beeda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9ea6d41f15909c4210971b5bc9c1cb9 3x", "genre": "art", "nsfw": false, "body": "笹おにぎり様\n\nはじめまして！\n堕天使Vtuberのシャティ・アビスメアと申します。\nTwitterでとても素敵なイラストをお見かけしてリクエストさせていただきました！\nリクエストは私自身のイラストを描いていただけないでしょうか？\n\n【シャティ・アビスメア】\n人と遊ぶのが大好きな堕天使の女の子。\n目は淡いグラデーションがかかっていて、しいたけ目です。\n天使の輪っかは少し欠けていて\n背中の翼は白２枚、黒赤２枚の全部で４枚あります。しまうことも可能！\n部屋着衣装もあり、猫化もできます！\n\n【使用用途】\n・YouTubeのサムネイル、動画等への使用\n・Twitter等のSNSへの投稿\n（使用の際にはTwitterのアカウント名を記載させていただきます）\n\n【要望】\n・構図はソファの上で横になってこちらを見てくつろいでいる様子でお願いします。\n・衣装は参考資料の部屋着の方で猫耳・しっぽがある状態をお願いしたいです。\n・可能でしたら人物と背景を分けたデータも頂けると大変嬉しいです。\n\nお忙しいところ恐縮ですが、何卒よろしくお願い致します。\n\nhttps://twitter.com/shatti_0604/status/1616035299628584960?s=20", "created_at": "", "completed_at": ""}, {"path": "/@sasa_onigiri105/works/121", "thumbnail_src": "https://si.imgix.net/710f6d43/uploads/origins/febf6cdc-757e-4543-83a4-ba50e64448d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32ade569da5d9888f0896296d7dd29a5", "thumbnail_srcset": "https://si.imgix.net/710f6d43/uploads/origins/febf6cdc-757e-4543-83a4-ba50e64448d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32ade569da5d9888f0896296d7dd29a5, https://si.imgix.net/710f6d43/uploads/origins/febf6cdc-757e-4543-83a4-ba50e64448d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=888abafc5bf02b06b91fdbd7da7f4d2c 2x, https://si.imgix.net/710f6d43/uploads/origins/febf6cdc-757e-4543-83a4-ba50e64448d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aae79d6b5ed1b041206685566800a222 3x", "genre": "art", "nsfw": false, "body": "こんにちわ(*´ω｀*)私のキャラクター「カフリ」を描いていただけないでしょうか？\n\n白魔道士の衣装で登場させたいと考えていました。足を組んで座ってウインクしているような感じにしたかった。魅惑的な感じでもいいし、もっと可愛く、でもはっちゃけた感じでもいいと思います。\nパソコンの壁紙として使いたいと思っています！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1lzlq75EY7H3yyJ4XnCb2JUZJhOMjDFG-", "created_at": "", "completed_at": ""}, {"path": "/@sasa_onigiri105/works/120", "thumbnail_src": "https://si.imgix.net/d65c38ed/uploads/origins/83b1d3af-3208-4670-8ac2-1722a5f26962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6f7ebef7cf844a22c70c69d355109a8", "thumbna