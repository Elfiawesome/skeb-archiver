Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78c929013799c3e73a30d1c4f33af21c 2x, https://si.imgix.net/9ea64b6b/uploads/origins/a01b1c0f-bcfc-421b-bbd6-136ab8adfc36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b898866aacba782f5aeb33f6168143c 3x", "genre": "art", "nsfw": true, "body": "初めまして。いつも最高なイラスト本当にありがとうございます！ンガ丸さんの絵柄がとても好きで自分の好きなキャラ描いていただけないかなと思いこちら送らせていただきました。\nキャラは鬼滅の刃の栗花落カナヲをお願いしたいです。\n脚は筋肉質でむちむち。胸はそこそこ大きめでお願いします。\nマン毛もお願いしたいです。\n隊服から胸が飛び出し、スカートは履いたままのと完全に全裸の姿を描いていただけると嬉しいです。アヘ顔もできましたらお願い致します。\nリクエストするのが初めてで他の方のを参考に考えてみたのですがわかりづらかったら申し訳ないです。最終的にはンガ丸さんにえっちな栗花落カナヲ描いていただけるだけで嬉しいので細かい部分はおまかせできればと思っておりました。\n\nお忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/161", "thumbnail_src": "https://si.imgix.net/bdd95966/uploads/origins/98676a76-2292-45a0-95cb-b436cab988b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ed2067b7546d91b982600f49e1bd389", "thumbnail_srcset": "https://si.imgix.net/bdd95966/uploads/origins/98676a76-2292-45a0-95cb-b436cab988b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ed2067b7546d91b982600f49e1bd389, https://si.imgix.net/bdd95966/uploads/origins/98676a76-2292-45a0-95cb-b436cab988b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ed476339734a4e1a66f9f6b916f54be 2x, https://si.imgix.net/bdd95966/uploads/origins/98676a76-2292-45a0-95cb-b436cab988b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fedb4ab6a728d6480eac1d17b552e38 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/160", "thumbnail_src": "https://si.imgix.net/dddf5422/uploads/origins/5e022382-642f-45e7-b30f-b956373964c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9c04ead984acd55c7aba126a6d3012e", "thumbnail_srcset": "https://si.imgix.net/dddf5422/uploads/origins/5e022382-642f-45e7-b30f-b956373964c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9c04ead984acd55c7aba126a6d3012e, https://si.imgix.net/dddf5422/uploads/origins/5e022382-642f-45e7-b30f-b956373964c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=314cbd3576c6ee63392873fbc68ac12e 2x, https://si.imgix.net/dddf5422/uploads/origins/5e022382-642f-45e7-b30f-b956373964c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d2e5a0bd4e5fdf6a4a3874a751e1fb3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/159", "thumbnail_src": "https://si.imgix.net/929c3baa/uploads/origins/8d46b377-65b3-4f46-b5ba-79ce74c5dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=944261e18a48b35e87df9bc5deacddc6", "thumbnail_srcset": "https://si.imgix.net/929c3baa/uploads/origins/8d46b377-65b3-4f46-b5ba-79ce74c5dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=944261e18a48b35e87df9bc5deacddc6, https://si.imgix.net/929c3baa/uploads/origins/8d46b377-65b3-4f46-b5ba-79ce74c5dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec932304964632acc39654a2346a7605 2x, https://si.imgix.net/929c3baa/uploads/origins/8d46b377-65b3-4f46-b5ba-79ce74c5dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e75e82ef0aafc67586f8b69585662142 3x", "genre": "comic", "nsfw": true, "body": "ンガ丸さんはじめまして！いつもンガ丸さんの素晴らしい作品を楽しみにしております。今回、ぜひ私のOCを描いて頂きたいです。よろしくお願いいたします！\n\n内容…私のOC「ゴア」のいちゃラブエロを描いて頂きたいです！\n\n名前…ゴア\n\nキャラ…好戦的なオレっ娘スーツ剣士キャラクター。「全員まとめてかかってきな！」「オレは最強だ！」みたいなことを言いそうな男勝りなキャラクターイメージ。一人称は「オレ」。竿役（ボス）への二人称は「ボス」または「おまえ」。\n\n容姿…２０代後半。１７０㎝くらい。少し筋肉質。巨乳。ピンクに近い赤紫の髪色と目の色。先を結んだ顔にかかるタイプの特徴的な長い前髪と後髪。鼻と左目と体に無数の傷跡。爆乳。陰毛や腋毛はあってもなくても大丈夫です！\n\n装備…服装は紫ネクタイ＆ベルトの着崩したスーツでジャケットなし。赤紫のマニキュアをしています。武器は大剣。髪留めは黒石を加工したようなもの。\n\nシチュ…恋人である「ボス」とのいちゃラブみたいな感じでお願いします。とくにNGはありませんので、ぜひンガ丸さんの描きやすいように描いて頂けたら嬉しいです！可能でしたら射精されて絶頂しているシーンを入れていただきたいです！\n\n備考…竿役はゴアの上司「ボス」という感じのイメージでお願いします。竿役は黒髪モブでお願いします。可能でしたらセリフもお願いします！（口調はタメ口でお願いします！）\n\n・細部やその他文章に書いていない部分はすべてお任せします！\n・イラストの使用目的は妄想や個人使用のみですが、次回依頼時の参考資料として使用させていただく場合があります！\n・内容や金額等不備がありましたら訂正し再送させていただきます！\n\n楽しみにしております！\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1RrW59zrn-vxFkmLfXQLlB1AS9R0EeajE", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/158", "thumbnail_src": "https://si.imgix.net/2ea6f541/uploads/origins/786ceb25-7709-47f1-b5b4-a1003c54fe78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc985d9f4c79e42b0b40a4b7053edab1", "thumbnail_srcset": "https://si.imgix.net/2ea6f541/uploads/origins/786ceb25-7709-47f1-b5b4-a1003c54fe78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc985d9f4c79e42b0b40a4b7053edab1, https://si.imgix.net/2ea6f541/uploads/origins/786ceb25-7709-47f1-b5b4-a1003c54fe78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f949a2d0797446097219687324a90bd 2x, https://si.imgix.net/2ea6f541/uploads/origins/786ceb25-7709-47f1-b5b4-a1003c54fe78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dd4b01f223902daa6fc318c2325e47b 3x", "genre": "art", "nsfw": true, "body": "ンガ丸様こんばんは、以前に依頼した者ですが(https://skeb.jp/@buchubuchuneet/works/151)今回もまたお願いしたいと思います。\n●今回も『いきいきごんぼ』の今木麻紀(イマキマキー)ちゃんを前回と違う妄想シチュで描いていただきたいと思います。\n\n●今回は即オチ2コマというか0コマで壁に手をついた立ちバックで突かれてるイラストをメインにしていただければと思います。可能でしたら制服姿でまくりあげておっぱいなど見えている状態でお願いしたいです。\n※ポーズ参考(三次画像ですので一応ご注意を)https://img.bakufu.jp/wp-content/uploads/2024/05/240526c_0018.jpg\n画像ではもう一人の男優に掴まってますが壁に手をついてるような体勢だとありがたいです。\nセリフ的には\nモブ男「イッてる？」\nイマキマキー(滅茶苦茶感じてる表情で)「イ…イッてない…♡」などあれば嬉しいです。\n\n●もう一つ見たいアングルが立ちバックを下から見上げたイラストで\n※ポーズ参考(これも三次画像です)https://img.bakufu.jp/wp-content/uploads/2024/06/240616c_0015.jpg\nの様なアングルで激しくハメ潮を漏らしながら\nモブ男「じゃあもっと激しくするからイけッ」\nイマキマキー「待…ッ」「イってる♡イってるからダメェッ♡」\nなどがあればと思います。\n後は値段や描くスペースにもよりますがフィニッシュ描写に顔射か事後で呼吸も荒くぐったりしてる描写などが可能でしたらお願いしたいです。\n\n●今回もイラストの隅に(…という事をしてぇなぁ…)とエロ妄想に耽るモブでオチをつけるなどしていただければと思います。\n\n長々と注文も多く申し訳ありませんが細かい箇所などある程度ンガ丸様のアドリブで変更していただいても構いませんので以上の内容でご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/157", "thumbnail_src": "https://si.imgix.net/06f8c4f8/uploads/origins/bd9a345c-dd29-4cb4-8281-3e70f692d301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c81b7683a8e2dabce2dd5a72a03dd1", "thumbnail_srcset": "https://si.imgix.net/06f8c4f8/uploads/origins/bd9a345c-dd29-4cb4-8281-3e70f692d301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c81b7683a8e2dabce2dd5a72a03dd1, https://si.imgix.net/06f8c4f8/uploads/origins/bd9a345c-dd29-4cb4-8281-3e70f692d301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2543a70f4907e4ecff0aab37b1c58692 2x, https://si.imgix.net/06f8c4f8/uploads/origins/bd9a345c-dd29-4cb4-8281-3e70f692d301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cd3f43904abba1e04160e3912e3e3a5 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの美しい絵が大好きです！私のOC、Nemooの絵をリクエストしてもいいですか？\n\nねむーは牛の女の子で、控えめな主婦です。普段は恥ずかしがり屋で控えめですが、夫が気持ちよくなるためなら何でも挑戦します。最初は自意識過剰で躊躇しているネモも、最後は快楽に溺れてしまうことが多い。\n\n作品については、皆さんにお任せしたいと思います。自由に好きな構図で描いてください！ネモのデザインに少し手を加えてもOKです。\n\nご考慮いただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1DutTjPDGgII4HUc7XzMHxn-zLAXM62E0?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/156", "thumbnail_src": "https://si.imgix.net/80573960/uploads/origins/612e728e-1709-4063-b458-9dd484051ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2b0b0c4b20b04fa363acb9a2cb0f8d3", "thumbnail_srcset": "https://si.imgix.net/80573960/uploads/origins/612e728e-1709-4063-b458-9dd484051ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2b0b0c4b20b04fa363acb9a2cb0f8d3, https://si.imgix.net/80573960/uploads/origins/612e728e-1709-4063-b458-9dd484051ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84bd47d56859a655f2bc154a71bf5c03 2x, https://si.imgix.net/80573960/uploads/origins/612e728e-1709-4063-b458-9dd484051ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a35e8f7d7c12ce1c1c5db9f1e426322a 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/155", "thumbnail_src": "https://si.imgix.net/bf678a1f/uploads/origins/a2d8e4e0-548c-464f-a60b-33cb7b9622fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f505cfdcf2927378c9e83b0a2f573ac4", "thumbnail_srcset": "https://si.imgix.net/bf678a1f/uploads/origins/a2d8e4e0-548c-464f-a60b-33cb7b9622fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f505cfdcf2927378c9e83b0a2f573ac4, https://si.imgix.net/bf678a1f/uploads/origins/a2d8e4e0-548c-464f-a60b-33cb7b9622fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4972ae94ac6790fd87b5773becef0bc2 2x, https://si.imgix.net/bf678a1f/uploads/origins/a2d8e4e0-548c-464f-a60b-33cb7b9622fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a537ca904c188789a5ff3c0ac08f4a1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/154", "thumbnail_src": "https://si.imgix.net/e528ed2b/uploads/origins/1445072b-3f99-4aa8-b8f6-239b973cc5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f9d26d57f41caff48db36c749a8168", "thumbnail_srcset": "https://si.imgix.net/e528ed2b/uploads/origins/1445072b-3f99-4aa8-b8f6-239b973cc5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f9d26d57f41caff48db36c749a8168, https://si.imgix.net/e528ed2b/uploads/origins/1445072b-3f99-4aa8-b8f6-239b973cc5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fa28cffa51dfb1ba338e0301918014c 2x, https://si.imgix.net/e528ed2b/uploads/origins/1445072b-3f99-4aa8-b8f6-239b973cc5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9f6bd71c15c17607bb77e129dd967ff 3x", "genre": "art", "nsfw": true, "body": "初めまして！むちむちで可愛いイラストに惹かれました。リクエストさせてください。\n\nキャラ\nファンタジー世界の歴戦の女戦士。年齢はアラフォーくらいで白髪のロングヘアー、褐色肌。体付きは巨乳で全身しっかり鍛えられていて、所々に傷跡がある。脇毛、陰毛どちらもモッサリ生えている。\n現役を引退して弟子を鍛えているが、弟子を男として見ていないので常にふんどし一丁で生活している。\n全体的なイメージは以前描かれていたこちらのキャラ(https://www.pixiv.net/artworks/122669333)が1回り歳を取った感じです。\n\nシチュエーション\n性欲旺盛な弟子に「修行に身が入らない」と言われて渋々弟子の望み通りのポーズを取り見抜きをさせることになる。\n脇見せポーズで脇にぶっかけ、尻を突き出して尻にぶっかけ、最終的には口を開けてアーンの体勢で顔射。何度もぶっかけられて自分も興奮してふんどしをグッショリ濡らしてしまったが平静を装って「これで満足か？」と呟いて終了。\n\n構図やセリフなどは全てお任せします。シチュの内容も金額に合わなければ改変して頂いてOKです。\n以上、内容に問題なければご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/153", "thumbnail_src": "https://si.imgix.net/5a5f2ef0/uploads/origins/e0e36e2d-c7c8-47ed-b4db-4240a8886bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=befe8e7e87b6c1b349944dbb28bfb0c7", "thumbnail_srcset": "https://si.imgix.net/5a5f2ef0/uploads/origins/e0e36e2d-c7c8-47ed-b4db-4240a8886bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=befe8e7e87b6c1b349944dbb28bfb0c7, https://si.imgix.net/5a5f2ef0/uploads/origins/e0e36e2d-c7c8-47ed-b4db-4240a8886bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b4550fab5091a86f793077c543ab3f3 2x, https://si.imgix.net/5a5f2ef0/uploads/origins/e0e36e2d-c7c8-47ed-b4db-4240a8886bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02a3f955f2e7ed472bb2b4824aad142e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生！先生の作品には圧倒されました。先生の描く長い胸と脇の下は本当に素晴らしいです！アークナイツのレイディアンの絵をお願いしたいです。\nライディアンはメイドのカフスをつけ、ティアラをつけ、白いストッキングをはいていてほしいです。二の腕は一の腕の脇の下にある。乳首は大きく、乳輪には乳首のような突起がたくさんあり、母乳も漏れている。太ももとヒップはとてもふくよかだが、ウエストはたるんでいない（あまりない）。\nこのイラストには、指の乳首ファック、腋の下、母乳の内容が含まれていることを期待していた。その他、動きに対する要望は特にありませんので、彼女の体の最も美しい曲線やポーズを表現していただければと思います。\nご快諾いただければ幸いです！\n\nhttps://arknights.wiki.gg/images/8/85/Raidian.png?format=original", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/152", "thumbnail_src": "https://si.imgix.net/adb31093/uploads/origins/55ac193e-8d22-4dbd-9271-583d8a85414f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ef2568686fef07c82235458d84c528", "thumbnail_srcset": "https://si.imgix.net/adb31093/uploads/origins/55ac193e-8d22-4dbd-9271-583d8a85414f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ef2568686fef07c82235458d84c528, https://si.imgix.net/adb31093/uploads/origins/55ac193e-8d22-4dbd-9271-583d8a85414f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf167ce24436173eec4b96223c588ad1 2x, https://si.imgix.net/adb31093/uploads/origins/55ac193e-8d22-4dbd-9271-583d8a85414f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0610d81ebbff3ed1cc8e7df8530f00b9 3x", "genre": "art", "nsfw": true, "body": "ンガ丸先生初めまして！\n唐突ですが私は女性の大きめの乳輪が性癖の一丁目一番地でして…ンガ丸先生の作品を拝見して、ぜひ私の理想を叶えていただきたいと思いリクエストいたしました。\n\n描いていただきたいのは、褐色肌黒髪ショートヘア・赤色瞳のツリ目の女性兵士が敵男性兵士に敗北して快楽調教を受けるシーンです。\nこだわりたいポイントは先生が得意とされる大きめの胸、乳輪はもちろん、ボリューム多めの下腹部の陰毛も描写していただきたいです。迷彩服をほぼ脱がされている描写もございますと大変嬉しいです。\n\nどうかご検討のほど、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/151", "thumbnail_src": "https://si.imgix.net/33c844a7/uploads/origins/12cca118-5d1e-462b-b3fd-a4d8892a9753?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=343061172d3bf46fa64cfb8dd7c27239", "thumbnail_srcset": "https://si.imgix.net/33c844a7/uploads/origins/12cca118-5d1e-462b-b3fd-a4d8892a9753?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=343061172d3bf46fa64cfb8dd7c27239, https://si.imgix.net/33c844a7/uploads/origins/12cca118-5d1e-462b-b3fd-a4d8892a9753?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac7a1dbe94f4c1431af6115b1979a91c 2x, https://si.imgix.net/33c844a7/uploads/origins/12cca118-5d1e-462b-b3fd-a4d8892a9753?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a78ea13c531713ebb6485822c4ada454 3x", "genre": "art", "nsfw": true, "body": "はじめまして、ンガ丸様の描くムチムチな絵が好みなのでリクエストさせていただきます。\n\n●昔の作品なのでニッチな需要になるかと思いますが少年チャンピオンで連載していた『いきいきごんぼ』というギャグ漫画の『今木麻紀(イマキマキー)』というキャラをンガ丸様のタッチで描いていただきたいと思います。\n\nイマキマキーちゃんは茶髪でショートカットの目つきがキツめのSっ気が強めの女子でカースト低めの主人公たちをイジってくるタイプのキャラです。\n\nキャラの参考に下記に画像URLも貼らせていただきます。\nhttps://livedoor.blogimg.jp/b00ks/imgs/7/8/7869586d.jpg\nhttps://livedoor.blogimg.jp/thedeb/imgs/e/4/e411465e.jpg\n\n●即オチ2コマ風に制服を着た通常立ち絵(こちらを挑発するような表情で笑っている様なイメージ)とセックスしているイラスト(描きやすければ全裸で構いません)が並んでいるイメージでこれまで描かれた作品の様に1枚絵の中で色々な体位などを見られればありがたいです。値段的に難しいようでしたら再送をお願いいただければと思います。\n\n●元ネタがマイナーな為ご存じないかと思うので激しくハメられている擬音や喘ぎ声があれば特にセリフは必要ありませんが入れてもらえるなら立ち絵のイマキマキーは「何か股間が膨らんでるんですけどｗやらし～」など、竿役は「いやらしいのはお前のカラダじゃ！このくされおぱんぽんめッッ！！」と言いながらハメ倒すイメージですが無くても構いませんしアドリブで付け足していただいても構いません。\n\n●特にストーリー性など無いのですがシチュエーション的にはイマキマキーにいつもイジられているモブ竿役(ンガ丸様が描かれるタイプのモブでかまいません)が脳内妄想で仕返しにいじめハメ倒している、というイメージで余裕があればイラストの隅に(…という事をしてぇなぁ…)とエロ妄想に耽るモブでオチをつけるなどしていただければと思います。\n\n長々と申し訳ありませんが細かい箇所などある程度ンガ丸様のアドリブで変更していただいても構いませんので\n以上の内容でご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/150", "thumbnail_src": "https://si.imgix.net/ded39c92/uploads/origins/3157a557-a24d-4bba-8979-94221fece39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5b01de50448b3a721fd6fc3c3c9f3c", "thumbnail_srcset": "https://si.imgix.net/ded39c92/uploads/origins/3157a557-a24d-4bba-8979-94221fece39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5b01de50448b3a721fd6fc3c3c9f3c, https://si.imgix.net/ded39c92/uploads/origins/3157a557-a24d-4bba-8979-94221fece39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9de61ad1d031aaa11205175d380c1c9 2x, https://si.imgix.net/ded39c92/uploads/origins/3157a557-a24d-4bba-8979-94221fece39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3b10f5a8cf6a38ed3fdb1b822a05165 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。以前、長い胸が漏れるくノ一のイラストをリクエストしたhttps://x.com/buchubuchuneet/status/1885945296234168753?t=a92UvrVRFxBu__gFXl_xiw&s=19。\n\n母乳のせいで見つかってしまい、捕まってしまったというシチュエーションで、おっぱいの長い彼女のイラストをまたお願いしたいです。そして、長く垂れ下がった乳房が攻撃され、拷問を受けることで、さらに母乳を噴出させ、エロティックな表情をする。\n\n違うシチュエーションを描きたい方はどうぞ。", "created_at": "", "completed_at": ""}, {"path": "/@buchubuchuneet/works/149", "thumbnail_sr