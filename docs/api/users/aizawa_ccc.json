/origins/983ac422-abbb-4d42-a4b5-bca31ccd34e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef33fee7e4f5f5292168de9dc8357e2a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aizawa_ccc/works/11", "thumbnail_src": "https://si.imgix.net/9ab83d50/uploads/origins/994eb567-857c-4aa3-9245-278c7ba05239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdee81dd4e3ef1994178498aa5cc4c72", "thumbnail_srcset": "https://si.imgix.net/9ab83d50/uploads/origins/994eb567-857c-4aa3-9245-278c7ba05239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdee81dd4e3ef1994178498aa5cc4c72, https://si.imgix.net/9ab83d50/uploads/origins/994eb567-857c-4aa3-9245-278c7ba05239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbefa0fb3aba0fb04b689259515fab27 2x, https://si.imgix.net/9ab83d50/uploads/origins/994eb567-857c-4aa3-9245-278c7ba05239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4a5cd1d0e9d819e8b5130bb61657a0a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のキャラクターを描いていただけると嬉しいです！彼女の性格のタイプはダウナー系です。性格のタイプはダウナー系です。お姉さん的な感じでもOKです。また、最初の参考リンクにある服を着て描いてもいいですし、あなたがデザインした服を着て描いてもいいです。\n\nキャラクターリファレンス： https://imgur.com/a/4zcU6uY\n\nこのキャラクターの古い絵: https://twitter.com/i/events/1499786853788143619\n\nご検討ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@aizawa_ccc/works/10", "thumbnail_src": "https://si.imgix.net/bafaa41f/uploads/origins/3f418e4e-ae9d-441f-9547-0c0665ea44c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cfaaeec5e6d6c8bd1dd3bd209418964", "thumbnail_srcset": "https://si.imgix.net/bafaa41f/uploads/origins/3f418e4e-ae9d-441f-9547-0c0665ea44c6?bg=%23fff&auto=format%2Cc