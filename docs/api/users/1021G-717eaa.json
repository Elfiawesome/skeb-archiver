200&s=3ed2cace9e66f7f0e726ad6047a342a8 2x, https://si.imgix.net/f33fb242/uploads/origins/ed580dcf-b3cd-4015-bfa4-c7af761b3366?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4695b4d1f121cb62fcfe7a72bd6e9637 3x", "genre": "art", "nsfw": true, "body": "毎度お世話になっています。\n今回もお願いしたいです。\n\n・シチュ「ベットに拘束され、多人数からくすぐられまくる田端さん」\n\n・田端さん　下着姿　ベットに大の字で拘束されている\n・くすぐる人　リアルな白手袋はめたキャラ（お任せ）\n\n構図はおまかせします。\nくすぐる方のキャラの全体図は省略で構いません。\n腋、お腹、足の裏をくすぐっているコマ割りがあると嬉しいです。\n\n・表情差分\n田端さん　かわいい笑顔\n　　　　　苦しむ笑顔\n　　　　　ちょっとエッチな笑顔\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@1021G/works/57", "thumbnail_src": "https://si.imgix.net/ce19ee6f/uploads/origins/8affbb0d-be90-4a22-9cb6-5b1b39968ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56a799d442db7f8f9b3e868302936a56", "thumbnail_srcset": "https://si.imgix.net/ce19ee6f/uploads/origins/8affbb0d-be90-4a22-9cb6-5b1b39968ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56a799d442db7f8f9b3e868302936a56, https://si.imgix.net/ce19ee6f/uploads/origins/8affbb0d-be90-4a22-9cb6-5b1b39968ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0a157a5f0e748deb0b581fdb91d9cce 2x, https://si.imgix.net/ce19ee6f/uploads/origins/8affbb0d-be90-4a22-9cb6-5b1b39968ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe54a894153e638fb8b0c91511a099a5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@1021G/works/56", "thumbnail_src": "https://si.imgix.net/bac2cac0/uploads/origins/6040ab89-aebf-4a59-ab70-aadb5c722f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7054115336c361baf8c6c07474ed4344", "thumbnail_srcset": "https://si.imgix.net/bac2cac0/uploads/origins/6040ab89-aebf-4a59-ab70-aadb5c722f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7054115336c361baf8c6c07474ed4344, https://si.imgix.net/bac2cac0/uploads/origins/6040ab89-aebf-4a59-ab70-aadb5c722f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b847de7812cd3be7f110f4c1312b21 2x, https://si.imgix.net/bac2cac0/uploads/origins/6040ab89-aebf-4a59-ab70-aadb5c722f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3242905e9188e8c73206823d362aeeb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@1021G/works/55", "thumbnail_src": "https://si.imgix.net/38c5ad36/uploads/origins/02ae73eb-4123-4073-9e7e-b7f7b978fb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c43fbb8b8bcfe69229597f95d214e6d0", "thumbnail_srcset": "https://si.imgix.net/38c5ad36/uploads/origins/02ae73eb-4123-4073-9e7e-b7f7b978fb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c43fbb8b8bcfe69229597f95d214e6d0, https://si.imgix.net/38c5ad36/uploads/origins/02ae73eb-4123-4073-9e7e-b7f7b978fb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e91fd713dd807736ef5861cc58f5f73 2x, https://si.imgix.net/38c5ad36/uploads/origins/02ae73eb-4123-4073-9e7e-b7f7b978fb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ff86788183aa0e9998a5e1216014b9e 3x", "genre": "art", "nsfw": false, "body": "初めてリクエスト送らせていただきます。指定する制服はJR西日本女性冬用制服車掌（ネクタイ着用）\nキャラクターは石和さん（上半身）でお願いします。\nポーズは戸閉め後の指さし確認動作\nセリフとして「L空間よし！」という文言を吹き出しなしでお願いしたいです。\n\nもし可能ならば背景で223系2000番台のイラスト入れれるようならお願いしたいです（行先は新快速長浜行きで…）", "created_at": "", "completed_at": ""}, {"path": "/@1021G/works/54", "thumbnail_src": "https://si.imgix.net/840ad3b4/uploads/origins/d18f7455-c354-48be-849a-95a3824b97b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734edbda2a450343ad6cee2f8e4768cb", "thumbnail_srcset": "https://si.imgix.net/840ad3b4/uploads/origins/d18f7455-c354-48be-849a-95a3824b97b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734edbda2a450343ad6cee2f8e4768cb, https://si.imgix.net/840ad3b4/uploads/origins/d18f7455-c354-48be-849a-95a3824b97b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01695a87198c172ed4de2ef705602326 2x, https://si.imgix.net/840ad3b4/uploads/origins/d18f7455-c354-48be-849a-95a3824b97b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=430e32788e15d9f5f01f9fcb4375562d 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nまた三鷹さんのリクエストをさせていただきたいです。\n改札係になって、入鋏印をもっている様子をお願いできますでしょうか。\nお客さんの前では普段は普通にしつつも、時折補充券などの珍しいきっぷを見て興奮してしまう様子(パン屋さんのトングのごとく、入鋏印をカチカチしてしまう)を差分でいただけると嬉しいです。\nご検討、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@1021G/works/53", "thumbnail_src": "https://si.imgix.net/63285c32/uploads/origins/0798143a-aea1-4235-9ea7-c9a4ffef7dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89ddfbc5125e95b83623ead150ce4744", "thumbnail_srcset": "https://si.imgix.net/63285c32/uploads/origins/0798143a-aea1-4235-9ea7-c9a4ffef7dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89ddfbc5125e95b83623ead150ce4744, https://si.imgix.net/63285c32/uploads/origins/0798143a-aea1-4235-9ea7-c9a4ffef7dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cc42c8ed526271a274778a68789651e 2x, https://si.imgix.net/63285c32/uploads/origins/0798143a-aea1-4235-9ea7-c9a4ffef7dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0891ff0e2db5127d9870fe356d0e36ec 3x", "genre": "art", "nsfw": true, "body": "はじめまして!\nこういう概念の列車設定画とえっちな踊り子さんたちのイラストをお願いしたいです\nどちらもデザイン、世界観もろもろお任せいたします!\n\nこういう概念↓\nhttps://skeb.jp/@yak9d/works/4\nhttps://skeb.jp/@Kama_iruka/works/9\nhttps://skeb.jp/@Kama_iruka/works/11\nhttps://skeb.jp/@ricebirdmon/works/117\n\n世界中に数メートル級の超広軌鉄道が敷かれた世界で走る、北の将軍様もびっくりなｸｯｿでかいえっちハーレム列車が共通概念です\n\n踊り子さんの衣装イメージとかこちら\nhttps://x.com/skebisskebe/status/1730595709723009299?t=dG2JJQIcxe1pbE8d1IZmaQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@1021G/works/52", "thumbnail_src": "https://si.imgix.net/611734f6/uploads/origins/dcf82de5-309b-4d00-9b07-da1a81667487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0e04d81a2f96d8e88763a330a3b6ce0", "thumbnail_srcset": "https://si.imgix.net/611734f6/uploads/origins/dcf82de5-309b-4d00-9b07-da1a81667487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0e04d81a2f96d8e88763a330a3b6ce0, https://si.imgix.net/611734f6/uploads/origins/dcf82de5-309b-4d00-9b07-da1a81667487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbdc804ca6bbf41a021e84b50cb8e76e 2x, https://si.imgix.net/611734f6/uploads/origins/dcf82de5-309b-4d00-9b07-da1a81667487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eafd230f4252fdef89e99343fb9bdba4 3x", "genre": "art", "nsfw": false, "