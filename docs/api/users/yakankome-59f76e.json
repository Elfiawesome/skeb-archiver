71d6037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4a32e87798d46b6a8fdcd12232cf56, https://si.imgix.net/018bb244/uploads/origins/8fa8674c-c8fc-4767-b8a5-6d68371d6037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=441b145d113b65a38258084062fb7aed 2x, https://si.imgix.net/018bb244/uploads/origins/8fa8674c-c8fc-4767-b8a5-6d68371d6037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57342d4b93133b8be302c1e4cf9f237a 3x", "genre": "art", "nsfw": false, "body": "ヤカンコメ様の素敵なイラストをお見掛けし、ご依頼させていただきました。\n\n個人勢のみなとんこつをお願い致します。\n\n\n◇特徴\n・糸目がアイデンティティの女の子です。\n・オレンジや黄色などの明るい色がイメージカラーで、歌枠や雑談枠をメインに配信をしています。\n・見た目はふわふわ系ですが、性格は元気で明るい感じです。\n・ブタさんがお供にいますが含んでも含まなくても大丈夫です。\n•お洋服はご自由にデザインしていただいても大丈夫です。\n\n参考資料は下記リンクを参照ください。\n\nhttps://lit.link/minaton2525", "created_at": "", "completed_at": ""}, {"path": "/@yakankome/works/17", "thumbnail_src": "https://si.imgix.net/efd90395/uploads/origins/bbc45dd1-cef3-4db4-b68a-a3b54e509b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8658aadec749e60bbd66947a4dbc1910", "thumbnail_srcset": "https://si.imgix.net/efd90395/uploads/origins/bbc45dd1-cef3-4db4-b68a-a3b54e509b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8658aadec749e60bbd66947a4dbc1910, https://si.imgix.net/efd90395/uploads/origins/bbc45dd1-cef3-4db4-b68a-a3b54e509b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=682416ce7868c9643a781c66536043e6 2x, https://si.imgix.net/efd90395/uploads/origins/bbc45dd1-cef3-4db4-b68a-a3b54e509b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99bbd6c565b8bfd7b0de971140a50299 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のオリジナルキャラクターを描いていただけませんか？\n彼女は食べ物を食べるのが好きなうさぎの女の子！\nツインテールがうさ耳になっています。\n可能であれば、彼女がデザートを食べているところや、どんな食べ物でもいいので描いていただけませんか？\n可能であれば、デザートか何か食べ物を食べているところを描いていただけませんか？\n参考：https://ibb.co/CWkV8L5\n\nhttps://ibb.co/CWkV8L5", "creat