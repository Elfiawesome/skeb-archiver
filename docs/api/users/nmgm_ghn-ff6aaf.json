367a9d01c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2cbfa50ef249e1bbfa4a7337ad746e0 2x, https://si.imgix.net/ae81cb7c/uploads/origins/357b9a2c-2936-47b0-9576-0367a9d01c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ad9b7da8fc3abd2baa1492ef817f4ed 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nmgm_ghn/works/53", "thumbnail_src": "https://si.imgix.net/0f9f71cc/uploads/origins/7c956dd4-622a-4d18-a2e2-8abb2dce0283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=930693759c26a8c35771186908ed22da", "thumbnail_srcset": "https://si.imgix.net/0f9f71cc/uploads/origins/7c956dd4-622a-4d18-a2e2-8abb2dce0283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=930693759c26a8c35771186908ed22da, https://si.imgix.net/0f9f71cc/uploads/origins/7c956dd4-622a-4d18-a2e2-8abb2dce0283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf77c85da3e202f50c4aa28568ad2ed1 2x, https://si.imgix.net/0f9f71cc/uploads/origins/7c956dd4-622a-4d18-a2e2-8abb2dce0283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7116aac36d67cfcfff3260fe5793ec68 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ申し訳ないですが\n以前のリクエストがすごく満足で\nまだリクエストしました！\n\n前回のリクエスト\nhttps://skeb.jp/requests/2852571\n\nキャラクター\nヒロアカ スターアンドストライプ \nhttps://drive.google.com/file/d/11tbEmEIJkr-OLY7vwz7jSjMuruvqan3X/view?usp=sharing\n\n※コスチュームは以前と同じく半分ぐらい破れて片方の胸が見える状態でお願いします。\n\n前回の続きで\n気を失っで大の字で倒れているスターアンドストライプ\n\nこんな感じだと思います。\n\n動作1\nhttps://drive.google.com/file/d/1_2RuG3-y1uqJ-BFoFX2y83FYHZymgr8k/view?usp=sharing\n差分1-1 白目をむいている　スターアンドストライプ \n差分1-2 白目で涙を流している　スターアンドストライプ \n差分1-3 アへ顔して痙攣している　スターアンドストライプ 、失禁までしている。\n\n動作2\nhttps://drive.google.com/file/d/1ZIna52zxqn45iSD4W2WqKp6D8pvVeG6r/view?usp=drive_link\n差分2-1   白目をむいている　スターアンドストライプ \n差分2-2  白目で涙を流している　スターアンドストライプ \n差分2-3  アへ顔して痙攣している　スターアンドストライプ 、失禁までしている。\n\n申し訳ございませんがご検討をお願いします!", "created_at": "", "completed_at": ""}, {"path": "/@nmgm_ghn/works/52", "thumbnail_src": "https://si.imgix.net/170a7b1d/uploads/origins/5e28e34c-eea2-4811-858a-72a6b4c25063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c634c9833583c1ef2dfd9567c89c6939", "thumbnail_srcset": "https://si.imgix.net/170a7b1d/uploads/origins/5e28e34c-eea2-4811-858a-72a6b4c25063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c634c9833583c1ef2dfd9567c89c6939, https://si.imgix.net/170a7b1d/uploads/origins/5e28e34c-eea2-4811-858a-72a6b4c25063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6398e0936ca7da2a28c08cfb39f9684d 2x, https://si.imgix.net/170a7b1d/uploads/origins/5e28e34c-eea2-4811-858a-72a6b4c25063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa5de2565d17fa2cd4cf07f2be7b5a56 3x", "genre": "art", "nsfw": true, "body": "生ゴミ御飯様こんにちは。\n今回は前回描いて頂いたトリクシーのリョナイラストをお願いしたくリクエストさせて頂きました。\n\n\n●シチュエーションの概要：\n前回のイラストで窮地を助けた幼女の正体は実は敵で、花のネックレスも彼女が仕込んだ罠だった。\nいきなり蔓のような植物触手に形を変えてギュッと締め付けを起こしたネックレスに首を絞められ、動揺した隙に背後から正体を現した幼女に襲われて深傷を負い一方的に嬲られた末に尻もちをついて追い詰められているトリクシーの姿。\n\n\n●細かいリクエスト内容のお願い：\n\n・今回も元ネタとはあまり関係のない妄想シチュなので作品設定などは気にして頂かなくて構いません。\n\n・首を蔓のような植物触手に形を変えたネックレスに絞められて苦しむトリクシーの姿のカットインと、傷つけられた末に尻もちをついて追い詰められているメインのイラストをお願いします。\n\n・カットインの詳しい構図、ポーズなどは生ゴミご飯様にお任せ致します。\n以下はメインのイラストでのお願いになります。\n\n・傷描写は右脇腹と左肩の深い傷からの流血、他に全身にいくつか傷をお願いします。\n右脇腹の傷が第一撃の深いもので、右手で血を止めようと抑えているが止まらずに血が溢れている描写をお願いします。\n左腕は動かすことが出来なくなりだらんと垂れ下がっているような状態でお願いします。\n\n・ポーズは尻餅をついて足は開脚のような状態で、背中の後ろは壁になっていて逃げ場なく追い詰められているようなものでお願いします。\n\n・尿を失禁描写をお願いします。\n\n・トリクシーの表情は前回の笑顔からはかけ離れた恐怖と絶望に染まった怯え泣き顔でお願いします。\n\n・顔面の傷跡は少なめ、もしくは無しで、また首元のネックレス（植物触手）は消えた状態でお願いします。\n\n・「お漏らししちゃったお姉ちゃんにはもっとお仕置きしないとね」というニュアンスの幼女のセリフ差分をお願いします。\nセリフの改変や伸縮はお任せします。\n\n・敵の姿の描写はなくて構いません。\n\n・その他の部分は生ゴミ御飯様にお任せ致します。\n\n\nリクエスト内容は以上になります。\nご検討のほどよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@nmgm_ghn/works/51", "thumbnail_src": "https://si.imgix.net/00764c0d/uploads/origins/6ce6c408-ace5-4dd8-9e4f-a51f95de8b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3609eedb156ff3d44f9f41d4d66f7062", "thumbnail_srcset": "https://si.imgix.net/00764c0d/uploads/origins/6ce6c408-ace5-4dd8-9e4f-a51f95de8b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3609eedb156ff3d44f9f41d4d66f7062, https://si.imgix.net/00764c0d/uploads/origins/6ce6c408-ace5-4dd8-9e4f-a51f95de8b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b922070952dab06669e8168a75a8cfde 2x, https://si.imgix.net/00764c0d/uploads/origins/6ce6c408-ace5-4dd8-9e4f-a51f95de8b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af66df95e5fba0e63d39758c4ddbee76 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nmgm_ghn/works/50", "thumbnail_src": "https://si.imgix.net/ca5bd738/uploads/origins/d981f2a1-4535-477d-b2e5-628432808bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1c07ed2ec29318d70040a34159e04ce", "thumbnail_srcset": "https://si.imgix.net/ca5bd738/uploads/origins/d981f2a1-4535-477d-b2e5-628432808bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1c07ed2ec29318d70040a34159e04ce, https://si.imgix.net/ca5bd738/uploads/origins/d981f2a1-4535-477d-b2e5-628432808bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1431fb33ab0ec486391cbfe2d2e3910 2x, https://si.imgix.net/ca5bd738/uploads/origins/d981f2a1-4535-477d-b2e5-628432808bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af51a31cd6734403e535840467f040e0 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ申し訳ないですが\n以前のリクエストがすごく満足で\nまだリクエストしました！\n\n前回のリクエスト\nhttps://skeb.jp/requests/2477784\n\nキャラクター\nヒロアカ スターアンドストライプ \nhttps://drive.google.com/file/d/11tbEmEIJkr-OLY7vwz7jSjMuruvqan3X/view?usp=sharing\n\n※コスチュームは以前と同じく半分ぐらい破れて片方の胸が見える状態でお願いします。\n\n前回の続きで\n体を硬直しながら倒れているスターアンドストライプ\n\nこんな感じだと思います。\n\n動作1\nhttps://drive.google.com/file/d/1XJdsB2uNHARz1Bt05kr-BWxtZ5ogR26M/view\n\n差分1-1 目を閉じている　スターアンドストライプ \n差分1-2 白目をむいている　スターアンドストライプ \n差分1-3 白目で涙を流している　スターアンドストライプ \n差分1-4 アへ顔して痙攣している　スターアンドストライプ 、失禁までしている。", "created_at": "", "completed_at": ""}, {"path": "/@nmgm_ghn/works/49", "thumbnail_src": "https://si.imgix.net/33f42630/uploads/origins/72c9109a-33c7-4b22-ba3f-143741e4b732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73712f78f035e137598a9bbe769ac085", "thumbnail_srcset": "https://si.imgix.net/33f42630/uploads/origins/72c9109a-33c7-4b22-ba3f-143741e4b732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73712f78f035e137598a9bbe769ac085, https://si.imgix.net/33f42630/uploads/origins/72c9109a-33c7-4b22-ba3f-143741e4b732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4872fd575fc06c23fa809c203b40d59 2x, https://si.imgix.net/33f42630/uploads/origins/72c9109a-33c7-4b22-ba3f-143741e4b732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ad00db7c23ea7e3c6da31ce4854b726 3x", "genre": "art", "nsfw": true, "body": "初めまして。リクエストさせていただきます。\nスカシチュになりますが、ご検討いただければ幸いです。\n\n〇キャラ\nティアナ　(ランモバ)\n〇コスチューム\nレオタード　＋　両腕巻　＋　ニーハイソックス　＋　ヒール　\n(マスク、マント、右二の腕の装甲、ソードベルトを取り払った状態)\n〇参考\nhttps://ul.h3z.jp/wIA79krr.jpg\nhttps://www.pixiv.net/artworks/122999921\n\n〇シチュ\n尻を広げられて、失禁脱糞絶頂。\n〇参考\nhttp://www.floral-village.info/up/1735730208.jpg\n〇詳細\n参考資料のような開脚姿勢で、持ち上げられている状態。\n全身汗だくで、睨みつけている表情。\n\n次に尻たぶを外側に広げられた状態。\n目を見開いて、食いしばった表情。\n失禁。\n\n最後に脱糞。\n白目を剥きそうに、舌を出した表情。\n顔中涙や鼻水、涎だらけに。\n\n〇補足\nレオタードのずらしや、破損はなし。背面デザインの細部もお任せします。\n相手役の女戦士的なモブのデザインはお任せします。\n場所は宿、あるいは酒場のような屋内。", "created_at": "", "completed_at": ""}, {"path": "/@nmgm_ghn/works/48", "thumbnail_src": "https://si.imgix.net/8678cb0f/uploads/origins/d4083b1f-f8d6-4c9c-a544-4b1c1ffc3504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfa188e24b44fd8ba34867abdfd30596", "thumbnail_srcset": "https://si.imgix.net/8678cb0f/uploads/origins/d4083b1f-f8d6-4c9c-a544-4b1c1ffc3504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfa188e24b44fd8ba34867abdfd30596, https://si.imgix.net/8678cb0f/uploads/origins/d4083b1f-f8d6-4c9c-a544-4b1c1ffc3504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db57582502f38d7e60ed4a5c146b6bda 2x, https://si.imgix.net/8678cb0f/uploads/origins/d4083b1f-f8d6-4c9c-a544-4b1c1ffc3504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc82cfbe9894d3472fbaa3c649ccee21 3x", "genre": "art", "nsfw": false, "body": "生ゴミ御飯様こんにちは。\nいつもお世話になっております。\n\n今回は以前お願いしたこちらのイラスト（https://skeb.jp/@nmgm_ghn/works/42）と同じような軽めのイラストをお願いしたくリクエストさせて頂きました。\nリクエスト内容は以下の通りになります。\n\n\n●対象キャラクター：\nトリクシー（アニメ「キディ・ガーランド」の登場人物）\n\n\n●キャラ参考資料：\nhttps://imgur.com/a/K9smcaa\n\n\n●シチュエーション：\n窮地を助けたことで知り合った非戦闘員の幼女から助けてくれたお礼にシロツメクサの花を編んだネックレスをプレゼントされて、嬉しさや喜びが込もった笑顔を幼女に向けている様子。\n\n\n●お願いしたい細かい点\n\n・今回はコス破壊や傷描写はなしでお願いします。\n\n・シチュエーションの通り、上記参考資料の衣装のタートルネック部分に重なるような形でシロツメクサの花を編んだネックレスの描写をお願いします。\n\n・シロツメクサの花を編んだネックレスの輪の長さはチョーカーのような短いものでお願いします。\n輪にしてから頭から被ったのではなく、編んで紐状にした物を彼女の首の後ろで幼女が輪に結んだという設定になります。\n\n・他にネックレスについてお願いしたいこだわりはございませんので細かい描写は簡単なもので構いません。\n\n・念のため付け加えると幼女の姿の描写は不要です。\nトリクシーひとりの姿でお願いします。\n\n・その他の構図やポーズなどは生ゴミ御飯様にお任せ致します。\n\n\nリクエスト内容は以上になります。\nご検討のほどよろしくお願い致します。", "created_at": "", "compl