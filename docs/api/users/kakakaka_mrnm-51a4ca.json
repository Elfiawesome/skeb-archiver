ess&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fa94f59b5ed256940e7276f90fd9d02, https://si.imgix.net/546c9105/uploads/origins/d41a53fe-3eb6-45be-987d-17f6c9d43f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22f158b1bfc961ec267de137b3f8ca98 2x, https://si.imgix.net/546c9105/uploads/origins/d41a53fe-3eb6-45be-987d-17f6c9d43f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ce1b78e7d9ffe6d095bd25127307d0e 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kakakaka_mrnm/works/37", "thumbnail_src": "https://si.imgix.net/c748498f/uploads/origins/682eb984-9545-45ae-a95d-1520bf9ded28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e96cb85fd5d7960de088ca9de47cab2", "thumbnail_srcset": "https://si.imgix.net/c748498f/uploads/origins/682eb984-9545-45ae-a95d-1520bf9ded28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e96cb85fd5d7960de088ca9de47cab2, https://si.imgix.net/c748498f/uploads/origins/682eb984-9545-45ae-a95d-1520bf9ded28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=096cf5c3ddc7a674216a7ecba66a3a41 2x, https://si.imgix.net/c748498f/uploads/origins/682eb984-9545-45ae-a95d-1520bf9ded28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=768a5c0f39ad4fccb0077f5e9408de13 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私はあなたの絵のファンです。あなたのドラゴンの描き方、舌や口が大好きです。私はヴォアとドラゴンの大ファンなのですが、友人のドラゴンのキャラクターが私のキャラクターを貪るイラストをお願いしたいです。友人のドラゴンのキャラクターはエラスという名前で、とても変わった見た目のドラゴンです。私のキャラクターはミズという名のジェナシーの探検家で、彼はエラスに食べられています！\n\nミズ：https://drive.google.com/drive/folders/1jj6nZVuJNnk4Ko8BzPonfR7RV9wue593?usp=sharing\nエラス参考アート：https://drive.google.com/drive/folders/1kl7vJ_QQqZnk80li05FTI92qh_b0NbnA?usp=sharing\n\nミズを飲み込むエラスを描いてください。Mizはすでに喉の奥に入り込んでいて、顔と片腕しか見えません。彼の片腕は彼女の歯のすぐ先まで伸びています。エラスの大きくて濡れた舌がミズを味わいながら、丸くなってミズの顔と頭に押し付けて飲み込んでいます。このポーズは、以前あなたがこのリクエストで描いたものといくらか似ている。https://skeb.jp/@kakakaka_mrnm/works/29\n\n可能であれば、ミズを飲み込んだ後のエラスを追加で描いてください。できれば、ミズを飲み込んだあとのエラスを追加でお願いします。このショットは、エラスが首に膨らみを持ち、ミズがお腹に滑り落ちてくるのを感じるために爪を押し付けているところだけを映してください。\n\nお時間とご配慮をどうもありがとうございました！リクエストを受け入れていただけるととても嬉しいです。また、PSDファイルを添付していただけると助かりますが、必須ではありません。<3", "created_at": "", "completed_at": ""}, {"path": "/@kakakaka_mrnm/works/36", "thumbnail_src": "https://si.imgix.net/7c04cc13/uploads/origins/3de57eb9-fa99-4d70-9212-ea6ecccc10f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c901589ea8ed5b9c45327fd88e820b86", "thumbnail_srcset": "https://si.imgix.net/7c04cc13/uploads/origins/3de57eb9-fa99-4d70-9212-ea6ecccc10f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c901589ea8ed5b9c45327fd88e820b86, https://si.imgix.net/7c04cc13/uploads/origins/3de57eb9-fa99-4d70-9212-ea6ecccc10f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00798511df1e9694380156de92a9a9e2 2x, https://si.imgix.net/7c04cc13/uploads/origins/3de57eb9-fa99-4d70-9212-ea6ecccc10f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcc503a8edf0381a530a165dc67f3583 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kakakaka_mrnm/works/35", "thumbnail_src": "https://si.imgix.net/5751fb1b/uploads/origins/14030525-aa5c