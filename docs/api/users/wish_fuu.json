8770-74f897d818bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=936f867de97a10dc25e9cbfd92356004", "thumbnail_srcset": "https://si.imgix.net/fa37a7cd/uploads/origins/548d5841-ca10-41d2-8770-74f897d818bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=936f867de97a10dc25e9cbfd92356004, https://si.imgix.net/fa37a7cd/uploads/origins/548d5841-ca10-41d2-8770-74f897d818bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d36945a6d51d26952277a9dade8ac1f 2x, https://si.imgix.net/fa37a7cd/uploads/origins/548d5841-ca10-41d2-8770-74f897d818bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e7e43004fd60c730e91aacd9b42e8de 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ファイアーエムブレム 聖魔の光石のテティスがソロでシンクロナイズドスイミングの演技をしている様子を、2枚の別々のイラストで描いていただけませんか？\n\n最初のイラストは、テティスが両腕を上げてポーズを取る姿で、彼女は微笑んでいる。二番目のイラストは、彼女の脚だけを写したもので、水面から勢いよく飛び上がる瞬間を捉えている。\n\nhttps://imgur.com/a/crC0EXz\n\nリンク先にはテティスの参考資料、両方のポーズ、そして彼女に着てほしい衣装が掲載されています。\n\nお時間をいただき、ご配慮いただき、誠にありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@wish_fuu/works/7", "thumbnail_src": "https://si.imgix.net/e4f3d565/uploads/origins/62e44dea-e838-421a-a3a0-f16e6d81a4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d66a01821371440c48ba1cf279d92444", "thumbnail_srcset": "https://si.imgix.net/e4f3d565/uploads/origins/62e44dea-e838-421a-a3a0-f16e6d81a4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d66a01821371440c48ba1cf279d92444, https://si.imgix.net/e4f3d565/uploads/origins/62e44dea-e838-421a-a3a0-f16e6d81a4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e57c70879117da9c44ce59c07783b6ac 2x, https://si.imgix.net/e4f3d565/uploads/origins/62e44dea-e838-421a-a3a0-f16e6d81a4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f08cabf9d0862637cd79b66bf764aa95 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ファイアーエムブレム 新・紋章の謎の女性版クリスをお願いしたいです。ポーズは、剣を抜き、自信に満ちた表情のクリスです。\n\nこのリンクにクリスの参考資料があります: https://imgchest.com/p/9rydro8kn7k", "created_at": "", "completed_at": ""}, {"path": "/@wish_fuu/works/6", "thumbnail_src": "https://si.imgix.net/0f2402f1/uploads/origins/1489f55c-7184-4ed0-bd71-830e328d9d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6e33fc961ee7238f1648b6f6e3f6817", "thumbnail_srcset": "https://si.imgix.net/0f2402f1/uploads/origins/1489f55c-7184-4ed0-bd71-830e328d9d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6e33fc961ee7238f1648b6f6e3f6817, https://si.imgix.net/0f2402f1/uploads/origins/1489f55c-7184-4ed0-bd71-830e328d9d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7480a0d774ebd5b8096f9a6e37792a0c 2x, https://si.imgix.net/0f2402f1/uploads/origins/1489f55c-7184-4ed0-bd71-830e328d9d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a6c015a2bd898b17e9cb2ff2c116493 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きなので、私のOC \"Vivienne \"をリクエストしたいです。\n\n彼女は冷たく、激しくエレガントで、何よりも統制を重んじる女性です。すべてのジェスチャーは慎重に、すべての言葉は慎重に。彼女は感情、特に情熱的なものを危険視する。\n\n彼女の参考文献：https://drive.google.com/file/d/1sqaNp6MP0mlp4LxP55K6vddgagaOisLQ/view?usp=sharing\n\n夏をテーマに、水着姿の彼女を考えていたのですが、もし別の衣装やテーマがあるのなら、それもOKです！^^\n\n私の \"ヴィヴィアン \"を楽しんでもらえると嬉しいです！\n\nご検討ありがとうございました^^。", "created_at": "", "completed_at": ""}, {"path": "/@wish_fuu/works/5", "thumbnail_src": "https://si.imgix.net/f7a6e1d7/uploads/origins/d78c6c9b-7fe4-4143-b074-42a1b0d6cde6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=811c566351d3f3714e49f114902a6b29", "thumbnail_srcset": "https://si.imgix.net/f7a6e1d7/uploads/origins/d78c6c9b-7fe4-4143-b074-42a1b0d6cde6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=811c566351d3f3714e49f114902a6b29, https://si.imgix.net/f7a6e1d7/uploads/origins/d78c6c9b-7fe4-4143-b074-42a1b0d6cde6?bg=%23fff&auto=format%2Ccompress