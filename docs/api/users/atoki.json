Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c9e2c8a896e3f5f30846965373b4123 2x, https://si.imgix.net/5e3f5afd/uploads/origins/ccb5c384-7872-45e3-acd1-6806968b6510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=956c655d4ff682cb4dbb5fe63fb378b4 3x", "genre": "art", "nsfw": false, "body": "大人化(20代後半程度のイメージ)した三月精(サニーミルク、ルナチャイルド、スターサファイア)のイラストをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/17", "thumbnail_src": "https://si.imgix.net/d93f2d00/uploads/origins/4abec44c-b457-4781-a5a7-9b031c2e81c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48011ca9f6753746d02a449fb43843c5", "thumbnail_srcset": "https://si.imgix.net/d93f2d00/uploads/origins/4abec44c-b457-4781-a5a7-9b031c2e81c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48011ca9f6753746d02a449fb43843c5, https://si.imgix.net/d93f2d00/uploads/origins/4abec44c-b457-4781-a5a7-9b031c2e81c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72cda2d84d1bae74a439110039a79e3c 2x, https://si.imgix.net/d93f2d00/uploads/origins/4abec44c-b457-4781-a5a7-9b031c2e81c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6aedf58cdd3289f1a95460f53bec5acc 3x", "genre": "art", "nsfw": false, "body": "執事服の雷鼓さんとメイド服（ロングスカート）の影狼さんをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/16", "thumbnail_src": "https://si.imgix.net/2d912c71/uploads/origins/b50df584-9a4a-41e3-aae0-67fbe1483860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efda704166dffef1072bccc3c981862", "thumbnail_srcset": "https://si.imgix.net/2d912c71/uploads/origins/b50df584-9a4a-41e3-aae0-67fbe1483860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efda704166dffef1072bccc3c981862, https://si.imgix.net/2d912c71/uploads/origins/b50df584-9a4a-41e3-aae0-67fbe1483860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3d0790f9ce76aab31cae8d575dd5609 2x, https://si.imgix.net/2d912c71/uploads/origins/b50df584-9a4a-41e3-aae0-67fbe1483860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1aba519111bddb7ce8359cffa8a87a28 3x", "genre": "art", "nsfw": false, "body": "風邪でダウンした文ちゃんと、非日常イベントをちょっと楽しみながら看病している早苗さんをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/15", "thumbnail_src": "https://si.imgix.net/245e651b/uploads/origins/fbb84167-558b-484f-bbf6-108a8bbd0ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b1ef4354cf9bde650b8b37327c86320", "thumbnail_srcset": "https://si.imgix.net/245e651b/uploads/origins/fbb84167-558b-484f-bbf6-108a8bbd0ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b1ef4354cf9bde650b8b37327c86320, https://si.imgix.net/245e651b/uploads/origins/fbb84167-558b-484f-bbf6-108a8bbd0ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16b0b88217034c290b4f6bcf225a4d1c 2x, https://si.imgix.net/245e651b/uploads/origins/fbb84167-558b-484f-bbf6-108a8bbd0ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4f2e2f4b3ea3c852a9141984eebf2b5 3x", "genre": "art", "nsfw": false, "body": "八千慧早鬼饕餮と飯綱丸典百々世が接しているイラストをリクエストします。下記のペアで描いていただきたいです\n\n早鬼と百々世→二人は戦い終わった後のように強さを気に入って友達になってる。名刺代わりに自分のアビリティカードを交換し合ってる。(一応買ってはいる)\n\n\n饕餮と飯綱丸→表向きはアビリティカードのビジネスの話をしているが\n\n飯綱丸は饕餮がどういう人物か知っていて気になっていて戦ってみたくて仕方ない(戦闘好きだから)\n饕餮は飯綱丸を見て強欲そうな奴と気になってる\n\nと互いに心の中でウズウズしている。\n\n\n八千慧と典→アビリティカードのビジネスをしている。\n\n\n大変だと思いますが各キャラの会話を付けてほしいです。\n\n指定していないところや細かい構図などはあとき先生にお任せしたいです。\n\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/14", "thumbnail_src": "https://si.imgix.net/b276fd91/uploads/origins/3040abb9-97d6-43ad-9698-68b263d3852b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb85600bb587f680f6ce145857126b70", "thumbnail_srcset": "https://si.imgix.net/b276fd91/uploads/origins/3040abb9-97d6-43ad-9698-68b263d3852b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb85600bb587f680f6ce145857126b70, https://si.imgix.net/b276fd91/uploads/origins/3040abb9-97d6-43ad-9698-68b263d3852b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c00083d0817699a0cb7beacd05f9c9c 2x, https://si.imgix.net/b276fd91/uploads/origins/3040abb9-97d6-43ad-9698-68b263d3852b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15eb8a0a98f266528bfe33e02d445c43 3x", "genre": "art", "nsfw": false, "body": "안녕하세요.\n저는 한국인 입력해 주세요.\n번역기를 사용하는점 양해 부탁드립니다.\n당신의 그림 보고 감명받았습니다.\n\n제가 요청드릴것은.\n판타지세계에서 OC \"POCHI\" 와 OC \"ssoO\" 두 캐릭이\n일본의 대하면서 일본의 대하면서 대하는데\n토끼와 슬라임도 다가와 같은 어울리는 모듬으로 보고싶으로 있습니다.\n\nOC \"POCHI\" 와 OC \"ssoO\" 는 동료입니다.\n\n\n그외 나머지는 당신의 마음대로 표현해주세요.\nhttps://drive.google.com/drive/folders/11WoxtHrBcH929kE2cJsytbtb2TK28Wn3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/13", "thumbnail_src": "https://si.imgix.net/2d750f16/uploads/origins/71778d90-24be-40b6-9a35-232e750e6526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12025985a2e129987a5a7fceff17f41a", "thumbnail_srcset": "https://si.imgix.net/2d750f16/uploads/origins/71778d90-24be-40b6-9a35-232e750e6526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12025985a2e129987a5a7fceff17f41a, https://si.imgix.net/2d750f16/uploads/origins/71778d90-24be-40b6-9a35-232e750e6526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db0fe24d38c11938cbe9221f8ba8149f 2x, https://si.imgix.net/2d750f16/uploads/origins/71778d90-24be-40b6-9a35-232e750e6526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e132eba2b4f75810a84f7bd3326c2da 3x", "genre": "art", "nsfw": false, "body": "地底に仮移住して地底組(ヤマメパルスィ勇儀)と接してる百々世　をリクエストします。\n\n構図は真ん中に百々世と左右にヤマメと勇儀が居て二人は百々世に強そう、働き者で頼もしいみたいな褒めている台詞を付けてほしいです。\n\n百々世は身内以外の他人に賞賛されることは滅多にない為照れつつ喜んでいる。　\n\n近くにパルスィも居て妬ましそうに見ている。\n\n距離離れてる所に飯綱丸が居て「良かったなあ百々世」と言い微笑ましく見守っている。\n\n\nその他の細かい構図や台詞などはあとき先生にお願いしたいです。どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/12", "thumbnail_src": "https://si.imgix.net/9b5100fc/uploads/origins/949fbce9-40d6-459f-84fe-83b7f1c67586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2198a7765b8be20fad8d704766e9ca7", "thumbnail_srcset": "https://si.imgix.net/9b5100fc/uploads/origins/949fbce9-40d6-459f-84fe-83b7f1c67586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2198a7765b8be20fad8d704766e9ca7, https://si.imgix.net/9b5100fc/uploads/origins/949fbce9-40d6-459f-84fe-83b7f1c67586?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e43a2128d8181f7438af70da02af13ec 2x, https://si.imgix.net/9b5100fc/uploads/origins/949fbce9-40d6-459f-84fe-83b7f1c67586?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14b6ca51e186f71af157776391061534 3x", "genre": "art", "nsfw": false, "body": "いつも可愛い絵をありがとうございます。\n依頼内容ですが、apex legendsのシアというキャラの服を着た水橋パルスィをお願いします。\nポーズはお任せします。\nSNSの使用を考えています", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/11", "thumbnail_src": "https://si.imgix.net/1352c9e6/uploads/origins/8d760a2e-62b0-405b-bbc7-33a97d342800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c543756c09c0c8f990b4435a29043d5e", "thumbnail_srcset": "https://si.imgix.net/1352c9e6/uploads/origins/8d760a2e-62b0-405b-bbc7-33a97d342800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c543756c09c0c8f990b4435a29043d5e, https://si.imgix.net/1352c9e6/uploads/origins/8d760a2e-62b0-405b-bbc7-33a97d342800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d04754558dec53dea51301a8b825fd25 2x, https://si.imgix.net/1352c9e6/uploads/origins/8d760a2e-62b0-405b-bbc7-33a97d342800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8b1fa661a5f53957720b4a5dd68f7d0 3x", "genre": "art", "nsfw": true, "body": "典が虹龍洞絡みの任務に失敗して落ち込んでいる所を百々世が慰めている　イラストをリクエストします。\n\n構図は右側が典で左側に百々世。　どちらも右側を向いていて正面よりの右向き\n\n百々世は後ろから典の頭を右手でわしゃわしゃして「典、おめぇが黙っていれば問題ないってことだよ」\nと言っている。\n典は顔が見える程度に下を向きつつ泣いて涙を零している(いきなり百々世に頭を触られたから)\n\nその他以外の所の構図はあとき先生にお任せします。\n2行目の構図がわかりにくいかもしれませんがその際はあとき先生のアドリブでお願いします\n\n注文が多くなってしまい恐縮ですがよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/10", "thumbnail_src": "https://si.imgix.net/40383a0f/uploads/origins/6b403bf1-7770-4f4f-98ac-7e2deb83930d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a39910717d9603c43907f827feec7b1", "thumbnail_srcset": "https://si.imgix.net/40383a0f/uploads/origins/6b403bf1-7770-4f4f-98ac-7e2deb83930d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a39910717d9603c43907f827feec7b1, https://si.imgix.net/40383a0f/uploads/origins/6b403bf1-7770-4f4f-98ac-7e2deb83930d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=113e83334d07286c96fd21572a80d78d 2x, https://si.imgix.net/40383a0f/uploads/origins/6b403bf1-7770-4f4f-98ac-7e2deb83930d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8494e09857d6a261314e320bbe52459 3x", "genre": "art", "nsfw": false, "body": "鬼傑組に金属鍛造で作った武器を納品する多々良小傘ちゃんをお願いします。\n八千慧さんは「貴女、見た目の割にはやりますね……」と、表情は普段通りながらも感心してる仕草を取っているとより良いです。", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/9", "thumbnail_src": "https://si.imgix.net/4ae06cbf/uploads/origins/a5a03ec1-85f9-4ddc-bcb3-804df4dfdc90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dad38f1165172cf02ae8109f627f252", "thumbnail_srcset": "https://si.imgix.net/4ae06cbf/uploads/origins/a5a03ec1-85f9-4ddc-bcb3-804df4dfdc90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dad38f1165172cf02ae8109f627f252, https://si.imgix.net/4ae06cbf/uploads/origins/a5a03ec1-85f9-4ddc-bcb3-804df4dfdc90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edbd33c41b648af4144b8b6364c403e6 2x, https://si.imgix.net/4ae06cbf/uploads/origins/a5a03ec1-85f9-4ddc-bcb3-804df4dfdc90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f111b3d581e44f5ce444b50f02e2b0d5 3x", "genre": "art", "nsfw": false, "body": "いつも可愛くて面白い作品を楽しませていただいています。\nそれぞれ大変だった一日の疲れを癒やし合うゆかれいむをお願いしたいと思います。\nたとえば抱っこ充電とか、膝枕とか、肩にもたれる、などなど、とにかくそういう雰囲気で、詳細は任せます。", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/8", "thumbnail_src": "https://si.imgix.net/00236b40/uploads/origins/f601ae68-47a1-4bfc-ae81-ba88487eda3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b8319897cff4f65e31700ea154dd41a", "thumbnail_srcset": "https://si.imgix.net/00236b40/uploads/origins/f601ae68-47a1-4bfc-ae81-ba88487eda3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b8319897cff4f65e31700ea154dd41a, https://si.imgix.net/00236b40/uploads/origins/f601ae68-47a1-4bfc-ae81-ba88487eda3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=355458a0d016cd989d823365b0735ce3 2x, https://si.imgix.net/00236b40/uploads/origins/f601ae68-47a1-4bfc-ae81-ba88487eda3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20abe8a0e720b663764b9a0db9055566 3x", "genre": "art", "nsfw": false, "body": "勇儀とパルスィが二人で苺のショートケーキを食べているイラストをお願いしたいです。\n\nもし図柄的に入るようでしたら、同じ席にキスメも加わっているととても嬉しいです。\n(「まいごのかくしごと」でジャムをなめているデフォルメのキスメがとても可愛かったので……)", "created_at": "", "completed_at": ""}, {"path": "/@atoki/works/7", "thumbnail_src": "https://si.imgix.net/bac30f18/uploads/origins/b7df85d1-6f43-4c97-a41e-9240110cf63f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a186ea8895189471c6d5eea4f3468468", "thumbnail_srcset": "https://si.imgix.net/bac30f18/uploads/origins/b7df85d1-6f43-4c97-a41e-9240110cf63f?bg=%23fff&auto=format%2