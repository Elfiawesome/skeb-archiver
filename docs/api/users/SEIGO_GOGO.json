-9d7e-d7664af4b8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6cee2b34a6da8ae35feae3e6487d0c2", "thumbnail_srcset": "https://si.imgix.net/c8d18144/uploads/origins/56663ba2-bdb4-468c-9d7e-d7664af4b8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6cee2b34a6da8ae35feae3e6487d0c2, https://si.imgix.net/c8d18144/uploads/origins/56663ba2-bdb4-468c-9d7e-d7664af4b8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=929538cfcef1810cbf3d52de00acb782 2x, https://si.imgix.net/c8d18144/uploads/origins/56663ba2-bdb4-468c-9d7e-d7664af4b8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8bef6b1687de4b0fd49d68f536a586f 3x", "genre": "art", "nsfw": false, "body": "両想い夢女にラッキースケベ揃ヱくんが見たいです！！！！！！！！！！！！！！！！", "created_at": "", "completed_at": ""}, {"path": "/@SEIGO_GOGO/works/5", "thumbnail_src": "https://si.imgix.net/122d308b/uploads/origins/efbe8401-3857-459e-a286-dc2c09bf0b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e81d70a4a3c0d064867b400035562dfc", "thumbnail_srcset": "https://si.imgix.net/122d308b/uploads/origins/efbe8401-3857-459e-a286-dc2c09bf0b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e81d70a4a3c0d064867b400035562dfc, https://si.imgix.net/122d308b/uploads/origins/efbe8401-3857-459e-a286-dc2c09bf0b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c454841e1eae03ba89a8a3133887f718 2x, https://si.imgix.net/122d308b/uploads/origins/efbe8401-3857-459e-a286-dc2c09bf0b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0dcf79867ebd0c0cf8f1d9346331513 3x", "genre": "art", "nsfw": false, "body": "誤誤正誤さんの絵柄が本当に大好きなので今回オリジナルキャラクターを描いていただきたくリクエストを送らせていただきます！\n資料はこちらからご覧下さい↓\nhttps://x.com/asodaimidori/status/1775588001407705596?s=46\n服装は豆山→学ラン　先生→白衣\n豆山がちょっかいをかけて先生は鬱陶しそうにしてる感じでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@SEIGO_GOGO/works/4", "thumbnail_src": "https://si.imgix.net/559cd5bc/uploads/origins/d9cc9c52-ca25-4c29-b8a3-40e1e289b32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91ffff72b1f4777cde55cc051a7e5ae0", "thumbnail_srcset": "https://si.imgix.net/559cd5bc/uploads/origins/d9cc9c52-ca25-4c29-b8a3-40e1e289b32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91ffff72b1f4777cde55cc051a7e5ae0, https://si.imgix.net/559cd5bc/uploads/origins/d9cc9c52-ca25-4c29-b8a3-40e1e289b32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b88403724f81d44d62c19d310f57d0f 2x, https://si.imgix.net/559cd5bc/uploads/origins/d9cc9c52-ca25-4c29-b8a3-40e1e289b32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53fc745921815b03e28cb397c3c09fae 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SEIGO_GOGO/works/3", "thumbnail_src": "https://si.imgix.net/3de06ca4/uploads/origins/ecf8d450-29e4-4bdc-91a7-06cf5e85bf28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75ae1483795793a7cd8121ddaa6ad16", "thumbnail_srcset": "https://si.imgix.net/3de06ca4/uploads/origins/ecf8d450-29e4-4bdc-91a7-06cf5e85bf28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75ae1483795793a7cd8121ddaa6ad16, https://si.imgix.net/3de06ca4/uploads/origins/ecf8d450-29e4-4bdc-91a7-06cf5e85bf28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7067ecb0f418466da95d9ad57c4fefbf 2x, https://si.imgix.net/3de06ca4/uploads/origins/ecf8d450-29e4-4bdc-91a7-06cf5e85bf28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f5acfb97cdeef889166c3028cade24f 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n誤誤正誤さんのキャラクターや世界観全てが好きです。ちょっと前まではたまにしか浮上できなかったのでその時に少し絵を見に行く程度しかできませんでしたが、最近は浮上する機会が増えたので特にハマってます。\nイラストが上がる度に1人で盛り上がってうるさくしてるのに、リプくださったり、ファンアートに引用で感想言ってもらえて嬉しいです。\nカンバスやおいでよ導火市市のキャラクターや設定全部好きですが、特にロボコン部のみんな個性が強くて毎度ギャグやってるところが大好きです。\n\nリクエストの内容は、\nわちゃわちゃしてるロボコン部をお願いします。\n自分の解釈が合ってるのかわからないので、以下は想像ですが\n・中津くんや春地くんは部長の誕生日を大袈裟に祝ってそう、それに付き合わされる揃ヱくんと普通にウキウキで手伝ってる鉄畑くん\n\n・部活サボってる揃ヱくんと、部活でやることがないから揃ヱくんと仲良くなろうと奮闘する鉄畑くん、それを注意する中津くん\n\n(部長と副部長のイメージがあまり掴めていないのでこの2人をどうするかは誤誤正誤さんにお任せします。\n「ロボコン部」という表現をしましたが、全員は強制じゃないです、ご自由にお願いします。)\n\nロボコン部ってこういう時どんな感じだろうなーって考えた妄想です。ガチガチに指定するのは不安なので例として２つ挙げましたが、どっちも沿わずに日常の一部とかでも全然大丈夫です。誤誤正誤さんの解釈と描きやすい方でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@SEIGO_GOGO/works/2", "thumbnail_src": "https://si.imgix.net/1533afd6/uploads/origins/7d5fc0ce-5087-4102-9800-91848d50f8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e0dfa42d741290b50faadd2a6d098fb", "thumbnail_srcset": "https://si.imgix.net/1533afd6/uploads/origins/7d5fc0ce-5087-4102-9800-91848d50f8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e0dfa42d741290b50faadd2a6d098fb, https://si.imgix.net/1533afd6/uploads/origins/7d5fc0ce-5087-4102-9800-91848d50f8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa46a083b714efd0c6fd519d4be3c31 2x, https://si.imgix.net/1533afd6/uploads/origins/7d5fc0ce-5087-4102-9800-91848d50f8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6d1461fe14ec7b423007cd69568daa4 3x", "genre": "art", "nsfw": false, "body": "アイコンの火薬ちゃんみたいなちびキャラの暁くん（https://www.pixiv.net/artworks/107395422）と、それを邪魔そうにしている冬夜くん（https://www.pixiv.net/artworks/107395509）を描いてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@SEIGO_GOGO/works/1", "thumbnail_src": "https://si.imgix.net/d63be438/uploads/origins/8c39b280-cb06-4f1b-b518-bff6ad6cd5a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ff683e10223b9913a8f7986ada5424", "thumbnail_srcset": "https://si.imgix.net/d63be438/uploads/origins/8c39b280-cb06-4f1b-b518-bff6ad6cd5a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ff683e10223b9913a8f7986ada5424, https://si.imgix.net/d63be438/uploads/origins/8c39b280-cb06-4f1b-b518-bff6ad6cd5a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6df342d3584fc9fb4a74a9e5ce8ba7a2 2x, https://si.imgix.net/d63be438/uploads/origins/8c39b280-cb06-4f1b-b518-bff6ad6cd5a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8c24d7385ae7c612fe54eaa924dbda7 3x", "genre": "art", "nsfw": false, "body": "夏に縁側でスイカを食べている同郷組(性愛でもノット性愛でもどちらでも、お好きな方で)の絵を描いていただきたいです。(これ以上の構図や服装、シチュエーションなどにおける指示は特にございません)\nこういったフォーマルな場で依頼をするのは始めてですので、何か不躾なことをしてしまっているのであればぜひ教えて下さい。", "created_at": "", "completed_at": ""}]}