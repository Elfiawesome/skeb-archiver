nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@katuragi0209/works/125", "thumbnail_src": "https://si.imgix.net/549e9bf7/uploads/origins/a9c2833b-8bd2-410b-9ea3-c11d4c9d55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a31b94cd413fbc9aecdf1eb3a37d452", "thumbnail_srcset": "https://si.imgix.net/549e9bf7/uploads/origins/a9c2833b-8bd2-410b-9ea3-c11d4c9d55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a31b94cd413fbc9aecdf1eb3a37d452, https://si.imgix.net/549e9bf7/uploads/origins/a9c2833b-8bd2-410b-9ea3-c11d4c9d55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9ad90f517e091cba59665d53c0ec58f 2x, https://si.imgix.net/549e9bf7/uploads/origins/a9c2833b-8bd2-410b-9ea3-c11d4c9d55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6fcbb8c40c80bc0210a5c260c3e8ce1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@katuragi0209/works/124", "thumbnail_src": "https://si.imgix.net/73299ff0/uploads/origins/c4346bfd-84c3-4d3b-91f2-76af0a0da512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3642f0c457922ded4286c34328ebd2d0", "thumbnail_srcset": "https://si.imgix.net/73299ff0/uploads/origins/c4346bfd-84c3-4d3b-91f2-76af0a0da512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3642f0c457922ded4286c34328ebd2d0, https://si.imgix.net/73299ff0/uploads/origins/c4346bfd-84c3-4d3b-91f2-76af0a0da512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4da7dcb21f9f22