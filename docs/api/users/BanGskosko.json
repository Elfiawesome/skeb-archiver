/1da52a9f-e1c2-42b6-a11e-7cef08221ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b09f14190a8f9ee764235ec9fd9bed3", "thumbnail_srcset": "https://si.imgix.net/0f08f9ff/uploads/origins/1da52a9f-e1c2-42b6-a11e-7cef08221ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b09f14190a8f9ee764235ec9fd9bed3, https://si.imgix.net/0f08f9ff/uploads/origins/1da52a9f-e1c2-42b6-a11e-7cef08221ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edba2db6b9be02eafd57f7b6965148fb 2x, https://si.imgix.net/0f08f9ff/uploads/origins/1da52a9f-e1c2-42b6-a11e-7cef08221ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4ec6cc2a142c81ef99bd054709dc685 3x", "genre": "art", "nsfw": false, "body": "今流行りの猫ミームのイラストを\n私のオリキャラの生徒会メンバーの子達で描いて欲しく依頼します\nお題「キャラで猫ミーム」\nキャラ 鈴音達の生徒会メンバー\n\n参考先に描いて欲しい猫ミーム達あります\nキャラのサイズはデフォルトでも構いません\nその中で合いそうなのは\nハピハピ猫→鈴音\n色々言うヤギ→ソフィア\n猫パンチ→光と愛菜(身長差があって愛菜の胸を叩くことになる光)\n\n\n他の猫ミームは他のキャラでも同じキャラいいですし被っても構いません\n台詞有無でお願いします\n\nアイコンやLINEスタンプみたいにきっと可愛いと思います( *˙ω˙*)و \nピッチピチ猫とか腰を左右に振る猫も結構面白いです☺️\n\nhttps://twitter.com/YATOGMITOHKA/status/1759199307738275875?t=25FzoE3KDQttgxnCeDlTUA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/58", "thumbnail_src": "https://si.imgix.net/6606a0ee/uploads/origins/309011c2-c675-46a3-8fef-d2871667295f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d1ebb690f6b76ddaac0fadf65654d3", "thumbnail_srcset": "https://si.imgix.net/6606a0ee/uploads/origins/309011c2-c675-46a3-8fef-d2871667295f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d1ebb690f6b76ddaac0fadf65654d3, https://si.imgix.net/6606a0ee/uploads/origins/309011c2-c675-46a3-8fef-d2871667295f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=010b537012e0d840d15aa95768eae849 2x, https://si.imgix.net/6606a0ee/uploads/origins/309011c2-c675-46a3-8fef-d2871667295f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63431f5925929bc1e6e0b01e4a68bfd8 3x", "genre": "art", "nsfw": true, "body": "こんにちは現文のままとなってたので🤔\n英語とかになってたのでしょうか？少し編集して再送信します\n\nお題\n｢立ちバックごっこ鈴音\n\nキャラ\n小3の渡壁鈴音\n\n服装\n水着③は裸版\n\nシチュ\n①1枚目 \n立ちバック風に腕引っぱられながら腰を打ちつけられる鈴音1枚の絵\n↓台詞\n女友｢オラオラ♪鈴音いけいけ♪｣\n鈴音｢鈴音にパンパンしないでってばw｣\n\n②2枚目\n画面横に揺れてる鈴音の胸があり\n他の子達それを見てイヤらしい想像しちゃう\n\n男の子達には｢渡壁｣とよばれてる\n\n③\n ①の裸ver.\n\n④\n②の揺れてる胸だけ丸見え状態\n\n台詞有と無に分けてくれると嬉しいです\nお時間ある時にでもよろしくお願い\n\nhttps://twitter.com/YATOGMITOHKA/status/1736289930098397496?t=wqUWp4GWxT225EGY0Uw9lA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/57", "thumbnail_src": "https://si.imgix.net/277e3a34/uploads/origins/11599581-18c0-46f7-8830-2076b1558813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5265dfe584d7bb7b4c4c5f43125069cc", "thumbnail_srcset": "https://si.imgix.net/277e3a34/uploads/origins/11599581-18c0-46f7-8830-2076b1558813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5265dfe584d7bb7b4c4c5f43125069cc, https://si.imgix.net/277e3a34/uploads/origins/11599581-18c0-46f7-8830-2076b1558813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfff62d0cec44ab137f2a13d451a6692 2x, https://si.imgix.net/277e3a34/uploads/origins/11599581-18c0-46f7-8830-2076b1558813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15e382fd1bb97eb50df9658a0939538b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/56", "thumbnail_src": "https://si.imgix.net/5216be9a/uploads/origins/9d2635b2-ce65-446c-a68c-5b40098c5a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4095033e3600900c304fb00a373bee99", "thumbnail_srcset": "https://si.imgix.net/5216be9a/uploads/origins/9d2635b2-ce65-446c-a68c-5b40098c5a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4095033e3600900c304fb00a373bee99, https://si.imgix.net/5216be9a/uploads/origins/9d2635b2-ce65-446c-a68c-5b40098c5a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ee380214540365efae85fecb9946b7a 2x, https://si.imgix.net/5216be9a/uploads/origins/9d2635b2-ce65-446c-a68c-5b40098c5a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a5e3b299349e8f61da6c78903c38c4b 3x", "genre": "art", "nsfw": true, "body": "きおさんこんばんは🥳\n 鈴音は前の裸は見ますがあまりおしりや後ろ姿見ないので鈴音も料理上手なので依頼します\nお題\n裸エプロンで料理用意した鈴音\n キャラ\n渡壁 鈴音\n鈴音は私の事｢十香｣と呼んでる\n今回は漫画でなく一面イラストで\n裸エプロンでお尻や後ろ姿とこっちを見る参考の様な構図\n向きは参考は体を左側向いてるので左右反転で右側向きで参考絵と繋がるような絵もいいかもですね\nｸﾛｽしてないのでｾｰﾌです\n鈴音の髪型はロングヘアーにロングの頭部の後ろにポニテ\n\n差分\n①参考のリサ見たく呼ぶ\n②恥ずかしがる鈴音\n えっ食べるって 鈴音のこと？←台詞\n③①の台詞無\n④②の台詞無\n何卒検討お願いします\n\nhttps://skeb.jp/@BanGskosko/works/23", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/55", "thumbnail_src": "https://si.imgix.net/e2784e87/uploads/origins/65f31592-7dd4-414a-8685-15f37f5b6329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebbc5385e64143c1881b2d76955bccff", "thumbnail_srcset": "https://si.imgix.net/e2784e87/uploads/origins/65f31592-7dd4-414a-8685-15f37f5b6329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebbc5385e64143c1881b2d76955bccff, https://si.imgix.net/e2784e87/uploads/origins/65f31592-7dd4-414a-8685-15f37f5b6329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb574150b84b38a4bbad869c54f1bf01 2x, https://si.imgix.net/e2784e87/uploads/origins/65f31592-7dd4-414a-8685-15f37f5b6329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81793dfe19fbd9965acf24154d276809 3x", "genre": "art", "nsfw": false, "body": "こんにちは(」・ω・)\n鈴音や2年生の依頼はよくしますが\nたまには1年生の依頼します\n\nお題\n｢1年生コンビの日常｣\nキャラ\n｢光庵寺 光｣｢闇桜 愛菜｣\n\n構図\n前作のリサゆき時の様に2人が並んでる図\n\n光は愛菜の胸元まで位の身長\n愛菜はジト目キャラきおさんの描いた愛菜も同じ感じ\n\nシチュ\n1 生徒会終わり帰宅中の話たりして\n   やる事したので帰宅したら後で通信プレイでもすると光を誘う愛菜\n\n2 光は1度断る\n実は渡壁先輩,ソフィア先輩も参加すると伝えると\n\n3 鈴音が参加する事と聞き参加すると答える光 返答に反応しつつも光をイジる愛菜\n\n台詞有無でお願いします\nお時間ある時でお願いします\n\nhttps://twitter.com/YATOGMITOHKA/status/1704464506422992909?t=SymxGXy6_AtPx_d9w4jrJQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/54", "thumbnail_src": "https://si.imgix.net/b3bd7b2e/uploads/origins/05097b9a-f416-45fb-a9ff-35e1f56161dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bc9825cbf17642f0c5bbb8ff7fe670e", "thumbnail_srcset": "https://si.imgix.net/b3bd7b2e/uploads/origins/05097b9a-f416-45fb-a9ff-35e1f56161dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bc9825cbf17642f0c5bbb8ff7fe670e, https://si.imgix.net/b3bd7b2e/uploads/origins/05097b9a-f416-45fb-a9ff-35e1f56161dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80255830e8a2babe79de349cb013eab6 2x, https://si.imgix.net/b3bd7b2e/uploads/origins/05097b9a-f416-45fb-a9ff-35e1f56161dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ad96029054453fa0b7901d0a440c8d6 3x", "genre": "art", "nsfw": true, "body": "バンドリの倉田ましろをお願いします。\n\n衣装は「情熱、伝わる想い」でお願いします。\n\nポージングに指定はありません。\n\nシチュエーションとしてはベッドの上で着衣セックスで体位から竿役の有無まですべてお任せします。\n事後シチュもいいかも？お任せ。\n\nコンドームの箱、未開封のゴム、使用済みゴムを必ず描写してほしいのと\nもし衣装を一部でも脱がす場合は脱いだ衣装が映っていてほしいです。\n\n\np.s 今年でおじさんになります。", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/53", "thumbnail_src": "https://si.imgix.net/0949fcc9/uploads/origins/bbf5d945-b21b-4ecb-98de-a5ae3d76194d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d8ba427d3532648356ca1a7772a8e7", "thumbnail_srcset": "https://si.imgix.net/0949fcc9/uploads/origins/bbf5d945-b21b-4ecb-98de-a5ae3d76194d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d8ba427d3532648356ca1a7772a8e7, https://si.imgix.net/0949fcc9/uploads/origins/bbf5d945-b21b-4ecb-98de-a5ae3d76194d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5de4797fcbfb343adba876ed2a000934 2x, https://si.imgix.net/0949fcc9/uploads/origins/bbf5d945-b21b-4ecb-98de-a5ae3d76194d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19343df328c134e9ea7b6b5bad94ef74 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n浴衣姿のりみりんが、打ち上げ花火のドーンって音に驚いて、花火を怖がってる絵をリクエストさせていただきます。\nガルパイベントで、ポピパ5人で夏祭り参加して時に着てたピンクの浴衣にしていただけたら幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@BanGskosko/works/52", "thumbnail_src": "https://si.imgix.net/73320cc0/uploads/origins/d22e59e0-f70e-44b5-bc94-354d34b85a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c557652006fda068fa682523249f72b7", "thumbnail_srcset": "https://si.imgix.net/73320cc0/uploads/origins/d22e59e0-f70e-44b5-bc94-354d34b85a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c557652006fda068fa682523249f72b7, https://si.imgix.net/73320cc0/uploads/origins/d22e59e0-f70e-44b5-bc94-354d34b85a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05f668e8d4a8b956d2b0a035bf7167c1 2x, https://si.imgix.net/73320cc0/uploads/origins/d22e59e0-f70e-44b5-bc94-354d34b85a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd5ddf9b2a68f018c92055f7500aab6d 3x", "genre": "art", "nsfw": true, "body": "納品早々すみません\nまた8/27が私の誕生日で記念イラストで依頼しようと申請します\n今回はバンドリイラストです。\n\nお題\n｢誕生日記念イラスト｣\nキャラ\n今井リサ,湊友希那\n\n髪型は\nリサはポニテ\n友希那はロングの普通\n\n構図\n2人の姿イラスト\n\n差分\n①夏用私服ver.(参考URLにあり)\n②水着ver.\n③裸ver.\n\n台詞有無に分けてくれると嬉しいです\nバンドリの世界で進級して衣装も変わったのでいい機会なのでぜひとも書いてほしく依頼しました。何卒よろしくお願いします😇\nマストでは無いので日付越えちゃっても構いません😉きおさんのペースで描いてくださったら幸いです\n\nhttps://twitter.com/YA