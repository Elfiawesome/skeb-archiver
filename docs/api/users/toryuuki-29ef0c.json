2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7da08b4590331de5cd085b75a3ccb3e 3x", "genre": "art", "nsfw": false, "body": "おんすろーと。を描いていただきたいです。\nデザインはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@toryuuki/works/22", "thumbnail_src": "https://si.imgix.net/f9c068d0/uploads/origins/29bf98fe-5484-41f0-8524-e2e90b3bc160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=248ec79c0934dc1af26406acdd454c62", "thumbnail_srcset": "https://si.imgix.net/f9c068d0/uploads/origins/29bf98fe-5484-41f0-8524-e2e90b3bc160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=248ec79c0934dc1af26406acdd454c62, https://si.imgix.net/f9c068d0/uploads/origins/29bf98fe-5484-41f0-8524-e2e90b3bc160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e69ec0003964a9ab96c23e07f4ec5c5 2x, https://si.imgix.net/f9c068d0/uploads/origins/29bf98fe-5484-41f0-8524-e2e90b3bc160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fd77b2a3050a53f4312c530ca602c67 3x", "genre": "art", "nsfw": true, "body": "はじめまして。リクエスト失礼します。\n\n艦これのジャーヴィスが温泉上がりに浴衣に着替えているところを全身画でお願いします。浴衣の下はパンツのみでお願いします。浴衣及びパンツの色はおまかせします。", "created_at": "", "completed_at": ""}, {"path": "/@toryuuki/works/21", "thumbnail_src": "https://si.imgix.net/541a9222/uploads/origins/510a5009-101f-4e6a-b89d-d2287f62822c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6cf373e5359b1b03b6e1b6a411d0354", "thumbnail_srcset": "https://si.imgix.net/541a9222/uploads/origins/510a5009-101f-4e6a-b89d-d2287f62822c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6cf373e5359b1b03b6e1b6a411d0354, https://si.imgix.net/541a9222/uploads/origins/510a5009-101f-4e6a-b89d-d2287f62822c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a38f10e29ea9760005fd14cbbd7983e7 2x, https://si.imgix.net/541a9222/uploads/origins/510a5009-101f-4e6a-b89d-d2287f62822c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3148618c9b4bc5ae0557ab09cd8128c2 3x", "genre": "art", "nsfw": true, "body": "艦これのFletcher(フレッチャー)に頭を撫でられながら膝枕で授乳手コキしてもらうところをお願いします。\n\nFletcherの表情は困り顔であやしているセリフを入れて欲しいです。\nセリフ例：「よしよし」「いいこいいこ」「しょうがないですねぇ」など\n上記の雰囲気に合っていれば、これ以外でも構いません。\n\n描きにくいところはアレンジしていただいても構いません。\n\n可能であれば、下記の差分を作成してほしいです。\n・射精\n・母乳の噴き出し\n・表情：母乳を吸われ感じている表情\n・表情：満足げな笑顔\n\n上記以外はお任せいたします。\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@toryuuki/works/20", "thumbnail_src": "https://si.imgix.net/8dd01c5a/uploads/origins/daeb636d-60ea-4016-84fe-aeb9b22ae66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4031d55b6a952003006dd8631cee6a6", "thumbnail_srcset": "https://si.imgix.net/8dd01c5a/uploads/origins/daeb636d-60ea-4016-84fe-aeb9b22ae66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4031d55b6a952003006dd8631cee6a6, https://si.imgix.net/8dd01c5a/uploads/origins/daeb636d-60ea-4016-84fe-aeb9b22ae66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb123c5093548c72f8cc8e0d6ae5b936 2x, https://si.imgix.net/8dd01c5a/uploads/origins/daeb636d-60ea-4016-84fe-aeb9b22ae66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5b25fb4db0dfefc24f82c6878b69c85 3x", "genre": "art", "nsfw": false, "body": "今回、リクエストしたいのは艦これの響ちゃんで構成としては\n資料のような感じの看板を持ってにこやかな響ちゃんの表情でお願いします\n看板には勝利という文字でお願いします\nその他のことはおまかせします！ぜひ勝利して嬉しそうな響ちゃんをお願いします！！\n\nhttps://seiga.nicovideo.jp/seiga/im1687772", "created_at": "", "completed_at": ""}, {"path": "/@toryuuki/works/19", "thumbnail_src": "https://si.imgix.net/2ac6b77e/uploads/origins/34aaded3-5d29-4681-a43d-93f316b33c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eb7d33e444db0096fbfe3e5ca8d6b0a", "thumbnail_srcset": "https://si.imgix.net/2ac6b77e/uploads/origins/34aaded3-5d29-4681-a43d-93f316b33c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eb7d33e444db0096fbfe3e5ca8d6b0a, https://si.imgix.net/2ac6b77e/uploads/origins/34aaded3-5d29-4681-a43d-93f316b33c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=151866c8e2475a9c4260b610ad2b0c09 2x, https://si.imgix.net/2ac6b77e/uploads/origins/34aaded3-5d29-4681-a43d-93f316b33c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25350e195d51e344384cec0ae3ab45b 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもツイッターでイラストを拝見しております\n今回リクエストしたいのは、艦これの響ちゃんで、いつもの服装で、行ってらっしゃいと見送ってくれてる感じでお願いします\n優しく微笑んでる感じで手を顔の高さぐらいで手を降ってる感じでお願いします\nその他のことはおまかせしますのでぜひご検討をよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@toryuuki/works/18", "thumbnail_src": "https://si.imgix.net/4352960e/uploads/origins/c328cf78-4427-4d38-9f82-b9c356f6bffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11f5a8c97586211ce5dabf67118b6ef1", "thumbnail_srcset": "https://si.imgix.net/4352960e/uploads/origins/c328cf78-4427-4d38-9f82-b9c356f6bffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11f5a8c97586211ce5dabf67118b6ef1, https://si.imgix.net/4352960e/uploads/origins/c328cf78-4427-4d38-9f82-b9c356f6bffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81ced83eb53f608c3d719ee0fc146f30 2x, https://si.imgix.net/4352960e/uploads/origins/c328cf78-4427-4d38-9f82-b9c356f6bffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae034116e0ee4fe5790085694cc89a07 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@toryuuki/works/17