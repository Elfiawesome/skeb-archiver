a4d2b5e/uploads/origins/0c375548-8fe6-4128-97b5-ec6d1185d6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d6fb8e508f94293b02290783fd72c15 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回の作品がとても気に入ったので、またお願いしたいです!💖\n\nヴェルギリウスと私のOCをまた一緒に描いて欲しいです。今回はバスの中で一緒に座っているシーンをお願いします。ヴェルギリウスは彼の肩に頭を預けて、彼の隣で寝ています。ヴェルギリウスが彼女の髪を愛おしそうに撫でているところを描いてほしい。彼が微笑んでいるところを描いてください！\n\nhttps://drive.google.com/drive/folders/17oxcYug_qVwV9Epq6JDX7GraABEgGUqx?usp=drive_link\n\nありがとうございます💖", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/28", "thumbnail_src": "https://si.imgix.net/244ee8a1/uploads/origins/a972183a-6841-4915-bdb6-48349a3c009d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9450fe1a68acdc856bc28b3d1ef04ea6", "thumbnail_srcset": "https://si.imgix.net/244ee8a1/uploads/origins/a972183a-6841-4915-bdb6-48349a3c009d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9450fe1a68acdc856bc28b3d1ef04ea6, https://si.imgix.net/244ee8a1/uploads/origins/a972183a-6841-4915-bdb6-48349a3c009d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=763ec8e45c56bd3f29950748d3cefff0 2x, https://si.imgix.net/244ee8a1/uploads/origins/a972183a-6841-4915-bdb6-48349a3c009d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92eff579dcad36b0070ec53cec16b476 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/27", "thumbnail_src": "https://si.imgix.net/84826153/uploads/origins/0c972d9c-43ce-4e3b-ba39-8368144feb97?bg=%23fff&auto