-43e3-acb5-e68829059b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=802fd3fc7d9683f97e3cdc89125ddee0 2x, https://si.imgix.net/e77ce008/uploads/origins/f20905af-b819-43e3-acb5-e68829059b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=521ea9720bc4729820e5d57799ede49d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/17", "thumbnail_src": "https://si.imgix.net/4eb6e8f0/uploads/origins/0c2d9fdb-1470-41a1-82e6-d56d529d97e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc3bb7394f2e8978e74f7f777767ad4", "thumbnail_srcset": "https://si.imgix.net/4eb6e8f0/uploads/origins/0c2d9fdb-1470-41a1-82e6-d56d529d97e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc3bb7394f2e8978e74f7f777767ad4, https://si.imgix.net/4eb6e8f0/uploads/origins/0c2d9fdb-1470-41a1-82e6-d56d529d97e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d5b3c776b149c9e60c3a558936a763a 2x, https://si.imgix.net/4eb6e8f0/uploads/origins/0c2d9fdb-1470-41a1-82e6-d56d529d97e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55bffa0890140460f7994355712b1178 3x", "genre": "art", "nsfw": false, "body": "うに太郎くん\nこんにちは、英語を使ってすみません、日本語が下手です、私の説明に問題がなければいいのですが😢。\n私はあなたの絵がとても好きです、特に「リンバス・カンパニー」の絵が大好きです、あなたの絵はとても上手で、あなたの描くキャラクターが本当に大好きです。また、あなたの「リョウシュウ」と「アウティス」の絵を何度も見たので、彼らのイラストをあなたに託したいと思います。\n金額が足りなければ、再送も可能です💖！\n\n以下、イラストの細かい要望です。\n\n- ロボトミーコーポレーション状態のリョウシュウとオーティスが見たい\n つまり、【警備隊長リョウシュウ】（E.G.Oアカツキペナンス）と【訓練隊長アウティス】（マジックバレットシューター）です。\n どの状態かわからない場合は、私のリンク先にサンプル画像があります！\n\n-私の頭の中の雰囲気はこうだった：\n 対決では、ただ言い争いを終わらせるだけ......向き合うだけ......みたいな？\n 涼洲はタバコを咥えたまま、いやらしく微笑み返す。\n\n-どっちが優位に立とうが、私はそれを見るのが好きだ。\n\nまだまだ書き足りないことがあるかもしれないので、私が言っていないことを自由に作ってください。\n私の要望が描きにくかったら、それは無視して、自分で二人のやり取りを描くのもいい選択だと思います᥺❤️❤️！\n\nありがとうございます🥳🥳!!!\n\nhttps://drive.google.com/drive/folders/1V8OThBXK_l1Mzxov15cVQlgdjCJpCxzL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/16", "thumbnail_src": "https://si.imgix.net/4ce11a6b/uploads/origins/d5e93c5b-2910-4662-a785-031f85f5bd6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92076af189e0e434d96eb07f568bc703", "thumbnail_srcset": "https://si.imgix.net/4ce11a6b/uploads/origins/d5e93c5b-2910-4662-a785-031f85f5bd6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92076af189e0e434d96eb07f568bc703, https://si.imgix.net/4ce11a6b/uploads/origins/d5e93c5b-2910-4662-a785-031f85f5bd6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f8f4cd6d0cc4052992392be21c0db68 2x, https://si.imgix.net/4ce11a6b/uploads/origins/d5e93c5b-2910-4662-a785-031f85f5bd6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29de1aef420c61fb27b8dfc9e1f7152b 3x", "genre": "art", "nsfw": false, "body": "雅宗から見た凪夏を描いてほしいです\n日常、遠出、昔…なんでもいい(こまるかな………)のですが印象に残っている一場面が見たいなと思います　明るめ、暗め問いません　よろしくお願いします\n\nふわっとしたリクエストなので思いつかなかったらもう一度考えるのでお戻しください", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/15", "thumbnail_src": "https://si.imgix.net/caeb2ede/uploads/origins/dc2f161a-15e6-40f1-91d2-354408f118bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00a7e6c53d877df6fd0762d80c9e21d6", "thumbnail_srcset": "https://si.imgix.net/caeb2ede/uploads/origins/dc2f161a-15e6-40f1-91d2-354408f118bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00a7e6c53d877df6fd0762d80c9e21d6, https://si.imgix.net/caeb2ede/uploads/origins/dc2f161a-15e6-40f1-91d2-354408f118bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b489243363561739f46366e08e546623 2x, https://si.imgix.net/caeb2ede/uploads/origins/dc2f161a-15e6-40f1-91d2-354408f118bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19de6d5f40d059a04ba1eca586eac013 3x", "genre": "art", "nsfw": false, "body": "うに太郎さん、いつもお世話になってます！\n今回は、自分のアバターキャラの立ち絵を描いて頂きたくリクエストさせて頂きます！\n\n・構図\n全身の見える構図で、片方の腕は口元に持ってきてふわっと笑っている感じだと嬉しいです！\n・使用用途\nXでのアイコン、自身のXにてポストさせていただき、他の方との交流時の資料として使用させて頂きたいと思っています。\n\n＊アバターキャラについて\n・年齢、性別\n(見た目年齢)19歳、女性\n・性格\n基本的にはおっとりとしていて、どこか抜けている。\nでも知識は無駄に豊富で、知識パワーで会話中ではツッコミ役になることが多い。\n・髪型、髪色\n髪型は腰上くらいのロング。左の横側の髪を結っています。\nまた、オオカミ系のケモミミが生えてます。\n髪色は灰色ベースに黒のメッシュが入っています。\n・顔周り\nタレ目でオッドアイ。左がオレンジで右が黄色の目。\n資料画像の様に、瞳孔の代わり？に白い星(キラキラ？)があると嬉しいです！\n左目の下に2つ、右目の下に1つほくろがあります。\nケモミミが生えているのでヒト耳は無いです。\n・服装、アクセサリー\n資料画像では黒のノースリーブインナーにダボ袖の上着を着ているのですが、\n自分がファッション関係に疎く…見えない範囲はおまかせしたく思います…＞＜\nまた、資料ではヘアアクセサリーとして白いお花があるのですが、こちら大きさや形などは自由に変えていただいて大丈夫です！\n\n資料画像\nhttps://twitter.com/qre1d_/status/1789937399063027794\n\nこういったリクエストは初めてなので、何か不備などありましたらすみません！\nよろしくお願いします！！！", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/14", "thumbnail_src": "https://si.imgix.net/a44a3dbb/uploads/origins/85722ac3-bb56-4f60-96f4-75552035236b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b74207e478816ef6e3301cd7e2a0b53", "thumbnail_srcset": "https://si.imgix.net/a44a3dbb/uploads/origins/85722ac3-bb56-4f60-96f4-75552035236b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b74207e478816ef6e3301cd7e2a0b53, https://si.imgix.net/a44a3dbb/uploads/origins/85722ac3-bb56-4f60-96f4-75552035236b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1df2ca7921a9fd32616a0fb2a5541eef 2x, https://si.imgix.net/a44a3dbb/uploads/origins/85722ac3-bb56-4f