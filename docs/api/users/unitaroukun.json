n\nhttps://drive.google.com/drive/folders/17oxcYug_qVwV9Epq6JDX7GraABEgGUqx?usp=drive_link\n\nできれば、ヴェルギリウスがE.G.O.を使っているシーンが欲しいです( https://drive.google.com/file/d/1yTMcFrESS2do9Q2y7V4p9_Meal89smCi/view?usp=drive_link )怪我をして血を流しているマネージャーOCをヴェルギリウスに抱っこしてもらいたい。\n\nありがとうございます💖", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/25", "thumbnail_src": "https://si.imgix.net/f056da44/uploads/origins/20fa0e03-c791-4375-b1ec-6b4b83706ede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f79f7d93a4d647a3cd0addcb2a3de74", "thumbnail_srcset": "https://si.imgix.net/f056da44/uploads/origins/20fa0e03-c791-4375-b1ec-6b4b83706ede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f79f7d93a4d647a3cd0addcb2a3de74, https://si.imgix.net/f056da44/uploads/origins/20fa0e03-c791-4375-b1ec-6b4b83706ede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fcc8edf26febb36eeedd3c5d3345da1 2x, https://si.imgix.net/f056da44/uploads/origins/20fa0e03-c791-4375-b1ec-6b4b83706ede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec1cd52f7502042e86920e512ee6649c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@unitaroukun/works/24", "thumbnail_src": "https://si.imgix.net/30f61818/uploads/origins/221d1737-c0df-4b7d-be32-830a46f8e6d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73f06372a60bbef32481140ed477220f", "thumbnail_srcset": "https://si.imgix.net/30f61818/uploads/origins/221d1737-c0df-4b7d-be32-830a46f8e6d1?bg=%23fff&auto=format%2Ccompre