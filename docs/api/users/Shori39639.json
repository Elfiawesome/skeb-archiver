8-b346-6f71edc23bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f68ab0da1b97b3a74e81bf04a08f09d7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/115", "thumbnail_src": "https://si.imgix.net/bffacc22/uploads/origins/5de50dfe-ee26-48b6-974f-867413c07ff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fc7ffbcdd38013c4813fa9a3dec0a8d", "thumbnail_srcset": "https://si.imgix.net/bffacc22/uploads/origins/5de50dfe-ee26-48b6-974f-867413c07ff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fc7ffbcdd38013c4813fa9a3dec0a8d, https://si.imgix.net/bffacc22/uploads/origins/5de50dfe-ee26-48b6-974f-867413c07ff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0765e14570ef214d82033225ed76cfca 2x, https://si.imgix.net/bffacc22/uploads/origins/5de50dfe-ee26-48b6-974f-867413c07ff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4644e04b42c17f443afd0f7d511c413 3x", "genre": "art", "nsfw": false, "body": "ロビン・フッドの作品、本当にありがとう。\n\n別のFate OCのために別の作品をお願いしたいのですが、今回は中国のバラッドに登場する華武蘭（木蘭）という真名を持つランサー・サーヴァントです。彼女は忠誠心と勇敢さで知られる英雄で、戦争に行くにもかかわらず、ソフトな面も持ち合わせている。見た目はほとんどアンドロイドだが、女性的な側面が強い。黒髪をポニーテールにし、優しい目を持ち、穏やかな笑顔を絶やさない。\n\n翻訳がぎこちないので、彼女のウィキペディアのページもリンクしておこう。\n\nhttps://ja.wikipedia.org/wiki/木蘭\n\n私は彼女に中国風の鎧を着せたい。下に添付したものに似ているが、もっと様式化したものだ。\n\nhttps://imgur.com/a/heSPM2Y\n\nポーズとしては、ポールアームをそっと持っているような、リラックスした、しかしエレガントなものを希望します。そのような武器の画像も添付します。\n\nhttps://imgur.com/a/nIkB18R", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/114", "thumbnail_src": "https://si.imgix.net/b9665dc1/uploads/origins/5c469627-7eea-4851-ba76-61c580e38d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f12d769a1b55907934b0467e2b2fa8", "thumbnail_srcset": "https://si.imgix.net/b9665dc1/uploads/origins/5c469627-7eea-4851-ba76-61c580e38d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f12d769a1b55907934b0467e2b2fa8, https://si.imgix.net/b9665dc1/uploads/origins/5c469627-7eea-4851-ba76-61c580e38d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e6149760fbbe6608aad911ac981dc77 2x, https://si.imgix.net/b9665dc1/uploads/origins/5c469627-7eea-4851-ba76-61c580e38d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b308cd3026790028db0019e2e1bd7d6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ショウリ！あなたがエリシアのためにしてくれた仕事が大好きです。\n\n僕のFateのOCの一人を描いてくれないかなと思っていたんだ。彼女はアーチャークラスのサーヴァントで、Fate Extraに登場するようなロビン・フッドの称号を持っています。彼女は外向的でいたずら好きな無法者で、困っている人を助ける。彼女は親切なトリックスターで、金持ちから盗んで貧しい人々に与える。\n\n弓を持ち、自信に満ちたポーズで立っていてほしい。髪は長くて乱れている。緑色のマントを羽織ってほしい。他の服装については知らないが、彼女を書くきっかけとなったアートを提供した。\n\nhttps://imgur.com/a/robin-oc-inspiration-PU2RQtp", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/113", "thumbnail_src": "https://si.imgix.net/d7a4fb36/uploads/origins/84219e83-b8b0-47a7-b931-c7b540084e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b448adc7d4ab87c55e58b7c343b8034", "thumbnail_srcset": "https://si.imgix.net/d7a4fb36/uploads/origins/84219e83-b8b0-47a7-b931-c7b540084e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b448adc7d4ab87c55e58b7c343b8034, https://si.imgix.net/d7a4fb36/uploads/origins/84219e83-b8b0-47a7-b931-c7b540084e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1678b72c04d662a8d93ddaad84f3f504 2x, https://si.imgix.net/d7a4fb36/uploads/origins/84219e83-b8b0-47a7-b931-c7b540084e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4697b78dfb6c8f924dcf6641b66922a1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの画風が大好きです！fate samurai remnantのヤマトタケルと宮本伊織を描いていただけませんか？場面は現代で、普通の観光客と同じように浅草寺を観光しているところです。姿勢は自由ですし、普段着でも構いません。もうお互いを攻撃する必要はないので、楽しい雰囲気にしてください。\n作品はSNSでファン同士が閲覧するためだけに使用し、あなたが制作者であることを明記します。私の依頼が不適切であれば、遠慮なくキャンセルしてください。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/112", "thumbnail_src": "https://si.imgix.net/2f0dd5be/uploads/origins/2bbf8d43-bc83-4157-b098-b5344f3a35b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e53943b0c11682cb3f60b75461744d6", "thumbnail_srcset": "https://si.imgix.net/2f0dd5be/uploads/origins/2bbf8d43-bc83-4157-b098-b5344f3a35b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e53943b0c11682cb3f60b75461744d6, https://si.imgix.net/2f0dd5be/uploads/origins/2bbf8d43-bc83-4157-b098-b5344f3a35b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62be806f62bf6d813598d99b2c32af7e 2x, https://si.imgix.net/2f0dd5be/uploads/origins/2bbf8d43-bc83-4157-b098-b5344f3a35b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98b9518e4e034fd0cce875ef1b8a8eb0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！2025年、皆様はいかがお過ごしでしょうか？\nもしよろしければ、もう一度ドゥリヨダナ＆アカシアにお願いしたいことがあります！\n\n今回はFGOのオルデコール2章をモチーフにした絵をお願いします！\n\nアカシア＆ドゥリヨダンナは学園パートの背景キャラというイメージです。ドゥリヨダンナは先生で、アカシアは保健室の先生。\n性格は基本的にいつも通り。ドゥリヨダナは仕事中にもかかわらず浮気性で恥知らずだが、アカシアはプロフェッショナルでありたいと思っている！\n\n今回は服装の紹介がないので、それぞれの役に合った服装をお願いします！(アカシアはメガネをかけてもいいかも？）\n\n学校でのシーンなら、その章の登場人物（藤丸の友達グループとか、他の先生とか）を背景としてカメオ出演させるのも面白いかもしれません。\nもちろん、これは一つのアイディアに過ぎず、構成は最終的にあなたに委ねられています！\n\n必要であれば、お値段を上げても構いません。ありがとうございました\n\nhttps://drive.google.com/drive/folders/1CCfOauy-T9Zehhl_Dbzsv2l9LgGEYiCn", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/111", "thumbnail_src": "https://si.imgix.net/2c20cbea/uploads/origins/fd3d315f-886d-443c-bcb2-c011cf279fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a1e9752d6c27c058f5137e616930285", "thumbnail_srcset": "https://si.imgix.net/2c20cbea/uploads/origins/fd3d315f-886d-443c-bcb2-c011cf279fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a1e9752d6c27c058f5137e616930285, https://si.imgix.net/2c20cbea/uploads/origins/fd3d315f-886d-443c-bcb2-c011cf279fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3257f6497e83e2122a6ff469b9d94988 2x, https://si.imgix.net/2c20cbea/uploads/origins/fd3d315f-886d-443c-bcb2-c011cf279fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f401661a898aa9dc5d37399aa9149aef 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nしょ～り@Skeb依頼お気軽にどうぞ。配信用Live2Dモデルの制作承りますさんのFate作品のイラストを見て知り、とても素敵だったので、今回依頼させていただきました。\n描いて頂きたいものですが、私（新人VTuberとして活動してます、名前は神楽雫です。）とFGOのマリー・アントワネット第一再臨の一枚絵をお願いしたいです。二人で一枚絵という形です。バトルシーンを再現してもらえると嬉しいです！\n構図や背景はお任せ致します。納品サイズはサイズは特に決まっていませんが、ツイートするときに見やすいサイズだと嬉しいです。縦、横もお任せ致します。\n私（神楽雫）は資料URLを参考にしてください。\n使用用途ですが、VTuberとして1周年を迎えるときに、記念配信のカウントダウンツイートで、グランド鯖と私のイラストをツイートしたいと思っています。また、記念配信の方でもイラストと一緒に紹介したいと思います。\nぜひ、引き受けていただけたら嬉しいです。\n\nhttps://x.com/kagura_shizuku/status/1775618270659502149?t=Btt4p7tB9AzuoM8CvhRaDw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/110", "thumbnail_src": "https://si.imgix.net/9099f675/uploads/origins/4114a1eb-6805-4669-9ac0-ece971f69ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25c717461c68ee7441851474b5f4927a", "thumbnail_srcset": "https://si.imgix.net/9099f675/uploads/origins/4114a1eb-6805-4669-9ac0-ece971f69ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25c717461c68ee7441851474b5f4927a, https://si.imgix.net/9099f675/uploads/origins/4114a1eb-6805-4669-9ac0-ece971f69ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d34664c3e1333b4e02d5ffd248c58036 2x, https://si.imgix.net/9099f675/uploads/origins/4114a1eb-6805-4669-9ac0-ece971f69ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84eccb681e4ac0b8a0ae4f632dc3cbda 3x", "genre": "art", "nsfw": false, "body": "Shoriさん、こんにちは！前回のリクエスト、本当にありがとうございました！\n\n今回は、ビジュアルノベル「アンリミテッドブレイドワークス」のルートから何年も後のお話で、マスターとサーヴァントのペアをリクエストしたいと思います。マスターは士郎と凛の娘で家出した衛宮弓子。とても可愛らしい女の子で、士郎のオレンジ色の髪（だいぶ長いが）、凛の青い目と体型をしている。どんな状況でも前向きに生きようとする少女で、サーヴァントを溺愛している。\n\nサーヴァントはヤマトタケル。  Fate/Samuraiレムナント』での姿よりも、もっと年上で、でもジェンダーレスな描写を維持するためにアンドロイド的であってほしい。また、前回のヤマトタケルのリクエストにあった鳥のイメージを継承し、『Fate/Samurai Remnant』のファンタズマルドレスを着てほしいです( https://img-eshop.cdn.nintendo.net/i/91f1ac6d0382c1d52cfca215a06e5ec8c06cc8f0ef6e4dcf70a261e0f21beefe.jpg )\n\n今回もありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/109", "thumbnail_src": "https://si.imgix.net/dfbe7ee6/uploads/origins/4b5e6359-e415-4d14-9187-49016e6048d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8406275e87f28317475728b861408f50", "thumbnail_srcset": "https://si.imgix.net/dfbe7ee6/uploads/origins/4b5e6359-e415-4d14-9187-49016e6048d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8406275e87f28317475728b861408f50, https://si.imgix.net/dfbe7ee6/uploads/origins/4b5e6359-e415-4d14-9187-49016e6048d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8537dd68f1e6ac0518229aa7ec63bc36 2x, https://si.imgix.net/dfbe7ee6/uploads/origins/4b5e6359-e415-4d14-9187-49016e6048d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a7bdc901475d075951d45100233f3f9 3x", "genre": "art", "nsfw": false, "body": "Shoriさん、こんにちは！ロホールのリクエスト、ありがとうございました。良いお年をお迎えください！\n\n今回は同じ聖杯戦争からもう一組描いて頂きたいのですが、それは鬼の少女の母親で名前は聖子、サーヴァントはランサークラスのブリトマートです。\n\n聖子は美しい不老不死の仏教女性で、元宮廷女官であり、娘が安心して暮らせる世界を作りたいと願っている。娘と違って鬼の血は引いていない。体型や髪の色は娘に似ているが、外見も動作もずっと優雅な美しさを持っている。デザインはほとんどお任せしますが、インスピレーションを得るために：\n\nhttps://imgur.com/a/refs-b6L65Tt\n\nブリトマートは、聖子が娘と思っている人物で、彼女の美しさを強調する豪華な伝統的なドレスを着ている聖子とは対照的に、現代的な服を着てほしい。できれば、二人の関係を表すようなポーズをとってほしいです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/108", "thumbnail_src": "https://si.imgix.net/1564e9b4/uploads/origins/d6c70c6d-d0a5-4843-9360-9e4ad6daed96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc509e41ab21e96c1599f606f8e952f4", "thumbnail_srcset": "https://si.imgix.net/1564e9b4/uploads/origins/d6c70c6d-d0a5-4843-9360-9e4ad6daed96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc509e41ab21e96c1599f606f8e952f4, https://si.imgix.net/1564e9b4/uploads/origins/d6c70c6d-d0a5-4843-9360-9e4ad6daed96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7630a58a3b933d3ba4dc2e63c15c4707 2x, https://si.imgix.net/1564e9b4/uploads/origins/d6c70c6d-d0a5-4843-9360-9e4ad6daed96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6c1ab79322d74d8476fe1211433e5bf 3x", "genre": "art", "nsfw": false, "body": "Shoriさん、こんにちは！以前はヤマトタケルのリクエスト、本当にありがとうございました。\n\n今回はFateのOCを2人リクエストしたいと思います。一人目は、500年間眠っていた酒呑童子に似た無口な鬼の女の子です。Fate/stay nightのさくらのような体つきでかわいいのですが、添付画像のようなピンクの髪と目をしていて、髪はもっと乱れています：\n\nhttps://www.pixiv.net/en/artworks/88247811\n\nどんな服装でもOKで、額に傷があり、角がネックレスになっている。彼女のコマンドスペルは手にある。\n\n二人目は彼女のサーヴァントで、アーサー王の息子であるロホール・ペンドラゴン。可愛らしく女性的な容姿で、白い髪と緑色の目をしている。アルトリアと同じようなサイドポニーテールの髪型にしたい。銀の鎧と大きな青いマントを持っている。アロンダイトやエクスカリバーのようなデザインの大剣も持たせたい。鎧はアルトリアや下の騎士に似せてほしい。アホージは必要だ。\n\n参考文献\nhttps://imgur.com/5i2A4Hj\nhttps://imgur.com/WkA2rMN", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/107", "thumbnail_src": "https://si.imgix.net/231a152c/uploads/origins/9d1a3d99-4ec9-4f21-9855-8842e8d4d4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=390c3a86983be2b95c1a1f28d3422540", "thumbnail_srcset": "https://si.imgix.net/231a152c/uploads/origins/9d1a3d99-4ec9-4f21-9855-8842e8d4d4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=390c3a86983be2b95c1a1f28d3422540, https://si.imgix.net/231a152c/uploads/origins/9d1a3d99-4ec9-4f21-9855-8842e8d4d4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f5f57ade25948607eb414b059b211fc 2x, https://si.imgix.net/231a152c/uploads/origins/9d1a3d99-4ec9-4f21-9855-8842e8d4d4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c46773335457a394dd471bea0822cc7f 3x", "genre": "art", "nsfw": false, "body": "以前しょ〜りさんにメディアさんを描いていただいた者ですが、またリピートさせていただきました。\n\nリクエスト内容ですが\n描いていただきたいキャラはFGOのメディアリリィとカレンオルテシアで\n\nシチュエーションとしましてはメディアは神話にてエロースの矢を撃たれて恋心を植え付けられたというエピソードがあるのですが、そのシーンのイメージでカレンに矢をさされるメディアリリィと言ったイラストをお願いしたいです。\n\n構図としては参考資料のメディアに刺されるセイバーのオマージュという感じで、矢を手づかみで刺すカレンとそれを呆然と見つめるメディアリリィと言った感じで\n\n服装については二人とも第一再臨のものでお願いします。\n\nその他の細かいシチュエーション、構図、背景などは全てお任せします。\nよろしくお願いします。\n\nhttps://x.com/ki3tyu/status/1849402752302207248?s=46&t=3nSnRdk5XWrNEm1duG3goA", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/106", "thumbnail_src": "https://si.imgix.net/9f160d36/uploads/origins/474430d1-94dc-45dc-ad9b-2c7c6e500881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d5d878adfbb52edb8d0210cb50ddd92", "thumbnail_srcset": "https://si.imgix.net/9f160d36/uploads/origins/474430d1-94dc-45dc-ad9b-2c7c6e500881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d5d878adfbb52edb8d0210cb50ddd92, https://si.imgix.net/9f160d36/uploads/origins/474430d1-94dc-45dc-ad9b-2c7c6e500881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9b144a0f34b44986821f869b7e99679 2x, https://si.imgix.net/9f160d36/uploads/origins/474430d1-94dc-45dc-ad9b-2c7c6e500881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6b22a826022d4cadeaf49d161fcc33a 3x", "genre": "art", "nsfw": false, "body": "また会ったね、ショウリ！お元気でしたか？\n\nもしよろしければ、また素敵な絵をお願いしたいです！\n\nFGO［お宿の活動日誌～閻魔亭繁盛記～］の2019年お正月イベントのワンシーンを描いてください。今回はアカシアとアーユスをお願いします。\n\nイベントでマシュが着ていた宿の制服を着てほしい（ドライブリンクの1つ目のフォルダに参考資料がある）。\n\nアカシアとアーユスはおそらく同じ身長と体格です。\n肌の色はアーユスの方が黒い。\nアカシアの髪の色合いは、前回のリクエストよりもう少し暗くてもいいかもしれません（最初に送っていただいたリクエストの色合いに近いです）。それ以外はいつも通りに描いてください！\n\n詳細はお任せしますが、大前提として、アカシアとアーユスはウェイトレス役です。\n\nドゥリヨダナが何かしらいるとかわいいですね。\nもしかしたら、ゲストとしてサービスされるのかも？\n\nやる気があれば、ドゥリヨダナのNPの兄弟も出てくるかもしれない。\n\nシーンに登場させたい人数によっては、自由に値上げしてください！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/14V8Dqqo8oTuo1OGFIqgBIip1zi6crg9S", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/105", "thumbnail_src": "https://si.imgix.net/67f7307d/uploads/origins/bf02820d-d1a2-44e5-b1fc-68ff8dd4eff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e765339d92a1b127c5d1e98a306c5417", "thumbnail_srcset": "https://si.imgix.net/67f7307d/uploads/origins/bf02820d-d1a2-44e5-b1fc-68ff8dd4eff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e765339d92a1b127c5d1e98a306c5417, https://si.imgix.net/67f7307d/uploads/origins/bf02820d-d1a2-44e5-b1fc-68ff8dd4eff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c63f0e3d285378b6f5766c917e80e88d 2x, https://si.imgix.net/67f7307d/uploads/origins/bf02820d-d1a2-44e5-b1fc-68ff8dd4eff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5861c06c1782b1908753ccb045204f15 3x", "genre": "art", "nsfw": false, "body": "先日は、無間龍など書いていただきありがとうございました。\n今回はオリジナルの聖杯戦争を題材に頼みたいと思いまして、\nアーチャー　ロックマンゼロのゼロ\nランサー　ロックマンゼロのレヴィアタン\nセイバー　メドゥーサ(第3再臨コス)\nアサシン　呪腕ハサン\nライダー　マルタ\nキャスター　アルトリア・キャスター(第2再臨コス)\nバーサーカー　セイバーオルタ\nルーラー　戦国無双の茶々\nの組み合わせでお願いいたします。\nメインはゼロとキャストリアで、背中合わせにそれぞれZセイバーと杖を構えている構図でお願いいたします。\nイメージとしては、映画のポスターのようなかんじです", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/104", "thumbnail_src": "https://si.imgix.net/adeb7036/uploads/origins/ee4d9b99-73b9-406f-b682-4e91f459a482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9af555662b82de6b7ee194bee93d9fe5", "thumbnail_srcset": "https://si.imgix.net/adeb7036/uploads/origins/ee4d9b99-73b9-406f-b682-4e91f459a482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9af555662b82de6b7ee194bee93d9fe5, https://si.imgix.net/adeb7036/uploads/origins/ee4d9b99-73b9-406f-b682-4e91f459a482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6e8d4adc7464c305e03cbb4e62f1b1d 2x, https://si.imgix.net/adeb7036/uploads/origins/ee4d9b99-73b9-406f-b682-4e91f459a482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12e0410781aa5432b032be0933c1e105 3x", "genre": "art", "nsfw": false, "body": "お願いしたいイラストは、『Fate/Samurai Remnant』のヤマトタケル（セイバー）、特に『Fate/Grand Order』の3回目の昇天（https://static.wikia.nocookie.net/fategrandorder/images/1/1b/S402_Stage3.webp/revision/latest?cb=20231231163641 ）をモチーフにしたものです。\n\n大まかなデザインと髪型はアウトラインのイメージのままでよいのですが、この作品のように鳥をイメージしたデザインを希望します。https://cdn.donmai.us/original/8f/bf/__yamato_takeru_and_yamato_takeru_fate_and_2_more_drawn_by_imomushi__8fbfa3de7580e34ed95f0f9708a8af73.jpg\n\nまた、彼の顔には邪悪な表情があり、ここにリンクされているものに似た鎧を着用してほしいのですが、鎧については自由に創造していただいて構いません：\n\nhttps://cdn.donmai.us/original/01/95/__a_knight_and_a_knight_reverse_1999_drawn_by_amykem__0195d4b2a48eaeb842280b9e35ad45f0.png\n\n最後に、細かいことですが、腰にカタナを持ってもらえるとありがたいです。", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/103", "thumbnail_src": "https://si.imgix.net/ce7d02ca/uploads/origins/b9d6f860-9cd9-4178-9768-3ede0bd83666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59515dc82ce6a6732d20d3496979f38", "thumbnail_srcset": "https://si.imgix.net/ce7d02ca/uploads/origins/b9d6f860-9cd9-4178-9768-3ede0bd83666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59515dc82ce6a6732d20d3496979f38, https://si.imgix.net/ce7d02ca/uploads/origins/b9d6f860-9cd9-4178-9768-3ede0bd83666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e973a63e9ed7c9192c2176372d61084 2x, https://si.imgix.net/ce7d02ca/uploads/origins/b9d6f860-9cd9-4178-9768-3ede0bd83666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2499298c8cfa71cb8c2d466663b5775d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、こんにちは。もしよろしければ、依頼をお願いしたいのですが。宇宙イシュタル（2回目の昇天）とぐだお、そして時臣先生です。ポーズとしては、ぐだおが時臣教授にスペースイシュタルとの結婚の許可を求めているところと、スペースイシュタルが背景の地面で恥ずかしさのあまりパニクっているところをお願いしたいです。背景は、家の前や外にしてもらえるとありがたいです。", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/102", "thumbnail_src": "https://si.imgix.net/11c76201/uploads/origins/f0e41933-2c55-4604-a7b5-4c55ddd35783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3bec49db05ae8dfd17d0b585bc4699b", "thumbnail_srcset": "https://si.imgix.net/11c76201/uploads/origins/f0e41933-2c55-4604-a7b5-4c55ddd35783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3bec49db05ae8dfd17d0b585bc4699b, https://si.imgix.net/11c76201/uploads/origins/f0e41933-2c55-4604-a7b5-4c55ddd35783?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7719c3f5e8880c211bc9b4ccde5e2f9f 2x, https://si.imgix.net/11c76201/uploads/origins/f0e41933-2c55-4604-a7b5-4c55ddd35783?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27ab5d46fb4d3652bafd4e48eaf3bc55 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アカシアとドゥルヨーダナをまた描いていただけませんか？\n\nこの依頼が複雑だったら、もっと高い金額でアピールしてください。よろしくお願いします！\n\n今回は結婚式のイラストです。\"最高のエンディングのCG！\"みたいな感じになると思います。\n\nシーンはお任せですが、ピンクの蓮の花が何らかの形で実装されると嬉しいです！\n\nキャラクター参考：https://imgur.com/a/RO30Sd0\n\n前回の二人の描き方は完璧でした！今回はドゥルヨーダナの顔色をもう少し日焼けさせてもいいと思いますが、それはあなた次第です。\n\nインドの伝統的な服装（ドゥルヨーダナの文化）で描いてください。https://imgur.com/a/Ak1iNUN\n\nターバンと頭飾りは省いてください。\nまた、髪型は前回と同じでお願いします。\n\n服装の部分的な芸術的自由はありますが、メインの色は極端に変えないでほしいです。\n小さな複雑な模様は、あなたの判断で簡略化してもかまいません。\nジュエリーはすべてお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/101", "thumbnail_src": "https://si.imgix.net/0d7c00d9/uploads/origins/9766299a-a36a-40d2-bcde-7ea92c585a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45e43d24392d0a3725d9a06ee1d3a3dc", "thumbnail_srcset": "https://si.imgix.net/0d7c00d9/uploads/origins/9766299a-a36a-40d2-bcde-7ea92c585a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45e43d24392d0a3725d9a06ee1d3a3dc, https://si.imgix.net/0d7c00d9/uploads/origins/9766299a-a36a-40d2-bcde-7ea92c585a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=120d7bf5136fc1374dbe4c4b05ad78b6 2x, https://si.imgix.net/0d7c00d9/uploads/origins/9766299a-a36a-40d2-bcde-7ea92c585a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f95be006f34aef16b3792db2d2c21b3 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとても美しい\n私のOC、イデアとFGOの酒呑童子のアートをお願いしたいです。特にキャスターの酒呑童子、別名 護法少女・鬼救阿。\nFGOのイベント神秘の国のONILANDを舞台にして描いてほしいです！～鬼の王とカムイの黄金\n\n二人の関係はこうだ：酒呑童子はとてもチャラくて、イデアをよくからかう。エディアはそれが恥ずかしく、修天堂司の本気度がわからず戸惑っている。基本的には、リツカに対する接し方と同じだ。\nしかし、ONILANDでは、2人ともただ楽しもうとしている！お互いに恋愛感情を持っているので、遊園地デートともいえる！\n他には特に何も考えていないので、好きなようにやってください！\n\nイデアの服装は、参考文献にあるものなら何でもOKです。(イデアが悪魔の角のヘアバンドをしていたらかわいいと思いますが、そうでなくてもかまいません)。\n\nキャラクターリファレンスはこちらです：[https://imgur.com/a/80Lfrmc]\nそして、ONILAND![https://imgur.com/a/Sw9cdUs]", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/100", "thumbnail_src": "https://si.imgix.net/e44300af/uploads/origins/040ee8a2-c1a7-4b8a-ab85-72465ef613fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed91285aed84354b6e6c153346bc0085", "thumbnail_srcset": "https://si.imgix.net/e44300af/uploads/origins/040ee8a2-c1a7-4b8a-ab85-72465ef613fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed91285aed84354b6e6c153346bc0085, https://si.imgix.net/e44300af/uploads/origins/040ee8a2-c1a7-4b8a-ab85-72465ef613fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3176658bd959dabe6c4bb882f465be47 2x, https://si.imgix.net/e44300af/uploads/origins/040ee8a2-c1a7-4b8a-ab85-72465ef613fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3e8540675664e62180fe0682e9dce89 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエストを送らせていただきます。グダオとグダ子が夏服で一緒に写っているアートをお願いしたいです。夕日に照らされたヤシの木の下で、ぐだおがぐだ子を抱きしめてキスをしています。お忙しいところありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/99", "thumbnail_src": "https://si.imgix.net/dc4e95cf/uploads/origins/dc54e8da-10d3-445b-8f53-abdaa6489edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20afd5456f5f6b4443f061b008828828", "thumbnail_srcset": "https://si.imgix.net/dc4e95cf/uploads/origins/dc54e8da-10d3-445b-8f53-abdaa6489edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20afd5456f5f6b4443f061b008828828, https://si.imgix.net/dc4e95cf/uploads/origins/dc54e8da-10d3-445b-8f53-abdaa6489edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b13eb9f2d63ae17a4c3d1c2a9bb83105 2x, https://si.imgix.net/dc4e95cf/uploads/origins/dc54e8da-10d3-445b-8f53-abdaa6489edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35be5c039446bab8e66e1a977e45eac3 3x", "genre": "art", "nsfw": false, "body": "ひびき＆千鍵、浅上藤乃アーネンエルベ\n\nアーネンベの準備をする響と近木と藤野（テーブルを片付け、新しいお客さんのためにカフェの準備をする。\n\nhttps://ibb.co/HxGg35V", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/98", "thumbnail_src": "https://si.imgix.net/62238dd7/uploads/origins/955b7d73-c287-4411-b52d-db4c31d70166?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8303d5278141816d6e13078cffa23627", "thumbnail_srcset": "https://si.imgix.net/62238dd7/uploads/origins/955b7d73-c287-4411-b52d-db4c31d70166?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8303d5278141816d6e13078cffa23627, https://si.imgix.net/62238dd7/uploads/origins/955b7d73-c287-4411-b52d-db4c31d70166?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c87c9527990b8ad987564d4d4ee94453 2x, https://si.imgix.net/62238dd7/uploads/origins/955b7d73-c287-4411-b52d-db4c31d70166?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c47516337f77ecfa853b2a55a76352e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が本当に大好きです！私のOCのアカシアとFate/Grand Orderのドゥルヨーダナの絵をお願いしたいです。\n\nもしNGの場合は、遠慮なくキャンセルするか、適切な金額で再送してください！\n\n参考：https://drive.google.com/drive/folders/1CmW8ZAi3RdXf0kbQPBxUhRHcaF1cdR0i?usp=sharing\n\nシーン二人はお茶とお菓子を一緒に食べている。\nアカシアには、ドゥルヨーダナの顔についたパンくずやアイシングを拭いてほしい。\n登場人物の身長や体格の違いに注意してください！表情や細かい設定はお任せします。BGや場所も自由です。\n\nアカシア\n- 20代半ば\n- 物静かで控えめな性格。\n- 161cm。細身。バストサイズは小～中。\n- 服装はマシュウの画像を参考にしてください。ジュエリー、アクセサリー、シャツの色は自由に変更できます。\n\nドゥルヨーダナ\n- 30代後半\n- 190cm。大柄で筋肉質。肌の色はアカシアより日焼けしている。\n- 眉と髭は紫ではなく黒。\n- FGOの昇天1で描いてほしい。", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/97", "thumbnail_src": "https://si.imgix.net/45e8031e/uploads/origins/d908000b-6b6a-4e2b-90ea-6f8e3738ac49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42bd251a42062cd5205c6720db82844", "thumbnail_srcset": "https://si.imgix.net/45e8031e/uploads/origins/d908000b-6b6a-4e2b-90ea-6f8e3738ac49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42bd251a42062cd5205c6720db82844, https://si.imgix.net/45e8031e/uploads/origins/d908000b-6b6a-4e2b-90ea-6f8e3738ac49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7565942eb6b9b97ed1107886ad45e442 2x, https://si.imgix.net/45e8031e/uploads/origins/d908000b-6b6a-4e2b-90ea-6f8e3738ac49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39093571d5a00b29d831c86db1204ffa 3x", "genre": "art", "nsfw": false, "body": "私のキャラクター「ティターニア」を希望する。https://toyhou.se/27232338.titania\n\n とFate/Grand Orderのオベロン・ヴォーティガン: https://static.wikia.nocookie.net/fategrandorder/images/6/6e/S316_Stage3.webp/revision/latest?cb=20220925055838\nhttps://static.wikia.nocookie.net/fategrandorder/images/4/40/S316_Stage4.webp/revision/latest/scale-to-width-down/250?cb=20220925055829\n\nをカップルで描いてほしいです。ロマンチックな関係にある二人なので、とてもラブラブな表現にしたいと思います。左手にはお揃いのゴールドの結婚指輪をしています。ポーズや背景は、このカップルにふさわしいと思うものであなたの創造力次第です。ありがとうございました。\n\nhttps://toyhou.se/27232338.titania", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/96", "thumbnail_src": "https://si.imgix.net/5c0d7eb2/uploads/origins/fb5cea34-3f78-467c-bd36-9607927c6909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a79f3edd29e856b5499c07e430c330ea", "thumbnail_srcset": "https://si.imgix.net/5c0d7eb2/uploads/origins/fb5cea34-3f78-467c-bd36-9607927c6909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a79f3edd29e856b5499c07e430c330ea, https://si.imgix.net/5c0d7eb2/uploads/origins/fb5cea34-3f78-467c-bd36-9607927c6909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31dfa3def2224975df17b1ac2d0b4e9b 2x, https://si.imgix.net/5c0d7eb2/uploads/origins/fb5cea34-3f78-467c-bd36-9607927c6909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23da9ef86e370b5860e44dd08b32cba6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！この画像（https://i.imgur.com/8WJG1Jy.png）のような、衛宮士郎とアルトリア・ペンドラゴン（セイバー）が水中でキスしているロマンチックな作品をお願いしたいです。セイバーはFate/Hollow Ataraxiaの水着(https://i.imgur.com/S5mxqha.jpeg)を着ていて、士郎が抱きつきながらキスをしています。セイバーの背中とお尻が見えるようにしてほしい。ありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/95", "thumbnail_src": "https://si.imgix.net/4ff0c3ed/uploads/origins/6d06a58c-3898-4208-851c-61f3b7d2b82c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91afa9d9ea142468ae0eaeea2e339a3e", "thumbnail_srcset": "https://si.imgix.net/4ff0c3ed/uploads/origins/6d06a58c-3898-4208-851c-61f3b7d2b82c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91afa9d9ea142468ae0eaeea2e339a3e, https://si.imgix.net/4ff0c3ed/uploads/origins/6d06a58c-3898-4208-851c-61f3b7d2b82c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1893c0638375c922c91ca7198eafaa5 2x, https://si.imgix.net/4ff0c3ed/uploads/origins/6d06a58c-3898-4208-851c-61f3b7d2b82c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46c867c3b60781a0eb1f61cc19183b86 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵が大好きです。Fate/Grand Orderのセイバー村正とバーサーカーアルトリア・アヴァロンの恋愛イラストをお願いしたいです。\n\n村正(https://i.imgur.com/jSfbvch.png)は初昇天時で、白いマントと赤いアームガードは無し。アルトリア・アヴァロン(https://i.imgur.com/2jFJFhy.png)は水着の第三の昇天で、白いリボンも白い袖もなく、青い水着だけ。二人は夏の浜辺で、手をつないでキスをしている。", "created_at": "", "completed_at": ""}, {"path": "/@Shori39639/works/94", "thumbnail_src": "https://si.imgix.net/158e98eb/uploads/origins/d695199c-37c5-42aa-ada6-bfef18168c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dacaddf1f68c4f7fce4ff8c3916e2d", "thumbnail_srcset": "https://si.imgix.net/158e98eb/uploads/origins/d695199c-37c5-42aa-ada6-bfef18168c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dacaddf1f68c4f7fce4ff8c3916e2d, https://si.imgix.net/158e98eb/uploads/origins/d695199c-37c5-42aa-ada6-bfef18168c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e79a3736d2bab1a2dbd633d657c084c 2x, https://si.imgix.net/158e98eb/uploads/origins/d695199c-37c5-42aa-ada6-bfef18168c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f149365e6f6febc9d8d40b27cb0c296b 3x", "genre": "art", "nsfw": false, "body": "しょ〜り様\n初めまして、個人Vtuber活動をしております\n志綺れいじ と申します。\nしょ〜り様のイラストを拝見しまして、\nしょ〜り様にイラストを作成していただきたくリクエストを送らせていただきました。\n\n以下にリクエスト内容をまとめましたのでご検討のほどよろしくお願い致します。\n【参考資料】\nhttps://x.com/reiji_shiki4/status/1691053965067382784?s=46&t=eU5fAeegLCfO2I4h_Jn6ZQ\n\nX:@REIJI_ SHIKI\n\n【使用用途】 \nSNSの活動におけるプロモーション、アイコン等、YouTubeでのサムネイル、OP、EDで使わせていただきたいです。\n【構図・設定】\n⚪︎構図\n片手で敵に銃を突きつけるイメージ\n・イメージ図   \n切嗣\nモト様ポスト参照\nhttps://x.com/otemoto02/status/1709924657460298102?s=46&t=eU5fAeegLCfO2I4h_Jn6ZQ\n\n【服装】\n参考資料の私の服装でお願い致します。\n\n【希望・補足】\nタバコはNGでお願い致します。\n\n背景、追加の装飾などはお任せします。\nまた、サムネイルに使用させていただきたいと思っていますので、左右が見切れていない形で描いていただけると嬉しいです。\n\n【希望納品形式について】 \nPSDデータでお願いしたいです。 \n背景、人物のレイヤー分け、透過版をご準備いただけたら嬉しいです。\n ここまでお目通しいただきありがとうございました。\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/reiji_shiki4/status/1691053965067382784?s=46&t=eU5fAeegLCfO2I4h_Jn6ZQ", "created_at": "", "completed_at": ""}]}