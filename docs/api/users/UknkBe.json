{"amount": 20000, "recorded_at": "2026-03-18T21:28:46.282861+00:00"}]}, "current_prices": {"art": 9000, "comic": 20000}, "price_range": {"art": {"min": 4000, "max": 9000}, "comic": {"min": 8000, "max": 20000}}, "links": [{"label": "Twitter", "url": "https://x.com/UknkBe", "name": "UknkBe"}, {"label": "Misskey_io", "url": "https://misskey.io/@fuzimino", "name": "fuzimino"}, {"label": "Website", "url": "https://lit.link/fuziminoko", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/63606828", "name": "63606828"}, {"label": "BOOTH", "url": "https://fuzimi.booth.pm", "name": "fuzimi"}, {"label": "Fanbox", "url": "https://fuzimino.fanbox.cc", "name": "fuzimino"}], "flags": {"from_archive": true}, "acceptable": false, "works": [{"path": "/@UknkBe/works/282", "thumbnail_src": "https://si.imgix.net/7e586d5a/uploads/origins/3f0a056f-9114-4957-8002-36ed7588e397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202c0512de5e5d2e88921148d2ecff24", "thumbnail_srcset": "https://si.imgix.net/7e586d5a/uploads/origins/3f0a056f-9114-4957-8002-36ed7588e397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202c0512de5e5d2e88921148d2ecff24, https://si.imgix.net/7e586d5a/uploads/origins/3f0a056f-9114-4957-8002-36ed7588e397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e648d7268c455d0ac813af8cdd4065c2 2x, https://si.imgix.net/7e586d5a/uploads/origins/3f0a056f-9114-4957-8002-36ed7588e397?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c715d579121b5a9f90c76e3f53af1a33 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n不二見さんの作品の、静かで透明な孤独の表現にいつも心を掴まれています。\n\nこの度、自己理解を深めるために、セリフつきイラストをご依頼させていただきました。\n\n私は @yns_0707 というXアカウントで撮影会モデルとして活動しております。\n写真の中で「恋している私」「失恋している私」「強がっている私」など、自分の感情をヒロインとして役づけながら、揺れながら生きている今を残しています。\n\n実は現実では精神科に通院しており、息のしづらさや、自分の価値への葛藤を抱えながら日々を過ごしています。\nですが、表現の中では救われる瞬間があります。\n\n不二見さんの描かれる透明な孤独の中で、表現者としての私と、生身の私との間で揺れている姿を描いていただけましたら幸いです。\n見た目はXの私の容姿を参考に投影していただきたいです。\n\n周囲の人には精神的な状態のことは言っていないのですが、\nできれば、誰かに見抜かれてしまうような、それでも壊れないぎりぎりの強さを含んだ空気感があれば嬉しいです。\n\n作品は @yns_0707 のXに投稿させていただきたく存じます。\nそのため、直接的な死の表現は控えていただけますと幸いです。\n\nSkebでの依頼が初めてのため、不手際がございましたら申し訳ございません。\nどうぞよろしくお願いいたします。\n\nhttps://x.com/yns_0707?s=21&t=_WfKvWJzHvOQD-kcGrC6Ww", "created_at": "", "completed_at": ""}, {"path": "/@UknkBe/works/281", "thumbnail_src": "https://si.imgix.net/26d89cc1/uploads/origins/40156092-06bc-40a5-a156-8b502696a070?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c815f4568b3df4bdaaad02bbab301b73", "thumbnail_srcset": "https://si.imgix.net/26d89cc1/uploads/origins/40156092-06bc-40a5-a156-8b502696a070?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c815f4568b3df4bdaaad02bbab301b73, https://si.imgix.net/26d89cc1/uploads/origins/40156092-06bc-40a5-a156-8b502696a070?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fad244f3772c6b92a0f914f6ad5dcc1 2x, https://si.imgix.net/26d89cc1/uploads/origins/40156092-06bc-40a5-a156-8b502696a070?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e22a37b3efec1c394ba3094f198998d9 3x", "genre": "comic", "nsfw": false, "body": "不二見様初めまして。絵柄や温度感がたいへん素晴らしく好みの雰囲気でいつも楽しくアカウントを拝見させていただいております。コミックskebをしているということで是非OCを描いて頂けないかと思い、リクエストをお願い致しました。 \n\nお頼みしたいのは以下のキャラクターでのコミックイラストです。クトゥルフ神話TRPGの「オルタナティブダブル」というシナリオで遊んだOCです。何卒よろしくお願い致します。\n\n  【資料】 https://drive.google.com/drive/folders/1Q5OGHtBqIZWfCmlRakDdLHQcoWK5tgw-?usp=drive_link  \n\n【内容】 構図等はお任せいたします。お好きなように書いていただいて構いません！ \n\n【使用用途】 SNSにアップロードしたり、SNS上のアイコンとして利用したり、グッズを作成する可能性があります。  金額の調整が必要であれば再送しても構いません。また、気が向かなければお気軽にキャンセルしてください。ご検討いただけますと幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@UknkBe/works/280", "thumbnail_src": "https://si.imgix.net/aacbfd4e/uploads/origins/d413ce86-e861-45b0-8fe6-5b1978cf23b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2C