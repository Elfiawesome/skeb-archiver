4a2-4f0d-8f81-6f79f12cc12e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af915e0c2efa9ab7fda5ecec6113aee5 2x, https://si.imgix.net/d426d5cf/uploads/origins/0b0247ab-b4a2-4f0d-8f81-6f79f12cc12e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=007c5370c5d331fcb6fe97772a09ea0e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/37", "thumbnail_src": "https://si.imgix.net/2c570369/uploads/origins/a199f5cc-c6f7-41cd-8f0d-d0df561dc008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a869c6285511dda8e53a000d52b864bd", "thumbnail_srcset": "https://si.imgix.net/2c570369/uploads/origins/a199f5cc-c6f7-41cd-8f0d-d0df561dc008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a869c6285511dda8e53a000d52b864bd, https://si.imgix.net/2c570369/uploads/origins/a199f5cc-c6f7-41cd-8f0d-d0df561dc008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3406eabde085cd83ea3f86fb1376861 2x, https://si.imgix.net/2c570369/uploads/origins/a199f5cc-c6f7-41cd-8f0d-d0df561dc008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c823e6140338415126a2a5d2942c18b1 3x", "genre": "art", "nsfw": false, "body": "ご依頼失礼します。\n以前のWaveBox並びSkebでは良いものをありがとうございました。\n黒髪ロングに太めのタレ眉というのが衣装側に調和していますし腰やお尻の辺りまである長い髪の女の子というのも趣向的に刺さりました。\n\nとても気に入りましたが故、良ければまた衣装側に関連する感じで依頼させていただきたいのですが\nよろしいでしょうか？\n\n以前のかたつむりな子と同じような感じの指定となるのですが、参考資料のような感じの衣装を着た女の子をあなたの絵柄でお願いしたいです。\n敢えてそちらのセンスにお任せしたいので、指定の衣装の大まかな形状と女の子であるという部分以外は変わらずお任せなのですが、一からデザインする以外にも\n\nhttps://x.com/samekomuSOUSAKU/status/1965064552560930884?s=19\n↑の黒髪ロングのこの子自体を描いたりこの子を元にデザインやアレンジを加えていくというのも非常に良いのでそういった形も歓迎します。\n\n衣装等はアレンジから付け足しや要素のオミットまで歓迎ですが、必ずキャラの手や足先までが衣装の袖や裾に包まれて見えないように描いて下さい。\n\n手先から足先まで完全に覆い隠すようなお化けや幽霊っぽさもある衣装ではありますが、ステレオタイプの幽霊のように脚や下半身部分が先細りだったり消えているようには描かず、\nあくまで床まで引きずるような長い裾で隠れていて足が見えないという感じでお願いしたいです。\n\nまた、可能であれば 裾に隠れたままの足の部分まで見えるように全身を描いて頂きたいです。\n\n構図やポーズ等はそちらにお任せします。\n送付した衣装の資料は前回と同じ物です。\n\n参考資料↓\nhttps://imgur.com/a/BoRro2t", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/36", "thumbnail_src": "https://si.imgix.net/ee7991a5/uploads/origins/9c2cd9f2-79c4-43ec-b78d-10b57117ce00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98bb898035ad1a9e6397e4ef6059afe3", "thumbnail_srcset": "https://si.imgix.net/ee7991a5/uploads/origins/9c2cd9f2-79c4-43ec-b78d-10b57117ce00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98bb898035ad1a9e6397e4ef6059afe3, https://si.imgix.net/ee7991a5/uploads/origins/9c2cd9f2-79c4-43ec-b78d-10b57117ce00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e04641148b737712c0fe05bb3edd3219 2x, https://si.imgix.net/ee7991a5/uploads/origins/9c2cd9f2-79c4-43ec-b78d-10b57117ce00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1001d9731eb94e8f461d0760566c0ebf 3x", "genre": "art", "nsfw": true, "body": "Greeting, Mr. Oka. It's me, again.\nThis request is very simple. It's just to draw a full-length portrait of my profile picture. If you have a proper composition, it's not necessary to show all parts of the body.\nThe original avatar image has already been placed in the Google Docs link for reference.\nThe character is approximately 1.7 meters tall. You can make appropriate corrections according to your feelings.\nFor actions and expressions, there is no specific the actions or expressions. Just make sure they look natural.\nIn terms of clothing... Perhaps you could have her wear a knight's armor or act like a magician? Since we're already here, I think it's nice to have a bit of a fantasy touch. If you think it's not appropriate, just pretend I didn't say anything.\nFull color is not necessary, but I hope to retain the color of my hair. Since I like it very much.\nThat's all, I think. Thank you!\n\nhttps://drive.google.com/file/d/15mEYZ4D3_fHO0MukZlHe_-qdeYuDSHP4/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/35", "thumbnail_src": "https://si.imgix.net/1fdca34b/uploads/origins/a83b62e8-de54-45b4-892a-ca6ea9762aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2eeba0519c3f2abec7ca2b9012f5ef", "thumbnail_srcset": "https://si.imgix.net/1fdca34b/uploads/origins/a83b62e8-de54-45b4-892a-ca6ea9762aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2eeba0519c3f2abec7ca2b9012f5ef, https://si.imgix.net/1fdca34b/uploads/origins/a83b62e8-de54-45b4-892a-ca6ea9762aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d864b83d7e0f45e26f12bf8cecf4c4d 2x, https://si.imgix.net/1fdca34b/uploads/origins/a83b62e8-de54-45b4-892a-ca6ea9762aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f205c86af9edf3735717c08624f65823 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ツイッターであなたのアートを見つけて、そのアートスタイルと、エルフのような耳を持ったキャラクターの絵がとても気に入ったの。\n\n僕のキャラクターを描いてほしいんだ。彼女の名前はマリッサで、SF TRPGのキャンペーン用に作ったキャラクターです。彼女は別の惑星から来たハーピーで、人間に拾われて修道女として育てられた。念動力があり、手を使う代わりに自分の周りに物を浮かせる。\n\nhttps://drive.google.com/drive/folders/1JkpplrFbhg_DdFl43Vyf5oBD1ApgUzXa\n\n好きなように、好きな格好で描いてください。\n\n好みの画風については、あなたのドット絵のように描いてください。下のリンクの写真のように：\n\nhttps://x.com/oka_okakanoka/status/1924385971690512421\nhttps://x.com/oka_okakanoka/status/1925524320815915248\n\nhttps://drive.google.com/drive/folders/1JkpplrFbhg_DdFl43Vyf5oBD1ApgUzXa", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/34", "thumbnail_src": "https://si.imgix.net/e9264148/uploads/origins/4f09551b-1013-47e5-b368-a837a169c404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77361395f2565fbb1de420da1e71940b", "thumbnail_srcset": "https://si.imgix.net/e9264148/uploads/origins/4f09551b-1013-47e5-b368-a837a169c404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77361395f2565fbb1de420da1e71940b, https://si.imgix.net/e9264148/uploads/origins/4f09551b-1013-47e5-b368-a837a169c404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=900e4066be59fbd4127445774fbcc046 2x, https://si.imgix.net/e9264148/uploads/origins/4f09551b-1013-47e5-b368-a837a169c404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb843069e51b9826a90adc853642b69a 3x", "genre": "art", "nsfw": false, "body": "岡(Oka)さんこんにちは。いつも拝見しております。\n初リクエストで恐縮ですが、自分のアバターの子のイラストをお願いいたします。\n\nビジュアルの詳細は資料URLにてご確認頂ければと思います。\n低身長巨乳とスパッツが特徴で、制服風のワンピースをベースに、西洋占星術（ホロスコープ）をモチーフとした意匠を持っています。\nオカルト＋スチームパンクというイメージで作成しています。\nデザインについては細かい箇所があるため省略いただいて構いません。\n岡(Oka)さんの作家性にお任せしたいので構図についても指定はありません。\n何より、自分と友人で一緒にデザインしたこの子を楽しんで描いて頂ければ嬉しいです。\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1gwyLQyDW4bm52sUKLxCb8_Smrz6MdRia/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/33", "thumbnail_src": "https://si.imgix.net/724b38a4/uploads/origins/21dcdcd4-b0c9-483b-be4d-56efafc186e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b372c50df94c93959bb9e2b1fd13dbb", "thumbnail_srcset": "https://si.imgix.net/724b38a4/uploads/origins/21dcdcd4-b0c9-483b-be4d-56efafc186e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b372c50df94c93959bb9e2b1fd13dbb, https://si.imgix.net/724b38a4/uploads/origins/21dcdcd4-b0c9-483b-be4d-56efafc186e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49f0d2e82011e5228b6b0575003a6af5 2x, https://si.imgix.net/724b38a4/uploads/origins/21dcdcd4-b0c9-483b-be4d-56efafc186e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d6f5fce8b1fdcaa9fe4c2ba5c49deb3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きです！もしよろしければ、私のキャラクターのイラストをお願いしたいのですが！Twitterであなたの投稿を見て、とても気に入りました：\nhttps://x.com/oka_okakanoka/status/1925524320815915248\n\n同じようなものをリクエストすることは可能でしょうか？もしそうでなければ、あなたの好きなスタイルで私のキャラクターを描いてください！\n\n私のキャラクターはフクロウのお姫様で、荒涼とした島にある魔法のお城に住んでいます。島は紫色の花でいっぱいです。普段はとても疲れていて、不器用で、内気で、本を読むのが大好き。時々、ろうそくを持ってお城の中を探検します。\n\nリファレンスにある服や髪型、あるいは彼女に似合う他の何かで、自由に彼女を描いてください。彼女は気分によって服や髪に違う花をつけます。左目の下に三日月型のほくろがあり、耳の先が黒くなっていることに注意してください。   \n\n細かい構図はお任せしたい！\n\n参考文献：https://drive.google.com/drive/folders/130MfDL6jZGHQOvL1rkPKFcevmnQu-KpR?usp=sharing\n\n使用用途はSNS用になります！透過バージョンも追加していただけるとありがたいです！\n\nご考慮いただきありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/32", "thumbnail_src": "https://si.imgix.net/66a40c63/uploads/origins/663b142f-d7c9-4a81-b1c6-98d2e86e8e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebe7f7a0464932ef04e952b57b26b47b", "thumbnail_srcset": "https://si.imgix.net/66a40c63/uploads/origins/663b142f-d7c9-4a81-b1c6-98d2e86e8e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebe7f7a0464932ef04e952b57b26b47b, https://si.imgix.net/66a40c63/uploads/origins/663b142f-d7c9-4a81-b1c6-98d2e86e8e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8493aa2995b8cf72fcd83c5f6751949d 2x, https://si.imgix.net/66a40c63/uploads/origins/663b142f-d7c9-4a81-b1c6-98d2e86e8e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=382976fe773cc50ca7b162996caf04cb 3x", "genre": "art", "nsfw": false, "body": "ご依頼失礼します。\n下記資料のかたつむりな感じの衣装を着た女の子を描いてみて頂けますか？\n指定は着せる衣装のみですので、中の女の子のデザインや触角や殻などの色といった細部はそちらにお任せします。\nあまりデザインに余計な縛りを付けずそちらのセンスや好みにお任せしたいのでこう言いますが、ムチムチだとかお胸の辺りがふくよかだったりするのは個人的に歓迎です(強制はしません)\n\n衣装についてはアレンジや要素の付け足し等も歓迎ですのでお好きなようにやって頂ければ幸いですが、\n手は先端まで完全に覆われ、足も長い裾で完全に隠れるローブや着ぐるみっぽい服ですので、手先や足先まで露出させないようにお願いします。\n\n衣装の手先部分のデザインに関してなのですが 先細りの先端が完全に閉じた形状と、ローブのようにたるみのある感じを両立した感じに描いて貰いたいです。\n衣装自体の資料とは別で下記に作例をご用意しましたので、可能であればこちらを参考に描いてみて頂きたいです。\n\nまた、頭の触覚の部分の解釈も自由ですので、そのまま触覚付きのカチューシャのように描いても、カチューシャ部分を省いて頭から直接触覚が生えてる感じに解釈してもどちらでもよろしいものとします。\n\n構図やポーズ等はそちらにお任せします。\n\n参考資料(衣装本体資料)↓\nhttps://imgur.com/a/qmGUT0v\n\n参考資料↓(衣装の手先部分資料)\nhttps://imgur.com/a/pgwjiMN", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/31", "thumbnail_src": "https://si.imgix.net/4acfc329/uploads/origins/f90b1d86-ac11-43ae-ad99-87e592ff9d97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1313360cf306c7fdaea9f5f5fb9c0dc", "thumbnail_srcset": "https://si.imgix.net/4acfc329/uploads/origins/f90b1d86-ac11-43ae-ad99-87e592ff9d97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1313360cf306c7fdaea9f5f5fb9c0dc, https://si.imgix.net/4acfc329/uploads/origins/f90b1d86-ac11-43ae-ad99-87e592ff9d97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66d2008c84fdc2f1ec4d915109e12d57 2x, https://si.imgix.net/4acfc329/uploads/origins/f90b1d86-ac11-43ae-ad99-87e592ff9d97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=345c4ccbfcac0d31e692e265c734c175 3x", "genre": "art", "nsfw": false, "body": "Hi, I was hoping if you can draw a vtuber, Mono Monet in bikini armour/ビキニアーマー illustrated in her birthday merch (link below)\nhttps://imgchest.com/p/ljyqxpj6d42\n\n\n\nThanks for considering my request!", "created_at": "", "completed_at": ""}, {"path": "/@oka_okakanoka/works/30", "thumbnail_src": "https://si.imgix.net/8d99cd12/uploads/origins/9df6a320-80e0-4f06-ab99-1a6482d9d64a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fec03d1f6b309eea93a397414da540cb", "thumbnail_srcset": "https://si.imgix.net/8d99cd12/uploads/origins/9df6a320-80e0-4f06-ab99-1a6482d9d64a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fec03d1f6b309eea93a397414da540cb, https://si.imgix.net/8d99cd12/uploads/origins/9df6a320-80e0-4f06-ab99-1a6482d9d64a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f42f7ec064b670369168d6