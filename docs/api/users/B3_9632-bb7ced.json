ーのカウンターブローで即死するシチュで、首がへし折れる威力の顔面カウンターか内臓破裂級のボディのどちらかを食らったことで絶命、死体を晒しているシーンをお願いします。\n\n以上可能であればよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@B3_9632/works/4", "thumbnail_src": "https://si.imgix.net/c51dbdbc/uploads/origins/c8ca482e-0e48-4f2e-95db-0ab49c2ddd2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0353830b9bc6d07d522c466b7ad072a", "thumbnail_srcset": "https://si.imgix.net/c51dbdbc/uploads/origins/c8ca482e-0e48-4f2e-95db-0ab49c2ddd2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0353830b9bc6d07d522c466b7ad072a, https://si.imgix.net/c51dbdbc/uploads/origins/c8ca482e-0e48-4f2e-95db-0ab49c2ddd2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1324e1dc84d2634589fd56d6d413e7a 2x, https://si.imgix.net/c51dbdbc/uploads/origins/c8ca482e-0e48-4f2e-95db-0ab49c2ddd2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4123a3603aef90f62e6dec9816cab0b3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}