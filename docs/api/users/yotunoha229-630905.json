b-4ab0e93f3a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b5c96629b116d57cc079e4eb9ddc616, https://si.imgix.net/fb1d89cd/uploads/origins/367d33d6-e2e6-4a53-a24b-4ab0e93f3a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b112fce091c05fbf2e4397629a9afcff 2x, https://si.imgix.net/fb1d89cd/uploads/origins/367d33d6-e2e6-4a53-a24b-4ab0e93f3a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5acc2beb0d3743ee2378d172f1340786 3x", "genre": "art", "nsfw": true, "body": "初めまして。既に出されているイラスト群に惹かれてご依頼致しました。\n\n緋月彩さんという個人Vtuberのパイズリイラストをお願いしたいです。\nご本人Twitter https://x.com/Aya813941?t=PAYqW3ZuZiatPP2z-Sc7JQ&s=09\n立ち絵が載っているツイート\nhttps://x.com/Aya813941/status/1628353208149225472?t=aIXUZ67wk80BOZ5MRMxsYw&s=19\n（三面図はお持ちでは無いようです）\n\n構図 \n対面する一人称視点でのパイズリ\n内容\n谷間に挿した状態での2、3回ほどの連続乳内射精\n\n服装はなるべくであれば着衣をお願いしたいです。\nお手間であれば裸でも問題ありません。\n\n表情等は申し訳ありませんがお任せします\n\nまたご本人様も何度かパイズリイラストを描いていますのでそちらも参考になりましたら幸いです。 https://skeb.jp/@Aya813941\n\nhttps://skeb.jp/@Aya813941", "created_at": "", "completed_at": ""}, {"path": "/@yotunoha229/works/21", "thumbnail_src": "https://si.imgix.net/e9cb848b/uploads/origins/2b878b76-1d66-40ab-bc25-a3eda502e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581bc6510c1bf9cdf8746a20e2054413", "thumbnail_srcset": "https://si.imgix.net/e9cb848b/uploads/origins/2b878b76-1d66-40ab-bc25-a3eda502e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581bc6510c1bf9cdf8746a20e2054413, https://si.imgix.net/e9cb848b/uploads/origins/2b878b76-1d66-40ab-bc25-a3eda502e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31425a290127262c29c510fa676ecc89 2x, https://si.imgix.net/e9cb848b/uploads/origins/2b878b76-1d66-40ab-bc25-a3eda502e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ad4d22f0d4422d359f5bdf47f50a338 3x", "genre": "art", "nsfw": true, "body": "最強陰陽師の異世界転生記というアニメのイーファちゃんのエッチ絵をお願いしたいです。\n\n・男性主観視点の構図で、こちらを見つめながらフェラ\n・亀頭全体を口の中に含んでじゅぽじゅぽしている\n\nよろしくお願いします。\n\n参考\nhttps://yoriko.info/ref/yifa/159\n作品紹介ページ\nhttps://saikyo-onmyouji.asmik-ace.co.jp/", "created_at": "", "completed_at": ""}, {"path": "/@yotunoha229/works/20", "thumbnail_src": "https://si.imgix.net/3f3ffae4/uploads/origins/ad0bd0f9-a1a2-4ccf-b1d9-3378ddce2e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=accbbf6fa9c05dd5eebb0b1e50e35993", "thumbnail_srcset": "https://si.imgix.net/3f3ffae4/uploads/origins/ad0bd0f9-a1a2-4ccf-b1d9-3378ddce2e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=accbbf6fa9c05dd5eebb0b1e50e35993, https://si.imgix.net/3f3ffae4/uploads/origins/ad0bd0f9-a1a2-4ccf-b1d9-3378ddce2e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11537034094730047ca91122674c96d9 2x, https://si.imgix.net/3f3ffae4/uploads/origins/ad0bd0f9-a1a2-4ccf-b1d9-3378ddce2e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b54c703b08db7cb2b61d6fdd22b8d8c5 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n犬山あおいさんの作品が大好きでリクエストさせていただきます\n参考URL＋衣装参照\nあおいちゃんが黒人の巨根にパイズリ＋フェラをしているnsfwなイラストをお願いします。\nチンコは胸から先っぽが出るくらいの大きさ。  そのチンコを咥えたり舐めたりして、大量のフェラチオを受ける。\n射精前と射精後の違いを教えてください。\n彼女がムラムラしていることを示すために、幸せそうな表情とハートの目をしていること。\nその他はお好みにお任せします。\n乳房を広げて、その間に大量のザーメンがあるような違いもあれば最高です。  任意\n背景は何でも結構です。\nよろしくお願いします。\n\nhttps://catbox.moe/c/yeimhx", "created_at": "", "completed_at": ""}, {"path": "/@yotunoha229/works/19", "thumbnail_src": "https://si.imgix.net/7ffd1036/uploads/origins/fefbc542-1b1d-4183-82cd-92dada4b51bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0c73fbcc46b2d0373547488c702b75b", "thumbnail_srcset": "https://si.imgix.net/7ffd1036/uploads/origins/fefbc542-1b1d-4183-82cd-92dada4b51bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0c73fbcc46b2d0373547488c702b75b, https://si.imgix.net/7ffd1036/uploads/origins/fefbc542-1b1d-4183-82cd-92dada4b51bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89fab6d4caa3682706c7239c2655b5bd 2x, https://si.imgix.net/7ffd1036/uploads/origins/fefbc542-1b1d-4183-82cd-92dada4b51bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=891c276ade5e8e3a564ae990f2e3fd45 3x", "genre": "art", "nsfw": true, "body": "はじめまして。イラストが最高だったのでリクエストさせてください。\n\n以下の設定のセリフ付イラストをお願いします。\n学園アイドルマスターの花海佑芽が、枕営業でスポンサーに気に入られて身請けされた。\n\nそれから３年後・・・\n花海佑芽が、スポンサーの子を3人妊娠出産済みで、４人目を妊娠してボテ腹になり、\n黒くなった巨乳輪（さらに爆乳化）から母乳を出しながら、乳首丸見えのビキニを着て\n正面を向いて騎乗位で中出しされているイラスト。\n\n花海佑芽はスポンサーの子を3人妊娠出産済みで、４人目を妊娠していること、\n子は１０人以上作る予定なこと、ボテ腹AV女優としてデビューすること等を\nファン等に報告している。", "created_at": "", "completed_at": ""}, {"path": "/@yotunoha229/works/18", "thumbnail_src": "https://si.imgix.net/6b9b4104/uploads/origins/f01cb104-85a9-4e07-875a-a332da6ef704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=234f27de08bdc47d8f463447e85fe333", "thumbnail_srcset": "https://si.imgix.net/6b9b4104/uploads/origins/f01cb104-85a9-4e07-875a-a332da6ef704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=234f27de08bdc47d8f463447e85fe333, https://si.imgix.net/6b9b4104/uploads/origins/f01cb104-85a9-4e07-875a-a332da6ef704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a7db8edcdd56be0d25b9190d207a871 2x, https://si.imgix.net/6b9b4104/uploads/origins/f01cb104-85a9-4e07-875a-a332da6ef704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51bb9efbffc59a0f041e119369ffb210 3x", "genre": "art", "nsfw": false, "body": "",