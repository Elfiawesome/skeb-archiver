4da3-bbde-58cd607fca1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fb84ecfb7b57dccb40860656b4f1e8, https://si.imgix.net/bc8fa76d/uploads/origins/882691bf-91c3-4da3-bbde-58cd607fca1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4102f7555039aa8ed3359e5cc921ca9e 2x, https://si.imgix.net/bc8fa76d/uploads/origins/882691bf-91c3-4da3-bbde-58cd607fca1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=094729faef541b045742b8c246303fcf 3x", "genre": "art", "nsfw": false, "body": "どもう、はじめまして。ミカと申します。\n先生のイラストを拝見しております。先生のケモノイラストはもふもふてかわいいです。\nぜひオリジナルキャラクターのリクエストを送りたいと思います！\n➤URLはこちら：\nhttps://drive.google.com/folderview?id=1a1eD4Pg0ALGMZ0xPz9vaF73dwI3aXeOZ\n\n獣人化にも描いてお願いしたいです。悪魔の特徴（尻尾）を取り入れていただいても良いですが、普通に猫っぽい獣人描いても大丈夫です。\n服装は自由にどぞ。もしよければ服装もお好きにデザインしてください。また、もし可能でしたら肉球たっぷりだとうれしいです。\nいいアイデアがあれば、遠慮なく使ってください。\n\n➤用途は個人的な閲覧、SNSのアイコンなどです。\nもし衣装のデザインをいただきな場合、多分これからもtorise先生のデザインを創作に使用し、イラストを描いたり、イラストの依頼したりです。作者名も明記します。\nすべては私個人の創作に使用するもので、商業的な使用は一切いたしません。\n先生が許可してくれると幸せです。\nまた、先生のデザインをベースにして、創作の過程で少し調整することについてご了承いただけますと大変幸いです。\n\nご検討の程よろしくお願い致します。\n不適切と感じた場合は遠慮なくキャンセルをお願いします、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@torinikusale/works/31", "thumbnail_src": "https://si.imgix.net/5f7c3d75/uploads/origins/bcecce2f-5749-468e-9fd3-38987805a98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83f8b339ba57a2d1b49ddce38b99b2cb", "thumbnail_srcset": "https://si.imgix.net/5f7c3d75/uploads/origins/bcecce2f-5749-468e-9fd3-38987805a98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83f8b339ba57a2d1b49ddce38b99b2cb, https://si.imgix.net/5f7c3d75/uploads/origins/bcecce2f-5749-468e-9fd3-38987805a98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c