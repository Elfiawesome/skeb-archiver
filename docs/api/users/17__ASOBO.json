=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50504f9d018dd94758389636905f7aa5", "thumbnail_srcset": "https://si.imgix.net/b7aec402/uploads/origins/f6e85465-0f72-4dee-a7ed-3ff573443352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50504f9d018dd94758389636905f7aa5, https://si.imgix.net/b7aec402/uploads/origins/f6e85465-0f72-4dee-a7ed-3ff573443352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59446606d5cf2dcb58ca4b24c9fa60fe 2x, https://si.imgix.net/b7aec402/uploads/origins/f6e85465-0f72-4dee-a7ed-3ff573443352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3a13ed04002353c10d52a982a8d9f5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@17__ASOBO/works/1", "thumbnail_src": "https://si.imgix.net/cb893e58/uploads/origins/6a2e2360-1bf4-4a43-b4b7-d40ec878b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6b16811b8f7e2906738df6444cf7cc", "thumbnail_srcset": "https://si.imgix.net/cb893e58/uploads/origins/6a2e2360-1bf4-4a43-b4b7-d40ec878b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6b16811b8f7e2906738df6444cf7cc, https://si.imgix.net/cb893e58/uploads/origins/6a2e2360-1bf4-4a43-b4b7-d40ec878b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82ad27e373dfd27372a329dbf26e2414 2x, https://si.imgix.net/cb893e58/uploads/origins/6a2e2360-1bf4-4a43-b4b7-d40ec878b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c3f111a22d3a73b2a3fc36d70852fdf 3x", "genre": "art", "nsfw": false, "body": "一七様、はじめまして。\n一七様の描くしなやかで力強い画面に惹かれ、有償リクエストを今か今かと待っておりました。\nよろしければ自宅の創作キャラクターを是非お願いしたく思います…！\n\n以下キャラクターの設定となりますので、参考にしていただけましたら幸いです！\n一画面に二人を希望しておりますが、金額に見合わなければどちらか一人を描いていただけましたらと思います。\n\n・寺内万治（男性/30）\n浄土真の寺の副住職。高校教諭を兼ねる。\n除霊を生業とする一派の出自だが、霊視の調子が悪いため現在除霊業は休業中。\n\n良く言えばおおらかで優しく、悪く言えば無責任で楽観的な性格。\n物腰は非常に柔らかく、怒ることは滅多にない。怒っても怖くない。\n\n10代初めから20代半ばまでは芸能活動をしていたが、共演女優と不倫、妊娠、中絶のコンボを決めて\n責任を取る形で引退。これをきっかけに霊視の調子が悪くなった。\n\nまた、教師になる際に参加したオリエンテーションで事故があり、自身のクローンが生成されている。\nそのクローンは一連の事故の中で自害し怨霊と成り果てており、これに憑りつかれているが当人は気にしていない。事情も知らない。\n\n・怨の人\n\n寺内万治のクローンが自害し、怨霊と成り果てたもの。\n人間が自らの過ちに気が付くためには呪いが必要だ、との考えを持ち\n気づき・反省を促すために人を呪う。\n\n怨霊らしく融通が利かず極端かつ、人の話を聞かない。\n正しい者に優しく、正しくない者を決して許さない。\nただし、正しさとは何かと問われても返答することができない。\n現在は寺内万治に憑りついている。\n\nhttps://drive.google.com/drive/folders/1nYX0kl5nBvKHsjn3qzpL2NvUtLEOHwMq?usp=sharing", "created_at": "", "completed_at": ""}]}