分前後でシームレスにループできるものが望ましいです。\n\n詳細として、オリジナルキャラクターのデザインとイラストを以下に添付します：https://drive.google.com/drive/folders/1GYl9t6_QPAfgtq4eIzIMUJ5wYAc2LRYS?usp=drive以前制作いただいた楽曲が大変気に入っております。適切であれば、作風のリファレンスとしてご自由にお使いください：\nhttps://skeb.jp/@damahysk/works/1818本当にありがとうございます！！https://drive.google.com/drive/folders/1GYl9t6_QPAfgtq4eIzIMUJ5wYAc2LRYS?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@damahysk/works/1848", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1609970513002266624%2F2XL8fQl4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8f2a3df81d84e9e0fdbc7dff9b61e94", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1609970513002266624%2F2XL8fQl4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8f2a3df81d84e9e0fdbc7dff9b61e94, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1609970513002266624%2F2XL8fQl4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a924cb2d2fdab811b7fc3326b0f43eb0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1609970513002266624%2F2XL8fQl4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=373033ceedf29243751c608c92bea846 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@damahysk/works/1847", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1609970513002266624%2F2XL8fQl4.jpg?bg=%23fff&auto=format%2Cc