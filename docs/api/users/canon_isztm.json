2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc70989898e5ae2be5077950cd434d04", "thumbnail_srcset": "https://si.imgix.net/59c88bac/uploads/origins/3f2cd0de-f939-4ae8-afc1-0e62090bc86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc70989898e5ae2be5077950cd434d04, https://si.imgix.net/59c88bac/uploads/origins/3f2cd0de-f939-4ae8-afc1-0e62090bc86e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60a9d8c1909c13dd503315336f182581 2x, https://si.imgix.net/59c88bac/uploads/origins/3f2cd0de-f939-4ae8-afc1-0e62090bc86e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6af117aeedb1851f84f095d177f18a44 3x", "genre": "art", "nsfw": true, "body": "石包カノンさん初めまして、jack-ravenと申します。\n今回はイラストのご依頼をしたい為ご連絡致しました。\n概要は下記になります。\n\n・当方のオリジナルキャラクター「本多栗（ホンダリツ）」のイラスト。\n・キャラクターの容姿は添付画像をご参考下さい。上記キャラクターをゲーム上で再現した物です。\n・服装はアリス・ギア・アイギスよりコンパニオン/AF。\n・構図は添付画像の様にいわゆるエロ蹲踞をした本多栗が欲情した表情で手で作った輪っかを口元に寄せ性的に挑発し、秘部を濡らしている感じでお願いします。イメージした画像を添付しますのでご参考下さい。\n・背景は単色等で構いません\n・可能な場合メガネなし差分と秘部が濡れていない差分をそれぞれご制作お願いします。\n・解像度及びサイズはお任せします。\n\n以上が概要となります。ご一考の程よろしくお願いします。\n長文失礼致しました。\n\nhttps://drive.google.com/drive/folders/1x5irATNUd_a0r4YveU0si98F33vFkbAh?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/8", "thumbnail_src": "https://si.imgix.net/a8b53f9d/uploads/origins/4908742e-c78e-44c4-933f-6779173868b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffb4249db4b35d62e17a49bcc60e29e0", "thumbnail_srcset": "https://si.imgix.net/a8b53f9d/uploads/origins/4908742e-c78e-44c4-933f-6779173868b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffb4249db4b35d62e17a49bcc60e29e0, https://si.imgix.net/a8b53f9d/uploads/origins/4908742e-c78e-44c4-933f-6779173868b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78c168d77147e23e434c8332ce9e9bb0 2x, https://si.imgix.net/a8b53f9d/uploads/origins/4908742e-c78e-44c4-933f-6779173868b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bafe40bbd0c55cc0cc36b699197c4fac 3x", "genre": "art", "nsfw": true, "body": "こんにちは、また依頼したいと思います\n\n今回はデスクトップアーミーボディの兼志谷シタラをお願いします\n関節構造は実物のデスクトップアーミーと同じで大丈夫です\n服装は私服でポーズはお任せします\n下着姿差分も欲しいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/7", "thumbnail_src": "https://si.imgix.net/3d86bed8/uploads/origins/bfbb9786-1578-4f34-b81a-162b1e4c8d96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de71ce91db4a92fc27df2a3558f1614", "thumbnail_srcset": "https://si.imgix.net/3d86bed8/uploads/origins/bfbb9786-1578-4f34-b81a-162b1e4c8d96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de71ce91db4a92fc27df2a3558f1614, https://si.imgix.net/3d86bed8/uploads/origins/bfbb9786-1578-4f34-b81a-162b1e4c8d96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9ed46db16b575182a25d7cfc81c870e 2x, https://si.imgix.net/3d86bed8/uploads/origins/bfbb9786-1578-4f34-b81a-162b1e4c8d96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf06d7a0ce7f89ba93294fe11248f9d1 3x", "genre": "art", "nsfw": true, "body": "いつも神姫絵ありがとうございます\nまた依頼します\nキャラ\nストラーフ、神姫関節あり\n\n服装\n上はワイシャツ、下はパンツ、肌色素体\n\nシチュ\n膝枕で男の顔がお腹側に向いているのでストラーフが恥ずかしがっている\n\n細かいところはお任せします\nあとノーパン差分も欲しいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/6", "thumbnail_src": "https://si.imgix.net/6824d918/uploads/origins/e52ebd2c-bf86-48f0-ae90-a634230ecb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81a86a683bd0020951d6eafac755ae8b", "thumbnail_srcset": "https://si.imgix.net/6824d918/uploads/origins/e52ebd2c-bf86-48f0-ae90-a634230ecb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81a86a683bd0020951d6eafac755ae8b, https://si.imgix.net/6824d918/uploads/origins/e52ebd2c-bf86-48f0-ae90-a634230ecb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=642e95b1ad22106c6b371539febbc9d5 2x, https://si.imgix.net/6824d918/uploads/origins/e52ebd2c-bf86-48f0-ae90-a634230ecb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bb2b20d1519cb75e2bae42d7108d7ff 3x", "genre": "art", "nsfw": true, "body": "日焼けテンペスタちゃんが中出しされている所をお願いします\n神姫関節あり\n脱いだ水着が近くにある\n断面図あり\nあとは自由でお願いします\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/5", "thumbnail_src": "https://si.imgix.net/31605acd/uploads/origins/3a55cb50-8110-4565-b196-4281d119cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc0fa396717d45b9886a9dc727847cc", "thumbnail_srcset": "https://si.imgix.net/31605acd/uploads/origins/3a55cb50-8110-4565-b196-4281d119cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc0fa396717d45b9886a9dc727847cc, https://si.imgix.net/31605acd/uploads/origins/3a55cb50-8110-4565-b196-4281d119cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3718aca1e2fdf58589168f28f098af35 2x, https://si.imgix.net/31605acd/uploads/origins/3a55cb50-8110-4565-b196-4281d119cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5896040d5b7d4b2800deb9596fa8f9ab 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ブレイブウィッチーズの進藤美恵をモチーフにした作品をお願いします。\n白い制服の上着を半開きにし、片手を振って喜んでいる姿（魔法・獣の耳付き、膝上、水色無地）を希望します。\n本当にありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/4", "thumbnail_src": "https://si.imgix.net/9986562b/uploads/origins/f62e16a9-3ce9-4815-a5c4-bd7823d83c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c44376d6769779cc05f3d4daedb70c0", "thumbnail_srcset": "https://si.imgix.net/9986562b/uploads/origins/f62e16a9-3ce9-4815-a5c4-bd7823d83c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c44376d6769779cc05f3d4daedb70c0, https://si.imgix.net/9986562b/uploads/origins/f62e16a9-3ce9-4815-a5c4-bd7823d83c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9eb06891c91df40af9ebad735976a0d6 2x, https://si.imgix.net/9986562b/uploads/origins/f62e16a9-3ce9-4815-a5c4-bd7823d83c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01bf5ef582433dc483b4bf4d592240cd 3x", "genre": "art", "nsfw": true, "body": "武装神姫の飛鳥を私服姿を描いて欲しいです\n着せる服はカノンさんにお任せします\nボディは神姫関節あり肌色素体でお願いします\n下着姿の差分も欲しいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/3", "thumbnail_src": "https://si.imgix.net/b20aabbe/uploads/origins/58f0a00e-e93c-4543-a51d-7989223a001f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b842fd3b15ef40fd2201d83c84a6a0", "thumbnail_srcset": "https://si.imgix.net/b20aabbe/uploads/origins/58f0a00e-e93c-4543-a51d-7989223a001f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b842fd3b15ef40fd2201d83c84a6a0, https://si.imgix.net/b20aabbe/uploads/origins/58f0a00e-e93c-4543-a51d-7989223a001f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc70f3a476a30c9afa91167ec667d66f 2x, https://si.imgix.net/b20aabbe/uploads/origins/58f0a00e-e93c-4543-a51d-7989223a001f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4085e375f31acd4227aa5d38749b3126 3x", "genre": "art", "nsfw": false, "body": "はじめまして。突然のリクエスト失礼いたします。\nアリス・ギア・アイギスより赤の広場制服を着た吾妻楓をお願いします。\n可能であれば、スクエアメガネ/赤を着用させていただければ幸いです。\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/2", "thumbnail_src": "https://si.imgix.net/091f64bb/uploads/origins/b3e76f63-b092-4003-b85e-dd557d232b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0a33438593fb5a05f05c7e887b7cd7", "thumbnail_srcset": "https://si.imgix.net/091f64bb/uploads/origins/b3e76f63-b092-4003-b85e-dd557d232b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0a33438593fb5a05f05c7e887b7cd7, https://si.imgix.net/091f64bb/uploads/origins/b3e76f63-b092-4003-b85e-dd557d232b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fef3f5b4fd6a39651ca546fa571eab9c 2x, https://si.imgix.net/091f64bb/uploads/origins/b3e76f63-b092-4003-b85e-dd557d232b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49c93a76637dc4bcace61d2d461906e7 3x", "genre": "art", "nsfw": false, "body": "できれば、仰向けで膝を立てて触れ合いながら、足の下部を広げて足、この場合はストライカーユニットが地面に触れているような形にしたい。そして、恥ずかしそうに横を向いて視線をそらし、両手を重ねて腹ばいになっているライフルを持っている。以上、よろしくお願いします。もし説明が必要でしたら、お気軽にご連絡ください。\n\nhttps://www.pixiv.net/en/artworks/98166579", "created_at": "", "completed_at": ""}, {"path": "/@canon_isztm/works/1", "thumbnail_src": "https://si.imgix.net/7065bc77/uploads/origins/4908d363-df6d-4277-bb1c-05592d9e0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=733e5263bb54a767b8afbe52dbac0266", "thumbnail_srcset": "https://si.imgix.net/7065bc77/uploads/origins/4908d363-df6d-4277-bb1c-05592d9e0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=733e5263bb54a767b8afbe52dbac0266, https://si.imgix.net/7065bc77/uploads/origins/4908d363-df6d-4277-bb1c-05592d9e0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5ec13957c5063d9b42da0db55119403 2x, https://si.imgix.net/7065bc77/uploads/origins/4908d363-df6d-4277-bb1c-05592d9e0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=101136ace304a4cc0a5ac8e025b54661 3x", "genre": "art", "nsfw": false, "body": "こんにちは。四つ葉と文香の水着姿を描いてください。その他は自由に決めてください。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}]}