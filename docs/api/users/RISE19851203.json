f3-0ccbd32a49dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a15e0aedda71df3979c5fecae78d0249 2x, https://si.imgix.net/6cac8e60/uploads/origins/58df5cf3-ae92-4697-97f3-0ccbd32a49dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79eeeb17c4ee37a957c77f6dc656ccc3 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nTwitterさんで拝見をさせていただいたイラストがとってもステキだったのでぜひうちの子も！\nと思いリクエストさせていただきました♪\n\nリクエストの内容としましては、魔法少女姿のうちの子が右手に蒼炎を纏いながら力を込めて、悪役に直接攻撃を仕掛けているシーンのイラストをお願いします♪\n\nうちの子の特徴としては\n\n・真っ赤なお目々\n・水色の髪の毛\n・ポニテ\n・全身の蒼炎(頭、羽根、尻尾、鬼火)\n・八重歯\n・左眼の紅く光る魔眼\n\nがあります♪\n\n蒼炎の形状は資料①のURLをご参考ください♪\n\n資料① ↓\nhttps://twitter.com/shizyoumishio/status/1708102573616754985\n\n魔法少女姿の特徴としては\n\n・ポニテを結んでいる、フリルの付いた黒くて大きなリボン\n・ノースリーブで角形の付け襟の付いた、セーラー服風の上着\n・上着の裾や肩口の青いライン\n・手袋の中から二の腕までを覆うアームカバー\n・スカートの上側の金色の装飾\n・スカートの下側の白いライン\n・スカートの後ろ側に付いている、スカートと同じ色の大きなリボン\n・スカートの両サイドに浮いている、ひし形のアーマー\n・星型の装飾が付いた左脚のレッグリング\n・左脚だけルーズになっているニーソ\n\nがあります♪\n\n魔法少女姿の衣装は資料②〜④のURLをご参考ください♪\n\n資料② ↓\nhttps://twitter.com/shizyoumishio/status/1708116688171094361\n\n資料③ ↓\nhttps://twitter.com/shizyoumishio/status/1707741614016500063\n\n資料④↓\nhttps://x.com/shizyoumishio/status/1722986507479171121\n\n描写範囲は太ももがチラリと見えるくらいから可能であれば全身\n\n可能であれば構図は資料⑤の表紙の様に、右手を振りかぶって飛びかかっている構図でお願いします♪\n\n資料⑤↓\nhttps://x.com/shizyoumishio/status/1972485687258812701\n\nではではよろしくお願いします♪(˶˃ᴗ˂˶)", "created_at": "", "completed_at": ""}, {"path": "/@RISE19851203/works/479", "thumbnail_src": "https://si.imgix.net/9ce1206d/uploads/origins/f94dbb06-469b-4e8c-8035-0aa2afeb1e98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4acae622cafbde2e3a160ae1614928eb", "thumbnail_srcset": "https://si.imgix.net/9ce1206d/uploads/origins/f94dbb06-469b-4e8c-8035-0aa2afeb1e98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4acae622cafbde2e3a160ae1614928eb, https://si.imgix.net/9ce1206d/uploads/origins/f94dbb06-469b-4e8c-8035-0aa2afeb1e98?bg=%23fff&auto=format%2Ccompress&fm=web