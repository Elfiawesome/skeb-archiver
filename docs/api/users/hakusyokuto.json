ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c753d8b84b5e3306d80b287ca10420a", "thumbnail_srcset": "https://si.imgix.net/20b4f327/uploads/origins/5aaae87e-ad86-4dfe-8712-8d9aff19aa29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c753d8b84b5e3306d80b287ca10420a, https://si.imgix.net/20b4f327/uploads/origins/5aaae87e-ad86-4dfe-8712-8d9aff19aa29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7813571f990631148496d0661dd82bb 2x, https://si.imgix.net/20b4f327/uploads/origins/5aaae87e-ad86-4dfe-8712-8d9aff19aa29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9eb00427ba19cc4792a701e5bb47f0fe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hakusyokuto/works/129", "thumbnail_src": "https://si.imgix.net/092dbd85/uploads/origins/371f1e22-9ff3-44d4-8f24-2f6a189db7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e13e1ebcd859b7a34a98e5da832ecd54", "thumbnail_srcset": "https://si.imgix.net/092dbd85/uploads/origins/371f1e22-9ff3-44d4-8f24-2f6a189db7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e13e1ebcd859b7a34a98e5da832ecd54, https://si.imgix.net/092dbd85/uploads/origins/371f1e22-9ff3-44d4-8f24-2f6a189db7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33e785e2b0ca705d16548f3569ebf370 2x, https://si.imgix.net/092dbd85/uploads/origins/371f1e22-9ff3-44d4-8f24-2f6a189db7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5c02a80d641f861fde1261836aea1d 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ハク、\n\n可能であれば、またあなたに依頼したいと思っていました。今回のフォックスカーリットは大胆なアジアン衣装で、ちょっと露出度が高いので、もし抵抗があればサイズを小さくしてください。この作品に関しては、お祭りが行われているような場所で、背景で花火が上がっているようなイメージで考えています。ポーズや表情は、お祭りのようなものでも、セクシーなものでも何でもいいと思います。\n\nお忙しい中、ご考慮いただき、本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1z3lkgQk4q5pk9OYabGPnmd2NDHZpEyfJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hakusyokuto/works/128", "thumbnail_src": "https://si.imgix.net/4b2e6d2c/uploads/origins/e0145328-ce69-492c-8b5b-503586cd98d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc3da0645998ed1e6867b5d25e6b8ad", "thumbnail_srcset": "https://si.imgix.net/4b2e6d2c/uploads/origins/e0145328-ce69-492c-8b5b-503586cd98d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc3da0645998ed1e6867b5d25e6b8ad, https://si.imgix.net/4b2e6d2c/uploads/origins/e0145328-ce69-492c-8b5b-503586cd98d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=445dc2f4583a27fe11da6a11b08350d4 2x, https://si.imgix.net/4b2e6d2c/uploads/origins/e0145328-ce69-492c-8b5b-503586cd98d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5f94fc6f5c437a327813f6d5b30f471 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n白色灯先生の絵柄と肌や局部の質感にとても惹かれたためリクエスト送らせていただきます。\n\n■キャラクター名／作品名\nクリス・ベルナル／ポップアップストーリー(ポプスト)\n\nエルフの女の子になります。\n\n■容姿\n・パイパン、全裸(額のアクセサリと両耳のイヤリングのみ装着)\n・おっぱいはもっちりとした爆乳サイズ、乳首は鮮やかなピンク色で山なりにぷっくりとした乳輪大きめのパフィーニップル。\n\n■シチュエーション\n・笑顔でいちゃラブ騎乗位エッチを楽しんでいる。\n・竿役視点で、結合部がよく見えている構図。\n・絵の隅に断面図。\n・修正表現は海苔でお願いします。\n\n▼差分\n・大量中出しして、気持ち良さにうっとりと恍惚に浸っている表情。\n\n以上となります、ご検討よろしくお願いいたします。\n\nhttps://www.dropbox.com/s/4yx655in8zh4pqa/chris.png\n\nhttps://wikiwiki.jp/popupstory/%E7%94%9F%E5%BE%92%E3%83%97%E3%83%AD%E3%83%95%E3%82%A3%E3%83%BC%E3%83%AB/%E3%82%AF%E3%83%AA%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@hakusyokuto/works/127", "thumbnail_src": "https://si.imgix.net/afa5f567/uploads/origins/3c51a296-7d22-419b-a0b3-45904563a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e545ce8ff0ecf5ee90e1825a7ae232", "thumbnail_srcset": "https://si.imgix.net/afa5f567/uploads/origins/3c51a296-7d22-419b-a0b3-45904563a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e545ce8ff0ecf5ee90e1825a7ae232, https://si.imgix.net/afa5f567/uploads/origins/3c51a296-7d22-419b-a0b3-45904563a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16880e6e5379c9ff8a5ea9a70c7a8c8e 2x, https://si.imgix.net/afa5f567/uploads/origins/3c51a296-7d22-419b-a0b3-45904563a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c2dd0fb53ba36a3f086d7d0e72d840d 3x", "genre": "art", "nsfw": true, "body": "ハクによろしく、\n\n前回に引き続き素晴らしい作品をありがとうございました。スカーリットは以前と同じ赤い太いキツネですが、新しい服を着ています。彼女は相変わらず友達の間ではしゃいでいて、恥ずかしがらずに他の人に自分をアピールし、自信に満ちた雰囲気を醸し出しています。今回の作品では、そのチャラチャラした一面を新しい服装で包み込みつつ、キュートな雰囲気を漂わせながら、外の陽だまりの中でバトルで鍛えた肌をキラキラと輝かせ、周囲の注目を集めるような彼女にしたいと思いました。お忙しい中、本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1f7L-G9918pxyYxrg9R61xTAEkN0XhbG5?dmr=1&ec=wgc-drive-globalnav-goto", "created_at": "", "completed_at": ""}, {"path": "/@hakusyokuto/works/126", "thumbnail_src": "https://si.imgix.net/a0126588/uploads/origins/c160d09c-1c44-4b30-aad6-4f3569485e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3acb9fd2b621f23b95922fb271473f4", "thumbnail_srcset": "https://si.imgix.net/a0126588/uploads/origins/c160d09c-1c44-4b30-aad6-4f3569485e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3acb9fd2b621f23b95922fb271473f4, https://si.imgix.net/a0126588/uploads/origins/c160d09c-1c44-4b30-aad6-4f3569485e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eda332328bc21c375a973f80be26228a 2x, https://si.imgix.net/a0126588/uploads/origins/c160d09c-1c44-4b30-aad6-4f3569485e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cr