-a8da-b8f61e0357f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f325659f85ce89ea6847fc2543f16c02, https://si.imgix.net/ec59ffbc/uploads/origins/c001eab0-f4ad-40c5-a8da-b8f61e0357f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe37e8dffb9777234543edd58e8a4f2f 2x, https://si.imgix.net/ec59ffbc/uploads/origins/c001eab0-f4ad-40c5-a8da-b8f61e0357f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eca245bd34f757f7c38b561e9f0b3f74 3x", "genre": "art", "nsfw": false, "body": "【概要】\nフラワーナイトガールのミント(成長する美徳)がセーラースターズに登場するスターシードの力を開放しようとしているシチュエーション\n\n【キャラクター・表情】\nミント(成長する美徳)の通常の姿。\nミントは穏やかな表情をしています\n\n【詳細】\nスターシードは資料のように胸元に金色の花が咲くことで現れる輝く光を放つ結晶で、ミントのスターシードの色は緑色をしています。\n資料と同じく、胸元に咲いた金色の花の上に結晶が浮かんでいて、美しい緑色の輝きを放っています。\nスターシードのサイズは資料のサイズと同じでなくともかまいません、描きやすいサイズでお願いします。\n\n希望の納品形式はPSDで、スターシードの結晶と花はそれぞれ別のレイヤーでいただきたいです。\nそれ以外のご不明な点などは、全てお任せします。\n特殊なシチュエーションのリクエストですが、ご検討いただけますと幸いです。\n\n【資料】\n・ミント\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%9F%E3%83%B3%E3%83%88%28%E6%88%90%E9%95%B7%E3%81%99%E3%82%8B%E7%BE%8E%E5%BE%B3%29\n\n・スターシード\nhttps://i.gyazo.com/2c276b6796f04efb101b08180fbfece7.gif\n\nhttps://i.gyazo.com/cc50132bcc82625f77a4c87986a69764.jpg", "created_at": "", "completed_at": ""}, {"path": "/@sahara_tsugumi/works/299", "thumbnail_src": "https://si.imgix.net/9c0073d8/uploads/origins/c9dadfa5-ada2-489c-8538-5cdd0ec4e075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=224737ccd6c5abed381a5b1c2c155761", "thumbnail_srcset": "https://si.imgix.net/9c0073d8/uploads/origins/c9dadfa5-ada2-489c-8538-5cdd0ec4e075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=224737ccd6c5abed381a5b1c2c155761, https://si.imgix.net/9c0073d8/uploads/origins/c9dadfa5-ada2-489c-8538-5cdd0ec4e075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83a05d780c60b26febcbd8c01a970b44 2x, https://si.imgix.net/9c0073d8/uploads/