%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a193c715c0c31ed8a614de386f64e6a5", "thumbnail_srcset": "https://si.imgix.net/5f8c9e7b/uploads/origins/1916eb54-808f-4148-a4b7-3a1645a2c385?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a193c715c0c31ed8a614de386f64e6a5, https://si.imgix.net/5f8c9e7b/uploads/origins/1916eb54-808f-4148-a4b7-3a1645a2c385?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f9de13a25ec69c337e5f7f39945f109 2x, https://si.imgix.net/5f8c9e7b/uploads/origins/1916eb54-808f-4148-a4b7-3a1645a2c385?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d24204c47177890f5fd43d572778d66 3x", "genre": "art", "nsfw": false, "body": "長文のアピールありがとうございます！遅れましたがリクエストさせていただきます！\n自身のオリジナルキャラクター「園場しのぎ」のイラストをお願いします！！\n\n参考資料はこちらを御覧ください→https://twitter.com/zeromission/status/1371085920636563460\n園場しのぎ本人のアカウントはこちらです→https://twitter.com/sonoshino_v\n\nイラストですがアピールに書いてあったクリスマスはもうシーズンすぎてしまったので、バレンタインもしくは桜の季節に合うようなイラストをお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@puchi_illust/works/74", "thumbnail_src": "https://si.imgix.net/14511f28/uploads/origins/b6d914a6-d171-454f-886e-b6c9dc9f2088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=203e602042aa1205e6f54b30ba24b4be", "thumbnail_srcset": "https://si.imgix.net/14511f28/uploads/origins/b6d914a6-d171-454f-886e-b6c9dc9f2088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=203e602042aa1205e6f54b30ba24b4be, https://si.imgix.net/14511f28/uploads/origins/b6d914a6-d171-454f-886e-b6c9dc9f2088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f63bbb01ca11c571f42da686732629fa 2x, https://si.imgix.net/14511f28/uploads/origins/b6d914a6-d171-454f-886e-b6c9dc9f2088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eece5b473ad0dfbf2b6bc5ba854ea0d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、アピールありがとうございます。\n\nキャラクターはうちの子・陽夜子(資料参考)で、シチュエーションはバレンタインに向けてお菓子作りをしている。\n\n背景、構図、ポーズ、服装、すべてお任せします。\n\n以上、宜しくお願いします。\n\nhttps://twitter.com/barrel_sake2020/status/1527238709690503170", "created_at": "", "completed_at": ""}, {"path": "/@puchi_illust/works/73", "thumbnail_src": "https://si.imgix.net/02d4a150/uploads/origins/a70e6ff7-207a-4e7c-bcad-98ddb47692a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a8c5a3d50f23b39038a5ae1fe23270", "thumbnail_srcset": "https://si.imgix.net/02d4a150/uploads/origins/a70e6ff7-207a-4e7c-bcad-98ddb47692a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a8c5a3d50f23b39038a5ae1fe23270, https://si.imgix.net/02d4a150/uploads/origins/a70e6ff7-207a-4e7c-bcad-98ddb47692a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f382156af7a614fd10312d0d7e5d53e9 2x, https://si.imgix.net/02d4a150/uploads/origins/a70e6ff7-207a-4e7c-bcad-98ddb47692a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9edd72a9cc448ede52457079f035894b 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！！\nたくさん褒めていただけてとっても嬉しいです！！\n\nぜひかなたを可愛く描いていただければと思います。\n\n構図はエッヘンとどや顔しているのがいいかなと思います。\nもし、こう描きたい！というものがありましたら、puchiさんのご希望の構図でも問題ございません。\n\nかなたのキャラデザ・参考資料は下記ツイートをご参照いただければと思います。\nhttps://twitter.com/suito_kanata/status/1587123813153591296?s=20&t=X9qcAc-rhHqHL-Wid-MiSA\n\nYoutubeサムネやSNSでも使用させていただければと思いますので、背景透過PNG等をいただけますと幸いです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@puchi_illust/works/72", "thumbnail_src": "https://si.imgix.net/527620f5/uploads/origins/5c894659-6ca2-4f55-b6c9-d7893fdca996?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8f716e5e60c1fa1c85fc1d39428c993", "thumbnail_srcset": "https://si.imgix.net/527620f5/uploads/origins/5c894659-6ca2-4f55-b6c9-d7893fdca996?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8f716e5e60c1fa1c85fc1d39428c993, https://si.imgix.net/527620f5/uploads/origins/5c894659-6ca2