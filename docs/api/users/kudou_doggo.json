！お邪魔してすみませんでした。\n先生の作品や絵柄がとても好きなので、ぜひOCを依頼させていただけませんでしょうか。\nできましたら、二人のキャラクターのやり取りを描いていただけると嬉しいです。\nこちらのリンクを元に、自由に描いていただいて大丈夫です。\n\nhttps://drive.google.com/drive/folders/1YmlK8xq2gagTFtuFspZnBqVUx3yKBE-b", "created_at": "", "completed_at": ""}, {"path": "/@kudou_doggo/works/24", "thumbnail_src": "https://si.imgix.net/057bcc6f/uploads/origins/494e66c9-061e-43ab-8cf6-755d4d2cd1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c07e7a8ceb1deb45e6e7add47f64a16b", "thumbnail_srcset": "https://si.imgix.net/057bcc6f/uploads/origins/494e66c9-061e-43ab-8cf6-755d4d2cd1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c07e7a8ceb1deb45e6e7add47f64a16b, https://si.imgix.net/057bcc6f/uploads/origins/494e66c9-061e-43ab-8cf6-755d4d2cd1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=163aec56953b8d347edbb5d589aa3576 2x, https://si.imgix.net/057bcc6f/uploads/origins/494e66c9-061e-43ab-8cf6-755d4d2cd1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=866321a04e12913082bd95102a16427d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kudou_doggo/works/23", "thumbnail_src": "https://si.imgix.net/1b0235f5/uploads/origins/cf3e13aa-0a50-482e-82b8-44eb7ed7438e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21987684a9a318f54a9dc568e7c6207c", "thumbnail_srcset": "https://si.imgix.net/1b0235f5/uploads/origins/cf3e13aa-0a50-482e-82b8-44eb7ed7438e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21987684a9a318f54a9dc568e7