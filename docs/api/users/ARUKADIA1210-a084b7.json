2338d4eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fefbc212ddf1eeb55603a21fc61e48, https://si.imgix.net/1085d90c/uploads/origins/9d695d1b-2ecd-442e-976d-a8f2338d4eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fb2583d81ef8061522884fbdeaa3938 2x, https://si.imgix.net/1085d90c/uploads/origins/9d695d1b-2ecd-442e-976d-a8f2338d4eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84409ffe19631fade67450feea1851e6 3x", "genre": "comic", "nsfw": false, "body": "あーさんが以前描かれていた、ゆき、日曜、一突の漫画を読んでみたいです！\n\n気になっていたので(リクエスト‪‪では無い)\n･3人の関係性\n･ゆきちゃんと日曜くんは仲良しさん？\n･何者！家庭的な怪しいお兄さん一突さん(モテてそう\n\n我欲(という名の感想寄り)\n･個人的にゆきと日曜の会話もっと聞いてたい\n･もし仲良しさんなら日曜くん一突さんふみふみありですか\n･家族(血の繋がりなくても)のあったけえ話大好物\n\nふわっとした感じなんですが\nあーさんが描きたいもの描いてできた創作漫画読んでみたい侍なので以前考えてた子と変わったり今描きたい子とかでも大変美味しいです\n\n気が乗らなければぺっぺしてください！\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ARUKADIA1210/works/6", "thumbnail_src": "https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60fa177730b46f6b967c6feb10d8d0bd", "thumbnail_srcset": "https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60fa177730b46f6b967c6feb10d8d0bd, https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c65900e7671f87f3301f82ee7994f8bc 2x, https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b5485dcd7302630e577386f153a476f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回描いていただいたイラストがとても気に入ったので、また別のキャラクターをお願いしたいです。\n\nダニールは不老不死の鍵を見つけることに執着している医者です。彼女は信じられないほど知的ですが、非常に無愛想でもあります。滅多に笑わないし、普段は慇懃無礼でうぬぼれが強い。不老不死に執着するあまり、周囲の人々の命を大切にすることを忘れている。密かに死霊術師である。\n\nモチーフ：彼岸花、キャンドル、黒いレース。\n\nこれらを意識して自由に描いてください。武器を描く必要はありません。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1F99oxg0cM1HheumPZKbM04wjrKm2w1yq", "created_at": "", "completed_at": ""}, {"path": "/@ARUKADIA1210/works/5", "thumbnail_src": "https://si.imgix.net/a316831c/uploads/origins/9ea633fb-8b63-4f15-8d97-d5dde3656e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77f52b9de85752cc5ad1399937d51d9", "thumbnail_srcset": "https://si.imgix.net/a316831c/uploads/origins/9ea633fb-8b63-4f15-8d97-d5dde3656e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77f52b9de85752cc5ad1399937d51d9, https://si.imgix.net/a316831c/uploads/origins/9ea633fb-8b63-4f15-8d97-d5dde3656e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acb53a1cd0f39552592600cfa3605cec 2x, https://si.imgix.net/a316831c/uploads/origins/9ea633fb-8b63-4f15-8d97-d5dde3656e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=192b0814c733451c533b49c1710dcc1a 3x", "genre": "art", "nsfw": false, "body": "hello! i'd like to request artwork of my character, selene. she's a grim reaper, and is very stoic and solemn. however, she has a gentle heart.\n\nhttps://imgur.com/a/HYOnDOm", "created_at": "", "completed_at": ""}, {"path": "/@ARUKADIA1210/works/4", "thumbnail_src": "https://si.imgix.net/6e0c272c/uploads/origins/f0b43c91-d6de-4d66-97b0-f2935efa0825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c88e5e635e7926486aa3516b841849a", "thumbnail_srcset": "https://si.imgix.net/6e0c272c/uploads/origins/f0b43c91-d6de-4d66-97b0-f2935efa0825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c88e5e635e7926486aa3516b841849a, https://si.imgix.net/6e0c272c/uploads/origins/f0b43c91-d6de-4d66-97b0-f2935efa0825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41034a93159c7bbd71e709349ff58017 2x, https://si.imgix.net/6e0c272c/uploads/origins/f0b43c91-d6de-4d66-97b0-f2935efa0825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99d079cf2a80006667f8cdabb71ee898 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのスタイルは美しいです。OCをお願いします。\nhttps://drive.google.com/drive/u/0/folders/1qBwKEYCiJVnnTkbh3DGeyUPN5jL6pK3Y\n\n遊び好きでいたずら好き、ダンスと歌が大好き。ハープを弾き、人をからかうのが好き。いつもニコニコしているけれど、その裏には深い悲しみを隠している。元気いっぱいで遊び好きだが、妖艶でエレガントな一面もある。\n\nテーマとモチーフ：ひまわり、夜、星、魔法、ハープ、妖精、旅、自然\n\nお気遣いありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@ARUKADIA1210/works/3", "thumbnail_src": "https://si.imgix.net/98b5f214/uploads/origins/a52175f0-eec6-46a3-a7f6-0f25f18ff904?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c4a48435ba9d417e15eb6f9a911866", "thumbnail_srcset": "https://si.imgix.net/98b5f214/uploads/origins/a52175f0-eec6-46a3-a7f6-0f25f18ff904?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c4a48435ba9d417e15eb6f9a911866, https://si.imgix.net/98b5f214/uploads/origins/a52175f0-eec6-46a3-a7f6-0f25f18ff904?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fb01538385b932c56e7e32faf475b66 2x, https://si.imgix.net/98b5f214/uploads/origins/a52175f0-eec6-46a3-a7f6-0f25f18ff904?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e71ad4ff9f05efa610fc246537bf5952 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風が大好きなので、私のキャラクター「クレサラ」を描いてほしいです。彼女はお花とリボンやぬいぐるみのようなかわいいものが大好きなとても元気な女の子です。彼女の髪型や服装は好きなように描いてもいいし、フォルダの中の参考資料を使ってもいい。鼻の傷、目の色、ひげのマーク、そばかすに注意してください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-BkU8Pij4phQBxKIq5zDoD3wDk_qvJ6r", "created_at": "", "completed_at": ""}, {"path": "/@ARUKADIA1210/works/2", "thumbnail_src": "https://si.imgix.net/8dc249d1/uploads/origins/6960d98c-2e58-406c-a20d-143273361cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04cb0814f84b07081f2c9a7eef401a04", "thumbnail_srcset": "https://si.imgix.net/8dc249d1/uploads/origins/6960d98c-2e58-406c-a20d-143273361cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04cb0814f84b07081f2c9a7eef401a04, https://si.imgix.net/8dc249d1/uploads/origins/6960d98c-2e58-406c-a20d-143273361cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cc392296a95de62e6b888b0304893c2 2x, https://si.imgix.net/8dc249d1/uploads/origins/6960d98c-2e58-406c-a20d-143273361cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1a178c6d24b9b2da6927279b95f30b7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！もしよろしければ、キャラクターをリクエストしたいのですが。\n\nデュラハンです。彼女はリボンで頭を固定しています。リボンで頭を固定している。髪はよく染めるので、色は自由に（ピンク、緑、白、赤、青など何でもOK）。髪の色は自然な黒で、根元を入れたり、少し伸ばしたりしたい場合は。日焼けした肌にご注目ください。\n\n仕事中は上品な服装が多いが、オフの時はカジュアルな服装も厭わない。服装の例は「服装」にあります。\n\n気遣いは人一倍深いが、わがままな面もある。よくデートをするが、すぐに別れてしまう。本当は愛されたいと思っているが、それを恐れている。人といても孤独を感じるタイプ。\n\n趣味はお化粧、ゲーム、バー通い。\n\nテーマとモチーフ：ワイン、夜更かし、孤独、自分に嘘をついているようで怖い。\n\n彼女に一番似合うと思うものを自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1xcDA7818kEDbil5KyeU3M3eVlIdsLuew?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ARUKADIA1210/works/1", "thumbnail_src": "https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffb2f1e6f4217cc1438838ba78dc7c2", "thumbnail_srcset": "https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffb2f1e6f4217cc1438838ba78dc7c2, https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53a65f11c0aa8fcadc399279b0b9b5b6 2x, https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4e3456927af8c53152cd261774a803e 3x", "genre": "art", "nsfw": false, "body": 