都合が合わない場合はこのリクエストを蹴って頂いて構いません。無理せずせ？ご自愛せ？\n\nhttps://youtu.be/srOYDtgUAls?si=znUIsj8L4QMwplCY", "created_at": "", "completed_at": ""}, {"path": "/@fugang01/works/74", "thumbnail_src": "https://si.imgix.net/5ab8f683/uploads/origins/e6c1360f-a935-45b3-b695-26de74e4d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dae858474077610de2f1608032a3ea93", "thumbnail_srcset": "https://si.imgix.net/5ab8f683/uploads/origins/e6c1360f-a935-45b3-b695-26de74e4d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dae858474077610de2f1608032a3ea93, https://si.imgix.net/5ab8f683/uploads/origins/e6c1360f-a935-45b3-b695-26de74e4d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27d611965b030d5a55930e9ec1ed32d2 2x, https://si.imgix.net/5ab8f683/uploads/origins/e6c1360f-a935-45b3-b695-26de74e4d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72dceaedca654867717f0d79fd5c79d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fugang01/works/73", "thumbnail_src": "https://si.imgix.net/9a004e95/uploads/origins/97dcbfbd-1bbc-4a35-8491-900684bc6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e28a630745bcf90f2c45bf6157d29854", "thumbnail_srcset": "https://si.imgix.net/9a004e95/uploads/origins/97dcbfbd-1bbc-4a35-8491-900684bc6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e28a630745bcf90f2c45bf6157d29854, https://si.imgix.net/9a004e95/uploads/origins/97dcbfbd-1bbc-4a35-8491-900684bc6dbd?bg=%23fff&auto=format%2Cc