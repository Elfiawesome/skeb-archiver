3e-0bba07e3c1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74b3cb53fa1fdfef89538469cac5ce16", "thumbnail_srcset": "https://si.imgix.net/147cc89e/uploads/origins/4f3af57f-75ee-4d87-bc3e-0bba07e3c1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74b3cb53fa1fdfef89538469cac5ce16, https://si.imgix.net/147cc89e/uploads/origins/4f3af57f-75ee-4d87-bc3e-0bba07e3c1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beb229fa57fb0785f7a0a0f8a2c5556d 2x, https://si.imgix.net/147cc89e/uploads/origins/4f3af57f-75ee-4d87-bc3e-0bba07e3c1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c26c46b2302c85e329983032cc5eed2 3x", "genre": "art", "nsfw": false, "body": "怪獣娘〜ウルトラ怪獣擬人化計画〜より、かぷせるがーるずの３人\nアギラ(宮下アキ)ミクラス(牛丸ミク)ウィンダム(白銀レイカ)の３人を、ソウルライドモード(怪獣形態)でお願いします\n\n基本的にSDタッチの作品ですが、変身シーンや劇場版等ではリアル等身にもなります　どちらでもOKです！\n色々と事情があり、検索が難しい作品なので公式サイトのURLを記載しておきます\n\nhttp://kaiju-gk.jp/anime/1st/", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/9", "thumbnail_src": "https://si.imgix.net/1e367621/uploads/origins/8701caf6-63e8-471e-8e70-8d005b3db91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8874814aa66feb232ec384135898178f", "thumbnail_srcset": "https://si.imgix.net/1e367621/uploads/origins/8701caf6-63e8-471e-8e70-8d005b3db91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8874814aa66feb232ec384135898178f, https://si.imgix.net/1e367621/uploads/origins/8701caf6-63e8-471e-8e70-8d005b3db91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2233190af1f9c4493deeb0ec6d7728ac 2x, https://si.imgix.net/1e367621/uploads/origins/8701caf6-63e8-471e-8e70-8d005b3db91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=508c7b203213c840e4ea3067435d3a74 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nリクエストさせて頂きます。\n\n\n『北斗の拳』のリン(少女時代)のパンチラ(モロ)イラストをお願いします。\n「食料をくれたらいいことしてあげるんだけどな～♡」という感じで自分からパンツを見せて誘惑しているイメージです。表情は挑発的な感じでロ〇ビッチ、メスガキ感が強いです。\nポーズや構図等はお任せします。\n\n\n以上です。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/154XDPGUG3BiA0HzxnOXHOjUfdSWG1W-r?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/8", "thumbnail_src": "https://si.imgix.net/9cf5e92d/uploads/origins/824421af-09fc-4e0c-af65-579b45f1745d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9b6c10d31e99b73be64f00645d13b00", "thumbnail_srcset": "https://si.imgix.net/9cf5e92d/uploads/origins/824421af-09fc-4e0c-af65-579b45f1745d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9b6c10d31e99b73be64f00645d13b00, https://si.imgix.net/9cf5e92d/uploads/origins/824421af-09fc-4e0c-af65-579b45f1745d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=587cf6d03c431758d781f32375f11e35 2x, https://si.imgix.net/9cf5e92d/uploads/origins/824421af-09fc-4e0c-af65-579b45f1745d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d7eb43cbf37200a8353ee2e89e08909 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、\n\nはじめまして。\n\n姫野しるこちゃんと晃めろちゃんの漫画 (https://skeb.jp/@msgk_chan/works/5) を拝見して、とても気に入ったので、この二人の漫画をリクエストしたいです。\n\n二人ともお泊まり会で、下着姿です。下着のデザインはお任せします。\n何かに気を取られている晃めろの背後に忍び寄る姫野しるこ。姫野しるこは晃めろの一番敏感なところをくすぐり、晃めろは口を大きく開け、のどちんこが丸見えの状態で不覚にも笑ってしまう。くすぐられた後、晃めろはまったく力が入らない。\nしばらくすると、晃めろは仕返しにと、姫野しるこの敏感なところをくすぐり始める。 姫野しるこはコントロールを失い、手足をバタバタさせる。口を大きく開け、のどちんこが丸見えの状態で、抑えきれずに笑っている。\nくすぐられた後、姫野しるこは完全に混乱し、体から力が抜けている。\n晃めろは彼女を見て、やり過ぎたのではないかと思っている。\n\nご配慮ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/7", "thumbnail_src": "https://si.imgix.net/72dd13bb/uploads/origins/17475c50-0a0e-44b0-8a82-e62d6985ae98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e002036bc150f30e393fbd182541ec2d", "thumbnail_srcset": "https://si.imgix.net/72dd13bb/uploads/origins/17475c50-0a0e-44b0-8a82-e62d6985ae98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e002036bc150f30e393fbd182541ec2d, https://si.imgix.net/72dd13bb/uploads/origins/17475c50-0a0e-44b0-8a82-e62d6985ae98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a46823aec70deac4568481616984d2ac 2x, https://si.imgix.net/72dd13bb/uploads/origins/17475c50-0a0e-44b0-8a82-e62d6985ae98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73dd2c38acd8fab8b728fd3c4ae5a8f8 3x", "genre": "comic", "nsfw": true, "body": "くすぐり漫画見ました。以下の漫画をお願いしたいです。\n\n20歳まで得意とのことなので、みんなが17歳の高校生になった設定でお願いします。\nクラスでくすぐりが流行っており、胡蝶田が、よりエロい体になっためろちゃんをくすぐらせてと頼みに行き、めろちゃんは両腕を挙げて頭の後ろに組みいいよと誘います。\nガラ空きの両脇をくすぐり爆笑してしまう。さらに制服、ブラを脱がせて、乳首丸見えになるが、両手は手の後ろに組んでおり、暴れてスカートも丸見えで、おっぱいを揺らしながら爆笑させられてしまう。\n\nめろちゃんがくすぐられているのを見て、嫉妬心が芽生えた、こちらもめろちゃんほどではないがエロい体に成長した姫野しるこが、制服とブラを脱ぎ、スカートを両手でたくしあげパンツを見せながら、私は我慢できるからくすぐりなさいと胡蝶田をあおる。\n胡蝶田はガラ空きの脇の下をくすぐり、姫野は爆笑してしまう。そのまま手を離してしまうまでくすぐられてしまう。\n\n以上でお願いします。\n細かい流れやセリフはおまかせします。\n今後もくすぐり漫画描いていただければと思います。\n長文失礼しました。", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/6", "thumbnail_src": "https://si.imgix.net/009b6ed1/uploads/origins/218f908c-a6ce-4cc5-bd43-4d8e7870dd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1baaf678afeb5082063a4b537db8e47f", "thumbnail_srcset": "https://si.imgix.net/009b6ed1/uploads/origins/218f908c-a6ce-4cc5-bd43-4d8e7870dd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1baaf678afeb5082063a4b537db8e47f, https://si.imgix.net/009b6ed1/uploads/origins/218f908c-a6ce-4cc5-bd43-4d8e7870dd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43fa1659b3919564262c799cbd9150f4 2x, https://si.imgix.net/009b6ed1/uploads/origins/218f908c-a6ce-4cc5-bd43-4d8e7870dd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50d1029d5ebbb645d7c41ce7a5eb0136 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしいシャルロットのイラストありがとうございました。\nまたリクエストさせて頂きます。\n\n\n『ときめきメモリアル』の早乙女優美のパンチラ(モロ)イラストをお願いします。ゲーム中のボートイベントのパロディで、ボートに足を開いて座りパンツが丸見えになっている優美ちゃんというイメージです。\n(ポーズなどは同じでなくても構いません)\n・優美ちゃんの衣装は夏服です。イチゴTシャツに合わせてイチゴ柄のパンツを穿いています。\n・優美ちゃんは挑発的な表情を浮かべています。「先輩のエッチ♡」という感じで自分からパンツを見せて主人公を誘惑しているイメージです。\n・背景は適当で構いません。\n\n\n以上です。\n検討頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/13dG4E4ABlIgZjIUYnpVRby4GfP-qGXtt?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/5", "thumbnail_src": "https://si.imgix.net/e34b7989/uploads/origins/cb24b18c-e907-4a65-baeb-8353539987af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed848e87052b9b18b6845c145ad923f", "thumbnail_srcset": "https://si.imgix.net/e34b7989/uploads/origins/cb24b18c-e907-4a65-baeb-8353539987af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed848e87052b9b18b6845c145ad923f, https://si.imgix.net/e34b7989/uploads/origins/cb24b18c-e907-4a65-baeb-8353539987af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d70986337fea2dce39adee9a33094ebc 2x, https://si.imgix.net/e34b7989/uploads/origins/cb24b18c-e907-4a65-baeb-8353539987af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3dba71f7c036fc1e4cc0e8f26a44101 3x", "genre": "comic", "nsfw": true, "body": "以下の漫画をお願いしたいです。\n\n女の子をくすぐり、くすぐったさで股を開かせパンツが見えるようにするのが得意な男の子A\n①座ってるところ後ろにいたAに服のすそから手を入れられ、直接両腋の下をもぞもぞこちょこちょと\n　くすぐられ大笑いするめろちゃん　パンツも丸見えになる\n②メスガキムーブを御礼くんにかましていたところ不意に後ろから両腋の下に手を入れられくすぐられ、\n　笑い声に濁音が付くくらい激しく笑うしるこちゃん\n　くすぐりにはメスガキムーブできなくなるくらい弱く、顔真っ赤にして目に涙を溜め大笑いする\n\n設定と異なる箇所があるかもしれませんが並行世界ということで…！\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/4", "thumbnail_src": "https://si.imgix.net/09453021/uploads/origins/e142bff7-c0ed-4baa-84e1-a0f49b899561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d979df97fe3ac29bef73a93029bd50d7", "thumbnail_srcset": "https://si.imgix.net/09453021/uploads/origins/e142bff7-c0ed-4baa-84e1-a0f49b899561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d979df97fe3ac29bef73a93029bd50d7, https://si.imgix.net/09453021/uploads/origins/e142bff7-c0ed-4baa-84e1-a0f49b899561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f0dd82cf55a31e8e1bf917201c5735 2x, https://si.imgix.net/09453021/uploads/origins/e142bff7-c0ed-4baa-84e1-a0f49b899561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66bd9811b203702e7190c85323203028 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n可愛らしい絵柄に惹かれたのでリクエストさせて頂きます。\n\n\n『聖剣伝説3』のシャルロットが虎柄ビキニを着てポーズを取っているイラストをお願いします。\n(同シリーズに登場するタイガービキニを装備しているイメージです)\n・ビキニのデザインはマイクロビキニっぽい際どいものでお願いします。それ以外の装飾などは資料と同じで構いません。帽子は無しでお願いします。\n・シャルロットは挑発的な表情を浮かべています。セクシーボディ(だと本人は思ってる)を見せつけているイメージです。ポーズは「がお～♡」という感じで手を虎の爪のようにしてこちらに向けています。\n\n\n以上です。\n検討頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/1GbUDeJFUAjSbF7UAlt_KzPEw6aVLzwh-?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/3", "thumbnail_src": "https://si.imgix.net/39a41474/uploads/origins/10f8f6cc-8613-451b-a58c-d3ff80c5fc01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01df770f66e4626d5422bc79955ef91", "thumbnail_srcset": "https://si.imgix.net/39a41474/uploads/origins/10f8f6cc-8613-451b-a58c-d3ff80c5fc01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01df770f66e4626d5422bc79955ef91, https://si.imgix.net/39a41474/uploads/origins/10f8f6cc-8613-451b-a58c-d3ff80c5fc01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8014204b680f13eb3c141d014830ead 2x, https://si.imgix.net/39a41474/uploads/origins/10f8f6cc-8613-451b-a58c-d3ff80c5fc01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7085d16a932ca3e834d3d6f380475d28 3x", "genre": "art", "nsfw": true, "body": "リクエストさせていただきます。m(_ _ )m\n\n姫野しるこちゃんと晃めろちゃんの2人が学校でスケベな男子にスカートを持ち上げられて、パンツが丸見えになっているイラストをお願いします。体系はデフォルメではなく頭身が高めの姿で。男の子も簡略化せずに描いてほしいです。\n男の子は「パンツ丸見えだぞ～」とはしゃいでいる。めろちゃんは恥ずかしそうにしているけど、しるこちゃんはそんなに慌てず「まったくこれだから男の子は…」と余裕のある様子。\n下着のデザインはお任せしますが、それぞれ別なものにしてください。\n\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/2", "thumbnail_src": "https://si.imgix.net/54efd202/uploads/origins/3c4791e3-691a-486f-bf37-18a7cb8c782e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe3d0fcc994800adfc02c40a5974ec97", "thumbnail_srcset": "https://si.imgix.net/54efd202/uploads/origins/3c4791e3-691a-486f-bf37-18a7cb8c782e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe3d0fcc994800adfc02c40a5974ec97, https://si.imgix.net/54efd202/uploads/origins/3c4791e3-691a-486f-bf37-18a7cb8c782e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e11fe76111b84fbfdc48737c4640238d 2x, https://si.imgix.net/54efd202/uploads/origins/3c4791e3-691a-486f-bf37-18a7cb8c782e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba43633ff68c7ba681860af40216c286 3x", "genre": "art", "nsfw": false, "body": "ボクサー御堂綱紀！", "created_at": "", "completed_at": ""}, {"path": "/@msgk_chan/works/1", "thumbnail_src": "https://si.imgix.net/9b004587/uploads/origins/055e0bb4-ad42-4f06-9068-8ec8b6be1c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38a4919817c0518c947c8268ab188f3", "thumbnail_srcset": "https://si.imgix.net/9b004587/uploads/origins/055e0bb4-ad42-4f06-9068-8ec8b6be1c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38a4919817c0518c947c8268ab188f3, https://si.imgix.net/9b004587/uploads/origins/055e0bb4-ad42-4f06-9068-8ec8b6be1c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=060b44960b98c483b29c6e793b577b52 2x, https://si.imgix.net/9b004587/uploads/origins/055e0bb4-ad42-4f06-9068-8ec8b6be1c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=225ee0e239432dffa3af05b061629304 3x", "genre": "art", "nsfw": fa