eted_at": ""}, {"path": "/@yoshine_1205/works/15", "thumbnail_src": "https://si.imgix.net/5ae2101a/uploads/origins/58687854-4c8d-45a2-b2f9-41f4ec184236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc9a6b5c44468a332816748af684ce0c", "thumbnail_srcset": "https://si.imgix.net/5ae2101a/uploads/origins/58687854-4c8d-45a2-b2f9-41f4ec184236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc9a6b5c44468a332816748af684ce0c, https://si.imgix.net/5ae2101a/uploads/origins/58687854-4c8d-45a2-b2f9-41f4ec184236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1080e35c5b5c2cac4065a9bfa5bdaedf 2x, https://si.imgix.net/5ae2101a/uploads/origins/58687854-4c8d-45a2-b2f9-41f4ec184236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aa5de4595b63b79c8d9ab8de3290fed 3x", "genre": "art", "nsfw": false, "body": "佳音さん\nいつも素敵なイラストをありがとうございます。\n\n連投に次ぐ連投大変申し訳ございません。\n差し支えなければアークナイツの\nパインコーンのイラストをお願い出来ますでしょうか？\n\nもし可能であればアナログを希望いたします。\n構図は経験値上昇時のセリフ\n「えっと、えっと……全然わかりません……」な時にしてそうな表情だと\nうれしいです。", "created_at": "", "completed_at": ""}, {"path": "/@yoshine_1205/works/14", "thumbnail_src": "https://si.imgix.net/b1b4eb62/uploads/origins/83fcd051-77a2-42de-b0f1-40a1f7873a91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d012c5716da16ce705380e4d3a177ff", "thumbnail_srcset": "https://si.imgix.net/b1b4eb62/uploads/origins/83fcd051-77a2-42de-b0f1-40a1f7873a91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d012c5716da16ce705380e4d3a177ff, https://si.imgix.net/b1b4eb62/uploads/origins/83fcd051-77a2-42de-b0f1-40a1f7873a91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80a75e230bb0714e619f17af843ee643 2x, https://si.imgix.net/b1b4eb62/uploads/origins/83fcd051-77a2-42de-b0f1-40a1f7873a91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed0bafcad541a66979099607c55def79 3x", "genre": "art"