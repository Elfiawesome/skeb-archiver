fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e61ae8885624258c7902b258a59c8bf 3x", "genre": "art", "nsfw": false, "body": "初めましてこんばんは。\nそしていきなりご連絡失礼致します、十種みつかと申します。\nこの度依頼したいと思ったきっかけは、りん様は九尾裂狐兎さんと言う方のお母様だと言うのを確認致しまして、もしりん様さえ宜しければ九尾裂狐兎さんのお母様書き下ろしの絵を描いて頂けたらと思いご連絡させて頂きました\nSD絵でサムネイルに使いやついものを希望しているのですが大丈夫でしょうか？\n\nhttps://x.com/Kuosaki_Koto", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/61", "thumbnail_src": "https://si.imgix.net/a4803b62/uploads/origins/bee4cf88-2c95-4adb-9216-cdf99a1949b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a1caa3c6c8af7894f46c2455f0277e3", "thumbnail_srcset": "https://si.imgix.net/a4803b62/uploads/origins/bee4cf88-2c95-4adb-9216-cdf99a1949b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a1caa3c6c8af7894f46c2455f0277e3, https://si.imgix.net/a4803b62/uploads/origins/bee4cf88-2c95-4adb-9216-cdf99a1949b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a08ae60642ab07528c64d51bac4ccaa 2x, https://si.imgix.net/a4803b62/uploads/origins/bee4cf88-2c95-4adb-9216-cdf99a1949b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bbab645e75c560ad839fc14763de8bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/60", "thumbnail_src": "https://si.imgix.net/0fb12dcf/uploads/origins/7b9edd76-0e20-4ee1-97e6-0891a3069c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b64968b5c66fc075240fc5453b2695", "thumbnail_srcset": "https://si.imgix.net/0fb12dcf/uploads/origins/7b9edd76-0e20-4ee1-97e6-0891a3069c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b64968b5c66fc075240fc5453b2695, https://si.imgix.net/0fb12dcf/uploads/origins/7b9edd76-0e20-4ee1-97e6-0891a3069c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cde1d1bbdc4292bd3c7afa23d919f1f4 2x, https://si.imgix.net/0fb12dcf/uploads/origins/7b9edd76-0e20-4ee1-97e6-0891a3069c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=631552ccd4afaee2e4905de6317359d2 3x", "genre": "art", "nsfw": false, "body": "Hello! I really enjoy your artstyle, and I was hoping if you could draw my bunny!\n\nI'd love if they could be drawn wearing the clothes of the lalafel, blowing a kiss to the viewer with a smug wink!\n\nhttps://www.dropbox.com/sh/67jo3qac2jbi565/AAANGXBdgF_rG_edZrPQiGWNa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/59", "thumbnail_src": "https://si.imgix.net/8a23d8e2/uploads/origins/dfbda2fd-5018-43dc-9c51-aaefd6a85177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae5c6582d6cadc0c16121fe235ee9e1", "thumbnail_srcset": "https://si.imgix.net/8a23d8e2/uploads/origins/dfbda2fd-5018-43dc-9c51-aaefd6a85177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae5c6582d6cadc0c16121fe235ee9e1, https://si.imgix.net/8a23d8e2/uploads/origins/dfbda2fd-5018-43dc-9c51-aaefd6a85177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e618db2cb23e083fd1605b0e4ee0ee5 2x, https://si.imgix.net/8a23d8e2/uploads/origins/dfbda2fd-5018-43dc-9c51-aaefd6a85177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1487f078d5d57433768b918fb52902e1 3x", "genre": "art", "nsfw": false, "body": "Hi!\n\nI love your cute illustrations, especially the eyes!\n\nI wanted to request drawing of my friend's  character in game for her birthday coming up!\n\nShe is shy to new people, but is very mischievious and kind to people who are close to her. If you can capture that feeling that would be awesome!!\n\nThank you!", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/58", "thumbnail_src": "https://si.imgix.net/2eb4b66f/uploads/origins/bfd7de7d-0fce-44d4-b478-d1f04aafeba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ff3864f9f209e06bd2ba153e0340672", "thumbnail_srcset": "https://si.imgix.net/2eb4b66f/uploads/origins/bfd7de7d-0fce-44d4-b478-d1f04aafeba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ff3864f9f209e06bd2ba153e0340672, https://si.imgix.net/2eb4b66f/uploads/origins/bfd7de7d-0fce-44d4-b478-d1f04aafeba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5e1fb10c4e06385966531cd82b652db 2x, https://si.imgix.net/2eb4b66f/uploads/origins/bfd7de7d-0fce-44d4-b478-d1f04aafeba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a8134cd11bc187fc1403025e6461e5c 3x", "genre": "art", "nsfw": false, "body": "Hello nice to meet you!\n\nI would like to submit a request for my character that I would like you to draw.\n\nShe is a cat girl and her personality is coldhearted and serious. She is kuudere and slightly tsundere.\nHer facial expression should be cold but slightly shy. She should have a slight blush.\n\nPlease use this outfit for reference:\nhttps://sta.sh/01qzjmlnlpbg\nhttps://sta.sh/01i9nn520gqz\nhttps://sta.sh/013d692u48cm\n\nI will leave the composition, pose, and details to you.\n\nThank you in advance!\n\nhttps://sta.sh/21bkdcpn9y4k", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/57", "thumbnail_src": "https://si.imgix.net/4c6c6594/uploads/origins/a0c922b2-909d-40e9-8b0a-70c8f06d022e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1afb29a6507c3c9cbe8a61c2502137", "thumbnail_srcset": "https://si.imgix.net/4c6c6594/uploads/origins/a0c922b2-909d-40e9-8b0a-70c8f06d022e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1afb29a6507c3c9cbe8a61c2502137, https://si.imgix.net/4c6c6594/uploads/origins/a0c922b2-909d-40e9-8b0a-70c8f06d022e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee9a931b1474610cb7f63b5e7dd47c8f 2x, https://si.imgix.net/4c6c6594/uploads/origins/a0c922b2-909d-40e9-8b0a-70c8f06d022e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=292c34d9d96d4eab36b090968734639c 3x", "genre": "art", "nsfw": false, "body": "hi! i love your artwork, and would be happy if you could draw my vtuber character!\nhttps://drive.google.com/file/d/1DEUvoZL5mOvgq2DVPBiyn2JE2Raxnav-/view?usp=sharing\nshe is a fluffy creamy-white haired catgirl with a affectionate and mischievous personality!\n\nplease draw her looking surprised and shy in this pose: https://imgur.com/a/KaT86Cf\n\ni would like a transparent copy too. thank you so much!", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/56", "thumbnail_src": "https://si.imgix.net/57b059de/uploads/origins/b12451a3-842c-400f-b324-6bd5af31c7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf80761b26dbd0f19e33a06b5484ca51", "thumbnail_srcset": "https://si.imgix.net/57b059de/uploads/origins/b12451a3-842c-400f-b324-6bd5af31c7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf80761b26dbd0f19e33a06b5484ca51, https://si.imgix.net/57b059de/uploads/origins/b12451a3-842c-400f-b324-6bd5af31c7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beb5e47c385f47d446e32180df432ab1 2x, https://si.imgix.net/57b059de/uploads/origins/b12451a3-842c-400f-b324-6bd5af31c7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0d01650a0e0186d086e83ab04957309 3x", "genre": "art", "nsfw": false, "body": "Hello, I'd like to request art with my friend. Any pose is okay as long as they both appear happy <3\n\nhttps://drive.google.com/drive/folders/1JOK1UIbAoD7JZUCHlDmda8cmhrv8UH55?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/55", "thumbnail_src": "https://si.imgix.net/673f460d/uploads/origins/3d1fb398-591f-4757-8fed-bbb38d0824d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2530b063849ecbcc12fc4021e873e5", "thumbnail_srcset": "https://si.imgix.net/673f460d/uploads/origins/3d1fb398-591f-4757-8fed-bbb38d0824d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2530b063849ecbcc12fc4021e873e5, https://si.imgix.net/673f460d/uploads/origins/3d1fb398-591f-4757-8fed-bbb38d0824d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fc55bfdb3a48a4a5412b5b028ec7fc8 2x, https://si.imgix.net/673f460d/uploads/origins/3d1fb398-591f-4757-8fed-bbb38d0824d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e4265f718ddc6a5b89b627a8528c12b 3x", "genre": "art", "nsfw": false, "body": "Dear Rin Hanasaki, nice to meet you!\nMy name is Nekomaga Himari, and I am currently a Vtuber, although I am still in the preparation stage.\nI got to know you from Proseka's FA and saw your wonderful illustrations, so I sent a request to you to draw one for me!\n\nI would like to send you a request for your drawing.\n(Reference material)\nhttps://twitter.com/2Himari2/status/1527408767901519889?s=20&t=phH_YVglmhgb5O9dVfxD3g\n\nUsage.\nI would like to use it for promotion in my daily SNS activities and as a thumbnail on YouTube!\n\nAbout the illustration\nThe overall atmosphere of the illustration should be cute!\nPose, composition, background, and additional decorations are up to you.\nIf possible, it would be very helpful if you could draw it so that it extends to the waist or the feet...!\n\nPreferred delivery format\nWe would appreciate it if you could include the waist or feet in the drawing if possible.\nWe would appreciate it if you could separate the layers of the background, the person, and the signature, and prepare a transparent version.\nI would appreciate it if you could post it on Twitter with the tag #Himari no Sugatami...!\n\nThank you very much for taking the time to read through this!\nThank you very much for your consideration.", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/54", "thumbnail_src": "https://si.imgix.net/0461bb21/uploads/origins/403e84f2-1710-4660-b6f8-7fc3763f2027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d698389d60b9db1e4c0e57767359125", "thumbnail_srcset": "https://si.imgix.net/0461bb21/uploads/origins/403e84f2-1710-4660-b6f8-7fc3763f2027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d698389d60b9db1e4c0e57767359125, https://si.imgix.net/0461bb21/uploads/origins/403e84f2-1710-4660-b6f8-7fc3763f2027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6505b08b141751fcd8f87bfc4e21efaf 2x, https://si.imgix.net/0461bb21/uploads/origins/403e84f2-1710-4660-b6f8-7fc3763f2027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b9e0d418569ab850f065500389cf92c 3x", "genre": "art", "nsfw": false, "body": "Dear Hana,\n\nI really appreciate your art style. I would like to ask you for an illustration of a character in Shadowverse, which is a cross-platform card game.\nI would be grateful if uploading it to my steam profile artwork showcase is permitted. I am willing to give credit to the art in the description of the post.\n\nYou can find the character in the links below:\n• https://shadowverse-portal.com/card/105541010?lang=en\n• https://drive.google.com/file/d/13__UEiHZQVuna81ui1Fn4G6Yu42NsE06/view?usp=sharing\nHope this helps!\n\nMany thanks,\nLucifer", "created_at": "", "completed_at": ""}, {"path": "/@Hana_rinch/works/53", "thumbnail_src": "https://si.imgix.net/196b3560/uploads/origins/c35ce38c-50e7-4605-aaef-f6f2708bd326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr