%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8288f4b57bd9df4da0b0f3d7b9dafc19 2x, https://si.imgix.net/8d682509/uploads/origins/6ca11fa7-03af-4a75-8a25-4223b339318a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41d8eafbb5f4c433466805e2297f76f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hitomeborere/works/44", "thumbnail_src": "https://si.imgix.net/c8ce8b45/uploads/origins/2121fd63-3ddf-4219-ac55-37b46bc7d74e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71f23189f5c8a58da84cccbb712f5e92", "thumbnail_srcset": "https://si.imgix.net/c8ce8b45/uploads/origins/2121fd63-3ddf-4219-ac55-37b46bc7d74e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71f23189f5c8a58da84cccbb712f5e92, https://si.imgix.net/c8ce8b45/uploads/origins/2121fd63-3ddf-4219-ac55-37b46bc7d74e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45f16251b807cc44c726fc6fd6d06c7a 2x, https://si.imgix.net/c8ce8b45/uploads/origins/2121fd63-3ddf-4219-ac55-37b46bc7d74e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11486bfa5219c1f22cee4b4ae6bdf200 3x", "genre": "art", "nsfw": false, "body": "こんにちは、hitome, baehino(または単にbae)は、お菓子が大好きな、いたずら好きな生意気な悪魔です！怖がろうとしているにもかかわらず、実はとてもかわいかったりする。(ダークソウルなどのソウルゲーム、エルデンリング、ゴスロリ、メンヘラファッション、ジライ系が大好物。どんな服でも、彼女が持っている服でも、どんな構図でもOKです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@hitomeborere/works/43", "thumbnail_src": "https://si.imgix.net/e7ac0017/uploads/origins/d9de27bc-dbc3-47aa-a7e1-23f8687e8097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33ffe3dab54cb64a43ddf96c95c9e7f", "thumbnail_srcset": "https://si.imgix.net/e7ac0017/uploads/origins/d9de27