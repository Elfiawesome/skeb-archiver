e0b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=743022b4a7615baa2e1d665c35e1a794 2x, https://si.imgix.net/db10e790/uploads/origins/2302ac37-d347-4752-9e59-b463487e0b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c190b048c8412130b92fd7fbaca6a8fe 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのイラストがとても好きです～\n\n私のキャラクターのイラストをお願いします。ポーズはお任せします！主な特徴：𖹭 とても可愛くて眠そうな猫耳娘です！𖹭 ヘアクリップやアイマスクなど、頭部のディテールを忘れずに描いてください。𖹭 胸は小さめです。𖹭 可能であれば透明版も提供してください！\n\nSNS（X、Twitch、YouTube）への投稿やプロフィール画像として使用するなど、私のVTuber活動において、あなたのイラストを掲載する許可を頂きたいです。参考画像：https://drive.google.com/drive/folders/1VvimStnTd8mwgQ9BP38g60LVbeNMD2o0?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/318", "thumbnail_src": "https://si.imgix.net/66336117/uploads/origins/fa786f67-200f-46b9-8e5b-f0a6711d9094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=981ca4d2a1b48c4c99bdd551c5f1a96d", "thumbnail_srcset": "https://si.imgix.net/66336117/uploads/origins/fa786f67-200f-46b9-8e5b-f0a6711d9094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=981ca4d2a1b48c4c99bdd551c5f1a96d, https://si.imgix.net/66336117/uploads/origins/fa786f67-200f-46b9-8e5b-f0a6711d9094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53aedbdb4bc9130a4f19653fa26e5aa4 2x, https://si.imgix.net/66336117/uploads/origins/fa786f67-200f-46b9-8e5b-f0a6711d9094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d8effa51b54082f104cddec291f542b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/317", "thumbnail_src": "https://si.imgix.net/d515b193/uploads/origins/7291d13e-2b1f-4eca-b8df-baec92f98a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=852c87b97fedfbf2990ec01a1b66cf20", "thumbnail_srcset": "https://si.imgix.net/d515b193/uploads/origins/7291d13e-2b1f-4eca-b8df-baec92f98a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=852c87b97fedfbf2990ec01a1b66cf20, https://si.imgix.net/d515b193/uploads/origins/7291d13e-2b1f-4eca-b8df-baec92f98a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55e2f54d7d942bb047875e8592554a97 2x, https://si.imgix.net/d515b193/uploads/origins/7291d13e-2b1f-4eca-b8df-baec92f98a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1b1e79a8bedec91f54f8b759686dd16 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとても素敵です！私のキャラクターのイラストを描いてほしいです。笑顔で可愛らしく親しみやすい表情にしてほしいです！とても笑顔で可愛く。  真っ赤な髪！適度な胸！髪は特に後ろが少し長めで、衣装をあまり隠さないように！ティアラはキャラクターの必須アイテムなのでそのまま描いてください。髪型はかなり特徴的で、片側だけカールしていて、前髪はサイドに流すのではなく片側だけカールしています。また、顔の両側に2本の毛束が顔をやさしく縁取っています。彼女は王女様のような気品がありながらも、優しくフレンドリーな性格です！\n私は色覚異常なので、髪は鮮やかな赤にしてください（茶色やオレンジに近い色は避けて）。瞳はとても美しいので、大きく輝いて見えるように！明るく陽気な性格にしてください。https://imgur.com/a/Ods6Evo\n\nhttps://imgur.com/a/Ods6Evo", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/316", "thumbnail_src": "https://si.imgix.net/2c5c93d8/uploads/origins/a594e773-e76a-47ff-907a-e588cc7b1084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c00b84de07486ccdf35e4be3a20ae5", "thumbnail_srcset": "https://si.imgix.net/2c5c93d8/uploads/origins/a594e773-e76a-47ff-907a-e588cc7b1084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c00b84de07486ccdf35e4be3a20ae5, https://si.imgix.net/2c5c93d8/uploads/origins/a594e773-e76a-47ff-907a-e588cc7b1084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e90766e6c3bd53d833c630e4b5ba87a3 2x, https://si.imgix.net/2c5c93d8/uploads/origins/a594e773-e76a-47ff-907a-e588cc7b1084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2000e8301fd6a49adeea3671e53d0e1c 3x", "genre": "art", "nsfw": false, "body": "初めまして。Vライバーの深青白夜と申します。 以前よりうゆ様の素敵な作品を拝見しており、是非私の女体化もお写真を撮って頂いたいと思い、リクエストさせていただきます。 \n\n 【依頼内容】 \n参考資料をもとに私、深青白夜の女体化(深青未夜)のイラストを描いて頂きたい \n\n ・外見のベース 女体化「ベースイラスト」の雰囲気を年齢感(27歳前後)をベースに「髪色・メガネ・ヘアピン参考」の参考に描いていただきたい(髪は暗めの青色で、インナーカラーがシルバー) 目の色は青色で極力キラキラにして頂きたい。  \nメガネ\n向かって左目(実際は右目)下の泣きぼくろ\n髪留め\nは必須で描いて頂きたい\n\n・衣装/髪型  衣装イメージは添付していますが、あくまで参考として自由にアレンジして頂きたい  \nただし杖や頭の上の光輪はなしで\n\n・ポーズ/表情 お茶目で少し色気のある感じにしていただけると嬉しいです  \n\n・描写範囲:全身\n\n・背景 お任せ  \n\n・使用用途 配信アプリのサムネイル/返礼品\n企業案件コラボ用のイラスト/SNS投稿用\n\n・サイズ 縦横ともに3000px以上  \n\n・備考 背景ある場合は背景なしの人物透過データも頂きたい また、描写範囲に関わらず顔の左右と上は切れないように描いて頂きたい  \n上記内容で金額不足等あれば金額提示の上再送いただければ幸いです。  \n\n以上、ご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-FoGWY9gTU4Yyc-xEg9GbiXqxch9G4O6", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/315", "thumbnail_src": "https://si.imgix.net/461f6778/uploads/origins/68926ff5-a1ca-4e4f-8b3d-223f61ff49db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d39760fd45ddb1487e3c9e797b569e9", "thumbnail_srcset": "https://si.imgix.net/461f6778/uploads/origins/68926ff5-a1ca-4e4f-8b3d-223f61ff49db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d39760fd45ddb1487e3c9e797b569e9, https://si.imgix.net/461f6778/uploads/origins/68926ff5-a1ca-4e4f-8b3d-223f61ff49db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a05683668c6b9d5ab028692cc11bac9 2x, https://si.imgix.net/461f6778/uploads/origins/68926ff5-a1ca-4e4f-8b3d-223f61ff49db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1c1f21ee4221e6aef0ad03df7247ed1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/314", "thumbnail_src": "https://si.imgix.net/71f4806b/uploads/origins/393a037b-5530-4878-8e32-25c374484c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7212a52516ebcf6312979340a17bb3e", "thumbnail_srcset": "https://si.imgix.net/71f4806b/uploads/origins/393a037b-5530-4878-8e32-25c374484c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7212a52516ebcf6312979340a17bb3e, https://si.imgix.net/71f4806b/uploads/origins/393a037b-5530-4878-8e32-25c374484c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56e27d2c277f1bdc8f3cecb038f2811d 2x, https://si.imgix.net/71f4806b/uploads/origins/393a037b-5530-4878-8e32-25c374484c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3735aaa9c48fad74138ba645e99368aa 3x", "genre": "art", "nsfw": false, "body": "うゆ様、お世話になっております。\nIRIAMで活動しております、万葉まよです。\nこれで4回目のリクエストになります！\nぜひ今回も描いていただけたら嬉しいなと思いリクエストさせていただきました。\n\n今回も自分のイラストを描いていただきたいと思っています。\n\n＜イラストのイメージ＞\n・自分の髪をポニーテールに結んでいる最中のイラスト\n・服装（部屋着等ラフなかわいらしい服装だと嬉しいです）\n・髪の毛がイラスト内で切れていない状態だと嬉しいです\n\nIRIAMで活動しているため配信のため配信内やXでの使用、サムネイルやヘッダー等に利用させていただきたいです。\nそのため、背景と別で透過されたデータもいただけると嬉しいです。\n\nたくさん要望を書いてしまい申し訳ありませんが、何卒宜しくお願いいたします。\n\nhttps://novel-live.net/vliver/%e4%b8%87%e8%91%89-%e3%81%be%e3%82%88/", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/313", "thumbnail_src": "https://si.imgix.net/8b2547e2/uploads/origins/6f2320d4-f7b9-4c35-8620-9b9ee3bcf3a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c794c75ef9f644dbb48356184b3f589", "thumbnail_srcset": "https://si.imgix.net/8b2547e2/uploads/origins/6f2320d4-f7b9-4c35-8620-9b9ee3bcf3a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c794c75ef9f644dbb48356184b3f589, https://si.imgix.net/8b2547e2/uploads/origins/6f2320d4-f7b9-4c35-8620-9b9ee3bcf3a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e48362492e5d3a94df2ed0efc90fbb0f 2x, https://si.imgix.net/8b2547e2/uploads/origins/6f2320d4-f7b9-4c35-8620-9b9ee3bcf3a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4264c4b6b984b9353aefd977c62379bf 3x", "genre": "art", "nsfw": false, "body": "うゆ🐾さんリクエスト失礼します。\n\nskebで偶然お見かけしましてこれはぜひリクエストを！と思いリクエストさせて頂きました。\n\n【個人Vtuber】 \n琥星楓碧さん（@Koseifua715 ）\n\n 三面図を上げておらず正面のみの資料になりますが下に　 \n右の銀髪トラ耳姿でお願いします⤵ https://x.com/Koseifua715/status/1879533712209232297?t=oXOmt4eoCI32J-_CQYRvxA&s=19\n\n【希望内容】\nこちらからポーズ、構図のリクエストはないのでうゆ🐾さんの自由に描いて頂きたいです。\n\n人物と背景を分けたデータをお願いしたく\n\n【仕様用途】\n琥星楓碧さんご本人様のYouTuberのサムネイル、配信の告知に使用させて頂く可能性があります。\n\nご検討して頂けましたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/312", "thumbnail_src": "https://si.imgix.net/ce53c4f9/uploads/origins/51b38608-ba35-4e3a-a4f8-35496f8892f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c61229a123681fa524d2058e4bd7eb78", "thumbnail_srcset": "https://si.imgix.net/ce53c4f9/uploads/origins/51b38608-ba35-4e3a-a4f8-35496f8892f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c61229a123681fa524d2058e4bd7eb78, https://si.imgix.net/ce53c4f9/uploads/origins/51b38608-ba35-4e3a-a4f8-35496f8892f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddb617acb3a724c72d406336ea2e7f8d 2x, https://si.imgix.net/ce53c4f9/uploads/origins/51b38608-ba35-4e3a-a4f8-35496f8892f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f76c2687a5f3f8aab7bc084d40b56fce 3x", "genre": "art", "nsfw": false, "body": "初めまして、Vライバー活動をしております。\n四門燕（よつかどつばめ）と申します。\n\n是非私のOCを描いて頂けないでしょうか。\n\n・依頼内容\n\nシチュエーションなどおまかせでイラストを描いてほしい。\n\n・私について\n\n人間界についての知識を得たいと燕の国からやってきました。\nどういう訳か人間の姿を手に入れたので、人間に紛れて暮らしています。\n寒い所が苦手で、それでも暖を取りたいとみんなで集まってお話が出来る場所\nという暖かい場所で時折過ごしています。\n\n・構図、要望について\n\nフワフワなイラストをみて、現在、髪型や衣装を模索中でして、\n色んな髪型を見てみたいという事で、色味はそのままで\n髪型、長さなど自由に描いて頂けないかと言うのが要望です。\n衣装はおまかせします！\n\n・データについて\n\nキャラクターと背景はレイヤー分けしてPSDデータで頂いただけると嬉しいです。\n\n・使用範囲\n\nSNS、サムネイル\nパネル明けなどで使用させていただきます。\n\n見えにくい場所があると思いますが、想像におまかせで結構です！！\n燕をモチーフにしているため、燕尾服を少々意識したお洋服になっています。\n\nご検討のほどよろしくお願いします。\n\n参考画像\nhttps://x.com/yotsukado286/status/1982737227437486532/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/311", "thumbnail_src": "https://si.imgix.net/7d60f122/uploads/origins/cc3ae3ef-187b-4b5e-923d-de67960d82c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bafc849a5acb5a947a782ea332f90608", "thumbnail_srcset": "https://si.imgix.net/7d60f122/uploads/origins/cc3ae3ef-187b-4b5e-923d-de67960d82c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bafc849a5acb5a947a782ea332f90608, https://si.imgix.net/7d60f122/uploads/origins/cc3ae3ef-187b-4b5e-923d-de67960d82c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=734840d73b603c54efbd84cfe067cd52 2x, https://si.imgix.net/7d60f122/uploads/origins/cc3ae3ef-187b-4b5e-923d-de67960d82c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba4d592920b00695eaf11f1a54b22bbd 3x", "genre": "art", "nsfw": false, "body": "このキャラクターのキュートでセクシーなイラストを描いてください！\n\nhttps://i.ibb.co/MyHwHFnK/SPOILER-portrait.png", "created_at": "", "completed_at": ""}, {"path": "/@UyU_BeliasFF14/works/310", "thumbnail_src": "https://si.imgix.net/d46828d6/uploads/origins/b7513208-a2a6-4e14-b0cc-1c068cb89d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ef82699e165801b350340aadc3fc02f", "thumbnail_srcset": "https: