08_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec5f0b16fafc2e20f876b001af35c55d 3x", "genre": "art", "nsfw": false, "body": "先日はどうも失礼致しました。赤石と申します。\nやっと勇気が出たので蒼様にスケブのご依頼をと思ったのですが原稿中でしたら申し訳ございません。\n\n鬼滅の煉炭を是非お願いします。\n構成？とか良くわからないので蒼様が描きやすいタッチで構いません。\nどうぞ宜しくお願い致します。\n\n（先日のいいね驚きました、お陰様でソファーから転げ落ちました(笑)）", "created_at": "", "completed_at": ""}, {"path": "/@ask07m/works/8", "thumbnail_src": "https://si.imgix.net/462a951a/requests/15381_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09fdef45526359bc809b739f0309a890", "thumbnail_srcset": "https://si.imgix.net/462a951a/requests/15381_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09fdef45526359bc809b739f0309a890, https://si.imgix.net/462a951a/requests/15381_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8dbd1fe839bc2405d066d8934ddef02 2x, https://si.imgix.net/462a951a/requests/15381_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26f6061e794d5ef4b4a35f19de2c9912 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ask07m/works/7", "thumbnail_src": "https://si.imgix.net/f68fd643/requests/13476_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3a6662d62d3ee0eaa7a67de7c941d3", "thumbnail_srcset": "https://si.imgix.net/f68fd643/requests/13476_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3a6662d62d3ee0eaa7a67de7c941d3, https://si.imgix.net/f68fd643/requests/13476_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c495fac9f3423fb1d6291db7953ea32 2x, https://si.imgix.net/f68fd643/requests/13476_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92bc7fa63aa8f950de7d4aa6abf9931b 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nスケブの作品一覧で拝見し、とてもキレイな空気感の作品に惹かれて依頼させていただきました\n依頼内容ですが、個人的に好きな声優さんが小西克幸さんと安元洋貴さんでして\nこの二人の声がイメージのオリジナル軍人キャラクターを二名よろしくお願いいたします\n(BLテイストは無しでお願いいたします)\n\n足助様は和テイストが、お得意なようですので和装でも洋装でも、どちらでも構いません\n\nまた、構図･武器所持の有無･着彩･背景などは予算に合わせてお任せなのですが、可能であればどちらか一名を褐色肌に色素の薄い髪色\n合わせてどちらか一名(または二人とも)を眼鏡キャラで描いていただけましたら幸いです\n\n細かく指定してしまい申し訳ございません\nお時間などに余裕があり、依頼内容に少しでも気が向きましたら どうぞよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@ask07m/works/6", "thumbnail_src": "https://si.imgix.net/0d78b844/requests/13755_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d3c5a78e701f0718c7c76bc2f342724", "thumbnail_srcset": "https://si.imgix.net/0d78b844/requests/13755_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d3c5a78e701f0718c7c76bc2f342724, https://si.imgix.net/0d78b844/requests/13755_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c529f9d1d837aa9d851aa884e521ed0 2x, https://si.imgix.net/0d78b844/requests/13755_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb089016e0c620e49df8eb005564eec0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Ruyです。\n先日は素敵なイラストありがとうございました！\n今回は和装のうちの子を描いていただきたいです！\nもし余裕がありましたら、蝶々や植物のアクセント？があると嬉しいです。\nお忙しいと思いますので、お時間あるときにでも…\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ask07m/works/5", "thumbnail_src": "https://si.imgix.net/20354c0d/requests/12125_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc4e33ebaf097eb0a3f9cbce0b69cd1", "thumbnail_srcset": "https://si.imgix.net/20354c0d/requests/12125_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc4e33ebaf097eb0a3f9cbce0b69cd1, https://si.imgix.net/20354c0d/requests/12125_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5982782a08b98b5dbd8a3d1082d22890 2x, https://si.imgix.net/20354c0d/requests/12125_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ca7733e88c9e300da589d55cc5c25eb 3x", "genre": "art", "nsfw": false, "body": "前回は素敵なイラストをありがとうございました！\n絵も和服デザインもとても素敵で違う子でも見たい！ということで今度は固定ツイートのモーメントの3枚目のスティートの和服姿(デザインお任せ)が見たいと思い依頼させて頂きます。\n固定ツイの設定画ではぶかぶかな大きめの服を着ていますが、ぶかぶかじゃなくても構いません。\nどこかに死神ぽい要素と前回の悠と服の模様でもアイテムでもいいので、お揃いの部分があると嬉しいです。\n書いてない部分はお任せします。\n金額的に難しい部分は省いて下さって大丈夫です。\n前回と同じ正方形サイズで描いて頂けると嬉しいです。(印刷して並べた時に同じ形だと良さそうなので…！)\n前回と同じく宛名は絵の雰囲気を壊さないよう隅の方に小さく書いて頂けるとありがたいです。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ask07m/works/4", "thumbnail_src": "https://si.imgix.net/7041a66b/requests/11831_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a225224cf4e2ef2a82004fefaf2d88ea", "thumbnail_srcset": "https://si.imgix.net/7041a66b/requests/11831_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a225224cf4e2ef2a82004fefaf2d88ea, https://si.imgix.net/7041a66b/requests/11831_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acb729e4e524992f5c262e0e733c8fc3 2x, https://si.imgix.net/7041a66b/requests/11831_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6d3326d4a8351e2f7858c01d9320ab6 3x", "genre": "art", "nsfw": false, "body": "はじめまして。自創作キャラのイラストを描いていただきたくおもい、リクエストを送らせていただきました。　参考画像：https://www.dropbox.com/sh/5y1upeavqyw24zx/AADW9hjAMTUmD-wyx4RJsMD8a?dl=0　足助さまのセンスで和風系の服をデザインして着せていただきたいこと以外は全てお任せします。(描写範囲・サイズ等)よろしければお願いします....！", "created_at": "", "completed_at": ""}, {"path": "/@ask07m/works/3", "thumbnail_src": "https://si.imgix.net/d7c73916/requests/11911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ddf6da737d0fea1aa686545a3b5f69c", "thumbnail_srcset": "https://si.imgix.ne