ba07c-fc3d-4904-8903-bd28055850a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38c57d669c9e60c83fa3693cf4a81e2e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回の作品、本当にありがとうございました！\nまたハイエナのソナを描いてほしいです。\n何を描くかについては、芸術的な自由を与えてほしいのですが、参考文献にある代替案と同じような服装で彼女を描いていただけたらと思います。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1ZWDKwuX4tuPA3ou3HbETBlZ6P3L6DIbo", "created_at": "", "completed_at": ""}, {"path": "/@namamekasumi/works/15", "thumbnail_src": "https://si.imgix.net/340103bf/uploads/origins/c82a4a2c-5f7d-44ee-a621-db6b76eeabbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e12a16e4d469d538b1e21d92fa7b137", "thumbnail_srcset": "https://si.imgix.net/340103bf/uploads/origins/c82a4a2c-5f7d-44ee-a621-db6b76eeabbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e12a16e4d469d538b1e21d92fa7b137, https://si.imgix.net/340103bf/uploads/origins/c82a4a2c-5f7d-44ee-a621-db6b76eeabbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf2b7aec2ccaee1291f4a6067960567b 2x, https://si.imgix.net/340103bf/uploads/origins/c82a4a2c-5f7d-44ee-a621-db6b76eeabbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42c20b3b51f85358f1d796427d1a4502 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@namamekasumi/works/14", "thumbnail_src": "https://si.imgix.net/c89ebe01/uploads/origins/80ab5013-1b1f-4361-8aec-12a59e64bfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb3cc989b43a9f8780bcec022d0f6d8", "th