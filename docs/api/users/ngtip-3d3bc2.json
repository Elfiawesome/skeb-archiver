ize=30&txt=PRIVATE&s=d6e2c5da976227d16c2a2a736b655447", "thumbnail_srcset": "https://si.imgix.net/13a3dfda/uploads/origins/a1424d68-5f42-4743-ad7d-2a980b17ac70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6e2c5da976227d16c2a2a736b655447, https://si.imgix.net/13a3dfda/uploads/origins/a1424d68-5f42-4743-ad7d-2a980b17ac70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1b6aa8a602ae386cff3092504ba988a 2x, https://si.imgix.net/13a3dfda/uploads/origins/a1424d68-5f42-4743-ad7d-2a980b17ac70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=731bcb0ac5967b0abc5606756825b796 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ngtip/works/43", "thumbnail_src": "https://si.imgix.net/46eaf7ff/uploads/origins/dcebbf38-b035-43df-a72a-11f4cf271c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7cafa29153fcfc919153102dc987e7", "thumbnail_srcset": "https://si.imgix.net/46eaf7ff/uploads/origins/dcebbf38-b035-43df-a72a-11f4cf271c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7cafa29153fcfc919153102dc987e7, https://si.imgix.net/46eaf7ff/uploads/origins/dcebbf38-b035-43df-a72a-11f4cf271c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b0acf48bad35e99c5a58ce1898fb6ed 2x, https://si.imgix.net/46eaf7ff/uploads/origins/dcebbf38-b035-43df-a72a-11f4cf271c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e77cfac921964e93bc83c27e5882ec9 3x", "genre": "art", "nsfw": true, "body": "幽香さんのunbirth絵が想像以上に良くて別パターンが見たくなったので連続の依頼失礼します。\n\n前回と同じく自身よりも少し大柄な男性を胎内に呑み込んで大きなお腹を抱えた風見幽香さんをお願いしたいです。\n\n\n・アングルは横方向から(真横からか、斜め前からか等はお任せします)\n・胎内の男の抵抗でお腹が少し凸凹している\n・快楽で少し仰け反り気味\n・股から透明の粘液が大量に吹き出している\n\nその他、姿勢や格好、肌やお腹の感じは前回の依頼と共通でお願いします。\n\n細かい注文が多くてすみませんがよろしくお願いいたします。\n\n\n以下、参考資料です\nhttps://twitter.com/shin50530001/status/1629797608888893440?t=Gf7gdBFTGSclqtVbtYgtKw&s=19\n\nhttps://twitter.com/shin50530001/status/1744061272289923326?t=VOdmFRsaCiIzRbVAMK_ykA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@ngtip/works/42", "thumbnail_src": "https://si.imgix.net/aa3841aa/uploads/origins/312ebf06-d118-46c8-9b25-f4b9bda6291e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=066d05fe2bcaab37094300c62c9a0691", "thumbnail_srcset": "https://si.imgix.net/aa3841aa/uploads/origins/312ebf06-d118-46c8-9b25-f4b9bda6291e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=066d05fe2bcaab37094300c62c9a0691, https://si.imgix.net/aa3841aa/uploads/origins/312ebf06-d118-46c8-9b25-f4b9bda6291e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45f799034440e22756df6d1b4a4bf9af 2x, https://si.imgix.net/aa3841aa/uploads/origins/312ebf06-d118-46c8-9b25-f4b9bda6291e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a743dd1c0f938a4f3804031522e35099 3x", "genre": "art", "nsfw": true, "body": "はじめまして。幽香さんを素敵な絵柄で描いていらっしゃったので依頼させていただきました。\n\nかなり特殊なシチュですが、自身よりも少し大柄な男性を胎内に呑み込んで(俗に言う胎内回帰、unbirth)、大きくなったお腹を抱えて快楽に浸っている風見幽香さんをお願いしたいです。\n\n・格好は全裸で、お腹は胸元までせり上がり、乳房が押し上げられているような感じ\n・姿勢は膝立ち\n・全身が汗ばみ、頬が紅潮\n・足元は股から溢れた透明な粘液で水溜まりのようになっている\n\nその他の構図、アングル等はお任せします。色々細かくて申し訳ないですがどうぞよろしくお願いいたします。\n\n以下、参考資料です\n\nhttps://twitter.com/shin50530001/status/1629794976870862849?t=qgJe0SVKgOSn9j88hOh-JA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@ngtip/works/41", "thumbnail_src": "https://si.imgix.net/636d9108/uploads/origins/e5a32304-3699-4616-b164-f25c8cc7e97a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc7322a7323cd9e1681aac67d45b2889", "thumbnail_srcse