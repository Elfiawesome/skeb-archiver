9795c/uploads/origins/40dfb2ac-73af-4732-87ac-ba62c1810e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad533be23e6f1afe7d8dc285b9ea0a42", "thumbnail_srcset": "https://si.imgix.net/8129795c/uploads/origins/40dfb2ac-73af-4732-87ac-ba62c1810e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad533be23e6f1afe7d8dc285b9ea0a42, https://si.imgix.net/8129795c/uploads/origins/40dfb2ac-73af-4732-87ac-ba62c1810e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75040a27440a1beeb4fb70ab026020f8 2x, https://si.imgix.net/8129795c/uploads/origins/40dfb2ac-73af-4732-87ac-ba62c1810e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce7ec1fc7706cb19a1059c490b6087e5 3x", "genre": "art", "nsfw": true, "body": "はじめまして、最近ねがたいぱさんを知りとても絵柄が好みだったので、リクエストの方失礼します。\n風見幽香が牛のコスプレをして、複数の手で乳首と大きめのクリトリス(子どものちんこくらい)を手で搾乳するかのように扱かれて母乳を吹き出しながら絶頂しているイラストをお願いしたいです。\nカラーでもモノクロでもどちらでも構いません。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ngtip/works/37", "thumbnail_src": "https://si.imgix.net/4110c7ef/uploads/origins/9ddd1505-e548-478e-a11c-40937e9d6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7426449095579c7f7d385286f6f813d5", "thumbnail_srcset": "https://si.imgix.net/4110c7ef/uploads/origins/9ddd1505-e548-478e-a11c-40937e9d6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7426449095579c7f7d385286f6f813d5, https://si.imgix.net/4110c7ef/uploads/origins/9ddd1505-e548-478e-a11c-40937e9d6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c456efcd8935d126baabf78633acde4 2x, https://si.imgix.net/4110c7ef/uploads/origins/9ddd1505-e548-478e-a11c-40937e9d6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f51968841726f2a6ef50787c78cb5b9e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ngtip/works/36", "thumbnail_src": "https://si.imgix.net/c31074b3/uploads/origins/8957e234-dad9-4451-86e1-6ceed9f99554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a44f490c670e60804a17ec8f8deb9140", "thumbnail_srcset": "https://si.imgix.net/c31074b3/uploads/origins/8957e234-dad9-4451-86e1-6ceed9f99554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a44f490c670e60804a17ec8f8deb9140, https://si.imgix.net/c31074b3/uploads/origins/8957e234-dad9-4451-86e1-6ceed9f99554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=109acad8e56ecdd61810bd3f0337957d 2x, https://si.imgix.net/c31074b3/uploads/origins/8957e234-dad9-4451-86e1-6ceed9f99554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2be92221bc062232b9a861990f825aa 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエスト失礼します。\n\nキャラ:東方旧作のくるみ\nシチュエーション:フェラ→飲精→嘔吐\n\n具体的な内容としましては、\n･くるみちゃんは通常衣装の着衣、竿役は特に指定ありません(ちんぽと手だけの描写でOKです)\n流れとしましては\n①くるみちゃんがフェラしてる\n②くるみちゃんが根元まで咥え込み、竿役がくるみちゃんの頭を手で軽く押さえた状態で射精(喉奥に直接流し込む感じ)\n③長く続く射精、くるみちゃんは苦しそうにもごくごくと飲精する、飲み切れない分の精液が口元から漏れ出す\n④射精が終わりちんぽから口を離して気持ち悪そうな顔をするくるみちゃん\n⑤我慢できず嘔吐、飲んだ精液だけでなく30分くらい前に食べたケーキなど胃の中身を全部吐き出してしまう、吐瀉物で口からブラウスの胸元とスカートまでベトベトになる。\n\nフェラ自体は強要ではなく和姦、射精量は500ml～1リットルくらい、かなり臭くて不味くて粘度も高いという設定でお願いします。\n嘔吐シーンがメインで、吐瀉物はなるべくリアルに描いて頂けるとありがたいです。\n指定のない部分はおまかせします。\n\nそれでは可能な範囲内で大丈夫ですのでよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ngtip/works/35", "thumbnail_src": "https://si.imgix.net/588758fe/uploads/origins/67bc528c-37f6-4d87-acd3-12b03625e02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b9a77e15155e331f8f94cdf02ca28a", "thumbnail_srcset": "https://si.imgix.net/588758fe/uploads/origins/67bc528c-37f6-4d87-acd3-12b03625e02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b9a77e15155e331f8f94cdf02ca28a, https://si.imgix.net/588758fe/uploads/origins/67bc528c-37f6-4d87-acd3-12b03625e02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f701e7839a2f12798a7fd0f1c849767c 2x, https://si.imgix.net/588758fe/uploads/origins/67bc528c-37f6-4d87-acd3-12b03625e02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba595d29d4272d9026a624a3c28861aa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}