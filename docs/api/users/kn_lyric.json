n7olq6aac2ji&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kn_lyric/works/6", "thumbnail_src": "https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=488f6a5da7475e4a5456a3228738329f", "thumbnail_srcset": "https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=488f6a5da7475e4a5456a3228738329f, https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=34c1bbb4356471b001925d25df8ff5c8 2x, https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9d6855e38162a4f75f7d86272a2b1a1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの芸術が本当に好きで、私が参照したサンプル写真のように私のキャラクターを描くことができるかどうか疑問に思っていました！私はこれをアニメーションにしたいのですが、もし多くのレイヤーでこれを得ることが可能であれば、それは素晴らしいことです！もし、多くのレイヤーでこれを得ることが可能であれば、それは素晴らしいことです！そうでない場合は、それは結構です！比率を16：9にしてもらえますか？\n\nhttps://drive.google.com/drive/folders/1bMJY_q7nJOKWj5qUqPAAKsIMZW2e5RNc?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kn_lyric/works/5", "thumbnail_src": "https://si.imgix.net/eee322ec/uploads/origins/b0bb7de9-831e-427f-8218-11e97f8f6b0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c7a441f7326ce6ff6265e80137ef9a", "thumbnail_srcset": "https://si.imgix.net/eee322ec/uploads/origins/b0bb7de9-831e-427f-8218-11e97f8f6b0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c7a441f7326ce6ff6265e80137ef9a, https://si.imgix.net/eee322ec/uploads/origins/b0bb7de9-831e-427f-8218-11e97f8f6b0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=131bbe010183d735c7dfd97ebb105abc 2x, https://si.imgix.net/eee322ec/uploads/origins/b0bb7de9-831e-427f-8218-11e97f8f6b0e?bg=%23fff&auto=format%