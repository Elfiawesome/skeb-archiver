ec6-439e-a3f3-afc96e69090f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be0632cce313c8b96e6b000620398ae1 2x, https://si.imgix.net/df617333/uploads/origins/2b040fb9-0ec6-439e-a3f3-afc96e69090f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8260f04614a660336955f99294542e67 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@klack_Rodyalove/works/12", "thumbnail_src": "https://si.imgix.net/49d7c013/uploads/origins/d0802f56-ed4d-4b04-bb97-1489f6601a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5936becf40d015c1aca17f6afad8d1e2", "thumbnail_srcset": "https://si.imgix.net/49d7c013/uploads/origins/d0802f56-ed4d-4b04-bb97-1489f6601a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5936becf40d015c1aca17f6afad8d1e2, https://si.imgix.net/49d7c013/uploads/origins/d0802f56-ed4d-4b04-bb97-1489f6601a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c66f4bd7a00fe36846d84536955b693f 2x, https://si.imgix.net/49d7c013/uploads/origins/d0802f56-ed4d-4b04-bb97-1489f6601a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e368bfe3c203f9397023b2735277b89c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Klack先生！\nLimbusCompanyのムルソーがBladeRunner 2049の \"K \"になっているところを描いてほしい（idを装備しているような感じで）。彼の状態は、少し打ちのめされ、疲れ果てて、荒れた感じ。背景は雨の降る未来のディストピア都市。(あまり複雑にする必要はありません）。\nありがとう！(https://imgur.com/a/iQShHHU)", "created_at": "", "completed_at": ""}, {"path": "/@klack_Rodyalove/works/11", "thumbnail_src": "https://si.imgix.net/1d27ff9e/uploads/origins/dae82db2-bcf9-4852-adda-d1658a5064a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b2e1eab846248e24ba26e46d8f2699", "thumbnail_srcset": "https://si.imgix.net/1d27ff9e/uploads/origins/dae82db2-bcf9-4852-adda-d1658a5064a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b2e1eab846248e24ba26e46d8f2699, https://si.imgix.net/1d27ff9e/uploads/origins/dae82db2-bcf9-4852-adda-d1658a5064a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0eb7ebadd1b1578886c4218e504a505f 2x, https://si.imgix.net/1d27ff9e/uploads/origins/dae82db2-bcf9-4852-adda-d1658a5064a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe7882665081d4cb35a8de53fa69f245 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n\n私のOC、リコリスを描いてください。軍人のドラゴンの女の子です。年齢は20代後半です。\nhttps://drive.google.com/drive/folders/1r_UPm0gKghOAJP8l72ZwM8tpnQbPkpvk?usp=drive_link\n\nリコリスは、たとえその手を血で染めなければならないとしても、自分の任務に誇りを持つ女騎士である。権威的な存在感を持ち、その絶大な力で兵士たちの尊敬を集めている。彼女の関連エレメントは \"夜 \"と \"水晶 \"である。\n\n魔弾の射手E.G.O.で彼女を描いてください。\nhttps://limbuscompany.wiki.gg/wiki/Lobotomy_E.G.O::Magic_Bullet_Outis\n\nポーズや背景は好みに任せますが、クールで威厳のある一面を見てみたいです。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@klack_Rodyalove/works/10", "thumbnail_src": "https://si.imgix.net/0d46af48/uploads/origins/8c3c195a-f342-4d60-a7c7-d27beb7c2428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=237794a1bab7cb3011d02bdef3622aff", "thumbnail_srcset": "https://si.imgix.net/0d46af48/uploads/origins/8c3c195a-f342-4d60-a7c7-d27beb7c2428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=237794a1bab7cb3011d02bdef3622aff, https://si.imgix.net/0d46af48/uploads/origins/8c3c195a-f342-4d60-a7c7-d27beb7c2428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c623763e480ce6495be81814bf8a9a48 2x, https://si.imgix.net/0d46af48/uploads/origins/8c3c195a-f342-4d60-a7c7-d27beb7c2428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5043dfa1d3e6c62990f0b3855aef8d9 3x", "genre": "art", "nsfw": false, "body": "こんにち