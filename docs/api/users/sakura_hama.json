o/status/1363807006453166088?s=21", "created_at": "", "completed_at": ""}, {"path": "/@sakura_hama/works/74", "thumbnail_src": "https://si.imgix.net/7df77e80/uploads/origins/d415fb99-4a80-4d11-a47b-c65776d9d7b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abfb380a538a4b1e2b91cbd90b5fad17", "thumbnail_srcset": "https://si.imgix.net/7df77e80/uploads/origins/d415fb99-4a80-4d11-a47b-c65776d9d7b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abfb380a538a4b1e2b91cbd90b5fad17, https://si.imgix.net/7df77e80/uploads/origins/d415fb99-4a80-4d11-a47b-c65776d9d7b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14a3cb63bc8f47e39f1c9e7deb1566ad 2x, https://si.imgix.net/7df77e80/uploads/origins/d415fb99-4a80-4d11-a47b-c65776d9d7b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10785037f1492e983d144fc2fe21d8db 3x", "genre": "art", "nsfw": false, "body": "Hello! Nice to meet you!\n\nI would like to request an illustration of my friend's character from FFXIV!\n\nReference photos: https://imgur.com/a/kq9gAGX\n\nFor the pose anything cute is fine, I leave it to you, and if a background is possible please have it something indoors.\n\nIf it is also possible please show a little cleavage in the outfit! Thank you!", "created_at": "", "completed_at": ""}, {"path": "/@sakura_hama/works/73", "thumbnail_src": "https://si.imgix.net/558b88e7/uploads/origins/4ba0e59d-696c-4321-b8b7-1de1f4bdc457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f7467e427988ba2b4a0b45c4ca9a8cc", "thumbnail_srcset": "https://si.imgix.net/558b88e7/uploads/origins/4ba0e59d-696c-4321-b8b7-1de1f4bdc457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f7467e427988ba2b4a0b45