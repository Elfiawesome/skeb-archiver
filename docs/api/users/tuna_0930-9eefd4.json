66f7a2cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=191ec815569dec1b4cd0e8d3a2dd0aa1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/27", "thumbnail_src": "https://si.imgix.net/afd091b2/uploads/origins/9d19723a-a953-440a-af52-95a68d13d56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3387bddb16e886f70f4c7a71ed10f7a1", "thumbnail_srcset": "https://si.imgix.net/afd091b2/uploads/origins/9d19723a-a953-440a-af52-95a68d13d56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3387bddb16e886f70f4c7a71ed10f7a1, https://si.imgix.net/afd091b2/uploads/origins/9d19723a-a953-440a-af52-95a68d13d56e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79eae6f0652c8ef46a24e62b8b825a32 2x, https://si.imgix.net/afd091b2/uploads/origins/9d19723a-a953-440a-af52-95a68d13d56e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68168db1a8c01914538f517473facb57 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私の2人のキャラクターをお願いします。どんなポーズが似合うかわからないので、お任せいただければと思います。2人は兄と妹のような関係です。\n\nLumiは緑の髪をした女の子です。穏やかで礼儀正しく、優雅な外見の下に遊び心のある性格をしています。紫色の瞳と、毛先がカールした短い髪で描いてください。\n\nRadiはピンクの髪をした男の子です。物静かで控えめな性格で、表情はあまり見せませんが、柔らかい顔立ちで、勘が良いです。金色のピアスと丸いメガネをかけた彼を描いてください。\n\nhttps://drive.google.com/file/d/1QNCop-QXTYBG0gv1NRZeNhPCU-R6eyAY/view?usp=sharing\n\nフォルダの中にはテキストが入っていますが、写真だけでも構いません。私のキャラクターが作業しやすいことを願っています。^^ 依頼の機会をいただきありがとうございました～。", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/26", "thumbnail_src": "https://si.imgix.net/2fde2b5b/uploads/origins/16d8484b-15a2-4d4d-a636-e211685c5733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2488b9ec1ec9542d26e7245a78de59b3", "thumbnail_srcset": "https://si.imgix.net/2fde2b5b/uploads/origins/16d8484b-15a2-4d4d-a636-e211685c5733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2488b9ec1ec9542d26e7245a78de59b3, https://si.imgix.net/2fde2b5b/uploads/origins/16d8484b-15a2-4d4d-a636-e211685c5733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf36637e5204b734fb159a15263d3f7a 2x, https://si.imgix.net/2fde2b5b/uploads/origins/16d8484b-15a2-4d4d-a636-e211685c5733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0acce458fc87171d7f6f3d6e25c17cc5 3x", "genre": "art", "nsfw": false, "body": "共通していること\nエルフの耳\n花を手に持っていること\n\n一人目\n肩にかかる長い髪\n髪の色はパステルピンク\n2色目はパステルブルー\n\n2人目\n丸いメガネ\n髪は肩までの長さで、色は茶色\n2色目はダークグリーン", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/25", "thumbnail_src": "https://si.imgix.net/af0aa0aa/uploads/origins/3d76d5cf-894e-4ac5-ab59-29494d6e275f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f8d1f64c9289295b8f158d5c085a1fa", "thumbnail_srcset": "https://si.imgix.net/af0aa0aa/uploads/origins/3d76d5cf-894e-4ac5-ab59-29494d6e275f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f8d1f64c9289295b8f158d5c085a1fa, https://si.imgix.net/af0aa0aa/uploads/origins/3d76d5cf-894e-4ac5-ab59-29494d6e275f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a230bea56de3c53ca6d6297c2d4ffc3a 2x, https://si.imgix.net/af0aa0aa/uploads/origins/3d76d5cf-894e-4ac5-ab59-29494d6e275f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=074edd96a8ec07260fa2b03c161ea868 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\n儚　亡々子（はかない　ななこ）と申します。\n\n以前友人のEir Salveoがお世話になり、作品がとても可愛かったので私の方からもご依頼させていただければと思いました。\n\nさっそくですが、依頼の内容に関しましてはブラック企業に務める幽霊社員VTUBER「儚　亡々子」です。性格は暗くはないが、常に疲れて、眠そうです。絵の構図・色の方ははお任せできればと思います。\n\n資料欄に全体姿が添付されているツイートを共有致しますので、参考にご覧になっていただきたいです。\n\n何卒宜しくお願い致します。\n\nhttps://twitter.com/NanacoHakanai/status/1472603381407846400?t=0v7rnUP34khAbnzHn111OQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/24", "thumbnail_src": "https://si.imgix.net/3f5d155b/uploads/origins/07d32dbc-66fc-4903-83f4-7ec233c3ce78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb1208ca1e46a06d78f5b6ec2e8d098", "thumbnail_srcset": "https://si.imgix.net/3f5d155b/uploads/origins/07d32dbc-66fc-4903-83f4-7ec233c3ce78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb1208ca1e46a06d78f5b6ec2e8d098, https://si.imgix.net/3f5d155b/uploads/origins/07d32dbc-66fc-4903-83f4-7ec233c3ce78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ed7f344601dd3df56653b92ebdeb8bf 2x, https://si.imgix.net/3f5d155b/uploads/origins/07d32dbc-66fc-4903-83f4-7ec233c3ce78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6839b86286c501607da682a008714b32 3x", "genre": "art", "nsfw": false, "body": "私はあなたのスタイルがとても好きです。素敵でユニークです。\n\n私のSNSやストリーミングで使用するために、私のvtuberキャラクターのアートをあなたからいただきたいと思います。\n\n私のvtuberキャラクター「タイガ・リリ」は、未来から来た大統領候補なのです\n\nhttps://twitter.com/lili_taiga/status/1436702800113774593?s=21", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/23", "thumbnail_src": "https://si.imgix.net/8f3a25e3/uploads/origins/8439621c-d96a-4e30-ad2a-db4582ee61a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c04df9bc5e81502c90ddada1e4fac8", "thumbnail_srcset": "https://si.imgix.net/8f3a25e3/uploads/origins/8439621c-d96a-4e30-ad2a-db4582ee61a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c04df9bc5e81502c90ddada1e4fac8, https://si.imgix.net/8f3a25e3/uploads/origins/8439621c-d96a-4e30-ad2a-db4582ee61a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7751a10521a7f26e5cee4a502b007167 2x, https://si.imgix.net/8f3a25e3/uploads/origins/8439621c-d96a-4e30-ad2a-db4582ee61a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b83b1daba9630b0c00dfd70591d6b1f 3x", "genre": "art", "nsfw": false, "body": "Hello! Your art is adorable! I would like to request a drawing of my friend Maple. She is a prince. Thank you for your consideration.\n\nReference: https://drive.google.com/drive/u/0/folders/1uwLwn-SSRlUbaLOCsj0CDoQaMMWGmt42", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/22", "thumbnail_src": "https://si.imgix.net/87f14a7f/uploads/origins/575ff6a4-31b9-4d22-823f-e98f82640431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c90a30f8b78794323843a74de329e462", "thumbnail_srcset": "https://si.imgix.net/87f14a7f/uploads/origins/575ff6a4-31b9-4d22-823f-e98f82640431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c90a30f8b78794323843a74de329e462, https://si.imgix.net/87f14a7f/uploads/origins/575ff6a4-31b9-4d22-823f-e98f82640431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04aa602195ff02b66b63d9f2a805360a 2x, https://si.imgix.net/87f14a7f/uploads/origins/575ff6a4-31b9-4d22-823f-e98f82640431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e55fc218c0a17536b2777ddfb6c79297 3x", "genre": "art", "nsfw": false, "body": "つな様、初めまして！素敵な絵を楽しく拝見させて頂きました。可愛い絵柄に惹かれて、可能ならばつな様に私の自キャラのイラストを依頼したいと思っております。\n\n【１】\n自分の能力を証明するために旅をしているエルフ族の少女です(160cm、見た目は18歳ぐらい)。まだ幼いからちょっと子供っぽくのタイプで、好奇心旺盛で朗らかな性格です。ホットケーキと線香花火が大好物です。\n\n【依頼内容】\n可能ならば、星と光のモチーフを入れて全身の構図で一枚をお願い致します。キャラと服装の参照は下記のURLをご覧ください。その他のポーズなどはつな様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Ze-4O5Vez4zAhG1FySxbSGG0PLCs-PSF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/21", "thumbnail_src": "https://si.imgix.net/d1a834ac/uploads/origins/a3495c53-61d2-4c70-b4b3-d7b05d1b21ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a5adf3766ab1afb2508fd824dff0e9", "thumbnail_srcset": "https://si.imgix.net/d1a834ac/uploads/origins/a3495c53-61d2-4c70-b4b3-d7b05d1b21ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a5adf3766ab1afb2508fd824dff0e9, https://si.imgix.net/d1a834ac/uploads/origins/a3495c53-61d2-4c70-b4b3-d7b05d1b21ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dba30ba1f7cf23853ccf64bafe2396c2 2x, https://si.imgix.net/d1a834ac/uploads/origins/a3495c53-61d2-4c70-b4b3-d7b05d1b21ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5abad529323df79505cf90b55a273ab 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生の絵がとても好きです！\nうちの可愛いの美少女を描かせていただきたいです。\n詳細なキャラクター設定の参考資料：https://photos.app.goo.gl/j6f9ubkYpgFmt1Cz9\n描き間違いやすい部分：彼女は赤い目と赤い髪をしていて、黄色い蝶结びが髪の両側に結ばれています。\n和風的な要素があってもいいと思います。\n構図はおまかせでお願いいたします。\n\n依頼料の範囲内でラフ等を見ることが出来るPSDで頂けると嬉しいです。\n\n迷惑な依頼でしたら拒否していただいて構いませんので、よろしくお願いいたします。m( _ _ )m", "created_at": "", "completed_at": ""}, {"path": "/@tuna_0930/works/20", "thumbnail_src": "https://si.imgix.net/39f64cff/uploads/origins/da45c919-470a-4ac5-8f3d-bd446fddf7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d7685b526681adac522dc934de3893", "thumbnail_srcset": "https://si.imgix.net/39f64cff/uploads/origins/da45c919-470a-4ac5-8f3d-bd446fddf7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d7685b526681adac522dc934de3893, https://si.imgix.net/39f64cff/uploads/origins/da45c919-470a-4ac5-8f3d-bd446fddf7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d15aa836deacbaeff4ba110d19521d6 2x, https://si.imgix.net/39f64cff/uploads/origins/da45c919-470a-4ac5-8f3d-bd446fddf7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73a6d22046f81a0faff54e004c790767 3x", "genre": "art", "nsfw": false, "body": "こんにちは!あなたはとても素晴らしいアートスタイルを持っています!ダニエルとジュピターという2人のキャラクターのイラストをお願いしたいのですが。\n\n彼らと彼らの猫のパンケーキを一緒に描いていただけますか？彼らの猫は、ぽっちゃりしたオレンジ色のタビーです。\n\nお好きなように描いてください。ポーズや構図はお任せします。また、服装も自由に変えてください。\n\nまた、可能であれば、サインと絵を別のレイヤーにしていただいてもよろしいでしょうか？\n\