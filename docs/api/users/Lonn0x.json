middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60f4b7b29352dcc87a9525adfb865ff4 2x, https://si.imgix.net/436dfb81/uploads/origins/5e4c612f-e67b-4828-a3bf-95f299d9b482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76d8317ff0b6acd6ba4365ecb232d8fe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Lonn0x/works/15", "thumbnail_src": "https://si.imgix.net/d78f4a5a/uploads/origins/d9756a11-d42c-496c-81be-0121567ca236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34f0b8c0a8078356df66de4973ec4630", "thumbnail_srcset": "https://si.imgix.net/d78f4a5a/uploads/origins/d9756a11-d42c-496c-81be-0121567ca236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34f0b8c0a8078356df66de4973ec4630, https://si.imgix.net/d78f4a5a/uploads/origins/d9756a11-d42c-496c-81be-0121567ca236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36087fe572fcb97accfbd8e1727ba516 2x, https://si.imgix.net/d78f4a5a/uploads/origins/d9756a11-d42c-496c-81be-0121567ca236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59325902a967566329487e7a3c7f526a 3x", "genre": "art", "nsfw": false, "body": "初めまして。匿名で失礼します。\n\n貴方の描くイラストの雰囲気にとてもひかれたため、リクエストさせていただきます。よろしければ、私のオリジナルキャラクターを描いて頂けないでしょうか？\n\n服装：白いパーカー、その上に赤基調のスカジャン(袖は白) \n　　　腕はまくらせて欲しい\n表情：クールにほほ笑んでいる\n\nポーズやその他指定の無い部分はお任せします。\n\nお忙しい所とは思いますが、ご都合が合えば是非よろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1zXjxuVLQPNOaM0W2WekCuE8JqKM-Ch7W", "created_at": "", "completed_at": ""}, {"path": "/@Lonn0x/works/14", "thumbnail_src": "https://si.imgix.net/561a8181/uploads/origins/29ebf1c2-6125-43fa-9b1f-2229904c433f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b48c83a635f69afcb4d791ff9752438", "thumbnail_srcset": "https://si.imgix.net/561a8181/uploads/origins/29ebf1c2-6125-43fa-9b1f-2229904c433f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b48c83a635f69afcb4d791ff9752438, https://si.imgix.net/561a8181/uploads/origins/29ebf1c2-6125-43fa-9b1f-2229904c433f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=962f0693bb30dcc24453210c7c9fd623 2x, https://si.imgix.net/561a8181/uploads/origins/29ebf1c2-6125-43fa-9b1f-2229904c433f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7a93d2153a597ce68721bfb0d3c7a02 3x", "genre": "art", "nsfw": false, "body": "・髪型はロングくらい\n・髪色は論さんの描きやすいものをお願いします。\n・瞳は緑色（髪型と髪色は上記のようだけれど資料のキャラクターに似てるような似てないような感じの顔になると嬉しいです→\nhttp://kannadukisola.com/138-2/\n・ポーズは、壁に寄りかかって座る\nイメージです→\nhttps://previews.123rf.com/images/ilona75/ilona751201/ilona75120100029/12078539-%E5%A3%81%E3%81%AB%E3%82%82%E3%81%9F%E3%82%8C%E3%81%A6%E5%BA%8A%E3%81%AB%E5%BA%A7%E3%81%A3%E3%81%A6%E6%82%B2%E3%81%97%E3%81%84%E3%83%86%E3%82%A3%E3%83%BC%E3%83%B3%E3%82%A8%E3%82%A4-%E3%82%B8%E3%83%A3%E3%83%BC%E3%81%AE%E7%94%B7%E3%81%AE%E5%AD%90.jpg……\n・くらい雰囲気を持ったキャラでお願いします。\n・画面も暗めで構いません。\n・男女は、論さんのインスピレーションにお任せしたいです。\n・服装は、だぼっとした感じだと嬉しいです。\n\nリクエスト承認は、可能ならば、で構いません。いつも素敵です。ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@Lonn0x/works/13", "thumbnail_src": "https://si.imgix.net/dca479c1/uploads/origins/4dda623a-8c57-478e-9443-e4ad6ffe8932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56e42a74bb9ad2c7a1060848c1d16d5", "thumbnail_srcset": "https://si.imgix.net/dca479c1/uploads/origins/4dda623a-8c57-478e-9443-e4ad6ffe8932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56e42a74bb9ad2c7a1060848c1d16d5, https://si.imgix.net/dca479c1/uploads/origins/4dda623a-8c57-478e-9443-e4ad6ffe8932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76a6d0f71b04190c2b0ae391b0324861 2x, https://si.imgix.net/dca479c1/uploads/origins/4dda623a-8c57-478e-9443-e4ad6ffe8932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab2981db79a2cc9323d2afc76c865f14 3x", "genre": "art", "nsfw": false, "body": "・以前のリクエストで描いていただいた「あぐらの女性」の本人orその弟/妹（→前回のキャラが気に入りましたので同じキャラか似ている少し若いキャラ）\n・髪形はショート〜肩に届くかくらい\n・服装は夏物（現実寄りでもゲームキャラ寄りでもどちらも好きです）\n・ポーズは、バストアップ〜腰から上（→アイコンにしたいです）\n・前回のイラストに描いてくださった「猫」再登場したら幸いです。（しなくとももちろん結構です）", "created_at": "", "completed_at": ""}, {"path": "/@Lonn0x/works/12", "thumbnail_src": "https://si.imgix.net/1efe811a/requests/261576_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe93ba5200dbe0cdc3905a304d97bab7", "thumbnail_srcset": "https://si.imgix.net/1efe811a/requests/261576_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe93ba5200dbe0cdc3905a304d97bab7, https://si.imgix.net/1efe811a/requests/261576_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd79b9f0cfd754dcd635bf3748f086d9 2x, https://si.imgix.net/1efe811a/requests/261576_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=401092447677d842c8c6492f97e5b834 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nI love your artworks. Please draw my OC. Please draw freely.\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/1-TA0pF0dRkRxi3nLAZEuKZJ_oSBxYJKB/view", "created_at": "", "completed_at": ""}, {"path": "/@Lonn0x/works/11", "thumbnail_src": "https://si.imgix.net/9571d3ec/requests/222483_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f822d0ff9ba70624b88c3194408be09a", "thumbnail_srcset": "https://si.imgix.net/9571d3ec/requests/222483_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f822d0ff9ba70624b88c3194408be09a, https://si.imgix.net/9571d3ec/requests/222483_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0366bec2b64030404c7ec4e0827945fc 2x, https://si.imgix.net/9571d3ec/requests/222483_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=769ff