0&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59cbff11f5a055057e491e46bb151bd0", "thumbnail_srcset": "https://si.imgix.net/8383bbe2/uploads/origins/0183afa4-fbd9-413e-9144-c6952c4f2b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59cbff11f5a055057e491e46bb151bd0, https://si.imgix.net/8383bbe2/uploads/origins/0183afa4-fbd9-413e-9144-c6952c4f2b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53f400324762a339c5737abd1dc2db44 2x, https://si.imgix.net/8383bbe2/uploads/origins/0183afa4-fbd9-413e-9144-c6952c4f2b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76a0e3bb49276889030d191010b76630 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@go_odbreakfast/works/19", "thumbnail_src": "https://si.imgix.net/1047af17/uploads/origins/0ca12c34-efbd-4849-8291-9c19b8832e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46dd07611f4915b58b9693d4623b21ad", "thumbnail_srcset": "https://si.imgix.net/1047af17/uploads/origins/0ca12c34-efbd-4849-8291-9c19b8832e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46dd07611f4915b58b9693d4623b21ad, https://si.imgix.net/1047af17/uploads/origins/0ca12c34-efbd-4849-8291-9c19b8832e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e809ba7bd68d7fe9588537b37779575 2x, https://si.imgix.net/1047af17/uploads/origins/0ca12c34-efbd-4849-8291-9c19b8832e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5c8c891ef0005e1adb8d477dc0767a4 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nKipperさんのコミカルで可愛げに溢れたユニークなイラストの大ファンです！！！\n\nこの度は私と友人のOCのカップリングイラストをお願いしたく、リクエストを送らせていただきました。(友人にもリクエストの許可をいただいております！)\n\nノッポでさえないひねくれ者コメディアンと、グラマスで心穏やかな優しい占い師の男女カップルになります。\n過去に一度お互いに未練がある状態で別れましたが、数年後にとある劇団で再会したことをきっかけに少しずつ歩み寄り復縁した、という経緯があります。\nですので、♡甘々イチャイチャ♡な雰囲気で描いていただけますとたいへんうれしいです…！！\n\nぜひよろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/12ph33b75GyVP6LVUYrdKCeQOb3tJMQUS?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@go_odbreakfast/works/18", "thumbnail_src": "https://si.imgix.net/7725f138/uploads/origins/3946df2b-c211-4651-b9d2-077e056b4940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba132d95734dde0f568301d6d82a664", "thumbnail_srcset": "https://si.imgix.net/7725f138/uploads/origins/3946df2b-c211-4651-b9d2-077e056b4940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba132d95734dde0f568301d6d82a664, https://si.imgix.net/7725f138/uploads/origins/3946df2b-c211-4651-b9d2-077e056b4940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9645e3f10abe605e31c857e0e2d36667 2x, https://si.imgix.net/7725f138/uploads/origins/3946df2b-c211-4651-b9d2-077e056b4940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1beebec846e28f150e147860482d6f4c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お世話になります。\nᴋɪᴘᴘᴇʀ ɢᴏᴏᴅʙʀᴇᴀᴋғᴀsᴛ様のイラストを拝見させていただきました。\nカートゥーンチックかつ、心情や表情が事細かに感じ取れる絵柄、とても良いと思いましたため是非とも依頼をさせていただきたくご連絡差し上げました。\n\nまずイラストの使用用途として2つありまして\n①SNSのアイコンとして使わせていただきたいこと\n②私はキャラクターを自動車に貼る、世間一般的に言う｢痛車｣というものに乗っているのですが、それに貼るステッカーに本依頼のイラストを使わせていただけたらと考えております。\nステッカーはボックスステッカーという手のひらサイズの長方形のステッカー、或いはこちらは可能性の話ではありますが自動車のボディに貼ることも考えております。\n以上2つの使用目的で本依頼のイラストを使わせていただきたく思います。\n\n・キャラクターモデル\nにじさんじ・健屋花那(すこやかな)\n\n・イメージ\n身体の向きはお任せいたしますが、顔の方向は正面からみて左を向いた構図で描いていただけるようお願いいたします。\nポージングはお任せいたします。\n\n衣装は下記URLの衣装で、表情はダウナーでありながらいたずらっぽくニッとはにかむような表情でお願い致します。\nまた、イラストの背景はお任せいたしますが、ステッカーの制作時にこちらの方で文字やエフェクトを付けさせていただく関係上背景を透過したバージョンも付けていただけると助かります。\n\nお忙しいところと存じ上げつつも依頼させていただくこと、また誠に不躾な要望の依頼であること、大変申し訳ありません。\n何卒ご検討いただきますよう、よろしくお願い申し上げます。\n\nhttps://www.youtube.com/live/4pgLL4ROLqI?si=35CaUdXl1jUGq15Z", "created_at": "", "completed_at": ""}, {"path": "/@go_odbreakfast/works/17", "thumbnail_src": "https://si.imgix.net/644746c5/uploads/origins/0a69d4c4-172a-4256-8b5e-221124022c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5d2d8ec7613869fe1a18afde154c877", "thumbnail_srcset": "https://si.imgix.net/644746c5/uploads/origins/0a69d4c4-172a-4256-8b5e-221124022c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5d2d8ec7613869fe1a18afde154c877, https://si.imgix.net/644746c5/uploads/origins/0a69d4c4-172a-4256-8b5e-221124022c37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e47f4de1dddac1e298e5c22741329b1 2x, https://si.imgix.net/644746c5/uploads/origins/0a69d4c4-172a-4256-8b5e-221124022c37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b01dc61f8ea59f3e36cdec72c117e6ea 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@go_odbreakfast/works/16", "thumbnail_src": "https://si.imgix.net/adad6a39/uploads/origins/d99b0852-1de2-485b-8370-47da0a0b4f73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae520754f70d71792880cdeeb2a3dd41", "thumbnail_srcset": "https://si.imgix.net/adad6a39/uploads/origins/d99b0852-1de2-485b-8370-47da0a0b4f73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&