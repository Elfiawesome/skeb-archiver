ん。\n\nデザインのポイントは眉毛の形、髪も色、目の赤いライン、目の色、ピアスと首の入れ墨です。\n\n可能でしたら彼の相棒のラドナをバックに描いてください。\n\nかっこいい感じでお願いいたします。\nよろしくお願いいたします。\n\nhttps://toyhou.se/20089950.quinton-rey-schaeffer/61676293\nhttps://toyhou.se/20089950.quinton-rey-schaeffer\n\nラドナ\nhttps://toyhou.se/20089950.quinton-rey-schaeffer/103904294\nhttps://toyhou.se/20089950.quinton-rey-schaeffer/gallery#100440826\n\nhttps://toyhou.se/20089950.quinton-rey-schaeffer/61676293", "created_at": "", "completed_at": ""}, {"path": "/@rumnobl/works/14", "thumbnail_src": "https://si.imgix.net/6cb49aaa/uploads/origins/53a88f4f-3dae-4ec2-8c8d-7f6663049d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9c07d0530729328bf4802079db8c5e9", "thumbnail_srcset": "https://si.imgix.net/6cb49aaa/uploads/origins/53a88f4f-3dae-4ec2-8c8d-7f6663049d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9c07d0530729328bf4802079db8c5e9, https://si.imgix.net/6cb49aaa/uploads/origins/53a88f4f-3dae-4ec2-8c8d-7f6663049d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12526bbb7ccc026528c01e5b9282ef2b 2x, https://si.imgix.net/6cb49aaa/uploads/origins/53a88f4f-3dae-4ec2-8c8d-7f6663049d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ea2a9a426eeb9ddf799d082f4e30b96 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rumnobl/works/13", "thumbnail_src": "https://si.imgix.net/ebd7c606/uploads/origins/2c77ae6f-2b26-4f1c-819a-cde00c82c658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb4e2772d671a67747685f594a