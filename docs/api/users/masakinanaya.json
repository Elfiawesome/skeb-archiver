-495d-bec2-e7582534ec3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71d2ac22cf760175a623a13608dcf363", "thumbnail_srcset": "https://si.imgix.net/db283abe/uploads/origins/95cf7d2e-c6f6-495d-bec2-e7582534ec3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71d2ac22cf760175a623a13608dcf363, https://si.imgix.net/db283abe/uploads/origins/95cf7d2e-c6f6-495d-bec2-e7582534ec3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=862ce1b48cbbaa745345b28ffda74b6d 2x, https://si.imgix.net/db283abe/uploads/origins/95cf7d2e-c6f6-495d-bec2-e7582534ec3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bee36008c24f40e92150e74e81f93bd4 3x", "genre": "art", "nsfw": true, "body": "原神の申鶴のおねショタをリクエストします。\n\n・ベッドの上でお互いに全裸\n・対面座位でショタが申鶴の胸を吸い、もう片方の胸を揉みしだく\n・申鶴が腰を振ってあげている\n・ショタは黒髪か茶髪\n・申鶴の胸は原作より大きめに描く\n\nNG\nアヘ顔\nオホ声\n陰毛\n\n出来れば中出しされてる差分もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/158", "thumbnail_src": "https://si.imgix.net/79e443c3/uploads/origins/22578866-54ba-4acc-b37b-831e28dd4648?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01e9f496c80d8264314e1b92e1ece70", "thumbnail_srcset": "https://si.imgix.net/79e443c3/uploads/origins/22578866-54ba-4acc-b37b-831e28dd4648?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01e9f496c80d8264314e1b92e1ece70, https://si.imgix.net/79e443c3/uploads/origins/22578866-54ba-4acc-b37b-831e28dd4648?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=833fb0bde8fde6b09ab56754c105c61c 2x, https://si.imgix.net/79e443c3/uploads/origins/22578866-54ba-4acc-b37b-831e28dd4648?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74e2b3d1908b0d48e8d5e7e2e5dc6ffb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/157", "thumbnail_src": "https://si.imgix.net/5282a9ed/uploads/origins/84f78aae-d0c9-4fc3-81d8-5c485b6a1d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87897365e6a2c10182bcb89fee7d6442", "thumbnail_srcset": "https://si.imgix.net/5282a9ed/uploads/origins/84f78aae-d0c9-4fc3-81d8-5c485b6a1d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87897365e6a2c10182bcb89fee7d6442, https://si.imgix.net/5282a9ed/uploads/origins/84f78aae-d0c9-4fc3-81d8-5c485b6a1d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca5c0e22be49ae1d419f2610994dbf73 2x, https://si.imgix.net/5282a9ed/uploads/origins/84f78aae-d0c9-4fc3-81d8-5c485b6a1d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8faa52bbf49b17dc4e88e5a072441bf7 3x", "genre": "art", "nsfw": true, "body": "はじめまして。うちの子（赤い方、下記資料や過去納品参照ください）のイラストをお願いできますでしょうか。\n\nうちの子が、https://skeb.jp/@masakinanaya/works/24　の様な感じで背後から胸を揉まれつつ犯されて中出しされているイラストをお願いします。\n\nコスチュームは胸と股間部分が破れている感じで、それ以外は着衣のままでお願いします。\n上記イラストみたいに、モブ男は顔が映らない感じでお願いします。\n\n細かい構図や表情はおまかせします。ご検討のほどよろしくお願いします。\n\nhttps://imgur.com/a/1tzAiFJ", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/156", "thumbnail_src": "https://si.imgix.net/99467f6b/uploads/origins/84b3f1f1-624e-4d88-9702-380743b9502c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13a311d84b3bcd2b8ad68b0364f80df7", "thumbnail_srcset": "https://si.imgix.net/99467f6b/uploads/origins/84b3f1f1-624e-4d88-9702-380743b9502c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13a311d84b3bcd2b8ad68b0364f80df7, https://si.imgix.net/99467f6b/uploads/origins/84b3f1f1-624e-4d88-9702-380743b9502c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c08001b612264e2f2832b38ba3b07a78 2x, https://si.imgix.net/99467f6b/uploads/origins/84b3f1f1-624e-4d88-9702-380743b9502c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d3958610bb1536f57dc22980e8e7b97 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/155", "thumbnail_src": "https://si.imgix.net/88c43222/uploads/origins/73ffdced-9cef-46bf-9948-dfe6d52a0b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a61d454d645e959d45d0f96d11244c", "thumbnail_srcset": "https://si.imgix.net/88c43222/uploads/origins/73ffdced-9cef-46bf-9948-dfe6d52a0b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a61d454d645e959d45d0f96d11244c, https://si.imgix.net/88c43222/uploads/origins/73ffdced-9cef-46bf-9948-dfe6d52a0b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2243680ffbccc0732e80014bba085a8 2x, https://si.imgix.net/88c43222/uploads/origins/73ffdced-9cef-46bf-9948-dfe6d52a0b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0b20436a6aca56eeb2ea8eac2c3107c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！コミッションを再開されたのを見かけたので、私のオリジナルキャラクターの新作アートを依頼したいと思いまして。\n\n使用してほしい衣装のスクリーンショットを添付しました。パーカー、ショートパンツ、ロングブーツです。パーカーに「Slut」と書かれた文字も必ず入れてください。胸のサイズは参考画像のように小さく保ってください。作品については、添付したポーズ参考画像のように、壁にもたれかかりながら視聴者を見上げるような構図を希望します。同様の高さの視点とセクシーな表情をお願いします。 参考画像とは異なり、頭部の横に壁に手を当てた「カベドン」ポーズを追加してください。この部分は.psdファイル内で別レイヤーとして作成してください。ショーツ・フーディー・ブーツは全て着用状態とします。背景は路地の壁にしてください。可能であれば別バージョンも希望します。別バージョンではフーディーを上げて胸元を露出させてください。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1roMpPYixXPZCMx8t7SK5G9E60_5VBRET", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/154", "thumbnail_src": "https://si.imgix.net/c1ff7f53/uploads/origins/c95543da-3cde-4a19-8aff-5ff55db5fd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b05af5bc1136a48fa7fb1cd16c04489", "thumbnail_srcset": "https://si.imgix.net/c1ff7f53/uploads/origins/c95543da-3cde-4a19-8aff-5ff55db5fd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b05af5bc1136a48fa7fb1cd16c04489, https://si.imgix.net/c1ff7f53/uploads/origins/c95543da-3cde-4a19-8aff-5ff55db5fd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ad95ca7ce7626797cfa14d1ae1dd4e4 2x, https://si.imgix.net/c1ff7f53/uploads/origins/c95543da-3cde-4a19-8aff-5ff55db5fd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c79c4f914b9506be05a16b3b9f6bd51 3x", "genre": "comic", "nsfw": true, "body": "はじめまして。\nNIKKE関連の素晴らしいイラストの数々を拝見し、リクエストさせていただこうと思いました。\n\n●キャラクター\nD（NIKKE）\n衣装はD:シークレットポリスでお願いします。\n\n●漫画の大まかな流れ\nとある犯罪者の男を取り調べしているDだったが、男は黙秘を続けていた。\nどうにかして口を割らせるため、男がチラチラ見ていたおっぱいを使うことを思いつく。\n\nおもむろに男のズボンを脱がして男性器をとりだし、パイズリで自白を迫る。\n何度も射精させたがそれでも男は口を割らないため、仕方なく最終手段をとることにする。\n\nショーツを脱ぎ捨てて対面座位の体位になり、自白すればSEXをさせてやると囁く。\n男はついに負けを認め、自白と引き換えにそのまま挿入、腰を振り中出しをする。\n\n…というシチュエーションで指揮官とのイメージプレイをする、といった内容でお願いしたいです。\n\n上記はあくまでも大まかな希望ですので、詳細な内容はお任せいたします。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/153", "thumbnail_src": "https://si.imgix.net/4e83c4f3/uploads/origins/f4420edf-0a6b-4f95-9a13-89e77825a3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3820863384feb7235f53fa1232df1231", "thumbnail_srcset": "https://si.imgix.net/4e83c4f3/uploads/origins/f4420edf-0a6b-4f95-9a13-89e77825a3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3820863384feb7235f53fa1232df1231, https://si.imgix.net/4e83c4f3/uploads/origins/f4420edf-0a6b-4f95-9a13-89e77825a3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7df4eec9cfc41a0f31f49fd6303095f 2x, https://si.imgix.net/4e83c4f3/uploads/origins/f4420edf-0a6b-4f95-9a13-89e77825a3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=770d094d29d3f5497f634912dda2ada7 3x", "genre": "art", "nsfw": true, "body": "はじめまして。過去の作品が本当に好きです：\nhttps://skeb.jp/@masakinanaya/works/146\nhttps://skeb.jp/@masakinanaya/works/141\nhttps://skeb.jp/@masakinanaya/works/79\n\n描いて欲しいうちの子の「夜久彩華」です。サキュバスの血を引くバニーガール。彼女はクローンを召喚する能力を持っている。昼間はファッションモデル、夜はバーテンダーとして働き。性格はとてものんびりしていて、面倒見がよく、自由奔放なお姉さんのよう。パーソナルスペースの感覚がなく、自分でも気づかないうちに人をからかっていることもある。スケベです。彼女ではほとんどの男性に対して主導権を握り支配するのが好きで、特に相手が可愛らしい場合なら尚更だ。彼女の舌と乳首はピアスをしています。\nチャームポイント: ほくろ、目、口、お尻、脚。\n髪型：彼女の髪型の中から、お好きなものを選んでください。\n\n以下に希望する構図の例を示します。どうぞご自身の興味に沿って彼女を描いてください！\nhttps://drive.google.com/drive/folders/1fAQnvfGim3hIT9oRQJl_Jqnt997MGT_o?usp=sharing\n\n（※参考までに、肌の色はアズールレーンの尾張のような色です）\n（※彼女の体の周りにあるほくろに注目してください）\n（※マスクは外さないようにお願いします）\n（※もし可能な範囲でしたらマスクなし差分をお願いします）\n\nなにか不備などがありましたら再送していただければ幸いです。\n金額が足りない場合はアピールで変更してください。\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/103wqNrtlD3hXS-DIyVYhuzrAbLiXJwHP?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@masakinanaya/works/152", "thumbnail_src": "https://si.imgix.net/d8e9ae64/uploads/origins/54c09b54-19be-49fe-9030-74f9dd182822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2f3bca1fe2bdf4e3b093c03ecb4e9d2", "thumbnail_srcset": "https://si.imgix.net/d8e9ae64/uploads/origins/54c09b54-19be-49fe-9030-74f9dd182822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=