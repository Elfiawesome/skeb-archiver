mgix.net/18bca2c4/uploads/origins/067f5d37-3e4f-4c3a-b704-917bbeb9e3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=356c11f85ba973bdf631ccf70e22638b, https://si.imgix.net/18bca2c4/uploads/origins/067f5d37-3e4f-4c3a-b704-917bbeb9e3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e45b715f38f3c32ddee885efb5f58e8b 2x, https://si.imgix.net/18bca2c4/uploads/origins/067f5d37-3e4f-4c3a-b704-917bbeb9e3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e06959bce505e4e103a6041d5ffa417a 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエスト失礼いたします。\n\nイナズマイレブンのクィールが全裸で蒸れた裸足の両足裏を見せつけてくるイラストをお願いします。\n\n白ソックス差分、黒タイツ差分をお願いいたします。\n\n下記URLはキャラクターの画像を集めたフォルダへのリンクとなります。\nhttps://drive.google.com/drive/folders/151lF6ahmszZWvbz41XazLYcf6YIipwlo?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oborotaka/works/351", "thumbnail_src": "https://si.imgix.net/38f8d221/uploads/origins/e6bec84c-bb05-4fc4-b2bb-39f7d70cd80d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca972aa061285ac870b5869a40d418cf", "thumbnail_srcset": "https://si.imgix.net/38f8d221/uploads/origins/e6bec84c-bb05-4fc4-b2bb-39f7d70cd80d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca972aa061285ac870b5869a40d418cf, https://si.imgix.net/38f8d221/uploads/origins/e6bec84c-bb05-4fc4-b2bb-39f7d70cd80d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36f739bdcddbffd55fb78e51b1807718 2x, https://si.imgix.net/38f8d221/uploads/origins/e6bec84c-bb05-4fc4-b2bb-39f7d70cd80d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7508fea2e9babfb0f66827b75f3b130 3x", "genre": "art", "nsfw": true, "body": "朧雲たかみつ様、ご無沙汰しております。\nまた、フリーザービューナスを描いていただけませんでしょうか。\n\n今回はこんな形で、以前お願いしたI字ポーズの変形のような形となりますが、連環腿を繰り出す構図としてください。\nhttps://imgur.com/a/2OBPEDk\n\n\n今回も、ビューナス以外を透過とした差分を頂けるとありがたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oborotaka/works/350", "thumbnail_src": "https://si.imgix.net/a8e30284/uploads/origins/50388f9d-a05a-448f-b833-65e19e85db05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d29a4873eaef807b8644b6f30b4d879f", "thumbnail_srcset": "https://si.imgix.net/a8e30284/uploads/origins/50388f9d-a05a-448f-b833-65e19e85db05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d29a4873eaef807b8644b6f30b4d879f, https://si.imgix.net/a8e30284/uploads/origins/50388f9d-a05a-448f-b833-65e19e85db05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51c3d005abd9162878218cd37f024398 2x, https://si.imgix.net/a8e30284/uploads/origins/50388f9d-a05a-448f-b833-65e19e85db05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c48b644983bc0504e758afb1a5765979 3x", "genre": "art", "nsfw": true, "body": "こんにちは、リクエスト失礼します。\n今度はガンダムSEED FREEDOMのラクス・クラインのパイロットスーツを着た浜風をまた見たいです。基本的な状況は、彼女が敵に捕らえられ、敵兵に輪姦されるというものです。\n具体的な状況と差分はあなたが自由に決めることができます。私が特に欲しい特別な差分は次のとおりです（可能であれば）：\nヘルメットを脱がされ口の中も犯される差分。\n抵抗する彼女に我慢できなくなった敵は、注射器で薬物を注入し、彼女の精神を快楽に崩壊させる。\n彼女は肉便器にされてそのまま放置された、彼女は精液まみれで、スーツとヘルメットには敵の書き込みやマークが残されている。\nご検討をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oborotaka/works/349", "thumbnail_src": "https://si.imgix.net/a75d4d3a/uploads/origins/e5be18d2-b32a-47d7-a2a4-b9f1317ab3db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a859a298827ff8566bd0e833a0d1bd6", "thumbnail_srcset": "https://si.imgix.net/a75d4d3a/uploads/origins/e5be18d2-b32a-47d7-a2a4-b9f1317ab3db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a859a298827ff8566bd0e833a0d1bd6, https://si.imgix.net/a75d4d3a/uploads/origins/e5be18d2-b32a-47d7-a2a4-b9f1317ab3db?bg=%23fff&auto=format%2Ccom