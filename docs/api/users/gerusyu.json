6-4a1d-9f72-81aa2f109cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b595b3b8df6ef2ac0879eaac5aa1a5e 2x, https://si.imgix.net/3edde0bc/uploads/origins/04ce5a15-1936-4a1d-9f72-81aa2f109cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90e7c779ed3137c32720b39701b99e09 3x", "genre": "art", "nsfw": false, "body": "こんにちは＾＾また依頼させてください\n\n前回描いていただいた絵、とてもよかったです (https://skeb.jp/@gerusyu/works/70)\n私のアンティラモンとアンティラモンの足のシーンを描いていただけませんか？\nどちらのキャラクターもその写真では幸せそうに見えるでしょう^^。\nhttps://imgur.com/a/GuWklUY。\n\nありがとうございます！^^", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/79", "thumbnail_src": "https://si.imgix.net/b7bd9f33/uploads/origins/97f7be59-1676-4848-9c7d-b03dd05d62d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c812847a8b04bbb1270c0b54fbe09f3", "thumbnail_srcset": "https://si.imgix.net/b7bd9f33/uploads/origins/97f7be59-1676-4848-9c7d-b03dd05d62d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c812847a8b04bbb1270c0b54fbe09f3, https://si.imgix.net/b7bd9f33/uploads/origins/97f7be59-1676-4848-9c7d-b03dd05d62d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fda56c76eac8d6f70383a9d9a68d2707 2x, https://si.imgix.net/b7bd9f33/uploads/origins/97f7be59-1676-4848-9c7d-b03dd05d62d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d99bf07fe5cf67afcae9b1aea0994850 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/78", "thumbnail_src": "https://si.imgix.net/b7227410/uploads/origins/16d365e2-aacb-412c-ae51-f6d4ecf88899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116636e663eac9ccaeaf9e2d4a9d01ad", "thumbnail_srcset": "https://si.imgix.net/b7227410/uploads/origins/16d365e2-aacb-412c-ae51-f6d4ecf88899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116636e663eac9ccaeaf9e2d4a9d01ad, https://si.imgix.net/b7227410/uploads/origins/16d365e2-aacb-412c-ae51-f6d4ecf88899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dadc3ada75c6cf996568a0cc23d8fd7d 2x, https://si.imgix.net/b7227410/uploads/origins/16d365e2-aacb-412c-ae51-f6d4ecf88899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b100381c2f4629fefe878a3a38da7c5 3x", "genre": "art", "nsfw": true, "body": "先生、またまたこんにちは！前回描いていただいたイラストがとても気に入ったので、続編をお願いしたくなりました！ビール子ちゃんとサクヤちゃんのロマンチックなラブラブアートをもう一枚お願いします！今回は役割が逆で、ビール子ちゃんがサクヤちゃんを仰向けにしています。ベエル子は咲耶のクリトリスとアソコを撫でながら、露出した咲耶の乳房に愛おしそうに吸い付き、咲耶門は力強いオーガズムになすすべもなく身を委ねている。前回同様、二人とも、あなたの描く得意な大きくて重い乳房にしてほしい！\n\n参考までに昔描いていただいた作品（https://skeb.jp/@gerusyu/works/45）へのリンクを貼っておきます。お忙しい中、ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/77", "thumbnail_src": "https://si.imgix.net/08a0ee63/uploads/origins/35abe189-a38d-48ca-88ae-a6c6d0fda5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24822c2d4244b20daa6673d80a9a3a65", "thumbnail_srcset": "https://si.imgix.net/08a0ee63/uploads/origins/35abe189-a38d-48ca-88ae-a6c6d0fda5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24822c2d4244b20daa6673d80a9a3a65, https://si.imgix.net/08a0ee63/uploads/origins/35abe189-a38d-48ca-88ae-a6c6d0fda5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cec8d8392a55c4587cbc34c5655c8a45 2x, https://si.imgix.net/08a0ee63/uploads/origins/35abe189-a38d-48ca-88ae-a6c6d0fda5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e257220a4dabc9ceeb1551e8df62671 3x", "genre": "art", "nsfw": true, "body": "イラスト拝見しました！私からも壁尻イラストのリクエストは可能でしょうか！\n【キャラクター】\nオファニモン　ベルスターモン　ライラモン　リリモン\n天野ネネ　メルヴァモン　陽ノ本アカリ\nウェヌスモン　クイーンチェスモン\n組み合わせはどのキャラ同士でも構いませんので上記の中から2人お願いします。\n壁尻の参考\nhttps://www.pixiv.net/artworks/119701709\nhttps://skeb.jp/@haisin1000_/works/17\nモニター型か\nhttps://www.pixiv.net/artworks/87060843\nhttps://www.pixiv.net/artworks/73718835\nみたいに尻と顔で別れてるパターンどちらでもいいので\n顔が見える構図で犯されるイラストをお願いします\n\n\n・尻側は腰から下が全部出てるようにお願いします、腕も出てると嬉しいです\n・顔側はには何もしないでほしいです(フェラ、乳揉み等)\n・アナルを犯してほしいです\n・襲撃され目が覚めたら突然壁尻状態になっている的な感じで\n・なるべく着衣だと嬉しいです\n\n\n\n可能であれば下記要素をお願いします\nhttps://x.com/KittyShinobi/status/1855235194082763052\n・このイラストが壁尻イラストで1番好きなので参考にしていただけると幸いです。\n・上記URLイラストの様に絶頂後は思い切り内股になり震える。\n・中に出された精液等を噴射\n・『本日の中出し回数〇回 アナル〇回』 『設置後〇日』 『本日の絶頂〇回 』累計バージョンだったりのようなデータ表示。\n・デカ尻で！\n\n上記はマニアックな内容なのでひとつも無くても大丈夫です、可能であればお願いします", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/76", "thumbnail_src": "https://si.imgix.net/76ce5519/uploads/origins/b3aa2f39-f022-49d1-9d98-b8672f60d0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5141a7cdeb84bcc043ff76ae680f0467", "thumbnail_srcset": "https://si.imgix.net/76ce5519/uploads/origins/b3aa2f39-f022-49d1-9d98-b8672f60d0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5141a7cdeb84bcc043ff76ae680f0467, https://si.imgix.net/76ce5519/uploads/origins/b3aa2f39-f022-49d1-9d98-b8672f60d0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb0b6d59464240853a6af49e46ea142 2x, https://si.imgix.net/76ce5519/uploads/origins/b3aa2f39-f022-49d1-9d98-b8672f60d0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc6302b2489d839c3b876472f71b4ebb 3x", "genre": "art", "nsfw": true, "body": "デジモンが搾乳家畜にされてしまうイラストをお願いしたいです。\n\n■キャラクター：以下のデジモンからおまかせでお願いします。シスタモンの場合は全員覚醒状態でお願いします。\n・各種シスタモン（覚醒)\n・ベルスターモン\n・リリスモン\n・フェアリモン\n\n■シチュエーション\n女性型デジモンのミルクから高エネルギーが採れるとわかり強力な女性デジモン達が拘束され搾乳機で24時間搾乳されながら犯されている。\nそこに新たに捕獲された家畜が連れてこられた。\n\n■流れ\n・『くっこんなことしてただじゃおかないわよ』『皆を解放しなさい！』等\n・搾乳機を付けられ注射をうたれる\n・胸が大きくなる\n・『さぁしっかり乳出せ！』と犯される。\nここからは下記の3パターンからどれかお願いします。\n■A\n・犯され少し母乳が出るも、出が悪いと乱暴に犯される。\n・ピストンを感じながら必死に耐えている\n・激しいピストンに耐えているも母乳の量が少し増える\n・中出しされイってしまう\n\n■B\n・犯されても乳が出ず、『おいおい！もう1発いっとくか！』と追加で注射をうたれて犯される。\n・追加の注射で感度がさらに上がってしまい感じながら必死に耐えているも激しいピストンに母乳が出始める。\n・中出しされイってしまい母乳が溢れ出す。\n\n■C\n・挿入する前から既に母乳がでている。\n『おっ搾乳家畜の才能あるなｗ』\n・犯され母乳がしっかりでる。\n・激しいピストンに耐えているも母乳がどんどん出て感じてしまう。\n・中出しされイってしまい母乳が溢れ出す。\n\n■お願い\n・強力なデジモン達なので直ぐに快楽堕ちせず強気に抵抗してるも感じてしまう、といった雰囲気でお願いします。\n・犯すのはアナルかお〇んこかはお任せします。\n・竿役デジモンもお任せします。\n・下記URLのような感じでバックでお願いします。\nhttps://www.pixiv.net/artworks/112467981\nhttps://www.pixiv.net/artworks/70536729\nhttps://www.pixiv.net/artworks/99508289", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/75", "thumbnail_src": "https://si.imgix.net/c9bdec88/uploads/origins/be5d3066-7b3d-4b99-91b9-865c2bad3962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76e3dba3f19ea50a6a410a06f1fc0798", "thumbnail_srcset": "https://si.imgix.net/c9bdec88/uploads/origins/be5d3066-7b3d-4b99-91b9-865c2bad3962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76e3dba3f19ea50a6a410a06f1fc0798, https://si.imgix.net/c9bdec88/uploads/origins/be5d3066-7b3d-4b99-91b9-865c2bad3962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c717d83271a965c56a1ad875fbaa9a08 2x, https://si.imgix.net/c9bdec88/uploads/origins/be5d3066-7b3d-4b99-91b9-865c2bad3962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2211ed46c50ba4112c420ea24e4332ce 3x", "genre": "art", "nsfw": false, "body": "エクスブイモンとテイルモンのイラストをお願いします。\n\n◆シチュエーション\nテイルモンがエクスブイモンの肩の上に乗せてもらい、エクスブイモンの頬にキスしているところ\n\n◆備考\nテイルモンは両目を閉じていて、エクスブイモンはキスされている頬の側の目を閉じて少し照れている様子です。\n\n以上、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/74", "thumbnail_src": "https://si.imgix.net/2046a909/uploads/origins/c55fc31d-be8d-4056-8cfe-b900d8f0f8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb3eddf7451e4ffe01b78b8f46e7aad", "thumbnail_srcset": "https://si.imgix.net/2046a909/uploads/origins/c55fc31d-be8d-4056-8cfe-b900d8f0f8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb3eddf7451e4ffe01b78b8f46e7aad, https://si.imgix.net/2046a909/uploads/origins/c55fc31d-be8d-4056-8cfe-b900d8f0f8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c30531d7845b7523fae9f012a5257cbc 2x, https://si.imgix.net/2046a909/uploads/origins/c55fc31d-be8d-4056-8cfe-b900d8f0f8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd31d3225297cfd76cfa52f963806c2d 3x", "genre": "art", "nsfw": true, "body": "また会ったね！\n\n私の強いバイカー・ガールの涼子の淫らなイメージが欲しいです。バイザーを開けてヘルメットをかぶってもらったらユニークで面白いかなと思って。\n\nそれ以外はとても熱血な女性なので、どんなシチュエーションで登場させるのか見てみたいです！\n\nhttps://drive.google.com/drive/folders/1GVEQEaDqFFUWVMTfk5tqJFtMFKiOfBNE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/73", "thumbnail_src": "https://si.imgix.net/c9ee7c89/uploads/origins/d8a29378-80fc-4ba9-9100-c94fde2e138a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8da5ce2f6c68a39c84d8924e073bfd9", "thumbnail_srcset": "https://si.imgix.net/c9ee7c89/uploads/origins/d8a29378-80fc-4ba9-9100-c94fde2e138a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8da5ce2f6c68a39c84d8924e073bfd9, https://si.imgix.net/c9ee7c89/uploads/origins/d8a29378-80fc-4ba9-9100-c94fde2e138a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=199ba853852640dc6e6205fb53f51b1d 2x, https://si.imgix.net/c9ee7c89/uploads/origins/d8a29378-80fc-4ba9-9100-c94fde2e138a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28bf85891e8aec6691ffa0b28ce8d9e8 3x", "genre": "art", "nsfw": true, "body": "私の友人のフォックスボーイのOCを、提供された参考資料のようにアンジュウォモンと一緒に描いていただけませんか？フェムドムのシチュエーションで、彼女は彼の生意気さにうんざりして彼を足でロックし、彼が彼女の中に入ってキスをしようとすると、彼女は彼が彼女の中でクンクンしている間、まだ許されないと言って彼を止めるために指を使います。また、彼女には参考文献にあるような表情をしてもらいたい。彼は全裸で、彼女は部分的に服を着ている。\n\n\nポーズ\nhttps://drive.google.com/file/d/1NSZODid4LGg3L2629DdLKQzTQin9cEY3/view?usp=sharing\n\nOC\nhttps://drive.google.com/file/d/1Nrw7WV8Z91CmdDwkh2nW2eCXBRsQzZol/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/72", "thumbnail_src": "https://si.imgix.net/bc6d4cb0/uploads/origins/436cfa2a-2dca-4ef2-9fe2-f0eade4c193b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b1f57cb452443e3d6dbdc1ff0a4d3b", "thumbnail_srcset": "https://si.imgix.net/bc6d4cb0/uploads/origins/436cfa2a-2dca-4ef2-9fe2-f0eade4c193b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b1f57cb452443e3d6dbdc1ff0a4d3b, https://si.imgix.net/bc6d4cb0/uploads/origins/436cfa2a-2dca-4ef2-9fe2-f0eade4c193b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdeb7f4ff1e1125881054cde7a0651d9 2x, https://si.imgix.net/bc6d4cb0/uploads/origins/436cfa2a-2dca-4ef2-9fe2-f0eade4c193b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c1820b9a0ffd7ffb6cd10f5de19dea5 3x", "genre": "art", "nsfw": true, "body": "おはようございます！乳輪と乳首がのぞくには小さすぎるトップスを着て、乳房を顔に押しつけながら、鋭利な歯を持つ大きくて幸せそうなビール子に抱っこされているOCの絵をリクエストしたい。\n\nOC: https://drive.google.com/file/d/12jMKA7Wmw1zPc1b2BUhfkMsjT-o1xXJi/view?usp=sharing\nビール子：https://drive.google.com/file/d/14SAjfN7hJuYE_w-q1PBj0affFQ9trqqU/view?usp=drive_link\nポーズ：https://drive.google.com/file/d/1WkpzxHrl3u8ZpXHs1MXPrSiXCFyHuN8s/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@gerusyu/works/71", "thumbnail_src": "https://si.imgix.net/64c3494d/uploads/origins/8809fd4f-1774-426c-bdaf-65d57c8104cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77ebd003ee45746f52bfd3da63db75c", "thumbnail_srcset": "https://si.imgix.net/64c3494d/uploads/origins/8809fd4f-1774-426c-bdaf-65d57c8104cf?bg=%23fff&auto=format%2Ccom