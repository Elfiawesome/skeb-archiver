ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ed79b930d1ba6924f2a678b564cd8e5 2x, https://si.imgix.net/7c653fb1/uploads/origins/82b8211c-5407-48ce-b851-e0b419c3a6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7254e4825dafd0bf384e0e66a3e20b7 3x", "genre": "art", "nsfw": true, "body": "鎧真伝のナスティと美麗が相互手コキして、二人で勢いよく射精しているフタナリイラストをお願いします。\n二人とも玉有り。美麗は仮想空間での制服姿で胸と下半身丸出し、ナスティは全裸でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aoimanabu/works/473", "thumbnail_src": "https://si.imgix.net/ddb278a2/uploads/origins/ee580345-5385-4b93-82dc-18cc1440718b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1186933f1d748076497edca68f036cdd", "thumbnail_srcset": "https://si.imgix.net/ddb278a2/uploads/origins/ee580345-5385-4b93-82dc-18cc1440718b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1186933f1d748076497edca68f036cdd, https://si.imgix.net/ddb278a2/uploads/origins/ee580345-5385-4b93-82dc-18cc1440718b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae59aedcb154bfd8adcfb21ac6759707 2x, https://si.imgix.net/ddb278a2/uploads/origins/ee580345-5385-4b93-82dc-18cc1440718b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c057ff9d1bbcf9d7638fe2c141b9d3d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aoimanabu/works/472", "thumbnail_src": "https://si.imgix.net/e769fcff/uploads/origins/0b036db2-65b1-43ac-a663-3c3c34cb3e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f01b19791f7b93dd331fcbcba04c132c", "thumbnail_srcset": "https://si.imgix.net/e769fcff/uploads/origins/0b036db2-65b1-43ac-a663-3c3c34cb3e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f01b19791f7b93dd331fcbcba04c132c, https://si.imgix.net/e769fcff/uploads/origins/0b036db2-65b1-43ac-a663-3c3c34cb3e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c5a959cf03bb0ecf2031341209294b4 2x, https://si.imgix.net/e769fcff/uploads/origins/0b036db2-65b1-43ac-a663-3c3c34cb3e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f396406675cdf47439e804fae9c57246 3x", "genre": "art", "nsfw": true, "body": "TOD2のザコキャラのバンデットでリクエストです。\n\n以前描いていただいたプリースト（https://skeb.jp/@aoimanabu/works/165）のように、腋とザコキャラにやられてしまうシチュがとても好きなので複数カット形式でお願いしたいです。\n\n・戦闘中に蒸れた腋を見せつけられ誘惑。\n（https://skeb.jp/@aoimanabu/works/90）の左上のカットのようなイメージ。\n\n・腋につられて近づいてしまい、腋に顔を抱え込まれて匂いを嗅がされる。\n（https://skeb.jp/@aoimanabu/works/197）の下のカットのような状態。\n\n・さらに体勢を変え、（https://skeb.jp/@aoimanabu/works/135）の下のカットのような状態（腕は後頭部に回されてがっちりと抱え込まれている）で腋の匂いを無理やり嗅がされながら手コキをされフィニッシュ。\n\n適宜擬音や煽っているセリフを入れていただきたいです。\n\n竿役はマネキンのようなモブでお願いします。\n\nカラーでお願いしたいです。\n\nhttps://dic.pixiv.net/a/%E3%83%90%E3%83%B3%E3%83%87%E3%83%83%E3%83%88%28TOD2%29", "created_at": "", "completed_at": ""}, {"path": "/@aoimanabu/works/471", "thumbnail_src": "https://si.imgix.net/08153491/uploads/origins/622524f8-ff3f-4dbb-93bb-1deefe4d37d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aacfd7113e452dcb7abe58ac3e0d553", "thumbnail_srcset": "https://si.imgix.net/08153491/uploads/origins/622524f8-ff3f-4dbb-93bb-1deefe4d37d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aacfd7113e452dcb7abe58ac3e0d553, https://si.imgix.net/08153491/uploads/origins/622524f8-ff3f-4dbb-93bb-1deefe4d37d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0f0e903910585dcfcd0a15ba5c70e1b 2x, https://si.imgix.net/08153491/uploads/origins/622524f8-ff3f-4dbb-93bb-1deefe4d37d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df353d5de9a9c67cf6d716c8bc21909c 3x", "genre": "art", "nsfw": true, "body": "鎧真伝のナスティが美麗に挿入して、二人で勢いよく射精しているフタナリイラストをお願いします。\n二人とも裸で玉有り。しっかり挿入しているのがわかるアングル希望です。", "created_at": "", "completed_at": ""}, {"path": "/@aoimanabu/works/470", "thumbnail_src": "https://si.imgix.net/668f03b3/uploads/origins/c1615c27-5859-4245-a4ef-3c77ebe0cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34898d8137cb81b91d5395773e371886", "thumbnail_srcset": "https://si.imgix.net/668f03b3/uploads/origins/c1615c27-5859-4245-a4ef-3c77ebe0cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34898d8137cb81b91d5395773e371886, https://si.imgix.net/668f03b3/uploads/origins/c1615c27-5859-4245-a4ef-3c77ebe0cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96c500c1ceafff77ffde042c994c7408 2x, https://si.imgix.net/668f03b3/uploads/origins/c1615c27-5859-4245-a4ef-3c77ebe0cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e80dc10cd82a35d15dff1f1a2b71c6c6 3x", "genre": "art", "nsfw": true, "body": "サイキックフォース2012のウェンディーが脇見せポーズでビスチェがペロンとめくれて胸が露出しているのをバストアップでお願いします\n胸はかなり大き目でビスチェがめくれてびっくりしている顔で", "created_at": "", "completed_at": ""}, {"path": "/@aoimanabu/works/469", "thumbnail_src": "https://si.imgix.net/15f8ddf3/uploads/origins/7a323b5d-c05c-4d67-9121-a109bb40621b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68d8a4a343b4734c32eb527cd66e348a", "thumbnail_srcset": "https://si.imgix.net/15f8ddf3/uploads/origins/7a323b5d-c05c-4d67-9121-a109bb40621b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68d8a4a343b4734c32eb527cd66e348a, https://si.imgi