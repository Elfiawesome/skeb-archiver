789b/uploads/origins/6af4e121-adce-4d3f-8ac6-e2d782cea0a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf26abe361beda6ab342c59623bbb479 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sasoriextract/works/16", "thumbnail_src": "https://si.imgix.net/0334ed96/uploads/origins/3444c2ff-71e5-4c75-af64-f9033656f4c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe5d5fc5138d206017bd6783dd3a7ea6", "thumbnail_srcset": "https://si.imgix.net/0334ed96/uploads/origins/3444c2ff-71e5-4c75-af64-f9033656f4c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe5d5fc5138d206017bd6783dd3a7ea6, https://si.imgix.net/0334ed96/uploads/origins/3444c2ff-71e5-4c75-af64-f9033656f4c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a90a0e9bcc74ac3b12b2abe7af8d9bf4 2x, https://si.imgix.net/0334ed96/uploads/origins/3444c2ff-71e5-4c75-af64-f9033656f4c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e4996552f36bdc5a9a2e1be15aefb6c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nまたアヤナを描いてほしいんだ。\nこのビキニの服を着てほしい。\nhttps://www.deviantart.com/stash/0oubaqzcicf\nhttps://www.deviantart.com/stash/0rzff6kh1fz\n\n彼女のポーズ、キュートでセクシーなポーズを自由に創造してください。", "created_at": "", "completed_at": ""}, {"path": "/@sasoriextract/works/15", "thumbnail_src": "https://si.imgix.net/ecfe8ed0/uploads/origins/59d42209-59de-4eda-9cde-c685b5b2feac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e65edd8afa69080be3e36d6177c05784", "thumbnail_srcset": "https://si.imgix.net/ecfe8ed0/uploads/origins/59d42209-59de-4eda-9cde-c685b5b2feac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e65edd8afa69080be3e36d6177c05784, https://si.imgix.net/ecfe8ed0/uploads/origins/59d42209-59de-4eda-9cde-c685b5b2feac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48d386c9c0539564bd4f97940b04d8fe 2x, https://si.imgix.net/ecfe8ed0/uploads/origins/59d42209-59de-4eda-9cde-c685b5b2feac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b32dd4c6eface2fb75a6a0ced96e0c7f 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\n前回はとても素晴らしい作品をありがとうございました。\n本当にご依頼してよかったと心から思いました。\n\nまた似たような題材で恐縮なのですが\n自分の代理キャラの「ゆうき」\n（https://www.pixiv.net/artworks/115836037）を\n\n街歩き用の私服(サソリEXさんにおまかせ）\n　・表情はメスガキっぽく\nスケベ衣装（サソリEXさんにおまかせ）\n　・表情は照れ、赤面\n\nの2パターンで描いていただきたいです。\n\n（一応、流れとしましてはこんな衣装着れないだろと煽られて\n　着てみた結果、予想以上にスケベで照れてる感じで）\n\n\n衣装に合わせて髪型や小物などアレンジしていただいて\n大丈夫です。\n\n\n似たようなご依頼かつ、コーデまでお任せに\nなってしまいますが描いていただければ嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@sasoriextract/works/14", "thumbnail_src": "https://si.imgix.net/addce2a5/uploads/origins/eef9c261-b2cb-47b6-ae68-c3d1242243fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b1ede83a9b6b6164ae73843885b2c7", "thumbnail_srcset": "https://si.imgix.net/addce2a5/uploads/origins/eef9c261-b2cb-47b6-ae68-c3d1242243fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b1ede83a9b6b6164ae73843885b2c7, https://si.imgix.net/addce2a5/uploads/origins/eef9c261-b2cb-47b6-ae68-c3d1242243fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb1e151b24822b0fb81e1d6d714321d8 2x, https://si.imgix.net/addce2a5/uploads/origins/eef9c261-b2cb-47b6-ae68-c3d1242243fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51dcf700ba75a82bc81843708dc0816b 3x", "genre": "art", "nsfw": false, "body": "こんにちは。またアヤナと僕を描いてほしいんだ。\n彼女は服を着る。パステルパープルのベレー帽、パステルパープルのスカーフ、胸の谷間が切り取られたストライプのシャツ、ペンシルスカート。\nhttps://sta.sh/0150z3peobv1\n私の私服の創作は自由です。\n\n私たちのポーズでは、二人でロマンチックにチョコレートをシェアする予定。", "created_at": "", "completed_at": ""}, {"path": "/@sasoriextract/works/13", "thumbnail_src": "https://si.imgix.net/ad03dcda/uploads/origins/d0fde204-461c-47a8-95fa-459fe8580c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0dd931038cd51e2adf9ebc6aa8b5ce", "thumbnail_srcset": "https://si.imgix.net/ad03dcda/uploads/origins/d0fde204-461c-47a8-95fa-459fe8580c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0dd931038cd51e2adf9ebc6aa8b5ce, https://si.imgix.net/ad03dcda/uploads/origins/d0fde204-461c-47a8-95fa-459fe8580c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ea0f02a382ca9bf2f28ebaa7f38a2eb 2x, https://si.imgix.net/ad03dcda/uploads/origins/d0fde204-461c-47a8-95fa-459fe8580c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1661b0765d0b4f20991fcc33531610cd 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n私のOCのイラストをお願い出来ますか？\n内容はお任せしますがお酒が好物なので飲酒している様子だと嬉しいです。\n\nhttps://skeb.jp/@Fyoshihiko01/works/2", "created_at": "", "completed_at": ""}]}