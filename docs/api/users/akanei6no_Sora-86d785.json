{"screen_name": "akanei6no_Sora", "file": "akanei6no_Sora-86d785", "name": "夜坂よる", "avatar_url": "https://pbs.twimg.com/profile_images/1993966917762293760/5h0agA-w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1598872816560246784/1764233703/1500x500", "description": "Skeb→https://skeb.jp/@akanei6no_Sora", "total_works": 60, "scraped_works": 30, "first_seen": "2025-09-14T03:10:30.820347+00:00", "last_updated": "2026-03-08T01:29:36.227542+00:00", "price_history": {"art": [{"amount": 16000, "recorded_at": "2025-09-14T11:10:30.820347"}, {"amount": 12000, "recorded_at": "2025-09-27T00:58:06.427569"}, {"amount": 15000, "recorded_at": "2026-02-14T18:37:17.360468+00:00"}]}, "current_prices": {"art": 15000}, "price_range": {"art": {"min": 12000, "max": 16000}}, "links": [{"label": "Twitter", "url": "https://x.com/akanei6no_Sora", "name": "akanei6no_Sora"}, {"label": "Misskey_io", "url": "https://misskey.io/@yoru_akane", "name": "yoru_akane"}, {"label": "Website", "url": "https://lit.link/Akanei6", "name": ""}], "flags": {"from_archive": true}, "acceptable": true, "works": [{"path": "/@akanei6no_Sora/works/60", "thumbnail_src": "https://si.imgix.net/496de858/uploads/origins/98b6ba82-4658-4238-a053-64a1b29c296c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32ad0bbec2175711f6fb0ac3ff1c50e", "thumbnail_srcset": "https://si.imgix.net/496de858/uploads/origins/98b6ba82-4658-4238-a053-64a1b29c296c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32ad0bbec2175711f6fb0ac3ff1c50e, https://si.imgix.net/496de858/uploads/origins/98b6ba82-4658-4238-a053-64a1b29c296c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5c36c684e220795fef25065d548abdc 2x, https://si.imgix.net/496de858/uploads/origins/98b6ba82-4658-4238-a053-64a1b29c296c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f92731925bf5e54bd776e38c59ff1de 3x", "genre": "art", "nsfw": false, "body": "夜坂よるさん、初めまして。\nペスチと申します！\n\nskebで夜坂よるさんの作品を拝見しており、\n人物の表情や雰囲気の描写がとても素敵で、\nぜひお願いしたいと思いリクエストを送らせていただきました。\n\nもし可能であれば、私のオリジナルキャラクターに打撲跡がある状態のシーンを描いていただきたいです。\n外見や設定、参考衣装などはすべてこちらのGoogle Driveにまとめておりますので、\nご確認いただけますと幸いです。\n\n【依頼内容】\n・ポーズ・表情・構図など、すべて夜坂よるさんの自由な発想にお任せしたいです。\n・複数の衣装参考がありますが、描きたいものを自由に選んでいただいて大丈夫です。\n・見えない部分の補完やアレンジも自由にしていただいて問題ありません。\n\n【用途】\n・個人使用\n・他のリクエストやコミッションの参考資料としての使用\n・SNSでの投稿、アイコン、ヘッダー\n※収益目的では使用いたしません\n\nもし内容が難しい場合やイメージが湧きにくい場合は、\nキャンセルしていただいてもまったく問題ありません。\nお引き受けいただけましたらとても嬉しいです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1yNx51RJirMQ-TRol30rD0HD8AEnMr3QJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@akanei6no_Sora/works/59", "thumbnail_src": "https://si.imgix.net/052505b9/uploads/origins/655e001a-3c37-49be-a16a-d55f19bbf266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0e3d542c69e1d979dd6f974b971f3cb", "thumbnail_srcset": "https://si.imgix.net/052505b9/uploads/origins/655e001a-3c37-49be-a16a-d55f19bbf266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0e3d542c69e1d979dd6f974b971f3cb, https://si.imgix.net/052505b9/uploads/origins/655e001a-3c37-49be-a16a-d55f19bbf266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b777554fbd2c970ad20b4628e98f58e0 2x, https://si.imgix.net/052505b9/uploads/origins/655e001a-3c37-49be-a16a-d55f19bbf266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f249f1c53b8a807d05db88ee94d86f20 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akanei6no_Sora/works/58", "thumbn