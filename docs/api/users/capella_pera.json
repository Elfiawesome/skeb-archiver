821f-c45b-4b73-8939-0936719ed5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9fdc573ff8825cf53ed57afe5ecc210", "thumbnail_srcset": "https://si.imgix.net/40e45f31/uploads/origins/8ed5821f-c45b-4b73-8939-0936719ed5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9fdc573ff8825cf53ed57afe5ecc210, https://si.imgix.net/40e45f31/uploads/origins/8ed5821f-c45b-4b73-8939-0936719ed5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d47345259ce65cb9a9fa7d2380d2a53a 2x, https://si.imgix.net/40e45f31/uploads/origins/8ed5821f-c45b-4b73-8939-0936719ed5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18a26ee38bf6a2c01f223b3cb5866fdb 3x", "genre": "art", "nsfw": false, "body": "やあ！\n\n僕は君のアートスタイルがとても好きなんだ！どんなポーズや表情でも構いません。チャンスをありがとう！\n\nhttps://drive.google.com/file/d/1LvnKxTVjqsN5GRB6KT7-0z0ZgmH_sdN2/view?usp=sharing\n\nhttps://drive.google.com/file/d/1LvnKxTVjqsN5GRB6KT7-0z0ZgmH_sdN2/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@capella_pera/works/130", "thumbnail_src": "https://si.imgix.net/eba6e722/uploads/origins/40bca6a7-359f-43e4-89f5-f71e7d1c8afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c1ffec5865547e48af0ed4f0d59d8b6", "thumbnail_srcset": "https://si.imgix.net/eba6e722/uploads/origins/40bca6a7-359f-43e4-89f5-f71e7d1c8afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c1ffec5865547e48af0ed4f0d59d8b6, https://si.imgix.net/eba6e722/uploads/origins/40bca6a7-359f-43e4-89f5-f71e7d1c8afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51e9eb3b70792105581a3e6f356976ec 2x, https://si.imgix.net/eba6e722/uploads/origins/40bca6a7-359f-43e4-89f5-f71e7d1c8afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efb26b501ed8b154466fdc72f1784661 3x", "genre": "art", "nsfw": false, "body": "かぺらさんこんにちは！\n\nかぺらさんの絵柄でうちのこのスコンくんが見たいと思い、リ