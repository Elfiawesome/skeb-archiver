89-d9cd6b6a492e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e23e018207bdda8186060ed8d0173517 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nくろもさんのきりたんがかわいいのでリクエストいたします。\n「朝起きたら、東北きりたんがスケベな格好をしていて、エッチな起こし方をしてくれていた」\nというコッショリなイラストをお願いしたいです。\n詳しい内容はお任せします。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@cromoribuden/works/5", "thumbnail_src": "https://si.imgix.net/2b5f717a/uploads/origins/a11cc453-3e24-4619-84d3-7f6f5a1e9f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09ee04284df23e403e836faf426de6a8", "thumbnail_srcset": "https://si.imgix.net/2b5f717a/uploads/origins/a11cc453-3e24-4619-84d3-7f6f5a1e9f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09ee04284df23e403e836faf426de6a8, https://si.imgix.net/2b5f717a/uploads/origins/a11cc453-3e24-4619-84d3-7f6f5a1e9f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cb866c7561580a0b53c750b97a6b6dc 2x, https://si.imgix.net/2b5f717a/uploads/origins/a11cc453-3e24-4619-84d3-7f6f5a1e9f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd3e6c01d0092537a4b831e32f00f112 3x", "genre": "art", "nsfw": false, "body": "晴れ空の下で満面の笑みの紲星あかりをお願いします。\n構図やポーズはお任せで、Twitterや動画での切り抜き以外の加工を伴わない二次使用許可もいただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@cromoribuden/works/4", "thumbnail_src": "https://si.imgix.net/836d5efb/uploads/origins/90f134fb-169a-44fd-9856-397923045f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80049300ddc25c04ae7ba7374158f3fb", "thumbnail_srcset": "https://si.imgix.net/836d5efb/uploads/origins/90f134fb-169a-44fd-9856-397923045f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80049300ddc25c04ae7ba7374158f3fb, https://si.imgix.net/836d5efb/uploads/origins/90f134fb-169a-44fd-9856-397923045f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86a85d4f43a544a994add21a0fc44d11 2x, https://si.imgix.net/836d5efb/uploads/origins/90f134fb-169a-44fd-9856-397923045f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6d376b57c94b4500e5f6f9d32a01258 3x", "genre": "art", "nsfw": false, "body": "（雨に降られて）びしょ濡れになっている結月ゆかりさんのイラストを健全な感じでお願いします。\nまた、可能であればイラストをそのままあるいは一部をクリッピングしてTwitterやニコニコ動画のアイコンとして使用させていただきたいです。", "created_at": "", "completed_at": ""}, {"path": "/@cromoribuden/works/3", "thumbnail_src": "https://si.imgix.net/00746ac7/uploads/origins/3faca5f1-284f-4447-ac8c-ab13306d4643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2502fdf247a2ff3cfe2ef3478a7b0c6d", "thumbnail_srcset": "https://si.imgix.net/00746ac7/uploads/origins/3faca5f1-284f-4447-ac8c-ab13306d4643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2502fdf247a2ff3cfe2ef3478a7b0c6d, https://si.imgix.net/00746ac7/uploads/origins/3faca5f1-284f-4447-ac8c-ab13306d4643?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f867361877605f95f0d93d874a8c4c8c 2x, https://si.imgix.net/00746ac7/uploads/origins/3faca5f1-284f-4447-ac8c-ab13306d4643?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9eaae0ab0642658321bf2abd7db1e91 3x", "genre": "art", "nsfw": false, "body": "染次朗子ちゃんのイラストを何卒よろしくお願い申し上げます。\n内容はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@cromoribuden/works/2", "thumbnail_src": "https://si.imgix.net/5a083652/uploads/origins/da1aa6f0-bad7-4e6e-a258-11d462060453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6083b766be75e1a41aafe65829236f71", "thumbnail_srcset": "https://si.imgix.net/5a083652/uploads/origins/da1aa6f0-bad7-4e6e-a258-11d462060453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6083b766be75e1a41aafe65829236f71, https://si.imgix.net/5a083652/uploads/origins/da1aa6f0-bad7-4e6e-a258-11d462060453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47c7819c4b8103ebf0839ba6ff62c0a3 2x, https://si.imgix.net/5a083652/uploads/origins/da1aa6f0-bad7-4e6e-a258-11d462060453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f579fcc772cad3e32217b2dad9ef457 3x", "genre": "correction", "nsfw": false, "body": "くろもさん\n\nいつもお世話になっております。ららべるです。\n私のイラストにつきまして、どうすればもっと「エモさ」を引き出せるか、アドバイスを頂戴したく依頼申し上げました。\n「アドバイス」ジャンルの使い方として正しいのかどうかわかりませんので、不適当と感じた場合は非承認していただくようお願いします。\n\nアドバイスいただきたいイラストのURLを記載します（pixiv)\nhttps://www.pixiv.net/artworks/93534465\n\n技術的には少しずつ上手くなってきたとは思うのですが、「アイデア」「場面設定」の部分が弱いのではと感じています。\n見た人を惹きつけるようなイラストにするために、どういった点を改善すべきでしょうか。\n難解な内容でも勉強して習得しますので、感じたままに忌憚なきご意見をいただければと思います。\n\n以上です。どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cromoribuden/works/1", "thumbnail_src": "https://si.imgix.net/4866e3e8/uploads/origins/afa946d2-6ed2-4848-be9c-54c9e5b73112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40960ee609abb33476ab01fe91a8533a", "thumbnail_srcset": "https://si.imgix.net/4866e3e8/uploads/origins/afa946d2-6ed2-4848-be9c-54c9e5b73112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40960ee609abb33476ab01fe91a8533a, https://si.imgix.net/4866e3e8/uploads/origins/afa946d2-6ed2-4848-be9c-54c9e5b73112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3acc4fe7b2652c8de54a77ee5e11d2a3 2x, https://si.imgix.net/4866e3e8/uploads/origins/afa946d2-6ed2-4848-be9c-54c9e5b73112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb22336859f1f26b3d18b05ac4f92009 3x", "genre": "art", "nsfw": true, "body": "くろもさん初めまして\nイラストをお願いしたいのですが\n東北きりたんがよく遊んでくれる近所のお兄さんが東北家のお手伝いとかで疲れ果てて縁側でぐっすり昼寝していたので\nつい興味本位でズボンを降ろしておちんちんをまじまじとみながら手で弄ってたら\n寝ているお兄さんがびゅーびゅー射精して顔も手も精液まみれになってしまってビックリ\nみたいなシーンを描いて貰えないでしょうか\n\nよろしくお願いします", "created_at": "", "completed_at": ""}]}