やっと収まった…？おしり拭かなきゃ、きゃっ！おならが…男子トイレであんな音出ちゃうなんて最悪だし恥ずかしい…)で終わりです。 長くなりましたがシーンはこんな感じで、排泄シーンは1枚絵で便器は中まで見えるのと見えないので構図はhttps://www.pixiv.net/artworks/136740009 で服装はhttps://drive.google.com/file/d/1lRa7d2V7WnNxmWXK8LRVfvZIiXECbKhI/view?usp=drivesdk で、スカートは付けたままでパンツは白でアソコが見えるところまでお願いします。何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@IlIlIlIl1133/works/13", "thumbnail_src": "https://si.imgix.net/d32fa7d8/uploads/origins/518c07a2-47cc-40be-9885-6d96e447889b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d691f43c7435e6d8eae023bbe89ead9", "thumbnail_srcset": "https://si.imgix.net/d32fa7d8/uploads/origins/518c07a2-47cc-40be-9885-6d96e447889b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d691f43c7435e6d8eae023bbe89ead9, https://si.imgix.net/d32fa7d8/uploads/origins/518c07a2-47cc-40be-9885-6d96e447889b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d08fd77a93a741ad7f76f1f49f3d79b 2x, https://si.imgix.net/d32fa7d8/uploads/origins/518c07a2-47cc-40be-9885-6d96e447889b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a86935b74081facd0b4deabccf098f69 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@IlIlIlIl1133/works/12", "thumbnail_src": "https://si.imgix.net/b4f123c9/uploads/origins/a51e3aae-e123-42c3-8df8-9b06074170f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7d27fad76d61d0714234d25f312b068", "thumbnail_srcset": "https://si.imgix.net/b4f123c9/uploads/origins/a51e3aae-e123-42c3-8df8-9b06074170f1?bg=%23