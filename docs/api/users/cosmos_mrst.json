が現れます。\nゲームが好きなのは人間と触れ合うことをこれしか知らないから、遊ぶことによって人間を知ろうとしてます。\n好きなものは人と話すこと、かわいいもの\n嫌いなものは独りぼっち、忘れられること\n意外とさみしがり屋でかまってもらえないとすぐ暗くなる不安定な一面もあります。\n\n以上になります。\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/13J2smx6y_ICJWcU2QbVVQ6FIAtc8lBZr/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@cosmos_mrst/works/231", "thumbnail_src": "https://si.imgix.net/e44438c9/uploads/origins/aa8546aa-0627-41b6-bbb4-ac6687855a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d482c38b7389893887449be8e8759b6", "thumbnail_srcset": "https://si.imgix.net/e44438c9/uploads/origins/aa8546aa-0627-41b6-bbb4-ac6687855a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d482c38b7389893887449be8e8759b6, https://si.imgix.net/e44438c9/uploads/origins/aa8546aa-0627-41b6-bbb4-ac6687855a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff0945aaf8531b1562a8bd5dc951e7b 2x, https://si.imgix.net/e44438c9/uploads/origins/aa8546aa-0627-41b6-bbb4-ac6687855a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7adcb436402ef0b49a4fead26c2395ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@cosmos_mrst/works/230", "thumbnail_src": "https://si.imgix.net/12e33e86/uploads/origins/ac3fef1a-a156-43d8-a7c6-079bfb455bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ed0de748ec57c4a07cf393cbee42ad", "thumbnail_srcset": "https://si.imgix.net/12e33e86/uploads/origins/ac3fef1a-a156-43d8-a7c6-079bfb455bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop