%2Ccenter&txtsize=30&txt=PRIVATE&s=dfc43b98f128f744253c25d1ee0f8639 2x, https://si.imgix.net/28dc5610/uploads/outputs/99128330-814a-420a-8809-e7c0699811cb?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91188aba10698bbdd166d4f038f4af0e 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rikusu_vrc/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59dfa1bbe40c31443368a66f64ad82d6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9022e48d9cf5c8b90fd86834f8ed5256 3x", "genre": "voice", "nsfw": false, "body": "rikusuさんこんばんは。\nRenYukiこと雪村錬太郎です。\n今回もボイスの依頼です。\n\n声はママのときの声で。\nシチュエーションは、お風呂に入っていたら、バスタオルを巻いたりくすママが背中を流しに入ってきちゃって、りくすママに一通りからかわれたり洗われたりしたあと、中に水着を着ていたとネタバラシされる感じでお願いします。\nでも中の水着もめっちゃ可愛くてセクシーなので、背中を流される側はそれでも照れちゃって、それをまたからかわれたりする感じで。\n呼び掛けは「お主」とか「主様」みたいな感じののじゃロリに似合いそうな感じで宜しくおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@rikusu_vrc/works/4", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59dfa1bbe40c31443368a66f64ad82d6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9022e48d9cf5c8b90fd86834f8ed5256 3x", "genre": "voice", "nsfw": false, "body": "rikusuさんこんばんは。\nRenYukiこと雪村錬太郎です。\n今回もボイスの依頼です。\n仕事でめっちゃ疲れて帰ってきて、疲れていて眠いはずなのに目ばかり冴えて深夜まで眠れない時用の、寝かしつけDOKIDOKI添い寝ボイスをお願いします。\n声はキタリナのママのときの声で。\n一人称も二人称もキタリナママのときの感じでお願いいたします。\nもし挨拶動画をつけてくださる場合は、本編を一番目、挨拶動画を二番目にしてくださると、Twitterで納品URLを拡散するときに、（多分）本編音声をTwitterで拡散できるので嬉しいです。\nただし順番は必須ではないです。\nまた、参考動画を添付していますが、あくまで参考なので、必ずしもこうして欲しいというわけではありません。\nrikusuさんの素敵なボイス作品をお待ちしております。\n\nhttps://www.nicovideo.jp/watch/nm13569991", "created_at": "", "completed_at": ""}, {"path": "/@rikusu_vrc/works/3", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59dfa1bbe40c31443368a66f64ad82d6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9022e48d9cf5c8b90fd86834f8ed5256 3x", "genre": "voice", "nsfw": false, "body": "キタリナのママのときの声で、仕事に疲れて帰ってきた人をベロベロに甘やかす感じのボイスをお願いいたします。\nノリとしては伊東ライフさんの同人誌みたいなノリが良いです。\nただし、ものとしては全年齢向けが良いです。\n伊東ライフさんの同人誌っぽいノリがわからない場合は無理にそっちに合わせなくても大丈夫です。\n呼びかけ方はキタリナママのときのキャラクターに合ったのじゃロリババっぽい感じでお願いします。\n個人名よりも、お主とか、主様とか、ぬし、とかそんな感じで。", "created_at": "", "completed_at": ""}, {"path": "/@rikusu_vrc/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59dfa1bbe40c31443368a66f64ad82d6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9022e48d9cf5c8b90fd86834f8ed5256 3x", "genre": "voice", "nsfw": true, "body": "私はその日、生活費が厳しいという愚痴をフレンドにこぼしていた。\n何か良いバイトはないかなぁと呟いた時、その人は私の目の前に移動してきた。\nアバターは可愛いのにどこか心を許せない、できれば会いたくない人、でも私はこの人に、秘密を握られている。\n秘密を盾に何かを要求したりしない、ただいつも視界の隅に現れては存在感だけ主張して去っていく。\nそれが不気味でいつも避けていたのだった。\n\n「聞いたよ、困ってるんだって？いい話があるんだけど、聞くだけ聞く？ここだとあれだから、ポータル出すよ」\n\n私は直感した。この人はこの日のために今までずっと私の近くにいたんだと。\n断れば、逆らえばどうなるか分からない。でもあくまで脅しではなく対等な取引関係に見せかけて、私を我がものにするつもりだったんだって。\n\n先にポータルに消えたその人を、静かに呪いながら、私はスティックを倒した。\n\nーーーーーーーーーーーーーーーー\n\n「ほら、もうすこし頑張ってもらわないと困りますよ。可愛い声聞かせてくださいよ」\n\n彼の初めの要求は、自慰だった。\nカメラを向けながら、彼は私の目の前で私の姿を見下ろしている。\n私はいつか大切な時のために用意しておいたアバターで横たわり、小さく声を上げていた。\n一番見せたくない人に、一番見せたくない姿を見せ、\n一番聞かせたくない人に、一番聞かせたくない声を聞かせる。\n私の中で自尊心が破壊されていくのと同時に、代わりに今までにない認めたくないほどの快感が私を襲い始めてきた。\n\n私、どうなっちゃうんだろう。\n段々ぼんやりしていく意識の中で、私は明けない夜の到来を感じていた。\n\n\n\nみたいなシチュエーションで、喘ぎ声をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rikusu_vrc/works/1", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c40553a27bb620dff7ec9e972471195, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59dfa1bbe40c31443368a66f64ad82d6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1904163441679781888%2F6q7bqyfo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9022e48d9cf5c8b90fd86834f8ed5256 3x", "genre": "voice", "nsfw": true, "body": "声の練習には喘ぎ声がいいという眉唾な知識を手に入れてから、\n可愛い声の持ち主はきっと喘ぎ声が上手いんだろうという妄想に取り憑かれてしまいました。\nもしよければ差し支えない範囲で喘ぎ声を録音して欲しいです。", "created_at": "", "completed_at": ""}]}