9-8f41-71d5d086a298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79db0bfba3c908a4d3886d5ddc908a97, https://si.imgix.net/ba204049/uploads/origins/386b4371-ab9a-4339-8f41-71d5d086a298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fbf3bd36fce9a9f9d51f9f0a8758d9f 2x, https://si.imgix.net/ba204049/uploads/origins/386b4371-ab9a-4339-8f41-71d5d086a298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1f06add15fd6bc9e196b964b4f15c2b 3x", "genre": "art", "nsfw": true, "body": "こんにちは。アトリエ・ルルアのルルア・フリクセルをお願いします。\n\nこのシナリオでは、ルルアが盗賊に倒され、盗賊がルルアにおちんちんにキスをさせます。ルルアは、怖くて恥ずかしくて、山賊のペニスにキスをして、服従を示します。\n\nルルアは普通の服を着ているが、傷んでいる。ルルアは金属の鎖の首輪もする。\n\nhttps://drive.google.com/drive/folders/1LuBQF1kSoDFSDil55wNzv85orLBRVvH7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@a83d8/works/32", "thumbnail_src": "https://si.imgix.net/70602f56/uploads/origins/71f88ae9-379a-4b31-a34e-b44b2e9decce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8a04da613d1ca0a0003cca9c7eea96", "thumbnail_srcset": "https://si.imgix.net/70602f56/uploads/origins/71f88ae9-379a-4b31-a34e-b44b2e9decce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8a04da613d1ca0a0003cca9c7eea96, https://si.imgix.net/70602f56/uploads/origins/71f88ae9-379a-4b31-a34e-b44b2e9decce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=643913d9b99ce49ab79c99487cffd1ac 2x, https://si.imgix.net/70602f56/uploads/origins/71f88ae9-379a-4b31-a34e-b44b2e9decce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a69b2cdd894c35e95a26893a1731967b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@a83d8/works/31", "thumbnail_src": "https://si.imgix.net/4b9bf1e8/uploads/origins/06d154a0-7e6e-4b9d-96d9-cb6bd5549f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4690f66cdc5146c3da399b717df79d14", "thumbnail_srcset": "https://si.imgix.net/4b9bf1e8/uploads/origins/06d154a0-7e6e-4b9d-96d9-cb6bd5549f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4690f66cdc5146c3da399b717df79d14, https://si.imgix.net/4b9bf1e8/uploads/origins/06d154a0-7e6e-4b9d-96d9-cb6bd5549f08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=878a30f77bc0ea68539a71d29caf3720 2x, https://si.imgix.net/4b9bf1e8/uploads/origins/06d154a0-7e6e-4b9d-96d9-cb6bd5549f08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c1ffead7226f74c7bb2b3a99e9864cc 3x", "genre": "art", "nsfw": true, "body": "プリコネのノゾミをお願い致します\nノゾミ（資料1）が騎士君に手コキカラオケ\n構図は資料2枚目を参考に\n髪質はかなりふんわりとウェーブがかったように\nノゾミは左手で竿役の肉棒を扱いています\n手の爪はかなり長く、ピンクのネイルをしています\n胸は爆乳で、この過去イラストくらい大きくしてください。むしろこれよりも大きくしてください\nhttps://skeb.jp/@a83d8/works/10\n爆乳の谷間には指先が沈んで見えなくなるほどの大量のパイズリ白濁精液の湖\n股からは、中出しされた精液が垂れていて、スカートから漏れ出しています\n表情は舌なめずりなどでとっても意地悪そうに\n\n竿役は騎士君\n全裸で口を大きく開き涎をダラダラ垂らし痙攣\n顔や胸板に正の字を複数個書かれています\n竿役は左手でマイクを持っており、その手に絡めるようにノゾミも資料3のマイクを右手で一緒に持っています\n背景はカラオケボックス内で、テーブルや床に使用前・使用済みのコンドーム、資料4枚目のスタミナドリンクが散らばっています\n以下はシチュエーション及び、欲しい差分の流れになります\n過去作品のシャドウノゾミに監禁搾精されているシリーズの続きで、シャドウのノゾミに監禁されながら弄ばれています。\n\n舌なめずりをしながら肉棒を虐めるノゾミ\n歌い切れず射精する\n「私の勝ち～♡」と目にハートを浮かべ、ニコニコ嬉しそうなノゾミ\n再度歌い出す騎士君\n今度は歌い切りそうになり焦るノゾミ\n曲が終わる前に激しいキスで物理的に妨害するズルをするノゾミ\n急なキスで再び射精\n興奮でノゾミシャドウ化\n竿役の口と唾液の橋を作りながら「また私の勝ち～♡」と勝ち誇るノゾミ。連続射精で息絶え絶え騎士君\nノゾミが「キミが1曲歌いきるまで終わらせないからね♡」と宣言。絶望の騎士君\n手コキとキスで永遠と敗北し続ける\n\n以上になります。\n宜しくお願いいたします\n\nhttps://misskey.io/notes/9omzjnrasw2j09mt", "created_at": "", "completed_at": ""}, {"path": "/@a83d8/works/30", "thumbnail_src