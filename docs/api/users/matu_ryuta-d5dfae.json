rop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2581495505f1f825e4a81af343d3325b", "thumbnail_srcset": "https://si.imgix.net/e4a0995e/uploads/origins/9d48961a-aefb-4454-9bf3-0305b38a9ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2581495505f1f825e4a81af343d3325b, https://si.imgix.net/e4a0995e/uploads/origins/9d48961a-aefb-4454-9bf3-0305b38a9ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44c918a5f83a9979502d7906ad6dc046 2x, https://si.imgix.net/e4a0995e/uploads/origins/9d48961a-aefb-4454-9bf3-0305b38a9ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aaf5234d99b9285ef34710404784cf43 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/16", "thumbnail_src": "https://si.imgix.net/4eb70e81/uploads/origins/cf33f5c9-69e9-4b38-9011-e49893e936e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75e97c5c8a29fc6273a69000b2b58d74", "thumbnail_srcset": "https://si.imgix.net/4eb70e81/uploads/origins/cf33f5c9-69e9-4b38-9011-e49893e936e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75e97c5c8a29fc6273a69000b2b58d74, https://si.imgix.net/4eb70e81/uploads/origins/cf33f5c9-69e9-4b38-9011-e49893e936e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f822b9fdfbf60545823462ae0c32addb 2x, https://si.imgix.net/4eb70e81/uploads/origins/cf33f5c9-69e9-4b38-9011-e49893e936e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b33ca330c07aee864c1bad2e6879fb62 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/15", "thumbnail_src": "https://si.imgix.net/17dcca89/uploads/origins/f0355604-73ad-453e-a873-0570d07d4091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=221aa195f9a9175bd43f0b02f3403d79", "thumbnail_srcset": "https://si.imgix.net/17dcca89/uploads/origins/f0355604-73ad-453e-a873-0570d07d4091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=221aa195f9a9175bd43f0b02f3403d79, https://si.imgix.net/17dcca89/uploads/origins/f0355604-73ad-453e-a873-0570d07d4091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3628973c3e85ebfa29d85a77488c9987 2x, https://si.imgix.net/17dcca89/uploads/origins/f0355604-73ad-453e-a873-0570d07d4091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea1ae01cd16afcced5c133c62508d0d7 3x", "genre": "art", "nsfw": true, "body": "テーマは「催眠支配されたお嬢様学校の寮生」の女の子です。\n\nキャラ\n我儘で高飛車なツインテール女子\n舞台となる女子高の理事長の娘\n甘やかされて育っており、自分以外には高圧的。\n管理人に催眠でレイプ願望を植え付けられて、従属する事の悦びに染められる。\n\n形式\nモノクロ漫画形式で下記の表現をお願いします。\n・催眠でレイプ願望を植え付けられたヒロインのお嬢様はネットでレイプ物のエロ動画を見つけて見入ってしまう。\n・ヒロインは自分が凌辱セックスされる妄想をしてオナニー三昧の日々。\n・度々夢をレイプされる夢を見るようになり、その相手はなんと竿役である女子寮の管理人。\n・竿役にレイプされたいヒロインは竿役が自分の部屋に襲いに来る事を妄想して、部屋の鍵を開けてオナニーする。\n・オナニーしている所を見つけられて脅迫されてのセックス。言葉では嫌がりながらも、内心で早く犯して欲しいと懇願している。\n・催眠解除されるヒロイン。正気のまま正真正銘のレイプだが竿役をおかずにオナニーをしていたため快感を覚えてしまう。\n・激しいレイプにも関わらず感じるヒロインは自分が雌奴隷なのだと自分で認める。\n・教育されたヒロインは喜んで管理人に服従する。メイド服を着てオナニーしながら管理人にご奉仕フェラをしている。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/14", "thumbnail_src": "https://si.imgix.net/ac609b52/uploads/origins/0eb7a9e8-1d70-46c2-be56-3929b141d67d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6bce7299953afc2d021dd342c2f468b", "thumbnail_srcset": "https://si.imgix.net/ac609b52/uploads/origins/0eb7a9e8-1d70-46c2-be56-3929b141d67d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6bce7299953afc2d021dd342c2f468b, https://si.imgix.net/ac609b52/uploads/origins/0eb7a9e8-1d70-46c2-be56-3929b141d67d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c1c9d825d11c74696cc68d74fa4e17c 2x, https://si.imgix.net/ac609b52/uploads/origins/0eb7a9e8-1d70-46c2-be56-3929b141d67d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc192e793af13562729eae123dc39b08 3x", "genre": "art", "nsfw": true, "body": "『現実改変アプリ』を手に入れた種付けおじさんが、可愛いＪＫを全裸ハメ撮りイチャラブセックスでイカせまくるシチュをお願いします。\n\n◎ヒロイン\n\n・１６歳。セミロング、Ｃカップ美乳、パイパン。穏やかで奥ゆかしい性格\n\n・キス未経験、処女。交際経験無し。えっちな事に興味はあるが恥ずかしい\n\n・オナニーは週２～３回。絶頂は未経験（感度は良いがイキそうになると怖くなってやめてしまう）\n\n\n◎設定\n\n・無人島を購入して改変アプリで開拓し、中高一貫の『ハーレム学園』を設置。全国から苗床候補の可愛い女子や美人教師を集めて（生徒は他の学校からの寄せ集めのため制服はバラバラ）、島内の寮で生活させる\n\n・島で唯一の男性である種付けおじさんは改変アプリで『種付け師』となり、島のあらゆる施設や部屋に自由に出入りでき、妊娠可能な全ての女性に種付けできる。生まれた子供は本土に転送され国の機関が育てる\n\n・島の女性は全員種付けおじさんを愛しており、中出しセックスと妊娠出産を受け入れている（羞恥心はある）\n\n・アプリのカメラで女性の裸を透視し、ステータスを閲覧可能。種付け師とのセックスは全て撮影・記録する\n\n・島にいる女性の肉体劣化無効（加齢、病気、ムダ毛、乳垂れ、乳首の黒ずみ、膣のゆるみなど）。処女でも出血や痛みは無く、初セックスで快感を感じ、種付けおじさんの体臭や体液で発情する身体に改変済み", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/13", "thumbnail_src": "https://si.imgix.net/23960684/uploads/origins/8c406951-e4e4-4e27-a225-6a104780175d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f04cad43cd90b701bf647cc8fd65aa61", "thumbnail_srcset": "https://si.imgix.net/23960684/uploads/origins/8c406951-e4e4-4e27-a225-6a104780175d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f04cad43cd90b701bf647cc8fd65aa61, https://si.imgix.net/23960684/uploads/origins/8c406951-e4e4-4e27-a225-6a104780175d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66ec42f8a1d39f9a201084966bb1cb95 2x, https://si.imgix.net/23960684/uploads/origins/8c406951-e4e4-4e27-a225-6a104780175d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e6cdb017d071d635fb6e3710da2795d 3x", "genre": "art", "nsfw": true, "body": "文化祭ソープランドの堀江優季ちゃんが一番好きでいつも大変お世話になっています。\n早速ですがDL販売されている中で堀江さんの「☆えっちなエピソード」にあった「さーちゃんと弟の3人でシたこと」が是非見てみたいです。\n指定としましては「まあそのあと2人に逆襲されて盛大にイっちゃったけど…♡」の部分を本番・中出しアリで1枚以上お願いできましたらと。\n具体的なプレイ内容につきましては元々イメージされていたものがあるかと存じますので自由にお任せいたします。\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/12", "thumbnail_src": "https://si.imgix.net/c794dc7d/uploads/origins/9a967de4-a6a0-47a4-901b-06d3674c00db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02b0775f4ab4acfbbb01522a672fee34", "thumbnail_srcset": "https://si.imgix.net/c794dc7d/uploads/origins/9a967de4-a6a0-47a4-901b-06d3674c00db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02b0775f4ab4acfbbb01522a672fee34, https://si.imgix.net/c794dc7d/uploads/origins/9a967de4-a6a0-47a4-901b-06d3674c00db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f78969bf5a09536631a095c984168418 2x, https://si.imgix.net/c794dc7d/uploads/origins/9a967de4-a6a0-47a4-901b-06d3674c00db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d4157d6a3be3ba47e17ac55e1b683d6 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\n前回お願いさせて頂きました「寝取られ勇者　女神官ロゼ救済IFルート」のその後をお願いいたします。\n\n結ばれたロゼが勇者の子供を身ごもるお話で、妊娠初期、ボテ腹、産後のイラストをお願い致します。\n特にボテ腹、赤ちゃんを抱いた産後の場面が見たいところで可能であれば、産後に勇者の事を「あなた」か「パパ」呼びしてくださると最高です。\n\nまた、可能でありましたらつわりで体調の優れない様子（妊娠に気づいていない）と妊娠を喜ぶ様子、産後のステータス画面（経験人数1）をお願いできますととても嬉しいです。\n\nIFルートの為、正史とは関係なく、大好きな勇者と幸せな家庭を築くお話でお願いさせていただきます。\n\n要望の多いリクエストにございますが、お目通し頂けますと幸いです。\n何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/11", "thumbnail_src": "https://si.imgix.net/a39c7f45/uploads/origins/0c49a74f-4c4f-47e7-abf4-82f790fbd6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d12d882be2c72c83094a414281f3b699", "thumbnail_srcset": "https://si.imgix.net/a39c7f45/uploads/origins/0c49a74f-4c4f-47e7-abf4-82f790fbd6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d12d882be2c72c83094a414281f3b699, https://si.imgix.net/a39c7f45/uploads/origins/0c49a74f-4c4f-47e7-abf4-82f790fbd6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48a535a72237543cf67df78ac8d1a9ea 2x, https://si.imgix.net/a39c7f45/uploads/origins/0c49a74f-4c4f-47e7-abf4-82f790fbd6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=549e974ef44f4ffb0885690daf9ba51d 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエストさせて下さい。\n\nロゼちゃんと勇者くんのイチャラブ子作りエッチの白黒イラストあるいは漫画を切に願います。行為前、行為後に本編の様なステータス画面があると最高です。\n\nキャラクター\n「信頼しているパーティー仲間が知らないステータスを増やして帰ってくる」　より\n女神官のロゼちゃん（処女）\n勇者くん（童貞）\n\nシチュエーション\n・死と隣り合わせの冒険によりロゼちゃんに恋情をもった勇者くんが愛の告白。本編同様恋慕の目でみていたロゼちゃんと結ばれるお話し。\n・初夜\n・行為前後にキス（後半はディープ）\n・体位は正常位と対面座位　中出しアリ\n・行為自体はゆっくりとお互いが高まる雰囲気（スローセックス）\n・事後のステータス画面では破瓜の痛みよりも想い人との行為で嬉し泣きハート目でうっとりと子宮のあたり撫でて欲しい。\n・本編と全く関係ないIFストーリーにして頂けると大変ありがたいです。\n\n\n具体的かつ非常にわがままなリクエストとなりますが金額内でできる範囲内でのご対応、ご検討頂けますと幸いです。\nどうぞよろしくお願いします。\n\nhttps://twitter.com/matu_ryuta/status/1516795426917154818?t=AB-eQOtiiC-GAnzpEbmceg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/10", "thumbnail_src": "https://si.imgix.net/2adf54c7/uploads/origins/c103e5da-1e7f-4a45-b66b-905cff2d80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bf4196ea5cc19e98b56318e0ab213b2", "thumbnail_srcset": "https://si.imgix.net/2adf54c7/uploads/origins/c103e5da-1e7f-4a45-b66b-905cff2d80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bf4196ea5cc19e98b56318e0ab213b2, https://si.imgix.net/2adf54c7/uploads/origins/c103e5da-1e7f-4a45-b66b-905cff2d80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28e6073434e8a411ae0f7579f999e6ea 2x, https://si.imgix.net/2adf54c7/uploads/origins/c103e5da-1e7f-4a45-b66b-905cff2d80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=918246efc48d1086972ce2fd69fc8030 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/9", "thumbnail_src": "https://si.imgix.net/662cc038/uploads/origins/c9e212ed-e26b-48a8-a522-fd21338110df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5452684348fa83a09578ec3d77ddbb5b", "thumbnail_srcset": "https://si.imgix.net/662cc038/uploads/origins/c9e212ed-e26b-48a8-a522-fd21338110df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5452684348fa83a09578ec3d77ddbb5b, https://si.imgix.net/662cc038/uploads/origins/c9e212ed-e26b-48a8-a522-fd21338110df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60425a6dfaab10d819767bcf985b0b41 2x, https://si.imgix.net/662cc038/uploads/origins/c9e212ed-e26b-48a8-a522-fd21338110df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=969577d08e436a4b8bad1a3f192bc022 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/8", "thumbnail_src": "https://si.imgix.net/a7cf8a3b/uploads/origins/c0643565-7724-4740-8f5d-829ae57cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3037b44ea122494ea342c2d747d0482", "thumbnail_srcset": "https://si.imgix.net/a7cf8a3b/uploads/origins/c0643565-7724-4740-8f5d-829ae57cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3037b44ea122494ea342c2d747d0482, https://si.imgix.net/a7cf8a3b/uploads/origins/c0643565-7724-4740-8f5d-829ae57cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bc502ef01f21dcc8db95f59960e6c4e 2x, https://si.imgix.net/a7cf8a3b/uploads/origins/c0643565-7724-4740-8f5d-829ae57cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02427591fc4d2919ef14ee0c8fd40882 3x", "genre": "art", "nsfw": true, "body": "テーマは「催眠支配されたお嬢様学校の寮生」の女の子です。\n\nキャラ：\n王子様系の女の子。\n女の子から好かれるキリっとしたタイプ。\nただし王子様っぽさは周囲の期待に合わせている自分であり、内心では女の子らしく扱って欲しい。\n\n形式：\nモノクロ漫画で下記の表現をお願いします。\n・彼氏の話をする周囲の人間の話を聞くと女の子扱いされたい願望が強くなるようにされている。\n・暗示で管理人に相談なければと思う。管理人から美容マッサージ（痴漢）をされる。更に薬（実は少量の媚薬）を渡される。\n・毎日、媚薬を飲んで身体が火照っている状態に。催眠でオナニーをする時は身近な男性（管理人）をおかずにと誘導される。\n・エッチな表情で管理人さん毎日経過報告。ある日、女らしさの仕上げを行いましょうかと言われる。\n・女らしさの仕上げとは当然セックスで、処女喪失から、ひっきりなしに続けられるエッチな美容行為。あられもない表情で管理人とセックスを求めるようになっていく。今のお前は最高に女らしいぞと言われる。\n・女らしく仕上がった状態。めっきり女らしくなってしまい、他の生徒からも凄く色っぽくて見るとドキドキしてしまうと噂される。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/7", "thumbnail_src": "https://si.imgix.net/fc9670dc/uploads/origins/7dd6003c-578a-433d-a086-a810b951bb27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2c266070a6a9931842ef719b39436ea", "thumbnail_srcset": "https://si.imgix.net/fc9670dc/uploads/origins/7dd6003c-578a-433d-a086-a810b951bb27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2c266070a6a9931842ef719b39436ea, https://si.imgix.net/fc9670dc/uploads/origins/7dd6003c-578a-433d-a086-a810b951bb27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab74c697f6b81c0c711c839ff1d941c9 2x, https://si.imgix.net/fc9670dc/uploads/origins/7dd6003c-578a-433d-a086-a810b951bb27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34ba9b6ea28e7bfa49d12ad83a61d1b7 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\n\nキャラ：\n「少子化問題に真剣に取り組む正義の催眠種付けおじさん」のふうかのお母さん\n\nシチュ：\n・お母さんのボテ腹姿を拝みたいです\n・なお、（最後のページの黒髪の子をお母さんの第2子と仮定して）何人目を孕んでるかはお任せします\n\n指定以外の部分についてはそちらにお任せ致します\n以上、ご都合が宜しければご検討頂けると幸いです\n宜しくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/6", "thumbnail_src": "https://si.imgix.net/59fa1b41/uploads/origins/c392b022-c25f-47b2-9077-88be8c1a9b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec08f9a8233d3f6ef9915c308ddae044", "thumbnail_srcset": "https://si.imgix.net/59fa1b41/uploads/origins/c392b022-c25f-47b2-9077-88be8c1a9b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec08f9a8233d3f6ef9915c308ddae044, https://si.imgix.net/59fa1b41/uploads/origins/c392b022-c25f-47b2-9077-88be8c1a9b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8738754e6bb64b77a1c028d0b7644d2c 2x, https://si.imgix.net/59fa1b41/uploads/origins/c392b022-c25f-47b2-9077-88be8c1a9b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b090ce42f86353975a0db39fe7c856d0 3x", "genre": "art", "nsfw": true, "body": "skeb再開お待ちしておりました！！\n「田舎から引っ越してきたボーイッシュな女の子」の作品がとても性癖に刺さっておりとても好みです！\nまた、子作り報告部のシリーズも好きです。\nそんな作品関連で依頼させて頂けないでしょうか？\n個人的な趣向になりますのでお気に召さなければキャンセルをお願いします。\n\n〇幼馴染のボーイッシュな女の子が家庭の事情などの理由で他の大人の男と結婚してしまった…というシチュエーション\nをお願いします\n\n「田舎から引っ越してきたボーイッシュな女の子」同様、基本的に男の子視点で\n途中まで(それこそ女の子が妊娠するまで)異性であると気付かなかったという設定も同様でお願いします。\n特に裸を見られた時の反応を中心に描いていただけると嬉しいです。\n\nまた、結婚～妊娠～出産に至るまで終始ボーイッシュな小学生のままでお願いします。\n夫に対して背は腰ぐらい、胸はぺったんこで乳首も小さめだと嬉しいです。\n\n＜描いていただきたいシーンについて＞\n・結婚前\n・結婚後妊娠前\n・妊娠後\n・出産後\nのシーンを描いていただけると嬉しいです。\n結婚前は裸(胸など)を見られても気にしてなかったが、結婚後は恥じらったり恥ずかしくて不機嫌になったり…\n最終的にはまた恥じらわなくなるといった感じだと嬉しいです。\n\n結婚後は指輪が見えるようになっていると嬉しいです。\n夫の描写や絡みはお任せします。\n\nあと、上記作品の4のような。「昔はよく見てたじゃん」等と言いながら授乳しているシーンは入れて頂けると嬉しいです。\n\n以上です。\n要望が多くて申し訳ありません…\n「田舎から引っ越してきたボーイッシュな女の子」を相当意識した依頼になっております(あの作品がとても好きなのです…)\n\n改めて無茶な依頼であればキャンセル頂ければ幸いです\n何卒宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/5", "thumbnail_src": "https://si.imgix.net/be343e40/uploads/origins/2356424d-a86f-4af7-b467-aa6f49143a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c184684e4d27f9dd97e2d7c10bae5465", "thumbnail_srcset": "https://si.imgix.net/be343e40/uploads/origins/2356424d-a86f-4af7-b467-aa6f49143a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c184684e4d27f9dd97e2d7c10bae5465, https://si.imgix.net/be343e40/uploads/origins/2356424d-a86f-4af7-b467-aa6f49143a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5fcf206042a4b340f32db875486a5ed 2x, https://si.imgix.net/be343e40/uploads/origins/2356424d-a86f-4af7-b467-aa6f49143a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02a843e8f2c949a80bac238d7844789e 3x", "genre": "art", "nsfw": true, "body": "「催眠支配されたお嬢様学校の寮生」の女の子をお願いいたします。\n\nキャラ：\nプライドが高く気の強い高嶺の花の生徒会長の女の子。\n見た目はクール系美少女。\n黒髪ロングでスタイル抜群。\n運動神経も抜群で頭も良い。\n男嫌い。\n\n形式：\nモノクロ漫画で下記の表現をお願いします。\n・寮生の女の子に好かれる管理人を怪しく思い調べていたが、罠に嵌められて捕らえられるヒロイン。\n・管理人に襲われセックスされるヒロイン。みんなと同じようにしてあげるという管理人の言葉に強い気持ちで反発。事が終われば警察に行くつもりでつらい気持ちを耐えようとする。\n・ヒロインの抵抗虚しく。みんなと同じように催眠をかけられる。膣内射精で管理人を深く愛するように刷り込み。\n・催眠をかけられたヒロインは必死に拒絶するが、管理人は構わず中出し。ヒロインは竿役への愛情を無理矢理植え付けられてしまう。\n・その後の日々。男嫌いだったヒロインは管理人を深く愛する。裸エプロンで竿役とラブラブセックス。愛している管理人にセックスの気持ち良さを褒められて嬉しそうに甘える。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/4", "thumbnail_src": "https://si.imgix.net/7008b0b9/uploads/origins/ffd301e9-a0c6-4cdb-a0f3-524e5eb3db8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf5468e89f54628d15dbf667b27ea1fd", "thumbnail_srcset": "https://si.imgix.net/7008b0b9/uploads/origins/ffd301e9-a0c6-4cdb-a0f3-524e5eb3db8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf5468e89f54628d15dbf667b27ea1fd, https://si.imgix.net/7008b0b9/uploads/origins/ffd301e9-a0c6-4cdb-a0f3-524e5eb3db8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca9749b811f590847e5b9f5371b10484 2x, https://si.imgix.net/7008b0b9/uploads/origins/ffd301e9-a0c6-4cdb-a0f3-524e5eb3db8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=285c7d8e7d7fc343efc2cbb8a8af7546 3x", "genre": "art", "nsfw": true, "body": "好きなクラスメイトの女の子が実はサキュバスで人気が無い旧校舎で同級生に騎乗位でエナジードレインしているのを見てしまった男の子的な絵をお願い致します。\n\n詳細は\n\n・クラスメイトの女の子\n実はサキュバスで、一人一人誘惑しては旧校舎で精気をギリギリまで搾り取っている。既に学校の男という男の大半は餌食になっており、彼女の実質奴隷になっている……みたいな設定\n\n体型は制服上ではわかりづらいがかなり胸が大きく、それでいて体のラインは細い\n\n\nシチュ\n\n・古びた旧校舎の教室で同級生がクラスメイトの人気な女の子に騎乗位で搾り取られている\n\n・同級生の精気をかなり吸い取っている為かお腹が膨らんでいる\n\n・台詞として夢心地になっている同級生に甘い言葉をかけつつ、次のターゲットに誰にしようかみたいなことを言っている\n\n・その教室の廊下で口元に手を当てて息を殺しながら衝撃の事実と次のターゲットが自分であることに気が動転している男の子\n\nこれでお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/3", "thumbnail_src": "https://si.imgix.net/14543a48/uploads/origins/a69c06d7-af85-46e0-9cc0-487827ee453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b71ca8cac4c0de8d70b1f14f7b8511d", "thumbnail_srcset": "https://si.imgix.net/14543a48/uploads/origins/a69c06d7-af85-46e0-9cc0-487827ee453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b71ca8cac4c0de8d70b1f14f7b8511d, https://si.imgix.net/14543a48/uploads/origins/a69c06d7-af85-46e0-9cc0-487827ee453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46365d84ecf32fb083f0a62fb1a34419 2x, https://si.imgix.net/14543a48/uploads/origins/a69c06d7-af85-46e0-9cc0-487827ee453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d911bfd7f799daac6ac81286a0cb80f 3x", "genre": "art", "nsfw": true, "body": "初めましてリクエストさせていただきます。\nブルアカのユウカちゃんと子作りエッチして、見事にデキてしまって段々と体形（お腹やおっぱい、乳首など肥大）が変わっていくモノクロのイラストをお願いできますでしょうか？\n陰毛は生えていると助かります。\nハッピーというか明るい感じにしていただけますと幸いです。\n\n抽象的かつ要望多くて申し訳ございませんが、金額内でできる範囲でご対応、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/2", "thumbnail_src": "https://si.imgix.net/ff109cfc/uploads/origins/61532b48-bf42-48c1-802b-390e001ed4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665eac5b84f3800f17c6ff97dcb56b44", "thumbnail_srcset": "https://si.imgix.net/ff109cfc/uploads/origins/61532b48-bf42-48c1-802b-390e001ed4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665eac5b84f3800f17c6ff97dcb56b44, https://si.imgix.net/ff109cfc/uploads/origins/61532b48-bf42-48c1-802b-390e001ed4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=700f595304201c13deae51c845fdd695 2x, https://si.imgix.net/ff109cfc/uploads/origins/61532b48-bf42-48c1-802b-390e001ed4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0aa4721b803d55ff8beacb21f75a28c 3x", "genre": "art", "nsfw": true, "body": "昼夜で主導権が逆になる八雲紫の恋人エッチイラスト/漫画をお願いします。\n・大人っぽい方の紫様\n・着崩れ導師服で着衣\n・昼は不敵で余裕な感じで思わせぶりな挑発をする\n・夜は主導権を奪われて涙目でしおらしくなる\n・避妊具を勝手にとられて危険日を示唆しながら外出しを懇願するものの、説得力のない感じでダメだと言いながら中出し受精してしまう\n・胸の大きさはいつもツイッターで上げている鈴仙と同程度\n・モノクロ\n\n検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@matu_ryuta/works/1", "thumbnail_src": "https://si.imgix.net/a5194027/uploads/origins/3f1bf17e-fbae-4f24-8f43-0188a8b02dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f2a27eca0c3131072ca14633d26640", "thumbnail_srcset": "https://si.imgix.net/a5194027/uploads/origins/3f1bf17e-fbae-4f24-8f43-0188a8b02dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f2a27eca0c3131072ca14633d26640, https://si.imgix.net/a5194027/uploads/origins/3f1bf17e-fbae-4f24-8f43-0188a8b02dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a64a106008e602e19c4f20fef5ef90c 2x, https://si.imgix.net/a5194027/uploads/origins/3f1bf17e-fbae-4f24-8f43-0188a8b02dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77281bbec1d4131836b969d655c8b98d 3x", "genre": "art", "nsfw": true, "body": "テーマは「催眠支配されたお嬢様学校の寮生」でリクエストをお願いできないでしょうか？\n\nキャラ：\n・お嬢様学校の寮生。\n茶色がかったロングヘアでふわふわなウェーブがかかっている。\n小柄で巨乳。\n寮生活になってから急激に強くなる性欲に戸惑いながらも、１日１０回ものオナニーを日々繰り返している。（竿役が催眠で仕込んでおり絶頂時には竿役の顔が思い浮かぶようになっている）\n\n・竿役は女子寮の管理人\nおじさんなのに女子寮の女の子達からも評判が良い。\nというのは表向きで、女子寮の女の子達を片っ端から催眠で堕としまくっている。\n途中で寮に入ったヒロインもその毒牙にかけようとしている\n\n形式：\nモノクロ漫画で下記の表現をしてください\n・ヒロインが自室で催眠オナニー\n・ヒロインがオナニー中の動画を使って脅迫からのセックス\n・凌辱セックスなのに絶頂しまくる\n・催眠で思考を誘導され竿役おじさんが好きになるヒロイン", "created_at": "", "completed_at": ""}]}