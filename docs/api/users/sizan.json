{"screen_name": "sizan", "file": "sizan", "name": "出羽", "avatar_url": "https://pbs.twimg.com/profile_images/1971218060448247808/xX7muCAb.jpg", "header_url": "", "description": "◎https://pinkkiller.fanbox.cc/", "total_works": 249, "scraped_works": 30, "first_seen": "2025-10-18T12:37:28.505547", "last_updated": "2025-10-18T12:37:28.505547", "price_history": {"art": [{"amount": 2500, "recorded_at": "2025-10-18T12:37:28.505547"}], "correction": [{"amount": 500, "recorded_at": "2025-10-18T12:37:28.505547"}]}, "current_prices": {"art": 2500, "correction": 500}, "price_range": {"art": {"min": 2500, "max": 2500}, "correction": {"min": 500, "max": 500}}, "links": [{"label": "Website", "url": "https://dlaf.jp/maniax/dlaf/=/t/s/link/work/aid/seiounorakuen/id/RJ01258339.html", "name": ""}], "flags": {"from_archive": true}, "works": [{"path": "/@sizan/works/250", "thumbnail_src": "https://si.imgix.net/0d1a9c52/uploads/origins/8fcd78f6-7e13-4738-b6cc-761540cba9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb6474d53019c68357cd3961cebc843", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品のお世話になっております。\nイラストのリクエストさせていただきます。\n詳細は下記に記載いたします。\n\n・キャラクター\nカシバトルの鶴田ぽた子\n参考資料https://x.com/gokuo_official/status/1830049454222950544\nhttps://corocoro-news.jp/news/342655/\n\n・シチュエーション\n性処理係として手コキ素振りをしている(元の服装を下品に改造お願いいたします)\n\nマイナーなキャラクターで恐縮ですがご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sizan/works/249", "thumbnail_src": "https://si.imgix.net/3f176c67/uploads/origins/91f4e3dc-28c2-4831-a1cf-096e022bc492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=801004f41381cf2a47c6762d8b070d7b", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sizan/works/248", "thumbnail_src": "https://si.imgix.net/6a8c9e0d/uploads/origins/eb92b9a4-2c54-