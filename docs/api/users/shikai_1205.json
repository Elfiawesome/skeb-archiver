d0f-ba97-9ba24d925954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86975ff15b80752faa7e71e75ae37461, https://si.imgix.net/187ee2e9/uploads/origins/ec7a8743-8948-4d0f-ba97-9ba24d925954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ce20c7fc13b4b6e00d245e0a1f11e3 2x, https://si.imgix.net/187ee2e9/uploads/origins/ec7a8743-8948-4d0f-ba97-9ba24d925954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8955ebe7886d03469a994313017febd1 3x", "genre": "art", "nsfw": false, "body": "Thank you for the appeal! Your art is very cute, I would love you to draw my vtuber! She is a sleepy ghost child. \n\nPlease choose any pose you think is best. Including the mascot would make me happy! I will use it for posting on SNS, so a transparent file is appreciated. \n\nhttps://drive.google.com/drive/u/2/folders/1gbcDG6mH1Xpe6-hgGXMThLK-0slLnKgF", "created_at": "", "completed_at": ""}, {"path": "/@shikai_1205/works/46", "thumbnail_src": "https://si.imgix.net/f6d455b8/uploads/origins/58651a36-b79d-413c-8348-d14ef0da8eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aedf28c82422165b9b5ad715cb9e8ff", "thumbnail_srcset": "https://si.imgix.net/f6d455b8/uploads/origins/58651a36-b79d-413c-8348-d14ef0da8eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aedf28c82422165b9b5ad715cb9e8ff, https://si.imgix.net/f6d455b8/uploads/origins/58651a36-b79d-413c-8348-d14ef0da8eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5111ec21f6d58dd0d03fbc492b0a88e 2x, https://si.imgix.net/f6d455b8/uploads/origins/58651a36-b79d-413c-8348-d14ef0da8eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1aad6e648844e7095698a0946d69d465 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵と作風が大好きなので、私のアイドルキャラの絵を依頼できたらありがたいです！どんなポーズや表情でも構いませんし、服装もお任せします。カジュアルな服装でも、参考資料と同じ服装でも構いません。よろしくお願いします！\n\n使用方法SNS投稿\n\nhttps://dr