x.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d125ad7b4df4f8e2ae7771b35cfcf76 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=960c83014536a9ee9d0b770edb9d701d 3x", "genre": "voice", "nsfw": false, "body": "仕事から疲れて帰ってきた弟の為に夕飯作ったりタイミング良くお風呂沸かしてくれて寝かしつけてくれるお兄ちゃんが聞きたい!!(泣)", "created_at": "", "completed_at": ""}, {"path": "/@ryouna_ryona917/works/7", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf157c1e500aa193c2daf317965955f", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf157c1e500aa193c2daf317965955f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d125ad7b4df4f8e2ae7771b35cfcf76 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=960c83014536a9ee9d0b770edb9d701d 3x", "genre": "voice", "nsfw": true, "body": "散歩してたらいきなり口を塞がれて(軽くで構わない)目隠しをかけられて拉致される\n廃墟の椅子に縛り付けられて目隠しをとられた瞬間にビニール袋を頭からかけられて窒息させられながらオナホを無理矢理付けられる声が聞きたいです(変態)", "created_at": "", "completed_at": ""}, {"path": "/@ryouna_ryona917/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1788222447025885184%2FxwtIT0Ip.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf157c1e5