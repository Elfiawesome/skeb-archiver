net/0d9e405f/uploads/origins/819e0e1f-5ffe-4cfd-965d-8e51f290244b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=260420906c31e9e929b11f0f867603bc", "thumbnail_srcset": "https://si.imgix.net/0d9e405f/uploads/origins/819e0e1f-5ffe-4cfd-965d-8e51f290244b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=260420906c31e9e929b11f0f867603bc, https://si.imgix.net/0d9e405f/uploads/origins/819e0e1f-5ffe-4cfd-965d-8e51f290244b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71451d99ba5f06f548b5e31d1d871618 2x, https://si.imgix.net/0d9e405f/uploads/origins/819e0e1f-5ffe-4cfd-965d-8e51f290244b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a008be2c57046ee457fefa90b1c23d9 3x", "genre": "art", "nsfw": true, "body": "TRPGで使用しているOCの1枚絵をお願いしたいです。\n\nXにて「 #仁那虎琉 」と検索していただくと、立ち絵が2枚貼ってあるツイートが出てきます。そちらの男の子をお願いします。(URLを貼るとどうしても送れなかったのでこのような形で失礼します)\n\n「烏が群れては、極彩色」というシナリオのHo2の男です。一番気に入っている探索者でいつかあんどうさんに頼んでみたくて！！！！\n\n渋谷でカラーギャングをしてます！\n足が早い！\nパルクールできます！\nナイフで戦います！\n素直になれないツンデレボーイです！\n甘いものが好きなのですが、誘われて嬉しいくせにみんなの前ではなんか恥ずかしいので「……ふーん、別にいいかな…」みたいなこと言って、あとから2人の時にやっぱいく。って言いながら裾を引っ張るタイプの男です！\nこんな感じですが女の子には比較的優しいし、女性ファーストです。\n\n構図等々お任せします、顔が見えればありがたいです！ゴーグルは作画コストが高いので無くても問題ありません！あんどうさんが描いてくれるボロボロの男が大好きなので、是非こいつもﾎﾞﾛﾎﾞﾛにしてほしいです！！！！！戦う男なのですがCONが7でよくぶっ倒れたりすぐ怪我したりしてるので、情けない涙目とかしてると嬉しいなと思います。", "created_at": "", "completed_at": ""}, {"path": "/@tamagoDX1414/works/252", "thumbnail_src": "https://si.imgix.net/8d6b577c/uploads/origins/11292b07-cb6e-4937-9779-79d2ac32707f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a1b7e3fab65849b694f3a0b24d32d0e", "thumbnail_srcset": "https://si.imgix.net/8d6b577c/uploads/origins/11292b07-cb6e-4937-9779-79d2ac32707f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a1b7e3fab65849b694f3a0b24d32d0e, https://si.imgix.net/8d6b577c/uploads/origins/11292b07-cb6e-4937-9779-79d2ac32707f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e420548610efefc0c4eb4ab235ffa025 2x, https://si.imgix.net/8d6b577c/uploads/origins/11292b07-cb6e-4937-9779-79d2ac32707f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b37a7729b339fa0775c69c59bbd0fcd5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tamagoDX1414/works/251", "thumbnail_src": "https://si.imgix.net/278ebb14/uploads/origins/bb7a11e8-78c8-4f1b-8235-cbadf7440569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d1897ebe10dae3a1d3d84ee6e1d6d20", "thumbnail_srcset": "https://si.imgix.net/278ebb14/uploads/origins/bb7a11e8-78c8-4f1b-8235-cbadf7440569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d1897ebe10dae3a1d3d84ee6e1d6d20, https://si.imgix.net/278ebb14/uploads/origins/bb7a11e8-78c8-4f1b-8235-cbadf7440569?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaf9dde61d7415a5f2a1b88a5e461e22 2x, https://si.imgix.net/278ebb14/uploads/origins/bb7a11e8-78c8-4f1b-8235-cbadf7440569?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f80530f977dba83834e69ff6fe30b041 3x", "genre": "art", "nsfw": false, "body": "ティターニア、リン、R、詐堂がそろっている絵が見たいです！\n人数が多いのでラフ、SD、モノクロなどで適宜工数を削減していただければ助かります。\n\n背中を向けていたり顔が見えない構図でも問題ありません。\n雰囲気はHappyでもBadでもどちらでも構いません！！\n並ぶわけないとも思うのでifでもパロディでも大丈夫です。\n\nご検討いただければ嬉しく思います。", "created_at": "", "completed_at": ""}, {"path": "/@tamagoDX1414/works/250", "thumbnail_src": "https://si.imgix.net/eb0aac22/uploads/origins/c23eea99-45da-4bff-8999-4e9b79aa8c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3bc23ce3d5d9a2471a49a28143a569", "thumbnail_srcset": "https://si.imgix.net/eb0aac22/uploads/origins/c23eea99-45da-4bff-8999-4e9b79aa8c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3bc23ce3d5d9a2471a49a28143a569, https://si.imgix.net/eb0aac22/uploads/origins/c23eea99-45da-4bff-8999-4e9b79aa8c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c34f12a9e64152d61582f457c97eea9 2x, https://si.imgix.net/eb0aac22/uploads/origins/c23eea99-45da-4bff-8999-4e9b79aa8c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0c31254c9151017eee5d790d64b901d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、今回リクエストを再開するとのことで募集させていただきます。\nいつもあんどうさんのシナリオで楽しませていただいており、シナリオ自体のおもしろさだけでなく、魅力的なNPCたちに心を揺さぶられています。特にイドラの約束の緑川雷同くんが大好きです。\n\n今回リクエストしたいのは、イド約のうちの子と、雷同くんのイラストです。\n普段から女装をしている設定の子なので、女装をしている状態の自探索者と雷同くんが見られたらうれしいと思っています。\n特に見てみたいと感じるシチュエーションは以下の通りです。その中でイメージが湧きやすいものがあれば描いていただけるとうれしいです。\n・二人で真剣に仕事をしているところ（コーヒーなどを飲みつつ書類の読み合わせをしていたりなど）\n・二人で遊園地に遊びに来ているところ、表情は笑顔\n・休日に二人で外食に来ているところ（ピザだと嬉しいです）\n\n▼簡単な自探索者設定\n・名前：青柳 眞秀（あおやぎ まほろ）、34歳男性\n・表面上クールなタイプ。基本的に他者には冷たい対応をするが、雷同など、気心の知れた友人相手には明るい。\n・根は気弱だが、気持ちを強く持つ為に女装をしている。\n・女装をしている時でもあまりスカートは履かない。\n・ピザやハンバーガーなど、ジャンクフードが好き。\n\n▼キャラクターシート\nhttps://iachara.com/view/10042276\n▼全身立ち絵\nhttps://drive.google.com/drive/folders/1hpW2sZVt7dOK9T2TK5qIkolve7uqmwGK?usp=sharing\n\nまだ暑い日が続きますので、どうかお身体を大切にしてください。\nご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@tamagoDX1414/works/249", "thumbnail_src": "https://si.imgix.net/54c15bbf/uploads/origins/5454d512-df57-4b20-a07c-cff7ef8c6ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=189b0bb31674c684b4e0fcc332199ae7", "thumbnail_srcset": "https://si.imgix.net/54c15bbf/uploads/origins/5454d512-df57-4b20-a07c-cff7ef8c6ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=189b0bb31674c684b4e0fcc332199ae7, https://si.imgix.net/54c15bbf/uploads/origins/5454d512-df57-4b20-a07c-cff7ef8c6ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5fd29ed8508b9110cf8317825af6cc5 2x, https://si.imgix.net/54c15bbf/uploads/origins/5454d512-df57-4b20-a07c-cff7ef8c6ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6182ac21bc9065602e7577dd3808c121 3x", "genre": "art", "nsfw": false, "body": "あんどう様\n\n平素は素敵シナリオにて大変お世話になっております。\n\n彁来の宮本シンが好きすぎて拗らせているのですが、最近見ている幻覚を是非描いていただきたくリクエストしております。\n\n【リクエスト内容】\nパン食い競争に参加する宮本シンとそれをうちの子であるHO3が応援しているシーンをお願いします。\n宮本シンのほか、うちの子にもジャージを着せていただけると幸いです。\nジャージについては指定はございませんので、描きやすいものを描いていただければと思います。\n\n--読まなくても問題のないあらすじ--\n運動会の出場種目決めで「宮本は足が速い」と言う理由でクラス対抗リレー、パン食い競争など複数種目に勝手にエントリーされていた。\n宮本シンがそのことについて抗議したところ、クラスメイトにせめてどれか一つに参加してほしいと懇願され、仕方なく「パン食い競争」を選ぶ。\nクラス対抗リレーを選ばなかったのは、放課後にリレー練習に参加するのが面倒だったからである。その点、パン食い競争は個人競技なので練習に参加する必要はなかった。\n\n運動会当日、ハチマキをつけジャージを着た宮本シンはパン食い競争に参加する。\n天気は快晴で、絶好の運動会日和である。\nスターターが鳴り、宮本シンは駆け出す。走ること自体は当然順調だった。\nしかし、その行く手を吊るされたパンが阻む。\n果たして、宮本シンは吊るされたパンを咥えることができるのか――。\n--あらすじ　おわり--\n\n・使用用途\n自陣の皆と鑑賞予定です。\n\nキャラクターシート\nhttps://iachara.com/view/8840837\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/12O6PpsrIIbnMyrkysi2yg9Ln-WNtLPhi?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tamagoDX1414/works/248", "thumbnail_src": "https://si.imgix.net/db6841bb/uploads/origins/1fa3d2b4-54d2-4064-ae59-517c904edbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d22dbf024ade9c92a3d9464328ae588d", "thumbnail_srcset": "https://si.imgix.net/db6841bb/uploads/origins/1fa3d2b4-54d2-4064-ae59-517c904edbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d22dbf024ade9c92a3d9464328ae588d, https://si.imgix.net/db6841bb/upload