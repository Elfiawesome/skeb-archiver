84fd-d08d94591ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ca5f2f31537950f515f2cf145795e4a", "thumbnail_srcset": "https://si.imgix.net/b224480e/uploads/origins/3e46d0da-ddd9-4636-84fd-d08d94591ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ca5f2f31537950f515f2cf145795e4a, https://si.imgix.net/b224480e/uploads/origins/3e46d0da-ddd9-4636-84fd-d08d94591ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bef731e9963bde0d28e5c47547fa49d 2x, https://si.imgix.net/b224480e/uploads/origins/3e46d0da-ddd9-4636-84fd-d08d94591ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=304cdb5a4011706ac38c26bd9b8e3ec2 3x", "genre": "art", "nsfw": false, "body": "サブズさん、こんにちは\n\nサブズさんの作品がとても好きです、よかったら私のOCを描いてください！🙇🏻‍♀️\n\nリンク内の【兄】をお願いします！\n彼は女性的な雰囲気の男性で、吸血鬼になった妹を飼っている\n\n受け入れていただけると嬉しいです、お読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1vqiN_CP6tg63vahC1YFYgPYqqOmlfSfA?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mokusubzu/works/308", "thumbnail_src": "https://si.imgix.net/25d6e788/uploads/origins/7f5292ca-d6a7-44fc-ba79-28eed4fc1f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9585adce128bc5795fe2fc0cd27ad0c", "thumbnail_srcset": "https://si.imgix.net/25d6e788/uploads/origins/7f5292ca-d6a7-44fc-ba79-28eed4fc1f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9585adce128bc5795fe2fc0cd27ad0c, https://si.imgix.net/25d6e788/uploads/origins/7f5292ca-d6a7-44fc-ba79-28eed4fc1f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2438bfbdab708de6553adc60d16c6a3a 2x, https://si.imgix.net/25d6e788/uploads/origins/7f5292ca-d6a7-44fc-ba79-28eed4fc1f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec72ebb92d02e78028605d745bb68239 3x", "genre": "art", "nsfw": false, "body": "初めまして！オリジナルキャラクターの男性を依頼したく、リクエストを送りました。\n\n目:三白眼っぽい切れ長の目で薄茶色。左目だけ瞳孔が無く上半分が深緑色・下半分が右目と同じ色の目\n表情：気だるい感じ\n髪型 : 肩甲骨下辺りまでの白髪おさげ\n 服装 : 第1ボタン開け黒シャツ・白スラックス・革靴・右手のみ手袋\n構図：おまかせ\nポーズ：おまかせ \nサイズ：おまかせ \nその他：鑑賞目的で使用させて頂きます\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1SSsRQSgCwTvz7ht9mOyKbUPoAIyUK2bN?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@mokusubzu/works/307", "thumbnail_src": "https://si.imgix.net/a9e82311/uploads/origins/12bcc337-f9cc-4c7d-9767-d2145f56ec58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1127f414c175ec9c02a270e721c8abc0", "thumbnail_srcset": "https://si.imgix.net/a9e82311/uploads/origins/12bcc337-f9cc-4c7d-9767-d2145f56ec58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1127f414c175ec9c02a270e721c8abc0, https://si.imgix.net/a9e82311/uploads/origins/12bcc337-f9cc-4c7d-9767-d2145f56ec58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b3b4b11bf1f56cb88bd75ed8f7c43fe 2x, https://si.imgix.net/a9e82311/uploads/origins/12bcc337-f9cc-4c7d-9767-d2145f56ec58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=618d3f0e5f4b4e5fd833cac461caf0ef 3x", "genre": "art", "nsfw": false, "body": "サブズ様はじめまして、リクエスト失礼いたします！\nいつも作品を楽しく拝見しております。特に白黒イラストの表現がとても大好きで、ぜひお願いできたら嬉しいです。\n\n■ キャラクター名：\nヴァニール（Vanir）\n\n■ 基本情報：\n・身長：190cm\n・年齢：33〜35歳\n・得意分野：語学、歴史、武術\n\n■ 性格・設定：\n魔術師や獣を狩る、名の知れた組織のカリスマ的リーダーです。\n妹を何よりも大切にしており、彼女を傷つけた者たちへの復讐を胸に生きています。\n\n豪快で自信家、いい酒・いい肉・いいセックスが大好きな男ですが、立場をわきまえるべき時はきちんと振る舞えるタイプです。\n頭の回転が速く、必要とあらば非常に狡猾。\n部下思いで面倒見がよく、その人柄ゆえに強い忠誠を集めています。\n\n一方で妹の前では驚くほど甘く、情けない一面もあります。\n過去の大事故で妹を守れなかった経験と、背中に残る大きな傷を今も引きずっています。\n彼女を守る力を得るために「レリック」を体に取り込みましたが、その代償として寿命が縮み、体も弱くなっています。\nそれでも戦場では“獣”のように恐ろしい存在です。\n\nまた、魔術過激派によって未来を奪われた孤児たちを引き取り、志願者には自らの部下として戦う術を教えています。\n\n■ 外見・特徴：\n・狼のような雰囲気\n・縦に裂けた瞳孔（猫・蛇のような目）\n・牙あり\n・両耳ピアス\n・アホ毛\n・尖った耳\n・胸や腕に多数の傷\n・筋肉質で大柄な体格（長身）\n\n※本来の瞳の色は青ですが、赤目は魔法によるものです（赤目を不吉だとする人々への皮肉）。\n\n■ 好きなもの：\n・美味しいお酒\n・肉料理\n・いいセックス\n・甘いもの\n・歴史を学ぶこと\n\n■ 苦手なもの：\n・苦い食べ物\n・書類仕事\n・最低な両親\n\n■ 補足：\nお洋服につきましては、参考資料内の 「１．ref clothes」 のデザインに沿って描いていただけますと幸いです。\n\n金額、内容等に不備がありましたら、ご遠慮なく再送、もしくはキャンセルしていただいて大丈夫です。\n\n構図やポーズ、雰囲気などはお任せします。\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-6OcHFNQCYL9NGxjibj1wYIWNQfAKjDX?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mokusubzu/works/306", "thumbnail_src": "https://si.imgix.net/84b0b9b3/uploads/origins/a6f6ae64-27ac-4670-904a-11015a17aa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33d6c03f26a5d2e67b5426896e20a4c", "thumbnail_srcset": "https://si.imgix.net/84b0b9b3/uploads/origins/a6f6ae64-27ac-4670-904a-11015a17aa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33d6c03f26a5d2e67b5426896e20a4c, https://si.imgix.net/84b0b9b3/uploads/origins/a6f6ae64-27ac-4670-904a-11015a17aa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a637bd76d34f54bcb5f596cd986816c 2x, https://si.imgix.net/84b0b9b3/uploads/origins/a6f6ae64-27ac-4670-904a-11015a17aa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6010496fce5a32e71a83e6a138818ece 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のキャラクター、シュウジとアイシュワリヤーのイラストをお願いしたいです。\n\nシュウジ\nhttps://drive.google.com/drive/folders/11hniCM1_d-MbtI0ND2AvqcNMac-HJhSA\n身長：175cm\n\nアイシュワリヤー\nhttps://drive.google.com/drive/folders/15Pltkhyvq_faDc83KjZ2766Jd1d9qGsk\n身長：170cm\n\n恋人同士の二人。ポーズも衣装も二息歩行と同じにしてほしい：\n\nhttps://static.wikia.nocookie.net/fansekai/images/b/b1/Nisokuhokou.png/revision/latest?cb=20240208163606\n\nhttps://images.genius.com/23490bb000cc298dae86c4690aeb667b.512x512x1.png\n\nシュウジは右の男の子のポーズと衣装で、アイシュワリヤーは左の女の子のポーズと衣装でお願いします。また、シュウジにはナイフを持ってもらいたい。彼の表情は驚いていて、彼女の表情は悲しげだが決意しているように。\n\n背景は\n1)人間失格の本からのランダムなテキスト\nまたは\n2) 水滴\n\nどちらもダメなら、背景は不要。", "created_at": "", "completed_at": ""}, {"path": "/@mokusubzu/works/305", "thumbnail_src": "https://si.imgix.net/c4760793/uploads/origins/465db3f4-0ab6-457b-a53a-88feb