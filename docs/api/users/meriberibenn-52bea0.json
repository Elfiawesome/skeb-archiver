novel/show.php?id=21057426#1\n\n以上何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@meriberibenn/works/219", "thumbnail_src": "https://si.imgix.net/3b9e8eee/uploads/origins/fcc5deff-e189-452e-a3cd-251b0947ee14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da57e683b7936b993c830d3b1a39985e", "thumbnail_srcset": "https://si.imgix.net/3b9e8eee/uploads/origins/fcc5deff-e189-452e-a3cd-251b0947ee14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da57e683b7936b993c830d3b1a39985e, https://si.imgix.net/3b9e8eee/uploads/origins/fcc5deff-e189-452e-a3cd-251b0947ee14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4315e67cf052ff36e3e8d6429d5b7c1c 2x, https://si.imgix.net/3b9e8eee/uploads/origins/fcc5deff-e189-452e-a3cd-251b0947ee14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66cffffe768bebd079207566192c5709 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@meriberibenn/works/218", "thumbnail_src": "https://si.imgix.net/4a62cfd7/uploads/origins/c1680327-78fd-494c-9156-9991ecc9f75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f06531c3d8028b34247bb08ae0bfa43", "thumbnail_srcset": "https://si.imgix.net/4a62cfd7/uploads/origins/c1680327-78fd-494c-9156-9991ecc9f75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f06531c3d8028b34247bb08ae0bfa43, https://si.imgix.net/4a62cfd7/uploads/origins/c1680327-78fd-494c-9156-9991ecc9f75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro