f-4b1a-8e0b-86ba14875fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9cc5d9d7b166a12affc00b6a695aecb 2x, https://si.imgix.net/08f2fad9/uploads/origins/6c90d9b7-ab2f-4b1a-8e0b-86ba14875fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e99fa3e8f179fbab2457ae9fabdb9150 3x", "genre": "art", "nsfw": false, "body": "初依頼です\nオンゲキの柏木咲姫と逢坂茜をお願いします\n\n咲姫側詳細\n衣装:Daybreak Angels\n構図:金と赤の豪華な椅子に座っている\n　　 椅子と身体は正面から10°~30°くらい斜め左向き\n　　 ポーズと表情はお任せします\n(椅子参考資料:https://www.ac-illust.com/main/detail.php?id=24209832)\n\n茜側詳細\n衣装:ひらり、宵桜\n構図:いちげき！(https://ongeki.sega.jp/manga/)の｢お花見'20 茜リサイタル in 花見｣の延長的な感じで段ボールに座っている\n　　 殲ちゃんがBOOTHに出している音ゲー下手くそシャツ(https://akane1023.booth.pm/items/4912093)の絵をSDから等身にするイメージでつまらなさそうな表情と足プラプラ\n　　 段ボールと身体は咲姫と逆向き\n\nもしよろしければ\n茜も咲姫と同じ豪華な椅子に座り、ワイングラス片手にドヤ顔\nの差分も頂けますと幸いです\n\n用途としては\nYouTubeでの動画の一部、サムネイル、Xでの動画企画開催告知、企画ルールブック等に使用します\n\n全て背景透過で、二人別々で椅子のみ,キャラのみも分けてPNGかPSDで納品して頂けるとありがたいです\n\nご検討宜しくお願い致します\n\nhttps://drive.google.com/drive/folders/1s8XN9NIdSplha061ABmNz79PHt2pFVeE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sen_art1023/works/78", "thumbnail_src": "https://si.imgix.net/322b7a41/uploads/origins/70688b18-2ac5-487d-b9c4-de5d0c8dd5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8193bcc15f9c3bc1bd2d889b5de55ef7", "thumbnail_srcset": "https://si.imgix.net/322b7a41/uploads/origins/70688b18-2ac5-487d-b9c4-de5d0c8dd5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8193bcc15f9c3bc1bd2d889b5de55ef7, https://si.imgix.net/322b7a41/uploads/origins/70688b18-2ac5-487d-b9c4-de5d0c8dd5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5b2763740b2498252c2895ed5cbba0a 2x, https://si.imgix.net/322b7a41/uploads/origins/70688b18-2ac5-487d-b9c4-de5d0c8dd5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b584f57552de489061da829ce44ac30 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sen_art1023/works/77", "thumbnail_src": "https://si.imgix.net/45bf5f7b/uploads/origins/34121693-8777-447a-9b0e-468c52bab980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df351a32c43c4b0f8a17b4c1b8a11040", "thumbnail_srcset": "https://si.imgix.net/45bf5f7b/uploads/origins/34121693-8777-447a-9b0e-468c52bab980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df351a32c43c4b0f8a17b4c1b8a11040, https://si.imgix.net/45bf5f7b/uploads/origins/34121693-8777-447a-9b0e-468c52bab980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41f52dc6c7846a8da805fad525a539e3 2x, https://si.imgix.net/45bf5f7b/uploads/origins/34121693-8777-447a-9b0e-468c52bab980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9328ea6fa23f9872c90372eac12d18e0 3x", "genre": "art", "nsfw": false, "body": "いつも魅力的なイラストありがとうございます!! またリクエストすることになりました😋\n\n今回に自分の好きなゲームキャラクターのイラストをお願いしたいです。 ゲーム「IDOLY PRIDE」中「一ノ瀬怜」の「アニマル風衣装　スイートレディ」を着て踊る瞬間のイラストをお願いしたいです！\nここに少し改変して、着ているジャケットについて片側の脇の素肌が見えるほど少し乱れている、ダイナミックなポーズの瞬間であってほしいです！\n特に全身イラストではなく上半身だけでも十分で、ステージ上で汗が飛び散るほど満足して楽しんでいる一瞬の姿を殲ちゃん様のスタイルで完成してほしいと願っています✨（瞳の色や髪の色、そしてサイド三つ編みリボンがトレードマークなのでこちらを少し気にしてくださったら嬉しいです）それ以外のポーズや構図については殲ちゃん様のご自由にお任せすると思うので是非よろしくお願いします！\n\n参考資料\nhttps://drive.google.com/drive/folders/1HmBqEq54Y_xZGUUiwonRJZ5CAtnvjRnl?usp=sharing\nhttps://idolypride.jp/character/rei-ichinose/\nhttps://idolypride.gamedbs.jp/chara/show/9/20\nhttps://x.com/idolypride/status/1832771601030623260\nhttps://www.youtube.com/watch?v=SYqWjo992-4\n\n普段お描きになっているジャンルとは少し違うものになりますが、スケジュールの余裕や意欲が出る際にご検討お願いしたいと思います！", "created_at": "", "completed_at": ""}, {"path": "/@sen_art1023/works/76", "thumbnail_src": "https://si.imgix.net/af0b8925/uploads/origins/047b4a6c-a750-429b-9e92-fe62ecdf5127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=071bdfb7c5c05f30b973498505659b53", "thumbnail_srcset": "https://si.imgix.net/af0b8925/uploads/origins/047b4a6c-a750-429b-9e92-fe62ecdf5127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=071bdfb7c5c05f30b973498505659b53, https://si.imgix.net/af0b8925/uploads/origins/047b4a6c-a750-429b-9e92-fe62ecdf5127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecfa01fd7cc701f33e239507e8b2becf 2x, https://si.imgix.net/af0b8925/uploads/origins/047b4a6c-a750-429b-9e92-fe62ecdf5127?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2bb5b5fd955d73641232ce0ea411524 3x", "genre": "art", "nsfw": false, "body": "こんにちは(」・ω・)\n殲ちゃん様にオリキャラを描いて欲しいと思い送らせてもらいました\n設定はTwitterのリンクを貼らせてもらいます\n（https://x.com/xl_kuzakihina/status/1970838519515128243?s=46&t=HvZvqkOjIm4XvPPewnMUVg）\n構図やシュチュエーションはおまかせします\nご検討よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@sen_art1023/works/75", "thumbnail_src": "https://si.imgix.net/618cc582/uploads/origins/fea530e9-ad3b-47d2-9d8c-4a5d104e9d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cbaf567ff2c45e63546ee5fefbd60e5", "thumbnail_srcset": "https://si.imgix.net/618cc582/uploads/origins/fea530e9-ad3b-47d2-9d8c-4a5d104e9d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cbaf567ff2c45e63546ee5fefbd60e5, https://si.imgix.net/618cc582/uploads/origins/fea530e9-ad3b-47d2-9d8c-4a5d104e9d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dcb033a4ac21431a795b03da36ddbb2 2x, https://si.imgix.net/618cc582/uploads/origins/fea530e9-ad3b-47d2-9d8c-4a5d104e9d66?bg=%23fff&auto=format%2Cco