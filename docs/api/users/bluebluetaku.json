23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c99fa31f3dbe0490be27ec878556bd1, https://si.imgix.net/c46303c2/uploads/origins/66de3b8e-7778-43b1-8d2d-e53150fb7968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61e6093661a98c3741965fad2afdaea4 2x, https://si.imgix.net/c46303c2/uploads/origins/66de3b8e-7778-43b1-8d2d-e53150fb7968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dec4c2552a5a13f7dcf32b503d7309d 3x", "genre": "art", "nsfw": true, "body": "楓神の千代に、他の写真と同じようなペイズリをお願いしたい。マスクはなし。\nhttps://www.pixiv.net/en/artworks/126680691\nhttps://pbs.twimg.com/media/GuDoM2XX0AAOzlP?format=jpg&name=orig\nhttps://pbs.twimg.com/media/GunqD0BXsAAG71M?format=png&name=orig\nhttps://pbs.twimg.com/media/GuD8CWRXcAAzfiG?format=jpg&name=orig", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/14", "thumbnail_src": "https://si.imgix.net/4846dcd8/uploads/origins/9361a1ac-20e0-480f-8cce-5660411101d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9602dc885717ffa3b684937792060b15", "thumbnail_srcset": "https://si.imgix.net/4846dcd8/uploads/origins/9361a1ac-20e0-480f-8cce-5660411101d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9602dc885717ffa3b684937792060b15, https://si.imgix.net/4846dcd8/uploads/origins/9361a1ac-20e0-480f-8cce-5660411101d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dad8f7d97722ea4cc4c5b7dccc1056fe 2x, https://si.imgix.net/4846dcd8/uploads/origins/9361a1ac-20e0-480f-8cce-5660411101d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29b76cc2d428ba8b3ce85b298e5da7e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/13", "thumbnail_src": "https://si.imgix.net/342a1950/uploads/origins/32ea390c-e016-4f88-aa7d-a740927674f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a521297e445c3947f63f8852f3e4a1", "thumbnail_srcset": "https://si.imgix.net/342a1950/uploads/origins/32ea390c-e016-4f88-aa7d-a740927674f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a521297e445c3947f63f8852f3e4a1, https://si.imgix.net/342a1950/uploads/origins/32ea390c-e016-4f88-aa7d-a740927674f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f328b204054248ecc360336accdcfa96 2x, https://si.imgix.net/342a1950/uploads/origins/32ea390c-e016-4f88-aa7d-a740927674f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89d47edef9a109c158449fbed469a285 3x", "genre": "art", "nsfw": true, "body": "ヌエの祓魔師のヌエ（1鵺）とガクロ（2夜島学郎）をお願いしたいです。両者とも後背位で、片方の手は胸を、もう片方の手は太もも辺りを掴んで欲しいです。どちらも横から見てほしい。\n\n1 https://files.catbox.moe/3ld6w5.jpg\n2 https://files.catbox.moe/dojv1l.jpg", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/12", "thumbnail_src": "https://si.imgix.net/923852aa/uploads/origins/c3f75f83-11a0-4bb2-9f5d-6b6044417d44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3db99004b7819c30ce059b64c714d36", "thumbnail_srcset": "https://si.imgix.net/923852aa/uploads/origins/c3f75f83-11a0-4bb2-9f5d-6b6044417d44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3db99004b7819c30ce059b64c714d36, https://si.imgix.net/923852aa/uploads/origins/c3f75f83-11a0-4bb2-9f5d-6b6044417d44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a9e3eefc1c3ea0ef2af4b769eee10a0 2x, https://si.imgix.net/923852aa/uploads/origins/c3f75f83-11a0-4bb2-9f5d-6b6044417d44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb73d3f56100c143632e0db1a1bcc531 3x", "genre": "art", "nsfw": true, "body": "私はあなたの以前のペイラの作品が好きで、私自身の淫らな要求をしたい。\n\n参考文献\nhttps://www.pixiv.net/en/artworks/115598171\nhttps://catbox.moe/c/rw4cgw\n\n\n一人称視点でパイズリをしているところを見てみたい。正面から見て、ペニスをすっぽり覆う横から胸を押し付けているような感じ（胸の大きさを少し強調）。 表情は誘惑的か興奮した感じで、できれば谷間の中で射精して、それに彼女が反応するというバリエーションも見てみたい。\n\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/11", "thumbnail_src": "https://si.imgix.net/e61788c5/uploads/origins/148e1265-0f40-4f77-88f9-d0d94bd086b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=584db28ca6c859091f2c74f28f81c299", "thumbnail_srcset": "https://si.imgix.net/e61788c5/uploads/origins/148e1265-0f40-4f77-88f9-d0d94bd086b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=584db28ca6c859091f2c74f28f81c299, https://si.imgix.net/e61788c5/uploads/origins/148e1265-0f40-4f77-88f9-d0d94bd086b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fffd046a690f8e299b321e42efa47d17 2x, https://si.imgix.net/e61788c5/uploads/origins/148e1265-0f40-4f77-88f9-d0d94bd086b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3c416f2493aeee7508217702b8d0f11 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nブルアカの蒼森ミネのR18イラストをお願いします。\n\n希望プレイ内容はパイズリフェラです。咥える形でも、舐めるだけでもどちらでも可です。\n構図はお任せしたいですが、乳首は露出させて下さい。\n可能であれば射精差分もお願いしたいです。差分の形が難しければ射精の瞬間のイラストのみお願いします。\n\n以上、ご検討下さい。", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/10", "thumbnail_src": "https://si.imgix.net/01a0b543/uploads/origins/108c3d25-b986-43f8-8203-c75ee34585a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78f9a3c752da1060b61f4278d83afecf", "thumbnail_srcset": "https://si.imgix.net/01a0b543/uploads/origins/108c3d25-b986-43f8-8203-c75ee34585a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78f9a3c752da1060b61f4278d83afecf, https://si.imgix.net/01a0b543/uploads/origins/108c3d25-b986-43f8-8203-c75ee34585a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d3dbba2801da15431db710764c0c43e 2x, https://si.imgix.net/01a0b543/uploads/origins/108c3d25-b986-43f8-8203-c75ee34585a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d0fd5c49ad2cd0b3b3abcc4fc8c1c74 3x", "genre": "art", "nsfw": true, "body": "サイズが小さめのブラを付けて乳圧高めのパイズリをするうちの子のナズナちゃんのイラストをお願いします。メカクレと黒いロングヘア、妖精のような羽が特徴で、積極的な性格の女の子です。\n\n参考資料として、これまでに描いていただいたうちの子のイラストを資料URLでまとめています。\n\nhttps://min.togetter.com/wI3W2e7", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/9", "thumbnail_src": "https://si.imgix.net/8e250e05/uploads/origins/320b8849-ac9a-4a33-bf1c-d08157878967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e5e679a9db853ee141f9c9e83265fce", "thumbnail_srcset": "https://si.imgix.net/8e250e05/uploads/origins/320b8849-ac9a-4a33-bf1c-d08157878967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e5e679a9db853ee141f9c9e83265fce, https://si.imgix.net/8e250e05/uploads/origins/320b8849-ac9a-4a33-bf1c-d08157878967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=978fd07df9688f85728fb4c666d04c77 2x, https://si.imgix.net/8e250e05/uploads/origins/320b8849-ac9a-4a33-bf1c-d08157878967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b774c5b2bd6fbbfd4bbc60b48e137a0 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n\n前回は素晴らしいイラストをありがとうございました。\n今回もまた「狼谷さん」を描いて欲しいです。\n\nキャラクター「狼谷さん」\nhttps://skeb.jp/@azarasinanoka/works/16\n\n描いて欲しいシチュエーション。\nトイレの個室で隠れながら立バックでセックスをしているシーンをお願いします。\n服装は制服は半裸でお願いします。下着などは脱げている、または無しで大丈夫です。\n狼谷さんは陥没乳首の設定ですが興奮して勃っている感じでお願いします。\nマスクはしたままでお願いします。（もし大丈夫でしたら前回のようにマスクなしもあると嬉しいです）\n胸のサイズは大きめで身体つきはムチムチした感じでお願いします。\n\n竿役のほうも制服ありでお願いします（竿役はそこまで目立たない感じでお願いします）\n\n立ちバックの構図はPixivに投稿されている「イオリとシャワー」のような構図でお願いします。\nhttps://www.pixiv.net/artworks/117525547\n\n以上となります。\nよろしければご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/8", "thumbnail_src": "https://si.imgix.net/08c6af87/uploads/origins/298700b0-0614-4974-9c49-72ff60ceaf3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=018ccdcbbe0d05d1154c15e552126656", "thumbnail_srcset": "https://si.imgix.net/08c6af87/uploads/origins/298700b0-0614-4974-9c49-72ff60ceaf3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=018ccdcbbe0d05d1154c15e552126656, https://si.imgix.net/08c6af87/uploads/origins/298700b0-0614-4974-9c49-72ff60ceaf3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a8eb64cc7d5a0adaa543ca30ff8c014 2x, https://si.imgix.net/08c6af87/uploads/origins/298700b0-0614-4974-9c49-72ff60ceaf3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=857096e29874848001f073a54f52705c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bluebluetaku/works/7", "thumbnail_src": "https://si.imgix.net/d997b718/uploads/origins/8db813e8-3be3-4762-a03c-990d3e61410d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ca8a3c9cc6c6467146d67f630704b3", "thumbnail_srcset": "https://si.imgix.net/d997b718/uploads/origins/8db813e8-3be3-4762-a03c-990d3e61410d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ca8a3c9cc6c6467146d67f630704b3, https://si.imgix.net/d997b718/uploads/origins/8db813e8-3be3-4762-a03c-990d3e61410d?bg=%23fff&auto=fo