69%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c44f74769f3d8816104a3d97b43ede20 3x", "genre": "voice", "nsfw": false, "body": "ボイスのお願いです\n主題：日曜日の夜に明日仕事なのに寝ようとしないでいるのを寝るように叱咤激励する形でお願いします\nキャラ設定：隣に住む世話焼きの幼馴染\n呼び名：きみ\n内容量：1分程度のもの\n詳しい台本：申し訳ないですがフレアさんの方で決めてください、その分も含めての値段とします", "created_at": "", "completed_at": ""}, {"path": "/@flarerune/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18fbad450c30fd40e68221c5003c2802", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18fbad450c30fd40e68221c5003c2802, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3463f46e7378479e15e871202a4a34c5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c44f74769f3d8816104a3d97b43ede20 3x", "genre": "voice", "nsfw": false, "body": "「おかえりなさい。今日はどんな1日だった？……うんうん、そっか。いっぱい頑張ったんだね。よしよし、いい子いい子。…ん？ふふっ、しょうがないなぁ。もう少しだけよしよししててあげるから、また明日から頑張ろうね。」\n以上のセリフをフレア君でお願いします！セリフを改変していただいても大丈夫です。\n泣いてる子供を慰めてあげるような優しい感じで読んでもらえると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@flarerune/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18fbad450c30fd40e68221c5003c2802", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18fbad450c30fd40e68221c5003c2802, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3463f46e7378479e15e871202a4a34c5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2029547485593837569%2FKDAvCR4R.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c44f74769f3d8816104a3d97b43ede20 3x", "genre": "voice", "nsfw": false, "body": "こんにちはフレア・ルーン。わたしは最近とても疲れています。仕事をしなければならないのですがやる気が起きず、すぐに手元のiPadでgameをplayしてしまいます。しかし、そのゲームも日々のmissionが辛く感じてきました。こんな怠け者のわたしでも愛する人の応援で立ち上がれる気がします。どうか一言励ましを与えてくださるとわたしは大いに喜びます。", "created_at": "", "completed_at": ""}, {"path": "/@flarerune/works/4", "thumbnail_src": "https://si.imgix.net/b0e2ba09/uploads/origins/9044462c-7c0e-44a1-aa6c-06e0440dbee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cb700bc6e9f27424b2c912604bfdca0", "thumbnail_srcset": "https://si.imgix.net/b0e2ba09/uploads/origins/9044462c-7c0e-44a1-aa6c-06e0440dbee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cb700bc6e9f27424b2c912604bfdca0, https://si.imgix.net/b0e2ba09/uploads/origins/9044462c-7c0e-44a1-aa6c-06e0440dbee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9b306c0069716b8894504879384481d 2x, https://si.imgix.net/b0e2ba09/uploads/origins/9044462c-7c0e-44a1-aa6c-06e0440dbee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b61830b63f2e7eca0a22f161ae0b68c3 3x", "genre": "art", "nsfw": false, "body": "こんにちは、フレアちゃん～\n\n今回が初めてのskeb依頼なので、正しくできていることを祈ります\n式部めぐりさんのかわいい系の絵をお願いしたいです.\n三面図は以下のリンクからご覧いただけます.\nhttps://twitter.com/cuon20/status/1442862652372312066\n\nhttps://twitter.com/cuon20/status/1442862652372312066", "created_at": "", "completed_at": ""}, {"path": "/@flarerune/works/3", "t