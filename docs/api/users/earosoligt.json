c0-8e61-25db3f149b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e089f7e8187fca31ac91a7d34b776a0f", "thumbnail_srcset": "https://si.imgix.net/47ead45d/uploads/origins/a27750c1-3f4e-49c0-8e61-25db3f149b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e089f7e8187fca31ac91a7d34b776a0f, https://si.imgix.net/47ead45d/uploads/origins/a27750c1-3f4e-49c0-8e61-25db3f149b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0970537aa6b262362b7bfda9e79aed0d 2x, https://si.imgix.net/47ead45d/uploads/origins/a27750c1-3f4e-49c0-8e61-25db3f149b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fd06f5e36acedb0eae52edccedc2e3b 3x", "genre": "art", "nsfw": true, "body": "差し支え無ければ、資料URLの続きとして、ブルアカのミヤコがお掃除？フェラで尿道に残った精液を根こそぎ吸い尽くそうとしているところを、カラーの漫画形式で描いていただきたいです。\n\n\n・希望のシチュは以下の通りです。多少改変したり削っても構いません。\n①前回の射精から、咥えたまま精液をゴクゴク飲み込む。\n②竿を口から離す。\n③まだ尿道から精液が出てくるので、全て吸い尽そうと亀頭を咥える。\n④ミヤコの可愛さが残った軽めのひょっとこ顔で、竿をぢゅ〜〜〜っと長めのバキュームで吸い上げ、後ろにグググっと引っ張る。\n・ミヤコが横顔となるアングルと竿役の主観の2カット(2コマ)を描いていただき、上下に配置していただきたいです。\n⑤ぽん！と音を立てながら竿を引き抜く\n\n・「ぢゅ〜〜〜っぽん」という竿を吸い上げてから引き抜くまでの一連の効果音を、④と⑤のコマを通して配置してください(資料URL参照)。効果音の始めの文字を④の始めのコマ、効果音の最後の文字を⑤に配置してください。\n\n・その他のセリフや効果音等は適当に付けてください。先生の「ちんこもげちゃう」や「もう出たからぁ」のような情けないセリフがあると嬉しいです。\n\n\n以上です。\n不躾な要求で大変恐縮ですが、ご一考いただけると幸いです。\nよろしくお願い申し上げます。\n\nhttps://skeb.jp/@earosoligt/works/11\nhttps://skeb.jp/@tshangen/works/100", "created_at": "", "completed_at": ""}, {"path": "/@earosoligt/works/15", "thumbnail_src": "https://si.imgix.net/425558fd/uploads/origins/01e9e674-3daa-415e-abf3-b6d18246647d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03ba0c681572a32fc79056016b78b64b", "thumbnail_srcset": "https://si.imgix.net/425558fd/uploads/origins/01e9e674-3daa-415e-abf3-b6d18246647d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03ba0c681572a32fc79056016b78b64b, https://si.imgix.net/425558fd/uploads/origins/01e9e674-3daa-415e-abf3-b6