o7q0sUf5zZ7XUZ28_8?rlkey=q4bk1cvba5vaozwlnz06g8jp5&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@zummmy58/works/12", "thumbnail_src": "https://si.imgix.net/8002c95c/uploads/origins/61aa7cd0-d4f8-4953-968a-cb1c11e0f275?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=72143666e4c222a65f16bd2041001542", "thumbnail_srcset": "https://si.imgix.net/8002c95c/uploads/origins/61aa7cd0-d4f8-4953-968a-cb1c11e0f275?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=72143666e4c222a65f16bd2041001542, https://si.imgix.net/8002c95c/uploads/origins/61aa7cd0-d4f8-4953-968a-cb1c11e0f275?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=437e249df35e7dd7468a77e8f67b731b 2x, https://si.imgix.net/8002c95c/uploads/origins/61aa7cd0-d4f8-4953-968a-cb1c11e0f275?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a26aca819972c666318765934ad22e4 3x", "genre": "art", "nsfw": false, "body": "はじめまして！TLでお見かけしてかわいいイラストだなと思ったのでぜひ依頼をさせて頂きたいです！\n\n可能でしたらこちらのリンク先にあるキャラ(自分のデフォルメキャラ)のGIFアニメを依頼したいです！\n内容はおまかせしたいです！お酒飲んでるとか泣いてるとか二日酔いとか…のイメージが強いかなと思います…\n\nhttps://www.icloud.com/sharedalbum/#B0QGY8gBYiaRk2\n\n宜しければよろしくお願い致しますm(_ _  )m", "created_at": "", "completed_at": ""}, {"path": "/@zummmy58/works/11", "thumbnail_src": "https://si.imgix.net/d2a5e1a1/uploads/origins/7fc4d829-6ca3-4dee-90c3-8814bc5cd9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a1fb2e256a1b8e2894b81fdbfb32ca", "thumbnail_srcset": "https://si.imgix.net/d2a5e1a1/uploads/origins/7fc4d829-6ca3-4dee-90c3-8814bc5cd9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a1fb2e256a1b8e2894b81fdbfb32ca, https://si.imgix.net/d2a5e1a1/uploads/origins/7fc4d829-6ca3-4dee-90c3-8814bc5cd9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4abb0891bff1e2cb3ec259c140b4fd24 2x, https://si.imgix.net/d2a5e1a1/uploads/origins/7fc4d829-6ca3-4dee-90c3-8814bc5cd9d7?bg=%23fff&auto=format%2Ccompress&fm=w