fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=685495702547fd429b051c2651633122", "thumbnail_srcset": "https://si.imgix.net/18f43b0f/uploads/origins/722b6e41-1bb8-44d9-be1d-9569a79cbae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=685495702547fd429b051c2651633122, https://si.imgix.net/18f43b0f/uploads/origins/722b6e41-1bb8-44d9-be1d-9569a79cbae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46e9d93a224281396185b7132655c04c 2x, https://si.imgix.net/18f43b0f/uploads/origins/722b6e41-1bb8-44d9-be1d-9569a79cbae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1fe58183aa3d79b4803f7e30f1b8a15 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのアートスタイルが本当に大好きです。\n\ntouhou projectのやしきたかじんの絵をリクエストしたいのですが、好きなポーズで描いてください。\n\nPlease and thank you !!!", "created_at": "", "completed_at": ""}, {"path": "/@shitace1/works/13", "thumbnail_src": "https://si.imgix.net/5ca745ec/uploads/origins/90b9e62c-f492-4f26-b6da-e7976dfdf687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91bfc8b87771bdb1aa91ef44d303ee1d", "thumbnail_srcset": "https://si.imgix.net/5ca745ec/uploads/origins/90b9e62c-f492-4f26-b6da-e7976dfdf687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91bfc8b87771bdb1aa91ef44d303ee1d, https://si.imgix.net/5ca745ec/uploads/origins/90b9e62c-f492-4f26-b6da-e7976dfdf687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9a3be561754eb666b9e97a9c90ce89b 2x, https://si.imgix.net/5ca745ec/uploads/origins/90b9e62c-f492-4f26-b6da-e7976dfdf687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fae03e13bb0eaa67478c5279a1a2586 3x", "genre": "art", "nsfw": false, "body": "制服を着た女子学生2人が泥んこになってしまったイラストをお願いいたします。\n\nシチュエーションは、泥沼に落ちてしまったA（一人目の女の子）をB（二人目の女の子）が手を握って引き上げようとする場面と、泥まみれになってしまった二人が仲良さそうにピースをしている場面です。\n\n女の子の見た目は、\nA…ポニーテールの優しい優等生キャラ。ブレザー・制服リボン・チェック柄スカート・紺ハイソ・茶ローファー。\nB…サイドテールのフレンドリーなギャルっぽいキャラ。セーラー・制服リボン・カーディガン・カーディガンからぎりぎり見えるミニスカート・ルーズソックス・黒ローファー。\n\n汚れ方は、Aは肩から泥に落ちたような半身をメインに泥にまみれた状態（このような感じhttps://www.pixiv.net/artworks/103561904）で、BはただAを引き上げるだけなので膝から下が汚れるような感じです。\n\nピースの場面ではBがAの腕を組んで、Aの泥をBの制服にべっとりつけてほしいです。\n二人の足元には泥の足跡と、したたり落ちた泥をお願いします。\n\nしたせ様のMessy絵がとても魅力的で好みです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shitace1/works/12", "thumbnail_src": "https://si.imgix.net/224a35d1/uploads/origins/35c98e94-d4a9-413d-9fc0-87a757afbd62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=952dfcb5f7658a46ee4f163cd7655963", "thumbnail_srcset": "https://si.imgix.net/224a35d1/uploads/origins/35c98e94-d4a9-413d-9fc0-87a757afbd62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=952dfcb5f7658a46ee4f163cd7655963, https://si.imgix.net/224a35d1/uploads/origins/35c98e94-d4a9-413d-9fc0-87a757afbd62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7c576849496b256f6dc5fc75b32f020 2x, https://si.imgix.net/224a35d1/uploads/origins/35c98e94-d4a9-413d-9fc0-87a757afbd62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e5cba75d8b72660a21467214caafb25 3x", "genre": "art", "nsfw": false, "body": "いつもしたせさんのイラストを楽しみにしています！！\nしたせさんの絵柄でのチルノの亜種ナインボールを依頼させていただきます！！\n\n参考資料(文章)\n.シェイプシフター\n.羽根は濃い灰色で溶けている\n.目は赤く光っている\n.赤いネクタイ\n.腰に赤いボタンがある\n.靴はブーツ\n\n内容\n\n1薄暗い紅魔館で顔の半分、腕の部分を霊夢に変異させたナインボールがハルバード(斧槍)を持って不敵に笑っている\n\n2くらぴ風ナインボール\n\nお忙しいとは思いますがどうかよろしくお願いいたします！！！\n\nhttps://twitter.com/SatanNeutral/status/1608278423981666305?t=tK18rAZy6rt7AjVLEwlU2w&s=19", "created_at": "", "completed_at": ""}, {"path": "/@shitace1/works/11", "thumbnail_src": "https://si.imgix.net/1b42cb1d/uploads/origins/785ec5b8-15c5-4a2c-b99f-e8d82b43d376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de1df370e278c7f1ea88222ac247be8", "thumbnail_srcset": "https://si.imgix.net/1b42cb1d/uploads/origins/785ec5b8-15c5-4a2c-b99f-e8d82b43d376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de1df370e278c7f1ea88222ac247be8, https://si.imgix.net/1b42cb1d/uploads/origins/785ec5b8-15c5-4a2c-b99f-e8d82b43d376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d45492246ef6f5db6a3b9045d08a6f52 2x, https://si.imgix.net/1b42cb1d/uploads/origins/785ec5b8-15c5-4a2c-b99f-e8d82b43d376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4a3b0b636e0648e7b7d252d520ca0de 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のリクエストを考慮していただきありがとうございます\n\n前回の依頼は、衣替えをしたいのでキャンセルさせていただきましたが、お許しください。\n\n車掌さんのナイチンゲールの衣装を着た初音ミクが、茶色い泥にまみれて楽しそうに遊んでいるイラストを描いてください。構図はおまかせします。\n\n可能であれば、泥まみれになる前の違いも描いてほしいです。\n\nありがとうございました。\n\nhttps://static.wikia.nocookie.net/project-diva/images/4/47/Train_Conductor_Nightingale.png", "created_at": "", "completed_at": ""}, {"path": "/@shitace1/works/10", "thumbnail_src": "https://si.imgix.net/bddbefaf/uploads/origins/e222b025-14ba-490b-92e3-65246b40e494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11992b430145e867b1db97b31c3cbbdf", "thumbnail_srcset": "https://si.imgix.net/bddbefaf/uploads/origins/e222b025-14ba-490b-92e3-65246b40e494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11992b430145e867b1db97b31c3cbbdf, https://si.imgix.net/bddbefaf/uploads/origins/e222b025-14ba-490b-92e3-65246b40e494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd4bf1238d335c6603874c39985cc7e7 2x, https://si.imgix.net/bddbefaf/uploads/origins/e222b025-14ba-490b-92e3-65246b40e494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f22f059011259a006212ea0601cf97b3 3x", "genre": "art", "nsfw": false, "body": "ウサギにコスプレーした妖精の初詣", "created_at": "", "completed_at": ""}, {"path": "/@shitace1/works/9", "thumbnail_src": "https://si.imgix.net/bb9e748f/uploads/origins/a6ca7669-3549-4790-bca5-71bba1083a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr