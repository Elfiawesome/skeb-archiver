f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8157b5d905d7509f35d3d4b40e656ab, https://si.imgix.net/f0f5e380/uploads/origins/dc19fbdf-7364-4358-b7ee-65daa921e199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fe67031fcb7b1e8d26028207e6cda27 2x, https://si.imgix.net/f0f5e380/uploads/origins/dc19fbdf-7364-4358-b7ee-65daa921e199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=485bf6d1cbe6640b3b56cbe85c1165b7 3x", "genre": "art", "nsfw": true, "body": "こんにちは、tanarouさん。\n\nまたこのドラゴンの写真が欲しいです、以前のように筋肉質で。\n\nhttps://www.dropbox.com/sh/x9ijfcq9sewzvi1/AAA4cCiSkYciXAM5pbEe_d1va?dl=0\n\n首から下を保護する液体ゴムのハイテク・ヒーロー・スーツを着ているところを見せびらかし、楽しんでもらいたい。しかし、その後、驚きの機能が作動し、彼の頭も覆い密閉し、彼をセックスのおもちゃのドローンに変えてしまう。視聴者に奉仕した後、スーツは元に戻り、彼は何が起こったのか全く覚えていない。\n\n私は彼に大きなペニスを持たせたいのですが、あなたが最近描いた彼の絵のように。ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/20", "thumbnail_src": "https://si.imgix.net/6c92a9b5/uploads/origins/96afb3c0-1733-4bb7-8044-7b1be6fe60ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a005e850ea1160e6f92545b88fe1b593", "thumbnail_srcset": "https://si.imgix.net/6c92a9b5/uploads/origins/96afb3c0-1733-4bb7-8044-7b1be6fe60ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a005e850ea1160e6f92545b88fe1b593, https://si.imgix.net/6c92a9b5/uploads/origins/96afb3c0-1733-4bb7-8044-7b1be6fe60ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94f25e0ff3c6211c8b347699df1cae0b 2x, https://si.imgix.net/6c92a9b5/uploads/origins/96afb3c0-1733-4bb7-8044-7b1be6fe60ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0503cd1d7d68198161a7fdb256256b1 3x", "genre": "art", "nsfw": true, "body": "こんにちは、tanarouさん。\n\nまたこのドラゴンをお願いしたいのですが、以前と同じように筋肉質な体でお願いします。\n\nhttps://www.dropbox.com/sh/x9ijfcq9sewzvi1/AAA4cCiSkYciXAM5pbEe_d1va?dl=0\n\nこんな感じの服装でお願いします。\n\nhttps://www.dropbox.com/scl/fi/7xcwgku0mfwjxmq5evkmq/MPD.jpg?rlkey=ql8903ame2w0inc08loibcuvt&dl=0\n\nゴムの鞘は彼のペニスを常に勃起させて準備万端にしておき、バイザーは催眠術で自分が良いヒーローであるかのように思わせておく。", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/19", "thumbnail_src": "https://si.imgix.net/7d684118/uploads/origins/974df06b-e1e5-4088-adb2-07d0e9d18ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55cf365624f894678f1b6bb489c85e25", "thumbnail_srcset": "https://si.imgix.net/7d684118/uploads/origins/974df06b-e1e5-4088-adb2-07d0e9d18ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55cf365624f894678f1b6bb489c85e25, https://si.imgix.net/7d684118/uploads/origins/974df06b-e1e5-4088-adb2-07d0e9d18ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e42645d28ca02a283a335a3ad997ec40 2x, https://si.imgix.net/7d684118/uploads/origins/974df06b-e1e5-4088-adb2-07d0e9d18ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68a9b14128df7dd88441505b53ead28b 3x", "genre": "art", "nsfw": false, "body": "はじめまして！うちの子のイラスト作成をお願いしたいです。\n年齢は30代　種族は狼犬　元ガテン系で現在は福祉関係のお兄さん\n構図や背景は表情はお任せします。尻尾は見えているほうが嬉しいです。\n服装は夏に向けて薄着でお願い出来たらと思います。\n参考画像はAIでなんとか自分のイメージを作成したものとウチの子イラストで描いて頂いたものです。AIの方は服装等におかしい部分がありますがよろしくお願いします。\nXやヘッダー等のアイコンや参考画像の資料に使用したいと思っています。\n頂いた画像は一切AI学習は致しません。\n\nhttps://twitter.com/sin004565/status/1761246435520221471?t=n6n1KicKXmQ3unk9T8nL9g&s=19\n\nhttps://twitter.com/sin004565/status/1761246435520221471?t=n6n1KicKXmQ3unk9T8nL9g&s=19", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/18", "thumbnail_src": "https://si.imgix.net/a0284060/uploads/origins/2ac8430b-dc60-46ae-a7e9-21291f2c2b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c191777f63f8da94a943b5dec97b977e", "thumbnail_srcset": "https://si.imgix.net/a0284060/uploads/origins/2ac8430b-dc60-46ae-a7e9-21291f2c2b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c191777f63f8da94a943b5dec97b977e, https://si.imgix.net/a0284060/uploads/origins/2ac8430b-dc60-46ae-a7e9-21291f2c2b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89eebca506ac5df488421f959bdada7e 2x, https://si.imgix.net/a0284060/uploads/origins/2ac8430b-dc60-46ae-a7e9-21291f2c2b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=007d80387c1e7e5ea419a930ee783c9f 3x", "genre": "art", "nsfw": true, "body": "こんにちは、以前お願いした聖職者の獣人の写真をお願いしたいのですが。\n\nhttps://skeb.jp/@RaYbaf8nb9vwzPv/works/17\n\n状況お任せします。", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/17", "thumbnail_src": "https://si.imgix.net/aaa2f136/uploads/origins/87fe4c14-e25d-4c7e-a2b7-dccfde042b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78751b97769fa266243b7725cb124e00", "thumbnail_srcset": "https://si.imgix.net/aaa2f136/uploads/origins/87fe4c14-e25d-4c7e-a2b7-dccfde042b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78751b97769fa266243b7725cb124e00, https://si.imgix.net/aaa2f136/uploads/origins/87fe4c14-e25d-4c7e-a2b7-dccfde042b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5fa7318a168644c24b1ebfa2e640640 2x, https://si.imgix.net/aaa2f136/uploads/origins/87fe4c14-e25d-4c7e-a2b7-dccfde042b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c8bca09564fe166b483a9bdf29df3f9 3x", "genre": "art", "nsfw": true, "body": "こんにちは、以前お願いした聖職者の獣人の写真をお願いしたいのですが。\n\nhttps://skeb.jp/@RaYbaf8nb9vwzPv/works/14\n\n最初の画像と同じ服装で描いてください。\n\nシチュエーションとしては、パンツを下ろして発情期のように必死にオナニーしているところを描いてほしい。聖書を持っている姿も描いてください。それ以外は自由にしてください。\n\nできれば全裸バージョンもお願いします。\n\n他のバージョンも自由に追加してください。", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/16", "thumbnail_src": "https://si.imgix.net/9b2aead9/uploads/origins/0ec120da-db6f-42f8-b9bb-7c0ad55af06a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd882066745f57899d56e3e13f36f454", "thumbnail_srcset": "https://si.imgix.net/9b2aead9/uploads/origins/0ec120da-db6f-42f8-b9bb-7c0ad55af06a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd882066745f57899d56e3e13f36f454, https://si.imgix.net/9b2aead9/uploads/origins/0ec120da-db6f-42f8-b9bb-7c0ad55af06a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5f684a92bd807c3f60be1c50a71de05 2x, https://si.imgix.net/9b2aead9/uploads/origins/0ec120da-db6f-42f8-b9bb-7c0ad55af06a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d9661da0d2b4992c91c715a769bc246 3x", "genre": "art", "nsfw": true, "body": "こんにちは、tanarouさん。\n\n私はこのドラゴンをカメラに収めたい。ライブストリームか録画で、彼が視聴者やフォロワーに応えるような形で。リクエストはエロティックなもので、チンコを見せびらかしたり、オナニーをするよう求めるのですが、彼は拒否します。しかし、催眠術をかけられているため、彼の身体は自動的に要求に従うように反応するが、彼はそれに気づかないように訓練されており、丁寧に断ったり、興味を持ってくれた視聴者に感謝したりすることで普通に対応する。\n\n彼の体型は変えられる。筋肉質にしてほしい。また、可能であれば日本語のテキストを追加することもできる。\n\nhttps://www.dropbox.com/sh/x9ijfcq9sewzvi1/AAA4cCiSkYciXAM5pbEe_d1va?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/15", "thumbnail_src": "https://si.imgix.net/1907d166/uploads/origins/d20b8f46-8da3-4aa8-a28f-215cbc539aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9deb689deca5ec3afc68de5cd7ee6366", "thumbnail_srcset": "https://si.imgix.net/1907d166/uploads/origins/d20b8f46-8da3-4aa8-a28f-215cbc539aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9deb689deca5ec3afc68de5cd7ee6366, https://si.imgix.net/1907d166/uploads/origins/d20b8f46-8da3-4aa8-a28f-215cbc539aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf03f77abdeae546622de506844c8198 2x, https://si.imgix.net/1907d166/uploads/origins/d20b8f46-8da3-4aa8-a28f-215cbc539aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fe7115148eca7df7bfc12b7dab26709 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のオリジナルキャラクター（https://drive.google.com/file/d/1qBf_KHQy8Q7A8Vaqs41_BOi7X9MzNTLx/view?usp=drive_link）を描いてほしいです。\n\n私のキャラクターは反抗的で、いじわるな性格のチンピラで、この参考画像のように光沢のあるラテックスのトラックスーツを着て、磨いたラバーのトレーナーを履いています：\n\n(https://imgur.com/10Ae8ov)\n(https://imgur.com/EipYE7L)\n(https://imgur.com/wugPF5a)\n\nこの参考資料（https://imgur.com/kAQzpYd）のように、テーブルのようなものや屋外の階段のようなものの上に座りながら、私のキャラクターの体と衣装を見せるポーズを希望します。私のキャラクターは舌を出し、舌ピアスを見せびらかす必要があります。\n\n作品の別バージョンも欲しいです：私のオリジナル・キャラクターに、光沢のあるラテックスで作られた別のコスチュームを着せたい： (https://drive.google.com/file/d/11ANuA24PuQrQjshIzt3gJgMp29YNXBxG/view?usp=drive_link) (https://drive.google.com/file/d/1_thczdB18ToBQOxKoeXTvdLybUvFo4-G/view?usp=drive_link)", "created_at": "", "completed_at": ""}, {"path": "/@RaYbaf8nb9vwzPv/works/14", "thumbnail_src": "https://si.imgix.net/7b5e579b/uploads/origins/f06b69e7-e2a3-46f0-b87e-159b4b03951c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b229a1c5f63d140025de19864777706", "thumbnail_srcset": "https://si.imgix.net/7b5e579b/uploads/origins/f06b69e7-e2a3-46f0-b87e-159b4b03951c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b229a1c5f63d140025de19864777706, https://si.imgix.net/7b5e579b/uploads/origins/f06b69e7-e2a3-46f0-b87e-159b4b03951c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff2dec10635478eaff68f187c547cc2d 2x, https://si.imgix.net/7b5e579b/uploads/origins/f06b69e7-e2a3-46f0-b87e-159b4b03951c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1bebe34ec57f54bbc2beaa0a4d9ce30 3x", "genre": "art", "nsfw": true, "body": "こんにちは、以前お願いした吸血鬼と聖職者の獣人の写真をお願いしたいのですが。\n\nhttps://skeb.jp/@RaYbaf8nb9vwzPv/works/10\n\n二人の獣人がセックスしているところを描いてください。差し支えなければ体位などはお任せします！", "created_at": "", "completed_at": ""}]}