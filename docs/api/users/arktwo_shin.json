fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=026713764b016251475c4cbbde7b1a1e 3x", "genre": "art", "nsfw": true, "body": "『漆黒のシャルノス』の主人公である『メアリ・クラリッサ・クリスティ嬢』のブレイブルー風感電イラストをリクエストさせて下さい。 ポーズはブレイブルーシリーズのノエル、プラチナ、Esの感電ポーズで、それぞれ着衣・全裸・骨格の差分をいただきたく存じます。", "created_at": "", "completed_at": ""}, {"path": "/@arktwo_shin/works/55", "thumbnail_src": "https://si.imgix.net/6955eac9/uploads/origins/9664de4d-1fee-487c-96be-2a18f018f1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649d5ed2f3911c5b746c35af6e7d0dc8", "thumbnail_srcset": "https://si.imgix.net/6955eac9/uploads/origins/9664de4d-1fee-487c-96be-2a18f018f1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649d5ed2f3911c5b746c35af6e7d0dc8, https://si.imgix.net/6955eac9/uploads/origins/9664de4d-1fee-487c-96be-2a18f018f1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb459aa8d02c72dd5518c7ca7af70a48 2x, https://si.imgix.net/6955eac9/uploads/origins/9664de4d-1fee-487c-96be-2a18f018f1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=261d7d46b856ea60b20cc6b2d3deb827 3x", "genre": "art", "nsfw": false, "body": "匿名リクエスト失礼します\nボイスロイドの弦巻マキさんの感電絵を依頼させていただきます。\nポーズは内股で表情はよく使っていらっしゃる\"https://skeb.jp/@arktwo_shin/works/19\"\nと同じ表情でお願いします\nビリビリしてる体は全体を描いてほしいです\n衣装はこの衣装でお願いします↓\nhttps://www.ah-soft.com/images/products/maki/maki-guest-oohenri.png\nhttps://lohas.nicoseiga.jp/thumb/5879945i\nhttps://i1.sndcdn.com/artworks-000206007886-mtzt1u-t500x500.jpg", "created_at": "", "completed_at": ""}, {"path": "/@arktwo_shin/works/54", "thumbnail_src": "https://si.imgix.net/a7793506/uploads/origins/a67ce465-5ae5-4b96-846a-0fee213bcbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f023be677cd6f8dd7c0aec21b56ca7dd", "thumbnail_srcset": "https://si.imgix.net/a7793506/uploads/origins/a67ce465-5ae5-4b96-846a-0fee213bcbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f023be677cd6f8dd7c0aec21b56ca7dd, https://si.imgix.net/a7793506/uploads/origins/a67ce465-5ae5-4b96-846a-0fee213bcbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a0c3e5a493ef72b879db9306c4e2926 2x, https://si.imgix.net/a7793506/uploads/origins/a67ce465-5ae5-4b96-846a-0fee213bcbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e61cfa6b5bc43a422e7e002b4b1b89e2 3x", "genre": "art", "nsfw": true, "body": "ファイナルファンタジー10からユウナの感電骨透けイラストをリクエストさせて下さい。 全身が見える2パターンで服有り(衣装はFF10のもの)・全裸・骨透けの差分をいただきたいです。１つは内股ポーズをお願いしたいです。 シチュエーションとしては、サンダープリン(同作に出現する帯電したスライムの様なモンスター)に接触してビリビリッといった感じでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@arktwo_shin/works/53", "thumbnail_src": "https://si.imgix.net/c067fef5/uploads/origins/f87acc0c-2d06-497f-87b3-2f61c369f242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c188fd65c2f817d2b57e548d2c54f16d", "thumbnail_srcset": "https://si.imgix.net/c067fef5/uploads/origins/f87acc0c-2d06-497f-87b3-2f61c369f242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c188fd65c2f817d2b57e548d2c54f16d, https://si.imgix.net/c067fef5/uploads/origins/f87acc0c-2d06-497f-87b3-2f61c369f242?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb5cf629f623f39620033a94b3128e24 2x, https://si.imgix.net/c067fef5/uploads/origins/f87acc0c-2d06-497f-87b3-2f61c369f242?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea66e37db41a5333683aab5547c22374 3x", "genre": "art", "nsfw": true, "body": "にじさんじの五十嵐梨花が、ファミレスで俺くんと向かい合って座っているシチュで、テーブルの下で足コキをして射精させるシチュをお願いします。\n俺くんはズボンを履いたままチャックを開けてちんこだけ出しているイメージです。\n五十嵐の方は、ブーツを脱いで蒸れ蒸れの靴下で足コキをしています。\n左右でソックスが違います。どちらの足でするかはお任せします。\n差分として、裸足Verもお願いします。足の爪には資料にある爪と同じ感じのマニキュアをしてください。\nジャケットについてるバッジなどは省略してもOKです。\n\n衣装:https://twitter.com/1garashi_Rika/status/1617718966952017921 (画像の1枚目のオレンジのジャケットを着ている方)、https://images.microcms-assets.io/assets/5694fd904074443