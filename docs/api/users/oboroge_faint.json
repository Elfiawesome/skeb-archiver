.net/48708c87/uploads/origins/6ce97497-0ca6-4da7-8a2f-842fdcc3a087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f9c4512a760d88bad83f824c2339474 2x, https://si.imgix.net/48708c87/uploads/origins/6ce97497-0ca6-4da7-8a2f-842fdcc3a087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9a1513318760a76de239ad1ab778bdb 3x", "genre": "art", "nsfw": false, "body": "正月衣装の葵ちゃんをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/22", "thumbnail_src": "https://si.imgix.net/e585cd59/uploads/origins/40b20a8c-f826-455d-993a-f3bb67298b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3ad9e4b2eacb871ac24307cb53c957d", "thumbnail_srcset": "https://si.imgix.net/e585cd59/uploads/origins/40b20a8c-f826-455d-993a-f3bb67298b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3ad9e4b2eacb871ac24307cb53c957d, https://si.imgix.net/e585cd59/uploads/origins/40b20a8c-f826-455d-993a-f3bb67298b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f649a4ee062ea7bc8efae339c719ccf 2x, https://si.imgix.net/e585cd59/uploads/origins/40b20a8c-f826-455d-993a-f3bb67298b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b79d5e8d5b060e61652e0cce1c4b805e 3x", "genre": "art", "nsfw": false, "body": "合成音声ソフトの結月ゆかりと琴葉茜をお願いします。\n露骨な百合表現は無くても大丈夫です。仲睦まじい感じであれば関係性は友達でも恋人でも問題ありません。朧気さんが描きやすい形でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/21", "thumbnail_src": "https://si.imgix.net/595f888b/uploads/origins/62bab83c-d178-41f7-9b2c-c77aa6445131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5be60511bfe0eb61b732d7c34a113277", "thumbnail_srcset": "https://si.imgix.net/595f888b/uploads/origins/62bab83c-d178-41f7-9b2c-c77aa6445131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5be60511bfe0eb61b732d7c34a113277, https://si.imgix.net/595f888b/uploads/origins/62bab83c-d178-41f7-9b2c-c77aa6445131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a338c70c1ec61ae65903183253fbae27 2x, https://si.imgix.net/595f888b/uploads/origins/62bab83c-d178-41f7-9b2c-c77aa6445131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c4b16dd370396f1f32bfd433130ba64 3x", "genre": "art", "nsfw": false, "body": "Vtuberの絹糸衣のイラストをお願いします。\n\n片手で頬杖をついて考え事している感じで、脚は左を上にして組んで座ってる構図でお願いします。\n\nhttps://twitter.com/silk_kanna/status/1528341892424794112?s=20&t=eTNN5McsGYXMSy9ih4MZaQ", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/20", "thumbnail_src": "https://si.imgix.net/b0677ec9/uploads/origins/0ae127c4-578a-482a-98bb-b20c3e634c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe2fbad22a139ac1bf9b3a16c98e3a52", "thumbnail_srcset": "https://si.imgix.net/b0677ec9/uploads/origins/0ae127c4-578a-482a-98bb-b20c3e634c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe2fbad22a139ac1bf9b3a16c98e3a52, https://si.imgix.net/b0677ec9/uploads/origins/0ae127c4-578a-482a-98bb-b20c3e634c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=091e77b4139f39cd37161ab12d4017d2 2x, https://si.imgix.net/b0677ec9/uploads/origins/0ae127c4-578a-482a-98bb-b20c3e634c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf0046fb963b39f893424702c4389c7a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/19", "thumbnail_src": "https://si.imgix.net/774a63ef/uploads/origins/24ee1ff9-2909-4d9c-8be4-ff0e9baa72ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10933c88b9b86876f4e81bddd92782fe", "thumbnail_srcset": "https://si.imgix.net/774a63ef/uploads/origins/24ee1ff9-2909-4d9c-8be4-ff0e9baa72ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10933c88b9b86876f4e81bddd92782fe, https://si.imgix.net/774a63ef/uploads/origins/24ee1ff9-2909-4d9c-8be4-ff0e9baa72ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f64e2a0870cb0c2f32689581219a814 2x, https://si.imgix.net/774a63ef/uploads/origins/24ee1ff9-2909-4d9c-8be4-ff0e9baa72ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2cc1345324d1669dd112de89c129b8e 3x", "genre": "art", "nsfw": false, "body": "いつも素敵な作品拝見させてもらってます！\n推しのVtuber「イツナ」さんのイラストを是非リクエストさせて頂きたいです。\n参考として記載したキービジュアルには二つの衣装がありますが、白衣のような衣装のほうでお願いします。\n構図等は全てお任せします。\n\n≪参考≫\n資料：https://twitter.com/Itsuna_57/status/1480871415289348096\nイツナ二次創作ガイドライン：https://itsuna.fanbox.cc/posts/3259636\nファンアートタグ(参考用)：#57番観察記録\n\nhttps://twitter.com/Itsuna_57/status/1480871415289348096", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/18", "thumbnail_src": "https://si.imgix.net/e77da9c6/uploads/origins/96362609-6c1e-4b5c-a481-fd927396bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659f383eb46fd6b402ae057a4e321340", "thumbnail_srcset": "https://si.imgix.net/e77da9c6/uploads/origins/96362609-6c1e-4b5c-a481-fd927396bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659f383eb46fd6b402ae057a4e321340, https://si.imgix.net/e77da9c6/uploads/origins/96362609-6c1e-4b5c-a481-fd927396bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c117272e230fc1de49da10f6ba38d89e 2x, https://si.imgix.net/e77da9c6/uploads/origins/96362609-6c1e-4b5c-a481-fd927396bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9ceb5ba320d7aaf409fd1fed32b73ce 3x", "genre": "art", "nsfw": false, "body": "学校から帰宅後、自宅で制服のまま二人でゲームをする琴葉姉妹をお願いしたいです。\n\n服装は々々（のまのま）さんの琴葉姉妹立ち絵のイメージです。\nhttps://seiga.nicovideo.jp/seiga/im8943263\nhttps://seiga.nicovideo.jp/seiga/im8948956\n\n髪型に関しては解釈でお任せしますが、髪飾りは日常用簡易版って感じでふたりともつけていて欲しいです。\n協力ゲーをやっているイメージで、ゲームコントローラーはPS4コンでお願いします。\n\nとにかく楽しげにしている琴葉姉妹が見たいです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/17", "thumbnail_src": "https://si.imgix.net/d44798fc/uploads/origins/b8c940df-3021-47c1-964e-d49957a0834d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baaaf27b3c26ef499d2ce0e3e3bfa499", "thumbnail_srcset": "https://si.imgix.net/d44798fc/uploads/origins/b8c940df-3021-47c1-964e-d49957a0834d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baaaf27b3c26ef499d2ce0e3e3bfa499, https://si.imgix.net/d44798fc/uploads/origins/b8c940df-3021-47c1-964e-d49957a0834d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=568c5bd6b4fbfddbe2c8a24b4b658f6d 2x, https://si.imgix.net/d44798fc/uploads/origins/b8c940df-3021-47c1-964e-d49957a0834d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2063e57352a977ca9697dbc204d5e051 3x", "genre": "art", "nsfw": false, "body": "Patrick's Paraboxというゲームをおぼにっき風にレビューお願いします。\n個人的に好きなゲーム且つ、朧気さんもきっと気に入ると思ったので依頼しました。\n配信で実況プレイなどして頂いて構いません。というか朧気さんさえ良ければ是非お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/16", "thumbnail_src": "https://si.imgix.net/a080cb35/uploads/origins/711f6956-df69-472f-b05b-a366dcf8d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83966dbfed4895099e66cb6a63d43f0d", "thumbnail_srcset": "https://si.imgix.net/a080cb35/uploads/origins/711f6956-df69-472f-b05b-a366dcf8d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83966dbfed4895099e66cb6a63d43f0d, https://si.imgix.net/a080cb35/uploads/origins/711f6956-df69-472f-b05b-a366dcf8d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49ea407ccada448d48fc2487e9dc4729 2x, https://si.imgix.net/a080cb35/uploads/origins/711f6956-df69-472f-b05b-a366dcf8d7d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cea79c469f469156d67f72aa80f7ebf9 3x", "genre": "art", "nsfw": true, "body": "ぺたんと座りながら（パンツは履いた状態）ゴムを咥えて手ブラでこっちを煽ってくるような表情をしている朧気ちゃんをよろしければお願いします", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/15", "thumbnail_src": "https://si.imgix.net/02905b22/uploads/origins/f92be5e9-9de0-4912-8c75-dff0ee114d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0d45fbe8cb4ed90c494afb63420a0c", "thumbnail_srcset": "https://si.imgix.net/02905b22/uploads/origins/f92be5e9-9de0-4912-8c75-dff0ee114d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0d45fbe8cb4ed90c494afb63420a0c, https://si.imgix.net/02905b22/uploads/origins/f92be5e9-9de0-4912-8c75-dff0ee114d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcae33d69548f1a2a1cad1ebe5ea6040 2x, https://si.imgix.net/02905b22/uploads/origins/f92be5e9-9de0-4912-8c75-dff0ee114d7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bd514a8cc27f9b9d47ba7014b16d0ad 3x", "genre": "art", "nsfw": false, "body": "某オープンワールドゲームのクリア時に使ってた装備を着てる朧気ちゃんをよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/14", "thumbnail_src": "https://si.imgix.net/d06bf10f/uploads/origins/6c43a2cc-92c1-448f-af02-25d278c036f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ce9b6be4bae8e2d9215396d290bfdae", "thumbnail_srcset": "https://si.imgix.net/d06bf10f/uploads/origins/6c43a2cc-92c1-448f-af02-25d278c036f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ce9b6be4bae8e2d9215396d290bfdae, https://si.imgix.net/d06bf10f/uploads/origins/6c43a2cc-92c1-448f-af02-25d278c036f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2c7a381edd7b333d0963bc2a0228364 2x, https://si.imgix.net/d06bf10f/uploads/origins/6c43a2cc-92c1-448f-af02-25d278c036f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32364100095ddbdcf466ff64ae1a61d0 3x", "genre": "art", "nsfw": false, "body": "朧気さんの代理キャラ「朧気ちゃん」と、多々良さん（@nabenofuta33）の代理キャラ「多々良さんちゃん」が街でデー……お買い物を一緒に楽しんでる絵をお願いします。\n向かって右側に多々良さんちゃんが、左手にいかにも甘そうな中身が見えているス〇バっぽいカップを持っていて、右手にスマホを（朧気ちゃんにも見えるように二人の間に）持っていて\n向かって左側に朧気ちゃんが、右手にブラックコーヒー、左手で多々良さんちゃんが持ってるスマホを捜査している構図でおねがいします。\n服装は多々良さんちゃんが女の子っぽく薄手のシャツと短いスカートで、朧気ちゃんがボーイッシュに柄物のシャツにデニムを履いてる感じでお願いします。（ガーリーとボーイッシュがはっきりしていれば大丈夫です）\n二人以外は白地でも可\nずっと練っていた構図なのでぜひ見たいです。よろしくお願いします。\n（宛名がお二人の絵に入ってしまうのは解釈違いなので無くて結構です）", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/13", "thumbnail_src": "https://si.imgix.net/cbee3e51/uploads/origins/3b6794eb-2b3e-4652-8a0e-42e5d2200c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b610611c0d4941b997d35cad57f5f959", "thumbnail_srcset": "https://si.imgix.net/cbee3e51/uploads/origins/3b6794eb-2b3e-4652-8a0e-42e5d2200c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b610611c0d4941b997d35cad57f5f959, https://si.imgix.net/cbee3e51/uploads/origins/3b6794eb-2b3e-4652-8a0e-42e5d2200c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39c3972b0d667ebcafa13091fd1cf0be 2x, https://si.imgix.net/cbee3e51/uploads/origins/3b6794eb-2b3e-4652-8a0e-42e5d2200c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c11137ceefda4f0bed8f8d1046b6dba 3x", "genre": "art", "nsfw": false, "body": "猫股葵ちゃんが丸まって眠っている姿を御呉れー！\nあの水色と白色のツートンカラーが私を狂わせた...\n\n具体的には資料URLにもあります、UNIふさい2-4の「ねこまたあおいちゃん」のイラストをお願いしたいです。\n体の右側面を下に横たわり、背中を丸めてお腹を守る状態。\n組んだ両腕を枕代わりに、両足も膝をお腹に寄せてる感じ。\n\n伝わらなければいい感じにお願いします。\n\nhttps://twitter.com/oboroge_faint/status/1430569741672873984", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/12", "thumbnail_src": "https://si.imgix.net/846ec255/uploads/origins/a2f84a12-79d9-4909-9745-3e2a04c59e63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9099f8aab74b570300d4078c09c4651e", "thumbnail_srcset": "https://si.imgix.net/846ec255/uploads/origins/a2f84a12-79d9-4909-9745-3e2a04c59e63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9099f8aab74b570300d4078c09c4651e, https://si.imgix.net/846ec255/uploads/origins/a2f84a12-79d9-4909-9745-3e2a04c59e63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4625110396c8c26a1e1025bddda6b35 2x, https://si.imgix.net/846ec255/uploads/origins/a2f84a12-79d9-4909-9745-3e2a04c59e63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e135fd268eea69d56628f35b4cb96f61 3x", "genre": "art", "nsfw": false, "body": "「お菓子を食べる琴葉姉妹(蕾)とその世話を焼く伊織弓鶴(冥)」をお願いします！\n参考資料として、手前味噌で恐縮ですが自身の既刊の一コマを本文最下部に添付させていただいております。\nただ、こちらはあくまで構図指定やラフみたいなものだと思っていただいて、朧気さんが変えたいところは好きなように改変して頂いてかまいません。\n\nどうぞよろしくお願いいたします！\n\n参考画像\nhttps://www.dropbox.com/s/2a6qrsrcspvu7tg/%E3%81%B5%E3%81%9F%E3%81%94%E3%81%8B%E3%81%BF%E3%81%95%E3%81%BE_022.png?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@oboroge_faint/works/11", "thumbnail_src": "https://si.imgix.net/92da87e3/uploads/origins/497248f0-5901-4b2c-adc5-6f067bb88ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c16833855ac8c0479c707596708712", "thumbnail_srcset": "https://si.imgix.net/92da87e3/uploads/origins/497248f0-5901-4b2c-adc5-6f067bb88ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c16833855ac8c0479c707596708712, https://si.imgix.net/92da87e3/uploads/origins/497248f0-5901-4b2c-adc5-6f067bb88ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60037778a62b0750662cdcc1098e8c12 2x, https://si.imgix.net/92da87e3/uploads/origins/497248f0-5901-4b2c-adc