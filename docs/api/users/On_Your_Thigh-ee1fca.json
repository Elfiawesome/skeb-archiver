4ccd-b661-fc45df6aac61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63cb417fd1744bac760b89077bd70d90 2x, https://si.imgix.net/4ebeaa25/uploads/origins/7ae11224-3679-4ccd-b661-fc45df6aac61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78c965e51c54b97ab795b0b9f8c23a04 3x", "genre": "art", "nsfw": false, "body": "よーさいさん、こんにちは。\nもし宜しければ私はプレイしているゲームの（アラド戦記）キャラクターを書いてほしいです。\n私のキャラクター外形と職業の設定はこちらです: \nhttps://imgur.com/2iP5hlu（私のキャラクターの見た目）\nhttps://imgur.com/a/cwoIOBF（エンチャントレスの基本イラスト）\nhttps://dpaste.com/8D2Z6SAB3 （エンチャントレスの設定）\n構図は単独または人形と、 その他はよーさいさんのお好きなように描いてほしいです。\nただひとつ欲しいのは、あまりにも可愛いだけだったり生意気に見えたりして、単に見えるよりは彼女の性格通りに複雑微妙な雰囲気が出てほしいです。\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@On_Your_Thigh/works/4", "thumbnail_src": "https://si.imgix.net/9e124ac2/uploads/origins/bde362ff-4516-41c5-97ed-fd2f5a2dbe23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c468e55581c80591ef1840762003d54", "thumbnail_srcset": "https://si.imgix.net/9e124ac2/uploads/origins/bde362ff-4516-41c5-97ed-fd2f5a2dbe23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c468e55581c80591ef1840762003d54, https://si.imgix.net/9e124ac2/uploads/origins/bde362ff-4516-41c5-97ed-fd2f5a2dbe23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e69723950fb408312a9dc0688352678 2x, https://si.imgix.net/9e124ac2/uploads/origins/bde362ff-4516-41c5-97ed-fd2f5a2dbe23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8aaa1d98bdd75fb07828e33245a00a2 3x", "genre": "art", "nsfw": false, "body": "突風でパンモロして恥ずかしがってる南夢芽ちゃんお願いします！！\n\nストッキンクなし差分があるとうれしいです", "created_at": "", "completed_at": ""}, {"path": "/@On_Your_Thigh/works/3", "thumbnail_src": "https://si.imgix.net/01f8c0cf/uploads/origins/81b36e6b-d139-47c6-812e-146a2d74c32a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50