=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e541a8d439a6bb594bf7c6f9e7377a9 3x", "genre": "art", "nsfw": false, "body": "はじめまして、突然失礼致します。  \n\nとても素敵なイラストを拝見致しまして、ぜひリクエストさせて頂きたくご連絡致しました。\nもし、内容や金額が大丈夫でしたらご検討頂けますと幸いです。よろしくお願い致します…！\n\n以下、内容についてです。 \nこの後、送らせていただきますURLのキャラクターを描いていただきたいと思っております。 \nぜひ描きやすいように自由に描いていただければと思っております。\n\n中性的なキャラクターで、目元に縦にほくろが二つあります。また、八重歯があり笑うと見えるような感じです。 \nぜひこちらのキャラクターをお願いしたく思っています。  \n\n長々と失礼致しました、お忙しいところ申し訳ございません、\nご検討いただけますと幸いです。\n何かありましたらキャンセルしていただいて構いません。 \n何卒よろしくお願い致します🙇🏻‍♂️  \n\n❏ 資料\nhttps://www.dropbox.com/scl/fo/kh7xm18o2qkotv0kuzg26/AI2qqjVuDMepg3Ozx3hI_2Y?rlkey=w0in3helvc2xonjv29iduubjy&st=9w7706cw&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@gozo_oekaki/works/33", "thumbnail_src": "https://si.imgix.net/2918babb/uploads/origins/0415f597-90ce-499c-8616-325c30d62adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3af8cf0203d5555d238ac8da9576584b", "thumbnail_srcset": "https://si.imgix.net/2918babb/uploads/origins/0415f597-90ce-499c-8616-325c30d62adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3af8cf0203d5555d238ac8da9576584b, https://si.imgix.net/2918babb/uploads/origins/0415f597-90ce-499c-8616-325c30d62adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f778c1e01ebc981b4c86408b7705805e 2x, https://si.imgix.net/2918babb/uploads/origins/0415f597-90ce-499c-8616-325c30d62adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5686186770134e30ee5e6b9874156d3b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gozo_oekaki/works/32", "thumbnail_src": "https://si.imgix.net/6bd11bda/uploads/origins/3e60f44b-5005-4d80-aaaf-6bed3be8baa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a0578797f8a8252fa9f219cb46218a", "thumbnail_srcset": "https://si.imgix.net/6bd11bda/uploads/origins/3e60f44b-5005-4d80-aaaf-6bed3be8baa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a0578797f8a8252fa9f219cb46218a, https://si.imgix.net/6bd11bda/uploads/origins/3e60f44b-5005-4d80-aaaf-6bed3be8baa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4eb51f6888e5178be406b4f22b44a22 2x, https://si.imgix.net/6bd11bda/uploads/origins/3e60f44b-5005-4d80-aaaf-6bed3be8baa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0a1bf565df75e92a1e57e7de5d062cf 3x", "genre": "art", "nsfw": false, "body": "はじめましてgozo様。いつもXで流れてくるイラストを素敵だなぁと眺めさせていただいております。今回お願いしたいキャラクターはCoC『ニトロとレモン』のHOニトロです。\n\ngozo様の色彩センスがとても好きなので可能であれば【カラーイラスト】だととても嬉しいです………！！\n\n\n▶︎以下PCについて\n\n●プロフィール\n名前：二戸 ライカ(ニト-)\n性別：男\n身長：185cm\n\n●容姿（詳細画像はGoogleドライブをご覧ください）\n・モチーフはロシア犬のサモエド\n・白いもふもふの髪に緑の鋭い目\n\n●性格\n・にぱ！と笑うタイプのお茶目で陽気な男\n・好きな女をダーリン♡と呼ぶ\n\n●イメージアイテム(もし絵の中になにかモチーフを入れ込んでいただけるなら)\n・レモン\n・手榴弾(檸檬爆弾)\n・拳銃\n・花束\n・駄菓子\n\n\nお忙しいとは思いますが、お受けいただけると嬉しいです！もし料金に不足があればお手数ですが、再送要請をしていただければと思います。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/15nP0yO97DfvjQJIiqgpd-CeKlVuryp8M", "created_at": "", "completed_at": ""}, {"path": "/@gozo_oekaki/works/31", "thumbnail_src": "https://si.imgix.net/92e42f94/uploads/origins/e4eabd77-1c95-48f3-81a0-ae6b6a2a3213?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=febd8f953ea50d783c1d7a31df1ad387", "thumbnail_srcset": "https://si.imgix.net/92e42f94/uploads/origins/e4eabd77-1c95-48f3-81a0-ae6b6a2a3213?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=febd8f953ea50d783c1d7a31df1ad387, https://si.imgix.net/92e42f94/uploads/origins/e4eabd77-1c95-48f3-81a0-ae6b6a2a3213?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad6875e4a96abec00404734e9d0bf1ac 2x, https://si.imgix.net/92e42f94/uploads/origins/e4eabd77-1c95-48f3-81a0-ae6b6a2a3213?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3edc377f1aa84e9859e3c5274ed4b70f 3x", "genre": "comic", "nsfw": false, "body": "あなたの絵がとても好きです。これらのキャラクターを描くことに興味はありますか？\n\nサウデ（A、ポニーテール） - 礼儀正しく、親切で、フォーマル...そう思っている。笑顔の裏に本心を隠している。エフィにだけ警戒心を解く。\n\nエフィー（B、三つ編みヘア） - 魅力的で自信家。他人の無能を見下す。カジュアルでラフな話し方。\n\n危険な会社の同僚（書類仕事と現場任務の両方がある...スパイに似ている）。仲の良い友人でもあり、ロマンチックなシチュエーションで描かれるのを見るのも楽しい（明確に付き合っているわけではない）。\n\n自由に描いてください！このリクエストで不快な思いをさせたら申し訳ありません。\n\nhttps://drive.google.com/drive/folders/1Q-MQawoARnWmy881IuO-ML_UoQ2eP2O-", "created_at": "", "completed_at": ""}, {"path": "/@gozo_oekaki/works/30", "thumbnail_src": "https://si.imgix.net/880c75a2/uploads/origins/632e0511-409f-4779-adb6-2396922ddfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8b0286fba893409422c5dcb16811491", "thumbnail_srcset": "https://si.imgix.net/880c75a2/uploads/origins/632e0511-409f-4779-adb6-2396922ddfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8b0286fba893409422c5dcb16811491, https://si.imgix.net/880c75a2/uploads/origins/632e0511-409f-4779-adb6-2396922ddfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39e087d74959631d3817da507a5b3796 2x, https://si.imgix.net/880c75a2/uploads/origins/632e0511-409f-4779-adb6-2396922ddfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5c030755be9f95fe723d1608a61a882 3x", "genre": "art", "nsfw": false, "body": "被験者13は背が高く、小柄な男性キャラクターだ。ミステリアスでクールに振る舞おうと懸命だが、いつもダサく、不器用で、ちょっと不穏な雰囲気を漂わせている。注目されることを切望しており、たとえそれが自分を哀れなものに見せるとしても、注目されたいと思っている。落ち着きのない目、歯列矯正器、突拍子もないエネルギーなど、彼の外見は様々だ。押しつけがましく、滑稽で、不快なヤンデレ。あなたの創造力を信じますので、好きなように描いてください！\n\nhttps://drive.google.com/drive/folders/1qxDLgpn3O4YHPpMPDpe0qjt1pfjDMjAC?usp=sharing\n\nhttps://drive.google.com/drive/folders/1qxDLgpn3O4YHPpMPDpe0qjt1pfjDMjAC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gozo_oekaki/works/29", "thumbnail_src": "https://si.imgix.net/0ba2fbcf/uploads/origins/ba860b0b-bde7-4e5a-9967-14b519141755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7ecff2a488dce6f3808cbd35273ef66", "thumbnail_srcset": "https://si.imgix.net/0ba2fbcf/uploads/origins/ba860b0b-bde7-4e5a-9967-14b519141755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7ecff2a488dce6f3808cbd35273ef66, https://si.imgix.net/0ba2fbcf/uploads/origins/ba860b0b-bde7-4e5a-9967-14b519141755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43354dd65cadf7684f0e5d00f1156b7d 2x, https://si.imgix.net/0ba2fbcf/uploads/origins/ba860b0b-bde7-4e5a-9967-14b519141755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b69cf7862fbdd93a9f20ad6dd4484b0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gozo_oekaki/works/28", "thumbnail_src": "https://si.imgix.net/aa65509b/uploads/origins/2138ba6f-3efb-4eca-86ca-b62b1c3686a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ff09251cd0fbac5b66d5dca5ef985f8", "thumbnail_srcset": "https://si.imgix.net/aa65509b/uploads/origins/2138ba6f-3efb-4eca-86ca-b62b1c3686a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ff09251cd0fbac5b66d5dca5ef985f8, https://si.imgix.net/aa65509b/uploads/origins/2138ba6f-3efb-4eca-86ca-b62b1c3686a4?bg=