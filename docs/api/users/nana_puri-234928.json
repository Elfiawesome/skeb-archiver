画やプロフィールのサムネイルなどに、立ち絵として使う場合があります。\nその他非営利的な用途で、元のイラストを損なわない程度の拡大・縮小・トリミングなどの加工をする場合があります。\nイラスト自体はなーなさんに著作権が帰属しますが、原著作権者（大元のデザインをした方）の二次的著作物となる可能性について留意してください。\n\nhttps://x.com/Kuze_chiaki/status/1690216319214661632", "created_at": "", "completed_at": ""}, {"path": "/@nana_puri/works/14", "thumbnail_src": "https://si.imgix.net/367fb224/uploads/origins/e07b7b70-d3e5-447a-803f-b941dc9e8d30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3b8d36d29709ee93f48fcddfd24324", "thumbnail_srcset": "https://si.imgix.net/367fb224/uploads/origins/e07b7b70-d3e5-447a-803f-b941dc9e8d30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3b8d36d29709ee93f48fcddfd24324, https://si.imgix.net/367fb224/uploads/origins/e07b7b70-d3e5-447a-803f-b941dc9e8d30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e12bcafe0e06e27a82f9f428217fb396 2x, https://si.imgix.net/367fb224/uploads/origins/e07b7b70-d3e5-447a-803f-b941dc9e8d30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d46e22fd5ebc2092d5055fd539b1535 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nana_puri/works/13", "thumbnail_src": "https://si.imgix.net/eb5f8ff2/uploads/origins/220a2c26-34b9-440a-992e-5762c2947386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a85ea8753d6cbc5324c934e260172d", "thumbnail_srcset": "https://si.imgix.net/eb5f8ff2/uploads/origins/220a2c26-34b9-440a-992e-5762c2947386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a85ea8753d6cbc5