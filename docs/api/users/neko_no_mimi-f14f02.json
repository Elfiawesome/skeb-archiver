ec943f9f92dc910 2x, https://si.imgix.net/c7f3048b/uploads/origins/390cedc5-1249-4d61-8075-39c0996573ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e73fd43865fbf77adeafdd39cfa68099 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@neko_no_mimi/works/14", "thumbnail_src": "https://si.imgix.net/b6f5a6d7/uploads/origins/df4ad8c8-6e70-4b1e-bc6d-25fa4bfac817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e86391ab69e55994106f11e513cf2d5", "thumbnail_srcset": "https://si.imgix.net/b6f5a6d7/uploads/origins/df4ad8c8-6e70-4b1e-bc6d-25fa4bfac817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e86391ab69e55994106f11e513cf2d5, https://si.imgix.net/b6f5a6d7/uploads/origins/df4ad8c8-6e70-4b1e-bc6d-25fa4bfac817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1faea3be1e075a6cfbfb9bc1f05ef244 2x, https://si.imgix.net/b6f5a6d7/uploads/origins/df4ad8c8-6e70-4b1e-bc6d-25fa4bfac817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=250daf6d2ae7fabb2508a5a8439c762e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@neko_no_mimi/works/13", "thumbnail_src": "https://si.imgix.net/79c0a92f/uploads/origins/d3bc87f9-f689-4da3-9724-f131d55d9113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa46bb803c698dd0e10b3663bedf1dc2", "thumbnail_srcset": "https://si.imgix.net/79c0a92f/uploads/origins/d3bc87f9-f689-4da3-9724-f131d55d9113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa46bb803c698dd0e10b3663bedf1dc2, https://si.imgix.net/79c0a92f/uploads/origins/d3bc87f9-f689-4da3-9724-f131d55d9113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=290a8872121660b68b32c035339c7204 2x, https://si.imgix.net/79c0a92f/uploads/origins/d3bc87f9-f689-4da3-9724-f131d55d9113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=468a85f9e16fc937dd1f49a1bd4f0726 3x", "genre": "art", "nsfw": false, "body": "初リクエストです！猫の耳先生の作品が好きなので、リクエストを送らせていただきます！\nマリクとの闇のゲームに負けた天上院明日香と早乙女レイが罰ゲーム(電気ビリビリ椅子)を受けるというシチュエーションをモノクロ漫画形式でお願いしたいです！\n詳細を下に書きます。\n\n内容:横並びで電気ビリビリ椅子に座った状態で、マリクが引いたカードが何かを当てる\n間違えたら電気が流れ、威力が上がる\n正解すれば、解放される\n\n1、マリクが引いたカードはモンスターだが、2人は間違え電気が流れる。\nあまりの痛さに、椅子から立ち上がり、悲鳴を上げ、少し体をのけ反らせながらお尻を両手で押さえるリアクションをする。\n\n2、次も間違え電気が流れる。威力が上がっている為、きゃあああ痛い、痛いと絶叫しながら飛び跳ねるリアクションをする。\n\n3、3回目も間違え、電気が流れさらに威力が上がっているので、本当に痛い、やめて、嫌ーと涙目で大絶叫しながらリアクションする。\n最後はマリクが高笑いしながら、何問目で正解出来るか見ものだなというセリフで終わるという内容です。\nマリクはセリフのみで大丈夫です。表情はお任せします！\n\n初リクエストで、難しいご要望してしまいすみません😓難しかったら断ってもらって大丈夫です。\n\n天上院明日香\nhttps://x.com/TheSnackFalcon/status/1646593557346816001?s=20\n\n早乙女レイ(レイの服装は明日香と同じ制服でお願いします)\nhttps://x.com/himazintenzu/status/1642890368277712896?s=46\n\nリアクションの参考動画\nhttps://twitter.com/OCHtldYikXvgVmy/status/1687014070116036608?s=20\n\nhttps://x.com/OCHtldYikXvgVmy/status/1717738457802682711?s=20", "created_at": "", "completed_at": ""}, {"path": "/@neko_no_mimi/works/12", "thumbnail_src": "https://si.imgix.net/0370f1ac/uploads/origins/049e716f-3a69-430a-a89a-cfe11d088e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2cb5e61f85e0a3766f761f67980947", "thumbnail_srcset": "https://si.imgix.net/0370f1ac/uploads/origins/049e716f-3a69-430a-a89a-cfe11d088e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2cb5e61f85e0a3766f761f67980947, https://si.imgix.net/0370f1ac/uploads/origins/049e716f-3a69-430a-a89a-cfe11d088e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6f8f7d0bb9ee311c3fc6599904c5575 2x, https://si.imgix.net/0370f1ac/uploads/origins/049e716f-3a69-430a-a89a-cfe11d088e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a914ac4e9c90d1ef8b73219671b6c6c9 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ネコミミさん\n\n最も素晴らしい仕事だ！\n\nまたマンガを広げよう！まだ、戦闘中のエロシーンについて。\n\n今度はバイブを使ったパリーグやロープウォークに挑戦してみませんか？その他、どんなプレイも大歓迎です！(また生モノはダメですよ）\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JydE_sACknlHNIDd3D9WRkeMeMEVWT_-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@neko_no_mimi/works/11", "thumbnail_src": "https://si.imgix.net/c0d57eb2/uploads/origins/6a924b7d-a9cb-4123-9208-be1b040c16b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9515614fe1b802264fb9b5a4510456ae", "thumbnail_srcset": "https://si.imgix.net/c0d57eb2/uploads/origins/6a924b7d-a9cb-4123-9208-be1b040c16b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9515614fe1b802264fb9b5a4510456ae, https://si.imgix.net/c0d57eb2/uploads/origins/6a924b7d-a9cb-4123-9208-be1b040c16b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfa7228bdbb74cf3f19313fb6b1d2ff8 2x, https://si.imgix.net/c0d57eb2/uploads/origins/6a924b7d-a9cb-4123-9208-be1b040c16b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cc1e47d5e3c28f1545cbc037d6047ea 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n先日は素敵なイラストありがとうございます。\nリクエストさせて頂きます。\n要望が気に入らない場合はキャンセルして頂いて構いません。\n\nキャラクター\n→閃刀姫レイ（遊戯王）\n\n希望構図\n→目隠しをされ、X字に拘束されてパンツの中にローターを入れられ、胸や乳首、ふとももなど様々な所を触られ拘束を外そうと藻掻いているレイをお願い致します。\n\n希望シチュ\n→前回納品して頂いた続きのイメージで、イカされすぎて気絶してしまい、目を開けたはずが目隠しによって暗いままな状態で責められているレイのイメージでお願い致します。\n\n差分でボールギャグを装着させられた状態で責められるレイをお願い致します。\n\n責め側やレイのセリフは先生にお任せ致します。\n\n分かりにくい所などありましたら申し訳ありませんで。\n是非ご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@neko_no_mimi/works/10", "thumbnail_src": "https://si.imgix.net/3432c596/uploads/origins/9d4db12e-7379-450c-af84-f0d9bf7e1ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce096f60bce3aef1c93bdad324585d45", "thumbnail_srcset": "https://si.imgix.net/3432c596/uploads/origins/9d4db12e-7379-450c-af84-f0d9bf7e1ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce096f60bce3aef1c93bdad324585d45, https://si.imgix.net/3432c596/uploads/origins/9d4db12e-7379-450c-af84-f0d9bf7e1ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34e442d69582644b0ad6b228a7ac6462 2x, https://si.imgix.net/3432c596/uploads/origins/9d4db12e-7379-450c-af84-f0d9bf7e1ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a3e54a4fca9efb6fc1343505d712dd2 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ネコミミさん\n\n前回は素晴らしい仕事でした！そして、より高い予算で新しいリクエストを送るのが待ち遠しいです！\n\n漫画(コミック？)をもっと膨らませて欲しい！主に戦闘中のエロシーンについて。\n\n例えば、機械の腕を両腕で受け流す(受け流す？抵抗する？)シーンで、クリトリスにバイブを当てたり、謎のビームで強制的にオーガズムに到達させたり、股縄を使って崖を渡ったり...。お好きなものをお試しください！繰り返しますが、機械とロープのみです。\n\nコミックの各ページの価格表を提供していただけると助かります！\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JydE_sACknlHNIDd3D9WRkeMeMEVWT_-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@neko_no_mimi/works/9", "thumbnail_src": "https://si.imgix.net/934d5c36/uploads/origins/66bbce68-bffd-4fb2-89b2-dfcaad6bc2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee624635fd879aea256788deb35ceadc", "thumbnail_srcset": "https://si.imgix.net/934d5c36/uploads/origins/66bbce68-bffd-4fb2-89b2-dfcaad6bc2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee624635fd879aea256788deb35ceadc, https://si.imgix.net/934d5c36/uploads/origins/66bbce68-bffd-4fb2-89b2-dfcaad6bc2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3393cb751d27c196acbf1df4e8d6e38 2x, https://si.imgix.net/934d5c36/uploads/or