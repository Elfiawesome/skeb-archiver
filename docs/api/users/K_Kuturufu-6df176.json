-4d48-889e-435540f7f210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cef25c8eef9f0dcf7cda9d40e5e52b2", "thumbnail_srcset": "https://si.imgix.net/bc553640/uploads/origins/a4421243-24ea-4d48-889e-435540f7f210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cef25c8eef9f0dcf7cda9d40e5e52b2, https://si.imgix.net/bc553640/uploads/origins/a4421243-24ea-4d48-889e-435540f7f210?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5a93a2cc88cb080474638c44a371b9b 2x, https://si.imgix.net/bc553640/uploads/origins/a4421243-24ea-4d48-889e-435540f7f210?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7351d0e5a3a7661ec55776b3ee351bc8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、葛飾Kさん！\n自分の誕生日が近いため、自分への贈り物としてリクエストをお願い差し上げます。\n期間も、描き方も関係ありません！目元にダークサークルがあるで、暗くて湿っぽいなパチュリーノーレッジを、先生の好みをたくさん詰め込んでお好きに描いていただければ本当に嬉しいです。\n\n※追伸\n帽子はあってもなくても構いませんが、帽子がない場合、おだんごヘアは省いていただければとお願い申し上げます。\n以前と同様に、月の形の装飾も入る場合、🌒の形でお願いいたします！\n\n改めてお礼申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@K_Kuturufu/works/3", "thumbnail_src": "https://si.imgix.net/9da0ed60/uploads/origins/3dc49c5b-1a7b-463d-8a4b-e99e4047cb74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d5f4abf0730b20526d56b4c6664bf61", "thumbnail_srcset": "https://si.imgix.net/9da0ed60/uploads/origins/3dc49c5b-1a7b-463d-8a4b-e99e4047cb74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d5f4abf0730b20526d56b4c6664bf61, https://si.imgix.net/9da0ed60/uploads/origins/3dc49c5b-1a7b-463d-8a4b-e99e4047cb74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adc9b6efe8ee065eef5aa05859156b23 2x, https://si.imgix.net/9da0ed60/uploads/origins/3dc49c5b-1a7b-463d-8a4b-e99e4047cb74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16ec468745f579762a99debe7531fbaf 3x", "genre": "art", "nsfw": false, "body": "いつも可愛くてきれいなイラストを楽しく拝見しております！\n\nこの度は葛飾K先生にぜひ当方のオリジナルキャラクターを描いていただきたくメッセージを送らせていただきました。\n先生の描きたいイメージで楽しんで書いていただければ幸いです。\n\n【使用用途】\n・SNSへの掲載\n・YouTube動画や配信のサムネイル\n※人物のみの透過データをいただけますと幸いです\n\nオリジナルキャラクターにつきましては資料URLからご確認ください。\nhttps://drive.google.com/file/d/1duv3f7aERZX_wz056ak2U3W2PGywLZjy/\n\nご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@K_Kuturufu/works/2", "thumbnail_src": "https://si.imgix.net/c4c4763a/uploads/origins/78732e3b-3267-4c95-b286-1d92aa9c1435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4151c7c4153a64718b5bbc763139f76f", "thumbnail_srcset": "https://si.imgix.net/c4c4763a/uploads/origins/78732e3b-3267-4c95-b286-1d92aa9c1435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4151c7c4153a64718b5bbc763139f76f, https://si.imgix.net/c4c4763a/uploads/origins/78732e3b-3267-4c95-b286-1d92aa9c1435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24cda4156acaff748b5a54faa68f854b 2x, https://si.imgix.net/c4c4763a/uploads/origins/78732e3b-3267-4c95-b286-1d92aa9c1435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3506a0f2749d2664b68f9e95ba845d0c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、葛飾さん！先生のアートスタイルと作品のファンです。\nもし受け入れていただけるなら、私にとって大変光栄です！\n\n以下が私のリクエストです。\n\n寝るとき、隣に掛けるためのパチュリー・ノーレッジの絵が必要で、\n厚塗りで儚い感じに、残りは先生の自由にお任せいたします。描く過程を楽しんでいただければ、それだけで私は非常に感謝しています。\n\n本当にありがとうございます。\n\n\n*彼女の三日月飾りを描く場合は、🌘の形ではなく、🌒の形を選んでいただけますか？ もしそうなら、とても助かります。", "created_at": "", "completed_at": ""}, {"path": "/@K_Kuturufu/works/1", "thumbnail_src": "https://si.imgix.net/2bb75701/uploads/origins/f33cfeb8-f0e4-4de4-ac81-4c5e92ff45f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e53d3357f206f30194c29d2ade0c9db2", "thumbnail_srcset": "https://si.imgix.net/2bb75701/uploads/origins/f33cfeb8-f0e4-4de4-ac81-4c5e92ff45f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e53d3357f206f30194c29d2ade0c9db2, https://si.imgix.net/2bb75701/uploads/origins/f33cfeb8-f0e4-4de4-ac81-4c5e92ff45f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee1daddde5a905f5163d6cb69bafbd43 2x, https://si.imgix.net/2bb75701/uploads/origins/f33cfeb8-f0e4-4de4-ac81-4c5e92ff45f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=411184791ab37ae86646e33a02af23b2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、葛飾クトゥルフさんの絵をTwitterで拝見し色使いがとても魅力的なイラストでした。\n好みの絵柄ですのでぜひリクエストしたいです。\nもし良ければホロライブIDのアイラニ・イオフィフティーンさんをポーズや構図等はすべておまかせで描いていただきたいです!!\nよろしくお願いします。", "created_at": "", "completed_at": ""}]}