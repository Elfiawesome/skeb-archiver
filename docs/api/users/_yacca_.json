bp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de54c1484233f401361746646adef728", "thumbnail_srcset": "https://si.imgix.net/63620902/uploads/origins/ca523670-189e-4966-b96d-2d3773f83789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de54c1484233f401361746646adef728, https://si.imgix.net/63620902/uploads/origins/ca523670-189e-4966-b96d-2d3773f83789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dd2faf9c5582f334167a248eef3ae37 2x, https://si.imgix.net/63620902/uploads/origins/ca523670-189e-4966-b96d-2d3773f83789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=928bea7b6097c1a53c4987ba76e9c78d 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_yacca_/works/7", "thumbnail_src": "https://si.imgix.net/5173eedd/uploads/origins/bba4466b-606c-4d15-b59e-6a9e3c3b4c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb0058b9875f99669c2bd56ff24eef7b", "thumbnail_srcset": "https://si.imgix.net/5173eedd/uploads/origins/bba4466b-606c-4d15-b59e-6a9e3c3b4c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb0058b9875f99669c2bd56ff24eef7b, https://si.imgix.net/5173eedd/uploads/origins/bba4466b-606c-4d15-b59e-6a9e3c3b4c22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f88ebaf9a18b6f90487f5ce01f8c71c 2x, https://si.imgix.net/5173eedd/uploads/origins/bba4466b-606c-4d15-b59e-6a9e3c3b4c22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49585c35bd217cc0764bd92dde82714f 3x", "genre": "novel", "nsfw": false, "body": "薬夏さん、こんにちは！\nmisskey.ioで知りました、アタストと申します。\n”俳句をつくる”ということにとっても興味がわいたので、興味本位でのリクエストとさせていただきました。\nえげつない興味を全力投球させていただきます。\n\n海水浴場やプールでよく見かける、シャチとかの形をした浮き輪のようなもの、俗に言われる\"フロート\"でお願いしたいです。個人的に好みなので。　せっかくですので癖ありのお題をばと思い、フロート特有の感触などに着目しつつ、\n”通常サイズのもの”\n”膨張して5倍以上の大きさになったサイズのもの”\n\"さらに膨張した、前のサイズと比較できないぐらいとんでもなくでっかいサイズのもの”\nを意識したものでお願いします。\nサイズは青天井で構いません。でかいほど喜びます。なんなら天文学的サイズでも構いません。\n\n予算内で可能であれば、解説テキストもお願いします。\n\n勢いで書いているのでほぼ怪文書となっていますが、なにとぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_yacca_/works/6", "thumbnail_src": "https://si.imgix.net/cf6dbab2/uploads/origins/2f6cc78f-b52e-4b6b-9d5b-acdcba540e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8faeb1cd68ec315979eb6a0f87abbd85", "thumbnail_srcset": "https://si.imgix.net/cf6dbab2/uploads/origins/2f6cc78f-b52e-4b6b-9d5b-acdcba540e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8faeb1cd68ec315979eb6a0f87abbd85, https://si.imgix.net/cf6dbab2/uploads/origins/2f6cc78f-b52e-4b6b-9d5b-acdcba540e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c9be4e5e2fb045ae9ab5532afc63112 2x, https://si.imgix.net/cf6dbab2/uploads/origins/2f6cc78f-b52e-4b6b-9d5b-acdcba540e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f943e644b427dfb9358e2e2e60f48c34 3x", "genre": "novel", "nsfw": false, "body": "いつもお世話になっております。木内一命です。\nだんだんと寒くなってまいりましたが、いかがお過ごしでしょうか。\n\n今回は、「昼寝」をテーマにお願いしたく思います。\nぼくはというと、こういう時期はついうとうとして昼寝をしてしまいがちなので……。\nなんとなく昼寝をして、目が覚めたときに目に入るとうれしい句をいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@_yacca_/works/5", "thumbnail_src": "https://si.imgix.net/eb076a34/uploads/origins/f0294e8a-a705-41f8-963a-368306bfafe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3684b2da7f34f14afdfbe9c125fc65e", "thumbnail_srcset": "https://si.imgix.net/eb076a34/uploads/origins/f0294e8a-a705-41f8-963a-368306bfafe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fi