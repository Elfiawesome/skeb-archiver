9-48e7-a719-eff72e1a7a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f69a913743734def42a2927ceda4c1 2x, https://si.imgix.net/a23a5eae/uploads/origins/c88eb1ca-ffe9-48e7-a719-eff72e1a7a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d927b9ba628a635c4c4763a59280e24 3x", "genre": "art", "nsfw": false, "body": "オリジナルキャラクターのツバキちゃんをお願い致します！\n構図等はお任せでお願い致します。服装は資料の真ん中の画像（ケープなし）でお願い致します。よろしくお願い致します！\n\nhttps://postimg.cc/gallery/63ZT51F/2c43fdbd", "created_at": "", "completed_at": ""}, {"path": "/@hoshikagewataru/works/2", "thumbnail_src": "https://si.imgix.net/3470e553/uploads/origins/4e9863cf-208e-4ac1-9200-97c18a2db70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5415b459886883c4e48727a15bb9fbcc", "thumbnail_srcset": "https://si.imgix.net/3470e553/uploads/origins/4e9863cf-208e-4ac1-9200-97c18a2db70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5415b459886883c4e48727a15bb9fbcc, https://si.imgix.net/3470e553/uploads/origins/4e9863cf-208e-4ac1-9200-97c18a2db70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d9868b20a778e0ef1b56cd482752de3 2x, https://si.imgix.net/3470e553/uploads/origins/4e9863cf-208e-4ac1-9200-97c18a2db70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3939fd2efc2b56affe9f83fcd69d9df1 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの作品、特にSkebへの最初の投稿が大好きで、私のオリジナルキャラクターを2つ描いていただきたいと思っています。私の毎月の依頼テーマは「学校の運動会」です。ブルマを着て運動会の練習をしているケモノミミ・ロリとショタのキャラクターを描いてください。\n\nその他の詳細については、作者にお任せします。\n\nhttps://rebrand.ly/poponekochara、以下のキャラクターの中から2人選んでください。これらのキャラクターは、特に写真に写っていない限り、ほとんどがフラットチェストです。\n\nお手数ですが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hoshikagewataru/works/1", "thumbnail_src": "https://si.imgix.net/b39597c8/uploads/origins/8a2bdcbe-a1d2-426d-8638-fa7187ae098d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=348a831