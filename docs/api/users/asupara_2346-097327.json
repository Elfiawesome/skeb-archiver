imgix.net/4c9ab4fa/uploads/origins/ada33a41-03fd-466c-adde-ff6a615355ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=570219f0872001bd1a36ac45f55298c7", "thumbnail_srcset": "https://si.imgix.net/4c9ab4fa/uploads/origins/ada33a41-03fd-466c-adde-ff6a615355ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=570219f0872001bd1a36ac45f55298c7, https://si.imgix.net/4c9ab4fa/uploads/origins/ada33a41-03fd-466c-adde-ff6a615355ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6728381e09fec4664e6b25b66bf661b7 2x, https://si.imgix.net/4c9ab4fa/uploads/origins/ada33a41-03fd-466c-adde-ff6a615355ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39bdfd5814b7b3252d238ae231b687f5 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。今回は自分がいつも使用しているアバターを描いていただきたく、リクエストさせていただきました。\n\nhttps://twitter.com/VRC_gmmm/status/1598856522704244736/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@asupara_2346/works/7", "thumbnail_src": "https://si.imgix.net/d428b1c2/uploads/origins/8f95afa5-94a9-4c88-9746-219e0e01f0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d47854771dbff662355369a9d61d6a6", "thumbnail_srcset": "https://si.imgix.net/d428b1c2/uploads/origins/8f95afa5-94a9-4c88-9746-219e0e01f0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d47854771dbff662355369a9d61d6a6, https://si.imgix.net/d428b1c2/uploads/origins/8f95afa5-94a9-4c88-9746-219e0e01f0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78247ddaec143697ce581477ec32e539 2x, https://si.imgix.net/d428b1c2/uploads/origins/8f95afa5-94a9-4c88-9746-219e0e01f0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94d716edf1ec65a5a9275f148c2bd29d 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。今回は、私の主催するイベントである雨見会の、VRChatグループのヘッダー画像を描いていただきたく思い、リクエストいたしました。\n背景は透過させ、VRChat内で見栄え良くしていた