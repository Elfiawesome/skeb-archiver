/si.imgix.net/71cec672/uploads/origins/adec4eac-f781-4565-9d68-9b400da9d254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edc47f813df1c514e484b359cbb2b9f7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@natsunouro/works/3", "thumbnail_src": "https://si.imgix.net/4e3065a6/uploads/origins/353b2b39-af24-4a10-b61d-f18082754501?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fe44046cbe20160a518be8ba4f12ecc", "thumbnail_srcset": "https://si.imgix.net/4e3065a6/uploads/origins/353b2b39-af24-4a10-b61d-f18082754501?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fe44046cbe20160a518be8ba4f12ecc, https://si.imgix.net/4e3065a6/uploads/origins/353b2b39-af24-4a10-b61d-f18082754501?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad48c37475dc70d974cdf2dae44757a3 2x, https://si.imgix.net/4e3065a6/uploads/origins/353b2b39-af24-4a10-b61d-f18082754501?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f16391a10ce141eb1b4c0ac45258cc4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@natsunouro/works/2", "thumbnail_src": "https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9b6756a6e6b3feaef55436d8aa6dfe2", "thumbnail_srcset": "https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9b6756a6e6b3feaef55436d8aa6dfe2, https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=366d8793b4f2b4f4746254b9500e5f70 2x, https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68cbf2bb831d542c3569f92097814e03 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私はあなたの絵がとても好きです！\n\n絵をお願いしてもいいですか？私のオリジナルキャラクターであるチェンユーを全裸にして、黒いスライムや触手から逃れながら、ペニスをフル勃起させた力強いポーズで描いてほしいです。\n\n髭を生やし、肌は白く、髪は紫か赤、筋肉質で、胸と腕にタトゥーが入っています（タトゥーの詳細はお任せします）。\n\nURLの1枚目の写真は、私が話しているシナリオとポーズの例です。URLの2枚目の写真は、Chenyuの参考写真です。\n\nこの度はご検討いただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/158Z_w7DMZm3ARVj9uM_y0OhMsifnjGY4?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@natsunouro/works/1", "thumbnail_src": "https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928be84efdeff6a43cfa077b5d7c876d", "thumbnail_srcset": "https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928be84efdeff6a43cfa077b5d7c876d, https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef606ea6651fcdb019e12f5aea591597 2x, https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4eb4c850f2efbb773ef948e60c120a6 3x", "genre": "art", "nsfw": true, "body": "ご挨拶。\n\n私はあなたに絵のリクエストをしたいと思います。私のオリジナルキャラクター、便宜上ブラックさんとホワイトさんと呼ぶことにしますが、この二人の絵が欲しいのです。二人とも全裸で、ホワイトさんがブラックさんに上手にフェラチオをしているような絵をお願いします。\n\nブラックさんはホワイトさんの頭をつかんで、満足そうな、あるいは叫んでいるような表情をしています。ホワイトさんの口やあごからは精液が滴り落ち、ブラックさんのおしりやお尻をつかんでいます。\n\n私のURLに写真を掲載しましたので、参考にしてください。\n\nブラックさんは金色の王冠をかぶっていて、先の尖ったエルフの耳をしています。彼はとても筋肉質で、少し日焼けした肌をしています。\n\nホワイトさんはブラックさんよりも肌が明るく、痩せていて、帽子をかぶっていません。ホワイトは、片側の胸と肩と腕にタトゥーが入っていますが、デザインは鯉のぼりやドラゴンなど日本的なものであれば、お任せします。\n\nまた、フェラチオのポーズの例も参考にしました。\n\nご検討いただき、ありがとうございました。\n\nhttps://drive.google.com/drive/u/0/folders/1cSxzJbCYW0tBLeumNNSJ5d9drV_TdOdA", "created_at": "", "completed_at": ""}]}