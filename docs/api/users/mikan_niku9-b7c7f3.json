ix.net/5904d77d/uploads/origins/64b741e0-3c9a-49d5-a1d4-34251c41d10e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce6944b7d4af2be78f019cc6a45c07e4 2x, https://si.imgix.net/5904d77d/uploads/origins/64b741e0-3c9a-49d5-a1d4-34251c41d10e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90704961eabf1da7f1e9c4f51e2a0d1d 3x", "genre": "art", "nsfw": false, "body": "座ったキツネのソナが羽織を着ている姿を描きたい。肩からずり落ちた羽織を、彼は観る者に近づくよう誘うように。手には酒瓶を。https://imgchest.com/p/pg738939j4r", "created_at": "", "completed_at": ""}, {"path": "/@mikan_niku9/works/15", "thumbnail_src": "https://si.imgix.net/b40c56b3/uploads/origins/2b579e94-46dc-4e34-950e-30c864ea913e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8db401bb4bb75dd16970cda4af4cc151", "thumbnail_srcset": "https://si.imgix.net/b40c56b3/uploads/origins/2b579e94-46dc-4e34-950e-30c864ea913e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8db401bb4bb75dd16970cda4af4cc151, https://si.imgix.net/b40c56b3/uploads/origins/2b579e94-46dc-4e34-950e-30c864ea913e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e35f4a6cf5be1f60aa37719d39ff0645 2x, https://si.imgix.net/b40c56b3/uploads/origins/2b579e94-46dc-4e34-950e-30c864ea913e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf954911d2e5b37060df5bef05fbfdb0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、三缶さん！\n\nオリジナルキャラクターのイラストを委託します。アニメーション用にできるだけ多くのパーツを別々のレイヤーに分けてください（例：体、首、顔のベース形状（顔の詳細なし）、各目/口/眉毛、髪、耳、鼻、腕/手、服）。これをライブストリームアバターのパーツとして使用します。\n\n必須の表情パーツ\n\n目：\n    閉じた目（まばたき用）\n    開いた目\n    笑った目\n    前を向いた目（まっすぐ）\n    視聴者を見る目（軽く角度付き）\n\n口：\n    幸せな口\n    中立な口\n    笑った口\n    「あ」形（大きく開いた）\n    「い」形（笑顔で細い）\n    「う」形（丸い）\n    「え」形（小さく開いた）\n    「お」形（リラックス）\n    「ん」形（閉じて舌が触れる）\n\n手と腕：\n    腕を下に垂らした（ニュートラル）\n    ゲームコントローラーを持った手\n    マウスとキーボードを持った手（左右別々で）\n\n衣装：\nキャラクターにぴったりの新しい衣装をデザインしてください。既存の衣装を使用しても構いません。\n\n参考資料：\n    現在のアバターのアニメーション例：\n    https://files.choop.place/public/ezgif-77248e7e82c054be.mp4\n    https://files.choop.place/public/example2.mp4\n\n    現在のレイヤリング解決策の画像：\n    https://files.choop.place/public/slices.png\n    https://files.choop.place/public/slices2.png\n\n    参考画像：\n    https://oc.choop.place/choop\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@mikan_niku9/works/14", "thumbnail_src": "https://si.imgix.net/64ca0101/uploads/origins/4bdb7018-b97c-4740-a62c-077c8dfc0045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc897895e83cff4ea4023a36cd91eac", "thumbnail_srcset": "https://si.imgix.net/64ca0101/uploads/origins/4bdb7018-b97c-4740-a62c-077c8dfc0045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc897895e83cff4ea4023a36cd91eac, https://si.imgix.net/64ca0101/uploads/origins/4bdb7018-b97c-4740-a62c-077c8dfc0045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a683692536c3eb4abe688a80687a1e9f 2x, https://si.imgix.net/64ca0101/uploads/origins/4bdb7018-b97c-4740-a62c-077c8dfc0045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f55c5008be1445193d8ce06bcc38c079 3x", "genre": "art", "nsfw": false, "body": "三缶さん、またこんにちは！\n\nまたイラストをお願いしたいんだ。\n\n今回は、うちのサーバルキャラと友達のうさぎキャラを一緒に描いてほしいんだけど、その友達のキャラはケモノとして描いてほしいんだ！\n\nできれば、冬のほっこりした感じのシーンがいいな。クリスマスマーケットで、雪がちょっと降ってる、みたいな。\n\nポーズとか構図、服装とかは全部おまかせするよ。もしテーマに合う新しい衣装をデザインしてくれたら、すっごく嬉しい。\n\n三缶さんの作品、本当に大好き。もし受けてくれたら、めちゃくちゃ嬉しいな。\n\nサーバル:\nhttps://drive.proton.me/urls/7BY38PTXJ4#-oFiuyB49dAq\n\nうさぎ:\nhttps://drive.proton.me/urls/4FZA66X7T4#sZRxHrVdk21a", "created_at": "", "completed_at": ""}, {"path": "/@mikan_niku9/works/13", "thumbnail_src": "https://si.imgix.net/c48f38c5/uploads/origins/c22ced05-ff42-4289-81c8-17537cd90943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfe045ec4a2a3ef69886ddbada628fe1", "thumbnail_srcset": "https://si.imgix.net/c48f38c5/uploads/origins/c22ced05-ff42-4289-81c8-17537cd90943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfe045ec4a2a3ef69886ddbada628fe1, https://si.imgix.net/c48f38c5/uploads/origins/c22ced05-ff42-4289-81c8-17537cd90943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1785f67ee8fcb3f7981d8385d1fe57e 2x, https://si.imgix.net/c48f38c5/uploads/origins/c22ced05-ff42-4289-81c8-17537cd90943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76823120ba4efd5d9ba43e5e5d987ce6 3x", "genre": "art", "nsfw": true, "body": "こんにちは！2キャラのnsfw作品が欲しいんだ。私のオオカミのOCと猫のOCです。オオカミがネコの足を広げて、ネコのお尻を犯します。猫は仰向けになる。二人ともヌードだ。このポーズで、2人と挿入が見える。猫は慌てたような、恥ずかしそうな顔をし、オオカミは生意気な顔をする。全体の構図はあなた次第で、ただ部屋のベッドの上、窓際で。ザーメンあり、ザーメンなしの編集を加えていただけますか？ありがとうございました！\n\nhttps://www.dropbox.com/scl/fo/jqj2415wowsj3ecx26b8q/AKVMgcei9pZVXGsPhecU53A?rlkey=57o4bbqomj9xwxg0scbcg82eh&st=gl5120ac&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@mikan_niku9/works/12", "thumbnail_src": "https://si.imgix.net/c090c8e4/uploads/origins/b4d6966d-b9d2-444f-a63c-a57b74838934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64266c87635d264850a180da7a59049", "thumbnail_srcset": "https://si.imgix.net/c090c8e4/uploads/origins/b4d6966d-b9d2-444f-a63c-a57b74838934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64266c87635d264850a180da7a59049, https://si.imgix.net/c090c8e4/uploads/origins/b4d6966d-b9d2-444f-a63c-a57b74838934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87464ae069beb8d04f06ec8caaeea203 2x, https://si.imgix.net/c090c8e4/uploads/origins/b4d6966d-b9d2-444f-a63c-a57b74838934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=161ab897de1a3ea22ef6deb9ff6172a2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、サメの女の子ケイラニのイラストをお願いしたいです。帽子、襟、ドレス、マント(角度による)以外は全て身に着けていてほしいのですが、メガネはありません。武器もなし。ポーズや表情は自由です。\n\nhttps://drive.google.com/file/d/1qCuLSWA7faHvITN85XEoOOpB6c64dhGD/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mikan_niku9/works/11", "thumbnail_src": "https://si.imgix.net/fa1b7d57/uploads/origins/bc27c011-ab1c-4a2d-9692-836bd0546f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b6c07cb513da86a395a376eb9215c16", "thumbnail_srcset": "https://si.imgix.net/fa1b7d57/uploads/origins/bc27c011-ab1c-4a2d-9692-836bd0546f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b6c07cb513da86a395a376eb9215c16, https://si.imgix.net/fa1b7d57/uploads/origins/bc27c011-ab1c-4a2d-9692-836bd0546f21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7df06664ce27c198b5f6034d2eb98062 2x, https://si.imgix.net/fa1b7d57/uploads/origins/bc27c011-ab1c-4a2d-9692-836bd0546f21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0992a5cde2c169eeda1c10e346bc71f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵が大好きです！私のVtuber OCを毛皮で描いてくれませんか？どんなポーズや服装でも構いません。狼とか、彼女のデザインに一番合うと思うものにしてほしいです。\n\nhttps://drive.google.com/drive/folders/1dgj2w_qvUtVNZAy9xDC1mmIS5G2m3PFz", "created_at": "", "completed_at": ""}, {"path": "/@mikan_niku9/works/10", "thumbnail_src": "https://si.imgix.net/d7624c7a/uploads/origins/64df8d59-1024-4898-9993-36a22ab97b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e01659541a46613aa5c454a0c1839f3", "thumbnail_srcset": "https://si.imgix.net/d7624c7a/uploads/origins/64df8d59-1024-4898-9993-36a22ab97b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e01659541a46613aa5c454a0c1839f3, https://si.imgix.net/d7624c7a/uploads/origins/64df8d59-1024-4898-9993-36a22ab97b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa9e44d1a168813109b819c4c2753218 2x, https://si.imgix.net/d7624c7a/uploads/origins/64df8d59-1024-4898-9993-36a22ab97b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fdc8c0ec50b081da7b77f0f3abc7a48 3x