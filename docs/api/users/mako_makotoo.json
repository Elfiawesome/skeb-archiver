26-02-14T17:12:34.361537+00:00"}]}, "current_prices": {"art": 13000, "comic": 24000}, "price_range": {"art": {"min": 9500, "max": 13000}, "comic": {"min": 18000, "max": 24000}}, "links": [{"label": "Twitter", "url": "https://x.com/mako_makotoo", "name": "mako_makotoo"}, {"label": "Website", "url": "https://apt2.booth.pm", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/4788939", "name": "4788939"}], "flags": {}, "works": [{"path": "/@mako_makotoo/works/221", "thumbnail_src": "https://si.imgix.net/87531ff6/uploads/origins/c24c7e70-1d4a-4162-9688-4a17e1f99371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51dbe410ebea89ad0568a24a2d69a71", "thumbnail_srcset": "https://si.imgix.net/87531ff6/uploads/origins/c24c7e70-1d4a-4162-9688-4a17e1f99371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51dbe410ebea89ad0568a24a2d69a71, https://si.imgix.net/87531ff6/uploads/origins/c24c7e70-1d4a-4162-9688-4a17e1f99371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2345c87a3cc2eb044068bdfedb6b6d0e 2x, https://si.imgix.net/87531ff6/uploads/origins/c24c7e70-1d4a-4162-9688-4a17e1f99371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f28f09a69f2b4b305557c26a82f3938 3x", "genre": "art", "nsfw": false, "body": "こんにちは、マコトウ。あなたの絵がとても好きです。\n\nこれは私の最初のOCで、海から来たドラゴンです。https://imgur.com/a/lQn4JYY\n\n夜の海や水の中にいて、目が少し光っていて、クールでハンサムな感じにしてほしいです。あとは好きなように描いてください。\n\nありがとうございました！\n\nhttps://imgur.com/a/lQn4JYY", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/220", "thumbnail_src": "https://si.imgix.net/38833332/uploads/origins/b9a77dd5-760c-4fad-b50b-2787a421f191?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2051fabbf886c938650b9c34a9a4892", "thumbnail_srcset": "https://si.imgix.net/38833332/uploads/origins/b9a77dd5-760c-4fad-b50b-2787a421f191?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2051fabbf886c938650b9c34a9a4892, https://si.imgix.net/38833332/uploads/origins/b9a77dd5-760c-4fad-b50b-2787a421f191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fdf4530c1ba6852fad2855c65040189 2x, https://si.imgix.net/38833332/uploads/origins/b9a77dd5-760c-4fad-b50b-2787a421f191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34339197a54282797df39fb0ea3a27a8 3x", "genre": "art", "nsfw": false, "body": "お邪魔します！マコトウ先生、こんにちは！ビャクヤです🙏  \n\nイラストを依頼したく、私のイメージは以下の通りです：\n\n 1. 和室の縁側に座っていて、足は地面に対して垂直（少し浮いていても大丈夫） \n\n2. 少し上を見上げるような姿勢で、両手は後ろについてリラックスしている、庭には一本の木があり、その場所から木と空の両方が見える構図。 \n\n3. 画面の視点は高い位置（木の葉あたりの高さ）からの俯瞰で、画面の隅に木の葉が入り、主役となるキャラは縁側に座っている。\n\n 4. 服装は法被・甚平・浴衣などのゆったりしたものを希望、そばに海苔せんべいのようなものを一皿置いてもらえたら嬉しいです。 \n\n5. 季節は紅葉か桜の時期で、こちらは先生のおまかせで大丈夫です。  \n\nよろしくお願いします🙇\n\nキャラクターデザインのURLはこちらです：\n\nhttps://drive.google.com/drive/folders/1-OX91RJT1hefQzxtBLMwyNqylaiL4pIk", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/219", "thumbnail_src": "https://si.imgix.net/a846695b/uploads/origins/5b1eff60-3459-4c48-84b8-f04cf294ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91fc2a99381ca07437f010cc9ead2a1e", "thumbnail_srcset": "https://si.imgix.net/a846695b/uploads/origins/5b1eff60-3459-4c48-84b8-f04cf294ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91fc2a99381ca07437f010cc9ead2a1e, https://si.imgix.net/a846695b/uploads/origins/5b1eff60-3459-4c48-84b8-f04cf294ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ec62fa66b7d16235105db3c3b9bb45b 2x, https://si.imgix.net/a846695b/uploads/origins/5b1eff60-3459-4c48-84b8-f04cf294ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d96f81fa93585093395c46ea84312f4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のファーソナを描いていただけませんか？\n彼は猫で、両頬に2-3本のひげが生えています。左右対称になるようにお願いします。\nかわいいエプロンを着て、生クリームを泡立てているファーソナを描いてほしい。\n彼の青い左手と左目が見えるように描いてください。\nショールは描かなくていいです。\nポーズと構図はお任せします。\nありがとうございました！\n私のファーソナ\nhttps://drive.google.com/drive/folders/1hHPWuPQ4HpueFNEEVPJTTbu8Y3dJjiwu?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1hHPWuPQ4HpueFNEEVPJTTbu8Y3dJjiwu?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/218", "thumbnail_src": "https://si.imgix.net/980ae7e7/uploads/origins/eee21076-c875-4a75-be46-e112e1c0b2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b3a630c70bd482c98997b534ee0d6b", "thumbnail_srcset": "https://si.imgix.net/980ae7e7/uploads/origins/eee21076-c875-4a75-be46-e112e1c0b2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b3a630c70bd482c98997b534ee0d6b, https://si.imgix.net/980ae7e7/uploads/origins/eee21076-c875-4a75-be46-e112e1c0b2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abda89ecf443a1a12137968636113fae 2x, https://si.imgix.net/980ae7e7/uploads/origins/eee21076-c875-4a75-be46-e112e1c0b2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa25b349f444381695c83c066e8969b0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたのアートスタイルが大好きで、私のスーパーヴィラン・キャラクター \"Destrudo \"のイラストをお願いしたいのです！(参照した写真のように)\n\nシーンについてですが、デストルドが黒いスポーツバイクに乗って、赤いアンビエントライト（参考写真のような）をつけて、夜の街でポーズをとっているところを考えてみました。\nデストルドの表情は、リラックスしているように見えて、邪悪な笑みを浮かべている。\n\nhttps://drive.google.com/drive/folders/1WDTWcWgpk-XuKw2TY5f3BbQtZ-_e-eOQ", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/217", "thumbnail_src": "https://si.imgix.net/ec42454c/uploads/origins/a87d8ae7-51e5-4483-9823-61fb55764e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34902dbef31853bf0e8096628fc17bd3", "thumbnail_srcset": "https://si.imgix.net/ec42454c/uploads/origins/a87d8ae7-51e5-4483-9823-61fb55764e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34902dbef31853bf0e8096628fc17bd3, https://si.imgix.net/ec42454c/uploads/origins/a87d8ae7-51e5-4483-9823-61fb55764e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b691a1f169346561d3ab9d0d0a93455 2x, https://si.imgix.net/ec42454c/uploads/origins/a87d8ae7-51e5-4483-9823-61fb55764e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a5d6d9df6e441384fc988c312873362 3x", "genre": "art", "nsfw": false, "body": "こんにちは、マコトウ、\n\nこちらもOC、緑のキツネのお医者さんです。https://imgur.com/7Fxeym5\n\n頭に保護バイザーをかぶってほしい。そして、聴診器は描かなくていいです。ありがとうございました！\n\nhttps://imgur.com/7Fxeym5", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/216", "thumbnail_src": "https://si.imgix.net/35ac8888/uploads/origins/fe9e6f3f-a197-441b-8b85-07ec924569b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24819b4e80758722f93c62272a2e9edc", "thumbnail_srcset": "https://si.imgix.net/35ac8888/uploads/origins/fe9e6f3f-a197-441b-8b85-07ec924569b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24819b4e80758722f93c62272a2e9edc, https://si.imgix.net/35ac8888/uploads/origins/fe9e6f3f-a197-441b-8b85-07ec924569b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a9e6c01d430598032958c2831ffe3c9 2x, https://si.imgix.net/35ac8888/uploads/origins/fe9e6f3f-a197-441b-8b85-07ec924569b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c38c2be4c02356cf582fdd599f60027a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。はじめまして。\nあなたのイラストがとても好きで、ぜひ一枚キャラクターイラストをお願いしたいです。\n\n描いていただきたいのは、このキャラクターです。\nポーズや表情などの細かいデザインは、すべておまかせしたいです。\nあなたの解釈で自由に描いていただけると嬉しいです。\n\nどうぞよろしくお願いいたします\n\nhttps://drive.google.com/file/d/182ajD54Os-_QUzzKXSoI8dC_XP4c-OMw/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/215", "thumbnail_src": "https://si.imgix.net/01652889/uploads/origins/4ad76f6b-aea7-420c-8d9b-183b48176713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10c5be47c8862ca65369131aabbea829", "thumbnail_srcset": "https://si.imgix.net/01652889/uploads/origins/4ad76f6b-aea7-420c-8d9b-183b48176713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10c5be47c8862ca65369131aabbea829, https://si.imgix.net/01652889/uploads/origins/4ad76f6b-aea7-420c-8d9b-183b48176713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=122542d533a5f0dbbdb876393134a883 2x, https://si.imgix.net/01652889/uploads/origins/4ad76f6b-aea7-420c-8d9b-183b48176713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31ed1767dac52fc8231c18a3735126a3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品がとても好きなので、作品をお願いしたいです。\n\n手を広げて星空に手を伸ばすようなイメージでお願いします。ディテールや服装は自由に追加してください。また、私のOCにゴーグルをつけるのを忘れないでください。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1r4lhOVpKZvZ_bRuZJm4qI_qR_tAnSF-J", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/214", "thumbnail_src": "https://si.imgix.net/11665c88/uploads/origins/9c21fbbb-46c3-4802-870a-27a11c15fbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0816ae1ec99dcabca121a20a9ebe441f", "thumbnail_srcset": "https://si.imgix.net/11665c88/uploads/origins/9c21fbbb-46c3-4802-870a-27a11c15fbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0816ae1ec99dcabca121a20a9ebe441f, https://si.imgix.net/11665c88/uploads/origins/9c21fbbb-46c3-4802-870a-27a11c15fbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea1d1204604cff67f7c16362fadc2883 2x, https://si.imgix.net/11665c88/uploads/origins/9c21fbbb-46c3-4802-870a-27a11c15fbb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb7e6e95173ea16d951cfc1704ccd161 3x", "genre": "art", "nsfw": true, "body": "こんにちは!! 作家さんの作業物の雰囲気がとても良くて注目していたが、このように機会があって申請しようと思います 😊\n私のOCを2人描いていただけますか？\n\n便宜上AとBに分類します。 Bは秘密の霧の森を守る巡察者です。 盗賊設定のAが隠された宝物を目的にBの森に入ってきて捕まった状況です。\n\n• BはAの両手を木の幹で縛ったまま、冷たい表情でAを眺めています。 \n • Aは照れくさそうな表情で笑いながらBの顔色をうかがっています。\n\nAの場合は「cloth ref」ファイルの服装を参考にしてください！ Bの場合、胸が胸毛で覆われています。\n\n背景はできれば紫の葉と彩度の低い枯葉色の茎でできた森にしていただきたいです！ 長文を読んでくださってありがとうございます。 よろしくお願いします。\n\nA :\nhttps://drive.google.com/drive/folders/1jm5rbh6CLUJSyuaW-GXjxutTb1Rf-JQO\n\nB :\nhttps://drive.google.com/drive/folders/17LJIYQMuYk_bINQqQg6XwUnAKJ4WEQoK", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/213", "thumbnail_src": "https://si.imgix.net/83d66e0d/uploads/origins/207da861-6031-4cf4-97af-51d9119a3d28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8d65e1a792a8b145aba4224d14e6236", "thumbnail_srcset": "https://si.imgix.net/83d66e0d/uploads/origins/207da861-6031-4cf4-97af-51d9119a3d28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8d65e1a792a8b145aba4224d14e6236, https://si.imgix.net/83d66e0d/uploads/origins/207da861-6031-4cf4-97af-51d9119a3d28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caf4f6f434b6910b82e7cb7cf743c48e 2x, https://si.imgix.net/83d66e0d/uploads/origins/207da861-6031-4cf4-97af-51d9119a3d28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4078711a1e26e832dc3b21997b49d12d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きです！あなたのスタイルで私のドラゴンのキャラクターを描いてほしいです！好きなように描いてください！\n\nhttps://drive.google.com/file/d/1e6cYcuntyJU3iCwN3GMqW0I7AzmQbtij/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/212", "thumbnail_src": "https://si.imgix.net/eb619275/uploads/origins/595f387d-3393-42bd-b303-e54b0aa194b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dd0d654b4febea36df7a75c7471f49", "thumbnail_srcset": "https://si.imgix.net/eb619275/uploads/origins/595f387d-3393-42bd-b303-e54b0aa194b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dd0d654b4febea36df7a75c7471f49, https://si.imgix.net/eb619275/uploads/origins/595f387d-3393-42bd-b303-e54b0aa194b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0359e234e96400bd7925b40cc383d6c4 2x, https://si.imgix.net/eb619275/uploads/origins/595f387d-3393-42bd-b303-e54b0aa194b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72ac291103db84124e70d1ef85c003ea 3x", "genre": "art", "nsfw": false, "body": "月と月明かりを背にしたキャラクターの正面から見た姿を描きたいと思っていて、彼女の目はとても輝いています。\nhttps://drive.google.com/file/d/1paiGJUQRKSF3C89VW8KA7hKZ_Q3ovJZw/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/211", "thumbnail_src": "https://si.imgix.net/5f46d522/uploads/origins/72662f67-3d2c-47a9-b3f9-91aff7c62d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa1b94bd99092eaec9f3e8aae9fed953", "thumbnail_srcset": "https://si.imgix.net/5f46d522/uploads/origins/72662f67-3d2c-47a9-b3f9-91aff7c62d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa1b94bd99092eaec9f3e8aae9fed953, https://si.imgix.net/5f46d522/uploads/origins/72662f67-3d2c-47a9-b3f9-91aff7c62d91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db169d0699d85e2079df95271ee2295a 2x, https://si.imgix.net/5f46d522/uploads/origins/72662f67-3d2c-47a9-b3f9-91aff7c62d91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e93825c8743cec5d4ba8837abe276428 3x", "genre": "art", "nsfw": false, "body": "こんにちは、OvO先生\nあなたの画風に一目で魅了されたので、私のocにもあなたのイラストを描いてもらおうと思いました。\n私のアイデアはこうです：私のオークが光る真珠を持って海の底に落ちていく。穏やかでロマンチックなイメージです。\n先生のプレイをとても楽しみにしています ❤️\n私のocのリファレンスはこちら：https://free.picui.cn/free/2025/12/14/693e71785a247.png\nhttps://free.picui.cn/free/2025/12/14/693e7177874a3.png", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/210", "thumbnail_src": "https://si.imgix.net/18f806a3/uploads/origins/348bb2e3-1800-443a-8228-799e0cd7f398?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77e4e0dd3ce6d3ea19b6b2f53a7811b9", "thumbnail_srcset": "https://si.imgix.net/18f806a3/uploads/origins/348bb2e3-1800-443a-8228-799e0cd7f398?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77e4e0dd3ce6d3ea19b6b2f53a7811b9, https://si.imgix.net/18f806a3/uploads/origins/348bb2e3-1800-443a-8228-799e0cd7f398?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=323ca311442041a2ac758dfd23bd9d17 2x, https://si.imgix.net/18f806a3/uploads/origins/348bb2e3-1800-443a-8228-799e0cd7f398?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4df4240c4f9de7629a0116d846cd4bf 3x", "genre": "art", "nsfw": false, "body": "Hello Makotoo,\nI really love your cute art style, so I would like to ask for an illustration for me and my friend. In Fantasy style, 4:3 ratio.\nJournalistHK: Dragon-wolf mage. Design and outfit in the link below.\nMainYi: Maine Coon inquisitor. Please design his outfit. He wears a top hat or hood, a white or other light-colored coat, and holds a lantern and rapier. Reference in the link below.\nCharacter refs: https://drive.google.com/drive/folders/1vKmMPA-cJ-qO7oGYWPjO0w7yAN0gV5tm?usp=drive_link\nThey hike along a cliff toward an old castle in the distance. MainYi lights the path with the lantern and looks back to talk to JournalistHK. Cliff: please use Ref1. Castle: far left background with a small road to it. Shape based on Ref2. Other details are up to you.\nScene refs: https://drive.google.com/drive/folders/11VNA-2zjulDZAVJcDM_aIbR3skLJfVs7?usp=drive_link\nThis request may be complex, so please feel free to adjust the price.\nThank you very much, and I hope you can accept my request.\n\nhttps://drive.google.com/drive/folders/1Vstdp-TJWc5ANCHfuLsRJYDEbCuNhf4a?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/209", "thumbnail_src": "https://si.imgix.net/64091e5f/uploads/origins/6ec96ad6-8402-4677-b94d-3ceda20ad9c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b5ff5988dab7a6097547e09f0e24aca", "thumbnail_srcset": "https://si.imgix.net/64091e5f/uploads/origins/6ec96ad6-8402-4677-b94d-3ceda20ad9c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b5ff5988dab7a6097547e09f0e24aca, https://si.imgix.net/64091e5f/uploads/origins/6ec96ad6-8402-4677-b94d-3ceda20ad9c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=595c7520eead5c2fbd74acfa6b3adad1 2x, https://si.imgix.net/64091e5f/uploads/origins/6ec96ad6-8402-4677-b94d-3ceda20ad9c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a04c20485ca9d9933007c91531608863 3x", "genre": "art", "nsfw": false, "body": "Hi! I really like your art, and now that I have the opportunity I'd like you to draw my Dungeons and Dragons character, Akagi (赤木)! They are from an axolotl-inspired race. They have a whimsical, playful, and carefree personality. I'd like for them to be looking towards the camera/viewer with a grin, winking with a hand on their hat. Aside from that, I leave everything in the composition up to you! Please go as crazy as you want!\n\nPhysically, they are athletic with a bit of muscle/definition on their chest (pecs and a *tiny* bit of abs), but nothing too extreme. They are about 106-122 cm tall.\n\nThank you in advance!\n\nReference: https://drive.google.com/drive/folders/1lpxFFh7B9i_oNzukcEVhOGRUVR4RXeni?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/208", "thumbnail_src": "https://si.imgix.net/a3bf5202/uploads/origins/1a8f4127-4a20-41b3-af51-30e81b5d213b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a49b43b253a3645eb9db80d59bfe12", "thumbnail_srcset": "https://si.imgix.net/a3bf5202/uploads/origins/1a8f4127-4a20-41b3-af51-30e81b5d213b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a49b43b253a3645eb9db80d59bfe12, https://si.imgix.net/a3bf5202/uploads/origins/1a8f4127-4a20-41b3-af51-30e81b5d213b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66e0c381a8de20542c476370aca1177d 2x, https://si.imgix.net/a3bf5202/uploads/origins/1a8f4127-4a20-41b3-af51-30e81b5d213b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=febc7c2cb40da52cdc6684841e8727ef 3x", "genre": "art", "nsfw": true, "body": "こんにちは！このキャラクターを描いてみてほしい！かっこいいキャラクターです！\n背景は冬の公園とか雪のあるところで描いてほしいです！暖かい家の暖炉の前とか！左目は白目で盲目です！もし可能なら、眼帯をつけて区別できるようにしてほしい！\n難しければ他のポーズやアクションを描くこともできます！それなら、冬服を着せてあげましょう！全然大丈夫です！\nとにかくありがとう！\n\nhttps://drive.google.com/drive/folders/1FxydFzBS3tHxgvkqq5gScRB_qbxuRqjP?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/207", "thumbnail_src": "https://si.imgix.net/cebda84c/uploads/origins/e0f3285e-cfd6-47a2-bef5-d8834246b7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6014ad3da777279b3f88df2d55f44f39", "thumbnail_srcset": "https://si.imgix.net/cebda84c/uploads/origins/e0f3285e-cfd6-47a2-bef5-d8834246b7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6014ad3da777279b3f88df2d55f44f39, https://si.imgix.net/cebda84c/uploads/origins/e0f3285e-cfd6-47a2-bef5-d8834246b7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdaffaa53b478ea6bc99ec25d7f31d48 2x, https://si.imgix.net/cebda84c/uploads/origins/e0f3285e-cfd6-47a2-bef5-d8834246b7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a141b399e03251f9e650d51a3b33cfd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風が大好きです！私のキャラクターのイラストをお願いしてもいいですか？好きなものを自由に描いてください！ありがとうございます！\n参考文献\nhttps://zupimages.net/viewer.php?id=22/21/4rek.png\nhttps://zupimages.net/viewer.php?id=22/21/nv00.png", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/206", "thumbnail_src": "https://si.imgix.net/0c09a1eb/uploads/origins/7b071d33-466f-4ab4-8cce-d530d7d513bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab64af748281a412b3a3f44e9fa3858", "thumbnail_srcset": "https://si.imgix.net/0c09a1eb/uploads/origins/7b071d33-466f-4ab4-8cce-d530d7d513bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab64af748281a412b3a3f44e9fa3858, https://si.imgix.net/0c09a1eb/uploads/origins/7b071d33-466f-4ab4-8cce-d530d7d513bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ed9e305374e940cacd89e7955ebebf6 2x, https://si.imgix.net/0c09a1eb/uploads/origins/7b071d33-466f-4ab4-8cce-d530d7d513bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aac86f0f0b815a3c8a5e0e7573b71727 3x", "genre": "art", "nsfw": false, "body": "Hello, sensai! It's great to see that you've started accepting requests again.\nThis is my characters' reference:\nhttps://1drv.ms/f/c/6a8e65b6d252f7b8/EmJXYyf_cR1FsodhAprRei8B0kUMvserVB1WIBnD9ijUfQ?e=efXCiF\nHe is a three-tailed fox boy and has different colored eyes, the left eye is blue and the right  is red.He can use smoke magic to make all sorts of weapons and items to use.Under his left eye is the Roman numeral XIII.\nJust draw it as you like.\nAnd really love your artworks, thanks for the chance!", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/205", "thumbnail_src": "https://si.imgix.net/33ac8b4f/uploads/origins/da894a7a-44a2-4037-b91d-0a4c1f61e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de73ccd1bc110d630f9b0c08828ad0d8", "thumbnail_srcset": "https://si.imgix.net/33ac8b4f/uploads/origins/da894a7a-44a2-4037-b91d-0a4c1f61e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de73ccd1bc110d630f9b0c08828ad0d8, https://si.imgix.net/33ac8b4f/uploads/origins/da894a7a-44a2-4037-b91d-0a4c1f61e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60bca73cb27e73700c1129b7dd2ce766 2x, https://si.imgix.net/33ac8b4f/uploads/origins/da894a7a-44a2-4037-b91d-0a4c1f61e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d5bcf6511cec78a01ebe48ecc65eb13 3x", "genre": "art", "nsfw": false, "body": "マコトウ様初めまして。\nいつも素敵なイラストを拝見しております。\n可愛さとカッコよさが共存した素敵なイラストをいつもありがとうございます。\n\n僭越ながら初めてリクエストをさせて頂きます。\nTRPGで使用したうちの仔とよそ様の仔とのうちよそ絵を描いて頂きたいです。頂いた絵はSNS等のアイコンで使用させて頂く可能性があります。\n差支えなければ、キャラクターの透過画像と背景のみの画像も合わせて頂けますと幸いです。\n\n（リクエスト内容）\n白虎の獣人と猫の獣人の夫婦のイラストをお願いします。\n猫の獣人である妻の視点から見た、夫の白虎の獣人の構図になります。\n構図の関係で猫の獣人は全身ではなく一部になります。\n\n（シチュエーション）\n2人は一緒に綺麗な海岸の砂浜を歩いている。砂浜に足を取られながら後ろを歩く猫の獣人に、白虎の獣人が振り返って手を取ってあげる、そんな夫の優しくて頼れる姿を、妻の目を通した目線で描いて頂きたいです。\n\n（構図詳細）\n・全体構図は、彼女（猫の獣人）目線で、彼（白虎の獣人）に見つめられながら、彼女が彼の手を取っている感じを希望します。\n・彼女については、彼の手を取っているその手を描いて欲しいです。\n・彼は完全に振り返るのではなく、体半分だけ振り返って、彼女に手を差し伸べている感じをイメージしています。\n（構図上不都合が生じる場合は自由に変更いただいて構いません）\n・彼の表情は目を開いて優しく微笑んでいる感じが良いです。\n・彼の衣装は添付の通り、コートにベレー帽を被っています。\n・身長差は彼の胸辺りに彼女の頭が来るくらいあるので、彼女目線にした時に、若干見上げる構図にして頂けるとありがたいです。\n\nキャラ設定\n名前　皇 琥（ファンフゥ）\n性別　♂\n年齢　24歳\n種族　白虎\n容姿　スッとした佇まいで、凛々しい目つき\n　　　ベレー帽にダッフルコート\n　　　胸ポケットに目元ペンをいつも携帯している\n\n性格　正義感と責任感が強い。押しに弱く断れない男で、妻のようなお転婆な仔にはたじたじになってしまう。\n　　　仕事柄人前では朗らかで明朗な様相をしており、言葉遣いも丁寧。\n　　　普段の彼も心穏やかで優しく、口数は決して多くはないが、それとなく気遣ったり心遣いができる、頼りがいのある男。\n　\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ZN2_wnVir7sMr5j9qvOvSYdx1jDjy59q?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/204", "thumbnail_src": "https://si.imgix.net/eafe3d19/uploads/origins/7fb11abc-cdb0-4a3f-babe-d390007ffff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ef33b257fecffc76c9a331e4e8aa320", "thumbnail_srcset": "https://si.imgix.net/eafe3d19/uploads/origins/7fb11abc-cdb0-4a3f-babe-d390007ffff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ef33b257fecffc76c9a331e4e8aa320, https://si.imgix.net/eafe3d19/uploads/origins/7fb11abc-cdb0-4a3f-babe-d390007ffff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=299dd357a6b1abf735621737296af7e0 2x, https://si.imgix.net/eafe3d19/uploads/origins/7fb11abc-cdb0-4a3f-babe-d390007ffff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36a742321e89e03e417730de88c6c7d4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、マコトウ！長い間、あなたの作品に憧れていました。\n\n今回は、親しい友人同士の特別な絆を表現するために、友人同士でからかい合うというテーマで二人用のイラストを依頼したいと思います。梣にはマントを着て、利诺をからかってほしい。その他のディテールは、あなたのクリエイティブな解釈次第です。それに、あなたの作品の雰囲気のある背景も好きなので、シーンに合った背景を作ってください。よろしくお願いします！\n\n以下、2人のキャラクターを紹介します：\n梣: https://drive.google.com/drive/folders/1Jb3jnPZCl967ew3frzIunOtF5vmqQaMt\n利诺：https://drive.google.com/drive/folders/1MRM6k47E_OW5v7YQSdfO8j9x5ApS4sD7", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/203", "thumbnail_src": "https://si.imgix.net/e9e36721/uploads/origins/93d74f09-4fd4-446a-b1ea-9fcfc4af0a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=072c0ecd1a4f9d87bb5f008b94389cf1", "thumbnail_srcset": "https://si.imgix.net/e9e36721/uploads/origins/93d74f09-4fd4-446a-b1ea-9fcfc4af0a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=072c0ecd1a4f9d87bb5f008b94389cf1, https://si.imgix.net/e9e36721/uploads/origins/93d74f09-4fd4-446a-b1ea-9fcfc4af0a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fcf5cab9cf61f3b88cf241b1983aad1 2x, https://si.imgix.net/e9e36721/uploads/origins/93d74f09-4fd4-446a-b1ea-9fcfc4af0a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afe616c35a083af060bc56522e2962d7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵にずっと憧れていたので、私のキャラクターをあなたに描いてもらおうと決めました。エリオット（キツネ）とオリバー（恐竜）です。彼らは一緒に育ったので兄弟のようです。どのように描いても構いませんし、芸術的な自由は完全にお任せします。オリバーがエリオットの2倍の大きさであることと、オリバーの眉毛がいつも浮いていることだけは注意してください。この依頼を本当に楽しみにしています！(リンクを間違えてしまい、本当に申し訳ありません。）\n\nhttps://imgur.com/a/Kx77xI2", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/202", "thumbnail_src": "https://si.imgix.net/d5d1b331/uploads/origins/17af6fc1-c19e-48d0-b8d8-e414c2c0b978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=686e40cbc495e7fe55355a0b6b080290", "thumbnail_srcset": "https://si.imgix.net/d5d1b331/uploads/origins/17af6fc1-c19e-48d0-b8d8-e414c2c0b978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=686e40cbc495e7fe55355a0b6b080290, https://si.imgix.net/d5d1b331/uploads/origins/17af6fc1-c19e-48d0-b8d8-e414c2c0b978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0251af2dd757de707ea130c335b410cb 2x, https://si.imgix.net/d5d1b331/uploads/origins/17af6fc1-c19e-48d0-b8d8-e414c2c0b978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50908db3c851f787022e0ac0fc4d6340 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵をとても楽しんでいます。\n私の毛皮のドラゴンのOCのイラストが欲しいのですが、POSEという名前のものと同じポーズでお願いします。\n背景については、あなたの判断を信頼しているので、自由に創造してください！\n\nhttps://drive.google.com/drive/folders/1dlssQbaHSa5rnG-5blgBrs5PKygCyRsd?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/201", "thumbnail_src": "https://si.imgix.net/35473306/uploads/origins/13077763-d321-4048-8571-25ad96a6264e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dde1164ca7fd99b58461e4133eced04", "thumbnail_srcset": "https://si.imgix.net/35473306/uploads/origins/13077763-d321-4048-8571-25ad96a6264e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dde1164ca7fd99b58461e4133eced04, https://si.imgix.net/35473306/uploads/origins/13077763-d321-4048-8571-25ad96a6264e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0132316c3a8af3c5f38e9e923750cda7 2x, https://si.imgix.net/35473306/uploads/origins/13077763-d321-4048-8571-25ad96a6264e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f57a6747e64ac6c3e4f6dbfe78d972cf 3x", "genre": "art", "nsfw": false, "body": "こんにちは。はじめまして。\nあなたのイラストの雰囲気がとても好きで、ぜひ一枚イラストをお願いしたいです。\n\nテーマは「竹林と神社」です。\n竹林に囲まれた小さな木造の神社の前で、神職風の衣装を着たキャラクターが静かに立っている場面を描いていただきたいです。\n\n構図は、やや下から見上げるローアングルで、キャラクターが少し横を向きながら斜め上を見上げている姿を希望します。\n風で竹の葉や衣の袖がゆるやかに揺れているような、さりげない動きがあると嬉しいです。\n\n光が竹の間から差し込み、空気中に小さな光の粒が舞うような、柔らかく幻想的な雰囲気でお願いします。\n表情は穏やかで、静けさを感じる落ち着いた印象だと嬉しいです。\n\n参考画像（設定・衣装など）はこちらにあります。\nhttps://drive.google.com/file/d/16d5tFEwMvFjKIW_bkX44ObOykSamSbc6/view?usp=drivesdk\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/16d5tFEwMvFjKIW_bkX44ObOykSamSbc6/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/200", "thumbnail_src": "https://si.imgix.net/daa80f37/uploads/origins/e0c2e1eb-3234-4d20-8286-1f1ad688a0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=546fcd2deca3150576af02c040b34aae", "thumbnail_srcset": "https://si.imgix.net/daa80f37/uploads/origins/e0c2e1eb-3234-4d20-8286-1f1ad688a0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=546fcd2deca3150576af02c040b34aae, https://si.imgix.net/daa80f37/uploads/origins/e0c2e1eb-3234-4d20-8286-1f1ad688a0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e50c6cf398a57c0568d8d3111e6af55 2x, https://si.imgix.net/daa80f37/uploads/origins/e0c2e1eb-3234-4d20-8286-1f1ad688a0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce3e3877f2521b39adf64743f97209f2 3x", "genre": "art", "nsfw": false, "body": "您好，我想委托一个比较帅气的插图，您可以自由发挥，我非常喜欢您的插图，希望可以与您合作\n这是我第一次使用skeb，所以不太熟练，我也不知道怎么给您看我的设定参考图，所以我发在推特上了，以下是链接：https://x.com/ass_kenny/status/1990341351771451685?t=ByiV6Pu7YZA8p2xCIwoE7w&s=19\nこんにちは、私は1つの比較的にハンサムなイラストを依頼したくて、あなたは自由に発揮することができて、私はあなたのイラストがとても好きで、あなたと協力することができることを望みます\nskebを使うのは初めてなので、あまり上手ではありませんし、私の設定参考図をどのようにお見せすればいいのか分からないので、ツイッターに投稿しました。以下はリンクです：\nhttps://x.com/ass_kenny/status/1990341351771451685?t=ByiV6Pu7YZA8p2xCIwoE7w&s=19", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/199", "thumbnail_src": "https://si.imgix.net/95cd2833/uploads/origins/ec30e090-2d62-4ad9-a8a7-0b77fca0c263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26fdfc00e195b821397f7cb52580410e", "thumbnail_srcset": "https://si.imgix.net/95cd2833/uploads/origins/ec30e090-2d62-4ad9-a8a7-0b77fca0c263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26fdfc00e195b821397f7cb52580410e, https://si.imgix.net/95cd2833/uploads/origins/ec30e090-2d62-4ad9-a8a7-0b77fca0c263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f87ed5afc98f18d57331cd00a8a10d28 2x, https://si.imgix.net/95cd2833/uploads/origins/ec30e090-2d62-4ad9-a8a7-0b77fca0c263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d81f89b90c234cd26fe23429f9928ce7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/198", "thumbnail_src": "https://si.imgix.net/0be3420b/uploads/origins/2e418dff-4ce8-49fd-9f79-56532e6a2f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7402e8a24c146e9ff74028cacd6147f1", "thumbnail_srcset": "https://si.imgix.net/0be3420b/uploads/origins/2e418dff-4ce8-49fd-9f79-56532e6a2f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7402e8a24c146e9ff74028cacd6147f1, https://si.imgix.net/0be3420b/uploads/origins/2e418dff-4ce8-49fd-9f79-56532e6a2f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68a24b1b9ffdf58ad4c6e12d3229a760 2x, https://si.imgix.net/0be3420b/uploads/origins/2e418dff-4ce8-49fd-9f79-56532e6a2f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6039f7e19e003507165156a998195ac6 3x", "genre": "art", "nsfw": false, "body": "マコトウさんこんにちは、いつも素敵なイラストを拝見しております。\n\nこの度はうちの子「黒曜石」と新キャラ「蛋白石」のイラストを依頼したくご連絡いたしました。\nテーマは「スノーボード(SB)」です。\n\n・黒曜石：かっこよく楽しそうに滑っているポーズ（自信満々で笑顔の表情）\n・蛋白石：少しバランスを崩して、転びそうで焦っている表情\n\n背景は露天のスキー場でお願いしたいです。\n（雪の坂道やゲレンデの雰囲気が分かる程度で大丈夫です）\n\n服装は特にスノーウェアでなくても構いません。\n必要に応じてゴーグル、マフラーなどの冬用アクセサリーを自由に追加していただいて大丈夫です（色指定なし）。\n\n参考は下記のリンクをご確認ください。\n黒曜石（キャラシート）：\nhttps://drive.google.com/file/d/1tadAeGWEf20O1MrmBFivo_JBu7sudgMv/view?usp=drivesdk\n（黒色が深くて描きにくい場合にはちょっと調整しても大丈夫です、#2B2B2Bなど）\n\n蛋白石（キャラシート）：\nhttps://drive.google.com/file/d/1GTVB36DCYzpDdeLXXIdLqbupDsUNp0YP/view?usp=drivesdk\n\n以上でよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1tadAeGWEf20O1MrmBFivo_JBu7sudgMv/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/197", "thumbnail_src": "https://si.imgix.net/79335230/uploads/origins/5af0fc98-1c5f-4085-a804-e6e694b2127e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa2a7cb682fd86f670af109a50d710b6", "thumbnail_srcset": "https://si.imgix.net/79335230/uploads/origins/5af0fc98-1c5f-4085-a804-e6e694b2127e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa2a7cb682fd86f670af109a50d710b6, https://si.imgix.net/79335230/uploads/origins/5af0fc98-1c5f-4085-a804-e6e694b2127e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3d77718cf1ac7438b58f8a6f0d4c887 2x, https://si.imgix.net/79335230/uploads/origins/5af0fc98-1c5f-4085-a804-e6e694b2127e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9da83cd1df42dc803257de722caa9462 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品は美しく、とてもふわふわしています！\nこの二人のキャラクターの絵をお願いしたいです！プレゼント用です！\n晴れた日のお花畑や桜並木の中にいてほしいです！\nカップルなので、かわいく、できれば目を見開いて見つめ合っているような感じで描いてください。\n\nマルクスは、のんびりしていて、冷静で、リラックスした表情で、パートナーをからかうのが好きなオオカミ。\nマルは、キュートでベビーフェイスのウサギで、マルクスよりずっと背が低い。\n服装は自由。\n\nあとはお任せします！ありがとうございました！\n\nキャラクター\nhttps://toyhou.se/35906242.maru\nhttps://toyhou.se/36007231.marx", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/196", "thumbnail_src": "https://si.imgix.net/7c44874e/uploads/origins/16ecfbe4-23e0-48ab-8310-ef06ce9336c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73035d9471c999874033338dc40e7a73", "thumbnail_srcset": "https://si.imgix.net/7c44874e/uploads/origins/16ecfbe4-23e0-48ab-8310-ef06ce9336c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73035d9471c999874033338dc40e7a73, https://si.imgix.net/7c44874e/uploads/origins/16ecfbe4-23e0-48ab-8310-ef06ce9336c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f50ec2de751d19417d6ea9d480f8eda 2x, https://si.imgix.net/7c44874e/uploads/origins/16ecfbe4-23e0-48ab-8310-ef06ce9336c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4b6f8274b2f64c19e2f234681bf6aed 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの作品が大好きで、あなたの絵に一目惚れしました。私のキャラクターを描いていただけたらとても嬉しいです！彼はオオカミです。頭髪なしで描いてください（2枚目の前面展望リファレンスシート参照）。\n\nできれば3840 x 2160 (16:9)でデスクトップの壁紙にしたいです。\n\n舞台は木造の小屋の中の暖かな冬の情景で、暖炉とクリスマスツリーが部屋にあります。私がどこにいて、どんなポーズが構図に一番合うかは自由に決めてください。\n\nサンタ帽をかぶり、首にはマフラーを巻いています。どちらのデザインも好きなスタイルにしてください。\n\n心地よい照明と暖炉の暖かさで、クリスマスらしく楽しい雰囲気になるように。\n\nこれが私のキャラクター・リファレンスです：\nhttps://drive.google.com/drive/folders/1X8n0-EvD1mCHjDMI8sTeS_ldfhr2OHFn?usp=sharing\n\nセッティングのアイデア\nhttps://imgur.com/a/AjQr5an\n\n設定は完全に一致する必要はありません。自由に変更してください。\nありがとうございました！🌸", "created_at": "", "completed_at": ""}, {"path": "/@mako_makotoo/works/195", "thumbnail_src": "https://si.imgix.net/b8002da3/uploads/origins/955a3057-605f-4354-be76-06ee94d123ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5745d6298401e3912f4b749ff122764d", "thumbnail_srcset": "https://si.imgix.net/b8002da3/uploads/origins/955a3057-605f-4354-be76-06ee94d123ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5745d6298401e3912f4b749ff122764d, https://si.imgix.net/b8002da3/uploads/origins/955a3057-605f-4354-be76-06ee94d123ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr