6bbc-4799-89a1-07c2c8db613f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f910484ac443fa7a631bc7095e6ac1", "thumbnail_srcset": "https://si.imgix.net/478f041c/uploads/origins/cd078b14-6bbc-4799-89a1-07c2c8db613f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f910484ac443fa7a631bc7095e6ac1, https://si.imgix.net/478f041c/uploads/origins/cd078b14-6bbc-4799-89a1-07c2c8db613f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c67ba67aff2146456e4d2114eb1895e 2x, https://si.imgix.net/478f041c/uploads/origins/cd078b14-6bbc-4799-89a1-07c2c8db613f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82b264139a6daaff6490a35b7ed65db9 3x", "genre": "art", "nsfw": false, "body": "あみこ（あゐこ）さん、いつも楽しませて頂いております。またまたリクエストさせていただきます。 さて今回はゴジラ FINAL WARS なウマ娘のポッケとタキオンをリクエストしたく。 ポッケが地球防衛軍の尾崎（松岡◯宏）、タキオンがX星人参謀（北村◯輝）の衣装でお願いできれば思います。 （…とすると、ガイガンがタキオン配下になりますが、この点の解釈はおまかせします） お手すきで構いません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/31", "thumbnail_src": "https://si.imgix.net/90f9c1ab/uploads/origins/3cf9673b-1f92-4f2d-a53d-91a9b87a69fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30b2050da1ef1f34443e4acdac69b554", "thumbnail_srcset": "https://si.imgix.net/90f9c1ab/uploads/origins/3cf9673b-1f92-4f2d-a53d-91a9b87a69fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30b2050da1ef1f34443e4acdac69b554, https://si.imgix.net/90f9c1ab/uploads/origins/3cf9673b-1f92-4f2d-a53d-91a9b87a69fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a8b25b0a124f3ebf57fa4c4b9b47785 2x, https://si.imgix.net/90f9c1ab/uploads/origins/3cf9673b-1f92-4f2d-a53d-91a9b87a69fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a465d8149f00e234f51b61198ef83c99 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/30", "thumbnail_src": "https://si.imgix.net/4f58a5b7/uploads/origins/7f09f082-b367-41a3-81a0-b0eb6cea1bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c445650abbe1ffca6e117ad9c148be", "thumbnail_srcset": "https://si.imgix.net/4f58a5b7/uploads/origins/7f09f082-b367-41a3-81a0-b0eb6cea1bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c445650abbe1ffca6e117ad9c148be, https://si.imgix.net/4f58a5b7/uploads/origins/7f09f082-b367-41a3-81a0-b0eb6cea1bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f0f1aa84bd19e5e458590d45e721b77 2x, https://si.imgix.net/4f58a5b7/uploads/origins/7f09f082-b367-41a3-81a0-b0eb6cea1bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c540efdce532feebd73f992442044f8a 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nドギラゴン剣のイラストに惹かれたので依頼したいです。\n\n依頼内容\nカードゲーム用プレイマットに使用するイラスト\n\nキャラクター\n遊戯王ZEXALの九十九遊馬\nデュエル・マスターズ！の轟轟轟ブランド(クリーチャー)\n\n構図･イメージ\nアストラルとの対決していて、アストラルには5体のホープ、対する遊馬は轟轟轟のみ。\n\n4枚目の九十九遊馬の後ろに腕を組んだ轟轟轟\n\nGoogleドライブでキャラデザ等を共有します。\n\nファイル形式\n\n･PSD\n･サイズ:4882×2913\n　620mm×370mmに縦15mm、横10mmの塗り足しをお願いします。\n\n･宛名とサインがあるものとないものの両方をお願いします。\n\n長文となってしまいましたが、ご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/1nNjPNr3q5hES_SMd6cPsXze2R6yW84vM", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/29", "thumbnail_src": "https://si.imgix.net/6a6a3163/uploads/origins/07c637b1-a8de-4d8f-8cdf-e5522c09486b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb2fc93215c3933de78c322dc9b2d7e", "thumbnail_srcset": "https://si.imgix.net/6a6a3163/uploads/origins/07c637b1-a8de-4d8f-8cdf-e5522c09486b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb2fc93215c3933de78c322dc9b2d7e, https://si.imgix.net/6a6a3163/uploads/origins/07c637b1-a8de-4d8f-8cdf-e5522c09486b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5d9fe7760044481af76ea8f479fa8e6 2x, https://si.imgix.net/6a6a3163/uploads/origins/07c637b1-a8de-4d8f-8cdf-e5522c09486b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3beea6d8bb123f65feada51ad8d0db0d 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\n　走り終わったシュヴァルグラン(勝負服)が蒸れた靴と靴下を脱いで裸足になり芝生の上に疲れてあぐらをかくような感じで座って休憩している絵を描いて欲しいです。顔の表情はお任せします。\n　あとできれば自分は足裏が好きなのでシュヴァルグランの足裏が写るようにして欲しいです。", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/28", "thumbnail_src": "https://si.imgix.net/8e010cf9/uploads/origins/4bbf9fcc-1c0d-4f65-86f3-eabbccc81f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8020f82d8b519b7c87bc0f8ee0092559", "thumbnail_srcset": "https://si.imgix.net/8e010cf9/uploads/origins/4bbf9fcc-1c0d-4f65-86f3-eabbccc81f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8020f82d8b519b7c87bc0f8ee0092559, https://si.imgix.net/8e010cf9/uploads/origins/4bbf9fcc-1c0d-4f65-86f3-eabbccc81f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=158816ebfc385d59b72e98f89fc868df 2x, https://si.imgix.net/8e010cf9/uploads/origins/4bbf9fcc-1c0d-4f65-86f3-eabbccc81f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a9962173299841de2888498884e4233 3x", "genre": "art", "nsfw": false, "body": "あみこさん、いつも楽しませてもらってます。\nカレーに喜ぶポッケが良く、素敵な表情だと思っていましたので、「カレーうどんを豪快に啜るポッケ」をお願いしたく。\n\n夏コミで忙しい中ですが、お手隙でお願い出来ればと思います。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/27", "thumbnail_src": "https://si.imgix.net/46ad862e/uploads/origins/3d7df23e-9ace-4775-bc23-80e366bf121c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0524cd81f64f5e068f4e88530cd48ae4", "thumbnail_srcset": "https://si.imgix.net/46ad862e/uploads/origins/3d7df23e-9ace-4775-bc23-80e366bf121c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0524cd81f64f5e068f4e88530cd48ae4, https://si.imgix.net/46ad862e/uploads/origins/3d7df23e-9ace-4775-bc23-80e366bf121c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54f295c50e26d15a0db229ba78c5cf1d 2x, https://si.imgix.net/46ad862e/uploads/origins/3d7df23e-9ace-4775-bc23-80e366bf121c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2322968a7eba8a9970609fa3958f8d46 3x", "genre": "art", "nsfw": false, "body": "Hello, nice to meet you! I really like your Umamusume drawings and art style. I'd like like to request 5 full art illustrations. All the illustrations will be ウマ娘 プリティーダービーx仮面ライダー剣.\n\n1st illustration: ジャングルポケットx剣崎 一真/仮面ライダーブレイド\n\n2nd illustration: アグネスタキオンx橘 朔也/仮面ライダーギャレン\n\n3rd illustration: ダンツフレームx相川 始/仮面ライダーカリス\n\n4th illustration: マンハッタンカフェx上城 睦月/仮面ライダーレンゲル\n\n5th illustration: ウマ娘 プリティーダービーx仮面ライダー剣ELEMENTS\n\nAny additional details I'll leave up to you. Thank you if you're willing to accept.\nYou can send back the request for the appropriate amount for the large request. Also for the 5th illustration I would like to use it as my twitter header.\n\nhttps://drive.google.com/drive/folders/1ABmllhls2HS_jmt62NlXyXFj3abnMI9F?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/26", "thumbnail_src": "https://si.imgix.net/c17ea5ec/uploads/origins/9518c811-6ec2-4c38-b590-59493acd25c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3466c632a729439e2f18b5199821d310", "thumbnail_srcset": "https://si.imgix.net/c17ea5ec/uploads/origins/9518c811-6ec2-4c38-b590-59493acd25c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3466c632a729439e2f18b5199821d310, https://si.imgix.net/c17ea5ec/uploads/origins/9518c811-6ec2-4c38-b590-59493acd25c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09553893f88ecea0b86f65e49b7d0db9 2x, https://si.imgix.net/c17ea5ec/uploads/origins/9518c811-6ec2-4c38-b590-59493acd25c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68252bcc0d28686914c1daa0c05f6154 3x", "genre": "art", "nsfw": false, "body": "はじめまして。以前シュヴァルグランとガイアッシュカイザーのイラストを拝見し、リクエストさせていただきます。\nウマ娘シンデレラグレイのオベイユアマスターとデュエル・マスターズの蒼き団長ドギラゴン剣お願い致します。オベイユアマスターの姿は一回目のジャパンカップの姿でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/25", "thumbnail_src": "https://si.imgix.net/d097f236/uploads/origins/a17a7882-101b-4f4d-8b75-b0e7987a4428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254ffb232fa9438a0bda226658e949a3", "thumbnail_srcset": "https://si.imgix.net/d097f236/uploads/origins/a17a7882-101b-4f4d-8b75-b0e7987a4428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254ffb232fa9438a0bda226658e949a3, https://si.imgix.net/d097f236/uploads/origins/a17a7882-101b-4f4d-8b75-b0e7987a4428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49cd94273a4fed8c1f0cf161e4a21ce2 2x, https://si.imgix.net/d097f236/uploads/origins/a17a7882-101b-4f4d-8b75-b0e7987a4428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40214fb971be6abccf5e95b21ced9a5d 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！私がファンであるVtuber、Puriのアートをお願いしたいです！\n\nhttps://x.com/puripuwin\n参考（画像/テキスト）：https://imgur.com/a/ubn5Vj1\n\n作風が好きです！プリが更衣室（お店で試着するようなところ）から恥ずかしい格好でどんどん出てきて、見る人に恥ずかしがったり、イライラしたりする漫画が見たいです。衣装はお任せしますが、できれば晴れ着、メイド服、ウエディングドレスがいいです！\n\n可能であれば、背景のあるバージョンとないバージョン（PSD/PNG）もお願いします！\n\n詳細はお任せします！\n\nSNS(twitter)やストリーム、サムネイル(youtube)でのプリvtuber活動に使用する可能性があります。\nご検討のほど、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@AMIk0824/works/24", "thumbnail_src": "https://si.imgix.net/8aa2fa5a/uploads/origi