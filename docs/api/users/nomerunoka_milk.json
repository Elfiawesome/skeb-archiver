bbde-7c240c224db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=830cc5570728600fffedeec755a5bca4, https://si.imgix.net/ef16b9f3/uploads/origins/6e0d7d61-5952-463b-bbde-7c240c224db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6f9653df94cfa0deaccbf0ff262d4dc 2x, https://si.imgix.net/ef16b9f3/uploads/origins/6e0d7d61-5952-463b-bbde-7c240c224db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2717e4911b1de697ac6b18837b6ed27 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n現在は配信者で、Vtuber準備中の小鳥遊ななせと申します。\n透き通る目やまつ毛が可愛く、Xで拝見しましたイラストがとても可愛かったため是非描いていただけたらと思いご依頼いたしました。\n\n描いていただきたいのは私自身となります。\n️️キャラクター: 柔らかい雰囲気、明るくよく笑う天使\n髪型: 腰あたりまで伸びているゆるいウェーブ髪 \n髪色: 桃色、インナーカラーは水色\n目: 水色、グラデーションで下はミントグリーン \n\n️𐄳モチーフ\n天使×リボン\n\n️𐄳使用用途\n・Xのタグや投稿(おはようVtuber、フォロー祭りのタグ等)\n・YouTubeのサムネイル(今後収益化予定) \n・スケジュール表 \n・Xのアイコン \n・可能でしたら、商用利用(ネットプリントやFANBOX(予定)での配布)\n\n️𐄳イラストについて\n新髪型であるハーフツインの短い髪型を描いていただけたらと思います。\nポーズ、構図はお任せします。\n表情はやんちゃな感じでお願いしたいです。\nFPSのゲーム配信、雑談配信のサムネに使えるようなものですと嬉しいです。\n顔周りや髪の毛は見切れずに構図に収めていただけたらと思います。\n\n可能であれば、背景と人物を分けたデータをいただけましたら嬉しいです。\n\n資料はこちらになります。\nhttps://drive.google.com/drive/folders/1-0TSap_FWne5OTdx3rxiAYB1ODiTp4N3\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nomerunoka_milk/works/16", "thumbnail_src": "https://si.imgix.net/f1967f38/uploads/origins/07fe785b-487f-441a-8c6b-732bfd9c0ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c329d3590e60a341270bc030a08b6f", "thumbnail_srcset": "https://si.imgix.net/f1967f38/uploads/origins/07fe785b-487f-441a-8c6b-732bfd9c0ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c329d3590e60a341270bc030a08b6f, https://si.imgix.net/f1967f38/uploads/origins/07fe785b-487f-441a-8c6b-732bfd9c0ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d2b0bdddb34b3df403e352b2d51daf9 2x, https://si.imgix.net/f1967f38/uploads/origins/07fe785b-487f-441a-8c6b-732bfd9c0ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39077b3641d425380ae51ab9c9069ec8 3x", "genre": "art", "nsfw": false, "body": "はじめまして、mi1k様のイラストを拝見し、女の子の表情と塗り方に惹かれリクエストを送らせていただきました。\n\n現在、個人Vtuberとして活動しているわるどと申します。\n\n-------\n○要望\n構図・衣装・表情おまかせで私(わるど)を書いていただきたいです。\nもふもふのしっぽとお耳がチャームポイントなので描写いただけると幸いです！\n\n参考資料\nhttps://drive.google.com/drive/folders/1d0ly6yOMdasSI42b8RmmjAgMVqVMi0VK?usp=sharing\n\n○キャラクターについて\n歌とゲームが好きなお狐Vtuberです。\n涙ぼくろは向かって右で人の耳はないです。\nモチーフは🦊と🪭です。\n\n○使用用途\nSNSアイコン、ヘッダー\nおはV、サムネイル(画像や文字重ねる等の加工)\n収益化済みの配信サイト(Twitch)での使用\nネットプリント、サブスク限定壁紙、個人用グッズ化(非商用)\n\n-----\n\nもしも背景も描いていただけるのであれば背景と人物を分けた画像もいただけると幸いです。\n\nお忙しいところ恐縮ですが、何卒ご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@nomerunoka_milk/works/15", "thumbnail_src": "https://si.imgix.net/bb668d51/uploads/origins/e46aae28-529f-42e4-a9c0-e0a2e31bbc72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7752ff3910721ca3aa204cfdeeb7754c", "thumbnail_srcset": "https://si.imgix.net/bb668d51/uploads/origins/e46aae28-529f-42e4-a9c0-e0a2e31bbc72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7752ff3910721ca3aa204cfdeeb7754c, https://si.imgix.net/bb668d51/uploads/origins/e46aae28-529f-42e4-a9c0-e0a2e31bbc72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=714f4244c5698ab6d16deb7e041059ef 2x, https://si.imgix.net/bb668d51/uploads/origins/e46aae28-529f-42e4-a9c0-e0a2e31bbc72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=197148f4275a80789282f2cb5fc7cb4c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nomerunoka_milk/works/14", "thumbnail_src": "https://si.imgix.net/b33f83ee/uploads/origins/aa0863ee-2bc7-4171-ae7f-87e7dbb10b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d1913b7c99054bef9877a58be498ed", "thumbnail_srcset": "https://si.imgix.net/b33f83ee/uploads/origins/aa0863ee-2bc7-4171-ae7f-87e7dbb10b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d1913b7c99054bef9877a58be498ed, https://si.imgix.net/b33f83ee/uploads/origins/aa0863ee-2bc7-4171-ae7f-87e7dbb10b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25c9275a6dff6603d3076cdc1a4bfcde 2x, https://si.imgix.net/b33f83ee/uploads/origins/aa0863ee-2bc7-4171-ae7f-87e7dbb10b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f1805e24719c46c5123a3a05d417bf4 3x", "genre": "art", "nsfw": false, "body": "mi1k様はじめまして！\n個人Vtuberの星乃みらいと申します。\n今回はをmi1k様に描いて頂きたいと思いリクエスト失礼します。\n\n(モチーフ)星座、星、青、水色\n(外見)髪色は銀髪、髪型はウルフ、胸は小さめ\n(表情)参考資料のような\n(服装)通常衣装モデル\n(使用用途)サブスクのお礼としてデスクトップ背景用\n横向きの9:16でお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lQk1AljtDBaXOE0DGaYLPgXsvSP3jtvF?usp=sharing\n\nhttps://drive.google.com/drive/folders/1qNQt4Aa1Pf7li_YW8gFaPgnYHhWfFVmo?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nomerunoka_milk/works/13", "thumbnail_src": "https://si.imgix.net/35a38ece/uploads/origins/56eaf40e-1b34-4c07-9b3c-8fc2f6ba8fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f765ca08e1a88a33968b7f619224f61", "thumbnail_srcset": "https://si.imgix.net/35a38ece/uploads/origins/56eaf40e-1b34-4c07-9b3c-8fc2f6ba8fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f765ca08e1a88a33968b7f619224f61, https://si.imgix.net/35a38ece/uploads/origins/56eaf40e-1b34-4c07-9b3c-8fc2f6ba8fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7f3ed