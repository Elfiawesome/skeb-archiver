a35c-02566828de5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9900b70e7600fb5ff1d126a4c55ae02, https://si.imgix.net/4ea4a8ac/uploads/origins/66d8dcf3-ce60-44dd-a35c-02566828de5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3600d9ef632be0801f04882b74dc52df 2x, https://si.imgix.net/4ea4a8ac/uploads/origins/66d8dcf3-ce60-44dd-a35c-02566828de5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba18a344b9c2b74001264738bcd16c09 3x", "genre": "art", "nsfw": false, "body": "前回もお世話になりましたが！彼女は最近新しい衣装を追加しました、今回も絵を依頼したいと思います！描いて頂けたらとても嬉しいです！(*´I`*)\n\n🍪🐶 Keks\n- 古代中国に住んでいた若い医師 / よくガラガラを持っている\n- 元気で明るい / いつも笑顔 \n- 彼女の髪はライトブロンドからグレープフルーツピンクに変わります。\n\n【古風】を使って自由にペイントしてください！\nhttps://drive.google.com/drive/folders/1oz8jafAheB5kKEKnxU2Ly8ckIr2iBLAu\n\n金額の不足、資料に問題があれば再送要請頂けますと幸いです。難しければキャンセルして頂いても構いません。ご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@scskarm/works/307", "thumbnail_src": "https://si.imgix.net/2ea081f1/uploads/origins/fcc04cd7-bd01-4f37-89ef-354073d70731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84123585d375ceb9b1ade06c1c6f5616", "thumbnail_srcset": "https://si.imgix.net/2ea081f1/uploads/origins/fcc04cd7-bd01-4f37-89ef-354073d70731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84123585d375ceb9b1ade06c1c6f5616, https://si.imgix.net/2ea081f1/uploads/origins/fcc04cd7-bd01-4f37-89ef-354073d70731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20878d0ad1da5d1d0dd1451e32e6c165 2x, https://si.imgix.net/2ea081f1/uploads/origins/fcc04cd7-bd01-4f37-89ef-354073d70731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f3c7be2a43c7a29dde9bbd9e5f3e15c 3x", "genre": "art", "nsfw": false, "body": "​Karmin先生はじめまして、先日は大変素敵な作品に仕上げてくださりありがとうございます。\n​この度はオリジナルキャラクターのマンガ創作をお願いしたく！\n​\n​2人いますので、よろしければお好きな方をお選びください。もし2人を描くことができたら、報酬の調整をお願いします!🙇🏻‍♂️\n​\n​【背景】\n​人間とお化けが共存する混沌とした世界で、2人の万屋を営んでいる。\n​\n​·少女祓魔師·来世\n​真面目な性格の女の子。 標的ではない九尾の狐を誤って殺し、相手から相手が開いた万屋で働くように頼まれ、罪悪感から引き受けた。\n​2本の短剣を持ち、1本「盛者必衰」は退魔用、もう1本「生者必滅」は悪を断つためのもの。\n​\n​構図や表情、ポーズ等についてはお任せします。 ご検討をいただけると幸いです。 もしご機会があれば是非よろしくお願い致します！\n​ https://drive.google.com/drive/folders/14p6bDdypNdYzYn8QyaeBEL1_KUmAhMGi\n​", "created_at": "", "completed_at": ""}, {"path": "/@scskarm/works/306", "thumbnail_src": "https://si.imgix.net/9c40d201/uploads/origins/dc342732-4779-4543-8864-5ec2657cd086?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea1b337c1db04f95384a18f7cfd67eae", "thumbnail_srcset": "https://si.imgix.net/9c40d201/uploads/origins/dc342732-4779-4543-8864-5ec2657cd086?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea1b337c1db04f95384a18f7cfd67eae, https://si.imgix.net/9c40d201/uploads/origins/dc342732-4779-4543-8864-5ec2657cd086?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=478c9f436faa4de6a1edfdea4f577745 2x, https://si.imgix.net/9c40d201/uploads/origins/dc342732-4779-4543-8864-5ec2657cd086?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a69c72bae24d274b7b33c0d3a439612 3x", "genre": "art", "nsfw": false, "body": "カ〜ミンさん、こんばんは。\nお世話になっております禾ズ真です。\n\n今回は自創作の主人公「フレス」をリクエストしたいと思います。\n\n資料はこちらになります。\nhttps://twitter.com/psyan75_17_ra/status/1690282041311633409?t=GYFQwQOyyMf5McOsH7dGng&s=19\n\n赤毛で襟足がハネている髪とスミレ色のマフラーがトレードマークです。\n生真面目で落ち着いた性格で、自分に自信を持てていないことから日々努力して成長しようとしている主人公です。\n争い事や刃物が苦手で、身を守るのに剣ではなく十手を使います。\n\nまた、控えめなようでかなり負けず嫌いなところがあります。\n優れた英雄が招かれる別世界に一般人の身で漂着し、そしてその世界で命を救ってくれたリナリーに恋をして以来、周りの英雄たちに男子として見劣りしないよう師匠の元で身体を鍛えつつ、防具職人の見習いとしても働いている苦労人です。\n\nリナリーを側で支え守ることができる人になるという目標のため頑張っています。\n\nリナリーにとっても自分を拾った義姉以外に初めてできた心置きなく話せる仲間で、かつ自分を全面的に信頼してくれる相手なので特別な感情を抱いています。\n\n現実と空想の境界を曖昧にしたり、他者の夢の中に入りこむことがある体質で、リナリーが悪夢を見た日は夢の中で彼女を守ったりもします。\n(しかし授かった能力で良い格好をするのには思うところがあり、リナリーを含め殆どの仲間に内緒にしています。)\n\nコンプレックスや悩みを多く抱えつつも根は明るく、笑うととても優しい表情になります。\n目指したことを諦めない性格です。 \n\n願望が混じりやすい主人公という立ち位置