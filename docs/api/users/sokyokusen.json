ress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cae7461a8c9d7d0416aaaae5d855400c", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sokyokusen/works/2", "thumbnail_src": "https://si.imgix.net/01d4b582/uploads/origins/ca8e3c83-380e-4072-87bf-7a7644af6ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f69787779d676491ddd2d9faae9436d0", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストを拝見させていただいています。\nぜひともけものフレンズのアカギツネを描いて頂けないでしょうか。\n表情、構図、背景等についてはおまかせ致します。", "created_at": "", "completed_at": ""}, {"path": "/@sokyokusen/works/1", "thumbnail_src": "https://si.imgix.net/d0bc608e/uploads/origins/f92d9ce7-e30b-4ff0-accd-689d2fbeddf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2106ee82fe1f069fb30dceccc6685122", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "鉄むすの青葉あさひがひょうたん揚げの持って嬉しそうにしているイラストをお願いします", "created_at": "", "completed_at": ""}]}