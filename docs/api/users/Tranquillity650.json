tax3i5tk/.png?rlkey=tnmeye442tmr0g1nypyyprtya&st=gkij5bhj&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Tranquillity650/works/127", "thumbnail_src": "https://si.imgix.net/a2bbc2af/uploads/origins/9b55d889-8392-4aae-a3e6-e2a4700bccb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7086823a6d151fb1ebc2445819bd01e9", "thumbnail_srcset": "https://si.imgix.net/a2bbc2af/uploads/origins/9b55d889-8392-4aae-a3e6-e2a4700bccb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7086823a6d151fb1ebc2445819bd01e9, https://si.imgix.net/a2bbc2af/uploads/origins/9b55d889-8392-4aae-a3e6-e2a4700bccb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d038e261fc79f419d985167e289e553 2x, https://si.imgix.net/a2bbc2af/uploads/origins/9b55d889-8392-4aae-a3e6-e2a4700bccb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c444f8cf5189750caecab7cee3b6a2 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n先生の「クラスのギャルに空気扱いされています 」のリクエストをお送りさせてもらいます\n内容は\n①いつも通り、空気扱いして膝の上に座っている愛乃さんのスカートが捲れてパンツが丸見えになり相沢君は勃起\n②愛乃さんはニヤニヤしながらチンポを取り出してパンツ越しのお股に押し付けてくる\n③我慢できずにそのまま愛乃さんのパンツに射精。愛乃さんも精液の感触と熱に「んっ♡」と僅かに赤面しながら震える\n④最後に愛乃さんは精液で汚れたパンツを相沢君に見せつけて終了\n\n参照URLの作品内のように愛乃さんは向かい合って座るよう感じでお願いします\n注文が多くて申し訳ございませんが受けて頂ければ幸いです\n\nhttps://www.pixiv.net/artworks/113809720", "created_at": "", "completed_at": ""}, {"path": "/@Tranquillity650/works/126", "thumbnail_src": "https://si.imgix.net/a1d5120f/uploads/origins/499c71f0-d2f2-46ff-9e79-f7b2e8e67c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec904be0b5701028a5f25fda9c32f89", "thumbnail_srcset": "https://si.imgix.net/a1d5120f/uploads/origins/499c71f0-d2f2-46ff-9e79-f7b2e8e67c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec904be0b5701028a5f25fda9c32f89, https://si.imgix.net/a1d5120f/uploads/origins/499c71f0-d2f2-46ff-9e79-f7b2e8e67c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dafa3a2a2fbe2c24de91a361ec04caaf 2x, https://si.imgix.net/a1d5120f/uploads/origins/499c71f0-d2f2-46ff-9e79-f7b2e8e67c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4874c4904747a425be707e735b572ca4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Tranquillity650/works/125", "thumbnail_src": "https://si.imgix.net/937a5720/uploads/origins/d699d3e9-9fad-49ee-80e3-4d9e214cda0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a481aa98f5a316da54d575a9ea566a2c", "thumbnail_srcset": "https://si.imgix.net/937a5720/uploads/origins/d699d3e9-9fad-49ee-80e3-4d9e214cda0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a481aa98f5a316da54d575a9ea566a2c, https://si.imgix.net/937a5720/uploads/origins/d699d3e9-9fad-49ee-80e3-4d9e214cda0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcaf0ea2114b8597e33078b68076879a 2x, https://si.imgix.net/937a5720/uploads/origins/d699d3e9-9fad-49ee-80e3-4d9e214cda0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58b3642af7f8329e6c497f4734d8236e 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nサプライ・デポをお願いしたいのですが......戦いに失敗した天龍を安全な場所に運ぶプリンセス・プリンセス。空は煙で暗く荒れ模様。\n\n天龍は全裸で顔を赤らめ、決意の表情を浮かべるサプライ・デポを見上げている。\n\n参考にさせていただきました。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1VjkxiuAP-hrLHx9U3DnL4THO1dCbDR46?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Tranquillity650/works/124", "thumbnail_src": "https://si.imgix.net/5c0f32cc/uploads/origins/97a16a11-d236-4140-9a6d-1504a5945da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74706ab8a71e0edc845137c179c15e16", "thumbnail_srcset": "https://si.imgix.net/5c0f32cc/uploads/origins/97a16a11-d236-4140-9a6d-1504a5945da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74706ab8a71e0edc845137c179c15e16, https://si.imgix.net/5c0f32cc/uploads/origins/97a16a11-d236-4140-9a6d-1504a5945da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc075587cdfcd4693052d444d29df3f9 2x, https://si.imgix.net/5c0f32cc/uploads/origins/97a16a11-d236-4140-9a6d-1504a5945da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af2ac16cd59fc6a8029a4f024855699d 3x", "genre": "art", "nsfw": true, "body": "磯×鈴3Pの続編依頼です！\n「のびたヒキガエルみたいな仰向けで嬉しそうにアヘアヘしてる磯風と、精液でドロドロになった磯風のマ〇コからザーメンブリッジを垂らしてなおまだまだギンギン状態の提督の主砲をぼーっと見つめるペタン座りの鈴谷」をお願いします！鈴谷は奇乳一歩手前の爆乳とデカケツ、磯風は先生のお好きなムチムチ具合でお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Tranquillity650/works/123", "thumbnail_src": "https://si.imgix.net/04bbdada/uploads/origins/801c5937-3253-4696-99c3-bc0a0f3a105a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68818e9f5ba02a0760dd42ce0baa4654", "thumbnail_srcset": "https://si.imgix.net/04bbdada/uploads/origins/801c5937-3253-4696-99c3-bc0a0f3a105a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68818e9f5ba02a0760dd42ce0baa4654, https://si.imgix.net/04bbdada/uploads/origins/801c5937-3253-4696-99c3-bc0a0f3a105a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c36b366a30c55f15bc2bedc45e39e1b8 2x, https://si.imgix.net/04bbdada/uploads/origins/801c5937-3253-4696-99c3-bc0a0f3a105a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7495945b249e201a3723164d8e3cc868 3x", "genre": "art", "nsfw": true, "body": "提督の顔を太ももに挟んでいる磯風(艦これ)のイラストをお願いします。\n状況的には、\n①ベッドに腰を掛けている磯風に誘惑された提督が股間に顔を埋めた状態。\n②磯風が不意に足を閉じる。太ももに顔をギュッと挟まれた提督は｢むぐっ