8:24.044623+00:00"}]}, "current_prices": {"art": 12000, "correction": 500}, "price_range": {"art": {"min": 5000, "max": 12000}, "correction": {"min": 500, "max": 2000}}, "links": [{"label": "Twitter", "url": "https://x.com/nienndesu", "name": "nienndesu"}, {"label": "Bluesky", "url": "https://bsky.app/profile/nienndesu.bsky.social", "name": "nienndesu.bsky.social"}, {"label": "Website", "url": "https://lit.link/nienn", "name": ""}], "flags": {"from_archive": true}, "works": [{"path": "/@nienndesu/works/44", "thumbnail_src": "https://si.imgix.net/30fba8ef/uploads/origins/af711f90-f432-4c99-ab9e-d8461e082c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a61ae30dd8831524054ce7defefd660", "thumbnail_srcset": "https://si.imgix.net/30fba8ef/uploads/origins/af711f90-f432-4c99-ab9e-d8461e082c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a61ae30dd8831524054ce7defefd660, https://si.imgix.net/30fba8ef/uploads/origins/af711f90-f432-4c99-ab9e-d8461e082c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29164c4d1c19e85bd25466b7bb22614d 2x, https://si.imgix.net/30fba8ef/uploads/origins/af711f90-f432-4c99-ab9e-d8461e082c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cfe69d351c468ecb21cc8a0f5116d64 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nかわいさ満点、ふんわりした絵柄に惹かれてリクエストを送らせて頂きました。\n\n私、王女系Vtuber【エイル・オリビア】のイラストを描いていただきたいと思っております。\n\n構図：お任せいたします\n服装：お任せいたします！（二円様のお好きな洋服にしていただければ幸いです💖）\n髪型：お任せいたします。王冠、リボンなどの装飾も無しのアレンジでも問題ございません！\n背景：予算の範囲内でしたら書いていただけると幸いです！\n\n使用用途：YouTubeのサムネイル（当チャンネルは収益化済みです）やSNSでの活動（Xの宣伝・FANBOXの限定壁紙）にて利用させて頂ければと思いますのでご使用の許可を頂きたいです。\n\nその他：\n背景と人物が分かれた透過済みpngデータか、psd データで納品いただきたいです。\n頭が見切れないように描いていただけるととても助かります。\n\nお忙しいところ恐れ入りますが、ご検討いただければ大変嬉しいです！\n\n以下にキービジュアル、三面図等をまとめたリンクをお送りいたします。\n🔗https://drive.google.com/drive/folders/1Vrh4a7OmEhC04fBpHrSXO2W15D0Bj--k?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nienndesu/works/43", "thumbnail_src": "https://si.imgix.net/d0659827/uploads/origins/051f9f83-1513-484f-b61f-3734c5c144e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5ffdfafa39de9a5c41d34ef0953e02", "thumbnail_srcset": "https://si.imgix.net/d0659827/uploads/origins/051f9f83-1513-484f-b61f-3734c5c144e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5ffdfafa39de9a5c41d34ef0953e02, https://si.imgix.net/d0659827/uploads/origins/051f9f83-1513-484f-b61f-3734c5c144e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4c6d908f435ab30644cdcf20b72e00b 2x, https://si.imgix.net/d0659827/uploads/origins/051f9f83-1513-484f-b61f-3734c5c144e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d698fe4701bcc289acd1bfd4db388b1a 3x", "genre": "art", "nsfw": false, "body": "初めまして。ひさぎと申します。 二円様のX投稿やskebにあるイラスト拝見させていただきとても素敵だと思い今回ご連絡させて頂いております。  \n\n■描いていただきたいもの\n個人VTuber「眞白うどん」様(https://x.com/mashiroudonn?s=21) \n\n■使用用途\n・FAとしてVTuber様へのお渡し(VTuber様のX投稿、Youtubeサムネ等での利用、グッズ等々使用許諾を頂ければ幸いです) \n\n■参考資料\nhttps://lit.link/en/mashiroudonn\nショートヘア,ウルフカットもあります(https://x.com/mashiroudonn/status/1989646375521599609?s=20) \n\n■ポーズ・構図\n・二円様の描く瞳がとても魅力的に思うので顔は正面を向くイラストで、それ以外の構図については全てお任せいたします。\n・衣装に関しては改変して頂きたく、こちら(https://x.com/nienndesu/status/1974085605643727115?s=46)のようなお洋服を着せて頂きたいです。\n・太ももはあまり細くならないようにお願いしたいです(本人が下半身太めを公言しているため) \n\n■希望納品形式\n・PSD\n・人物、背景、サイン等々のレイヤー分け\n\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nienndesu/works/42", "thumbnail_src": "https://si.imgix.net/b18ddd49/uploads/origins/64efdf1e-90ef-4f53-8351-a445a8574be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa380dbc7f537bd8f1a695249d06f18", "thumbnail_srcset": "https://si.imgix.net/b18ddd49/uploads/origins/64efdf1e-90ef-4f53-8351-a445a8574be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa380dbc7f537bd8f1a695249d06f18, https://si.imgix.net/b18ddd49/uploads/origins/64efdf1e-90ef-4f53-8351-a445a8574be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74f23931a2549b96bc26207aebc1802 2x, https://si.imgix.net/b18ddd49/uploads/origins/64efdf1e-90ef-4f53-8351-a445a8574be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a42c0955a258b786383ce734042203a2 3x", "genre": "art", "nsfw": false, "body": "niennさん こんにちは！いつもタイムラインで見るたびに、あなたの絵が大好きです。私の依頼を検討していただけると嬉しいです！白髪でピンクの瞳の女の子をミディアム〜太めのツインテールで毛先がウェーブしている感じで描いて欲しいです。ツインテールにはピンクの細いリボンを髪留めとしてつけ、前髪のどこかに黒い星型のヘアピンをつけてください。耳には小さなピアスもいくつか欲しい！制服のシャツを着て、リボンを少しゆるめにして、もうひとつ小さな星型の指輪を指にはめて。ポーズはあなた次第。彼女に似合うと思ったら、カーディガンやジャケットを着せてもいい。きっと可愛く仕上がると思います。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@nienndesu/works/41", "thumbnail_src": "https://si.imgix.net/28d62141/uploads/origins/b9ca2b3e-512a-457c-a490-ad49c2df30e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccac9035f66e0cde733d8950899b00e4", "thumbnail_srcset": "https://si.imgix.net/28d62141/uploads/origins/b9ca2b3e-512a-457c-a490-ad49c2df30e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccac9035f66e0cde733d8950899b00e4, https://si.imgix.net/28d62141/uploads/origins/b9ca2b3e-512a-457c-a490-ad49c2df30e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e02cc2baadc631dc9c5ce20c51a6d80 2x, https://si.imgix.net/28d62141/uploads/origins/b9ca2b3e-512a-457c-a490-ad49c2df30e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b459bcbe31c464376961f45bc910b56e 3x", "genre": "art", "nsfw": false, "body": "初めまして、いわたぴと申します。 二円様の素敵なイラストを拝見し、今回是非ご依頼をさせていただきたく、ご連絡いたしました。\n\n⇒使用用途 \nSNS投稿、アイコン、配信などによる商用利用(サムネイル、立ち絵等として)\n\n⇒依頼内容\n添付されたキャラクターの1枚絵\n二円様のイラストの世界観が好きなため、構図、シチュエーションなどは二円様にお任せします。自由に楽しく書いていただきたいです。\n\n左右上に見切れのない背景透過データも頂けますと嬉しいです。\n\n\n\n⇒キャラクターについて\n\n髪色…金髪、マットな水色メッシュ＋インナー\n目の色…上部オレンジ、下部紫(メインカラー)のグラデーション 特徴的なハイライトがあります\n設定…ハスキーボイス、かっこいい×かわいい\n髪型や衣装につ