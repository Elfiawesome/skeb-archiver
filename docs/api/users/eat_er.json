eted_at": ""}, {"path": "/@eat_er/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb88f7dc118dc91755a54e5a10589d5f", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb88f7dc118dc91755a54e5a10589d5f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9e5ea90ee48eecddc52f968fc138f1 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3862d303125b57d97e6b14c97417f5a3 3x", "genre": "voice", "nsfw": false, "body": "応援セリフのリクエストになります。\n\n「挫けそうになったらまずは深呼吸です。\n立ち止まって落ち着いて、それから、もう一回歩き出しましょう。\n頑張れ」\n\n頑張れの前に少し間をおいていただけると幸いです。\n語尾などの細かい部分の変更はお任せいたします。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@eat_er/works/1", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb88f7dc118dc91755a54e5a10589d5f", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb88f7dc118dc91755a54e5a10589d5f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1237649724603129856%2Fuf_oGg9U.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9e5ea90ee48eecddc52f968fc138f1 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twi