iv.net/artworks/114399061\n\nシチュはお嬢様（赤い方）のえっちな魔法実験が失敗しちゃって、二人とも拘束されてもがく。そんな中片方だけあと少しでこのピンチから脱出できる希望（ハサミとかアイテムとか）に（手でも口でも）触れそうだけど、拘束ミトンとかテープとかとにかくなんやで最後の希望も絶たれそうな感じをお願いします。\n\n拘束については誰に何をつけるとかは特にありませんが\nこういう感じの目隠しと猿轡が見たいですね\nhttps://misskey.io/notes/a45ehmycugt402a5\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/34", "thumbnail_src": "https://si.imgix.net/a872484b/uploads/origins/0db53f02-a0dd-4ed9-a6a5-5751092113b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=862822a4b4c0b1b82be40c18a33ee003", "thumbnail_srcset": "https://si.imgix.net/a872484b/uploads/origins/0db53f02-a0dd-4ed9-a6a5-5751092113b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=862822a4b4c0b1b82be40c18a33ee003, https://si.imgix.net/a872484b/uploads/origins/0db53f02-a0dd-4ed9-a6a5-5751092113b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60fbea900ddcfec36c241dc8e3a15fe4 2x, https://si.imgix.net/a872484b/uploads/origins/0db53f02-a0dd-4ed9-a6a5-5751092113b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10e6e5572fd651976b172365dc80944f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/33", "thumbnail_src": "https://si.imgix.net/4b9bb730/uploads/origins/4b05f8db-d9d2-4fd0-8344-0dd6f5b2bbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d565d61a8c4d189e7e4f8caf0550c12", "thumbnail_srcset": "https://si.img