-4de9-89f0-5beca313a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab92cdddeab9e4bda32aecf5ce9200b4 2x, https://si.imgix.net/3d34106a/uploads/origins/93214a85-4ba3-4de9-89f0-5beca313a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14df1cf29e37201e9731de4cd6b379ae 3x", "genre": "art", "nsfw": true, "body": "りょう先生こんにちは。\nいつも先生の絵が気に入っています。良かったら以下の緊縛絵リクエストをお願いします。\n\nキャラ：バンドリ　豊川祥子\n衣装：通常衣装・裸足\nhttps://anime.bang-dream.com/avemujica/character/sakiko/\n\nシチュ：自宅の床に必死にもがいてる。表情は赤面で睨ん感じ。\n拘束は胸を強調する高手小手縛り、股縄（服が許す範囲に下着が見え）、両足揃って膝+足首+足の甲+足の親指をまとめて縛る。背景は六畳和室もしくは木の部屋。\n\n出来れば、以下の差分もお願いします：\n乳首と陰部ローター\nボールギャグ（涎あり）\n涙目\n\n構図は基本的にお任せしますが、足裏が見てる角度でお願いします。\n\nご検討ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/29", "thumbnail_src": "https://si.imgix.net/c9042d1e/uploads/origins/d0f469c8-b22d-47ae-b759-1d7613dfcc30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ee2cee22e72fcc589fc055bed334517", "thumbnail_srcset": "https://si.imgix.net/c9042d1e/uploads/origins/d0f469c8-b22d-47ae-b759-1d7613dfcc30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ee2cee22e72fcc589fc055bed334517, https://si.imgix.net/c9042d1e/uploads/origins/d0f469c8-b22d-47ae-b759-1d7613dfcc30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f6b2410480a26e04baaa16cd8fb0dd5 2x, https://si.imgix.net/c9042d1e/uploads/origins/d0f469c8-b22d-47ae-b759-1d7613dfcc30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a8b3d32531488cc9a71083c320664d8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/28", "thumbnail_src": "https://si.imgix.net/680fa784/uploads/origins/5fd13a08-6153-44a8-8f6f-f566806f7d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6663c199dff1d5601a58885883c17309", "thumbnail_srcset": "https://si.imgix.net/680fa784/uploads/origins/5fd13a08-6153-44a8-8f6f-f566806f7d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6663c199dff1d5601a58885883c17309, https://si.imgix.net/680fa784/uploads/origins/5fd13a08-6153-44a8-8f6f-f566806f7d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=720827a7f0d530257215b9263737ced5 2x, https://si.imgix.net/680fa784/uploads/origins/5fd13a08-6153-44a8-8f6f-f566806f7d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5e91cb7c20391752e746b8d01abc320 3x", "genre": "art", "nsfw": true, "body": "『CHUNITHM』というアーケードゲーム内のユニット\n「イロドリミドリ」の《小仏 凪》と《葛城 華》を描いていただきたいです。\n\nシチュエーション：監禁後\n・（https://skeb.jp/@ryoattoryo/works/27）の監禁場所と縛り方で、\n制服を着たまま胸を強調する感じで股を開いた状態で縛られている。（２人とも正面向き）\n\n・パンツはずらされて、膣にピンクローターを挿入されており、リモコンは太ももの縄に固定されている。\n\n・２人とも頬をつたうほど涙を流している\n\n・２人とも激しく抵抗した汗で制服にブラジャーが透けている\n\n・２人とも口の中や膣内に射精された後な感じで、精液が膣や口元からこぼれている\n\n\n服装：キャラクター紹介時の制服\n《小仏 凪》（ジャケットは剥ぎ取られて床に落としておいて欲しいです）\n（https://chunithm.sega.jp/irodorimidori/character/%E5%B0%8F%E4%BB%8F%E5%87%AA/）\n\n《葛城 華》\n（https://chunithm.sega.jp/irodorimidori/character/%E8%91%9B%E5%9F%8E%E8%8F%AF/）\n\n\n用途：大きく印刷して飾ろうと思っていますので、\nB3サイズくらいの大きさでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/27", "thumbnail_src": "https://si.imgix.net/fd9f6aaa/uploads/origins/02c8f8bb-6629-4239-8b16-71a7d45703fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f38b6c473c736e2def46721800706f0", "thumbnail_srcset": "https://si.imgix.net/fd9f6aaa/uploads/origins/02c8f8bb-6629-4239-8b16-71a7d45703fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f38b6c473c736e2def46721800706f0, https://si.imgix.net/fd9f6aaa/uploads/origins/02c8f8bb-6629-4239-8b16-71a7d45703fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d666db3d807b6be01149e803a914a350 2x, https://si.imgix.net/fd9f6aaa/uploads/origins/02c8f8bb-6629-4239-8b16-71a7d45703fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6ef5062d3bf1947c7995e9cd33c0246 3x", "genre": "art", "nsfw": true, "body": "『CHUNITHM』というアーケードゲーム内のユニット\n「イロドリミドリ」の《月鈴白奈》と《御形アリシアナ》を描いていただきたいです。\n\nシチュエーション：監禁後\n・（https://www.pixiv.net/artworks/72234603#1）の縛り方で、\n制服を着たまま胸を強調する感じで股を開いた状態で縛られている。（２人とも正面向き）\n\n・パンツはずらされて、膣にピンクローターを挿入されており、リモコンは太ももの縄に固定されている。\n（月鈴白奈はパンツ周りのタイツを破られて、パンツをずらされている）\n\n・２人とも頬をつたうほど涙を流している\n\n・２人とも激しく抵抗した汗で制服にブラジャーが透けている\n\n・２人とも口の中や膣内に射精された後な感じで、精液が膣や口元からこぼれている\n\n\n服装：キャラクター紹介時の制服\n《月鈴白奈》（ストールは剥ぎ取られて床に落としておいて欲しいです）\n（https://chunithm.sega.jp/irodorimidori/character/%E6%9C%88%E9%88%B4%E7%99%BD%E5%A5%88/）\n（https://pbs.twimg.com/media/DuDNm1nVsAAjsOi?format=jpg&name=large）\n\n《御形アリシアナ》\n（https://chunithm.sega.jp/irodorimidori/character/%E5%BE%A1%E5%BD%A2%E3%82%A2%E3%83%AA%E3%82%B7%E3%82%A2%E3%83%8A/）\n\n\n用途：大きく印刷して飾ろうと思っていますので、\nB3サイズくらいの大きさでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/26", "thumbnail_src": "https://si.imgix.net/38775ceb/uploads/origins/27addda6-cda6-4c42-8ea9-236c3a640f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=532b4b29420bd122666fa5871d01b6ab", "thumbnail_srcset": "https://si.imgix.net/38775ceb/uploads/origins/27addda6-cda6-4c42-8ea9-236c3a640f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=532b4b29420bd122666fa5871d01b6ab, https://si.imgix.net/38775ceb/uploads/origins/27addda6-cda6-4c42-8ea9-236c3a640f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3039fb8cbc0392314d45df4908c595ca 2x, https://si.imgix.net/38775ceb/uploads/origins/27addda6-cda6-4c42-8ea9-236c3a640f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc4f520c947eeec7b073f1c438ec7460 3x", "genre": "art", "nsfw": true, "body": "はじめまして、りょう先生。先生の作品の大ファンです。\nブルブルの桐藤ナグサと聖園ミカの写真が欲しいです。\nhttps://www.pixiv.net/artworks/85793935\n二人の少女が縛られ、棒につながれている。二人の少女は上半身をマタナワで縛っている。足もこのように縛られている。https://www.pixiv.net/artworks/112824378\n二人は裸で、制服のリボンとパンスト（渚は黒、美香は白）、ハイヒールを履いているだけ。参照：https://skeb.jp/@calicchio23/works/404\n猿轡はしていない。表情は少し涙を流しながら、恥ずかしそうに緊張している。\n背中の羽も結ばれている。\n背景は明るい部屋。シンプルでOK。\n\nもし許されるなら、このようなバリエーションがあるとありがたい：\n(1):結び目で猿ぐつわ。\n(2):トロ顔で乳首と陰部に振動卵を接続。\n(3):(1)+(2)\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/25", "thumbnail_src": "https://si.imgix.net/1432314e/uploads/origins/6dc1d6b3-a924-455f-93f4-9548e6d092cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f072173d6a61850cb2eb35cef8d3c25", "thumbnail_srcset": "https://si.imgix.net/1432314e/uploads/origins/6dc1d6b3-a924-455f-93f4-9548e6d092cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f072173d6a61850cb2eb35cef8d3c25, https://si.imgix.net/1432314e/uploads/origins/6dc1d6b3-a924-455f-93f4-9548e6d092cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56eed391d9d45bb1b4b16697c5d8c62e 2x, https://si.imgix.net/1432314e/uploads/origins/6dc1d6b3-a924-455f-93f4-9548e6d092cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4cb71333346546dda09a4d2fb8f90ba 3x", "genre": "art", "nsfw": true, "body": "そちらの子のイリスちゃんとケルンくんがおせっせえっちがを依頼したいです（ストレート）\n衣装は両人とも法被+ふんどしでずらし挿入\n可能であれば事中→フィニッシュ→事後があれば幸いです。\nあとは全部おまかせします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/24", "thumbnail_src": "https://si.imgix.net/a56d81eb/uploads/origins/7cf608d0-79ad-4d68-a9f5-c566d7467204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44793ef99db1cb57cc68c68eac3ac7bc", "thumbnail_srcset": "https://si.imgix.net/a56d81eb/uploads/origins/7cf608d0-79ad-4d68-a9f5-c566d7467204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44793ef99db1cb57cc68c68eac3ac7bc, https://si.imgix.net/a56d81eb/uploads/origins/7cf608d0-79ad-4d68-a9f5-c566d7467204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17ff12a668438b93fcfcc0bfeb37ffd1 2x, https://si.imgix.net/a56d81eb/uploads/origins/7cf608d0-79ad-4d68-a9f5-c566d7467204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9753d7a0fb5ca2e6bf5481489a12218a 3x", "genre": "art", "nsfw": true, "body": "はじめまして。オリキャラ（うちのこ）の着衣緊縛イラストをリクエストいたします。\n\n【服装】ミニ丈のスリムニットワンピース。色、細かいデザイン等はおまかせします。靴下は履かず素足。\n\n【詳細】\n縛り方は胸を強調するように後手縛り、両足は揃えるようにして縛る。裾が捲りあげられ、股縄とピンクローターがパンツに食い込んでいる。布の猿轡を噛まされている。\n\nシチュエーションとしては「厳重な緊縛から縄抜けをする」という内容での動画撮影。床orベッドに横たわった体勢から縄抜けをしようとするが全く緩まず、もがいた際に股縄とローターが食い込んで感じてしまっている。\n\nよろしくお願いします\n\nhttps://imgur.com/a/t2I7dgz", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/23", "thumbnail_src": "https://si.imgix.net/79d93179/uploads/origins/98820658-af78-49a9-a897-a1af1f190958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68987f8fe65095e7969a6408330cd29", "thumbnail_srcset": "https://si.imgix.net/79d93179/uploads/origins/98820658-af78-49a9-a897-a1af1f190958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68987f8fe65095e7969a6408330cd29, https://si.imgix.net/79d93179/uploads/origins/98820658-af78-49a9-a897-a1af1f190958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc6b239f6b4eb06a132001bfde6aa4a8 2x, https://si.imgix.net/79d93179/uploads/origins/98820658-af78-49a9-a897-a1af1f190958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb779c3e3321def44b9bacffea6a5805 3x", "genre": "art", "nsfw": true, "body": "『艦これ』の「山城」と「伊良湖」をカラーで描いていただきたいです。\n\nシチュエーション：お仕置き後\n・２人は縄で手首と腕を縛られてひざ立ち\n（２人とも正面向き）\n\n・縄は上から吊られており、両手は頭の上へ伸びている\n（https://skeb.jp/@ryoattoryo/works/3 と同じ縛り方で）\n\n・服は両胸やおなかが見えるように正面で破かれている。\n\n・ブラは無しで、おっぱいをたくさん吸われた後な感じで胸にはよだれが残っている\n（剥ぎ取られたブラが足の上か床にあると嬉しいです）\n\n・膣から中出しされた精液がこぼれているのが見えるようにパンツはずらされて、\nスカートは破られるか下げられている。\n\n・２人とも頬をつたうほど涙を流している\n\n用途：大きく印刷して飾ろうと思っていますので、\nB3サイズくらいの大きさでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/22", "thumbnail_src": "https://si.imgix.net/8d4b8e69/uploads/origins/52eefa4b-a3f1-459a-8172-07bcd124defa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46113413ac37969e947bc4018430350f", "thumbnail_srcset": "https://si.imgix.net/8d4b8e69/uploads/origins/52eefa4b-a3f1-459a-8172-07bcd124defa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46113413ac37969e947bc4018430350f, https://si.imgix.net/8d4b8e69/uploads/origins/52eefa4b-a3f1-459a-8172-07bcd124defa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9ac59ad4557ca25d182752c97447c76 2x, https://si.imgix.net/8d4b8e69/uploads/origins/52eefa4b-a3f1-459a-8172-07bcd124defa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=515a47b573968898a7fd05c944b3abad 3x", "genre": "art", "nsfw": true, "body": "そちらのイリスちゃんが、手足ともに動かせないように拘束された上で着衣でスパッツの上から電マを延々と当てられ、ぐしゃぐしゃに泣きながらも歯を食いしばって必死に快楽を耐えようとするも、あえなく何回も何十回もイかされてしまうイラストをお願いします！\n\nイリスちゃん！！！！！イリスちゃん大好き！！！！！！\nhttps://www.pixiv.net/artworks/92486484 とか https://www.pixiv.net/artworks/102739447 の7枚目とかとても好きです。ボーイッシュで一見男の子と見紛うような子が、女の子の快楽で泣かされているのは素晴らしいですね……\nスパッツも良い……スパッツ越しにねっとりした愛液が染み出ているのは至極……", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/21", "thumbnail_src": "https://si.imgix.net/f0052396/uploads/origins/f31fd137-8543-413e-be68-78e834506f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20d7b0e1c4cf171705c107405da4d998", "thumbnail_srcset": "https://si.imgix.net/f0052396/uploads/origins/f31fd137-8543-413e-be68-78e834506f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20d7b0e1c4cf171705c107405da4d998, https://si.imgix.net/f0052396/uploads/origins/f31fd137-8543-413e-be68-78e834506f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2d57482b257581fde85497491f7f19b 2x, https://si.imgix.net/f0052396/uploads/origins/f31fd137-8543-413e-be68-78e834506f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b55f23640b6cfbe4468743f37a66169 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私はあなたの絵の大ファンです。私の友人Katsu(23歳)のためにアートピースをお願いしたいのですが、参考ポーズのように縛られ、全裸か服を着たまま、誰かが頭を踏んでいるようなもので、タオルで猿ぐつわをしてください。参考ポーズのように、バイブと彼女の目もお願いします！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1WXwKPmJ7V3n1WO0fPSbN6eavcHIPo7Hj?usp=sharing\n\nhttps://drive.google.com/drive/folders/1WXwKPmJ7V3n1WO0fPSbN6eavcHIPo7Hj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ryoattoryo/works/20", "thumbnail_src": "https://si.imgix.net/15461696/uploads/origins/bc69af42-1b32-4e0d-b144-4544bd52e0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24c348789ff47091eb04b60bf5d77770", "thumbnail_srcset": "https://si.imgix.net/15461696/uploads/origins/bc69af42-1b32-4e0d-b144-4544bd52e0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24c348789ff47091eb04b60bf5d77770, https://si.imgix.net/15461696/uploads/origins/bc69af42-1b32-4e0d-b144-4544bd52e0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e51d8d584465a30f5dccd8586b3c1e0 2x, https://si.imgix.net/15461696/uploads/origins/bc69af42-1b32-4e0d-b144-4544bd52e0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&