af4cf8/uploads/origins/44da1c1d-68e9-4a7f-8199-5fe20522fc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4404b8a9e1e55093b9c584d7922fde54", "thumbnail_srcset": "https://si.imgix.net/a4af4cf8/uploads/origins/44da1c1d-68e9-4a7f-8199-5fe20522fc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4404b8a9e1e55093b9c584d7922fde54, https://si.imgix.net/a4af4cf8/uploads/origins/44da1c1d-68e9-4a7f-8199-5fe20522fc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af94007c06c578c94f8081398926cb21 2x, https://si.imgix.net/a4af4cf8/uploads/origins/44da1c1d-68e9-4a7f-8199-5fe20522fc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0584b4e5966b05512c0999d08b9e480c 3x", "genre": "art", "nsfw": false, "body": "庵さんこんにちは！いつも素敵絵拝見させていただいております！\n今回は思い切ってskebで依頼をしてみようとメッセージしてみました！\n\n構図等はお任せで、夏のふともも眩しい水着なデセールさんをお願い致します～\n添付資料のような青を使った配色希望で、キャラクターのみで背景無しでOKです！\n\n不明点等ありましたらメッセージ頂けますと幸いです。よろしくお願いしますー！\n\nhttps://x.com/ioiori18/status/1925871026325303655/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@ioiori18/works/33", "thumbnail_src": "https://si.imgix.net/3209afba/uploads/origins/e7b25717-0e5b-4378-8519-8513cf6b9960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd550046e21fc4def9891702f710dd7", "thumbnail_srcset": "https://si.imgix.net/3209afba/uploads/origins/e7b25717-0e5b-4378-8519-8513cf6b9960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd550046e21fc4def9891702f710dd7, https://si.imgix.net/3209afba/uploads/origins/e7b25717-0e5b-4378-8519-8513cf6b9960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49081ad3c527c2e7e39271b7fa13af7a 2x, https://si.imgix.net/3209afba/uploads/origins/e7b25717-0e5b-4378-8519-8513cf6b9960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12f03da3f5091e9a80b29663c5a9f7d4 3x", "genre": "art", "nsfw": false, "body": "初