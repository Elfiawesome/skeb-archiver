iddle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f90e4a2ac67af243aa19633fe639e85, https://si.imgix.net/c47bd2f7/uploads/origins/ec821ade-6cd6-4c09-acaa-0df73f5e7f04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=652d0f49f8253cac88cc2f9a92115544 2x, https://si.imgix.net/c47bd2f7/uploads/origins/ec821ade-6cd6-4c09-acaa-0df73f5e7f04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cc9f723d0d9c196aaf0340b74594cad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jin_morisono/works/1618", "thumbnail_src": "https://si.imgix.net/6e774ec9/uploads/origins/a44406af-a749-4871-9566-cdf70ab170ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d45e41be023d3beb271ca4ea7d68a86f", "thumbnail_srcset": "https://si.imgix.net/6e774ec9/uploads/origins/a44406af-a749-4871-9566-cdf70ab170ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d45e41be023d3beb271ca4ea7d68a86f, https://si.imgix.net/6e774ec9/uploads/origins/a44406af-a749-4871-9566-cdf70ab170ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68c7afcecd700a7b1134c46c21d8f015 2x, https://si.imgix.net/6e774ec9/uploads/origins/a44406af-a749-4871-9566-cdf70ab170ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21f8aaa14c2c49ce4d9db1d9a59178dd 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\n今回も、一キャラごとに一枚ずつ、という感じでリクエストさせて下さい。\n\nキャラクター\n折原碧(ショッキングBoy)\n並木綾音(ショッキングBoy)\n麻生慧子(ショッキングBoy)\n\n構図\n以前描いて頂いた、全裸のモリガンがシャワーを浴びながら、モブ男性に跨がって巨乳をブルンッブルンッと揺らしながら、エナジードレインをしている場面を、上記の3名でお願いします\n(ポーズは、資料URLのモリガンの様な騎乗位でお願いします)\n\n折原碧→一枚目\n麻生慧子→二枚目\n並木綾音→三枚目\nでお願いします\n\n描写\n・資料URLの様な、目に光のない、操られているかの様な虚ろな目をしている\n\n表情\n・無表情\n・微笑んでいる\n     でお願いします。\n\n詳細\n・3名とも、資料URLレベルの巨乳で、碧は二人より大きく描写して下さい。\n・3名の乳首をやや小さめに、陰部や陰毛は描かず、マネキンの様なツルツルにして描いて下さい。\n・並木綾音の髪の長さを肩甲骨辺りまで伸ばして下さい\n\nまた可能であれば、線画や陰影なしの下塗りを同じく掲載してくれたら幸いです。\n\n以上となります。希望がいつもより多めですが、リクエストを宜しくお願いします\n\nhttps://si.imgix.net/66f1fbba/uploads/origins/dd9c43ce-bfe3-48c8-bcaf-8567e51a6403?bg=%23fff&txtfont=bold&txtshad=70&txtclr=BFFFFFFF&txtalign=middle%2Ccenter&txtsize=150&txt=SAMPLE&auto=format&fm=webp&w=800&s=d4f2af1f158471ba7602be791216df50", "created_at": "", "completed_at": ""}, {"path": "/@jin_morisono/works/1617", "thumbnail_src": "https://si.imgix.net/6e3a3fde/uploads/origins/f5097888-a2c3-4c44-b6d1-7e00220961bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce308eebb4c138aae90f1e8805806eb9", "thumbnail_srcset": "https://si.imgix.net/6e3a3fde/uploads/origins/f5097888-a2c3-4c44-b6d1-7e00220961bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce308eebb4c138aae90f1e8805806eb9, https://si.imgix.net/6e3a3fde/uploads/origins/f5097888-a2c3-4c44-b6d1-7e00220961bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89afdcf0de26ef84a43bcd5e00b0baf2 2x, https://si.imgix.net/6e3a3fde/uploads/origins/f5097888-a2c3-4c44-b6d1-7e00220961bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47c3a23225f7eba4417e7a4b7dafb338 3x", "genre": "art", "nsfw": true, "body": "間違いがあったら謝ります。故意ではありません。\n\n私のキャラクターが激しく、気持ちいいセックスをしているアートをお願いします。ソニアはセックスが大好きな妻なので、何でもしてあげてください！楽しんでください。\n\n引き締まったお腹が好きなので、それも入れてもらえるとありがたいですが、必須ではありません。\n\n名前ソニア\nhttps://drive.google.com/file/d/1BFBidxQO5_v1L5Ir6J22je9fxpvhwz2e/view\n\nその他の参照: https://drive.google.com/drive/folders/1fzo7-zwdRJWkvsLhcVm9itiypO9iI8Mu\n\n私の依頼を検討していただき、ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@jin_morisono/works/1616", "thumbnail_src": "https://si.imgix.net/349bdcbb/uploads/origins/d2a9a605-63f6-4e76-9422-20983a1a71c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa68e54ed322d17b0f94393ba4a2346a", "thumbnail_srcset": "https://si.imgix.net/349bdcbb/uploads/origins/d2a9a605-63f6-4e76-9422-20983a1a71c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa68e54ed322d17b0f94393ba4a2346a, https://si.imgix.net/349bdcbb/uploads/origins/d2a9a605-63f6-4e76-9422-20983a1a71c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d95952915ff4ce6330abccac052f378c 2x, https://si.imgix.net/349bdcbb/uploads/origins/d2a9a605-63f6-4e76-9422-20983a1a71c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aab6a6cb862cc59f2bb4e5f08c1fced7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jin_morisono/works/1615", "thumbnail_src": "https://si.imgix.net/5841479f/uploads/origins/b524981d-94f3-4d92-9eeb-5a11471edfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e16ad2ae42f987f3781cc06bd33ec7e", "thumbnail_srcset": "https://si.imgix.net/5841479f/uploads/origins/b524981d-94f3-4d92-9eeb-5a11471edfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e16ad2ae42f987f3781cc06bd33ec7e, https://si.imgix.net/5841479f/uploads/origins/b524981d-94f3-4d92-9eeb-5a11471edfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88f74c5b66bb14335b4b7d332313141b 2x, https://si.imgix.net/5841479f/uploads/origins/b524981d-94f3-4d92-9eeb-5a11471edfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=970b5bfb930856a740e34eaa9860b8bb 3x", "genre": "art", "nsfw": true, "body": "FGOのバーゲストが山の巨人にベアハッグで締め上げられ、圧倒的体格差の前に為す術もない様子のシチュをお願いします。\n\nシチュ：\n・竿役が女性の腰付近を自分の胸付近の位置で締めており、女性が高くリフトアップされて女性の頭が竿役の頭より高い位置にある状態。\n・女性は抵抗しているが、 腕の太さがまるで違い、びくともしない様子（腕の太さの差が映える構図）。\n・巨人は程々の体格差（下記資料程度）\nhttps://drive.google.com/file/d/1uEdQ28YJS4zTVsu91BMzH4rgp9b72sjb/view?usp=drive_link\n\n・バーゲストは髪型ポニテで肩周りの筋肉が映る髪型、服装は全裸に極小のビキニパンツのみ着用（映らなくても可）\n・バーゲストは折れる寸前のようで限界ギリギリのような表情\n・巨人は服やアクセサリー等はなしで全裸", "created_at": "", "completed_at": ""}, {"path": "/@jin_morisono/works/1614", "thumbnail_src": "https://si.imgix.net/b1da538b/uploads/origins/a043e6df-2af9-4706-a532-5218255a32fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e184b66d04e1d8536e73ce716398ad0", "thumbnail_srcset": "https://si.imgix.net/b1da538b/uploads/origins/a043e6df-2af9-4706-a532-5218255a32fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e184b66d04e1d8536e73ce716398ad0, https://si.imgix.net/b1da538b/uploads/origins/a043e6df-2af9-4706-a532-5218255a32fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9aa85aa46c229043c4463acddc1c7c4 2x, https://si.imgix.net/b1da538b/uploads/origins/a043e6df-2af9-4706-a532-5218255a32fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70f3012fb8f853e2febd5fb49c2af122 3x", "genre": "art", "nsfw": true, "body": "バレンタイン舞のミイラ化した作品が欲しいのですが、お時間がありますか？彼女が包まれる前と後に、彼女の決意を弱めるためにオーガズムを追加することはできますか？\n\nhttps://skeb.jp/@rekka46/works/22\n\nhttps://skeb.jp/@honotomo7/works/87\n\nhttps://skeb.jp/@oguwooo/works/65\n\nhttps://skeb.jp/@wade_williams99/works/162\n\nhttps://skeb.jp/@Kta_osushi/ワークス/187\n\nカードデザインとモンスターのデザインがとても好きです。舞の衣装のビフォアとクビレ、そしてファイナルは舞がすっぽりセクシーに包まれた状態でお願いできませんか？", "created_at": "", "completed_at": ""}, {"path": "/@jin_morisono/works/1613", "thumbnail_src": "https://si.imgix.net/ac35854d/uploads/origins/24b3c24c-f316-4668-bf6f-e0d7ab947202?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=P