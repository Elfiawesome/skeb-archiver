9adc-a88534cab065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b5d96d29463dd381f371b3a187f39e5", "thumbnail_srcset": "https://si.imgix.net/7ec44919/uploads/origins/7b90cff0-ca4a-468d-9adc-a88534cab065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b5d96d29463dd381f371b3a187f39e5, https://si.imgix.net/7ec44919/uploads/origins/7b90cff0-ca4a-468d-9adc-a88534cab065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=875776936e94f403da310f80f0f90ef5 2x, https://si.imgix.net/7ec44919/uploads/origins/7b90cff0-ca4a-468d-9adc-a88534cab065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d7ceac8bce7d7f8c68cbcefeb79c348 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\nアピール文でネクロニカ民とお見受けしたので是非リクエストさせていただきます。\n\nクロアちゃん（下記URL2枚目）を描いていただきたいです。\nhttps://www.pixiv.net/artworks/90071944\nにくむちが生えている絵に関しては下記URL1枚目、2枚目（5ページ）を参考にしてください。\nhttps://www.pixiv.net/artworks/73787093\nhttps://www.pixiv.net/artworks/90070098\n\n性格としては大人しくて内気で引っ込み思案気味なのですが、一方で性悪な部分があり自分が優勢に立てそうになると調子に乗ってタガが外れるような子です。\nなので可能でしたらそういった面を強調したサディスティックな雰囲気でお願いしたいです。（白タイツ脚とかよく見えてたら嬉しいです）", "created_at": "", "completed_at": ""}, {"path": "/@n_hyr/works/2", "thumbnail_src": "https://si.imgix.net/cbca3ae3/uploads/origins/32060dd3-c5a8-4ea1-bc79-1b122a53a747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2ade1c10231905d88dcbcec976f9c40", "thumbnail_srcset": "https://si.imgix.net/cbca3ae3/uploads/origins/32060dd3-c5a8-4ea1-bc79-1b122a53a747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2ade1c10231905d88dcbcec976f9c40, https://si.imgix.net/cbca3ae3/uploads/origins/32060dd3-c5a8-4ea1-bc79-1b122a53a747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1990c4a22ca586a4472c12ef0717c4d7 2x, https://si.imgix.net/cbca3ae3/uploads/origins/32060dd3-c5a8-4ea1-bc79-1b122a53a747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cr