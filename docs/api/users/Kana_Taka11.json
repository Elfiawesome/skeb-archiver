d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c36c7caf123d15684bf0779f2ff9ad24 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/47", "thumbnail_src": "https://si.imgix.net/e1527ad9/uploads/origins/218272fb-8d08-4aec-8fe2-13cebda4ab9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f983b847b0e618f32ee6140289659ff", "thumbnail_srcset": "https://si.imgix.net/e1527ad9/uploads/origins/218272fb-8d08-4aec-8fe2-13cebda4ab9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f983b847b0e618f32ee6140289659ff, https://si.imgix.net/e1527ad9/uploads/origins/218272fb-8d08-4aec-8fe2-13cebda4ab9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1d5dd103bd29375a49793000b89c2a4 2x, https://si.imgix.net/e1527ad9/uploads/origins/218272fb-8d08-4aec-8fe2-13cebda4ab9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ce62c6210b9325669c3dcf92f535acc 3x", "genre": "art", "nsfw": false, "body": "はじめまして。私のキャラクターのイラストをお願いできますか？\nhttps://www.dropbox.com/scl/fo/4e38y7nd6utp970att6h9/AMklD8Sv0MUmTpMX1ErmtQw?rlkey=8fa6qu97ro567k33pa3waa8oy&st=bmex3v9w&dl=0\n\nhttps://x.com/htklik/status/1771229419668955443。\nできれば全身が見えるような、夏の上野不忍池のような公園のベンチに座っているような。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/46", "thumbnail_src": "https://si.imgix.net/ef22021a/uploads/origins/c288d0b2-c87c-47c3-a6c2-6982d4cf8a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1fd8cfed14433fdbf8efb404071689", "thumbnail_srcset": "https://si.imgix.net/ef22021a/uploads/origins/c288d0b2-c87c-47c3-a6c2-6982d4cf8a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1fd8cfed14433fdbf8efb404071689, https://si.imgix.net/ef22021a/uploads/origins/c288d0b2-c87c-47c3-a6c2-6982d4cf8a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=987a7390f60076d024cb6205975d8b94 2x, https://si.imgix.net/ef22021a/uploads/origins/c288d0b2-c87c-47c3-a6c2-6982d4cf8a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ba5a87087004e99375c45f8ffa04da5 3x", "genre": "art", "nsfw": true, "body": "鷹なゆさんお久しぶりです！\n温泉旅館の風呂上がりに虹夏ちゃんが転んでぼっちちゃんを巻き込んで倒れて押し倒す体勢の形になった…というシチュエーションで、\n虹夏ちゃんの掌が宿の浴衣がはだけたぼっちちゃんの生胸を鷲掴みにしているというイラストをリクエストします。\n\n地区美券の有無やはだけ具合などはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/45", "thumbnail_src": "https://si.imgix.net/da6fa755/uploads/origins/486f1bd0-8caa-4ab2-a2db-ad83bb8ccea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62dca7b6ba6236604e8535ff1b71e14e", "thumbnail_srcset": "https://si.imgix.net/da6fa755/uploads/origins/486f1bd0-8caa-4ab2-a2db-ad83bb8ccea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62dca7b6ba6236604e8535ff1b71e14e, https://si.imgix.net/da6fa755/uploads/origins/486f1bd0-8caa-4ab2-a2db-ad83bb8ccea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=184fc8db425d6d413c6ca41d0fd3fa57 2x, https://si.imgix.net/da6fa755/uploads/origins/486f1bd0-8caa-4ab2-a2db-ad83bb8ccea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c292463b6e9080cc50395cc134dc9bff 3x", "genre": "art", "nsfw": true, "body": "ぼっち・ざ・ろっく！のぼっちちゃんと喜多ちゃんがタオルを身体に巻くか前を隠すかして温泉に浸かってくつろいでいるイラストをリクエストします。\n濡れ透けや露出度の度合いなどはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/44", "thumbnail_src": "https://si.imgix.net/32c3fc2e/uploads/origins/945523d0-9dca-4d0e-9ef0-33d7936a9412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6523c6eac37f4e25ea1b86ea8f5228f0", "thumbnail_srcset": "https://si.imgix.net/32c3fc2e/uploads/origins/945523d0-9dca-4d0e-9ef0-33d7936a9412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6523c6eac37f4e25ea1b86ea8f5228f0, https://si.imgix.net/32c3fc2e/uploads/origins/945523d0-9dca-4d0e-9ef0-33d7936a9412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00324e48c10e6e8381a11efd5261efbd 2x, https://si.imgix.net/32c3fc2e/uploads/origins/945523d0-9dca-4d0e-9ef0-33d7936a9412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e25cdd31dc9fd42af74d6dce4d522150 3x", "genre": "art", "nsfw": false, "body": "この前はバニー喜多ちゃん、ありがとうございました！性懲りもなく喜多ちゃんのイラストをお願いできればと思います。\n\n唐突ですけど『ぼっち・ざ・ろっく！』コラボイヤホンの喜多ちゃんの音声、メチャクチャ可愛いんですよね。特にタップ音の「ん〜」のくすぐったそうな感じと、「もうっ！」のハートマークがついてそうな甘い感じがたまらなくて…。以前コラボイヤホンは購入されたと呟いていらっしゃったので、まだ音声聴いていないようでしたら、是非聴いてみてください…。\n\nそんなわけで（？）、白ワンピース姿の喜多ちゃんに「もうっ！」って可愛く怒られる絵を描いてほしいです。可愛い喜多ちゃんに可愛く怒られたいんです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/43", "thumbnail_src": "https://si.imgix.net/8f74cbc1/uploads/origins/68b8832b-04cd-4024-a03d-9110d80c8b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48e737b91447979952d6e201a03391d5", "thumbnail_srcset": "https://si.imgix.net/8f74cbc1/uploads/origins/68b8832b-04cd-4024-a03d-9110d80c8b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48e737b91447979952d6e201a03391d5, https://si.imgix.net/8f74cbc1/uploads/origins/68b8832b-04cd-4024-a03d-9110d80c8b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8b6a655bcf019d64f8541f237312cb6 2x, https://si.imgix.net/8f74cbc1/uploads/origins/68b8832b-04cd-4024-a03d-9110d80c8b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89f7695ddde6a130d99c52a0d5680dca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/42", "thumbnail_src": "https://si.imgix.net/16921aa8/uploads/origins/c9fe1209-31f7-43aa-87ed-48738797921c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ab4bcf26387163fec881fc50237c1c0", "thumbnail_srcset": "https://si.imgix.net/16921aa8/uploads/origins/c9fe1209-31f7-43aa-87ed-48738797921c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ab4bcf26387163fec881fc50237c1c0, https://si.imgix.net/16921aa8/uploads/origins/c9fe1209-31f7-43aa-87ed-48738797921c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=312f30a961bca17307a96e7056c93e91 2x, https://si.imgix.net/16921aa8/uploads/origins/c9fe1209-31f7-43aa-87ed-48738797921c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d5aacdfd2df3fb875bf4b56b46e2206 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作風とイラストがとても好きです、\n私のOCである葵（白髪、青い目、穏やかで優しい、かなり大きな胸）のイラストをお願いしたいです。\n表情は穏やかな微笑みを浮かべているような、幸せそうで可愛らしいものを希望します。\nキャラクターの参考のために他のイラストも提供します。\nhttps://drive.google.com/drive/folders/16j9lPsRRWVzBxA9KKUstPzHmCo0YSu-d?usp=drive_link\nご回答よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/41", "thumbnail_src": "https://si.imgix.net/fec4155e/uploads/origins/ed79ed60-819b-4e73-9804-630b2b555d27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aab3494fa728d3a24263db7bfbe71f1", "thumbnail_srcset": "https://si.imgix.net/fec4155e/uploads/origins/ed79ed60-819b-4e73-9804-630b2b555d27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aab3494fa728d3a24263db7bfbe71f1, https://si.imgix.net/fec4155e/uploads/origins/ed79ed60-819b-4e73-9804-630b2b555d27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9705de40d4acefecb9bcda9dba1afbad 2x, https://si.imgix.net/fec4155e/uploads/origins/ed79ed60-819b-4e73-9804-630b2b555d27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8295426408849cbc4a07c5a9b5cde24 3x", "genre": "art", "nsfw": false, "body": "イラストの美しさと可愛さのバランスが絶妙でとても好きです。\n『ぼっち・ざ・ろっく！』の喜多ちゃんのイラストを依頼できればと思います。\n\n原作6巻の特典のバニー衣裳を着た喜多ちゃんが、「似合ってる？」と笑顔で見せてくるようなイメージでお願いします。\n\n何卒……。\n\nhttps://img.amiami.jp/images/product/bonus/233/MED-BOOK-034986_01.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/40", "thumbnail_src": "https://si.imgix.net/4dd64a77/uploads/origins/36c33ee5-40ad-4401-a2b8-2c17c8e863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3378e3a290a365e28d644f40cb66fec", "thumbnail_srcset": "https://si.imgix.net/4dd64a77/uploads/origins/36c33ee5-40ad-4401-a2b8-2c17c8e863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3378e3a290a365e28d644f40cb66fec, https://si.imgix.net/4dd64a77/uploads/origins/36c33ee5-40ad-4401-a2b8-2c17c8e863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad16382d2ce22aa248e945fff3c5dd2a 2x, https://si.imgix.net/4dd64a77/uploads/origins/36c33ee5-40ad-4401-a2b8-2c17c8e863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5d941ea99828b7a670afed3185819f5 3x", "genre": "art", "nsfw": false, "body": "初めまして。 よろしければ参考URLのアニメキャラのイラストを依頼してもいいでしょうか？ \n\n【構図・ポーズ】全身が見えて、振り向いているポーズ。\n【服装】浴衣姿、シンプルなデザインでお任せします。体のラインが見えたら嬉しい。\n【体型】身長140㎝、スレンダー体型\n【髪型】原作のままか髪飾りなどついている\n【背景】できれば夏祭りみたいな感じ。\n【表情】カメラ目線で微笑む \n\n難しいなら気軽にキャンセルしてください。  ご検討宜しくお願い致します。\n\nhttps://imgur.com/a/dHsdNqA", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/39", "thumbnail_src": "https://si.imgix.net/97882672/uploads/origins/7481083a-4311-495c-8870-f22e88dcebf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd182003723485234d29ea86dea1cdb", "thumbnail_srcset": "https://si.imgix.net/97882672/uploads/origins/7481083a-4311-495c-8870-f22e88dcebf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd182003723485234d29ea86dea1cdb, https://si.imgix.net/97882672/uploads/origins/7481083a-4311-495c-8870-f22e88dcebf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80f26f9fe6cf2a6ffecd5984c1cd2d48 2x, https://si.imgix.net/97882672/uploads/origins/7481083a-4311-495c-8870-f22e88dcebf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=448f382d4f34e20d8931aac954bfc82b 3x", "genre": "art", "nsfw": false, "body": "先日は、https://skeb.jp/@Kana_Taka11/works/38 のイラストを納品頂き、ありがとうございました。\n\n早速なのですが、イラストの差分の追加をお願いいたします。お願いしたい内容を以下に記載します。\n\n本キャラクターが両足に履いている黒い靴下を脱がし、靴はそのまま履いている差分の納品をお願いいたします。例えば、https://skeb.jp/@ichiyo127/works/3 の上から二枚目のように、両脚に素足のまま靴を直に履かせてください。\n\n納品時のデータ形式は、レイヤーのON/OFF操作で靴下の有無を切り替えられるのが望ましいですが、不可な場合は靴下を履いてないバージョンのイラストのみの納品でも構いません。\n\nまた、納品時はhttps://skeb.jp/@Kana_Taka11/works/38 で納品頂いたときのファイル形式、解像度、アスペクト比等をそのまま引き継ぐようお願いいたします。\n\nお忙しいところ恐縮ですが、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/38", "thumbnail_src": "https://si.imgix.net/276c1bb0/uploads/origins/31f405a8-02ff-477f-8ff2-4624d8eabf37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ca403f2a63667def281355e4b2dafd", "thumbnail_srcset": "https://si.imgix.net/276c1bb0/uploads/origins/31f405a8-02ff-477f-8ff2-4624d8eabf37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ca403f2a63667def281355e4b2dafd, https://si.imgix.net/276c1bb0/uploads/origins/31f405a8-02ff-477f-8ff2-4624d8eabf37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=087ddcfb0f73879b9ac8f6213af485aa 2x, https://si.imgix.net/276c1bb0/uploads/origins/31f405a8-02ff-477f-8ff2-4624d8eabf37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb7bffb9901dc18a281a1000b2411802 3x", "genre": "art", "nsfw": false, "body": "平素はお世話になっております。\n早速ですが、リクエストを送ります。\n\n・キャラクター\n\n響音小夜（https://is.gd/G6ebgk ）。すろさん（https://is.gd/FjBpHu ）のうちの子。使用許可は事前に得ています。\n\n・衣装\n\nhttps://is.gd/1UU3bj と同じ制服。https://is.gd/1UU3bj と同じく、ニーソの代わりに黒い靴下を履かせ、同じデザインの靴を履かせてください。チューバで見えない部分は、https://is.gd/G6ebgk の方を参考にしてください。\n\n・ポーズと着こなし。\n\nhttps://is.gd/EZTE7O の一枚目と同じ、両脚の位置をずらしつつ、上半身をこちらの方に向けている座り。ここで、両脚の太腿の下半分辺りまでは見えつつ、太腿の付け根付近を含む、太腿の上半分はスカートで隠れて見えないよう、スカートの形状や丈の長さ等を調節してください。\n\nまた、靴下は\n\n１．靴下を履いている\n\n２．靴下を履いていない\n\nの二種類の差分を収録してください。また、どちらの差分であっても、靴は必ず履かせてください。\n\n・カメラ位置、角度、画角\n\nhttps://is.gd/EZTE7O の一枚目と同じ、横から見た位置と角度。このとき、キャラクターの全身がキャンバスから見切れないようにしてください。\n\n・表情\n\n両目を開けた笑顔。ここで、口については、\n\n１．口を開けている\n\n２．口を閉じている\n\nの二種類の差分を収録してください。\n\n・背景\n\n学校の体育館の中。体育館の、木の床の上に座っているイメージでお願いします。\n\n・納品時のデータ形式\n\n短辺2160px、長辺3840px以上の、レイヤーのON/OFFで差分が切り替えられる原寸サイズのPSDファイル。金額の範囲内で、解像度をなるべく高く描いてください。アスペクト比は、上記の指定を満たしつつ、キャラクターがキャンバスをなるべく多く占めるように決めてください。本指定が不可の場合は、すみませんがキャンセルをお願いします。\n\n\nお忙しいところ恐れ入りますが、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/37", "thumbnail_src": "https://si.imgix.net/9038b764/uploads/origins/d0374eef-ad79-4ecd-af37-b05b94c40a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82b70f0eaff5eb2d5b3cfcb67b3e8ee3", "thumbnail_srcset": "https://si.imgix.net/9038b764/uploads/origins/d0374eef-ad79-4ecd-af37-b05b94c40a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82b70f0eaff5eb2d5b3cfcb67b3e8ee3, https://si.imgix.net/9038b764/uploads/origins/d0374eef-ad79-4ecd-af37-b05b94c40a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd6a2720881c1c718921797e962eca09 2x, https://si.imgix.net/9038b764/uploads/origins/d0374eef-ad79-4ecd-af37-b05b94c40a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0825fec939d4c0745bf83fe51db28d3 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！ビキニ姿のアバターをお願いしたいのですが https://drive.google.com/file/d/1Tz4lTYl_qhWHdH9W1WnFOGhYUeRURSFr/view?usp=sharing ポーズについては、例の https://danbooru.donmai.us/posts/5423610 のような感じで、背景も同じような感じでお願いします。胸はそんなに大きくないほうがいいです。写真はポストカード形式にしてください。本当にありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/36", "thumbnail_src": "https://si.imgix.net/a834ca03/uploads/origins/22ecbf26-7460-4120-bef6-9a82e0892bb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94e9cfa588fbcfb4da70d1d9362530b4", "thumbnail_srcset": "https://si.imgix.net/a834ca03/uploads/origins/22ecbf26-7460-4120-bef6-9a82e0892bb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94e9cfa588fbcfb4da70d1d9362530b4, https://si.imgix.net/a834ca03/uploads/origins/22ecbf26-7460-4120-bef6-9a82e0892bb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b6cb84d7df7e54c228d37a387e1dcc3 2x, https://si.imgix.net/a834ca03/uploads/origins/22ecbf26-7460-4120-bef6-9a82e0892bb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=929a8cf71030f00230e4541faa7f6cda 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/35", "thumbnail_src": "https://si.imgix.net/315ac3fe/uploads/origins/cdc1be28-906e-4eee-81b5-1cff42beddb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=626e9648f8c9a4d24af9beea60b18197", "thumbnail_srcset": "https://si.imgix.net/315ac3fe/uploads/origins/cdc1be28-906e-4eee-81b5-1cff42beddb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=626e9648f8c9a4d24af9beea60b18197, https://si.imgix.net/315ac3fe/uploads/origins/cdc1be28-906e-4eee-81b5-1cff42beddb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=319dc1279098f4ddd8a66a2a16c00ecb 2x, https://si.imgix.net/315ac3fe/uploads/origins/cdc1be28-906e-4eee-81b5-1cff42beddb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f95e47db32bc7b6b9172fd1aa7ac55d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/34", "thumbnail_src": "https://si.imgix.net/85ca539d/uploads/origins/34b02104-9c4e-4fd6-8441-f571ef195947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3284a597aaadc726ae5b8b6150a80850", "thumbnail_srcset": "https://si.imgix.net/85ca539d/uploads/origins/34b02104-9c4e-4fd6-8441-f571ef195947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3284a597aaadc726ae5b8b6150a80850, https://si.imgix.net/85ca539d/uploads/origins/34b02104-9c4e-4fd6-8441-f571ef195947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11f172e83d5330fd8fb57f1f4975c0ac 2x, https://si.imgix.net/85ca539d/uploads/origins/34b02104-9c4e-4fd6-8441-f571ef195947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92566bfffe83f69be2fd325985c5931a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私はあなたの絵がとても好きで、ぜひリクエストを送りたいのです。\n\n今年のハロウィンで、私のキャラクターに魔女のコスチュームを着せようと思っています。\n具体的なデザインは考えていないので、ぜひリクエストさせてください。\n\n私は「さまよえる魔女」の大ファンなので、キャラクターの衣装もそれをイメージしたものにしたいと思っています。\n彼女は20代後半くらいとやや年齢が高めなので、それを反映した服装にしたいです。\nヴィクトリカやフラン先生が着ているような服装が似合うと思います。エレーナが20代半ばの時に着ていた服とか。\n\nその他にも、私が好きな服装がいくつかあるので、参考にしてみてください。\n\nキャラクターの参考：https://imgur.com/a/LabTYgK\n\n衣装の参考：https://imgur.com/a/arbdCKu\n\n構図や背景はおまかせしますが、表情は明るくしてほしいです。\n眼鏡はそのままで、大きな帽子をかぶせてください。帽子が大きければ大きいほど、かわいい魔女になると思います。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/33", "thumbnail_src": "https://si.imgix.net/e63ca873/uploads/origins/a1cfccbb-0f63-4d7a-8ad8-68c257a81bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97288d5a7a63f073b9343a8a8532af60", "thumbnail_srcset": "https://si.imgix.net/e63ca873/uploads/origins/a1cfccbb-0f63-4d7a-8ad8-68c257a81bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97288d5a7a63f073b9343a8a8532af60, https://si.imgix.net/e63ca873/uploads/origins/a1cfccbb-0f63-4d7a-8ad8-68c257a81bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11049ac4b46f1bf0a40c8514eac30b99 2x, https://si.imgix.net/e63ca873/uploads/origins/a1cfccbb-0f63-4d7a-8ad8-68c257a81bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6216ed7d0e679ab9c652d5fa4f2d2a6 3x", "genre": "art", "nsfw": false, "body": "こんにちわ。\n先日は素敵なイラスト納品いただき、ありがとうございました。\n\n今回、鷹なゆさんのオリジナリキャラクターの子を久しぶりに見たいなと思いリクエストさせていただきました。\n\n【キャラ】\n名前が分からなかったのでリンクで失礼します。\nhttps://www.pixiv.net/artworks/86897606\n\n【構図】\n簡単で構いませんので背景有り、16:9でお願いしたいです。\nその他構図ですが、この子の魅せ方は鷹なゆさんが１番分かっているかと思いますのでお任せします！\n\n【その他】\n可能であれば線画のみのイラストもいただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/32", "thumbnail_src": "https://si.imgix.net/ce21f6b6/uploads/origins/0ace7176-6405-46d9-b880-ffb4e3dcd0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095e5961dfc1eeaf5e99364138e3dad6", "thumbnail_srcset": "https://si.imgix.net/ce21f6b6/uploads/origins/0ace7176-6405-46d9-b880-ffb4e3dcd0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095e5961dfc1eeaf5e99364138e3dad6, https://si.imgix.net/ce21f6b6/uploads/origins/0ace7176-6405-46d9-b880-ffb4e3dcd0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8b061b4aba0b6d765f43851f20e11c3 2x, https://si.imgix.net/ce21f6b6/uploads/origins/0ace7176-6405-46d9-b880-ffb4e3dcd0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2615297a37dce715375da776d12e524c 3x", "genre": "art", "nsfw": false, "body": "こんにちははじめまして。オーバーロードのシャルティアブラッドフォールンの水着姿をお願いしたいのですが https://imgur.com/a/wRLSaUm .水着をビキニにして、お腹を露出させた状態にしていただけたらと思います。ってな感じです。\n肌は、夏の暑さで汗をかいて、少し光っているくらいがいい。足の爪は、黒かピンクに塗ってください。片方の腕は頭の後ろに回して、脇の下を露出させる。表情は、遊び心のある笑顔か、にっこり笑っているような感じ。\n\n風景や背景が必要であれば、このようなものを希望します。Https://imgur.com/a/vwgf4C0\n\nその他はお任せします。ありがとうございました。Shalltear-https://imgur.com/a/gi80lxx", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/31", "thumbnail_src": "https://si.imgix.net/d0a01288/uploads/origins/d5c937be-8639-417c-8160-7fcdd3f0151b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a756daa4ee3f4213846f8380eaa99b9", "thumbnail_srcset": "https://si.imgix.net/d0a01288/uploads/origins/d5c937be-8639-417c-8160-7fcdd3f0151b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a756daa4ee3f4213846f8380eaa99b9, https://si.imgix.net/d0a01288/uploads/origins/d5c937be-8639-417c-8160-7fcdd3f0151b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e4980be19bba4da9de7c6658608cb85 2x, https://si.imgix.net/d0a01288/uploads/origins/d5c937be-8639-417c-8160-7fcdd3f0151b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1de806f49459fd80220997e6fbf836a 3x", "genre": "art", "nsfw": false, "body": "こんにちわ。\n手数料無料期間ということなのでリクエストさせていただきます！\n\n【キャラ】\n風間チエル（現実ver）（プリコネ）　※金髪の子です。\n\n【衣装】\nダメージジーンズ（半ズボン）とパーカーを着ている姿でお願いします。\n\n【構図】\nフカン以外の構図であれば後はお任せします。\nただ、太ももは入るようにしてもらえればと思います。\n\n【その他】\n可能であれば納品の際に線画のみのイラストもいただけると幸いです。\n\n資料少ないかと思いますが、ご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/30", "thumbnail_src": "https://si.imgix.net/4947fede/uploads/origins/954a8fa7-14f6-4e3a-9b70-6c46bcb11822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97cdb501a90b98d15e35223eec4a9c28", "thumbnail_srcset": "https://si.imgix.net/4947fede/uploads/origins/954a8fa7-14f6-4e3a-9b70-6c46bcb11822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97cdb501a90b98d15e35223eec4a9c28, https://si.imgix.net/4947fede/uploads/origins/954a8fa7-14f6-4e3a-9b70-6c46bcb11822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad8dfa27c4a1c02b07025b25add96ef6 2x, https://si.imgix.net/4947fede/uploads/origins/954a8fa7-14f6-4e3a-9b70-6c46bcb11822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3594fbfe51b8a784d4fa9a83820b83d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。鷹なゆさんのイラストから興味を持ち最近になって魔女の旅々にどハマりしてしまい、今回、思い切ってリクエストさせていただきました。\n\n魔女の旅々よりイレイナとアヴィリアをお願いします。\n\nアムネシアからの目線で、2人の水着姿を褒めたら、ちょっと恥ずかしがっているイレイナとアヴィリア。といった感じでお願いします。水着のデザインは私が疎いもので鷹なゆさんにお任せしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/29", "thumbnail_src": "https://si.imgix.net/b90f2de1/uploads/origins/1d59fab4-8b9a-4f1a-86ec-05f494f11725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ea431de059955f2c6c99d4ddc77af5f", "thumbnail_srcset": "https://si.imgix.net/b90f2de1/uploads/origins/1d59fab4-8b9a-4f1a-86ec-05f494f11725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ea431de059955f2c6c99d4ddc77af5f, https://si.imgix.net/b90f2de1/uploads/origins/1d59fab4-8b9a-4f1a-86ec-05f494f11725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b37dcf875bb994d791e2617d863c81aa 2x, https://si.imgix.net/b90f2de1/uploads/origins/1d59fab4-8b9a-4f1a-86ec-05f494f11725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a8245e0b337fff023d9ea5849e04eea 3x", "genre": "art", "nsfw": false, "body": "こんにちわ。\nもしよろしければご検討の程よろしくお願いします。\n\n【作品名】\n天才王子の赤字国家再生術\n\n【キャラ】\nニニム\n\n【構図】\nニーソを履こうとしている姿を描いていただければと思います。\nその他はお任せします。\n\n【備考】\n可能であればレイヤー未統合のファイルもいただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/28", "thumbnail_src": "https://si.imgix.net/ee10a4d5/uploads/origins/a10b388e-e13f-46f1-9801-7f34dc78c103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24173b98e95a4aacafd04aec3009775d", "thumbnail_srcset": "https://si.imgix.net/ee10a4d5/uploads/origins/a10b388e-e13f-46f1-9801-7f34dc78c103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24173b98e95a4aacafd04aec3009775d, https://si.imgix.net/ee10a4d5/uploads/origins/a10b388e-e13f-46f1-9801-7f34dc78c103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25a6de38bb6015432d06fd01dcb2775b 2x, https://si.imgix.net/ee10a4d5/uploads/origins/a10b388e-e13f-46f1-9801-7f34dc78c103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82539e94ab786a75c330f612064614d5 3x", "genre": "art", "nsfw": false, "body": "鷹なゆさん、\nあけましておめでとうございます。\nプリンセスプリンシパルのアンジュとプリンセスが広いベッドの上で、\n二人で一枚の薄いシーツを素肌にかぶって仰向けの姿勢で、\nシーツの下でお互いに指を絡めて手をつないで、\nお互いに微笑んでいるイラストをリクエストします。\n参考になりそうな公式イラスト\nhttps://medicos-e-shop.net/products/detail/564", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/27", "thumbnail_src": "https://si.imgix.net/43d504e2/uploads/origins/2841e14f-0890-42db-be69-807e1e008649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9d9fbade0ae9ef7edeeee82ff38a5d1", "thumbnail_srcset": "https://si.imgix.net/43d504e2/uploads/origins/2841e14f-0890-42db-be69-807e1e008649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9d9fbade0ae9ef7edeeee82ff38a5d1, https://si.imgix.net/43d504e2/uploads/origins/2841e14f-0890-42db-be69-807e1e008649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3c3282feaa75e43efcbdd6fe364bb40 2x, https://si.imgix.net/43d504e2/uploads/origins/2841e14f-0890-42db-be69-807e1e008649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5bdfb0c3cba6246ada736bbb7ae0c14 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nVTuberとしての活動をしております、白凰リリアと申します。\n\nTwitterで先生の描くイラストを見かけましてとても惹かれました！\nこの度は私自身のイラストを描いていただきたくリクエストいたしました。\n\n以下詳細となります。\n\n【使用目的】\nPokémon LEGENDS アルセウスを配信する際に使用するサムネイル及び\nTwitterのアイコン等に使用\n\n【キャラクター参考画像】\nhttps://twitter.com/hakuou_lilia/status/1406502850650202116\nhttps://twitter.com/hakuou_lilia/status/1460166183290769409\n\n【服装】\nPokémon LEGENDS アルセウスの女の子の主人公のような服装\n和装だけど忍者っぽくマフラーとかひらひらしている感じ\nhttps://www.pokemon.co.jp/ex/legends_arceus/ja/character/210818_01/\n\n【ポーズ】\nルリナのようなボールを片手に持って、もう片方の手を腰にやっているポーズ\nhttps://www.4gamer.net/games/451/G045125/20190612029/\n\n【表情】\n少し微笑んでるぐらいでちょっとカッコつけてるような\n\n【背景】\nなしでも構いません。\n\n【希望】\n背景やサイン等レイヤー分けていただけると嬉しいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/26", "thumbnail_src": "https://si.imgix.net/35c28fd1/uploads/origins/bb0a39ab-c180-4400-9b55-e5266b549791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0b57fe8b3ddd4c49914cdb4d0aa13f1", "thumbnail_srcset": "https://si.imgix.net/35c28fd1/uploads/origins/bb0a39ab-c180-4400-9b55-e5266b549791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0b57fe8b3ddd4c49914cdb4d0aa13f1, https://si.imgix.net/35c28fd1/uploads/origins/bb0a39ab-c180-4400-9b55-e5266b549791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8814ccdcef0bddb479f00115b710f8ec 2x, https://si.imgix.net/35c28fd1/uploads/origins/bb0a39ab-c180-4400-9b55-e5266b549791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=591c7e932eba2d6a13db83405675aa6c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。このキャラクターでアート作品を作っていただけないでしょうか？誰かに「かわいい」と言われたような、とても恥ずかしそうな表情をしてほしいです。宜しくお願いします。\n\nChara reference: https://drive.google.com/drive/folders/1DgY3iPxAMHkhtzTbzBp3xk16lstECGaB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kana_Taka11/works/25", "thumbnail_src": "https://si.im