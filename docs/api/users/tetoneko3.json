3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fec8b582305f0d354a973a04115bd7b, https://si.imgix.net/b3bbe601/uploads/origins/d17a246e-0e47-4f87-b3db-d377d5620c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cfa799461af5b1d519c76b4e6c6668d 2x, https://si.imgix.net/b3bbe601/uploads/origins/d17a246e-0e47-4f87-b3db-d377d5620c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcd57f3c9d7719a7f459d76477e1b037 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターを描いていただけないでしょうか！ポーズや表情は自由に選んでください！\n\nhttps://drive.google.com/drive/folders/1uMdtjaOB7p_rGZYU3B5jjvcdqp2g-oi6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/29", "thumbnail_src": "https://si.imgix.net/2b7fd04c/uploads/origins/b90ca8a2-3a69-4d83-9be2-6f707f0839c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dc8b66030485f226f84f21bff0436e2", "thumbnail_srcset": "https://si.imgix.net/2b7fd04c/uploads/origins/b90ca8a2-3a69-4d83-9be2-6f707f0839c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dc8b66030485f226f84f21bff0436e2, https://si.imgix.net/2b7fd04c/uploads/origins/b90ca8a2-3a69-4d83-9be2-6f707f0839c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa882ce1f5a51fc39e797ea927872625 2x, https://si.imgix.net/2b7fd04c/uploads/origins/b90ca8a2-3a69-4d83-9be2-6f707f0839c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b43877d8fbc0ac931fa6d974364357ca 3x", "genre": "art", "nsfw": false, "body": "私のffxivキャラクターの絵をお願いしたいです。\n彼女はMiqo'te（ミコテ）、別名猫の女の子です。ポージングはお任せします！\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1xh5Y61eVgxTB34_4ABYq4MfwU0GnHfwk", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/28", "thumbnail_src": "https://si.imgix.net/a98cb15a/uploads/origins/8691ef2f-8b88-4024-b428-aca76b74e8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=479f82ba1f99cb8bac8c5eb176b52015", "thumbnail_srcset": "https://si.imgix.net/a98cb15a/uploads/origins/8691ef2f-8b88-4024-b428-aca76b74e8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=479f82ba1f99cb8bac8c5eb176b52015, https://si.imgix.net/a98cb15a/uploads/origins/8691ef2f-8b88-4024-b428-aca76b74e8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30322de4cc0ed6f50460cf9a0e1f4e56 2x, https://si.imgix.net/a98cb15a/uploads/origins/8691ef2f-8b88-4024-b428-aca76b74e8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4527170c19c1df0f20776898febaa8af 3x", "genre": "art", "nsfw": false, "body": "こんばんは。今回も当方のオリキャラ黄色アイドル（あんな）を描いていただきたいです。\nご都合よろしければお願いいたします。\n\n料金とスケジュールの許容範囲内で以下の候補のうちいくつかをお願いします。\nとくに優先順位はないのでお好みでご自由にお選びいただければと思います。\n\n・かわいいフリル系統のビキニ水着姿。髪型はポニテにする\n・アイドル衣装できららジャンプしているシーン（アイドル風は既存のものでも改変でも新規でもいずれもok）\n・ゴシックパン風の服装でクールな決めポーズ\n・https://skeb.jp/@tetoneko3/works/2のような感じの明るいえちえちチアガール姿（パンチラOUTならアンスコかショートスパッツでもok）\n・ブレザー系のJK風制服姿（髪型は前回のイラストの中にあったのと同じようなツインテールに希望）\n・髪を結わずに梳いた形のプライベートのパジャマ姿。少し寝ぼけている感じに\n\nhttps://drive.google.com/drive/folders/1d0NHpKD3Xj7kC-kLvPbjR6ZasfoUcPdS", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/27", "thumbnail_src": "https://si.imgix.net/e5976413/uploads/origins/9c961896-3b53-447a-af71-64621f07729d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549c29377db1c665493685f5c520caf2", "thumbnail_srcset": "https://si.imgix.net/e5976413/uploads/origins/9c961896-3b53-447a-af71-64621f07729d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549c29377db1c665493685f5c520caf2, https://si.imgix.net/e5976413/uploads/origins/9c961896-3b53-447a-af71-64621f07729d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7c2ea59503bbee1800dae7b1abd4582 2x, https://si.imgix.net/e5976413/uploads/origins/9c961896-3b53-447a-af71-64621f07729d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bc91fc0a3e6c2148fd90de39f31b06d 3x", "genre": "art", "nsfw": false, "body": "たぬこさんー！！！\nこの間はskebありがとうございました！！！\n和服も勿論大好きなのですが洋装の少し照れた感じが最高イラストすぎてずっと眺めています😭😭今回も同じキャラクター又は長男のお好きな方でご縁があればお願いしたいです。全ておまかせいたします…！https://drive.google.com/drive/folders/11LMdLz2mxVqWS-UiRwV2bkuFooRgl-Bd", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/26", "thumbnail_src": "https://si.imgix.net/e9d6243e/uploads/origins/ef502afe-418e-48f6-b009-0ba2b41f9bca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0079d4e24ffd8b0495166cedd520904c", "thumbnail_srcset": "https://si.imgix.net/e9d6243e/uploads/origins/ef502afe-418e-48f6-b009-0ba2b41f9bca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0079d4e24ffd8b0495166cedd520904c, https://si.imgix.net/e9d6243e/uploads/origins/ef502afe-418e-48f6-b009-0ba2b41f9bca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1ab98900fd6674a03096d71279f2a1a 2x, https://si.imgix.net/e9d6243e/uploads/origins/ef502afe-418e-48f6-b009-0ba2b41f9bca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c90e7b7744cfe4509bc69d0f9dfe86b2 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nskebの新着作品を見ていた時に目に留まり、すごく自分好みだったのでリクエストを送らせて頂きました。\n\n・参考資料のオリジナルキャラをお願いします\n・前髪ぱっつん、ツーサイドアップ（黒いリボンで結んでいる）、後ろ髪は腰まで伸びているロング\n・服の色は黒色をメインカラーにサブカラーを赤色（リボンなど）\n・服装の指定は上記の色のみで、デザインに指定はありません、書き易いように変更してもらって構いません\n・構図やポーズも全てお任せいたします\n\n以上になります。\nお手数おかげしますが、検討いただけますと幸いです。\n\n参考資料\n・キャラクター\nhttps://imepic.jp/20240623/387280", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/25", "thumbnail_src": "https://si.imgix.net/12c1de1d/uploads/origins/5945f59b-1a9a-41d7-bdb0-5493bb8c94c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13eaeaa6671ab31e1c56df8f68b892fa", "thumbnail_srcset": "https://si.imgix.net/12c1de1d/uploads/origins/5945f59b-1a9a-41d7-bdb0-5493bb8c94c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13eaeaa6671ab31e1c56df8f68b892fa, https://si.imgix.net/12c1de1d/uploads/origins/5945f59b-1a9a-41d7-bdb0-5493bb8c94c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f6e11fac028201f85d3b575a40eb03e 2x, https://si.imgix.net/12c1de1d/uploads/origins/5945f59b-1a9a-41d7-bdb0-5493bb8c94c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fec5c2732a7f752e7a13b54b909bb79a 3x", "genre": "art", "nsfw": false, "body": "才気煥発、と言ったところでしょうか\nそんな貴方に次なるリクエストをば\n今回は「”仕事着”で、画面側の存在に向けて手を差し伸べる」というシチュエーションです\n構図素材を探してみました\nhttps://graphon.jp/main/photo/16411\nhttps://www.otomate.jp/smp/librarycross/content/?page=3\nただしイメージは屋外、それも荒野や原野のたぐいになります\n画面側の方は手首までで充分でしょう、赤いネイルの繊手です\nhttps://img.shop-pro.jp/PA01303/551/etc_base64/cGl4dGFfNjgxOTQ4NzhfTQ.jpg\nああそうそう、蛇の目は今回映らないことが重要ですね\n赤面もありません", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/24", "thumbnail_src": "https://si.imgix.net/1270ad2f/uploads/origins/e483a945-3df7-4ee9-97af-9f2bc2318b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5668491395cf6c2d7e895c37238b081", "thumbnail_srcset": "https://si.imgix.net/1270ad2f/uploads/origins/e483a945-3df7-4ee9-97af-9f2bc2318b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5668491395cf6c2d7e895c37238b081, https://si.imgix.net/1270ad2f/uploads/origins/e483a945-3df7-4ee9-97af-9f2bc2318b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62f0f55e66fd1dbbf15029bbdf847b14 2x, https://si.imgix.net/1270ad2f/uploads/origins/e483a945-3df7-4ee9-97af-9f2bc2318b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbe565511998093355cb47d3cfc494ab 3x", "genre": "art", "nsfw": false, "body": "初めまして！ユイリスと申します。以前skebでイラストを見かけ、絵柄が好みでぜひ書いていただきたいと思い依頼しました。\nたぬこ様には私の新しいOCを書いていただきたいです。Xのアイコンに使用します。\n\n新OC資料\n・女の子\n・青目\n・白髪ボブ\n\n服装↓\nhttps://x.com/jirai_flamingo/status/1805918759884116268?s=46\n肩出し＆肩落としでお願いします。服はこちらに載せているパーカーで、インナーは1枚目の方でお願いします。\n\nご検討の程宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/23", "thumbnail_src": "https://si.imgix.net/e9640096/uploads/origins/a4abec0b-ce2d-44af-a27c-2d45ffaf61a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d18cf62535549c54ac150189732d028", "thumbnail_srcset": "https://si.imgix.net/e9640096/uploads/origins/a4abec0b-ce2d-44af-a27c-2d45ffaf61a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d18cf62535549c54ac150189732d028, https://si.imgix.net/e9640096/uploads/origins/a4abec0b-ce2d-44af-a27c-2d45ffaf61a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b021c9853342310005e20edfa132f0c2 2x, https://si.imgix.net/e9640096/uploads/origins/a4abec0b-ce2d-44af-a27c-2d45ffaf61a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5780915432cdf1c33a09ed9ee20e6548 3x", "genre": "art", "nsfw": false, "body": "たぬこさんの可愛いイラストを拝見して、ぜひSNS用のアバターを描いていただきたいと思いリクエストしました。\nナース服の女の子のイラストを書いていただきたいです。\n髪型は三つ編み、目はほんの少し吊り目気味で、何かしら医療っぽいアイテムを持っているor身につけていると嬉しいです。\nそれ以外は容姿の雰囲気やポーズなどはすべてお任せでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@tetoneko3/works/22", "thumbnail_src": "https://si.imgix.net/f059603c/uploads/origins/2b8fe73c-29a5-4658-9ce9-c5f4ed51df4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02de8b3012bb08915cabfa1b431bc190", "thumbnail_srcset": "https://si.imgix.net/f059603c/uploads/origins/2b8fe73c-29a5-4658-9ce9-c5f4ed51df4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02de8b3012bb08915cabfa1b431bc190, https://si.imgix.net/f059603c/uploads/origins/2b8fe73c-29a5-4658-9ce9-c5f4ed51df4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e210f2b2d6df5aaa807fbc63c4d8e34d 2x, https://si.imgix.net/f059603c/uploads/origins/2b8fe73c-29a5-4658-9ce9-c5f4ed51df4b?bg=%23fff&auto=format%2Ccompress&fm=w