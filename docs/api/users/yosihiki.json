た。やがて外の世界に戻ることができたが、パラノイアと不安に悩まされるようになった。以前の温厚な性格を保とうとはしているが、新しい友人や仲間と本当に深い絆を築くには、癒しの旅が必要だ。\n\nアリシアをかっこよく、あるいはかわいく描いてください。背景や文脈は先生にお任せします。アリシアに似合いそうな、楽しそうなシーンを描いてください。\n\nよろしくお願いします。\n\nhttps://www.deviantart.com/stash/219zt9qwlosq", "created_at": "", "completed_at": ""}, {"path": "/@yosihiki/works/119", "thumbnail_src": "https://si.imgix.net/86cf39f8/uploads/origins/e5a7db6e-ce7c-4b7c-bb99-33fe41c3b43e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ff843e37b2631b6f65bf0ff4beac9d0", "thumbnail_srcset": "https://si.imgix.net/86cf39f8/uploads/origins/e5a7db6e-ce7c-4b7c-bb99-33fe41c3b43e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ff843e37b2631b6f65bf0ff4beac9d0, https://si.imgix.net/86cf39f8/uploads/origins/e5a7db6e-ce7c-4b7c-bb99-33fe41c3b43e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=deb5ed330f0ade95c6be38f6d733a9c0 2x, https://si.imgix.net/86cf39f8/uploads/origins/e5a7db6e-ce7c-4b7c-bb99-33fe41c3b43e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ebb0a4871c7dcb4065939c5e453204a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yosihiki/works/118", "thumbnail_src": "https://si.imgix.net/d162d2cd/uploads/origins/e000ef7f-a2de-4e21-a79d-ab6a46e1ace8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=441ba6ccb8986b66bb2f74e866d146a4", "thumbnail_srcset": "https://si.imgix.net/d162d2cd/uploads/origins/e000ef7f-a2de-4e21-a79d-ab6a46e1ace8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44