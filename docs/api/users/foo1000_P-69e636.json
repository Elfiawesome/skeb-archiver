c8/uploads/origins/3d4bac45-9917-4716-a233-4e0eb7c91b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8fa71c2a50b5af8f5155ec3b16aaff9", "thumbnail_srcset": "https://si.imgix.net/0f3d60c8/uploads/origins/3d4bac45-9917-4716-a233-4e0eb7c91b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8fa71c2a50b5af8f5155ec3b16aaff9, https://si.imgix.net/0f3d60c8/uploads/origins/3d4bac45-9917-4716-a233-4e0eb7c91b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9dd6ed27853f6bdd31c986448b9957c7 2x, https://si.imgix.net/0f3d60c8/uploads/origins/3d4bac45-9917-4716-a233-4e0eb7c91b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f33824b1b5e9378230822bcabee43b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/21", "thumbnail_src": "https://si.imgix.net/e4e1f956/uploads/origins/8a4a596e-57d0-4c17-b6f2-ee44beb04c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12f992e5ae714ff5df6a926119a75acf", "thumbnail_srcset": "https://si.imgix.net/e4e1f956/uploads/origins/8a4a596e-57d0-4c17-b6f2-ee44beb04c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12f992e5ae714ff5df6a926119a75acf, https://si.imgix.net/e4e1f956/uploads/origins/8a4a596e-57d0-4c17-b6f2-ee44beb04c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f27046997956762405cb05a1c245395 2x, https://si.imgix.net/e4e1f956/uploads/origins/8a4a596e-57d0-4c17-b6f2-ee44beb04c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8933026f7bca425841311bc88acba486 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/20", "thumbnail_src": "https://si.imgix.net/ec456bd6/uploads/origins/111ae4a2-dd5f-4a4f-bc35-90d9412168fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c52e29e082e24548de81c8ffe44cbc", "thumbnail_srcset": "https://si.imgix.net/ec456bd6/uploads/origins/111ae4a2-dd5f-4a4f-bc35-90d9412168fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c52e29e082e24548de81c8ffe44cbc, https://si.imgix.net/ec456bd6/uploads/origins/111ae4a2-dd5f-4a4f-bc35-90d9412168fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ec527b9df07dfa88b44b96633415934 2x, https://si.imgix.net/ec456bd6/uploads/origins/111ae4a2-dd5f-4a4f-bc35-90d9412168fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abc3316d44f3b9fa5814d68939dbb2aa 3x", "genre": "art", "nsfw": true, "body": "ラテボではなく風船に全身閉じ込められてる安部菜々をお願いします。\n1枚目（もしくは小さいコマでこうなった敬意を説明）　風船から顔だけ出して跳ね回って1日生活してもらうという番組企画を説明される菜々。楽しそうと興味津々な顔です。この時の菜々はスタッフに騙されている事に気づいてないです。\n2枚目（メイン）　風船は完全に閉じられてるので、顔なんか出せないし破けない。「ここから出して！誰か助けて！」と叫びながら中から風船を破こうともがいてます。不透明だから中身は見えません。可哀想なのでテロップに「1時間後に出してもらいました」と書いてください。\n3枚目（可能であれば）　2枚目の透明差分または、出してもらった菜々のちょっと楽しんでいた姿をお願いします。こちらと1枚目が難しい場合は、中にいる人が誰か分かるように横に小さい写真立てでも置いて下さい。\n\n風船閉じ込めはこちらをご参照下さい。\nhttps://youtu.be/FQOocXM0Jqg?si=7Jut-qpQz386jNiF\n・背景は菜々の家の中、もしくはおまかせ\n・不透明で全身閉じ込められてる構図は必ず優先して欲しいです\n・セリフは欲しいです\n・服装はおまかせします\n\nhttps://youtu.be/FQOocXM0Jqg?si=7Jut-qpQz386jNiF", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/19", "thumbnail_src": "https://si.imgix.net/148ed54b/uploads/origins/4dafccd1-cb4d-4747-9a82-57737353bd8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35d8b90a9fe4855173d5e58f1421f487", "thumbnail_srcset": "https://si.imgix.net/148ed54b/uploads/origins/4dafccd1-cb4d-4747-9a82-57737353bd8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35d8b90a9fe4855173d5e58f1421f487, https://si.imgix.net/148ed54b/uploads/origins/4dafccd1-cb4d-4747-9a82-57737353bd8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00a61706193e5f9e1cc5dff85d456b0f 2x, https://si.imgix.net/148ed54b/uploads/origins/4dafccd1-cb4d-4747-9a82-57737353bd8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6a5a8beb48365bff09da0fce3524c09 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/18", "thumbnail_src": "https://si.imgix.net/e6fdd00f/uploads/origins/44a29496-ff64-4e45-9d6e-83a9bac1e874?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=621f10b552e63f59f8c0cad3d15044d7", "thumbnail_srcset": "https://si.imgix.net/e6fdd00f/uploads/origins/44a29496-ff64-4e45-9d6e-83a9bac1e874?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=621f10b552e63f59f8c0cad3d15044d7, https://si.imgix.net/e6fdd00f/uploads/origins/44a29496-ff64-4e45-9d6e-83a9bac1e874?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a909ca53619b000a515b4bc477c0bfc 2x, https://si.imgix.net/e6fdd00f/uploads/origins/44a29496-ff64-4e45-9d6e-83a9bac1e874?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc02c566481335d95b834390783ef7f4 3x", "genre": "art", "nsfw": true, "body": "チョコ型ラテボに拘束されたアイマスの高垣楓が、液体状のチョコレートにコーティングされて拘束されるイラストを三枚に分けてお願いします。セリフ付き版とセリフ無し版をお願いします。今リクエストは、相葉ちゃんGOLDENのチョコレート版のイメージとなります。\n一枚目　いきなり拘束されたので、口を大きく開けて戸惑っている。\n二枚目　相葉ちゃんGOLDEN 二枚目のコーティング途中の様な感じで、チョコレートにコーティングされているイラストをお願いします。息苦しさから舌を出して苦しんでる表情でお願いします。\n三枚目　二枚目の表情のまま完全にチョコレートにコーティングされたイラストをお願いします。\n全イラストの擬音やオノマトペ、セリフはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/17", "thumbnail_src": "https://si.imgix.net/590a1190/uploads/origins/587548a7-ed0b-4cad-bb1e-0eb2ba24c5f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6105d90d120a00f2dbee62fef552065c", "thumbnail_srcset": "https://si.imgix.net/590a1190/uploads/origins/587548a7-ed0b-4cad-bb1e-0eb2ba24c5f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6105d90d120a00f2dbee62fef552065c, https://si.imgix.net/590a1190/uploads/origins/587548a7-ed0b-4cad-bb1e-0eb2ba24c5f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93aa3eb48096150783ddf3be61cb7ebd 2x, https://si.imgix.net/590a1190/uploads/origins/587548a7-ed0b-4cad-bb1e-0eb2ba24c5f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff9f3f55e18bd9c26601ad901dfa682c 3x", "genre": "art", "nsfw": true, "body": "以前書かれていた中野二乃のラバーだるま拘束を原神の宵宮で書いてもらえませんか？差分も中野二乃のラバーだるま拘束と同じでお願いします🙇‍♀️", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/16", "thumbnail_src": "https://si.imgix.net/2dfe0c60/uploads/origins/79e05b01-aa4a-49ba-9836-e79cc2ab0d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e972390426526df1a6cf08c54e59658c", "thumbnail_srcset": "https://si.imgix.net/2dfe0c60/uploads/origins/79e05b01-aa4a-49ba-9836-e79cc2ab0d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e972390426526df1a6cf08c54e59658c, https://si.imgix.net/2dfe0c60/uploads/origins/79e05b01-aa4a-49ba-9836-e79cc2ab0d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=458d516ce3a46c9d7bd0f02785eb739d 2x, https://si.imgix.net/2dfe0c60/uploads/origins/79e05b01-aa4a-49ba-9836-e79cc2ab0d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3326a1fad716966935545b47dcc4dab0 3x", "genre": "art", "nsfw": true, "body": "無理なお願いでなければ以下のリクエストをお願いします\n\n・キャラクター\n東方のわかさぎ姫と今泉影狼\n\nわかさぎ姫のイメージ画像\nhttps://i.imgur.com/CUBTxfY.png\nhttps://i.imgur.com/nPNrhQS.jpg\n今泉影狼のイメージ画像\nhttps://i.imgur.com/3xOHkhw.jpg\n\n・シチュエーション\n二人ががぴょんぴょんバルーン柄のラテックスボールに拘束され\n涙目で藻掻いてるイラストをお願いします\n\n・ラテックスボール\n柄はマリオパーティ4のミニゲームに登場するぴょんぴょんバルーンの柄\n上部の花のような模様は下記の画像のように花びら部分は長く描いてください\nhttps://i.imgur.com/6K1mhFH.png\n\n色はわかさぎ姫は青色、影狼は深紅色\n影狼の髪はラテボの回りに広がるようにだらんとかける\n柄はマリオパーティ4のミニゲームに登場するぴょんぴょんバルーンの柄\n首はボールの中に埋まりしわが出ている状態\n藻掻いているエフェクトや効果音あり\nラテックスボールはなるべく全体を映して下さい\n\nもし余力があれば猿轡系差分に穴ありボールギャグ、ラバーマスク、リブレスバッグ付きラバーマスク\nボールタイプのインフレータブルマスクもお願いしたいです\nレイヤーでキャラ単体・猿轡・効果音・背景なしに切り替えられるとありがたいです\nその他拘束を演出する台詞・構図・小物・エフェクト等はお任せいたします", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/15", "thumbnail_src": "https://si.imgix.net/8e89cc82/uploads/origins/59db371b-bf46-48a6-b213-3ee858c2cb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=324b381cea86b4fffca95dd9022b1cf5", "thumbnail_srcset": "https://si.imgix.net/8e89cc82/uploads/origins/59db371b-bf46-48a6-b213-3ee858c2cb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=324b381cea86b4fffca95dd9022b1cf5, https://si.imgix.net/8e89cc82/uploads/origins/59db371b-bf46-48a6-b213-3ee858c2cb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c2295e0612cbbf9aa0505f1ad41e661 2x, https://si.imgix.net/8e89cc82/uploads/origins/59db371b-bf46-48a6-b213-3ee858c2cb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81625c5ddfc736377e4d479d1a436e1b 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\n橘ありすちゃんのラテックスボール絵をお願いします。\n\n内部で体育座りする程度の小さめのボールに入れられ、ボールが歪むほどに透明なガラスに前後左右から圧迫されたシチュで、戸惑った表情でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/14", "thumbnail_src": "https://si.imgix.net/42568d96/uploads/origins/42634331-35d3-4652-9349-2ef43244e785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7504c2424dfb9bde386c5481ed275045", "thumbnail_srcset": "https://si.imgix.net/42568d96/uploads/origins/42634331-35d3-4652-9349-2ef43244e785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7504c2424dfb9bde386c5481ed275045, https://si.imgix.net/42568d96/uploads/origins/42634331-35d3-4652-9349-2ef43244e785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=884598a0808fdd3649b991995569e826 2x, https://si.imgix.net/42568d96/uploads/origins/42634331-35d3-4652-9349-2ef43244e785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f68aa260d3b9bd2aedc677d720f7e00d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/13", "thumbnail_src": "https://si.imgix.net/50592f2b/uploads/origins/a55986b4-6bcc-46ab-8d7f-bcc0b8e61945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f816b915742dc3f8443adb218b03a9bf", "thumbnail_srcset": "https://si.imgix.net/50592f2b/uploads/origins/a55986b4-6bcc-46ab-8d7f-bcc0b8e61945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f816b915742dc3f