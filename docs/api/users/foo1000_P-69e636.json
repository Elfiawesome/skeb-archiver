47-4542-9a56-b951494cae6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec08c189dce9c7b547c8fa5da2795330", "thumbnail_srcset": "https://si.imgix.net/bf8e4113/uploads/origins/75b2e380-c547-4542-9a56-b951494cae6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec08c189dce9c7b547c8fa5da2795330, https://si.imgix.net/bf8e4113/uploads/origins/75b2e380-c547-4542-9a56-b951494cae6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5db940d187d8da24d481ec1ae7674903 2x, https://si.imgix.net/bf8e4113/uploads/origins/75b2e380-c547-4542-9a56-b951494cae6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ffc8b3906f645cb443e81d008085e69 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/3", "thumbnail_src": "https://si.imgix.net/db1a7a01/uploads/origins/84839b63-3f6b-4058-9621-0537148b72ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c8764f04169fe0d16b57ea796ac3014", "thumbnail_srcset": "https://si.imgix.net/db1a7a01/uploads/origins/84839b63-3f6b-4058-9621-0537148b72ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c8764f04169fe0d16b57ea796ac3014, https://si.imgix.net/db1a7a01/uploads/origins/84839b63-3f6b-4058-9621-0537148b72ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2428ec26e5f8804c196aba621173fe38 2x, https://si.imgix.net/db1a7a01/uploads/origins/84839b63-3f6b-4058-9621-0537148b72ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bfdb493cabbc6a2e03b939f4500f3ef 3x", "genre": "art", "nsfw": true, "body": "もし無理なお願いでなければ以下のリクエストをお願いします\n\n・キャラクター\n東方の姫海棠はたて\n\nはたてのイメージ画像\nhttps://imgur.com/a/loxwlz0\n\n・シチュエーション\n姫海棠はたてがぴょんぴょんバルーン柄のラテックスボールに拘束され\n涙目で藻掻いてるイラストをお願いします\n\n・ラテックスボール\n色は紫色\n柄はマリオパーティ4のミニゲームに登場するぴょんぴょんバルーンの柄\n首はボールの中に埋まりしわが出ている状態\nツインテールはラテックスボールの前にだらんとかかった状態\n藻掻いているエフェクトや効果音あり\nラテックスボールはなるべく全体を映して下さい\n\nぴょんぴょんバルーンの一部参考画像\nhttps://www.pixiv.net/artworks/98290771\nhttps://www.pixiv.net/artworks/98306928\nhttps://www.pixiv.net/artworks/103497166\nhttps://www.pixiv.net/artworks/103680168\n\nもし余力があれば猿轡系差分に穴ありボールギャグ、ラバーマスク、リブレスバッグ付きラバーマスク\nボールタイプのインフレータブルマスクもお願いしたいです\nエフェクトや効果音なしもお願いしたいです\nその他拘束を演出する台詞・構図・小物・エフェクト等はお任せいたします", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/2", "thumbnail_src": "https://si.imgix.net/2edbc12c/uploads/origins/c2701740-1be3-4643-88a1-edaf457cc01a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73073d1a24aab234f31420fdc0f64bde", "thumbnail_srcset": "https://si.imgix.net/2edbc12c/uploads/origins/c2701740-1be3-4643-88a1-edaf457cc01a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73073d1a24aab234f31420fdc0f64bde, https://si.imgix.net/2edbc12c/uploads/origins/c2701740-1be3-4643-88a1-edaf457cc01a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84d9d1a6d9ba1e46e50d487d659bea98 2x, https://si.imgix.net/2edbc12c/uploads/origins/c2701740-1be3-4643-88a1-edaf457cc01a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb78f9f7040fb004357f284276ad2219 3x", "genre": "art", "nsfw": true, "body": "https://www.pixiv.net/artworks/95713894の麗奈ちゃんの構図（圧迫顔込みで）が一番好きなのでこの構図でラテックスボールで拘束された反抗的な態度の二人、天馬咲希と暁山瑞希（ﾌﾟﾛｾｶ）の二人を並べて欲しいです。\n\n欲張りなので差分を上から優先度順に書くので全ては無理。となった場合は省いて大丈夫です。\n涙目顔好きなので泣かしてもらって大丈夫です。\n・鼻フック\n・圧迫顔\n・顔パンツ（似合うデザイン）\n・バイブ責め（通常顔、可能ならその他）\n\n擬音などがあると助かります。\n\nレイヤー管理等が面倒でなければ、psdで切り替え等できると嬉しいです（スルーしても大丈夫です）\n\nこのような内容になりますが良ければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@foo1000_P/works/1", "thumbnail_src": "https://si.imgix.net/18a655d5/uploads/origins/6ba984f8-3977-4b65-abc0-db9729ab7294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f3a5c347ef58c0f3f3130104167f25c", "thumbnail_srcset": "https://si.imgix.net/18a655d5/uploads/origins/6ba984f8-3977-4b65-abc0-db9729ab7294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f3a5c347ef58c0f3f3130104167f25c, https://si.imgix.net/18a655d5/uploads/origins/6ba984f8-3977-4b65-abc0-db9729ab7294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=962d69b1b42bd4ece107303429283808 2x, https://si.imgix.net/18a655d5/uploads/origins/6ba984f8-3977-4b65-abc0-db9729ab7294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f58fdc0f570b7a3231a630b4991a1e9d 3x", "genre": "art", "nsfw": false, "body": "けものフレンズのコディアックヒグマちゃんとパラケラテリウムちゃんが大きめの服柄のラテックスボールに入って転がって競争しているシチュの絵をお願いいたします。\nボールの大きさはコディアックヒグマちゃんは大きめのボールでパラケラテリウムちゃんは巨大なボールでお願いします。\nラテックスボールの柄はそれぞれ2人が普段着ている服の柄でお願いします。\n2人の表情は楽しんでいる表情でお願いします。\nあと、転がるときのオノマトペもお願いします。\n絵の参考になるようにキャラクターの画像を載せておきます。\nコディアックヒグマ→https://i.ytimg.com/vi/VfD-eTHiw8w/maxresdefault.jpg\nパラケラテリウム→https://i.ytimg.com/vi/1fV6PoWY9SI/maxresdefault.jpg", "created_at": "", "completed_at": ""}]}