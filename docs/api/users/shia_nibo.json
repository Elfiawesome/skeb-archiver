&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afcb38bbe276578372e8c6a6ee42cd63 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shia_nibo/works/31", "thumbnail_src": "https://si.imgix.net/e6cb0b39/uploads/origins/c36e45b2-84ef-4896-8c08-8b9d897790be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31b6735db5df62bb05cc089a468c0f17", "thumbnail_srcset": "https://si.imgix.net/e6cb0b39/uploads/origins/c36e45b2-84ef-4896-8c08-8b9d897790be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31b6735db5df62bb05cc089a468c0f17, https://si.imgix.net/e6cb0b39/uploads/origins/c36e45b2-84ef-4896-8c08-8b9d897790be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09d622913214d8f0b2f925863a0fd52e 2x, https://si.imgix.net/e6cb0b39/uploads/origins/c36e45b2-84ef-4896-8c08-8b9d897790be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9b82a446227c041c342038fd5b4fcc3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shia_nibo/works/30", "thumbnail_src": "https://si.imgix.net/ac7f7640/uploads/origins/f763d15c-2dcc-4958-b7a8-2f37e2d894ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2dcd57088388c8e46615f9108fd3c6", "thumbnail_srcset": "https://si.imgix.net/ac7f7640/uploads/origins/f763d15c-2dcc-4958-b7a8-2f37e2d894ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2dcd57088388c8e46615f9108fd3c6, https://si.imgix.net/ac7f7640/uploads/origins/f763d15c-2dcc-4958-b7a8-2f37e2d894ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09dbe6beda680e5c7c5b9f88f524afaf 2x, https://si.imgix.net/ac7f7640/uploads/origins/f763d15c-2dcc-4958-b7a8-2f37e2d894ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42c1b01a1eee0e6aa14ac807463e5164 3x", "genre": "art", "nsfw": false, "body": "はじめまして！リクエスト失礼します。\nモンスターストライクのロンギヌスをお願いしたいです。\n\n・リクエストについて\nキャラクター：ロンギヌス進化前 (封の別の進化形態ではないです！)\n服装：白ベースのパーカー、\n表情、構図：上目遣いのような、少しだけ上を見るような表情で、その目線の先から少し上からのぞくような構図にしていただけると嬉しいです\n\n・使用用途について\nSNSでのアイコンや壁紙などの個人使用です、また、描いていただいたイラストを印刷して個人的に作成している推しバッグなどに使用するかもしれないです。\n\n・資料等\nキャラデザを担当された方の投稿と、資料になるかはわかりませんがボイス秘話の投稿のリンクを貼っておきます。\n・キャラデザ\nhttps://x.com/shino_bara/status/1912456371909369861\n・ボイス秘話\nhttps://x.com/moon_song/status/1590581511992274944\n\n資料になるイラスト等が少ないため、髪形などわかりにくい部分は想像で描いていただいて大丈夫です。\nパーカーを着ている推しキャラをぜひ見てみたいのでご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/16NOB-8UjxzlxidLu0BU2Pv3LOvZtTgTs?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shia_nibo/works/29", "thumbnail_src": "https://si.imgix.net/e3e8381f/uploads/origins/44057455-61b4-4280-9cea-88987031dc5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4108db8f0f731ac58c1d52d1a03d5cbb", "thumbnail_srcset": "https://si.imgix.net/e3e8381f/uploads/origins/44057455-61b4-4280-9cea-88987031dc5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4108db8f0f731ac58c1d52d1a03d5cbb, https://si.imgix.net/e3e8381f/uploads/origins/44057455-61b4-4280-9cea-88987031dc5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c622f5a9529f908641855212b993d48b 2x, https://si.imgix.net/e3e8381f/uploads/origins/44057455-61b4-4280-9cea-88987031dc5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b36cd1cac62be74c1d28fc3f07d52cb 3x", "genre": "art", "nsfw": false, "body": "はじめまして！とりんぱすと申します。\nいつも素敵なイラスト拝見してます！！\n色の塗り方などとても好みで毎度のイラストとても楽しみにしてます！\n\nイラストのリクエストについて\n\n【キャラクター】\nモンストの\nアレキサンドライト(進化)\nをお願いしたいです。\n↓参考資料です。\nhttps://dic.xflag.com/monsterstrike/character/2985/\n\nアイコン等での使用を考えているため、胴から上くらいのイラストでお願いしたいです。\n\nポーズや表情はドヤってる感じでお願いします。\n衣装は参考資料の少なさもありますのでお任せいたします。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shia_nibo/works/28", "thumbnail_src": "https://si.imgix.net/64118db2/uploads/origins/138a79a0-3781-48a2-9382-cfd7e825ea15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=848fef0379da550f25127c9bfc6d7bba", "thumbnail_srcset": "https://si.imgix.net/64118db2/uploads/origins/138a79a0-3781-48a2-9382-cfd7e825ea15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=848fef0379da550f25127c9bfc6d7bba, https://si.imgix.net/64118db2/uploads/origins/138a79a0-3781-48a2-9382-cfd7e825ea15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c351949727bb16957c887372159e08b2 2x, https://si.imgix.net/64118db2/uploads/origins/138a79a0-3781-48a2-9382-cfd7e825ea15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31a501933daf853f33e2a6f9e4e40e15 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shia_nibo/works/27", "thumbnail_src": "https://si.imgix.net/889ad6fd/uploads/origins/5b620ab4-334f-4dc2-8dce-2f4b492f54e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb71c1f0b086707935e87772e9161613", "thumbnail_srcset": "https://si.imgix.net/889ad6fd/uploads/origins/5b620ab4-334f-4dc2-8dce-2f4b492f54e0?bg=%23fff&auto=format%2Ccompress&fm=webp&f