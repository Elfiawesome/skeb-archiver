.net/c45eb30b/uploads/origins/185de58d-941d-4e5f-8457-2241740e2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2641d0a523c84fa589b2b1d952a07467", "thumbnail_srcset": "https://si.imgix.net/c45eb30b/uploads/origins/185de58d-941d-4e5f-8457-2241740e2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2641d0a523c84fa589b2b1d952a07467, https://si.imgix.net/c45eb30b/uploads/origins/185de58d-941d-4e5f-8457-2241740e2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56b5e6394ea0813cdceff284cabbc300 2x, https://si.imgix.net/c45eb30b/uploads/origins/185de58d-941d-4e5f-8457-2241740e2af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e55fbc480429cddfa6043ce6bd176a34 3x", "genre": "art", "nsfw": false, "body": "Twitterや動画投稿アカウントでアイコン又はヘッダー等々で使用する結月ゆかり凪と紲星あかり萌のイラストをお願いしたいです\n金額や労力に合わない場合はどちらかのキャラクターにもう片方のキャラクターのエッセンスが入っていればOKです\n(例：あかり萌ちゃんがゆかり凪さんの帽子を被っている等)", "created_at": "", "completed_at": ""}, {"path": "/@gamma_u1/works/2", "thumbnail_src": "https://si.imgix.net/7a92809b/uploads/origins/c74f5c0e-dc69-4caf-9c81-69d22c60e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65034dd8747bf948954800d6ca06f003", "thumbnail_srcset": "https://si.imgix.net/7a92809b/uploads/origins/c74f5c0e-dc69-4caf-9c81-69d22c60e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65034dd8747bf948954800d6ca06f003, https://si.imgix.net/7a92809b/uploads/origins/c74f5c0e-dc69-4caf-9c81-69d22c60e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a528790fe98f550733e838286f463de4 2x, https://si.imgix.net/7a92809b/uploads/origins/c74f5c0e-dc69-4caf-9c81-69d22c60e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86f6c3202ce72400633ac4a29146b780 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n先生のイラストとても好きです。イキイキとした表情楽しく感じる。\ntwitter で拝見して､この機会に描いて頂きたくリクエストさせて頂きました。\n\n推しの生稚くれあさん@crea_ikichiを描いていただきたいです。テーマは「マクロスδ」のアイドル、セクシーで大胆な雰囲をお願いします。服装、構図などは先生のお好きに描いて嬉しいです｡\n\n彼女の二次創作ガイドライン はこちらですhttps://lit.link/en/ikichicrea\nページの一番下にある。三面図もあります。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@gamma_u1/works/1", "thumbnail_src": "https://si.imgix.net/7d7cf759/uploads/origins/4891bc2e-e6b4-431d-9967-90a350eaf61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18cabe9d778ee93cb685d11c1067094b", "thumbnail_srcset": "https://si.imgix.net/7d7cf759/uploads/origins/4891bc2e-e6b4-431d-9967-90a350eaf61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18cabe9d778ee93cb685d11c1067094b, https://si.imgix.net/7d7cf759/uploads/origins/4891bc2e-e6b4-431d-9967-90a350eaf61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e4b11692cfc3ad4a8f5447ac1f4438a 2x, https://si.imgix.net/7d7cf759/uploads/origins/4891bc2e-e6b4-431d-9967-90a350eaf61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9da6fa7de2a90e525c6da00516a85512 3x", "genre": "art", "nsfw": false, "body": "写真を撮っているｱｶﾈﾁｬﾝをお願いします。\nオレンジっぽいセーターに白いジーパン、ブルーっぽいファー付きのアウターにD750の組み合わせでお願いします。\n出来ればスニーカー(スペースヒッピー03)も描いてくれると嬉しいです...", "created_at": "", "completed_at": ""}]}