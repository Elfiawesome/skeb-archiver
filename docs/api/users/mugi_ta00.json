2-4042-86cc-32c4227116bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbdf00761ed73bbee0dcd02deebfb1c9 2x, https://si.imgix.net/b02fcf6f/uploads/origins/5f6342f0-07e2-4042-86cc-32c4227116bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a38be1347032d1c8837f7f820940226 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルが大好きです。私はVtuberで、自分のキャラクターの絵を依頼したいと思っていました！\n\n私のキャラクターはこんな感じです： https://i.imgur.com/zFpfMBJ.png\n\n彼は火の魔道士で、ちょっと気取った雰囲気があります。\n\nポーズや背景などはお任せします！\n\nまた、必要であればレイヤーを分けて、キャラクターの背景を透過できるようにしていただけると助かります！そうでない場合は、理解していますので、そうしなくても結構です。\n\n本当にありがとうございます！:)", "created_at": "", "completed_at": ""}, {"path": "/@mugi_ta00/works/31", "thumbnail_src": "https://si.imgix.net/101a6935/uploads/origins/68b9159f-f5af-452b-a8ce-413a39754af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=702bd2c4e211edb3205776f7cefb6df6", "thumbnail_srcset": "https://si.imgix.net/101a6935/uploads/origins/68b9159f-f5af-452b-a8ce-413a39754af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=702bd2c4e211edb3205776f7cefb6df6, https://si.imgix.net/101a6935/uploads/origins/68b9159f-f5af-452b-a8ce-413a39754af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=594b32ed5a6a1b9a68fb0a51eb4c7504 2x, https://si.imgix.net/101a6935/uploads/origins/68b9159f-f5af-452b-a8ce-413a39754af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e364ae58b50d4148306f94ff12da11de 3x", "genre": "art", "nsfw": false, "body": "麦田▣様\n\n初めまして、私VTuberの雪丸ひおと申します。\nおすすめから麦田様のイラストを拝見させて頂き、とってもドストライクでめちゃめちゃ好き！です！！\n是非私の事も書いていただけたらと思いご連絡させていただきました。\n\n(Twitter @HioYukimaru)\n\n◆使用用途\n・twitter等SNSでの画像使用、アイコン、ヘッダー、配信や動画のサムネ用\n\n\n◆構図他\n構図やポーズ、服装などはお任せいたします！\n出来たら、背景透過したものも頂きたいです。\n\n\nご検討頂けたら幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mugi_ta00/works/30", "thumbnail_src": "https://si.imgix.net/cec1428e/uploads/origins/3c2c4a0d-87dc-476c-8623-f8ddad9eed41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56c57a9478a834074e30713d9af98dd", "thumbnail_srcset": "https://si.imgix.net/cec1428e/uploads/origins/3c2c4a0d-87dc-476c-8623-f8ddad9eed41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56c57a9478a834074e30713d9af98dd, https://si.imgix.net/cec1428e/uploads/origins/3c2c4a0d-87dc-476c-8623-f8ddad9eed41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76fb26712ffb77821b3041eaba90ab83 2x, https://si.imgix.net/cec1428e/uploads/origins/3c2c4a0d-87dc-476c-8623-f8ddad9eed41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00001368904f34aabc41581f2346a19e 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！\nとても丁寧でありがたいお言葉までいただき、すごく嬉しかったです。\n\n麦田さんのイラストを拝見しまして、とても綺麗な絵柄や人物の描き方がかわいくて惹かれました。女の子も男の子も好きです！\n\nぜひリクエストを送らせていただきたいと思いまして、失礼いたします。\n\n╍╍╍╍╍╍╍╍╍╍\n\n○リクエスト内容\n私の創作キャラの2人組を描いてほしいです。\nシチュエーション・構図などは、麦田さんにおまかせします。アピールで書いてくださった内容のもの、または新しく浮かんできたもの、どちらでも大丈夫です。描く時に想像したものをご自由に描いていただければ嬉しいです！\n(たくさんのシチュエーションを想像してくださりありがとうございます……！)\n\n○キャラクター詳細\n‐ルーシス\n27歳。178cm。男性。冒険者。\n髪色は柔らかいブラウン。目の色は緑色。\n一人どこか遠くを見ているようなことが多いが、洞察力は優れている。\n何事も器用。\n得物を研ぐのが日課。\n魚釣りや絵を描くのが好き。\n海難事故で弟を亡くして以降、あまり他者と深い関わりを持ちたいと思っていない。\n\n-グリネル\n22歳。160cm。女性。冒険者。\n好奇心旺盛で子供っぽい。少し変わり者。\n使い古すまで物を大事にする。\n魚、硝子細工、リンゴ、絵本、露天商の怪しい品が好き。\n交友関係を持つことに積極的で、他者との隔たりがあってもその壁をすぐ乗り越えたいと思う傾向がある。\n\n・関係性\n存在感が薄いのに、存在感を放っている。正直だけど、思いやりがないわけじゃない。彼を友達と言う人もいる。けれど周囲にルーシスをよく知る人はいなかった。\nグリネルはルーシスに興味津々。\n他者との関わりに壁を隔てようとするルーシスに、積極的に対話を試みるグリネル。彼も向けられる素直さから若干の清々しさを感じ、彼女の人柄を拒絶はしなかったため、ゆるい友人関係に至る。\n\n╍╍╍╍╍╍╍╍╍╍\n\nもしよければ、どうぞよろしくお願いします！\nここまで読んでくださりありがとうございます\n\nhttps://app.box.com/s/b5yify8zu0j4sq029v08zc8ibl3rampf", "created_at": "", "completed_at": ""}, {"path": "/@mugi_ta00/works/29", "thumbnail_src": "https://si.imgix.net/b6696273/uploads/origins/d8e54d6e-0953-427d-b26e-a23e55c2a1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2