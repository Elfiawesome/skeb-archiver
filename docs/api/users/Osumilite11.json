ix.net/fc5b00fe/uploads/origins/d0a15001-1343-4543-b329-c98a853fd061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b2aac473556f18b503ff61fa3410e04 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/34", "thumbnail_src": "https://si.imgix.net/3a821814/uploads/origins/285a54b3-8d6a-429b-935a-b32c3b5b7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12ae67831c5865d19178198ca0209a7c", "thumbnail_srcset": "https://si.imgix.net/3a821814/uploads/origins/285a54b3-8d6a-429b-935a-b32c3b5b7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12ae67831c5865d19178198ca0209a7c, https://si.imgix.net/3a821814/uploads/origins/285a54b3-8d6a-429b-935a-b32c3b5b7473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f01d65b55b77d6b8dd4e6b935a279d08 2x, https://si.imgix.net/3a821814/uploads/origins/285a54b3-8d6a-429b-935a-b32c3b5b7473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43db64b9df7d9a5368237d4a7c46f4f7 3x", "genre": "art", "nsfw": true, "body": "【キャラクター】弓長ハル（六本木サディスティックナイト）\nhttps://imgur.com/a/szI96dZ\n\nhttps://youtu.be/6fjXED9b8FE?si=LjZT9O6sElcJ7Qwt\n\n【シチュエーション】\n以前描かれていた閃光×モブ忍の地蔵背負いのイラストがとてもよかったので、あれと同様の絞殺シチュをお願いしたいです。\n\n敵に面が割れているので、もし狙われたら路地裏で1人になったときなどには容易に始末されうると思います。遠距離武器のボーガンで戦うキャラなので、不意打ちで背後から襲えばほぼ確実に仕留められるはずです。\n\n服装は添付画像の1-7枚目の普段のものでお願いします。\n失禁、目を見開いた苦しそうな表情はぜひお願いしたいです。\n最後はできれば確実に絶命したことがわかるようにしてくださると嬉しいです。\n敵のデザインは描きやすいもので構いません。六本木が舞台なので、スーツ姿の仮面男、など、現実寄りの格好が好ましいです。\n\n以上、可能であればぜひよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/33", "thumbnail_src": "https://si.imgix.net/40ad560a/uploads/origins/50f6cdbf-0e27-4d8c-8fbc-d003c5a0c2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484bd84226f44926cd6e100a16535a9d", "thumbnail_srcset": "https://si.imgix.net/40ad560a/uploads/origins/50f6cdbf-0e27-4d8c-8fbc-d003c5a0c2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484bd84226f44926cd6e100a16535a9d, https://si.imgix.net/40ad560a/uploads/origins/50f6cdbf-0e27-4d8c-8fbc-d003c5a0c2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc197b8406493624e4955904d8e3adb1 2x, https://si.imgix.net/40ad560a/uploads/origins/50f6cdbf-0e27-4d8c-8fbc-d003c5a0c2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bf7ebfb7de4ae4543cdef76b096dfb1 3x", "genre": "art", "nsfw": true, "body": "資料URLの作品がとても好みなので依頼させていただきます！\nブルーアーカイブよりアロナとプラナが凍って固まるシチュエーションをお願いします！\n彼女たちは「シッテムの箱」と呼ばれるタブレットPCのOSです。\n「シッテムの箱」の内部に侵入してきたウイルスを削除しようとするも返り討ちにあい、ウイルスによって服を削除されて全裸にされ、恥ずかしがる隙をついて全権限を凍結され、二人とも資料URLのような氷像へと変えられてしまう内容でお願いします。\nできれば、ウイルスは少女型で「【シッテムの箱】の乗っ取りが目的で、OSである二人をいきなり消すと【シッテムの箱】が壊れるので一旦凍結して無力化した。OSとしての機能をコピーしたら自分がOSに成り代わり、二人を削除する予定」の設定でお願いします。\n\nhttps://www.pixiv.net/artworks/113344093", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/32", "thumbnail_src": "https://si.imgix.net/59256e7b/uploads/origins/10b7b17f-d41d-4d53-9f6b-4384a69c9fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5dd7f4d54471683002224452b36a5f3", "thumbnail_srcset": "https://si.imgix.net/59256e7b/uploads/origins/10b7b17f-d41d-4d53-9f6b-4384a69c9fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5dd7f4d54471683002224452b36a5f3, https://si.imgix.net/59256e7b/uploads/origins/10b7b17f-d41d-4d53-9f6b-4384a69c9fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=039db35adc7caddc90d42d3985f3740c 2x, https://si.imgix.net/59256e7b/uploads/origins/10b7b17f-d41d-4d53-9f6b-4384a69c9fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f814e4fe4cc328c4198c54ef65c83e7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/31", "thumbnail_src": "https://si.imgix.net/de480211/uploads/origins/9577dfc8-f4a6-4066-8fc5-0fd48bc7d569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3ed59df2c8f9e0039ca47b092bf540", "thumbnail_srcset": "https://si.imgix.net/de480211/uploads/origins/9577dfc8-f4a6-4066-8fc5-0fd48bc7d569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3ed59df2c8f9e0039ca47b092bf540, https://si.imgix.net/de480211/uploads/origins/9577dfc8-f4a6-4066-8fc5-0fd48bc7d569?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89be0ce45650a9e9751a44a993196c3e 2x, https://si.imgix.net/de480211/uploads/origins/9577dfc8-f4a6-4066-8fc5-0fd48bc7d569?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8b4ea8c45ff40dd7b39cc680353b13 3x", "genre": "art", "nsfw": true, "body": "【リクエスト内容】\n強姦殺害された柳生三厳(一騎当千)\n【資料】\nhttps://www.marv.jp/product/ikki_eb/character/yagyuu/\n【シチュエーション】\n・強姦殺害後の死体がヤリ捨てられている、または晒し吊りにされている\n・制服はビリビリに破られ、胸が露出している\n・全身精液まみれ\n・身体には彼女の刀が突き刺さり、局部には鞘が捩じ込まれている\n\nまた可能でしたら以前描かれてましたこちらの作品\nhttps://skeb.jp/@Osumilite11/works/27\nのような感じで、犯人が彼女の学生証を見比べている描写を付けていただけると嬉しいです。\n\nその他背景や犯人のセリフなどはお任せします。\nご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/30", "thumbnail_src": "https://si.imgix.net/2ecfb249/uploads/origins/507dd6a5-3062-4d6b-bde3-e85aab4ca0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=378c7fad682cf25a256b1e28aeb9617d", "thumbnail_srcset": "https://si.imgix.net/2ecfb249/uploads/origins/507dd6a5-3062-4d6b-bde3-e85aab4ca0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=378c7fad682cf25a256b1e28aeb9617d, https://si.imgix.net/2ecfb249/uploads/origins/507dd6a5-3062-4d6b-bde3-e85aab4ca0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8304656b2ec0d6594645dc82d686b8cf 2x, https://si.imgix.net/2ecfb249/uploads/origins/507dd6a5-3062-4d6b-bde3-e85aab4ca0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c215b777cdc4505d81afbd238f1f2354 3x", "genre": "art", "nsfw": true, "body": "原作『メタルスラッグ』\nキャラクター\n『フィオ・ジェルミ』\nシチュエーション\n『死体置場に置かれたフィオの死体袋が漁られ死体を犯される』\n・死体袋の中のフィオの死体は全裸（髪は下ろされメガネも外されている）\n・首にドッグタグが掛けられている\n・片目や首、腹部に包帯やガーゼが巻かれている（血まみれ\n・目と口が半開きで微睡んでいるような顔", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/29", "thumbnail_src": "https://si.imgix.net/0e5d0d02/uploads/origins/e988d555-dcda-4441-940a-766d982cfff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23390bd83c2e9842347172f6c77cc469", "thumbnail_srcset": "https://si.imgix.net/0e5d0d02/uploads/origins/e988d555-dcda-4441-940a-766d982cfff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23390bd83c2e9842347172f6c77cc469, https://si.imgix.net/0e5d0d02/uploads/origins/e988d555-dcda-4441-940a-766d982cfff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af9c5ea28d3dae0b77cd9a44760e0094 2x, https://si.imgix.net/0e5d0d02/uploads/origins/e988d555-dcda-4441-940a-766d982cfff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7356173320f2c52863696c1c400098ef 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n大隅らいとさんの素敵なイラストの数々を見て、是非とも描いていただきたく思いリクエストさせていただきました。\n\nご一読頂けますと幸いです。よろしくお願いします。\n\n\n○作品\nMETAL GEAR AC!D2\n\n○キャラクター(衣装)\nヴィナス(スニーキングスーツ)\n\n○シチュエーション\n　敵の施設に潜入した【ヴィナス】が敵のステルス兵に首を切られて敗北するイラストをお願いします。\n\n○シチュエーション詳細等\n・　資料の【ヴィナス】はややリアル調のキャラクターデザインですが、大隅らいとさんの描きやすいようにデフォルメしていただければと思います。\n\n\n・　以下にシチュエーションや台詞のイメージを列挙しますので、参考にしていただければと思います。\n\n1.　【ヴィナス】が物陰に到着し、イヤホン無線で仲間に無線連絡。\n「こちらヴィナス。データを入手したわ。　今から離脱するからお迎えのヘリをよろしくね。」\n\n2.　【ヴィナス】の背後にステルス迷彩を装備した敵の揺らぐ影がスゥッ…と現れる。\nそうとも知らずに「こんな甘い警備だなんて、敵ながら心配だわ」と呟く【ヴィナス】\n\n3.　【ヴィナス】が不意に背後から顎を持ち上げられ、がら空きになった喉目掛けて敵のナイフが一閃。\n目を見開いて「っ？！」と息を呑むことしかできなかった【ヴィナス】\n\n4.　敵が素早く手を離し、支えを失って地面に膝をつく【ヴィナス】は必死に血が溢れる喉の傷を両手で押さえつつ「ごぼっ！げぼっ…！！」と呼吸に苦しむ。\n\n5.　そのまま地面に倒れ込み、おしりがやや突き上がった状態で痙攣して地面に血溜まりを作る【ヴィナス】\n(この時、弛緩して失禁(小)を垂らしていると嬉しいです。)\n\n6.　敵は【ヴィナス】を足で踏むようにして仰向けにし、虚ろな目で死亡しているのを確認し「侵入者を排除した。　…中々イイ女だったから少し惜しいな。」と連絡する。\n\n以上になりますが、可能であれば死亡した【ヴィナス】がスニーキングスーツを乱雑に切り開かれて複数人に死姦されていたり、そのあと精液まみれで討ち捨てられているイラストをいただけるととても嬉しいです。\n\n\nご一読くださりありがとうございます。\n長いリクエスト分となってしまい申し訳ありません。\n\nご一考いただければ幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/12DH_CYhP0WxJqAxCtAHyfSVJ7Pgo7Gqf", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/28", "thumbnail_src": "https://si.imgix.net/658c37ca/uploads/origins/0940453b-041c-4a67-8b05-e50c4f1d7de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168badefc7bcc08cbfffb877a99d180f", "thumbnail_srcset": "https://si.imgix.net/658c37ca/uploads/origins/0940453b-041c-4a67-8b05-e50c4f1d7de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168badefc7bcc08cbfffb877a99d180f, https://si.imgix.net/658c37ca/uploads/origins/0940453b-041c-4a67-8b05-e50c4f1d7de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc6ee3843347a428153e1869792a2cad 2x, https://si.imgix.net/658c37ca/uploads/origins/0940453b-041c-4a67-8b05-e50c4f1d7de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d5de0acc8466a79ebfdc980e0f985ce 3x", "genre": "art", "nsfw": true, "body": "大隅様の描かれる可愛らしい女の子の過激なリョナ漫画に惹かれ、是非依頼をお願い出来たらと思います\n\n遊戯王ラッシュデュエルから\n「やられ役にされるブラック・マジシャン・ガール」\nといった作品をお願いします\n\n〇登場キャラ\n・ブラック・マジシャン・ガール（以下BMG表記\nhttps://www.db.yugioh-card.com/rushdb/card_search.action?ope=2&cid=16371\n胸は大きく、上乳や胸の谷間が良く見えるように（乳首の描写は無しで\nスカートの中は青いレオタードで\n・マックス・レイダー\nhttps://www.db.yugioh-card.com/rushdb/card_search.action?ope=2&cid=15199\n\nカードゲームを紹介するホビー漫画のようなテイストで、出血の表現は抑えながらも、首や足が捥げるところは容赦なく描写\n\n①BMG召喚シーン\n・『カードをセットし、モンスターを召喚！！』\n・可愛くポーズを決めたブラック・マジシャン・ガールの全身絵\n\n②マックス・レイダー召喚シーン\n・『相手よりも強力なモンスターを召喚しよう！！』\n・かっこよくポーズを決めたマックス・レイダーの姿\n\n③マックス・レイダーに切り裂かれるBMG\n・『バトルフェイズ！相手のモンスターに攻撃だ！！』\n・斧を振るうマックス・レイダーと首と両足を切り飛ばされるBMGの後ろ姿\n・スカートが捲れ上がって中のお尻が丸見えの状態\n\n④BMGの胴体のアップ\n・『相手のモンスターを倒し、ライフポイントを減らして勝利を掴もう！！』\n・首のないBMGの胴体が宙に浮いている様子\n・胸がアップで映るようなアングルで\n\n原作漫画等で使われてるような攻撃力やライフポイントの表記を入れて頂けたら嬉しいです\n細かいセリフやコマ割りは自由に変更して頂いて構いません\n多数の依頼を頂いてる中で難しいかもしれませんが、よろしければご検討お願いします", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/27", "thumbnail_src": "https://si.imgix.net/338d343c/uploads/origins/fcc6258a-cccc-4bb5-a10c-c6ba4ee0bd78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3259417ccc6da614728b16e85724791f", "thumbnail_srcset": "https://si.imgix.net/338d343c/uploads/origins/fcc6258a-cccc-4bb5-a10c-c6ba4ee0bd78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3259417ccc6da614728b16e85724791f, https://si.imgix.net/338d343c/uploads/origins/fcc6258a-cccc-4bb5-a10c-c6ba4ee0bd78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edaa3319dfec5b82032d7f6e8758ab72 2x, https://si.imgix.net/338d343c/uploads/origins/fcc6258a-cccc-4bb5-a10c-c6ba4ee0bd78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b637a44c1cd5a314a0ff307c303acf8b 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしい作品をありがとうございました。今回また依頼させて頂きます。\n\nキャラクター:戦乱カグラの雪泉\nhttps://dic.pixiv.net/a/雪泉\n\nシチュエーション:敵に敗れ死体を確認されている\n\n・仰向けで倒れている\n・衣装はボロボロで傷・血だらけ\n・乳房が露出している\n・スリーサイズ、写真などが書いてある報告書と照合して死体の確認をされている(状態：死亡確認など書かれている)\n\n詳細は以上です。\n体の上半身(主に胸の部分)が見える構図でお願いします。\nセリフの有無などは製作者様にお任せします。\n上手く伝えられているかわかりませんが、可能であればよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/26", "thumbnail_src": "https://si.imgix.net/3151012d/uploads/origins/30fa06e2-5a44-4aca-bc32-693076f84240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab8ef2586c537028441529557c0e4947", "thumbnail_srcset": "https://si.imgix.net/3151012d/uploads/origins/30fa06e2-5a44-4aca-bc32-693076f84240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab8ef2586c537028441529557c0e4947, https://si.imgix.net/3151012d/uploads/origins/30fa06e2-5a44-4aca-bc32-693076f84240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc4254e6e447d8e84987b96e7109f034 2x, https://si.imgix.net/3151012d/uploads/origins/30fa06e2-5a44-4aca-bc32-693076f84240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9d6912c6fcfcb940876dc1212f07c5d 3x", "genre": "art", "nsfw": true, "body": "匿名で失礼します。もしよければ、デジモンアドベンチャーtriの八神ヒカリとエレキモンのイラストを2枚でリクエストさせてください。\n\nテーマ:意地悪なエレキモン（紫）に電撃でいたずらされる八神ヒカリ\n\nシチュエーション：\n１枚目： エレキモンがヒカリに電撃を浴びせる。ヒカリは両手を上げてガニ股のポーズで感電。\n（ポーズの参考画像）　https://64.media.tumblr.com/d3ad62b0bfb9dffd9d68e14069a8572e/60b074eef3821d9e-81/s2048x3072/b7d377ff629fab277d5a574edb630ae49cac9edc.pnj\n\n表情は過去にpixivに投稿していたミニスカート&バチュル（https://www.pixiv.net/artworks/73952135#manga）のような、驚いた感じの表情。\n\n\n２枚目︰電撃が終わった後。ヒカリは痺れて尻もちをついている。涙目の表情で髪の毛はボサボサになっている。また、ところどころ焦げて煙が出ている。\n\n\nヒカリの服装は、デジモンアドベンチャーtriのセーラー服の夏服（上は白メイン、スカートは緑のものです）。\n\n2枚とも全身入っている構図でお願いします。\nまた、可能であれば2枚目の焦げ具合で差分をお願いします。\n\n\n参考\n・八神ヒカリ@triのセーラー服（夏服）\nhttps://www.suruga-ya.jp/product/detail/608642371\n\nhttps://www.deviantart.com/dragonmatt600/art/Kari-Kamiya-Wearing-her-Sexy-Summer-Schoolgirl-Out-944364992\n\nhttps://digitousailorcure.fandom.com/wiki/Kari_Kamiya\n\n\n・エレキモン（紫色のウイルス種）\nhttps://www.cardrush-digimon.jp/phone/data/cardrush-digimon/product/rushBT6-070.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/25", "thumbnail_src": "https://si.imgix.net/902a0183/uploads/origins/f86604ff-22d8-4608-9ea9-b482422c6280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab51ffd8d2f41d4ae7d64492b6d612d4", "thumbnail_srcset": "https://si.imgix.net/902a0183/uploads/origins/f86604ff-22d8-4608-9ea9-b482422c6280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab51ffd8d2f41d4ae7d64492b6d612d4, https://si.imgix.net/902a0183/uploads/origins/f86604ff-22d8-4608-9ea9-b482422c6280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e4ce6bed15f05473c29fbf8e9d30344 2x, https://si.imgix.net/902a0183/uploads/origins/f86604ff-22d8-4608-9ea9-b482422c6280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf5915d84f82a4cea50685cee020caba 3x", "genre": "art", "nsfw": true, "body": "プリキュアのキュアスカイのやられ（絶命）イラストを描いていただけないでしょうか。\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/24", "thumbnail_src": "https://si.imgix.net/2e054096/uploads/origins/20c63fa4-fa46-40be-a3c0-4318b80dede0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166f2c63c2e37f90ce520d10dca41297", "thumbnail_srcset": "https://si.imgix.net/2e054096/uploads/origins/20c63fa4-fa46-40be-a3c0-4318b80dede0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166f2c63c2e37f90ce520d10dca41297, https://si.imgix.net/2e054096/uploads/origins/20c63fa4-fa46-40be-a3c0-4318b80dede0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f087f29387fe2ca833c2f67023f1ccd 2x, https://si.imgix.net/2e054096/uploads/origins/20c63fa4-fa46-40be-a3c0-4318b80dede0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d9c52edda9f96b57dadb06a4e83ebd3 3x", "genre": "art", "nsfw": true, "body": "【リクエスト】\n暗殺される雪泉(閃乱カグラ)\n\n【シチュエーション】\n以下の流れでリクエストしたいです。\n\n変装が得意な悪忍に襲われ暗殺される\n↓\n悪忍は雪泉の服を奪い取るとそれを着て、雪泉そっくりに変装する\n↓\n雪泉に変装した悪忍は「今日から私が本物の雪泉よ。さようなら、偽物さん。」と言い残して雪泉の全裸死体を遺棄してどこかへ去って行く\n\nこんな感じでいかがでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/23", "thumbnail_src": "https://si.imgix.net/8521016f/uploads/origins/3e18c7f5-7fa8-43df-a441-23ec60fab54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35082c99bb206e8cb6b7a471c9f8465", "thumbnail_srcset": "https://si.imgix.net/8521016f/uploads/origins/3e18c7f5-7fa8-43df-a441-23ec60fab54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35082c99bb206e8cb6b7a471c9f8465, https://si.imgix.net/8521016f/uploads/origins/3e18c7f5-7fa8-43df-a441-23ec60fab54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15d430e93dd69fdf4a17eb480d4015cc 2x, https://si.imgix.net/8521016f/uploads/origins/3e18c7f5-7fa8-43df-a441-23ec60fab54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bec9d772669a0507ead635d6cb14bebb 3x", "genre": "art", "nsfw": true, "body": "大隅らいとさん、こんばんは。\n\n以前、サヤカやマリアのリクエストをさせて頂いたものです。\n今回も可能でしたらよろしくお願いします。\n\n今回のリクエストは悪魔城ドラキュラ黙示録のキャリーのリョナをお願いします。\n\n迷路庭園でチェーンソーを持ったガーデンキーパーに襲われるキャリー。\n圧倒的体格差に手も足も出ず、重傷を負うキャリー。\n\n地面に仰向けに倒れ、目の前の大男に恐怖するキャリー。\nキャリーは身体中に切り傷がありボロボロ。\n服が破れ、左胸のおっぱいが露出している。\nまたスカートも一部破れて、白いショーツが見えている。\n\n大男はゆっくりとチェーンソーを近づけて、怯えるキャリーを楽しむ。\nそのままゆっくりと腹部にチェーンソーを押し付け、キャリーは泣き叫ぶ。\nキャリーは横一文字に切断され、両手と胴体が離れ、地面が赤く染まっていた。\n\nイラストとしては、\n・キャリーが地面に仰向けに倒れて、ボロボロになって怯えているメイン絵。\n・差分で、チェーンソーをキャリーに近づけているシーン。\n・チェーンソーを腹部に押し付けて、泣き叫ぶキャリー。\n・横一文字に切断され、絶命しているシーン。（切断が厳しければ、深い傷で表現してください。）\nまた、お漏らしのＯＮ，ＯＦＦが出来るようにお願いします。\n\nガーデンキーパーはキャリーの目の前にいるので描写はチェーンソーのみで構いません。\n（ガーデンキーパー視点のようなイメージです。）\n可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/22", "thumbnail_src": "https://si.imgix.net/7213b8d3/uploads/origins/91cb4f4f-0c39-4614-9094-19473ebc4307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53eabae2e9ad3f81d67d00da98049495", "thumbnail_srcset": "https://si.imgix.net/7213b8d3/uploads/origins/91cb4f4f-0c39-4614-9094-19473ebc4307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53eabae2e9ad3f81d67d00da98049495, https://si.imgix.net/7213b8d3/uploads/origins/91cb4f4f-0c39-4614-9094-19473ebc4307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c02816ef7cd61d6805670b231ae84e54 2x, https://si.imgix.net/7213b8d3/uploads/origins/91cb4f4f-0c39-4614-9094-19473ebc4307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91d9a8415f19dcccd1895b1c99e21273 3x", "genre": "art", "nsfw": true, "body": "再びになりますがまた「閃乱カグラ」から依頼をさせてください。\n\n\n・無傷の雪泉が絶命し地面に転がっている春花の横顔を踏みつけ非情な言葉を浴びせてください。\n\n・足蹴にした後、ぐりぐりと強く踏み躙り潰し、汚しながら「悪忍の亡骸など足蹴にされて当然ですね」のような尚も非情な言葉を浴びせて下さい。\n\n・ぎゅぅ…と強く春花の顔を踏みしめながら最後には嘲笑的な表情と言葉を春花に浴びせてください。\n\n構成はお任せする形で大丈夫でしょうか。台詞や展開のアレンジはご自由になさって下さい。\nこちらで可能でしたらよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/21", "thumbnail_src": "https://si.imgix.net/d5423cad/uploads/origins/3904f1cc-ee24-44b9-8566-6a5b7cef744f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=557cf26befc2fe12d8f27dba4b0a51e4", "thumbnail_srcset": "https://si.imgix.net/d5423cad/uploads/origins/3904f1cc-ee24-44b9-8566-6a5b7cef744f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=557cf26befc2fe12d8f27dba4b0a51e4, https://si.imgix.net/d5423cad/uploads/origins/3904f1cc-ee24-44b9-8566-6a5b7cef744f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad4fb91eef25dba1bc56665a7161a7d1 2x, https://si.imgix.net/d5423cad/uploads/origins/3904f1cc-ee24-44b9-8566-6a5b7cef744f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88e58e8872343b13491cae4faf594c79 3x", "genre": "art", "nsfw": true, "body": "初めまして絵柄が好みでしたので依頼させていただきます。製作者さまの下記のような作品を描いて頂きたくて依頼させて頂きます。\nhttps://skeb.jp/@Osumilite11/works/7\n敵役は足だけだったり透明だったり製作者様の描きやすいように描いていただいて大丈夫です。\n\nキャラクター:黎の軌跡のアニエス・クローデル(黎の軌跡1の衣装)\nhttps://dic.pixiv.net/a/アニエス・クローデル\nシチュエーション:敵に敗北し戦死している\n\n詳細\n①戦闘に敗北し完全に事切れている全身を見下ろしているコマ\n　・服は着ているが、剣などで切られてボロボロで両方の乳房が露出している\n　・表情は絶望し涙を浮かべて生き絶えている\n　・そばに折れた杖などがあると嬉しいです\n②胸のアップで片方の胸を踏みつぶされながら「ガキのくせに立派なもの持ってるじゃねぇか…」と言われている\n③製作者様の③のようなアングルで「この女の身ぐるみ剥いで金目のモンは売っちまうぞ」「死体も回収しておくぞ」というような台詞を言われている\n\nコマの大きさは①→③→②の順番で大きくしていただけると嬉しいです。\n\n詳細は以上です。\nセリフは思いつきなので製作者様の方で変更や削除していただいても大丈夫です。\nもし可能であればよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/20", "thumbnail_src": "https://si.imgix.net/ad5447cc/uploads/origins/ef0e74b4-0a41-448f-82e8-68cf366d7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=337583a5f5a84e8613acd000bffd0d4b", "thumbnail_srcset": "https://si.imgix.net/ad5447cc/uploads/origins/ef0e74b4-0a41-448f-82e8-68cf366d7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=337583a5f5a84e8613acd000bffd0d4b, https://si.imgix.net/ad5447cc/uploads/origins/ef0e74b4-0a41-448f-82e8-68cf366d7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eabb687aecbc9198d91d805df1e9793 2x, https://si.imgix.net/ad5447cc/uploads/origins/ef0e74b4-0a41-448f-82e8-68cf366d7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efdcdb5366ea52878f6b5380a2b4d6a7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/19", "thumbnail_src": "https://si.imgix.net/fef5e45d/uploads/origins/c64547f5-d06b-4f67-8a00-aa38d0b4da43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6950fd665740c93a5f219e140200c96c", "thumbnail_srcset": "https://si.imgix.net/fef5e45d/uploads/origins/c64547f5-d06b-4f67-8a00-aa38d0b4da43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6950fd665740c93a5f219e140200c96c, https://si.imgix.net/fef5e45d/uploads/origins/c64547f5-d06b-4f67-8a00-aa38d0b4da43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acca3ffc4eb0a58bb6e1cd1e4d5a50b9 2x, https://si.imgix.net/fef5e45d/uploads/origins/c64547f5-d06b-4f67-8a00-aa38d0b4da43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87a56bd4f35f16b0d521b26ccd452d90 3x", "genre": "art", "nsfw": true, "body": "pixivで見た時から依頼したいと思っていました。\nkofの麻宮アテナが大会でナコルルに敗れて56される漫画を依頼します。衣装は最新の15でお願いします。\n詳細\nナコルルに敗れ膝をついているアテナ→アテナ「はぁ…はぁ…負けられなかったのに…」→ナコルル「ではさよならですね…」→アテナ「えっ…？何を言って…」→右腕を刀に切断される→アテナ「声にならない悲鳴」左腕で肩を抱きしめて必死に痛みに耐えながら泣いている様子→ナコルル「敗者は死ぬのが定め　アテナさんはよく頑張りました」→アテナ「いやっ…許して…こないで……」ナコルル「終わりです」ナコルルによって他の四肢も全て切断される。アテナ「もう一度声にならない悲鳴」ナコルルは去り、仰向けに放置されるアテナ「痛いよぉ…死にたく…ないよぉ…誰か…助け…て……」命乞いを繰り返すが四肢から溢れる血により出血多量で死亡→ 哀れな表情を浮かべて死ぬアテナ→ナレーション「人々に勇気を与えたアイドルの最期は見るも無惨だった。麻宮アテナ　絶命」\nシチュエーションは例なのでセリフは多少変えていただいても構いません。グロテスクに描いていただけると嬉しいです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Osumilite11/works/18", "thumbnail_src": "https://si.imgix.net/88c7daac/uploads/origins/4e23b0a9-f818-4cff-8b91-9b0ad7919a69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af63a54ecb00a81e19c5c6fc454ac1c5", "thumbnail_srcset": "https://si.imgix.net/88c7daac/uploads/origins/4e23b0a9-f818-4cff-8b91-9b0ad7919a69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af63a54ecb00a81e19c5c6fc454ac1c5, https://si.imgix.net/88c7daac/uploads/origins/4e23b0a9-f818-4cff-8b91-9b0ad7919a69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d076afe899dee0268422b1292783f790 2x, https://si.imgix.net/88c7daac/uploads/origins/4e23b0a9-f818-4cff-8b91-9b0ad7919a69?bg=%23fff&auto