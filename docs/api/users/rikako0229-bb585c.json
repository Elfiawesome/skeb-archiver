2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37a96c0d06ec9b2a754c266336fd95e8", "thumbnail_srcset": "https://si.imgix.net/c128eb4b/uploads/origins/e1e3c18d-0132-4707-a606-5924ae887601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37a96c0d06ec9b2a754c266336fd95e8, https://si.imgix.net/c128eb4b/uploads/origins/e1e3c18d-0132-4707-a606-5924ae887601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b5ad06a2a8390773b9572161691529c 2x, https://si.imgix.net/c128eb4b/uploads/origins/e1e3c18d-0132-4707-a606-5924ae887601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ed8ce04d03a2247f83dd130b6b41e4b 3x", "genre": "art", "nsfw": false, "body": "はじめまして、イラストの雰囲気がとても素敵で\n先生の描くイラストを推しへ贈りたいと思いリクエストさせていただきます。\n\nリクエスト内容は、「クリスマスに、サンタクロース衣装を着た推しの『ふゆの』さん（@huyunodayo）のイラスト」をお願いしたいです。\n\n〇詳細〇\n・使用用途：\nふゆのさん（@huyunodayo）さんのファンタグでファンアートをあげます。\n普段配信等はされていらっしゃらない方ですが、機会があれば非商用にて活動での使用をしてもらうと思います。\nそのため、配信サムネイル、SNS、Ci-en、アイコンやヘッダー・告知等で使われる可能性があります。\n\n・描いていただきたい推し\n顔・髪型・体：\nhttps://twitter.com/huyunodayo/status/1719153957980033262\nhttps://twitter.com/huyunodayo/status/1717265634445398334\n\n・希望の衣装イメージ\nhttps://amzn.asia/d/2kayn4W\n\n・他：\nふゆのさんは普段は疲れたOLを名乗れている方ですが、\nマスクをつけててもわかる素敵な笑顔や可愛らしい様子が特徴だと思っています。\nそのため、にっこりと目が笑っている笑顔のイラストをお願いしたいです。\n\nなお、イラストのポーズや背景、瞳の色はおまかせします。\nまた、推しの画像の通りマスクはつけたままで大丈夫です。\n\nお手数おかけしますが、何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@rikako0229/works/20", "thumbnail_src": "https://si.imgix.net/3d298466/uploads/origins/692fedf5-d182-42da-81c4-d61c5835a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac1f1fcea2615c325e91c3eed8a84163", "thumbnail_srcset": "https://si.imgix.net/3d298466/uploads/origins/692fedf5-d182-42da-81c4-d61c5835a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac1f1fcea2615c325e91c3eed8a84163, https://si.imgix.net/3d298466/uploads/origins/692fedf5-d182-42da-81c4-d61c5835a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1df0d4930580087ce3201b24cc01dea0 2x, https://si.imgix.net/3d298466/uploads/origins/692fedf5-d182-42da-81c4-d61c5835a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df525f0bebb81d6fe250a7308ba49c6b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVtuber Lune Asteliaのアートをリクエストしたいです！特に星町翠星石(https://twitter.com/rikako0229/status/1687776703651954689)のアートが大好きです。同じようなものをリクエストしたいです！\n\nリューネは月のお姫様で、冒険のために地球にやってきました。かわいくて、明るくて、歌が大好きで、大きな夢を持っています！テーマは三日月、銀河、百合、リボン。構図、ポーズ、表情はお任せしますので、自由に描いてください！髪のリボンは重要なので忘れずにつけてください！\\o/\n\nTwitch、Twitter、Youtube、SNSでの使用許可をお願いしたいです！背景と透過キャラ絵は分けてください。参考までにリンクを貼っておきます。\n\n依頼を検討していただきありがとうございます！素敵な作品を楽しみにしています！;w；\n\nhttps://drive.google.com/file/d/1AQpZKIGIgpN_jPaikzO_EDQQhoEdmMlS/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@rikako0229/works/19", "thumbnail_src": "https://si.imgix.net/3b426aeb/uploads/origins/e7d0a553-675c-4e2e-abc9-5c80f8fa23c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e026df1abac57eddad74db97f259395", "thumbnail_srcset": "https://si.imgix.net/3b426aeb/uploads/origins/e7d0a553-675c-4e2e-abc9-5c80f8fa23c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e026df1abac57eddad74db97f259395, https://si.imgix.net/3b426aeb/uploads/origins/e7d0a553-675c-4e2e-abc9-5c80f8fa23c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8d96c7660b4d3cbab7fd0c0a03cb558 2x, https://si.imgix.net/3b426aeb/uploads/origins/e7d0a553-675c-4e2e-abc9-5c80f8fa23c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b7017795cdf758216ec71a269df1869 3x", "genre": "art", "nsfw": false, "body": "初めまして、Xでイラストを拝見して、(私個人の感想ですが)水彩画っぽく淡いけど印象深いタッチが魅力に感じ興味を惹かれました。\n\n私の推しの個人で活動しているVtuberの桃奈みゆい(https://twitter.com/MomonyaMiyui)さんのファンアートを依頼させていただきたいです。\nそしてそのファンアートに関して、桃奈さんが配信やCi-enなどのサムネイルなどの桃奈さんが活動で使用する旨の許可を頂ければと思います。\n\n先日桃奈さんは新色衣装として、白を基調とした衣装から黒を基調とした衣装をお披露目し、さらに悪魔コス衣装として角と羽が生えたものもお披露目しています。\nまた桃奈さんはいくつか髪型のパターンがあります。\n今回は件の悪魔コス衣装でストレートロングの目隠れで、ちょっと弱気な悪魔っぽい感じでお願いしたいです。\n\n黒色衣装+悪魔コスの参考(髪型ツインテール):\nhttps://twitter.com/MomonyaMiyui/status/1706192545230020744/photo/3\n\nストレートロングの目隠れの参考:\nhttps://twitter.com/MomonyaMiyui/status/1672010521711882241/photo/1\n\nhttps://youtu.be/rYLXXPsKUUo", "created_at": "", "completed_at": ""}, {"path": "/@rikako0229/works/18", "thumbnail_src": "https://si.imgix.net/39d03938/uploads/origins/e45f4ed6-52ff-4ad8-8cfc-4229bfd9b65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4588a35471446db009e3a8f21971dadf", "thumbnail_srcset": "https://si.imgix.net/39d03938/uploads/origins/e45f4ed6-52ff-4ad8-8cfc-4229bfd9b65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4588a35471446db009e3a8f21971dadf, https://si.imgix.net/39d03938/uploads/origins/e45f4ed6-52ff-4ad8-8cfc-4229bfd9b65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f64f9549e104e109576d07c057d4f9dc 2x, https://si.imgix.net/39d03938/uploads/origins/e45f4ed6-52ff-4ad8-8cfc-4229bfd9b65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1054e7123d0924f8bf1e6aeb385c3dd 3x", "genre": "art", "nsfw": false, "body": "りかこ様初めまして‼️\n絵柄が好みだったのでリクエストさせて頂きました。\n髪色は黒で髪型セミロングで目はオッドアイで\nギャルで服装はメイド服でお願いしたいです！\n背景とかポーズとか細かい事はおまかせします\n＜使用用途＞\n新しく作るX(Twitter)の垢で使う予定です！", "created_at": "", "completed_at": ""}, {"path": "/@rikako0229/works/17", "thumbnail_src": "https://si.imgix.net/a39a2329/uploads/origins/8aa6a45f-a4ca-4fc1-9343-c8c902c0a29d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e29a0c807a4bd6adbbfeaf5d4c9593", "thumbnail_srcset": "https://si.imgix.net/a39a2329/uploads/origins/8aa6a45f-a4ca-4fc1-9343-c8c902c0a29d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e29a0c807a4bd6adbbfeaf5d4c9593, https://si.imgix.net/a39a2329/uploads/origins/8aa6a45f-a4ca-4