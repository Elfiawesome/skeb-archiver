origins/1b5d9564-ccdf-4c8f-8bab-d1e5e32b9bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=093e6961514892cbe0f5122fadbdfa22 2x, https://si.imgix.net/de2db9c0/uploads/origins/1b5d9564-ccdf-4c8f-8bab-d1e5e32b9bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c3848f7000d7f4cf9f5b6f2ee50e1e3 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/48", "thumbnail_src": "https://si.imgix.net/8f0bcfe1/uploads/origins/1531021d-5024-4869-8430-969b999587d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2431fc3c5c20c6170dc9571c8d31b2f6", "thumbnail_srcset": "https://si.imgix.net/8f0bcfe1/uploads/origins/1531021d-5024-4869-8430-969b999587d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2431fc3c5c20c6170dc9571c8d31b2f6, https://si.imgix.net/8f0bcfe1/uploads/origins/1531021d-5024-4869-8430-969b999587d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5dcaaa1b7d8a16e7979c854d3481c98 2x, https://si.imgix.net/8f0bcfe1/uploads/origins/1531021d-5024-4869-8430-969b999587d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a65f3446f2364227c8c7fb8f0a946c4a 3x", "genre": "art", "nsfw": false, "body": "こんにちは前回の巨大娘のリクエストありがとうございました!\n\n東方の堀川雷蔵の大きい画像をリクエストしたいです。\n\nプリズムリバー姉妹を踏みつけている姿をお願いします。\n\n酔っているような無自覚な表情もお願いします。\n\n裸足の彼女を描いてください。\n\n靴を履いたバージョンもお願いします。\n\n靴が透けて見えるようにしてください。\n\nポーズの大まかなイメージはこんな感じです：[https://drive.google.com/drive/folders/1_DJWA_3IjQxPDZBGN1y-0dvszt7x_IO2?usp=sharing]\n\nいつもありがとうございます", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/47", "thumbnail_src": "https://si.imgix.net/406e2aaa/uploads/origins/a73f2923-67ea-4807-aa49-431242d781ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da73be3754aa2f583743d478813a9bf0", "thumbnail_srcset": "https://si.imgix.net/406e2aaa/uploads/origins/a73f2923-67ea-4807-aa49-431242d781ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da73be3754aa2f583743d478813a9bf0, https://si.imgix.net/406e2aaa/uploads/origins/a73f2923-67ea-4807-aa49-431242d781ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bfb928ee99c724c9f8f698eb6c7d71e 2x, https://si.imgix.net/406e2aaa/uploads/origins/a73f2923-67ea-4807-aa49-431242d781ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8099ee597a8c97ac25493f11ed32984b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/46", "thumbnail_src": "https://si.imgix.net/272a8e21/uploads/origins/c6910c5b-e9b0-44ee-9e94-1f96d150beea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66a2a5b0325d214104d09969953f2ab6", "thumbnail_srcset": "https://si.imgix.net/272a8e21/uploads/origins/c6910c5b-e9b0-44ee-9e94-1f96d150beea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66a2a5b0325d214104d09969953f2ab6, https://si.imgix.net/272a8e21/uploads/origins/c6910c5b-e9b0-44ee-9e94-1f96d150beea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52ac5991539b9a667283220ab8d0a662 2x, https://si.imgix.net/272a8e21/uploads/origins/c6910c5b-e9b0-44ee-9e94-1f96d150beea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dd89d3c61291a3b5ee1b7b9c2f7e685 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！\nもし、このような依頼がお似合いでしたら、アルテミス（FGO）にアカシア（私のオリジナルキャラ）をつけてほしいです。お値段は上げていただいて構いません！\n\n構図はお任せします！あなたの画風はこのキャラに合うと思うので、どんなキャラにするかだけでも嬉しいです。\n\nアカシアはカルデアの衛生兵（マスターではない）。いつもはストイックな \"クーデレ \"タイプなのですが、今回はシャイでキュートな一面を見せてくれるとうれしいです！\nFGOの絵がメインなので、アルテミスの性格はもうご存知かと思いますが。\n\nアルテミスはアカシアに特別な好意を抱いている（ダーリンと同じくらいかも）。アカシアはこの注目を受け入れているが、少し圧倒されているようだ......。\n\n理想を言えば、アカシアとアルテミスの身長とプロポーションの違いが強調される（あるいは誇張される）のがいい！ポージングも、好きなだけ親密にできる。\n\nお読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/11lUtgj5RbsBG2r4ZGT9cvtWe1IGu_OkD?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/45", "thumbnail_src": "https://si.imgix.net/906f397f/uploads/origins/c884e28a-c61a-41ce-98e8-12e2ebed0dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a868912102e3d22c45016c4ac50bca2f", "thumbnail_srcset": "https://si.imgix.net/906f397f/uploads/origins/c884e28a-c61a-41ce-98e8-12e2ebed0dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a868912102e3d22c45016c4ac50bca2f, https://si.imgix.net/906f397f/uploads/origins/c884e28a-c61a-41ce-98e8-12e2ebed0dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23a6554c5fdc12f2db3e823106adadae 2x, https://si.imgix.net/906f397f/uploads/origins/c884e28a-c61a-41ce-98e8-12e2ebed0dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df28767e96a02098a51bf71f3b9ce26b 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n酒飲み系VTubeの夜風一夜です。\n\n今回は私が裸で腕組仁王立ちのカラーイラストをお願いしたいです。\n出来れば全身で組んだ腕の上に胸が乗ってる状態でお願いしたいです。\n表情は挑発的な笑顔でお願いします。\n\n立ち絵のURLです。参照になりましたら\nhttps://x.com/yoluono_kaze/status/1870290708982313418\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/44", "thumbnail_src": "https://si.imgix.net/bdac691f/uploads/origins/2a1cbe50-a2f7-4807-9123-1556364e1836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59174a7c5e076dabe26aaba4f37e5d23", "thumbnail_srcset": "https://si.imgix.net/bdac691f/uploads/origins/2a1cbe50-a2f7-4807-9123-1556364e1836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59174a7c5e076dabe26aaba4f37e5d23, https://si.imgix.net/bdac691f/uploads/origins/2a1cbe50-a2f7-4807-9123-1556364e1836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=452e3e3370651a0179f94ad5704ae687 2x, https://si.imgix.net/bdac691f/uploads/origins/2a1cbe50-a2f7-4807-9123-1556364e1836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8256d5e34fd983d2fe58ee348041d9f2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/43", "thumbnail_src": "https://si.imgix.net/43c5592c/uploads/origins/8959104e-238e-4b6f-9b02-51df546ff018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3eb9d0942281a79a2798646bd7c52d", "thumbnail_srcset": "https://si.imgix.net/43c5592c/uploads/origins/8959104e-238e-4b6f-9b02-51df546ff018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3eb9d0942281a79a2798646bd7c52d, https://si.imgix.net/43c5592c/uploads/origins/8959104e-238e-4b6f-9b02-51df546ff018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45fdbd42d07c1c3fb1c2f641d422adb1 2x, https://si.imgix.net/43c5592c/uploads/origins/8959104e-238e-4b6f-9b02-51df546ff018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f14ec46b636ea868f2c73ee5da29dc70 3x", "genre": "art", "nsfw": true, "body": "いつも巨大なケツァルコアトルをありがとう！\n\n巨大伊吹童子（夏バージョン）と巨大UDKバーゲスト（https://imgur.com/a/KUTS5oK）をお願いします。\n\nカラーイラストをお願いします\n\n画像を2つに分けて欲しいです。\n\n画像1では、乳首の間に小さなリツカを挟むことができますか。両方の乳首に授乳できるように。\n\nリツカは片方の乳首につかまっている。\n\nトップレスになれるか。\n\nバーゲストは恥ずかしそうに、伊吹童子は興奮したように見えるか。\n\n律花のアップを入れることは可能か (https://imgur.com/a/EiYA5ft)\n\n画像2で、足の間に小さなリツカを挟むことは可能か。\n\n足の裏が見えます。\n\n足の裏は汗ばんでいるのだろうか。\n\n裸足である\n\n足を組み、半身が見える状態で立川を抱きながら座っていることができるか。\n\n足から逃げようとする立花。\n\n前の画像と似たような表現。\n\n手をつないでいるのだろうか。\n(https://imgur.com/a/RDs5fmX)\n\n自由に変更してください。\n\nいつもありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/42", "thumbnail_src": "https://si.imgix.net/0abbabab/uploads/origins/7afc8880-b6dc-41f9-9780-10297a14ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6084dd2fda72dde1915010b7d67f14", "thumbnail_srcset": "https://si.imgix.net/0abbabab/uploads/origins/7afc8880-b6dc-41f9-9780-10297a14ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6084dd2fda72dde1915010b7d67f14, https://si.imgix.net/0abbabab/uploads/origins/7afc8880-b6dc-41f9-9780-10297a14ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4657bcdc89b52666c312d76898c845f1 2x, https://si.imgix.net/0abbabab/uploads/origins/7afc8880-b6dc-41f9-9780-10297a14ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d39f21beb185a4d53c8d1d85d7cb0fd4 3x", "genre": "art", "nsfw": true, "body": "失礼します。今現在ブーディカさんの日常エロスpart 1を依頼させて頂いている者です。\nリクエスト中ですが、宜しければ今回はその続きをお願いします。\n\nキャラ　FGO ブーディカ\n\nシチュエーション\n『ブーディカさんの日常エロスpart2』\nご機嫌な様子で食堂のテーブルをお掃除するブーディカさん。前屈みになっているお陰もあってか、腕を動かす度に長い爆乳が振り子のようにゆさゆさと揺れている。\n\nそれを見ている食事中の男達は（なっっっっっが…）（持ち上げて支えたい…）（顔に乗せておっぱいアイマスクとか良いな…）（テーブルに付きそう…）等と心の中でそれぞれエロい事を考えている。\n\n一枚絵です。細かい構図や台詞の内容などの細かい所はお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/41", "thumbnail_src": "https://si.imgix.net/898dcd19/uploads/origins/caa08a82-0a87-484c-aeda-035f08eb12ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7c93a2b14898c9c8bf8a2b31052327", "thumbnail_srcset": "https://si.imgix.net/898dcd19/uploads/origins/caa08a82-0a87-484c-aeda-035f08eb12ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7c93a2b14898c9c8bf8a2b31052327, https://si.imgix.net/898dcd19/uploads/origins/caa08a82-0a87-484c-aeda-035f08eb12ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04ee259da581abad5b789e4a3a667d2c 2x, https://si.imgix.net/898dcd19/uploads/origins/caa08a82-0a87-484c-aeda-035f08eb12ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0f36e7e2c84252229052d25d8232e1e 3x", "genre": "art", "nsfw": true, "body": "台詞ありのイラストをリクエストさせて頂きます。\n\nキャラクター　FGO ブーディカ\n\nシチュエーション\n『ブーディカさんの日常エロスpart1』\n洗い物をしている時に腕がデカ過ぎるおっぱいに当たってたぷたぷムニュムニュさせているブーディカ。それを見ている男たちが心の中で（でっっっか…）（揺れてる…）（柔らかそう…）（乳輪ポロってね？）等と好き放題思っている。\n\n構図や細かい台詞などはお任せしますので、よろしくお願いします。\n出来ればうっすら乳輪をポロリさせてください。\n\n因みにブーディカさんはデカ乳輪の陥没乳首です。弄ると人妻らしいぽってり長丸くてでっかい乳頭がムクムクと顔を出します。色は使い込まれて色素濃いめのくすんだ感じの色です。そして下はちょい毛深めです。\n念の為の情報です。", "created_at": "", "completed_at": ""}, {"path": "/@inaduki1/works/40", "thumbnail_src": "https://si.imgix.net/22a20a5c/uploads/origins/1b5b3ca7-7210-414f-8178-f50e78a39502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=469b91379058bf5ff758278fd551b1c9", "thumbnail_srcset": "https://si.imgix.net/22a20a5c/uploads/origins/1b5b3ca7-7210-414f-8178-f50e78a39502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=469b91379058bf5ff758278fd551b1c9, https://si.imgix.net/22a20a5c/uploads/origins/1b5b3ca7-7210-414f-8178-f50e78a39502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c592aac242e73e8e41556a095c8dad1 2x, https://si.imgix.net/22a20a5c/uploads/origins/1b5b3ca7-7210-414f-8178-f50e78a39502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bf07128c8d514d2443094b312fde051 3x", "genre": "art", "nsfw": true, "body":