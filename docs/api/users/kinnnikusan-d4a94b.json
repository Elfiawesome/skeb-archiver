a-a6d7-ae51b6380865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9b3e836dbc68fa822ece82582d68623 2x, https://si.imgix.net/7f9f18a1/uploads/origins/947e8a66-a203-4c5a-a6d7-ae51b6380865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5550998c91959e1227166f5b110374be 3x", "genre": "art", "nsfw": true, "body": "はじめまして！ 先生のイラストを見るのはいつも楽しみです。\n百合えっちなリクエストを願いします...\n\n『虹ヶ咲』の天王寺璃奈と宮下愛がレズセックスのイラストをお願いしたいです。\n\n二人とも全裸で貝合わせ（※）をしです。\n※ 貝合わせ：具を使わず互いの女性器を直接こすりつける\n\n【可能であれば】\n絶頂： セックスはとても激しいので、二人とも潮を吹く。\n\n参考になるポーズ集を持っている：\nhttps://catbox.moe/c/bhz93v\n\nそうでなければ、構図は先生が決めるのが一番だ。\n条件が合わない場合は条件再送、キャンセルしていただいて大丈夫です。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kinnnikusan/works/22", "thumbnail_src": "https://si.imgix.net/82ba6f61/uploads/origins/0dc629b0-cab3-441b-8d09-fccf9b067558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e964c3396036440ee7fa54594bab8afb", "thumbnail_srcset": "https://si.imgix.net/82ba6f61/uploads/origins/0dc629b0-cab3-441b-8d09-fccf9b067558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e964c3396036440ee7fa54594bab8afb, https://si.imgix.net/82ba6f61/uploads/origins/0dc629b0-cab3-441b-8d09-fccf9b067558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6340f49de968573bc749b60358ecd53 2x, https://si.imgix.net/82ba6f61/uploads/origins/0dc629b0-cab3-441b-8d09-fccf9b067558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90d7af91013fdc246c8586d42f718f26 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\n天王寺璃奈ちゃんが桃源暗鬼の屏風ヶ浦帆希ちゃんと衣装交換イラストをお願いします\n璃奈ちゃんが帆希ちゃんの鬼機関制服、帆希ちゃんが璃奈ちゃんの制服パーカーを着せてその後、二人でツーショットをお願いします。表情は璃奈ちゃんがウインクしながらピース、帆希ちゃんは照れながらもピースをお願いします\n屏風ヶ浦帆希の参考資料はこちらからお願いします\nhttps://x.com/tougenanki_anm/status/1894688860740657467?t=8at23N386Is-OPaFPzpz9A&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kinnnikusan/works/21", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1951304285763018790%2FsdoBSzH-.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ed7744745eda2e31d44198db9ffe7b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1951304285763018790%2FsdoBSzH-.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ed7744745eda2e31d44198db9ffe7b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1951304285763018790%2FsdoBSzH-.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3c61789b6f4374b39c8defd59279989 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1951304285763018790%2FsdoBSzH-.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f5070d9ed8c51e47644ec72dcff20e1 3x", "genre": "correction", "nsfw": false, "body": "アドバイスほいただきたいと思いましてリクエストさせていただきます\n今アナログで絵を描いているのですが体の構図が想像出来ない状態です\n顔はリンクのように描けている状態です\n今描きたい構図は\n差し伸べられた手を右手で掴もうとする(軽く触れる感じ)、左手は胸にあてるような構図です\nhttps://wide-aquamarine-uuy2g6o6pe.edgeone.app/IMG_6562.jpeg\nよろしければアドバイスお願いします", "created_at": "", "completed_at": ""}, {"path": "/@kinnnikusan/works/20", "thumbnail_src": "https://si.imgix.net/b18546d7/uploads/origins/fa34e475-b329-4b5a-b818-f301c35b9880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfe6575028bb9e29bde3ee2c39e0c7a", "thumbnail_srcset": "https://si.imgix.net/b18546d7/uploads/origins/fa34e475-b329-4b5a-b818-f301c35b9880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfe6575028bb9e29bde3ee2c39e0c7a, https://si.imgix.net/b18546d7/uploads/origins/fa34e475-b329-4b5a-b818-f301c35b9880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8dc34ac4dbdbdd5503ba39617d0ae76 2x, https://si.imgix.net/b18546d7/uploads/origins/fa34e475-b329-4b5a-b818-f301c35b9880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f10be389546fa579d7829b2b6f32256 3x", "genre": "art", "nsfw": false, "body": "もしよろしければ下記の条件の服を着た天王寺璃奈をお願いします \nグレーの前開きパーカー \n璃奈ちゃんボードのイラストがプリントされた黒の半袖Tシャツ \n黒のズボンと黒の下記のURLのような２つ穴ベルト\n ベルト通しにチェーン\n 表情はウインクのすまし顔でズボンのポッケに両手を入れていれる \n以上よろしくお願いします\n\nhttps://item.rakuten.co.jp/shop-orange/bt0221/?iasid=07rpp_10097___2v-me9vmjgp-a1-7cebf9e2-8c14-4aaf-89b8-b8499e1fcf3d", "created_at": "", "completed_at": ""}, {"path": "/@kinnnikusan/works/19", "thumbnail_src": "https://si.imgix.net/5407c32e/uploads/origins/7e5c30e9-4370-42ae-981c-3805cc7d00c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e05b98496e20da10bbb7cb281dbdbe", "thumbnail_srcset": "https://si.imgix.net/5407c32e/uploads/origins/7e5c30e9-4370-42ae-981c-3805cc7d00c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e05b98496e20da10bbb7cb281dbdbe, https://si.imgix.net/5407c32e/uploads/origins/7e5c30e9-4370-42ae-981c-3805cc7d00c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15d7be027466fe1b046d739632e74b85 2x, https://si.imgix.net/5407c32e/uploads/origins/7e5c30e9-4370-42ae-981c-3805cc7d00c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=118c26e7dba6bb4a04becf5d1a8f3646 3x", "genre": "comic", "nsfw": true, "body": "はじめましてキンニックさん、イージスと申します。あなたのイラストにはいつもときめきと興奮を感じていただいております。そこで、僕からもリクエストを1つ依頼いたします。内容は以下の通りですので、よろしくお願いいたします。\n作品：ラブライブ！シリーズ\nキャラクター：天王寺璃奈　矢澤虎太郎\nプレイ内容：おねショタ　顔面騎乗　オナホコキ　射精\nシチュエーション：璃奈と虎太郎によるおねショタコミックです。璃奈はあらかじめ開発した吸引式オナホールを持つと、仰向けになっている虎太郎に顔面騎乗してパンツ越しの匂いを嗅がせます。虎太郎は匂いを嗅いで興奮し、おちんちんを勃起させます。それを見た璃奈はおちんちんをオナホールの中に差し込んでスイッチを入れます。するとオナホールはヒダ部分でおちんちんを刺激し、吸引力を上げます。虎太郎は気持ちよくなって鼻息を荒くして射精しそうになります。璃奈はオナホールの吸引力のもっと上げて、射精してほしそうにお願いします。虎太郎は堪らずオナホの中に多く射精します。それを見た璃奈は虎太郎を褒めてあげ、気持ちよく射精してくれたことへの感謝を伝えます。", "created_at": "", "completed_at": ""}, {"path": "/@kinnnikusan/works/18", "thumbnail_src": "https://si.imgix.net/279dd9a4/uploads/origins/8136f06c-7dbc-4cbe-be58-f928d6bd24f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84186c58ba93094b143d768e0ad5e798", "thumbnail_srcset": "https://si.imgix.net/279dd9a4/uploads/origins/8136f06c-7dbc-4cbe-be58-f928d6bd24f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84186c58ba93094b143d768e0ad5e798, https://si.imgix.net/279dd9a4/uploads/origins/8136f06c-7dbc-4cbe-be58-f928d6bd24f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d8df01e731bc54fc71d35f8f3bd1357 2x, https://si.imgix.net/279dd9a4/uploads/origins/8136f06c-7dbc-4cbe-be58-f928d6bd24f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5106a3314e1a17b077cb752e1f84c248 3x", "genre": "art", "nsfw": true, "body": "同じ虹ヶ咲生の男の娘とセックスする璃奈ちゃんをお願いします。\n場所は璃奈の家、二人とも全裸で駅弁の体位でセックスします。\n竿役の設定（描ける範囲で）\n・ゴツくはないですが脱ぐと男子だと分かる体つき\n・学年は三年生\n・髪は黒髪、地味目、身長は少し高め\n・璃奈のファンだがロリコン気質があり性的な目でも見ている　おちんちんはちっちゃいが璃奈にはちょうどいいサイズのため相性が良い\n・行為の前には璃奈のおっぱい、お尻、アナル、クリ、尿道を触りまくった\n・「私、もう出そう…出すよ、璃奈ちゃんっ…！」と言いながら中出し\n断面図も出来れば希望", "created_at": "", "completed_at": ""}, {"path": "/@kinnnikusan/works/17", "thumbnail_src": "https://si.imgix.net/a6f7e7ca/uploads/origins/29f13ebf-59e5-470a-9b15-76adff46ddef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cf05759227e0d58a87fe41bbfd64494", "thumbnail_srcset": "https://si.imgix.net/a6f7e7ca/uploads/origins/29f13ebf-59e5-470a-9b15-76adff46ddef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cf05759