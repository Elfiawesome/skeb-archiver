itter）での投稿\n・収益化済みサイトでの利用\n・返礼品としてのイラスト利用\n（※グッズ化を指すものではございません）\n\n【納品形式】\n・PNG または PSD\n\n構図や細かい表現については、久世様の描きやすい形でお任せいたします。\nもし料金に不足等がございましたら、再送いただけましたらすぐに対応いたします。\n\nそれでは、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aW7Og8V0KEdUakkhh9UU4srhyws8f0a4?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@hk45_x/works/1168", "thumbnail_src": "https://si.imgix.net/9ed9f011/uploads/origins/38aefb03-faa8-4b3f-ad69-6137a1f36104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19b9f109aeec084bbdd4398369bbd61c", "thumbnail_srcset": "https://si.imgix.net/9ed9f011/uploads/origins/38aefb03-faa8-4b3f-ad69-6137a1f36104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19b9f109aeec084bbdd4398369bbd61c, https://si.imgix.net/9ed9f011/uploads/origins/38aefb03-faa8-4b3f-ad69-6137a1f36104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab69f8d7b81402ee361d705b8fbd340a 2x, https://si.imgix.net/9ed9f011/uploads/origins/38aefb03-faa8-4b3f-ad69-6137a1f36104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=301ee41a0e12f81e5508ee261e1dd290 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hk45_x/works/1167", "thumbnail_src": "https://si.imgix.net/54548d83/uploads/origins/51b12caa-6bbd-4b66-bb15-b8f2ad526ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d4627f70eb181e71fee3fe450e1de3c", "thumbnail_srcset": "https://si.imgix.