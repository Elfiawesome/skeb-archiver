66126-de3f-46b9-abec-211003ebc239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9554fec2965bf6bb78cb285ff4899aac 2x, https://si.imgix.net/ab5f6d9c/uploads/origins/47666126-de3f-46b9-abec-211003ebc239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34a745d01f1d70dd5e4974a9cd49c931 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DORIANE_DOJIN/works/1588", "thumbnail_src": "https://si.imgix.net/18ce636b/uploads/origins/a3347750-29a0-47f2-ac6d-398a51b70c14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61616bbec31531bc0004f0616f8a1cdc", "thumbnail_srcset": "https://si.imgix.net/18ce636b/uploads/origins/a3347750-29a0-47f2-ac6d-398a51b70c14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61616bbec31531bc0004f0616f8a1cdc, https://si.imgix.net/18ce636b/uploads/origins/a3347750-29a0-47f2-ac6d-398a51b70c14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bd7e719c487f31614c01e01a8330bf7 2x, https://si.imgix.net/18ce636b/uploads/origins/a3347750-29a0-47f2-ac6d-398a51b70c14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47e734d89c377f6108f1083da9fe15f1 3x", "genre": "art", "nsfw": true, "body": "はめまして\n絵柄が好みなのでさ、リクエストさせてください\n\n【キャラ】\n艦これのヘレナ\n\n【一枚絵ベースの差分で以下をお願いしたいです】\nバックで胸を揉まれながら挿れられていてる様\n①挿入された瞬間\n②抽送\n③ナカに1発目＆絶頂\n④まだ出来るよねとせがみ、ナカで締め付ける\n⑤外に2発目＆絶頂\n\n【その他】\n性格的には、普段は友達の距離感から、何らかのきっかけに付けてライバルに負けじと、あらゆる手で距離を詰めてくるタイプ\n甘々な営みの雰囲気で\n元より胸は少し盛っていただければ\nキャラ判別の為にカチューシャと左手薬指に金色の指輪あってほしく、ほか服装はなしで\n\n※お手数ですが、取り敢えずの額ですので、金額不足有れば再送ください\n宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@DORIANE_DOJIN/works/1587", "thumbnail_src": "https://si.imgix.net/76255676/uploads/o