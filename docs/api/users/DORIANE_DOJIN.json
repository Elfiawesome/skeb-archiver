.net/cfd04c2a/uploads/origins/ef881ff3-2433-4d35-95b8-b92c4622be58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1efff64cb34096022fdc2f8f48dfdc2e, https://si.imgix.net/cfd04c2a/uploads/origins/ef881ff3-2433-4d35-95b8-b92c4622be58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b146e7a9cafd2ffc27ee104b6656db5 2x, https://si.imgix.net/cfd04c2a/uploads/origins/ef881ff3-2433-4d35-95b8-b92c4622be58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68d6f5616406c6aca73fd6dabbfffa7a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DORIANE_DOJIN/works/1578", "thumbnail_src": "https://si.imgix.net/c019f6f2/uploads/origins/3fc99d36-eadb-4215-af66-fbed41c1e209?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c28fec027b71af1a454e8d9342a54d7b", "thumbnail_srcset": "https://si.imgix.net/c019f6f2/uploads/origins/3fc99d36-eadb-4215-af66-fbed41c1e209?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c28fec027b71af1a454e8d9342a54d7b, https://si.imgix.net/c019f6f2/uploads/origins/3fc99d36-eadb-4215-af66-fbed41c1e209?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba6916fe8f4c9780e873c2cb847fd52a 2x, https://si.imgix.net/c019f6f2/uploads/origins/3fc99d36-eadb-4215-af66-fbed41c1e209?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b6287780ccc010a91f13896da0675fe 3x", "genre": "art", "nsfw": true, "body": "とても好みなイラストを描かれているのでリクエストよろしくお願いします\n\nブルーリフレクション帝という作品の主人公の星崎愛央ちゃんとヒロインのひとりである春日詩帆さんの百合えっちをお願いしたいです\n\n詩帆\n裸エプロン（乱れて胸が露出）\n愛央\n黒のスケスケネグリジェか全裸\n\nベッドの上で愛央ちゃんが詩帆さんの背後に周りエプ