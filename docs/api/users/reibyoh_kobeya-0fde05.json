d6c9-48c4-9d25-d1b295cbb36d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5582d6c8d5994eca76316f8c91e7da1a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@reibyoh_kobeya/works/6", "thumbnail_src": "https://si.imgix.net/f0665b18/uploads/origins/0d1ba50d-7d1f-4aa7-8221-688c8ad07e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35df1a91b2d2176ffd47bce858879db3", "thumbnail_srcset": "https://si.imgix.net/f0665b18/uploads/origins/0d1ba50d-7d1f-4aa7-8221-688c8ad07e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35df1a91b2d2176ffd47bce858879db3, https://si.imgix.net/f0665b18/uploads/origins/0d1ba50d-7d1f-4aa7-8221-688c8ad07e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=280000e68105b22827d1f025cb47bd0e 2x, https://si.imgix.net/f0665b18/uploads/origins/0d1ba50d-7d1f-4aa7-8221-688c8ad07e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c6f730c25c7ca105f71900a11853c0d 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは〜。\n\n今やっているキャンペーンを利用させてもらっていいでしょうか？\n今回はバンドリの市ヶ谷有咲と鰐部七菜です。\n有咲はツンデレから脱却した女の子で、自分に素直になれず、褒め言葉を受け入れるのが苦手な女の子です。身長は152cm。\n七菜は元生徒会長で2歳年上。優しくて面倒見がいいが、いじわるな一面もある。  身長は約163cm。\n\n有咲は昔から七菜にひっそりと、しかし明らかに恋心を抱いているが、あえてそれを認めないという状況。二人はキーボードの練習をしていて、七菜が彼女の後ろに立って手を誘導しているところでしょう。有咲がようやく自分の気持ちを受け入れて、キスをしようと歩み寄る瞬間を描いてほしい。七菜は喜んでその愛情を受け止める。\n\n有咲: https://bestdori.com/assets/en/characters/resourceset/res005028_rip/card_normal.png\n七菜は私服で描くこともできる。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://pbs.twimg.com/media/E6XfViHVoAA2D1s?format=png&name=orig", "created_at": "", "completed_at": ""}, {"path": "/@reibyoh_kobeya/works/5", "thumbnail_src": "https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147eebbbedae7a023a82340368e71c55", "thumbnail_srcset": "https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147eebbbedae7a023a82340368e71c55, https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61a7c49ad7b085d153d434f269a6b084 2x, https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94ff7b84eb3ead0b31af308c435e21b0 3x", "genre": "art", "nsfw": false, "body": "よろしくお願いします。\n\n少し前にあなたの絵を発見し、すぐに気に入りました。そこで、セーラームーンの美奈レイのイラストを描いていただけないでしょうか。\n\nシチュエーションは、秋のデート中の二人です。二人はキスをしていて、おそらく美奈が主導権を握っているが、レイはその愛情を楽しんでいる。\n\n具体的にはあなたにお任せします。\n\nご考察ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@reibyoh_kobeya/works/4", "thumbnail_src": "https://si.imgix.net/d0ccfe76/uploads/origins/8c4829a9-deb4-45d3-8d1d-3e5fba822835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb43807dc899e294cc85beebe53f3c4", "thumbnail_srcset": "https://si.imgix.net/d0ccfe76/uploads/origins/8c4829a9-deb4-45d3-8d1d-3e5fba822835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb43807dc899e294cc85beebe53f3c4, https://si.imgix.net/d0ccfe76/uploads/origins/8c4829a9-deb4-45d3-8d1d-3e5fba822835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0453cb3371d90982e60eef06a30f631 2x, https://si.imgix.net/d0ccfe76/uploads/origins/8c4829a9-deb4-45d3-8d1d-3e5fba822835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17440010bfaad9f7d618249fd7b5584f 3x", "genre": "art", "nsfw": false, "body": "天皇はるかと有栖川樹璃\nセーラームーンとウテナのクロスオーバー\n仮面舞踏会にて女同士のワルツを踊る二人をお願いします！！（全体像で）\n\n天皇はるか（男性役・有栖川樹璃の王子様衣装・黒の狐面）\n有栖川樹璃（女性役・薔薇の花嫁のドレス衣装《樹璃バージョン》・白の狐面）\n・二人とも顔をすっぽり覆った狐面を顔につけている\n\n参考画像\nワルツ↓\nhttps://fscomps.fotosearch.com/bigcomps/CSP/CSP504/k36624643.jpg\n\n有栖川樹璃の王子様衣装↓\nhttps://cdn-eu.anidb.net/images/main/79656.jpg\n\n薔薇の花嫁のドレス衣装↓\nhttps://cdn.donmai.us/sample/54/c0/__tenjou_utena_himemiya_anthy_arisugawa_juri_takatsuki_shiori_kiryuu_nanami_and_1_more_shoujo_kakumei_utena_drawn_by_sen_senpani__sample-54c0ae21c93abc7454054731d5300ade.jpg\n\n狐面↓\nhttps://t.pimg.jp/071/365/911/1/71365911.jpg", "created_at": "", "completed_at": ""}, {"path": "/@reibyoh_kobeya/works/3", "thumbnail_src": "https://si.imgix.net/e54fa28a/uploads/origins/8dc1db2e-4987-4fc2-9460-ee3de78aa8c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f04a63edbc940dc18a2fcb32d7c77e1", "thumbnail_srcset": "https://si.imgix.net/e54fa28a/uploads/origins/8dc1db2e-4987-4fc2-9460-ee3de78aa8c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f04a63edbc940dc18a2fcb32d7c77e1, https://si.imgix.net/e54fa28a/uploads/origins/8dc1db2e-4987-4fc2-9460-ee3de78aa8c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f42bff4890070ea5b07545b1ecc9de0 2x, https://si.imgix.net/e54fa28a/uploads/origins/8dc1db2e-4987-4fc2-9460-ee3de78aa8c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d75a5ec5b3473c3516c68fc1d5910506 3x", "genre": "art", "nsfw": false, "body": "姫宮の絵を描いてもらいたい。絵の中の姫宮は、パソコンでライトノベルの物語を打っている。", "created_at": "", "completed_at": ""}, {"path": "/@reibyoh_kobeya/works/2", "thumbnail_src": "https://si.imgix.net/e3027402/uploads/origins/5db83840-a28b-4463-b4b4-c5624249cc2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a5da494dcb10e92958390db32373eb", "thumbnail_srcset": "https://si.imgix.net/e3027402/uploads/origins/5db83840-a28b-4463-b4b4-c5624249cc2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a5da494dcb10e92958390db32373eb, https://si.imgix.net/e3027402/uploads/origins/5db83840-a28b-4463-b4b4-c5624249cc2b?bg=%23fff&auto=format%2Ccompress&fm=web