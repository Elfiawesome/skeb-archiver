rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c2dd7662cf221ec375b647c18485d68 2x, https://si.imgix.net/2499af45/uploads/origins/cf6910e6-3336-49d5-b8cd-90c5f4391c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c772f60bc1c05e021d4fe9936b5ffd8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/38", "thumbnail_src": "https://si.imgix.net/317c3883/uploads/origins/1cfc6ec3-4cdc-47cb-a2c9-0d72333c2707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f9a9dea4de1a4da6644166193ae4a4", "thumbnail_srcset": "https://si.imgix.net/317c3883/uploads/origins/1cfc6ec3-4cdc-47cb-a2c9-0d72333c2707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f9a9dea4de1a4da6644166193ae4a4, https://si.imgix.net/317c3883/uploads/origins/1cfc6ec3-4cdc-47cb-a2c9-0d72333c2707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1125fef0c011043961943194856e4dbc 2x, https://si.imgix.net/317c3883/uploads/origins/1cfc6ec3-4cdc-47cb-a2c9-0d72333c2707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2a28f6e1a0347fa8965275f426a017d 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\nフィーロちゃんの勇者の成り上がりを描いてほしいんだ。\n\nポーズ：片足を上げたくぱぁ\nhttps://www.pixiv.net/en/artworks/103835406#manga の4枚目の写真のように。\n衣装：全裸とデフォルトの衣装のバリエーションが欲しいです。\n表情: 笑顔、幸せそう\n\n可能であれば、彼女のアソコにザーメンが入っているバリエーションも欲しい。\n\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/37", "thumbnail_src": "https://si.imgix.net/112643e0/uploads/origins/57d05efc-7906-4d30-9f74-142a0120c4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17ed7703421e05d007f34c3907b68ad", "thumbnail_srcset": "https://si.imgix.net/112643e0/uploads/origins/57d05efc-7906-4d30-9f74-142a0120c4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17ed7703421e05d007f34c3907b68ad, https://si.imgix.net/112643e0/uploads/origins/57d05efc-7906-4d30-9f74-142a0120c4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6e38f5cd0923c074c81c54974c96190 2x, https://si.imgix.net/112643e0/uploads/origins/57d05efc-7906-4d30-9f74-142a0120c4fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d616bdeb95b167399054c5cf3fd6b4ed 3x", "genre": "art", "nsfw": true, "body": "藤忍さん\nskeb再開ありがとうございます、もし可能であればこちらをお願いしたいです！\n\nキャラ:アロエ(QMA)\n\n今回少しマニアックですが、髪型を初代QMA仕様でお願いします\nhttps://www.dropbox.com/scl/fi/c2mbg5tdhe3p8s4hzw2ak/IMG_1595.JPG?rlkey=e3p2ym82288vvbqowdpfbx8oj&st=68xk52uz&dl=0\n\nポーズ:以前描かれていたこちらのような感じで、椅子に座ってのくぱぁとぶっかけをお願いしたいです　画角や細かいポーズはお任せします\nhttps://skeb.jp/@FujiShinobu/works/8\n\n他、お願いしたい差分\n・パンツ穿いているもの\n・穿いたままでのおもらし、目瞑りでの表情\n・首輪\n\nご検討よろしくお願いいたします、", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/36", "thumbnail_src": "https://si.imgix.net/4ca920c5/uploads/origins/0e266538-7663-43d6-b01a-f16bc960199b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a4e42efa95e775ec4f0f6c7525b750", "thumbnail_srcset": "https://si.imgix.net/4ca920c5/uploads/origins/0e266538-7663-43d6-b01a-f16bc960199b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a4e42efa95e775ec4f0f6c7525b750, https://si.imgix.net/4ca920c5/uploads/origins/0e266538-7663-43d6-b01a-f16bc960199b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51aee7cdd48fa0c08ae26ce884702d38 2x, https://si.imgix.net/4ca920c5/uploads/origins/0e266538-7663-43d6-b01a-f16bc960199b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96dc19e06b59b0b42f48e1d1483860f5 3x", "genre": "art", "nsfw": true, "body": "藤忍先生\n\nこんばんわ、リクエスト再開心待ちにしておりました。\nいつもルリルリの抱き枕にはお世話になっております。\nあまり軽くない依頼で恐縮ですが、もしよろしければ\n抱き枕カバーのイラストを描いていただけないでしょうか\n\n●形式：PSD形式\n参考デザインテンプレ\nhttps://imgur.com/a/FShzn8v\n\n●キャラ：美少女戦士セーラームーンシリーズより\n　スーパーセーラーちびムーン（ちびうさ）\n\n●衣装：\n・衣装が戦闘で負けてボロボロになり胸と股間が露出している\n・両手足に鉄枷を装着\nhttps://amzn.asia/d/hqwkCFw\nhttps://amzn.asia/d/aEaGmVw\n・装飾のついたリングピアスを勃起した乳首、クリトリスに装着\n・左手枷と左乳首ピアス、右手枷と右乳首ピアスをそれぞれ短い鎖で連結\n・太もも辺りに短い棒をつけて少しガニ股気味に足を開き閉じれなくなっている\nhttps://imgur.com/a/6pmpmyg\nhttps://amzn.asia/d/2srLHpR\n・クリピアスと太ももの棒をチェーンで連結\n・トゲトゲやイボイボの凶悪な形状の極太バイブが挿入（お腹がポコッとなっていると嬉しいです）\n・下腹部に手書きのメモリの落書き\nhttps://imgur.com/a/CQVqvQO\n・片足のブーツが脱げて裸足で以下の様な拘束具を装着\nhttps://imgur.com/a/OloBMXr\n\n●背景：\n白シーツ\nシーツは潮吹きでシミがついている\n\n●差分：\n可能な範囲で構いませんので以下差分があると嬉しいです\n・汗だく\n・体の汚れ\n・いくつかの表情\n　例：微笑み、睨み、恐怖、泣き、絶頂、絶頂から逃れられず悶え、イキすぎて放心、無理やり笑顔など\n・母乳があふれている\n・ぼて腹\n・おっぱいや周辺に噛み跡やキスマーク\n・バイブが抜けて下部に置いてある差分（どんな形状のものが入っていたのか見たいです）\n・バイブ振動On/Off\n\n以上要望が多く恐縮ですが、ご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/35", "thumbnail_src": "https://si.imgix.net/6836ff30/uploads/origins/d6ece4b6-458a-4bb6-8bd2-978dca82ff39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0f7cbab48dd4eb0433275ffabc327a2", "thumbnail_srcset": "https://si.imgix.net/6836ff30/uploads/origins/d6ece4b6-458a-4bb6-8bd2-978dca82ff39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0f7cbab48dd4eb0433275ffabc327a2, https://si.imgix.net/6836ff30/uploads/origins/d6ece4b6-458a-4bb6-8bd2-978dca82ff39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba0685c05109472e8971392cf4b1b310 2x, https://si.imgix.net/6836ff30/uploads/origins/d6ece4b6-458a-4bb6-8bd2-978dca82ff39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b75310799765a9bb698bd3d4c9164ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/34", "thumbnail_src": "https://si.imgix.net/de3e8351/uploads/origins/168df138-e589-4be8-9d57-e8638783bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2335cde5690ccfe2197b7bfd65f2f136", "thumbnail_srcset": "https://si.imgix.net/de3e8351/uploads/origins/168df138-e589-4be8-9d57-e8638783bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2335cde5690ccfe2197b7bfd65f2f136, https://si.imgix.net/de3e8351/uploads/origins/168df138-e589-4be8-9d57-e8638783bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15ad801ccd6ae8a678dac267d903afdd 2x, https://si.imgix.net/de3e8351/uploads/origins/168df138-e589-4be8-9d57-e8638783bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f8e599772a97c071c75d0076b193915 3x", "genre": "art", "nsfw": true, "body": "機動戦艦ナデシコのホシノルリ艦長で\n以前、TV版ホシノルリにふたなり艦長がぶっかけをしていたものを描いていたと思いますが\nビューの方向を逆にして\nふたなり艦長が手コキされていかされちゃっている姿をお願いします\n（以前の絵では2人対1でしたが\n　TV版ホシノルリとホシノルリ艦長のマンツーマンでお願いします）", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/33", "thumbnail_src": "https://si.imgix.net/eec4a129/uploads/origins/980c2d23-d260-49bf-8c4c-cc2be3d128be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78c02e11cc0cda86524af09e4acedbb3", "thumbnail_srcset": "https://si.imgix.net/eec4a129/uploads/origins/980c2d23-d260-49bf-8c4c-cc2be3d128be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78c02e11cc0cda86524af09e4acedbb3, https://si.imgix.net/eec4a129/uploads/origins/980c2d23-d260-49bf-8c4c-cc2be3d128be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c26c4e6117ec7526f9c564d275e9936 2x, https://si.imgix.net/eec4a129/uploads/origins/980c2d23-d260-49bf-8c4c-cc2be3d128be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da5abcc1f6ad6cb55e585e0e1b2b40b4 3x", "genre": "art", "nsfw": true, "body": "機動戦艦ナデシコの劇場版ホシノルリ艦長で\n透け透け白競泳水着をお願いします\n\n勃起した乳首やおへそが透けていて\nハイレグがかなりきつくて\n股間は紐くらいの幅しかなくて筋がほとんど丸見えなくらい\n食い込ませているものが可能でしたらお願いします\n\n膝から上くらいの正面絵で\n股間を重視していただけると非常にありがたいです", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/32", "thumbnail_src": "https://si.imgix.net/fa4f3495/uploads/origins/b394adc8-8eba-4113-ae9d-a72cc49989b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff527065304a1480e6a1d29068c2607e", "thumbnail_srcset": "https://si.imgix.net/fa4f3495/uploads/origins/b394adc8-8eba-4113-ae9d-a72cc49989b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff527065304a1480e6a1d29068c2607e, https://si.imgix.net/fa4f3495/uploads/origins/b394adc8-8eba-4113-ae9d-a72cc49989b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=179dc57ab4c63fa1bf58b8de3c3c95d2 2x, https://si.imgix.net/fa4f3495/uploads/origins/b394adc8-8eba-4113-ae9d-a72cc49989b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7b7530c8cab9855156cb02081f7a6d3 3x", "genre": "art", "nsfw": true, "body": "前回は芸術的に閣下を描いて頂きありがとうございました。家宝にしたくなる美しさでした…。\n\n今回は、『藤忍さまが描く肉球グローブをつけた状態で性交している機動戦艦ナデシコのルリルリ』を依頼させてください。\nルリルリの可愛いさに猫の肉球の可愛いさが合わさったイラストを藤忍さまの美しいタッチで描いて頂いたら、コミケで注目間違いなしの可愛いさになるかと…\n\n衣装は…\nお兄ちゃんはおしまい！のネコまひろ衣装…\nもしくは、プリズマ☆イリヤのデンジャラスビースト衣装を推したいです。（美遊衣装かイリヤ衣装のどちらが似合うかは藤忍さまのセンスにお任せします。）\n\nいずれかルリルリに似合うと思われる衣装があればご採用ください。オリジナルの肉球衣装も歓迎です。\n\n描きにくいようなら脱がしたり、衣装をアレンジしたりして頂いてかまいません。\n\nポーズは…寝転がって腹を見せる猫をイメージしてます。\n\nVERTICAL COMPOSITION 18の表紙の娘のように足を広げた状態で肉棒を挿入され、\n左手はミリアちゃん抱き枕カバーの裸面のようにに手をあげて、右手は着衣面の様に身体の横で軽く拳を握る感じで…\n要は股を開いて、上半身は招き猫のポーズをして欲しいのです。\n\n男優を描くなら男根の描写だけでお願いします。\nルリルリの表情は痛そうでなく、快楽に色づいているとありがたいです。\n猫ですしイタズラっぽい表情でも良いかも？\n\n藤忍さまがこうしたほうが可愛いルリルリになるとお思いになった場合、肉球グローブとキャラセレクト以外は無視して、お好きなnsfwイラストを描いて頂きたいです。", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/31", "thumbnail_src": "https://si.imgix.net/dc08af46/uploads/origins/e657178b-cf1d-4b55-98b2-99d355c2dd77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f886f517075671ee1ed9b82e2b7d0734", "thumbnail_srcset": "https://si.imgix.net/dc08af46/uploads/origins/e657178b-cf1d-4b55-98b2-99d355c2dd77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f886f517075671ee1ed9b82e2b7d0734, https://si.imgix.net/dc08af46/uploads/origins/e657178b-cf1d-4b55-98b2-99d355c2dd77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f20acc80671f14be5966dcb49105870 2x, https://si.imgix.net/dc08af46/uploads/origins/e657178b-cf1d-4b55-98b2-99d355c2dd77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d8a216de8ef17da81e4005fa4fceda1 3x", "genre": "art", "nsfw": true, "body": "募集再開ありがとうございます。\nまた今回もよつねちゃんをお願いしたく思います。\n\nキャラ：\nよそ様の創作キャラクター、早里よつねちゃんのイラストをお願い致します。\n（ご本人様からの許可は頂いております）\nビジュアルは資料URLを参考に宜しくおねがいします。\n\nシチュエーション：\n・ルリルリのミニ抱き枕カバーのように這いつくばって流し目でこちらを見て、お尻を突き上げているよつねちゃん\n・服装は夏制服姿（背面は想像でお願いします）で、白の子供パンツ\n・アイコン上の段左から二番目の様に恥ずかしがっている表情\n\n金額と作業量に見合わなければ省いて頂いて構いませんが、また差分も描いていただけると嬉しいです。\n\n・涙レイヤー\n・パンツを太ももに引っ掛けすじまん露出\n・モブ男の男根挿入（膣内射精溢れ精液ON-OFF）\n・マイクロビキニ＋白いニーソックス\n・資料のピンク色のすけすけネグリジェ\n・ソックスなし全裸\n\n\n備考：\n・やはりおみ足が大好きなのでつま先まで描いて欲しいですが、元のミニ抱き枕の範囲でも大丈夫です。\n・できれば修正は白線が嬉しいですがモザイクでもよろしいです。\n\n以上になります。\n\nそれではどうか、ご検討よろしくおねがい致します。\n\nhttps://cdn.discordapp.com/attachments/870109873864581221/1160256742278561852/YOTUNE.png?ex=6534004b&is=65218b4b&hm=6bb5bf5ab86e0e80d30c8dc8a8f81bf1b9759ffee0e4f26d0a494952a56ea034&", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/30", "thumbnail_src": "https://si.imgix.net/21cc8661/uploads/origins/a7832c9c-cfcf-4206-9bab-d063f3c8ebdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50dfdc0f3f46b6a77f52fb45b8e2bae6", "thumbnail_srcset": "https://si.imgix.net/21cc8661/uploads/origins/a7832c9c-cfcf-4206-9bab-d063f3c8ebdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50dfdc0f3f46b6a77f52fb45b8e2bae6, https://si.imgix.net/21cc8661/uploads/origins/a7832c9c-cfcf-4206-9bab-d063f3c8ebdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2519d7bf11b4865297bd7d7096d39b95 2x, https://si.imgix.net/21cc8661/uploads/origins/a7832c9c-cfcf-4206-9bab-d063f3c8ebdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9782afe29bdffe2e78112458753696b4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/29", "thumbnail_src": "https://si.imgix.net/c26c7fdc/uploads/origins/b9a59bbb-58dd-45f7-a605-f2ade9238065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=809e743986fd6d89641383d2347d1ee8", "thumbnail_srcset": "https://si.imgix.net/c26c7fdc/uploads/origins/b9a59bbb-58dd-45f7-a605-f2ade9238065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=809e743986fd6d89641383d2347d1ee8, https://si.imgix.net/c26c7fdc/uploads/origins/b9a59bbb-58dd-45f7-a605-f2ade9238065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6804e871c3d4cee66cdf0c4db8cc4bf5 2x, https://si.imgix.net/c26c7fdc/uploads/origins/b9a59bbb-58dd-45f7-a605-f2ade9238065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0edf20aefd3a13ecc5a70a697a38b14 3x", "genre": "art", "nsfw": true, "body": "アズールレーンの「クイーン・エリザベス」閣下が寝屋で提督と交わるシーンをお願いしたいです。\n\n閣下の高貴な身分ゆえの上質な肌質の描写は、藤忍さまの技術がないと難しそうなのです。\n\n衣装は「女王様の舞踏会」のドレスでお願いしたいです。\n藤忍さまの絹の描写も素晴らしいので、ぜひこちらの衣装を…。\n描きにくいようなら適時脱がしたり、衣装をアレンジしたりしてください。\n他の衣装を採用するのもよろしいかと。「メイド・マイ・ハイネス」のメイド服やデフォルトの衣装も可愛いくて良いと思います。\n\nリボンちゃんミニ抱き枕カバーのように股を開いて、女性器も手でクパっと開いてるポーズで男根を出し入れされてるトコロを描写して頂きたいです。男優は男根の描写だけでお願いします。値段的に無理ならクパだけでも大丈夫です。\n表情は痛そうでなく、快楽に色づいているとありがたいです。\n\n藤忍さまがこうしたほうが良くなるとお思いになった場合、キャラセレクト以外は無視して、お好きなnsfwイラストを描いて頂きたいです。", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/28", "thumbnail_src": "https://si.imgix.net/23202698/uploads/origins/79e14534-ab73-4e20-8a39-edba3733f199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b40235d940a6403468420ba25ae6305d", "thumbnail_srcset": "https://si.imgix.net/23202698/uploads/origins/79e14534-ab73-4e20-8a39-edba3733f199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b40235d940a6403468420ba25ae6305d, https://si.imgix.net/23202698/uploads/origins/79e14534-ab73-4e20-8a39-edba3733f199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47e8e0e2f9056b7c8ca1f1e32bd3f0f2 2x, https://si.imgix.net/23202698/uploads/origins/79e14534-ab73-4e20-8a39-edba3733f199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a690d06bde5716839c5c0d94746ed7b1 3x", "genre": "art", "nsfw": true, "body": "劇場版ホシノルリで\n裸であそこをくぱぁとしているのが\n可能でしたらお願いします", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/27", "thumbnail_src": "https://si.imgix.net/64666492/uploads/origins/9866545f-0519-405d-944a-ed402c8bfb12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57c0d890fc193b0c1c80ccfa8c0cbc40", "thumbnail_srcset": "https://si.imgix.net/64666492/uploads/origins/9866545f-0519-405d-944a-ed402c8bfb12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57c0d890fc193b0c1c80ccfa8c0cbc40, https://si.imgix.net/64666492/uploads/origins/9866545f-0519-405d-944a-ed402c8bfb12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4eecbd4df901db896137395cecb3e386 2x, https://si.imgix.net/64666492/uploads/origins/9866545f-0519-405d-944a-ed402c8bfb12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=374f53e22ba89d1ebd26581ab260a4a8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/26", "thumbnail_src": "https://si.imgix.net/9fda7da8/uploads/origins/500ffa01-6b7d-4132-8b3d-7e63d97ca73f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a2a32988d27ee4f1cdfd02e98eb69a", "thumbnail_srcset": "https://si.imgix.net/9fda7da8/uploads/origins/500ffa01-6b7d-4132-8b3d-7e63d97ca73f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a2a32988d27ee4f1cdfd02e98eb69a, https://si.imgix.net/9fda7da8/uploads/origins/500ffa01-6b7d-4132-8b3d-7e63d97ca73f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3efdfeb3ff102c96be940a412e80b5b 2x, https://si.imgix.net/9fda7da8/uploads/origins/500ffa01-6b7d-4132-8b3d-7e63d97ca73f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e425c5bba66e0a545edd200e3dce3216 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。以前は肌の描写が芸術的な伊26をありがとうございました。\n\n藤忍様が描かれる少女はただ細く儚いだけでなく、手触りの良さそうな皮膚とその下の柔らかそうな肉付きが感じられてクセになります。指や鎖骨の描写まで美しい。\n\nアズールレーンの伊26が「花火見物の前に」の浴衣をはだけて、寝そべった指揮官に跨って騎乗位中のイラストをお願いしたい。\n（浴衣の模様が大変な場合はオリジナルな模様にするか、全裸でもOKです。）\n『藤忍様が描かれる鼠蹊部から内股あたりをまた観たい』というのが主題なので、他の体位も大歓迎です。描きたい体位を優先してください。\n\n同じキャラは飽きた…という場合は学生服をはだけた伊25（アズールレーン）との性行中を描いたイラストも歓迎です。沙羅ちゃんの様な体型のキャラも可愛く描けるとは…技術の幅が広いですね…。", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/25", "thumbnail_src": "https://si.imgix.net/ce72b15a/uploads/origins/68f207c0-3234-4837-b631-b7614bb54cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e94c8deb19bfa25b424d1ad4d7536c74", "thumbnail_srcset": "https://si.imgix.net/ce72b15a/uploads/origins/68f207c0-3234-4837-b631-b7614bb54cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e94c8deb19bfa25b424d1ad4d7536c74, https://si.imgix.net/ce72b15a/uploads/origins/68f207c0-3234-4837-b631-b7614bb54cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=022328fe7c85e0b3813ceb6c6c7e91ac 2x, https://si.imgix.net/ce72b15a/uploads/origins/68f207c0-3234-4837-b631-b7614bb54cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60ab273947de052881f4767c6bbec085 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FujiShinobu/works/24", "thumbnail_src": "https://si.imgix.net/c03f119b/uploads/origins/9c223d58-8a6c-47b9-9ff2-5130693bf1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6e7bbad6650cf960a46c78d7b295063", "thumbnail_srcset": "https://si.imgix.net/c03f119b/uploads/origins/9c223d58-8a6c-47b9-9ff2-5130693bf1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6e7bbad6650cf960a46c78d7b295063, https://si.imgix.net/c03f119b/uploads/origins/9c223d58-8a6c-47b9-9ff2-5130693bf1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17db70002acc87bd4e8beec3d4b8155c 2x, https://si.imgix.net/c