gix.net/252b9ecd/uploads/origins/3920eb85-1ff1-4eae-9c14-639bdc45c38d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=739e49d494f79feb892bb10b5377c589 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Lida_2617/works/33", "thumbnail_src": "https://si.imgix.net/b3cb9528/uploads/origins/86a8a983-b53a-465b-8714-9b965fa2a94b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3925fb06c259b1a8d265002566c823b9", "thumbnail_srcset": "https://si.imgix.net/b3cb9528/uploads/origins/86a8a983-b53a-465b-8714-9b965fa2a94b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3925fb06c259b1a8d265002566c823b9, https://si.imgix.net/b3cb9528/uploads/origins/86a8a983-b53a-465b-8714-9b965fa2a94b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d030a147bb707288e7abecbd2bbb6c75 2x, https://si.imgix.net/b3cb9528/uploads/origins/86a8a983-b53a-465b-8714-9b965fa2a94b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a591ac93739c8119320cce74f023e80 3x", "genre": "art", "nsfw": false, "body": "以前依頼させていただいたときは、とてもかわいいイラストを描いていただきありがとうございました。今回、私の好きなVtuberと蒼流様の絵柄が親和性があると思い、依頼させていただきました。\n\n〇描いていただきたいVtuber\n天ノ咲ねん様\n　先月デビューしたばかりの新人Vtuberで、独創性の高い様々な企画配信をして視聴者を楽しませてくれます。構図等は蒼流様の自由なご発想におまかせしますが、参考として、私が抱くねん様のイメージは「明るい、元気、勢いがある、クリエイティブ、フレンドリー」などとなります。\n　\n〇使用用途\n　いただいたイラストは、天ノ咲ねん様がYouTubeチャンネルにて、サムネイル、動画素材、配信素材等に使用する許可をいただきたいです。また、同様に天ノ咲ねん様がXでイラスト投稿、画像素材としての使用する許可をいただきたいです。\n\n〇納品形式\n納品形式はキャラクターと背景がレイヤーが分けされたPSDだと大変助かります。\n\n〇資料\nhttps://drive.google.com/drive/folders/1xoBFlGTrVLzBL-mHNBmgRJ8CF-PWuJMC?usp=sharing\n\nYouTubeチャンネル\nhttps://www.youtube.com/@Anoe_Nen\n\nXアカウント\n@AnoeNen\n\nその他リンクまとめ\nhttps://lit.link/anoenen\n\n以上になります。\nもし、ご興味がおありでしたら、ご検討していただければ幸いです。\n失礼いたしました。", "created_at": "", "completed_at": ""}, {"path": "/@Lida_2617/works/32", "thumbnail_src": "https://si.imgix.net/0443f0ef/uploads/origins/7d523bc3-3b67-4327-bf6f-e20a8d881513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e267d78821f73d28f8ebf27a141158", "thumbnail_srcset": "https://si.imgix.net/0443f0ef/uploads/origins/7d523bc3-3b67-4327-bf6f-e20a8d881513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e267d78821f73d28f8ebf27a141158, https://si.imgix.net/0443f0ef/uploads/origins/7d523bc3-3b67-4327-bf6f-e20a8d881513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c39b02d7284be6ee9a03018191b161b7 2x, https://si.imgix.net/0443f0ef/uploads/origins/7d523bc3-3b67-4327-bf6f-e20a8d881513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a2a8fff609109f8a4e80a6f996d3c5e 3x", "genre": "art", "nsfw": false, "body": "蒼流リダ様\n\nはじめまして、グラルと申します。素敵なイラストを拝見して以前から依頼したいと思っており、この度依頼させていただきました。\n\n早速ですが、SEGAの音楽ゲーム「オンゲキ」の藤沢柚子ちゃんのイラストをお願い致します。\n制服で雨の中びしょ濡れで帰ってきて、ベストを脱いだ後に肌に張り付いたワイシャツが透けている様子を描いていただきたいです。髪がぐっしょり濡れている様子は、資料として添付した「[びしょ濡れ雨宿り]桜井春菜」のカードイラストを参考にしてください。表情やワイシャツが透けて薄っすら見えている下着のデザイン等はお任せいたします。可愛く描いていただければ嬉しいです！差分等も描いていただけると嬉しいですが、内容はお任せいたします。\n\nキャラクターおよび衣装、雨に濡れている様子については添付資料を参考にしていただければと思います。\n\n資料\n・キャラクター紹介\n(https://ongeki.sega.jp/character/1020/)\n・カード一覧\n(https://gamerch.com/ongeki/entry/462628)\n・雨に濡れている様子の資料(https://gamerch.com/ongeki/464198)", "created_at": "", "completed_at": ""}, {"path": "/@Lida_2617/works/31", "thumbnail_src": "https://si.imgix.net/0f05d59d/uploads/origins/0540e504-6d84-4cf5-b1c5-e086800e5aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4226862f7c2eb4bddd925c7adb9f4403", "thumbnail_srcset": "https://si.imgix.net/0f05d59d/uploads/origins/0540e504-6d84-4cf5-b1c5-e086800e5aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4226862f7c2eb4bddd925c7adb9f4403, https://si.imgix.net/0f05d59d/uploads/origins/0540e504-6d84-4cf5-b1c5-e086800e5aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f6bf88664b28d7d479506c57d160210 2x, https://si.imgix.net/0f05d59d/uploads/origins/0540e504-6d84-4cf5-b1c5-e086800e5aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b070240aee0702fb0f0726e0366bdeb7 3x", "genre": "art", "nsfw": false, "body": "初めまして\n蒼流リダ様の描かれる\n可愛いイラストがとても気に入ったため\n私の推しキャラを是非蒼流リダ様に\n描いて頂きたいと思いイラスト依頼に参りました\n下記依頼内容になります\n\n描いて頂きたいキャラ\nセガのmaimaiでらっくすより\n天界ちほー4のクロト\n※本文最下部にキャラ資料と楽曲のURL有\n\n指定内容\n①目を細めた艶めかしい表情\n②黒白の羽の描写もお願いしたいです\n指定内容は以上の2点です\n他構図等はおまかせします\n宜しくお願い致します！\n\n公式サイト\nhttps://maimai.sega.jp/area/heaven4/\n\n楽曲\nhttps://youtu.be/4xiS4qk8rec?si=Fy97AKzgV8deljSk", "created_at": "", "completed_at": ""}, {"path": "/@Lida_2617/works/30", "thumbnail_src": "https://si.imgix.net/01dc9a7d/uploads/origins/fa295f72-67cd-4e75-8a0e-6c51a4fd38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c264528bc1f6e241bbe4ce56a8b040a", "thumbnail_srcset": "https://si.imgix.net/01dc9a7d/uploads/origins/fa295f72-67cd-4e75-8a0e-6c51a4fd38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c264528bc1f6e241bbe4ce56a8b040a, https://si.imgix.net/01dc9a7d/uploads/origins/fa295f72-67cd-4e75-8a0e-6c51a4fd38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9680c031dab7d3ef9feb6a07b52bdea8 2x, https://si.imgix.net/01dc9a7d/uploads/origins/fa295f72-67cd-4e75-8a0e-6c51a4fd38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e411e945d51bce63e07c2d7d2c1e253 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n\n蒼流リダ様のイラストを拝見し、ぜひイラスト作成をお願いしたいと思いリクエストいたしました。\n以下、依頼の詳細でございます。お目通し頂けますと幸いです。\n\n◆使用用途\n・個人観賞用\n・Twitterのヘッダー(アイコン等)\n\n◆詳細\nSDVXのニア・ノアちゃん\n\n服装や色合い、雰囲気は蒼流リダ様が以前描かれておりました以下のイラストがイメージとピッタリでございます。\nhttps://www.pixiv.net/artworks/117873148\n\nTwitterのヘッダーでの使用を検討しているため、横長のサイズを希望いたします。\nその他、構図やポージングなどは蒼流リダ様にお任せいたします。\n(もし可能であれば、無理のない範囲内で表情差分をいただけますと幸いです)\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Lida_2617/works/29", "thumbnail_src": "https://si.imgix.net/8f7361fc/uploads/origins/856cd6ba-28d1-4ae0-b03b-2b2b7f876c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5a99961ec063a354923d033265e1d1e", "thumbnail_srcset": "https://si.imgix.net/8f7361fc/uploads/origins/856cd6ba-28d1-4ae0-b03b-2b2b7f876c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5a99961ec063a354923d033265e1d1e, https://si.imgix.net/8f7361fc/uploads/origins/856cd6ba-28d1-4ae0-b03b-2b2b7f876c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0d823517f3e534651be63a823438875 2x, https://si.imgix.net/8f7361fc/uploads/origins/856cd6ba-28d1-4ae0-b03b-2b2b7f876c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bea273561aae8689cd519a4c4456ec25 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Lida_2617/works/28", "thumbnail_src": "https://si.imgix.net/2aee8153/uploads/origins/a96f3ff8-ff6d-49ae-b05c-4a5621ef4e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ada1fa786b88f38cd8787cfcdac805a", "thumbnail_srcset": "https://si.imgix.net/2aee8153/uploads/origins/a96f3ff8-ff6d-49ae-b05c-4a5621ef4e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ada1fa786b88f38cd8787cfcdac805a, https://si.imgix.net/2aee8153/uploads/origins/a96f3ff8-ff6d-49ae-b05c-4a5621ef4e19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=165f638580