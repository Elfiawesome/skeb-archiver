bde-7486b81d6365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee8cf5aea7797bfdabc10f68eda66955 3x", "genre": "art", "nsfw": true, "body": "いつも大変お世話になっております。\nまたうちの子をお願いできないでしょうか。\n\n■衣装等\n資料URLのハイレグポリス衣装をバニー風にアレンジしてください。\n帽子の代わりにウサミミを付け、潜入捜査中…といった感じでお願いします。\n\n大雑把な内容で恐縮ですが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1QZNrH1UJw2Bw-yAAyZXSE43MnRABIIvO?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/94", "thumbnail_src": "https://si.imgix.net/8c89192d/uploads/origins/4e5fa845-e709-4564-bf2b-6610b8973e01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8436d8b313f6115125b592c1949fdfd9", "thumbnail_srcset": "https://si.imgix.net/8c89192d/uploads/origins/4e5fa845-e709-4564-bf2b-6610b8973e01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8436d8b313f6115125b592c1949fdfd9, https://si.imgix.net/8c89192d/uploads/origins/4e5fa845-e709-4564-bf2b-6610b8973e01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77d61cddf7801c40e29296b91406af03 2x, https://si.imgix.net/8c89192d/uploads/origins/4e5fa845-e709-4564-bf2b-6610b8973e01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8489fccc0b91b66221c28d7ddf501b5 3x", "genre": "art", "nsfw": false, "body": "ご挨拶申し上げます。あなたの作品は本当に一流ですね…\n私のキャラクターをあなたのスタイルで描いていただけませんか？\n\n彼女の参考画像は以下にあります：\nhttps://drive.google.com/drive/folders/1YJWBpexsluB2OhtXeHr_Iz0alvC6JoQ-?usp=sharing\n\nハイテクボディスーツに大型の剣を持った姿で描いていただけませんか？今後のリクエストでも使用したいと考えています。デザインは必要に応じて自由に調整してください。角のリングは省略しても構いません。豊満な体型は維持してください。\n\n…可能であれば、後ろ姿もお願いしたいです。無理なら構いません。\n\nご検討いただきありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/93", "thumbnail_src": "https://si.imgix.net/aae958ac/uploads/origins/fe6d9016-445b-4e59-8211-88bb313aacac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f5ad7c3692c8254590356c7ea8af223", "thumbnail_srcset": "https://si.imgix.net/aae958ac/uploads/origins/fe6d9016-445b-4e59-8211-88bb313aacac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f5ad7c3692c8254590356c7ea8af223, https://si.imgix.net/aae958ac/uploads/origins/fe6d9016-445b-4e59-8211-88bb313aacac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb6af9a8e214c8961d7d42ebd721af8d 2x, https://si.imgix.net/aae958ac/uploads/origins/fe6d9016-445b-4e59-8211-88bb313aacac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0b33fcb3e39135afa9cd3f873599603 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私のVTuberキャラクターの絵をお願いしたいのですが。\n彼女は人間の耳を持っていて、サキュバスの角、翼、尻尾を持っています。\n\nポーズ、服装、表情は自由です。\n彼女の大きな胸があれば、クールでも生意気でも何でも。\n\nBlueskyの投稿のようにSNSで使いたい。\n参考画像はURLにて！\n\nhttps://i.imgur.com/Cj3jlNx.png", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/92", "thumbnail_src": "https://si.imgix.net/5d4f32ef/uploads/origins/81fc715f-9fe7-4b2c-9cba-5779b8151b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee5f0f512641cc2366774c2a56cff51", "thumbnail_srcset": "https://si.imgix.net/5d4f32ef/uploads/origins/81fc715f-9fe7-4b2c-9cba-5779b8151b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee5f0f512641cc2366774c2a56cff51, https://si.imgix.net/5d4f32ef/uploads/origins/81fc715f-9fe7-4b2c-9cba-5779b8151b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac7713b437803c741ad6092e92edb0e1 2x, https://si.imgix.net/5d4f32ef/uploads/origins/81fc715f-9fe7-4b2c-9cba-5779b8151b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bc8cceaad6265eadd221b9574eb5ccc 3x", "genre": "art", "nsfw": false, "body": "ヌゥシ様\n\nはじめまして、素敵なイラストを拝見しており、この度リクエストをさせていただきました\nOC（うちの子）の新しい衣装デザインを依頼させていただきたいです\n\n【OC詳細】\nhttps://drive.google.com/drive/folders/1ExPhlbbDtzarZwRR5G8dy190Z6-fbCio?usp=sharing\n春の花をイメージしたキャラクターで、10代後半・160cmぐらいの身長のイメージです\n\n【依頼詳細】\nhttps://x.com/Nuuuuuusi06/status/1974075060681052598/photo/1\nhttps://x.com/Nuuuuuusi06/status/1836350768112374058/photo/1\n上記作品のように、白、黒、緑をベースに、肌を覆う褐色？の光沢感のある素材のサイバー系のスーツ衣装が好みで、ぜひこちらの色合いに近い感じでデザインしていただけないでしょうか\n女の子が重火器を持っているのが個人的に好きで、武器としてはガトリング等大きめの銃をイメージしていますが、こちらは余裕があればで大丈夫です\n髪型・体形等は自由に変えていただいて構いません（ぜひ変更してください）\nその他の要素につきましてはお任せさせていただきます\n\n【使用用途】\n個人使用及び、依頼時の資料として使用させていただきます\n納品形態としても上記のskeb作品と同様でお願いいたします\nどうぞよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/91", "thumbnail_src": "https://si.imgix.net/e48cddca/uploads/origins/695e2f3b-9559-40b4-8910-d6e855eb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bdc0875cf7775e167e8a219fdfe32e0", "thumbnail_srcset": "https://si.imgix.net/e48cddca/uploads/origins/695e2f3b-9559-40b4-8910-d6e855eb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bdc0875cf7775e167e8a219fdfe32e0, https://si.imgix.net/e48cddca/uploads/origins/695e2f3b-9559-40b4-8910-d6e855eb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d91d80ce16d4a168ee73e5a6cb525c9e 2x, https://si.imgix.net/e48cddca/uploads/origins/695e2f3b-9559-40b4-8910-d6e855eb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce955048ef3bb82bb46022c5778aad3e 3x", "genre": "art", "nsfw": false, "body": "また会ったね。僕のキャラクターは、このフード付きの革の服を着せたかったんだ。どんなポーズでも構わないよ。\n\nhttps://www.deviantart.com/stash/216a0v5ybb4x", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/90", "thumbnail_src": "https://si.imgix.net/db271137/uploads/origins/b2824236-885f-4d71-8e97-a1b10fd297ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113e8b350f5ef07b1ecde8a87e4f3846", "thumbnail_srcset": "https://si.imgix.net/db271137/uploads/origins/b2824236-885f-4d71-8e97-a1b10fd297ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113e8b350f5ef07b1ecde8a87e4f3846, https://si.imgix.net/db271137/uploads/origins/b2824236-885f-4d71-8e97-