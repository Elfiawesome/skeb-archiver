4c09-98a3-0cfcf743add6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24b8acba8bdb2a6d62073c05720b7f9", "thumbnail_srcset": "https://si.imgix.net/f19db4b0/uploads/origins/178ec8c3-613e-4c09-98a3-0cfcf743add6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24b8acba8bdb2a6d62073c05720b7f9, https://si.imgix.net/f19db4b0/uploads/origins/178ec8c3-613e-4c09-98a3-0cfcf743add6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa12d365e71fa99ff2dd5a65a9e01469 2x, https://si.imgix.net/f19db4b0/uploads/origins/178ec8c3-613e-4c09-98a3-0cfcf743add6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ab84bbec342805f61c2a142f82b2c29 3x", "genre": "art", "nsfw": true, "body": "うちの子（いわゆるオリジナルキャラクター）の悪魔っ娘レインを描いていただけないでしょうか。\n\n\nキャラ：レイン（資料URLご参照ください）\n\nシチュ、構図など：\n・衣装は参加資料のアメスクスタイル\n・お尻または鼠径部重点\n・ムチムチ感増し\n・目や肌の色、羽尻尾の有無などはお好みのバリエーションでお願いします\n・他はお任せでお願いします\n・宛名はPSDでon /offできると嬉しいです\n\n依頼用資料や紹介としてSNSやドライブ等のストレージ、コミュニケーションツール（掲示板やディスコ等、スタンプや絵文字など）で利用させていただければと思います。\n\nご検討のほどよろしくお願いいたします。\n\n参考資料\nhttps://drive.google.com/drive/folders/1R9Yv7CEpezuYCUk679f_b4XzKkobM15i", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/84", "thumbnail_src": "https://si.imgix.net/c3f258c8/uploads/origins/562d6c79-6806-4c83-bbc9-49f986131cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb8e6efb30635559f3caee4cd044f7e", "thumbnail_srcset": "https://si.imgix.net/c3f258c8/uploads/origins/562d6c79-6806-4c83-bbc9-49f986131cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb8e6efb30635559f3caee4cd044f7e, https://si.imgix.net/c3f258c8/uploads/origins/562d6c79-6806-4c83-bbc9-49f986131cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=594a6b431e8156b09669a3ac176b5786 2x, https://si.imgix.net/c3f258c8/uploads/origins/562d6c79-6806-4c83-bbc9-49f986131cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9fca5e740df02aefbdb39e4df4e333f 3x", "genre": "art", "nsfw": false, "body": "はじめまして、歪んだむと申します。\nバニーとSF的なスーツのイラストが魅力的でしたので、リクエストを送りました。\n\nうちの子の探索者「シア」をリクエストします。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n●リクエスト内容\nコンセプトはのイメージはバニー×SFバトルスーツで、含んでほしい要素に\n・機械的なパーツでできたウサミミ型ヘッドギア\n・https://skeb.jp/@Nuuuuusi/works/74 こちらのようなブーツや背（腰）部のユニットなど一部に機械的な要素\n・竪杵をモチーフにしたツインビームランサーやビーム砲のような大型複合武器\n　うさぎの餅つきのイメージ　※竪杵…うさぎ杵とも呼ばれる、棒状で中央が細く両端が太くなっている両頭タイプの杵\nを入れた『メカニカル要素もあり、戦えるバニー型バトルスーツ』といったイメージでお願いします。\n\nバニー型バトルスーツ衣装は先生の完全なオリジナル、もしくは資料の「基本衣装」や「ライトニング・チェシャー」の意匠を組み込んだものでお願いします。\nバニーのタイプやデザイン、機械的なパーツや武器のデザイン、その他表情やポーズ、構図などはお任せいたします。\n\n\n宛名やサイン、背景などにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインonで投稿）\n\n\nご検討よろしくお願いします。 \n\n\n●簡易な設定など\n黒髪に、先端に行くほど濃くなる山吹色のグラデーションインナーカラー。\n顔はいいが基本的にぶっきらぼうで、口調も乱暴。目付きも鋭い。別に悪人ではないが第一印象で勘違いされやすいタイプ、かつ黙っていれば美人と言われるタイプ。\nスタイルは引き締まっているが、お尻はデカい。\n\n●衣装資料\n・キャラデザ＆基本衣装　https://x.com/gn0083/status/1794173475369980214\n・ライトニング・チェシャー　https://x.com/DAINAMAN_X/status/1919341848989925860?t=hQFbPHbtcggDy28CEKoiaw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Nuuuuusi/works/83", "thumbnail_src": "https://si.imgix.net/7ade10ec/uploads/origins/1193b58b-2b30-4ea0-aeff-a1b7dcf8da0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14d9d3652b90c6cbaf0204e1da0fc903", "thumbnail_srcset": "https://si.imgix.net/7ade10ec/uploads/origins/1193b58b-2b30-4ea0-aeff-a1b7dcf8da0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14d9d3652b90c6cbaf0204e1da0fc903, https://si.imgix.net/7ade10ec/uploads/origins/1193b58b-2b30-4ea0-aeff-a1b7dcf8da0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e9724