76-4786-9dcb-a8a3256b355f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48dc2c1652b5aed0e9ca3f45b8fe7c4d 2x, https://si.imgix.net/3443c69d/uploads/origins/30dd4032-c676-4786-9dcb-a8a3256b355f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cac81653e30d940f549760e9c9d83d6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aoichan567/works/19", "thumbnail_src": "https://si.imgix.net/81b519c1/uploads/origins/7a938546-bea9-45aa-b468-4d7d301118bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee47197a31a5bec01c8df5fc991d4d9", "thumbnail_srcset": "https://si.imgix.net/81b519c1/uploads/origins/7a938546-bea9-45aa-b468-4d7d301118bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee47197a31a5bec01c8df5fc991d4d9, https://si.imgix.net/81b519c1/uploads/origins/7a938546-bea9-45aa-b468-4d7d301118bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=649c5121cee8d3cbd805e4a5929a4eb6 2x, https://si.imgix.net/81b519c1/uploads/origins/7a938546-bea9-45aa-b468-4d7d301118bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6339b6acd85c4fa28c3138ab796d4f23 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品をありがとうございます。\n\n依頼させていただきます。\n\nキャラクター:アイドルマスターシンデレラガールズより高森藍子\n\nシチュエーション:更衣室で着替えている最中、下記URL①のように女戦闘員へと改造されてしまった身体と服を他人に見せつけているシーン。\n\n藍子ちゃんの女戦闘員姿は以前描いていただいた②の姿をベースとしていただけると幸いです。\n\n表情は藍子ちゃんらしい可愛い感じながらも、洗脳されている狂気を孕んでいる形に出来れば嬉しいです。\n\nニッチな上に分かりづらい依頼かと思いますが、可能でしたら何卒ご検討の程宜しくお願い致します。\n\n①https://www.pixiv.net/artworks/1391078\n\n②https://www.pixiv.net/artworks/127466176", "created_at": "", "completed_at": ""}, {"path": "/@aoichan567/works/18", "thumbnail_src": "https://si.imgix.net/1136a379/uploads/origins/f637742c-60ad-4831-8598-264bd466fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff8fdbd4e1a4772dde9581e52775254", "thumbnail_srcset": "https://si.imgix.net/1136a379/uploads/origins/f637742c-60ad-4831-8598-264bd466fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff8fdbd4e1a4772dde9581e52775254, https://si.imgix.net/1136a379/uploads/origins/f637742c-60ad-4831-8598-264bd466fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9dfb2e70139645d8145e5ddaf4893b1 2x, https://si.imgix.net/1136a379/uploads/origins/f637742c-60ad-4831-8598-264bd466fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48e8d2f7b3545e9a16882d4ffd4831d4 3x", "genre": "art", "nsfw": true, "body": "初めまして、楠木様のイラストが可愛くてグッと来たのでリクエストさせていただきます。\n\nホイッスルを吹くラブライブ！サンシャイン！！Aqoursの善子ちゃんを描いて欲しいです。\n顔や口元がメインなので、上半身で充分です。\n\n・衣装は浦の星の長袖制服でアングルは資料のようにお願いします。\n・笛の紐は細めの白色で首にかけず、紐を手に持っている感じでお願いします。\n・笛を吹いている時ほっぺは少し膨らませで、表情はお任せします。\n・唇はみずみずしく潤って柔らかそうな感じでお願い致します。\n・ふんわりキスをするように先っぽだけでなく吹き口の半分以上を優しく咥えている感じでお願いします。\n・また、彼女が吹いた後の、リップグロスの唇の跡や噛んで歯形が付いた唾液まみれの笛も余白の箇所にお願いします。\n・口と笛の間に唾液が糸をとろ〜りと引いていて、口を付けた吹き口部分がベタベタにぬれている感じでお願いします。\n・笛は白のプラ製（画像は黄色ですが、白色でお願いします。）で、資料と形状、穴や刻印（PLASTIC Echo JAPAN）もリアルに再現してくださいませ。\n\nシチュエーションは以下の4パターン描いて頂きたいです。\n①ピーッ！と勢い良く吹くver\n②笛を口から離した時、吹き口は彼女のたっぷりの唾液でベタベタになって、彼女の口元と吹き口に唾が糸を引いてる\n※この時、唇はキスをするようにすぼめた感じでお願いします。\n③笛の吹き口を唇に当ててキスをしているような状態\n※この時の表情はキス顔でお願いします。\n④笛に唾が溜まり“ぴよよ～ん”と変な音が鳴って顔を赤らめ恥ずかしがっている表情\n\n注文が多くてすみませんが、よろしくお願いします。\n\n参考資料\n\nホイッスル（色は白でお願いします。）\nhttps://item.rakuten.co.jp/sumitaya/10005236/?s-id=pc_shop_recommend&rtg=0df0fa745f3e67984866a233e7dc98be\n\nアングル\nhttps://pbs.twimg.com/media/C8-QvarU0AE8HGZ?format=jpg&name=large\n\n※もしも金額が足りない場合は再送依頼お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@aoichan567/works/17", "thumbnail_src": "https://si.imgix.net/b86a901c/uploads/origins/cfe22de0-2241-4c23-978a-1dd8d45da115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874daa87abe774316e3ce9aa6aabcccc", "thumbnail_srcset": "https://si.imgix.net/b86a901c/uploads/origins/cfe22de0-2241-4c23-978a-1dd8d45da115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874daa87abe774316e3ce9aa6aabcccc, https://si.imgix.net/b86a901c/uploads/origins/cfe22de0-2241-4c23-978a-1dd8d45da115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fac8e590fdf66088ec3ac3b0d6571d83 2x, https://si.imgix.net/b86a901c/uploads/origins/cfe22de0-2241-4c23-978a-1dd8d45da115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=847711658600872b68dcc00870266b75 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。巡回していたら先生の作品を見て、ぜひお願いしたいにですが、よろしいでしょうか？\n\nこれは、私が中学生になったばかりの話です。部活動（吹奏楽部）に入り、楽器決めの時にそれは起きました。その女子とは、左右対称に座ってしまい、体育座りをお互いにしてしまい、男子はズボン、女子はスカートだったので、体育座りで、上面。パンティがはっきりまる見えで、中学生になって初めて『勃起』という言葉をしりました。それが私の恋の始まりになりました。確か、パンティは白地にクロッチはっきり、真ん中上に赤い蝶々リボン、制服はブレザーで真っ赤なネクタイ。本人の写真を載せられないので、私がわかる限りでお伝えします。\n・髪型はロンクボブ・黒色（肩まで）カチューシャをしていて、カチューシャより後ろは真ん中分け　\n顔はこの間亡くなられた「若い中山美穂さんのほっぺたがふんわりしてた感じ」です。\n・誰か別の女子と話をわいわいしている。だからこちらがガン見ていることは気づいていない。\n・練習の毎日。その時は気にしてなかったんだけど、2年になった時委員会決めがあり、私は放送が好きだったので、後ろの方から「やります」との声が…それが彼女でした。次の年も。周りからも色々言われたが悪い気持ちではなかった。でも、私にその勇気がなく、散りました。\nでも何とか25年後に連絡先貰ってましたが…結婚されてたので発展することはなく、散りました。それでもそれでも伝えたくて「すきだったよ」彼女は『何を今更』と言いました。それ以来恋はしてません。その思いでをイラストにして頂けますか？ちなみに楽器は私はトロンボーン、彼女はファゴット（特殊です、詳細は申し訳ありませんが、ヤマハのホームページを参照して下ださい）\n\n【作図条件】\nピクセルは前回と同じ（横3840×縦2160ピクセル以上、比率16対9）厳守！\nあとは先生におまかせします。\n\n・お忙しい中、駄文をお読みいただきありがとうございます。ご検討をお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@aoichan567/works/16", "thumbnail_src": "https://si.imgix.net/eebe3350/uploads/origins/0f0e6b79-3696-4b11-9f75-326ac863f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df7b72e0e3e2061e8dc8c2e2ba5404a0", "thumbnail_srcset": "https://si.imgix.net/eebe3350/uploads/origins/0f0e6b79-3696-4b11-9f75-326ac863f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df7b72e0e3e2061e8dc8c2e2ba5404a0, https://si.imgix.net/eebe3350/uploads/origins/0f0e6b79-3696-4b11-9f75-326ac863f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79e7bb69560352cac05dc4b4febddea5 2x, https://si.imgix.net/eebe3350/uploads/origins/0f0e6b79-3696-4b11-9f75-326ac863f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2dbcd648df92907a19d67afb6d13492 3x", "genre": "art", "nsfw": true, "body": "先日は素晴らしい作品をありがとうございました。\n\n再度リクエストさせていただきます。\n\nキャラクター:アイドルマスターシンデレラガールズより高森藍子\n\n前回描いて頂いた下記URL①の戦闘員姿の藍子ちゃんが、下記URL②のような足で責めている姿をお願いします。\n\n希望としては、表情を「足で踏まれて興奮してるんですか？」といった挑発的な悪そうな笑顔でいただけると幸いです。\n\n偏った依頼かと思いますが何卒宜しくお願い致します。\n\n①https://skeb.jp/@aoichan567/works/14\n\n②https://drive.google.com/file/d/1rBWa7EEoSc35ty-clvyEhhDFMR4qGEyn/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@aoichan567/works/15", "thumbnail_src": "https://si.imgix.net/9df8fcf1/uploads/origins/127b940e-fc85-4b98-aecb-f02c2bf74323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9a0eb65044fb99b3f333f6deef10549", "thumbnail_srcset": "https://si.imgix.net/9df8fcf1/uploads/origins/127b940e-fc85-4b98-aecb-f02c2bf74323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9a0eb65044fb99b3f333f6deef10549, https://si.imgix.net/9df8fcf1/uploads/origins/127b940e-fc85-4b98-aecb-f02c2bf74323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b1234add932ec0b670dce204ee24346 2x, https://si.imgix.net/9df8fcf1/uploads/origins/127b940e-fc85-4b98-aecb-f02c2bf74323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=174c284436eafdb3434c7a6afe6e986b 3x", "genre": "art", "nsfw": true, "body": "匿名でのリクエスト失礼します。\n\n●キャラクター\nアイドルマスターシンデレラガールズの櫻井桃華\n\n●シチュエーション\n・M字開脚、もしくは大股開きで座っていて、タイツ越しにオナニーしている\n・タイツは白タイツで、ランガードのような太い線あり\n・胸や太ももなどは盛らず、なるべく華奢な感じ\n・効果音や喘ぎ声あり\n・喘ぎ声に「おっ」「お゛っ」といったものはNG\n・