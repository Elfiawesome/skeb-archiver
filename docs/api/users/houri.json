9-bb62-1eb436d8d764?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9161e1c66f52ffcc44448031d8a8cd70 3x", "genre": "art", "nsfw": false, "body": "平成版のヤッターマン1号のコスプレした霧雨魔理沙とヤッターマン2号のコスプレした博麗霊夢です。霧雨魔理沙は赤い仮面で博麗霊夢は紫色の仮面を装備しています。", "created_at": "", "completed_at": ""}, {"path": "/@houri/works/145", "thumbnail_src": "https://si.imgix.net/9256d513/uploads/origins/5dc2935f-ebf6-4c90-8c67-37d98aa14b06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4278f59aa52f4a2d7875aaac3c7230d3", "thumbnail_srcset": "https://si.imgix.net/9256d513/uploads/origins/5dc2935f-ebf6-4c90-8c67-37d98aa14b06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4278f59aa52f4a2d7875aaac3c7230d3, https://si.imgix.net/9256d513/uploads/origins/5dc2935f-ebf6-4c90-8c67-37d98aa14b06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aef300ef46cac47cb67c92f75fbffa64 2x, https://si.imgix.net/9256d513/uploads/origins/5dc2935f-ebf6-4c90-8c67-37d98aa14b06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=031a7f946024d8bdb0def6e23b7b0a95 3x", "genre": "art", "nsfw": false, "body": "アピールありがとう！ぜひ描いてほしいな～ YouTubeのコンテンツにも使わせてもらうかも！あなたが一番似合うと思うものを自由に描いてください！参考のリンクは僕のビデオでの使い方の一例で、僕のYTページには他にも僕のキャラクターの参考例があるよ！\n\nhttps://youtu.be/JWPJypLmmTI", "created_at": "", "completed_at": ""}, {"path": "/@houri/works/144", "thumbnail_src": "https://si.imgix.net/5c18d7e4/uploads/outputs/929a4bb8-0d63-4ef6-bbca-78c698ba09d3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8d36a3a1ec739f01ffaed9aa17951c13", "thumbnail_srcset": "https://si.imgix.net/5c18d7e4/uploads/outputs/929a4bb8-0d63-4ef6-bbca-78c698ba09d3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8d36a3a1ec739f01ffaed9aa17951c13, https://si.imgix.net/5c18d7e4/uploads/outputs/929a4bb8-0d63-4ef6-bbca-78c698ba09d3?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ad1a95e277bbd8112078a09ede1babc 