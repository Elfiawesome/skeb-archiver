できない)\n一斉射精(巻き付いてる触手の先端からも)\nぐったり(触手が苗床にするため動き出す)\n苗床になってEND(資料の苗床のようなポーズで触手増し増しで)(半透明で卵の入った産卵管が欲しいです)\n\n・できるだけ希望\n基本あまり動かさなくていいですが、できるなら抵抗する動き等をお願いします\n途中で触手による責めの差分(電流・搾乳・腹ボコ等)\n\nアルまどの造形も細かく要望・差分等も膨大になりますが、\nどうかよろしくお願いします。\n\nhttps://www.dropbox.com/sh/5p6op49imy0x0le/AAAE8r6yO8DBpaSYOyfY3Iupa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@denkiyadokari/works/12", "thumbnail_src": "https://si.imgix.net/18d4d8c0/requests/97665_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32a7af34d0c6a8aeb4c0deb4c677ee19", "thumbnail_srcset": "https://si.imgix.net/18d4d8c0/requests/97665_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32a7af34d0c6a8aeb4c0deb4c677ee19, https://si.imgix.net/18d4d8c0/requests/97665_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0b2cf19bed1d6d8f2e1abbb1c473f67 2x, https://si.imgix.net/18d4d8c0/requests/97665_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd1badbc497399779dfa56877066dd58 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@denkiyadokari/works/11", "thumbnail_src": "https://si.imgix.net/07912f39/requests/91777_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4a94bddf2ee2c3f5ef9a6be4c92e450", "thumbnail_srcset": "https://si.imgix.net/07912f39/requests/91777_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4a94bddf2ee2c3f5ef9a6be4c92e450, https://si.imgix.net/07912f39/requests/91777_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c