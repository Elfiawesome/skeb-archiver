.net/0217d26c/uploads/origins/353c7d55-6db6-4cf3-b1a1-abaa52e520cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b962e3fee4a7bc8d1e715d619e6e6768", "thumbnail_srcset": "https://si.imgix.net/0217d26c/uploads/origins/353c7d55-6db6-4cf3-b1a1-abaa52e520cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b962e3fee4a7bc8d1e715d619e6e6768, https://si.imgix.net/0217d26c/uploads/origins/353c7d55-6db6-4cf3-b1a1-abaa52e520cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f809850597d9fc7b56aff49a7631bb52 2x, https://si.imgix.net/0217d26c/uploads/origins/353c7d55-6db6-4cf3-b1a1-abaa52e520cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=615a55bdb430559492ff384c1d1bb385 3x", "genre": "art", "nsfw": false, "body": "新年おめでとうございます\n\n私のOCに全身画を描いていただきたいのですが\n\n姿勢は自由で、かっこいいものでもかわいいものでもいいです。\n\n衣装は【戦服2.0】を参考に\n\nありがとう~\n\nhttps://drive.google.com/drive/folders/1ALmTyjfeovK-4NYiMx_ZZo_OjWRsiJ9r?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@7_tamakibi_21/works/2", "thumbnail_src": "https://si.imgix.net/683c4536/uploads/origins/8ae5dbed-b1db-4432-9e5e-db37f425d647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4eee5191eb510b9bb8e733069dd897", "thumbnail_srcset": "https://si.imgix.net/683c4536/uploads/origins/8ae5dbed-b1db-4432-9e5e-db37f425d647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4eee5191eb510b9bb8e733069dd897, https://si.imgix.net/683c4536/uploads/origins/8ae5dbed-b1db-4432-9e5e-db37f425d647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0036df5db227fe15d7ecfd0e0ea44acf 2x, https://si.imgix.net/683c4536/uploads/origins/8ae5dbed-b1db-4432-9e5e-db37f425d647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=551c713ed5c8d24743fa3a1e5bb5273d 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のキャラクター \"Shoto \"を依頼したいと思います。彼は人間のローグまたはアサシンです。彼は冒険者のギルドのリーダーでもあり、ショトは悪魔を嫌っています。魔物退治の専門家でもあります。普段はとても冷たくストイックな外見をしていますが、実は内面はとても柔らかく、すぐに恥ずかしくなってしまうのです。たまにツンデレになることもありますが、基本的にはおっとりしています。包丁を持って可愛くポーズをとったり、パンケーキを食べている姿を描いていただけますか？クールでもキュートでも構いません。それでは、よろしくお願いします。\n\nhttps://imgur.com/a/kYm3YmM", "created_at": "", "completed_at": ""}, {"path": "/@7_tamakibi_21/works/1", "thumbnail_src": "https://si.imgix.net/aa1ffcad/uploads/origins/5463c31b-f24e-4957-bc1c-55bbb382bfec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43f44add3f5cec2c1452200021177f28", "thumbnail_srcset": "https://si.imgix.net/aa1ffcad/uploads/origins/5463c31b-f24e-4957-bc1c-55bbb382bfec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43f44add3f5cec2c1452200021177f28, https://si.imgix.net/aa1ffcad/uploads/origins/5463c31b-f24e-4957-bc1c-55bbb382bfec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31923deb055e141d10e72552f69bba71 2x, https://si.imgix.net/aa1ffcad/uploads/origins/5463c31b-f24e-4957-bc1c-55bbb382bfec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7231b23ffea361b7c6edd5fddd4e7c0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Alejandroです。vtuberモデルのCy Yuさんの作品を依頼したいと思っています。私は彼が宇宙に横たわっているような、海のようなものを想像していました。\n\nありがとうございます。完成品を楽しみにしています。)\n\nhttps://drive.google.com/drive/folders/1JSg1n_xNzvEHPmf4_tBYuMPisk4zhXnI?usp=sharing", "created_at": "", "completed_at": ""}]}