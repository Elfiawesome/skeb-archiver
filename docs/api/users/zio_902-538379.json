op=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3927193979fbcca4838bea18bf058849 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/10", "thumbnail_src": "https://si.imgix.net/96e3672f/uploads/origins/bd527b0e-d152-48d7-8da8-c7c1abc18fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72b2e5b0badef3e1e432b76a67b68922", "thumbnail_srcset": "https://si.imgix.net/96e3672f/uploads/origins/bd527b0e-d152-48d7-8da8-c7c1abc18fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72b2e5b0badef3e1e432b76a67b68922, https://si.imgix.net/96e3672f/uploads/origins/bd527b0e-d152-48d7-8da8-c7c1abc18fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8be4ef7b6994f41606a79c9f8bf1ba17 2x, https://si.imgix.net/96e3672f/uploads/origins/bd527b0e-d152-48d7-8da8-c7c1abc18fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1978d48a4967707e940285f5aa639483 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nブレイヴガールレイヴンズのファンアートを描いてくれませんか？\nアルフェニアがアルヴェイラの尻尾を持ってぐるぐると回り、\nそれを空に向かってぶん投げるところです\nシチュエーションはなんやかんやあってアルヴェイラがアルフェニアを怒らせてしまい、\nその結果…です。二人の服装はお任せします。\n可能なら吹き出しで怒っているアルフェニアと目がぐるぐる状態になっているアルヴェイラも描いてください\nよろしくお願いします\n\nアルヴェイラ - ブレイヴガール レイヴンズ 攻略2代目 Wiki https://bravegirl2.wiki.fc2.com/wiki/%E3%82%A2%E3%83%AB%E3%83%B4%E3%82%A7%E3%82%A4%E3%83%A9\nアルフェニア - ブレイヴガール レイヴンズ 攻略2代目 Wiki https://bravegirl2.wiki.fc2.com/wiki/%E3%82%A2%E3%83%AB%E3%83%95%E3%82%A7%E3%83%8B%E3%82%A2", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/9", "thumbnail_src": "https://si.imgix.net/6cea5922/uploads/origins/202e01e3-f982-49d4-b694-b4036677fd85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=611bc6b8939790fe52cc87a5a861b3a4", "thumbnail_srcset": "https://si.imgix.net/6cea5922/uploads/origins/202e01e3-f982-49d4-b694-b4036677fd85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=611bc6b8939790fe52cc87a5a861b3a4, https://si.imgix.net/6cea5922/uploads/origins/202e01e3-f982-49d4-b694-b4036677fd85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd94fb1026a12fbbf77c56dd65ffe96b 2x, https://si.imgix.net/6cea5922/uploads/origins/202e01e3-f982-49d4-b694-b4036677fd85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdfc82644925f1c9f6c8f87c2b49f241 3x", "genre": "art", "nsfw": false, "body": "ブレイヴガールレイヴンズのリゼットをお願いします\n・新妻リゼット\n・エプロン姿、左薬指に指輪あり\n・エプロンの下は新装衣装でお願いします。変更可。裸エプロン不可！\n・左後ろを振り返り、柔らかく微笑んでくれている\n・朝食を作っている感じで\n・画面端にアレット、シャーロット、ネイキスのぬいぐるみがあると点数高いです\n・印刷して額縁に飾れるくらいの大きさで\n\n以上でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/8", "thumbnail_src": "https://si.imgix.net/71f2ed98/uploads/origins/d65b00ab-e2ad-46a1-9065-14199dcf8ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9da09b8b90c1aa948b948f1c6625c312", "thumbnail_srcset": "https://si.imgix.net/71f2ed98/uploads/origins/d65b00ab-e2ad-46a1-9065-14199dcf8ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9da09b8b90c1aa948b948f1c6625c312, https://si.imgix.net/71f2ed98/uploads/origins/d65b00ab-e2ad-46a1-9065-14199dcf8ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a2cae78edb29261d57cbbdfd10d21ae 2x, https://si.imgix.net/71f2ed98/uploads/origins/d65b00ab-e2ad-46a1-9065-14199dcf8ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d619c84e542b27217ad9271285b4093 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nブレイヴガールレイヴンズのファンアートを希望します\nルルエラ様とリリウムのバニーガール姿がぜひ見たいです\nリリウムはノリノリの表情で、ルルエラ様は恥ずかしくて赤面しているイメージです\n背景はカジノを希望します\nよろしくお願いします\n\nブレガwikiのリリウム\nhttps://bravegirl2.wiki.fc2.com/wiki/%E3%83%AA%E3%83%AA%E3%82%A6%E3%83%A0 \nルルエラ様\nhttps://bravegirl2.wiki.fc2.com/wiki/%E3%83%AB%E3%83%AB%E3%82%A8%E3%83%A9", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/7", "thumbnail_src": "https://si.imgix.net/641ee082/uploads/origins/43f838d0-69ab-4090-a560-78ff67a2c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2773ce479dc76222b5826e590dab775d", "thumbnail_srcset": "https://si.imgix.net/641ee082/uploads/origins/43f838d0-69ab-4090-a560-78ff67a2c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2773ce479dc76222b5826e590dab775d, https://si.imgix.net/641ee082/uploads/origins/43f838d0-69ab-4090-a560-78ff67a2c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=855c37f5446cd8eca9ad8425e2095bd2 2x, https://si.imgix.net/641ee082/uploads/origins/43f838d0-69ab-4090-a560-78ff67a2c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b839f4fd1b4d384366a823186cb435ee 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します\n\nジオさんのオリジナルキャラクターのリィズさんをお願いします。状況やシチュエーションはお任せします\n\nご検討をよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/6", "thumbnail_src": "https://si.imgix.net/c52db08c/uploads/origins/d8114742-d76e-428b-9844-fd8f878b1618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7871ca3545ddc124f29e683d4c2691ee", "thumbnail_srcset": "https://si.imgix.net/c52db08c/uploads/origins/d8114742-d76e-428b-9844-fd8f878b1618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7871ca3545ddc124f29e683d4c2691ee, https://si.imgix.net/c52db08c/uploads/origins/d8114742-d76e-428b-9844-fd8f878b1618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09c1f60740486f7194c9425c48280ae1 2x, https://si.imgix.net/c52db08c/uploads/origins/d8114742-d76e-428b-9844-fd8f878b1618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8017cdcb6d498503371004032006363 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n前回のブレイヴガールレイヴンズのイラストがとてもよかったので依頼をします\n飛び蹴り（ライダーキック）のモーションのアルフェニアが見たいです。\nシチュエーションは水着アルヴェイラのシナリオであった、\nアルヴェイラが初めて島に来た時に住民からの助け要求でアルフェニアが攻撃を行い、回避したため島の4分の1が吹き飛んだシーンです。\nアルヴェイラは後ろ頭、または描かれなくてもいいです。\nよろしくお願いします\n\nブレガwikiのアルフェニア\nhttps://bravegirl2.wiki.fc2.com/wiki/%E3%82%A2%E3%83%AB%E3%83%95%E3%82%A7%E3%83%8B%E3%82%A2 \nアルヴェイラ\nhttps://bravegirl2.wiki.fc2.com/wiki/%E3%82%A2%E3%83%AB%E3%83%B4%E3%82%A7%E3%82%A4%E3%83%A9 \nアルフェニアの攻撃SD\nhttps://twitter.com/White4232/status/958744285603536897?s=20&t=XRsGkre3RsYraLPCQ_OYLQ", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/5", "thumbnail_src": "https://si.imgix.net/98985922/uploads/origins/ff5d9508-2374-43fb-8363-eecc83a96eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9a30bdad0e241828463fbea97e1f498", "thumbnail_srcset": "https://si.imgix.net/98985922/uploads/origins/ff5d9508-2374-43fb-8363-eecc83a96eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9a30bdad0e241828463fbea97e1f498, https://si.imgix.net/98985922/uploads/origins/ff5d9508-2374-43fb-8363-eecc83a96eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5ec9e4f1fba5a9e835efb5a84ea67f7 2x, https://si.imgix.net/98985922/uploads/origins/ff5d9508-2374-43fb-8363-eecc83a96eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c19e12ed1e7547f770cb38b9d3feadc3 3x", "genre": "art", "nsfw": false, "body": "アクスタになりそうなSDイラストをお願いします！\n\n・描いて欲しいSD\n以前ツイッターで掲載していた「カフェルーデシア」のルーデシア（「ブレイヴガールレイヴンズ」）\n衣装などは元ツイのものに拘らず任意にアレンジしても構いません。\n\n・表情・ポーズなど\n？？を頭に浮かべている（？のバリエーションはお任せします）。\n涙目などの辛い表情ではなく、明るくとぼけた感じ・コミカルな感じが出てるものを希望します。\n\n条件が見合わないようでしたら無視して頂ければと思います。\n以上、ご検討よろしくお願いいたします。\n\nhttps://twitter.com/zio_902/status/1467552546122506241", "created_at": "", "completed_at": ""}, {"path": "/@zio_902/works/4", "thumbnail_src": "https://si.imgix.net/f843de18/uploads/origins/45bed04d-f046-431a-9707-4b06dec78dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b54d645a7daa60d40dd37152d1323e", "thumbnail_srcset": "https://si.imgix.net/f8