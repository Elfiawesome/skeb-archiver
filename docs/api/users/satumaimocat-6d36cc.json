ess&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bec2cadfa834cc76ff4136dc997c9ef", "thumbnail_srcset": "https://si.imgix.net/c25c3dee/uploads/origins/58cee61f-6f67-4c07-aa5a-53eef6d29680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bec2cadfa834cc76ff4136dc997c9ef, https://si.imgix.net/c25c3dee/uploads/origins/58cee61f-6f67-4c07-aa5a-53eef6d29680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51e276123a8c25faf378558f83453d7a 2x, https://si.imgix.net/c25c3dee/uploads/origins/58cee61f-6f67-4c07-aa5a-53eef6d29680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7222377c871acb3efb43718df7c94f3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@satumaimocat/works/217", "thumbnail_src": "https://si.imgix.net/9121447d/uploads/origins/a1016d6b-756c-4b19-8cac-b47352da5b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168bf0bcabfb71ef25f425a61710aa7f", "thumbnail_srcset": "https://si.imgix.net/9121447d/uploads/origins/a1016d6b-756c-4b19-8cac-b47352da5b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168bf0bcabfb71ef25f425a61710aa7f, https://si.imgix.net/9121447d/uploads/origins/a1016d6b-756c-4b19-8cac-b47352da5b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87ec4d081fdd08c18dbdafa13fb2c68c 2x, https://si.imgix.net/9121447d/uploads/origins/a1016d6b-756c-4b19-8cac-b47352da5b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08769f1f40f9d9f7e32f29d0ecab5250 3x", "genre": "art", "nsfw": true, "body": "初めまして！Xやskebでたくさん丸呑みイラストを描かれているのを拝見してリクエストさせていただきました。\nモンスターハンターワイルズにてチャタカブラに丸呑みされるマイハンターをお願いしたいです。\n\n【内容】\n通常個体よりも段違いに大きなチャタカブラのフィジカル任せな舌攻撃でハンターを盾ごとすくい上げられてしまったハンター。\n予想外の行動とパワーに押し負け、思わず武器から手を離してしまったハンターは粘着性のある大舌に身体を持っていかれ、チャタカブラの口の中に閉じ込められてしまう。\nチャタカブラの狭い口内で、分厚くベトベトした舌に包み込まれるように揉みくちゃにされるハンター。武器も無ければスリンガー弾を撃つ余裕も無い。救助が来るまで奥まで呑み込まれないことを祈りつつ、ただひたすら耐えるしかなかった…みたいなイメージでお願いします。\n\n具体的な構図や背景等はお任せします。\n難しければ武器も最初から持っていなくて大丈夫です。\n\n【ハンター&チャタカブラの参考資料】\nhttps://imgur.com/a/QcM7jRQ\n細かいところまでデザインの再現ができなくても大丈夫です。\n分からない部分は省略・簡略化してください。\nチャタカブラがタル爆弾を食べようとするモーションの動画も用意しましたので参考程度にどうぞ。\n\n情報不足等ありましたら申し訳ないですが、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@satumaimocat/works/216", "thumbnail_src": "https://si.imgix.net/4b649315/uploads/origins/e11b8be4-5fc0-487a-9987-438fd13b146d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1316b95df3b0e973eb504949e598a46", "thumbnail_srcset": "https://si.imgix.net/4b649315/uploads/origins/e11b8be4-5fc0-487a-9987-438fd13b146d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1316b95df3b0e973eb504949e598a46, https://si.imgix.net/4b649315/uploads/origins/e11b8be4-5fc0-487a-9987-438fd13b146d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7f68c27336932bd09b3e418f81c0e91 2x, https://si.imgix.net/4b649315/uploads/origins/e11b8be4-5fc0-487a-9987-438fd13b146d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3883e2a6386fafe4756f6ad0cc06b81 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, 