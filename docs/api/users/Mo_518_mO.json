=30&txt=PRIVATE&s=66f22d47ba9cf1b6abd33d768420a5f3, https://si.imgix.net/82a46309/uploads/origins/d20a2d31-4a58-4d0c-b72c-a42d00779e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=600cbc33c21fdc631b4ba8634d7b035e 2x, https://si.imgix.net/82a46309/uploads/origins/d20a2d31-4a58-4d0c-b72c-a42d00779e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16cdd4023e981318cb5d13fcf0899613 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mo_518_mO/works/1322", "thumbnail_src": "https://si.imgix.net/5dae6e77/uploads/origins/ab753ec5-4c77-4961-a0a7-2562d1e6a5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc90662d4f69783fbaceed2fe736829e", "thumbnail_srcset": "https://si.imgix.net/5dae6e77/uploads/origins/ab753ec5-4c77-4961-a0a7-2562d1e6a5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc90662d4f69783fbaceed2fe736829e, https://si.imgix.net/5dae6e77/uploads/origins/ab753ec5-4c77-4961-a0a7-2562d1e6a5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61d133f1b7e86647f97b700e8956f2f1 2x, https://si.imgix.net/5dae6e77/uploads/origins/ab753ec5-4c77-4961-a0a7-2562d1e6a5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b110c03bc8acc9419d447806d7dfc92a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートはとてもキュートですね。私のVTuberのTwitchスタンプをいくつか注文したいです。\n\n1.両手を上げて笑っている。スタンプの上の部分に英字の「W」を一文字入れてください。\n2.泣いている、口を尖らせている\n3.いたずらっぽい微笑み。こちらの「ばかめ」スタンプに似ているが、もっとにやけてる→https://skeb.jp/@Mo_518_mO/works/1201\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1e7jgix0vkNNX8kEJuev0tKSzwuTKH18a?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mo_518_mO/works/1321", "thumbnail_src": "https://si.imgix.net/b81f9d4e/uploads/outputs/aee18555-eace-4495-a201-fec0e4a167e3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=bd83f028ab699580476b98b977ea9d43", "thumbnail_srcset": "https://si.imgix.net/b81f9d4e/uploads/outputs/aee18555-eace-4495-a201-fec0e4a167e3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=bd83f028ab699580476b98b977ea9d43, https://si.imgix.net/b81f9d4e/uploads/outputs/aee18555-eace-4495-a201-fec0e4a167e3?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d6224f99371ae219f6c97e67e2dbd33 2x, https://si.imgix.net/b81f9d4e/uploads/outputs/aee18555-eace-4495-a201-fec0e4a167e3?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c38224652a235277baad0d3913178c7 3x", "genre": "video", "nsfw": false, "body": "こんにちは！\n\nあなたのトランジション動画を見ましたが、とても可愛らしいです。Twitchでの配信中に使用できるトランジション動画の制作を依頼したいです。\n\n私のVTuberキャラクターは三毛猫です！現在はゲームをしてはスナックを要求する生活を送っています。遊び好きでいたずらっ子です。怖がりですが、ホラーゲームが大好きです。 \n\nhttps://skeb.jp/@Mo_518_mO/works/1302 と https://skeb.jp/@Mo_518_mO/works/1239 が本当に大好きです。同じような終わり方のトランジションを作ってくださったら、とても嬉しいです。\n\n参考画像の中から衣装や髪型は自由に選んでいただいて構いませんが、猫耳・メガネ・額の模様は必ず残してください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16bN8RnmZx8lXrv4PbJyljgno4VVRSRKU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Mo_518_mO/works/1320", "thumbnail_src": "https://si.imgix.net/1e42898b/uploads/origins/6d03b80c-d990-44a1-8cce-080f3b6c4afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b5d06e25364e8bf451edcb8de4ae7d", "thumbnail_srcset": "https://si.imgix.net/1e42898b/uploads/origins/6d03b80c-d990-44a1-8cce-080f3b6c4afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b5d06e25364e8bf451edcb8de4ae7d, https://si.imgix.net/1e42898b/uploads/origins/6d03b80c-d990-44a1-8cce-080f3b6c4afb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f22760eb2911d84bfe44acd907e2e769 2x, https://si.imgix.net/1e42898b/uploads/origins/6d03b80c-d990-44a1-8cce-080f3b6c4afb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2315f5499bae408ad2e0990e160d23a9 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！あなたの絵がとても好きで、私のフェレットのOCのために3/4向きのPNGTuberをやってほしいです！キャラクターのリファレンスとポーズ（もっと明るい表情で）を送りました。口を開けているバージョンと閉じているバージョンをお願いします！\n\nhttps://drive.google.com/drive/folders/1WP2d8rCZ4fl4G6IiRdG_Dqy_4X-fQIAr", "created_at": "", "completed_at": ""}, {"path": "/@Mo_518_mO/works/1319", "thumbnail_src": "https://si.imgix.net/a31f6df9/uploads/origins/27975310-899d-48b3-954d-42b27be56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d04480046dfd12e1200e9ded7913ef1", "thumbnail_srcset": "https://si.imgix.net/a31f6df9/uploads/origins/27975310-899d-48b3-954d-42b27be56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d04480046dfd12e1200e9ded7913ef1, https://si.imgix.net/a31f6df9/uploads/origins/27975310-899d-48b3-954d-42b27be56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48851c7911ea0ade19d646e96d17ad43 2x, https://si.imgix.net/a31f6df9/uploads/origins/27975310-899d-48b3-954d-42b27be56b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42c375afef6f8af319bc82086cbd518c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、サイクロプスのキャラクターPaixのエモートを5つ欲しいと思っています。主にDiscord用ですが、ソーシャルでも使用します。\n\n1.疲労困憊\n2.クレジットカードで興奮している\n3.非常に不審な横目\n4.おもちゃのハンマーで頭を叩かれる\n5.もう片方の手で帽子を傾けながら花を差し出す。\n\nもっと高くする必要があれば、遠慮なく必要な金額に変更してください。\n\nhttps://drive.google.com/drive/u/1/folders/13yfqCzBQVRYPOZmcATOePadmQUsinXlK", "created_at": "", "completed_at": ""}, {"path": "/@Mo_518_mO/works/1318", "thumbnail_src": "https://si.imgix.net/148f9dc8/uploads/outputs/b9bcb5a8-8437-4063-a249-5c3f89eeee82?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=333e89c165589550a4a99459b6adf30a", "thumbnail_srcset": "https://si.imgix.net/148f9dc8/uploads/outputs/b9bcb5a8-8437-4063-a249-5c3f89eeee82?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=333e89c165589550a4a99459b6adf30a, https://si.imgix.net/148f9dc8/uploads/outputs/b9bcb5a8-8437-4063-a249-5c3f89eeee82?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb069807924e8ad912ff2829829e74db 2x, https://si.imgix.net/148f9dc8/uploads/outputs/b9bcb5a8-8437-4063-a249-5c3f89eeee82?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfd92de2e02091a787ef4b332060a0ec 3x", "genre": "video", "nsfw": false, "body": "こんにちは！お元気でしょうか！私の友達がVTuberの友達を探しているので、プレゼント用にお願いしたいと思います！\n\n彼女はパステルクレヨンの猫で、一度に一つのストリームで人々の人生を彩ることを望んでいます！だから、彼女はとても陽気で、気立てがよくて、幸せです！\n\nトランジションのアニメーションのアイデアとしては、彼女がクレヨンで何かを描いている最中に飛び出してきて、観客を見上げ、微笑み、そしてトランジションは彼女がクレヨンでスクリーンを横切って描いているようにしたい！もしこれが複雑すぎて実現できなくても、心配はいらない！あなたが思い描く、もっと簡単にできそうなことなら、何でも大丈夫です。\n\nご検討、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1xm9Ji62z8klcFg5MOiaehsK9DO073vpI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Mo_518_mO/works/1317", "thumbnail_src": "https://si.imgix.net/f18a7d89/uploads/origins/b414747d-0856-42de-94d2-4243327b1b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8fd292cefbfda20fbafcf9e740fabd7", "thumbnail_srcset": "https://si.imgix.net/f18a7d89/uploads/origins/b414747d-0856-42de-94d2-4243327b1b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8fd292cefbfda20fbafcf9e740fabd7, https://si.imgix.net/f18a7d89/uploads/origins/b414747d-0856-42de-94d2-4243327b1b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36a74222f298f263add885a7d98c893a 2x, https://si.imgix.net/f18a7d89/uploads/origins/b414747d-0856-42de-94d2-4243327b1b2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=653c66059527004fa1ff2ad2d45b87fa 3x", "genre": "art", "nsfw": false, "body": "むしむし様、初めまして。\nVtuber活動を行っている鹿乃神フォンと申します。\n\n色々なサイトで作品を閲覧させていただき、是非\nむしむし様に普段着（黒い服）の方の僕をたくさん\n描いていただきたいと思いご依頼をさせていただきま