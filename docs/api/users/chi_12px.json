be1-c08c-4822-a093-6dad5c46172c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7429eb59082253a17adbdb1e1ff0f83e, https://si.imgix.net/d3d063ca/uploads/origins/b83d3be1-c08c-4822-a093-6dad5c46172c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48ae8a67f787b6d6e664add5ee432746 2x, https://si.imgix.net/d3d063ca/uploads/origins/b83d3be1-c08c-4822-a093-6dad5c46172c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94ed5fb62ab33243956a61ba16839659 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chi_12px/works/193", "thumbnail_src": "https://si.imgix.net/be3e4346/uploads/origins/416b9799-9fba-43f2-9b33-ff6a66ad0173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a5ba36943adc573c54a17c2172592b", "thumbnail_srcset": "https://si.imgix.net/be3e4346/uploads/origins/416b9799-9fba-43f2-9b33-ff6a66ad0173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a5ba36943adc573c54a17c2172592b, https://si.imgix.net/be3e4346/uploads/origins/416b9799-9fba-43f2-9b33-ff6a66ad0173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7b0f8c8a2daf1c99642c837751b33ff 2x, https://si.imgix.net/be3e4346/uploads/origins/416b9799-9fba-43f2-9b33-ff6a66ad0173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b766f55998d04a0cfd45b6d45baacf66 3x", "genre": "comic", "nsfw": false, "body": "ちやこさまこんばんは、前回も素敵なイラストありがとうございました！\n前回の納品も本当に嬉しかったです！部下女性が本当に本当にかわいくて、見るたびに嬉しくなっています。\n描いていただいた内容もかなり本人たちの現状に近くて、友人とはしゃいでおりました。\nこの度はまたぜひ前回と同じOCたちを描いていただけないだろうかと思い、ご連絡させていただきました。\n\n以下に依頼内容を記載いたしますので、ご検討いただけますでしょうか。\n金額に見合わないなど、受付不可でしたらお手数ですが再送要請やキャンセルいただけますと幸いです。\nご縁がありましたら、よろしくお願いいたします。\n\n*納品いただいたイラストは、個人利用の範囲内で①アイコン／ヘッダー使用、②ネットプリント印刷・グッズ製作、③TRPGを遊ぶ際の立ち絵、④他の方への依頼の際に資料として提示などさせていただく可能性がございます。\n\nーーーーーーーーーー\n\n《依頼詳細》\n・刑事として働く、上司・部下の関係にある男女のイラスト\n・下記をお願いしたいです。両方は難しいと思うので、いずれかお願いできますと幸いです。\n　①前回納品いただいた絵の左下のコマor右下のコマor任意の内容を含むコミック\n　②前回納品いただいた絵の左下のコマで着ている私服or任意の私服の全身立ち絵（カラーでお願いできると嬉しいです)\n・2人は現状交際しているわけではありませんが、お互いを大切に想い合う関係で、いわゆる”以上未満”の状況です。\n※毎日上司の車で送り迎えしていたり、家に泊まったことがあったり、休日も一緒に買い物に出かけたりしています。抱きしめる・頭を撫でるなどもしたことがあります。恋仲ではないものの、上司部下の関係からはかなり逸脱しています…\n・納品時、お手数ですが人物単体の透過psdデータもお願いできますと幸いです。\n\n《キャラクター設定》\n◆上司男性\n身長等：身長184cm。整った顔立ちで、体格もよい。喫煙者。\n年　齢：32歳\n性　格：表情や立ち振る舞いなど外見に自信が表れており、頼りになる印象。お人好しで世話焼きな面もある。部下女性を特別に思っており、大事にしている。いわゆるセコム、保護者。朴念仁。一人称は「俺」、部下女性のことを「桂木(かつらぎ)」と呼ぶ。\n\n◆部下女性\n身長等：身長160cm。豊満な体型。顔は美人というよりも可愛らしい印象。雨女。\n年　齢：25歳\n性　格：気弱でおとなしい。まじめ。純朴で素直な面もある。無害そう／庇護欲を抱かれそうな印象。異性は苦手だが、上司男性に対してはかなり心を開いており、信頼している。上司男性に恋心を抱いているが、想いは秘めている。一人称は「わたし」、上司男性のことを「鷹生(たかお)さん」と呼ぶ。敬語で話す。\n\n会話サンプル(バレンタイン時期想定)\n「あの、鷹生さん。これよかったら…」\n「(異性が苦手なことを知っているので)…誰かの入れ知恵か？無理に用意しないでもよかったんだぞ」\n「ご迷惑でしたか？でも、いつもお世話になっているので…！」\n「いや、迷惑だなんて思ってはいないが。……ありがとう。桂木は甘いもの好きか？」\n\n▽前回依頼時の作品ページ\nhttps://skeb.jp/@chi_12px/works/118\n\nhttps://drive.google.com/drive/folders/10264em4bdpsEKmmwEBOyfPbHtyGjQXkv", "created_at": "", "completed_at": ""}, {"path": "/@chi_12px/works/192", "thumbnail_src": "https://si.imgix.net/e3db918c/uploads/origins/18192bda-c3a5-4324-bcef-c66118496b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1c39703d8bdf64668aec5e0a23a4ab6", "thumbnail_srcset": "https://si.imgix.net/e3db918c/uploads/origins/18192bda-c3a5-4324-bcef-c66118496b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1c39703d8bdf64668aec5e0a23a4ab6, https://si.imgix.net/e3db918c/uploads/origins/181