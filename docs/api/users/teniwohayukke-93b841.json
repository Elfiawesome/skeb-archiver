5781d33e8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd0606a2353c039c9970c4f733a3d1c1 2x, https://si.imgix.net/d342aeac/uploads/origins/e4030098-b541-46d0-a982-a5781d33e8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa693c81419bdccdfac8a3578c5f5293 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/20", "thumbnail_src": "https://si.imgix.net/85fccb2b/uploads/origins/28a8f621-e84b-4cd2-9ca7-267332ed1c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b0b4ab547febe9d98e7c08f09fa7b8", "thumbnail_srcset": "https://si.imgix.net/85fccb2b/uploads/origins/28a8f621-e84b-4cd2-9ca7-267332ed1c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b0b4ab547febe9d98e7c08f09fa7b8, https://si.imgix.net/85fccb2b/uploads/origins/28a8f621-e84b-4cd2-9ca7-267332ed1c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b06a62cfb9a5023ad47891ff62725ae 2x, https://si.imgix.net/85fccb2b/uploads/origins/28a8f621-e84b-4cd2-9ca7-267332ed1c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c43d9a1d8f7cd467bcd9ed5098d87557 3x", "genre": "art", "nsfw": false, "body": "はじめました！あなたのアートが大好きです！\nキャラクターは、不器用でかわいい月の猫の女の子です！彼女にはペットもいるのですが、そのペットの参考写真も載せました！\n\n月猫の女の子が赤いスポーツカーに座って、携帯電話のカメラの視点からペットの猫と自撮りしているような作品は可能でしょうか？月猫ちゃんもペットもとても幸せそうです！\n\nありがとうございました！\nhttps://drive.google.com/drive/folders/15b8lCht10fmJgQTUYLZyDK04CrZFelBZ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/19", "thumbnail_src": "https://si.imgix.net/1da36b38/uploads/origins/63a0ee98-1b51-4870-972f-9993c047d13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f22bb6d84f0c2b7313ea136b743e0ee", "thumbnail_srcset": "https://si.imgix.net/1da36b38/uploads/origins/63a0ee98-1b51-4870-972f-9993c047d13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f22bb6d84f0c2b7313ea136b743e0ee, https://si.imgix.net/1da36b38/uploads/origins/63a0ee98-1b51-4870-972f-9993c047d13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3085230c6661d84f299f4249a2ae8d8f 2x, https://si.imgix.net/1da36b38/uploads/origins/63a0ee98-1b51-4870-972f-9993c047d13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=420b2692f83f0e50b147e21eea21396b 3x", "genre": "art", "nsfw": false, "body": "Hello, my name is Remi and I'm a vtuber who streams video games on Twitch! I love video games! My character is a pink cyberpunk rabbit who is playful and cute. I'm like the little sister who likes cute things but is also a little tomboy and is bratty.\n\nI hope you can draw my character holding a game controller and playing video games in your art style!\n\nHere is my socials and character reference: https://remivespertine.carrd.co/\n\nMy twitter: https://twitter.com/RemiVespertine\n\nhttps://twitter.com/RemiVespertine", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/18", "thumbnail_src": "https://si.imgix.net/7da04f91/uploads/origins/a4386d59-9d6a-407a-8023-c75b24a1ae1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a24caf00f5604a6506ab06a53f9a753", "thumbnail_srcset": "https://si.imgix.net/7da04f91/uploads/origins/a4386d59-9d6a-407a-8023-c75b24a1ae1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a24caf00f5604a6506ab06a53f9a753, https://si.imgix.net/7da04f91/uploads/origins/a4386d59-9d6a-407a-8023-c75b24a1ae1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b772ed33b577b6b8fb5d2f613df2e1b9 2x, https://si.imgix.net/7da04f91/uploads/origins/a4386d59-9d6a-407a-8023-c75b24a1ae1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d506404dd7a6fdcce7dbfeb8b01232f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/17", "thumbnail_src": "https://si.imgix.net/22f7e032/uploads/origins/dbea158d-e755-4f39-abc5-d5b326483298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bc6d489f0b8446f891f1c0bf6ba3a50", "thumbnail_srcset": "https://si.imgix.net/22f7e032/uploads/origins/dbea158d-e755-4f39-abc5-d5b326483298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bc6d489f0b8446f891f1c0bf6ba3a50, https://si.imgix.net/22f7e032/uploads/origins/dbea158d-e755-4f39-abc5-d5b326483298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57d3e667b0dc62569ae11c2df776fe89 2x, https://si.imgix.net/22f7e032/uploads/origins/dbea158d-e755-4f39-abc5-d5b326483298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b02ddedee88ef99cded71d3a94ba567 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/16", "thumbnail_src": "https://si.imgix.net/34a3b30d/uploads/origins/c01f9e9e-e80d-4dca-93c7-899659cae08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=948593535b8918e3670f46b73583d7ce", "thumbnail_srcset": "https://si.imgix.net/34a3b30d/uploads/origins/c01f9e9e-e80d-4dca-93c7-899659cae08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=948593535b8918e3670f46b73583d7ce, https://si.imgix.net/34a3b30d/uploads/origins/c01f9e9e-e80d-4dca-93c7-899659cae08f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0ae91c57396ea7ea5ab2ff9f51f71be 2x, https://si.imgix.net/34a3b30d/uploads/origins/c01f9e9e-e80d-4dca-93c7-899659cae08f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dfad85b67b2a9ed37dbd6ff941a7146 3x", "genre": "art", "nsfw": false, "body": "Hello! I would like to commission art from you! I would like to get my OC drawn as a cop!\n\nReferences:\n1. My OC\n2. Pose/outfit/background reference\n\nI would like my OC (reference 1) to be drawn in the same pose and outfit as in reference 2. I like the background in reference 2, but if you want to change it you can! I would like my OC to look confident and smug in the art.\n\nImportant notes about my OC: She is a dog spirit. She has white diamond-shaped pupils. She does not need the mask on the side of her head in this art. She does not need the big ribbon or the bell at the bottom of her hair in this art. Any other changes are up to you.\n\nThank you!\n\nhttps://imgur.com/a/sVX18LW", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/15", "thumbnail_src": "https://si.imgix.net/ba3300bb/uploads/origins/760c8157-f589-4351-9eca-ec93f496984c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303c1705acee83fc2167bb826676da2d", "thumbnail_srcset": "https://si.imgix.net/ba3300bb/uploads/origins/760c8157-f589-4351-9eca-ec93f496984c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303c1705acee83fc2167bb826676da2d, https://si.imgix.net/ba3300bb/uploads/origins/760c8157-f589-4351-9eca-ec93f496984c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e38ffb0e04ce3968b8991de12e707348 2x, https://si.imgix.net/ba3300bb/uploads/origins/760c8157-f589-4351-9eca-ec93f496984c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcce975a2f4bf7e9a8db29a065e80923 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして、ファイヤーエムブレムエンゲージのスータルクの絵が欲しいのですが\nこの服を着てくれるのは、https://i.imgur.com/BKecFqg.png。\n弓矢を持つ。どんなポーズでもOKです。\n背景は赤い空です。\nご検討のほど、よろしくお願いいたします。\n\nhttps://i.imgur.com/BKecFqg.png", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/14", "thumbnail_src": "https://si.imgix.net/04517e28/uploads/origins/d4a4003a-e626-4fa2-9555-b3844a068ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=409c45d6296c69130945f5af53ddef23", "thumbnail_srcset": "https://si.imgix.net/04517e28/uploads/origins/d4a4003a-e626-4fa2-9555-b3844a068ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=409c45d6296c69130945f5af53ddef23, https://si.imgix.net/04517e28/uploads/origins/d4a4003a-e626-4fa2-9555-b3844a068ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db38bcf656fe2ced8f8ba37caf1bf23a 2x, https://si.imgix.net/04517e28/uploads/origins/d4a4003a-e626-4fa2-9555-b3844a068ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53dabbf95e172e691fce4f04808cdd77 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの芸術は信じられないほどです。私のVtuberモデルと私の友人のVtuberモデルでバレンタインの特別なシーンを作っていただけたら光栄です。私のモデル（Kris Nekomata）がギターを弾きながらマイクに向かって歌っているシーンで、私の友人のモデル（Gloom）もバレンタインデーコンサートでベースギターを弾きながら歌っているシーンを作っていただけたらと思います。Kris Nekomataは、優しく大胆で、冒険のエネルギーに満ち溢れているが、愛する人には思いやりがある。情熱的で神秘的、癒し系だけどパワフルなオーラを持つGloom。二人とも、お互いをサポートするために心を込めて歌い、観客が踊りたくなるような、そして愛し合えるような体験を作り出しているのです\n\n猫又クリス 参考：https://drive.google.com/file/d/144G1aedzeqCnAtiDcr9WyOrMi7jYEbvg/view?usp=sharing\n\nGloom 参考：https://drive.google.com/file/d/1nX6lMrL8g63b1gLXGb91ialyIl71A8Lp/view?usp=sharing\n\nhttp://www.gomoodboard.com/boards/AzxCpWtN/share", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/13", "thumbnail_src": "https://si.imgix.net/13ff36d1/uploads/origins/108e9e26-c9ad-4af8-926f-63e5377ba56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335ec87b5a25a098ddd6891c2bf36b70", "thumbnail_srcset": "https://si.imgix.net/13ff36d1/uploads/origins/108e9e26-c9ad-4af8-926f-63e5377ba56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335ec87b5a25a098ddd6891c2bf36b70, https://si.imgix.net/13ff36d1/uploads/origins/108e9e26-c9ad-4af8-926f-63e5377ba56e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1facc3f37ae6a9d4ac6e276f828a291 2x, https://si.imgix.net/13ff36d1/uploads/origins/108e9e26-c9ad-4af8-926f-63e5377ba56e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d448cb6b28b7acc4432dcb9c444bcbfb 3x", "genre": "art", "nsfw": false, "body": "Hello! Your art is so beautiful! Can you please draw me? I'm a crime boss Vtuber who loves heists, fast cars, and money. Can you please draw me either reclining on a large, fancy chair with my feet on a pile of money? Or please draw me as if I just completed a big heist. Whatever you feel comfortable or inspired to draw as long as it has a sexy and mischievous theme! Thank you so much! \n\nhttps://drive.google.com/drive/folders/1XJosS_MWLHKi9tdQr8GDP9pue4-PEM0G\n\nhttps://drive.google.com/drive/folders/1XJosS_MWLHKi9tdQr8GDP9pue4-PEM0G", "created_at": "", "completed_at": ""}, {"path": "/@teniwohayukke/works/12", "thumbnail_src": "https://si.imgix.net/2fa0f1e5/uploads/origins/7309b9b3-2ad4-4be4-834f-cd1c517bbb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9516fdaddc432a9945b9ba5f51b17a", "thumbnail_srcset": "https://si.imgix.net/2fa0f1e5/uploads/origins/7309b9b3-2ad4-4be4-834f-cd1c517bbb15?bg=%23fff&auto=f