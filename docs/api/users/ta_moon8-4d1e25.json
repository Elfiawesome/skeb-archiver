6-24bc-4999-aab6-be394424f7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474102d04b3b681b5c03bbde4c9d32c7", "thumbnail_srcset": "https://si.imgix.net/b94c9ec4/uploads/origins/e92b90d6-24bc-4999-aab6-be394424f7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474102d04b3b681b5c03bbde4c9d32c7, https://si.imgix.net/b94c9ec4/uploads/origins/e92b90d6-24bc-4999-aab6-be394424f7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccd279b68555b875775713991d5f67e5 2x, https://si.imgix.net/b94c9ec4/uploads/origins/e92b90d6-24bc-4999-aab6-be394424f7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8878ade6cf4625313ba1f85a9233f6ec 3x", "genre": "art", "nsfw": false, "body": "初めまして！イラストがとても好きで依頼させていただきました！！\nVRChatというゲームの僕とフレンドのアバターのイラストをお願いしたいです！\n紫の髪の子はしっかりものの先輩メイドで赤の目隠れの子はドジっ子後輩メイドでお仕事してる風景を描いて欲しいです！ぜひよろしくお願いします！！\n\nhttps://twitter.com/katuonotataki7/status/1516162397882355712?s=21&t=i4Ig6tc4Pw-L4BhDpB2HdA", "created_at": "", "completed_at": ""}, {"path": "/@ta_moon8/works/5", "thumbnail_src": "https://si.imgix.net/aa796dd7/uploads/origins/ee12c6b9-2acb-45c1-8eea-78e2bdd2691f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ec70dfa5be1f9687a0156bfaf06362", "thumbnail_srcset": "https://si.imgix.net/aa796dd7/uploads/origins/ee12c6b9-2acb-45c1-8eea-78e2bdd2691f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ec70dfa5be1f9687a0156bfaf06362, https://si.imgix.net/aa796dd7/uploads/origins/ee12c6b9-2acb-45c1-8eea-78e2bdd2691f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abad93a53d60a950a7fb402d41dc1ac9 2x, https://si.imgix.net/aa796dd7/uploads/origins/ee12c6b9-2acb-45c1-8eea-78e2bdd2691f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b45d2e6229b09ae8db73c9ce9a5490a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、もろこし先生。\n\n先生のアートスタイルがとても好きです。私とパートナーのFFXIVのキャラクターを一緒に描いていただけませんか？\n\nSai:内向的で恥ずかしがり屋のMiqo'teは、ブロンドの髪と水色の目をしています。左目の下にほくろがあります。\nクリス：外向的でのんびりしたMiqo'teで、白髪、ルビーレッドの目をしています。\n\n2人はお互いに愛し合っていて、何をするにも一緒です。笑顔がキュートな二人を近くに描いてほしいです。ポーズや背景は自由に決めてください。\n\n参考画像\nサイ： https://imgur.com/a/9grDkPy\nクリス： https://imgur.com/a/bZ5RDls\nFFXIVの猫耳の参考画像： https://imgur.com/a/oGyno8W", "created_at": "", "completed_at": ""}, {"path": "/@ta_moon8/works/4", "thumbnail_src": "https://si.imgix.net/53770c3f/uploads/origins/5f89c47c-1620-44cc-9ed9-1b2c9e2979d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24fe0d1e901b72a6d04dcf3c20186b19", "thumbnail_srcset": "https://si.imgix.net/53770c3f/uploads/origins/5f89c47c-1620-44cc-9ed9-1b2c9e2979d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24fe0d1e901b72a6d04dcf3c20186b19, https://si.imgix.net/53770c3f/uploads/origins/5f89c47c-1620-44cc-9ed9-1b2c9e2979d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66c3a18f012a63c8a8ee41ddee68e4b1 2x, https://si.imgix.net/53770c3f/uploads/origins/5f89c47c-1620-44cc-9ed9-1b2c9e2979d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aaef8167d9a58a9ead77cd8b5c58edf 3x", "genre": "art", "nsfw": false, "body": "もろこし様はじめまして、新着欄を見ていてとても魅力的な絵柄だったのでリクエストにこさせていただきました。\n私のオリキャラの絵を描いていただきたいです。\n用途→個人的に見て楽しむ、CMYKインクで印刷して飾る、それとpixivfactory様の方で個人用のグッズにいくつか印刷してもらうつもりです。(それと、SNSに「スケブで描いてもらった」と作者明記で画像をアップしたいです)\n資料が一方向からのデザインしかない拙いものですみません。↓\nhttps://twitter.com/odd_loading/status/1486115845495746561?t=TehERfrxVT-RtxG-P7zQUA&s=19\n\n希望する構図\n座ってたり寝そべってたり、ゆったりした印象があるものないいです。\nあと、右下あたりにも作者サインがあると嬉しいです\n\nサイズはできればA4あるいはA4と同じ比率をお願いしたいです\n\n不十分であれば断っていただいても大丈夫です。\n検討よろしくおねがいします。\n\nhttps://twitter.com/odd_loading/status/1486115845495746561?t=TehERfrxVT-RtxG-P7zQUA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@ta_moon8/works/3", "thumbnail_src": "https://si.imgix.net/a5546bde/uploads/origins/71d94a1d-801a-43ab-a27a-451c5746f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=239f83076cc22c48b6d40e42547ee3c4", "thumbnail_srcset": "https://si.imgix.net/a5546bde/uploads/origins/71d94a1d-801a-43ab-a27a-451c5746f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=239f83076cc22c48b6d40e42547ee3c4, https://si.imgix.net/a5546bde/uploads/origins/71d94a1d-801a-43ab-a27a-451c5746f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=433c3f609cb21390fbec6feaa0d3c9a4 2x, https://si.imgix.net/a5546bde/uploads/origins/71d94a1d-801a-43ab-a27a-451c5746f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f97c2f4017fd35e15a49d9d5ada35aad 3x", "genre": "art", "nsfw": false, "body": "はじめまして。ケイリと申します。先生の作品がとてもいいと思ったので、私のVTuber Su'Riをお願いします！ https://sta.sh/01vvk6a80jon\n\n表現、構図、服装など、先生にお任せしたいと思います。自由に描いてください。お忙しい中、ありがとうございました先生の作品を私のTwitch配信で表示したいのですが、クレジットは全て先生にお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ta_moon8/works/2", "thumbnail_src": "https://si.imgix.net/4da947a5/uploads/origins/99e6dd9c-cf42-4dfd-b019-8f98b34b36d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=643fa194f980290067d7b8d20a7244f5", "thumbnail_srcset": "https://si.imgix.net/4da947a5/uploads/origins/99e6dd9c-cf42-4dfd-b019-8f98b34b36d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=643fa194f980290067d7b8d20a7244f5, https://si.imgix.net/4da947a5/uploads/origins/99e6dd9c-cf42-4dfd-b019-8f98b34b36d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c695e654c0e09c8557f8bf5acf93d9b 2x, https://si.imgix.net/4da947a5/uploads/origins/99e6dd9c-cf42-4dfd-b019-8f98b34b36d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30c15aa2b4f721bbe8562f3142aa8940 3x", "genre": "art", "nsfw": false, "body": "はじめまして!\nTwitterで素敵なイラストを見かけたので依頼させていただきました\n依頼内容はVRChatで使用しているアバターになります\n\nアバターは①、②のどちらかお好きな方を選んでいただければOKです\n構図などはお任せします\n資料URLを記載してありますが、服装や髪型