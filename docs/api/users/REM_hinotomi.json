a44-4332-adfc-b02b144a7dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=575f403daf06580401f98fcad3e7122e", "thumbnail_srcset": "https://si.imgix.net/281ae7a8/uploads/origins/c81c44d1-7a44-4332-adfc-b02b144a7dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=575f403daf06580401f98fcad3e7122e, https://si.imgix.net/281ae7a8/uploads/origins/c81c44d1-7a44-4332-adfc-b02b144a7dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbdaacbb2857513daabfeafe44679367 2x, https://si.imgix.net/281ae7a8/uploads/origins/c81c44d1-7a44-4332-adfc-b02b144a7dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67701dcd0d3a632e023c1f78a7a4acf9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@REM_hinotomi/works/44", "thumbnail_src": "https://si.imgix.net/22ef3ea4/uploads/origins/e979bdc4-801f-4a2e-a369-4e5d77224f32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7679842bd52452d477d802dd2330cfe6", "thumbnail_srcset": "https://si.imgix.net/22ef3ea4/uploads/origins/e979bdc4-801f-4a2e-a369-4e5d77224f32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7679842bd52452d477d802dd2330cfe6, https://si.imgix.net/22ef3ea4/uploads/origins/e979bdc4-801f-4a2e-a369-4e5d77224f32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=825f80fbe44d1407551ba9c1ccd29f3a 2x, https://si.imgix.net/22ef3ea4/uploads/origins/e979bdc4-801f-4a2e-a369-4e5d77224f32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf9d5d08949161fcf8152ef194f58046 3x", "genre": "art", "nsfw": false, "body": "レムさま、はじめまして、\nレム様の絵がとても綺麗です！\n依頼したいのはオリジナルキャラクターですが、設定の中のいくつかは元素、性別、および職業の設定に関してしばらく完全にひっくり返ります。\n\nこれは近未来な人造人間Paroでの新設定です。\n\n性別：男女不明な感じでお願いします。\n\n身長：168 cm\n\n職業：ある組織が所属して、人造人間及び人体実験、薬物制作の科学者を研究しています。\n\n性格：気ままに行動していて、頭がちょっとおかしいように見えますが、実はIQの高い天才です。しかし、実験以外のことをすると、生活に関する能力基本は0です。気分はずっと高揚しています。一日中笑顔をしていますが、彼の考えが分かりません。実験しかできないと言われた気違いはとても嬉しいです。前の一秒は東に行って、次の一秒は西に行きたいです。興味があることに全身全霊を傾けて、飽きたら捨て去ってしまいます。\n\n服の特徴：頭のてっぺんにはいつもゴーグルが付いています。身につけている白い上着は、裾が完全に床に引きずられています。袖もとても大きくて手が見えません。だらしなく体にかけています。中に着ている服もだらけています。肌着は黒半襟のベストです。服全体のデザインはURL先に参考画像をおいております。。靴は機械みたいなデザインを希望しています。白を主な色として、ポイントいろはオレンジでお願いします。長さは膝までです。\n\n外形の特徴：男性ですが、生活能力が低いため、食事も乱れているので、体が薄く、髪型はウフルカットです。左の目は自分で作った義眼で、眼球の中に電流が流れているのが見えます。\n\n義眼について：何度も失敗した人造人間の実験をしてから、自分の目を次の生まれてくる人造人間の目に入れようと思って、こうしました。自分で機械の義眼を準備してから、手術して眼球を取り出して移植しました。\n\n全身が見れるようににしたいです！服のデザインなどはおまかせします。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/1TN3iY4MZyGlJ5FGWfEgIH2n9phjoPoEv", "created_at": "", "completed_at": ""}, {"path": "/@REM_hinotomi/works/43", "thumbnail_src": "https://si.imgix.net/b54e3786/uploads/origins/457a235c-faec-459f-a7be-fd5afcb39456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1e4ae839f863ae273d35eb7ad44f921", "thumbnail_srcset": "https://si.imgix.net/b54e3786/uploads/origins/457a235c-faec-459f-a7be-fd5afcb39456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1e4ae839f863ae273d35eb7ad44f921, https://si.imgix.net/b54e3786/uploads/origins/457a235c-faec-459f-a7be-fd5afcb39456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec033ab45cd270bbbd72b549584edd