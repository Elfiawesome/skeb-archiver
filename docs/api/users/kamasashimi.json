1f/uploads/origins/546094cd-7ef4-47ae-b577-a288c8e33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=493ef35aae0c18b563e3e64681bf674b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kamasashimi/works/13", "thumbnail_src": "https://si.imgix.net/5bf95b71/uploads/origins/e98417f4-170a-4cc3-a992-f1ff0b4dd786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e1e3eff689c5d483399677b28b3652", "thumbnail_srcset": "https://si.imgix.net/5bf95b71/uploads/origins/e98417f4-170a-4cc3-a992-f1ff0b4dd786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e1e3eff689c5d483399677b28b3652, https://si.imgix.net/5bf95b71/uploads/origins/e98417f4-170a-4cc3-a992-f1ff0b4dd786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ad85c0061e3431c6199f89a7a19e34b 2x, https://si.imgix.net/5bf95b71/uploads/origins/e98417f4-170a-4cc3-a992-f1ff0b4dd786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b131207e50e902871d15fd9730e15aaf 3x", "genre": "art", "nsfw": false, "body": "鎖鎌のお刺身定食さんの絵柄が個人的に好きなので、描いて欲しいイラストがあります。\nウマ娘のライスシャワーが前屈みになって服の中が見えてしまうイラストをお願いします。\n服装は勝負服でお願いします。\n内容は勝負服で走り終えた後、座ってるトレーナーに前屈みになって話してる時に、服の中が見えてしまう感じでお願いします。\n走った後なので、汗が顔や身体からダラダラと出てる感じでお願いします。\n台詞や表情はお任せします。\n出来ればでいいのですが、二枚目で服の中が見えちゃってるのがバレて赤面するライスもお願いします。\nどうか宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kamasashimi/works/12", "thumbnail_src": "https://si.imgix.net/7bbaab9d/uploads/origins/f1a25b85-4a5f-4beb-b3cc-26c75cb52a90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e5878f7bbb5b3e660e1213379d903f", "thumbnail_srcset": "https://si.imgix.net/7bbaab9d/uploads/origins/f1a25b85-4a5f-4beb-b3cc-26c75cb52a90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e5878f7bbb5b3e660e1