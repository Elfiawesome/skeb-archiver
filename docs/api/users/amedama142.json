その他、表情など細かいことはお任せします。\n\n機械翻訳はわかりやすかったでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@amedama142/works/3", "thumbnail_src": "https://si.imgix.net/cff33692/uploads/origins/01a9ba7f-975b-48a3-bce4-39e20e129555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69f499d213bbab14a826276b0694b1af", "thumbnail_srcset": "https://si.imgix.net/cff33692/uploads/origins/01a9ba7f-975b-48a3-bce4-39e20e129555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69f499d213bbab14a826276b0694b1af, https://si.imgix.net/cff33692/uploads/origins/01a9ba7f-975b-48a3-bce4-39e20e129555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7defc85249aa1d97b9bd8ea5b0301085 2x, https://si.imgix.net/cff33692/uploads/origins/01a9ba7f-975b-48a3-bce4-39e20e129555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddf8380ae49a1e3442e7f637d14e9dfa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amedama142/works/2", "thumbnail_src": "https://si.imgix.net/3acd3200/uploads/origins/a3ea7e84-5640-4ad5-ba60-25b5a9d6655f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b34096b47143597fb5bfd7bafbf2e4a", "thumbnail_srcset": "https://si.imgix.net/3acd3200/uploads/origins/a3ea7e84-5640-4ad5-ba60-25b5a9d6655f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b34096b47143597fb5bfd7bafbf2e4a, https://si.imgix.net/3acd3200/uploads/origins/a3ea7e84-5640-4ad5-ba60-25b5a9d6655f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h