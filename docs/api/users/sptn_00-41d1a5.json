%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70e2e7d24330ed0e9a3c5bf699593b3a 3x", "genre": "art", "nsfw": false, "body": "フォールアウトニューベガスのOCをこのポーズ（タバコなし、同じ表情）でお願いします https://lagooncompany.fandom.com/wiki/Revy?file=Revygun.png\nまた、代わりにこの銃を使う https://fallout.fandom.com/wiki/Plasma_Defender?file=PlasmaDefenderFNV.png\nシンプルな背景。", "created_at": "", "completed_at": ""}, {"path": "/@sptn_00/works/25", "thumbnail_src": "https://si.imgix.net/391c5171/uploads/origins/774234c8-2cd1-42c9-8899-af23c0d6b1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd6e8f0c42dc1178853a11e8ef7e8e6", "thumbnail_srcset": "https://si.imgix.net/391c5171/uploads/origins/774234c8-2cd1-42c9-8899-af23c0d6b1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd6e8f0c42dc1178853a11e8ef7e8e6, https://si.imgix.net/391c5171/uploads/origins/774234c8-2cd1-42c9-8899-af23c0d6b1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a209268eac574ea82cdf9e6edc0a4859 2x, https://si.imgix.net/391c5171/uploads/origins/774234c8-2cd1-42c9-8899-af23c0d6b1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c851669b106b4c31e6ae45c068cb3f9a 3x", "genre": "art", "nsfw": false, "body": "やあ！君のI-NOの描き方を見て、君から依頼を受けたいと思ったんだ！タワーレコードのI-NO（この改造に似ている！https://gamebanana.com/mods/373110）をあなたのスタイルで描いてほしい。ポージングは、正面から見て笑顔が素敵なものをお願いします。ちょっと変なリクエストかもしれませんが、腹筋があるバージョンとないバージョンを作ってもらえるとうれしいです！描き直しが必要になるかもしれないので、大変なことだとは思いますが、もし実現しないのであれば、それは承知しています。ありがとうございます！:)", "created_at": "", "completed_at": ""}, {"path": "/@sptn_00/works/24", "thumbnail_src": "https://si.imgix.net/116917b4/uploads/origins/3e4392f8-c754-4a04-9baa-39427e5670c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa72e161338cf380295082d3e19dd0f3", "thumbnail_srcset": "https://si.imgix.net/116917b4/uploads/origins/3e4392f8-c754-4a04-9baa-39427e5670c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa72e161338cf380295082d3e19dd0f3, https://si.imgix.net/116917b4/uploads/origins/3e4392f8-c754-4a04-9baa-39427e5670c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dda32f4cf32c1b0a6a3ca8a9f309c32 2x, https://si.imgix.net/116917b4/uploads/origins/3e4392f8-c754-4a04-9baa-39427e5670c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cbc72ea75b163f9048edaac4b9fe162 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きなので、何か描いてもらえると嬉しいです！\n\n16:9のフルスクリーンでお願いします。\n\nブリジットとI-NOがラース・キャニオンで向かい合って戦う準備をしているところを描いてほしい。\n左側はカメラに背を向け、右肩にヨーヨーをぶら下げてドヤ顔しているブリジット。頭が少し横に傾いているので、カメラにはまだ彼女の顔が十分に見え、ドヤ顔と片目がわかる。\n右側には、もう少し背景に、彼女のStriveのアートワークと似ているが、両目が見えていて、ブリジットを見つめている。\nブリジットには、ほとんど黒で、フューシャ色のアクセントと、ごくわずかな白のハイライトという配色を与えてほしい。\nコートの白い部分はメガネとギターと同じように赤であるべきだ。\n\n完成した作品を楽しみにしている！", "created_at": "", "completed_at": ""}, {"path": "/@sptn_00/works/23", "thumbnail_src": "https://si.imgix.net/83517fc1/uploads/origins/96d0f4e1-2416-42a4-8e16-a378b93f08e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=433eec13d68c87d8cccba4d593456114", "thumbnail_srcset": "https://si.imgix.net/83517fc1/uploads/origins/96d0f4e1-2416-42a4-8e16-a378b93f08e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=433eec13d68c87d8cccba4d593456114, https://si.imgix.net/83517fc1/uploads/origins/96d0f4e1-2416-42a4-8e16-a378b93f08e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b68de936635381330c97ae5a839a2838 2x, https://si.imgix.net/83517fc1/uploads/origins/96d0f4e1-2416-42a4-8e16-a378b93f08e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6774790afc8da9081d277993a9b3c520 3x", "genre": "art", "nsfw": false, "body": "私のユーザー名 \"Herbfromthecurb \"をあしらったI-no color 4のバナー。ポーズやデザインは自由です。ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@sptn_00/works/22", "thumbnail_src": "https://si.imgix.net/3baf8c38/uploads/origins/b19f36da-f8c9-42ef-9daa-5df7102610d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4264a765b3a20dbc8ece74ffa0cc5695", "thumbnail_srcset": "https://si.imgix.net/3baf8c38/uploads/origins/b19f36da-f8c9-42ef-9daa-5df7102610d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4264a765b3a20dbc8ece74ffa0cc5695, https://si.imgix.net/3baf8c38/uploads/origins/b19f36da-f8c9-42ef-9daa-5df7102610d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe7dad0c78b5558dc25522d6668ebfec 2x, https://si.imgix.net/3baf8c38/uploads/origins/b19f36da-f8c9-42ef-9daa-5df7102610d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6be42cbab011df836eb5094c963f792 3x", "genre": "art", "nsfw": false, "body": "こんにちは、またまた私です。またまたお願いがあります！ファンタシースターユニバース」のマヤ・シドウのデザインがとても好きなので、マヤの服装（ドレス、ブーツ、レギンス、メガネ）で私のキャラクターを描いてほしいです。いつものように、私のキャラクターのデザインをこの衣装に合わせてアレンジしてください。\n\nhttps://imgur.com/a/Ukj4oqz", "created_at": "", "completed_at": ""}, {"path": "/@sptn_00/works/21", "thumbnail_src": "https://si.imgix.net/4b0f05a6/uploads/origins/b0218e45-4610-4e9c-92bd-bc23c76c08a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc4af28b4f590764b7e67a88bc5491ae", "thumbnail_srcset": "https://si.imgix.net/4b0f05a6/uploads/origins/b0218e45-4610-4e9c-92bd-bc23c76c08a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc4af28b4f590764b7e67a88bc5491ae, https://si.imgix.net/4b0f05a6/uploads/origins/b0218e45-4610-4e9c-92bd-bc23c76c08a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=206afe5d7ecf7fe154663c0852858bd9 2x, https://si.imgix.net/4b0f05a6/uploads/origins/b0218e45-4610-4e9c-92bd-bc23c76c08a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de961eebf47b8a91e2540ec9de8a46a2 3x", "genre": "art", "nsfw": false, "body": "メガネを下げるI-NO（GGSTデザイン）、微笑む、色とりどりの瞳、拗ねたような微笑み、シンプルな背景、プロフィール画像サイズ（小）、通常のI-NOカラー", "created_at": "", "completed_at": ""