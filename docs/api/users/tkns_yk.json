11f54337-91a8-410c-bec3-f82552ed09c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67101c115aa3f0dff2e2fee227bce431 3x", "genre": "art", "nsfw": false, "body": "リクエストお願いします。\n\nhttps://x.com/tkns_yk/status/1795756692086665285\nこちらの続きのイラストをお願いしたいです。\n\nトイレの中で奮闘する紲星あかりとトイレの前で必死に腹痛に堪えて順番を待つ結月ゆかり。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tkns_yk/works/16", "thumbnail_src": "https://si.imgix.net/14c04a08/uploads/origins/cd6ad076-85ed-4f25-a187-4a5b44b6f50f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e78d766d8786034f0cbd5d1ac291cdff", "thumbnail_srcset": "https://si.imgix.net/14c04a08/uploads/origins/cd6ad076-85ed-4f25-a187-4a5b44b6f50f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e78d766d8786034f0cbd5d1ac291cdff, https://si.imgix.net/14c04a08/uploads/origins/cd6ad076-85ed-4f25-a187-4a5b44b6f50f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc969925a167d91d927c18938c712a56 2x, https://si.imgix.net/14c04a08/uploads/origins/cd6ad076-85ed-4f25-a187-4a5b44b6f50f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=800e4970d2c2e2335b179b3dd6d073bc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tkns_yk/works/15", "thumbnail_src": "https://si.imgix.net/16cbe381/uploads/origins/b4175a60-7235-4f38-8621-b6cd9cf832ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e750fed8c5422b25c87e971c3633ff", "thumbnail_srcset": "https://si.imgix.net/16cbe381/uploads/origins/b4175a60-7235-4f38-8621-b6cd9cf832ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e750fed8c5422b25c87e971c3633ff, https://si.imgix.net/16cbe381/uploads/origins/b4175a60-7235-4f38-8621-b6cd9cf832ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6af3426277b16d1e3ea03d033754642 2x, https://si.imgix.net/16cbe381/uploads/origins/b4175a60-7235-4f38-8621-b6cd9cf832ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba96c10da88d62902288f2a8bafc7b25 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\nまた小鳥遊千様にイラストを描いていただきたく依頼をさせていただきました。\n\n【詳細】\nキャラクターはVOICEROIDの弦巻マキ。\n前回と同様にゲームをしているマキちゃんをお願いします。\nシチュエーションはお任せいたします。\nよろしくお願いいたします。\n\n■使用用途\n・配信や動画での使用。\n・SNSでのアイコン使用や投稿", "created_at": "", "completed_at": ""}, {"path": "/@tkns_yk/works/14", "thumbnail_src": "https://si.imgix.net/5c0d6921/uploads/origins/f73cf729-f6c7-4276-85a7-5e07951d839e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3044bd8c1ad338177f87feb69b85185", "thumbnail_srcset": "https://si.imgix.net/5c0d6921/uploads/origins/f73cf729-f6c7-4276-85a7-5e07951d839e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3044bd8c1ad338177f87feb69b85185, https://si.imgix.net/5c0d6921/uploads/origins/f73cf729-f6c7-4276-85a7-5e07951d839e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebfffb82d6905dd50470448ce2ea3473 2x, https://si.imgix.net/5c0d6921/uploads/origins/f73cf729-f6c7-4276-85a7-5e07951d839e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eb31c51bfb53e49b775b52973e8772c 3x", "genre": "art", "nsfw": false, "body": "初めてリクエストさせて頂きます。\n女の子が授業中に腹痛に襲われるシチュをお願いします。\n\nhttps://skeb.jp/@Kutatsu7/works/47\nキャラはオリジナルです。\n容姿はこういう感じの、黒髪ツーサイドアップで清楚系。\n\nhttps://skeb.jp/@unagi_pic/works/10\n服装はこの娘のような制服が良いです。\n\nhttps://twitter.com/ttomarii/status/1272499093713981442?t=j057yRg4h87WBSTa-2nTrw&s=19\n髪は左右の結んでる部分の存在感は最初の参考イラストより強調してこれぐら