f0/uploads/origins/90d1314d-646c-47ba-84fc-c33f4b7342d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4806351d9f1bb44562ddc9ec7062f79 3x", "genre": "art", "nsfw": false, "body": "はじめまして、ゆずグラフと申します。\n\n私がVRSNSで利用している3Dアバターのイラストを依頼致します。\nアバター3面図・写真は下記資料URLをご参照ください。\n\n表情・具体的なポーズ指定は御座いませんが、少しキリッとした顔で運動して汗ばんでいる印象を受ける物だとありがたいです。\n\nご承認頂けますと誠に幸いです。\n\n以上、ご多用のところ恐れ入りますが、どうかよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1V-J80FAPX3CKO9940snUQfwB3pTlAVf-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@1859ysmssstsp/works/23", "thumbnail_src": "https://si.imgix.net/09bda74c/uploads/origins/465c0a94-c0bf-4454-991a-1a2bcf5894ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6bfecd7b16dfe8429b81746e4653171", "thumbnail_srcset": "https://si.imgix.net/09bda74c/uploads/origins/465c0a94-c0bf-4454-991a-1a2bcf5894ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6bfecd7b16dfe8429b81746e4653171, https://si.imgix.net/09bda74c/uploads/origins/465c0a94-c0bf-4454-991a-1a2bcf5894ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2c5d89562a621d728ff197ebae61a62 2x, https://si.imgix.net/09bda74c/uploads/origins/465c0a94-c0bf-4454-991a-1a2bcf5894ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48c7fc89b78d11db0775fa0ebf94c740 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@1859ysmssstsp/works/22", "thumbnail_src": "https://si.imgix.net/b799b139/uploads/origins/7e9a3c74-6fdd-429d-b4ed-e24e68a85935?bg=%23f