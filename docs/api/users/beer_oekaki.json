35-962e-858d2a241ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e8f358fb60fcd7b3d5f280183aa1c1b, https://si.imgix.net/aa1e4bd2/uploads/origins/6ee8a858-2121-4935-962e-858d2a241ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19f6297a42e81cf541b358e6d4f10388 2x, https://si.imgix.net/aa1e4bd2/uploads/origins/6ee8a858-2121-4935-962e-858d2a241ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=212d6d040cc9f3f923d76192de718e6d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@beer_oekaki/works/15", "thumbnail_src": "https://si.imgix.net/b255d130/uploads/origins/0027a8ce-c528-4cd0-8ea7-9fe79ad9bb72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ddd1ebc38244d50ea053ed31a3ecba", "thumbnail_srcset": "https://si.imgix.net/b255d130/uploads/origins/0027a8ce-c528-4cd0-8ea7-9fe79ad9bb72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ddd1ebc38244d50ea053ed31a3ecba, https://si.imgix.net/b255d130/uploads/origins/0027a8ce-c528-4cd0-8ea7-9fe79ad9bb72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d6aa0e7b76afe8690f4432ca94ab713 2x, https://si.imgix.net/b255d130/uploads/origins/0027a8ce-c528-4cd0-8ea7-9fe79ad9bb72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c79df67f8a52eebd24894faafa88978a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのSDスタイルが大好きです。\n\n僕のドラゴンボールのOC、スウーテンを描いてくれないかな？\n彼は魔界から来た悪魔で、とてもプライドが高く、巨大なエゴを持っています。\n魔法で戦い、魔法で爪を伸ばす。物理的な攻撃に関しては蹴りを好む。どんなポーズでもOK。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/18lQ2usOX0MD5dd1aK9