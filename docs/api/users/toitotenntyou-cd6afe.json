833a7-9033-4e62-91df-d2293d4f77a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f72c979096e412c7570ced4e4307738 3x", "genre": "art", "nsfw": true, "body": "トイト様\n\nいつも素晴らしい絵の数々を拝見させていただいております。\n是非トイト様の絵で推しを見たく参りました。\n\n早速内容で恐縮ですが、\n\n・キャラクター\nリトルバスターズ!EXヒロイン3人\nご参考：https://ws-tcg.com/cardlist/?cardno=Klb/W102-034\n\n・服装（髪飾りはそのまま）\n佐々美（紫の子）：裸に公式ニーソ\n佳奈多（ピンクの子）：裸に公式シャツ\n沙耶（黄色の子）：裸に公式制服上着（ガンベルト等の装備は無くて大丈夫です）\n\n・シーン\n佳奈多が中央で正常位の体勢、\n他の2人は左右にいて、3人とも恥ずかしがりながらも性器を見せている（左右2人の体勢はお任せいたします）。\n\nもし余裕があればですが、精液差分が少しあると嬉しいです。\n\n長々となってしまいお手数をおかけしてしまいますが、\nもしご縁がありましたら、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@toitotenntyou/works/63", "thumbnail_src": "https://si.imgix.net/5d338f7a/uploads/origins/59bca8a1-4ca9-4fec-a70a-623c97a0eecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c07aa13c70facc8c79bc3fc489e28896", "thumbnail_srcset": "https://si.imgix.net/5d338f7a/uploads/origins/59bca8a1-4ca9-4fec-a70a-623c97a0eecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c07aa13c70facc8c79bc3fc489e28896, https://si.imgix.net/5d338f7a/uploads/origins/59bca8a1-4ca9-4fec-a70a-623c97a0eecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=549b7101af2f7796da8dae92c18b6f60 2x, https://si.imgix.net/5d338f7a/uploads/origins/59bca8a1-4ca9-4fec-a70a-623c97a0eecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9ab0778b88c1ca9f05bebf450892f59 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@toitotenntyou/works/62", "thumbnail_src": "https://si.imgix.net/efd9e123/uploads/origins/a97356d3-bb42-48ef-8f1c-6a2832c6b30f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0f4312e8e0f434d95f9e3480632cfb0", "thumbnail_srcset": "https://si.imgix.net/efd9e123/uploads/origins/a97356d3-bb42-48ef-8f1c-6a2832c6b30f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0f4312e8e0f434d95f9e3480632cfb0, https://si.imgix.net/efd9e123/uploads/origins/a97356d3-bb42-48ef-8f1c-6a2832c6b30f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c889d9703e9ce5d8548383d507a5d60 2x, https://si.imgix.net/efd9e123/uploads/origins/a97356d3-bb42-48ef-8f1c-6a2832c6b30f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6934ed8ccb72e4087429f2b95868aa63 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@toitotenntyou/works/61", "thumbnail_src": "https://si.imgix.net/0e5eeac5/uploads/origins/9c3e3560-a4ff-4318-9b0b-72662af9860c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea3803136c88cfe7e0731799e8069b8", "thumbnail_srcset": "https://si.imgix.net/0e5eeac5/uploads/origins/9c3e3560-a4ff-4318-9b0b-72662af9860c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea3803136c88cfe7e0731799e8069b8, https://si.imgix.net/0e5eeac5/uploads/origins/9c3e3560-a4ff-4318-9b0b-72662af9860c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17df79a89c4bfcef7096f2e16a446a8f 2x, https://si.imgix.net/0e5eeac5/uploads/origins/9c3e3560-a4ff-4318-9b0b-72662af9860c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1be1ca39179a005480d1c4443ca2169 3x", "genre": "art", "nsfw": true, "body": "刀藤綺凛が像に全裸の状態で埋め込まれて拘束されている続きで、ピンクの触手が像や綺凛に巻き付いて、性的に襲う感じのイラストをリクエストしたいです。\n\n\n\n・1〜2作目の設定も引き継ぎで、矛盾が出てきそうな設定はなしで大丈夫です\n\n・視点は1作品と同じで、後に鏡があり、像の後ろ姿全体が見えるように描いていただきたいです、そのため鏡の光の反射は無しでお願いします。\n\n・触手は像の腕や足、腰、綺凛の胸や二の腕等体中に絡みついていて、巻き付き方は普通の螺旋巻や、✕に交差する感じでお願いします。\n↓イメージです、前回と同じく触手は像の周りを囲むように回っていたり像の足元や腕の下のクッションを通っていたり、胸はそのまま像の中に入って巻き付いている感じで、物理的に巻き付くのが無理そうな部分は無しで良ければその分別の場所に描いてくださればです。\nイメージの他の場所にも巻き付いていたり、巻き付いているを増やしてくださってもかまいません、どうしても難しそうなら触手を複数増やしても大丈夫です。\nhttps://i.imgur.com/iCKhPox.png\n\n・同じく↑のイメージ黒の線で、胸の谷間から出てそのまま首に巻き付いて、触手の先端を男の生殖器の張り型（以降は男根と呼びます）が綺凛を襲う感じに描いていただきたいのですが、AかBのシチュエーションで迷っていまして自分では甲乙付け難いのでトイトさんにお好きな方のシチュエーションを選んでいただきたいです。\n（あと勿論男根の色も、触手と同じピンク色で）\n\nA.綺凛が抵抗し顔を反らして、触手の男根は先端から透明の液体を垂らしながら、口に押し込もうと唇近くの頬に押し当て液体が綺凛の口周りに垂れる\n（難しいかもですができればしっかり顔は見える様にしてください、勿論難しいそうなら無しで構いません）\n\nB.そのまま男根を半分以上口の中に押し込む\n\n・表情はおまかせしますが瞳は両方、あるいは左右どちらかは開いていて涙を流していてほしいです。\n\n\n\n何時もどうり最終的にはトイトさんが基本ご自由に描いていただいても大丈夫ですが前回と同じくらいのクオリティや、ほぼ全体の描写をお頼みしたいので金額も多くお出しします、見合わない様ならキャンセルしていただければです。", "created_at": "", "completed_at": ""}, {"path": "/@toitotenntyou/works/60", "thumbnail_src": "https://si.imgix.net/75e6d5b2/uploads/origins/afde6e72-8dff-41bc-93e1-3e9200631df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d3c13e0043b9a2ceb91798f77d02d1", "thumbnail_srcset": "https://si.imgix.net/75e6d5b2/uploads/origins/afde6e72-8dff-41bc-93e1-3e9200631df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d3c13e0043b9a2ceb91798f77d02d1, https://si.imgix.net/75e6d5b2/uploads/origins/afde6e72-8dff-41bc-93e1-3e9200631df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=916e5d671c0b34092420aca223c459f4 2x, https://si.imgix.net/75e6d5b2/uploads/origins/afde6e72-8dff-41bc-93e1-3e9200631df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=