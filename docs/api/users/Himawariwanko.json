_at": ""}, {"path": "/@Himawariwanko/works/18", "thumbnail_src": "https://si.imgix.net/4d49940f/uploads/origins/fc6f7153-a65b-4672-93ee-be85af2c8504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e202a9ed50c930320ec18a68397bd2f", "thumbnail_srcset": "https://si.imgix.net/4d49940f/uploads/origins/fc6f7153-a65b-4672-93ee-be85af2c8504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e202a9ed50c930320ec18a68397bd2f, https://si.imgix.net/4d49940f/uploads/origins/fc6f7153-a65b-4672-93ee-be85af2c8504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b63ed90b768b209e14efa250eeb30b0 2x, https://si.imgix.net/4d49940f/uploads/origins/fc6f7153-a65b-4672-93ee-be85af2c8504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba67d90426d3729fccc54fcd42265f03 3x", "genre": "art", "nsfw": false, "body": "ひまわりわんこさん、こんにちは！\nひまわりわんこさんの作風がとても好きです。特に、ひまわりわんこさんのページの最初の2つの作品、マルチ・ビューの作風が好きです。私のキャラクターも同じように描いていただけますか？\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1W_bT-pxXK3gFiPP3VuOjP6gOLxHtKbpE", "created_at": "", "completed_at": ""}, {"path": "/@Himawariwanko/works/17", "thumbnail_src": "https://si.imgix.net/eb575d1d/uploads/origins/8d790ba9-b01e-4493-92a5-b16e2453cd3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addc864003f8e59e7e36eae72844f41e", "thumbnail_srcset": "https://si.imgix.net/eb575d1d/uploads/origins/8d790ba9-b01e-4493-92a5-b16e2453cd3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addc864003f8e59e7e36eae72844f41e, https://si.imgix.net/eb575d1d/uploads/origins/8d790ba9-b01e-4493-92a5-b16e2453cd3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0a43997737367b9918345a8eba33ecd 2x, https://si.imgix.net/eb575d1d/uploads/origins/8d790ba9-b01e-4493-92a5-b16e2453cd3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a956a04102bc82b37e95ed412d39146 3x", 