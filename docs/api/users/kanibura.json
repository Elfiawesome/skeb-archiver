_at": ""}, {"path": "/@kanibura/works/108", "thumbnail_src": "https://si.imgix.net/a26cdafa/uploads/origins/0c03279a-de6f-4847-872c-13ad2094eee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6dfb0f28b28036a9be5421d70edf023", "thumbnail_srcset": "https://si.imgix.net/a26cdafa/uploads/origins/0c03279a-de6f-4847-872c-13ad2094eee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6dfb0f28b28036a9be5421d70edf023, https://si.imgix.net/a26cdafa/uploads/origins/0c03279a-de6f-4847-872c-13ad2094eee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb77ef7da204a65a1fe324f259b27a07 2x, https://si.imgix.net/a26cdafa/uploads/origins/0c03279a-de6f-4847-872c-13ad2094eee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c0d29506d04e267421f05ee2fe17833 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/107", "thumbnail_src": "https://si.imgix.net/5f0332be/uploads/origins/f8eda1b5-ec73-4ff2-acda-1539ab18c2f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88b3eca785cce8235b084f777313538c", "thumbnail_srcset": "https://si.imgix.net/5f0332be/uploads/origins/f8eda1b5-ec73-4ff2-acda-1539ab18c2f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88b3eca785cce8235b084f777313538c, https://si.imgix.net/5f0332be/uploads/origins/f8eda1b5-ec73-4ff2-acda-1539ab18c2f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9920f117f1bbe20bb7db8c549db9583b 2x, https://si.imgix.net/5f0332be/uploads/origins/f8eda1b5-ec73-4ff2-acda-1539ab18c2f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d4fb7d660e55732b9f98e21f242dc01 3x", "genre": "art", "nsfw": true, "body": "漫画じゃなくイラストのリクエストをしたいと思いますが大丈夫でしょうか？\nキャラクターは飛鳥(閃乱カグラ)と雪泉\n谷間の線YじゃなくI\n陰毛ありで割れ目が見えないくらい多め\n二人の身長の差原作通り\nテーマは媚薬入りの散水を浴び発情して股間を抑え自慰行為をしているイラスト\n立った状態で涙とよだれまみれでハァハァとあえぐ", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/106", "thumbnail_src": "https://si.imgix.net/9052df23/uploads/origins/c577e0a5-fee2-48d4-90de-8b87d3d91396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254aba899e82ee9d227df94e12714c6b", "thumbnail_srcset": "https://si.imgix.net/9052df23/uploads/origins/c577e0a5-fee2-48d4-90de-8b87d3d91396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254aba899e82ee9d227df94e12714c6b, https://si.imgix.net/9052df23/uploads/origins/c577e0a5-fee2-48d4-90de-8b87d3d91396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6848efe87cd97cfac36a3e177a653067 2x, https://si.imgix.net/9052df23/uploads/origins/c577e0a5-fee2-48d4-90de-8b87d3d91396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a08aa3c2e2aa9be8d1bd6c37912cc24e 3x", "genre": "art", "nsfw": true, "body": "リゼアンの続きをお願いいたします。\n\n◼︎内容: 2コマ形式みたいな感じを想像しています。\n1コマ目はリゼが学校から帰ってきて、「…ただいま」とジト目で言っているところ。\n2コマ目はリゼの視線の先で、アンジュが男にバックから犯されて喜んでいる様子。\n\n◼︎衣装: リゼは今まで通りの制服、アンジュは前回と同じか裸(どちらでも)で、髪はコンドームでポニテにしている。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/105", "thumbnail_src": "https://si.imgix.net/2db714b1/uploads/origins/ed714569-0f88-447c-bf41-f6c13b1baade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ea40944a31f578e59cc4def28e2dc7", "thumbnail_srcset": "https://si.imgix.net/2db714b1/uploads/origins/ed714569-0f88-447c-bf41-f6c13b1baade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ea40944a31f578e59cc4def28e2dc7, https://si.imgix.net/2db714b1/uploads/origins/ed714569-0f88-447c-bf41-f6c13b1baade?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5302542f67a22249aa0f7ec2ca09f742 2x, https://si.imgix.net/2db714b1/uploads/origins/ed714569-0f88-447c-bf41-f6c13b1baade?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ca14dbe20bcb31e83be986c4b2bd458 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nまたまたになりますがリクエストお願いします！\n\n彼氏と温泉にきた葉加瀬さん\n2人並んでお湯に浸かっていると彼が腕を回してきて葉加瀬さんの胸を揉み始める\n咎めるような目を向けながら「これくらいならええけどエッチは部屋に帰ってから」と釘をさす\n勃起してくる彼のチンコを見つつ胸を揉まれ続けてムラムラしてきた葉加瀬さんは自ら彼にまたがりキスをしながらそのままエッチしちゃう\n\nといった内容でお願いします！\nだらだらと書いてしまいましたが大体このようなイメージと思っていただいて大丈夫です！", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/104", "thumbnail_src": "https://si.imgix.net/9e038b47/uploads/origins/fea01063-f89b-4a87-a965-d0047730173c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1772c72833175c19b90f7d5b212ea65f", "thumbnail_srcset": "https://si.imgix.net/9e038b47/uploads/origins/fea01063-f89b-4a87-a965-d0047730173c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1772c72833175c19b90f7d5b212ea65f, https://si.imgix.net/9e038b47/uploads/origins/fea01063-f89b-4a87-a965-d0047730173c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4690063ffbcd50077edba72c6cbcc95 2x, https://si.imgix.net/9e038b47/uploads/origins/fea01063-f89b-4a87-a965-d0047730173c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66c85e9ffc3563862d42205ea68a8f9d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/103", "thumbnail_src": "https://si.imgix.net/2330205a/uploads/origins/2d72409d-e294-417e-9039-9defbd8bbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da3adf762dc097665a614f8788150b42", "thumbnail_srcset": "https://si.imgix.net/2330205a/uploads/origins/2d72409d-e294-417e-9039-9defbd8bbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da3adf762dc097665a614f8788150b42, https://si.imgix.net/2330205a/uploads/origins/2d72409d-e294-417e-9039-9defbd8bbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c601a953364c98f4c9e2319a31bce9e5 2x, https://si.imgix.net/2330205a/uploads/origins/2d72409d-e294-417e-9039-9defbd8bbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f039d540f5f58cf20f61e7412acc3d6 3x", "genre": "art", "nsfw": true, "body": "リクエストをさせていただきます\n\nにじ〇〇じの夜〇〇なのリクエストをさせていただきます。\n衣装は水着衣装\n水着衣装⇩\nhttps://x.com/rena_yorumi/status/1424792091977129984?t=hb-2p4BHEy9nnGDwUcQjIA&s=19\n\n・シチュエーション\n海辺で二人組にナンパされ、野外の人気のない場所でハメられている。\n（ナンパシーンとセックスシ－ンの2枚構成）\n\n一枚目ナンパシーン\nhttps://skeb.jp/@Pd_Pallad/works/176の様な、ナンパ2人組に前後から胸やアソコを弄られる。表情、背景、台詞有無はお任せします。\n\n二枚目セックスシ－ン\n夜〇〇なの髪は下ろされていてストレート。\n・男A\n騎乗位で夜〇と恋人繋ぎ\n・男B\nバックで、アナル挿入しながら両手で陥没乳首チを弄っている。\n夜〇の表情は発情したようなトロ顔で舌を出している状態\nイメージ構図↓\nhttps://www.pixiv.net/artworks/130981037\n竿役は簡素で大丈夫です。\n台詞有無はお任せします。\n\nNG項目や料金等不備がございましたら再送をして頂けたらと思います。\n\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/102", "thumbnail_src": "https://si.imgix.net/de77392c/uploads/origins/3fbd3c93-2ecf-4bd5-aa6d-62c98ca31acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4836cd86da044bbe23a40b0510b9bf02", "thumbnail_srcset": "https://si.imgix.net/de77392c/uploads/origins/3fbd3c93-2ecf-4bd5-aa6d-62c98ca31acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4836cd86da044bbe23a40b0510b9bf02, https://si.imgix.net/de77392c/uploads/origins/3fbd3c93-2ecf-4bd5-aa6d-62c98ca31acc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa1614558ba010a59144d78cd65a510f 2x, https://si.imgix.net/de77392c/uploads/origins/3fbd3c93-2ecf-4bd5-aa6d-62c98ca31acc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=512dd00ebdefbcdb2ccadbc6268fd315 3x", "genre": "art", "nsfw": true, "body": "はじめまして、素敵な漫画を描いていらっしゃったので初リクエストさせて頂きます。\n\n普段描いていらっしゃらないキャラで申し訳ないですが、「ご注文はうさぎですか？」のリゼちゃんで おねショタ授乳プレイ漫画をお願いしたいです\n\n設定:リゼちゃんが小学高学年ぐらいのショタの勉強を教えてる(家庭教師みたいな感じ)\n\n・場所:ラビットハウス寝室\nリゼちゃんの格好は、アニメ3期8羽の髪を下ろしたノーブラ黒キャミソール姿でお願いします。(添付blog参照)\n\n・ショタの容姿風貌は可愛めであれば特に指定はありません\n\n・テスト点数が良かったからショタを褒めて、何かご褒美あげるぞ〜と言うと、大きなおっぱいにに我慢出来なくなったショタが「それなら僕…リゼお姉ちゃんのおっぱい飲んでみたい」と恥ずかしそうにお願いする\n\n・「お…おっぱい！？な…何を言ってるんだ！お前はもう小〇生だろ！？」と断るが、\nそれにショックを受けたショタを見て、「はぁ…しょうがないな…私はまだ母乳は出ないけど、それでもいいのか？」と渋々OKを出し、それにショタが満面の笑みで頷く。\n\n以降が授乳シーンです。\n\n下半身の描写は不要です。上半身のみを映す構図でも構いません。\nショタが勃起するような描写も不要です。\nただおっぱいに赤ちゃんみたいに甘えるシーンがメイン、みたいに思って頂けると幸いです\n\n・正座してるリゼちゃんの前に、ショタが向かい合って正座する。(この際、ショタの目線の先におっぱいが来る感じで)\nこの状態でリゼちゃんがキャミを上にたくし上げて、両方の大きなおっぱいを出す。\n\n・「ほら…いいぞ」と言われ我慢出来なくなったショタが膝立ちになりおっぱいに吸い付く\n\n・授乳時は乳首を吸ってる所が見える構図でお願いします。\n(片手は吸ってない方のおっぱいを軽く揉む(乳首は見えるような揉み方で))\n\n・乳首を吸う音はちゅうちゅう、ちゅぱちゅぱ、と赤ちゃんがひたすらおっぱいを吸うような感じでお願いします。\n\n・吸ってる時にショタが「ママ…」と呟いてる所を入れてくれると嬉しいです。\n\n・授乳時リゼちゃんはショタの頭を撫でて、\n「ふふ、そんなに吸っても出ないぞ」\n「全く…赤ちゃんみたいだな」\n「私のおっぱい、おいしいか？」と母性的に話す感じでお願いします。\n\n\n長くなってしまいましたが以上です。是非ご検討をよろしくお願い致します。\n\nhttps://gamp.ameblo.jp/ktsince2019train/entry-12641151150.html", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/101", "thumbnail_src": "https://si.imgix.net/28e285a6/uploads/origins/06ea6360-393a-4799-89be-61df79a45866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4dd85a7028b0dbd19bd15b1ff65413d", "thumbnail_srcset": "https://si.imgix.net/28e285a6/uploads/origins/06ea6360-393a-4799-89be-61df79a45866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4dd85a7028b0dbd19bd15b1ff65413d, https://si.imgix.net/28e285a6/uploads/origins/06ea6360-393a-4799-89be-61df79a45866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb54e72d4e4215a18cf99505ef32c2ea 2x, https://si.imgix.net/28e285a6/uploads/origins/06ea6360-393a-4799-89be-61df79a45866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bc566920cf3e0186241af99ef05e20f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/100", "thumbnail_src": "https://si.imgix.net/21da70cc/uploads/origins/f59ca43b-bb77-4f0a-ae0d-d4b10712e54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147a88913a0e8ad0929cc9ee2d89713a", "thumbnail_srcset": "https://si.imgix.net/21da70cc/uploads/origins/f59ca43b-bb77-4f0a-ae0d-d4b10712e54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147a88913a0e8ad0929cc9ee2d89713a, https://si.imgix.net/21da70cc/uploads/origins/f59ca43b-bb77-4f0a-ae0d-d4b10712e54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe6042e1270ac5ab3fc72d0e76ee506d 2x, https://si.imgix.net/21da70cc/uploads/origins/f59ca43b-bb77-4f0a-ae0d-d4b10712e54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0927a25669a9c3a3aa2158bd31640a69 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nSNSで漫画を拝見し、ぜひ、Ci-enで公開しているオリジナルキャラクターを描いていただけないかと思いリクエストさせていただきました。\n利用目的：SNSでの紹介\n\n描いてほしいのはこちら。\nhttps://ci-en.dlsite.com/creator/7691/article/1444227\n・人妻（左手薬指に指輪）\n・上記ページの私服姿（黒のタンクトップにデニムパンツの立ち絵）\n\n1ページ目\n・コンビニでコンドームを購入している\n・恥ずかしそう、悔しそうな感じで「袋は必要ありません」「すぐ使いますので」と言わされている。\n・コンドームのサイズは0.01\n\n２ページ目\n・屈強な男から夫婦の寝室で犯されている。\n・「一箱でたりるわけねーだろうが！！」「使い切ったらナマで中出しするからな！」\n　と乱暴に犯されている。\n・ヒロインの方は「ごめんなさい」とか「中出しだけはっ」と抵抗している感じで。\n\n構図はお任せいたします。\n興味を持っていただけましたら、ぜひ、よろしくお願いいたします。\n\nhttps://ci-en.dlsite.com/creator/7691/article/1444227", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/99", "thumbnail_src": "https://si.imgix.net/9a2b7e9d/uploads/origins/f9098fcf-dbe7-4dae-9c9a-61f574337453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c34be2ba65b485442e2234dfdc63aab", "thumbnail_srcset": "https://si.imgix.net/9a2b7e9d/uploads/origins/f9098fcf-dbe7-4dae-9c9a-61f574337453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c34be2ba65b485442e2234dfdc63aab, https://si.imgix.net/9a2b7e9d/uploads/origins/f9098fcf-dbe7-4dae-9c9a-61f574337453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41f2040fdd1516039cdd979c1218c381 2x, https://si.imgix.net/9a2b7e9d/uploads/origins/f9098fcf-dbe7-4dae-9c9a-61f574337453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca228b0d0bb6661cfb124bdba985fad0 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回はポケモンの主人公キャラをお願いいたします。\n描いてほしいキャラ画像タイトル「主人公」\n女装している男の娘です\n\nシュチュエーションは鏡に向かって「オレ可愛い、オレ可愛い」と言いながらオナニーしている\n\nニーソではなくトレンカを履いている\n\nホットパンツと女性用の下着を履いてるが脱いで片足に引っ掛けている\n竿は袋まで見えている\n鏡に向かってオナニーしている\n両方の足の裏が見えている\n今回もエッチな足裏よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WxMhS-TdwkXfmA1wCsFpTMAClzOVTRZZ", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/98", "thumbnail_src": "https://si.imgix.net/8d16369b/uploads/origins/cf8b501d-f64f-49ef-9c82-149d90beaa75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fdd9cf57224e90759736a6cf7dcd09f", "thumbnail_srcset": "https://si.imgix.net/8d16369b/uploads/origins/cf8b501d-f64f-49ef-9c82-149d90beaa75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fdd9cf57224e90759736a6cf7dcd09f, https://si.imgix.net/8d16369b/uploads/origins/cf8b501d-f64f-49ef-9c82-149d90beaa75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3420dcc06c7f5e98c2707b57c47d300b 2x, https://si.imgix.net/8d16369b/uploads/origins/cf8b501d-f64f-49ef-9c82-149d90beaa75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97a2ec078857f123539984b05de2b753 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanibura/works/97", "thumbnail_src": "https://si.imgix.net/9b561563/uploads/origins/08da55b7-0fb0-4061-b37f-1e5cbf81f29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c759a778272826e46214be7383b3b15e", "thumbnail_srcset": "https://si.imgix.net/9b561563/uploads/origins/08da55b7-0fb0-4061-b37f-1e5cbf81f29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c759a778272826e46214be7383b3b15e, https://si.imgix.net/9b561563/uploads/origins/08da55b7-0fb0-4061-b37f-1e5cbf81f29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=223c4086fd2f0d34611630c4a0d2b3c6 2x, https://si.imgix.net/9b561563/uploads/origins/08da55b7-0fb0-4061-b37f-1e5cbf81f29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb85a2aa638f5d6d61882001c79c8e83 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n前回のイラスト素晴らしかったです！\nまたリクエストさせてください！\n\n海で遊んでいる椎名さん\nいきなり子供にビキニの上を剥ぎ取られ逃げられる\n何とか追いついた先で返すように要求するが「おっぱい触らせてくれたら返してあげる」と言われ\n悩んだあげくしかたなく触らせて胸を吸われたり揉まれたりする\nといった内容でお願いします！", "created_at": "", "