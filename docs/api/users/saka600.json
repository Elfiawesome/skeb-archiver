2-49e9-9fc6-aaa68fbcdaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5482c3e304b3828f05be41883c83259d, https://si.imgix.net/0111f8e4/uploads/origins/d62a1704-64c2-49e9-9fc6-aaa68fbcdaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f38922a30417f96549a788f673eff2d 2x, https://si.imgix.net/0111f8e4/uploads/origins/d62a1704-64c2-49e9-9fc6-aaa68fbcdaa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6dd3d647654a15a3e0887d3ff420c89 3x", "genre": "art", "nsfw": false, "body": "やさか沙彩先生、はじめまして。\n活動休止されているVtuberの瀬乃ここは(@Senokoko_ha)さんへ、4月6日のお誕生日をお祝いするFAをお願いしたいです。\n\n髪型はもしよろしければ、ことねちゃんのようなツイン編みおろしでお願いします。\n髪先等が見切れていない構図でお願いします。\nその他詳細なポーズ・構図はお任せします。\n\n・補足\n元気で明るいキャラ、かわいいルックスと声を持つ癒し系な配信者さんでもありリスナーさんに活力をくれる配信者さんです。髪飾りは白のライラック、好きなお花はネモフィラです。\n\n・利用範囲\n瀬乃ここはさん本人は休止後もFAを歓迎されております（参考資料の画像もご本人がそのために提供してくださった画像となります）。\n活動休止されておりますが、もし瀬乃ここはさんご本人が活動のためにYoutubeやSNS等で使用する場合は許可して頂ければと思います。\nまた、そのため文字、人物を分けたデータも用意していただければと思います。\nもし、投稿時ウォータマーク等必要であればレイヤー用意していただけると幸いです。\n\nhttps://drive.google.com/drive/folders/1LoAlVK0SNVR95co2fOnuGYnUZgogo95B?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@saka600/works/24", "thumbnail_src": "https://si.imgix.net/7ab62b4e/uploads/origins/8784d0cf-2e4d-4db8-aa01-c73ae413c84b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b011de8713129fd56d2f264289dd6abe", "thumbnail_srcset": "https://si.imgix.net/7ab62b4e/uploads/origins/8784d0cf-2e4d-4db8-aa01-c73ae413c84b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b011de8713129fd56d2f264289dd6abe, https://si.imgix.net/7ab62b4e/uploads/origins/8784d0cf-2e4d-4db8-aa01-c73ae413c84b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4163b9cfc6fe7309a2de0c27445c0f55 2x, https://si.imgix.net/7ab62b4e/uploads/origins/8784d0cf-2e4d-4db8-aa01-c73ae413c84b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4da78a6a6fd46c1b6c7ed998bf8e39b8 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\nずっと先生の絵が好きで、この度リクエストをさせていただくことにしました。Skebというものが初めてなのでこれであっているのかわかりませんが、よろしくお願いします。\n\nご依頼したいキャラクターは駅メモ！というゲームの豊栄なほ、という娘です。（添付したTwitterリンクの画像の右側の娘です）\n\n寝ているこちらを上からのぞき込んできて、髪がカーテンのように垂れてきている構図でお願いします。\n服装はツイートにあるデフォルト衣装もしくは彼シャツ、表情は口元だけかすかに微笑む感じでお願いしたいです。\nよろしくお願いします。\n\nhttps://x.com/JREniigata/status/1859508659979682187?s=20", "created_at": "", "completed_at": ""}, {"path": "/@saka600/works/23", "thumbnail_src": "https://si.imgix.net/f9e92520/uploads/origins/e868530c-32e8-4449-aa67-8735691dfed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c7dd1d4b81c3a464a2343334e2feb9", "thumbnail_srcset": "https://si.imgix.net/f9e92520/uploads/origins/e868530c-32e8-4449-aa67-8735691dfed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c7dd1d4b81c3a464a2343334e2feb9, https://si.imgix.net/f9e92520/uploads/origins/e868530c-32e8-4449-aa67-8735691dfed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e702a645cd5c20b4a77c1d231f0fc2b8 2x, https://si.imgix.net/f9e92520/uploads/origins/e868530c-32e8-4449-aa67-8735691dfed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d34098f99aeb9596d20a86432db6c23d 3x", "genre": "art", "nsfw": false, "body": "ポケモンレジェンズZ-Aのムクをお願いします\n\nD･G･4！のポーズをしながら「カナリィ……♡」って考えてると嬉しいです\n\nキャラ・ポーズの参考資料として下記の動画の29:30～あたりと5:16:30～あたりを参照のほどよろしくお願います\nカナリィ VS 最強のお茶漬け、ひつまぶし【馬車道はげみ】F カナリィ戦〜\nhttps://www.youtube.com/live/DZXubhSjVWo?si=DiSuDxhZtlD21P3R&t=1770", "created_at": "", "completed_at": ""}, {"path": "/@saka600/works/22", "thumbnail_src": "https://si.imgix.net/d0d31585/uploads/origins/8b70cae9-4829-416e-8796-e1ee99c26305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560932c8a0956700678412b6062cc478", "thumbnail_srcset": "https://si.imgix.net/d0d31585/uploads/origins/8b70cae9-4829-416e-8796-e1ee99c26305?bg=%23fff&auto=format%2Ccompress&fm=webp&f