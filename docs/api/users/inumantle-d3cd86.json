3b6-b724-3e39a719f7a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d1045605b3b38884c583dea88b62ee2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/15", "thumbnail_src": "https://si.imgix.net/d5529ae1/uploads/origins/bf7ada63-e95f-4e26-9a4d-4d4b9658da4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655a76b424ac34ddd4e0b0fa3181eee7", "thumbnail_srcset": "https://si.imgix.net/d5529ae1/uploads/origins/bf7ada63-e95f-4e26-9a4d-4d4b9658da4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655a76b424ac34ddd4e0b0fa3181eee7, https://si.imgix.net/d5529ae1/uploads/origins/bf7ada63-e95f-4e26-9a4d-4d4b9658da4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38194ddc3bca00256621a7efde426c50 2x, https://si.imgix.net/d5529ae1/uploads/origins/bf7ada63-e95f-4e26-9a4d-4d4b9658da4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4945dfb053c8a9a565bc8d7f06f52e8e 3x", "genre": "art", "nsfw": true, "body": "以前描いていただいたフレデリカさんのイラストが背景画像にずっと居座るくらい素晴らしかったので\n再度リクエストさせていただきます。\n\nアイドルマスターシンデレラガールズ\n速水奏\n\nベッドに下着姿で横たわるお姿。\nいつもは余裕綽々、挑発的なキャラクターなのですが、それが崩れていて\n余裕なく、弱みを見せていて恥ずかしそうな表情。\n流し目でちょっと涙目なくらい。顔がほんのり赤くなっている。\n\n下着は黒とかの色っぽいものが希望ですが\nイメージに合うものあれば、他でも問題ありません。\nスレンダー気味でスタイルが良く色っぽい身体の描写をお願いしたいです。\n\n希望は以上になります。\n描きづらい部分、不自然な描写になる部分あれば変えていただいて構いません。\nご検討お願い致します。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/122?h=bcabb6bef0c899516b59ab44dc701efa", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/14", "thumbnail_src": "https://si.imgix.net/f2b7cf28/uploads/origins/65401913-91b8-49ef-aa6f-80434028a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f3f1f174f386182011796ce9d0aa2c", "thumbnail_srcset": "https://si.imgix.net/f2b7cf28/uploads/origins/65401913-91b8-49ef-aa6f-80434028a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f3f1f174f386182011796ce9d0aa2c, https://si.imgix.net/f2b7cf28/uploads/origins/65401913-91b8-49ef-aa6f-80434028a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d1e7360d5ea21695ee255516c6bf6c2 2x, https://si.imgix.net/f2b7cf28/uploads/origins/65401913-91b8-49ef-aa6f-80434028a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0229f0f415b0a1bb848d83db826aaa9f 3x", "genre": "art", "nsfw": true, "body": "作品を鑑賞させていただき、特に以下のようなイラストにとても惹かれたので\n同じようなシチュエーションでリクエストさせていただきます。\nhttps://skeb.jp/@inumantle/works/5\nhttps://skeb.jp/@inumantle/works/4\n\nアイドルマスターシンデレラガールズ\n宮本フレデリカ\n\n私服姿(参照URLの恰好)でベッドか、ソファに横たわっているお姿。\n（参照URLの衣服、下がよくわからないので黒のミニスカート、黒のニーソックスということにしていただきたいです。靴はなしでよいです。）\nショーツは見えていないでよいのですが、絶対領域は見えててちょっとエロ目。\n表情はちょっと恥ずかしそうに照れ笑い。口は少し開いている。\n\nなるべく全身鑑賞できる構成でお願いしたいです。(膝くらいまでとかでもよいので。)\n希望は以上になります。ご検討お願い致します。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/32?h=imcgss-c15", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/13", "thumbnail_src": "https://si.imgix.net/fab8935e/uploads/origins/3541ff02-0f99-4a2a-b676-3b4afe5ccf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd285eaacd8fce0ff564f1368fd2ad48", "thumbnail_srcset": "https://si.imgix.net/fab8935e/uploads/origins/3541ff02-0f99-4a2a-b676-3b4afe5ccf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd285eaacd8fce0ff564f1368fd2ad48, https://si.imgix.net/fab8935e/uploads/origins/3541ff02-0f99-4a2a-b676-3b4afe5ccf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2131d1ee2d909eb753efbf81d80f2f48 2x, https://si.imgix.net/fab8935e/uploads/origins/3541ff02-0f99-4a2a-b676-3b4afe5ccf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e58a4880d8febde8dd3e93e7510a774c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの画風が本当に好きです。私のキャラクターを描いていただけると本当に嬉しいです。髪の色は白銀（金髪ではない）でお願いします。髪の色は、ピンクや赤のハイライトは無視できますか？一色（白）でお願いします。ありがとうございました。\n\n参考：https://imgur.com/a/GzP6MUD\nポーズ: https://imgur.com/a/wfOG1yc\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/12", "thumbnail_src": "https://si.imgix.net/160ff0e3/uploads/origins/6d1832a4-460e-40e6-9497-04fadea9352c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a66c6807b4e00da50b5d00267a9406a", "thumbnail_srcset": "https://si.imgix.net/160ff0e3/uploads/origins/6d1832a4-460e-40e6-9497-04fadea9352c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a66c6807b4e00da50b5d00267a9406a, https://si.imgix.net/160ff0e3/uploads/origins/6d1832a4-460e-40e6-9497-04fadea9352c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67c97281789a4de712705cddfed86642 2x, https://si.imgix.net/160ff0e3/uploads/origins/6d1832a4-460e-40e6-9497-04fadea9352c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae915bc81517d604d447b6507e90176f 3x", "genre": "art", "nsfw": false, "body": "イラストが大好きです！作風がとてもかわいいです。もし気が向いたらリクエストを受け入れてください！そうしてもらえたらとても嬉しいです。\n\nシュワちゃんは身長144cmの核の猫娘です。胸はぺったんこで、自信満々でカオスなツンデレです。ポーズや構図はあなた次第。工夫してください！お時間のある方は少し多めに入れました！(笑)\n\nSNSやYoutubeで使用する可能性があります。ありがとうございます💜。\n\nhttps://imgur.com/a/0QSueKS", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/11", "thumbnail_src": "https://si.imgix.net/ac090564/uploads/origins/9197a96b-3854-4430-a6ff-f6b469efc773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9c940ecddccc98886ce3996bbe168f7", "thumbnail_srcset": "https://si.imgix.net/ac090564/uploads/origins/9197a96b-3854-4430-a6ff-f6b469efc773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9c940ecddccc98886ce3996bbe168f7, https://si.imgix.net/ac090564/uploads/origins/9197a96b-3854-4430-a6ff-f6b469efc773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffd5d776aecc03802e5dae949ffb1ea6 2x, https://si.imgix.net/ac090564/uploads/origins/9197a96b-3854-4430-a6ff-f6b469efc773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd4c075f5450fd36b0e6ada6a1874a9c 3x", "genre": "art", "nsfw": false, "body": "はじめまして、よろしければブルアカのホシノをお願いします。\nその他、細かい指定等はありませんので自由に描いて頂ければと。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/10", "thumbnail_src": "https://si.imgix.net/c451149d/uploads/origins/0b405ac7-54e0-4cac-9874-e604a115c655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1be0a3ae959afcb9c490a44cfd6f33c", "thumbnail_srcset": "https://si.imgix.net/c451149d/uploads/origins/0b405ac7-54e0-4cac-9874-e604a115c655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1be0a3ae959afcb9c490a44cfd6f33c, https://si.imgix.net/c451149d/uploads/origins/0b405ac7-54e0-4cac-9874-e604a115c655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=694d960b3b5a7e29277f7ae7bdcb59f3 2x, https://si.imgix.net/c451149d/uploads/origins/0b405ac7-54e0-4cac-9874-e604a115c655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb0ad4ccef2d2f96be1e58bab61f1e01 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/9", "thumbnail_src": "https://si.imgix.net/04a3048d/uploads/origins/6dc6234c-201f-4ddc-87e1-cf7943c4d3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab59bee56100c100919aa439d785348", "thumbnail_srcset": "https://si.imgix.net/04a3048d/uploads/origins/6dc6234c-201f-4ddc-87e1-cf7943c4d3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab59bee56100c100919aa439d785348, https://si.imgix.net/04a3048d/uploads/origins/6dc6234c-201f-4ddc-87e1-cf7943c4d3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9d0b034dbd9d77ed435d371128fd03c 2x, https://si.imgix.net/04a3048d/uploads/origins/6dc6234c-201f-4ddc-87e1-cf7943c4d3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2c8d22e2e1af269652729ab20a9385e 3x", "genre": "art", "nsfw": false, "body": "・書いていただきたい人物\n→シャニマス の桑山千雪さん\n\n・シチュや構図のイメージ\n→水族館の大きい水槽の前で、水槽のガラスに手を触れて中を眺めている、という内容でお願いしたいです。\nまた、もし可能であれば中のお魚に触れようとしている、まで表現していただけるととても嬉しいです…！\n\n素人のイメージで恐縮ですが、甜花ちゃんの「楽園に背く」というSRサポートカードのようなイメージが近いです。あのカードの描かれている範囲がもう少し広がって身体が見えている感じです。\n（資料URLにwikiですが添付しております）\n\nうまく伝わらない箇所などあったらとても申し訳ありませんが、そのような箇所は先生のやりやすいようにしていただきたいです。\nよろしくお願いいたします…！\n\nhttps://wikiwiki.jp/shinycolors/%E3%80%90%E6%A5%BD%E5%9C%92%E3%81%AB%E8%83%8C%E3%81%8F%E3%80%91%E5%A4%A7%E5%B4%8E%E7%94%9C%E8%8A%B1", "created_at": "", "completed_at": ""}, {"path": "/@inumantle/works/8", "thumbnail_src": "https://si.imgix.net/349a6200/uploads/origins/28592c75-b161-4295-94b3-9c62fff85b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c145026d3e3cce913165b1c66a7fefc", "thumbnail_srcset": "https://si.imgix.net/349a6200/uploads/origins/28592c75-b161-4295-94b3-9c62fff85b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c145026d3e3cce913165b1c66a7fefc, https://si.imgix.net/349a6200/uploads/origins/28592c75-b161-4295-94b3-9c62fff85b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVA