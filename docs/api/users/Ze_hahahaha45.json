は自傷行為として髪を雑に切ってしまっています。 また、左腕にはリストカットの傷跡があり、いつも包帯を巻いています。 主食はヒトで、見境なく人間を食べています。  構図等はお任せしますが、仄暗い雰囲気だと嬉しいです！\n\nただざらすすす先生の世界観が好きなので、お好きに描いていただきたいです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1wPL97oF72gTeFCyLrtarLo659SnSd2z_", "created_at": "", "completed_at": ""}, {"path": "/@Ze_hahahaha45/works/2", "thumbnail_src": "https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c33f6133e42ba58eaccc3030bd76a5f3", "thumbnail_srcset": "https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c33f6133e42ba58eaccc3030bd76a5f3, https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d30440daf5960ec25206d4e8fb0028c 2x, https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f44355f042ad61f9aea5553fddcf98cb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ze_hahahaha45/works/1", "thumbnail_src": "https://si.imgix.net/57ca3685/uploads/origins/fe2bd7d0-84b5-459c-8ab5-fb2f898a1857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a6768934bac533e6d3c0b3196d622f2", "thumbnail_srcset": "https://si.imgix.net/57ca3685/uploads/origins/fe2b