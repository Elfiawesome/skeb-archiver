fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=035a94286389c012c6840bc6ab9d250f 2x, https://si.imgix.net/d85079ea/uploads/origins/403bfa2b-43be-4513-9e1c-1451749856f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f5b72539ccbb8985895d6c07edc89c3 3x", "genre": "art", "nsfw": true, "body": "はじめまして。河馬拳さんの描く汚パンツ絵が好きです。\n河馬拳さんの好きなキャラクター三人がパンツであやとりポーズで汚れたクロッチ裏を見せている絵をリクエストさせていただきます。\nクロッチは濃い目に汚してください。\nキャラクターのチョイス、構図や表情、着衣状態はお任せします。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@coverpa13a/works/108", "thumbnail_src": "https://si.imgix.net/50f053b0/uploads/origins/0da30681-90b8-4ffd-9f73-459c20c302d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33347f7d0a51415d4daa5f38d5d57a0d", "thumbnail_srcset": "https://si.imgix.net/50f053b0/uploads/origins/0da30681-90b8-4ffd-9f73-459c20c302d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33347f7d0a51415d4daa5f38d5d57a0d, https://si.imgix.net/50f053b0/uploads/origins/0da30681-90b8-4ffd-9f73-459c20c302d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cde8f94cb5b0bec4c206a4f62e93e2f 2x, https://si.imgix.net/50f053b0/uploads/origins/0da30681-90b8-4ffd-9f73-459c20c302d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20975aaf10a03ff296f40c4ac082de90 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@coverpa13a/works/107", "thumbnail_src": "https://si.imgix.net/5851ef21/uploads/origins/f2b87616-d448-43dc-8907-4a822f47e5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e9a039f7313d771cf359f2d7f498927", "thumbnail_srcset": "https://si.imgix.net/5851ef21/uploads/origins/f2b87616-d448-43dc-8907-4a822f47e5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e9a039f7313d771cf359f2d7f498927, https://si.imgix.net/5851ef21/uploads/origins/f2b87616-d448-43dc-8907-4a822f47e5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3ee9a85a6cdc87123c0c1f6503cc559 2x, https://si.imgix.net/5851ef21/uploads/origins/f2b87616-d448-43dc-8907-4a822f47e5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce666244f7f581fcc9be3e7257d15283 3x", "genre": "art", "nsfw": true, "body": "こんにちは。綾小路夜斗が大きな大人のペニスで犯され、最後にお腹に精液がかかっているところを描いていただけませんか？ 別の絵は、彼女が妊娠していて、黒ずんだ乳輪と乳首がオーガズムに達したときに母乳を噴出しているところです。 よろしくお願いします。セクシーなランジェリーを着た彼女も描いてもらえますか？ ありがとう\nhttps://megaman.fandom.com/wiki/Yai_Ayanokoji", "created_at": "", "completed_at": ""}, {"path": "/@coverpa13a/works/106", "thumbnail_src": "https://si.imgix.net/22982431/uploads/origins/739fb503-6ee7-445b-9f0d-94d3488ff9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d014e1cc2a4853b452edf7620d6eb311", "thumbnail_srcset": "https://si.imgix.net/22982431/uploads/origins/739fb503-6ee7-445b-9f0d-94d3488ff9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d014e1cc2a4853b452edf7620d6eb311, https://si.imgix.net/22982431/uploads/origins/739fb503-6ee7-445b-9f0d-94d3488ff9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4dfba2d739b8f9cb167b244ad1fa4ad 2x, https://si.imgix.net/22982431/uploads/origins/739fb503-6ee7-445b-9f0d-94d3488ff9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f127622b523a12ad46b5ac39bb83e9b2 3x", "genre": "art", "nsfw": true, "body": "【あいさつ】\nカブールイラストとてもよかったです\nありがとうございます\nカブールイラストの、最初服を着ているところから、少しずつ隠されている部分があらわになり、最後に中出しされて閉じなくなったアソコから精液があふれ出す…\nといった展開の、各イラストとその変化がとても素晴らしかったです\n以前依頼した利根イラストもとても満足していたのですが、同じような差分を追加して、もっと素晴らしいものにしていただきたく感じました\nもともとそのような差分を考慮されていないでしょうから、労力大きい場合は申し訳ありませんが、よければお願いします\n\n【依頼】\n前回の利根改二イラストに、次の差分を追加いただきたくお願いします\n\n【差分1】\n[服を着た状態]\n以前いただいたイラストの1枚目は\n・服の胸：暴かれている　スカート：めくられている　アソコ：丸見え\nという状態ですが、1枚目のイラストのさらに前をイメージした、下記の2つの差分を追加いただけないでしょうか\n・胸と股間が隠れている健全状態のイラスト　服の胸：閉じている　スカート：下ろしている　アソコ：スカートで隠れている\n・胸と下着がさらけ出された少しHイラスト　服の胸：暴かれている　スカート：めくられている　アソコ：下着が丸見え\n表情はおまかせしますが、1枚目のままでも構いません\n\n【差分2】\n[中出し]\n以前いただいたイラストで電マを当てられるイラストがありました\n・電マの代わりに、ペニスをねじ込まれて中出し絶頂する差分\n・ペニスを引き抜かれて、閉じなくなったアソコから精液が漏れ出しているイラスト\n表情はお任せしますが、電マの時と同じ表情でも構いません", "created_at": "", "completed_at": ""}, {"path": "/@coverpa13a/works/105", "thumbnail_src": "https://si.imgix.net/713995c9/uploads/origins/15d0b06a-8392-49d4-8b60-56bdcfbae5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b36b0f51d14d7a930fa7a9c8242e8b9", "thumbnail_srcset": "https://si.imgix.net/713995c9/uploads/origins/15d0b06a-8392-49d4-8b60-56bdcfbae5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b36b0f51d14d7a930fa7a9c8242e8b9, https://si.imgix.net/713995c9/uploads/origins/15d0b06a-8392-49d4-8b60-56bdcfbae5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae850717a845c0dcaaa0608eeced6bc7 2x, https://si.imgix.net/713995c9/uploads/origins/15d0b06a-8392-49d4-8b60-56bdcfbae5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d77733b37559f30d3bc6208df772999 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@coverpa13a/works/104", "