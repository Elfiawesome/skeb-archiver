%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c258c9f5d49d6ee0df98360650ce27f2", "thumbnail_srcset": "https://si.imgix.net/03adb53a/uploads/origins/24fffee5-c6c5-48f4-a919-073e1b8cc41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c258c9f5d49d6ee0df98360650ce27f2, https://si.imgix.net/03adb53a/uploads/origins/24fffee5-c6c5-48f4-a919-073e1b8cc41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f67cbb84329f950eebcdcdb08917e67 2x, https://si.imgix.net/03adb53a/uploads/origins/24fffee5-c6c5-48f4-a919-073e1b8cc41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cc59ecaab699a381e7f0e2bc8eaf618 3x", "genre": "art", "nsfw": false, "body": "こんにちは、グルミンさん。愛猫とソイミルクの二人のキャラクターが一緒にいるイラストをお願いしたいです。シーンは、ソイミルクが座っていて、愛猫がソイミルクの足の上に寝そべっている様子です。二人とも幸せで楽しそうな表情にしてください。その他の要素はご自由に描いていただいて結構です。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1tYnCqbkSURitB_yoP1SXlY7JvLpEJHus?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@GuruminnSD/works/657", "thumbnail_src": "https://si.imgix.net/4864ab0f/uploads/origins/f4523f07-c8ae-4233-b240-202407c308c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18b5084f1df36118579cf55b9964348b", "thumbnail_srcset": "https://si.imgix.net/4864ab0f/uploads/origins/f4523f07-c8ae-4233-b240-202407c308c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18b5084f1df36118579cf55b9964348b, https://si.imgix.net/4864ab0f/uploads/origins/f4523f07-c8ae-4233-b240-202407c308c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7a4a53e6b5bae20e38305e715d210bb 2x, https://si.imgix.net/4864ab0f/uploads/origins/f4523f07-c8ae-4233-b240-202407c308c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3b2d7e84705ae570a8b2c21c3a5afb5 3x", "genre": "art", "nsfw": false, "body": "あなたの絵柄、すごく可愛いです！私のオリジナルキャラを描いていただけませんか？見た目はこちらのリンクを参考にしてください：https://pandabearlily.carrd.co/#refsheet。構図やポーズは完全に自由にしていただいて結構です、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@GuruminnSD/works/656", "thumbnail_src": "https://si.imgix.net/ef3360bf/uploads/origins/53dc4887-1727-4d33-a0a7-e3aeb935e674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b513f75e02540d164211024f2770761", "thumbnail_srcset": "https://si.imgix.net/ef3360bf/uploads/origins/53dc4887-1727-4d33-a0a7-e3aeb935e674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b513f75e02540d164211024f2770761, https://si.imgix.net/ef3360bf/uploads/origins/53dc4887-1727-4d33-a0a7-e3aeb935e674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a00775f85ccf252ce7cd7020842d4518 2x, https://si.imgix.net/ef3360bf/uploads/origins/53dc4887-1727-4d33-a0a7-e3aeb935e674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26b7ab5c70d7512f059490a561021865 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n先日はとてもかわいいSDイラストを描いていただきありがとうございました！\nぜひまたイラストを描いていただきたくリクエストさせていただきました…！\n\n今回は、同じ事務所「らいとあっぷ！」所属の「JamQuartz」の二人のイラストをお願いします！\nhttps://x.com/Zakuro_kuoN\nhttps://x.com/kiraboshi_inori\n\n使用用途は観賞用で商用利用の予定はありませんが、二人の活動で使用する可能性があります。", "created_at": "", "completed_at": ""}, {"path": "/@GuruminnSD/works/655", "thumbnail_src": "https://si.imgix.net/006189e7/uploads/origins/17edf7d8-fd75-4c64-8839-fd85c524c532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7818271af192885eb2a3c9e78900408b", "thumbnail_srcset": "https://si.imgix.net/006189e7/uploads/origins/17edf7d8-fd75-4c64-8839-fd85c524c532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7818271af192885eb2a3c9e78900408b, https://si.imgix.net/006189e7/uploads/origins/17edf7d8-fd75-4c64-8839-fd85c524c532?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=310c0ce13ad7a4b8e9d49ba214258996 2x, https://si.imgix.net/006189e7/uploads/origins/17edf7d8-fd75-4c64-8839-fd85c524c53