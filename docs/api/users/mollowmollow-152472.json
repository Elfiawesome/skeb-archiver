&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2102354451f9a6c22023b78680b1c39 2x, https://si.imgix.net/f763cb3b/uploads/outputs/a6703b9b-1d9f-4a22-b9e8-8e6ae8f3747f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb259014410c4f829139a9c5bca5afa9 3x", "genre": "video", "nsfw": false, "body": "自キャラのアニメーションをお願いします、ゲームの要素入れてくれると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@mollowmollow/works/37", "thumbnail_src": "https://si.imgix.net/be2d757f/uploads/origins/75331da8-85c3-45db-a642-0b6b03d783a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11f5c70a263e462ca4085430f47cd2c2", "thumbnail_srcset": "https://si.imgix.net/be2d757f/uploads/origins/75331da8-85c3-45db-a642-0b6b03d783a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11f5c70a263e462ca4085430f47cd2c2, https://si.imgix.net/be2d757f/uploads/origins/75331da8-85c3-45db-a642-0b6b03d783a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=978c4951d4c5ecda1073a14c5e032342 2x, https://si.imgix.net/be2d757f/uploads/origins/75331da8-85c3-45db-a642-0b6b03d783a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08165633759d70283ea1364571906667 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの仕事が大好きです!\n\n私のocのSehothとBadianの絵をお願いしたいです!Sehothは北極キツネで、植物学者でもあり、司祭でもあります！彼は少し陰気ですが、とても優しいです。バディアンはハイエナで、吟遊詩人であり、作家であり、標識灯ライターでもある。彼もまたとても穏やかで、自由気ままな性格だ！\n\n芸術家には創作する自由がある！さらに、彼らはゲイカップルなので、親密なしぐさをすることができます。できるだけかっこよく、かわいくしてください!\n\nhttps://drive.google.com/drive/folders/1lMxE9HBNp-QoJlup9YDrRVFwAZ1aKcNl?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mollowmollow/works/36", "thumbnail_src": "https://si.imgix.net/7852e630/uploads/outputs/bffff7e8-74e4-47a5-b05c-8adf053a56e5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=20070adb2e1824f4925085398966519b", "thumbnail_srcset": "https://si.imgix.net/7852e630/uploads/outputs/bffff7e8-74e4-47a5-b05c-8adf053a56e5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=20070adb2e1824f4925085398966519b, https://si.imgix.net/7852e630/uploads/outputs/bffff7e8-74e4-47a5-b05c-8adf053a56e5?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d589138c112e41b3e2e2d244d40a16f 2x, https://si.imgix.net/7852e630/uploads/outputs/bffff7e8-74e4-47a5-b05c-8adf053a56e5?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ad95da744682a3545f4b82e568131ab 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたの作品をとても尊敬しています。私の息子ノナスのために、あなたに仕事を依頼したいと思っています！\n\n小さなノナスは、世界を本当に知りたがっている幸せな太陽のようなユキヒョウです。彼は巨大な金属製の手袋を使って敵を制圧します。小さなノナスは、普段はとても愛らしく、みんなと仲良くしているときはやんちゃですが、友達や家族を脅かす敵に出会うと容赦しません。\n\n 芸術的なポーズも自由です！楽しんで描いてください！\n\n出来上がりが楽しみだ！ありがとう！\n\nhttps://drive.google.com/drive/folders/1P1Z6gY_0aLET3EPnYRVWl_FmYIpZVzbz", "created_at": "", "completed_at": ""}, {"path": "/@mollowmollow/works/35", "thumbnail_src": "https://si.imgix.net/43d7ba13/uploads/origins/030d57c4-bb99-4442-b97d-82bdcb5c821c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5db75924e9ca1b557c42d97e92bfccd9", "thumbnail_srcset": "https://si.imgix.net/43d7ba13/uploads/origins/030d57c4-bb99-4442-b97d-82bdcb5c821c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5db75924e9ca1b557c42d97e92bfccd9, https://si.imgix.net/43d7ba13/uploads/origins/030d57c4-bb99-4442-b97d-82bdcb5c821c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=484037d4a0d1e342a1eed511a8a3810c 2x, https://si.imgix.net/43d7ba13/uploads/origins/030d57c4-bb99-4442-b97d-82bdcb5c821c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97b831397f2032d936ab828cbf7fef32 3x", "genre": "art", "nsfw": false, "body": "mollowmollowさん、こんにちは！はじめまして！\n私は「けものになりたい」を見て以来、あなたのアートワークとアニメーションの大ファンです！\n最近の「Colorize」の作品もとても好きです！\n\n私のオオカミのキャラクター「ハイレン」を描いてほしいです。\n参考：https://drive.google.com/drive/folders/1vszAcbQ95-yEC5pJT_udvL5oJ05TrzDy?usp=sharing\n\n好きなように描いてください！\nあなたのスタイルに合うように、彼のデザインの細部を自由に変更してください！\n\nご検討ありがとうございます！依頼を受けたら、楽しんで描いてくださいね^^。", "created_at": "", "completed_at": ""}, {"path": "/@mollowmollow/works/34", "thumbnail_src": "https://si.imgix.net/934fb0fa/uploads/outputs/e0859f75-25df-46b8-9283-d6529c6c321c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=725033debc7c892ac7a9008bdda8ba19", "thumbnail_srcset": "https://si.imgix.net/934fb0fa/uploads/outputs/e0859f75-25df-46b8-9283-d6529c6c321c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=725033debc7c892ac7a9008bdda8ba19, https://si.imgix.net/934fb0fa/uploads/outputs/e0859f75-25df-46b8-9283-d6529c6c321c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee3283a174948b4ce396fd494ae353e8 2x, https://si.imgix.net/934fb0fa/uploads/outputs/e0859f75-25df-46b8-9283-d6529c6c321c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b910c5a0dc383dccfb343598cd9dee4 3x", "genre": "video", "nsfw": false, "body": "HIHIです！またまた僕です。今回は曲のカバーPVではないので、何か可愛くて面白いショートビデオをやりましょう！！黒柴のPVは本当に感動しました。僕のOCでも作ってほしいです！好きなようにやってください\n\nhttps://drive.google.com/drive/folders/1icQ1uB7PKx-YorgwaV2dd5mESaqERddY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mollowmollow/works/33", "thumbnail_src": "https://si.imgix.net/a6ccdc0b/uploads/origins/10c69d92-8e88-4a9a-9731-7b65753a7f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff0a033e67f8904e7ee082507cf26292", "thumbnail_srcset": "https://si.imgix.net/a6ccdc0b/uploads/origins/10c69d92-8e88-4a9a-9731-7b65753a7f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff0a033e67f8904e7ee082507cf26292, https://si.imgix.net/a6ccdc0b/uploads/origins/10c69d92-8e88-4a9a-9731-7b65753a7f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8be2bbe1bc6d07680691ef8ce395fad 2x, https://si.imgix.net/a6ccdc0b/uploads/origins/10c69d92-8e88-4a9a-9731-7b65753a7f4a?bg=%23fff&auto=form