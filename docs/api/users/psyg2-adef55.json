的なエフェクトはしき様の解釈やお好みにお任せします。\n\nどこか至らない所があれば申し訳ありません。\n\nどうかご検討をお願い致します。\n\nhttps://twitter.com/psyg2/status/1623201673173942272?t=5DOJQl9xvw1PTaPAsAtghg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@psyg2/works/28", "thumbnail_src": "https://si.imgix.net/87165a3b/uploads/origins/06ac5e07-93f9-443c-b021-736c4a9ac863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db498f8cb5e014d77fa0468affd89424", "thumbnail_srcset": "https://si.imgix.net/87165a3b/uploads/origins/06ac5e07-93f9-443c-b021-736c4a9ac863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db498f8cb5e014d77fa0468affd89424, https://si.imgix.net/87165a3b/uploads/origins/06ac5e07-93f9-443c-b021-736c4a9ac863?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=395d6d4f73e203dfd95f31af49b32217 2x, https://si.imgix.net/87165a3b/uploads/origins/06ac5e07-93f9-443c-b021-736c4a9ac863?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dd0bd79a60937c77baafdfc2cc1c1dc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@psyg2/works/27", "thumbnail_src": "https://si.imgix.net/f559cbd1/uploads/origins/6c72f2b9-6436-455d-b0f9-b734995e4ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=264788e48799d2dca7d145c638fbe9fc", "thumbnail_srcset": "https://si.imgix.net/f559cbd1/uploads/origins/6c72f2b9-6436-455d-b0f9-b734995e4ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&