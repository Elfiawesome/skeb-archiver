ess&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=756413ad96cd55236418761072b5ed44 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートワークはとても素敵ですね添付のキャラクターが机などに足をかけ、椅子に腰掛けてくつろいでいる絵が欲しいです。表情はにっこりとかニヤニヤとか、全体的にリラックスした感じにしてほしいです。手は頭の後ろか、携帯電話や携帯ゲーム機など何かを持っている状態にしてください。\n\nhttps://cdn.discordapp.com/attachments/992285158810062911/1004623990926614569/Bratty_Ben_Ref.png", "created_at": "", "completed_at": ""}, {"path": "/@karubolion/works/7", "thumbnail_src": "https://si.imgix.net/faf1bf21/uploads/origins/2cffd6b0-9ea9-42a3-9c25-265648339665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1856732d5da54cf19cfa9e5a67786294", "thumbnail_srcset": "https://si.imgix.net/faf1bf21/uploads/origins/2cffd6b0-9ea9-42a3-9c25-265648339665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1856732d5da54cf19cfa9e5a67786294, https://si.imgix.net/faf1bf21/uploads/origins/2cffd6b0-9ea9-42a3-9c25-265648339665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7b6dc173ab4a9dd9c428d3e017271f1 2x, https://si.imgix.net/faf1bf21/uploads/origins/2cffd6b0-9ea9-42a3-9c25-265648339665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb983aaf0d3aefc8c41420ef328ff297 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@karubolion/works/6", "thumbnail_src": "https://si.imgix.net/a972e365/uploads/origins/1cf47342-9c24-4ff1-8d8f-80f65a0aa9d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe32f3948077fe7d6bf22d7757708bf4", "thumbnail_srcset": "https://si.imgix.n