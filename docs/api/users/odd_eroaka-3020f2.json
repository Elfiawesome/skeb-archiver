200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ca2a6ed22194e94f24f4afd7ef2df1d 2x, https://si.imgix.net/c0bdd0dd/uploads/origins/afacb290-e62f-48d2-895d-e27431e2b48b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3df2d69fb7e4660a6a61e8c7e0249057 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@odd_eroaka/works/17", "thumbnail_src": "https://si.imgix.net/27fbfede/uploads/origins/de84e442-871b-43a9-aacc-26e3af9ef8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985e96ed4ca200e42b4398ad1465390e", "thumbnail_srcset": "https://si.imgix.net/27fbfede/uploads/origins/de84e442-871b-43a9-aacc-26e3af9ef8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985e96ed4ca200e42b4398ad1465390e, https://si.imgix.net/27fbfede/uploads/origins/de84e442-871b-43a9-aacc-26e3af9ef8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3684472bb1124e409bd31900558b285e 2x, https://si.imgix.net/27fbfede/uploads/origins/de84e442-871b-43a9-aacc-26e3af9ef8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b238404153b30456fa3841e044ee2af 3x", "genre": "art", "nsfw": true, "body": "お世話になります！skeb再開お待ちしておりました！\n以前pixivに上げられていたタイバニのブルーローズのイラストの続編のような作品を描いて頂けないでしょうか？\n\n男のエロNEXTで洗脳され（カメラマン、レポーターも洗脳済み）逆レイプショーを演じてしまう…と言った内容です\n\n「キューティ・アスレイプ」が大変好みでしたのでカラーリップが映える構図ですと嬉しいです…ポルノ女優の様な表情でカメラ目線で下品なプレイをするブルーローズ、とても良かったです。\n\n詳細などはおっどさんの好きなように描いて下さい！絶対その方が素晴らしい作品が出来るので！\n\nそれでは、もしご都合が合いましたらばよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@odd_eroaka/works/16", "thumbnail_src": "https://si.imgix.net/6ba0bc3c/uploads/origins/ce8d72d5-253d-497b-82dd-048564a627f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d8ff625f76c320a125b3bd3c49d4833", "thumbnail_srcset": "https://si.imgix.net/6ba0bc3c/uploads/origins/ce8d72d5-253d-497b-82dd-048564a627f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d8ff625f76c320a125b3bd3c49d4833, https://si.imgix.net/6ba0bc3c/uploads/origins/ce8d72d5-253d-497b-82dd-048564a627f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ffc9bcac8daa844c9527cb761f773b8 2x, https://si.imgix.net/6ba0bc3c/uploads/origins/ce8d72d5-253d-497b-82dd-048564a627f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80484b485051f2bf4c929b3918439c19 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@odd_eroaka/works/15", "thumbnail_src": "https://si.imgix.net/5ffbad3b/uploads/origins/f081da5b-c8d5-4eb2-bcad-05d020eaa3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1bb796ae54c9d0165e42a9b862b148", "thumbnail_srcset": "https://si.imgix.net/5ffbad3b/uploads/origins/f081da5b-c8d5-4eb2-bcad-05d020eaa3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1bb796ae54c9d0165e42a9b862b148, https://si.imgix.net/5ffbad3b/uploads/origins/f081da5b-c8d5-4eb2-bcad-05d020eaa3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0fac681851474b3d06c3f0c5baffb0c 2x, https://si.imgix.net/5ffbad3b/uploads/origins/f081da5b-c8d5-4eb2-bcad-05d020eaa3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a079ff013fd3fd83bd172be7a84c2d69 3x", "genre": "art", "nsfw": true, "body": "以前依頼した辻堂真琴、長谷冴子寝取られビデオレターがめちゃくちゃ良かったので、\n更に発展させた形で依頼したいと思います！\n\n■キャラクター\n辻堂さんの純愛ロードより\n・辻堂真琴\nhttp://minatocarnival.com/tsujidou/chara-makoto.php\nhttps://www.youtube.com/watch?v=pNECO44VSGs　7:16～\n\n・長谷冴子\nhttp://minatocarnival.com/tsujidou/chara-saeko.php\nhttps://www.youtube.com/watch?v=tm0W1XyB99g　10:15～\nhttps://www.youtube.com/watch?v=3M2BF0xjO5k　8:20～\nhttps://www.youtube.com/watch?v=uubfWNwIHqg　0:20～\n\n・竿役（巨根、ガタイのいい黒人）\n\n■シチュエーション\n以前pixivリクエストで作成いただいた寝取られビデオレター（https://odd.fanbox.cc/posts/1917420）の続きです。\n前回の一件以後、都合のいいチンポケースとしてして何度も呼び出され、時には家に押しかけられハメ撮りを繰り返し、撮り貯めた映像をＡＶとして発売されてしまう。\n\n■形式\nＡＶパッケージ風\n\n・表面\n寝トラセ天国の表紙（https://odd.fanbox.cc/posts/2974763）のような感じ。\n\n表面については、\n・糸目の困り笑顔\n・舌出し仰け反り絶頂\nの差分もいただけると嬉しいです。\n\n・裏面\n内容や配置はお任せしますので金額の許す限り、複数のシーンを配置してください。\n\n■備考\n映像を見たパートナーが心を折られるような、BBCの圧倒的な優位性を見せつけるパッケージにしていただきたいです！", "created_at": "", "completed_at": ""}, {"path": "/@odd_eroaka/works/14", "thumbnail_src": "https://si.imgix.net/32bae5d5/uploads/origins/d4dceb18-bedc-4461-a140-976bd85a75ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb1bbf305be70c2b1bd7fefbe67eb213", "thumbnail_srcset": "https://si.imgix.net/32bae5d5/uploads/origins/d4dceb18-bedc-4461-a140-976bd85a75ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb1bbf305be70c2b1bd7fefbe67eb213, https://si.imgix.net/32bae5d5/uploads/origins/d4dceb18-bedc-4461-a140-976bd85a75ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aae2666720bdc1f15698b802d679972a 2x, https://si.imgix.net/32bae5d5/uploads/origins/d4dceb18-bedc-4461-a140-976bd85a75ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf5ce1d3c04ba36a31c3903cc898d766 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@odd_eroaka/works/13", "thumbnail_src": "https://si.imgix.net/18a250de/uploads/origins/0a507dc8-cd62-4706-b5cb-7ed3bb2f1f7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=368f8bb7cd1c302bccc52bd59c1f7348", "thumbnail_srcset": "https://si.imgix.net/18a250de/uploads/origins/0a507dc8-cd62-4706-b5cb-7ed3bb2f1f7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=368f8bb7cd1c302bccc52bd59c1f7348, https://si.imgix.net/18a250de/uploads/origins/0a507dc8-cd62-4706-b5cb-7ed3bb2f1f7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=022047561ee79132030174d438c53f8a 2x, https://si.imgix.net/18a250de/uploads/origins/0a507dc8-cd62-4706-b5cb-7ed3bb2f1f7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b71d3d3f6c5f9ef0a2938e0f9becd18a 3x", "genre": "art", "nsfw": true, "body": "Odd先生、いつもお世話になっております。お忙しい中、募集を再開してくださりありがとうございます。今回お願いしたいお題は、ORCSOFT様の作品『邪娠娼館』に登場する熟女、宗像瑠璃江になります。本作のパッケージがとても気に入っているので、このような感じの逡巡する主人公を誘うような妖しい雰囲気の構図をお願いできればと思います。もしお眼鏡にかなうようでしたら御一考の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@odd_eroaka/works/12", "thumbnail_src": "https://si.imgix.net/3fe306c2/uploads/origins/f8d3d3d5-5e84-422e-bea2-d51d25deed26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869298268e8a0ecefa661a84fce5de46", "thumbnail_srcset": "https://si.imgix.net/3fe306c2/uploads/origins/f8d3d3d5-5e84-422e-bea2-d51d25deed26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869298268e8a0ecefa661a84fce5de46, https://si.imgix.net/3fe306c2/uploads/origins/f8d3d3d5-5e84-422e-bea2-d51d25deed26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d515de720d5253009d5d4d28a34f085 2x, https://si.imgix.net/3fe306c2/uploads/origins/f8d3d3d5-5e84-422e-be