f0e-d811-4b5e-8465-0d789828f09c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4336a896fdfb84e2e15bbb9165a858e, https://si.imgix.net/9558ecdf/uploads/origins/a8798f0e-d811-4b5e-8465-0d789828f09c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f2d73bfc2f83463ea13c10d1f42ba94 2x, https://si.imgix.net/9558ecdf/uploads/origins/a8798f0e-d811-4b5e-8465-0d789828f09c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6c4d9745a37eaf28928b64583509d43 3x", "genre": "art", "nsfw": true, "body": "もちさんこんにちは。\nよろしければうちのスリット竜お兄さんを描いていただきたいです\n\n誘い受けて、衣装は仮面に手足のテカるロングタイツ、濡れてたりスリットか漏れてたり精液まみれだと嬉しいです。あとはお任せします。\n\nhttps://www.furaffinity.net/view/34810887/ https://www.furaffinity.net/view/28457485/ https://www.furaffinity.net/view/16072574/ https://www.furaffinity.net/view/22654236/ https://www.furaffinity.net/view/56581511/\n\nご検討、お願いたします", "created_at": "", "completed_at": ""}, {"path": "/@enen666/works/40", "thumbnail_src": "https://si.imgix.net/3f9611d5/uploads/origins/c7d35112-190d-47ca-acc3-b9c616a114b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34b170cdca694369fbad251271f656d2", "thumbnail_srcset": "https://si.imgix.net/3f9611d5/uploads/origins/c7d35112-190d-47ca-acc3-b9c616a114b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34b170cdca694369fbad251271f656d2, https://si.imgix.net/3f9611d5/uploads/origins/c7d35112-190d-47ca-acc3-b9c616a114b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63c76b869acb543d377725af214c343b 2x, https://si.imgix.net/3f9611d5/uploads/origins/c7d35112-190d-47ca-acc3-b9c616a114b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9f61c8ae08109ee63827b9626c17eeb 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！僕のキャラクター、ムーンムーンも描いてもらえますか？\n\n彼女は灰色の狼です。彼女はまた、水の精霊に祝福されたダンサーでもあります。残念なことに、彼女はとてもバカで愚かでもあります。それを表現するために、いつも彼女の目はいろいろな方向を見ています。\n\n彼女の色のついた絵は