254_134271628.jpg\n・https://ae01.alicdn.com/kf/H1ff3d958ebff4cbe9d16939f34214d7b4/-.jpg", "created_at": "", "completed_at": ""}, {"path": "/@marurumadoka/works/98", "thumbnail_src": "https://si.imgix.net/80566391/uploads/origins/db9928d3-e500-4da8-abe9-cb84744d1249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4636c5ea337feeed4e44242e3c8ceb6", "thumbnail_srcset": "https://si.imgix.net/80566391/uploads/origins/db9928d3-e500-4da8-abe9-cb84744d1249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4636c5ea337feeed4e44242e3c8ceb6, https://si.imgix.net/80566391/uploads/origins/db9928d3-e500-4da8-abe9-cb84744d1249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2aca060127d6d5e5804cb5409a63b165 2x, https://si.imgix.net/80566391/uploads/origins/db9928d3-e500-4da8-abe9-cb84744d1249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af7a235a44f65be1b62e20bc235132ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marurumadoka/works/97", "thumbnail_src": "https://si.imgix.net/4beada76/uploads/origins/f6d3132e-bf80-4bd7-b1a6-f35291678bde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74ee938e562d634654441033ce4b2ffc", "thumbnail_srcset": "https://si.imgix.net/4beada76/uploads/origins/f6d3132e-bf80-4bd7-b1a6-f35291678bde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74ee938e562d634654441033ce4b2ffc, https://si.imgix.net/4beada76/uploads/origins/f6d3132e-bf80-4bd7-b1a6-f35291678bde?bg=%23fff&auto=format%2