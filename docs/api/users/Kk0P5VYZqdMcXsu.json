ive.google.com/drive/folders/1-MAMdswA7_0KaYqDgwkgbqUDgAVVzh7K", "created_at": "", "completed_at": ""}, {"path": "/@Kk0P5VYZqdMcXsu/works/150", "thumbnail_src": "https://si.imgix.net/b67d1c84/uploads/origins/780bbb93-8d84-4dee-9c3f-acd4ad3f9e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310862c56a1aef180d547ce9f4f83c44", "thumbnail_srcset": "https://si.imgix.net/b67d1c84/uploads/origins/780bbb93-8d84-4dee-9c3f-acd4ad3f9e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310862c56a1aef180d547ce9f4f83c44, https://si.imgix.net/b67d1c84/uploads/origins/780bbb93-8d84-4dee-9c3f-acd4ad3f9e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8675af3eaeb9a02dd8f10df0b551267 2x, https://si.imgix.net/b67d1c84/uploads/origins/780bbb93-8d84-4dee-9c3f-acd4ad3f9e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25a7b2c4581095c2380851a3fe85522e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！提案されたアイデアがとても気に入ったので、そのポーズで描いてほしいです！可能であれば、彼の服装も描いてください！ありがとうございました！\n\nhttps://drive.google.com/file/d/1JkNe9LzqRNUYzmouyXbi7rNYZ6yPhlvY/view", "created_at": "", "completed_at": ""}, {"path": "/@Kk0P5VYZqdMcXsu/works/149", "thumbnail_src": "https://si.imgix.net/8c84e002/uploads/origins/f14e08c2-3a7e-4c8f-865f-861e55536da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7911a263327220d069ba6eaa1dee327", "thumbnail_srcset": "https://si.imgix.net/8c84e002/uploads/origins/f14e08c2-3a7e-4c8f-865f-861e55536da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7911a263327220d069ba6eaa1dee327, https://si.imgix.net/8c84e002/uploads/origins/f14e08c2-3a7e-4c8f-865f-861e55536da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd011f8c37e9264ee6d703722634c1bc 2x, https://si.imgix.net/8c84e002/uploads/origins/f14e08c2-3a7e-4c8f-865f-861e55536da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&