4da-ae8b-89fb1045ddbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bb10f3284d989ceb25655600b8eb37b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/52", "thumbnail_src": "https://si.imgix.net/706767c6/uploads/origins/6ecc5bcb-5588-45ae-9632-2d711cca6b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de541c0d6942aa7e07046283c2d5d31", "thumbnail_srcset": "https://si.imgix.net/706767c6/uploads/origins/6ecc5bcb-5588-45ae-9632-2d711cca6b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de541c0d6942aa7e07046283c2d5d31, https://si.imgix.net/706767c6/uploads/origins/6ecc5bcb-5588-45ae-9632-2d711cca6b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ab239856e7228383fafa278ce2fb564 2x, https://si.imgix.net/706767c6/uploads/origins/6ecc5bcb-5588-45ae-9632-2d711cca6b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b1975123d0cc4a05fc73c25a2938233 3x", "genre": "art", "nsfw": true, "body": "バニーいいですよね……。\nおっぱいやおしりが大きいバニーはさらにいいですよね……。\nというわけで、くーよんさんのキャラクター同士の\nバニー衣裳でのどえっちなレズキスシーンを何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/51", "thumbnail_src": "https://si.imgix.net/1fb2506f/uploads/origins/ffd28004-3470-40f4-a367-27bb74918e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e45cc001874af158e411a3cb7837a021", "thumbnail_srcset": "https://si.imgix.net/1fb2506f/uploads/origins/ffd28004-3470-40f4-a367-27bb74918e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e45cc001874af158e411a3cb7837a021, https://si.imgix.net/1fb2506f/uploads/origins/ffd28004-3470-40f4-a367-27bb74918e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8367a6bf61f1a9639f1e803dfbf4ec2a 2x, https://si.imgix.net/1fb2506f/uploads/origins/ffd28004-3470-40f4-a367-27bb74918e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d9057f1af58b4a31587c97b62752cc1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、クーラと言います。\nくーよんさんのイラストを見てすごく可愛く思いまして是非うちの子も描いていただきたいと思いリクエストさせていただきました！\n虎柄の灰色狐で背中に赤色の羽根が生えています。\nポーズや構図などはおまかせいたしますが羽のある子なので羽根が活かされたポーズをお願いしたいです。服は資料を見ていただくかカジュアルに変えていただいても無しでも大丈夫です。\n参考資料\nhttps://twitter.com/kurlas/status/1531558956262637568\nhttps://twitter.com/kurlas/status/1668238901465731073\n\nよろしくお願いします！\n\nhttps://twitter.com/kurlas/status/1531558956262637568", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/50", "thumbnail_src": "https://si.imgix.net/0b892cfa/uploads/origins/b41824b2-d04d-494e-be27-340e9af912d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2cc90698dfe6c16eb48dc35aaf54443", "thumbnail_srcset": "https://si.imgix.net/0b892cfa/uploads/origins/b41824b2-d04d-494e-be27-340e9af912d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2cc90698dfe6c16eb48dc35aaf54443, https://si.imgix.net/0b892cfa/uploads/origins/b41824b2-d04d-494e-be27-340e9af912d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8b746ffe80b2d79cd6258e8815b4549 2x, https://si.imgix.net/0b892cfa/uploads/origins/b41824b2-d04d-494e-be27-340e9af912d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b38ddce3c1695c6cc362d04146830f2b 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております。\n今回は刀（短刀）のデザインをお願いしたくリクエストさせてもらいました。\nおまかせ設定そのままでリクエストさせてもらいましたが、内容的に大丈夫そうでしたら宜しくお願いします。\n\nいつも描いて頂いているウチの子（歌彩亜矢）が15年ほど前にPBW（ウェブ上で行うTRPGみたいなコンテンツ）で使用していた武器をイラスト化して頂きたく思います。\n以下に当時設定していた説明文をザっと書かせてもらいます。\n・歌彩家の蔵から「八咫烏」と書かれた古ぼけた桐の箱に入った状態で発見された三振の刀\n・一振は刀身40ｃｍ程の反りの無い忍刀で残り二振は刀身30ｃｍ程の脇差という異色の組み合わせ\n・三振とも刀身は刃以外は漆黒\n・どれにも銘は切られていないため出自は不明だが三振揃って「八咫烏」と名付けられた物と思われる\n\nみたいな感じになります。\n忍刀のみ鍔を大きめに、鞘の鐺は金属製で鋭角に、下緒は長めに描いて頂けると幸いです。\n詳細なデザイン等々は完全にお任せ致しますので、筆の乗るままご自由に描いてくださって大丈夫です。\n色々と難解なリクエストかもしれませんが、問題なさそうでしたら是非よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/49", "thumbnail_src": "https://si.imgix.net/999f7ca1/uploads/origins/41678ccf-62ab-4d2d-92f4-6dbd2bbc76ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188e6ba9c9c2d4d64795fb4e141ec781", "thumbnail_srcset": "https://si.imgix.net/999f7ca1/uploads/origins/41678ccf-62ab-4d2d-92f4-6dbd2bbc76ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188e6ba9c9c2d4d64795fb4e141ec781, https://si.imgix.net/999f7ca1/uploads/origins/41678ccf-62ab-4d2d-92f4-6dbd2bbc76ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=398bc87a4ef0652e5af6315aa7a65c40 2x, https://si.imgix.net/999f7ca1/uploads/origins/41678ccf-62ab-4d2d-92f4-6dbd2bbc76ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bccb6621fc50f713352c42f018424a5 3x", "genre": "art", "nsfw": true, "body": "手数料無料期間！そこで１１月に描いた絵のハートくださいシリーズを見て思いつきましたので依頼させて頂きます。\n\n例によって資料の銀髪褐色メスガキギザ歯貧乳刺青ロリダークエルフのカティちゃんについてとなりますが…手でハートを形作っておまんこに押し当てる、おっぱいハートのおまんこ版！おまんこハート！（pixiv15作品HIT）姿をお願いしたいと思います。\n\n衣装状態やハートの向き、足の開き方など細かい点はお任せしたいと思います。\n\nご検討よろしくお願いいたします。\n\n\nご参考※資料更新日2023年11月\nhttps://twitter.com/wagunasu_TS/status/1298940810973470720\n\nhttps://drive.google.com/file/d/1MLcawzZe5S9-84Lv1sPfyfjyIldDok3f/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/48", "thumbnail_src": "https://si.imgix.net/48d133b3/uploads/origins/41585d81-ee9d-4e93-b392-536c826f9895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb270c7c1358a814bc4e9afbe1f7e770", "thumbnail_srcset": "https://si.imgix.net/48d133b3/uploads/origins/41585d81-ee9d-4e93-b392-536c826f9895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb270c7c1358a814bc4e9afbe1f7e770, https://si.imgix.net/48d133b3/uploads/origins/41585d81-ee9d-4e93-b392-536c826f9895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cf57cf395e0443ac23b386cdc4ddd24 2x, https://si.imgix.net/48d133b3/uploads/origins/41585d81-ee9d-4e93-b392-536c826f9895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c56f7f1ce67f08632cd7a6f97e514dc 3x", "genre": "art", "nsfw": false, "body": "何時も素敵なイラストありがとうございます。\n今回の依頼はうちの子サイカさん（https://skeb.jp/@Jasdgkd/works/6）が前世（現在は転生後なので模造した贋作）に持っていた短刀のデザイン依頼になります。\nなお今回は特にデザイン画はありませんので好きにデザインしていただいて構いません。ただ資料不足であればデザイン後に再度依頼したいと思います。\n以下が刀の概要です。\n\n銘：「耀変正宗」\n\n概要：元は鎌倉期に地球に降り立った「宇宙から来た狩人」が五郎入道正宗より譲り受けた刀で代々狩人の一族に受け継がれてきたものである。\nベトナム戦争時に密林奥深くの王国で宇宙恐怖的存在を相手に共闘した際、恩賜の軍刀と交換し生涯戦場に帯刀される。\n茎に正宗の銘が入っており本来なら重文〜国宝級の逸品。その道に詳しい戦友に所有と使用が露見した際には殺人的憎悪を受けた。\n材質に相州に降った流れ星（隕鉄）を使用し、更に長い年月の使用とベトナムにおける宇宙恐怖との戦いを経て侵星存在に対する特効を持つ。\n最期は中東のある国で使用者が死去した際に喪われ、当世には戦友が撮った幾枚かの写真とメモが残るのみである。\n\n刀身：刃長40㎝、茎長13㎝（約数）。刃文は光の角度で玉虫色の光彩が輝き、これが耀変たる銘の由来である。なお刀身の長さは三十年式銃剣に近く別称に「銃剣正宗」がある。\n\n拵え：独逸影響下の日本で作られた物。元は鎌倉末期〜南北朝時代初期のものであったが破損・老朽化が酷かった為、現代（1960年代〜1970年代）で改められた。基本は日本刀の脇差（短刀）だが、独逸の軍用短刀の形状も入っている。\n\nまた使用者であるサイカさんの使用時イラストも一緒にお願いしたいと思います。基本戦闘スタイルは左手に短刀、右手に回転拳銃を持ったものになります。\n可能であれば某所でおそらく描かれていたと思われるオリジナル鬼ころ隊隊士のような感じでお願いしたいですが、基本お任せします。これは参考なので白黒もしくはラフで構いません。\n\n※他のクリエイター様に納品物を参考に描いていただくかもしれません。金銭目的には使用しません。あくまで個人で楽しむ為に依頼します。\n\n資料はURL先に入れています。何卒ご検討のほどよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/lo4uxl6yfu1bhju9qg8ys/h?rlkey=551kxdy4v2tqrdjok45kzzhou&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/47", "thumbnail_src": "https://si.imgix.net/30f4d674/uploads/origins/b8361746-0497-41d6-a4c2-f4296ccc8758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c6970e9d1c9fb9bc2db6355336d193d", "thumbnail_srcset": "https://si.imgix.net/30f4d674/uploads/origins/b8361746-0497-41d6-a4c2-f4296ccc8758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c6970e9d1c9fb9bc2db6355336d193d, https://si.imgix.net/30f4d674/uploads/origins/b8361746-0497-41d6-a4c2-f4296ccc8758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48515d402e3c8f52b0b7349e57c19039 2x, https://si.imgix.net/30f4d674/uploads/origins/b8361746-0497-41d6-a4c2-f4296ccc8758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=121b7811e9c965d8e77d99a4aa9aeafd 3x", "genre": "art", "nsfw": true, "body": "私のリンクに問題があることを発見し、修正しました。ご迷惑をおかけして本当に申し訳ありません。\n======\n\n先生のデザインはかなり面白いし、アートスタイルも好きだ。\n\n足枷と手枷の役割を同時に果たす靴をデザインしてほしい。(エロ囚人服の一部と考える)\n\n色は黒で、わずかに反射している。\n\nこの靴は、水泳のジャンプスタートの準備ポーズに似たポーズでキャラクターを保持する必要があります。キャラクターを保持するポーズについては、このアートワークを参考にしてください。\n[https://drive.google.com/file/d/106M1aXH0FR4w3NtCZvSS8u21Hdhu7J3J/view?usp=sharing]\n\nデザインは自由ですが、丸いつま先のメリージェーンの革靴のデザインをベースにして、靴のストラップと靴の内腰の後部の一部を足枷のリングとしてデザインし直して、2つのリングをチェーンでつないでほしいです。\n\n靴と靴を直接しっかりとロックするロックが必要だ。枷のチェーンに空いたスペースで、キャラクターがかろうじて歩き回れる状況が想像できるだろう。キャラクターが目的地に到着した後、2つの靴をロックすれば、キャラクターはジャンプする以外に移動できなくなるが、ポーズのせいでジャンプは非常に難しくなる。\n\nロックは靴底に配置し、2つの靴が横に並んだときにロックが靴を強制的にロックできるようにするのがいいと思う。\n\n手錠の部分は、手を自由に動かせないようにして、キャラクターの足に縛り付ける\n\n======\n\nノーマルタイプとハイヒールタイプの2種類。ハイヒールタイプは、ヒールの高さが10センチ前後であること。(ヒールの高さを増すだけで、靴底は厚くない。)\n\n可能であれば、様々な角度から見た靴の外観と、ロックとロックの解除の段階を提供してください。\n\nキャラクターがこの靴に閉じ込められる例を描きたいのであれば、【https://skeb.jp/@PhqU9i/works/17】と【https://skeb.jp/@ryu_insect/works/33】に出てくるキャラクターをモデルにすることができる（主に服装のためで）。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/46", "thumbnail_src": "https://si.imgix.net/e5bd9ccb/uploads/origins/4c287c9b-8675-40f8-bcdb-a7ff5cde8414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902aa3df08db97d4bfc02f309712edcd", "thumbnail_srcset": "https://si.imgix.net/e5bd9ccb/uploads/origins/4c287c9b-8675-40f8-bcdb-a7ff5cde8414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902aa3df08db97d4bfc02f309712edcd, https://si.imgix.net/e5bd9ccb/uploads/origins/4c287c9b-8675-40f8-bcdb-a7ff5cde8414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eea7cb2460e138e414c5747715f44fa 2x, https://si.imgix.net/e5bd9ccb/uploads/origins/4c287c9b-8675-40f8-bcdb-a7ff5cde8414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f266bd19af928d6d7e2789c766621f0b 3x", "genre": "art", "nsfw": true, "body": "うちの子（いわゆるオリジナルキャラクター）の悪魔っ娘レインを描いていただけないでしょうか。\n\n\n\nキャラ：レイン（資料URLご参照ください）\n\nシチュ、構図など：\n・ポーズ、シチュなどはおまかせでお願いします\n・魅せたいと思った箇所メインに描いていただければと思います\n・白の薄地の極小マイクロビキニ\n　（乳首の色や形、まんスジがわかるくらいの。構図的に見えなくなる場合は無視していただいて構いません）\n・スケベなイラストを求めています\n・肌の色は青肌と人肌色の2パターンありますが、お好みの方でお願いします\n・他はおまかせでお願いします\n・ケツニクマシマシオッパイオオキメフトモモフトメ\n\n依頼用資料や紹介としてSNSやドライブ等で利用させていただければと思います。\n\nご検討のほどよろしくお願いいたします。\n\n参考資料\nhttps://drive.google.com/drive/folders/1C4oKH4kBQs6b5mydcWiN23dDQLV_pzzC", "created_at": "", "completed_at": ""}, {"path": "/@fangwy/works/45", "thumbnail_src": "https://si.imgix.net/8a8f9ff8/uploads/origins/24e8386c-62ed-4ed4-b646-0e7c27c59afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e0b70010a4f27f7c9f840842c2de09", "thumbnail_srcset": "https://si.imgix.net/8a8f9ff8/uploads/origins/24e8386c-62ed-4ed4-b646-0e7c27c59afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e0b70010a4f27f7c9f840842c2de09, https://si.imgix.net/8a8f9ff8/uploads/origins/24e8386c-62ed-4ed4-b646-0e7c27c59afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2c4851bc4c327d592f471e47885d3b1 2x, https://si.imgix.net/8a8f9ff8/uploads/origins/24e8386c-62ed-4ed4-b646-0e7c27c59afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b64e3885b69d1a1255e9af02fd42368a 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回はNSFWでお願いしたく思います。\n少々難解なリクエスト内容かもしれませんので、難しそうでしたらキャンセルして頂いて全然OKです。\n大丈夫そうでしたら是非とも宜しくお願いします。\n\n前提として、いつものようにウチの子（資料URL参照）をモデルに作品をお願いします。\n内容についてですが、くーよん様が現状で一番エッチぃと思われる構図・ポーズでウチの子を描いて頂ければと思います。\nこんな内容はNGという事は一切ございませんので、リビドーの赴くがままお好きな様に描いてくださって大丈夫です。\nあと、ウチの子（歌彩亜矢）ですが、実は陥没乳首設定だったりするので、乳周りの描写をされる場合は、そのように描いて頂けると嬉しいです。\n\n内容的に投げっぱなしかつ難解な感じですが、大丈夫そうでしたらお願いし