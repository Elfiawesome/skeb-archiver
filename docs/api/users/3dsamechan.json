dfc-c3610793d273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2c7de21e3d4f0361820aa9f51f74df1, https://si.imgix.net/6226c4e7/uploads/origins/2439c93d-8b07-400c-9dfc-c3610793d273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7c7af0539d7bc6fdfef78d0190ec889 2x, https://si.imgix.net/6226c4e7/uploads/origins/2439c93d-8b07-400c-9dfc-c3610793d273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3577d04c61a724a14911460b32261c83 3x", "genre": "art", "nsfw": false, "body": "西瀬さめ　様\n\nはじめまして\n個人観賞用にイラストをお願いしたく\n下記のURLのうちの子を描いていただけないでしょうか？\nhttp://t-walker.jp/eb/status/?chrid=c14474\nhttp://t-walker.jp/illust/product/tw_c/144/f_c14474_pdt_1.jpg\n\nリクエスト内容\n・服装は資料イラストのドレス姿\n・上半身アップのバストアップもしくはウエストアップ\n・上目遣いで見上げる、もしくは前かがみ等、胸の谷間が強調されるようなポーズ、構図でお願いします。\n\n以上、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@3dsamechan/works/105", "thumbnail_src": "https://si.imgix.net/dda06964/uploads/origins/a4595e29-17e2-4229-86b5-d3ba265f3b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e48eb664b8c81b76c4d54fa00681d271", "thumbnail_srcset": "https://si.imgix.net/dda06964/uploads/origins/a4595e29-17e2-4229-86b5-d3ba265f3b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e48eb664b8c81b76c4d54fa00681d271, https://si.imgix.net/dda06964/uploads/origins/a4595e29-17e2-4229-86b5-d3ba265f3b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66cdede9a2a9dbba379559eb01c9315c 2x, https://si.imgix.net/dda06964/uploads/origins/a4595e29-17e2-4229-86b5-d3ba265f3b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37a885e96078d5d97fcb90416ed51380 3x", "genre": "art", "nsfw": false, "body": "西瀬さめ 様\n\nはじめまして，ぬーと申します\n個人Vsinger（Vtuber）のさざなみセレナさんのイラストを\n描いていただきたくリクエストをさせていただきました\n\n【使用用途】\n・さざなみセレナさん本人へのプレゼント用\n・収益化しているYoutubeチャンネルのサムネイル\n・SNSでの投稿，プロモーション\n\n【イメージ】\nライブステージで美しく凛々しく歌ってるようなお姿でお願いします\n万が一可能ならスタンドマイクの差分を付けて貰えるととても嬉しいです\nポーズや他の要素については全てお任せいたします\n\n\n参考資料\nhttps://drive.google.com/drive/folders/1WG6VUbYt7sdi4FH_NB3bwo_oNWzzkVB0\n\n【お願いしたいこと】\n髪や腕などが見切れないよう描写範囲に収めていただき\n全てがレイヤー分けされたPSD(または透過PNG)で納品していただけますと\n本人がサムネイル等に使用する際，自由度が高まるので助かります\n\n何卒，よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@3dsamechan/works/104", "thumbnail_src": "https://si.imgix.net/69fa6ba5/uploads/origins/899295fb-c53f-4736-aab5-ce4e3fc14422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39cee364c91843b689a543bbb7e04036", "thumbnail_srcset": "https://si.imgix.net/69fa6ba5/uploads/origins/899295fb-c53f-4736-aab5-ce4e3fc14422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39cee364c91843b689a543bbb7e04036, https://si.imgix.net/69fa6ba5/uploads/origins/899295fb-c53f-4736-aab5-ce4e3fc14422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba3abe0cd886af8f17758c312ed89003 2x, https://si.imgix.net/69fa6ba5/uploads/origins/899295fb-c53f-4736-aab5-ce4e3fc14422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dd27d3499be2d2066e1541e1c098216 3x", "genre": "art", "nsfw": false, "body": "こんにちは　西瀬さめ先生　いつも大変お世話になっております\nVariumの他メンバーでケモ耳の子がおりその子を書いて頂きたく、依頼させていただきました\n\n【書いていただきたい方】\nVarium所属　VTuberの「飴望にぃな」さん(@amemochinina)のイラストをお願いしたいです\n（フェネックモチーフのVTuberさんです）\n\nガイドライン的に二次創作は大丈夫です\nhttps://varium.jp/guide_line/\n\n【目的】\n飴望にぃなさんのサムネやXなどでの使用です\nVTuber活動に使えるように許可をいただけると幸いです\nプレゼント時に先生のXのIDとAI禁止の文言を付けてポストさせていただきたいです\nまたは自分での鑑賞用です\n\n【リクエスト事項】\n2月ににぃなさんの新衣装「ジャージメイド」が出たのでこちらの衣装でイラストをお願いします\n\n構図などは先生におまかせいたします\n\nもし可能であれば表情差分もいただけると幸いです\n\n飴望にぃなさんがサムネで使うことができるように、背景なしや文字なしのレイヤーを分けたPSDファイルでも納品していただけると嬉しいです\n\n【参考資料】\nXの新衣装のキービジュアルです\nhttps://x.com/varium_info/status/1895005952480317524\n\nXの通常衣装の三面図です\nhttps://x.com/amemochinina/status/1673995372732248065\n\n（参考までに）通常衣装新キービジュアルです\nhttps://x.com/amemochinina/status/1883498121180963208\n\n事務所の公式HP（タレントページ）です\nhttps://varium.jp/talent/nina/\n\nいつもとても素敵なイラストをありがとうございます\nご検討の程よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@3dsamechan/works/103", "thumbnail_src": "https://si.imgix.net/0ff88933/uploads/origins/0500973e-030a-4ed1-9d7c-e8aae22fa1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abcda1d987294e253e71f7750a670694", "thumbnail_srcset": "https://si.imgix.net/0ff88933/uploads/origins/0500973e-030a-4ed1-9d7c-e8aae22fa1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abcda1d987294e253e71f7750a670694, https://si.imgix.net/0ff88933/uploads/origins/0500973e-030a-4ed1-9d7c-e8aae22fa1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11289733dbe1ddf9b8b0e342980eec07 2x, https://si.imgix.net/0ff88933/uploads/origins/0500973e-030a-4ed1-9d7c-e8aae22fa1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a482f97f842fb06db468b0cd0017626 3x", "genre": "art", "nsfw": false, "body": "西瀬さめさん\n\n前回の立ち絵めっちゃ良かったです！！\n最高でした。\n\n本当に可愛いし美しいし気に入りました！！\nイラスト見てて新しい差分欲しくなったので別途依頼させて頂きました。\n\n○描いて欲しいもの\n前回納品されたレースクイーン衣装の追加差分\nイメージは日焼けギャル差分って感じ\n\n追加差分の内容としては\n①レースクイーン衣装は日焼けが似合うと思うので日焼け差分をお願いしたいです\n日焼け度合いとしてはFGOの水着BBの第二再臨、FGOのサマバケ鈴鹿御前くらい（調べると出てくると思います）\nこんがり小麦色って感じです\n\nまた、肌の色を日焼けさせるにあたって、肌の色に合うように髪の色を少し濃くするや服など他の部分の色もちょっと合わせてマイナーチェンジして欲しい感じです\n\n②汗差分\n日焼けするほど暑いってことなんで\n取り外しできる汗差分つけて欲しいです。顔、胸元、足などに汗が垂れてるイメージ\nこれだけオンオフできるようにしてください\n\n③顔にタトゥーシール差分\nハートとか星のタトゥーシール\nそんなにたくさんつけておらず、マーク１つくらい\nこれもオンオフできるようにしてください\n\n以上です\nよろしかったらお願いします！！\n\nあと、今回差分だけなんで、もし余力あったらでいいんで何かおまけ描いてくれると嬉しいです。（今まで描いてもらったどの衣装の子でもいいですし一枚絵でなくてもラフなスケッチなようなものでもなんでもいいので何かおまけ要素あると嬉しいです）\n金額的に差分だけじゃないと厳しいならそれでオッケーです\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@3dsamechan/works/102", "thumbnail_src": "https://si.imgix.net/f08b24b5/uploads/origins/728afab6-4bc4-4a03-9922-23b28685bbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cc27d114da70802a3ce66408df3d62f", "thumbnail_srcset": "https://si.imgix.net/f08b24b5/uploads/origins/728afab6-4bc4-4a03-9922-23b28685bbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cc27d114da70802a3ce66408df3d62f, https://si.imgix.net/f08b24b5/uploads/origins/728afab6-4bc4-4a03-9922-23b28685bbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09c2ee51281c8640064d1c9623b08ffb 2x, https://si.imgix.net/f08b24b5/uploads/origins/728afab6-4bc4-4a03-9922-23b28685bbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa3a2e735611a869e99a41b86d17eb73 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも立ち絵を書いて頂いてる桟敷です。\nさめさんに描いてもらった立ち絵はどれも本当に気に入ってまして、また私のオリキャラのイラストを描いてもらいたいと思い依頼しました。\n\n↓いつものこの女の子です。 \nhttps://skeb.jp/@3dsamechan/works/54  \nhttps://skeb.jp/@3dsamechan/works/94\n\n依頼が立て続けになってしまいましたが、よろしければお願いします。(この前納品してもらったイラストがめちゃくちゃ気に入り、新しくこの衣装が見たいというアイデアが浮かんできました)\nまた、今回いつものイラストよりも少し肌色分が大きいと思います。NSFWには当たらないと思うんですが、露出度やスケジュールなど都合悪ければキャンセルしてください。\n\n〇描いてもらいたいもの \n\n以前描いてもらった私のピンク髪のオリキャラです \n身長162cm、かなりの巨乳で包容力マシマシ、年齢は20代半ばのイメージ\n星がモチーフの女の子で、目は緑色の目で星のハイライトあり\nこの子の別衣装を描いてもらいたいです\n\n今回私が描いてもらいたいのはレースクイーン衣装になります\n\n○設定イメージ\n金欠でスカウトマンから稼げるバイトを紹介してもらったオリキャラちゃん\nその稼げるバイトとはレースクイーンだった\n最初はレースクイーンの格好に羞恥心をもっており辞めたいと思っていたが、時給を聞いて恥ずかしいけど続けるか……と決意する。\nなんだかんだで周りから褒められていくうちに満更でもなくなっていくのであった。みたいな感じ\n\n○見た目のイメージ  \n\nセクシーなレースクイーンのお姉さんといった感じ\n\n髪型→長髪をポニーテールにまとめてる\nアクセサリー→帽子を付けてる(レースクイーンがよくつけてるサンバイザー付きの帽子)\n髪型と帽子に関してはポケカのMCの盛り上げってカードのイラストがイメージ近いかもです\n\n服装→下のリンクみたいな近未来サイバー風レースクイーン衣装 \nhttps://www.amazon.co.jp/LOST-G-ハイレグ水着-レースクイーン-コスチューム-レディースcosplay/dp/B0C34CD8B7?ref_=ast_sto_dp\n\nhttps://www.amazon.co.jp/LOST-G-レースクイーン-アームカバー-全身コスチューム-レディースcosplay/dp/B0CLLYQQZW?ref_=ast_sto_dp&th=1&psc=1\nみたいな感じ、へそ出してて袖とかニーハイブーツがある\n\n持ち物→レースクイーンがよくもっているようなフラッグ\n\nURLは雰囲気の参考といった感じで細かいところや全体のデザインはお任せします(露出多すぎと思ったら少し減らして貰っても大丈夫です)\nキャラの衣装や絵に関しては素人なのでさめさんが一番似合うと思ったように色とか服の形とかデザインは好きなように書いてくれて構いません。よろしくお願いします。\n立ち絵のポーズはお任せです。\n\n○差分 \n\n今まで描いて頂いた表情差分は全て可愛く