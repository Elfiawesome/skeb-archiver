%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f921dda2a52880ac5ca3b86b44f7808", "thumbnail_srcset": "https://si.imgix.net/749f2045/uploads/origins/c073d48f-46f9-416c-8d38-e7143b75a891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f921dda2a52880ac5ca3b86b44f7808, https://si.imgix.net/749f2045/uploads/origins/c073d48f-46f9-416c-8d38-e7143b75a891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13aff3121e3af38f18379ae6746338b5 2x, https://si.imgix.net/749f2045/uploads/origins/c073d48f-46f9-416c-8d38-e7143b75a891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7681750c18ea95fef1fe18b17666ca59 3x", "genre": "art", "nsfw": true, "body": "あなたの作品が大好きです！僕（Mod）と僕の女友達のOC（Jhel）が小さなサメの女の子を支配しているところを描いてください。Modは後ろに立って、銃口をつけて、サメの女の子を貫いています。Jhelはサメ女のリードを引っ張って、サメ女の中でModのペニスの膨らみに乗っている。サメ女はお好みで！\n\nhttps://drive.google.com/drive/folders/1F7L_WdhdIvbHwgXhxtprIi4Dq4FdraE9", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/22", "thumbnail_src": "https://si.imgix.net/ac711b4b/uploads/origins/0d8d36e0-8554-4ce2-b3aa-cdf5811b99b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07a71b60649e176ffc1f0a6590e5c19c", "thumbnail_srcset": "https://si.imgix.net/ac711b4b/uploads/origins/0d8d36e0-8554-4ce2-b3aa-cdf5811b99b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07a71b60649e176ffc1f0a6590e5c19c, https://si.imgix.net/ac711b4b/uploads/origins/0d8d36e0-8554-4ce2-b3aa-cdf5811b99b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86bc1d6bf1afe25d22297d676daea389 2x, https://si.imgix.net/ac711b4b/uploads/origins/0d8d36e0-8554-4ce2-b3aa-cdf5811b99b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f56ef1047ce6681b0dfca63a5c2443f 3x", "genre": "art", "nsfw": true, "body": "ファンタがバッキーに股を開くシーン。この作品と同じポーズで、サイズも同じです (https://twitter.com/sijimmy456/status/1621495089301458947?s=46&t=l9S5L2Oi-TBm9AG4dMrXrQ)\n\n次に、ファンタがバッキーに馬乗りになっているシーンをクローズアップ。彼女の大きなお尻を見せながら、ボックスでキスをする。\n\nhttps://drive.google.com/drive/folders/1-40y1PFp4CD1lDIdhF_eDR2cBfimVdQW", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/21", "thumbnail_src": "https://si.imgix.net/a4c0663e/uploads/origins/827f1d46-2568-46d5-89dd-dcc8f1a33045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b2b49c76105953000fae63203c806bb", "thumbnail_srcset": "https://si.imgix.net/a4c0663e/uploads/origins/827f1d46-2568-46d5-89dd-dcc8f1a33045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b2b49c76105953000fae63203c806bb, https://si.imgix.net/a4c0663e/uploads/origins/827f1d46-2568-46d5-89dd-dcc8f1a33045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a25a654d4cdcc5be282dab84bfbaac70 2x, https://si.imgix.net/a4c0663e/uploads/origins/827f1d46-2568-46d5-89dd-dcc8f1a33045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7999d3bd77cb3573c5c171fbaed425f0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/20", "thumbnail_src": "https://si.imgix.net/b8ad3c35/uploads/origins/52e0ae15-5628-4efb-a42a-91431947cd24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b4afb743e889259f209da865d89b98", "thumbnail_srcset": "https://si.imgix.net/b8ad3c35/uploads/origins/52e0ae15-5628-4efb-a42a-91431947cd24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b4afb743e889259f209da865d89b98, https://si.imgix.net/b8ad3c35/uploads/origins/52e0ae15-5628-4efb-a42a-91431947cd24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c3cf87594d462ae9ec0dc35e2c74336 2x, https://si.imgix.net/b8ad3c35/uploads/origins/52e0ae15-5628-4efb-a42a-91431947cd24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8845952eebd99f2815d9cc3625037104 3x", "genre": "art", "nsfw": true, "body": "私の女狐キャシーをリクエストしたい。パープルのビジネススーツ姿で、視聴者にお尻を見せびらかしたい。アソコが見えるようにノーパンでお願いします。彼女のマンコがザーメンを垂れ流し、彼女が孕んでいることを示す大クリームの別バージョンが見たい。\n\nhttps://www.dropbox.com/s/hc0jzsneru0trxr/a94mKlZ.jpg?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/19", "thumbnail_src": "https://si.imgix.net/702d0229/uploads/origins/c88c95c0-8dbb-4347-bf0e-fac7983261b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3b959e71ac9e5576c0340c9784ea13d", "thumbnail_srcset": "https://si.imgix.net/702d0229/uploads/origins/c88c95c0-8dbb-4347-bf0e-fac7983261b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3b959e71ac9e5576c0340c9784ea13d, https://si.imgix.net/702d0229/uploads/origins/c88c95c0-8dbb-4347-bf0e-fac7983261b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f586a34b206679e635b7581a5278ff38 2x, https://si.imgix.net/702d0229/uploads/origins/c88c95c0-8dbb-4347-bf0e-fac7983261b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11a43d25f11d412fefc24b9fcf757686 3x", "genre": "art", "nsfw": true, "body": "ピンクのパーカーを着たファンタが黒と白のショートパンツを下ろし、大きなお尻を見せつけ、視聴者をドヤ顔で振り返るショット。もう一枚は、パーカーをたくし上げて大きな胸を見せつけるファンタのショット。\n\nhttps://twitter.com/notfantaad/status/1674177437373005824?s=46&t=l9S5L2Oi-TBm9AG4dMrXrQ", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/18", "thumbnail_src": "https://si.imgix.net/acd586fd/uploads/origins/c142e164-49ad-4eac-b059-1076756d0b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cf6df7c2c651db12accff789564e632", "thumbnail_srcset": "https://si.imgix.net/acd586fd/uploads/origins/c142e164-49ad-4eac-b059-1076756d0b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cf6df7c2c651db12accff789564e632, https://si.imgix.net/acd586fd/uploads/origins/c142e164-49ad-4eac-b059-1076756d0b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07ba0f5f0945f1d73871c8d83dfe0465 2x, https://si.imgix.net/acd586fd/uploads/origins/c142e164-49ad-4eac-b059-1076756d0b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7aee5ec53e719ab0da974493c9d05c30 3x", "genre": "art", "nsfw": true, "body": "こんにちは！キャラクターを所定の位置に描いてください！メイビスのペニスは光り輝き、イクとさらに輝きを増します。ヴァイの性器は肉球と同じ青色です。\n\nhttps://drive.google.com/drive/folders/1y3dbmTHyOUJ6B5IyA3ntIXqwOTLD9iCM", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/17", "thumbnail_src": "https://si.imgix.net/eda33020/uploads/origins/dc833de8-14aa-4817-b86d-784d15a3a5c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=056fcb561bc3a6b5eb28a3e7de7f8a9d", "thumbnail_srcset": "https://si.imgix.net/eda33020/uploads/origins/dc833de8-14aa-4817-b86d-784d15a3a5c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=056fcb561bc3a6b5eb28a3e7de7f8a9d, https://si.imgix.net/eda33020/uploads/origins/dc833de8-14aa-4817-b86d-784d15a3a5c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=553180332fb41040795b8a6fb9b847ae 2x, https://si.imgix.net/eda33020/uploads/origins/dc833de8-14aa-4817-b86d-784d15a3a5c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c9e8df0d41a3d9722474c3e2c9c31c7 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nトラ（身長218cm）にウーロン（身長177cm）を押さえつけてパイズリフェラしてほしいです。汗とザーメンがあれば最高です。ザーメンシーンもお願いします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Lfz9VBWbYFfVuLb3neh8cdVjJfIDTONV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Sijimmy456/works/16", "thumbnail_src