T5ovhl6TszDMm8uUOI-Qb8w?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@u3_10_/works/5", "thumbnail_src": "https://si.imgix.net/1197346c/uploads/origins/2425f3a5-3377-4d93-a54e-477f282be58f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4036607a7f112db0122aaf960505b7a", "thumbnail_srcset": "https://si.imgix.net/1197346c/uploads/origins/2425f3a5-3377-4d93-a54e-477f282be58f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4036607a7f112db0122aaf960505b7a, https://si.imgix.net/1197346c/uploads/origins/2425f3a5-3377-4d93-a54e-477f282be58f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21a036301388a3f11795ba62c922823c 2x, https://si.imgix.net/1197346c/uploads/origins/2425f3a5-3377-4d93-a54e-477f282be58f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=136871c257a1a7f837657570db73ff45 3x", "genre": "art", "nsfw": false, "body": "お世話になります！月星ルナと申します。\nアピールありがとうございました！\n是非私にも、IRIAM等のサムネ用等としてイラストをお願いできませんでしょうか？\n資料URLに私の使用している立ち絵を載せます。\n全身絵かバストアップで、何となくダークな感じを希望します！また、パパVということもあるので、娘が小さくても写ってると嬉しいです！\n尚、詳細は絵の構図や色合い等色々あると思うので、ある程度お任せしたいです。\nご検討のほどよろしくお願いします！\n\nhttps://twitter.com/vtuber_luna/status/1594692368737140738?s=46&t=8uNbp3cIj4EYNNs44JzShw", "created_at": "", "completed_at": ""}, {"path": "/@u3_10_/works/4", "thumbnail_src": "https://si.imgix.net/c7b53015/uploads/origins/48f5498f-a6e9-4b01-bea6-d99d554a944e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a1c60eeceb757557b1f7e1cbca6c34e", "thumbnail_srcset": "https://si.imgix.net/c7b53015/uploads/origins/48f5498f-a6e9-4b01-bea6-d99d554a944e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a1c60eeceb757557b1f7e1cbca6c34e, https://si.imgix.net/c7b53015/uploads/origins/48f5498f-a6e9-4b01-bea6-d99d554a944e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e6b8c1819a8a5a353c8934fd4de7d48 2x, https://si.imgix.net/c