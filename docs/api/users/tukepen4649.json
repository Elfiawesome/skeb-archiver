4c8e-9f8b-d51c78a77b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8d2872a0f9fb7dfbadb6810d033f423 2x, https://si.imgix.net/361d323b/uploads/origins/9de9e872-8b44-4c8e-9f8b-d51c78a77b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feb42927f8877e1a147f8782b3737028 3x", "genre": "art", "nsfw": true, "body": "はじめましてロニさん、イージスと申します。あなたが描くイラストに、いつもトキメキと癒しをいただいております。そこで僕からもリクエストを1つ送ります。内容は以下の通りです。\n作品：ラブライブ！シリーズ\nキャラクター：唐可可、矢澤虎太郎\nタグ：おねショタ　顔面騎乗　匂い責め　オナホコキ　射精\nシチュエーション：可可と虎太郎によるおねショタイラストです。可可が顔面騎乗で虎太郎にパンツ越しの匂いを嗅がせて、ちんちんを勃起させます。そしてオナホールでちんちんをシコシコして射精させてあげます。\nできる範囲で良いので、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/268", "thumbnail_src": "https://si.imgix.net/08ef3651/uploads/origins/b3ca026d-ea47-4848-8da9-d63c0937f810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb8460b51e124eed00105748c4162cb1", "thumbnail_srcset": "https://si.imgix.net/08ef3651/uploads/origins/b3ca026d-ea47-4848-8da9-d63c0937f810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb8460b51e124eed00105748c4162cb1, https://si.imgix.net/08ef3651/uploads/origins/b3ca026d-ea47-4848-8da9-d63c0937f810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f793d1e73caa4a730b5ed2e15cadef2 2x, https://si.imgix.net/08ef3651/uploads/origins/b3ca026d-ea47-4848-8da9-d63c0937f810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38061502c8be8d2df7f38741b8346c35 3x", "genre": "art", "nsfw": true, "body": "はじめまして。ウルトラヒロインのイラストがエロかったのでリクエストさせてください。\n\n以下の設定のセリフ付イラストをお願い致します。\n設定\nウルトラガール・ティーファ（巨乳で乳はまるみえでお願いいたします。）\nhttps://www.pixiv.net/artworks/132475506\nセリフ参考\nhttps://www.pixiv.net/novel/show.php?id=25637427\n\nが異星人に完敗して、地球侵略をあきらめてもらう代わりに、異星人の子を定期的に妊娠出産することを条件に出されそれを受け入れた。（実は異星人は地球侵略に興味がなく、ウルトラガール・ティーファと子作りするのが目的であった。）\n\nイラスト内容\nその後、ウルトラガール・ティーファは、異星人の子を３人妊娠出産済みで、４人目を妊娠してボテ腹になり黒くなった巨乳りんからぼ乳を出しながら正面を向いて騎乗位で異星人になか出しされているイラスト。\n\nウルトラガール・ティーファは、異星人の子を３人妊娠出産済みで、４人目を妊娠していることや子は２０人以上作る予定なこと等市民などに報告している。\n\n差分で８人目を妊娠してボテ腹になり爆乳化している。\nウルトラガール・ティーファは、異星人の子とラブラブになっており、これからはウルトラヒロインを引退して異星人との子作りに専念すること等を市民に報告している。", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/267", "thumbnail_src": "https://si.imgix.net/d8c2df14/uploads/origins/46456b08-ec09-4371-b1be-70f0e13d8f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e64bb578715b2016855abde6473338f", "thumbnail_srcset": "https://si.imgix.net/d8c2df14/uploads/origins/46456b08-ec09-4371-b1be-70f0e13d8f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e64bb578715b2016855abde6473338f, https://si.imgix.net/d8c2df14/uploads/origins/46456b08-ec09-4371-b1be-70f0e13d8f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7bfb316b637336aed501885168108af 2x, https://si.imgix.net/d8c2df14/uploads/origins/46456b08-ec09-4371-b1be-70f0e13d8f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82b0437c932bea78afc3f2f227669ead 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/266", "thumbnail_src": "https://si.imgix.net/bd47f7af/uploads/origins/54e03e15-58ba-443a-a172-f71b12774072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c5b6b12ef888410f12b77876755559", "thumbnail_srcset": "https://si.imgix.net/bd47f7af/uploads/origins/54e03e15-58ba-443a-a172-f71b12774072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c5b6b12ef888410f12b77876755559, https://si.imgix.net/bd47f7af/uploads/origins/54e03e15-58ba-443a-a172-f71b12774072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d36feeba850883e3af35ff8fec5f5ff5 2x, https://si.imgix.net/bd47f7af/uploads/origins/54e03e15-58ba-443a-a172-f71b12774072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=198d1e58d4aaa9596975f2d1dbe213cf 3x", "genre": "art", "nsfw": true, "body": "ロニ様\n下記のキャラクターイラスト計2枚を依頼します。\nキャラクター\n受け： 葛城リーリヤ（161cm）\n攻め： アイリーン・レドメイン（143cm）\nアイリーン参考： https://heaven-burns-red.com/character/31x/irene-redmayne/\n格闘ゲームの対戦画面風の演出を希望します。\n2枚共に、画面上部に体力ゲージを配置し「Round 1」「Round 2」と記載してください。アイリーンのゲージはほぼ満タン、リーリヤは瀕死の状態です。\nこの体力差を反映し、リーリヤは満身創痍で衣服もボロボロ、苦痛と屈辱で失禁しています。対照的にアイリーンはほぼ無傷で、彼女を侮蔑する表情です。アイリーンの見下すセリフ追加も歓迎します。\nイラスト1枚目：「Round 1」\nリーリヤ衣装参考： https://x.com/gkmas_official/status/1902913050430345355\nアイリーンが、リーリヤのブーツごと足に関節技（アンクルホールド等）を極め、非可動域に曲げている場面。リーリヤは激痛に顔を歪めつつも、必死の反抗心を見せる表情。ブーツもひどく損傷していると嬉しいです。\nイラスト2枚目：「Round 2」\nリーリヤ衣装参考： https://x.com/gkmas_official/status/1931904079682511237\nアイリーンがリーリヤにコブラツイストをかけている場面。完敗による絶望と屈辱で失神寸前のリーリヤと、彼女を冷たく見下し満足げなアイリーンをお願いします。\nご検討のほど、よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/265", "thumbnail_src": "https://si.imgix.net/9e097ffe/uploads/origins/0d672f46-c6bb-4389-9be0-2eb1ce3f2fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f81bde055e34e956073f7e767e69be4", "thumbnail_srcset": "https://si.imgix.net/9e097ffe/uploads/origins/0d672f46-c6bb-4389-9be0-2eb1ce3f2fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f81bde055e34e956073f7e767e69be4, https://si.imgix.net/9e097ffe/uploads/origins/0d672f46-c6bb-4389-9be0-2eb1ce3f2fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81bd2000477ae60b0b2f489f5715e6d6 2x, https://si.imgix.net/9e097ffe/uploads/origins/0d672f46-c6bb-4389-9be0-2eb1ce3f2fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59e05bf2b6f3b015209a406b5f645d6f 3x", "genre": "art", "nsfw": true, "body": "突然のメッセージ失礼いたします。以下に依頼したい内容を記載させていただきます： ラブライブの西木野真姫&中須かすみの水着キャットファイト 。\n内容：中須かすみは西木野真姫のパンツの中に直接手を入れ、真姫の秘所を強く握り締めます（かすみが力を入れすぎて、真姫のパンツが少しずり落ちてしまいました、秘所が少し赤くなっています）。かすみのもう一方の手が真姫の上半身の水着の中に入ってきて、乳首を強く引っ張り、真姫を屈めさせました(片方の乳首だけが露出していて、もう片方の乳首は服でかろうじて隠れています)。かすみは陰険に笑い、軽薄な言葉で真姫をからかっています（例えば：この一撃を股間で受け止めてみろよ！お嬢様！)真姫は痛みで顔を真っ赤にし、悲鳴を上げ、涙を流していました。真姫はかすみの秘所攻撃の手を懸命に押しのけようとしましたが、無駄でした。二人とも裸足でした。\n乳房のサイズは参照URLと同じで、二人とも乳房は大きくない。かすみは真姫より背が低く、胸も少し小さい。  ご検討いただけたら幸いです。よろしくお願いします。\n(中須かすみ\nhttps://x.com/hobby_stock/status/1443115289231732736\n西木野真姫 \nhttps://pbs.twimg.com/media/GLc-fp0aYAAnnJp?format=jpg&name=large )", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/264", "thumbnail_src": "https://si.imgix.net/0204ed92/uploads/origins/fab3c593-f0f9-4b60-8089-464b5e963318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b7fc2c184dc4cfc25f355165c900d64", "thumbnail_srcset": "https://si.imgix.net/0204ed92/uploads/origins/fab3c593-f0f9-4b60-8089-464b5e963318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b7fc2c184dc4cfc25f355165c900d64, https://si.imgix.net/0204ed92/uploads/origins/fab3c593-f0f9-4b60-8089-464b5e963318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=495db25c0564a9b790383aa49816b955 2x, https://si.imgix.net/0204ed92/uploads/origins/fab3c593-f0f9-4b60-8089-464b5e963318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faa0a55816662e2d86b949b6805e6cb7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/263", "thumbnail_src": "https://si.imgix.net/3cd8d74a/uploads/origins/adc1a02d-5a62-4649-bbac-b3de47b7f1d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02e624a51691abce5bcd5eff0c12d52b", "thumbnail_srcset": "https://si.imgix.net/3cd8d74a/uploads/origins/adc1a02d-5a62-4649-bbac-b3de47b7f1d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02e624a51691abce5bcd5eff0c12d52b, https://si.imgix.net/3cd8d74a/uploads/origins/adc1a02d-5a62-4649-bbac-b3de47b7f1d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a835e743c4aef0be379868ddf6423b8 2x, https://si.imgix.net/3cd8d74a/uploads/origins/adc1a02d-5a62-4649-bbac-b3de47b7f1d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7729c4399e8e0768ca5426db83872d27 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼致します。\nリサハミルトンにエリオットがコーナーに追い込まれ、身体が浮き上がる程にボディーブローの連打を食らい、背骨にまでダメージが及んでいるイラストをお願い致します。\n\nエリオットはデラックスコスチュームで既に全身痣だらけでボロボロ。\n\nリサはトロピカルセクシーコスチュームで被り物と後ろのフサフサは無しでお願い致します、胸は顔より大きい爆乳にして頂きたいです。\n\n御検討の程宜しくお願い致します。\n\nトロピカルセクシーコスチュームの資料urlになります。\nhttps://www.gamespark.jp/article/img/2014/02/04/46159/49954.fullscreen.html\n\nhttps://www.gamespark.jp/article/img/2014/02/04/46159/49954.fullscreen.html", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/262", "thumbnail_src": "https://si.imgix.net/eddd8a66/uploads/origins/8fe0bf5a-305c-4456-8b3d-6f2f09effd93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4785a6fc1313493a4cd79cef8903d36e", "thumbnail_srcset": "https://si.imgix.net/eddd8a66/uploads/origins/8fe0bf5a-305c-4456-8b3d-6f2f09effd93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4785a6fc1313493a4cd79cef8903d36e, https://si.imgix.net/eddd8a66/uploads/origins/8fe0bf5a-305c-4456-8b3d-6f2f09effd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0b35b0584e164ee2cd750fcd84405fc 2x, https://si.imgix.net/eddd8a66/uploads/origins/8fe0bf5a-305c-4456-8b3d-6f2f09effd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81f593541569fa59d48212d1fa033dc3 3x", "genre": "art", "nsfw": true, "body": "ホロライブの癒月ちょこさんが男性レスラーにブレストスムーザーをかけているイラストをお願いいたします。\n可能であれば衣装は初期衣装でお願いいたします。難しい場合は他の衣装でも差し支えございません。また、シチュエーション的には癒月ちょこさんと男性レスラーが闘っている状況でお願いしたいです。\n\nSkebでご依頼させていただくのは初めてなのでご不快な思いをさせてしまった場合は申し訳ございません。", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/261", "thumbnail_src": "https://si.imgix.net/600df6dd/uploads/origins/dcce5c82-f2c6-4b9f-b1c3-519ce4c5ff59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a04bfe1bd2407b5505ca71fa9ee6e5", "thumbnail_srcset": "https://si.imgix.net/600df6dd/uploads/origins/dcce5c82-f2c6-4b9f-b1c3-519ce4c5ff59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a04bfe1bd2407b5505ca71fa9ee6e5, https://si.imgix.net/600df6dd/uploads/origins/dcce5c82-f2c6-4b9f-b1c3-519ce4c5ff59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7495ccdbd61e7d4b1ba749b2d568bb1a 2x, https://si.imgix.net/600df6dd/uploads/origins/dcce5c82-f2c6-4b9f-b1c3-519ce4c5ff59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=566b06eb46ff990cc8ec098fce1231cb 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています。またリクエストしたいのですがいつものとは少し趣向が変わります。\n\nいつもの二人の\n平原陽桜莉（https://drive.google.com/drive/folders/1Ndp46WtuyIUeCwUmKpAb8rHu3YmaNyvH?usp=drive_link）\nと\n安住菜々花（https://drive.google.com/drive/folders/1Gkm8gZxEGqeFMekzMT8QTUPc_ecUccTk?usp=drive_link）\nを前回までと同じ衣装に加えて、\n春日詩帆（ブルーリフレクションより）を描いていただきたい。\n詩帆の見た目はこちらにいくつか用意してあるので参照ください\nhttps://drive.google.com/drive/folders/1zyeVn10VIELrb8bnHJft2x_Kob6s7Kpn?usp=sharing\n詩帆に着せて欲しい資料\nhttps://x.com/baketsu007/status/1913241874028179964\n上記資料、私の画力のなさのせいでわかりにくく申し訳ございません。\n別絵師の作品ですみませんが、以前私が依頼して描いていただいた絵も参考になれば\nhttps://www.pixiv.net/artworks/130766523\n\n描いて欲しい技絵\n陽桜莉と菜々花が詩帆にツープラトンパイルドライバー（1人が相手の胴体を逆さまに抱え上げ、もう1人が相手の両足をつかんで一緒に落下し、その勢いを利用してパイルドライバーを仕掛ける技）\n陽桜莉が詩帆を抱え上げ、菜々花が詩帆の両足を掴んでアシスト。マットに置かれたクサリの上にパイルドライバーを仕掛ける。\n\n構図はやられ側の詩帆が見える構図でお願いします。あとはお任せします。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/260", "thumbnail_src": "https://si.imgix.net/cf566506/uploads/origins/ce4f137f-1e44-42f2-b12d-710911ef4a28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a4041b2d9e8e46fbba4f91a85e32c2", "thumbnail_srcset": "https://si.imgix.net/cf566506/uploads/origins/ce4f137f-1e44-42f2-b12d-710911ef4a28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a4041b2d9e8e46fbba4f91a85e32c2, https://si.imgix.net/cf566506/uploads/origins/ce4f137f-1e44-42f2-b12d-710911ef4a28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf31ecca0871b342cd49aed165327d4e 2x, https://si.imgix.net/cf566506/uploads/origins/ce4f137f-1e44-42f2-b12d-710911ef4a28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=575f16dea00e265857dd6834ca347288 3x", "genre": "art", "nsfw": true, "body": "クイーンズブレイドリミットブレイクの超回転武装少女ミリムが戦国BASARAの伊達政宗を超振動ベアハッグで絞め上げ骨折させるイラストをお願いします。\n\n容姿・衣装\n超回転武装少女ミリム\nhttps://imgur.com/a/CnYwinc\n戦国BASARAの伊達政宗の容姿　https://dengekionline.com/elem/000/000/126/126200/\n戦国BASARAの伊達政宗の兜を外した姿\nhttps://blog-imgs-24-origin.fc2.com/b/a/s/basara2011/20111117180957e11.jpg\n\nベアハッグのイメージ\nhttps://www.pixiv.net/artworks/29927483\n\n※ベアハッグのイメージではリリアナが全裸でベアハッグ食らっているが、今回のリクエストの政宗は男で青い装束を着たままとする。\n\n\nミリムは弱気な性格の持ち主で、政宗をベアハッグで両腕ごと抱き絞め、ビキニアーマーの胸と股間に付けられている超振動クリスタルで自分が胸と股間への刺激で快感を感じながら相手が傷つく事を恐れて「は、早く降参してくださ〜〜〜〜い!」と涙目で叫びながらぎゅ〜〜〜〜っと締め上げる。\n\n政宗は、ミリムのビキニアーマーの胸とガントレットの部分に両腕と胴体を圧迫され、胴体と胴体の骨にダメージを受けて、自身もまたミリムのベアハッグにより超振動クリスタルを体(胸と股間)に押し当てられた事で刺激されて快感を感じ勃起しつつ苦しみながらも「だ、誰がアンタなんかに…」と強気で抵抗するも超振動の力が強すぎて脱出出来ない。\n\n数分後、政宗はミリムの超振動クリスタルの刺激によって絶頂に達してズボン越しに射精しながらミリムのビキニアーマーの胸当てとガントレットの圧力によって骨折。ミリムは政宗の骨折の音でビックリする。\n\nその次のシーンで政宗は骨折によって泡吹いて死亡し、その時には超振動クリスタルの超振動が収まり、ミリムは政宗を解放して、「あわわわわ、ご、ごめんなさい!」と政宗の身を感じながら必死に謝る。\n\n※死亡がダメなら口から魂が抜ける表現か意識を失いK.O.にしても構わない。", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/259", "thumbnail_src": "https://si.imgix.net/6e54a8d2/uploads/origins/6bdb481a-570c-4ab5-a520-3e6366a92f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf837abb55aa601f4dc236945780e74", "thumbnail_srcset": "https://si.imgix.net/6e54a8d2/uploads/origins/6bdb481a-570c-4ab5-a520-3e6366a92f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf837abb55aa601f4dc236945780e74, https://si.imgix.net/6e54a8d2/uploads/origins/6bdb481a-570c-4ab5-a520-3e6366a92f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0e5129deb66613801df7fe08a554f31 2x, https://si.imgix.net/6e54a8d2/uploads/origins/6bdb481a-570c-4ab5-a520-3e6366a92f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97ae4a4dbd0f6fd3f8f5870291cdb1ee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tukepen4649/works/258", "thumbnail_src": "https://si.imgix.net/e0eabf1e/uploads/origins/9331c719-6ced-4d24-85ad-02c539b016bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=092c9966645a3621763b60b964b54e53", "thumbnail_srcset": "https://si.imgix.net/e0eabf1e/uploads/origins/9331c719-6ced-4d24-85ad-02c539b016bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bo