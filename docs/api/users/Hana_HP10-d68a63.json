fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=955c1a7ab138b974fdac5e9d30fc563e 2x, https://si.imgix.net/9f93bba1/uploads/origins/6499b08b-6009-420d-8576-76672501cf51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=016affeeb84038bddce5159dd7dfd2f0 3x", "genre": "art", "nsfw": false, "body": "華様\n\nお世話になっております\n文妹妹文です\n\n以前依頼した華さんのイラストには大変助かりました‼️ありがとうございます✨\nまた依頼をさせてほしいです🎵\n\n私の姿の資料は下記です\nhttps://lit.link/maifumiV\n\n描いて頂きたい内容ですが、\n私が良く🙌🙌この絵文字を使うのですが\n(両手をあげる絵文字)\nこの絵文字のイメージで私を描いて頂くことは可能でしょうか\n描きやすい形で大丈夫です\n(難しいようでしたらお任せまたはお手数ですが否決をお願いします🙏)\n\n使用用途は配信や動画での利用やサムネ・Twitter・BlueSkyで使用させて頂きたいです。\nできれば透過素材を頂けたらありがたいです。\n\nまたTwitterなどAI問題等ありますので投稿する際に気を付けてほしい事など指定等あればレイヤーなどに書いていただければありがたいです", "created_at": "", "completed_at": ""}, {"path": "/@Hana_HP10/works/8", "thumbnail_src": "https://si.imgix.net/60807361/uploads/origins/43d46d30-9f0d-4324-ba58-153f5c214476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ef479a63e8a527472f83013e97a52d9", "thumbnail_srcset": "https://si.imgix.net/60807361/uploads/origins/43d46d30-9f0d-4324-ba58-153f5c214476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ef479a63e8a527472f83013e97a52d9, https://si.imgix.net/60807361/uploads/origins/43d46d30-9f0d-4324-ba58-153f5c214476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1787ba86b15a15622f9d8a6765773ecd 2x, https://si.imgix.net/60807361/uploads/origins/43d46d30-9f0d-4324-ba58-153f5c214476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a9b1ebc7d68b97a4ad7748f6de86d11 3x", "genre": "art", "nsfw": false, "body": "華様\nはじめましてvtuber準備中の文妹妹文(あやせ　まいふみ)と申します\n\nイラストがとっても素敵で\nわたしも描いて頂きたいと思い連絡させて頂きました\n資料は下記です\nhttps://twitter.com/maifumiV/status/1775848170830082406?t=gu-03CoauMHlUWoJg2wH8g&s=19\n\n描いて頂きたい内容ですが\nイラストの雰囲気が好きなのでお任せでお願いしたいです\n\n使用用途は配信や動画での利用やサムネ・Twitterで使用させて頂きたいです。\n\nできれば透過素材を頂けたらありがたいです", "created_at": "", "completed_at": ""}, {"path": "/@Hana_HP10/works/7", "thumbnail_src": "https://si.imgix.net/e1ad6f9c/uploads/origins/3931c5a5-7006-40ca-8221-88d9b6bc7d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2aaeeedb05575f5c22412b796cbc3466", "thumbnail_srcset": "https://si.imgix.net/e1ad6f9c/uploads/origins/3931c5a5-7006-40ca-8221-88d9b6bc7d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2aaeeedb05575f5c22412b796cbc3466, https://si.imgix.net/e1ad6f9c/uploads/origins/3931c5a5-7006-40ca-8221-88d9b6bc7d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6ee6d100b3141a95dc0636d1f50379e 2x, https://si.imgix.net/e1ad6f9c/uploads/origins/3931c5a5-7006-40ca-8221-88d9b6bc7d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a826ea496e242b74daf998e8358979ce 3x", "genre": "art", "nsfw": false, "body": "華絵師様\n\n初めまして、たこめしと申します。\nXで華絵師様のとてもお洒落で素敵なお子さんたちを拝見し、\nぜひイラストを描いていただきたくリクエストさせていただきました。\n\nもしご都合がよろしければ、下記の内容にて描いていただきたく思います。\n\n●キャラクターは他社のコミッションにて別の絵師様に描いていただいたOCです。\n\n●デザインは下記のURLを参照願います。\n(立ち絵は返り血の表現があるのでご注意ください。\n苦手でしたらデザイン資料とアイテム資料だけでも大丈夫です。)\nhttps://drive.google.com/drive/folders/1Mhev__IUydl3Acm7p7EqNw161FkMBSVH\n\n●お願いしたい内容は華絵師様の描かれた帝政つぁりあ様のような全身が入るSDを希望します。\n衣装や小物のデザインが細かいので容赦なく簡略化やアレンジしていただいて大丈夫です。\nポーズは上記URLのアイテム資料にあるモップを持ってお掃除中の姿でお任せ、表情は完全にお任せいたします。\nバケツやバスケットも描いていただけると嬉しいですが、ご負担であれば省略していただければと思います。\n\n●キャラクターについて\n名前はカシェ。\nオオカミのお腹から助けられた時に血を見るのが性癖になってしまった赤ずきんの女の子です。\n性格は明るく素直ですが、血をたくさん見るのが目的で特殊清掃のバイトを始めたり、\n悪魔と契約して戦闘力を上げたりするやばい子です。\n\n●用途\n今のところ観賞用のみですが、SNS等で使用させていただく際は必ず著作表記いたします。\n\n以上、もしご縁がありましたら、どうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Hana_HP10/works/6", "thumbnail_src": "https://si.imgix.net/fe4d2e00/uploads/origins/baabd080-cde9-4d88-9ff2-a7a8e2d758c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7597042b869e2fb697cfff259666b68", "thumbnail_srcset": "https://si.imgix.net/fe4d2e00/uploads/origins/baabd