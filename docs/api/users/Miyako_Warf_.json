7-888f-0eed116c54ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50faa810663cd643ed9d2461f077322", "thumbnail_srcset": "https://si.imgix.net/a3a8e51e/uploads/origins/5faffbfd-6964-4417-888f-0eed116c54ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50faa810663cd643ed9d2461f077322, https://si.imgix.net/a3a8e51e/uploads/origins/5faffbfd-6964-4417-888f-0eed116c54ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8959a2582a820cbb756159e7422f7de8 2x, https://si.imgix.net/a3a8e51e/uploads/origins/5faffbfd-6964-4417-888f-0eed116c54ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59a211c043d19493fc0166fb4fbe2030 3x", "genre": "art", "nsfw": false, "body": "初めまして新着で拝見しフォローさせていただいておりました\nこちらのうちの子妖狐堕ち男の子秋巳と妖狐堕ち母様楓に\n資料の堕ち衣装色合いで名残残して花魁衣装デザインしていただきたいです\n装飾髪型アレンジなどもお願いしたいです\n(男の子の方は男の子のまま、髪型ショートなので装飾など追加だけで大丈夫です)\nhttps://drive.google.com/drive/folders/1hKj4BA85u_Ea9b8Jx8aTSkEsmhhDXO8a?usp=sharing\n別ファイルで簡単な2面図もお願いしたいです\n描いていただいたものはXミスキーディスコードでの使用紹介、他の方への依頼への資料に使わせていただきたいです\n宛名はpsdレイヤーでon/offお願いします\nよろしくおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@Miyako_Warf_/works/8", "thumbnail_src": "https://si.imgix.net/c01b43fa/uploads/origins/cc2626f8-0d31-4c80-9ce8-f8dfcae7f4d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91478b4146b13bc6b658832451ee342d", "thumbnail_srcset": "https://si.imgix.net/c01b43fa/uploads/origins/cc2626f8-0d31-4c80-9ce8-f8dfcae7f4d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91478b4146b13bc6b658832451ee342d, https://si.imgix.net/c01b43fa/uploads/origins/cc2626f8-0d31-4c80-9ce8-f8dfcae7f4d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txt