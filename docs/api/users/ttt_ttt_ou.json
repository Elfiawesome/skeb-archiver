ize=30&txt=PRIVATE&s=444f312915ade00859ac2ca72d56597b 2x, https://si.imgix.net/4be5df37/uploads/origins/8c946412-4141-4156-a9c3-c073d8dd8516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5405bbc517268a2d0823d8f20c9575d6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ttt_ttt_ou/works/25", "thumbnail_src": "https://si.imgix.net/973d7597/uploads/origins/e1818811-dcc7-4029-a5c4-836fb9de0026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=628ff9a6117158d60cb4405a60a12080", "thumbnail_srcset": "https://si.imgix.net/973d7597/uploads/origins/e1818811-dcc7-4029-a5c4-836fb9de0026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=628ff9a6117158d60cb4405a60a12080, https://si.imgix.net/973d7597/uploads/origins/e1818811-dcc7-4029-a5c4-836fb9de0026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3df50b9c22406712801642bf184bd7d 2x, https://si.imgix.net/973d7597/uploads/origins/e1818811-dcc7-4029-a5c4-836fb9de0026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63eea477308e5fe2843cd8dc9824c75c 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nキャラクター:にじさんじの本間ひまわり\n\nあらすじ\n動物と遊ぶ番組と聞いてやってきた本間ひまわり。\nしかし実際は動物のコスプレをしたライバーで遊ぶというエロバラエティであり、ひまわりは豚耳にピンクの長手袋とラバーソックス以外全裸という豚のコスプレを強制着用させられていた。\n\n流れとしては\n1.MCに紹介される。\n2.動物にご飯をあげるというコーナーでザーメンジョッキを出され、強制的に飲まされたひまわりはザーメンゲップをしてしまう。\nという感じでお願いします。\n\nひまわりはムチムチ汗だくでくさそうな感じでお願いします。\n\n可能であれば鼻フックもしくは男に強制的に顔責めされて豚鼻にさせられているシーン又は差分があると嬉しいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ttt_ttt_ou/works/24", "thumbnail_src": "https://si.imgix.net/14975c78/uploads/origins/9f863a12-9d28-411d-9ce8-83cf5343be66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e230876bdc4ec0b54c9dc4906046436c", "thumbnail_srcset": "https://si.imgix.net/14975c78/uploads/origins/9f863a12-9d28-411d-9ce8-83cf5343be66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e230876bdc4ec0b54c9dc4906046436c, https://si.imgix.net/14975c78/uploads/origins/9f863a12-9d28-411d-9ce8-83cf5343be66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=672a2be96740be2b099f6245d23c9d1c 2x, https://si.imgix.net/14975c78/uploads/origins/9f863a12-9d28-411d-9ce8-83cf5343be66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7623bdec9e8152afe1c4bfce9363ba6d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ttt_ttt_ou/works/23", "thumbnail_src": "https://si.imgix.net/a996583a/uploads/origins/5ab29225-6b19-40a0-b707-04ba64026a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=268081765385c6bdc29520baf9d25c64", "thumbnail_srcset": "https://si.imgix.net/a996583a/uploads/origins/5ab29225-6b19-40a0-b707-04ba64026a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=268081765385c6bdc29520baf9d25c64, https://si.imgix.net/a996583a/uploads/origins/5ab29225-6b19-40a0-b707-04ba64026a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc5da6036cf0ce0fc5ae63a80de7b059 2x, https://si.imgix.net/a996583a/uploads/origins/5ab29225-6b19-40a0-b707-04ba64026a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=814e6351f4933b691a7ca7c2cda5b022 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します！\n以前描かれていた参考URLの依頼の差分として鍵垢で2025年1月12日に投稿されていた鷹宮リオンのピンクの衣装が好みすぎたのでこちらの衣装の鷹宮リオンをお願いします。\n\n常識改変済みの鷹宮リオンが、新衣装として上記の衣装をノリノリで配信で披露するというシチュエーション\n\n下品やバカみたいといった罵倒するコメントを読むが常識改変で褒め言葉として受け取り、元に戻してというコメントに対しては他の衣装全部捨てちゃったから戻せないとサラッと答える\n\n更に衣装差分の鼻フックと身体への落書きも披露しスクショ用に笑顔でピースする\n\n衣装の指定が分かりづらく申し訳ございません。よろしければお願いします！\n\nhttps://skeb.jp/@ttt_ttt_ou/works/9", "created_at": "", "completed_at": ""}, {"path": "/@ttt_ttt_ou/works/22", "thumbnail_src": "https://si.imgix.net/738f1dff/uploads/origins/e5ca8b62-b02d-446f-a2c5-56beb0b2f5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3819f9dc49d97a22ec86699bdf15f0fc", "thumbnail_srcset": "https://si.imgix.net/738f1dff/uploads/origins/e5ca8b62-b02d-446f-a2c5-56beb0b2f5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3819f9dc49d97a22ec86699bdf15f0fc, https://si.imgix.net/738f1dff/uploads/origins/e5ca8b62-b02d-446f-a2c5-56beb0b2f5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83ada013e1ea77091f3112816eda017e 2x, https://si.imgix.net/738f1dff/uploads/origins/e5ca8b62-b02d-446f-a2c5-56beb0b2f5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52315e23be5ba9cf6a65e20d32be1b4f 3x", "genre": "art", "nsfw": true, "body": "以下のシチュエーションで、にじさんじの葉加瀬冬雪をお願いします。\n\nスパチャの言うことを聞くのは当たり前と催眠を受けた葉加瀬はリスナーの玩具にされ、一切手を出されること無くコメントに従って自身を無様で下品に改造していた。\n受けたスパチャ（フレーバーとして）\n・元の衣装は帽子と靴とアクセサリー以外全部廃棄しろ\n・片方の乳だけを開発し続けて下品に育て、もう片方の乳やまんこには触るな\n・脇毛の処理はせず、風呂の頻度も減らし部屋は常に蒸らしてくさそうな体臭を充満させろ。逆にまんこは丁寧に剃毛して綺麗にしろ\n・ゲップや放尿はその場で堂々としろ\n等\n\n欲しいシーン\n・催眠済み無様処女JKの葉加瀬冬雪として自己紹介、自身の身体について説明する\n\n・リスナーにプレゼントとして贈られているザーメン入りの食べ物（描写は無くても大丈夫です）がぶり返し盛大にゲップ、更にちょっとオシッコしたくなったと言いながらその場で放尿。その後今日の配信内容は〜と平然に続けるセリフで〆\n\n描きづらいようでしたら設定やシチュエーションを自由に加筆修正していただいても大丈夫です\nご一考よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ttt_ttt_ou/works/21", "thumbnail_src": "https://si.imgix.net/24651b39/uploads/origins/f4e26477-0e95-4ecb-9dc4-ee5b4a3f3e56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d16cbb36b283bfc085fddeea911c875", "thumbnail_srcset": "https://si.imgix.net/24651b39/uploads/origins/f4e26477-0e95-4ecb-9dc4-ee5b4a3f3e56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d16cbb36b283bfc085fddeea911c875, https://si.imgix.net/24651b39/uploads/origins/f4e26477-0e95-4ecb-9dc4-ee5b4a3f3e56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25d249833061f10665d4a83abc56b146 2x, https://si.imgix.net/24651b39/uploads/origins/f4e26477-0e95-4ecb-9dc4-ee5b4a3f3e56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcb1d05d85cc416a3a4d9130abde66d6 3x", "genre": "art", "nsfw": true, "body": "にじさんじのドーラのイラストをリクエストさせていただきます。\n\n衣装\n本間ひまわりの制服と髪飾りとソックス（改造されており胸は丸見え、スカート丈は股上10cmでノーパン）\n可能であればどこかにひまわりの学生証が貼り付けられている。\n\nポーズ\n媚びた困り笑顔でピース\n\nシチュエーション\n男に弱みを握られたドーラはひまわりの制服を持ち出し現役女子高生として立ちんぼをするように指示されてしまい、うわキツババアなのがバレバレの中本間ひまわりとして自己紹介しながら身体を売る。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ttt_ttt_ou/works/20", "thumbnail_src": "https://si.imgix.net/116d916c/uploads/origins/1b7ed8e9-40f7-49ad-8425-06cb6c65531a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cb22507c08b31e5f6c06fa19960a0cf", "thumbnail_srcset": "https://si.imgix.net/116d916c/uploads/origins/1b7ed8e9-40f7-49ad-8425-06cb6c65531a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cb22507c08b31e5f6c06fa19960a0cf, https://si.imgix.net/116d916c/uploads/origins/1b7ed8e9-40f7-49ad-8425-06cb6c65531a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f65a16e395e7a656ddcf44ea42282a0c 2x, https://si.imgix.net/116d916c/uploads/origins/1b7ed8e9-40f7-49ad-8425-06cb6c65531a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de84289f97fbb0cf11d5c528af5f3d97 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\n以前投稿されていたこちらの作品\nhttps://www.pixiv.net/artworks/81889140\nのように、平然と常識改変済みで配信を行う戌亥とこをお願いします。\n\n通常衣装の胸や腋の部分を大きく切り取られた状態で、「腋毛の処理を禁止されたせいで