6-bdc5-f7a411d56961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d32e72de484e0b92ecb47ba97ecdce3 2x, https://si.imgix.net/b670d32e/uploads/origins/2f9a3603-9ad4-4b96-bdc5-f7a411d56961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb7034c674c1a0410d7551d63e289143 3x", "genre": "art", "nsfw": true, "body": "キャラはアイマスのLMBGから何人かすずさんが描きやすい子を何人かお願いします。引率役で日下部若葉が入っていると嬉しいです。\n エロアニメのヤリモクビーチに修学旅行で！のような感じの漫画をお願いします(https://www.pinkpineapple.co.jp/detail.php?did=1831) ヌーディストビーチの隣にあるヤリモクビーチで仕事のストレス解消の乱交プレイをする女の子たちをお願いします。 竿役は日本人でも外国人でも構いません。 服装は水着をずらすか太ももまでずり下ろす形で着たままで。 3Pや4Pなどの複数プレイがあると嬉しいです。\n 最後は膣や口から精液を垂れ流しながら満足して寝ているアイドル達の集合図でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@suzuusagisan2/works/12", "thumbnail_src": "https://si.imgix.net/b4ce436e/uploads/origins/3988a16f-a4a2-4182-8ea2-d42d4201c862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=084d58121487ebebe4ae193a2f045af8", "thumbnail_srcset": "https://si.imgix.net/b4ce436e/uploads/origins/3988a16f-a4a2-4182-8ea2-d42d4201c862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=084d58121487ebebe4ae193a2f045af8, https://si.imgix.net/b4ce436e/uploads/origins/3988a16f-a4a2-4182-8ea2-d42d4201c862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0710c4e0d00904aaad423b12ff49fa2 2x, https://si.imgix.net/b4ce436e/uploads/origins/3988a16f-a4a2-4182-8ea2-d42d4201c862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=969d01b53e255e878462a35fc511a355 3x", "genre": "art", "nsfw": true, "body": "アイマスの佐々木千枝の輪姦をお願いします。\n枕営業で相手企業のスポンサーたちを相手にするシチュエーションがいいです。服装は私服かマイクロビキニでお願いします。陰毛はなしのパイパンかうぶ毛が生えているくらいで。\n千枝は何度も枕営業体験済みで興奮してるとエロいです。\n竿役の男たちは3人以上がいいです。少しぽっちゃりしてチンコがでかいのを見て千枝が期待しているといい感じです。\nプレイ内容は\n·バイブかディルドを挿入してパンツで固定\n·相手の前に跪いてフェラ→顔面へぶっかけ\n·シックスナイン→口内射精\n·騎乗位で挿入、両手で竿しごき→中出し＆体にぶっかけ\n·膣とアナルの二穴プレイ\n·バックから突かれながらフェラ、体が浮き上がってるとよし\nこれらの中ですずさんが描けると思えるものをお願いします。\n最後はベッドに仰向けに倒れた精液まみれの千枝に仕事の契約を枕営業をセットしたプロデューサーに伝えておくという報告と、また今度の誘いをかけるスポンサー達(姿は見えず声だけ)でお願いします。\n長々と注文つけましたがよろしけばお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@suzuusagisan2/works/11", "thumbnail_src": "https://si.imgix.net/e92f00cb/uploads/origins/bca7814a-6117-4276-be1a-8a972a7535f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bff292337af43f72b26c636789bd1820", "thumbnail_srcset": "https://si.imgix.net/e92f00cb/uploads/origins/bca7814a-6117-4276-be1a-8a972a7535f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bff292337af43f72b26c636789bd1820, https://si.imgix.net/e92f00cb/uploads/origins/bca7814a-6117-4276-be1a-8a972a7535f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e00bed6e460b9efa66a18f0abf1f568 2x, https://si.imgix.net/e92f00cb/uploads/origins/bca7814a-6117-4276-be1a-8a972a7535f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95d3a26cd360e92857c330ccb39a6c67 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suzuusagisan2/works/10", "thumbnail_src": "https://si.imgix.net/4ff38425/uploads/origins/c24b0b68-f241-4ee0-af7f-d9b1a21dee11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c319cd0d392450600ed2e51d3ab45836", "thumbnail_srcset": "https://si.imgix.net/4ff38425/uploads/origins/c24b0b68-f241-4ee0-af7f-d9b1a21dee11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bo