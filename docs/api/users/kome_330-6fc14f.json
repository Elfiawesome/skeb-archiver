2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4883dcb457aeb4f7cadc6adadea6f8f4 2x, https://si.imgix.net/4dac769a/uploads/origins/3c60824a-6b45-41d6-9b04-a5c500444229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c52a0a8b7115432c335132d373352e2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターデザインを気に入っていただけて嬉しいです！アピールありがとうございます💙✨️ ぜひマンタシェイを描いていただきたいです。好きなように描いてください！\n\nhttps://ibb.co/jbmVq6L\nhttps://ibb.co/Jr0ngd5", "created_at": "", "completed_at": ""}, {"path": "/@kome_330/works/5", "thumbnail_src": "https://si.imgix.net/88dc0fa7/uploads/origins/2d390bb3-85f1-43ef-b5f6-3bfde510c7b9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=350a08cf71380c4fb5e50045fd91be8e", "thumbnail_srcset": "https://si.imgix.net/88dc0fa7/uploads/origins/2d390bb3-85f1-43ef-b5f6-3bfde510c7b9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=350a08cf71380c4fb5e50045fd91be8e, https://si.imgix.net/88dc0fa7/uploads/origins/2d390bb3-85f1-43ef-b5f6-3bfde510c7b9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=98bcb774093152eb59056a6208d0b6ef 2x, https://si.imgix.net/88dc0fa7/uploads/origins/2d390bb3-85f1-43ef-b5f6-3bfde510c7b9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a738cb0592e260cb05856709cac0f03 3x", "genre": "art", "nsfw": false, "body": "kome様はじめまして\nいただいたアピールがいいなと思ったのでリクエストさせて頂きました\nイラストは感じるがままに、あなたイメージがした通りに描いてください\n\nキャラクターのデザインは下記のURLに入れています\n(設定画には色々書いてありますが、デザインは厳密には決まっていないので描きやすいように自由に解釈、省略、補完して描いていただいて差し支えありません)\n\nhttps://drive.google.com/drive/folders/1jDKOE3xaLbweTmJTMno6MKZ0AyuhrVSR", "created_at": "", "completed_at": ""}, {"path": "/@kome_330/works/4", "thumbnail_src": "https://si.imgix.net/e34086d9/uploads/origins/01f56375-6269-46ba-8794-c4f44deec780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=256271c67f5adda0087f3b25f406aeac", "thumbnail_srcset": "https://si.imgix.net/e34086d9/uploads/origins/01f56375-6269-46ba-8794-c4f44deec780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=256271c67f5adda0087f3b25f406aeac, https://si.imgix.net/e34086d9/uploads/origins/01f56375-6269-46ba-8794-c4f44deec780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb7de23e5a3bfdbd43df7a1e8e3cf09d 2x, https://si.imgix.net/e34086d9/uploads/origins/01f56375-6269-46ba-8794-c4f44deec780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69ef3b533c3b5086c59eccd02f69626f 3x", "genre": "art", "nsfw": false, "body": "はじめまして。Twitchにて配信活動をしております、スイと申します。\n\nアピールありがとうございます。\nぜひお願いしたいと思い、リクエストを送らせていただきました。\n\n今回描いていただきたいのは私のイラストです。\n\n使用用途\n・X(旧Twitter)などのSNSでの使用\n・収益化済みのTwitchチャンネルやyoutube(サムネイルや動画、スタンプなど)の配信活動での使用\n・立ち絵(サムネイルや配信画面上の使用のみ)として自分以外の配信者様が使用すること(NGでしたら私のみ使用いたします。NGの場合はお手数ですが、別レイヤー等でお知らせをいただきたいです。)\n\nイラスト詳細\n・構図はお任せします。\n・服装はそのままでお願いいたします。\n・髪は短い方でお願いします。\n・表情はお任せいたします。差分があるととても嬉しいです。\n\nその他\n・サムネイルに使用するため体や髪などが見切れないようにお願い致します。\n・背景がある場合は人物と背景が分けられるようにしていただきたいです。\n\nお忙しいと思いますが、ご検討いただければと思います。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1VREJNRQGb2u9yIqEaE3d9Hj3P5rYLjvm?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kome_330/works/3", "thumbnail_src": "https://si.imgix.net/f2953fd5/uploads/origins/4d0bbbc0-f267-4392-ad96-add68f1416d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef015c80bedf0b7191c2c1b26198b37", "thumbnail_srcset": "https://si.imgix.net/f2953fd5/uploads/origins/4d0bbbc0-f267-4392-ad96-add68f1416d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef015c80bedf0b7191c2c1b26198b37, https://si.imgix.net/f2953fd5/uploads/origins/4d0bbbc0-f267-4392-ad96-add68f1416d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=432cfd93c2b0f430a89d0b9fa22563ce 2x, https://si.imgix.net/f2953fd5/uploads/origins/4d0bbbc0-f267-4392-ad96-add68f1416d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=