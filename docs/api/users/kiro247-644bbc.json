2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23aaedc4031b482594e13f5e59d1ce8a", "thumbnail_srcset": "https://si.imgix.net/fc5deb1f/uploads/origins/075b0a96-83f5-4cd1-9c65-9f7363e2003f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23aaedc4031b482594e13f5e59d1ce8a, https://si.imgix.net/fc5deb1f/uploads/origins/075b0a96-83f5-4cd1-9c65-9f7363e2003f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=108de77d6f11a8d6d1e581d3dcbaaa4d 2x, https://si.imgix.net/fc5deb1f/uploads/origins/075b0a96-83f5-4cd1-9c65-9f7363e2003f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dae2526396da46f1f7f04b1001c8d67a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n自分が参加しているTRPG卓でキャラの絵を用意することになり、短納期でイメージに合う方を探していた時に目に留まり連絡差し上げました。\n\n描いて頂きたいのはキャラの立ち絵で、主にキャラクターシートに使用するものです。\n背景はなくて構いません。\n\n※押さえてほしいポイント\n丸く長くない耳のウサギ（モチーフはナキウサギです）\nヒト要素はわずか（二足歩行するウサギ程度でお願いします）\nサングラスをかけている\n火のついていない紙タバコを咥えている\n首にオレンジ色のバンダナを巻いている\n\n※そのほかのポイント（参考程度で構いません）\n笑顔が眩しい\n身長は110cm程\n毛の色は白\nウサギだけど肉球がある\n服装は特になしでOK\n\n※全体的なキャラのイメージ\n陽気なダンディー（でもちょっとギャグっぽくてOK）\n\n文字ばかりの依頼で難しいかもしれませんが、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kiro247/works/50", "thumbnail_src": "https://si.imgix.net/0f19d38b/uploads/origins/5acee50c-da4f-4777-accd-fdbdabe4892b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=975243aa3933fd0de63802348fa7c461", "thumbnail_srcset": "https://si.imgix.net/0f19d38b/uploads/origins/5acee50c-da4f-4777-accd-fdbdabe4892b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=975243aa3933fd0de63802348fa7c461, https://si.imgix.net/0f19d38b/uploads/origins/5acee50c-da4f-4777-accd-fdbdabe4892b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ea74aed067d6468e60822f26c14e0f1 2x, https://si.imgix.net/0f19d38b/uploads/origins/5acee50c-da4f-4777-accd-fdbdabe4892b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=827189cf3fc86f499d3dedc5aae6ad9a 3x", "genre": "art", "nsfw": false, "body": "きゐさんの画風でうちのキツネっ仔（レンシア）をお願いしたいと思い依頼させて頂きました。\n可能であれば全体入っていると嬉しいです。\n応援ポーズ、背景などおまかせします。\n\n【レンシアの特徴】\n・鼻先ではなく鼻元が毛色の境\n・耳先の毛が垂れている\n・額に水色の模様あり\n・手の指は5本、足の指は３本\n・手や足は薄い茶色\n・年齢は１０歳〜１２歳くらい\n\n【装束】\n・学ラン（フロントは空いていてもとじていてもOKです、ボタンの数などは調整して頂いて構いません）\n・学ランの襟に水色のストライプが入ります、左腕上に赤の肉球マーク入り腕章をつけてます\n・白の長鉢巻き、タスキ、手袋、足袋を身につけてます\n・赤の褌は六尺褌\n\n手書きですが資料を下記URLにアップしています。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1zWJeC27_6i-xf5V4ExZgz26QrnRbyw7m?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kiro247/works/49", "thumbnail_src": "https://si.imgix.net/bdf6be6b/uploads/origins/a159eb5a-629e-4a58-824c-b98e9edae046?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=982a47c0b7f492aa18dc24f39f5afaf5", "thumbnail_srcset": "https://si.imgix.net/bdf6be6b/uploads/origins/a159eb5a-629e-4a58-824c-b98e9edae046?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=982a47c0b7f492aa18dc24f39f5afaf5, https://si.imgix.net/bdf6be6b/uploads/origins/a159eb5a-629e-4a58-824c-b98e9edae046?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6dccdcfa5932d75421d61be6ee7204f 2x, https://si.imgix.net/bdf6be6b/uploads/origins/a159eb5a-629e-4a58-824c-b98e9edae046?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ed7a97c1437be46375d68cf94537b48 3x", "genre": "art", "nsfw": false, "body": "人物の設定：https://drive.google.com/file/d/1-Xf5wYIDI5jZAYDVEKfZO7pUFtf3I3nz/view?usp=sharing\nQ版二頭身でいいから、あとは自由に発揮して。", "created_at": "", "completed_at": ""}, {"path": "/@kiro247/works/48", "thumbnail_src": "https://si.imgix.net/88ada904/uploads/origins/ab44a522-fccd-4c25-9f71-6bc62752a8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4ed591dea75855f6c8c7d07363fd7bb", "thumbnail_srcset": "https://si.imgix.net/88ada904/uploads/origins/ab44a522-fccd-4c25-9f71-6bc62752a8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4ed591dea75855f6c8c7d07363fd7bb, https://si.imgix.net/88ada904/uploads/origins/ab44a522-fccd-4c25-9f71-6bc62752a8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2b90808bb2f0d255bf9fe021cd9c926 2x, https://si.imgix.net/88ada904/uploads/origins/ab44a522-fccd-4c25-9f71-6bc62752a8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04c53661a790b9fbab7f49842b246b0d 3x", "genre": "art", "nsfw": false, "body": "料金の用意が出来ましたのでリクエストさせて頂きます🎵前に言ってた通り代理をヘッダー用に描いてもらいたいです♥️代理は↓の資料から見れると思います！リクエストするの凄い楽しみにしてました❗こぎさんのイラストらしく可愛く描いてくれると幸いですm(_ _)m\n\nhttps://twitter.com/ramutohituji/status/1655181400121942016?t=F2k4WHWonBeMCOvytup7yg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kiro247/works/47", "thumbnail_src": "https://si.imgix.net/8b75a074/uploads/origins/14cac493-35e7-4478-8d48-4989e87edb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe87cf5bd512b0f33bb01b9bc1e82867", "thumbnail_srcset": "https://si.imgix.net/8b75a074/uploads/origins/14cac493-35e7-4478-8d48-4989e87edb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe87cf5bd512b0f33bb01b9bc1e82867, https://si.imgix.net/8b75a074/uploads/origins/14cac493-35e7-4478-8d48-4989e87edb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06a02dd3546c0251bf2fb1ba386e5c8f 2x, https://si.imgix.net/8b75a074/uploads/origins/14cac493-35e7-4478-8d48-4989e87edb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=517fffd6113aed3181d6f1e8d9326c34 3x", "genre": "art", "nsfw": false, "body": "きゐ先生\n\nいつも楽しくご活躍を拝見しております。\nきゐ先生の絵柄がすごく好きで、見ていて幸せな気持ちになります。\n以下内容にてお願いしたいです。\nTwitterとyoutubeアカウントのアイコンとしても使用したいと思います。\n\nキャラのイメージはふっくらした、あたたかみのあるドラゴンで、尻尾あり。\nオレンジ色と白色を基調で、青と赤も少しあると嬉しいです。（青赤は無くてもいいです)\nその他はきゐ先生にお任せします。資料はございません。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kiro247/works/46", "thumbnail_src": "https://si.imgix.net/8baecec9/uploads/origins/c2fa6bbb-2ce7-46ba-af32-d2602684cb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f41dfac5409e86317e75dc9606b23077", "thumbnail_srcset": "https://si.imgix.net/8baecec9/uploads/origins/c2fa6bbb-2ce7-46ba-af32-d2602684cb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f41dfac5409e86317e75dc9606b23077, https://si.imgix.net/8baecec9/uploads/origins/c2fa6bbb-2ce7-46ba-af32-d2602684cb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=458ed464fc4b775ab7875114e99e200e 2x, https://si.imgix.net/8baecec9/uploads/origins/c2fa6bbb-2ce7-46ba-af32-d2602684cb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=818e91770ddb3112fa63c2420af4a929 3x", "genre": "art", "nsfw": false, "body": "きゐさん、こんにちは！\n先生のイラストが大好きなので、もし良ければ、私と友人のオリキャラを描いてもよろしいか？（友人からリクエストおよび資料提供の許可をいただいております）\n\nキャラ：\n三人共創作論破（ダンガンロンパシリーズの背景をモデルのオリジナル作品）の超高校級キャラクターです。\n\n千年屋 ドロシー：\nピンク髪の女の子、超高校級の「貴族令嬢」\n人に気さく、口調が温和で活発の子。他人と付き合うことが好きで、たまにちょっどデンパ感ある。\n\n村田 直輝： 金髪の男の子、超高校級の「幸運」 自信過剰で、挫折したり叱られたりして落ち込んだり、困ったりしまうのやつ。\n\n九重 時塚： 金髪の女の子、超高校級の「万事屋」\n気さくで、行動力のあるのお姉さん。外向で真面目で、気持ちがいい。\n\nシーン： 三人でバタークッキーを作っている。村田が卵を割り、他の二人がそばでクリームを割っている、こんな感じ。\n\n詳しいキャラ情報は下記URLよりご確認ください：\nhttps://m.weibo.cn/7522436180/4863676730841326\n\n可能であれば、この三人のfurry化したパロを依頼したいと思っております。\nそして宛名が別のレイヤーにご記載いただけると幸いです！\nもし料金に見合わないようでしたら再送要請やキャンセルしていただいても大丈夫です。\n\n何卒宜しくお願い致します！\n\nhttps://m.weibo.cn/7522436180/4863676730841326", "created_at": "", "completed_at": ""}, {"path": "/@kiro247/works/45", "thumbnail_src": "https://si.imgix.net/e756b41a/uploads/origins/062d05c9-e7e7-44ff-860b-558e3b307c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f239901ad7170c18d3b0f06f8b7190e2", "thumbnail_srcset": "https://si.imgix.net/e756b41a/uploads/origins/062d05c9-e7e7-44ff-860b-558e3b307c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f239901ad7170c18d3b0f06f8b7