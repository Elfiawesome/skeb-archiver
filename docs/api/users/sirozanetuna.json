&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48db015457d720b04f2c79b7c4e89ac9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sirozanetuna/works/33", "thumbnail_src": "https://si.imgix.net/97f10250/uploads/origins/b4b7cec9-bc00-428b-9361-458125e143d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81760f1673584a7b7f6c195cff566cb5", "thumbnail_srcset": "https://si.imgix.net/97f10250/uploads/origins/b4b7cec9-bc00-428b-9361-458125e143d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81760f1673584a7b7f6c195cff566cb5, https://si.imgix.net/97f10250/uploads/origins/b4b7cec9-bc00-428b-9361-458125e143d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e9f1c683af2de792624e136bd636301 2x, https://si.imgix.net/97f10250/uploads/origins/b4b7cec9-bc00-428b-9361-458125e143d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e381eed9c3b5913ecd6fbf6c64b73f28 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sirozanetuna/works/32", "thumbnail_src": "https://si.imgix.net/a0b1edce/uploads/origins/d17a2059-7fd8-4e9f-a281-c4daebdeafa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a5c4b48050080b2ad0f07bad62296ff", "thumbnail_srcset": "https://si.imgix.net/a0b1edce/uploads/origins/d17a2059-7fd8-4e9f-a281-c4daebdeafa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a5c4b48050080b2ad0f07bad62296ff, https://si.imgix.net/a0b1edce/uploads/origins/d17a2059-7fd8-4e9f-a281-c4daebdeafa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a794b87957a4873d26baf0b18182711a 2x, https://si.imgix.net/a0b1edce/uploads/origins/d17a2059-7fd8-4e9f-a281-c4daebdeafa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd2a075d9bfb5b4d3bd9bf477e89c8b6 3x", "genre": "art", "nsfw": true, "body": "はじめまして。pixiv等でクリエイター様の原神作品(綾華×香菱シリーズ)を拝見しました\n興味を持ちまして依頼失礼します\n\n\n原神のネフェル(ゲーム内には登場済みで近々実装)と夜蘭のレズバトル\n\nどちらも裸でリップを唇に塗っている\n色はネフェルは緑系、夜蘭は青系とそれぞれのイメージカラー(クリエイター様の判断や好みで別カラーでもOK)。\n\n私好みで両者とも長手袋＆ニーハイ(もしくはトレンカ)系を履いている(無理に見える描写や構図にする必要は無い)\n\n\nベッドの上でお互いにマウントをリードを取る勢いで相手の唇を奪い吸うように貪り合い激しいキスを繰り返す\n\nキスだけではなく舌も相手の口の中に入れてたり相手の舌と絡め合う\n\nでも互いに仲が悪いと言う感じも無く愛し合い認め合う\n\n\nクリエイター様の綾華×香菱シリーズからの発想であります。つまり綾華×香菱をネフェル✕夜蘭に置き換えたレズバトルとも\n\n\nゲーム内で同業者だからか互いに飲みあってる会話の際にもバチバチな空気を出している事から今回の構図内容を思いつきました\n\n\nはじめての依頼故に雑な中身ではありますが…検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sirozanetuna/works/31", "thumbnail_src": "https://si.imgix.net/4f51f9cc/uploads/origins/fd8964c4-1f5e-42e9-ad4c-95ace4ec2c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70102c451966572d3e66b86459632aee", "thumbnail_srcset": "https://si.imgix.net/4f51f9cc/uploads/origins/fd8964c4-1f5e-42e9-ad4c-95ace4ec2c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70102c451966572d3e66b86459632aee, https://si.imgix.net/4f51f9cc/uploads/origins/fd8964c4-1f5e-42e9-ad4c-95ace4ec2c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f5f69eb7698cb59071474f0d771c1a3 2x, https://si.imgix.net/4f51f9cc/uploads/origins/fd8964c4-1f5e-42e9-ad4c-95ace4ec2c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=939fbea39779dc754a1a3b96bcbba438 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n今回は以前リクエストさせていただいたこちら(https://skeb.jp/@sirozanetuna/works/22)の続きをリクエストさせていただきます。\n\n前回のキス責めされているところから始まって、そこからひたすら姫野にキス責めされるマキマ。\n\n途中で姫野が舌を思いっきり出し、アゴから鼻にかけてべろぉーんと舐め上げる。\nこの時鼻に舌を長めに押し付けている感じにしていただけるとありがたいです。\n\nそうしてキス責めが続く中姫野が嘔吐きはじめ、マキマの口を手で塞ぎゲップを思い切り鼻に浴びせる。\n\nあまりの臭いにマキマは白目を向いて気絶してしまう。\n\nと言った感じのものをお願いします。細かいセリフなどはお任せします。\n\n前回の続きということでマキマには引き続き鼻フックを付けたままでお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sirozanetuna/works/30", "thumbnail_src": "https://si.imgix.net/e81970ad/uploads/origins/8a9e7561-f511-4f09-93db-e08cecf3b7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4eb953d12cc1163b07995b8917afa06", "thumbnail_srcset": "https://si.imgix.net/e81970ad/uploads/origins/8a9e7561-f511-4f09-93db-e08cecf3b7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4eb953d12cc1163b07995b8917afa06, https://si.imgix.net/e81970ad/uploads/origins/8a9e7561-f511-4f09-93db-e08cecf3b7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=832714f7c8fe6ecb5815759e6f2c33d8 2x, https://si.imgix.net/e81970ad/uploads/origins/8a9e7561-f511-4f09-93db-e08cecf3b7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcac450b0853140c62b8c76cb7974b77 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sirozanetuna/works/29", "thumbnail_src": "https://si.imgix.net/d515ca5a/uploads/origins/2c59c9cd-8264-4ab8-93a1-e58fb24e3ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2932cf52e65dda0f57756f8d1a4c653", "thumbnail_srcset": "https://si.imgix.net/d515ca5a/uploads/ori