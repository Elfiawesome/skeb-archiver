e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58a92102c5ef8b21cb116154b9f5416f, https://si.imgix.net/45a765c8/uploads/origins/f297e90b-a349-4223-8b27-8cc467d6b3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff44bc897e7d0729b43c15e2e0b1a450 2x, https://si.imgix.net/45a765c8/uploads/origins/f297e90b-a349-4223-8b27-8cc467d6b3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd691e4cb513e45b9f498443053e2b2b 3x", "genre": "art", "nsfw": false, "body": "オレンジ色のビキニを着た私のオリジナルキャラクターを描いてください。セクシーなポーズで。\n目の色：グレー\n\n身長: 5'9 \"\n\n年齢: 20\n\n犬耳\n\nアクセサリー：赤い首輪\n\n背景: ビーチ\n\nポーズ: セクシー\n\n表情：浮気\n\n私のオリジナルキャラクターの参考文献はこちら: https://www.deviantart.com/citrusanime/art/My-Offical-DA-Mascot-290687270\n\n他のアーティスト 1. https://sta.sh/023ht6z36vqf 2. https://sta.sh/0278r2mg6ixd 3. https://sta.sh/0k1ja8v3adq\n\nポーズの参考文献 1. https://sta.sh/0ufsyy8di0d 2. https://sta.sh/0sozjsty4p7 3. https://sta.sh/01hzsy3ciyyy\n\nセクシーに描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@nori_mame_/works/4", "thumbnail_src": "https://si.imgix.net/edd11dd4/uploads/origins/afca5b2e-6884-4abf-ad8e-3a938d7106ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4370e11cc1f1881617fad71d0cadafc5", "thumbnail_srcset": "https://si.imgix.net/edd11dd4/uploads/origins/afca5b2e-6884-4abf-ad8e-3a938d7106ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4370e11cc1f1881617fad71d0cadafc5, https://si.imgix.net/edd11dd4/uploads/origins/afca5b2e-6884-4abf-ad8e-3a938d7106ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8335c57312f32ca1e0cd79a616d25a87 2x, https://si.imgix.net/edd11dd4/uploads/origins/afca5b2e-6884-4abf-ad8e-3a938d7106ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4aca37ddc0199b6091b90b91a9576762 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます\nhttps://twitter.com/yuckak3/status/1698999413719617905\nhttps://skeb.jp/@kinenbicyan/works/98\nhttps://skeb.jp/@Ow_neenn/works/1\nhttps://twitter.com/KomaTsura502/status/1730963975297511537\nええ、最低限の設定は順守しつつ自由に描いてみてください", "created_at": "", "completed_at": ""}, {"path": "/@nori_mame_/works/3", "thumbnail_src": "https://si.imgix.net/8db1705e/uploads/origins/2b91c2a6-a21f-42e7-bef1-ba18ea68972a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8ce47439dfc6884df736c6f6aee74f0", "thumbnail_srcset": "https://si.imgix.net/8db1705e/uploads/origins/2b91c2a6-a21f-42e7-bef1-ba18ea68972a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8ce47439dfc6884df736c6f6aee74f0, https://si.imgix.net/8db1705e/uploads/origins/2b91c2a6-a21f-42e7-bef1-ba18ea68972a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ba82588e7026ffd9c0dc5d700719f6c 2x, https://si.imgix.net/8db1705e/uploads/origins/2b91c2a6-a21f-42e7-bef1-ba18ea68972a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7cb3baf0bcf65b60685eff82ba85b50 3x", "genre": "art", "nsfw": false, "body": "初めまして、新人Vtuberの志熊シグと申します。今回は商用SNS等での利用を考えた。イラストを描いていただきたいです。お願い致します。下記がTwitter URLです。YouTubeのリンクや画像がありますので資料として使っていただけたら幸いです。\n\nhttps://x.com/shigumaaaaaaa11/status/1738956129299030205?s=46&t=Y3PPOx6lZHkmFhJiIJ-uNQ", "created_at": "", "completed_at": ""}, {"path": "/@nori_mame_/works/2", "thumbnail_src": "https://si.imgix.net/441c3c42/uploads/origins/7bfaf24e-ddb7-4cde-b6bd-0e520ab9e621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1ae03072341c1ae53bcb43bb88cd78", "thumbnail_srcset": "https://si.imgix.net/441c3c42/uploads/origins/7bfaf24e-ddb7-4cde-b6bd-0e520ab9e621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1ae03072341c1ae53bcb43bb88cd78, https://si.imgix.net/441c3c42/uploads/origins/7bfaf24e-ddb7-4cde-b6bd-0e520ab9e621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d14d37a27464493fb478de5dd61fab19 2x, https://si.imgix.net/441c3c42/uploads/origins/7bfaf24e-ddb7-4cde-b6bd-0e520ab9e621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b67811f5cf2f1208b79b20527b13f7c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の創作漫画のキャラをお願いします。\n男キャラか女キャラどちらか一人を選んでお描きください。\n\n■女キャラの場合\n「桜（サクラ）」を描いてください。\n\n前髪は目が隠れるぐらい長いが頭の上で結んでおでこを出してもどっちでも可です。\n衣装はカスタマイズしてもらってもかまいません。\n\nビジュアルの資料は以下です↓\nhttps://twitter.com/SakumaGinmaru/status/1574735461817659393\n\nこのキャラが出てくる漫画の回は以下です↓\nhttps://manga-no.com/episodes/105b36c1baf95ef6064\n※読まなくてもどちらでもよいですがどんなキャラなのかの参考に必要でしたらどうぞ。\n\n■男キャラの場合\n十七夜（かなぎ）を描いてください。\n\nキャラの特徴↓\nふわふわ金髪ロン毛で後ろで軽く結っている、三白眼、ギザ歯、右頬に傷、右腕がない、やせ型\n\nキャラの三面図資料の載っているページ↓\nhttps://sakuma-ginmaru.fanbox.cc/posts/3600156\n\n悪い表情でかっこよく描いてもらえると嬉しいです。\n細かいシチュエーションは申し訳ないのですが思いつかないのでお任せします。\n羽織や細かい装飾は大変そうなら省略しても大丈夫です。\n\n−−−−−−−−\n\n描いて頂いたイラストは自分のブログ等に掲載させていただく場合があります。\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nori_mame_/works/1", "thumbnail_src": "https://si.imgix.net/a18797a6/uploads/origins/aa93df9e-e24b-43de-88b0-5ae9afc3faee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4dfa516cd4067631659907fc858d6f7", "thumbnail_srcset": "https://si.imgix.net/a18797a6/uploads/origins/aa93df9e-e24b-43de-88b0-5ae9afc3faee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4dfa516cd4067631659907fc858d6f7, https://si.imgix.net/a18797a6/uploads/origins/aa93df9e-e24b-43de-88b0-5ae9afc3faee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a08c55cbb247e6d423377a251a95f42 2x, https://si.imgix.net/a18797a6/uploads/origins/aa93df9e-e24b-43de-88b0-5ae9afc3faee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1befa2ef18bb098b647695e60a18e1e3 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nＸ上での宣伝を拝見しまして、便乗する様で恐縮ですがリクエストさせていただきます。\nアズールレーンより「ネプチューン」を描いて欲しいです。\nデフォルトの衣装か、直近の着せ替えのドレス衣装でお願いしたいですが、他に着せたい衣装があれば（他キャラの衣装やいっそ水着等でも）、装備やアクセサリー等も自由で構いません。\n色っぽい、悪戯っぽい表情やポーズだと嬉しいですが、概ねお任せします。お好きな様に描き下さい。\nスマホ壁紙での使用を想定しているので縦長での、膝か腰より上の画で(いっそ全身像でも)、水辺を想起させる様な背景やエフェクトあると喜びますが、いずれも余裕があればで簡素なものでも大丈夫です。\nゆっくり描いて頂いて構いません。ご一考の程よろしくお願いします。", "created_at": "", "completed_at": ""}]}