2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18727975794144123a65d3dfbd8f2201", "thumbnail_srcset": "https://si.imgix.net/8c318426/uploads/origins/dc597446-1c3f-4803-81b1-6ece9554ea77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18727975794144123a65d3dfbd8f2201, https://si.imgix.net/8c318426/uploads/origins/dc597446-1c3f-4803-81b1-6ece9554ea77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe5cb3a856795bbb323de691ed363442 2x, https://si.imgix.net/8c318426/uploads/origins/dc597446-1c3f-4803-81b1-6ece9554ea77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68515ccbd541331e2aa03761b815b3a1 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターであるフロストが、暗い部屋で金属の下で踊っているような、彼女のゴシックスタイルに合った絵や、机に向かって何か科学的な本を読んでいるような、彼女が研究しているアーティファクトを理解しようとしているような絵が欲しい。\n\n彼女のゴシックな服装なのか科学的な服装なのか、服装の選択も含めてアイデアはお任せします。\n\nhttps://drive.google.com/drive/folders/1zUWry2f1Miy1qTw2YYzDXIL6vmSPOqDG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/34", "thumbnail_src": "https://si.imgix.net/5f30168e/uploads/origins/5db47bd6-f49f-4bb3-9671-7a3bd3147eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d95b81a9216381f78b357f2272744f8", "thumbnail_srcset": "https://si.imgix.net/5f30168e/uploads/origins/5db47bd6-f49f-4bb3-9671-7a3bd3147eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d95b81a9216381f78b357f2272744f8, https://si.imgix.net/5f30168e/uploads/origins/5db47bd6-f49f-4bb3-9671-7a3bd3147eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7054bd456a5f7a2b68fad550d5ea625d 2x, https://si.imgix.net/5f30168e/uploads/origins/5db47bd6-f49f-4bb3-9671-7a3bd3147eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43e6546fe49defb551939990a631bd27 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/33", "thumbnail_src": "https://si.imgix.net/dda567be/uploads/origins/ebfb764a-caf9-40b1-b355-96df2268dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=407c5a630611f9044cab6dd25285e518", "thumbnail_srcset": "https://si.imgix.net/dda567be/uploads/origins/ebfb764a-caf9-40b1-b355-96df2268dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=407c5a630611f9044cab6dd25285e518, https://si.imgix.net/dda567be/uploads/origins/ebfb764a-caf9-40b1-b355-96df2268dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72372e3d7c2789b328f3287d6c93cf5a 2x, https://si.imgix.net/dda567be/uploads/origins/ebfb764a-caf9-40b1-b355-96df2268dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a4b05ea500d511e0efb726fc957ad73 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\n今回は、初詣でお祈りしている原罪ママをお願いします。\nお着物を着て、髪も結って飾りを付けていると助かります。\nまた、「お祈りして目を閉じている状態」と、「お祈りしながらこちらに優しく微笑んでいる状態(「今年1年もよろしくね」といった表情で)」の表情差分もお願い致します。\n\nもし、原罪ママのキャラクター的に初詣に行くのが解釈違いのようであれば、正月に家で全力でくつろいでいる原罪ママをお願い致します。\nその場合は、本当に全力でくつろいでいただけると助かります。(例えば、こたつでみかんを食べながらみかんの皮で遊んでいたりすると、特に可愛いのでありがたいです。)\n\n\nお忙しい時期の依頼となってしまっていましたら大変申し訳ございません。\n何卒、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/32", "thumbnail_src": "https://si.imgix.net/7ba5edd6/uploads/origins/5dc5b190-0aea-4003-8f55-24d4c4a70a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c301969a20958b5ed11c1e88058ca08", "thumbnail_srcset": "https://si.imgix.net/7ba5edd6/uploads/origins/5dc5b190-0aea-4003-8f55-24d4c4a70a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c301969a20958b5ed11c1e88058ca08, https://si.imgix.net/7ba5edd6/uploads/origins/5dc5b190-0aea-4003-8f55-24d4c4a70a80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d616be80eefbe2ae96c938b2d700051 2x, https://si.imgix.net/7ba5edd6/uploads/origins/5dc5b190-0aea-4003-8f55-24d4c4a70a80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4512a5130694053eb27836c7dedc4d6b 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\n今回はサンタの服を意識した衣装の原罪ママをお願いします。\n以前描かれていたサンタの付け髭をしている原罪ママがかなり気に入っているので、髭の有無差分があると助かります。\nまた、ドヤ顔の原罪ママを見てみたいので、今回のイラストは、子供にプレゼントを届けてお礼を言われ、満更でもない様子でドヤ顔している原罪ママをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/31", "thumbnail_src": "https://si.imgix.net/adb108e5/uploads/origins/6bacde17-e5b9-40c6-b045-be60a11fa09e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aebf1bfdd26394923875f0f7df32d297", "thumbnail_srcset": "https://si.imgix.net/adb108e5/uploads/origins/6bacde17-e5b9-40c6-b045-be60a11fa09e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aebf1bfdd26394923875f0f7df32d297, https://si.imgix.net/adb108e5/uploads/origins/6bacde17-e5b9-40c6-b045-be60a11fa09e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3d96d580ec47ca33fac37c3f2c8bb54 2x, https://si.imgix.net/adb108e5/uploads/origins/6bacde17-e5b9-40c6-b045-be60a11fa09e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a690574639018d9e72bf7c35f7ef2fd4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/30", "thumbnail_src": "https://si.imgix.net/8a866b30/uploads/origins/29f3ce18-5402-4552-aa97-2cc01259afbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f44e8ef76d34791cf726d437ca90a6", "thumbnail_srcset": "https://si.imgix.net/8a866b30/uploads/origins/29f3ce18-5402-4552-aa97-2cc01259afbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f44e8ef76d34791cf726d437ca90a6, https://si.imgix.net/8a866b30/uploads/origins/29f3ce18-5402-4552-aa97-2cc01259afbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa9b04fe1365a1bfabb8f5f8f8475acc 2x, https://si.imgix.net/8a866b30/uploads/origins/29f3ce18-5402-4552-aa97-2cc01259afbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca7abecb622554e00264038d19e66bf7 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\n\n今回はゴスロリを着た原罪ママをお願いします。\n細かい指定はありませんが、最低限の希望として\n\n・カラーリングはピンクまたは黒、またはその両方を起点とした物\n・衣装パーツとして頭部にフリルカチューシャ\n\nの2点をお願いします。\nまた、可能であれば表情差分として\n\n・着せられてムスッとしている顔\n・嬉々としてゴスロリを楽しんでいる顔\n\nの２通りをいただけるとより幸いです。\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/29", "thumbnail_src": "https://si.imgix.net/8e3c41c5/uploads/origins/8e2e7b0f-5aa6-4058-9728-740762b85f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08365d67eaa45d9918963173f193f0ce", "thumbnail_srcset": "https://si.imgix.net/8e3c41c5/uploads/origins/8e2e7b0f-5aa6-4058-9728-740762b85f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08365d67eaa45d9918963173f193f0ce, https://si.imgix.net/8e3c41c5/uploads/origins/8e2e7b0f-5aa6-4058-9728-740762b85f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=661f2cc4d124a4d04e3ebdcb45535dbe 2x, https://si.imgix.net/8e3c41c5/uploads/origins/8e2e7b0f-5aa6-4058-9728-740762b85f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8058f60e68ccc703703a81cbf2798a5b 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\n\n下着の上に彼シャツを着てニッコリしている原罪ママをお願いします。\n俗にいう彼シャツはダボダボのシャツを着たイメージですが、原罪ママの体格的に考えて逆に丈が少し足りていないとかで、ヘソチラなどして頂いてもとてもありがたいです。もちろん通常通りダボシャツを着た姿でも助かります。\n何卒よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/28", "thumbnail_src": "https://si.imgix.net/e8bdb875/uploads/origins/832dc3d3-fd13-4fc2-831f-f66633173c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef81f1d0a136284d77a0efd7556aaa9", "thumbnail_srcset": "https://si.imgix.net/e8bdb875/uploads/origins/832dc3d3-fd13-4fc2-831f-f66633173c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef81f1d0a136284d77a0efd7556aaa9, https://si.imgix.net/e8bdb875/uploads/origins/832dc3d3-fd13-4fc2-831f-f66633173c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9ef6af5b18b1d9500feb7918a4de33d 2x, https://si.imgix.net/e8bdb875/uploads/origins/832dc3d3-fd13-4fc2-831f-f66633173c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=736debb00ec4e0219d5efde90071a00a 3x", "genre": "art", "nsfw": false, "body": "こんにちはです\nうちの子のコルトちゃんのイラストをお願いします。\n\n・特徴として特大級の胸、頭についている蝶々と胸元にある惑星、3m以上の長身。\n・胸の大きさは変えることができ、最小で腰ぐらい、最大で接地級の大きさも可能。（体の大きさも変えることができる））\n\n内容\n・シチュエーションはすべてお任せしますが、巨体ですので何かしらの対象比較ができるものがあるとよいです。\n・胸の大きさは描ける限界の大きさまでお願いします（大きければ大きいほど助かります。）\n\n参考として以下のURLでSSをまとめたものがありますので、参考していただければと。\nhttps://drive.google.com/drive/folders/1X4HGXlrng89662FBDraS-fMjiyhZNLgK?usp=sharing\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kiRegiris/works/27", "thumbnail_src": "https://si.imgix.net/1b7ef7df/uploads/origins/f0daca31-dd74-4859-ac84-9970b0dfeb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a12d23a5bae91938fc79b73b6284da", "thumbnail_srcset": "https://si.imgix.net/1b7ef7df/uploads/origins/f0daca31-dd74-4859-ac84-9970b0dfeb4d?bg=%23fff&auto=format%2