FFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01e8cc640187979ce00a5d964281b181 2x, https://si.imgix.net/99ec7e62/uploads/origins/8d675f42-da8a-4c98-a3ac-1170b34aefd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=121a01093cd102b564707b693edeb7e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/9", "thumbnail_src": "https://si.imgix.net/5121d504/uploads/origins/d51a20a5-65d9-4bbf-a272-eddc3c85873c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abd6c3ad2e74810ae65f5271ee8de71d", "thumbnail_srcset": "https://si.imgix.net/5121d504/uploads/origins/d51a20a5-65d9-4bbf-a272-eddc3c85873c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abd6c3ad2e74810ae65f5271ee8de71d, https://si.imgix.net/5121d504/uploads/origins/d51a20a5-65d9-4bbf-a272-eddc3c85873c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55403570a391f717cd65ee0455b434f1 2x, https://si.imgix.net/5121d504/uploads/origins/d51a20a5-65d9-4bbf-a272-eddc3c85873c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c87b530d324e8e177ed6f7e06977614 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/8", "thumbnail_src": "https://si.imgix.net/a25ed57b/uploads/origins/1c3fc08d-c6d6-4413-bb0a-70f3f61eb5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07c9ea7e2f07c7e97065f60ca4f003dd", "thumbnail_srcset": "https://si.imgix.net/a25ed57b/uploads/origins/1c3fc08d-c6d6-4413-bb0a-70f3f61eb5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07c9ea7e2f07c7e97065f60ca4f003dd, https://si.imgix.net/a25ed57b/uploads/origins/1c3fc08d-c6d6-4413-bb0a-70f3f61eb5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87f8c2f48b914cf43ba7ef2d47f63843 2x, https://si.imgix.net/a25ed57b/uploads/origins/1c3fc08d-c6d6-4413-bb0a-70f3f61eb5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb502b80bfd27698e62ee9f55b011a35 3x", "genre": "art", "nsfw": false, "body": "榊原またぎ先生、私は先生の作品が好きです。\n\nクールで自信のある感じで描いてください。\n構図はお好みで。\n\n参考までにキャラクターの詳細を：\n一般的には15〜16歳くらいの女の子で、凍てつくような印象があります。\n冷たい霧、鋭い氷、星空などが印象的です。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1o_QstI61OVnJHjV3kXiE8rNnU-gIkUwd?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/7", "thumbnail_src": "https://si.imgix.net/97a368fd/uploads/origins/6d3d666a-f410-4d8d-8f88-bce90ee71853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00a9ddceb4db714c0c4e4cbd287632f6", "thumbnail_srcset": "https://si.imgix.net/97a368fd/uploads/origins/6d3d666a-f410-4d8d-8f88-bce90ee71853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00a9ddceb4db714c0c4e4cbd287632f6, https://si.imgix.net/97a368fd/uploads/origins/6d3d666a-f410-4d8d-8f88-bce90ee71853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b6bfa8faf44abca7e6e947500a99745 2x, https://si.imgix.net/97a368fd/uploads/origins/6d3d666a-f410-4d8d-8f88-bce90ee71853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b9a8a9cc43ae9027574bbee691fabe2 3x", "genre": "art", "nsfw": false, "body": "またまた妖艶な魔性の村娘でリクエストさせて頂きます！\n今回は村の外れの川で水汲み中か何かのアクシデントで、頭から水を被ってしまいビショ濡れになるのですが、そんな状態でも平然としており、\n逆に妖しく微笑んで「責任取ってくれる？」「着替え、手伝ってくれるわよね？」とドキドキすることを誘うように囁いているイメージです。\n前回までは台詞無しでしたが今回は実際に台詞付きとなります。\n体勢は地面に膝から座り込む、いわゆるぺたん座りの感じで、やや見上げるようなカメラ視点です。\nまた、全身水を浴びて滴っているということで、谷間に水が溜まってる・胸を強調してると個人的に嬉しいです。\n\n基本的に上記に沿っていれば、それ以外の要素は好きに考えても構いません！\n\n以上で宜しければ何卒ご検討をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/6", "thumbnail_src": "https://si.imgix.net/a4329841/uploads/origins/b6506e5e-7d4e-45bd-8dea-59db496382de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a6151b7224018a560c2f7ab9a1445e", "thumbnail_srcset": "https://si.imgix.net/a4329841/uploads/origins/b6506e5e-7d4e-45bd-8dea-59db496382de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a6151b7224018a560c2f7ab9a1445e, https://si.imgix.net/a4329841/uploads/origins/b6506e5e-7d4e-45bd-8dea-59db496382de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e5e7b33589c0ea9deda50be95acf62a 2x, https://si.imgix.net/a4329841/uploads/origins/b6506e5e-7d4e-45bd-8dea-59db496382de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=731cc4707e3b3d5b0a90b400077df106 3x", "genre": "art", "nsfw": false, "body": "はじめまして！作品を拝見したところとっても素晴らしいのでうちの子のユスティナちゃんをお願いしたいです！\n構図やシチュエーションはおまかせします。\n黒い翼と黒い輪っかの要素が欲しいです!\n外見、服装等は描きやすいように改変していただいて構いません。\n\nご検討よろしくお願いします。\n\n\n\nhttps://drive.google.com/drive/u/0/folders/1wq8Eo3vSv3AzYmg3ehOexoufyhPYtPQl", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/5", "thumbnail_src": "https://si.imgix.net/9442c6d6/uploads/origins/d826de5c-8941-4633-869c-06aea241668a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12d49c91ae581e7d069049338fc302b0", "thumbnail_srcset": "https://si.imgix.net/9442c6d6/uploads/origins/d826de5c-8941-4633-869c-06aea241668a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12d49c91ae581e7d069049338fc302b0, https://si.imgix.net/9442c6d6/uploads/origins/d826de5c-8941-4633-869c-06aea241668a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a07a72516fdf02dce9e23e22caec4eda 2x, https://si.imgix.net/9442c6d6/uploads/origins/d826de5c-8941-4633-869c-06aea241668a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=545037de563d3b1326c0a584ef67e877 3x", "genre": "art", "nsfw": false, "body": "前回は妖艶な村娘お姉さんをありがとうございました。\n今回は同じキャラクターで違うシチュエーションをリクエストしたいと思います！\n場所は村の納屋の中というイメージで、お姉さんはカメラ目線で木箱に座りながら、谷間になんかの宝箱の鍵を挟んでおり、「そのお宝が欲しいのかしら？」と見せつけるようにして妖しく挑発しています。\n肩紐の片側を下にずらして妖しさを増していると嬉しいです。\n\nよければご検討をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/4", "thumbnail_src": "https://si.imgix.net/5b7f90bc/uploads/origins/8a15d762-7ffe-47aa-bcd9-7d21196565ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcfb80a9e772352d26a628464d06076", "thumbnail_srcset": "https://si.imgix.net/5b7f90bc/uploads/origins/8a15d762-7ffe-47aa-bcd9-7d21196565ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcfb80a9e772352d26a628464d06076, https://si.imgix.net/5b7f90bc/uploads/origins/8a15d762-7ffe-47aa-bcd9-7d21196565ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=300b4d63008057a12eebe31790a980a1 2x, https://si.imgix.net/5b7f90bc/uploads/origins/8a15d762-7ffe-47aa-bcd9-7d21196565ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bf196bc29dc5d2627b68dec095d95b0 3x", "genre": "art", "nsfw": false, "body": "色っぽい大人のお姉さんの絵をリクエストします。\nコンセプトとしては「魔性の村娘」という感じで、中世ファンタジーっぽい紫基調のドレスに谷間をがっつり見せており、スカートもスリットが入っています。頭も村娘っぽい頭巾をかぶってます。\nお姉さん自身抜群なスタイルの持ち主で、バストサイズも大きいです。\n表情は色目を使い、悪っぽくて妖艶な笑みを浮かべているイメージです。\n\n以上で宜しければご検討をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@matagi_14/works/3", "thumbnail_src": "https://si.imgix.net/75b45587/uploads/origins/436599db-c138-4d78-ad89-e5ff25174b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3653dce55515c10bba192a205459fb