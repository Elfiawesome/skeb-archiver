%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20cbb8e00bd6851c66367d7b5da61410 2x, https://si.imgix.net/796a2d2a/uploads/origins/afdbcfdf-4e45-40db-956b-ac3e47435fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0277c9a2ecf26831eabcfee392e3c0c5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/18", "thumbnail_src": "https://si.imgix.net/2248a9aa/uploads/origins/ad31746f-4bb7-43ac-9cf2-1b496eede9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d86cf34cc236e9d543c9656cd20fac", "thumbnail_srcset": "https://si.imgix.net/2248a9aa/uploads/origins/ad31746f-4bb7-43ac-9cf2-1b496eede9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d86cf34cc236e9d543c9656cd20fac, https://si.imgix.net/2248a9aa/uploads/origins/ad31746f-4bb7-43ac-9cf2-1b496eede9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5877305242d9ba405764bab130f1c4d 2x, https://si.imgix.net/2248a9aa/uploads/origins/ad31746f-4bb7-43ac-9cf2-1b496eede9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6cd4db63cd2cc86bbbf536f3c13aefb 3x", "genre": "art", "nsfw": false, "body": "お世話になっております！\nskebの再開お待ちしておりました…！\n\nもし良ければ、私と友人の探索者をリクエストさせてください！\n「ようこそ！迷冥市役所都市伝説課へ！」というシナリオで作成したキャラになります。\n2人は先輩と後輩です。\n\n________________________\n\n【先輩】黄鶲\n黄色い方。物腰は穏やかで落ち着いているが、生活能力が大変乏しい。\nメシマズ。肉体派。静かに過保護。\n\n【後輩】朱鷺\n赤い方。元気で明るく、ヒーローを目指している。いつも一生懸命。\n声が大きい。趣味はゲーム。根暗の陽キャ。\n\n________________________\n\n\nさいとうさんの構成する画面がとても大好きなので、好きなように描いていただきたいです！\nもしなにかイメージをお伝えした方が描きやすければ、和風のようなモチーフや、コンビネーションの合っているシチュエーション、または鳥のような意匠がどこかに入っている等…があると嬉しいです！（これらはなくても全く構いません！）\n\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-kMTu5jNQmy4buBZ9NQFJqfxmm75BFfO", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/17", "thumbnail_src": "https://si.imgix.net/48a6a5c3/uploads/origins/9cb949d6-52fb-433e-959c-210e5a05ca88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d1b34a7eeaaca4b79be18fc0047b2a", "thumbnail_srcset": "https://si.imgix.net/48a6a5c3/uploads/origins/9cb949d6-52fb-433e-959c-210e5a05ca88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d1b34a7eeaaca4b79be18fc0047b2a, https://si.imgix.net/48a6a5c3/uploads/origins/9cb949d6-52fb-433e-959c-210e5a05ca88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c16f9825598c27b538dab82d266bdb34 2x, https://si.imgix.net/48a6a5c3/uploads/origins/9cb949d6-52fb-433e-959c-210e5a05ca88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ed2c60acebfa230710b998979e5b5bb 3x", "genre": "art", "nsfw": false, "body": "こんばんは、前回依頼を引き受けていただき本当にありがとうございました！\n\n今回またSkeb受付を再開されたということで、是非依頼させていただきたいと思い、送信させていただきます。どうしても書いていただきたいのが4人という人数になってしまいご負担になられると思いますので、金額等の上乗せあれば再送していただければと思います。\n\n今回依頼したいのは以下の4名です。\n\n①黒髪の女性\n女学生。表情を崩すことがなく、基本的にクールな印象を受けるが、好奇心は強めで色々なことに挑戦したがる傾向にある。家が神社で自身も巫女をやっているためそちらの方面にも強い。裁縫が趣味。\n\n②黒髪の男性\n特憲隊に所属している。無表情が主だが最近は上司の無茶ぶりが酷く死んだ目をしていることも多い。基本的に冷静だが肉体的に頑健なため力で解決できそうなときは何も考えずに破壊に走ることもままある。\n\n③茶髪の男性\n大学教授。心理学専攻。声が大きく快活だが常識人なため④などによく振り回されている。オカルト系に目がなく、そちらの分野を話し始めると長い。溺愛している許嫁がいる。\n\n④着物の男性\n資産家のおじさん。羽振りが良くお願いしたらなんでも買ってくれるタイプの人。飄々としておりなんにでも首を突っ込んでは何もせずに帰っていく……というようなことを繰り返している。\n\n　身長差：②＞④＞③＞①\n\n舞台は昭和初期の日本です。\n全員事件をきっかけに出会い様々なことをしていくうちに顔見知りになったかたちで、仲がいいというよりは腐れ縁に近いですが、お互いを助ける程度の仲間意識はあるような形の関係性です。\n\n昭和初期くらいのレトロな雰囲気がさいとうさんの絵で見たい……！と思い、依頼させていただきます。よければ引き受けてくださるととても嬉しいです……！よろしくお願いいたします。\n\n花硲\n\nhttps://drive.google.com/drive/folders/1NSKwKX5mg5ea_Twm8K9_C5EMd0m_9jOq?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/16", "thumbnail_src": "https://si.imgix.net/27e13acf/uploads/origins/551733a5-d579-458e-999f-f4de42862c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d84d065bac15cfd1b63912e7c1327d2e", "thumbnail_srcset": "https://si.imgix.net/27e13acf/uploads/origins/551733a5-d579-458e-999f-f4de42862c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d84d065bac15cfd1b63912e7c1327d2e, https://si.imgix.net/27e13acf/uploads/origins/551733a5-d579-458e-999f-f4de42862c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcbc3f48cf3608da83cac71d6994b57d 2x, https://si.imgix.net/27e13acf/uploads/origins/551733a5-d579-458e-999f-f4de42862c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7d80c0062115012b7da579ec08c05f6 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nこの度skebにて齊藤様の目を惹くハイセンスな配色、キャラクターの存在している風景表現が素敵なイラストをお見かけし、リクエストさせていただきました。\n\n【希望】\nクトゥルフ神話TRPGを遊ぶ際に使用している、友人とのOC2人のイラストをお願いします。\n可能であれば、2人共顔が見えている状態があると嬉しいです。\n上記に限らずシチュエーションや構図などは齊藤様のご自由に描いていただければと思います。\n\n【2人の関係性】\nわちゃわちゃと仲のいい職場の先輩後輩。\n素直で頑張り屋な後輩を先輩がゆるく見守っている(先輩は無意識的だが少し過保護)\n\n【使用用途】\nskebでの依頼であることを伝えた上での友人へのデータ共有\n利益の発生しない個人利用に限るグッズ制作\n\n【キャラクター資料】\nhttps://drive.google.com/drive/folders/16GetLbUwZZpyPS8eLjMNIyRjTnqcrKbl?usp=sharing\n\n\n何か内容や金額等不備、問題がございましたらアピール、キャンセルいただければと思います。\nご縁がございましたら何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/15", "thumbnail_src": "https://si.imgix.net/f9357f7d/uploads/origins/9c7c4db8-ad8d-48dd-b59b-9454630876f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c3ecb1af9a3dba3992945d11f173ea2", "thumbnail_srcset": "https://si.imgix.net/f9357f7d/uploads/origins/9c7c4db8-ad8d-48dd-b59b-9454630876f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c3ecb1af9a3dba3992945d11f173ea2, https://si.imgix.net/f9357f7d/uploads/origins/9c7c4db8-ad8d-48dd-b59b-9454630876f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d65f44ca20b796498760ccd9925869a 2x, https://si.imgix.net/f9357f7d/uploads/origins/9c7c4db8-ad8d-48dd-b59b-9454630876f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f00c2e880737f7d04585e6d2f5caff2d 3x", "genre": "art", "nsfw": false, "body": "齊藤様\n\n初めまして。いつも素敵な雰囲気や色使いのイラストを拝見させていただいています。\n今回スケブを開いてくださるとのことで、この期に是非イラストを\n描いていただきたいと思いリクエスト送らせていただきました。\n(特に社御前歌のイラスト集が好きで何度も読み返しております……！)\n\n以下、リクエスト内容です。お目通しいただけますと幸いです。\n――――――――――――――――――\n⚪︎一枚絵（1人）\n⚪︎使用用途：個人観賞用\n⚪︎サイズ等の仕様：おまかせお願いします\n⚪︎依頼キャラクター :学生戦争ったーという診断メーカーから作成したキャラクターです。\n学生軍人かつ元検体の青年で、主にナイフを使った白兵戦を行っています。\n\n⚪︎参考資料URL:\nhttps://drive.google.com/drive/folders/11hpUU5Gn34Be5CRTdoUv2DFzn_hF5kC2?usp=sharing\n※紫色の制服を着た方をお願いします。\n※衣装の省略などは描きやすいように行っていただいて問題ありません\n\n⚪︎構図など:おまかせでお願いします\n――――――――――――――――――\nお目通しいただきありがとうございます。\n料金が見合わないなど、不適切であれば再送要請又は拒否をしていただけますようお願いいたします。\nご機会合えば是非リクエストを受けていただけますと幸いです。\nお忙しいところ恐れ入りますが、ご検討の程よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/14", "thumbnail_src": "https://si.imgix.net/6ab5272f/uploads/origins/be6f99d9-968e-4f66-9cc5-709357b544c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28ed87416c314a9e6c3741459580e1a3", "thumbnail_srcset": "https://si.imgix.net/6ab5272f/uploads/origins/be6f99d9-968e-4f66-9cc5-709357b544c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28ed87416c314a9e6c3741459580e1a3, https://si.imgix.net/6ab5272f/uploads/origins/be6f99d9-968e-4f66-9cc5-709357b544c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92f633f528cde0b5abcc41285a41f9ee 2x, https://si.imgix.net/6ab5272f/uploads/origins/be6f99d9-968e-4f66-9cc5-709357b544c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=339c9998a0c51efab8b92c54b8909c94 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/13", "thumbnail_src": "https://si.imgix.net/57ba592f/uploads/origins/0703b604-41ef-4b46-9a85-e4b68d8d9ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a0ede187cc3ce73103d82ff5ceb10b", "thumbnail_srcset": "https://si.imgix.net/57ba592f/uploads/origins/0703b604-41ef-4b46-9a85-e4b68d8d9ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a0ede187cc3ce73103d82ff5ceb10b, https://si.imgix.net/57ba592f/uploads/origins/0703b604-41ef-4b46-9a85-e4b68d8d9ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a3fefc61059983617b74e9e4c7776c7 2x, https://si.imgix.net/57ba592f/uploads/origins/0703b604-41ef-4b46-9a85-e4b68d8d9ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aeff06b383ccd503e24c9f4252e07576 3x", "genre": "art", "nsfw": false, "body": "Skebお待ちしてました…！さいとうさんのシックな絵柄と色使いからなる人物や緻密な空間の絵がお洒落で大好きです……\n是非機会があればと思っていたのでこの度の募集に居ても立っても居られず、リクエストを送信させていただきます。\n\nリクエスト内容についてあれもこれもと悩みに悩んだのですが、さいとうさんの描かれるスーツが好き、且つさいとうさんもスーツを描かれるのがお好きだと聞き、スーツを着用しているCOCの探索者のイラストをお願いしたく思いました。\n\n以上から、「絶望⇔希望のローライフ」という2PLシナリオ出身の私のCOC探索者「鈴木清志」と、もう一方のPLほたるさんの探索者「山田義男」の両名のイラストをご依頼とさせていただきます。\n（※今回のリクエストや資料の送付について、ほたるさんにも許可をいただいています）\n\n■もしもリクエストをお受けいただける場合のご参考として、下記にビジュアルの資料や簡単な人物像について記載いたします。（※シナリオについての言及は全て概要情報の範疇のため、ネタバレはございません）\n\n・ビジュアル資料\nhttps://drive.google.com/drive/folders/1dCKpN4TZNoTfJ6YEjMnEFjjAPAp1LHAr?usp=sharing\n\n・簡単な人物像\n【両名共通・前提】\n両名とも死刑判決の下された犯罪者だったが、とある事情から「神話生物懲罰隊」として国に従事する立場となる。\n懲罰隊である証明として赤い腕章を、制服としてスーツを基本的に着用している。\n実際の両名は懲罰隊入りを果たしているが「表向きには死刑が執行された」ことになるため、改名と顔の整形を強いられ、ビジュアルは両名とも整形後のもの。\n\n【鈴木清志】\n24歳男/シリアルキラー/拳銃と拡声器/ツンツン頭・八重歯/171cm・相方に比べて小柄で細身/戦闘差分では瞳が赤いが基本的に真っ黒/張り付けたような笑顔が多い\nCS：\nhttps://charasheet.vampire-blood.net/m1a04c98449ec12a2a2e9e957a6c6ed20\n\n【山田義男】\n30歳男/爆弾魔/斧とダイナマイト/七三分け黒髪メガネ/188cmほど・相方に比べて大柄で筋肉質/心身ともに健やかで表情も快活\nCS：\nhttps://charasheet.vampire-blood.net/m74f741c89b6c6b43dcf319acb472b6d3\n\n長々と大変恐れ入ります。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dCKpN4TZNoTfJ6YEjMnEFjjAPAp1LHAr?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/12", "thumbnail_src": "https://si.imgix.net/48a19c22/uploads/origins/a22dbb99-d14d-4091-9f7a-7af2af04214a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63fe4690940b49078bea7b6fc5d7fd8a", "thumbnail_srcset": "https://si.imgix.net/48a19c22/uploads/origins/a22dbb99-d14d-4091-9f7a-7af2af04214a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63fe4690940b49078bea7b6fc5d7fd8a, https://si.imgix.net/48a19c22/uploads/origins/a22dbb99-d14d-4091-9f7a-7af2af04214a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=386e2636dab3a7677f1b816d14fdae5c 2x, https://si.imgix.net/48a19c22/uploads/origins/a22dbb99-d14d-4091-9f7a-7af2af04214a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b78ed93817bb40e7e2eac6d1da8b1514 3x", "genre": "art", "nsfw": false, "body": "はじめまして、さめよちと申します。\nこの度Twitterにて拝見し、絵柄に惹かれてリクエストを送らせていただきました。\n今回は私と知人のキャラクターを書いていただきたいです。\n\n【OC概要】\nスチエ・ルーンヌイー・スヴェート 28歳 軍人（部隊長）\n自他共に厳しい性格で、無意識に顔を顰めていることが多い。\n面倒見はかなり良い方で、小言を言いながらも色々と世話を焼いてしまう苦労人気質。\nクトゥルフ神話TRPG「GODARCA」HO月\n「今回は運が良かったのでしょう、もっと鍛錬を積まなければ」\n「俺は親ではないんですが！…そういう目で見るのはやめなさい」\n\n【キャラクターデザイン】\n体型：身長188cm、体重90kg前後\n髪色：黒寄りの紫（夜空に近いイメージ）\n髪型：短髪で襟足は少し長め\n目の色：アイボリー（月の光をイメージ）\n服装：規定の隊服をアレンジしたもの\n\n服装等細かい部分に関しては描きやすいよう改変していただいて構いません。\n\n【イラストについて】\n今回は『許諾済同卓PC』というファイル内のキャラクターと私のOCを一緒に描いていただきたいと考えております。人数や人選、ポーズ、表情、構図は全てお任せしますので好きに描いていただければと思います。\n\n【画像サイズについて】\n基本的に指定はないですが、指定した方がよろしければ16：9の比率でお願いします。\n\n【使用用途について】\n基本的には個人使用の範囲内で使わせていただきます。\n\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13gz01OFK3-hSJMVvoAgzI50Q7G9NUgaP", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/11", "thumbnail_src": "https://si.imgix.net/b0522c68/uploads/origins/d5875bef-edb1-4bac-bc2c-84d933ee85cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c3002fed9ad688cfa71f72b702efb8", "thumbnail_srcset": "https://si.imgix.net/b0522c68/uploads/origins/d5875bef-edb1-4bac-bc2c-84d933ee85cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c3002fed9ad688cfa71f72b702efb8, https://si.imgix.net/b0522c68/uploads/origins/d5875bef-edb1-4bac-bc2c-84d933ee85cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=534211399a4a73f3962878428886a2d9 2x, https://si.imgix.net/b0522c68/uploads/origins/d5875bef-edb1-4bac-bc2c-84d933ee85cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6358f9635c4718e49bcf509398468cca 3x", "genre": "art", "nsfw": false, "body": "齊藤様、こんにちは！\nいつも素敵なイラスト拝見させて頂いております。\n\n今回齊藤様に念願の自探索者を描いて頂きたい…！と思い、リクエストをお送りさせて頂きました。\n\n以下は依頼内容となります。\n\n▼資料\n創作（TRPG）のキャラクター\n『藍染 一夏(あいぞめ いちか)』\n\n※資料URLにて\n\n極道の若頭です。送らせて頂いた資料では服装がほぼ同じですが、衣服は自由に描いて頂いて大丈夫です。\n\n▼構図\n何でも大丈夫です！お任せ致します。\n\n▼使用用途\n個人観賞用です。\n\nお手数ですが何卒ご検討頂けますと幸いです。\nどうぞよろしくお願い致します…！\n\nhttps://twitter.com/89_sabure/status/1684313520425295873?t=1X5UQyc1v3N3ji8wceXZcA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/10", "thumbnail_src": "https://si.imgix.net/cc806ca2/uploads/origins/30cb7ab1-9b1f-45a0-89fd-c118d218e601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8d6fbf3d17bda6320f94f74132be36", "thumbnail_srcset": "https://si.imgix.net/cc806ca2/uploads/origins/30cb7ab1-9b1f-45a0-89fd-c118d218e601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8d6fbf3d17bda6320f94f74132be36, https://si.imgix.net/cc806ca2/uploads/origins/30cb7ab1-9b1f-45a0-89fd-c118d218e601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6412d2f39d417d9d77e9933a094b61c7 2x, https://si.imgix.net/cc806ca2/uploads/origins/30cb7ab1-9b1f-45a0-89fd-c118d218e601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed4add073fb3576e9be12c3ba87c0617 3x", "genre": "art", "nsfw": false, "body": "さいとうさんこんにちは！お世話になっております。\nいつも素敵なイラスト拝見しております！さいとうさんの絵が……好きです！！！\n自探索者の絵を是非描いていただきたくリクエストに参りました。\n\n▼依頼内容\nCoCシナリオ「VOID」HO4 旧型アンドロイド\n名前：九死 一生（きゅうし いお）性別は女です\n▼構図/ポーズ等\nお任せ\n▼使用用途\n個人観賞\n\n個人観賞のため、さいとうさんの好きに描いていただければ幸いです。\n探索者の資料URLを添付しておりますが、描きやすいように描いていただければと思います。\n何卒ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1dmZnpezbwCBDjRyQueWk0LTk2BaUiwGV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/9", "thumbnail_src": "https://si.imgix.net/a39e2904/uploads/origins/3704eb8d-1267-4619-bd44-a3a68e9a0f73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d72179801adf9df6a7dbf02dbd228fe1", "thumbnail_srcset": "https://si.imgix.net/a39e2904/uploads/origins/3704eb8d-1267-4619-bd44-a3a68e9a0f73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d72179801adf9df6a7dbf02dbd228fe1, https://si.imgix.net/a39e2904/uploads/origins/3704eb8d-1267-4619-bd44-a3a68e9a0f73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91b940a143fa943e13f831c6281152cc 2x, https://si.imgix.net/a39e2904/uploads/origins/3704eb8d-1267-4619-bd44-a3a68e9a0f73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa259fc19fcc8ed75a859c0aeef1e3ac 3x", "genre": "art", "nsfw": false, "body": "斎藤様こんにちは！\nいつも素敵なイラストを拝見させていただいております。\n斎藤様の描かれるイラストが大好きで、描かれるキャラクターも非常に魅力的で、描かれるイラストの全体的な雰囲気や色使いもとっても素敵でいつも楽しんで斎藤様のイラストを拝見しています。\n\nこの度、斎藤様にオリジナルキャラクターを描いていただければと思い、リクエストをお送りさせていただきました。\nもし何か不手際や無作法がありましたら大変申し訳ありません。\n\n〇資料\n10代後半の男性のオリジナルキャラクター　以下資料です\nhttps://drive.google.com/file/d/152T_ufwkNJs01aWZxcWGEovTpzUOxw8X/view?usp=sharing\n色味やデザインはあまりきちんと決めていないので、あまり参考にならない資料で申し訳ありません。\nキャラクターの特徴は以下のものです。\n・紫がかった銀髪？白髪のような髪色\n・横髪が長く、片方は三つ編みをしています\n・基本的に緩い笑顔がデフォルトの表情です\n・CoCシナリオ『ゾディアックスクール』というシナリオのキャラクターで、高校生です。\n\n〇構図など\nお任せでお願いいたします。\n\n〇使用用途\n・個人観賞用\n・ツイッターのアイコン/ヘッダーへの使用\n後者につきましては、もしも許可していない、ということであれば、\nその旨をお伝えいただくか、何かの形で発信していただければ確認いたしますので、使用は控えます。\n\n本文が長くなってしまい、大変申し訳ないのですが、ご検討いただけますと幸いです。\nよろしくお願いいたします…！\n\nhttps://drive.google.com/file/d/152T_ufwkNJs01aWZxcWGEovTpzUOxw8X/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/8", "thumbnail_src": "https://si.imgix.net/b353262c/uploads/origins/e32b43b8-9fc2-4c9b-89e8-a24cf2050fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74d040724b4f79708c7aabcde6351874", "thumbnail_srcset": "https://si.imgix.net/b353262c/uploads/origins/e32b43b8-9fc2-4c9b-89e8-a24cf2050fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74d040724b4f79708c7aabcde6351874, https://si.imgix.net/b353262c/uploads/origins/e32b43b8-9fc2-4c9b-89e8-a24cf2050fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d1edc5d1ba300ae812ca7a5daef0036 2x, https://si.imgix.net/b353262c/uploads/origins/e32b43b8-9fc2-4c9b-89e8-a24cf2050fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3c5e6c3e61cd151a5f2f2177178b6f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@2slush/works/7", "thumbnail_src": "https://si.imgix.net/8bb63771/uploads/origins/82f9b6c9-c9e0-43b2-8fa1-8cdc0c8c0625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb45ae5a11627122ac4cd