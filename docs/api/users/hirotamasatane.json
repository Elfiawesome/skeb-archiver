5a54/uploads/origins/809dce51-efec-49d5-a5d0-97f36722c01a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5fb045f75e9e273567cd243764e1716, https://si.imgix.net/c8e05a54/uploads/origins/809dce51-efec-49d5-a5d0-97f36722c01a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a5cffbf76c2a98ffd35b1231033d4f8 2x, https://si.imgix.net/c8e05a54/uploads/origins/809dce51-efec-49d5-a5d0-97f36722c01a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=061bf706a6a35505431ea0306e415deb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hirotamasatane/works/332", "thumbnail_src": "https://si.imgix.net/e18075f1/uploads/origins/c15585d4-3667-40ab-87c3-c07d5cc7e761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ba55bef3320480711e10367b367d62", "thumbnail_srcset": "https://si.imgix.net/e18075f1/uploads/origins/c15585d4-3667-40ab-87c3-c07d5cc7e761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ba55bef3320480711e10367b367d62, https://si.imgix.net/e18075f1/uploads/origins/c15585d4-3667-40ab-87c3-c07d5cc7e761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a26b4236fa6b3c1032a43e6af4941283 2x, https://si.imgix.net/e18075f1/uploads/origins/c15585d4-3667-40ab-87c3-c07d5cc7e761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88a346d8302c7bdb12ffea4670483603 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@hirotamasatane/works/326\nこちらの如月ちゃんがとても良かったので、近いシチュエーションでの別キャライラスト作成をお願いしたいです\n\n作成していただきたいのはまどかマギカの眼鏡ほむらで、同様にくぱぁイラストをお願いします\n\n・服装は見滝原の制服か魔法少女の姿を希望しますが、乳首、女性器、アナルが露出して見えるようにしてください\n　タイツや下着などは破いて露出させて構いませんが、和姦の範囲でお願いします\n　\n・女性器は綺麗なピンクでお願いします。陰毛は↓の鷺沢さんくらいに生やしてください\n　https://skeb.jp/@hirotamasatane/works/191\n\n・表情は恥ずかしがっている感じにしてください\n\n\nカラー１枚絵を希望しますが、可能であれば以下の差分を作成願います\n\n・女性器をいじられ愛液が垂れてきている\n\n・中出し後の精液が逆流、胸や顔にも精液がかかっている\n\n相手役の描写は一切不要です。工数が多くなる場合は差分作成を無視していただいて構いません\n\n依頼内容は以上となります、ご一考のほどよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@hirotamasatane/works/331", "thumbnail_src": "https://si.imgix.net/c5a8755e/uploads/origins/0dfaa04f-6648-41b3-9604-fcd41e505e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943d0fbffe8a3d7deef6cff39c16f1ef", "thumbnail_srcset": "https://si.imgix.net/c5a8755e/uploads/origins/0dfaa04f-6648-41b3-9604-fcd41e505e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943d0fbffe8a3d7deef6cff39c16f1ef, https://si.imgix.net/c5a8755e/uploads/origins/0dfaa04f-6648-41b3-9604-fcd41e505e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c183ea8265206680a0586b792d24f5a 2x, https://si.imgix.net/c5a8755e/uploads/origins/0dfaa04f-6648-41b3-9604-fcd41e505e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=686f1b56879a8496f64bcf5832bc10c1 3x", "genre": "art", "nsfw": true, "body": "DEAD OR ALIVE Xtreme Venus Vacationの「ロベリア」を描いていただきたいです\n衣装は資料URLのリンク先の画像を参考にしてください(Xの私のポストに飛びます)\n\n衣装(一応水着という設定です)の都合でお尻が隠しきれず、服を伸ばして何とか尻を隠そうとするも全然隠せなく恥ずかしさで顔を紅潮させている様子のイラストをお願いします\n構図はお任せしますが、廣田眞胤様の描く臀部の丸みが好きなのでお尻が強調されたイラストにしていただきたいです\n\n以上です。ご検討宜しくお願い致します\n\nhttps://x.com/lQS3Vvb8QGpVwZn/status/1940752341227262284", "created_at": "", "completed_at": ""}]}