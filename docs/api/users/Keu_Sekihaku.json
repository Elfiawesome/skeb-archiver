21-d6b8-4990-aeaf-eb2261a24de8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e212f71909c82fe752ab230fd8b7bfea 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/13", "thumbnail_src": "https://si.imgix.net/28d74401/uploads/origins/b19f4a1b-8878-4af6-bfa6-844009f8b90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27db467b290375ad0491e55e50e98232", "thumbnail_srcset": "https://si.imgix.net/28d74401/uploads/origins/b19f4a1b-8878-4af6-bfa6-844009f8b90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27db467b290375ad0491e55e50e98232, https://si.imgix.net/28d74401/uploads/origins/b19f4a1b-8878-4af6-bfa6-844009f8b90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3ec9e13cc90c03106afbba13399c9f5 2x, https://si.imgix.net/28d74401/uploads/origins/b19f4a1b-8878-4af6-bfa6-844009f8b90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83afdf502dcb4975d5100516794c560d 3x", "genre": "art", "nsfw": true, "body": "pixivに投稿されているd-r様（https://www.pixiv.net/artworks/114853422）がすごく良かったので、それの続きのようなシチュを依頼させていただきます。\n\nはちゃめちゃに孕まされたので別な触手と性処理で戯れるが、こいつも孕ませる気満々で\nベロチューセックスしながら当然のように子宮に入り込んできた触手に排卵を促され、精液を何度も流し込まれてまた卵子が触手の精子に負けてしまう。\n\n希望する描写としては\n・子宮まで入り込んだ触手が子宮壁を擦りながら精液を流し込む（射精開始から子宮がいっぱいになるまでを描写してほしいです）\n・卵子がどんどん精子に負けて受精しまくっている描写\n・d-r様はベロチューで絶頂しながら精液を受け入れている\n・（コイツにも孕まされる）（精液で子宮が悦んどる…）等の心理描写\n\n内容に対して料金が不足している場合は金額を提示して再送していただけますと幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/12", "thumbnail_src": "https://si.imgix.net/20529754/uploads/origins/a1f08e64-8585-4518-bf80-d2d172b773c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea075b88e8e6752467eaae86e19a3385", "thumbnail_srcset": "https://si.imgix.net/20529754/uploads/origins/a1f08e64-8585-4518-bf80-d2d172b773c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea075b88e8e6752467eaae86e19a3385, https://si.imgix.net/20529754/uploads/origins/a1f08e64-8585-4518-bf80-d2d172b773c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de49cdc6a207663034b37667de024827 2x, https://si.imgix.net/20529754/uploads/origins/a1f08e64-8585-4518-bf80-d2d172b773c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a279f20f4e1b33a7a0592d775e44f705 3x", "genre": "art", "nsfw": true, "body": "◆キャラクター\nフレン・E・ルスタリオ(全裸)\nhttps://twitter.com/SHUTOCHIKACHIKA/status/1431605677839900675\n◆竿役\n異種:https://www.pixiv.net/artworks/87278901\n性器A&Bの設定:https://www.pixiv.net/artworks/76390152\n性器Aの色:https://www.pixiv.net/artworks/84552100\n性器Bの色https://www.pixiv.net/artworks/81977223\n異種の設定:\n異種は人間のように初めてオーガズムに達したときに単純に射精するわけではありません\n異種の亀頭(性器A)が子宮口に密着します。\n射精するとき、性器Aは最初の精液と小さな亀頭(性器B)を子宮に注入されます。\n性器Bは精管を介して子宮口の外側の亀頭とつながっており、少し休んだ後、再び腰を振り、第二のオーガズムの際に異種は性器Bを通して子宮内に直接射精します。\n◆シチュエーション・構図\n・視点:(https://skeb.jp/@Keu_Sekihaku/works/10)\n・体位:[密着した正常位]\n(異種(https://www.pixiv.net/artworks/87278901)の参考資料と同じ、乳首の分を露出させず。異種はフレンを強く抱きしめ、フレンの胸の谷間に優しくキスした)\n・場所:ベッド\n◆差分\n行為中・1回目の射精・2回目行為中・2回目射精・射精後5種\n・行為中\n・1回目の射精:異種が精液と小さな亀頭(性器B)を子宮に注入する\n・2回目行為中\n・2回目射精:性器Bからは少量の濃厚精液が射精されます\n・射精後: 異種の精子が人間の卵子と結合する絵を描いてください\n\n断面図:行為中・1回目の射精・2回目行為中・2回目射精・射精後5種\n・表情:https://twitter.com/hanpen_marumaru/status/1675497310036586496\n・断面図(行為中・1回目の射精・2回目行為中・2回目射精・射精後5種)もお願いしたい\n・断面図構図https://skeb.jp/@Keu_Sekihaku/works/10", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/11", "thumbnail_src": "https://si.imgix.net/82a7c790/uploads/origins/496010e9-ddff-4aa0-8007-99d788bc5946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79e9ea7a4c4ac0aea20de69750e84e59", "thumbnail_srcset": "https://si.imgix.net/82a7c790/uploads/origins/496010e9-ddff-4aa0-8007-99d788bc5946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79e9ea7a4c4ac0aea20de69750e84e59, https://si.imgix.net/82a7c790/uploads/origins/496010e9-ddff-4aa0-8007-99d788bc5946?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61274d0d84eba8ac38c519ca8698577c 2x, https://si.imgix.net/82a7c790/uploads/origins/496010e9-ddff-4aa0-8007-99d788bc5946?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=106f1e803bce02f6861028c2c49caadf 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nＦＧＯやアークナイツの、素敵な触手責め絵が流れてきたので、依頼させてください。\n\nアークナイツのキャラクター、アステシアの触手責めイラストをお願いします。\nhttps://arknights.wikiru.jp/index.php?%E3%82%A2%E3%82%B9%E3%83%86%E3%82%B7%E3%82%A2\n\n・状況\n　膝をついた姿勢で、背後から触手に絡み付かれ、地面に突き立てた剣を両手で握って、必死にすがり付いている。\n　本人はまだ負けていないと思って堪えようとしているが、既に子宮まで激しく責められており、反撃の余地はない……というような内容でお願いします。\n　服装は、基本の衣装が破かれているか、脱がされている感じでお願いします。\n　もし可能ならば、抵抗している最中の姿と、敗北絶頂した後の表情差分があるととても嬉しいです。\n\n注文が細かくて申し訳ありません。\nお手すきでしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/10", "thumbnail_src": "https://si.imgix.net/d54266db/uploads/origins/c5b10fe4-29f7-46c0-a7a6-b231dda8cf06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c686d2062c32501488a4f07833a9ac62", "thumbnail_srcset": "https://si.imgix.net/d54266db/uploads/origins/c5b10fe4-29f7-46c0-a7a6-b231dda8cf06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c686d2062c32501488a4f07833a9ac62, https://si.imgix.net/d54266db/uploads/origins/c5b10fe4-29f7-46c0-a7a6-b231dda8cf06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60d8f256e818ebb9a13ba18d76963d37 2x, https://si.imgix.net/d54266db/uploads/origins/c5b10fe4-29f7-46c0-a7a6-b231dda8cf06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81081abb103246b1f029378755e57698 3x", "genre": "art", "nsfw": true, "body": "はじめまして。リクエスト失礼致します。\n\nVTuberの銀海渡ニシェちゃんが膣内を蹂躙され、子宮内に直接精液、もしくは卵を注ぎ込まれて妊娠・苗床確定の状態で快楽を享受しているイラストをお願いしたいです。\n竿役(蟲・獣・触手等)は描きやすいものでお任せします。\n\n資料↓\nhttps://twitter.com/ukaisaki/status/1581592416532197377?s=46&t=aP5DO3iKLZPUiGkHSTkfHg", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/9", "thumbnail_src": "https://si.imgix.net/4bb8043c/uploads/origins/3b327f0c-269f-4320-a47f-4987b9155dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6efb08a79195454d344572e89484e281", "thumbnail_srcset": "https://si.imgix.net/4bb8043c/uploads/origins/3b327f0c-269f-4320-a47f-4987b9155dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6efb08a79195454d344572e89484e281, https://si.imgix.net/4bb8043c/uploads/origins/3b327f0c-269f-4320-a47f-4987b9155dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd29f16242f3c79c2756d1bb7c19e0bb 2x, https://si.imgix.net/4bb8043c/uploads/origins/3b327f0c-269f-4320-a47f-4987b9155dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3f23a8594bce9473711c10f5c0c2295 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\nモンスター2体に前後から立位で二穴責めされて気持ちよくなっているAmmyKkrちゃんのイラストをお願いいたします。\n\n＜AmmyKkrちゃんについて＞\n・正面にいるモンスターの首に両腕を回していてほしいです。\n・正気を失わずに性的快楽を享受しているような表情にしてほしいです。（例えば、目を描く場合には瞳のハイライトが消えていなかったり、あるいは正面のモンスターの顔を愛おしそうに見つめているなど）\n・脚は正常位のように股を開く形になっていると嬉しいです。\n・喘ぎ声の吹き出しがあると嬉しいです。\n・挿入の効果音があると嬉しいです。\n・快楽を感じているような表現があると嬉しいです。（「キュンキュン」「ゾクッ」など）\n\n＜モンスターについて＞\n・AmmyKkrちゃんより明らかに質量が大きいと分かるような体格にしてほしいです。（体格差がすきです）\n・明らかに人間でないと分かるような肌色にしてほしいです。（紫、ピンク、灰色、紺色、緑など）\n・人語は話さないでほしいです。\n\n\n以上です。 よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/8", "thumbnail_src": "https://si.imgix.net/82fe3c43/uploads/origins/e4fe513a-da6d-4e26-8aae-fd3cc71cbe8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af9bfa660b1a057f8ae286e44310676", "thumbnail_srcset": "https://si.imgix.net/82fe3c43/uploads/origins/e4fe513a-da6d-4e26-8aae-fd3cc71cbe8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af9bfa660b1a057f8ae286e44310676, https://si.imgix.net/82fe3c43/uploads/origins/e4fe513a-da6d-4e26-8aae-fd3cc71cbe8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=951bcf3147dcb1ddc8edb7969c6a0491 2x, https://si.imgix.net/82fe3c43/uploads/origins/e4fe513a-da6d-4e26-8aae-fd3cc71cbe8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34c749dc446f7e7460f5a62919dad554 3x", "genre": "art", "nsfw": true, "body": "はじめまして　イラストが好みでしたのでリクエストさせて頂いきます\nキャラクター　AZKi\n衣装　アーティスティック衣装\n衣装資料↓\nhttps://seesaawiki.jp/hololivetv/d/AZKi%a1%da%bb%b2%b9%cd%bb%f1%ce%c1%a1%db#AZKi-idol\n状況　\nホロオルタの世界で異形の触手に襲われ子宮に卵を産み付けられる\n構図はおまかせします", "created_at": "", "completed_at": ""}, {"path": "/@Keu_Sekihaku/works/7", "thumbnail_src": "https://si.imgix.net/0295e8cc/uploads/origins/cc59e6d8-f0a6-4709-b68f-b10b7b1e0d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5a332b6a0b6c7e6ff0e8146f55110c3", "thumbnail_srcset": "https://si.imgix.net/0295e8cc/uploads/origins/cc59e6d8-f0a6-4709-b68f-b10b7b1e0d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5a332b6a0b6c7e6ff0e8146f55110c3, https://si.imgix.net/0295e8cc/uploads/origins/cc59e6d8-f0a6-4709-b68f-b10b7b1e0d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f47c2f30b72942b6ccd1886bb31a59da 2x, https://si.imgix.net/0295e8cc/uploads/origins/cc59e6d8-f0a6-4709-b68f-b10b7b1e0d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c848f70e157b33ea0e3ad5c6a23360ba 3x", "genre": "art", "nsfw": false, "body": "", "created_a