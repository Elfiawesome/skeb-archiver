op=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=327d15ce13049b69691ebd3e0ebd05df 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suillustration/works/68", "thumbnail_src": "https://si.imgix.net/01347253/uploads/origins/5587ac9b-0d2d-4902-bc9b-85f60fd407b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5340396fdad50dc4b02c5031aba719", "thumbnail_srcset": "https://si.imgix.net/01347253/uploads/origins/5587ac9b-0d2d-4902-bc9b-85f60fd407b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5340396fdad50dc4b02c5031aba719, https://si.imgix.net/01347253/uploads/origins/5587ac9b-0d2d-4902-bc9b-85f60fd407b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f57fe4930acd82641c21243e453b00a7 2x, https://si.imgix.net/01347253/uploads/origins/5587ac9b-0d2d-4902-bc9b-85f60fd407b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c02b5522ff1592863a776cce277de391 3x", "genre": "art", "nsfw": true, "body": "何度も同じキャラをリクエストしてすみません…！\nもし可能であれば、聖剣伝説3からデュランをパラディンの姿でお願いします。\n暑くて耐えられない！あっちー！！みたいなイメージで、灼熱の砂漠の日差しの下で汗だくになりながら休息しているデュランをお願いしたいです。\nひと戦闘終えた後みたいな雰囲気があると嬉しいです。\n結構ガラの悪いキャラなので、ガサツさやワイルドなイメージがあると嬉しいです。\nまた、汗だくならではの色気というか男くささみたいなイメージがあると最高です。\n\n首周りのスヌードは暑さに耐えかねてひっぱったり外したり外そうとさせても大丈夫ですが、かっちり着込んだ装備や衣服ごしの筋肉が好きなので、それ以上は脱がせたり崩しすぎずにしてほしいです。\nスヌードの下の首周りは詳細な設定がないのですが、詰襟のようになっていると思っていただいて自由にアレンジして大丈夫です。\n\nパラディンの装備のブーツのふくらはぎやくるぶし、厚手のグローブが好きなので、なるべく手足が入るポージングや構図でお願いしたいです。\n特に今までsuさまに描いていただいた2枚のグローブの光沢の表現やグローブ越しの手の表現がとても素敵だったので、あのイメージでグローブやブーツのふくらはぎを表現してもらえるととても嬉しいです…！\n\nもし連続すぎるようでしたらまた次の機会に依頼します！\nもし良ければぜひお願いします。\n\n\n聖剣伝説二次創作ガイドライン\nhttps://www.pixiv.net/artworks/99335815#big_1\n\nデュラン（パラディン）\nhttps://www.pixiv.net/artworks/81587926#big_18\nhttps://min.togetter.com/18VhcrF\n\n参考:砂漠ステージ\nhttps://min.togetter.com/jGU9Dgm", "created_at": "", "completed_at": ""}, {"path": "/@suillustration/works/67", "thumbnail_src": "https://si.imgix.net/4ba867a7/uploads/origins/9e91c767-f92d-498d-ab05-affecb8018e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=545602affe8cf37be0bf93609aa37153", "thumbnail_srcset": "https://si.imgix.net/4ba867a7/uploads/origins/9e91c767-f92d-498d-ab05-affecb8018e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=545602affe8cf37be0bf93609aa37153, https://si.imgix.net/4ba867a7/uploads/origins/9e91c767-f92d-498d-ab05-affecb8018e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d517e77a770fbf077262ef29d38ef2c3 2x, https://si.imgix.net/4ba867a7/uploads/origins/9e91c767-f92d-498d-ab05-affecb8018e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a372d5c69488fb1b28a4525f465c6d1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suillustration/works/66", "thumbnail_src": "https://si.imgix.net/0604f49c/uploads/origins/0071a9c8-0294-4ac0-a55e-ae65d79d244d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec92cd349d289cf410548ea80e3a8e8", "thumbnail_srcset": "https://si.imgix.net/0604f49c/uploads/origins/0071a9c8-0294-4ac0-a55e-ae65d79d244d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec92cd349d289cf410548ea80e3a8e8, https://si.imgix.net/0604f49c/uploads/origins/0071a9c8-0294-4ac0-a55e-ae65d79d244d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da3447838387e4eee46b4f6c7ab52c10 2x, https://si.imgix.net/0604f49c/uploads/origins/0071a9c8-0294-4ac0-a55e-ae65d79d244d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13b1d9833a15c914c4225d8301d9ab53 3x", "genre": "art", "nsfw": false, "body": "先生、どうも、お邪魔してすみません。私はあなたの作品が大好きなので、僭越ながらご依頼してもよろしいでしょうか? \n私のOCを描いてください。彼女の名前はMORIです、傲慢で不吉な財閥令嬢で。\n好きな衣装を選んで描くことができます。\n感想をもとに自由に描いていただければ幸いです。作品は商業的に使用されません。\n注意事項：\n1: 背景のピンクのドラゴンを追加してほしい。\n2: ダブルポニーテールの上の三つ編みは左右対称。\n3:もしよろしければ、画像を2枚いただけますか?メガネをかけている写真とそうでない写真を一枚ずつ持っていたいものだ。\n\nありがとうございます\n\nhttps://drive.google.com/drive/folders/1Pijr7d1dSAyq-9tNx7omv9wL-Ffdipav?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@suillustration/works/65", "thumbnail_src": "https://si.imgix.net/590cb794/uploads/origins/25c4903b-8a48-41c6-b558-7e13c03106ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba91f876a3d0a1e35b4c45d230b1a8c5", "thumbnail_srcset": "https://si.imgix.net/590cb794/uploads/origins/25c4903b-8a48-41c6-b558-7e13c03106ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba91f876a3d0a1e35b4c45d230b1a8c5, https://si.imgix.net/590cb794/uploads/origins/25c4903b-8a48-41c6-b558-7e13c03106ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2354ad7cb4d1bb613a557637d9ad623 2x, https://si.imgix.net/590cb794/uploads/origins/25c4903b-8a48-41c6-b558-7e13c03106ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e704693835f0ec40e539d75943915a6 3x", "genre": "art", "nsfw": false, "body": "Hello~\nI'd like to submit a request!\n\nI'd like for you to draw my bunnygirl OC Lisette!\nI'd like to request a piece of my OC Lisette in her new outfit! She's a powerful bunny girl that practices dark magic, summoning spirits and lost souls to aid her in both navigation and battle!\nShe shows off herself, smugly and sensually, but is kind at heart. Often guiding the lost souls to rest after relying on them for assistance.\n\nLisette Main Reference: https://drive.google.com/drive/u/0/folders/1tSqN8JGFgPtBpira4yYUEVE4_Oyd19vX\nLisette Additional References: https://drive.google.com/drive/u/0/folders/1kjqsOb_QtjE5XUqp1ADbQLSEyceVbO5t\nIf possible, I'd like you to draw both versions of her outfit! If not possible, please choose whichever version you like most!\n\nI'd love if you could include her bunny spirits in some way as well!\nhttps://drive.google.com/drive/u/0/folders/1e8AxW8OyoPoPgNjGLdtmLQahw08cq00n\n\nI will leave the composition and pose up to you!\n\nThank you for the opportunity!", "created_at": "", "completed_at": ""}, {"path": "/@suillustration/works/64", "thumbnail_src": "https://si.imgix.net/2b838bf2/uploads/origins/752d7743-a1ff-4903-bf4b-7887d0fbb026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d6cd7458cad7a4804076eccdee9c9b5", "thumbnail_srcset": "https://si.imgix.net/2b838bf2/uploads/origins/752d7743-a1ff-4903-bf4b-7887d0fbb026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d6cd7458cad7a4804076eccdee9c9b5, https://si.imgix.net/2b838bf2/uploads/origins/752d7743-a1ff-4903-bf4b-7887d0fbb026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1a4fe11ad2ac5e1786af797bdc49814 2x, https://si.imgix.net/2b838bf2/uploads/origins/752d7743-a1ff-4903-bf4b-7887d0fbb026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70f29324902d8d3e4e9f1565aba18e7b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suillustration/works/63", "thumbnail_src": "https://si.imgix.net/e9f47a62/uploads/origins/d7067237-e649-48d6-b1b