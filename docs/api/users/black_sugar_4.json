961a-45f8-8999-0df56b9e6a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=319e40803935844de0d90e11f6f393ba", "thumbnail_srcset": "https://si.imgix.net/4dc2f925/uploads/origins/534fe8a4-961a-45f8-8999-0df56b9e6a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=319e40803935844de0d90e11f6f393ba, https://si.imgix.net/4dc2f925/uploads/origins/534fe8a4-961a-45f8-8999-0df56b9e6a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f91a7b973a7e0d508c477d55633407e 2x, https://si.imgix.net/4dc2f925/uploads/origins/534fe8a4-961a-45f8-8999-0df56b9e6a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cf630c726ffa231f3cf1176ffb2821d 3x", "genre": "art", "nsfw": true, "body": "このすばのアイリスが複数のイ級に拘束されて、自分が産んだであろうイ級からイラマチオされながら犯される内容でリクエストします。\nまたイ級が膣内に戻ろうとしている差分と大量射精差分、ボテ腹差分お願いします。\n衣装はネックレスなしで肩付近を残して裸、体形はつるぺたでお願いします。\n\nhttps://viewer-trial.bookwalker.jp/03/15/viewer.html?cid=53033d56-d1f1-4da7-a225-13218062fda1", "created_at": "", "completed_at": ""}, {"path": "/@black_sugar_4/works/11", "thumbnail_src": "https://si.imgix.net/90c7858e/uploads/origins/6a2830c9-79cb-46ea-b31d-c77977df57e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50d5bd90824fb23247490773a690dfc0", "thumbnail_srcset": "https://si.imgix.net/90c7858e/uploads/origins/6a2830c9-79cb-46ea-b31d-c77977df57e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50d5bd90824fb23247490773a690dfc0, https://si.imgix.net/90c7858e/uploads/origins/6a2830c9-79cb-46ea-b31d-c77977df57e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd6648bc6936dedb122eeb20eb3fa819 2x, https://si.imgix.net/90c7858e/uploads/origins/6a2830c9-79cb-46ea-b31d-c77977df57e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ba82e40dafbdc2e5d8f92f98093d723 3x", "genre": "art", "nsfw": true, "body": "※お手数ですが金額が不足でしたら再送願います\n艦これのスキャンプをお願いします\nスキャンプがあぐらをかくような姿勢で座って、その前に座った竿役を羽交い絞めし、竿役の耳を舐め、乳首をいじりながら足コキしている(背面座位を男女逆にしたような位置)のを斜め横から見る構図で、スキャンプの体が画面からはみ出ないように描いてください\n服装は公式制服で、頭の潜舵と帽子、長手袋をつけ裸足の状態\n体つきは先生のスキャンプ本と同じくらいで足指はギリシャ型　\n竿役もスキャンプ本のヘタレ整備兵で、全裸にひん剥かれて快感に悶えている感じの表情\n射精した瞬間の差分と、射精後(足と足指を広げて足裏が見え、竿と足の間にザーメンブリッジがかかっている)、射精後の精液なし版とそれぞれ黒タイツ、白タイツ(足裏の部分が薄黒く汚れている)を履いている差分もお願いします\nセリフは「足で扱かれてこんなに硬くするなんてお前相当なヘンタイだな、女の子みたいな声上げてそんなに気持ちいいのか?」「おいおいもう暴発かよ、情けないboyだな」「乳首弄られてこんなに撒き散らすとか、お前けっこうマゾの素質あんじゃん、あたいが仕込んでやろうか?たっぷり可愛がってやるから覚悟しな♡」みたいな感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@black_sugar_4/works/10", "thumbnail_src": "https://si.imgix.net/f44e37fc/uploads/origins/84511c1c-dca6-4888-b0fa-cbbf1050180e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f21cdf1deb78d68cfaf604e0359c3a83", "thumbnail_srcset": "https://si.imgix.net/f44e37fc/uploads/origins/84511c1c-dca6-4888-b0fa-cbbf1050180e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f21cdf1deb78d68cfaf604e0359c3a83, https://si.imgix.net/f44e37fc/uploads/origins/84511c1c-dca6-4888-b0fa-cbbf1050180e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e02251949ea49911d992de5d419ad13 2x, https://si.imgix.net/f44e37fc/uploads/origins/84511c1c-dca6-4888-b0fa-cbbf1050180e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dadae9690badf304005cd3e075ba655a 3x", "genre": "art", "nsfw": true, "body": "初めまして、黒糖ニッケ先生\n私は先生が描いた艦娘がとても好きです。艦隊これくしょんのZ1を主要キャラクターとして創作していただけると嬉しいです。\n\n【艦娘着妊】シリーズに似て、Z1は性処理任務を与えられ、人権を剥奪され、顧客がおもちゃのように使用される。\nZ1は、ゲーム内と同じスタイルの水着を着て、ビーチで性処理任務を遂行しています。\n両手は重い手錠で背中に拘束され、足首は鉄鎖と巨大な鉄球で繋がれ、逃げる可能性を完全に絶たれていた。\n首に首輪をつけ、Z1が現在実行中の任務を示しています。\n\nもし可能であれば、任務が始まる前と終わる後の差分を希望します。", "created_at": "", "completed_at": ""}, {"path": "/@black_sugar_4/works/9", "thumbnail_src": "https://si.imgix.net/397b9a49/uploads/origins/b3ed1153-6e05-47aa-b14c-f49769cff945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c1c3e914d50b3506b980bf59cd8a