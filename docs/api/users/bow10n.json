-b5e9-adb6c855f0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e49498441ae9101f7ef678bd58053603", "thumbnail_srcset": "https://si.imgix.net/8a6f9282/uploads/origins/215cbd2d-11a5-4627-b5e9-adb6c855f0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e49498441ae9101f7ef678bd58053603, https://si.imgix.net/8a6f9282/uploads/origins/215cbd2d-11a5-4627-b5e9-adb6c855f0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40c363c6eae96cc341b7540da9ae4912 2x, https://si.imgix.net/8a6f9282/uploads/origins/215cbd2d-11a5-4627-b5e9-adb6c855f0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f89d81a841603d1e18da7a9a827e2f4c 3x", "genre": "art", "nsfw": false, "body": "真ん丸さんこんばんは！はると申します。いつも真ん丸さんの尊くフェチに富んだ絵に癒されております🙏✨\n\n前作(https://skeb.jp/@bow10n/works/38)の続きを是非真ん丸さんに描いていただきたいです！\nリクエストの詳細内容は以下の通りとなります。\n\n[リクエスト内容 / 2枚 +希望1枚(別視点)]\n①コックさんの怪しい料理によりおなかがアドバルーン以上に膨らんでしまったレヴィくんとレッテンくん。この状況に戸惑いを覚えつつもおなかがぎゅっと合わさってお互いに照れ顔を見せていると、料理に遅効性の膨張薬が仕込まれていたせいか急激におなかが膨らんでいってしまい、お互いに驚きと興奮に満ちた表情を見せてしまう。\n②2匹の周りにいた黒丸くんやコックさんをも巻き込んでしまい、傍から見れば部屋全体が水色と黄色の2色に染め上げられているほどに2匹のおなかが部屋全体を満たすほどみっちみちに膨らんでしまう。\n※おなかが膨らむ際の擬音や効果線、その他要素(各登場人物の表情やおなかの揺れなど)は全て真ん丸さんにお任せいたします。\n※金額の範囲内で可能であれば、2匹のおなかが部屋いっぱいに膨らんだ時の別視点を描いていただけますと幸いです。\n[参考資料およびキャラシート]\nhttps://drive.google.com/drive/folders/1-5Yonl74SZl4q1WIJrew5UYU4PoPcy53\n\nまた、納品形式につきましてはPSDファイル形式希望いたします。\n拙い文章となってしまい申し訳ございませんが、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@bow10n/works/40", "thumbnail_src": "https://si.imgix.net/17ec1acc/uploads/origins/52bdb77d-101b-49fa-96a3-a52e3769d896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf55cac9fa62ce230b0731c91f7eefc2", "thumbnail_srcset": "https://si.imgix.net/17ec1acc/uploads/origins/52bdb77d-101b-49fa-96a3-a52e3769d896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf55cac9fa62ce230b0731c91f7eefc2, https://si.imgix.net/17ec1acc/uploads/origins/52bdb77d-101b-49fa-96a3-a52e3769d896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adfe4b669ba89417c527dd4a08e65264 2x, https://si.imgix.net/17ec1acc/uploads/origins/52bdb77d-101b-49fa-96a3-a52e3769d896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c65e914e39c76e19212aaca890adc3c 3x", "genre": "art", "nsfw": false, "body": "Hello! \n\nI am interested in seeing two characters made very round. \nThe blue character would be  much larger than the red, at least twice as round and being very satisfied but a bit embarrassed with how large they have become, as if they have just finished a large amount of sweets and candies with their stomach very tight and round. The second red character would also be rounder than in the reference, but not as large as the blue character, leaning back against the red characters stomach looking far more tired than satisfied with how big his belly had become but not upset. \n\nIt would be very fun to see it from a lower angle, almost looking up at the blue characters large stomach but his face would still be visible, as seeing their expressions would be very cute. \n\nNote: One of the references included features them wearing clothing but I would not like them wearing the clothes in this image, but the reference is the most up to date interpretations of the characters for color and proportions. \n\nThank you very much for your consideration!\n\nhttps://www.dropbox.com/scl/fo/ugskeuk5rv17ugzl9rogu/AP41KTfzexTkkxYHkv_sr6g?rlkey=b3kp6pu76pemhci0qg12pu57z&st=y1bb1k1y&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@bow10n/works/39", "thumbnail_src": "https://si.imgix.net/691416e4/uploads/origins/e4f12935-a69e-4967-ac35-998e533b9a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21b14b2966c170199304c82fde86df9", "thumbnail_srcset": "https://si.imgix.net/691416e4/uploads/origins/e4f12935-a69e-4967-ac35-998e533b9a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21b14b2966c170199304c82fde86df9, https://si.imgix.net/691416e4/uploads/origins/e4f12935-a69e-4967-ac35-998e533b9a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b68318d105e1a36b89d56a0bf7a2cb3 2x, https://si.imgix.net/691416e4/uploads/origins/e4f12935-a69e-4967-ac35-998e533b9a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8668cba13b88acb58cf825a3b98df55b 3x", "genre": "art", "nsfw": false, "body": "Hello! Nice to commission you again.\nI want would like my two characters,柴郡and 達西.\nThey're a cute couples. 柴郡likes to inflating 達西, and 達西 will be mad and inflating him too.\nI'd like to see them inflating eachother like a balloon and both feel happily in the end.\n\nhttps://drive.google.com/drive/folders/1HPanx7SW5gewFKIOMx3Sw0R7LERGVDWB", "created_at": "", "completed_at": ""}, {"path": "/@bow10n/works/38", "thumbnail_src": "https://si.imgix.net/2e498c49/uploads/origins/2419d610-72cb-4b6f-a134-bc9ff02f308c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b5401f9f4c35574ed7aa89213cb67a4", "thumbnail_srcset": "https://si.imgix.net/2e498c49/uploads/origins/2419d610-72cb-4b6f-a134-bc9ff02f308c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b5401f9f4c35574ed7aa89213cb67a4, https://si.imgix.net/2e498c49/uploads/origins/2419d610-72cb-4b6f-a134-bc9ff02f308c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=379ff2883d148a7e7d28e46d866bc0d1 2x, https://si.imgix.net/2e498c49/uploads/origins/2419d610-72cb-4b6f-a134-bc9ff02f308c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4a2999917985e29dfb654cc91e562bf 3x", "genre": "comic", "nsfw": false, "body": "真ん丸さんこんばんは！はると申します。いつも真ん丸さんの尊くフェチに富んだ絵に癒されております🙏✨\n\nうちの子レヴィくんとライムさんの子レッテンくんの膨張絵をぜひ真ん丸さんの絵柄で見てみたいです！\nリクエストの詳細内容は以下の通りとなります。\n\n[リクエスト内容 / 希望2枚]\n①笑顔を浮かべたコックさんから提供されたお菓子を美味しそうに食べるレヴィくんとレッテンくん。食べ終わって満足気におなかをさすっていると、突然おなかが風船のように膨らみ始めてしまう。\n②突然体に訪れた感覚に戸惑いを覚えながら興奮を隠すことが出来ず、そのままおなかが膨らんでいき...アドバルーン並に膨らんだおなかがぎゅむっと合わさり、突如訪れた感覚に魅了されてしまい可愛い表情を見せてしまう。奥には不安げに2人を見つめる黒丸くんといたずらげに笑みを浮かべるコックさんの姿がぼんやりと見えている。\n※おなかが膨らむ際の擬音や効果線、その他表情などはすべて真ん丸さんにお任せいたします。\n※もし可能であれば、擬音あり/なしverを作成していただけますと幸いです。\n[参考資料およびキャラシート]\nhttps://drive.google.com/drive/folders/1-5Yonl74SZl4q1WIJrew5UYU4PoPcy53\n\n拙い文章となってしまい申し訳ございませんが、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@bow10n/works/37", "thumbnail_src": "https://si.imgix.net/0741cd26/uploads/origins/ef4d0afd-5b40-45a1-bc6b-43be4b78b085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d63d63166e6478e5dda63d11a7eb66b", "thumbnail_srcset": "https://si.imgix.net/0741cd26/uploads/origins/ef4d0afd-5b40-45a1-bc6b-43be4b78b085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d63d63166e6478e5dda63d11a7eb66b, https://si.imgix.net/0741cd26/uploads/origins/ef4d0afd-5b40-45a1-bc6b-43be4b78b085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4994a812c372c0189bbe35b9911c6f4 2x, https://si.imgix.net/0741cd26/uploads/origins/ef4d0afd-5b40-45a1-bc6b-43be4b78b085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d22dc6ae3cac44c5ad4377953dc692e 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bow10n/works/36", "thumbnail_src": "https://si.imgix.net/73b06a40/uploads/origins/7b03ebef-1ef7-436f-91a1-c17ab43bb307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&