23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d6ddece63580e294adbb6440c828ea9", "thumbnail_srcset": "https://si.imgix.net/17286e8e/uploads/origins/6f897dca-5173-4c9a-abe7-6d5389b8de45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d6ddece63580e294adbb6440c828ea9, https://si.imgix.net/17286e8e/uploads/origins/6f897dca-5173-4c9a-abe7-6d5389b8de45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43caeb8460d9eaeceef8cffdb62a54e7 2x, https://si.imgix.net/17286e8e/uploads/origins/6f897dca-5173-4c9a-abe7-6d5389b8de45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=985fa07de06b4fdb8bb5a07295115b96 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mutyahunter/works/50", "thumbnail_src": "https://si.imgix.net/697f65c5/uploads/origins/adfc1dfe-be9e-47b3-812d-53a4e3c34ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c24f2334f59325a0f7b9e2bb734412fd", "thumbnail_srcset": "https://si.imgix.net/697f65c5/uploads/origins/adfc1dfe-be9e-47b3-812d-53a4e3c34ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c24f2334f59325a0f7b9e2bb734412fd, https://si.imgix.net/697f65c5/uploads/origins/adfc1dfe-be9e-47b3-812d-53a4e3c34ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=689c637b082a6ee12b5b91ccee2649d9 2x, https://si.imgix.net/697f65c5/uploads/origins/adfc1dfe-be9e-47b3-812d-53a4e3c34ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=200cc150ca52aeeb071b427e0c2e5c95 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mutyahunter/works/49", "thumbnail_src": "https://si.imgix.net/43f3fae1/uploads/origins/227891de-fb9a-44f1-9d64-dee2fd8429e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3952a700bafaa84397509ad45ea8aa91", "thumbnail_srcset": "https://si.imgix.net/43f3fae1/uploads/origins/227891de-fb9a-44f1-9d64-dee2fd8429e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3952a700bafaa84397509ad45ea8aa91, https://si.imgix.net/43f3fae1/uploads/origins/227891de-fb9a-44f1-9d64-dee2fd8429e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81d723c75aad53c5ce7293269497c982 2x, https://si.imgix.net/43f3fae1/uploads/origins/227891de-fb9a-44f1-9d64-dee2fd8429e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4527b488899142349e32d5dbee53efee 3x", "genre": "art", "nsfw": true, "body": "初めまして、フィロリーザと申します。\n無茶坊先生の描かれるイラストをいつも楽しみに拝見させていただいております。背面から魅せるお尻のラインと、お尻の穴の描写が大好きです！！！\n私がVRSNS（VRChat）で使用しているアバターの、アナルゼリー排泄イラストを描いてだきたく存じます。\n\n◆キャラクターの設定\n・種族：クラゲドラゴン娘\n・特徴：クラゲの特徴とドラゴンの特徴を持っています。血の色がきれいな青色で、口の中や舌が青色です。（お尻の穴は人間の色で構いません。）\n・排泄物の代わりに水色のアナルゼリーが出る体質。\n\n◆シチュ\n・白いシーツの上で四つん這いになり、限界まで溜めたアナルゼリーを排泄して、ゼリーで魚拓を取る『アナルゼリー拓』…というシチュエーションです。\n\n◆構図・ポーズ\n・先生の描かれたイラストのようにこちらに振り向きながら四つん這いのポーズでお願いします。（参考：https://skeb.jp/@mutyahunter/works/19）\n・イラストサイズは全身＋後述するアナルゼリーの全長を含めたサイズ。\n\n◆排泄描写（差分）\n①排泄前。ぎりぎりの状態で堪えている。\n②お尻の穴から先っちょが顔を出している。そろそろ限界。\n③アナルゼリーを勢いよく排泄。放物線を描きながら、ブッ太くて長い一本ものアナルゼリーを、ブリブリとシーツにぶちまける。肛門がアナルゼリーに引っ張られており、排泄の快感に潮を吹きながら絶頂。\n④勢いが落ちたが自分の意思とは関係なく止まらないアナルゼリー。出し切れるまでなすがままのような姿。\n⑤ようやく出し切り、息を切らしている。お尻の穴がぽっかり。\n⑥キャラクター無。出し切ったアナルゼリーの状態と、シーツに残った潮の跡がこちら…\n（可能であれば、生産者表示としてダブルピースをしているキャラクターのチェキを添えてほしいです）\n\n細かい注文となってしまい大変申し訳ありませんが、楽しく自由に描いていただければ幸いです。\n\n手足の✖模様、触手等は複雑なので、もし難しそうであれば資料と同じでなくても大丈夫です。先生のアレンジで描いて頂いても構いません。また、尻尾や触手が邪魔になるようであれば描かなくても構いません。\nお手数ですが、ご検討のほどよろしくお願いいたします。\n※参考画像、及び資料につきましては、下記URLよりご確認をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fW8FInDr26vt7SGLOJLl6sRt-DfdcWWG", "created_at": "", "completed_at": ""}, {"path": "/@mutyahunter/works/48", "thumbnail_src": "https://si.imgix.net/5be5017e/uploads/origins/c3df248c-e50a-4978-a21a-5ac4b71038cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0df90e63de335bbc98f655dd234700da", "thumbnail_srcset": "https://si.imgix.net/5be5017e/uploads/origins/c3df248c-e50a-4978-a21a-5ac4b71038cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0df90e63de335bbc98f655dd234700da, https://si.imgix.net/5be5017e/uploads/origins/c3df248c-e50a-4978-a21a-5ac4b71038cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4d7f81b84a4ca1ddd50d1b78d24443e 2x, https://si.imgix.net/5be5017e/uploads/origins/c3df248c-e50a-4978-a21a-5ac4b71038cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc23460a3d791f1571995c33995ca48c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mutyahunter/works/47", "thumbnail_src": "https://si.imgix.net/d6dce557/uploads/origins/921a5b0c-40e6-4886-a597-1fc1c622775b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7267b7cb0c57e89b42b2508b0dbe2c2b", "thumbnail_srcset": "https://si.imgix.net/d6dce557/uploads/origins/921a5b0c-40e6-4886-a597-1fc1c622775b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7267b7cb0c57e89b42b2508b0dbe2c2b, https://si.imgix.net/d6dce557/uploads/origins/921a5b0c-40e6-4886-a597-1fc1c622775b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b14da3d92aa76c996f07246841274013 2x, https://si.imgix.net/d6dce557/uploads/origins/921a5b0c-40e6-4886-a597-1fc1c622775b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87a2d22d53c42c52b2e8eee392279897 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n前回依頼したばかりで申し訳ありませんが、絵柄がとても好きすぎるので再度依頼させて下さい。\n前回と同じくアリス・ギア・アイギスの紺堂地衛理をお願いします。\n\n格好\n首には赤い首輪。\nハイレグボンデージ(資料参照)\nエナメル素材のような光沢ありでお願いします。\nハイレグとロングストッキングの接続部分は無しでお願いします(赤で囲った箇所)。\n綺麗なハイレグが見たいので。\n\n姿勢\n天井から鎖で吊らされてる手枷に両手を拘束されて上げさせられている(脇が見えるように)状態で低めのテーブル(台)の上でエロ蹲踞。\n見世物にされてる感じで。\n\n状態\n口から精液を垂らしながら舌を出している。\n両乳首にピンクローター(リモコンは二の腕辺りにテープで巻かれている。配線処理は任せます)。\nオマンコとアナルに大きめの電動バイブが挿入され、ハイレグで外れないように固定されている(何度か両穴犯された後に栓をするように挿入され、精液が少し溢れ出ていて糸を引いて垂れている)。\n顔と体にぶっかけあり。\n中出しした回数や「肉便器」「ぶっかけOK」「調教済み」等の落書きをペンで書かれている(中出し回数は任せます)。\n\n表情\nアへ顔。\n\n背景\n薄暗いSM調教部屋みたいな感じ。\n\nその他\n手前に精液が糸を引いて垂れているバキバキのイチモツを握った順番待ちor中出しした後の男達(2人ぐらい)が左右にいると、これからも数時間休まず犯され続ける雰囲気が出てめちゃエロです。\n使用済みコンドームがあちこちに乱雑に落ちてると良いです。\n可能なら口にボールギャグを着けて唾液を垂らしてる状態もお願いします(無理なら大丈夫です！)。\n\n最初は抵抗していたのに数日調教されて立派なメス豚肉便器に墜ちたってイメージです。\n\n要望が多いですがどうかよろしくお願いします。\n\nhttps://photos.app.goo.gl/XLU7iEyiV5Y113Ku6", "created_at": "", "completed_at": ""}, {"path": "/@mutyahunter/works/46", "thumbnail_src": "https://si.imgix.net/5d1382dc/uploads/origins/2c22e989-4684-4fd6-b9fa-eb2b9d0b4d30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd41adeb8fb3e228fd9ba4cda510949", "thumbnail_srcset": "https://si.imgix.net/5d1382dc/uploads/origins/2c22e989-4684-4fd6-b9fa-eb2b9d0b4d30?bg=%23fff&auto=format%2Ccompress&fm=webp&fi