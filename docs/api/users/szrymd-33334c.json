ix.net/f06fab4e/uploads/origins/ab60e94e-ebbe-4435-bb6c-8bb56ddbe6f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5378b4999466e84bb5da0bc079dc4d6 2x, https://si.imgix.net/f06fab4e/uploads/origins/ab60e94e-ebbe-4435-bb6c-8bb56ddbe6f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=294475cb66ffc1b1cc31cb9f5316c0ff 3x", "genre": "art", "nsfw": false, "body": "IA-ARIA ON THE PLANETES-（CeVIO）とONE -ARIA ON THE PLANETES-（CeVIO）と垂さんがカフェで寛いでいる様子をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/12", "thumbnail_src": "https://si.imgix.net/093af346/uploads/origins/3133e3cd-20dc-4813-9c12-b1467953d7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b56186963764bc9cecdb5b87dbd1f54", "thumbnail_srcset": "https://si.imgix.net/093af346/uploads/origins/3133e3cd-20dc-4813-9c12-b1467953d7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b56186963764bc9cecdb5b87dbd1f54, https://si.imgix.net/093af346/uploads/origins/3133e3cd-20dc-4813-9c12-b1467953d7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f55a09b86e48e5f54c827739f0b8bcab 2x, https://si.imgix.net/093af346/uploads/origins/3133e3cd-20dc-4813-9c12-b1467953d7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdb4976b06b732f274234d4b3656a232 3x", "genre": "art", "nsfw": false, "body": "山田垂様、はじめまして。\nskeb募集のツイートをRTより拝見し、依頼させて頂きます。\n\nVtuberの「御電話ちくわぶ」さんを描いて頂くことは可能でしょうか。\n・ご本人よりskeb依頼の許可は頂いております。\n・配信サムネイルなどで使っていただきたいと思いますので、使用のご許可も頂けますと幸いです。\n・資料URL1枚目の4.1の姿でお願いいたします。\n\nイメージは下記のとおりです\n・少々ミステリアス&色気のある雰囲気\n・お顔の布が風に煽られて少しめくれており、にやりと不敵に笑う口元だけが見えている\n・画面に向けて「内緒だよ？」と言うかのように、口元に立てた人差し指を添えている\n・人物部分のみの背景透過データ差分も頂けますと助かります\n・私への宛名は不要です\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/keim0122/status/1388185703926829057?s=19", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/11", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1939795277147168768%2FR54Hy5UE.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b05f50cad32f0717c19f654f1fa142d7", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1939795277147168768%2FR54Hy5UE.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b05f50cad32f0717c19f654f1fa142d7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1939795277147168768%2FR54Hy5UE.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0ebb8748862033b1ee8622416a5fb40 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1939795277147168768%2FR54Hy5UE.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a52bb381845890b23d9d1e5e4f6de8e 3x", "genre": "voice", "nsfw": false, "body": "数を数えていただきたいです。\n1〜10までの数を「1、2、3…」のようなカウントアップでお願いします。「いち、に、さん」のような間延びしない、はっきりとした読み方だと大変助かります。\nもし余裕がありましたら「10、9、8…」のようなカウントダウンもしていただけるとさらに助かります。\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/10", "thumbnail_src": "https://si.imgix.net/3bf03c8a/uploads/origins/1ca6905d-f63e-4650-92f5-a260a0cda5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3575f2c137ec7ac3cef2896dace9e646", "thumbnail_srcset": "https://si.imgix.net/3bf03c8a/uploads/origins/1ca6905d-f63e-4650-92f5-a260a0cda5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3575f2c137ec7ac3cef2896dace9e646, https://si.imgix.net/3bf03c8a/uploads/origins/1ca6905d-f63e-4650-92f5-a260a0cda5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be414c981754821976d0a2f698286f47 2x, https://si.imgix.net/3bf03c8a/uploads/origins/1ca6905d-f63e-4650-92f5-a260a0cda5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=417799d7ceb6182e8c291fb421be7e33 3x", "genre": "art", "nsfw": false, "body": "山田垂さん\nSkebでは初めましてですね\n何度かイラストを拝見していて\n依頼するタイミングを考えており\n今回依頼させていただきました\n\n全力で圧をかけている魔王の威厳がある感じの私を描いてもらえないでしょうか\n衣装についてはTwitterの固定の新衣装を参考にしてもらえればと思います\n構図やポーズはお好きに描いていただいて大丈夫です。\n活動にてゲーム配信や魔王の威厳を感じさせる配信の時に\nサムネに使用させてもらえると幸いです\nよろしくお願いいたします\n\n【参考URL】\nhttps://twitter.com/kouen_nero\n\nhttps://twitter.com/kouen_nero", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/9", "thumbnail_src": "https://si.imgix.net/a9049485/uploads/origins/816b2514-34b1-4ad7-9ecc-d8348e54ed02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=400a904c77ff85f3b027e5b1be9ba06c", "thumbnail_srcset": "https://si.imgix.net/a9049485/uploads/origins/816b2514-34b1-4ad7-9ecc-d8348e54ed02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=400a904c77ff85f3b027e5b1be9ba06c, https://si.imgix.net/a9049485/uploads/origins/816b2514-34b1-4ad7-9ecc-d8348e54ed02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4908c5033d2c71f1b92f52bda8ac2417 2x, https://si.imgix.net/a9049485/uploads/origins/816b2514-34b1-4ad7-9ecc-d8348e54ed02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d22b1609e4f92c518552747a8394804 3x", "genre": "art", "nsfw": false, "body": "Vtuberのユウくんです。どうぞ一枚お願いします。\n\nTwitterやYouTubeなどで使うかもしれません。\n\nhttps://twitter.com/yukun_vtuber/status/1331615062214098944", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/8", "thumbnail_src": "https://si.imgix.net/d086165f/uploads/origins/1b201045-6c79-4021-8adc-cb416d68b993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0a0d1c6394aa805aa43f55f4870d8a4", "thumbnail_srcset": "https://si.imgix.net/d086165f/uploads/origins/1b201045-6c79-4021-8adc-cb416d68b993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0a0d1c6394aa805aa43f55f4870d8a4, https://si.imgix.net/d086165f/uploads/origins/1b201045-6c79-4021-8adc-cb416d68b993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b8dd28c31938e9246b0c2cc21cb2737 2x, https://si.imgix.net/d086165f/uploads/origins/1b201045-6c79-4021-8adc-cb416d68b993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=111e8574b3720bed560d60b43fa71c5e 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n5/23にお誕生日を迎えられるにじさんじの森中花咲さん（オトナverショートボブ）をお描き頂きたくリクエストさせて頂きました。\n服装と構図等に関しての指定は特にございません。\n\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/7", "thumbnail_src": "https://si.imgix.net/057e931e/uploads/origins/ba048366-5088-4bab-a8ac-96819dd219de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ece58cbb12b76150fc312591fcf12124", "thumbnail_srcset": "https://si.imgix.net/057e931e/uploads/origins/ba048366-5088-4bab-a8ac-96819dd219de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ece58cbb12b76150fc312591fcf12124, https://si.imgix.net/057e931e/uploads/origins/ba048366-5088-4bab-a8ac-96819dd219de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e77024f002f6cc9a4573329ed18a8ee 2x, https://si.imgix.net/057e931e/uploads/origins/ba048366-5088-4bab-a8ac-96819dd219de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4127e07a5f5e32e701cb5b7ebb09fa82 3x", "genre": "art", "nsfw": false, "body": "山田垂様。\n今回はサムネ等に使うイラストを描いて頂きたく、山田様にskebリクエストを投げさせて頂きます。\n\n参考イラストのような雰囲気で、新しいモデルの僕を書いてほしいです。\nポーズはカッコいい（と思ってるような）感じで、表情は悪い顔でお願いします。\n\nサムネに使わせて頂きたいと考えているので、モデルが見切れないような構図でお願いします。\n\n【参考イラスト】\nhttps://www.pixiv.net/artworks/87871049\n\nhttps://drive.google.com/file/d/1Nc3SAbLfxNKFlrxFkyOGwremDXES3IgQ/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/6", "thumbnail_src": "https://si.imgix.net/f1aac562/requests/219350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6a4f5e804e0772b2286b179c2f511a1", "thumbnail_srcset": "https://si.imgix.net/f1aac562/requests/219350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6a4f5e804e0772b2286b179c2f511a1, https://si.imgix.net/f1aac562/requests/219350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94695ab3f1a36853a9262f839ae5ed98 2x, https://si.imgix.net/f1aac562/requests/219350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8db897ce11b2345444995c8987f09b67 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n垂さんにイラストを依頼したいと思いコメント致しました。\n座って寛ぎながらテレビを見ているイメージで私を描いていただけないでしょうか？\nまた、活動で映画の同時視聴をやろうと思ってまして、そのサムネに使用させて頂いてもよいでしょうか？\nどうぞよろしくお願い致します。\n(こちらの不手際で再度依頼を出させて頂いてます。こちらを正として見てくださると幸いです)\n\nhttps://twitter.com/vmintovv/status/1344953024360321025?s=21", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/5", "thumbnail_src": "https://si.imgix.net/7ef38592/requests/223006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbd5ef1e9c2a3327130c4eb9f8c1fd1e", "thumbnail_srcset": "https://si.imgix.net/7ef38592/requests/223006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbd5ef1e9c2a3327130c4eb9f8c1fd1e, https://si.imgix.net/7ef38592/requests/223006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeae6890138b06a9a59048dada1bc99c 2x, https://si.imgix.net/7ef38592/requests/223006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e992f69521c8eab50591278f0ffe2fd 3x", "genre": "art", "nsfw": false, "body": "BLAZBLUEのハザマをお願いします！\n胡散臭い笑みを浮かべているとありがたいです。\nその他構図等はおまかせします。\n\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/4", "thumbnail_src": "https://si.imgix.net/274663a3/requests/194371_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8cdf8cf95b589462b53b9ae9acebf04", "thumbnail_srcset": "https://si.imgix.net/274663a3/requests/194371_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8cdf8cf95b589462b53b9ae9acebf04, https://si.imgix.net/274663a3/requests/194371_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ed457890292d93d385eac2616bf2ae3 2x, https://si.imgix.net/274663a3/requests/194371_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d93e7b6b714437242d732a4645df968 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nFate/Grand Orderのアナスタシア・ニコラエヴナ・ロマノヴァをお書きいただきたいと思っております。\n構図等の指定は特にございませんのでご自由にお描きいただいて問題ありません。\n\n以上、山田様の活動を今後とも応援しています。", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/3", "thumbnail_src": "https://si.imgix.net/7398a32d/requests/184672_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccfbca22f2a45865c4ca9977951682eb", "thumbnail_srcset": "https://si.imgix.net/7398a32d/requests/184672_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccfbca22f2a45865c4ca9977951682eb, https://si.imgix.net/7398a32d/requests/184672_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d51c6e10bc92919a5e52d392f2e2091 2x, https://si.imgix.net/7398a32d/requests/184672_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ff1e9babd2eab7de486db9a1441c4a3 3x", "genre": "art", "nsfw": false, "body": "ニコ・・・ で描いていただけると……\n\nサムネやTwitterに使うかもしれません……サイズの変更や配置の関係上イラストの上に文字が被るような感じで使うかもしれません……みたいな\n\nhttps://twitter.com/yukun_vtuber", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/2", "thumbnail_src": "https://si.imgix.net/6bfbb708/requests/161351_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b32861193750edc51cba855f1df5f0a", "thumbnail_srcset": "https://si.imgix.net/6bfbb708/requests/161351_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b32861193750edc51cba855f1df5f0a, https://si.imgix.net/6bfbb708/requests/161351_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5da391f64b7678d7923f4d37710ba805 2x, https://si.imgix.net/6bfbb708/requests/161351_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a38863aebfda29f80c17ad5906b6aa40 3x", "genre": "art", "nsfw": false, "body": "垂さんこんにちは！個人勢Vtuberの純白ましろです。\n垂さんのイラストの雰囲気がとても好きなので、募集されていると知りぜひ依頼させて頂きたいです...！\n今回はヤンデレ風な私のイラストをお願いしたいです。宜しければシチュボ動画等のサムネに利用する許可も頂けますと幸いです...！\n\nhttps://mobile.twitter.com/sumisiroma46", "created_at": "", "completed_at": ""}, {"path": "/@szrymd/works/1", "thumbnail_src": "https://si.imgix.net/00a22202/requests/157734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=481c9ab9fa962b3afb53f450519b2d95", "thumbnail_srcset": "https://si.imgix.net/00a22202/requests/157734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=481c9ab9fa962b3afb53f450519b2d95, https://si.imgix.net/00a22202/requests/157734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=488b732b4f07fee89a077440559a3227 2x, https://si.imgix.net/00a22202/requests/157734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6c38c8d1adb80279b3f746aee72e624 3x", "genre": "art", "nsfw": false, "body": "酒野ハルハルをせっかくなので白黒（モノクロ？）でかいていただきたいです！\n目にくまを付けてヘラってるけど笑ってる感じが出てると嬉しいです！\nポーズや背景はおまかせします。\n許可いただけるのであれば動画・配信等で使用させていただきたいです。\nよろしくお願いします！\n\nhttps://twitter.com/haruharu_ch_V/status/1277950913143922689?s=20", "created_at": "", "completed_at": ""}]}