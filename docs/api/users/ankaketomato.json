4d4d-9967-df049d7bda6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa6c141abd66efafd57ee6c702027180 2x, https://si.imgix.net/0a0693e6/uploads/origins/fee6f766-2c62-4d4d-9967-df049d7bda6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=833118dffc23d6b11b227ffd8b37a828 3x", "genre": "art", "nsfw": false, "body": "こんにちは！二人の友人のイラストを描いてほしい。\n\nマインクラフトのイラストになります！二人ともマインクラフトが好きです。\n過去に描いたこの絵がいい例です！https://skeb.jp/@ankaketomato/works/33\n\nピンクの髪の女の子は、「パンプキンカー」というおもちゃを持って、茶髪の女の子にプレゼントしているところを描いてください。誇らしげな表情で！\n\n茶髪の女の子は、パンプキンパイを焼くために調理器具を持ちながら、額の汗をこすってほしい。彼女の表情は恥ずかしがりながらも嬉しそうであるべきだ。\n\n背景とキャラクターはPSD形式で分けてください。\n私の要望を描くことを検討していただけると幸いです！ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1lkPBHmQGgLuaVZinJuBsJb5whkr0n7rx?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ankaketomato/works/54", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/1bc01dd7/uploads/origins/0ea44ba0-9257-4ba5-8378-5215f83e931c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=715f04cffcbc77e11280c6483e362955", "thumbnail_srcset": "https://si.imgix.net/1bc01dd7/uploads/origins/0ea44ba0-9257-4ba5-8378-5215f83e931c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=715f04cffcbc77e11280c6483e362955, https://si.imgix.net/1bc01dd7/uploads/origins/0ea44ba0-9257-4ba5-8378-5215f83e931c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89dcb6bb99950cb7828c6350f3875299 2x, https://si.imgix.net/1bc01dd7/uploads/origins/0ea44ba0-9257-4ba5-8378-5215f83e931c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76152e155de4555de22103e308cfb36b 3x", "genre": "art", "nsfw": false, "body": "また相談にのってください！\n\n今回も\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍する鬼族のキャラです。\nゴーグルの目の部分から出ているのは角です（ガラスは無くて良いです）。\n衣装はそのまま系でも別衣装でも良いですし\nゴーグル自体が無くても良いです。\n\n使用したい範囲は\n自前の紹介サイトや、\nＸでの掲載となります。（Grok利用はOFFしてます）\nトリミング使用もしたいと考えているので\n合わせて問題ないか御確認ください！\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://twitter.com/oniyatsuhashi/status/1727335250622357703", "created_at": "", "completed_at": ""}, {"path": "/@ankaketomato/works/53", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/c6a803c0/uploads/origins/d1e7151b-f586-4592-ba41-514da447dc65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c53e94aed4f5dc6ed66f1d672b28d679", "thumbnail_srcset": "https://si.imgix.net/c6a803c0/uploads/origins/d1e7151b-f586-4592-ba41-514da447dc65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c53e94aed4f5dc6ed66f1d672b28d679, https://si.imgix.net/c6a803c0/uploads/origins/d1e7151b-f586-4592-ba41-514da447dc65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e14b43dcdb5d51ad419beff6b71194ff 2x, https://si.imgix.net/c6a803c0/uploads/origins/d1e7151b-f586-4592-ba41-514da447dc65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4b80f7fcfa53804ed6bf3b150b5fcbc 3x", "genre": "art", "nsfw": false, "body": "明けましておめでとうございます、昨年度は本当にお世話になりました。今年もどうぞよろしくお願いいたします。\n\n今回のリクエストなのですが、前に描いて頂いたあの白髪青目の女の子について、その成長した姿のイラストをお願いしたいです。具体的には次の様な感じです。\n\n・年齢は20代半ばくらい（20-24歳くらいまで）\n・キーになるブレザー風のジャケットとシャツ、紐ネクタイはそのままでお願いします\n・髪型も前のイラストと同じ形だと嬉しいです\n・下はスラックス\n\n全体として、昔の雰囲気を濃く残しながらも大人っぽさを加えて、学校に一人はいるミステリアスな先生みたいな形にして欲しいなと思います。難しいリクエストになるかもしれませんが、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ankaketomato/works/52", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/1fcc8800/uploads/origins/b66c00a8-a371-404b-a7f3-887e6070b4ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7cef3839fb5fdffed6d482a907ce40", "thumbnail_srcset": "https://si.imgix.net/1fcc8800/uploads/origins/b66c00a8-a371-404b-a7f3-887e6070b4ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7cef3839fb5fdff