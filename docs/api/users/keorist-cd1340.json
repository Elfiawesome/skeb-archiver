6-4999-a342-d50a8ca34acf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88de8171888c7689feae1a66dd48f02, https://si.imgix.net/35cfa90f/uploads/origins/382ac298-a436-4999-a342-d50a8ca34acf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=370ad5afc71d8b725c73a281fcf71f1e 2x, https://si.imgix.net/35cfa90f/uploads/origins/382ac298-a436-4999-a342-d50a8ca34acf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a66fe959ea96d6cff4d9840cfbdafbfd 3x", "genre": "art", "nsfw": true, "body": "背面側位で先生と中出しえっちするブルアカの鬼方カヨコをお願いします！\n全裸で大丈夫です！", "created_at": "", "completed_at": ""}, {"path": "/@keorist/works/58", "thumbnail_src": "https://si.imgix.net/78c0d1aa/uploads/origins/ba87fb9e-ad5d-4cb8-837c-1afb4320bde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1515dc84321ca3ece992b80c34bf8d99", "thumbnail_srcset": "https://si.imgix.net/78c0d1aa/uploads/origins/ba87fb9e-ad5d-4cb8-837c-1afb4320bde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1515dc84321ca3ece992b80c34bf8d99, https://si.imgix.net/78c0d1aa/uploads/origins/ba87fb9e-ad5d-4cb8-837c-1afb4320bde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9fc999795fee1fe906a2812beefe0e 2x, https://si.imgix.net/78c0d1aa/uploads/origins/ba87fb9e-ad5d-4cb8-837c-1afb4320bde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2f62605e439e17c45ac21a658c1d9a1 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リク再開とのことで\n今回お願いしたいのは\nアズレンのシリアスが包茎ちんちんの\n皮の中に舌入れフェラしているイラストで\n丁寧に奉仕しているというものです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@keorist/works/57", "thumbnail_src": "https://si.imgix.net/da9b1c15/uploads/origins/e8f5ad1b-9610-4cee-97db-aaf761780938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa14fd0bc763327810ac9f643a38722", "thumbnail_srcset": "https://si.imgix.net/da9b1c15/uploads/origins/e8f5ad1b-9610-4cee-97db-aaf761780938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa14fd0bc763327810ac9f643a38722, https://si.imgix.net/da9b1c15/uploads/origins/e8f5ad1b-9610-4cee-97db-aaf761780938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c291d8db6eefa7f393722ed7a131695b 2x, https://si.imgix.net/da9b1c15/uploads/origins/e8f5ad1b-9610-4cee-97db-aaf761780938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d04f32df507d784ba43b65397a15ff44 3x", "genre": "art", "nsfw": true, "body": "ブルアカのイチカちゃんのくぱぁも描いてください。\n鏡でえっちな自撮りをしてください。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@keorist/works/56", "thumbnail_src": "https://si.imgix.net/e2992037/uploads/origins/70bb6e6b-2a9f-4499-a160-2741b3ff8684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a95a9c7764fce6ee2f5ddd4e568270c", "thumbnail_srcset": "https://si.imgix.net/e2992037/uploads/origins/70bb6e6b-2a9f-4499-a160-2741b3ff8684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a95a9c7764fce6ee2f5ddd4e568270c, https://si.imgix.net/e2992037/uploads/origins/70bb6e6b-2a9f-4499-a160-2741b3ff8684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef4f8483ef57e49a3c4de3ed41c89782 2x, https://si.imgix.net/e2992037/uploads/origins/70bb6e6b-2a9f-4499-a160-2741b3ff8684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b197f1d0414452c3ff510644dcc6f8a8 3x", "genre": "art", "nsfw": true, "body": "以前は猫榴こなみを描いて頂いて、ありがとうございました。\n\nもし宜しければ、またリクエストさせていただきたいです。\n\nキャラクター\n猫榴こなみ\n参考画像\nhttps://twitter.com/573_6w6__/status/1540734675580485632\n上着を脱いで胸がはだけて、羽と尻尾も消えた状態でお願いします\n\nシチュエーション\n前回と同じく猫榴こなみが業界の偉いおっさんに枕営業しているシチュエーション。\n今回はフェラをしている内容\n早く終わらせるために嫌々だけど仕方なくフェラをしているという感じ。\nできれば胸が見える構図でお願いします。\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@keorist/works/55", "thumbnail_src": "https://si.imgix.net/6b5c7758/uploads/origins/625b1e5a-3272-4bb6-8fe5-aa4399b27486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9adf7297d29cca58592d9da50226e3fd", "thumbnail_srcset": "https://si.imgix.net/6b5c7758/uploads/origins/625b1e5a-3272-4bb6-8fe5-aa4399b27486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9adf7297d29cca58592d9da50226e3fd, https://si.imgix.net/6b5c7758/uploads/origins/625b1e5a-3272-4bb6-8fe5-aa4399b27486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e6df958c3d667f98426c42fb6572811 2x, https://si.imgix.net/6b5c7758/uploads/origins/625b1e5a-3272-4bb6-8fe5-aa4399b27486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f0ccea264a7955893db39ca4b65b212 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回依頼をさせてもらいます！\n\n\n【キャラクター】\n◆ファイアーエムブレム烈火の剣に登場するリンをリクエストします。\n　https://i.imgur.com/hqXiHoL.png\n　\n【シチュエーション】\n◆前回描いてもらったこちらの作品の続きシチュでお願いします。\n　https://misskey.io/notes/9xmjdcs1rmhu05b1\n　エロ催眠をかけられてモブ男達にフェラご奉仕をするリンをお願いします。\n\n【体位や構図】\n◆有翼ペンギンさんが以前描かれているこちらのイラストのような感じでフェラ奉仕しているという風にお願いします。\n　https://skeb.jp/@keorist/works/38\n　フェラされてるチンコ以外にもあと1～2人の竿役をリンの周りに描いてください。\n\n【表情】\n◆催眠がかかり目から光の無い表情でご奉仕フェラしているという風にお願いします。\n　上記の過去イラストみたいな表情でお願いします。\n\n【衣装】\n◆前回描いてもらった依頼品と同じぐらいの脱ぎ具合でお願いします。\n\n【台詞や擬音】\n◆エロいフェラ擬音をお願いします。\n　またモブ男達に\n　「うぉ…公女フェラめっちゃ気持ちいい」\n　「俺のも早く咥えてくれよ公女様」\n　みたいな感じの台詞をお願いします。\n\n【NG要素】\n◆個人的な好みで 　\n　・アヘ顔 　\n　・ひょっとこフェラやバキュームフェラ 　\n　・スカ要素 　\n　・乳首やクリトリスへのピアス\n　・口に抜け陰毛 　\n　などはNGでお願いします。\n\n【その他】\n◆竿役の男たちは全身写さずに前回描いてもらった依頼品ぐらいの写り込みでお願いします。\n　https://misskey.io/notes/9xmjdcs1rmhu05b1\n\n\n長々となりましたがどうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@keorist/works/54", "thumbnail_src": "https://si.imgix.net/4aaef505/uploads/origins/9ac62564-f2eb-4ce8-90f2-d9c891f75fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8d6e6dbe6eea3138182c60eae8323e", "thumbnail_srcset": "https://si.imgix.net/4aaef505/uploads/origins/9ac62564-f2eb-4ce