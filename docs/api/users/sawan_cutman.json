%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=788b1ff0046d7d9b9aa7645488d7a93d, https://si.imgix.net/a1d477fd/uploads/origins/c565cbe0-8f16-4f5e-8d4d-afa538b213a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63d624b9fc102b7a247b312cd0797b81 2x, https://si.imgix.net/a1d477fd/uploads/origins/c565cbe0-8f16-4f5e-8d4d-afa538b213a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4e2a624eeb953ebb7e5e6ba45d853b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sawan_cutman/works/109", "thumbnail_src": "https://si.imgix.net/92266478/uploads/origins/58aef327-e7fe-46b1-9739-24d7db1d2228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae87154d47c0f34db66ed4b40be12b4d", "thumbnail_srcset": "https://si.imgix.net/92266478/uploads/origins/58aef327-e7fe-46b1-9739-24d7db1d2228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae87154d47c0f34db66ed4b40be12b4d, https://si.imgix.net/92266478/uploads/origins/58aef327-e7fe-46b1-9739-24d7db1d2228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f6e2f158fbb44258d7b33dac80c3d3b 2x, https://si.imgix.net/92266478/uploads/origins/58aef327-e7fe-46b1-9739-24d7db1d2228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=986ead2141baf3e95f9ce3d75383cbc1 3x", "genre": "art", "nsfw": false, "body": "はじめまして。先生の遊戯王絵いつも楽しみに見ています！ローが増Gにパワー勝てなくて煽られてるこち亀パロめちゃくちゃ好きです！\n\n今回お願いしたいイラストは、『ポケットモンスターSV』のキャラクター「ポピー」が、初代ウルトラマンに登場する「宇宙恐竜ゼットン」に肩車されているイラストです。（Xのアイコンとして使用させていただきたいです）\n\n〜ポピー\n・表情は笑顔\n・片手でゼットンの角を掴む\n・もう片方の手は人差し指を前に突き出して「行けー！」と言っているような仕草\n\n〜ゼットン（初代ウルトラマンに登場する怪獣）\n・ノリノリで、両手でポピーの足をしっかり支えながら走っている\n\n構図としては「ゼットンが走り、その上でポピーが元気いっぱいに指差している」というイメージです。\n少し特殊な組み合わせですが、先生にぜひ描いていただきたいです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@sawan_cutman/works/108", "thumbnail_src": "https://si.imgix.net/2f42b3bd/uploads/origins/70e07e95-30b1-401e-9646-6ffc7d8b5368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43ef300752d23a1e3080e115710a078e", "thumbnail_srcset": "https://si.imgix.net/2f42b3bd/uploads/origins/70e07e95-30b1-401e-9646-6ffc7d8b5368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43ef300752d23a1e3080e115710a078e, https://si.imgix.net/2f42b3bd/uploads/origins/70e07e95-30b1-401e-9646-6ffc7d8b5368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35710d9870696751cf62d50ee897a90f 2x, https://si.imgix.net/2f42b3bd/uploads/origins/70e07e95-30b1-401e-9646-6ffc7d8b5368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84440d8c9faffbe3b0ba5c62a0191e88 3x", "genre": "art", "nsfw": false, "body": "はじめまして、いつもイラスト拝見しています\n初リクエスト失礼します\nエクスキューティー・フローア、見習い魔女、ゴーストリックの魔女、マドルチェ・マジョレーヌが、ハリー・ポッターのクィディッチをしていて、羽のついた金の玉(スニッチ)を追いかけているといったシチュエーションでお願いしたいです。\n細かい部分はおまかせします。\n初めてのリクエストで恐縮ですが、ぜひお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sawan_cutman/works/107", "thumbnail_src": "https://si.imgix.net/c3e9ba93/uploads/origins/788335bf-bebe-4b5a-a845-165a77daad0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610664843f045d5a9192faa8fcd7c1d0", "thumbnail_srcset": "https://si.imgix.net/c3e9ba93/uploads/origins/788335bf-bebe-4b5a-a845-165a77daad0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610664843f045d5a9192faa8fcd7c1d0, https://si.imgix.net/c3e9ba93/uploads/origins/78833