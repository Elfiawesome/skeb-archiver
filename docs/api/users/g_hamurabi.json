-a0c6-dd264b4a46e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0931e82c521ef3a648847e7869115576", "thumbnail_srcset": "https://si.imgix.net/649be856/uploads/origins/de5f154c-8b5b-4a82-a0c6-dd264b4a46e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0931e82c521ef3a648847e7869115576, https://si.imgix.net/649be856/uploads/origins/de5f154c-8b5b-4a82-a0c6-dd264b4a46e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8bc8ced9cf19387af51fd7b727f50c8 2x, https://si.imgix.net/649be856/uploads/origins/de5f154c-8b5b-4a82-a0c6-dd264b4a46e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b47c3dbd2b94392e9f7dd7a3969a4857 3x", "genre": "art", "nsfw": true, "body": "このイラストとGTAのアーカイブを見ていて閃いたシチュをお願いしたいです。\n\n竜胆尊とレヴィ・エリファがキャバの経営に失敗して借金を背負ってしまい、成功したら借金がチャラという条件で「生中出し100人抜き」というAV企画に参加したという状況です。（もしよければそのほかのキャバ店員も後ろで転がっていると嬉しいです。（例：早瀬走、ドーラなど）\n構図としてはURLのイラストと同じような感じで大丈夫です。\n\n・何人抜いたかが得点板のようなカウンターで表示されておりすでに30人くらいカウント\nすでに尊様は大量に中出しされておりボテ腹になっており母乳も出しながら「がんばれレヴィ！もう残っとるのワシとお主だけなんじゃよ！」と発破をかけている。レヴィちゃんは華奢な体に巨根をぶち込まれつつちっぱいをつねられて「ムリ！ボクこわれル！こわれちゃウ！」\n\n・カウンターが96人（惜しくもクリアならず）\n2人とも精液まみれでボテ腹になっている。尊様は常に深イキしているような顔で母乳を激しく絞られながら「おっ…おぉっ…」とされるがまま、レヴィちゃんはちっぱいから絞られなくても常に母乳がたらたれ漏れてる感じで気絶して犯され続けている。（後ろに他の店員が転がっている場合はその人たちもボテ腹になっている）\n\n是非よろしくお願いします。\n\nhttps://skeb.jp/@g_hamurabi/works/30", "created_at": "", "completed_at": ""}, {"path": "/@g_hamurabi/works/37", "thumbnail_src": "https://si.imgix.net/dd2d40d8/uploads/origins/41ee14c7-3bdd-4913-976c-d0f6478939c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c3e283496f0866cdf38afd254c7bf53", "thumbnail_srcset": "https://si.imgix.net/dd2d40d8/uploads/origins/41ee14c7-3bdd-4913-976c-d0f6478939c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c3e283496f0866cdf38afd254c7bf53, https://si.imgix.net/dd2d40d8/uploads/origins/41ee14c7-3bdd-4913-976c-d0f6478939c0?bg=%23fff&auto=format%2Ccompress&fm=