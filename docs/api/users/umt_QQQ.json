a5e-8822-7adb9b9854d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6132985ac2be7e4e501ea0ae1d3a768b, https://si.imgix.net/23ef135e/uploads/origins/e4b08a33-ef56-4a5e-8822-7adb9b9854d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe2d35e96465a7cc59be321de094473c 2x, https://si.imgix.net/23ef135e/uploads/origins/e4b08a33-ef56-4a5e-8822-7adb9b9854d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23c5841c5a294587ae6733ded2c8af45 3x", "genre": "art", "nsfw": false, "body": "こんばんは、いつも素敵な作品をありがとうございます！ずもさんのファンを長年勝手にやらせて頂いている者です…。\n\nお忙しいところ恐れ入りますが、アイコン用イラストをお願いできますでしょうか。\n以下の要素のイラストを作成して頂ければと思っております。\n●黒髪の女がポピーの花を抱えて、証明写真のように正面を見ている\n\n上記要素以外はおまかせ出来れば幸いです。。\n依頼内容が大雑把で申し訳ございませんが、何卒よろしくお願いいたします…！", "created_at": "", "completed_at": ""}, {"path": "/@umt_QQQ/works/5", "thumbnail_src": "https://si.imgix.net/4b2ca6a7/uploads/origins/196ad5c5-604c-4608-a301-e73a427dee33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5885be850ce2e255c2fa7da1539217e6", "thumbnail_srcset": "https://si.imgix.net/4b2ca6a7/uploads/origins/196ad5c5-604c-4608-a301-e73a427dee33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5885be850ce2e255c2fa7da1539217e6, https://si.imgix.net/4b2ca6a7/uploads/origins/196ad5c5-604c-4608-a301-e73a427dee33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e392ad0ab1aef0bca445b68cf85e7996 2x, https://si.imgix.net/4b2ca6a7/uploads/origins/196ad5c5-604c-4608-a301-e73a427dee33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28e8d5450b26c2347b1013f6bd1e7391 3x", "genre": "art", "nsfw": false, "body": "Misskeyで募集ノートを拝見しました！　一次創作小説のキャラでモノクロイラストをお願いできますでしょうか。\n\n■キャラクター\n吸血鬼体質の貴族青年「パトリック」\n・世界を救う勇者を目指しているが、立ち振る舞いが悪の幹部っぽくなりがち\n・特異体質なだけで種族は人間なので牙などはなし\n・睫毛は長く眉毛は太め、表情筋はよく動くタイプ\n・身に付けている宝石はトパーズ\n・読書や茶会をよくする。紅茶はミルクティー派\n・コウモリ系の使い魔がいる\nふとしたきっかけで出会った青年（資料フォルダ内にいる「テオバルト」）のことを一方的に気に入っており、有無を言わさず旅に連れ回している…というやや自己中心的な青年です。\n\nキャラデザ資料はURL先にあります。\n衣装アレンジ、髪を下ろすなどの髪型アレンジもOKです。衣装自体も複数ありますが、どれでもOKです。\nhttps://drive.google.com/drive/folders/1shOC2BC33kGFE9QjKhw_yTL9O13ffxNA?usp=sharing\n\n■シチュエーション、構図\n構図やトリミング範囲など、全面的にお任せ致します。\n\nご検討のほど宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1shOC2BC33kGFE9QjKhw_yTL9O13ffxNA?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@umt_QQQ/works/4", "thumbnail_src": "https://si.imgix.net/4f845c9e/uploads/origins/57cbdef4-7a69-45b1-8e50-bfac5cef2bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb137c489104ecf22e743a4bda5e1dc0", "thumbnail_srcset": "https://si.imgix.net/4f845c9e/uploads/origins/57cbdef4-7a69-45b1-8e50-bfac5cef2bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb137c489104ecf22e743a4bda5e1dc0, https://si.imgix.net/4f845c9e/uploads/origins/57cbdef4-7a69-45b1-8e50-bfac5cef2bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9565032b4be049ddde6d6ef1cf2ad673 2x, https://si.imgix.net/4f845c9e/uploads/origins/57cbdef4-7a69-45b1-8e50-bfac5cef2bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9353de68987c2e0c15ba49407bc9618c 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストや漫画を拝見させていただいております。\n\nこの度は私のオリジナルキャラクターを描いていただきたいです。\n簡単なもので恐縮ですが、ご依頼内容は以下の通りです。\n\n・吸血鬼のオリジナルキャラクター\n・中性的な外見\n・犬歯、瞳に十字のハイライト、大きめのリボンが特徴\n・不器用だがひたむきな性格\n\nより詳細な外見のイメージについては資料URLをご参照ください。\n\nポージング・構図・服装等についてはご自由に描いていただきたく思います。\n\n以上、ご縁がありましたらよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/192-g2F06kx8UhihLPNKHPUBNQzIHg6sg?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@umt_QQQ/works/3", "thumbnail_src": "https://si.imgix.net/76610fc3/uploads/origins/fe940d60-0dc3-46da-944d-23968f1ce73a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac86d6983492df7d5c23e015a3e31826", "thumbnail_srcset": "https://si.imgix.net/76610fc3/uploads/origins/fe940d60-0dc3-46da-944