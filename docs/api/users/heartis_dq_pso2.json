90-2db40a34b786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67c01fd1b9516e1971a25a81aa1556c5, https://si.imgix.net/e8d24a20/uploads/origins/6c654849-b906-455d-b890-2db40a34b786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18721e16a94ea8ebc675b25e348cf506 2x, https://si.imgix.net/e8d24a20/uploads/origins/6c654849-b906-455d-b890-2db40a34b786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38f51da32e6fbf08ad37a57751910007 3x", "genre": "art", "nsfw": false, "body": "鮭べんとーさん前回のリクエストを受け入れていただき、ありがとうございました。\nもしよろしければ、またノブナガンのイラストをお願いしたいのですが。今回は、第二小隊のメンバーを音楽グループとして描いてほしいですね。ロックバンドでもいいし、アイドルグループでもいい;その選択は鮭べんとーさんにお任せします。もし差し支えなければ、登場人物にふさわしいコスチュームを考えてみてください。\n第二小隊の構成は以下の通りです:\nしお：https://www.vap.co.jp/nobunagun/character/index.html\nジャック：https://www.vap.co.jp/nobunagun/character/jack.html\nニュートン：https://www.vap.co.jp/nobunagun/character/newton.html\nガンジー：https://www.vap.co.jp/nobunagun/character/gandhi.html\nキャラクター物がかなり多いので、メンバー全員を描くのが嫌なら、ニュートンとガンジーを外せばいいんです。\nよろしくお願いしうます。\n\nhttps://www.vap.co.jp/nobunagun/character/index.html", "created_at": "", "completed_at": ""}, {"path": "/@heartis_dq_pso2/works/6", "thumbnail_src": "https://si.imgix.net/29a4a1e7/uploads/origins/ec23b29d-ed79-4ea5-af1e-bedef0f066ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2c06a56e82da2052628c8ea731530a", "thumbnail_srcset": "https://si.imgix.net/29a4a1e7/uploads/origins/ec23b29d-ed79-4ea5-af1e-bedef0f066ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2c06a56e82da2052628c8ea731530a, https://si.imgix.net/29a4a1e7/uploads/origins/ec23b29d-ed79-4ea5-af1e-bedef0f066ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=088821223ce65137777a50f48609b63f 2x, https://si.imgix.net/29a4a1e7/uploads/origins/ec23b29d-ed79-4ea5-af1e-bedef0f066ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0926f480412390aec463d556dac7c9b 3x", "genre": "art", "nsfw": true, "body": "初めまして。違うジャンル・シリーズをリクエストしてしまい、申し訳ありませんでした。私は鮭べんとーさんのスタイルが好きで、「ノブナガン」シリーズのキャラクター「小椋シオ」×「ジャック」を鮭べんとーが描いたら楽しいだろうと思います。しおｘジャックのエッチなイラストをリクエストしても大丈夫ですか？\n参考資料: https://www.vap.co.jp/nobunagun/character/index.html\nhttps://www.vap.co.jp/nobunagun/character/jack.html\n私のリクエストを考慮していただき、ありがとうございます。\n\nhttps://www.vap.co.jp/nobunagun/character/index.html", "created_at": "", "completed_at": ""}, {"path": "/@heartis_dq_pso2/works/5", "thumbnail_src": "https://si.imgix.net/db16e43c/uploads/origins/2eed931a-0bf4-451d-be6a-51c48826cdc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee66629776fee4f7c6ee3fbfedfcb1e9", "thumbnail_srcset": "https://si.imgix.net/db16e43c/uploads/origins/2eed931a-0bf4-451d-be6a-51c48826cdc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee66629776fee4f7c6ee3fbfedfcb1e9, https://si.imgix.net/db16e43c/uploads/origins/2eed931a-0bf4-451d-be6a-51c48826cdc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=880c37fba7e81ce8cfeadb36820a59ce 2x, https://si.imgix.net/db16e43c/uploads/origins/2eed931a-0bf4-451d-be6a-51c48826cdc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9d7bcc792124f18e7fa7274cf34b36e 3x", "genre": "art", "nsfw": false, "body": "天外魔境第四の黙示録　のアイク・クリントンをお願いしたいのですが、いわゆる夢絵というのは可能でしょうか。\nもし可能であれば\n・散々ボコられて情けなく地べたに這いつくばるボロ雑巾な私からの視点\n・そんな私を死にかけのドブネズミを見るような目で見おろしながらあの尖った爪先のブーツで蹴りを入れてくるアイク\nでお願いしたいです。\n視界(=画面)の端に血が滲んでいたりするとめもう最高です。", "created_at": "", "completed_at": ""}, {"path": "/@heartis_dq_pso2/works/4", "thumbnail_src": "https://si.imgix.net/2ca2957d/uploads/origins/43f662ad-d093-4677-b945-06fb39aac620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=007a8001f44e3315cddf7999ed62e32a", "thumbnail_srcset": "https://si.imgix.net/2ca2957d/uploads/origins/43f66