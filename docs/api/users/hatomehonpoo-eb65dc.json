が触手に襲われてるコミックをお願いします。\n\n構図や表情等ははとめ様にお任せしますが触手による愛撫と挿入描写、快楽落ちしている表情がありますとありがたいです。\n\n条件やリクエスト内容が合わなければ遠慮なくキャンセルしてください。\n\n年始のご多忙な時期かと思いますがご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hatomehonpoo/works/11", "thumbnail_src": "https://si.imgix.net/c2553937/uploads/origins/b37068d8-cad2-40b9-a770-ab8648d07157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81e6808a1e55f7865883b3388006121f", "thumbnail_srcset": "https://si.imgix.net/c2553937/uploads/origins/b37068d8-cad2-40b9-a770-ab8648d07157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81e6808a1e55f7865883b3388006121f, https://si.imgix.net/c2553937/uploads/origins/b37068d8-cad2-40b9-a770-ab8648d07157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcb32af90bf8939d60369ab2c6c3b823 2x, https://si.imgix.net/c2553937/uploads/origins/b37068d8-cad2-40b9-a770-ab8648d07157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77bee4d4467283ebfb2574f2c081b5f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hatomehonpoo/works/10", "thumbnail_src": "https://si.imgix.net/fd2493d5/uploads/origins/cb125516-b587-4710-ac35-3dbd60d80fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f15e0590a9af34fa208316eb1df70bd3", "thumbnail_srcset": "https://si.imgix.net/fd2493d5/uploads/origins/cb125516-b587-4710-ac35-3dbd60d80fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=