.net/be8551b9/uploads/origins/5029ed86-c615-420a-8b48-12fa74856f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=652d632b4a978f998c8466257977d72c, https://si.imgix.net/be8551b9/uploads/origins/5029ed86-c615-420a-8b48-12fa74856f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e914ccee491a09c7d5bf305fa7c6083b 2x, https://si.imgix.net/be8551b9/uploads/origins/5029ed86-c615-420a-8b48-12fa74856f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b7ee56305ed7d5486e6e47482f87429 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nikumochu/works/9", "thumbnail_src": "https://si.imgix.net/54e17f22/uploads/origins/263673e7-9238-4705-ada4-224147d1be44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1f336906632a50284e1db6c7cdf37b5", "thumbnail_srcset": "https://si.imgix.net/54e17f22/uploads/origins/263673e7-9238-4705-ada4-224147d1be44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1f336906632a50284e1db6c7cdf37b5, https://si.imgix.net/54e17f22/uploads/origins/263673e7-9238-4705-ada4-224147d1be44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e32f485a27a25e3f4ae1353f773642fd 2x, https://si.imgix.net/54e17f22/uploads/origins/263673e7-9238-4705-ada4-224147d1be44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84bbea063d90fed45202732b91175232 3x", "genre": "art", "nsfw": true, "body": "はじめましてのご依頼となります。\n今回は所謂うちの子、オリジナルキャラでのイラストのリクエストになります。よろしければお願い致します。\n\nシチュエーションとしては。\n普段着ることのない修道服を着てテンションが上がり、恋仲の相手の子にチラ見せというか……\n修道服の胸元をはだけて自慢のおっぱいをぽろんとさせて誘っている感じでお願いします。\