33d8e5da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9bb51d5322db2b6e36541ff9afb0079, https://si.imgix.net/5bbdb6aa/uploads/origins/8394a2b0-53a6-4176-a1ac-b0933d8e5da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a13de1b828fa0b655bc5b3911176cd9 2x, https://si.imgix.net/5bbdb6aa/uploads/origins/8394a2b0-53a6-4176-a1ac-b0933d8e5da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39401af18aa3799c258586faf76d4c15 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルの大ファンなので、私の茶色いウサギを描いてくれませんか？\n\nあなたの他の絵のように胸が大きくて、セーターを伸ばして胸の谷間が見えるような彼女を見たいと思っています。ポーズは何でも構いません！\n\nとてもドヤ顔でいじわるなので、ドヤ顔で企んでいるような表情の絵でも嬉しいです。\n\nhttps://www.dropbox.com/scl/fo/pf02abh9clmfsbg6azxik/ANhBWJXU2-JEu5bqU6dtrCs?rlkey=txg5jxcz5ws9smqfvjtzcenr6&st=qrudsnvm&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/36", "thumbnail_src": "https://si.imgix.net/017c06a3/uploads/origins/a0b1757c-f9fc-4155-938e-eb6e6bc2a310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=892b22cc5f72337c29291deab9c17eb9", "thumbnail_srcset": "https://si.imgix.net/017c06a3/uploads/origins/a0b1757c-f9fc-4155-938e-eb6e6bc2a310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=892b22cc5f72337c29291deab9c17eb9, https://si.imgix.net/017c06a3/uploads/origins/a0b1757c-f9fc-4155-938e-eb6e6bc2a310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e60d47a9d7dd19b63e70169f1f1d88d 2x, https://si.imgix.net/017c06a3/uploads/origins/a0b1757c-f9fc-4155-938e-eb6e6bc2a310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ceb64875518b019acb972f26e144a1d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きで、私のキャラクターの絵をリクエストしたかったの。\n\n私の魔女と磁器人形の女の子を描いてください。魔女は冷淡で、いつも無気力な顔をしています。彼女の身長は254cmです。人形は109cmしかなく、とてもフォーマルです。\n魔女にこの作品と同じようなボディを与えていただけたらと思います！https://skeb.jp/@hachi__rou/works/24\n\nシナリオは、魔女が人形に迫られるというもの。人形は注意を引くために彼女のシャツを引っ張り、その結果、シャツが彼女の大きな胸にきつく押し付けられる。ポーズはこれに似ている。https://files.catbox.moe/qwaenn.jpg\n\n魔女の参考資料です：\nhttps://files.catbox.moe/lbaj0m.png\nhttps://files.catbox.moe/aomrcd.png\n\n人形の参考文献はこちら：\nhttps://files.catbox.moe/ahvm9q.png\nhttps://files.catbox.moe/j42o8a.png\nhttps://files.catbox.moe/q5tlsq.png\nhttps://files.catbox.moe/r4qp5w.png", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/35", "thumbnail_src": "https://si.imgix.net/8f46a6bf/uploads/origins/ad2cd5cc-f1d1-4d86-b72d-016894d755dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3717d5b12e5420290347a4f5480dcf64", "thumbnail_srcset": "https://si.imgix.net/8f46a6bf/uploads/origins/ad2cd5cc-f1d1-4d86-b72d-016894d755dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3717d5b12e5420290347a4f5480dcf64, https://si.imgix.net/8f46a6bf/uploads/origins/ad2cd5cc-f1d1-4d86-b72d-016894d755dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d8018b0dc5d72dbe3859b7abfa5206c 2x, https://si.imgix.net/8f46a6bf/uploads/origins/ad2cd5cc-f1d1-4d86-b72d-016894d755dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68b4ac163011945b1e0944085671eb69 3x", "genre": "art", "nsfw": false, "body": "こんにちは！最近のニコ・ロビンと豊満な女性のアートが気に入ったので、リクエストさせてください！\n\n今度発売される『ユーミアのアトリエ』のニーナ・フリーデというキャラクターを描いていただけませんか？魅惑的な雰囲気の銃を振り回す師匠キャラです。下のリンクにニーナのデザインの参考資料を用意しました：\n\nニーナ・フリーデ 参考：https://imgur.com/a/3Hk5dyk\n\nニーナが銃を見せるポーズで描かれるのを見たい。ターゲットを睨みつけるような、拗ねたような表情のニーナを見てみたい。ポーズは好みで自由に変えてください。\n\n銃のポーズ参考：https://imgur.com/a/OpDpF0n\n\nニコ・ロビンのような横構図でお願いします：\n\nニコ・ロビン アート：https://skeb.jp/@hachi__rou/works/22\n\nその他の詳細はお任せします。ご検討のほど、よろしくお願いいたします！また作品を拝見できるのを楽しみにしています。", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/34", "thumbnail_src": "https://si.imgix.net/6aab288b/uploads/origins/631679d4-9054-4f66-9c11-bfefda8c2c71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff3863f585bc0a26951a331137375f7", "thumbnail_srcset": "https://si.imgix.net/6aab288b/uploads/origins/631679d4-9054-4f66-9c11-bfefda8c2c71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff3863f585bc0a26951a331137375f7, https://si.imgix.net/6aab288b/uploads/origins/631679d4-9054-4f66-9c11-bfefda8c2c71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=161dab3709de897cdc1f19bd0380a496 2x, https://si.imgix.net/6aab288b/uploads/origins/631679d4-9054-4f66-9c11-bfefda8c2c71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8459e2354f19e9def5644b161fbb07e2 3x", "genre": "art", "nsfw": false, "body": "初めまして、Vtuber （準備中）の縞那賀えこんと申します。\n八郎様の素敵なイラストを拝見し、是非描いて頂きたくご依頼させていただきました。\n\n【依頼内容】\n◆キャラクター\n縞那賀 えこん（しまなが えこん）\nおいしいご飯とお酒やゲームが大好きな社畜。\n髪のインナーカラーは黒。\n手の甲に三日月のブローチ。\nネイルは親指から黒、赤、黒、赤、黒。\n三面図はありませんので、見えない部分は好きに描いていただいて大丈夫です。\n参考資料：\nhttps://drive.google.com/drive/folders/1pBRVUFTBZVvhmeU1Wve9pY0kmm0OVbGL?usp=sharing\n\n◆シチュエーション、構図など\n水着姿を描いていただきたいです。\n構図やデザイン等は全てお任せさせていただきたいです。\n髪型など変更していただいても問題ありません。\n人物の頭や髪が見切れていないと助かります。\n\n【使用用途】\n・Vtuber活動全般\n・Twitter等各種SNSのアイコンや投稿\n・YouTubeやtwitch等のサムネイル、ヘッダー、動画など\n・ゆくゆくは収益化後の配信・動画でも使用したいと考えております。\n・FANBOX（未定）やグッズ化での商用利用\nNGのものがある場合は別途レイヤー等に記載していただけると幸いです。\nNGの用途へは使用いたしません。\n\n【その他】\nPSD形式希望で、背景と人物、サインを分けて納品していただけると助かります。\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/33", "thumbnail_src": "https://si.imgix.net/f0474d55/uploads/origins/ea131a1c-5735-4b77-9f85-0aa3a9a54639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faea71c8b88828f3b9f059f666842b53", "thumbnail_srcset": "https://si.imgix.net/f0474d55/uploads/origins/ea131a1c-5735-4b77-9f85-0aa3a9a54639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faea71c8b88828f3b9f059f666842b53, https://si.imgix.net/f0474d55/uploads/origins/ea131a1c-5735-4b77-9f85-0aa3a9a54639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f9be2a4fc11b692102092c2611ee298 2x, https://si.imgix.net/f0474d55/uploads/origins/ea131a1c-5735-4b77-9f85-0aa3a9a54639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45970ed647dc6f7c891af2f6ca538065 3x", "genre": "art", "nsfw": false, "body": "先日は素敵なイラストありがとうございました！\nまさかキャラたちの関係性まで熟読した上で複数名のシーンを描いていただけるなんて…最高のイラストでした！！！\nその後の他のリクエストイラストなども拝見しておりましたが、八郎さんの描く特盛の娘たちが素敵で我慢出来ず今回リピートを送らせていただきます！\n\n\n内容\n当方のオリキャラの中からお好きなキャラを選んでいただき、そのキャラと弾力のある割れないシャボン玉の絡んだイラスト\n\nキャラデザ\n資料URLのリンクからお好きなキャラをお選びください\nまた、既にご存知かと思われますが当方のオリキャラは皆胸が大きなキャラばかりですが、八郎さんの特盛イラスト大好きなのでデフォルトにこだわらずいくらでも更に好きに盛ってくださって大丈夫です！！！\n\n衣装\n元々のデフォルトの衣装に限定しませんのでお好きな衣装、季節にあった衣装、シチュエーションにあった衣装等を自由着せてくださいますと幸いです\n\nシャボン玉\n弾力のある割れないシャボン玉\nという設定で前回同様にキャラと自由に絡めてください\n\n\n以上が内容となります\n前回のイラストがあまりにも可愛くて素敵で作品の端から端まで余すことなく最高で嬉しくなり今回リピートしてしまいましたが、元々がマニアックな内容でのリクエストですのでご迷惑でしたら申し訳ございません\nもしよろしければ、今回も何卒よろしくお願いいたします\n\nhttps://syabon09.simdif.com/?s=09", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/32", "thumbnail_src": "https://si.imgix.net/8e6188f0/uploads/origins/f867688c-0fd1-4dc5-bc9a-7b4a1953205f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df06ebd794ec405a60b84bc7cab73aa", "thumbnail_srcset": "https://si.imgix.net/8e6188f0/uploads/origins/f867688c-0fd1-4dc5-bc9a-7b4a1953205f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df06ebd794ec405a60b84bc7cab73aa, https://si.imgix.net/8e6188f0/uploads/origins/f867688c-0fd1-4dc5-bc9a-7b4a1953205f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a44c96339676deae22a41ba370abcf9 2x, https://si.imgix.net/8e6188f0/uploads/origins/f867688c-0fd1-4dc5-bc9a-7b4a1953205f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39bf7b017d953412a5ba4f1b7c7aa3fe 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nVtuberのIkumiを描いてほしい。\n彼女は休暇中の悪魔退治人で、ASMRをたくさんやっています。\nhttps://www.youtube.com/@ikumi\n\nマスコットキャラクターとハグしているところを描いてほしい。\nhttps://files.catbox.moe/l89q3i.png\nマスコットの大きさは彼女の頭より少し大きいくらいで、枕のようにふにゃふにゃと柔らかく描いてください。\n\nカーディガンを羽織った白い衣装の郁美を描いてほしい。胸は参考画像よりも大きく、頭の大きさよりも少し小さめにしてください。胸はマスコットキャラクターの上にのせてください。表情は明るく。\n\n背景はベッドやソファなどでも構いません。\n\n[参考シート］\nhttps://drive.google.com/drive/folders/1WSAAHKLpykLF2zQYh0gM_6aywXngFo5V?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/31", "thumbnail_src": "https://si.imgix.net/57af5151/uploads/origins/0927b959-e6df-4070-a1cf-842bb9ea29f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=155c5640ecf69bf31e94018b88167020", "thumbnail_srcset": "https://si.imgix.net/57af5151/uploads/origins/0927b959-e6df-4070-a1cf-842bb9ea29f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=155c5640ecf69bf31e94018b88167020, https://si.imgix.net/57af5151/uploads/origins/0927b959-e6df-4070-a1cf-842bb9ea29f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8408613ad831b7b942242aeecea1c86e 2x, https://si.imgix.net/57af5151/uploads/origins/0927b959-e6df-4070-a1cf-842bb9ea29f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c508b3ecf9e40f72526df41e4865a9a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hachi__rou/works/30", "thumbnail_src": "https://si.imgix.net/8b15df6d/uploads/origins/7229c9d7-4e2d-4769-b395-c16838e3fe95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87e1f82cae34456508f22d52813e4d83", "thumbnail_srcset": "https://si.imgix.net/8b15df6d/uploads/origins/7229c9d7-4e2d-4769-b395-c1683