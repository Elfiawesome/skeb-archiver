gn=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c9137792847eb514542a15200f0cebf 2x, https://si.imgix.net/41801416/uploads/origins/3f81fbcf-480c-4c54-9ad7-911ce5a9571b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f1f6c687e4d06fcbd2ce220e3649f17 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@harusame13/works/152", "thumbnail_src": "https://si.imgix.net/c4e02169/uploads/origins/b4a49e66-7112-425a-97e2-e18f19f5cb31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccf10bf78ed12e52200d577ae64efa3c", "thumbnail_srcset": "https://si.imgix.net/c4e02169/uploads/origins/b4a49e66-7112-425a-97e2-e18f19f5cb31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccf10bf78ed12e52200d577ae64efa3c, https://si.imgix.net/c4e02169/uploads/origins/b4a49e66-7112-425a-97e2-e18f19f5cb31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd9203217f290c3af3748c7a7d3b808a 2x, https://si.imgix.net/c4e02169/uploads/origins/b4a49e66-7112-425a-97e2-e18f19f5cb31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c6225c8921865af0fd14bcefa9ede71 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@harusame13/works/151", "thumbnail_src": "https://si.imgix.net/7880bf9d/uploads/origins/55279afa-383c-4fe7-8e24-5838e5b589a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef1d633887c60c19e40de5f2b81bd07", "thumbnail_srcset": "https://si.imgix.net/7880bf9d/uploads/origins/55279afa-383c-4fe7-8e24-5838e5b589a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef1d633887c60c19e40de5f2b81bd07, https://si.imgix.net/7880bf9d/uploads/origins/55279afa-383c-4fe7-8e24-5838e5b589a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9cd946811329aefe399871ccc9d172e 2x, https://si.imgix.net/7880bf9d/uploads/origins/55279afa-383c-4fe7-8e24-5838e5b589a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3344c80136b4776a713cb47fe901e75f 3x", "genre": "art", "nsfw": true, "body": "こんにちは！東方ProjectのAlice Margatroid with Medicine Melancholyをリクエストしたいです。\n\nメディスンはフタナリで、彼女の精液には強い媚薬効果、乳房や尻の拡張、思考障害、中毒性など様々な毒性があります。\n\nメディスンがアリスを自分だけのラブドールに仕立て上げ、毒精液中毒にさせるというテイクをぜひ見てみたい。アリスは最初はパンストを履いて服を着ているが、メディシンの精液の後遺症でセックスを続けるうちに胸が膨らみ、服を突き破って胸が露わになる。アリスのパンストは膨張したヒップで数カ所穴が開き、股間にも穴が開いて、メディスンのペニスを入れるためにパンティが横に押されているのが見える。できれば乳房の大きさを何段階かに分けて、最後に母乳を飲ませてほしい。アリスは完全に中毒になり、メディスンの精液まみれになる。\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@harusame13/works/150", "thumbnail_src": "https://si.imgix.net/ea1e7166/uploads/origins/7a01ab7b-910d-4af7-96c1-eec77f8dbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a35438aceee31abd4dc644640f7be5", "thumbnail_srcset": "https://si.imgix.net/ea1e7166/uploads/origins/7a01ab7b-910d-4af7-96c1-eec77f8dbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a35438aceee31abd4dc644640f7be5, https://si.imgix.net/ea1e7166/uploads/origins/7a01ab7b-910d-4af7-96c1-eec77f8dbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97d817a79dcb64abc5b6b58ed7937ae1 2x, https://si.imgix.net/ea1e7166/uploads/origins/7a01ab7b-910d-4af7-96c1-eec77f8dbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=006963e0b49eae3ac704cae5eaef49d3 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\n東方projectの純狐と、ふたなり優曇華のイラストをお願いします。\nシチュエーションは、発情して射精が止まらなくなったふたなり鈴仙。純狐がペニスを扱いて全部出させようとするも全く治まらない、という場面。\n\n鈴仙は下半身だけ脱いだ制服姿。止まらない快感でどうしようも無い状態。\n純狐はいつもの服装で着衣のまま、大量の精液を浴びて顔も服もドロドロの状態。困惑しつつも恍惚とした表情。\n\n以上よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@harusame13/works/149", "thumbnail_src": "https://si.imgix.net/ad4a1636/uploads/origins/07be87b0-6ab7-4699-861f-1d7a2b9a1228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb30364c2037d33be849ffaf08a800cf", "thumbnail_srcset": "https://si.imgix.net/ad4a1636/uploads/origins/07be87b0-6ab7-4699-861f-1d7a2b9a1228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb30364c2037d33be849ffaf08a800cf, https://si.imgix.net/ad4a1636/uploads/origins/07be87b0-6ab7-4699-861f-1d7a2b9a1228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2abc107ed21d5ac4755388268bdd13c2 2x, https://si.imgix.net/ad4a1636/uploads/origins/07be87b0-6ab7-4699-861f-1d7a2b9a1228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91fe8d909d5946951b2d46dfa3fda1ef 3x", "genre": "art", "nsfw": true, "body": "初めまして、いつも素敵な絵を見させていただいております。\n募集再開のポストを見掛けて、依頼をさせていただきました！\n\n早速ですが、差し支えなければ「戎　瓔花」「霍　青娥（娘々）」「四季映姫・ヤマザナドゥ」の３人の入ったイラストを描いていただけますと幸いです。\n\n\n【舞台背景】\n娘々に怪しい術を掛けられて、女の子から男の子にされてしまった瓔花ちゃん。\n瓔花ちゃんに男の子の気持ち良さを教えてあげようと、迫る娘々。\n\nそこへたまたま通りかかった映姫様は、超速で全ての状況を理解した。\n「このままでは瓔花ちゃんが身も心も男の子になってしまう！　私が阻止しなければ！」\n\n\n【シチュエーション】\n・瓔花ちゃんの横に居て、瓔花ちゃんのおちんちんと玉を弄っている娘々\n　男の子の気持ち良さに溺れさせようとしている\n\n・瓔花ちゃんの後ろから抱き着いて、瓔花ちゃんの乳首を弄っている映姫様\n　女の子の気持ち良さを思い出させようとしている\n\n・二人にいっぱい気持ち良いところを弄られ、夢見心地な瓔花ちゃん\n\n※構図としては、過去のSkeb絵にある「ルナサくんが弁々ちゃんと静葉さんに挟まれている」ものが近いです\n\n\n【キャラの体形や服装など】\n・瓔花ちゃん\n子供っぽい体形。男の子化しているためおっぱいは無いが、乳首はちゃんと弄れるくらいのサイズ\nおちんちんや玉は、清潔感があってつるつるすべすべな感じ（剥けていても大丈夫ですが、出来れば少し小さめの方がありがたいです）\n服装は原作の服を着用（シチュエーションに合わせて、局部が見えるように半脱ぎにしてしまって大丈夫です）\n\n※娘々と映姫様については、細かい指定は致しません。描きやすいかたちで大丈夫です！\n\n\n【出来れば入れていただきたいもの】\n・男の子の気持ち良さに溺れさせようとする、娘々のセリフ\n・女の子の気持ち良さを思い出させようと必死な、映姫様のセリフ\n・いっぱい気持ち良くされて、トロットロな表情になっている瓔花ちゃん\n・幸せそうな射精差分\n\n\n【出来れば避けていただきたいもの】\n・痛がったり嫌がったり可哀想だったりする描写\n・険悪なムード（おバカっぽい空気の言い争いはOKです！）\n\n\n以上、ご検討いただけますと幸いです。\n長文失礼しました、応援しております！", "created_at": "", "completed_at": ""}, {"path": "/@harusame13/works/148", "thumbnail_src": "https://si.imgix.net/bc1b667a/uploads/origins/4bc74e99-2c59-47c3-921f-bdc7e3e3d6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fffd31be91b6f47428056e10c10340", "thumbnail_srcset": "https://si.imgix.net/bc1b667a/uploads/origins/4bc74e99-2c59-47c3-921f-bdc7e3e3d6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fffd31be91b6f47428056e10c10340, https://si.imgix.net/bc1b667a/uploads/origins/4bc74e99-2c59-47c3-921f-bdc7e3e3d6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5535449206de3abb957c1e0760b5984 2x, https://si.imgix.net/bc1b667a/uploads/origins/4bc74e99-2c59-47c3-921f-bdc7e3e3d6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05cb1f6bb1c197090ff24482a54a16f4 3x", "genre": "art", "nsfw": true, "body": "初めまして！ 全裸で相互手マンで対決するこいしとフランお願いします。・胸の大きさや体格はお互い同じくらいで描いてください  表情 ・相手の手マンがあまり効いてなさそうな感じで多少感じつつも、お互い余裕そうにしている(内心は相手のテクニックの上手さに驚いて焦っている)感じでお願いします ・よろしければ歯を食いしばって睨み合いながら相手の絶頂を催促する、同時絶頂する差分をお願いします ・お互い挑発するセリフがあれば幸いです  ポーズ https://www.pixiv.net/artworks/85478072\n\nhttps://www.pixiv.net/artworks/85478072", "created_at": "", "completed_at": ""}, {"path": "/@harusame13/works/147", "thumbnail_src": "https://si.imgix.net/0ebe953f/uploads/origins/edf5e6ac-7c11-469e-8ffe-f1869ea25a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9e868320fc1be9bd54892f25eaf803", "thumbnail_srcset": "https://si.imgix.net/0ebe953f/uploads/origins/edf5e6ac-7c11-469e-8ffe-f1869ea25a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9e868320fc1be9bd54892f25eaf803, https://si.imgix.net/0ebe953f/uploads/origins/edf5e6ac-7c11-469e-8ffe-f1869ea25a77?bg=%23fff&auto=format%2Ccom