f88b683204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07bcd08e7a0d267b8ff6432273c53033 2x, https://si.imgix.net/512fd454/uploads/origins/cfbb9499-3208-4069-8c11-35f88b683204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6562f8b2351091f20d9d3dbe40022e80 3x", "genre": "art", "nsfw": false, "body": "鍛冶屋ソレイユ様\n初めまして。\n毎回イラストを楽しみに拝見させていただいております。\n\nご依頼したいのはVライバーの壱國メシアさんのファンアートです。\n誰かの救世主になりたい悪魔で、とてもカッコよく可愛らしい方です。\n髪型はロングヘアーでお願いします。\n左目も青くしていただきたいです。\nそれ以外に関しましては全てお任せいたします。\n\nまたファンアートであるため、ご本人様が活動で使う場合があります。\nそのためご本人様にのみ限定でイラストの使用許諾もいただきたいです。\nそのことに関しましてご不安な点がありましたらお断りいただいて大丈夫です。\nhttps://twpf.jp/me0sia27\n上記リンクにご依頼に関する記載がありますので、お手数ですが確認していただけますと幸いです。\n\nまた納品の際、人物などレイヤーを分けていただきたいです。\nご検討よろしくお願いします。\n\n下記にリンクを貼っておきますので、資料として参考にしてください。\nhttps://twitter.com/me0sia27/status/1504007234434453504?s=20&t=Jw7Q_-iKHXzRDu9IDaRhMA\n\nhttps://twitter.com/me0sia27/status/1507753955568234501?s=20&t=gv59o99S2f97997QeLzyog\n\nhttps://twitter.com/me0sia27/status/1549046338775654401?s=20&t=hfySL2KlBfZ5UHcLqaHVBQ", "created_at": "", "completed_at": ""}, {"path": "/@Soleilmtfbwy03/works/20", "thumbnail_src": "https://si.imgix.net/bb2d5636/uploads/origins/3a905f53-64ec-4305-9946-f11602d10cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e550d7a36df35056dca13a7dff2d286", "thumbnail_srcset": "https://si.imgix.net/bb2d5636/uploads/origins/3a905f53-64ec-4305-9946-f11602d10cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e550d7a36df35056dca13a7dff2d286, https://si.imgix.net/bb2d5636/uploads/origins/3a905f53-64ec-4305-9946-f11602d10cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7511099da4778b5c8675b0a7cfba1458 2x, https://si.imgix.net/bb2d5636/uploads/origins/3a905f53-64ec-4305-9946-f11602d10cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0630476aae92da750da56c7c53c4503b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n・ 私の参考資料の中から好きなキャラクターを選んでください\n・ 好きなことをしてください！（ギリギリエロまではOKです）\n・ 背景をお願いします\n・ .clipファイルではレイヤーを分離しておいてください　(.psdもOK)\n\nhttps://drive.google.com/drive/folders/1rngNTNwLzHxK81-PV3HJ5tS9vHGivpcI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Soleilmtfbwy03/works/19", "thumbnail_src": "https://si.imgix.net/89215109/uploads/origins/2ed5ecf1-28ea-4c77-9e71-819bddeb2b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=003a7a7cfa5010643d693b572988b4fb", "thumbnail_srcset": "https://si.imgix.net/89215109/uploads/origins/2ed5ecf1-28ea-4c77-9e71-819bddeb2b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=003a7a7cfa5010643d693b572988b4fb, https://si.imgix.net/89215109/uploads/origins/2ed5ecf1-28ea-4c77-9e71-819bddeb2b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e7bec593b251788a8f2d485ced52ecb 2x, https://si.imgix.net/89215109/uploads/origins/2ed5ecf1-28ea-4c77-9e71-819bddeb2b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c7ced27ec40d92e2c9553e048b1fb7a 3x", "genre": "art", "nsfw": true, "body": "背景から伝わる懐かしさと、ギリギリなフェティッシュが素晴らしい作品ばかりでした。髪や腹筋の質感の細かさと背景の茶系統の色味のバランスが絶妙です。\nまた、白い服装やそのスケ方が素晴らしく、白髪のキャラも鬼の子やさかまたがガツンと来まして、かわいすぎるっ！！ぜひ白髪のキャラ＋白スケ＋秘密基地的な世界を描いてほしいと思いました。\n\nキャラクター：放置少女の星熊童子で、ポニテはJKのような自然な感じに変更。秘密基地の子のような、下半身むっちりで腹筋は結構あり、胸はソレイユさんが違和感ない程度に大きめでお願いします（ソレイユちゃんや「緩い友達に～」の子みたいな、大きいけどお腹やみぞおちの良さを殺さない程度の大きさ）\n\n構図と背景：秘密基地の車内。鼠径部やおなか、乳がだいたい正面で拝める構図。細かいポーズはお任せですが、後述の衣装を強調させたいので、足はある程度開くなどして股が見れるようにお願いします。車内は夏には死ぬほど暑そうで、汗だくな感じです。\nキャラの作画を優先してほしいので、背景は予算の中である程度で構いません\n\n衣装：https://www.pixiv.net/artworks/94271822で描かれている白スケぴっちりスーツがとても良かったので、その雰囲気でhttps://www.pixiv.net/artworks/97572293のようなカットのハイレグでハイネックな白透けスーツをお願いします。乳首の透けはいつもの奴をお願いします！\n\n強く食い込むものの、土手の部分は布地で隠れており、あくまで透けによってギリアウト感を狙いたいです。腹部布地の幅のイメージは前の資料やこちらの資料のイメージですhttps://houti-wiki.com/index.php?%E9%A4%8A%E7%94%B1%E5%9F%BA\n白スケ衣装の上に着用していたであろうショートパンツや短い丈のシャツやジャケットなどおまかせのえち衣装が脱ぎかけだったり各所に配置されてると幸いです。\n\n利用目的はディスコードの公式サイトやTwitterへの掲載による紹介です。お手数ですがNSFW版とセーフ版（局部が透けてない）の差分作成をお願いします。\n\n※星熊童子に左目の下に泣きぼくろを追加してください\n※角の長さが左右で違うことに注意してください\n\n過去の依頼絵があるのでよろしければ参考にどうぞ。\n\nhttps://twitter.com/mokepuu/status/1438166125792022530", "created_at": "", "completed_at": ""}, {"path": "/@Soleilmtfbwy03/works/18", "thumbnail_src": "https://si.imgix.net/68901e1f/uploads/origins/4465eb00-6607-4bc3-991c-53b1e2e6c364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5621ed299dbf3f6e0438fba7c3d70766", "thumbnail_srcset": "https://si.imgix.net/68901e1f/uploads/origins/4465eb00-6607-4bc3-991c-53b1e2e6c364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5621ed299dbf3f6e0438fba7c3d70766, https://si.imgix.net/68901e1f/uploads/origins/4465eb00-6607-4bc3-991c-53b1e2e6c364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51372194feca3d50e9e56315a4f5359b 2x, https://si.imgix.net/68901e1f/uploads/origins/4465eb00-6607-4bc3-991c-53b1e2e6c364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cca166ebbaf6a4cfc1be2c2b0663c3a 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n『女子小学生2人と校長の日常的な一コマ(R18)』\nを依頼させて頂きます。\n\n【キャラクター設定】\n《小学5〜6年生程度の体格の女生徒が2人》\n1人目:清楚風\n髪は腰までの長さ\n垂れ目\n胸は平らだが尻は大きめ\nセーラーワンピースタイプの黒い制服\n下に黒マイクロビキニを着けている\n2人目:メスガキ風\n肩までの長さの髪を二つ結び\n少しツり目\n胸は小学生にしては大きめ\n黒マイクロビキニ\n\n2人とも黒髪かつ頬を染め、行為に積極的な様子\n\n《竿役》\n校長\nでっぷり太ってる\n巨根\n全裸\n\n《シチュエーション》\n校長室のソファに王様座りする校長\n1人目が校長の片膝に跨り巨漢に絡みつき、舌を絡めたキス\n校長に尻を直に揉まれ、スカートが捲れて使用前ゴムが複数挟まったマイクロビキニ姿の下半身が露出。\n同時に2人目は校長の反対側からフェラチオ\nさっきまで校長とセックスをしていたので前髪が汗で張りついており、マイクロビキニは胸の部分のみ。乳首が少し見えている。\n構図的に可能であれば、2人目は頭を撫でられるor胸か尻を揉まれる\nどちらも難しければ、身体のどこかを触られている感じでお願いします。\n\n床にはティッシュや使用済みゴムが散乱し2人目が着ていた制服が畳まれている。\n\n正面からの構図かつ、ビデオで撮っているので2人ともカメラ目線\n金額的に可能なら、RECマークや撮影時間等を示した撮影中の差分もお願いします。\n\n非常に細かくなってしまい、申し訳ありません。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Soleilmtfbwy03/works/17", "thumbnail_src": "https://si.imgix.net/8fb32826/uploads/origins/fcbf8fc5-2e79-46d7-8822-3e4dc02e21d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b089bd99dfcc0cc28d9399116bc74be4", "thumbnail_srcset": "https://si.imgix.net/8fb32826/uploads/origins/fcbf8fc5-2e79-46d7-8822-3e4dc02e21d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b089bd99dfcc0cc28d9399116bc74be4, https://si.imgix.net/8fb32826/uploads/origins/fcbf8fc5-2e79-46d7-8822-3e4dc02e21d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acc0c57fbd1a93408b070490ddaf2f4c 2x, https://si.imgix.net/8fb32826/uploads/origins/fcbf8fc5-2e79-46d7-8822-3e4dc02e21d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2b96be81e194402460f43cb5ef7f66d 3x", "genre": "art", "nsfw": false, "body": "Twitterにて、凄く素敵なイラストをよく拝見させていただいております。\n今回依頼しましたのは、その雰囲気で私がアイコン等に使っている娘を描いていただきたいと思ったからです。\n@jCmF0kmvDF1vOhi\n\n希望と致しましては。\n夏の暑さにうだれながら、仰向けで寝そべるポーズで、何故かスプーンを持っている。\n服は“とりにく”と書かれた白いシャツ一枚、汗で透けている感じ、下はショーツ一枚。\nおへそや、脇が見えている。\n側にカレーが有ったら嬉しいです。\n\nこのような感じで、お願いしたいのですが、いかがでしょうか？\nよろしくお願いします。", "created_at": "", "completed_at": ""}]}