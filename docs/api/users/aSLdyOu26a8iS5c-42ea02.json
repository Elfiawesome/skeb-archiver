b4932a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa2aee15b4de4f27c62adb9ee84b470f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aSLdyOu26a8iS5c/works/206", "thumbnail_src": "https://si.imgix.net/18cd0ba9/uploads/origins/6927c6d2-6775-410e-8162-498fad743857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b7b99780b4aecdb026764c0153b85e5", "thumbnail_srcset": "https://si.imgix.net/18cd0ba9/uploads/origins/6927c6d2-6775-410e-8162-498fad743857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b7b99780b4aecdb026764c0153b85e5, https://si.imgix.net/18cd0ba9/uploads/origins/6927c6d2-6775-410e-8162-498fad743857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b344d981b25b1baad15e44c76d6c08e 2x, https://si.imgix.net/18cd0ba9/uploads/origins/6927c6d2-6775-410e-8162-498fad743857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a1da4ee8d03551352256d865ac1638d 3x", "genre": "art", "nsfw": true, "body": "ひろがるスカイプリキュアのキュアバタフライの蟲姦イラストお願いします。\n\n相手は蝶の雄と雌\nやらされているのではなく自らの意志で蝶の苗床になる。\n子宮内断面図の描写、セリフもお願いします。\n\n①https://skeb.jp/@aSLdyOu26a8iS5c/works/190のイラストみたいにM字開脚でスパッツのおマンコ部を破って自ら指でおマンコを開いており、おマンコはすでにぬれぬれで蝶の産卵を受け入れる準備万端。\nお腹にはすでに大きな蝶が止まっている\n\n②蝶が腹をおマンコに挿入\n\n③子宮の仲間で伸びた産卵管が子宮壁に卵を産み付ける\n\n④子宮内に大量の卵を産み付けられ大きくなるお腹、雌は飛んで消える\n\n④雄の蝶が止まり同じように腹をおマンコに挿入\n\n⑤子宮内に精包を放出\n\n⑥子宮内が精包で埋め尽くされさらに大きくなるお腹\n\n⑦最後に交尾嚢でおマンコを覆われる\n\n⑧すっかり蝶の苗床になったお腹を満足げに撫でる\n\n\n前半雌相手資料\nhttps://www.pixiv.net/artworks/98729908\nhttps://www.pixiv.net/artworks/98730127\n後半雄相手資料\nhttps://www.pixiv.net/artworks/116953781", "created_at": "", "completed_at": ""}, {"path": "/@aSLdyOu26a8iS5c/works/205", "thumbnail_src": "https://si.imgix.net/402cdda8/uploads/origins/97ab6b0f-fefd-4f68-9bd8-a0f0774f199f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c7dfbeb57fe6a13d1991f75c45876dc", "thumbnail_srcset": "https://si.imgix.net/402cdda8/uploads/origins/97ab6b0f-fefd-4f68-9bd8-a0f0774f199f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c7dfbeb57fe6a13d1991f75c45876dc, https://si.imgix.net/402cdda8/uploads/origins/97ab6b0f-fefd-4f68-9bd8-a0f0774f199f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ace795afe50ddf5ac935105af709704 2x, https://si.imgix.net/402cdda8/uploads/origins/97ab6b0f-fefd-4f68-9bd8-a0f0774f199f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=288b7022e7c7f287df5331d6eeb80cdb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aSLdyOu26a8iS5c/works/204", "thumbnail_src": "https://si.imgix.net/453d28ee/uploads/origins/b8ff93d5-aa31-4514-8454-a636de080f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=063525be08d2b5bf7ca7b59113a56360", "thumbnail_srcset": "https://si.imgix.net/453d28ee/uploads/origins/b8ff93d5-aa31-4514-8454-a636de080f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=063525be08d2b5bf7ca7b59113a56360, https://si.imgix.net/453d28ee/uploads/origins/b8ff93d5-aa31-4514-8454-a636de080f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11cd3f5d15d90d5e30788ac4158be4cb 2x, https://si.imgix.net/453d28ee/uploads/origins/b8ff93d5-aa31-4514-8454-a636de080f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c6ea3a1447e682366adb22ca8fc6015 3x", "genre": "art", "nsfw": true, "body": "どうも、天破 蜜柑さん。\n久しぶりの依頼となりますが、以前描いて頂いた横山光輝三国志の村娘を以下の内容でお願いします。\n\n村娘（董卓に牛裂きにされる女キャラ）↓\nhttps://skeb.jp/@aSLdyOu26a8iS5c/works/127\n\n内容:生活費を稼ぐため、兵士たちと乱交SEXする村娘。\n\n1.兵士たちの指示で、ベッドに寝転んで脚を広げる村娘。\n･寝転んだ村娘は下記の画像の様にM字開脚で寝転んだ形で描いて下さい。↓\nhttps://www.pixiv.net/artworks/106426889\n･スカートは下半身が丸見えになる様にめくれた形で、パンツは履いておらずノーパンでお願いします。\n\n2.1の状態から前戯で兵士の1人にペロペロとクンニされる。\n\n3.「ズブリ!!」とチ◯ポを挿入。\n\n4.激しくピストン。\n\n5.更に反対側から仰け反りながらイラマチオされて串刺しファック状態になり、口とマ◯コ両方を激しくピストンされる。\n\n6.絶頂しながら口内射精と中出し。\n\n7.チ◯ポを抜かれ、口内射精された精液を（涙目で吐き出すのを堪えながら）「ゴクン」と飲み込み、マ◯コから精液を垂らす村娘。\n\n8.その後もSEXが続き、7の状態から「ゲホゲホ!!」と口から精液を吐き出し、マ◯コからは大量に精液を放出する村娘。\n･村娘の周りにはSEXに満足した兵士たちが給金として払った金（コイン）が散らばって置かれている猫写を入れて下さい。\n\n以上でよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aSLdyOu26a8iS5c/works/203", "thumbnail_src": "https://si.imgix.net/97dc305a/uploads/origins/cc464b54-4d9a-4da8-a73b-8106432b295a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984b71a0ee1e6ee166c94bde21acfff8", "thumbnail_srcset": "https://si.imgix.net/97dc305a/uploads/origins/cc464b54-4d9a-4da8-a73b-8106432b295a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984b71a0ee1e6ee166c94bde21acfff8, https://si.imgix.net/97dc305a/uploads/origins/cc464b54-4d9a-4da8-a73b-8106432b295a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ee510af73e1b35c42ee9616ac1470dd 2x, https://si.imgix.net/97dc305a/uploads/origins/cc464b54-4d9a-4da8-a73b-8106432b295a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0186f94eb9ab0fdfa95d77152382154 3x", "genre": "art", "nsfw": true, "body": "またリクエストお願いいたします🙇\nヒロアカからお茶子ちゃんの窒息拷問プレイお願いいたします。\n椅子に縛られた状態で情報を聞き出そうとしてるヴィランに鼻を背後からつままれさらに口を大きな手で塞がれ息が限界に近づいたら鼻を豚鼻にして呼吸させる流れを繰り返し豚鼻にされながら涙をし情報をしゃべってしまうシチュエーションでお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@aSLdyOu26a8iS5c/works/202", "thumbnail_src": "https://si.imgix.net/edd4c05e/uploads/origins/51896883-4c19-4c3c-bda4-1e0195145033?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cdeec68a974fbac724de1617697a546", "thumbnail_srcset": "https://si.imgix.net/edd4c05e/uploads/origins/51896883-4c19-4c3c-bda4-1e0195145033?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cdeec68a974fbac724de1617697a546, https://si.imgix.net/edd4c05e/uploads/origins/51896883-4c19-4c3c-bda4-1e0195145033?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a37dc3cef9cf7a9909834b3bfbb9282 2x, https://si.imgix.net/edd4c05e/uploads/origins/51896883-4c19-4c3c-bda4-1e0195145033?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a420f8012d84a09603f999cf564a80d3 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。\n今回もイラストの依頼をしたいのですが、一人目のキャラクターが前回描いていただいたアトムのイプシロン。\nシチュエーションが床に倒れた状態で、放心状態になりながら仰向けに寝転び呻き声を上げてる。\n構図は、全身写るようにお願いします。\n後、ぶっかけや身体に落書き等の差分も可能であれば、宜しくお願いします。\n二人目が、天破さんのオリジナルキャラクターのロストリス。\n此方は全身の立ち絵をお願いします。\n出来れば、新旧のコスチューム差分等あればありがたいです。\nお忙しいと思いますが、何卒宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aSLdyOu26a8iS5c/works/201", "thumbnail_src": "https://si.imgix.net/be22856e/uploads/origins/7f60e5bf-50ac-4c6f-8280-a71dbdefa58f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97e2c67b1c588e550878917951d9221d", "thumbnail_srcset": "https://si.imgix.net/be22856e/uploads/origins/7f60e5bf-50ac-4c6f-8280-a71dbdefa58f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97e2c67b1c588e550878917951d9221d, https://si.imgix.net/be22856e/uploads/origins/7f60e5bf-50ac-4c6f-8280-a71dbdefa58f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1e544b0eff3820a46a9e811a42efe53 2x, https: