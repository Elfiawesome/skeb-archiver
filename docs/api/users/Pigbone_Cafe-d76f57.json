0&txt=PRIVATE&s=56c846001d6eaab9fd998d09a0161607", "thumbnail_srcset": "https://si.imgix.net/3876a88c/uploads/origins/df18bc85-040b-4f94-879d-5b67b7b31b93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56c846001d6eaab9fd998d09a0161607, https://si.imgix.net/3876a88c/uploads/origins/df18bc85-040b-4f94-879d-5b67b7b31b93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=205897a96d53fb97e027701782218d22 2x, https://si.imgix.net/3876a88c/uploads/origins/df18bc85-040b-4f94-879d-5b67b7b31b93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c1232c9043ac15d32d91ff9a2b8bc77 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Pigbone_Cafe/works/19", "thumbnail_src": "https://si.imgix.net/2952dcf0/uploads/origins/cb015875-b849-43de-9d10-441d5e7d3cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba532818f92c52fa162ef8794885805", "thumbnail_srcset": "https://si.imgix.net/2952dcf0/uploads/origins/cb015875-b849-43de-9d10-441d5e7d3cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba532818f92c52fa162ef8794885805, https://si.imgix.net/2952dcf0/uploads/origins/cb015875-b849-43de-9d10-441d5e7d3cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e688dce845e1f6a12fa290575efd8e4 2x, https://si.imgix.net/2952dcf0/uploads/origins/cb015875-b849-43de-9d10-441d5e7d3cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4bf9ba6eba1f889e858fcb8ccef8fc5 3x", "genre": "art", "nsfw": false, "body": "とんペチ先生！こんにちは！！  \n\nアクア(このすば)、志摩リン(ゆるキャン)、山田リョウ(ぼざろ)のスリーショットでご依頼したいです。  \n\n 厚かましいお願いですが可能であれば他作品になるのでこの三人がスリーショットを撮った際こんな反応だろう！みたいな感じでお願いしたいです。曖昧な表現ですいません🙏🙏 \n B2サイズの縦横比で書いていただけるとありがたいです！\n\n お願いします🙇‍♂️", "created_at": "", "completed_at": ""}, {"path": "/@Pigbone_Cafe/works/18", "thumbnail_src": "https://si.imgix.net/e4f81f93/uploads/origins/0280e49e-4408-4706-801c-0f791e5ab5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7eb564e7c98ebd0160809afc24e3895", "thumbnail_srcset": "https://si.imgix.net/e4f81f93/uploads/origins/0280e49e-4408-4706-801c-0f791e5ab5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7eb564e7c98ebd0160809afc24e3895, https://si.imgix.net/e4f81f93/uploads/origins/0280e49e-4408-4706-801c-0f791e5ab5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f0caca6f217023a47b6a97bf92c0bc7 2x, https://si.imgix.net/e4f81f93/uploads/origins/0280e49e-4408-4706-801c-0f791e5ab5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac9e8a71701eedc2563d9258a0d97ecd 3x", "genre": "art", "nsfw": false, "body": "とんペチさんこんにちは！\n私はきらら作品が好きで、とんペチさんのぼっちのイラストをTLで見かけて気になり、pixivも見させていただきました。うごくぼっちが照れながらも表情豊かでとてもかわいくて癒されました。\n\nリクエストはぼざろでもなければきららでもないのですが、私が一番好きなキャラクターである、アニメ『天体のメソッド』のノエルちゃんを描いてほしいです。\n作品やキャラクターをご存じかどうかわかりませんので、ノエルちゃんの簡単な性格(？)を紹介しておきます。すごく元気いっぱいで無邪気な女の子で、年齢は明かされていませんが子どもっぽい容姿や言動がまたかわいい子です。一方で、時には不思議な雰囲気も放つ少女です。\n\n参考URLにノエルちゃんの画像を載せておきます。服装は画像のようないつもの服で、笑顔ではしゃいでいる姿をお願いします。ここでいう「笑顔」とは、普通に瞳が描かれている表情でもいいですし、アニメなどでよくある(^_^)こんな感じの表情でも、ウインクなどでも構いません。とんペチさんの想像する最高の笑顔をいただきたいです。その他細かい部分はお任せします。\n\n過去のイラストを見た限りだと、ぼざろとゆるキャン△がお好きなようですね。今回は別作品のリクエストとなり恐縮ですが、引き受けてくださると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1L_hb3fBgNPSRQJ7uekVEsRiGNcq_ok1_?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Pigbone_Cafe/works/17", "thumbnail_src": "https://si.imgix.net/f77a79ee/uploads/origins/adabcac5-2071-4b9a-b9d1-4a0c5d05a705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb0eb1a4be19f20234e76ceaa6aa5e3", "thumbnail_srcset": "https://si.imgix.net/f77a79ee/uploads/origins/adabcac5-2071-4b9a-b9d1-4a0c5d05a705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb0eb1a4be19f20234e76ceaa6aa5e3, https://si.imgix.net/f77a79ee/uploads/origins/adabcac5-2071-4b9a-b9d1-4a0c5d05a705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beded09fcedf0c63a0124ed28c4103a5 2x, https://si.imgix.net/f77a79ee/uploads/origins/adabcac5-2071-4b9a-b9d1-4a0c5d05a705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f18102a4f0c9fefa86b2fcc28c551dfb 3x", "genre": "art", "nsfw": false, "body": "ぼざろのぼっちちゃんが柔らかそうな手のひらをこしょこしょされて恥ずかしがりながらくすぐったさを堪えちゃう絵をお願いします。\n手のひらをアップでこちらに向けてる構図でお願いします。\nセリフも付けてほしいです。\n\nhttps://twitter.com/pigbone_cafe/status/1717828489439801718", "created_at": "", "completed_at": ""}, {"path": "/@Pigbone_Cafe/works/16", "thumbnail_src": "https://si.imgix.net/6b44043a/uploads/origins/275cfcc5-5701-4903-81ea-59d401aea277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47c81926b419e669ebf2d05c9e352334", "thumbnail_srcset": "https://si.imgix.net/6b44043a/uploads/origins/275cfcc5-5701-4903-81ea-59d401aea277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47c81926b419e669ebf2d05c9e352334, https://si.imgix.net/6b44043a/uploads/origins/275cfcc5-5701-4903-81ea-59d401aea277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50ed88c7d5409aa76e97e833251916e1 2x, https://si.imgix.net/6b44043a/uploads/origins/275cfcc5-5701-4903-81ea-59d401aea277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e2b8e02de19c070b99c31d4e80c7b56 3x", "genre": "art", "nsfw": false, "body": "（相対的に見て）巨人みたいにでっかいぼざろのぼっちちゃんのおっきな手の上に蟻サイズにちっちゃくなった虹夏ちゃん、リョウさん、喜多ちゃん、その他のみんなが乗っかってるイラストをお願いします。\nぼっちちゃんの手のひらが目立つような構図でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Pigbone_Cafe/works/15", "thumbnail_src": "https://si.imgix.