nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mizumi3/works/83", "thumbnail_src": "https://si.imgix.net/12e26b0d/uploads/origins/d8bd7343-c7db-4243-8c7e-74472f878fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f10de96d910676ccbff91c9658b5a5", "thumbnail_srcset": "https://si.imgix.net/12e26b0d/uploads/origins/d8bd7343-c7db-4243-8c7e-74472f878fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f10de96d910676ccbff91c9658b5a5, https://si.imgix.net/12e26b0d/uploads/origins/d8bd7343-c7db-4243-8c7e-74472f878fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e501c6daf20c5beedb107286099607b0 2x, https://si.imgix.net/12e26b0d/uploads/origins/d8bd7343-c7db-4243-8c7e-74472f878fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e42135a13423901cc60aa1864ef990d 3x", "genre": "art", "nsfw": true, "body": "これはリクエストというよりお礼です。\nキリアのイラストを拝見しました。まさに彼女そのもののようで、胸が熱くなりました。\n素晴らしい作品を本当にありがとうございます。\n彼女を大切に想っている者として、心から嬉しく思います。\n特にリクエストはないので、ご自由にどうぞ。", "created_at": "", "completed_at": ""}, {"path": "/@mizumi3/works/82", "thumbnail_src": "https://si.imgix.net/d7fbb645/uploads/origins/3ff499aa-945a-4657-8fa4-ac4ca847c852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd28828880b487bb758f8ce0c33cab5f", "thumbnail_srcset": "https://si.imgix.net/d7fbb645/uploads/origins/3ff499aa-945a-4657-8fa4-ac4ca847c852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd28828880b487bb758f8ce0c33cab5f, https://si.imgix.net/d7fbb645/uploads/origins/3ff499aa-945a-4657-8fa4-ac4ca847c852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&t