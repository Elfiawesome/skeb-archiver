ストをまとめています。元のエンブレムの画像もあります。\nhttps://drive.google.com/file/d/1cKk1giWvgQ6x1OiyDOxlEUVLWYJPGPlA/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mizumi3/works/86", "thumbnail_src": "https://si.imgix.net/c910ae55/uploads/origins/a420e6b5-ff08-41a1-9bbe-67b05873cf95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9173a50cf8ba462e5de107f71fcc2d88", "thumbnail_srcset": "https://si.imgix.net/c910ae55/uploads/origins/a420e6b5-ff08-41a1-9bbe-67b05873cf95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9173a50cf8ba462e5de107f71fcc2d88, https://si.imgix.net/c910ae55/uploads/origins/a420e6b5-ff08-41a1-9bbe-67b05873cf95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f454a736fb95f5109476d8a546d6e1e 2x, https://si.imgix.net/c910ae55/uploads/origins/a420e6b5-ff08-41a1-9bbe-67b05873cf95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cc771c6902c36924e96ce7205d2302f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mizumi3/works/85", "thumbnail_src": "https://si.imgix.net/8dccdc98/uploads/origins/9c7d5d3d-84f7-449d-8108-d8d08e67defc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=526ab3ecee0247e4ac5a538f101005e9", "thumbnail_srcset": "https://si.imgix.net/8dccdc98/uploads/origins/9c7d5d3d-84f7-449d-8108-d8d08e67defc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc