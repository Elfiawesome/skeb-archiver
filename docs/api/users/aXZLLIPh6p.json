30&txt=PRIVATE&s=96297df649f3f655117d88dfbf611cc0 2x, https://si.imgix.net/86e0610e/uploads/origins/51ab5c6f-606e-4b2e-83c3-bfb795768045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=424719a89f4c46386b1c91653472c0f3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/51", "thumbnail_src": "https://si.imgix.net/2dbd538b/uploads/origins/db9774fa-037f-43ba-91cf-ca08eeeab733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89a1e26da1124491b490290f4b6f1168", "thumbnail_srcset": "https://si.imgix.net/2dbd538b/uploads/origins/db9774fa-037f-43ba-91cf-ca08eeeab733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89a1e26da1124491b490290f4b6f1168, https://si.imgix.net/2dbd538b/uploads/origins/db9774fa-037f-43ba-91cf-ca08eeeab733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80075fada2301c572110803ec6ccccf6 2x, https://si.imgix.net/2dbd538b/uploads/origins/db9774fa-037f-43ba-91cf-ca08eeeab733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c0b4c1f76cc9eb8b9a8d12665822da8 3x", "genre": "art", "nsfw": true, "body": "桐本先生はじめまして。\n 突然のリクエスト失礼致します。  \n\n先生作の「私立男の娘学園」の18禁イラストをリクエスト致します。  \n\n3話に出てきた金髪セミロングちゃん(すみません、名前は分かりません)が未登場ですが学園の女教師(♂)に犯されているシーン。  \nシチュエーションは体育倉庫で金髪セミロングちゃん(体操着、ブルマ)が女教師(♂)(スカートスーツ、半裸)にバッグからつかれている。 \n体位、アングルはお任せしますが、二人のお○ん○んやキ○タ○がよく見えると嬉しいです。 \n女教師(♂)はウェーブがかったロングで色っぽい30代ぐらいの美魔女(♂)。\nイメージ的には峰不二子やキャッツアイの泪姐さん(長女)みたいな感じでお願いします。 \n可能であれば漫画的な擬音、喘ぎ声等簡単なセリフ、射精差分があると嬉しいです。 \n各要素は先生のご判断で取捨選択して構いません。  \n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/50", "thumbnail_src": "https://si.imgix.net/dfca30b4/uploads/origins/8028f2a8-1aff-474e-b722-c8a2432b56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de4416a8d4f796e5545e072022c70e3", "thumbnail_srcset": "https://si.imgix.net/dfca30b4/uploads/origins/8028f2a8-1aff-474e-b722-c8a2432b56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de4416a8d4f796e5545e072022c70e3, https://si.imgix.net/dfca30b4/uploads/origins/8028f2a8-1aff-474e-b722-c8a2432b56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f1e3e7ba7f68e53dc43d1e029589f7c 2x, https://si.imgix.net/dfca30b4/uploads/origins/8028f2a8-1aff-474e-b722-c8a2432b56b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=597bea748e34f8088da7a0d0fac013b0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/49", "thumbnail_src": "https://si.imgix.net/922158d7/uploads/origins/97de61ce-b6d0-4a03-ba85-5716f6a15d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b84af37558f2965cd858f560cbbdb5", "thumbnail_srcset": "https://si.imgix.net/922158d7/uploads/origins/97de61ce-b6d0-4a03-ba85-5716f6a15d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b84af37558f2965cd858f560cbbdb5, https://si.imgix.net/922158d7/uploads/origins/97de61ce-b6d0-4a03-ba85-5716f6a15d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acaed51c524eb2628377433459afe7e8 2x, https://si.imgix.net/922158d7/uploads/origins/97de61ce-b6d0-4a03-ba85-5716f6a15d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4a77494c4cec8635abf9f9dbf05a8e0 3x", "genre": "art", "nsfw": true, "body": "おっきいおしりがメインの先導アイチくんのイラストをリクエストします！\n\n抱き枕イラストのような、内股でズボンを下ろし途中で、プリッとなった巨尻を突き出し、横顔でこちらを振り向いた構図。\n正面からの顔のワイプもお願いします！\n\nハート目の興奮状態で舌を出したスケベなアヘ顔で、大きなおしりを手で広げ、尻穴を見せつけてフリフリするアイチ。\n\n差分として\nアナルセックスされてる差分(相手は半透明)アイチくんは強烈で激しいオホ顔\nの差分もお願いします！\n\n以上、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/48", "thumbnail_src": "https://si.imgix.net/2651c6c2/uploads/origins/7c2a72e7-015a-40cf-ab39-24ffa8beaf57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1596e825e1daec7542ac133e44780a09", "thumbnail_srcset": "https://si.imgix.net/2651c6c2/uploads/origins/7c2a72e7-015a-40cf-ab39-24ffa8beaf57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1596e825e1daec7542ac133e44780a09, https://si.imgix.net/2651c6c2/uploads/origins/7c2a72e7-015a-40cf-ab39-24ffa8beaf57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18c531711ec5aab915390a17df0d2208 2x, https://si.imgix.net/2651c6c2/uploads/origins/7c2a72e7-015a-40cf-ab39-24ffa8beaf57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48c1cc5d20d0006cc83379d6888552bd 3x", "genre": "art", "nsfw": true, "body": "桐下さんはじめまして！\n素敵なジョーカーのイラストいつも拝見しております。\nリクエストさせていただきます。\nペル◯ナ5のジョーカーを描いて頂きたいです。\nコスチュームはピンクのハイレグレオタードにピンクのオペラグローブとニーソックスを着用ジョーカーマスクもピンクで。\nジョーカーがハートの予告状を持って街に繰り出しているというシチュエーションです。\nハイレグレオタードには乳首やお臍さらに股間のもっこりまでくっきりと浮き出ていて、マントは羽織っていないのでTバックになっているお尻も丸見えで、ちょっと恥じらいのある表情で描いて頂きたいです。\n注文が多いので、大変でしたり料金的に厳しい場合はキャンセルでかまいませんので、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/47", "thumbnail_src": "https://si.imgix.net/2b8883dd/uploads/origins/a2cef4ee-fb9f-4c2a-970e-765c2f2fcecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35004cc0caa77edbb16240f760d65e89", "thumbnail_srcset": "https://si.imgix.net/2b8883dd/uploads/origins/a2cef4ee-fb9f-4c2a-970e-765c2f2fcecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35004cc0caa77edbb16240f760d65e89, https://si.imgix.net/2b8883dd/uploads/origins/a2cef4ee-fb9f-4c2a-970e-765c2f2fcecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbbd29fd539ef314d714f318f291cf1e 2x, https://si.imgix.net/2b8883dd/uploads/origins/a2cef4ee-fb9f-4c2a-970e-765c2f2fcecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7acb3e6503624e0903d0aa881082bc31 3x", "genre": "art", "nsfw": true, "body": "初めまして！TSモノが好きで、先生の作品をたくさん読みました。中でもTSインモラルがとてもお気に入りです。\n\nそこでなのですが、TSインモラル後編の後、吉田君も眷属になって女体化してしまうというIFストーリーをイラストにしていただけないでしょうか。\n\n構図としては、変化した直後で全裸の自分の体を恥じらいながら触っている女体化した吉田君と、それを見守る田吹先生という感じでお願いします。\n\nお忙しい中とは思いますが、ご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/46", "thumbnail_src": "https://si.imgix.net/dc9df851/uploads/origins/76d90524-338a-44dc-b770-446bb35877e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6c584720dd803ddffb7b0d58aeb0ce0", "thumbnail_srcset": "https://si.imgix.net/dc9df851/uploads/origins/76d90524-338a-44dc-b770-446bb35877e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6c584720dd803ddffb7b0d58aeb0ce0, https://si.imgix.net/dc9df851/uploads/origins/76d90524-338a-44dc-b770-446bb35877e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df4e81a4cd57ee5ade9fd95ab22a3596 2x, https://si.imgix.net/dc9df851/uploads/origins/76d90524-338a-44dc-b770-446bb35877e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5db16d649152547e3718767d30dca52e 3x", "genre": "art", "nsfw": true, "body": "FGOのキャプテンネモがFGO主人公♂に犯されているシーンをお願いします。\nシチュエーションは相思相愛な感じです。\n体位等はお任せします。\n検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/45", "thumbnail_src": "https://si.imgix.net/5d7febd6/uploads/origins/3158e0b5-fe55-46e3-bfe4-e099d920bfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aef82997470e5d61c846cb3753d1acf", "thumbnail_srcset": "https://si.imgix.net/5d7febd6/uploads/origins/3158e0b5-fe55-46e3-bfe4-e099d920bfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aef82997470e5d61c846cb3753d1acf, https://si.imgix.net/5d7febd6/uploads/origins/3158e0b5-fe55-46e3-bfe4-e099d920bfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3a704de9bfbc3c4f9aa3c71029f8443 2x, https://si.imgix.net/5d7febd6/uploads/origins/3158e0b5-fe55-46e3-bfe4-e099d920bfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8c7ab3d33a397915b2dd8417e5b262e 3x", "genre": "art", "nsfw": true, "body": "いつも作品楽しませていただいております。 アイマスSideMの秋月涼が、橘志狼にプロレスでギロチンチョークをかけられ負けているイラストをカラーで1シーン御願いします。\n涼：Dearly Starsの女装時代のピンク色コスをイメージした女物のレスリングコス。上下セパレートで少し腹筋見えている感じ。画面左で正面向き膝立ちの状態。相手の右腕で、首回りにギロチンチョークをかけられている。両腕は相手の腕を掴み必死に抵抗している。失神寸前の苦悶の表情。苦しいのに興奮しているのか勃起している状態。\n志狼：米国星条旗カラーのビキニパンツで、画面右で正面向き立ちの状態。右腕で涼にギロチンチョークをかけている。サディスティックで勝ち気な表情を涼に向けている。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/44", "thumbnail_src": "https://si.imgix.net/7d6dcabd/uploads/origins/166d8180-fe4f-4160-a7bc-3d165ac9a954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a04f8594ba29f70ccf7cde230481830", "thumbnail_srcset": "https://si.imgix.net/7d6dcabd/uploads/origins/166d8180-fe4f-4160-a7bc-3d165ac9a954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a04f8594ba29f70ccf7cde230481830, https://si.imgix.net/7d6dcabd/uploads/origins/166d8180-fe4f-4160-a7bc-3d165ac9a954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8f59cb16132657b017a456dceaa6db9 2x, https://si.imgix.net/7d6dcabd/uploads/origins/166d8180-fe4f-4160-a7bc-3d165ac9a954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c00e8d5b402d4f1c7d01b3818f8ae7a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nあなたの絵が大好きで、私と友達のキャラクターを一緒にイラストにしてもらえたらと思いました。\nリリーです。\nhttps://imgur.com/a/sp0NVsX\nアメリア\nhttps://imgur.com/a/luRWSDJ\n\nアメリアがリリーの中に射精している間、二人とも大好きなのでとても楽しそうな表情をしている、こんなポーズが欲しいです。\nhttps://imgur.com/a/z41KCLQ\n\n私の要望を聞いていただきありがとうございます！これで大丈夫でしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/43", "thumbnail_src": "https://si.imgix.net/6b5d1b79/uploads/origins/bad36a09-5fed-4faa-921f-bd2fc761e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=965d7898923658250762770cdc614075", "thumbnail_srcset": "https://si.imgix.net/6b5d1b79/uploads/origins/bad36a09-5fed-4faa-921f-bd2fc761e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=965d7898923658250762770cdc614075, https://si.imgix.net/6b5d1b79/uploads/origins/bad36a09-5fed-4faa-921f-bd2fc761e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42e7a62a0482ecc14e5217c25fb78cd9 2x, https://si.imgix.net/6b5d1b79/uploads/origins/bad36a09-5fed-4faa-921f-bd2fc761e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a7e6edc29ed411fb1f3449ecfa7ef4d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/42", "thumbnail_src": "https://si.imgix.net/5152a4a3/uploads/origins/b0697d9a-21bd-4ebb-836d-4d90f90382b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d310ac56d02a2b6739a0c01bf06f42ff", "thumbnail_srcset": "https://si.imgix.net/5152a4a3/uploads/origins/b0697d9a-21bd-4ebb-836d-4d90f90382b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d310ac56d02a2b6739a0c01bf06f42ff, https://si.imgix.net/5152a4a3/uploads/origins/b0697d9a-21bd-4ebb-836d-4d90f90382b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3db539a65e6ca7c26805bd2a578dd2c3 2x, https://si.imgix.net/5152a4a3/uploads/origins/b0697d9a-21bd-4ebb-836d-4d90f90382b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6da9c54d8ed56e3a188c18a64bd0c83f 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nまじめそうな美青年の男の子が\n女子の陸上部ウェアとブルマーを穿いて\nえちい蹲踞ポーズでピースしている\nイラストをお願いできませんか？\n\n黒髪で20代半ばから後半ぐらいの\n男子。まじめそう。童貞。\n女子陸上部のウエアとブルマーで女装している。\nえちいがに股蹲踞で座り、\n勃起して膨らんだブルマーを見せつけています。\n膨らんだ先端からは汁が出て、シミになっています。\n\n上半身のウエアはピチピチで\nメス化して大きなぷっくり陥没乳首乳輪が\n浮き出てます。\n\n苦笑いしつつ興奮して\nこちらにむかってピースポーズ。\n\n出来ましたら\n裸のバージョンももらえますとうれしいです。\nそのときは表情アへっていて\nおちんちんは\n小さめ包茎だとうれしいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/41", "thumbnail_src": "https://si.imgix.net/32b832ce/uploads/origins/6ed5565c-fac5-4d2d-b817-961238e26d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ef9ff6c28f2c39064ff8b1d508566dd", "thumbnail_srcset": "https://si.imgix.net/32b832ce/uploads/origins/6ed5565c-fac5-4d2d-b817-961238e26d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ef9ff6c28f2c39064ff8b1d508566dd, https://si.imgix.net/32b832ce/uploads/origins/6ed5565c-fac5-4d2d-b817-961238e26d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1305c6f0aac7bc9f3646194755911070 2x, https://si.imgix.net/32b832ce/uploads/origins/6ed5565c-fac5-4d2d-b817-961238e26d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10724eaa447e8a2ea7d4a69679c72140 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私と妻のキャラクターを一緒に描いていただけませんか？私のキャラクターは、ピンクの髪のキャットガール（エリー）が上になり、後ろから黒髪のキャットガール（リズ）を取ります。エリーはフタナリで、平均的な大きさのペニスとボールを持っています。私が求めているポーズのタイプは、リファレンスフォルダに含まれています。エリーの表情はリファレンスとほぼ同じで、ハートの瞳孔を持ち、リズの脇腹を掴みながら、本当に楽しんでいるのでヨダレを垂らして苦笑いを浮かべているような表情にしたいです。リズの表情は下のキャラクターに合わせて、顔はほとんどシーツの中に入っていて、シーツを握りしめ、赤面して涙目になっています。二人とも服はありませんが、リズには無理のない範囲でここに黒いストッキングを履かせたいと思います。また、参考資料のように、ハートやサインを入れるかどうかはあなた次第です。以上、私のリクエストを聞いていただければ幸いです。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1sSVA7kN8OtRH5TnB36uPxEcQ0JfZi6OE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/40", "thumbnail_src": "https://si.imgix.net/09812d63/uploads/origins/f599243a-dc46-40eb-8c0e-abbdea4de589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd700bb87460da0b39cc3c07c7b9465e", "thumbnail_srcset": "https://si.imgix.net/09812d63/uploads/origins/f599243a-dc46-40eb-8c0e-abbdea4de589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd700bb87460da0b39cc3c07c7b9465e, https://si.imgix.net/09812d63/uploads/origins/f599243a-dc46-40eb-8c0e-abbdea4de589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d483116d6b15bdb88c2e509434e2592 2x, https://si.imgix.net/09812d63/uploads/origins/f599243a-dc46-40eb-8c0e-abbdea4de589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c39b01b7d9e5a91ce0f5f8ef376d488 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/39", "thumbnail_src": "https://si.imgix.net/6d45dc29/uploads/origins/81b847b1-58aa-4712-bdf6-a5c42a7be7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c249096568f8e297ccdc0b88db23f36f", "thumbnail_srcset": "https://si.imgix.net/6d45dc29/uploads/origins/81b847b1-58aa-4712-bdf6-a5c42a7be7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c249096568f8e297ccdc0b88db23f36f, https://si.imgix.net/6d45dc29/uploads/origins/81b847b1-58aa-4712-bdf6-a5c42a7be7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73a8d0988eed1445e98de086a260c1bd 2x, https://si.imgix.net/6d45dc29/uploads/origins/81b847b1-58aa-4712-bdf6-a5c42a7be7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96d255aa21e1679e6ee688152f416da9 3x", "genre": "art", "nsfw": true, "body": "このようなキャラクターを描いてみたいという方のみご応募ください。\n\nhttps://www.dropbox.com/sh/ghuo3jkakdz2vay/AAD7gKt2bcVU7UDKON1otRMpa?dl=0\n\n絵の内容は、彼女があなたの選んだ男の子のお尻を激しく犯すというものです。沢山の精液が出るようにしてください。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/38", "thumbnail_src": "https://si.imgix.net/b4d3183f/uploads/origins/a787e65c-ffe0-481d-ac71-e0ce736eff65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd96ec1c00c04060879773d7f0dbb8a", "thumbnail_srcset": "https://si.imgix.net/b4d3183f/uploads/origins/a787e65c-ffe0-481d-ac71-e0ce736eff65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd96ec1c00c04060879773d7f0dbb8a, https://si.imgix.net/b4d3183f/uploads/origins/a787e65c-ffe0-481d-ac71-e0ce736eff65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb20329e33249e02ad17ee154d235dc5 2x, https://si.imgix.net/b4d3183f/uploads/origins/a787e65c-ffe0-481d-ac71-e0ce736eff65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20b015dc2f7efe25d36af675a693e2fe 3x", "genre": "art", "nsfw": true, "body": "前回描いていただいたイラストが大変素晴らしく、是非ともリピート依頼をさせていただければと思います。今回はシーメール×ショタのイラストとなります。（シーメールはニューハーフを言い換えただけなので、特に違いを意識していただく必要はありません）\n\n攻め役のシーメールは基本的に前回のデザインを踏襲していただきつつ、髪型をハネ気味でショートのウルフカットにしてください。受け役の少年は、下記の依頼で描かれているようなイメージで、日焼けはしてない形でお願いします。\nhttps://skeb.jp/@aXZLLIPh6p/works/1\n\n体位及び構図、双方の体格差については、3Dモデルでのイメージを資料URLに添付いたしましたので、そちらを参考にお願いいたします。あくまでイメージなので、適宜調整・アレンジしていただければと思いますが、シーメールの身体の前面部分はできるだけ見える状態を維持していただけるとありがたいです。\n\nシーメールの陰茎については前回根元側の半分弱が外に見えてる状況で、中に入っている部分についてはいわゆる断面図的な形で描写をお願いいたします。\n\nご検討いただけると幸いです。よろしくお願いします。\n\nhttps://imgur.com/a/wmzWU1p", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/37", "thumbnail_src": "https://si.imgix.net/20576d93/uploads/origins/430c631d-7f18-4af2-9759-61a0c32eff53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=397f1e1720d7742be9ec9607c947af07", "thumbnail_srcset": "https://si.imgix.net/20576d93/uploads/origins/430c631d-7f18-4af2-9759-61a0c32eff53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=397f1e1720d7742be9ec9607c947af07, https://si.imgix.net/20576d93/uploads/origins/430c631d-7f18-4af2-9759-61a0c32eff53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f629da6cef71bb3cd72cbe7ef2fa81c2 2x, https://si.imgix.net/20576d93/uploads/origins/430c631d-7f18-4af2-9759-61a0c32eff53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=386abcd35d46d296087fa4cf31ec1866 3x", "genre": "art", "nsfw": true, "body": "初めまして。リクエストをお願いします。\n聖闘士星矢の星矢と瞬の格闘シーンでお願いします。\n二人とも衣装は普段着の、瞬はアニメ版の緑のシャツにサスペンダー、白のパンツ、星矢は赤のシャツに白のパンツでお願いします。\n星矢の首に瞬の鎖が巻き付いていて、鎖を持っている瞬が星矢のボディにパンチかキックを決めた瞬間でお願いします。\nダメージ表現としては二人とも顔はわずかに傷がある程度、星矢の口の端から少量の血が出ている程度、星矢の口からやや多めの唾液が飛び散っている感じでお願いします。\n瞬の表情は優勢だけどあまり余裕がない感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/36", "thumbnail_src": "https://si.imgix.net/9bf547b1/uploads/origins/1b3ec454-d580-4798-a08a-508b1b88151c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8280c5ec865eeedfdc150c79c2dc5acc", "thumbnail_srcset": "https://si.imgix.net/9bf547b1/uploads/origins/1b3ec454-d580-4798-a08a-508b1b88151c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8280c5ec865eeedfdc150c79c2dc5acc, https://si.imgix.net/9bf547b1/uploads/origins/1b3ec454-d580-4798-a08a-508b1b88151c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9d20ba837142da5023d5ce06b93734c 2x, https://si.imgix.net/9bf547b1/uploads/origins/1b3ec454-d580-4798-a08a-508b1b88151c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74f36adf3f678ed2db2046d9332ccdb 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ビフォーアフターのスタイル画像をお願いしたいのですが。\n\n左側は鏡の前でポーズをとっているフェミニンな男の子です。\n\n右はJKニューハーフになって数年後の同一人物。制服を着ていて、胸が大きい。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/35", "thumbnail_src": "https://si.imgix.net/b42be523/uploads/origins/b4be0a90-17ad-4403-a43c-03193552794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4af67891e553d486b8bc292656252317", "thumbnail_srcset": "https://si.imgix.net/b42be523/uploads/origins/b4be0a90-17ad-4403-a43c-03193552794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4af67891e553d486b8bc292656252317, https://si.imgix.net/b42be523/uploads/origins/b4be0a90-17ad-4403-a43c-03193552794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcabf09bdd13031a4dcd161a0900c33f 2x, https://si.imgix.net/b42be523/uploads/origins/b4be0a90-17ad-4403-a43c-03193552794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f32ff19cc55d5c69fde7f0f2af9d9c5 3x", "genre": "art", "nsfw": true, "body": "以前\nhttps://skeb.jp/@aXZLLIPh6p/works/22　でお願いさせていただいた者です。\nその節はありがとうございました！\n「塔矢アキラがチアガールのコスプレ」のイラストも大好きでして今回はそのポーズでお願いさせて下さい。\n・キャラは前回と同じくセーラーヴィーナス女装した美青年\n・https://skeb.jp/@aXZLLIPh6p/works/15　のポーズで両手はダブルピース、表情も同じ感じ\n・包茎ペニス＋少しの陰毛\n・（可能であれば）そのポーズのまま射精＋アヘ顔差分\nでお願いできますでしょうか　よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/34", "thumbnail_src": "https://si.imgix.net/755c24bd/uploads/origins/35d22116-231a-4ef3-b317-0606fb5f2562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4737e75873b32a22b6e578887bf5a36f", "thumbnail_srcset": "https://si.imgix.net/755c24bd/uploads/origins/35d22116-231a-4ef3-b317-0606fb5f2562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4737e75873b32a22b6e578887bf5a36f, https://si.imgix.net/755c24bd/uploads/origins/35d22116-231a-4ef3-b317-0606fb5f2562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa5b494bd7211be48e2ff2089488da6f 2x, https://si.imgix.net/755c24bd/uploads/origins/35d22116-231a-4ef3-b317-0606fb5f2562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e9974d2cbf6502e2f62d8234ae6d888 3x", "genre": "art", "nsfw": true, "body": "金髪黒ギャル風ニューハーフ×清楚お嬢様風男の娘をリクエストします。\n\nニューハーフは、男の娘学園の四条くんのようなイケメンを、ちょっとSっぽくした顔。\n体格は190cm程度の高身長で骨格と肉付きはスリムながらも男性的、腹筋がうっすら割れるなどやや筋肉質。\n男性器はニューハーフの前腕部程度の長さで、太さや玉も体格と比べても質量感、重量感があって、\n男の娘には半分程度しか収まらないようなサイズ感をイメージしています。\n\n男の娘は、ツインテールの可愛らしい感じで、体格は140cmのショタ体型、\nまだ未発達で剥けてない男性器でお願いします。\n\n構図、体位などはお任せしますが、両方とも全裸で、体格差を活かして、シーメールが力任せに\n男の娘にメスを覚えさせるようなそんな体位と構図だと非常にありがたいです。\nまた中に押し込まれているニューハーフの巨根が透過されて見える描写を希望します。\n\n色々と注文が多くて申し訳ありませんが、お受けいただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@aXZLLIPh6p/works/33", "thumbnail_src": "https://si.imgix.net/578edf7d/uploads/origins/c9a2ea46-b19f-4163-83bd-7140ecaa2a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1381e18e8a30fe45f5b9409e65be55e", "thumbnail_srcset": "https://si.imgix.net/578edf7d/uploads/origins/c9a2ea46-b19f-4163-83bd-7140ecaa2a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1381e18e8a30fe45f5b9409e65be55e, https://si.imgix.net/578edf7d/uploads/origins/c9a2ea46-b19f-4163-83bd-7140ecaa2a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=818c5f4722efe542a90328a22ad24bf7 2x, https://si.imgix.net/578edf7d/uploads/origins/c9a2ea46-b19f-4163-83bd-7140ecaa2a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f0defe8bb100e3dc6cb5fda5b931ce6 3x", "genre": "art", "nsfw": true, "body": "サキュバスは戦闘でジョーカーを倒した。サキュバスは大きなペニスと睾丸を持ってジョーカーとファックしています。パンサーは衣装を着てマスクをしてオナニーをしながら、サキュバスがジョーカーとヤッているのを見ています。パンサーもペニスを持っている。\n\nジョーカーはペニスと睾丸が非常に小さくて「役に立たない」。\n\nhttps://i.imgur.com/iBvlfoN.jpg", "created_at": "", "completed_at": ""}]}