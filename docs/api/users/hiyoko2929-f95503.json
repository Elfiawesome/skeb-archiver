0d-39d63dfeb36a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a13172267d051971b41ae67bd06e732", "thumbnail_srcset": "https://si.imgix.net/6a5ff315/uploads/origins/7d7d0c0e-7f28-4c2f-960d-39d63dfeb36a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a13172267d051971b41ae67bd06e732, https://si.imgix.net/6a5ff315/uploads/origins/7d7d0c0e-7f28-4c2f-960d-39d63dfeb36a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15037d088fb0032518fc0763ef0e553c 2x, https://si.imgix.net/6a5ff315/uploads/origins/7d7d0c0e-7f28-4c2f-960d-39d63dfeb36a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e25e3a66bb5cb583c0cdc3c19bbf7f70 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が本当に大好きです！\n僕のキャラクター、サイケンを描いてほしいんだ。\n彼はクールで自信に満ち溢れた若い医者で、学生の指導をしたり、患者の世話をするのが好きです。長い一日を終えて、診察室の椅子にもたれている彼を描いてほしい！久しぶりにほっと一息ついているような、とても疲れたリラックスした表情で！\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/12BI5mm52a1w09_xcVU0vhfHIvVczNe94?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hiyoko2929/works/5", "thumbnail_src": "https://si.imgix.net/bc8c713f/uploads/origins/fd5f5101-1148-4944-8d92-ff3b6eef0396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad829291d83eefe8b9a36d8c99217c89", "thumbnail_srcset": "https://si.imgix.net/bc8c713f/uploads/origins/fd5f5101-1148-4944-8d92-ff3b6eef0396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad829291d83eefe8b9a36d8c99217c89, https://si.imgix.net/bc8c713f/uploads/origins/fd5f5101-1148-4944-8d92-ff3b6eef0396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba40596019fb84f516ffeb8785d8b865 2x, https://si.imgix.net/bc8c713f/uploads/origins/fd5f5101-1148-4944-8d92-ff3b6eef0396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=029d8d2c6f85b0683265e47347ef5243 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵はとてもかわいいと思うので、私のOC、ユエルの作品をあなたのスタイルで描いてほしいです。\n\nユエルは不機嫌なツンデレです。冷静でまじめに振る舞おうとしているが、短気で、すぐに照れたり慌てたりする。本を読むこととお菓子を食べることが好き。フェミニンな服装が苦手だが、彼氏に強引に誘われることも。\n\n参考画像はこちら：\nhttps://drive.google.com/drive/folders/1WBga2HYhR4EMRU5An-u5o3j4Qj5hHMeu?usp=sharing\n\nどんな服装でも、どんなポーズでも、どんな表情でも、自由に描いてください。\n\nあなたのスタイルで彼がどう見えるか見てみたいだけです。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@hiyoko2929/works/4", "thumbnail_src": "https://si.imgix.net/15cfc56c/uploads/origins/b1acb693-d0dd-4139-a07d-bac02a8277a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b5e52dede4b57fc5580053e355c9f32", "thumbnail_srcset": "https://si.imgix.net/15cfc56c/uploads/origins/b1acb693-d0dd-4139-a07d-bac02a8277a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b5e52dede4b57fc5580053e355c9f32, https://si.imgix.net/15cfc56c/uploads/origins/b1acb693-d0dd-4139-a07d-bac02a8277a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a333cbb2988ca801bf6a77a16fc031d7 2x, https://si.imgix.net/15cfc56c/uploads/origins/b1acb693-d0dd-4139-a07d-bac02a8277a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbe7ebb7a2877e54ac4cf1beeb6ffd6f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hiyoko2929/works/3", "thumbnail_src": "https://si.imgix.net/fd49a510/uploads/origins/732241a7-22dd-4635-aa2e-ddbfb22df171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=546825168e4ed04620e40ca865bf9b83", "thumbnail_srcset": "https://si.imgix.net/fd49a510/uploads/origins/732241a7-22dd-4635-aa2e-ddbf