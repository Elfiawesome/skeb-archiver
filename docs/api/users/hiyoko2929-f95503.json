です。\n\n以下キャラクターの特徴になります。\n・黒縁メガネ\n・色素の薄い髪、高身長\n・喫煙者\n・黒や紺の、ラフな服を着ている\n・気だるげ、面倒見は良い方\n・25歳くらい\n\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1sk7shHj7DX5-ggvJlrq_CXGeYJP2oMYg", "created_at": "", "completed_at": ""}, {"path": "/@hiyoko2929/works/1", "thumbnail_src": "https://si.imgix.net/c5e1de8d/uploads/origins/3daffa81-29c8-42f1-b2f5-c2d9e742c299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dd2975e26ab7afbea7f7caa60625c20", "thumbnail_srcset": "https://si.imgix.net/c5e1de8d/uploads/origins/3daffa81-29c8-42f1-b2f5-c2d9e742c299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dd2975e26ab7afbea7f7caa60625c20, https://si.imgix.net/c5e1de8d/uploads/origins/3daffa81-29c8-42f1-b2f5-c2d9e742c299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b01d66ba7d3762def007bc880383609 2x, https://si.imgix.net/c5e1de8d/uploads/origins/3daffa81-29c8-42f1-b2f5-c2d9e742c299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc4c8add884e3343ddb607b074a3f0a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}