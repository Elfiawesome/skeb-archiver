b0c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7beb921ae0a3086f5e7acc0ad5bf9a0d, https://si.imgix.net/e0ee6ccb/uploads/origins/d2ccc168-6f16-4442-8ac5-653e742b0c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d44aaad8608a94fa0f06137cd622d0c 2x, https://si.imgix.net/e0ee6ccb/uploads/origins/d2ccc168-6f16-4442-8ac5-653e742b0c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3d0524ee1c6bfc6fe4ce9abc0c50cff 3x", "genre": "art", "nsfw": false, "body": "Vtuber活動をしています、竜姫エナと申します。\n絵柄がとても可愛くて依頼させていただきます！\nTwitterやサムネに使用するイラストをお願いしたいです。\nポーズはうつ伏せで枕の下に手を入れ枕に頭を乗せている感じ。足は上に向かって折り曲げて、アンニュイな表情で。\nルームウェアぽい服装かなと思いますが\n絵師様のイメージで好きなように描いていただければ嬉しいです。\nYoutubeのサムネにも使用したいので\n出来たらメッセージとイラストのレイヤーを別でいただけると助かります。\n資料はこちらの固定ツイからお願いします。ケモ耳の方のモデルのイラストをお願いします。\nhttps://twitter.com/enachamnel/status/1542797654404435968?s=21&t=d0250oZ8W6sTDmM7PwHUYw", "created_at": "", "completed_at": ""}, {"path": "/@ow0d01/works/16", "thumbnail_src": "https://si.imgix.net/998dcd01/uploads/origins/f926ed07-ffc2-4cf1-9d7a-4a61249244ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea2c71aa42b78867b402883432e7dee", "thumbnail_srcset": "https://si.imgix.net/998dcd01/uploads/origins/f926ed07-ffc2-4cf1-9d7a-4a61249244ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea2c71aa42b78867b402883432e7dee, https://si.imgix.net/998dcd01/uploads/origins/f926ed07-ffc2-4cf1-9d7a-4a61249244ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=067e2bb3e36bf6adafeb1eae9970db47 2x, https://si.imgix.net/998dcd01/uploads/origins/f926ed07-ffc2-4cf1-9d7a-4a61249244ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efb7962592d9125a0742da06c9bbc7b7 3x", "genre": "art", "nsfw": false, "body": "はじめまして。個人Vtuber沙月りりかと申します。\n\nしぽん様のイラストをTwitterで拝見し、\nとっても可愛い絵柄としぽん様が描くお洋服の可愛さに惹かれ\nぜひ沙月りりかを描いていただきたいと思いリクエストいたしました。\n\n\n■沙月りりか\n九尾の狐。貴族のお嬢様。\n\n■希望シチュエーション\n透明感がある雰囲気に、ちょっぴりセクシーさがあると嬉しいです。\n服装はベビードールなどのランジェリーでお願いします。\nアクセサリー、髪型など、自由にアレンジいただいて問題ございません。\n背景や構図もお任せいたします。\n\n■参考資料\nお手数ですが固定ツイートに立ち絵、ツリーに三面図の記載がございます。\n(特徴→オーロラ色にキラキラと反射する白髪、狐耳なので人間の耳はございません。\n尻尾は九本ありますが、公式設定で一本にもできますので一本でも構いません。)\nよろしくお願いいたします。\nhttps://twitter.com/SatsukiLilica/status/1474707024000987136?s=20&t=5GJ1HosHHHTJoncPdTTE7A\n\n■使用範囲\n沙月りりかの活動に関するもの\nYoutubeサムネイル、TwitterやFANBOX等のSNSなど\nプロモーションを中心に大切に使わせていただきます。\n\n■レイヤーについて\n可能であれば宛名なしと人物のみの透過レイヤーもいただけると\nサムネイルなどでの使用の自由度があがりとても助かります。\n\n\nしぽん様の沙月りりかを見れたらとても嬉しいです。\n\nお忙しいところ恐縮ですが\nご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@ow0d01/works/15", "thumbnail_src": "https://si.imgix.net/992410c1/uploads/origins/656d1d90-4bda-49dc-8cec-6ecbc4688bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc3afe3702754eaeaca38209511bafe6", "thumbnail_srcset": "https://si.imgix.net/992410c1/uploads/origins/656d1d90-4bda-49dc-8cec-6ecbc4688bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc3afe3702754eaeaca38209511bafe6, https://si.imgix.net/992410c1/uploads/origins/656d1d90-4bda-49dc-8cec-6ecbc4688bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=742b1e2bf99f94ec340f1c0b084c6323 2x, https://si.imgix.net/992410c1/uploads/origins/656d1d90-4bda-49dc-8cec-6ecbc4688bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=554e4794c4d25538dedb4a570d469711 3x", "genre": "art", "nsfw": false, "body": "しぽんさん、お世話になっております。\n個人VTuberの宝珠るらです。\nしぽんさんの透明感のある儚いイラストが大好きで\nぜひ「宝珠るら」のイラストを描いていただきたいです！！\n\nテーマなど、全てお任せいたします。\n普段から様々な洋服を着ておりますので\n衣装も、ベーシックな宝珠るらの衣装から\n自由なデザインされたものまで、なんでも問題ありません。\n装飾類（アクセなど含む）も自由にしていただければと思います！\n\n使用範囲は\n宝珠るらにかかわるPR（SNSでの投稿や動画のサムネイルなど）全般で\nグッズ利用はいたしません。\n\nもし可能であればPSDでいただく際に\n人物のみレイヤーもいただけると\nサムネイルなどで使用しやすく、ありがたいです。\n\n何卒ご検討よろしくお願いいたします！！\nずっとご相談したいとおもっていたので\nSkeb開放ありがとうございます！！\n\nhttps://twitter.com/hojurura/status/1519535006762160128?s=20&t=h-TCEJAPa