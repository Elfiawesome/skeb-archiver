598-193f-4474-9b96-730449001a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16cdf95adc14da8be7e238da46c0d522 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰してます！\n前回は小悪魔エラちゃんを描いて頂いてありがとうございました。\n\n今回はエラちゃんをSDで描いて頂けないでしょうか？\nエルブン乳業でカウガール衣装を着てアルバイトをしている天空のエラをSDでお願いします。\nその他諸々に関しては全てお任せいたします。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sw_scout/works/6", "thumbnail_src": "https://si.imgix.net/c4a7ea47/uploads/origins/481b37df-00c5-4962-b1af-e54a985fde92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69e53afd81e0e7523b8620e333cdd750", "thumbnail_srcset": "https://si.imgix.net/c4a7ea47/uploads/origins/481b37df-00c5-4962-b1af-e54a985fde92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69e53afd81e0e7523b8620e333cdd750, https://si.imgix.net/c4a7ea47/uploads/origins/481b37df-00c5-4962-b1af-e54a985fde92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=301f57f6345b8748f0f0b944eda7f1ac 2x, https://si.imgix.net/c4a7ea47/uploads/origins/481b37df-00c5-4962-b1af-e54a985fde92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34d696a991ce98982fed633e7a61fd64 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sw_scout/works/5", "thumbnail_src": "https://si.imgix.net/d821e88f/uploads/origins/25483699-e7b3-4ccd-98bf-a9627b803a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47e81ab179d2155a58d033a0f26e450d", "thumbnail_srcset": "https://si.imgix.net/d821e88f/uploads/origi