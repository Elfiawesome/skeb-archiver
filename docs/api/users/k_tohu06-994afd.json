center&txtsize=30&txt=PRIVATE&s=380508b53bcc2d3ea8c5b3f86f5edf05 2x, https://si.imgix.net/e3fdf04f/uploads/origins/62ff246a-71b4-43db-868e-7bfe20a6d618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c26f3684d7f3e9563010484a60aeda43 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@k_tohu06/works/31", "thumbnail_src": "https://si.imgix.net/42830750/uploads/origins/f4d270e7-b438-4754-b265-0d499579fd95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccc4fc37b088aec4d47b71eaeaeb8f56", "thumbnail_srcset": "https://si.imgix.net/42830750/uploads/origins/f4d270e7-b438-4754-b265-0d499579fd95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccc4fc37b088aec4d47b71eaeaeb8f56, https://si.imgix.net/42830750/uploads/origins/f4d270e7-b438-4754-b265-0d499579fd95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05e360fe5d0d26e193f465e722a569ba 2x, https://si.imgix.net/42830750/uploads/origins/f4d270e7-b438-4754-b265-0d499579fd95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6175b09bb60baf6257c0a4dde0c2d216 3x", "genre": "art", "nsfw": false, "body": "るどさん、はじめまして！」。\n\nあなたのグループイラストが大好きで、以前からお願いしたいと思っていたのですが...！\n\n私のキャラクターたちのハロウィンをテーマにした集合イラストを描いていただけませんか？ハロウィンのコスチュームは描いたことがあるので、参考資料にあります。そのコスチュームで描いていただけると嬉しいです！もし必要なら、個別の参考資料もあります。\n\n登場人物はバンドマンなので、ポスターのような構図だと嬉しいです。それは面白いと思います。楽器を入れる必要はありません。衣装は自分の解釈で少しずつ変えていけばいい。\n\n登場人物の簡単な情報です：\n\nCH1 - ONI\n人間ではないかもしれない謎の仮面の人物。喋らないがギターを弾く。マスクの目が変化して感情を表す。見た目は怖いが、実は気さくでイタズラが好き。\nハロウィンの仮装はジャック・オー・ランタン。\n\nCH2 - AIKA\n上品で真面目な女性。ベーシストになる前はミュージカルの舞台で活躍していた。C03とは同級生。いつも濃いメイク。\nハロウィンの衣装は魔女。\n\nCH3・KAZUO\nセクシーでちょっとエキセントリックなボーカル。グループのリーダー。カリスマ性があり、自然体でいることが好き。自分の外見に誇りを持っている。\nハロウィンの仮装はヴァンパイア。\n\nCH4 - ウイルス\n無骨で頑固なギタリスト。C03の幼なじみで、C02とは一方的なライバル関係。いつもマスクや呼吸器など、口を覆うものをつけている。\nハロウィンの仮装は狼男。\n\nch5 - しげる\nドラマー。ストイックで威圧的だが、実は少しシャイ。バンド以外ではサラリーマンをしており、2児の父。趣味は占い。\nハロウィンの仮装はフランケンシュタインの怪物。\n\nこのリクエストでOKだといいのですが！もし金額が違っていたら、再送をリクエストしてください。機械翻訳で変なところがあったらごめんなさい。\n\nhttps://drive.google.com/drive/folders/1LDw2rPzRhcZyeNhsS3n6A7tGD8eg5Zpf", "created_at": "", "completed_at": ""}, {"path": "/@k_tohu06/works/30", "thumbnail_src": "https://si.imgix.net/00069ed4/uploads/origins/799d6659-4a56-4b8e-acb1-906f7294cf7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=949d1118e82595050df6ce37bf0944ae", "thumbnail_srcset": "https://si.imgix.net/00069ed4/uploads/origins/799d6659-4a56-4b8e-acb1-906f7294cf7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=949d1118e82595050df6ce37bf0944ae, https://si.imgix.net/00069ed4/uploads/origins/799d6659-4a56-4b8e-acb1-906f7294cf7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=966ae94e816eca0edb1ede8b2fa14beb 2x, https://si.imgix.net/00069ed4/uploads/origins/799d6659-4a56-4b8e-acb1-906f7294cf7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce600f725a9dd8e61de603c92199a731 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@k_tohu06/works/29", "thumbnail_src": "https://si.imgix.net/16aa6196/uploads/origins/364a155d-4468-4262-9d0f-8c7ed6ac97d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098c5633d53b0a6ed087a3c6b365e562", "thumbnail_srcset": "https://si.imgix.net/16aa6196/uploads/origins/364a155d-4468-4262-9d0f-8c7ed6ac97d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop