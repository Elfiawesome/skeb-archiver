ive.google.com/drive/folders/1rJ4jyj5GxuA1zOyiP44tuE2zgOOILIq4?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Gunjou_row/works/14", "thumbnail_src": "https://si.imgix.net/9097e76d/uploads/origins/2559235f-64cd-45e4-8477-49e3dc96e402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=790f1ce2b3d923b53c714172a3eadd71", "thumbnail_srcset": "https://si.imgix.net/9097e76d/uploads/origins/2559235f-64cd-45e4-8477-49e3dc96e402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=790f1ce2b3d923b53c714172a3eadd71, https://si.imgix.net/9097e76d/uploads/origins/2559235f-64cd-45e4-8477-49e3dc96e402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9ae191b2e4882203c9cd94bbd3427be 2x, https://si.imgix.net/9097e76d/uploads/origins/2559235f-64cd-45e4-8477-49e3dc96e402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b4e39d4295356b606ecb4d72205ca61 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gunjou_row/works/13", "thumbnail_src": "https://si.imgix.net/3ec5fc1c/uploads/origins/4abed843-223a-458e-81e0-3aa656827ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b53b746adc69e2ddd88f820d77b732f", "thumbnail_srcset": "https://si.imgix.net/3ec5fc1c/uploads/origins/4abed843-223a-458e-81e0-3aa656827ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b53b746adc69e2ddd88f820d77b732f, https://si.imgix.net/3ec5fc1c/uploads/origins/4abed843-223a-458e-81e0-3aa656827ed8?bg=%23fff&auto=format%2Ccompress&fm=webp