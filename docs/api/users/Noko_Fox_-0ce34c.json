's the night time and the star on my tail is glowing\nno other specific request\nI really love your art, please feel free to draw us\nThank you!\n\nmy friend‘s character:\nhttps://drive.google.com/file/d/1Jf9n_bNBEE2NnhY8A9xZm6h-ifAarYLO/view?usp=sharing\nmy character:\nhttps://drive.google.com/file/d/1-7oEyZ0cfDrjdMV0Xs9SDS2fNyAWPl-C/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Noko_Fox_/works/148", "thumbnail_src": "https://si.imgix.net/9c5042f1/uploads/origins/7e80e45e-236b-4416-92d0-85e64659754a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69764adceafafaeb6e4e49153bb2b9ac", "thumbnail_srcset": "https://si.imgix.net/9c5042f1/uploads/origins/7e80e45e-236b-4416-92d0-85e64659754a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69764adceafafaeb6e4e49153bb2b9ac, https://si.imgix.net/9c5042f1/uploads/origins/7e80e45e-236b-4416-92d0-85e64659754a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41fff9bbaab48c5aaeade39120669bf8 2x, https://si.imgix.net/9c5042f1/uploads/origins/7e80e45e-236b-4416-92d0-85e64659754a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a93e72383126390d58ba93db5f021d26 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Noko_Fox_/works/147", "thumbnail_src": "https://si.imgix.net/832d08e5/uploads/origins/1bc8e7d3-f2d7-473d-aa4e-c065c35572f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1469f938fd120d840abef220fb88e207", "thumbnail_srcset": "https://si.imgix.net/832d08e5/uplo