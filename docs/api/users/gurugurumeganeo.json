eb-853e-f4f8cdbf3184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5891701a29a9b847ed7dd77d4b7873ac 2x, https://si.imgix.net/ecc52a22/uploads/origins/60e39b7c-1146-4aeb-853e-f4f8cdbf3184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3f15ee12f8c773bd450d991e86faf88 3x", "genre": "art", "nsfw": true, "body": "遊戯王OCGより『ダーク・エルフ』のふたなりイラストをお願いします！\n\nちんぽのサイズはこちら(https://twitter.com/gurugurumeganeo/status/1507545742717513729)4枚目のカスミくらいの巨根で可能であれば仮性包茎にして頂き玉付きでお願いします！\nちんぽの色は以前伊藤さんの描かれていたこちら(https://www.pixiv.net/artworks/97628590)のダーク・エルフの様に褐色の肌より少し濃い目の黒チンポですとありがたいです！\nまた、性癖的に可能な範囲で大丈夫ですので腋毛陰毛(黒毛)を濃い目に生やして頂けますと…！\n\nそんなダーク・エルフが腋見せ蟹股ポージングor腋見せエロ蹲踞で自身のデカチンや濃い毛の生えた臭そうなエロボディを見せつけている様な姿をお願いします！\n\n以上長くなりましたがご一考よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gurugurumeganeo/works/2", "thumbnail_src": "https://si.imgix.net/1a27f7e8/uploads/origins/b70c006a-166e-4cf9-8128-9b990895c389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26318effc8af636b544ba9f27c35a078", "thumbnail_srcset": "https://si.imgix.net/1a27f7e8/uploads/origins/b70c006a-166e-4cf9-8128-9b990895c389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26318effc8af636b544ba9f27c35a078, https://si.imgix.net/1a27f7e8/uploads/origins/b70c006a-166e-4cf9-8128-9b990895c389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7caeaa0e0d621f9b393c59097df00bad 2x, https://si.imgix.net/1a27f7e8/uploads/origins/b70c006a-166e-4cf9-8128-9b990895c389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a001ef75acd1cec867ff89c183cd13b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gurugurumeganeo/works/1", "thumbnail_src": "https://si.imgix.net/b436cde0/uploads/origins/3e109bcc-1ce7-4f2f-b557-f854fc52cb8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c21acd5cf9ad07bfefcf3cb70bf17253", "thumbnail_srcset": "https://si.imgix.net/b436cde0/uploads/origins/3e109bcc-1ce7-4f2f-b557-f854fc52cb8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c21acd5cf9ad07bfefcf3cb70bf17253, https://si.imgix.net/b436cde0/uploads/origins/3e109bcc-1ce7-4f2f-b557-f854fc52cb8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0d5371732459722a89a50e41e1d31e2 2x, https://si.imgix.net/b436cde0/uploads/origins/3e109bcc-1ce7-4f2f-b557-f854fc52cb8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a54ec6260dad5794982c89601162282 3x", "genre": "art", "nsfw": true, "body": "はじめまして！失礼いたします。\n\npixivで拝見したハーピィレディのイラストが素晴らしかったので、リクエストさせていただこうと思いました。\n\n「ハーピィレディがブラックマジシャン師匠を嬲り殺しにしている」というシチュエーションをお願いしたいです。\n具体的な構図としては、\n・ブラックマジシャンは既にハーピィに凄惨にいたぶられており、両手をもぎ取られてボロボロにされ、ハーピィの前に跪くような姿勢。杖もへし折られて転がっている\n・ハーピィレディは電撃鞭を持ってグイッと扱いている。ボロボロのブラックマジシャンをさらに執拗に鞭打し、じわじわと処刑しようと企み、ニヤニヤしながら舌なめずりをしている…\n\nという感じで、絶望的で陰惨な逆リョナ場面をお願いしたいです。\nハーピィレディはpixivのイラストのようなノーマルのコスチュームに鞭、というスタイルでお願いします。\n主役をいたぶって殺す悪役、悪女、卑劣な敵女というイメージで、\nエロではなくガチの胸糞悪い処刑シーンとして描いていただきたいと思います。\n\nマニアックな内容ですし、嗜好と合わないかもしれませんが、\nもし予算や内容やスケジュール的に可能なら、ご検討いただければ幸いです。", "created_at": "", "completed_at": ""}]}