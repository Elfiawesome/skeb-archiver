e-4fbe-966d-e91bf45fdd81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8ad11c1a592fae401d48e1c7a9dfb11 2x, https://si.imgix.net/1aefd763/uploads/origins/24c1f74a-099e-4fbe-966d-e91bf45fdd81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b50cf2bac20692ab82eb823ed6b6349e 3x", "genre": "art", "nsfw": false, "body": "初めまして！個人Vtuberを応援してますLily（@lily_xm_x1）と申します。\n\nわらやぬこ様に自分の推しの個人勢Vtuberの\n紅記えり(@Kurenagieri)さんのイラストをお願いしたいです。\n\n【希望する構図】\n構図：ねむたい目をこすって起きたばっかの表情\n衣装：お任せ\n表情：ねむそう\n\n表情差分もお任せであったら嬉しいです。\n\n■使用用途\n紅記えりさんのYouTubeのサムネイルややTwitterでの広報活動に\n使用していただきたいため、\n紅記えりさんにのみ使用許可をお願い致します。\n\n本人はファンアートをskebで依頼することは許可しております。\n（https://lit.link/kurenagieri)\n\nなにとぞ、ご検討よろしくお願いいたします。\n\nhttps://www.fanbox.cc/@kurenagieri/posts/5783559\n\nhttps://downloads.fanbox.cc/images/post/5783559/4KNlt5Fx30P6x25nS27zZ88x.png", "created_at": "", "completed_at": ""}, {"path": "/@warayanukodaa/works/25", "thumbnail_src": "https://si.imgix.net/827eec82/uploads/origins/94b034d0-fee2-409a-b483-00e80a646af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163fcd8e234050530da54425497c9159", "thumbnail_srcset": "https://si.imgix.net/827eec82/uploads/origins/94b034d0-fee2-409a-b483-00e80a646af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163fcd8e234050530da54425497c9159, https://si.imgix.net/827eec82/uploads/origins/94b034d0-fee2-409a-b483-00e80a646af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7f3e043f389ca64f9f0a0da2619ccb0 2x, https://si.imgix.net/827eec82/uploads/origins/94b034d0-fee2-409a-b483-00e80a646af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c56b947675ee55a0aad061ba9e178f1 3x", "genre": "art", "nsfw": false, "body": "アイコンの依頼です。\nオリジナルキャラクターで、外見の特徴は狐耳、白髪、青いメッシュ、ロングヘア、碧眼の少女です。獣耳フードがあるダボっとしたぶかぶかな黒いパーカーを着ていて(フードは被らない)右左どちらかの肩からズレて肩が見えてる感じでお願いしたいです。パーカーは前にファスナーがないタイプです。\n雰囲気は眠たげで、構図は椅子か何かに座りながらあくびをして伸びてる感じがいいです。\n納品は可能ならば1ヶ月程でお願いしたいですが、遅れても納品されれば問題ないです。\n是非、お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@warayanukodaa/works/24", "thumbnail_src": "https://si.imgix.net/c07ac40a/uploads/origins/034bc897-4c59-44e5-be96-9a9b5fccc441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c0d055389815f15868366b58b0b2639", "thumbnail_srcset": "https://si.imgix.net/c07ac40a/uploads/origins/034bc897-4c59-44e5-be96-9a9b5fccc441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c0d055389815f15868366b58b0b2639, https://si.imgix.net/c07ac40a/uploads/origins/034bc897-4c59-44e5-be96-9a9b5fccc441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e77b22c2af1e8c9ade2c6db0ff710a24 2x, https://si.imgix.net/c07ac40a/uploads/origins/034bc897-4c59-44e5-be96-9a9b5fccc441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=617ec72ce2e7cd11abf557b1e8c19c5b 3x", "genre": "art", "nsfw": false, "body": "わらやぬこ様\n\nはじめまして、蜜乃くまと申します。\nわらやぬこ様の繊細な画風がとても好きで、いつも楽しく拝見させていただいております…！\n（白金ダイヤちゃんのメイド服のイラスト大好きです）\n今回は、ぜひ私のキャラクターであるVtuber「蜜乃くま」を描いていただきたいです。\n\n衣装はランジェリー、ベビードール（細かいデザインはお任せします、脱がせてだいじょうぶです）で、控えめサイズのお胸や身体（特にお尻）のむちっと感が印象的な構図になっているととても嬉しいです…！ \n細かいポーズ、小物、背景、髪型などは全てお任せいたします。\n\n使用用途はTwitter等SNSでの利用やyoutubeのサムネイル、ネットプリントなどです。\n可能であれば、キャラクターのみの背景透過版もpsdのレイヤーで入れていただけると幸いです。\nご多忙とは存じますが何卒ご検討のほど、よろしくお願いいたします。\n\n以下、キャラクターの参考になればと思います。\nhttps://twitter.com/mitsunokuma/status/1645005938380922880?s=46&t=ddLHIPtnleWsPFpnyCuXbw\n\nhttps://twitter.com/arata_zatta_fa/status/1638919181939904514?s=46&t=ddLHIPtnleWsPFpnyCuXbw\n\nhttps://twitter.com/arata_zatta_fa/status/1533104365229047808?s=46&t=ddLHIPtnleWsPFpnyCuXbw", "created_at": "", "completed_at": ""}, {"path": "/@warayanukodaa/works/23", "thumbnail_src": "https://si.imgix.net/22163008/uploads/origins/ff2e6917-dc42-4b44-a43b-4cd982aaedd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1c490cd5f115a3422f2b4b05ad06f01", "th