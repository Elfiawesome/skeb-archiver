b1f4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c3118ca4734941c892b77f0f29cc0f", "thumbnail_srcset": "https://si.imgix.net/b590c3c0/uploads/origins/59031402-91b9-4e34-9add-8254c0b1f4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c3118ca4734941c892b77f0f29cc0f, https://si.imgix.net/b590c3c0/uploads/origins/59031402-91b9-4e34-9add-8254c0b1f4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33f578b233a77faf9e510b2374a781db 2x, https://si.imgix.net/b590c3c0/uploads/origins/59031402-91b9-4e34-9add-8254c0b1f4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6fcbd940b2ee3a3368d08fbe3335ab9 3x", "genre": "art", "nsfw": true, "body": "牛大福様はじめまして！すごくかわいらしいキャラデザをお見かけしたもので、\nよろしければウチの娘のエッチなイラストを描いていただきたくご依頼です。\n\n牛大福様が描きになられてる、一人称正常位Ｈのイラストが大変好みにぶっささりまして、\nブループロトコルというゲームで作ったオリキャラで、\n同じような構図でのイラストをお願いできると嬉しいです。\n\n可能であればいくつか差分もお願いしたいのですが、\n金額厳しいようでしたらキャンセル頂けると幸いです。\n\n----------\n▼キャラ参考\nhttps://i.imgur.com/cqJwQVj.jpeg（デザイン）\nhttps://i.imgur.com/SybzTRK.png（キャラ設定）\nhttps://i.imgur.com/Ljzz1BB.jpeg（イメージ）\n\n▼内容\n参考構図のようなイメージでアリサとディランの正常位Ｈ。\n（相手は一応参考のハゲマッチョな男イメージですが、一人称なので描写頂く必要ありません）\n\n衣服は手間かと思うので、恰好は全裸で。\n無理やりな感じではなく素直になれないツンデレな雰囲気で、\nエッチに抵抗はなくツンツンイチャ甘なイメージ。\n\n・参考構図\nhttps://skeb.jp/@ushidaihuku/works/235\nhttps://skeb.jp/@ushidaihuku/works/228\n\n※可能な範囲で差分をご検討頂きたく、難しければ最初と最後程度をお願いしたいです\n・挿入前でアリサがに両手でアソコをくぱぁして恥ずかしそうに戸惑っている表情\n・挿入～中出し\n・中出し後でジト目風で（出しすぎよ、ばか……♡）みたいな感じで、膣内からあふれ出す精液。\n　ツンとしてるものの口元はちょっと微笑んでてまんざらでもない様子。\n----------\n\nご無理な内容でしたら、ご遠慮なくキャンセルをお願いします。\n何卒ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ushidaihuku/works/239", "thumbnail_src": "https://si.imgix.net/d58dead6/uploads/origins/90065e85-2689-4533-ab87-15bf741b3ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c74f3a7f588959d357daa62e1047541", "thumbnail_srcset": "https://si.imgix.net/d58dead6/uploads/origins/90065e85-2689-4533-ab87-15bf741b3ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c74f3a7f588959d357daa62e1047541, https://si.imgix.net/d58dead6/uploads/origins/90065e85-2689-4533-ab87-15bf741b3ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76ccea08cc9e509c333e80553a99e71f 2x, https://si.imgix.net/d58dead6/uploads/origins/90065e85-2689-4533-ab87-15bf741b3ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6880b36307682e209f3d8e9bc60ca4 3x", "genre": "art", "nsfw": true, "body": "お世話になっています！\n前回描いていただきましたイラストは最高でした！\n今回ももしよければお願いします……！\n\n■キャラクター\n・フラワーナイトガール（花騎士）のプルーン\n　資料URLをご参照ください。\n　明るく元気なつるぺたロリで、だんちょー（主人公）とのえっちにも積極的です。\n\n■服装\n・資料内の「進化前」\n　背中の羽付きリュックは不要です。\n・左手薬指に金色の指輪。\n　前回と同様、ゲーム内システムによって渡したものです！\n　映る場合は描写をお願いします！\n　https://flowerknightgirl.game-info.wiki/d/%b1%ca%b1%f3%a4%ce%c0%c0%a4%a4#content_2_1\n\n■シチュ\n竿役主観のハート飛び交う明るいいちゃいちゃM字騎乗位セックス。\nM字……蹲踞っぽいポーズとなります。前かがみににはならず全身がしっかり見られると嬉しいです。\n明るい室内のベッド上を想定しています。\nプルーンはワンピースの正面にあるボタンを全て外して肌着は身に付けずに丸出しの状態。\n大好きなだんちょーに気持ちよくなってほしいプルーンが、嬉しそうに跳ねてくれます。\nだんちょーとは体格差もあり超立派な竿なのでゴチュゴチュゴリュゴリュえぐってしまいますが、\nすっかり慣れているので全く痛くも苦しくもなく、むしろとても気持ち良い状態です。\n・団長のイメージ\n　前回と同様、細マッチョ体型で18cm以上の巨根でお願いします！\n　また、竿以外の描写はほぼ不要です。\n\n■可能であれば\n以下のような差分を頂けますと大変嬉しいです。\n希望順に記載致しましたので、金額の範囲内で可能であればご対応頂けますと幸いです。\n・中出し\n　グッサリ突き刺した超立派な竿から思いっきり膣内に大量にぶち撒けまくります。\n　プルーンは嬉しくとろけそうな表情で、瞳に薄いピンクのハートマークを浮かべながら一緒にイッてくれます。\n・事後\n　大量の精液が性器からドボドボ流れ出ている状態です。\n・挿入前\n　超立派な竿がお腹にぴたっと添えられ、プルーンはとても期待しながら嬉しそうにこちらを見つめてくれます。\n・外出し跡\n　お腹から顔にかけてまっすぐ大量にぶち撒けた跡がつきます。\n\n以上、細かく記載していますが、もしよければお願いします……！\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%d7%a5%eb%a1%bc%a5%f3", "created_at": "", "completed_at": ""}, {"path": "/@ushidaihuku/works/238", "thumbnail_src": "https://si.imgix.net/f73d5799/uploads/origins/9aa19d8f-7c3f-4e72-b01b-187c2ffd3d58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11325c0