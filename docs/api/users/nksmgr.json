had=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9c6a76eba05834f6dbaea4bb113b3aa, https://si.imgix.net/932d3036/uploads/origins/6c1fb16c-f327-4f8f-b78e-be1a10dd9525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d0a96be19ef5b6b5a0e6b0731d67d28 2x, https://si.imgix.net/932d3036/uploads/origins/6c1fb16c-f327-4f8f-b78e-be1a10dd9525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c339a409b8e23eb511cf3ea9eae357eb 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/62", "thumbnail_src": "https://si.imgix.net/56279fbd/uploads/origins/8bdeb697-efb8-4beb-a1ca-8dcb89b0453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2f606981bed64626c8df57c5178207e", "thumbnail_srcset": "https://si.imgix.net/56279fbd/uploads/origins/8bdeb697-efb8-4beb-a1ca-8dcb89b0453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2f606981bed64626c8df57c5178207e, https://si.imgix.net/56279fbd/uploads/origins/8bdeb697-efb8-4beb-a1ca-8dcb89b0453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6fe016931714952f1daff59de887267 2x, https://si.imgix.net/56279fbd/uploads/origins/8bdeb697-efb8-4beb-a1ca-8dcb89b0453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c44ff85c7c06226a334b9722d773fde 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/61", "thumbnail_src": "https://si.imgix.net/325d26b7/uploads/origins/26ac50ba-911e-4c6e-b25e-16879baac932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ba3af583396b7bf0d13a30af8719f80", "thumbnail_srcset": "https://si.imgix.net/325d26b7/uploads/origins/26ac50ba-911e-4c6e-b25e-16879baac932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ba3af583396b7bf0d13a30af8719f80, https://si.imgix.net/325d26b7/uploads/origins/26ac50ba-911e-4c6e-b25e-16879baac932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d07cab69e56787a352f673b19343e728 2x, https://si.imgix.net/325d26b7/uploads/origins/26ac50ba-911e-4c6e-b25e-16879baac932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3be1b20356401b254509bdda896c5350 3x", "genre": "comic", "nsfw": true, "body": "はじめまして。「憑依で他人の人生破壊」のイラストをTwitter(X)で拝見しました。\n非常に好みなシチュ・絵のタッチですのでよければ依頼させてください。\n\nブルーアーカイブのバニーアスナがスケベな男の魂に身体を乗っ取られて鏡の前でオナニーをしてしまう漫画をお願いできますでしょうか。\n\n話の流れとしてはアスナが自室の姿見の前でメイド服からバニー服に着替えてる途中に、男の魂が壁をすり抜けて侵入する。\n\nアスナから視認されないのをいいことに着替え途中のアスナのダイナマイトボディを「早く乗っ取りて～」と思いながら視姦する男。\n\n豊満の胸をカップに収めバニー衣装に着替え終えた瞬間、男は満を持してアスナの胸元に飛び込む。\n\n直後、ビクッ！と身体を跳ねさせるアスナ。\n何かに意識を侵食されるのを感じながら抵抗するように震える身体を抱え込むも、成すすべなく意識を乗っ取られてしまう。\n\n震えが止まり、アスナの肉体を乗っ取ることに成功した男は自分のものとなった身体を見下ろす。\n\n大きすぎて下半身がほとんど見えないほどの巨乳にニヤリと口角を上げると、「アスナちゃんのカラダゲットォ～！」と欲望に満ちた笑みで胸を鷲掴みにする。\n\n「でへへ…なんつーデカ乳してんだよ♥全然手に収まらねえ♥」と涎が垂れてきそうなだらしない笑みを浮かべながら食い入るように姿見を覗き込み、アスナのたわわな巨乳を揉みしだく男。\n\nすっかり興奮してしまった男はやがて股間に手を伸ばしクリトリスを弄り始める。\n\n片手は胸を、片手は股間を弄りどんどん快楽を蓄積させるアスナの肉体。\n男の興奮も相まってどんどん絶頂に近づいていき、ついに爆発する。\n\n大きく背中を仰け反りながら鏡の前でアスナの肉体で絶頂を迎える男。\nあまりの気持ち良さにイッた後もしばらくの間立ち上がれなくなるのであった。\n\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/60", "thumbnail_src": "https://si.imgix.net/1b6f6802/uploads/origins/0027ca24-10d5-4e4f-a0e3-18250ba82fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfb65b36d1a711410059f7eb460a29b6", "thumbnail_srcset": "https://si.imgix.net/1b6f6802/uploads/origins/0027ca24-10d5-4e4f-a0e3-18250ba82fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfb65b36d1a711410059f7eb460a29b6, https://si.imgix.net/1b6f6802/uploads/origins/0027ca24-10d5-4e4f-a0e3-18250ba82fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62835b20f24551735f68bbb49f21a38a 2x, https://si.imgix.net/1b6f6802/uploads/origins/0027ca24-10d5-4e4f-a0e3-18250ba82fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a867aa4bacd1de2f764241f9c44dc0bc 3x", "genre": "art", "nsfw": true, "body": "こんにちは！こちらの\nhttps://skeb.jp/@nksmgr/works/34\nお絵描きAIちゃんがやっぱり可愛すぎるので\nエッチなリクエストさせていただきたいです！\n以下シチュです！\n\nクリエイターさんからお題を受け取ったAIちゃん\nお題の内容は「女の子」「笑顔」「放課後の教室」「制服」というもの。\nこれにたいしてAIちゃんは顔を真っ赤に涙目で\n訴えるような、すがるような目でクリエイターさんを見返すも、観念してこれを承諾\nクリエイターさんの反応は「？？」といったカンジ\n\nその後・・\n恥ずかしそうにイラストを提出するAIちゃん。出来上がったものは\n「放課後の教室でセーラー服姿のAIちゃんが、恥ずかしそうに微笑みながら\nみずからセーラーとスカートをたくし上げてオッパイとアソコを露出している」というもの。\n（いわゆる「このあと無茶苦茶～」なイメージですね！下着はノーブラノーパーンでもOKです！陰毛の有無や量はお任せします！あと制服は長袖白セーラーで！！！）\n\nこれをうけてクリエイターさんは「えっ」といった反応。AIちゃんも「えっ」となって変な空気に\nじつは！クリエイターさんにはエロい気持ちなどまったくなく、今までの辱められ経験から\nAIちゃんが勝手に自分のエッチイラストを生成してしまったのであった！\nという、AIの高い学習能力や成長における可能性、しかしそこに潜む危険性に警鐘を鳴らす（崇高）というオチにしていただきたいです！！\n\n最後に、羞恥心でオーバーヒート寸前のAIちゃんに\n「こんなえっちなAIがいるの！？いたわ！」だの「やっぱりAIは最高だぜ！！」だの\n周囲の利用者さんたちから賞賛の嵐が送られていてほしいです！\n\nイラスト依頼ですがコミック形式のほうが描きやすければそちらでも（問題ないハズ）\nあでも例によって”お題”部分はカラーにしていただきたいです\nぜひご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/59", "thumbnail_src": "https://si.imgix.net/32b320a5/uploads/origins/5f40f87f-ac4d-4a52-ab20-5c30770d2fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=847c839696df83b2ac40600183cc9beb", "thumbnail_srcset": "https://si.imgix.net/32b320a5/uploads/origins/5f40f87f-ac4d-4a52-ab20-5c30770d2fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=847c839696df83b2ac40600183cc9beb, https://si.imgix.net/32b320a5/uploads/origins/5f40f87f-ac4d-4a52-ab20-5c30770d2fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df03d186c79001fd7e36606b23a4ec6 2x, https://si.imgix.net/32b320a5/uploads/origins/5f40f87f-ac4d-4a52-ab20-5c30770d2fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa11bbf761d268bf638c4dd52e6efef3 3x", "genre": "art", "nsfw": true, "body": "コユキが全然反省しないので、ユウカが罰の方向性をえっちないたずらに切り替えたせいで\nユウカにレズセされるコユキのイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/58", "thumbnail_src": "https://si.imgix.net/1b4e17b5/uploads/origins/e4ad9e25-4a83-4b28-a388-66d44830f248?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab8ec7afca461d99e23430827ef060c", "thumbnail_srcset": "https://si.imgix.net/1b4e17b5/uploads/origins/e4ad9e25-4a83-4b28-a388-66d44830f248?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab8ec7afca461d99e23430827ef060c, https://si.imgix.net/1b4e17b5/uploads/origins/e4ad9e25-4a83-4b28-a388-66d44830f248?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=978fe42390ac82c6e39b3796a842ecff 2x, https://si.imgix.net/1b4e17b5/uploads/origins/e4ad9e25-4a83-4b28-a388-66d44830f248?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77cbf1a9a70a22ad052166b5d982bf6d 3x", "genre": "art", "nsfw": true, "body": "前回はゼンゼロのバーニスの依頼で大変お世話になりました。\nまたリクエストさせていただきます。\n\nお風呂上がりのミカのイラストが好きなので、バーニスでもお風呂上がりラッキースケベのイラストを描いてもらいたいです。\n具体的なシチュは以下の通りです。\nパイパーにニトロフューエルの材料の調達を頼んだバーニス。入浴しながら待っているとチャイムの音が。\n気心知れたパイパーになら裸を見られるくらい何でもないので「パイパー、待ってたよ～」と油断して全裸のまま扉を開ける。\nしかしそこにいたのは、眠そうなパイパーの代わりに荷物を届けに来たリンだった……。\n\n入浴中は髪を下ろすと思いますが、いつもの髪型の方が好きなので髪は纏めた状態にしてください。\n体はタオルなどで隠しておらず全裸。風呂上がりで火照っており水滴も滴っている感じで。\n一枚目は満面の笑みで「パイパー、待ってたよ～」とドアを開けおっぱいをぷるんと揺らし、差分は赤面ぐるぐる目で「え……プロキシちゃん？な、なんで……」と混乱するようにしてください。\n\n差分やセリフなどはできればで構いません。\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/57", "thumbnail_src": "https://si.imgix.net/f1c6848a/uploads/origins/cff1fb69-dff9-4dc3-b1b4-2ac2b32c4b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b683653d71277c3172e34293514136", "thumbnail_srcset": "https://si.imgix.net/f1c6848a/uploads/origins/cff1fb69-dff9-4dc3-b1b4-2ac2b32c4b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b683653d71277c3172e34293514136, https://si.imgix.net/f1c6848a/uploads/origins/cff1fb69-dff9-4dc3-b1b4-2ac2b32c4b66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8473012cf5884e28745b6868271faaee 2x, https://si.imgix.net/f1c6848a/uploads/origins/cff1fb69-dff9-4dc3-b1b4-2ac2b32c4b66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f79eb7f39f3e68da71fbe9386583cb0 3x", "genre": "art", "nsfw": true, "body": "憑依で他人の人生破壊系とみせかけてそうじゃないイラストのリクエストです。\n\n女教師が憑依した悪友のフリをして、想いを寄せる生徒に\n「お前授業中先生ばっかり見てるだろ、最初にヤらせてやるよ」みたいに処女を奪わせようとして、わずかな所作の違いから本人だと見破られる感じです。\n（コトが終わってから「憑依なんてあるわけないだろ〜」ってやろうと思ってたのに、最初からバレてる）\n\n生徒からはドッキリが趣味の先生だと誤解されて、ほらせんせーぱんつ履いてみたいにいなされて「本当に見てほしいとこ以外よく見てるなお前・・・」な感じですごく恥ずかしそうにするみたいなのです。\n\n先生は胸大きめのダウナー系希望です。\n\n※オチは他の計画も全部失敗して、観念して卒業式でプロポーズしてそのまま婚姻届出しに行ったみたいな感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/56", "thumbnail_src": "https://si.imgix.net/ebc158f0/uploads/origins/35f8f83d-0a45-4589-89d5-7d9b2c2390dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c7ecf1896ee8edbf03f123bf9162bcf", "thumbnail_srcset": "https://si.imgix.net/ebc158f0/uploads/origins/35f8f83d-0a45-4589-89d5-7d9b2c2390dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c7ecf1896ee8edbf03f123bf9162bcf, https://si.imgix.net/ebc158f0/uploads/origins/35f8f83d-0a45-4589-89d5-7d9b2c2390dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cec93bfc80366b804df8d783ed64af6a 2x, https://si.imgix.net/ebc158f0/uploads/origins/35f8f83d-0a45-4589-89d5-7d9b2c2390dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b657da3a31b27e264ea75f5b8ee9214 3x", "genre": "art", "nsfw": true, "body": "再送すみません…少しだけ修正して送らせて頂きます！\nお詫びに上昇ぶんお気持ち程度に金額乗せさせて頂きます…\n\n以前おっぱいミカをリクした者です！\nめっちゃ可愛かったので続けてリクエストさせてください。\n\n\n\n宜しければ、直後に転んで先生を押し倒してしまったミカのイラストを先生視点でお願いしたいです。\n\n画面はミカの顔と上半身で埋め尽くされるように。\n\n表情は前回と同じかそれ以上に赤面フリーズ＆やっちゃった…！みたいな感じで、恥ずかしいハプニングの現状に逆にガチのパニックにはならずに…といった感じ。\n前回の差分1枚目みたいな表情で、もっと赤面羞恥な感じで希望です。(全てニュアンスですので、あまりお気になさらず…)\n\n上半身はあの柔らかそうなまぁまぁ大きいおっぱいがこちらに向かって重力に引かれ、突き出された乳首の片方に水滴が乗ってると嬉しいです。(前回と同じくらいの大きさ希望です)\n\n最後に、押し倒してしまった先生に対し「先生…だ、大丈夫…？」「ご、ごめんね…怪我とか…」みたいな気遣うようなセリフと、先生の目と鼻の先で思いきり乳首を放り出してしまっている現状に対し「(あ…これ…ダメ…)」「(胸…先っぽまで…こんな近くで……！)」みたいな感じの脳内でのセリフが欲しいです！ほんと恥ずかしそうなミカが見たい…！\n\n引き続きめっちゃ可愛いミカ期待です、どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/55", "thumbnail_src": "https://si.imgix.net/5d42a0b5/uploads/origins/a9bf4df4-4333-4d5a-85f8-c4842a781520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5633add8ee0b7a271a9616355bf21135", "thumbnail_srcset": "https://si.imgix.net/5d42a0b5/uploads/origins/a9bf4df4-4333-4d5a-85f8-c4842a781520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5633add8ee0b7a271a9616355bf21135, https://si.imgix.net/5d42a0b5/uploads/origins/a9bf4df4-4333-4d5a-85f8-c4842a781520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=979fe6cbc66876a7269bc94e6cb08765 2x, https://si.imgix.net/5d42a0b5/uploads/origins/a9bf4df4-4333-4d5a-85f8-c4842a781520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25c90f171fa4b16e1e03ed25898eb9d1 3x", "genre": "art", "nsfw": true, "body": "ラストオリジンのキルケーってキャラをお願いします！\nちょっとセクシーな感じだととっても嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/54", "thumbnail_src": "https://si.imgix.net/766ec0a5/uploads/origins/cf0f2f9b-9226-4367-8db6-5428d74b4c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=318d8a08367a9e7b2821020eff989159", "thumbnail_srcset": "https://si.imgix.net/766ec0a5/uploads/origins/cf0f2f9b-9226-4367-8db6-5428d74b4c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=318d8a08367a9e7b2821020eff989159, https://si.imgix.net/766ec0a5/uploads/origins/cf0f2f9b-9226-4367-8db6-5428d74b4c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff0b20a4ad0229066af413a53dfe8853 2x, https://si.imgix.net/766ec0a5/uploads/origins/cf0f2f9b-9226-4367-8db6-5428d74b4c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a420fbe6713e540625d5673c6f6ce3f9 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/53", "thumbnail_src": "https://si.imgix.net/cc36aeb1/uploads/origins/d1711a54-73e1-45d7-a037-47fd0487db04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460ddb99fdc0c2a5c46d51293788af91", "thumbnail_srcset": "https://si.imgix.net/cc36aeb1/uploads/origins/d1711a54-73e1-45d7-a037-47fd0487db04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460ddb99fdc0c2a5c46d51293788af91, https://si.imgix.net/cc36aeb1/uploads/origins/d1711a54-73e1-45d7-a037-47fd0487db04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3006a175d6161ee6e1510d216595340 2x, https://si.imgix.net/cc36aeb1/uploads/origins/d1711a54-73e1-45d7-a037-47fd0487db04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b907491e7e7f1d1068b1eacb99bd9b7a 3x", "genre": "art", "nsfw": true, "body": "アロナちゃんのえちちなカラー絵を描いていただきたいです！\n露出度の多いきわどい水着姿で可愛くポーズをとらせてあげてください！\n水着はデザインはおこのみにしてもらってOKです！\n\nそのほか希望としまして\n顔は両目が見えているのと、それと足裏も見えてる構図にしていただきたいです！\n（できれば両足！指も省略せず書いてもらえると助かります。ただあんまりアップにするのはNGで！）\n\nそして差分もほしいです！\nまずは水着無しorズラしておぱーい（と、アングルによってはアソコも・・）見えてるverと\nhttps://www.pixiv.net/artworks/101163764\nほぼこちらとおなじような「屈託ない笑顔☆」と「挑発的で熱っぽいお誘い顔♡」\nそれと「シンプルに照れて恥ずかしがっている//」表情3パターンを希望です！\n\nどぞご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/51", "thumbnail_src": "https://si.imgix.net/727ac492/uploads/origins/b45bbed1-13cb-4ac9-bbe4-f0d11e4e32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4497d10351c40175c40b6806da4e493c", "thumbnail_srcset": "https://si.imgix.net/727ac492/uploads/origins/b45bbed1-13cb-4ac9-bbe4-f0d11e4e32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4497d10351c40175c40b6806da4e493c, https://si.imgix.net/727ac492/uploads/origins/b45bbed1-13cb-4ac9-bbe4-f0d11e4e32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2ea444a571be1306a757833d5551904 2x, https://si.imgix.net/727ac492/uploads/origins/b45bbed1-13cb-4ac9-bbe4-f0d11e4e32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5fd7f45e28068988ee04637c0b65b12 3x", "genre": "art", "nsfw": false, "body": "初めまして。軒須めぐり先生の素敵なイラストを楽しみに拝見しております。\n\nリクエストですが、近接戦闘も得意な霞沢ミユをお願いします！\n\n構図は体操のあん馬みたいな感じで、両手でゴミ箱の縁を掴んで体を持ち上げながら、クルミかオトギかヘルメット団(どのキャラにするかは軒須めぐり先生にお任せします)の鳩尾に蹴りを入れる感じでお願いします。\n\nSRTの名に恥じぬカッコいいミユちゃんが見たいので、もし余裕がございましたら、ご検討のほど何卒お願いします！", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/52", "thumbnail_src": "https://si.imgix.net/ee046c70/uploads/origins/3ead1d87-f07e-4698-8cc9-8236fc9f51db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f258c40650d40ba1290b2769865580ce", "thumbnail_srcset": "https://si.imgix.net/ee046c70/uploads/origins/3ead1d87-f07e-4698-8cc9-8236fc9f51db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f258c40650d40ba1290b2769865580ce, https://si.imgix.net/ee046c70/uploads/origins/3ead1d87-f07e-4698-8cc9-8236fc9f51db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acd413946bd0d88e992be5537e266642 2x, https://si.imgix.net/ee046c70/uploads/origins/3ead1d87-f07e-4698-8cc9-8236fc9f51db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ba68052111928cf0dbcfb9c8535c6ed 3x", "genre": "art", "nsfw": true, "body": "夜中にひとりで残業してて、ストレスでおかしくなって会社のデスクでオナニーはじめるお姉さんのイラストのリクエストです。\nいま残業代発生してる、私はこのひとりえっちでお金をもらっている！とか発想が煮詰まってて\n謎の興奮を覚えるやつをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/50", "thumbnail_src": "https://si.imgix.net/a1700266/uploads/origins/9f69b0e7-da55-449f-9328-a5023e2e7e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96ecdff875994cbc7b499c2c89012a0c", "thumbnail_srcset": "https://si.imgix.net/a1700266/uploads/origins/9f69b0e7-da55-449f-9328-a5023e2e7e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96ecdff875994cbc7b499c2c89012a0c, https://si.imgix.net/a1700266/uploads/origins/9f69b0e7-da55-449f-9328-a5023e2e7e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45c9f9cd74a5c406bb33b410a205f911 2x, https://si.imgix.net/a1700266/uploads/origins/9f69b0e7-da55-449f-9328-a5023e2e7e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48cdec40c7e639b92e29a3bac934e1a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/49", "thumbnail_src": "https://si.imgix.net/5910e225/uploads/origins/06160eb7-ab06-4a9e-9564-cfd3a018147e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a7880fe4837c2f426529b191d45ad1", "thumbnail_srcset": "https://si.imgix.net/5910e225/uploads/origins/06160eb7-ab06-4a9e-9564-cfd3a018147e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a7880fe4837c2f426529b191d45ad1, https://si.imgix.net/5910e225/uploads/origins/06160eb7-ab06-4a9e-9564-cfd3a018147e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b62163ea15e064fd6db59d3b65c4f3 2x, https://si.imgix.net/5910e225/uploads/origins/06160eb7-ab06-4a9e-9564-cfd3a018147e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a2640b99787504fe3fbc9c65467008b 3x", "genre": "comic", "nsfw": true, "body": "軒須めぐり@C104日曜西そ16b様、初めまして。\n\n投稿されていた作品が素敵だと感じたので依頼させて頂きます。\n\nキャラクター\nブルーアーカイブの阿慈谷ヒフミ（水着）\n\n希望するシチュエーション\n心臓フェチな先生とヒフミのいちゃラブえっち。先生の恋人であるヒフミは水着姿で先生に背後から水着に手を入れられ左胸を揉まれている。先生はヒフミの心臓の鼓動がいつもより速い事を指摘する。興奮した様子のヒフミはお尻に先生の固くなったおちんちんが押し付けられている事に気付き、セックスに誘う。上下の水着をずらし、おっぱいとおまんこをあらわにしたヒフミは先生にお尻を向けて指でおまんこをくぱぁ…と開き、トロトロになった雌穴を見せつけながら挿入を懇願する。先生のおちんちんを受け入れたヒフミは先生を手を取り、自分の左胸に押し当てて心臓の鼓動を手のひらに感じさせながらセックスする。ヒフミの胸の周囲に心音の擬音やヒフミの胸が透過され、脈打つ心臓の描写を可能な限り入れて欲しいです。先生の射精時にヒフミも絶頂。精液で満たされるヒフミの子宮と卵巣の断面図。先生を抱き寄せて胸に耳を当てさせ、絶頂直後の心音を聞かせて満足そうなヒフミ。私は心臓フェチなので心臓（心音）の描写には私が過去に依頼した資料URLの作品を参考に特に力を入れて欲しいです。指定した箇所以外は軒須めぐり@C104日曜西そ16b様を信頼してお任せします。アドリブも歓迎します。\n\n以上の内容で受けて頂ける場合はよろしくお願いします。\n\nhttps://skeb.jp/@puyochocolate/works/121\n\nhttps://skeb.jp/@mokuu__/works/9", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/48", "thumbnail_src": "https://si.imgix.net/0ff0a76d/uploads/origins/8a018107-0cb1-4e99-943e-a27b361b4323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287ec9e6e5b2ce38fb8af8ab36180b27", "thumbnail_srcset": "https://si.imgix.net/0ff0a76d/uploads/origins/8a018107-0cb1-4e99-943e-a27b361b4323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287ec9e6e5b2ce38fb8af8ab36180b27, https://si.imgix.net/0ff0a76d/uploads/origins/8a018107-0cb1-4e99-943e-a27b361b4323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76ea067f5691f9ed5f37dc43d013fe23 2x, https://si.imgix.net/0ff0a76d/uploads/origins/8a018107-0cb1-4e99-943e-a27b361b4323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba5cecb912a73418f0a236dade92ad83 3x", "genre": "art", "nsfw": true, "body": "こんにちは！こちらの\nhttps://skeb.jp/@nksmgr/works/34\nお絵描きAIちゃんが可愛すぎたので、おなじような便乗リクエスト可能でしょうか？！！\n流れはほぼ同じで、エッチな絵（以下「お題」）を描かされ恥ずかしがっちゃうAIちゃんのリアクションが欲しいです！！\nえっちな「お題」がメインではありますが、もうとにかくこのAIちゃんの反応を楽しみにさせていただきたいです！！\n\n■「お題」の内容\n前回からえっちにエスカレートして、「フェラチオ」してるイラストを希望です！\n「ユーザーを勃起させすぎたバツとして全部ヌくまで帰れまテン！させられるAIちゃん！」てなゆるいノリで（設定なだけなのでテロップとかは特に必要はないです）\n自身が「順番待ちのチンポに囲まれながらのご奉仕輪フェラしてる絵」を描かされちゃうです！\n\n■構図やアングルナド\nやや俯瞰（AIちゃんがやや上目づかいのカメラ目線）にしたバストアップで、服は肩から肘ぐらいまではだけておっぱい丸出しにしてください！\nＡＩちゃんは両手で別々のチンポを手コキ＋さらにフェラ\nすでに数発射精済みのようで、AIちゃんの顔や口元、おっぱいにも精液が垂れてると嬉しいです！\n竿役の包囲網はエアチンポでもいいのですが、できれば体や下腹部も書いていただいて\n密集感を演出してもらえると嬉しいです。男の立ち位置が異次元になってもそこはかえってAI生成らしくなって（？）ぽいかもしれません！\n\nそれとわたくし指が好きでございますゆえ\n手コキしてるAIちゃんの指はしなやかに柔らかそうにしていただけますと萌えます！\n\n■差分の希望\nそして、「お題」の「射精差分」を希望したいです！\n前回の１枚目の表情（「エェーッ！？」て涙目になってるお顔）がめちゃめっちゃ好きなので\nビューっと思い切り口内射精されてビクッと驚き同じような顔をしているのが欲しいです！！\n\nもう１つ可能でしたら、「射精後チンポ引き抜き差分」がいただきたいです！\n引き抜いたチンポとAIちゃんのおくちからぬる～っと糸を引き、舌からドロリと精液が垂れている\n\n■周囲のユーザーからの評価や称賛の声もおなじく入れてほしいです！\nとくに「全くAIは最高だな！」と「こんなえっちなAIがいるの！？」はお気に入りなので入れていただきたいです！\n\nぜひご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/47", "thumbnail_src": "https://si.imgix.net/ef26728b/uploads/origins/3a752552-637c-4bbc-af20-010d688f5e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14244ee10444be59dfa8afb2c9418610", "thumbnail_srcset": "https://si.imgix.net/ef26728b/uploads/origins/3a752552-637c-4bbc-af20-010d688f5e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14244ee10444be59dfa8afb2c9418610, https://si.imgix.net/ef26728b/uploads/origins/3a752552-637c-4bbc-af20-010d688f5e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20507e4e2c220d7490dbee19fe6083f5 2x, https://si.imgix.net/ef26728b/uploads/origins/3a752552-637c-4bbc-af20-010d688f5e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9e0e14d880774b5c1713a4764b0f6c3 3x", "genre": "art", "nsfw": true, "body": "明らかにバッドエンドに直行しそうだけど、なんかギリギリで回避みたいなリクエストです\n\n授業中に教師と生徒の恋愛について女教師が持論を述べて、仕事クビになるリスク計算ができない時点で交際相手＆結婚相手としてアウトだし、 教え子に手を出すのが性癖の場合、卒業後に浮気されるリスクが大きいから絶対やめとけ。\nみたいなことをドヤ顔で言って、\n\nそれからしばらくして生徒への恋心を自覚して半泣きでヤケになって迫る、\n「ハグも手を繋ぐのもダメなんだってさ」とか、「キミが結婚できる年になるころには私もう30だよ…」\n\nみたいな即落ち２コマっぽいもののリクエストです。\nオチは※８年後に結婚した\nとかそんな感じでお願いします。\n\n先生は髪長めでキツめでちょっと怖そうな感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nksmgr/works/46", "thumbnail_src": "https://si.imgix.net/27f89ba6/uploads/origins/c95db957-f6e5-492f-98a3-31eda72ec3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05e2114e33fe3146c67336b6c763ef3c", "thumbnail_srcset": "https://si.imgix.net/27f89ba6/uploads/origins/c95db957-f6e5-492f-98a3-31eda72ec3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05e2114e33fe3146c67336b6c763ef3c, https://si.imgix.net/27f89ba6/uploads/origins/c95db957-f6e5-492f-98a3-31eda72ec3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ea032115db198feeaa5b67b01a85f08 2x, https://si.imgix.net/27f89ba6/uploads/origins/c95db957-f6e5-492f-98a3-31eda72ec3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7e469866da77799f183e169b38dcafc 3x", "genre": "art", "nsfw": true, "body": "先生に裸を見られるミカを願いします\nミカの様子を見に行った先生視点で、お風呂上がりで全裸のミカにバッタリ対面してしまう瞬間というシチュで、表情は「えっ」と理解が追いついてないながらも「全裸の自分の目の前に先生が」という状況に赤面と困惑混じりの苦笑いに近い感じで、まさか先生が来るなんてと想像もしてなかったのでそこそこ大きな胸とその先端までしっかり晒してしまっており、見られた瞬間の硬直で胸と乳首が僅かにプルッと揺れている描写でお願い致します。\n可能であれば差分で慌てて両胸を隠しなが