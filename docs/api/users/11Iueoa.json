す。\n\n・背景ありとキャラクターのみの背景透過されたものをPNGかPSDデータでいただけると幸いです。\n\n・サムネなど使用するため顔や髪の毛、うさ耳が見切れていないと嬉しいです。\n\nプロフィール:\n普段は和喫茶の看板娘として働いている。\n和服メイドスタイルの露出少なめなので、清楚っぽいイメージを持たれがち。\n\nプライベートはおうちが大好きで引きこもり。ゲームとチョコが好き。\nだらしなく家ではゴロゴロや二度寝大好き、露出多めの薄着が多いです。\n※キャラクター自身の左胸にホクロあり、谷間の出る服だと見える※\n胸はF〜Gで和服を脱いだら意外とあるな、という隠れ巨乳タイプ。\n\n以上になります。ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://lit.link/mirei111", "created_at": "", "completed_at": ""}, {"path": "/@11Iueoa/works/3", "thumbnail_src": "https://si.imgix.net/168b25bb/uploads/origins/ad4182d8-f86e-4577-a381-3605bae293de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5764563a6da63bb4b0c3884bf446b2b7", "thumbnail_srcset": "https://si.imgix.net/168b25bb/uploads/origins/ad4182d8-f86e-4577-a381-3605bae293de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5764563a6da63bb4b0c3884bf446b2b7, https://si.imgix.net/168b25bb/uploads/origins/ad4182d8-f86e-4577-a381-3605bae293de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41d4907a752bf2a9e3502e2874a7bc1a 2x, https://si.imgix.net/168b25bb/uploads/origins/ad4182d8-f86e-4577-a381-3605bae293de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf7b557481b29c1e0702c28a524f7dcb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@11Iueoa/works/2", "thumbnail_src": "https://si.imgix.net/989d0f9d/uploads/origins/49fba699-6834-47a7-9b1b-2c81a6ab30ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed96dadacb077cdfc8572b8aa19680fe", "thumbnail_srcset": "https://si.imgix.net/989d