cb-4c07-8edd-8f235c8c2aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b960a29cd865f2f664b50e44218a65eb 2x, https://si.imgix.net/9479c479/uploads/origins/c9835214-cecb-4c07-8edd-8f235c8c2aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52e7d8a2e097f1d0a49bba35f97f61a7 3x", "genre": "art", "nsfw": false, "body": "はじめまして、アピールありがとうございます。\nさっそくリクエストさせていただきます。\n\nVRChatというゲームで使用している私のアバターのイラストをお願いいたします。\nアクセサリ等、細かい部分は多少デザインを変更しても問題ありません。\n構図やシチュエーションはお任せします。\n\n資料は下記URLをご覧ください。\n\nhttps://twitter.com/nulmis_VRC/status/1712050117921104273", "created_at": "", "completed_at": ""}, {"path": "/@tofu63100401/works/4", "thumbnail_src": "https://si.imgix.net/057ceb1d/uploads/origins/f39bb682-8171-41bf-b266-c08dac496087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3706d1514ef0bc15052063f8f404a0bd", "thumbnail_srcset": "https://si.imgix.net/057ceb1d/uploads/origins/f39bb682-8171-41bf-b266-c08dac496087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3706d1514ef0bc15052063f8f404a0bd, https://si.imgix.net/057ceb1d/uploads/origins/f39bb682-8171-41bf-b266-c08dac496087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d451e00d6e6746a08b1540212920ca5 2x, https://si.imgix.net/057ceb1d/uploads/origins/f39bb682-8171-41bf-b266-c08dac496087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=363fdd6b354c537f55114213d80fde1f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\nアピールをありがとう。\n\nこの作品がどのように見えるか、あなたはすでにアイデアを共有しているので、私はあなたに完全な芸術的自由を与えたいと思います。\n2つだけお願いがあります：帽子のつばに黒い雫を入れるのを忘れないでください。そして、彼女に生えているカビを通して、作品に色あせを加えてください。鮮やかな色である必要はありません。\n\n以上です。\nあとはすべてあなた次第です。\n\nそれではまた、良い一日を。\n\nhttps://drive.google.com/drive/folders/1JFURj_cuAMRps5FqcnAzH-R5CPNsefcR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tofu63100401/works/3", "thumbnail_src": "https://si.imgix.net/e5d8cf29/uploads/origins/d2d2c322-58ac-4b2d-9122-b270d89dceeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf754f71c480231e6bb014c82034e1e2", "thumbnail_srcset": "https://si.imgix.net/e5d8cf29/uploads/origins/d2d2c322-58ac-4b2d-9122-b270d89dceeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf754f71c480231e6bb014c82034e1e2, https://si.imgix.net/e5d8cf29/uploads/origins/d2d2c322-58ac-4b2d-9122-b270d89dceeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=616c342e2310a01f4c9888821c9be36d 2x, https://si.imgix.net/e5d8cf29/uploads/origins/d2d2c322-58ac-4b2d-9122-b270d89dceeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3b46f228100ed30cca14716125052a7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのリクエストを見て、あなたの絵が大好きになりました！あなたの見たいシナリオで「Hahzel」を描いてください！\n\nhttps://www.dropbox.com/sh/5bes0tvwjgw59ej/AADV4y4V5GfOH3zUaDgainIga?dl=0\n\nhttps://www.dropbox.com/sh/k49y11h9q99asrg/AACioS2Vqk8gnN1hlxEGxZlVa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@tofu63100401/works/2", "thumbnail_src": "https://si.imgix.net/8a1ab01e/uploads/origins/d3968e6d-ba17-4e30-b4df-b53bcd85a1da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c438b50fa4946f26ee11951c99ac7a", "thumbnail_srcset": "https://si.imgix.net/8a1ab01e/uploads/origins/d3968e6d-ba17-4e30-b4df-b53bcd85a1da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c438b50fa4946f26ee11951c99ac7a, https://si.imgix.net/8a1ab01e/uploads/origins/d3968e6d-ba17-4e30-b4df-b53bcd85a1da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2aef2340521f6fda5271dbc3c305dd03 2x, https://si.imgix.net/8a1ab01e/uploads/origins/d3968e6d-ba17-4e30-b4df-b53bcd85a1da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afb7538c4a6a7ed2f251ec56d2a115e2 3x", "genre": "art", "nsfw": false, "body": "アピールしてくれてありがとう！あなたの作品がとても好きです！\nオリジナルキャラクターのイラストをお願いしたいです。\nポーズや表情、背景などイラストの構図は全てお任せします！\nありがとうございました！\n\nhttps://imgur.com/a/wh128ST", "created_at": "", "completed_at": ""}, {"path": "/@tofu63100401/works/1", "thumbnail_src": "https://si.imgix.net/3d6283fa/uploads/origins/ffbf0b9b-223a-42cd-b00d-e3558ae4debb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752320566e3c8669540a29dc6ad64662", "thumbnail_srcset": "https://si.imgix.net/3d6283fa/uploads/origins/ffbf0b9b-223a-42cd-b00d-e3558ae4debb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752320566e3c8669540a29dc6ad64662, https://si.imgix.net/3d6283fa/uploads/origins/ffbf0b9b-223a-42cd-b00d-e3558ae4debb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=435c45652de248eb0346d35037749a9d 2x, https://si.imgix.net/3d6283fa/uploads/origins/ffbf0b9b-223a-42cd-b00d-e3558ae4debb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fd2ba1c4f251306b434f83599c6f3d7 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nアピールを有難う御座います！是非、睦村を描いて下さい！\nイラストの使用用途は、TwitterやDiscordその他SNSでの紹介、TRPGその他、個人使用です。\n\n・キャラクター\n\n睦村 奏衛(むつむら かなえ)\n\n25歳 女性\n身長216センチ\n体重84キロ(痩せ型)\n一人称 私\n\n真っ白な肌や髪(アルビノ)\n傷だらけ。口唇口蓋裂。\n大きな口にギザギザの歯。\n大型肉食獣を思わせる顔立ち。\n左右で色構成が違うやや菱形の瞳。\n眉毛は無く、長い睫毛。欠けた耳。\n左右非対称で羽毛質感の髪の毛。\n長く大きな手。左利き寄り両利き。\n胸は無く、骨格はかなりガッシリと男性的。\n\n表向きはボディガードで、本業は殺し屋。\n医学知識と卓越したナイフさばきで、苦しませる事なくターゲットを一撃で仕留める。\n幼少期に受けた頭部の外傷によるホルモン分泌異常により、身長が異常に大きく、見た目で女性と見られる(バレる)事はまず無い。\n頭が弱く騙され易いが、真面目で大人しく、仕事以外で誰かを害する事を嫌う。\n大きな音や強い匂い、酒やタバコが苦手。\n手先が器用で、料理が唯一の趣味。\n無類の動物好きだが、虫が少し苦手で、ナマコが怖い。\n冬の夜が好きで、夏の昼が苦手。\n夢は子供を産んでお母さんになる事と、自分の料理の店を持つ事。\n白いネリネ(ダイヤモンドリリー/白彼岸花)が誕生花。\n\n・イメージ\n\n顔付きや体格は資料URL内01.05、衣装は00(仕事着)でお願いします。\n全体的にエキゾチックな雰囲気とpixivで拝見した血糊の描き方が良かったので、仕事中〜仕事後のイメージで一枚お願いします‼︎\nナイフを持たせる場合は左手に。\n細かい部分や背景、構図などはお任せします。\n\n※顔、髪型、目の詳細。\nhttps://www.dropbox.com/s/fxhjix3lli24eeg/7E7744C5.png?dl=0\n※ラフ、線画、塗り等でレイヤーの分かれたPSDを希望。\n※納品されているギャラリーも参考にして頂けると嬉しいです。\n\n以上、ヨロシクお願いします！\n\nhttps://www.dropbox.com/sh/wutrpijgh0twmhq/AADnwxxZsN7UGGtt0soY7hLia?dl=0", "created_at": "", "completed_at": ""}]}