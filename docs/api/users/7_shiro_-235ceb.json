6fd8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=affbb8cd39c5c0972cdd4b4ddd174601 2x, https://si.imgix.net/b60f8a67/uploads/origins/a92afce2-1e7f-4c5a-8eba-b01ac346fd8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c0a3f43f4bbfaff19615d8eb18c88a8 3x", "genre": "art", "nsfw": false, "body": "四郎さん、こんにちは。\n\n私は四郎さんのキャラクターの描き方、特に顔とまつ毛が大好きです。私のキャラクター「ベラ」をぜひ描いてください。ベラは自信に満ち溢れ、幸せな女性です。人前ではエレガントに振る舞うのが好きですが、ちょっと生意気な面も持っています。コーヒーを飲んでくつろぐ彼女のイラストをお願いします。着てほしい服は添付の通りです。また、ベラはショートブーツにジーンズでも構いません。また、普段の姿の写真も追加しました。構図や表情はあなた次第です。その他、細かいことはshiroさんにお任せします。\n\nご検討ありがとうございました。\nどんな作品が出来上がるのか、楽しみにしています\nベラ 参考：https://imgur.com/a/lUkRMxY\n衣装： https://imgur.com/ESIQgV5", "created_at": "", "completed_at": ""}, {"path": "/@7_shiro_/works/10", "thumbnail_src": "https://si.imgix.net/7a59f8d8/uploads/origins/3b60c0ba-fef2-439b-b82e-80933b45f551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed94b419c5396d63265fd428286e877", "thumbnail_srcset": "https://si.imgix.net/7a59f8d8/uploads/origins/3b60c0ba-fef2-439b-b82e-80933b45f551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed94b419c5396d63265fd428286e877, https://si.imgix.net/7a59f8d8/uploads/origins/3b60c0ba-fef2-439b-b82e-80933b45f551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38a28c1a1743f8be382fcbc74f430b90 2x, https://si.imgix.net/7a59f8d8/uploads/origins/3b60c0ba-fef2-439b-b82e-80933b45f551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c9a3f2c23552bb39d17ccaf1aeee75d 3x", "genre": "art", "nsfw": false, "body": "初めまして！絵が素敵で魅力的なので、リクエストさせていただきたいと思います！\n\n下記資料のURLを参考していただければ幸いです！\n\n咲苗は複雑。周りの人が近づかないようにとても冷たく、皮肉や嫌味よく使い、本当の気持ちをあんまり出さない。笑顔しても、偽物にすぎない。たまに普通にひどいことをするが、心の底は優しさで行動している。周りの人の期待に答えるためたくさん嘘をつく。サクランボ味のお菓子、とくにロリポップをいつも食べている。体調がすごく悪く、体力より戦略のほうが得意。昔は、ピアノの天才だと思われ、右手のケガのためプロをやめてしまった。探偵役で、残酷な犯罪の犯人を探している。過去で罪を犯したため、この役割を果たすことで許しを欲しがっている。自分の夢を全部諦めて、もう死んでもいいのに、様々な責任を負うため死ねない。自分の人生は価値がないと思い、自分を犠牲にしても構わない。\n\nイラストの方は特にアイディアがないので、ご自由に描いていただければうれしいです。咲苗によく付き合うものは：傘、雨、白い菊、チェス（特に黒駒）、血。冷たいや暗い雰囲気、メランコリック的な絵が似合うと思います。咲苗の本当の性格を表示していただければ嬉しいです！できれば背景があってほしいです！お任せします！\n\nキャラクターなどは好みではなければ、いつでもキャンセルでかまいません！\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1zPJt7mqukt7aFP39E28R1E_6Dy-c0Pfh?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@7_shiro_/works/9", "thumbnail_src": "https://si.imgix.net/46b83333/uploads/origins/74ad393c-35e8-444a-81c9-fff3a0b02d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9360f733b6c7a784a4525c119b39f4d", "thumbnail_srcset": "https://si.imgix.net/46b83333/uploads/origins/74ad393c-35e8-444a-81c9-fff3a0b02d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9360f733b6c7a784a4525c119b39f4d, https://si.imgix.net/46b83333/uploads/origins/74ad393c-35e8-444a-81c9-fff3a0b02d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6925bdb19817f030f8a6847d359509d 2x, https://si.imgix.net/46b83333/uploads/origins/74ad393c-35e8-444a-81c9-fff3a0b02d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13814bfb90dd30da0c280b9a75526426 3x", "genre": "art", "nsfw": false, "body": "こんにちは私はあなたの絵が大好きです!私のオリジナルキャラクター「はるか」をお願いします!元気いっぱいの少女なのですが、その行動の裏には哀愁が漂っています。出来れば、青い蝶の要素も入れて描いて欲しいです\nそれ以外の構図はお任せします!ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1plO6xGqYg_vFlj4DiK4PzBB0_rSUWoty?usp=sharing\n\n英語でのプロフィールです。参考になれば幸いです。https://toyhou.se/2756588.shinseki-haruka", "created_at": "", "completed_at": ""}, {"path": "/@7_shiro_/works/8", "thumbnail_src": "https://si.imgix.net/1997fc7a/uploads/origins/7bbb6958-3dcf-4f80-85ad-45fe2a52091b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf6df42fd3a974801434b3f8ab81f6bf", "thumbnail_srcset": "https://si.imgix.net/1997fc