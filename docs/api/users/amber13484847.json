2631e743/uploads/origins/e7d520a8-2fa4-4d3b-9b0a-42b98fff5a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4db74cb951f4ba41687b1e2901ecf180 2x, https://si.imgix.net/2631e743/uploads/origins/e7d520a8-2fa4-4d3b-9b0a-42b98fff5a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a667d991eb4a0c2dd7efa76425423205 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amber13484847/works/3", "thumbnail_src": "https://si.imgix.net/d9093887/uploads/origins/469be0db-e96b-4619-8a46-ce7a5e8d6fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e294ed9b2678e939033200ca2d312091", "thumbnail_srcset": "https://si.imgix.net/d9093887/uploads/origins/469be0db-e96b-4619-8a46-ce7a5e8d6fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e294ed9b2678e939033200ca2d312091, https://si.imgix.net/d9093887/uploads/origins/469be0db-e96b-4619-8a46-ce7a5e8d6fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2fa0964eed28a4b5263c3397f60f543 2x, https://si.imgix.net/d9093887/uploads/origins/469be0db-e96b-4619-8a46-ce7a5e8d6fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6aeb045794834a138dcb8f45c24b497 3x", "genre": "art", "nsfw": true, "body": "絵に至るシチュは3次元に影として投影している高次元生命体なつるぺた全裸な女の子が女の子の排泄に興奮する変態ロ○コン男の性癖を覗き見して排泄プレイしてあげているシチュで、3次元の姿は影なのでどんな姿でもどんな大きさでも自由自在で排泄物の量も自由自在であるという都合が良い設定である。\n\n絵は全裸つるぺた女の子が下品なガニ股で凄い勢いと量のくぱぁ立ちションを見せてあげているという感じでお願いします。\n\n身長は通常サイズでも巨大サイズでも良く、画面に放尿がかかっていても良く、おしっ湖が出来ていても良く、あらゆる事が自由自在な高次元生命体なので排泄シーンは作者様に都合の良い解釈にお任せします。\n\n女の子の排泄が大好きな変態ロ○コン男が大興奮する様な絵をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@amber13484847/works/2", "thumbnail_src": "https://si.imgix.net/dbc23