す。(多すぎず、少なすぎず)\n\n彼は悪役ですが、猫たちは彼のことが大好きで、彼が悪いことをしていても、どこにでもついてくるようです。(猫のせいで可愛く見えるかもしれませんが、彼はとても邪悪です。TT)\n\nイメージとしては、クールな雰囲気を出したいですね。", "created_at": "", "completed_at": ""}, {"path": "/@Sei__0512/works/5", "thumbnail_src": "https://si.imgix.net/574de058/uploads/origins/fb69a892-4665-400c-9aec-4397fa1812e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60c97b7c9e454bbd46e458298ffb11a5", "thumbnail_srcset": "https://si.imgix.net/574de058/uploads/origins/fb69a892-4665-400c-9aec-4397fa1812e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60c97b7c9e454bbd46e458298ffb11a5, https://si.imgix.net/574de058/uploads/origins/fb69a892-4665-400c-9aec-4397fa1812e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cda98aabf1678471025b9725a45dccb1 2x, https://si.imgix.net/574de058/uploads/origins/fb69a892-4665-400c-9aec-4397fa1812e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8f1ec511d88a152eab35b25f462c551 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Sei__0512/works/4", "thumbnail_src": "https://si.imgix.net/b2e1bb82/uploads/origins/a88fb25e-94b3-4c9b-b94d-8386c21ca521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a758130dab1e39d3fcfe6e27894632", "thumbnail_srcset": "https://si.imgix.net/b2e1bb82/uploads/origins/a88fb25e-94b3-4c9b-b94d-8386c21ca521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a758130dab1e39d3fcfe6e27894632, https://si.imgix.net/b2e1bb82/uploads/origins/a88fb25e-94b3-4c9b-b94d-