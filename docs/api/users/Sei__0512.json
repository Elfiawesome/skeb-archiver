す。\nhttps://drive.google.com/file/d/1qX-ibvc9_0UFuHIsMefV8r3CkieHt8Kw/view?usp=sharing\n\n\nご検討のほど、何卒よろしくお願い申し上げます。m(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@Sei__0512/works/8", "thumbnail_src": "https://si.imgix.net/ac9fa3e7/uploads/origins/86f9a8d2-a8ac-40ad-a434-139a45355fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa08f2447ed8db9eae20a51cc61cfa3a", "thumbnail_srcset": "https://si.imgix.net/ac9fa3e7/uploads/origins/86f9a8d2-a8ac-40ad-a434-139a45355fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa08f2447ed8db9eae20a51cc61cfa3a, https://si.imgix.net/ac9fa3e7/uploads/origins/86f9a8d2-a8ac-40ad-a434-139a45355fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=930631144d11daae4ebaa660300053e8 2x, https://si.imgix.net/ac9fa3e7/uploads/origins/86f9a8d2-a8ac-40ad-a434-139a45355fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80fbad5bc8db86a9f4e8088adb79f8d1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Sei__0512/works/7", "thumbnail_src": "https://si.imgix.net/d528efd3/uploads/origins/e6a61899-438b-448e-960c-101c3b5edd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c87cd1cbb38317a104e95111664f8e0a", "thumbnail_srcset": "https://si.imgix.net/d528efd3/uploads/origins/e6a61899-438b-448e-960c-101c3b5edd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c87cd1cbb38317a104e95111664f8e0a, https://si.imgix.net/d528efd3/uploads/origins/e6a61899-438b-448e-960c-101c3b5ed