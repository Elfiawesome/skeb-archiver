ix.net/265dad9f/uploads/origins/69d4805f-eeb7-4b6f-9e05-379dba6468b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1abe014eff5998371e33da3fd68ed84e", "thumbnail_srcset": "https://si.imgix.net/265dad9f/uploads/origins/69d4805f-eeb7-4b6f-9e05-379dba6468b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1abe014eff5998371e33da3fd68ed84e, https://si.imgix.net/265dad9f/uploads/origins/69d4805f-eeb7-4b6f-9e05-379dba6468b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=976078a6a64ec11d2276aeb5b1d0d34b 2x, https://si.imgix.net/265dad9f/uploads/origins/69d4805f-eeb7-4b6f-9e05-379dba6468b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2578163996493ab55493b95d9eb19750 3x", "genre": "art", "nsfw": false, "body": "テーマは｢続ハクの日常 自宅にて スマホ鳴る トイレ行きたい チャイム鳴る｣でお願いします！\n•｢トイレに行こうとした瞬間､スマホが鳴りだすと同時に宅配便が届き･･･｣という感じで\n以上でお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@caffein89/works/113", "thumbnail_src": "https://si.imgix.net/0509b9a6/uploads/origins/67d36afa-22fa-4fb7-a38e-44e37960b409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f543c6d78e3f758cebf7c3db01279d8b", "thumbnail_srcset": "https://si.imgix.net/0509b9a6/uploads/origins/67d36afa-22fa-4fb7-a38e-44e37960b409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f543c6d78e3f758cebf7c3db01279d8b, https://si.imgix.net/0509b9a6/uploads/origins/67d36afa-22fa-4fb7-a38e-44e37960b409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b96f1ce81664a6754a0cbfd06ceff9d 2x, https://si.imgix.net/0509b9a6/uploads/origins/67d36afa-22fa-4fb7-a38e-44e37960b409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=494a4e31a31f90b92fc038b34a2dfaf4 3x", "genre": "art", "nsfw": false, "body": "初めて依頼させて頂きます。\n以下の内容でイラストを描いて頂きたいです。\n\n[希望キャラ]\n弱音ハク\n\n[希望衣装]\n京極院沙夜(CODE OF JOKER)の衣装\n(以下参考資料)\nhttps://livedoor.blogimg.jp/coj_seg