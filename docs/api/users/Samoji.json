a63e4dda34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07ebb7ba74eca7346e7fb89879123396 2x, https://si.imgix.net/d2cb3a63/uploads/origins/f06d7d02-6968-47b6-8915-a63e4dda34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=976374eba8258cee8e625bdcffcb95c8 3x", "genre": "art", "nsfw": true, "body": "漏れなつ。の翠屋辰樹と翠屋辰平親子がこちらに背を向けて立ち、上半身を下に屈んで開いた両足の隙間から蕩けて真っ赤の顔を覗かせておりダブルピースをこちらに向けていて、ポッカリと開いた肛門から気泡混じりの白濁液がタップリと溢れて垂れているというのを。\n二人の尻たぶには「二〇二四おつかれさまでした」「よいお年を」や、無数の「正」の筆文字が書かれているというのをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Samoji/works/76", "thumbnail_src": "https://si.imgix.net/bc3dfed9/uploads/origins/a487628f-1c57-42b1-b596-bfff28763e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6311073fe28d565ccd7878ce87586738", "thumbnail_srcset": "https://si.imgix.net/bc3dfed9/uploads/origins/a487628f-1c57-42b1-b596-bfff28763e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6311073fe28d565ccd7878ce87586738, https://si.imgix.net/bc3dfed9/uploads/origins/a487628f-1c57-42b1-b596-bfff28763e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8219f140f53d37db1901ef62bd3d5db 2x, https://si.imgix.net/bc3dfed9/uploads/origins/a487628f-1c57-42b1-b596-bfff28763e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c5e102b5844591e08da9b57c81f13e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Samoji/works/75", "thumbnail_src": "https://si.imgix.net/3b20d741/uploads/origins/9a01d380-346f-4c9b-a62b-068ab330b391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5210df4a67edcb2123cc9cbd8960ab", "thumbnail_srcset": "https://si.imgix.net/3b20d741/uploads/origins/9a01d380-346f-4c9b-a62b-068ab330b391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5210df4a67edcb2123cc9cbd8960ab, https://si.imgix.net/3b20d741/uploads/origins/9a01d380-346f-4c9b-a62b-068ab330b391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=432ed51372663f8c652db74de0c7c78c 2x, https://si.imgix.net/3b20d741/uploads/origins/9a01d380-346f-4c9b-a62b-068ab330b391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b88e396a53228250436680674b42a91f 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n今回はまた白雪さんとうちの欲狼（フォルティス）のイラストをリクエストしてよろしいでしょうか？\n\n以下、今回のシチュエーション的なものになります（敬称略）\nシチュエーションの前半等は、欲狼の心情を少しでも伝えられればと思い書いたものになります\nご一読いただければ幸いです\n\n初めて白雪を抱いた夜以降、なんだかんだとどし茶に通う欲狼\nお目当ては完全に白雪、他の男衆から声をかけられてもそっけない態度をとる\n白雪が他の客の相手をしていても不快にはならない\nむしろ仕事をしている白雪の姿を眺めているだけで楽しいようだ\nどし茶に行ったときは必ず白雪をアフターに誘っている\nもちろん毎回成功するわけではないが\n\nそんなある日、白雪を何度目かのアフターに誘う\n向かった先で、白雪を褌一丁にして眺めている\nアフターだからか恥じらう白雪\nそんな白雪に欲狼は妙な提案をする\n「これ、俺様につけてくれねぇか？」\n取り出したのは新品の褌、しかも白雪のとお揃い\nもちろん褌の締め方なんて知らない欲狼は白雪に締めてもらう\nお揃いの褌を締め、壁ドンから、見下ろすように白雪を見つめる欲狼\n密着し、パンパンになっている褌を白雪のそれにこすりつける欲狼\n先走りで濡れていく褌\nこのあとどれぐらい褌がその役割を果たしていたかは二匹しか知らない・・・\n\nてな感じです\n今回は描いてほしいのは、お揃いの褌を締めた白雪さんと欲狼が股間をこすり合わせているシーンです\n欲狼に白雪さんとお揃いの形の褌を、色は出来れば同じ白で\nただ、描いてみて色が違う方が映える、と思った場合はご自由に変えていただきたいです\n欲狼は楽しそうににやりと笑って、白雪さんを見下ろすように見つめています\n白雪さんの反応はお任せでお願いします\n\nhttps://drive.google.com/drive/folders/1tz9L2EQhLdFFhsuVrA9i4hg7fXnCOyb5?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Samoji/works/74", "thumbnail_src": "https://si.imgix.net/f07feb3a/uploads/origins/cd65d80c-9b8d-42df-8769-53493de55565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bce340934863cbca17926e884ea5ce1", "thumbnail_srcset": "https://si.imgix.net/f07feb3a/uploads/origins/cd6