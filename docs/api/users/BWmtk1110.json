com/attachments/1113993530575159367/1113993534735912990/Juniper.png\n\nhttps://cdn.discordapp.com/attachments/1113993530575159367/1113994057979527238/Juniper-Japanese.jpg", "created_at": "", "completed_at": ""}, {"path": "/@BWmtk1110/works/6", "thumbnail_src": "https://si.imgix.net/2b38be1a/uploads/origins/dd671598-9df0-4f88-9c56-39a65b32b5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49ef8890d7546b5f609305cb15a28ac7", "thumbnail_srcset": "https://si.imgix.net/2b38be1a/uploads/origins/dd671598-9df0-4f88-9c56-39a65b32b5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49ef8890d7546b5f609305cb15a28ac7, https://si.imgix.net/2b38be1a/uploads/origins/dd671598-9df0-4f88-9c56-39a65b32b5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=699e11fc8a91f757543e19635cf7209b 2x, https://si.imgix.net/2b38be1a/uploads/origins/dd671598-9df0-4f88-9c56-39a65b32b5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e536e41570d03a26663c31383d128ec2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のブイゼルを描いてくれませんか？\n好きなように描けばいい！\n\nhttps://drive.google.com/drive/folders/1ck0sQP1C179MUMBIb9Zmh6cit8K4qXOR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@BWmtk1110/works/5", "thumbnail_src": "https://si.imgix.net/387952f8/uploads/origins/a2010bf9-c6da-48c9-86d2-2f7333646b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f45730a6de0d619131e2269d34ec7e", "thumbnail_srcset": "https://si.imgix.net/387952f8/uploads/origins/a2010bf9-c6da-48c9-86d2-2f7333646b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f45730a6de0d619131e2269d34ec7e, https://si.imgix.net/387952f8/uploads/origins/a2010bf9-c6da-48c9-86d2-2f7333646b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30bfbca091cea3cd257d345a853ffc9b 2x, https://si.imgix.net/387952f8/uploads/origins/a2010bf9-c6da-48c9-86d2-2f733