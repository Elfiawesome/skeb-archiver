34-a916-862b7d1180ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99135216dc423da8da967bc54dab4df4, https://si.imgix.net/c6808c35/uploads/origins/e004d89f-ba22-4234-a916-862b7d1180ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62968645e1828203cca4af1484fc99f8 2x, https://si.imgix.net/c6808c35/uploads/origins/e004d89f-ba22-4234-a916-862b7d1180ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3dcbfe7aef75e0193e8576e5cddb79d 3x", "genre": "art", "nsfw": false, "body": "めぇと言う名前の私のキャラを描いて下さい\n羊・月・布団・サキュバスなどの要素が含まれます \n身長:123cm　外見年齢:10歳程度 (notケモ)\n\n\n性格\n口数少なく穏やかな性格で、常に少し眠そうです\n振る舞いはおとなしい10歳程度の子供のようです\nミルク、ナッツ、チョコ等を好み、小食です\n行動に害意はなく、敵意を嫌います\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています \n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n\n分泌される体液や血液は練乳やミルクのようで\n飲ませた相手を強壮し、軽い依存性をもちます\n\n3Dモデル\nhttps://twitter.com/gomames/status/1043101142081724416\nその他の資料はpixivなどにあります\n\nhttps://www.pixiv.net/artworks/99333545", "created_at": "", "completed_at": ""}, {"path": "/@BWmtk1110/works/2", "thumbnail_src": "https://si.imgix.net/263d4b82/uploads/origins/8f53aa59-e502-4faf-9642-28b970924ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0542dacde113e4ce7d9a485010e4cb6", "thumbnail_srcset": "https://si.imgix.net/263d4b82/uploads/origins/8f53aa59-e502-4faf-9642-28b970924ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0542dacde113e4ce7d9a485010e4cb6, https://si.imgix.net/263d4b82/uploads/origins/8f53aa59-e502-4faf-9642-28b970924ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae0fbe7c95ece000e7330949c8154046 2x, https://si.imgix.net/263d4b82/uploads/origins/8f53aa59-e502-4faf-9642-28b970924ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7ed9c2a339bd40e5f4b92decba356ab 3x", "genre": "art", 