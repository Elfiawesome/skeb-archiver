le%2Ccenter&txtsize=30&txt=PRIVATE&s=56ed2ef6aa5d488452128423d85dfe70 2x, https://si.imgix.net/4b11f014/uploads/origins/8e4653b7-71f9-4d4a-bd71-353a1efc4cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd368383487d70c317e1e42ccafd6336 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@moa151/works/25", "thumbnail_src": "https://si.imgix.net/691ae295/uploads/origins/90771642-e4f5-467d-a517-15bd9434bfd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d41f3188c30d555f16987f0f8506cf6", "thumbnail_srcset": "https://si.imgix.net/691ae295/uploads/origins/90771642-e4f5-467d-a517-15bd9434bfd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d41f3188c30d555f16987f0f8506cf6, https://si.imgix.net/691ae295/uploads/origins/90771642-e4f5-467d-a517-15bd9434bfd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c4da0318affa1f36fa039bc52c6994b 2x, https://si.imgix.net/691ae295/uploads/origins/90771642-e4f5-467d-a517-15bd9434bfd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6688c333a9e84c45c3ffc8218eecc0b4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n現役の頃、ポケ書には色々と世話になっていました。Xにて久しぶりにお姿を拝見したので今回依頼したいと思います。\n\n描いていただきたいのはビッカメ娘の「アキバたん」というキャラクターです。\n衣装は公式サイトでも着ている通常制服、表情はウインクをしていて口を開いている猫口、ポーズは片足を曲げている状態でいわゆる猫の手ポーズでお願いします。\n絶対領域が特徴なキャラクターでもあるのでむっちりしていると助かります。\n背景にハートマークと猫のシルエットがほどよく浮かんでいると幸いです。\n\n参考資料として公式サイトのキャラ紹介のページを張っておきますが、Xにて #アキバたん で検索すると色々な方がアキバたんの写真を上げているのでそちらも参考にどうぞ。\n\n以上となります。\nよろしくお願い致します。\n\nhttps://biccame.jp/profile/akiba.html", "created_at": "", "completed_at": ""}, {"path": "/@moa151/works/24", "thumbnail_src": "https://si.imgix.net/c0817043/uploads/origins/a172a7ec-742a-4fa6-b9bd-bbcd33a68f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2667a72276031193d9bbbe1baa62d196", "thumbnail_srcset": "https://si.imgix.net/c0817043/uploads/origins/a172a7ec-742a-4fa6-b9bd-bbcd33a68f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2667a72276031193d9bbbe1baa62d196, https://si.imgix.net/c0817043/uploads/origins/a172a7ec-742a-4fa6-b9bd-bbcd33a68f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72f9615d82ed9377a3da629c7554870b 2x, https://si.imgix.net/c0817043/uploads/origins/a172a7ec-742a-4fa6-b9bd-bbcd33a68f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b06586af058fd4c9934981a7e4c537b 3x", "genre": "art", "nsfw": false, "body": "自分の推しキャラである麻雀ファイトガールのイッシキクリア様を依頼させていただきます。\nhttps://eacache.s.konaminet.jp/game/mfg/1/images/chara/12/illustcut2.png?1\nhttps://img.atwiki.jp/mfgkonami/attach/56/124/s-GNLcfKbaUAA2Qw1.jpg\nポーズや構図などは先生にお任せします。\nクリア様の美しさを世に広めるためお力添えいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@moa151/works/23", "thumbnail_src": "https://si.imgix.net/d1908999/uploads/origins/9a48cdd2-c9d8-4726-85e6-730874e0d940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=716cfdb91d4cc5f08b2898586b4afddd", "thumbnail_srcset": "https://si.imgix.net/d1908999/uploads/origins/9a48cdd2-c9d8-4726-85e6-730874e0d940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=716cfdb91d4cc5f08b2898586b4afddd, https://si.imgix.net/d1908999/uploads/origins/9a48cdd2-c9d8-4726-85e6-730874e0d940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a22778480285051935e464128105f8ae 2x, https://si.imgix.net/d1908999/uploads/origins/9a48cdd2-c9d8-4726-85e6-730874e0d940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f4ecfbe94f0dfc01d23eb2c4be689b0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@moa151/works/22", "thumbnail_src": "https://si.imgix.net/aae6e94b/uploads/origins/a611a5bb-78b9-438e-a268-10a547674ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bba81880e8423d6202c83fb2330d2ce", "thumbnail_srcset": "https://si.imgix.net/aae6e94b/uploads/origins/a611a5bb-78b9-438e-a268-10a547674ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bba81880e8423d6202c83fb2330d2ce, https://si.imgix.net/aae6e94b/uploads/origins/a611a5bb-78b9-438e-a268-10a547674ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07e1b7387ba09ced27bca995b7bb0ac5 2x, https://si.imgix.net/aae6e94b/uploads/origins/a611a5bb-78b9-438e-a268-10a547674ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2965998b277278aa3fa28f839943b4c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！最近Twitter/Xであなたの絵を発見し、あなたのスタイルが大好きになりました。もしよろしければ、私のポケモンオリジナルキャラクター、カタリナ（略してリナ）の絵をお願いしたいのですが。要約すると、彼女は大学卒業後の研究の一環として、ノモセシティ近くのシンノー地方の大湿原とサファリゾーンで働いている、熱心で冒険好きなポケモン研究者の研修生です。彼女のフィールドリサーチの服装（チェストウェーダー、Tシャツ、黒とピンクのフィッシングハット）を描いてほしい。\n\nhttps://sta.sh/029zo80dcnju\nhttps://sta.sh/02ys1k49p8l\n\nポーズや構図などの詳細はお任せします。この依頼が御社のガイドラインに沿うものであれば、受諾を検討していただけると幸いです。ありがとうございました！\n\n(追伸：英語しか話せないので、DeepLの翻訳が不明瞭でしたら申し訳ありません)", "created_at": "", "completed_at": ""}]}