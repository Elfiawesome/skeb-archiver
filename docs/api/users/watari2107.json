ix.net/e1cc1ce4/uploads/origins/4f56353c-6175-4c9d-bdfd-729e8dc37bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93287a3f0791a5dd2b79bea6916e7b11, https://si.imgix.net/e1cc1ce4/uploads/origins/4f56353c-6175-4c9d-bdfd-729e8dc37bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb6fb3c56b0aebe079cdb5515f3c6fd5 2x, https://si.imgix.net/e1cc1ce4/uploads/origins/4f56353c-6175-4c9d-bdfd-729e8dc37bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0355b2e84365aa653c16f21fa6212b7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nアヤナを描いてほしい。\nアヤンナはゴシックなおとぎ話の王国を支配しているので、彼女のポーズをフルにクリエイティブにします。キュートでロマンチックな感じで。\n\n\n参考資料\nhttps://sta.sh/0jue9itus3a\nhttps://sta.sh/0pb7jnrysok", "created_at": "", "completed_at": ""}, {"path": "/@watari2107/works/38", "thumbnail_src": "https://si.imgix.net/8e153ff9/uploads/origins/6b52ea65-7057-4dd1-9552-e2938176e12f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2908bce9f10d81e7450950478bd215a5", "thumbnail_srcset": "https://si.imgix.net/8e153ff9/uploads/origins/6b52ea65-7057-4dd1-9552-e2938176e12f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2908bce9f10d81e7450950478bd215a5, https://si.imgix.net/8e153ff9/uploads/origins/6b52ea65-7057-4dd1-9552-e2938176e12f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00126354a7bdc069d49d65f064a8d9a0 2x, https://si.imgix.net/8e153ff9/uploads/origins/6b52ea65-7057-4dd1-9552-e2938176e12f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9f82f9b788a01ce715f4a1307a21f4c 3x", "genre": "art", "nsfw": false, "body": "はじめまして、コードギアスの月下のデフォルメイラストを拝見いたしまして、依頼させていただきます。同じく 『コードギアス』に出てくる機体、ナイトメアフレームの『ガウェイン』をお願いできますでしょうか。 詳しい資料などはURLをご覧くださいませ。 \nイラストをTwitterのアイコンにさせて頂きたいです。\nご確認よろしくお願いします。\n\nhttps://imgur.com/a/PzQahBa", "created_at": "", "completed_at": ""}, {"path": "/@watari2107/works/37", "thumbnail_src": "https