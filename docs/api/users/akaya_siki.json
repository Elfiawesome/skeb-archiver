=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f632ce07935f5dc1542a9b9c3fc3690 2x, https://si.imgix.net/8d0bf202/uploads/origins/023304b9-a812-403c-b473-ac696ce4243a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1407c446f298a28b0d02d3cb3fdf9012 3x", "genre": "art", "nsfw": false, "body": "朱耶式先生\n\n初めまして。\n\nVtuberの薬袋アルマ(@MinaiAlma) さんを描いてお願いしたいです。\n今回の要素\"お姉さんのASMR?\"\n服と他の要素はお好きなように描いてください！\n画像のアスペクト比は16:9 (壁紙_PC用) ?\n\n完成したイラストは薬袋アルマさんにもお送りいたします。\n薬袋アルマはサムネイル,アイコン,ヘッダー,動画などに使用させて頂く事があります (多分?)\n宛名はPSDレイヤーでON/OFFできると嬉しいです。\n\nよろしくお願いします！\n\nhttps://twitter.com/MinaiAlma", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/65", "thumbnail_src": "https://si.imgix.net/d2d233b0/uploads/origins/cfa33930-779f-4ee5-aa22-e7df74b5c5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e7c1b3d8cd6735e428bdc41df67fe1d", "thumbnail_srcset": "https://si.imgix.net/d2d233b0/uploads/origins/cfa33930-779f-4ee5-aa22-e7df74b5c5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e7c1b3d8cd6735e428bdc41df67fe1d, https://si.imgix.net/d2d233b0/uploads/origins/cfa33930-779f-4ee5-aa22-e7df74b5c5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=223f6d17328ffb94967c8b1018d3648c 2x, https://si.imgix.net/d2d233b0/uploads/origins/cfa33930-779f-4ee5-aa22-e7df74b5c5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d3722df62c8f065b663ec9697f678ef 3x", "genre": "art", "nsfw": false, "body": "お世話になります。前回は素敵なイラストありがとうございました。\n今回もらいとあっぷ所属の緋乃あかねさんのイラストをお願いします。\n\n衣装は新衣装の部屋着でお願いします。\nhttps://twitter.com/hino4kane/status/1492108763545083904\n構図はお互い正面に座ってゆったりくつろいでいる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/64", "thumbnail_src": "https://si.imgix.net/ca40a8a1/uploads/origins/a4be2af8-ab53-4926-bf74-9f3634452b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d22c457771410ed22db0c863783a99", "thumbnail_srcset": "https://si.imgix.net/ca40a8a1/uploads/origins/a4be2af8-ab53-4926-bf74-9f3634452b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d22c457771410ed22db0c863783a99, https://si.imgix.net/ca40a8a1/uploads/origins/a4be2af8-ab53-4926-bf74-9f3634452b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45b825563e48cbccc50359854295cf5f 2x, https://si.imgix.net/ca40a8a1/uploads/origins/a4be2af8-ab53-4926-bf74-9f3634452b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37e8ef306afc7758251033ac4bc005a8 3x", "genre": "art", "nsfw": false, "body": "朱耶式様、初めまして。\nRealityというアプリで配信活動を行っております、華白ユピアと申します。\n\n他の方からのご依頼絵を拝見し、ぜひ私の配信時のアバターを朱耶式様のタッチで描いていただきたくリクエストいたしました。\n配信時のアバターの姿については、Twitter上に載せている写真を参考にしていただければ幸いです。アバターの設定などは、以下の通りです。\n\n【アバター設定】\n・雪うさぎの妖精\n・耳は垂れ耳(人の耳✕)\n・身長は(150〜160cmぐらい)\n・髪の毛はセミロング～ロング\n・肌は白め\n・胸は小さめ\n瞳や髪の色は、着せ替えによりその都度変えていますので、お好きな物を参考にして下さい。\n\n【依頼内容】\n・軍服(黒系)\n・服装の装飾は金色\n・マントorロングコートを肩にかけている\n・帽子や手袋などの小物あり\n・クールな印象、表情\n→服装や表情など総合的に少しだけ色っぽい感じも出していただけたら嬉しいです…！\n背景、ポーズなどはお任せしてもよろしいでしょうか？\n利用用途としては、Twitterでのアイコンやヘッダー、個人デバイスの壁紙等で使用したいと思っております。\nどうぞよろしくお願いいたします。\n\nhttps://twitter.com/yupiyupia_k?t=zvUo2YnyxTQg83J_P_R5iw&s=09", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/63", "thumbnail_src": "https://si.imgix.net/655b6705/uploads/origins/eb7751cd-8961-4b94-800b-dd69d1271625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e60cc9dc1255c1308d12558917336f", "thumbnail_srcset": "https://si.imgix.net/655b6705/uploads/origins/eb7751cd-8961-4b94-800b-dd69d1271625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e60cc9dc1255c1308d12558917336f, https://si.imgix.net/655b6705/uploads/origins/eb7751cd-8961-4b94-800b-dd69d1271625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bc5d52bdc03f0718ea63174dcdea0d6 2x, https://si.imgix.net/655b6705/uploads/origins/eb7751cd-8961-4b94-800b-dd69d1271625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e2c943b3d2f1640d3771bc226eb2fdb 3x", "genre": "art", "nsfw": false, "body": "先日はイラストありがとうございました。\n何回も見返してカッコ良さに悶えております。さて今回ですが、前回同様ビワハヤヒデとナリタブライアンのイラストをお願いします！\n▶︎服装\nハヤヒデ\n上白衣　中スーツ　白衣は閉じない状態\nブライアン\n上白衣　中パーカー　白衣は閉じない状態\nスーツ、パーカーの色はおまかせします。\n▶︎装飾品\nハヤヒデ\n眼鏡の有無の差分をお願いします。\nそれ以外はおまかせします。\nブライアン\nこちらも眼鏡の有無差分をお願いします。\n口に飴の白い棒を咥えてる状態差分もお願いします。\n（↑描いてる際になんか合わないなってなったら省いてもらって大丈夫です。）\n▶︎構図、背景、表情等\n前回同様おまかせします。\n先生の自由に描いていただいて結構です。\n\nここまで書きましたが先生の思うように変更、追加していただければと思いますので、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/62", "thumbnail_src": "https://si.imgix.net/fa69507b/uploads/origins/36a5ca5a-16f9-4644-adf8-e475ed0a2709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68c5569e27fe5692144d4f024aff8cf5", "thumbnail_srcset": "https://si.imgix.net/fa69507b/uploads/origins/36a5ca5a-16f9-4644-adf8-e475ed0a2709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68c5569e27fe5692144d4f024aff8cf5, https://si.imgix.net/fa69507b/uploads/origins/36a5ca5a-16f9-4644-adf8-e475ed0a2709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2e4dd21d989180d39c48eed8b71b702 2x, https://si.imgix.net/fa69507b/uploads/origins/36a5ca5a-16f9-4644-adf8-e475ed0a2709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b2162efb58691ef47813bb240bb28fe 3x", "genre": "art", "nsfw": false, "body": "はじめまして！Twitterのイラストを拝見し、リクエストさせていただきました。\n\n依頼内容\nウマ娘からミホノブルボンをお願いします。\n衣装は勝負服で構図はお任せしたいのですが、カメラ目線で描いていただけると嬉しいです。\n\n今回リクエストしたイラストをTwitterのアイコンに使用させていただきたいのですが、こちらは可能でしょうか？\n\nお時間に余裕があれば、何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/61", "thumbnail_src": "https://si.imgix.net/adc8d684/uploads/origins/54de8551-e611-4949-b998-7016a639138c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fdec4b84521877a9d72c8b806df49af", "thumbnail_srcset": "https://si.imgix.net/adc8d684/uploads/origins/54de8551-e611-4949-b998-7016a639138c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fdec4b84521877a9d72c8b806df49af, https://si.imgix.net/adc8d684/uploads/origins/54de8551-e611-4949-b998-7016a639138c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fb3653010681535bbc5f02feeba1238 2x, https://si.imgix.net/adc8d684/uploads/origins/54de8551-e611-4949-b998-7016a639138c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b787624e5a2f4538aab67cf388c646b9 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nいつも先生のウマ娘のイラストを拝見させていただいております。そこで今回先生お願いしたいイラストですが\nビワハヤヒデ&ナリタブライアンをお願いします！！！\n▶︎服装\n・黒スーツ\n▶︎装飾品等\nハヤヒデorブライアンどちらかにサングラス（目がサングラスの上部分からチラッと見えてるとありがたいです。）先生さえ良ければ差分があると助かる命があります...！\n他持っているもの等は先生にお任せいたします！！これ合ってるかもってものは追加していただけると非常にありがたいです。\n▶︎背景や構図等\n・こちらもお任せします。\n\nほとんどおまかせになってしまってますが先生のビワハヤヒデ&ナリタブライアンの姉妹イラストを是非見たいのでよろしくお願いします！！！！", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/60", "thumbnail_src": "https://si.imgix.net/715cb185/uploads/origins/2ac585ac-9e6a-440f-a284-79acd1808590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be13fcdfd800d3493312f702292ce95a", "thumbnail_srcset": "https://si.imgix.net/715cb185/uploads/origins/2ac585ac-9e6a-440f-a284-79acd1808590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be13fcdfd800d3493312f702292ce95a, https://si.imgix.net/715cb185/uploads/origins/2ac585ac-9e6a-440f-a284-79acd1808590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fe640ac3a59d28633caf73a76e9d8d6 2x, https://si.imgix.net/715cb185/uploads/origins/2ac585ac-9e6a-440f-a284-79acd1808590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=789dd80b8aba831864fbb2d8b9dfaa5f 3x", "genre": "art", "nsfw": false, "body": "すいません、こちらの都合で確認したい事があって、一旦キャンセルさせて頂いておりました。ご迷惑をおかけしました。\nもう一度同内容の依頼をお願いしてもよろしいでしょうか？\n\n依頼内容\n弓矢を構えているリゼ皇女で 衣装と髪型が こちらのポスターの左にいる「アベンジャーズ」のドラマ「ホークアイ」に登場する「ケイト・ビショップ」の衣装で 衣装の資料① https://twitter.com/frc_watashi_ame/status/1458469199920066561?s=21 衣装の資料② 下の2枚が該当の登場人物です。 弓矢のデザインなどは簡易的でも大丈夫です。 https://twitter.com/hasbropulse/status/1466820773151182877?s=21 衣装の資料③ https://twitter.com/hawkeyeofficial/status/1462480934700294155?s=21 髪型は役者さんがインスタにあげていたこちらに近い物でお願いします。 https://www.instagram.com/p/CTv01DoMeI0/?utm_medium=copy_link 衣装の色はリゼ皇女に合わせた青系か元の衣装のそのままにするか悩んだのですが、先生のお好みでお願い致します。 具体的なポーズや構図も先生にお任せ致しますが、表情は鼻に絆創膏でおでこにサングラスをかけていて背景は雪が吹いてる夜空でお願いします。\n\nhttps://twitter.com/marvelstudios_j/status/1452469975508209671?s=21", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/59", "thumbnail_src": "https://si.imgix.net/6136439b/uploads/origins/408ae1aa-b5d7-48ad-a0e6-170ffea5cc99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03422b2de4c403a58ce4de9665331376", "thumbnail_srcset": "https://si.imgix.net/6136439b/uploads/origins/408ae1aa-b5d7-48ad-a0e6-170ffea5cc99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03422b2de4c403a58ce4de9665331376, https://si.imgix.net/6136439b/uploads/origins/408ae1aa-b5d7-48ad-a0e6-170ffea5cc99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8194b384a89123b7a3903e4537393e2c 2x, https://si.imgix.net/6136439b/uploads/origins/408ae1aa-b5d7-48ad-a0e6-170ffea5cc99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9214394bdebce949279508c4f719698 3x", "genre": "art", "nsfw": false, "body": "閃の軌跡Ⅱのアルティナ・オライオンをリクエストしたいです。\n細かい指定は特にありませんが、しゃがむor座って可能な範囲で股周辺を強調して描いていただきたいです。\n\nhttps://www.falcom.co.jp/sen2/chara/sub03.html\n\nhttps://dengekionline.com/elem/000/000/836/836218/02_cs1w1_585x880.jpg", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/58", "thumbnail_src": "https://si.imgix.net/93163d5b/uploads/origins/7857c466-c321-42ff-911c-7ff967edd354?bg=%