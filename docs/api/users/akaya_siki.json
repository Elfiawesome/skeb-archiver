c-9396-d8053cc22550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06f878b49bebd34862dd67f26f482015", "thumbnail_srcset": "https://si.imgix.net/567b4601/uploads/origins/bf5988c0-170e-426c-9396-d8053cc22550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06f878b49bebd34862dd67f26f482015, https://si.imgix.net/567b4601/uploads/origins/bf5988c0-170e-426c-9396-d8053cc22550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b41ee39b71bfe953cab04d87667c8b4 2x, https://si.imgix.net/567b4601/uploads/origins/bf5988c0-170e-426c-9396-d8053cc22550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c00bac79a84062af631a1bb3b9178e5 3x", "genre": "art", "nsfw": false, "body": "この度依頼させて頂きたいイラストは「PSYCHO-PASS」の登場人物「狡噛慎也」のとにかくカッコイイイラストです。\nシチュエーションとしましては作中に出てくる「ドミネーター」という銃を目標に捉えて撃つ瞬間を切り取った様な感じです。真剣な面持ちで躍動感溢れる感じが好ましいです。\n銃の構え方に関しましては躍動感溢れると思われた構えでお願いします。両手や片手持ち等は問いません。もしドミネーターより拳銃の方が良いと感じましたら拳銃でも構いません。\n姿格好は下記の公式サイトにあるスーツ姿でお願いします。ネクタイを下げる、前を開ける等アレンジは何でもして頂いて大丈夫です。\n\n\n銃(ドミネーター)の参考サイト\nhttps://cerevo.shop-pro.jp/?pid=176462199&_ga=2.227009054.2086678349.1756409557-1062558947.1756409557\n公式サイト\nhttps://psycho-pass.com/archive/sp/character/", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/84", "thumbnail_src": "https://si.imgix.net/148508fe/uploads/origins/e4843972-da74-4cd8-9b16-52cb0576f9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471672d7113445246c4f13ae007e90db", "thumbnail_srcset": "https://si.imgix.net/148508fe/uploads/origins/e4843972-da74-4cd8-9b16-52cb0576f9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471672d7113445246c4f13ae007e90db, https://si.imgix.net/148508fe/uploads/origins/e4843972-da74-4cd8-9b16-52cb0576f9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71f0c249faceaa38df1e7b0a1e966fb2 2x, https://si.imgix.net/148508fe/uploads/origins/e4843972-da74-4cd8-9b16-52cb0576f9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a726cdf734c2b780fb9f8826ff21786 3x", "genre": "art", "nsfw": false, "body": "先日はご迷惑をおかけして申し訳ありませんでした。改めてリクエストをお願い出来ればと思います。\nキャラクターは、カプコンのヴァンパイアセイヴァーという作品の『リリス』になります。側面からの視点を入れていただければ、構図や背景その他すべてお任せ致します。\n\nご検討いただければ幸いです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/83", "thumbnail_src": "https://si.imgix.net/7b34e663/uploads/origins/e328713d-69dd-41e0-84c8-e0b71625503d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f47613a528ff441b30e92dab86b47be7", "thumbnail_srcset": "https://si.imgix.net/7b34e663/uploads/origins/e328713d-69dd-41e0-84c8-e0b71625503d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f47613a528ff441b30e92dab86b47be7, https://si.imgix.net/7b34e663/uploads/origins/e328713d-69dd-41e0-84c8-e0b71625503d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30713ba350493f203c146df922461941 2x, https://si.imgix.net/7b34e663/uploads/origins/e328713d-69dd-41e0-84c8-e0b71625503d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c81ddc6637f8db15dc1f306cfa29682 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nもしよければうちの子のアクリスをお願いします。\n少し抜けた所のある明るく優しい上位種の鹿のお姉さん(180cm)になります。\n瞳の色はターコイズブルーです。\n表情はドヤッとした感じで、ポーズはお任せします。\n服装は資料のtype-Aでお願いします。\n\n以上になります。\nお忙しいところ恐縮ですが、ご一考よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1sAtEwb2X3dK9LecXcmqkOQXXMmUZbeGl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/82", "thumbnail_src": "https://si.imgix.net/24077986/uploads/origins/e8d8c824-13aa-4b0d-8ad0-27ee949978a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928d5ae7f3d27659864ecdd7777005cd", "thumbnail_srcset": "https://si.imgix.net/24077986/uploads/origins/e8d8c824-13aa-4b0d-8ad0-27ee949978a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928d5ae7f3d27659864ecdd7777005cd, https://si.imgix.net/24077986/uploads/origins/e8d8c824-13aa-4b0d-8ad0-27ee949978a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aed7ca063e62ed1f63d4cc487141b05c 2x, https://si.imgix.net/24077986/uploads/origins/e8d8c824-13aa-4b0d-8ad0-27ee949978a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4aad822043449e7ec22cabd30a47ca2 3x", "genre": "art", "nsfw": false, "body": "skeb再開ありがとうございます！\nお久しぶりですぽいとんです！\n今回は最近新モデルの発表のあった個人勢天使代行ラングドシャさんを描いていただきたいと思いリクエスト送らせていただきます！\n\n以前描かれていたメジロアルダンのような脚と髪の毛の映えるポーズで通常衣装のラングドシャさんを！\n背景は一色もしくは最近描かれているような両サイドに黒があるやつ(どちらもかっこよくて好き)のどちらかでお願いしたいと思います！\nお忙しいとは思いますがどうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/81", "thumbnail_src": "https://si.imgix.net/e1f0824d/uploads/origins/4db7a778-b4e3-436a-baa3-3c8519221ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20c80d2f560edb6786bb059e8fc5ad1a", "thumbnail_srcset": "https://si.imgix.net/e1f0824d/uploads/origins/4db7a778-b4e3-436a-baa3-3c8519221ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20c80d2f560edb6786bb059e8fc5ad1a, https://si.imgix.net/e1f0824d/uploads/origins/4db7a778-b4e3-436a-baa3-3c8519221ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a43d42a50b50cfd6ddb2cd8e5fbafec 2x, https://si.imgix.net/e1f0824d/uploads/origins/4db7a778-b4e3-436a-baa3-3c8519221ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b59f89bac4005f3e940465e2e1175a17 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストを楽しませていただいております！ぽいとんです！\n今回は個人V見習い錬金術師VTuber蒼咲ユウリさんをお願いしたいです！\n衣装は青のチャイナドレスでスリットが深いと大変嬉しいです！\nユウリさんはお胸と脚線が大変魅力的なので映える感じの構図があればそちらをよろしくお願いいたします！\n普段からふふーんっ！とドヤ顔まじりの笑いからをされるので表情は是非「チャイナユウリさん可愛かろー？」と言いそうなドヤ顔笑顔でおねがいいたします！\n(肉まんとか中華料理的なやつが周りや背景にたくさんあるとユウリさんぽさが出て私が嬉しいです！優先度低)\nお忙しいとは思いますがよく食べよく笑う笑顔の素敵な推しをよろしくお願いします！\n\nhttps://x.com/aosaki_yuri/status/1797291605864694181?s=46&t=NDUP6SXK9O_SH1JIurB2SQ", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/80", "thumbnail_src": "https://si.imgix.net/c81afcea/uploads/origins/5c09f171-b4a1-4c31-ade8-667fef9c7b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb54c943d065c194fd7a8f73c2e87c23", "thumbnail_srcset": "https://si.imgix.net/c81afcea/uploads/origins/5c09f171-b4a1-4c31-ade8-667fef9c7b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb54c943d065c194fd7a8f73c2e87c23, https://si.imgix.net/c81afcea/uploads/origins/5c09f171-b4a1-4c31-ade8-667fef9c7b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f493014f80067c59c070d700ecf52483 2x, https://si.imgix.net/c81afcea/uploads/origins/5c09f171-b4a1-4c31-ade8-667fef9c7b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a56cc0bbe9fd4a864c6c076d6b03f259 3x", "genre": "art", "nsfw": false, "body": "素敵なイラストをいつもありがとうございます。\nイラストご依頼失礼いたします。\n\n【用途】\n個人鑑賞とコチラのキャラクターを使用しているやさと(@yasato83)さんへプレゼントするFAとなります。\n納品していただいた後、Skebよりサンプル画像を専用タグ#鳴と高 へシェア、DMで納品していただいたイラストをやさとさんへ共有させていただく予定になります。\n\n【描いていただきたいキャラクター】\nやさとさんがTRPGというゲームにて使用されている『鳴雷 核』です。\n\n以下、やさとさんの一部引用になります。\n\n●鳴雷核・25歳/♂/185cm  \n公安警察で趣味で爆弾を作ったりカスタマイズする人。 一見陽気な性格に見えて闇が深く抱え込みがちでなんだかんだプライドが高い。割と何でもそつなくこなすタイプだが拳銃はトラウマがあって使えず女性が苦手。 陽気で軽いオーラのくせにどこかいやらしい男で、いつも恋人をからかっています。  八重歯があり体からはレモンの香りがします。 恋人の全てを愛しており、事ある毎にすぐ可愛がります。 \nイメージカラーは黄色です。  \n\n【資料】 \nhttps://drive.google.com/drive/folders/1-7faRTy42Iy4m5MwD9fRV8aQYIVbvpIB\n\n【構図/衣装について】\n複数の衣装がありますがメインでよろしくお願いいたします。\n\n料金不足や受けられなければ再送要請や拒否をしていただいて問題ありません。\nご検討よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@akaya_siki/works/79", "thumbnail_src": "https://si.imgix.net/3e9c403d/uploads/origins/c5534f41-a163-444e-a9bb-b0ce79ea0c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d01e3871d626d987b1d9c5086979a9de", "thumbnail_srcset": "https://si.imgix.net/3e9