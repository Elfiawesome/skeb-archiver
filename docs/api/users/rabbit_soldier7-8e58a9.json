fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0bd0cd3bfe873d2bc7620f5dd475914 2x, https://si.imgix.net/f518d75f/uploads/origins/ac9a828d-5e58-405a-bdc4-41821cc0c11a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4a1065bab6b355fbf7ccf51f4ebad8a 3x", "genre": "art", "nsfw": false, "body": "いのりちゃんこんにちは～～～～！！\nいつもいつもいつもいつもお世話になってます、毎度のリクエストです。\n\n今回のリクエスト内容はShadowverseのラティカというキャラでお願いしたいです。\n下記参考資料です。\n\n画像\nhttps://svgdb.me/cards/121141020\nhttps://svgdb.me/cards/114141020\nhttps://svgdb.me/cards/722141010\n\n動画\nhttps://x.com/shadowverse_jp/status/1304742638101262336\n\nいつも通り構図はお任せでお願いしたいです。\nダウナー系のギャルっ子なイメージです。\n\nご検討よろしくお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@rabbit_soldier7/works/12", "thumbnail_src": "https://si.imgix.net/927914a9/uploads/origins/483d7716-e7b7-4af3-a104-bec63e755637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a4707b09691ab0aaacde4f8dd54645b", "thumbnail_srcset": "https://si.imgix.net/927914a9/uploads/origins/483d7716-e7b7-4af3-a104-bec63e755637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a4707b09691ab0aaacde4f8dd54645b, https://si.imgix.net/927914a9/uploads/origins/483d7716-e7b7-4af3-a104-bec63e755637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c9d4911b49d586fc98ec0de28f6a030 2x, https://si.imgix.net/927914a9/uploads/origins/483d7716-e7b7-4af3-a104-bec63e755637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a6075c57cb9eb79f19920037be72084 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。\n新着イラストに目を惹かれました。https://skeb.jp/@rabbit_soldier7/works/9\n過去作品やXのメディア欄も拝見し、\n立体感のある綺麗な髪の表現、力のある目を始めとした豊かな表情、陰影やシワが巧い服飾、\nと魅力的な点がたくさんあり、是非イラストをお願いしたいと思いました。\n\n少しマニアックな要素を含みますが、以下のようなオリキャラの女の子を描いていただけませんでしょうか。\n以下は参考画像ですが、セーラー服のデザインや表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "created_at": "", "completed_at": ""}, {"path": "/@rabbit_soldier7/works/11", "thumbnail_src": "https://si.imgix.net/0179068a/uploads/origins/9700a7d7-f96c-4740-a88c-91b3a698a175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99dd4c2aa3e16c5ebbf06ff43654b01", "thumbnail_srcset": "https://si.imgix.net/0179068a/uploads/origins/9700a7d7-f96c-4740-a88c-91b3a698a175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99dd4c2aa3e16c5ebbf06ff43654b01, https://si.imgix.net/0179068a/uploads/origins/9700a7d7-f96c-4740-a88c-91b3a698a175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=befb4d5f6555f703aa74e188adb551e9 2x, https://si.imgix.net/0179068a/uploads/origins/9700a7d7-f96c-4740-a88c-91b3a698a175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03b35a6bec64a276b6e6956777f07613 3x", "genre": "art", "nsfw": false, "body": "いのりさんこんにちは～！相変わらずのリクエストです、5回目らしいです。\n毎度毎度ですが、よろしくお願いします！\n\n今回のリクエストはオーバーウォッチのメイちゃんで、コーデはパジャメイでお願いします…！\n\n参考：https://x.com/kurae_wo_sanma/status/1877251771678019686\n\n構図はいつも通りでお願いします！\n最近メイちゃんにハマっているので可愛い感じで大丈夫だと思います！", "created_at": "", "completed_at": ""}, {"path": "/@rabbit_soldier7/works/10", "thumbnail_src": "https://si.imgix.net/95140b17/uploads/origins/474933d5-bd71-45fd-b61a-3042c75fb625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53705c6c77ae190c69131fc51e4fdf7", "thumbnail_srcset": "https://si.imgix.net/95140b17/uploads/origins/474933d5-bd71-45fd-b61a-3042c75fb625?bg=