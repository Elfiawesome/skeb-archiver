/uploads/origins/58664dda-6c6d-4a15-8a45-61e03a7c439a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1f7eb069540bd69909b7545459c46e2 2x, https://si.imgix.net/b8e7ce65/uploads/origins/58664dda-6c6d-4a15-8a45-61e03a7c439a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff62b13ac1dc7edea4c77c2804a619d1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fujifuji0330/works/18", "thumbnail_src": "https://si.imgix.net/b2cb8f00/uploads/origins/f6729642-f342-4fb3-b957-75dba9a32b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4e5d1f2df4c9f8aa638eadb512d4f98", "thumbnail_srcset": "https://si.imgix.net/b2cb8f00/uploads/origins/f6729642-f342-4fb3-b957-75dba9a32b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4e5d1f2df4c9f8aa638eadb512d4f98, https://si.imgix.net/b2cb8f00/uploads/origins/f6729642-f342-4fb3-b957-75dba9a32b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ac06622bdb56f18d06b71e5cb490a0e 2x, https://si.imgix.net/b2cb8f00/uploads/origins/f6729642-f342-4fb3-b957-75dba9a32b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efb2a8a6d418a44c75a20711423f7f16 3x", "genre": "art", "nsfw": false, "body": "はじめまして！合成音声好きな海外民はこちらです。\nいつもTwitterにてFUJI藤様の絵を拝見させていただております！\n前のFUJI藤様が描いてくださった双葉湊音ちゃん（https://x.com/fujifuji0330/status/1800497000066215953/photo/1）がとても気に入っています。\n\n今回のリクエストは、FUJI藤様に无袖バンド衣装を着て、エレキギターを構えた湊音ちゃんのイメージを描いて欲しいです。（无袖バンド衣装のスタイルにはこの2枚のキャラクター立ち絵に参照できます：\n花園たえ:https://drive.google.com/file/d/1VjM-a8sZ4ZFKqM-LzK9r6YB3O69DhAYe/view?usp=sharing\nhttps://drive.google.com/file/d/18EV2VXPLFiXEgRXmcl0zt1La74oNrnoQ/view?usp=sharing\n星乃一歌：https://drive.google.com/file/d/1VNp2lSjbvGApCdkC4wZLDTzPXF-W2FwT/view?usp=sharing）\n\nエレキギターの外観は双葉湊音ライプのコラボエレキギター（https://www.futabaminato.com/news/359/\nhttps://x.com/futabaminato/status/1759927588984881531/photo/1）\n\nポージング：湊音ちゃんはピックを持つ右手の甲で頬の汗を拭った。\n\n使用用途はSNSやtwitterのアイコン、スマホの壁紙等。\n以上、設定等もあくまで参考程度に、自由に改変·解釈等していただいても構いません。お忙しいところ、お手数ですが、ご検討いただけますと幸いです。どうそよろしくお願いいたします。\n\nお忙しいところ、お手数ですが、ご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@fujifuji0330/works/17", "thumbnail_src": "https://si.imgix.net/56e98472/uploads/origins/22d54909-5a4b-40f9-8f03-c7f8a9d22f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d92ba81bd2cb3be84d849d7af980844", "thumbnail_srcset": "https://si.imgix.net/56e98472/uploads/origins/22d54909-5a4b-40f9-8f03-c7f8a9d22f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d92ba81bd2cb3be84d849d7af980844, https://si.imgix.net/56e98472/uploads/origins/22d54909-5a4b-40f9-8f03-c7f8a9d22f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92571d744ee78fd7d56349035827836e 2x, https://si.imgix.net/56e98472/uploads/origins/22d54909-5a4b-40f9-8f03-c7f8a9d22f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bb22a39cb754c74f49e6d5eb91c554d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fujifuji0330/works/16", "thumbnail_src": "https://si.imgix.net/0e3cdf4c/uploads/origins/f6e2e344-dbe2-49ee-bdfa-1fe9aeffcb37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8f3823b36288f8a54dbdf1305bd699", "thumbnail_srcset": "