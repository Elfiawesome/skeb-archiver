a96-8760-e8ddd8c1fa44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a9754fb988b2a869ff39093ca83727", "thumbnail_srcset": "https://si.imgix.net/0cec7cc1/uploads/origins/c1c22e66-af14-4a96-8760-e8ddd8c1fa44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a9754fb988b2a869ff39093ca83727, https://si.imgix.net/0cec7cc1/uploads/origins/c1c22e66-af14-4a96-8760-e8ddd8c1fa44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6a3ddb42fa64aac57b981161c849f89 2x, https://si.imgix.net/0cec7cc1/uploads/origins/c1c22e66-af14-4a96-8760-e8ddd8c1fa44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74c534626ee0d7ef9b9f85784b4524ba 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n私の猫娘のキャラクターをぜひあなたに描いていただきたいです。\n\nオーレリアというFFXIVのモンスターに捕まったキャラクターを描いてほしいです。\nhttps://www.deviantart.com/mintygreytea/art/FFXIV-Field-Notes-Aurelia-909046992\n\nオーレリアは私を驚かせ、その爪と触手で私を人質に取り、私のキャラクターにしがみつきました。\nオーレリアは私に毒を注入し、私の体をオーレリア自身の皮膚のようにゼリー状にしてしまった。\nこれがその例だ。\nhttps://twitter.com/BumbleBorb/status/1098133794207412225\n(この画像の奇妙な黒いものは無視してください）\n\nオーレリアは触手を使って私の膣から体液を取り出すかもしれない（これは任意）。\n\nあなたは私を服を着て描くか、裸で描くか選ぶことができる。 どちらか一方だけ）。\n\n彼女がノーマルなバージョンと、オーレリアのようにゼリー状になったバージョンを見てみたい。\n\n\nありがとうございます！:3\n\nhttps://skeb.dj-fpaul.de/SKEB60", "created_at": "", "completed_at": ""}, {"path": "/@nezumo6/works/51", "thumbnail_src": "https://si.imgix.net/e703a5a3/uploads/origins/2c4bd268-819f-419b-9626-e3ca3b443ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b838a1c95de2a46570159ec56df64c66", "thumbnail_srcset": "https://si.imgix.net/e703a5a3/uploads/origins/2c4bd268-819f-419b-9626-e3ca3b443ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b838a1c95de2a46570159ec56df64c66, https://si.imgix.net/e703a5a3/uploads/origins/2c4bd268-819f-419b-9626-e3ca3b443ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=865fee1249956b963f3746123261d3b4 2x, https://si.imgix.net/e703a5a3/uploads/origins/2c4bd268-819f-419b-9626-e3ca3b443ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a74537c78dc6f69a409dd07e36d5230 3x", "genre": "art", "nsfw": true, "body": "前回の作品がとても気に入ったので、今回もモデルのゼナリエルと友人のフロストとのNSFW作品をお願いしたかったんだ。\n\nこのリクエストは、この作品の続編を意図しています。https://skeb.jp/@reiairi1/works/65\n\nZenarielは紫の髪のウミウシの女の子で、Frostは青い髪の猫の女の子ですが、尻尾は彼女の髪の色と同じような薄い青のソリッドで、縞模様のないものにしてください。フロストの胸もゼナリエルと同じような大きさで、参考資料より大きくしてください。\n\nゼナリエルのメガネと手のアクセサリーをつけて、ボンデージ姿のまま。フロストは相変わらずグローブとブーツだけだが、今度はフロストをフタナリにしてほしい。フロストはゼナリエルの首輪についた鎖を引きながら、後ろからゼナリエルを犯してほしい。\n\nできればX線とオーガズムのザーメン差も欲しい。\n\nhttps://drive.google.com/drive/folders/1Loq7gddrG2-sp2kmVF9zjivypC8VxMg8", "created_at": "", "completed_at": ""}, {"path": "/@nezumo6/works/50", "thumbnail_src": "https://si.imgix.net/509849a3/uploads/origins/3734e3fc-1b06-4f68-b6f7-ef691ac4c00b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a198210802bdfb1dfe13fc7a83132ec9", "thumbnail_srcset": "https://si.imgix.net/509849a3/uploads/origins/3734e3fc-1b06-4f68-b6f7-ef691ac4c00b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a198210802bdfb1dfe13fc7a83132ec9, https://si.imgix.net/509849a3/uploads/origins/3734e3fc-1b06-4f68-b6f7-ef691ac4c00b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b77487e44d4b4a7440521df7e21a39aa 2x, https://si.imgix.net/509849a3/uploads/origins/3734e3fc-1b06-4f68-b6f7-ef691ac4c00b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9788dd4f615307cffe2088388618684e 3x", "genre": "art", "nsfw": true, "body": "いつもリクエストを受けていただきありがとうございます。\n今回もメタモンをポケモンカードのキャラクターに変身する内容をお願いしたいです。\nメタモンはポケモンカードのオリーヴに変身することを要求されます。変身したオリーヴの髪も服もドロドロしています。\nそして変身したオリーヴは、椅子に座って、無表情でトレーナーさんに足コキを始めました。オリーヴはおっぱいを露出して、片手に自分のヒールを持って、片手にデバイスを持っている。トレーナーさんはすでに精液を出して、一部はオリーヴの足元に付けている。\n足コキする時は擬態の制御が難しいなので、オリーヴのももの内側は少し溶けて、髪も服も一部粘液状になっていました。ヒールとデバイスも一部溶けている様子です。\nトレーナーさんの顔出しはいらないです。\n