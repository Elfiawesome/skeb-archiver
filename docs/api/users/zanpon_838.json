2-40ac-8917-d57a34a36d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd5fb82dac1e83cc55845f63e260214", "thumbnail_srcset": "https://si.imgix.net/7d7452a4/uploads/origins/9e6e8a75-0d12-40ac-8917-d57a34a36d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd5fb82dac1e83cc55845f63e260214, https://si.imgix.net/7d7452a4/uploads/origins/9e6e8a75-0d12-40ac-8917-d57a34a36d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cedb232fc58a94468c24c7d33752af3 2x, https://si.imgix.net/7d7452a4/uploads/origins/9e6e8a75-0d12-40ac-8917-d57a34a36d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d60a698113de7ff306d96982eaa17e5 3x", "genre": "art", "nsfw": true, "body": "胸と乳首の描き方が好きです！ファイアーエムブレムのエイリークのイラストをお願いしたいです。\n\nベッドに仰向けで寝ていて、笑顔で優しくセックスを誘っています。全裸です。ポーズはお任せします。\n\n男性の体の部分は見えない。\n\nセックスの後、彼女の胸に精液がつき、膣から漏れているバリエーションが欲しい。\n\n胸と太ももが見えるようにしてほしい。カメラアングルは抱き枕カバーのような感じでお願いします。よろしくお願いします！\n\nhttps://drive.google.com/drive/u/0/folders/1Y40yy-0B88mNh9LiV6JFDYTCBULxijLa", "created_at": "", "completed_at": ""}, {"path": "/@zanpon_838/works/32", "thumbnail_src": "https://si.imgix.net/0f86d87c/uploads/origins/fc0082d1-8fd9-46c6-8233-f978a0e4e5ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=194b0c2f6c2bfd241ab25f17f2c2bd9c", "thumbnail_srcset": "https://si.imgix.net/0f86d87c/uploads/origins/fc0082d1-8fd9-46c6-8233-f978a0e4e5ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=194b0c2f6c2bfd241ab25f17f2c2bd9c, https://si.imgix.net/0f86d87c/uploads/origins/fc0082d1-8fd9-46c6-8233-f978a0e4e5ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a3dbcabf9c96b97d6b0ea6aadc92405 2x, https://si.imgix.net/0f86d87c/uploads/origins/fc0082d1-8fd9-46c6-8233-f978a0e4e5ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1421f62e8c865ab62f2cd72e7f57c87c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nラブライブ・スーパースターのマルガレーテ・ウィーンを依頼したい！\n\nマルガレーテがシャワーを浴びているところです。彼女の顔と胸はガラスに押し付けられています。彼女の至福の表情をお願いします。できれば射精の違いもお願いします。\n\nさらに、もしよろしければ、フタナリ渋谷かのんに後ろから犯されてください。ダメなら男性で十分です。\n\nマルガレーテ - https://imgur.com/a/SSMTteu\nかのん - https://imgur.com/a/MRVLNg0\n構成例 - https://imgchest.com/p/ljyq853edy2\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@zanpon_838/works/31", "thumbnail_src": "https://si.imgix.net/aa840a27/uploads/origins/64fea2fa-fd04-4dd0-93a9-5764abdeb035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46aec022a03e5e796e32817c5939a81a", "thumbnail_srcset": "https://si.imgix.net/aa840a27/uploads/origins/64fea2fa-fd04-4dd0-93a9-5764abdeb035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46aec022a03e5e796e32817c5939a81a, https://si.imgix.net/aa840a27/uploads/origins/64fea2fa-fd04-4dd0-93a9-5764abdeb035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ba6521b0379ad27e7629f2b02755a1a 2x, https://si.imgix.net/aa840a27/uploads/origins/64fea2fa-fd04-4dd0-93a9-5764abdeb035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=004d1145d1706812e195de1b383cf64d 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\n今回は、安養寺姫芽ちゃんを正常位でぶち犯してるイラストをお願いしたいです。\n\n具体的な構図の指定としましては、姫芽ちゃんは全裸でベッドの上で、下リンク先のイラストの様に枕を掴んでよがっている様子でお願いします。また、シーツ代わりに姫芽ちゃんのパーカーを姫芽ちゃんの下に敷いて見えるようにしてほしいです。姫芽ちゃんは全裸なので、パーカーを袖に通しているような構図ではないです。また、お腹は極力隠さない構図で、お臍は絶対に隠さないようにお願いしたいです。\n\nhttps://skeb.jp/@eniraka80/works/32\n\nまた、今回も絶頂差分と事後差分を描いていただきたいです。断面図は不要です。\n\n絶頂差分の表情はお任せします。めっちゃ激しい感じでお願いしたいです。\n事後差分の表情は朦朧とした意識の中、焦点の合わない目で虚空を見ながら舌をダランと情けなく垂らしてる表情でお願いします。また、中出しされた快感でイくのが止まらなくて腰をガクガク震わせてる風に描いていただきたいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@zanpon_838/works/30", "thumbnail_src": "https://si.imgix.net/e6d399af/uploads/origins/08053b63-0934-4454-889c-d399509bdfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36d99