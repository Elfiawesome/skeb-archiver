71a-ae3a5f4ae8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcdb87d7e15328d1d0a81226d7ad39ff", "thumbnail_srcset": "https://si.imgix.net/4b7df252/uploads/origins/73977eb3-f728-487d-a71a-ae3a5f4ae8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcdb87d7e15328d1d0a81226d7ad39ff, https://si.imgix.net/4b7df252/uploads/origins/73977eb3-f728-487d-a71a-ae3a5f4ae8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b257581fd4a29cb055f0e590ad30723 2x, https://si.imgix.net/4b7df252/uploads/origins/73977eb3-f728-487d-a71a-ae3a5f4ae8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62df4d3467e5763bb098d5fb2ac166b8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/15", "thumbnail_src": "https://si.imgix.net/0674607a/uploads/origins/d98b3b37-263d-4005-b7f5-a6b3c57ce0db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeabf81a9686f8b82200bb318036b69a", "thumbnail_srcset": "https://si.imgix.net/0674607a/uploads/origins/d98b3b37-263d-4005-b7f5-a6b3c57ce0db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeabf81a9686f8b82200bb318036b69a, https://si.imgix.net/0674607a/uploads/origins/d98b3b37-263d-4005-b7f5-a6b3c57ce0db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b88ace32fe9402b3ab4eb3dbf2d8b69a 2x, https://si.imgix.net/0674607a/uploads/origins/d98b3b37-263d-4005-b7f5-a6b3c57ce0db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d76617022de52f399c09d0177eb76066 3x", "genre": "art", "nsfw": true, "body": "はじめまして！①催眠にかかってしまい田んぼの真ん中で二人並んでカカシの様にTポーズしているFate／プリズマイリヤシリーズの遠坂凛とルヴィアをお願いします。\n②時間が経ち夕方になりTポーズのまま放置されてる状態でサラシがはだけて乳首が見える状態。\n\n二人の表情は無表情で目のハイライトは無しでお願いします。それと口の端からヨダレを垂らしてください。服装は二人とも上はサラシのみで下はふんどしで、風でアソコが見えてる状態(陰毛)あり。麦わら帽子と軍手をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/14", "thumbnail_src": "https://si.imgix.net/e57dbda3/uploads/origins/0020156d-aa54-43e3-824c-b730f24b7e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e47249c3780b9912c84c88ffb8ca7f7f", "thumbnail_srcset": "https://si.imgix.net/e57dbda3/uploads/origins/0020156d-aa54-43e3-824c-b730f24b7e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e47249c3780b9912c84c88ffb8ca7f7f, https://si.imgix.net/e57dbda3/uploads/origins/0020156d-aa54-43e3-824c-b730f24b7e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc7ae176a108ae0daec874cc6e22a8fd 2x, https://si.imgix.net/e57dbda3/uploads/origins/0020156d-aa54-43e3-824c-b730f24b7e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2f14f915086d89122b93f8397a9bde2 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n空崎恋ちゃんの3作品を購入させていただきました。\nこのキャラが気に入ったので、リクエストさせていただきます。\n\n【内容】\n・体を改造して徹底的に催眠アプリをした空崎恋ちゃんが、想定通り催眠アプリを無効化するも普通にイチャラブセックスしてガチ恋結婚妊娠するシチュでお願いします。\n（設定上、前頭前皮質を守れば催眠アプリは無効化？）\n\n【その他】\n・空崎恋ちゃんが出ている作品とは無関係のパラレルワールド設定でお願いします。\n・元々が白黒作品かつ合計何ページになるか想像もつかないので、一旦おま金で依頼させてください。\n\nご検討をよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/13", "thumbnail_src": "https://si.imgix.net/c12598a6/uploads/origins/e899de4e-27fe-433e-8b38-36f29e0284a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4dca2e17734766ad3103925a6cd3296", "thumbnail_srcset": "https://si.imgix.net/c12598a6/uploads/origins/e899de4e-27fe-433e-8b38-36f29e0284a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4dca2e17734766ad3103925a6cd3296, https://si.imgix.net/c12598a6/uploads/origins/e899de4e-27fe-433e-8b38-36f29e0284a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f56a690c24529c99c3b44fe3f91f8d82 2x, https://si.imgix.net/c12598a6/uploads/origins/e899de4e-27fe-433e-8b38-36f29e0284a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd779f7da0f5ae7ec8cb1c4039ffc6c 3x", "genre": "art", "nsfw": false, "body": "ワンダーランドウォーズのイラストリクエストをお願いします。\n\nミクサが公園のブランコでゆらゆらと揺られて遊んでいるイラストをお願いしたいです。\n衣装は通常のポンチョ服で、表情は少し楽しそうに笑っている感じで。\nよろしくお願いします。\n\n(https://twitter.com/byakko_mikusa/status/1668942616443129856　こちらのURLにミクサの立ち絵の画像があります参考にどうぞ)", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/12", "thumbnail_src": "https://si.imgix.net/6e10e46d/uploads/origins/044511fc-18e6-4184-952d-93a4dcbc7ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77ff1174bd9ed1859654a9413b3d9b90", "thumbnail_srcset": "https://si.imgix.net/6e10e46d/uploads/origins/044511fc-18e6-4184-952d-93a4dcbc7ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77ff1174bd9ed1859654a9413b3d9b90, https://si.imgix.net/6e10e46d/uploads/origins/044511fc-18e6-4184-952d-93a4dcbc7ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f79ae1ac48e4b5b50961581c8c139431 2x, https://si.imgix.net/6e10e46d/uploads/origins/044511fc-18e6-4184-952d-93a4dcbc7ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6d069280ae54b9b181aaa87a3248c4 3x", "genre": "art", "nsfw": false, "body": "「ブルアカ生徒さんにガチ依存されてみた」シリーズが大好きで、今回初めて依頼させていただきます。\nよろしければ以下の内容でお引き受けいただけますと幸いです。\n\n【キャラクター】\n　プラナ（ブルーアーカイブ）\n【構図・背景等】\n　「ブルアカ生徒さんにガチ依存されてみた」っぽくプラナに依存されたいです…。\n　スマートフォンの壁紙（２０：９）に設定した時に画面内からこちらに迫ってきているような\n　構図でお願いします。\n　セリフや背景はお任せでお願いしたいですが、差分でセリフに宛名呼び(るるシア先生)入り\n　をいただけると依存度高そうで大変嬉しいです…！", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/11", "thumbnail_src": "https://si.imgix.net/45d5321b/uploads/origins/7f27d8d4-1ee1-4e60-bd4a-4fa5ff24892a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba321b02ce08c693f3f93898547ecfe", "thumbnail_srcset": "https://si.imgix.net/45d5321b/uploads/origins/7f27d8d4-1ee1-4e60-bd4a-4fa5ff24892a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba321b02ce08c693f3f93898547ecfe, https://si.imgix.net/45d5321b/uploads/origins/7f27d8d4-1ee1-4e60-bd4a-4fa5ff24892a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88f84578b3d1561d5382fcdcbc5c79d4 2x, https://si.imgix.net/45d5321b/uploads/origins/7f27d8d4-1ee1-4e60-bd4a-4fa5ff24892a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c34255ca849b7561ee3cd7f42d4d6d3b 3x", "genre": "art", "nsfw": true, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n漫画形式か、１シーンごとかはご負担が少ない方で(同じなら１シーン事で)お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/10", "thumbnail_src": "https://si.imgix.net/c63f2503/uploads/origins/44b385d3-7de0-4f2a-b5bb-0d2337cc032d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d64ce44d526c3a4b90f4db0e08ec628", "thumbnail_srcset": "https://si.imgix.net/c63f2503/uploads/origins/44b385d3-7de0-4f2a-b5bb-0d2337cc032d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d64ce44d526c3a4b90f4db0e08ec628, https://si.imgix.net/c63f2503/uploads/origins/44b385d3-7de0-4f2a-b5bb-0d2337cc032d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1285f6728d0c22f5ff5c801e757da71 2x, https://si.imgix.net/c63f2503/uploads/origins/44b385d3-7de0-4f2a-b5bb-0d2337cc032d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f38f60220cc325fa70f46b27d94120f1 3x", "genre": "art", "nsfw": false, "body": "にこるじゃっくだよ！\nそういえば俺YouTubeのアイコン何も設定してないなと思って、せっかくなのでえりんさんにお願いしようと思います！\n俺がYouTubeで活動していく上でイメージに合うようなアイコンを１つ描いて欲しいです\nできればTwitterのアイコンにも使わせてほしい🫰\n\n竜詩の時に一緒にプレイした時の俺のうさおをベースに顔アップで\nデフォルメでにこやかにしてもらえるとよき\n一応資料用としてURL貼っておくね\n\nこういったリクエストするの初めてだから困らせちゃったらごめんね！\nよろしくお願いします！\n\nhttps://twitter.com/nicolejackff14/status/1536727419956375552?s=46&t=K9_0yYw66WtZZs_KQ-jfOA", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/9", "thumbnail_src": "https://si.imgix.net/278b48c0/uploads/origins/d9aebde0-37b0-4602-bd5d-a28c10094cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53df6df90cb061e81053a8a94a22a3b1", "thumbnail_srcset": "https://si.imgix.net/278b48c0/uploads/origins/d9aebde0-37b0-4602-bd5d-a28c10094cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53df6df90cb061e81053a8a94a22a3b1, https://si.imgix.net/278b48c0/uploads/origins/d9aebde0-37b0-4602-bd5d-a28c10094cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4abc2631fde7eb17b0abbf9bc769d675 2x, https://si.imgix.net/278b48c0/uploads/origins/d9aebde0-37b0-4602-bd5d-a28c10094cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=106c35227bb94a4a9591e37a257529c0 3x", "genre": "art", "nsfw": false, "body": "※資料が不十分でしたので再度依頼させて頂きました。手間をかけさせてすみませんでした。\nこんにちは。今回の依頼内容を説明させて頂きます。\n\n今回依頼する内容は、ファンタシースターオンライン2ニュージェネシスと言うゲームでキャラクターを制作、使用している子たちをSDキャラにしたアイコンを描いて頂きたいのです。\n\nアイコンの内容ですが、文章を書くのが苦手なので資料URLの参考画像(Twitterのツイートで貼った画像)を混ぜて説明させて頂きます。参考画像の数が多く1つのツイートでは全て貼れなかったので、キャラの外観画像はそのツイートのリプで貼らせて頂きます。\nこの様な見えにくい方法しか取れず申し訳ございません。描いて頂きたいキャラは4人です。\n\n参考画像(以下画像)1-1のトレース素材の下にあるマシュマロを抱いてる二人組に、画像1-2の下のプレゼントボックスから出てるキャラの様な感じのポーズ(あくまでも参考なので描きやすい様に多少ポーズを変えても構いません)で抱きつかれてる感じでお願いします。\n\nキャラは画像1-1の右側のキャラを画像2の子「WH04HL-KRSW」に、左側を画像3の子「CR-WR98L」でお願いします。この子達の身体や顔にタツゥーの様なものが入っており、耳の形状も機械的な物ですが省略して大丈夫です。\n\n抱きつかれてる子の方ですが、こちらは体を画像4の様にデフォルメにして頂き頭部を自キャラにして貰いたいと思っております。\n抱きつかれてる子は右側は画像5の子「YWR27HL-KRSW2」に、左側は画像6の子「WR09HL-SPIRIT」でお願いします。\n\nなお参考画像の中にトレース素材が入っていますが、製作者様からは引用RTで使用したとツイートすれば問題ないと言われておりますので大丈夫です。\n\n依頼内容は以上です。どうかよろしくお願いします。\n\nhttps://twitter.com/Q31820024/status/1647092414778318848?s=20", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/8", "thumbnail_src": "https://si.imgix.net/be2dc8b0/uploads/origins/b7bd159e-32e9-4466-b983-4650daf86362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47afa07e15c74bb1c6d0bba2b17aaa5c", "thumbnail_srcset": "https://si.imgix.net/be2dc8b0/uploads/origins/b7bd159e-32e9-4466-b983-4650daf86362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47afa07e15c74bb1c6d0bba2b17aaa5c, https://si.imgix.net/be2dc8b0/uploads/origins/b7bd159e-32e9-4466-b983-4650daf86362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=706ba7287c3e86c214a19703f23dd6db 2x, https://si.imgix.net/be2dc8b0/uploads/origins/b7bd159e-32e9-4466-b983-4650daf86362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b91b0eeaaf22221dad8e22ddd420a320 3x", "genre": "art", "nsfw": true, "body": "御津波さくら様 こんにちは\n\nキャラクター：藤原妹紅(東方Project)\nhttps://dic.pixiv.net/a/藤原妹紅\n\nシチュエーション：無限月読に掛かり、神樹のツタに囚われる妹紅\n\n・月が輝いており明るい空を妹紅は虚ろな表情で空を見上げており、妹紅の眼球全体が薄紫色の波紋模様の物に変化している\n\n・包帯のようなツタが身体を覆い拘束し始めている\n\nシチュエーションの参考動画・画像：\nhttps://drive.google.com/file/d/1JoIOpZnT9x-KxauZIuf4YIM82eHNcIOt/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1tAyDBQ6wjXEO0sjrZ5qOW9wD5ih8PSBw/view?usp=drivesdk\n\n両目全体の参考画像\nhttps://drive.google.com/file/d/1XfGLU5CcszZwXPYfq1oaYMONb_Cs8oLz/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1KtOHQdQNaFdrDi8qoPEEtZBbFP8WrEP0/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/7", "thumbnail_src": "https://si.imgix.net/ef8a056e/uploads/origins/4b015160-60af-4633-8edc-50fff2e04dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc82a2ec7bd2f127f1e28ba6ab0f7225", "thumbnail_srcset": "https://si.imgix.net/ef8a056e/uploads/origins/4b015160-60af-4633-8edc-50fff2e04dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc82a2ec7bd2f127f1e28ba6ab0f7225, https://si.imgix.net/ef8a056e/uploads/origins/4b015160-60af-4633-8edc-50fff2e04dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47437e7b76fc8428f15b322d6f2ad165 2x, https://si.imgix.net/ef8a056e/uploads/origins/4b015160-60af-4633-8edc-50fff2e04dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=722145855bd52ba0522393fd7b9ad605 3x", "genre": "art", "nsfw": true, "body": "こんにちは、アートワークを依頼することはできますか？\n\nアークナイトのマッドロックをモチーフにしたNSFWアートワークをお願いしたいのですが、詳細はこちらです。\n\n彼女はベッドに横たわり、手を持ち上げてベッドフレームに縛り付けています。マドロックは医者にこれを止めるように頼むが、医者は拒否し、彼女は毎日これをすることに同意したと思った。医師はマドロックの水泳ブラのボタンを外して乳房を露出させ、乳房ポンプを取り出してマドロックの乳房に装着する。医師はポンプを引いて乳房を刺激し始め、指でもう片方の乳首を刺激する。Mudrockは声を抑えて呻き始め、間もなく乳首から母乳が吹き出し始めました。\nもし可能なら、これをコミック版で描いていただけませんか？\n\n母乳ポンプについては、このような機種でもいいのでしょうか？\nhttps://www.pixiv.net/en/artworks/93420653\n\n詳細は以上です、お付き合いいただきありがとうございました。\n\nhttps://www.pixiv.net/en/artworks/100049414", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/6", "thumbnail_src": "https://si.imgix.net/75c7ebaa/uploads/origins/d17df21b-83f5-4ab8-855d-904a9cfa5a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd291670829ac9e017d037ff74eb80a", "thumbnail_srcset": "https://si.imgix.net/75c7ebaa/uploads/origins/d17df21b-83f5-4ab8-855d-904a9cfa5a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd291670829ac9e017d037ff74eb80a, https://si.imgix.net/75c7ebaa/uploads/origins/d17df21b-83f5-4ab8-855d-904a9cfa5a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c9507684027104c5af6dd969667ebdb 2x, https://si.imgix.net/75c7ebaa/uploads/origins/d17df21b-83f5-4ab8-855d-904a9cfa5a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa444e7ed40cca1f699ccc0fe1c2b48 3x", "genre": "art", "nsfw": false, "body": "初めまして。御津波さくら様の絵を拝見させていただきました。とても素晴らしかったので、私からもリクエストさせていただきます。\n\nキャラクター\n世界樹の迷宮Xのヒーロー1♂（下記URLの左上にいる緑髪の青年）\nhttps://www.famitsu.com/news/amp/201805/01156691.php\nと、世界樹の迷宮5のフェンサー1♀（下記URLの金髪ツインテの少女）\nhttps://sq-atlus.jp/sq5/sp/character/fencer.html\n\nシチュエーション\n世界樹の迷宮シリーズは設定等を自由にして構わないゲームなので、私の設定を利用させていただく事をご了承ください。\n\n世界樹の迷宮Xのヒーロー1♂と世界樹の迷宮5のフェンサー1♀のイチャラブ絵をお願いします。\n\nヒーロー1♂の性格は真面目。フェンサー1♀はボクっ娘という設定。\n2人は恋人関係で非常に仲が良い。ヒーロー1♂がフェンサー1♀の胸を触る。それにフェンサー1♀は少しビックリするが、内心嬉しそうで、「もう、エッチなんだから。」と言う。そのセリフを聞いたヒーロー1♂はすみませんと謝る。すると、フェンサー1♀は「でも、いいよ。私の胸もっと触っても。」と言う。そのセリフを聞いたヒーロー1♂「そうですか。愛してるよ。」と言い、続けてフェンサー1♀も「僕もだよ。愛してる。」と言いながらお互いにキスをする。\n\n妄想全開ですみませんが、上記リクエストがOKであればよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@MidunamiSakura/works/5", "thumbnail_src": "https://si.imgix.net/77c04bd0/uploads/origins/181e14fa-809d-4bb9-a6b4-f0fff8f849af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1673af8cffaff26b39ce8f4b483f1d79", "thumbnail_srcset": "https://si.imgix.net/77c04bd0/uploads/origins/181e14fa-809d-4bb9-a6b4-f0fff8f849af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1673af8cffaff26b39ce8f4b483f1d79, https://si.imgix.net/77c04bd0/uploads/origins/181e14fa-809d-4bb9-a6b4-f0fff8f849af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04c7202cba5e1fac10067bb1bd326e40 2x, https://si.imgix.net/77c04bd0/uploads/origins/181e14fa-809d-4bb9-a6b4-f0fff8f849af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cb7de56691a7903711595be61d3499f 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n\nブルーアーカイブの『聖園ミカ』と『百合園セイア』のイラストを描いていただけませんか。\n\nシチュエーションは、ミカがセイアをからかう為に両手で目を隠して「だ〜れだ」をしようとするが、なぜか胸の辺りの隙間に手を突っ込んでしまい、ちっぱいを揉んでしまう。\nすぐに離そうとするが、セイアも満