4e0-42a7-aafe-6e3fda79529b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5deb758a839b0712995e3abaf70ad09", "thumbnail_srcset": "https://si.imgix.net/fadf7955/uploads/origins/1dd3e391-34e0-42a7-aafe-6e3fda79529b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5deb758a839b0712995e3abaf70ad09, https://si.imgix.net/fadf7955/uploads/origins/1dd3e391-34e0-42a7-aafe-6e3fda79529b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4fdda66a82d3a7e0f8f32335a4c37d4 2x, https://si.imgix.net/fadf7955/uploads/origins/1dd3e391-34e0-42a7-aafe-6e3fda79529b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff726bc7b1417abe9bdce962c5d751e4 3x", "genre": "art", "nsfw": false, "body": "お忙しい中失礼します。\nあれのわの水着イラストを依頼したいです！\n水着の色等などはおまかせでよろしくお願いします。\n出来たら一人ずつ分けた透過があると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@Noirxvx/works/11", "thumbnail_src": "https://si.imgix.net/4c7913f3/uploads/origins/e30ccea1-a302-44cc-b2b0-4f9e3225291e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719e675311785ef0d488af0e4b53631a", "thumbnail_srcset": "https://si.imgix.net/4c7913f3/uploads/origins/e30ccea1-a302-44cc-b2b0-4f9e3225291e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719e675311785ef0d488af0e4b53631a, https://si.imgix.net/4c7913f3/uploads/origins/e30ccea1-a302-44cc-b2b0-4f9e3225291e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=796a78da964b77b98e978b8c8a1b53de 2x, https://si.imgix.net/4c7913f3/uploads/origins/e30ccea1-a302-44cc-b2b0-4f9e3225291e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=654b69b26c573ea9cadfa8ee12425def 3x", "genre": "art", "nsfw": false, "body": "神絵師大天使ママのわーる様へ\n\nろりろりぷりちぃアレナちゃんを描いてほしいです\nご機嫌に歌ってるとことかだと嬉しいです\n服とか全部お任せします", "created_at": "", "completed_at": ""}, {"path": "/@Noirxvx/works/10", "thumbnail_src": "https://si.imgix.net/4e4bac34/uploads/origins/86849121-8941-4625-bade-42a3bf414f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2aec7bcafaec13ef739502188499ad", "thumbnail_srcset": "https://si.imgix.net/4e4bac34/uploads/origins/86849121-8941-4625-bade-42a3bf414f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2aec7bcafaec13ef739502188499ad, https://si.imgix.net/4e4bac34/uploads/origins/86849121-8941-4625-bade-42a3bf414f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6d0821f4cd90f3cffcf0b7c245d65eb 2x, https://si.imgix.net/4e4bac34/uploads/origins/86849121-8941-4625-bade-42a3bf414f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b614ae466e0eccc6524a623c5d5d3f9c 3x", "genre": "art", "nsfw": false, "body": "原神のスカークを描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@Noirxvx/works/9", "thumbnail_src": "https://si.imgix.net/ad0301af/uploads/origins/59329b97-46c1-4f99-b324-29ec7b739a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c71b6fbe62d4c4deabe7093994a86ff2", "thumbnail_srcset": "https://si.imgix.net/ad0301af/uploads/origins/59329b97-46c1-4f99-b324-29ec7b739a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c71b6fbe62d4c4deabe7093994a86ff2, https://si.imgix.net/ad0301af/uploads/origins/59329b97-46c1-4f99-b324-29ec7b739a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c27d76d75b4eee9300b623d10246a28e 2x, https://si.imgix.net/ad0301af/uploads/origins/59329b97-46c1-4f99-b324-29ec7b739a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e3b2ad4f5c17510835cf92ed3b6de87 3x", "genre": "art", "nsfw": false, "body": "SDイラスト強化月間ということで、SDイラストのリクエストです！\n\n◇依頼内容\n・お腹がすいたNoir氏をお願い致します\n・表情等はお任せしますが、参考までにイラストのイメージ候補を３つ記載せていただきます。\n①もうお腹がすいて頑張れない\n②好きな食べ物を想像して幸せそうな表情\n③葛藤\n\n◇表情参考\nhttps://www.nicovideo.jp/watch/sm8641965\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Noirxvx/works/8", "thumbnail_src": "https://si.imgix.net/09a36d4f/uploads/origins/ede511b3-1ecf-431c-bcd7-1a576a194a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=005c99321e66dddae2142ba4247b80a6", "thumbnail_srcset": "https://si.imgix.net/09a36d4f/uploads/origins/ede511b3-1ecf-431c-bcd7-1a576a194a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=005c99321e66dddae2142ba4247b80a6, https://si.imgix.net/09a36d4f/uploads/origins/ede511b3-1ecf-431c-bcd7-1a576a194a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2eb29562ad0444512d25445aad86b877 2x, https://si.imgix.net/09a36d4f/uploads/origins/ede511b3-1ecf-431c-bcd7-1a576a194a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dec0b8bc0f29c6086d2a428648a58dc7 3x", "genre": "art", "nsfw": false, "body": "Noir様、こんにちは。\n私を、イラストとして描いて欲しくてリクエストしました。\n使用目的は、X、YouTube、ツイキャス等のアイコン、ヘッダーでの利用。\nSNSでの利用。\nX収益化に伴い、グッズ化以外の商用利用もお願いします。\n1枚絵のA4サイズでお願いします。\n被写体は学生服、冬服を着た中二病の学生の姿を描いて欲しいです。\n服の色は「黒」、ボタンは「金か黄色」、髪色は「茶髪でボサボサ」、髪で左目は隠してください（髪の上から透かしで目は見えるように）右手と右腕はちょっと汚い包帯で肘まで巻いてください（指は巻かずに右腕の袖は肘まで捲る）瞳は「赤」でお願いします。\nポーズは、足を「ハ」の字に開いて、右腕を足の前に自然とだらんと垂らしている感じに、左手で左目を抑えている感じに（人差し指と中指はちょい開いて瞳は見える感じに）\n不足している分はおまかせします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Noirxvx/works/7", "thumbnail_src": "https://si.imgix.net/48898692/uploads/origins/41aae6f8-9fa2-4b3e-ae8f-c034b3740da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=312749d42cbeff3cbd129ec02c06589f", "thumbnail_srcset": "https://si.imgix.net/48898692/uploads/origins/41aae6f8-9fa2-4b3e-ae8f-c034b3740da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=312749d42cbeff3cbd129ec02c06589f, https://si.imgix.net/48898692/uploads/origins/41aae6f8-9fa2-4b3e-ae8f-c034b3740da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87e9bbfe2edc8e493c5e48352e1c0e95 2x,