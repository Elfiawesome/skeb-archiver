fb0-b110-5fb743672034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf038fd70db44c070412df1fae9727b", "thumbnail_srcset": "https://si.imgix.net/713a9e52/uploads/origins/2ff369c8-1255-4fb0-b110-5fb743672034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf038fd70db44c070412df1fae9727b, https://si.imgix.net/713a9e52/uploads/origins/2ff369c8-1255-4fb0-b110-5fb743672034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29286144b47d841df1eaa450718ac2c8 2x, https://si.imgix.net/713a9e52/uploads/origins/2ff369c8-1255-4fb0-b110-5fb743672034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb91ad82569fd9fe202606735301abcb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のキャラクターVeeを描いてほしいです！彼女はかわいいリズムのアーケードゲームから出てきたタスマニアデビルの女の子です！\n\nポーズは決めていないので、あなたがかわいいと思う方法で描いてください！\n\nhttps://drive.google.com/file/d/1UZej3Wwh9pj_5PNtmPOE3qKoYf4QDUYU/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@POST0_/works/150", "thumbnail_src": "https://si.imgix.net/9d2cdf81/uploads/origins/d934909f-c365-4f01-875e-c226b3384c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943fb8dfb973ab371188b206ac878561", "thumbnail_srcset": "https://si.imgix.net/9d2cdf81/uploads/origins/d934909f-c365-4f01-875e-c226b3384c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943fb8dfb973ab371188b206ac878561, https://si.imgix.net/9d2cdf81/uploads/origins/d934909f-c365-4f01-875e-c226b3384c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=691f725736474ff5fb18caa9128e2f4d 2x, https://si.imgix.net/9d2cdf81/uploads/origins/d934909f-c365-4f01-875e-c226b3384c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=439d1ba215d634f509b2ee5b87968662 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのPNGtuberの作品がとても好きで、私もお願いしたいです！私はストリーミングに戻るので、私のキャラクターを表現するためにあなたのアートを使いたいです。\n\nシンプルなバージョンしか使わない予定なので、必要なのは\n目を開けて口を開ける\n目を開けて口を閉じる\n目を閉じて口を開ける\n目を閉じ、口を閉じる\n\n私のキャラクターの衣装はまだ完全に描かれていないが、参考資料のイメージを忠実にコピーすることができる。\n\n僕のキャラクターの大まかなデザイン／コンセプトは、超常現象を扱う \"ブラッドメイジ \"だ。彼女は魔法を使うために血を摂取し、魔法を吹き込まれた剣を使って仕事をする。彼女は人間でも吸血鬼でもないが、両方に似ている。彼女の雰囲気は少しストイックなものであるべきだ。\n\n重要な細かい点をいくつか：\n- 小さな牙が1本見える。\n- 赤と白のスパイダーリリーのピンバッジを持っている。\n- 目の下と唇の下に2つ、美容マークがある。\n- 彼女の目はデフォルトで黒です。もし赤い目のバージョンを入れていただけるなら、それは素晴らしいことですが、必須ではありません。\n\n\nいくつかの表情が含まれている可能性があります：\n- ドヤ顔（猫顔）\n- 苛立ち (煮えたぎるような、静かな怒り。この場合は赤い目。)\n- 微笑み\n- 赤面／照れ（横を向く／遠くを見る）\n\n\n価格設定が不十分な場合は、遠慮なくアピールしてください！ありがとうございました！\n\nhttps://drive.google.com/file/d/1yd0pvaeGiLwjJv6BPN2YhUb92dulA03b/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@POST0_/works/149", "thumbnail_src": "https://si.imgix.net/78e6fcd1/uploads/origins/6b58e091-ee4b-4fb8-a8b7-ca100bc735c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=786f918602dd2dafa214dfc2093c7361", "thumbnail_srcset": "https://si.imgix.net/78e6fcd1/uploads/origins/6b58e091-ee4b-4fb8-a8b7-ca100bc735c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=786f918602dd2dafa214dfc2093c7361, https://si.imgix.net/78e6fcd1/uploads/origins/6b58e091-ee4b-4fb8-a8b7-ca100bc735c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=257c2e777477fceb182182f8fb429d77 2x, https://si.imgix.net/78e6fcd1/uploads/origins/6b58e091-ee4b-4fb8-a8b7-ca100bc735c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23e077ba68030a4909c2d48cb3c296fb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！始める前に、私はあなたの絵が大好きだと言いたいです！だから、私のキャラクター、Chisasaiko、または単にSaikoのPNGTuberバージョンをリクエストしたいです。\n\n彼女は元々アンダーワールドから来たランパッドの妖精で、今は地上の洞窟に住んでいます。彼女は生意気で賢く、とても忠実ですが、その忠実さは少し独占欲やヤンデレに見えることもあります。洞窟の外にいる悪意のある人々にいたずらをしたり、お菓子を食べながら人間の文化を勉強したりするのが好き。\n\nTwitchやYoutubeで配信したり、動画を作ったり、SNS全般で使えそう。プロフィール画像にもするかもしれません。以下のフォーマットでお願いします：   \n\n- 目を開け、口を閉じる\n- 目を開け、口を開ける\n\nまた、可能であれば、彼女の頬や顔の形をもう少し丸くして、より若々しくしていただけませんか？  下のリファレンスにある、以前の作