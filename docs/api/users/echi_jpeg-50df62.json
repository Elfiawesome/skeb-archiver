x.net/18b3148b/requests/209444_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93a918e89630c253ebe72e53d1791507, https://si.imgix.net/18b3148b/requests/209444_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=677bb86aff9efd82f156039a7b3c0cd8 2x, https://si.imgix.net/18b3148b/requests/209444_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efec72e4fc856ddc92ba6e8018e20e68 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@echi_jpeg/works/21", "thumbnail_src": "https://si.imgix.net/fdc9b062/requests/178639_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0da58248fd8fffe6517e7c6648b88c", "thumbnail_srcset": "https://si.imgix.net/fdc9b062/requests/178639_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0da58248fd8fffe6517e7c6648b88c, https://si.imgix.net/fdc9b062/requests/178639_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f24fea5be99902a08f4b185279d2dce5 2x, https://si.imgix.net/fdc9b062/requests/178639_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53d250f8208c18ed801437aeea1b7fd7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@echi_jpeg/works/19", "thumbnail_src": "https://si.imgix.net/c5a25ae7/requests/79658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4255107e3db0cc048b1da4a54b145508", "thumbnail_srcset": "https://si.imgix.net/c5a25ae7/requests/79658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4255107e3db0cc048b1da4a54b145508, https://si.imgix.net/c5a25ae7/requests/79658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1cb59112fdde9d9e5fd50688ef5b6e1 2x, https://si.imgix.net/c5a25ae7/requests/79658_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fdca679b40ae9fc571969966702c6c0 3x", "genre": "art", "nsfw": true, "body": "ひといきさんのTS(性転換)シチュイラストを見てみたいです！\n内容としては、真面目そうな大学生ぐらいの男子が、胸が大きめの黒髪ロングの清楚系な美人な女の子にTSしてしまい、胸がハート型に空いたスタイルを強調するメイド服を着て、胸やアソコを触ってＨなことをしちゃってるってシチュでお願いしたいです！\nTS後のシチュがメインで、TS前の姿や変身途中or直後のようなイラストは、端や小窓に描いてくださると嬉しいです。(TS前の格好や姿はお任せします。)\n長くなってしまいましたが受けてくださると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@echi_jpeg/works/18", "thumbnail_src": "https://si.imgix.net/a4598b70/requests/80715_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65e35ac8ffa6bb04af4823446b0c4b4a", "thumbnail_srcset": "https://si.imgix.net/a4598b70/requests/80715_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65e35ac8ffa6bb04af4823446b0c4b4a, https://si.imgix.net/a4598b70/requests/80715_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=064c1ad3d12a891dd0502f7ef7f0f7d7 2x, https://si.imgix.net/a4598b70/requests/80715_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f45822c72cf15cde366a38bd2c56768 3x", "genre": "art", "nsfw": false, "body": "『空の境界』から両儀式をお願いいたします。\n・服装：前掛けがあるタイプのメイドビキニで黒ニーハイ（水着アルトリア・オルタみたいな感じ）\n・表情：赤面しつつちょっと怒ってて、でも強く出れない感じ\n・構図：サービストレー（お盆）を持って、腋が見えてるポーズ\n・背景：可能であればなんとなく喫茶店っぽい感じでお願いします\n\n参考：TYPE-MOONの二次創作ガイドライン\nhttp://typemoon.com/copyright", "created_at": "", "completed_at": ""}, {"path": "/@echi_jpeg/works/17", "thumbnail_src": "https://si.imgix.net/e9043e1d/requests/79928_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8696a1152b30790972d298ba77051e01", "thumbnail_srcset": "https://si.imgix.net/e9043e1d/requests/79928_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8696a1152b30790972d298ba77051e01, https://si.imgix.net/e9043e1d/requests/79928_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b1c17151ec53f4d12102960363c7073 2x, https://si.imgix.net/e9043e1d/requests/79928_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffe3b00caa450b51575256c8ebfa17f0 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n\nオリジナルのキャラクターを描いてもらえますか？\n\n彼女はちょうどシャワーを終えたところです。レースパンティーのみの着こなしをお願いします。彼女は首にタオルをかけたり、それで髪を乾かしたりできます。\n\n残りはお任せします\n\nありがとうございました！\n\nhttps://drive.google.com/open?id=15bSlV40wdNDVulGVMOgf98MCg0y2vZla", "created_at": "", "completed_at": ""}, {"path": "/@echi_jpeg/works/16", "thumbnail_src": "https://si.imgix.net/a6b7bd9d/requests/63031_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=630cf9c7b6ef30d80903e732e42b997f", "thumbnail_srcset": "https://si.imgix.net/a6b7bd9d/requests/63031_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=630cf9c7b6ef30d80903e732e42b997f, https://si.imgix.net/a6b7bd9d/requests/63031_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d762501db58ca0ea0eaa98c9e070a7d 2x, https://si.imgix.net/a6b7bd9d/requests/63031_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dfbedd703b069cf8becfd118f9ce512 3x", "genre": "art", "nsfw": true, "body": "以前描いていただいた「ぐぬぬちゃん」をおねがいします！\n出来ましたら、ベッドで押し倒されながら、胸がはだけており、両手をネクタイかリボンで結ばれていて、顔の横に持ってきている感じでお願いします！\n後、もう一つ出来ましたら、表情は、ぐぬぬってしつつも気持ちいいみたいな、これからの事を期待しているみたいな、好き！って表情でお願いします！(これは、あやふやな表現なので無視していただいても構いません)\n\nよろしくお願