6c07d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14813eb8189c0f3cd3c87a3102152f2, https://si.imgix.net/45519c9f/uploads/origins/b93e4b0f-08ca-4a5d-bb4b-47bcfa6c07d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee6cacca2a8538ce578979a3e73f313b 2x, https://si.imgix.net/45519c9f/uploads/origins/b93e4b0f-08ca-4a5d-bb4b-47bcfa6c07d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d31aa71adb409d3af4b4160eabf3d0a2 3x", "genre": "art", "nsfw": false, "body": "はじめまして。ゾイド大好き太郎です。今回はモンスターハンターのオリジナルキャラクターを神羅万象チョコ風のイラストで依頼したいとおもいます！\nhttps://pbs.twimg.com/media/FX76h6aUsAA4nFn?format=jpg&name=4096x4096\nhttps://pbs.twimg.com/media/FX76kmqUsAAkH1r?format=jpg&name=4096x4096\nhttps://pbs.twimg.com/media/FX76nDnUYAAvDS4?format=jpg&name=4096x4096\nhttps://pbs.twimg.com/media/FX765EcVEAE5Ute?format=jpg&name=4096x4096\n以上の顔と髪型をした女性を19歳ほどに調整し、\nアグナコトルのスラッシュアックスである紅蓮斧ヘルゼスティを剣モードで手に取り、\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ0xLGn0j4B8t7t7fWqqJxIzIA83939vOzEPA&s\nオドミドロ亜種の防具であるオロミドｚ防具を身に着け、オロミドｚヘルムをかぶっている差分付きでお願いいたします。\nhttps://kamigame.jp/MH-RISE/page/219173166071725075.html\n\nhttps://lh3.googleusercontent.com/hS8NLaHMtlZkLHHyG3r07xVse_JDe2G-isoLvasXdHBDTa_YWsfOUS20eMLIO0Xzm1AgitGozSFwccCBl7QkyLXUvfLU28lGNKSWEVMSdYM\n彼女の名前はカロル(ラテン語で熱)・ララ(ハワイ語で太陽)・ポース(ギリシャ語で光)で、燃え盛る太陽を背景にお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@reki_00/works/6", "thumbnail_src": "https://si.imgix.net/4b3c6bf6/uploads/origins/459b8b80-5f1a-4939-b029-73ae4c19d43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2820ca55d5611174b354200dbc2d7b3", "thumbnail_srcset": "https://si.imgix.net/4b3c6bf6/uploads/origins/459b8b80-5f1a-4939-b029-73ae4c19d43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2820ca55d5611174b354200dbc2d7b3, https://si.imgix.net/4b3c6bf6/uploads/origins/459b8b80-5f1a-4939-b029-73ae4c19d43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da262c20ada91146f746b5a0e637dc58 2x, https://si.imgix.net/4b3c6bf6/uploads/origins/459b8b80-5f1a-4939-b029-73ae4c19d43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e237d5375826f30f605705350bebc3c 3x", "genre": "art", "nsfw": false, "body": "れきさん、いつもお世話になっております。\n色々とお忙しい中で恐縮ですが、リクエストを送らせてください。\n\nキャラクターは神羅万象の花媛香具耶。\n\n以前、というかかなり前に描いて頂いたJKな感じの香具耶ちゃんをお願いしたく思います。\nポーズなど諸々は全てお任せ致します。簡略化のアレンジなども全然して頂いて大丈夫です。\n\n宜しければ、ご一考のほどお願いします。\n\nhttps://x.com/reki_00/status/973843784415899648\n\nhttps://x.com/reki_00/status/974277776852189185", "created_at": "", "completed_at": ""}, {"path": "/@reki_00/works/5", "thumbnail_src": "https://si.imgix.net/4d45fabb/uploads/origins/86d41569-99da-4f11-905d-0a00759fd631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98b9c4ed1ebf90cad059183b4643ebed", "thumbnail_srcset": "https://si.imgix.net/4d45fabb/uploads/origins/86d41569-99da-4f11-905d-0a00759fd631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98b9c4ed1ebf90cad059183b4643ebed, https://si.imgix.net/4d45fabb/uploads/origins/86d41569-99da-4f11-905d-0a00759fd631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6db555a37e4bb162e765362654c331fc 2x, https://si.imgix.net/4d45fabb/uploads/origins/86d41569-99da-4f11-905d-0a00759fd631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85573d9ea33a29cd12af230a573feef7 3x", "genre": "art", "nsfw": false, "body": "はじめまして、歪んだむと申します。\nX（旧Twitter）やpixiv、skebの納品物などで拝見した森羅万象チョコ風のイラストがとても良かったので今回リクエストを送りました。\n\nシャングリラ・フロンティアという作品の「秋津茜」というキャラクターを、森羅万象風に描いてほしいです。\n\n・中身は元気なスポーツマン系のキャラなので、表情は笑顔（えへ顔）もしくはキメ顔\n・作品タイトルと同名の作中のVRゲームでは、忍者系ジョブに就いているので、忍者刀を構えるor忍術の印を組んでいるようなイメージ\nでお願いします\n\nその他、ポーズや構図などはお任せします。\n\n\n宛名や文字、背景やロゴなどをpsdレイヤーで分けることができるとありがたいです。\n\n ご検討よろしくお願いします。\n\nhttps://x.com/DAINAMAN_X/status/1684613933712498688?t=AH-h5KJ2vBy0bivoEuoyNQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@reki_00/works/4", "thumbnail_src": "https://si.imgix.net/aaa796b1/uploads/origins/8a78dceb-242b-4b0d-baf1-2bb1c0f5e9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683334c10cecb3352bc1d0a0cccce9ed", "thumbnail_srcset": "https://si.imgix.net/aaa796b1/uploads/origins/8a78dceb-242b-4b0d-baf1-2bb1c0f5e9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683334c10cecb3352bc1d0a0cccce9ed, https://si.imgix.net/aaa796b1/uploads/origins/8a78dceb-242b-4b0d-baf1-2bb1c0f5e9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=418838e7694866c4633ca4432a2b6fa2 2x, https://si.imgix.net/aaa796b1/uploads/origins/8a78dceb-242b-4b0d-baf1-2bb1c0f5e9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2759e7a52b457db06d8b3e1bf038c23 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。神姫PROJECTからアリサの神羅万象風のカードイラストをお願いいたします。８周年記念に実装された『［覚醒の魔導士］アリサ』このゲームではマスコットキャラ枠で長らくお世話になっていたのですが、これでようやくプレイアブルキャラクターに昇格しました。その記念に是非とも神羅万象風イラストコレクションに加えたいと考えております。記念＆守銭奴キャラなので背景は金ぴかを希望します。あとはお任せします", "created_at": "", "completed_at": ""}, {"path": "/@reki_00/works/3", "thumbnail_src": "https://si.imgix.net/737b36ba/uploads/origins/06610ffa-697b-4e70-a608-2e220f8eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32b80c152e33b4630923ee82690455b8", "thumbnail_srcset": "https://si.imgix.net/737b36ba/uploads/origins/06610ffa-697b-4e70-a608-2e220f8eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32b80c152e33b4630923ee82690455b8, https://si.imgix.net/737b36ba/uploads/origins/06610ffa-697b-4e70-a608-2e220f8eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txta