82-93ec-32bc9cec0ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee3d9c8bf16ed879b8208d7265891cf7 3x", "genre": "art", "nsfw": false, "body": "プレイマットのイラストをお願い致します。 WIXOSSの緑姫と一衣をお願い致します。構図等はおまかせでお願い致します。 エモいもしくは尊いイラストをお願いいたします！サイズが縦35cm×横60cmでお願い致します。プレイマットにして自分が主催する無料大会で無料配布等する予定です。ご検討して頂けたら幸いです。 また運営様からは許可は得ております。 https://postimg.cc/0rHJt3vH  \n運営様から許可を得ている資料2つめ https://postimg.cc/JDnwgn11\n\n緑姫（書いてほしい衣装です）\nhttps://x.com/wixoss_tcg/status/1868936672903041214?s=46\n\n一衣\nhttps://images.app.goo.gl/z7pP63uEcMsKnKzo7", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/44", "thumbnail_src": "https://si.imgix.net/16b6c6a0/uploads/origins/a6210bab-cc26-4ed8-a3f1-8af942125e75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e7e405d504b93d214398abf21a2397", "thumbnail_srcset": "https://si.imgix.net/16b6c6a0/uploads/origins/a6210bab-cc26-4ed8-a3f1-8af942125e75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e7e405d504b93d214398abf21a2397, https://si.imgix.net/16b6c6a0/uploads/origins/a6210bab-cc26-4ed8-a3f1-8af942125e75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dca660b74fe5e3e39b40c0431f0cbe4 2x, https://si.imgix.net/16b6c6a0/uploads/origins/a6210bab-cc26-4ed8-a3f1-8af942125e75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0906b439254cd8551a24b841cb183196 3x", "genre": "art", "nsfw": false, "body": "あけましておめでとうございます！今年もよろしくお願いします！\n最近モデルを公開したので、新年に向けてアートをお願いしたいです。私のリクエストを受け入れてくださったらとても光栄です(˶ ˃ ᵕ ˂ ˶)\n\n楽しい性格のアキソロトルvtuberです。目、耳、尻尾に注目してください。\n白のチャイナ服を着ていて、それを引き立てるような色で描いてください。\n笑顔で宝石ビスケットを持っている彼女も描いてください。ペットが宝石ビスケットを見ているところを描いてください。\n背景はランタンと花火を浮かべてください。\n全体的にお祭りのような、記念になるような雰囲気でお願いします。\nその他の構図は自由です！前髪と髪の色を統一していただければ、髪型も自由に変えてください！\n\nできれば、キャラクターと背景を分けてください。この投稿はSNSにアップする予定です！そして、もう一度、私を検討していただき、本当にありがとうございます！\n\n[参考リンク］\nhttps://drive.google.com/drive/folders/1Y1U15Q417tUV-o1FBb-uRSzPvw3l0C8v?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/43", "thumbnail_src": "https://si.imgix.net/3127161d/uploads/origins/6994f091-6f4a-4574-95aa-d8dfc9c4344d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a0484efdb56b2658fd9245ae55dadbe", "thumbnail_srcset": "https://si.imgix.net/3127161d/uploads/origins/6994f091-6f4a-4574-95aa-d8dfc9c4344d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a0484efdb56b2658fd9245ae55dadbe, https://si.imgix.net/3127161d/uploads/origins/6994f091-6f4a-4574-95aa-d8dfc9c4344d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da656f063a64d9909d024209eb7f4e9 2x, https://si.imgix.net/3127161d/uploads/origins/6994f091-6f4a-4574-95aa-d8dfc9c4344d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c09a47697c433c9569cc7919a27a7d42 3x", "genre": "art", "nsfw": false, "body": "こんにちは、緑QN先生！\n\nあなたのアートギャラリーを拝見し、あなたのキャラクターワークと色使いがとても気に入りました！もしよければ、私のVtuberキャラクターにリクエストをして、Twitter、Twitch、ウェブサイトでアートを使いたいです！\n\n彼女は遊び好きで、よく笑い、きれいな風景を見るために旅行するのが好きです！花柄の袴を着てほしいです！具体的なデザインや柄はお任せしますが、デザインに興味がなければ参考のもので構いません！舞台は春の公園で桜が咲いている設定でお願いします！ポーズやディテールはお任せします！\n\n本当にありがとうございました！よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1EhppDOWX40JDKs4Yf9AvQRkD4RMRLNX4", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/42", "thumbnail_src": "https://si.imgix.net/653632a2/uploads/origins/8529fb76-90e5-4756-b09d-c66657472b92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbd084081c3158292862617fdf991f4a", "thumbnail_srcset": "https://si.imgix.net/653632a2/uploads/origins/8529fb76-90e5-4756-b09d-c66657472b92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbd084081c3158292862617fdf991f4a, https://si.imgix.net/653632a2/uploads/origins/8529fb76-90e5-4756-b09d-c66657472b92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0255d0d460702ad4f4922fb78d4e30e 2x, https://si.imgix.net/653632a2/uploads/origins/8529fb76-90e5-4756-b09d-c66657472b92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=581b968849b55c92eda966eafbb1b0a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/41", "thumbnail_src": "https://si.imgix.net/db918370/uploads/origins/fe82c4db-88f9-4846-8114-967b6101a006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dcd3b97ffed69c718ba1d9df3fb162c", "thumbnail_srcset": "https://si.imgix.net/db918370/uploads/origins/fe82c4db-88f9-4846-8114-967b6101a006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dcd3b97ffed69c718ba1d9df3fb162c, https://si.imgix.net/db918370/uploads/origins/fe82c4db-88f9-4846-8114-967b6101a006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18aa8df134b0ce07d4e3e4a893e08f93 2x, https://si.imgix.net/db918370/uploads/origins/fe82c4db-88f9-4846-8114-967b6101a006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d1b67f9bceeb5b4175da450903ddacb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのアートスタイルがとても好きで、私と友人のVtuberモデルのアートを一緒に依頼したいと思っています。\n\nカズは九尾の守護狐の精霊で、羽織を着ているときは一尾しか見せません。Bloomeは天空のレッサーパンダです。\n\n参考文献はgoogle driveのリンクを見てください：\nhttps://drive.google.com/drive/folders/17Yw9UPwC38_IuEbr6QUOpbCD1I97yEZd?usp=sharing\n\ngoogle driveのリンクには、カズ、ブルーム、ポーズのリファレンスがあります。\n\n表情は、カズがブルームを気遣うような目で見つめ、軽く微笑むような感じでお願いします。ブルームは、カズの目を見て赤面しているようにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/40", "thumbnail_src": "https://si.imgix.net/64ae0582/uploads/origins/707806fc-d5a6-4dac-a8ad-cc085fab7da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d54f0bdee396eb76f4551ef3d2dd84", "thumbnail_srcset": "https://si.imgix.net/64ae0582/uploads/origins/707806fc-d5a6-4dac-a8ad-cc085fab7da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d54f0bdee396eb76f4551ef3d2dd84, https://si.imgix.net/64ae0582/uploads/origins/707806fc-d5a6-4dac-a8ad-cc085fab7da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3bf32f1114dbd8625be51b26aff13be 2x, https://si.imgix.net/64ae0582/uploads/origins/707806fc-d5a6-4dac-a8ad-cc085fab7da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fdf67e9d3acf749e8e993e71a80182f 3x", "genre": "art", "nsfw": false, "body": "久しぶりです！\nえすです。\n約3年前うちの娘描いて頂きました。その件、改めてありがとうございます。\nディソナ花代さんも大変ありがとうございます。\n今回は、似たような設定で別のキャラをリクエストさせてください。\nつまり、うちの娘の、ウィクロスのルリグかアーツみたいなイラストを描いて欲しいです。\n彼女は魔法剣士なので、スペルとルリグアタックが多い白青デッキがいいと思います。\n\n他お任せます。\nよろしくお願いします。\n\nその他はお任せます。\n\nhttps://drive.google.com/drive/folders/1Ge2ouB25kpBIy9-Gccmf-iYbKzjBzN8g", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/39", "thumbnail_src": "https://si.imgix.net/08467a01/uploads/origins/eb310279-075c-42cd-9b41-4528dbfe7ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1884f53d928dc2b70d2ca042814b8fcd", "thumbnail_srcset": "https://si.imgix.net/08467a01/uploads/origins/eb310279-075c-42cd-9b41-4528dbfe7ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1884f53d928dc2b70d2ca042814b8fcd, https://si.imgix.net/08467a01/uploads/origins/eb310279-075c-42cd-9b41-4528dbfe7ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4aed41482b299a96f4c6f2c9120e3a34 2x, https://si.imgix.net/08467a01/uploads/origins/eb310279-075c-42cd-9b41-4528dbfe7ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35764da2f7eb402dddc97d9bb1b116ee 3x", "genre": "art", "nsfw": false, "body": "緑QN様こんにちは\n前回依頼した作品がとても気に入ったので、また依頼しに来ました。\n今回は愛白めろにゃの1周年を記念してイラストを依頼したいと思います!\n\n・キャラクター\nキャラクターは私の推しVTuberである愛白めろにゃさんのイラストをお願いします。\n可愛らしい娘で甘々な配信を提供している方です。\n（YTリンク： https://www.youtube.com/channel/UCgdEY-CzL66QLAGUgnfdSRw ）\n（Xリンク： https://x.com/mashiro_meronya ）\n\n・構図、ポーズ\n今回は参考画像をリンクに入れておきました。\n構図は大体、配信環境のイメージです。\n彼女は配信中、いつも椅子に正座していると言っていたので、イラストでも正座の姿勢にしてほしいです。\n彼女の配信はよくASMRなので、イラストに3Dioも描いてほしいです。\n今回は室内の環境なので、服装の部分で上半身のジャケットを外してほしいです（つまり、二面図のFront BとBack Bのような感じです）。\n今回は猫耳と尾がない人間の姿でお願いしたいです。\n可能であれば、今回は彼女の小さなペットも一緒に描いてほしいです。\n全体的にとてもリラックスした感じを出してほしいです。\n頭周辺がキャンバスから見切れない形でお描きいただけましたら使用の幅が広がり助かります。\n\n・使用用途\n依頼者本人によるSNSなどの媒体への投稿及びアイコン、ヘッダーへの使用、壁紙等への個人利用。\n愛白めろにゃさん本人によるYouTube、SNSなど媒体への投稿及びアイコン、ヘッダーへの使用、グッズの製作等の配信活動への利用許可も頂ければ幸いです。\n\n・納品形式\nPSD形式での納品を希望いたします。\nまた、背景とキャラクターのレイヤーを分けて納品いただけますと幸いです。\nこの依頼は来年の2月前に完成してほしいです。\n\n緑QN/MiDQNさんに素敵な愛白めろにゃさんをお描きいただけるのをとても楽しみにしています！\nぜひご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1evcs_6eHw1yxTezjsubSBqiJUYY0CRjm?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/38", "thumbnail_src": "https://si.imgix.net/ee7a424b/uploads/origins/878d4402-e4a0-4a2f-989b-43f1ed6c3d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f4fa43e50bcd9f5407492ae52738965", "thumbnail_srcset": "https://si.imgix.net/ee7a424b/uploads/origins/878d4402-e4a0-4a2f-989b-43f1ed6c3d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f4fa43e50bcd9f5407492ae52738965, https://si.imgix.net/ee7a424b/uploads/origins/878d4402-e4a0-4a2f-989b-43f1ed6c3d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d7db748536b2b8cf26db66a9ea95f78 2x, https://si.imgix.net/ee7a424b/uploads/origins/878d4402-e4a0-4a2f-989b-43f1ed6c3d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9579b604f28f718d2b0c101bc4fcdaf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/37", "thumbnail_src": "https://si.imgix.net/7a8d1124/uploads/origins/12eeffa3-1b8c-4e90-aa5a-c32900620caa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeccff266c157423b72d066328f83444", "thumbnail_srcset": "https://si.imgix.net/7a8d1124/uploads/origins/12eeffa3-1b8c-4e90-aa5a-c32900620caa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeccff266c157423b72d066328f83444, https://si.imgix.net/7a8d1124/uploads/origins/12eeffa3-1b8c-4e90-aa5a-c32900620caa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f617ad2a703b6fc051a328e2a5ff4b3d 2x, https://si.imgix.net/7a8d1124/uploads/origins/12eeffa3-1b8c-4e90-aa5a-c32900620caa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4790c1b68bac41626d0a83be84f86d04 3x", "genre": "art", "nsfw": false, "body": "緑QN/MiDQN様\nはじめまして。素敵な作品に惹かれました。この作品がとても好きです！幻想的な色彩、光の表現と衣装がとても素敵です。\nhttps://64.media.tumblr.com/c742b206a41d4f6c12feb917c0d1c2b4/173cd9357f230fba-24/s1280x1920/46284d1a31a8a8d00c79fea4f28039ed704f9d3c.jpg\n\n　もしよろしければ天空のクラフトフリートの「シェイラ」というキャラクターでリクエストをお願いします。\n　PC壁紙に使用させて頂きたいので（https://skeb.jp/@dqnww/works/29）の作品ように対角線上にキャラクターが配置されて映える感じだと嬉しいです。\n\n【キャラクターについて】\n・顔立ちのバランスは少し幼さも残った甘めの雰囲気で描写いただけると嬉しいです。まつ毛も重ためのバランスが好みです。緑QN様の作品で好きな顔立ちの描写⇒（https://x.com/dqnww/status/1838352648828854337/photo/1）\n・肩や手足の華奢な感じがチャームポイントだと感じていますので、肩幅など細くすらっとした体型で描写いただけると嬉しいです。\n・スリットスカート部分のデザインも好きです。そこも映える感じの構図だと嬉しいです。\n\n是非ご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1taU5dffSH_MFBvPgkjGZPV2SOaNh2Iuv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/36", "thumbnail_src": "https://si.imgix.net/515dfcdd/uploads/origins/6ed35355-bec9-4149-a214-18d91679ec97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc611a2271e754265316e5b73d91a15", "thumbnail_srcset": "https://si.imgix.net/515dfcdd/uploads/origins/6ed35355-bec9-4149-a214-18d91679ec97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc611a2271e754265316e5b73d91a15, https://si.imgix.net/515dfcdd/uploads/origins/6ed35355-bec9-4149-a214-18d91679ec97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=520f6115c967a7286f01576859f2191a 2x, https://si.imgix.net/515dfcdd/uploads/origins/6ed35355-bec9-4149-a214-18d91679ec97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d5fe0d42e135b6b2465ea166a391cc5 3x", "genre": "art", "nsfw": false, "body": "緑QN様\n初めまして、なたねと申します。\n\n私のオリジナルキャラクターを描いていただきたく\nリクエストさせていただきました。\n\n参考資料で不明な点や分かりづらい点は描きやすいように\n調整・アレンジして頂いて問題ありません。\n構図などはお任せいたします。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1eYD2XoeY0hPsYVQ_mypqeD7J6r7hEJG3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dqnww/works/35", "thumbnail_src": "https://si.imgix.net/259f32de/uploads/origins/d5056317-9b23-4f3c-b2c8-e91b522c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25acdc4731582c89b69ee8b15afe22df", "thumbnail_srcset": "https://si.imgix.net/259f32de/uploads/origins/d5056317-9b23-4f3c-b2c8-e91b522c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25acdc4731582c89b69ee8b15afe22df, https://si.imgix.net/259f32de/uploads/origins/d5056317-9b23-4f3c-b2c8-e91b522c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edb96796f3825dd599e111e5c7033a2d 2x, https://si.imgix.net/259f32de/uploads/origins/d5056317-9b23-4f3c-b2c8-e91b522c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fi