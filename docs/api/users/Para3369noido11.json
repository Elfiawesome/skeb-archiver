t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c74d27b79d60ea6de4f854eb36eb11c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/25", "thumbnail_src": "https://si.imgix.net/7979661c/uploads/origins/ce32c90d-04ee-484d-a2fe-ff4895bbe48d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a33a29fcc18234a5bd82fbd401deb02", "thumbnail_srcset": "https://si.imgix.net/7979661c/uploads/origins/ce32c90d-04ee-484d-a2fe-ff4895bbe48d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a33a29fcc18234a5bd82fbd401deb02, https://si.imgix.net/7979661c/uploads/origins/ce32c90d-04ee-484d-a2fe-ff4895bbe48d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c7df36a276e1c3b4c247aa2cdac93dc 2x, https://si.imgix.net/7979661c/uploads/origins/ce32c90d-04ee-484d-a2fe-ff4895bbe48d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8152477a104bd42c91a64c9cf3b131e 3x", "genre": "art", "nsfw": false, "body": "いぬさん、こんにちは！またまたクモリの依頼がありました。\n\n写真では、ドーナツを食べながら本を読んでいるのですが、パンツのボタンが開いてしまいました😳。\nびっくりしたような、恥ずかしそうな顔をしています🤭。\n\n半袖シャツにショートパンツという夏バージョンの格好になるのかな🤔。\nシャツはなんとなく上に持ち上げられていたり、ボタンが外れてお腹が露出していたり...その日は暑すぎたのかも😅。\nそして、彼のお腹は、彼の最初の依頼よりもぽっちゃりとして柔らかく、胸もぽっちゃりとして見えるかもしれません᤭。\n(もしかしたら背景にはハロウィンプライドのぬいぐるみもあるかも？🥹)\n\nというわけで、以上がアイデアですが、細かい部分は追加・変更可能です☺️\nクモリを作ってくれてありがとう！この写真に写っているクモリは、きっととてもかわいいと思います🥰。\nこの依頼を引き受けてくれることを願っています！お願いします、犬さん🙏。", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/24", "thumbnail_src": "https://si.imgix.net/b67d8698/uploads/origins/6a0d2646-540d-4bcb-8330-183581539337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8bade3011e442bf6491a0e91c214c56", "thumbnail_srcset": "https://si.imgix.net/b67d8698/uploads/origins/6a0d2646-540d-4bcb-8330-183581539337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8bade3011e442bf6491a0e91c214c56, https://si.imgix.net/b67d8698/uploads/origins/6a0d2646-540d-4bcb-8330-183581539337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b68c7b4d23c433f85122c14daea8545c 2x, https://si.imgix.net/b67d8698/uploads/origins/6a0d2646-540d-4bcb-8330-183581539337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=951cfb88cd002ead24d8889dfd436604 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/23", "thumbnail_src": "https://si.imgix.net/5b6d67d7/uploads/origins/2983b369-d81e-4e98-b7d0-b01ae342cac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=940506f8d615fcba69cef0d71264bea1", "thumbnail_srcset": "https://si.imgix.net/5b6d67d7/uploads/origins/2983b369-d81e-4e98-b7d0-b01ae342cac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=940506f8d615fcba69cef0d71264bea1, https://si.imgix.net/5b6d67d7/uploads/origins/2983b369-d81e-4e98-b7d0-b01ae342cac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3c0bfa4901c113fc59d402984eeb4a5 2x, https://si.imgix.net/5b6d67d7/uploads/origins/2983b369-d81e-4e98-b7d0-b01ae342cac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb36a9c600d3ef236061a9906aea593c 3x", "genre": "art", "nsfw": false, "body": "いぬさん、こんにちは！今回の依頼は、EveのインソムニアとさよならエンドロールのMVに登場するキャラクター、淵素直と弟切飛についてです。\n\nトビは淵の唯一の友人で、彼の幸せを本当に心配しているようだ。\nこの2人のキャラクターについては、MVと『まったりやすさん』の絵を参考にしてほしい：\nhttps://www.pixiv.net/artworks/126242917\n\nPixivのリンクにある11枚目と12枚目の写真から、渕はまったく食べることを好まないが、鳶はいつもたくさん食べていることがわかる。そして、渕はいつも心身ともに不健康である。\n\n今回の依頼では、渕と鳶がレストランで一緒に食事をしているシーンを想像してみた。鳶はいつものように大盛りを注文し、あっという間に平らげてしまった。鳶は渕がちゃんと食べるべきだと思い、ショックでついていくのが大変な渕を尻目に、自分で食べさせる。\n\n写真は、食事の後、一緒に歩いて帰るトビと渕。トビは、丸々としたお腹に少しぽっちゃりとした体つきで、余分な力を入れずに歩いていた。こんなに食べたのは初めてという渕は、お腹の詰め物がだいぶ小さくなったとはいえ、歩くには鳶の肩の支えが必要だった。\n鳶はいつもの無関心な表情だろうが、渕はまだショックを受けた顔で震えている。\n\n以上がコミッションのアイデアである。いつものように、依頼内容の変更は何でも可能です！\nまたまた2キャラの絵の依頼で申し訳ないです...描くの大変だろうなぁ...😅 でも前回鳶を描いてくれた時は本当に助かりました☺️\nもし引き受けてくださったら、本当にありがとうございます🙏。\n\nhttps://www.pixiv.net/artworks/126242917", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/22", "thumbnail_src": "https://si.imgix.net/33be60e7/uploads/origins/328219ab-c266-4859-99bc-c688c0c390a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e256f2060e235f131e4ba523756449dc", "thumbnail_srcset": "https://si.imgix.net/33be60e7/uploads/origins/328219ab-c266-4859-99bc-c688c0c390a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e256f2060e235f131e4ba523756449dc, https://si.imgix.net/33be60e7/uploads/origins/328219ab-c266-4859-99bc-c688c0c390a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77fc1c5b29313dc4ed08f320edefcb4b 2x, https://si.imgix.net/33be60e7/uploads/origins/328219ab-c266-4859-99bc-c688c0c390a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=819b448c372396fa0c12e64db03add05 3x", "genre": "art", "nsfw": false, "body": "いぬさん、こんにちは！\nファイナルファンタジーXVの2人のキャラクターの依頼です：ノクティスとプロンプトです。\nノクティスとプロンプトのデザインはとても気に入っているのですが、ヘアスタイルや衣装など、描くのが難しそうです😅。\n\nキャラクターの紹介を少し：\nノクティスは主人公の王子で、プロンプトを含む3人のキャラクターがミッションのために一緒に旅をしています。\nプロンプトのバックストーリーは、子供の頃はぽっちゃり体型。ノクティスと友達になりたかった彼は、ノクティスに近づくために努力して痩せてかっこよくなった。そして二人は親友になった。\n\n写真はキャンプファイヤーを囲んでいるところ。\nノクティスは食べることが楽しくて、上着やシャツがきつくなり、ぽっちゃりしてきた。\nノクティスは食べることが楽しくて、上着やシャツがきつくなってきている。プロンプトを元の体格に戻すために、ボリュームのある食べ物をたくさん食べさせようとしているが、実はそれが好きなのだፔ🍲。\nプロンプトは混乱していて、何が起こっているのかわからない。ノクティスからの餌付けについていけず、タンクトップがめくれあがって、詰まったお腹を抱えている💦。\n\nというわけで、こんな感じで考えてみました。\nいつも通り、何でも好きなように変えてください！\nもしこの依頼を引き受けてくださったら、よろしくお願いします🙏。", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/21", "thumbnail_src": "https://si.imgix.net/5f595f9e/uploads/origins/41af0674-92bb-4bbc-8be3-255488408f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e855d67e3d08a266398adf524aff66d6", "thumbnail_srcset": "https://si.imgix.net/5f595f9e/uploads/origins/41af0674-92bb-4bbc-8be3-255488408f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e855d67e3d08a266398adf524aff66d6, https://si.imgix.net/5f595f9e/uploads/origins/41af0674-92bb-4bbc-8be3-255488408f08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77c42239cee65b78f479a117c5b52950 2x, https://si.imgix.net/5f595f9e/uploads/origins/41af0674-92bb-4bbc-8be3-255488408f08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf423b1f1ee9fb1338e01bbcbe435f25 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/20", "thumbnail_src": "https://si.imgix.net/413314dc/uploads/origins/27834ba4-ee49-4a44-b85a-b29c809699dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b1b8d979671d666216bc03c5cb219f2", "thumbnail_srcset": "https://si.imgix.net/413314dc/uploads/origins/27834ba4-ee49-4a44-b85a-b29c809699dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b1b8d979671d666216bc03c5cb219f2, https://si.imgix.net/413314dc/uploads/origins/27834ba4-ee49-4a44-b85a-b29c809699dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3154c5f11f274e6925daaacbc22e46de 2x, https://si.imgix.net/413314dc/uploads/origins/27834ba4-ee49-4a44-b85a-b29c809699dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa3487a2c52e1c55538a6f0a020837a8 3x", "genre": "art", "nsfw": false, "body": "この依頼は、ジュードとケイシーが一緒に暮らし始めた初期の頃の話である。\n\n写真の中で、ジュードはケイシーが作ってくれる食事について行こうとしていた。しかしこの時、ジュードは本当に満腹で、ケイシーに休みたいと言った。\nケイシーはそれが気に入らなかったので、ジュードに自分で食事を与えることにした。ジュードがケイシーの裏の顔を見たのはこれが初めてだった...。\n\nジュードが初めてケイシーの裏の顔を見たのは...。\n写真に彼らの会話を追加してもらえるとうれしいですが、その必要はありません。\nもしこの依頼を引き受けてくださるのであれば、よろしくお願いします！お願いします、犬さん🙏。", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/19", "thumbnail_src": "https://si.imgix.net/209a9ace/uploads/origins/accfbdc5-15c7-46f6-ad6e-aa3a7434136d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e693769337a6e80d0480c487145aedca", "thumbnail_srcset": "https://si.imgix.net/209a9ace/uploads/origins/accfbdc5-15c7-46f6-ad6e-aa3a7434136d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e693769337a6e80d0480c487145aedca, https://si.imgix.net/209a9ace/uploads/origins/accfbdc5-15c7-46f6-ad6e-aa3a7434136d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcf482f8b4c1605bb12d61e60d08960a 2x, https://si.imgix.net/209a9ace/uploads/origins/accfbdc5-15c7-46f6-ad6e-aa3a7434136d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca9350d7246b2511e1bc28aa16fe6018 3x", "genre": "art", "nsfw": false, "body": "今回の依頼は、以前あなたが作成に協力してくれた代替タイムラインにおけるプライドについてです。\n前回の依頼のために描いてくれた2枚目のスケッチの完成版を見せてほしい：\nhttps://x.com/Sore3369noido11/status/1757787514985967848\n\nメガネチェーンにロングジャケットのプライドの服装がとてもかっこいいので、ぜひ完成形を見てみたいです！😲\nあと、もう一人のキャラが誰なのかも気になる。🤔\nプライドのシャツのボタンが、お腹の着ぐるみで少し取れているのが唯一の変更点かな᤭。\n\nどんな細かい部分でも変えていただいて構いませんし、構図をガラッと変えていただいても構いません。\n私のためにこのバージョンのプライドを作ってくれて本当にありがとう。この依頼を引き受けてくださるとありがたいです！お願いします、犬さん🙏。\n\nhttps://x.com/Sore3369noido11/status/1757787514985967848", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/18", "thumbnail_src": "https://si.imgix.net/bf1714e4/uploads/origins/40cacac5-49d3-455c-9bf6-b59c7f2cfaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a877816b6437f8935ee98bd81246b5a", "thumbnail_srcset": "https://si.imgix.net/bf1714e4/uploads/origins/40cacac5-49d3-455c-9bf6-b59c7f2cfaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a877816b6437f8935ee98bd81246b5a, https://si.imgix.net/bf1714e4/uploads/origins/40cacac5-49d3-455c-9bf6-b59c7f2cfaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d1548e29c2704c9a587ff9fd7eaecc1 2x, https://si.imgix.net/bf1714e4/uploads/origins/40cacac5-49d3-455c-9bf6-b59c7f2cfaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=229b57ce69478bcd6b043e8fd19a9de9 3x", "genre": "art", "nsfw": false, "body": "犬さん、こんにちは！お世話になったキャラの依頼がまた来ました。\n(彼の発する雰囲気から、とりあえず「クモリ」と名付けようと思います）。\n\n今回の依頼は、彼の自撮り写真です。\n以下は自撮り写真のアイデアだ：\n- 自撮り写真は、おそらく上から見下ろしたアングルで撮られている。\n- 彼は笑おうとしているが、めったに笑わないので、少し恥ずかしそうでぎこちない。\n- プライドのぬいぐるみを見せびらかしたいので、おそらく持っているか、横に置いている。\n- 彼は白いシャツと茶色のセーターを着ているが、なんとなく彼のぽっちゃりしたお腹が透けて見える。\n- あなたが描いた落書きのような水彩画風がとても好きです。この自撮り写真もこのスタイルにすることができる。\n\n以上がアイデアですが、全部に従う必要はありません。\nあなたは私よりもクモリのことをよく知っていると思うので、あなたが適切と思うディテールを追加したり変更したりすることができます。\nもしよければ、これを僕のプロフィール写真にも使おうかな！\n\n改めて、僕のためにこのキャラクターを作ってくれて、素晴らしい絵も描いてくれて、本当にありがとう！\nもしこの依頼を引き受けてくださったら、よろしくお願いします！お願いします、犬さん🙏。", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/17", "thumbnail_src": "https://si.imgix.net/7a75c456/uploads/origins/ee8f1bbc-3edd-4f93-887d-6b60e114d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc9609acaa9879eee3ec141976896017", "thumbnail_srcset": "https://si.imgix.net/7a75c456/uploads/origins/ee8f1bbc-3edd-4f93-887d-6b60e114d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc9609acaa9879eee3ec141976896017, https://si.imgix.net/7a75c456/uploads/origins/ee8f1bbc-3edd-4f93-887d-6b60e114d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdebee4083b8c7aaa4ac67432891e4f8 2x, https://si.imgix.net/7a75c456/uploads/origins/ee8f1bbc-3edd-4f93-887d-6b60e114d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb718b43a35e78a5378271e964942e32 3x", "genre": "art", "nsfw": false, "body": "この依頼には2枚の絵が含まれています。\n一枚目は、あなたが描いたこのLustの絵の完全版です：\nhttps://x.com/Sore3369noido11/status/1803452804411052235/photo/1\n\nこのラストのおなかがとてもかわいくて、起きたばかりの彼は本当に美しいと思います。だから、これの完全版が本当に見たい。\n(お腹はもう少し大きくてもいいと思うけど᤭)\n\n2枚目は、このLustの写真にGluttonyを入れたバリエーションです：\nこの写真では、グラットニーは背中からラストに抱きつき、ラストのタンクトップを持ち上げてお腹をつかんでいる。また、グラットニーはラストの頭に頭を乗せ、ラストに対して「いい匂いだね」とか、何かいいことを言っている。😌\nLustはGluttonyに苛立ち、拳を振り上げ、やめないと顔を殴ると言っている。💢👊\n\nいつものように、二人の性格に合うように、どんなディテールでも変えることができる。もしこれがあまりに性格的でないと思われるなら、受け入れていただかなくても結構です。\n犬さん、このリクエストを受け入れてくださったら、本当にありがとうございます！\n\nhttps://x.com/Sore3369noido11/status/1803452804411052235/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/16", "thumbnail_src": "https://si.imgix.net/d12ddffe/uploads/origins/5ff190b8-c34a-43c9-85c6-3ea72c6104b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026e97eeb979615ce00362fb0cbf5eb1", "thumbnail_srcset": "https://si.imgix.net/d12ddffe/uploads/origins/5ff190b8-c34a-43c9-85c6-3ea72c6104b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026e97eeb979615ce00362fb0cbf5eb1, https://si.imgix.net/d12ddffe/uploads/origins/5ff190b8-c34a-43c9-85c6-3ea72c6104b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9de935d7b421c73d15bfc0999bc575dd 2x, https://si.imgix.net/d12ddffe/uploads/origins/5ff190b8-c34a-43c9-85c6-3ea72c6104b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d887d9063fdfa9fd12f91510bcc09931 3x", "genre": "art", "nsfw": false, "body": "キャラクター:配信実況者くん\n枚数:2枚 \n\n状況\n座椅子に座り、配信実況をしている\n\n1枚目\n座椅子から立ち上がろうとしているが、苦戦している様子\n \n2枚目\n立ち上がることは出来たが体力を消耗し、休んでいる様子", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/15", "thumbnail_src": "https://si.imgix.net/d2b30016/uploads/origins/cf99ec98-faef-4f08-ae2e-84f4b880f58d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89814445500857ca070836f468fcfbaa", "thumbnail_srcset": "https://si.imgix.net/d2b30016/uploads/origins/cf99ec98-faef-4f08-ae2e-84f4b880f58d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89814445500857ca070836f468fcfbaa, https://si.imgix.net/d2b30016/uploads/origins/cf99ec98-faef-4f08-ae2e-84f4b880f58d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d3fb26d9b6fc9a116d9563357aa16a1 2x, https://si.imgix.net/d2b30016/uploads/origins/cf99ec98-faef-4f08-ae2e-84f4b880f58d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d01548b7e5dd5e731bb705ac2f6a346 3x", "genre": "art", "nsfw": false, "body": "先日のポストで登場したセイルくんの友達が凄く可愛かったので、彼とセイルくんが6年ぶりに当時と同じ格好で同じ構図で写真を撮ってみたというシチュエーションのイラストを描いて頂きたいです。\n\n2人とも当時と同じ服を着ているけども、体重は過去最高になってるためギチギチで全然サイズ合ってないしだらしない体が丸見えで、表情はお互いとんでもなく太ったことを自覚してるため恥ずかしげで汗をかいてる感じでお願いします！\n二重顎が好きなので、2人の二重顎も描いて頂けるとありがたいです。\n何卒よろしくお願いします！\n\nhttps://x.com/Para3369noido11/status/1814290670741561754?t=FnsYbeQ6U9OvrmLgsnYUkQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/14", "thumbnail_src": "https://si.imgix.net/13fd50bd/uploads/origins/914bf79c-78e4-4460-b550-086db4d38bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c827f69e92e6ec66a2a417035ba1695", "thumbnail_srcset": "https://si.imgix.net/13fd50bd/uploads/origins/914bf79c-78e4-4460-b550-086db4d38bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c827f69e92e6ec66a2a417035ba1695, https://si.imgix.net/13fd50bd/uploads/origins/914bf79c-78e4-4460-b550-086db4d38bad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=665484dba0f0e165ad29611393cddbd5 2x, https://si.imgix.net/13fd50bd/uploads/origins/914bf79c-78e4-4460-b550-086db4d38bad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1a7c2b039def8fe758de8a25fbb2cc 3x", "genre": "art", "nsfw": false, "body": "\"スロウスとプライドのラッキースケベ\"\nあなたの話を聞いてから、私も気になって、どうしても見たくなりました！\n好きなように、好きなアイデアで描いてください。\n(ナマケモノとプライドが狭い路地にはまり込んで、お腹を押し付け合っているところとか？わからないけど......)\n\n唯一の条件は、ナマケモノもプライドもメガネをかけていること。(特にナマケモノの丸メガネ、かわいい！)\nもし引き受けてくださったら、よろしくお願いします。このシーンを見るのを楽しみにしています！", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/13", "thumbnail_src": "https://si.imgix.net/b48e341c/uploads/origins/55eaaafe-f6bc-46b1-8352-75867b7e38f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74e00c6f61957d78a5b3ba93a8f8ccc1", "thumbnail_srcset": "https://si.imgix.net/b48e341c/uploads/origins/55eaaafe-f6bc-46b1-8352-75867b7e38f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74e00c6f61957d78a5b3ba93a8f8ccc1, https://si.imgix.net/b48e341c/uploads/origins/55eaaafe-f6bc-46b1-8352-75867b7e38f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85519ef3da04532342ad8632dbece23c 2x, https://si.imgix.net/b48e341c/uploads/origins/55eaaafe-f6bc-46b1-8352-75867b7e38f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03e1b3fe893ce1c9fab066cce24144fc 3x", "genre": "art", "nsfw": false, "body": "キャラクターロクサス（キングダムハーツ）\n\nロクサスは『キングダム ハーツ』シリーズで一番好きなキャラクターだ。彼の持つクールな雰囲気がとても好きなんだ。クールな性格、クールな衣装、クールな髪型、そして悲しいストーリー。\n(それに、彼はシーソルト・アイスクリームを食べるのが大好きで、お腹が大きくなるかもしれないね。）\n\nとにかく、キングダムハーツ2のオープニングで、ロクサスが水の中を落ちていくシーンがあるんだ。\n下のリンクの4:04あたりから見ることができる。\nhttps://youtu.be/im5tc4fcg5w?si=sszmM21zZcnCIp6g&t=244\n\nリクエストとしては、ロクサスが星空から落ちている絵が欲しいです。\nただ、ロクサスは落下中に衣装からおなかが出ています。彼のおなかは、あなたが最初に描いたハロウィン・プライドの写真のような、かわいくて柔らかくてぷにぷにしたお腹になると思います。\nロクサスがシーンのように安らかに目を閉じているか、おなかを出して落下していることに気づいて驚いた顔をしているかは、あなたが決めてください。\n\nいつものように、どんなディテールでもあなたが正しいと思うように変えてください。この作品を描くのは簡単ではないかもしれませんが、あなたの作風がとても好きなので、私の好きなキャラクターを描いてほしいです。犬さん、もし引き受けてくださったら、本当にありがとうございます！\n\nhttps://youtu.be/im5tc4fcg5w?si=sszmM21zZcnCIp6g&t=244", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/12", "thumbnail_src": "https://si.imgix.net/fe6f6bef/uploads/origins/c7195b0d-5323-41ca-bbe3-abb09c4f0747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0721ba4e0912ec42351c1e92c8df0bb", "thumbnail_srcset": "https://si.imgix.net/fe6f6bef/uploads/origins/c7195b0d-5323-41ca-bbe3-abb09c4f0747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0721ba4e0912ec42351c1e92c8df0bb, https://si.imgix.net/fe6f6bef/uploads/origins/c7195b0d-5323-41ca-bbe3-abb09c4f0747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ff0f36a28d29a592e78c9f7bcc5ed3b 2x, https://si.imgix.net/fe6f6bef/uploads/origins/c7195b0d-5323-41ca-bbe3-abb09c4f0747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c127aed98763706cc946991abfc5416a 3x", "genre": "art", "nsfw": false, "body": "あらすじ\n刑務所にプライドの(元)マネージャーが面会にやってくる。\nマネージャーの手には、プライドが俳優時代に演じたスパイの衣装が。\n着てみろ。と笑みを浮かべながら衣装を手渡す。\n悪態をつきながらも着替え始めるプライドだったが、肥えた身体にサイズがあうはずもなく…\n\nBefore/Afterの2枚でお願いします。\n1枚目\n衣装に身を包み、スパイ役を演じている当時の姿\n細身で引き締まっていることを分かりやすくして頂けるとありがたいです(腹チラ等)\nとにかくイケメン度を盛って欲しいです\n\n2枚目\n刑務所生活でまるまると太った姿\n腕や脚はギリギリ入っているもののパツパツで肉のムチムチ感が見て取れる\nまた、シャツやスーツのボタンは閉められず前は開いたまま(全部か一部かは任意)\n体にフィットするインナーも当時のものなので、お腹を覆い切れてない\n恥ずかしさと焦りで赤面気味\n\n(マネージャーの顔をワイプとか何かしらで入れてもらえると嬉しいです)", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/11", "thumbnail_src": "https://si.imgix.net/c98f39de/uploads/origins/5c53a3b7-0cc7-4531-9ea1-9d18cdaad73b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d97a734a48bab1e1255657fa3df48ef", "thumbnail_srcset": "https://si.imgix.net/c98f39de/uploads/origins/5c53a3b7-0cc7-4531-9ea1-9d18cdaad73b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d97a734a48bab1e1255657fa3df48ef, https://si.imgix.net/c98f39de/uploads/origins/5c53a3b7-0cc7-4531-9ea1-9d18cdaad73b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e268f35d2f7845e7ebb907717f0a9295 2x, https://si.imgix.net/c98f39de/uploads/origins/5c53a3b7-0cc7-4531-9ea1-9d18cdaad73b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5819155cf664e6acc360d9dd1a871310 3x", "genre": "art", "nsfw": false, "body": "いぬさん、こんにちは！プライドに関わる別の依頼があるのですが、これは必ずしもおなかの写真ではありません。\n\n囚人たちの設定を読ませていただきました。ナマケモノは唯一プライドのお喋りをなんとなく聞いてくれそうで、プライドのお兄ちゃん的な存在でもあるような気がします。\n\nそこで、こんなシナリオを想像してみた。\nある日、プライドとナマケモノが夕食を共にしたとき、プライドはまた役者時代の自慢話を始め、ナマケモノはいつものようにそれを半信半疑で聞いていた。\nしかし、お酒が入った後、プライドは突然ナマケモノに、自慢話の半分は事実ではなかったと打ち明ける。プライドは涙を流し、自分の自慢話はすべて自信のなさと内面の葛藤のせいだと認める。そしてナマケモノに、あの日自分がしたことを話す。\n(ナマケモノは、プライドの傲慢な振る舞いが単なる見せかけであることをすでに知っていたと思うが）。\n\n写真では、プライドはナマケモノの腕の中で泣きながら告白している。ナマケモノはプライドの話を熱心に聞き、頭を撫でて慰めようとしている。\n(翌日、プライドはいつもの傲慢で子供っぽい性格に戻り、ナマケモノは何事もなかったかのようにする）。\n\n\nあなたのOCを使って別の絵をお願いして申し訳ないのですが、私はどうしてもこのシーンが見たいのです（プライドにふさわしいと思うので）。\nもしこれがあなたのOCにそぐわないと思うなら、受け入れなくてもいい。\n彼らの個性に合うように細部を変えることもできるし、制服を着るか私服を着るか決めることもできる。 お腹が出ているかどうかもね。\n\n最後に、素晴らしいOCを作ってくれてありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/10", "thumbnail_src": "https://si.imgix.net/0af6d3f1/uploads/origins/f5f5bff9-609a-4a5e-b710-22d84cd7dffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e41a9c888d472b0cd4b617cfac4236f8", "thumbnail_srcset": "https://si.imgix.net/0af6d3f1/uploads/origins/f5f5bff9-609a-4a5e-b710-22d84cd7dffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e41a9c888d472b0cd4b617cfac4236f8, https://si.imgix.net/0af6d3f1/uploads/origins/f5f5bff9-609a-4a5e-b710-22d84cd7dffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78d8350577a5949373e8d3df63e9df38 2x, https://si.imgix.net/0af6d3f1/uploads/origins/f5f5bff9-609a-4a5e-b710-22d84cd7dffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a56052160f3945f3bc1ac11703b52a2d 3x", "genre": "art", "nsfw": false, "body": "刑事さんを描いていただきたいです↓\nhttps://x.com/sore3369noido11/status/1750822862997578196?s=46&t=IGVM4QACGbVWROsT0c0xsQ\n\nもし大丈夫なら以下のようなシチュエーションは如何でしょうか…(別のシチュエーションでも構いません)\n\n・膨腹好きかフィーダー気質の犯罪者に捕まって、椅子に縛り付けられ大量の食べ物を次々と詰め込まれる刑事さん(囮捜査みたいなイメージでも良いかもです)\n・お腹が今にもはち切れそうで苦しいけど、犯人を睨みつけるか挑発的な笑みを浮かべている\n・後ろや横に空になった皿や鍋が積み重なっていると嬉しいです😊\n\n以前お見かけした時に気になっていたキャラなので、是非描いていただきたいです！", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/9", "thumbnail_src": "https://si.imgix.net/70fcdffb/uploads/origins/33342b5d-21d1-4295-836b-77b19f1ab909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9514f32f84d67c41dc2324604cb71bc", "thumbnail_srcset": "https://si.imgix.net/70fcdffb/uploads/origins/33342b5d-21d1-4295-836b-77b19f1ab909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9514f32f84d67c41dc2324604cb71bc, https://si.imgix.net/70fcdffb/uploads/origins/33342b5d-21d1-4295-836b-77b19f1ab909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6517cb92ca52ab19ba1119bdf244a5b 2x, https://si.imgix.net/70fcdffb/uploads/origins/33342b5d-21d1-4295-836b-77b19f1ab909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43fedb5880dbfaf54711c84fd11d5c40 3x", "genre": "art", "nsfw": false, "body": "配信中に太り過ぎでゲーミングチェア壊してしまい、落ちた衝撃と揺れた肉で服が捲れ上がっている状態で、床に尻もちついて何が起きたかわかってない顔をしている配信者くんをお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@Para3369noido11/works/8", "thumbnail_src": "https://si.imgix.net/0b467d33/uploads/origins/896bc682-86cc-4ed1-9cd6-a09cb0c27d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe1bc4ad957314803c402d80ce54f1a9", "thumbnail_srcset": "https://