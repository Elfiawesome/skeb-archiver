rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1eafef97990c8057aee21f75d16bd22 2x, https://si.imgix.net/e76729f3/uploads/origins/363e9ecf-5982-4f13-9d60-29b7575820eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5c1bebd0fae9cb512b0f27d17a4889 3x", "genre": "art", "nsfw": true, "body": "シンフォギアXDの雪音クリス(Another)の手錠拘束連行シーンお願いします！\n\n○衣装：\n参考URLの制服\nhttps://ibb.co/XZr6tZLt\nhttps://skeb.jp/@ugandam_00/works/246\n○シチュエーション\n環境はS.O.N.G.の潜水艦内部の通路です\n手錠拘束+黒い布で目隠し\nもちろん何も見えない、左右にシンフォギア奏者（二課制服、誰でも）にはさまれて、両脇から腕を抱えられる形で連行。\n\n以上！\n他の詳細はお任せします、自由に調整してください。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ugandam_00/works/352", "thumbnail_src": "https://si.imgix.net/57271431/uploads/origins/3772ba42-5eea-4256-beb1-d0c46263a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a986f1194202777963c7734939f4ce23", "thumbnail_srcset": "https://si.imgix.net/57271431/uploads/origins/3772ba42-5eea-4256-beb1-d0c46263a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a986f1194202777963c7734939f4ce23, https://si.imgix.net/57271431/uploads/origins/3772ba42-5eea-4256-beb1-d0c46263a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f2f98ee995dd022c7bcc30a650065ae 2x, https://si.imgix.net/57271431/uploads/origins/3772ba42-5eea-4256-beb1-d0c46263a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a4cf7e0eedc55a384630cb7f34b55a6 3x", "genre": "art", "nsfw": true, "body": "久しぶりの依頼です。\n今回はプリキュアシリーズのキャラでお願いします。\n\nキャラはヒープリの花寺のどかと沢泉ちゆで\n2人ともプリキュアの衣装(ミッドフォーム)で\n手錠をかけられているイラストをお願いします。\n構図は以下のイラストと同じ感じです。\nhttps://skeb.jp/@ugandam_00/works/301\n表情は怯えているものと照れているものの\n二つをお願いします。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ugandam_00/works/351", "thumbnail_src": "https://si.imgix.net/34ab93ef/uploads/origins/b7029adc-71ac-4b00-be39-78a4c483918a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a72179f2bb373f12b2686322b4bfb5ee", "thumbnail_srcset": "https://si.imgix.net/34ab93ef/uploads/origins/b7029adc-71ac-4b00-be39-78a4c483918a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a72179f2bb373f12b2686322b4bfb5ee, https://si.imgix.net/34ab93ef/uploads/origins/b7029adc-71ac-4b00-be39-78a4c483918a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74b8382472bd723c5f690433e1693331 2x, https://si.imgix.net/34ab93ef/uploads/origins/b7029adc-71ac-4b00-be39-78a4c483918a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b77f45c632ad0fe4b673240d1e81b04f 3x", "genre": "art", "nsfw": true, "body": "度々お世話になっております。\n以前先生が描かれた灰島ちゃん拘束\nhttps://skeb.jp/@ugandam_00/works/274\nが非常に素敵でしたので、護摩堂睦美ちゃんで似たシチュエーションのイラストお願いします。\n\n【衣装】\n仰陽館(リディアン)制服。靴下は前回\nhttps://skeb.jp/@ugandam_00/works/265\nと同じもの+靴は茶色のローファー。\n\n【拘束状態】\n・人外である防人兵器の膂力でも抜け出せないようキューブ状の装置で手首から先を固められた状態。手は体の前側でお願いします(気持ち10°程度の前傾姿勢)。\n・腕部の拘束については胸を潰さないように胸の下、灰島ちゃんに使ったものよりやや太幅のベルト1本でお願いします(手を固めた異端技術と同種であるため同じ色、等のディテールはお任せします)。\n・太腿はなるべく閉じた状態。\n【拘束する側】\nクリスとマリアの姿を模したアンドロイド(本物と外見上の差異は無し)。\n・服装はそれぞれ無印私服とG前半私服(参照：https://x.com/ves_ZoL/status/1924151545740030148)\n・構図によって顔が映る際は表情を両者共に先生が度々描かれている\nhttps://skeb.jp/@ugandam_00/works/304\nのシリーズのような終始ハイライト無しの無表情でお願いします。\n【流れ】\n①2体に挟まれながら\nhttps://x.com/oh_miura3/status/1687511305773838336\nの1枚目の生徒Aのようなキリッとした目つきで気丈に振舞う睦美ちゃん。\n②啖呵を切ろうとするも、偽マリアによって片方の外耳を覆うハッキング装置を取り付けられる。\n③装置により電子頭脳を弄られ(いわゆる「ﾁｷﾁｷ」)、瞳にノイズが走るor瞳が収縮する睦美ちゃんの様子。\n(「ﾁｷﾁｷ」参照：https://dic.pixiv.net/a/%EF%BE%81%EF%BD%B7%EF%BE%81%EF%BD%B7)\n④洗脳が完了し、ハイライトの無いやや蕩けた表情で妖艶に微笑む睦美ちゃん。\n\n条件付再送にもお時間お掛けするかもしれませんが可能な限り応えていきたい所存です。\n参照が多く冗長かもしれませんが何卒ご一考いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@ugandam_00/works/350", "thumbnail_src": "https://si.imgix.net/e7b7650e/uploads/origins/62d611e1-5396-445b-90ff-3b2cdbe791d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&t