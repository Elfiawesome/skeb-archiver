49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a81392dcb82fa7242b89c3ce03dd5dc2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/65", "thumbnail_src": "https://si.imgix.net/1146ed8c/uploads/origins/512296f5-c5ff-449f-adbc-b62a8c1384b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3373a890513b0a2ae5351fbe76451ec", "thumbnail_srcset": "https://si.imgix.net/1146ed8c/uploads/origins/512296f5-c5ff-449f-adbc-b62a8c1384b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3373a890513b0a2ae5351fbe76451ec, https://si.imgix.net/1146ed8c/uploads/origins/512296f5-c5ff-449f-adbc-b62a8c1384b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08bfa2718a893cbf5eac754843158ea8 2x, https://si.imgix.net/1146ed8c/uploads/origins/512296f5-c5ff-449f-adbc-b62a8c1384b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d8eb4c5dbfff88f734d896f1570511b 3x", "genre": "art", "nsfw": false, "body": "初めまして！YKというものです！早速ですがロックマンエグゼのアニメ無印オリジナルキャラのバーチャルアイドルのAKIちゃんをお願いできますでしょうか?衣装は普段のアイドル衣装でお願い致します!ご検討の元お願いいたします!\nhttps://drive.google.com/drive/folders/1-C5LJKkz635QU-ayn1JeUQJsfT4wNj-I", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/64", "thumbnail_src": "https://si.imgix.net/b98e6c5b/uploads/origins/91fc6c85-4d50-4db1-878d-c2ab36b17632?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caf1360eb704051968655f563608a60a", "thumbnail_srcset": "https://si.imgix.net/b98e6c5b/uploads/origins/91fc6c85-4d50-4db1-878d-c2ab36b17632?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caf1360eb704051968655f563608a60a, https://si.imgix.net/b98e6c5b/uploads/origins/91fc6c85-4d50-4db1-878d-c2ab36b17632?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faba263aedb9fcb2bc523d589c68d24f 2x, https://si.imgix.net/b98e6c5b/uploads/origins/91fc6c85-4d50-4db1-878d-c2ab36b17632?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31c385dc9e95bfa57591d06600745e00 3x", "genre": "art", "nsfw": false, "body": "きょう様こんにちは。\n手数料無料期間なのでリクエストを送付します！\n\n内容はロックマンエグゼの色綾まどいさん衣装チェンジで、資料URLの城ヶ崎美嘉の衣装を着せて欲しいです。\n\nよろしくお願いします！\n\nhttps://www.cafereo.co.jp/goods/27283", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/63", "thumbnail_src": "https://si.imgix.net/b7c49b43/uploads/origins/c5318eb9-6ea9-421b-b4ca-6476c1cf4b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95096c90d36e39509c2ee0e25c640ca9", "thumbnail_srcset": "https://si.imgix.net/b7c49b43/uploads/origins/c5318eb9-6ea9-421b-b4ca-6476c1cf4b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95096c90d36e39509c2ee0e25c640ca9, https://si.imgix.net/b7c49b43/uploads/origins/c5318eb9-6ea9-421b-b4ca-6476c1cf4b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe1dca1e8f508fea8e753659a94efb72 2x, https://si.imgix.net/b7c49b43/uploads/origins/c5318eb9-6ea9-421b-b4ca-6476c1cf4b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dc8bf963b168f44e802cf8058128053 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます。\n描いてほしいキャラ：美神令子（GS美神）\nシチュ：「マネキンが招く！」より、マネキン化してしまった令子(普段のボディコン姿で)と、その横で彼女を弄ぶ彼女と同じ格好をしたマネキンの悪魔。\n\nマネキン化した令子は直立不動のポーズを取っている\nマネキンの悪魔は令子の肩に手をおき、令子の身体を触る。\n　\nセリフ（参考）\n令子「・・・・・」\nマ「うふふふ・・・最強のゴーストスイーパーもマネキンになってしまえばどうということはないわ」\nマ「この美しい姿、たっぷり利用させてもらおう・・・」\nマ？「今日から私が新しい美神令子よ。」\nマ？「気に入った人間はマネキンにして・・・私のコレクションにしてあげるわ」\n\n備考：\nポーズはそのままに令子に擬態した状態を差分として入れていただければ幸いです。\n（そのときは邪悪な笑みで）\n\nご検討いただければ幸いです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/62", "thumbnail_src": "https://si.imgix.net/b62dac22/uploads/origins/23aa3cdd-b9d7-4132-8c3a-656e3f64798a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f2af7aa57e951780c66a0bebb1b19e2", "thumbnail_srcset": "https://si.imgix.net/b62dac22/uploads/origins/23aa3cdd-b9d7-4132-8c3a-656e3f64798a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f2af7aa57e951780c66a0bebb1b19e2, https://si.imgix.net/b62dac22/uploads/origins/23aa3cdd-b9d7-4132-8c3a-656e3f64798a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a8e2ec28a29ca27ea4180bc1b670968 2x, https://si.imgix.net/b62dac22/uploads/origins/23aa3cdd-b9d7-4132-8c3a-656e3f64798a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e10dc4d42e775280f676d6a81e213b8a 3x", "genre": "art", "nsfw": false, "body": "きょう様こんにちは。\n前回のリクエストもありがとうございました。微笑ましくて可愛かったです...！\n\n新しいリクエストですが、今回はロックマンエグゼのロールちゃん（ノーマル）の人間態をお願いします！\n\n要望としては体つきや髪色はダークロールの時と同じ感じで、後はお任せです。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/61", "thumbnail_src": "https://si.imgix.net/3dac60c2/uploads/origins/e32114c4-e191-4b60-a3bb-4c57d888c73b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2401ff3bc4408545c4683185cab6d6e5", "thumbnail_srcset": "https://si.imgix.net/3dac60c2/uploads/origins/e32114c4-e191-4b60-a3bb-4c57d888c73b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2401ff3bc4408545c4683185cab6d6e5, https://si.imgix.net/3dac60c2/uploads/origins/e32114c4-e191-4b60-a3bb-4c57d888c73b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a3e4a0603e3a2af537cbe195486bf2c 2x, https://si.imgix.net/3dac60c2/uploads/origins/e32114c4-e191-4b60-a3bb-4c57d888c73b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74276f602c17cf8ed0ae07790baa238 3x", "genre": "art", "nsfw": false, "body": "新一君と明美さんのイラストありがとうございました。また新一君と明美さん（新明）の悪堕ちイラストになってしまいますがリクエストお願いします。悪堕ちした新一君と明美さんがボロボロになって倒れている赤井さんと蘭姉ちゃん（明美さんにやられた設定）を冷酷な表情で見下している感じのイラストをお願いします。新一君の服装はお任せします。明美さんの服装は黒のハイレグのラバースーツで胸が少し露出してる感じで2人の全身が写る感じでお願いします。因みに赤井さんと蘭姉ちゃんは描かなくて良いです。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/60", "thumbnail_src": "https://si.imgix.net/c809dbf3/uploads/origins/0eb946a2-43d6-4c2d-acc2-1926fb16cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd39a76dd8d4e12da9a1a54518e1b73", "thumbnail_srcset": "https://si.imgix.net/c809dbf3/uploads/origins/0eb946a2-43d6-4c2d-acc2-1926fb16cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd39a76dd8d4e12da9a1a54518e1b73, https://si.imgix.net/c809dbf3/uploads/origins/0eb946a2-43d6-4c2d-acc2-1926fb16cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8969883548edc268aca6613f87a101b0 2x, https://si.imgix.net/c809dbf3/uploads/origins/0eb946a2-43d6-4c2d-acc2-1926fb16cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b5a683575606d1fa4f823cc193a8659 3x", "genre": "art", "nsfw": false, "body": "こんにちは。前回のイラストも素晴らしかったです！ほぼオリキャラのデザイン依頼でしたが、リクエストして良かったです。\n\n今回は初期のポケモンアニメオリジナルキャラクターから2キャラリクエストさせて頂きます。\n\nキャラクターは、ミー・スノードン（18歳）とウチキド博士。\n構図はお任せですが、ふたりが密着していると嬉しいです。\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/59", "thumbnail_src": "https://si.imgix.net/f9b845fa/uploads/origins/6a72119f-1214-4ba7-baeb-47f4d80449bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b3eb56690b78f3c33fe2ad18e170699", "thumbnail_srcset": "https://si.imgix.net/f9b845fa/uploads/origins/6a72119f-1214-4ba7-baeb-47f4d80449bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b3eb56690b78f3c33fe2ad18e170699, https://si.imgix.net/f9b845fa/uploads/origins/6a72119f-1214-4ba7-baeb-47f4d80449bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fddb14d9538bcaef21d5acf4e22861d 2x, https://si.imgix.net/f9b845fa/uploads/origins/6a72119f-1214-4ba7-baeb-47f4d80449bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d26acd857748ee232fba9703e74bd75e 3x", "genre": "art", "nsfw": false, "body": "初めましてこんにちは。\nOCの女子高生が蛇の女怪人になった姿を横に並べたBefore/Afterのようなの姿が並び立っているイラストを描いていただけないでしょうか。\n女怪人の姿はマジレンジャーのゴーゴンや仮面ライダーウィザードのメデューサみたいな感じでお願いします。\n細かいデザイン等はおまかせします。\nよろしければお願いします。\nhttps://drive.google.com/drive/folders/1EuaSRYKRYQUK0Fb7v6G_Epcuv6lrK2rj", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/58", "thumbnail_src": "https://si.imgix.net/1b8f502a/uploads/origins/7e87fa14-4892-4d33-9a9b-117a86c1f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d5e7e25a59d068625b08545dd8e76e4", "thumbnail_srcset": "https://si.imgix.net/1b8f502a/uploads/origins/7e87fa14-4892-4d33-9a9b-117a86c1f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d5e7e25a59d068625b08545dd8e76e4, https://si.imgix.net/1b8f502a/uploads/origins/7e87fa14-4892-4d33-9a9b-117a86c1f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f838a4aa506dc0f15948f9aa2c5ec975 2x, https://si.imgix.net/1b8f502a/uploads/origins/7e87fa14-4892-4d33-9a9b-117a86c1f33e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9629c1da9ebd749581f97592e24bfed9 3x", "genre": "art", "nsfw": false, "body": "きょう様こんにちは。手数料無料のキャンペーンをやっているようなのでリクエストさせて頂きます！\n\n今回はロックマンエグゼのダークロールちゃんのリクエストです。\nロックマンXdiveでフェラム（https://dic.pixiv.net/a/%E3%83%95%E3%82%A7%E3%83%A9%E3%83%A0）が衣装チェンジで下記URLの姿になるのですが、\nhttps://wikiwiki.jp/rockmanxdive/%E5%A4%A9%E9%99%BD%E3%81%AE%E3%83%95%E3%82%A7%E3%83%A9%E3%83%A0\n\nこのノリでダークロールちゃんの人間態（？）を描いて頂きたいです。\n盛り込んで欲しい要素としては、\n・髪型はお任せですが、髪色は金髪\n・胸やふとももは盛ってほしい\n\nといった感じです。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/57", "thumbnail_src": "https://si.imgix.net/3793ad89/uploads/origins/486a064e-5f62-4217-9821-8ec65377abec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5269e744395aa17e76842acc3476167a", "thumbnail_srcset": "https://si.imgix.net/3793ad89/uploads/origins/486a064e-5f62-4217-9821-8ec65377abec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5269e744395aa17e76842acc3476167a, https://si.imgix.net/3793ad89/uploads/origins/486a064e-5f62-4217-9821-8ec65377abec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ed2972b912bc5833bf124d0f975e616 2x, https://si.imgix.net/3793ad89/uploads/origins/486a064e-5f62-4217-9821-8ec65377abec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=708eaf771035fa97bb96edf264ab12eb 3x", "genre": "art", "nsfw": false, "body": "きょう様いつもありがとうございます。\n今回は衣装チェンジのリクエストです。\n\nFF7のティファがFFTのセリアとレディが着ているような踊り子衣装を着たイラストをお願いします。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/56", "thumbnail_src": "https://si.imgix.net/7288795b/uploads/origins/01b39393-e6ee-4c14-ae94-dab1cbd05b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44edbe142134a18520429bbbb28393fd", "thumbnail_srcset": "https://si.imgix.net/7288795b/uploads/origins/01b39393-e6ee-4c14-ae94-dab1cbd05b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44edbe142134a18520429bbbb28393fd, https://si.imgix.net/7288795b/uploads/origins/01b39393-e6ee-4c14-ae94-dab1cbd05b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b94581122df02a1f5339fba4c9e0dc04 2x, https://si.imgix.net/7288795b/uploads/origins/01b39393-e6ee-4c14-ae94-dab1cbd05b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d2c857160a5210b8c81b3784e90dae1 3x", "genre": "art", "nsfw": false, "body": "リクエストお願いします。また名探偵コナンの新一君と明美さん（新明）の悪堕ちのイラストと赤井さんと蘭をお願いします。2枚お願いしたいです。1枚目は新一君と明美さん2人の全身が写る感じで、ボロボロの赤井さんとボロボロの蘭（明美さんにやられた設定で因みに明美さんはFBIの設定です。新一君は恋人である明美さんに洗脳され悪堕ちした設定）を新一君と明美さんがくっつきながら悪い顔で不敵に微笑み見ている感じで（1枚目には赤井さんと蘭は描かなくて良いです）2枚目も1枚目と同じ感じですが、全身は描かなくて良いですが、ボロボロの赤井さんとボロボロの蘭が驚愕しているイラストを追加見たいな感じでお願いしたいです。因みに新一君の服装はお任せします。明美さんの服装は今回は黒のハイレグのラバースーツ（URLの画像と同じ感じの服装でお願いします）で胸が少し露出してる感じでお願いします。（参考URL貼っときます。https://www.pixiv.net/artworks/108602818", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/55", "thumbnail_src": "https://si.imgix.net/458e756b/uploads/origins/abc2bea0-8e46-4d33-8f1e-d02e84b25674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e327e1d13bfae7530075b2da98388102", "thumbnail_srcset": "https://si.imgix.net/458e756b/uploads/origins/abc2bea0-8e46-4d33-8f1e-d02e84b25674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e327e1d13bfae7530075b2da98388102, https://si.imgix.net/458e756b/uploads/origins/abc2bea0-8e46-4d33-8f1e-d02e84b25674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f39b5534dab955177a1a8565220db48e 2x, https://si.imgix.net/458e756b/uploads/origins/abc2bea0-8e46-4d33-8f1e-d02e84b25674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9ff220c0847dcf10524617945c4e16e 3x", "genre": "art", "nsfw": false, "body": "こんにちは。前回のマルティナバニー衣装が素晴らしかったので、また衣装チェンジのリクエストをさせて下さい！\n\nキャラクターはロックマンエグゼのテスラ・マグネッツ。\nマルティナの黒バニー衣装を着ていて、ベッドで足組みをして座っているシチュエーションが希望です。（胸は前回のミーちゃんくらいに盛って頂けると嬉しいです（笑））\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/54", "thumbnail_src": "https://si.imgix.net/2b62481b/uploads/origins/1bcb4de5-f614-4814-b697-5dd35fa4e42b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb7f7fff83f7d501ab8bc8a85fe8adae", "thumbnail_srcset": "https://si.imgix.net/2b62481b/uploads/origins/1bcb4de5-f614-4814-b697-5dd35fa4e42b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb7f7fff83f7d501ab8bc8a85fe8adae, https://si.imgix.net/2b62481b/uploads/origins/1bcb4de5-f614-4814-b697-5dd35fa4e42b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04f5debd37408eb13398ac5fecdd5d10 2x, https://si.imgix.net/2b62481b/uploads/origins/1bcb4de5-f614-4814-b697-5dd35fa4e42b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95201bb36a70d350ea248449d8ec448b 3x", "genre": "art", "nsfw": false, "body": "こんにちは!\nリクエスト送信させて下さい。\n\n今回は衣装チェンジをお願いしたいです。\nキャラクターは以前も描いて頂いたオリジナルのミー・スノードン。（https://skeb.jp/@kikopoko11/works/13） \n\n衣装はドラクエ11のマルティナの黒バニーが希望です。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/53", "thumbnail_src": "https://si.imgix.net/23790d87/uploads/origins/d718fb52-7a96-4840-a87e-e15bb998531f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83058d17115860ab49452553b35edc1", "thumbnail_srcset": "https://si.imgix.net/23790d87/uploads/origins/d718fb52-7a96-4840-a87e-e15bb998531f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83058d17115860ab49452553b35edc1, https://si.imgix.net/23790d87/uploads/origins/d718fb52-7a96-4840-a87e-e15bb998531f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=552fea78f8dc2bb2113fa75a7bb33af5 2x, https://si.imgix.net/23790d87/uploads/origins/d718fb52-7a96-4840-a87e-e15bb998531f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7e4da700c86adaf9fee20139f8cdf7 3x", "genre": "art", "nsfw": false, "body": "こないだの明美さんと新一君、ジンのイラストありがとうございます。またリクエストお願いします。同じく名探偵コナンの新一君と明美さん（新明）のイラストをお願い出来ますか?明美さんの手作りレモンパイを仲良く美味しそうに食べている感じでお願いします。（新一君は凄く嬉しそうに美味しそうに食べている感じで、明美さんもそんな新一君を見て嬉しそうな顔をして食べている感じで）、二枚目もOKでしたら（無理なら一枚だけで良いです）二枚目はレモンパイを食べ終わった後に、明美さんが新一君にキスをし新一君が顔を紅くしているイラストもお願いします。因みに服装はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/52", "thumbnail_src": "https://si.imgix.net/51c924fd/uploads/origins/88434f98-da7d-4057-9c02-38f4a672963a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41720e96ff867e9f0a234bf79dadf97c", "thumbnail_srcset": "https://si.imgix.net/51c924fd/uploads/origins/88434f98-da7d-4057-9c02-38f4a672963a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41720e96ff867e9f0a234bf79dadf97c, https://si.imgix.net/51c924fd/uploads/origins/88434f98-da7d-4057-9c02-38f4a672963a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2810fef32eaaa85ea23fab84ead731fa 2x, https://si.imgix.net/51c924fd/uploads/origins/88434f98-da7d-4057-9c02-38f4a672963a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c862de7358428663a658fd6c3af8204 3x", "genre": "art", "nsfw": false, "body": "きょう様こんにちは。\n今回もセラムンキャラの水着姿を描いて頂きたく、リクエストします！\n\nキャラクターは海王みちる。\nどんな水着かはまたお任せなのですが、前回のうさぎちゃんと同じ場所の、その隣にいるような雰囲気で描いて頂きたいです。\n（イメージ的には2枚のイラストを組み合わせて1枚になるような感じですかね? 分かりにくくてすみません）\n\nよろしくお願いします...！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/51", "thumbnail_src": "https://si.imgix.net/eaa46e6c/uploads/origins/26e26eea-421a-4eeb-b492-d09e7f458f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbb3a6729731556fd176decc05467d37", "thumbnail_srcset": "https://si.imgix.net/eaa46e6c/uploads/origins/26e26eea-421a-4eeb-b492-d09e7f458f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbb3a6729731556fd176decc05467d37, https://si.imgix.net/eaa46e6c/uploads/origins/26e26eea-421a-4eeb-b492-d09e7f458f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36fbd67057ed89d7ca48ba7c3208575a 2x, https://si.imgix.net/eaa46e6c/uploads/origins/26e26eea-421a-4eeb-b492-d09e7f458f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bc856da4f8091e5973b8608c8f02a3b 3x", "genre": "art", "nsfw": false, "body": "きょう様こんにちは。\n手数料無料期間らしいのでリクエスト送付します！\n\n今回は、何度か描いていただいている闇堕ちした月野うさぎの水着姿が希望です。\n\n黒色の水着ならあとはおまかせなのですが、悪堕ちの凶暴さより大人の女性的な妖艶さを重視して下さると幸いです。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/50", "thumbnail_src": "https://si.imgix.net/2016a64e/uploads/origins/ce75b106-a801-4279-850c-8fb80f36283d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73d5d3c60996bab06555460137242199", "thumbnail_srcset": "https://si.imgix.net/2016a64e/uploads/origins/ce75b106-a801-4279-850c-8fb80f36283d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73d5d3c60996bab06555460137242199, https://si.imgix.net/2016a64e/uploads/origins/ce75b106-a801-4279-850c-8fb80f36283d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7ea4b6808a26c4dea13ce0ada7a7b2d 2x, https://si.imgix.net/2016a64e/uploads/origins/ce75b106-a801-4279-850c-8fb80f36283d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d13e4531a55a3a6e0c76bd7ef13c2af7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエスト再開ありがとうございます。また悪堕ちイラストになってしまいますがリクエストお願いします。名探偵コナンの宮野明美と工藤新一、ジンをお願いします。悪堕ちした明美さんが、ボロボロの状態で倒れているジン（悪堕ちした新一君と明美さんにやられた設定）に冷酷な表情で見下しながら不敵に微笑み、銃を向けている感じのイラストをお願いします。新一君は不敵に微笑んでいる感じでジンはボロボロ状態で何とか顔を上げては居るが驚愕の表情をしている感じでお願いします。新一君と明美さんの服装はお任せしますが色は黒色で明美さんの谷間が見える感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/49", "thumbnail_src": "https://si.imgix.net/48ededb8/uploads/origins/e5e3b875-7195-4fbf-9c71-3974264dc982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de5a3f1bdb894b11141499f361292cb8", "thumbnail_srcset": "https://si.imgix.net/48ededb8/uploads/origins/e5e3b875-7195-4fbf-9c71-3974264dc982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de5a3f1bdb894b11141499f361292cb8, https://si.imgix.net/48ededb8/uploads/origins/e5e3b875-7195-4fbf-9c71-3974264dc982?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277e4a8a492b277ae6124a5187f36960 2x, https://si.imgix.net/48ededb8/uploads/origins/e5e3b875-7195-4fbf-9c71-3974264dc982?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31fbf075b280d87431867a71fadc5bd1 3x", "genre": "art", "nsfw": false, "body": "こんにちは。リクエスト再開お待ちしておりました！\n\n今回描いて頂きたいのは、以前描いて頂いたオリジナルのミー・スノードン。（https://skeb.jp/@kikopoko11/works/13）\n\nシチュエーションは下記URLを参考にテーブルを挟んで対面しているところをお願いしたいです!\nhttps://www.pixiv.net/artworks/104563410\n\nhttp://gs.dengeki.com/dengekiya/129453/\n\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/48", "thumbnail_src": "https://si.imgix.net/8d10748d/uploads/origins/77c4f4db-bdde-439d-804b-b343934f92c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c27a71fc327d0a6bbebbf8e4598fa78", "thumbnail_srcset": "https://si.imgix.net/8d10748d/uploads/origins/77c4f4db-bdde-439d-804b-b343934f92c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c27a71fc327d0a6bbebbf8e4598fa78, https://si.imgix.net/8d10748d/uploads/origins/77c4f4db-bdde-439d-804b-b343934f92c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=818446873558a39bac9f77f478546c0c 2x, https://si.imgix.net/8d10748d/uploads/origins/77c4f4db-bdde-439d-804b-b343934f92c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb1e7568fc7b8968a7382f0f62d48fdf 3x", "genre": "art", "nsfw": false, "body": "こんにちは。リクエスト送信いたします!\n今回は軌跡シリーズのエマ・ミルスティンをお願いします。\nhttps://www.falcom.co.jp/sen2/chara/main07.html\nhttps://www.falcom.co.jp/sen3/chara/emma.html\nhttps://www.falcom.co.jp/sen4/character/emma.html\n\n閃の軌跡Ⅲ以降のトールズ士官学院・本校の制服を着ているイラストをお願いします。\n\n閃の軌跡Ⅲ以降のトールズ士官学院・本校制服の衣装資料(海外のwikiや他の方の引用で失礼します)\nhttps://static.wikia.nocookie.net/kiseki/images/6/6b/Ada_Grant_%28Sen_III%29.png/revision/latest?cb=20180421055120←タイツやブーツはこっちをベースでお願いします。\nhttps://twitter.com/sumikazu_mitu/status/1012558841253224448\n↕制服の着こなしはこっちをベースでお願いします。\nhttps://pbs.twimg.com/media/E4mJ1z9VgAMXrQT?format=jpg&name=small\n\nエマが閃の軌跡Ⅲ以降のトールズ士官学院・本校の制服を着て、眼鏡を外して髪をほどいていて、美人で戦闘狂で、暴力で相手を屈服させることを好み、戦うことと相手を殺すことの両方に享楽をしている、享楽主義になってる感じでお願いします。\n\n悪堕ちイラストが希望です。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/47", "thumbnail_src": "https://si.imgix.net/fbace784/uploads/origins/2d59d2ea-0a66-4e9d-885b-fdd3e62e4b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a169f2e43df19f81f3e16079b7464c61", "thumbnail_srcset": "https://si.imgix.net/fbace784/uploads/origins/2d59d2ea-0a66-4e9d-885b-fdd3e62e4b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a169f2e43df19f81f3e16079b7464c61, https://si.imgix.net/fbace784/uploads/origins/2d59d2ea-0a66-4e9d-885b-fdd3e62e4b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86e9374c70f255fecfe5b5c89ac794bc 2x, https://si.imgix.net/fbace784/uploads/origins/2d59d2ea-0a66-4e9d-885b-fdd3e62e4b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de4851d475e94b454786f0405e18e7f9 3x", "genre": "art", "nsfw": false, "body": "どうも、前回から立て続けになって申し訳無いです(暫く閉じると聞いたので後悔しないように投げておこうと決意しまして)(後、早めに投げておかないと先客がバンバン来そうなので)(いつもの如く描けそうであれば是非)\n\n資料リンク先、シャイニングウインドのシーナ・カノン(画像左)に、どきどきシャッターチャンスの如月玲香(画像右)の眼鏡、口紅、服装(スーツとズボン)をお願いしますm(_ _)m\n\n・表情は目元を細めて(ジト目、半開きと呼ばれる物です)笑顔を浮かべず冷たい感じで、身体は女子高生で雰囲気が出来る女上司になったイメージです。\n\n・眼鏡の透け具合は元の物より少し高めて頂けると助かります。ポーズや構図はお任せします。\n\n・玲香側はだいぶ前の作品で資料の画質悪いので出来るだけ再現で(もし描いて頂けるのであれば、きょう先生の懇切丁寧な描き込みなら大丈夫だと言う信頼はあるので杞憂になりそうですが(小声)\n\n以上になります、ご検討の方をよろしくお願い致します。\n\nhttps://i.imgur.com/pRBQpyC.jpg", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/46", "thumbnail_src": "https://si.imgix.net/1eccbbeb/uploads/origins/05a0d898-9710-4aef-a3e6-9735755b4365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd0597299b819dd5a574e16dc4d2b8c6", "thumbnail_srcset": "https://si.imgix.net/1eccbbeb/uploads/origins/05a0d898-9710-4aef-a3e6-9735755b4365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd0597299b819dd5a574e16dc4d2b8c6, https://si.imgix.net/1eccbbeb/uploads/origins/05a0d898-9710-4aef-a3e6-9735755b4365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c1339c1d1398ae666eea8d7c6abbd18 2x, https://si.imgix.net/1eccbbeb/uploads/origins/05a0d898-9710-4aef-a3e6-9735755b4365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3219ab1aeee648d3fa0c42f9b563d00f 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n過去に納品していただいたイラストでいくつか再依頼をしたいと思い、前回分の納品前ですがリクエストをさせてください。\n1.スコーピオン・デモンの顔の色コードを参考画像と同じ#dff3e8系統に変更したものも見てみたくなったので差分をお願いします\n2.パティシエ見習いの鼻にクリームがついていない場合も見てみたくなったので差分をお願いします\n3.ナイトメア・デモンと絵本作家のイラストですが、他のイラストと並べた際に頭身の小ささが目立つので、他のイラストの頭身と合わせる修正をお願いします\n以上3点となります。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/45", "thumbnail_src": "https://si.imgix.net/86c9dd27/uploads/origins/bf9187f8-b5fa-461d-b092-44b70d44a8bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34bc207d434ddaa67134ba6802fcc869", "thumbnail_srcset": "https://si.imgix.net/86c9dd27/uploads/origins/bf9187f8-b5fa-461d-b092-44b70d44a8bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34bc207d434ddaa67134ba6802fcc869, https://si.imgix.net/86c9dd27/uploads/origins/bf9187f8-b5fa-461d-b092-44b70d44a8bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6472c2ae6047a8e9962eaf517ade2ad 2x, https://si.imgix.net/86c9dd27/uploads/origins/bf9187f8-b5fa-461d-b092-44b70d44a8bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f70292d060e5735360c72da1be6c401b 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n前回に引き続き、守護戦士エンジェリオンに登場するキャラクターのビフォーアフターイラストをお願いします。\n作中に登場する敵組織デモニアンの女怪人スネーク・デモンとその素体になってしまった女性（シスター）になります。\nそれぞれの全身立ち絵を並べてください。\n構図は前回と同じ形で構いません。\n素体女性の全身デザインとそれぞれのポーズに関してはお任せします。\n下記に参考画像を纏めたURLを記載しているので参考にしてください。\nhttps://drive.google.com/drive/folders/1c5dhs-6u4ddk6kRLR_Kw7aOfQwCS7USp?usp=share_link\n他のイラストと並べて観賞もしたいので、可能でしたら単体の全身立ち絵は透過背景にしていただけると嬉しいです。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/44", "thumbnail_src": "https://si.imgix.net/ec4c8889/uploads/origins/e50edf59-69a4-4299-b91b-dffb00679abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3795286f623ca45d6554d90d4f97ccfe", "thumbnail_srcset": "https://si.imgix.net/ec4c8889/uploads/origins/e50edf59-69a4-4299-b91b-dffb00679abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3795286f623ca45d6554d90d4f97ccfe, https://si.imgix.net/ec4c8889/uploads/origins/e50edf59-69a4-4299-b91b-dffb00679abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fdbfd8d2fe60ba4a78afd73b302810c 2x, https://si.imgix.net/ec4c8889/uploads/origins/e50edf59-69a4-4299-b91b-dffb00679abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c24d41f5054cdcf9dc75c76bc80dc9d7 3x", "genre": "art", "nsfw": false, "body": "きょう様こんにちは。\n今回のリクエストですが、ロックマンエグゼの移植版が発売間近ということで、エグゼロールちゃん2人を描いて頂きたいです！\n\nキャラクターは普通のロールちゃんと悪魔チップで悪堕ちしたダークロール。\n\nアニメ版でレースクイーンのような格好が登場したことがあるのですが、その格好でお願いします。(もちろんダークロールのレースクイーンなんてありませんが、そこは捏造で(笑)\n資料はこちら→https://twitter.com/wanakin0114/status/1643227752005537792?t=P435DZg8f3qj29cYzJ0QEw&s=19\n\nちなみにダークロールはいつもの邪悪な表情というより、セクシーなお姉さん的な雰囲気で描いて頂けると嬉しいです！\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kikopoko11/works/43", "thumbnail_src": "https://si.imgix.net/94dd985f/uploads/origins/277fe2f7-87f4-440c-a905-37f0d922b977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007ff27642f918f3c38732797906f372", "thumbnail_srcset": "https://si.imgix.net/94dd985f/uploads/origins/277fe2f7-87f4-440c-a905-37f0d922b977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007ff27642f918f3c38732797906f372, https://si.imgix.net/94dd985f/uploads/origins/277fe2f7-87f4-440c-a905-37f0d922b977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=333e6d294e3e3ffa5a920dc08b394ae9 2x, https://si.imgix.net/94dd985f/uploads/origins/277fe2f7-87f4-440c-a905-37f0d922b977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5a8603010da68c9b557d5d2fab8adf8 3x", "genre": "art", "nsfw": false, "body": "こないだの工藤新一×宮野明美のビフォーアフターのイラスト