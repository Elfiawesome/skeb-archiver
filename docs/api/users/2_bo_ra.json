a4-5fdae8b962ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abaef20bc0344a4346661777043ad58a, https://si.imgix.net/c2a445b2/uploads/origins/f2f5e407-b7ce-4593-aaa4-5fdae8b962ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd7595846cad3b5387c9e32ae07e9923 2x, https://si.imgix.net/c2a445b2/uploads/origins/f2f5e407-b7ce-4593-aaa4-5fdae8b962ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=886cbe1fc8d76341639529f94fa1d7ff 3x", "genre": "art", "nsfw": false, "body": "こんにちは、オリジナルキャラクターのイメージを描いていただけませんか？\n\n名前は「ヴェセラ」。ファンタジーの世界の女の子です。フクロウのような顔をした女の子です。背中に羽が生えていますが、手は普通です。足はフクロウのように爪がある。目は緑色で、眼球全体が緑色をしている。いくつかの呪文を唱えることができるが、彼女の最大の特徴は占いである。タロットカードのようなハローカードで未来を占うことができる。また、未来のビジョンを見ることもある。身長は180cm以上とかなり高い。\n\n彼女のポーズやその他の詳細は、あなたが選ぶことができます。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/16GlSRgvBFNJdzEWSHBfrNbT5hwy37IfL?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@2_bo_ra/works/276", "thumbnail_src": "https://si.imgix.net/4c2f2236/uploads/origins/246e4409-7060-4d59-a1cf-8bdc509b19f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3847eca04658a93695f8f71840e60e1c", "thumbnail_srcset": "https://si.imgix.net/4c2f2236/uploads/origins/246e4409-7060-4d59-a1cf-8bdc509b19f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3847eca04658a93695f8f71840e60e1c, https://si.imgix.net/4c2f2236/uploads/origins/246e4409-7060-4d59-a1cf-8bdc509b19f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=344000ee271f08795cfd0e3934aff7e7 2x, https://si.imgix.net/4c2f2236/uploads/origins/246e4409-7060-4d59-a1cf-8bdc509b19f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aec84bd64cebe92694b3778645e6ab27 3x", "genre": "art", "nsfw": false, "body": "はじめまして！先生の個性的でかわいい絵に出会って、私のキャラクターも描いていただきたくお願いしたvsingerです<3 リクエストの際、ポーズや衣装は特に考えていなかったので、ご自由に描いてください！特に何かをいただくというよりは、先生の絵の中の娘を見るのが