4490-b58e-d8f760f2e874?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57df1d95311aadc2326ea6a2e4acbe2a, https://si.imgix.net/48dabe4e/uploads/origins/11c2eb26-5b20-4490-b58e-d8f760f2e874?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eb11f8a24e165aebb24d1130a9ec719 2x, https://si.imgix.net/48dabe4e/uploads/origins/11c2eb26-5b20-4490-b58e-d8f760f2e874?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5364921e25e4637ae143388bc5b952e6 3x", "genre": "art", "nsfw": true, "body": "触手に堕とされた私のキャラクター、ルナのイラストをお願いします。\n触手は彼女の耳に入り、彼女を洗脳しています。彼女の服は触手スーツに変わっています。\nその他はお任せします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1f3Tts_6sxEToO4SokINI78tnoEwiQ-Gr/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mikage_sakura/works/74", "thumbnail_src": "https://si.imgix.net/63af41d0/uploads/origins/949bcff3-68a2-4a72-a51b-169fb0e96507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906c2968fdc47ead554d97f435feb1f0", "thumbnail_srcset": "https://si.imgix.net/63af41d0/uploads/origins/949bcff3-68a2-4a72-a51b-169fb0e96507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906c2968fdc47ead554d97f435feb1f0, https://si.imgix.net/63af41d0/uploads/origins/949bcff3-68a2-4a72-a51b-169fb0e96507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bac6672e7b809acc6e772eb66999528 2x, https://si.imgix.net/63af41d0/uploads/origins/949bcff3-68a2-4a72-a51b-169fb0e96507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f459413efcd2a0ad8b121399ab3fbf97 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n先生がリクエストを開けられたと知り飛んで来ました。\n今回もよろしければお受けください。\n\n【作品】フラワーナイトガール\n【キャラクター】ハツユキソウ（花騎士）\nhttps://i.imgur.com/b2FNAPo.png\n【衣装】特に指定はございません\n\n【シチュエーション】\nちびキャラでの依頼です。\n寒くなってまいりました。\n冬の間こたつの主となってくつろぐハツユキソウを描いてください、お願いします。\n\n以上が私の要望でございますが、難しいようであれば先生の御自由にアレンジしていただいても構いません。\n\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "created_at": "", "completed_at": ""}, {"path": "/@mikage_sakura/works/73", "thumbnail_src": "https://si.imgix.net/cc1cb773/uploads/origins/d9b0a526-8432-420c-a0f9-73c6b66e3670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02d5bcfe4efbde54300aac9af50fe33", "thumbnail_srcset": "https://si.imgix.net/cc1cb773/uploads/origins/d9b0a526-8432-420c-a0f9-73c6b66e3670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02d5bcfe4efbde54300aac9af50fe33, https://si.imgix.net/cc1cb773/uploads/origins/d9b0a526-8432-420c-a0f9-73c6b66e3670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=257a923c2dd2ba2857c21111e327d193 2x, https://si.imgix.net/cc1cb773/uploads/origins/d9b0a526-8432-420c-a0f9-73c6b66e3670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d232f6b15bec89d006c2982a44b14dd 3x", "genre": "art", "nsfw": true, "body": "褐色獣ショタ君の触手和えありがとうございました！\n触手から垂れる粘液塗れになりながらお尻に種付けされて、頭の中を弄られ理解できないまま強制的に絞り取られて、最後は弄られ過ぎて廃人化しちゃう様子が最高にエッチでした！\n\nもし何度も同じキャラを描くのが嫌でなければ、もう一度同じ縞々尻尾の褐色獣ショタ君（チンポ小さめ）で、人間牧場で裸で搾精＆搾乳されているシチュエーションをお願いしたいです\nディストピアな感じで、管理拘束されていて栄養は点滴（色んな所に刺さって怪しい色の液体を注入されている）で、ドリルバイブの様な物でお尻を穿られながら、延々と搾精＆搾乳されている\n可能であれば、連れてこられた当初で泣いたりヒギィってなってたりな表情がある感じで液の出が少ないビフォアーと、長い時間で心が折れてレイプ目無表情で液の出が多いアフターみたいな変化\nもし気が向きましたらで構いませんので、その時はよろしくお願いします\n\nhttps://drive.google.com/file/d/1urngRHtcKDcDZzLws4lzFTNDzpLv4W1n/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mikage_sakura/works/72", "thumbnail_src": "https://si.imgix.net/2593d845/uploads/origins/d591682d-f40e-492d-b43c-bb57fc529192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b4708c212e543b9c92e4f4046e9e27", "thumbnail_srcset": "https://si.imgix.net/2593d845/uploads/origins/d591682d-f40e-492d-b43c-bb57fc529192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to