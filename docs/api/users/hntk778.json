f&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7120c9f0b66aa8733a3b10797c57915 2x, https://si.imgix.net/78192333/uploads/origins/2941a700-e66f-4a36-bac5-2a1b0e04ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=945a08c9b062754b1c9e9aee6713aa81 3x", "genre": "art", "nsfw": true, "body": "けものフレンズのカレンダをお願いします。\n\n密猟者達にドール共々捕まるカレンダ。\n\n密猟者に薬を注射され、身体が麻痺するドールと、後ろ手で手錠を掛けられるカレンダ。\n\nその後、密猟者達はドールに集まり始め、胸や太ももを触るなどをし始める。\n\nこれから密猟者がドールにする事を察したカレンダは、自身の身体を好きにして良い代わりに、ドールに手を出さないように交渉し、密猟者はそれを承諾する。\n\nドールが見ている中、半裸にされ、代わる代わる穴という穴を犯され、悶えるカレンダをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/27", "thumbnail_src": "https://si.imgix.net/50af31ff/uploads/origins/6dd8a887-cc19-49af-8404-ed53a73749db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7039256b6ee90d1599a0ecb4977a376", "thumbnail_srcset": "https://si.imgix.net/50af31ff/uploads/origins/6dd8a887-cc19-49af-8404-ed53a73749db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7039256b6ee90d1599a0ecb4977a376, https://si.imgix.net/50af31ff/uploads/origins/6dd8a887-cc19-49af-8404-ed53a73749db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37fe39f20ae4f847d15ecd2fda66532d 2x, https://si.imgix.net/50af31ff/uploads/origins/6dd8a887-cc19-49af-8404-ed53a73749db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0718543fc7b0e7b9715c8d4bf161915c 3x", "genre": "art", "nsfw": true, "body": "キュウビキツ姐さんの誘惑に乗って一線を超えるシチュエーションでリクさせていただきます。\nなお以下の台詞はイメージなので、全てアレンジ・変更OKです。\n　\nキュウビさんを組み敷いているところから始まり、仰向けで脱がされながらもクスクス笑っているところにに挿入。\n「必死で腰振って可愛いわね♡ほら、もっと頑張りなさいな♡」などと喘ぎつつ余裕をチラつかせて来る姿に欲情と対抗心を煽られ、激しく突いたり揉んだりして中出し。\nしかし一回出した程度ではお互い収まらず、そのまま二回戦へ。\n\nラスト。\n数時間後、何回も射精されてドロドロになりながら、予想以上の絶倫さに余裕を保てなくなっているキュウビさん。\n「この私を何度もイカせるなんて……凄いわねあなた♡」\n「でも流石に疲れちゃったし、そろそろ休憩……（話してる途中でまた挿れられた、もしくは中でまた硬くなったのを感じて）あん♡まだするの？♡」\nと、続行を示唆しつつ〆。\n\nというような具合で、ご検討いただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/26", "thumbnail_src": "https://si.imgix.net/759c39cd/uploads/origins/45451c67-1f81-42ab-9bc0-4ced7d396fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97e84fd175359f9c8a08e2ac3899fad7", "thumbnail_srcset": "https://si.imgix.net/759c39cd/uploads/origins/45451c67-1f81-42ab-9bc0-4ced7d396fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97e84fd175359f9c8a08e2ac3899fad7, https://si.imgix.net/759c39cd/uploads/origins/45451c67-1f81-42ab-9bc0-4ced7d396fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d949100be4a8792ac3946644e16436fb 2x, https://si.imgix.net/759c39cd/uploads/origins/45451c67-1f81-42ab-9bc0-4ced7d396fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c33206e36238b31b8d5e0926e01c0e8 3x", "genre": "art", "nsfw": true, "body": "リクエスト致します！\n\nけものフレンズ3より\nマルタタイガー、コヨーテをお願いします。\n\n二人共催眠に掛かってしまい、自らおっぱいと恥部を晒してオナニーをしてこちらに見せているシチュエーション。\n\n最初は催眠状態でノリノリでオナニーを始める\n↓\n途中で意識だけが戻る（以降もオナニーは継続）\n↓\n状況を把握してパニックになる\n↓\n犯人を私達だと理解し、こちらを睨む\n↓\n絶頂\n↓\n絶頂しながらもオナニーは止まらず泣き顔になる\n↓\n再度絶頂\n\nと言った流れでお願いします！\nポーズはお任せします。\n服は半脱ぎ。\nパンツは足に引っかかっている状態でお願いします。\n\n注文が多く申し訳ありません。\n承認いただける場合は宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/25", "thumbnail_src": "https://si.imgix.net/65ef73c1/uploads/origins/4be45873-53c6-4d59-8add-7f258627a73e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f4464dccb7a76fde6d51c26e3c1a2b", "thumbnail_srcset": "https://si.imgix.net/65ef73c1/uploads/origins/4be45873-53c6-4d59-8add-7f258627a73e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f4464dccb7a76fde6d51c26e3c1a2b, https://si.imgix.net/65ef73c1/uploads/origins/4be45873-53c6-4d59-8add-7f258627a73e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cb18e230dee7de9c55587f69b125a13 2x, https://si.imgix.net/65ef73c1/uploads/origins/4be45873-53c6-4d59-8add-7f258627a73e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d559c086e23661a7f6177b05f07c38ea 3x", "genre": "art", "nsfw": true, "body": "ジェンツーペンギンのパイズリイラストをお願いしたいです。\nジェーンは性知識が浅め。不慣れな様子で「こうですか…？」と恐る恐るパイズリをして亀頭を舌先で舐めたりちょっとだけ口に含んだりしている様子。\n射精にびっくりして「きゃっ！」と亀頭から口を離して顔面にモロに精液を被ってしまう。\n片方の目の上から鼻先にかけてたっぷり精液をかぶって片目を開けられない状態になり、のぼせたような不思議そうな表情で精液の感触と匂いにドキドキしているジェーンちゃんのイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/24", "thumbnail_src": "https://si.imgix.net/b28c4672/uploads/origins/aa61366c-450f-406c-be7b-62fa65a4d2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=112fa0e06a92acbef47def8c2768bb5d", "thumbnail_srcset": "https://si.imgix.net/b28c4672/uploads/origins/aa61366c-450f-406c-be7b-62fa65a4d2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=112fa0e06a92acbef47def8c2768bb5d, https://si.imgix.net/b28c4672/uploads/origins/aa61366c-450f-406c-be7b-62fa65a4d2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=782e373700f4d16fe11e87690787b1f0 2x, https://si.imgix.net/b28c4672/uploads/origins/aa61366c-450f-406c-be7b-62fa65a4d2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8394427bcf4ecfed71b7bf5e14bd5c07 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/23", "thumbnail_src": "https://si.imgix.net/40df602e/uploads/origins/76d9ae8b-ce8d-4b9f-a7ee-bf53b269f68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46fc8ed6c0254aba7128de5639ee5d27", "thumbnail_srcset": "https://si.imgix.net/40df602e/uploads/origins/76d9ae8b-ce8d-4b9f-a7ee-bf53b269f68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46fc8ed6c0254aba7128de5639ee5d27, https://si.imgix.net/40df602e/uploads/origins/76d9ae8b-ce8d-4b9f-a7ee-bf53b269f68a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=520c8436212a0ecea2f1b791cfd91253 2x, https://si.imgix.net/40df602e/uploads/origins/76d9ae8b-ce8d-4b9f-a7ee-bf53b269f68a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e55e6f2737249ac56f01a25e45c5431 3x", "genre": "art", "nsfw": true, "body": "Skebでは初めまして。\n密かなけもシコ勢として応援させて頂いております。\n\nもしよろしければ、ジャクソンカメレオン殿に「快楽に負けない修行」と称して夜這いされる…的なシチュをお願いいたします。\n体位は騎乗位。最初は強気で主導権を握ろうとしてくるも、挿入から突き上げられて攻守逆転し、結局自分も乱れながら同時イキしてしまうという流れ。\nそして最後は、\n「某まであのようにあられもない姿を曝してしまうとは……これは、互いにまだまだ修行が必要だな」\n「……何を呆けている？　さあ続けようではないか♡」\nと宣告（セリフについては変更・アレンジOK）をし、舌なめずりして〆。\n\n脱ぎ具合・射精量などについてはお好みで。\nご興味感じていただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/22", "thumbnail_src": "https://si.imgix.net/6d4af0be/uploads/origins/87c59053-9ae2-4a28-a130-fda42074a0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41b6941fb32a53ae451b5f1e02257880", "thumbnail_srcset": "https://si.imgix.net/6d4af0be/uploads/origins/87c59053-9ae2-4a28-a130-fda42074a0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41b6941fb32a53ae451b5f1e02257880, https://si.imgix.net/6d4af0be/uploads/origins/87c59053-9ae2-4a28-a130-fda42074a0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffc9ac2bad312acbea4c89cd01880467 2x, https://si.imgix.net/6d4af0be/uploads/origins/87c59053-9ae2-4a28-a130-fda42074a0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb17f516a3a5f8f812cf2aeb7ea67be2 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます\n「フェネック」のレズ緊縛絵をお願いしたく依頼させていただきました。以降は箇条書きにします\n\n・シチュは「お互いの同意の下でアライさんにガチガチに縛られて気持ち良くされてしまうフェネック。軽い後ろ手縛りだと思っていたら思いっきりSMプレイの縛りをされて、驚くのと同時に緊縛の刺激とアライさんに好き放題されてしまうという事実に興奮している」\n\n・ムチムチにえっちに菱縄縛りにされて、必要以上に縛られている。腕や脚は絶対に動かせない程に縛られて、腕は後ろに回され、両脚それぞれ別々に折り畳むように縛られている。クッションに跨がされて、軽い膝立ち状態にされている。股下には拳一つ以上が入る程の窪みがある。腕には閂というものもつけられて、より動けなくさせれられている\n\n・縄が股間にギッチリと通されて、とても気持ち良くなっている。さらにアライさんに乳首を服越しに爪でカリカリされている。\n途中で乳首カリカリが乳首くすぐりに変わって、可愛く笑いながら絶頂している。さらに後半になると、片手で激しく股間をくすぐり、空いた方の乳首をアライさんの尻尾でくすぐられて、連続絶頂させられている。お互いにずっと幸せそうにしている\n\n・乳首くすぐりが始まる直前にフェネックが「もっと縛って」と要求して、そこからどこかしらがギチギチに縛られて、もっと動けなくなってもっと気持ち良くなっている\n\n・服装は2人とも公式がコミケで公開した水着（もし分からなければ通常服でも構いません）\n\n・原作よりも巨乳\n\n・場所はベッドの上\n\n・表情は幸せそうに蕩けている。くすぐりのときはただひたすらに可愛く笑っている\n\n・アライさんはドS気味\n\n・フェネックとアライさんの2人の会話形式。セリフはお任せします\n\n口下手で伝わりづらい部分もあったかもしれませんが、とても見てみたいシチュだったので描いていただけるととても嬉しいです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/21", "thumbnail_src": "https://si.imgix.net/a72e33db/uploads/origins/02bc6b6c-5e6b-4059-8bda-9cc306563140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a3b338663289020eb99b51ec73fd267", "thumbnail_srcset": "https://si.imgix.net/a72e33db/uploads/origins/02bc6b6c-5e6b-4059-8bda-9cc306563140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a3b338663289020eb99b51ec73fd267, https://si.imgix.net/a72e33db/uploads/origins/02bc6b6c-5e6b-4059-8bda-9cc306563140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fb414f170c0f417b8056555fd16c30d 2x, https://si.imgix.net/a72e33db/uploads/origins/02bc6b6c-5e6b-4059-8bda-9cc306563140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1a05ab4042f7e6adde990b7a8e81769 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/20", "thumbnail_src": "https://si.imgix.net/acbde25b/uploads/origins/61cc0c89-4c56-433d-97e3-e9eec400818e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d371d64ce8298b660fbeef5e67b3423c", "thumbnail_srcset": "https://si.imgix.net/acbde25b/uploads/origins/61cc0c89-4c56-433d-97e3-e9eec400818e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d371d64ce8298b660fbeef5e67b3423c, https://si.imgix.net/acbde25b/uploads/origins/61cc0c89-4c56-433d-97e3-e9eec400818e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6421de76f960ebc526d16912a84862c8 2x, https://si.imgix.net/acbde25b/uploads/origins/61cc0c89-4c56-433d-97e3-e9eec400818e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=821737cae5defce6c6c72b6f928d1650 3x", "genre": "art", "nsfw": true, "body": "けものフレンズのフェネックをお願いします。\n\n密猟者に拉致られたアライグマを、単身で助けに来たフェネック。\n\nアライグマを解放するように、密猟者に言ったところ、条件付きで解放すると言われ、その条件をのむ。\n\nその条件は一日中ファッ〇ングマシーンを使って、一度も絶頂しなかったら解放。\n\n密猟者の指示に従い、四つん這いになり、密猟者の手で両手・両足を拘束＆ショーツを膝まで下ろされ、ファッキ〇グマシーンを設置＆挿入し稼働させる。\n\n稼働後、密猟者はアライグマを連れ、フェネックを放置して、どこかへ行ってしまう。\n\n人気の無い場所で一人にされ、四つん這いで身動きが取れないフェネックがファッキン〇マシーンに無慈悲に犯され続け、何度も絶頂し続けるフェネックをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hntk778/works/19", "thumbnail_src": "https://si.imgix.net/3c3aa455/uploads/origins/96876b15-02d2-4141-a1be-4210873eee5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb9862e846714f04c11afd78c6b0c9b0", "thumbnail_srcset": "https://si.imgix.net/3c3aa455/uploads/origins/96876b15-02d2-4141-a1be-4210873eee5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb9862e84