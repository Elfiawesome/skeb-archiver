leted_at": ""}, {"path": "/@Shameimarulike/works/9", "thumbnail_src": "https://si.imgix.net/b9cc9084/uploads/origins/9f118d77-a8b6-4abe-b8fc-4bb9470b6291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd8e442cc5e1c956148d1f416eee79e6", "thumbnail_srcset": "https://si.imgix.net/b9cc9084/uploads/origins/9f118d77-a8b6-4abe-b8fc-4bb9470b6291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd8e442cc5e1c956148d1f416eee79e6, https://si.imgix.net/b9cc9084/uploads/origins/9f118d77-a8b6-4abe-b8fc-4bb9470b6291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f135471c5cd05ddd7cd887806513c4d0 2x, https://si.imgix.net/b9cc9084/uploads/origins/9f118d77-a8b6-4abe-b8fc-4bb9470b6291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6ccdee090df8ec714df9825be7648ef 3x", "genre": "art", "nsfw": false, "body": "いつも可愛くてセクシーな布都ちゃんをありがとうございます。\nすっかり夏というコトで水着姿の布都ちゃんをみたいです！\n過去イラストよりも一回りおっきい特盛りふとぱいでお願いします！！\n\nhttps://twitter.com/Shameimarulike/status/1589950435301134338?s=20\n\nhttps://twitter.com/Shameimarulike/status/1600460938247012352?s=20\n\nhttps://twitter.com/Shameimarulike/status/1634189615082147840?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Shameimarulike/works/8", "thumbnail_src": "https://si.imgix.net/d690b84e/uploads/origins/c8f4454e-32ce-4b44-a388-259d1ec29ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d2956eceb19e89093433cefc6be8ec", "thumbnail_srcset": "https://si.imgix.net/d690b84e/uploads/origins/c8f4454e-32ce-4b44-a388-259d1ec29ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d2956eceb19e89093433cefc6be8ec, https://si.imgix.net/d690b84e/uploads/origins/c8f4454e-32ce-4b44-a388-259d1ec29ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06478f63efca93b5a9773b257603e047 2x, https://si.imgix.net/d690b84e/uploads/origins/c8f4454e-32ce-4b44-a388-259d1ec29ee7?bg=%2