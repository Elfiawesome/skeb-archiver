2ea51f36?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c1b6b1ecdbc54564e1566b44c605eeed, https://si.imgix.net/9d0873cf/uploads/outputs/ecbdc2ae-778a-4230-afb9-5d4e2ea51f36?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=abe4da6feb2f84605dbe04c5b4e6b152 2x, https://si.imgix.net/9d0873cf/uploads/outputs/ecbdc2ae-778a-4230-afb9-5d4e2ea51f36?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=586721af545da6fe3239726093e6105c 3x", "genre": "video", "nsfw": false, "body": "はるたまき先生、はじめまして☺️\n以前から、可愛いなぁと思ってXを拝見していて、いつか依頼させて頂きたいと思いながらフォローさせていただいておりました✨️\n\n【依頼内容】  依頼したい作品は、私の姉VTuberの、天癒ここな(あまいここな)のASMR 朗読配信で使用予定です。 YouTube、X、にも使用予定です！\n(中の人はこのアカウントの天癒みるくと同じで、姉妹設定として活動しております🙇‍♀️)\n\n   【構図】\n他の方のASMR用のムービーの構図のような、少し横に傾いてるような感じで、本を開いて持っている、朗読配信で使用出来る構図でお願い致します！本の背表紙は、キービジュアルが持っているデザインでお願いします✨️服装は立ち絵の衣装でお願いいたします。胸は大きめの設定なので巨乳に描いていただいて大丈夫なのですが、バーチャル心理カウンセラーとして癒しに特化した活動をしているため、性的な目的で視聴する方をなるべく受け入れたくない思いがあります。なので、がっつりとした谷間の描写は無いようにしていただけるとありがたいです。\n参考資料は、当方三面図がないため立ち絵とキービジュアルをご覧頂けますと幸いです。\n資料URLに添付したのが、公式ホームページです！トップになっている画像がキービジュアルです。立ち絵はお手数なのですが、私天癒みるくのXプロフィールに、天癒ここなのIDを記載しておりますので、固定ポストをご覧頂けますでしょうか…？@cocona_amainya です。\n優しい癒し系の表情で、お姉さんな感じの落ち着いた雰囲気だと嬉しいです。\n\n【納品ファイル】  16:9 サイズ。 背景あり・なし、両方頂けますと助かります。  静止画のイラストもあると嬉しいです。\n\n楽しみにしております☺️\nよろしくお願いいたします！\n\nhttps://cocona-amai.com/", "created_at": "", "completed_at": ""}, {"path": "/@haruta_makiko/works/286", "thumbnail_src": "https://si.imgix.net/585d7647/uploads/outputs/7270b60b-8da5-47a2-90f0-b54547a23ad9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=39bc234e91b0f5bc82bf2bc6a6e1e18f", "thumbnail_srcset": "https://si.imgix.net/585d7647/uploads/outputs/7270b60b-8da5-47a2-90f0-b54547a23ad9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=39bc234e91b0f5bc82bf2bc6a6e1e18f, https://si.imgix.net/585d7647/uploads/outputs/7270b60b-8da5-47a2-90f0-b54547a23ad9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e820effe4e81eef6050a0e9