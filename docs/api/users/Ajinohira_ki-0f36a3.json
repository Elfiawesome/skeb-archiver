=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=333b18aad4cffc3327f925799c509d2b 2x, https://si.imgix.net/616e55f2/uploads/origins/ac12554e-1f44-4858-9d3d-8ad9d2c1caad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b55dd11f9e5741b9526da379facdd0d 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/39", "thumbnail_src": "https://si.imgix.net/b2a3f87c/uploads/origins/b3926bae-9e72-4e3b-92eb-b51a583f9e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc86e87693558c7ded0d8d61b30ada38", "thumbnail_srcset": "https://si.imgix.net/b2a3f87c/uploads/origins/b3926bae-9e72-4e3b-92eb-b51a583f9e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc86e87693558c7ded0d8d61b30ada38, https://si.imgix.net/b2a3f87c/uploads/origins/b3926bae-9e72-4e3b-92eb-b51a583f9e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c6b7c0fa058761f958d903fbdf482f8 2x, https://si.imgix.net/b2a3f87c/uploads/origins/b3926bae-9e72-4e3b-92eb-b51a583f9e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=063e02e5d243ae2071094717c260706c 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\nプロセカより、日野森雫と桐谷遥でお願いいたします。\n\n催眠状態で露出の多い水着改造されたアイドル衣装を着せられファン達と乱交という内容でお願いします。\n\n「？」という困惑状態で乱交→絶頂→ハート目の快楽堕ちした様子でノリノリで乱交\n\n以上の内容でお願いします。構図などはおまかせします。検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/38", "thumbnail_src": "https://si.imgix.net/922c7f11/uploads/origins/77adac2a-d17e-4efb-bfca-5cba7e1dca59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b6c3b060d6d7cde11a3476a197f3951", "thumbnail_srcset": "https://si.imgix.net/922c7f11/uploads/origins/77adac2a-d17e-4efb-bfca-5cba7e1dca59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b6c3b060d6d7cde11a3476a197f3951, https://si.imgix.net/922c7f11/uploads/origins/77adac2a-d17e-4efb-bfca-5cba7e1dca59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a1787d8e1a2c3f0e919d334a025060f 2x, https://si.imgix.net/922c7f11/uploads/origins/77adac2a-d17e-4efb-bfca-5cba7e1dca59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3d46b3a1f244209fbf1879eb9de3938 3x", "genre": "art", "nsfw": true, "body": "リクエスト再送いたします。\n\nキャラ：夢限(WIXOSS) アイドルのすがた\nキャラ名間違えやすいのでご注意ください。\nhttps://www.takaratomy.co.jp/products/wixoss/card_list.php?card=card_detail&card_no=WXDi-P11-026\n\nhttps://skeb.jp/@Ajinohira_ki/works/37\nhttps://skeb.jp/@Ajinohira_ki/works/35\nが大好きなので、これらのようなイメージのイラストをお願いします。\n\n\n・ドスケベビッチな夢限が、ファンの知らないところで過激な裏ビデオに進んで出演している設定。無責任中出しで妊娠してしまったシーンも収録されている。これをベースにお好きに描いてください。\n・変態アイドル衣装、で思い浮かぶ衣装で描いてください。\n・耳、乳首、ヘソにピアス。ハートなどの装飾が付いているものでお願いします。\n・おっぱいと乳首と乳輪は盛ってください。妊娠後は少し垂れたり黒くなったりなど変化があると嬉しいです。\n・体型はhttps://skeb.jp/@Ajinohira_ki/works/35が好みです。\n・落書き、タトゥー(普段のアイドル活動で隠しやすそうな場所)、ビッチメイク、褐色化など全部好きなのでお好きなように色々入れてください。\n・キャラご存知ないと難しいかもしれませんが、台詞を書いていただきたいです。「ですます口調は無し」「基本的には言葉少なめ」を守っていただければ問題ないです。が、裏ビデオでは本性出して普段と全然違う喋り方してる……でもえっちなので、正直お好きに書いていただいて構いません。どちらにせよ下品な言葉は言わせてあげてください。\n\n妖艶エロエロイラスト、お待ちしております。ご検討よろしくお願いいたします。\n\n参考資料の記事が削除されていたようで、確認不足大変失礼いたしました。しかし、元々アニメでの台詞も多くないキャラではあるので、資料URLのカードに書いてあるフレーバーテキストで十分参考になるかと思います！\nどうしても見ておきたい場合は「Lostorage conflated WIXOSS」12話(最終話)をご覧ください。\n\nhttps://www.takaratomy.co.jp/products/wixoss/card/card_list.php?keyword=%E5%A4%A2%E9%99%90&color=%E7%84%A1&keyword_target=%E3%82%AB%E3%83%BC%E3%83%89%E5%90%8D,%E3%83%95%E3%83%AC%E3%83%BC%E3%83%90%E3%83%BC", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/37", "thumbnail_src": "https://si.imgix.net/381cac78/uploads/origins/b07b0aad-7714-4816-9a8d-b4ae50ca3890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=930f7d7fcf8ac8ecabebc2a572ba8fec", "thumbnail_srcset": "https://si.imgix.net/381cac78/uploads/origins/b07b0aad-7714-4816-9a8d-b4ae50ca3890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=930f7d7fcf8ac8ecabebc2a572ba8fec, https://si.imgix.net/381cac78/uploads/origins/b07b0aad-7714-4816-9a8d-b4ae50ca3890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2552ce1dc582486bfd8aff821d437d2c 2x, https://si.imgix.net/381cac78/uploads/origins/b07b0aad-7714-4816-9a8d-b4ae50ca3890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a30eb042a3774f7967029b9f3902f14 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエストをお願いします\n\nキャラ\n白石杏、小豆沢こはね(プロセカ)\n\nドスケベビッチな二人が「海でエロ水着で逆ナンorパパ活」もしくは「乱交パーティー会場で局部丸出し使用済みコンドーム腰蓑付きドスケベ衣装に極太バイブやアナルパール装備でゴム切れ生本番誘惑」して、危険日無責任種付けされて、ボテ腹妊婦になった後もパパ活などに精を出す一連の流れのセリフ付きイラストを以下のようにお願いします。\n\n以下、乳首強調でお願いします。\n①杏ちゃんとこはねのドスケベ水着or 局部丸出し使用済みコンドーム腰蓑付きドスケベ衣装に極太バイブやアナルパール装備での生本番お誘い2ショット\n\n②生本番乱交中or事後の全身ザーメン濡れ落書き塗れのハメ撮りアヘ顔ピースシーン\n受精描写付き\n\n③新規か①の差分で、ボテ腹妊婦母乳ドバドバの2ショット\n\n二人には衣装に関わらず、ゴッツイ乳首ピアスとをつけて下さい。乳首と乳輪は盛れるだけ盛ってください。\n\nセリフや表情、体型はドスケベビッチ全開の妖艶エロエロ仕様でお願いします。\n\n上記内容で何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/36", "thumbnail_src": "https://si.imgix.net/f534b0d0/uploads/origins/6f1371ce-407a-40db-bb41-2c2000a451fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8abccb1cddd34e0c3db1759fc02bc9ee", "thumbnail_srcset": "https://si.imgix.net/f534b0d0/uploads/origins/6f1371ce-407a-40db-bb41-2c2000a451fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8abccb1cddd34e0c3db1759fc02bc9ee, https://si.imgix.net/f534b0d0/uploads/origins/6f1371ce-407a-40db-bb41-2c2000a451fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d2c4612ebf74d028d7233dd1c29a336 2x, https://si.imgix.net/f534b0d0/uploads/origins/6f1371ce-407a-40db-bb41-2c2000a451fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fe5843e5786dd757d344eb3ff7e4498 3x", "genre": "art", "nsfw": true, "body": "【依頼概要】あじのひラキさんのオリキャラであるディーカさんを描いてほしいです。できれば肌面積が多い格好でほぼ全身が見えるコマがあると嬉しいです。\n【形式】不問。コミックっぽくしても大丈夫です！\n【詳細】おおよそお任せしてしまいますが、ディーカさんらしいドスケベさが際立っているようなシチュエーションが感じられるものだと嬉しいです。竿役が登場する場合はシルエットのみでも可で、体格が小さく見える相手だと特に喜びます。以下、シチュエーションの例を挙げますが自由に取捨選択していただいて構いません。\n相撲大会に薄布で出場するディーカさん／男湯でセクハラされながらも余裕なディーカさん／ゴブリン集団に纏わりつかれてるのに嬉しそうなディーカさん等々……\n【挨拶】いつもイラストなど楽しませていただいております！　ご検討宜しくお願い致します……！", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/35", "thumbnail_src": "https://si.imgix.net/1a8cf364/uploads/origins/196c1a20-0ff9-422a-83f6-94501156c0c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af27076b39bd4b70ee52d68e8f128ebd", "thumbnail_srcset": "https://si.imgix.net/1a8cf364/uploads/origins/196c1a20-0ff9-422a-83f6-94501156c0c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af27076b39bd4b70ee52d68e8f128ebd, https://si.imgix.net/1a8cf364/uploads/origins/196c1a20-0ff9-422a-83f6-94501156c0c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1358670b7c1f299069a3e1161cbece21 2x, https://si.imgix.net/1a8cf364/uploads/origins/196c1a20-0ff9-422a-83f6-94501156c0c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=607d0a606b90013e247046f65cc543aa 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラスト拝見させていただいております。\nもしよろしければリクエストの方をお受けいただけると幸いです。\n\nキャラクターはワールドフリッパーの見嶋ユキをお願いします。資料URLを添付します。\nシチュエーションとしては、支援サイトで昨年11月終わり頃に投稿なさっていた作品がかなり印象深いので、全般的にそれに近いイメージでお願いできればと思っています。\n輪姦や3Pなど複数人プレイでお願いします。相手に関してはお任せします。特に誰と想起させない感じでも問題ないです。\n衣装や装飾は、露出が多く派手な感じでいかにも軽薄そうなものがよいです。\n服装以外にメイクやタトゥー、身体に落書きなどからも適宜エッチになるよう要素を入れていただきたいです。\n\n特に指定していない要素に関してはお任せします。特別やめてほしいような要素もないので、思うようにエッチな感じにしていただければと存じます。\n曖昧なところやおまかせしている部分が多々あり申し訳ございません。お気が向きましたら引き受けていただけると大変嬉しいです。\nそれではよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Z7Ap1lyBWGZhaT7ADPmjsgdR0rhWGK-p?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/34", "thumbnail_src": "https://si.imgix.net/f9e5f930/uploads/origins/181870da-5322-4361-a9eb-e66f0123290b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4874cef6ee42a5999c551037002c85a", "thumbnail_srcset": "https://si.imgix.net/f9e5f930/uploads/origins/181870da-5322-4361-a9eb-e66f0123290b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4874cef6ee42a5999c551037002c85a, https://si.imgix.net/f9e5f930/uploads/origins/181870da-5322-4361-a9eb-e66f0123290b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da12d45b365a0a485ea6b89e698779d9 2x, https://si.imgix.net/f9e5f930/uploads/origins/181870da-5322-4361-a9eb-e66f0123290b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af776487dea691d34187d4884bc570e8 3x", "genre": "comic", "nsfw": true, "body": "リクエスト失礼します。\n以前Xのすけべ絵の垢の方であげられていたプロセカの志歩のイラストが非常にエロかったため、志歩を描いていただきたいです。\n\n内容\n1.志歩がピンク色の口紅を塗って、唇がぷるんとなり、「jkが口紅塗っただけで興奮してるとか、最低❤」と言う。\n\n2.志歩がちんぽに唇を押し付けるように強くキスをし、それだけでイかせる。ちんぽはパイパンで、ちんぽ以外は描かなくて大丈夫です。\n\n3.志歩がちんぽからちゅぱぁと唇を離し、糸が引いてる。ちんぽにはくっきりとキスマークがつき、「キスだけでイクなんて、本当に気持ち悪い❤」と嘲笑する。\n\n志歩は裸で、できれば唇のぷるぷるさを強調して頂きたいです。ページ数についてはお任せします。\n\n内容が細かめになってしまいましたが、ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/33", "thumbnail_src": "https://si.imgix.net/8c207147/uploads/origins/e35ca82e-33c3-4a33-ad70-5111652a7e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=042e1e1d0619c74c086ab250cb31843f", "thumbnail_srcset": "https://si.imgix.net/8c207147/uploads/origins/e35ca82e-33c3-4a33-ad70-5111652a7e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=042e1e1d0619c74c086ab250cb31843f, https://si.imgix.net/8c207147/uploads/origins/e35ca82e-33c3-4a33-ad70-5111652a7e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52e8057eb90245cb72e9f290021a8497 2x, https://si.imgix.net/8c207147/uploads/origins/e35ca82e-33c3-4a33-ad70-5111652a7e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bc79d9ddba13c16d03702023e4f6262 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！以前お願いしたスケブがとても楽しかったので、新しいスケブをお願いしたいと思いました！\n\n星野一花、花里美乃梨、小豆沢こはねの3人が、それぞれ違う水着を着て撮影するというものです。\n\n左のイチカは、濃い紫のスリングビキニを着て、緊張した面持ちでお尻を突き出している。\n右側のみのりは、胸を張って前傾姿勢になり、ウィンクをしながら、鮮やかなピンクのフリフリのビキニを着ている。\nそして真ん中のこはねは、深紅のワンピース水着で後ろを向いて前かがみになり、ドヤ顔で自信満々。\n\n今回のリクエストは以上です。今回もありがとうございました！\n\nhttps://media.discordapp.net/attachments/1111329231637577822/1335690813782364301/Expanding_Circle_of_Friendship.png?ex=67a8ff81&is=67a7ae01&hm=9053363999a563f727973a6cff4a6539923fac33a3c11d299392d26cb294528c&", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/32", "thumbnail_src": "https://si.imgix.net/17c1b900/uploads/origins/861a9b6b-b87b-427c-8119-02d7af8853f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c34affae73bc982e6e801a98c547dab", "thumbnail_srcset": "https://si.imgix.net/17c1b900/uploads/origins/861a9b6b-b87b-427c-8119-02d7af8853f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c34affae73bc982e6e801a98c547dab, https://si.imgix.net/17c1b900/uploads/origins/861a9b6b-b87b-427c-8119-02d7af8853f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6350d7a63a65b46e820f8c8e70935d1 2x, https://si.imgix.net/17c1b900/uploads/origins/861a9b6b-b87b-427c-8119-02d7af8853f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0d87859732ebd30546a44559f931bfc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/31", "thumbnail_src": "https://si.imgix.net/efaa15a6/uploads/origins/48a3fc32-4630-4084-b644-239841817790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06ddabb7bd8c3dd548306e419e3ce5c", "thumbnail_srcset": "https://si.imgix.net/efaa15a6/uploads/origins/48a3fc32-4630-4084-b644-239841817790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06ddabb7bd8c3dd548306e419e3ce5c, https://si.imgix.net/efaa15a6/uploads/origins/48a3fc32-4630-4084-b644-239841817790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb387f0b595bac74e977a746b17a86b7 2x, https://si.imgix.net/efaa15a6/uploads/origins/48a3fc32-4630-4084-b644-239841817790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0f27b3b5d7b314a86e13e8c815259ca 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼します。\n↓依頼内容\n自分がbeatmaniaIIDXという音楽ゲームで使っているアバターキャラ3人(さなえ、アカネ、ラピス)がスク水姿でレズえっちをしているイラストをお願いします。\n白スク水差分とスク水半脱ぎ差分と全裸差分もお願いします。\n表情、ポーズ等その他諸々はおまかせでお願いします。\n\n資料(さなえ)\nhttps://www.dropbox.com/scl/fi/2f6fb6ljw454g7ncykthh/.png?rlkey=00znbdcvjzct13wot6m83kqu2&dl=0\n\n資料(アカネ)\nhttps://www.dropbox.com/scl/fi/4yrc8flg4mfn6wywd0n6b/.png?rlkey=oe3zbs5n7fam640lb8g16z2v8&dl=0\n\n資料(ラピス)\nhttps://www.dropbox.com/scl/fi/6wxgl0iurozu2g5h97w1m/.png?rlkey=tcvwmh1u78q8cln8k41pzf48f&st=bi809miv&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Ajinohira_ki/works/30", "thumbnail_src": "https://si.imgix.net/258741da/uploads/origins/9bdf9950-7775-48ac-90d5-32bfcd3e2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d35d334c9bd0819b90d938329a411b61", "thumbnail_srcset": "https://si.imgix.net/258741da/uploads/origins/9bdf9950-7775-48ac-90d5-32bfcd3e2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=