f&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09d9acfdcfcbef240af20838b2435948 2x, https://si.imgix.net/9a6d3395/uploads/origins/b4b41105-f773-4e41-9fed-450f371d675b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1141fc75545d03345b5f6e2745fc3444 3x", "genre": "art", "nsfw": false, "body": "他の方に依頼したイラストをご覧いただいてのアピールありがとうございます！\n描いて頂けるとのことで依頼させていただきたいと思います！\n\n以下は他の方に依頼した時の文をそのまま持ってきております。よろしくお願いします。\n\n\nオリジナルのキャラのイラストをお願いします。\n白(銀？)のショートカットに橙色の瞳の、丸型サングラスとジェンダーレスな服を着た170cm後半くらいの身長の中性的な顔立ちのどこか怪しげというか胡散臭げな女性。\n目は狐をイメージしてつり目と目尻に紅が入っている。体系としてはスラッとしているが胸が平均より大きめ(すみません性癖です)\n設定としては武器等を密かに売る化け物退治もできる妖狐の血を引く商人で、いつもニコニコ胡散臭い笑みを浮かべている。狐の手の形でおちょくったりする。", "created_at": "", "completed_at": ""}, {"path": "/@nihonnosaida097/works/22", "thumbnail_src": "https://si.imgix.net/66d53c8c/uploads/origins/5711c19d-ee8c-456c-8658-d5965cc119fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aced8470eca3077c63ad5845880400b3", "thumbnail_srcset": "https://si.imgix.net/66d53c8c/uploads/origins/5711c19d-ee8c-456c-8658-d5965cc119fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aced8470eca3077c63ad5845880400b3, https://si.imgix.net/66d53c8c/uploads/origins/5711c19d-ee8c-456c-8658-d5965cc119fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b2f3f5e059565e88d7fb5f1d827de5 2x, https://si.imgix.net/66d53c8c/uploads/origins/5711c19d-ee8c-456c-8658-d5965cc119fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f49606befec54f8c1d324529d43ea7d7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n赤い逆十字の髪飾りキャラへのアピールありがとうございます！\nぜひご自由に描いて頂きたいです！ \n構図などお任せします\n\nhttps://drive.google.com/drive/folders/1FdaENoWd5y0p9IoaNXaRX7xWMb3zjovt", "created_at": "", "completed_at": ""}, {"path": "/@nihonnosaida097/works/21", "thumbnail_src": "https://si.imgix.net/77d91251/uploads/origins/49b1ed61-c5b8-4b8f-89eb-98a349fec2f6?bg=%23fff&auto=format%2Ccompre