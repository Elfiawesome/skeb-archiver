007e701, https://si.imgix.net/44a10006/uploads/origins/e8900fd7-c35b-4cc9-83d6-b1ababd6370b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2a13a857d0c6b665a7eb94317507dd0 2x, https://si.imgix.net/44a10006/uploads/origins/e8900fd7-c35b-4cc9-83d6-b1ababd6370b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09018286d9656da399b7d9e93e29da2a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@garp_cts/works/50", "thumbnail_src": "https://si.imgix.net/239e19af/uploads/origins/8fd0e61e-bdad-4e3a-8191-0369a6834639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97229d1abd0697123bbd47160731508", "thumbnail_srcset": "https://si.imgix.net/239e19af/uploads/origins/8fd0e61e-bdad-4e3a-8191-0369a6834639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97229d1abd0697123bbd47160731508, https://si.imgix.net/239e19af/uploads/origins/8fd0e61e-bdad-4e3a-8191-0369a6834639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4390910d03eb28dcab2ff8822f4898fb 2x, https://si.imgix.net/239e19af/uploads/origins/8fd0e61e-bdad-4e3a-8191-0369a6834639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ff71acf44fdc9774f589bf1cc1e19e9 3x", "genre": "art", "nsfw": false, "body": "また会ったね、\n\nもう一人、友だちと一緒にアートを作りたかったんだ。ポーズと私たちの写真を添付して、ザルには違う服を着せてみたの。コーヒーを飲みながら、一緒にいる時間を楽しんでいるように見えるようにしたいんだ！\n\nhttps://drive.google.com/drive/folders/10ja6A_Q1pmT_KBUUAwMWeLimz2HG_J_m?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@garp_cts/works/49", "thumbnail_src": "https://si.imgix.net/d832b25a/uploads/origins/6f8b1369-2736-4ee4-b231-454b8529bcb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20