-baa7-40e5d4f2e8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9484544221e6dc508e2a86922ea09cc6 2x, https://si.imgix.net/e9a3d7e7/uploads/origins/28422a9e-643c-4932-baa7-40e5d4f2e8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eeec5cd98a79ccb5d9d48c2cf3f3225 3x", "genre": "art", "nsfw": false, "body": "はじめまして、カバシと申します。\n\n今回、個人Vtuberの「猫山みあ」さんのイラストをリクエストさせていただきました。\n\n■構図など\n先生の作品の正月ムツキのように、悪戯っぽい笑顔のイラストを希望いたします。\n\n用途により髪の毛の先や耳、指の先等が切れていない構図だと助かりますが、お任せいたします。\n服装は、オリジナルの私服を着せていただいてもかまいません。\n\n■使用用途\n活動用イラストとしてプレゼント(TwitterやYouTubeサムネイルなどで使用)\n\n背景や文字が透過されたpsd形式ですと、大変助かります。\n\nご検討のほどを宜しくお願い申し上げます。\n\nhttps://twitter.com/nekoyama_miaaa/status/1583022651102334976", "created_at": "", "completed_at": ""}, {"path": "/@Irelia_is_god/works/17", "thumbnail_src": "https://si.imgix.net/6b7733e6/uploads/origins/bb921f28-56f7-41e7-9f8e-17ac4749aca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24a403e8cadb2cbc9f48b72173397215", "thumbnail_srcset": "https://si.imgix.net/6b7733e6/uploads/origins/bb921f28-56f7-41e7-9f8e-17ac4749aca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24a403e8cadb2cbc9f48b72173397215, https://si.imgix.net/6b7733e6/uploads/origins/bb921f28-56f7-41e7-9f8e-17ac4749aca6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e268379abde930f33dda04a9eec3f70 2x, https://si.imgix.net/6b7733e6/uploads/origins/bb921f28-56f7-41e7-9f8e-17ac4749aca6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edc5e7c26188b6f11dc12df5edd0ca50 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nうちの子を描いて頂けたら嬉しいです。\n\n◆使用用途\ntwitter等SNSでの画像使用\n\n◆キャラ参考資料\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n\n◆構図\n具体的な構図はお任せしますので、自由に描いてください！\nこちらの絵柄がとても好みです。印象的なポージング希望です。\nhttps://twitter.com/Irelia_is_god/status/1643125865033891841?s=20\n\n◆服装\n制服でも、アレンジ頂いてもOKです！\n\n◆納品形式\nPSDとPNG希望です。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Irelia_is_god/works/16", "thumbnail_src": "https://si.imgix.net/5c969dc9/uploads/origins/fedb006d-5c47-44b4-8ee0-a722448c315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eb71e431cb07be94cd705d1ef280b70", "thumbnail_srcset": "https://si.imgix.net/5c969dc9/uploads/origins/fedb006d-5c47-44b4-8ee0-a722448c315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eb71e431cb07be94cd705d1ef280b70, https://si.imgix.net/5c969dc9/uploads/origins/fedb006d-5c47-44b4-8ee0-a722448c315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3349244ed4d245e96d019333aa05e6df 2x, https://si.imgix.net/5c969dc9/uploads/origins/fedb006d-5c47-44b4-8ee0-a722448c315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e75c285ab09e3d2f9cc8ea4892b4cf8 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストを拝見させていただいています。\n今回はばず先生の描いたブルーアーカイブのフウカ(正月)を\n個人観賞用、SNSアイコン(ディスコード等)に使用したいと思い、\nリクエストを送らせていただきました。\n\n構図やポーズはお任せいたします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Irelia_is_god/works/15", "thumbnail_src": "https://si.imgix.net/8f569618/uploads/origins/47af5164-68f2-49c8-8a92-206d8d5c93a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff24e19c570d4a50644aeac552ae37f9", "thumbnail_srcset": "https://si.imgix.net/8f569618/uploads/origins/47af5164-68f2-49c8-8a92-206d8d5c93a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff24e19c570d4a50644aeac552ae37f9, https://si.imgix.net/8f569618/uploads/origins/47af5164-68f2-49c8-8a92-206d8d5c93a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13c4c10c737b396decc59948a325470d 2x, https://si.imgix.net/8f569618/uploads/origins/47af5164-68f2-49c8-8a92-206d8d5c93a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b3def83b919223172e5c2596ad7fe79 3x", "genre": "art", "nsfw": true, "body": "こんにちは、前回の依頼が期限切れになってしまったようなので、再度送ります。内容や依頼は前回と同じなので、私のキャラクターを好きなように描いてください！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1M7BTZdI47OL6CmpYWkeK5WSN5CR9m2Xt", "created_at": "", "completed_at": ""}, {"path": "/@Irelia_is_god/works/14", "thumbnail_src": "https://si.imgix.net/629afe9c/uploads/origins/2d05b375-980a-483f-8f28-1d75ab5ec09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd7a6909d8ca77a2f860d3c585870d6e", "thumbnail_srcset": "https://si.imgix.net/629afe9c/uploads/origins/2d05b375-980a-483f-8f28-1d75ab5ec09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd7a6909d8ca77a2f860d3c585870d6e, https://si.imgix.net/629afe9c/uploads/origins/2d05b375-980a-483f-8f28-1d75ab5ec09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fe456cab6cf93f05c0d67357e076057 2x, https://si.imgix.net/629afe9c/uploads/origins/2d05b375-980a-483f-8f28-1d75ab5ec09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99d640dff958a28eab4c4f9677301e08 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Irelia_is_god/works/13", "thumbnail_src": "https://si.imgix.net/c5bce6bf/uploads/origins/9605d707-284c-4a37-a260-d7ed3b5962f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec859dec278644cda1dfc356754738d3", "thumbnail_srcset": "https://si.imgix.net/c5bce6bf/uploads/origins/9605d707-284c-4a37-a260-d7ed3b5962f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec859dec278644cda1dfc356754738d3, https://si.imgix.net/c5bce6bf/uploads/origins/9605d707-284c-4a37-a260-d7ed3b5962f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2439f4ce1cc304f2f703898767015c48 2x, https://si.imgix.net/c5bce6bf/uploads/origins/9605d707-284c-4a37-a260-d7ed3b5962f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=437136ac1b0689046e3ace012160d356 3x", "genre": "art", "nsfw": false, "body": "初めまして、先生のイラストが好きです。\n\n今回依頼したいのはうちの子の菜音ちゃんで、設定はとある大企業のお金持ちなお嬢様です。\n\nこの子が100万円の札束でジェンガをして遊んでるイラストを描いて欲しいです。\n高さはお任せしますがキャンバス内に収まる程度の高さで大丈夫です。\nジェンガの近くに半開きの通帳でも置いておいていただけると嬉しいです。\n\nキャラクターの容姿や服装の資料は参考ツイートをご覧ください。\n\n楽しそうに札束ジェンガで遊んでいれば細かいポーズや構図はお任せします！\n完成サイズは壁紙にしたいので「横2,732 x 縦2,048ピクセル」でお願いします！\n\nhttps://twitter.com/shiro_jima09/status/1592480963011170305?s=61&t=pfaXzaPo1YMboUp8i-b0Iw", "created_at": "", "completed_at": ""}, {"path": "/@Irelia_is_god/works/12", "thumbnail_src": "https://si.imgix.net/155a9568/uploads/origins/5cfc0848-4905-41aa-9200-fe21580a67f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03d59e3e6b5d6902dd7181d8150ecd00", "thumbnail_srcset": "https://si.imgix.net/155a9568/uploads/origins/5cfc0848-4905-41aa-9200-fe21580a67f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03d59e3e6b5d6902dd7181d8150ecd00, https://si.imgix.net/155a9568/uploads/origins/5cfc0848-4905-41aa-9200-fe21580a67f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fd157f590746d1112a3ab72e0cc425f 2x, https://si.imgix.net/155a9568/uploads/origins/5cfc0848-4905-41aa-9200-fe21580a67f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2192044b4fc562b1bf43f5dcdaba7eca 3x", "genre": "art", "nsfw": false, "body": "はじめまして！ツイッターで見かけた ばずさん のレイサが可愛くてぜひお願いしたいなと思いました。\n\nもしよければVtuber「杏夜くもり」さんのファンアートを描いて頂きたいです。\n\n歌枠をよくやっているので、歌ってるシチュエーションだと嬉しいです。\n\nポーズとか構図とかはお任せいたします！\nどうぞよろしくお願いします。\n\nhttps://twitter.com