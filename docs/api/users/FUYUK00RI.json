.net/ebaf702b/uploads/origins/bb5f8882-2c4a-4671-81a1-a70df902b34f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fc0050c75a8f54132a8787affd4fea, https://si.imgix.net/ebaf702b/uploads/origins/bb5f8882-2c4a-4671-81a1-a70df902b34f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9da5cf612c54e79f72cdba3520b87781 2x, https://si.imgix.net/ebaf702b/uploads/origins/bb5f8882-2c4a-4671-81a1-a70df902b34f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01b1b858b114d9b27104906540f49eb6 3x", "genre": "art", "nsfw": false, "body": "Hello! I'd like to request you to draw my OC, her name is Streya: https://imgur.com/a/streya-reference-images-xvxufZ6\n\nShe is a very mysterious, mischievous, and silly character. So any silly or fun pose would be good.\nHer eyes must be white/blank on the mask.\nThank you!", "created_at": "", "completed_at": ""}, {"path": "/@FUYUK00RI/works/21", "thumbnail_src": "https://si.imgix.net/18b9b74f/uploads/origins/0f6c5900-d389-4817-8314-5ac11144ca9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4eb6aeff6f7e458e30fffa1e34d8c5c", "thumbnail_srcset": "https://si.imgix.net/18b9b74f/uploads/origins/0f6c5900-d389-4817-8314-5ac11144ca9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4eb6aeff6f7e458e30fffa1e34d8c5c, https://si.imgix.net/18b9b74f/uploads/origins/0f6c5900-d389-4817-8314-5ac11144ca9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62d133647db8cf0d0840c20cb8e1e924 2x, https://si.imgix.net/18b9b74f/uploads/origins/0f6c5900-d389-4817-8314-5ac11144ca9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&