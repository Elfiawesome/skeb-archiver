mpleted_at": ""}, {"path": "/@Patrasche_1599/works/8", "thumbnail_src": "https://si.imgix.net/2703f1c0/uploads/origins/3692ba64-040b-4da2-8e51-4a9ed01a77ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0a96abb637173023030ffb1a4dde81b", "thumbnail_srcset": "https://si.imgix.net/2703f1c0/uploads/origins/3692ba64-040b-4da2-8e51-4a9ed01a77ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0a96abb637173023030ffb1a4dde81b, https://si.imgix.net/2703f1c0/uploads/origins/3692ba64-040b-4da2-8e51-4a9ed01a77ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06910acc369b1262695761f9214f8286 2x, https://si.imgix.net/2703f1c0/uploads/origins/3692ba64-040b-4da2-8e51-4a9ed01a77ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa53ee563f7c739d7ecdd83685d00fc9 3x", "genre": "art", "nsfw": false, "body": "skebを閉じられるとのことで滑り込みで失礼します！\nTwitterのアイコンでカウンターサイドの覚醒アキヤマ・シリュウというキャラをデフォルメで描いていただきたいです！ 糸目の方で！\n参考資料が動画しかないのですが、よろしくお願いします🥺🙏\n【カウンターサイド】 『アキヤマ・シリュウ：阿羅漢』 https://youtube.com/shorts/w70NeTu9wDI?feature=share\n\nhttps://youtu.be/Z_yTJmCfNYg", "created_at": "", "completed_at": ""}, {"path": "/@Patrasche_1599/works/7", "thumbnail_src": "https://si.imgix.net/b777de8f/uploads/origins/2458d99d-5e63-4b4a-b1b6-48c28ba98e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16cff0e97b8289f38ff225cfc0fa8fe8", "thumbnail_srcset": "https://si.imgix.net/b777de8f/uploads/origins/2458d99d-5e63-4b4a-b1b6-48c28ba98e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16cff0e97b8289f38ff225cfc0fa8fe8, https://si.imgix.net/b777de8f/uploads/origins/2458d99d-5e63-4b4a-b1b6-48c28ba98e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fdc5e3eaa35d87c347017f0a92a582a 2x, https://si.imgix.net/b777de8f/uploads/origins/2458d99d-5e63-4b4a-b1b6-48c28ba98e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=20