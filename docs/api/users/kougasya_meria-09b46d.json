a-bffd-d6e23e82ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=996205b224a82dfbba22ce84533b423a 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\nアイドルマスターシンデレラガールズの棟方愛海が、浴衣姿で線香花火をしながら微笑んでいるイラストをお願いします。検討して頂けたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kougasya_meria/works/17", "thumbnail_src": "https://si.imgix.net/a8a91985/uploads/origins/db566e83-0f27-477e-8045-09139367866b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f86e4630a38669efe4d6a0885eeb3d32", "thumbnail_srcset": "https://si.imgix.net/a8a91985/uploads/origins/db566e83-0f27-477e-8045-09139367866b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f86e4630a38669efe4d6a0885eeb3d32, https://si.imgix.net/a8a91985/uploads/origins/db566e83-0f27-477e-8045-09139367866b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c5f4fc27b5f26f4de8b66060509edd5 2x, https://si.imgix.net/a8a91985/uploads/origins/db566e83-0f27-477e-8045-09139367866b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32b77a16fad4b856ebd471f9a61166c7 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nVtuber酒恋原ヘリコ（本人）です。\n\n新衣装バージョンの酒恋原ヘリコ\n背景透過のイラストを描いていただきたいです。\nポーズ、構図、表情等はお任せいたします。\n\nサイズは1080px×1080px以上でお願いいたします。\n正方形、縦長、横長いずれでも問題ありません。\n\nサムネイルで多用したく、衣装とサイズのみ指定させていただきました。\n何卒よろしくお願い申し上げます。\n\nhttps://twitter.com/helico193/status/1649581537766297601?s=20", "created_at": "", "completed_at": ""}, {"path": "/@kougasya_meria/works/16", "thumbnail_src": "https://si.imgix.net/2c3dc616/uploads/origins/320eb11c-eaa2-405e-9a0f-2792f5acab33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff08ffde59c5edc21350f26e81d9e8b8", "thumbnail_srcset": "https://si.imgix.net/2c3dc616/uploads/origins/320eb11c-eaa2-405e-9a0f-2792f5acab33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff08ffde59c5edc21350f26e81d9e8b8, https://si.imgix.net/2c3d