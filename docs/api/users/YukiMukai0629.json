b15-bd0f-964ba924f142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd0d6af5c1a340618da37cc88f8f635a 2x, https://si.imgix.net/60d4c182/uploads/origins/af9b5981-4d1d-4b15-bd0f-964ba924f142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ca00faa6b6e5900d355d17529bff8d9 3x", "genre": "art", "nsfw": false, "body": "こんにちは。はじめまして。\n\nあなたのスケッチ的なカートゥースタイルがとても好きです！不気味でありながら、とてもクールな印象です！\n\nリクエストで申し訳ないのですが、「フォスターズ・ホーム・フォー・イマジナリーフレンズ」の「ダッチス」を頂いてもよろしいでしょうか？\n\n性格はプライドが高くて正直で計算高くて見栄っ張り。悪役のオバさんタイプ。それを反映したポーズが欲しいです。\n\nスタイリングは自由です。不気味でありながらエレガントな雰囲気を出してほしい。\n\nご検討のほど、よろしくお願いいたします！\n\nあとはお任せします！\n\nhttps://cdn.discordapp.com/attachments/1042576022689816589/1093688849949012030/040DF27C-FAA0-4239-AE69-B878A65B82DE.png", "created_at": "", "completed_at": ""}, {"path": "/@YukiMukai0629/works/4", "thumbnail_src": "https://si.imgix.net/73ff958a/uploads/origins/1651f387-c94e-43f2-8a0e-8e3a3bc71ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e431664159157d0b41c8e48412ba16", "thumbnail_srcset": "https://si.imgix.net/73ff958a/uploads/origins/1651f387-c94e-43f2-8a0e-8e3a3bc71ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e431664159157d0b41c8e48412ba16, https://si.imgix.net/73ff958a/uploads/origins/1651f387-c94e-43f2-8a0e-8e3a3bc71ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e95ef8400968d0c28ac2ea5e05fe889e 2x, https://si.imgix.net/73ff958a/uploads/origins/1651f387-c94e-43f2-8a0e-8e3a3bc71ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b640fa2328c47a5eaeb3348c2c81c18 3x", "genre": "art", "nsfw": false, "body": "YUKI先生の心霊写真シリーズのおばけちゃんと遭遇し、全力で逃げ出しているガラちゃんをお願いしても良いでしょうか \nスマホ壁紙サイズだと助かります \n\nザラキーマカレー", "created_at": "", "completed_at": ""}, {"path": "/@YukiMukai0629/works/3", "thumbnail_src": "https://si.imgix.net/85d412ed/uploads/origins/f5d6e0c7-a47f-43bf-928e-ee78ab8268a7?bg=%23fff&auto=format%2