px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=469146d97345487fdaa0cb7a6fce1493 2x, https://si.imgix.net/33766af7/uploads/origins/b7f95d91-daf6-4061-8eac-476626b531d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=463dfef1d381f25c84f40fe8f4bded9d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/17", "thumbnail_src": "https://si.imgix.net/555cc3e8/uploads/origins/3c5f42df-26c6-49a0-a3bd-83ce49fc3f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=279ec6b74af9a3ca22469a3fae26732a", "thumbnail_srcset": "https://si.imgix.net/555cc3e8/uploads/origins/3c5f42df-26c6-49a0-a3bd-83ce49fc3f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=279ec6b74af9a3ca22469a3fae26732a, https://si.imgix.net/555cc3e8/uploads/origins/3c5f42df-26c6-49a0-a3bd-83ce49fc3f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dae4180eda02188319d2c6ee9244462a 2x, https://si.imgix.net/555cc3e8/uploads/origins/3c5f42df-26c6-49a0-a3bd-83ce49fc3f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c4f8978009a7f05b653ee295b48c418 3x", "genre": "art", "nsfw": false, "body": "風さん、はじめまして！\n\nもしよろしければ、私のオリジナルキャラクターのエマちゃんを描いて頂きたいです。\n下のURLでは三面図と設定シートのツイートスレッドです！\n\nエマちゃんはとても健全な子なので健全のリクエストだけど、他の詳細など全部お任せします！\n\nありがとうございます！\n\nhttps://twitter.com/kazakuri/status/1397562595662512130", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/16", "thumbnail_src": "https://si.imgix.net/894e880e/uploads/origins/d17df8ff-60fa-42c7-8ab6-795501ae1329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97511451bbbf059178f30c3fad81455d", "thumbnail_srcset": "https://si.imgix.net/894e880e/uploads/origins/d17df8ff-60fa-42c7-8ab6-795501ae1329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97511451bbbf059178f30c3fad81455d, https://si.imgix.net/894e880e/uploads/origins/d17df8ff-60fa-42c7-8ab6-795501ae1329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=988b65afcf25e37bf63f2cbbaf9dd84e 2x, https://si.imgix.net/894e880e/uploads/origins/d17df8ff-60fa-42c7-8ab6-795501ae1329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=358256a88b592a05273c2500eedf9ec7 3x", "genre": "art", "nsfw": true, "body": "こんにちは、アピール通りリクエストを再送します。もし冬子をもう一度描きたいというのであれば、私はそれでいいと思います！\n\nまた描いてもらえたら嬉しいので、ポーズなどはお任せします。好きなポーズ、好きなシチュエーションで描いてください！NSWFを使えるようにしたので、自由に描いてください。\n\n唯一お願いしたいのは、プロポーションは今まで通りで、それ以外は何でも構いません！\n\nお任せします。ご配慮ありがとうございました！\n\nhttps://drive.google.com/file/d/1qaLtQSb96ySjP4RRwG9CDuEdJ-ZjHfmM/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/15", "thumbnail_src": "https://si.imgix.net/ff4c2640/uploads/origins/652912d9-1893-4042-802f-966b622bd508?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1f5c431b3918115f6f94fa58bef5968", "thumbnail_srcset": "https://si.imgix.net/ff4c2640/uploads/origins/652912d9-1893-4042-802f-966b622bd508?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1f5c431b3918115f6f94fa58bef5968, https://si.imgix.net/ff4c2640/uploads/origins/652912d9-1893-4042-802f-966b622bd508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3d5912450ca18ddf6e0b7e4e55eecfb 2x, https://si.imgix.net/ff4c2640/uploads/origins/652912d9-1893-4042-802f-966b622bd508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afdd5cba06741c8a41fb61a2e5e52c87 3x", "genre": "art", "nsfw": true, "body": "私のオリジナルキャラクターをお願いしたくリクエストさせていただきたいです。\nイラストレーター様にキャラデザをお願いして、コミッション等で使う許可はいただいております。\n\nhttps://img1.mitemin.net/d0/pp/hhv1j7e4k5ygl24e13s2667b2wt_1641_tk_128_nd3m.png\n\nhttps://img1.mitemin.net/90/mk/adkzgad6saghw45f0ypkg9hl1e9_17a_11e_ke_5xsh.jpg\n\nhttps://img1.mitemin.net/az/47/j5lgkbef42xfe265f02gao5hblrl_1c7p_112_1jk_1dg7v.png\n\n構図はお任せでメスガキ感がある雰囲気でお願いしたいです。\nできれば表情はこちらの右のような感じにしてください。\nhttps://img1.mitemin.net/1x/w5/jgnr7m92a6d3frjg5vj85dvic6w_pq7_jb_85_5u54.png", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/14", "thumbnail_src": "https://si.imgix.net/d659fe7b/uploads/origins/23d28eb6-fa74-48ee-8443-f28c8c921c41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0aa5a34c83d740412ff4e78a0e73c22", "thumbnail_srcset": "https://si.imgix.net/d659fe7b/uploads/origins/23d28eb6-fa74-48ee-8443-f28c8c921c41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0aa5a34c83d740412ff4e78a0e73c22, https://si.imgix.net/d659fe7b/uploads/origins/23d28eb6-fa74-48ee-8443-f28c8c921c41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2c37f1d697ed1354222eadaf7788fdc 2x, https://si.imgix.net/d659fe7b/uploads/origins/23d28eb6-fa74-48ee-8443-f28c8c921c41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78c37623945e106ddc39f99abe6584f3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/13", "thumbnail_src": "https://si.imgix.net/581beeb7/uploads/origins/e2acd71e-1c92-45b6-b110-1ad3123891f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85efd848c1e0e3be734ddd3a9cfc95c8", "thumbnail_srcset": "https://si.imgix.net/581beeb7/uploads/origins/e2acd71e-1c92-45b6-b110-1ad3123891f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85efd848c1e0e3be734ddd3a9cfc95c8, https://si.imgix.net/581beeb7/uploads/origins/e2acd71e-1c92-45b6-b110-1ad3123891f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52dd5e8fb7c35214bff275ebeab70cc7 2x, https://si.imgix.net/581beeb7/uploads/origins/e2acd71e-1c92-45b6-b110-1ad3123891f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=103b2598749bf29f2809d6d2dfcb79fc 3x", "genre": "art", "nsfw": true, "body": "こんにちは！前回は私のキャラで素敵な作品を作っていただきありがとうございました\nhttps://skeb.jp/@konekonoyomeiri/works/7\n\nまた同じキャラの絵をお願いしたいので、ご検討いただけると幸いです！よろしくお願いします。\n\nこんな位置と角度で、こんな風に振り返って、でもできれば全身が見えるような感じでお願いしたいです。布団に寝ている姿とかでもいいかもしれません。\nhttps://cdn.discordapp.com/attachments/1029096643179585566/1034170364474957954/unknown.png\n\nできれば2～3種類のバージョンをお願いしたいです。\n1.服を着ているが、パンティーが見えているもの\n2.下着だけ\n3.フルヌードただし、金額でカバーできない場合は、着衣と下着で十分です。\n\n表情は頬を赤らめてニヤニヤしていてもいいし、資料のような、でも牙は見せているようなものもいい。でも、表情は自由でいいんですよ。\n\n以上、細かいところですが、よろしくお願いします。もし、違うポーズで描きたいのであれば、それはそれで結構です。最初に描いていただいた作品が今でもお気に入りなので、また描いていただけるだけでも嬉しいです。\n\nリクエストにお答えいただきありがとうございました。\n\nhttps://drive.google.com/file/d/1qaLtQSb96ySjP4RRwG9CDuEdJ-ZjHfmM/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/12", "thumbnail_src": "https://si.imgix.net/b3faf5ce/uploads/origins/92eb0a2b-8854-4894-bc79-bf5d86874c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0021c9b030772c27a2cfce68ffcb8754", "thumbnail_srcset": "https://si.imgix.net/b3faf5ce/uploads/origins/92eb0a2b-8854-4894-bc79-bf5d86874c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0021c9b030772c27a2cfce68ffcb8754, https://si.imgix.net/b3faf5ce/uploads/origins/92eb0a2b-8854-4894-bc79-bf5d86874c43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca8bdef22e8e582dd4539abc84751dce 2x, https://si.imgix.net/b3faf5ce/uploads/origins/92eb0a2b-8854-4894-bc79-bf5d86874c43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d153ad090ed46132207995abf44cdc36 3x", "genre": "art", "nsfw": true, "body": "もしよろしければ、下記URL衣装のデレマスの杏ちゃんで、サボって寝てしまって、\n寝相が悪く大股開きでパンツ丸出しの大胆な体勢になってしまい、そこをみられたPに、\n睡眠姦をされてしまうシチュをお願いしたいです！\n\n先生の描く、股間を前面に出した構図が素晴らしかったので、そのような構図と大股開きの体勢で、\nパンツは黒の子供っぽいもので、行為中も取らずにずらし挿入で。\n差分として、挿入されている時と、イってしまった差分を、お願いしたいです！\n\n挿入されている時は、杏ちゃんの反応など、全て先生にお任せします！\n意識が朧げのままでも、嫌がっている感じのもの等々、お任せしたいです！\n\nイってしまった時のものは、顎しか見えない舌出し仰け反り絶頂で、お願いしたいです！\n\nPの描写は最低限、透明でも大丈夫、また台詞などはお任せします！\n以上で大丈夫そうであれば、お願い頂きたいです！\n\nhttps://imas.gamedbs.jp/cgss/images/-avmQG61g_mn8_6mszsxL1DeB7brW5hrR5NF-I0yYYE.jpg", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/11", "thumbnail_src": "https://si.imgix.net/556b97a2/uploads/origins/06d42929-d464-4949-8ba0-4a9776dc1dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a15d3db00096e1fb4b800ea6cbf326b9", "thumbnail_srcset": "https://si.imgix.net/556b97a2/uploads/origins/06d42929-d464-4949-8ba0-4a9776dc1dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a15d3db00096e1fb4b800ea6cbf326b9, https://si.imgix.net/556b97a2/uploads/origins/06d42929-d464-4949-8ba0-4a9776dc1dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e0549e04ccd6c1b0c9e5edb8fb7016b 2x, https://si.imgix.net/556b97a2/uploads/origins/06d42929-d464-4949-8ba0-4a9776dc1dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf3133868c308f95af9d0fa33e973ca1 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今日も素敵な一日をお過ごしでしょうか。お忙しい中、事前にご検討いただきありがとうございました。\n\n最初のSkebリクエストで描いていただいた教室の様子（https://skeb.jp/@konekonoyomeiri/works/1）、とても素敵ですね。\n\n同じような教室の環境で、私のオリジナルキャラクターを2人描いていただけませんか？\n\n胸ぺったんこのロリキャラ2人は、学校のコスプレパレードに参加しています。しかし、普通の生徒ならシンプルなキャラで行くところ、二人は結局エロいのを選んでしまう。\n\nアニメが大好きな二人は、イマジニアとプリズマ☆イマジニアのクロの獣人バージョンのコスチュームで登校することになりました。\n\nこのコスチュームを着た下の2人を描くことができますか？その衣装で、クラスメイトにセクシーなポーズをとる2人を、あどけない表情で描いてください。\n\nキャラクター1 シナモンちゃん（猫耳と尻尾のある猫娘）\nhttps://rebrand.ly/vctd8v2\n\nキャラクター②デメーテルちゃん（うさ耳としっぽのバニーガール）\nhttps://rebrand.ly/demeter-reference\n\nこのアイデアがあなたのお好みであることを願っています。", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/10", "thumbnail_src": "https://si.imgix.net/fcf180aa/uploads/origins/3c6d43b6-1a10-456d-9e45-43629c9b149d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfba02191a9d86543458fee151e41d06", "thumbnail_srcset": "https://si.imgix.net/fcf180aa/uploads/origins/3c6d43b6-1a10-456d-9e45-43629c9b149d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfba02191a9d86543458fee151e41d06, https://si.imgix.net/fcf180aa/uploads/origins/3c6d43b6-1a10-456d-9e45-43629c9b149d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c390b57e77ac96994d798ca258c128e 2x, https://si.imgix.net/fcf180aa/uploads/origins/3c6d43b6-1a10-456d-9e45-43629c9b149d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39f4a03d8a065dc1fe23bb8f2cf3888c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！！！VTuberの犬飼ぷりんです。  VTuber犬飼ぷりんの画像が欲しいです。  ロリで描いて欲しいです。  制服を着ています。  防犯ブザーを持った人をドヤ顔でいじっている。  こんな感じでお願いします！ https://www.pixiv.net/en/artworks/92946805\n\nお忙しい中、ありがとうございました\n\nhttps://imgur.com/M7lS6zl", "created_at": "", "completed_at": ""}, {"path": "/@konekonoyomeiri/works/9", "thumbnail_src": "https://si.imgix.net/db07d407/uploads/origins/ffbb4c47-db6b-4867-a34d-14ea28b1f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ce334329d502e3d3484481a264f6cf", "thumbnail_srcset": "https://si.imgix.net/db07d407/uploads/origins/ffbb4c47-db6b-4867-a34d-14ea28b1f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ce334329d502e3d3484481a264f6cf, https://si.imgix.net/db07d407/uploads/origins/ffbb4c47-db6b-4867-a34d-14ea28b1f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c77781ef6e5e40960bf829f3bb256f5e 2x, https://si.imgix.net/db07d407/u