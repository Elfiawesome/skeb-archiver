.net/cbe9a5f6/uploads/origins/4334bacb-89da-4bf9-ab6c-e07bbe66d5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5f29823d4cea831c4d0aa22890a0d51 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のOCのためにこのような中国風の服をデザインすることができますか？https://www.pixiv.net/en/artworks/99435185。\n彼女の武器はオプションです。詳細はお任せします。ご検討よろしくお願いします。\n\nhttps://imgur.com/gYlo7FI", "created_at": "", "completed_at": ""}, {"path": "/@mashiroKta/works/12", "thumbnail_src": "https://si.imgix.net/2d996289/uploads/origins/19a4449e-fc76-405b-b03a-c1b17d6d102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=690f6b8e07aff5ae59f340c8f6d38e45", "thumbnail_srcset": "https://si.imgix.net/2d996289/uploads/origins/19a4449e-fc76-405b-b03a-c1b17d6d102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=690f6b8e07aff5ae59f340c8f6d38e45, https://si.imgix.net/2d996289/uploads/origins/19a4449e-fc76-405b-b03a-c1b17d6d102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5aedbe4841a27add82f2b8c820c80dac 2x, https://si.imgix.net/2d996289/uploads/origins/19a4449e-fc76-405b-b03a-c1b17d6d102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38a952fb87689fb0e6629c168c9c6edb 3x", "genre": "art", "nsfw": false, "body": "おい、ましろさん。\n\n私はあなたのアートスタイルとキャラクターデザインが大好きです。\n\n私のオリジナルキャラの絵をお願いしたいです。また、新しい衣装のデザインもお願いします。\n\nポーズなどはお任せします。できれば簡単な背景もお願いします\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1xcCCGs3jCfo4k354cQuVY6rj0Kx2ndRp?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mashiroKta/works/11", "thumbnail_src": "https://si.imgix.net/f13f697c/uploads/origins/ab744f85-ef19-4a54-adf8-461aa938f4c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ef27dbe73febe264e793ea7186f144", "thumbnail_srcset": "https://si.imgix.net/f13f697c/uploads/origins/ab744f85-ef19-4a54-adf8-461aa938f4c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ef27dbe73febe264e793ea7186f144, https://si.imgix.net/f13f697c/uploads/origins/ab744f85-ef19-4a54-adf8-461aa938f4c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0f7604414812ac895a3d857110c1b63 2x, https://si.imgix.net/f13f697c/uploads/origins/ab744f85-ef19-4a54-adf8-461aa938f4c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664e560cf90ebd195db65d5e8a817d64 3x", "genre": "art", "nsfw": false, "body": "前回はつい視線を吸い寄せられるような魔性、かつ美麗で細部まで輝く素敵なイラストを描いてくださりありがとうございました\n今回もまたぜひ、真白K大先生に私の想う場面を実現して頂きたくリクエストさせていただきました\nぜひご承諾いただけると嬉しいです\n\n【作品】\n・ミストトレインガールズ\n\n【キャラクター】\n・シブヤ\nhttps://misttraingirls.wikiru.jp/index.php?シブヤ\n\n【服装】\nhttps://misttraingirls.wikiru.jp/index.php?［待てを知らない忠犬］シブヤ\n\n【シチュエーション】\n・舞台は近世ヨーロッパ風の街並み\n・季節は夏、時間帯は真昼間。太陽の光溢れる明るい雰囲気\n\n・シブヤは手にギターを持ち、ストリートミュージシャンの如く往来で演奏を披露している場面\n・表情は爽やかな笑顔。瞳を輝かせ、目と口を大きく開けている\n・全身を使って楽器を演奏していることが伝わるよう、少し躍動感を持たせてほしい\n・真白K大先生の、髪の毛がなびく表現が好きなので、よろしければシブヤの特徴とも言える大きなポニーテールが体の動きと風で躍動するところが見たいです\n・ギターは「ギブソン・レスポール」のチェリーサンバースト\n\n・可能であれば、沢山の野次馬が押し寄せていることが伝わる表現を入れていただけると嬉しいです（あくまでさりげない表現で、群衆が目立ちすぎない程度に）\n\nhttps://drive.google.com/drive/folders/1-jCnC-8ilvRgLm1sDE8v9IlyAQ3w2DgD", "created_at": "", "completed_at": ""}, {"path": "/@mashiroKta/works/10", "thumbnail_src": "https://si.imgix.net/50136f90/uploads/origins/15dab1b2-41bd-4514-918d-33ba08a46e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf720b16870693ac307693b82998515a", "thumbnail_srcset": "https://si.imgix.net/50136f90/uploads/origins/15dab1b2-41bd-4514-918d-33ba08a46e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf720b16870693ac307693b82998515a, https://si.imgix.net/50136f90/uploads/origins/15dab1b2-41bd-4514-918d-33ba08a46e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd56c496a54d7880fd5dba17fe098e55 2x, https://si.imgix.net/50136f90/uploads/origins/15dab1b2-41bd-4514-918d-33ba08a46e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b99fcb67b6d8adb7226268a13eede2f 3x", "genre": "art", "nsfw": false, "body": "私は本当にあなたの仕事が大好きです、私はあなたが私の委託を受け入れることができることを望む、彼女はライオンの女の子です、彼女は短い髪を持っており、二つの束は、気分によって振ることができる耳のようなものです、あなたはあなたの想像力をフルに発揮することができます。私はあなたが彼女を描くのプロセスを楽しむことができます願っています。\n\nhttps://drive.google.com/file/d/1_UsNPHknZAwnnK1P270o9Xw2FKiWucUe/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mashiroKta/works/9", "thumbnail_src": "https://si.imgix.net/698dbdae/uploads/origins/31f25d14-d2fb-4a9f-9fb5-e1ac02037965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6b738e5733aca92d9a331e557ecb177", "thumbnail_srcset": "https://si.imgix.net/698dbdae/uploads/origins/31f25d14-d2fb-4a9f-9fb5-e1ac02037965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6b738e5733aca92d9a331e557ecb177, https://si.imgix.net/698dbdae/uploads/origins/31f25d14-d2fb-4a9f-9fb5-e1ac02037965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31f2f19ea554b9866e2a2d21c69c170f 2x, https://si.imgix.net/698dbdae/uploads/origins/31f25d14-d2fb-4a9f-9fb5-e1ac02037965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99e77c1a18fc673ad1a3403cacab87d6 3x", "genre": "art", "nsfw": false, "body": "あなたの大胆な色使いと服のファッションの選択が大好きです。私のVtuberに着せる服をデザインしてほしいです。ポーズや表現の自由は完全にあなた次第です。ただ、首輪やチョーカーを付けて欲しいのですが、どのようなスタイルにするかは自由です。カラーリングは白×ピンクや黒×ピンクなどでも構いません。私のルミに着せる姿をぜひ見てみたいです。また、ルミの瞳孔をハート型に描いていただけると、ボーナスポイントになります。\n\nhttps://imgur.com/a/YXefuJd", "created_at": "", "completed_at": ""}, {"path": "/@mashiroKta/works/8", "thumbnail_src": "https://si.imgix.net/437a0454/uploads/origins/1dc5d25a-8140-48f6-981b-7a0d656d0d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae4e2232e8e57e99ab0975839ad13c05", "thumbnail_srcset": "https://si.imgix.net/437a0454/uploads/origins/1dc5d25a-8140-48f6-981b-7a0d656d0d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae4e2232e8e57e99ab0975839ad13c05, https://si.imgix.net/437a0454/uploads/origins/1dc5d25a-8140-48f6-981b-7a0d656d0d17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fef9511d05c68513a55838518134c02 2x, https://si.imgix.net/437a0454/uploads/origins/1dc5d25a-8140-48f6-981b-7a0d656d0d17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d14bc1e3c4228e779b6f07e202c19ac 3x", "genre": "art", "nsfw": false, "body": "はじめまして。真白K大先生の透明感と清涼感に満ちた色の世界、そして人物達の生き生きとしたバリエーション溢れる表情に惹かれてリクエストさせていただきました\n青という落ち着いた色をベースにしながら、しかしエネルギッシュに自己を表現するキャラクターの数々はとても魅力的です\n\n二次創作の依頼となってしまうのですが、もしご一考くだされば幸いです\n\n【作品】\n・ミストトレインガールズ\n公式運営様に問い合わせ、コミッションサービス利用の許可は得ております\n\n【キャラクター】\n・テンシン\nhttps://misttraingirls.wikiru.jp/index.php?テンシン\n\n【服装】\nhttps://misttraingirls.wikiru.jp/index.php?plugin=attach&refer=［至福のひと時を］テンシン&openfile=［至福のひと時を］テンシン_profile.png\n\n【用途】\n・Twitterのアイコンとして使用させていただこうと考えております。\n\n【内容】\n・体の向きと視線は正面\n・両目と口を開けた天真爛漫な笑顔\n・両手を前に差し出し、目の前の人物を優しく暖かく受け入れるような、母性に溢れる仕草\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@mashiroKta/works/7", "thumbnail_src": "https://si.imgix.net/aefdad83/uploads/origins/177453c0-c81e-4854-8ce5-fab87bc80ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bed6953e12e1ed36a15d752b142d0dc", "thumbnail_srcset": "https://si.imgix.net/aefdad83/uploads/origins/177453c0-c81e-4854-8ce5-fab87bc80ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bed6953e12e1ed36a15d752b142d0dc, https://si.imgix.net/aefdad83/uploads/origins/177453c0-c81e-4854-8ce5-fab87bc80ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18152961fdac6a9dc6c3609751a3