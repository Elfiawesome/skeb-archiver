b8d6e2c17b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0afe76941209ca982150db860ab207, https://si.imgix.net/19574b53/uploads/origins/2d9c4087-8296-40fa-a19b-fbb8d6e2c17b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56e8582a6a72042ae154f285d60e4e08 2x, https://si.imgix.net/19574b53/uploads/origins/2d9c4087-8296-40fa-a19b-fbb8d6e2c17b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24325ad31e228fa723f6ca9f528bdc60 3x", "genre": "art", "nsfw": true, "body": "はじめまして。御本とXで拝見しますおじ様たちのえちえち絵にいつもお世話になっています！ はるかってぃさんの描かれる、男たちの筋肉と色気、エロエロな乱れっぷりが大好きです！\n　\n　Fate/GrandOrderより、柳生但馬守宗矩をお願いしたいです！\n　\n・シチュエーション\n　柳生宗矩本の続き的なイラストを拝見したいです。\n　主殿のために自己開発しているうちに、パールでの尿道オナとデカマラディルドでのアナニーに夢中になってセルフ雌墜ちするシーンをお願いいたします！\n・可能であれば(予算の許す限りで)\n　射精差分や着衣差分があると嬉しいです！\n\n柳生宗矩本をきっかけに、グラブル本やFE本も拝見しました。読み返すたびにオイゲンがえろかわいく見えて仕方ないです！ ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@harukatti/works/15", "thumbnail_src": "https://si.imgix.net/6e85ccbf/uploads/origins/6180a9ff-0ffb-40cc-9b15-1d9fa6e829cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=005c87f3445bc2d26c7565663f9e23cd", "thumbnail_srcset": "https://si.imgix.net/6e85ccbf/uploads/origins/6180a9ff-0ffb-40cc-9b15-1d9fa6e829cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=005c87f3445bc2d26c7565663f9e23cd, https://si.imgix.net/6e85ccbf/uploads/origins/6180a9ff-0ffb-40cc-9b15-1d9fa6e829cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e7612d3f92feefb54bad342360bf6ac 2x, https://si.imgix.net/6e85ccbf/uploads/origins/6180a9ff-0ffb-40cc-9b15-1d9fa6e829cf?bg=%23fff&auto=format%2Ccompress&fm