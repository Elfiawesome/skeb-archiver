beb8-3673-447e-a4df-47dfec8d5e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c87106d6d640564bc2eacad10ab3ca21", "thumbnail_srcset": "https://si.imgix.net/b641cae9/uploads/origins/1587beb8-3673-447e-a4df-47dfec8d5e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c87106d6d640564bc2eacad10ab3ca21, https://si.imgix.net/b641cae9/uploads/origins/1587beb8-3673-447e-a4df-47dfec8d5e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52606c4c96556bf8b1d4a808be7c2320 2x, https://si.imgix.net/b641cae9/uploads/origins/1587beb8-3673-447e-a4df-47dfec8d5e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af24cc8e52dcc127ca3a902871f7765d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haro_jp_/works/9", "thumbnail_src": "https://si.imgix.net/03722d15/uploads/origins/44e0750c-0e18-49df-be6f-41b11293c11b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e62d741340284a4ef01e046dcaa5c1f", "thumbnail_srcset": "https://si.imgix.net/03722d15/uploads/origins/44e0750c-0e18-49df-be6f-41b11293c11b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e62d741340284a4ef01e046dcaa5c1f, https://si.imgix.net/03722d15/uploads/origins/44e0750c-0e18-49df-be6f-41b11293c11b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de6527d84a51fac7037952b6951bf0f1 2x, https://si.imgix.net/03722d15/uploads/origins/44e0750c-0e18-49df-be6f-41b11293c11b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bce3b28f724464fb192b6795d7a3967 3x", "genre": "art", "nsfw": false, "body": "はじめまして。タカと申します。\nはろ先生の可愛いイラストを拝見し、\nぜひVtuberの「猫山みあ」さんを描いていただきたいと思いリクエストを送らせていただきました。\n\n■希望のイラスト\n構図：夏の海での水着イラスト\nはろ先生のこちらのイラスト様な感じでお願いしたいです。\n\nhttps://x.com/haro_jp_/status/1889263876006654066?s=46\n\nポーズ：お任せ\nシチュエーション：お任せ\n服装：はろ先生の描いたイラストの様に水着の上にTシャツとショートパンツを履いていてTシャツは濡れて透けてる状態で裾を縛っておへそが見える\nショートパンツは前を止めず水着が見える\n水着の色やデザインですが過去にグッズで黒はあったので黒以外でお任せしたいです。\n髪型：お任せ、アレンジで描いていただいても構いません。\n胸の大きさは参考にさせていただいた先生のイラストぐらいでお願いします。\nそれとTシャツやショートパンツの無い差分は可能でしょうか？可能でしたらお願いしたいです。\n■使用用途\nYoutube(収益化済）サムネやTwitter\nFANBOXでの壁紙配布として猫山みあさんの配信活動での使用を許可していただけると幸いです。\n\n■サイズ\nサムネイル等に使用するため、髪の毛の先や耳、指の先等が切れていない構図ですと幸いです。\n\n■その他\n人物のみの背景透過もお願いいたします。\nファイル形式は、キャラクターと背景を分けたPSDファイルでいただけると幸いです。\n参考資料三面図：https://x.com/nekoyama_miaaa/status/1912070979733569628?s=46\n猫山みあ参考資料\n\nhttps://drive.google.com/drive/folders/1IrNB5U_hlfaOXZL7eawlDtyRX1h1EBc9\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@haro_jp_/works/8", "thumbnail_src": "https://si.imgix.net/6615a3ca/uploads/origins/d7a54684-366f-45ee-8871-920b3b179725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fea9f25f04eb35b2bd2076963b40ba2", "thumbnail_srcset": "https://si.imgix.net/6615a3ca/uploads/origins/d7a54684-366f-45ee-8871-920b3b179725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fea9f25f04eb35b2bd2076963b40ba2, https://si.imgix.net/6615a3ca/uploads/origins/d7a54684-366f-45ee-8871-920b3b179725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a404d4540818b15d751ea5abe35418b2 2x, https://si.imgix.net/6615a3ca/uploads/origins/d7a54684-366f-45ee-8871-920b3b179725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caa4d05b62f4708b658fcb4bd8806070 3x", "genre": "art", "nsfw": true, "body": "ハロさん、こんにちは！\n\nまたまたR18のリクエストで申し訳ないのですが、船長がビーチで楽しんでいる絵が大好きでたまりません。船長と乗組員がビーチでロマンチックな時間を過ごしているシチュエーションが欲しいです。船長が騎乗位で上になり、船員と指を絡めている。視点は船員を通して船長を見ている。キスをしたばかりなので、船長の舌が出ている。ビキニが持ち上げられ乳首が見える。\nできれば、船長の大きなお尻が入ったフレームが欲しい。\nありがとうございました 🙇‍♂️\n船長が大好きです", "created_at": "", "completed_at": ""}, {"path": "/@haro_jp_/works/7", "thumbnail_src": "https://si.imgix.net/68be65e7/uploads/origins/f5c39093-ba12-4b16-a158-52366c98590a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aad7222e24f902bd54574a6278a1591", "thumbnail_srcset": "https://si.imgix.net/68be65e7/uploads/origins/f5c39093-ba12-4b16-a158-52366c98590a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aad7222e24f902bd54574a6278a1591, https://si.imgix.net/68be65e7/uploads/origins/f5c39093-ba12-4b16-a158-52366c98590a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6aa800532568e6fe6264b46e8460eb05 2x, https://si.imgix.net/68be65e7/uploads/origins/f5c39093-ba12-4b16-a158-52366c98590a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7a688800bca3dbc0889b633f9a8c90a 3x", "genre": "art", "nsfw": false, "body": "はろ先生こんにちは！\n\nぶいすぽっENの黒刃アリヤちゃんのイラストお願いします\nもうすぐ夏から水着のイラスト欲しいです\n水着のデザイン：\n*黒水着\n*衣装の黄金の骨みたいな飾りが大事\n\n三面図： https://x.com/aryakuroha/status/1852531109893906672\n去年私の下手に描いたドット絵：https://x.com/lorok__/status/1825485478075760795\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@haro_jp_/works/6", "thumbnail_src": "https://si.imgix.net/5713338f/uploads/origins/947ed24b-baed-49d5-968a-0031683de976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63757bc3d87b5c0f12868816fcb7fec", "thumbnail_srcset": "https://si.imgix.net/5713338f/uploads/origins/947ed24b-baed-49d5-968a-0031683de976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63757bc3d87b5c0f12868816fcb7fec, https://si.imgix.net/5713338f/uploads/origins/947ed24b-baed-49d5-968a-0031683de976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5de61bc5d5476a0fde1a18de1ec8b47e 2x, https://si.imgix.net/5713338f/uploads/origins/947ed24b-baed-49d5-968a-0031683de976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9800a7323d9914979db1dc28062f2711 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは！\n\nマリン船長がシャワーを浴びている絵は大好きなのですが、船長がシャワーを浴びながら乗組員を受け入れるR18の代替シーンをお願いしたいです。船員の胸を触りながら、船長のアソコを貫く。乗務員にキス。陰毛が生えていて、髪をおろしている\n\nありがとうございます💓。", "created_at": "", "completed_at": ""}, {"path": "/@haro_jp_/works/5", "thumbnail_src": "https://si.imgix.net/2aac1b28/uploads/origins/edb62d29-5b5e-48c9-90bd-735095ee67a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ce3c40f079082255f806ee6fac8716c", "thumbnail_srcset": "https://si.imgix.net/2aac1b28/uploads/origins/edb62d29-5b5e-48c9-90bd-735095ee67a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ce3c40f079082255f806ee6fac8716c, https://si.imgix.net/2aac1b28/uploads/origins/edb62d29-5b5e-48c9-90bd-735095ee67a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39ebb141f3bb9d677c7f3c615c98bcc1 2x, https://si.imgix.net/2aac1b28/uploads/origins/edb62d29-5b5e-48c9-90bd-735095ee67a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8593f17ca4e8765d84e42fc62fcb8710 3x", "genre": "art", "nsfw": true, "body": "こんにちわ\n\n私はずっと絵のファンでした。宝生マリンのR18の図面をお願いしたいです。前回描いていただいた、10月頃に船長が性的に欲求不満な乗組員にベッドで拘束されている絵の続編になります。髪型は同じボブ。船長はオッパイを露出し、全裸で汗をかきながら宣教師的な体位になっている。彼女の表情は幸せな性的快楽に満ちている。ペニスが彼女の膣の中を貫通しているのが見える。\n\n私のリクエストを検討していただけると幸いです。\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@haro_jp_/works/4", "thumbnail_src": "https://si.imgix.net/445b3b0f/uploads/origins/c1b9e396-55ff-4ccc-b034-0b6dea4a00ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6a953baca564ccf9dcc7286bda23cfa", "thumbnail_srcset": "https://si.imgix.net/445b3b0f/uploads/origins/c1b9e396-55ff-4ccc-b034-0b6dea4a00ba?bg=%