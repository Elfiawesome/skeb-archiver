-fb4acbb5031c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3294cdec6cd815a5232671de994c671c, https://si.imgix.net/ed188bc9/uploads/origins/32c3eedf-f6d5-4869-bb5e-fb4acbb5031c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f382a98fabc27bc47b669943c1ba86a 2x, https://si.imgix.net/ed188bc9/uploads/origins/32c3eedf-f6d5-4869-bb5e-fb4acbb5031c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d76956761851270d3017ead6be71285b 3x", "genre": "art", "nsfw": true, "body": "私の趣味にお付き合い威いただけたら幸いです。\n\n【ゴブリンスレイヤー！】より【「剣の乙女」の衣装を着た「女神官」】で\n【「服の透け」or「隙間から諸々見えてしまっている」ようなちょっとえっちな姿】をお願いします。\n\n・肩掛けケープは無し（資料A04、B01参照）\n・全身を見切れ無くフレームイン\n・表情は微笑みのカメラ目線\n・錫杖（天秤の付いた大剣）は近くに添えてください\n・極端な俯瞰や煽り、接近視点はご勘弁ください\n・簡素で構いませんので野外っぽい背景があると嬉しいですが無くてもOKです（透過pngだとありがたいです）\n\n資料に同様の依頼で描いていただいた物や、準公式の衣装交換絵がありますので参考にしてみてください。\n\n布の質感などはこちらを参考にしてみてください。\nhttps://drive.google.com/drive/folders/1oekmqONV27lj4zxc3O0ijG7M0dGAxwIZ\n\nhttps://drive.google.com/drive/folders/1CUuMarcn56w09XMRTkU5nHYsQgr-8pEj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@100percent_park/works/34", "thumbnail_src": "https://si.imgix.net/7f2c6f9c/uploads/origins/f8fc9669-ef91-439b-92eb-2cca7d2272f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c59a365cb2caded90e927ef1241c9ff", "thumbnail_srcset": "https://si.imgix.net/7f2c6f9c/uploads/origins/f8fc9669-ef91-439b-92eb-2cca7d2272f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c59a365cb2caded90e927ef1241c9ff, https://si.imgix.net/7f2c6f9c/uploads/origins/f8fc9669-ef91-439b-92eb-2cca7d2272f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c27474d99c60cc2a630399102975876e 2x, https://si.imgix.net/7f2c6f9c/uploads/origins/f8fc9669-ef91-439b-92eb-2cca7d2272f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df48529cc7f7abffb9ff2c629f588504 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます。\nTriangleが出している魔法戦士スイートナイツに出てくる、スイートリップをお願いします。\n変身後の姿で、勇ましく武器を構えているシチュエーションをお願いします。\n\nhttps://www.google.com/search?sca_esv=452b903197b11896&rlz=1CDGOYI_enJP798JP798&hl=ja&sxsrf=ADLYWILipqz_LRbbKG650o1pHQfPbZnK4A:1723269847951&q=%E3%82%B9%E3%82%A4%E3%83%BC%E3%83%88%E3%83%AA%E3%83%83%E3%83%97+%E9%AD%94%E6%B3%95%E6%88%A6%E5%A3%AB&udm=2&fbs=AE\n\nhttps://images.app.goo.gl/UXdz37kh9tHnJoSX6", "created_at": "", "completed_at": ""}, {"path": "/@100percent_park/works/33", "thumbnail_src": "https://si.imgix.net/b8521e44/uploads/origins/5c1f4284-43c4-4136-aad5-c9fda470838a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e30c14d7c505390e2373b5ad7d1703c2", "thumbnail_srcset": "https://si.imgix.net/b8521e44/uploads/origins/5c1f4284-43c4-4136-aad5-c9fda470838a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e30c14d7c505390e2373b5ad7d1703c2, https://si.imgix.net/b8521e44/uploads/origins/5c1f4284-43c4-4136-aad5-c9fda470838a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f9ccd6bf2a47c5fb42a934d5de8b802 2x, https://si.imgix.net/b8521e44/uploads/origins/5c1f4284-43c4-4136-aad5-c9fda470838a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1abd14ffcf0cf4e6087009355185ea59 3x", "genre": "art", "nsfw": true, "body": "100％さんこんにちは！\nリクエストをお願いしたいです！\n\n【キャラクター】\nブプレウルム（花騎士）\nカジノディーラーの駆け引き上手な明るい女の子です。\n耳は魔力が強すぎて実体化したものです。\n\n【衣装】\n逆バニー\n\n【シチュエーション等】\nセクシーな衣装で団長を誘惑中\n\n【差分】\nニプレスと前張りの有り無しと蕩けた表情もお願いしたいです\n\nよろしくお願いいたします！\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%96%E3%83%97%E3%83%AC%E3%82%A6%E3%83%AB%E3%83%A0", "created_at": "", "completed_at": ""}, {"path": "/@100percent_park/works/32", "thumbnail_src": "https://si.imgix.net/5e0a6245/uploads/origins/baed4019-bde9-4d8d-983c-4b55d01a2042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccent