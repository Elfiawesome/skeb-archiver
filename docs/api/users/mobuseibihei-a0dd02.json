67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35736be67cc4fe4ad0fbad3e60a8edb4 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！いつも色々拝見させて頂いています。\n\n今回の依頼ですが、國政領火さんを巫女服姿でお願いします。実家の神社でお手伝いされたこととかあるはずなのできっと似合うはず。\n\n雑な依頼で申し訳ありませんが、何卒お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mobuseibihei/works/5", "thumbnail_src": "https://si.imgix.net/095410a6/uploads/origins/9f7ff26a-6d23-4db0-9931-cc466ba67e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f165c1ee42cb78b5bd16df84585de60", "thumbnail_srcset": "https://si.imgix.net/095410a6/uploads/origins/9f7ff26a-6d23-4db0-9931-cc466ba67e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f165c1ee42cb78b5bd16df84585de60, https://si.imgix.net/095410a6/uploads/origins/9f7ff26a-6d23-4db0-9931-cc466ba67e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=788046a21332f3a6e68e05e4313e0b58 2x, https://si.imgix.net/095410a6/uploads/origins/9f7ff26a-6d23-4db0-9931-cc466ba67e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f927e31a350944dcff91eb90aa08ef7 3x", "genre": "art", "nsfw": false, "body": "キャスティ・リアノイト", "created_at": "", "completed_at": ""}, {"path": "/@mobuseibihei/works/4", "thumbnail_src": "https://si.imgix.net/a8c69489/uploads/origins/f3cfd067-e4c9-4cf9-8ae5-017fc3f32ca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4020b17e95a34b0651b8951786e8b79", "thumbnail_srcset": "https://si.imgix.net/a8c69489/uploads/origins/f3cfd067-e4c9-4cf9-8ae5-017fc3f32ca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4020b17e95a34b0651b8951786e8b79, https://si.imgix.net/a8c69489/uploads/origins/f3cfd067-e4c9-4cf9-8ae5-017fc3f32ca6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae5edb69c66ec84b2fa7067bb2f40777 2x, https://si.imgix.net/a8c69489/uploads/origins/f3cfd067-e4c9-4cf9-8ae5-017fc3f3