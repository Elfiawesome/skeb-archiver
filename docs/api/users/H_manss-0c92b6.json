%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e49b383eeefe16ff04860125f3004019 2x, https://si.imgix.net/0e06561d/uploads/origins/a9f6d877-84f2-452f-880f-36e545fdbbb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f1cf8ddcad1b9e43360b6ddf14a1b77 3x", "genre": "art", "nsfw": true, "body": "はじめまして、金爆マン先生\n超次元ゲイム ネプテューヌ」のノワールの依頼をしたいです。\nhttps://imgur.com/a/q3xcvkA（コスチューム008）\nこの作品(https://www.pixiv.net/artworks/88377232)も、以前描いていただいたセルフボンデージシリーズもとても気に入っています。\n\nこの2つの要素(激しい拘束＋セルフボンデージ)を融合させて、彼女に取り組んでいただけないでしょうか？主な拘束具は金属で、バイブレーターは必要です。\nそれ以外のことはあなた次第です。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/46", "thumbnail_src": "https://si.imgix.net/20365d57/uploads/origins/3f4362bf-e744-45e5-b926-009d0d521276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=142ad454b876317256689101b0f74c96", "thumbnail_srcset": "https://si.imgix.net/20365d57/uploads/origins/3f4362bf-e744-45e5-b926-009d0d521276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=142ad454b876317256689101b0f74c96, https://si.imgix.net/20365d57/uploads/origins/3f4362bf-e744-45e5-b926-009d0d521276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d77ed74c62331731e3458191e7f5dc16 2x, https://si.imgix.net/20365d57/uploads/origins/3f4362bf-e744-45e5-b926-009d0d521276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e0f67dcf107aa5af771363aea22057e 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。\nhttps://sta.sh/2i1tvkp77l5、椅子に縛られた私のOCをもう一人描いていただけませんか？また、猿ぐつわをされたり、目隠しをされたり、バイブを使われたりするバージョンも欲しいです。\nまたよろしくお願いします。\n\nhttps://sta.sh/22d4xtfod13a", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/45", "thumbnail_src": "https://si.imgix.net/57cf3e6f/uploads/origins/721c0c4d-6081-4b5c-9b7c-40bb11639521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e49a92e20fe833b9733639dd2551f9", "thumbnail_srcset": "https://si.imgix.net/57cf3e6f/uploads/origins/721c0c4d-6081-4b5c-9b7c-40bb11639521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e49a92e20fe833b9733639dd2551f9, https://si.imgix.net/57cf3e6f/uploads/origins/721c0c4d-6081-4b5c-9b7c-40bb11639521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c1744b2ca3ce4757547ff38cddf6634 2x, https://si.imgix.net/57cf3e6f/uploads/origins/721c0c4d-6081-4b5c-9b7c-40bb11639521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94553c1e9cf6f4cddeac0f654b641938 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい拘束絵をありがとうございます。\n\n今回はうちの子である「海都鈴音」をお願いします。\nデザインは資料URLかpixivのタグで「海都鈴音」と検索ください。\n\n最近も挙げられていたこちら（https://x.com/kinbakuman_/status/1730526559763853387?s=20）の絵のように手や足が全く身動きできないように拘束され、バイブやローターで快楽責めにあっているところを見たいと思っています。\n\n口にはボールギャグを付けて欲しいです。\n拘束はテープ以外でも大丈夫ですが、テープか革の拘束具だと嬉しいです。\nご検討よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/104735286", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/44", "thumbnail_src": "https://si.imgix.net/70de1974/uploads/origins/9768b762-3332-46e2-9302-51ffb269bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7bd1952c232b2509ef0667c8f4b374", "thumbnail_srcset": "https://si.imgix.net/70de1974/uploads/origins/9768b762-3332-46e2-9302-51ffb269bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7bd1952c232b2509ef0667c8f4b374, https://si.imgix.net/70de1974/uploads/origins/9768b762-3332-46e2-9302-51ffb269bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67a2bc5a0177d80e10777298bbaf3b89 2x, https://si.imgix.net/70de1974/uploads/origins/9768b762-3332-46e2-9302-51ffb269bf84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b659fd185ab583709b5309fe496149de 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n前に依頼したシチュエーションを継続して、再びZ1のイラストを依頼したいです\n\n兵士たちは、台風が来る前に港に停泊している船をしっかりと縛り付ける方法を学んでいます\nZ1は出撃前のミスのため、デモンストレーション艦として指名されました\n\n可能であれば、手を背中に拘束する要素や首輪と鎖を加えていただけると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/43", "thumbnail_src": "https://si.imgix.net/3b7cc055/uploads/origins/6460f937-bef6-4955-b13b-2837846a855f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c81acd8598f054305406817b196981f", "thumbnail_srcset": "https://si.imgix.net/3b7cc055/uploads/origins/6460f937-bef6-4955-b13b-2837846a855f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c81acd8598f054305406817b196981f, https://si.imgix.net/3b7cc055/uploads/origins/6460f937-bef6-4955-b13b-2837846a855f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8177283458c91803726c55f9870267b2 2x, https://si.imgix.net/3b7cc055/uploads/origins/6460f937-bef6-4955-b13b-2837846a855f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d713c16d3d5dbf74eaf3ca6da96e987 3x", "genre": "art", "nsfw": true, "body": "赤いロープで吊るされたバニーの悪魔の女の子を描いてください。 この女の子はバニーとサキュバスのミックスです。 つの角と長い耳を持っています。左胸の上、右肩、左の太ももの内側にビューティーマークがある。 左太ももの外側には3つの赤いハートのタトゥーがある。\n\n女の子は生意気な性格で、賭けに負けたり罰を受けたりするシナリオです。\n\nこの参考資料と同じようなポーズで縛られたバニーデーモンの少女を描いてください。ただし、革紐の代わりに赤いロープを使ってください。 少女は完全に服を着ている必要がありますが、ショーツを脱いでパンティをはいたままの代替もありえます。\n\nポーズの参考：\nhttps://drive.google.com/file/d/1USclNH3HweQnnRyKh96EH1Tj_LYAqXkf\n\nキャラクター・リファレンス：\nhttps://drive.google.com/drive/folders/1CPkw8h68hgzOHzupk1Lc23yBlk_UG407", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/42", "thumbnail_src": "https://si.imgix.net/9e3659f8/uploads/origins/d1e14c95-6b6c-4b86-b1a2-f213f6f427ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a4b0fdc1bd4feb9f9925c74a0d9066b", "thumbnail_srcset": "https://si.imgix.net/9e3659f8/uploads/origins/d1e14c95-6b6c-4b86-b1a2-f213f6f427ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a4b0fdc1bd4feb9f9925c74a0d9066b, https://si.imgix.net/9e3659f8/uploads/origins/d1e14c95-6b6c-4b86-b1a2-f213f6f427ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad14faf7150863e113322b8ba3e37f01 2x, https://si.imgix.net/9e3659f8/uploads/origins/d1e14c95-6b6c-4b86-b1a2-f213f6f427ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7df32a0fb7aaecda33891e6406943c0 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n前回の依頼の作品がとても気に入りましたので、再びZ1にイラストの依頼をしたいと思います。\n\n部屋に戻ったZ1は、より強い拘束方法で自身の行動能力を制限し、タイマーロックと鉄の鎖で自分をベッドに固定し、明日の朝までのカウントダウンを設定しました。\n\n可能であれば、Z1が急な出撃の通知を受け取り、脱出手段の準備を忘れて混乱に陥る差分を加えていただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/41", "thumbnail_src": "https://si.imgix.net/4f726ae6/uploads/origins/384b764d-631c-44e5-8b2e-0c49b8cbc64b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6f6c65d5f6d2c244e06d953611bfd7a", "thumbnail_srcset": "https://si.imgix.net/4f726ae6/uploads/origins/384b764d-631c-44e5-8b2e-0c49b8cbc64b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6f6c65d5f6d2c244e06d953611bfd7a, https://si.imgix.net/4f726ae6/uploads/origins/384b764d-631c-44e5-8b2e-0c49b8cbc64b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9510fa813525b532d1b10701f58bdb5 2x, https://si.imgix.net/4f726ae6/uploads/origins/384b764d-631c-44e5-8b2e-0c49b8cbc64b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b82b18106720be41d12102ff1b98a9e 3x", "genre": "art", "nsfw": true, "body": "匿名にて失礼します、イラストをリクエストさせていただきます。\n\n◆キャラクター\nラブひなの成瀬川なる\n衣装はバニーガール。参考画像のものに加え、長手袋とヒールを着用した状態\n参考：https://i.imgur.com/6sMq8ya.png\n\n◆シチュエーションと状態\n裏配信、もしくはいかがわしいショーにて見世物にされ、嬲られる…というイメージ\n後ろ手を拘束、脚を折りたたむ形で緊縛され、宙吊りにされている\n参考：https://drive.google.com/file/d/12xW7xhbwJKbIyd7VIXeCO7S7nn3wlgSx/view\n\n差分や流れはお任せします。\nただ可能であれば、「目を覚まし、自分の置かれた状況に羞恥混じりに驚く表情」を入れていただければ幸いです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@H_manss/works/40", "thumbnail_src": "https://si.imgix.ne