xtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59ce5f1ae5ce48a535a3025476279203 2x, https://si.imgix.net/35af1b1b/uploads/origins/f907a6f6-0be4-4096-ae13-fd9e55c18c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07c8c41133b3ba3ed95929058552e0e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/275", "thumbnail_src": "https://si.imgix.net/c3d1c410/uploads/origins/a9c949d2-9c85-4add-af77-40586b593b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c813ce1a4fc42fb4ad7412dac72f56f", "thumbnail_srcset": "https://si.imgix.net/c3d1c410/uploads/origins/a9c949d2-9c85-4add-af77-40586b593b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c813ce1a4fc42fb4ad7412dac72f56f, https://si.imgix.net/c3d1c410/uploads/origins/a9c949d2-9c85-4add-af77-40586b593b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed374d7135c03166385940c5a90048e8 2x, https://si.imgix.net/c3d1c410/uploads/origins/a9c949d2-9c85-4add-af77-40586b593b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da9ae2e846fb127fb9e6eb62f6a1919e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/274", "thumbnail_src": "https://si.imgix.net/ea338264/uploads/origins/1a9dee51-4e7c-481d-9f22-0836cd77bc8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69479d90330dc7d9b6a9765e67ff28a", "thumbnail_srcset": "https://si.imgix.net/ea338264/uploads/origins/1a9dee51-4e7c-481d-9f22-0836cd77bc8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69479d90330dc7d9b6a9765e67ff28a, https://si.imgix.net/ea338264/uploads/origins/1a9dee51-4e7c-481d-9f22-0836cd77bc8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b6e30d05db43860fcd509b31504887c 2x, https://si.imgix.net/ea338264/uploads/origins/1a9dee51-4e7c-481d-9f22-0836cd77bc8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd81ed29232ba72a053656d8cf1edca4 3x", "genre": "art", "nsfw": true, "body": "初めまして。自分にとってとても刺さるイラストを描かれていたので依頼を出させていただきました。\n\n今回の依頼の内容ですが、キャラクターはチェインクロニクルという作品よりケーテというキャラクターで下記の内容でお願いします。\n\n\n・シチュエーション\n身体を機械化するために右腕以外の四肢を切断されている状態。\n\n・構図\n本人は手術台の上ですでに両脚（膝からやや上あたり）ならび左肩付近を切断されたばかりの状態で、近くの机の上には切断したばかりの部位が置かれている状態でお願いします。\nイメージとしてはこちら（https://www.pixiv.net/artworks/89895413）で描かれたイラストの様子に近いですが他に描きやすい描写がありましたらそちらを優先していただいて大丈夫です！\n\nまた、本人の様子は落ち着いているもしくは眠っている様子でお願いします。\n\n\nもし上記の内容で大丈夫でしたらよろしくお願いします。\n\nチェインクロニクル　ケーテ\nhttps://www.4gamer.net/games/223/G022384/20231129037/SS/005.jpg", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/273", "thumbnail_src": "https://si.imgix.net/fe9ffbca/uploads/origins/4142e6ce-ff14-4b96-8c4f-074f57dd6eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0201af6ac510c63658ea8e42ec29acd7", "thumbnail_srcset": "https://si.imgix.net/fe9ffbca/uploads/origins/4142e6ce-ff14-4b96-8c4f-074f57dd6eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0201af6ac510c63658ea8e42ec29acd7, https://si.imgix.net/fe9ffbca/uploads/origins/4142e6ce-ff14-4b96-8c4f-074f57dd6eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c3c2b7b1b3ca33cd00f7d63cd06897a 2x, https://si.imgix.net/fe9ffbca/uploads/origins/4142e6ce-ff14-4b96-8c4f-074f57dd6eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f8ef28236d17b7c4b3ccd6f6009a2d4 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/272", "thumbnail_src": "https://si.imgix.net/bbb260cc/uploads/origins/8722cf76-4671-45d2-a055-3c438ff3bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62fdb822b7be4fb8e2e015ab3937c0ec", "thumbnail_srcset": "https://si.imgix.net/bbb260cc/uploads/origins/8722cf76-4671-45d2-a055-3c438ff3bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62fdb822b7be4fb8e2e015ab3937c0ec, https://si.imgix.net/bbb260cc/uploads/origins/8722cf76-4671-45d2-a055-3c438ff3bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=712dda4d7e30e73dfaa905bb5b248bc3 2x, https://si.imgix.net/bbb260cc/uploads/origins/8722cf76-4671-45d2-a055-3c438ff3bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef55732132e30db6838f88731edccfed 3x", "genre": "art", "nsfw": true, "body": "こんにちは。Fate/Stay Nightのキャラクター、アルトリア・ペンドラゴン(セイバー)、遠坂凛、馬頭琴のリクエストです。衣装は15thセレブレーションドレスです。\n(https://www.aniplexplus.com/itempTKdIzPT.html）。\n\nこの3人は銃殺刑にしてほしい。ムラムラして、殺されることに興奮している。彼らの体は銃弾の穴だらけで、血が流れ出ている。ドレスはぐちゃぐちゃになり、血に濡れる。乳首が露わになり、母乳と血液を授乳しながら、股間から潮を吹いて死んでいく。手足は銃弾に吹き飛ばされ、額に銃創を負って死ぬ。彼らの死体は床に倒れ、血と母乳の水たまりにまみれ、恍惚の表情を浮かべながら潮を吹く。\n\nありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/271", "thumbnail_src": "https://si.imgix.net/8cf575e2/uploads/origins/6467aaf3-c2f4-45a1-ab0a-ffe78889648b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4913278d8d65a878a8e12b5684a4d977", "thumbnail_srcset": "https://si.imgix.net/8cf575e2/uploads/origins/6467aaf3-c2f4-45a1-ab0a-ffe78889648b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4913278d8d65a878a8e12b5684a4d977, https://si.imgix.net/8cf575e2/uploads/origins/6467aaf3-c2f4-45a1-ab0a-ffe78889648b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c934baef2576415f74670f82c5c66baf 2x, https://si.imgix.net/8cf575e2/uploads/origins/6467aaf3-c2f4-45a1-ab0a-ffe78889648b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da07fe3f79ec0ba16ae5b8535a575deb 3x", "genre": "art", "nsfw": true, "body": "【リクエスト】\nリュール(FEエンゲージ)とその仲間の死体晒し\n\n【シチュエーション】\n原作11章「撤退」バッドエンド\nhttps://youtu.be/VllctermR4U?si=OHTV8MruBeIHVwIc\n\n追手を振り払えず全滅したリュール達。\n大将のリュール、裏切り者のアイビー、そしてリュールの仲間は敵に死姦された後、見せしめとしてその場で晒し者にされる\n\n【参考資料】\n・リュール\nhttps://guide.fire-emblem-heroes.com/14001002000900-2/\n・アイビー\nhttps://guide.fire-emblem-heroes.com/14004002001063-2/\n・リュールのこの時点の仲間(ここからお好みの子をお願いします)\nhttps://imgur.com/a/Uedvq2t\n\n【リクエスト詳細】\n・雨ざらしの中、リュール達の死体が晒し者にされている(吊るすも磔にするもお好みで)\n・衣装はボロボロにされ、おっぱいが露出\n・全身精液まみれ\n\nこのような形でいかがでしょうか？検討していただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/270", "thumbnail_src": "https://si.imgix.net/a58e66d3/uploads/origins/39fee11b-a194-4c7b-91fe-bfd21589c82b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1090f9618ae8ce897343044466a9f5cf", "thumbnail_srcset": "https://si.imgix.net/a58e66d3/uploads/origins/39fee11b-a194-4c7b-91fe-bfd21589c82b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1090f9618ae8ce897343044466a9f5cf, https://si.imgix.net/a58e66d3/uploads/origins/39fee11b-a194-4c7b-91fe-bfd21589c82b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64f2af29a008347cf8da028316fdb3b2 2x, https://si.imgix.net/a58e66d3/uploads/origins/39fee11b-a194-4c7b-91fe-bfd21589c82b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49b8a924f03a5388c5de80664e661033 3x", "genre": "art", "nsfw": true, "body": "イラスト3点お願いします。姫騎士リリアのメイド2人が魔王の飼育奴隷になる。魔王の顔は隠れています。最初の画像は彼の玉座の部屋にいるメイドたちで、2枚目は彼がメイドたちとセックスしているところです。そして最後の画像は、メイドたちが妊娠し、種付けベッドとして使われている。スケッチとソースはこちら。\nhttps://drive.google.com/file/d/1yBsD38TCGphReRbrCZDhfZZJx4hbWAAC/view?usp=sharing\nhttps://drive.google.com/file/d/1TIQmP94JkKSbI6bVFlCFPlmJpdiF42U5/view?usp=drive_link\nhttps://drive.google.com/file/d/1zlMkhIVbk1MWky1sgWsRQDsxMDCS2oOT/view?usp=drive_link\nhttps://drive.google.com/file/d/1gnl3Afoa0S5th7M6FbhPOmQltZ83KylV/view?usp=drive_link\n\nもし引き受けていただけるなら、本当にありがとうございます。\nまた、前回の依頼もありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/269", "thumbnail_src": "https://si.imgix.net/35c79647/uploads/origins/85c7cda9-b54e-4b08-979f-b878fa04b181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a796d8cfe45ada0bcb781df0777c96f", "thumbnail_srcset": "https://si.imgix.net/35c79647/uploads/origins/85c7cda9-b54e-4b08-979f-b878fa04b181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a796d8cfe45ada0bcb781df0777c96f, https://si.imgix.net/35c79647/uploads/origins/85c7cda9-b54e-4b08-979f-b878fa04b181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bb387c450311f6cc0b1c106c4d18db8 2x, https://si.imgix.net/35c79647/uploads/origins/85c7cda9-b54e-4b08-979f-b878fa04b181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3a7fb9a13341561e0632b5a215825da 3x", "genre": "art", "nsfw": true, "body": "いつも楽しく拝見させて頂いております。\n今回、オトギフロンティアのキャラクターであるジェミニの乳房切断絵をリクエスト致します。\nシチュエーションは以下の通りでお願いします。\nシーン１\n服から爆乳だけ露出した姿でギロチン台に拘束されているシーン。これから何が起こるかわかっていない無垢で不思議そうな表情をジェミニは浮かべている。この時、ギロチン台にセットされた乳房からは母乳が垂れ流しの状態になっている。後、目の色は金色でお願いします。\nシーン２\nジェミニの乳房めがけて、ギロチンが落ちようとしているシーン。この時、ジェミニの表情は青ざめながら慌てた顔になっており、乳房からは大量に母乳が噴き出している状態になっている。また、目の色は赤色でお願いします。\nシーン３\nギロチンが乳房に落ち、根元から乳房が切断され、宙に舞っているシーン。この時、胸から最後の放出と言わんばかりに、大量に母乳が噴き出した状態になっている。この時の表情は恐怖と痛みに耐える苦悶の表情で、目は赤色の状態でお願いします。\nシーン４\nギロチンが上がり、乳房の切断面が見えた状態で、ジェミニが悔しそうに涙を流している。また、地面に落ちた乳房からは血の混じった母乳が噴き出している状態になっている。この時、目の色は赤色の状態でお願いします。\n補足\nジェミニの見た目の資料は資料URLを参考にお願いします。\nまた身長134㎝　Bサイズ103cmのロリ爆乳キャラになりますので爆乳気味で描いて頂けるとありがたいです。\n妹人格と姉人格が同じ体に入っているという設定なので、目の色に細かく要望を出させて頂きましたが、大事な要素になるので何卒、よろしくお願いします。（なお、金色が妹、赤色が姉の状態になります）\n\n難しければキャンセルしていただいても構いません。\n\nご検討のほど、よろしくお願い致します。\n\nhttps://otogi.wikiru.jp/index.php?%E2%98%855/%E3%82%B8%E3%82%A7%E3%83%9F%E3%83%8B", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/268", "thumbnail_src": "https://si.imgix.net/28b2980a/uploads/origins/8c43e60a-e234-4ec3-bb57-811d458c48b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee925da91e1b2258333c2dbf0bc1732b", "thumbnail_srcset": "https://si.imgix.net/28b2980a/uploads/origins/8c43e60a-e234-4ec3-bb57-811d458c48b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee925da91e1b2258333c2dbf0bc1732b, https://si.imgix.net/28b2980a/uploads/origins/8c43e60a-e234-4ec3-bb57-811d458c48b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6160dc63cb430b6e14a61bc8c0e4e97e 2x, https://si.imgix.net/28b2980a/uploads/origins/8c43e60a-e234-4ec3-bb57-811d458c48b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cb239259b0b2deae5cba0a3a4bb9708 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/267", "thumbnail_src": "https://si.imgix.net/b4410bbf/uploads/origins/486e5a9e-73b4-489c-8a11-53d34cbd6cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee912d7e5d68e589fc13320eb7b32f04", "thumbnail_srcset": "https://si.imgix.net/b4410bbf/uploads/origins/486e5a9e-73b4-489c-8a11-53d34cbd6cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee912d7e5d68e589fc13320eb7b32f04, https://si.imgix.net/b4410bbf/uploads/origins/486e5a9e-73b4-489c-8a11-53d34cbd6cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7acfba482a10969966b2bc1b74fef343 2x, https://si.imgix.net/b4410bbf/uploads/origins/486e5a9e-73b4-489c-8a11-53d34cbd6cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8e798f5da810917eea9b8b7e758a088 3x", "genre": "art", "nsfw": true, "body": "久しぶりの依頼になります。\n\n以前リクエストしました\n（　https://skeb.jp/requests/1028199　）\n（　https://skeb.jp/requests/1123238　）\nの続きとなる内容をお願い出来ればと思います。\n\n「対魔忍シリーズ」の「大人ゆきかぜ」が自害する所をリクエスト出来ますか。\n\n※資料URLのリンク先はGoogleフォトです。\n\n基本絵＋差分絵をお願い致します。\n\n\n＜基本絵＞\n手刀を胸に突き刺し、自分の心臓を握った所。\n顔は無表情がちょっと歪んだ位です。\n\n＜差分絵＞\n自分の心臓を握りつぶした所。\n顔は（　https://www.pixiv.net/artworks/124026538　）の一枚目の金剛のような苦悶の表情です。\n口から血を吐いています。\n\n＜共通＞\nコスチュームの破れは胸のみ（最小限）です。\n膝から上辺りを描写頂ければと思います。（金額が足りなければ再送願います）\n\n\n以上になります。\n\nご検討頂ければ幸いです。\n\nhttps://photos.app.goo.gl/DHpDwTVMGQ4JM6KN6", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/266", "thumbnail_src": "https://si.imgix.net/92b040d2/uploads/origins/62eb5b7e-73f2-4356-8ee0-64d20b5496eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecd554f2c5418ce9bfbd1f31c66ca9c9", "thumbnail_srcset": "https://si.imgix.net/92b040d2/uploads/origins/62eb5b7e-73f2-4356-8ee0-64d20b5496eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecd554f2c5418ce9bfbd1f31c66ca9c9, https://si.imgix.net/92b040d2/uploads/origins/62eb5b7e-73f2-4356-8ee0-64d20b5496eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=889d10be90fe3e09809d2b2ff55b7bd0 2x, https://si.imgix.net/92b040d2/uploads/origins/62eb5b7e-73f2-4356-8ee0-64d20b5496eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8c2aa203fa035253bb13e406388e81b 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/265", "thumbnail_src": "https://si.imgix.net/df39403e/uploads/origins/486dbe84-d45e-4ae9-abe2-b9d7340a0252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=929cbd85b0737f50c9eef028ff1c8a1b", "thumbnail_srcset": "https://si.imgix.net/df39403e/uploads/origins/486dbe84-d45e-4ae9-abe2-b9d7340a0252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=929cbd85b0737f50c9eef028ff1c8a1b, https://si.imgix.net/df39403e/uploads/origins/486dbe84-d45e-4ae9-abe2-b9d7340a0252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a864f9946155a33ece2d0bf462b11364 2x, https://si.imgix.net/df39403e/uploads/origins/486dbe84-d45e-4ae9-abe2-b9d7340a0252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a78a9ef6590d53abfd362d9cd805fe 3x", "genre": "art", "nsfw": true, "body": "キャラ]\n私のPSO2キャラクター\n[シチュ]    敗敗北剥製\n[コスチューム] 全裸\n[内容]\n通行人が観察できるように公共エリアに設置\n彼女の体は剥製として展示されボディは無傷、子宮や尻子玉その他の臓器などのボディパーツが体の横に表示され\n\n淫らな体勢にされて、一般の人が彼女の臓器や体を弄ることができる。\n\n看板には彼女が犯罪者であることなどが書かれていますが、これは彼女が新しいタイプの半人前や怪物であることや、他の理由によるものである可能性もあります。\n彼女の横には衣装や武器が展示され、\n\nhttps://drive.google.com/file/d/1hJ8Fl7h0Ng-6qtogIUi2fwUW61QW-BSm/view?usp=sharing\n\nhttps://drive.google.com/file/d/1_o_j17n4FPBgS_u5ZoFFjOPq7UkgJxCh/view?usp=sharing\n\nhttps://drive.google.com/drive/folders/1vUOxxzr6bK6D1fQgUQ3ZQ_GTPqJG1WFN?usp=sharing\n\nhttps://drive.google.com/file/d/1C4XeoVCNyHtlL2XCPAos_Cr7Ht1n0OiG/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/264", "thumbnail_src": "https://si.imgix.net/1bf3b993/uploads/origins/0f646c64-da5e-473a-b474-86c13fe918c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0810dd5493ebf097fef3d4840fd1a050", "thumbnail_srcset": "https://si.imgix.net/1bf3b993/uploads/origins/0f646c64-da5e-473a-b474-86c13fe918c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0810dd5493ebf097fef3d4840fd1a050, https://si.imgix.net/1bf3b993/uploads/origins/0f646c64-da5e-473a-b474-86c13fe918c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55cc11d95ac42da46ad4c7fe8e0297a2 2x, https://si.imgix.net/1bf3b993/uploads/origins/0f646c64-da5e-473a-b474-86c13fe918c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4a82074310af60167a1ee07b74318de 3x", "genre": "art", "nsfw": true, "body": "リベサガの踊り子、ネレイド、イーリスの真っ二つ討伐をお願いします。\n1枚絵→エフェクト→ズレる→真っ二つで。\n狩りの獲物を見つけ、嘲笑いながら追い詰めるも返り討ちに会うのをイメージしています。", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/263", "thumbnail_src": "https://si.imgix.net/5ddbfbad/uploads/origins/7d7a54c1-9e11-48e7-af13-17a162f8ae4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bea136608d887b1360f65d0e5237e037", "thumbnail_srcset": "https://si.imgix.net/5ddbfbad/uploads/origins/7d7a54c1-9e11-48e7-af13-17a162f8ae4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bea136608d887b1360f65d0e5237e037, https://si.imgix.net/5ddbfbad/uploads/origins/7d7a54c1-9e11-48e7-af13-17a162f8ae4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a096c974bb3945ef909fa05e1d9f06b 2x, https://si.imgix.net/5ddbfbad/uploads/origins/7d7a54c1-9e11-48e7-af13-17a162f8ae4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6b8f7eeb5c5900c9ce6c2ac46fc5659 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/262", "thumbnail_src": "https://si.imgix.net/7cba1c63/uploads/origins/6f33db30-1ebc-4a89-8485-7d6aa04b7048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311052df76ec73ac843c78d05e1c34d2", "thumbnail_srcset": "https://si.imgix.net/7cba1c63/uploads/origins/6f33db30-1ebc-4a89-8485-7d6aa04b7048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311052df76ec73ac843c78d05e1c34d2, https://si.imgix.net/7cba1c63/uploads/origins/6f33db30-1ebc-4a89-8485-7d6aa04b7048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c180b87b179d8ffd2631be555c26bff4 2x, https://si.imgix.net/7cba1c63/uploads/origins/6f33db30-1ebc-4a89-8485-7d6aa04b7048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acb1d3328d27f70a1604e82e4bb77d5f 3x", "genre": "art", "nsfw": true, "body": "転スラのウルティマとスターレイルのトパーズ(カブは無し)のイラストをお願いします。\n\nウルティマ(https://img2.animatetimes.com/2022/12/edae168c93fc7cec9594cb21f050359063887cbb784257_44572932_abb5ac314b0dbe068bb046926e6619e827e0f96d.jpg)\nトパーズ(https://wiki.hoyolab.com/m/hsr/entry/1389)\n\n2人の戦闘後のイラストで、トパーズがウルティマに敗北した状況です。\n\n\nトパーズは全身ボロボロで口元から血を流し、茨触手(ウルティマのURLにあるもの)に絡みつかれ拘束されています。\nウルティマに片手で首を絞めつけられて、苦痛に顔を歪ませつつも睨み返しますが、抵抗する術もなく喘ぐことしか出来ません。\nウルティマはトパーズの生殺与奪の権利を得て、自らの手で首を絞める感触を愉しんでいます。\n\nやがてトパーズを弄ぶことに飽きたウルティマは、もう片方の手に魔力で毒を纏わせ貫手で腹部を貫きます(突き刺した所からの流血は無しでもOKです)\nトパーズは体を貫かれて吐血し、猛毒によって体を蝕まれて目から光が消えていきます。", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/261", "thumbnail_src": "https://si.imgix.net/5e2ad721/uploads/origins/c02271e9-bdcf-4111-babe-53baf3c2ed44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=230ca4a0e655d9bc40bd62dc6b87074b", "thumbnail_srcset": "https://si.imgix.net/5e2ad721/uploads/origins/c02271e9-bdcf-4111-babe-53baf3c2ed44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=230ca4a0e655d9bc40bd62dc6b87074b, https://si.imgix.net/5e2ad721/uploads/origins/c02271e9-bdcf-4111-babe-53baf3c2ed44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6c1660cd0079687da6f13716a2cd185 2x, https://si.imgix.net/5e2ad721/uploads/origins/c02271e9-bdcf-4111-babe-53baf3c2ed44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aed35c808e1123b6921b7adac1cc6e4e 3x", "genre": "art", "nsfw": true, "body": "再びこんにちは。前回のリクエストに応えてくれてありがとう。とてもよくできていました。今回はゼノブレイド2のヒカリのイラストを提案させていただきます。\n\nhttps://static.wikia.nocookie.net/p__/images/2/2b/Mythra.png/revision/latest?cb=20180517124742&path-prefix=protagonist\n\nダンジョンで完全にバラバラにされて忘れ去られたヒカリのバッドエンドシナリオを描いていただけませんか？\n\n- 胴体がバラバラにされて串刺しにされる\n\n- 手足は一本一本ロープで吊るされ、胴体の近くに吊るされる\n\n- 首を切られた頭部は、涙目で口を開けた表情で髪を吊るされ、他の胴体の近くに配置される。\n\n結った髪はこのイラストのようにしたい：\nhttps://wimg.rule34.xxx//samples/1524/sample_522a33f8e70181e69397b9f3a324ee8b27092d85.jpg?11946312\n\n胸のコアクリスタルを忘れないでください。\n\nもしバリアントが許されるなら、彼女の目玉をえぐったものが欲しいです。\n\nいつもありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@siruzakura/works/260", "thumbnail_src": "https://si.imgix.net/cc0bb83e/uploads/origins/954f72bd-bcbf-4c66-9cdb-49c2f35c931a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72aa618b29e1f6780c79300139f2956a", "thumbnail_srcset": "https://si.imgix.net/cc0bb83e/uploads/origins/954f72bd-bcbf-4c66-9cdb-49c2f35c931a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop