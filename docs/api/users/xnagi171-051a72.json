34f855b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27bef242534934e08b392d7e87475966 2x, https://si.imgix.net/0a903d64/uploads/origins/aeffd0c9-fff1-4c2b-b81a-0a5e34f855b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92153279e1025560d0ef1544d2ef3737 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\nまた自キャラの変化絵をお願いします。\n\n今回は異世界に迷い込んだうちの子が偶然居合わせた\n凪砂さん宅の小凪ちゃんに変化させられて遊ばれるというシチュエーションでお願いします。\n\n変化内容は4つで\n・正方形に横平面化させて折り紙にして遊ぶ(折り鶴や紙飛行機等書きやすい物2種程度でお願いします)\n\n・その後元に戻るが怯んでいる間に球体化させて手毬代わりにして遊ぶ(球体化の型はお任せします。)\n\n・コロコロ転がったすきに元に戻れて逃げようとするが上から重いものが落ちてきて縦平面化。そこを見つかって尻尾をもって振り子のようにされてしまう。\n\n・最後に[閉じ込めの壺]というアイテムを使われて壺に閉じ込められた後,閉じ込めの壺を割ってみると壺化してしまったうちの子が出てくる。眺めていると神琴ちゃんに見つかって怒られて\n壺から戻るまで神棚に置かれて保管される(形はお任せします。)\n\n的な変化内容でお願いできますでしょうか。\n\n自キャラ資料\n[https://photos.app.goo.gl/MkJ9rMakQ2ksoxzW7]\n(パンツは白に黒いレースの少し大人な感じ)\nキャラ設定は資料に入れておりますのでご確認ください。\n表情としてはびっくりしてたり恥ずかしがってたり少し怒ってたりしてる感じでお願いします。\n\n長くなりましたが以上よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@xnagi171/works/28", "thumbnail_src": "https://si.imgix.net/5d67889c/uploads/origins/9db6eb62-f4fe-44d2-afae-8ffd09ce58e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aea3d26728f5defd28ca4b1deac4727f", "thumbnail_srcset": "https://si.imgix.net/5d67889c/uploads/origins/9db6eb62-f4fe-44d2-afae-8ffd09ce58e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aea3d26728f5defd28ca4b1deac4727f, https://si.imgix.net/5d67889c/uploads/origins/9db6eb62-f4fe-44d2-afae-8ffd09ce58e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95464a6f0eb608d7732abde3bdc35900 2x, https://si.imgix.net/5d67889c/uploads/origins/9db6eb62-f4fe-44d2-afae-8ffd09ce58e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b68bde15f085648dca8f05fa4f057c2f 3x", "genre": "art", "nsfw": false, "body": "ホロライブのさくらみこさん(https://twitter.com/ordan/status/1368185674889719809?s=20&t=py-dvGpMIu9wmvDubGfUlg)と、星街すいせいさん(https://twitter.com/saekiyahiro/status/1450452446849814529?s=20&t=HabkZFMgQ_PXrsHv8Hn12w)の箱化イラストをお願いいたします。\n\n服装については、みこさんは資料一番左の私服で、すいせいさんは資料真ん中のカーディガンでお願いいたします。\n箱化のシチュエーションについて、可能であれば2人一緒の箱型に圧縮されていると嬉しいですが、難しいようであれば別々の箱でも構わないです。\n以前描かれていたフレアさんの箱化のように窮屈そうな体勢であると嬉しいです。\n表情については、すいせいさんが赤面顔で、みこさんが涙目でお願いいたします。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@xnagi171/works/27", "thumbnail_src": "https://si.imgix.net/e0404a2f/uploads/origins/48ec6534-f828-4b5a-8a06-fa07699863a0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=218c58a5a84fbb12df04085f508266c7", "thumbnail_srcset": "https://si.imgix.net/e0404a2f/uploads/origins/48ec6534-f828-4b5a-8a06-fa07699863a0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=218c58a5a84fbb12df04085f508266c7, https://si.imgix.net/e0404a2f/uploads/origins/48ec6534-f828-4b5a-8a06-fa07699863a0?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eb3305149f81656a4646b3ee409622e 2x, https://si.imgix.net/e0404a2f/uploads/origins/48ec6534-f828-4b5a-8a06-fa07699863a0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=280f77ca7e0d53ccaab6eaf404ee9cf1 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\nまた自キャラの変化絵をお願いします。\n\n今回は転がってきた岩に轢かれてしまい横平面化。その後岩に張り付いてしまい岩と一緒にごろごろ転がって行ってしまう。\nこんなシチュエーションでお願いします。\n\n自キャラ資料\n[https://photos.app.goo.gl/qYDsxuNkCLNvR3vT8]\n表情としては恥ずかしくて赤面して涙目な感じでお願いします。\nまた少し焦ってる様子もいれてくださると何よりです。\n\nまた前回の依頼のムービーがとてもよかったので可能であればお願いしたいです。金額的に不可ならなしでもokです。\n\n以上よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@xnagi171/works/26", "thumbnail_src": "https://si.imgix.net/7d2bdf39/uploads/origins/fb90fa0d-0f07-43a2-9986-8db4b1b19099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c777cae0ceadac6393d4198bd201306", "thumbnail_srcset": "https://si.imgix.net/7d2bdf39/uploads/origins/fb90fa0d-0f07-43a2-9986-8db4b1b19099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&