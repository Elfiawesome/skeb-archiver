e604c590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab168fd147ba3e334647f16f7c5310f, https://si.imgix.net/25a802e3/uploads/origins/1d05afb7-71cc-4cd9-94dc-246ae604c590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=121cc04b2027ddbe03d92c249dedb2fb 2x, https://si.imgix.net/25a802e3/uploads/origins/1d05afb7-71cc-4cd9-94dc-246ae604c590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2c529c1cb59529c382e474bcef07170 3x", "genre": "art", "nsfw": true, "body": "お世話になります\n神羅万象のベリルをお願いしたいです。\nフロリーナやミナのような蹲踞で両胸はだけ＆腋見せポーズをベースに\n槍や斧を股間にあてがわれて怯え失禁のイラストをお願いしたいです。\nホットパンツは大きく前が開いてぴっちりとフィットしたパンツのような描写でお願いします。\n\n\n差分で\n通常蹲踞→股間に武器→失禁　\nにらみ顔→怯え顔→哀願（泣き顔）\nズボンＯＦＦ　通常すじ→具（クリ）勃起状態\n陰毛腋毛の有り無し\nセリフ付きの場合はＯＮＯＦＦができると嬉しいです\n\n可能なら修正は線でお願いいたします。\n宜しくお願いいたします。\n\nhttps://x.com/PIPUMINEKOSANTA/status/1992146598839861700/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/44", "thumbnail_src": "https://si.imgix.net/4f3f90d5/uploads/origins/f4bc10d0-9f4a-4e0f-8ac6-21337925fb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6112df16341d1eeca1dc1aa13856b61f", "thumbnail_srcset": "https://si.imgix.net/4f3f90d5/uploads/origins/f4bc10d0-9f4a-4e0f-8ac6-21337925fb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6112df16341d1eeca1dc1aa13856b61f, https://si.imgix.net/4f3f90d5/uploads/origins/f4bc10d0-9f4a-4e0f-8ac6-21337925fb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8a8baf7da463d7be561f2b35cf0da98 2x, https://si.imgix.net/4f3f90d5/uploads/origins/f4bc10d0-9f4a-4e0f-8ac6-21337925fb5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f68fbbefee6ff8f466e4ca76e7587a6c 3x", "genre": "art", "nsfw": true, "body": "先生！いつもお世話になります。\n今回も1枚お願いできればありがたいです。\n\n今回お願いしたいのは『東島丹三郎は仮面ライダーになりたい』と言う作品に登場する\n『電波人間タックル(自称) 岡田ユリコ』をお願い出来ますでしょうか。\n\n怪人に敗れて、エッチな目にあっているタックルをお願いできますでしょうか。\n\nご検討頂けたらありがたいです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/43", "thumbnail_src": "https://si.imgix.net/03914f26/uploads/origins/03c78137-43d7-4a77-964e-05aed6d3355e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea2ba54035310cc805eab88eaffaff66", "thumbnail_srcset": "https://si.imgix.net/03914f26/uploads/origins/03c78137-43d7-4a77-964e-05aed6d3355e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea2ba54035310cc805eab88eaffaff66, https://si.imgix.net/03914f26/uploads/origins/03c78137-43d7-4a77-964e-05aed6d3355e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09aef1962767a43eda88606459d5bac0 2x, https://si.imgix.net/03914f26/uploads/origins/03c78137-43d7-4a77-964e-05aed6d3355e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c83feae7ff65e2b3523f81673774e68 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ガヴィアル（アークナイツ）のコミッションを作りたいです。\n足フェチがテーマの依頼なので、彼女の大きくて蒸れた足の裏と、履き古したサンダル（汗で足の跡がついたもの）を見たいんだ。彼女はクールな部族の女の子で、強く、自信に満ちていて、細かいことは気にしない。だから、休憩中に履き古したサンダルを脱ぐことも気にしない。彼女の履き古したサンダルの汗ばんだ足の跡も描いてほしい。\nキャラクターリファレンス：https://drive.google.com/drive/folders/1yXmcOQZ77Myhqm8E2ObaoVMGtld-wnpm?usp=drive_link\n注：00_official settingは彼女のゲーム内での公式設定、その他は私の他の依頼によるものです。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/42", "thumbnail_src": "https://si.imgix.net/191e99da/uploads/origins/e3f799f0-6d2b-4f89-a7e8-765bdad79eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e62db1e00bc6fd24140afe0150149a2", "thumbnail_srcset": "https://si.imgix.net/191e99da/uploads/origins/e3f799f0-6d2b-4f89-a7e8-765bdad79eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e62db1e00bc6fd24140afe0150149a2, https://si.imgix.net/191e99da/uploads/origins/e3f799f0-6d2b-4f89-a7e8-765bdad79eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4da86a05b40821baa9eeab1c6708e0f9 2x, https://si.imgix.net/191e99da/uploads/origins/e3f799f0-6d2b-4f89-a7e8-765bdad79eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=944a020ac9f620e644b8570042af8aeb 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしいイラストありがとうございます。\nまた一枚お願いできればと思いご依頼させていただきました。\nご検討いただけましたら幸いです。\n\n書いていただきたいのは蒼穹のファフナーの羽佐間カノンこと、カノン・メンフィスです。\n以前描かれていた同人誌のように、敵の捕虜になり、シナジェティックスーツを破られエッチな尋問を受けているようなイラストをよろしくお願い致します。\n\nご検討いただきましたら幸いです。\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/41", "thumbnail_src": "https://si.imgix.net/070ffc46/uploads/origins/88fcc0fb-c781-4eb9-a9a2-22af1f4db51a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1a854efbe680b770e608af0e46e5ffa", "thumbnail_srcset": "https://si.imgix.net/070ffc46/uploads/origins/88fcc0fb-c781-4eb9-a9a2-22af1f4db51a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1a854efbe680b770e608af0e46e5ffa, https://si.imgix.net/070ffc46/uploads/origins/88fcc0fb-c781-4eb9-a9a2-22af1f4db51a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d4e5dd95f1186e6aa60dfc17e296aa2 2x, https://si.imgix.net/070ffc46/uploads/origins/88fcc0fb-c781-4eb9-a9a2-22af1f4db51a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c09644ad2c16494d3157ad32e743031 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/40", "thumbnail_src": "https://si.imgix.net/48751152/uploads/origins/d3e5e8a6-5c87-4fef-8c43-41988b1503f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d148a23f27674c2ee8ab4ca62fa38410", "thumbnail_srcset": "https://si.imgix.net/48751152/uploads/origins/d3e5e8a6-5c87-4fef-8c43-41988b1503f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d148a23f27674c2ee8ab4ca62fa38410, https://si.imgix.net/48751152/uploads/origins/d3e5e8a6-5c87-4fef-8c43-41988b1503f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8e152d4667afeb067db48a20b86c5b8 2x, https://si.imgix.net/48751152/uploads/origins/d3e5e8a6-5c87-4fef-8c43-41988b1503f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22916e2b00e01d0ff494e31fa4dd6385 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\nリクエストお願いします\n\nサムライスピリッツから\n真鏡名ミナをお願いしたいです\nデザインは眼帯のない初期デザインを希望します。\n\n敗北後　\n強制エロ蹲踞（開脚ポーズ）のイラストをお願いしたいです\nhttps://www.pixiv.net/artworks/37501538　レベッカ\nのようなポーズをお願いしたいです。\n両胸は露出状態で、乳首は立ち気味でお願いします。\n下半身は全裸で　恥部（すじ）が見える状態でお願いします。\n戦闘後なので、体は若干の傷、出血ありで、汗は多めでお願いします。\n\n\nこれをベースに差分で\n\n表情\n\nキッと睨みつけ\n↓\n歯を鳴らして怯え\n↓\n命乞い泣き顔\n\n性器\n\nすじ\n↓\nレベッカイラストのようにすじに沿って槍のような武器を這わせる\n↓\nクリ勃起状態で具チラ\n↓\n失禁\n\n陰毛\nあり（濃いめ）\nなし\n\nをお願いします。\n\n\n可能でしたら修正は黒線修正でお願いいたします\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/39", "thumbnail_src": "https://si.imgix.net/e46a48af/uploads/origins/96304029-e3e7-4bbe-88d5-96536fcf9690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f62ca3e2a6bc34a695353e1ddd82f8e", "thumbnail_srcset": "https://si.imgix.net/e46a48af/uploads/origins/96304029-e3e7-4bbe-88d5-96536fcf9690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f62ca3e2a6bc34a695353e1ddd82f8e, https://si.imgix.net/e46a48af/uploads/origins/96304029-e3e7-4bbe-88d5-96536fcf9690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b128b33871efcfc8ecf4a94b8f472262 2x, https://si.imgix.net/e46a48af/uploads/origins/96304029-e3e7-4bbe-88d5-96536fcf9690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d5c4fc230cf63ed61c0c73f4b5f2f90 3x", "genre": "art", "nsfw": true, "body": "初めまして。こんにちは。\nリクエストさせていただきます。\n\nキャラクター：コードギアス反逆のルルーシュ　ミレイ・アッシュフォード（ボロボロのアッシュフォード学園制服）\n\nシチュエーション：\n黒の騎士団の捕虜となりに囚われたミレイ・アッシュフォード\n尻上げ土下座、顔は上げた状態で、涙・鼻水垂らしながら命乞い謝罪しつつ\n団員のキモガリおっさん一人（日本人・眼鏡無し）にバックで犯され\nおじ様専用の孕み、肉便器奴隷になります！と絶叫し乳首ビンビンに勃起し\nアヘ顔・晒しながら種付け（※受精カットイン）され\n最後は命が助かった喜びからヘラヘラと情けなく笑いながら\nお礼ともう一発いかがでしょうか？とお伺いを立てる。\n\n以上、ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/38", "thumbnail_src": "https://si.imgix.net/0b14ac48/uploads/origins/21e716f7-d27d-449d-9bed-6182f1bc92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aea8b23896197fabd33308906069724b", "thumbnail_srcset": "https://si.imgix.net/0b14ac48/uploads/origins/21e716f7-d27d-449d-9bed-6182f1bc92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aea8b23896197fabd33308906069724b, https://si.imgix.net/0b14ac48/uploads/origins/21e716f7-d27d-449d-9bed-6182f1bc92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=779a9e412650accca74b49b25e84a0ac 2x, https://si.imgix.net/0b14ac48/uploads/origins/21e716f7-d27d-449d-9bed-6182f1bc92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eebb7e9cfe8ebd0066eddcc67a6a5cd9 3x", "genre": "art", "nsfw": true, "body": "初めまして！\nもしよろしければ以下の内容でリクエストさせて下さい。\n\nキャラクター：ロゥリィ・マーキュリー（GATE）\nhttps://gate.fandom.com/wiki/Rory_Mercury/Gallery\n\nシチュエーション：敵軍に捕まり拘束、コロされた仲間の報復とばかりに敵兵に凌辱される\n\n料金的に問題なければ下記２差分をお願いしたく\n\n①鎖か縄で縛り上げ拘束されレイプされるも気丈に振舞っている\n②局部に自身の武器であるハルバードの柄を突っ込まれてかき回され、ついに堕ちる\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/37", "thumbnail_src": "https://si.imgix.net/68774a58/uploads/origins/b30324f2-9372-421b-827a-2cff3148c987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17438411469da7b95400ec178bc6bcc4", "thumbnail_srcset": "https://si.imgix.net/68774a58/uploads/origins/b30324f2-9372-421b-827a-2cff3148c987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17438411469da7b95400ec178bc6bcc4, https://si.imgix.net/68774a58/uploads/origins/b30324f2-9372-421b-827a-2cff3148c987?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a70b61f85c996c7111280bf1d5ae75f9 2x, https://si.imgix.net/68774a58/uploads/origins/b30324f2-9372-421b-827a-2cff3148c987?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48ea569d08caad3def88d12d1ee696f7 3x", "genre": "art", "nsfw": true, "body": "以前、一度書いていただいたキャラの再リクエストさせていただきます。\nこの度は私のオリキャラのラビアをお願いします。\nhttps://twitter.com/yukimichi5656/status/1725499053033800116\n・性格はおっとり系です。\n最初は腋毛と陰毛を剛毛にしていただき、調教後は両方ともジョリ跡にしていただければと思います。\n\nシチュエーションは\n拘束され絶頂できないまま調教されている状態から絶頂懇願しているラビアの乳首やクリなどにピアスをブッ刺し、下腹部に卑猥な文字の焼印(文字はお任せします。)を押すシーン\nその後、涙を流しながらアヘ顔絶頂するシーンを描いていただけると幸いです。セリフやポーズなどはお任せいたします。\n\n可能であれば鼻フックの装着の差分があればありがたいです。難しければ、無くても大丈夫です。\n大変注文が多くて申し訳ありませんが、何卒ご検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/36", "thumbnail_src": "https://si.imgix.net/3cfa9369/uploads/origins/29e668f8-8516-490f-8801-545c696f487f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=482ada1728813fb984f2266eeea994db", "thumbnail_srcset": "https://si.imgix.net/3cfa9369/uploads/origins/29e668f8-8516-490f-8801-545c696f487f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=482ada1728813fb984f2266eeea994db, https://si.imgix.net/3cfa9369/uploads/origins/29e668f8-8516-490f-8801-545c696f487f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42c9532681209eede5c3bea7cc2ba36b 2x, https://si.imgix.net/3cfa9369/uploads/origins/29e668f8-8516-490f-8801-545c696f487f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e250c49a9da9e4cb05c23374d7b7324d 3x", "genre": "art", "nsfw": true, "body": "以前ルーとエルにレズ調教されるエマ中尉を描いていただいた際、一晩中ルーのアナルを舐めていたという一文が素敵でしたので、そちらの光景を描いていただきたいです。\nエマ中尉は陰毛、腋毛が生え茂ってる状態でお願いします。\n\nエマ中尉はルーが尻肉を掌と押し広げてアナル見せしてる所を夢中になってむしゃぶりついており、こちら側に下品なガニ股なって尻を見せているようにお願いします。\nエマ中尉のマンコにはバイブ(抜けて落としたらお仕置きとルーとエルに躾けられている)が突き刺さっており、アナルにはエルが拳大のアナルパールを次々詰め込んでおり、「どんどん飲み込んでいくじゃん、やっばぁｗ」と煽っているようにお願いします。\n\nまた、差分でエルが勢いよくアナルパールを引き抜き、エマ中尉がアヘ顔を浮かべ潮を噴き出しながらバイブを噴射し、思い切り絶頂している姿を見てケラケラ笑うエルと、ルーへのアナル舐めが疎かになったので口汚く叱責しながらエマ中尉の頭を掴んでアナルに押し付けている差分と、\nバイブを落としたお仕置きとして、エルがアナルとマンコに次々と何本もバイブを刺しこみ、ルーはエマ中尉の乳首をつねって思い切り引っ張りながら「鳴け、メスブタ！」と罵っている差分をよろしくお願い致します。\n\n以上、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/35", "thumbnail_src": "https://si.imgix.net/e9b9a7bc/uploads/origins/0e237c48-6245-444c-b39b-ee760166f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b9685804686eb00669771d1f2e86522", "thumbnail_srcset": "https://si.imgix.net/e9b9a7bc/uploads/origins/0e237c48-6245-444c-b39b-ee760166f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b9685804686eb00669771d1f2e86522, https://si.imgix.net/e9b9a7bc/uploads/origins/0e237c48-6245-444c-b39b-ee760166f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55d2cffe6b2574eada98ae823dba536d 2x, https://si.imgix.net/e9b9a7bc/uploads/origins/0e237c48-6245-444c-b39b-ee760166f1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddf81fe7b49b50773d8a74416fb7ee0d 3x", "genre": "art", "nsfw": true, "body": "初めまして。臭いフェチシチュのイラストを見て大変そそられたのでよろしければリクエストお願いします。\n悲鳴-地下室に囚われた11人-より小島純那で強制エロ蹲踞開脚ポーズで汗で蒸れている状態で臭いを嗅がれることに対し嫌な表情をしているのをベースに媚薬を飲まされ放置される、その後彼氏が助けに来てイチャラブ挿入。最初は臭いを嗅がれることを嫌がり抵抗するも途中からイチャラブになるイメージでお願いします。\n設定としては地下室に監禁され、媚薬を飲まされ悶えてていたが、彼氏に助けられてイチャラブに発展するイメージです。純那の腋や膣部の毛は監禁されており、少し生えている感じで。\n・容姿は最初はバスケ部衣装（下はパンツのみ）で→媚薬を飲まされる際は服がたくし上げブラが見える状態→\nその後睨むような表情で悶え始める→彼氏に助けられ、ずらし挿入＆オホ顔絶頂（可能であれば全裸）でお願いします。\n・セリフも可能であればお願いします。\n・竿役は描かなくて良いです。可能であれば「あーし、あいつらに捕まって3日風呂入ってないし臭うから嗅がないで」みたいなセリフを可能であればお願いします。\n以上になりますが困難であればおまかせでシチュ（できれば臭い関連）や構図に変更して構いませんのでご検討お願いします。\n\nhttps://drive.google.com/file/d/1hC2Dw-cvjBtOfddFK4_6Vq3crbeh39AA/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/34", "thumbnail_src": "https://si.imgix.net/c1823500/uploads/origins/1b95146c-3869-49d4-a510-05555ac09db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=257b9cef0cf72122f57811be02ed3fb4", "thumbnail_srcset": "https://si.imgix.net/c1823500/uploads/origins/1b95146c-3869-49d4-a510-05555ac09db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=257b9cef0cf72122f57811be02ed3fb4, https://si.imgix.net/c1823500/uploads/origins/1b95146c-3869-49d4-a510-05555ac09db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dc305ee42f74079dc16acfc99828f9f 2x, https://si.imgix.net/c1823500/uploads/origins/1b95146c-3869-49d4-a510-05555ac09db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d7a52f830c92c7be7e203795c0be8b3 3x", "genre": "art", "nsfw": true, "body": "はじめまして、pixivやTwitterにあげている絵を拝見してあたなの描く表情が好みでしたのでSkebの再開を待っていました。\n\nキャラクター:佐倉双葉(ペルソナ5)のイラストをリクエストしたいです。\n\nシチュエーション ：怪盗団に賞金がかけられた状態で男子トイレに拉致され、換金する前にやられてしまう。という内容になります。\n\n格好 ：全裸、メガネあり\n \n全裸で男子小便器に既に嬲られた状態で座らされています。\nメガネにはヒビが入っている、胸、腹や太ももにも殴られた後や踏まれた跡(足形)、タバコを押し付けられたり、腹パン、首絞めックス、強めの平手打ち、泣き叫び、命乞いをしているさまが見たいです。\n金額的に可能なら体に小便をかけている差分などあればありがたいです。\n\n上記のような内容が希望ですが、セリフや描写などおまかせいたします。\n 血とか吐瀉物の描写があっても大丈夫です。  \n\n以上、もしよろしければ、ご一考頂きたく思います。 \nよろしくお願い致します。\n\n\n \n\n注文が多くて申し訳ありませんが、何卒ご検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/33", "thumbnail_src": "https://si.imgix.net/be9c9f3b/uploads/origins/79743c0b-5b7a-4cd4-878b-8512a80de833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98540cc8441816bec2059e30a4793b4", "thumbnail_srcset": "https://si.imgix.net/be9c9f3b/uploads/origins/79743c0b-5b7a-4cd4-878b-8512a80de833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98540cc8441816bec2059e30a4793b4, https://si.imgix.net/be9c9f3b/uploads/origins/79743c0b-5b7a-4cd4-878b-8512a80de833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68711b6d61d766683be903551f457ed4 2x, https://si.imgix.net/be9c9f3b/uploads/origins/79743c0b-5b7a-4cd4-878b-8512a80de833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26ced3c5dffcbc6b48d2d1b319de53d0 3x", "genre": "art", "nsfw": true, "body": "先生！！いつもお世話になります！\n前回はご厚意で素晴らしい皐月様を見せていただいて誠にありがとうございました！\n大変良いものを見せていただきました。\n\nまた依頼を再開されたとのことですので、一枚お願い出来れば幸いです！\n今回お願いしたいキャラクターは『幼女戦記』に登場する『ターニャ・デグレチャフ』になります。\n敵軍に捕縛され厳しい責めを受けている感じでお願い出来たら幸いです！\n\n普段描かれていないキャラだとは思いますが、可能でしたらお願いできたら幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/32", "thumbnail_src": "https://si.imgix.net/f76bd580/uploads/origins/262b339e-fffb-4c75-bfd3-8599250f9bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=290b84fb7812adffb8400f889bbdfd04", "thumbnail_srcset": "https://si.imgix.net/f76bd580/uploads/origins/262b339e-fffb-4c75-bfd3-8599250f9bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=290b84fb7812adffb8400f889bbdfd04, https://si.imgix.net/f76bd580/uploads/origins/262b339e-fffb-4c75-bfd3-8599250f9bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2727d438cbc9bebb7bd3f549f14d026 2x, https://si.imgix.net/f76bd580/uploads/origins/262b339e-fffb-4c75-bfd3-8599250f9bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3ea01bbb82f90020fb342a8f23aacf8 3x", "genre": "art", "nsfw": true, "body": "ガンダムZZのイリア・パゾムを以下のような形でお願いいたします。\n\n・上半身はチューブトップが下にずれて胸が露出している以外は服はそのままでお願いします\n・下半身はスカートとパンティが脱げて股間が露出している状態でお願いします（足の描写があればブーツもそのままでお願いします）。\n・イリアが激しく犯されているシチュでお願いします（構図などはお任せいたします）\n・もし可能であれば、挿入される前のくっとした状態や激しく犯されてアヘっている状態、絶頂の状態、射精された後などの表情含めた差分を作っていただけるとうれしいです\n\nこれ以外につきましてはお任せいたします\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/31", "thumbnail_src": "https://si.imgix.net/0fd586a1/uploads/origins/5ff75868-a357-43ca-b1ce-6446aed90718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a5521197934376ce5b9839dc4596c2e", "thumbnail_srcset": "https://si.imgix.net/0fd586a1/uploads/origins/5ff75868-a357-43ca-b1ce-6446aed90718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a5521197934376ce5b9839dc4596c2e, https://si.imgix.net/0fd586a1/uploads/origins/5ff75868-a357-43ca-b1ce-6446aed90718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3e650b1351633f72d68f01335c805dd 2x, https://si.imgix.net/0fd586a1/uploads/origins/5ff75868-a357-43ca-b1ce-6446aed90718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26c194b277aaf70d003e0ddde8903f88 3x", "genre": "comic", "nsfw": true, "body": "お世話になります。\nペルソナ4 白鐘直斗のリクエストです。\nもしできたらモノクロで結構ですので、マンガ形式でお願いしたく…\n内容としては、拳銃で脅されてフェラ、イラマの後レイプされ、絶望している所に、約束を破られて局部に拳銃を突っ込まれて撃たれる、みたいな感じで…\n私服着用、もしよかったら眼鏡着用もお願いしたく…\n\nさらわれてテレビに放り込まれた後、気が付いたら取調室にいて、現実の世界にいると思い込んだまま、刑事達（に見えるシャドウ）に囲まれ、襲われる、みたいな想定で、\n・いきなり相手がチンポを出してしゃぶれと言ってくる　直斗一瞬怯えるが、僕は男ですよ？大勢で囲んで卑怯な、と立ち向かう→髪を掴み上げられて、女だってバレてんだよ大人舐めんな、と言われ、直斗の表情に怯えが\n・それでも抵抗して逃げようとするが、頭に拳銃を突きつけられて恐怖で動けなくなり、涙目でフェラ　最初は反抗的な目つきをしているが、下手なフェラしてたら撃つぞと言われ、必死で舌を動かす\n・やっぱ下手だなと言われ、撃たれる恐怖で顔がこわばる　男は髪を掴んで頭を固定したまま自分で動いてイラマ、喉奥射精　直斗アヘ顔で鼻からも精液を流しつつ嘔吐\n・全員満足したら無事に帰してやると言われるが、直斗は現実が信じられず、泣きながら嫌だと繰り返すので、結局暴力的にレイプ　首締めや仰向けイラマとか\n・事後、警察にレイプされてもう探偵は続けられないと泣いてる直斗、男たちがじゃあそろそろ始末するか、と直斗を押さえつけて局部に銃口を挿入　直斗は約束が違うと泣き叫ぶが、通じないとわかると必死に命乞い　舌を伸ばしてもう一度舐めようとするとかで、口を使ってもらって延命しようとするとか　\n・発砲されて子宮破壊　後日、女子用の制服を着て泣き笑いの表情やアヘ顔でレイプされる直斗がマヨナカテレビに映る　女を自覚できて良かったねみたいな放送\n\n基本的に涙とか鼻水で顔をぐちゃぐちゃにして泣き喚いている感じだとありがたいです。\n前回描いて頂いた真のように、白目剥いて気絶するけど死にはしない程度のダメージの想定ですが、死んでも大丈夫です。\n\n以上が希望の要素ですが、キャラクターのご解釈に合わせて、流れや描写など、お好きなように描いて頂ければと思います。 金額変更の再送も大丈夫です。\nもしご興味がおありでしたら是非ご一考の程、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/30", "thumbnail_src": "https://si.imgix.net/237da05c/uploads/origins/c307518d-ca34-4f3f-a66f-d51c8f8a4beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efa0dea7f9e09d1a5a339bed2a139662", "thumbnail_srcset": "https://si.imgix.net/237da05c/uploads/origins/c307518d-ca34-4f3f-a66f-d51c8f8a4beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efa0dea7f9e09d1a5a339bed2a139662, https://si.imgix.net/237da05c/uploads/origins/c307518d-ca34-4f3f-a66f-d51c8f8a4beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c892bd34a8728b2bcb058f332f9304ce 2x, https://si.imgix.net/237da05c/uploads/origins/c307518d-ca34-4f3f-a66f-d51c8f8a4beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34ee2a30b8599126afc5d64f51bbbcb6 3x", "genre": "art", "nsfw": true, "body": "ゲゲゲの鬼太郎6期15話「ずんべら霊形手術」に登場する房野きららをお願いします。\n\n○房野きらら\nお世辞にも可愛いとは言えない顔がコンプレックスの女子中学生。\n妖怪ずんべらに霊形手術を施され見違えるほどの美少女になるがそのせいで大変な目に合う。\n\n内容は原作の別ルートな形で\n顔のことで悩んでいたところ西洋妖怪インキュバスに囚われ彼好みの女だったため手篭めにされてしまうという内容になります。\n\nシチュエーションは\n・両者裸でフルネルソンの体位で嫌がり泣きながら抵抗しているきららを自分のものにしようと激しく犯すインキュバス。\n・孕ませるつもりできららの中に溢れ出るほど中出しするインキュバスと中出しの快楽に負け相手もイケメンだしもういいかと堕ちてしまうきらら。\nという内容でお願いいたします。\n\nきららは陰毛少しありでお願いします。\n\n俗に言う水木顔な女の子ですが、霊形手術前の方が好みだったためリクエストさせていただきました。\nよろしくお願いいたします。\n以下、資料になります。\n\n房野きらら\nhttps://drive.google.com/file/d/1AYJRNB-MzZ2Ph37cpZPXNi2TuKJ-s3X5/view?usp=drivesdk\nhttps://drive.google.com/file/d/1NhGPHABpxRKpiphVp24GoBsY-AKPOF8n/view?usp=drivesdk\nhttps://drive.google.com/file/d/18lvsMItBRohp37pPT9Pop4d1FXx3C8WA/view?usp=drivesdk\n\nインキュバス\nhttps://drive.google.com/file/d/1snqJ-ysGhshUbDSY3jmCRNL0LmnNhXn-/view?usp=drivesdk\nhttps://drive.google.com/file/d/1v5tz6UadFAfjVP9sluykWSbUPKO4bmvj/view?usp=drivesdk\nhttps://drive.google.com/file/d/1XAQwK1ZMKzFtLDPAZDyzP_8YQw2jGQKy/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/29", "thumbnail_src": "https://si.imgix.net/fe233c18/uploads/origins/c83840cb-0c58-4608-893f-f81a581338e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a49f8c9bcd04212e83c0172a68f1915b", "thumbnail_srcset": "https://si.imgix.net/fe233c18/uploads/origins/c83840cb-0c58-4608-893f-f81a581338e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a49f8c9bcd04212e83c0172a68f1915b, https://si.imgix.net/fe233c18/uploads/origins/c83840cb-0c58-4608-893f-f81a581338e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec36eefee70bd7f5ec53771bb0aa439 2x, https://si.imgix.net/fe233c18/uploads/origins/c83840cb-0c58-4608-893f-f81a581338e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4996b0b0a10716633427c2cf30522891 3x", "genre": "art", "nsfw": true, "body": "お世話になります\nポ○ットモンスターからヒガナをお願いしたいです。\n\n捕まって分娩台のようなものに全裸開脚腋見せポーズで拘束されたヒガナをお願いします。\n\n構図はhttps://skeb.jp/@PIPUMINEKOSANTA/works/26\nの三日月、あるいはhttps://skeb.jp/@PIPUMINEKOSANTA/works/27\n詩織2枚目のような胸からアナルあそこまで丸見えの正面構図、\n乳首はややツン立ち状態でお願いします。\n\nこれをベースに\n\n表情　\n紅潮し、内心怯えながらも余裕そうに軽口を叩いている表情\n↓\n怯え表情\n↓\n恐怖絶頂表情\n\n\n性器\n\n通常すじ　（https://skeb.jp/@PIPUMINEKOSANTA/works/13　フェアチャイルドのような修正の不要なぴっちり閉じたすじ）\n↓\nクリ（具）チラしている性器\n↓\n器具で性器くぱぁ\n↓\n電極クリップを立った乳首とクリに挟み込む\n\n\n他\n\n失禁差分\n陰毛の有無\n\n\n汗、蒸れた感じは普段描かれるイラストのようにお願いいたします。\n\nまた、修正が必要な箇所は黒線修正を希望しますが、難しいようでしたらモザイクもでOKです。\nわかりにくい部分は描きやすいように変更してくださいませ\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@PIPUMINEKOSANTA/works/28", "thumbnail_src": "https://si.imgix.net/330caeb3/uploads/origins/469e597c-55a5-43eb-9775-bc1bb5b56fee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3522de5267f7fa57d9fb23dc6ee37291", "thumbnail_srcset": "https://si.imgix.net/330caeb3/uploads/origins/469e597c-55a5-43eb-9775-bc1bb5b56fee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3522de5267f7fa57d9fb23dc6ee37291, https://si.imgix.net/330caeb3/uploads/origins/469e597c-55a5-43eb-9775-bc1bb5