32-6cf92d6c2bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f33678c27e1bb517245cb0cc9fd829, https://si.imgix.net/646fbddc/uploads/origins/5dbad484-bf8c-41ad-8832-6cf92d6c2bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f759d87161aba328d933841c808e48a 2x, https://si.imgix.net/646fbddc/uploads/origins/5dbad484-bf8c-41ad-8832-6cf92d6c2bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23c2cd3b883a4ab8ba8e3b9746b47e22 3x", "genre": "art", "nsfw": false, "body": "私のFF14のキャラクターの髪型が新しくなりましたので、改めて大好きなポケモン二匹と一緒に冒険しているイラストをお願いします！\n\nポケモンはジュカインとスタメンのファイアローです。\n青空の下で二匹と一緒に歩いている感じでお願いします。\nうちの子は微笑んでいるか小さく口を開けて笑う穏やかな性格です。\n私のキャラクターが大好きなポケモンと一緒に冒険している光景を見たいです！\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1O30a0xQ4RPdMkstsqomvm90luPjzBNyr", "created_at": "", "completed_at": ""}, {"path": "/@Tom_mczk/works/70", "thumbnail_src": "https://si.imgix.net/70861774/uploads/origins/987793d6-1a48-412f-8db0-8152c3ac9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec292e6905f60b5e39259f484415585c", "thumbnail_srcset": "https://si.imgix.net/70861774/uploads/origins/987793d6-1a48-412f-8db0-8152c3ac9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec292e6905f60b5e39259f484415585c, https://si.imgix.net/70861774/uploads/origins/987793d6-1a48-412f-8db0-8152c3ac9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=741f46acc850ea325ab42ce6e2382935 2x, https://si.imgix.net/70861774/uploads/origins/987793d6-1a48-412f-8db0-8152c3ac9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f73b14d3c7f158e3808b7a9cf9fa2c3 3x", "genre": "art", "nsfw": false, "body": "トムさん、こんばんは！うちのリンゴちゃんを依頼します！\n\nリンゴちゃんはお茶目で能天気な狐娘です！青い羽織と白い着物を着ています！羽織は肘の下にかけてほしいです！\n\nリンゴちゃんとデンリュウのイラストをお願いします！コンビニの近くに立ってコロッケを食べています！\nポーズや構図はトムさんにお任します！\n\nhttps://drive.google.com/drive/u/3/folders/1HHGXHxWMslSX0zW7W5od2t