=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2e85d27c257f81d62e492cbd31973dd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/238", "thumbnail_src": "https://si.imgix.net/65b68789/uploads/origins/a11f0cc5-d56d-485b-aa67-792b66c27c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb5a4ccf20227aa66ab338482a8673b1", "thumbnail_srcset": "https://si.imgix.net/65b68789/uploads/origins/a11f0cc5-d56d-485b-aa67-792b66c27c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb5a4ccf20227aa66ab338482a8673b1, https://si.imgix.net/65b68789/uploads/origins/a11f0cc5-d56d-485b-aa67-792b66c27c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3c91f0d43c5eab7331a3883f472b94d 2x, https://si.imgix.net/65b68789/uploads/origins/a11f0cc5-d56d-485b-aa67-792b66c27c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=789e0b8d610acba0219a393cb265623f 3x", "genre": "art", "nsfw": true, "body": "久しぶりの依頼となります\n\nキャラ(いずれも大人化)\n■レミリア・スカーレット\n■フランドール・スカーレット\n\n衣装\n■こちらを参照にしてもらえると(https://seiga.nicovideo.jp/seiga/im6273182)。\n　先生なりのアレンジがあるとなおありがたいです。\n\n胸のサイズ\n■レミリア側\n　https://twitter.com/dr_yukito/status/1565338691987316737?s=20\n■フラン側\n　https://twitter.com/dr_yukito/status/1558090930409902081\nこのサイズを目安にお願いします。\n\n場所\n■紅魔館の寝室(大きな窓からは赤い満月が見えている)\n\nプレイ内容\n■レミリア側\n　左の手のひら全体で玉袋を持ち上げて揉みながら右手で左側の乳首責め\n■フラン側\n　右手で竿を激しく手コキしながら左手は右側の乳首責め\n■男性側\n　背もたれのある椅子に座った状態で両手は背もたれの後ろに鎖で縛られた状態\n\n表情\n■二人ともニヤニヤして馬鹿にしたような表情\n■男性側は涙目で口半開き(これは入れなくてもかまいません)\n\n台詞\n■レミリア側\n「ほらほら、どうしたの？私たちに種付けしたいんじゃあなかったの？♡\n　そんな有様では100年経っても無理に決まってるわ♡」\n■フラン側\n「やーいざ～こ♪ざこざこざこざこ♪ざっこぉ～い♡男として恥ずかしくないの～？\n　まあでもお兄さんはこれがよかったんだよね～♡そうだよね～♡」\n\n差分(可能であれば)\n■全裸差分\n■射精差分\n\n細かくなりましたが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/237", "thumbnail_src": "https://si.imgix.net/0ed21d1e/uploads/origins/9c729dfe-442d-461a-aa0b-de8260354836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cc7eab0791366e88f9a16932e0baa7e", "thumbnail_srcset": "https://si.imgix.net/0ed21d1e/uploads/origins/9c729dfe-442d-461a-aa0b-de8260354836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cc7eab0791366e88f9a16932e0baa7e, https://si.imgix.net/0ed21d1e/uploads/origins/9c729dfe-442d-461a-aa0b-de8260354836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fae8da8caea59ac03bea86997acc3730 2x, https://si.imgix.net/0ed21d1e/uploads/origins/9c729dfe-442d-461a-aa0b-de8260354836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95f27f5028aea1b3f66b41bfec21f49f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/236", "thumbnail_src": "https://si.imgix.net/cbdce6d5/uploads/origins/3908d265-25a2-4d4f-8174-317ffdf4d669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad28227a5f4d361f3397929b7e83528", "thumbnail_srcset": "https://si.imgix.net/cbdce6d5/uploads/origins/3908d265-25a2-4d4f-8174-317ffdf4d669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad28227a5f4d361f3397929b7e83528, https://si.imgix.net/cbdce6d5/uploads/origins/3908d265-25a2-4d4f-8174-317ffdf4d669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c10709d60be7ea362e2b300c9bf2777 2x, https://si.imgix.net/cbdce6d5/uploads/origins/3908d265-25a2-4d4f-8174-317ffdf4d669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=394cb28ebc0763737f44bb51a8819602 3x", "genre": "art", "nsfw": true, "body": "東風谷早苗の精液風船に大量射精して股間まで隠れる程の超特大精液風船化❗️\nそして尚も射精されてお口(両乳首)から逆流しても無理矢理射精されて…\nビュルルルルルル！❤️ドププ❤️ゴプッ❤️\n「やだ…精液がお口から逆流してる…❤️いっぱい射精してくれるのは嬉しいけど…流石に多すぎる～❤️これじゃあごっくん中に早苗の精液風船が大破裂しちゃうよぉ～❤️」", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/235", "thumbnail_src": "https://si.imgix.net/d9503253/uploads/origins/465978eb-7c76-4969-afa9-c9fa6e30ed05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1048b4201e4764b4c66aac701b684e2c", "thumbnail_srcset": "https://si.imgix.net/d9503253/uploads/origins/465978eb-7c76-4969-afa9-c9fa6e30ed05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1048b4201e4764b4c66aac701b684e2c, https://si.imgix.net/d9503253/uploads/origins/465978eb-7c76-4969-afa9-c9fa6e30ed05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=348be1767cebc96c310f2d7f79eca647 2x, https://si.imgix.net/d9503253/uploads/origins/465978eb-7c76-4969-afa9-c9fa6e30ed05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6af6bc9d3953e5d141ae98235ed4f46 3x", "genre": "art", "nsfw": true, "body": "この前は素敵なイラストありがとうございました！\nまた今回も依頼させていただきます！\n以下がリクエスト詳細となります。\nーーーーー\n▼キャラクター\n・比那名居天子\n\n▼服装\n・アメスク(青いスカート)\n・ブラジャー・パンツ有り(青色)\n・帽子、ニーソ着用\n\n▼ポーズ\n・片膝を立てて椅子に座っている\n\n▼シチュエーション\n・パンツを見せつけながら下着越しくぱぁ\n\n▼台詞\n・何勝手に見てるのよ気持ち悪い。\n・ふふっ。おちんちんおっきさせて見てる見てる。(脳内)\nーーーーー\nといった感じでお願いいたします！\n\nもし差分が可能でしたら、魔理沙の時同様下着無し差分をいただけますと幸いです！\n細かいリクエストとなってしまいましたが、何卒宜しくお願いいたしますm(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/234", "thumbnail_src": "https://si.imgix.net/98b39e53/uploads/origins/9952a742-3bdb-40f1-adef-250868586e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3218375026d44010923c8813dc05fa31", "thumbnail_srcset": "https://si.imgix.net/98b39e53/uploads/origins/9952a742-3bdb-40f1-adef-250868586e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3218375026d44010923c8813dc05fa31, https://si.imgix.net/98b39e53/uploads/origins/9952a742-3bdb-40f1-adef-250868586e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2f0b79de9df23f90cd24930b9bcbbab 2x, https://si.imgix.net/98b39e53/uploads/origins/9952a742-3bdb-40f1-adef-250868586e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78eab2dce732446c0a3415a53652a602 3x", "genre": "art", "nsfw": true, "body": "いつもエッチなイラストありがとうございます！\n\n初依頼なのですが、描いていただきたいのはアメスク衣装の霧雨魔理沙です！\nパンツは履かせたままで胸の大きさは普段描いていらっしゃる通常サイズでお願いいたします。\nまた、魔理沙成分多めにしていただきたいので、帽子は残して白黒ボーダーニーソを履かしていただきたいです。\n下着のデザインはお任せいたしますが、透けてたり際どすぎるものは控えていただけますと幸いです。\n\nポーズは箒をポール代わりにポールダンスでよくある感じのしゃがみ開脚で、片手でパンツ越しくぱぁをお願いします。\n\n表情や台詞は照れてる感じで\n「ちゃんとここに向かってにぶっかけるんだZE…?」\n「恥ずかしいところ見せつけちゃってるんだZE…(脳内)」\nといった感じでお願いいたします。\n\nもし差分が可能でしたら、胸元がはだけて胸露出差分をいただけますと幸いです。\n\n細かい指定となってしまいましたが、何卒宜しくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/233", "thumbnail_src": "https://si.imgix.net/71be1d76/uploads/origins/3a53bb54-38ca-46cb-af6b-34dca14e2600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2fab935f96c2adb3289b0d7e6a37225", "thumbnail_srcset": "https://si.imgix.net/71be1d76/uploads/origins/3a53bb54-38ca-46cb-af6b-34dca14e2600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2fab935f96c2adb3289b0d7e6a37225, https://si.imgix.net/71be1d76/uploads/origins/3a53bb54-38ca-46cb-af6b-34dca14e2600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b1198f1c2ea408ec28f522a98729131 2x, https://si.imgix.net/71be1d76/uploads/origins/3a53bb54-38ca-46cb-af6b-34dca14e2600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab30d0db7d07fa5fbce384919dfa0c94 3x", "genre": "art", "nsfw": true, "body": "1人で泉のほとりにいた大妖精を無知ラブラブレイプするイラストをお願いします。\n大妖精は中学生ぐらいの身長でおっぱいはおまかせします\n男は巨チンの成人\n\n(ここは書いて貰えるとありがたいですが、描かなくて大丈夫です)\n人気のない森を歩いていると、霧の湖のほとりに出る。そこには湖の方向を向いてキョロキョロする大妖精がおり、何かを探しているようだ。\n\n普通に近づいてスカートを捲りあげると、こどもっぽい見た目とは裏腹に大人のショーツを履いていた。大妖精は抵抗もせずよくわからなさそうにこちらを見ている。\n大妖精のパンツを膝上ぐらいまで下ろすと、つるっつるで幼い感じだが、確実に子供が作れる女の性器が顕になる。後ろから挿入を試みると、なぜか濡れているためすんなり入った。どうやら処女だったようだが、とってもきもちよさそうだ。\nキスして舌を入れると甘くてフルーティーな唾液が口の中に広がり、大妖精の表情がトロけていく。\n\n木に手をつかせると、幼い見た目とは裏腹に大きな乳房が重力に従い垂れ下がる。ボタンを外しておっばいを露出させ少し揉んでみると、また気持ちよさそうな声を上げ息を荒げる。乳首の先端部分が濡れており、母乳が地面に滴り落ちている。\n\n(ここからお願いします)\nバックで激しく突くと、目にハートを浮かべ処女でレイプされているは思えないほど気持ちよさそうに喘ぐ。腟内は極上の肉壺であり、堪えきれずすぐに膣内射精。\n大妖精も乳首から勢いよく母乳を吹き出し、口をとんがらせながらハートを撒き散らして絶頂", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/232", "thumbnail_src": "https://si.imgix.net/c2e5e6aa/uploads/origins/8a363338-83a8-46da-8b3f-1902f68b6173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2add520dd70b3d5a725d21485b731ebd", "thumbnail_srcset": "https://si.imgix.net/c2e5e6aa/uploads/origins/8a363338-83a8-46da-8b3f-1902f68b6173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2add520dd70b3d5a725d21485b731ebd, https://si.imgix.net/c2e5e6aa/uploads/origins/8a363338-83a8-46da-8b3f-1902f68b6173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ad4350570d7c0482842b4a9e4f85fdf 2x, https://si.imgix.net/c2e5e6aa/uploads/origins/8a363338-83a8-46da-8b3f-1902f68b6173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b844d9fe9359126c93f7677de6232ff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dr_yukito/works/231", "thumbnail_src": "https://si.imgix.net/0c534032/uploads/origins/1c2a339d-be0a-4dbb-aa39-9fada69f98fc?bg=%23ff