8fa3dec9324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed3edfa1527d4c50bbdcf9ab374542c2 2x, https://si.imgix.net/2e53d78e/uploads/origins/629e1e76-3ef4-46e9-9310-98fa3dec9324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15d28a103ba6a65f4bb7fcf7902830aa 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターを描いてもらえませんか？\n\nこのキャラクターは穏やかで物静かな性格です。\n\nhttps://i.imgur.com/K2Eic2r.jpeg。\n\nそれ以外はお好きなように描いていただいて構いません。よろしくお願いします！\n\nhttps://i.imgur.com/gjvT3nj.jpg", "created_at": "", "completed_at": ""}, {"path": "/@_migihidari_/works/53", "thumbnail_src": "https://si.imgix.net/31abad45/uploads/origins/285b74bb-79cc-4644-971d-733212f452cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d64133aae379c896f2f45a04fdf7b252", "thumbnail_srcset": "https://si.imgix.net/31abad45/uploads/origins/285b74bb-79cc-4644-971d-733212f452cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d64133aae379c896f2f45a04fdf7b252, https://si.imgix.net/31abad45/uploads/origins/285b74bb-79cc-4644-971d-733212f452cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c33c1ec16ed97b7a70b4d83e2e9e9ee 2x, https://si.imgix.net/31abad45/uploads/origins/285b74bb-79cc-4644-971d-733212f452cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23357c35193780d674c745dca4df493f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、渚の絵を依頼したいです。ヌードやポルノはご遠慮ください。胸の谷間や下着は見えません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_migihidari_/works/52", "thumbnail_src": "https://si.imgix.net/e865187b/uploads/origins/30933b4c-9780-4c8e-b514-fa3a5c872087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fdf2d9e2dd44aa4605008e54b135b19", "thumbnail_srcset": "https://si.imgix.net/e865187b/uploads/origins/30933b4c-9780-4c8e-b514-fa3a5c872087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fdf2d9e2dd44