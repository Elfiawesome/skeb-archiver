の丸いあざに注目です。\n\n由于是第一次向日本的画师约稿还不太熟练还请老师多多包涵，带来的不便非常抱歉(｡ ́︿ ̀｡)\n\n日本の絵師さんに註文するのは初めてなので、まだ慣れていないので大目に見ていただき、ご不便をおかけして申し訳ありません(｡ ́︿ ̀｡)\nhttps://drive.google.com/file/d/1HacJ6TzjgDZSqHTRBqWVSzvNrJMK7Cwd\n\nhttps://drive.google.com/file/d/1HacJ6TzjgDZSqHTRBqWVSzvNrJMK7Cwd\n\nhttps://drive.google.com/file/d/1-0RYop_3BMGD2EVdLL-2wEOAha-XNJQ4", "created_at": "", "completed_at": ""}, {"path": "/@uokkom/works/119", "thumbnail_src": "https://si.imgix.net/c2ff97a5/uploads/origins/09273483-51d0-4d39-a260-c4da5ca5a98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2155bc85c949c2bfdbf4950683f78147", "thumbnail_srcset": "https://si.imgix.net/c2ff97a5/uploads/origins/09273483-51d0-4d39-a260-c4da5ca5a98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2155bc85c949c2bfdbf4950683f78147, https://si.imgix.net/c2ff97a5/uploads/origins/09273483-51d0-4d39-a260-c4da5ca5a98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfa49ad95bc65e439a16cace285a3d2c 2x, https://si.imgix.net/c2ff97a5/uploads/origins/09273483-51d0-4d39-a260-c4da5ca5a98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebaf46423dfefe71fad7a4b20ecdc212 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uokkom/works/118", "thumbnail_src": "https://si.imgix.net/e5d58d0d/uploads/origins/4d0f80c6-73d1-4287-aeee-9f4c3396b046?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=649bf2b7cae8d87d421