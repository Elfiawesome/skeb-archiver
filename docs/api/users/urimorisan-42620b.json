%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff8a063fbaf8c52f0275c57323c63b2f 2x, https://si.imgix.net/aece20c8/uploads/origins/3a109903-41fb-444a-a195-4ef45872e0db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1169af3e35fbc2c52f98ed2b8a8413f0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの最新の完成したアートを見て、あなたのスタイルは私の忍者ガールOCにぴったりだと思ったの。\n\n彼女はカナ、背の高い19歳の女の子で、とても大人っぽくエレガントだけど、激しいファイター。\n少し紺色の髪に紫の目。武器はクナイ：\nhttps://twitter.com/ccanngreen/status/1679141811309383680?s=61&t=h8xv6D07TzeOGBZ_-hnYtA\n\nこのような表情の半身ショットを描いていただけますか？\nhttps://skeb.jp/@urimorisan/works/2\n\n忍者服を着て、髪を結んでほしい。クナイを持ったファイティングポーズをお願いします。衣装の修正、背景のレンダリングは自由です。\n\nこの絵は個人的なコレクションに使う予定です。\n絵とサインを分離したファイルを送ってください。\nもしこの依頼があなたにとって多すぎるようでしたら、遠慮なくこの依頼をキャンセルしてください。\nありがとうございました！\n\nhttps://twitter.com/ccanngreen/status/1679141811309383680?s=61&t=h8xv6D07TzeOGBZ_-hnYtA", "created_at": "", "completed_at": ""}, {"path": "/@urimorisan/works/2", "thumbnail_src": "https://si.imgix.net/8709f7cf/uploads/origins/f61e1311-455c-4be0-bcac-0b8049b7f9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e216225a79c1e786302370217b43c03", "thumbnail_srcset": "https://si.imgix.net/8709f7cf/uploads/origins/f61e1311-455c-4be0-bcac-0b8049b7f9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e216225a79c1e786302370217b43c03, https://si.imgix.net/8709f7cf/uploads/origins/f61e1311-455c-4be0-bcac-0b8049b7f9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca004bb5ceb0d6f8788b890530098227 2x, https://si.imgix.net/8709f7cf/uploads/origins/f61e1311-455c-4be0-bcac-0b8049b7f9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d1397f764816f61f77d9123a7980d32 3x", "genre": "art", "nsfw": false, "body": "以前はありがとうございました。\n\n納品されたイラストがとても良かったので、\nぜひ別の子も描いて欲しいと思い、リクエストさせて頂きます。\n\n資料は添付しましたので、ご確認ください。\nどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-0PAIeT6yHwTUCxbN5T2CggcIL6S