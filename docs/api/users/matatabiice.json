5-496d-a730-e016108bc35c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22aaf26671aa5f4afc63fb447cf6cbe5 2x, https://si.imgix.net/51b76831/uploads/origins/94205e10-c615-496d-a730-e016108bc35c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e7eab26a3b172d57a02e2e75fe207e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@matatabiice/works/20", "thumbnail_src": "https://si.imgix.net/ec2831de/uploads/origins/7e527d3b-4cb3-4a78-af7f-766e0e199b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a250a012eacc712bb91af45683bdbc6f", "thumbnail_srcset": "https://si.imgix.net/ec2831de/uploads/origins/7e527d3b-4cb3-4a78-af7f-766e0e199b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a250a012eacc712bb91af45683bdbc6f, https://si.imgix.net/ec2831de/uploads/origins/7e527d3b-4cb3-4a78-af7f-766e0e199b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3e56a8e44df01cb11d8486759f2d69c 2x, https://si.imgix.net/ec2831de/uploads/origins/7e527d3b-4cb3-4a78-af7f-766e0e199b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffa2bd821212df99ac48a0999e52a01e 3x", "genre": "art", "nsfw": false, "body": "初めまして。IRIAMで活動している泡星月です。\n初めてskebを使用して依頼させていただきます。\n早速なのですが、依頼内容にうつらせていただきます。\n構図などはおまかせで、笑顔いっぱいな泡星月を描いていただきたいです。\n商用利用を予定しております。\n\nよろしくお願いします。\n\nhttps://x.com/i/status/2008142441224998978", "created_at": "", "completed_at": ""}, {"path": "/@matatabiice/works/19", "thumbnail_src": "https://si.imgix.net/94ca1628/uploads/origins/7577df54-333b-4963-9933-ebc1b710047e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5cd319c3b6098060b61dffbd22507f6", "thumbnail_srcset": "https://si.imgix.net/94ca1628/uploads/origins/7577df54-333b-4963-9933-ebc1b710047e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5cd319c3b6098060b61dffbd22507f6, https://si.imgix.net/94ca1628/uploads/origins/7577df54-333b-4963-9933-ebc1b710047e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21da888d53b08c6c59f4c9e026e9271d 2x, https://si.imgix.net/94ca1628/uploads/origins/7577df54-333b-4963-9933-ebc1b710047e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e49d4c1ee4e0381f88ec3f9757be5b21 3x", "genre": "art", "nsfw": false, "body": "YouTubeにて活動中の藍晶シアンと申します。\n\n○SDイラストをお願いしたいです。\n構図はお任せします。\nヘアアレンジ衣装チェンジ大歓迎です。\n\n宝石好きの精霊という設定なので、モチーフの青い宝石がついてると嬉しいです。\n\nTwitter投稿用にGIF加工したいので、ウインクなどの目の差分あるととっても嬉しいです。\n\n○立ち絵のポイント\n耳がとんがりお耳とピアス\n目尻のほくろ\nお胸はそこそこあります\n\n○利用範囲\n配信活動に伴う全般（商用利用含む）\nグッズ作成\n配信のサムネイル\n返礼品への使用\nSNS投稿の際の軽微な加工（AI対策等）\n\n○参考資料\nこちらの方が耳やほくろなどは確認しやすいかと思います。\nhttps://x.com/cyan_ransho2nd/status/1996184860998893787?s=46&t=09VHdxbt7pUXt2M0aFvHfw\n\nhttps://x.com/cyan_ransho2nd/status/1898601726418338269?s=46&t=09VHdxbt7pUXt2M0aFvHfw\n\n要望多くてすいません。\nぜひよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@matatabiice/works/18", "thumbnail_src": "https://si.imgix.net/dbc457ee/uploads/origins/02ccaef2-857c-4dc3-a772-ca3bbd6ee516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae81053f96858e3b97da50dea2f3b53f", "thumbnail_srcset": "https://si.imgix.net/dbc457ee/uploads/origins/02ccaef2-857c-4dc3-a772-ca3bbd6ee516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae81053f96858e3b97da50dea2f3b53f, https://si.imgix.net/dbc457ee/uploads/origins/02ccaef2-857c-4dc3-a772-ca3bbd6ee516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ddcc0244b444e3cf7333add2fc272ba 2x, https://si.imgix.net/dbc457ee/uploads/origins/02ccaef2-857c-4dc3-a772-ca3bbd6ee516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f65d81da62e72992a33c81df29ab1551 3x", "genre": "art", "nsfw": false, "body": "またたび団子様  \n\nお世話になっております。 \nYouTubeにて配信活動を行っております、ウルハシスティーです。  \n\nこの度、またたび団子様に私ウルハシスティーのイラストを自由に描いて頂きたくリクエストいたしました。  \n下記内容にてリクエストは可能でしょうか？  \n\n【依頼事項】 \n・基本的におまかせ \n・衣装はお送りした資料の中からお好きなものか、別衣装等を自由に描いていただければと思っています。別衣装の場合は髪型の改変も問題ございません。  \n\n【デザインに関して】 \n・ウーパールーパーのエラと尻尾 \n・腰まである白髪にピンクメッシュ  \n\n【利用用途】 \n・商用利用あり \n・配信サムネイルやショート動画、Youtube動画等での利用 \n・SNSやクリエイティアでの利用\n ・グッズ化、案件への利用 \n※利用不可の用途があれば再送要請orキャンセルください。 \n\n 以上、長々と書きましたが是非お願い出来ますと幸いです。 \n条件が合いましたらどうぞよろしくお願いいたします！  \n\nhttps://drive.google.com/drive/folders/1jzL5X3r_Y9xNhkU76vrsB8CaxqUejfjx", "created_at": "", "completed_at": ""}, {"path": "/@matatabiice/works/17", "thumbnail_src": "https://si.imgix.net/21c1b715/uploads/origins/9438de5c-b134-4241-8315-085cba8904d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=639d7e0e576d8688a31c2630052dd2a8", "thumbnail_srcset": "https://si.imgix.net/21c1b715/uploads/origins/9438de5c-b134-4241-8315-085cba8904d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=639d7e0e576d8688a31c2630052dd2a8, https://si.imgix.net/21c1b715/uploads/origins/9438de5c-b134-4241-8315-085cba8904d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0737cac5bfab681f96b97c1fe0cd70c 2x, https://si.imgix.net/21c1b715/uploads/origins/9438de5c-b134-4241-8315-085cba8904d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f052557c6ecb08fcce757dc9c52b6820 3x", "genre": "art", "nsfw": false, "body": "またたび団子先生のskeb、心待ちにしておりました！！\n藤の花の精霊で紫夜りおんと申します。 \n\n私もぜひご依頼させていただきたいと考え、ご連絡いたしました。 よろしければ、下記ご確認の上描いていただけますと幸いです。\n\n■希望のイラスト\n私を描いていただけないでしょうか。\n参考資料①\nhttps://pin.it/2PvfNLXS9\n\n どんな表情やポーズでも大丈夫なので自由に描いてください。\n(既存SDとだけポーズ被らないようにして頂けたら嬉しいです。)\n参考資料②\nhttps://pin.it/ofaQOg1Ob\n\nまた、もし可能でしたら表情差分もいただけると大変嬉しいです…！\n\n■使用用途 \n【配信活動全般】\nサムネイルや動画、SNSでの使用(おはV等)、デジタル返礼品での使用、返礼品としてグッズ化等での商用利用を予定しております。\n\nサムネイル等に使用するため、髪