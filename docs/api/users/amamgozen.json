nという流れでお願いします\n沙弥香の表情は恐怖、痛み、絶望に満ちたものでお願いします\n構図はこちらの作品(https://www.pixiv.net/artworks/87431885)と同じものでお願いします\n左胸は形がかなり歪むほど握りしめられ、右胸は乳首に亀頭が押し付けられてください。どちらも乳首がハッキリ見えていてください\n左手は髪コキ状態で右手はそのまま男の性器を握らされている状態です\nhttp://yagakimi.com/character/\nhttps://twitter.com/bunko_dengeki/status/1037900567178145792?s=19 https://twitter.com/nakataniii/status/735780100042432513?s=19", "created_at": "", "completed_at": ""}, {"path": "/@amamgozen/works/29", "thumbnail_src": "https://si.imgix.net/025fc8a8/uploads/origins/f37a8a78-d718-4442-8549-eeab61efa4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=939e52253fcb39b3ec45e7b78b5a62e4", "thumbnail_srcset": "https://si.imgix.net/025fc8a8/uploads/origins/f37a8a78-d718-4442-8549-eeab61efa4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=939e52253fcb39b3ec45e7b78b5a62e4, https://si.imgix.net/025fc8a8/uploads/origins/f37a8a78-d718-4442-8549-eeab61efa4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8a3bc60076c371f71a44ab7cf159c0c 2x, https://si.imgix.net/025fc8a8/uploads/origins/f37a8a78-d718-4442-8549-eeab61efa4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46db740625b65422e828cff17070d92f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amamgozen/works/28", "thumbnail_src": "https://si.imgix.net/8d6b9f84/uploads/origins/1cd10952-f3ba-48f2-afc4-a0094b266620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c943d94b99848432586c9172df1bd85", "thumbnail_srcset": "https://si.imgix.net/8d6b