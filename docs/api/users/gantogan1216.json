-a33a-75ba508f5b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18dcd0684002c343c8dedb381071dc0a, https://si.imgix.net/2f401b20/uploads/origins/d2e4406a-f945-47e1-a33a-75ba508f5b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d102c79b355c71d017d97a19e424dd0 2x, https://si.imgix.net/2f401b20/uploads/origins/d2e4406a-f945-47e1-a33a-75ba508f5b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=981a8e962bbdbffc77543f54eab1e3cc 3x", "genre": "art", "nsfw": true, "body": "岩頭岩さんこんにちは！\n前回ライザンに乳首責められて上からも下からもビュービューとミルクを吹く熊レスラーをリクエストした者です、その節はどうもありがとうございました！\n今回は、前回のリクエストの続きで、\n意識が戻ったバルク熊レスラーがライザンにたっぷり心からの感謝のお礼の乳搾りをするという内容でイラストをリクエストします！\n\nシチュエーションは、\n《ライザンに沢山気持ち良くしてもらった熊レスラーが、\n次はライザンの期待に応えるべく疲れた身体に鞭を打ち、\n床に背を付けた自身のガタイの上にライザンを仰向けに寝そべらせ、ライザンのぶっとい太腿に自身の足を掛けてガッチリホールドした寝技の体制を作り、ライザンの乳首をたっぷりと時間を掛けて責めたてる。\n乳首責めを始めて数時間程経過した頃、\nそこには乳頭が熊レスラーの乳首同等にまで肥大し、胸板や腹筋が自身の乳ミルクと竿ミルクでビシャビシャになり、\n黄色いタイツの中に何度目かの射精を果たして尚イチモツを屹立させた、白目ひん剥いて気絶したライザンと、\n顔を赤らめながら肩で息をし、ニコニコと満面の笑みを浮かべた大変満足そうなバルク熊レスラーの姿がそこにはあった…》\nという内容を希望します！\nそれと可能であればライザンのタイツが脱がされイチモツが露出した差分も希望致します！\nこの内容で、何卒お願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@gantogan1216/works/75", "thumbnail_src": "https://si.imgix.net/2a1b39e2/uploads/origins/55aa82ac-df85-4976-ae05-c5517f66457a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c9d0c47142f2621b34aaed99d8bacd", "thumbnail_srcset": "https://si.imgix.net/2a1b39e2/uploads/origins/55aa82ac-df85-4976-ae05-c5517f66457a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c9d0c47142f2621b34aaed99d8bacd, https://si.imgix.net/2a1b39e2/uploads/origins/55aa82ac-df85-4976-ae05-c5517f66457a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1fd0500a8140f7072a594e493bf63f6 2x, https://si.imgix.net/2a1b39e2/uploads/origins/55aa82ac-df85-4976-ae05-c5517f66457a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80518d968c0be3eb20c1c135790d087c 3x", "genre": "art", "nsfw": true, "body": "立て続けですみません。また「スリーパーホールドで絞め落とさないと出られないデスマッチ」の仕返しで今度はパン田さんによるベアハグをお願いします。\nイタロウによるチャロフへのアルゼンチンの後、パン田は意識朦朧のチャロフ巻柴の背骨を強烈に圧迫する。朦朧でもチャロフ巻柴は歯を食いしばリ耐えようとするも、股間を擦られ乳首を舐められついには耐えきれず果てる。\n連続で申し訳ありませんが、可能でしたらお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gantogan1216/works/74", "thumbnail_src": "https://si.imgix.net/3e2cfe63/uploads/origins/2de67af2-f62c-4cdd-a3f2-c12c8256cd0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03d450f58ca441d411d1a84b94c3eb2d", "thumbnail_srcset": "https://si.imgix.net/3e2cfe63/uploads/origins/2de67af2-f62c-4cdd-a3f2-c12c8256cd0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03d450f58ca441d411d1a84b94c3eb2d, https://si.imgix.net/3e2cfe63/uploads/origins/2de67af2-f62c-4cdd-a3f2-c12c8256cd0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d34d2b82c00642a9cd4eeb312d20ac10 2x, https://si.imgix.net/3e2cfe63/uploads/origins/2de67af2-f62c-4cdd-a3f2-c12c8256cd0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08df553a0b1216c0ffe6fcc0b96122b9 3x", "genre": "art", "nsfw": true, "body": "チャロフ巻柴がイタロウにアルゼンチンバックブリーカーで担ぎ折られているている姿をお願いします。\n「スリーパーホールドで絞め落とさないと出られないデスマッチ」の仕返しで、イタロウがチャロフ巻柴にアルゼンチンバックブリーカーを仕掛ける。チャロフは葉を喰いしばり耐えようとするが、膨らみを掴まれ、果ててしまう姿をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gantogan1216/works/73", "thumbnail_src": "https://si.imgix.net/6d12178f/uploads/origins/d235dd04-526b-4ba2-b308-707cd296b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a353ca387fe1ea00a057a9e29c7d22a9", "thumbnail_srcset": "https://si.imgix.net/6d12178f/uploads/origins/d235dd04-526b-4ba2-b308-707cd296b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a353ca387fe1ea00a057a9e29c7d22a9, https://si.imgix.net/6d12178f/uploads/origins/d235dd04-526b-4ba2-b308-707cd296b0ab?bg=%23fff&auto=format%2Ccom