-6d8e-46e5-a770-93c6af085cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75a334f454e90046d92441b3a9bdc4e5 2x, https://si.imgix.net/48dae87b/uploads/origins/d0b9b208-6d8e-46e5-a770-93c6af085cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f10ac9cde40be1aa62caee8a0c7e78a 3x", "genre": "art", "nsfw": false, "body": "サワさん、こんにちは。私はあなたの作品と構図に惚れています。この2つのオリジナルキャラクターをお願いしたいのですが、もし描いていただけるなら光栄です。\n\n参考（キャラクター情報は参考リンクの中にあります）。\nhttps://sta.sh/2u7vaxcllza\n\nリクエスト\n居心地の良さそうな雰囲気を出してほしいです。シャオはお香の煙、ランはお茶を淹れるときの湯気をイメージしています。二人の共通テーマは「柳」です。\n\n構図やポーズなど、自由に楽しく描いてください。お忙しい中、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/7", "thumbnail_src": "https://si.imgix.net/20fb234d/uploads/origins/45286a01-68a0-45a8-8eae-f402b5a8247d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edadf2f4245d91637ffcc27a5ebf64a2", "thumbnail_srcset": "https://si.imgix.net/20fb234d/uploads/origins/45286a01-68a0-45a8-8eae-f402b5a8247d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edadf2f4245d91637ffcc27a5ebf64a2, https://si.imgix.net/20fb234d/uploads/origins/45286a01-68a0-45a8-8eae-f402b5a8247d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=741debd3d21dc4f1117550cc43a19058 2x, https://si.imgix.net/20fb234d/uploads/origins/45286a01-68a0-45a8-8eae-f402b5a8247d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32af6b598e8c6b3834b6e00349c517fe 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！あなたのアートが大好きです。\n\n私のオリジナルキャラクターのアートをお願いしたいです。下のフォルダにある長髪バージョンを描いていただけませんか？\n\nhttps://drive.google.com/drive/u/0/folders/1Oc5zcgGhI3uRb7zQmqs-spA-bYpbuMhN\n\n176cmで蛇の妖怪です。26歳くらいに見える。左目の下にほくろがある。首から左腕にかけて蛇と牡丹の刺青がある。一人では飄々としているが、人といるときは快活な笑顔を見せてくれる。大太刀を構えた姿を描いてください。血しぶきの表現も自由にしてください。\n\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/6", "thumbnail_src": "https://si.imgix.net/0dacb529/uploads/origins/381f12cd-c5fe-42f6-bf46-46dccc367052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=096f9e8942cb1c027fb08763e3eacfce", "thumbnail_srcset": "https://si.imgix.net/0dacb529/uploads/origins/381f12cd-c5fe-42f6-bf46-46dccc367052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=096f9e8942cb1c027fb08763e3eacfce, https://si.imgix.net/0dacb529/uploads/origins/381f12cd-c5fe-42f6-bf46-46dccc367052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a97123be24b6f7788b2faa55a0e54e0a 2x, https://si.imgix.net/0dacb529/uploads/origins/381f12cd-c5fe-42f6-bf46-46dccc367052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e846e1c16a253282e56b6a0ab6d63533 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ あなたの絵は大好きです！ 良かったら私のオリジナルキャラクター描いてもらえますか？ 今度も素敵な絵期待します! ありがとうございます！\n\nhttps://twitter.com/frau__atm/status/1438390491964346368", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/5", "thumbnail_src": "https://si.imgix.net/6c12d48b/uploads/origins/f53838e4-c4a3-4519-978a-61ea74a14387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8baf92a19a6399604fe4a3916681bc", "thumbnail_srcset": "https://si.imgix.net/6c12d48b/uploads/origins/f53838e4-c4a3-4519-978a-61ea74a14387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8baf92a19a6399604fe4a3916681bc, https://si.imgix.net/6c12d48b/uploads/origins/f53838e4-c4a3-4519-978a-61ea74a14387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a7274fcc48fc48d797f3b00f85f962c 2x, https://si.imgix.net/6c12d48b/uploads/origins/f53838e4-c4a3-4519-978a-61ea74a14387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b3b4f73aa2e499cb06e6284a1a77e8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのアートがとても大好きです。\n\nこの二人のキャラクターの絵をお願いしたいのですが。彼らは、魂の転生を助けるために働いている同僚です。二人とも中国風の服を着ています。\n\nイーユアン（男の子）。大人しいけどイライラしやすい。ストイックでクールな表情で描いてください。身長は180cmです。\n\nシエ（女の子）。可愛いというよりは、イケメンです。ハンサムな男の子のように、パイプを持っている姿を描いてください。身長は172cmです。\n\n本の表紙のようなかっこいいポーズでお願いします。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1UBeHMvi54YE0xMWUh1ikQzZkXd8oVFhL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/4", "thumbnail_src": "https://si.imgix.net/a877fd89/uploads/origins/857bed33-ccd4-49f4-8bb0-6373e7ac5926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5682353b761dea39b4ef198255ed7ef3", "thumbnail_srcset": "https://si.imgix.net/a877fd89/uploads/origins/857bed33-ccd4-49f4-8bb0-6373e7ac5926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5682353b761dea39b4ef198255ed7ef3, https://si.imgix.net/a877fd89/uploads/origins/857bed33-ccd4-49f4-8bb0-6373e7ac5926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57a4b1bda47dd38390639eed3b0ce890 2x, https://si.imgix.net/a877fd89/uploads/origins/857bed33-ccd4-49f4-8bb0-6373e7ac5926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1c52080c08935732b004939000d227d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ おはようございます。 この前に描いてくださった絵が気に入って来ました。 今回もよろしくお願いします。\n\nhttps://www.evernote.com/shard/s538/sh/5c799489-1ebc-4fbc-85e4-ed8e83d0da36/91865b765c461fd74166e82fa6eb93c0", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/3", "thumbnail_src": "https://si.imgix.net/acd92f6e/uploads/origins/bd630347-fee3-4462-9b6e-d9e465872118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8368adf97f8c81813babe6d53e97133d", "thumbnail_srcset": "https://si.imgix.net/acd92f6e/uploads/origins/bd630347-fee3-4462-9b6e-d9e465872118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8368adf97f8c81813babe6d53e97133d, https://si.imgix.net/acd92f6e/uploads/origins/bd630347-fee3-4462-9b6e-d9e465872118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c58da0168fc36da2d974ff058c121d7b 2x, https://si.imgix.net/acd92f6e/uploads/origins/bd630347-fee3-4462-9b6e-d9e465872118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b3795b5f6f38e1d946997ad0fa6b682 3x", "genre": "art", "nsfw": false, "body": "こんにちは。はじめまして。以前から澤さんの絵が大好きで（pixivではユダ公の絵でフォローしていました！）、アルベドとモナを描いていただいてもよろしいでしょうか？似た者同士が協力し合う姿がとても好きです。クレーと一緒に遊んでいる姿もかわいいです。宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/2", "thumbnail_src": "https://si.imgix.net/edc3e161/uploads/origins/e28ae22f-5ef5-45b5-b7b5-49981d7b4798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc311c64fa1ac13b77577d219df445e", "thumbnail_srcset": "https://si.imgix.net/edc3e161/uploads/origins/e28ae22f-5ef5-45b5-b7b5-49981d7b4798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc311c64fa1ac13b77577d219df445e, https://si.imgix.net/edc3e161/uploads/origins/e28ae22f-5ef5-45b5-b7b5-49981d7b4798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=730dd9e8464ad3473a2e1d305a4a2022 2x, https://si.imgix.net/edc3e161/uploads/origins/e28ae22f-5ef5-45b5-b7b5-49981d7b4798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=540ba5bde1692dc7b7d68fc29e967972 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして。 あなたの絵が好きで惹かれました。 よろしければ私の子供たちを描いていただけますか。 どうぞよろしくお願いします。\n\nhttps://www.evernote.com/shard/s538/sh/a3f9ebba-e225-45f8-ab00-8090b1130743/b687fc0ec5df9b8ea68f0dd886d2a27f", "created_at": "", "completed_at": ""}, {"path": "/@sawanojiga/works/1", "thumbnail_src": "https://si.imgix.net/80712052/uploads/origins/7005a2a9-746c-47a4-8c7b-ffb14eb47a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287b2fae11f43cc1f7a8f280b28b450a", "thumbnail_srcset": "https://si.imgix.net/80712052/uploads/origins/7005a2a9-746c-47a4-8c7b-ffb14eb47a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287b2fae11f43cc1f7a8f280b28b450a, https://si.imgix.net/80712052/uploads/origins/7005a2a9-746c-47a4-8c7b-ffb14eb47a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f772e814a37b8094362a69fedfc297ea 2x, https://si.imgix.net/80712052/uploads/origins/7005a2a9-746c-47a4-8c7b-ffb14eb47a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f352710edc4bbcb9b01a5db65ade2eaa 3x", "genre": "art", "nsfw": false, "body": "こんにちは。可能でしたらラグナロクマスターズで私が使用している兄弟キャラを描いていただけませんでしょうか。SNSアイコン、PC壁紙に使用予定です。\n資料URLを添付します。もうひとつはラグマスのガイドラインURLです。\nイメージは以下のような感じです。\n兄：金狐、桃色髪、左頬にハートタトゥ、細身、サボり魔\n弟：銀狐、紫髪、右目眼帯、兄より筋肉質、兄の飼い主（振り回されてる）\n衣装のアレンジ 、場面はおまかせ致します。宛名を書いていただけるのでしたら別レイヤーにして頂くと嬉しいです。\n\nhttps://imgur.com/a/FdMIqPc\n\nhttps://ragnarokm.gungho.jp/member/event/fankit/rom_terms.html", "created_at": "", "completed_at": ""}]}