d9b8-66ac-48c1-932c-22cce716347b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1418d504ced3be179e25afec251496", "thumbnail_srcset": "https://si.imgix.net/50cedc22/uploads/origins/5ff4d9b8-66ac-48c1-932c-22cce716347b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1418d504ced3be179e25afec251496, https://si.imgix.net/50cedc22/uploads/origins/5ff4d9b8-66ac-48c1-932c-22cce716347b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed8a912d2276dc1300effd81e605e0ff 2x, https://si.imgix.net/50cedc22/uploads/origins/5ff4d9b8-66ac-48c1-932c-22cce716347b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b042ad180cc8b5f7d9a779b1103881e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品を拝見しました。\n\nゲーム「ソラ」と「100％オレンジジュース」のソラ（参考はこちら：https://drive.google.com/drive/folders/1xyKJRu_jcTBcQirD-LP1KCwzFpbWy2tJ?usp=sharing）を、以前の作品（https://skeb.jp/@mikeran5648/works/1、https://skeb.jp/@mikeran5648/works/30）と同じようなポーズで、前述の作品のようなナイトウェアを着てほしいです。また、今までの作品のように笑顔で髪を見せてほしいです。それ以外のポーズ調整などはお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mikeran5648/works/33", "thumbnail_src": "https://si.imgix.net/33859811/uploads/origins/178f7138-f8a9-4a65-a3c6-b28a8d62c521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87fc79a49d6b5232898800bf7d9a2059", "thumbnail_srcset": "https://si.imgix.net/33859811/uploads/origins/178f7138-f8a9-4a65-a3c6-b28a8d62c521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87fc79a49d6b5232898800bf7d9a2059, https://si.imgix.net/33859811/uploads/origins/178f7138-f8a9-4a65-a3c6-b28a8d62c521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c44ae2377b4e37f7be5eaf6d2382f2c 2x, https://si.imgix.net/33859811/uploads/origins/178f7138-f8a9-4a65-a3c6-b28a8d62c521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d08ce9cd054d8b2d78303d40fef9