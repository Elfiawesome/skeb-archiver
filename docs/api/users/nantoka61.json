ロジャー（海賊のドクロマーク）をあしらって欲しいです\nジョリーロジャーのモチーフにするのがダイヤか鶏か神社か南米の悪霊かはたまたそれ以外の何にするかはなんとか先生に一任せさせていただければと思います\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@nantoka61/works/91", "thumbnail_src": "https://si.imgix.net/10626a8c/uploads/origins/7b409260-d66d-48be-b46c-e7cea2948d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fc76d4b89230e322cc9780ce1aef9b7", "thumbnail_srcset": "https://si.imgix.net/10626a8c/uploads/origins/7b409260-d66d-48be-b46c-e7cea2948d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fc76d4b89230e322cc9780ce1aef9b7, https://si.imgix.net/10626a8c/uploads/origins/7b409260-d66d-48be-b46c-e7cea2948d17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5aa16230804f53fa8782206741ed86fb 2x, https://si.imgix.net/10626a8c/uploads/origins/7b409260-d66d-48be-b46c-e7cea2948d17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0550d24f5866ca0e2287ab6ddbe74b5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nantoka61/works/90", "thumbnail_src": "https://si.imgix.net/16099f92/uploads/origins/8b035228-7d7f-4646-8874-170c34b63fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30647b4412ab20291b6a0001e8f3c9d7", "thumbnail_srcset": "https://si.imgix.net/16099f92/uploads/origins/8b035228-7d7f-4646-8874-170c34b63fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=