ジでお願いしたいです。\n\n・シリュウ参考画像\nhttps://drive.google.com/file/d/1MXNTZCpUL9XTLRG65uYCVmcUSXaOkgN1/view", "created_at": "", "completed_at": ""}, {"path": "/@amatsu_rai2/works/9", "thumbnail_src": "https://si.imgix.net/c58e985b/uploads/origins/c315556b-c7fb-4051-b858-c423543d6640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb3adca90d054c12bd8852189c8d7778", "thumbnail_srcset": "https://si.imgix.net/c58e985b/uploads/origins/c315556b-c7fb-4051-b858-c423543d6640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb3adca90d054c12bd8852189c8d7778, https://si.imgix.net/c58e985b/uploads/origins/c315556b-c7fb-4051-b858-c423543d6640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=352d47a343b598f6da06012fa24c512b 2x, https://si.imgix.net/c58e985b/uploads/origins/c315556b-c7fb-4051-b858-c423543d6640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=feb9b093154d41bb2c4e1d3951771fec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amatsu_rai2/works/8", "thumbnail_src": "https://si.imgix.net/c8f7c76a/uploads/origins/00df32d9-0f77-4afa-b9ee-982993705330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=682c78f08daea2bf406b211ac00ccf0a", "thumbnail_srcset": "https://si.imgix.net/c8f7c76a/uploads/origins/00df32d9-0f77-4afa-b9ee-982993705330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF