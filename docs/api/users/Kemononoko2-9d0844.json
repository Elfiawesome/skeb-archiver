71a7-44d3-b223-1f31987ee192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55ff5ff3f759bb4674651e1843069cf5", "thumbnail_srcset": "https://si.imgix.net/a71a3964/uploads/origins/854ceccd-71a7-44d3-b223-1f31987ee192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55ff5ff3f759bb4674651e1843069cf5, https://si.imgix.net/a71a3964/uploads/origins/854ceccd-71a7-44d3-b223-1f31987ee192?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79517f8c802185ec2f6f3cec4b6925da 2x, https://si.imgix.net/a71a3964/uploads/origins/854ceccd-71a7-44d3-b223-1f31987ee192?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef27587e1bbcef1c876616518b93ba3f 3x", "genre": "art", "nsfw": false, "body": "バクフーン×バシャーモ\n見本の１枚目を参考に、夏の縁日でまったりしてるのをお願いします。\n\n◆バクフーン\n　・おまつりスタイル（３枚目の浴衣）でわたあめを舐めている\n◆バシャーモ\n　・おみこしスタイル（４、５枚目の法被などなど）で焼きモコシをかじってる\n\nもし値段に見合ってるのであれば、２枚めのシェアし合うのもお願いします。\n\nhttps://www.dropbox.com/home/bakubasyariku", "created_at": "", "completed_at": ""}, {"path": "/@Kemononoko2/works/6", "thumbnail_src": "https://si.imgix.net/e4aaea07/uploads/origins/6c29bd51-3dba-461e-9c79-7aaf45e3eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59530bbecb7c922e944be470e417a168", "thumbnail_srcset": "https://si.imgix.net/e4aaea07/uploads/origins/6c29bd51-3dba-461e-9c79-7aaf45e3eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59530bbecb7c922e944be470e417a168, https://si.imgix.net/e4aaea07/uploads/origins/6c29bd51-3dba-461e-9c79-7aaf45e3eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b75312a21f3444546d57cc30b2ab082b 2x, https://si.imgix.net/e4aaea07/uploads/origins/6c29bd51-3dba-461e-9c79-7aaf45e3eba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e48dffab532ee9a01ad36d48982b7526 3x", "genre": "art", "nsfw": true, "body": "失礼します。アリゲイツ×マグマラシでアリゲイツがマグマラシに押し倒して口を大きく開けて首を甘噛みしようとしてて漫画がガオーとア