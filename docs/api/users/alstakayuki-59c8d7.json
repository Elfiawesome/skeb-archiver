753/uploads/origins/1c6450c8-78b1-4142-ae32-5cb7db5a27e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c39c4fda46d2b446fe9f03a5cbcbe30c, https://si.imgix.net/bd308753/uploads/origins/1c6450c8-78b1-4142-ae32-5cb7db5a27e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=713e3d55048b67cffbe18101d83dfaef 2x, https://si.imgix.net/bd308753/uploads/origins/1c6450c8-78b1-4142-ae32-5cb7db5a27e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=342a1a7b7c78d794a723753d86bf934a 3x", "genre": "art", "nsfw": false, "body": "またお願いしたいです。\n\n遊戯王でガガガガールの全身が写ったイラストをお願いします。\n\n・バストは大きめのセクシーな感じ(大きいが前依頼のブラックマジシャンガールよりは小さい)\n・片手で腰当てや可愛げなポーズを決めて、もう片手は携帯を持ち待ち合わせ風な仕草orこちらと目線があって笑い会話を見せてる様子\n・可能でしたら、キリッとした目付きの戦闘顔のカッコ良さや憧れの先輩を見つけた可愛い反応をするなどの表情変化も有ると嬉しいです\n\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/16", "thumbnail_src": "https://si.imgix.net/3ca326bd/uploads/origins/4b9e9147-d29e-4b8a-818f-cfabb8b733d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b152d6927faac16309fac0e9a9474ab", "thumbnail_srcset": "https://si.imgix.net/3ca326bd/uploads/origins/4b9e9147-d29e-4b8a-818f-cfabb8b733d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b152d6927faac16309fac0e9a9474ab, https://si.imgix.net/3ca326bd/uploads/origins/4b9e9147-d29e-4b8a-818f-cfabb8b733d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e857214266eed177ea5248c4b6c4aac4 2x, https://si.imgix.net/3ca326bd/uploads/origins/4b9e9147-d29e-4b8a-818f-cfabb8b733d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14bc9f649db06458a31812ff5fbdac3c 3x", "genre": "art", "nsfw": false, "body": "またお願いしたいです。\n\n遊戯王でブラックマジシャンガールの全身が写ったイラストをお願いします。\n\n・バストは大きめのセクシーな感じ\n・片手でピースや可愛げなポーズを決めて、もう片手は杖を持ちこちらに魔法をかける仕草or自信に満ちた感じや待ち待機な構えな感じでこちらを見つめながら笑いを見せてる様子\n・可能でしたら、キリッとした目付きの戦闘顔や片目ウィンクなどカッコ良さや可愛い反応をする表情変化も有ると嬉しいです\n\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/15", "thumbnail_src": "https://si.imgix.net/77311e41/uploads/origins/dddb6423-4600-4ea7-b498-07d5bb152bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e829073e12efdcab4cc4ab7dfe401353", "thumbnail_srcset": "https://si.imgix.net/77311e41/uploads/origins/dddb6423-4600-4ea7-b498-07d5bb152bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e829073e12efdcab4cc4ab7dfe401353, https://si.imgix.net/77311e41/uploads/origins/dddb6423-4600-4ea7-b498-07d5bb152bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c70de17a7e0ad8b4cfb30702b74f307 2x, https://si.imgix.net/77311e41/uploads/origins/dddb6423-4600-4ea7-b498-07d5bb152bb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a637bd937dd49bc346a5a352cac2001 3x", "genre": "art", "nsfw": false, "body": "またお願いしたいです。\n\n遊戯王で沈黙の魔術師衣装のサイレント・マジシャンの全身が写ったイラストをお願いします。\n\n・バストは資料くらい大きめで穴空き履き物から太ももが広い面積見えのセクシーな感じ\nhttps://www.pixiv.net/artworks/105063480\n・片手で大きな帽子を支え調整や、もう片手は杖を持ちつつ腰に手を置く待機中か戦闘前の構えな感じでこちらを見つめながら微笑みを浮かべてる様子\n・可能でしたら、キリッとした目付きの戦闘顔や片目ウィンクドヤ顔などカッコ可愛いお姉さん風な反応をする表情変化も有ると嬉しいです\n\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/14", "thumbnail_src": "https://si.imgix.net/609fe386/uploads/origins/a26e38bf-f809-4c95-8b73-40b3e47c3ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86eee8fa7c7943dfbfc8c5660504fae7", "thumbnail_srcset": "https://si.imgix.net/609fe386/uploads/origins/a26e38bf-f809-4c95-8b73-40b3e47c3ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86eee8fa7c7943dfbfc8c5660504fae7, https://si.imgix.net/609fe386/uploads/origins/a26e38bf-f809-4c95-8b73-40b3e47c3ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0466e452018b25d582a288d484075b4 2x, https://si.imgix.net/609fe386/uploads/origins/a26e38bf-f809-4c95-8b73-40b3e47c3ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=002db91cc35f7c104ffcc724e2ab73a4 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストに癒されてます。\nまた描いて貰えると嬉しいです！\n\n遊戯王でドラゴンメイド・パルラの全身が写ったイラストをお願いします。\nhttps://twitter.com/alstakayuki/status/1571900704163495936?s=20\n・バストやスタイルなどは資料と同じで\n・おやつの食べ物を運んでいるが、笑顔でしっかりとつまみ食いもしていた感じの様子\n・可能でしたら、つまみ食いバレて反応する表情変化も有ると嬉しいです\n\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/13", "thumbnail_src": "https://si.imgix.net/d693f9e7/uploads/origins/7c723aee-84b2-4ddb-b0c6-75a3163bf76c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57a7402cfa5b4e078f3eb84a8856dfac", "thumbnail_srcset": "https://si.imgix.net/d693f9e7/uploads/origins/7c723aee-84b2-4ddb-b0c6-75a3163bf76c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57a7402cfa5b4e078f3eb84a8856dfac, https://si.imgix.net/d693f9e7/uploads/origins/7c723aee-84b2-4ddb-b0c6-75a3163bf76c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e01f932d4095305f8b9b4234e52ccf6 2x, https://si.imgix.net/d693f9e7/uploads/origins/7c723aee-84b2-4ddb-b0c6-75a3163bf76c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9114db20d9ab8caebd1cc797e4724ced 3x", "genre": "art", "nsfw": false, "body": "たっかゆーき先生\nお世話になっております。\n\n先生に1点イラストのリクエストしても可能でしょうか。\nご多忙のところ恐縮ですが、ご検討宜しくお願い致します。\n\nキャラ：ハーピィ・ガール\nシチュ：ハーピィ・ガールがしているポーズの全身版をお願い致します。\nhttps://twitter.com/alstakayuki/status/1638943119193538560\n\n以上になります。\nご検討の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/12", "thumbnail_src": "https://si.imgix.net/e17dcebd/uploads/origins/668a82b3-cbba-40c0-ba16-6fb0bfd75c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04405b574d269e2e9d7698d5255106c3", "thumbnail_srcset": "https://si.imgix.net/e17dcebd/uploads/origins/668a82b3-cbba-40c0-ba16-6fb0bfd75c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04405b574d269e2e9d7698d5255106c3, https://si.imgix.net/e17dcebd/uploads/origins/668a82b3-cbba-40c0-ba16-6fb0bfd75c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b320efaab11ee79fccb4694ac4ea2473 2x, https://si.imgix.net/e17dcebd/uploads/origins/668a82b3-cbba-40c0-ba16-6fb0bfd75c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50612ed5079f9bc4b3e927c0753e1444 3x", "genre": "art", "nsfw": true, "body": "こんばんは。\n遊戯王OCGのEvil★TwinキスキルとEvil★Twinリィラ（両方髪の長さは初出イラスト版基準ですが素顔は新イラスト版で）をお願いします。\n\n希望シチュは、\n・ベッドの上でぺたん座りしているキスキルと、その側でキスキルの肩に頭を乗せて横座りするリィラ\n・2人とも裸でお互いを愛おしげに見つめている\n・キスキルはツインテールを解いてストレートに\n・キスキルの左手にリィラの右手が指がやや絡むように重なっている", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/11", "thumbnail_src": "https://si.imgix.net/bd7f4ce6/uploads/origins/ec53b463-b1e7-4cb6-b4a8-b48bfb7f2dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defb107e61fe56de90584831b404a6b6", "thumbnail_srcset": "https://si.imgix.net/bd7f4ce6/uploads/origins/ec53b463-b1e7-4cb6-b4a8-b48bfb7f2dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defb107e61fe56de90584831b404a6b6, https://si.imgix.net/bd7f4ce6/uploads/origins/ec53b463-b1e7-4cb6-b4a8-b48bfb7f2dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86ab4cd7f59c2778560677588ded352f 2x, https://si.imgix.net/bd7f4ce6/uploads/origins/ec53b463-b1e7-4cb6-b4a8-b48bfb7f2dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50185008704cdabf2ecf3cbb98864445 3x", "genre": "art", "nsfw": true, "body": "遊戯王のブラックマジシャンガールと沈黙衣装版サイレントマジシャンが竿役の師匠、ソードマンとカップル乱交をお願いします\n\n・極力着衣で二人共大きい胸(サイマジの方が大きい)をずり下げや前掛け谷間挟み、結合部を露出の半脱ぎの見える様子で資料の様に近場で並んだりで共に両乳首見え彼氏に背もたれな股開き背面座位で、片脚持たれと師匠に片胸揉ませるBMGと片胸鷲掴みとクリ弄りされつつ片手は前掛けたくし上げサイマジの二人が自慢げ笑みに楽しく営んでおり余った片手で指立てや可愛いポーズでノリノリな様子\n\n・差分で男性の責めに我慢限界に眼瞑り喘ぎで中出しされ、その後まだしたそうにトロけた眼で舌出しやニヤケ事後など\n\nhttps://www.pixiv.net/artworks/81800291", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/10", "thumbnail_src": "https://si.imgix.net/25349356/uploads/origins/c8dec82d-e68c-4a01-8f50-af8bd8325344?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff457b24f0025dd01ff357ecb24f2a41", "thumbnail_srcset": "https://si.imgix.net/25349356/uploads/origins/c8dec82d-e68c-4a01-8f50-af8bd8325344?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff457b24f0025dd01ff357ecb24f2a41, https://si.imgix.net/25349356/uploads/origins/c8dec82d-e68c-4a01-8f50-af8bd8325344?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17882d695bc667157b49f194f7751002 2x, https://si.imgix.net/25349356/uploads/origins/c8dec82d-e68c-4a01-8f50-af8bd8325344?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f36c5d852edd079e1379ee1ffe62b7a8 3x", "genre": "art", "nsfw": true, "body": "遊戯王のブラックマジシャンガールとガガガガールがパートナーの師匠と先輩の竿役とカップル乱交をお願いします\n\n・二人とも極力着衣で大きい胸(二人とも大きいがBMGの方が大きい)をずり下げや谷間挟み、結合部を露出の半脱ぎの見える様子で下資料など参考で片脚持ちと股開かれの対面BMGと片手に携帯持ちつつもう片手で腰掴みの騎乗位責めしてる先輩(ガガガマジシャン)のもう片手を掴み自分の片胸を揉ませたり(乳首見え)して二人共笑顔やニヤリ歯浮かべて楽しくエッチに勤しんで女性陣が責め立てる様子\n\n・差分で男性の責めに耐え切れず滅茶苦茶喘いだりで中出しされ、その後もう一回したそうに甘えたりの事後光景など\n\nhttps://www.pixiv.net/artworks/91336857", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/9", "thumbnail_src": "https://si.imgix.net/26a5801f/uploads/origins/c44a4376-0b48-43f1-aae5-91f502d607a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0dfd5d544db819795491642b9eda4f7", "thumbnail_srcset": "https://si.imgix.net/26a5801f/uploads/origins/c44a4376-0b48-43f1-aae5-91f502d607a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0dfd5d544db819795491642b9eda4f7, https://si.imgix.net/26a5801f/uploads/origins/c44a4376-0b48-43f1-aae5-91f502d607a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdf7dc8473a776f940ef8e273212015f 2x, https://si.imgix.net/26a5801f/uploads/origins/c44a4376-0b48-43f1-aae5-91f502d607a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2508dc3ab948e78d02fbc15d9f1f2578 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n\nポケモンシリーズのタマムシジムジムリーダー・エリカをリクエストさせていただきます。\n\nシチュエーション等の細かい依頼内容としましては、\n・背景は朝の和室。彼女の後ろの方には開いてて外が見える窓\n・一糸まとわぬ裸姿\n・布団の上で身体全てこちらを向けてぺたん座り。布団には処女喪失の血の跡\n・恥じらいの表情を浮かべながら枕を抱えて股間を隠そうとしている一方で、抱えた枕に割と大きなおっぱいを載せて強調してしまっている\n・窓の側に白百合の花が一輪生けてある花瓶（なお花の部分は丸ごと落ちて散っている）\n・布団の側にきちんと畳まれた、バトルの際着ている和服\n\n以上の内容でお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/7", "thumbnail_src": "https://si.imgix.net/4bf569f5/requests/97299_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bee9a1cb4a91a63889d6f64ba97a6f4", "thumbnail_srcset": "https://si.imgix.net/4bf569f5/requests/97299_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bee9a1cb4a91a63889d6f64ba97a6f4, https://si.imgix.net/4bf569f5/requests/97299_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dcb4f0858c8b2db21de23b4d215ef0b 2x, https://si.imgix.net/4bf569f5/requests/97299_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebd0dcd5d5155507c7373bb72874bb9c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@alstakayuki/works/6", "thumbnail_src": "https://si.imgix.net/275fc0da/requests/61355_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVA