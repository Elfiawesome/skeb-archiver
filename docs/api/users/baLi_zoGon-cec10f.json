bp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca7f7d0b06c84a7d74223ff6d3032ccc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@baLi_zoGon/works/9", "thumbnail_src": "https://si.imgix.net/723ca99c/uploads/origins/48d036b2-b030-4d2c-8d3c-16e73465ea25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01369dcd0581e9f220dc4c73a1f05a6", "thumbnail_srcset": "https://si.imgix.net/723ca99c/uploads/origins/48d036b2-b030-4d2c-8d3c-16e73465ea25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01369dcd0581e9f220dc4c73a1f05a6, https://si.imgix.net/723ca99c/uploads/origins/48d036b2-b030-4d2c-8d3c-16e73465ea25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ffdaa14f57ffe44d5e766fdabb8e2de 2x, https://si.imgix.net/723ca99c/uploads/origins/48d036b2-b030-4d2c-8d3c-16e73465ea25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8febfa3a1e30a1596ad49b45072debd 3x", "genre": "art", "nsfw": true, "body": "こんにちは、リクエストを失礼します！\n\n社長のやんちゃショタ息子がデスクの下からこっそりフェラされている若いサラリーマンのシーンを描いていただきたいです。ショタは勢いよくしゃぶって吸っているながら男は平静を装おうとしているが、本物の気持ちを少し漏らしてしまう。できれば男根に吸い付くショタの唇をズームアップ別で表示してお願いしたいです。\n\nご検討の程よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@baLi_zoGon/works/8", "thumbnail_src": "https://si.imgix.net/9cc4ffe4/uploads/origins/b42d5832-d22d-48f6-9294-04fb5092a727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6884bc8e8df814ddb52d8cc3932d3a", "thumbnail_srcset": "https://si.imgix.net/9cc4ffe4/uploads/origins/b42d5832-d22d-48f6-9294-04fb5092a727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6884bc8e8df814dd