ix.net/cad94c15/uploads/origins/75f3e36c-e23b-4b60-9ccf-56d7a63f401a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34012ea56d7ef9afe3d8e6febf3f5db3", "thumbnail_srcset": "https://si.imgix.net/cad94c15/uploads/origins/75f3e36c-e23b-4b60-9ccf-56d7a63f401a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34012ea56d7ef9afe3d8e6febf3f5db3, https://si.imgix.net/cad94c15/uploads/origins/75f3e36c-e23b-4b60-9ccf-56d7a63f401a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b18ab1e0afa641b336a797ec4fe280c1 2x, https://si.imgix.net/cad94c15/uploads/origins/75f3e36c-e23b-4b60-9ccf-56d7a63f401a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5db8c46cb47f7af7d33258d739d8ba1c 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。ひっきーです。あき様のskebが好きでまた依頼してみたいと思い、声をかけました。 \n\n· お題『寛乃りまる』て子(URLから)の1周年記念で祝われてる所をお願いいたします。\n\n ·構図は、『寛乃りまる』が1周年で祝われてる感じでお願いします。 \n·表情等はお任せいたします。\n\n·もし良かったら差分で背景透過があると助かります。\n\n どうかよろしくお願いします。 \n\n\n·寛乃りまる\n\nhttps://x.com/kannorimaru/status/1941997532080419066?t=1P7Jcp1vWhvwUJP-DA-ppQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@aki_neko_aki/works/15", "thumbnail_src": "https://si.imgix.net/77abde49/uploads/origins/77aa3754-43ab-4795-b59b-91ad97699ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6a9a6f0978902eeacbf6b4bdac8341b", "thumbnail_srcset": "https://si.imgix.net/77abde49/uploads/origins/77aa3754-43ab-4795-b59b-91ad97699ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6a9a6f0978902eeacbf6b4bdac8341b, https://si.imgix.net/77abde49/uploads/origins/77aa3754-43ab-4795-b59b-91ad97699ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&t