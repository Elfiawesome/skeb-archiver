c1-ca55-43a1-9330-4b1aec96cfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=772ebb2e3310c0ce61867f999276e550", "thumbnail_srcset": "https://si.imgix.net/42cd8db8/uploads/origins/a605aec1-ca55-43a1-9330-4b1aec96cfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=772ebb2e3310c0ce61867f999276e550, https://si.imgix.net/42cd8db8/uploads/origins/a605aec1-ca55-43a1-9330-4b1aec96cfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a90f07a8fcecd1fca4c49da95bf89e98 2x, https://si.imgix.net/42cd8db8/uploads/origins/a605aec1-ca55-43a1-9330-4b1aec96cfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68487159d3ee44e1838f32e1d6f6b9e6 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/8", "thumbnail_src": "https://si.imgix.net/793e7ce4/uploads/origins/a661ae69-750f-4649-a5fb-23acd5a07493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d9dedb2af6b9e251c67afd4e9a9d043", "thumbnail_srcset": "https://si.imgix.net/793e7ce4/uploads/origins/a661ae69-750f-4649-a5fb-23acd5a07493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d9dedb2af6b9e251c67afd4e9a9d043, https://si.imgix.net/793e7ce4/uploads/origins/a661ae69-750f-4649-a5fb-23acd5a07493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe5a651d4b1d25e84845ea0ab90a9c94 2x, https://si.imgix.net/793e7ce4/uploads/origins/a661ae69-750f-4649-a5fb-23acd5a07493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb79cea92f1650cfc7146d27d66fe699 3x", "genre": "art", "nsfw": true, "body": "エヴァのレイとアスカによるおならとスカのシチュをリクエストします！\n(内容変更し、構図一つとなるような形で再送いたしますが、追加した部分厳しいようでしたらカットください！)\n\nピチピチのプラグスーツ衣装でジト目のレイはハンバーガー食いすぎの爆乳爆尻ぶっともも体型に腹肉もたるんでいる。アスカは上半身は貧乳でスリムだが、下半身はレイ並みにデカい下半身デブ。\nレイは大きく下品な音の屁(茶色ガス)\nアスカもおっさんのような豪快な音の屁(黄色ガス)\n\n構図https://www.pixiv.net/artworks/128349409のような余りある尻肉が変形するほど押し付け合い小柄なシンジは資料の真ん中の人のような状態。\n※可能であれば、端に2人のまん丸巨尻のみドアップのワイプもお願いしたいです！\n\n①レイの屁が臭すぎると指摘するアスカにそちらの方が臭いと言い返すレイ。間に挟まるシンジはそもそも2人の尻が臭すぎて苦しんでいる。互いに貧乳デカケツ、デカケツデブなどと揶揄しあってるところに腹が鳴り屁が出そうになる。\n\n②資料のような隙間から吹き出る特大放屁。アスカは気持ちよさそうなオホ顔でレイは無表情ながらも力み気味な顔。「屁ぇでる！❤」やふんっ！❤と下品な放屁時の台詞も。\n\n③怒ったシンジによるお仕置き(ここからはシンジは台詞のみ)距離は少し離れ。互いのアナルに極太透明チューブを挿入。そんなに比べたきゃ腹ん中で比べあえ！と互いに屁をこきあい交換し合う形に。\nお互いの屁で少し膨れる腹に、チューブ内も黄色茶色の屁が入り混じっている。\nアスカはさらに激しいオホ顔で苦しみ、レイも若干のオホ顔。\nアナル部分のみ破けたワイプでは、普通に屁をこいてるような描写\n\n④追加攻撃で自分達の屁が染み付いた汚パンツを頭に被せられる。2人ともあまりの臭さに「んほぉ！？❤」「ほぎょぉ！？❤」と苦しみながら、レイも無表情崩れる強烈なオホ顔。苦しみながらも匂いにフゴフゴ鼻息荒く興奮しており。乳首や股間をいじりながらオナニーしだし、屁も更に勢い増しチューブの隙間からも漏れている。臭いに興奮するドスケベっぷりをシンジに揶揄される。\n\n⑤我慢の限界で脱糞までしてしまう。チューブの隙間から屁も吹き出しながら、気持ちよさそうにチューブ膨らませ大量うんこを互いに送り込む。アスカは苦しそうなオホ顔オホ声でさらに膨腹。レイも普段とギャップ激しいオホ顔野太いオホ声で膨腹。シンジはこれでこりただろうと満足げ。\n\n⑥数日後、反省どころか汚パンツや屁の臭いに夢中になり、今度は互いのパンツを被り合い、屁を四方八方に噴射しまくりながら、プラグスーツを膨らます着衣脱糞(変色なし)ドスケベな顔で鼻息荒くパンツや屁を嗅ぎながらオナニーしまくる2人に呆れるシンジの台詞。\n\n以上となります。特殊なシチュなのと、色々差分あり恐縮ですが、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/7", "thumbnail_src": "https://si.imgix.net/5880a0af/uploads/origins/433e5fe3-93a6-46e7-9b77-8f286b795357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfef802585756d68c8a3a1e93076e84", "thumbnail_srcset": "https://si.imgix.net/5880a0af/uploads/origins/433e5fe3-93a6-46e7-9b77-8f286b795357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfef802585756d68c8a3a1e93076e84, https://si.imgix.net/5880a0af/uploads/origins/433e5fe3-93a6-46e7-9b77-8f286b795357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdee7897ca574afd1bac95e21b0bc092 2x, https://si.imgix.net/5880a0af/uploads/origins/433e5fe3-93a6-46e7-9b77-8f286b795357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e52ba59df194c4c096f7ec0c209a1346 3x", "genre": "art", "nsfw": true, "body": "巨大化できる全裸つるぺた幼女が変態な善行を行うイメージでお願いします。\n\n・乾燥していて大火事が発生し、水不足で消火できないので巨大全裸幼女が両手でクパァしながら下品なガニ股立ちションによる物凄い超大量放尿で大火事を消火する感じです。\n超能力で温かい水をいくらでも生み出せるので火を消すまで無限放尿できる。\n\n・炎だけではなく貯水池か川なども描く余裕があればですが、ついでに飲める聖水で満たして地域の水不足も解消する感じでお願いします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/6", "thumbnail_src": "https://si.imgix.net/6d8737dc/uploads/origins/4c8bdd5b-7437-4c2b-b4a7-56d1e1198469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dfdee24d2a0c3442848ac81f7c47705", "thumbnail_srcset": "https://si.imgix.net/6d8737dc/uploads/origins/4c8bdd5b-7437-4c2b-b4a7-56d1e1198469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dfdee24d2a0c3442848ac81f7c47705, https://si.imgix.net/6d8737dc/uploads/origins/4c8bdd5b-7437-4c2b-b4a7-56d1e1198469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e938fc5c44e5697d2e5972838c0b0399 2x, https://si.imgix.net/6d8737dc/uploads/origins/4c8bdd5b-7437-4c2b-b4a7-56d1e1198469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff9bf14eb5d4c406076e0c15f7328d3d 3x", "genre": "art", "nsfw": true, "body": "もしも作者様の描いたオリジナルメスガキが様々な超能力を得たらで、変態な善行を行うイメージです。\n\n・絵の前の設定イメージですが作者様にお任せします。\n太陽光など様々なエネルギーを養分にしたり出来るが、変態男達の性欲はオヤツ的な美味しさでかなりパワーアップできる。\n超能力の一つで全裸の園児や小学低学年の姿を入れ替えられる永遠の幼女で美しい肌をしていて乳首・お股・肛門はキレイなピンク色。\n変態男達と共に荒地に行って全員にハッキリ見せつける為に超能力で巨大化して物凄い全裸排泄を見せつけて変態男達を興奮させながら大地を豊かにする。\n様々な超能力が使えるのでやりたい放題なイメージです。\n\nO絵のイメージですがお任せします。\n・画面は変態男の視界な感じですがお任せします。\n「変態さん達の性欲を貰うね♡私の絶壁で美しい裸と凄い排泄で興奮してね♡」な感じで、\n仰向けで寝転がって全裸大開脚している巨大幼女が超能力で人間には物理上不可能な凄い排泄をしていて柔らかい肛門を胴の半径に匹敵するか上回る広がり方をしながら自身の体積を上回る超極太カチカチ超特大一本グソの排便を見せつけてあげている絵をお願いします。\n\n・作者様に余裕があればですが、変態男達に温かい聖水風呂やおしっ湖をプレゼントする為に勢いが強く自身の体積を超えるギャグ漫画的な超大量放尿を見せつけてあげているのか、\n片方の絶壁乳首に1人の変態男にミルクの出ない授乳プレイをしてあげているのかはお任せします。\n\n作者様、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/5", "thumbnail_src": "https://si.imgix.net/935dc2b7/uploads/origins/45086de7-0628-4d2a-994b-31c35386f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697f303e929a8d3fa5c9c3f4ff6d621d", "thumbnail_srcset": "https://si.imgix.net/935dc2b7/uploads/origins/45086de7-0628-4d2a-994b-31c35386f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697f303e929a8d3fa5c9c3f4ff6d621d, https://si.imgix.net/935dc2b7/uploads/origins/45086de7-0628-4d2a-994b-31c35386f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=316e16c74f93905bcaaf57493f8ce47b 2x, https://si.imgix.net/935dc2b7/uploads/origins/45086de7-0628-4d2a-994b-31c35386f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=116f53fc535f4d4ace57f039187eb3b1 3x", "genre": "comic", "nsfw": true, "body": "こんばんは、以前は大変お世話になりました。\n風来のシレン2のキララをお願いしたいです。\n（https://media.spike-chunsoft.co.jp/pages/games/shiren2/images/character09.gif）\n（https://i.ytimg.com/vi/8W7dXMPtyu8/maxresdefault.jpg）のサムネイル（左から2番め）\n\nベースは貴方様のイラストでご依頼します。\n（https://sp.nijie.info/view.php?id=597222）\n\n以下、私からの要望。\n-------------------\nセリフはいらないです。\n等身は元イラストと違いますが、ベースの等身で合わせて下さい。\n乳首とおまんこの書き方はこれでお願いします。\n乳首の色は元イラストの肌色をベースに濃いめ（2段階ぐらい沈殿色？）でお願いします。\n表情は（https://i.ytimg.com/vi/8W7dXMPtyu8/maxresdefault.jpg）を再現して下さい。\nもちろん、パンツも元イラストでお願いします。\n\n資料は上記のほか「風来のシレン2　キララ」でGoogle画像検索すれば出てきます、参考にして下さい。\n以上です、ご一考お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/4", "thumbnail_src": "https://si.imgix.net/6305a7a6/uploads/origins/ddc3d97a-0d29-4a6a-ba6a-83f475e3ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a23ef348a465d941ef7e01fdbf5fbb7b", "thumbnail_srcset": "https://si.imgix.net/6305a7a6/uploads/origins/ddc3d97a-0d29-4a6a-ba6a-83f475e3ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a23ef348a465d941ef7e01fdbf5fbb7b, https://si.imgix.net/6305a7a6/uploads/origins/ddc3d97a-0d29-4a6a-ba6a-83f475e3ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a18b20e62e2b49ac249bc300e37d1b5 2x, https://si.imgix.net/6305a7a6/uploads/origins/ddc3d97a-0d29-4a6a-ba6a-83f475e3ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c28d1f5269c95b01dd094559196fdbf6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/3", "thumbnail_src": "https://si.imgix.net/75327acc/uploads/origins/f793d33b-4c9f-459d-9b77-9273b4f281fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5cb23f166b0698158c38154aed668ee", "thumbnail_srcset": "https://si.imgix.net/75327acc/uploads/origins/f793d33b-4c9f-459d-9b77-9273b4f281fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5cb23f166b0698158c38154aed668ee, https://si.imgix.net/75327acc/uploads/origins/f793d33b-4c9f-459d-9b77-9273b4f281fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64e115fee7de4684474721464cd617cc 2x, https://si.imgix.net/75327acc/uploads/origins/f793d33b-4c9f-459d-9b77-9273b4f281fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fd5668bc1b55e7ce8d84346c09d4c5a 3x", "genre": "art", "nsfw": true, "body": "こんばんは、はじめまして。\nがんばれゴエモンの帯ひろ志版「ヤエ」（https://m.media-amazon.com/images/I/51SJ+rKr9UL._AC_UF1000,1000_QL80_.jpg）をお願いしたいです。\n\n貴方様の作品（https://www.pixiv.net/artworks/114217565）のオマンコの描き方に惚れ込んでのリクエストです。\n構図は上の作品の構図で、パンツはいりません。\n\n以下、私からの要望。\n・体つき（スリーサイズ）を維持して下さい。\n参考（https://cdn.clipkit.co/tenants/1415/item_images/images/001/533/882/medium/f2a6c25f-33f8-439a-9ff7-1314af546beb.jpg?1469952969）\n\n・表情は照れて目線をこっちに合わせる感じでお願いします。\n・カラーは出来るだけ漫画版に準じた色合いでお願いします。\n・頭、顔も見える構図にして下さい。\n・乳首の色は上記の通り、オマンコ及び尻穴の描き方は貴方様の（https://www.pixiv.net/artworks/110864388）の形ででお願いします。\n・陰毛及び尻毛の描き方も上記の通りで、髪色と同じ色か近い色合いにして下さい。\n・まん汁は垂らして下さい。\n・まんかすは要らないです。\n\n資料の検索結果のURLが長いので「帯ひろ志　ヤエ」でググっていただけると助かります。\n帯ひろ志テイストを維持しつつ描いてくれたら嬉しいです。\n\n注文が多いですが、御検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/2", "thumbnail_src": "https://si.imgix.net/56d79da0/uploads/origins/dd43c7cd-3d4e-48a2-8332-d156c12bc759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=444e6882d0606c9c4dbc6fd8d4db76ca", "thumbnail_srcset": "https://si.imgix.net/56d79da0/uploads/origins/dd43c7cd-3d4e-48a2-8332-d156c12bc759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=444e6882d0606c9c4dbc6fd8d4db76ca, https://si.imgix.net/56d79da0/uploads/origins/dd43c7cd-3d4e-48a2-8332-d156c12bc759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4debf2a453dae7cc18c08f8073aaae4b 2x, https://si.imgix.net/56d79da0/uploads/origins/dd43c7cd-3d4e-48a2-8332-d156c12bc759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3afc1f5d4ecad62d2578f4ad4899b750 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mottiri_yarou/works/1", "thumbnail_src": "https://si.imgix.net/57a0c4db/uploads/origins/52825b0e-1f19-4140-915e-b5300a58873c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0831bc10bb9cbb9dace074ebe18d38b7", "thumbnail_srcset": "https://si.imgix.net/57a0c4db/uploads/origins/52825b0e-1f19-4140-915e-b5300a58873c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0831bc10bb9cbb9dace074ebe18d38b7, https://si.imgix.net/57a0c4db/uploads/origins/52825b0e-1f19-4140-915e-b5300a58873c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c16df750fe72ed2542519c6af9818d3e 2x, https://si.imgix.net/57a0c4db/uploads/origins/52825b0e-1f19-4140-915e-b5300a58873c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03faccd0b4ad29f4ef643511cb331672 3x", "genre": "art", "nsfw": true, "body": "オリモノが膣からビロローーンと垂れているのをお願いします。\n形をもって固まりそうなくらい粘り気の強い大量のオリモノが、膣の奥から伸びてぶら下がっている感じ。\n茶髪ギャル系ｊｋがうんこ座りでこっちを見ながら、自らピースくぱぁして尿道まで丸見え状態。\n膣も開き気味で、奥からオリモノが出てきている。\nデロデロに汚れたパンティは片脚太ももにかけて、クロッチが見えるように。\n毛は上部のみ生えかけの極薄で。\n構図や姿勢など厳しければ、変更してくださって結構です。\n\n中出し精液と見分けがつかないかもしれないので、絵の中に「オリモノ」と分かる文言を入れても結構です。", "created_at": "", "completed_at": ""}]}