1f5-416b-ad58-c077cf68072c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984ab004fe1fe69d072f0ab2283925c3", "thumbnail_srcset": "https://si.imgix.net/83ce969a/uploads/origins/5578dda8-a1f5-416b-ad58-c077cf68072c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984ab004fe1fe69d072f0ab2283925c3, https://si.imgix.net/83ce969a/uploads/origins/5578dda8-a1f5-416b-ad58-c077cf68072c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dda61ee4516f782cd701bd59f3ae7f34 2x, https://si.imgix.net/83ce969a/uploads/origins/5578dda8-a1f5-416b-ad58-c077cf68072c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a460e58a108dc3db224abb51b741bfb 3x", "genre": "art", "nsfw": false, "body": "コミケの際はありがとうございました。\nイラスト本素晴らしい出来栄えでした。今回skeb再開したとのことでリクエスト送らせていただきます。\n\nキャラクター：艦これの愛宕\n衣装：2023年の三越コラボの大和風　元イラストよりスカートは短めで黒のロングブーツ\n参考：https://i.imgur.com/THZNyIT.jpg\n\n衣装のアレンジ、背景、ポーズ等諸々はお任せしますが全身絵だとうれしいです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hatomaru56/works/10", "thumbnail_src": "https://si.imgix.net/fc29feac/uploads/origins/e4538e45-c821-4fab-927e-6dcd96abccbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dcb300924ed95374a18b83ce75c5ab3", "thumbnail_srcset": "https://si.imgix.net/fc29feac/uploads/origins/e4538e45-c821-4fab-927e-6dcd96abccbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dcb300924ed95374a18b83ce75c5ab3, https://si.imgix.net/fc29feac/uploads/origins/e4538e45-c821-4fab-927e-6dcd96abccbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1062145318fdf72b73493929b1cf7f05 2x, https://si.imgix.net/fc29feac/uploads/origins/e4538e45-c821-4fab-927e-6dcd96abccbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aeba3cb2ab56133aacb7ed8e326f40d1 3x", "genre": "art", "nsfw": false, "body": "はとまる様\n\nはじめまして。\nこの度艦娘ちゃんでなく申し訳ないのですが、VTuberの1枚絵を依頼したくご