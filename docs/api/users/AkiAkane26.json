 "2026-02-15T12:43:14.797671+00:00"}, {"amount": 14000, "recorded_at": "2026-02-15T23:04:38.434320+00:00"}, {"amount": 9000, "recorded_at": "2026-02-16T18:09:12.278019+00:00"}, {"amount": 7000, "recorded_at": "2026-02-17T03:33:41.620349+00:00"}, {"amount": 9000, "recorded_at": "2026-02-18T01:08:12.595792+00:00"}, {"amount": 16000, "recorded_at": "2026-02-18T13:47:46.789564+00:00"}, {"amount": 15000, "recorded_at": "2026-02-18T21:38:04.596622+00:00"}, {"amount": 16000, "recorded_at": "2026-02-19T02:10:07.753763+00:00"}, {"amount": 10000, "recorded_at": "2026-02-19T08:27:17.625069+00:00"}, {"amount": 16000, "recorded_at": "2026-02-19T15:20:36.768034+00:00"}, {"amount": 8000, "recorded_at": "2026-02-20T00:19:35.610669+00:00"}, {"amount": 13000, "recorded_at": "2026-02-20T11:14:12.509420+00:00"}]}, "current_prices": {"art": 13000, "comic": 13000}, "price_range": {"art": {"min": 7000, "max": 18000}, "comic": {"min": 7000, "max": 17000}}, "links": [{"label": "Twitter", "url": "https://x.com/AkiAkane26", "name": "AkiAkane26"}, {"label": "Misskey_io", "url": "https://misskey.io/@AkiAkane13", "name": "AkiAkane13"}], "flags": {}, "works": [{"path": "/@AkiAkane26/works/42", "thumbnail_src": "https://si.imgix.net/992cf11f/uploads/origins/6d22906e-dac8-4c6b-92cc-3661ee9a6d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3fa2546874d6f55178526baf2dc059c", "thumbnail_srcset": "https://si.imgix.net/992cf11f/uploads/origins/6d22906e-dac8-4c6b-92cc-3661ee9a6d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3fa2546874d6f55178526baf2dc059c, https://si.imgix.net/992cf11f/uploads/origins/6d22906e-dac8-4c6b-92cc-3661ee9a6d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=551db3bf8a24d1a8a2907921c916133a 2x, https://si.imgix.net/992cf11f/uploads/origins/6d22906e-dac8-4c6b-92cc-3661ee9a6d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eecb929f82502a27e453418fca6fd544 3x", "genre": "art", "nsfw": true, "body": "うちの子のイラストを描いて頂きたく依頼しました。\n\n[内容]\n\n女性上位な雰囲気で前立腺責め手コキや逆アナル、射精管理など\n資料を参考にマゾシチュの複数構図をお願いしたいです。\n\n竿役は髪あり目なしのモブだとうれしいです。\n\nうちの子は馬ちんぽふたなりが生えた感じでお願いします。\n髪型は資料の様な「二つ結びのおさげ」でお願いします。\n衣装はお任せします。衣装で分かりづらい点は描きやすい様にしてください。\n\n『眼鏡』は掛けさせてください。\n\nよろしくお願いします。\n\n[用途]\n\n依頼用資料や紹介としてSNSやドライブ等のストレージ、\nコミュニケーションツール(ディスコ等)で利用させていただければと思います。\n\n可能でしたらPSDファイルで納品お願いします。\n宛名なしも別ファイル(png可)にて納品お願いします。\n\n[設定・資料]\n\nアンニュイな雰囲気のダウナー系。\n小柄、薄め、眠そうな目、敬語キャラ、天然。\nかわいい服装と素麺が好き。\n\nキャラクター資料\nhttps://www.dropbox.com/scl/fo/mb7nph4pl6uuz4gez71tf/AH-PYx6PR7U1_5y-7O-QXa0?rlkey=qmfdtbuh6aezc43oj7lv9ics8&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/41", "thumbnail_src": "https://si.imgix.net/ba401ac4/uploads/origins/d7f54380-2883-4fbc-b697-113a7b8b518a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261a489997a86a7b21143462a1c9a451", "thumbnail_srcset": "https://si.imgix.net/ba401ac4/uploads/origins/d7f54380-2883-4fbc-b697-113a7b8b518a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261a489997a86a7b21143462a1c9a451, https://si.imgix.net/ba401ac4/uploads/origins/d7f54380-2883-4fbc-b697-113a7b8b518a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76a64f368afafeedc0e08bef734e1e62 2x, https://si.imgix.net/ba401ac4/uploads/origins/d7f54380-2883-4fbc-b697-113a7b8b518a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8af4684d73557559c93fb9e32d339e19 3x", "genre": "art", "nsfw": true, "body": "キャンペーンに合わせて依頼させて頂きます\n\n\n■キャラ\nポケモンレジェンズZAよりカナリィ\nhttps://www.pokemon.co.jp/ex/legends_z-a/ja/characters/251106_01/\nhttps://arceus-sokuho.com/wp-content/uploads/2025/10/1760735444382.jpg\n\n\n■シチュ概要、構図\n足下から見上げる煽りの尻フェチアングル+見返りの構図\n褐色ギャルの煮卵プリケツでカナ友(リスナー)のオタクくんを誘惑挑発する感じ\n\n・マスクのまま目を細めたニヤニヤスケベ顔\n\n・グイッと捲り降ろした半脱ぎワイドパンツの縁に乗っけるように桃尻〜モリマン気味のアソコを見せつけるような股間突き出し、片手を尻たぶに添えつつ指でセルフアナルくぱぁ（長時間配信の後で引き籠もり配信ギャルのエロくさ体臭が籠もって蒸れている)\n　※もう片手は後述の差分用に不自然じゃない形で何かを摘めるような感じに上げている\n\n・胸元のチューブトップをずり上げておっぱいも露出\n\n・パンツは煮卵ケツが強調されるTでアナルチラ+後述の脱ぎ差分見据えたハイレグ気味のサイド紐\n　カナリィの服から配色を取った縞柄でギャルっぽい感じの物\n\n\n■差分希望\n　・顔：顎マスクでリップの口元が見える状態\n　・尻～股間：ノーパン　アナル周りが肌色を少し濃くしつつ薄っすら青黒くくすんだ系、乳首や肛門などの粘膜は明るめ薄ピンクのアポロチョコ系な配色\n　　　　　　　脱ぎ解いた紐パンツは空いたもう片手で(当人的には)ばっちぃ物でも摘むようにぶら下げてクロッチが見えている\n　・陰毛ありver：濃さは並程度だが配信で処理してなくてパンツ穿いててもハミ毛+アナルは更に薄くちょろちょろ生えてる感じ　※金髪想定ですが仕上げが上手くいかなさそうなら黒でもよいです\n　・パンツ：着用状態の尻股間、脱いで手に持った状態両方で　蒸れた湯気や擬音、クロッチ周りの汗じみやトイレ跡の薄黄色汚れ　更に手に持った方のクロッチ面にマンカスっぽい汚れや縮れた抜け陰毛\n\n■台詞\n　ここはできれば程度で、もし秋赤音さんがZAプレイされてたり配信でキャラをご存知ならシチュエーションに合う台詞をお好みでお願いします\n\n\n以上、ご検討の程よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/40", "thumbnail_src": "https://si.imgix.net/2dcb4154/uploads/origins/d790dfce-037f-44ea-8a66-52eb76fd90db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc0fcbe51f807926683ff636a4956333", "thumbnail_srcset": "https://si.imgix.net/2dcb4154/uploads/origins/d790dfce-037f-44ea-8a66-52eb76fd90db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc0fcbe51f807926683ff636a4956333, https://si.imgix.net/2dcb4154/uploads/origins/d790dfce-037f-44ea-8a66-52eb76fd90db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01a7b00e775c6430a7df70ac00525564 2x, https://si.imgix.net/2dcb4154/uploads/origins/d790dfce-037f-44ea-8a66-52eb76fd90db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=816d206d1100edc5c2927f19e98dbc4a 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n以前キャラデザして頂いた「ゆうり珠璃」と同じテキスト作品（続編）に登場する別キャラクターのデザインをお願いしたくリクエストさせてもらいました。\nテキスト作品のクリエイター様には自由にイラスト化OKとの許可を頂いております。\n広義での「うちの子」「OC」という解釈でキャンペーン対象となるか分かりませんが、ご都合諸々が大丈夫そうでしたら是非よろしくお願いします。\n\nキャラの設定ですが原作クリエイター様より参考文を頂いております（テキスト作品は資料URL参照）\n\n■名前\n大河寅子　オオカワトラコ\n\n■年齢\n高校三年生（すでに誕生月を迎えて成人済み）\n\n■外見\n・身長140センチ代半ば〜後半ぐらい。\n同じチビだけど、小夜は華奢な小学生。寅子は小柄な中学生ぐらいのイメージ。\n\n・ちっちゃいくせにわりと筋肉質。腹筋割れてる。\n・動きやすさ重視のベリーショート\n・褐色肌（地黒or日焼け？ 未定）\n・貧乳\n・胸のサイズ順、小夜＜【寅子】＜珠璃＜ポニテ＜亜矢\n・パフィーニップル\n・色黒だけど乳首はピンク\n\n■格闘スタイル\n・子供のころからフルコン空手をやっていた。\n・前方への加速力がすごい。一瞬で接近戦に持ち込むダッシュ力。\n・弱点は低身長。それによるリーチ差を補うためにダッシュ力を鍛えた。\n・接近してのボディ連打→相手が下がったところに回し蹴り、が勝ちパターン。\n・それを知っている相手にリーチの差で手堅く攻められると勝てない。\n・亜矢にも勝てない。機動力で負けていて、なかなか勝ちパターンに持ち込めないから。前回の試合では、「距離を詰めてボディ連打」までは持ち込んだが、逃げられてしまった。\n・次に戦うときは高低差のある攻撃で揺さぶるために、長身の亜矢も捕まえられるハイキックを練習中。\n・「趣味で週一でジム通ってます」ぐらいのアマ格女子より強い。「本気でプロ練してます」みたいな大人には勝てない。\n・寝技、組技は素人。選択体育が柔道だったので受け身ぐらいはできる。「なんでウチの学校、選択に『空手』がないんスか〜！」とかいって真面目に受けてなかった。その後、ブロウルブロッサムに出場するようになって、組技に興味を持つ。\n\n■ファッション\n・あまりこだわらない。そっけなくてシンプルなのが好み。\n・中学生時代のジャージとかを部屋着にしてる。\n・試合では空手着着用。\n・プリンス・カラテ：空手着＋目元を隠す仮面的なもの\n\nマダム・ジュードーとプリンス・カラテでコンビを組んで、亜矢を救出に行く。\n拘束を解かれ、アイマスクを外した亜矢が最初に目にするのがプリンス・カラテ。窮地の自分を助けてくれた王子様。一瞬、すごく格好良く見える。恋の芽生え？\n「あ、な〜んだ、寅子ちゃんか……」と我に返るけど、不思議な気持ちが残る。\n\n・黒サキュバス：褐色肌に白テープ。\n\n「トラちゃん……かっこいいよ。ホワイトタイガーみたい……」\n「それ、白地に黒縞じゃありませんでしたっけ……？」\n「じゃあ……ブラックタイガー……？」\n「それはエビの名前ッス！！！！」\n\n■メモ\n・亜矢が好き。本気でレズなのか、憧れ的なものなのかは本人も不明。かっこいい男子には普通にドキドキしたりする。放っておくと大学の新歓で悪い先輩に喰われそう。\n\n・小夜にAVに売られる。「この子、もう成人してるから大丈夫」\n\n・性格が真っ直ぐすぎて勝てない。経験不足＆駆け引きが苦手。小夜がセコンドについて、格ゲーキャラを操作するかのように指示を出されて格上の相手に勝つ。\n\n・色白×黒テープの小夜、地黒×白テープの寅子でサキュバスコンビ。\n\n・一人称：基本「自分」、甘えるときは「トラ子」、家族に対しては「あたし」\n・呼び方：小夜さん、歌彩さん、アヤ＝チャンさん（試合時）、ゆうりさん\n・呼ばれ方：トラちゃん（小夜）、大河さん（亜矢）\n\n・ポケットタイガー、ミニトラ、チビトラ、ロケットタイガー、ラピッドタイガー、ポケットロケット、タイニータイガー、なんかそのへんの「ちっちゃい」「速い」「虎」あたりのワードでリングネーム。ポケロケ寅子。\n\nhttps://skeb.jp/@shrimp_swamp/works/34", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/39", "thumbnail_src": "https://si.imgix.net/a210eb90/uploads/origins/e93a2034-08c0-40b1-96c4-9da9fedb9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf53aa69960562b2be6eceb567631e7", "thumbnail_srcset": "https://si.imgix.net/a210eb90/uploads/origins/e93a2034-08c0-40b1-96c4-9da9fedb9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf53aa69960562b2be6eceb567631e7, https://si.imgix.net/a210eb90/uploads/origins/e93a2034-08c0-40b1-96c4-9da9fedb9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9444b65b9418bff94a0f15d62f5b3a3 2x, https://si.imgix.net/a210eb90/uploads/origins/e93a2034-08c0-40b1-96c4-9da9fedb9f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8abdecd5aa39eebb20335198f49a5de0 3x", "genre": "art", "nsfw": true, "body": "以前リクエストさせてもらった　うちの子　作品の仕上げをお願いできますでしょうか。\n\nhttps://skeb.jp/@AkiAkane52/works/135\n\n可能あれば\n\n立ち絵、エロ蹲踞の分割\n\n通常ギャルと日焼けギャル風　\n\nマイクロビキニずり下がり乳首だし\n\n\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/38", "thumbnail_src": "https://si.imgix.net/6e4049ab/uploads/origins/1406eab9-a1e9-49e7-9c72-30aa4d8d8d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f64928a0d47fbb67304a87396a5665", "thumbnail_srcset": "https://si.imgix.net/6e4049ab/uploads/origins/1406eab9-a1e9-49e7-9c72-30aa4d8d8d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f64928a0d47fbb67304a87396a5665, https://si.imgix.net/6e4049ab/uploads/origins/1406eab9-a1e9-49e7-9c72-30aa4d8d8d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=716918d9a1c26452a78e5984b14ff912 2x, https://si.imgix.net/6e4049ab/uploads/origins/1406eab9-a1e9-49e7-9c72-30aa4d8d8d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d73c37bd25326c467f0562ee0fc85a9 3x", "genre": "art", "nsfw": true, "body": "「うちの子、OC(オリキャラ)」リクエストキャンペーンとのことで開設ありがとうございます\n\n前回依頼した魔法学園風お嬢様vsライバルのノーパン羞恥攻め分岐含む3Pの仕上げ化をお願いできますでしょうか\nhttps://skeb.jp/@AkiAkane52/works/111\n\n他垢からの続きで最初から仕上げ工程とのことですが、以前最初から一発仕上げでお願いした竜胆尊様等と比較して工数換算が難しかったので一旦の目安で送らせて頂きます　不足の場合は条件付き再送をご検討ください\n\n例によって羞恥の表情や股間〜アナル周りや陰毛、パンツの描写(蒸れ感、パンツの描き込みやクロッチの汚れ、付着した抜け陰毛などの生々しさ)に注力頂けると嬉しいです(余力があればパンツのカラバリやクロッチ汚れ等でバリエーションを付けて頂けると嬉しいです)\n\n以上、ご検討の程よろしくお願いいたします\n\nhttps://skeb.jp/@AkiAkane52/works/111", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/37", "thumbnail_src": "https://si.imgix.net/2931d036/uploads/origins/0beb70c1-7945-472f-80f1-60667906a26a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=332083b6b0b9f09f075649ed83462e08", "thumbnail_srcset": "https://si.imgix.net/2931d036/uploads/origins/0beb70c1-7945-472f-80f1-60667906a26a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=332083b6b0b9f09f075649ed83462e08, https://si.imgix.net/2931d036/uploads/origins/0beb70c1-7945-472f-80f1-60667906a26a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=516bf346bba3216a64e5c704f5894d85 2x, https://si.imgix.net/2931d036/uploads/origins/0beb70c1-7945-472f-80f1-60667906a26a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56e72d7787924f6dbc322ec3bdfbb42c 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます\nまたリクエストさせてください\n\nキャラクター\n過去に描いていただいたコンドームを買う少女\nhttps://skeb.jp/@AkiAkane52/works/11\nhttps://skeb.jp/@AkiAkane26/works/27\n\n衣装(元絵で着用しているものと同じものです)\n･純白のブラウス+黒いプリーツスカート(夏服の制服のイメージです)\n･ひざ下丈の紺色のハイソックス\n\n内容\n所謂うちの子の資料として、上記の子の設定画を描いていただきたいです\n\n条件等\n･正面と真後ろの二面図、もしくはそれに真横からの立ち絵を含めた三面図を描く\n･ブラウス等、着衣の白色はhttps://skeb.jp/@AkiAkane26/works/11のパーカーと同じ色合いのものにする\n\n上記以外についてはおまかせします\n\n使用目的\nskebやpixivリクエスト等、有償リクエストの参考資料として使わせていただく予定です\n\nその他\npsd形式での納品を希望します\n\nもし依頼内容に問題があれば即キャンセルしていただいて構いませんので、改めてよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/36", "thumbnail_src": "https://si.imgix.net/6acfc007/uploads/origins/8fc92b75-eb99-45b5-8ecc-f8ef756888e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a16d07a0996628f79bf14b20c9067f5f", "thumbnail_srcset": "https://si.imgix.net/6acfc007/uploads/origins/8fc92b75-eb99-45b5-8ecc-f8ef756888e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a16d07a0996628f79bf14b20c9067f5f, https://si.imgix.net/6acfc007/uploads/origins/8fc92b75-eb99-45b5-8ecc-f8ef756888e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25361b69e4d21fb15e88c404ee0de186 2x, https://si.imgix.net/6acfc007/uploads/origins/8fc92b75-eb99-45b5-8ecc-f8ef756888e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22b5e1294906469661ae2ecd9788f11c 3x", "genre": "art", "nsfw": true, "body": "秋巳ちゃんとうちの子レインを描いていただけないでしょうか。\n\n\nキャラ：\n・レイン（資料URLご参照ください）\n・秋巳ちゃん（男の子、https://skeb.jp/@SWakimi_hi）\n女の子恰好は元から好きでやっている 堕ち前は優しく真面目(堕ち依頼もよくしているため)\n 酒呑童子の京言葉にならない程度の大阪寄り\n身長165cm\nチン長（https://www.pixiv.net/artworks/113815379　2枚目参照）\n\n\n衣装指定：\n　・レイン：参考資料のアメスク\n　・秋巳ちゃん：参考資料の魔法少女服\n\n構図：\n・複数カットを1枚にまとめた形で\n縦長大コマにフェラ尻（①）\nその横に\n秋巳ちゃん表情アップ（②）\nうちのこ表情アップ（③）のコマを縦に置く感じを想定しています。\n\n構図説明等：\n①フェラ大コマ\n秋巳ちゃん\n・「どこかの室内で、何か」に座って足を開いている\n・手はスカートをたくし上げるように握っている、または、後ろについて体を支えている\n・表情はトロ顔(気持ちよさに負けちゃってる感じ)\n\nレイン\n・秋巳ちゃんの足の間に入りフェラしている\n・両膝をついてお尻を画面手前側に向けている\n・スカートは捲れていて食い込み強めのTバック尻\n・ムチムチ感増し\n\n②秋巳ちゃん表情アップ\n・①とは別カットの秋巳ちゃんのトロ顔かイキ顔\n・とにかくエッチな感じでお願いします\n\n③レイン表情アップ\n・ちんちんとうちのこのフェラ顔\n・とにかくエッチな感じでお願いします\n・詳細はお任せ\n\n\nその他要望など\n・室内想定なので靴は無しでお願いします\n・擬音や喘ぎなどアリでお願いします\n・他はお任せでお願いします\n\n\n依頼用資料や紹介としてSNSやドライブ等のストレージ、コミュニケーションツール（ディスコ等）で利用させていただければと思います。\nまた、OCをお借りした方へ連携いたします。\n\nご検討のほどよろしくお願いいたします。\n\n参考資料\nhttps://drive.google.com/drive/folders/12hQkWCHuDgTLgYSXML6RWRF0Gd6CnGzL", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/35", "thumbnail_src": "https://si.imgix.net/1cc69742/uploads/origins/e08e6672-6982-4c70-820e-fbca83e263a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad121b956405da674b17184cbf4ca13", "thumbnail_srcset": "https://si.imgix.net/1cc69742/uploads/origins/e08e6672-6982-4c70-820e-fbca83e263a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad121b956405da674b17184cbf4ca13, https://si.imgix.net/1cc69742/uploads/origins/e08e6672-6982-4c70-820e-fbca83e263a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ddae42173b9872884e5cc90d12fa166 2x, https://si.imgix.net/1cc69742/uploads/origins/e08e6672-6982-4c70-820e-fbca83e263a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18a0ea12611f12fdbddfbdac3dc635f0 3x", "genre": "art", "nsfw": true, "body": "もしよろしければNTRイラスト作って頂きたく依頼したくリクエストします\n\n■キャラは魔法少女リリカルなのはStrikerSからヴィータちゃんを\n\n■衣装はhttps://www.nanoha.com/archive3/character/vita.html#の赤い服でお願いします\n\n〇上役に弱みを握られて愛人契約からのご奉仕騎乗位NTRSEX中のヴィータちゃんのイラストを希望します\n☆接合部はスカートで隠れている見せない構図で使用済みゴムを幾つか用意して連戦を演出して頂きたいです\n☆表情は悔しさや怒りを感じながらもイキまくってる事がわかる物をお願いします\n\nもし良ければリクエストお受けしていただけると嬉しいです、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-zs3qEOEPDO5WmRCNEOXFbmpSG8mkEQZ?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/34", "thumbnail_src": "https://si.imgix.net/26d2da20/uploads/origins/418c77e6-d8f3-4caa-a7e8-fb5be60042aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f22826473c83ca34684c510e190300e4", "thumbnail_srcset": "https://si.imgix.net/26d2da20/uploads/origins/418c77e6-d8f3-4caa-a7e8-fb5be60042aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f22826473c83ca34684c510e190300e4, https://si.imgix.net/26d2da20/uploads/origins/418c77e6-d8f3-4caa-a7e8-fb5be60042aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=106e87ddf5ea8c0f6de200dc82e98446 2x, https://si.imgix.net/26d2da20/uploads/origins/418c77e6-d8f3-4caa-a7e8-fb5be60042aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1337674b5b673b178b2d62534ebfe2a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/33", "thumbnail_src": "https://si.imgix.net/59d0e3a1/uploads/origins/812845ba-ecaf-48ac-abac-62d7e25a34ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f6561f9325af5377f02afe4da84c3ea", "thumbnail_srcset": "https://si.imgix.net/59d0e3a1/uploads/origins/812845ba-ecaf-48ac-abac-62d7e25a34ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f6561f9325af5377f02afe4da84c3ea, https://si.imgix.net/59d0e3a1/uploads/origins/812845ba-ecaf-48ac-abac-62d7e25a34ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9d43549166b9f592767acb861c85a17 2x, https://si.imgix.net/59d0e3a1/uploads/origins/812845ba-ecaf-48ac-abac-62d7e25a34ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f617e3e9ebe4dc9196d337e31dc74aa 3x", "genre": "art", "nsfw": true, "body": "ラフ絵垢でもお世話になっております、募集再開ありがとうございます\n過去依頼でにじさんじ竜胆尊さまやアナル舐め手コキを描かれてるのを見て依頼させて頂きました\nhttps://skeb.jp/@AkiAkane26/works/4\nhttps://skeb.jp/@AkiAkane26/works/1\n\n※納品について、可能ならレイヤー未結合のpsdで、ラフやボツが出ればそのレイヤーも残しておいてくださると嬉しいです(個人の楽しみの範疇でそういうのを見るのも好きなので)\n\n\n■お題\nすけべ鬼モードでSっ気出てる竜胆尊(デフォ衣装)\nちょっとマニアックなにおいフェチ責め+アナル舐め手コキ搾精+地の文やフキダシによるCG集風のショートストーリー\n　→糊のようにこってりした薄黄ばんだ精液をドプドプ搾り取る大量射精差分\n\n・竿役は過去作と似た感じの無個性なシルエット風\n　労力を割かない程度に簡素な髪の毛あり+童貞ショタ〜若い男ぐらいのイメージ\n\n・過去作同様に竿役の身体を透過して、舌を突き尖らせて穿るようなヌチャヌチャエグいアナル舐め手コキ\n　簡易的な断面図というか、舌先の近くに前立腺っぽい楕円を描き加えてほしいです\n\n・尊様は手コキともう片方の空いた手で、アナル舐め参考イラストのようにオナニー(できればエロ蹲踞の体勢)で前と尻穴両方をセルフでほじくっている\n\n・和装の肩をはだけておっぱいも程よく露出している\n\n・竿役に膝立ち四つん這いor脚を開いて立たせるなどポージングや構図はお任せしますが、\n　後述するように\n　　①竿役の顔周り\n　　②尊様のノーパンの股間周り(局部周りは陰毛あり、ちょろとケツ毛も生えたスケベな尻穴まで見えている)\n　　この二つがそれなりに目立つサイズ感で画面に収まる感じでお願いしたいです(ワイプやコマ割りも可)\n　　あくまで案ですが以下のどちらか、それ以外でも良さげなのがあればお任せします\n　　　A：画面手前側に竿役の顔、透過した身体越しに尊様のアナル舐めの様子+ワイプやコマ割りで尊様の股間\n　　　B：Aと逆に尊様がエロ蹲踞オナニーしながらアナル舐めしてる様子をローアングルで地面付近から煽り見るような尻フェチ構図+ワイプやコマ割りで竿役の顔周り\n\n・竿役は、パンツ被せるアレをふんどしでやる要領で顔面に尊様の脱ぎたての白ふんどしを暖簾のように被せられ、黒子の顔隠しのようになっている\n　ちょうど竿役の鼻〜口の辺りにパンツでいうクロッチ、股間～尻の谷間に密着して食い込んでいた辺りが被さっている\n　布地が汗を吸って湿ったり、くしゃっとよれたり癖が付いた感じとか、皺みたいな質感があるとよりフェティッシュで好みです\n\n・顔に被さったふんどしの股布に脱ぎたて使用済みの表現(別レイヤー、オンオフで隠せるように)\n　　→エロくさそうな湯気や汗染み\n　　→アワビや船底型っぽい、アソコのヒダ形に食い込んだ白っぽい跡(いわゆるマン拓)やマンカス汚れ\n　　→マン拓付近に薄黄色い拭き残しが何重かまばらに滲んだ小便シミ\n　　→小便シミ付近に縮れた抜け陰毛を数本\n　　→ケツ穴に食い込んでいたと辺りに放射状のアナル皺の跡と、小便シミとは別の黄色or茶色い薄汚れ\n\n・ふんどしの股布越しに竿役の鼻や口元の輪郭が浮く感じで、\n　顔を塞がれた息苦しさ、におい&手コキの興奮でフゥフゥ言いながら半強制的に息を荒くしてふんどしをより一層深く嗅いでしまう感じ\n\n・前述の通り、よくあるCG集風なショートストーリーを地の文やフキダシでお願いします\n　細部は秋赤音さんの解釈や好みでよいのですが2パターンお願いしたく、\n　A：好みの童貞ショタor若いオスにもう普通に戻れないようなディープな体験をさせて変な性癖を植え付けるかのようにアナル舐め手コキでノリノリで搾精する楽しそうな悪い鬼のお姉さん感\n　　　射精後も空っぽになるまで何度も搾り取るのを示唆する感じ)\n　B：Aに輪をかけてねっとりマニアックに、脱ぎたてふんどしの汚れやにおいにも言及しつつソレを嗅がされながらも興奮してギンギンになっている状態をマゾ煽りする感じ\n　　　脱いだふんどしが汚れているのを分かってて、射精させた後に「妾の尻穴も舐めて綺麗にしてもらおうかの・・・？」みたいなことを言い出す\n　AB共に一応和姦の範疇の男受けMシチュで、すけべ鬼が楽しげにノリノリでプレイに興じてる感じ\n　口調は優しくも、興奮してオナニーしながらしゃぶってることに自ら触れたり、言葉選びは容赦なく卑語猥語を並べ立てる若干のお下品エロな感じで(特にB)\n\n\n以上、長くなり恐縮ですがご検討頂けると幸いです\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/32", "thumbnail_src": "https://si.imgix.net/57fc2a75/uploads/origins/ee164618-140f-4060-ac1a-215b83b1c31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=423b143b0383afaacc7231a96c22d3c0", "thumbnail_srcset": "https://si.imgix.net/57fc2a75/uploads/origins/ee164618-140f-4060-ac1a-215b83b1c31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=423b143b0383afaacc7231a96c22d3c0, https://si.imgix.net/57fc2a75/uploads/origins/ee164618-140f-4060-ac1a-215b83b1c31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=491551108c1f6bedf9e12ef1a932d2d2 2x, https://si.imgix.net/57fc2a75/uploads/origins/ee164618-140f-4060-ac1a-215b83b1c31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8da825410ff9f615b8428aa01a17aad6 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nhttps://skeb.jp/@AkiAkane13/works/155\nの仕上げをお願いしたいです！\n\n使用用途は個人鑑賞、コミッションで依頼する際の資料です。\nご検討いただけますと幸いです。\n\nhttps://twitter.com/party_room/status/1734289774834524397", "created_at": "", "completed_at": ""}, {"path": "/@AkiAkane26/works/31", "thumbnail_src": "https://si.imgix.net/de946c24/uploads/origins/b