origins/180c3ea7-ec37-466d-a2fa-d618ed431466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba964df6d561fbe6186eb70ea68253f3", "thumbnail_srcset": "https://si.imgix.net/5454cca2/uploads/origins/180c3ea7-ec37-466d-a2fa-d618ed431466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba964df6d561fbe6186eb70ea68253f3, https://si.imgix.net/5454cca2/uploads/origins/180c3ea7-ec37-466d-a2fa-d618ed431466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b9a8143008bc70973227976079e5a93 2x, https://si.imgix.net/5454cca2/uploads/origins/180c3ea7-ec37-466d-a2fa-d618ed431466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d73051b7cbc59404718e89b14b42cf4 3x", "genre": "art", "nsfw": false, "body": "やじさん、こんにちは！またお世話になります。\n前回に引き続き、完成したイラストはプリコネRクラメン募集用のフライヤー画像として使用させていただきます。\n\n聖学祭衣装でなかよし部の3人をチエルを中心にした感じで描いていただきたいです。\nクランを探してる方に楽しげな雰囲気が伝わるような賑やかなイラストに仕上げてくださると嬉しいです！\n\nやじさんの描くチエルをまだ見たことがないので完成がとても楽しみです！構図やシチュエーションはお任せしますので、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/14", "thumbnail_src": "https://si.imgix.net/9bafc19d/uploads/origins/3296b7a0-075c-4f3a-9662-dacdb5d670d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52c0260b53bd82a4bc30092c2739fee3", "thumbnail_srcset": "https://si.imgix.net/9bafc19d/uploads/origins/3296b7a0-075c-4f3a-9662-dacdb5d670d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52c0260b53bd82a4bc30092c2739fee3, https://si.imgix.net/9bafc19d/uploads/origins/3296b7a0-075c-4f3a-9662-dacdb5d670d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=587dcbe25b428f06d5fd2c08e1d2f468 2x, https://si.imgix.net/9bafc19d/uploads/origins/3296b7a0-075c-4f3a-9662-dacdb5d670d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2338ba1b1e1f1cd18f905e98143d96c9 3x", "genre": "art", "nsfw": false, "body": "やじさん、こんにちは！\nまたお世話になります！\n\n今回はエマちゃんの誕生日のためにまたエマちゃんを描いて頂きたいです！\n詳細など全部お任せします！\n\nいつも本当にありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/13", "thumbnail_src": "https://si.imgix.net/e9009816/uploads/origins/19402bd9-381c-48c8-9071-bbab189b24c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bad9cfff960d7b747dca67ba23c6b55", "thumbnail_srcset": "https://si.imgix.net/e9009816/uploads/origins/19402bd9-381c-48c8-9071-bbab189b24c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bad9cfff960d7b747dca67ba23c6b55, https://si.imgix.net/e9009816/uploads/origins/19402bd9-381c-48c8-9071-bbab189b24c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49261913d2750228c7e5410dfe8e5be5 2x, https://si.imgix.net/e9009816/uploads/origins/19402bd9-381c-48c8-9071-bbab189b24c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b09e0931d5b548696d7bcc4af5290135 3x", "genre": "art", "nsfw": false, "body": "やじ先生\n先生の作品はとっても大好き、先生にこのキャラクター描いで欲しい！！！！このイラストはバーチャルユーチューバーの活動に使います！！本当にありがとうございます！\n今回のテーマは誕生日2周年です 誕生日は5月25日 お願いします \n三面図:\nhttps://drive.google.com/file/d/117a2wy0rzcxR2-nQzH4ZoxyfPoI3uO8d/view?usp=sharing\nYoutube Channel:\nhttps://www.youtube.com/channel/UCpWpaKzmuJhSkYe-B-179PA", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/12", "thumbnail_src": "https://si.imgix.net/a5501830/uploads/origins/98e4052b-0493-450b-9400-7c28ba5ead84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=579eaa46fbda910166293172e6c16260", "thumbnail_srcset": "https://si.imgix.net/a5501830/uploads/origins/98e4052b-0493-450b-9400-7c28ba5ead84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=579eaa46fbda910166293172e6c16260, https://si.imgix.net/a5501830/uploads/origins/98e4052b-0493-450b-9400-7c28ba5ead84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=199cc3ed13bd8bc929476f5b58c4f206 2x, https://si.imgix.net/a5501830/uploads/origins/98e4052b-0493-450b-9400-7c28ba5ead84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd8f6b1f1052b8684cff1e113564fc54 3x", "genre": "art", "nsfw": false, "body": "はじめまして、こんにちは。\n私のキャラクターの新衣装の参考イラストを作っていただけないでしょうか？私のキャラクターは男性で音楽家です。私は「バーチャルウィッチ現象」の服のスタイルが好きです。もしよろしければ、髪の色や顔のスタイルを変えてください。\n\n参考： https://imgur.com/a/n9aimyi", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/11", "thumbnail_src": "https://si.imgix.net/a6ff21df/uploads/origins/595e1781-6657-41f5-92fc-ca62f1d5b1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4d70d90aecefcf85c32234f06471297", "thumbnail_srcset": "https://si.imgix.net/a6ff21df/uploads/origins/595e1781-6657-41f5-92fc-ca62f1d5b1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4d70d90aecefcf85c32234f06471297, https://si.imgix.net/a6ff21df/uploads/origins/595e1781-6657-41f5-92fc-ca62f1d5b1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef52e264031f7b79247bf8e3c89aa5d9 2x, https://si.imgix.net/a6ff21df/uploads/origins/595e1781-6657-41f5-92fc-ca62f1d5b1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a8a66b0a80e8acf565b740a5f82330d 3x", "genre": "art", "nsfw": false, "body": "やじさん、こんにちは！\nまたお世話になります！\n\n今回はおしゃれの冬っぽいエマちゃんを描いて頂きたいです！\n衣装の詳細など全部お任せします！\n\nいつも本当にありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/10", "thumbnail_src": "https://si.imgix.net/65d23f53/uploads/origins/05a5f6f2-01d4-4dc6-a9ee-9110cae781ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f161f14ce036944bcc089d7cc37e47", "thumbnail_srcset": "https://si.imgix.net/65d23f53/uploads/origins/05a5f6f2-01d4-4dc6-a9ee-9110cae781ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f161f14ce036944bcc089d7cc37e47, https://si.imgix.net/65d23f53/uploads/origins/05a5f6f2-01d4-4dc6-a9ee-9110cae781ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e902d67bec774b32706e440752b96bbc 2x, https://si.imgix.net/65d23f53/uploads/origins/05a5f6f2-01d4-4dc6-a9ee-9110cae781ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=593f206cf8c39051be3658efba4dfb90 3x", "genre": "art", "nsfw": false, "body": "やじさん、こんにちは！\nまたお世話になります！\n\n今回は家でくつろいでいるエマちゃんを描いて頂きたいです。\n家でくつろいでいる時に制服パーカーか前回の私服のはちょっとやりすぎるので、すごく可愛い部屋着描いてくれると嬉しいです！\n\n詳細などお任せします！\n\nいつもありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/9", "thumbnail_src": "https://si.imgix.net/80d3bac1/uploads/origins/a38760b7-5bf6-45cb-b5bb-c6850fadf1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9660a06c45a1a30f363057d38c376537", "thumbnail_srcset": "https://si.imgix.net/80d3bac1/uploads/origins/a38760b7-5bf6-45cb-b5bb-c6850fadf1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9660a06c45a1a30f363057d38c376537, https://si.imgix.net/80d3bac1/uploads/origins/a38760b7-5bf6-45cb-b5bb-c6850fadf1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4fd8a03a3c84bd2eb283a90d24e591a 2x, https://si.imgix.net/80d3bac1/uploads/origins/a38760b7-5bf6-45cb-b5bb-c6850fadf1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aca1f736f9f22dc3cd069ee7aa6bf07a 3x", "genre": "art", "nsfw": false, "body": "やじさん、こんにちは！\nまたお世話になります。\n\nエマちゃんの制服パーカーはとても可愛いですが、この暑い季節でパーカーを着てるのはちょっと暑すぎます！それで、もっと涼しい格好でお出かけしてるシーンが見てみたいと思います。\n\nやじさんがデザインしたエマちゃんはとても可愛いなので、新しい衣装の詳細は全部やじさんにお任せします！\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@YAZI114/works/8", "thumbnail_src": "https://si.imgix.net/d7df0bbe/uploads/origins/28ba35da-dffe-4984-820a-e6cca7672838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=410cbe20786f5f0e76181b04794dc54f", "thumbnail_srcset": "https://si.imgix.net/d7df0bbe/uploads/origins/28ba35da-dffe-4984-820a-e6cca7672838?bg=%23fff&