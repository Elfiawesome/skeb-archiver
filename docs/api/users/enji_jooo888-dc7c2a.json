d2a88-55e8-4579-9dfe-65bfa2c96e4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f66f27f5e5d7666cbeb1a5992c7d0b2b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@enji_jooo888/works/4", "thumbnail_src": "https://si.imgix.net/c12ce16f/uploads/origins/c8d942d4-7543-4627-8368-f1898daa6674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ae1da7e46711a6369c29d0ac2b1e5ed", "thumbnail_srcset": "https://si.imgix.net/c12ce16f/uploads/origins/c8d942d4-7543-4627-8368-f1898daa6674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ae1da7e46711a6369c29d0ac2b1e5ed, https://si.imgix.net/c12ce16f/uploads/origins/c8d942d4-7543-4627-8368-f1898daa6674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c169f828c44253d506c1b282c6258c86 2x, https://si.imgix.net/c12ce16f/uploads/origins/c8d942d4-7543-4627-8368-f1898daa6674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=093961c558a8dad85336b68b1826ec2a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@enji_jooo888/works/3", "thumbnail_src": "https://si.imgix.net/0e49c058/uploads/origins/17aa2087-0bb4-43b7-87f0-71ec947f79ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08da4b7c05640afeebf1c01c97038ae7", "thumbnail_srcset": "https://si.imgix.net/0e49c058/uploads/origins/17aa2087-0bb4-43b7-87f0-71ec947f79ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08da4b7c05640afeebf1c01c97038ae7, https://si.imgix.net/0e49c058/uploads/origins/17aa2087-0bb4-43b7-87f0-71ec947f79ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e83c33e906674a57a67c415b5b842aa 2x, https://si.imgix.net/0e49c058/uploads/origins/17aa2087-0bb4-43b7-87f0-71ec947f79ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8359571f2cff50ce16dc645feb1b6e88 3x", "genre": "art", "nsfw": false, "body": "以前ギムレット×ハートのイラストを依頼させていただいた者です。その節は本当にありがとうございました！\nPCの壁紙スライドショーに設定させていただいているのですが、映るたびに断トツに美しい…と感じ、お願いしてよかったと改めて思っています。\nウマ娘の方では孫のデアリングタクトが動き始め、ハートにもスポットが当たるのではないかと期待しながら過ごしている今日この頃です。\n\n今回のリクエストですが、ウマ娘のキタサンブラックがホストとしてアーモンドアイ・ラッキーライラックを接客しているイラストをお願いします。\nキタサンは20代後半、アイ・ララの2人は大学生〜卒業直後くらいの年齢感をイメージしています。\n\nモデルのキタサンブラック号とアーモンドアイ号は昨年産駒が誕生し、ラッキーライラック号とは昨年交配が行われ、出産間近と言われています。\nそしてキタサンブラック号は、昨年種付け料が2,000万円まで高騰したにもかかわらず、200回の交配が行われるほど種牡馬として栄華を極めています。\nこれをウマ娘の世界に置き換え、1年あたり2,000万円貢がせる全国最強ナンバーワンホストとして君臨するキタサンブラックと、そんなキタサンと戯れる賞金女王2人という構図を見てみたいと思いました。\nナンバーワンに登り詰めた最高にイケメンなキタサンを描ける方と考えたとき、真っ先に艷慈さんが浮かんだので依頼させて頂くことにしました。\n（艷慈さんのアイちゃんも見てみたいと思っています）\n\nかなり俗っぽいテーマで恐縮ですが、ご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@enji_jooo888/works/2", "thumbnail_src": "https://si.imgix.net/fa287e76/uploads/origins/ba547fab-0ba0-44a8-852a-af1f6be9c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9452f56883d4c054db10cd4c9552f8b6", "thumbnail_srcset": "https://si.imgix.net/fa287e76/uploads/origins/ba547fab-0ba0-44a8-852a-af1f6be9c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9452f56883d4c054db10cd4c9552f8b6, https://si.imgix.net/fa287e76/uploads/origins/ba547fab-0ba0-44a8-852a-af1f6be9c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d751da739ce0945e2e556333a2de947 2x, https://si.imgix.net/fa287e76/uploads/origins/ba547fab-0ba0-44a8-852a-af1f6be9c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf1930e4549c61d58f2f1418fa2793ab 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのウマ娘作品が大好きです！私のオリジナルキャラクターをドリームジャーニーのトレーナーとして描いてください！身長差はありますが、怖さは同じです！あなたのビジョンを信じて、気長に待ちます！\n\nhttps://imgur.com/a/l9uvd8I\n\nhttps://www.dropbox.com/scl/fo/bskb6j0zenycqyqwlrlak/AEP1DMdOHXpRm55bHBByEb0?rlkey=n95m9dht25hh6g3e094bw5fzh&dl=0\n\nhttps://umamusume.fandom.com/wiki/Dream_Journey", "created_at": "", "completed_at": ""}, {"path": "/@enji_jooo888/works/1", "thumbnail_src": "https://si.imgix.net/b568ee2c/uploads/origins/99d93a01-e55c-47f0-bace-17ad1f430217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f760548c18dc46a1e58f8cb091d1a6d7", "thumbnail_srcset": "https://si.imgix.net/b568ee2c/uploads/origins/99d93a01-e55c-47f0-bace-17ad1f430217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f760548c18dc46a1e58f8cb091d1a6d7, https://si.imgix.net/b568ee2c/uploads/origins/99d93a01-e55c-47f0-bace-17ad1f430217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85731663e6715a45c49bbe917aac9ad1 2x, https://si.imgix.net/b568ee2c/uploads/origins/99d93a01-e55c-47f0-bace-17ad1f430217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d3760037aec7cf9f34a7ec1795c5c7c 3x", "genre": "art", "nsfw": false, "body": "はじめまして、pixiv・Twitterで素敵なイラストを拝ませて頂いています。\nこれまでもセクシーさを感じる肉感と表情・カップリングの創造性が並ではないと感じていたのですが\n特にバブルガムフェローのお洒落さに衝撃を受けました。\nぜひ私にも一枚と思いましたが、無償でリクエストするのが心苦しい性分なので\nskebからリクエストさせていただきます。\n\nリクエストですが、デアリングハートとタニノギムレットのイラストをお願いします。\nシチュエーションはお任せですが、指定があったほうが良ければバーのカウンターで談笑しているシーンにしてください。\n\nデアリングハート号の初仔の相手がタニノギムレット号で、いわゆる史実夫婦になります。\n（残念ながら競走デビューには至らなかったようですが…）\nそれに加えてお互い鮮やかな黄色がテーマカラーであり、ウマ娘でも屈指の顔面の強さを誇っていて\n並べるととても絵になるペアだとも感じています。\nぜひ艶慈さんのセンスで描かれた二人が見たいと思い今回のリクエストに至りました。\nぜひご承認のほどよろしくお願いします！", "created_at": "", "completed_at": ""}]}