2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29d91c1fb9c8831e82d9590a931c4475", "thumbnail_srcset": "https://si.imgix.net/4477ff41/requests/157859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29d91c1fb9c8831e82d9590a931c4475, https://si.imgix.net/4477ff41/requests/157859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9f4f31b2b4fa1f94386b89995259c99 2x, https://si.imgix.net/4477ff41/requests/157859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6d77ea880ee7443cdc8ff90c9886826 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n推しのVTuber、浅葱なぎさんが11/11にお誕生日を迎えるため、お誕生日記念イラストをお願いします。\n\n誕生日にちなんだ内容であること以外はポーズ、服装等、特に指定はありませんので、自由に描いていただければと思います。\n加えて、浅葱なぎさんご本人の希望があった場合には配信やSNSでの紹介、サムネ等の利用についての許諾をいただきたいです。\nまた、前述の通りお誕生日イラストのため、可能であれば11/11に間に合うと非常に嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kurokin_vlkn/works/1", "thumbnail_src": "https://si.imgix.net/e1e641d2/requests/132425_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=248639c6c3031b5e964b936e41412899", "thumbnail_srcset": "https://si.imgix.net/e1e641d2/requests/132425_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=248639c6c3031b5e964b936e41412899, https://si.imgix.net/e1e641d2/requests/132425_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6a5b9d00be5f44644e293b7559ad6b9 2x, https://si.imgix.net/e1e641d2/requests/132425_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=918c8cdf2b03c1cf9a255a81db6b1a7a 3x", "genre": "art", "nsfw": true, "body": "キャラはミリオンライブの伊吹翼\n\n竿役と密着し、竿役の乳首をいやらしく舐めながら手コキをするイラストをお願いします。\n衣装はむちむちな感じで、舌が強調する感じの構図で気持ち大きめで描いていただけたら嬉しいです。\n竿役が見下ろす、または見上げるような構図でお願いいたします。", "created_at": "", "completed_at": ""}]}