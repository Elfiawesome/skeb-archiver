で槍をこうやって (https://resize.cdn.otakumode.com/exq/65/679.950/shop/product/3ed9c78666724c14958d8d7f04df40e1.jpg) 握っている姿をお願いします。頭は横顔ではなくて少し前を向いた角度、そこで目はこちらを見ているといいと思います。\n\n前身なら嬉しいのですが、困ったら上半身~太ももまでだけで十分です。\n\n背景は後ろに海辺が見える密林の端、姫が座っているのは原本のように木でお願いします。\n\nそれでは考慮してください！ どうぞよろしくお願いします！\n\nhttps://imgur.com/RGquEZP", "created_at": "", "completed_at": ""}, {"path": "/@kurokin_vlkn/works/8", "thumbnail_src": "https://si.imgix.net/a57d7500/uploads/origins/b7025cea-3783-4ef2-98a4-7d3c63c17a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df20eeb6ad9e50dc12bb9eb7f64bbbe4", "thumbnail_srcset": "https://si.imgix.net/a57d7500/uploads/origins/b7025cea-3783-4ef2-98a4-7d3c63c17a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df20eeb6ad9e50dc12bb9eb7f64bbbe4, https://si.imgix.net/a57d7500/uploads/origins/b7025cea-3783-4ef2-98a4-7d3c63c17a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de0756cc81f1611dcb634724260943e3 2x, https://si.imgix.net/a57d7500/uploads/origins/b7025cea-3783-4ef2-98a4-7d3c63c17a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b807cf046ab2bf69209e292daefd3ce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kurokin_vlkn/works/7", "thumbnail_src": "https://si.imgix.net/9c347c8f/uploads/origins/e43c8f8b-5438-4658-bb2b-36af12b5a90b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=796f1d6565bd731cf1053d1e4514ffd3", "thumbnail_srcset": "https://si.imgix.net/9c347c8f/uploads/origins/e43c8f8b-5438-4658-bb2b-36af12b5