のままの金額でお送りしておりますが、クリエイター側から確認後金額を変更し返送することができるとあったので、ご確認をお願い致します！\nぜひご検討のほど、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@gizagizawing/works/45", "thumbnail_src": "https://si.imgix.net/957ed08a/uploads/origins/cd7f163a-0c1a-4c1c-a702-03f10a5252b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d62fb1c07cbe02f4e15740cf15efefa", "thumbnail_srcset": "https://si.imgix.net/957ed08a/uploads/origins/cd7f163a-0c1a-4c1c-a702-03f10a5252b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d62fb1c07cbe02f4e15740cf15efefa, https://si.imgix.net/957ed08a/uploads/origins/cd7f163a-0c1a-4c1c-a702-03f10a5252b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b34dd68fc3411cae9c0e433a300987e0 2x, https://si.imgix.net/957ed08a/uploads/origins/cd7f163a-0c1a-4c1c-a702-03f10a5252b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b98373ba0c85b0e1a62f9c4126c0925 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gizagizawing/works/44", "thumbnail_src": "https://si.imgix.net/52d2924a/uploads/origins/dbb6e00b-9a6e-461f-90ca-172b39a45aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c33a59756159fab7571390bc1ac9f6bb", "thumbnail_srcset": "https://si.imgix.net/52d2924a/uploads/origins/dbb6e00b-9a6e-461f-90ca-172b39a45aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c33a59756159fab7571390bc1ac9f6bb, https://si.imgix.net/52d2924a/uploads/origins/dbb6e00b-9a6e-461f-90ca-172b39a45aee?bg=%23fff&auto=format