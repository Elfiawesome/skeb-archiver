691b8eea82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a51a44b4b4cac5855a8ab1dc30ef2371, https://si.imgix.net/411b31c2/uploads/origins/010be7e7-ed37-4099-abf1-2c691b8eea82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b9a339caa8e0685070df6fbcc31ca35 2x, https://si.imgix.net/411b31c2/uploads/origins/010be7e7-ed37-4099-abf1-2c691b8eea82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14ff88c81afe44bd605634cb67ee1ffc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_hoshihaya/works/4", "thumbnail_src": "https://si.imgix.net/a6a2d70e/uploads/origins/73593787-c211-495b-94a3-1a06a44832bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8273d03138b2789964e979378ceda2ab", "thumbnail_srcset": "https://si.imgix.net/a6a2d70e/uploads/origins/73593787-c211-495b-94a3-1a06a44832bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8273d03138b2789964e979378ceda2ab, https://si.imgix.net/a6a2d70e/uploads/origins/73593787-c211-495b-94a3-1a06a44832bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90cd9a44452c6c12d3aeed4ac21a419f 2x, https://si.imgix.net/a6a2d70e/uploads/origins/73593787-c211-495b-94a3-1a06a44832bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cae385c5eddf164dd4b7c2e585d07bb 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のキャラクターを描いていただけませんか？\n\n彼はカルト教団のリーダーですが、信者のことを気にしていません。\n美しい外見をしていますが、実はとても残酷で、人体実験をしています。\n\n天使のような、神聖なイメージで描いてほしいです。\n\n注意点\n見づらいけど髪が長いです。そして、画像では同じように見えても、指輪は両手とも違うのです。\n\nhttps://drive.google.com/file/d/1S3rUGrgSIYwiV1IPGAW497wLZO0VT3BV/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@_hoshihaya/works/3", "thumbnail_src": "https://si.imgix.net/46bfbfe1/uploads/origins/17f21837-3470-4e46-9535-883dfdaf2940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c2129fea46af23fb21171d9c42bbb55", "thumbnail_srcset": "https://si.imgix.net/46bfbfe1/uploads/origins/17f21837-3470-4e46-9535-883dfdaf2940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c2129fea46af23fb21171d9c42bbb55, https://si.imgix.net/46bfbfe1/uploads/origins/17f21837-3470-4e46-9535-883dfdaf2940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca6b66536c44ab6fbabe0d43ced94a1 2x, https://si.imgix.net/46bfbfe1/uploads/origins/17f21837-3470-4e46-9535-883dfdaf2940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a817d4c775fb05577aaf9b693c5a3ed9 3x", "genre": "art", "nsfw": false, "body": "Good morning Sensei, I love your magical artstyle!   \nMay I ask for a drawing of my OC?   \n\n  \nCharacter Background:  \nHis name is Nightshade, he is a boy. His mother was sold to a foreign country to become a body slave and he was born there. He spent his childhood relatively peacefully, but one day his mother was killed by one of her clients. He is determined to find the killer and seek revenge.  \n\nNightshade’s character picture is in the reference URL. \n\n \nMy Commission:  \nI would like to see Nightshade sitting in the dark night, he is petting a lamb in his arms. On one side of him, there is a knife, on the other side there is a mirror (shown in URL character picture). He has a cold expression on his face. The knife and lamb symbolise he is about to kill (end) his childhood innocence.    \n  \n Would it be possible for you to draw him younger? His clothes don’t need to change. His hair is hanging down and longer.  \n\nThank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1LztDD7cfKmwNeFplUqClZGImno2WK40P?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@_hoshihaya/works/2", "thumbnail_src": "https://si.imgix.net/a8148b97/uploads/origins/f6457c65-3cfc-4b65-8361-773d820aafe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e2d1b8d744a67932db9ab2cb57a95ae", "thumbnail_srcset": "https://si.imgix.net/a8148b97/uploads/origins/f6457c65-3cfc-4b65-8361-773d820aafe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e2d1b8d744a67932db9ab2cb57a95ae, https://si.imgix.net/a8148b97/uploads/origins/f6457c65-3cfc-4b65-8361-773d820aafe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc28c60e73b5fba3ea98291452d8d900 2x, https://si.imgix.net/a8148b97/uploads/origins/f6457c65-3cfc-4b65-8361-773d820aafe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cd69faf3973475507e8da04a1d92da6 3x", "genre": "art", "nsfw": false, "body": "星早さん、はじめまして、ふゆきと申します。星早さんの素敵な作風に惹かれて、リクエストさせて頂きました！\n＊もし良ければ、【私のオリキャラと彼女の仲間であるコツメカワウソ】の一枚絵を描いていただけないでしょうか？\n＊【雪や霧】をモチーフにして、ご自由に描いて頂ければと思います。\n＊オリキャラの設定：\n\n名前：ふゆ\n身長:150〜155cm\n年齢:15～20歳\nすごい雪が降っていた冬の日に生まれて、社交苦手で静かな子\nインドア派\n人より動物や植物の方が好き、一人で音楽を聴きながらぼーっとしていることが好き\n雨の日や雪の日が好き、ネコが好き、コツメカワウソの仲間がいる。\n仲間のカワウソと物理的に合体することができる。その際、ふゆちゃんはカワウソの耳としっぽが生えます。\n\n寂しいなあ〜と思われるが、でも彼女は寂しいと感じない。しかし、やはり彼女の心の中のどこかに大きい虚しさが存在する。その心の穴を埋めたいため、ふゆちゃんと親友のコツメカワウソが旅をしています。どこかに行きたい、でも行き先が分からない。どうしようもなく心の居場所を探し続けています。\n\n＊参考資料リンク：\n\nhttps://drive.google.com/drive/folders/1-mFiBFrCQwxeIMypmE1bU1RQSw7Yd-07\n\n＊構図、ポーズ、服装のデザインなど細かい点はすべてお任せします!ぜひお好きなようにしてください( *´︶`*)!\n＊もし良ければ、サインを別レイヤーにしたPSDデータの納品を頂ければ幸いです。\n\n以上、ご検討のほどよろしくお願いします(*^^*)!", "created_at": "", "completed_at": ""}, {"path": "/@_hoshihaya/works/1", "thumbnail_src": "https://si.imgix.net/4f394a50/uploads/origins/5c6b64a0-94d8-4b2a-a3b5-57614b1cb198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4df0a5a62b154cf2a4f8fa7e6cc12097", "thumbnail_srcset": "https://si.imgix.net/4f394a50/uploads/origins/5c6b64a0-94d8-4b2a-a3b5-57614b1cb198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4df0a5a62b154cf2a4f8fa7e6cc12097, https://si.imgix.net/4f394a50/uploads/origins/5c6b64a0-94d8-4b2a-a3b5-57614b1cb198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70c9925c43b35591b687b013de3988a4 2x, https://si.imgix.net/4f394a50/uploads/origins/5c6b64a0-94d8-4b2a-a3b5-57614b1cb198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c63d2bc10dc4cbad1c4636d10d199f3 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの描き方がとても好きで、私のOCをリクエストしたいのです。\n\nちょっと記号的というか、漠然としたイラストを希望します。\n\nイヴは生まれながらにして選ばれた聖女です。ずっと閉じこもっていた彼女は、後に騎士の妖怪であるミハイルを召喚する。二人はミハイルが彼女を守る兄妹のような関係です。\n\n自由にお絵かきしてください。ご検討よろしくお願いします。レイヤー分けされたpsdファイルを希望します。\n\nhttps://drive.google.com/drive/folders/1KtRi113JMP-ITspsEsnAte5sOWUQ6i8a?usp=sharing", "created_at": "", "completed_at": ""}]}