8-8d62-d1eea7bcd990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a852af054b83529a1995a40763ac8405", "thumbnail_srcset": "https://si.imgix.net/b8b993f6/uploads/origins/15a74153-66a8-4728-8d62-d1eea7bcd990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a852af054b83529a1995a40763ac8405, https://si.imgix.net/b8b993f6/uploads/origins/15a74153-66a8-4728-8d62-d1eea7bcd990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7f5448a844970abd9be74ad4cc611e7 2x, https://si.imgix.net/b8b993f6/uploads/origins/15a74153-66a8-4728-8d62-d1eea7bcd990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff052fa07cf7fc74a3c1a67b8b769f03 3x", "genre": "art", "nsfw": false, "body": "あかぴｯピさんの絵柄に惹かれ、skebを依頼させていただきました。\nいつも原神イラストを楽しく拝見してます！\n\n【イラスト対象】\n来狸クルミ\n\n【内容】\n以下、八田ルイイラストと対称的になるような向き\nポージングや表情等はお任せ\nhttps://skeb.jp/@surapuni_5/works/36\n（サムネの左側に八田ルイ、右側に来狸クルミを配置想定）\n\nあかぴｯピさんの性癖もりもりでも可\n\n【使用用途】\nサムネイルイラスト\n\nhttps://drive.google.com/file/d/1VeRFfd2plevPJ5HBiIOdjQnc0fpUHWq7/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/44", "thumbnail_src": "https://si.imgix.net/9ef88620/uploads/origins/b33eebc3-0e21-4cb8-80a6-113d5589fa90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fe98dbdced2af232137b9bb4d6e0aca", "thumbnail_srcset": "https://si.imgix.net/9ef88620/uploads/origins/b33eebc3-0e21-4cb8-80a6-113d5589fa90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fe98dbdced2af232137b9bb4d6e0aca, https://si.imgix.net/9ef88620/uploads/origins/b33eebc3-0e21-4cb8-80a6-113d5589fa90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdad78386dbfdc866f52deebb35cd670 2x, https://si.imgix.net/9ef88620/uploads/origins/b33eebc3-0e21-4cb8-80a6-113d5589fa90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fabb9936079a9f4ed75b9d617b24f003 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nあかぴｯｸｽ様のイラストがRTで回ってきて、はっ…！と一目ぼれしてしまいました。\nぜひ私のキャラクターを描いていただきたいです！\n\n【キャラ】\n私は普段配信活動を行っているのですが、まだ歴が浅く自身のアイコンや立ち絵などに迷っていて、ぜひあかぴｯｸｽ様の作風で私のキャラクターを描いていただくご連絡しました。\n\n〇銀髪の男の子\n〇両手の人差し指を頭の上に立てて、動物の耳を作っているポーズ\n〇銀魂の坂田銀時のようなイメージ\n\n・以上の事柄以外は、服装や構図等すべておまかせデザインをお願いします。（OCになります…！参考画像がなくて申し訳ありません…！）\n\n【好きなもの】※ご参考までに\nシンプルで軽い感じの服装（休日に家の中で着る部屋着系が好きです）\n狐\n紅茶\nゲーム\n\n【用途】\n個人鑑賞及び、SNSアイコンや配信画面等で使用させていただきたいです。\n\n条件に合いましたらぜひよろしくお願いいたします！！", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/43", "thumbnail_src": "https://si.imgix.net/155f96bb/uploads/origins/f45cdd94-0e44-4ecb-8c47-1a5cb72388ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06ecb9bff7a751f56d40467f0c2b843e", "thumbnail_srcset": "https://si.imgix.net/155f96bb/uploads/origins/f45cdd94-0e44-4ecb-8c47-1a5cb72388ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06ecb9bff7a751f56d40467f0c2b843e, https://si.imgix.net/155f96bb/uploads/origins/f45cdd94-0e44-4ecb-8c47-1a5cb72388ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2b7953a41ada52feea6604ce678622e 2x, https://si.imgix.net/155f96bb/uploads/origins/f45cdd94-0e44-4ecb-8c47-1a5cb72388ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f61e1c79a7543ce87f8521ecb75b552 3x", "genre": "art", "nsfw": false, "body": "使用用途\n\nはじめまして。\n今回は私のオリジナルキャラクターをご依頼させていただきたいです。（宛名のミスでキャンセルになってしまいすみません。）\n\n【使用用途】\n・SNSのアイコンなど\n・twichの配信での装飾など\n\n【納品形式】\n•可能であれば、背景とキャラクターのレイヤーが分かれたデータをいただけると嬉しいです。\n\n【キャラクター】\n・参考画像\nhttps://twitter.com/aktn_bo/status/1450448957981683718?s=46\n・衣装はキャラクターがわからなくなる範囲でなければ可愛い感じに変えていただいても大丈夫です\n・髪型は変更しないでいただきたいです。\n・メガネはある状態でお願いしたいですが、完全に無くならなければ手に持って外しているなどの構図にはしていただいても構いません。（メガネ無しの差分などは作っていただいても大丈夫です。）\n・モチーフは赤トンボとなっています。\n\n【構図】\n・お任せします。\n\n【背景】\n・お任せします。\n\n【雰囲気や表情】\n・可愛らしい雰囲気\n・元気な雰囲気", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/42", "thumbnail_src": "https://si.imgix.net/048b3171/uploads/origins/b66e251f-5ff8-4fe9-b4d6-f61e22ff6c8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65489aff0ae3f11842eca81efc07529d", "thumbnail_srcset": "https://si.imgix.net/048b3171/uploads/origins/b66e251f-5ff8-4fe9-b4d6-f61e22ff6c8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65489aff0ae3f11842eca81efc07529d, https://si.imgix.net/048b3171/uploads/origins/b66e251f-5ff8-4fe9-b4d6-f61e22ff6c8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51f704e5f656fdcac37d29a00d73ba78 2x, https://si.imgix.net/048b3171/uploads/origins/b66e251f-5ff8-4fe9-b4d6-f61e22ff6c8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c20b269fff806c4dc1d36f04a737f9f 3x", "genre": "art", "nsfw": false, "body": "あかぴ様、こんばんは！前回はありがとうございました！\n貴方様のイラストに一目惚れしたのですが、本当に本当に可愛らしくて😭柔らかそうな頬、きゅるりとした瞳に大きめのお靴…どれをとっても愛らしくて…。身体のバランス？体格も本当に素晴らしいです！💓\n\nリクエストばかりでご迷惑でなければ良いのですが、またまたうちの子をお願いしても宜しいでしょうか？\n\nギザ歯と三つ編みが特徴の子です。\n得意げに物を語りますがすぐにあわあわしだすアホの子です。自分を大きく見せようと見栄を張ったり知ったかぶりをしますが、嘘をつくのはめちゃくちゃに下手くそです。\nメンヘラ気質だと思います。よく泣きそうになってます。\n困った時や不安を感じてる時は自分の三つ編みをにぎにぎする癖があります。\n\n構図等はお好きな様にして貰って構いません。恐縮なのですが、また全身を描いて貰えると嬉しいです🙏\nズボンや靴はご自由にアレンジして頂いて大丈夫です。分かりにくいと思いますので…。\nよろしくお願いします。\n\nhttps://twitter.com/salt_v2/status/1684033976607059968?s=46&t=blBEFbTKkBwOrNUdOxjDlQ", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/41", "thumbnail_src": "https://si.imgix.net/f5a2b7f2/uploads/origins/b776b25a-6095-4546-a35c-f5897d655967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13116ce41f8baf9e234dd619796c3d71", "thumbnail_srcset": "https://si.imgix.net/f5a2b7f2/uploads/origins/b776b25a-6095-4546-a35c-f5897d655967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13116ce41f8baf9e234dd619796c3d71, https://si.imgix.net/f5a2b7f2/uploads/origins/b776b25a-6095-4546-a35c-f5897d655967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a0734248d8a6857617360b846f8e3e9 2x, https://si.imgix.net/f5a2b7f2/uploads/origins/b776b25a-6095-4546-a35c-f5897d655967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17650f72687264c5c80ff71dcc7d83d6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、貴方のイラストが好きです。\n宜しければ私のTRPGキャラを描いていただけませんか？\n\nタレ目気味のディーラーくんです。\n髪が長くて結んでるのですが横から少し出ている感じです、平凡な子なので特別な特徴はありませんが身長が小さくて頼み事なんかも断れない不幸体質です。\n\n構図等はおまかせ致します。\n全身絵でキャラと背景でレイヤー分離して頂けると幸いです。\n\n参考としましてテーブルゲームが好きで、ダーツだったりコイン遊びだったりカードゲームをよくやる子です。\n\nhttps://twitter.com/Aru_skb/status/1683690627882684416?t=jq6ptCdm9xWLLXpOcQPgRQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/40", "thumbnail_src": "https://si.imgix.net/0c24df4a/uploads/origins/9a0551cc-2a1f-4e6d-aba1-5ba1a12d024a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2c4d3d57d240f2c0b45943adb44cfa4", "thumbnail_srcset": "https://si.imgix.net/0c24df4a/uploads/origins/9a0551cc-2a1f-4e6d-aba1-5ba1a12d024a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2c4d3d57d240f2c0b45943adb44cfa4, https://si.imgix.net/0c24df4a/uploads/origins/9a0551cc-2a1f-4e6d-aba1-5ba1a12d024a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67ec6b0bb6c48152d45fc7c256c59db5 2x, https://si.imgix.net/0c24df4a/uploads/origins/9a0551cc-2a1f-4e6d-aba1-5ba1a12d024a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a593d1861a89ed44d1eef2fbb3f6b81 3x", "genre": "art", "nsfw": false, "body": "あかぴｯピ様\n\nはじめまして。\nskebの新着にてお見かけした素敵なイラストに心惹かれましたので、リクエストを送らせて頂きます。\n\n私は個人Vtuberとして活動準備中の舞羽ラテフと申します。\n依頼させて頂きたいのは私自身のイラストです。\n\n舞羽ラテフは好奇心旺盛で割とお話し好きな吸血鬼です。\n構図や表情など、よろしければ全てお任せしたいです。\n\nまた、イラストについてはVtuber活動で使用させていただきたいです。\n（YouTubeサムネ/SNSアイコン・投稿/その他配信活動全般）\n\nその為、人物と背景のレイヤーを分けていただけるとありがたいです。\n\n以上です。\nご縁がありましたらよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1MhAXLRCamDk1xggspzDJoNca9s7_X1V9", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/39", "thumbnail_src": "https://si.imgix.net/2aef319d/uploads/origins/e8607c19-05e5-4972-a0ee-db7556417e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5bcc550696be1f6106264339f3c4b4b", "thumbnail_srcset": "https://si.imgix.net/2aef319d/uploads/origins/e8607c19-05e5-4972-a0ee-db7556417e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5bcc550696be1f6106264339f3c4b4b, https://si.imgix.net/2aef319d/uploads/origins/e8607c19-05e5-4972-a0ee-db7556417e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9db0c6f8d315af5457e80bae55b99f60 2x, https://si.imgix.net/2aef319d/uploads/origins/e8607c19-05e5-4972-a0ee-db7556417e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5e5f994cf3a7f25e8b5204d8c2afa5b 3x", "genre": "art", "nsfw": false, "body": "前回はお世話になりました。お早い納品ありがとうございます。\n早速なのですがもう一つ依頼させて頂いても宜しいでしょうか。\n\nhttps://twitter.com/salt_v2/status/1665034595509600259?s=46&t=blBEFbTKkBwOrNUdOxjDlQ\n\nまた長い三つ編みのチャイナっ子なのですが…。地面スレスレの長い髪が好きなので、また全身を描いてもらえると嬉しいです。\n中身は子供っぽい我儘な子なのですが、外見だけは爽やかな好青年って感じだと思います。\n普段はニコニコしてますが、自由気ままで怒りっぽいところもあります。むっとして人の髪の毛引っ張ったりする悪い子です。\n\n構図等はお任せします。\nよく腕組んでたり、手にヒヨコ乗せてお話してたりします。\n\nhttps://twitter.com/salt_v2/status/1680624971968811008?s=46&t=blBEFbTKkBwOrNUdOxjDlQ", "created_at": "", "completed_at": ""}, {"path": "/@surapuni_5/works/38", "thumbnail_src": "https://si.imgix.net/d5d6cc65/uploads/origins/661b25f5-9b59-4564-9e1f-24053f346346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09aea133f4939b7fa2a36b806b0db971", "thumbnail_srcset": "https://si.imgix.net/d5d6cc65/uploads/origins/661b25f5-9b59-4564-9e1f-24053f346346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09aea133f4939b7fa2a36b806b0db971, https://si.imgix.net/d5d6cc65/uploads/origins/661b25f5-9b59-4564-9e1f-24053f346346?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&