b-4691-8943-073aa3be6e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=810b97e4dbe563e7b7e2207d481043dc, https://si.imgix.net/a83da7ac/uploads/origins/a1d03262-e60b-4691-8943-073aa3be6e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03f58a6a87679fc8e3df643ce64f1dd 2x, https://si.imgix.net/a83da7ac/uploads/origins/a1d03262-e60b-4691-8943-073aa3be6e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62544f8e0aa487b422255269e40da576 3x", "genre": "art", "nsfw": false, "body": "「千恋万花」の「常陸茉子」と「朝武芳乃」がいちゃついているシーンを描いてください。茉子はゲームの私服、芳乃はゲームの巫女服。その中で茉子は芳乃の後ろで挑発的な笑顔で彼女の胸に触れ、芳乃は少し怯えて恥ずかしがり屋で、両手は戸惑い、恥ずかしがり屋で顔が赤くなった", "created_at": "", "completed_at": ""}, {"path": "/@Hosinonana7/works/5", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/0e20f7b4/uploads/origins/d6e87372-b33c-49b7-b274-df246a6e0532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a36110c9a71be9b12ba412f893ab511f", "thumbnail_srcset": "https://si.imgix.net/0e20f7b4/uploads/origins/d6e87372-b33c-49b7-b274-df246a6e0532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a36110c9a71be9b12ba412f893ab511f, https://si.imgix.net/0e20f7b4/uploads/origins/d6e87372-b33c-49b7-b274-df246a6e0532?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd79f120fc99257cabb9eda419d36527 2x, https://si.imgix.net/0e20f7b4/uploads/origins/d6e87372-b33c-49b7-b274-df246a6e0532?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e163f2f4030d24833e1eb06e2e28b2cc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエストを見ていただきありがとうございます。和美の参考資料はURLにあります。服装やポーズなどは想像にお任せします。\n\nhttps://imgur.com/a/RetpgwV", "created_at": "", "completed_at": ""}, {"path": "/@Hosinonana7/works/4", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/3311c6be/uploads/origins/dd5bea77-54fd-4ac4-a8bb-601f57660938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a10c9fc96ac16c54fc14dc3a3e1e1cd4", "thumbnail_srcset": "https://si.imgix.net/3311c6be/uploads/origins/dd5bea77-54fd-4ac4-a8bb-601f57660938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a10c9fc96ac16c54fc14dc3a3e1e1cd4, https://si.imgix.net/3311c6be/uploads/origins/dd5bea77-54fd-4ac4-a8bb-601f57660938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b1f9dab24b8cb16049b52ef0d5cf9cb 2x, https://si.imgix.net/3311c6be/uploads/origins/dd5bea77-54fd-4ac4-a8bb-601f57660938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbad8a1741598c2e9a5a653cded06cb1 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n以下仕様です（顔はこれでもかって言うくらいかわいく）\n・制服女子（リボンは色を水色に変更しておおきく。ブレザーは今までに無いようなかわいいデザインを希望します。体育座り）\n・丸眼鏡（はっきりわかるように、）\n・手はハート型→かなり照れながら\n・髪の毛の色（茶髪）\n・髪型（ツインテールで出来れば結び目にリボンのアクセントが欲しいです）\n・スカートは青色でチェック柄で短め\n・全体的に水色で透明感重視\n・靴はローファー\n・上下左右見切れがないようにお願いします。\n・サイズは横1920*縦1080ピクセルでお願いします。納品ファイル形式は、psd、jpgでお願いします。\n\nご検討の程、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Hosinonana7/works/3", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/39050524/uploads/origins/7a35e405-4828-4223-a652-8428f168fad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b34734b6d96c66263acc5f577a4899b7", "thumbnail_srcset": "https://si.imgix.net/39050524/uploads/origins/7a35e405-4828-4223-a652-8428f168fad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b34734b6d96c66263acc5f577a4899b7, https://si.imgix.net/39050524/uploads/origins/7a35e405-4828-4223-a652-8428f168fad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=403612ae2b1b03c2afb9095933aa1cf8 2x, https://si.imgix.net/39050524/uploads/origins/7a35e405-4828-4223-a652-8428f168fad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1a76f722bddd47d9d7a0afed0d064ba 3x", "genre": "art", "nsfw": false, "body": "ホシノナナさん、こんにちは。\n\nいつもTwitterやFANBOXでお世話になっています！\nありがとうございます！\n\nリクエストですが、参考資料にある、\n描愛ゆうさんの「探偵少女シャーロット」の女の子が、\n花束を手に、ゆうさんのお誕生日を\nお祝いしているイメージでお願いしたいです。\n\n背景や構図などの細かいところは、\nホシノナナさんにお任せいたします。\n\nゆうさんのお誕生日は、10月4日とまだ先なのですが、\n描いていただいたイラストを、ゆうさんに\nお誕生日のギフトとして、プレゼントできたらなと\n考えておりますので、そちらのプレゼントの許可も、\nお許しいただけると幸いです・・！\n\nまた、もし可能でしたら、ゆうさんへのギフト用として、\n「お誕生日おめでとうございます！」\n「はっぴーばーすでー！」など、\nお誕生日をお祝いする、メッセージの入った差分を\n用意していただけたら嬉しいです・・！\n\n色々と注文が多くてすみませんが、\nリクエストを受けていただけたらとても喜びます！\n\n何卒よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/89594886", "created_at": "", "completed_at": ""}, {"path": "/@Hosinonana7/works/2", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/85d40976/uploads/origins/a56b986c-299c-47e2-99cf-5164afa89b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d246f1e9ff17cda6112f3ac7e58904", "thumbnail_srcset": "https://si.imgix.net/85d40976/uploads/origins/a56b986c-299c-47e2-99cf-5164afa89b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d246f1e9ff17cda6112f3ac7e58904, https://si.imgix.net/85d40976/uploads/origins/a56b986c-299c-47e2-99cf-5164afa89b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2c43f6f6ce48ce0a5b147fdb3cc4f59 2x, https://si.imgix.net/85d40976/uploads/origins/a56b986c-299c-47e2-99cf-5164afa89b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27acf10b1830cd9fb643c0d11a46ec33 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵はとてもかわいいです\n\nひだまりスケッチの夏目さんの絵をお願いしたいのですが、添付のアルバムにある服装のどれかを着て欲しいです。どれを描くかは自由です。ポーズや構図はお任せします!\n\nhttps://imgur.com/a/qbcmCCu", "created_at": "", "completed_at": ""}, {"path": "/@Hosinonana7/works/1", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/23e9ddcf/uploads/origins/2423dfd0-5c5f-48df-a761-ce0f9eeb8231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c