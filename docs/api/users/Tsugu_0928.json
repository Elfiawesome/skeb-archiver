-a3fb-e235e2d3a234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e3962bdf4423b06daf1344656c8eda, https://si.imgix.net/e636c6c2/uploads/origins/be33235c-4dbc-4886-a3fb-e235e2d3a234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a061db1c126c3ea1473a646d0ce7ea35 2x, https://si.imgix.net/e636c6c2/uploads/origins/be33235c-4dbc-4886-a3fb-e235e2d3a234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=682f8d5d1389985e400eed31e5fa70f0 3x", "genre": "art", "nsfw": false, "body": "初めまして！ゲーム実況者のLiaqN【りあん】と申します！\nはやみくらげ様の素敵な作品群を拝見し思わずリクエストさせてもらいました。\n\nポーズや構図は全てお任せしますので、\n私のキャラクターを描いていただけませんでしょうか。\n\n※服装や装飾などはアレンジしていただいても問題ございません。\n※黄色い帽子は無しでお願いします。\n※可能であれば、PSDデータでレイヤーを分けて頂けるととても助かります。\n\n【使用用途】\nYouTubeのサムネイルやTwitterアイコン等\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1k9_CN8WFd6hCE0bk3LCV04sN4-hUvOzL?usp=sharing\n\n何卒ご検討のほど宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Tsugu_0928/works/17", "thumbnail_src": "https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9864108e9e2a311ed354278c7cce47", "thumbnail_srcset": "https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9864108e9e2a311ed354278c7cce47, https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=082fd5d35d41a194901af0b6f16ca34b 2x, https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ee8d3480dc8c7c01b83515c6c1aacc3 3x", "genre": "art", "nsfw": false, "body": "いつもTwitterではお世話になっております。ねぎまると言う者です。\n初めてのリクエストですので、何か失礼がありましたら申し訳ございません。\n\nリクエスト内容としては、スマホゲーム『ブルーアーカイブ』に登場する\"薬子サヤ\"という子を描いていただきたいです！資料のところに、参考のURLを記載します。\n一応表情等の指定は書きますが、偉そうに指定できる立場ではないので、いろいろと変更して大丈夫です！顔だけのイラストなど、はやみ先生が納得できるようにしてください…！\n\nゲーム中に衣装が二つありますが、リクエストとしては通常衣装（青い方の衣装）です。\nニヤリと笑い、悪だくみを考えているような表情をお願いします。\n状況としては、椅子とかに座りながら考え事をする…という感じでお願いします。（もし胸部まで描く場合は、ぜひ小さめで…）\n\nよろしくお願い致します！\n\nhttps://twitter.com/Blue_ArchiveJP/status/1355350152379199490?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Tsugu_0928/works/16", "thumbnail_src": "https://si.imgix.net/a084d94f/uploads/origins/3efdc5e1-64fc-4212-85b8-aa099e72b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d0be9903a511e40bced2947e3e04f58", "thumbnail_srcset": "https://si.imgix.net/a084d94f/uploads/origins/3efdc5e1-64fc-4212-85b8-aa099e72b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d0be9903a511e40bced2947e3e04f58, https://si.imgix.net/a084d94f/uploads/origins/3efdc5e1-64fc-4212-85b8-aa099e72b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b652184947a1211c12c90b621a7f194e 2x, https://si.imgix.net/a084d94f/uploads/origins/3efdc5e1-64fc-4212-85b8-aa099e72b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a0defa60ab0e5ec5f9b1e0e9e251456 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Tsugu_0928/works/15", "thumbnail_src": "https://si.imgix.net/dd4416f7/uploads/origins/c40cd88b-a40b-420c-a411-0d90977e8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e004d179e0af63f8d3eddff31a84ef69", "thumbnail_srcset": "https://si.imgix.net/dd4416f7/uploads/origins/c40cd88b-a40b-420c-a411-0d90977e8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e004d179e0af63f8d3eddff31a84ef69, https://si.imgix.net/dd4416f7/uploads/origins/c40cd88b-a40b-420c-a411-0d90977e8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=311d9eed3c859ebb4b89c6fea6a9e4b2 2x, https://si.imgix.net/dd4416f7/uploads/origins/c40cd88b-a40b-420c-a411-0d90977e8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff05303f6ca3544f415a3d6c6d6d274c 3x", "genre": "art", "nsfw": false, "body": "はやみさん、はじめまして！\n\nあなたの描く表情豊かな絵がとても好きなので、リクエストをお送りします！\n\nキャラクターは私のFFXIVのOCでお願いします。詳細は資料URLをご確認ください。\nスクショだとツリ目ですが、ジト目に変えて描いてくれると嬉しいです。\n服装はできれば現実っぽく、リクルートスーツを着せてもらえたらと思います。\n\nシチュエーションですが、仕事でテンションが下がってｽﾞｰﾝってしてる感じの絵を、はやみさんのコミカルなテイストでお願いします。\n日曜日に遊びすぎて眠すぎる月曜日の出勤中とか、\n徹夜したのにまだ仕事が終わらないとか、\n5000兆連勤してるとか。\n具体的なシチュエーションはお任せしますが、\nそういう雰囲気で耳がへにょってたり猫背になっちゃうような感じでお願いします。\n\n形式は一枚絵でも漫画でもお任せいたします。\nはやみさんのかわいくてシュールでコミカルなゆるい雰囲気がとても好みなので、描きやすい形で描いていただけたらと思います。\n最後まで読んでくださりありがとうございました。\nそれでは、よろしくお願いいたします！\n\nhttps://imgur.com/a/mQKK0wi", "created_at": "", "completed_at": ""}, {"path": "/@Tsugu_0928/works/14", "thumbnail_src": "https://si.imgix.net/5ce0d8e5/uploads/origins/a9097938-5107-49a8-a342-a56870371afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=801ee4debe72ef7853f97dda899691ba", "thumbnail_srcset": "https://si.imgix.net/5ce0d8e5/uploads/origins/a9097938-5107-49a8-a342-a56870371afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=801ee4debe72ef7853f97dda899691ba, https://si.imgix.net/5ce0d8e5/uploads/origins/a9097938-5107-49a8-a342-a56870371afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89b99bcd79d421918e4ef06b784d436f 2x, https://si.imgix.net/5ce0d8e5/uploads/origins/a9097938-5107-49a8-a342-a56870371afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81ae1c7005e014d113495732e95f94e7 3x", "genre": "art", "nsfw": false, "body": "個人で活動されているVtuberの桜兎めうさんのSDイラストを描いていただけないでしょうか？  \n（桜兎めうさん本人には、skebなどでのファンアート依頼の許可について、事前に確認済みです。）   \n\n桜兎めうさんのTwitter  \nhttps://twitter.com/SMeu_channel   \n\n〇希望内容  \n・スマホゲーム「アークナイツ」の登場キャラクター「テンニンカ」のコスプレをした桜兎めうさんのSDイラスト1枚  \n・上記に加え、涙目表情差分1枚 \n\n ※涙目表情については、個人的なイメージとして、後述する参考資料（モーションgif）のように大きな丸白目の涙目が好きです   \n\n○「テンニンカ」の参考資料（有志攻略wikiより） \n・本ページ  \nhttps://arknights.wikiru.jp/index.php?%E3%83%86%E3%83%B3%E3%83%8B%E3%83%B3%E3%82%AB  \n・SDモーションgif  \nhttps://arknights.wikiru.jp/index.php?plugin=attach&refer=%E3%83%86%E3%83%B3%E3%83%8B%E3%83%B3%E3%82%AB&openfile=%E3%83%86%E3%83%B3%E3%83%8B%E3%83%B3%E3%82%AB_1_sd.gif   \n\n○桜兎めうさんの参考資料  \nhttps://twitter.com/SMeu_channel/status/1621795948442656768  \n※髪の色がピンクと青の2パターンありますが、どちらでも構いません   \n\n〇用途 \n桜兎めうさん本人が以下の用途で使用できる許可を頂ければ幸いです。 \n ・Twitter等のSNSへの掲載  \n・Youtube等での配信活動での使用  \n※絵の全体の雰囲気を損なわない程度の加工許可を頂けると幸いです", "created_at": "", "completed_at": ""}, {"path": "/@Tsugu_0928/works/13", "thumbnail_src": "https://si.imgix.net/9c81c0da/uploads/origins/7d8ce53d-7fb5-4ca5-83eb-c36448c7b9af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b09778001862f8efa15cd6359066c2", "thumbnail_srcset": "https://si.imgix.net/9c81c0da/uploads/origins/7d8ce53d-7fb5-4ca5-83eb-c36448c7b9af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b09778001862f8efa15cd6359066c2, https://si.imgix.net/9c81c0da/uploads/origins/7d8ce53d-7fb5-4ca5-83eb-c36448c7b9af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17358dedeaa68be8db6e741e05396192 2x, https://si.imgix.net/9c81c0da/uploads/origins/7d8ce53d-7fb5-4ca5-83eb-c36448c7b9af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be9ec4734410aff4c1551222585bf2e8 3x", "genre": "art", "nsfw": false, "body": "はじめましてAtsuと申します。 普段からアークナイツ漫画などの作品を拝見しており、可愛らしい絵柄が大変気に入りましたので依頼させていただきます。\n\n要望\n私が応援しております、Vtuberのあくまメリルさんを描いていただきたいです。ポーズや構図はおまかせ致しますが、「落ち着いたお姉さん」のイメージを反映していただけると嬉しいです。また、メリルさんの推しオペレーターである、メテオリーテを一緒に描いていただけますでしょうか。\nこちらもポーズ、構図はおまかせ致します。\n\n参考資料\nあくまメリルさん　三面図\nhttps://twitter.com/bookVtuber/status/1613068007378685953?s=20&t=O4RMmSoZXMHFVzycocUjjg\n\n以上よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Tsugu_0928/works/12", "thumbnail_src": "https://si.imgix.net/c2d2b893/uploads/origins/04adb23c-78e5-452c-ba64-dbebfcffcb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eef474ccfaa146ba5a40d3245ace5a5", "thumbnail_srcset": "https://si.imgix.net/c2d2b893/uploads/origins/04adb23c-78e5-452c-ba64-dbebfcffcb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eef474ccfaa146ba5a40d3245ace5a5, https://si.imgix.net/c2d2b893/uploads/origins/04adb23c-78e5-452c-ba64-dbebfcffcb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b2e3433b786bb1083b8e7edf853dcb8 2x, https://si.imgix.net/c2d2b893/uploads/origins/04adb23c-78e5-452c-ba64-dbebfcffcb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9037c3918d6d97c2ffca0ec30363580 3x", "genre": "art", "nsfw": false, "body": "はやみ くらげ🥐様\n\nV声優プロダクションぼいそーれという事務所に所属している日向こがね(@himukai_kogane_)と申します。\nはやみ様の描かれる元気いっぱいで動きのある女の子たちのイラストが大好きで、前々から依頼したいと思っておりました…！\n\n今回お願いしたいのは、下記の内容です。\n\n【リクエスト内容】\n・Vtuber日向こがねのイラスト（三面図やキャラクター資料は文末にございます！）\n・朝の寝起き、あくびしてる眠そうな日向こがねをお願い致します…！\n・洋服などはだぼだぼのオーバーサイズパーカーか、彼シャツのようなものでお願いいたします！\n・ポーズや構図等は下記にございます…！\n⇒https://media.discordapp.net/attachments/847007281799626762/1036341218088587365/2.png?width=1193&height=671\n（上記メモ書いてありますが失礼な言葉ありましたら大変申し訳ございません）\n・イラストの比率はお任せ\n（ただし、動画サムネイルに使用する際には16:9にこちらで調整させていただく場合がございます…！）\n\n【使用用途】\n・SNSでの掲載,アイコン\n・YouTubeコミュニティ（※収益化済みチャンネル）\n・FANBOX\n・主にグッズ以外などの販売目的以外でのVtuber活動\n・サムネ用と言うよりは一枚絵としてお願いしたい気持ちが強めですが、背景と人物をわけて人物をサムネなど様々な形でも使える形ですと嬉しいです…！\n\nそれではもしお時間ございましたら、どうぞよろしくお願い致します…！\n\n日向\n\nキャラクター資料\nhttps://drive.google.com/drive/folders/1oHAdMBvD7aq4KJNdeurXfAtC44-MK-1b?usp=sharing", "created_at": "", "completed_at": ""}, {"pat