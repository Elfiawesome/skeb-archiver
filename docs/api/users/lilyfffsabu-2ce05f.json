%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52007ab415394216350c3a3538ee8c1a", "thumbnail_srcset": "https://si.imgix.net/ce572c31/uploads/origins/b5ffdb15-50ae-4792-a9dd-3d511577f92d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52007ab415394216350c3a3538ee8c1a, https://si.imgix.net/ce572c31/uploads/origins/b5ffdb15-50ae-4792-a9dd-3d511577f92d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1807d0c55f101cbba9c2d6975195de2 2x, https://si.imgix.net/ce572c31/uploads/origins/b5ffdb15-50ae-4792-a9dd-3d511577f92d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf65a8249ffbe6c589abd3acd8240254 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！\n僕のキャラを気に入っていただきありがとうございます！\n\n衣装は資料の中からお好きなものを、\n髪型も資料からお好きなもの、\n（衣装と髪型の組み合わせも自由です♪）\nもしくはオリジナルでアレンジしていただいても大丈夫です。\n構図・表情などはお任せします。\n\n自由に楽しんで描いていただけたら嬉しいです！\n\nhttps://hub.vroid.com/users/7138564", "created_at": "", "completed_at": ""}, {"path": "/@lilyfffsabu/works/6", "thumbnail_src": "https://si.imgix.net/244d358c/uploads/origins/9aa5b517-bc43-4687-a025-7e048fac931c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee2b944438800a2ebae4da11e089d5f", "thumbnail_srcset": "https://si.imgix.net/244d358c/uploads/origins/9aa5b517-bc43-4687-a025-7e048fac931c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee2b944438800a2ebae4da11e089d5f, https://si.imgix.net/244d358c/uploads/origins/9aa5b517-bc43-4687-a025-7e048fac931c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a06628bf43be2131e1f4a825677a793 2x, https://si.imgix.net/244d358c/uploads/origins/9aa5b517-bc43-4687-a025-7e048fac931c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fdbd245ac14c96f7500dcb41f86a081 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのアートとスタイルが大好きです。\n\nこれは私のキャラクター、アリサです：\n\nhttps://drive.google.com/drive/folders/1ZECBBAgF4zXX-di9NWhoUw