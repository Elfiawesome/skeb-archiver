5810821120%2FBAZ-8dns.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b97af21ca22b055db1b09089040916fc 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1837153265810821120%2FBAZ-8dns.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=984a9a9c6430449342f9b68630a3a3eb 3x", "genre": "voice", "nsfw": false, "body": "折角ボイスを募集されてるという事なのでリクエストさせていただきました\n内容につきましては、可能でしたらりくりさんのお任せでお願いしたいです\n\n無理そうでしたら……応援する系のボイスをいただきたいです\n心が疲れた時に癒され頑張れるような……難しい注文ですよね？すみません……", "created_at": "", "completed_at": ""}, {"path": "/@virtual_rikuri/works/1", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1837153265810821120%2FBAZ-8dns.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3096092240c249e4fe8cceeae2b20cce", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1837153265810821120%2FBAZ-8dns.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3096092240c249e4fe8cceeae2b20cce, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1837153265810821120%2FBAZ-8dns.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b97af21ca22b055db1b09089040916fc 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1837153265810821120%2FBAZ-8dns.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=984a9a9c6430449342f9b68630a3a3eb 3x", "genre": "voice", "nsfw": false, "body": "こんにちは\nSkeb開設されたということなので、\nさっそく依頼します。\n\nリクエストテーマは、\n歌の練習前にやっている発声練習・声出しです。\n音声の内容・長さはお任せいたします。", "created_at": "", "completed_at": ""}]}