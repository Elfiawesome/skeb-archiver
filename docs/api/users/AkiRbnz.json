2-4e7c-80b0-d2bfb7037beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f5e6756c291e2ea53cbb5e8c03dfb88, https://si.imgix.net/bd171cbc/uploads/origins/ef28eacf-6372-4e7c-80b0-d2bfb7037beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69bdad554a0e5fec8c85ac468b2bc249 2x, https://si.imgix.net/bd171cbc/uploads/origins/ef28eacf-6372-4e7c-80b0-d2bfb7037beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccdad09ef71fedd00f7b19b27f7855e6 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしい作品をありがとうございました。\nキャラクター:ファイアーエムブレム風花雪月のヒルダとイングリッド(2人とも第二部の衣装)\n\nヒルダ:https://dic.pixiv.net/a/ヒルダ%3Dヴァレンティン%3Dゴネリル\nイングリッド: https://dic.pixiv.net/a/イングリット%3Dブランドル%3Dガラテア\n\nシチュエーション:首を吊られ晒されている\n\n・目と口は開いていて完全に事切れている\n・全裸\n・2人とも乳房が見えるような構図\n・ヒルダは巨乳、イングリッドは美乳くらいの大きさ\n・セリフの有無はお任せ\n可能であればお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@AkiRbnz/works/38", "thumbnail_src": "https://si.imgix.net/cedb2429/uploads/origins/90f98bbb-c3fe-4511-9628-b0402f06781c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade3d66fa78a05a6c14704b88bad1410", "thumbnail_srcset": "https://si.imgix.net/cedb2429/uploads/origins/90f98bbb-c3fe-4511-9628-b0402f06781c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade3d66fa78a05a6c14704b88bad1410, https://si.imgix.net/cedb2429/uploads/origins/90f98bbb-c3fe-4511-9628-b0402f06781c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d3e2abc3e9853b9fe92588528029a64 2x, https://si.imgix.net/cedb2429/uploads/origins/90f98bbb-c3fe-4511-9628-b0402f06781c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0435d0764e46e02ce24a6c7bfcf9f9f8 3x", "genre": "art", "nsfw": true, "body": "【ファイアーエムブレム　封印の剣　ユーノ】\n\nユーノさんが死体オナホ化される内容\n\nテーマ：「服を残したまま絞殺され屍姦されるユーノさん。巨乳は露出され、複数男(2～3人くらい)たちにその死体を支えられながら背面駅弁で中出し、死体を愛されまくる。」\n\n絵の構図：M字開脚、中出し、断面図、ブーツ、背面駅弁、背後から乳揉み、ネクロフィリア(死体愛好)\n\nユーノさんの全身が見えるような絵(頭から足先、ブーツまで見える)にして欲しいです。また、ユーノさんの顔は美形、妖艶な逝き方に、脚は細めに描いて下さると助かります。\n\n差分は、①中出し②中出し断面図③ユーノさんの死体とディープキス④男のブーツこき射精", "created_at": "", "completed_at": ""}, {"path": "/@AkiRbnz/works/37", "thumbnail_src": "https://si.imgix.net/c9f920f2/uploads/origins/4d1ef7c4-7e17-42b3-9fa4-46e33861c884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=906ea8ff703ae252ad89bc01a3c5667a", "thumbnail_srcset": "https://si.imgix.net/c9f920f2/uploads/origins/4d1ef7c4-7e17-42b3-9fa4-46e33861c884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=906ea8ff703ae252ad89bc01a3c5667a, https://si.imgix.net/c9f920f2/uploads/origins/4d1ef7c4-7e17-42b3-9fa4-46e33861c884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43b5368962b6803a7d12648ac12bef6e 2x, https://si.imgix.net/c9f920f2/uploads/origins/4d1ef7c4-7e17-42b3-9fa4-46e33861c884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d1fae43c8cde493d2d4c658ec50cc3d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@AkiRbnz/works/36", "thumbnail_src": "https://si.imgix.net/311bb541/uploads/origins/0534790d-607c-4bd7-b313-2b82d57fc980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdcbcf9a0d6cc6becb4fbe0d6a33e69c", "thumbnail_srcset": "https://si.imgix.net/311bb541/uploads/origins/0534790d-607c-4bd7-b313-2b82d57fc980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdcbcf9a0d6cc6becb4fbe0d6a33e69c, https://si.imgix.net/311bb541/uploads/origins/0534790d-607c-4bd7-b313-2b82d57fc980?bg=%23fff