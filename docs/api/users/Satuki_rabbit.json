imgix.net/2912043b/uploads/origins/d63b0f3b-1249-41af-a6dc-2a2c66901686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f19efc7f513c9474eb11aaf7c12de92c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Satuki_rabbit/works/206", "thumbnail_src": "https://si.imgix.net/1653f9bd/uploads/origins/dca6da58-525d-4175-9c0f-ea608adaad18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703ea7f5757c43f70fe27d14a140e57d", "thumbnail_srcset": "https://si.imgix.net/1653f9bd/uploads/origins/dca6da58-525d-4175-9c0f-ea608adaad18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703ea7f5757c43f70fe27d14a140e57d, https://si.imgix.net/1653f9bd/uploads/origins/dca6da58-525d-4175-9c0f-ea608adaad18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c190e44400fac07208c5ca5bbf5ef0d4 2x, https://si.imgix.net/1653f9bd/uploads/origins/dca6da58-525d-4175-9c0f-ea608adaad18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dd04f24df51484d5980f3771111090d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のオリジナルキャラクターの新しい衣装をデザインしていただきたいのですが、突然お願いするのはちょっと恥ずかしいので…すみません。\nhttps://drive.google.com/drive/folders/1ywzz6XH6HoK-BPGiRUAfIGRQTRzKCL02\n魔法使いですが、忍者っぽい衣装を着せたいと思いました。（最近「ニンジャスレイヤー」という小説にハマっていて…忍者ってカッコいいですよね！）\n忍者になった後、彼は長柄の刀を二本の短刀に持ち替え、魔法に使う青い宝石は手裏剣の刃となり、投げると虹のような軌跡を残すようになった。\n尻尾の宝石も手裏剣に変形しており、なんと巨大な手裏剣になることもできるのだとか…スカーフがあればさらに良いでしょう，衣服に現代的な要素が多少あっても全く問題ありません。", "created_at": "", "completed_at": ""}, {"path": "/@Satuki_rabbit/works/205", "thumbnail_src": "https://si.imgix.net/b65ae183/uploads/origins/4d1ec8df-77df-47d3-a558-c5c71210eacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cebaab4fef56e9384cb8bb