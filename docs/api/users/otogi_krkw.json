%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1337b3017adefba09efb4eca0f0d2477 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otogi_krkw/works/24", "thumbnail_src": "https://si.imgix.net/8caac583/uploads/origins/098fee43-f1f5-47ea-97ed-80dd1b47d03f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d4bb42580a98da81c6ef27f2ea3e9f0", "thumbnail_srcset": "https://si.imgix.net/8caac583/uploads/origins/098fee43-f1f5-47ea-97ed-80dd1b47d03f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d4bb42580a98da81c6ef27f2ea3e9f0, https://si.imgix.net/8caac583/uploads/origins/098fee43-f1f5-47ea-97ed-80dd1b47d03f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5372fe9977d8e7f6b7b5cd7bcdc152cc 2x, https://si.imgix.net/8caac583/uploads/origins/098fee43-f1f5-47ea-97ed-80dd1b47d03f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f15ea87d531d39ad154adcc2de73e475 3x", "genre": "art", "nsfw": true, "body": "資料URLのウチの子のでっっっか……という感じのモノクロ絵をリクエストします\n活発だけど育ちの良さは出てる、ですます調のキャラのイメージです\n\nポーズや状況、着衣ズリ前中後等はお任せしますが、おっぱいがパツンパツンの着衣でお願いします\n\nご一考よろしくお願いします\n\nhttps://twitter.com/Lord_of_Doragon/status/1564642735944273920", "created_at": "", "completed_at": ""}, {"path": "/@otogi_krkw/works/23", "thumbnail_src": "https://si.imgix.net/887070ab/uploads/origins/0fbcb3ff-110e-4ad4-be26-8007fa67da84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8635d3ea5f15050a1a056c5ba6a7d425", "thumbnail_srcset": "https://si.imgix.net/887070ab/uploads/origins/0fbcb3ff-110e-4ad4-be26-8007fa67da84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8635d3ea5f15050a1a056c5ba6a7d425, https://si.imgix.net/887070ab/uploads/origins/0fbcb3ff-110e-4ad4-be26-8007fa67da84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c1f4e5af96c347e060dfc48504ac36d 2x, https://si.imgix.net/887070ab/uploads/origins/0fbcb3ff-110e-4ad4-be26-8007fa67da84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fc88617c3ad53e589fb4c205ace2685 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です、動画配信アカウントの6channelです。以前はリクエストをお受けいただきありがとうございました。\n今回も黒川おとぎ先生に描いてもらいたくリクエストさせて頂きます。細かな内容も含みますので、以下にまとめて書かせて頂きます。\n\n(概要)\n・うちの子(緑髪メイド、茶髪メイド)のWパイズリ(挿乳から乳内射精まで)を3ページのマンガ形式で描いて欲しいです。\n・二人とも全裸でお願いします。カチューシャは描いて欲しいですが、作画の都合で省いても大丈夫です。\n・カラーではなく白黒＋トーンでお願いします。\n・台詞は一切無しで、描き文字のSEやエモーション(♡や♪等)を添えて欲しいです。\n\n(資料)\n・メイド服の三面図…(https://pbs.twimg.com/media/E9AYuyzVkAY1304?format=jpg&name=4096x4096)\n・下着姿の正面、横向き図…(https://pbs.twimg.com/media/E5TEjlHVoAYzwJU?format=jpg&name=4096x4096)\n・二人とも乳首は出てます。\n・イヤリング等のアクセサリは省いても問題ありません。\n・二人とも胸を盛っても問題ありませんが、バストサイズは茶髪＞緑髪になるようお願いします。\n\n(詳細)\n・以下にコマ数指定やカメラアングル等も書きますが、おとぎ先生の描きやすいようにコマ数、ページ数等を変えても問題ありません。\n\n○１頁目…2人のバストアップ→乳を押し付け合い生まれた十字の谷間の中央に上から挿乳。\n・二人で横に並んで乳を強調。緑髪は恥ずかしそうに、茶髪は恍惚な表情をする。\n・挿乳直前の下乳を見せるローアングルの構図\n・挿乳する瞬間\n以上、全3コマをお願いします。\n\n○2頁目…Wパイズリの様子\n・Wパイズリの細かな内容や描写、コマ割についてはおとぎ先生に一任したいです。\n・最後のコマで乳内射精をお願いします。\n\n○3頁目…射精後のザーメンブリッジ見せつけ\n・射精し終わった竿から離れて出来るＷザーメンブリッジ\n・再度横に並び、ドロドロになった胸の谷間を開き二人のザーメンブリッジを見せつける\n以上、全2コマをお願いします。\n\n以上となります。長々と失礼しました。\n\n商業誌の執筆もありお忙しい中だと思いますが、何卒宜しくお願い致します。\n\nhttps://twitter.com/6ch_COM3D2/status/1410969112826634242", "created_at": "", "completed_at": ""}]}