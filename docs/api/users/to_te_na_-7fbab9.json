ab1/uploads/origins/7f8464ef-5171-4e1e-ae89-5225d5473c59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a5e918400c3f65d62dcf6cf18077f5b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ニーア転生の沙流とプリエのアートをお願いしたいです。二人が手をつないでいたり、なんとなく二人で甘えていたりすると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@to_te_na_/works/5", "thumbnail_src": "https://si.imgix.net/86390b0b/uploads/origins/419d2482-82ca-4995-ae4c-e29cffa8c631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ff4eda1810a5d9a42cc23891e7de64", "thumbnail_srcset": "https://si.imgix.net/86390b0b/uploads/origins/419d2482-82ca-4995-ae4c-e29cffa8c631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ff4eda1810a5d9a42cc23891e7de64, https://si.imgix.net/86390b0b/uploads/origins/419d2482-82ca-4995-ae4c-e29cffa8c631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2367769de733205677fa5bb4ffc7f25a 2x, https://si.imgix.net/86390b0b/uploads/origins/419d2482-82ca-4995-ae4c-e29cffa8c631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53763b92d222f2240ab65bc3c3bb518b 3x", "genre": "art", "nsfw": false, "body": "むつりさん！また私です😂。前回の作品が好きすぎて、それ以来スマホのロック画面として使っています。また同じキャラをリクエストさせていただきたいんです！全部をおまかせします。よろしくお願いします🙏\n\nhttps://toyhou.se/1831040.havok/gallery", "created_at": "", "completed_at": ""}, {"path": "/@to_te_na_/works/4", "thumbnail_src": "https://si.imgix.net/685e403f/uploads/origins/7170b927-0578-4ebf-9ef6-73fd9ddee7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=736f25b209c63b2bc232d7cc99127b88", "thumbnail_srcset": "https://si.imgix.net/685e403f/uploads/origins/7170b927-0578-4ebf-9ef6-73fd9ddee7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=736f25b209c63b2bc232d7cc99127b88, https://si.imgix.net/685e403f/uploads/origins/7170b927-0578-4ebf-9ef6-73fd9ddee7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20