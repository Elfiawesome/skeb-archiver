=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa6eb45ef66a290c38c49ffb55dea86a 2x, https://si.imgix.net/8b71c18a/uploads/origins/b6c28ee1-51e2-42c4-bed6-34afaed2d3c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30e47522aa5d5ec157d18245fdd4cb66 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\nうちの子(VRSNS/VRChat)の絵を描いて頂きたいです。\n用途としてはSNSのヘッダー、アイコンに使用するほか自宅へ飾るのが目的となります。\n\n【デザイン】\n・参考資料にはいくつかの衣装パターン・ケモ耳の有無がありますが、どれで描いて頂いても構いません\n・アクセサリ・装飾品等の細かいディティールについては必要に応じて省略やアレンジして頂いても構いません。\n・構図や表情、ポーズなどは全てお任せいたします。\n\n【備考】\n・可能であればキャラクター、背景、サインなどが別レイヤーになったPSD形式にして頂けると嬉しいです。\n\nよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1SHfGJcM_dyW19vWpIOVKUovh8DMIrrGC", "created_at": "", "completed_at": ""}, {"path": "/@ARoHa252538/works/1", "thumbnail_src": "https://si.imgix.net/d50b503e/uploads/origins/961427b2-cfb6-41b1-80a8-502d9feac163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87c7ccdc2e59077a1217d5b52e5ee149", "thumbnail_srcset": "https://si.imgix.net/d50b503e/uploads/origins/961427b2-cfb6-41b1-80a8-502d9feac163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87c7ccdc2e59077a1217d5b52e5ee149, https://si.imgix.net/d50b503e/uploads/origins/961427b2-cfb6-41b1-80a8-502d9feac163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76669047dc42c3031916899ba480d47e 2x, https://si.imgix.net/d50b503e/uploads/origins/961427b2-cfb6-41b1-80a8-502d9feac163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50d6390f0e94fbe0dcdfbd3b5eb0f4c5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}