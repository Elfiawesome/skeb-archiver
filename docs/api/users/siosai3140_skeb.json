.net/33026237/uploads/origins/8adf3711-63be-4a86-9f1d-6d767d9326b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd2bf4e8d1ee942efceac8bc86b16945 3x", "genre": "art", "nsfw": false, "body": "https://twitter.com/KomaTsura502/status/1655154847220662272\nhttps://twitter.com/Ichika_1771/status/1641913860700635136\nこの二人の綿貫織華(わたぬき おろか)が写ったイラストを希望します\nhttps://skeb.jp/@Wanasi_/works/19\nhttps://skeb.jp/@Wanasi_/works/18\nこれは一例です。ピンク系の色調になっていますが、かれらは銀髪です\n構図についてはお任せします\nご検討いただけますと幸いです", "created_at": "", "completed_at": ""}, {"path": "/@siosai3140_skeb/works/11", "thumbnail_src": "https://si.imgix.net/b80857ce/uploads/origins/68fbfe0e-9bdd-4c7f-aaa5-1ca473789093?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=623b55b680a21b462243e454d23b3ed7", "thumbnail_srcset": "https://si.imgix.net/b80857ce/uploads/origins/68fbfe0e-9bdd-4c7f-aaa5-1ca473789093?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=623b55b680a21b462243e454d23b3ed7, https://si.imgix.net/b80857ce/uploads/origins/68fbfe0e-9bdd-4c7f-aaa5-1ca473789093?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f199a58d0055386452cd6de2dc4cd2cd 2x, https://si.imgix.net/b80857ce/uploads/origins/68fbfe0e-9bdd-4c7f-aaa5-1ca473789093?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c21c68233a0949ab80f1210b3204c88 3x", "genre": "art", "nsfw": false, "body": "こんにちは、シオサイ！\n\nシオサイさん、こんにちは！シオサイさんの作品は私の友人にも紹介していて、とても評判がいいんです！私の双子のエラキーとスドビーナを描いていただけませんか？エラキーは黄色と黒の本で、スドビーナは赤と黒の本です。引き受けてくれると嬉しいな！\n\nhttps://imgur.com/a/a9bzwdI", "created_at": "", "completed_at": ""}, {"path": "/@siosai3140_skeb/works/10", "thumbnail_src": "https://si.imgix.net/ff825df3/uploads/origins/a2c31ebc-4f73-479a-82bb-21eee96c219a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5419fc97ec75b0d1ffd798ac19c6c3a9", "thumbnail_srcset": "https://si.imgix.net/ff825df3/uploads/origins/a2c31ebc-4f73-479a-82bb-21eee96c219a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5419fc97ec75b0d1ffd798ac19c6c3a9, https://si.imgix.net/ff825df3/uploads/origins/a2c31ebc-4f73-479a-82bb-21eee96c219a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f3bef891b8a2bb43ea14019d090f0fe 2x, https://si.imgix.net/ff825df3/uploads/origins/a2c31ebc-4f73-479a-82bb-21eee96c219a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39c818cc1c644632549b57367d4e12f2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@siosai3140_skeb/works/9", "thumbnail_src": "https://si.imgix.net/b2c23ee7/uploads/origins/f868a9f6-8cf9-4bc1-a590-a9f78b65ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f96cccaff959e587f8bfeee2f69772c", "thumbnail_srcset": "https://si.imgix.net/b2c23ee7/uploads/origins/f868a9f6-8cf9-4bc1-a590-a9f78b65ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f96cccaff959e587f8bfeee2f69772c, https://si.imgix.net/b2c23ee7/uploads/origins/f868a9f6-8cf9-4bc1-a590-a9f78b65ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6942fb076ed44c49ea28639c6707d93d 2x, https://si.imgix.net/b2c23ee7/uploads/origins/f868a9f6-8cf9-4bc1-a590-a9f78b65ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ea4aaa61871982bf7b142bb12fc92f7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのチビたちはかわいいと思います。\n\n私と私の友達のOCが木の根元に座っているところを描いてくれませんか？名前はアルティナ、ルミ、レイで、みんな若い貴族の女の子です。\n\nアルティナ（金髪で長い髪が違う髪色に分かれている子）は、真ん中にリラックスした表情で、他の2人より背が高くなるように描いてください。\n\nルミ（短髪で眼鏡をかけた金髪の女性）は、彼女を右側に描き、本を読ませてください。ルミの姉なので、アルティナに寄りかかるように描いても構いません。\n\nレイ（緑色の髪の人）は、左側にリンゴを食べているところを描いてください。\n\nアルティナの衣装は2種類（どちらを使っても構いません）、デザインシートは参考資料の中にあります。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/aAnHlxu", "created_at": "", "completed_at": ""}, {"path": "/@siosai3140_skeb/works/8", "thumbnail_src": "https://si.imgix.net/58eea4fd/uploads/origins/704a3941-9b00-4a64-a3c9-62f0fd7d57ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9442b4ad96cdc2377abf159781e9cd3e", "thumbnail_srcset": "https://si.imgix.net/58eea4fd/uploads/origins/704a3941-9b00-4a64-a3c9-62f0fd7d57ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9442b4ad96cdc2377abf159781e9cd3e, https://si.imgix.net/58eea4fd/uploads/origins/704a3941-9b00-4a64-a3c9-62f0fd7d57ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58bc0c23d1c92ce3a80d229b27056d31 2x, https://si.imgix.net/58eea4fd/uploads/origins/704a3941-9b00-4a64-a3c9-62f0fd7d57ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4613daea6154c6fa8fea8841e2d4f56 3x", "genre": "art", "nsfw": false, "body": "潮彩様についに3回目のリクエストです。\n\nちんまりとかわいいキャラを他にも見て見たくなりましたｗ\n\n創作作品[おおかみちゃん]シリーズ\n\nオリジナルキャラクター\n\n狼の軌跡 Ver.2 [おおかみちゃん作品モーメント]\n\n・https://x.gd/rKLDB\n\n依頼内容：今回はモーメント内のおおかみちゃん「ルルカ(三種類のフォームの中から一つ)」とおおかみちゃんシリーズの枠内コラボをしてみたいと考えているので潮彩様が自由にキャラを組み合わせてみてくれると嬉しいです。\n\nこのシリーズ自体がクリエイター様の手で物語を紡ぎ出すといったテーマなので多少の独自解釈なども大丈夫です。\n\n以下、最近使用している個人的なSkeb依頼用のテンプレートです。\n\n狼の軌跡 Ver.2 [おおかみちゃん作品モーメント]\n\n・https://x.gd/rKLDB\n\n・ここに様々なクリエイター様が描いたおおかみちゃん作品が公開されているので目を通していただけると助かります。\n\n・リクエスト中にも新作が増えていく可能性があります。\n\n☆尻尾など忘れられる事が多いので気をつけていただけると助かります。\n\n☆納品は保存版のPSDと、出力済みPNGでお願い致します。\n\n☆レイヤーでサインのon/off可能にしていただけると助かります。", "created_at": "", "completed_at": ""}, {"path": "/@siosai3140_skeb/works/7", "thumbnail_src": "https://si.imgix.net/330c6304/uploads/origins/28032188-16a6-4cb2-8fee-a55c245bafad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr