ff-8321-b58fc96c9219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36d2e60b91a8cb758fd59982aab245c3, https://si.imgix.net/20d9c346/uploads/origins/cbc934b1-9727-44ff-8321-b58fc96c9219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44782834220aa721fd69f6376c9e21f7 2x, https://si.imgix.net/20d9c346/uploads/origins/cbc934b1-9727-44ff-8321-b58fc96c9219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7c51e0e695224e727b10dcea98a4ea8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私の白ウサギに興味を持っていただけて嬉しいです！ゲーム画面に没頭している姿がいいですね。\n\nhttps://drive.google.com/drive/folders/14-99n3Sc6OBpeBLEP-BsFcQoAuy6lPea?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@HIBIKI_TAKOCHI/works/4", "thumbnail_src": "https://si.imgix.net/654b8c4c/uploads/origins/63944eb1-4bf1-4010-8f35-80f47e14abe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdbde253f5558cc6cd8c14fb35f14fad", "thumbnail_srcset": "https://si.imgix.net/654b8c4c/uploads/origins/63944eb1-4bf1-4010-8f35-80f47e14abe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdbde253f5558cc6cd8c14fb35f14fad, https://si.imgix.net/654b8c4c/uploads/origins/63944eb1-4bf1-4010-8f35-80f47e14abe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c125bb1ec76cee2f038fc4e868dadba6 2x, https://si.imgix.net/654b8c4c/uploads/origins/63944eb1-4bf1-4010-8f35-80f47e14abe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a22e9e46802f2e9379b25ce269464910 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nこの度は、アピールをありがとうございます。\n\n響たこち様の過去作を拝見した上で、アピール文の中にあった「ハロウィン感を出した小物と合わせてのイラスト」というのを見てみたいと思いましたので、今回のアピールを受けることにしました。\n\n\nまず、こちらが、私のオリジナルキャラのプロフィールとなります。\n\nプロフィール\n名前︰シクティス\n年齢︰12歳\n性別︰女\n性格︰優しくおとなしい\n備考︰黒髪おかっぱ頭の魔女。\n服装は黒い普段着、白い夏服の2種類があり、黒服の方はわかりにくいですがベルトをしています。\n\n\n内容に関しては、「うちの子」が年齢的にも、まだハロウィンのお菓子を貰う側だと思いますので、例えば、お菓子を貰うためのカボチャなデザインのカバンを持って楽しそうにしているというような、ひと目でハロウィンだとわかるイラストになっていれば嬉しいです。\n\n\n服などの資料は、URLの方を参照して下さい。\nなお、服装は黒服と白服の2種類が存在しますが、ハロウィンのイメージから、個人的には黒服の方を希望したいです。\nまた、ホウキは必須のアイテムというわけではないので、イラストの内容に合わせてオミットして下さい。\n\n\n問題がなければ、リクエストを受けて下さる形で結構ですので、宜しくお願い致します。\n\nhttps://auto.hanabie.com/sictes-kettei.html", "created_at": "", "completed_at": ""}, {"path": "/@HIBIKI_TAKOCHI/works/3", "thumbnail_src": "https://si.imgix.net/d980d8d4/uploads/origins/a07c4cd0-ff4d-41fd-a6a6-ae9438f68fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2583ce6b1be9537ed1d40923aed03bf2", "thumbnail_srcset": "https://si.imgix.net/d980d8d4/uploads/origins/a07c4cd0-ff4d-41fd-a6a6-ae9438f68fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2583ce6b1be9537ed1d40923aed03bf2, https://si.imgix.net/d980d8d4/uploads/origins/a07c4cd0-ff4d-41fd-a6a6-ae9438f68fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=553918ecb907c2b4cf81be8f08602a83 2x, https://si.imgix.net/d980d8d4/uploads/origins/a07c4cd0-ff4d-41fd-a6a6-ae9438f68fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97c9906ec0f974f5e664d3a105113b5b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のVTuberを描いてもらえたら嬉しいです！\n\n私のVTuberは陽気で礼儀正しいノンバイナリー植物少女で、緑色の髪、黄色の目、陽気な笑顔、そして頭の上にはアロエベラの耳があります。趣味はガーデニングとソフトウェア開発。\n\n彼女の頭の大きさに比べて耳の大きさはとても重要なので注意してください。\n\nこれが私の参考シートです： https://files.catbox.moe/psgnur.png\n\nあなたの決断に満足します。ポーズやディテールは完全にあなた次第です。\n自由に創造してください！\n\nもっとインスピレーションを得るために私のストリームを見たい場合は、こちらが私のTwitchです：\nhttps://www.twitch.tv/hexadigital\n\nその他の衣装もご覧になりたい方は、こちらをご覧ください：\nhttps://catbox.moe/c/n24fbr\n\nソーシャルメディアや自分のストリームで使いたい。\n\nよろしくお願いします！\n\nhttps://files.catbox.moe/psgnur.png", "created_at": "", "completed_at": ""}, {"path": "/@HIBIKI_TAKOCHI/works/2", "thumbnail_src": "https://si.imgix.net/b8a65466/uploads/origins/320c5a40-4e93-4203-a987-873251391dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd9608c7d4149d5194a398cf0df61ef7", "thumbna