696-8dee-f2a624330a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34e52a95dafe79e26b0fa46a05948a0e 2x, https://si.imgix.net/3f98a3a0/uploads/origins/2c8fa616-9b18-4696-8dee-f2a624330a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=074c393088914d2cf313520063af1676 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ あなたの芸術作品が大好きです！ 絵を描いていただきたいのですが。 これは私のオリジナルキャラクターです。✨️\n\n どんな姿勢でもいいです。 私のOCの顔にくまが少しあります。彼女の表情を少し怖く描いてくれませんか。ありがとうございます。❤️\n\nhttps://twitter.com/gszzj/status/1707937512659079652?s=19", "created_at": "", "completed_at": ""}, {"path": "/@pepoyoPPY/works/26", "thumbnail_src": "https://si.imgix.net/08a8c757/uploads/origins/055dc615-080d-4470-9ff2-b02fe7f0c529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=135d2e036ea00f6f77c12a6434065ca4", "thumbnail_srcset": "https://si.imgix.net/08a8c757/uploads/origins/055dc615-080d-4470-9ff2-b02fe7f0c529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=135d2e036ea00f6f77c12a6434065ca4, https://si.imgix.net/08a8c757/uploads/origins/055dc615-080d-4470-9ff2-b02fe7f0c529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35a7ba7c6c94cebecf57a0387ec102cd 2x, https://si.imgix.net/08a8c757/uploads/origins/055dc615-080d-4470-9ff2-b02fe7f0c529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ca8bedb6f17713b54943d4c5f098cd5 3x", "genre": "art", "nsfw": false, "body": "こんにちは。えとわーるといいます:)\n自分の使っているSNSのアカウント（@etoile_0620）などのアイコンにぺぽよさんの描いたイラストを使用したいです。\n丸い目をした可愛い感じの男の子を描いて頂きたいです。\n漠然としてて申し訳ないのですが、構図など全てお任せします。自由に描いて頂きたいです!", "created_at": "", "completed_at": ""}, {"path": "/@pepoyoPPY/works/25", "thumbnail_src": "https://si.imgix.net/d319398d/uploads/origins/2cd897ad-9f55-405e-ba39-6f96da1eb32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6a24a2886f8cae8df9763b8fa3a6172", "thumbnail_srcset": "https://si.imgix.net/d319398d/uploads/origins/2cd897ad-9f55-405e-ba39-6f96da1eb32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6a24a2886f8cae8df9763b8fa3a6172, https://si.imgix.net/d319398d/uploads/origins/2cd897ad-9f55-405e-ba39-6f96da1eb32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e3d3b1bc1a2e76d003aefc521029c09 2x, https://si.imgix.net/d319398d/uploads/origins/2cd897ad-9f55-405e-ba39-6f96da1eb32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ce7c453909c96f9bc59581276a6692d 3x", "genre": "art", "nsfw": false, "body": "ぽよろいどたちが子豚と遊んでいるシーンでお願いします！！\n子豚はピンク色がいいです！ペポン人化できれば最高ですが、お任せします！\n\n説明が簡単すぎてすみません。。\nSkebを依頼することは初めてです、失礼あったらすみません。。\nよろしくお願いします！！\n\nいつもぺぽよさんの創作をお楽しみさせていただいておりまして、ありがとうございます！！！", "created_at": "", "completed_at": ""}, {"path": "/@pepoyoPPY/works/24", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdfa79f3598059f722ef449eb1bf3d4b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdfa79f3598059f722ef449eb1bf3d4b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d927670c1298854d3328f82f7844029d 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6cfac6dbd6e0a95e05c65db63e16e63 3x", "genre": "voice", "nsfw": false, "body": "ぺぽよ様、いつも作品を楽しませていただいております シチュエーションボイスというものを依頼したいです、設定等は以下の通りです\n \n躁ぽよろいどさんがめちゃくちゃメンヘラになって、「誰か」を「監禁」して「ぼくのことだけ見て、ぼくのことだけ考えてよ」とか、そんな調子で、その「誰か」をめちゃくちゃメンヘラ的に愛しまくるシチュエーションボイスをお願いします\n\n「誰か」は、聴く人の想像によって誰にでもなる(モブキャラにもなるし鬱さんにもなるし、聴いてる人にもなる)感じで、誰か分からないようにお願いします  \n\nメンヘラと言っていますが、もしかしたらヤンデレというやつかもしれません、違いが分からないのでそこはお任せします、曖昧ですが、とりあえず愛が重い感じが伝われば幸いです  \n\n最後に、こちら全年齢向けとなるようにお気を付けください\n\n難しい依頼になると思いますが、表情豊か(?)なぽよろいどさんを見てみたいので、どうかよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@pepoyoPPY/works/23", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdfa79f3598059f722ef449eb1bf3d4b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdfa79f3598059f722ef449eb1bf3d4b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d927670c1298854d3328f82f7844029d 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1779930158398660608%2F1cxmHX_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6cfac6dbd6e0a95e05c65db63e16e63 3x", "genre": "voice", "nsfw": false, "body": "依頼資料\nぺぽよ様、いつも創作を楽しませていただいております。\n今回は、ぺぽよ様に喋っていただきたいものがありますので、リクエストさせて頂きました。\n少し特殊な内容かと思いますので、お引き受けいただけるかはご一考いただけますと幸いです。  \n以下、リクエスト内容になります。\n======================\n\nはじめにぺぽよ様の自己紹介を話して頂き、そのどこかで宛名の読み上げをよろしくおねがいします\n宛名は「POYO999」となっておりますが、「ぽよないん」と読む設定ですので、skebの規約的に問題が無ければこちらの読み方でも宛名を読んで頂けるとありがたいです。\n\n次に、ぺぽよ様が思い付いたランダムな様々な単語を、1単語2秒ほどかけてゆっくりと、単語の倍ほどの間を空けて何分か呟き続ける、というような内容でお願いします\nどのような単語を呟くのかは完全にお任せします\n\nまた、ボイスの締めくくりに関してもお任せします\n\n具体的にどういうものを作って頂きたいのかは、下に用意しました資料1の10分40秒より先を視聴して頂けると分かりやすいかと思います\n\n以下参考資料になります\n=====================\n\n\n\n話す単語の内容やスピード、ペースはこちらの動画の10分40秒から先を参考にしていただけますと幸いです\n資料1\nhttps://m.youtube.com/watch?v=hOq1nY46UYU\n\nぺぽよ様自身の喋り方、喋るトーンにつきましては、今回は囁くと言うよりもつぶやくような感じで、こちらの動画の声の出し方を参考にして頂けますと幸いです。\n資料2\nhttps://youtu.be/kacmHmL-_cE\n\n資料3\nhttps://youtu.be/KMfDCliKP18\n\n以上になります\nよろしくおねがいします\n\nhttps://m.youtube.com/watch?v=hOq1nY46UYU", "created_at": "", "completed_at": ""}, {"path": "/@pepoyoPPY/works/22", "thumbnail_src": "https://si.imgix.net/c190b6ab/uploads/origins/1a245033-077f-4036-9319-b283a55e1714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=493e5469d943fd070b6d448e9f54764b", "thumbnail_srcset": "https://si.imgix.net/c190b6ab/uploads/origins/1a245033-077f-4036-9319-b283a55e1714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=493e5469d943fd070b6d448e9f54764b, https://si.imgix.net/c190b6ab/uploads/origins/1a245033-077f-4036-9319-b283a55e1714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eadeb3641b6d8a590119ad611ddb1a3 2x, https://si.imgix.net/c190b6ab/uploads/origins/1a245033-077f-4036-9319-b283a55e1714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3da30ca7da6cd64c2fe7ffcd9c5a2ba1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pepoyoPPY/works/21", "thumbnail_src": "https://si.imgix.net/80f793b0/uploads/origins/bd98350b-9ebd-4a45-9002-6a139807ddbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dd501c9ada49ede604ebdca47f486c1", "thumbnail_srcset": "https://si.imgix.net/80f793b0/uploads/origins/bd98350b-9ebd-4a45-9002-6a139807ddbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dd501c9ada49ede604ebdca47f486c1, https://si.imgix.net/80f793b0/uploads