367-afab-46d99f734173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e8db3253783439cf8dc402020c944de 2x, https://si.imgix.net/92a02476/uploads/origins/b4fe3605-ab31-4367-afab-46d99f734173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f07fb165065be231d851fa9a65a83c17 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になってます。\nご依頼させていただきます。\nガールズリミックスの初代変身メンバー６人(五十嵐さくら、夏木花、神代玲花、イズ、ツクヨミ、ポッピーピポパポ)の足裏封印をお願いしたいです。\n(表情はできたら苦痛な感じ多めで。難しい場合はおまかせいたします。)\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@buronzu2000/works/79", "thumbnail_src": "https://si.imgix.net/a2d3485c/uploads/origins/716a3cd7-3a02-48d4-abd6-1912e336cf87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ae4347df7288fb7e8162355c6a3f6a", "thumbnail_srcset": "https://si.imgix.net/a2d3485c/uploads/origins/716a3cd7-3a02-48d4-abd6-1912e336cf87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ae4347df7288fb7e8162355c6a3f6a, https://si.imgix.net/a2d3485c/uploads/origins/716a3cd7-3a02-48d4-abd6-1912e336cf87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3513ef4c5d033c346dcc4f46d430f277 2x, https://si.imgix.net/a2d3485c/uploads/origins/716a3cd7-3a02-48d4-abd6-1912e336cf87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72100888dc7957c922a21db7059fc9ff 3x", "genre": "art", "nsfw": true, "body": "乃木坂46の梅澤美波さんと遠藤さくらさんを足裏封印それぞれ別でお願いします\n梅澤さんは驚きの表情で\n遠藤さんは口を閉じた状態でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@buronzu2000/works/78", "thumbnail_src": "https://si.imgix.net/ae7031a6/uploads/origins/33bb604f-7524-4084-8397-2ccac6f372b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e010ed67770363870a6e1002b04a1bad", "thumbnail_srcset": "https://si.imgix.net/ae7031a6/uploads/origins/33bb604f-7524-4084-8397-2ccac6f372b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e010ed67770363870a6e1002b04a1bad, https://si.imgix.net/ae7031a6/uploads/origins/33bb604f-7524-4084-8397-2ccac6f372b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5887c62b7f53c05cd1c2f4a3c2ae43dc 2x, https://si.imgix.net/ae7031a6/uploads/origins/33bb604f-7524-4084-8397-2ccac6f372b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1ddd53096dc5767010a844a684b6d05 3x", "genre": "art", "nsfw": true, "body": "前回は、ありがとうございます\n最高でした\nhttps://skeb.jp/@buronzu2000/works/68\n今回もお願いします\n\nキャラ:\nローズ:\n種族: 大精霊\n一人称:ワタクシ\n性別:女\n身長: 伸縮自在(今は約4m以上)\n色:全体的に明るいピンク(カラーまつ毛や髪や服など)、褐色、オッドアイ(目の色は水色と赤)\n性格:お嬢様口調、大人しい、物静か、プライドが高い\n見た目: 美しく大人しそうな見た目(羽川ハスミみたいな感じ)、エルフ耳、目はいつも閉じてる、顔は細め、十等身以上、爆乳、方目メカクレ、地に着くぐらいに長いロング、かなりスレンダーな体つき\n短小巨玉ふたなりが生える時がある。\n衣装:踊り子に近い衣装、フェイスベールと長いベールを着用して、フィンガーループ&長いショール(先っちょが中指に引っ掛けている穴になっている)、横乳、腹とヘソは露出し、大きく膨らんだハーレムパンツと腰マントと腰ベール、裸足(ちなみに彼女はノーパン)\n\n全身立ち絵(&オッドアイ&短小巨玉)\nhttps://files.catbox.moe/cnt4u2.jpeg\n差分絵\nHttps://files.catbox.moe/8cex5a.jpeg\n\n4m越えモルガン(&ハーレムパンツ(裸足))\nhttps://files.catbox.moe/1e6s06.jpeg\n\n【シチュ】\nふっくらハーレムパンツの4m越えのローズは、同サイズのモリガンにcockvoreされて、金玉の中に閉じ込められ、性液共にシェイクされ、性液コーティングされ、ハーレムパンツは中に性液が入り、それがぎっちり詰まり、更に膨らんだ\nその後、金玉の圧力で圧縮され、射精され、手のひらサイズの濃厚圧縮性液玉にされ、モリガンは性液玉を地面に落とし、性液玉は一瞬で膨らんでいき、破裂して、大量の性液が溢れ出し、中から、性液コーティングされた、固められる前より膨らんだハーレムパンツを着たローズの4m越え性液像(差分絵では、短小巨玉付き)が…\n\nローズの表情\n酷い匂いに臭がり、圧縮された窮屈な苦しみや、身体をほぐされる気持ちよさなどの感情が混じっているが、プライドが高く、屈しない為、必死に耐えようとしてる表情。\n\nイメージ図:\nhttps://files.catbox.moe/c4pk2n.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@buronzu2000/works/77", "thumbnail_src": "https://si.imgix.net/914498a8/uploads/origins/0bc1823b-12fd-4a61-b45a-7d7c0072f39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5389b5343f5833e4b9977b0e738772ae", "thumbnail_srcset": "https://si.imgix.net/914498a8/uploads/origins/0bc1823b-12fd-4a61-b45a-7d7c0072f39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5389b5343f5833e4b9977b0e738772ae, https://si.imgi