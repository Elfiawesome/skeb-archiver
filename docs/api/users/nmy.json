c-8b0a5bc41d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1bc3ae90ace35430234bd0c0b3e233e, https://si.imgix.net/0ef43017/uploads/origins/e55648a5-4608-4091-adac-8b0a5bc41d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cdaa68a1c1f51e2513842d4b6018010 2x, https://si.imgix.net/0ef43017/uploads/origins/e55648a5-4608-4091-adac-8b0a5bc41d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8105e5461a522f66ee502e597893dbd 3x", "genre": "art", "nsfw": false, "body": "ノミャ様こんばんは、お世話になっております。\n以前いただいたイラスト、今も愛用しております…！\n\n新衣装を実装したのでその私を描いていただきたく思います！\n使用用途はYouTubeやSNSでアピール画像として。\n構図、ポーズに特に指定はありません。\n背景がある場合は透過もいただけますと幸いです！\n衣装にはアレンジなどもしていただいても大丈夫です！\nよろしくお願いいたします！\n\n衣装資料：https://drive.google.com/drive/folders/1M_AzIUmdMOdTNLkjuU9EeQih7tDa6TBK?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nmy/works/47", "thumbnail_src": "https://si.imgix.net/7722fcbb/uploads/origins/715f76b1-ef28-44b2-88c2-7c1afb45cb49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36376aa5fcb6badf4075c8082773b067", "thumbnail_srcset": "https://si.imgix.net/7722fcbb/uploads/origins/715f76b1-ef28-44b2-88c2-7c1afb45cb49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36376aa5fcb6badf4075c8082773b067, https://si.imgix.net/7722fcbb/uploads/origins/715f76b1-ef28-44b2-88c2-7c1afb45cb49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e957d84e52a55f9b9f30e9c73b4f1821 2x, https://si.imgix.net/7722fcbb/uploads/origins/715f76b1-ef28-44b2-88c2-7c1afb45cb49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5d9bdb8b16d6b09685248469fcbf12d 3x", "genre": "art", "nsfw": false, "body": "ノミャ先生、アピールはありがとうございます！\n\nEda Louis（エダ・ルイ）と申します。\nイラストのご依頼に関しましてご連絡させていただいております。\n\nさっそくですが、依頼の内容に関しましては黒魔術師（弟子）VTUBER「エダ・ルイ」です。\n魔法使いの雰囲気が重要ですが、ポーズははお任せできればと存じます。\nもしできれば、ノミャ先生が前に描いたSkeb (https://skeb.jp/@nmy/works/40) のような構図をお願いしたいですが、無理の場合は大丈夫です！ (*'ω'*)\n\nお金にならないVtuber活動に利用したいです（アイコン、スケジュールなど）\n\n資料欄に全体姿と参考資料が添付されているリンクを共有致します。\n\n何卒宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1QRaCofpg53Spqy7zK8F6L5SuCuWt_URM?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nmy/works/46", "thumbnail_src": "https://si.imgix.net/739f44da/uploads/origins/ec2dcc78-5f40-4b69-bb59-f0547a4e0f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=846deeb8eafb89a1a133eaca3a623ae1", "thumbnail_srcset": "https://si.imgix.net/739f44da/uploads/origins/ec2dcc78-5f40-4b69-bb59-f0547a4e0f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=846deeb8eafb89a1a133eaca3a623ae1, https://si.imgix.net/739f44da/uploads/origins/ec2dcc78-5f40-4b69-bb59-f0547a4e0f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52b87d9b28268ce1ae4fef9bfa2b7925 2x, https://si.imgix.net/739f44da/uploads/origins/ec2dcc78-5f40-4b69-bb59-f0547a4e0f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f31c9019713558d190e3fcc9f37bf9d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nmy/works/45", "thumbnail_src": "https://si.imgix.net/aaf3e446/uploads/origins/42c9f358-d611-4b85-825a-0197afe3eaa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e0f183f19b818dc57cc25e83633ec8b", "thumbnail_srcset": "https://si.imgix.net/aaf3e446/uploads/origins/42c9f358-d611-4b85-825a-0197afe3eaa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e0f183f19b818dc57cc25e83633