2026-03-15T05:20:27.704413+00:00"}, {"amount": 6000, "recorded_at": "2026-03-16T05:18:13.028617+00:00"}, {"amount": 12000, "recorded_at": "2026-03-16T23:44:47.231855+00:00"}, {"amount": 9000, "recorded_at": "2026-03-18T02:43:43.976714+00:00"}]}, "current_prices": {"art": 9000}, "price_range": {"art": {"min": 5000, "max": 12000}}, "links": [{"label": "Twitter", "url": "https://x.com/ppsycho02", "name": "ppsycho02"}, {"label": "Website", "url": "https://sites.google.com/view/psycho02", "name": ""}, {"label": "BOOTH", "url": "https://ppsycho02.booth.pm", "name": "ppsycho02"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/58394", "name": "58394"}, {"label": "Fanbox", "url": "https://psycho02.fanbox.cc", "name": "psycho02"}], "flags": {"from_archive": true}, "works": [{"path": "/@ppsycho02/works/91", "thumbnail_src": "https://si.imgix.net/bd7786bd/uploads/origins/1ce7f479-5137-45fb-bf3e-5cfd4dc7338a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9891b6950f1d06f63b87f2e69cd489ff", "thumbnail_srcset": "https://si.imgix.net/bd7786bd/uploads/origins/1ce7f479-5137-45fb-bf3e-5cfd4dc7338a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9891b6950f1d06f63b87f2e69cd489ff, https://si.imgix.net/bd7786bd/uploads/origins/1ce7f479-5137-45fb-bf3e-5cfd4dc7338a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5515709d51aa6ef39b85acc19276dd2 2x, https://si.imgix.net/bd7786bd/uploads/origins/1ce7f479-5137-45fb-bf3e-5cfd4dc7338a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b127880ac848ced582994bbc16bc40f 3x", "genre": "art", "nsfw": false, "body": "新作の製作お疲れ様です！\nリリース心待ちにしております。\n\nよろしければ、村岡葵くんのイラストをお願いさせていただきたいです。 \n義務服姿であれば大変嬉しいですが、構図シチュエーション等含めpsycho02様に全てお任せいたします。\n \n体調の崩しやすい気候になって参りましたが、ご無理はせずお身体にはお気をつけてお過ごしくださいませ。\nご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/90", "thumbnail_src": "https://si.imgix.net/57fd56cd/uploads/origins/fb829479-6904-465c-8c23-83af48d8826c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aa308d327ab6c3cbec3d37e45320c4b", "thumbnail_srcset": "https://si.imgix.net/57fd56cd/uploads/origins/fb829479-6904-465c-8c23-83af48d8826c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aa308d327ab6c3cbec3d37e45320c4b, https://si.imgix.net/57fd56cd/uploads/origins/fb829479-6904-465c-8c23-83af48d8826c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83bc18d112da0b4951b6ea72019a4937 2x, https://si.imgix.net/57fd56cd/uploads/origins/fb829479-6904-465c-8c23-83af48d8826c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f497da8881cba69dfd732c00992e1276 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつもpsycho02様の作品を楽しませてもらっています！\n\n今回のリクエストなのですが、興味津々な様子でこちらへ迫ってくるピクチャンをお願いできたらと思います。\nシチュエーションや構図などの細かい点はお任せしたいと思います。ご検討の程よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/89", "thumbnail_src": "https://si.imgix.net/8ee07580/uploads/origins/4a891dcd-9839-4a6d-b1f4-664a32de24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aee4eae950361401dc627558dcf98cf", "thumbnail_srcset": "https://si.imgix.net/8ee07580/uploads/origins/4a891dcd-9839-4a6d-b1f4-664a32de24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aee4eae950361401dc627558dcf98cf, https://si.imgix.net/8ee07580/uploads/origins/4a891dcd-9839-4a6d-b1f4-664a32de24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2b664ddf24bac96288d5970a0edb3ac 2x, https://si.imgix.net/8ee07580/uploads/origins/4a891dcd-9839-4a6d-b1f4-664a32de24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e310a9b28e2b7b4f865a5601ad67bdbd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前にポラリスのスケブを頼んだ者です、あのときは本当にありがとうございました！！！\n\nよろしければ、今回もまたミマモロール！のアルテン・リステンが好きなので、依頼させていただきたいです…！\nスケジュールが厳しければキャンセルしちゃってください！\n構図やシチュエーションはお任せします！好きなように描いちゃってください、この子たちのイラストが少なすぎる気がするのでとにかく見たい\n褐色無表情人外ロボが大好きです\nお身体には気を付けて…", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/88", "thumbnail_src": "https://si.imgix.net/079b4fd9/uploads/origins/f54b189c-2501-43e0-b65d-3bf85e6830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839fbdc9c03841afa6b0e0939ca42581", "thumbnail_srcset": "https://si.imgix.net/079b4fd9/uploads/origins/f54b189c-2501-43e0-b65d-3bf85e6830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839fbdc9c03841afa6b0e0939ca42581, https://si.imgix.net/079b4fd9/uploads/origins/f54b189c-2501-43e0-b65d-3bf85e6830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1a13eeedccdbeac2a0df5d5caef984f 2x, https://si.imgix.net/079b4fd9/uploads/origins/f54b189c-2501-43e0-b65d-3bf85e6830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e81be5125b102490aa432aee59464b06 3x", "genre": "art", "nsfw": false, "body": "psycho02様\n\n以前の依頼の際はありがとうございました。\n今回は以前依頼させて頂いたキャラクターの必殺技カットイン風のイラストの依頼をお送りいたします。\n用途はTRPG用となり、公開範囲はクローズドな場となる予定です。\n以下に希望内容を記載するのですが、無理があったり気に入らなければ再送依頼もしくはキャンセルを頂ければと思います。\n\n〇希望内容\n・URLのキャラクターがキセルを差し向けて術を行使してそうなカットインを依頼したいです。\n・キセルの先からたなびく妖しい色の煙が腕を振った軌跡を描いている、みたいなイメージです。\n・片目閉じていたずらするかのような表情だとうさん臭さが増していいかもなとぼんやり思っております。\n・この機会にお聞きしたいのですがこちらのキャラクターってもしかして中に黒いインナー着てたりします……？手首の辺りからそう思ったのですが……。もしそうなら首元あたりにチラってした時にすごくすごい有難いなって思います。\n・この依頼の機序としてはpsycho02さんのご作品の「ミマモロール！」の敵キャラの大技カットインみたいなのがあると大変嬉しいなと思って依頼させて頂いております。\n・もし可能であれば、ちび丸眼鏡、でかサングラス、裸眼を切り替えられるよう差分がありますととてもとても助かります……。\n\n細かい指定となってしまい大変恐縮です。\n繰り返しになりますが、気に入らない部分などありましたら返却頂ければと思います。 \nどうかご一考いただけますと助かります。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14D1ruSPJnMsdvvjOTMtLSMdW-f6vijI0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/87", "thumbnail_src": "https://si.imgix.net/6cccbeec/uploads/origins/e8b4f783-4ffd-42d7-bcba-44f90555ce53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c31df6e6e11869ed22c3ee5e132a9a", "thumbnail_srcset": "https://si.imgix.net/6cccbeec/uploads/origins/e8b4f783-4ffd-42d7-bcba-44f90555ce53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c31df6e6e11869ed22c3ee5e132a9a, https://si.imgix.net/6cccbeec/uploads/origins/e8b4f783-4ffd-42d7-bcba-44f90555ce53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53397e2287af7a5030d128d5bbcd9513 2x, https://si.imgix.net/6cccbeec/uploads/origins/e8b4f783-4ffd-42d7-bcba-44f90555ce53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05c63e2982b78d6006e545bd88fa7edc 3x", "genre": "art", "nsfw": false, "body": "いつもゲーム作品楽しませて頂いております、1ファンの人間です！\nskebを受け付けてらっしゃるとのことで勢いでご依頼させて頂いてます、\n本題のご依頼なのですが ocキャラクターを バトラー風立ち絵イラストでお願いさせて頂きたいです……！！\n\n資料に関してはURLに記載しております物を参考にして頂けると幸いです。\nまたモチーフがAIや電脳チックな子なので、エフェクトなどはそういったものを参考にしていただけると大変嬉しく思います\n\nお忙しい中だとは思いますが ご検討して頂けると幸いです……！！\nまた、新作ゲームもとても楽しみにしております……！！\n\nhttps://drive.google.com/drive/folders/1oM_xjWOtFlyoqiXJr0P8c_oNSEg13_jP", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/86", "thumbnail_src": "https://si.imgix.net/cffeae97/uploads/origins/abbeb873-f654-46b3-84da-3ae36d46db39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98c8be47b228a74a170f59236359f0e", "thumbnail_srcset": "https://si.imgix.net/cffeae97/uploads/origins/abbeb873-f654-46b3-84da-3ae36d46db39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98c8be47b228a74a170f59236359f0e, https://si.imgix.net/cffeae97/uploads/origins/abbeb873-f654-46b3-84da-3ae36d46db39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6aac119973a62c3bc0f4561f8e60e27 2x, https://si.imgix.net/cffeae97/uploads/origins/abbeb873-f654-46b3-84da-3ae36d46db39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8edc5cf9acac6e54cb5044d038fcf09f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nミマモロールを最近クリアした者です、素敵な作品を作ってくださりありがとうございます…！\n現在のゲーム創作も応援しています…！完成が楽しみです。\n\nリクエストなのですが、可能でありましたらミマモロール！のポラリスをお願いしたいです。ストーリーの鬱状態の彼が好きで好きで…いくつか考えましたがシチュ等はお任せします！もしよければ、何か表情等の差分があると嬉しいです…！\n\nスケジュール的にダメそうならキャンセルしちゃってください！\nまだまだ寒いですが、お体には気をつけてください…！\nご検討いただければ幸いです、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/85", "thumbnail_src": "https://si.imgix.net/213a7de9/uploads/origins/0212961d-1b99-4067-91c5-a153d9d77ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509eaf30faeac6006394356e2db1ea1d", "thumbnail_srcset": "https://si.imgix.net/213a7de9/uploads/origins/0212961d-1b99-4067-91c5-a153d9d77ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509eaf30faeac6006394356e2db1ea1d, https://si.imgix.net/213a7de9/uploads/origins/0212961d-1b99-4067-91c5-a153d9d77ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cd6fa02ef281ada57e683f77ec4d316 2x, https://si.imgix.net/213a7de9/uploads/origins/0212961d-1b99-4067-91c5-a153d9d77ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38d72fb8b82406c8b725b43ee9f55582 3x", "genre": "art", "nsfw": false, "body": "すみません！金額を間違えていたため再送させていただいております。\n\nはじめまして。ミマモロールやドリートポーカーで楽しく遊ばせていただいています。また、トリモの進捗もいつも楽しみに拝見しております。\nどのキャラクターも可愛くて好きなのですが、推しはエウ・エウと、エル・エルルです！\n\n今回は、TRPGのオリキャラをリクエストさせていただきたく、ご連絡いたしました。\nイラストの内容に関しては、ご自由に描いていただければとおもいます。服装も変えていただいて構いません。\n参考画像は、お手数ですが、資料URLのくるっぷの記事をご参照いただけますと幸いです。差分など全部載っています。\n\nアウトローな世界観で何でも屋の交渉係を担当している成人男性です。\n仕事のためにお化粧・中性的な服装をしている、という設定です。\n\n以上です。よろしくおねがいします。\nこれからも応援しています！\n\nhttps://crepu.net/post/12379029", "created_at": "", "completed_at": ""}, {"path": "/@ppsycho02/works/84", "thumbnail_src": "https://si.imgix.net/398c53c3/uploads/origins/5d58336d-533b-4b19-80c1-9b97382737f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3042b7a76a28bf36b6ac240e19eb95f", "thumbnail_srcset": "https://si.imgix.net