ddle%2Ccenter&txtsize=30&txt=PRIVATE&s=82a37797ebd333944004537526f464ad 2x, https://si.imgix.net/8cba5d58/uploads/origins/d59f0af9-d8c7-4e0c-9ba7-7bb981a90705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d99091319ce27ce2977b6a8bef7eeed 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/67", "thumbnail_src": "https://si.imgix.net/efb1b2c3/uploads/outputs/21f4800c-0adb-4635-96f8-f6f9436ae997?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d43ec2c66b898236336e0c49958a08e3", "thumbnail_srcset": "https://si.imgix.net/efb1b2c3/uploads/outputs/21f4800c-0adb-4635-96f8-f6f9436ae997?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d43ec2c66b898236336e0c49958a08e3, https://si.imgix.net/efb1b2c3/uploads/outputs/21f4800c-0adb-4635-96f8-f6f9436ae997?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ae4f8c5842b8604abcfe0e004a4dfe9 2x, https://si.imgix.net/efb1b2c3/uploads/outputs/21f4800c-0adb-4635-96f8-f6f9436ae997?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8459a62ac0f723ede98f957338634a25 3x", "genre": "video", "nsfw": true, "body": "お疲れさまです。\n\n今回もオリキャラ「ユリル・シルヴィオン」のムービーを作って頂けないでしょうか。\n内容としましては、前回作って頂いたスライム姦の続きになります。\nhttps://skeb.jp/@3byakuyen/works/54\n\n◯ユリル・シルヴィオン\nhttps://drive.google.com/drive/folders/1XLaPMfBhaUD1g_R1oz6HRRbIPNQ22gCw\n\n①浮遊するスライムに犯されボテ腹になった「ユリル」。\n絶頂の余韻に浸っていると部屋の奥から巨大なスライムが現れ、「ユリル」に近づくと身体を持ち上げてスライムの体表に磔にする。\n(https://www.pixiv.net/artworks/99646189)\n\n②スライムの体から3本の触手が伸び、2本は乳首を露出させて胸に吸い付き搾乳を行い、\n（https://www.pixiv.net/artworks/100839912）\nもう1本は秘部に挿入される。\n\n③秘部に挿入された触手は白濁液でパンパンに膨れた子宮に侵入、白濁液をかき混ぜるようにのたうち回り、子宮内壁に当たる度にボテ腹が「ボコッボコッ」と形を歪めながら跳ねる。\n歯を食いしばりながら耐えようとするも絶頂してしまう。\n\n④何度か絶頂した後、触手がポンプのような動きをし始め、テニスボール大のカエルの卵の様な卵を子宮目掛けて流し込んで行く。子宮内に到達した瞬間「ドクン」とボテ腹が大きく跳ねる。\nスライムは限界まで卵を流し込み、子宮に入る度にユリルは何度も絶頂する。\nそして受精した卵が子スライムに孵化する。\n\n⑤植え付けが終わるとボテ腹が一回り大きく膨れ、苦しそうにしていると「モゴモゴ」と子宮内で何十匹もの子スライムが動き出し、子宮口をこじ開けて出ようとする。\n必死に堪えていると親スライムが触手で腹パンをするようにボテ腹を突く。\n衝撃で力が抜けた瞬間、子スライムを出産してしまう。\nそれを機に他の子スライムを立て続けに出産する。\n\n⑥すべての子スライムを出産し終えると親スライムから解放され、床にガニ股の姿勢で仰向けになりアヘ顔を晒す。\n\n〇補足\n今回も衣装の破損は無しでお願いします。\n分かり難い箇所につきましてはアレンジして頂いて構いません。\n\n今回も難しい内容で大変恐縮ですが、何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/66", "thumbnail_src": "https://si.imgix.net/5485c020/uploads/origins/7d1f2b2a-b5f5-417e-8b49-92f5e746cec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b4c0fdc060c9dc6edbfd818f9f703d4", "thumbnail_srcset": "https://si.imgix.net/5485c020/uploads/origins/7d1f2b2a-b5f5-417e-8b49-92f5e746cec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b4c0fdc060c9dc6edbfd818f9f703d4, https://si.imgix.net/5485c020/uploads/origins/7d1f2b2a-b5f5-417e-8b49-92f5e746cec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2a20f652ac46e70de9d183947637c85 2x, https://si.imgix.net/5485c020/uploads/origins/7d1f2b2a-b5f5-417e-8b49-92f5e746cec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01e42188f7e3bea4987b800d66594c1d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/65", "thumbnail_src": "https://si.imgix.net/9bb04986/uploads/origins/9bee1c41-013d-4ef4-826c-aba37527b234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac35c449ae61