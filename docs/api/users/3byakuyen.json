%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af793bd9b1b67a6dedebd87cb22d2ae1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/54", "thumbnail_src": "https://si.imgix.net/2476b8ef/uploads/outputs/207a525e-9480-44b6-b60d-9ad9a381f0f4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=42c7fd250133bd1172c835510c788239", "thumbnail_srcset": "https://si.imgix.net/2476b8ef/uploads/outputs/207a525e-9480-44b6-b60d-9ad9a381f0f4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=42c7fd250133bd1172c835510c788239, https://si.imgix.net/2476b8ef/uploads/outputs/207a525e-9480-44b6-b60d-9ad9a381f0f4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a7adb49ecf74b5b16da34c87ac5a373 2x, https://si.imgix.net/2476b8ef/uploads/outputs/207a525e-9480-44b6-b60d-9ad9a381f0f4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8427dda4d9fb3cb9c6a2cfb5e721ee0 3x", "genre": "video", "nsfw": true, "body": "お疲れ様です。\n前回はオリキャラ［ユリル・シルヴィオン］の動くイラストを作って頂き、誠にありがとうございました。\n今回はスライム姦のムービーを作って頂きたく、リクエスト致しました。\n\n◯キャラクター\nオリキャラ：ユリル・シルヴィオン（エナメルスーツ）\nhttps://drive.google.com/drive/folders/1jRZiCDE84hiV5qh_F2cuXpcrbBswjUuI?usp=drive_link\n\n◯内容\n地下の研究室のような薄暗い部屋で目隠しを装着し、キン肉バスターをかけられたようなまんぐり返しの状態で拘束されていると、天井から風船の様に浮遊するスライムが現れる。\n\n直径は約１メートル程で半透明の風船の中にはドロドロのヨーグルト状の白濁液が満タンに内包されている。\n\nスライムが真上に近づくと極太の触手を伸ばし秘部に挿入する。膣奥に到達した後ピストン運動を行う。\n\nスライムの責めに耐えきれず絶頂した瞬間、触手の先端が子宮口をこじ開けて子宮内に侵入し、触手が蠕動運動をしながら白濁液を注入する。\n\n白濁液は結合部から溢れることなく、瞬く間に子宮内を満たす。\n\nしかし、スライムはすかさず白濁液を子宮内に注入し続ける。風船内の白濁液をすべて流し込むまで止まらない。ここで一度画面が暗転する。\n\n画面が明転すると注入が終わっており、お腹はすっかりボテ腹になっている。\n\nスライムは風船内が空になると白濁液が漏れ出さないように触手の一部を切り離し蓋（極太ディルドが挿入されている感じ）をして去っていく。\n\nシチュエーションはこちらの画像を参考にしてください。\nhttps://www.pixiv.net/artworks/129964336\n\n◯補足\n衣装の破損はなしでお願いします。\n\n背景・表情など細かい所はお任せします。\n\n可能であれば、子宮内の断面図のカットも作って頂けると幸いです。\n\n難しい内容で大変恐縮ですが、何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/53", "thumbnail_src": "https://si.imgix.net/cdeb8f68/uploads/origins/314f9bfb-601f-4d01-b34a-8ea3a13eb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316efbcaba585f8a09bfad28b14d1311", "thumbnail_srcset": "https://si.imgix.net/cdeb8f68/uploads/origins/314f9bfb-601f-4d01-b34a-8ea3a13eb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316efbcaba585f8a09bfad28b14d1311, https://si.imgix.net/cdeb8f68/uploads/origins/314f9bfb-601f-4d01-b34a-8ea3a13eb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c76feb2040b152db8dd8c7f5df956c35 2x, https://si.imgix.net/cdeb8f68/uploads/origins/314f9bfb-601f-4d01-b34a-8ea3a13eb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1b4c9417dfac9f473363d64177afc21 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/52", "thumbnail_src": "https://si.imgix.net/80b38df0/uploads/outputs/c65138f4-437e-4bac-92bf-fe0115a56acc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e08c352a62e8e8a4185cf5f9f6ed0254", "thumbnail_srcset": "https://si.imgix.net/80b38df0/uploads/outputs/c65138f4-437e-4bac-92bf-fe0115a56acc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e08c352a62e8e8a4185cf5f9f6ed0254, https://si.imgix.net/80b38df0/uploads/outputs/c65138f4-437e-4bac-92bf-fe0115a56acc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=957f99994e212bb16f86109f022e2170 2x, https://si.imgix.net/80b38df0/uploads/outputs/c65138f4-437e-4bac-92bf-fe0115a56acc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4631958782369371753849cc950e8f76 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/51", "thumbnail_src": "https://si.imgix.net/321cfead/uploads/origins/9ef5984a-e3bb-4c47-8db0-4c9f4da1ef61?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b89a812961d46f1a49882089a07dd9ae", "thumbnail_srcset": "https://si.imgix.net/321cfead/uploads/origins/9ef5984a-e3bb-4c47-8db0-4c9f4da1ef61?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b89a812961d46f1a49882089a07dd9ae, https://si.imgix.net/321cfead/uploads/origins/9ef5984a-e3bb-4c47-8db0-4c9f4da1ef61?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c44e9df38367be7ee5b81b8cfddb6757 2x, https://si.imgix.net/321cfead/uploads/origins/9ef5984a-e3bb-4c47-8db0-4c9f4da1ef61?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9fc9532de659a62df5841a11dc9476f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/50", "thumbnail_src": "https://si.imgix.net/738e450f/uploads/origins/4906f183-46dd-44a1-8340-abfcac40b46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eadc985b82266890253cf35ad60c0a53", "thumbnail_srcset": "https://si.imgix.net/738e450f/uploads/origins/4906f183-46dd-44a1-8340-abfcac40b46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eadc985b82266890253cf35ad60c0a53, https://si.imgix.net/738e450f/uploads/origins/4906f183-46dd-44a1-8340-abfcac40b46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9c5b8fbe2f457d0480bb5b44d4e4e0 2x, https://si.imgix.net/738e450f/uploads/origins/4906f183-46dd-44a1-8340-abfcac40b46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66cbfa10b333315f97f692a6ec8f1376 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。\n私のオリキャラの動くイラストを描いて欲しいと思い、リクエストさせて頂きました。\n\n〇キャラクター\nオリキャラ［ユリル・シルヴィオン］\n\n〇衣装\nインナーのみの状態とエナメルスーツを着た状態と2種類ありますが、どちらか1つ。可能であれば、両方描いて頂けると幸いです。\n※下記URL参照\n\n〇シチュエーション\n両腕を大きく上に挙げながら背伸びをすると胸が「ぷるん」と揺れる。その反動でインナーの乳首部分が開き、乳首が丸見えになる。\n※表情等の細かい所はお任せ致します。\n\nお忙しい所、大変申し訳ありませんが何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jRZiCDE84hiV5qh_F2cuXpcrbBswjUuI", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/49", "thumbnail_src": "https://si.imgix.net/8af507a4/uploads/origins/3f0f1637-1403-4831-8926-187d622672ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c589b14dba9a9a323aa401ffdca67143", "thumbnail_srcset": "https://si.imgix.net/8af507a4/uploads/origins/3f0f1637-1403-4831-8926-187d622672ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c589b14dba9a9a323aa401ffdca67143, https://si.imgix.net/8af507a4/uploads/origins/3f0f1637-1403-4831-8926-187d622672ab?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71f800eaf2f6fea1a81c7ddadbd78b9d 2x, https://si.imgix.net/8af507a4/uploads/origins/3f0f1637-1403-4831-8926-187d622672ab?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8a10525af7ded90eadeaaf9c6f8a3cb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/48", "thumbnail_src": "https://si.imgix.net/33fb8a03/uploads/outputs/413aaadb-701e-4a09-abfb-2038fbfe0a08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c828407c1abbae9f5db1c93773635982", "thumbnail_srcset": "https://si.imgix.net/33fb8a03/uploads/outputs/413aaadb-701e-4a09-abfb-2038fbfe0a08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c828407c1abbae9f5db1c93773635982, https://si.imgix.net/33fb8a03/uploads/outputs/413aaadb-701e-4a09-abfb-2038fbfe0a08?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=770904101817878929e90e93e8293cb5 2x, https://si.imgix.net/33fb8a03/uploads/outputs/413aaadb-701e-4a09-abfb-2038fbfe0a08?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ef62c192d4322e140a11568c29734ae 3x", "genre": "video", "nsfw": true, "body": "こんにちは。\nゼノブレイド2のプネウマのビデオをお願いしたいです。(https://xenoblade.fandom.com/wiki/Pneuma)\nプネウマがゆっくりと服を脱ぐところから始まります。そしてフェラチオと荒いディープスロートから始まります。その後、POV視点でのミッションセックスが始まる。そして後背位セックスが始まる。最後はアヘ顔でお願いします。最後はパイズリで、彼女の胸と顔に射精して終わります。\n男性キャラクターは大人のレックス（https://xenoblade.fandom.com/wiki/Rex）をベースにしてほしいが、あまり見せないでほしい。プネウマの胸のサイズを大きくして、胸の緑色のコアクリスタルを忘れないでください。グリマーというキャラクターが持っているコアクリスタルをフルで彼女に与えてください (https://xenoblade.fandom.com/wiki/Pneuma)\nオプション：逆牛の女の子のシーンを入れてください。", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/47", "thumbnail_src": "https://si.imgix.net/22f0ba30/uploads/origins/609a02e3-f5c3-4064-b653-cfbbbbdc3c17?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=898233c3ea434eb3cfbe10896b8671b1", "thumbnail_srcset": "https://si.imgix.net/22f0ba30/uploads/origins/609a02e3-f5c3-4064-b653-cfbbbbdc3c17?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=898233c3ea434eb3cfbe10896b8671b1, https://si.imgix.net/22f0ba30/uploads/origins/609a02e3-f5c3-4064-b653-cfbbbbdc3c17?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af647156f88093ca5899b3592a2d80f7 2x, https://si.imgix.net/22f0ba30/uploads/origins/609a02e3-f5c3-4064-b653-cfbbbbdc3c17?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce1a69de2e2fb80619695192666ca47e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/46", "thumbnail_src": "https://si.imgix.net/93190993/uploads/outputs/f50fae89-b5a0-4e87-8411-51428ce6e368?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b09c377baea9ae53745dbe1e821116a0", "thumbnail_srcset": "https://si.imgix.net/93190993/uploads/outputs/f50fae89-b5a0-4e87-8411-51428ce6e368?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b09c377baea9ae53745dbe1e821116a0, https://si.imgix.net/93190993/uploads/outputs/f50fae89-b5a0-4e87-8411-51428ce6e368?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=8615981d81c64966701c412ba6852e03 2x, https://si.imgix.net/93190993/uploads/outputs/f50fae89-b5a0-4e87-8411-51428ce6e368?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1103d6003946e53f9e0b4ad4f01609a9 3x", "genre": "video", "nsfw": true, "body": "こんにちは、はじめまして。\nあなたのコンテンツがとても好きです。\n\n私の女性OCのビデオをお願いしたいのですが、寝ている間に胸がどんどん大きくなってしまいます。お願いできますか？\n\nかわいいパジャマを着て、ボタンを留めたトップスを着て寝てほしいです。胸はAカップかBカップ。\n呼吸をするたびに胸が1～2カップ大きくなります。\n成長するにつれて、乳房がパジャマに押しつけられ、乳首はますます目立つようになる。\n次々とボタンが外れて胸が露わになり、成長し続ける。\n\n最大サイズは自分で決められます。私にサイズ制限はないので、大きければ大きいほどいい。\n\nhttps://drive.google.com/drive/folders/1E9w17N5ITuObjAH3-zCFWz-XBXlDzpzK", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/45", "thumbnail_src": "https://si.imgix.net/c10a8f56/uploads/outputs/c11ff652-56bf-4a7c-9b0e-cb78797bbcdb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fc4b22305d97ebc4ae351982168b20e", "thumbnail_srcset": "https://si.imgix.net/c10a8f56/uploads/outputs/c11ff652-56bf-4a7c-9b0e-cb78797bbcdb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fc4b22305d97ebc4ae351982168b20e, https://si.imgix.net/c10a8f56/uploads/outputs/c11ff652-56bf-4a7c-9b0e-cb78797bbcdb?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b90b419561206ca42bd98b1c9a48147f 2x, https://si.imgix.net/c10a8f56/uploads/outputs/c11ff652-56bf-4a7c-9b0e-cb78797bbcdb?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=167c8883737919dd01d18a1600d6670d 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/44", "thumbnail_src": "https://si.imgix.net/4fa49f11/uploads/outputs/8f66bd98-3740-48b1-be33-ddd828103a51?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ba0f803adcddcfaa8213d76894b91f99", "thumbnail_srcset": "https://si.imgix.net/4fa49f11/uploads/outputs/8f66bd98-3740-48b1-be33-ddd828103a51?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ba0f803adcddcfaa8213d76894b91f99, https://si.imgix.net/4fa49f11/uploads/outputs/8f66bd98-3740-48b1-be33-ddd828103a51?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=f812964f01501d48bde32146769dda90 2x, https://si.imgix.net/4fa49f11/uploads/outputs/8f66bd98-3740-48b1-be33-ddd828103a51?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ce306afae1116f6b0de729a7c2897e1 3x", "genre": "video", "nsfw": true, "body": "お久しぶりです！前回はゼルダの最高にえっちなのをありがとうございました！今回もよろしくお願いします！\n\n今回依頼したいのはアニメ、ソードアートオンラインに登場するアリス・シンセシス・サーティちゃんの敗北えっちになります！\n\n竿役には同作に登場するチュデルキンという全身色白の男を使って頂きます！\n\nアリス参考↓\nhttps://sao-alicization.net/character/?chara=alice\n\nチュデルキン参考↓\nhttps://dengekionline.com/articles/51546/\n\nキャラ設定\n\nアリス，頭の白いヘッドバンドはそのままで、服装は青色の紐ビキニ，片目に黒い布で眼帯，白色の長い手袋と靴下，\n胸のサイズは巨乳で大きさ控えめで、膨乳されて特大爆乳に！紐ビキニに隠れていた乳輪も大きくなりビキニが胸に食い込むムッチムチおっぱいに！\n\nチュデルキン・顔は口のニヤケ面だけ写して顔半分は暗い影で自主規制して頂き、白いパンツ一枚、超低身長で少しお腹が出た中年体型、パンツ越しでも分かるぐらい超もっこりしている\n分身や膨乳術など使える\n\nチンポは前回のゼルダで使って頂いたボコブリンと同じ色で、チンポは白色、亀頭が灰色\nチンポのサイズは極太ロング、亀頭はボコブリンよりデカいデカ亀頭でお願いします！デカ金玉\n\nシチュ，構図\n\n最初胸元両手で隠して恥ずかしがるアリス\n\nチュデルキンが紫色の念力波みたいなのを手から出す\n\nすると胸が巨大化！アリスは超ビックリ❗️\n\nさらに追い討ちでパンツをおろしデカチン披露するチュデルキン\n\nデカパイでパイズリさせられる、飛び出した亀頭を口で吸う\n↓\n口内射精＆ぶっかけ\n\n次のシーンでロープで空中にまんぐりポーズで縛りあげられている、後ろからチュデルキンがしがみつきデカチン挿入準備，マンコの所にチンポと金玉のみ分身させ挿入準備\nアリスは頭をブンブン横に振り嫌がる仕草\n\n参考シチュや体位↓\nhttps://www.pixiv.net/artworks/103225528\n\n両穴同時挿入！アリスは舌出し顔仰け反り即イキ！\n↓\n段々と加速するピストン、それに伴い表情がトロトロに\n↓\n最後は両穴何度も大量中出し！\nチンポ引き抜き顔や体全体に沢山ぶっかけて放心アヘ顔エンド…\n\nみたいな感じでお願いします❗️", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/43", "thumbnail_src": "https://si.imgix.net/6b0fab28/uploads/origins/c841de66-fc2b-4ef0-a0e6-0eaaf6cdd6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ff860b4f03d0324fd72575117b64fe8", "thumbnail_srcset": "https://si.imgix.net/6b0fab28/uploads/origins/c841de66-fc2b-4ef0-a0e6-0eaaf6cdd6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ff860b4f03d0324fd72575117b64fe8, https://si.imgix.net/6b0fab28/uploads/origins/c841de66-fc2b-4ef0-a0e6-0eaaf6cdd6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21e79ad6a6029f5111ede0beb2d395e7 2x, https://si.imgix.net/6b0fab28/uploads/origins/c841de66-fc2b-4ef0-a0e6-0eaaf6cdd6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67f979c06b16dc50f12b2f5a9dbc60ff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3byakuyen/works/42", "thumbnail_src": "https://si.imgix.net/8a8dcc2c/uploads/outputs/5afb78aa-9091-4a27-89f7-3b7e06e99bbc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=05853b88e6ac7637efab1480d7b9bb30", "thumbnail_srcset": "https://si.imgix.net/8a8dcc2c/uploads/outputs/5afb78aa-9091-4a27-89f7-3b7e06e99bbc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=05853b88e6ac7637efab1480d7b9bb30, https://si.imgix.net/8a8dcc2c/uploads/outputs/5afb78aa-9091-4a27-89f7-3b7e06e99bbc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7d38cbc7813cadd416c4efe76be1510 2x, https://si.imgix.net/8a8dcc2c/uploads/outputs/5afb78aa-9091-4a27-89f7-3b7e06e99bbc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbf42c783d7a9918b01fcb7117193991 3x", "genre": "video", "nsfw": true, "body": "1.0シリーズ \nエリートの教室 \n\n1.1 登場人物 \n一ノ瀬ほなみ \n\n綾小路清隆 \n\n1.2\n前回のリクエストの続きです。\n\n2.0\nほなみは緊張しながらも、清隆が彼女のアソコにペニスを押し当てるのを見守る。\n\n清隆がほなみの中に入ってくると、ほなみは処女喪失の軽い痛みを感じる。\n\n最初は清隆はほなみに優しく、ほなみにも快感を与えるようにする。\n\n痛みが和らぎ、穂波が気持ちよくなり始めると、清隆はスピードを上げる。\n\n清隆は穂波の中に射精し、穂波は驚いた。\n\nほなみは自分の中に精液が残っていることを気にしながらお腹を見つめるが、清隆はまだ満足せず、もう一度ほなみを犯し始める。\n\n清隆はセックスをしながら、今度は穂波の胸をまさぐる。\n\nほなみは以前と比べ強烈な快感を覚える。\n\n清隆はもう一度射精しようとすると、穂波に近づきキスをし、穂波もキスを返す。\n\nほなみは清隆に足を巻きつける。\n\n清隆は再び穂波の中に射精し、穂波もオーガズムを感じる。\n\nほなみはセックスができたことに満足する。", "created_at": "", "completed_at": ""}]}