80-22d320fb80ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b2dcb1198d7c8af1aa368718162aec6 2x, https://si.imgix.net/7fcce47d/uploads/origins/a93939b3-95a4-40d0-9280-22d320fb80ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb3f6dc4db9a8daf7dda677cd2b7af0e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Katze_Zucker/works/8", "thumbnail_src": "https://si.imgix.net/aa178731/uploads/origins/187f0c7e-9ebc-40ba-9ebd-185760c8314d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aba8f838daf8d99ce6600afa13b06683", "thumbnail_srcset": "https://si.imgix.net/aa178731/uploads/origins/187f0c7e-9ebc-40ba-9ebd-185760c8314d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aba8f838daf8d99ce6600afa13b06683, https://si.imgix.net/aa178731/uploads/origins/187f0c7e-9ebc-40ba-9ebd-185760c8314d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26c7a6e84bc68af0377424a4da04d1bb 2x, https://si.imgix.net/aa178731/uploads/origins/187f0c7e-9ebc-40ba-9ebd-185760c8314d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4551a1a04426c6f66eb6bcde307dd81c 3x", "genre": "art", "nsfw": true, "body": "カッツェさんが描かれたこちら（https://x.com/Katze_Zucker/status/1894224636126384277）のハイグレ戦闘員に改造されてしまったうちの子、ツァンフーをお願いします！\n性格はこちら（https://skeb.jp/@Katze_Zucker/works/5）でも記入しましたが、元からマゾの素質があるメタナイトをイメージしてもらえれば大丈夫です！\n前の姿とプリケツにされた後ろの様子を描いてもらえると嬉しいです。\n\nハイグレ戦闘員にされたことによる快感や半キカイ化による影響といった、ハイグレ戦闘員にされた者の実例をうちの子で見せてもらいたいです！\nストーリーやどれぐらい描くかはお任せしますが、メモリプラグを刺されて抜かれたり、ハイグレ敬礼している様子などあると助かります！\n\nhttps://drive.google.com/drive/folders/13lKhgR-SD0c2YxM_njr35cbh6YNyCzRC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Katze_Zucker/works/7", "thumbnail_src": "https://si.imgix.net/b6e87629/uploads/origins/6a0b85bb-4856-4447-bc11-ba7e5bad0124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b7106984aeffc5f5bbb004049bf2ce", "thumbnail_srcset": "https://si.imgix.net/b6e87629/uploads/origins/6a0b85bb-4856-4447-bc11-ba7e5bad0124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b7106984aeffc5f5bbb004049bf2ce, https://si.imgix.net/b6e87629/uploads/origins/6a0b85bb-4856-4447-bc11-ba7e5bad0124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91f3141f739a8db003ef618673e7881d 2x, https://si.imgix.net/b6e87629/uploads/origins/6a0b85bb-4856-4447-bc11-ba7e5bad0124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7be4434156f22a6e3dcfd5f8791acdf9 3x", "genre": "art", "nsfw": true, "body": "我慢出来なくなってしまったのでリクさせていただきます！\n今回もお願いいたします！\n\nうちの子がBimboの街にあるラバードールの製造工場の設備で\nセックスラバードールに改造・教育されてしまうのをお願いします。\n改造中やセックスドール教育の快感には悶えながらも耐えていたけれど、出荷時には精神がBimboなセックスドールとして堕ち切ってる形にして欲しいです。\n今回は先に快感と性欲が増した身体に改造され、快感によって精神がBimboに汚されていく様子が見たいです！\n\n場所としては前回の依頼に出てきたBimboの街の中にある工場で、仕事として工場の潜入調査をしていたものの工場のトラップに引っかかってしまい\nそのまま手足を大の字拘束された状態にされて、工場らしい機械的な段階を踏んでフリフリやリボンたっぷりの変態Bimboラバードールに加工されてしまう形です。\n\nラバードールは黒紫なラバー素体にBimboケバメイクが施され、フリルが付いた露出の高い服の着用させられたり、塗装や接着によってカツラやリボンやハート、フリフリそのものをあしらわれているデザインでお願いします！（服は無い方がエロいと思うのなら無しで大丈夫です！）\n\n今回も服装やラバー化以外の改造内容、差分の枚数や内容といった細かな所はお任せしますが、少なくとも以下の姿が欲しいです！\n・全裸\n・首から下だけラバー化した状態\n・頭部含めた全身ラバー化（頭部はのっぺらぼう）\n・↑の状態で顔パーツが戻っている状態\n・セックスラバードールに加工された姿\n\nアイス：\n竜の女の子\nリヒトの幼馴染\n気が強いが友達想いで、実は奉仕属性持ち\n少し前に街の調査に行ったきり連絡が取れなくなったリヒトとツァンフーを心配し、工場の潜入調査が終わったら2人を探すつもりだった。\nhttps://x.com/NaGaKeMo_Sou/status/1257912492157624322\n\nセックスラバードール：\nBimboの街で出荷されているセックス用のラバー人形\nデザインや服装は多種多様だがどれもケバいメイクが施されており、普通に見ると服装とアンマッチしているものもある（人によってはそれが好みな人もいる）\n工場の技法で作られた特別なラバーで作られており、1からラバーで作られたものもあれば、工場に入り込んだスパイやBimboの街にとって危険な人物をラバー化加工して作られたものもある。\n後者の方は全身くまなく内臓や脳も全てラバーに置換されており、ラバーであるにも関わらず全身や内臓が性感帯であり、強烈な性的快感を感じやすくなる。（着擦れにすら快感を感じるほど）\n\n今回もマスコット体型のままでもケモロリケモショタ体型に変えていただいても構いません。\n金額が見合わなかったら再送していただければ助かります。\n\n前回と違って指定が多くて申し訳ありませんが、是非ともよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@Katze_Zucker/works/6", "thumbnail_src": "https://si.imgix.net/f6ee6721/uploads/origins/d51302f6-cbd0-4934-ba1d-deecf06321fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f94f3736319110078c1b89836fda7cf", "thumbnail_srcset": "https://si.imgix.net/f6ee6721/uploads/origins/d51302f6-cbd0-4934-ba1d-deecf06321fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f94f3736319110078c1b89836fda7cf, https://si.imgix.net/f6ee6721/uploads/origins/d51302f6-cbd0-4934-ba1d-deecf06321fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc795713b76be907b801ba0e66261604 2x, https://si.imgix.net/f6ee6721/uploads/origins/d51302f6-cbd0-4934-ba1d-deecf06321fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6298860995a91d6ddf024a576194cae 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n私の代理キャラクターが前にカッツェ氏が描いていたチビデブ化幼児退行（https://www.pixiv.net/artworks/94199982）するイラストをお願いします。\n上記作品のように私代理の通常・子供服・スモック・おむつのシーケンスを描いていただきたいです。\n工程の多いイラストですので、値段の割に合わないと感じましたら子供服・スモックの差分を省略していただいても構いません。\nよろしくお願いします。\n代理の資料：https://www.dropbox.com/scl/fi/rr8xguh5rzg0nt6ccppgj/siryou.png?rlkey=is9vuzboqvimwmvzmql13vwqs&st=nsnsun5s&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Katze_Zucker/works/5", "thumbnail_src": "https://si.imgix.net/d265ed91/uploads/origins/7b903430-0bcb-4ace-a2b3-2fa94a45dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57dd1b00031ca1f5d05cc1e682609bd4", "thumbnail_srcset": "https://si.imgix.net/d265ed91/uploads/origins/7b903430-0bcb-4ace-a2b3-2fa94a45dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57dd1b00031ca1f5d05cc1e682609bd4, https://si.imgix.net/d265ed91/uploads/origins/7b903430-0bcb-4ace-a2b3-2fa94a45dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a023feb91778b78e3bdf08f07bcf8bb0 2x, https://si.imgix.net/d265ed91/uploads/origins/7b903430-0bcb-4ace-a2b3-2fa94a45dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b654c08a6f7c9976e713233565c9e284 3x", "genre": "art", "nsfw": true, "body": "うちの子二人が下品なBimbo化をしてしまうイラストをお願いできますか？\nBimboのいる街に滞在するうちに、段々と心身共にBimboに汚染されていって欲しいです。\n\n最初は普通の服装でいたのが、Bimboが着るような短い丈の服を着るようになり\nそこからさらに下品な服装と軽めのアイシャドウや口紅、付けまつ毛といった化粧をするようになって\n最終的にはカツラを被って濃いアイシャドウや厚唇な口紅、付けまつ毛モリモリの厚化粧をして、似合う似合わないに関わらず下品な服装で裏路地で人を誘惑してる落ちぶれたBimboにしてください！\n\nシーケンスというか差分としてじわじわと少しずつBimbo化していく様子が見たいです！（差分の枚数はお任せします）\n服装や肉体改造の内容、アクセサリー等どんなものでも大丈夫です！\n肉体改造は必須ではないですのでカッツェさんにするしないはお任せします！\n\nリヒト：\n竜の女の子\n優しくて快活\nhttps://x.com/NaGaKeMo_Sou/status/1257911778878672897\nhttps://x.com/NaGaKeMo_Sou/status/1740009002770325860\n\nツァンフー：\n虎の男の子\nクールでプライドが高い\nhttps://drive.google.com/drive/folders/1M0uGProQxwPZSMTXKZ09I0HaT8TgyBXH?usp=drive_link\n\n二人ともマスコット体型ですが、マスコット体型のままでもケモロリケモショタ体型に変えていただいても構いません。\n描きやすい、描きたい方でお願いします！\n\nもし金額が見合わなかったら再送をお願いいたします。\n是非とも、よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@Katze_Zucker/works/4", "thumbnail_src": "https://si.imgix.net/46cc9ce5/uploads/origins/87dc0d5f-f6ac-4cf2-b980-632ade10c093?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9721ebe1c7ca83e1713bc661f244b2b", "thumbnail_srcset": "https://si.imgix.net/46cc9ce5/uploads/origins/87dc0d5f-f6ac-4cf2-b980-632ade10c093?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9721ebe1c7ca83e1713bc661f244b2b, https://si.imgix.net/46cc9ce5/uploads/origins/87dc0d5f-f6ac-4cf2-b980-632ade10c093?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&tx