/6ae0f2c5-de76-4b79-942e-9aeb09a7067a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8384f7ba5b659ce2686a7fdb7a198ba7", "thumbnail_srcset": "https://si.imgix.net/28b6ad1e/uploads/origins/6ae0f2c5-de76-4b79-942e-9aeb09a7067a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8384f7ba5b659ce2686a7fdb7a198ba7, https://si.imgix.net/28b6ad1e/uploads/origins/6ae0f2c5-de76-4b79-942e-9aeb09a7067a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9ee8ee253771e58ec66dff59d45601d 2x, https://si.imgix.net/28b6ad1e/uploads/origins/6ae0f2c5-de76-4b79-942e-9aeb09a7067a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79e9c7d936a0fa1f6e6dbddff04a9f3b 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます\n\n構図等指定しないので自由に書いてもらえればと思います。\nアバターの見た目についてはこちらを参考にしてください\nhttps://drive.google.com/drive/folders/1jHxpJD21ScQQSqmwLzDZhXdbrcTKlxAB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sshr_smr/works/38", "thumbnail_src": "https://si.imgix.net/550dbd3c/uploads/origins/4f946db4-68ff-4b4a-b353-81a2b993b854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85cac1d48ea58296b56271abf02002dd", "thumbnail_srcset": "https://si.imgix.net/550dbd3c/uploads/origins/4f946db4-68ff-4b4a-b353-81a2b993b854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85cac1d48ea58296b56271abf02002dd, https://si.imgix.net/550dbd3c/uploads/origins/4f946db4-68ff-4b4a-b353-81a2b993b854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e413c07eecd02b87140332bb9bc179f 2x, https://si.imgix.net/550dbd3c/uploads/origins/4f946db4-68ff-4b4a-b353-81a2b993b854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=700f003c2c814f828ad4725dbffdc9e0 3x", "genre": "art", "nsfw": false, "body": "佐々原さまこんにちは、アピールありがとうございます！\n早速なのですがB20形蒸気機関車モチーフの男の子を描いていただきたいと思います。\n可能であれば全身かそれに近い構図でお願いします。\nキャラと一緒にモチーフの蒸気機関車も描いていただけると嬉しいです！難しいようでしたらデフォルメしていただいてOKです。\nよろしくお願い致します。\n\nhttps://muuseo.com/Kaiso/diaries/150", "created_at": "", "completed_at": ""}, {"path": "/@sshr_smr/works/37", "thumbnail_src": "https://si.imgix.net/073eb13e/uploads/origins/ef1f9723-e72f-4547-a10c-51961c3c5e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c8e4cf95ec7e5084cb6382a3b0f29ff", "thumbnail_srcset": "https://si.imgix.net/073eb13e/uploads/origins/ef1f9723-e72f-4547-a10c-51961c3c5e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c8e4cf95ec7e5084cb6382a3b0f29ff, https://si.imgix.net/073eb13e/uploads/origins/ef1f9723-e72f-4547-a10c-51961c3c5e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18666b52e771145635cf01038c15cfd5 2x, https://si.imgix.net/073eb13e/uploads/origins/ef1f9723-e72f-4547-a10c-51961c3c5e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=488eb85ad437e7a52a24e091bfd558f7 3x", "genre": "art", "nsfw": false, "body": "佐々原純鈴さん、こんにちは。\n(以下、佐々原さんと呼ばせていただきます。)\n\n禾ズ真と申します。\nこの度はうちのリナリーを気に入っていただきアピールを下さり、ありがとうございます！名前やデザインをお褒めいただきとても嬉しいです！\n\n佐々原さんの絵、とても生き生きしていて魅力を感じました。\n是非うちのリナリーを描いていただきたいです！\n\n現行のメイン衣装はこちらの資料の画像2枚目になります。\nhttps://twitter.com/psyan75_17_ra/status/1615100152292990976?t=cpJ03tBmTQiF72s-UUQ_sw&s=19\n\n詳細なプロフィールはこちらです。\nhttps://twitter.com/psyan75_17_ra/status/1608929243974729732?t=3LDjkzbgWkUlDzCh2JihxA&s=19\n\nリナリーは青薔薇のアルラウネ、つまりいわゆる植物系の人外の女の子です。\n人間に擬態しない個体であるため、一目で人外と分かる緑肌が大きな特徴です。\nまた、片方の三つ編みの先端がアイデンティティである青薔薇に変形して咲いています。\n(髪を解いた場合は他の場所に青薔薇が咲いたり、もしくは青薔薇の尻尾が生えたりなどします。)\n\nその他の特徴ですが、性格は健気な癒やし系です。真面目ですがアルラウネの性質で無自覚にあざとくなることがあります。\n\n気持ち丸顔気味に描いていただけると嬉しいです。\n\n衣装は資料からお好きなものを選んでいただけると嬉しいです！\n構図は佐々原さんのイメージにお任せします。\n\n以上の内容で差し支えなければ、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@sshr_smr/works/36", "thumbnail_src": "https://si.imgix.net/5b3b4c46/uploads/origins/9fd94f8f-27bc-494c-9050-e72b332bfe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr