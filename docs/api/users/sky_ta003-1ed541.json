6b/uploads/origins/8081b836-9597-44eb-9134-0a93017c7620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60626613e3c701138d05cff9b9081d69", "thumbnail_srcset": "https://si.imgix.net/fda1ac6b/uploads/origins/8081b836-9597-44eb-9134-0a93017c7620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60626613e3c701138d05cff9b9081d69, https://si.imgix.net/fda1ac6b/uploads/origins/8081b836-9597-44eb-9134-0a93017c7620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b14643a3d4a91096ee721a0bc86492c5 2x, https://si.imgix.net/fda1ac6b/uploads/origins/8081b836-9597-44eb-9134-0a93017c7620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dca28432116952b322ba6b004ba6cab5 3x", "genre": "art", "nsfw": false, "body": "はじめまして！  あなたの作品がとても美しいので、お願いがあります！\n\n私のPSO2NGSのキャラクターを描いてください。  エルフで、耳が長くて、金髪で、胸が大きくて、頭の上に緑色のキラキラがあります。  \n\nセクシーなポーズで描いてください！  難しいディテールは必要に応じて簡略化してください。  \n\nよろしくお願いします！\n\nhttps://imgchest.com/p/o24ap8x924l", "created_at": "", "completed_at": ""}, {"path": "/@sky_ta003/works/12", "thumbnail_src": "https://si.imgix.net/4c22010e/uploads/origins/7951dfaf-08a2-4891-b7bd-87e5c024d94f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fed35d246521193315e20035019205e", "thumbnail_srcset": "https://si.imgix.net/4c22010e/uploads/origins/7951dfaf-08a2-4891-b7bd-87e5c024d94f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fed35d246521193315e20035019205e, https://si.imgix.net/4c22010e/uploads/origins/7951dfaf-08a2-4891-b7bd-87e5c024d94f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4165f8e1b567146ccd385c563d13952 2x, https://si.imgix.net/4c22010e/uploads/origins/7951dfaf-08a2-4891-b7bd-87e5c024d94f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6716a373a9b63d3d77c634574a6a14c 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nよろしければ私がゲームで使用しているキャラクターのイラストを描いていただけないでしょうか。\n和・夜のイメージで描いていただけると嬉しいです。\nご検討よろしくお願いします。\n\nhttps://imgur.com/a/spRH79R", "created_at": "", "completed_at": ""}, {"path": "/@sky_ta003/works/11", "thumbnail_src": "https://si.imgix.net/a458f32f/uploads/origins/1450138f-7b8a-47b9-b958-6c81c31d0d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2160954d2cf00d5f630b4970b7c8b4af", "thumbnail_srcset": "https://si.imgix.net/a458f32f/uploads/origins/1450138f-7b8a-47b9-b958-6c81c31d0d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2160954d2cf00d5f630b4970b7c8b4af, https://si.imgix.net/a458f32f/uploads/origins/1450138f-7b8a-47b9-b958-6c81c31d0d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23eb64b335078ccbb482d08af307bdb5 2x, https://si.imgix.net/a458f32f/uploads/origins/1450138f-7b8a-47b9-b958-6c81c31d0d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b99083d4c0a7f561838637812a36502d 3x", "genre": "art", "nsfw": false, "body": "始めまして。そあそら様 \nそあそら様の素敵なイラストを見て、私の想像するイラストを描いてもらいたいと思い、リクエストを送りました。\n依頼内容ですが、リコリス・リコイルの錦木千束と井ノ上たきながウォーハンマーのスペースマリーンのパワーアーマーを装着をしているイラストをお願いできないでしょうか？\n\nリコリス・リコイル \n錦木千束\nhttps://lycoris-recoil.com/character/?chara=chisato\n井ノ上たきな\nhttps://lycoris-recoil.com/character/?chara=takina\n\nウォーハンマーのパワーアーマー\nhttps://hobby.dengeki.com/news/1073825/\n\nヘルメットは2人とも外した状態でお願いします。\nパワーアーマーに関しましては色は千束とたきながそれぞれ着用している制服の色と同じにアレンジしてほしいです。\nイラストのイメージに関しましては戦いの後の休息中に2人で戯れあっている感じでお願いします。\nお忙しいと思いますが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sky_ta003/works/10", "thumbnail_src": "https://si.imgix.net/9d80bdcd/uploads/origins/ccdea579-101d-4a9f-af26-b9d88156309e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2abcbd1e2758321f73e45a770aa2b2", "thumbnail_srcset": "https://si.imgix.net/9d80bdcd/uploads/origins/ccdea579-101d-4a9f-af26-b9d88156309e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2abcbd1e2758321f73e45a