.net/12b14f9f/uploads/origins/dfbaf046-4e6e-41e4-8dd9-696ed7a99a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6a16c7e2f390752efc6a8e9bf2a4e15", "thumbnail_srcset": "https://si.imgix.net/12b14f9f/uploads/origins/dfbaf046-4e6e-41e4-8dd9-696ed7a99a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6a16c7e2f390752efc6a8e9bf2a4e15, https://si.imgix.net/12b14f9f/uploads/origins/dfbaf046-4e6e-41e4-8dd9-696ed7a99a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bec1cf277b549823920bad1f14f3e450 2x, https://si.imgix.net/12b14f9f/uploads/origins/dfbaf046-4e6e-41e4-8dd9-696ed7a99a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0e2d5edca9099c03b9ada50af3a2dc1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@littleurin/works/10", "thumbnail_src": "https://si.imgix.net/51485ba3/uploads/origins/4258b70c-b2d8-4c58-9048-9582ff452e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bacf1db2408d83c3eb2b6c87bfe7f1", "thumbnail_srcset": "https://si.imgix.net/51485ba3/uploads/origins/4258b70c-b2d8-4c58-9048-9582ff452e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bacf1db2408d83c3eb2b6c87bfe7f1, https://si.imgix.net/51485ba3/uploads/origins/4258b70c-b2d8-4c58-9048-9582ff452e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc333935d413e07c0055e63070dc112e 2x, https://si.imgix.net/51485ba3/uploads/origins/4258b70c-b2d8-4c58-9048-9582ff452e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59b9136bd67ed2def5ca49b5241514ce 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ドールズフロントラインの2人の女性キャラクター、UMP9とUMP45の絵を依頼したいです！\n(彼女たちの外見と服装は参考リンクにありますが、武器や装備は含めなくて結構です。ニーパッドやグローブは省いても構いません。一番重要なのは、彼女たちが黒いパンストを履いていることです)\n\nそれぞれの「ジェスチャー・リファレンス」を1つの構図にまとめてみてください。全体の構図と視点は「UMP9のジェスチャー」のように、UMP9が写真の左側、UMP45が写真の右側、2人とも右足をあげて椅子に座っていて、UMP45は赤ワインのグラスを持っていて、2人の右足の裏は赤ワインで濡れて横並びになっています！\n\nディファレンシャル\nオープンディファレンシャル：\n二人の表情はリンク先の「表情1」をご覧ください。\n\n差分は非公開：\n二人の表情がリンク先の「絵文字2」になり、赤面や八重歯が目立つ。\nリンク先で2人の表情が「絵文字3」になり、明らかに赤面し、眉毛が8本になっている。\n(4)「違い(3)」と同じだが、右足の裏に赤ワインのシミがない。\n(上記すべての差分の2人の右足は湯気が立ち、足の裏は明らかに汗で靴下の裏まで浸透している)\n\n\n背景：\nカクテルパーティーのような背景。\n\n注目すべきディテール：\n-両者とも顔に傷跡があり、UMP9は右目、UMP45は左目。髪の色と瞳孔の色も異なり、UMP9の方が明るく、UMP45の方が暗い。\n-両者とも靴を履いておらず、「右足の裏」が見える（これが最も気になる点で、足首から上の左足が見えない）。\n-両者とも「右足の裏」が写真の焦点であり、そこに切り込んではいけない、両者とも右足の裏も比較的大きい。\nどちらのストッキングもシースルーで、つま先と足の爪が見えます。どちらもつま先部分につま先パッドが入っていて、ストッキングのつま先の先端にステッチがあります。\n-2人の黒いストッキングの繊維模様、質感、シワを強調してみてください（つま先のパッドはストッキングの繊維模様とは異なりますのでご注意ください）。\n-ふたりとも、顔を開いていないときは、赤ら顔で八重眉です。\n\n解像度は約4000×3600px。\n\nお読みいただきありがとうございました。またの作品を楽しみにしています。\n\nhttps://drive.google.com/drive/folders/1TO8k7PMhjON8wkasxmAkkVvts9ZThr9g", "created_at": "", "completed_at": ""}, {"path": "/@littleurin/works/9", "thumbnail_src": "https://si.imgix.net/b472a8b9/uploads/origins/0368ac5b-52ae-4a4b-b665-11d297a78526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d656ee93fddf26f0717e2974d1134f54", "thumbnail_srcset": "https://si.imgix.net/b472a8b9/uploads/origins/0368ac5b-52ae-4a4b-b665-11d297a78526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d656ee93fddf26f0717e2974d1134f54, https://si.imgix.net/b472a8b9/uploads/origins/0368ac5b-52ae-4a4b-b665-11d297a78526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d3d9922b769ecc480984411f8c6d117 2x, https://si.imgix.net/b472a8b9/uploads/origins/0368ac5b-52ae-4a4b-b665-11d297a78526?bg=%23fff&auto=format%2Ccom