ad-be22-e7d25acc1833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=088b1a2f4bab4c4545fb4d95c1d29c94", "thumbnail_srcset": "https://si.imgix.net/25daae1a/uploads/origins/089da65a-4cf9-46ad-be22-e7d25acc1833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=088b1a2f4bab4c4545fb4d95c1d29c94, https://si.imgix.net/25daae1a/uploads/origins/089da65a-4cf9-46ad-be22-e7d25acc1833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b6efa84ef08cf20a3646b251eb00469 2x, https://si.imgix.net/25daae1a/uploads/origins/089da65a-4cf9-46ad-be22-e7d25acc1833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50f002d37461382a7af4f513a84efc5a 3x", "genre": "art", "nsfw": true, "body": "It先生、ご機嫌いかがおいででしょうか。お忙しくおいでのご様子と存じ上げながら不躾にお邪魔して申し訳ありません。\n当方は先だって、先生に「クリーチャー化してしまった美少年」の題材を手掛けていただきました者です。その節は本当にありがとうございました！\n\n実は、かの傑作の感激が忘れ難くて、かなうなら いつかまた先生のご迷惑にならないときに、再び彼の題材をお願いできたらと望んでおりました…\nただ、お忙しい先生を厚かましくも立て続けに煩わせてはいけないと思い、先生のお手空きのときをずっと待たせていただく存念でいたのですが、このほど手数料キャンペーンを聞き及びまして、あるいは一度お伺いしたほうがと迷い、この通り リクエストを申請させていただくに至った次第です。お気に障りましたら申し訳ございません。\n先生のご都合にお差支えがありましたら お気遣いなくお聞き捨ていただければと存じます。然るに もしお気が向かれましたら、リクエストについてご検討いただけたら幸甚この上ない思いです。\n\n前回、先生の素晴らしい表現によって見事にクリーチャー化していただいた美少年ですが、このたびは もしよければ、クリーチャーになった彼があの姿で活動的に動き回っているシーンをお願いしてみたいのです…！\n縦画面の構図にて、人間だった頃のままと同じに両脚で歩き回っている姿も、人間らしさを残す怪物ぶりが捨てがたいですけど、逆に人間の名残も窺えなくなったような、怪物的に生えた触手と本来の残っている人間の足とで四つん這いになって徘徊しているイメージもありかと…。さらにはもっと奇抜に、地球上の従来の動物からは想像できなかったような、たとえばブリッジの体勢のように元美少年が仰向けに寝転がった体位からそのまま背を浮かせて、つまり前半身を上に、後半身を下にしたポーズのまま触手と足の四肢でもって動き回る動態などなど、不気味すぎる設定でも。そこは先生のアイデアにお任せしたいですが、ともあれ、もう人間ではなくなってしまった元美少年の彼が、いまや生物的に活動しているさまを、是非お願いできないかと…！\nと同時に一点だけ要件として、元美少年がクリーチャー化させられた時点で穿いていた彼愛用のＧパンとスニーカーは、その後も変わらず下半身に着用したままとしていただきたいです…。拘りをお願いして恐縮ですけど、下半身は生前の人間らしさ、美少年だったカッコよさとセクシーさの残滓を漂わせておいていただきたいのです。\n一方で上半身のクリーチャー部分につきましては、臓器や脂肪層、肉腫や骨など露出ぶりは、前回のままでもそうでなくても、先生のお考えにお頼りしたいです。この怪物が徘徊しているのは、もはや人類の敵となって栄養源を捕食するためなのか、それとも本能で逃げ回っているだけなのか、それでも生物としての尊厳が仄めく哀愁が、このたびのリクエストの趣旨といえます…\n\n図々しく厄介なリクエストでまことに恐れ入りますが、It先生にお願いできたら本当に本望です。もしよろしければご検討いただけたら何より嬉しく存じます…。\n\nお目を通していただき、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@moja_sungura/works/49", "thumbnail_src": "https://si.imgix.net/299f6b9f/uploads/origins/3a0ee395-8ce7-4b31-b39b-4629065cd3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47da9c2d0dde8cad988c1dab7fd49167", "thumbnail_srcset": "https://si.imgix.net/299f6b9f/uploads/origins/3a0ee395-8ce7-4b31-b39b-4629065cd3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47da9c2d0dde8cad988c1dab7fd49167, https://si.imgix.net/299f6b9f/uploads/origins/3a0ee395-8ce7-4b31-b39b-4629065cd3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a66f259ff2a8b15d1a757abcabeec087 2x, https://si.imgix.net/299f6b9f/uploads/origins/3a0ee395-8ce7-4b31-b39b-4629065cd3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2dccd0fc4e909ab30fa162d4f09a55d9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@moja_sungura/works/48", "thumbnail_src": "https://si.imgix.net/0219a09c/uploads/origins/ae6d6903-005d-4c42-b792-b8fc6487f96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cebcad8e8aaef18d4ed00e1ebdd1ad07", "thumbnail_srcset": "https://si.imgix.net/0219a09c/uploads/origins/ae6d6903-005d-4c42-b792-b8fc6487f96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=