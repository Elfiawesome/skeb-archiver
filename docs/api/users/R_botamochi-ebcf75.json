f1-068301a4b891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82eaa5f42fce8d8f634c4031ab98339e 2x, https://si.imgix.net/0e6b6432/uploads/origins/3993af11-f056-42cd-bcf1-068301a4b891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=923fad100f1c5f93a0df0ac0faeaf914 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは。\nクリスマス衣装の藤田佳那をお願いします。\nどんなポーズや表情でもOK!\nご検討のほど、よろしくお願いします:)\n\nhttps://images2.imgbox.com/e0/73/8UuU7XA3_o.png", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/62", "thumbnail_src": "https://si.imgix.net/cb537f10/uploads/origins/02ef701e-3d76-4088-91d3-a229a1476e3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d005a3b7207b45521cb9939e87d1d2e9", "thumbnail_srcset": "https://si.imgix.net/cb537f10/uploads/origins/02ef701e-3d76-4088-91d3-a229a1476e3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d005a3b7207b45521cb9939e87d1d2e9, https://si.imgix.net/cb537f10/uploads/origins/02ef701e-3d76-4088-91d3-a229a1476e3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a987a7f82a4301b8656cb0f3df595286 2x, https://si.imgix.net/cb537f10/uploads/origins/02ef701e-3d76-4088-91d3-a229a1476e3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e54357f43b82f333095ef300fc7d31f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつも素敵なイラストありがとうございます！\n\nガレヲン(六竜)並のサイズにダイマックスしたレジギガスをバックに微笑むガレヲン(人型)のイラストをリクエストしたいです。\n\nレジギガスは全身は見えなくとも異質なサイズ感がわかる描写(周りに雲や小さな島が浮かんでいるとか)があるとありがたいです。\n\n構図やポーズ諸々はお任せしますが、デスクトップの壁紙に使用したいので、横長で作成して頂けると大変助かります。\n\nよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/61", "thumbnail_src": "https://si.imgix.net/50d5c887/uploads/origins/29ca778c-ec07-42e0-9b7a-e73a4ff2225f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e96e8d46ec7f657fcb7be58c1302e45", "thumbnail_srcset": "https://si.imgix.net/50d5c887/uploads/origins/29ca778c-ec07-42e0-9b7a-e73a4ff2225f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e96e8d46ec7f657fcb7be58c1302e45, https://si.imgix.net/50d5c887/uploads/origins/29ca778c-ec07-42e0-9b7a-e73a4ff2225f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa97f71ab27b58390d5637b0d91f2629 2x, https://si.imgix.net/50d5c887/uploads/origins/29ca778c-ec07-42e0-9b7a-e73a4ff2225f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57d6ade37a389ca544f5149d3da7b975 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！！！！！！！！！！！！！！！！！！（笑私のvtuberであるあーりんげ！さんの写真をリクエストしたいと思っていました。\n (https://imgur.com/a/L9ifEqT)\n\nミスドリーヴスと一緒にかわいいおばけのポーズをとってほしいです!\n\n(https://imgur.com/a/HDk3fOS)", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/60", "thumbnail_src": "https://si.imgix.net/6b49efe3/uploads/origins/53a5a714-aacc-465b-8241-8ace282ad132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=784636215149893b27b8518d4fe641a2", "thumbnail_srcset": "https://si.imgix.net/6b49efe3/uploads/origins/53a5a714-aacc-465b-8241-8ace282ad132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=784636215149893b27b8518d4fe641a2, https://si.imgix.net/6b49efe3/uploads/origins/53a5a714-aacc-465b-8241-8ace282ad132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ca42f967f89a6849e8b5abee895fad5 2x, https://si.imgix.net/6b49efe3/uploads/origins/53a5a714-aacc-465b-8241-8ace282ad132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2b9007575c88701d5e3ce5f4ddbcb93 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nペルソナ4の里中千枝をお願いしたいと思います。ブログやツイッターなどのSNSのアイコンとして使用する予定です。笑顔でお肉を食べています。その他はお好みで。\n眼鏡をかけた別バージョンもあるといいですね。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/59", "thumbnail_src": "https://si.imgix.net/dbfa3539/uploads/origins/bc401d56-1f45-4c3a-9b28-7b5079123268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f565991c88f2fb0cbab4410340c99ab", "thumbnail_srcset": "https://si.imgix.net/dbfa3539/uploads/origins/bc401d56-1f45-4c3a-9b28-7b5079123268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f565991c88f2fb0cbab4410340c99ab, https://si.imgix.net/dbfa3539/uploads/origins/bc401d56-1f45-4c3a-9b28-7b5079123268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1093395f7f670d9bcd4f9c64171e0201 2x, https://si.imgix.net/dbfa3539/uploads/origins/bc401d56-1f45-4c3a-9b28-7b5079123268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb64d8a52b37945a603742d58cae794b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、グランブルーファンタジーのカリオストロを、このカラーパレット（https://grandcypher.com/wp-content/uploads/2020/10/cag-color-9.png）を使って、ヘッドホンをして音楽を聴きながらリラックスして描けますか？", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/58", "thumbnail_src": "https://si.imgix.net/b7e0a3b2/uploads/origins/9eb6cfa2-15d8-40c5-b477-cabee62bc278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08bb4c915e66ec3c47503bb841dd77d", "thumbnail_srcset": "https://si.imgix.net/b7e0a3b2/uploads/origins/9eb6cfa2-15d8-40c5-b477-cabee62bc278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08bb4c915e66ec3c47503bb841dd77d, https://si.imgix.net/b7e0a3b2/uploads/origins/9eb6cfa2-15d8-40c5-b477-cabee62bc278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6c135909276c9767d85d484ebc1836c 2x, https://si.imgix.net/b7e0a3b2/uploads/origins/9eb6cfa2-15d8-40c5-b477-cabee62bc278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=127890a722de344612d59d54f8cc6ce5 3x", "genre": "art", "nsfw": false, "body": "いつもグラブルやマキラを筆頭に素敵なイラスト見させて頂いてます。\n今回はうちの子であるひじき子のイラストをお願いしたいです。\n抱き枕のようにマキラに抱き着いて昼寝をしているシチュでお願いします。\nマキラの衣装は通常のSSR衣装で、ひじき子の衣装はお任せします。\n\n元々飼い猫がベースの子なんですが、元になった猫の写真は自分のツイ垢のメディア欄に概ねあります。\n\nhttps://min.togetter.com/KnUvwjq", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/57", "thumbnail_src": "https://si.imgix.net/e2eb114b/uploads/origins/9b02b37e-3dc1-49cc-a260-5f70a9b65671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73e8d1f8b91a1dc9756adb39996299a3", "thumbnail_srcset": "https://si.imgix.net/e2eb114b/uploads/origins/9b02b37e-3dc1-49cc-a260-5f70a9b65671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73e8d1f8b91a1dc9756adb39996299a3, https://si.imgix.net/e2eb114b/uploads/origins/9b02b37e-3dc1-49cc-a260-5f70a9b65671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1d65c9a2e7a2c6c029cdab566081008 2x, https://si.imgix.net/e2eb114b/uploads/origins/9b02b37e-3dc1-49cc-a260-5f70a9b65671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f3c87179ceb173a94155e10f3a71bfc 3x", "genre": "art", "nsfw": false, "body": "こんにちわ！魂カーニバル先生のイラストいつも楽しみに拝見させていただいています。\n今回描いていただきたいイラストはVtuber「星月ルンナ」さんです。\nグラブルやプリコネなどのゲームやASMRを中心に配信をされている方です。\n\n横長のイラストでYoutubeのサムネイルに使用できるようなものをお願いしたいと思っています。\n構図はお任せしたいと思っていますが、明るめな雰囲気で描いていただけると嬉しいです。\n服装は冬衣装でお願いします。↓こちらのツイートの右下、もしくは最新動画のEDです。\nhttps://twitter.com/hoshizukilunna/status/1346157740805132289?s=20\nまた、Youtubeのサムネイルに使用いただく可能性がありますことをご許可いただけると幸いです。\nご検討を宜しくお願い致します。\n\n【参考】\nhttps://www.youtube.com/channel/UCiyxAWJcn0PWt696Kt8M2Ew/videos　（youtube）\n\nhttps://hoshizukilunna.wixsite.com/hoshizukilunna", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/56", "thumbnail_src": "https://si.imgix.net/58155c21/uploads/origins/214f724a-85f3-4934-850e-c3428d80480a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4c163d8f6e4a5815068723b0a68a860", "thumbnail_srcset": "https://si.imgix.net/58155c21/uploads/origins/214f724a-85f3-4934-850e-c3428d80480a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4c163d8f6e4a5815068723b0a68a860, https://si.imgix.net/58155c21/uploads/origins/214f724a-85f3-4934-850e-c3428d80480a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eedec3fdefe8dc405667e1a6032dbe8 2x, https://si.imgix.net/58155c21/uploads/origins/214f724a-85f3-4934-850e-c3428d80480a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59eb7326daed1906cd1d51d14d559eca 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは。\n前回のイラスト、ありがとうございました\nVtuberのリンコロとグランブルーファンタジーのエリルを一緒に描いていただけませんか？\n(キャラクター参考:https://imgbox.com/g/yVYvXQH7PB)\n(エリル参考資料：https://gbf.wiki/Elil#/media/File:Summon_b_2040344000.png)\nリンコロは、指が4本しかないハーピーです。\nできれば、腕を覆う羽を描いてください。\nその他はお任せします。\nご検討のほど、よろしくお願いいたします。:)", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/55", "thumbnail_src": "https://si.imgix.net/6813cc5c/uploads/origins/01c72d22-93f4-45cf-881a-42586dc0db2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3c5082d234ae2503b2706456095a82e", "thumbnail_srcset": "https://si.imgix.net/6813cc5c/uploads/origins/01c72d22-93f4-45cf-881a-42586dc0db2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3c5082d234ae2503b2706456095a82e, https://si.imgix.net/6813cc5c/uploads/origins/01c72d22-93f4-45cf-881a-42586dc0db2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaafeeb9ed191d38bb6f528c7a881920 2x, https://si.imgix.net/6813cc5c/uploads/origins/01c72d22-93f4-45cf-881a-42586dc0db2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc1594031eddba3fa2657bbbf41382de 3x", "genre": "art", "nsfw": false, "body": "初めまして。魂カーニバルさんの事はツイッターのイラストで知りました、絵柄がとても好みなので依頼したいです。\n\nグール×グーラ（http://colorjelly.jp/product_02.html）のマリーカ\nグール×グーラ・コンパーニャ（http://colorjelly.jp/product_05.html）のマリーカ\nが対になる感じの１枚絵をお願いしたいです。\n（設定的には同一人物です。ポーズや表情はお任せします。）\n（対になる、というのは例えば有名な２人組のキャラが並んでいるorポーズを決めているような図を思い浮かべて頂ければよいです。）\n\n宛名はありとなしの両パターンあると嬉しいです。\n片方のみならば宛名ありでお願いします。\n\nグール×グーラのマリーカの衣装資料\n（グーラ化前、肌色に黄緑色の目、口の閉じた大きな骸骨の髪飾り。）\nhttps://twitter.com/ColorJelly_/status/957973361396662274?s=20\nhttp://colorjelly.jp/note_2013_03.html\nhttps://colorjelly.booth.pm/items/835900\n\nグール×グーラ・コンパーニャのマリーカの衣装資料\n（グーラ化後、灰色の肌、赤色の目、口を開けた大きな骸骨の髪飾り。）\nhttps://twitter.com/ColorJelly_/status/743738567478784000?s=20\nhttp://colorjelly.jp/note_2016_04.html\nhttps://twitter.com/ColorJelly_/status/908697891849375744?s=20", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/54", "thumbnail_src": "https://si.imgix.net/5110955c/uploads/origins/f37df8fe-03e0-4f9a-a65a-a157450d176b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=289a6f0fc9565ad52198e66d898e0285", "thumbnail_srcset": "https://si.imgix.net/5110955c/uploads/origins/f37df8fe-03e0-4f9a-a65a-a157450d176b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=289a6f0fc9565ad52198e66d898e0285, https://si.imgix.net/5110955c/uploads/origins/f37df8fe-03e0-4f9a-a65a-a157450d176b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0906b23ffd4b6047eefd4ef0c7effaea 2x, https://si.imgix.net/5110955c/uploads/origins/f37df8fe-03e0-4f9a-a65a-a157450d176b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4d68808f293731826953d928763b41d 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストありがとうございます。\n今回は『ワールドフリッパー』のバレッタを描いていただきたいです。\nポーズは手銃で「バーン！」としているポーズでお願いします。\nそれ以外の点はお任せします。\n\nバレッタ\n公式サイト　https://worldflipper.jp/character/detail.php?char=a835fb212577f792bc304069c0b1c420\n\n表情　https://imgur.com/JhqxEpN", "created_at": "", "completed_at": ""}, {"path": "/@R_botamochi/works/53", "thumbnail_src": "https://si.imgix.net/36493a42/uploads/origins/60ef846b-4a24-4d53-ac97-9cea6d02b345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cedb9431f51acd1e6bfdab2e3809e5bf", "thumbnail_srcset": "https://si.imgix.net/36493a42/uploads/origins/60ef846b-4a24-4d53-ac97-9cea6d02b345?bg=%23fff&auto=format%2Ccompres