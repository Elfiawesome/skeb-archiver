pr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aee1e7c29667b21c385d5870b998fcdc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/1001", "thumbnail_src": "https://si.imgix.net/7fcc01e5/uploads/origins/78408cef-82ec-4b18-8c48-d076dfaf084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2f203ee588c154203ff5a521ab1438", "thumbnail_srcset": "https://si.imgix.net/7fcc01e5/uploads/origins/78408cef-82ec-4b18-8c48-d076dfaf084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2f203ee588c154203ff5a521ab1438, https://si.imgix.net/7fcc01e5/uploads/origins/78408cef-82ec-4b18-8c48-d076dfaf084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93c839ed9ceab7f11d8e8ba22de8eadd 2x, https://si.imgix.net/7fcc01e5/uploads/origins/78408cef-82ec-4b18-8c48-d076dfaf084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8c5dd330a0fd9411c44245e07ba2e6b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵はとてもかわいいです！私のキャラクターを描いていただけませんか？パーティーの設定でお願いします。青いお姉さんが大きなバースデーケーキの前に立っていて、ピンクのお姉さんがケーキから飛び出してお姉さんを驚かせています。二人ともパーティ用の帽子をかぶっています。ピンクのお姉さんはフロスティングにまみれて、ブルーのお姉さんはフロスティングをかけられています。デフォルトの服装でも、設定に合いそうなかわいい服装でも、どちらでも描くことができます。\n以下は彼女たちの参考例です：\nムーンゼリー\n- 前髪にピンクの筋\n- 身長142cm\n- 平らな胸\n- 小さな牙\n- 両掌に一つずつ目\n- 頭に球根のついた触角が2本\n\nhttps://imgur.com/a/uQe1AoO\n\nプリンセス・ゼリー\n- 身長152cm\n- 大きな胸\n- 太ももとぽっこりお腹\n- 小さな牙\n- 頭に球根のついた2本の触角\n- 甘やかされたお姫様\n- セクシーだけどキュート\n\nhttps://drive.google.com/drive/folders/1blJxOyrVV0hGqqhytbZLBXwMnUPJEAHb\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/1000", "thumbnail_src": "https://si.imgix.net/80b121ef/uploads/origins/34398c0a-7ab7-427b-bc97-313c8397a261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7064685e4e460443c41f0ad8767d05b2", "thumbnail_srcset": "https://si.imgix.net/80b121ef/uploads/origins/34398c0a-7ab7-427b-bc97-313c8397a261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7064685e4e460443c41f0ad8767d05b2, https://si.imgix.net/80b121ef/uploads/origins/34398c0a-7ab7-427b-bc97-313c8397a261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12c5e2cd56c5c7ab69801308778fa5ae 2x, https://si.imgix.net/80b121ef/uploads/origins/34398c0a-7ab7-427b-bc97-313c8397a261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53c6d87bf6fb03ef9ec67311fba7cc4d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私と友人のVTuberモデルのイラストを再びお願いいたします。カズは九尾の守護狐霊ですが、羽織を着ている時は一尾しか見えません。キミコはゴス系猫吸血鬼です。\n\nGoogleドライブのリンク内に、モデルとポーズの参考資料があります。イラストでは、ポーズ参考資料のようにキミコをカズの膝の上に座らせてください。カズは、キミコの顔をからかうように好奇心たっぷりの得意げな笑みを浮かべて見つめる様子で。キミコは、目を閉じていない状態でカズを見つめ、顔を赤らめている様子でお願いします。 \n\n背景は、可能であれば都会の景色が見渡せる豪華なペントハウスにしてください。バラの花びらも必ず含めてください。この作品はSNSと配信で公開します。Google Driveリンク: https://drive.google.com/drive/folders/1RNwgXM7iv7PNQ-Pfk0ztWcJq0KWCOczw?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/999", "thumbnail_src": "https://si.imgix.net/f0cc702d/uploads/origins/6881eb44-1011-4ea2-8902-2ee13ab23dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1515dd09eb30d6602c4ba39608f7fe89", "thumbnail_srcset": "https://si.imgix.net/f0cc702d/uploads/origins/6881eb44-1011-4ea2-8902-2ee13ab23dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1515dd09eb30d6602c4ba39608f7fe89, https://si.imgix.net/f0cc702d/uploads/origins/6881eb44-1011-4ea2-8902-2ee13ab23dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b906d8ad87d14be570e29e36ee2c2850 2x, https://si.imgix.net/f0cc702d/uploads/origins/6881eb44-1011-4ea2-8902-2ee13ab23dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbe1be19bbae661debbc21eb8e65d81e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/998", "thumbnail_src": "https://si.imgix.net/7f41ede1/uploads/origins/8e3915bb-aa28-46fb-8429-ccc52645101b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c379c8866cad379a56fd83b8d1b4241", "thumbnail_srcset": "https://si.imgix.net/7f41ede1/uploads/origins/8e3915bb-aa28-46fb-8429-ccc52645101b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c379c8866cad379a56fd83b8d1b4241, https://si.imgix.net/7f41ede1/uploads/origins/8e3915bb-aa28-46fb-8429-ccc52645101b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88cf27833d8450682dfef00ec4ff1ead 2x, https://si.imgix.net/7f41ede1/uploads/origins/8e3915bb-aa28-46fb-8429-ccc52645101b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41e104a35677a8ed07007e542898ec93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/997", "thumbnail_src": "https://si.imgix.net/8e61b46a/uploads/origins/2123309a-9620-4cb0-b69f-cd22e73cce85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ff8dc0568dab6e995bb7bad2fb5a15a", "thumbnail_srcset": "https://si.imgix.net/8e61b46a/uploads/origins/2123309a-9620-4cb0-b69f-cd22e73cce85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ff8dc0568dab6e995bb7bad2fb5a15a, https://si.imgix.net/8e61b46a/uploads/origins/2123309a-9620-4cb0-b69f-cd22e73cce85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5f07ade1790dea86cf85c29603d9a50 2x, https://si.imgix.net/8e61b46a/uploads/origins/2123309a-9620-4cb0-b69f-cd22e73cce85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22ed4c8afea06cb03bdd6fd81bf850a7 3x", "genre": "art", "nsfw": false, "body": "こんにちは :)また特別なアートの依頼があるんだ。\n\nシーン：3人がパルクールの腕前を競うトレーニングに挑戦している。1人は木々の間をスウィングしたり、枝から枝へ飛び移ったり、もう1人は障害物から障害物へ飛び移ったり、3人目は翼を使って滑空したりしている。この挑戦は、彼らにとって楽しいものであり、切磋琢磨するライバルのようなものだ。\n\nキャラクター・ジェヴィエル\n虚空の魔法を使うシャドウエルフで、宝石で飾られた角、緑色の目、紫色の髪が特徴。ルーンのタトゥーが光っている。スイングとジャンプが得意。\n参照：https://vsona.co/jeev-iel\n\nミナ\n鬼龍です。白い髪に赤い筋と角が生えている。龍の尻尾を持ち、少しトリッキーな靴を履いているが、石から石へのジャンプが得意。\n参考：https://drive.google.com/file/d/1Q8Yj3qSAvYUFAe2byLvXs7SjhhfCnWus/view?usp=drivesdk\n\nルウン\n悪魔ハンターで、背中に黒い翼を生やして滑空することができる。赤紫の髪で目隠しをし、角が生えている。彼女の体にあるタトゥーはパワーサイクルを表しており、フェルマジックの結果である。\n参照：https://vsona.co/ruun\n\n使用方法このアートワークは壁紙として使われるでしょう。\n\nhttps://vsona.co/jeev-iel", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/996", "thumbnail_src": "https://si.imgix.net/0b0eb60c/uploads/origins/95875ce5-3194-401c-81ce-a9e8feb87a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85b28e73eb381edaeff644537c223438", "thumbnail_srcset": "https://si.imgix.net/0b0eb60c/uploads/origins/95875ce5-3194-401c-81ce-a9e8feb87a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85b28e73eb381edaeff644537c223438, https://si.imgix.net/0b0eb60c/uploads/origins/95875ce5-3194-401c-81ce-a9e8feb87a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37e7338094df527aec3615878bad66fd 2x, https://si.imgix.net/0b0eb60c/uploads/origins/95875ce5-3194-401c-81ce-a9e8feb87a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b23215637246dedae93ced9cc1a997fe 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！今回も私のOCである風野杏里を乙女チックに描いて頂きたいと思います！ - https://drive.google.com/file/d/183EcEHAMqfRvHHYBOiKC-dOC7Fo1QgUy/view?usp=drive_link\n\nポーズ：ポーズ：車のトランクに縛られた状態、こんな感じ - https://www.pixiv.net/en/artworks/124493947\n胸の上と下にロープ、足を縛り、足首を縛る。猿轡をさせてください。猿ぐつわはお好みで（テープ、薙ぎ払い、ボール）。\n\nリクエストを聞いてくれてありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/995", "thumbnail_src": "https://si.imgix.net/eb7cffb3/uploads/origins/2e17a646-d027-43b3-be0a-690db3c11500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d030e351965c9c23e3abd22e0a12e0d", "thumbnail_srcset": "https://si.imgix.net/eb7cffb3/uploads/origins/2e17a646-d027-43b3-be0a-690db3c11500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d030e351965c9c23e3abd22e0a12e0d, https://si.imgix.net/eb7cffb3/uploads/origins/2e17a646-d027-43b3-be0a-690db3c11500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0daf5bec499d38b0345fddc693a84981 2x, https://si.imgix.net/eb7cffb3/uploads/origins/2e17a646-d027-43b3-be0a-690db3c11500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f456d7b306c765994aa2124c94b13ae 3x", "genre": "art", "nsfw": false, "body": "364ingさん、こんにちは！あなたの絵はとてもきれいだし、あなたは私の絶対的なお気に入りだから、何か依頼したいわ！🙏🏼\n\nシーン湖の上でハートのボートに一緒に座ってロマンチックに時間を楽しんでいる2人のキャラクター。\n\nキャラクター・ジェヴィエル：\n角が生え、紫色の髪、ターコイズブルーの瞳を持つシャドウエルフ。ここではよりロマンチックで優しい雰囲気を持っている。タトゥーや角など、彼女の重要な特徴が見える限り、髪型は自由に選べる。\n参照：https://vsona.co/jeev-iel\n\nキャラクター・ノック：\n茶色の長髪にひげを生やし、腕から胸にかけてSHAというタトゥーを入れている。ファイタータイプで、少々乱暴な喧嘩屋。\n参照：https://vsona.co/noctucx\n\n僕の小さなムーンキンのシャズーも写真に加わってくれると嬉しいな。彼は長いペタペタした耳、角、首のフチ、そして毛皮を持っている。他の特徴は、くちばしとちょっとぽっちゃりしてるところかな。\n参考：https://vsona.co/shazoo\n\nボート ref: https://drive.google.com/file/d/1W25QTkhVrSUXpSGmokmBfstpKOv9cNzA/view?usp=drivesdk\n\nhttps://vsona.co/jeev-iel", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/994", "thumbnail_src": "https://si.imgix.net/c03e418a/uploads/origins/1974262e-1b3f-4b43-9d3c-7b4c1ca3c673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6350632e0ad40c7dab92c63abbdc4c41", "thumbnail_srcset": "https://si.imgix.net/c03e418a/uploads/origins/1974262e-1b3f-4b43-9d3c-7b4c1ca3c673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6350632e0ad40c7dab92c63abbdc4c41, https://si.imgix.net/c03e418a/uploads/origins/1974262e-1b3f-4b43-9d3c-7b4c1ca3c673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9524f7cbe06e6055b959e7c14a5d17e 2x, https://si.imgix.net/c03e418a/uploads/origins/1974262e-1b3f-4b43-9d3c-7b4c1ca3c673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5250d10a75f4c6c1e8cc8f0aefd8ef65 3x", "genre": "art", "nsfw": false, "body": "もう1つ仕事をお願いしたい。\n\n私のOCであるクラリスを友人のOCたちと一緒にリクエストしたいのです。そのような作品をリクエストする許可は得ています。\n\n設定は：朝日が差し込む自然に囲まれた森の小道をハイキングしているはずです。\n\nマイヤ大きなキノコを頭に乗せた明るく陽気なドルイドで、杖をステッキのように持ち、自然の扱いに最も慣れているため、グループをリードするだろう。\n\n鳩：先頭近くにいて、周囲に危険なものがないか警戒している。\n\nNeat：好奇心旺盛に周囲を見回し、森の小さな生き物が走り回っていないか探して指差す。\n\nネムリ：上を見上げてぼんやりと樹林帯を見回している。\n\nバイパー・アティラ：集団の最後尾に近づき、周りの誰とでもおしゃべりして楽しい会話をしようとしている。\n\nアルメインとクラリス：アルメインはクラリスを背中に抱き、2人とも遊び心と喜びに満ちた表情と口調をしている。\n\n量が足りない場合は、再送してください。\n\n参考文献はリンク先にあります。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1ZHPa00IkMarbwDI0SHk4UDdI1C3OMh0Z?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/993", "thumbnail_src": "https://si.imgix.net/589b662d/uploads/origins/6a43c4b4-e5bf-407f-9012-3c514cc870cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6985271f5bc2eac7cda346346e46663", "thumbnail_srcset": "https://si.imgix.net/589b662d/uploads/origins/6a43c4b4-e5bf-407f-9012-3c514cc870cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6985271f5bc2eac7cda346346e46663, https://si.imgix.net/589b662d/uploads/origins/6a43c4b4-e5bf-407f-9012-3c514cc870cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41641bc87162283070e05765c50c903a 2x, https://si.imgix.net/589b662d/uploads/origins/6a43c4b4-e5bf-407f-9012-3c514cc870cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d49913674b9df6e0e170e966fd4a5bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/992", "thumbnail_src": "https://si.imgix.net/ac2e5c03/uploads/origins/a91100de-0277-4e45-8406-aa2aaaaac3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3504a8abca9ba7e8a42732af10e4ff70", "thumbnail_srcset": "https://si.imgix.net/ac2e5c03/uploads/origins/a91100de-0277-4e45-8406-aa2aaaaac3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3504a8abca9ba7e8a42732af10e4ff70, https://si.imgix.net/ac2e5c03/uploads/origins/a91100de-0277-4e45-8406-aa2aaaaac3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13f536a658e9dd49687f06100fd2ba50 2x, https://si.imgix.net/ac2e5c03/uploads/origins/a91100de-0277-4e45-8406-aa2aaaaac3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19dfe6ef7706c2a0ea1f0ed93310eb0f 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n私のOC「ルシア・オルティス」のイラストを描いてもらえませんか。\n\nルシアについて\n・仕事：何でも屋（近辺調査から荒事への対応まで行う万事屋）。過去に従軍経験あり\n・性別：女性\n・性格：クールで表情変化は少ない\n・身体年齢：25歳\n・身長：160cm後半\n・髪型：ポニーテール\n・髪色：赤色（眉毛、まつ毛も同色）\n・瞳の色：青色\n・肌色：色白で健康的\n・軍人時代に受けた人体実験の影響で人並外れた膂力と再生能力を手に入れている\n・基本的に武器は使わず、徒手空拳\n\nシチュエーションについて\nとある犯罪組織の殲滅依頼を受けたルシアが敵アジトを強襲するシーンをお願いします。\n（強襲シーンのイメージを参考資料に入れています。確認してください。）\n\n参考資料\nhttps://drive.google.com/drive/folders/14PnNDVa-oXVzkA2ZE-srVWDrkFURPKCS?usp=sharing\n\nリクエスト内容は以上です。ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/991", "thumbnail_src": "https://si.imgix.net/74226cb5/uploads/origins/12f9acce-3025-4198-91a5-85c98326851c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eb29baca4a9887b3f8791fd015ee5ff", "thumbnail_srcset": "https://si.imgix.net/74226cb5/uploads/origins/12f9acce-3025-4198-91a5-85c98326851c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eb29baca4a9887b3f8791fd015ee5ff, https://si.imgix.net/74226cb5/uploads/origins/12f9acce-3025-4198-91a5-85c98326851c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=556df8b6256d60b4f56aed4697dae09d 2x, https://si.imgix.net/74226cb5/uploads/origins/12f9acce-3025-4198-91a5-85c98326851c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=391c07933ba6c9ec6ed0350cab9411cd 3x", "genre": "art", "nsfw": false, "body": "I came across your profile and fell in love with your artwork! I was wondering if you could do an illustration for a Vtuber friend of mine.\n\nHer reference sheet: https://drive.google.com/file/d/1XeWlWAUNvZX97TxxZ48CG1jGD3I_wRHf/view?usp=sharing\n\nI'll leave the rest to you!", "created_at": "", "completed_at": ""}, {"path": "/@364ing01/works/990", "thumbnail_src": "https://si.imgix.net/3fa2c3fc/uploads/origins/49ee3d33-fcea-4e0c-a7d4-714b651f6162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=622ffd2a52a53f0ecb3c47004586c26c", "thumbnail_srcset": "https://si.imgix.net/3fa2c3fc/uploads/origins/49ee3d33-fcea-4e0c-a7d4-714b651f6162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccen