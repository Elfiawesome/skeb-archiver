{"screen_name": "HetareNeko", "file": "HetareNeko", "name": "へたれねこ/HetareNeko🐈Skeb大募集中！", "avatar_url": "https://pbs.twimg.com/profile_images/1908124831100620800/zWe5A6B6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1810157836149923840/1743853117/1500x500", "description": "へたれイラストレーター/illustrator JP/EN OK! お題箱：https://odaibako.net/u/HetareNeko 【依頼はこちらから！/ Commision】 ◆Skeb：https://skeb.jp/@HetareNeko ◆DM or hetarenekowork@gmail.com", "total_works": 50, "scraped_works": 30, "first_seen": "2025-10-06T03:56:19.682647+00:00", "last_updated": "2026-02-18T21:38:04.596622+00:00", "price_history": {"art": [{"amount": 5000, "recorded_at": "2025-10-06T11:56:19.682647"}], "correction": [{"amount": 1000, "recorded_at": "2025-10-06T11:56:19.682647"}]}, "current_prices": {"art": 5000, "correction": 1000}, "price_range": {"art": {"min": 5000, "max": 5000}, "correction": {"min": 1000, "max": 1000}}, "links": [{"label": "Twitter", "url": "https://x.com/_HetareNeko", "name": "_HetareNeko"}, {"label": "Misskey_io", "url": "https://misskey.io/@HetareNeko_HN", "name": "HetareNeko_HN"}, {"label": "Website", "url": "https://odaibako.net/u/HetareNeko", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/76638485", "name": "76638485"}], "flags": {"from_archive": true}, "works": [{"path": "/@HetareNeko/works/50", "thumbnail_src": "https://si.imgix.net/5b0e8f3f/uploads/origins/aecf6496-ed21-4076-9979-61e66b8542d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=563467791eb8a63a95e14a74667faf68", "thumbnail_srcset": "https://si.imgix.net/5b0e8f3f/uploads/origins/aecf6496-ed21-4076-9979-61e66b8542d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=563467791eb8a63a95e14a74667faf68, https://si.imgix.net/5b0e8f3f/uploads/origins/aecf6496-ed21-4076-9979-61e66b8542d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86b1f9a51f051a75884fd305afd59282 2x, https://si.imgix.net/5b0e8f3f/uploads/origi