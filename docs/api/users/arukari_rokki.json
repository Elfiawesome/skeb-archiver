cb2a0f2897a9928 2x, https://si.imgix.net/48a43109/uploads/origins/b855909e-297b-43ed-889c-46de59f4f26c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9950f1f19c5db9a4e0535795061d3b8b 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/40", "thumbnail_src": "https://si.imgix.net/60945fe1/uploads/origins/e0d8f8f6-c803-457c-ad6b-fa84e2607a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7339dd7c065bc7521ba20b687750cda", "thumbnail_srcset": "https://si.imgix.net/60945fe1/uploads/origins/e0d8f8f6-c803-457c-ad6b-fa84e2607a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7339dd7c065bc7521ba20b687750cda, https://si.imgix.net/60945fe1/uploads/origins/e0d8f8f6-c803-457c-ad6b-fa84e2607a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73e5490d0e99578d12f1593578bb5474 2x, https://si.imgix.net/60945fe1/uploads/origins/e0d8f8f6-c803-457c-ad6b-fa84e2607a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b3117924ffe6f27d1473f56233a2e29 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/39", "thumbnail_src": "https://si.imgix.net/77dcf881/uploads/origins/c68bb396-56ec-471e-afa9-29d7e05c14d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e6f45d88b02f372a7ea64cc785f6cf8", "thumbnail_srcset": "https://si.imgix.net/77dcf881/uploads/origins/c68bb396-56ec-471e-afa9-29d7e05c14d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e6f45d88b02f372a7ea64cc785f6cf8, https://si.imgix.net/77dcf881/uploads/origins/c68bb396-56ec-471e-afa9-29d7e05c14d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a4a85896d745299fee10e2f8a94979d 2x, https://si.imgix.net/77dcf881/uploads/origins/c68bb396-56ec-471e-afa9-29d7e05c14d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a078479a0c9f97e55dc89160ebd3f05 3x", "genre": "comic", "nsfw": true, "body": "こんばんは、豆餅アルカ@skeb募集中さん。リクエストさせていただきます。  \n『対魔忍アサギ』より『井河アサギ』の肥満化コミックお願いします。\n  内容は以下の通りです。\n①アサギ(対魔忍スーツ:スリム)は敵のアジトに突撃していくが、敵の罠にかかり捕まってしまう。\n ②アサギ(対魔忍スーツ:スリム)は目を覚ますとそこには机と椅子だけの無機質な部屋で『体重300kgまで太らないと出られない部屋』であった。\n ③アサギは仕方なく机から出てきた料理を食べ続けていき、数時間後、ぽっちゃり体型になった頃二人はお腹をつまみ自分が太った事を自覚した。 (スリムからぽっちゃり)\n④アサギが体重300kgに太った時、ドアの鍵が開いて出ようとするが、太り過ぎてドアから出るのが手こずり、太った体を揺らしながら歩くのもキツくなってアサギ仲間達に井河さくらと八津紫に見られて恥ずかしくなった。(ぽっちゃりからデブ)\n ⑤その後、学園で井河アサギは私服で生徒たちに肥満体を揺らしながら授業していたがボタンが弾け飛び恥ずかしくなっていて生徒たちにお菓子をもらい食べながら授業するアサギであるが、その姿を見て呆れていた井河さくらと八津紫は呆れていた。  \n対魔忍アサギは初めてだと思いますがどうでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/38", "thumbnail_src": "https://si.imgix.net/b1c8c829/uploads/origins/e3f3518a-f0bc-4da2-b483-a025fa6663df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=591fa2152ad7395d0c4ccec42050f5e3", "thumbnail_srcset": "https://si.imgix.net/b1c8c829/uploads/origins/e3f3518a-f0bc-4da2-b483-a025fa6663df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=591fa2152ad7395d0c4ccec42050f5e3, https://si.imgix.net/b1c8c829/uploads/origins/e3f3518a-f0bc-4da2-b483-a025fa6663df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c9a422639bc88e2aa99479a783e61bb 2x, https://si.imgix.net/b1c8c829/uploads/origins/e3f3518a-f0bc-4da2-b483-a025fa6663df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66a613825ac0530b3b0441ba6938589a 3x", "genre": "comic", "nsfw": true, "body": "いつも素敵な作品、ありがとうございます。\n原神から綺良々と千織の肥満化をお願いします。\n前に描かれていた綺良々がかわいかったので、その続きみたいな感じで描いていただきたいです。\n以下話の流れを書いていますが、自由に変更して構いません。\n\n\n少しだけぽっちゃりした綺良々は、千織屋に荷物を届けに行くと、千織に「太った？」と言われ、採寸することに。\nまだ服に少しは余裕があるけど、綺良々はこれ以上太らないように釘を刺され、太った理由を聞かれる。\n千織は太った理由を知ると、時間のあるとき食べるから食べ物を置いていっていいと綺良々に伝える。\n綺良々はもらいものを置いていくことに少し抵抗があったが、食べ物を分け与えるという時点で商人の目的は達成されているし、そもそも招き猫じゃなくて猫又でしょ？と千織に言われ、食べ物を置いていくことに。\nそのかなりの量に千織は驚く。\n\nその大量の食べ物を消費するため、千織は時間のあるときの過ごし方がほぼ食べることになり、少しずつ太っていく。\n食べぐせがついたことで、綺良々の置いていった食べ物がなくなってからも食べる量は減らず、むしろ常に食べ物を口に入れるようになる。\n\n再び千織屋に荷物を届けに行く綺良々は服がぎちぎちになるまで太っていた。\n綺良々は、重い体での移動で疲れた様子で千織屋に入ると、千織が自分よりも太り、口周りに食べカスをつけながら食べ、食べた跡（空の容器や皿）がたくさんあることに驚く。\n綺良々が驚きで言葉が出ないうちに、千織は綺良々が太ったことを指摘して採寸をする。\nしかし、特に千織が太ったことでスムーズに採寸できず、なんとか採寸が終わるが千織は疲れる。\n綺良々はその様子を見て、千織にかなり太ったけど大丈夫？と聞くが、千織は私の服は調整できるからと答えそんなことより早く食べるよう催促し、二人で食べ始める。\n綺良々は、自分が今後も太ることを想像して、サイズの大きい服を新たに作ってもらうことを千織にお願いする。\n\n\n文章が長くなってしまいましたが、詳しい説明は省略してもいいので、採寸するところや千織がだんだん太っていく過程を、横や後から見た姿も含め詳しく描いていただけるとありがたいです。\nまた、千織の一番太った体型は、太るアンバー＆コレイの漫画の5, 6ページのコレイくらいの体型でお願いしたいです。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/37", "thumbnail_src": "https://si.imgix.net/7d44e2a4/uploads/origins/51383e97-e4b7-44bc-9218-9ff6db03c937?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1908be4851f3d40bc059c2872158416", "thumbnail_srcset": "https://si.imgix.net/7d44e2a4/uploads/origins/51383e97-e4b7-44bc-9218-9ff6db03c937?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1908be4851f3d40bc059c2872158416, https://si.imgix.net/7d44e2a4/uploads/origins/51383e97-e4b7-44bc-9218-9ff6db03c937?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f040ece4e61deb8dd38755f3f41ec3c8 2x, https://si.imgix.net/7d44e2a4/uploads/origins/51383e97-e4b7-44bc-9218-9ff6db03c937?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21053f3e261036ee040ba31894673c2d 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、本年もどうぞよろしくお願いします...！\n早速ですが、今回も漫画のリクエストをお願いします。\n前回の合間のお話でニィロウと蛍&パイモン側がメインのお話となります！\n\n【流れ】\n①海灯祭も終わり、久しぶりにスメールに帰ってきた蛍とパイモンは貰ったお菓子を食べている綺良々と出会い、ニィロウに荷物を届けた話を聞いてニィロウを訪ねてみることに\n\n②しばらくすると、スメールにはないパスタの匂いが漂ってきたので不思議に思いながらニィロウの家を訪ねると、食べ過ぎて満腹のニィロウが出てきた(ここから最後までお腹が膨れている感じでお願いします)\n\n③事の経緯を話すニィロウ\n・フリーナからの手紙にはパスタの作り方が書いてあり、早速作ってみるが一袋分を茹でてしまい大量にパスタが出来てしまう\n・食べても食べても減らずにお腹が膨れてしまい今に至る\n\n④ソースだけだと飽きると思い、壺に案内して特産品を用いて色々とパスタ料理を作る蛍\n\n⑤満腹でも美味しそうな蛍の手料理の数々を見て少しずつ食べていくニィロウ、蛍とパイモンも一緒に食べて段々とパスタも消費されていった\n\n⑥食べ切れた後、パスタのレシピを貰ったニィロウはシアターの仲間に手料理を振舞ってみるのも良いかもと思いながら満腹でも上機嫌で帰路に着いた\n(そして前回のラストにつながります)\n\n【①の補足】\n・蛍は前回の招き猫の噂を知っているので、別れ際に「招き猫さん」と言って欲しいです\n・綺良々はその事を不思議に思うが、まあいっかと気にせずに配達に戻る場面が欲しいです\n・綺良々のお腹は少しだけ膨らせていると嬉しいです\n\n【裏設定】\n実は前回の噂は八重神子から聞いた話を蛍が脚色し、それを商人のドリーに話した結果商人の間で広まったので、蛍が実質の元凶だったのです！(この話は本編中に無くても構いません)\n\n合間の話という事で難航しておりましたが、一応このような形の事が起こっていたという事になります！\n今回も是非よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/36", "thumbnail_src": "https://si.imgix.net/d6b3afb3/uploads/origins/c24a799c-5bcc-483c-9afa-446830a441ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0230b9eccb610a8ae5aafdcdad2d8b40", "thumbnail_srcset": "https://si.imgix.net/d6b3afb3/uploads/origins/c24a799c-5bcc-483c-9afa-446830a441ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0230b9eccb610a8ae5aafdcdad2d8b40, https://si.imgix.net/d6b3afb3/uploads/origins/c24a799c-5bcc-483c-9afa-446830a441ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2830c4a64edf4323bf9fc6b5a01212b6 2x, https://si.imgix.net/d6b3afb3/uploads/origins/c24a799c-5bcc-483c-9afa-446830a441ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac795b297d35c06009b7d9a77da2a91e 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/35", "thumbnail_src": "https://si.imgix.net/213b8d1e/uploads/origins/8e5e8a80-eeff-43e7-8dd2-3fdb1a7ddd35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f301fa5821d18343bf93ab94d5d50bdf", "thumbnail_srcset": "https://si.imgix.net/213b8d1e/uploads/origins/8e5e8a80-eeff-43e7-8dd2-3fdb1a7ddd35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f301fa5821d18343bf93ab94d5d50bdf, https://si.imgix.net/213b8d1e/uploads/origins/8e5e8a80-eeff-43e7-8dd2-3fdb1a7ddd35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7929ced34369ec9f1cff8e5e8b298c30 2x, https://si.imgix.net/213b8d1e/uploads/origins/8e5e8a80-eeff-43e7-8dd2-3fdb1a7ddd35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af51870198e0c9ee7a802cf08f8e474d 3x", "genre": "comic", "nsfw": true, "body": "いつも素晴らしい作品をありがとうございます。\n\n原神から、アンバーとコレイの肥満化をお願いします。\n以下の大まかな流れを考えましたが、全体の構成や細かい部分は自由に変更していただいて構いません。\n\nコレイはアンバーの料理の練習に付き合うことに。\n最初だけ料理上手な蛍（ぽっちゃり体型）に作り方を教えてもらった。\nアンバーは教えてもらった通り作ろうとするが、なかなか上手にできない。\n失敗作がたくさんできるが、もったいないのでコレイとアンバーでなんとか食べきる。\nこれを繰り返すうちにだんだん太っていく。\n\nようやく料理がうまくできるようになったが、その頃には二人とも胃袋が大きくなっていて、その料理だけでは量が足りないので、外食することに。\nそのお店にちょうど来ていた蛍は、見覚えあるが太めの後ろ姿だと思って近づくと、それが太ったアンバーとコレイだったことに気づき、太ったことを少しからかう。\n\nこんな生活を続けるうちに食欲が止まらずさらにでっぷりと太った二人は、家で上手くなった料理をいっぱい作って食べ、お互い幸せそうにげっぷをする。\n\n\nできれば、二人の太り方に差がある描写があるとうれしいです（例：アンバーは下半身が大きめでショートパンツがきつくなる、コレイはお腹が大きめで座るとお腹がテーブルに当たる）。\n\nまた、食べ終わったお皿が積み重なっている様子など、食事量が増えたことが伝わるシーンがあると嬉しいです。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/34", "thumbnail_src": "https://si.imgix.net/aa56a2b8/uploads/origins/9b55d8f0-39df-443d-90e5-baab11d5b870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7165ec0ae322fa3ed6ea083766d36b3", "thumbnail_srcset": "https://si.imgix.net/aa56a2b8/uploads/origins/9b55d8f0-39df-443d-90e5-baab11d5b870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7165ec0ae322fa3ed6ea083766d36b3, https://si.imgix.net/aa56a2b8/uploads/origins/9b55d8f0-39df-443d-90e5-baab11d5b870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=354773ee69ed7de2ad01f336f9be12df 2x, https://si.imgix.net/aa56a2b8/uploads/origins/9b55d8f0-39df-443d-90e5-baab11d5b870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21ed9ece8a2bd8ce687d64beb7826865 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/33", "thumbnail_src": "https://si.imgix.net/b15aba5f/uploads/origins/510da7f0-f10b-42f5-a3f2-0733952598cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb36865794fa6967511b02b8e5ee50e7", "thumbnail_srcset": "https://si.imgix.net/b15aba5f/uploads/origins/510da7f0-f10b-42f5-a3f2-0733952598cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb36865794fa6967511b02b8e5ee50e7, https://si.imgix.net/b15aba5f/uploads/origins/510da7f0-f10b-42f5-a3f2-0733952598cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fb5d3bc2054b91f9dff81b7dc4c25c9 2x, https://si.imgix.net/b15aba5f/uploads/origins/510da7f0-f10b-42f5-a3f2-0733952598cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ac86f56fa0eee403644445f2c284b6f 3x", "genre": "comic", "nsfw": false, "body": "いつも素晴らしいイラストをありがとうございます。\n\n原神から、リネットとシュヴルーズが大食いする生活を続け太っていく様子を、以下のような流れでお願いしたいです。\n\nリネットはケーキなどの甘いスイーツを、シュヴルーズは油っこいスナックを好んで食べる。\n2人とも体型を気にして運動をしているため痩せていた。\n\nしかし、2人が出会ってお互いの好物を食べ、甘いスイーツと油っこいスナックの組み合わせにハマってしまう。\n\nリネットは本来は味の濃い食べ物が嫌いだが、その後に食べるスイーツがより甘く感じるので、だんだん味の濃いスナックも癖になっていく。\n\nシュヴルーズは、そもそも脂質と糖質の多い食べ物が好きなので、ケーキなどのスイーツも食べるようになる。\n\nこうして間食の量も頻度も増え、だんだん太っていく。\n\nまた、運動よりも間食を優先するようになってしまい、ぶくぶく太っていく。\n\nさらに、食欲が大幅に増えた結果、間食だけでなく通常の食事も大量にお腹がぱんぱんになるまで食べるようになり、さらに間食も食べる。\n\n最終的には、少なくとも直近のニィロウくらいには太ってくれるとうれしいです。\n\nできれば、食欲や体型について、お互いに指摘しあったり、周りから反応されたりする様子も描いていただきたいです。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/32", "thumbnail_src": "https://si.imgix.net/575066c0/uploads/origins/a2820da5-5a9c-4eb4-ae65-82f866861a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=520e97d47d7aec5b421cd625f92ca69a", "thumbnail_srcset": "https://si.imgix.net/575066c0/uploads/origins/a2820da5-5a9c-4eb4-ae65-82f866861a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=520e97d47d7aec5b421cd625f92ca69a, https://si.imgix.net/575066c0/uploads/origins/a2820da5-5a9c-4eb4-ae65-82f866861a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67fc699e1ce94f2506d2eed8fdaa877f 2x, https://si.imgix.net/575066c0/uploads/origins/a2820da5-5a9c-4eb4-ae65-82f866861a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8de10a9ab97383ba2d1efc0123c5704b 3x", "genre": "comic", "nsfw": false, "body": "こんにちは、前回も素晴らしい漫画をありがとうございました...！\nさて、今回のリクエストなんですが今回は番外編という事で綺良々の漫画をお願いしたいです。\n\n概要\n「招福！繁盛？招き猫！」\n①公演を終えて暫しの休暇中のニィロウ、港で買い出し中に噂になっている「駆ける招き猫」が来るという話を聞く\n\n②なんでも、その招き猫に売り物のお菓子や食べ物を分けてあげるとその店は商売繁盛になると商人の間で話題になっているらしい\n\n③招き猫は置物なので走るのはおかしいと思いながら家に帰るニィロウ、暫くすると綺良々が配達にやってきた\n(依頼主はフリーナでパスタの贈り物という形です)\n\n④猫又の配達員である綺良々を見て、来る途中でお裾分けを貰ったか尋ねるとさっきフォンテーヌで貰ったと答えたので綺良々が「駆ける招き猫」の正体だと気付くニィロウ\n\n⑤猫と言われて嫌そうにしている綺良々にニィロウが招き猫は幸運の置物だから良いことだと説明する\n\n⑥半信半疑で配達を続ける綺良々、評価とお菓子や食べ物を貰うが、既に腹八分目だったので配達をしては少しずつお腹が膨れてしまう\n満腹で苦しいけど、配達を時間通りにこなしてその度に食べるを繰り返す綺良々\n\n⑦ニィロウが歩いていると、配達終わりの綺良々がお腹を膨らませているのを見てビックリ\n自分は猫又だから招き猫は嫌！と満腹で苦しむ彼女に何も答えられないニィロウだった\n(その後、店の売り上げと綺良々の体重が増加したのはまた別の話)\n\nキャラ事の設定\nニィロウ\n・詳しくは後日依頼予定の漫画にて明かしますが、⑧のシーンでは満腹で家に戻る最中という形でお願いします(③のシーンでフリーナから貰ったパスタについてのお話になる予定です)\n\n綺良々\n今回のメインキャラです\n・⑦のシーンでお腹が膨れていく途中、苦しくてついゲップしてしまう一幕があると良いです\n\n(今回は蛍とパイモンの出番はありません...が、次回のメインのお話では登場します)\n\n　綺良々について、初描きになられると思われるので今回は少し割高に設定させていただきます。\n次の話について考えている際、お気に入りキャラの1人である綺良々を思い出して素早く構成ができました...\n上述のストーリー設定にありますが、ニィロウサイドのお話はまた次回とさせてもらいたいです！\n長文となりましたが、こちらご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/31", "thumbnail_src": "https://si.imgix.net/bd74e164/uploads/origins/d0890933-3b7e-4bbc-838d-105a1c2232c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0da9d31ff67a512e4b6799f0c29978", "thumbnail_srcset": "https://si.imgix.net/bd74e164/uploads/origins/d0890933-3b7e-4bbc-838d-105a1c2232c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0da9d31ff67a512e4b6799f0c29978, https://si.imgix.net/bd74e164/uploads/origins/d0890933-3b7e-4bbc-838d-105a1c2232c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=504f4277fe4df11bed7133a2252a7039 2x, https://si.imgix.net/bd74e164/uploads/origins/d0890933-3b7e-4bbc-838d-105a1c2232c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=876bc1d16472e38597bb9692439a54f4 3x", "genre": "comic", "nsfw": false, "body": "どうもこんにちは、前回のおまけ風イラストありがとうございました！\n今回で3回目のリクエストになります...！\nようやく続きの構成が纏まったので、ニィロウちゃん(+α)の漫画をお願いします。\n構成としては以下の感じです。\n\n\n①前回の漫画から数日後、蛍とパイモンに誘われてフォンテーヌへとやってきたニィロウ\n\n②初めてのフォンテーヌにワクワクしているが、前回の食べ過ぎで太り気味になったニィロウ\n\n③蛍たちは待ち合わせていたフリーナと合流する\n\n④スメールからの客人をもてなそうと躍起になるフリーナはお気に入りのパスタの店を案内する\n\n⑤ちょっとボリュームがあるパスタを食べてお腹いっぱいのニィロウ達\n\n⑥ 食後のデザートとしてゆっくりとお茶会をしながら話をしようとフリーナから提案\n\n⑦流石にケーキまで入らないお腹になってしまったニィロウだが、フォンテーヌのケーキの美味しさに心奪われる\n\n⑧話に花が咲き、気付けば時間があっという間に過ぎていった(時間が経つにつれてお腹が膨れていく)\n\n⑨話が進み、楽しい時を過ごした4人\n沢山デザートを食べたフリーナ、蛍、パイモンは満足そうにしているが、ニィロウはまたも食べ過ぎてしまい更に太ってしまう事に(後日なんとか戻る)\n\n流れとしてはこのような形です。\n各キャラの要望はあまり無いですが、とりあえず下記の要素はお願いしたいです。\n\nニィロウ\n・前回からの続きという事で最初から太り気味に\n・(キノコが苦手なのでキノコ抜きのパスタにしてあげてください)\n\n蛍&パイモン\n・前と同じような感じで大丈夫です、特に指定はありません\n・フリーナとの会話でちょっとだけナタの話も入れてくださると嬉しいです！\n\nフリーナ\n・特にこれと言った指定はありませんが、最後ケーキを沢山食べて尚且つ貴重な話も聞けて嬉しそうな感じにしてあげてください！\n\n前回依頼させていただいたニィロウちゃんの漫画がとても素晴らしい出来でしたので、続きを考えてみました。\n長文になってしまい申し訳ないですが、詳細に書いたつもりです...\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/30", "thumbnail_src": "https://si.imgix.net/03d4b03c/uploads/origins/e8e528e7-a23e-41c7-b04c-44e0583718d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b45ccd9ebb132eb946d3cb9820950e7a", "thumbnail_srcset": "https://si.imgix.net/03d4b03c/uploads/origins/e8e528e7-a23e-41c7-b04c-44e0583718d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b45ccd9ebb132eb946d3cb9820950e7a, https://si.imgix.net/03d4b03c/uploads/origins/e8e528e7-a23e-41c7-b04c-44e0583718d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76615043e51f764be235ee6a56250497 2x, https://si.imgix.net/03d4b03c/uploads/origins/e8e528e7-a23e-41c7-b04c-44e0583718d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5477b08fb4e2fc4b0952c78e6d9a0f7f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arukari_rokki/works/29", "thumbnail_src": "https://si.imgix.net/cc08687c/uploads/origins/8c77a5f1-30b0-44e0-8aec-14ccf3