fc-496f-9648-d559a7005842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34ca25c7f4dcac5fdbc1d44ab8d9ead4 2x, https://si.imgix.net/c4af95f6/uploads/origins/b92191eb-b4fc-496f-9648-d559a7005842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b10463d30936ac9d76818a54784404c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@funnylife1207/works/170", "thumbnail_src": "https://si.imgix.net/b410391e/uploads/origins/231709c9-72ec-46f6-94a8-d1b58b7f3a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dded085cdc02d86e50b8364a4cfd76e7", "thumbnail_srcset": "https://si.imgix.net/b410391e/uploads/origins/231709c9-72ec-46f6-94a8-d1b58b7f3a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dded085cdc02d86e50b8364a4cfd76e7, https://si.imgix.net/b410391e/uploads/origins/231709c9-72ec-46f6-94a8-d1b58b7f3a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35e09019ccc6aeb8ab17691aed6d20bf 2x, https://si.imgix.net/b410391e/uploads/origins/231709c9-72ec-46f6-94a8-d1b58b7f3a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8f244385dcc8f3eda2c903e0afdcaf4 3x", "genre": "art", "nsfw": false, "body": "クリスマス・カリン\n\nクリスマスをテーマにしたサカマタのカリンが見たい。\nシナリオはあなた次第。", "created_at": "", "completed_at": ""}, {"path": "/@funnylife1207/works/169", "thumbnail_src": "https://si.imgix.net/9d00dd5f/uploads/origins/80e05643-3196-4cb6-b49d-4d4480ea7481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd493a2ef7f262b793dffa6728b3930", "thumbnail_srcset": "https://si.imgix.net/9d00dd5f/uploads/origins/80e05643-3196-4cb6-b49d-4d4480ea7481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd493a2ef7f262b793dffa6728b3930, https://si.imgix.net/9d00dd5f/uploads/origins/80e05643-3196-4cb6-b49d-4d4480ea7481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93628305aa39b29a611e3ea5ada5cea3 2x, https://si.imgix.net/9d00dd5f/uploads/origins/80e05643-3196-4cb6-b49d-4d4480ea7481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36b8686d7b7eb5b2d928160deeeb1e17 3x", "genre": "art", "nsfw": false, "body": "いつも楽しい動画や配信を誠にありがとうございます。\nこの度、初めての依頼をお願いします。\n\n\n『普段着（執事風）バージョンのコルニクス・A・S・ホワイトフェザーくんがブルーベル家の一室から こちらへ向けて微笑んでいる』イラストをお願いします。部屋の場所とホザーくんのポーズはおまかせでよろしくお願いします。\nイラストは印刷してお届けを利用してタペストリーにして部屋に飾りたいと思っております。崇めます。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@funnylife1207/works/168", "thumbnail_src": "https://si.imgix.net/0138b44e/uploads/origins/684d7d5e-3861-4c22-bdf1-75f9c8cba41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454bc5dab69a8cc6756fd19997e22a95", "thumbnail_srcset": "https://si.imgix.net/0138b44e/uploads/origins/684d7d5e-3861-4c22-bdf1-75f9c8cba41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454bc5dab69a8cc6756fd19997e22a95, https://si.imgix.net/0138b44e/uploads/origins/684d7d5e-3861-4c22-bdf1-75f9c8cba41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ceaa8d01e4681223b5857ce3d5f7d62b 2x, https://si.imgix.net/0138b44e/uploads/origins/684d7d5e-3861-4c22-bdf1-75f9c8cba41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79df8663c409754f2b0e8a78698f3b93 3x", "genre": "comic", "nsfw": false, "body": "https://files.catbox.moe/42q5am.webp\n\nメアリーちゃん、八重ちゃん、そして八重の友達たちは可愛いサンタっぽいの衣装を着ている。（デザインはお任せ）\nシナリオは、プレゼントを届けるために煙突から謎の家に入ったというもの。\n\nメアリーはサンタのために置いてあったクッキーを見つけ、美味しいそうので一つ食べてから他の皆を呼ぶ。メアリーは変な気分になり、次第に大きくなり、皆を見下ろすほどに巨大化した。間もなく他の皆も同じ現象に襲われ、体が大きくなりすぎてドアや煙突から脱出できなくなる。狭い空間に押し込められた彼らは、比較的小さいクッキーを調べると、チョコチップに「ワタシヲオタベ」と書かれていた（見落としやすいね）。\n\nマスコットのチャチャくんが現れ、牛乳の入ったグラスを持ってて。最初にメアリーが飲み、続いて他の皆が飲む。最後に八重が飲み干すため、他より多くの牛乳を摂取する。牛乳のおかげで全員が元サイズに戻るが、八重ちゃんはより多く飲んだため人形サイズに小さくなって、メアリーたちを見上げる。メアリーは優しく彼女を抱き上げ、皆に「メリークリスマス」を願う。\n\nありがとうございます！必要に応じて自由に調整と描写してください。", "created_at": "", "completed_at": ""}, {"path": "/@funnylife1207/works/167", "thumbnail_src": "https://si.imgix.net/0f044404/uploads/origins/e7a543f8-4d29-41c6-982f-47b41b2be442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=489d34a2e0b567f6465d14339881d050", "thumbnail_srcset": "https://si.imgix.net/0f044404/uploads/origins/e7a543f8-4d29-41c6-982f-47b41b2be442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=489d34a2e0b567f6465d14339881d050, https://si.imgix.net/0f044404/uploads/origins/e7a543f8-4d29-41c6-982f-47b41b2be442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b9463c0595437bb99dbbf8b7eb75422 2x, https://si.imgix.net/0f044404/uploads/origins/e7a543f8-4d29-41c6-982f-47b41b2be442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8dcb4d9b5ca36d031ee5d69246fe964a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@funnylife1207/works/166", "thumbnail_src": "https://si.imgix.net/da6e7e4d/uploads/origins/d1857de9-df9c-4efc-bb8e-820061216cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd979913fa35e0df11cb0c926ec18ff1", "thumbnail_srcset": "https://si.imgix.net/da6e7e4d/uploads/origins/d1857de9-df9c-4efc-bb8e-820061216cdb?bg=%2