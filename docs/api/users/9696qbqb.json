T13:23:49.525051+00:00"}, {"amount": 22000, "recorded_at": "2026-03-14T05:31:42.237233+00:00"}, {"amount": 20000, "recorded_at": "2026-03-14T14:14:10.508493+00:00"}, {"amount": 15000, "recorded_at": "2026-03-15T05:20:27.704413+00:00"}, {"amount": 23000, "recorded_at": "2026-03-15T12:53:31.080509+00:00"}]}, "current_prices": {"art": 23000}, "price_range": {"art": {"min": 10000, "max": 27000}}, "links": [{"label": "Twitter", "url": "https://x.com/9696qbqb", "name": "9696qbqb"}, {"label": "Misskey_io", "url": "https://misskey.io/@9696qbqb", "name": "9696qbqb"}, {"label": "Website", "url": "https://lit.link/9696qbqb", "name": ""}, {"label": "BOOTH", "url": "https://9696qbqb.booth.pm", "name": "9696qbqb"}], "flags": {"from_archive": true}, "works": [{"path": "/@9696qbqb/works/120", "thumbnail_src": "https://si.imgix.net/b216ab9e/uploads/origins/c25152cf-a625-4925-a3f9-43ea88dbd1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9c8e05e64784a19da5d1b46545b350", "thumbnail_srcset": "https://si.imgix.net/b216ab9e/uploads/origins/c25152cf-a625-4925-a3f9-43ea88dbd1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9c8e05e64784a19da5d1b46545b350, https://si.imgix.net/b216ab9e/uploads/origins/c25152cf-a625-4925-a3f9-43ea88dbd1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39d2a8b4dd10255ba99f6b9e6a358a56 2x, https://si.imgix.net/b216ab9e/uploads/origins/c25152cf-a625-4925-a3f9-43ea88dbd1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=526b752b37190d75e032ab4b1faa2f3b 3x", "genre": "art", "nsfw": false, "body": "初めまして、こういった依頼を初めてするので不足している点等あれば申し訳ありません…\n\n・依頼したいもの\n学園アイドルマスターのユニット　ゆめぱしー\n(篠澤広と倉本千奈のユニット)\n\n構図は参考資料や実装された際の動画を参照し、お任せでお願いできれば思います。\n\n・使用用途\nXやDiscordなどのアイコン\nアイマスのイベント等での交換用名刺素材\n(基本的にそのまま名刺に使用させて頂きたいですが、念のため背景投下バージョンももらえると嬉しいです。)\n\n・参考資料\nhttps://m.youtube.com/watch?v=P5Fe4nhePa0&t=54m30s\n\n54分付近からliveの動画があり(URLで飛ぶはずです…)\nその後58分30秒ぐらいからモデルの映像が確認できます。\n\nただ、liveの映像が実装前で途中となります。\n作業に取り掛かるぐらいにはおそらく実装されているかと想定されますので、その際にはちょっと検索してもらい確認いただけますと幸いです…\n\nまた、細かいですが…モデルの説明時に解説されてますが、髪飾りが交換？されているようですので、ちょっと気を付けてもらえればなと思います…\n\n金額は2人描いて欲しいという依頼でもあり、\n他サイトのリンクを参照し、デフォルトの金額から盛らせて頂きました。\n不足あればリジェクトしてもらい、再リクエストという流れも検討させていただければと思っています。\n\n以上、何卒よろしくお願いします。\n\nhttps://m.youtube.com/watch?v=P5Fe4nhePa0&t=54m30s", "created_at": "", "completed_at": ""}, {"path": "/@9696qbqb/works/119", "thumbnail_src": "https://si.imgix.net/febbe751/uploads/origins/899fde59-f07d-4ac5-87ff-ba4f0c951a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9779c270c405292a8da403e5546ffd95", "thumbnail_srcset": "https://si.imgix.net/febbe751/uploads/origins/899fde59-f07d-4ac5-87ff-ba4f0c951a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9779c270c405292a8da403e5546ffd95, https://si.imgix.net/febbe751/uploads/origins/899fde59-f07d-4ac5-87ff-ba4f0c951a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e4893585aeea247bd92a2f3687a86ac 2x, https://si.imgix.net/febbe751/uploads/origins/899fde59-f07d-4ac5-87ff-ba4f0c951a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d922e29c2e84b9e2b5be541ff58c62a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@9696qbqb/works/118", "thumbnail_src": "https://si.imgix.net/0866358c/uploads/origins/b9fad27e-b280-4976-a8c2-36ed9d93adc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c051805397d9bc76aef17298934c25ea", "thumbnail_srcset": "https://si.imgix.net/0866358c/uploads/origins/b9fad27e-b280-4976-a8c2-36ed9d93adc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c051805397d9bc76aef17298934c25ea, https://si.imgix.net/0866358c/uploads/origins/b9fad27e-b280-4976-a8c2-36ed9d93adc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a50039e0849ecd670e478cdc115c5b58 2x, https://si.imgix.net/0866358c/uploads/origins/b9fad27e-b280-4976-a8c2-36ed9d93adc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10f9568487dd0ba8a6ceff50918c355a 3x", "genre": "art", "nsfw": false, "body": "続けて失礼いたします…！\n新人Vsingerの花開ふりる(はなひらふりる)と申します。\n\nくろだくろ子様へ是非、下記のイラストもお願いしたく別途リクエストをさせていただきました…！\n\n  早速なのですが、以下詳細になります。  \n\n【描いていただきたいもの】\n 花開 ふりるイラスト\n\n ★髪色 \n・全体のカラーコード【#ff9396】 \n・毛先の緑のカラーコード【#C1fb5f】  \n\n★特徴\nチューリップから生まれたキャラクターです。\n・チューリップ型のアホ毛\n・束感のあるまつ毛\n・優しめな猫目\n\n★モデルの参考資料(私のXにも詳細がございます)\nhttps://drive.google.com/drive/folders/1-Gj84aoPw0iNqA7eiX0CMeCtwl3n7aRr\n\n【使用用途】\n・自身の生誕祭・または周年記念にて使用\n・グッズ販売(商用利用)\n・Xでの使用 \n・収益化済みのYouTubeチャンネルのサムネイルでも使用 \n\n【構図】\n下記のような構図でお願いいたします。\n・出来ればお花はチューリップを中心に描いて頂けますと幸いです…！(色合いはおまかせいたします！)\nhttps://drive.google.com/file/d/1vsYENTI5WDF_eWtNnY9TKo8qcsiCtn0s/view?usp=drivesdk\n\n【その他】\n・キャラクターが幼い面持ちなのですが、幼すぎないように描いて頂けますと幸いです…！\n・雰囲気に合わせてキャラクターの色合いは変えて頂いて問題ございません。\n・合わせて透過のものも送付して頂きたいです。 \n・画像形式はお任せいたします。 \n\nお忙しい中恐れ入りますが、 \nよろしければよろしくお願いいたします🌷", "created_at": "", "completed_at": ""}, {"path": "/@9696qbqb/works/117", "thumbnail_src": "https://si.imgix.net/848e24fc/uploads/origins/d2e36070-0d8a-4078-84a4-ecffeeb52320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054b71caa07f2ef71f4d7f69de64bd39", "thumbnail_srcset": "https://si.imgix.net/848e24fc/uploads/origins/d2e36070-0d8a-4078-84a4-ecffeeb52320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054b71caa07f2ef71f4d7f69de64bd39, https://si.imgix.net/848e24fc/uploads/origins/d2e36070-0d8a-4078-84a4-ecffeeb52320?bg=%23fff&auto=format%2Ccompress&fm