=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e1496849a10683e2ca66b7b9afc2785 2x, https://si.imgix.net/7ac5ccc2/uploads/origins/ce3f7b6a-81f4-4073-b3c3-aba011e6dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5edfb7e475c3fedcc0f7675a2aef9dc8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Chihua_Zoku/works/72", "thumbnail_src": "https://si.imgix.net/6f712ffe/uploads/origins/dc277f6c-7bbb-47cc-9f2a-ad03175f7768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76282df9f3be79d5c55bc558b3b5475a", "thumbnail_srcset": "https://si.imgix.net/6f712ffe/uploads/origins/dc277f6c-7bbb-47cc-9f2a-ad03175f7768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76282df9f3be79d5c55bc558b3b5475a, https://si.imgix.net/6f712ffe/uploads/origins/dc277f6c-7bbb-47cc-9f2a-ad03175f7768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b8015340af3735e3a3a0061e61a30d9 2x, https://si.imgix.net/6f712ffe/uploads/origins/dc277f6c-7bbb-47cc-9f2a-ad03175f7768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6d7ba2d77a24241b23c4ed4c9a1eb4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のキャラクターをドラゴンか海のモンスターのどちらかにしてくれたら嬉しいです。どちらを選ぶかは自由ですし、細かい部分はできるだけお任せしたいです！\n\nhttps://drive.google.com/file/d/1iU7BL3lt4uGqBEsUN1rAK5TK0_pk2gTE/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Chihua_Zoku/works/71", "thumbnail_src": "https://si.imgix.net/b096b4b8/uploads/origins/9d4e5933-beda-46a7-99ec-308c47d30c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8620f12a9265651f1e91f960c305861e", "thumbnail_srcset": "https://si.imgix.net/b096b4b8/uploads/origins/9d4e5933-beda-46a7-99ec-308c47d30c1b?bg=%23fff&auto=format%2Ccompre