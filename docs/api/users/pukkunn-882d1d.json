RONにできることは、赤面しながら迷惑そうにそれを受け入れ、早く終わることを願うだけだ！\nSHIRONとRATHIANはLegendz出身！", "created_at": "", "completed_at": ""}, {"path": "/@pukkunn/works/130", "thumbnail_src": "https://si.imgix.net/602071c5/uploads/origins/9dbd4f12-63c8-4521-8061-341a05f27809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83ed000f1fcd124313af4d8516e64005", "thumbnail_srcset": "https://si.imgix.net/602071c5/uploads/origins/9dbd4f12-63c8-4521-8061-341a05f27809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83ed000f1fcd124313af4d8516e64005, https://si.imgix.net/602071c5/uploads/origins/9dbd4f12-63c8-4521-8061-341a05f27809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd9f15b126c27fd57cda8a5fd25e16b0 2x, https://si.imgix.net/602071c5/uploads/origins/9dbd4f12-63c8-4521-8061-341a05f27809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ee3aae72f6f3a3a54d6114de819e4b5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pukkunn/works/129", "thumbnail_src": "https://si.imgix.net/5ebdac88/uploads/origins/82a5f97c-5d1a-4b7c-af20-e82905288cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a5884c1c236a2e9391164d28de23d5f", "thumbnail_srcset": "https://si.imgix.net/5ebdac88/uploads/origins/82a5f97c-5d1a-4b7c-af20-e82905288cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txt