f5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71cdf0b4454ce683346a8e51b1223744, https://si.imgix.net/892c4994/uploads/origins/44ef4bb7-e8a1-43da-be6f-c9d10995f5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f5e160467a4e4f40fc7f9873473e4d4 2x, https://si.imgix.net/892c4994/uploads/origins/44ef4bb7-e8a1-43da-be6f-c9d10995f5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e95c12db560167e66020ac7fff85dbd9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pukkunn/works/114", "thumbnail_src": "https://si.imgix.net/3399e54f/uploads/origins/3a340664-9785-44f3-9405-dc40896fe796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3256ca67732b20e5bbf2ef8b7e92862", "thumbnail_srcset": "https://si.imgix.net/3399e54f/uploads/origins/3a340664-9785-44f3-9405-dc40896fe796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3256ca67732b20e5bbf2ef8b7e92862, https://si.imgix.net/3399e54f/uploads/origins/3a340664-9785-44f3-9405-dc40896fe796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f1b416cdf4bff41f841ef4767409138 2x, https://si.imgix.net/3399e54f/uploads/origins/3a340664-9785-44f3-9405-dc40896fe796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d32cd60db536db1c1ba10848a6baab83 3x", "genre": "comic", "nsfw": true, "body": "こんにちは！\n今回は前にも描いてもらったマイロスガルがベヒーモスにcockvoreされる作品をお願いしたいです！（資料は下に）\n\n1ページ目で\n斧を持ったロスガルが吹っ飛ばされて地面に倒れたあとベヒーモスの強靭な前足でドスッと捕まえられ\n殺られる！と思った所に\nお前…強いし美味そうだなこっちで喰ってやると足元にベヒーモスの巨根の先がボロンと\nそしてそれにびっくりし！？となるロスガル\n\n2ページ目で\nふざけるなと逃げようと足掻こうとするも前足で体を抑えられてるので足からゆっくり丸呑みにされていき\nそのまま巨根にゴックン！と喰われる様子を\n\n3ページ目で\n大きくなった玉袋がモゾモゾ動き\nベヒーモス気持ちよくシコッてる所\n差分で大量に出してイク所を\n\nここでそのページに合わせてワイプをお願いしたく\n玉袋の描写が大きく描かれたワイプを差分合わせて3カットくらいで\n袋の中で精液がせまり足掻いて溺れながら精液に成り果ていく様子が見たいです！\n玉袋の中は後ろに玉がしっかりあってそれで押し付けられ身動きが取れずそのまま精液に埋まっていく感じが良いです\n\n\nセリフはおまかせで有り無し両方を\nファイルはすべて分けて納品でお願いします\n\nかなり濃い内容ですが良かったらよろしくお願いしますm(_ _)m\n\nhttps://www.dropbox.com/scl/fo/ss09rgl0cb26rgsww7ncb/ANFX20B_P6Ot5660bTcgAmA?rlkey=q4o5vqu9a5278x3z42k920qry&st=blxdeii7&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@pukkunn/works/113", "thumbnail_src": "https://si.imgix.net/a422ec7f/uploads/origins/c25e8c00-c679-41e7-9fd6-d548c236c150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd7be584bd91c575093abef123080e33", "thumbnail_srcset": "https://si.imgix.net/a422ec7f/uploads/origins/c25e8c00-c679-41e7-9fd6-d548c236c150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd7be584bd91c575093abef123080e33, https://si.imgix.net/a422ec7f/uploads/origins/c25e8c00-c679-41e7-9fd6-d548c236c150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5675cdce1f3f20afad0d0fad0cb00538 2x, https://si.imgix.net/a422ec7f/uploads/origins/c25e8c00-c679-41e7-9fd6-d548c236c150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c663ea8890aef4a0224658c5aa19a7f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pukkunn/works/112", "thumbnail_src": "https://si.imgix.net/73b77be9/uploads/origins/a7d03d63-04c8-4d0c-aef5-f243a6f070c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr