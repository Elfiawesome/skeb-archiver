23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ef7273f1191bcf1680a7e0c7f8d5b52, https://si.imgix.net/e4450ccf/uploads/origins/f9b5218b-da60-41cc-a99a-fa5b05c15bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dda20adbf8b63a84086494760da37fd 2x, https://si.imgix.net/e4450ccf/uploads/origins/f9b5218b-da60-41cc-a99a-fa5b05c15bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d6855589be458130c28b832dd9ea7e9 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております！\n由利さんが最近描かれているふわもふのモンスターがとても素敵で、1体デザイン＆イラストをお願いできると嬉しいです！\nふわもふのベースはモモンガ、組み合わせる要素にカイコ（成虫）でお願いしたいです（要素増えたり、ベース入れ替えしても大丈夫です）。\n\n●定期更新型ゲーム、PBWで使用（以前描いていただいたしゅきちゃんと一緒に使用）\n●ブログでの使用\n○特徴や生態等の設定もあると妄想がはかどります！\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Freezing_Wolf/works/4", "thumbnail_src": "https://si.imgix.net/61642611/uploads/origins/c720091c-b43f-4d06-80f1-31f21c13986c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5be8e64f5ee372c8e12e43c6c6c3f6b", "thumbnail_srcset": "https://si.imgix.net/61642611/uploads/origins/c720091c-b43f-4d06-80f1-31f21c13986c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5be8e64f5ee372c8e12e43c6c6c3f6b, https://si.imgix.net/61642611/uploads/origins/c720091c-b43f-4d06-80f1-31f21c13986c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b32f2a2cb138aef95242938852b029c2 2x, https://si.imgix.net/61642611/uploads/origins/c720091c-b43f-4d06-80f1-31f21c13986c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33e7338761ce37d93b4ff52196e4df39 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お世話になっております……！\n以前由利さまに描いていただいた自キャラのアールノと、「Stroll Green」という空中庭園を舞台としたゲーム内で仲良くさせていただいているナディグさんとのツーショット絵をお願いしたく、依頼を送らせていただきます！\n\n▼アールノのプロフィール\nhttp://st.x0.to/?mode=profile&eno=642\n\n▼ナディグさんのプロフィール（PLさん及びイラストを描かれた絵師さんの了解はいただいております）\nhttp://st.x0.to/?mode=profile&eno=209\n\nシチュエーションとしましては、\nA. ナディグさんが剣で戦っているところを、風の魔法で支援しているところ\nB. 夜の庭園のベンチで、ナディグさんが持つ懐中時計を見せていただいているところ\nのいずれかでお願いできればと思います。\n\nもし描いていただけましたら、ゲーム内で2人が連続行動する際に演出イラストを設定することができるので、そこに使わせていただきたい（画像サイズは横600px、縦自由（1000pxまで））のと、ブログに掲載をさせていただきたいと考えております。\n可能であれば等身が高いイラストを希望しますが、デフォルメでも構いません。\nもしよろしければ、なにとぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Freezing_Wolf/works/3", "thumbnail_src": "https://si.imgix.net/078ef14a/uploads/origins/53174879-7634-45a1-8cc8-776c04c4b628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6fddc5deb4140d6f75df898dfd25347", "thumbnail_srcset": "https://si.imgix.net/078ef14a/uploads/origins/53174879-7634-45a1-8cc8-776c04c4b628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6fddc5deb4140d6f75df898dfd25347, https://si.imgix.net/078ef14a/uploads/origins/53174879-7634-45a1-8cc8-776c04c4b628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ebcccbd1577794fafe4eb7b61876414 2x, https://si.imgix.net/078ef14a/uploads/origins/53174879-7634-45a1-8cc8-776c04c4b628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f56c8a3c5c55a1476ac756d967f44ca0 3x", "genre": "art", "nsfw": false, "body": "依頼失礼します、ゴリラです。\n拙宅のキャラクターを描いてくれたらいただきたいのですが、由利さんに描きたいキャラクターをひとり選んでくれると嬉しいです。\n資料は当方のTwitterアカウントから確認していただけると幸いです。\n「そんな無茶な注文すんなよ……」と思った場合はゴリラを描いて下さい。大変喜びます。\n\nご検討よろしくお願いいたします。\n\nhttps://twitter.com/0055s_long_inu/status/1412080297986772997?s=19", "created_at": "", "completed_at": ""}, {"path": "/@Freezing_Wolf/works/2", "thumbnail_src": "https://si.imgix.net/7823aecf/uploads/origins/54f42ac8-0759-4421-97ba-22014659a802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a82ecee4b08b4dbf3640085a8f4c3ac9", "thumbnail_srcset": "https://si.imgix.net/7823aecf/uploads/origins/54f42ac8-0759-4421-97ba-22014659a802?bg=%23fff&auto=format%2Ccompress&