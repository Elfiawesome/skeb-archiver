g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=775c9c7152f9ac00a014cd601e64c5d8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！キャラクターデザインを依頼したいのですが。\n\n人間のことが大好きだけど、反社会的で自分から話しかけることができない、引きこもりのアライグマの女の子です。コスプレでキャラになりきり、可愛くはしゃぐしかない。\n\nスター気取りのファンと交流するシナリオも欲しい。ほとんど人間の女の子です。その他、細かいことはお任せします。ありがとうございました！\n\nhttps://drive.google.com/file/d/1eZg2-3_sJMzVBqBp0wdSaMpVsrkDxfG4/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Gomyama__/works/38", "thumbnail_src": "https://si.imgix.net/75735c6d/uploads/origins/cb981816-9206-4797-99d7-ca6b92e03293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47ff023ab5f05d5784498b180f863366", "thumbnail_srcset": "https://si.imgix.net/75735c6d/uploads/origins/cb981816-9206-4797-99d7-ca6b92e03293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47ff023ab5f05d5784498b180f863366, https://si.imgix.net/75735c6d/uploads/origins/cb981816-9206-4797-99d7-ca6b92e03293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a91fab7ff73383a7d472b7fe3b9be6d 2x, https://si.imgix.net/75735c6d/uploads/origins/cb981816-9206-4797-99d7-ca6b92e03293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a545d759522bac251dd43ca1c0179fb6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gomyama__/works/37", "thumbnail_src": "https://si.imgix.net/bd596245/uploads/origins/02565695-ac79-440f-b17d-f7ce951ed23f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6f97df3d9b91cd8a37b