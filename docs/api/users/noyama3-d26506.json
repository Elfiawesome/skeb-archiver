fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1592b772a04226baf5edda02f1d1453 2x, https://si.imgix.net/2bfb9202/uploads/origins/16f3859c-c2f4-4c02-afbb-b81299b3e440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9e4825087c6661098012d3e545031ee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@noyama3/works/3", "thumbnail_src": "https://si.imgix.net/96c24920/uploads/origins/363ceaa4-bee8-46ac-b6c7-494399b318ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3321adf14cc45a199d630e56b2d98a6d", "thumbnail_srcset": "https://si.imgix.net/96c24920/uploads/origins/363ceaa4-bee8-46ac-b6c7-494399b318ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3321adf14cc45a199d630e56b2d98a6d, https://si.imgix.net/96c24920/uploads/origins/363ceaa4-bee8-46ac-b6c7-494399b318ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d377362a24a2facb87a863350c5fe59 2x, https://si.imgix.net/96c24920/uploads/origins/363ceaa4-bee8-46ac-b6c7-494399b318ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0defb12899875508cc52a91806aea826 3x", "genre": "art", "nsfw": false, "body": "のやまさんの描いた、ベーコンエッグ定食（大盛）の絵が見たいです。", "created_at": "", "completed_at": ""}, {"path": "/@noyama3/works/2", "thumbnail_src": "https://si.imgix.net/ae1084fd/uploads/origins/53d1a4f7-61a3-4733-b3ad-49d434e691df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc85b93c866479324211debcda254104", "thumbnail_srcset": "https://si.imgix.net/ae1084fd/uploads/origins/53d1a4f7-61a3-4733-b3ad-49d434e691df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc85b93c866479324211debcda254104, https://si.imgix.net/ae1084fd/uploads/origins/53d1a4f7-61a3-4733-b3ad-49d434e691df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76d19271e2e301f1081a480a5a26a690 2x, https://si.imgix.net/ae1084fd/uploads/origins/53d1a4f7-61a3-4733-b3ad-49d434e691df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd00c116c2bfa485c3d835d34e10290b 3x", "genre": "art", "nsfw": false, "body": "のんさんこんにちは　ヤーマンです。\nお元気でしょうか・・ちょっとお疲れにみえますので心配してます。\nいままで色々な絵を書いて頂いて感謝してます。\nそんなのんさんにできればデザインをお願いできないかと思いました。\n\nヤーマンもしかするとコーヒー豆の販売のお店をやるかも？となっていまして\nそのコーヒーのパッケージに使うシールのデザインが欲しいのです。\n\nグリーンタイツを履いているチョンマゲで白い髭の黒人（モーグリスリッパはなし）が小さくワンポイントで入っていて店名とコーヒーだよってわかるようなパッケージシールをイメージしています。　\n店名\nグリタイコーヒー\nGreen Tights Coffee\ncoffee beansか豆の絵\n\nすぐに潰れそうですね（笑\nコーヒー名は手書きで入れたいと思うのでその場所もほしいです。\n大体シールは６ｃｍｘ６ｃｍくらいの大きさです。\n全体デザインがちょっと困難でしたらヤーマンのワンポイントだけでもお願いできたらと思っています。\nそのワンポイントがあれば名刺とか看板とかＨＰにとか使いたいと思っていますので・・・・\n\nもしできたら無理しない程度で結構ですのでよろしくお願いします！ヤー！", "created_at": "", "completed_at": ""}, {"path": "/@noyama3/works/1", "thumbnail_src": "https://si.imgix.net/116d01d3/uploads/origins/8fc92d7e-41b0-41f3-a6b1-d86cd1aa16a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97cff9535efa2dc55edfe221a764b3a", "thumbnail_srcset": "https://si.imgix.net/116d01d3/uploads/origins/8fc92d7e-41b0-41f3-a6b1-d86cd1aa16a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97cff9535efa2dc55edfe221a764b3a, https://si.imgix.net/116d01d3/uploads/origins/8fc92d7e-41b0-41f3-a6b1-d86cd1aa16a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04bef4ade919c0ee0478b93e88f18f9e 2x, https://si.imgix.net/116d01d3/uploads/origins/8fc92d7e-41b0-41f3-a6b1-d86cd1aa16a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26621af9fbe11832f079339e259f5804 3x", "genre": "art", "nsfw": false, "body": "こんにちは～、太った猫の作品、かわいいですね。\n\n私は太ったウサギのアートが欲しいのですが、別々のpngでお願いします。\n\nhttps://twitter.com/noyama3/status/142605