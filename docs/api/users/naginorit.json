d-9caa-633b1ea75fba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d58936ac6e6c7b8b744cf26151ea26", "thumbnail_srcset": "https://si.imgix.net/7d050af3/uploads/origins/e2cc231f-666e-459d-9caa-633b1ea75fba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d58936ac6e6c7b8b744cf26151ea26, https://si.imgix.net/7d050af3/uploads/origins/e2cc231f-666e-459d-9caa-633b1ea75fba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2468050da17e47552303bb79d2f7f7e6 2x, https://si.imgix.net/7d050af3/uploads/origins/e2cc231f-666e-459d-9caa-633b1ea75fba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bbd9cb95c83322ec50f41b79cf6f8c1 3x", "genre": "art", "nsfw": false, "body": "こんにちはあなたのスタイルが大好きです!私のオリジナルキャラクターNaviの作品を依頼したいです!ナビは森の中の図書館に住んでいる天使のようなクマです。どんなポーズでもOKで、性別も選べます!翼も自由だし、服も変えてもいいし、後光の大きさも動かしてもいいけど、ちょっと曲がっているのが大事！（笑\n\nhttps://drive.google.com/file/d/1_F2Az1JsRv6XstWK55XHAQUMwlp1c1CZ/view?usp=sharing\n\n参考までに、私はこの雰囲気/色彩が大好きです!\nhttps://skeb.jp/@naginorit/works/3\n\nこの作品と同じような図書館でのナビを描いてくれたら嬉しいです！参考と同じ縦横比でも16：10でも構いません（スマホかノートPCの背景にしたいです！）。", "created_at": "", "completed_at": ""}, {"path": "/@naginorit/works/11", "thumbnail_src": "https://si.imgix.net/9602e60e/uploads/origins/842a7b1f-69dc-4ad8-83c2-61e52281432a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf4a40dd76f001ae0cd335249467eea", "thumbnail_srcset": "https://si.imgix.net/9602e60e/uploads/origins/842a7b1f-69dc-4ad8-83c2-61e52281432a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf4a40dd76f001ae0cd335249467eea, https://si.imgix.net/9602e60e/uploads/origins/842a7b1f-69dc-4ad8-83c2-61e52281432a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f11fa0fd30ca4d30c3898e0ddec4523e 2x, https://si.imgix.net/9602e60e/uploads/origins/842a7b1f-69dc-4ad8-83c2-61e52281432a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200