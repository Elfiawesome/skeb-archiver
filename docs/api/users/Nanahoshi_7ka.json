e6-04657c30d563?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf62e8eff3b50118a34d98914b0f7840 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/42", "thumbnail_src": "https://si.imgix.net/3ba1709b/uploads/origins/f691b27d-812e-4ee5-a363-89f7adb379b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=411486c7c3daee8cf9a680d45e92e34d", "thumbnail_srcset": "https://si.imgix.net/3ba1709b/uploads/origins/f691b27d-812e-4ee5-a363-89f7adb379b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=411486c7c3daee8cf9a680d45e92e34d, https://si.imgix.net/3ba1709b/uploads/origins/f691b27d-812e-4ee5-a363-89f7adb379b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec36226bce022c20715d8973849b9468 2x, https://si.imgix.net/3ba1709b/uploads/origins/f691b27d-812e-4ee5-a363-89f7adb379b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9389ac2b513249733521c4e07d76a273 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n\n\nドラゴン娘になりたくないっ!の流星アーシュが時折描かれているドラゴンの着ぐるみを着ているイラストをお願いします。\n資料２のカードのドラゴンがモチーフになっているキャラなので着ぐるみはそちらをもとにして欲しいです。\n表情は戸惑っているとか恥ずかしがっている感じでお願いします。\n胸無しもあれば嬉しいですがラフ垢なので難しければ大丈夫です。\n装飾の少ないものも雑魚ドラゴン感が強く無様で好きなので消せるようレイヤー分けされていると嬉しいです。\n\n\nどうぞよろしくお願いいたします。\n\n\n資料\n１.公式HP\nキャラ紹介ページが独立していないのでcharacterページをクリックするか下にスクロールしてください。\nhttps://dm.takaratomy.co.jp/drms/\n\n２.カードイラスト　ガイアッシュ・カイザー\nhttps://dm.takaratomy.co.jp/card/detail/?id=dmex17-021", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/41", "thumbnail_src": "https://si.imgix.net/440b0e99/uploads/origins/dfaf5cd9-8abf-4b50-9039-fbf67477689f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d4df7480a75d8d2e1de7589df47da4", "thumbnail_srcset": "https://si.imgix.net/440b0e99/uploads/origins/dfaf5cd9-8abf-4b50-9039-fbf67477689f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d4df7480a75d8d2e1de7589df47da4, https://si.imgix.net/440b0e99/uploads/origins/dfaf5cd9-8abf-4b50-9039-fbf67477689f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93b9284cf02d5d00b2f303ff9dcee74d 2x, https://si.imgix.net/440b0e99/uploads/origins/dfaf5cd9-8abf-4b50-9039-fbf67477689f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=717cebc9db287cf6d4c9d7eb30877d37 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/40", "thumbnail_src": "https://si.imgix.net/fc20072c/uploads/origins/a831faeb-448c-4410-a192-37530d5b7f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=804f7561c5c9d4148c4737760cde2832", "thumbnail_srcset": "https://si.imgix.net/fc20072c/uploads/origins/a831faeb-448c-4410-a192-37530d5b7f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=804f7561c5c9d4148c4737760cde2832, https://si.imgix.net/fc20072c/uploads/origins/a831faeb-448c-4410-a192-37530d5b7f44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ace2ee59088d2f565643fa0ebfa28ca5 2x, https://si.imgix.net/fc20072c/uploads/origins/a831faeb-448c-4410-a192-37530d5b7f44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc7819939823c93d654a05fe694b077d 3x", "genre": "art", "nsfw": false, "body": "先日はラバーダルマのリクエストにご快諾いただきありがとうございます！\nよろしければ、私のOC「錦野 舞」「錦野 歌嫁」の球体化イラストもしくはラバーダルマ化をお願いしたいです！差し支えなければ２人とも描いていただけますと嬉しいです…！\n\n【キャラクターについて（Dropbox）】\n衣装差分が２つがありますが、どちらを描いてくださっても構いません。\n- https://www.dropbox.com/scl/fi/7l1g33zmz37o83auf8eje/cnsp-psd-78_.png （左が錦野 舞）\n- https://www.dropbox.com/scl/fi/pbw6zeclncfe4zv4tlrh3/.png （右が錦野 舞）\n\n【イラストのシチュエーションについて】\n形状変化のイメージやシチュエーションについては以下のイラストに近いものですと嬉しいです。\n＜球体化の形状イメージ＞\n- https://skeb.jp/@ooohnk/works/53\n＜ラバーダルマ化の形状イメージ＞\n- https://skeb.jp/@Nanahoshi_7ka/works/23\n＜表情や動作のイメージ（Dropbox）＞\n- https://www.dropbox.com/scl/fi/jv0mnt1ugtjxc282iw82u/.png （錦野 舞）\n- https://www.dropbox.com/scl/fi/bf09pl5obzf7o1xy98bt5/.png （錦野 歌嫁）\n- https://www.dropbox.com/scl/fi/6j0nafapftkd0i55610o7/2023-1.png （左が錦野 舞）\n\n【利用用途について】\n 個人の閲覧範囲までに留めます。それ以外での使用は致しません。  \n\nぜひご検討いただけますと幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/39", "thumbnail_src": "https://si.imgix.net/9de92cf9/uploads/origins/1ab047fa-6b68-491a-9387-a79657e7e3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56dd8df0466b9cdd26aee25f357d6241", "thumbnail_srcset": "https://si.imgix.net/9de92cf9/uploads/origins/1ab047fa-6b68-491a-9387-a79657e7e3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56dd8df0466b9cdd26aee25f357d6241, https://si.imgix.net/9de92cf9/uploads/origins/1ab047fa-6b68-491a-9387-a79657e7e3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1e3d73aa731e55ead7258cc2acdd946 2x, https://si.imgix.net/9de92cf9/uploads/origins/1ab047fa-6b68-491a-9387-a79657e7e3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea08906f4de4823ad642035c7e939a92 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/38", "thumbnail_src": "https://si.imgix.net/1dea6a49/uploads/origins/82f36928-42c7-4402-99e6-c517a8adaf93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33558b07edb676e139a7156cb286e4e4", "thumbnail_srcset": "https://si.imgix.net/1dea6a49/uploads/origins/82f36928-42c7-4402-99e6-c517a8adaf93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33558b07edb676e139a7156cb286e4e4, https://si.imgix.net/1dea6a49/uploads/origins/82f36928-42c7-4402-99e6-c517a8adaf93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f0c0a2d208009cecafa94a9f7be453 2x, https://si.imgix.net/1dea6a49/uploads/origins/82f36928-42c7-4402-99e6-c517a8adaf93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f858e7d9c33f7d5cd81969ee05698ac0 3x", "genre": "art", "nsfw": true, "body": "先日は素晴らしいイラストを描いて頂き、ありがとうございました。\n前川みくがヘビの顔出し着ぐるみを着ているイラストをリクエストします。\nイラストは下記のイメージです。\n\n□着ぐるみイメージ\n・別添の資料URL参考\n・ヘビの首または口の部分から顔出し（描きやすい方でOKです）\n・着ぐるみから手足が出ている状態\n・お腹部分に穴を設け、タイツ越しに大きな胸が見えるようにする\n・着ぐるみの全身をできるだけ見てみたいです（参考資料と同程度の大きさのイメージ、可能な範囲でOKです）\n\n□シチュ案\n①ヘビの着ぐるみを着せられて、座らされている状態またはうつ伏せの状態\n※細かい部分のシチュはお任せします\n②嫌がっている表情、恥ずかしがる表情\n※ポーズは描きやすいものでOKです\n\nもし、よろしければ、ご検討の程お願いします！\n\nhttps://www.pixiv.net/artworks/134220302", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/37", "thumbnail_src": "https://si.imgix.net/9884e97d/uploads/origins/e33955aa-6658-4b7e-a4ac-c6b50f5eae1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8259548b683e03aa148a1b842f524066", "thumbnail_srcset": "https://si.imgix.net/9884e97d/uploads/origins/e33955aa-6658-4b7e-a4ac-c6b50f5eae1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8259548b683e03aa148a1b842f524066, https://si.imgix.net/9884e97d/uploads/origins/e33955aa-6658-4b7e-a4ac-c6b50f5eae1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2fea0f5b07e4cfc84ae4f70efbdc6ef 2x, https://si.imgix.net/9884e97d/uploads/origins/e33955aa-6658-4b7e-a4ac-c6b50f5eae1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a44f9b2d5cedff3e7123557ed9af2388 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/36", "thumbnail_src": "https://si.imgix.net/34c75974/uploads/origins/c7193331-2f42-429c-93ef-d21df0d39872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bdea381a7845484d62131ab108391f2", "thumbnail_srcset": "https://si.imgix.net/34c75974/uploads/origins/c7193331-2f42-429c-93ef-d21df0d39872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bdea381a7845484d62131ab108391f2, https://si.imgix.net/34c75974/uploads/origins/c7193331-2f42-429c-93ef-d21df0d39872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74a515688bbac6eec71a6711fc1199f4 2x, https://si.imgix.net/34c75974/uploads/origins/c7193331-2f42-429c-93ef-d21df0d39872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6a926984bf21863c4adbddea4a98b8f 3x", "genre": "art", "nsfw": true, "body": "お世話になります。いつも素晴らしいイラストをありがとうございます。\n今回は貴方のOCちゃんでのリクエストさせていただく次第です。\nお忙しいところ恐縮ですが、ご検討ください。\n\nななかさんのOCちゃん(黒髪の子、桃色髪の子のどちらでもOKです)が、下記参考のような顔出し着ぐるみを着ているイラストをお願いします。\n着ぐるみ参考：https://imgur.com/a/LlFJD70\n\nまた、着ぐるみについて、可能な範囲で下記のようにしていただきたいです。\n・着ぐるみの下は白い全身タイツ着用\n・直近の納品物である、納豆着ぐるみヒアンシーのようにガニ股になって足が露出している\n　参考作品：https://skeb.jp/@Nanahoshi_7ka/works/33\n\n表情は恥じらいを感じながら笑顔のもので、\nポーズについては参考のようなもので、難しければそれ以外のものでも問題ございません。\nまた、髪無しの差分もいただきたいです。\n(無論ですが、運用方針の通りすべてに応えていただかなくて問題ございません)\n\n希望が多くなってしまい申し訳ございませんが、是非よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/35", "thumbnail_src": "https://si.imgix.net/8fbfd279/uploads/origins/fda4a09d-abcf-4ac0-852d-48af64956c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a0fabd648f5ebb5615999a69d76ab7", "thumbnail_srcset": "https://si.imgix.net/8fbfd279/uploads/origins/fda4a09d-abcf-4ac0-852d-48af64956c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a0fabd648f5ebb5615999a69d76ab7, https://si.imgix.net/8fbfd279/uploads/origins/fda4a09d-abcf-4ac0-852d-48af64956c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2346a65752f7ccc988144d7b24eb55b7 2x, https://si.imgix.net/8fbfd279/uploads/origins/fda4a09d-abcf-4ac0-852d-48af64956c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f176115fa91e60fca3c14f71d4db2663 3x", "genre": "art", "nsfw": true, "body": "ゼンレスゾーンゼロよりシードのラバーだるまをお願いします。\nラバーだるまの色は水色で大きさや形状はこのイラストと同じように少し小さめでお願いします。資料の形や大きさが自分の理想に近いのでマジでそのまんま同じもの使うレベルで大丈夫です。\nhttps://x.com/NanahoshiNanaka/status/1907338699614101965\nラバーだるまに何かしらの模様があれば嬉しいです。個人的には機械っぽい模様をイメージしていますが描きやすいものを自由に描いてください。イメージとしてはこれが一番近いです。\nhttps://x.com/NanahoshiNanaka/status/1862436347182547031\nそれとこれはそんなに拘ってないので自由でいいのですが、ぎゅうぎゅうだと安心するらしいのでシードの表情は照れというよりほんの少しだけ驚いてるもしくは平常心のどちらかをイメージしてます。\nもしよろしければご検討のほうお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/34", "thumbnail_src": "https://si.imgix.net/b6a81cb3/uploads/origins/1be21084-2c34-474f-9849-b0ffc668a001?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0731e040c028ba2a685da3f087746c10", "thumbnail_srcset": "https://si.imgix.net/b6a81cb3/uploads/origins/1be21084-2c34-474f-9849-b0ffc668a001?bg=