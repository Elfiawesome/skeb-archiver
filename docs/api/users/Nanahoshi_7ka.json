と同様な形でお願いします。\nラフ垢なので出来ればで良いですがさなみさんの作品の様に納豆臭が出ていてそれに嫌がっている表情や、差分が欲しいです。\n\nさなみさんの納豆着ぐるみのpixivのリンクです。 https://www.pixiv.net/artworks/105228571 https://www.pixiv.net/artworks/103418464 https://www.pixiv.net/artworks/99969956\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/32", "thumbnail_src": "https://si.imgix.net/75f8569c/uploads/origins/0d73bcb1-c20d-41e9-8a92-98cd0eaab308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68e9ad04d949eb11359b3e294298c477", "thumbnail_srcset": "https://si.imgix.net/75f8569c/uploads/origins/0d73bcb1-c20d-41e9-8a92-98cd0eaab308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68e9ad04d949eb11359b3e294298c477, https://si.imgix.net/75f8569c/uploads/origins/0d73bcb1-c20d-41e9-8a92-98cd0eaab308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7122cf8cc2570d9e5678c9119279725c 2x, https://si.imgix.net/75f8569c/uploads/origins/0d73bcb1-c20d-41e9-8a92-98cd0eaab308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=532179309055a7820ba3f174d4038186 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Nanahoshi_7ka/works/31", "thumbnail_src": "https://si.imgix.net/3b8cb4d7/uploads/origins/9d24cc0a-6a24-4fbb-aa65-a896a1ccb4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9002cff3bf2523f81a6f3764e74212b0", "thumbnail_srcset": "https://si.imgix.net/3b8cb4d7/uploads/origins/9d24cc0a-6a24-4fbb-aa65-a896a1ccb4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w