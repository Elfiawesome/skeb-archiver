.net/073d1072/uploads/origins/a9a3c237-c7fa-4d5b-ad7b-d2ce78b9053d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da8b6cee7737e035ef57bf0fd3225d58, https://si.imgix.net/073d1072/uploads/origins/a9a3c237-c7fa-4d5b-ad7b-d2ce78b9053d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c01a08a2ac297a7188b7433861030ad4 2x, https://si.imgix.net/073d1072/uploads/origins/a9a3c237-c7fa-4d5b-ad7b-d2ce78b9053d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50b9754a4332f5ff3fb9ed4dea2eccbd 3x", "genre": "art", "nsfw": false, "body": "あらためまして、こんにちは、Vtuberとして活動をしているケルベロス鳥と申します。、私、ケルベロス鳥のキービジュアルを作成してもらいたいと思い、依頼しました。案や構図はすでに考えていますが、私自身絵などがあまり得意なものではないので、わかりにくかったら、バツ子様の想像に任せてもらって構いません。\nキャラの美しさを引き立てた作品になるよう願っております。", "created_at": "", "completed_at": ""}, {"path": "/@__Black_Xko__/works/13", "thumbnail_src": "https://si.imgix.net/b51ed4f1/uploads/origins/8ffdbdf1-534b-4516-894b-9bae65a38b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42cce6707b781e0066a289e1ee9f8f13", "thumbnail_srcset": "https://si.imgix.net/b51ed4f1/uploads/origins/8ffdbdf1-534b-4516-894b-9bae65a38b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42cce6707b781e0066a289e1ee9f8f13, https://si.imgix.net/b51ed4f1/uploads/origins/8ffdbdf1-534b-4516-894b-9bae65a38b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c7bb6f641e5d4983be3659dd41d8f7a 2x, https://si.imgix.net/b51ed4f1/uploads/origins/8ffdbdf1-534b-4516-894b-9bae65a38b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce997bbc10db8a036d6ea34483181f6a 3x", "genre": "art", "nsfw": false, "body": "こんばつぅ～！！('ω'乂)\n超絶カッコいい男装令嬢ソルト伯爵（TS) を頼む。\n\n■髪型\nオリジナル通り\n■ポーズ\n顎クイ\n■服装\n白のスーツ\n\nhttps://twitter.com/VirtualG11/status/1526522013463916544?s=20&t=0hXgJKx0hZFTUSaCRm_F5w", "created_at": "", "completed_at": ""}, {"path": "/@__Black_Xko__/works/12", "thumbnail_src": "ht