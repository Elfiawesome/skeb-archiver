fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2d23afbd521a0a3671a3b9ac82b2f44, https://si.imgix.net/dbe7dc00/uploads/origins/b89ae050-5744-449f-aeee-bf3ed151441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfc1279a18fed04eb14c95347f208148 2x, https://si.imgix.net/dbe7dc00/uploads/origins/b89ae050-5744-449f-aeee-bf3ed151441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7cdcc526b0a5974a7393d94f351b3f9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mebi_mea/works/3", "thumbnail_src": "https://si.imgix.net/d9f68e1d/uploads/origins/a81fa842-3856-4e06-9517-82329733d054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6dc47367d448c4ed53338717e8a3395b", "thumbnail_srcset": "https://si.imgix.net/d9f68e1d/uploads/origins/a81fa842-3856-4e06-9517-82329733d054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6dc47367d448c4ed53338717e8a3395b, https://si.imgix.net/d9f68e1d/uploads/origins/a81fa842-3856-4e06-9517-82329733d054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e5e02beffc77f80cb6d20a921a1026e 2x, https://si.imgix.net/d9f68e1d/uploads/origins/a81fa842-3856-4e06-9517-82329733d054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45dd3e452d7ca5ab1385f6f3fcba5a75 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mebi_mea/works/2", "thumbnail_src": "https://si.imgix.net/d8bd811e/uploads/origins/e36960f8-496b-4ed6-985e-07f88443f6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6551accd6549ef9ca46fc2077f8713c1", "thumbnail_srcset": "https://si.imgix.net/d8bd811e/uploads/origins/e36960f8-496b-4ed6-985e-07f88443f6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6551accd6549ef9ca46fc2077f8713c1, https://si.imgix.net/d8bd811e/uploads/origins/e36960f8-496b-4ed6-985e-07f88443f6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16522cf866a314dedd3d8c54f128ca74 2x, https://si.imgix.net/d8bd811e/uploads/origins/e36960f8-496b-4ed6-985e-07f88443f6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f472cb7fd7860b231f7b8bffcaf2d683 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nAgape先生の作品を新着クリエイターで拝見して\nしっとりした腋や美しいお姉さんの描写に一目惚れしました！\n先生の絵柄でぜひ描いていただきたいキャラとシチュがあるので、\nもしお時間と作業量で可能でしたら、イラストのご依頼をさせていただけると嬉しいです。\n\nリクエストですがメギド72のアスモデウス(資料url参照)のR18イラストになります。\nまた納品形式はPSDでお願いしたいです。\n(アスモデウスのキャラ設定としては自分が絶対的な存在であると強く認識しており、\n実際それに見合った実力の持ち主で、強大な力と尊大な態度、\n美しく強靭な肉体を持ち合わせる、誇り高き性格の持ち主となります。）\n\nシチュエーションとしては現代もので、転生したアスモデウスは居候しており\nその家には少年(性知識はあるけど大人しいよくも悪くも普通の子)が同居しています。\n普段からヒールなしで186cmの態度も尻もデカい銀髪爆乳デカ乳筋肉質汗臭なアスモさんの姿に\n少年は悩まされて悶々とした日々を過ごしており\n夏の暑い中眠りこけているアスモデウスの豊満な胸やデカ尻を前に\nついに我慢できなくなった少年がアスモデウスの下着を脱がして、\nおま〇こに挿入して腰を振ってるところをお願いします。\n少年目線のハメ撮り風で汗でムレムレの腋が見えるような体位で描いてほしいです\n\n差分として途中で目を覚ますものの母性本能をくすぐられて\n「かわいいな♥」と気づかないふりをしたり\n少し顔を赤らめて吐息を漏らす様子や\n「私の扱いについて教えてやる…もっと来い♥」と少年を挑発したものの\n少年に欲望をぶつけられて耐えきれず\n「なんだこれは？…お゛❤️んほっ！？❤️こ…この程度…私を甘く見るな❤️」と感じ始め\n最後にはオホ声アヘ顔で子宮をしつけられて\n無様に絶頂してしまう描写をお願いしたいです。\n台詞はアレンジしていただいて構いませんが\n後半になるにつれてハートマーク多めでお願いしたいです。\n\nまた服装はソシャゲキャラなので資料には進化別外見、アレコス等がありますが\n原作衣装ではなく現代風のラフな感じでお願いしたいです。\n(詳細についてはおまかせします。全裸でも構いません)\n\n他指定のない事項についてもおまかせしたいです。\nお忙しい中とは存じますが、ご一考の程宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ilC97vq9s5v4zgq15MmU5muX8DcmWyyX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mebi_mea/works/1", "thumbnail_src": "https://si.imgix.net/7e6b08c1/uploads/origins/4087e14a-e764-4f89-817b-add5c809c015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=992f35f9dc6b62491b8adb1e4ac7a250", "thumbnail_srcset": "https://si.imgix.net/7e6b08c1/uploads/origins/4087e14a-e764-4f89-817b-add5c809c015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=992f35f9dc6b62491b8adb1e4ac7a250, https://si.imgix.net/7e6b08c1/uploads/origins/4087e14a-e764-4f89-817b-add5c809c015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5745b213a7306dfbcaefeb5d9e86edc8 2x, https://si.imgix.net/7e6b08c1/uploads/origins/4087e14a-e764-4f89-817b-add5c809c015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a235fe6100fcf5c92a014d038bc6b0e6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}