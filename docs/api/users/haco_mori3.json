バトルパートナーです。\n太陽の下、芝生の上で寝そべって休んでいる二人を描いていただければと思います。シーンの細部、姿勢、パースなどはあなたのお好みでどうぞ。\nご迷惑をおかけしますが、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@haco_mori3/works/19", "thumbnail_src": "https://si.imgix.net/bd3acc40/uploads/origins/39c845d9-0c91-4c32-95b6-aa637836440f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dde83fb429ea4694adb6b8fa434dbe2", "thumbnail_srcset": "https://si.imgix.net/bd3acc40/uploads/origins/39c845d9-0c91-4c32-95b6-aa637836440f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dde83fb429ea4694adb6b8fa434dbe2, https://si.imgix.net/bd3acc40/uploads/origins/39c845d9-0c91-4c32-95b6-aa637836440f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=042dcde96e045f7c1524a3931be89058 2x, https://si.imgix.net/bd3acc40/uploads/origins/39c845d9-0c91-4c32-95b6-aa637836440f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b00f465a97495256ef8df11ae9ab568 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haco_mori3/works/18", "thumbnail_src": "https://si.imgix.net/34c8c922/uploads/origins/a0405434-e09b-4233-93ec-e2b0ff0c173c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed4efc87d045f5b32bb46222438aec5", "thumbnail_srcset": "https://si.imgix.net/34c8c922/uploads/origins/a0405434-e09b-4233-93ec-e2b0ff0c173c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed4efc87d045f5b32bb46222438aec5, ht