33216aa7/uploads/origins/4562f79f-63a5-4532-8eb8-33cea137baa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28679e15ca82d120228c9cf51a399b40 2x, https://si.imgix.net/33216aa7/uploads/origins/4562f79f-63a5-4532-8eb8-33cea137baa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3607511b1d4e2baa56beb905a7d2541 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marimuu026/works/17", "thumbnail_src": "https://si.imgix.net/812e4660/uploads/origins/11aeceeb-32d6-41e5-9920-3bb42d558018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489ce5f7ea5073339de67992329bad69", "thumbnail_srcset": "https://si.imgix.net/812e4660/uploads/origins/11aeceeb-32d6-41e5-9920-3bb42d558018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489ce5f7ea5073339de67992329bad69, https://si.imgix.net/812e4660/uploads/origins/11aeceeb-32d6-41e5-9920-3bb42d558018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcd528ec4ae0cc719f15faea233358ed 2x, https://si.imgix.net/812e4660/uploads/origins/11aeceeb-32d6-41e5-9920-3bb42d558018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adbe6c8f027f5bfd7c8f7145cff40992 3x", "genre": "comic", "nsfw": false, "body": "あなたの絵がとても好きです！私のオリジナルキャラクターを描いていただけませんか？このイラストは個人使用のみです。\n\nモダンなオフィスの一室が舞台です。\nキャラクター（1）：「やんちゃで上品な女性「ミニー\n登場人物（2）：  働き者の作家 \"リー\"\n\n「リーは椅子に座り、あくびをしながら仕事に疲れている様子だ。誰かがテーブルの上にコーヒーカップを置くと、彼女はびっくりする。振り向くと、\"ミニー \"が微笑んでいる。「ミニー」は「今日はお休みね」と言う。そして彼女は「リー」を両腕で包み込むように抱きしめる。「でも、私たちと一緒に過ごすのよ」。「リーは少し顔を赤らめ、恥ずかしそうにしている。ミニー \"が「ありがとう！」と言うと、二人は笑顔になり、シーンはハッピーになる。\n\nhttps://drive.google.com/drive/folders/1S3FLUj03cvaAXkbSgb7JzdBXR6liLhm1?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@marimuu026/works/16", "thumbnail_src": "https://si.imgix.net/9f2d6915/uploads/origins/4a325620-c9aa-4b35-bf16-f36430c21a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=464a43c9df2198f7e3e3e70d8ceb7622", "thumbnail_srcset": "https://si.imgix.net/9f2d6915/uploads/origins/4a325620-c9aa-4b35-bf16-f36430c21a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=464a43c9df2198f7e3e3e70d8ceb7622, https://si.imgix.net/9f2d6915/uploads/origins/4a325620-c9aa-4b35-bf16-f36430c21a63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e62978894e23ab006d2425631ffb935 2x, https://si.imgix.net/9f2d6915/uploads/origins/4a325620-c9aa-4b35-bf16-f36430c21a63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ae615efbad7f4074b6e5d59a5879d64 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marimuu026/works/15", "thumbnail_src": "https://si.imgix.net/a76658eb/uploads/origins/16e7dad9-13dc-496d-aeb7-e690bc3ba8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82b080567123c9aa9a7ddc94e0a6f20b", "thumbnail_srcset": "https://si.imgix.net/a76658eb/uploads/origins/16e7dad9-13dc-496d-aeb7-e690bc3ba8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82b080567123c9aa9a7ddc94e0a6f20b, https://si.imgix.net/a76658eb/uploads/origins/16e7dad9-13dc-496d-aeb7-e690bc3ba8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d258c070f2cf34ac2832e7a4a4886427 2x, https://si.imgix.net/a76658eb/uploads/origins/16e7dad9-13dc-496d-aeb7-e690bc3ba8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3788c478538fceb8fa57f2c0cda387 3x", "genre": "comic", "nsfw": false, "body": "先生こんにちは、ミリオンライブも間もなく十周年ですが、年齢が同じく十年間も経ったまつともが見たいです！（徳川まつり（29）×天空橋朋花（25））\n 朋花眼鏡をかけていて、 そして二人の指には、全部一対となった指輪をつけています。 \nストーリーは、お二人が同居になった後、夜にベッドに一緒に寝ていて、そして二人は全て散髪の様子で、横になって本を読んでいます。続いて読むと、まつりは既に半分読みっぱなしで寝てしまった朋花のことに気付きました。まつりは思わず笑って、相手のメガネを取ってあげてもう少し見つめて、「この子は本当に寝る時だけは全く無防備ですね」と思っていて、相手に布団をかけてあげて、電気を消して一緒に寝ました。\n他の内容は先生にご自由に任せてください!", "created_at": "", "completed_at": ""}, {"path": "/@marimuu026/works/14", "thumbnail_src": "https://si.imgix.net/b545acaa/uploads/origins/47c5d514-3322-476a-97ce-a5dafd008502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4db9af981c41d4dce57160e974be98c", "thumbnail_srcset": "https://si.imgix.net/b545acaa/uploads/origins/47c5d514-3322-476a-97ce-a5dafd008502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4db9af981c41d4dce57160e974be98c, https://si.imgix.net/b545acaa/uploads/origins/47c5d514-3322-476a-97ce-a5dafd008502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dca938e7b3246cc9a7737b00014c1347 2x, https://si.imgix.net/b545acaa/uploads/origins/47c5d514-3322-476a-97ce-a5dafd008502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4239afa98aeaac07090bbcf617c4784d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、最近あなたの漫画を読みました！私のキャラクターについての短いマンガをリクエストしてもいいですか？\n\nキャラクター\n\nアイリス：普段はのほほんとしていてクールだが、たまにドジでおちゃめなところもある。\nhttps://drive.google.com/drive/folders/1aM5GiMo-GXzKwTPRsCpICPHVvCa4yVDL\n\nリスキー : 表情豊かで、人をからかうのが大好き。胸がとても大きい。サメの歯もある。\nhttps://drive.google.com/drive/folders/1sbDTDqGvbd5Kdy_Ym3ZnzqWvkRi1IGlY\n\nシナリオ\n\n今日はアイリスリスの誕生日。リスキーは妹なので、アイリスリスを起こし、ベッドで朝食をとって驚かせます。それから二人は外に出て写真を撮る。写真を撮った後、二人はデザートカフェに行き、ケーキとバナナミルクセーキを食べてお祝いをする。満月が出て、夜になった。リスキーは月を背にアイリスの前に行き、最後にアイリスの誕生日を祝う。リスキーには、明るい笑顔で大きなハグをしてもらいたい。", "created_at": "", "completed_at": ""}, {"path": "/@marimuu026/works/13", "thumbnail_src": "https://si.imgix.net/25afb474/uploads/origins/b4847d23-0287-4b11-a4eb-5af79995089d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e693a3327d80d3077b1fb929ff5a00a1", "thumbnail_srcset": "https://si.imgix.net/25afb474/uploads/origins/b4847d23-0287-4b11-a4eb-5af79995089d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e693a3327d80d3077b1fb929ff5a00a1, https://si.imgix.net/25afb474/uploads/origins/b4847d23-0287-4b11-a4eb-5af79995089d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9808fc7c02ee73f2ab32809567e890e 2x, https://si.imgix.net/25afb474/uploads/origins/b4847d23-0287-4b11-a4eb-5af79995089d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=586c67b9b119049fd4d66d15e54b2367 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@marimuu026/works/12", "thumbnail_src": "https://si.imgix.net/26963eef/uploads/origins/88612da1-0151-484b-9ac5-f54a64ce595c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=067e0fef2bb73c2967d84f18c84c696a", "thumbnail_srcset": "https://si.imgix.net/26963eef/uploads/origins/88612da1-0151-484b-9ac5-f54a64ce595c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=067e0fef2bb73c2967d84f18c84c696a, https://si.imgix.n