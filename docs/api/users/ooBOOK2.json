.net/9c3bd1df/uploads/origins/b821833f-369c-4c0e-8a79-f40a7eb51bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=525d97a194492c677642f27fe81ef242, https://si.imgix.net/9c3bd1df/uploads/origins/b821833f-369c-4c0e-8a79-f40a7eb51bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9235890e5481b7f9c8c606de1093423e 2x, https://si.imgix.net/9c3bd1df/uploads/origins/b821833f-369c-4c0e-8a79-f40a7eb51bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92b5ae233a0a8eb0c10de77a679ac281 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ooBOOK2/works/57", "thumbnail_src": "https://si.imgix.net/61febbf2/uploads/origins/f8be0001-8045-4de8-afe6-2f4ddbfd56a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ad005ef7222ed2bf55916512b00d74", "thumbnail_srcset": "https://si.imgix.net/61febbf2/uploads/origins/f8be0001-8045-4de8-afe6-2f4ddbfd56a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ad005ef7222ed2bf55916512b00d74, https://si.imgix.net/61febbf2/uploads/origins/f8be0001-8045-4de8-afe6-2f4ddbfd56a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d4568d1b72c85d67dcb2acc1fcce363 2x, https://si.imgix.net/61febbf2/uploads/origins/f8be0001-8045-4de8-afe6-2f4ddbfd56a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=807738f75fe93acf38982f5f762c01f5 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ 以前はリクエストに対応してくださりありがとうございました。今回もリクエストを送らせて頂きました。  \n\n【キャラクター】 \nCHUNITHMより、MIR-203【セレネ・シェリル】をお願いします。 \n\n 【内容】 \n下記リクエストの続きにあたる内容です。引き続き催眠による偽りの純愛となります。\nhttps://skeb.jp/@ooBOOK2/works/47\n\n青年の催眠により相思相愛のカップルとなり身体を重ねてきたシェリル。とうとう青年との結婚式を挙げ、そのまま新婚初夜えっちに入る…\n\n以下、話の流れのイメージ\n1.前戯。青年はシェリルの乳房や乳首を弄くり回したりキスしたり等おこなう。対するシェリルは青年から乳の大きさを褒められ、最愛の人に身体を捧げる喜びを感じつつ身を委ねる。\n\n2.正常位での本番えっち。激しい突きにすっかり興奮しているシェリルは青年の精子をねだる。\n\n3.事後の余韻に浸るシェリル。ふと催眠が解けそうな感じが過るが、最愛の人との結婚&えっちの前に何事もなく過ぎ去り、これからも青年を愛することを誓う…\n\n 【補足】 \n・結婚式を挙げたということで衣装はブライドフォームでよろしくお願いします。\n\n内容は以上です。 検討の方をよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ooBOOK2/works/56", "thumbnail_src": "https://si.imgix.net/5dd0467c/uploads/origins/2be722bd-5baf-4379-986f-ae39dccd13b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b33a21c917322a90101bed9a0756d4", "thumbnail_srcset": "https://si.imgix.net/5dd0467c/uploads/origins/2be722bd-5baf-4379-986f-ae39dccd13b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b33a21c917322a90101bed9a0756d4, https://si.imgix.net/5dd0467c/uploads/origins/2be722bd-5baf-4379-986f-ae39dccd13b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6a001f12776218e562763690ce43c6a 2x, https://si.imgix.net/5dd0467c/uploads/origins/2be722bd-5baf-4379-986f-ae39dccd13b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c73d2a3b1b31b7b63de3d4c1986a4752 3x", "genre": "comic", "nsfw": true, "body": "失礼致します。ウッタカッタさんの叡智な画風に惹かれましたので依頼させていただきます！\nよろしければ、閃乱カグラの玉響さんの催眠連続ディルドオナニーをお願い致します！\n・服装\nシノビマスターの玉響（新乳祭）の水着衣装で、目隠しも同じ水着衣装のものでお願い致します！黒い陰毛多めで、へそ下まで伸びるギャランドゥでお願い致します！\n・シチュ\n催眠おじさんに催眠され、ラブホでひたすら蟹股ディルドオナニーをされられ何度も絶頂し、身体に快楽を覚えさせられてしまう…。\n催眠おじさんは声だけで大丈夫です。\nポーズとしては、玉響さんがベッドを背に背筋を伸ばして膝を少し曲げた浅いガニ股ポーズでﾋﾞｷﾆｼｮｰﾂをずらして太いバイブディルドをおまんこにぐっぽり咥え込み、片手でディルドを押さえながら、片手でデカクリをコリコリといじり絶頂。こちらに背を向け、高めのベッドの端に右足を乗せながら背筋を伸ばしつつ右手でディルドをｽﾞﾎﾞｽﾞﾎﾞﾋﾟｽﾄﾝし腰をﾍｺﾍｺさせ絶頂。最後はベッドに仰向けになり、パンツinバイブ状態で大の字足ﾋﾟﾝ舌出し仰け反りアクメをお願い致します!\n他に良さそうなポーズがあれば追加いただいて構いません！\n台詞やその他はお任せ致します!なるべく無様な感じだと嬉しいです!\nよろしければお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@ooBOOK2/works/55", "thumbnail_src": "https://si.imgix.net/