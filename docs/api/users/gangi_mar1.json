ze=30&txt=PRIVATE&s=e1beb1897b6c4d6751beed2fb1a2a382, https://si.imgix.net/e43f150e/uploads/origins/6f4db21b-8ea0-41c4-9fe2-e9114178835c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75b347855fbc7d2cb0297b6db85639b3 2x, https://si.imgix.net/e43f150e/uploads/origins/6f4db21b-8ea0-41c4-9fe2-e9114178835c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f204c9d065d786cceae7eaf93593dfd5 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gangi_mar1/works/3", "thumbnail_src": "https://si.imgix.net/d6c235b9/uploads/origins/8f129804-49fc-426a-aa02-e1db310e703a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dea6be51103da9a67316aa2bb2532aef", "thumbnail_srcset": "https://si.imgix.net/d6c235b9/uploads/origins/8f129804-49fc-426a-aa02-e1db310e703a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dea6be51103da9a67316aa2bb2532aef, https://si.imgix.net/d6c235b9/uploads/origins/8f129804-49fc-426a-aa02-e1db310e703a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbac25c234e948e8adcbea213aa5bb17 2x, https://si.imgix.net/d6c235b9/uploads/origins/8f129804-49fc-426a-aa02-e1db310e703a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce9fed5c4b2a73005ae04333fbce6036 3x", "genre": "art", "nsfw": true, "body": "資料の件、失礼致しました。\n過去作品へのリンクでなく、キャラと服装のリンクに変更して再送致します。\nキャラ:フラワーナイトガール(花騎士)のナデシコ(末尾リンク参照)\n服装:パラレル学園(現代パロ)の下記リンク制服\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%A2%E3%83%8D%E3%83%A2%E3%83%8D%28%E3%83%91%E3%83%A9%E3%83%AC%E3%83%AB%E5%AD%A6%E5%9C%92%29\n(キャラなどはミリ知らで大丈夫です。敬語を使う清楚な娘という扱い程度で大丈夫です)\nこの形にていろんな方にえっちぃシチュを描いて頂きましたが、今回はその先を想定したシチュです。\n\nざっくりシチュ:過去の数々の恥辱で開発された身体の疼きを抑えきれず、ついに自分の意志で身体を差し出す\n\n描写としてはマンガのようなコマ割り、というよりはハイライトみたいに複数の場面を配置するような構成になるかと思います。大まかな流れ・構図としては、\n①キャラ立ち絵。いけないことと分かっている表情をしつつも頬は紅潮＆内ももから愛液が垂れており、身体はその先を期待してしまっている。か細く「ごめんなさい…でも私…」と誰に向けるでもなく呟いている。\n②服を着たままパンツに手を入れられ乱暴に手マンされる。期待して出来上がった身体は簡単に仰け反り絶頂する。\n③スカート残しで背面駅弁(orフルネルソン)。ペニスでGスポットを擦られ潮吹きアクメ。\n④ベッドの上でロールスロイス。ドチュドチュと最奥を強く突かれ頭がパチパチ弾ける様子。「あ゛ッッ」「お゛ッッ」「ま゛たイ゛グゥ!!!」など清楚さゼロの濁点混じりの大きな喘ぎ声を出しながら連続アクメ(顔が正面に見える形がいいです)。\n⑤事後。仰向けで何度もアクメしたトロアへ顔を晒しながらビクビクと余韻イキしており、股間からは何度も出された精液が流れ出ている。\n\n以上のご検討をよろしくお願い致します。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8A%E3%83%87%E3%82%B7%E3%82%B3", "created_at": "", "completed_at": ""}, {"path": "/@gangi_mar1/works/2", "thumbnail_src": "https://si.imgix.net/0f3482f0/uploads/origins/cf85dd7e-382e-4a3b-be4d-afeebdfbe388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c5a749b315941b03f6c014b5c2b6357", "thumbnail_srcset": "https://si.imgix.net/0f3482f0/uploads/origins/cf85dd7e-382e-4a3b-be4d-afeebdfbe388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c5a749b315941b03f6c014b5c2b6357, https://si.imgix.net/0f3482f0/uploads/origins/cf85dd7e-382e-4a3b-be4d-afeebdfbe388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6c8a40457f8c4bea97dfb6ed5f34eb0 2x, https://si.imgix.net/0f3482f0/uploads/origins/cf85dd7e-382e-4a3b-be4d-afeebdfbe388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=666f912d6686671abb01c06c677b51ba 3x", "genre": "art", "nsfw": true, "body": "おっきい胸が最高だったので可能な範囲でお願いします！\n書くかも程度ですがSSの挿絵に利用したいです\nシチュ：着衣超魔乳&特大着衣ボテ腹姿のアリア&シルクにゴミを見るような冷めた目(ハイライト無し、顔上部に影有)で嫌悪され見下されながら、、異形の咥内orえぐい構造をした肉塊オナホを見せつけられるドMホイホイシチュ\n二人とも表情は顔上部に影が掛かり瞳のハイライト無しでゴミを見る冷めた目で変態マゾを嫌悪・侮蔑しており、\n咥内や舌(もしくは持ってるオナホ)が、精液を搾り尽くすための肉襞やイボイボ満載の唾液たっぷりの搾精器官になっており、これから搾精される感強めのドMホイホイ向けでお願いします\n片乳だけで両手が簡単に沈む、頭&胴体以上サイズかつ服越しでも(アリアはピンク色の透け)勃起乳首がわかる着衣超魔乳と\n超乳と同サイズの淫紋付き特大着衣ボテ腹姿で、服の中にギチギチに押し込まれた胸やボテ腹が強調された大きさとポーズで、\nまた全身が粘液でドロドロで衣服が肌に貼りついていたり、異形の咥内からどろどろの特濃粘液を溢れさせて超乳の谷間に粘液溜りが出来ている描写を希望します\n\npsd形式希望で、可能であれば周囲は肉壁or禍々しいorダーク系希望、もしできれば射精後(精液ぶっかけ)差分や擬音差分、\n上記より優先度低で(異形の咥内やオナホに興奮して射精する)変態マゾへの嫌悪・侮蔑台詞(キャラ付けや口調等は完全にお任せします)の有無差分が行けそうでしたらお願いします\n\nキャラ参考：\nhttps://drive.google.com/drive/folders/1APuwOvZqgXD5NCxftu0mWnMvrkocLBfq?usp=sharing\n\nシチュ参考：\n\nhttps://drive.google.com/drive/folders/1s4LWzA1ha8QvAhCmZGOXCT0_cd9JscKU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gangi_mar1/works/1", "thumbnail_src": "https://si.imgix.net/09219417/uploads/origins/16696e53-4073-46f3-81e3-b394a9f8d954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=896f0ef12fbdcaf686e59ada4362266d", "thumbnail_srcset": "https://si.imgix.net/09219417/uploads/origins/16696e53-4073-46f3-81e3-b394a9f8d954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=896f0ef12fbdcaf686e59ada4362266d, https://si.imgix.net/09219417/uploads/origins/16696e53-4073-46f3-81e3-b394a9f8d954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=139307f0fcbf2425dc93eb469365369e 2x, https://si.imgix.net/09219417/uploads/origins/16696e53-4073-46f3-81e3-b394a9f8d954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7966f24c028c4e5be0ceae5d0cdbcb63 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}