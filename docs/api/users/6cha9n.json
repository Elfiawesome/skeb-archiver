f-4af8-9dd1-4dceb24e79cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a3facbbf355e8e99e994964c75d5902", "thumbnail_srcset": "https://si.imgix.net/137549fa/uploads/origins/8b618af1-f73f-4af8-9dd1-4dceb24e79cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a3facbbf355e8e99e994964c75d5902, https://si.imgix.net/137549fa/uploads/origins/8b618af1-f73f-4af8-9dd1-4dceb24e79cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df3435e1754a2f6706abe1880d87cbc 2x, https://si.imgix.net/137549fa/uploads/origins/8b618af1-f73f-4af8-9dd1-4dceb24e79cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1afe17c5a786d00ff0caaefd5abea90 3x", "genre": "art", "nsfw": false, "body": "りょくちゃくんさんこんばんは！はると申します。いつも可愛い絵柄に癒されています🙏✨\n\nうちの子レヴィくんが身体よりも遥かに大きな巨大風船2つに押しつぶされてしまい、可愛い表情を見せながら風船圧迫を楽しんでしまう姿を是非りょくちゃくんさんの絵柄で見てみたいです！\n巨大風船に身体を挟まれる構図・風船の膨張音や摩擦音といった擬音などのその他の要素は全てりょくちゃくんさんにお任せいたします。\n\nまた、レヴィくんの設定資料は以下のツイートとなります。\nhttps://x.com/Levinflate/status/1443965515337138177?s=20\n\n拙い文章で申し訳ないですが、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@6cha9n/works/1", "thumbnail_src": "https://si.imgix.net/8ccb6db1/uploads/origins/2bdc145e-cc3e-4ece-b83e-bb79bdd07bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d32a37d4c40bc0a8d70ba794e9138d3", "thumbnail_srcset": "https://si.imgix.net/8ccb6db1/uploads/origins/2bdc145e-cc3e-4ece-b83e-bb79bdd07bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d32a37d4c40bc0a8d70ba794e9138d3, https://si.imgix.net/8ccb6db1/uploads/origins/2bdc145e-cc3e-4ece-b83e-bb79bdd07bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7b8b990064389ccbdec73f5e89e4cac 2x, https://si.imgix.net/8ccb6db1/uploads/origins/2bdc145e-cc3e-4ece-b83e-bb79bdd07bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c7a9b208dd979e429071954b6c2875f 3x", "genre": "art", "nsfw": true, "body": "ここでリクエストして良いのか迷いましたが、@6taonaka アカウントの存在を明かしているツイートを確認しましたので書かせていただきます。\n\n資料URLの作品を大変気に入っており、是非とも以下の差分を頂きたいです。\n１．少しズームアウトする（上記作品をそのまま上下左右を延長する形で大丈夫です。）\n２．前項に続き、両サイドからの押し付けが強くなる↗↙\n３－１．前項に続き、グレイエルさんが前方のオブジェクトに口をうずめ、射精する\n４－１．前項の事後、両サイドが少し離れ↙↗、後方のオブジェクトに精液がべっとり付いて糸を引いているのが見える（グレイエルさんは前方のオブジェクトに抱きついたまま）\n３－２．「３－１」の射精音を消したバージョン\n４－２．「４－１」の精液を消したバージョン\n\nすなわち、以下の2組のシナリオを想定しております。\n性的シナリオ：１．➡２．➡３－１．➡４－１．\n健全シナリオ：１．➡２．➡３－２．➡４－２．\n\n希望するポイントとしては以下の通りです。\n・１～４でアングルは固定する（故に性器は描画不要です。）\n・３～４で涙が出ている\n\n性的表現を見せたくない場合、psdにまとめての納品をご検討ください。\n\n以上、何卒よろしくお願いいたします。\n\nhttps://twitter.com/6taonaka/status/1455807573022547972", "created_at": "", "completed_at": ""}]}