/f69d4e7b-3f5a-4175-b5f9-49e2b48b3dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16e2358a709bcdc25b4db97bf3447743 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@horo_27/works/17", "thumbnail_src": "https://si.imgix.net/743abdf6/uploads/origins/6c53b2c1-b747-4314-8c0f-a0818f7a57d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3432a52f1cace9f0e1f321d2d639f1b", "thumbnail_srcset": "https://si.imgix.net/743abdf6/uploads/origins/6c53b2c1-b747-4314-8c0f-a0818f7a57d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3432a52f1cace9f0e1f321d2d639f1b, https://si.imgix.net/743abdf6/uploads/origins/6c53b2c1-b747-4314-8c0f-a0818f7a57d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1eb1cb18025ee19cbb9f0540921ad67 2x, https://si.imgix.net/743abdf6/uploads/origins/6c53b2c1-b747-4314-8c0f-a0818f7a57d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e7c777c3f65736e63900a66e2d45253 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵がとても好きです！\n私のVtuberのキャラクターを描いてくれませんか？\n彼女は鳥（シマエナガ）で、花は赤い彼岸花です。\n\n海辺で水着を着ているところを描いてください。\nポーズや表情はお任せします。\n\n\n背景とサインはPSDファイルで分けてください。\nSNS、ストリーミング用です。\n\nhttps://drive.google.com/drive/folders/1VPJlaDYcRXjSVr6LOI5hkGWeRN04h8N6?usp=sharing\n\nhttps://drive.google.com/drive/folders/1VPJlaDYcRXjSVr6LOI5hkGWeRN04h8N6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@horo_27/works/16", "thumbnail_src": "https://si.imgix.net/6075901f/uploads/origins/688b06fa-e155-49e7-8cb3-bd9e0a3c184a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c61658a6e00cef2a2c42fb8ab7c441ed", "thumbnail_srcset": "https://si.imgix.net/6075901f/uploads/origins/6