6c8-40cef4b86fc3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a93e77dc4e3e75da9a423d1d2b611f2f, https://si.imgix.net/c8ba33b6/uploads/origins/54bf4bf3-c8d8-453f-86c8-40cef4b86fc3?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4df86bdc235a351ad059e29f333e60c 2x, https://si.imgix.net/c8ba33b6/uploads/origins/54bf4bf3-c8d8-453f-86c8-40cef4b86fc3?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=d52748e5e38767fd38fee6ba9be86cf7 3x", "genre": "art", "nsfw": false, "body": "初めまして、にゃるぅと申します。\nmariri様素敵なアピールありがとうございます。\nイラスト拝見させていただきました。\nとても透明感があって可愛いくて魅力的でしたので是非、私の推しのVTuber成世ななくも様を描いていただきたいです。\n\n\n内容\n・Vtuberの「成世ななくも」さんのイラスト（FA）をお願いしたいです。 本人了承済み。\n\n使用用途\n・成世ななくも様のVTuber活動、配信内（収益化済みYouTube）やサムネイル、SNS（X）、ファンBOXなどでのネットプリント、壁紙配布、グッズなどの使用許可をお願いしたいです。\n\n・ななくも様本人のみに使用許可をいただきたいです。\n\n・可能であれば背景と被写体のレイヤーが分かれている状態での納品を希望します。\n\n◎希望の構図内容\n・mariri様のアピールでご提案いただいた、サブカル衣装のななくもさんを見てみたいのでお願いしたいです。ポーズなどはmariri様のご自由に描いていただけると嬉しいです！\n\n・衣装アレンジやヘアアレンジ等あれば、mariri様の自由に描いていただきたいです。\n\n◎成世ななくもさん概要\nhttps://lit.link/nanakumo\n・イメージカラーは白と水色\n・雲が好き\n・日常や声の雰囲気がわかるもの\nhttps://twitter.com/NaruseNanakumo\nhttps://youtube.com/@NaruseNanakumo\n\n・三面図資料\n・新衣装＆くもちゃん\nhttps://drive.google.com/drive/folders/16r1808TRGK45wLiH39PIz1iiZqNOmmjU?usp=sharing\n・旧衣装（髪型差分込み）\nhttps://drive.google.com/drive/folders/1_auTsaZHuXiAZGwsUUNA147mCKJA6LDz?usp=sharing\n\n・問題があればリクエスト再送よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@rose_an_mary_/works/15", "thumbnail_src": "https://si.imgix.net/9b42f1c4/uploads/origins/47eeaa43-eb39-466e-a732-78817670abcc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=70b443e4fef66d80f0e2cb66af2c5656", "thumbnail_srcset": "https://si.imgix.net/9b42f1c4/uploads/origins/47eeaa43-eb39-466e-a732-78817670abcc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=70b443e4fef66d80f0e2cb66af2c5656, https://si.imgix.net/9b42f1c4/uploads/origins/47eeaa43-eb39-466e-a732-78817670abcc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=22b9163ced5b27152a0cd02581e4b1cf 2x, https://si.imgix.net/9b42f1c4/uploads/origins/47eeaa43-eb39-466e-a732-78817670abcc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb71c768c19c3bc49db58866143ebbc4 3x", "genre": "art", "nsfw": false, "body": "mariri┊ご依頼受付中様\n初めまして！\n\nskebへのアピールありがとうございます！\nVtuber準備中の星乃もふと申します！\n\n今回はアピールを頂いたので是非私のイラストを描いて頂きたくリクエストさせて頂きます！\n\n使用用途\nXやYouTube等のアイコンやサムネイル、Xでのポスト投稿\n\n描画範囲やポーズ、衣装などお好きに描いていただいて構いません！\n\nサムネイル等に使用したい為、頭や左右の見切れなど無いようにして頂けますと助かります！\n\nもし背景などがあれば人物と分かれたレイヤーも一緒に納品して頂けると助かります！\n\nまた、金額内で可能でしたらご提示頂いた表情差分や瞬きGIF等の差分も頂けたら嬉しいです！\n\n是非よろしくお願いします！\n\nhttps://x.com/hoshino_mofu/status/1978770479491035563?s=46&t=y40p3lhG0U7v2-2jO_E6aw", "created_at": "", "completed_at": ""}, {"path": "/@rose_an_mary_/works/14", "thumbnail_src": "https://si.imgix.net/b4b78f1c/uploads/origins/d89272cf-33b9-4823-a782-70224aed8319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57d91355176c5b5d0e9b5e097bd721a", "thumbnail_srcset": "https://si.imgix.net/b4b78f1c/uploads/origins/d89272cf-33b9-4823-a782-70224aed8319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57d91355176c5b5d0e9b5e097bd721a, https://si.imgix.net/b4b78f1c/uploads/origins/d89272cf-33b9-4823-a782-70224aed8319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a71b6f4c186195494048380b2d8d3e8 2x, https://si.imgix.net/b4b78f1c/uploads/origins/d89272cf-33b9-4823-a782-70224aed8319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e13c482e4d9dd202cd2cd80f2ea7c7e 3x", "genre": "art", "nsfw": false, "body": "アピール頂きありがとうございます！\n\n構図、衣装等々お好きなように描いていただけますか？\n\nSNS投稿や配信等に使用させていただきたいので、背景透過かPSDファイルで納品していただけると嬉しいです\n\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@rose_an_mary_/works/13", "thumbnail_src": "https://si.imgix.net/e7a042a7/uploads/origins/a719e671-0108-493e-ad98-d353e9211629?bg=%23fff