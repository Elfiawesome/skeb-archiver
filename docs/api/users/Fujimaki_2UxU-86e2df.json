ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a9d006a8f7aaf34ca04139f5e5d5df, https://si.imgix.net/4381c8fc/uploads/origins/2d0b85cf-afd9-43a5-8f43-93f6aebd5b05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c1041f061ea8e6a1ecd4b3fa9bc81dc 2x, https://si.imgix.net/4381c8fc/uploads/origins/2d0b85cf-afd9-43a5-8f43-93f6aebd5b05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92256d17f1fadfb1cce0101d41311411 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！\n前回、僕の魔女猫を描いてくれて本当に感動したよ！\n\n今回はオオヤマネコの絵をお願いしたいです。\nhttps://drive.google.com/drive/folders/1vto-4tosPRH7zzZG3HPNUpB-dtPYjnGx?usp=sharing\n\n白い毛のオオヤマネコで、少し丸みを帯びた体型をしています。\n頬に小さな紫色のハート型のマークがあり、キツネの尻尾を持っています。\nキュートでシャイな感じです。\n\nフォルダの「Outfit_1_Reference」にあるカジュアルな服装か、フォルダの「Outfit_2_Reference」にあるラベンダー色のドレスのどちらかを着て描いてほしい。\n\nポーズや表情は自由です！\nどんなポーズでも、どんな表情でも自由自在です！\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/41", "thumbnail_src": "https://si.imgix.net/2bfee96d/uploads/origins/291b8d6b-0a54-4606-9512-fde9eb76e724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43c318515c6c8c329df9e30a58e284bd", "thumbnail_srcset": "https://si.imgix.net/2bfee96d/uploads/origins/291b8d6b-0a54-4606-9512-fde9eb76e724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43c318515c6c8c329df9e30a58e284bd, https://si.imgix.net/2bfee96d/uploads/origins/291b8d6b-0a54-4606-9512-fde9eb76e724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2255eca1126f58246b2ff3b8fc60f128 2x, https://si.imgix.net/2bfee96d/uploads/origins/291b8d6b-0a54-4606-9512-fde9eb76e724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e4385775633e8cfc1ad75601b1bd0e2 3x", "genre": "art", "nsfw": false, "body": "こんにちはあなたの絵が好きなので、自分もお願いしたいと思いました。私のキャラクターを描いていただくことは可能でしょうか？ポーズや表情など、細かいところはお任せします。服装はバルドの服でも1の服でも何でも構いません！体型は以前描いていただいた絵に近い感じでお願いします。\n\nhttps://drive.google.com/drive/folders/1ZJd0iWwKD47YSMtSRNSlJIE3bgjn69oW?usp=drive_link キャラクター\n\nhttps://skeb.jp/@Fujimaki_2UxU/works/27体型", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/40", "thumbnail_src": "https://si.imgix.net/bbf0faf1/uploads/origins/4a0240e0-75e7-4e44-b8e6-3ebfb4cb4a51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28eb4b15b52cc534571276acda1d2c66", "thumbnail_srcset": "https://si.imgix.net/bbf0faf1/uploads/origins/4a0240e0-75e7-4e44-b8e6-3ebfb4cb4a51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28eb4b15b52cc534571276acda1d2c66, https://si.imgix.net/bbf0faf1/uploads/origins/4a0240e0-75e7-4e44-b8e6-3ebfb4cb4a51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c5981827523e47437e6276ec1b5b375 2x, https://si.imgix.net/bbf0faf1/uploads/origins/4a0240e0-75e7-4e44-b8e6-3ebfb4cb4a51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1e8b64c750a75585a5ed793b7d96370 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風はとてもかわいいです。私のメスドラゴンを描いてくれませんか？https://drive.google.com/file/d/1Dy7BqDjL6Tqzra0eEoyWgOn1kdIOFXMX/view?usp=sharing\n\n表情やポーズはお任せします！ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/39", "thumbnail_src": "https://si.imgix.net/8d1446db/uploads/origins/25efa437-0d32-4bc4-a6c5-7cd5122b1012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f8f3feb9444261c5505b15adede0d7", "thumbnail_srcset": "https://si.imgix.net/8d1446db/uploads/origins/25efa437-0d32-4bc4-a6c5-7cd5122b1012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f8f3feb9444261c5505b15adede0d7, https://si.imgix.net/8d1446db/uploads/origins/25efa437-0d32-4bc4-a6c5-7cd5122b1012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34b6eacf7cfedece10b695ad7a8cab1e 2x, https://si.imgix.net/8d1446db/uploads/origins/25efa437-0d32-4bc4-a6c5-7cd5122b1012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1fb41edd8d242c93eb49d5118073871 3x", "genre": "art", "nsfw": false, "body": "藤巻さん、こんにちは！シルバーです、よろしくお願いします👋。\nこちらやツイッターで藤巻さんの作品を拝見し、とてもかわいい画風だと思いました！リクエストを送れる機会をずっと待っていたので、こうして送れることを嬉しく思います👀。\n\n私のOCの一人、エロイーズ・リス(Eloise Lys)を描いて欲しいです。\n彼女が住んでいる世界は、一つの巨大都市が地球の大部分を覆っているサイバーパンクな世界。彼女のプロフィールを読んでから、好きなように描いてください。細かいところはお任せします🙏。\nパソコンに向かっている彼女を描くなら、メガネをかけてあげてください！デザインは自由です👍。\n\n彼女の詳細とアート(ギャラリー)は、私のサイトのここにあります：\nエロイーズ (エロイーズ): https://argentumgaleria.carrd.co/#eloise-lys\n\nお願いを聞いてくれてありがとう💗。", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/38", "thumbnail_src": "https://si.imgix.net/766f8ec6/uploads/origins/ff19dd74-d72a-4a85-a549-9e2da0923748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f92e3d2e83e0dd99fdb78ec4cbc867d", "thumbnail_srcset": "https://si.imgix.net/766f8ec6/uploads/origins/ff19dd74-d72a-4a85-a549-9e2da0923748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f92e3d2e83e0dd99fdb78ec4cbc867d, https://si.imgix.net/766f8ec6/uploads/origins/ff19dd74-d72a-4a85-a549-9e2da0923748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d5ceeded372bae3666596ac4901995b 2x, https://si.imgix.net/766f8ec6/uploads/origins/ff19dd74-d72a-4a85-a549-9e2da0923748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1843055f4d53f5f2f4feafcdb8bb1920 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターにセクシーなコスチュームを依頼したいのですが、特にバストに重点を置いて、脚は肉感たっぷりに見えるようにしてください。\nコスチュームは彼女のセクシーな体型を強調するもので、もう少し露出度が高くても構いません。ストッキングは少しひもっぽい感じで、もう少し流動性を持たせてください。\n彼女のキャラクターは大胆で開放的なので、表情や姿勢、立ち居振る舞いでそれを際立たせたいと思っています。彼女の目には2つのプリズムがあるので、このディテールに注目してください。\n\nhttps://bsky.app/profile/dinood.bsky.social/post/3lni7jue7y22k", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/37", "thumbnail_src": "https://si.imgix.net/b63ae023/uploads/origins/a156d518-85b5-4216-b8b2-cd071b018490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fe3dce8d3cf69ea82b38743dc67e5f", "thumbnail_srcset": "https://si.imgix.net/b63ae023/uploads/origins/a156d518-85b5-4216-b8b2-cd071b018490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fe3dce8d3cf69ea82b38743dc67e5f, https://si.imgix.net/b63ae023/uploads/origins/a156d518-85b5-4216-b8b2-cd071b018490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1b85049043dc49531618ae17c9d71f1 2x, https://si.imgix.net/b63ae023/uploads/origins/a156d518-85b5-4216-b8b2-cd071b018490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71a361e5af1b20c29e3840348781c505 3x", "genre": "art", "nsfw": false, "body": "露出度の高いメイド服を着て、ポーズの参考にあるような髪をなびかせるセクシーで誇らしげな表情を心がけて描いてください。ポーズのディテールや表情はお好きなように。\n\nキャラクターリファレンス（上にキャラクターシート）：https://drive.google.com/drive/folders/1BTEfQDlTxQi8bTMOr1Gq6gXkevdhFgys?usp=sharing\n\nポーズ：https://drive.google.com/file/d/1oxoBguqyBm8MD3TyF8KvOfPVaC_b8iu1/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/36", "thumbnail_src": "https://si.imgix.net/1b435c3a/uploads/origins/e00876aa-3339-4899-bf40-b655646e145a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a440cc3dd4155980b952bffb126f52", "thumbnail_srcset": "https://si.imgix.net/1b435c3a/uploads/origins/e00876aa-3339-4899-bf40-b655646e145a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a440cc3dd4155980b952bffb126f52, https://si.imgix.net/1b435c3a/uploads/origins/e00876aa-3339-4899-bf40-b655646e145a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cab2ef8fec49b72b4aab8c5c9198132b 2x, https://si.imgix.net/1b435c3a/uploads/origins/e00876aa-3339-4899-bf40-b655646e145a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd3ee1f635d7c790ad91cccbe9921c2a 3x", "genre": "art", "nsfw": false, "body": "Hi hi its me again, this time I'm coming to you to get a piece drawn up for a friend.\n\nI really liked how my piece came out and wanted to get one done for a friend of mine as a gift!\n\nThank you again. Artist freedom as always ♡\n\nhttps://imgur.com/a/P7oPtyX", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/35", "thumbnail_src": "https://si.imgix.net/bc7c666a/uploads/origins/908e5f5a-ead5-4565-8086-123e8cf50215?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=037acb568cf842054523b20714639385", "thumbnail_srcset": "https://si.imgix.net/bc7c666a/uploads/origins/908e5f5a-ead5-4565-8086-123e8cf50215?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=037acb568cf842054523b20714639385, https://si.imgix.net/bc7c666a/uploads/origins/908e5f5a-ead5-4565-8086-123e8cf50215?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b1f34680236a9f1e9122f4f32f3988d 2x, https://si.imgix.net/bc7c666a/uploads/origins/908e5f5a-ead5-4565-8086-123e8cf50215?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edd59dacf638b6eee523367004039441 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私の猫＋うさぎのキャラクターです。\nふくよかで曲線的な体型の女の子として描いてください。また\n他の属性も自由に変えてください。\n他の属性も自由に変えてください。お願い\n服装も自由に変えてください。\n\nhttps://drive.google.com/drive/folders/1nCyTgTfRrZ3kX8Bzgu-Q52tJoDBDitxn", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/34", "thumbnail_src": "https://si.imgix.net/8cb38810/uploads/origins/74f3e068-03a5-4153-8490-eedc533f230a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ef5979f3161f1f423cd451cfb5652e", "thumbnail_srcset": "https://si.imgix.net/8cb38810/uploads/origins/74f3e068-03a5-4153-8490-eedc533f230a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ef5979f3161f1f423cd451cfb5652e, https://si.imgix.net/8cb38810/uploads/origins/74f3e068-03a5-4153-8490-eedc533f230a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f