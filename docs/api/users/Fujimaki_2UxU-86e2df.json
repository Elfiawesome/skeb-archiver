2e0-ad91-5be14f6d5f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=301deb72b5941f41ed4e06dd6dab41b4", "thumbnail_srcset": "https://si.imgix.net/c05f692f/uploads/origins/47405674-767a-42e0-ad91-5be14f6d5f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=301deb72b5941f41ed4e06dd6dab41b4, https://si.imgix.net/c05f692f/uploads/origins/47405674-767a-42e0-ad91-5be14f6d5f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93efd77b78aedb09b23e8d6148bea541 2x, https://si.imgix.net/c05f692f/uploads/origins/47405674-767a-42e0-ad91-5be14f6d5f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6ab97aa8f0906da8267cdd8517ee02b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の犬のキャラクターを描いてほしいです！彼女の服装は複数あるので、どれを選んでもいいし、新しくデザインしてもらっても構いません。どんなポーズでもOKです！\n\nhttps://drive.google.com/drive/u/0/folders/17l5yUy5ihv8YSaIZq8h23e7GF1Wc8egR", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/31", "thumbnail_src": "https://si.imgix.net/2485142b/uploads/origins/835eb9de-6725-4242-9c2f-0885539bacbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0b615eb8b3a18a0005abed91fe9e6b4", "thumbnail_srcset": "https://si.imgix.net/2485142b/uploads/origins/835eb9de-6725-4242-9c2f-0885539bacbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0b615eb8b3a18a0005abed91fe9e6b4, https://si.imgix.net/2485142b/uploads/origins/835eb9de-6725-4242-9c2f-0885539bacbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59daae95b4e9271514851500dcc5f572 2x, https://si.imgix.net/2485142b/uploads/origins/835eb9de-6725-4242-9c2f-0885539bacbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=795d0a4e0001de2d5ce5bbb4e65dd9de 3x", "genre": "art", "nsfw": false, "body": "メスケモ化した私（ライラと言いますhttps://www.dropbox.com/sh/gam2wv1rsik6nff/AABxwGhFM9nXwe_bOPiiZp1va?dl=0）を描いていただけませんか？\n ちょっと内気でインドア派、天然なところもあるけど食べること（特にパンケーキ）が大好きで普通の大きさから惑星サイズ以上にも巨大化もできる不思議な女の子です！（資料では真顔ですが、笑顔や恥ずかしがる顔も可愛いのです！）\nポーズや服装などはお任せします！通常のぶかぶかなシャツはもちろん、VRで使い始めたギャル風のホットパンツつきジャケット、その他流行りの服装やふじまきさんのお好きなコーデなどで飾り付けてやってください！\nただ、もし可能であればなのですが、巨大化していることがわかりやすいように何か建物や惑星など、比較物を描いて頂けると嬉しいです！\n 体型などはお好みに改変してもらっても構いません！ふじまきさんの描くナイスバディなメスケモ達に一目惚れしたのでそういったイラストを期待しております！\n\nhttps://www.dropbox.com/sh/gam2wv1rsik6nff/AABxwGhFM9nXwe_bOPiiZp1va?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/30", "thumbnail_src": "https://si.imgix.net/fb970781/uploads/origins/5d135f80-379c-47cb-a10c-70e6a70ef26f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab5c0b1db3ce71b5b3600441cc8ad008", "thumbnail_srcset": "https://si.imgix.net/fb970781/uploads/origins/5d135f80-379c-47cb-a10c-70e6a70ef26f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab5c0b1db3ce71b5b3600441cc8ad008, https://si.imgix.net/fb970781/uploads/origins/5d135f80-379c-47cb-a10c-70e6a70ef26f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b74b2cfa7ea8bcb1b98bc2636466ecf 2x, https://si.imgix.net/fb970781/uploads/origins/5d135f80-379c-47cb-a10c-70e6a70ef26f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15ca7d78eeac0978f00531adfd622463 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Fujimaki_2UxU/works/29", "thumbnail_src": "https://si.imgix.net/b94d250b/uploads/origins/e59fe7b2-f5fe-4d4b-9f03-09f8cdd29258?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549b754efff90fce26fa23