f1-44bd6e9221fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0de90d90d21734b56fbfcf2d3fe7a5e3 2x, https://si.imgix.net/5c76a364/uploads/origins/31a32b1f-3c2b-490f-90f1-44bd6e9221fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e01d68721cc93e7f7b3b95842adf496a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、エーエスさん!私たちはあなたの絵が大好きで、私たちのキャラクターであるイソとケインを描いてほしいと思っていました。\n\nイソは、紫色の髪、灰色の目、牙のある歯、目の下の美容マーク、耳のピアス、そして指輪を身につけています。クールでパンクだけど親しみやすい感じです。\n\nKaneは、赤い髪、青い目、目の下のビューティマーク、耳のピアス、肩のタトゥーが特徴です。\n\n二人が向かい合って座り、楽しそうにおしゃべりしているポーズを希望します。\n\n衣装はお好みで。\n\n可能であれば、背景は昼間のカフェなどにしていただけませんか？その他はシンプルな背景でお願いします。\n\n主にバナーとしてSNSで使用する予定です。そのため、16:9の比率が望ましいです。\n\n参考写真はこちらでご確認ください。\nhttps://drive.google.com/drive/folders/138U2W9YNk5iYqIvsAaQ1DXVs5RxIVG5i\n\nありがとうございます!\n\nhttps://drive.google.com/drive/folders/138U2W9YNk5iYqIvsAaQ1DXVs5RxIVG5i", "created_at": "", "completed_at": ""}, {"path": "/@Aes_s0/works/12", "thumbnail_src": "https://si.imgix.net/a02ffb9c/uploads/origins/1641e322-cbd2-486c-814e-4a1221ddc8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=780fbf21c0a2d4ff32d0a22d47b76143", "thumbnail_srcset": "https://si.imgix.net/a02ffb9c/uploads/origins/1641e322-cbd2-486c-814e-4a1221ddc8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=780fbf21c0a2d4ff32d0a22d47b76143, https://si.imgix.net/a02ffb9c/uploads/origins/1641e322-cbd2-486c-814e-4a1221ddc8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e12cd101bc3e249a80b62bb4ce70cadf 2x, https://si.imgix.net/a02ffb9c/uploads/origins/1641e322-cbd2-486c-814e-4a1221ddc8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=056ffe3d0698c15a051855a0e6f210dd 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとても可愛いです私の友人と私のオリジナルキャラクター、アネットとヴァイオレットを描いていただけませんか？姉妹で仲が良かったのですが、今は対立しています。\n\nピンクの髪のアネットは、元気でヒーロータイプ。紫色の髪のヴァイオレットは、真面目な悪役タイプ。派手な衣装で武器を持った二人を描いて欲しいです!\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1kxmCTAobM4Uwa5SztUfQBqNgbMO8UKst?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Aes_s0/works/11", "thumbnail_src": "https://si.imgix.net/34a637c4/uploads/origins/f192467b-5711-4327-b6c5-dedaf885ec44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b569d0696cc46558f4279cfbc41403e2", "thumbnail_srcset": "https://si.imgix.net/34a637c4/uploads/origins/f192467b-5711-4327-b6c5-dedaf885ec44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b569d0696cc46558f4279cfbc41403e2, https://si.imgix.net/34a637c4/uploads/origins/f192467b-5711-4327-b6c5-dedaf885ec44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f623152483b1088cdb4d8f2029b98f48 2x, https://si.imgix.net/34a637c4/uploads/origins/f192467b-5711-4327-b6c5-dedaf885ec44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38df3b4d98acad31df16c04416ea587c 3x", "genre": "art", "nsfw": false, "body": "あえすさん、改めましてこんにちは!\n以前いただいた作品がとても気に入ったので、VTuberのサクちゃんのイラストをお願いしたいです\n\n評判の良い祓魔師の家系なのに、よく悪霊に取り憑かれてしまう祓魔師なんです。桜をモチーフにした女性らしい男の子です。\n\nクールな雰囲気のイラストにしたいです。キャラクターを元に自由にデザインできる錫杖を持たせて描いて欲しいです。その他、お守りを入れてもいいですが、それはあなた次第です。\n\nピンクのマントを羽織ってほしいのですが、人間の姿で描くか、悪魔の姿で描くか、どちらを選ぶかは自由です。ほくろは3つ（目の下、首、太もも）、目は形態によって変化し、花は人間の目だけです。また、ピアスやアイメイクも忘れずにお願いします。\n\n作品は出来れば16:9の比率でお願いしたいです。その他は自由に描いていただいて結構です\n\nイラストは私のSNSに掲載したり、Twitchでお名前をクレジットして使用させていただくことがあります。本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/15in_BWzfNhMe42fkdObi1ZG_8XlRoTqf", "created_at": "", "completed_at": ""}, {"path": "/@Aes_s0/works/10", "thumbnail_src": "https://si.imgix.net/e9b435b4/uploads/origins/bb261446-3217-4a4a-a5cc-029b1ccd28d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4314b0991886cb8db8ebed2f21e4524", "thumbnail_srcset": "https://si.imgix.net/e9b435b4/uploads/origins/bb261446-3217-4a4a-a5cc-029b1ccd28d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2