igins/811761ea-e011-45a5-8398-2235637af4ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0582df393e0b0a32dc873551686bb891 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ringokuro999/works/57", "thumbnail_src": "https://si.imgix.net/b542c53a/uploads/origins/22fa17cf-5716-4914-b47f-9c0750dfb012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=487757174db09848f12729b8ba245f4f", "thumbnail_srcset": "https://si.imgix.net/b542c53a/uploads/origins/22fa17cf-5716-4914-b47f-9c0750dfb012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=487757174db09848f12729b8ba245f4f, https://si.imgix.net/b542c53a/uploads/origins/22fa17cf-5716-4914-b47f-9c0750dfb012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23ba64f88e0f226e24272e904b7d1a84 2x, https://si.imgix.net/b542c53a/uploads/origins/22fa17cf-5716-4914-b47f-9c0750dfb012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4f109ab45bced66737226b8cab02f76 3x", "genre": "art", "nsfw": true, "body": "アイドルマスターの和泉愛依でお願いします。6つ子を妊娠したボテ腹(資料1のと同じくらい)で鼻と両乳首、クリトリスにリングピアスが付けられていて(それぞれ菱形を描くように紐で繋がれていて、乳首とクリトリスは長くなっている)、胸と尻のサイズが3桁の爆乳・爆尻(資料2のような感じで)で、鼻には直接鼻フック用のフックが引っ掛けられていて、更に左右にもそれぞれフックで引っ張られ(資料3のような感じで・鼻水も資料3のようにだらだらと垂れている)両腕には黒いロンググローブ(ラバー製)、両足には黒いサイハイソックス一体型厚底ハレエヒールブーツ(つま先立ちを強要するタイプ・ラバー製で編み上げ無し・資料4と5をベースに)が付けられ、口にはボールギャグを噛まされている感じ(ボールの穴と口との隙間から涎がだらだらと垂れている)で、マンコには極太ディルドと大量のピンクローター(両太ももにはローターのリモコンがサイハイブーツの履き口に付いている)が、アナルにはソフトボール並みの大きさのアナルパールが6つ連結式で詰め込まれていてガニ股になっている(引き抜く為の紐付きリングがアナルから垂れ下がっている)。全身にはオイルを塗りこまれて元々の肌の黒さも相まってテカテカしているお願いします。構図は昼間の繁華街を周囲の通行客の視線を集めつつも堂々と歩いている感じで(ディルドとローター、アナルパールの気持ちよさに加えて周囲の視線で発情している為股から大量の愛液が零れ落ちて地面に通った痕が出来るほど・正面から見た感じで)お願いします。差分は、背景は夕方で全身にザーメンを浴びてほぼ真っ白になっているものと、厚底ハレエヒール一体型のラバースーツを着用したものと2枚目と同じく夕方で全身にザーメンを浴びて真っ白になっているものの合計4枚でお願いします。\nhttps: