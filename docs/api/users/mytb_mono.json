200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03924b797333988b64f64628f96bc22a 2x, https://si.imgix.net/869520a5/uploads/origins/aeea84bb-b50b-43df-9306-03c6f1f8cb5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6a4e291217dd5de216cecaa76d9a229 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mytb_mono/works/5", "thumbnail_src": "https://si.imgix.net/69528de7/uploads/origins/c8ade26a-04b7-4fbf-a30b-6af193e4a864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b84590be1aa38111aa6c8b9f2e3cb70c", "thumbnail_srcset": "https://si.imgix.net/69528de7/uploads/origins/c8ade26a-04b7-4fbf-a30b-6af193e4a864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b84590be1aa38111aa6c8b9f2e3cb70c, https://si.imgix.net/69528de7/uploads/origins/c8ade26a-04b7-4fbf-a30b-6af193e4a864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6be3cd220bb81758eafdaf3a9eee6a0 2x, https://si.imgix.net/69528de7/uploads/origins/c8ade26a-04b7-4fbf-a30b-6af193e4a864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f9b5b25009c2415c7770e8dd4480d98 3x", "genre": "art", "nsfw": false, "body": "はじめまして、煮たかと申します！\n個人制作しておりますオリジナル『全国縁起』のキャラクターをリクエストさせていただきます。\nどうぞよろしくお願いいたします！\n\n使用目的　Twitter、YouTubeでのイラスト紹介\n\n▼詳細\nhttps://zenkokuengi.com/\nhttps://twitter.com/2tkinfo/status/1521420430019825664?s=20&t=kwFtbvCy3aSDzwWVUsbxyQ\nhttps://twitter.com/2tkinfo/status/1521420528862769156?s=20&t=kwFtbvCy3aSDzwWVUsbxyQ", "created_at": "", "completed_at": ""}, {"path": "/@mytb_mono/works/4", "thumbnail_src": "https://si.imgix.net/44dc666c/uploads/origins/fab13820-e90f-43bc-9817-210481265ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=5