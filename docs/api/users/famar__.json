oogle.com/file/d/13tgjIEd-I4dmfyXXke6dy_-dr96oX11e/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@famar__/works/64", "thumbnail_src": "https://si.imgix.net/6287b0c7/uploads/origins/6a8fcfc8-ffad-42dc-b099-bb897068ffaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56f3665a7201a7f95856dff906b054db", "thumbnail_srcset": "https://si.imgix.net/6287b0c7/uploads/origins/6a8fcfc8-ffad-42dc-b099-bb897068ffaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56f3665a7201a7f95856dff906b054db, https://si.imgix.net/6287b0c7/uploads/origins/6a8fcfc8-ffad-42dc-b099-bb897068ffaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5562de9fbb2c9eeafafe780f77a54ef8 2x, https://si.imgix.net/6287b0c7/uploads/origins/6a8fcfc8-ffad-42dc-b099-bb897068ffaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b4ae359a7ab3b5b389cbfe170b30918 3x", "genre": "art", "nsfw": false, "body": "Hello ~\nI am a Vtuber from Hong Kong , I really love your artwork and style .\nYou can design the pose. Thank you\n\n【使用用途】\n・SNSでの使用\n・配信活動用\n・グッズに使用する可能性がございます\n\nhttps://drive.google.com/drive/u/2/folders/1-38nEWgj5ukPyif8m-KWxWwA5Ummk-YK", "created_at": "", "completed_at": ""}, {"path": "/@famar__/works/63", "thumbnail_src": "https://si.imgix.net/c263e8ee/uploads/origins/ecd4ec62-7ef4-4167-ab0d-4fe0a8683f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8d27b63716666491477b78a4f6ce5d5", "thumbnail_srcset": "https://si.imgix.net/c263e8ee/uploads/origins/ecd4ec62-7ef4-4167-ab0d-4fe0a8683f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8d27b63716666491477b78a4f6ce5d5, https://si.imgix.net/c263e8ee/uploads/origins/ecd4ec62-7ef4-4167-ab0d-4fe0a8683f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3120585b289dbf926b9365c284b36fc 2x, https://si.imgix.net/c263e8ee/uploads/origins/ecd4ec62-7ef4-4167-ab