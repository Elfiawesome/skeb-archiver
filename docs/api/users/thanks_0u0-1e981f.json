f8e-a7b1-097476072a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b03bf4946cf9446404c014257f8be5, https://si.imgix.net/46791866/uploads/origins/70edeac9-0a67-4f8e-a7b1-097476072a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=977a32b94442018c261c468bf89055f4 2x, https://si.imgix.net/46791866/uploads/origins/70edeac9-0a67-4f8e-a7b1-097476072a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d1aa16ea93df68ebcfbda948794d2ac 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私はあなたの作品が大好きで、私のVtuber/Sonaをあなたのスタイルで見てみたいと思っています。彼女は人間と悪魔のハーフで、楽しい性格で自由気ままな女性です。彼女の表情は、楽しく、はしゃいだり、ドヤ顔だったり（あなたがやっている作品に合っていると思う方法で）、あなたの好きなダイナミックなポーズや構図にしてほしいです！\n\n彼女はまた、花（特にヒナギク）と人生の魔法を連想させますが、LAやニューヨークのような現代世界に存在しています。アートと猫も大好き！角、翼、尻尾は彼女のデザインにとってとても重要なので、忘れないでください。\n\nバナーやsnsの投稿に使いたいと思います！可能であれば、署名を別のレイヤーに分けてください！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/18zjEBziLyX0Sz-Igc8bsnpO7LO0CTLTr?usp=drive_linkHello！\n私はあなたの作品が大好きで、私のVtuber/Sonaをあなたのスタイルで見てみたいです。彼女は人間と悪魔のハーフの女性で、楽しい性格で自由人です。彼女の表情は、楽しく、はしゃいだり、ドヤ顔だったり（あなたがやっている作品に合っていると思う方法で）、あなたの好きなダイナミックなポーズや構図にしてほしいです！\n\n個人的には、LAやNYのようなモダンな街で、絵を描いたり、猫と遊んだり、花屋にいるような彼女を希望します。\n\nもし彼女の服装をクリエイティブに決めたいなら（何人かのアーティストがしたように）、彼女のエッセンスやカラーパレットが保たれている限り、自由に決めてください！彼女は確かに女性的な体型をしていますが、顔はキュートです（子供のような感じではなく、ロマンチックでチャラチャラした感じです）。\n\nバナーやsnsの投稿に使うかもしれないので、できれば画像の比率を16:9にして、署名を別のレイヤーに分けてください！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/18zjEBziLyX0Sz-Igc8bsnpO7LO0CTLTr?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@thanks_0u0/works/12", "thumbnail_src": "https://si.imgix.net/b1a30ab6/uploads/origins/2281776c-45e2-455e-9351-c8d5da212c4d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=30dc3d6d5425f0442c61dd16067ddf51", "thumbnail_srcset": "https://si.imgix.net/b1a30ab6/uploads/origins/2281776c-45e2-455e-9351-c8d5da212c4d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=30dc3d6d5425f0442c61dd1606