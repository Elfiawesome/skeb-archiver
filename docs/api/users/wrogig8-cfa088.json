7-4e59-8eed-db8841bc61e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28445fa0ebf00298469b52c55d59ca8f, https://si.imgix.net/bf6f8df8/uploads/origins/2d461f19-fbc7-4e59-8eed-db8841bc61e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abb387fcaeb0389256db65af408ee578 2x, https://si.imgix.net/bf6f8df8/uploads/origins/2d461f19-fbc7-4e59-8eed-db8841bc61e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9acefc07017f0c39f7cbd775988bae6d 3x", "genre": "art", "nsfw": false, "body": "ったな！\n\n以前描いていただいたルーンの絵がとても気に入ったので、またリクエストさせてください。できれば、ルーンの姉（双子）のフィービーのデザイン・イラストをお願いしたいです。彼女は明るく自信家で、よく弟のことを気にかけている女性です。フィービーはとても明るい性格ですが、怒るとルーンと同じように血の気が多くなります。彼女は未来を見る能力を持っており、それを使ってルーンの仕事を助けている。\n\n姉ではあるが、実はルーンより少し背が低い。フィービーは170cm、ルーンは177cm。彼女の外見や服装の参考資料を載せましたが、自由に改変して解釈してください。あなたのデザインセンスが素晴らしいので、どんなものが出来上がるか楽しみにしています！\n\nーこのー、ーさん、ーデザインセンスがー素晴らしいー！\n\nhttps://drive.google.com/drive/folders/1PLgYdxnh-65K4iu9FCN6CicV6CglFRjY", "created_at": "", "completed_at": ""}, {"path": "/@wrogig8/works/79", "thumbnail_src": "https://si.imgix.net/845e73e6/uploads/origins/1c68437b-1d85-4113-8a06-6a81faa298d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=164ba473fcf3e53d3b78238eb1d6ce93", "thumbnail_srcset": "https://si.imgix.net/845e73e6/uploads/origins/1c68437b-1d85-4113-8a06-6a81faa298d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=164ba473fcf3e53d3b78238eb1d6ce93, https://si.imgix.net/845e73e6/uploads/origins/1c68437b-1d85-4113-8a06-6a81faa298d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71b9efb360fc795ff8c14f2c53dcca74 2x, https://si.imgix.net/845e73e6/uploads/origins/1c68437b-1d85-4113-8a06-6a81faa298d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=459d43a1074c15c626ab9414733fcb4a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回のリクエストに応えていただき、ありがとうございました！今回は、三国志の曹操とその二人の妻（卞氏と丁氏）を私と私の友人バー