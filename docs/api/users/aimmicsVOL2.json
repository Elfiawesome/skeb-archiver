2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e42232a48b6218af8bff8f81eca549c9 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n私の子JDちゃんのアダルトイラストを描いていただきたいです。\nJDちゃん：https://drive.google.com/drive/folders/1HXx8iJMNTdIX2ey0yWje1tzmPthmaN2h\n[コンパニオン/AF]を完全にファスナーを開け、前面を露出させた状態で着用しています。\nベッドに横たわり、脚を広げて陰毛を完全に露出し、膣から精液が溢れ出ている姿でお願いします。\n可能であれば妊娠と授乳の差分もお願いします。\n乳首を描く場合は、ピンク色でお願いします。\n\nご依頼をお読みいただきありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/10", "thumbnail_src": "https://si.imgix.net/0d9672b7/uploads/origins/9a508c68-88cf-4dcb-93ed-0fc36087e470?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d655c200785e222d2ab98ca37ef43576", "thumbnail_srcset": "https://si.imgix.net/0d9672b7/uploads/origins/9a508c68-88cf-4dcb-93ed-0fc36087e470?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d655c200785e222d2ab98ca37ef43576, https://si.imgix.net/0d9672b7/uploads/origins/9a508c68-88cf-4dcb-93ed-0fc36087e470?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52acb912c03456681ac765c7519ef1b6 2x, https://si.imgix.net/0d9672b7/uploads/origins/9a508c68-88cf-4dcb-93ed-0fc36087e470?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a93deb362a5a5f4136cce40dfc0b1840 3x", "genre": "art", "nsfw": false, "body": "ご都合がよろしければ、イラストの依頼をさせて頂きたいです。\n\n◯キャラクター →紺堂地衛理、小鳥遊怜(アリス・ギア・アイギス) \n\n○シチュエーション →ベビードールを着用した紺堂地衛理と小鳥遊怜が、ベッドの上に寝そべってこちらを見つめながら誘惑してくる\n\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/9", "thumbnail_src": "https://si.imgix.net/b37bc5ba/uploads/origins/c8d56dc1-fb7d-4e21-a40d-49dbd518def9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc38458694407a6ddc07f2b56f73ef3a", "thumbnail_srcset": "https://si.imgix.net/b37bc5ba/uploads/origins/c8d56dc1-fb7d-4e21-a40d-49dbd518def9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc38458694407a6ddc07f2b56f73ef3a, https://si.imgix.net/b37bc5ba/uploads/origins/c8d56dc1-fb7d-4e21-a40d-49dbd518def9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74596e18445519675e322cb141123e2a 2x, https://si.imgix.net/b37bc5ba/uploads/origins/c8d56dc1-fb7d-4e21-a40d-49dbd518def9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c17ad6ac1a099ac96cfcd0bc383f0883 3x", "genre": "art", "nsfw": true, "body": "キャラ 駒添 絵伝\n服装 ウェディングビキニ(アニバリング着用)\n内容 隊長さんに徹夜での原稿の手伝いしてくれたお礼という事で着て見せてみたら、興奮した隊長さんにベッドまで連れていかれそのまま挿入、大量に中出しされてハート目で受精潮ふきアクメしている", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/8", "thumbnail_src": "https://si.imgix.net/89dcb9e4/uploads/origins/353fc977-3d4d-494d-a53a-d707bc8770ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6da2d1ed96ea4794a64f2c1efad5c1f", "thumbnail_srcset": "https://si.imgix.net/89dcb9e4/uploads/origins/353fc977-3d4d-494d-a53a-d707bc8770ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6da2d1ed96ea4794a64f2c1efad5c1f, https://si.imgix.net/89dcb9e4/uploads/origins/353fc977-3d4d-494d-a53a-d707bc8770ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0650d73eea0e819675cf04fc3ac6b311 2x, https://si.imgix.net/89dcb9e4/uploads/origins/353fc977-3d4d-494d-a53a-d707bc8770ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba4919855145d02122bd4c6a25ec45f8 3x", "genre": "art", "nsfw": false, "body": "ご都合がよろしければ、イラストの依頼をさせて頂きたいです。\n\n  ◯キャラクター →二子玉舞(アリス・ギア・アイギス)\n ○シチュエーション →競泳水着姿に首輪を着用した舞さんが、首輪に繋がれたリードを差し出し、頬を染めながらこちらを見つめているシーン\n\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/7", "thumbnail_src": "https://si.imgix.net/987d93dd/uploads/origins/c5bf250f-f48f-42e8-a444-cb6be5f646fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d071f89825418c7f501a3d4a295f0c7f", "thumbnail_srcset": "https://si.imgix.net/987d93dd/uploads/origins/c5bf250f-f48f-42e8-a444-cb6be5f646fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d071f89825418c7f501a3d4a295f0c7f, https://si.imgix.net/987d93dd/uploads/origins/c5bf250f-f48f-42e8-a444-cb6be5f646fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eee74810fc2f5056537276af37d6c23c 2x, https://si.imgix.net/987d93dd/uploads/origins/c5bf250f-f48f-42e8-a444-cb6be5f646fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d72820272bdfc5e284eb3ca1bae218f 3x", "genre": "art", "nsfw": false, "body": "ご都合がよろしければ、イラストの依頼をさせて頂きたいです。\n\n◯キャラクター\n→比良坂夜露、小鳥遊怜(アリス・ギア・アイギス)\n\n○シチュエーション\n→ベビードールを着た夜露ちゃんと怜ちゃんが、ベッドの上で手を繋ぎ、こちらを見つめて微笑んでいるシーン\n\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/6", "thumbnail_src": "https://si.imgix.net/09c66dcc/uploads/origins/5bbecb8a-a2eb-4e91-b636-22de9b0b6eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f78e4b22c5848d4b6b161a725676d8c", "thumbnail_srcset": "https://si.imgix.net/09c66dcc/uploads/origins/5bbecb8a-a2eb-4e91-b636-22de9b0b6eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f78e4b22c5848d4b6b161a725676d8c, https://si.imgix.net/09c66dcc/uploads/origins/5bbecb8a-a2eb-4e91-b636-22de9b0b6eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61693d5bb69b2f0d363df2aeb7ed0b6c 2x, https://si.imgix.net/09c66dcc/uploads/origins/5bbecb8a-a2eb-4e91-b636-22de9b0b6eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae2c59d6c4d20c81fecde5ac18b332b2 3x", "genre": "art", "nsfw": true, "body": "キャラ 二子玉舞\n服装 ゾディアックバニー(アニバリング着用)\n内容 発情して隊長さんを誘惑したら、汗だく蒸し蒸しな室内で乳首攻めされながらのキスハメ背面座位で潮吹きながら孕むまで何度も中出しされている", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/5", "thumbnail_src": "https://si.imgix.net/d2548ade/uploads/origins/afedfdd7-3f63-4137-9282-643d92d21466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff5ce2e938bb16aceccc93639a01d0d7", "thumbnail_srcset": "https://si.imgix.net/d2548ade/uploads/origins/afedfdd7-3f63-4137-9282-643d92d21466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff5ce2e938bb16aceccc93639a01d0d7, https://si.imgix.net/d2548ade/uploads/origins/afedfdd7-3f63-4137-9282-643d92d21466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8080a85b34ed4ac17ce8731d48d9436e 2x, https://si.imgix.net/d2548ade/uploads/origins/afedfdd7-3f63-4137-9282-643d92d21466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87e77410c30cf268e1c9106a9ffc243b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/4", "thumbnail_src": "https://si.imgix.net/1fcadfcd/uploads/origins/aa1b194a-18b9-47ba-81b5-c20ddc2f103d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85a3d8710d3228d15147dc7e920ecd16", "thumbnail_srcset": "https://si.imgix.net/1fcadfcd/uploads/origins/aa1b194a-18b9-47ba-81b5-c20ddc2f103d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85a3d8710d3228d15147dc7e920ecd16, https://si.imgix.net/1fcadfcd/uploads/origins/aa1b194a-18b9-47ba-81b5-c20ddc2f103d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e3c558e1a5d654e6ab955a8d323265b 2x, https://si.imgix.net/1fcadfcd/uploads/origins/aa1b194a-18b9-47ba-81b5-c20ddc2f103d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fdd2ddcc445b8a141feafe91fdf7fed 3x", "genre": "art", "nsfw": true, "body": "シャワー室で隊長さんと対面立位で愛し合ってる二子玉舞をお願い致します\n内容 隊長さんとする事は嬉しいけど場所に少し不満気味な表情を浮かべている(陰部は期待で濡れてる)\n挿入されて奥まで入って動きながらキスをされて嬉しそうに目を閉じて舌を絡ませた瞬間に腟内に大量射精される\n口を離し身体を快楽で震わせながらお腹越しに隊長さんのがまだ元気なのを確認すると微笑みながら｢このままだったら大変ですし……もう1回しませんか？｣と訪ねてる", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/3", "thumbnail_src": "https://si.imgix.net/fff89200/uploads/origins/8c699b95-395b-464e-b22a-3b78e924f610?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aacd135db038a1ce03e717d14708663", "thumbnail_srcset": "https://si.imgix.net/fff89200/uploads/origins/8c699b95-395b-464e-b22a-3b78e924f610?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aacd135db038a1ce03e717d14708663, https://si.imgix.net/fff89200/uploads/origins/8c699b95-395b-464e-b22a-3b78e924f610?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=800325ce6e73c1ce7882c6fc60ba2f1b 2x, https://si.imgix.net/fff89200/uploads/origins/8c699b95-395b-464e-b22a-3b78e924f610?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49a7121a3749948d60a4702e7d7daf7f 3x", "genre": "art", "nsfw": true, "body": "[コンパニオンYS着用の文嘉イラスト]\n突然の依頼失礼致します。\n巷で話題のAFではありませんが、YSを着用した百科文嘉の成人向け作品をお願い致します。\n\n内容 : コンパニオンYSを着用した文嘉に対して隊長がYS衣装のパンツ部分に上から手を突然突っ込み文嘉の秘部を中指で掻き回した上でそのまま失禁させる構図。\n\n①目の前に居る隊長が突然自分のパンツに手を突っ込んできたので想定外の展開に悲鳴を上げるのを忘れて肉体をビクッとさせつつ目を丸くして「えっ」と少し間抜けな声を上げる文嘉\n\n②そのまま隊長の中指が膣内を刺激し始めたので突然の性的快楽にしっかり感じつつも力の入らぬ両手で隊長の腕を引き離そうとしながら「隊長やめてください」と赤面し、吐息を荒くさせ、抵抗にならぬ抵抗をする文嘉。\n\n③何の意味も持たぬ抵抗を続けるが結局隊長の力には抗えず、男性的な力強い指で優しいながら激しく膣内を刺激され続けた結果、性的快楽に耐えきることが出来ずに情けない悲鳴を上げ腰を引かせ内股になり脚を震わせながら(隊長の手がパンツに突っ込まれた状態のまま)お漏らしをするように盛大に絶頂を迎える文嘉。", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/2", "thumbnail_src": "https://si.imgix.net/ffadfb76/uploads/origins/03f265d4-fbf5-41e1-b92f-e91a300e3a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=064ab50795601bd6fe483fc86ae32cdb", "thumbnail_srcset": "https://si.imgix.net/ffadfb76/uploads/origins/03f265d4-fbf5-41e1-b92f-e91a300e3a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=064ab50795601bd6fe483fc86ae32cdb, https://si.imgix.net/ffadfb76/uploads/origins/03f265d4-fbf5-41e1-b92f-e91a300e3a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45849c75d380daad952e3123ab9f069e 2x, https://si.imgix.net/ffadfb76/uploads/origins/03f265d4-fbf5-41e1-b92f-e91a300e3a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d930cf5e94147938b81e2138dfdff35 3x", "genre": "art", "nsfw": true, "body": "先日は怜ちゃんのイラストありがとうございました。\nまた小鳥遊怜ちゃん（アリスギア）のえっちなイラストをお願いしたいのですがよろしいでしょうか。\n\n以下詳細となります\nキャラクター\n小鳥遊怜（アリスギア）\n\n衣装\n巣鴨Tシャツ\n\nシチュ\nパンストのまま隊長のちんちんを両足で挟み込んで足コキ\n上のTシャツは乳首が見えるくらいまで捲り上げて、怜ちゃん自身で自分の乳首をいじって慰めている\n差分もあれば、射精してパンストやショートパンツ、胸にかかって目がハート目になっていると嬉しいです...。\n\nお時間等合えばご考慮いただけらば幸いです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aimmicsVOL2/works/1", "thumbnail_src": "https://si.imgix.net/e7026dca/requests/253846_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fbf719496c1e642466625037074390f", "thumbnail_srcset": "https://si.imgix.net/e7026dca/requests/253846_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fbf719496c1e642466625037074390f, https://si.imgix.net/e7026dca/requests/253846_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd135b1746f90d4528bd1ad71bda03e3 2x, https://si.imgix.net/e7026dca/requests/253846_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa0736af11e2fb7e4335deaef63a096 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n依頼したいのですがよろしいでしょうか。\n\nキャラクター\n小鳥遊怜（アリス・ギア・アイギス）\n\nシチュ\n隊長とのアナルえっち（四つん這いでお尻をこっちに向けてる感じで...）\n\nお忙しいと思います。お時間あれば、ご検討ください。\nよろしくおねがいいたします。", "created_at": "", "completed_at": ""}]}