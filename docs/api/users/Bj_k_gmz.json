8/uploads/origins/44e3ce5d-d7c4-4c8e-8131-f75d0b69f591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df32b75bb8fe20217e8335f7c48e18a9, https://si.imgix.net/145197b8/uploads/origins/44e3ce5d-d7c4-4c8e-8131-f75d0b69f591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0ef8274003a1157fcbe3d683c35335a 2x, https://si.imgix.net/145197b8/uploads/origins/44e3ce5d-d7c4-4c8e-8131-f75d0b69f591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b9dbbbbbd6320bafc363ea585c2d46e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Bj_k_gmz/works/17", "thumbnail_src": "https://si.imgix.net/1a87e5f2/uploads/origins/aee0522d-d008-496f-8528-500d1a55700b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83cb094a572f60efdf322724b750526", "thumbnail_srcset": "https://si.imgix.net/1a87e5f2/uploads/origins/aee0522d-d008-496f-8528-500d1a55700b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83cb094a572f60efdf322724b750526, https://si.imgix.net/1a87e5f2/uploads/origins/aee0522d-d008-496f-8528-500d1a55700b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9656c1dc279b1a2b39df341f6fcbf09 2x, https://si.imgix.net/1a87e5f2/uploads/origins/aee0522d-d008-496f-8528-500d1a55700b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=949405835631c167d7b9d51436a6aa34 3x", "genre": "art", "nsfw": false, "body": "はじめまして。月咲と申します。\n作品を拝見し、とても好みの絵柄と雰囲気の絵を描かれる方だと感動しました。もし可能であればリクエストをお願いしたいです。\n自分のTRPGで使用したキャラクターの絵をお願いしたいです。 それぞれ違うシナリオを通過した探索者であり、自分がつけた以上のつながりや設定はありません。\n\n【依頼内容】\n自探索者2人。\n2人とも刑事で関係性は幼馴染です。互いに恋愛感情はなく、相手に情はあるが好きではないと思っています。\n2人とも喫煙者（②が①に煙草の吸い方を教えた）\n\n①女性\n34歳168cm\n普段は特殊組織で仕事をしており、戦闘があれば刀を振るう。拳銃も一応撃つ。\n中性的で整った顔立ちをしており、立ち振る舞いは紳士的。\n誰に対しても愛想が良く、へらりとした笑みを浮かべ掴みどころのない人と思わせるような振る舞いをしている。\n右目は真っ黒、左目はミントブルー\n普段吸っているのはメビウス\n\n②男性\n36歳184cm\n普通の刑事。戦闘の際は拳銃を握る。\n真面目な印象を与えるよう振る舞い、基本的に誰に対しても優しく微笑んでいる。しかし実際は性格が悪く人の嫌がることを積極的にやります！というタイプ。\n吸ってるのは主にマルボロ（赤）\n\n◆欲しい部位・希望\n2人とも喫煙者の為、手や口元の描画があるととても嬉しいです。\nまた、暇テラス様の描くファッションもとても好きなので私服を捏造していただけるととても嬉しいです。（手間であれば資料内の好きな姿でお願いします）\n\n資料リンク内にキャラクター立ち絵や関係性メモなどをまとめております。 もしもどちらも描くのは難しいと言うことであれば①の人物だけでお願いしたいです。\nまた、納品いただいたものはSNSアイコンや個人で楽しむための印刷、グッズ制作などで使用する可能性があります\n\nご検討いただけますと幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-VvNK-gj-WhooHG9WzusOxXerKMlsx3m?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Bj_k_gmz/works/16", "thumbnail_src": "https://si.imgix.net/530b7143/uploads/origins/747c46c4-e329-42b1-95d9-8e145048f2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c619f5b04f9cd8965204f0ccefcc4208", "thumbnail_srcset": "https://si.imgix.net/530b7143/uploads/origins/747c46c4-e329-42b1-95d9-8e145048f2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c619f5b04f9cd8965204f0ccefcc4208, https://si.imgix.net/530b7143/uploads/origins/747c46c4-e329-42b1-95d9-8e145048f2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ad65b32781b3bbe0165c163cf652a25 2x, https://si.imgix.net/530b7143/uploads/origins/747c46c4-e329-42b1-95d9-8e145048f2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cb278a9b1d3d8368bfe947d9f86e6f5 3x", "genre": "art", "nsfw": false, "body": "暇テラス様\n\nいつも大変素敵なイラストをありがとうございます。\n今回も私のキャラクターを元にスケッチを描いて頂けますと嬉しいです！\n\n\n〖キャラクター詳細〗\nキャラクターや世界観のモチーフや引退競走馬と馬術競技です。\n\n身長：168cm\nイメージカラー：黄色・青\n\n優しくてマイペースなふんわりとした性格。\n多くの名声と共にこの世を去った親の背中を追い続けてきたが、父と同じ景色を見ることなくレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\n同居人の少女に振り回されつつも楽しい日々を過ごしている。\n\n\n✤衣装について\n今回は【衣装1】と記載のあるイラストを参考にして頂けますと幸いです。\n\n\nキャラクターシートもドライブに同梱しておりますので、こちらもご参考下さい。\n\n今回もよろしくお願い致します🦋\n\nhttps://drive.google.com/drive/mobile/folders/1i-CKhuokPUaatw2ZHQyxMn4KD4ihcarX", "created_at": "", "completed_at": ""}, {"path": "/@Bj_k_gmz/works/15", "thumbnail_src": "https://si.imgix.net/54685fd8/uploads/origins/7ea0d04b-b0de-48b0-8f7d-2ab4d67ab1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da09e6d70fc9bf882fcdf2a56d282aa2", "thumbnail_srcset": "https://si.imgix.net/54685fd8/uploads/origins/7ea0d04b-b0de-48b0-8f7d-2ab4d67ab1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da09e6d70fc9bf882fcdf2a56d282aa2, https://si.imgix.net/54685fd8/uploads/origins/7ea0d04b-b0de-48b0-8f7d-2ab4d67ab1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88a626b6dc1ae4890a195851445e862a 2x, https://si.imgix.net/54685fd8/uploads/origins/7ea0d04b-b0de-48b0-8f7d-2ab4d67ab1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67bd2dacffd368d03d211ffaedaed66c 3x", "genre": "art", "nsfw": false, "body": "暇terasuさん、こんにちは！いつも素敵な作品を拝見しています。もし可能でしたら、私のOCを描いていただけたら嬉しいです。\n\n💖参考URLには4人のOCが載っています。気になった子だけ選んで描いてください。\n1. 📖秋本歩月：伝統的な図書館で働く、勤勉でとても優しい司書です。\n2. 🍃ハマドリュアス：黒髪ショートに緑の瞳を持つ、明るく中性的な植物学者。\n3. 🟣アンティゴネ：紫の瞳と茶色のロングヘアを持つ、上品で可愛らしい植物学専攻の学生です。紫のユリやベリー類が好きです。\n4. 🗡️Æbleskiver：乾燥地帯に住む素直で明るい冒険者。戦闘は得意だけど料理は苦手です。\n\n衣装は自由に選んでOK、改変や新デザインでも大丈夫です。ポーズや構図もお任せします。\n依頼内容と金額が見合わない・その他不備などあればお気軽に再送要請してください。ご検討ありがとうございます！\n\nhttp://tiny.cc/k2tv001", "created_at": "", "completed_at": ""}, {"path": "/@Bj_k_gmz/works/14", "thumbnail_src": "https://si.imgix.net/88977401/uploads/origins/218e6b03-0cd2-48fc-844f-182318da7418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1458508f3740e6241bbaa505ff7432e1", "thumbnail_srcset": "https://si.imgix.net/88977401/uploads/origins/218e6b03-0cd2-48fc-844f-182318da7418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1458508f3740e6241bbaa505ff7432e1, https://si.imgix.net/88977401/uploads/origins/218e6b03-0cd2-48fc-844f-182318da7418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c556f25c9d0297d7b2d9c3a8aae3e412 2x, https://si.imgix.net/88977401/uploads/origins/218e6b03-0cd2-48fc-844f-182318da7418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f491d1399f1f007d5c854007f9a06b74 3x", "genre": "art", "nsfw": false, "body": "前回は素敵な劉と呉ありがとうございました！スタイリッシュに仕上げていただいて嬉しいです\nあちらとどちらにしようか迷ったんですが、今回はラフっぽいタッチで、自作小説「バンダースナッチ」のメイン2人を描いてほしいです。\n\n参考資料\nhttps://novel18.syosetu.com/n9084hx/34/\nhttps://www.alphapolis.co.jp/novel/904256305/435692574/episode/7538223\n\n風祭遊輔（32）\n元記者のヘビースモーカー　薫の相棒　身長176センチ\nギャンブル好き女好き　口も柄も悪いやさぐれたアラサーだが不正を許せない正義感の持ち主\n両手に黒の指ぬきグローブ（薫のプレゼント）\n\n富樫薫（22）\n遊輔の相棒　バーテンダー兼ハッカー　身長179センチ\n見た目は品行方正な好青年　遊輔の記事で救われた過去を持ち、彼に強く執着している\n心臓（ハート）に矢が刺さった、赤いコラソンのピアス着用（遊輔のプレゼント）\n\n※指ぬきグローブとコラソンのピアスはデートの思い出の品なので、それを装着したイラストが欲しくなりました\n\nポーズ・構図・表情・服装その他　不明点や詳細おまかせ\n自由に描いてください\nhttps://skeb.jp/@Bj_k_gmz/works/8\nの日常カット詰め合わせの雰囲気がおしゃれで大好きなので、こんな感じでお願いできれば幸いです\n\n内容や金額に不足・不備がございましたらご遠慮なく再送してください\n完成品はネット小説の表紙・挿絵・宣伝、SNSに掲載させてください\nお名前とアカウント名は明記します\n\nご縁があればよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Bj_k_gmz/works/13", "thumbnail_src": "https://si.imgix.net/3cd2c889/uploads/origins/493eff4b-d443-4848-a2cc-804ee36a4029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04e482b944e0740c092c023f63ef9a7", "thumbnail_srcset": "https://si.imgix.net/3cd2c889/uploads/origins/493eff4b-d443-4848-a2cc-804ee36a4029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04e482b944e0740c092c023f63ef9a7, https://si.imgix.net/3cd2c889/uploads/origins/493eff4b-d443-4848-a2cc-804ee36a4029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=680feb1fa5f4d4fc1b16d9bd6c51be89 2x, https://si.imgix.net/3cd2c889/uploads/origins/493eff4b-d443-4848-a2cc-804ee36a4029?bg=%23fff&auto=format%2Ccompress&fm=web