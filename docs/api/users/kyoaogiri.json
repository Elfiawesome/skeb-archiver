e0e37bad6ea 2x, https://si.imgix.net/dcc0a1e8/uploads/origins/8ac52ddd-df3c-45ce-99b4-08e470aef306?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=390cef8a20b861ceba7367d8f90954f6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/61", "thumbnail_src": "https://si.imgix.net/82721938/uploads/origins/aca9e8f8-90ca-4902-b868-05c467ad1e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e8f5f664e0f8ee347371ca71b92f899", "thumbnail_srcset": "https://si.imgix.net/82721938/uploads/origins/aca9e8f8-90ca-4902-b868-05c467ad1e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e8f5f664e0f8ee347371ca71b92f899, https://si.imgix.net/82721938/uploads/origins/aca9e8f8-90ca-4902-b868-05c467ad1e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdd24e072c49aeb4a7d6d8ccec2177f6 2x, https://si.imgix.net/82721938/uploads/origins/aca9e8f8-90ca-4902-b868-05c467ad1e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5eb5f026d0e8bca7c764fa80af85a418 3x", "genre": "art", "nsfw": false, "body": "キャラクター：花形ひかる（駅メモ！）\n\n服装：ミリタリーなひかる(資料URL参照)\n\n・ミリタリーラッピングを依頼するなら過去実績含めてもみくおじ先生かなぁと思っていたところ、プラスの要素＆おすすめクリエイター紹介メールが来て「時が来た」と思いましたので依頼した次第です。\n\n・ミリタリーラッピングの花形ひかるをお願いします。\n・通常時のニコニコアイドルな花形ではなく、諜報班として情報収集に動き帝国を貶めんとする「裏の顔」「シリアスなシチュエーション」といったイメージでお願いしたいです。\n・夜の天台ヤコの表情がかなり表情のイメージと近いかなと思っています。日中が普段と顔したら、丑三つ時が裏の顔（こっちが表？）といったところでしょうか。\n・イメージの振れ幅を大きくすると、以前よんご君が性癖パネルトラップで描いた「悪役三段笑いの2段目」に近くなってもいいと考えています。\nhttps://twitter.com/45_Stations/status/1952396056286671228\n・悪役にしてほしいという訳ではないのですが、今回の依頼ではアイドル的な普段の花形ではない姿が拝めれば、悪そうでも何でもオールオッケーと考えています。\n\n・それ以外は背景含めてすべてお任せします。モノクロの方が雰囲気が出るならカラーでなくてもＯＫです。\n\n以上、よろしくお願い致します。\n\n※ラッピング資料としてツイートを記載します。\n\nhttps://twitter.com/AUMUNF54/status/1968695331664674961", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/60", "thumbnail_src": "https://si.imgix.net/6f1d9619/uploads/origins/ad2fac92-1969-4bf7-9bbf-2cb3d515a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e8aa5a1080516b17c17c53ad4d75c8", "thumbnail_srcset": "https://si.imgix.net/6f1d9619/uploads/origins/ad2fac92-1969-4bf7-9bbf-2cb3d515a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e8aa5a1080516b17c17c53ad4d75c8, https://si.imgix.net/6f1d9619/uploads/origins/ad2fac92-1969-4bf7-9bbf-2cb3d515a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37e5b9dbb30bc9d818b69084ccab1d30 2x, https://si.imgix.net/6f1d9619/uploads/origins/ad2fac92-1969-4bf7-9bbf-2cb3d515a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=822b6d07d1e6049cb0aaa53637b2d89a 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\n\nジュビロ磐田を応援するドゥラメンテ(ウマ娘)という設定でイラストを描いていただきたいです。\n\nフィールドプレーヤー1stユニフォーム(URL下に貼りました)を着て声援(立席応援)を送っている感じで描いてほしいです。\nもし可能でしたら今回の作品をSNSのアイコンに使いたいです。\n\nよろしくお願いします！\n\nhttps://www.jubilo-iwata.co.jp/newslist/detail/?nw_seq=9927&year=2024&month=12", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/59", "thumbnail_src": "https://si.imgix.net/4d2c98f1/uploads/origins/c04dc6b9-0109-43bd-a82f-375447b68601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c9aee8aa9520e4d50bcbfc1a3f175c", "thumbnail_srcset": "https://si.imgix.net/4d2c98f1/uploads/origins/c04dc6b9-0109-43bd-a82f-375447b68601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c9aee8aa9520e4d50bcbfc1a3f175c, https://si.imgix.net/4d2c98f1/uploads/origins/c04dc6b9-0109-43bd-a82f-375447b68601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef4eaed04cb96471e6f1934d2d3ad2a9 2x, https://si.imgix.net/4d2c98f1/uploads/origins/c04dc6b9-0109-43bd-a82f-375447b68601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=747de5507c4173a001481d18b9151521 3x", "genre": "art", "nsfw": false, "body": "駅メモのファンアートを依頼したいです。\n\n美談くにさんをみくおじさんのタッチで、いつものラッピングで描いて頂けないでしょうか。可能なら背景を晴れた青空でお願いしたいです。その他の構図等は自由でお任せしたいです。パンタグラフは外した状態でも大丈夫です。\n\n夏に実車を初めて見て、その格好よさに見惚れてしまって、そんな感動を絵に変えて残してほしいのです。いつも素敵なでんこを描いておられるので依頼してみました。\n\nもし引き受けて頂ける場合も、急がないし、無理なく楽しく描ける範囲でお願いしたいです。\n\n以上、宜しくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/58", "thumbnail_src": "https://si.imgix.net/375e3fb2/uploads/origins/be7e5614-90ea-4d4a-8ff5-dd50add27507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb2a12bc1c8793eff4e88501aefc1e8", "thumbnail_srcset": "https://si.imgix.net/375e3fb2/uploads/origins/be7e5614-90ea-4d4a-8ff5-dd50add27507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb2a12bc1c8793eff4e88501aefc1e8, https://si.imgix.net/375e3fb2/uploads/origins/be7e5614-90ea-4d4a-8ff5-dd50add27507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8ade47d80f324bb641576b36e409279 2x, https://si.imgix.net/375e3fb2/uploads/origins/be7e5614-90ea-4d4a-8ff5-dd50add27507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90c196889df61fdac2259534a383bca2 3x", "genre": "art", "nsfw": false, "body": "初めまして\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の18歳位、\n明るいお姉ちゃん的な黒髪少女のイラストをリクエストしたいです。\n髪型、顔だち、体型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様、\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/57", "thumbnail_src": "https://si.imgix.net/48ec38b0/uploads/origins/4a348339-5204-4404-829b-0fde5b101435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac42938f2ba75c179129abdb775657a", "thumbnail_srcset": "https://si.imgix.net/48ec38b0/uploads/origins/4a348339-5204-4404-829b-0fde5b101435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac42938f2ba75c179129abdb775657a, https://si.imgix.net/48ec38b0/uploads/origins/4a348339-5204-4404-829b-0fde5b101435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7baae8c9f7404458b7503f45fd28141 2x, https://si.imgix.net/48ec38b0/uploads/origins/4a348339-5204-4404-829b-0fde5b101435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af3e396cd3dab8c39863e76ea1304fbe 3x", "genre": "art", "nsfw": true, "body": "駅メモ 千旦あずさがオナニーしているイラストをお願いします。\n\n・衣装→髪飾り系のみ残した全裸 脱がせた服は足元に乱雑に置いてください \n\n ・ポーズ→ベッドに仰向けで寝転びハの字開脚、乳首と下腹部を片手ずつで擦っている\n\n・表情→頬を赤らめ、口を半開きにさせてとろんとした顔\n\n・おっぱい→無乳（膨らみほぼなし）乳首は黒ずみ気味だと◎\n\n・その他→背中の機械などは省略して構いません\n\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/56", "thumbnail_src": "https://si.imgix.net/dfc50c32/uploads/origins/200be57b-9ff7-4fed-be54-dac1f5839eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da06cd2a196942a71e5db947974b7b11", "thumbnail_srcset": "https://si.imgix.net/dfc50c32/uploads/origins/200be57b-9ff7-4fed-be54-dac1f5839eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da06cd2a196942a71e5db947974b7b11, https://si.imgix.net/dfc50c32/uploads/origins/200be57b-9ff7-4fed-be54-dac1f5839eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21b782003a92cdf7ff79096598c58e4b 2x, https://si.imgix.net/dfc50c32/uploads/origins/200be57b-9ff7-4fed-be54-dac1f5839eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=800b5ea45f06425cc81800084d0083b7 3x", "genre": "art", "nsfw": false, "body": "今年のラブライブ！の千葉ロッテマリーンズコラボの園田海未ちゃんを描いていただけると嬉しいです。\nキャラ及び服装指定のみでその他諸々お任せでどうかよろしくお願いします。\n\nhttps://www.lovelive-anime.jp/special/pacificleague2024/marines/", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/55", "thumbnail_src": "https://si.imgix.net/3b7d7c86/uploads/origins/fe775b39-6702-4e50-9976-158154439d23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b319dd667a3a48856e371d797ea554f9", "thumbnail_srcset": "https://si.imgix.net/3b7d7c86/uploads/origins/fe775b39-6702-4e50-9976-158154439d23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b319dd667a3a48856e371d797ea554f9, https://si.imgix.net/3b7d7c86/uploads/origins/fe775b39-6702-4e50-9976-158154439d23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9dc25ee69c61bbc96efdfa0dead8624 2x, https://si.imgix.net/3b7d7c86/uploads/origins/fe775b39-6702-4e50-9976-158154439d23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb894a0db58687fe6891337799cf27f6 3x", "genre": "art", "nsfw": false, "body": "もしよろしければIKSのリコちゃんを衣服デフォルトでお願いします。\nシチュエーションはお任せします…！", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/54", "thumbnail_src": "https://si.imgix.net/1bfbabfb/uploads/origins/467f7a62-0399-4440-b575-b846a1dbef76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7858a2a7825940451edd3f63ef94b479", "thumbnail_srcset": "https://si.imgix.net/1bfbabfb/uploads/origins/467f7a62-0399-4440-b575-b846a1dbef76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7858a2a7825940451edd3f63ef94b479, https://si.imgix.net/1bfbabfb/uploads/origins/467f7a62-0399-4440-b575-b846a1dbef76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4456beb66d469d99cb492c8f8ec5b5ec 2x, https://si.imgix.net/1bfbabfb/uploads/origins/467f7a62-0399-4440-b575-b846a1dbef76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cd7d9798330c8b45703364be81f6382 3x", "genre": "art", "nsfw": true, "body": "匿名にて失礼します\n\n駅メモのキャラクター、作草部マコ、作草部チコの並んだ立ち絵をお願いします（R-18 保健体育の教材にある裸挿絵のイメージ･･･）\n\n以下詳細\n\n・マコ･･･髪留めのみ残した全裸。両乳を下から支えたポーズ。胸や陰毛はしっかりと成長し切った大人びた体型。\nチコよりもやや背を高めに描いてください。\n\n・チコ･･･同様に髪留めのみ残した裸。両手は腰に、足を肩幅に開いた堂々とした仁王立ちのポーズ。身体の発育はマコと正反対のつるぺた（無乳、パイパン）の幼児体型。\n\n2人とも全裸ですがあくまで恥じらいなどはなく、笑顔の表情でお願いします。\n\nその他\n背景の処理や複雑な背中部分の機械類の省略などは主様にお任せします。\n\n以上、ご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/53", "thumbnail_src": "https://si.imgix.net/84edb0a1/uploads/origins/1221da0e-9dd0-4021-95cf-8aa501fe8b1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e87614a93c4d21cbbe78e87758a2e7f8", "thumbnail_srcset": "https://si.imgix.net/84edb0a1/uploads/origins/1221da0e-9dd0-4021-95cf-8aa501fe8b1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e87614a93c4d21cbbe78e87758a2e7f8, https://si.imgix.net/84edb0a1/uploads/origins/1221da0e-9dd0-4021-95cf-8aa501fe8b1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62353dfef7fe5eaab0fe6c90feb810b8 2x, https://si.imgix.net/84edb0a1/uploads/origins/1221da0e-9dd0-4021-95cf-8aa501fe8b1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54b76b3f9f848d4971a3ebd321a048ad 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@kyoaogiri/works/42\nの作品の構図で、登場するキャラクター\nを、ふたなりチンコはそのままの状態で\n超時空要塞マクロス愛おぼえていますか\nのアイドル衣装を着たリン・ミンメイに\n置換えた絵を描いて頂きたいのですが、\n何卒宜しくお願いいたします。\n\nhttps://twitter.com/LMP500/status/1638502885800693760", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/52", "thumbnail_src": "https://si.imgix.net/41989dfd/uploads/origins/f708bcf2-abe7-4532-88d1-b650304847ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b09ee6d0e399050d9b81d11342f4b847", "thumbnail_srcset": "https://si.imgix.net/41989dfd/uploads/origins/f708bcf2-abe7-4532-88d1-b650304847ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b09ee6d0e399050d9b81d11342f4b847, https://si.imgix.net/41989dfd/uploads/origins/f708bcf2-abe7-4532-88d1-b650304847ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef455db22326f030235334d09522940f 2x, https://si.imgix.net/41989dfd/uploads/origins/f708bcf2-abe7-4532-88d1-b650304847ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=372d2db34e3c84c6b0bf4b682b7da89a 3x", "genre": "art", "nsfw": true, "body": "駅メモのゆめのちゃん(攻め)とふたなりになったていらちゃん(受け)のえっち絵をご依頼させていただきたく存じます。\n背景、構図などは全ておまかせでお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/51", "thumbnail_src": "https://si.imgix.net/3fee18de/uploads/origins/d4072ece-0d46-4d79-a5bc-2e1cfb3b4792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=635e738a27375dc7486de56a8cb8b36e", "thumbnail_srcset": "https://si.imgix.net/3fee18de/uploads/origins/d4072ece-0d46-4d79-a5bc-2e1cfb3b4792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=635e738a27375dc7486de56a8cb8b36e, https://si.imgix.net/3fee18de/uploads/origins/d4072ece-0d46-4d79-a5bc-2e1cfb3b4792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3ee206d1e6e10e16f8140406672d499 2x, https://si.imgix.net/3fee18de/uploads/origins/d4072ece-0d46-4d79-a5bc-2e1cfb3b4792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c71290c0d19b56e558b55a26502f828b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/50", "thumbnail_src": "https://si.imgix.net/b99efc51/uploads/origins/8598aa2a-97c4-4868-9cb6-bddbe51a3695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be47e76ab3ee849ec66321cc13115f03", "thumbnail_srcset": "https://si.imgix.net/b99efc51/uploads/origins/8598aa2a-97c4-4868-9cb6-bddbe51a3695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be47e76ab3ee849ec66321cc13115f03, https://si.imgix.net/b99efc51/uploads/origins/8598aa2a-97c4-4868-9cb6-bddbe51a3695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=306938924d4191f5d7fc1444fc7575a5 2x, https://si.imgix.net/b99efc51/uploads/origins/8598aa2a-97c4-4868-9cb6-bddbe51a3695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e457bea5e17f7f92e9aea571338365ba 3x", "genre": "art", "nsfw": true, "body": "もし可能でしたら、駅メモの新百合ほこねと新百合うららの百合百合している感じのイラストがみたいです…。\nシチュエーション(受け攻めがどちらかなどなど)はお任せしますが、できればデフォルトラッピングでお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/49", "thumbnail_src": "https://si.imgix.net/107db006/uploads/origins/11f46693-f570-4f89-ab83-8910c42227c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7d3a773bb670f186758cb04e7df5227", "thumbnail_srcset": "https://si.imgix.net/107db006/uploads/origins/11f46693-f570-4f89-ab83-8910c42227c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7d3a773bb670f186758cb04e7df5227, https://si.imgix.net/107db006/uploads/origins/11f46693-f570-4f89-ab83-8910c42227c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a09f9b07be07c1357be6f62ef4680c5 2x, https://si.imgix.net/107db006/uploads/origins/11f46693-f570-4f89-ab83-8910c42227c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1544a8ca8b62f0a8c2aa52a6f9a2f13f 3x", "genre": "art", "nsfw": false, "body": "駅メモの八日市ゆかりさんのモデルであろう近江鉄道900形がデビュー10周年になるので、記念のファンアートを描いて頂けないでしょうか？\n\n今のあかね号の姿を大事にしつつ、昔の淡海号の頃も懐かしむような絵が見たいのですが、以下の要素をなるべく含む絵が希望です\n・水辺を走る現在のあかね号塗装の900形\n・水面に映る過去の淡海号塗装の900形\n・ゆかりさんがいつもの衣装から、頭の帽子だけは外した状態で、気持ち髪を綺麗めに。髪が淡海号と同じカラーなので、淡海号の意匠も強調する意図と、お姉さんが髪が綺麗だったという設定があるので、ゆかりさんも同じように綺麗だろうという所からです。\n\n参考になるかわかりませんが、近江鉄道　水面の画像検索して頂けると水辺を走る電車が水鏡で反射した構図の写真が沢山出て来るかと思います。構図は架空で描いて頂いても問題ありません。ゆかりさんや実車のパンタや機構は適宜描きやすく省略や改変なさって下さい。\n\nもし引き受けて頂ける場合も、気負わず気楽に描いて頂ければ幸いです。増分は描く対象が複数で指定が多いことによるもので、気になさらないで下さい。\n\n以上、宜しくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/48", "thumbnail_src": "https://si.imgix.net/f270c520/uploads/origins/96db43cb-7af9-47ae-b310-32ed2067b921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4560ce4c496dd984b6a4beb107a79d3", "thumbnail_srcset": "https://si.imgix.net/f270c520/uploads/origins/96db43cb-7af9-47ae-b310-32ed2067b921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4560ce4c496dd984b6a4beb107a79d3, https://si.imgix.net/f270c520/uploads/origins/96db43cb-7af9-47ae-b310-32ed2067b921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e68b3da03c085dafa680efffbdf6608d 2x, https://si.imgix.net/f270c520/uploads/origins/96db43cb-7af9-47ae-b310-32ed2067b921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c17a6b56fb56c7ec8ca4e52f57e9e76a 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になります🙏🏻  駅メモ！の妹尾まりかさんをお願いいたします。 シチュエーション、ラッピング等お任せいたします。  よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kyoaogiri/works/47", "thumbnail_src": "https://si.imgix.net/72c6f4f4/uploads/origins/95aa1a57-9593-48f6-8619-80e0ec9994c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0646bc2a32119b73b3b9852b9967a5", "thumbnail_srcset": "https://si.imgix.net/72c6f4f4/uploads/origins/95aa1a57-9593-48f6-8619-80e0ec9994c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0646bc2a32119b73b3b9852b9967a5, https://si.imgix.net/72c6f4f4/uploads/origins/95aa1a57-9593-48f6-8619-80e0ec9994c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2