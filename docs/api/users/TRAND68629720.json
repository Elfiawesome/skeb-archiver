=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=666fb286189e51bad4bcdda3c0466e63, https://si.imgix.net/793d6d61/uploads/origins/c53d6d63-31ba-4938-9752-17cac0f08d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53f989d05a845f7b519d1d996445dcd3 2x, https://si.imgix.net/793d6d61/uploads/origins/c53d6d63-31ba-4938-9752-17cac0f08d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63c98a4bd3aa789eef4be2f073123162 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TRAND68629720/works/96", "thumbnail_src": "https://si.imgix.net/3effb578/uploads/origins/695ba054-22f8-49d3-a468-37c5e064e72a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9109863253a9f0c2f970115528628575", "thumbnail_srcset": "https://si.imgix.net/3effb578/uploads/origins/695ba054-22f8-49d3-a468-37c5e064e72a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9109863253a9f0c2f970115528628575, https://si.imgix.net/3effb578/uploads/origins/695ba054-22f8-49d3-a468-37c5e064e72a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e0f9031ab52bebfc3ce48a23a370995 2x, https://si.imgix.net/3effb578/uploads/origins/695ba054-22f8-49d3-a468-37c5e064e72a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf1625e0abb91c2b75adb0b148c05366 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TRAND68629720/works/95", "thumbnail_src": "https://si.imgix.net/88ce494b/uploads/origins/4482aef9-2099-4d2d-8b4e-61fd70e91ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c945d6be95ec09bd0e52148b8fdbdbe", "thumbnail_srcset": "https://si.imgix.net/88ce494b/uploads/origins/4482aef9-2099-4d2d-8b4e-61fd70e91ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c945d6be95ec09bd0e52148b8fdbdbe, https://si.imgix.net/88ce494b/uploads/origins/4482aef9-2099-4d2d-8b4e-61fd70e91ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c9fd49b2ef4f91213a3393c58afc60 2x, https://si.imgix.net/88ce494b/uploads/origins/4482aef9-2099-4d2d-8b4e-61fd70e91ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd72a6c7b3d57a4b00ab26cab8af2d24 3x", "genre": "art", "nsfw": true, "body": "はじめまして。とても好みの絵柄でしたので、私の推しキャラを依頼させていただきたいと思います。ジャンル外かつ版権キャラではありますが、承認いただけますと幸いです。\n\nジャンル:モンスターストライク\nキャラクター:ワタツミ神化(https://dic.xflag.com/monsterstrike/character/3952/)\nその他:髪型は参考画のままでお願いします。額の冠は付けていただきたいです。胸は大きめでお願いします。\n\nシチュエーション\nNTRモノをお願いします。可能であれば、以下の構成でお願いします。\n1 待ち合わせ場所に遅刻してくるワタツミ。サイズの合っていない私服(スカート、タイツ)を着ている。衣服から身体の落書きや太ももに巻かれたコンドームがはみ出ている。画面にはワタツミ1人のみ。\n　\n2 全裸で竿役に土下座し、「抱いてくれ」と懇願するワタツミ。画面にはワタツミ1人のみ。\n\n3 ベッドの上でツインテールを掴まれ、バックで激しく突かれるワタツミ。中出しを懇願している。周囲には使用済みのコンドームが散乱している。\n\n4 エロ蹲踞の体制になり、性器から精液を滴らせているワタツミ。体には落書きをされ、使用済みのコンドームを身体に括り付けられている。竿役は背後から胸を鷲掴みにしている。\n\n以上となります。\nわかりにくく長い文章で申し訳ないです。\n指定外の部分は全てお任せします。\nお忙しいところ恐縮ですが、承認いただけますと幸いです。何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@TRAND68629720/works/94", "thumbnail_src": "https://si.imgix.net/9f5c15d0/uploads/origins/b91efd30-dae2-407d-a40e-4007d85ca5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2914331cb28d21cc20247dac5f55f68d", "thumbnail_srcset": "https://si.imgix.net/9f5c15d0/uploads/origins/b91efd30-dae2-407d-a40e-4007d85ca5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2914331cb28d21cc20247dac5f55f68d, https://si.imgix.net/9f5c15d0/uploads/origins/b91efd30-dae2-407d-a40e-4007d85ca5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6494b4da8f3fe415f525043114016f3 2x, https://si.imgix.net/9f5c15d0/uploads/origins/b91efd30-dae2-407d-a40e-4007d85ca5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44a27df69165285b819637665d3071bd 3x", "genre": "art", "nsfw": true, "body": "こんにちは！またしてもリクエストを送らせていただきます。\n今回はふたなりのアンジュ・カトリーナがニュイ・ソシエールそしてフレン・E・ルスタリオと行為に及んでいる絵をお願いします。\n\n詳しいシチュエーションなどは以下の通りです。\n今回は2枚で\n1枚目はアンジュとニュイが交尾をしていて、それをフレンが見てしまう。この時の体位は、立ちバックでお願いします。\n2枚目でフレンもアンジュに犯され、事後に2人でアンジュの肉棒を舐めているという感じでお願いします。\n\n見た目については、アンジュは短髪で衣服などは着たまま(デフォルトの服装)で、ニュイとフレンは牛柄ビキニでお願いします。\n\n後の細かい点と致しましては、出来ればですが、2枚目はフレンとの行為と事後の絵がどちらとも大体半分位であると有難いです。また、ニュイとフレン2人とも牛柄のビキニを着ていることから、牛のような喘ぎ声を上げるというのもお願いしたいです。\n\nまたしてもふたなりアンジュが誰かと行為をしているというリクエストになってしまいますが、何卒よろしくお願いします。完成する日を心待ちにしています！", "created_at": "", "completed_at": ""}, {"path": "/@TRAND68629720/works/93", "thumbnail_src": "https://si.imgix.net/b510a342/uploads/origins/96951ba4-4ed4-4b72-aff5-6bc86c55467e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cdd9e706ce711d6ce70c72de85e9998", "thumbnail_srcset": "https://si.imgix.net/b510a342/uploads/origins/96951ba4-4ed4-4b72-aff5-6bc86c55467e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cdd9e706ce711d6ce70c72de85e9998, https://si.imgix.net/b510a342/uploads/origins/96951ba4-4ed4-4b72-aff5-6bc86c55467e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=413f8d0600465618fb3dff82b274b025 2x, https://si.imgix.net/b510a342/uploads/origins/96951ba4-4ed4-4b72-aff5-6bc86c55467e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32270fa23a00eb901e6e21d9195978ce 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nキャラクター\nブルーアーカイブの狐坂ワカモ(仮面無し)をお願いします。(参考資料https://bluearchive.wikiru.jp/?plugin=attach&refer=ワカモ&openfile=ワカモ（素顔）.png)\n\n衣装\n和風の制服→全裸でお願いします。(ワカモの体のどこかにQoSタトゥー入れて欲しい。)\n\nシチュエーション\n黒人の男性に調教され、男性の雌奴隷になったワカモが先生を捕まえ拘束する。そして先生に見せつけるように、黒人の男性とドスケベセックスをし始め、ある程度セックスを楽しんだ後、男性がワカモに中出しをし、同時にワカモも我慢できず、絶頂してしまうという感じのシチュエーションをお願いします。(寝取られ要素もあるととても嬉しいです。)\n\n台詞\n上記のシチュエーションに合った台詞をお願いします。(可能でしたら、ワカモがセックスをしている時の台詞やオホ声などは、下品な感じになっているととても助かります。)\n\nその他、セックスの体位や表情、細かい内容などはお任せしますので、どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@TRAND68629720/works/92", "thumbnail_src": "https://si.imgix.net/1764f492/uploads/origins/8080b037-0ad4-4df5-923c-6deeb7f26eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89e476452f2a182faeb3af598a358643", "thumbnail_srcset": "https://si.imgix.net/1764f492/uploads/origins/8080b037-0ad4-4df5-923c-6deeb7f26eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89e476452f2a182faeb3af598a358643, https://si.imgix.net/1764f492/uploads/origins/8080b037-0ad4-4df5-923c-6deeb7f26eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2404679a7ddbbbc029667b5a4df892b1 2x, https://si.imgix.net/1764f492/uploads/origins/8080b037-0ad4-4df5-923c-6deeb7f26eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e129eb860226df8a4818edd3977b163b 3x", "genre": "art", "nsfw": true, "body": "テフルさんこんにちは\n以前の倉持のショタおねが凄い良かったので今回もショタおねでお願いします\nキャラは梢桃音(メイド服)でテーマはNTRで\n\nシチュエーションは\n彼氏の弟に彼氏とセックスしてる盗撮された動画で脅され体を要求される\n相手は子供だと最初は強気だったが彼氏より上手いテクでイカされてしまう\nそれでも強気な態度で睨み付けるが今度は種付けプレスで中出しされてしまう\n最後は堕ち○○シリーズの最初みたいに桃音がイカされてる動画を見て彼氏が震える1枚をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@TRAND68629720/works/91", "thumbnail_src": "https://si.imgix.net/502b636d/uploads/origins/5293405f-9fbd-432c-80f4-1a5820db2941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b4dbb1a326cbc3b0b0799d86e7f89b", "thumbnail_srcset": "https://si.imgix.net/502b636d/uploads/origins/5293405f-9fbd-432c-80f4-1a5820db2941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b4dbb1a326cbc3b0b0799d86e7f89b, https://si.imgix.net/502b636d/uploads/origins/5293405f-9fbd-432c-80f4-1a5820db2941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76e4f45f9f932aa6753e9cc469363bc6 2x, https://si.imgix.net/502b636d/uploads/origins/5293405f-9fbd-432c-80f4-1a5820db2941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98fa69b59b32b5a057a8bd896df46738 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ失礼します。\n久方ぶりにリクエストをお送りさせて頂きます。\n下記キャラクターでイラスト作成のご検討をお願いします。　　\n\n登場作品:可愛いだけじゃない式守さん\nキャラクター:式守さん ※髪型は長髪（https://shikimori-anime.com/character/shikimori.html参照）でお願いします。\n\n【シチュエーション】\n彼氏の和泉くんをヘトヘトになるまで快楽責めする様を描いて頂きたいです。\n\n【各構図と備考】\n計8枚のイラストのご用意をお願い致します。　\n※各種ともセリフ無しバージョンもご用意頂けると幸いです。\n①https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQDc2-O4NUFnCBALBeUi7LbjKx9nwDJPA3HWnREw0i-M-fmFpUbSTgCP9M&s=10のよう和泉くんを壁に押し付け、おっぱいを顔に押し当てて興奮させる。\n\n②https://img5.qy0.ru/data/2623/84/250_250.jpgのようにバッキバキになったおチンポの大きさと臭いに大興奮。\n\n③https://cdn.imagedeliveries.com/3017524/46a504fd54fc3362787cb6614476ed8f7adb438a/140.webpと同じ構図・表情でパイズリ責め。イきたくてもイけない寸止め地獄を味合わせる。\n※おっぱいの輪郭が見切れないよう枠内に収めて描いて頂けると幸いです。\n\n④↑の表情違い。https://i1.nhentaimg.com/003/a919eee90d/19.jpg内右下のキャラのように舌舐めずりをしながら、「イかせて」と懇願してもイかせてもらえない寸止め地獄に悶え苦しむ和泉くんを楽しそうに見上げる。\n\n⑤顔射され、顔にかかったザーメンを舐め取りながらご満悦。\n\n⑥https://images.asmhentai.com/016/519688/10.jpg内下段のようにギュッと強く抱きしめながら正常位で激しく責め立てる。\n\n⑦https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSiY3HRzhjyo0h980SCERujI8Dfkp82ZTZZr2HVz_V7u3OMC96rcYDd4ooh&s=10と同じ構図で絶対に逃げられないように腰を両足でロックしてさらなる快楽責めを味合わせる。\n\n⑧足のロックを解いて、度重なる快楽責めと射精でヘトヘトに疲れ果てた和泉くんをhttps://cdn.doudou.pm/galleries/2749227/33.webpのように抱き寄せる。\n\n何卒、宜しくお願い申し上げます。", "created_at": "", "completed_at": ""}]}