\n\n■用途\nYouTubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\n使用の際は、先生のTwitterアカウントをYouTubeの概要欄、もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望など\nYouTubeのサムネイルに使用する為、お顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kenseeeeeeee/works/208", "thumbnail_src": "https://si.imgix.net/75353dcb/uploads/origins/30e7794c-a3f1-4fd7-9148-cba257cc3766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d439f27c51c0ddab6cf54ef6362c44", "thumbnail_srcset": "https://si.imgix.net/75353dcb/uploads/origins/30e7794c-a3f1-4fd7-9148-cba257cc3766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d439f27c51c0ddab6cf54ef6362c44, https://si.imgix.net/75353dcb/uploads/origins/30e7794c-a3f1-4fd7-9148-cba257cc3766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34ce0eeeec2734e42d608aacc0c4ef97 2x, https://si.imgix.net/75353dcb/uploads/origins/30e7794c-a3f1-4fd7-9148-cba257cc3766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac3e88a27488aa7a814c27fa366f2662 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kenseeeeeeee/works/207", "thumbnail_src": "https://si.imgix.net/a80e113f/uploads/origins/2b02d585-aa72-499a-819b-cf5cd2ec65c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d80b9c047054806d44e26c421ba6f5a", "thumbnail_srcset": "https://si.imgix.net/a80e113f/uploads/origins/2b02d585-aa72-499a-819b-cf5cd2ec65c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200