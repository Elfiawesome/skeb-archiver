8-8a3b-ca939376ef91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1dbbc9c6e99d2409e69aa573db1f1af", "thumbnail_srcset": "https://si.imgix.net/e1a22663/uploads/origins/2d3f3fb2-e58b-4e68-8a3b-ca939376ef91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1dbbc9c6e99d2409e69aa573db1f1af, https://si.imgix.net/e1a22663/uploads/origins/2d3f3fb2-e58b-4e68-8a3b-ca939376ef91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecdfa4d0c3e3f57249535f09f4590946 2x, https://si.imgix.net/e1a22663/uploads/origins/2d3f3fb2-e58b-4e68-8a3b-ca939376ef91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f9287fc876c274ebcd71cc544ba2806 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。\n\n「ストライクウィッチーズ」の「宮藤芳佳」の肥満化絵をアニメで放送されているような絵柄でお願いします。\n\nもしよろしければですが、お腹とお尻中心に太り、胸には余り贅肉がついていないような感じでお願いします。\n\nその他衣装や字幕台詞等はお任せします。\n\n上記の内容でもしよろしければ、依頼受注のご検討を宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/15", "thumbnail_src": "https://si.imgix.net/a0d64c89/uploads/origins/7dbd65da-7d5d-49ef-80d0-863d24b74076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ba208d2d483eefe87be5d8e5316b1d", "thumbnail_srcset": "https://si.imgix.net/a0d64c89/uploads/origins/7dbd65da-7d5d-49ef-80d0-863d24b74076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ba208d2d483eefe87be5d8e5316b1d, https://si.imgix.net/a0d64c89/uploads/origins/7dbd65da-7d5d-49ef-80d0-863d24b74076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8eaf2bf5065e949daac8839066220d96 2x, https://si.imgix.net/a0d64c89/uploads/origins/7dbd65da-7d5d-49ef-80d0-863d24b74076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e24bc327345542f6ec371ce24250840c 3x", "genre": "comic", "nsfw": true, "body": "『ビビッドレッド・オペレーション』の「一色あかね」の肥満化をお願いします。\n大量のマヨネーズを何にでもかける重度のマヨラーのため、日を追うごとにブクブク太っていき、徐々に学校生活や登校にも支障が出始め、最終的には階段はおろか席から立ち上がって歩くのもやっとなぐらいに肥満化してしまう感じでお願いします。\n肥満化しきった姿は全身が見えるようなワンシーンがあると嬉しいです。\n\n参考画像：\nhttps://vfrltl.wickedwombats.com/index.php?main_page=product_info&products_id=14755\n\n漫画抜粋(キャラ、セリフなどの参考になれば)：\nhttps://twicomi.com/manga/KitaharaTomoe/1044923377541046277", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/14", "thumbnail_src": "https://si.imgix.net/6e3a8e6b/uploads/origins/a23259b8-ea20-4395-83b0-b3e3bea7864a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67b4e4227a4aa48c92bf01e04997b506", "thumbnail_srcset": "https://si.imgix.net/6e3a8e6b/uploads/origins/a23259b8-ea20-4395-83b0-b3e3bea7864a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67b4e4227a4aa48c92bf01e04997b506, https://si.imgix.net/6e3a8e6b/uploads/origins/a23259b8-ea20-4395-83b0-b3e3bea7864a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d334fe84943e86321680235c33a8d378 2x, https://si.imgix.net/6e3a8e6b/uploads/origins/a23259b8-ea20-4395-83b0-b3e3bea7864a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=beceecfea9285868a576a6340d3cc107 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nマニアックなリクエストですが\n描いてもらいたいです。\n\n【概要】\n原神の蛍ちゃんのゴールデン泡を受けてしまった姿\n\n【詳細】\n①全身を映してツヤツヤになった身体を見て驚いてる姿\n女の子座りで起伏のない両手を見て驚いてる様な感じ\n\n②立ち上がれなくて悔しそうにしている姿\nオットセイの様な四つん這いの姿勢で涙目\n\n③腰に手を当てながら振り返る様な姿\n顔と胸とお尻が見える姿勢\n\n是非お願いします！", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/13", "thumbnail_src": "https://si.imgix.net/17f76de4/uploads/origins/e5f39b59-88e7-4d7f-9b48-bffed4d8a998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b210190c0c8d496e6ee720f1b0112f12", "thumbnail_srcset": "https://si.imgix.net/17f76de4/uploads/origins/e5f39b59-88e7-4d7f-9b48-bffed4d8a998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b210190c0c8d496e6ee720f1b0112f12, https://si.imgix.net/17f76de4/uploads/origins/e5f39b59-88e7-4d7f-9b48-bffed4d8a998?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8729c435d0e8efaf78bc754725b2d12d 2x, https://si.imgix.net/17f76de4/uploads/origins/e5f39b59-88e7-4d7f-9b48-bffed4d8a998?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0a0d7d230c305b9b3ce89d1dda70085 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/12", "thumbnail_src": "https://si.imgix.net/e19bbe4a/uploads/origins/0fd101d3-4b6f-4cd9-bd97-607d1a4ba6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89009599f3cb4f7b8c3f5d850c73b2d7", "thumbnail_srcset": "https://si.imgix.net/e19bbe4a/uploads/origins/0fd101d3-4b6f-4cd9-bd97-607d1a4ba6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89009599f3cb4f7b8c3f5d850c73b2d7, https://si.imgix.net/e19bbe4a/uploads/origins/0fd101d3-4b6f-4cd9-bd97-607d1a4ba6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c97e48bf6b2b5eb6220cf5fc6479673e 2x, https://si.imgix.net/e19bbe4a/uploads/origins/0fd101d3-4b6f-4cd9-bd97-607d1a4ba6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06659878603b036368487d4ee0ee855d 3x", "genre": "art", "nsfw": true, "body": "i'd like to get a piece similar to this   ( only the first image though https://x.com/p_kinaco/status/1744359857862447508/photo/1) of my centipede girl (though don't depict her centipede half  \n\nThe scenario would be of her at some sort of eating contest, enjoying the taste of human food since she doesn't get to eat it often\nthe first panel would be after she ate around 46 kg of food\nThe second panel would be after she ate 92 kg of food, with her slurping down a long stream of noodles with an elated expression on her face\nthe last panel would be after she ate the last bit of food, capping off at 140 kg, with her smacking the side of her taut belly with a confident/smug expression \n\nhere are the references for the piece, including her proportions and belly sizes through the sequence https://justpaste.it/getl3", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/11", "thumbnail_src": "https://si.imgix.net/76a959f6/uploads/origins/2e21fc03-876a-4d08-9e64-fa956eeac14e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e72c861de09db0f927a6c8019777655", "thumbnail_srcset": "https://si.imgix.net/76a959f6/uploads/origins/2e21fc03-876a-4d08-9e64-fa956eeac14e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e72c861de09db0f927a6c8019777655, https://si.imgix.net/76a959f6/uploads/origins/2e21fc03-876a-4d08-9e64-fa956eeac14e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b5b5f8e65a86c09fa9f61fbc4dd886d 2x, https://si.imgix.net/76a959f6/uploads/origins/2e21fc03-876a-4d08-9e64-fa956eeac14e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faa32897a7d46ffe44747725e7a22059 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/10", "thumbnail_src": "https://si.imgix.net/124675d9/uploads/origins/0aa3b9ed-41f4-4604-9935-07ba725fffa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41877ca36193395c112b01b4f84ef8b6", "thumbnail_srcset": "https://si.imgix.net/124675d9/uploads/origins/0aa3b9ed-41f4-4604-9935-07ba725fffa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41877ca36193395c112b01b4f84ef8b6, https://si.imgix.net/124675d9/uploads/origins/0aa3b9ed-41f4-4604-9935-07ba725fffa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a1f1619f0d772ab94495de99e549f90 2x, https://si.imgix.net/124675d9/uploads/origins/0aa3b9ed-41f4-4604-9935-07ba725fffa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4e8c6603334dcfcce949af0ecb406a4 3x", "genre": "comic", "nsfw": true, "body": "「混血のカレコレ」の「ヒサメ」と「ヨーメイ」の肥満化をお願いします。\n\nシチュエーション\n2人は満漢全席の食べ放題に招待されて遠慮なく食べておかわりもし続けた。\n初めは、お腹が膨らんでいき丸出しに出てきて、\n更に肥満化して服が破れて下着姿になる。\nブラのフロントホックが千切れる。\n最後は満足な顔をして座り込んでいるでお願いします。\n\n参考\nhttps://x.com/shakekoujou/status/1220537493663055872\n\n(ヒサメ)\n服の下が競り上がってお腹が飛び出る。\n自分のお腹を摩ったりポンポンと叩く。\n(ヨーメイ)\n服のボタンが全部取れてお腹が飛び出る。\n大きくなった自分の胸を鷲掴みにして感触を楽しむ。", "created_at": "", "completed_at": ""}, {"path": "/@plump_kinaco/works/9", "thumbnail_src": "https://si.imgix.net/2c531685/uploads/origins/9343b48c-bb14-475f-8126-bbd966f89bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fe0f6acbb5088bd298eca6caf6a625c", "thumbnail_srcset": "https://si.imgix.net/2c531685/uploads/origins/9343b48c-bb14-475f-8126-bbd966f89bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fe0f6acbb5088bd298eca6caf6a625c, https://si.imgix.net/2c531685/uploads/origins/9343b48c-bb14-475f-8126-bbd966f89bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt