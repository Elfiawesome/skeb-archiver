dle%2Ccenter&txtsize=30&txt=PRIVATE&s=395b3254f08fe1721f875d889dda7f03 2x, https://si.imgix.net/1661a612/uploads/origins/bce9f1ca-3cac-41ca-8fd4-48a77e2f022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3dcdc6b72067c0b727720dae7e6d38ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fals0811/works/74", "thumbnail_src": "https://si.imgix.net/09de81e4/uploads/origins/bbb97f06-b14d-4cc2-b625-30dce0158583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33128f0303fb8dd40b9daf8ed1e90c78", "thumbnail_srcset": "https://si.imgix.net/09de81e4/uploads/origins/bbb97f06-b14d-4cc2-b625-30dce0158583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33128f0303fb8dd40b9daf8ed1e90c78, https://si.imgix.net/09de81e4/uploads/origins/bbb97f06-b14d-4cc2-b625-30dce0158583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ff8f8305a18315e0a57a504f9b5fc10 2x, https://si.imgix.net/09de81e4/uploads/origins/bbb97f06-b14d-4cc2-b625-30dce0158583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43b42c3d0ba78fae2983b8243f70879a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fals0811/works/73", "thumbnail_src": "https://si.imgix.net/5b36dde7/uploads/origins/714cf8b6-0328-42c6-94d7-f5ce1043f047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dd3d77d5a2fd86833fc8e42473de1a6", "thumbnail_srcset": "https://si.imgix.net/5b36dde7/uploads/origins/714cf8b6-0328-42c6-94d7-f5ce1043f047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dd3d77d5a2fd86833fc8e42473de1a6, https://si.imgix.net/5b36dde7/uploads/origins/714cf8b6-0328-42c6-94d7-f5ce1043f047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f4d68c4904465554463ac4c046e9ea3 2x, https://si.imgix.net/5b36dde7/uploads/origins/714cf8b6-0328-42c6-94d7-f5ce1043f047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1f4dff0cea595675945303d75681f3b 3x", "genre": "art", "nsfw": false, "body": "いつもヤマ先生にお世話になりました！前回はとっても可愛らしいイラストを頂いたので、もしよろしければ、まだ私のオリジナルキャラクター描いて頂けないでしょうか？\n\n▼キャラー設定\n風口 海向（黒髪メガネ） 男性　20歳　身長170cm\n大学三年生、日本史民俗学専門学生。\n普段はいつも陰気な顔して、一旦古代民俗学の話すとおしゃべりになる。\n都会や近代、アイドル文化が嫌い。ややせっかちで怒りやすいなところもあり。\n\n石川 學（茶髪メガネ）　男性　21歳　身長173cm\n大学四年生、現代民俗学専門学生。\n誰からの頼みにも断るを言えない可哀想なおひとよし。よくからかいの対象になる。\n本人は自分のこと民俗学学者だと思って、あんまり外出歩くないから非常に不摂生をしている。一度研究に没頭してしまうと、ドアを閉めて食事もとらない。\n\n▼ポーズ・構図参考\nもしよろしければ、一枚のイラストに複數のやりとりを描いて頂けると嬉しいです！\nこちらのような↓\nhttps://skeb.jp/@fals0811/works/58\nhttps://skeb.jp/@fals0811/works/63\n\n日常生活の感じもいいし、少しグロや血、狂気などの表現も歓迎です！\nアヤ先生描いたやり取りとっても好きです(*´ω｀*)\n\n▼二人の関係\n二人は中学生の時にネットの掲示板で知り合った民俗学仲間です。\nただの趣味とは違い、二人とも大きな心志を持っている。\n研究内容は全く異なるが、お互いの研究を共有し、将来は自分の名前が入った論文を発表することを夢見ることができる仲である。\n\n風口海向はとても会話力がないので、誰かを怒らせた後、説明したり謝ったりするのは、たいてい石川学が担当することになります。\n風口海向は石川学の不摂生な生活習慣に口を挟む。例えば、戸締り研究中に弁当を自宅に届ける、掃除を手伝い、もっと運動するように言う、など。\n\n·補足（あんまり長いなので、見なくても良いですよ！）\nhttps://drive.google.com/drive/u/0/folders/1VULqd0s71zff1ArHTZWNUTUPpHFsUDJR\n\n▼補足\n時代は1999年です。\n\n▼参考画像\n風口海向（黒髪メガネ）＆石川學（茶髪メガネ）\nhttps://drive.google.com/drive/folders/1zCWoyE9iWXg7OpW6jzB12xLTit_2kF3I\n\n宛名は「柴ネギ」と書いて欲しい、もし良ければ宛名なしの差分をお願いします！ \nご検討のほどよろしくお願いいたします> <！！", "created_at": "", "completed_at": ""}, {"path": "/@fals0811/works/72", "thumbnail_src": "https://si.imgix.net/2769d21a/uploads/origins/f094a5da-73b7-41b2-b705-d4f1aa2aa6e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fi