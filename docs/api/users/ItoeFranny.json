fc9-aeb694387df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c8cfd581e330ef3797ec25d782d88e", "thumbnail_srcset": "https://si.imgix.net/db8066ca/uploads/origins/d2fdfc5f-fbcb-4539-9fc9-aeb694387df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c8cfd581e330ef3797ec25d782d88e, https://si.imgix.net/db8066ca/uploads/origins/d2fdfc5f-fbcb-4539-9fc9-aeb694387df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f02a3e66fafd4c8a986429b9573b8c1b 2x, https://si.imgix.net/db8066ca/uploads/origins/d2fdfc5f-fbcb-4539-9fc9-aeb694387df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1550ff96e7f1cd9a2100e15097cd4159 3x", "genre": "art", "nsfw": false, "body": "原神の蛍ちゃんお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ItoeFranny/works/21", "thumbnail_src": "https://si.imgix.net/a9b0e0d6/uploads/origins/04e6b094-fb1b-4c41-ae63-6a046fb86427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c437cf43a6e507f3d15204a9440245a", "thumbnail_srcset": "https://si.imgix.net/a9b0e0d6/uploads/origins/04e6b094-fb1b-4c41-ae63-6a046fb86427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c437cf43a6e507f3d15204a9440245a, https://si.imgix.net/a9b0e0d6/uploads/origins/04e6b094-fb1b-4c41-ae63-6a046fb86427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae4a473e02760bc43a8198b5eb054178 2x, https://si.imgix.net/a9b0e0d6/uploads/origins/04e6b094-fb1b-4c41-ae63-6a046fb86427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b155d96a7c4987a336797614d74f914c 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nテトリスのイラストが可愛く、メラニー、コラニー、ダラニー他3名バージョンも\n見たくなり送ります\n\n【詳細】\nポーズ参考\nhttps://x.com/itoefranny/status/1872331663499485213?s=46&t=Xc6K14nW4acYHdmhv-hdVA\n\n参考資料の様にポージングしてる4名をお願いします。\n画面を十字に4分割、田の様な感じで、\n（4名全員が見れれば4分割のやり方はお任せします。）\n\nフラニーさんは笑顔\nメラニーちゃんは真顔\nコラニーちゃんはあわあわ\nダラニーちゃんは丸まって寝る、なんなら布団入っててもいいです。ダラニーちゃんの枠にいつもの様にカニさんを入れてもらえると助かります。\n\nこの時の表情みたらテトリス版見たくなりました\nhttps://x.com/itoefranny/status/1796697965672931665?s=46&t=Xc6K14nW4acYHdmhv-hdVA\n\nご一考の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ItoeFranny/works/20", "thumbnail_src": "https://si.imgix.net/3dda89ea/uploads/origins/4ef767b7-7af3-4b2a-8b25-158c129c8aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f00387771543fe5939d7233355d280", "thumbnail_srcset": "https://si.imgix.net/3dda89ea/uploads/origins/4ef767b7-7af3-4b2a-8b25-158c129c8aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f00387771543fe5939d7233355d280, https://si.imgix.net/3dda89ea/uploads/origins/4ef767b7-7af3-4b2a-8b25-158c129c8aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60c0a04989a8162f413fd63cea136bfd 2x, https://si.imgix.net/3dda89ea/uploads/origins/4ef767b7-7af3-4b2a-8b25-158c129c8aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55d0af0748b83f147f99a259bfa33247 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています。手数料無料キャンペーンということでぜひお願いしたいと思いました。\n\n今回はマビノギに登場するNPCキャラクターの「ローワン」という子を描いて欲しいです。\n・公式立ち絵資料・魔法陣\nhttps://x.com/Nexon_Mabinogi/status/1689924608483606529\n・ゲーム画面でのビジュアル・デフォルメ姿\nhttps://x.com/Nexon_Mabinogi/status/1690921199600377856\n・公式ページ　公式ビジュアルがあります\nhttps://mabinogi.nexon.co.jp/campaign/beyond02/\n\n簡単な説明\n・可憐な見た目で神秘的な雰囲気だけど普段は「ふかふかのふとんから出たくない」「坂道登るのがつらい」\nと結構グータラ。でも魔法の訓練は真面目にやります。基本的には明るい性格です。\n・彼女の使う「ダークメイジ」の魔法はとても強力ですが、少々制御できない場面もあります\n・嫌いな食べ物は豆と豆料理。好物はシシケバブ\n\nこの子を絵フラニーさんの好きなように描いて見て下さい！好きなキャラなので可愛く描いてほしいです…！\n\n描いて頂けたらいつものように私のブログで紹介したいと思います。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ItoeFranny/works/19", "thumbnail_src": "https://si.imgix.net/499ce79a/uploads/origins/ffe9cf42-e380-4405-bb37-f833eb94b9e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=555e3c875399368794648abc6fc53839", "thumbnai