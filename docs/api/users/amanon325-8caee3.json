3d-0897-4d43-8e2b-4e2858e8e018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=262236dfc38f742522977101f677a738, https://si.imgix.net/11caee7f/uploads/origins/42d46f3d-0897-4d43-8e2b-4e2858e8e018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4668a2b658efa5d47f2951f48b6d6bca 2x, https://si.imgix.net/11caee7f/uploads/origins/42d46f3d-0897-4d43-8e2b-4e2858e8e018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e3ea9c0b191a377a578686e28f08d57 3x", "genre": "art", "nsfw": false, "body": "こんにちは、初めまして。\n少し前に先生が投稿してたクラスメイトモモイ概念のイラストが好きでフォローした通りすがりのものです。\n\n今回依頼したいのは、うちの子のネムです。\n参考ツイートの赤髪猫耳な子です。\n\nこの子が「偉いぞ〜ネム猫〜」っと頭を撫でられているシーンを描いて欲しいです。\n撫でられている時に耳をぴょこぴょこ動かしていると可愛らしくて良いですね。\n\n撫でている人の手は腕から先だけでも構いません。\n描いていただけるなら男性に撫でられているイメージでお願いします。\n\n服装は参考ツイートの学生服でお願いします。\nその他の細かいポーズやシチュエーションはお任せします。\n\nよろしくお願いします！\n\nhttps://x.com/kuku_nia09/status/1774796627020321030?s=61&t=zZM564I0FNmuI5mcjBltFQ", "created_at": "", "completed_at": ""}, {"path": "/@amanon325/works/1", "thumbnail_src": "https://si.imgix.net/40872f54/uploads/origins/dd695243-9e6a-40b8-90ff-3c1e392854b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a2564cbbada38c1ff0c8fd146e23bf", "thumbnail_srcset": "https://si.imgix.net/40872f54/uploads/origins/dd695243-9e6a-40b8-90ff-3c1e392854b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a2564cbbada38c1ff0c8fd146e23bf, https://si.imgix.net/40872f54/uploads/origins/dd695243-9e6a-40b8-90ff-3c1e392854b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=158981f550e99e1c72d388d4b4b152f7 2x, https://si.imgix.net/40872f54/uploads/origins/dd695243-9e6a-40b8-90ff-3c1e392854b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbe2af13094d19d1835dcc0176d203bc 3x", "genre": "art", "nsfw": false, "body": "Skebのメール広告であなたを見つけました。 私のO.Cを描いてください。 背景を描くことも希望します。\n\nhttps://drive.google.com/drive/fol