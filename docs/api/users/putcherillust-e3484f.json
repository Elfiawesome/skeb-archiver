44-bf14-c306b9c6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddffbe46929ffdd7c0f5032ba0782b1c", "thumbnail_srcset": "https://si.imgix.net/1d688ea2/uploads/origins/3f879b6e-7921-4844-bf14-c306b9c6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddffbe46929ffdd7c0f5032ba0782b1c, https://si.imgix.net/1d688ea2/uploads/origins/3f879b6e-7921-4844-bf14-c306b9c6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d6d9a83cfb93beeec76194c01287528 2x, https://si.imgix.net/1d688ea2/uploads/origins/3f879b6e-7921-4844-bf14-c306b9c6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8130138dbcdf55fb104778ffcdd56edf 3x", "genre": "art", "nsfw": false, "body": "いつも拝見しており、特にサイトウの絵がお気に入りです。\nそこでなのですが、サイトウがシャワーを浴びているところ後ろから見た絵を希望します。\n背中やお尻の筋肉に水滴が伝うところをややローアングルから見たいです。目線をこちらに送るか等細かいところはお任せします。どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@putcherillust/works/46", "thumbnail_src": "https://si.imgix.net/d6f11ad8/uploads/origins/a700138d-3251-48a1-aaa4-c49c25b343b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f20a0a1769d68feb96b1e904a2dfb79", "thumbnail_srcset": "https://si.imgix.net/d6f11ad8/uploads/origins/a700138d-3251-48a1-aaa4-c49c25b343b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f20a0a1769d68feb96b1e904a2dfb79, https://si.imgix.net/d6f11ad8/uploads/origins/a700138d-3251-48a1-aaa4-c49c25b343b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa856251eb95ee07cd731b33275fe391 2x, https://si.imgix.net/d6f11ad8/uploads/origins/a700138d-3251-48a1-aaa4-c49c25b343b5?bg=%23fff&auto=f