0-307aa210bda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef1d4e15d2a22d658134e8cd56a520fc", "thumbnail_srcset": "https://si.imgix.net/62600dcf/uploads/origins/b8a11e0a-8185-41a0-aa00-307aa210bda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef1d4e15d2a22d658134e8cd56a520fc, https://si.imgix.net/62600dcf/uploads/origins/b8a11e0a-8185-41a0-aa00-307aa210bda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7c7608672b8d9671aa8798662cb8c11 2x, https://si.imgix.net/62600dcf/uploads/origins/b8a11e0a-8185-41a0-aa00-307aa210bda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ced0555442d9cc46fc1f810e0ee23a44 3x", "genre": "art", "nsfw": true, "body": "アニメ「ワンピース」のアーロンパーク編からお願いがあります。幼いナミと幼いノジコを使いたいです。細かいところは人の感じ方次第でちょっと暗いです。\n\n母ベルメールの死後、ナミとノジコは故郷を守るためにアーロン海賊団に身を売った。彼らの知識、技術、そして肉体。故郷を守るために、二人は大金を築くか...。\n\nもしくは、子供でありながら生殖能力の高い若い女性であるため、アーロン海賊団を作るためにできるだけ多くのフィッシュマンを産まなければならない。性奴隷であり、海賊のための赤ん坊工場であることを意味する。\n\nナミとノジコは何度も孕まされ、出産させられ、欲望に堕ち、なぜアーロンから脱税したのか忘れてしまった。二人の体は廃墟と化し、生きるオナホールと化した。\n\nhttps://youtu.be/JvCJdpr1hAs\n\nhttps://pbs.twimg.com/media/Eaa_Hq2WsAAeyIk.jpg", "created_at": "", "completed_at": ""}, {"path": "/@12cut/works/17", "thumbnail_src": "https://si.imgix.net/6eff36a9/uploads/origins/1fdf4deb-a2ed-4067-a3bf-aea13a7cf0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02633d2b49bead3b3a25509de1cab695", "thumbnail_srcset": "https://si.imgix.net/6eff36a9/uploads/origins/1fdf4deb-a2ed-4067-a3bf-aea13a7cf0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02633d2b49bead3b3a25509de1cab695, https://si.imgix.net/6eff36a9/uploads/origins/1fdf4deb-a2ed-4067-a3bf-aea13a7cf0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=677e5a04469b3f549486af39570018fc 2x, https://si.imgix.net/6eff36a9/uploads/origins/1fdf4deb-a2ed-4067-a3bf-aea13a7cf0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ca8bedb4abf21b5cb2f5d9669f24410 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@12cut/works/16", "thumbnail_src": "https://si.imgix.net/4558eea5/uploads/origins/67bdc9f5-3c53-4798-9821-c06d57c4ca9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcfc7a537548d1880328ce38f74bbfbf", "thumbnail_srcset": "https://si.imgix.net/4558eea5/uploads/origins/67bdc9f5-3c53-4798-9821-c06d57c4ca9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcfc7a537548d1880328ce38f74bbfbf, https://si.imgix.net/4558eea5/uploads/origins/67bdc9f5-3c53-4798-9821-c06d57c4ca9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89d2d7faa6f731a8860c0962dab2bf48 2x, https://si.imgix.net/4558eea5/uploads/origins/67bdc9f5-3c53-4798-9821-c06d57c4ca9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17cb6994f43302ef3c6e3e128bc48333 3x", "genre": "art", "nsfw": true, "body": "僕のヒーローアカデミア』のエリが、ロリコン悪役と子作りセックスをして子供を産む。変態に捕まり、子作りをしようとする。\n\n悪役の力は「交尾」と呼ばれています。メスを自在にムラムラさせ、交尾相手を探させる能力だ。また、まだ妊娠できない若い女性にも子供を作らせることができる。\n\n絵里は恥ずかしがり屋で、体も小さくてか弱いが、大人のペニスをアソコに入れることに成功する。しかし、クリームを塗られ、妊娠してしまう。\n\nhttps://static.wikia.nocookie.net/bokunoheroacademia/images/6/61/Eri_Anime_Fullbody_Casual.png/revision/latest?cb=20200904064620", "created_at": "", "completed_at": ""}, {"path": "/@12cut/works/15", "thumbnail_src": "https://si.imgix.net/14bde811/uploads/origins/9e9b399f-c1eb-4268-b744-6b69f0317c66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200