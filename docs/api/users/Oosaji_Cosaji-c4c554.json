尻ポケットのウォークマンまたはスマホにつけていただくと有難いです。\nスタイルは以前skebで描かれていたイオフィみたいにお願いします。\n\nキャラ\nhttps://twitter.com/fusosinano/status/1502998427734487041\n\nヘッドホン\nhttps://twitter.com/fusosinano/status/1667530119840411650\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Oosaji_Cosaji/works/12", "thumbnail_src": "https://si.imgix.net/04d87a06/uploads/origins/bedb595e-6c19-48f1-99d7-41c17235e631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21623368a139651c7d2b653830c62802", "thumbnail_srcset": "https://si.imgix.net/04d87a06/uploads/origins/bedb595e-6c19-48f1-99d7-41c17235e631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21623368a139651c7d2b653830c62802, https://si.imgix.net/04d87a06/uploads/origins/bedb595e-6c19-48f1-99d7-41c17235e631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c591af259889700eb377307ab57333fb 2x, https://si.imgix.net/04d87a06/uploads/origins/bedb595e-6c19-48f1-99d7-41c17235e631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77e697fa36ffef363208cc0543c105d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Oosaji_Cosaji/works/11", "thumbnail_src": "https://si.imgix.net/1f99343c/uploads/origins/d23a1f02-4efd-4693-a7a9-0df56d1b0b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5706ec9b619f2b92618fc51ef493f50a", "thumbnail_srcset": "https://si.imgix.net/1f99343c/uploads/origins/d23a1f02-4efd-4693-a7a9-0