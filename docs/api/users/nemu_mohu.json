00&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=983ba0d07ac8a3df18292107dd0cf5a3", "thumbnail_srcset": "https://si.imgix.net/013b2a19/uploads/origins/c7320321-84a8-4e43-9915-72f71716b8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=983ba0d07ac8a3df18292107dd0cf5a3, https://si.imgix.net/013b2a19/uploads/origins/c7320321-84a8-4e43-9915-72f71716b8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83c91eedc73227c9893ec122ca343031 2x, https://si.imgix.net/013b2a19/uploads/origins/c7320321-84a8-4e43-9915-72f71716b8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b20421769473766cb333feb11e3c9290 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/62", "thumbnail_src": "https://si.imgix.net/edfca5d5/uploads/origins/b09e1935-4433-4f42-a11a-41a6f0780c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b905343431b513c4b9dfdeff4ea254c0", "thumbnail_srcset": "https://si.imgix.net/edfca5d5/uploads/origins/b09e1935-4433-4f42-a11a-41a6f0780c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b905343431b513c4b9dfdeff4ea254c0, https://si.imgix.net/edfca5d5/uploads/origins/b09e1935-4433-4f42-a11a-41a6f0780c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=534f310e81c86392fc1ae92b1210b2c9 2x, https://si.imgix.net/edfca5d5/uploads/origins/b09e1935-4433-4f42-a11a-41a6f0780c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9338309881e3362ad55413c2310d4588 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nとてもかわいいイラストを拝見し、是非にとリクエストさせていただきます。\n\n〇キャラ\nお隣さん（佐々木とピーちゃん）\nhttps://sasapi-anime.com/chara/chara03.html\nhttps://pbs.twimg.com/media/ErMfG-jVQAQVXzN?format=jpg&name=900x900\nhttps://pbs.twimg.com/media/EpuhDNmVoAA4Dez?format=jpg&name=large\n\n〇シチュ\n輪姦レイプ\n体位は後ろ矢筈\nお隣さんのお口と男性の性器とで、精液ブリッジ\n制服あり。おっぱい露出。\n胸は揉まれるか、乳首を摘まれている\nスカートも捲られ、パンツをずらして挿入\n\nできますれば挿入前→中出しまでの一連の流れをお願いしたいです。\n表情的には抵抗→感じてくる→逝く\n\nお隣さんは愛液を多めにしていただけると嬉しいです。\n\nレイプ系なので、難しい場合はキャンセルでも大丈夫です。\nご検討いただけますと幸いです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/61", "thumbnail_src": "https://si.imgix.net/92f9f2de/uploads/origins/aa2178be-bebc-4442-ab58-185132d0caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f631c9638c84ab1084edcfdcf21311", "thumbnail_srcset": "https://si.imgix.net/92f9f2de/uploads/origins/aa2178be-bebc-4442-ab58-185132d0caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f631c9638c84ab1084edcfdcf21311, https://si.imgix.net/92f9f2de/uploads/origins/aa2178be-bebc-4442-ab58-185132d0caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96bacd6f30459671a39f2c5e13012f03 2x, https://si.imgix.net/92f9f2de/uploads/origins/aa2178be-bebc-4442-ab58-185132d0caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1a39a3614bcfdabfe79b4c9d7ef6564 3x", "genre": "art", "nsfw": false, "body": "みかみ様、初めましてメールでのオススメで知り過去作品を見て大変魅力的だったので是非イラストをお願いしたいと思いました。\n個人Vtuberである凪乃ましろさんのライブ衣装のデザイン(海の歌姫ドレス)で構図などはそちにお任せしたいと思います。\n可能であれば白のましろんと黒のまくろんの差分もお願いしたいと思います。表情も複数あるとありがたいです。文字あり、なしや透過バージョンも頂きたいです。\n納品された際はましろさんのサムネイルやXでのポスト投稿を許可していただけると幸いです。\nよろしくお願いします。\n\n参考資料URL\nhttps://x.com/nagino_mashiro/status/1705845708610499031?s=46&t=vX6i-o1qEZaJL2fqwVKGNA", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/60", "thumbnail_src": "https://si.imgix.net/61625b2f/uploads/origins/b030e5ab-55db-49b1-96be-b25163866fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99ce6529c67a5afd83ec3ab7504041ef", "thumbnail_srcset": "https://si.imgix.net/61625b2f/uploads/origins/b030e5ab-55db-49b1-96be-b25163866fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99ce6529c67a5afd83ec3ab7504041ef, https://si.imgix.net/61625b2f/uploads/origins/b030e5ab-55db-49b1-96be-b25163866fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9a8699892f2e61d40565d53f1ea5507 2x, https://si.imgix.net/61625b2f/uploads/origins/b030e5ab-55db-49b1-96be-b25163866fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bafe227c44fc784225b6133565c32957 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/59", "thumbnail_src": "https://si.imgix.net/eea7b010/uploads/origins/8577a923-800f-4f66-9339-b79bd09d4ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52cf2a90f02067a7d2fffaa6de924ea1", "thumbnail_srcset": "https://si.imgix.net/eea7b010/uploads/origins/8577a923-800f-4f66-9339-b79bd09d4ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52cf2a90f02067a7d2fffaa6de924ea1, https://si.imgix.net/eea7b010/uploads/origins/8577a923-800f-4f66-9339-b79bd09d4ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c91e6212165acca37780851bdc42193b 2x, https://si.imgix.net/eea7b010/uploads/origins/8577a923-800f-4f66-9339-b79bd09d4ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79be1b6703402cb598afc14b52706d39 3x", "genre": "art", "nsfw": true, "body": "【キャラ】\n美少女ゲーム『放課後シンデレラ』の王城茉莉愛。\n\n【服装】\n前回と同じくシンデレラの服装、パンツなし。\nhttps://skeb.jp/@nemu_mohu/works/45\n\n【ポーズ】\n背面騎乗位、キス、おっぱい揉む。\n着衣セックス。\n\n【構図】\nハイヒール（少なくとも1つ）が見える絵。その分キャラが小さくなっても問題ありません。\n参考の絵（構図のみ）：\nhttps://www.pixiv.net/artworks/106754574\nhttps://www.pixiv.net/artworks/125746492\n\n【竿役】\n公住清史郎。顔なしでも大丈夫。\nhttps://vndb.org/c89999\n\n【差分】\n前回と同じく、さまざまな表情と体液の組み合わせをお願い致します。\nハート型の瞳は、ピンクと白でお願いできますと幸いです。\n効果線は別々で、文字なしで大丈夫です。\n\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/58", "thumbnail_src": "https://si.imgix.net/4d27e641/uploads/origins/504a0872-92b0-4cdc-8e67-9d2651e1382f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f28f581d367352a602f3574ea8a0024", "thumbnail_srcset": "https://si.imgix.net/4d27e641/uploads/origins/504a0872-92b0-4cdc-8e67-9d2651e1382f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f28f581d367352a602f3574ea8a0024, https://si.imgix.net/4d27e641/uploads/origins/504a0872-92b0-4cdc-8e67-9d2651e1382f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a04332d9f8d9ce129efbc69b5a30d432 2x, https://si.imgix.net/4d27e641/uploads/origins/504a0872-92b0-4cdc-8e67-9d2651e1382f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=498fd4963c588b4780715495d4381155 3x", "genre": "art", "nsfw": true, "body": "とある魔術の禁書目録よりローラ＝スチュアートの騎乗位セックスをお願いします。\n\n原作では物語とともにすごい役回りを演じていく彼女ですが\n小説アニメやゲームの平和な日常ではコミカルでかわいい場面も多く、時には作品のメタな話をしたり…\nそんなローラの平和な世界での濡れ場なシーンをお願いします\n\n\n・縦長の構図で、明るい順光のなかで、ローラは普段の修道服の上からでもわかる淫靡な肢体のヘアヌードを披露し\n・男性の腰の上で膝立ちで開脚しながら挿入を受ける騎乗位プレイ。\n（男性の身体はペニス（黒い陰毛）と腰一部程度の最小限の描写で十分です）\n（男性がセックスしながらカメラかなにかで自身の頭の視界と別の構図で撮影でもしている？的な感じです）\n\n・ローラの上半身はグラビア的な立ち絵みたいに画面と平行に近い\n・頭身は2次イラストでポピュラーな6.5頭身程度\n・上半身は右半身側をやや手前に、セクシーに腰を反らし、艶かしい両腋を強調する、（単調な左右対称ではなく）コントラストのある悩殺ポーズ。汗もかいている。\n・ローラの髪型は普段の修道服姿のもの\n・腕に顔は隠れず、腋も自然になるべく髪に隠れない\n・ローラのおっぱいは腕の動きに連動した自然な雰囲気の美乳（普通のヌードのように静止し、形が揺れる表現ではない）\n・恥丘には発育相応にすっかり逆デルタ▼に茂った髪色の陰毛が生えている　\n・蜜壺にペニスを挿入され中出しを受け、男の肉棒の隙間に精液が垂れでている\n・右腋には別人男性のペニス（陰茎と玉袋だけの描写、赤毛の陰毛）の亀頭を押し付けられ腋コキ（精液付き）を受けている\n・顔は結構正面寄り（でも全くの真正面ではない）に向け、少し頬を染め、ローラらしい垂れ目のかわいい両目を普段並に開いて、\n彼女の目線よりかすかに高いアイレベルのこちらへ画面越しに視線に向け、口を少し開けて可愛く微笑みかける\n\n・背景はごく簡単に、ステイルとのシーンがあった、湯気のある浴室の床らしき場所でセックスするイメージ。\n・吹き出しで行為中のローラから画面越しのこちらに、自身家のローラらしい台詞をお願いします\n\n\n◎以下はpsdのレイヤーで差分のオンオフ切り替え表示可能な形でお願いいたします\n・ローラの陰毛に加え、腋毛も\n・汗\n・男性の身体や体液…※ローラ一人でも自然な雰囲気のいわば膝立ちヌード\n・背景\n・吹き出し\n\n参考資料です。とくに顔はアニメ禁書らしさがあるまつ毛とかの雰囲気も意識いただいたうえで、可愛らしく描いていただけましたら\n\nhttps://www.gamer.ne.jp/news/201911110042/image/4/\nhttps://dengekionline.com/articles/214073/images/5/\nhttps://dengekionline.com/articles/5374/images/65/\nhttps://www.gamer.ne.jp/news/202306260034/image/4/\nhttps://www.4gamer.net/games/446/G044623/20221228149/screenshot.html?num=008\nmydaily0705.blog118.fc2.com/blog-entry-26.html", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/57", "thumbnail_src": "https://si.imgix.net/147860df/uploads/origins/7571c2b1-4c6a-400c-8cde-5f4f34290624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=296297a1cf191887fed7f8db6df106a4", "thumbnail_srcset": "https://si.imgix.net/147860df/uploads/origins/7571c2b1-4c6a-400c-8cde-5f4f34290624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=296297a1cf191887fed7f8db6df106a4, https://si.imgix.net/147860df/uploads/origins/7571c2b1-4c6a-400c-8cde-5f4f34290624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d6405af14cc486983aea1644d2bdba4 2x, https://si.imgix.net/147860df/uploads/origins/7571c2b1-4c6a-400c-8cde-5f4f34290624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc5ea491f063a6f744b9bd8b88e3ce4b 3x", "genre": "art", "nsfw": false, "body": "みかみさま、はじめまして。\n運営からのオススメクリエイターメールが届きたどり着きました。\n\nよろしければ自分の推しである花芽すみれを描いていただけないでしょうか？\nご検討お願いします。\n\n\n【内容と詳細】\n・ぶいすぽっ！所属　花芽すみれの一枚絵\n・見切れ無しの全身。\n・服装や髪型はこちら →https://drive.google.com/drive/folders/1hrl4eb7aUt-oLlWE-0KmIRC8hFvcS24W を参考にしてください。\n・背景は教室、構図ははおまかせします。\n・psd形式で背景とキャラクターを分けてください。\n・メガネの差分お願いします。(三面図にフレーム上のない公式メガネがあります)\n\nわかりにくいですが右目の下にホクロがあります。\nこちらで位置を確認してください。→https://x.com/sumire_kaga/status/1578002490263412736\n\n以上になりますがご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/56", "thumbnail_src": "https://si.imgix.net/026e4f40/uploads/origins/8fb914ef-869f-4531-8598-e0f3e18681d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe28d8e3d0de1ec5a9b43e7b40bf3e99", "thumbnail_srcset": "https://si.imgix.net/026e4f40/uploads/origins/8fb914ef-869f-4531-8598-e0f3e18681d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe28d8e3d0de1ec5a9b43e7b40bf3e99, https://si.imgix.net/026e4f40/uploads/origins/8fb914ef-869f-4531-8598-e0f3e18681d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccda0ce0fab377a34e0dff15c5a07eb7 2x, https://si.imgix.net/026e4f40/uploads/origins/8fb914ef-869f-4531-8598-e0f3e18681d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=809d5912b0bcef107b5dca916c3ee951 3x", "genre": "art", "nsfw": true, "body": "御世話になっております。今回の依頼ですが、私のOCのNSFWなイラストをお願い致します。\n\nhttps://x.com/mugenyu10/status/1959925132321026441\n\n桃華のプロポーションは他の方に描いて貰った際の\nhttps://x.com/mugenyu10/status/1969185641595392309\nバストの発育は同サイズかもう少し気持ち大きめで。\n\nシチュエーションは畳床の上の布団で正常位というもの。\n\n格好はパーカー全開でインナーたくし上げで両胸裸出。下は無し。\n\n表情差分は\n・事前：照れて期待の笑顔。\n・挿入：片目瞑り、口を開き挿入されて驚き。\n・射精：両目瞑り、口を開いて絶頂。中出しされてしまう。\n・事後：両目ともとろりとして口を軽く開き蕩けて呆けた感じ。事後は膣から精液が溢れ出ている状態と体中にぶっかけされているものが希望です。\n\nお忙しいとは思いますが宜しくお願いします。\n\nhttps://x.com/mugenyu10/status/1959925132321026441", "created_at": "", "completed_at": ""}, {"path": "/@nemu_mohu/works/55", "thumbnail_src": "https://si.imgix.net/5ae10baf/uploads/origins/c84ccb1c-4107-4122-8d19-3451c7516b5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ac9e54ce065dc6682ee7c6a9191f19d", "thumbnail_srcset": "https://si.imgix.net/5ae10baf/uploads/origins/c84ccb1c-4107-