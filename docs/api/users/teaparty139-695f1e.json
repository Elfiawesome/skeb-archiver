4f45-817b-c9bec518def4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6961182b69fad48f7f99162ff55755b3 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたのスタイルで私のキャラクターを描いてくれたら本当に嬉しいです。自由に好きなように描いてください。ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1NK4YdML75uf_D6XYqm2SPfw_hP650Grk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@teaparty139/works/36", "thumbnail_src": "https://si.imgix.net/a1a74781/uploads/origins/4b9fe572-de0c-4016-b759-e90d02ae9de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35de6be65fb041fd8be3d9b3e1b55894", "thumbnail_srcset": "https://si.imgix.net/a1a74781/uploads/origins/4b9fe572-de0c-4016-b759-e90d02ae9de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35de6be65fb041fd8be3d9b3e1b55894, https://si.imgix.net/a1a74781/uploads/origins/4b9fe572-de0c-4016-b759-e90d02ae9de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=030f3f65012dae72a08137926e5a1c44 2x, https://si.imgix.net/a1a74781/uploads/origins/4b9fe572-de0c-4016-b759-e90d02ae9de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fceabe508739bb6b9ca3f10d2a637189 3x", "genre": "art", "nsfw": false, "body": "オリキャラの「きなこ」を描いていただけますでしょうか。\n\nhttps://www.pixiv.net/artworks/72402686\nhttps://www.pixiv.net/artworks/76239048\nhttps://www.pixiv.net/artworks/78594803\nhttps://x.com/elcnusmedy/status/1495749783344267264\nhttps://drive.google.com/drive/folders/1tJpbH1YSWZFxgTOMHerCr7wH932aE_bK?usp=drive_link\n\nデスクトップ壁紙として鑑賞したいため、キャンパスの比率は3:2だと嬉しいです。\n（難しい場合は、縦長でも横長でも正方形でも大丈夫です）", "created_at": "", "completed_at": ""}, {"path": "/@teaparty139/works/35", "thumbnail_src": "https://si.imgix.net/50ec503b/uploads/origins/ef04b07c-11f9-41ed-b72a-e27d757c26e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed09bbcba48ad950df943a315246e931", "thumbnail_srcset": "https://si.imgix.net/50ec503b/uploads/origins/ef04b07c-11f9-41ed-b72a-e27d757c26e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed09bbcba48ad950df943a315246e931, https://si.imgix.net/50ec503b/uploads/origins/ef04b07c-11f9-41ed-b72a-e27d757c26e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1b3a1fbacd4e43d950abd856ba55b98 2x, https://si.imgix.net/50ec503b/uploads/origins/ef04b07c-11f9-41ed-b72a-e27d757c26e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d09326920090014e5d8588eedf28ee9 3x", "genre": "art", "nsfw": false, "body": "ちゃと様\n\n初めまして。Nekomi と申します。\n\n【依頼内容】\n\n元気いっぱいに挨拶する様子\n\nポーズ等は諸々お任せします。ご検討いただけますと幸いです。\n\n（参考: もしよりシンプルにしたい場合、「挨拶する様子」に変更可能です。楽しくするバージョンも検討いただけます。）\n\n【利用範囲】\n\n・個人SNSでの使用（Twitter (X)、Instagram、Facebookなど）\n\n・商用利用は致しません\n\n【イメージについて】\n\nSkeb の入力欄に参考となるイメージURLを記載しています。以下URLには参考イメージが格納されており、私の希望やキャラクター設定を把握するのに役立ちます。URL内の「_」で始まる画像は、イラスト制作の際の参考として自由にご活用ください。キャラクターの詳細な設定については、URL内のinfo.txt には、髪型、目の色、服装など、キャラクターを構成する重要な要素が記載されています。設定以外の部分は、ちゃと様の解釈で自由にアレンジしていただけると大変嬉しいです。\n\n【その他】\n\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://u.pcloud.link/publink/show?code=kZadtL5ZoKInkoTJpLXWDW4bRczk0jQT3fbX", "created_at": "", "completed_at": ""}, {"path": "/@teaparty139/works/34", "thumbnail_src": "https://si.imgix.net/b6ac99a7/uploads/origins/1b7b543b-b695-4784-ad3e-40a94449519c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=035074776f7c388c843fbc0f33b9f060", "thumbnail_srcset": "https://si.imgix.net/b6ac99a7/uploads/origins/1b7b543b-b695-4784-ad3e-40a94449519c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=035074776f7c388c843fbc0f33b9f060, https://si.imgix.net/b6ac99a7/uploads/origins/1b7b543b-b695-4784-ad3e-40a94449519c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e29b0ae425cc3a42e5d02256bf05cf75 2x, https://si.imgix.net/b6ac99a7/uploads/origins/1b7b543b-b695-4784-ad3e-40a94449519c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop