583-40f4-b365-8deac087474e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99f6d8270728b342287db6199bef5801", "thumbnail_srcset": "https://si.imgix.net/c96f59ef/uploads/origins/babb8d28-b583-40f4-b365-8deac087474e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99f6d8270728b342287db6199bef5801, https://si.imgix.net/c96f59ef/uploads/origins/babb8d28-b583-40f4-b365-8deac087474e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f14cdc35f8457ba9b38dfe4559708779 2x, https://si.imgix.net/c96f59ef/uploads/origins/babb8d28-b583-40f4-b365-8deac087474e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=424931fde55cbaa3df2759020f7532dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nあずにゃん様の絵柄がすごく好みです！\nよろしければうちの子も描いて頂けたら嬉しいです。\n\n◆使用用途\ntwitter等SNSでの画像使用\n\n◆三面図・キャラ参考資料\nこちら参考資料です。\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n\n◆服装\nhttps://twitter.com/azu_nyan117/status/1638146787067449346?t=rM-05EBaUVRHNUmBpOvjmA&s=19\nこちらの体操服ユウカがとても刺さりましたので、ぜひこんな感じの体操服コーデでお願いしたいです。\nまた、運動する際には長い髪が邪魔になりますので、髪を束ねるなどヘアコーディネートいただけると！\n\n◆構図、ポージング\n構図、ポージング等はお任せしますが、できれば素足の指先まで画面に収めていただけると嬉しいです。\n足指や爪の描写が好きなので、爪が多く見えるよう描いてほしいです。\n\n◆納品形式\nPSDとPNG希望です。\n\nご検討宜しくお願い致します。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "created_at": "", "completed_at": ""}, {"path": "/@azu_nyan117/works/2", "thumbnail_src": "https://si.imgix.net/dd7b1bf3/uploads/origins/d6d18c82-cebb-4eef-92ca-7156b91d430e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbbfbf3392dd087ae3342317d819178e", "thumbnail_srcset": "https://si.imgix.net/dd7b1bf3/uploads/origins/d6d18c82-cebb-4eef-92ca-7156b91d430e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbbfbf3392dd087ae3342317d819178e, https://si.imgix.net/dd7b1bf3/uploads/origins/d6d18c82-cebb-4eef-92ca-7156b91d430e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c6525ad2e2ed0296b93eba7332b2149 2x, https://si.imgix.net/dd7b1bf3/uploads/origins/d6d18c82-cebb-4eef-92ca-7156b91d430e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69fedd2b7bb1c134ada3dd8cd7679f1f 3x", "genre": "art", "nsfw": false, "body": "はじめましてローグ5と申します。\n\nSNSをきっかけにあずにゃん様の活動について知り、可愛く美しく勇者達を描いている事からイラストを依頼させていただきました。\n内容は以下の通りです。\n\n○キャラ\n三ノ輪銀(鷲尾須美は勇者である)\n\n〇衣装\n黒と赤のゴスロリ衣装でお願いします。細かなデザインはお任せしますが、牡丹を模した飾りがあり、また黒い小ぶりなシルクハットをかぶっているとなお良いです。\n\n○内容\n背景・ポーズはあずにゃん様のお好みで構いません。\n表情はわっしーやそのっちに対して「どう？似合ってるー？」と問いかけてる感じの笑顔でお願いします。\n\nあずにゃん様のイラストを楽しみにしております。\nどうかよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@azu_nyan117/works/1", "thumbnail_src": "https://si.imgix.net/7746c021/uploads/origins/06890372-5c73-46f2-a9db-818260965474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d44d5e2ffacfbdbaa3914813dc951d6b", "thumbnail_srcset": "https://si.imgix.net/7746c021/uploads/origins/06890372-5c73-46f2-a9db-818260965474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d44d5e2ffacfbdbaa3914813dc951d6b, https://si.imgix.net/7746c021/uploads/origins/06890372-5c73-46f2-a9db-818260965474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86e5f2f60234558e47a7ad0b12d518d6 2x, https://si.imgix.net/7746c021/uploads/origins/06890372-5c73-46f2-a9db-818260965474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff44e698799a2f7e7fb9bd5564c3c3d0 3x", "genre": "art", "nsfw": false, "body": "あずにゃん様、初めまして。\n宜しければ私のオリジナルキャラクター、沙奈のイラストをお願いいたします。\n\n銀髪ツーサイドアップ、深い赤色の瞳が特徴で明るい性格の女の子です。\n詳細は参考画像にてご確認お願いいたします。\n\n眼鏡はレイヤーを分けて頂けると幸いです。\nご検討宜しくお願いいたします。\n\nhttps://drive.google.com/file/d/1VbM_76Uj9cO9jigQOVrxvi63ScnpuztJ/view", "created_at": "", "completed_at": ""}]}