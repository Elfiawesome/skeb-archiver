ったりやたら近いことに疑問を抱く\n・痴漢され対処を試みるが周囲からも手が伸びてあっという間に表面の体勢に\n・最初は動けないながらも抵抗していたがおっぱい責めや前後二本刺しなどもあってやがて完堕ち\n・吊り下げられたまま全身精液塗れで完堕ちアヘ顔Wピース\n・目隠しとボールギャグを装着＆拘束され大型のスーツケースに詰め込まれた高雄。そのまま『荷物』として終点で電車を降ろされ男達のアジトへ拉致される(電車の痕跡は全て清掃済)\nまた男達の台詞や煽り文として\n・高雄のAVデビューをお祝い\n・電車が終点まで止まらないこと\n・堕ちた高雄に『妹ちゃんに会わせてあげる』『姉妹AVも撮ってやる』と発言し拉致\nなどをお願いします(高雄の台詞は徐々に快楽堕ちしていく感じで)\n\nまた前回映っていた翔鶴姉も一緒に責められる感じで、最後はついで＆口封じで一緒に拉致される描写をお願いします\n(ガッツリ映るのではなくよく見ると背景で同じような目に遭ってる・最後さらっとスーツケースが二つある、ぐらいで大丈夫です)", "created_at": "", "completed_at": ""}, {"path": "/@K0Rwz2a9OQOYV8v/works/74", "thumbnail_src": "https://si.imgix.net/d05ce1c6/uploads/origins/a5feb1af-36be-4a2e-a803-5dfe95e7c539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e7d56e133f326b3365b160fb9bc8f27", "thumbnail_srcset": "https://si.imgix.net/d05ce1c6/uploads/origins/a5feb1af-36be-4a2e-a803-5dfe95e7c539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e7d56e133f326b3365b160fb9bc8f27, https://si.imgix.net/d05ce1c6/uploads/origins/a5feb1af-36be-4a2e-a803-5dfe95e7c539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1c8f5f0689713cd5bf4c49cddc2af9b 2x, https://si.imgix.net/d05ce1c6/uploads/origins/a5feb1af-36be-4a2e-a803-5dfe95e7c539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d44c8fd21d001ea88b6bbc54c949788a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@K0Rwz2a9OQOYV8v/works/73", "thumbnail_src": "https://si.imgix.net/4f3c24b2/uploads/origins/b513bf1a-498d-4072-a475-4d5b9e2b3c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&