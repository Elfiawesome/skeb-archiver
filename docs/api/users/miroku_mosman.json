8624-929efa743394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27de3e34359c158275aa702a8cfca2b9 3x", "genre": "art", "nsfw": false, "body": "はじめまして!!\n\n36/みろく様の素敵なイラストに目を惹かれまして\n是非描いて頂きたくリクエストさせていただきました\n\n・FAとして描いて欲しい方はVtuberの雨月紫乃さんです\nX：https://x.com/amatsuki_shino\nYoutube：https://www.youtube.com/@amatsukishino（収益化済です）\nLitlink：https://lit.link/amatsukishino\n\n・構図・表情等すべておまかせしたいのですが希望として\n12/22に新衣装のお披露目がありましたのでこちらでお願いします\nXの固定 https://x.com/amatsuki_shino/status/2003401508872991033\n細部の確認はお手数ですが以下の配信アーカイブをご覧になっていただければと思います\nhttps://www.youtube.com/live/AA1P0-fNqsA?si=EfyiO01IchU_RA4E&t=6440\n\n・できれば耳や髪が見きれぬようしていただけれ幸いです\n・使用用途はVtuber活動全般（XやYoutubeでのアイコン、サムネイル等）\n・背景ある場合サムネや配信で使いやすいように人物のみの透過png\nもしくはレイヤー分けしたPSDデータで納品いただければ嬉しいです\n\nそれでは、ご検討のほど宜しくお願い申し上げます", "created_at": "", "completed_at": ""}, {"path": "/@miroku_mosman/works/27", "thumbnail_src": "https://si.imgix.net/26306d45/uploads/origins/568d3ef0-0ac7-450b-9ee8-d8c1a53c7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a19f87eddfe21a270ccb89087e222b7", "thumbnail_srcset": "https://si.imgix.net/26306d45/uploads/origins/568d3ef0-0ac7-450b-9ee8-d8c1a53c7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a19f87eddfe21a270ccb89087e222b7, https://si.imgix.net/26306d45/uploads/origins/568d3ef0-0ac7-450b-9ee8-d8c1a53c7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e4e650b1a4c0c7a167349a23ad045ee 2x, https://si.imgix.net/26306d45/uploads/origins/568d3ef0-0ac7-450b-9ee8-d8c1a53c7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bfd4b55f8d5ad411dd4b8f934393407 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@miroku_mosman/works/26", "thumbnail_src": "https://si.imgix.net/b2e03a2e/uploads/origins/33df9dfc-d86f-4fc7-88b8-0a037e9ed3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f0d67a06a43e4d1e52e837b9d0c85a", "thumbnail_srcset": "https://si.imgix.net/b2e03a2e/uploads/origins/33df9dfc-d86f-4fc7-88b8-0a037e9ed3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f0d67a06a43e4d1e52e837b9d0c85a, https://si.imgix.net/b2e03a2e/uploads/origins/33df9dfc-d86f-4fc7-88b8-0a037e9ed3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=793655a38f9c68cfdeb86930af8349c2 2x, https://si.imgix.net/b2e03a2e/uploads/origins/33df9dfc-d86f-4fc7-88b8-0a037e9ed3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb204905bb870a1e230bac63cdbdece6 3x", "genre": "art", "nsfw": true, "body": "初めまして！ツイートの募集から拝見しましたが、素敵なイラストが多すぎてリクエストさせて頂きました☺️\n(甘咲ねむるさんのマネージャーとしてお送りさせて頂きます。)\n\nもし宜しければ、よろしくお願いいたします！\n\n■対象\n甘(甘めの声) + 咲(サキュバス) + ねむる(ASMR)\nという由来の、少し意地悪でセクシーな、お姉さんメイド系ASMRVtuberです。R18も大丈夫です。\n(デビュー準備中)\n\n■シチュエーション\nhttps://skeb.jp/@miroku_mosman/works/14\nこちらのイラストがとんでもなく素敵でしたので\n- 和服\n- 下乳が見える\n- 太ももが見える\n- 履いてない感じで鼠蹊部がガッツリ見える\nシチュエーションでお願いできればと思っております:)\n衣装の細部についてはお任せします。元の衣装を気にしていただく必要はございません！\n\nもし可能でしたら、完全に局部が見えてる差分があるととても最高ですが、難しければ大丈夫です。\nもし金額が足りない場合は、再送要請いただければ幸いです！\n\n■使用用途\nSNSやYoutube、ファンクラブなどで使用させて頂く予定です\n\n■その他\n人物と背景がレイヤー分かれたPSDデータで頂けると大変ありがたいです。\n\nhttps://drive.google.com/drive/u/0/folders/1SVlhhwYhRvQ4cH59ecytF2GQ9DIHCrh1", "created_at": "", "completed_at": ""}, {"path": "/@miroku_mosman/works/25", "thumbnail_src": "https://si.imgix.net/857de960/uploads/origins/b334fd77-6135-45d5-84a0-b1838b49c8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dab856da07ebfc2bd8e21732337c7a80", "thumbnail_srcset": "https://si.imgix.net/857de960/uploads/origins/b334fd77-6135-45d5-84a0-b1838b49c8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dab856da07ebfc2bd8e21732337c7a80, https://si.imgix.net/857de960/uploads/origins/b334fd77-6135-45d5-84a0-b1838b49c8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20bd6ff7fbef4a262d5adf0c2123ec59 2x, https://si.imgix.net/857de960/uploads/origins/b334fd77-6135-45d5-84a0-b1838b49c8d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18c1b5c3e72eeba9a5e76fb0aa933609 3x", "genre": "art", "nsfw": false, "body": "はじめまして　素敵なイラストが目にとまったので依頼させていただきました！\n\nうちの子を描いていただきたいです\n参考資料▼\nhttps://drive.google.com/drive/folders/1o4Yv_lw_5nBnnJSfu0cRTvJ_S9YFjvy7?usp=sharing\n\nポーズや構図などはお任せします、先生の思うバニーガールといえばなポーズを描いていただきたいです\n何卒検討の方よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@miroku_mosman/works/24", "thumbnail_src": "https://si.imgix.net/1110d995/uploads/origins/583266a7-5d06-4ac4-ace1-ea883ed66914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c007f7a1de128b6bceda552a4239c8da", "thumbnail_srcset": "https://si.imgix.net/1110d995/uploads/origins/583266a7-5d06-4ac4-ace1-ea883ed66914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c007f7a1de128b6bceda552a4239c8da, https://si.imgix.net/1110d995/uploads/origins/583266a7-5d06-4ac4-ace1-ea883ed66914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b91d9a833e9002d50ab72a50df3c066 2x, https://si.imgix.net/1110d995/uploads/origins/583266a7-5d06-4ac4-ace1-ea883ed66914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edd6ac6a93b399d7fbe2ab88fac8e201 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして。\n𝕏のポストならびにSkebにてお描きになったイラストを拝見し、とても素敵だと思いまして、ぜひ一度私のFF14自キャラをお願いしたく思い、リクエストさせていただきました。\n\n【キャラのイメージ】\n- 白髪と薄紫の目\n- クールで知的な大人のお姉さんの雰囲気\n\n【希望要素】\n- さりげなく色気を感じさせる大人っぽい表現\n- 完全な裸露はなし\n\n服装は複数用意しておりますので、お好きなものをお選びいただければ幸いです。\n\nPCの壁紙やSNSのヘッダーとして使いたいので、横長の構図だと大変ありがたいです。\n構図・ポーズ・表情などはすべてお任せでお願いいたします！\n\nご検討いただけましたら嬉しいです！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1etyQ_C2lWyoYYly-Mip0A11UY6sUj2ig?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@miroku_mosman/works/23", "thumbnail_src": "https://si.imgix.net/b098a3f1/uploads/origins/4ca44339-1fd7-4ec5-a01c-a3dcd836ea49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4237e1e7e01e00a6d6bc50af60e1d4c2", "thumbnail_srcset": "https://si.imgix.net/b098a3f1/uploads/origins/4ca44339-1fd7-4ec5-a01c-a3dcd836ea49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4237e1e7e01e00a6d6bc50af60e1d4c2, https://si.imgix.net/b098a3f1/uploads/origins/4ca44339-1fd7-4ec5-a01c-a3dcd836ea49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=528034dc8cc61f0fae69a34ae2b80811 2x, https://si.imgix.net/b098a3f1/uploads/origins/4ca44339-1fd7-4ec5-a01c-a3dcd836ea49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f755d2f0eae70129cfb0ff0764e8728 3x", "genre": "art", "nsfw": false, "body": "36/みろく様\n前回は大変素敵なイラストありがとうございました！\n是非またお願いしたくリクエスト送らせて頂きます！\n\n【キャラクター】\n・ぶいすぽ所属VTの八雲べに様をお願い致します。\n【服装・髪型】\n・部屋着衣装(https://x.com/beni_yakumo/status/1886380740352659556）\n・メガネ、Tシャツ、カーディガンありで髪型はお任せします！\n・くくもイラストが入ったエプロンもオリジナルでお願いできればと思います。\n【構図・ポージング・背景】\n・キッチンにて手作りケーキを作っている感じで、指についたチョコレートを味見しながら「ぺろっ」な表情でお願いできればと思います。\n・ほっぺや鎖骨又は胸元辺りにチョコがついてる感じでお願いできればと思います。\n【使用用途・納品方法】\n・個人鑑賞\n・文字•キャラクター•背景等をそれぞれレイヤー分けされたPSDファイルをお願いしたいです。\n\n依頼内容と金額が合わなければお手数おかけしますが金額指定で再送依頼を送っていただけると有難いです。\n何卒ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@miroku_mosman/works/22", "thumbnail_src": "https://si.imgix.net/a4e38e9d/uploads/origins/ab162d89-01c2-4d91-bf9b-badedb1becac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&