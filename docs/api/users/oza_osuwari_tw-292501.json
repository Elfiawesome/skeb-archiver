a04f0ace5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=443c51955856f14ec269787d9e98e81a, https://si.imgix.net/1e884b6f/uploads/origins/f7e85103-7a12-4553-aa5f-43a04f0ace5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f298f63266db6ebc297da4b31d06f7a 2x, https://si.imgix.net/1e884b6f/uploads/origins/f7e85103-7a12-4553-aa5f-43a04f0ace5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=383d8a0a7a608549cf470ee8b836cee6 3x", "genre": "art", "nsfw": true, "body": "もしよろしかったら下記の内容でお願いいたします。\n\n■キャラクター\nプリンセスコネクト!Re:Diveのチエル(聖学祭)\n\n■シチュエーション\n体操服着衣の状態の膝上パイズリで乳内射精\n参考資料のように膝上に乗っているのが分かる構図。\nhttps://skeb.jp/@oza_osuwari_tw/works/43", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/57", "thumbnail_src": "https://si.imgix.net/8ccda053/uploads/origins/9aab68ed-128d-4fab-b1ba-8efe3178fc3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=035fdc26506ae3af0e5761fcec103f24", "thumbnail_srcset": "https://si.imgix.net/8ccda053/uploads/origins/9aab68ed-128d-4fab-b1ba-8efe3178fc3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=035fdc26506ae3af0e5761fcec103f24, https://si.imgix.net/8ccda053/uploads/origins/9aab68ed-128d-4fab-b1ba-8efe3178fc3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=336ef4c366f27dc0a40e6bde47abe7a3 2x, https://si.imgix.net/8ccda053/uploads/origins/9aab68ed-128d-4fab-b1ba-8efe3178fc3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f12d4dd2dcf9c19cdd114ae52dd5981c 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です　いつもイラスト楽しみにしてます。\nリクエストになります\n\n●キャラクター\nNIKKEのアニス\n\n●構図\n今回は実際に竿を挟むのではなく、\n膝上パイズリする前に、女の子が男性の膝に腰を乗せる準備の描写になります\n挟む前に男性の脚を持ち上げ、おっぱいの前に引き寄せる感じのやつです\n竿役をしっかりと膝乗せしていることがわかるように、女性の脚、男性の腹部分くらいまで描写していただきたいです(少し引きのアングル)\n\n●シチュエーション、台詞など\n男性は太ももに感じるおっぱいの重みを噛み締めている\n「はい腰上げてねー」といった\n今からこの質量に挟まれるんだぞ、という淫行予告っぽいセリフをお願いしたいです\n\n体重と主導権を預ける感じと、これから始まる行為への期待感　を表現していただけたらと思います\n細かいところはアレンジしていただいて構いません\nご多様な中ですが、ご検討お願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/56", "thumbnail_src": "https://si.imgix.net/29a95319/uploads/origins/8c11c1ad-e0ec-47c2-ab30-53edc731edd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=715a3561fd700ca7f76bd2832e05d87e", "thumbnail_srcset": "https://si.imgix.net/29a95319/uploads/origins/8c11c1ad-e0ec-47c2-ab30-53edc731edd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=715a3561fd700ca7f76bd2832e05d87e, https://si.imgix.net/29a95319/uploads/origins/8c11c1ad-e0ec-47c2-ab30-53edc731edd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cefc70e5841935ac3b30de91d39ca20e 2x, https://si.imgix.net/29a95319/uploads/origins/8c11c1ad-e0ec-47c2-ab30-53edc731edd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aeecc29dfc50fce5d269b8f75f070f8b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/55", "thumbnail_src": "https://si.imgix.net/25938120/uploads/origins/23628119-6453-4ce0-afd8-eeebab7b0273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e106557514c413c730e19eb0e6f7b3", "thumbnail_srcset": "https://si.imgix.net/25938120/uploads/origins/23628119-6453-4ce0-afd8-eeebab7b0273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e106557514c413c730e19eb0e6f7b3, https://si.imgix.net/25938120/uploads/origins/23628119-6453-4ce0-afd8-eeebab7b0273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e95c34b2b76ddc3c098f4274ee1e2aee 2x, https://si.imgix.net/25938120/uploads/origins/23628119-6453-4ce0-afd8-eeebab7b0273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a51c058f890d15f9220d8f94edd6c828 3x", "genre": "art", "nsfw": true, "body": "以前描いていたブルーアーカイブのチヒロが可愛かったのでリクエストします。\nチヒロの膝上パイズリを描いてください。ミネのような差分形式でも、ホーネットⅡのコマ割り形式でも構いません。\n着衣→ズリ→発射→ザーメンブリッジ事後をお願いします。眼鏡まで精液がかかってると良いです。\nデカ乳輪にしてください。このぐらい～これより少し大きいのが希望です。（https://misskey.io/notes/9v7fe5rwkhv6090d）。\n\n衣装・背景はお任せします。\n\nhttps://x.com/Blue_ArchiveJP/status/1485462400371363843", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/54", "thumbnail_src": "https://si.imgix.net/0136767f/uploads/origins/ba28d733-20e2-472b-aec8-59fd9f7bc9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc059d3fb19e69db535d559d9853cdaa", "thumbnail_srcset": "https://si.imgix.net/0136767f/uploads/origins/ba28d733-20e2-472b-aec8-59fd9f7bc9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc059d3fb19e69db535d559d9853cdaa, https://si.imgix.net/0136767f/uploads/origins/ba28d733-20e2-472b-aec8-59fd9f7bc9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81a253150a0b7016f37ffaecea5ef6b9 2x, https://si.imgix.net/0136767f/uploads/origins/ba28d733-20e2-472b-aec8-59fd9f7bc9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c67529334eec017758e14b45fa1e1de 3x", "genre": "art", "nsfw": true, "body": "ブルーアーカイブのイラストをリクエストさせてください！\n\nプレイされているようなのでゲームはご存じだと思うのですが、「水羽ミモリ」のパイズリイラストをお願いしたいです。\n通常の制服姿でトップスをたくし上げて膝上パイズリしているイラストで、主観視点の構図が希望ですが、描き方はお任せします。\nできたら射精前後の差分があると嬉しいですが、金額的に受けられなければ射精後だけか、差し戻してもらえたらと思います。\n検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/53", "thumbnail_src": "https://si.imgix.net/6f37b288/uploads/origins/398ba922-f9df-4a79-9aa5-6a3d615f2f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b76cae2f28da35a29ad180e9b31dc5bc", "thumbnail_srcset": "https://si.imgix.net/6f37b288/uploads/origins/398ba922-f9df-4a79-9aa5-6a3d615f2f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b76cae2f28da35a29ad180e9b31dc5bc, https://si.imgix.net/6f37b288/uploads/origins/398ba922-f9df-4a79-9aa5-6a3d615f2f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d33285719d8631165ffd7245e8a3d3ba 2x, https://si.imgix.net/6f37b288/uploads/origins/398ba922-f9df-4a79-9aa5-6a3d615f2f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d336812a71399ac0ac51d2558611943 3x", "genre": "art", "nsfw": true, "body": "キャラ\nホーネットⅡ(アズールレーン)\n\n衣装\n大海原を駆けよ\nhttps://x.com/azurlane_staff/status/1604677411127590912\n\nシチュ内容\n\nskebのアツコカラー1P漫画作品の様な漫画形式\n\n①衣装イラストの体位を正面から見た構図\n水着が乳から離れていて、モロ見え状態\nホーネットは全く気づいてなく笑みをキープ\n「ん？指揮官なんで前屈みになってんの？」というセリフがある\n②そのまま、人目につかない岩陰に連れて込まれ、“縦”パイズリをしてもらうことに\nホーネットは状況を理解し、パイズリのリードを取り、激しくして射精を促していく\n③乳内射精、精液は比較的多め\n④おっぱいを左右に開きザーメンブリッジ披露\n\nその他\n・お坐さんの描く乳首が好きなので、可能であれば全コマ、両方とも隠れてない状態でお願いします\n・差分追加の色付け方がわからないので、金額面で問題がありましたら条件付き再送をご検討ください。\n\n夏コミ脱稿お疲れ様です。\nskeb再開されたのでリクエストを送らせていただきました。\nご確認、宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/52", "thumbnail_src": "https://si.imgix.net/77fb2745/uploads/origins/7381de60-4bdc-445f-b65b-423fe9201be9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf50f68bda82183dc2ee4510a9481eb8", "thumbnail_srcset": "https://si.imgix.net/77fb2745/uploads/origins/7381de60-4bdc-445f-b65b-423fe9201be9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf50f68bda82183dc2ee4510a9481eb8, https://si.imgix.net/77fb2745/uploads/origins/7381de60-4bdc-445f-b65b-423fe9201be9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9988e4507ebc45d7928b2cfa091a838a 2x, https://si.imgix.net/77fb2745/uploads/origins/7381de60-4bdc-445f-b65b-423fe9201be9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ccc2aad418e639dd5a7dc7195b0f6e2 3x", "genre": "art", "nsfw": true, "body": "お坐先生\n\nはじめまして。\nクオリティの高いパイズリイラストにいつもお世話になっております。\n是非描いていただきたいシチュエーションがあるため、ご依頼させて頂きます..!!\n\n■キャラクター\n　含英　衣装：https://imgur.com/a/nsVYuYE\n　　　　ｾﾘﾌ：https://imgur.com/a/DdZpAin\n　　　　呼び方：→悠悠(ﾖﾖ)\n　蒲牢　衣装：https://imgur.com/a/2E1TNsX\n　　　　ｾﾘﾌ：https://imgur.com/a/GeBpnfw\n　　　　呼び方：→含英姉さん\n\n■シチュエーション\n　ふたなり(蒲牢)x女性(含英)のシチュエーションを希望します。\n　突然生えた立派なモノを性処理のやり方が理解らない蒲牢の代わりに、\n　　含英が胸で一物を包み込む→女性優位のパイズリ&乳首責め→ザーメンブリッジ　\n　の様なシーンをお願いいたします!!\n\n■その他\n　ふたなり側のキャラは顔を映さなくて大丈夫です、パイズリの映える構図を優先頂けると嬉しいです。\n\nご検討頂けると幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/51", "thumbnail_src": "https://si.imgix.net/3e5f2ec5/uploads/origins/94d253c7-0225-45bf-9b9d-5e48a4f9688c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf2c20a4799cfbc226e4c6110ea5054", "thumbnail_srcset": "https://si.imgix.net/3e5f2ec5/uploads/origins/94d253c7-0225-45bf-9b9d-5e48a4f9688c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf2c20a4799cfbc226e4c6110ea5054, https://si.imgix.net/3e5f2ec5/uploads/origins/94d253c7-0225-45bf-9b9d-5e48a4f9688c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f711632a4576dbd2587e2eb66f1acb5 2x, https://si.imgix.net/3e5f2ec5/uploads/origins/94d253c7-0225-45bf-9b9d-5e48a4f9688c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb61f97ac294b13c44aa9202f06bd287 3x", "genre": "comic", "nsfw": true, "body": "初めまして、ブルアカの尾刃カンナの着衣パイズリの内容をお願いしたいです。\n\nシチュエーションとしては\n・ベッドとかに両手を頭上で縛られてるジャケットを脱いだ状態のカンナ。\n・馬乗りになって胸を責めながらカンナに着衣パイズリ。\n・ブラを外されてるので勃起して浮かんだ乳首の辺りも責められ、感じさせられながらも先生に辞めてもらえるように懇願。\n・乳内射精と一緒にカンナも胸で絶頂。Yシャツもドロドロで染みになるくらいに精液塗れにされ(シャツの首元にも溢れそうになってるイメージ)荒く息を吐いているカンナ。\n・実は陵辱ではなくそういうイメプレで、精液塗れの胸の処理を行いながら恥ずかしそうに先生に射精し過ぎですと怒るカンナと、カンナも胸でイったじゃんと返す先生。\n・バツが悪そうにしながらもこの後まだ時間はありますか？と本番を匂わせるようなカンナ。\n\nといった内容になります。\n先生のデザインは特に考えていないのでお任せします。\n良ければ検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/50", "thumbnail_src": "https://si.imgix.net/d54da763/uploads/origins/98b206a1-d12e-4639-b662-6b94f8b1373b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be296a2e96fe9f192d6071fc6d361aaa", "thumbnail_srcset": "https://si.imgix.net/d54da763/uploads/origins/98b206a1-d12e-4639-b662-6b94f8b1373b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be296a2e96fe9f192d6071fc6d361aaa, https://si.imgix.net/d54da763/uploads/origins/98b206a1-d12e-4639-b662-6b94f8b1373b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d56b7ec32278c39f68cbc02c7207f78 2x, https://si.imgix.net/d54da763/uploads/origins/98b206a1-d12e-4639-b662-6b94f8b1373b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b280b034de52feca1610ef3e461c752c 3x", "genre": "art", "nsfw": true, "body": "ご検討お願いします。\n\nブレマートン(５周年アニバーサリー抱き枕の眼帯金ビキニカウガール)による、「馬乗りパイズリ」を希望します。\n\nビキニは着たまま、跨った指揮官がデカパイを鷲掴みにしながら必死に腰振りをするも、不意に乳圧を強められ情けなく早撃ち射精をキメてしまう…….というシチュエーションです。\n\nマウントポジションを取られながらも終始ブレマートン優位で、エロコスデカパイに興奮しまくって「絶対おっぱい孕ませる💢」や好き好き♡ を連呼しながら谷間にチンポ突っ込みまくる指揮官を可愛い♡ と思いながら「ちゃんと上手にぴゅっぴゅできるかな〜？」「ははん、ぎゅーってされちゃうのたまらないカンジ？」と余裕たっぷりにザーメンコキ捨て乳内射精を導いて欲しいです。\n\nhttps://x.com/azurlane_staff/status/1569552230688374784\n\nhttps://x.com/azurlane_staff/status/1569552230688374784", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/49", "thumbnail_src": "https://si.imgix.net/44c3234b/uploads/origins/b9cb0a7c-d14a-4d62-8bcc-cefcca449c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87047cf058efd0adb0216c110acb5c18", "thumbnail_srcset": "https://si.imgix.net/44c3234b/uploads/origins/b9cb0a7c-d14a-4d62-8bcc-cefcca449c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87047cf058efd0adb0216c110acb5c18, https://si.imgix.net/44c3234b/uploads/origins/b9cb0a7c-d14a-4d62-8bcc-cefcca449c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86a404cca81f4894722c0ce74cad50ff 2x, https://si.imgix.net/44c3234b/uploads/origins/b9cb0a7c-d14a-4d62-8bcc-cefcca449c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe8985c534bbda467cf3314cfc21327b 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nブルアカの蒼森ミネのパイズリイラストをお願いします。\n\n胸が露出されている格好かつ射精〜ブリッジ見せの差分を入れていただけたら嬉しく、その他のズリ方等はお任せしたいです。\n\n曖昧な内容となりますがご検討いただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/48", "thumbnail_src": "https://si.imgix.net/c21b7c85/uploads/origins/07d6a611-2a1a-4476-8c97-077bbbdf4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f7688dbd54441f9713a5a31f41da8d", "thumbnail_srcset": "https://si.imgix.net/c21b7c85/uploads/origins/07d6a611-2a1a-4476-8c97-077bbbdf4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f7688dbd54441f9713a5a31f41da8d, https://si.imgix.net/c21b7c85/uploads/origins/07d6a611-2a1a-4476-8c97-077bbbdf4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=584244daed420b35ec2de3b8938aedc9 2x, https://si.imgix.net/c21b7c85/uploads/origins/07d6a611-2a1a-4476-8c97-077bbbdf4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f46bd04d8b6246a9f25b85adb312fa41 3x", "genre": "comic", "nsfw": true, "body": "ブルーアーカイブのキララちゃんのえっち漫画を何ページかお願いします。\n\nギャルJKキララちゃんに甘々授乳手コキされたい漫画。母乳は本当に出てください。\n\n\n先生疲れてるんだね〜。\n\nあたしのおっぱいで癒やされてよ〜。\n\n本物の赤ちゃんみたいでかわいい〜。\n\nもぉ〜、赤ちゃんはそんなにえっちな吸い方しないって〜。\n\nやだっ♡この吸い方ほんとやばいって♡\n\nイクッ♡♡♡♡♡\n\nと授乳してたら気持ちよくなっちゃって絶頂してしまうキララちゃん。\n\n先生、あのさ、あたしもう我慢できないんだけど。\n\nと濡れ濡れのパンツを見せてくるキララちゃん。\n\nこんなこと言われたらもう本気種付するしかない。\n\nまんぐり返しでおちんぽを挿入。\n\n先生♡先生♡♡　と子宮におちんぽ叩きつけられて感じるキララちゃん。\n\n先生に本気ピストンされて先生の赤ちゃん生みたくなっちゃう。\n\n一瞬まずいと抜こうとしたが、\n\nそのまま♡そのまま射精して♡♡\n\nとお願いされておまんこの一番深いところに膣内射精してしまう先生。\n\nおちんぽ引き抜かれておまんこから精液を溢れさせながら幸せそうにしているキララちゃん。", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/47", "thumbnail_src": "https://si.imgix.net/748271fc/uploads/origins/a19eaca7-4967-4eb3-9cad-a4f1ceaad9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dc1cc4fb4d30e99ff0c896470b0505a", "thumbnail_srcset": "https://si.imgix.net/748271fc/uploads/origins/a19eaca7-4967-4eb3-9cad-a4f1ceaad9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dc1cc4fb4d30e99ff0c896470b0505a, https://si.imgix.net/748271fc/uploads/origins/a19eaca7-4967-4eb3-9cad-a4f1ceaad9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a3d906c7b313778e520b9f43c61213c 2x, https://si.imgix.net/748271fc/uploads/origins/a19eaca7-4967-4eb3-9cad-a4f1ceaad9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9edf3ac4bfe5e99627e2d67c731a57ea 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nアズールレーンのイントレピッドを3つのバリエーションで依頼したいです。この服（https://danbooru.donmai.us/posts/6122681?q=intrepid_%28azur_lane%29）を着た彼女を描いてください。最初のバージョンは、この写真(https://danbooru.donmai.us/posts/6296229?q=satou_aji)のように、恥ずかしそうな表情で男性にパイズリをする彼女を描いてください。\n2つ目のポーズは、胸の間からザーメンが吹き出ているところを、驚いた表情で描いてください。3つ目のバリエーションは、胸とブラにザーメンがついた状態で、見る人に温かく微笑みかけながら描いてください。また、胸にほくろをつけるのも忘れずに。ヘアスタイルはこれ（https://danbooru.donmai.us/posts/6318712?q=intrepid_%28azur_lane%29）を参考にしてほしい。", "created_at": "", "completed_at": ""}, {"path": "/@oza_osuwari_tw/works/46", "thumbnail_src": "https://si.imgix.net/08d897b0/uploads/origins/dd57f648-d54b-47ea-9f7d-32fd15577740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5236d7180de6eaaa1608628c326bda", "thumbnail_srcset": "https://si.imgix.net/08d897b0/uploads/origins/dd57f648-d54b-47ea-9f7d-32fd15577740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5236d7180de6eaaa1608628c326bda, https://si.imgix.net/08d897b0/uploads/origins/dd57f648-d54b-47ea-9f7d-32fd15577740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a2b76b79610941fa17500c2ab4b9f1c 2x, https://si.imgix.net/08d897b0/uploads/origins/dd57f648-d54b-47ea-9f7d-32fd15577740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f3c356b125048b899485d32c6b91c5f 3x", "genre": "art", "nsfw": true, "body": "前回のご納品が大変すばらしく、またお願いしたく思います。\n今回もプリコネのノゾミでお願いします。\nノゾミの衣装は以下のものでお願いします。衣装は鎧部分は脱がさずスカートなども着衣でお願いします。\nhttps://redive.estertion.win/card/full/102931.webp\n体位は主観視点の騎乗位でお願いします。\n激しく腰を振る感じではなく、ぺたんこ座りでねちっこく膣内で竿役の騎士君のおちんちんを虐めているようにしてください。\n片手を恋人握りにして、もう片手は押さえつけるように強く騎士君の胸元においてください。\nノゾミの手の爪をかなり長くしてください。\n瞳をこちらのシラのように少し怪しく発光させているような雰囲気にしてください。\nhttps://www.pixiv.net/artworks/114044813\n胸は前回と同じくらい爆乳にしてください。\n前回の膝上パイズリの続きのシチュエーションで、胸の谷間には大量の精液を貯め池みたいにこびりつけてください。\nノゾミはとても楽しそうでいじわるそうな表情で、舌なめずりをしています。\n騎士君はパイズリからのそのまま連続セックスと連続射精で、精液をドバドバとノゾミに吸い尽くされながら全身がカタカタ震えているようにしてください。\n前回と同じく射精前、中、後で表情差分を頂けると大変うれしいです。\nまた、可能であればエロ擬音とセリフもお願いします。\n支援サイトでみましたセリフ描写が天才的なセンスがありましたので、出来ればいっぱい意地悪なセリフを言わせて騎士君から搾り尽くして欲しいです。\n\n2度目のリクエストになりますが、よろしければお願いいたします。\n\nhttps://skeb.jp/@oza_osuwari_tw/works/43", "created_at": "", "completed_at": ""}]}