.net/3fb0dd5b/uploads/origins/38e23c3d-cc0b-4a3b-99bb-bfee8ccaf091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=429736d3a36a2be5cb486e9269d76c96", "thumbnail_srcset": "https://si.imgix.net/3fb0dd5b/uploads/origins/38e23c3d-cc0b-4a3b-99bb-bfee8ccaf091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=429736d3a36a2be5cb486e9269d76c96, https://si.imgix.net/3fb0dd5b/uploads/origins/38e23c3d-cc0b-4a3b-99bb-bfee8ccaf091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d876d56ee53f9bee35b99eaa941f178 2x, https://si.imgix.net/3fb0dd5b/uploads/origins/38e23c3d-cc0b-4a3b-99bb-bfee8ccaf091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1dedd5e15d1c27819ee6173763ba70f 3x", "genre": "art", "nsfw": true, "body": "アークナイツのモスティマで立ち絵と平面化6種類(横平面化、縦平面化、反物化、のっぺり、引き伸ばし、アコーディオン)を描いてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@tai0415/works/63", "thumbnail_src": "https://si.imgix.net/fb1a0456/uploads/origins/a37a33a5-d444-4727-96c3-49082a7eb152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dc698e0269def1e9f84feccfb50170b", "thumbnail_srcset": "https://si.imgix.net/fb1a0456/uploads/origins/a37a33a5-d444-4727-96c3-49082a7eb152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dc698e0269def1e9f84feccfb50170b, https://si.imgix.net/fb1a0456/uploads/origins/a37a33a5-d444-4727-96c3-49082a7eb152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ccdb0c0870a20f2e68d2b83e5677f31 2x, https://si.imgix.net/fb1a0456/uploads/origins/a37a33a5-d444-4727-96c3-49082a7eb152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop