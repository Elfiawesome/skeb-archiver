025-09-27T00:59:18.322572"}, {"amount": 4000, "recorded_at": "2025-10-03T16:58:56.416278"}]}, "current_prices": {"art": 5000, "correction": 500, "video": 4000}, "price_range": {"art": {"min": 3000, "max": 5000}, "correction": {"min": 500, "max": 500}, "video": {"min": 4000, "max": 4000}}, "links": [{"label": "Twitter", "url": "https://x.com/sinocya", "name": "sinocya"}], "flags": {}, "works": [{"path": "/@sinocya/works/220", "thumbnail_src": "https://si.imgix.net/79517713/uploads/origins/6876c7cb-48b0-4e8d-bae8-f95571ecb9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e46ac09876dfd84e6b1508565aa00b80", "thumbnail_srcset": "https://si.imgix.net/79517713/uploads/origins/6876c7cb-48b0-4e8d-bae8-f95571ecb9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e46ac09876dfd84e6b1508565aa00b80, https://si.imgix.net/79517713/uploads/origins/6876c7cb-48b0-4e8d-bae8-f95571ecb9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd6fa94a598300490f956cb40f7c8748 2x, https://si.imgix.net/79517713/uploads/origins/6876c7cb-48b0-4e8d-bae8-f95571ecb9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ce748db6aef89c96fbe5567a373b4ed 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ずっとあなたの作品を拝見していますが、本当に楽しくて素敵です！表情やポーズがとてもお気に入りです！私のキャラクター、カズコを描いていただけないでしょうか。彼女は優しい女性で、生涯の親友であり夫であるムラマクの妻であり、双子のネイトとローラの母親です！ 本（作家として働いています）、お菓子、歌うこと、ガーデニング、オフィス用のかわいいぬいぐるみ収集、そして様々な衣装で着飾ることが大好きです。思いやりのある母親であり献身的な妻としての温かく愛情深いオーラを持っています〜<3 でも必要な時には、特に愛する人々を守るために、情熱的で狡猾になることもあります。\n\nぜひ彼女を描いてください！お好きなように描いてください！添付のGoogleフォルダに参考資料をたくさん用意しています。追加のインスピレーションが必要な場合に役立てば幸いです。改めて感謝します！https://drive.google.com/drive/folders/1WT_0x8xOE72VhtJCQQxZbCs4RuU0RKpl?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sinocya/works/219", "thumbnail_src": "https://si.imgix.net/dddd29fd/uploads/origins/e629c3da-ab92-4f9a-be41-4173246389af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4c40ee12505b53bbda6086b85da5bd", "thumbnail_srcset": "https://si.imgix.net/dddd29fd/uploads/origins/e629c3da-ab92-4f9a-be41-4173246389af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4c40ee12505b53bbda6086b85da5bd, https://si.imgix.net/dddd29fd/uploads/origins/e629c3da-ab92-4f9a-be41-4173246389af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8eb617d0484c4528b50311d4dd7140a 2x, https://si.imgix.net/dddd29fd/uploads/origins/e629c3da-ab92-4f9a-be41-4173246389af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9a77124cd626424e64ba5d5f14c1770 3x", "genre": "art", "nsfw": false, "body": "シノシアさん、こんにちは！あなたの作品、特に私の友人のために描いてくださったアートピースが本当に大好きです。FFXIVのピクシー種族から強くインスパイアされた私のキャラクター「フェイ」のコミッションをぜひお願いしたいです。できれば花を絡めた作品が理想です。花の上に座り、その瞬間に没頭して楽しんでいる姿を想像しています。\n\nただし、彼女を自由に描いてください！私はいつもアーティストを信頼し、その判断やアイデアを信じています。これまで一度も失望したことはありません<3敬具フェイより <3https://drive.google.com/drive/folders/1dFwf60yc9MeDLgYm1QN9tpe9_V5JIfGf", "created_at": "", "completed_at": ""}, {"path": "/@sinocya/works/218", "thumbnail_src": "https://si.imgix.net/9e1908d4/uploads/origins/53b301e9-b8f6-4863-abc0-c8cca13bc5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01ddaf816c0f56001dfc4195f712340", "thumbnail_srcset": "https://si.imgix.net/9e1908d4/uploads/origins/53b301e9-b8f6-4863-abc0-c8cca13bc5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01ddaf816c0f56001dfc4195f712340, https://si.imgix.net/9e1908d4/uploads/origins/53b301e9-b8f6-4863-abc0-c8cca13bc5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa293f9de4f9ba651a1f6f1ff64ea3d5 2x, https://si.imgix.net/9e1908d4/uploads/origins/53b301e9-b8f6-4863-abc0-c8cca13bc5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6e27e5abb2bc474768d4629c59088d1 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは～！また私のVTuberのアートが欲しいです！\n\nASMR動画のサムネイル用にイラストが欲しいです。テーマは「髪を洗う」「耳掃除」「鍵開け」「風を巻き起こしながら船乗りを海へ誘うセイレーン」の4つ。それぞれのシチュエーションでのキャラクターイラストをサムネイルに使いたいです！詳細は全てお任せします！\n\nSNSや動画サムネイルに使用したいです。透明版もお願いします。VTuber（参考画像とは異なり尖った耳です）：https://drive.google.com/file/d/1O7ia_HpM1JtCZ4LsPXAhguRlZlohg62s/view?usp=drive_link\n尖った耳：https://drive.google.com/file/d/10iJx8jvKxnjuJFjROiJAI5wA3fcmHWEw/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sinocya/works/217", "thumbnail_src": "https://si.imgix.net/c96ea3bd/uploads/origins/0d61f089-ab06-44b3-96f4-a96cd56fb4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a886d6768d624f2b67ce8b30d91b8bf", "thumbnail_srcset": "https://si.imgix.net/c96ea3bd/uploads/origins/0d61f089-ab06-44b3-96f4-a96cd56fb4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a886d6768d624f2b67ce8b30d91b8bf, https://si.imgix.net/c96ea3bd/uploads/origins/0d61f089-ab06-44b3-96f4-a96cd56fb4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35dd817a4a98eb37d91d55e7bcebda82 2x, https://si.imgix.net/c96ea3bd/uploads/origins/0d61f089-ab06-44b3-96f4-a96cd56fb4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7dfaa96778250c2c7b9f25ec1dcf05c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sinocya/works/216", "thumbnail_src": "https://si.imgix.net/a56d4df3/uploads/origins/8cb7d1ff-8e99-4599-9502-5c63371003fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c946ad8fe95ffa4dca77ea3ad8834374", "thumbnail_srcset": "https://si.imgix.net/a56d4df3/uploads/origins/8cb7d1ff-8e99-4599-9502-5c63371003fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c946ad8fe95ffa4dca77ea3ad8834374, https://si.imgix.net/a56d4df3/uploads/origins/8cb7d1ff-8e99-4599-9502-5c63371003fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a27b85cef54ca06675a03d6e88d13b42 2x, https://si.imgix.net/a56d4df3/uploads/origins/8cb7d1ff-8e99-4599-9502-5c63371003fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2da56e3e773776a289f4dd880146170f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nまたうちの子「にぷら」を描いていただきたいです。\nhttps://skeb.jp/@sinocya/works/193\nhttps://skeb.jp/@sinocya/works/196\n\n最初に描いていただいた\nhttps://skeb.jp/@sinocya/works/193\nの右下にかわいく描かれているような、座ってお歌を唄うにぷらをお願いします。\n\n【にぷら　設定】\n黒長髪にアホ毛、黒尻尾、黒い服を好んで着る猫耳少女。\n服はおへその見える短い上着、ミニスカート。黒縞パン。\n尾てい骨のあたりに尻尾を出すための穴がある。\n首輪と靴には鈴。アホ毛がある。\n身長は140ちょっとで幼げだけどお胸はおっきい。ロリ巨乳。少しツリ目。\nご主人（飼い主）大好きで第一主義。いつも構ってほしい甘えっ娘。", "created_at": "", "completed_at": ""}, {"path": "/@sinocya/works/215", "thumbnail_src": "https://si.imgix.net/0b06f8b6/uploads/origins/dba7b4a1-9643-4f34-8680-be418562b292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7aca608b8795545c05c1f6b92c7e130", "thumbnail_srcset": "https://si.imgix.net/0b06f8b6/uploads/origins/dba7b4a1-9643-4f34-8680-be418562b292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7aca608b8795545c05c1f6b92c7e130, https://si.imgix.net/0b06f8b6/uploads/origins/dba7b4a1-9643-4f34-8680-be418562b292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a3ba88308a538925bfba4b9126461b2 2x, https://si.imgix.net/0b06f8b6/uploads/origins/dba7b4a1-9643-4f34-8680-be418562b292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28768688f37c9e8a052fda51139af7ae 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクター、ポレン・パレットを描いてほしいです！彼女はファブラ・ウルティマ/TTRPGのキャラクターで、蜂の格好をした少女。商人、修理屋、グルメ/シェフとして活動していて、蜂の腹部をリュックサック代わりにしています！彼女