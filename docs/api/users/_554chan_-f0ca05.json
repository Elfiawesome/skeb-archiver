94ab-07e3e7d152ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94a50b36b5e2a82b0bd78d33935d659a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/9", "thumbnail_src": "https://si.imgix.net/ba68d204/uploads/origins/ce712101-1597-4670-b5ec-f17cd4337363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a90ec57f2b6fcefd532e3ccab0e7fd", "thumbnail_srcset": "https://si.imgix.net/ba68d204/uploads/origins/ce712101-1597-4670-b5ec-f17cd4337363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a90ec57f2b6fcefd532e3ccab0e7fd, https://si.imgix.net/ba68d204/uploads/origins/ce712101-1597-4670-b5ec-f17cd4337363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8ce6092a08d3cc7a51714954fc59126 2x, https://si.imgix.net/ba68d204/uploads/origins/ce712101-1597-4670-b5ec-f17cd4337363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acd3e04c5b3d0307fbee7bf4cb13b9dc 3x", "genre": "art", "nsfw": false, "body": "個人観賞用のカラーイラストをリクエスト致します！\n内容は信長（台詞のみ）に「今日はいちだんと化粧が厚いのう…」と言われた戦国無双3の濃姫が激昂して左頬の化粧がビシッとヒビ割れるシーンの一枚絵をお願いいたします‼️\n\n参考資料\nhttps://www.cmoa.jp/title/27412/vol/7/\n無料立ち読み\n\nhttps://n-kashima.hatenadiary.org/entry/20100825/1282672567", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/8", "thumbnail_src": "https://si.imgix.net/929ad6e3/uploads/origins/32668d2a-51f7-4e59-84de-c959fbc0c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=829e5c2a9f804bd8f7164290d2c91b5f", "thumbnail_srcset": "https://si.imgix.net/929ad6e3/uploads/origins/32668d2a-51f7-4e59-84de-c959fbc0c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=829e5c2a9f804bd8f7164290d2c91b5f, https://si.imgix.net/929ad6e3/uploads/origins/32668d2a-51f7-4e59-84de-c959fbc0c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ece48e5c371c924efcd545ada3a7656 2x, https://si.imgix.net/929ad6e3/uploads/origins/32668d2a-51f7-4e59-84de-c959fbc0c2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=871e5c20a77ffecefec2af6c3b8d9f1d 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストをありがとうございます！\n茶のすけさんの描かれる元気でかわいい郭嘉ちゃんと、色気に溢れたえっちな賈詡さんの仲良しカクカクが大好きです！\n\nよければ二人とも7の衣装で、賈詡さんに「賈詡♡好き♡好き♡」っていいながら抱きつく郭嘉ちゃんと「こら！」と叱りながらもまんざらでもなく受け入れてくれる優しい賈詡さんをお願いします！\n\nできればでいいんですが、そのまま着衣エッチになだれ込むカクカクが見たいです！\n賈詡さんが受けの時と、郭嘉ちゃんが受けの時の2種のパターンが見たいです♡♡\n気が向かなかったら大丈夫です\n\nこれからも創作活動応援しております！", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/7", "thumbnail_src": "https://si.imgix.net/70a08317/uploads/origins/582ec724-2faf-4dfa-ac54-3e80d4198d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f496f57aa96bb2d46995932ca4973e70", "thumbnail_srcset": "https://si.imgix.net/70a08317/uploads/origins/582ec724-2faf-4dfa-ac54-3e80d4198d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f496f57aa96bb2d46995932ca4973e70, https://si.imgix.net/70a08317/uploads/origins/582ec724-2faf-4dfa-ac54-3e80d4198d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c09cdc0359a02ce70479fa76dcdbd7cc 2x, https://si.imgix.net/70a08317/uploads/origins/582ec724-2faf-4dfa-ac54-3e80d4198d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53849c6cb795244fa02325736ab385d0 3x", "genre": "art", "nsfw": false, "body": "以前リクエストを引き受けてくださりありがとうございます。前回のシチュエーションの内容で、直虎版も見たくなり、恐縮ですがリクエスト申請をさせていただきたく存じます。\n\n内容は、小少将の元に直虎が訪れ「その寝癖頭って流行ってるんですか？」と不思議そうに尋ねる。イラッときた小少将は、「最近の流行りだから貴女にもしてあげるわね」と言い、直虎の髪にロッドを巻き付ける。そして頭に爆弾を乗せて爆発させる。モジャモジャ頭になった直虎は、目をキラキラさせて流行りの髪型にしてもらったことに喜ぶ。数日後、巷では同じ髪型をした女性が見えるようになり、小少将の元に髪結いを依頼する女性武将が訪れる。予想外の展開になり、小少将は戸惑って終わり。というものです。\n長くなり恐縮ですが、ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/6", "thumbnail_src": "https://si.imgix.net/e0a04a78/uploads/origins/8ee930d7-8f3d-40b2-97b8-8105edcb815f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f44fcfd6e4e96dad798c08e39248f3d", "thumbnail_srcset": "https://si.imgix.net/e0a04a78/uploads/origins/8ee930d7-8f3d-40b2-97b8-8105edcb815f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f44fcfd6e4e96dad798c08e39248f3d, https://si.imgix.net/e0a04a78/uploads/origins/8ee930d7-8f3d-40b2-97b8-8105edcb815f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac11201f0c70bc7851c54a0218b4097e 2x, https://si.imgix.net/e0a04a78/uploads/origins/8ee930d7-8f3d-40b2-97b8-8105edcb815f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c2fc6b61a92eb69ce371b0eda1f2460 3x", "genre": "art", "nsfw": false, "body": "茶のすけ樣の小少将が可愛くてすきでして、リクエストをしたくお声がけさせていただきました。\n2Pの漫画形式でお願いしたく存じます。\n内容は、小少将の髪型を見て「何やったらあんな頭になるの」と吹き出す甲斐姫とそれをたしなめる早川殿。\nカチンときた小少将が、モジャモジャ頭のやり方を甲斐姫と早川殿に実践。パーマロッドのような筒状の物を2人の髪に巻き付け、最後に2人の頭に爆弾を置き2人の頭で爆発。どちらも小少将のモジャモジャ頭になりぐるぐる目でフラフラになる。というものです。ご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/5", "thumbnail_src": "https://si.imgix.net/8bb0c896/uploads/origins/2c3c6a3a-9897-4fb1-b2e0-1435e650f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430840945e2d65e58c6f7a98aa9cffd4", "thumbnail_srcset": "https://si.imgix.net/8bb0c896/uploads/origins/2c3c6a3a-9897-4fb1-b2e0-1435e650f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430840945e2d65e58c6f7a98aa9cffd4, https://si.imgix.net/8bb0c896/uploads/origins/2c3c6a3a-9897-4fb1-b2e0-1435e650f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a58c88f6cdc8d1c7a56b1774e66a9c6 2x, https://si.imgix.net/8bb0c896/uploads/origins/2c3c6a3a-9897-4fb1-b2e0-1435e650f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2572cbccf55185c3dfdb0f2c5a583ffb 3x", "genre": "art", "nsfw": false, "body": "育毛剤の漫画をリクエストした者です!リクエストに応えて頂きありがとうございます!\n先日と引き続き頭頂部がペタンコかつオデコが広くなった小少将のイラスト（正面絵）をお願いいたします!\n頭を掻きむしりながら四方八方に抜け毛を待ち散らすシチュエーションでお願いいたします！\n\nポーズとシチュエーションのイメージ\nhttps://www.irasutoya.com/2015/10/blog-post_68.html?m=1\n\nhttps://www.irasutoya.com/2015/10/blog-post_68.html?m=1", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/4", "thumbnail_src": "https://si.imgix.net/c86478a7/uploads/origins/974b064e-5c67-4b40-be4b-8e5960a84b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=241d415565638d15295eb23f374d7030", "thumbnail_srcset": "https://si.imgix.net/c86478a7/uploads/origins/974b064e-5c67-4b40-be4b-8e5960a84b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=241d415565638d15295eb23f374d7030, https://si.imgix.net/c86478a7/uploads/origins/974b064e-5c67-4b40-be4b-8e5960a84b35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dacd7b3e5c0393883218a040bd50884 2x, https://si.imgix.net/c86478a7/uploads/origins/974b064e-5c67-4b40-be4b-8e5960a84b35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c297cb26b0315f2ab59cc2b32c7942e 3x", "genre": "art", "nsfw": false, "body": "小少将とガラシャの白黒漫画を2枚と小少将のイラストを1枚お願い致します！\n\n漫画の内容は小少将がガラシャに後ろから育毛剤をかけられて毛量が２倍に増えました。しかし育毛剤の副作用で頭皮が痒くなってしまい、両手で頭を掻きむしりながら抜け毛を四方八方に撒き散らして、最後には毛量が無くなり頭頂部がペタンコかつオデコが広くなった小少将をお願いいたします‼️\n\nイラストの内容は小少将の毛量が2倍になったversionと小少将の毛量が無くなり頭頂部がペタンコかつオデコが広くなったversionのイラストを1枚目にまとめて頂ければ", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/3", "thumbnail_src": "https://si.imgix.net/32ff7dca/uploads/origins/068da709-a90a-43ba-bfea-db0b725ec672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7511c7486cedfefd9b02d90ce419e6ed", "thumbnail_srcset": "https://si.imgix.net/32ff7dca/uploads/origins/068da709-a90a-43ba-bfea-db0b725ec672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7511c7486cedfefd9b02d90ce419e6ed, https://si.imgix.net/32ff7dca/uploads/origins/068da709-a90a-43ba-bfea-db0b725ec672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=746055a72aec248d0149d882b7f62df3 2x, https://si.imgix.net/32ff7dca/uploads/origins/068da709-a90a-43ba-bfea-db0b725ec672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ee192e82fe72b92789c8676deda4902 3x", "genre": "art", "nsfw": false, "body": "茶のすけ様の戦国無双の絵が好きで、リクエストしたいです！戦国無双5の家康と瀬名で漫画形式のリクエストをお願いしたいです。御一考いただけますと幸いです。\n\n内容は下記の通りです。\n家康の腰元に帯を巻きつけ、一気に引っ張って帯回しをする瀬名。独楽のように回されて家康は目を回し、その様子を見て瀬名は面白がる。そして限界を迎えた家康は前に倒れ込み、そのまま瀬名を押し倒す。瀬名は恥ずかしがるも、家康は気絶したまま動かないままだった。(完)", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/2", "thumbnail_src": "https://si.imgix.net/d5961e03/uploads/origins/f3090a80-8972-4ef3-8857-bde6a809714d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d8bc3882ec56bebf7c55e79cc924d04", "thumbnail_srcset": "https://si.imgix.net/d5961e03/uploads/origins/f3090a80-8972-4ef3-8857-bde6a809714d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d8bc3882ec56bebf7c55e79cc924d04, https://si.imgix.net/d5961e03/uploads/origins/f3090a80-8972-4ef3-8857-bde6a809714d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdab550c8b634a928c71cee496646742 2x, https://si.imgix.net/d5961e03/uploads/origins/f3090a80-8972-4ef3-8857-bde6a809714d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59aa8009238675d28c2d56bb17370941 3x", "genre": "art", "nsfw": false, "body": "茶のすけ様の戦国無双キャラの可愛いイラスト、いつも楽しく見させてもらってます。特に小少将が可愛くて好きで、そのリクエスト(漫画形式を希望したいです)がしたくお声がけしました。\n\n詳細についてですが、登場人物は小少将とガラシャ。\n内容は、小少将のモジャモジャな髪型を面白がりワシャワシャといじってイタズラするガラシャ。いじられた時に頭を激しく揺らされたことで、髪はさらにくしゃくしゃになり、目を回してしまう小少将。小少将も流石に少し怒り、お返しとしてガラシャの髪を超速の勢いでワシャワシャと弄り倒す。その結果、ガラシャの髪は小少将とお揃いのモジャモジャヘアーになってしまった。\n\nというものです。長くなってすみませんが、ご検討くださると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@_554chan_/works/1", "thumbnail_src": "https://si.imgix.net/b42378ca/uploads/origins/c596d4fa-ad9d-4623-a759-e26d39645d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8370cef62a220c998f1f92a545e7bc54", "thumbnail_srcset": "https://si.imgix.net/b42378ca/uploads/origins/c596d4fa-ad9d-4623-a759-e26d39645d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8370cef62a220c998f1f92a545e7bc54, https://si.imgix.net/b42378ca/uploads/origins/c596d4fa-ad9d-4623-a759-e26d39645d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdd42e665ad545c37056412eb2e097bb 2x, https://si.imgix.net/b42378ca/uploads/origins/c596d4fa-ad9d-4623-a759-e26d39645d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71d758f4f3f3b9bbacd6e6ad9be544d9 3x", "genre": "art", "nsfw": false, "body": "元親によって髪の中に手を突っ込まれてワシャワシャされる小少将ちゃんの2ページ白黒漫画をリクエストします!\n\n小少将ちゃんはブチ切れるかと思いきやデリケートゾーンである頭皮を刺激されて恍惚な表情を浮かべるシチュエーションで!", "created_at": "", "completed_at": ""}]}