8-b956-d5c5c2560276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d584de86f29fa3282191e4f960f1785 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お願いがあります！私のキャラクターを二人描いていただけませんか？ゴブリンの女の子パンドラと、そのガールフレンドの人間の歌姫ヒナです。ヒナの身長は167cm、パンドラの身長は132cmなので、身長差に注意してください！ポーズは可愛ければなんでもOKです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1J_QMLbMzP-00HAsvUXgAi8JTDZXVLz3c?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@unkmochi/works/4", "thumbnail_src": "https://si.imgix.net/9bf42d4b/uploads/origins/a178f8be-2a6e-47c4-81c1-df5207b2cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4077dcb0752567142ee4c45f4587df0", "thumbnail_srcset": "https://si.imgix.net/9bf42d4b/uploads/origins/a178f8be-2a6e-47c4-81c1-df5207b2cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4077dcb0752567142ee4c45f4587df0, https://si.imgix.net/9bf42d4b/uploads/origins/a178f8be-2a6e-47c4-81c1-df5207b2cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94d48164e805778299e1018bda8c699b 2x, https://si.imgix.net/9bf42d4b/uploads/origins/a178f8be-2a6e-47c4-81c1-df5207b2cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48773f1420443411bae04c2c4bcc4028 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nクロエとニーナ \"永劫回帰 \"のゲームから\nありがとう\n\nhttps://static.wikia.nocookie.net/blacksurvivaleternalreturn_gamepedia_en/images/7/78/Dutiful_Maid_Chloe.png/revision/latest?cb=20230311231518&format=original", "created_at": "", "completed_at": ""}, {"path": "/@unkmochi/works/3", "thumbnail_src": "https://si.imgix.net/e8631ff2/uploads/origins/f7a7f89d-a8f9-4d61-aa5a-83eb1d277f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c78e0694bf2496142c80ed1ece03d0e0", "thumbnail_srcset": "https://si.imgix.net/e8631ff2/uploads/origins/f7a7f89d-a8f9-4d61-aa5a-83eb1d277f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200