ん)\n･シェービングクリームはお尻の穴を完全に隠す量で描く\n･性器は脱ぎかけのパンツで隠すか、モザイクを使って修正する\n･文字や記号はレイヤーにて有無を選択できるようにする\n･psd形式での納品を希望します\n\n指定事項が多いうえに特殊なシチュで申し訳ありませんが、割に合わない依頼だと判断されましたら即キャンセルして構いませんのでよろしくお願いたします", "created_at": "", "completed_at": ""}, {"path": "/@kuon27260532/works/410", "thumbnail_src": "https://si.imgix.net/2a1e28df/uploads/origins/9f43b1c0-80cf-4278-a653-1d39723ff0a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09a2c6fe83d8ee2bfe115a253d3f56b2", "thumbnail_srcset": "https://si.imgix.net/2a1e28df/uploads/origins/9f43b1c0-80cf-4278-a653-1d39723ff0a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09a2c6fe83d8ee2bfe115a253d3f56b2, https://si.imgix.net/2a1e28df/uploads/origins/9f43b1c0-80cf-4278-a653-1d39723ff0a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=187bc651696b73dd229032cf11d302d1 2x, https://si.imgix.net/2a1e28df/uploads/origins/9f43b1c0-80cf-4278-a653-1d39723ff0a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3417f87dc0070a2af5352b8cf8607f52 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuon27260532/works/409", "thumbnail_src": "https://si.imgix.net/d892665c/uploads/origins/74ff782c-10ac-4364-a047-f51be503bd34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b242a73056fae0e91301bcae83b6e5fa", "thumbnail_srcset": "https://si.imgix.net/d892665c/uploads/origins/74ff782c-10ac-4364-a047-f51be503bd34?bg=%23fff&auto=format%2