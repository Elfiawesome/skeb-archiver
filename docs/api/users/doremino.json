6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34d753e58cdaed0e9c1ddb85cf26f7f5 2x, https://si.imgix.net/5b9d11c9/uploads/origins/b82a9ea0-2b00-45aa-b642-bfd71314e6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c429c2ef1cb15b464ac9262f338c019 3x", "genre": "art", "nsfw": true, "body": "ボンバーガールのアサギの同僚の根暗子のパイズリをお願いします。\n\n・服は何も着せずに全裸\n・おちんちんの先をぺろぺろ舐める\n・根暗子の表情は恥ずかしそうに目をそらす\n\n下記URLは根暗子の登場した漫画のまとめです。\n\nどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EJ9LvhzUhziua6YI2Y4NwyFUT3Qbd4ua", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/20", "thumbnail_src": "https://si.imgix.net/5229654a/uploads/origins/c7646f4c-54a3-40ee-be96-5e8164bed26e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993d9434cbe9fea47196129f9068aba6", "thumbnail_srcset": "https://si.imgix.net/5229654a/uploads/origins/c7646f4c-54a3-40ee-be96-5e8164bed26e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993d9434cbe9fea47196129f9068aba6, https://si.imgix.net/5229654a/uploads/origins/c7646f4c-54a3-40ee-be96-5e8164bed26e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=788e8b2d05e07d910eba6309cc6ae769 2x, https://si.imgix.net/5229654a/uploads/origins/c7646f4c-54a3-40ee-be96-5e8164bed26e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a594e54b0e55604f89dea6790e65d851 3x", "genre": "art", "nsfw": false, "body": "ボンガのシロンでシロちゃんくらいの年齢に成長した姿をお願いできますか？\n格好はシロちゃんのアカデミアの制服で、髪型はワンレングスカットもしくはワンレングスロングのような大人びた感じで。\n表情は難しいかもしれませんが、元気だけど大人な雰囲気が垣間見えるような感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/19", "thumbnail_src": "https://si.imgix.net/888a8c2e/uploads/origins/e5f1333b-ffe0-4817-953b-2bdc50ac82e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705194282262fc628079ce597b8fae2e", "thumbnail_srcset": "https://si.imgix.net/888a8c2e/uploads/origins/e5f1333b-ffe0-4817-953b-2bdc50ac82e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705194282262fc628079ce597b8fae2e, https://si.imgix.net/888a8c2e/uploads/origins/e5f1333b-ffe0-4817-953b-2bdc50ac82e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48702fa103c2502d675221d0936ced53 2x, https://si.imgix.net/888a8c2e/uploads/origins/e5f1333b-ffe0-4817-953b-2bdc50ac82e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b28d040282205c71fd2f751b79d827f8 3x", "genre": "art", "nsfw": false, "body": "「八十亀ちゃんかんさつにっき」の只草舞衣ちゃんをお願いできますでしょうか？\n服装は制服で、ポーズは両手を腰の前あたりで手を組むような感じで、表情は微笑むような感じでお願いします。\nご存じない漫画のタイトルかもしれませんがもしよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/18", "thumbnail_src": "https://si.imgix.net/cbe3a6f1/uploads/origins/14a61849-6f59-47c9-83e9-1337f1674728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8abc34533db42c1a1e5b07853aa0c4ab", "thumbnail_srcset": "https://si.imgix.net/cbe3a6f1/uploads/origins/14a61849-6f59-47c9-83e9-1337f1674728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8abc34533db42c1a1e5b07853aa0c4ab, https://si.imgix.net/cbe3a6f1/uploads/origins/14a61849-6f59-47c9-83e9-1337f1674728?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f69d393d47b85766970a57636c2f09bf 2x, https://si.imgix.net/cbe3a6f1/uploads/origins/14a61849-6f59-47c9-83e9-1337f1674728?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5278fe38319ddedf00a8189d332e524 3x", "genre": "art", "nsfw": false, "body": "ボンガのシロちゃんでお祝いのメッセージを言ってくれるイラストをお願いできますでしょうか？\n「HIENマスターお誕生日おめでとう！」\nと言いながら満面の笑みで迎えてくれるイメージです。\nポーズはクラッカーを鳴らしてる感じで、服装は抱き枕カバーの制服でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/17", "thumbnail_src": "https://si.imgix.net/74dd4c90/uploads/origins/bfae942d-2dca-44a8-9a7e-d7ce414e4abe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0d449da7ae492f536af7a13f00134da", "thumbnail_srcset": "https://si.imgix.net/74dd4c90/uploads/origins/bfae942d-2dca-44a8-9a7e-d7ce414e4abe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0d449da7ae492f536af7a13f00134da, https://si.imgix.net/74dd4c90/uploads/origins/bfae942d-2dca-44a8-9a7e-d7ce414e4abe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37a8c7490844f3cc4dbe9472ff5d0e4f 2x, https://si.imgix.net/74dd4c90/uploads/origins/bfae942d-2dca-44a8-9a7e-d7ce414e4abe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8dd38b4fb25a1b5d95d0ae8c924eb37 3x", "genre": "art", "nsfw": true, "body": "こんばんは、今回はエロ直球のリクエストをします\n\nウルシ（ボンバーガール）が全裸かつまんぐり返しの構図で\nマスターとセックスしている姿をお願いします\nマスターはチ〇ポだけの描写で構いません\nあとマスク無しでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/16", "thumbnail_src": "https://si.imgix.net/856fbb8c/uploads/origins/8296c850-ea69-45c4-bb5a-af8a7fd78c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d0249f89303596ca2471adf162040a", "thumbnail_srcset": "https://si.imgix.net/856fbb8c/uploads/origins/8296c850-ea69-45c4-bb5a-af8a7fd78c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d0249f89303596ca2471adf162040a, https://si.imgix.net/856fbb8c/uploads/origins/8296c850-ea69-45c4-bb5a-af8a7fd78c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe75eae1604e938481a92a1ad63c2ad5 2x, https://si.imgix.net/856fbb8c/uploads/origins/8296c850-ea69-45c4-bb5a-af8a7fd78c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f13ece63c394fc64a81515600deda3de 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/15", "thumbnail_src": "https://si.imgix.net/bb8847d5/uploads/origins/30d9f8ec-5640-4158-a82f-92cc007ee2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f0e513f65ba136d9a81a0ce34a11bc", "thumbnail_srcset": "https://si.imgix.net/bb8847d5/uploads/origins/30d9f8ec-5640-4158-a82f-92cc007ee2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f0e513f65ba136d9a81a0ce34a11bc, https://si.imgix.net/bb8847d5/uploads/origins/30d9f8ec-5640-4158-a82f-92cc007ee2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2f5318db9707d9e4b1a85734b1dce2b 2x, https://si.imgix.net/bb8847d5/uploads/origins/30d9f8ec-5640-4158-a82f-92cc007ee2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53c47c9c7749dc0f1c24b7e8ba610736 3x", "genre": "art", "nsfw": false, "body": "東方の東風谷早苗をお願いできますでしょうか？\n服装や髪型は東方虹龍洞の早苗で、表情はドヤ顔でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/14", "thumbnail_src": "https://si.imgix.net/e40fed0a/uploads/origins/df6b0307-15cc-45bf-b6e1-5ee3bd52c33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4ecd360c7ee032c5faf4498e8cd891", "thumbnail_srcset": "https://si.imgix.net/e40fed0a/uploads/origins/df6b0307-15cc-45bf-b6e1-5ee3bd52c33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4ecd360c7ee032c5faf4498e8cd891, https://si.imgix.net/e40fed0a/uploads/origins/df6b0307-15cc-45bf-b6e1-5ee3bd52c33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39d2fd0e353f40f363a867b4c6451f30 2x, https://si.imgix.net/e40fed0a/uploads/origins/df6b0307-15cc-45bf-b6e1-5ee3bd52c33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d783a107cbf283fe7a00e84150987478 3x", "genre": "art", "nsfw": true, "body": "プルーン（ボンバーガール）のパイズリをお願いします。\n\nおっぱいの間から出た亀頭をペロペロ舐めるようにしてください。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/13", "thumbnail_src": "https://si.imgix.net/7090e913/uploads/origins/cca60427-ba6c-4b8e-b42d-5da1547c9bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de3b5040fdc194314bf23f2dc8d899d8", "thumbnail_srcset": "https://si.imgix.net/7090e913/uploads/origins/cca60427-ba6c-4b8e-b42d-5da1547c9bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de3b5040fdc194314bf23f2dc8d899d8, https://si.imgix.net/7090e913/uploads/origins/cca60427-ba6c-4b8e-b42d-5da1547c9bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee6a54fb3520976b1eb449bfec721886 2x, https://si.imgix.net/7090e913/uploads/origins/cca60427-ba6c-4b8e-b42d-5da1547c9bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d2e2fc4ef67929a8827f2328c8d47ff 3x", "genre": "art", "nsfw": false, "body": "はじめまして、リクエストをお願いします\nボンガのシロちゃんがコスプレで魔女の旅々というラノベの主人公イレイナの魔女衣装を着ている姿をお願いします\n表情は笑顔でポーズは箒に乗って空を飛んでる感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/12", "thumbnail_src": "https://si.imgix.net/13d17be3/uploads/origins/5b7c756b-c82a-4943-9f6f-8116a8552fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277a84f3cd8ed909d9f39db7f9c1f8f3", "thumbnail_srcset": "https://si.imgix.net/13d17be3/uploads/origins/5b7c756b-c82a-4943-9f6f-8116a8552fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277a84f3cd8ed909d9f39db7f9c1f8f3, https://si.imgix.net/13d17be3/uploads/origins/5b7c756b-c82a-4943-9f6f-8116a8552fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9d0fb2b5ed550b17b64b086e5cf7063 2x, https://si.imgix.net/13d17be3/uploads/origins/5b7c756b-c82a-4943-9f6f-8116a8552fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f23a52ebddc03c2f47e200f56fa5b5e 3x", "genre": "art", "nsfw": false, "body": "リクルートスーツ(黒)のシロちゃんをお願いします！\n表情は笑顔でお願いします。\nもしよければ眼鏡差分をいただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/11", "thumbnail_src": "https://si.imgix.net/e1644a28/uploads/origins/5df9a2d6-a5b4-4a2f-8eb7-32f0cf037b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abd2cc1598caa2811531c09dfe0faf29", "thumbnail_srcset": "https://si.imgix.net/e1644a28/uploads/origins/5df9a2d6-a5b4-4a2f-8eb7-32f0cf037b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abd2cc1598caa2811531c09dfe0faf29, https://si.imgix.net/e1644a28/uploads/origins/5df9a2d6-a5b4-4a2f-8eb7-32f0cf037b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c74e7846177cde8b47ce7bf949259678 2x, https://si.imgix.net/e1644a28/uploads/origins/5df9a2d6-a5b4-4a2f-8eb7-32f0cf037b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=921f64a35894ade8a8da873fa4dc9090 3x", "genre": "art", "nsfw": false, "body": "プリンセスコネクトのペコリーヌをお願いできますでしょうか？\n通常衣装でニコニコの笑顔でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/10", "thumbnail_src": "https://si.imgix.net/aee2bfa3/uploads/origins/7781a875-a68e-421a-a828-3d1fec696628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edd5b4fe88cc06af3c674b5dc115fcf6", "thumbnail_srcset": "https://si.imgix.net/aee2bfa3/uploads/origins/7781a875-a68e-421a-a828-3d1fec696628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edd5b4fe88cc06af3c674b5dc115fcf6, https://si.imgix.net/aee2bfa3/uploads/origins/7781a875-a68e-421a-a828-3d1fec696628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f87b6a2c7ed963c912fc018042b0a2d 2x, https://si.imgix.net/aee2bfa3/uploads/origins/7781a875-a68e-421a-a828-3d1fec696628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca25e10f8bc46c6fca268813b526b568 3x", "genre": "art", "nsfw": false, "body": "ボンガのシロちゃんで妹の水着を無理矢理着て恥ずかしがっている姿をお願いします。\n服装はシロンの水着(青ストライプ)でシロちゃんの体の大きさに合わせてください。\nポーズは左腕で胸を下から抱き上げて、左手で右肘を掴む様な感じでお願いします。(おっぱい抱っこというものでしょうか？)\n表情は撃破絵の様な赤らめている姿で。\nもしよろしければシロンの水着(白)の差分もいただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/9", "thumbnail_src": "https://si.imgix.net/aaf294af/uploads/origins/c846d4b6-3f4e-4e20-a66d-1dd575b8ab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a5703feafb04893dfdafb6648ac33f", "thumbnail_srcset": "https://si.imgix.net/aaf294af/uploads/origins/c846d4b6-3f4e-4e20-a66d-1dd575b8ab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a5703feafb04893dfdafb6648ac33f, https://si.imgix.net/aaf294af/uploads/origins/c846d4b6-3f4e-4e20-a66d-1dd575b8ab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91f7fbadf325173daf64c041f8a9060f 2x, https://si.imgix.net/aaf294af/uploads/origins/c846d4b6-3f4e-4e20-a66d-1dd575b8ab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44d20788f12d938b0e9ca99129fda068 3x", "genre": "art", "nsfw": false, "body": "五等分の花嫁の中野四葉をお願いできますでしょうか？\n衣装は高校時代の制服(夏服)でお願いします。\n表情はにっこり笑顔でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@doremino/works/8", "thumbnail_src": "https://si.imgix.net/29dcb58e/uploads/origins/afe58640-69f4-449e-8f45-033d963c7a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0be660b20630f2cc41d310734ee0deae", "thumbnail_srcset": "https://si.imgix.net/29dcb58e/uploads/origins/afe58640-69f4-449e-8f45-033d963c7a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0be660b20630f2cc41d310734ee0deae, https://si.imgix.net/29dcb58e/uploads/origins/afe58640-69f4-449e-8f45-033d963c7a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7704b94a3efe16e41c86d6fda953271a 2x, https://si.imgix.net/29dcb58e/uploads/origins/afe58640-69f4-449e-