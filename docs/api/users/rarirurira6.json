161fe6d3829?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faf986a0083b3ee4858e357bbb659666 2x, https://si.imgix.net/6d284cb2/uploads/origins/68030b52-438e-4881-9f31-5161fe6d3829?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=880c26aa35b2edb51a14532d8ed44552 3x", "genre": "art", "nsfw": false, "body": "朝起きて鏡を見ると、東方Projectのメルラン・プリズムリバーになっていたというシチュエーションをお願いします\n\n以下の条件でお願いします\n\n・視点：鏡を見ているメルランになった人視点(鏡に映っているため、左右反転でお願いします)\n・顔：メルランになった自分の姿を見て驚く\n・服装：通常のメルランの服\n・補足：メルランの近くにトランペットが浮いている(難しければなくてもいいですが、できれば書いてほしいです)\n※参考： https://1drawstorage.blog.fc2.com/blog-entry-2605.html\n・台詞：「メルランになってる！？」※台詞なしの差分もほしいです\n・変身前の姿等は不要\n\nよろしくお願いします\n\nhttps://1drawstorage.blog.fc2.com/?tag=%E3%83%A1%E3%83%AB%E3%83%A9%E3%83%B3", "created_at": "", "completed_at": ""}, {"path": "/@rarirurira6/works/3", "thumbnail_src": "https://si.imgix.net/a4542f2a/uploads/origins/f724c781-0eac-43ff-b973-d0b885246ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2f93e48cdf0213162a0c8407f4e3584", "thumbnail_srcset": "https://si.imgix.net/a4542f2a/uploads/origins/f724c781-0eac-43ff-b973-d0b885246ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2f93e48cdf0213162a0c8407f4e3584, https://si.imgix.net/a4542f2a/uploads/origins/f724c781-0eac-43ff-b973-d0b885246ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1fe614e755f7ab80cf042f7f76e9b90 2x, https://si.imgix.net/a4542f2a/uploads/origins/f724c781-0eac-43ff-b973-d0b885246ef1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29058ed6a53eca308b53ed114f65aa69 3x", "genre": "art", "nsfw": false, "body": "メインはパチュリーが図書館の中で優雅に紅茶を飲んでる\n\nLINEアイコンを描いて欲しい。", "created_at": "", "completed_at": ""}, {"path": "/@rarirurira6/works/2", "thumbnail_src": "https://si.imgix.net/cbb0fcd7/uploads/origins/56c4e87a-8861-4fc5-b546-326b4cea7ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20