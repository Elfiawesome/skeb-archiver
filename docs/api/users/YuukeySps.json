e4-6e38-4a23-96e7-61a7d17a7bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bebc51f654fd2acddad85eb26b1e39d0, https://si.imgix.net/2c8635f9/uploads/origins/f8f9fde4-6e38-4a23-96e7-61a7d17a7bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cc780cfe4aa8d01173a030e7a34f8d3 2x, https://si.imgix.net/2c8635f9/uploads/origins/f8f9fde4-6e38-4a23-96e7-61a7d17a7bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a82a82a4db02bab6a51414c43357400f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@YuukeySps/works/4", "thumbnail_src": "https://si.imgix.net/5e7d4275/uploads/origins/de917680-4050-4cad-a78b-f6fc538b4d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c5d9cd604ec8c6b689fc2d5582a1794", "thumbnail_srcset": "https://si.imgix.net/5e7d4275/uploads/origins/de917680-4050-4cad-a78b-f6fc538b4d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c5d9cd604ec8c6b689fc2d5582a1794, https://si.imgix.net/5e7d4275/uploads/origins/de917680-4050-4cad-a78b-f6fc538b4d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be692c0905d28a5fea1fe419eac4be63 2x, https://si.imgix.net/5e7d4275/uploads/origins/de917680-4050-4cad-a78b-f6fc538b4d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f77809ef9c63650f24d8ebb7ed2385d 3x", "genre": "comic", "nsfw": true, "body": "男装少女が周りの男子に合わせてエロ本を読み、羞恥に耐える話をモノクロ漫画で描いて頂きたいです。\nできればpixiv等、他のSNSでも公開して頂けると嬉しいです。\n\n■あらすじ\n少女はある事情で性別を偽り男子校に入っている。正体がバレないよう普段から周りの男子に合わせて過ごすも下品な男子が多く、ある日男子が持ってきた数々のエロ本を皆で読み品評することに。少女も仕方なくエロ本を読むが「私何してるんだろう」と思うとともに内容の過激さに赤面、涙目になる。\n\n■詳細\n・ページ数はお任せします。\n・少女の特徴: 男子校の制服を着ている。華奢で身長は低いが巨乳であり、普段はサラシで胸を隠している。エロに耐性がない。一人称は「僕」で通しているが、心の中では「私」になる。", "created_at": "", "completed_at": ""}, {"path": "/@YuukeySps/works/3", "thumbnail_src": "https://si.imgix.net/454f5861/uploads/origins/226812e5-5413-4871-8809-80e21bb2ae75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3dd3dec5efe96ff7dbb7bbe5c55c75f", "thumbnail_srcset": "https://si.imgix.net/454f5861/uploads/origins/226812e5-5413-4871-8809-80e21bb2ae75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3dd3dec5efe96ff7dbb7bbe5c55c75f, https://si.imgix.net/454f5861/uploads/origins/226812e5-5413-4871-8809-80e21bb2ae75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5852d01f1a9e2f9046377d56d2de70a 2x, https://si.imgix.net/454f5861/uploads/origins/226812e5-5413-4871-8809-80e21bb2ae75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5a55804a5d5ac0a9a6a00b8ae625a79 3x", "genre": "art", "nsfw": true, "body": "先日は素晴らしい作品をありがとうございました。また依頼をさせて下さい。  \n\n先日のおもらし作品が素晴らしかったので、またおもらしで依頼をさせて頂きます。\n\n今回も『風の行方は』の佐藤佳那のおもらしをお願いします。\n本編とは別の世界線という設定で、運動会の実行委員長を務めることになった佳那が朝礼台の上での選手宣誓の最中に我慢できなくなり、全校生徒、先生、父兄の前で大量のおしっこを漏らしてしまうというシチュエーションで描いて下さい。\n\n衣装は昔ながらの体操服＆濃紺ブルマ＆ハチマキでお願いします。ブルマは小さめで、我慢のためにお尻に力を入れているため、食い込み気味にして下さい。\n必死の我慢の末のおもらしなので、生地の薄いブルマの中にはおしっこを収めきれず、滝のように流れるおしっこを書いて下さい。\n\n基本の構図は前回同様で、右上には我慢の表情を、右下には漏らした瞬間のお尻のアップを描いて下さい。\n両手は我慢のためにお尻を強く押さえているため、お尻側では指の間から泡立ったおしっこが飛び散ってしまうという瞬間を描いて欲しいです。\n\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@YuukeySps/works/2", "thumbnail_src": "https://si.imgix.net/fe6876b3/uploads/origins/222e792d-43cd-4dcd-8e54-c1053dc98fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73a1ac41e23b136b9dad1400c975c2c7", "thumbnail_srcset": "https://si.imgix.net/fe6876b3/uploads/origins/222e792d-43cd-4dcd-8e54-c1053dc98fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73a1ac41e23b136b9dad1400c975c2c7, https://si.imgix.net/fe6876b3/uploads/origins/222e792d-43cd-4dcd-8e54-c1053dc98fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffda795bcce08845d6ffd8d447b7f249 2x, https://si.imgix.net/fe6876b3/uploads/origins/222e792d-43cd-4dcd-8e54-c1053dc98fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eaca2d6e40bbe2c7a48291700d4e5a20 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@YuukeySps/works/1", "thumbnail_src": "https://si.imgix.net/652efdc4/uploads/origins/600807e3-e5f6-4b01-b261-eaf611454073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec17dd4ccb1c80688ce03323a1539a26", "thumbnail_srcset": "https://si.imgix.net/652efdc4/uploads/origins/600807e3-e5f6-4b01-b261-eaf611454073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec17dd4ccb1c80688ce03323a1539a26, https://si.imgix.net/652efdc4/uploads/origins/600807e3-e5f6-4b01-b261-eaf611454073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a87f2e5c79f5b33ce7a153050c8490d6 2x, https://si.imgix.net/652efdc4/uploads/origins/600807e3-e5f6-4b01-b261-eaf611454073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9ee82abb885e645abe5471654dea4c9 3x", "genre": "art", "nsfw": true, "body": "初めまして。いつも素晴らしい漫画とイラストを拝見しています。依頼をさせて下さい。\n\n先生の過去作『風の行方は』（『一緒にいてね』収録）からお願いします。\n主人公の佐藤佳那は、学芸会中に大勢の観客の前で緊張のためおもらししてしまいますが、原作では小コマだったこのシーンを大きく描いて下さい。\n遠くからでも見えるほど大量のおしっこを漏らしているため、ドレスはおしっこでグチャグチャになっていると思われます。\nこのおもらしがきっかけで性癖拗らせてしまい、佳那に歪んだ愛情を抱くことになるいじめっ子の喜多川潤も隅の方に描いて欲しいです。\n\n差分で構いませんので、漏らす前と漏らした後の表情の違いなど描いて頂ければ幸いです。\n必死の我慢と、解放感と羞恥心からの号泣、どちらも見てみたいです。\n\nどうかよろしくお願いします。", "created_at": "", "completed_at": ""}]}