bfc2-b1831fa3a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc371b225ac709df942a979728966543 2x, https://si.imgix.net/89b69898/uploads/origins/4eadf7d6-5f0d-4a34-bfc2-b1831fa3a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acb0d6c8e89e29e480f0a9b58b1f7ba7 3x", "genre": "art", "nsfw": false, "body": "抱きついてくれる高島あざみさんをお願いします。\n服装等はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@2423ruri/works/31", "thumbnail_src": "https://si.imgix.net/315cf966/uploads/origins/ed862186-7823-4ed8-8ae9-6b4ffeb53869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901e5afb6afdbae7302b7d180d5e344d", "thumbnail_srcset": "https://si.imgix.net/315cf966/uploads/origins/ed862186-7823-4ed8-8ae9-6b4ffeb53869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901e5afb6afdbae7302b7d180d5e344d, https://si.imgix.net/315cf966/uploads/origins/ed862186-7823-4ed8-8ae9-6b4ffeb53869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5975b47dd4ef9d8fb656f986cdfe1895 2x, https://si.imgix.net/315cf966/uploads/origins/ed862186-7823-4ed8-8ae9-6b4ffeb53869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ded4b286bfed0ae194d61bcbbaf23024 3x", "genre": "art", "nsfw": false, "body": "満月の夜に、宮城県のポケモン「ラプラス」の背に座ってなみのりしてる「松島名月」ちゃんをお願いしたいです！", "created_at": "", "completed_at": ""}, {"path": "/@2423ruri/works/30", "thumbnail_src": "https://si.imgix.net/0494bdf2/uploads/origins/e21ed516-b494-4b4a-965e-332a52d92212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fc971318dc21becb703c7c068b1a52", "thumbnail_srcset": "https://si.imgix.net/0494bdf2/uploads/origins/e21ed516-b494-4b4a-965e-332a52d92212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fc971318dc21becb703c7c068b1a52, https://si.imgix.net/0494bdf2/uploads/origins/e21ed516-b494-4b4a-965e-332a52d92212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b7e36a7efd85b0befcbff65bf62b339 2x, https://si.imgix.net/0494bdf2/uploads/origins/e21ed516-b494-4b4a-965e-332a52d92212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a209a09e9a68d47ef692ac02976bb46 3x", "genre": "art", "nsfw": false, "body": "うちのこの葦上紗樹子ちゃん( https://note.com/shirahata_ccr/n/n67de1f262102 )と貴布祢文ちゃん( https://note.com/shirahata_ccr/n/n31a503857e97 )の百合イラストをお願いします。\n\n二人の関係：\n紗樹子は巨大財閥の令嬢で、文は大神社の社家の娘。財閥や神社という属性を通して大人から接せられることの多かった二人は、自身をありのままに見てくれることを望んでいた。似たような境遇にあった二人は部活で知り合い、交流を深めていく内に段々と互いを意識し合うようになる。ない交ぜになった恋愛感情と思春期の情欲に突き動かされながら、二人の関係は深まっていく。\n\n服装：\n二人ともセーラー夏服(紗樹子は高校制服、文は中学制服)\nhttps://note.com/shirahata_ccr/n/n4b1fb25f3158\n紗樹子には制服に加えて、腕に日焼け対策のための黒色のアームカバーを付けてください\n\n構図：\n文が紗樹子の背後から抱きついている（バックハグ）\nhttps://www.pixiv.net/artworks/113859717 のような、横からの構図でお願いします。\n\n表情：\n文は安心したような表情をしていて、少し頬を赤らめている\n紗樹子は文に抱き着かれて嬉しそうな表情をしている\n文は表情があまり顔に出ないキャラクターですが、紗樹子に対しては様々な表情を見せます。\n\n備考：\n・アニメ塗りでお願いします\n・紗樹子は身長157cm、B85(E) W59 H88、文は身長149cm、B75(B) W56 H79です。ご確認いただけると幸いです。\n・背後から抱きつかれることで、紗樹子の胸が少し強調されていると嬉しいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@2423ruri/works/29", "thumbnail_src": "https://si.imgix.net/af905fe0/uploads/origins/d60e051c-7e01-4d7d-a0f5-8105e4df26db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3b5acc8e96d999b67a8dacc391878f6", "thumbnail_srcset": "https://si.imgix.net/af905fe0/uploads/origins/d60e051c-7e01-4d7d-a0f5-8105e4df26db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3b5acc8e96d999b67a8dacc391878f6, https://si.imgix.net/af905fe0/uploads/origins/d60e051c-7e01-4d7d-a0f5-8105e4df26db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26821b8341fff8ba74529f183a5d027d 2x, https://si.imgix.net/af905fe0/uploads/origins/d60e051c-7e01-4d7d-a0f5-8105e4df26db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58ba8cdb443307a72e6b31b97a6136bc 3x", "genre": "art", "nsfw": false, "body": "和服姿（出来れば着物姿）の高島あざみさんをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@2423ruri/works/28", "thumbnail_src": "https://si.imgix.net/4266fd4d/uploads/origins/06732be8-c2cd-4b4f-8118-7a28d44ff285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfdcc0d67e05b54aed3ae2cf036e2ea", "thumbnail_srcset": "https://si.imgix.net/4266fd4d/uploads/origins/06732be8-c2cd-4b4f-8118-7a28d44ff285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfdcc0d67e05b54aed3ae2cf036e2ea, https://si.imgix.net/4266fd4d/uploads/origins/06732be8-c2cd-4b4f-8118-7a28d44ff285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d72f49feb65974a1554d284aab4c12b7 2x, https://si.imgix.net/4266fd4d/uploads/origins/06732be8-c2cd-4b4f-8118-7a28d44ff285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cdabe8e9fd82be4858cd67d5390ad74 3x", "genre": "art", "nsfw": false, "body": "鉄道むすめ、八戸ときえ(夏服)全身絵、るおん先生の絵で見てみたいです。 ポーズはおまかせしますが、帽子、青いリボンはときえちゃんのトレードマークと思うので そのままお願いします。 御多忙で色々と大変とききます。無理を承知でございますが、やはりどうしても先生の絵で推しキャラを見てみたいなと思います。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@2423ruri/works/27", "thumbnail_src": "https://si.imgix.net/d2d5ed21/uploads/origins/6e5dc38c-4544-43e9-9bc7-d4bd3d4366c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a02b456356fadc08743635160e18c93", "thumbnail_srcset": "https://si.imgix.net/d2d5ed21/uploads/origins/6e5dc38c-4544-43e9-9bc7-d4bd3d4366c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a02b456356fadc08743635160e18c93, https://si.imgix.net/d2d5ed21/uploads/origins/6e5dc38c-4544-43e9-9bc7-d4bd3d4366c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d427772b53649093c3e3eed8074744a 2x, https://si.imgix.net/d2d5ed21/uploads/origins/6e5dc38c-4544-43e9-9bc7-d4bd3d4366c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr