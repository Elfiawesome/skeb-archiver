e/uploads/origins/415266de-2fc4-4612-8c35-34e0bdf00b55?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=cff000341174062a52d2df8c329bdd60 2x, https://si.imgix.net/26b06f5e/uploads/origins/415266de-2fc4-4612-8c35-34e0bdf00b55?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ca66da55ef7d06f55c7488872af5685 3x", "genre": "art", "nsfw": false, "body": "こんにちは。僕のOC、スティービーとホニーを君のスタイルで見てみたいんだ。\n\nStevieは黒のコッカースパニエルで、Honnieは金色のオカメインコです。\n\nHonnieが興奮して左右に飛び回り、Stevieと遊びたがっているのに、Stevieは座って彼女を見つめているところを見たいんだ。\n\nhttps://drive.google.com/drive/folders/1si99J1-BVInt_sMfVjHoGhqlmYSqoVZu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2748", "thumbnail_src": "https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2c5b937c0429099ff78ecb51cb67c18a", "thumbnail_srcset": "https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2c5b937c0429099ff78ecb51cb67c18a, https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e78a808c84cc1898a17dd83da7baf85e 2x, https://si.imgix.net/a88bcc8a/uploads/origins/8599fde5-9444-47c7-9766-f720049d9f08?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=12cb854dc4c94d6c6b9dea0356efc008 3x", "genre": "art", "nsfw": false, "body": "こんにちは！時兔と申します。\nTwitter（X）であなたのアニメーション作品を見つけ、とても気に入りました！\n\n私のキャラクターを描いて、アニメーションで命を吹き込んでいただけませんか？\n一番見てみたいのは、しっぽがゆるやかに揺れるところです。\n\nそれ以外の動きに関しては、あなたの創造力にお任せしたいと思っています。\nありがとうございました！\n\n参考リンクはこちらです：\nhttps://drive.google.com/file/d/1LTWg-F-k1MguXkJ_TjH8iZmR9JluhS6m/view?usp=sharing\n\nhttps://drive.google.com/file/d/1rowJ4cFzDRh4zJH5RFJ0kRb8GckzZ0r5/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2747", "thumbnail_src": "https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dcc7c934b9a3f8d75c36f6b8b85bbe09", "thumbnail_srcset": "https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dcc7c934b9a3f8d75c36f6b8b85bbe09, https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7e88a16c2f414e17b6dcb6e19404baa 2x, https://si.imgix.net/0b41c5b7/uploads/origins/2c7a6987-d41b-456d-85ec-29044f4e5b28?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=32c947a8fd07ab0b53a9bbaa2b96104a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵は素晴らしくて素晴らしいので、私の犬のOCを描いてもらえないかと思っています！\n\nもしリファレンスよりもう少しぽっちゃりしてくれたら嬉しいな :3\n\nポーズとしては、彼が腹ばいになって、床に近いところでチャブフラップの折り目が見えるようにするとか！あるいは、あなたが望むなら、あなた自身のアイデアを作ることもできる :>\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1PVRuf2mP6COcmEQuAbdnAauvmohHBtzP", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2746", "thumbnail_src": "https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc266c03e2b92eb2839e043b97bc9432", "thumbnail_srcset": "https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc266c03e2b92eb2839e043b97bc9432, https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e558ca1a1a36ce12d9a1aa82187acb22 2x, https://si.imgix.net/24228b1f/uploads/origins/d00e2700-4aec-4a59-be11-c55ee66e7357?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=02593086b989f3e50ae30a21cb958284 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ライナスが横になって寝ているアニメーションが欲しいです。オーロラはライナスのヒレで遊んでいます！\n\nオーロラは、以前お願いしたときと同じ格好で描いてください！アニメーションはGoogle Driveに用意しました。また、オーロラの花と髪の向きを参考資料と同じにしていただけますか？\n\nhttps://drive.google.com/drive/folders/1-grsJi2E-VNEK-fvMK1C2fNRncexVZ08?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2745", "thumbnail_src": "https://si.imgix.net/fabce668/uploads/origins/aa0d5da0-c2bf-408a-a999-a06e5c57a33b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2784487a72314e44294fceb5b27b2f24", "thumbnail_srcset": "https://si.imgix.net/fabce668/uploads/origins/aa0d5da0-c2bf-408a-a999-a06e5c57a33b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2784487a72314e44294fceb5b27b2f24, https://si.imgix.net/fabce668/uploads/origins/aa0d5da0-c2bf-408a-a999-a06e5c57a33b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=18ce341fa250ca58b979fae27e03d949 2x, https://si.imgix.net/fabce668/uploads/origins/aa0d5da0-c2bf-408a-a999-a06e5c57a33b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c95ea82165ac1019a10a4284dc78ec0 3x", "genre": "art", "nsfw": false, "body": "ねこたろ様\n\n初めまして。\n個人Vtuberとして活動している\n福丸ぽめといいます。\n\nねこたろ様の描くもふもふとアニメーションの可愛いさにぜひ自分を描いてほしいと思いリクエストさせていただきました！\n\n▪️キャラ\nポメラニアンのメスです。\n人間をポメラニアン中毒者にするために\n活動しています。\n\n▪️表情やポーズ\n楽しそうに走り回っているところを\n描いていただきたいです！\n服は着ていても脱いでも\nどちらでも大丈夫です。\n\n▪️使用用途\nXへの投稿\nYouTube（収益化予定）サムネイル　\nshort動画\n\n\n▪️納品希望\n背景を描いていただけるようでしたら\n人物とレイヤーを分けていただけると\nありがたいです。\n\n▪️資料\n立ち絵と三面図 送らせていただきます。\n\nご検討していただけると幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Gv2rYWHJFco8LwRozXWftpjTKNHwmkbV", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2744", "thumbnail_src": "https://si.imgix.net/ec48fcd0/uploads/origins/5bf7c5a5-465c-4afc-b2a0-b943c329fe9d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6b966e0e14943e5e804af7ff4d796e2b", "thumbnail_srcset": "https://si.imgix.net/ec48fcd0/uploads/origins/5bf7c5a5-465c-4afc-b2a0-b943c329fe9d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6b966e0e14943e5e804af7ff4d796e2b, https://si.imgix.net/ec48fcd0/uploads/origins/5bf7c5a5-465c-4afc-b2a0-b943c329fe9d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9ec5a9701a0bc9c599621dcb2352efb 2x, https://si.imgix.net/ec48fcd0/uploads/origins/5bf7c5a5-465c-4afc-b2a0-b943c329fe9d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b90653460a11efc64490ca266570570e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のOCを使ったアニメーションをまたお願いしたいです。私のリファレンスシートの \"四つ足の姿 \"を使っていただけますか？\n\n今回のアニメーションでは、私のOCが雨に濡れて帰ってきたように描いていただけますか？私のOCは雨に濡れて恥ずかしそうで、少し不機嫌そうな顔をしているはずです。\n\nドライヤーを持ったロトムにOCを乾かしてもらいたい。この画像のシナリオに少し似ていますが、ロトムで、私のOCに熱風を吹きかけているような感じにしてください。https://x.com/maumaujanken/status/1654144695855902723?s=20\n\nhttps://drive.google.com/file/d/1fWnyV3yaGFcnRVJ0lgopr2VQ3Ig6hF_J/view", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2743", "thumbnail_src": "https://si.imgix.net/1ebf5bac/uploads/origins/28418e01-23bf-441f-ad95-73bfe1857908?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=0b16cc410822d23e5957f0945d3335b2", "thumbnail_srcset": "https://si.imgix.net/1ebf5bac/uploads/origins/28418e01-23bf-441f-ad95-73bfe1857908?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=0b16cc410822d23e5957f0945d3335b2, https://si.imgix.net/1ebf5bac/uploads/origins/28418e01-23bf-441f-ad95-73bfe1857908?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba22474cc30668e6d1463b0b7509be23 2x, https://si.imgix.net/1ebf5bac/uploads/origins/28418e01-23bf-441f-ad95-73bfe1857908?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa5c3842bf1fc0af316438cf1e0d1c31 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またあなたのかわいいアートをお願いしたいです！猫が寝る前に、友達のぽっちゃりしたドラゴンに毛布をかけてあげています。\nキャラクターは以前依頼した https://skeb.jp/@mofumofu_nyaro/works/2594 を参考にしています。\nプロポーションは前回と同様です。ドラゴンも帽子をかぶって寝ています。", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2742", "thumbnail_src": "https://si.imgix.net/5ab4a87e/uploads/origins/c60c8f0f-c8a2-4d17-96b3-95b62191c5ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9e8eb46730eb3da5be6fe934d809aa14", "thumbnail_srcset": "https://si.imgix.net/5ab4a87e/uploads/origins/c60c8f0f-c8a2-4d17-96b3-95b62191c5ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9e8eb46730eb3da5be6fe934d809aa14, https://si.imgix.net/5ab4a87e/uploads/origins/c60c8f0f-c8a2-4d17-96b3-95b62191c5ab?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=38cc62e6df706465c761715504b775dc 2x, https://si.imgix.net/5ab4a87e/uploads/origins/c60c8f0f-c8a2-4d17-96b3-95b62191c5ab?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=221ecaf2186a21d1a2c694c1e18a3d0f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が大好きで、私のハムスターの絵を描いて欲しいと思っていました。）こんな感じです。https://i.imgur.com/BXhwxlB.png\n\n彼の最も重要な点は、目の瞳孔としてオン/オフのサインを持っていることです。\n\n私が望んでいたこと\n\n- できれば、ハムスターが画面に向かって（4本足で）走ってほしい。ハムスターがいつも走っている車輪の上とか！それが複雑すぎるなら、普通に走ったり、2本足で歩いたりしても構いません！\n- 表情は、よく描く半目で口を開けているのが好きです！ちょっとドヤ顔のハムスターなので、その辺もお任せします。\n\n以上、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2741", "thumbnail_src": "https://si.imgix.net/8b77eb10/uploads/origins/df19bcaa-9ac6-4d83-b362-8e94563a5a7c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d4641fbf3cf386802c49fd34439565e3", "thumbnail_srcset": "https://si.imgix.net/8b77eb10/uploads/origins/df19bcaa-9ac6-4d83-b362-8e94563a5a7c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d4641fbf3cf386802c49fd34439565e3, https://si.imgix.net/8b77eb10/uploads/origins/df19bcaa-9ac6-4d83-b362-8e94563a5a7c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee510e6e96f71bb8d79581803d8539e2 2x, https://si.imgix.net/8b77eb10/uploads/origins/df19bcaa-9ac6-4d83-b362-8e94563a5a7c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1de527ea3ae7b1a504d3800babcd9ff9 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\n私のポケソナのコスモ（オス、ニャースティック）がツインテールを回転させて空を飛ぶところを見たいのです。下記を参考にしてください：\n\nhttps://drive.google.com/file/d/1NlrKYZn0Ta-5YgONmnkSpxH5Sfraq-IW/view?usp=drive_link\n\n私のポケソナのリファレンスシートも以下にあります。\n\nhttps://drive.google.com/file/d/1zuKUFv-w5w9P-R3ZEjGwg7Jqef_0-5Tu/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2740", "thumbnail_src": "https://si.imgix.net/599fbe57/uploads/origins/17690f5b-60a1-45b9-97b5-70016b758a8f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=efb645f1dc65b20056124324d721de3f", "thumbnail_srcset": "https://si.imgix.net/599fbe57/uploads/origins/17690f5b-60a1-45b9-97b5-70016b758a8f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=efb645f1dc65b20056124324d721de3f, https://si.imgix.net/599fbe57/uploads/origins/17690f5b-60a1-45b9-97b5-70016b758a8f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=09b4647b3353279a2b274d22099dd110 2x, https://si.imgix.net/599fbe57/uploads/origins/17690f5b-60a1-45b9-97b5-70016b758a8f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdddd691274287d411af431c9d508cb0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、もふもふ先生！Xで偶然先生の作品に出会いました。かわいい画風にも惹かれ、私のOCのイラストを描いていただきたいと思いました！リクエストはこのキャラクターの体は宙を舞っていて、表情は少しぎこちなく、無力に見えます。キャラクターの参考リンクはこちらです。https://drive.google.com/drive/folders/1LLCtOeygkFxp7p3oybZPtdVSppBMtEIJ お願いします！今回も依頼を引き受けていただき、ありがとうございました！\nキャラの目の形はあらかじめ決まっていて、マスコット体型（tdm）。かわいいけどストイックな表情なので、表情はあまり変わりません。性格はおとなしいです。頭にはメビウスの帯のようなものがあり、光を放つ。各種魔法に長けており、空を飛ぶことができる。", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2739", "thumbnail_src": "https://si.imgix.net/0b6f87f0/uploads/origins/72989594-41ae-4b0e-8615-22477ad4aad2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=615a3c8728f7823c9d92c2ff5427908a", "thumbnail_srcset": "https://si.imgix.net/0b6f87f0/uploads/origins/72989594-41ae-4b0e-8615-22477ad4aad2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=615a3c8728f7823c9d92c2ff5427908a, https://si.imgix.net/0b6f87f0/uploads/origins/72989594-41ae-4b0e-8615-22477ad4aad2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fb63922806157e1e8e6bdc39d19fdab 2x, https://si.imgix.net/0b6f87f0/uploads/origins/72989594-41ae-4b0e-8615-22477ad4aad2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b68995bec9289c1c5efb2884f124660 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！僕とセヴヴィーはまた一緒に仕事をしたいんだ。今回は、私（ピンクのシルベオン/ニンフィア）がセヴィー（ブルーのシルベオン/ニンフィア）にお腹をさすってあげること。セヴィーはお腹を上に向けて仰向けに寝ているはずだ。グーグルドライブのリンクに「pose_ref.png」というポーズと表情を示す画像があります。\n\nhttps://drive.google.com/drive/folders/18Ira0TsWkjuNSH135hpAfcjdGc2KDEO5?usp=drive_link\n\nhttps://drive.google.com/drive/folders/18Ira0TsWkjuNSH135hpAfcjdGc2KDEO5?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2738", "thumbnail_src": "https://si.imgix.net/ffc9acf7/uploads/origins/5a7c457b-9791-4c73-a8f4-61f7b70b6265?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=eebaaca39ffe8371a71fe477255de3c4", "thumbnail_srcset": "https://si.imgix.net/ffc9acf7/uploads/origins/5a7c457b-9791-4c73-a8f4-61f7b70b6265?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=eebaaca39ffe8371a71fe477255de3c4, https://si.imgix.net/ffc9acf7/uploads/origins/5a7c457b-9791-4c73-a8f4-61f7b70b6265?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=94db9a0a72e34e069a85a289a8e6e1c4 2x, https://si.imgix.net/ffc9acf7/uploads/origins/5a7c457b-9791-4c73-a8f4-61f7b70b6265?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcb91bae9cfea43ed1f2b4ccbe22b6c2 3x", "genre": "art", "nsfw": false, "body": "初めまして！とてもかわいい絵柄です！\n\n今日はポケモンの絵を依頼したいと思います～\n内容としては、優しく慰めるリオルは膝の上で乗っているイーブイをなでなでするという感じです。イーブイはゆるい感じの表情のがいいかもね～\n\n何卒よろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2737", "thumbnail_src": "https://si.imgix.net/f1c7349e/uploads/origins/21b41a45-ef33-4788-86a1-b533aec86b35?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc73c7880a6dd7604bbc0be413ed028f", "thumbnail_srcset": "https://si.imgix.net/f1c7349e/uploads/origins/21b41a45-ef33-4788-86a1-b533aec86b35?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc73c7880a6dd7604bbc0be413ed028f, https://si.imgix.net/f1c7349e/uploads/origins/21b41a45-ef33-4788-86a1-b533aec86b35?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da6310309dc032f53717e19848e5914 2x, https://si.imgix.net/f1c7349e/uploads/origins/21b41a45-ef33-4788-86a1-b533aec86b35?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=21da0a248f2f06443ebb148659b3dbd8 3x", "genre": "art", "nsfw": false, "body": "Hello, sensai!\nI'm delighted you accepted my friend's commission. Another character of his would also like to submit a commission request to you:\ncharacter reference: https://1drv.ms/f/c/6a8e65b6d252f7b8/EutmO5q5RApIsfNFmPiFXXwBlgkuQva2SQziKcri7NIFAA?e=afmntf\n\n【situation】The black tiger sits on a chair with its legs stretched forward (revealing the pads on its feet). One paw mimics a gun-shooting gesture (see GIF reference), while the other paw is held outstretched. Its mouth forms the “biu” sound of firing (see GIF reference). Simultaneously, its head tilts to the side, one ear twitches in sync, and its tail swings back and forth behind it.\nGIF reference: https://1drv.ms/i/c/6a8e65b6d252f7b8/IQDpfAloYNJrQqYkC4b2yXeYAa6EscWyC6X6wANsTB7vMNo?e=DbNcrr\n\nAnd really love your artworks, sorry for the wrong URL!", "created_at": "", "completed_at": ""}, {"path": "/@mofumofu_nyaro/works/2736", "thumbnail_src": "https://si.imgix.net/230aacc8/uploads/origins/1482afbf-0ef2-4898-8f91-454c11907738?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5982bf5fb30b8487c541db424bb4f2f0", "thumbnail_srcset": 