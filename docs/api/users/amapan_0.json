s/origins/46ce28c3-d81c-4675-804a-3bfd0caa52fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8339cb9b3b1ea87547bcf9add0cc4f6c 2x, https://si.imgix.net/4a442ffe/uploads/origins/46ce28c3-d81c-4675-804a-3bfd0caa52fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89dc90bef2dc05b779b5ce68bd95f861 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amapan_0/works/48", "thumbnail_src": "https://si.imgix.net/9b08814e/uploads/origins/0aa3afec-a11c-42b7-a347-e6553bd2f6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df6bf2bb52eb224474c492e770fbec1", "thumbnail_srcset": "https://si.imgix.net/9b08814e/uploads/origins/0aa3afec-a11c-42b7-a347-e6553bd2f6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df6bf2bb52eb224474c492e770fbec1, https://si.imgix.net/9b08814e/uploads/origins/0aa3afec-a11c-42b7-a347-e6553bd2f6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49e07f1c5625219881a7cdf641219224 2x, https://si.imgix.net/9b08814e/uploads/origins/0aa3afec-a11c-42b7-a347-e6553bd2f6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c2d34ec3866dd19d1c1361c63ec6392 3x", "genre": "art", "nsfw": false, "body": "𝗞𝗠𝗡𝗞さんはじめまして\n\nこの度は私のOCを描いていただきたくリクエストしました！𝗞𝗠𝗡𝗞さんの描かれる女の子がだいすきなため服装/構図など全ておまかせします！NGありませんのでヘアアレンジなどご自由にしてください♡\n\nまた資料にあるきつねのぬいぐるみの描写があると嬉しいです！\n\n【詳細】\n・前髪ぱっつん 胸までのロング レイヤーカット\n・気が強く我儘でツンデレ 感情が全て顔に出る\n・可愛い物と本と食べることが好き \n・ つり目 瞳の色は黒〜桃色\n・右目頭と左口元にホクロあり \n・長いネイル（装飾省いても◎）\n・割れたハート（💔）がモチーフ\n\n【資料】\nhttps://photos.app.goo.gl/JTfk9gjHnkeJh5S28", "created_at": "", "completed_at": ""}, {"path": "/@amapan_0/works/47", "thumbnail_src": "https://si.imgix.net/1ceace09/uploads/origins/