Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=845b43a9351742509b0ead659e560db9 3x", "genre": "art", "nsfw": false, "body": "グラス博士推しなのでグラス博士を\n書いて欲しいです｡指定は特にありません｡\nよろしくお願いします｡", "created_at": "", "completed_at": ""}, {"path": "/@yukkurimahoro/works/3", "thumbnail_src": "https://si.imgix.net/e7d90242/uploads/origins/4e12242e-1552-4b62-b7b7-ddd3bc59d295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbabd1aa7974057059c417bf477f030", "thumbnail_srcset": "https://si.imgix.net/e7d90242/uploads/origins/4e12242e-1552-4b62-b7b7-ddd3bc59d295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbabd1aa7974057059c417bf477f030, https://si.imgix.net/e7d90242/uploads/origins/4e12242e-1552-4b62-b7b7-ddd3bc59d295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2abc91bd8c38433050b3035a197bab4 2x, https://si.imgix.net/e7d90242/uploads/origins/4e12242e-1552-4b62-b7b7-ddd3bc59d295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=886059389ab28703b723b34d59f7e2b5 3x", "genre": "art", "nsfw": false, "body": "いつも楽しく動画やイラストを拝見しております。リクエスト失礼します。\n\nキャラ：エージェントヨリックとブライト博士をお願いします。\n服装:ヨリックがDoesn't work memeの時の服装、ブライト博士が白衣でお願いします。\nシチュエーション:二人が絡んでいれば、後はお任せします（ブライト博士の孫説は本人から否定されているので、できれば血縁設定は避けていただけると幸いです）\n\nライセンス記載方法はクリエイティブ・コモンズ・ライセンスに即していればお任せします。\n\n長々と失礼しました。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yukkurimahoro/works/2", "thumbnail_src": "https://si.imgix.net/444f6ee2/uploads/origins/63f7b1bc-d7d3-49c2-82ef-cecc16cdae60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1225a959af4247e515bd84f224b776", "thumbnail_srcset": "https://si.imgix.net/444f6ee2/uploads/origins/63f7b1bc-d7d3-49c2-82ef-cecc16cdae60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1225a959af4247e515bd84f224b776, https://si.imgix.net/444f6ee2/uploads/origins/63f7b1bc-d7d3-49c2-82ef-cecc16cdae60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8796e4d1dcc466afdcfdbefe7159cfdb 2x, https://si.imgix.net/444f6ee2/uploads/origins/63f7b1bc-d7d3-49c2-82ef-cecc16cdae60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72bd74d96ab7e4dec3651b2428c09f7e 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n絵柄に惹かれましたので、依頼の方をお願いしたくお送りさせていただきました。\n今回依頼させていただきたいキャラは私がPSO2NGSで使っているマイキャラクターをロボトミーコーポレーションのセフィラの立ち絵風に描いていただきたいです。\n\n三面図&顔:https://twitter.com/nanaya_miyabi/status/1624512685739220992\n\n今回服装に関しては、この三面図で着ているものでお願いします。\n後は可能ならでよいのですが、青主体カラーの「A」の腕章(マルクトなどセフィラが付けてるMなどの腕章です)も追加して頂けると嬉しいです。\n\n構図や表情はゆっくりまほろ様のお好みでお願いします。\n\n以上となります。\nもし受けていただけるのでしたら、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yukkurimahoro/works/1", "thumbnail_src": "https://si.imgix.net/7ee2ce17/uploads/origins/e5645767-7a1f-4f77-845b-49d120617ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef1d9e14b78574c5cd7f0c9b6d2c4e6c", "thumbnail_srcset": "https://si.imgix.net/7ee2ce17/uploads/origins/e5645767-7a1f-4f77-845b-49d120617ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef1d9e14b78574c5cd7f0c9b6d2c4e6c, https://si.imgix.net/7ee2ce17/uploads/origins/e5645767-7a1f-4f77-845b-49d120617ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=497ddf0f0a1592fce684a95bcbcac838 2x, https://si.imgix.net/7ee2ce17/uploads/origins/e5645767-7a1f-4f77-845b-49d120617ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d895707e05d9f6540b76bf92a269ba37 3x", "genre": "art", "nsfw": false, "body": "skebのリクエスト失礼いたします。\n\n・キャラ（頭身）：SCP財団のアイスバーグ博士とギアーズ博士\n（2人が難しい場合はアイスバーグ博士のみ）\n・服装：白衣を着用していればあとはお任せ\n・シチュエーション：お任せ\n・背景：お任せ\n・その他：CC BY-SAライセンスの記載など必要な事柄はイラスト内に記載していただいて問題ありません。\n\n内容が合わなければキャンセルしていただいて大丈夫です。\n お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}