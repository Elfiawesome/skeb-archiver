%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a886cc9c2d5213a373442dc5510c4c0", "thumbnail_srcset": "https://si.imgix.net/5abb8342/uploads/origins/126d1501-5f29-4054-816c-05c9a79bbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a886cc9c2d5213a373442dc5510c4c0, https://si.imgix.net/5abb8342/uploads/origins/126d1501-5f29-4054-816c-05c9a79bbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e4126d341f509b848ac7a544ed8493c 2x, https://si.imgix.net/5abb8342/uploads/origins/126d1501-5f29-4054-816c-05c9a79bbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6029f754263f6be8a15e603359d3b7f6 3x", "genre": "art", "nsfw": false, "body": "8108さん、こんにちは！梦人间』という中国のビジュアルノベルの登場人物のリクエストに応えていただけませんか？私のキャラクター、楊露星は隣人でクラスメートの霍沫の幼なじみです。\n\n楊露星が霍沫にキスをするイラストをお願いしたいです。二人はよく赤い糸であやとりをして遊んでいるので、赤い糸で絡まったり巻かれたりしているのもかわいいかなと思いました！\n\n参考文献や登場人物についての詳細はこちら：\n- 楊露星：https://ganbarebenji.carrd.co/#yang-ruoxing\n- フオ・ブーリ：https://ganbarebenji.carrd.co/#huo-buli\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/34", "thumbnail_src": "https://si.imgix.net/0483ed75/uploads/origins/47586dcc-bf5f-42be-9c62-0d7b6cd92c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff0db655ef7d30962916d1aa18da6f1", "thumbnail_srcset": "https://si.imgix.net/0483ed75/uploads/origins/47586dcc-bf5f-42be-9c62-0d7b6cd92c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff0db655ef7d30962916d1aa18da6f1, https://si.imgix.net/0483ed75/uploads/origins/47586dcc-bf5f-42be-9c62-0d7b6cd92c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5ae4bbc378fd7600d3a89aeb1a76f99 2x, https://si.imgix.net/0483ed75/uploads/origins/47586dcc-bf5f-42be-9c62-0d7b6cd92c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b63799a20a5921057d4025a2d6a61c4 3x", "genre": "art", "nsfw": false, "body": "8108さんのイラストが大好きです。\n私のOCを描いていただけないでしょうか？\n\n世界観\n古代中国を舞台とした仙狭ファンタジー\n最強の女主人公とその弟子の物語。\n正義の味方の女主人公！\nしかし、彼女が弟子として迎えた者達は何故か皆、超がつく程の極悪人に育ってしまった！？\nさぁ彼らを再び正道へ導きなおそう！\n\n❄️姚雪梅（やおしゅえめい）\n最強の女主人公。雪と梅モチーフ。\n見た目24歳くらい。中身は100歳越えのおばあちゃん。\nキツイ美人。凛としていて雪の様な冷たい雰囲気。\n彼女の佇まいだけで見る人の背筋が自然と伸びる様な存在。\n剣を片手に妖魔奇怪を次々と倒し、襲われている人々を救い出す正義のヒーロー。\n自分に厳しく他人にも厳しい。\n人々が彼女に抱く「正義のヒーロー」になるべく、己の柔らかい感情は全て凍り付かせて表に出ないようにしている。\n本来は頑固なお節介焼きおばあちゃん。\n\n🦚林希睿（りんしーるい）\n姚雪梅の二番弟子。カササギがモチーフ。\n見た目21歳くらい。中身は64歳くらい。\n一国を影から乗っ取り、万の人々を恐怖に陥れた悪辣策士。頭脳派キャラ。\n政争に敗れた名門貴族出身。\n一族は族誅されて唯一生き残った天涯孤独の身。\n子供の頃、妖魔奇怪に襲われているところを姚雪梅に助けられ、彼女に弟子入りした。\n助けてくれた姚雪梅に対して歪んだ執着を持っている。\n表情筋が柔らかく、コロコロと表情が変わる。\n相手を嘲笑したり、皮肉を言ったりすることも。性格はかなり悪い。\nしかし、男女の色事には全く免疫がなく話を振られると真っ赤になって取り乱す。\n\n二人のモチーフの雪と梅、カササギを組み合わせ\n「困難（冬）を乗り越えて幸運（春）がやってくる」\nという意味を持たせています。\n衝突し、剣を向け合ったりする2人が、さまざまな困難を乗り越え、恋愛的に結ばれます。\nお互いの凍りついてしまった心を少しずつ溶かしあうような関係です。\n\n恋愛的面では、二人とも恋愛の「れ」の字も知れないような人達。\n姚雪梅の恋愛レベルがゼロなら林希睿はマイナス100なので、女性側から迫られて赤面して慌てて男性が逃げるような関係。\n二人でお茶を飲みながらお菓子を摘むのが好きです。\n\n服装や髪型は資料と違っていても大丈夫です。\nご自由に描いてください。\n内容が合わない場合はキャンセルしてください。\n検討お願いします\n\nhttps://drive.google.com/drive/folders/1oFE-U13xpjAEwslVgajWfpIf4J6qybtn", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/33", "thumbnail_src": "https://si.imgix.net/c6837441/uploads/origins/14bdf11e-19f6-440c-a1dc-005498137e91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=097d0d5d4d81325f2a86f51605f870b3", "thumbnail_srcset": "https://si.imgix.net/c6837441/uploads/origins/14bdf11e-19f6-440c-a1dc-005498137e91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=097d0d5d4d81325f2a86f51605f870b3, https://si.imgix.net/c6837441/uploads/origins/14bdf11e-19f6-440c-a1dc-005498137e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f064d9ec14c975435ffd6a64419d0873 2x, https://si.imgix.net/c6837441/uploads/origins/14bdf11e-19f6-440c-a1dc-005498137e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=389bbef719a3a37632ab08bc52f07f04 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/32", "thumbnail_src": "https://si.imgix.net/cb3d717b/uploads/origins/24abc2d9-3642-4724-bc3c-535a710093ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8117c83829fe1a1917c34c572d8dbb7", "thumbnail_srcset": "https://si.imgix.net/cb3d717b/uploads/origins/24abc2d9-3642-4724-bc3c-535a710093ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8117c83829fe1a1917c34c572d8dbb7, https://si.imgix.net/cb3d717b/uploads/origins/24abc2d9-3642-4724-bc3c-535a710093ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92d3a20acf54dafa1a357068d33b3aed 2x, https://si.imgix.net/cb3d717b/uploads/origins/24abc2d9-3642-4724-bc3c-535a710093ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=919d5d88a3e2e12c15d81121f8e54ee6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/31", "thumbnail_src": "https://si.imgix.net/92b3c903/uploads/origins/a967a2ca-8dc9-4716-9f8e-a9685facbd7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3914ecafd19d7d059db8ee10c795c04c", "thumbnail_srcset": "https://si.imgix.net/92b3c903/uploads/origins/a967a2ca-8dc9-4716-9f8e-a9685facbd7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3914ecafd19d7d059db8ee10c795c04c, https://si.imgix.net/92b3c903/uploads/origins/a967a2ca-8dc9-4716-9f8e-a9685facbd7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74be673ae63e3c0934b4ec8767117f15 2x, https://si.imgix.net/92b3c903/uploads/origins/a967a2ca-8dc9-4716-9f8e-a9685facbd7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97357af74eec65a42146d137100fe5e2 3x", "genre": "art", "nsfw": false, "body": "箱庭た2a】様初めまして！。\nあなたの画風がとても好きなので、私のOCを描いてほしいです。値段が合わなければ自由に変更してください(っ˘зʕ-̫͡-ʔ)\n\nこの二人のキャラクターは旅の仲間で、恋愛関係ではありません。もっと親密な言葉を使うなら「兄妹」のようなものです。二人が交わす可能性のある交流には、西洋の世界観の中であらゆるものと交流すること、野生で狩りをしたり、美味しい食べ物やリラックスを求めて様々な人間の街や村、お祭りによく出没することなどがあります。\n特別な条件はありません。メッセージを読んだ後、あなたのアイデアに従って自由に描いてください、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1YCfm1Xyxf2lGM-lrVv_K9ulZN9TBMDZs?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/30", "thumbnail_src": "https://si.imgix.net/e8a9a0d2/uploads/origins/11e163e4-26ea-43fd-9b3e-2afde04409b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1a8c4a95d6f0aef800e15e8563e163", "thumbnail_srcset": "https://si.imgix.net/e8a9a0d2/uploads/origins/11e163e4-26ea-43fd-9b3e-2afde04409b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1a8c4a95d6f0aef800e15e8563e163, https://si.imgix.net/e8a9a0d2/uploads/origins/11e163e4-26ea-43fd-9b3e-2afde04409b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ad677d5ffea4b75fe9df8f050286313 2x, https://si.imgix.net/e8a9a0d2/uploads/origins/11e163e4-26ea-43fd-9b3e-2afde04409b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d3cbc0a5a15baf2ca295fa4a2828607 3x", "genre": "art", "nsfw": false, "body": "初めまして!私のOCを描いていただけないでしょうか。\n彼らは恋人ではなく、家族と友人の間の特別な存在で、お互いにとって最も大切な人です。子供の頃は幼馴染で、事故で記憶を失い、その後、別の事故をきっかけに再会し、記憶を取り戻しました。現在は隣人で、関係は以前よりも深まっています。\n\n神戸川 春（黒髪、176cm）  \n警察  \n明るく外向的で、感情の機微には鈍い。秩序を守り、正義感が強く、勇敢でエネルギッシュ、人を守りたいという気持ちが強い。\n\n宇都宮 双奏（白髪、172cm）  \n無職  \n尖った言葉と笑顔の“狐男”、皮肉な言い回しが多い。親しい人にはおとなしく無害だが、内心は警戒心が強く、他人を信じにくく、自尊心が高い。\n\n特にこだわりはないので、お好きなスタイルで描いてください。詳細はURLに載せておきます。\n金額が合わなければ再送してもらうことも可能です。ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1D68MTI1O5m41crUzaQL0PPhk_AEpUloO", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/29", "thumbnail_src": "https://si.imgix.net/11d38639/uploads/origins/3fb57073-3d57-4f3e-949f-4c9160f54624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a247f72de143e0590b2c5dd1b6200d", "thumbnail_srcset": "https://si.imgix.net/11d38639/uploads/origins/3fb57073-3d57-4f3e-949f-4c9160f54624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a247f72de143e0590b2c5dd1b6200d, https://si.imgix.net/11d38639/uploads/origins/3fb57073-3d57-4f3e-949f-4c9160f54624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d1b302a7cc18c620600439913db7c0a 2x, https://si.imgix.net/11d38639/uploads/origins/3fb57073-3d57-4f3e-949f-4c9160f54624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0be9ae891f853b29da83e945d377ea7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの作品は色彩も表現も素晴らしいと思います。\n\n私のキャラクター、シレーヌを描いていただけませんか？できれば、彼の好きな楽器、ウクレレを弾いているところを描いていただけませんか？彼はスタンダードな木製のウクレレを持っています。\nhttps://drive.google.com/drive/folders/1b1KQ8o5FzeRTiZICOiwMeiDAtgn5Za0H?usp=sharing\n\n彼は魔法の馬の少年です。彼は長い間病弱だったので、多くの時間を寝て過ごしている。疲労が激しいので、一人でリラックスして過ごすことが多い。優しいが、明るくノリが良いので、ちょっとお茶目な性格。\n\n趣味は音楽を演奏すること、植物を育てること、編み物をすること。\n\nhttps://skeb.jp/@8108yasohc/works/15 この作品の雰囲気がとても好きです。同じようなものを描いていただけると嬉しいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/28", "thumbnail_src": "https://si.imgix.net/40c55434/uploads/origins/ca81201e-e663-42d0-8bde-d272f198b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=289df8c8f7c8f0269b7e6bfc08b59e7a", "thumbnail_srcset": "https://si.imgix.net/40c55434/uploads/origins/ca81201e-e663-42d0-8bde-d272f198b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=289df8c8f7c8f0269b7e6bfc08b59e7a, https://si.imgix.net/40c55434/uploads/origins/ca81201e-e663-42d0-8bde-d272f198b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ace531471740f9c1841d98c29e45c80e 2x, https://si.imgix.net/40c55434/uploads/origins/ca81201e-e663-42d0-8bde-d272f198b4c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ec63511a5a1e420ba3c8ea9418be35c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの仕事が本当に好きで、長い間あなたのことをフォローしています！このような機会をいただき、光栄です。機械翻訳ですので、間違いがありましたらご容赦ください。\n以下、私のオリジナルキャラクター2人の紹介です。\nF（名前）：髪と目が黒く、口角と両頬にほくろがある少年。温厚だが、たまに辛辣で意地悪。M（金髪のほうの名前）同様、スポーツが得意で歌を聴くのが好き、よく食べるので体重管理に苦労している。\nM（名前）：金髪で緑色の目をした少年で、Fより年下。外国人の若者で、より熱狂的、意志的、衝動的。マジシャンのようなもので、次に何をするか予想がつかない。しかし、テニスやバドミントンなどのスポーツではいつもFに勝てない。\n二人の関係は、CB/CP、良き友人でありながらライバルでもある。ありがとうございました\n\nhttps://drive.google.com/drive/folders/1HRcdWjYNS0ewPxJw6kZ5dRmHfGngKBz8", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/27", "thumbnail_src": "https://si.imgix.net/350fb1bd/uploads/origins/235a0aa3-54e6-47d8-a4aa-3fcae1ae1d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a8d196c01b9da7b9ea788e58902fa3d", "thumbnail_srcset": "https://si.imgix.net/350fb1bd/uploads/origins/235a0aa3-54e6-47d8-a4aa-3fcae1ae1d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a8d196c01b9da7b9ea788e58902fa3d, https://si.imgix.net/350fb1bd/uploads/origins/235a0aa3-54e6-47d8-a4aa-3fcae1ae1d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=675e0a5bd72eed63c4bb5faf10a96bc5 2x, https://si.imgix.net/350fb1bd/uploads/origins/235a0aa3-54e6-47d8-a4aa-3fcae1ae1d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfdd72ea9f974bf69234035911ff39fd 3x", "genre": "art", "nsfw": false, "body": "はじめまして！よろしければ自キャラ3人のイラストをリクエストしたいです。\n\nキャラ詳細：\nRamaluz （らまるす）\n150cm 16歳\n魔法学校に通いながら、宮廷錬金術師のインターンとして働いています。性格はおっとりしていて穏やかで。行動力が高く、考えるより先に体が動いてしまう感覚派です。\n\nPopo（ぽっぽ）\n174cm（人の姿） 233歳\n元はフクロウですが魔法薬で人の姿に。今はRamaluzと一緒に暮らし、保護者のような存在です。短気ですが面倒見がよく、嫌味を言いながらも自主的に彼女の世話をしています。頭が良く、論理的な人物です。\n\nBobo（ぼーぼ）\n181cm（人の姿）  493歳\n元はフクロウ2。Popoの兄で、弟を溺愛しています。家族には内緒でマフィアの幹部を務めており、組織のカジノを経営しています。基本的に豪快でノリが良い性格ですが、部下の前では厳しい一面も見せます。\n\n三人は家族のような親しい関係です。\n\n衣装の変更やアレンジーも歓迎なのでご自由にに描いて頂ければ嬉しいです。金額不足の場合は気軽に再送要請してください。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-EmrECAvH2LqvIBpLv100fPR_WAeOaI5", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/26", "thumbnail_src": "https://si.imgix.net/b3a0232e/uploads/origins/ce5d8c71-071f-4d25-935c-a0c1b4c3655e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a557c88a612bcb371e741a05a79f717f", "thumbnail_srcset": "https://si.imgix.net/b3a0232e/uploads/origins/ce5d8c71-071f-4d25-935c-a0c1b4c3655e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a557c88a612bcb371e741a05a79f717f, https://si.imgix.net/b3a0232e/uploads/origins/ce5d8c71-071f-4d25-935c-a0c1b4c3655e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddc5184896f8e357351fba41492655b2 2x, https://si.imgix.net/b3a0232e/uploads/origins/ce5d8c71-071f-4d25-935c-a0c1b4c3655e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a25c204604464272e64b5c9fed687c43 3x", "genre": "art", "nsfw": false, "body": "春の始まりを印象付ける絵を書いていただきたいです！\n\n背景について\n・梅の木の下で梅の花びらが中に詰められた鮮花餅を食べている2人の男の娘と少年を映すように沢があり、梅の花びらがうすピンクで鮮やか。\n・青々とした春の始まりを告げる雰囲気にしてください。\n・雰囲気的には鮮花餅を美味しそうに、嬉しそうに頬張る華奢な少女と鮮花餅を少し照れた感じで渡す大きめの少年に見える雰囲気でお願いします。\n\n左側の男の娘\n・身長155センチ、体重34キロの15歳\n・左眼はフクロウから移植した目、右はヘーゼル\n・華奢な体で、濃い茶髪の髪は三つ編みを輪っかにしたような髪型を左右でして、左側の額を隠す形で三つ編みをし、天然パーマのぱっつん前髪。ちなみに両方の輪っかを赤い髪紐で止めている。\n・薄い赤の斎胸襦裙をして、白い絹の天女が付けてる布みたいなのを身に着けている。\n・右手首と首に包帯を巻いている。\n・12歳の時に、右の男の姉に左耳を傷付けられ形がいびつなため、形を隠すイヤーカフをつけている。\n・男だが男の格好で外に出ると「女の子が男の格好をして野蛮な振る舞いをするな」と勘違いされて怒られるため女の格好で外へ出るようにしている。\n・西方から連れてこられた女奴隷と、洛陽の大手商人の息子との間に生まれたハーフで、女奴隷が連れてきたゴブリンといった低級の魔が喪黒福造でいう「ドーン！」をするときの能力源になるためそれをされると1週間寝込む。\n・全体的に影があり、いつも悲しそうな顔をしているが本気で笑ってても悲しそうな笑い顔をしているように見える。\n・左に配置、梅の花びらがつめられた鮮花餅を右側の大きな男から口で受け取っている\n・美味しそう、頬いっぱいに鮮花餅を詰めて食べている。\n\n右側の男\n・身長180センチで16歳、体重78キロ\n・薄い顔のイケメンで、兄貴分の金持ち\n・絹のような黒髪を後ろでまとめている。\n・仲間や子分たちに対しては傲慢だが左側の男の娘に対しては自分の姉が「悲しい」ことをした罪悪感がきっかけで、いつの間にか泣く時は一緒に泣き、笑うときは一緒に笑う仲になった。\n・左の男の娘が好きなのを隠すため、照れ隠しの顔をしている。\n・紫色の服を着ていて、どことなく高貴さがある。\n・男の娘のためなら命をかけて守る。\n\nできればスマホとgmailの画面にしたいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/25", "thumbnail_src": "https://si.imgix.net/280e023d/uploads/origins/419b29e1-65bc-444b-80b6-1146d86b327e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987c3459cc4641bf25094fb7ad8616a8", "thumbnail_srcset": "https://si.imgix.net/280e023d/uploads/origins/419b29e1-65bc-444b-80b6-1146d86b327e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987c3459cc4641bf25094fb7ad8616a8, https://si.imgix.net/280e023d/uploads/origins/419b29e1-65bc-444b-80b6-1146d86b327e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0da779aafd0b4318ce3ac0346cdf386 2x, https://si.imgix.net/280e023d/uploads/origins/419b29e1-65bc-444b-80b6-1146d86b327e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e70eb439de291cac8eb4f228b406ddb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵がとても好きで、私と友人のOCを描いていただきたいと思います！彼らはカップルです。\n\nしんぺい-お兄ちゃんみたいで、優しくて、面倒見がいい。身長178cm。\n\n車椅子の女の子（少し歩ける）。いつも笑顔でエレガント。晋平を最初にいじめることが多いが、いじり返されることもある。\n\nパフェやクレープなどのデザートを食べているところを描いてください。何でもいいです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-2szTIjdm95qI7rWNlyty-lKGNQLBlT2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/24", "thumbnail_src": "https://si.imgix.net/2da869fb/uploads/origins/eb3203e2-4ff8-4df5-b9c4-28ce30a7bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4fb9d7eeda855818420b7598c60d22", "thumbnail_srcset": "https://si.imgix.net/2da869fb/uploads/origins/eb3203e2-4ff8-4df5-b9c4-28ce30a7bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4fb9d7eeda855818420b7598c60d22, https://si.imgix.net/2da869fb/uploads/origins/eb3203e2-4ff8-4df5-b9c4-28ce30a7bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abc87200ca50e0cf84ed3ad23164e8c1 2x, https://si.imgix.net/2da869fb/uploads/origins/eb3203e2-4ff8-4df5-b9c4-28ce30a7bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7897dd0158a67b07ab4081b10c2f1b44 3x", "genre": "art", "nsfw": false, "body": "リクエストの機会をいただき、ありがとうございました。\n\n曖昧な関係の同級生。一方は愛が通じないと思っているが、もう一方は感情表現が難しい（複雑な種類の感情）。金髪の方が明るく感情的。\n\nどんなムードやシナリオでもOK！\nラブレター、紙飛行機。\n\n参考フォルダ：https://drive.google.com/drive/u/1/folders/1sIK7z-7G_dZxP3enmh_Ynj1Jzu8SaJjl\n\nありがとうございました！あなたの作品がとても好きです！", "created_at": "", "completed_at": ""}, {"path": "/@8108yasohc/works/23", "thumbnail_src": "https://si.imgix.net/4802464d/uploads/origins/24e167a7-771c-4b29-92a6-8cd1244ed447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd66f8674bf21c29e30cce1cbc034b08", "thumbnail_srcset": "https://si.imgix.net/4802464d/uploads/origins/24e167a7-771c-4b29-92a6-8cd1244ed447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd66f8674bf21c29e30cce1cbc034b08, https://si.imgix.net/4802464d/uploads/origins/24e167a7-771c-4b29-92a6-8cd1244ed447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac2e1ff5594a46a1ec4dbb74cdd2a15f 2x, https://si.imgix.net/4802464d/uploads/origins/24e167a7-771c-4b29-92a6-8cd1244ed447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74c37e56daf815bd9621c0e47cc1564c 3x