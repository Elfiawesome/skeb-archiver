きやすい方を選択、あるいは適宜変更していただいて大丈夫です。今回、先生のキャラクターを使って勝手にシチュエーションを作ってしまいましたため、キャラ付けに合わないなどの問題がございましたらお手数ですがキャンセルなどでご対応いただければと思います。\n\n条件が見合うようでしたら、是非よろしくお願いいたします。\n\nhttps://www.fanbox.cc/@fun/posts/7698108", "created_at": "", "completed_at": ""}, {"path": "/@nutim4n/works/3", "thumbnail_src": "https://si.imgix.net/87c69962/uploads/origins/851d40b9-a64f-4132-a4f3-93354f5c27ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45511592ec8802755cca413f8f6ec504", "thumbnail_srcset": "https://si.imgix.net/87c69962/uploads/origins/851d40b9-a64f-4132-a4f3-93354f5c27ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45511592ec8802755cca413f8f6ec504, https://si.imgix.net/87c69962/uploads/origins/851d40b9-a64f-4132-a4f3-93354f5c27ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9d57eb5dab88cfb746239156ab4743d 2x, https://si.imgix.net/87c69962/uploads/origins/851d40b9-a64f-4132-a4f3-93354f5c27ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eeeeee01586424291c7fad88439b29c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nutim4n/works/2", "thumbnail_src": "https://si.imgix.net/b16a82b8/uploads/origins/3288357f-8e54-4826-87b7-2515ebaa55fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f78723373f0123d0f0f1df65707604", "thumbnail_srcset": "https://si.imgix.net/b16a82b8/uploads/origins/3288357f-8e54-4826-87b7-2515ebaa55fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f78723373f0123d0f0f1df65707604, https:/