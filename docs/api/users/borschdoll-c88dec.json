bddd, https://si.imgix.net/5557ab2b/uploads/origins/8c63c8b2-35ae-4c4c-ba35-bd9f9d4cbbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8736128d266430f3d40a010e89cd4700 2x, https://si.imgix.net/5557ab2b/uploads/origins/8c63c8b2-35ae-4c4c-ba35-bd9f9d4cbbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67c8e9885af9efccaa65e491fe4a45fb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@borschdoll/works/18", "thumbnail_src": "https://si.imgix.net/0da725da/uploads/origins/a25ccded-11df-4ed1-acbf-aaf1a64956a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2def71a31ebe66c2dee442f7c3b46da9", "thumbnail_srcset": "https://si.imgix.net/0da725da/uploads/origins/a25ccded-11df-4ed1-acbf-aaf1a64956a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2def71a31ebe66c2dee442f7c3b46da9, https://si.imgix.net/0da725da/uploads/origins/a25ccded-11df-4ed1-acbf-aaf1a64956a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b81f0a7ab8164f18400c32d492c15968 2x, https://si.imgix.net/0da725da/uploads/origins/a25ccded-11df-4ed1-acbf-aaf1a64956a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6ae95d1763842532959151fc88dcb90 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nまたリクエストを送りたいと思います。前回のイラストがとても良かったので\nキャラクターはダークエルヴン フォレストレンジャーとラストオリジンのセレスティアです。\nダークエルフ・フォレストレンジャーはフタナリで、セレスティアは普通の女性です。\nどちらもセックスをしていて、完全に裸です。\n巨大なおっぱい\nポーズはあなたが決めてください。\nありがとうございます\n\nセレスティア \nhttps://static.wikia.nocookie.net/lastorigin/images/f/f1/Cerestia.png/revision/latest?cb=20200802233438\nダークエルブン フォレストレンジャー\nhttps://static.wikia.nocookie.net/lastorigin/images/a/a0/Dark_Elven_Forest_Ranger_Skin_1.png/revision/late