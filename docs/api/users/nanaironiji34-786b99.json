7-9bd4-ba02b3ec8fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e4ac8964c9f22f55685d712002825c4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nanaironiji34/works/18", "thumbnail_src": "https://si.imgix.net/f27512d7/uploads/origins/73db4d13-f648-4baf-9151-a384f75854e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd648abdd189a98fe718e91bd6a7df5", "thumbnail_srcset": "https://si.imgix.net/f27512d7/uploads/origins/73db4d13-f648-4baf-9151-a384f75854e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd648abdd189a98fe718e91bd6a7df5, https://si.imgix.net/f27512d7/uploads/origins/73db4d13-f648-4baf-9151-a384f75854e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f4a40fdb263b563fa1e182ee5e8f12d 2x, https://si.imgix.net/f27512d7/uploads/origins/73db4d13-f648-4baf-9151-a384f75854e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5afef546695fd72dbdd76c0a2ce2da1 3x", "genre": "art", "nsfw": false, "body": "七瀬葵先生\n\nお世話になっております。\n先日はとても可愛いイラストをありがとうございます！\n\nこの度は、Vtuberの　空詩ぷるむ（@Sorashi_Purumu）さん　のイラストをリクエストさせていただきます。\n\n【使用用途】\n\nご本人様へのプレゼント\nご本人様に限りの配信活動（配信内や、配信のサムネ、X(旧Twitter)、FANBOX等で使用する可能性があります）での使用許諾を頂きたいです。\n使用不可がある場合は別レイヤー等に記載していただけますでしょうか。\n※空詩ぷるむさんは、Skeb等でのご依頼を許可しております。\n\n背景等を付けていただける場合は、透過のデータも含めてPSD形式納品いただけますと大変助かります。\n\n【イメージ・衣装・髪型】\n\nラフな格好で髪を結んでないストレートヘアの空詩ぷるむをお願いいたします。\nお風呂上りや朝の準備などの、ブラシで髪を梳かしているシチュエーションをお願いいたします。\n\n【その他】\n\nサムネイル等で使い易いように耳や髪が見切れないようにして頂けると幸いです。\n※ぷるむさんはオッドアイです。\n\n金額の不足等ございましたら再送要請を頂けると幸いです。\n長文となりましたが、どうかご検討のほど宜しくお願いいたします。\n\n【参考資料】\n\nhttps://lit.link/sorashipurumu\nhttps://twitter.com/Sorashi_Purumu", "created_at": "", "completed_at": ""}, {"path": "/@nanaironiji34/works/17", "thumbnail_src": "https://si.imgix.net/2e0b096d/uploads/origins/096be7f4-c10b-4b20-94cb-1b075fd42d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f2f6bfcd388f79ea274f82e8d8e3083", "thumbnail_srcset": "https://si.imgix.net/2e0b096d/uploads/origins/096be7f4-c10b-4b20-94cb-1b075fd42d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f2f6bfcd388f79ea274f82e8d8e3083, https://si.imgix.net/2e0b096d/uploads/origins/096be7f4-c10b-4b20-94cb-1b075fd42d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61733084679f9c55ad26e26ddcce86e5 2x, https://si.imgix.net/2e0b096d/uploads/origins/096be7f4-c10b-4b20-94cb-1b075fd42d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ee572d96a93c3a011574077d578aed4 3x", "genre": "art", "nsfw": true, "body": "七瀬葵先生初めまして！\n素敵なイラストばかりで、ぜひご依頼したいと思いました。\nお願いしたいのは2023/9/9にホロライブデビューした新人VTuber、\n＼かわいい！ポジティブ！ジーニアス！／\n「一条莉々華」さんのイラストです。\nR18許可あります(①参考)\n\nシチュですが、配信後、配信を切り忘れてることに気付かずオナニーの声を配信してしまう姿をお願いしたいです。\n\n②の部屋で椅子の上でオナニーをして感じていて、\n服は着たまま上着は上に捲って両胸が出ていて、足はM字で開いてスカートは捲れて、片手は胸を、もう片手はパンツの中に手を入れている姿でお願いします。\n★配信を切り忘れてるのがわかるように、PCのモニター画面でリスナーがコメントで慌てていて、例「これ大丈夫？」「放送事故」「配信切れてないよ！？」「えっっっっ」みたいに反応しているのが分かるようにお願いいたします。(例えば画面に文字とか、モニターから吹き出しとか)\n\n構図は可能であれば人物は正面か斜め前からのでお願いします。\n\nないとは思いますが、ご本人様のSNSや配信での利用の許可をいただけたら幸いです。\n\n色々と細かいと思いますが、どうかよろしくお願いいたします。\n\n\n①三面図など(R18許可)\nhttps://x.com/ichijouririka/status/1700720388639199463?s=46&t=0aJ2VSjFJIbwLnLjM3LvbA\n\n②部屋の様子\nhttps://x.com/ichijouririka/status/1701430386277154817?s=46&t=0aJ2VSjFJIbwLnLjM3LvbA\n\n③初配信の様子\nhttps://www.youtube.com/live/vFLBCWLwLJk?si=tSld1ebDqioYMqLJ", "created_at": "", "completed_at": ""}, {"path": "/@nanaironiji34/works/16", "thumbnail_src": "https://si.imgix.net/be73f91a/uploads/origins/1fc86669-9859-4be9-aabb-9ca3956aee2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca158c5633aacc98957b32d79c2a5f69", "thumbnail_srcset": "https://si.imgix.net/be73f91a/uploads/origins/1fc86669-9859-4be9-aabb-9ca3956aee2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca158c5633aacc98957b32d79c2a5f69, https://si.imgix.net/be73f91a/uploads/origins/1fc86669-9859-4be9-aabb-9ca3956aee2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da545599f5db85ca1d3f25c3cd30c143 2x, https://si.imgix.net/be73f91a/uploads/origins/1fc86669-9859-4be9-aabb-9ca3956aee2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d2eea76fb0ea73040ba5436396a8b32 3x", "genre": "art", "nsfw": false, "body": "はじめまして！X（旧Twitter）で先生の「星街すいせい」さんのイラストをお見かけして、イラストをお願いしたいと思い連絡させていただきました。\n先生のイラストは、子供の頃に友人と遊んでいたゲーム関連のイラストで拝見しておりました。当時コミケに行けるような年齢ではなかったので作品を直接手に取ることができませんでしたが、各媒体に掲載されていた当時の美しいイラストが今でも記憶に残っています。\nXで拝見したときに、昔あこがれた先生が好きなVtuberのイラストを描かれていたため、驚きと喜びで画面を2度見してしまいました。\n私はプレイステーションのゲーム「グランツーリスモ７」の中でゲーム仲間と一緒に痛車を作っているのですが、痛車の素材として是非先生のイラストを使用したいと思い、この度ご連絡させていただいた次第です。\n\n１　依頼内容\n (1)　「星街すいせい」のイラスト。描画範囲としては、膝から上があればいいです。足元は先生にお任せします。左右は見切れなしでお願いします。\n (2)　「星街すいせい」の衣装は、正月向けの晴れ着をお願いいたします。先生のオリジナルでも、既成の正月衣装でもかまいません。(例：https://twitter.com/suisei_hosimati/status/1212671102784176131)\n (3)　背景は先生にお任せします。ただし、画像をゲーム用に加工する必要があるのですが、この際に手作業でトレースしなければなりません。背景と人物をレイヤーで分けてほしいと思います。\n\n２　用途等\n (1)　グランツーリスモ７というゲームの中で、ゲーム仲間とともに痛車を作るための素材にしたいと考えています。もちろん非営利目的です。\n (2)　正月用の素材として公開したいと考えています。イラストをいただいた後、加工するのに１カ月近くかかりますので、今お願いすれば冬休み時期～正月に間に合うかも…と考えておりました。\n\n３　その他\nゲーム仲間は年齢が幅広く、私同様に先生のイラストを覚えている方もいますので、先生のイラストを使用させていただくことができれば多くの方に喜んでいただけると思います。何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nanaironiji34/works/15", "thumbnail_src": "https://si.imgix.net/2f8e0630/uploads/origins/98542124-5b1e-491d-9cba-db3ff450cc60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53aed587899e03de247d4e4c7277e602", "thumbnail_srcset": "https://si.imgix.net/2f8e0630/uploads/origins/98542124-5b1e-491d-9cba-db3ff450cc60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53aed587899e03de247d4e4c7277e602, https://si.imgix.net/2f8e