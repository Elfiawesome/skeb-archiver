15-9e28-2cadc4d346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b6a8ab2ad463877214dacc3a793c7a, https://si.imgix.net/dce0d684/uploads/origins/6388c842-ef4f-4915-9e28-2cadc4d346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=633d2e5099919345a5257ebca892c607 2x, https://si.imgix.net/dce0d684/uploads/origins/6388c842-ef4f-4915-9e28-2cadc4d346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19f3ad6bc91f7ee66d6e7f5c5f8f237f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！(*^^*)ツイート拝見しました！画風がかわいいですね。私のOCを描いてほしいです。彼女の名前はヘダです。自信満々で生意気な子です。\n\nこんな感じで、衣装もこんな感じでお願いします。\nhttps://drive.google.com/drive/folders/1FxCRKOLeC8nFRMG8QvF4Up2JOiaWcDEX\n\n参考写真の花を持っているところを描いていただけませんか？紫色の花の色を使ってほしいです。もう一枚のオレンジの花の写真も念のため参考ですが、オレンジの色は使わないでください。ポーズ、表情、構図はお任せします。\n\n注意事項\n- 顔のマーク\n- 頭の横の羽\n\nこの子の性格がわかるフォルダはこちらです。\nhttps://drive.google.com/drive/folders/1ez1xyMmhjaEOI5OPDjG0XAaCvsNsEXIK\n\nご検討いただき、ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@Shio_Toukou/works/2", "thumbnail_src": "https://si.imgix.net/e35a017b/uploads/origins/ecdab6d1-4f29-4d25-b8ab-0e7b70224a59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f860bba56041a1f3b57a8dc767bf643f", "thumbnail_srcset": "https://si.imgix.net/e35a017b/uploads/origins/ecdab6d1-4f29-4d25-b8ab-0e7b70224a59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f860bba56041a1f3b57a8dc767bf643f, https://si.imgix.net/e35a017b/uploads/origins/ecdab6d1-4f29-4d25-b8ab-0e7b70224a59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=387214b25aad0fccabcee2b181e14139 2x, https://si.imgix.net/e35a017b/uploads/origins/ecdab6d1-4f29-4d25-b8ab-0e7b70224a59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c72a72eff65fb470770b4464a633a20 3x", "genre": "art", "nsfw": false, "body": "こんにちは、今回は幻影インパクトの胡桃の作品をお願いします。葬儀社の社長という意外と明るい性格で、イタズラ好きな彼女は、花火と妖怪を駆使して