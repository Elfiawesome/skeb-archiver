.com/watch?v=ADtdKI0M5hk\n\n昔からU-4🇯🇵さんの格闘イラストが好きです！\nよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@U4front/works/128", "thumbnail_src": "https://si.imgix.net/5fa5a5f6/uploads/origins/cb2dcd9a-acdd-43aa-87d0-742740710fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b4c95ca16234b730664617b654fb887", "thumbnail_srcset": "https://si.imgix.net/5fa5a5f6/uploads/origins/cb2dcd9a-acdd-43aa-87d0-742740710fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b4c95ca16234b730664617b654fb887, https://si.imgix.net/5fa5a5f6/uploads/origins/cb2dcd9a-acdd-43aa-87d0-742740710fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77550811f4c7bc8b590b1497bba8923d 2x, https://si.imgix.net/5fa5a5f6/uploads/origins/cb2dcd9a-acdd-43aa-87d0-742740710fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33a74f3053c4221c59b8d675978aa029 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@U4front/works/127", "thumbnail_src": "https://si.imgix.net/4b113674/uploads/origins/6ffc2807-5f3a-42dc-b513-9200bab1cc57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2febe0de37df562bc94c0e086349dc21", "thumbnail_srcset": "https://si.imgix.net/4b113674/uploads/origins/6ffc2807-5f3a-42dc-b513-9200bab1cc57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2febe0de37df562bc94c0e086349dc21, https://si.imgix.net/4b113674/uploads/origins/6ffc2807-5f3a-42dc-b513-9200bab1cc57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=