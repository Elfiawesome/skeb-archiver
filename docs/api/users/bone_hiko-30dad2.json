at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9944c0d7bc42dd3d0c2e0b401269812c 2x, https://si.imgix.net/46ede7ae/uploads/origins/3d38298f-8dac-4069-acc8-623e9edca2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd61265eec9be58bb34f273074743795 3x", "genre": "art", "nsfw": true, "body": "度々すみません・・・skeb再開したようなのでどうしても骨彦さんに依頼したくて・・・。 \n今回はアークナイツのスカジ（前衛の昇進前）の着衣パイズリをお願いしたいです・・・。\n骨彦さんの描くスカジめちゃ好きなので・・・。\n可能であればで結構ですので、何回戦もパイズリする連続射精を描いて頂ければと思います・・・。 \nその他の細かいシチュ等はお任せします・・・。\n 形式はイラストでも漫画でもお好きな方で構いません・・・。\nよろしければご検討の程お願い致します・・・。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/17", "thumbnail_src": "https://si.imgix.net/1222854f/uploads/origins/783837ba-3e22-42d3-aba3-84de3d820ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01730666d4f5e2504a4707ebfdd8d87", "thumbnail_srcset": "https://si.imgix.net/1222854f/uploads/origins/783837ba-3e22-42d3-aba3-84de3d820ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01730666d4f5e2504a4707ebfdd8d87, https://si.imgix.net/1222854f/uploads/origins/783837ba-3e22-42d3-aba3-84de3d820ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d86c50e593b5862bdad41389fef47030 2x, https://si.imgix.net/1222854f/uploads/origins/783837ba-3e22-42d3-aba3-84de3d820ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01919967ba1379fff37da990a49a7ab8 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nTwitterにて素敵なイラストを拝見し、ぜひご依頼させていただきたいと思いご連絡させていただきました。\n\nさて、早速ではありますが、以下ご依頼したい内容となっております。\nお忙しいとは存じますが、何卒ご検討の程よろしくお願いいたします。\n\n・ゲーム『ブルーアーカイブ』のキャラクター、「百合園セイア」\n・優しく微笑んでいるような表情、姿勢等はお任せしたく思います。\n・用途として、Twitter、discordなどのSNSのアイコンなどとして使用したいと考えております。\n\nなお、依頼内容に不備・不明瞭な点等ありましたら、お手数ですがご遠慮なくお断りいただければと思います。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/16", "thumbnail_src": "https://si.imgix.net/f79090d8/uploads/origins/43db0dba-2fa9-4ed9-a01e-e6117a057af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6c7ccd6c75e4f1e0081f5fbe7a9219a", "thumbnail_srcset": "https://si.imgix.net/f79090d8/uploads/origins/43db0dba-2fa9-4ed9-a01e-e6117a057af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6c7ccd6c75e4f1e0081f5fbe7a9219a, https://si.imgix.net/f79090d8/uploads/origins/43db0dba-2fa9-4ed9-a01e-e6117a057af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5577e97f8bc983f1a5469fae19993352 2x, https://si.imgix.net/f79090d8/uploads/origins/43db0dba-2fa9-4ed9-a01e-e6117a057af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e662ce56fa6a9b48b095f4cfa3daba69 3x", "genre": "art", "nsfw": true, "body": "また骨彦さんのえっちな絵が見たくて・・・。\nブルアカの空井サキの黒インナーを着たままでの馬乗り着衣パイズリをリクエストしたいのですが・・・。\n細かいシチュ等はお任せします・・・。\n形式はイラストでも漫画でもお好きな方で構いません・・・。\nよろしければご検討のほどお願い致します・・・。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/15", "thumbnail_src": "https://si.imgix.net/635c56d1/uploads/origins/1191b38f-58e8-4d21-ac07-661a39a1c548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed4b099fb8ba53876bf83ece837e13b9", "thumbnail_srcset": "https://si.imgix.net/635c56d1/uploads/origins/1191b38f-58e8-4d21-ac07-661a39a1c548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed4b099fb8ba53876bf83ece837e13b9, https://si.imgix.net/635c56d1/uploads/origins/1191b38f-58e8-4d21-ac07-661a39a1c548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9265c4d4d3e1981246ee01f4c8bf985d 2x, https://si.imgix.net/635c56d1/uploads/origins/1191b38f-58e8-4d21-ac07-661a39a1c548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efaf9e3cd8598687c6d97d7a06a03190 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nTwitterでサキのイラストを見てやってきました。\nリクエストをお願いしてもいいですか？\n\nブルアカから出るアリウス·スクワッドの秤アツコをお願いしたいです。\n\n先生を全力で誘惑するアツコにお願いしたいです。\n構図とかシチュエーションは自由にしてください！", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/14", "thumbnail_src": "https://si.imgix.net/60a83afd/uploads/origins/ea521d6e-1b4b-44c4-9af6-55f43bac91c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d27df56909439d39afc4b7ec8323cc24", "thumbnail_srcset": "https://si.imgix.net/60a83afd/uploads/origins/ea521d6e-1b4b-44c4-9af6-55f43bac91c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d27df56909439d39afc4b7ec8323cc24, https://si.imgix.net/60a83afd/uploads/origins/ea521d6e-1b4b-44c4-9af6-55f43bac91c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb1ea734456530c4bdfb2d7e2d518170 2x, https://si.imgix.net/60a83afd/uploads/origins/ea521d6e-1b4b-44c4-9af6-55f43bac91c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91fd6bf27728e8a17ee88b7c01003fd9 3x", "genre": "art", "nsfw": true, "body": "先日描かれていた天樹院マリーを見てすごく懐かしかったので、\n彼女が未来にてパイズリで誘惑しているところをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/13", "thumbnail_src": "https://si.imgix.net/74fa3048/uploads/origins/cead5099-faaf-4a68-8b7f-936a9dae7173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a33a13120c4cdf468946eeb994b6208", "thumbnail_srcset": "https://si.imgix.net/74fa3048/uploads/origins/cead5099-faaf-4a68-8b7f-936a9dae7173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a33a13120c4cdf468946eeb994b6208, https://si.imgix.net/74fa3048/uploads/origins/cead5099-faaf-4a68-8b7f-936a9dae7173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=440943510b5f1efb654377c4771e8963 2x, https://si.imgix.net/74fa3048/uploads/origins/cead5099-faaf-4a68-8b7f-936a9dae7173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81023ac1f06e9dbdd95efa6cec717766 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/12", "thumbnail_src": "https://si.imgix.net/b63c8ce4/uploads/origins/750a1892-7d2d-4182-be7f-c3d4f01144ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10278a1e05c4920980e89326d648dd4d", "thumbnail_srcset": "https://si.imgix.net/b63c8ce4/uploads/origins/750a1892-7d2d-4182-be7f-c3d4f01144ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10278a1e05c4920980e89326d648dd4d, https://si.imgix.net/b63c8ce4/uploads/origins/750a1892-7d2d-4182-be7f-c3d4f01144ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=898cebd51ec639e23e93dd9fff53faa0 2x, https://si.imgix.net/b63c8ce4/uploads/origins/750a1892-7d2d-4182-be7f-c3d4f01144ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dedf64486d6cf8362684891fb0e2c154 3x", "genre": "art", "nsfw": true, "body": "うすうすアーカイブ派でしたが以前boneさんがfanboxで描かれていたヒヨリのお腹を見てから気になってしかたないのでブルーアーカイブの槌永ヒヨリをお願いします。\n公式の1.5周年水着イラストの右上で美食研と一緒になって際どい水着でピザ食べてるようなイメージで、\nお腹は以前描かれていたくらい柔らかそうな感じでお願いします。\nNSFW有効にしましたので際どさ加減はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/11", "thumbnail_src": "https://si.imgix.net/a09da78d/uploads/origins/a261fa33-3372-43e6-bec5-693316e52c1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c6063e77e1445215917635a7c11299b", "thumbnail_srcset": "https://si.imgix.net/a09da78d/uploads/origins/a261fa33-3372-43e6-bec5-693316e52c1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c6063e77e1445215917635a7c11299b, https://si.imgix.net/a09da78d/uploads/origins/a261fa33-3372-43e6-bec5-693316e52c1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc39b369a3722f56382cc810c09e1bad 2x, https://si.imgix.net/a09da78d/uploads/origins/a261fa33-3372-43e6-bec5-693316e52c1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf3651a96da1e05cebbfdb23d3413ab0 3x", "genre": "art", "nsfw": true, "body": "でかでかスポブラから片乳だけ出してどでか乳輪見せてくれるブルアカのサキをお願いします。\nむれむれだととてもうれしいです。おちちと乳輪のサイズ感はだいたいこれくらいがいいです。https://twitter.com/akanefujimiya/status/1507680514466975744", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/10", "thumbnail_src": "https://si.imgix.net/8da61b8f/uploads/origins/d582cf67-4778-42a3-9131-9d25c969dfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6585e9a9e28c429d945c35633d529bbb", "thumbnail_srcset": "https://si.imgix.net/8da61b8f/uploads/origins/d582cf67-4778-42a3-9131-9d25c969dfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6585e9a9e28c429d945c35633d529bbb, https://si.imgix.net/8da61b8f/uploads/origins/d582cf67-4778-42a3-9131-9d25c969dfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96739e1c385a660210c210adee3b4861 2x, https://si.imgix.net/8da61b8f/uploads/origins/d582cf67-4778-42a3-9131-9d25c969dfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a53597cbe769a70ad4d8871a9de20a9 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイブ　聖園ミカを依頼したいです。\n\nエデン条約編、4章中編がもう少しで実装されますが、状況が悪くなっているミカに心が苦しいです。\nティーパーティーの優雅な雰囲気と幸せそうなミカをお願いしたいです…。\n詳細はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/9", "thumbnail_src": "https://si.imgix.net/066b9f64/uploads/origins/8ad79720-3812-4b11-9d8a-cee2710c87f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0502119e90d99d25572bec364ef05a", "thumbnail_srcset": "https://si.imgix.net/066b9f64/uploads/origins/8ad79720-3812-4b11-9d8a-cee2710c87f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0502119e90d99d25572bec364ef05a, https://si.imgix.net/066b9f64/uploads/origins/8ad79720-3812-4b11-9d8a-cee2710c87f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c00ed0635f8ef38528904956eb9de26 2x, https://si.imgix.net/066b9f64/uploads/origins/8ad79720-3812-4b11-9d8a-cee2710c87f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a495302367ab3fef0d46801da17b525 3x", "genre": "art", "nsfw": true, "body": "骨彦さんのえっちな絵が見たくて・・・。\nブルアカのツクヨの着衣パイズリをリクエストしたいのですが・・・。\n形式はイラストでも漫画でもお好きな方で構いません・・・。\nよろしければご検討のほどお願い致します・・・。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/8", "thumbnail_src": "https://si.imgix.net/1f4faa5f/uploads/origins/e7492320-fff4-4999-8f8d-e05cf4bc6769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa2bb8abd53bc882905a3e2d814de9d", "thumbnail_srcset": "https://si.imgix.net/1f4faa5f/uploads/origins/e7492320-fff4-4999-8f8d-e05cf4bc6769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa2bb8abd53bc882905a3e2d814de9d, https://si.imgix.net/1f4faa5f/uploads/origins/e7492320-fff4-4999-8f8d-e05cf4bc6769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa48482f095998f29f0953eadf23b6ac 2x, https://si.imgix.net/1f4faa5f/uploads/origins/e7492320-fff4-4999-8f8d-e05cf4bc6769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3caf1d9b7c4c6fcae943e24482b95a63 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nTwitterで素敵なイラストを拝見させていただきました。もしよろしければリクエストさせていただけないでしょうか？\n\nブルーアーカイブのキャラで聖園ミカもしくは黒舘ハルナどちらかお好きな方をお願いします。\n構図やシチュエーション等はお任せします。\nよろしければご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/7", "thumbnail_src": "https://si.imgix.net/57618384/uploads/origins/871e7f01-9ee9-43a6-b91c-078f6d78ca60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0311e04204f1d564e827fa0450dec09", "thumbnail_srcset": "https://si.imgix.net/57618384/uploads/origins/871e7f01-9ee9-43a6-b91c-078f6d78ca60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0311e04204f1d564e827fa0450dec09, https://si.imgix.net/57618384/uploads/origins/871e7f01-9ee9-43a6-b91c-078f6d78ca60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=489d87f0c29ee6db52d476a2fd36a3ba 2x, https://si.imgix.net/57618384/uploads/origins/871e7f01-9ee9-43a6-b91c-078f6d78ca60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61c45ba34001bb0fcc3e6e8e0fd29755 3x", "genre": "art", "nsfw": true, "body": "下記のパンツ見せ舞衣ちゃんがえっちだったのでご依頼させていただきます。\nhttps://skeb.jp/@bone_hiko/works/5\n\nチャイナドレスの寿々花さん（https://i.imgur.com/IqiU7qB.png）で上記の舞衣ちゃん同様に\nドレスのスリットを捲ってパンツを見せてる（ブラは外して近くに置いてある）構図でお願いします。\n表情は舞衣ちゃんと同様恥ずかしがってる感じに少し屈辱感があれば嬉しいです。\n下着はワインレッドカラーのスケスケTバックでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/6", "thumbnail_src": "https://si.imgix.net/d158a096/uploads/origins/ce77f8e2-5d34-4e53-9d3f-2fe489e4cbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=852fd377e343397106002a7bacee0758", "thumbnail_srcset": "https://si.imgix.net/d158a096/uploads/origins/ce77f8e2-5d34-4e53-9d3f-2fe489e4cbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=852fd377e343397106002a7bacee0758, https://si.imgix.net/d158a096/uploads/origins/ce77f8e2-5d34-4e53-9d3f-2fe489e4cbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0586748e6d8d89bfa67b6014cd93ca7a 2x, https://si.imgix.net/d158a096/uploads/origins/ce77f8e2-5d34-4e53-9d3f-2fe489e4cbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c535a6de10798c7d7e075b7ca2f5226 3x", "genre": "art", "nsfw": true, "body": "初めまして、メイヤーのパイズリ絵をお見掛けして素晴らしかったのでリクエストの方させて頂きたいと思います。\nリクエストの内容ですが、アークナイツのシデロカの着衣パイズリをお願いしたいです。\n細かいシチュ等は資料を参考にして頂きたいのですが、大体の流れが資料通りであればセリフ構図等は改変して頂いても構いませんので、ご検討のほど宜しくお願い致します。\n\nhttps://www.dropbox.com/s/pre81as672rwgqg/%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB%202021-10-21%204%2021%2004.png?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/5", "thumbnail_src": "https://si.imgix.net/e1311938/uploads/origins/f0ac211a-8bc6-4d11-a40c-b0214896a88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=322af75672b3d07df9871a1399f68d4c", "thumbnail_srcset": "https://si.imgix.net/e1311938/uploads/origins/f0ac211a-8bc6-4d11-a40c-b0214896a88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=322af75672b3d07df9871a1399f68d4c, https://si.imgix.net/e1311938/uploads/origins/f0ac211a-8bc6-4d11-a40c-b0214896a88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d1425b8b828703bfca300cd64984fac 2x, https://si.imgix.net/e1311938/uploads/origins/f0ac211a-8bc6-4d11-a40c-b0214896a88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a894e396e3786459205caf07350a86c1 3x", "genre": "art", "nsfw": true, "body": "チアガール衣装の柳瀬舞衣ちゃんがスカートをたくし上げておぱんつ見せてくれるイラストをお願いします！\n\n恥ずかしがってるせいで胸が押されてぎゅっ♡ってなってたり、ふとももがもじもじ♡してたりして、とにかくエッチな感じになってると嬉しいです！\n\nおぱんつはかわいい系で、白パンでも良いと思います！\n念のためNSFWの依頼となりますが、ご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/4", "thumbnail_src": "https://si.imgix.net/3cdac957/uploads/origins/b4c4d625-5ed2-44df-a792-c13fafb31f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40be985584b46d6bffaec2e9894d0369", "thumbnail_srcset": "https://si.imgix.net/3cdac957/uploads/origins/b4c4d625-5ed2-44df-a792-c13fafb31f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40be985584b46d6bffaec2e9894d0369, https://si.imgix.net/3cdac957/uploads/origins/b4c4d625-5ed2-44df-a792-c13fafb31f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d614b0abeb4fed4362efc52a0142ac6 2x, https://si.imgix.net/3cdac957/uploads/origins/b4c4d625-5ed2-44df-a792-c13fafb31f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=441e84f1591795b1323c05cec97f2802 3x", "genre": "art", "nsfw": true, "body": "アークナイツのメイヤーちゃんが、ショタになっちゃったドクター(幼博)を縦セタ着衣パイズリで優しく射精させてあげているイラストを依頼します！\n・ドクターは何らかで一時的に肉体と精神が幼くなっている状態、頭を描く場合はフードのみ有りで目元は見えない(目隠れショタ的な)\n・親愛度200で、幼博はされるがままなおねショタ。精液染みがセーターにできます。\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/3", "thumbnail_src": "https://si.imgix.net/e31aa692/uploads/origins/9bb1d99a-aabc-44c0-b159-abc144489f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5928b406ad40a1d6f939d6f1a2efba47", "thumbnail_srcset": "https://si.imgix.net/e31aa692/uploads/origins/9bb1d99a-aabc-44c0-b159-abc144489f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5928b406ad40a1d6f939d6f1a2efba47, https://si.imgix.net/e31aa692/uploads/origins/9bb1d99a-aabc-44c0-b159-abc144489f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=531a482b546503f56b32525609474a20 2x, https://si.imgix.net/e31aa692/uploads/origins/9bb1d99a-aabc-44c0-b159-abc144489f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb0828d7c22a0e2a6fd8c59edca47514 3x", "genre": "art", "nsfw": true, "body": "鎌府女学院水着を着て布団の中から手招きしてくる糸見沙耶香（刀使ノ巫女）をお願いします。\n以下要望です。\n・イメージは以前描かれていたオリジナルの「ベッドの中」と同じ\n・水着が胸からわずかに浮いて、乳首が見えそうで見えない\n・胸そのもののサイズは大きくないけど、下向きの姿勢になっているためやや大きく見える\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bone_hiko/works/2", "thumbnail_src": "https://si.imgix.net/600f27f9/uploads/origins/19b4cd22-6d23-4ea4-bc1e-b59face0792f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2e621a4d793f24c53f9edf45300c785", "thumbnail_srcset": "https://si.imgix.net/600f27f9/uploads/origins/19b4cd22-6d23-4ea4-bc1e-b59face0792f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&