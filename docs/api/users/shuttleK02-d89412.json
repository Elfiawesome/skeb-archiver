959-414464d079c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7e12f60f4a68cdcd3213162935fc57", "thumbnail_srcset": "https://si.imgix.net/85ffbaf2/uploads/origins/60947685-c4ea-4a56-8959-414464d079c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7e12f60f4a68cdcd3213162935fc57, https://si.imgix.net/85ffbaf2/uploads/origins/60947685-c4ea-4a56-8959-414464d079c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=658613038ef76ba75248f719cae64a56 2x, https://si.imgix.net/85ffbaf2/uploads/origins/60947685-c4ea-4a56-8959-414464d079c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9537652ae38291e2de9120858a94d301 3x", "genre": "art", "nsfw": false, "body": "こんにちは！とても気に入ったよ！\n\nできればまたFFXIVキャラクターの絵をお願いしたいです～。\n\n白い肌の猫娘です。\n白い髪としっぽが特徴です。\n右目はライトイエロー、左目はライトブルー。\n体は細身で、胸の大きさは中くらいです。\nキュートで活発\n\n服装や外見は写真を参考にしてください。\n白い水着を着ています。\nエッチでキュートなポーズもいいですね。\n細かいデザインはお任せします！\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://imgur.com/a/GnjBuiC", "created_at": "", "completed_at": ""}, {"path": "/@shuttleK02/works/13", "thumbnail_src": "https://si.imgix.net/f44e33ea/uploads/origins/6a2fee53-15af-4360-8eef-da2291409113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=332bece57f61ffd0fb917973b76dc2c5", "thumbnail_srcset": "https://si.imgix.net/f44e33ea/uploads/origins/6a2fee53-15af-4360-8eef-da2291409113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=332bece57f61ffd0fb917973b76dc2c5, https://si.imgix.net/f44e33ea/uploads/origins/6a2fee53-15af-4360-8eef-da2291409113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f1248e6a4f3172f61bd9e6adecc462d 2x, https://si.imgix.net/f44e33ea/uploads/origins/6a2fee53-15af-4360-8eef-da2291409113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b398630ee2de01fa0c887f1fc4c1a69 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのアートスタイルとあなたのアートが本当に大好きです。私は依頼をお願いしたいのですが、2人のキャラクターから選んでもらいたいと思います。\n\n光：\n驚異的な魔力を持つハーフエルフで、青い炎の魔法を使うことができる。彼女の翼は自分の中に住む不死鳥のもので、火のような青いオーラを放つ。友人には忠実だが、敵には凶暴な敵である。\n\nニア\n無作法で野蛮に見えるが、親しい人には面倒見がよく、同情的な魔性の狼。斬ると呪われる村正の刀を持ち歩いている。背は低いが、ライトのライバルである。\n\n2人のキャラクターを選んでもらい、どちらが好きか選んでもらいたい。ポーズも自由ですし、どう描くかも自由です。BGは彼らのスタイルに合わせたものを作ってください。\n\nご配慮いただき、もしこの依頼をお受けすることになれば、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1tdC-isj0DPjI2IJtG8zVpEQM8xFFs2IZ?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@shuttleK02/works/12", "thumbnail_src": "https://si.imgix.net/eaa57542/uploads/origins/5bfb85d5-e12b-4868-b5e1-8ebfcf027b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c681969add6e6c0e832c05e93512f1a7", "thumbnail_srcset": "https://si.imgix.net/eaa57542/uploads/origins/5bfb85d5-e12b-4868-b5e1-8ebfcf027b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c681969add6e6c0e832c05e93512f1a7, https://si.imgix.net/eaa57542/uploads/origins/5bfb85d5-e12b-4868-b5e1-8ebfcf027b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=049257014f0060285201fda70ba61bac 2x, https://si.imgix.net/eaa57542/uploads/origins/5bfb85d5-e12b-4868-b5e1-8ebfcf027b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62d5e8a985939b1d8172824d6c85503a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのアートがとても好きです！どれもとても美しいです！\n\nできればFFXIVキャラの絵をお願いしたいです〜。\n\n白い肌の猫娘です\n白い髪と尻尾が特徴です\n右目は薄黄色、左目は薄青色です\n体はスレンダーで、胸のサイズは中くらいです\nかわいくて、生き生きしている\n\n彼女の衣装や姿は写真を参考にしてください。\nかっこいいポーズをとってもらえるとうれしいです！\n細かいところは、あなたのデザイン次第です！\n\nご配慮いただき、誠にありがとうございました！\n\nhttps://imgur.com/a/3FuXxhO", "created_at": "", "completed_at": ""}, {"path": "/@shuttleK02/works/11", "thumbnail_src": "https://si.imgix.net/42fcbd45/uploads/origins/856ce449-d75f-47ea-a616-8f1c20a19575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61b120d0173355af6554743a7da71f38", "thumbnail_srcset": "https://si.imgix.net/42fcbd45/uploads/origins/856ce449-d75f-47ea-a616-8f1c20a19575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61b120d0173355af6554743a7da71f38, https://si.imgix.net/42fcbd45/uploads/origins/856ce449-d75f-47ea-a616-8f1c20a19575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c002b5a62e6df80d139ef57fb041d6a1 2x, https://si.imgix.net/42fcbd45/uploads/origins/856ce449-d75f-47ea-a616-8f1c20a19575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77c808f82d4d813192d4728bd3d3eacf 3x", "genre": "art", "nsfw": false, "body": "はじめましての方は初めましてです。\n先生の絵は本当に素晴らしいです。😇\n私のオリキャラのイラストをお願いしたいです。\n設定、ポーズ、構図は先生にお任せします。\n\n\n▷ オリキャラの詳細\n\n-彼女は16歳です。\n-髪の長さは長く、色は白です。\n-目の色はブルー。\n-身長は154cmで、体型は小柄である。\n-バストサイズはAカップ。\n\n-とても親切で優しい女の子で、明るい一面もあります。\n\n\n▷ 以下、参考資料\nhttps://sta.sh/21p2s91zrrwt\n\n\n追加内容は、自由に補足することができます。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shuttleK02/works/10", "thumbnail_src": "https://si.imgix.net/79cee33e/uploads/origins/e587e200-aeb3-435e-b983-669490f75852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dae27bc50d47ef1ae8504999928fed7", "thumbnail_srcset": "https://si.imgix.net/79cee33e/uploads/origins/e587e200-aeb3-435e-b983-669490f75852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dae27bc50d47ef1ae8504999928fed7, https://si.imgix.net/79cee33e/uploads/origins/e587e200-aeb3-435e-b983-669490f75852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7e9f6832b238bd784283e9ce8c2efcb 2x, https://si.imgix.net/79cee33e/uploads/origins/e587e200-aeb3-435e-b983-669490f75852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07d4c8f755e1b5f5389349cf3bf3e1bc 3x", "genre": "art", "nsfw": false, "body": "Hello!!\n\nI'd like to request my OC, Aira!!\n\nSome background information\n\nAira\n-23 years old\n-166cm\n\n- 嘱目 & 優雅 & 空気が読める\n-とてもクールなビューティーそしてエリートポケモントレーナーで頼れるお姉さん\n-とても強い