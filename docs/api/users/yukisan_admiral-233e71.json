fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48c0cfb5debca910f828d9f6a2b001d8 3x", "genre": "art", "nsfw": true, "body": "忙しい時期にすみません。\nマサチューセッツの依頼者です。\nマサチューセッツが路地裏で犯されている絵をお願いします。\n服装は呉コラボの時の私服でお願いします。\n性癖は大きいのと毛以外ならなんでも行けるので自由にやっちゃってください。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yukisan_admiral/works/34", "thumbnail_src": "https://si.imgix.net/e773d95a/uploads/origins/ee53b5fc-5a6c-4a30-a91d-2b901c5e9b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=180638afe36304852c55bf6742783f90", "thumbnail_srcset": "https://si.imgix.net/e773d95a/uploads/origins/ee53b5fc-5a6c-4a30-a91d-2b901c5e9b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=180638afe36304852c55bf6742783f90, https://si.imgix.net/e773d95a/uploads/origins/ee53b5fc-5a6c-4a30-a91d-2b901c5e9b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8049e1bcc33375a55b7ce805b85a334f 2x, https://si.imgix.net/e773d95a/uploads/origins/ee53b5fc-5a6c-4a30-a91d-2b901c5e9b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56eb2547593082d6b98b283f827873cd 3x", "genre": "art", "nsfw": true, "body": "何度もすみません。\nマサチューセッツの依頼者です。\n本日実装の浴衣マサチューセッツ(中破)としている絵をお願いします。\n背景などはお任せします。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yukisan_admiral/works/33", "thumbnail_src": "https://si.imgix.net/9febaabb/uploads/origins/a13bcadf-b7c8-4815-913a-a477cc411c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2995d711451931a2348c2a42d34b459", "thumbnail_srcset": "https://si.imgix.net/9febaabb/uploads/origins/a13bcadf-b7c8-4815-913a-a477cc411c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2995d711451931a2348c2a42d34b459, https://si.imgix.net/9febaabb/uploads/origins/a13bcadf-b7c8-4815-913a-a477cc411c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0914cd09780854611c84ed