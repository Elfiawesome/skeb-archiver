-8e93-0c0caf1bd946?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f53a7ab7dac215251bbe1cf27bc22756 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/35", "thumbnail_src": "https://si.imgix.net/7364604f/uploads/origins/15fbaeca-33d0-4317-91d0-08eef8e856b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28552a60e6d3f4992488d95dfbcf7b89", "thumbnail_srcset": "https://si.imgix.net/7364604f/uploads/origins/15fbaeca-33d0-4317-91d0-08eef8e856b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28552a60e6d3f4992488d95dfbcf7b89, https://si.imgix.net/7364604f/uploads/origins/15fbaeca-33d0-4317-91d0-08eef8e856b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddb6981ddbe9832814f5b387d78742fb 2x, https://si.imgix.net/7364604f/uploads/origins/15fbaeca-33d0-4317-91d0-08eef8e856b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c16369c1de2de9c80d555b5ef8e67c2 3x", "genre": "comic", "nsfw": true, "body": "オザワヨシ様へ、\nPoles_and_Zerosと申します。\n\n前回は素敵なサドの八雲藍のイラストをありがとうございます。\nまた引き続き、サドっ気のある内容ですが、ご検討いただけますと幸いです。\n\n◆概要\nラミアな八雲藍様のハードな締め付け\n\nお怒りの藍様が、太い蛇尻尾で男に巻き付き、\n息がろくに出来ないモブ男を睨めつけます。\nそして、無力にも藻掻こうとするモブ男を更に締め上げ、\nバキバキと骨を折ったり、「肋と大腿骨どっちがいい?」などと弄びます。\n\n◆こだわり\n赤蛇様みたいに、ほっぺに鱗があると嬉しいです。\nhttps://www.pixiv.net/artworks/125519472\n\n背景は、地下牢みたいなところだと嬉しいです。\n\n以上、何卒よろしくお願いします。\nまた、良いお年を! / あけましておめでとうございます!", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/34", "thumbnail_src": "https://si.imgix.net/d2fdd533/uploads/origins/07336745-3951-4246-9e38-5126778d6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=981bf71aa3780573cb45b7da2a92718e", "thumbnail_srcset": "https://si.imgix.net/d2fdd533/uploads/origins/07336745-3951-4246-9e38-5126778d6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=981bf71aa3780573cb45b7da2a92718e, https://si.imgix.net/d2fdd533/uploads/origins/07336745-3951-4246-9e38-5126778d6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1580627d37fcef0689da11f21e902135 2x, https://si.imgix.net/d2fdd533/uploads/origins/07336745-3951-4246-9e38-5126778d6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a3f3fab86c3b0281b8407b7558e50ca 3x", "genre": "comic", "nsfw": true, "body": "以前のゴルゴーンとバーゲストの作品ではお世話になりました。\n今回もFGOから、ヘミペニスを生やしたでっかい伊吹童子がぐだ子を犯す、というシチュエーションの\nコミック作品をお願いさせていただければと思います。\n\n伊吹童子については第二再臨以降の大人の姿、または敵として登場した「大蛇神の分け御霊」の姿で、\n身長については戦闘時の設定の3mか、もしくはより大きくなった（5～10m程度が目安）形で、\nヘミペニスでぐだ子の前後の穴に挿入描写が可能な範囲で大きく描いていただけると嬉しいです。\nヘミペニスの形状についてはお任せしますが、方向性としてはえげつない形状だと嬉しいです。\n\nまた、伊吹童子はぐだ子に対して愛情的なものを抱いてるものの、神霊なため人間の許容できる範囲を\n考慮していないためにぐだ子にとっては過酷な責めになっている雰囲気で描写していただけると理想です。\n\nご検討いただけると幸いです。よろしくお願いいたします。\n無視した", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/33", "thumbnail_src": "https://si.imgix.net/79186545/uploads/origins/475ded35-1d32-4808-88ee-dcf7b2646eca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bd26d842edb62c7eb947cf773bfd98c", "thumbnail_srcset": "https://si.imgix.net/79186545/uploads/origins/475ded35-1d32-4808-88ee-dcf7b2646eca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bd26d842edb62c7eb947cf773bfd98c, https://si.imgix.net/79186545/uploads/origins/475ded35-1d32-4808-88ee-dcf7b2646eca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5ffd5b4d047482a07df87181db1decb 2x, https://si.imgix.net/79186545/uploads/origins/475ded35-1d32-4808-88ee-dcf7b2646eca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea085a86f908192907c3e25f3e7017af 3x", "genre": "art", "nsfw": true, "body": "こんにちは！今回は \"ロリ百合支配 \"をコンセプトにしたシーンをリクエストします。\n\nキャラクターは、以前リクエストしたFFXIVのキャラクター、メルシンとナエルをロリ以外でお願いします。\n\nフタでもOKですが、