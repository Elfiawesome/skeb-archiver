%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aee5e66cc78357f88a9e5c5cd9c100a", "thumbnail_srcset": "https://si.imgix.net/bd9b385d/uploads/origins/987499b3-32fb-4551-8c0c-ab84b98ee842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aee5e66cc78357f88a9e5c5cd9c100a, https://si.imgix.net/bd9b385d/uploads/origins/987499b3-32fb-4551-8c0c-ab84b98ee842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc859ceda7352f0235504eb6244b876b 2x, https://si.imgix.net/bd9b385d/uploads/origins/987499b3-32fb-4551-8c0c-ab84b98ee842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d50161e378cab92253f98a80ea229c10 3x", "genre": "art", "nsfw": true, "body": "何故か巨大化した赤蛇大神ちゃんが\n白狐明神ちゃんを咥えこんで、舌先で弄ばれてイかせた後\n呑み込んでしまうところをお願いします。\n\n上記の要素が優先度が高いですが、\n可能ならば、蛇の身体で巻き付いて抵抗力を奪うところもあると嬉しいです\nサイズ差的に難しければ手で握るでも構いません。\n\nできればモノクロ漫画形式でお願いします。\nページ数は金額に応じてで構いません（1ページでも漫画的な作画だと嬉しいです）。", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/22", "thumbnail_src": "https://si.imgix.net/9ea80087/uploads/origins/ad05068f-4db3-42cc-bac6-3312d940b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2514a4bed140b6d5aad849282150d602", "thumbnail_srcset": "https://si.imgix.net/9ea80087/uploads/origins/ad05068f-4db3-42cc-bac6-3312d940b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2514a4bed140b6d5aad849282150d602, https://si.imgix.net/9ea80087/uploads/origins/ad05068f-4db3-42cc-bac6-3312d940b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8131038c65b2a8b7e5ce4904d20f1d95 2x, https://si.imgix.net/9ea80087/uploads/origins/ad05068f-4db3-42cc-bac6-3312d940b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecda46ce3843e8197c406a1a6e2962a1 3x", "genre": "art", "nsfw": false, "body": "こんにちは!\nオザワヨシ@八雲幻想祭【祭-１２】さんのSkebの募集通知を見てリクエストさせて頂きました！\nリクエストの内容ですが\n「少尉ちゃんがラミアお姉さんに上半身のみを丸呑みにされた状態で、下のお口を激しく手マンされてイッてる様子」でお願いしたいです。\n背景等はお任せいたします。\nそれともし可能であれば、丸呑みにされた少尉ちゃんの上半身が見える状態だと嬉しいです💦\n問題がなければ、なにとぞよろしくお願いいたします！ｍ(＿ ＿)ｍ💦", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/21", "thumbnail_src": "https://si.imgix.net/b0b5ddb6/uploads/origins/9824464c-9432-4326-b65b-fcfbb301c2c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21f9fce668fdb22a90933d699385d7a3", "thumbnail_srcset": "https://si.imgix.net/b0b5ddb6/uploads/origins/9824464c-9432-4326-b65b-fcfbb301c2c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21f9fce668fdb22a90933d699385d7a3, https://si.imgix.net/b0b5ddb6/uploads/origins/9824464c-9432-4326-b65b-fcfbb301c2c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=309ba4ac425117167d0c4dff152750fc 2x, https://si.imgix.net/b0b5ddb6/uploads/origins/9824464c-9432-4326-b65b-fcfbb301c2c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac1e228510ae2943795e7117df11762d 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n八坂神社奈子を描けますか？\n普段の服装を描いてください。\n\n上半身のイラストをお願いします。\nフェラチオの仕草をしているところ。(フェラ素振り)\n淫らな表情をしている。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/20", "thumbnail_src": "https://si.imgix.net/5ec9b4f8/uploads/origins/81cd327b-3820-4f41-81ec-4104f7b3d240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc555e4dab0ccbc2940af7eafe1a3c0", "thumbnail_srcset": "https://si.imgix.net/5ec9b4f8/uploads/origins/81cd327b-3820-4f41-81ec-4104f7b3d240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc555e4dab0ccbc2940af7eafe1a3c0, https://si.imgix.net/5ec9b4f8/uploads/origins/81cd327b-3820-4f41-81ec-4104f7b3d240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55e4231302ee7b014fb9de3ff454b564 2x, https://si.imgix.net/5ec9b4f8/uploads/origins/81cd327b-3820-4f41-81ec-4104f7b3d240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2261cafb5d89150b6990d0b5c62e861a 3x", "genre": "art", "nsfw": true, "body": "オザワヨシ様へ\nPoles_and_Zerosです。\n\n昨年のSkebは大変ありがとうございました。\n年末の丸呑み合同も、八雲藍の冒頭の怖い感じと、その後丸呑みし始める前の笑顔のコントラストによる「化け狐なんだ……」って雰囲気や、9, 15ページの八重歯のある口内など素敵でした!\n\n早速ですが依頼内容は以下のとおりです。\n\n◆概要\n粗相をした性奴隷を壁尻拘束して、イボ付きゴム手袋で腕を肘近くまで入れるハードなアナルフィストをする八雲藍\n<参考: kuジロウ様>\nhttps://www.pixiv.net/artworks/68147317\n\n◆書いて欲しいキャラクター\n○その1: 八雲藍\n前回 ( https://skeb.jp/@__ZAW__/works/17 ) 同様に、無慈悲な雰囲気の藍様をお願いいたします。\n\n服装は標準衣装でも全裸でもボンデージでもお任せします。\n\n○その2: 性奴隷\n壁尻なので、下半身や臀部しか見えていませんが、青年程度の男性を想定してください．\n\n* もし、可能なら:\n 貞操帯、 鞭の跡、焼印などの鬼畜要素があるとより嬉しいです。\n<例: 宮瀬ぬっこ様>\nhttps://www.pixiv.net/artworks/103458775\n(もちろん、苦手であれば大丈夫です。)\n\n◆その他: \n○ 構図は「壁尻 + アナルフィスト」でさえあれば　構図や細かいポーズ等はおまかせいたします。\n\n○ 背景はグレー等のちょっと暗い単色やグラデで十分ですが，\nでも、もし余裕があれば、地下牢っぽい感じだと嬉しいです。\n\nプレイ内容が結構マニアックですが、何卒ご検討頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@__ZAW__/works/19", "thumbnail_src": "https://si.imgix.net/7636478a/uploads/origins/af2df037-092d-42d6-820a-3b12f7fca388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21423368f856d0d9bf57efba519b5909", "thumbnail_srcset": "https://si.imgix.net/7636478a/uploads/origins/af2df037-092d-42d6-820a-3b12f7fca388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21423368f856d0d9bf57efba519b5909, https://si.imgix.net/7636478a/uploads/origins/af2df037-092d-42d6-820a-3b12f7fca388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d688d287212d3f40448dfe8ae576292c 2x, https://si.imgix.net/7636478a/uploads/origins/af2df037-092d-42d6-820a-3b12f7fca388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FF