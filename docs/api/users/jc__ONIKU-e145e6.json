は希望としてですが同じ構図でも無表情で花束の中に銃口がﾁﾗｯと覗いていて如何にも粛清にきたという差分もお願いしたいです。此方もサムネやSNSに使いたいと思います。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1skh6AGIVv1WupjThdpQ32A4UVCtk5vTy", "created_at": "", "completed_at": ""}, {"path": "/@jc__ONIKU/works/175", "thumbnail_src": "https://si.imgix.net/b2b03663/uploads/origins/d591f54b-62ce-4e1e-9a89-8643a09ad547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb6ed47a63dc5dda7c8505aee48c796c", "thumbnail_srcset": "https://si.imgix.net/b2b03663/uploads/origins/d591f54b-62ce-4e1e-9a89-8643a09ad547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb6ed47a63dc5dda7c8505aee48c796c, https://si.imgix.net/b2b03663/uploads/origins/d591f54b-62ce-4e1e-9a89-8643a09ad547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcffcaceab3c6b69428df393fb7155da 2x, https://si.imgix.net/b2b03663/uploads/origins/d591f54b-62ce-4e1e-9a89-8643a09ad547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7e134fa176021d7e79d226dd0c5cf67 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jc__ONIKU/works/174", "thumbnail_src": "https://si.imgix.net/5f9a8141/uploads/origins/dbda84e5-0de0-426b-bb70-11dd10f34355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ee75b2aed127bcc0f6d3ce7e8714e4", "thumbnail_srcset": "https://si.imgix.net/5f9a8141/uploads/origins/dbda84e5-0de0-426b-bb70-11dd10f34355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ee75b2aed127bcc0f6d3ce7e8714e4, https://si.imgix.net/5f9a81