a86-9dd9-8158bcf54a4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2bd6f80d02da9c618862991b405381e, https://si.imgix.net/cf42a2d3/uploads/origins/8cde3b65-7fd6-4a86-9dd9-8158bcf54a4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7da69dd4d2b904b3e0a38c9ea8e7d7ae 2x, https://si.imgix.net/cf42a2d3/uploads/origins/8cde3b65-7fd6-4a86-9dd9-8158bcf54a4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4539e35ee9eff32772f3e3718f22913 3x", "genre": "art", "nsfw": false, "body": "黎様\n\n初めまして、VTuberとして活動している冥賀小夜日と申します。\n乂×黎様のとても素敵なイラストを拝見して、リクエストをさせていただきます。\n黎様の描かれる作品は、キャラクターの澄んだ色使いや彩色、綺麗な瞳、表情だけでなく髪の毛の動きやポーズなどでキャラクターの個性を感じて、見ていてとても楽しく、描かれたキャラクターの事を知りたくなります！\n\nこの度、VTuberである私、冥賀小夜日の姿も書いていただけないでしょうか。\n\n私は映画や怪談朗読、ホラーゲーム実況などを中心に活動していますが、とても怖がりな性格です。\n映画館で映画を観たりすることが大好きです。\nまた麻雀やポーカーなどのテーブルゲームも大好きで、最近はポーカーの活動もしています。\n\n衣装や三面図については下記URLをご確認いただけますと幸いです。\nアクセサリーや衣服、髪型などは雰囲気に合わせてアレンジしていただいて問題ありません！\n（設定のままの衣装でも大丈夫です）\nhttps://x.com/sayori_meiga/status/1763961932531618246\nPixiv：https://www.pixiv.net/users/68376496/illustrations\n衣装や髪形のアレンジ：https://x.com/sayori_meiga/status/1494304657681780740\n\n黎様のデフォルメイラストも本当に可愛くて大好きなので、頭身とどちらでリクエストするかとても迷いました…！\n今回は頭身でお願いできましたら幸いです。\n黎様がこれまで描かれた作品たちの雰囲気が大好きなので、表情やポーズ、シチュエーションなどはお任せでお願いさせていただけたらと思います。\n\n＜使用用途＞\nいただいたイラストは、Youtubeのサムネイルや動画、XなどのSNSで使用する画像に使わせていただきたいと思っております。\nそのため、キャラクターのみのレイヤーを分けたpsdファイル（もしくはpng）もいただけますと大変助かります。\nまたご無理のない範囲で、髪の毛や頭の先が切れないようにしていただけますと大変ありがたいです。\n※Youtubeのチャンネルは収益化しております。\n\nご検討いただけますと幸いです。\n何卒よろしくお願いいたします！\n\nhttps://x.com/sayori_meiga/status/1763961932531618246", "created_at": "", "completed_at": ""}, {"path": "/@xqb_3/works/1", "thumbnail_src": "https://si.imgix.net/07b2691a/uploads/origins/083959c6-76f1-4e9d-9def-226e1eb70511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d744191174d2c1ca14243752ce69eab0", "thumbnail_srcset": "https://si.imgix.net/07b2691a/uploads/origins/083959c6-76f1-4e9d-9def-226e1eb70511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d744191174d2c1ca14243752ce69eab0, https://si.imgix.net/07b2691a/uploads/origins/083959c6-76f1-4e9d-9def-226e1eb70511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94dfe7c744f2436210f01af7200a166c 2x, https://si.imgix.net/07b2691a/uploads/origins/083959c6-76f1-4e9d-9def-226e1eb70511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe5b4dd1c7121395b7b4e4b685be81d9 3x", "genre": "art", "nsfw": false, "body": "初めまして、個人Vtuberの桃乃華あこたと申します。 この度素敵なイラストを拝見し、ぜひ依頼させて頂きたくご連絡差し上げました。\n\n  ◆使用用途 \n・配信サムネイルでの使用 \n・X（旧Twitter）での使用 \n・FANBOX内での返礼品  \n\n◆イラストの希望\n ・桃乃華あこた を描いていただきたいです。\n ・構図は腰上で、表情は明るく楽しい雰囲気でお願いいたします。ポーズはお任せします。\n ・サムネイル等に使用するので、横は見切れないで描いていただけると助かります。 \n・文字や背景がある場合は、人物と別レイヤーに分けて透過してもらえると有難いです。\n\n  ◆資料 \n下記URLを参照くださいませ。 画像の通り、ポニーテールは途中グラデーションになっております。 https://drive.google.com/drive/folders/12XIGb6O0s7gYLv0VNQ4QnEgP0Pe_H16t?usp=drive_link\n\nお忙しい中恐れ入りますが、ご検討いただけましたら幸いです。 何卒よろしくお願いいたします。\n\n  桃乃華あこた", "created_at": "", "completed_at": ""}]}