TE&s=9ee742388a0bcf91af146003360b8864 2x, https://si.imgix.net/04f6a187/uploads/origins/17482c9d-cabd-4415-93a8-73b0ee2728a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83960f116122e169b4d63b30db403da6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/18", "thumbnail_src": "https://si.imgix.net/844d7a9b/uploads/origins/5d755afc-cba8-4514-b674-07551501a833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7553b440375cdb746a05a3cdbbe58589", "thumbnail_srcset": "https://si.imgix.net/844d7a9b/uploads/origins/5d755afc-cba8-4514-b674-07551501a833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7553b440375cdb746a05a3cdbbe58589, https://si.imgix.net/844d7a9b/uploads/origins/5d755afc-cba8-4514-b674-07551501a833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=599c9434d338e71ec4ae744adc14b76b 2x, https://si.imgix.net/844d7a9b/uploads/origins/5d755afc-cba8-4514-b674-07551501a833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f7f339d4d855c0855f422fe26a7ee54 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/17", "thumbnail_src": "https://si.imgix.net/8082e9cf/uploads/origins/fe4ed41d-a1d9-4259-a0c9-8fad02eb04da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90233ba4e77188e7370224bfd96ba07b", "thumbnail_srcset": "https://si.imgix.net/8082e9cf/uploads/origins/fe4ed41d-a1d9-4259-a0c9-8fad02eb04da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90233ba4e77188e7370224bfd96ba07b, https://si.imgix.net/8082e9cf/uploads/origins/fe4ed41d-a1d9-4259-a0c9-8fad02eb04da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c869e708e8535e37282d0ef9e2c60895 2x, https://si.imgix.net/8082e9cf/uploads/origins/fe4ed41d-a1d9-4259-a0c9-8fad02eb04da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22bf3efa4dfcd904f6a952f3806949be 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nカーフェリーに乗ってる秋雲（艦これ）が何か絵を描いているイラストをお願いします\n\nお絵かき道具\n・スケッチブックでもいいし電子機器でもいいし、○○行きの裏紙でもいいです\n・船内に持ち込める手荷物程度のもの\n\n居る場所\n・何処でもいい\n・乗船中に一般客がお絵かきしていて自然な場所\n\n秋雲の選んだモチーフ\n・指定なし\n・強いて言えば、乗船中にのみ見えるもの\n・風景でも人物でも構造物でもよい\n・秋雲が描いている画面を映す必要は無い\n\n秋雲\n・シンプルでカジュアルな夏服\n・または、改二の服装\n\nご検討願います", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/16", "thumbnail_src": "https://si.imgix.net/38dc47db/uploads/origins/2d6bcfac-cb0c-4033-879d-f47a2def6a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eab5fe86bcafac6d93214154b1c0cc85", "thumbnail_srcset": "https://si.imgix.net/38dc47db/uploads/origins/2d6bcfac-cb0c-4033-879d-f47a2def6a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eab5fe86bcafac6d93214154b1c0cc85, https://si.imgix.net/38dc47db/uploads/origins/2d6bcfac-cb0c-4033-879d-f47a2def6a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d116261f2f36f861b39e579ba9b15a1 2x, https://si.imgix.net/38dc47db/uploads/origins/2d6bcfac-cb0c-4033-879d-f47a2def6a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eb90104a7399088dfed9a69e49ed113 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト楽しみにしています。\n度々リクエスト承認いただいてありがとうございます。\n今回もご検討頂ければ幸いです。\n\nリクエスト：\n艦これ　南極観測船　宗谷\n\nシチュエーションなど：\n南極　人類未踏破地へ観測に赴く宗谷\n\n実際は観測基地補給なんだろうからあり得ないとはおもいますが\n人外雰囲気の宗谷はどういったシチュエーションかなと\n思いついたのが上記フレーズでした。\n\n御山様が描かれていた穏やかな宗谷も好きです。\n\nどうぞご検討に加えていただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/15", "thumbnail_src": "https://si.imgix.net/18e98171/uploads/origins/c4c191b6-bb6a-49ba-bedc-83e91b7ca384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e6c5155b4fc1249e0e53793bd99fee6", "thumbnail_srcset": "https://si.imgix.net/18e98171/uploads/origins/c4c191b6-bb6a-49ba-bedc-83e91b7ca384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e6c5155b4fc1249e0e53793bd99fee6, https://si.imgix.net/18e98171/uploads/origins/c4c191b6-bb6a-49ba-bedc-83e91b7ca384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a29cf3692dbae4c15b0d41bef72dfead 2x, https://si.imgix.net/18e98171/uploads/origins/c4c191b6-bb6a-49ba-bedc-83e91b7ca384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5078ab8b180125df363729b098aaab73 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは、\n\nこの奇妙なリクエストに応えてくれることを期待しています。アメリカにはBuc-ee'sというガソリンスタンド兼ストアがあります。マスコットはかわいいビーバーです。そのマスコットのぬいぐるみを持って、ガソリンスタンドの外に立っている雪風を描いていただけませんか？彼女がビーバーを抱きしめたり、抱き上げたりしていたら、とてもキュートで萌えると思います！\n\nおそらく彼女は、駆逐艦と時雨がガソリンを買いに立ち寄った際に、一緒にドライブ旅行をしているのだろう！\n\nhttps://drive.google.com/drive/folders/1dxD3tDTN181anx8YecsiAOQWnGjRoeT6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/14", "thumbnail_src": "https://si.imgix.net/dbe1ecdf/uploads/origins/ff5aaaa2-eb47-4a9b-ba08-b2189c13b6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c62de411a65a74e3dd14874c66a734", "thumbnail_srcset": "https://si.imgix.net/dbe1ecdf/uploads/origins/ff5aaaa2-eb47-4a9b-ba08-b2189c13b6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c62de411a65a74e3dd14874c66a734, https://si.imgix.net/dbe1ecdf/uploads/origins/ff5aaaa2-eb47-4a9b-ba08-b2189c13b6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdad48de7be3f6d28886f567bc4ebf3c 2x, https://si.imgix.net/dbe1ecdf/uploads/origins/ff5aaaa2-eb47-4a9b-ba08-b2189c13b6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=186b5bd44beb719482c9719296c45610 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n船内の様子も是非お願いしたいです\n\nキャラクター\n・艦これのキャラ複数人\n・そのうち一人は早霜\n・服装はお任せします\n\n例（これらから選んで欲しいわけではない。あくまでも例）\n・座れるところでお菓子屋とかカップ麺を食べてる姿\n・階段のところ。ロビー。\n・窓際の椅子とテーブル。奥行きがあって腰掛けられる窓枠\n・浴室（SFW）\n・薄暗い二等寝台\n・二等雑魚寝（少なくとも一等以下。スイートは知らないので\n・ゲームコーナー。売店\n・軽食カウンター\n・給湯室\n・パンフレットスタンド\n・船内地図のボードがある廊下\n要はほぼすべての空間が好きなので、これというものは有りません。場所もやってることもお任せします\n\n明確な希望は有りません。ただ御山蔵枯さまの絵でフェリーの中、艦娘を眺めたい。ご検討願います。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/13", "thumbnail_src": "https://si.imgix.net/fee551da/uploads/origins/bbd28b0c-c16e-4d58-87e3-1c5e592bac8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d346ee5db090e2ee87fe0fdb67c5c63", "thumbnail_srcset": "https://si.imgix.net/fee551da/uploads/origins/bbd28b0c-c16e-4d58-87e3-1c5e592bac8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d346ee5db090e2ee87fe0fdb67c5c63, https://si.imgix.net/fee551da/uploads/origins/bbd28b0c-c16e-4d58-87e3-1c5e592bac8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73e1d83298f76b4cb0788e0d77423fbc 2x, https://si.imgix.net/fee551da/uploads/origins/bbd28b0c-c16e-4d58-87e3-1c5e592bac8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b4c1a1a9200a5f4e91d36ef3c178cd 3x", "genre": "art", "nsfw": false, "body": "どうかリクエストを送信する事をお許しください。\n　もしよかったら、艦これの艦娘である深雪を描いて頂けませんか。\n　私は絵について初心者なので、作品の詳細は全てmiyama kuragareⅡ様にお任せしたいです。\n　具体的な要望があった方がいいなら、イメージは勇ましい感じかほのぼのした感じのどちらか、場所は海か港のどちらかでお願いします。\n　絵と文章の創作を両方とも立派にこなし、小説やイラストを掲載した同人誌を頒布できるmiyama kuragareⅡ様はすごいと思います。\n　ぜひ引き受けて頂きたいと思っております。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/12", "thumbnail_src": "https://si.imgix.net/89ddfb15/uploads/origins/ce443846-29c2-454b-853d-4f0510c97c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b736034b15fcf34bcf6fe9f5446d3b28", "thumbnail_srcset": "https://si.imgix.net/89ddfb15/uploads/origins/ce443846-29c2-454b-853d-4f0510c97c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b736034b15fcf34bcf6fe9f5446d3b28, https://si.imgix.net/89ddfb15/uploads/origins/ce443846-29c2-454b-853d-4f0510c97c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfb5aaa1dd9da74af57b7c2b93ebbee3 2x, https://si.imgix.net/89ddfb15/uploads/origins/ce443846-29c2-454b-853d-4f0510c97c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f95e44faf01870ff152eddbc5fdb6f16 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nカーフェリー、白雲（艦これ）、この２つのキーワードでイラストをお願いします\n\n・とても好きな物と好きなキャラを挙げたもので、特に背景などはありません\n・艤装を背負ってフェリーを護るように航行しているもの、はたまた私服で単に乗船しているもの、フェリー埠頭の風景、等、キーワードの要素が入っていれば内容は問いません。お任せします。\n・フェリー自体の描き込みは不要です。遠景でも良いですし、有ると判れば十分です。\n・特に思い入れのある、大洗以北で北海道に行くフェリーが大好きです\n\n曖昧な依頼内容で恐縮ですが、ご検討願います", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/11", "thumbnail_src": "https://si.imgix.net/a212fd86/uploads/origins/d50a2cf0-397a-4731-95fb-c482bae07c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e166193a39ef92c849cda348d0b0a6", "thumbnail_srcset": "https://si.imgix.net/a212fd86/uploads/origins/d50a2cf0-397a-4731-95fb-c482bae07c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e166193a39ef92c849cda348d0b0a6, https://si.imgix.net/a212fd86/uploads/origins/d50a2cf0-397a-4731-95fb-c482bae07c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7f4309430a7db5ea66291338b1fd867 2x, https://si.imgix.net/a212fd86/uploads/origins/d50a2cf0-397a-4731-95fb-c482bae07c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1924c4f131c4d7dfdc789b3915f728c9 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト楽しみにしています。\n度々リクエスト受けていただきありがとうございます。\n今回もご検討頂ければ幸いです。\n\n\n依頼キャラクター：\n艦これ　択捉型海防艦　平戸\n\nシチュエーションなど:\n戦闘後、中破して帰投中か帰投後\n\n要望など：\n他の択捉型と違い元から中破姿が勇ましい平戸ですが\nそれ以外本家では割と平和な描きおろしが多いので\n厭世感まではいかなくともちょっと陰のある\n非人間感のある平戸が観たいなと思いリクエストします。\n（悲壮感だけでなく御山様の艦娘たちが取っているような\n　線引きができている？スタンスが好きです。）\n\nお好みでしたらご検討に加えていただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/10", "thumbnail_src": "https://si.imgix.net/d18d0521/uploads/origins/15e3b93f-a0df-4f21-80be-867356ce5787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6b5911689ec3544752e8dbbb116264c", "thumbnail_srcset": "https://si.imgix.net/d18d0521/uploads/origins/15e3b93f-a0df-4f21-80be-867356ce5787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6b5911689ec3544752e8dbbb116264c, https://si.imgix.net/d18d0521/uploads/origins/15e3b93f-a0df-4f21-80be-867356ce5787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a9f36d5335ee079b5337148d245af72 2x, https://si.imgix.net/d18d0521/uploads/origins/15e3b93f-a0df-4f21-80be-867356ce5787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f12758bcf495d79939f90bbf8852dd3 3x", "genre": "art", "nsfw": false, "body": "初めまして、艦これの素敵なイラストを多数描かれてらっしゃるのでリクエストいたします\n\n朝潮（改二丁）のイラストをお願いします\n・手に砲は持っておらず、魚雷を装備している。夜戦を想定した装備。（魚、魚、探照灯、見）\n・長い事大発遠征要員だったので鬱憤が溜まっており、純粋な夜戦要因として抜擢された待望の戦闘に、獰猛で好戦的な感情が抑えられない、という満面の笑み（目は開き口角が上がる感じ）\n\nご検討願います", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/9", "thumbnail_src": "https://si.imgix.net/b70451ff/uploads/origins/cab6b5cf-df77-43ae-85fa-f94b09fadc93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a31a914cb1027dae1ec20147801677fe", "thumbnail_srcset": "https://si.imgix.net/b70451ff/uploads/origins/cab6b5cf-df77-43ae-85fa-f94b09fadc93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a31a914cb1027dae1ec20147801677fe, https://si.imgix.net/b70451ff/uploads/origins/cab6b5cf-df77-43ae-85fa-f94b09fadc93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=470055289e5d702c6e59b4607bab24ed 2x, https://si.imgix.net/b70451ff/uploads/origins/cab6b5cf-df77-43ae-85fa-f94b09fadc93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7caeabd42996e5e1a336da0b58b0c25 3x", "genre": "art", "nsfw": false, "body": "https://yamato-j.hikarischool.jp/?p=7057\n参考写真のように臨海学習のボート体験で櫂立てにて敬礼する中学生たちのボートに、答礼する艦隊これくしょんの野分の様子をお願いします。\nボートに多数の生徒たちが乗り込んで櫂立てしている様子は、大きく描くと相当手間がかかると思います。ある程度省略できるよう、遠くの配置でも差し支えありません、御山さんにお任せ致します。\n野分もまた水上を航行中です。\n艤装は(お手数ですが)艦載砲、魚雷発射管共に装備している様子でお願いします。ただし、接敵の恐れのない場合の近海で、国民に威圧感を与えないよう、砲身、発射管共にグレーのキャンバスで覆われている様子でお願いします。\n砲身の覆いは下記の巡視船の機関砲のように\nhttps://image.space.rakuten.co.jp/d/strg/ctrl/9/239de3813a1c2c421204156ddb3b07d7e4873ea6.65.2.9.2.jpeg\nを参考に願います。よろしくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/8", "thumbnail_src": "https://si.imgix.net/5a8a8cc8/uploads/origins/59957e66-782e-410d-8632-e07c60fae28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22d26231ca7e426badbdd03add96c75e", "thumbnail_srcset": "https://si.imgix.net/5a8a8cc8/uploads/origins/59957e66-782e-410d-8632-e07c60fae28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22d26231ca7e426badbdd03add96c75e, https://si.imgix.net/5a8a8cc8/uploads/origins/59957e66-782e-410d-8632-e07c60fae28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a1db3a6691b1464a5db5d711a2d56d2 2x, https://si.imgix.net/5a8a8cc8/uploads/origins/59957e66-782e-410d-8632-e07c60fae28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19f3f2766480d3ecf08f7dd7205a79dd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/7", "thumbnail_src": "https://si.imgix.net/9d67546d/uploads/origins/01e4c4f3-239c-42a1-81f4-bdaee6b90a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84546db2ca1c83ca6ee7ab000ebae90b", "thumbnail_srcset": "https://si.imgix.net/9d67546d/uploads/origins/01e4c4f3-239c-42a1-81f4-bdaee6b90a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84546db2ca1c83ca6ee7ab000ebae90b, https://si.imgix.net/9d67546d/uploads/origins/01e4c4f3-239c-42a1-81f4-bdaee6b90a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d98539ff6cfb8ed4fd08bd75fe7b87b0 2x, https://si.imgix.net/9d67546d/uploads/origins/01e4c4f3-239c-42a1-81f4-bdaee6b90a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e11612213638cf5271081904e57dfd2 3x", "genre": "art", "nsfw": false, "body": "あなたのイラスト、特に海と空の捉え方が大好きです。\nもうすぐ冬になるので、ぜひご検討ください：\n\n空色の巡洋艦、Ташкентは、夕暮れの最後の光が降り注ぐ中、黒海に出航する。寒さで息が上がっているのが見える。ブイの明かりが夕暮れのかすかな光に浮かび上がる。太陽はすでに落ちているが、空の最後の光は消えていない。北極星が見えるかもしれない。黒海艦隊の出撃が始まる。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/6", "thumbnail_src": "https://si.imgix.net/e0445a28/uploads/origins/67bef1cc-31c2-4057-93eb-22ed937e3ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ea3b62112ae867b6924000fb79f8f64", "thumbnail_srcset": "https://si.imgix.net/e0445a28/uploads/origins/67bef1cc-31c2-4057-93eb-22ed937e3ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ea3b62112ae867b6924000fb79f8f64, https://si.imgix.net/e0445a28/uploads/origins/67bef1cc-31c2-4057-93eb-22ed937e3ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24d8402e545ea7eb7c90b75f4a2ca4e6 2x, https://si.imgix.net/e0445a28/uploads/origins/67bef1cc-31c2-4057-93eb-22ed937e3ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1971a1e406b78a775c4038c114eed83 3x", "genre": "art", "nsfw": false, "body": "はじめまして。依頼の送付、失礼いたします。\n綾波改二の戦闘場面、あるいは洋上で佇んでいる姿を依頼させていただきたく存じます。ご検討いただけましたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/5", "thumbnail_src": "https://si.imgix.net/989412ea/uploads/origins/e06806e3-ea7a-4e5d-8a74-f18df5a717b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9454eb5fce9d51e14166b52f62777dbb", "thumbnail_srcset": "https://si.imgix.net/989412ea/uploads/origins/e06806e3-ea7a-4e5d-8a74-f18df5a717b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9454eb5fce9d51e14166b52f62777dbb, https://si.imgix.net/989412ea/uploads/origins/e06806e3-ea7a-4e5d-8a74-f18df5a717b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0342fbc29f59ec95e67784f99709dba2 2x, https://si.imgix.net/989412ea/uploads/origins/e06806e3-ea7a-4e5d-8a74-f18df5a717b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c23927d6cc282ff7f9509239b53cb832 3x", "genre": "art", "nsfw": false, "body": "艦これ・三隈改二(改二特)のイラストをお願いします\n航海灯をつけて夜の海を行く姿で、平時の交通量の多い沿岸(戦場に向かうわけではないが注意は必要)といった状況を希望します\n艤装の改二・改二特はお任せします", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/4", "thumbnail_src": "https://si.imgix.net/c48ba31f/uploads/origins/57b69ae4-9e5b-4ffa-9d8d-4298f0d99cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e56e307aaa4de520fcd4744cf3da56", "thumbnail_srcset": "https://si.imgix.net/c48ba31f/uploads/origins/57b69ae4-9e5b-4ffa-9d8d-4298f0d99cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e56e307aaa4de520fcd4744cf3da56, https://si.imgix.net/c48ba31f/uploads/origins/57b69ae4-9e5b-4ffa-9d8d-4298f0d99cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd0b4866bfd51251c3a20e29868d7e6f 2x, https://si.imgix.net/c48ba31f/uploads/origins/57b69ae4-9e5b-4ffa-9d8d-4298f0d99cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fe0a621b2f0178009a8bb78bf72549d 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト楽しみにしています。\n以下の依頼についてご検討頂ければ幸いです。\n\n依頼内容：\n艦これ　夕雲型　浜波\n夕雲型だと長波や朝霜の印象的な絵を拝見していますが\n御山様の大人しめの夕雲型が観てみたくリクエスト致します。\n\nシチュエーションなど:\n波止場に佇む浜波、とアバウトですがどうぞご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/3", "thumbnail_src": "https://si.imgix.net/d0a6c6d3/uploads/origins/511f5430-e40d-415e-b455-92582681c2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3ae1cd24854c9fbf1d5f673886e83d", "thumbnail_srcset": "https://si.imgix.net/d0a6c6d3/uploads/origins/511f5430-e40d-415e-b455-92582681c2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3ae1cd24854c9fbf1d5f673886e83d, https://si.imgix.net/d0a6c6d3/uploads/origins/511f5430-e40d-415e-b455-92582681c2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=804dcecb518542eb15d0c7097346eac2 2x, https://si.imgix.net/d0a6c6d3/uploads/origins/511f5430-e40d-415e-b455-92582681c2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=346190d3880e15938855fc9c96e107bb 3x", "genre": "art", "nsfw": false, "body": "外航貨物船の船底部密輸検査を実施した後(通常はメール添付による電子証書で済ませるが、検査証書の原本を求められた為)、海から上がってすぐに本船事務室で検査証書を発行している最中の、艦隊これくしょんの伊401をお願いします。\n濡れた髪で、船員に借りて身を簡単に拭いたバスタオルを肩に、所定の事項を書き終え、最後にハンコを押す前に、上下を確かめている様子です。\n机の上の検査証書はちょっと濡れて、少しよれていると良く、脇に出してもらった飲みかけのミネラルウォーターのペットボトルがあります。\n事務室では401の他は白いツナギにヘルメットを被ったアジア系の航海士が笑顔で応対していると良いです。\nどうぞご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/2", "thumbnail_src": "https://si.imgix.net/bc10eddf/uploads/origins/bc472c6f-9244-4e60-a152-a56dfeb1dd8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3db316e437dac0110ee00fa866144f7", "thumbnail_srcset": "https://si.imgix.net/bc10eddf/uploads/origins/bc472c6f-9244-4e60-a152-a56dfeb1dd8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3db316e437dac0110ee00fa866144f7, https://si.imgix.net/bc10eddf/uploads/origins/bc472c6f-9244-4e60-a152-a56dfeb1dd8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fd9313d4dca1bb4c3e2729909e692e8 2x, https://si.imgix.net/bc10eddf/uploads/origins/bc472c6f-9244-4e60-a152-a56dfeb1dd8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dd5b956954625ff78ce51248b7bf4dd 3x", "genre": "art", "nsfw": false, "body": "初めまして、朝霜改二（艦隊これくしょん）のイラストをお願いできますか。\n\n希望\n靴無しで、ニーソ履いた足裏が見える構図でお願いします。\nつま先を親指とその他4指に分かれた足袋ソックス状にしてください。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wasure_mizu36/works/1", "thumbnail_src": "https://si.imgix.net/25ed8beb/uploads/origins/71673f2c-6124-42d8-86d9-03d7f60251ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1787fbe6ee352f52f7629369d417b19", "thumbnail_srcset": "https://si.imgix.net/25ed8beb/uploads/origins/71673f2c-6124-42d8-86d9-03d7f60251ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1787fbe6ee352f52f7629369d417b19, https://si.imgix.net/25ed8beb/uploads/origins/71673f2c-6124-42d8-86d9-03d7f60251ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3993e043839199696db718d579d6036 2x, https://si.imgix.net/25ed8beb/uploads/origins/71673f2c-6124-42d8-86d9-03d7f60251ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04e10dda2012258f3ef895e77d1a3dcf 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト楽しみにしています。\nskeb依頼受付開始されたとのことで\n以下の依頼についてご検討頂ければ幸いです。\n\n依頼内容：\n艦これ、雲鷹（八幡丸）\n\nしばふ空母艦として御山様の筆が乗れば…と。\nシンプルな立ち絵をお願いできればと思っています。\n\n改造や季節グラなどバリエーション多いですが\n改造段階など御山様の好みでお任せできればと思います。", "created_at": "", "completed_at": ""}]}