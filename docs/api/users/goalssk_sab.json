4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a2f0b528dcd98991efe6e342edd7203 2x, https://si.imgix.net/0c502dc3/uploads/origins/5e051df7-8083-45c2-9f45-b9866409584f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b09fe272e1a11bbea0feaf365f6d570 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのクールなアートスタイルが大好きです！2キャラお願いしてもいいですか？\n\n[1] シルヴィ｜206cm\nトナカイの突然変異体🦌で、陰気で不機嫌な男。暴力的で自分勝手な過去への罪悪感でいっぱいの男。過去には墓守。そばかすと眉毛にご注目。\n\n[2] エビハラ / 150cm\n海老原はエビ変異体🦐で、飄々とした不良のように振る舞う。生きることに無頓着なので、戦闘では無茶をすることが多い。顔の傷、ほくろ、目にご注目。また、アンドロイドのような外見をしています。\n\n2人ともメイドとして働きながら怪獣と戦う囚人。鬱屈した2人は、違いはあっても互いに安らぎ／幸福を見出すことができた。シルヴィは海老原に執着しているが、彼女の無鉄砲さを嫌っている。お互いを守るためなら何でもする。\n\nキーワード森、海、忘れな草、死、スカーフ\n\n自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1_BOOftsWg1XaXxFM48y5tVUYXlclWeSM", "created_at": "", "completed_at": ""}, {"path": "/@goalssk_sab/works/162", "thumbnail_src": "https://si.imgix.net/9b8bd3b3/uploads/origins/4721a09a-f62f-4edb-b3bc-e5eb5b683516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bbef15dab5e7eeb69bf52c288f9efdc", "thumbnail_srcset": "https://si.imgix.net/9b8bd3b3/uploads/origins/4721a09a-f62f-4edb-b3bc-e5eb5b683516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bbef15dab5e7eeb69bf52c288f9efdc, https://si.imgix.net/9b8bd3b3/uploads/origins/4721a09a-f62f-4edb-b3bc-e5eb5b683516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35959abdb21e489039ba64a8e266f6aa 2x, https://si.imgix.net/9b8bd3b3/uploads/origins/4721a09a-f62f-4edb-b3bc-e5eb5b683516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c76a24732715f3eaeec4d03e9a59e64 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートが大好きです！特にこの作品の大ファンです！https://skeb.jp/@goalssk_sab/works/73\n\nジークフリートとオデットは風変わりな夫婦で、疲れた魂が休める美しい島のリゾートに住んでいる。ジークフリートは物静かで控えめだが妻に執着し、オデットは派手でカリスマ性があり、夫に甘えるのが大好きだ。\n\nオデットは白鳥の女の子で、気立てがよく気性が荒いマジシャン。ちょっとビンボーで、絶対的に不器用。参照：https://drive.google.com/drive/folders/1imRJe5bVeGebsybN3iSK_oPoS913gO-O?usp=sharing\n\nジークフリートはクマの男の子のマッドサイエンティストです。いつも眠いのでストイックに見えるが、オタク趣味が大好き。参照：https://drive.google.com/drive/folders/1bACCJeZ65meaZebHp1T4uBi0q2GFrSrN?usp=sharing\n\n参考になれば幸いです！ポージングやその他もろもろ、楽しんでください！\n\nhttps://drive.google.com/drive/folders/1iWTsDnsc9L-UuqC7hd28Ve7HwX_lPyPr?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@goalssk_sab/works/161", "thumbnail_src": "https://si.imgix.net/14245329/uploads/origins/63f82e35-dc11-4ee5-b729-8ec2fca965a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b47b81f7d4fd2745f5d47016661ce6", "thumbnail_srcset": "https://si.imgix.net/14245329/uploads/origins/63f82e35-dc11-4ee5-b729-8ec2fca965a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b47b81f7d4fd2745f5d47016661ce6, https://si.imgix.net/14245329/uploads/origins/63f82e35-dc11-4ee5-b729-8ec2fca965a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=519d12083843e1b75b65387e7fe2498c 2x, https://si.imgix.net/14245329/uploads/origins/63f82e35-dc11-4ee5-b729-8ec2fca965a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94f15100e9335fe1f67bdf1c92bc33b0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@goalssk_sab/works/160", "thumbnail_src": "https://si.imgix.net/50404953/uploads/origins/143836c4-46fe-410f-8a54-891d13d7cf16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c51f7f9adfc9f68bcfa3cd81db804d", "thumbnail_srcset": "https://si.imgix.net/50404953/uploads/origins/143836c4-46fe-410f-8a54-891d13d7cf16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c51f7f9adfc9f68bcfa3cd81db804d, https://si.imgix.net/50404953/uploads/origins/143836c4-46fe-410f-8a54-891d13d7cf16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4495ee35b9f76d0bfd8e2af91de7012c 2x, https://si.imgix.net/50404953/uploads/origins/143836c4-46fe-410f-8a54-891d13d7cf16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da3048c4701bc7881f8d1a033926483a 3x", "genre": "art", "nsfw": false, "body": "ゴールさん、またお会いしましたね！\n\n今度はフレデリックの弟が帰ってきた！気分屋ですぐ怒ります。お好みで、ドヤ顔で自信満々に描いてもOKです！\n\n野球と漫画の大ファン！赤いジャケットを着てください！\n\n今回はどんな作品になるか楽しみです！\n\nhttps://toyhou.se/10581405.jason/gallery", "created_at": "", "completed_at": ""}, {"path": "/@goalssk_sab/works/159", "thumbnail_src": "https://si.imgix.net/1949dc61/uploads/origins/8545f79e-49f1-4b62-8246-752739166dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f177e2163f9f6ca80558bccdd56a5d63", "thumbnail_srcset": "https://si.imgix.net/1949dc61/uploads/origins/8545f79e-49f1-4b62-8246-752739166dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f177e2163f9f6ca80558bccdd56a5d63, https://si.imgix.net/1949dc61/uploads/origins/8545f79e-49f1-4b62-8246-752739166dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b98d7ad16bf85269b8429d75e8455db 2x, https://si.imgix.net/1949dc61/uploads/origins/8545f79e-49f1-4b62-8246-752739166dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d147167f82977447d44d70c3fd47e7e5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きで、私と友人のオークのカップルの絵をお願いしたいのです。あなたが彼らに似合うと思うものを何でも描いてください！  \n\nチェンユー（下）：27歳、男性。184センチ。軍人。筋肉質で堂々としている。シャープな顔立ち。黒髪にグレーの瞳。厳格で規律正しく、控えめ。心優しいが、優しさを表現するのが苦手。ジアン（上）：20歳、男性。168センチ。痩せ型で美人。明るい茶色の髪に水色の瞳。エレガントだが狡猾で手先が器用。花柄のアクセサリーを身につける。  \n\n二人は恋人同士。ジアンはからかうように媚を売り、チェンユーはそんなジアンに好意を抱いている。ジアンはチェンユーに独占欲が強い。\n\n二人の衣装は変えてもいいが、古代中国のテーマは守ってほしい！\n\n更新フォルダ：https://drive.google.com/drive/folders/1TiXZW7rqLnCzQKtrxfkgYOlbaXGQc8L0?usp=sharing\n\nSNSより参照：\nhttps://x.com/jiechii/status/1944067916930105404?s=46&t=hZaW8uR3d4j9K80w7izA8w\nhttps://x.com/tokitokiee/status/1956556824045601018?s=46&t=hZaW8uR3d4j9K80w7izA8w", "created_at": "", "completed_at": ""}, {"path": "/@goalssk_sab/works/158", "thumbnail_src": "https://si.imgix.net/4daa50c6/uploads/origins/d61072e2-652c-4dac-83f6-1d35f1d42174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ded1144d2ffea9430b7582804462215", "thumbnail_srcset": "https://si.imgix.net/4daa50c6/uploads/origins/d61072e2-652c-4dac-83f6-1d35f1d42174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ded1144d2ffea9430b7582804462215, https://si.imgix.net/4daa50c6/uploads/origins/d61072e2-652c-4dac-83f6-1d35f1d42174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15c9d53001e281af72082247c26c2c5d 2x, https://si.imgix.net/4daa50c6/uploads/origins/d61072e2-652c-4dac-83f6-1d35f1d42174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fe175dc343ddfc4715b63d83961d58a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターを描いていただけませんか？みんな刑事か捜査官です。\n\nリノ：男性、身長180.34cm、ダークブラウンの肌、赤い目、顔に傷。とても女性的。\n\nディーゼルオス、身長187.96cm、黒目1つと銀目1つ、耳と尻尾。タバコが好き。真面目。\n\nホーク：オス、身長190cm、茶色の髪、茶色の目、顔の毛。\n\nリノはディーゼルやホークに比べるとスリムな体格・体つきをしている。\n\nリノもホークもディーゼルをからかうのが好き。\n\nディーゼル：https://www.dropbox.com/scl/fo/q1ugav5jsixi1awp9e460/AHttpz3tbYMJ7Fw2fDrZbcQ?rlkey=685uqovrk4j7m731z9exp8lhx&st=ovs4yq4x&dl=0\n\nリノ：https://www.dropbox.com/scl/fo/nse4gzjwaa5i8bfaesbrh/ACsKXi3vBb9iSyy7qZ_ZuFs?rlkey=ucohg1ud11h0t4rnxx9tiqm0n&st=n8i0ddvq&dl=0\n\nホーク：https://www.dropbox.com/scl/fo/sn846kidlh4join97czup/ADoT7BpS0XhMNoNoQpGDcI0?rlkey=gvefgjjmido018j3kgjmsya93&st=n8hwatcd&dl=0\n\nありがとうございました", "created_at": "", "completed_at": ""}, {"path": "/@goalssk_sab/works/157", "thumbnail_src": "https://s