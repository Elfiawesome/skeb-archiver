f2-998269c5b240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f6f193da9cf5dfdb0d024eb5fb7cdc1 2x, https://si.imgix.net/77853dab/uploads/origins/53421b89-810a-47e5-bef2-998269c5b240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=129567954d46d5565ac367754d42dfda 3x", "genre": "art", "nsfw": false, "body": "ユッカ様、こんにちは。\n\n私の友人の一人、本月夢彩の絵をお願いしたいのです!デビューのお祝いに描いてください。もし、お子さんがデビューするときにすでに描いているのであれば、せめてかわいいものを描いてあげてください。アイコンやサムネイルに使えるようなものを。また、キャラクターを別レイヤーにしたものを送っていただければ、彼女のストリームでサムネイルとして使用することもできます。\n\n一応、魔法少女司書で、今は冒険していることになっています。普段は黄色やピンクの魔法の蝶々を描くのが好きです。彼女の好きなことは、以下の通りです。\n読書、本、歌、麻雀、ガチャ（デレステ、プリコネ）、オムライス、タピオカジュース、プリン、おだんご、りんご、紫陽花の花\n\n私のリクエストを受け入れてほしい。二人からのプレゼントにしたいです!\nありがとうございました!\n\nhttps://twitter.com/yuckak3/status/1602870879037566976?s=20&t=tHTgZpTv-ki7UNajVYfIng", "created_at": "", "completed_at": ""}, {"path": "/@yuckak3/works/13", "thumbnail_src": "https://si.imgix.net/231bdfd0/uploads/origins/5e9d5f3b-8960-448f-a418-1bd78cc61345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63be355ef74c83b95c26a72a290e4844", "thumbnail_srcset": "https://si.imgix.net/231bdfd0/uploads/origins/5e9d5f3b-8960-448f-a418-1bd78cc61345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63be355ef74c83b95c26a72a290e4844, https://si.imgix.net/231bdfd0/uploads/origins/5e9d5f3b-8960-448f-a418-1bd78cc61345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=182a5b09aa9f3370c0b794d63a974f5f 2x, https://si.imgix.net/231bdfd0/uploads/origins/5e9d5f3b-8960-448f-a418-1bd78cc61345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34d5b6d07f4a6aed27aa4dea8ca7d2ef 3x", "genre": "art", "nsfw": false, "body": "ユッカ様こんにちは！ななむーと申します。\n前々から素敵なイラストを描く方だと思っていたのですが、画集を拝見させていただいてからその思いがより鮮明になりました。そういった中でSkebの依頼を目にしましたので是非、私のオリジナルキャラクターを描いていただきたいと思い、リクエストをさせていただきました。\n\nデザインについては資料URLにある各種画像をご確認ください。\n彼女のモチーフは鬼で２本の角があり、髪の毛は全体的に薄緑ですが下部は少し青みがかっています。\nまた目の下には逆三角形の模様があり、八重歯があります。\n\nイラストのイメージとしては、元気だけど健康的なセクシーさを感じさせる雰囲気を希望します。\n資料では同じ服を着せていますが、ユッカ様の素敵なセンスで大胆なアレンジをいただければとても嬉しいです。(お腹は出した形だとなお嬉しいです)\n\n使用用途としては各種SNSのアイコンやプロフィール画像などに使用を考えております。\n納期については確認済みでございます。お忙しいとは存じますが何卒お受けいただけますことを願っております。\n\nhttps://drive.google.com/drive/folders/1su4mHciHfSKutZSJRozSDkfUu2aOyPm4?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@yuckak3/works/12", "thumbnail_src": "https://si.imgix.net/1ec18d8e/uploads/origins/2859ac25-b97a-4542-a4ff-cb16ff9cbc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc1352ae0cb68897bb50093acff4c629", "thumbnail_srcset": "https://si.imgix.net/1ec18d8e/uploads/origins/2859ac25-b97a-4542-a4ff-cb16ff9cbc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc1352ae0cb68897bb50093acff4c629, https://si.imgix.net/1ec18d8e/uploads/origins/2859ac25-b97a-4542-a4ff-cb16ff9cbc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6841ca76bb1439eac42e341e7a871cb2 2x, https://si.imgix.net/1ec18d8e/uploads/origins/2859ac25-b97a-4542-a4ff-cb16ff9cbc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=730ff199beb76183521c9a9db0df03d7 3x", "genre": "correction", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}