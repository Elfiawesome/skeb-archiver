13c-97ca8a584fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=755df37a096fb86bbd3de63b62953dc8 2x, https://si.imgix.net/27456e15/uploads/origins/432c0e48-02c4-4d43-b13c-97ca8a584fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=133fb30b37559000910d77c0adc6b4dc 3x", "genre": "art", "nsfw": false, "body": "wss.s様、こんにちは。\nお忙しい中すみません、よろしければリクエストをお願いします。\n\n1.艦これの飛鷹さん\n2.私服で旅行中。歩きながらこちらに振り向くように体を向けている。\n　片手にはトランク鞄、もう片手は帽子を頭に押さえているようなポーズ。\n3.服装は以前リクエストした白のワンピースかそれに近いデザインでお願いします。\n（https://skeb.jp/@wsss_rauha/works/47）\n4.背景はおまかせいたします。後述の用途の為背景とレイヤーを分けられるようお願いします。\n5.使用用途：スマホの壁紙として、また業者を利用した個人の鑑賞目的でのグッズ（アクスタ等）作成を想定しています。\n\nお忙しい中とは思いますが、ご都合が合えば、また使用用途に添えられればよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/281", "thumbnail_src": "https://si.imgix.net/420e7612/uploads/origins/78d23692-868b-4b56-96a5-87cd60e9f058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b825d7c05b54824d9ea0f2511e7728dd", "thumbnail_srcset": "https://si.imgix.net/420e7612/uploads/origins/78d23692-868b-4b56-96a5-87cd60e9f058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b825d7c05b54824d9ea0f2511e7728dd, https://si.imgix.net/420e7612/uploads/origins/78d23692-868b-4b56-96a5-87cd60e9f058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d89fff6f6326062987874f51e000824 2x, https://si.imgix.net/420e7612/uploads/origins/78d23692-868b-4b56-96a5-87cd60e9f058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0bb9aa1f29bc0b728b6b83807ac0412 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております。\nよろしければまた伊艦娘とパグのリクエストをお願いします。\n\n今回はコンテ・ディ・カブールに抱っこされたパグが腕の中でとろけてしまっている絵をお願いできますでしょうか。\n見た目に反して伊艦娘では年長者であるため年の功なのか意外にも（？）上手に抱っこ出来るためリラックスしてしまったパグが脱力した状態で心地よさそうに抱っこされている感じです。\nカブールの服装は改装後のノースリーズのものでお願いします。\nこちらの過去絵の幼児を抱いたフレッチャーのようなイメージです。\n\nhttps://www.pixiv.net/artworks/111665179", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/280", "thumbnail_src": "https://si.imgix.net/81c55fbe/uploads/origins/b5f98bca-f303-4af8-9516-10f61d87bc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592faff9807b67b59a95dd49cdd36d79", "thumbnail_srcset": "https://si.imgix.net/81c55fbe/uploads/origins/b5f98bca-f303-4af8-9516-10f61d87bc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592faff9807b67b59a95dd49cdd36d79, https://si.imgix.net/81c55fbe/uploads/origins/b5f98bca-f303-4af8-9516-10f61d87bc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a50a64370e3089bd66cd32fb917af630 2x, https://si.imgix.net/81c55fbe/uploads/origins/b5f98bca-f303-4af8-9516-10f61d87bc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=284b719913cdbb5bf5f8394470ea8ae6 3x", "genre": "art", "nsfw": true, "body": "初めまして。いつも素敵なイラストの数々を拝見しており、この度ぜひ依頼させていただきたいと思いました。\nご一読いただきご検討いただけますと幸いです。\n\n【内容】\nVSK-94(ドールズフロントライン)およびその10年後の姿であるニキータ(ドールズフロントライン2)で艦ママシリーズのような親子イラストをいただきたいです。\n\n彼女のストーリーを読んでいて戦術人形でありながら孤児院に足繁く通い子供の面倒を見ている彼女ならきっと素敵なママになってくれるだろうなぁ…という妄想をしたので、\n平和な世界で、人形でなく人間になったニキータが指揮官と幸せな家庭を築いている(という妄想をしているニキータ)、といった内容でお願いします。\n服装についてはなかなか露出が激しいので私服に変更していただければと思います。\n完全に余談ですが、彼女はドルフロ中でも最大級に胸が大きい部類のキャラなので胸を盛っていただけると嬉しいです。\n\n【家族構成】\n男指揮官(ドルフロ2)とニキータの夫婦、VSK-94の「朝日のようなステップ」スキンのような子供(兄妹)の4人家族\n\n・指揮官\nhttps://dollsfrontline2.wikiru.jp/?%E6%8C%87%E6%8F%AE%E5%AE%98\n\n・ニキータ\nhttps://dollsfrontline2.wikiru.jp/?%E3%83%8B%E3%82%AD%E3%83%BC%E3%82%BF\n\n・VSK-94\nhttps://wikiwiki.jp/dolls-fl/VSK-94\n\n【シチュ詳細】\nスポーツの大会に出る息子とそれを応援する一家というシチュで、大会中、あるいは大会前夜に家族で準備をしているシーンをお願いします。構図等はお任せします。\nスポーツについては野球でもサッカーでも描きやすいもので構いません。\n可能でしたら娘については先述の「朝日のようなステップ」スキンのチア姿で描いていただけると嬉しいです。\nもちろん露出が多いと判断されましたら布面積を増やすか、変更していただいて構いません。\n\n大好きな家族と一緒で幸せいっぱいなニキータを描いていただければと思います。\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/279", "thumbnail_src": "https://si.imgix.net/447e9701/uploads/origins/acedb999-44e0-46cb-8ffb-4eeea5eaae2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b57ad469552a04bf281fc02ebda2836d", "thumbnail_srcset": "https://si.imgix.net/447e9701/uploads/origins/acedb999-44e0-46cb-8ffb-4eeea5eaae2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b57ad469552a04bf281fc02ebda2836d, https://si.imgix.net/447e9701/uploads/origins/acedb999-44e0-46cb-8ffb-4eeea5eaae2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e2494156dd32e217ec679936a5aafbc 2x, https://si.imgix.net/447e9701/uploads/origins/acedb999-44e0-46cb-8ffb-4eeea5eaae2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79d59e50c7257defd0795a9c8a6e0a2b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/278", "thumbnail_src": "https://si.imgix.net/e0d42dd8/uploads/origins/72d0212f-de83-4b11-976a-0cc0efcd2668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5351672f892c5c0d807439111c92e47f", "thumbnail_srcset": "https://si.imgix.net/e0d42dd8/uploads/origins/72d0212f-de83-4b11-976a-0cc0efcd2668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5351672f892c5c0d807439111c92e47f, https://si.imgix.net/e0d42dd8/uploads/origins/72d0212f-de83-4b11-976a-0cc0efcd2668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0624b79d4803f1a94662fe732baf807 2x, https://si.imgix.net/e0d42dd8/uploads/origins/72d0212f-de83-4b11-976a-0cc0efcd2668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=231834ba3358e3229edc179b83d947e1 3x", "genre": "art", "nsfw": false, "body": "wss-rauha先生、こんにちは！\n\n私は先生の作品、特にカンコレのファンアートの大ファンです。そのため、先生に依頼をお願いしてもよろしいでしょうか？\n\n私の個人的なウサギの女の子のキャラクターを描いていただきたいです。私のキャラクター/OCはカニナというロップイヤーウサギの女の子です。彼女のウサギの耳は、普通の人間の耳があるところにそのままついています。彼女はアイスランド出身で、今は北海道に住んでいます。\n\n彼女は屋外でアルバイトをすることが多いので、キノコ狩りや桜の花びら集め、羊の放牧など、屋外で活動する彼女を描くことが多いです。\n\n今回の依頼では、創作はお任せしようと思います。できれば、今の季節にちなんだ屋外のアルバイトや活動をしている姿を描いていただけるとうれしいです。そうでなければ、かわいいポーズでもかまいません！\n\n以下はキャラクターの参考資料です：\nhttps://www.pixiv.net/artworks/82240171\nhttps://www.pixiv.net/artworks/102687545\nhttps://skeb.jp/@tsukiyopoke/works/19\nhttps://skeb.jp/@sksktk\n\nhttps://www.pixiv.net/artworks/82240171", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/277", "thumbnail_src": "https://si.imgix.net/f0b6fa16/uploads/origins/5851c481-f783-4609-a405-e939f76585de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1787ca89902bdd7d26df81d1bc096dd", "thumbnail_srcset": "https://si.imgix.net/f0b6fa16/uploads/origins/5851c481-f783-4609-a405-e939f76585de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1787ca89902bdd7d26df81d1bc096dd, https://si.imgix.net/f0b6fa16/uploads/origins/5851c481-f783-4609-a405-e939f76585de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40bdd7ef6a113c5eb83aeb1b3b5c599d 2x, https://si.imgix.net/f0b6fa16/uploads/origins/5851c481-f783-4609-a405-e939f76585de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ec3c5490524f0452306c573c12a85ca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/276", "thumbnail_src": "https://si.imgix.net/df36a0a0/uploads/origins/26075e7d-36d4-45ef-8f13-2b01bd09ec0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6440cb5ae55783480c56f8d3f337f5da", "thumbnail_srcset": "https://si.imgix.net/df36a0a0/uploads/origins/26075e7d-36d4-45ef-8f13-2b01bd09ec0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6440cb5ae55783480c56f8d3f337f5da, https://si.imgix.net/df36a0a0/uploads/origins/26075e7d-36d4-45ef-8f13-2b01bd09ec0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c38bbc9d60b3270c58927fbf11dcae6e 2x, https://si.imgix.net/df36a0a0/uploads/origins/26075e7d-36d4-45ef-8f13-2b01bd09ec0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=baf73ac97f3c1fd1c0e3f621d4daf40e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！新しいリクエストを出したいと思います。夜のカシアス、寝間着を着て窓の外を見ている絵が欲しい。日誌を前にして、絵を描いているかもしれないし、メモを読み返しているかもしれない。でも、美しい夜空を見ながら物思いにふけっている。感傷的だが、心地よい。\n\n部屋そのものは絵の中心ではないが、カシウスは自然を愛する温かい少年だ。彼の机の上には、かわいい植物や、親友のクロエから贈られたヘアボウがあるかもしれない。あなたの作品を見るのがいつも楽しみです！\n\nhttps://drive.proton.me/urls/ZTVN0VRHC0#5MNihjRDg1JR", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/275", "thumbnail_src": "https://si.imgix.net/644d0def/uploads/origins/b793ad7d-eded-4557-82a7-0f0a15698ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7319b0a8d35cf63e27a775b2d8ebe12b", "thumbnail_srcset": "https://si.imgix.net/644d0def/uploads/origins/b793ad7d-eded-4557-82a7-0f0a15698ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7319b0a8d35cf63e27a775b2d8ebe12b, https://si.imgix.net/644d0def/uploads/origins/b793ad7d-eded-4557-82a7-0f0a15698ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17fce09a7c3020e33a004f8d2b0b1ab7 2x, https://si.imgix.net/644d0def/uploads/origins/b793ad7d-eded-4557-82a7-0f0a15698ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=335deb294ca0616b58bcd79d239c921d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/274", "thumbnail_src": "https://si.imgix.net/3ce0633b/uploads/origins/7e66fbec-4c3f-433b-b8f1-94daca0b28c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37236a19775690d24783d9815f4863d1", "thumbnail_srcset": "https://si.imgix.net/3ce0633b/uploads/origins/7e66fbec-4c3f-433b-b8f1-94daca0b28c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37236a19775690d24783d9815f4863d1, https://si.imgix.net/3ce0633b/uploads/origins/7e66fbec-4c3f-433b-b8f1-94daca0b28c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f458b5fba09117ded7662c7542c9412 2x, https://si.imgix.net/3ce0633b/uploads/origins/7e66fbec-4c3f-433b-b8f1-94daca0b28c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff41d32c9ea3dc575a21b0beb1164d25 3x", "genre": "art", "nsfw": false, "body": "お忙しいところ申し訳ありません。\n五月作戦で初めて戦果聯合を取りましたのでその記念をお願いしたいと思います。\n\n・今回はほぼどの編成でもいた矢矧（改二乙）でお願いします。\n・報酬が飛龍熟練誘導弾だったので、飛龍熟練誘導弾の妖精さんと矢矧が戯れてるようなシチュエーションをお願いします。\n\n以上になります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/273", "thumbnail_src": "https://si.imgix.net/5091bbc1/uploads/origins/5a5ca67d-8bd3-4bb8-8e45-8ca3ca1c67d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea36ae9f9264164cec01406254ec7a89", "thumbnail_srcset": "https://si.imgix.net/5091bbc1/uploads/origins/5a5ca67d-8bd3-4bb8-8e45-8ca3ca1c67d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea36ae9f9264164cec01406254ec7a89, https://si.imgix.net/5091bbc1/uploads/origins/5a5ca67d-8bd3-4bb8-8e45-8ca3ca1c67d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3807f5faa89b4f8d352867b761ecbf7f 2x, https://si.imgix.net/5091bbc1/uploads/origins/5a5ca67d-8bd3-4bb8-8e45-8ca3ca1c67d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01b37a1f680ccb6e34c6781305d11e64 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nよろしければまた伊艦娘とパグのリクエストをお願いします。\n\n今回はグレカーレとパグが人魚っぽいポーズで座っている絵をお願いできますでしょうか。\n具体的にはビールの販促ポスターやグラビアアイドルが横に脚を伸ばして少し身体を傾けて座っている姿勢と言えばいいのでしょうか。\nパグの場合は資料ＵＲＬの写真のような感じです。\n二人(一人と一匹)並んでかわいらしいセクシーポーズを取っているイメージです。\n\nhttps://x.com/pagupaguaki/status/1939900878980612484", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/272", "thumbnail_src": "https://si.imgix.net/1fd26c8d/uploads/origins/7e12b9e2-2066-4a45-8ef6-3429e9a43493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=391411a6b609f429f3213786efd9651f", "thumbnail_srcset": "https://si.imgix.net/1fd26c8d/uploads/origins/7e12b9e2-2066-4a45-8ef6-3429e9a43493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=391411a6b609f429f3213786efd9651f, https://si.imgix.net/1fd26c8d/uploads/origins/7e12b9e2-2066-4a45-8ef6-3429e9a43493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36de246e4f853f27a0c9617f025aa7c0 2x, https://si.imgix.net/1fd26c8d/uploads/origins/7e12b9e2-2066-4a45-8ef6-3429e9a43493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ccd2e09d7f0ccfea2d798f2c81e7e8f 3x", "genre": "art", "nsfw": false, "body": "前回は素敵な金剛さんの艦ママイラストをありがとうございました！イラストからとっても仲良し家族なんだなと伝わってきました！！子供達のアホ毛、かわいいです！\n金剛さんに限らずですが、wss.s さんの描く艦娘はみんな本当にいいママになって、素敵な家族で…最高です！\n\n一番くじのフィギュアであった『水着mode 鈴谷改二』のイラストをお願いしたいです\nhttps://youtu.be/q_c8QkeBXAQ?si=ReGdieSOZRoTcaH8\nhttps://gonigiri.blog.fc2.com/blog-entry-537.html\n\n鎮守府の広報誌に出てた浜風さんのイラストと同じ感じのシチュで、広報誌orメイキング映像の鈴谷さんを子供達が見てる…みたいな感じでお願いします\n子供達の設定やセリフなどはおまかせします\n(関係ない話なので設定に入れなくて大丈夫ですが、他の方の艦ママイラストのコメントで「鈴谷と提督の子供ってサッカーやってそう」っていうのも見て、「確かに」と思ってしまいました…！)\n\nまた、可能であればですが、三角や眼帯ビキニ鈴谷も見たかったり…\n\n個人的な趣味全開で申し訳ありませんが、ご検討いただけますと幸いです", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/271", "thumbnail_src": "https://si.imgix.net/ce42cec6/uploads/origins/bdea5abd-89cd-4944-9fb9-f29fa78348a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae282c5b8c4045f0cef4ccc8085be91", "thumbnail_srcset": "https://si.imgix.net/ce42cec6/uploads/origins/bdea5abd-89cd-4944-9fb9-f29fa78348a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae282c5b8c4045f0cef4ccc8085be91, https://si.imgix.net/ce42cec6/uploads/origins/bdea5abd-89cd-4944-9fb9-f29fa78348a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=235cdbd5868f5f69ea2bfce9276179f7 2x, https://si.imgix.net/ce42cec6/uploads/origins/bdea5abd-89cd-4944-9fb9-f29fa78348a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ef82f55447de5cbe7b45b16137f1cd2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n今回は複数のキャラクターが登場する作品をお願いします。複雑ですみません。\n\n私のキャラクターであるクロエのリクエストなのですが、彼女の異なる年齢が交流する作品です。この場合、異なるバージョンはすべて一緒に学校に歩いて行きます。それぞれの女の子は年齢に応じた服装と個性を持っています。\n\n参考資料のフォルダに3つのファイルを添付しました：1) 登場人物の相対的な年齢と身長、2) それぞれに着せたい服装、3) 6人が交流している、より個性がわかる写真の例。クロエは全年齢の平均より常に背が低い。\n6人のキャラクターは全員、首のリボンの下に砂時計のネックレスをつけていますが、これは一緒に交流するときに存在する要素です。\nポーズやキャラクターが重なることで、特定のデザイン要素が隠れてしまっても構わない。すべてが一度に見える必要はない。それよりも、そのシーンの温かい感じが大事なんだ！\n\n私の要望を考慮していただき、本当にありがとうございました。\n\nhttps://drive.proton.me/urls/E1SPW54MXW#fBcMcAGTMA78", "created_at": "", "completed_at": ""}, {"path": "/@wsss_rauha/works/270", "thumbnail_src": "https://si.imgix.net/823081ba/uploads/origins/40d73d7b-7939-45b0-a62c-61f594b71718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&tx