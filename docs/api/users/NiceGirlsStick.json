rigins/71547fb5-623a-4aa3-8161-052ab29a6d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=068e9e545cf7e06e324ee868c1ba3b0c, https://si.imgix.net/357b9f17/uploads/origins/71547fb5-623a-4aa3-8161-052ab29a6d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a6a87e93dac27fe98302adc3e06abeb 2x, https://si.imgix.net/357b9f17/uploads/origins/71547fb5-623a-4aa3-8161-052ab29a6d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39c0366e72e7ffc336cd53e0b6d064bd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/36", "thumbnail_src": "https://si.imgix.net/bf677a1f/uploads/origins/fe331e95-fe4e-4b14-a97e-57e6e03a74bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e2e5868048ca85ad695d63cbf17aed1", "thumbnail_srcset": "https://si.imgix.net/bf677a1f/uploads/origins/fe331e95-fe4e-4b14-a97e-57e6e03a74bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e2e5868048ca85ad695d63cbf17aed1, https://si.imgix.net/bf677a1f/uploads/origins/fe331e95-fe4e-4b14-a97e-57e6e03a74bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1993a6531ab77c26174832113122c3d3 2x, https://si.imgix.net/bf677a1f/uploads/origins/fe331e95-fe4e-4b14-a97e-57e6e03a74bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1d842599a6455c09196f3dd3aaba53 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっています。\n今回「琴葉茜さんが全裸でソファに座り、茜さんが自分自身の大きな乳やおま⚪︎こを見せて、誰かの射精を促しているような場面」のイラストをリクエストします。\n\n・茜さんは相手を少し挑発しつつ、それでも射精を期待しているような雰囲気でいてほしいです。\n・相手は大きなおち⚪︎ちんが付いている女性の誰かを想定していますが、イラスト内にいなくても構いません。\n・もしできれば、精液をかけられた茜ちゃんも見たいですが、諸々の理由で無理ならなくても良いです。\n\nお忙しいところ恐れ入りますが、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/35", "thumbnail_src": "https://si.imgix.net/00e84e54/uploads/origins/dc060ef9-18b7-48a1-b3e9-d364dfe8744f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a2d0a1efe40294c1fc58db14d189509", "thumbnail_srcset": "https://si.imgix.net/00e84e54/uploads/origins/dc060ef9-18b7-48a1-b3e9-d364dfe8744f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a2d0a1efe40294c1fc58db14d189509, https://si.imgix.net/00e84e54/uploads/origins/dc060ef9-18b7-48a1-b3e9-d364dfe8744f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eda68f94acb36a0d03d668c8dd1be07a 2x, https://si.imgix.net/00e84e54/uploads/origins/dc060ef9-18b7-48a1-b3e9-d364dfe8744f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37c4089cd5cdf07ca13c0750bb47f7cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/34", "thumbnail_src": "https://si.imgix.net/e192a2c9/uploads/origins/5e266e3d-eb4b-43e9-9d87-06356abfcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb13a2db63d7d347e1a616d66564deaf", "thumbnail_srcset": "https://si.imgix.net/e192a2c9/uploads/origins/5e266e3d-eb4b-43e9-9d87-06356abfcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb13a2db63d7d347e1a616d66564deaf, https://si.imgix.net/e192a2c9/uploads/origins/5e266e3d-eb4b-43e9-9d87-06356abfcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3655fb6bedfbf469163ad4af6a2ac8ef 2x, https://si.imgix.net/e192a2c9/uploads/origins/5e266e3d-eb4b-43e9-9d87-06356abfcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fee324f2e15ebc9729096d118ed54db1 3x", "genre": "art", "nsfw": true, "body": "はじめましていつも絵を見させていただいて癖に刺さったので依頼させていただきました\n\nキャラクター\n紲星あかりちゃんとふたなりの琴葉茜ちゃん\n\n服装\n2人ともボカロ6の衣装であかりちゃんはインナー姿でお願いします\n\nシチュエーション\nあかりちゃんをベッドに押し倒し恋人繋ぎをしながら犯しているシチュをお願いします\n\n表情\n茜ちゃんは恍惚とした表情であかりちゃんは快感に溺れている表情でお願いします\n\n資料\nあかりちゃんに関しては公式にインナー姿の物がありましたのでの添付させていただきます茜ちゃんの資料が無くパッケージの全体図の立絵のイラストのみだったので無理なようでしたら茜ちゃんは裸でかまいません\n\nそれ以外はおまかせします最後に資料を添付し忘れてしまいすみませんでしたあらためてご検討よろしくお願いします\n\nhttps://www.ssw.co.jp/products/vocaloid6/kizunaakari/illust.html", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/33", "thumbnail_src": "https://si.imgix.net/03384e8c/uploads/origins/45dd91d8-0f5e-4ae3-8d05-ed4c78ea91ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d8300fff3ccdceec9abac0948a0737", "thumbnail_srcset": "https://si.imgix.net/03384e8c/uploads/origins/45dd91d8-0f5e-4ae3-8d05-ed4c78ea91ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d8300fff3ccdceec9abac0948a0737, https://si.imgix.net/03384e8c/uploads/origins/45dd91d8-0f5e-4ae3-8d05-ed4c78ea91ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51f4a74ead25e0b4cd746acbb21025ef 2x, https://si.imgix.net/03384e8c/uploads/origins/45dd91d8-0f5e-4ae3-8d05-ed4c78ea91ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd68bd92cda46e1a32b7cdd0fb827f6c 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっています。\n爆乳の琴葉茜さんが授乳手コキして相手を射精させるコッショリなイラストをリクエストいたします。\n相手はふたなり女の子だと嬉しいです。相手役の人選はおまかせします。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/32", "thumbnail_src": "https://si.imgix.net/0a6922bb/uploads/origins/b7873557-3fbb-4c9f-9247-7d1d2d781773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3224ffc39706736e6e71ed1102347e", "thumbnail_srcset": "https://si.imgix.net/0a6922bb/uploads/origins/b7873557-3fbb-4c9f-9247-7d1d2d781773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3224ffc39706736e6e71ed1102347e, https://si.imgix.net/0a6922bb/uploads/origins/b7873557-3fbb-4c9f-9247-7d1d2d781773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=695d378ef04626493a0d63fc8371cb02 2x, https://si.imgix.net/0a6922bb/uploads/origins/b7873557-3fbb-4c9f-9247-7d1d2d781773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddaacd03250fbe3eebe12d33262c11ec 3x", "genre": "art", "nsfw": false, "body": "おもいいも様おつかれさまです、前回はうちの子を描いていただきありがとうございました！\n\n今回はうちの子（蒼月空希）とフレンドさんのVRCキャラの２人\nその2人の衣装チェンジを描いていただきたいです（蒼月空希がフレンドさんのVRCの衣装を、フレンドさんのVRCキャラに蒼月空希通常版衣装を）\n\nうちの子蒼月空希　https://x.com/Air_TypeScarlet/status/1837869210288246881\nフレンドさんのVRCキャラ　https://x.com/VoiceroidMARKER/status/1915856678198906987\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/31", "thumbnail_src": "https://si.imgix.net/cb9e3db2/uploads/origins/4d1e2371-14bb-4258-add1-5b6b6c936c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db50e3a0cf94fbea4a580ab6cf3bf936", "thumbnail_srcset": "https://si.imgix.net/cb9e3db2/uploads/origins/4d1e2371-14bb-4258-add1-5b6b6c936c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db50e3a0cf94fbea4a580ab6cf3bf936, https://si.imgix.net/cb9e3db2/uploads/origins/4d1e2371-14bb-4258-add1-5b6b6c936c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e87cffbc98568b37f7dc4bce034ce6fe 2x, https://si.imgix.net/cb9e3db2/uploads/origins/4d1e2371-14bb-4258-add1-5b6b6c936c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c353d8d43b6eec797cc1d9da3388effb 3x", "genre": "art", "nsfw": true, "body": "はめまして、いつも絵を拝見させて頂いてます。（特に茜ちゃん）\nボイロキャラでなくて申し訳無いですが、うちの子(ルシェル)の絵を描いて頂きたいです。\n内容としてはフリル付きで短い丈の裸エプロンをお願いします。\n設定的には表情筋固めで身長160のBWHが103・61・108なので普段描かれてるみたいに胸もお尻も諸々はみ出そうな感じにムチムチに描いてください。\n詳しい構図などはおまかせしますが、もし竿役の竿を出す場合ふたなり(タマ無し)でお願いします。\n\nhttps://drive.google.com/drive/folders/1Zv43GxCtFUZIouF7xQbxokaq6FRi0ESz?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/30", "thumbnail_src": "https://si.imgix.net/c06ac41a/uploads/origins/ef650b71-587f-4c23-bc2c-3db23358f471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357b4970655e559926a77d7aa5626531", "thumbnail_srcset": "https://si.imgix.net/c06ac41a/uploads/origins/ef650b71-587f-4c23-bc2c-3db23358f471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357b4970655e559926a77d7aa5626531, https://si.imgix.net/c06ac41a/uploads/origins/ef650b71-587f-4c23-bc2c-3db23358f471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e35e231dfefbbf4d1a50ce2b8eaae80 2x, https://si.imgix.net/c06ac41a/uploads/origins/ef650b71-587f-4c23-bc2c-3db23358f471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b9bba02130e1649c37abaaddade0edf 3x", "genre": "art", "nsfw": true, "body": "先生、いつもお世話になっております。\nまた依頼させていただきます。\n\n〇キャラクター\n琴葉茜\n・巨乳、巨尻のむっちり（以前の依頼の体型、もしくはさらに好きに盛ってください）\n\n〇服装\nめちゃくちゃ際どいパーティドレス\n・色は黒又は茜ちゃんの服の色\n・胸元もお腹も見えていて、下も股は隠せるが太ももがほぼ隠せない細長い布面積。もし背中も描く場合は尾骶骨辺りまで見える（例 : https://www.pixiv.net/artworks/127038065, https://www.pixiv.net/artworks/94240282）\n・つけてない、はいてない\n・乳輪が半分くらい見えている\n・勃起乳首が丸わかり\n・アクセサリーはイヤリングとネックレスだけはお願いします。ブレスレット、ボディチェーン等はなくても構いません。\n・詳しいデザインはお任せします。\n\n〇構図\n・背景はパーティ会場。何となくキラキラしていれば大雑把で大丈夫です。\n・周囲の人はいてもいなくても構いません。\n・それ以外の詳細はお任せします。\n\n●以下余裕があれば\n・衣装を脱ぎ、乳首とクリにイヤリングを着けてそれらをボディチェーンで繋いだもの\n\n先生にお任せする部分が多く申し訳ありません。\n何か問題があればお手数ですが再送願います。\nそれではよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/29", "thumbnail_src": "https://si.imgix.net/57b33b16/uploads/origins/33820f12-bd35-4b55-a42f-0561bcb784ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3162b16be1dd1b2aee677c22412b15fd", "thumbnail_srcset": "https://si.imgix.net/57b33b16/uploads/origins/33820f12-bd35-4b55-a42f-0561bcb784ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3162b16be1dd1b2aee677c22412b15fd, https://si.imgix.net/57b33b16/uploads/origins/33820f12-bd35-4b55-a42f-0561bcb784ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=655bb2408614c0df2ccf7bcf379632ee 2x, https://si.imgix.net/57b33b16/uploads/origins/33820f12-bd35-4b55-a42f-0561bcb784ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3570b72fc881b3e8801142dd0312e7e6 3x", "genre": "art", "nsfw": true, "body": "はじめまして！成人向けVtuberをしております白川みゆと申します。\nSkebでイラストを拝見し、とてもとても素敵でしたので是非ともイラストをお願いできないかと思ってリクエストいたしました！\n使用用途はTwitter、配信サムネイル、有料ファンサイトの記事サムネイルなど主に広報活動で使用します。\n\n【リクエスト】\nウェディングランジェリーを着用（はだけてても大丈夫です）しつつオナニーしている姿を書いて頂きたいです！\nウェディングランジェリーはこんなのを希望してますが違うのでも大丈夫です！\nhttps://m.media-amazon.com/images/I/81aogJr3MbL._AC_SX569_.jpg\n\n\n\n【その他】\nサムネにも使用する為頭や左右が途切れないように描いていただきたいです！\n背景やサインがございましたら、キャラクターとのレイヤー分け、あるいは透過データをいただけますと幸いです。\n\n可能であればよろしくお願いいたします！\n\n【白川みゆ人物参考画像】\nhttps://twitter.com/shirakawamiyu/status/1636586936294055937/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/28", "thumbnail_src": "https://si.imgix.net/5a8121c6/uploads/origins/2add0cd0-9a8e-4500-b56e-8ed3441af296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c4f134fc3568b4031cdc536d77aea70", "thumbnail_srcset": "https://si.imgix.net/5a8121c6/uploads/origins/2add0cd0-9a8e-4500-b56e-8ed3441af296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c4f134fc3568b4031cdc536d77aea70, https://si.imgix.net/5a8121c6/uploads/origins/2add0cd0-9a8e-4500-b56e-8ed3441af296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bab93f73ccf0e7b48b4d45b3dfa5fb38 2x, https://si.imgix.net/5a8121c6/uploads/origins/2add0cd0-9a8e-4500-b56e-8ed3441af296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=613f883bf985663f443715cf4a755e50 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n前回も素敵なゆかりさんと葵ちゃんをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\nふたなり結月ゆかりに好き勝手犯され、ベッドの上で力尽きている制服姿の琴葉葵を描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\n前回(https://skeb.jp/@NiceGirlsStick/works/25)の続きで、\n自分の家まで案内させられて、ゆかりさんが満足するまで犯されてしまう葵ちゃん。\n\n■要望\n・葵ちゃんは全身精液塗れ\n・ベッド上に葵ちゃんの学生証があって精液が掛かっている(顔写真は判別できる)\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/27", "thumbnail_src": "https://si.imgix.net/fcf3a8b7/uploads/origins/b9216ed0-4073-416f-91db-e77a7cbc6055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e448b120f522254f7d3ac0e77feaadf4", "thumbnail_srcset": "https://si.imgix.net/fcf3a8b7/uploads/origins/b9216ed0-4073-416f-91db-e77a7cbc6055?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e448b120f522254f7d3ac0e77feaadf4, https://si.imgix.net/fcf3a8b7/uploads/origins/b9216ed0-4073-416f-91db-e77a7cbc6055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91d336407ec16c07361c90ba41bc2a52 2x, https://si.imgix.net/fcf3a8b7/uploads/origins/b9216ed0-4073-416f-91db-e77a7cbc6055?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d50c6396ad3226ce8698d2b8a5f75e6 3x", "genre": "art", "nsfw": true, "body": "先生、前回はありがとうございました。\n早速ですが依頼させていただきます。\n\n○キャラクター\n京町セイカ\n・体形は公式より巨乳、巨尻に（前回、前々回依頼の琴葉姉妹くらい）\n\n○衣装\n全裸または裸コートと公式ヘッドセット\n・ヘッドセット耳あて部分のマークは消してください\n\n○構図\n・汚い公衆トイレ（男用）で露出\n・小便器に座りこんで（もしくは向かい合って）オナニー\n・絶頂後、放尿\n・公式衣装にある「せ」に似たマークは描かないようにしてください。\n・その他構図はお任せします。\n\nもしよろしければお願いいたします。\n\nhttps://skeb.jp/@NiceGirlsStick/works/18", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/26", "thumbnail_src": "https://si.imgix.net/170a6f7d/uploads/origins/cb84eb27-1f29-4436-8b39-02746b221a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b3627ef7e6fc232f8e4cb2092d1402", "thumbnail_srcset": "https://si.imgix.net/170a6f7d/uploads/origins/cb84eb27-1f29-4436-8b39-02746b221a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b3627ef7e6fc232f8e4cb2092d1402, https://si.imgix.net/170a6f7d/uploads/origins/cb84eb27-1f29-4436-8b39-02746b221a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f13a7d7162a009d0bdabae0d80c93f4 2x, https://si.imgix.net/170a6f7d/uploads/origins/cb84eb27-1f29-4436-8b39-02746b221a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405e2b73dc59597b3f27b4b19634203e 3x", "genre": "art", "nsfw": true, "body": "おもいいも様\n\nはじめまして。\nXで見かけた「ｺｯｼｮﾘ露出徘徊中の葵ちゃん」がとても素晴らしかったので、依頼させていただきました。\n\nキャラ：琴葉葵\nシチュエーション：深夜公園の公衆便所(男子トイレ)で下品な格好をしながら野外露出オナニーをしている琴葉葵ちゃん。\n服装：露出プレイ的な感じのもので、詳細などはお任せしたいと思います。\n\n以下の要素を入れてくださると幸いです。\n\n・ハート目\n・野外露出オナニーが大好き。\n・興奮で汗をかいて胸をいじりながら、愛液を散らし恥部を激しくをいじっている。\n・嬉しそうに舌とよだれを垂らし下品な笑顔でオナニーに夢中になっている。\n・体形はXで投稿されていたこちらの感じで→https://x.com/NiceGirlsStick/status/1844759421681090937\n巨乳でムッチリした感じでお願いしたいです。\n\n可能であれば擬音、下品な感じの喘ぎ声や台詞を入れていただけると幸いです。\n（具体的なセリフはお任せします）\n\nまた、予算的に可能であればPSDで下記差分を頂ければと思います。\n(予算の中で可能な範囲でいただければと)\n\n・両手で恥部をいじっている\n・絶頂しそうになっている状態\n・嬉しそうに下品なアヘ顔で、勢いよく大量の潮吹き絶頂\n・だらしない顔で絶頂の余韻に浸っている\n\nお忙しいところ恐縮ですが、検討のほど何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/25", "thumbnail_src": "https://si.imgix.net/aa61c12d/uploads/origins/cbc59f1f-daf5-418d-9cdd-30a7d9ce481c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77fedb80bb6d8ff03a7481fc8dcf2d04", "thumbnail_srcset": "https://si.imgix.net/aa61c12d/uploads/origins/cbc59f1f-daf5-418d-9cdd-30a7d9ce481c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77fedb80bb6d8ff03a7481fc8dcf2d04, https://si.imgix.net/aa61c12d/uploads/origins/cbc59f1f-daf5-418d-9cdd-30a7d9ce481c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab9634d4ff2b079ac23886ef8b8c268e 2x, https://si.imgix.net/aa61c12d/uploads/origins/cbc59f1f-daf5-418d-9cdd-30a7d9ce481c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d78fe7dd4e1bd2fb12006b84694a40b2 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n前回も素敵な葵ちゃんとゆかりさんのイラストをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\n露出狂の琴葉葵を公衆トイレの個室で犯すふたなり結月ゆかりを描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\n全裸コートで出歩いて、コートを開いては興奮する露出狂葵ちゃん。\n通りがかったゆかりさんに見つかって、\n我慢できなくなり近くにあった公衆トイレに連れ込まれてしまう葵ちゃん。\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/24", "thumbnail_src": "https://si.imgix.net/f832d7b2/uploads/origins/43307e6c-a19a-4e41-9081-7e760aad52f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649c5ee91341f5d923eb178551bbb619", "thumbnail_srcset": "https://si.imgix.net/f832d7b2/uploads/origins/43307e6c-a19a-4e41-9081-7e760aad52f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649c5ee91341f5d923eb178551bbb619, https://si.imgix.net/f832d7b2/uploads/origins/43307e6c-a19a-4e41-9081-7e760aad52f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=254f90c76b8055d29a7cee13f049072e 2x, https://si.imgix.net/f832d7b2/uploads/origins/43307e6c-a19a-4e41-9081-7e760aad52f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f97ae7a5d2d45c6a7345e83a25f9e04e 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n巨乳の琴葉茜ちゃんが、その裸体を見せながら相手のちんちんを手でしごいて射精させるイラストをリクエストします。\n\n・茜ちゃんがメインのイラストでお願いします。できれば、茜ちゃんの巨乳をよく見たいです。\n・相手はちんちんが生えていれば男女誰でも構いません。相手の体はあまり画面内に入ってなくても良いです。\n・茜ちゃんは楽しそうにちんちんを触っていてほしいです。\n\nその他の内容はお任せします。\n差し支えなければ、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NiceGirlsStick/works/23", "thumbnail_src": "https://si.imgix.net/368acda3/uploads/origins/dff230a4-70