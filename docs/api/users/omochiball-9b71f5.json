%AD%E3%81%8D%E3%81%AD%E3%82%93%E3%81%B3", "created_at": "", "completed_at": ""}, {"path": "/@omochiball/works/13", "thumbnail_src": "https://si.imgix.net/095d39c3/uploads/origins/7b58bea6-6de0-431f-87d5-f960a6dc4cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59f517935be18995ff896f454a490cf", "thumbnail_srcset": "https://si.imgix.net/095d39c3/uploads/origins/7b58bea6-6de0-431f-87d5-f960a6dc4cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59f517935be18995ff896f454a490cf, https://si.imgix.net/095d39c3/uploads/origins/7b58bea6-6de0-431f-87d5-f960a6dc4cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af3b40f9d7e4ac4f44b95ff841135f26 2x, https://si.imgix.net/095d39c3/uploads/origins/7b58bea6-6de0-431f-87d5-f960a6dc4cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be987ad85e3647b65a16c099b99482f0 3x", "genre": "art", "nsfw": false, "body": "おもちまる様\nはじめまして。不労所得と申します。\n\npixiv様にてにじさんじのイラストを拝見しまして、\n今回ご依頼させていただきたく思いましたので\nご連絡させていただきました。\n\nリクエスト内容\n・にじさんじ所属の郡道美玲先生\n・ショートヘアver.\n・服装はディアンドル衣装\n・ビールを配膳してるシチュエーション\n\n胸が強調される衣装なのでアピールしてる感が出てると嬉しいです。\n宛名は別レイヤーにしてもらえると助かります。\n\n推しのディアンドル衣装姿を見てみたいというだけの好奇心によるリクエストなのですが、\nよろしければご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@omochiball/works/12", "thumbnail_src": "https://si.imgix.net/ac5fe74a/requests/261520_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188693dd56ae075d593a31e57d0e32cd", "thumbnail_srcset": "https://si.imgix.net/ac5fe74a/requests/261520_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188693dd56ae075d593a31e57d0e32cd, https://si.imgix.net/ac5fe74a/requests/261520_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e06b016a9571e3d068d3a39ae5ed633 2x, https://si.imgix.net/ac5fe74a/requests/261520_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=866dbab4aae7fd