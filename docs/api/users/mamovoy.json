-46fd-be21-1559e3a58322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62d683262b7b1f17f895254f047d9c84", "thumbnail_srcset": "https://si.imgix.net/530059f6/uploads/origins/eeed79a0-24d5-46fd-be21-1559e3a58322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62d683262b7b1f17f895254f047d9c84, https://si.imgix.net/530059f6/uploads/origins/eeed79a0-24d5-46fd-be21-1559e3a58322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9999a12572dcddee388d90ebbacea135 2x, https://si.imgix.net/530059f6/uploads/origins/eeed79a0-24d5-46fd-be21-1559e3a58322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee026d2669c18bb81f55e37c804dd115 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/59", "thumbnail_src": "https://si.imgix.net/516783fb/uploads/origins/37ed4b3a-ece0-49f4-ba9b-5cfb0843c43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523cd804bc9c1523656485e8ca35d9d0", "thumbnail_srcset": "https://si.imgix.net/516783fb/uploads/origins/37ed4b3a-ece0-49f4-ba9b-5cfb0843c43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523cd804bc9c1523656485e8ca35d9d0, https://si.imgix.net/516783fb/uploads/origins/37ed4b3a-ece0-49f4-ba9b-5cfb0843c43c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0091b405d5adb3faaa67d26b5780998e 2x, https://si.imgix.net/516783fb/uploads/origins/37ed4b3a-ece0-49f4-ba9b-5cfb0843c43c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39ab826647909b0af0ffeb25202896ae 3x", "genre": "art", "nsfw": true, "body": "マモヴォイ様\n\nお久しぶりです。\nフォロワー企画を拝見し依頼したいキャラがいるので是非。\n\nキャラ：岸田夏海(私立グリモワール学園)\n\nシチュ：まだおむつが取れておらず、特大おまるでトイレトレーニング中です。おまるにまたがりかけましたが、おむつを脱ぐのに間に合わずそのままおむつお漏らししてしまいます。\n\n服：下半身は女の子用おむつのみの格好でお願いします。その他服装は特に指定ございませんがキャラとおむつ画像は参考資料のリンクを添付していますのでご活用ください。\n\n以上になります。ご都合良ければお受けいただけると幸いです。\n\nhttps://drive.google.com/drive/folders/1VyLPPHsRiy9TVoJI1sOqrzm1mb2GQSzS?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/58", "thumbnail_src": "https://si.imgix.net/419901a3/uploads/origins/d77a5bd1-98d2-4f9d-92e2-902c29e2febe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b2d8fa6f7e2120b983860cdac4ea5df", "thumbnail_srcset": "https://si.imgix.net/419901a3/uploads/origins/d77a5bd1-98d2-4f9d-92e2-902c29e2febe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b2d8fa6f7e2120b983860cdac4ea5df, https://si.imgix.net/419901a3/uploads/origins/d77a5bd1-98d2-4f9d-92e2-902c29e2febe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8b3b347344e1433cd1ba659816a58a9 2x, https://si.imgix.net/419901a3/uploads/origins/d77a5bd1-98d2-4f9d-92e2-902c29e2febe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5108220999efacc0d6ae368146d8089 3x", "genre": "art", "nsfw": true, "body": "以前, 作家さんがコープスパーティーの登場人物である持田由香の絵を思い出したのですが,\nその絵のポーズをツクールゲームのIbにそのまま入れていただけますか?\n\n\n座り込んだポーズですが違いは,\n現在, Pixivの削除により資料を見つけることができず, 文で説明すると '座り込んだまま我慢する' だったと記憶しています.\nその絵の資料自体はおそらく2014~2015年頃に見たと記憶しています.\n\nここで多分片手だけで前押さえだと思います.\n\n\n申し込む Ibの場合は, やはり両手で手が見えないほどスカートの股間を前押さえしてください.\nあとはスカートをぎゅっとつかんだせいで, スカートがしわくちゃになるのです.\n\n\n\n\n可能であれば, それではお願いします.", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/57", "thumbnail_src": "https://si.imgix.net/ae2505e9/uploads/origins/2767093a-16db-49b9-a1a4-a692b8e9a00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14fe663111dc87014efc6c0c76fa6150", "thumbnail_srcset": "https://si.imgix.net/ae2505e9/uploads/origins/2767093a-16db-49b9-a1a4-a692b8e9a00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14fe663111dc87014efc6c0c76fa6150, https://si.imgix.net/ae2505e9/uploads/origins/2767093a-16db-49b9-a1a4-a692b8e9a00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c32ad1a7ebf7e5aeffca639fc7fd527 2x, https://si.imgix.net/ae2505e9/uploads/origins/2767093a-16db-49b9-a1a4-a692b8e9a00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1910aaed9b27a6b0032a6164ddcbba56 3x", "genre": "art", "nsfw": true, "body": "こんにちは。いつもお世話になっております。\n\nパズドラ（パズル＆ドラゴンズ）のバステトとソティス（どちらも進化前）のイラストをお願いします。\n\nシチュエーションとしては、\nおしっこを我慢しながらトイレに向かっている最中、\nモブ、もしくは敵に囲まれてしまい、限界が来ておもらししてしまう、といった内容を希望します。\nイラストの構図は以下の作品のように、漏らす瞬間のシーンを中央にお願いします。\nhttps://skeb.jp/@mamovoy/works/19\n\n漏らす瞬間のシーンでは、バステトはスカートをまくり上げて白いパンツを、\nソティスは前垂れをたくし上げて黒いパンツを見せている状態でお願いします。\n\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1KGKNEycE1NXUZs_v2nHaRj764FwQ9d7t", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/56", "thumbnail_src": "https://si.imgix.net/cde20d83/uploads/origins/37b0eaf5-8c5b-40db-878a-584957cd0c76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2cad840072bd705cac5ff9d0d0331af", "thumbnail_srcset": "https://si.imgix.net/cde20d83/uploads/origins/37b0eaf5-8c5b-40db-878a-584957cd0c76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2cad840072bd705cac5ff9d0d0331af, https://si.imgix.net/cde20d83/uploads/origins/37b0eaf5-8c5b-40db-878a-584957cd0c76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85d6dd7e5a81b2447a4020e4dd6379e3 2x, https://si.imgix.net/cde20d83/uploads/origins/37b0eaf5-8c5b-40db-878a-584957cd0c76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b22eb2ef036c7e1bb551a03a0b4fcde 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/55", "thumbnail_src": "https://si.imgix.net/10bdd7f2/uploads/origins/269a9051-73a2-4a47-b29c-53e8cd56ad1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89a5f5b7fe0fb4d05983d9f5421ec0ae", "thumbnail_srcset": "https://si.imgix.net/10bdd7f2/uploads/origins/269a9051-73a2-4a47-b29c-53e8cd56ad1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89a5f5b7fe0fb4d05983d9f5421ec0ae, https://si.imgix.net/10bdd7f2/uploads/origins/269a9051-73a2-4a47-b29c-53e8cd56ad1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aaea2121dc18448555340f4da203c334 2x, https://si.imgix.net/10bdd7f2/uploads/origins/269a9051-73a2-4a47-b29c-53e8cd56ad1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca5585bb65e4fe3321b4854c5492bc34 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/54", "thumbnail_src": "https://si.imgix.net/788dda3b/uploads/origins/a894eb66-e56d-41d3-91d7-3e3c89d6a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe86d9d3b7e7ca5f82891642375a150a", "thumbnail_srcset": "https://si.imgix.net/788dda3b/uploads/origins/a894eb66-e56d-41d3-91d7-3e3c89d6a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe86d9d3b7e7ca5f82891642375a150a, https://si.imgix.net/788dda3b/uploads/origins/a894eb66-e56d-41d3-91d7-3e3c89d6a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3810b63b35ea5367543b068f0504121b 2x, https://si.imgix.net/788dda3b/uploads/origins/a894eb66-e56d-41d3-91d7-3e3c89d6a85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=166a7e40e21e80fbe4aa05f3217ad8eb 3x", "genre": "comic", "nsfw": true, "body": "また久しぶりです.\n\n\n今度はまたこの子です.\nhttps://www.pixiv.net/artworks/39617788\n\n\n今回は授業中ずっとおしっこを我慢していたが, 休み時間になってトイレに駆けつけ, 他人とぶつかって後ろにおもらしする絵をリクエストします.\n\n\nフルカラー漫画です.\n側面の姿で我慢している姿を見せた後, 授業が終わってトイレに走って行き, 他人とぶつかることでお願いします. そしてぶつかりながら後ろに倒れながらおもらしするのです.\n\n\nいつも同じように おしっこ我慢+前押さえです.\n\n\nいつも慣れていると思いますので, 簡単に文章を書いても問題ないはずです.\nそれでは今回もよろしくお願いします.", "created_at": "", "completed_at": ""}, {"path": "/@mamovoy/works/53", "thumbnail_src": "https://si.imgix.net/98135419/uploads/origins/c9476a84-38bf-4c61-ad6f-e32ee873c0e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ef52f9c46e1098772443f2ff922128c", "thumbnail_srcset": "https://si.imgix.net/98135419/uploads/origins/c9476a84-38bf-4c61-ad6f-e32ee873c0e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ef52f9c46e1098772443f2ff922128c, https://si.imgix.net/98135419/uploads/origins/c9476a84-38bf-4c61-ad6f-e32ee873c0e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36a7422094d856d71540cf2a3293acbb 2x, https://si.imgix.net/98135419/uploads/origins/c9476a84-38bf-4c61-ad6f-e32ee873c0e5