s/a84f2241-f5d9-4dbb-8b62-662691e61faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71526447f576e257741f9dc12c97747b", "thumbnail_srcset": "https://si.imgix.net/82f7e000/uploads/origins/a84f2241-f5d9-4dbb-8b62-662691e61faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71526447f576e257741f9dc12c97747b, https://si.imgix.net/82f7e000/uploads/origins/a84f2241-f5d9-4dbb-8b62-662691e61faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d4fe13c308939d5f4923774bcdc1045 2x, https://si.imgix.net/82f7e000/uploads/origins/a84f2241-f5d9-4dbb-8b62-662691e61faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d9d3e9c5596b54900d72408c0a9e3b8 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mi_zu/works/20", "thumbnail_src": "https://si.imgix.net/7675eb70/uploads/origins/3c0b1811-1b8a-4e08-8d15-ad4a263ecf40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87101e81521cebfcde30264f55b3c37", "thumbnail_srcset": "https://si.imgix.net/7675eb70/uploads/origins/3c0b1811-1b8a-4e08-8d15-ad4a263ecf40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87101e81521cebfcde30264f55b3c37, https://si.imgix.net/7675eb70/uploads/origins/3c0b1811-1b8a-4e08-8d15-ad4a263ecf40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fa547b7c185a8e0a47618cddbdd1211 2x, https://si.imgix.net/7675eb70/uploads/origins/3c0b1811-1b8a-4e08-8d15-ad4a263ecf40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3eff4b5391710e82694cc424f4ca0b03 3x", "genre": "art", "nsfw": false, "body": "みず様、初めまして！素敵な絵を楽しく拝見させて頂きました。綺麗な絵柄に惹かれて、可能ならばみず様に私の自キャラのイラストを依頼したいと思っております。\n\n【依頼内容】\nキャラと服装の参照は下記のURLをご覧ください。和風ファンタジーの設定に神社で務めているエルフ族の先輩後輩の二人です。長いお付き合いですから、今はとても親密な関係です。\n\n【１】\n後輩(短髪の子、177cm)。見た目が優しくて落ち着いてる性格ですが、中身はちょっとツンデレで、少し生意気なタイプです。お世話焼き。右目は茶色、左目は青い色。\n\n【２】\n先輩 (ポニーテールの子、180cm)。表はクールと無口、裏は照れ屋さんの性格です。いつも他の人に世話を焼かれるのでなんか面倒くさいな人。耳の飾りは左耳の方だけに付けてお願い致します。\n\n可能ならば、この2人で「花」のモチーフを入れて、一枚のイラストをお願い致します。暖かい雰囲気で描いて頂ければ大変嬉しいです。その他のポーズや構図などはみず様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zme8Lu3By7Ay44m-CSSQKymAQRRT0M-a?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mi_zu/works/19", "thumbnail_src": "https://si.imgix.net/5d6005bf/uploads/origins/376751ec-f56f-4e0d-a1fd-2bc2757e32ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232900986b814063290579ba94f455a5", "thumbnail_srcset": "https://si.imgix.net/5d6005bf/uploads/origins/376751ec-f56f-4e0d-a1fd-2bc2757e32ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232900986b814063290579ba94f455a5, https://si.imgix.net/5d6005bf/uploads/origins/376751ec-f56f-4e0d-a1fd-2bc2757e32ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d5913423f0e2f1fd97c26548767d93c 2x, https://si.imgix.net/5d6005bf/uploads/origins/376751ec-f56f-4e0d-a1fd-2bc2757e32ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=113f720bf6b668b14591e4bdd405cda4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵がとても好きなので、私のオリジナルキャラクターのペアの絵をお願いしたいのです。二人は悪魔のカップルです。彼らのいる宇宙は、天使と悪魔が平和に共存している、現代と同じような世界です。ただし、この世界のキャラクターは全て天使と悪魔のデザインに似ています。\n----\n少年：ヘクター\n年齢：21歳 身長：180cm\n悪魔で、顔と首にタトゥーがある。普段は普通の大学生に見えるが、実は魔界では有名な殺し屋。有力なボスの仕事を手伝っており、今日に至るまで彼の正体を知る者はいない。普段は地味な存在。暗殺者という職業柄、冷徹で冷酷な態度をとり、表情に乏しく、どちらかといえば凶暴に見える。ステイシーの前でのみ、時折シャイで少し情緒的な一面を見せるが、それは隠されている。\n-----\n女の子：ステイシー\n年齢:23 身長:168cm\n羊の角を持つ悪魔で、穏やかで明るい性格が特徴。聞き上手であり、様々な人や事柄と関わることを楽しんでいる。お酒が好きで、人からいろいろな話を聞き、理解と知恵を得る。他人を指導することに喜びを感じ、面倒見のいい姉のような存在になることも多い。\n\nもともと裕福な家庭に生まれたステイシーは、父親の死後、困難な状況に直面した。下心を抱いた父親のビジネスパートナーが、一家の資産と権力を奪おうと画策し始めたのだ。その結果、ステイシーは現在、彼らの魔の手から逃れるために新たな身分を得て身を隠して暮らしている。\n----\n人間関係\n実はステイシーは、ヘクターが次に暗殺することになっているターゲットであり、ヘクターもそれを承知している。そのため、わざとステイシーと距離を置くが、それでも彼女への思いは強い。いつ暗殺を実行するかというジレンマに悩むヘクター。一方、ステイシーはこの状況にまったく気づいていない。彼女はヘクターに強い思いを抱いており、彼の前では自然に振る舞っている。誰かが自分を追っていることだけは知っているが、それが自分を暗殺しようとしているヘクター自身だとは気づいていない。\n\nふたりは普通のカップルのように、カップルがすることをしながら交際を続けているが、それぞれが心の奥底に秘密を隠している。ふたりは互いに愛し合っているが、さまざまな理由から、恋愛関係にあることを公にはできない。\n-----\n服装や装飾、ポーズなどは自由に選んでください。あなたの解釈によるキャラクターを見てみたいです。よろしくお願いします。\n参考文献\nhttps://drive.google.com/drive/folders/1-reEtkZiQwJYEidFEIs40jUAR5MGYqNQ\n\nhttps://drive.google.com/drive/folders/1-reEtkZiQwJYEidFEIs40jUAR5MGYqNQ", "created_at": "", "completed_at": ""}, {"path": "/@mi_zu/works/18", "thumbnail_src": "https://si.imgix.net/c3571d9b/uploads/origins/97b59b2b-694a-4681-a137-280308fcf732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1623e9b3af1ab0959b09cac00cd810e9", "thumbnail_srcset": "https://si.imgix.net/c3571d9b/uploads/origins/97b59b2b-694a-4681-a137-280308fcf732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1623e9b3af1ab0959b09cac00cd810e9, https://si.imgix.net/c3571d9b/uploads/origins/97b59b2b-694a-4681-a137-280308fcf732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9546f5f10cd08bf06b47dae07555fc35 2x, https://si.imgix.net/c3571d9b/uploads/origins/97b59b2b-694a-4681-a137-280308fcf732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&tx