dle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e192fa2a5cf00f6a437586c7bc80eb5 2x, https://si.imgix.net/0a7d8c59/uploads/origins/b853307d-fae9-43c2-9832-50175d11ab0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df87a787ab5e5f1bc6ef9e5df5ec1cfb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mi_zu/works/25", "thumbnail_src": "https://si.imgix.net/e408abb0/uploads/origins/046c72be-5fb1-40b0-a8f7-132a968e245b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce434749665cf5ea552b075b9feac7a9", "thumbnail_srcset": "https://si.imgix.net/e408abb0/uploads/origins/046c72be-5fb1-40b0-a8f7-132a968e245b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce434749665cf5ea552b075b9feac7a9, https://si.imgix.net/e408abb0/uploads/origins/046c72be-5fb1-40b0-a8f7-132a968e245b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7507b8b32043f7af69b4f6659723407a 2x, https://si.imgix.net/e408abb0/uploads/origins/046c72be-5fb1-40b0-a8f7-132a968e245b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=355ff5b5105cb0f7259cd018d1ecad90 3x", "genre": "art", "nsfw": false, "body": "君のアートはゴージャスだね！私のファイナルファンタジーXIVの少年たちを見てみたいです。私は試合後の瞬間を考えていました。2人のキャラクターは、ジャーキン（生意気、派手、エネルギッシュ、表情豊か）とミミック（控えめ、イライラしやすい、無口）です。\n\nJah'kynは傷だらけだがニヤニヤしている。\"ほら、全然大丈夫だよ！\"と言っているように屈伸しているかもしれない。\nミミックは叱られている最中で、彼の体を拭いたり包帯を巻いたりしている。\n\nミミックは叱られている最中で、彼の手当てをしたり、包帯を巻いたりしているが、明らかに苛立っている。2人はこれほど違うにもかかわらず、ロマンチックなパートナーである。お互いの愛情を示す何か。\n必要であれば、Jah'kynは弓を使うアーチャーで、Mimicは学者／ヒーラー。\nあなた次第です。私はあなたの作品が大好きで、もし時間があったり、あなたが望むなら、一緒に仕事をするのを楽しみにしています！\n\n詳細、Jah'kynは前の戦いで切り落とされた尻尾を持っているので、普通の尻尾より短い。詳細は以下のリンクを参照してください！\n\nhttps://jellyfishocs.weebly.com/jahkyn.html\n&\nhttps://jellyfishocs.weebly.com/mimic.html\n\nhttps://jellyfishocs.weebly.com", "created_at": "", "completed_at": ""