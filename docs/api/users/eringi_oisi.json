webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b1682ce62c4e366c26276746089edf2", "thumbnail_srcset": "https://si.imgix.net/50d86395/uploads/origins/4559b85d-c6d9-49dc-a43d-b7f49fc59003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b1682ce62c4e366c26276746089edf2, https://si.imgix.net/50d86395/uploads/origins/4559b85d-c6d9-49dc-a43d-b7f49fc59003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f17061371ca54209386190da91492e7 2x, https://si.imgix.net/50d86395/uploads/origins/4559b85d-c6d9-49dc-a43d-b7f49fc59003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e8cc4280f4a291b4eeffd7d0bf5f7c9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@eringi_oisi/works/23", "thumbnail_src": "https://si.imgix.net/9539a3c6/uploads/origins/4d3c2c5c-5730-4f03-b69f-aef326550e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9aae491b92cae157bbd5ddd5ce806f", "thumbnail_srcset": "https://si.imgix.net/9539a3c6/uploads/origins/4d3c2c5c-5730-4f03-b69f-aef326550e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9aae491b92cae157bbd5ddd5ce806f, https://si.imgix.net/9539a3c6/uploads/origins/4d3c2c5c-5730-4f03-b69f-aef326550e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7093ac421db353df5218af910be483a8 2x, https://si.imgix.net/9539a3c6/uploads/origins/4d3c2c5c-5730-4f03-b69f-aef326550e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cef7f83613262b31d522857d4d8eb36c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。もしよろしければ、私のノンバイナリーケモノマスコットを描いていただけませんか？初音ミクが描かれた特大の破れたTシャツを着て、こんなポーズで。https://i.pinimg.com/564x/ca/f0/5b/caf05b41324da64c083ac09a4539d22e.jpg\n\nこちらは参考資料です：https://toyhou.se/16339834.-fursona-laine\nありがとうございます！私はあなたの絵がとても好きです。", "created_at": "", "completed_at": ""}, {"path": "/@eringi_oisi/works/22", "thumbnail_src": "https://si.imgix.net/2587dbde/uploads/origins/ad1dc911-068c-4e56-a5e4-4c8ec0eb5010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad045c444359e7e26bbb03b047180afc", "thumbnail_srcset": "https://si.imgix.net/2587dbde/uploads/origins/ad1dc911-068c-4e56-a5e4-4c8ec0eb5010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad045c444359e7e26bbb03b047180afc, https://si.imgix.net/2587dbde/uploads/origins/ad1dc911-068c-4e56-a5e4-4c8ec0eb5010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e9922a9cdc43d002abf46ad99b568b6 2x, https://si.imgix.net/2587dbde/uploads/origins/ad1dc911-068c-4e56-a5e4-4c8ec0eb5010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b788f50219047717fe2300ae4296ffb 3x", "genre": "art", "nsfw": false, "body": "初めまして。個人VTuberとして活動しております、羽澄さひろと申します。\n先日、森乃様のイラストを拝見し、豊かで生き生きとした表情のキャラクターたちがとても素敵で、是非とも私のキャラクターイラストを描いていただきたく、依頼いたしました。\n\n●イラストはYouTubeやTwitterなどでの活動に使わせていただきたいので、\n宛名や背景がある場合は、キャラクターのレイヤーと分けて納品していただきたいです。\n・Twitter…アイコン、ヘッダー、自己紹介ツイートなど\n・YouTube…アイコン、ヘッダー、動画や配信のサムネイルなど\n●YouTubeの動画や配信は【1080p：1920×1080】に設定しており、\nイラストの顔周辺のみを切り抜いて使用することもあるので、ご了承いただき、\nまたその点を考慮してイラストのサイズを設定していただきたいです。\n●イラストをご自身でツイートする際は、私からの依頼である旨を書いていただいて構いませんので、\nツイート本文に #はねやすみ を添えていただきたいです。\n●その他は特に希望はございませんので、お任せします。\n●キャラクターデザインにつきましては、お手数ですが下記URLをご参照ください。\nhttps://twitter.com/hasumisahiro/status/1395721906616037385?s=21\nhttps://twitter.com/karohroka/status/1396063651908317191?s=21\n\n何卒よろしくお願いいたします。\n\nhttps://twitter.com/karohroka/status/1426889347937095682?s=21", "created_at": "", "completed_at": ""}, {"path": "/@er