}, {"path": "/@rew112111/works/121", "thumbnail_src": "https://si.imgix.net/ac45f769/uploads/origins/4ea17ed7-47c0-4409-94c2-3393cb375fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a302814b9a678b4442315a212be1202", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rew112111/works/120", "thumbnail_src": "https://si.imgix.net/4c7d99cb/uploads/origins/829e585b-f852-4319-8669-1d388bb97e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc08ab242545d3341d63cee954f377e1", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rew112111/works/119", "thumbnail_src": "https://si.imgix.net/bc7a5c30/uploads/origins/a1a333a1-22c8-4a44-8a1a-668b25c213f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=543b3915d6376e4c447d5ba87c5f3442", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rew112111/works/118", "thumbnail_src": "https://si.imgix.net/a780f35b/uploads/origins/6003cc85-bbb4-4160-8ac1-fda51d7236cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e732902ee7caaedec4f7121daaa2e1", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "あんどん様   \n\n以前あんどん様にskebにて描いて頂いたイラストが  \nとても可愛くて綺麗ですごく気に入ってしまい  \nまたリクエストさせていただきました！   \n\n【ご依頼内容】 \n今回も私が応援している、Vtuber 【ここちろり】さんのファンアート をお願いしたいです。\n\n  【キャラクター要素】\n  活発、やんちゃ、元気などです \n\n  【服装、構図、背景】  \n参考資料リンク先の【構図参考】のイラストのような構図、服装、背景でお願いいたします。 \n服の柄はあんどん様にお任せしたいです！ \n\n  ※可能であれば全身を描いたイラストにしていただきたいです。   \n\n※また、こちらも可能であればなのですが、表情差分と全裸差分も描いていただければ嬉しいです。 　   \n\n【フ