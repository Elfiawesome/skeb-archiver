ress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a70a355123e51e20f34e0eed10f58f40 2x, https://si.imgix.net/72cb7a3d/uploads/origins/7c387de6-5c08-41b8-a2c5-bf1862fd49f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d86f7d31f9ebc71210aa733330ea9c98 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@UC91776165/works/464", "thumbnail_src": "https://si.imgix.net/c2d632c8/uploads/origins/90071aee-aba2-4787-b611-3e43c3695329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=101b0bff58470abec33a5e493121f5e4", "thumbnail_srcset": "https://si.imgix.net/c2d632c8/uploads/origins/90071aee-aba2-4787-b611-3e43c3695329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=101b0bff58470abec33a5e493121f5e4, https://si.imgix.net/c2d632c8/uploads/origins/90071aee-aba2-4787-b611-3e43c3695329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11886a95870b4182ccd01b52ff5f2d75 2x, https://si.imgix.net/c2d632c8/uploads/origins/90071aee-aba2-4787-b611-3e43c3695329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b18e5444da46d9842a763422a727eab1 3x", "genre": "art", "nsfw": true, "body": "やあ、君の作品を見るのが大好きだよ。僕の紫のキツネ、ハネのアートを探していたんだ。ソファに座りながら、よだれを垂らしながら舌を横に出して、幸せそうに酔っぱらっている彼女を描きたかったんだ。片方の乳首が垂れ下がっていて、もう片方は滑っていて、クラーケンのボトルの上を持っています（ボトルの画像を送ります）。\n\nhttps://drive.google.com/drive/folders/1AMWnRkP4T2-PVV6-5y2IqZGpk8ji7VGo?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@UC91776165/works/463", "thumbnail_src": "https://si.imgix.net/318027be/uploads/origins/e7b063ca-01d1-47e2-a3b1-f43ad3c8fef7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1977885ea2102713672dedbf2db031f9", "thumbnail_srcset": "http