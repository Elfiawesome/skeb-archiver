42-94a5-738acb3e08c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b8d2e0644e5017d770ba2a18ebd01f", "thumbnail_srcset": "https://si.imgix.net/340e3ea7/uploads/origins/81bde685-01ab-4642-94a5-738acb3e08c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b8d2e0644e5017d770ba2a18ebd01f, https://si.imgix.net/340e3ea7/uploads/origins/81bde685-01ab-4642-94a5-738acb3e08c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a5cfe94eba027512e9d8eae07e6321f 2x, https://si.imgix.net/340e3ea7/uploads/origins/81bde685-01ab-4642-94a5-738acb3e08c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89f72aa28e539d737334382593bc7cdc 3x", "genre": "art", "nsfw": true, "body": "依頼させてください。\nキャラはプリンセスコネクに出てくる覇瞳皇帝(カイザーインサイト)とユカリ\n\n\n衣装は覇瞳皇帝は黒のハイレグの衣装でスカート部分と外套のようなアクセサリは無しの姿に\n頭部の装飾や眼帯も無しで\nユカリはハイレグの競泳水着を着せてください配色デザインは公式の配色っぽくしていただければ\n\nシチュはシチュはhttps://skeb.jp/@okuyamishimai/works/6の様な感じで\n覇瞳皇帝がユカリにディープキスによるエナジードレインをしているで\n\nメイン絵の下または上にキス中の2人の唇を拡大した絵を入れてください。\n\n以上となりますがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@blackminister/works/26", "thumbnail_src": "https://si.imgix.net/c4da9e2c/uploads/origins/dd0b15c2-c404-480d-bf89-33f7c4079815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca32c13ebaa84986979f233b7c974b54", "thumbnail_srcset": "https://si.imgix.net/c4da9e2c/uploads/origins/dd0b15c2-c404-480d-bf89-33f7c4079815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca32c13ebaa84986979f233b7c974b54, https://si.imgix.net/c4da9e2c/uploads/origins/dd0b15c2-c404-480d-bf89-33f7c4079815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6673f79697ffc4f31931322e45c3896d 2x, https://si.imgix.net/c4da9e2c/uploads/origins/dd0b15c2-c404-480d-bf89-33f7c4079815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b44e3a6b7549d98ae78f592a1898474 3x", "genre": "art", "