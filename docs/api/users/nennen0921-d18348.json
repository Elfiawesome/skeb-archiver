8-46d6-acf2-eaf1afe51dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=171df0893aeab5d444a6e526527c71f4", "thumbnail_srcset": "https://si.imgix.net/f7a115d5/uploads/origins/c0bf3ae7-4e98-46d6-acf2-eaf1afe51dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=171df0893aeab5d444a6e526527c71f4, https://si.imgix.net/f7a115d5/uploads/origins/c0bf3ae7-4e98-46d6-acf2-eaf1afe51dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f41e31474e5fbbcafd8e2d447427f1e7 2x, https://si.imgix.net/f7a115d5/uploads/origins/c0bf3ae7-4e98-46d6-acf2-eaf1afe51dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f4b5cb16d7964f633a4de27488a6c0b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。私、個人Vtuberとして活動をしております「ざっくぅ。」と申します。\nカリ助様の素敵なイラストを拝見しまして、是非お願いしたいと思いリクエストさせていただきました。\n差し支えなければ、私のキャラクターを描いていただけますでしょうか。\n\n【Twitter】\nhttps://twitter.com/zaqrodayo\n\n【資料】\nhttps://drive.google.com/file/d/1beBzZxI0vt7B0trlMVZ0-ZCZVkabB64i/view?usp=sharing\n\n黒のベースで悪魔っぽいような、少しセクシーだけど可愛い下着姿でお願いしたいです！\n表情は可能でしたら差分があると嬉しいです…！\nポーズや背景等はお任せいたします！\n\n使用用途は、SNSのアイコンやサムネイル等に使用したいと思っておりますので、\n可能であれば画面から見切れないように、また透過で使用できるようにPSDなどでいただけますと嬉しいです…！\n何卒、ご検討いただけたら幸いです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nennen0921/works/26", "thumbnail_src": "https://si.imgix.net/e4a72a87/uploads/origins/a209f770-f34f-4719-8ee4-cb59500f5e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073d4464ec76b9d373e7df195ba7ff19", "thumbnail_srcset": "https://si.imgix.net/e4a72a87/uploads/origins/a209f770-f34f-4719-8ee4-cb59500f5e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073d4464ec76b9d373e7df195ba7ff19, https://si.imgix.net/e4a72a87/uploads/origins/a209f770-f34f-4719-8ee4-cb59500f5e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=021fec1a8925b08ca6af6cd8e460b5fb 2x, https://si.imgix.net/e4a72a87/uploads/origins/a209f770-f34f-4719-8ee4-cb59500f5e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=528fb72072ae70112ae83248145c9dad 3x", "genre": "art", "nsfw": false, "body": "初めまして、Vtuberとして活動をしております、犬乃ゆのと申します。\n\nASMRの配信やサムネイルで使用させていただくイラストをお願いしたいです。\n\n○キャラクター詳細\n犬乃ゆの\n捨てポメラニアンだった。拾ってくれたご主人に恩を返すため人間の姿にしてもらった\n\nジト目気味の赤〜ピンクの瞳、向かって左側の前髪は目にかかっている、まろ眉、ふわふわしっぽ\n\n立ち絵▶︎ https://twitter.com/inuno_pomaid/status/1629405950032613377?s=46&t=rQ7P1MwqzmNAi6KjP8iEcA\n\n○シチュエーションはベッドで添い寝している感じでお願いします！\n衣装や髪型は変更ありなしお任せします。\n\n○サムネイルや配信で使いたいため横長だと嬉しいです。できれば背景と人物の透過版もいただけると助かります…！\n\n○使用用途\nTwitter、Youtubeでの配信、サムネイルなど\n\n初めてSkebを利用するためわかりにくいなどありましたら申し訳ございません、ご検討お願いします。\n\nhttps://twitter.com/inuno_pomaid/status/1629405950032613377?s=46&t=rQ7P1MwqzmNAi6KjP8iEcA", "created_at": "", "completed_at": ""}, {"path": "/@nennen0921/works/25", "thumbnail_src": "https://si.imgix.net/d260f8b4/uploads/origins/b01e18b8-408c-4944-beb1-510a6a4c5fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c22f2b66aeb9ff6dcbd09f826021cfd", "thumbnail_srcset": "https://si.imgix.net/d260f8b4/uploads/origins/b01e18b8-408c-4944-beb1-510a6a4c5fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c22f2b66aeb9ff6dcbd09f826021cfd, https://si.imgix.net/d260f8b4/uploads/origins/b01e18b8-408c-4944-beb1-510a6a4c5fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d19fb204aff0c9570783e0c50d1bdde 2x, https://si.imgix.net/d260f8b4/uploads/origins/b01e18b8-408c-4944-beb1-510a6a4c5fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb9735f286e258b3d1af39670e3a3ca2 3x", "genre": "art", "nsfw": false, "body": "初めまして、カリ助先生の素敵なイラストをお見かけして以前からリクエストさせていただきたいと思っていましたのでお願いいたします。\nRe:Act所属のVTuber、猫乃ユキノちゃんを描いていただけないでしょうか？\n\nベッドの上で寝起きの彼シャツ姿で眠そうにしているシチュエーションでお願いします。\n胸元が少しはだけている感じだと嬉しいです。\n可能であれば髪型のボブとロングの差分をいただきたいです(難しい場合は先生のお好きな方で描いていただいて構いません。)\n\nイラストはプレゼントとしてのファンアートになりますので、本人のYouTube等の配信やTwitterなどSNSの使用に許可を頂きたいです。\n可能でしたらpsdファイルでの納品、及びデータ内でキャラと背景のレイヤーを分けていただけると幸いです。\n何卒ご検討よろしくお願いいたします。\n\n猫乃ユキノ\n・YouTube\nhttps://youtube.com/channel/UCoFEbNyIRUS26-hf2AucwFw\n・Twitter\nhttps://twitter.com/nekonoyukin0\n\nhttps://drive.google.com/drive/folders/105DruvH6KavxAms_FU5iqiWBe2f6cZSF", "created_at": "", "completed_at": ""}, {"path": "/@nennen0921/works/24", "thumbnail_src": "https://si.imgix.net/b4693eae/uploads/origins/d9a5d07b-7d07-4fd0-9a30-21fbe69a76a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc607682cca62b712c2c21940eb95305", "thumbnail_srcset": "https://si.imgix.net/b4693eae/uploads/origins/d9a5d07b-7d07-4fd0-9a30-21fbe69a76a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc607682cca62b712c2c21940eb95305, https://si.imgix.net/b4693eae/uploads/origins/d9a5d07b-7d07-4fd0-9a30-21fbe69a76a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a319879280c9d35c0073ddee4eaa4469 2x, https://si.imgix.net/b4693eae/uploads/origins/d9a5d07b-7d07-4fd0-9a30-21fbe69a76a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1057df6b6b900eeb43bdbc0691a27ba6 3x", "genre": "art", "nsfw": false, "body": "カリ助様初めまして。イラストを拝見しとても可愛く好みだったためご依頼をお願いしたいです。\n\nキャラクター：私、澪月しあんのイラストをお願いしたいです。\n\n構図はお任せしたいです。少し照れて可愛い雰囲気にして下さると嬉しいです。\n\nYouTubeチャンネル登録1000人達成した記念用に投稿したいと考えております。\n\nTwitterやYouTubeのサムネなどに使わせていただきたいです。別途で背景透過素材をいただけると嬉しいです。\n\nよろしくお願いします。\n\nhttps://twitter.com/miotsuki_shian/status/1624557876730802181?s=46&t=Cepp8H9WCjuRCBFJD-2K9g", "created_at": "", "completed_at": ""}, {"path": "/@nennen0921/works/23", "thumbnail_src": "https://si.imgix.net/01680145/uploads/origins/ea177ad8-32b3-409a-bd64-033f9508750c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a376296c5e8abac25214c84dddabb15", "thumbnail_srcset": "https://si.imgix.net/01680145/uploads/origins/ea177ad8-32b3-409a-bd64-033f9508750c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&