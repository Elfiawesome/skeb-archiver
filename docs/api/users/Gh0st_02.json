5+00:00"}, {"amount": 16000, "recorded_at": "2026-03-13T13:23:49.525051+00:00"}, {"amount": 11000, "recorded_at": "2026-03-14T05:31:42.237233+00:00"}, {"amount": 16000, "recorded_at": "2026-03-14T14:14:10.508493+00:00"}, {"amount": 9000, "recorded_at": "2026-03-15T05:20:27.704413+00:00"}, {"amount": 15000, "recorded_at": "2026-03-15T12:53:31.080509+00:00"}]}, "current_prices": {"art": 15000}, "price_range": {"art": {"min": 7000, "max": 17000}}, "links": [{"label": "Twitter", "url": "https://x.com/yashiki_52", "name": "yashiki_52"}, {"label": "Website", "url": "https://potofu.me/yashiki2", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/21491136", "name": "21491136"}], "flags": {"from_archive": true}, "works": [{"path": "/@Gh0st_02/works/58", "thumbnail_src": "https://si.imgix.net/2df51097/uploads/origins/33acacab-d69e-445b-939a-083604a8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c92fc4f7393d12162adaac1916631a", "thumbnail_srcset": "https://si.imgix.net/2df51097/uploads/origins/33acacab-d69e-445b-939a-083604a8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c92fc4f7393d12162adaac1916631a, https://si.imgix.net/2df51097/uploads/origins/33acacab-d69e-445b-939a-083604a8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4fdc6a301e36ad3843dbc8e41d25125 2x, https://si.imgix.net/2df51097/uploads/origins/33acacab-d69e-445b-939a-083604a8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d851fe94811ddb67dd95883f7a95db6 3x", "genre": "art", "nsfw": false, "body": "先生！こんにちは！ あなたの作品がとても好きです！ ぜひ私の作品を描いてください。\n1996年の香港が舞台。香港映画からインスピレーションを受けています。\n\n【キャラクター設定】\n■林嘉謙（180cm）32岁\n最下層の警察官だが、実はマフィアボスの隠し子。懸命に昇進を目指すが報われず、8歳の時に異母兄の解承前と出会う。気にかけているが、身分の違いから兄だと完全に認めることができず、物語終盤で信念が崩壊しマフィアへ転落する。\n温厚な性格だが時折自暴自棄にタバコを吸ったり酒を飲んだり。兄への態度は「あいつはどうしてああなんだ」という曖昧な感情。\n\n■解承前（185cm）40岁\nマフィア組織の若頭。普段は冷酷非道だが、若頭になる前は医者になりたい夢を持っていた（父親に阻止された）。幼少期から周囲の反対を押し切り弟と交流を続け、心底弟を溺愛している。弟が正道に進むことを願う一方、矛盾して自分の元に戻ってくることも望んでいる。プライベートではだらしない一面も。\n\n非商業的な印刷に使用します\n\nhttps://drive.google.com/drive/folders/1kZNKmFAmDz7YTQL_ldlsymYFRkFJoAkU", "created_at": "", "completed_at": ""}, {"path": "/@Gh0st_02/works/57", "thumbnail_src": "https://si.imgix.net/0c287ec1/uploads/origins/15314099-1f5e-45e8-8106-88fdb04b9b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc4e854b7e7ebaeb5a2e5ad96572c423", "thumbnail_srcset": "https://si.imgix.net/0c287ec1/uploads/origins/15314099-1f5e-45e8-8106-88fdb04b9b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc4e854b7e7ebaeb5a2e5ad96572c423, https://si.imgix.net/0c287ec1/uploads/origins/15314099-1f5e-45e8-8106-88fdb04b9b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a546c25d06b1947a944ff6fe83200e1 2x, https://si.imgix.net/0c287ec1/uploads/origins/15314099-1f5e-45e8-8106-88fdb04b9b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e7a546f74d966ee94d6f2ebc42683fb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、やなぎ様！\nあなたの作品がとても好きです。もしよろしければ、ぜひ私のOCを描いていただけると嬉しいです。\n\n特別な条件はありません。二人の性格の範囲内であれば、どんなやり取りを描いても自由です！\nリンク先に設定の詳細と情報を記載しました。描きたいコスチュームも自由です！\n\n金額が足りない場合、再送いただければと思います。良ければご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ZPG8co0rVU-VH4RkqoZbidYWnJkY5b4C?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Gh0st_02/works/56", "thumbnail_src": "https://si.imgix.net/598df24f/uploads/origins/6783880e-fbf4-4e48-a1e0-60c1e1834f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f34678999edefa5238c3638895bed5", "thumbnail_srcset": "https://si.imgix.net/598df24f/uploads/origins/6783880e-fbf4-4e48-a1e0-60c1e1834f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f34678999edefa5238c3638895bed5, https://si.imgix.net/598df24f/uploads/origins/6783880e-fbf4-4e48-a1e0-60c1e1834f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2da43988473d599cd5a2228b18c9100 2x, https://si.imgix.net/598df24f/uploads/origins/6783880e-fbf4-4e48-a1e0-60c1e1834f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02657b0ae7aea69aadea008e5e27f56e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！先生の作品が大好きで、私のOC二人のイラストをご依頼いたしたく存じます。\n詳細な設定は下記のURLに記載しております。先生のご様式で自由にアレンジしていただき、衣装や設定の追加・変更も全てお任せします。\n金額に満たない場合は、再度リクエストを送っていただけると助かります～\n\nhttps://drive.google.com/drive/folders/1VnX_DyG7-Z7LoBn2kuz6EUy7e-T39VgB", "created_at": "", "completed_at": ""}, {"path": "/@Gh0st_02/works/55", "thumbnail_src": "https://si.imgix.net/f4459111/uploads/origins/dc45d8b2-fd49-4178-aae5-363afe3287eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6724ebc4d7f837f77016e3ef696b8db", "thumbnail_srcset": "https://si.imgix.net/f4459111/uploads/origins/dc45d8b2-fd49-4178-aae5-363afe3287eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6724ebc4d7f837f77016e3ef696b8db, https://si.imgix.net/f4459111/uploads/origins/dc45d8b2-fd49-4178-aae5-363afe3287eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da60c56a2ef68fb36a4528c36fabbe7b 2x, https://si.imgix.net/f4459111/uploads/origins/dc45d8b2-fd49-4178-aae5-363afe3287eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=316f71ce055507fead5b02e954f7344d 3x", "genre": "art", "nsfw": false, "body": "はじめまして！前回の作品がとても気に入ったので、また私のocの絵を描いていただきたいと思います。日本語を使うのが苦手なので、機械翻訳を使っていますが、理解してもらえると嬉しいです。\n\n依頼したいキャラクターは、この紫の髪の男性と白い髪の男性です。\n紫の髪の方はドゥームズデイに登場する自動人形で、禁断の魔法を持ち、冷たい表情や楽しい表情をすることが多い。詳細はURLにある。\n白髪の方は紫髪の者を狩る王家の魔法使いで、手から炎を放つことができ、目の瞳孔の色は紫である。\n\n二人の関係は、白髪が紫髪を追い詰め、紫髪が互いを翻弄し、悪の道へと導くことに喜びを感じている。\n\n二人の描写はご自由に、ご覧いただきありがとうございました。\n\n紫髪：https://drive.google.com/drive/folders/1296tYGDOfnhgLnH3db7NAPR0Dt4q--0x\n\n白髪：https://drive.google.com/drive/folders/14YCARyv6a1xMbvqDcyL9z6Y6SrXEgzFV", "created_at": "", "completed_at": ""}, 