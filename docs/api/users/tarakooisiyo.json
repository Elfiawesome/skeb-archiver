にお願いしたいです。\n髪の毛を少しふわふわにしてほしいです。\n\n【使用用途】\n・SNSでの投稿、youtubeやTwitch、サムネイル、アイコン、FANBOXへの投稿、など配信活動全般\n\n頂いたイラストをXへ投稿する際、ウォーターマークを付けての投稿予定なのですが、FANBOXへの投稿にはウォーターマークなしでの投稿を予定しております。\n\n【お願い】\n・頭が見切れないように描いて頂けますと大変助かります。\n・背景と人物を分けて頂きたいです。\n\n金額等の不都合がありましたら再送いただけますとありがたいです。\nご検討して頂けますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1qTDjcD0S-F-rs7fK0qFu3hGYmMYV4rSF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tarakooisiyo/works/35", "thumbnail_src": "https://si.imgix.net/9e208524/uploads/origins/b28c7731-05a8-4442-85f0-2ffa8fa23a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2718b76bbd12374deeb761b14ffc42c", "thumbnail_srcset": "https://si.imgix.net/9e208524/uploads/origins/b28c7731-05a8-4442-85f0-2ffa8fa23a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2718b76bbd12374deeb761b14ffc42c, https://si.imgix.net/9e208524/uploads/origins/b28c7731-05a8-4442-85f0-2ffa8fa23a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5a264c177fe156c925c0380e652991f 2x, https://si.imgix.net/9e208524/uploads/origins/b28c7731-05a8-4442-85f0-2ffa8fa23a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ddd58a851c6e8fa02a2ed4995f0c5a5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tarakooisiyo/works/34", "thumbnail_src": "https://si.imgix.net/11621446/uploads/origins/e8e4fbe5-48a4-4baa-a7fc-d6ab2b166dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeea2630088c55b00b349cc83de4e7cc", "thumbnail_srcse