23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b6e42175cce8d72c0a10d90a491e583 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n先生のイラストがとても性癖に刺さったので依頼をさせて頂きます。\nシャニマスの樋口円香が自宅で犬と交尾、妊娠出産するイラストをお願いします。\nシチュエーションとしましては\n快楽に任せ犬と交尾、中出しされ枕に顔をうずめながら絶頂\n後日大きくなったお腹を抱えながらシーツの上に仔犬を産み落とす\nといった感じでお願いします。\n可能であればボテ腹状態での交尾の差分を頂けるとありがたいです。\n初依頼ながら要望が多く申し訳ありません\nどうかご検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@gisyuled/works/40", "thumbnail_src": "https://si.imgix.net/e33c9b56/uploads/origins/c787633e-046d-4a5c-babe-fbbdd97e06fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09f129d42d195ba8843ba3e1739915b4", "thumbnail_srcset": "https://si.imgix.net/e33c9b56/uploads/origins/c787633e-046d-4a5c-babe-fbbdd97e06fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09f129d42d195ba8843ba3e1739915b4, https://si.imgix.net/e33c9b56/uploads/origins/c787633e-046d-4a5c-babe-fbbdd97e06fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1de79de40b4d5f44a79d946b1e863f6 2x, https://si.imgix.net/e33c9b56/uploads/origins/c787633e-046d-4a5c-babe-fbbdd97e06fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa5758064cca9751652710669a8c325f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gisyuled/works/39", "thumbnail_src": "https://si.imgix.net/d2f6318d/uploads/origins/a4c9d412-0b76-4f86-8d0a-0d9a17dd28aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab2add6ce7b302386aa74fab1f73a8b", "thumbnail_s