ess&fm=webp&fit=crop&crop=top&w=200&h=200&s=702d96339b04955ec3f76131fd1bea64, https://si.imgix.net/1ee1f5b2/uploads/origins/51f03090-eaae-446e-8804-3e27bc0add63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8aba0bf98b128fdb1591228a1411d5c 2x, https://si.imgix.net/1ee1f5b2/uploads/origins/51f03090-eaae-446e-8804-3e27bc0add63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=500252a22e696a401e0a9817083160de 3x", "genre": "art", "nsfw": true, "body": "お幸せに。\n\n柏崎星奈に似た女の子を聖母として描いてください。あどけない顔立ちに、大人びた胸。長い金髪に緑の瞳。抱きかかえるような仕草で立っている。胸元が露出しており、乳が漏れている。", "created_at": "", "completed_at": ""}, {"path": "/@gisyuled/works/43", "thumbnail_src": "https://si.imgix.net/32e96d14/uploads/origins/4351a2f3-f051-4930-bae9-c96c6c036d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cb5b40b2cc5005b5f3b77084d29da1a", "thumbnail_srcset": "https://si.imgix.net/32e96d14/uploads/origins/4351a2f3-f051-4930-bae9-c96c6c036d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cb5b40b2cc5005b5f3b77084d29da1a, https://si.imgix.net/32e96d14/uploads/origins/4351a2f3-f051-4930-bae9-c96c6c036d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad9ca8a356036ee91eb7f500161e2987 2x, https://si.imgix.net/32e96d14/uploads/origins/4351a2f3-f051-4930-bae9-c96c6c036d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28565c3c6fd49d8e5648e4aaf5fd455e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gisyuled/works/42", "thumbnail_