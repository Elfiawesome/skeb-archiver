%2Ccenter&txtsize=30&txt=PRIVATE&s=2ce6b82aa2bddb7a6172fd0ce9492bbf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ek_ra/works/162", "thumbnail_src": "https://si.imgix.net/770d2063/uploads/origins/b4ba4b96-29ac-4465-ad11-f96b1c12ed26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca90cf6edf9ea16c40dc1996ff56ae79", "thumbnail_srcset": "https://si.imgix.net/770d2063/uploads/origins/b4ba4b96-29ac-4465-ad11-f96b1c12ed26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca90cf6edf9ea16c40dc1996ff56ae79, https://si.imgix.net/770d2063/uploads/origins/b4ba4b96-29ac-4465-ad11-f96b1c12ed26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85c7296ac81d900e62ab942b225d395c 2x, https://si.imgix.net/770d2063/uploads/origins/b4ba4b96-29ac-4465-ad11-f96b1c12ed26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f9af458cc96fa679da91b75240b44f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、えくるあ先生！\nお元気でいらっしゃいますか。\n\n私のオリジナルキャラクター、あやこちゃんが代理人さんの膝に頭を乗せて耳を掃除してもらっている絵を描いていただけますか？\n雰囲気は温かくて穏やかです。  \n\nキャラクターの参考資料。\n代理人さん https://x.com/mimo_chorion/status/1804799472498536833\nhttps://pixiv.pximg.net/fanbox/public/images/creator/46975036/profile/MCDBF7tZWXpXfDp61oKmBKX0.jpeg\nあやこちゃん: x.gd/uZlOM\n\nあやこちゃんの服装:\nhttps://skeb.jp/@nenako_illust/works/14\n代理人さんはお好きな服装を着ていただいて構いません。\n他のすべてはあなた自身にお任せします。\n\nご検討いただきありがとうございます〜。", "created_at": "", "completed_at": ""}, {"path": "/@ek_ra/works/161", "thumbnail_src": "https://si.imgix.net/31b26e52/uploads/origins/44fbb366-1528-4555-8243-044e5c344233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdbb0f64f5cc1f35e99bd3447d9b2621", "thumbnail_srcset": "https://si.imgix.net/31b26e52/uploads/origins/44fbb366-1528-4555-8243-044e5c344233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdbb0f64f5cc1f35e99bd3447d9b2621, https://si.imgix.net/31b26e52/uploads/origins/44fbb366-1528-4555-8243-044e5c344233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dcb55c83a03bb0462354528add0daf7 2x, https://si.imgix.net/31b26e52/uploads/origins/44fbb366-1528-4555-8243-044e5c344233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5474d1478c2ec7a7d94e3615e790e5d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ek_ra/works/160", "thumbnail_src": "https://si.imgix.net/8e885ef7/uploads/origins/6fac334d-40fd-4e88-bc98-b48b8140e423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8508f7ebe5d9378e6fd55e9a418473a4", "thumbnail_srcset": "https://si.imgix.net/8e885ef7/uploads/origins/6fac334d-40fd-4e88-bc98-b48b8140e423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8508f7ebe5d9378e6fd55e9a418473a4, https://si.imgix.net/8e885ef7/uploads/origins/6fac334d-40fd-4e88-bc98-b48b8140e423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9612e27c871a3376280a4ea7299268d9 2x, https://si.imgix.net/8e885ef7/uploads/origins/6fac334d-40fd-4e88-bc98-b48b8140e423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59da1c2155416e1ebb16d5a6bbd506dc 3x", "genre": "art", "nsfw": false, "body": "えくるあ様\n\n初めまして、Vtuberのシャルエと申します。\nえくるあ様の素敵なイラストを拝見し、リクエストを送信させていただきました。\nもしご縁をいただけましたら、私シャルエのイラストをお願いいたします。\n\n【リクエスト内容】\nえくるあ様の絵柄で、寝ている姿のイラストをお願いできますと幸いです。\n（可能であれば、開いている目と起きている目の差分を希望です）\n\n衣装は省略や装飾の少ない衣装に変更など、えくるあ様の描きやすい形でお願いできますと大変ありがたく存じます。\n\nサムネイルなどに使用させていただきたいため、可能であれば帽子の左右どちらかのツバが見切れない構図、もしくは猫耳全体が入った構図を希望です。\n\n【使用用途】\nYoutube、SNS、FANBOX支援者様にネットプリント・壁紙の配布\n\n【納品形式】\n人物、背景、宛名等がレイヤー分けされたPSDもしくは背景透過のPNGを希望です\n\n【キャラクターについて】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ek_ra/works/159", "thumbnail_src": "https://si.imgix.net/b66971df/uploads/origins/fdea2992-6f1a-428e-b223-800d0b3e0a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8fd6925658e1acdd42f1b0613cbf6d2", "thumbnail_srcset": "https://si.imgix.net/b66971df/uploads/origins/fdea2992-6f1a-428e-b223-800d0b3e0a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8fd6925658e1acdd42f1b0613cbf6d2, https://si.imgix.net/b66971df/uploads/origins/fdea2992-6f1a-428e-b223-800d0b3e0a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec0580cc654a0d134b5873f1affe3d80 2x, https://si.imgix.net/b66971df/uploads/origins/fdea2992-6f1a-428e-b223-800d0b3e0a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9dfcafbe36c46f3350b72c352126b9f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！個人Vtuberのあれぐろもるとと申します。\nえくるあさんの描かれるイラストの絵柄に惹かれ、このたびリクエストいたしました！\n\n■依頼概要\nえくるあさんの絵柄で、Vtuber「あれぐろもると」を描いていただけますでしょうか？表情やポーズ、構図については、自由に描いていただけたら幸いです。\n\n・身体の周りに浮いているピアノ型のリングは作画コストが高いので、描いても描かなくてもどちらでも大丈夫です\n・身体の肉付き感については自由に盛っていただいてかまいません\n\n■作品を載せる可能性がある使用範囲\n・SNS投稿\n・動画やLIVE配信での紹介\n・動画サムネイル\n※載せる際はクレジットを表記します\n※トリミングして使用する場合があります\n\n■形式\nもし可能であれば、キャラクターと背景のレイヤーに別れているPSDファイルを納品物に含めて頂けますと幸いです。\n\nご検討の程よろしくお願いします。\n\nhttps://1drv.ms/f/c/ff7d93f1362b4673/EnNGKzbxk30ggP8YQQAAAAABn79k_Ofc56usIhu6aCsDhA", "created_at": "", "completed_at": ""}, {"path": "/@ek_ra/works/158", "thumbnail_src": "https://si.imgix.net/465be1c3/uploads/origins/a754508a-74db-4aec-8ba8-bfa01edde642?bg=%23fff&auto=format%2Ccompress&fm=webp&