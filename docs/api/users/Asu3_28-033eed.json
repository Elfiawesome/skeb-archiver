c-8c89-72a180150988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d831ebf07c0b313bd46efa926ee10c3", "thumbnail_srcset": "https://si.imgix.net/18739ca3/uploads/origins/f825aecb-97e1-41fc-8c89-72a180150988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d831ebf07c0b313bd46efa926ee10c3, https://si.imgix.net/18739ca3/uploads/origins/f825aecb-97e1-41fc-8c89-72a180150988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f46504c572b87a698e18dee46c7f75b3 2x, https://si.imgix.net/18739ca3/uploads/origins/f825aecb-97e1-41fc-8c89-72a180150988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5a2bf8174b00c6f4a0f97bb0edc8646 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品を見て恋に落ちました。\n\nファイアーエムブレムのヴィカの絵をお願いしたいです：詳細は以下の通りです。詳細を書いておきます：\n\n-ポーズは参考画像に近いものを希望します。\n-表情は少し微笑んでいる感じでお願いします。\n-髪は深緑や黒に描かれることがある。黒髪にしてほしい。\n\nご考慮いただきありがとうございました。\n\nキャラクターリファレンス\nhttps://drive.google.com/drive/folders/1YPe-59Y0N-SCnyvLcV3qDITFaYSMGsmZ\n\nポーズリファレンス\nhttps://drive.google.com/file/d/1RmvBQj-k4I02PF4xoM4iRWKtQtfHMAlD/view", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/51", "thumbnail_src": "https://si.imgix.net/11d2b080/uploads/origins/87983fc4-5b64-4074-be7a-8019ac909fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=783e6a437d01fd695e28a8f7e5902be2", "thumbnail_srcset": "https://si.imgix.net/11d2b080/uploads/origins/87983fc4-5b64-4074-be7a-8019ac909fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=783e6a437d01fd695e28a8f7e5902be2, https://si.imgix.net/11d2b080/uploads/origins/87983fc4-5b64-4074-be7a-8019ac909fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69bd9815a5878a3a1ad3fa263bfe211b 2x, https://si.imgix.net/11d2b080/uploads/origins/87983fc4-5b64-4074-be7a-8019ac909fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fb07c6f3e1e8237989822c57916673c 3x", "genre": "art", "nsfw": false, "body": "dora様、この間素敵なイラストをいただいてありがとうございました。\n今回また私の二人のOCの絵をお願いすることは可能でしょうか？\n\n・A（受け）\n財閥の跡継ぎ、子供の頃から恵まれた生活を送っています。\n計算高い同時に傲慢で尊大な面もあります（ツンデレ？）。\n体は弱くないけど、喧嘩すれば必ず負ける。\n妹がいて、兄としてソフトな一面もあります。\n特徴は整った黒い髪（アホ毛はない）、赤みの瞳です。\n\n・B（攻め）\nハーフ、父親は有名な外国人冒険家。幼い頃から父の冒険を追って育った彼は、荒野でのサバイバルのスキルをたくさん学んだ。\nとても頭がいいが、Aと違って直感や才能に頼るのではなく、理性と洞察力に頼っていた。\n穏やかで礼儀正しいが、人とは距離を置く。\n腹黒いの一面がある。\n\n二人ども高校生で、危ないゲームに巻き込まれた。最初の時は二人は対立する関係ですが、最後に協力してゲームを勝ち、真相を突き止めました。\n\n構図とポーズ、服装は指定しません。\nいずれは先生の画風通りに自由にお描きください。\n\nご迷惑をお掛けましたら、遠慮なくキャンセルしてください。\n金額を変更して再送も可能ですのでご検討宜しくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1DbW6Mv38xExuq8L1PKHZrScq6gxSEzMu?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/50", "thumbnail_src": "https://si.imgix.net/e8cc43f2/uploads/origins/f1f270a7-4be9-4893-9e2b-2e9a71cc42e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ed9d2f9fda391614960a07395b58f3", "thumbnail_srcset": "https://si.imgix.net/e8cc43f2/uploads/origins/f1f270a7-4be9-4893-9e2b-2e9a71cc42e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ed9d2f9fda391614960a07395b58f3, https://si.imgix.net/e8cc43f2/uploads/origins/f1f270a7-4be9-4893-9e2b-2e9a71cc42e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9861d15f67805991940c3d2c3550941 2x, https://si.imgix.net/e8cc43f2/uploads/origins/f1f270a7-4be9-4893-9e2b-2e9a71cc42e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50e932f3a99b7ca727d5799a6adcfbaa 3x", "genre": "art", "nsfw": false, "body": "私はVtuberをしているのですが、私のキャラクターを描いていただけませんか？ポーズや表情、設定など全てお任せします！\n\nあなたの画風はとてもユニークで好きです！好きなスタイルで私を描いてください！\n\n以下は私のキャラクターに関する参考資料と情報です： https://imgur.com/a/iQkN4XE\n\nあなたのスタイルで何ができるのか楽しみです！あなたに似合う服装やスタイルで自由にやってください。\n\n\nご検討のほど、よろしくお願いいたします！<3", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/49", "thumbnail_src": "https://si.imgix.net/e60b9465/uploads/origins/1cdea5d5-15d5-478b-b558-080807627bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2282bc676b245c97472423dab35edd7c", "thumbnail_srcset": "https://si.imgix.net/e60b9465/uploads/origins/1cdea5d5-15d5-478b-b558-080807627bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2282bc676b245c97472423dab35edd7c, https://si.imgix.net/e60b9465/uploads/origins/1cdea5d5-15d5-478b-b558-080807627bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4614011e9ddda7e4607a33a51aba9510 2x, https://si.imgix.net/e60b9465/uploads/origins/1cdea5d5-15d5-478b-b558-080807627bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4fa369845f323ccdf5399ff7059ef85 3x", "genre": "art", "nsfw": false, "body": "Dora様\nはじめまして、安眠ねむむと申します！\n\nクリスマス用の1枚絵をお願いしたく、\nご依頼致しました。\n\n衣装や表情は基本ご自由で大丈夫ですので、\nお任せしたいです\n\n資料として、立ち絵も一緒にお送りします。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jBxF-x-ZEQPez-1jcjLGxKHvimNJhep9", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/48", "thumbnail_src": "https://si.imgix.net/d785bd98/uploads/origins/29f2c4d7-0049-4351-b76f-fd898cb929aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6074fe069d4cc6b582fa582c9f61175", "thumbnail_srcset": "https://si.imgix.net/d785bd98/uploads/origins/29f2c4d7-0049-4351-b76f-fd898cb929aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6074fe069d4cc6b582fa582c9f61175, https://si.imgix.net/d785bd98/uploads/origins/29f2c4d7-0049-4351-b76f-fd898cb929aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e6576e4b88c005ab165c27dacec6029 2x, https://si.imgix.net/d785bd98/uploads/origins/29f2c4d7-0049-4351-b76f-fd898cb929aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3850a8773faa095b6a5265c2985cd745 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\nDora様の絵がとても繊細で素晴らしいだと思い、この度はocの全身イラストを依頼させていただきいです。\n\n→設定\n20代後半の女子、職業は闇屋。性格は冷徹で意地が悪い。人間観察と物事の流れを把握のが趣味、観察している際によくニヤニヤする。背が高く、体術の心得もある。\n\n構図やポーズなどは指定なしで、Dora様におまかせします。\n\n頂いたイラストはSNSへの投稿・アイコンとして使わせていただきます。\n\nもしスケジュールやリクエスト内容が金額に沿わないなど難しい点がありましたら、お気軽にキャンセルしてください。\n\n以上、お忙しいとは存じますが、\nご一読のうえご検討のほどお願いいたします。\n\nhttps://drive.google.com/drive/folders/15i-Rlg54kEH6625Qu4tyHEYIvWzX0e-D", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/47", "thumbnail_src": "https://si.imgix.net/09ec3ce7/uploads/origins/fc9ddc84-fc46-439b-a5eb-3bfb1a6d0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01cfc18c6edb45d86424b94f80425f12", "thumbnail_srcset": "https://si.imgix.net/09ec3ce7/uploads/origins/fc9ddc84-fc46-439b-a5eb-3bfb1a6d0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01cfc18c6edb45d86424b94f80425f12, https://si.imgix.net/09ec3ce7/uploads/origins/fc9ddc84-fc46-439b-a5eb-3bfb1a6d0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bc1cc0b26db3fcc89824f0ae7578ed1 2x, https://si.imgix.net/09ec3ce7/uploads/origins/fc9ddc84-fc46-439b-a5eb-3bfb1a6d0a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d682c304e6d0d0ba0aa33fd9ff72a5e6 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n偶然お見かけしたDora様の絵の描かれ方に惹かれ、こちらにリクエストを送らせていただきました。\nもしよろしければゲーム内にて使用していたOCを、デフォルメ抜きの等身の状態で描いていただきたいです。\n\nこれといった細かな特徴の指定はございません。また、髪型や顔立ちなどの、細かなデザインや服装はお任せ致します。決まっているのは女性で、髪の色が黒であるということと、目の色が黄色であること程度です。\n\n直近のゲーム内にて使用しているキャラクターの資料のリンクを記載しておきますので、ご査収の程よろしくお願い致します。\n\nゲーム内でのデフォルメが特徴的であり、またデザインの殆どをお願いする形となってしまいますので、ご負担になってしまう場合や、内容が合わないと感じましたら気兼ねなくキャンセルしていただいて構いません。\n\nお忙しい中恐縮ではございますが、ご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-VZW7YUroBw9UKFTus5U0ze4xoksTYl4", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/46", "thumbnail_src": "https://si.imgix.net/effc2eb9/uploads/origins/8e63ff80-8f39-48d1-a1d5-10e90f0f3f76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19cad5cc8a6b03dfb983f55675c235a0", "thumbnail_srcset": "https://si.imgix.net/effc2eb9/uploads/origins/8e63ff80-8f39-48d1-a1d5-10e90f0f3f76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19cad5cc8a6b03dfb983f55675c235a0, https://si.imgix.net/effc2eb9/uploads/origins/8e63ff80-8f39-48d1-a1d5-10e90f0f3f76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dee4e6898ac6382859a150ff3856a7d 2x, https://si.imgix.net/effc2eb9/uploads/origins/8e63ff80-8f39-48d1-a1d5-10e90f0f3f76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfb0bf19b78e3328e598ddd93425d415 3x", "genre": "art", "nsfw": false, "body": "Doraさま、こんばんは。この間お世話になりました。\n今回はTRPGのOCイラストを依頼したいです。\n\n彼女は狐の妖怪、無口で冷たい女の子です。年齢は17歳ぐらいです。\n身の周りの蝶を使って、敵を素早く眠らせることができる。\n\n見にくい部分はアレンジ、省略は自由にどうぞ。\n\nご迷惑をお掛けましたら、遠慮なくキャンセルしてください。\nご検討のほど宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WSe7aqoqeJdT52tApu6jrIIekdimmaHM?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/45", "thumbnail_src": "https://si.imgix.net/30d93aad/uploads/origins/26b8e777-7588-4b02-8a2f-851cd54f4aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4592245bf4d9b12d27ab2fceb04602", "thumbnail_srcset": "https://si.imgix.net/30d93aad/uploads/origins/26b8e777-7588-4b02-8a2f-851cd54f4aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4592245bf4d9b12d27ab2fceb04602, https://si.imgix.net/30d93aad/uploads/origins/26b8e777-7588-4b02-8a2f-851cd54f4aad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff54a00602645d23832d1f3a92029c2f 2x, https://si.imgix.net/30d93aad/uploads/origins/26b8e777-7588-4b02-8a2f-851cd54f4aad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85a873f15c424bda02dfb8a1d5c3aa55 3x", "genre": "art", "nsfw": false, "body": "Dorq様こんにちは。\nCoCTRPG「片鱗」の探索者イラストを依頼させていただきたいです。(秘匿HOありのシナリオですが、ネタバレはありません)\nよろしくお願い致します。\n設定は以下となります。\n\n「紫」\n年齢不明の殺人鬼\n163cm\n常にヘラヘラとしている\n何を考えているのかわからない恐ろしさがある\n首筋にアゲハ蝶のタトゥー、目の中にアゲハ蝶模様が入っている\n黒のスーツ(パンツスタイル)を着ており紫のシャツを七分丈程度に腕まくりしている\n靴は革靴\nhttps://drive.google.com/file/d/1q2vit80H-qfuk23zCAOAO1zzPJolm-uQ/view?usp=drivesdk\n\n「水色」\n17歳の高校生\n154cm\n内気で引っ込み思案\n頼まれると嫌でも断れない性格\nイメージ画像通りのセーラー服を着ている\n上と同じ色合いの膝下丈のスカートを履いている\n黒のタイツにローファー\nhttps://drive.google.com/file/d/1RyAENlCXw3LsDVM6FbWlZki4PH3kWWNd/view?usp=drivesdk\n\nシナリオ概要:雨の中で出会った凶悪な殺人鬼を高校生が匿う\n関係:水色は怯えつつもぐいぐい来る紫を受け入れてしまう(傘に入れてしまう)\nモチーフ:雨、ビニール傘\n使用用途:個人鑑賞、X・ディスコードなどでのアイコン使用(Dorq様のXにて@tos等で禁止とお伝えいただければ控えます)\n\n構図やポーズなどは自由に決めていただいて構いません。(「片鱗 CoC」と検索すれば他の方の探索者イラストが出てくると思いますのでご参考までに…！)\n\nskebでの依頼が初めてのため何か不都合がありましたら申し訳ありません。\nあと私はハシちゃんのハシビロです！\nよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@Asu3_28/works/44", "thumbnail_src": "https://si.imgix.net/3aba7a5c/uploads/origins/fe34eb40-e5cc-437f-9bda-75fd3284c02d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1515e42a79ebb4efa2eb0404e4aea764", "thumbnail_srcset": "https://si.imgix.net/3aba7a5c/uploads/origins/fe34eb40-e5cc-437f-9bda-75fd3284c02d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1515e42a79ebb4efa2eb0404e4aea764, https://si.imgix.net/3aba7a5c/uploads/origins/fe34eb40-e5cc-437f-9bda-75fd3284c02d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2e52d270e0d3bd52fe7feb7dcf9eee6 2x, https://si.imgix.net/3aba7a5c/uploads/origins/fe34eb40-e5cc-437f-9bda-75fd3284c02d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca9d915e564fb9bd62b5583d47c5057e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、またあなたに全身をお願いしたいです！\n\n今回は「アルエット」というキャラクターで、賞金稼ぎを始めたシルシーカーです。大声で、擦れっ面で、生意気だが、懸賞金を失敗したことがないため、実績はある。\n\n参考にしたのは大雑把なものなので、原作っぽさが残っている限り、細かいディテールの解釈は自由だ。\n\nデザイン上の注意：\n- どちらの瞳孔でも描けます。\n- 髪は太く長い三つ編み\n- 彼女の \"翼 \"は光でできているので、光ります。\n- シルバーのアクセサリーはチェーンやビーズ、十字架などを想定しているので、好きなように描いてください。\n- ネックレスは重要です！\n\nお願いするのはカッコいいポーズだけで、あとはお任せします。\n\n重ね重ね、ご配慮ありがとうございました！\n\nhttp