Ccenter&txtsize=30&txt=PRIVATE&s=c21f76e4bd2e16d3275ac587496f8f82, https://si.imgix.net/38fff1c1/uploads/origins/97f6921c-2071-4421-9625-a6c6bf082556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac10ad3e6db8a1b208466e38fe2ea5b0 2x, https://si.imgix.net/38fff1c1/uploads/origins/97f6921c-2071-4421-9625-a6c6bf082556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ea080217dbc3fbe4759697332dd35d3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/116", "thumbnail_src": "https://si.imgix.net/f0e31b5b/uploads/origins/81bd8ae0-8ba0-4970-bb91-7e54873aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=518b0ff6f2e42783108cf298c673695f", "thumbnail_srcset": "https://si.imgix.net/f0e31b5b/uploads/origins/81bd8ae0-8ba0-4970-bb91-7e54873aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=518b0ff6f2e42783108cf298c673695f, https://si.imgix.net/f0e31b5b/uploads/origins/81bd8ae0-8ba0-4970-bb91-7e54873aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6e27431af020e2eecf8f7743e205485 2x, https://si.imgix.net/f0e31b5b/uploads/origins/81bd8ae0-8ba0-4970-bb91-7e54873aabbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bae4635bfa7e5d2f91c9ff0117357a4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/115", "thumbnail_src": "https://si.imgix.net/c86130a6/uploads/origins/cb4daa30-92bf-4fd2-b75f-bc5a62ec5e58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759696902faafe9e32363709054abb4a", "thumbnail_srcset": "https://si.imgix.net/c86130a6/uploads/origins/cb4daa30-92bf-4fd2-b75f-bc5a62ec5e58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759696902faafe9e32363709054abb4a, https://si.imgix.net/c86130a6/uploads/origins/cb4daa30-92bf-4fd2-b75f-bc5a62ec5e58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da7850933a85f15e78a355329f760f6 2x, https://si.imgix.net/c86130a6/uploads/origins/cb4daa30-92bf-4fd2-b75f-bc5a62ec5e58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d8fd494a5a6906dcacdf287b5d5c61e 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you.\nI am a Vtuber working independently. My name is Sensai Tsuina. Tsuina is an angelic idol from heaven.\nI am contacting you to request the creation of my Twitch logo in preparation for my debut!\n\nThe main feelings I would like the logo to show:\nShe brings joy to heaven through her music. Please make a peaceful and heavenly idol logo!\n\nShe has sea coloured hair, a golden musical angelic halo, and wings with golden diamonds in them. She also has pink ribbons and a really pretty white dress. Her necklace and earrings are all musically themed.\n\nTEXT: \nSensai Tsuina (big)\n仙斎ついな (small)\n\nPlease choose the layout of text as you'd like! \n\nPlease feel free to include details from my design like my Halo, Wings and Necklace in the design as you see fit!\n\nI would prefer if it has a more 'classical' look, like a heavenly angel, than a cartoony look. (not bubbly)\n\n[Usage]\n・Twitch\n・Use in broadcast screens and social media\n・Merchandise\n・Animation\n\n[Remarks]\n・We would like to receive the data in PSD format with the background separated.\n\nI look forward to working with you!\n\nhttps://drive.google.com/drive/folders/1ySSeTAwsvpFZ9MwY7Y2r4Wrb33XAswEA?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/114", "thumbnail_src": "https://si.imgix.net/33af649c/uploads/origins/3c976e30-30a1-42f7-8b77-63bb6b6a6bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f1a5a031d12c856f5af8a6c660998a", "thumbnail_srcset": "https://si.imgix.net/33af649c/uploads/origins/3c976e30-30a1-42f7-8b77-63bb6b6a6bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f1a5a031d12c856f5af8a6c660998a, https://si.imgix.net/33af649c/uploads/origins/3c976e30-30a1-42f7-8b77-63bb6b6a6bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61114f22d6ff790c66b280792b181e3c 2x, https://si.imgix.net/33af649c/uploads/origins/3c976e30-30a1-42f7-8b77-63bb6b6a6bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bbf0b34e675c337ca61f7654954418d 3x", "genre": "art", "nsfw": false, "body": "このイメージは、僕が作っているTTRPGのためのものなんだ。ロゴの背景にあるアイデアは「メランコリア」というタイトルで、背景は描かれたひまわりです。このロゴはこの画像https://x.com/DA_Artworks/status/1925207234365022465。\n\n狼の輪郭とひまわりを組み合わせたバージョンも考えていたのですが、最終的にはまとまりのあるものにしたいです。少しシリアスで、どこか不思議な感じ。最初に考えたのはこんな感じです。\n\nでも、このhttps://skeb.jp/@Kuroha_17/works/72 や、https://skeb.jp/@Kuroha_17/works/26 のような、あなたの以前の作品をとても楽しんでいます。\n\nだから、そういうところからインスピレーションを得てほしいと思っていたんだ。僕もサークルは好きだけど、全部をどう取り入れたらいいかわからない。黒羽さんなら私のイメージを形にできる力があると信じています。  色については、私が提供したイメージに一番合うものを使ってください。\n\nhttps://x.com/DA_Artworks/status/1925207234365022465", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/113", "thumbnail_src": "https://si.imgix.net/33ceaa5d/uploads/origins/4a127029-c4f8-4def-8d70-bc024e819fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d49c465ca9c809063ab26dd19fdb51f7", "thumbnail_srcset": "https://si.imgix.net/33ceaa5d/uploads/origins/4a127029-c4f8-4def-8d70-bc024e819fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d49c465ca9c809063ab26dd19fdb51f7, https://si.imgix.net/33ceaa5d/uploads/origins/4a127029-c4f8-4def-8d70-bc024e819fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6402d6863671868b722424dda89bb35b 2x, https://si.imgix.net/33ceaa5d/uploads/origins/4a127029-c4f8-4def-8d70-bc024e819fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc89538a987d631f29ec79beb80f2290 3x", "genre": "art", "nsfw": false, "body": "黒羽さんへ\n\nこんにちは！あなたのこれまでの作品が大好きです。Vtuberの狐の女神mahinaのロゴをお願いしたいです。\nmahina \"のロゴを英語で[m a h i n a <綴りはこうです！>]お願いしたいです。桜神まひなは小さめの文字で、マヒナのマーク、桜の花、ピンクのハート、月のアクセサリーをデザインに取り入れてほしいです。\n\n桜とハートと月のチャームがたくさんあれば、デザインや構成はお任せしたいです。ピンクと白を少し使って、月はゴールドでお願いします。マネタイズ配信やグッズに使いたいです！\n\n[主な使用目的】 マネタイズ配信のサムネイルとして使用 TwitterなどのSNSで使用 グッズなどの商用利用 Twitterなどでも使用します。\n\n一番気に入っている作品は：くろは_17/works/94\n\nhttps://drive.google.com/file/d/1D8ltYuJCUyyeuSftusfRLQr0ioRdoMG3/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/112", "thumbnail_src": "https://si.imgix.net/b4c29929/uploads/origins/c3bccc72-c393-457f-ab1e-2feba58234c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fddfacd7ffcbeed926ffcd45ef63608", "thumbnail_srcset": "https://si.imgix.net/b4c29929/uploads/origins/c3bccc72-c393-457f-ab1e-2feba58234c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fddfacd7ffcbeed926ffcd45ef63608, https://si.imgix.net/b4c29929/uploads/origins/c3bccc72-c393-457f-ab1e-2feba58234c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b753395cd7cc94b8d293522f26d8983 2x, https://si.imgix.net/b4c29929/uploads/origins/c3bccc72-c393-457f-ab1e-2feba58234c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dda8ea810b3af55ed7d7a9663ba0f8d9 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。幻想的なロゴのデザインに惹かれました。\n私はFF14をメインに活動していまして、FCマスターも務めているのですが、自分用のものはいくつかありますがFC用のはありませんので、今回お願いさせていただきました。\nチーム自体、私自身が発足なので自己主張強めで、私個人のものを使っていました。\n何かインスピレーションになればと、PSO2時代のものが多めですが、下記URLに以前のものや私個人で使ってたものを置いてます。\n\n・モチーフカラーは【黒と緑】でお願いします。\n・チーム名は【Cathedral Croix】(カテドラルクロワ)です。英語表記でお願いします。\n・名前に聖堂や十字架が付いていますので、それを連想させるもの。\n・FC自体の設定や雰囲気としては「元教会の審問官だった人らが傭兵になって名残を残して活動してる」といった感じです\n・その他はお任せいたします。\n\n主な使用用途は、SNSやFC募集、SS撮影時のロゴに使わせていただきたいです。メンバーにも共有したいと思っています。\nですから透過されてるものと背景があるものも頂けると嬉しいです。基本的にチーム関係のみで使っていきます。\n\nご検討の方、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Vmj5pecPOou2uARQXzymLyuYzrhRSrLk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/111", "thumbnail_src": "https://si.imgix.net/7ec13023/uploads/origins/2cd2fb9e-ad3e-4f42-8ef2-0320f6d0113b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=310b75f1034ae16d02006cbed117df4a", "thumbnail_srcset": "https://si.imgix.net/7ec13023/uploads/origins/2cd2fb9e-ad3e-4f42-8ef2-0320f6d0113b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=310b75f1034ae16d02006cbed117df4a, https://si.imgix.net/7ec13023/uploads/origins/2cd2fb9e-ad3e-4f42-8ef2-0320f6d0113b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b6615ab2ad2d27af010a368c422daca 2x, https://si.imgix.net/7ec13023/uploads/origins/2cd2fb9e-ad3e-4f42-8ef2-0320f6d0113b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=739d1904cb95b6d4fe3d2f03bce66dee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/110", "thumbnail_src": "https://si.imgix.net/e47e2095/uploads/origins/425daa15-6237-4afb-968e-49dab7ee0b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65a8153d96e379faa385f6d11b06618d", "thumbnail_srcset": "https://si.imgix.net/e47e2095/uploads/origins/425daa15-6237-4afb-968e-49dab7ee0b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65a8153d96e379faa385f6d11b06618d, https://si.imgix.net/e47e2095/uploads/origins/425daa15-6237-4afb-968e-49dab7ee0b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2b8bd13565c20faea832794f9deed21 2x, https://si.imgix.net/e47e2095/uploads/origins/425daa15-6237-4afb-968e-49dab7ee0b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=909020f7a0704248903773d9aa204c08 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nVストリーマー兼イラストレーターの志原さくやと申します。\n最近Kurohaさんのモダンでおしゃれなデザインに出会い、一目でファンになりました！\n今回は、配信活動用のロゴと、個人サイトのfaviconとして使える差分の制作をお願いしたく、ご依頼させていただきました。\n\nモチーフは「白い狐」で、配色は主に白・黒・赤＋ゴールドのアクセントです。\n現時点では和風の要素がありますが、今後衣装の変化に伴って雰囲気が変わる可能性があるため、和風モチーフよりも「狐」や「配色（白・黒・赤＋ゴールド）」にフォーカスしていただけると嬉しいです。\n\nデザインはKurohaさんのセンスにお任せできればと思っております。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nf6UGYUYtDqee9-M9Iiaz0ZUMSn0a8Ct?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/109", "thumbnail_src": "https://si.imgix.net/43a459b7/uploads/origins/04888eb3-b16c-4161-b489-99087dcd53c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5acf32596066c90cb7da84af7c64e5b6", "thumbnail_srcset": "https://si.imgix.net/43a459b7/uploads/origins/04888eb3-b16c-4161-b489-99087dcd53c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5acf32596066c90cb7da84af7c64e5b6, https://si.imgix.net/43a459b7/uploads/origins/04888eb3-b16c-4161-b489-99087dcd53c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d3083651341181a8e26518cdf202553 2x, https://si.imgix.net/43a459b7/uploads/origins/04888eb3-b16c-4161-b489-99087dcd53c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7335d7db1147000c7aac41539504b6b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のVtuberキャラクターのロゴをお願いしたいです！彼女の名前はリザで、夜になると人間になる女神です。彼女は落ち着いていて、大人です。ロゴはリザ・エリスとリザ・エリスと書いてください。彼女のデザインの要素を含むと最高です。アトリエシリーズ」のゲームロゴのような見た目が好きです！.psdファイルでパーツを分けていただけると助かります。ご考慮いただきありがとうございました！\n\n\nhttps://drive.google.com/drive/folders/1t0jtRnI8y3Kaci00chdOojV7QD-Nn1vo?usp=drive_link\n\n私が本当に好きなロゴの例：\nhttps://m.media-amazon.com/images/M/MV5BZDhlNjNhMWYtMmViOS00ZWY1LTg4NjItNGMyZDA1MjcyNTEwXkEyXkFqcGdeQXVyMzgxODM4NjM@._V1_FMjpg_UX1000_.jpg\n\nあなたが作ったロゴで、私がとても気に入っているものの例：\nhttps://skeb.jp/@Kuroha_17/works/2\nhttps://skeb.jp/@Kuroha_17/works/92\nhttps://skeb.jp/@Kuroha_17/works/36\nhttps://skeb.jp/@Kuroha_17/works/17", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/108", "thumbnail_src": "https://si.imgix.net/e9500157/uploads/origins/092aecf8-1cad-4e5b-877f-871cb2143714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfba075195f2ee16f8b297dfff1a5ae0", "thumbnail_srcset": "https://si.imgix.net/e9500157/uploads/origins/092aecf8-1cad-4e5b-877f-871cb2143714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfba075195f2ee16f8b297dfff1a5ae0, https://si.imgix.net/e9500157/uploads/origins/092aecf8-1cad-4e5b-877f-871cb2143714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=462b983f885a66358d3cef2fd22ef374 2x, https://si.imgix.net/e9500157/uploads/origins/092aecf8-1cad-4e5b-877f-871cb2143714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8df75468558ef12624a736a26400de1a 3x", "genre": "art", "nsfw": false, "body": "はじめまして！あなたの美しいデザインに一目惚れしました！\n\n私の新しい音楽プロジェクト \"AirliS\"(AとSを大文字に)のロゴデザインをお願いしたいです。\n\nペンアート風にエレガントな花のデザインを取り入れていただけたらと思います：\nhttps://skeb.jp/@Kuroha_17/works/26\nhttps://skeb.jp/@Kuroha_17/works/82\nhttps://skeb.jp/@Kuroha_17/works/35\n\nテキスト／フォントスタイルでは、以下のデザインが特に気に入った：\nhttps://skeb.jp/@Kuroha_17/works/31\n美しい繊細なスタイルとボーダーレスなデザインで、最初の文字「A」のスタイルも気に入っています。\nあなたのプロフィール「Kuroha」のロゴもエレガントで素敵です。\n\nインスピレーションとカラーパレットは、こちらのキャラクターイラストをどうぞ：\nhttps://drive.google.com/file/d/1Sv0wUIy4RNCQ1MQdz-NE7CBHto28Vw5r/view?usp=drive_link\n\n可能であれば、レイヤーを分けたPSDファイルを添付していただけないでしょうか。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/107", "thumbnail_src": "https://si.imgix.net/34c8838b/uploads/origins/916f1d54-5386-44b2-9104-eb8f6b5e267d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=501f82116bd4ddfb70ac62f40ccbf59e", "thumbnail_srcset": "https://si.imgix.net/34c8838b/uploads/origins/916f1d54-5386-44b2-9104-eb8f6b5e267d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=501f82116bd4ddfb70ac62f40ccbf59e, https://si.imgix.net/34c8838b/uploads/origins/916f1d54-5386-44b2-9104-eb8f6b5e267d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83e201d682ddd79600251cf910f6958e 2x, https://si.imgix.net/34c8838b/uploads/origins/916f1d54-5386-44b2-9104-eb8f6b5e267d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27e0ce32dd27a3e2ec083e85a237bae4 3x", "genre": "art", "nsfw": false, "body": "Vtuber準備中のクリシア・シフォン（Crisia Siphon）です。\nyoutubeのヘッダーやサムネイルなどに使用する名前ロゴの依頼をしたいです。\n（主にゲーム配信の活動で、仕事に疲れた女が眠って変身した姿で活動するというような感じです）\n\n見た目：http://gofile.me/4MhRn/AS6M30xhE\n\nモチーフとしては月や太陽、星などの天体、猫、ファンタジー、夢で、ロゴに使う組み合わせはお任せします。\n縦型と横型があると助かります。", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/106", "thumbnail_src": "https://si.imgix.net/aac90be4/uploads/origins/9c3c3350-d7fa-4c92-9ce8-f4646eaede15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38d82efa806360a001f0af07aeb1d38a", "thumbnail_srcset": "https://si.imgix.net/aac90be4/uploads/origins/9c3c3350-d7fa-4c92-9ce8-f4646eaede15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38d82efa806360a001f0af07aeb1d38a, https://si.imgix.net/aac90be4/uploads/origins/9c3c3350-d7fa-4c92-9ce8-f4646eaede15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c2fab55ef0a7143ccec0cf4f5b43532 2x, https://si.imgix.net/aac90be4/uploads/origins/9c3c3350-d7fa-4c92-9ce8-f4646eaede15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06998b696b29647db5ee94f345a540eb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kuroha_17/works/105", "thumbnail_src": "https://si.imgix.net/d925d447/uploads/origins/7daff7aa-7ba2-475e-882d-63f2e869a020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f26b4d28e0ebb8474ef1a3bb5a9a8326", "thumbnail_srcset": "https://si.imgix.net/d925d447/uploads/origins/7daff7aa-7ba2-475e-882d-63f2e869a020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f26b4d28e0ebb8474ef1a3bb5a9a8326, https://si.imgix.net/d925d447/uploads/origins/7daff7aa-7ba2-475e-882d-63f2e869a020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=714da4951fe05184d02a35d2e31023a3 2x, https://si.imgix.net/d925d447/uploads/origins/7daff7aa-7ba2-475e-882d-63f2e869a020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c12a118786fa69ee230a57e2cef67cb4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルが大好きなので、ぜひロゴのデザインをお願いしたいです！\n私のチャットオーバーレイ、キャラクターデザイン、その他の詳細はgoogleフォルダにあります！\n\n玲は赤とオレンジの髪、炎の尻尾、目に炎を持つ火の鬼です！\n私のオーバーレイとキャラクターにぴったりだと思うロゴを作ってほしいです！\n\nロゴテキスト  火鬼レイ\n(カタカナ・漢字の名前も入れていただけると嬉しいです。）\n\n文字のレイアウトは自由に選んでください！(一行でも、ずらしてでも。各単語の間にはスペースを入れてください。\n\nロゴのアウトラインをゴールドにすると、オ