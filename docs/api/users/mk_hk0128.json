%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40272ad5933a37089b989c9b5ea270a9", "thumbnail_srcset": "https://si.imgix.net/96c4ed86/uploads/origins/320ab9a7-2e96-43aa-9117-ee9a58dcc3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40272ad5933a37089b989c9b5ea270a9, https://si.imgix.net/96c4ed86/uploads/origins/320ab9a7-2e96-43aa-9117-ee9a58dcc3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0b4ce1c2514f9957dee789600867437 2x, https://si.imgix.net/96c4ed86/uploads/origins/320ab9a7-2e96-43aa-9117-ee9a58dcc3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09991a07b76cd64d2e91e8df77af1cc5 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！あなたの推薦で、アリアとカラがタオルを着ている絵をお願いします。遅くなって申し訳ありません。\n\nhttps://imgur.com/a/UaXrPaq\nhttps://imgur.com/a/vz9t87c", "created_at": "", "completed_at": ""}, {"path": "/@mk_hk0128/works/52", "thumbnail_src": "https://si.imgix.net/ef2c38b6/uploads/origins/84c19c5d-b69b-4f04-b058-3144a60fc434?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0260ea9e47aaf73cb970f80010136af", "thumbnail_srcset": "https://si.imgix.net/ef2c38b6/uploads/origins/84c19c5d-b69b-4f04-b058-3144a60fc434?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0260ea9e47aaf73cb970f80010136af, https://si.imgix.net/ef2c38b6/uploads/origins/84c19c5d-b69b-4f04-b058-3144a60fc434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4e1cda42ab618a81ea3f8c35fe16326 2x, https://si.imgix.net/ef2c38b6/uploads/origins/84c19c5d-b69b-4f04-b058-3144a60fc434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db8cdc88c9d7a773a850bc048efac250 3x", "genre": "art", "nsfw": false, "body": "アピールをありがとう！ぜひクリスタを描いてほしい！\n\n新しい服でも、用意された服でも、自由に描いてください。\n\nお忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1Or8LarI3Von9dg5cjHr42ymEYmnI1F3e?dmr=1&ec=wgc-drive-globalnav-goto", "created_at": "", "completed_at": ""}, {"path": "/@mk_hk0128/works/51", "thumbnail_src": "https://si.imgix.net/d12eefe3/uploads/origins/7f7315bd-f1cf-4a89-a47a-f280a9b36a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=641c768e8996c07134da379c51921fed", "thumbnail_srcset": "https://si.imgix.net/d12eefe3/uploads/origins/7f7315bd-f1cf-4a89-a47a-f280a9b36a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=641c768e8996c07134da379c51921fed, https://si.imgix.net/d12eefe3/uploads/origins/7f7315bd-f1cf-4a89-a47a-f280a9b36a65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38f61e4ec15b2cc699c5d5fd75db84cc 2x, https://si.imgix.net/d12eefe3/uploads/origins/7f7315bd-f1cf-4a89-a47a-f280a9b36a65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d3dfb17f96dd61e63735a39bd941adc 3x", "genre": "art", "nsfw": false, "body": "はじめまして、アピールしていただきありがとうございます。\n是非たぬきくんを描いていただきたくリクエストを送らせてもらいます。\n\n内容ですが新衣装の指定のみさせていただき、それ以外についてはお任せします。\n参考資料を資料URLに新衣装に関する資料を画像とテキストで用意しました、\nフードを被っているのかで雰囲気が大きく変わるのでお手数ですが上記のテキストのご一読願います。\n\n\n衣装、アクセサリ等は一部省略、アレンジなどして頂いて問題ございません、よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/usxzh5yikp1pleweg2sdb/h?rlkey=tq8y32nwbsgijr5qnuz6bhab1&st=sp9qka25&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@mk_hk0128/works/50", "thumbnail_src": "https://si.imgix.net/d1c5c835/uploads/origins/f44d04ce-ec7d-4d0d-ae5a-805aae3bc06b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a5695ea1d0d39116346664c63c99ec", "thumbnail_srcset": "https://si.imgix.net/d1c5c835/uploads/origins/f44d04ce-ec7d-4d0d-ae5a-805aae3bc06b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a5695ea1d0d39116346664c63c99ec, https://si.imgix.net/d1c5c835/uploads/origins/f44d04ce-ec7d-4d0d-ae5a-805aae3bc06b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f76915ab03e45eeffe8da2173d83fda 2x, https://si.imgix.net/d1c5c835/uploads/origins/f4