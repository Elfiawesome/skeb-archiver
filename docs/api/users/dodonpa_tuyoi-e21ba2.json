5a/uploads/origins/8e65262c-1fb2-4e10-929c-06b9b12ee438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a0e361604c2c9d6d701cb59acb9ca33", "thumbnail_srcset": "https://si.imgix.net/90a5915a/uploads/origins/8e65262c-1fb2-4e10-929c-06b9b12ee438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a0e361604c2c9d6d701cb59acb9ca33, https://si.imgix.net/90a5915a/uploads/origins/8e65262c-1fb2-4e10-929c-06b9b12ee438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=addd1bf9d65c742ededea4c0cf5e69c6 2x, https://si.imgix.net/90a5915a/uploads/origins/8e65262c-1fb2-4e10-929c-06b9b12ee438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dbd2510d8628817351b6ce978e4d38d 3x", "genre": "art", "nsfw": false, "body": "かなと様\n\n以下に依頼したい内容を記載させていただきます。\n※このリクエストのイラストには、ポケモンの要素があり、【非商業目的】に使用されるつもりです（自分のファン小説に読者に無料で見せるためだけです）。\n---------------\nそのキャラクターは、A~Bカップ 、赤い肩の長さの短い髪の間に、身長145cmの約14歳の女の子として設定され、瞳孔の色は血のように赤いです。\n彼女は人を楽しませるのが好きなアイドルだが、プライベートでは性格が暗い。\n\nポケモン：フォッコ\n\n参照できる画像：\nhttps://twitter.com/Kanbe_Bell/status/1439187921651732487\n\nこのイメージは、【キャラクター外観】を参照するために使用できると思います。\n服装・構図、お好きなように決めてください 。\n---------------\n創作に難度があれば、適度に元素を削減してもいいです。", "created_at": "", "completed_at": ""}, {"path": "/@dodonpa_tuyoi/works/14", "thumbnail_src": "https://si.imgix.net/a9f23047/uploads/origins/b82dfb65-403c-43fc-a72e-10286f972260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa5c9bf774f60d7dbb2fde132c3554f", "thumbnail_srcset": "https://si.imgix.net/a9f23047/uploads/origins/b82dfb65-403c-43fc-a72e-10286f972260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa5c9bf774f60d7dbb2fde132c3554f, https://si.imgix.net/a9f23047/uploads/origins/b82dfb65-403c-43fc-a72e-10286f972260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04a909078ed71fed2d1bbfd5a2c11a83 2x, https://si.imgix.net/a9f23047/uploads/origins/b82dfb65-403c-4