77291557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0b0824e9b9b8c35574740cc645f9e44", "thumbnail_srcset": "https://si.imgix.net/5805971f/uploads/origins/f4a9513c-d256-4928-bd9c-2d277291557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0b0824e9b9b8c35574740cc645f9e44, https://si.imgix.net/5805971f/uploads/origins/f4a9513c-d256-4928-bd9c-2d277291557d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee7772ef844232f2959a0519b283f387 2x, https://si.imgix.net/5805971f/uploads/origins/f4a9513c-d256-4928-bd9c-2d277291557d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4a67eed40c76ccd25a8ebb1a5f3e7e5 3x", "genre": "art", "nsfw": true, "body": "こんにちは、足乃ちまどさん\nお元気でお過ごしでしょうか！\n次のリクエストですが、激しく荒々しいセックスをするナズーリンのイラストを描いていただけませんでしょうか？\n渋さ、怒り、絶望感など、表情も少し欲しいです。\n\n例として、こんな感じのインパクトのあるセックスがあれば最高です！\nhttps://skeb.jp/@hamacha_free/works/186\n\nこのようなアングルや視点で、ナズーリンがラフな後背位セックスを体験しているところを見たいです： \nhttps://twitter.com/elyaps18/status/1434859205727379456\n\nまた、腕を掴まれ、この体勢でセックスするナズーリンも見てみたいです：\nhttps://amechan9371.fanbox.cc/posts/5096323\n\nありがとうございました！\n\n無理にとは言いませんが、体液まみれで疲れ切ったナズーリンのアフターセックスの絵を描いていただけると、すごい嬉しいです......。\n\nナズーリンにこれだけのセックスを強要するのは、とてもエロい...。", "created_at": "", "completed_at": ""}, {"path": "/@ashinochimado/works/19", "thumbnail_src": "https://si.imgix.net/e838aea9/uploads/origins/4f834658-9729-4ca3-8b56-e23fa84289cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d44a5497d7c2d12122218c662b400557", "thumbnail_srcset": "https://si.imgix.net/e838aea9/uploads/origins/4f834658-9729-4ca3-8b56-e23fa84289cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d44a5497d7c2d12122218c662b400557, https://si.imgix.net/e838aea9/uploads/origins/4f834658-9729-4ca3-8b56-e23fa84289cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d646d54f7a683c5e4c0a867f0eb73ba 2x, https://si.imgix.net/e838aea9/uploads/origins/4f834658-9729-4ca3-8b56-e23fa84289cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8208ff1585ec9dc905c4e5e302235e72 3x", "genre": "art", "nsfw": true, "body": "こんにちは 足乃ちまどさん\nお元気でお過ごしでしょうか！\n私のリクエストなのですが、以下のようなシチュエーションでナズーリンのイラストを描いていただけませんでしょうか？\nhttps://skeb.jp/@kanichiri/works/43\nそれとは別に、ナズーリンが全裸でみんなにさらされている写真もまたお願いしたいです！\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@ashinochimado/works/18", "thumbnail_src": "https://si.imgix.net/e6492614/uploads/origins/df06f3df-3072-43b1-a47a-4c02c1515e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b8296fcf39ae324e4d0892b3af8b2b", "thumbnail_srcset": "https://si.imgix.net/e6492614/uploads/origins/df06f3df-3072-43b1-a47a-4c02c1515e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b8296fcf39ae324e4d0892b3af8b2b, https://si.imgix.net/e6492614/uploads/origins/df06f3df-3072-43b1-a47a-4c02c1515e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3523fe6bd168cd5db7b74f7803436555 2x, https://si.imgix.net/e6492614/uploads/origins/df06f3df-3072-43b1-a47a-4c02c1515e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c471506b0d82e80b9bbf4fe45de8e257 3x", "genre": "art", "nsfw": true, "body": "こんにちは。リクエストなのですが、ナズーリンが激しいセックスをしているところを、こういう形で描いていただけないでしょうか？定点カメラ\nhttps://www.pixiv.net/en/tags/%E5%AE%9A%E7%82%B9%E3%82%AB%E3%83%A1%E3%83%A9/illustrations?p=1\n全てお任せしますが、最後のコマはレイプ目とのナズーリンも入れていただけると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@ashinochimado/works/17", "thumbnail_src": "https://si.imgix.net/d64145ff/uploads/origins/a3834ca3-2a7e-41fb-9fc8-e226befb6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf416ed9760e032f1ff42455fca27f6", "thumbnail_srcset": "https://si.imgix.net/d64145ff/uploads/origins/a3834ca3-2a7e-41fb-9fc8-e226befb6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf416ed97