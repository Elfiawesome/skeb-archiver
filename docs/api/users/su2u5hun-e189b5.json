e3211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29b9f8eb093605954f123167773d3869, https://si.imgix.net/bf96d71a/uploads/origins/9e7c1e79-690a-4415-887c-4058b2be3211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fe562a6f4641a6f0b5078f70a7976dc 2x, https://si.imgix.net/bf96d71a/uploads/origins/9e7c1e79-690a-4415-887c-4058b2be3211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0da9d59bf9fc4fcf08539c2692a1f87d 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。\n前回の依頼がとても良かったので、今回も私のオリジナルキャラクターであるレヴィアと、ファイアーエムブレムのベルナデッタでお願いしたいです。そのシーンは、ベルナデッタがレヴィアにフェラチオをしようとしているのですが、レヴィアのペニスが大きすぎて困っている。そして、そのペニスを口に含む。そして、さらに彼のペニスを喉に押し込み、彼が彼女の中で射精する。レヴィアは、彼女の口の中に大量の精液を射精し、彼女のお腹は丸く満腹になる。\n\nhttps://twitter.com/VonGerth/status/1409134029727703045?s=20&t=Bzt37aByQvmGAXG2CrE6VQ\nhttps://twitter.com/VonGerth/status/1531282894156865541?s=20&t=Bzt37aByQvmGAXG2CrE6VQ\n\nこの度はお時間をいただき、誠にありがとうございました。またご一緒にお仕事ができればと思います", "created_at": "", "completed_at": ""}, {"path": "/@su2u5hun/works/29", "thumbnail_src": "https://si.imgix.net/d2d6a5c6/uploads/origins/52a255dd-1c32-44a0-ab8f-b23d53de6e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea709371061feac37539929c788429c8", "thumbnail_srcset": "https://si.imgix.net/d2d6a5c6/uploads/origins/52a255dd-1c32-44a0-ab8f-b23d53de6e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea709371061feac37539929c788429c8, https://si.imgix.net/d2d6a5c6/uploads/origins/52a255dd-1c32-44a0-ab8f-b23d53de6e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41184c5280f5976a83c228fe37fbd923 2x, https://si.imgix.net/d2d6a5c6/uploads/origins/52a255dd-1c32-44a0-ab8f-b23d53de6e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba497014c58c204239d81714c36c5acf 3x", "genre": "art", "nsfw": true, "body": "リクエストおねがいします。\n\n女の子に催眠または憑依でスイーツ責めにし太らせてデブになる漫画をおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@su2u5hun/works/28", "thumbnail_src": "https://si.imgix.net/b6f0c6cd/uploads/origins/657fe19e-a580-478c-8316-010eb5823f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64e24669f17744c26e8a5e129edfcfbc", "thumbnail_srcset": "https://si.imgix.net/b6f0c6cd/uploads/origins/657fe19e-a580-478c-8316-010eb5823f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64e24669f17744c26e8a5e129edfcfbc, https://si.imgix.net/b6f0c6cd/uploads/origins/657fe19e-a580-478c-8316-010eb5823f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a40243aef25d91a3100570ec60c4f497 2x, https://si.imgix.net/b6f0c6cd/uploads/origins/657fe19e-a580-478c-8316-010eb5823f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42526af66a6afba3d3d21f093bc30c83 3x", "genre": "art", "nsfw": true, "body": "初めまして！依頼をお願いしたいです。\n女の子に憑依した主人公が、喜び勇んでオナニーしていたら突然女の子の彼氏がやってきて、「おいおい、欲求不満なのか？」と言われてそのままセックスに突入してしまう漫画作品をお願いしたいです！", "created_at": "", "completed_at": ""}, {"path": "/@su2u5hun/works/27", "thumbnail_src": "https://si.imgix.net/76de0a41/uploads/origins/16364b65-14c5-4273-aee7-fc2d224d33e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eaf9f86a7a63cd0358648b2d1b321b7a", "thumbnail_srcset": "https://si.imgix.net/76de0a41/uploads/origins/16364b65-14c5-4273-aee7-fc2d224d33e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eaf9f86a7a63cd0358648b2d1b321b7a, https://si.imgix.net/76de0a41/uploads/origins/16364b65-14c5-4273-aee7-fc2d224d33e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98479ff2fffd416056250f11f021572f 