6a-373c86a0805a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=787719f5bba6a6f6ca2805c48bc76baa, https://si.imgix.net/621035c8/uploads/origins/7eeaddc7-2d01-49f2-9e6a-373c86a0805a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28e49809a4f8b444fb26114851a73df0 2x, https://si.imgix.net/621035c8/uploads/origins/7eeaddc7-2d01-49f2-9e6a-373c86a0805a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92b507d984f07e47828d3052f59aa6ff 3x", "genre": "art", "nsfw": true, "body": "以前はうちの子ありがとうございました、漫画形式良かったです\n\npixiv辞典のページを資料にします、ブルーアーカイブのイブキをお願いします。\n\n\n以下要素を含め、描きやすい様にお願いします。\n\n無知シチュ系、かわいい水着着用のイメージビデオ的な撮影(アイス舐め等)\n「なんかスカウト？されちゃったー！せんせー、見てるー？？」\n\n…とAV撮影(先生には秘密でハードな連続中だし系)\n\n複数の竿役から全身、前も後ろも玩具のように使われる様子\n\nお尻ごとくぱぁされて前後から出された液体を見せつける様子\n\n「明日も来てね、それまで剥がしちゃ駄目だよ」と漏れないように前貼りを貼られる様子\n\n新しい遊びを覚えた様に輪姦を楽しんでる様子\n(楽しんではいるが、自発的に騎乗等はせず、振りまわっされぱなしの様子)\n\nhttps://dic.pixiv.net/a/%E4%B8%B9%E8%8A%B1%E3%82%A4%E3%83%96%E3%82%AD", "created_at": "", "completed_at": ""}, {"path": "/@su2u5hun/works/55", "thumbnail_src": "https://si.imgix.net/21eb2050/uploads/origins/73574460-7e09-4102-a4e6-614c557db09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c322c4210529b658038668bc922ab26c", "thumbnail_srcset": "https://si.imgix.net/21eb2050/uploads/origins/73574460-7e09-4102-a4e6-614c557db09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c322c4210529b658038668bc922ab26c, https://si.imgix.net/21eb2050/uploads/origins/73574460-7e09-4102-a4e6-614c557db09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7953d44fa17c56b8552c4b642366335 2x, https://si.imgix.net/21eb2050/uploads/origins/73574460-7e09-4102-a4e6-614c557db09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca635df548c23a3c7e990f3ec83478bc 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつもお世話になってます〜。\n今回はvrchatの私のイラストを描いていただきたいです。、服装は資料内の青のミニスカートの制服（ピンクのブーツを履いてるやつです）髪型はいつものちょっとウェーブのかかったピンク髪ロング。表情はちょっと生意気な感じで。あとはお任せします！\n\n今回は一般向けイラストでお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1md9AgOvE00ViA-p5_usWt_8z4s_l_5x-?hl=jad", "created_at": "", "completed_at": ""}, {"path": "/@su2u5hun/works/54", "thumbnail_src": "https://si.imgix.net/c3746fa7/uploads/origins/a3b48013-0108-4c57-b10b-6af66a9031e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a86a371fb5343545bf9dee5fd6b5562", "thumbnail_srcset": "https://si.imgix.net/c3746fa7/uploads/origins/a3b48013-0108-4c57-b10b-6af66a9031e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a86a371fb5343545bf9dee5fd6b5562, https://si.imgix.net/c3746fa7/uploads/origins/a3b48013-0108-4c57-b10b-6af66a9031e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d286c2adf7bd4e505be9e633321cac6 2x, https://si.imgix.net/c3746fa7/uploads/origins/a3b48013-0108-4c57-b10b-6af66a9031e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2aa941b4ecb6b057232ccbc3c0262f4 3x", "genre": "art", "nsfw": false, "body": "イラストの依頼でリクエストを送りました\nメーダイサンです\n\n来月頃を目処に「むにひめVSメーダイサン」という動画\n（むにひめさんをイメージしたオリジナル曲とAI楽曲を繋げて動画にする予定）\nなんですが、その際に動画で使用する背景画像（静止画イラスト）を依頼したいです\n\nこちらのイメージでは、むにひめ*さんとメーダイサンが対峙してるイメージのイラストで、むにひめ*さんはむにひめ*さんのTwitterのアイコンのイメージ、メーダイサンもメーダイサンのTwitterのアイコンのイメージです\nその他の部分に関してはあまりイメージできていません\n\nご依頼可能でしたら、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@su2u5hun/works/53", "thumbnail_src": "https://si.imgix.net/7ca28595/uploads/origins/73168895-fd5f-4b4e-b024-941f33e8d6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ba710a18a4afe0c9f88315e3a068be", "thumbnail_srcset": "https://si.imgix.net/7ca28595/uploads/origins/73168895-fd5f-4b4e-b024-941f33e8d6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ba710a18a4afe0c9f88315e3a068be, https://si.imgix.net/7ca28595/uploads/origins/73168895-fd5f-4b4e-b024-941f33e8d6bd?