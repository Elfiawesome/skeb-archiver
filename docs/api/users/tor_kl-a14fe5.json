968f27294c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=545d52cf8a8dd164412f2dde640780c7, https://si.imgix.net/1f28f6ed/uploads/origins/84af28b9-0cff-4e12-9937-968f27294c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8857ebae6f1882cadad79fc77e61c9b7 2x, https://si.imgix.net/1f28f6ed/uploads/origins/84af28b9-0cff-4e12-9937-968f27294c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c0f259517bc06545d7a64054814ea4b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして、虎黒くめづさん。\n私はTwitterであなたの作品を長い間拝見しており、あなたの絵柄がとても可愛くて大好きです！\nずっと機会があれば、ぜひイラストを依頼したいと思っていました。\n\nもしご縁があり、依頼をお受けいただけるのであれば、私のキャラクターを描いていただきたいです。\n\nテーマは「星」や「星空」に関するものが希望です。\nポーズ、表情、背景などは、すべておまかせしたいと思います！\n\nキャラクターと衣装の参考画像は、リンクにまとめてありますので、ご確認いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/12TF-rJZNIdTtdZ-NT295XktWV8NelJi4?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tor_kl/works/113", "thumbnail_src": "https://si.imgix.net/09418eb3/uploads/origins/9e8c728e-81d4-43ce-8636-031cfa7a9867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3b64320c6d029c415fec283fb23e71c", "thumbnail_srcset": "https://si.imgix.net/09418eb3/uploads/origins/9e8c728e-81d4-43ce-8636-031cfa7a9867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3b64320c6d029c415fec283fb23e71c, https://si.imgix.net/09418eb3/uploads/origins/9e8c728e-81d4-43ce-8636-031cfa7a9867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=332669bd3a86b51f22305d88acadb6ba 2x, https://si.imgix.net/09418eb3/uploads/origins/9e8c728e-81d4-43ce-8636-031cfa7a9867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4def181a3c4e40f5230aa8df831a0694 3x", "genre": "art", "nsfw": false, "body": "虎黒くめづ 様\nこんにちは、逢天クルミです。\n今回はキャラデザをしていただいたケイカちゃんの可哀想可愛いイラストを描いて頂きたく初めての依頼を送らせていただきました。\n\n内容としてはケイカちゃんがぬいぐるみの置いてある自室で泣きじゃくっているようなシュチュエーションをお願いしたいです。その他の詳細に関してはおまかせします。\n\nくめづさんの描く可哀想可愛いケモノさんのイラストには他では得られない素晴らしさをとても感じており、キャラデザ本家様にお願いしたいと常々思っていました。\n\n受けてくださるととても嬉しく思います。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/158GhOXixwDAdxuKZur7VCKhBytLimxT4", "created_at": "", "completed_at": ""}, {"path": "/@tor_kl/works/112", "thumbnail_src": "https://si.imgix.net/dfc216dc/uploads/origins/5c16c913-d7fc-45ad-933d-3c40a73d9520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69151cc4aba7214a67bdf8f424844242", "thumbnail_srcset": "https://si.imgix.net/dfc216dc/uploads/origins/5c16c913-d7fc-45ad-933d-3c40a73d9520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69151cc4aba7214a67bdf8f424844242, https://si.imgix.net/dfc216dc/uploads/origins/5c16c913-d7fc-45ad-933d-3c40a73d9520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30cf55f49221427416cfd76ed7b8897d 2x, https://si.imgix.net/dfc216dc/uploads/origins/5c16c913-d7fc-45ad-933d-3c40a73d9520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=865a3493ec5aaa04fded832167171776 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のOCに、以前描いていただいたような冬の服を着せていただけませんか？あとはお任せしたいので、よろしくお願いします！\n\nhttps://drive.google.com/file/d/15hTW4bWzmH99i9BVrqPDxFC3GsINLCAy/view?usp=drive_link\n\nhttps://x.com/tor_kl/status/1870044746288378331?t=z-FLOtPtNFfT9uA0DADa0Q&s=19", "created_at": "", "completed_at": ""}, {"path": "/@tor_kl/works/111", "thumbnail_src": "https://si.imgix.net/429320e7/uploads/origins/9739929a-04c8-42f2-bb27-c96588a2e599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530dbea9a6192f387cbb8caaad96995b", "thumbnail_srcset": "https://si.imgix.net/429320e7/uploads/origins/9739929a-04c8-42f2-bb27-c96588a2e599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530dbea9a6192f387cbb8caaad96995b, https://si.imgix.net/429320e7/uploads/origins/9739929a-04c8-42f2-bb27-c96588a2e599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop