4-7a777f5ddc5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2987161618ce17a34dee15ee76a4d6b3 2x, https://si.imgix.net/265937d8/uploads/origins/a0a248b2-d64c-4f0b-bbc4-7a777f5ddc5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4f21390d6ebd4b1d8beb1e362106b43 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ するがさん。\nはじめまして、VRChatできつねのバーチャルお姉ちゃんをやっていますSANSYOといいます。当方がVRChatで使用しているアバター、SANSYOのイラストをお願します。\n\nするがさんの描く、やわらかくモチモチとしたボディのイラストが好きで、元気いっぱいながらもおちついて包容力のある雰囲気と表情がたまりません！ Skebのイラストもたくさんあげられていて憧れでいましたがついにリクエストさせていただきました。\n\nポーズは立ち姿勢で全身が映っているものがよいです。\n立ち姿勢といっても（artworks/107817080）のようにするがさんが思いつくままに動かしていただいて大丈夫です。過去投稿でなにか都合の良いものやポーズがあればそれらの流用でも構いません。表情はアイコンにしていらっしゃるような明るめの感じで、開口でお願いします。胸はハリのある丸い感じで、胸もふともももいつも通りモチモチ盛りにしていただければうれしいです。\n※もし「これでは全身でなく上半身になってしまうよ」となりましたら胸部を見せつけるようなポーズにしていただければ。\n\nまた服の構造につきまして、軽く寄せて胸部分を大きく見せるなどする場合、白色ではなく黒色の布地の部分が伸びておおきくなりますのでご参考に。黒色の薄いほうのインナーも開口部も自在に伸びますのでお好みで引っ張ったり触ったりしてみて大丈夫です。\n視点の高さはアイレベルになるとおもいます。当方巨大娘のジャンルで活動しているので念のためなのですが、身長は等身大（人間と同じ）で想定しています。\n\n\n「キャラ単体レイヤー表示（アルファ透過で抜いての使用）」や「印刷してお届け機能」を使用するかもしれませんので完成品は下辺を除く３辺または４辺から耳や尻尾が見切れないように、また、バーチャルお姉ちゃん SANSYO の文字入れをキャラにかぶらない位置にお願いします。※「へ」は不要です。\n\nhttps://twitter.com/LiSansyo/status/1621211401665777664", "created_at": "", "completed_at": ""}, {"path": "/@XsurugaX/works/140", "thumbnail_src": "https://si.imgix.net/f45abe48/uploads/origins/a0a2bbc0-ea07-493a-8cbd-c08174c5f82a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b0cd62b0c4d46d0158bbd1dfb5d9311", "thumbnail_srcset": "https://si.imgix.net/f45abe48/uploads/origins/a0a2bbc0-ea07-493a-8cbd-c08174c5f82a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b0cd62b0c4d46d0158bbd1dfb5d9311, https://si.imgix.net/f45abe48/uploads/origins/a0a2bbc0-ea07-493a-8cbd-c08174c5f82a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bac9ca3e08b7e8832e1876f411e883df 2x, https://si.imgix.net/f45abe48/uploads/