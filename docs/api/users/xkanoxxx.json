3a7c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baac9ee78fade06207df3fc98bc3c972, https://si.imgix.net/4efbdb28/uploads/origins/8ff92eaf-b77a-46ef-bdc5-e3e2023a7c31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edc8ff70892d21e3c9043388d14ee86e 2x, https://si.imgix.net/4efbdb28/uploads/origins/8ff92eaf-b77a-46ef-bdc5-e3e2023a7c31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5b0e8a7a80f897f6e43518bdfcb76e0 3x", "genre": "art", "nsfw": false, "body": "紲星あかりちゃんの誕生祭の絵のセンター分けの髪型（https://x.com/haino/status/2002359168607617297）の大人っぽさにぐっと来てしまったので、この髪型でリクエストお願いします。\nショート丈の羽織と袴スカート（https://x.com/misamaru_kimono/status/1891094506457481688）を着て、文倉先生の上記の絵のようなセンター分けの髪型で、大人っぽく片手を胸に当て、もう一方の手をこちらに差し出しているようなポーズの紲星あかりちゃんをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@xkanoxxx/works/52", "thumbnail_src": "https://si.imgix.net/94a86add/uploads/origins/ab2ab61f-f338-45cb-a033-e6ad85dbc9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1c3ec9128b951d498d9b6c8770a39d", "thumbnail_srcset": "https://si.imgix.net/94a86add/uploads/origins/ab2ab61f-f338-45cb-a033-e6ad85dbc9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1c3ec9128b951d498d9b6c8770a39d, https://si.imgix.net/94a86add/uploads/origins/ab2ab61f-f338-45cb-a033-e6ad85dbc9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20a64c43f356a833cdc52dc756ac257e 2x, https://si.imgix.net/94a86add/uploads/origins/ab2ab61f-f338-45cb-a033-e6ad85dbc9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e80ac98ca04879fcddab95c16a535d8 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n前回もとっても可愛らしくうちの子を描いていただき、ありがとうございました。\n\nまた描いていただきたくて、リクエストしてみます。\nよろしければまたおねがい致します！\n\n◆うちの子はこちらです\nhttps://drive.google.com/file/d/16vikjG8P1oxZFRF-dGhretlnrTuZyZzL/view?usp=sharing\n\n◆衣装はこちらでお願いします。\nhttps://drive.google.com/file/d/1wD2Zbid7bc0w7f0JXzf0c4o8OeDOgy2r/view?usp=sharing\n\n構図やシチュエーションはお任せ致します。\n可愛らしく描いていただけたら嬉しいです。\n\n可能でしたら、背景分離など可能なPSDで頂けると嬉しいです！\n\nうちの子カワイイさせていただけましたら嬉しいです。\nよろしければ。", "created_at": "", "completed_at": ""}, {"path": "/@xkanoxxx/works/51", "thumbnail_src": "https://si.imgix.net/95d21754/uploads/origins/c0c42d44-537c-44f1-a98c-924a4cd3631a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec53135c2d852eea4a0101fc61e18b9", "thumbnail_srcset": "https://si.imgix.net/95d21754/uploads/origins/c0c42d44-537c-44f1-a98c-924a4cd3631a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec53135c2d852eea4a0101fc61e18b9, https://si.imgix.net/95d21754/uploads/origins/c0c42d44-537c-44f1-a98c-924a4cd3631a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4794183a3a0b69cc00f32534bb30c56 2x, https://si.imgix.net/95d21754/uploads/origins/c0c42d44-537c-44f1-a98c-924a4cd3631a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebd6a6434e0b35990df17cb90a3dccc2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nVtuberの作品をお願いしたいです。モルモットのVtuber、Sopraltoを描いてください。この作品では、彼女がベッドの上であぐらをかいているところを描いてください。飼い猫のタピは膝の上で丸くなってすやすや眠っているはずです。眠っている猫を撫でながら、ソプラルトは幸せそうに微笑んでいるはずです。服装は、ショートパンツとTシャツのシンプルなセットでお願いします。\n\nご配慮ありがとうございます！\nサムネイルなどに使用したいとのことですので、NGの場合はお断りください。\n\nソプラルトの参考文献\nhttps://pbs.twimg.com/media/GocuD-qWsAAkILg?format=jpg&name=large\nhttps://pbs.twimg.com/media/GocBMczXMAAg2S9?format=jpg&name=large\nhttps://pbs.twimg.com/media/GmGwYmeWEAAXhFz?format=jpg&name=large\nhttps://pbs.twimg.com/media/Gl3VsCuWUAAHgqJ?format=jpg&name=large\n\nタピの参考文献\nhttps://files.catbox.moe/tnh7st.png\nhttps://files.catbox.moe/2ruxj3.png\nhttps://files.catbox.moe/ixmjjq.png", "created_at": "", "completed_at": ""}, {"path": "/@xkanoxxx/works/50", "thumbnail_src": "https://si.imgix.net/f0ac283c/uploads/origins/9f596d18-b7df-48fc-ba91-c477304735f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a8e75e5eaceaa024d27b1b1cd2430c", "thumbnail_srcset": "https://si.imgix.net/f0ac283c/uploads/origins/9f596d18-b7df-48fc-ba91-c477304735f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a8e75e5eaceaa024d27b1b1cd2430c, https://si.imgix.net/f0ac283c/uploads/origins/9f596d18-b7df-48fc-ba91-c477304735f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f1b211a915364334abd451849560d47 2x, https://si.imgix.net/f0ac283c/uploads/origins/9f596d18-b7df-48fc-ba91-c477304735f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93f0e6ecfb5b69621921288146bb953c 3x", "genre": "art", "nsfw": false, "body": "にじさんじGTAのエニグマのコスプレをしているゆかりさんとマキさんのイラストをお願いします。\nゆかりさんが葛葉のグレー目なチャイナ服を着ていて、マキさんは髪をアップにしてフレンの黒字に赤い花柄のチャイナドレスを着ている感じのイラストでお願いします（https://w.atwiki.jp/nijigta/pages/134.html）", "created_at": "", "completed_at": ""}, {"path": "/@xkanoxxx/works/49", "thumbnail_src": "https://si.imgix.net/a03475b5/uploads/origins/5cb64622-3716-43ee-a17e-6f8324c04b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5cc5d82aaf9258be35bb122a3c5fb8b", "thumbnail_srcset": "https://si.imgix.net/a03475b5/uploads/origins/5cb64622-3716-43ee-a17e-6f8324c04b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5cc5d82aaf9258be35bb122a3c5fb8b, https://si.imgix.net/a03475b5/uploads/origins/5cb64622-3716-43ee-a17e-6f8324c04b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcbf089e1b32ee900faa3f350c4590ce 2x, https://si.imgix.net/a03475b5/uploads/origins/5cb64622-3716-43ee-a17e-6f8324c04b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=635aedac7e6e3943cf6ee0b1004c2b78 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@xkanoxxx/works/48", "thumbnail_src": "https://si.imgix.net/f3349da5/uploads/origins/a5e67f19-c5d8-42e1-ab3c-cd6fec70ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=837965798817c25c5e5cefafb190e5d8", "thumbnail_srcset": "https://si.imgix.net/f3349da5/uploads/origins/a5e67f19-c5d8-42e1-ab3c-cd6fec70ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=837965798817c25c5e5cefafb190e5d8, https://si.imgix.net/f3349da5/uploads/origins/a5e67f19-c5d8-42e1-ab3c-cd6fec70ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae1e6f841499e56c742e1f7b4c243e25 2x, https://si.imgix.net/f3349da5/uploads/origins/a5e67f19-c5d8-42e1-ab3c-cd6fec70ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=633f6d552e14f6237d7e5acd1865380a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のOC、タミーのコミッションをお願いしたいのですが。\n彼女の画像を添付します。\n\n彼女は九尾の狐です！彼女はキツネですが、彼女のしっぽは焦点ではありません。\n\n黒い寝間着を着てベッドに横たわり、ポケモンのロコンを抱きしめているところを描いてほしいです。(訳が間違っていたらごめんなさい！画像も載せておきます。）ロコンも喜んでくれたら嬉しいです！\n\nポーズとしては、仰向けになって腕を回している姿を想像していますが、あなたが一番似合うと思うポーズでもかまいません！\n\nhttps://drive.google.com/drive/folders/15pP0lTiDl7vhGjQmzIQJaFpoDLDXOM9s?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@xkanoxxx/works/47", "thumbnail_src": "https://si.imgix.net/ba9a6c6f/uploads/origins/a98ccd0b-6868-46fd-a10d-cb9548750b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77523f1f3804b068d1cf376b1ae5b738", "thumbnail_srcset": "https://si.imgix.net/ba9a6c6f/uploads/origins/a98ccd0b-6868-46fd-a10d-cb9548750b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txt