 https://si.imgix.net/e6cc304b/uploads/origins/976720df-419d-45fd-87ad-d3532a040ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f1a62b80af794dad04553643bf5b48e 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n突然ですがイラストのご依頼をさせて頂きたいと思いましたので、リクエストをお送りします。\n\nキャラクターはウマ娘のエイシンフラッシュをバニー衣装でお願いいたします。ポーズは前屈みで可能であればにんじん差分もお願いいたします。\n\n年末にかけてお忙しい中とは存じますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/55", "thumbnail_src": "https://si.imgix.net/9ce5d9fe/uploads/origins/98251c51-ce07-4e42-a63d-cde78e81dbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41e069ba637a7d21d1b4da11fa741190", "thumbnail_srcset": "https://si.imgix.net/9ce5d9fe/uploads/origins/98251c51-ce07-4e42-a63d-cde78e81dbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41e069ba637a7d21d1b4da11fa741190, https://si.imgix.net/9ce5d9fe/uploads/origins/98251c51-ce07-4e42-a63d-cde78e81dbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=305af4a159aaf603fc76cfc8527f50e9 2x, https://si.imgix.net/9ce5d9fe/uploads/origins/98251c51-ce07-4e42-a63d-cde78e81dbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=038a772ecb43a077af34acd9dbe25353 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/54", "thumbnail_src": "https://si.imgix.net/fcef429c/uploads/origins/f7b90340-7eda-4dec-b0cb-c42c0d08f33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b0058682aac70697f64561366c3941b", "thum