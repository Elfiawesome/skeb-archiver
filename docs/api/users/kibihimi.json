48-440e-9ffe-b72a297eaad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560fa2bdf2d4690539fafb19d3e4888a", "thumbnail_srcset": "https://si.imgix.net/daa95936/uploads/origins/24679d18-ee48-440e-9ffe-b72a297eaad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560fa2bdf2d4690539fafb19d3e4888a, https://si.imgix.net/daa95936/uploads/origins/24679d18-ee48-440e-9ffe-b72a297eaad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72698057f7a1b454829824feae905f31 2x, https://si.imgix.net/daa95936/uploads/origins/24679d18-ee48-440e-9ffe-b72a297eaad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b85e96c5aed48a4aeadd0cd9598d184 3x", "genre": "art", "nsfw": true, "body": "キャラ\nベアトリクス(グランブルーファンタジー)\n\n衣装\n下記資料のから、乳首を露出\nhttps://img.aucfree.com/l526261802.1.jpg\n\nシチュ\nグランとのイチャラブパイズリ\n“交互”ズリで、竿役視点\n竿が乳房に完全に埋まって“見えない”\n\n差分・セリフイメージ\n①速攻で射精させると自信満々にパイズリ\n②3分経過しても一向に射精しないので焦りだす(実はグランは限界寸前で射精を必死に堪えている)\n「早くイけよ！この、このっ！このぉ！！」と乳圧もペースも大幅アップする\n③超濃厚な乳内射精\n「あっ、あっつ…！！」と驚く\n④おっぱいを左右に開きザーメンブリッジを披露\nドヤ顔で「私のパイズリ気持ちよかっただろ？」\n\nその他\n・出来る範囲でいいので差分ごとにセリフがあると嬉しいです\n・差分ありかつ、④がベースから形が変化するリクエストなので、金額面で問題がありましたら条件付き再送をご検討ください\n\n\nお久しぶりです。ヴェルゼビュートネメシスのリスエストを送った者です。\nその節はありがとう御座いました。いつもどおりの活動に戻って良かったです。\nとてもエッチなおっぱいでしたので、またリクエストを送らせていただきます。\nどうかご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/48", "thumbnail_src": "https://si.imgix.net/9a774727/uploads/origins/a2989f1f-8629-4dbc-bdf5-3d15708e255a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=715985683b13a7e79d713ee149582a6f", "thumbnail_srcset": "https://si.imgix.net/9a774727/uploads/origins/a2989f1f-8629-4dbc-bdf5-3d15708e255a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=715985683b13a7e79d713ee149582a6f, https://si.imgix.net/9a774727/uploads/origins/a2989f1f-8629-4dbc-bdf5-3d15708e255a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b132dac86568fe7a86c48db5544ff3c 2x, https://si.imgix.net/9a774727/uploads/origins/a2989f1f-8629-4dbc-bdf5-3d15708e255a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ce4c1a0988c3f0ccbba79cc1cf1b8c8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/47", "thumbnail_src": "https://si.imgix.net/8540b9a1/uploads/origins/f2301fea-1acb-4f57-aaf4-17460a296ff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f96d05904c444918435d0df57f1c5a40", "thumbnail_srcset": "https://si.imgix.net/8540b9a1/uploads/origins/f2301fea-1acb-4f57-aaf4-17460a296ff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f96d05904c444918435d0df57f1c5a40, https://si.imgix.net/8540b9a1/uploads/origins/f2301fea-1acb-4f57-aaf4-17460a296ff9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75695e875346552d53279baabd620fc2 2x, https://si.imgix.net/8540b9a1/uploads/origins/f2301fea-1acb-4f57-aaf4-17460a296ff9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93a12cf69dbb4a43f46c76c456abcbb6 3x", "genre": "art", "nsfw": true, "body": "過去にプロセカの花里みのりのスク水イラストを依頼させていただいた者です。\n今回もプロセカの花里みのりのイラストをお願いしたいと思います。\n\n衣装:スク水\n・ベッドに仰向けで寝て腕は頭の上に\n・スク水ずらしでおっぱい丸出し(肩紐をずらして丸出しor谷間にスク水をずらして丸出し)\n・中出し事後、おっぱい・お腹辺りへの精液ぶっかけ(少量顔に付着も可)\n(中出し分の精液は溢れさせてください、ぶっかけの量は乳首が見える程度)\n・使用済みゴムがベッドに散乱していると嬉しいです\n・足はM字開脚\n・表情は満足気、嬉しそうに\n・竿役は不要です\n・おっぱいの盛り具合はおまかせします\n・セリフの有無もおまかせします\n(有りの際はセリフ無しの差分があると嬉しいです)\n\n長文になりましたが、何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/46", "thumbnail_src": "https://si.imgix.net/162dd214/uploads/origins/d91b1ce8-a421-4feb-9d6e-c145eb2ec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ed2e3bdd1ee56c413d5fc996010f9de", "thumbnail_srcset": "https://si.imgix.net/162dd214/uploads/origins/d91b1ce8-a421-4feb-9d6e-c145eb2ec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ed2e3bdd1ee56c413d5fc996010f9de, https://si.imgix.net/162dd214/uploads/origins/d91b1ce8-a421-4feb-9d6e-c145eb2ec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2965255b53b8f0982a2f22a871d5db7a 2x, https://si.imgix.net/162dd214/uploads/origins/d91b1ce8-a421-4feb-9d6e-c145eb2ec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf1335ecc3b1d4eb0e37ef2547ae73fa 3x", "genre": "art", "nsfw": false, "body": "こんにちは!!!\nもうすぐチャンネル登録者さんが400人近いので記念に1枚絵を描いていただきたく思います。\n\n◆希望イラスト\n黎歌 姫希(くろうた きき)のイラストをお願いします。\n※衣装のデザインが時期によってマチマチなので最下部に記載した、資料URLに貼った参考用最新衣装でお願いします\n\n◆キャラのイメージ\n見た目はミステリアスなお姉さんっぽいです\n話すと気さくな感じ、喋らなければ可愛いと言われるタイプ。\n身長は178cmくらい。\n独占欲が強い(重要)\n\n普段は明るい性格ですが記念なので普段とイメージを変えて怪しさと&いやらしさが混ざったダークっぽい？感じでお願いします。\n\n胸は大きくチャームポイントなので目立つように描いていただけると嬉しいです。\nデザインによってはシャツを着てますが今回のイラストではシャツ無し(つまり資料URL)ではだけた状態でお願いします。\n\n胸のサイズ感は先生が描かれている絵のようなイメージ\n↓\nhttps://twitter.com/kibihimi/status/1743936367225364483?t=k9yRlLUHV8HTQlObZGZvAA&s=19\n\n◆ポーズのイメージ\n少し小悪魔っぽい感じで相手を見つめているイメージ。\n口元に手を添えてたりすると良い感じです。\n\n上記さえ満たせていればあとは好きにポーズ描いていただければと思います。\n\n◆背景\n指定無しおまかせ\nあると嬉しいですが無くても構いません。\n\n◆その他\n厳密に「こうでなければいけない」みたいな設定が黎歌 姫希には無いので盛ったりムチムチさせたりするのは全然ありです。\nその他は全て描きたいように任せます！\n\n色に関しても色味が変わるくらいであれば自由にしていただいて大丈夫です。\n※赤色が青色とか別の色にならなければOK\n※参考用のクルクルツインテール部分は影が付いているだけでツートンカラーではないです\n\n各パーツの色についてはモデルよりもXの固定ポストのファンアートイラストを参考にしていただければと思います。\n\nhttps://twitter.com/utahime00/status/1732015631040700751?t=fSqMa6nXmRRCDDUGLBSy7g&s=19\n\nその他、skebの利用規約・ガイドに従います。\n以上、よろしくお願いします🙇‍\n\nhttps://twitter.com/utahime00/status/1767139133393408320?t=Glj5eoZjSyIpmOvuVRN5SQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/45", "thumbnail_src": "https://si.imgix.net/034e67ed/uploads/origins/2de9d63f-f889-48da-966b-4cc77a3f97d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37e753a4b4a4d7e8b63cfcbadd8a032b", "thumbnail_srcset": "https://si.imgix.net/034e67ed/uploads/origins/2de9d63f-f889-48da-966b-4cc77a3f97d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37e753a4b4a4d7e8b63cfcbadd8a032b, https://si.imgix.net/034e67ed/uploads/origins/2de9d63f-f889-48da-966b-4cc77a3f97d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6354fc30512ca46f474dc658f6978235 2x, https://si.imgix.net/034e67ed/uploads/origins/2de9d63f-f889-48da-966b-4cc77a3f97d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=810b67d35f3a3618a745530289a12377 3x", "genre": "art", "nsfw": true, "body": "ひみ先生\n\nいつもお世話になっております。\n\n今回依頼させていただきたいのは、\n井之原小星のR18イラストです。\n\nシチュエーションとしては、\n以前FANBOXでアンケートを取った際に描いていたメイド衣装の柏木咲姫と同じようなシチュエーションでお願いしたいです。\n\n詳細は以下の通りです。\n\n・体位\n後ろ矢筈\n具体的に、片腕を掴まれて片腕は壁についているような状態でお願いします。\n可能であれば、片乳を鷲掴みされている描写も別途いただけると嬉しいです。\n\n・おっぱい\n件の咲姫のパフィーニップル具合がとても好きなのでパフィーニップルと、咲姫より少し長乳で乳首が少し長く太くしていただきたいです\n\n・その他\n太ももとお尻は大きくしていただきたいです。\n\n衣装について\n色ラフにあったような衣装によって抑え付けられていたおっぱいが解放されて衣装より少し大きく長い乳があらわになる様子が好きなので、その差分をお願いしたいです。\nまた、着衣時は乳首が浮いている状態と浮いていない状態、乳がまろび出ている状態の3パターンをいただきたいです。\n\n描写\n\n1.挿入中の膣内の描写とともに、行為を行なっている様子\n\n表情\n気持ち良さより困惑と恐怖がでているような、困り眉をベースとした表情にしていただきたいです。\n\n\n2.中出しをされている様子\n\n表情\n目はアヘ顔のようになり、口はベロを出して涎が垂れている様子でお願いしたいです。\n\nその他\n喘ぎ声は濁点がつくような汚い感じでお願いします。\n母乳が沢山出ている差分をいただきたいです。\n\n3.事後\n\n表情\nおまかせ\n\n事後も甘イキしており、かなり多くの精液が垂れ流され、足が震えている様子をお願いします。\n\n母乳が垂れ流されている差分もいただきたいです。\n\nまた、可能であればで構いませんので差分に色ラフを残していただけますと大変嬉しいです。\n\n以上、ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/44", "thumbnail_src": "https://si.imgix.net/a9010eaa/uploads/origins/9efda319-a977-4e53-af7f-cdcb1deed07f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb10cd42950c318479f0dda0c0505a51", "thumbnail_srcset": "https://si.imgix.net/a9010eaa/uploads/origins/9efda319-a977-4e53-af7f-cdcb1deed07f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb10cd42950c318479f0dda0c0505a51, https://si.imgix.net/a9010eaa/uploads/origins/9efda319-a977-4e53-af7f-cdcb1deed07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f5267459d57b4a15ad587e0b945558e 2x, https://si.imgix.net/a9010eaa/uploads/origins/9efda319-a977-4e53-af7f-cdcb1deed07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cada8b46e8460348375348767e1e0da 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/43", "thumbnail_src": "https://si.imgix.net/a3ad2306/uploads/origins/cdd329bf-43f9-42d1-9a9c-360c82b982fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719a64b24b95078a977f48216986880b", "thumbnail_srcset": "https://si.imgix.net/a3ad2306/uploads/origins/cdd329bf-43f9-42d1-9a9c-360c82b982fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719a64b24b95078a977f48216986880b, https://si.imgix.net/a3ad2306/uploads/origins/cdd329bf-43f9-42d1-9a9c-360c82b982fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=883cc1dd1babd0266011307b4b61f266 2x, https://si.imgix.net/a3ad2306/uploads/origins/cdd329bf-43f9-42d1-9a9c-360c82b982fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8feaf84faf30a6f3b5a8c81223b134ad 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます。\nプロジェクトセカイより花里みのりのイラストをお願いしたいです。\n衣装としては女児服をお願いしたいです。色はピンク系統でいかにもガーリーな感じ、ニーソックス直用、ちっちゃめのサイズで少しパツパツ気味、スカートはスカートの意味を成してないぐらい下を隠しきれていないようなサイズのものを着用していてほしいです。　\n衣装の雰囲気としては別の方に依頼した時のものですが、資料URLのイラストのような雰囲気だと嬉しいです。細かいデザインの指定はありませんので自由に描いていただいて大丈夫です。\n\n\nシチュエーションとしては以前描かれていましたライザやラブライブ!の穂乃果ちゃんのような構図の騎乗位でお願いしたいです。女児服を着ながらエッチなことをすることによる羞恥もありつつイチャラブな感じだと嬉しいです。\n\nよろしければ承認のほどよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/97922253", "created_at": "", "completed_at": ""}, {"path": "/@kibihimi/works/42", "thumbnail_src": "https://si.imgix.net/c0ed5348/uploads/origins/ad2888d8-179d-4a47-aeda-8c761c420c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec0b4f7d325df06acea105d48e02ea8", "thumbnail_srcset": "https://si.imgix.net/c0ed5348/uploads/origins/ad2888d8-179d-4a47-aeda-8c761c420c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec0b4f7d325df06acea105d48e02ea8, https://si.imgix.net/c0ed5348/uploads/origins/ad2888d8-179d-4a47-aeda-8c761c420c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ec40eb4303e73c9a0a2c3a86ec83a06 2x, https://si.imgix.net/c0ed5348/uploads/origins/ad2888d8-179d-4a47-aeda-8c761c420c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74a3fe49f53f0bf824237036e0379e77 3x", "genre": "art", "nsfw": true, "body": "ひみ先生ご無沙汰しております。以前ネグリジェライザをご依頼させて頂いたものです！\nふと気づけばネグリジェライザのフィギュアがもうすぐ発売だなって事もありまして（発売タイミングがどんどんズレていってますが……）\nよければ前回のライザのイラストの続きのようなえちイラストをお願いできませんでしょうか。\n※マニアックですがボテ腹希望になります。ご無理ならキャンセル頂けますと幸いです！\n\nシチュとしてはあの後もエッチしまくった結果妊娠し妊婦になったライザとピロートークなシチュで、\nエッチ後なイメージで汗だくネグリジェを来た状態で参考構図のような\n・横に座り大きなお腹を大事そうに撫でながらコチラを見ている\n・添い寝して大事そうにお腹を撫でながらコチラを見ている\nどちらか先生のお好きなシチュでイラストをお願いできませんでしょうか。\n（可能であれば差分としておっぱいを弄られ噴乳する差分があると嬉しいですが、なくても構いません）\n\n▼参考構図\nhttps://skeb.jp/@kensuke_illust/works/15\nhttps://skeb.jp/@soanote/works/6\n\nできれば台詞をお願いしたく、以下のような雰囲気でおじさんにまた求婚されて、\n満更でもなさそうな感じのシチュエーションの台詞