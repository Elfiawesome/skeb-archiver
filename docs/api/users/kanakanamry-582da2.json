compress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22d33e3f29f314b1b4f16f0009b8747d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kanakanamry/works/13", "thumbnail_src": "https://si.imgix.net/6e75d49b/uploads/origins/4bc0f854-5a26-46e3-8204-a1ba928566c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52662b144922605c4267a7868b781096", "thumbnail_srcset": "https://si.imgix.net/6e75d49b/uploads/origins/4bc0f854-5a26-46e3-8204-a1ba928566c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52662b144922605c4267a7868b781096, https://si.imgix.net/6e75d49b/uploads/origins/4bc0f854-5a26-46e3-8204-a1ba928566c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b7a90d2a0b7e4492b98b8f988871e36 2x, https://si.imgix.net/6e75d49b/uploads/origins/4bc0f854-5a26-46e3-8204-a1ba928566c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d85fabd6ad3b237582808fb7767493e 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nくらたろうさんの絵柄で我が家のOCであるゼニアの私服姿が見てみたいです\n【服装】\n・黒カラーのオフショルダー＋青いショートパンツ　柄にゼニアのエンブレム(Wikiページ参照)があしらわれている\n・インナーだったりソックスの差異だったりでバリエーションがありますが好きな方でお願いします　上記の要素が揃ってれば色々手を加えても全然大丈夫です（参考画像:https://twitter.com/Thermidor07/status/1514189458987700227）\n\nシチュエーションは日常の1コマを切り取った感じかシンプルに立ち絵風だと嬉しいですがくらたろうさんの絵柄でゼニアが見たい！！ってのが主なので細かい指定とかは特になく好きに描いちゃって大丈夫です\n\nこんな感じでよろしければよろしくお願いします！\n\nhttps://wikiwiki.jp/rwbyoc/%E3%82%BC%E3%83%8B%E3%82%A2%E3%83%BB%E3%82%AF%E3%82%B5%E3%83%B3%E3%83%88%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@kanakanamry/works/12", "thumbnail_src": "https://si.imgix.net/dc23fdc0/uploads/origins/fa6e5d57-e57b-4fc1-b54a-6f12cdb424fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed43788091bbf046dab1d175834593f", "thumbnail_srcset": "https://si.imgix.net/dc23fdc0/uploads/orig