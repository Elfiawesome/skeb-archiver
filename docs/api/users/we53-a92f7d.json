731657d3-15ac-4fcd-825d-721f3791d0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b558f72060d6baee61e6d4a457a68079 2x, https://si.imgix.net/5aad6ab1/uploads/origins/731657d3-15ac-4fcd-825d-721f3791d0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24ac1e0c49ae8d83fe062430b6e16ff3 3x", "genre": "comic", "nsfw": true, "body": "前の依頼\nhttps://skeb.jp/@we53/works/19\nhttps://skeb.jp/@we53/works/11\nで描いていただいた「無理矢理されている弱音ハクさん」の流れを、コミック仕立てでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@we53/works/30", "thumbnail_src": "https://si.imgix.net/77940a07/uploads/origins/d5b9cef2-d3c7-4fd7-9084-0618bbdf34c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8aaea6591781a2096766104e8de406", "thumbnail_srcset": "https://si.imgix.net/77940a07/uploads/origins/d5b9cef2-d3c7-4fd7-9084-0618bbdf34c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8aaea6591781a2096766104e8de406, https://si.imgix.net/77940a07/uploads/origins/d5b9cef2-d3c7-4fd7-9084-0618bbdf34c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0899b8435becdc6f607df1b7c3525b50 2x, https://si.imgix.net/77940a07/uploads/origins/d5b9cef2-d3c7-4fd7-9084-0618bbdf34c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b199a5aa6d78dcc8c5e20420d5e64ece 3x", "genre": "comic", "nsfw": true, "body": "お世話になっております。\n過去に居酒屋行った後にデルとハクさんがホテルに行ってシテいたように、久しぶりにホテルに行って目茶苦茶に盛り上がって本気で愛し合うデルとハクさんの子作りセックスが見たいです。\n\n以上、宜しければお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@we53/works/29", "thumbnail_src": "https://si.imgix.net/4363bd95/uploads/origins/207985b0-98b2-4907-ba26-73a0aa88d8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acc1948035b0839b2148524f425e21f0", "thumbnail_srcset": "https://si.imgix.net/4363bd95/uploads/origins/20