-f669-433d-9c4d-241726bc5d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af3763b271c5e9846512f5fd5ed07bc6 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n以前描いてもらったイラストがとても素敵でしたので別のミラプリでも描いていただきたくリクエストをしました！\n構図やポーズは先生にお任せします！\n\n参考資料\nhttps://mirapri.com/82389\n肌色 RGB:246,212,189\n髪色 RGB:120,143,188\n目　 RGB:81,105,151\n\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Rarararara0415/works/11", "thumbnail_src": "https://si.imgix.net/366adc6c/uploads/origins/57e217e8-2e1b-446c-8a78-10748a156181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1719de17cf1b4076b1a41b9c3fc8427", "thumbnail_srcset": "https://si.imgix.net/366adc6c/uploads/origins/57e217e8-2e1b-446c-8a78-10748a156181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1719de17cf1b4076b1a41b9c3fc8427, https://si.imgix.net/366adc6c/uploads/origins/57e217e8-2e1b-446c-8a78-10748a156181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4209129884e80d10f4bb42842c736f7 2x, https://si.imgix.net/366adc6c/uploads/origins/57e217e8-2e1b-446c-8a78-10748a156181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39270b2c40a480c2a7fb9edacd3beefc 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が好きなので、僕のララフェルを描いてほしいんだ。片手でピースサインをしながらニヤニヤして、もう片方の手でサングラスを持ち上げて目がよく見えるようにしてほしいです。彼はDunefolkの男性で、タンとダークの肌をしている。目は緑。可能であれば、提供された服を着てほしい。\n\n参考\nhttps://imgur.com/a/aYeUJS8", "created_at": "", "completed_at": ""}, {"path": "/@Rarararara0415/works/10", "thumbnail_src": "https://si.imgix.net/a5752870/uploads/origins/1427b775-b881-445a-bed8-97ccfce79e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=206bc1490ef4d4a74e8152d75c389864", "thumbnail_srcset": "https://si.imgix.net/a5752870/uploads/origins/1427b775-b881-445a-bed8-97ccfce79e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=206bc1490ef4d4a74e8152d75c389864, https://si.imgix.net/a5752870/uploads/origins/1427b775-b881-445a-bed8-97ccfce79e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3586d7592dc4dc696f7548e3c3c54ded 2x, https://si.imgix.net/a5752870/uploads/origins/1427b775-b881-445a-bed8-97ccfce79e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8f5d5b01fcbaa8889140b54efd071b0 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nツイッターにてイラストを拝見し、絵柄とイラストの雰囲気がとても素敵でしたので自キャラのイラストをお願いしたくリクエストさせていただきました！\n構図やポーズは先生にお任せします！\n\n参考資料\nhttps://mirapri.com/79617\n肌色 RGB:246,212,189\n髪色 RGB:120,143,188\n目　 RGB:81,105,151\n\n使用用途はスマートフォンの壁紙、SNSのアイコン等になります！\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Rarararara0415/works/9", "thumbnail_src": "https://si.imgix.net/bc296913/uploads/origins/ab2efa1f-e255-4e1d-b821-8c67e7dd53e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56bbda0f2784f4605fe9593306e9ca9f", "thumbnail_srcset": "https://si.imgix.net/bc296913/uploads/origins/ab2efa1f-e255-4e1d-b821-8c67e7dd53e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56bbda0f2784f4605fe9593306e9ca9f, https://si.imgix.net/bc296913/uploads/origins/ab2efa1f-e255-4e1d-b821-8c67e7dd53e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f357fc05eca64790cd690417fab3e72 2x, https://si.imgix.net/bc296913/uploads/origins/ab2efa1f-e255-4e1d-b821-8c67e7dd53e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb5b8d9c66e867cfc6082913cc03fb1f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ララフェルの似顔絵が欲しいです。\n\n恥ずかしそうに、ぽかんとしてるんです。ありがとうございました。\n\nhttps://imgur.com/B7v5WRL", "created_at": "", "completed_at": ""}, {"path": "/@Rarararara0415/works/8", "thumbnail_src": "https://si.imgix.net/cde6ba2b/uploads/origins/c4977788-b39f-4cd5-95c5-88a63d30c66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4120622705656437cc1fcc2821a2d4", "thumbnail_srcset": "https://si.imgix.net/cde6ba2b/uploads/origins/c4977788-b39f-4cd5-95c5-88a63d30c66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4120622705656437cc1fcc2821a2d4, https://si.imgix.net/cde6ba2b/uploads/origins/c4977788-b39f-4cd5-95c5-88a63d30c66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bedfc3bece87a3ec52de2c1f813b09ef 2x, https://si.imgix.net/cde6ba2b/uploads/origins/c4977788-b39f-4cd5-95c5-88a63d30c66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d699b10ced9d5e70d8ba79d2e97ea156 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nかわいいかわいいララフェルのイラストたくさん楽しませていただいています。\nもしよろしければ自キャラのイラストを描いていただければと思っています。\n\n資料はこちら(https://imgur.com/a/t52IowF)を参考にしていただければと思います。\n武器はオミット、眼鏡をクイッとしているととても嬉しいです！\n\nよろしくおねがいします！", "created_at": "", "completed_at": ""}, {"path": "/@Rarararara0415/works/7", "thumbnail_src": "https://si.imgix.net/10e6db59/uploads/origins/bffb4f77-2454-4841-84b2-84033a0a995e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8ac685990daf1085ede10f7a95756a", "thumbnail_srcset": "https://si.imgix.net/10e6db59/uploads/origins/bffb4f77-2454-4841-84b2-84033a0a995e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8ac685990daf1085ede10f7a95756a, https://si.imgix.net/10e6db59/uploads/origins/bffb4f77-2454-4841-84b2-84033a0a995e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11b00866363aa34b2a6eb36c6d4adbd 2x, https://si.imgix.net/10e6db59/uploads/origins/bffb4f77-2454-4841-84b2-84033a0a995e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc112a0bbc171d59be8e1d550ce1cfcb 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの画風が本当に大好きです!私のFFXIVキャラクターを収穫の衣装で描いていただけませんか？ポーズや構図はあなた次第です!ご検討のほど、よろしくお願いします\n\nhttps://imgur.com/a/NO8sVqX", "created_at": "", "completed_at": ""}, {"path": "/@Rarararara0415/works/6", "thumbnail_src": "https://si.imgix.net/f67