810-13cd-4f69-be00-2ef384600ac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b661530657ac25b9f97cf6385d51a18b 2x, https://si.imgix.net/b92803d6/uploads/origins/57021810-13cd-4f69-be00-2ef384600ac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fcc9f243f7d5d4aff2fcd8726c71a5f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hiziri_o0/works/3", "thumbnail_src": "https://si.imgix.net/77d62d60/uploads/origins/14f649ac-af9f-4697-89a8-bb2902d1fbee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e544a9150c97036363efea01850ed8", "thumbnail_srcset": "https://si.imgix.net/77d62d60/uploads/origins/14f649ac-af9f-4697-89a8-bb2902d1fbee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e544a9150c97036363efea01850ed8, https://si.imgix.net/77d62d60/uploads/origins/14f649ac-af9f-4697-89a8-bb2902d1fbee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0527c849c2dc4bd7d2f332c8840112d 2x, https://si.imgix.net/77d62d60/uploads/origins/14f649ac-af9f-4697-89a8-bb2902d1fbee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6baa9aae9f0e322aad01af79ed2d92f5 3x", "genre": "art", "nsfw": false, "body": "ﾋｼﾞﾘ様 初めまして。 \n配信アプリでVライバーをしております、花嶺かざりと申します。\nﾋｼﾞﾘ様の素敵なイラストをみて、私も描いていただきたいと思いリクエストいたしました。\n\n リクエスト内容 \n「花嶺 かざり」のイラスト。\n構図やシチュエーションやイメージなどは全てお任せしたいです。\n 衣装は資料のどのものでも、オリジナルなものでもなんでも大丈夫です。 \n\n 特徴\n・黄緑の髪にピンクのメッシュ\n ・少しタレているのピンク色の目 \n・八重歯  \n\nキャラ設定\n・森にある小さなカフェのウェイトレスで昼は人が、夜は人ならざる者に接客をします。\n\nその他\n 頭や横の髪が欠けないように描いていただけますでしょうか。 \n可能でしたら、背景と人物が別れた透過データもPSD等で頂きたいです。\n\n 使用用途 \n動画や配信での使用、SNSでの投稿、支援者さまへの特典などのVライバー・VTuberとしての活動での使用を予定しております。\n\n何卒、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1FAH4VgPw7MShr0B-52mFpZyI8gP4IZXy", "created_at": "", "completed_at": ""}, {"path": "/@Hiziri_o0/works/2", "thumbnail_src": "https://si.imgix.net/a08db1c5/uploads/origins/0cac7b5f-713f-4fbe-b9cd-ea41cd9d9e2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a6dd7316a34472232de0cf28c402de2", "thumbnail_srcset": "https://si.imgix.net/a08db1c5/uploads/origins/0cac7b5f-713f-4fbe-b9cd-ea41cd9d9e2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a6dd7316a34472232de0cf28c402de2, https://si.imgix.net/a08db1c5/uploads/origins/0cac7b5f-713f-4fbe-b9cd-ea41cd9d9e2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49a8d739e0fff3607e5ab68b5d840335 2x, https://si.imgix.net/a08db1c5/uploads/origins/0cac7b5f-713f-4fbe-b9cd-ea41cd9d9e2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=755cfa11bea78607533151e075f611df 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートワークが大好きで、vtuberの星海ジェリーさんのイラストをお願いしたいです。彼女のリファレンスはこちら：https://drive.google.com/drive/folders/1EUNB_vkrbTIwb678_C7H21rOY9sF-w3a?usp=sharing\n\nJellyはアイドルになるという夢に向かっている別の銀河系から来たお姫様です。彼女の特徴は\n- 身長142cm\n- 平らな胸\n- 星のついた黄色いヘアバンド\n- 髪型は3種類：毛先にドリルの入ったロングヘア／ドリルの入ったショートヘア／黄色い筋の入ったショートヘア\n- 明るい、歌うことが好き\n\n使用方法：SNSやストリームサムネイルでの非商用利用。できればキャラクターは背景とは別レイヤーでお願いします。\n\n構図やポーズ、背景など細かい部分はお任せしたいと思います。\n\nご検討のほど、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Hiziri_o0/works/1", "thumbnail_src": "https://si.imgix.net/200ec1fb/uploads/origins/42c28199-eed0-40a0-8d55-f7b587267746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2ef4ab2cee500136e9611d6a4c7f74c", "thumbnail_srcset": "https://si.imgix.net/200ec1fb/uploads/origins/42c28199-eed0-40a0-8d55-f7b587267746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2ef4ab2cee500136e9611d6a4c7f74c, https://si.imgix.net/200ec1fb/uploads/origins/42c28199-eed0-40a0-8d55-f7b587267746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=103ce20cbf8166ed7b4929a7bfb45166 2x, https://si.imgix.net/200ec1fb/uploads/origins/42c28199-eed0-40a0-8d55-f7b587267746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cda7786b0ad07a641e43288f295a3d05 3x", "genre": "art", "nsfw": false, "body": "初めまして。この度は私の代理キャラクターを描いていただきたく、リクエストを送らせていただきました！\n頂いたイラストはSNSのアイコンに使用する予定です。\nひじりさんのキラキラした色塗りとポップでカワイイ世界観が大好きです！是非、ひじりさんの楽しいように描いていただければ幸いです。\nよろしくお願いします💙🩷\n\n以下、詳細です\n・ぱっつん前髪、肩につく程度のボブヘア\n・髪色はミルクティーカラーに赤のインナー\n・グレーの目\n・服装やヘアアレンジ等お任せします！\n\nイラストの差し色としてネイビーとマゼンタを、それと、どこかにいちごを入れてもらえると嬉しいです🍓", "created_at": "", "completed_at": ""}]}