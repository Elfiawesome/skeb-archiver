d-8dbac9d857d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b224007d90cf83b198f245d9e7014947 2x, https://si.imgix.net/cd64be6c/uploads/origins/5d9566ba-5d2d-4254-8b1d-8dbac9d857d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d164180d0738d5a03b2dbb2fe0bd343 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの絵がとても好きで、リクエストを送りたいんです！\n\n私のOC、ルカスタが夫のゼンとセックスしているところを描いていただけませんか？ルカスタはエルフの魔女で、星、宇宙、宇宙に関係していて、165.1センチ、彼女の夫は傷だらけの人間の冒険家で、198.12センチです。  \n\n夫のゼンに後ろから犯されるルカスタを、正面・横からのPOVで描いてほしい。ゼンの手がルカスタの胸を触っていたらいいな。彼女の大きな帽子はかぶったままで！可能であれば、彼が彼女の中でクンニするバリエーションも入れてほしい。\n\nアートは苦手なんだけど、これがそのアート！\n\n禅：\n\nhttps://drive.google.com/file/d/1Dkx9oARmenVmhDvd5mWBZWmU6FnAKFRR/view?usp=drivesdk\n\nルカスタ\n\nhttps://drive.google.com/file/d/1u12kRRcVHGi-O0yjkiZq4EvCLZRPp7yn/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1EA5wuS7yb9q3ErAGTNAqvM2vMPLtnM5h/view?usp=drivesdk\n\nありがとうございました！o(｀ω´ )o", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/295", "thumbnail_src": "https://si.imgix.net/0370384a/uploads/origins/fa6b341c-ae1c-42cd-be95-8b896c67fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af7a7eae130e83278efdc0b5bcaa735c", "thumbnail_srcset": "https://si.imgix.net/0370384a/uploads/origins/fa6b341c-ae1c-42cd-be95-8b896c67fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af7a7eae130e83278efdc0b5bcaa735c, https://si.imgix.net/0370384a/uploads/origins/fa6b341c-ae1c-42cd-be95-8b896c67fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01bd1648a750a7b985f8ca95b6721136 2x, https://si.imgix.net/0370384a/uploads/origins/fa6b341c-ae1c-42cd-be95-8b896c67fdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1544741c869cef9a72af9be734d33e33 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/294", "thumbnail_src": "https://si.imgix.net/38c527bc/uploads/origins/d2291316-a15f-4390-aeaf-0e722dfda9c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=346874fee984fcd9b6e4876614717f23", "thumbnail_srcset": "https://si.imgix.net/38c527bc/uploads/origins/d2291316-a15f-4390-aeaf-0e722dfda9c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=346874fee984fcd9b6e4876614717f23, https://si.imgix.net/38c527bc/uploads/origins/d2291316-a15f-4390-aeaf-0e722dfda9c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fee46c3a1b03043ebc5b080be620f8fa 2x, https://si.imgix.net/38c527bc/uploads/origins/d2291316-a15f-4390-aeaf-0e722dfda9c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=938b3f45549ff0a8d49bbb36f7063c3d 3x", "genre": "art", "nsfw": true, "body": "いつも先生のエロ絵にはお世話になっております。先日のアイラ絵達にもお世話になりました。\n\n今回はいつものイチャラブ路線から外れた乱交系のオリカをお願いします。\n\nGG(グレングラッサ)0.01 火自然光\n\nガイアール・コマンド・ドラゴン/ヒューマノイド雌/テクノ・サムライ\n\nERO♀クリーチャー　パワー8585\n\nS・E・X♀(スペシャル・エロス・クロッシング)：互いの攻撃時、自分の場に「♂」が居ればこのクリーチャーをバトルゾーン出しても良い\n\n・ダブルブレイカー\n・自分のカードがプレイする時、このカードを指定された文明、種族として扱っても良い\n・自分がダイレクトアタックされる時、手札を一枚捨てる事で、相手はゲームに勝てず、自分はゲームに負けない。\n\nイラストは『トリック・オア・トリートメント』のようなゴム性のエロ衣装を纏ったグラッサと、後ろにクリーチャーなどの複数の男性の影(一つはタレットぽいもの)が映ったものをお願いします。\n\n差分は基本的には自由ですが、息を切らし、ゴム腰蓑をいくつも付け、蟲惑の表情を浮かべるグラッサは必ずお願いします。\n\nフレーバーテキスト\nクリーチャーの寄り合い所帯なテクノサムライ。彼らが仲を深める為に使うのが、このエロテクアーマーだ！\n\n今回もよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/293", "thumbnail_src": "https://si.imgix.net/372aedf9/uploads/origins/4f1f71ca-1593-4919-a900-d33b1315e964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c81293d5e4ad355de2a9e5204272135d", "thumbnail_srcset": "https://si.imgix.net/372aedf9/uploads/origins/4f1f71ca-1593-4919-a900-d33b1315e964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c81293d5e4ad355de2a9e5204272135d, https://si.imgix.net/372aedf9/uploads/origins/4f1f71ca-1593-4919-a900-d33b1315e964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba074c3371dcaab9325888d399ab1b63 2x, https://si.imgix.net/372aedf9/uploads/origins/4f1f71ca-1593-4919-a900-d33b1315e964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a7dda7ebe267db7cf59fbb05855f476 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/292", "thumbnail_src": "https://si.imgix.net/364cb9d8/uploads/origins/e89aa83e-ada9-48af-becc-2c8c579c00f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1ba28e1831063dcfb39f8f7595790f", "thumbnail_srcset": "https://si.imgix.net/364cb9d8/uploads/origins/e89aa83e-ada9-48af-becc-2c8c579c00f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1ba28e1831063dcfb39f8f7595790f, https://si.imgix.net/364cb9d8/uploads/origins/e89aa83e-ada9-48af-becc-2c8c579c00f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4698e5b16e71617536b2fbc8ff0940b8 2x, https://si.imgix.net/364cb9d8/uploads/origins/e89aa83e-ada9-48af-becc-2c8c579c00f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81feeaa16e97b43431bd6b2ae71a7153 3x", "genre": "comic", "nsfw": true, "body": "こんにちは。\n以前にもお世話になりましたが、今回もアカン先生にうちの子の爆乳イラストを描いて頂きたくリクエストお出しします。\n\n女の子が、ゴブリンに捕まり、家畜として扱われている風景を、動物番組風に紹介するエロショート漫画を描いて欲しいです。\nゴブリンの文化にスポットを当てるナレーションを添えて、あくまで女の子がゴブリンに家畜扱いされている……という演出でお願いします。\n女の子は候補となるキャラクターを複数人上げますので、そこから先生のお好みと、作画カロリーなどのご都合で何人か選んで、ゴブリンに調教されている場面を描いて頂きたいです。\nみんなアカン先生の絵柄に落とし込んで、どのシーンにどの子を起用するかもお任せします。\n\n※ひめきしちゃん\nhttps://skeb.jp/@Honokitiliver/works/39\n\n※しつじちゃん\nhttps://skeb.jp/@Honokitiliver/works/34\n\n※アサルトメイドさん\nhttps://skeb.jp/@Eiyttom/works/39\nhttps://skeb.jp/@Eiyttom/works/134\n\n※アサシンメイドさん\nhttps://skeb.jp/@Eiyttom/works/37\n\n※メイドチョー\nhttps://skeb.jp/@kikikitama/works/26\n\n設定としては、以前にも描いて頂いた貴族のお嬢様のひめきしちゃんと、彼女に仕える侍従たちです。\nゴブリンに捕まったひめきしちゃんを救出に向かったものの、全員返り討ちにされてゴブリンに辱められているイメージです。\n可能でしたら、ひめきしちゃん、しつじちゃん、メイドチョーは陰毛描写アリでお願いします。\nアサルト、アサシンめいどはパイパンです。\n\n\n※シナリオ・ナレーションイメージ\n『ゴブリンは野蛮で知能が低いと思われがちですが、実際はある程度の社会性を持ち原始的な牧畜も行うことが知られています。今日はその様子を見てみましょう』\n（導入）\n\n『ここはゴブリンの牧場です。どこからか捕まえてきた“雌馬”や“雌牛”がたくさん調教されていますね』\n（全裸の女の子が達が、屋外でゴブリン達に家畜調教されているシーン）\n\n『ご覧ください。こちらでは種付けが行われています。ゴブリンは自身の高い繁殖能力を応用して、家畜の個体数を増加することにも長けているのです』\n（女の子がゴブリンにレイプされている場面）\n\n『こちらの家畜はお腹が大きく母乳もでていますね。出産が近いようです。元気な赤ちゃんが生まれるといいですね！』\n（ボテ腹で完堕ちした女の子の痴態で締め）\n\nhttps://drive.google.com/drive/folders/1dutbk9HhCraxIeE_Hucjh8FYs3VD3LPK\n\nhttps://drive.google.com/drive/folders/1Un_48wjPsCc_VVP5vOcxEnMPr1i7PBAr", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/291", "thumbnail_src": "https://si.imgix.net/648e294f/uploads/origins/d3c51817-3ea0-4cc4-95a4-9b6e41091d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7893085fbe0d4dec3e196744c414d094", "thumbnail_srcset": "https://si.imgix.net/648e294f/uploads/origins/d3c51817-3ea0-4cc4-95a4-9b6e41091d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7893085fbe0d4dec3e196744c414d094, https://si.imgix.net/648e294f/uploads/origins/d3c51817-3ea0-4cc4-95a4-9b6e41091d57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f01794b3850c4dd305c663489904363 2x, https://si.imgix.net/648e294f/uploads/origins/d3c51817-3ea0-4cc4-95a4-9b6e41091d57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11fd8fd38749cb4636efa9004208e47f 3x", "genre": "art", "nsfw": true, "body": "久々のリクエストです\n\nキャラ\nそちらのオリキャラの姫騎士ちゃん(URLのヤツ)\n\n服装\nURLの画像と同じ服装 + 生おっぱいや乳首丸出し(少しでも乳首が隠れるのは完全NG)\n\n竿役\n太ってなく、肌が黒くなく、ショタでもふたなりでもない\n\nシチュ\nパイズリ大量射精(亀頭は出す)\n\n内容\nいつもの服装から生おっぱいや乳首を露出し、笑顔でおっぱいを自慢する姫騎士ちゃん竿役が興奮した事に気づき、そのままパイズリ開始\n↓\n竿役に気持ちいいかどうか問いかけ、肯定してもらった事で嬉しく感じる\n↓\n亀頭を優しく舐めながら扱いている内に、限界が近づいてきた姫騎士ちゃん。いつでも射精していい事を伝える\n↓\nやがて大量射精が発生。顔やおっぱいに大量の精液がかかる\n↓\n姫騎士ちゃんの目がハートになり、もう1回やるか中出しセックスするか問いかける\n\n補足\n1つのファイルに複数枚入れると、容量次第で見れなくなる場合があるので、1つのファイルに1枚ずつでお願いします\n\n以上です。検討の程よろしくお願いします\n\nhttps://x.com/akan_mori/status/1920502441243824148", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/290", "thumbnail_src": "https://si.imgix.net/f48cc138/uploads/origins/7de7b305-9686-443e-9717-1a7d2bd8d953?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1796d729ead823d3830ca0efb0a8c159", "thumbnail_srcset": "https://si.imgix.net/f48cc138/uploads/origins/7de7b305-9686-443e-9717-1a7d2bd8d953?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1796d729ead823d3830ca0efb0a8c159, https://si.imgix.net/f48cc138/uploads/origins/7de7b305-9686-443e-9717-1a7d2bd8d953?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adac667104013a1911edcfd24ed546bc 2x, https://si.imgix.net/f48cc138/uploads/origins/7de7b305-9686-443e-9717-1a7d2bd8d953?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57310e610c2827d51be4c2abce12aa20 3x", "genre": "art", "nsfw": true, "body": "遊戯王より黒魔女ディアベルスターを、フードとお面は外した状態でお願いします。\n巨根ショタガキに大量中出しされて精液ボテにされているところをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@26VNF3PorZYjkNT/works/289", "thumbnail_src": "https://si.imgix.net/74d43a19/uploads/origins/86f42ee5-cec3-470b-a709-2e7