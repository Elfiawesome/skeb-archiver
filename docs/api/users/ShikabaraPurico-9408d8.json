8e7-f7fe956bbaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d53858a20af6532d313bc1b733b79afc, https://si.imgix.net/4ca44639/uploads/origins/56112bbb-d70c-4245-88e7-f7fe956bbaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdad7a6de6c75ae383f9d095f50e05fd 2x, https://si.imgix.net/4ca44639/uploads/origins/56112bbb-d70c-4245-88e7-f7fe956bbaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78a31d42405e2f4bd79789726b143116 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ShikabaraPurico/works/94", "thumbnail_src": "https://si.imgix.net/36508711/uploads/origins/05ebb23d-f842-43b0-811f-c350497d919d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3f1d87cf860293c6a5875ef82afebd", "thumbnail_srcset": "https://si.imgix.net/36508711/uploads/origins/05ebb23d-f842-43b0-811f-c350497d919d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3f1d87cf860293c6a5875ef82afebd, https://si.imgix.net/36508711/uploads/origins/05ebb23d-f842-43b0-811f-c350497d919d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb5532707c1ac7912a6d454200f5593e 2x, https://si.imgix.net/36508711/uploads/origins/05ebb23d-f842-43b0-811f-c350497d919d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a140d44dd1523b3389f098b77f5b433 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回、下記の内容でリクエストをさせていたただきたいと思います。\n\n○キャラ\n・江風（アズレン）\n　先日のリクエスト（https://skeb.jp/@ShikabaraPurico/works/93）の続きのようなイメージ。\n　より陰茎化が進み、手足が完全に無くなっている。\n　地面とほぼ垂直の角度で勃起している。\n　結婚衣装（袖無し、裾が短縮されている）を陰茎化した身体に被せられている。（尻を頭に見立てて、襟部分から尻を出しているような状態）\n　乳首チンコ（玉なし、短め、太め）が生えている。\n　肛門、膣、尿道がぽっかり開いている。\n　クリトリスが肥大化しており、その根元には結婚指輪がはまっている。\n　胸にパンツ（黒・派手め）を履かされている。（https://www.pixiv.net/artworks/116243552）\n\n・長門（アズレン）\n　結婚衣装を着ており、左手薬指には指輪がはまっている。\n　尿道の隙間から陰毛のように江風の髪が出ている。\n　江風をぎゅっと抱きしめ、頬擦りしているような状態。\n　前回は乳首チンコ・舌チンコ・尻尾チンコなどを生やしていましたが、今回は無し。\n\n拙いですが手描きの資料を添付させていただきます。江風の衣装の向きなどについて参考にしていただければ幸いです。\n（https://drive.google.com/file/d/1i6IPvOXwkedABGGpnWY_yO1jsjLrqsTO/view?usp=drivesdk）\n\n○シチュエーション\n　①長門が幸せそうな表情をしている。\n　②江風の肛門にウェディングブーケ（https://drive.google.com/file/d/1i7gC4EgbAy9annVRVaIHFypBznLo-o6Y/view?usp=drivesdk）が挿入される。\n　③江風の尿道・膣・肛門・乳首チンコから大量の精液が溢れ出る。（勢いよく射精しているというよりは、大きく開いた各穴からドロドロと流れ出ているイメージ）\n\n○その他\n　修正についてはモザイクよりも修正線のほうが個人的に好みなので、できればそちらにしていただきたいです。\n\n以上です。また似た内容のリクエストとなってしまい恐縮ですが、ご検討いただければ幸いです。\n金額等で不都合がありましたら再送要請をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ShikabaraPurico/works/93", "thumbnail_src": "https://si.imgix.net/98c108e8/uploads/origins/5ead81b5-c250-49ef-b4bb-ee2141e01309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef650f5fa7518c54e78a71e0a299e3b4", "thumbnail_srcset": "https://si.imgix.net/98c108e8/uploads/origins/5ead81b5-c250-49ef-b4bb-ee2141e01309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef650f5fa7518c54e78a71e0a299e3b4, https://si.imgix.net/98c108e8/uploads/origins/5ead81b5-c250-49ef-b4bb-ee2141e01309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27615e535ec8c5ccd865547a6542f5fb 2x, https://si.imgix.net/98c108e8/uploads/origins/5ead81b5-c250-49ef-b4bb-ee2141e01309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcc5717e5f83e1c38670fdefd7290355 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回、下記の内容でリクエストをさせていたただきたいと思います。\n\n○キャラ\n・江風（アズールレーン）\n　先日のリクエスト（https://skeb.jp/@tewtewga/works/92）の続きのような感じで、頭が長門の尿道内に呑まれた状態。\n　より陰茎化が進み、胴体が長くなり、乳房と胴体の色がチンコのようになっている。（https://www.pixiv.net/artworks/90439866）\n　勃起状態で、水平より少し上を向いている。手足は退化し、ほぼ無くなっている。（https://www.pixiv.net/artworks/96788633）\n　初期衣装（袖無し）を陰茎化した身体に被せられている。（https://www.pixiv.net/artworks/104729958）\n　尿道内に呑まれなかった髪が陰毛のように隙間から出ている。（https://www.pixiv.net/artworks/83970569）\n　乳首チンコ（玉なし、短め、太め）が生えている。\n\n・長門（アズールレーン）\n　舌チンコ、乳首チンコ（玉あり）が生えている。（どちらもサイズは控えめ）\n　九尾の尻尾のように複数のチンコが尻のあたりから生えている。（尻尾が変化したものというイメージで、サイズはかなり大きめ、色は黒め）\n\n○シチュエーション\n　①長門は頬に手をあて、恍惚とした表情をしている。\n　②スカベンジャー（https://www.pixiv.net/artworks/80570307）の身体が江風の肛門に半分ほど呑み込まれる。\n　スカベンジャーの腰には江風の尻尾が巻き付いている。（尻尾で掴んで捕食しているイメージです）\n　③スカベンジャーが完全に呑み込まれる。\n　④長門の全チンコ、江風の肛門・膣・尿道・乳首から大量射精する。\n　スカベンジャーの衣服は江風の両乳首から排出される。\n　⑤長門の全チンコ、江風の肛門・膣・尿道・乳首から大量放尿する。\n\n○その他\n　修正についてはモザイクよりも修正線のほうが個人的に好みなので、できればそちらにしていただきたいです。\n\n以上です。立て続けに似た内容のリクエストとなってしまい恐縮ですが、ご検討いただければ幸いです。\n金額等で不都合がありましたら再送要請をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ShikabaraPurico/works/92", "thumbnail_src": "https://si.imgix.net/99e5ed34/uploads/origins/88cd29bb-2165-4871-aff0-d00aa6cc5ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a4610cca9976b1aedafbd577a4e152", "thumbnail_srcset": "https://si.imgix.net/99e5ed34/uploads/origins/88cd29bb-2165-4871-aff0-d00aa6cc5ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a4610cca9976b1aedafbd577a4e152, https://si.imgix.net/99e5ed34/uploads/origins/88cd29bb-2165-4871-aff0-d00aa6cc5ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13a5a9b1e713e110500484ee765d842b 2x, https://si.imgix.net/99e5ed34/uploads/origins/88cd29bb-2165-4871-aff0-d00aa6cc5ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d9ad9728d9379c2919e2ae27537f76a 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回、下記の内容でリクエストをさせていたただきたいと思います。\n\n○キャラ\n　・江風（アズールレーン）\n（参考資料: https://azurlane.wikiru.jp/?%E6%B1%9F%E9%A2%A8 ）\n　・長門（アズールレーン）\n（参考資料: https://azurlane.wikiru.jp/?%E9%95%B7%E9%96%80 ）\n\n　江風の頭が長門の尿道内にすっぽり呑み込まれ、巨大な陰茎のようになっている。（参考: https://drive.google.com/file/d/1_wrGwmXl8Nkt3YWCQe0Cc9mZaGsg_Gvr/view?usp=drivesdk）\n　尿道内に入りきらなかった江風の髪の毛が隙間から出ている。\n　江風の肛門、膣、尿道がぽっかり開き、乳房が肥大化している。\n　長門は両手で江風の胴体を掴んでいる。\n　江風の尻尾には複数の玉が通されており、アナルパールのようになっている。（参考: https://drive.google.com/file/d/1J_lhRbukWDkGJ-C0npXAojAhHo9w2eXg/view?usp=drivesdk ）\n　江風は初期衣装を全身、もしくは上半身のみ着ており、服の隙間から乳房が露出している。（参考: https://drive.google.com/file/d/1y6mCx40nUYxkdn-b_G8NmHGH3j1s-oFd/view?usp=drivesdk ）\n　長門は初期衣装、もしくは全裸。\n\n○シチュエーション\n　①江風の尻尾が、2分の3ほど江風の肛門に入っている。\n　　江風の乳首から精液が少し垂れている。\n　②江風の肛門から尻尾が引き抜かれ、江風の肛門、膣、尿道、乳首から精液が吹き出る。\n　　長門は絶頂して気持ちよさそうな表情をしている。\n　③江風の肛門、膣、尿道から小便が流れ出る。（②の射精よりも少し勢いが弱い感じでお願いしたいです。）\n　　長門は絶頂の余韻に浸るような表情をしている。\n\n○その他\n　修正についてはモザイクよりも修正線のほうが個人的に好みなので、できればそちらにしていただきたいです。\n\n以上です。ご検討いただければ幸いです。\n金額等で不都合がありましたら再送要請をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ShikabaraPurico/works/91", "thumbnail_src": "https://si.imgix.net/3723aad8/uploads/origins/f04a4753-5df6-42e6-a894-b636795a2d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9206e3a1f1f889087a3800d59c7f5db6", "thumbnail_srcset": "https://si.imgix.net/3723aad8/uploads/origins/f04a4753-5df6-42e6-a894-b636795a2d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9206e3a1f1f889087a3800d59c7f5db6, https://si.imgix.net/3723aad8/uploads/origins/f04a4753-5df6-42e6-a894-b636795a2d24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cde52e0e8c3b888eaffafa5637c5a4a6 2x, https://si.imgix.net/3723aad8/uploads/origins/f04a4753-5df6-42e6-a894-b636795a2d24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a39c86d97914242126fe6a9d2b6fe28b 3x", "genre":