ins/3fe585cf-4d7c-434a-b356-a562e6a01da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f38397f2edb45894a97e034046ff0985, https://si.imgix.net/18791de5/uploads/origins/3fe585cf-4d7c-434a-b356-a562e6a01da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2932ad5cecf75a0d2a625e1e9d1efc0 2x, https://si.imgix.net/18791de5/uploads/origins/3fe585cf-4d7c-434a-b356-a562e6a01da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90f87d578aad5745da3542f884834f4c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ShikabaraPurico/works/73", "thumbnail_src": "https://si.imgix.net/9dedf43b/uploads/origins/468b5310-c8c8-4fb4-902b-5e72005c4dca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609ddfbf1dceeb7ba288da8b240eba6c", "thumbnail_srcset": "https://si.imgix.net/9dedf43b/uploads/origins/468b5310-c8c8-4fb4-902b-5e72005c4dca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609ddfbf1dceeb7ba288da8b240eba6c, https://si.imgix.net/9dedf43b/uploads/origins/468b5310-c8c8-4fb4-902b-5e72005c4dca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caf8b4e98f1efaef6728c6c761b8dc42 2x, https://si.imgix.net/9dedf43b/uploads/origins/468b5310-c8c8-4fb4-902b-5e72005c4dca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf8fe5f71a004825cbc7b12c57b6e245 3x", "genre": "art", "nsfw": true, "body": "アイカツ！シリーズの「風沢 そら」でスカトロイラストのシチュをリクエストをさせていただきます。\n\nhttps://www.pixiv.net/artworks/79205755\n\nこちらのイラスト1~3枚目のような、タンクからチューブでウンコを体内に注入され脱糞というようなシチュエーションをお願いします。\n\n衣装は上記イラストのキャラのように、黒いラバースーツ＋青いラバーのニーハイ/ロンググローブで、その上から男物の白いブリーフを履いている。\n顔にも白いブリーフを被っている(変態仮面のような、パンツの股の部分が正面に来るような被り方)。\n\nY字バランスのような姿勢で、お尻を強調した構図。\n体格は、右側のキャラクターのように、元のキャラデザより全体的にムチムチとしていて、胸も大きく、また乳輪、乳首は大きめ。\n\n\nチューブは臍に接続されて腸に直接注入されており、妊婦のようにボテ腹の状態。\nアヘ顔で腹の中に納まりきらなくなったウンコがアナルと口から大量脱糞のようにあふれ出ている。\n\n以上のようなシチュをお願いします。\n\n\n可能であれば差分で、脱糞前の状態を描いていただきたいです(腹はボテ腹のまま、表情は上記イラスト二枚目のような表情)。\n\n\n受けていただけますとありがたいです。\nどうぞよろしくお願いいたします。\n\n\nキャラクター参考: https://gamerch.com/aikatsu-photo/entry/400868", "created_at": "", "completed_at": ""}, {"path": "/@ShikabaraPurico/works/72", "thumbnail_src": "https://si.imgix.net/991d18ff/uploads/origins/7cd6f048-fa0e-4d3c-a91c-aa873a014eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46bb6f459d51827c0c98219a3d8f8280", "thumbnail_srcset": "https://si.imgix.net/991d18ff/uploads/origins/7cd6f048-fa0e-4d3c-a91c-aa873a014eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46bb6f459d51827c0c98219a3d8f8280, https://si.imgix.net/991d18ff/uploads/origins/7cd6f048-fa0e-4d3c-a91c-aa873a014eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d624a9ec4f968c0cd324e97f93b4db01 2x, https://si.imgix.net/991d18ff/uploads/origins/7cd6f048-fa0e-4d3c-a91c-aa873a014eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8ad870f88ffdb2f75c766056285460b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの作品が大好きで、https://media.discordapp.net/attachments/1027787334776795239/1221825226048802846/1875112-1_clipped_rev_12.png?ex=6613fc6a&is=6601876a&hm=226f895432d4437bd589ced4d6d69bbd0dbfeba6652ef32dc5f2fc2aa075bbe4&=&format=webp&quality=lossless&width=602&height=671、この少女が自分自身をチンポに食べさせているさまざまな段階を描いてほしいと思っていました。彼女が飲み込まれるとき、同じように淫らな赤みと膨らみを見せ、最後のイメージは、発射されるURの残骸だ。\n\nhttps://media.discordapp.net/attachments/1027787334776795239/1221825226048802846/1875112-1_clipped_rev_12.png?ex=6613fc6a&is=6601876a&hm=226f895432d4437bd589ced4d6d69bbd0dbfeba6652ef32dc5f2fc2aa075bbe4&=&format=webp&quality=lossless&width=