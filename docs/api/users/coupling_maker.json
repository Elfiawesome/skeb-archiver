mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dcf36423f490002d5e09f325c9aec9a 2x, https://si.imgix.net/5ab4f4e0/uploads/origins/47ed5513-c1e0-4b11-b8be-9c62ca9c7e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb3bbf76f9ac31d4c00875066cfdb28a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の友人のためにあなたの素晴らしい作品を見ました！\n私のVtuberキャラクター、Aya Samiのアートワークをお願いしたいのです。彼女はインターネットの中に住んでいるデジタルウサギの女の子です。\nピチピチのボディスーツに包まれたお尻を中心に描いてほしいです！\n\nhttps://vgen.co/c/aya-sami/original", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/35", "thumbnail_src": "https://si.imgix.net/b567301d/uploads/origins/d6a11753-7d28-4289-9c40-25cb4814046d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea7b3d3b2666efdabd800f6420f1d09", "thumbnail_srcset": "https://si.imgix.net/b567301d/uploads/origins/d6a11753-7d28-4289-9c40-25cb4814046d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea7b3d3b2666efdabd800f6420f1d09, https://si.imgix.net/b567301d/uploads/origins/d6a11753-7d28-4289-9c40-25cb4814046d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d0509d7bb8837968f5b97823c830952 2x, https://si.imgix.net/b567301d/uploads/origins/d6a11753-7d28-4289-9c40-25cb4814046d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdcff797a30e5383d54cbdd136749033 3x", "genre": "art", "nsfw": true, "body": "とてもキュートなアートで、お尻とパンティーを上手に描いていますね。このスケブhttps://skeb.jp/@coupling_maker/works/34 でサイズ違いのセットアップを描かれたのを見て、このフラワーブレザーの服を着たタイムスキップ・ニア・テッペリンが小さな夫のシモンの上に座っている、同じようなセットアップを希望します。ご検討のほど、よろしくお願いいたします。\n\nhttps://www.deviantart.com/stash/2b6w8ww54xf", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/34", "thumbnail_src": "https://si.imgix.net/e795c2c4/uploads/origins/d41fa050-c28a-4fb6-a26c-9638f8c0e469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9d23a2a99f9d7511b3aaba1bdf83eb", "thumbnail_srcset": "https://si.imgix.net/e795c2c4/uploads/origins/d41fa050-c28a-4fb6-a26c-9638f8c0e469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9d23a2a99f9d7511b3aaba1bdf83eb, https://si.imgix.net/e795c2c4/uploads/origins/d41fa050-c28a-4fb6-a26c-9638f8c0e469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a4146fca0a8df61e978832f94ce2c60 2x, https://si.imgix.net/e795c2c4/uploads/origins/d41fa050-c28a-4fb6-a26c-9638f8c0e469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76223f73a469ab0e6d4d9ee2549dfd0d 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n資料URLの初音ミクの絵を拝見して、とても良いと思いましたので依頼させていただきます。\n\n少々特殊な内容になってしまうのですが、いわゆるサイズフェチのイラストで、\n「座っているミクの巨尻と、それに下敷きにされている、体長20cmぐらいに縮んだ鏡音レン」をお願いできますでしょうか。\n\n腰をおろして座っているミクのお尻に超接近した構図で、\n小さなレンは上半身が尻の下敷きになって見えなくなっており、外に出ている脚をジタバタとさせてもがいている……というイメージです。\nつまり、ミクは尻周りのみが、レンは脚のみが絵の中に映っています。\n\nまた、どちらも着衣で、ミクのパンツは資料URLと同じ縞パンです。\n\n以上です。\nもしよろしければ、お願いいたします。\n\nhttps://www.pixiv.net/artworks/128002707", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/33", "thumbnail_src": "https://si.imgix.net/f65e0b59/uploads/origins/f6c42f13-d92d-4fed-93af-22920d067514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6115e43a9e374d40fa4db9d616fbc298", "thumbnail_srcset": "https://si.imgix.net/f65e0b59/uploads/origins/f6c42f13-d92d-4fed-93af-22920d067514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6115e43a9e374d40fa4db9d616fbc298, https://si.imgix.net/f65e0b59/uploads/origins/f6c42f13-d92d-4fed-93af-22920d067514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03d85f63501e50acef865f2610566267 2x, https://si.imgix.net/f65e0b59/uploads/origins/f6c42f13-d92d-4fed-93af-22920d067514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3324b64ca4817548ef4d8019611efb8a 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！またお願いがあります！\n\n テイルズ オブ シンフォニア-新世界の夜明け-』のアリスをリクエストします：テイルズ オブ シンフォニア - ラタスクの騎士\n\nアリスのお尻アップのイラストをお願いします。\nアリスはシャツの下からお尻と下着が見えるようなポーズです。\n\nアリスの参考：(https://imgchest.com/p/o24av5ee34l) (2枚目の画像は後ろ姿)\n\nリクエストに応えていただきありがとうございました。\n\nhttps://imgchest.com/p/o24av5ee34l", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/32", "thumbnail_src": "https://si.imgix.net/3ed14af1/uploads/origins/28648c3d-aeab-4f38-a5d8-7f13a45b5c47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4cc3ccb13d079ff196b03c488e5ddc1", "thumbnail_srcset": "https://si.imgix.net/3ed14af1/uploads/origins/28648c3d-aeab-4f38-a5d8-7f13a45b5c47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4cc3ccb13d079ff196b03c488e5ddc1, https://si.imgix.net/3ed14af1/uploads/origins/28648c3d-aeab-4f38-a5d8-7f13a45b5c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee1ac7ca8332e032f7d142a15adc69eb 2x, https://si.imgix.net/3ed14af1/uploads/origins/28648c3d-aeab-4f38-a5d8-7f13a45b5c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36e182d3e737404146a4907a380af1b0 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私のキャラクターを描いてくれたあなたの最後の絵が大好きです！完璧でした！\nスカートを上げてお尻と脚を見せながら、振り返る彼女を描いていただけませんか？前回と同じOL姿でお願いします。\nレギンスはお尻が隠れるくらいで、下は黒とゴールドのパンティです。\nパンティと体型の参考画像を2番目のリンクに追加しました！\n\n衣装：https://drive.google.com/drive/folders/1ueLbEIbhKI42Qj5B77RannhhVWI5iVBy?usp=sharing\nインナー：https://drive.google.com/drive/folders/1kK32gPZKHbBrHfKH_EGBUo6jSlScgLNu?usp=sharing\n\nhttps://drive.google.com/drive/folders/1ueLbEIbhKI42Qj5B77RannhhVWI5iVBy?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/31", "thumbnail_src": "https://si.imgix.net/2154d508/uploads/origins/3e99700a-99a1-4f8c-b74f-1657dccb87ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=822a11b3d5028579a3d03b2d0d85dc0f", "thumbnail_srcset": "https://si.imgix.net/2154d508/uploads/origins/3e99700a-99a1-4f8c-b74f-1657dccb87ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=822a11b3d5028579a3d03b2d0d85dc0f, https://si.imgix.net/2154d508/uploads/origins/3e99700a-99a1-4f8c-b74f-1657dccb87ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8150ce581045f727ffa69434190364a 2x, https://si.imgix.net/2154d508/uploads/origins/3e99700a-99a1-4f8c-b74f-1657dccb87ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e2e568746be9880c7cc431ca5b4d1fc 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！またお願いがあります！\n\nテイルズ オブ エクシリア』のアグリアです。\n\nアグリアのお尻アップのイラストをお願いしたいです。\nスカートの下からお尻と黒いパンティが見えるようなポーズです。\n\nアグリアの参考資料です：(https://imgchest.com/p/wl7l8g964x2)\n\n彼女の走るポーズ: (https://cdn.imgchest.com/files/7pjcqbwomr7.png)\nまた、ビデオでの彼女の走るポーズと他のアグリアの情報（必要であれば）：(https://imgchest.com/p/a846k32wwyx) (これらの正確なポーズは、アーティストが使用する必要はありませんが、必要であれば例としてお使いください)\n\n赤いドレスの背中を少し持ち上げると、黒いパンティが見えます。黒いパンティーの例: (https://imgchest.com/p/dl7pe3qv6yo)\n\n私のリクエストを考慮していただき、ありがとうございます。\n\nhttps://imgchest.com/p/wl7l8g964x2", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/30", "thumbnail_src": "https://si.imgix.net/1fc0af63/uploads/origins/fff27742-b548-404e-a90b-f2b23f92b999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de532fe4acefbe359626bde906985ce", "thumbnail_srcset": "https://si.imgix.net/1fc0af63/uploads/origins/fff27742-b548-404e-a90b-f2b23f92b999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de532fe4acefbe359626bde906985ce, https://si.imgix.net/1fc0af63/uploads/origins/fff27742-b548-404e-a90b-f2b23f92b999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=712157c9d131e9193a60c41518b825ce 2x, https://si.imgix.net/1fc0af63/uploads/origins/fff27742-b548-404e-a90b-f2b23f92b999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a592b450a67daa873a39a35dd37401d8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/29", "thumbnail_src": "https://si.imgix.net/4c0d03e8/uploads/origins/9f1380e5-951f-4aa3-bd17-e0d8d43a0160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9e8b3f2274047549ceee44edc41a854", "thumbnail_srcset": "https://si.imgix.net/4c0d03e8/uploads/origins/9f1380e5-951f-4aa3-bd17-e0d8d43a0160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9e8b3f2274047549ceee44edc41a854, https://si.imgix.net/4c0d03e8/uploads/origins/9f1380e5-951f-4aa3-bd17-e0d8d43a0160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25fc34e36d167cfb78b99da24f0bf23f 2x, https://si.imgix.net/4c0d03e8/uploads/origins/9f1380e5-951f-4aa3-bd17-e0d8d43a0160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76a2f453f7297d908581bc2b2e59bdb5 3x", "genre": "art", "nsfw": true, "body": "こんにちは、あなたのアートを拝見しました。\n\n私のVtuber、デジのお尻にフォーカスしたイラストが欲しいです。ショートパンツを履いているので、とても素敵だと思います！また、ショーツからパンティラインが見えると嬉しいです！\n\nありがとうございました！\n\nhttps://i.imgur.com/UwiCQyn.png", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/28", "thumbnail_src": "https://si.imgix.net/0d7e2364/uploads/origins/d0794e13-f809-4913-b511-1fa01a7a06d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8a1d51133530203895a1712867b0f3", "thumbnail_srcset": "https://si.imgix.net/0d7e2364/uploads/origins/d0794e13-f809-4913-b511-1fa01a7a06d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8a1d51133530203895a1712867b0f3, https://si.imgix.net/0d7e2364/uploads/origins/d0794e13-f809-4913-b511-1fa01a7a06d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be78b326304cc72517bb9f7bff1a81fc 2x, https://si.imgix.net/0d7e2364/uploads/origins/d0794e13-f809-4913-b511-1fa01a7a06d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ccf6bd0123e5e0d2b514413d2df6fda 3x", "genre": "art", "nsfw": false, "body": "こんにちは。長い間お待たせしてごめんなさい。\n ぜひアヤナを描いてほしい。\n\nグールっぽい衣装で描いてください。\nhttps://sta.sh/098m9ld2jp4\nhttps://sta.sh/0130fjglq8ws\n\n彼女はゴシックな妖精の王国の王女です。\n彼女のポーズはあなた次第です。\nかわいく、楽しく。", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/27", "thumbnail_src": "https://si.imgix.net/5b0946ee/uploads/origins/69996c9c-0226-496f-a0fe-5108c846d4af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=263b2313f333e3355ffc38726273c6e9", "thumbnail_srcset": "https://si.imgix.net/5b0946ee/uploads/origins/69996c9c-0226-496f-a0fe-5108c846d4af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=263b2313f333e3355ffc38726273c6e9, https://si.imgix.net/5b0946ee/uploads/origins/69996c9c-0226-496f-a0fe-5108c846d4af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ea2136980e210fe2d898ab0f52e0ded 2x, https://si.imgix.net/5b0946ee/uploads/origins/69996c9c-0226-496f-a0fe-5108c846d4af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43c0bb0a173452be30b05e65914c00fe 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！もしよろしければ、またリクエストをお送りしたいのですが！\n\nキャラクターはテイルズオブヴェスペリアのゴーシュです。\n\nゴーシュはドロワの双子なのですが、ドロワより明らかに胸が小さいです。ゴーシュのお尻をクローズアップしたイラストをお願いしたい。ドロワと同じようにお尻と白いパンティが見えるようなポーズでお願いします（https://skeb.jp/@coupling_maker/works/23）。\n\nゴーシュの向きは、ドロワの向きとは逆にしてください。がドロワ（ドロワット）の隣に立っているような向きにしてください。(ドロワは外側を向き、お尻は右を向いている。ゴーシュは外側を向き、お尻は左を向いている)(https://www.pixiv.net/artworks/128044909)（これはお尻の向きで、ポーズではありません）。\n\n分かりにくくなっていなければいいのですが。リクエストに応えてくれてありがとう！\n\nDroiteと同じポーズを使いたくない場合、他のGaucheの参考をいくつか紹介します: (https://imgchest.com/p/pg73gjzvzyr)\n\nhttps://imgchest.com/p/9p4nelv9l4n", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/26", "thumbnail_src": "https://si.imgix.net/73335448/uploads/origins/5f378d21-495f-469a-94cc-96fb5b742339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984b8c918724471f1f128d0ea01c02ba", "thumbnail_srcset": "https://si.imgix.net/73335448/uploads/origins/5f378d21-495f-469a-94cc-96fb5b742339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984b8c918724471f1f128d0ea01c02ba, https://si.imgix.net/73335448/uploads/origins/5f378d21-495f-469a-94cc-96fb5b742339?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ad5f271429c513e1d2f797286964f76 2x, https://si.imgix.net/73335448/uploads/origins/5f378d21-495f-469a-94cc-96fb5b742339?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e962c244aa3d059a58864edad4dc1680 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼します。\n「甘神さんちの縁結び」ってアニメに主人公達のクラスメイトとして登場する前髪ぱっつんの子をお願いします。\n\nこちら参考に(画像の中央の子です)\nhttps://livedoor.blogimg.jp/mouseion5023/imgs/f/9/f96a4ce1.jpg\n\n下着姿で乳を揉まれているのをお願いします。\n胸は大きめで\n下着の色やデザインはお任せします。\n表情は画像を参考にして頂いて、少し頬を赤くして喜んでいる感じでお願いします。\n\nhttps://livedoor.blogimg.jp/mouseion5023/imgs/f/9/f96a4ce1.jpg", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/25", "thumbnail_src": "https://si.imgix.net/827a9a24/uploads/origins/de260d5b-0a56-43e5-b204-0163c91a00a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b1742309ad690624ee587045e278886", "thumbnail_srcset": "https://si.imgix.net/827a9a24/uploads/origins/de260d5b-0a56-43e5-b204-0163c91a00a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b1742309ad690624ee587045e278886, https://si.imgix.net/827a9a24/uploads/origins/de260d5b-0a56-43e5-b204-0163c91a00a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41a17f70dff4b6eb0896d72136a3b9cd 2x, https://si.imgix.net/827a9a24/uploads/origins/de260d5b-0a56-43e5-b204-0163c91a00a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9581d3498ed80cf2ef33acc612e4581 3x", "genre": "art", "nsfw": true, "body": "デビルサバイバーのアマネの後ろ姿を描いていただきたいです。アトリエ・ユミアのユミアの作品（https://www.pixiv.net/en/artworks/128438387）を拝見し、このような作風は私の希望するキャラクターにとても合うと思いました。この絵と同じような構図を希望します。ドレスのディテールと見えるパンティが好きなので、これも見てみたいです。\n\nピントは完全にお尻に合わせ、Yumiaの作品やこの作品（https://skeb.jp/@coupling_maker/works/20）のような上半身を見せる必要はありません。\n\n結果を楽しみにしています。\n\n参考：https://imgur.com/a/NTVbI0b", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/24", "thumbnail_src": "https://si.imgix.net/c0cc5dad/uploads/origins/0c26e8de-a976-4bcc-af05-4f52ad34248a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e63d66b875539757ea07b13120f90da6", "thumbnail_srcset": "https://si.imgix.net/c0cc5dad/uploads/origins/0c26e8de-a976-4bcc-af05-4f52ad34248a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e63d66b875539757ea07b13120f90da6, https://si.imgix.net/c0cc5dad/uploads/origins/0c26e8de-a976-4bcc-af05-4f52ad34248a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2237b26ea9402f4fe91b26bfba4f762 2x, https://si.imgix.net/c0cc5dad/uploads/origins/0c26e8de-a976-4bcc-af05-4f52ad34248a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=036d98ebb10f62005c37866e6a670330 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/23", "thumbnail_src": "https://si.imgix.net/32690bd1/uploads/origins/c2787507-bb07-4660-892f-28c737543cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967a32abef6aa7567843c2af83de3a28", "thumbnail_srcset": "https://si.imgix.net/32690bd1/uploads/origins/c2787507-bb07-4660-892f-28c737543cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967a32abef6aa7567843c2af83de3a28, https://si.imgix.net/32690bd1/uploads/origins/c2787507-bb07-4660-892f-28c737543cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2d9fc2b02d15c57bbdb8e3e56509e44 2x, https://si.imgix.net/32690bd1/uploads/origins/c2787507-bb07-4660-892f-28c737543cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abe037fb0d2045b886d7d39fcb414e77 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！またまたお願いがあります！\n\nテイルズ オブ ヴェスペリア』のドロワットです。\n\nドロワテのお尻アップのイラストをお願いしたいです。\nスカートの下からお尻と白いパンティが見えるようなポーズでお願いします(https://imgchest.com/p/ljyqv39ro72) (このポーズで描いていただく必要はありませんが、必要であれば一例としてお願いします)\n\nDroiteの名前はフランス語で「正しい」という意味です。ドロワテのお尻が右を向いているようにお願いします。例: (https://www.pixiv.net/artworks/121041733) (これはお尻の向きです。ポーズではありません。)\n\nリクエストにお答えいただきありがとうございました。\n\nhttps://imgchest.com/p/n87wbde37xd", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/22", "thumbnail_src": "https://si.imgix.net/699a5126/uploads/origins/b61a187e-238b-4cc2-941b-87f369872d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7107f1e21f383d0a30a003b4cc926c6", "thumbnail_srcset": "https://si.imgix.net/699a5126/uploads/origins/b61a187e-238b-4cc2-941b-87f369872d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7107f1e21f383d0a30a003b4cc926c6, https://si.imgix.net/699a5126/uploads/origins/b61a187e-238b-4cc2-941b-87f369872d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3cf071eda4ecc56d8ce4f7908b88442 2x, https://si.imgix.net/699a5126/uploads/origins/b61a187e-238b-4cc2-941b-87f369872d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de594c74a272b3fd83d5ac7ac0671fd6 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n日頃より眼福な作品の数々ご拝見しています。\nRYUSEI先生が直近でよくご投稿なされているムッチリとしたお尻作品、少し前に投稿されていた揉み乳作品、どちらも好きでして目の保養とさせていただいております。\n程よいむちむち加減が大変素晴らしいです！\n今回はその魅力的なお尻にフォーカスを当てた内容にてリクエストさせていただきます。\nお手数ですがお目通しだけでもいただけますと有難いです。\n\n『ｼﾁｭｴｰｼｮﾝ内容』\n見える子ちゃんより四谷みこがパンチラ羞恥しているシチュ…にてリクエストさせてください\n\n『資料』\nhttp://blog.livedoor.jp/anime_capture-cap/archives/cat_534871.html\n\nhttps://drive.google.com/drive/folders/1oy5nLT09tYLRmpM8JMj6Gvssve5T996t\n\n『シチュ詳細』\n「見える子ちゃん」は主人公である四谷みこちゃんが常人には見えない霊や異形の存在を視認する能力が発現してしまい奮闘していくストーリーで、アニメ版はホラー要素だけでなくフェチズムなアングルやほんのりエッチな描写でも話題になった作品でした。\n\n本件ではその設定を盛り込み、先生が以前描かれていたユウカのように後ろを振り返りお尻〜下半身が強調されたアングルで\nhttps://www.pixiv.net/artworks/115360116\n\n①自身の生足〜ミニスカートを凝視する霊の存在に気付き恥ずかしがる\n②霊にスカートをめくり上げられパンチラ(ひゃっ!?と驚きながらも羞恥な表情)\n③恥ずかしがりながらお尻を両手で隠そうとする(見ちゃダメっ！…な表情)\n\n1枚のメインイラストを表情差分〜腕の位置〜パンチラ差分などを組み込み描写していただきたく存じます。\n※霊の描写はみこちゃんの背後にいる…という設定で身体全体は描写せずとも大丈夫です\n※イラスト内の描写としては浮遊している紳士ハンドのような形式でスカートをめくりあげる役割\n\n資料先のみこちゃんはスラッとした体型ではありますが、本件ではC〜Dカップ＆スレンダーながらも桃尻…と肉付きを若干増した体型にてお願いいたします。\n※下着の色は資料先と同じような水色のもので！\n\n以上の内容でお送りいたします。\nご多忙の折、大変恐縮ではございますがご検討いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@coupling_maker/works/21", "thumbnail_src": "https://si.imgix.net/7abc5e15/uploads/origins/4f1cac31-1c01-4c62-b3be-8eff522ea8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8306a73601b0b09369932642728dd222", "thumbnail_srcset": "https://si.imgix.net/7abc5e15/uploads/origins/4f1cac31-1c01-4c62-b3be-8eff522ea8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8306a73601b0b09369932642728dd222, https://si.imgix.net/7abc5e15/uploads/origins/4f1cac31-1c01-4c62-b3be-8eff522ea8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=135f50618330761d8bda33151672e67b 2x, https://si.imgix.net/7abc5e15/uploads/origins/4f1cac31-1c01-4c62-b3be-8eff522ea8ca?bg=%23fff&auto=format%2Ccompress&fm=