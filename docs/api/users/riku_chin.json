-4b42-8d2e-4ec6e22861d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7367c81f4baab2face1edc8f711cf90f, https://si.imgix.net/ae9f3186/uploads/origins/872d839f-3e94-4b42-8d2e-4ec6e22861d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b49a4d40cf2860e87c662dde5f63d02f 2x, https://si.imgix.net/ae9f3186/uploads/origins/872d839f-3e94-4b42-8d2e-4ec6e22861d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47fa6e56a974060c6978e1df9250e839 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@riku_chin/works/6", "thumbnail_src": "https://si.imgix.net/d5ff70ea/uploads/origins/bb9d05fa-160e-41b2-b4a2-2ee0ef25c7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b32021e95c11bd6f9c52c3a120ec7b0", "thumbnail_srcset": "https://si.imgix.net/d5ff70ea/uploads/origins/bb9d05fa-160e-41b2-b4a2-2ee0ef25c7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b32021e95c11bd6f9c52c3a120ec7b0, https://si.imgix.net/d5ff70ea/uploads/origins/bb9d05fa-160e-41b2-b4a2-2ee0ef25c7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e4ff08a5e15b43cc336db14561fd086 2x, https://si.imgix.net/d5ff70ea/uploads/origins/bb9d05fa-160e-41b2-b4a2-2ee0ef25c7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79c67765f4a94c8460283b37d55a25e7 3x", "genre": "art", "nsfw": false, "body": "お世話になっております！壱原ことにょんです。\nSkeb受付中とのことですのでぜひりくさんにうちの子を…！と思いリクエストを送らせていただきます！\n\n私の一次創作キャラの陽太(はるた)と寧生(ねお)のイラストを描いていただきたいです。\n各キャラの主な特徴は以下になります。\n陽太…丸いつり目、麻呂眉気味、元気、後輩\n寧生…切れ長目、下まつ毛、髪型アシメ、インナーカラー、ミステリアス、先輩\n参考資料は資料URLよりご確認いただけますと幸いです。\n\nりくさんの描かれるイラストが大好きなので、シチュエーションや衣装など詳細はお任せします。\nCPでも未満でもどちらでも大丈夫です…！\n\n1点、陽太の髪型に関しましては「向かって左側のサイドの髪を下ろす」形でお願いしたいです(資料URL「バレンタイン」「ツナギ」参照)\n\n何卒宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1-UFuHsxMJQtfeXG9HLUkWC_FoL9eT81R", "created_at": "", "completed_at": ""}, {"path": "/@riku_chin/works/5", "thumbnail_src": "https://si.imgix.net/7a6f4809/uploads/origins/c2ba003a-5064-4e51-90ae-4b3789d847a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5c15d2538f27bfb0141628474589be", "thumbnail_srcset": "https://si.imgix.net/7a6f4809/uploads/origins/c2ba003a-5064-4e51-90ae-4b3789d847a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5c15d2538f27bfb0141628474589be, https://si.imgix.net/7a6f4809/uploads/origins/c2ba003a-5064-4e51-90ae-4b3789d847a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4ce04215ab862e4dc2a400bbcc2e6b9 2x, https://si.imgix.net/7a6f4809/uploads/origins/c2ba003a-5064-4e51-90ae-4b3789d847a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4254a422d7ef591768698c10b712b41e 3x", "genre": "comic", "nsfw": false, "body": "こんにちは。\n的場梨沙がPに異性としての好意を伝えるモノクロマンガをお願いします。\n好意を伝える流れや設定はりくさんの解釈で、Pは人畜無害そうな中肉中背のオリp、可能であれば好きになった経緯のモノローグ付きでお願いします。\n当初性癖全開でぶちまける予定でしたが、ある程度妄想で満足してしまったのでりくさんにお任せする形にしました。難しければキャンセル後性癖を再送いたします。\nお忙しい中恐れ入りますがご検討いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@riku_chin/works/4", "thumbnail_src": "https://si.imgix.net/a2126ad8/uploads/origins/745a58e2-ea04-403d-bd1e-69da6bd229c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17d522677628571749e22568c57261ad", "thumbnail_srcset": "https://si.imgix.net/a2126ad8/uploads/origins/745a58e2-ea04-403d-bd1e-69da6bd229c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17d522677628571749e22568c57261ad, https://si.imgix.net/a2126ad8/uploads/origins/745a58e2-ea04-403d-bd1e-69da6bd229c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5974701ca7f3d5d1e08147325da1d6e 2x, https://si.imgix.net/a2126ad8/uploads/origins/745a58e2-ea04-403d-bd1e-69da6bd229c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe66a44e5a06bc330c265c51702565f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@riku_chin/works/3", "thumbnail_src": "https://si.imgix.net/c237d541/uploads/origins/ce8b898c-b304-42fd-8c9d-386b6736f325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=625382f850087ecc6a5d7d7d3fcd1ce4", "thumbnail_srcset": "https://si.imgix.net/c237d541/uploads/origins/ce8b898c-b304-42fd-8c9d-386b6736f325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=625382f850087ecc6a5d7d7d3fcd1ce4, https://si.imgix.net/c237d541/uploads/origins/ce8b898c-b304-42fd-8c9d-386b6736f325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ec3587db2e4c31c75d21ad8ccab9c6d 2x, https://si.imgix.net/c237d541/uploads/origins/ce8b898c-b304-42fd-8c9d-386b6736f325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d68e650c9f4fcad66ccb397c7711a6f8 3x", "genre": "art", "nsfw": true, "body": "デレスタの白菊ほたるのエッチな絵が見たいです。\nプロデューサーに送るために、お尻を突き出して直接写真を撮っています。\n表情は少し恥ずかしがっています。\n下着の色は黒でお願いします。\n\n衣装\nhttps://hidamarirhodonite.kirara.ca/spread/101067.png\n\n参考資料\nhttps://www.pixiv.net/artworks/88050036", "created_at": "", "completed_at": ""}, {"path": "/@riku_chin/works/2", "thumbnail_src": "https://si.imgix.net/898193c0/uploads/origins/184dae6e-911d-4c4a-b920-7de6855a0629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd6226bb49181d010fb5ab3622986360", "thumbnail_srcset": "https://si.imgix.net/898193c0/uploads/origins/184dae6e-911d-4c4a-b920-7de6855a0629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd6226bb49181d010fb5ab3622986360, https://si.imgix.net/898193c0/uploads/origins/184dae6e-911d-4c4a-b920-7de6855a0629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30c2f404b2284d519e4512e9ae24c14c 2x, https://si.imgix.net/898193c0/uploads/origins/184dae6e-911d-4c4a-b920-7de6855a0629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4782550f771f186cd24360e3a2878c11 3x", "genre": "comic", "nsfw": true, "body": "先日の即売会でお願いしたアナログスケブがすごく良く、依頼させていただきました。\n\nサキュバスコスの梨沙ちゃんと、下着（下は脱がされた状態）の晴ちゃんのモノクロ百合えっち漫画をお願いできますか？\n\n・目が覚めたらリボンで両手首を拘束されていた晴ちゃん\n・梨沙ちゃんにあそこに吸い付かれてクンニされ、必死に我慢するもイかされて（精気を奪われて）しまう、\nという流れです。手の拘束以外道具無しだと有難いです。ページ数はお任せします。\n\n以下は、料金の範囲で取り入れられる部分だけお願いします。\n\n・クンニ開始直前に、晴ちゃんのあそこに唇を近けて、舌なめずりしながら『美味しそうな精気・・・吸引♥️』という梨沙ちゃんの台詞を入れて欲しいです。\n・上のコマに続いて、3コマくらいに渡って突き出した唇を晴ちゃんのあそこに徐々に近付けていく描写を入れて欲しいです。\n・精気を奪われまいと我慢する→晴ちゃんの太ももをがしっと抱えて逃げられなくし、より吸い付きを強くする→果ててしまう、という感じです\n・晴ちゃんをイカせた(精気を奪った)あと、恍惚とした表情の晴ちゃんに見せつけるようにごくりと精気を飲み込み、唇を手でぬぐった後『ごちそうさま♥️』という台詞をお願いしたいです。\n\n特殊なシチュで申し訳ありません。また地雷等ありましたら遠慮なくキャンセルしてくださいませ。もしお受けいただけるようでしたら、是非ともよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@riku_chin/works/1", "thumbnail_src": "https://si.imgix.net/85b59da5/uploads/origins/9b05626d-7e17-420d-8e2c-c6a63f0e68b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe1b2db0de8102f962fd49e1257ea9fa", "thumbnail_srcset": "https://si.imgix.net/85b59da5/uploads/origins/9b05626d-7e17-420d-8e2c-c6a63f0e68b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe1b2db0de8102f962fd49e1257ea9fa, https://si.imgix.net/85b59da5/uploads/origins/9b05626d-7e17-420d-8e2c-c6a63f0e68b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bfab039af989cc704e83759252bd525 2x, https://si.imgix.net/85b59da5/uploads/origins/9b05626d-7e17-420d-8e2c-c6a63f0e68b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de71bfce92095236769468fd73e6da7f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}