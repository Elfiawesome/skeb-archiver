auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5565959b4ed63260de299d802c1b11ff 2x, https://si.imgix.net/9fb72346/uploads/origins/caa6ed23-e673-4498-8cf2-47490b483764?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=997550c93b0533628d1c5daebe89719a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/116", "thumbnail_src": "https://si.imgix.net/aca9e803/uploads/origins/7793e355-480f-439a-a5dd-315b59105b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47dc49b4c6a1d809b9eefc6a42392c6b", "thumbnail_srcset": "https://si.imgix.net/aca9e803/uploads/origins/7793e355-480f-439a-a5dd-315b59105b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47dc49b4c6a1d809b9eefc6a42392c6b, https://si.imgix.net/aca9e803/uploads/origins/7793e355-480f-439a-a5dd-315b59105b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca3b13ce4056ea3f893b501ae6b5b7f6 2x, https://si.imgix.net/aca9e803/uploads/origins/7793e355-480f-439a-a5dd-315b59105b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2fdf1260c7c10758ab3f8a22047d0d0 3x", "genre": "comic", "nsfw": true, "body": "以前描かれた温泉大石泉が良かったのでリクエストさせてください。\n泉が温泉に入っていたら実は混浴で後から入ってきたオッサン達に輪姦されるコミックをお願いします。\n「身体を洗ってあげる」とオッサン達に胸を吸われ、腋やアソコ（パイパン）、アナルなど身体中を舐められる。\nそして「今度はこれで中を洗ってあげるよ」とチンコに囲まれアソコとアナルに二穴挿入される。\n元イラストのような巨尻と胸は文香のような巨乳+陥没乳首でお願いします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/115", "thumbnail_src": "https://si.imgix.net/2427100f/uploads/origins/6851d4af-21a6-4ee1-ad25-0ab54dece016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b09b27ebe4f27542eab3fa6b90a3096", "thumbnail_srcset": "https://si.imgix.net/2427100f/uploads/origins/6851d4af-21a6-4ee1-ad25-0ab54dece016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b09b27ebe4f27542eab3fa6b90a3096, https://si.imgix.net/2427100f/uploads/origins/6851d4af-21a6-4ee1-ad25-0ab54dece016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e9887289c17a7b7570eabfc6cf45258 2x, https://si.imgix.net/2427100f/uploads/origins/6851d4af-21a6-4ee1-ad25-0ab54dece016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d71dab0e06c51f51e91e34305d5e66eb 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/114", "thumbnail_src": "https://si.imgix.net/d1bad7a4/uploads/origins/499e92f0-90fc-4bec-874a-9cff9c6df819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28905c0ac5f50626c5059e42213cad1b", "thumbnail_srcset": "https://si.imgix.net/d1bad7a4/uploads/origins/499e92f0-90fc-4bec-874a-9cff9c6df819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28905c0ac5f50626c5059e42213cad1b, https://si.imgix.net/d1bad7a4/uploads/origins/499e92f0-90fc-4bec-874a-9cff9c6df819?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=080f3e1fd5676498e1e3ed708d011a70 2x, https://si.imgix.net/d1bad7a4/uploads/origins/499e92f0-90fc-4bec-874a-9cff9c6df819?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5304e1fbd16acf6f9114f73e2247976f 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、先生の絵を見て魅力を感じこの度初めて依頼をお送りします\n参考：https://x.com/nozarasi_s/status/1790740839435796554/photo/1\n上記の絵と同じような、色は無しの軽い絵柄で佐々木千枝と佐城雪美の3Pインピオコミックを依頼します\n【ショタ】\n容姿は純真な美少年のイメージを希望しますが、メカクレでも大丈夫です\n【シチュエーション】\n※3人とも全裸。ショタの描写は必要最小限でOKです\n・2人がかりでショタと舌を絡ませるディープキス\n・Wフェラ\n・2人に顔面騎乗クンニされる\n・2人と正常位セックス\n以上でご検討のほどよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/113", "thumbnail_src": "https://si.imgix.net/3c599457/uploads/origins/15947a4b-2d15-44d8-a616-1c4a38b6b0b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da34a959cf432de6dd01a8bd63440a7", "thumbnail_srcset": "https://si.imgix.net/3c599457/uploads/origins/15947a4b-2d15-44d8-a616-1c4a38b6b0b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da34a959cf432de6dd01a8bd63440a7, https://si.imgix.net/3c599457/uploads/origins/15947a4b-2d15-44d8-a616-1c4a38b6b0b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac5f007a6e69d789005e1bdef1853558 2x, https://si.imgix.net/3c599457/uploads/origins/15947a4b-2d15-44d8-a616-1c4a38b6b0b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a57afccd3ec2b191fb45c3ceb0e12600 3x", "genre": "comic", "nsfw": true, "body": "借金コスプレ杏姫様\nウマ娘のダスカ\n元ネタを知らない設定\n「なんだこのフリフリは…」\n\n前回と同じく咥え煙草に乳房露出コスで\n黒乳首・母乳・ボテ腹verも\n中出し山盛りで\n\n竿役も同じ粗チン小男\n口ではツンツンしながらも感じまくり・孕みまくり\n\n「粗チンで種馬気取りかよ」\n\n11人産んで12人目をお腹に孕みながら、呆れ半分嬉しさ半分フィニッシュ\n\n「誰が孕みたがりの繁殖牝馬だよ！」\n「マジで11匹産ませる奴がいるかよ…ったく」\n\nアナル中出しの後に竿役が杏姫の尻穴に口をつけて直接食糞するプレイもお願いします\n怒りながら結局気持ちよくなって癖になってしまうオチ\n\n「ボロの掃除って…ふざけんな！」", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/112", "thumbnail_src": "https://si.imgix.net/0857277f/uploads/origins/646300a2-b699-4e13-a869-03247d99a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a832b411dbd7a1b878e4e06e003e21e", "thumbnail_srcset": "https://si.imgix.net/0857277f/uploads/origins/646300a2-b699-4e13-a869-03247d99a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a832b411dbd7a1b878e4e06e003e21e, https://si.imgix.net/0857277f/uploads/origins/646300a2-b699-4e13-a869-03247d99a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=772e152e625c5e931efc3b7276fd631a 2x, https://si.imgix.net/0857277f/uploads/origins/646300a2-b699-4e13-a869-03247d99a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02d17e2acfcbad3423d7a1f694679802 3x", "genre": "art", "nsfw": true, "body": "・キャラクター\n五条橋皐月\n4月リクエスト内容の続きをお願いします\n\n・シチュ前提\n皐月が父親との娘を出産し、ご主人様と子育てや子作りに励んでいる\nお腹は出産後で普通のサイズに戻っている、ご主人様との子を妊娠してからは大きくなる\n\n・シチュ\nご主人様との騎乗位\n生まれた娘に授乳している時に誘われ、互いに娘を気遣いながらも子作り\n大量に中出しされてご主人様との子を妊娠する\n妊娠してお腹が大きくなってからも家族仲良く愛し合っている\n\n上記以外の箇所はお任せ致します\nよろしくお願いします\n\nhttps://skeb.jp/@nozarasi_s/works/89", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/111", "thumbnail_src": "https://si.imgix.net/33540559/uploads/origins/5577d27d-3927-40ca-afd3-88c9649df681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64513a873ed4ae4eddee7492fbe3c4ca", "thumbnail_srcset": "https://si.imgix.net/33540559/uploads/origins/5577d27d-3927-40ca-afd3-88c9649df681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64513a873ed4ae4eddee7492fbe3c4ca, https://si.imgix.net/33540559/uploads/origins/5577d27d-3927-40ca-afd3-88c9649df681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9585d534cc4c1d86df47f59fd9fbe8e7 2x, https://si.imgix.net/33540559/uploads/origins/5577d27d-3927-40ca-afd3-88c9649df681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c922296246f1c17251992842c722913b 3x", "genre": "art", "nsfw": true, "body": "いつもリクエストに応えていただきありがとうございます。\n今回は学マスから姫崎莉波さんをお願いします。\nシチュエーションは、\n「生徒会の仕事中に学園の不正の証拠（資金援助のために売れないアイドルを裏組織に売却）を見つけてしまい、口封じのために裏組織の中でもマニアックな部門に売却される」となります。\n・二度と表に出られない様に爆乳＋短小ふたなりに改造\n・エロ蹲踞拘束\n・ボテ腹\n・射精＋母乳噴射＋脱糞\n・股間には数本のバイブ\n・鎖付き首輪\n・「助けて」「もう嫌」みたいに嫌がりながら涙目\nPに出会ってない世界線で彼女自身も芽が出ていないので「人気者になれて良かったな」と揶揄されてる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nozarasi_s/works/110", "thumbnail_src": "https://si.imgix.net/bf659981/uploads/origins/33fea3b7-8bde-4b95-8e71-40ed9da12b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dda112d93297b6474ddac71c8f9b65e2", "thumbnail_srcset": "https://si.imgix.net/bf659981/uploads/origins/33fea3b7-8bde-4b95-8e71-40ed9da12b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dda112d93297b6474ddac71c8f9b65e2, https://si.imgix.net/bf659981/uploads/origins/33fea3b7-8bde-4b95-8e71-40ed9da12b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18edfd3967d080c9c3d95396c387df15 2x, https://si.imgix.net/bf659981/uploads/origins/33fea3b7-8bde-4b95-8e71-40ed9da12b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=438d9b7ecb608c098e8acbe249f736a3 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}