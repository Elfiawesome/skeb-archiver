78-2bab483baa2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa13940f669e99ec40f4c87e9a79598d, https://si.imgix.net/7bf367d7/uploads/origins/dd725b28-baf0-4c0a-b978-2bab483baa2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4fc41a17565e33c3f77b526b73c733e 2x, https://si.imgix.net/7bf367d7/uploads/origins/dd725b28-baf0-4c0a-b978-2bab483baa2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8da78784aded205f94dcaf5fe8ea328 3x", "genre": "art", "nsfw": false, "body": "りなさんまたお久しぶりです！今回は2枚の絵を依頼したいと思います...！\n\n一枚は同じ子、もう一枚は彼女と友達のてぇてぇ絵です。\n\n【キャラ】\n＜その1＞\nhttps://drive.google.com/file/d/1eI_p2cHyZjB5v0CobM7S7FtHmcodRJZl/view?usp=sharing\n服はお任せします。もしご面倒でなければ、前回の服と同じもので構いません。\n\n＜その2＞\nこちらの「てえてえ」へ：\nhttps://drive.google.com/drive/folders/1YDoSsZ_SopkLT8ZHCGeyjBP5pd-ZiHO3?usp=sharing\n二人の服もお任せします...！\n\n【リクエスト内容】\n＜その1＞\n自分へのプレゼントです。\n今の自分と過去の自分、そして「誰」と微笑んで小指を結び、「これからも頑張って生きていこう」と約束したような雰囲気が欲しいです。（過去の自分はポニテにしています）\nもちろん、りなさんがご都合の良い描き方で大丈夫です！\n\nBGM参考：https://www.youtube.com/watch?v=y998K2Zdk5c\n「約束だよ　呼吸の仕方を上手に思い出せないなら\n　約束だよ　呟くように、歌うように、涙を吐き出してよ\n　……\n　あなたが明日も生きたら　誕生日のように暮らしましょう\n　あなたが明日も生きたら　変わらず苦しい日々を見つめ\n　この歌と小指を結んで　あなたは明日も生きていくんだ\n　約束だよ」\n\n＜その2＞\nシチュー：自撮り／プリクラ／女の子のデート（どっちでも大丈夫です！）\nご都合の良い、描きやすい方法で大丈夫です！また、友達にプレゼントしたいので、もし可能であれば人物を別のレイヤーにしていただけると嬉しいです。\n\n複雑すぎて金額が足りない場合はアピールしてください。キャンセルも問題ございません。\nいつもいつも本当にお世話になりありがとうございました！今回もよろしくお願いします...！🙇‍♀️", "created_at": "", "completed_at": ""}, {"path": "/@krsmrina/works/96", "thumbnail_src": "https://si.imgix.net/38535280/uploads/origins/8f2a01eb-48ea-4465-8719-5c5b3a15845a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b904bc4bee6fb953d233b255c0a97b24", "thumbnail_srcset": "https://si.imgix.net/38535280/uploads/origins/8f2a01eb-48ea-4465-8719-5c5b3a15845a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b904bc4bee6fb953d233b255c0a97b24, https://si.imgix.net/38535280/uploads/origins/8f2a01eb