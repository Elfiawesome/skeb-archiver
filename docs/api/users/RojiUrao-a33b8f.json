f68-82d3-3e2aa8abd3c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dafe53242e986f3d7bd88b9b175c5e8", "thumbnail_srcset": "https://si.imgix.net/11146286/uploads/origins/529b812a-783f-4f68-82d3-3e2aa8abd3c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dafe53242e986f3d7bd88b9b175c5e8, https://si.imgix.net/11146286/uploads/origins/529b812a-783f-4f68-82d3-3e2aa8abd3c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8441d6560e8da81b3e0cb35fe3626be6 2x, https://si.imgix.net/11146286/uploads/origins/529b812a-783f-4f68-82d3-3e2aa8abd3c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd1818c825d209a98dde886bda947bec 3x", "genre": "art", "nsfw": false, "body": "Hello.\n\nI'd like to request an illustration of my character\nShe's a 157cm catgirl with pink hair with dark pink highlights in a side ponytail\nhttps://drive.google.com/file/d/1UcwSV1wRfT-5DPNmYY_5TKzlkJjVnHvz/view\n\nPlease draw her with a confident or smug expression.\nAll other details can be up to you.\n\nThank you!\n\nhttps://drive.google.com/drive/folders/1SN-6bv2vt7XirMXYo5J3oLND3UAehMi0", "created_at": "", "completed_at": ""}, {"path": "/@RojiUrao/works/15", "thumbnail_src": "https://si.imgix.net/624585a3/uploads/origins/c1ecac25-4073-428c-a2d8-50b04855a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f756892cb18fd5f88003f71dd79b1925", "thumbnail_srcset": "https://si.imgix.net/624585a3/uploads/origins/c1ecac25-4073-428c-a2d8-50b04855a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f756892cb18fd5f88003f71dd79b1925, https://si.imgix.net/624585a3/uploads/origins/c1ecac25-4073-428c-a2d8-50b04855a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7247a844bc8ac4c4cfc64d462326e5da 2x, https://si.imgix.net/624585a3/uploads/origins/c1ecac25-4073-428c-a2d8-50b04855a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f678ac2d2bd0f7ae4e00846de3056ca8 3x", "genre": "art", "nsfw": false, "body": "I saw your illustration of Aoi on your Twitter feed, and I thought I'd like to request an illustration of her because I liked her expression and shading.\nI would like to ask for an illustration of Ayla from the game \"Shadowverse\". I would like her expression to be relaxed and cheerful, and I will leave the composition to you.\nThank you in advance for your cooperation.\n\nhttps://onj-shadowverse.game-info.wiki/d/%E5%AB%A4%CE%CE%B5%B7%F5%BB%CE%A1%A6%A5%A2%A5%A4%A5%E9", "created_at": "", "completed_at": ""}, {"path": "/@RojiUrao/works/14", "thumbnail_src": "https://si.imgix.net/102bd2eb/uploads/origins/c7a30106-2ecd-41a4-9be0-e7a25fefb460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1386cc01884ec47d75977399513688", "thumbnail_srcset": "https://si.imgix.net/102bd2eb/uploads/origins/c7a30106-2ecd-41a4-9be0-e7a25fefb460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1386cc01884ec47d75977399513688, https://si.imgix.net/102bd2eb/uploads/origins/c7a30106-2ecd-41a4-9be0-e7a25fefb460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b09ba7d722d6106f23b30274ac929e5 2x, https://si.imgix.net/102bd2eb/uploads/origins/c7a30106-2ecd-41a4-9be0-e7a25fefb460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70b597fcdcd1c3e3526ad624610a5bfc 3x", "genre": "art", "nsfw": false, "body": "Hello, thank you for the previous work. \nI would like to ask for another work with the same character: https://imgur.com/a/GVcb591\n\nI would like my OC to wear a fancy dress this time. May idea is an elegant and sexy dress.\nSomething inspired from below:\nhttps://twitter.com/ydh2101/status/1571775783156486145/photo/1\n\nChanges:\nThe entire arm are fully exposed, or only a little bit clothed. (hand gloves is fine)\nNo cape\nThe big crown is not necessary but I would like some small crown. Or hair accessories.\n\nThe pose I leave to you but I would like it to show her head to below her knees.\n\nThank you!", "created_at": "", "completed_at": ""}, {"path": "/@RojiUrao/works/13", "thumbnail_src": "https://si.imgix.net/ad53b3c2/uploads/origins/73a2738d-df5e-410e-8292-b2fbe9dc23d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de13e0267a5547c4fece859db3a0880", "thumbnail_srcset": "https://si.imgix.net/ad53b3c2/uploads/origins/73a2738d-df5e-410e-8292-b2fbe9dc23d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de13e0267a5547c4fece859db3a0880, https://si.imgix.net/ad53b3c2/uploads/origins/73a2738d-df5e-410e-8292-b2fbe9dc23d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b09af3219276df24c006c47e72dd547 2x, https://si.imgix.net/ad53b3c2/uploads/origins/73a2738d-df5e-410e-8292-b2fbe9dc23d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78b725894513489410a939dbdcb4c111 3x", "genre": "art", "nsfw": false, "body": "Hello, your work is very beautiful, I am a vtuber still in preparation, I hope to have a transparent separation layer for youtube or twitter, the rest can be left to the artist to play freely, thank you\n\nhttps://drive.google.com/file/d/1faOeMLgsJ5WLVxHECl_6tARj7ePA48Tk/view?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@RojiUrao/works/12", "thumbnail_src": "https://si.imgix.net/92cb4ee8/uploads/origins/b5a772e3-0bbf-4f31-bb57-3a6e0038f034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e2dec5e50476e9a24499e68cb14b91f", "thumbnail_srcset": "https://si.imgix.net/92cb4ee8/uploads/origins/b5a772e3-0bbf-4f31-bb57-3a6e0038f034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e2dec5e50476e9a24499e68cb14b91f, https://si.imgix.net/92cb4ee8/uploads/origins/b5a772e3-0bbf-4f31-bb57-3a6e0038f034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w