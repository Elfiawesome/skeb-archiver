もお任せします。また、構図にごろつきを組み込む場合もデザインについては簡略化したもので構いません\n\n\nご検討頂けると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@mikazu_satsuki/works/26", "thumbnail_src": "https://si.imgix.net/cce2fbac/uploads/origins/c4469fc4-d873-4e24-b5ef-22fd43103df2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae997963c745c14f50bece6dd43f4100", "thumbnail_srcset": "https://si.imgix.net/cce2fbac/uploads/origins/c4469fc4-d873-4e24-b5ef-22fd43103df2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae997963c745c14f50bece6dd43f4100, https://si.imgix.net/cce2fbac/uploads/origins/c4469fc4-d873-4e24-b5ef-22fd43103df2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=331f2d18809f141cb6200b37a58b8863 2x, https://si.imgix.net/cce2fbac/uploads/origins/c4469fc4-d873-4e24-b5ef-22fd43103df2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b93f43a0339b2ee79a9bf741eb5f6b84 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mikazu_satsuki/works/25", "thumbnail_src": "https://si.imgix.net/f4f9d3cc/uploads/origins/23933bf6-58fb-4601-b64a-d43546c01ddf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d6f781b3ae9fb9b94621634eddaabde", "thumbnail_srcset": "https://si.imgix.net/f4f9d3cc/uploads/origins/23933bf6-58fb-4601-b64a-d43546c01ddf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d6f781b3ae9fb9b94621634eddaabde, https://si.imgix.net/f4f9d3cc/uploads/origins/23933bf6-58fb-4601-b64a-d43546c01ddf?bg=%23fff&auto=format%2Ccompress&fm=webp