n=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=848fed86640fb0458712afc868a2d7d8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/57", "thumbnail_src": "https://si.imgix.net/fdd3f7d7/uploads/origins/b8eceb28-df9b-47e3-856e-29a915924871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea30220b8542aabaa200f96c353283ca", "thumbnail_srcset": "https://si.imgix.net/fdd3f7d7/uploads/origins/b8eceb28-df9b-47e3-856e-29a915924871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea30220b8542aabaa200f96c353283ca, https://si.imgix.net/fdd3f7d7/uploads/origins/b8eceb28-df9b-47e3-856e-29a915924871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e373e87a82cfc6b2480be8347bf75c9f 2x, https://si.imgix.net/fdd3f7d7/uploads/origins/b8eceb28-df9b-47e3-856e-29a915924871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98ec25a1de83b3013d8c5e6a4823ed73 3x", "genre": "art", "nsfw": false, "body": "はじめまして、先生の絵から感じる柔らかい表現から溢れる可愛さに惹かれてご依頼させていただきたくこの文を書いております。\n依頼したいキャラがイナズマイレブンのアイシーというキャラになります。凍地愛とも言います。\n要望としては制服（黒セーラー服、リボンが赤）を着ていたら嬉しいです。\nその他の構図等は全てお任せします\nご検討のほどよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/56", "thumbnail_src": "https://si.imgix.net/61f6440b/uploads/origins/ef1dbaab-a671-4a2c-8a26-c8f4e66ec888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f55b7eb0e384d5538b7eafb76f70800", "thumbnail_srcset": "https://si.imgix.net/61f6440b/uploads/origins/ef1dbaab-a671-4a2c-8a26-c8f4e66ec888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f55b7eb0e384d5538b7eafb76f70800, https://si.imgix.net/61f6440b/uploads/origins/ef1dbaab-a671-4a2c-8a26-c8f4e66ec888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=392a098147b5e0e3113bdfd8dd8ec216 2x, https://si.imgix.net/61f6440b/uploads/origins/ef1dbaab-a671-4a2c-8a26-c8f4e66ec888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3706b4f4c099dd658932245519652cb8 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nいつもXにて悠むぐ先生の素敵な作品を拝見しております。\nキャラクターの可愛さはもちろん、その豊かな表情や細やかな仕草の表現が本当に素晴らしく、いつも楽しく拝見しております…！\n\nこの度、セイウンスカイ（ウマ娘）の夏らしい水着イラストをお願いしたく、リクエストさせていただきました。\nイメージとしては、トレーナーと一緒に海へ遊びに来て、着替えを終えたスカイちゃんが、恥ずかしそうにビキニ姿を見せに来た…というようなシチュエーションです。構図はトレーナー目線で、トレーナー自身は描かず、スカイちゃんの全身がわかる形でお願いできれば嬉しいです。\n\n表情は、照れているような、少し恥ずかしげな雰囲気だと嬉しいです。\nポーズや背景、ビキニのデザインなどは、悠むぐ先生にお任せいたします。\n\nお忙しいところ恐れ入りますが、ご検討いただけますと嬉しいです。\nどうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/55", "thumbnail_src": "https://si.imgix.net/7bc36539/uploads/origins/e5692edd-31ef-49df-9e4d-9e9474002edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cec8cd319fc0c85fb5c57d52d4d587e", "thumbnail_srcset": "https://si.imgix.net/7bc36539/uploads/origins/e5692edd-31ef-49df-9e4d-9e9474002edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cec8cd319fc0c85fb5c57d52d4d587e, https://si.imgix.net/7bc36539/uploads/origins/e5692edd-31ef-49df-9e4d-9e9474002edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=022862d9f942ca3a07c29f132272712f 2x, https://si.imgix.net/7bc36539/uploads/origins/e5692edd-31ef-49df-9e4d-9e9474002edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f80739b229ceae43e94bfab723c9042d 3x", "genre": "art", "nsfw": false, "body": "DOAシリーズのマリー・ローズちゃんをお願いします。\nシチュエーションは、以前書かれていた\nhttps://x.com/yu_mugu/status/1919706566703370335?s=46&t=bb_80N6Q-rpHte2EeqOmXQ\nのことねのようなイメージで、\n着ていた制服の前部分を開けて内側に着込んでいた戦闘服姿になって臨戦体勢に入ろうとしている感姿\n（いわゆるスーパーマンが服を脱いで戦闘形態に入る感じ、でお願いします）\n制服↓\nhttps://drive.google.com/file/d/1b4NgDKHQEPbCdc1jLv0FP_eu_lCLdB2I/view?usp=drivesdk\nhttps://drive.google.com/file/d/1_myT6_Ku_iYh6L20i8TKUeCvAXRXCBUU/view?usp=drivesdk\n戦闘服↓\nhttps://drive.google.com/file/d/1u0MEuGjv8e-oA0rbXvzjtnXasCdxqYDA/view?usp=drivesdk\nhttps://drive.google.com/file/d/1ynFSQnCR-REZxErhXFfnR3HWTg0224xi/view?usp=drivesdk\n\n体型は先生が時々描かれているような篠澤さんのようなぺったんこなスレンダー体型。\n表情は不敵な笑み＋舌ペロで「今からやっつけてやるから」とイタズラっぽか考えていそうな雰囲気でお願いします。\n\n3Dゲームのキャラクターですが、先生の絵柄でぜひお願いします！\n\nhttps://www.gamecity.ne.jp/doa6/chara_marie.html", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/54", "thumbnail_src": "https://si.imgix.net/81adaffc/uploads/origins/75581e0d-fe9e-4bf3-bb23-f3f077507719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316161d4c3da801e534cfaf81fd95ac6", "thumbnail_srcset": "https://si.imgix.net/81adaffc/uploads/origins/75581e0d-fe9e-4bf3-bb23-f3f077507719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316161d4c3da801e534cfaf81fd95ac6, https://si.imgix.net/81adaffc/uploads/origins/75581e0d-fe9e-4bf3-bb23-f3f077507719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3fc77ee274581b2bd1dd1b2b149e630 2x, https://si.imgix.net/81adaffc/uploads/origins/75581e0d-fe9e-4bf3-bb23-f3f077507719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c95ba06234cb6d2c672eec5493125d4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/53", "thumbnail_src": "https://si.imgix.net/7e847117/uploads/origins/68ed9d37-7691-4909-b01b-951c8e371d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16374408486f6fb0477719a7684fd07f", "thumbnail_srcset": "https://si.imgix.net/7e847117/uploads/origins/68ed9d37-7691-4909-b01b-951c8e371d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16374408486f6fb0477719a7684fd07f, https://si.imgix.net/7e847117/uploads/origins/68ed9d37-7691-4909-b01b-951c8e371d91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57a91517cc85dcfaad6c6d03308bab52 2x, https://si.imgix.net/7e847117/uploads/origins/68ed9d37-7691-4909-b01b-951c8e371d91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=387eed069f7c419983d8b1ea7cec1a9e 3x", "genre": "art", "nsfw": false, "body": "悠むぐ先生はじめまして！HiBiKIと申します。\n悠むぐ先生の描かれるイラストが大好きで、この度リクエストを送らせていただきました。\nVtuberの「紫雨るか」さんを描いていただきたいです。\n\n衣装はバニー衣装（ジャケットを羽織る形）でお願いしたいです。\nジャケットは紫雨るかさんが着用されているものを参考に、\n短丈のものにアレンジした形でお願いしたいです。\n\n構図やポーズに関しては、片方の脇が見えてたらいいな…程度のイメージしかないのと、\n僕自身が悠むぐ先生の描かれる構図やポーズが大好きなので、\nぜひ悠むぐ先生にお任せしたいと思っています。\n\nまた、可能であれば表情差分もいくつかお願いできたら助かります。\n完成した作品は紫雨るかさんのVTuber活動での使用許可をいただけるとありがたいです。\n\nどうかご縁がありますように…！\n\n紫雨るかさん\nhttps://x.com/shigure_ruka/status/1874819585410798062", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/52", "thumbnail_src": "https://si.imgix.net/029622aa/uploads/origins/048aa577-1379-4dd7-8a1a-9418d9b8a6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed2eed3d6b7de7bfdc086b014bbe38e", "thumbnail_srcset": "https://si.imgix.net/029622aa/uploads/origins/048aa577-1379-4dd7-8a1a-9418d9b8a6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed2eed3d6b7de7bfdc086b014bbe38e, https://si.imgix.net/029622aa/uploads/origins/048aa577-1379-4dd7-8a1a-9418d9b8a6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cb1d755eda16df666933e71375a4a93 2x, https://si.imgix.net/029622aa/uploads/origins/048aa577-1379-4dd7-8a1a-9418d9b8a6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=686d8474e2694193056c49547a98105f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Yu_Mugu/works/51", "thumbnail_src": "https://si.imgix.net/f9cb0fae/uploads/origins/d9ec33f3-f33f-4f75-a7c0-86a36a1668d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f127097f3cf5bb82d83fc75fe46e77", "thumbnail_srcset": "https://si.imgix.net/f9cb0fae/uploads/origins/d9ec33f3-f33f-4f75-a7c0-86a36a1668d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f127097f3cf5bb82d83fc75fe46e77, https://si.imgix.net/f9cb0fae/uploads/origins/d9ec33f3-f33f-4f75-a7c0-86a36a1668d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69728a100f0158a0c14b1696cbfbd191 2x, https://si.imgix.net/f9cb0fae/uploads/origins/d9ec33f3-f33f-4f75-a7c0-86a36a1668d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41f2b59b7034be0768f2bd34c9269b35 3x", "genre": "art", "nsfw": false, "body": "平素はお世話になっております\n早速ですが、リクエストを送ります\n\n・キャラクター\n\n涼風涼（資料１：https://natalie.mu/comic/gallery/news/630466/2515049 ）\n\n※ 原作はhttps://manga.nicovideo.jp/comic/53991 から読めます\n\n・衣装と髪型\n\n資料１と同じ\n\n・ポーズと構図\n\n資料２：https://assets.clip-studio.com/ja-jp/detail?id=2138937 の左上にある、大きく映っている方の3Dモデルと同じポーズと構図\n\n・見え方と着こなし\n\n１．口は右手に隠れて見えない\n２．袖の長いカーディガンを着ているが、手はカーディガンから出ている\n３．少なくとも、資料２の左上にある大きく映っている方の3Dモデルと同じく、腰とそれより上はキャンバスから見切れずに映る。できれば、資料２の左上にある小さく映っている方の3Dモデルのように、全身がキャンバスから見切れないように描いて頂けると有難いですが、金額やイラスト全体としての見栄えなどに応じてお任せします\n\n・表情/顔向き/視線\n\n両目を開け、頬に汗を一滴垂らして赤面しつつ、困り顔＆困り眉で恥じらっている表情。また、普段は（生まれつき）目つきが悪いキャラですが、今回は女の子の恥じらいの表情に似合う可愛い目つきにしてください\n\n顔向きは資料２と同じにし、視線は\n\n１．イラストを見ている側に向けている\n２．恥ずかしそうに、イラストを見ている側から逸らしている\n\nの二種類を収録して下さい\n\n・背景\n\n単色以外。シンプルな模様とかでも構いません\n\n・納品時のデータ形式\n\n衣装を含むキャラクターを囲う最小の枠が、短辺2160px以上、長辺3840px以上の、差分の切り替えや主要な