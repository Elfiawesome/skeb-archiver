da-bda1-ec4fa41c1886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0e6b8e41b8690a562ffe3ac4ac2f9d3 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のOC（アングイラ）を描いていただけませんか？瞳孔がハート型で、オレンジ色のバニースーツに身を包みながら、胸の谷間のニンジンを見て唇をなめています。彼女の腕は胸を押し上げることもできます。\n\nもしそうなら、それは素晴らしいことだ！\n\nhttps://drive.google.com/drive/folders/18YS5OS1pzAZ5TQwlhu5Q7CEw-4L6d34O?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/14", "thumbnail_src": "https://si.imgix.net/6078ed83/uploads/origins/aacfbc8d-f5ed-4918-acce-0de88b95ec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fda56c19bb5fd46304a5d7d4d1820be", "thumbnail_srcset": "https://si.imgix.net/6078ed83/uploads/origins/aacfbc8d-f5ed-4918-acce-0de88b95ec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fda56c19bb5fd46304a5d7d4d1820be, https://si.imgix.net/6078ed83/uploads/origins/aacfbc8d-f5ed-4918-acce-0de88b95ec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd4ca8e80a7054456c74613886308f02 2x, https://si.imgix.net/6078ed83/uploads/origins/aacfbc8d-f5ed-4918-acce-0de88b95ec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72c0e139e37e57cdb09de9fc6e39d860 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアピールに感謝します。私のOC（アングイラ）の瞳孔をハート型にして、胸の谷間まで届く長い舌を出しているところを描いてもらえますか？(舌は緑色で、リファレンスのひとつに、彼女の瞳孔がどのように形を変えるかが載っています）。\n\nもしそうなら、それは素晴らしいことです！\n\nhttps://drive.google.com/drive/folders/18YS5OS1pzAZ5TQwlhu5Q7CEw-4L6d34O?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/13", "thumbnail_src": "https://si.imgix.net/264ba89c/uploads/origins/6f5ca41f-af74-42f9-9788-cf79d616051e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7acb60f89d3f1ce508591d14a512c1cd", "thumbnail_srcset": "https://si.imgix.net/264ba89c/uploads/origins/6f5ca41f-af74-42f9-9788-cf79d616051e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7acb60f89d3f1ce508591d14a512c1cd, https://si.imgix.net/264ba89c/uploads/origins/6f5ca41f-af74-42f9-9788-cf79d616051e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb32887d1d6d01caad55a8cd607856da 2x, https://si.imgix.net/264ba89c/uploads/origins/6f5ca41f-af74-42f9-9788-cf79d616051e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13d610effde45a6973fd76ba03642311 3x", "genre": "art", "nsfw": false, "body": "アピールしてくれてありがとう。\nシリスの活躍を楽しみにしています。\n彼女は地獄から来た悪魔のようなサキュバス・バニーだ。\n彼女と楽しんでください！\nhttps://drive.google.com/drive/u/1/folders/1TdRT0m99CiFW5K15wxZLldZbIsTVGb7Q", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/12", "thumbnail_src": "https://si.imgix.net/7701b242/uploads/origins/fc44ac01-e168-4ee3-b503-7a280b5b07d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c141fd670dbe14ac4ae8f7a87e617538", "thumbnail_srcset": "https://si.imgix.net/7701b242/uploads/origins/fc44ac01-e168-4ee3-b503-7a280b5b07d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c141fd670dbe14ac4ae8f7a87e617538, https://si.imgix.net/7701b242/uploads/origins/fc44ac01-e168-4ee3-b503-7a280b5b07d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=227ca1927faf390cc21d7f992d5044ed 2x, https://si.imgix.net/7701b242/uploads/origins/fc44ac01-e168-4ee3-b503-7a280b5b07d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30a3cb4faa68ac4a75c3e5ee771aba2d 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n素晴らしい作品が欲しいです：グンドゥーラ・ラル（『ブレイブウィッチーズ』より）。\nhttps://www.foriio.com/works/678881 のようなポーズとアングルのグンドゥラを希望します。\nグンドゥラは耳と尻尾のあるいつもの服装で、手にはピストル（拳銃）を持っている姿でお願いします。\nグンドゥラは暗い嵐の雲（遠景）の方を見ていてほしい。\nその他、どんな細かいことでも、あなたの裁量にお任せします。\n本当にありがとうございました！💕", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/11", "thumbnail_src": "https://si.imgix.net/a4d76786/uploads/origins/e51b5b63-80e3-4d35-9355-7b78271d0788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81547c282225a65e71f040f12da1fd87", "thumbnail_srcset": "https://si.imgix.net/a4d76786/uploads/origins/e51b5b63-80e3-4d35-9355-7b78271d0788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81547c282225a65e71f040f12da1fd87, https://si.imgix.net/a4d76786/uploads/origins/e51b5b63-80e3-4d35-9355-7b78271d0788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c239bd305d930560d63c5c529df5d28 2x, https://si.imgix.net/a4d76786/uploads/origins/e51b5b63-80e3-4d35-9355-7b78271d0788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cf4ab3f9ac1d39f6347ce4fe4db466e 3x", "genre": "art", "nsfw": false, "body": "初めまして、アピールありがとうございます。リクエストさせていただきます。\n\nアピール通りに下記URLと同じ潜水服を装備して水中を潜っているイラストを描いていただきたいです。\n\nhttps://skeb.jp/@smile_messiyOC/works/44\nhttps://www.pixiv.net/artworks/106831597\n\nこの潜水服を装備させていただきたいキャラは「アイドルマスター」の萩原雪歩です。\n\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/10", "thumbnail_src": "https://si.imgix.net/94f222e4/uploads/origins/7a48ccd0-aed0-4126-9597-6d6593720a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a235a0b8a582c4eb8a113580e177b45b", "thumbnail_srcset": "https://si.imgix.net/94f222e4/uploads/origins/7a48ccd0-aed0-4126-9597-6d6593720a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a235a0b8a582c4eb8a113580e177b45b, https://si.imgix.net/94f222e4/uploads/origins/7a48ccd0-aed0-4126-9597-6d6593720a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5af06329040a12ce19c75e2b11114bc7 2x, https://si.imgix.net/94f222e4/uploads/origins/7a48ccd0-aed0-4126-9597-6d6593720a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6f1f635210c56a4df5c2e337df6141d 3x", "genre": "art", "nsfw": false, "body": "アピールにお応えし、依頼させて頂きます。\n\n今回は私が一番好きなキャラクターである、まほらばという漫画の水無月夕（以下夕ちゃん）をお願いします。\n夕ちゃんがお月見している様子を、構図や夕ちゃんの表情などソレルーさんのお任せでお願いしたいと思います。\n\n資料ＵＲＬに夕ちゃんの画像を載せますので、宜しければお願いします。\n\nhttps://www.pixiv.net/artworks/99575991", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/9", "thumbnail_src": "https://si.imgix.net/edd87407/uploads/origins/a2362cab-6c43-4b9b-894f-c96d5cddd28f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbad66bab92659b8e701ac402da4263", "thumbnail_srcset": "https://si.imgix.net/edd87407/uploads/origins/a2362cab-6c43-4b9b-894f-c96d5cddd28f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbad66bab92659b8e701ac402da4263, https://si.imgix.net/edd87407/uploads/origins/a2362cab-6c43-4b9b-894f-c96d5cddd28f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3010a898a9c89b30ad6a840a48910b03 2x, https://si.imgix.net/edd87407/uploads/origins/a2362cab-6c43-4b9b-894f-c96d5cddd28f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b45c7b9f6ac42579e6d69e209ca8c7c 3x", "genre": "art", "nsfw": false, "body": "先月アピールありがとうございました。遅くなりましたが、リクエストさせて頂きます。\n夜は猫といっしょのキュルガがドラゴンボールの筋斗雲に乗っているところをお願いします。構図はおまかせします。\n\n資料貼っておきます↓\nhttps://yoruneko-pr.com/character/", "created_at": "", "completed_at": ""}, {"path": "/@rirba_eR/works/8", "thumbnail_src": "https://si.imgix.net/29275686/uploads/origins/a77d3f17-2540-43a4-ab49-fd6787eac740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920ffb10a8322acdee07e181679886f7", "thumbnail_srcset": "https://si.imgix.net/29275686/uploads/origins/a77d3f17-2540-43a4-ab49-fd6787eac740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920ffb10a8322acdee07e181679886f7, https://si.imgix.net/29275686/uploads/origins/a77d3f17-2540-43a4-ab49-fd6787eac740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10afcd3460264cf2275850427e798a2a 2x, https://si.imgix.net/29275686/uploads/origins/a77d3f17-2540-43a4-ab49-fd6787eac740?bg=%23fff&auto=for