f149cca0/uploads/origins/d061252c-0811-495a-b4ee-a93bfd2d9b55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e383d3401ca24a3a45c70801727dd2e5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ckzn7/works/13", "thumbnail_src": "https://si.imgix.net/9991162a/uploads/origins/1d7f1fee-17b7-4152-b673-174935014174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7df27d470088ccbe31bb23578cf6131", "thumbnail_srcset": "https://si.imgix.net/9991162a/uploads/origins/1d7f1fee-17b7-4152-b673-174935014174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7df27d470088ccbe31bb23578cf6131, https://si.imgix.net/9991162a/uploads/origins/1d7f1fee-17b7-4152-b673-174935014174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f077678006bb8ea03c9e22983c3d5210 2x, https://si.imgix.net/9991162a/uploads/origins/1d7f1fee-17b7-4152-b673-174935014174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b81a8ac2c0864d29a13bbd9a4a6ea068 3x", "genre": "art", "nsfw": false, "body": "件名：バーチャルアーティストのタイポグラフィ依頼 - ILLUMINERIS\n\nCKZN 様\n\nはじめまして。ピクシブにてロゴタグからたどり着き、CKZN様の素晴らしいタイポグラフィデザインに心惹かれました\n\n今回、バーチャルアーティストのアイデンティティとなるタイポグラフィの制作を依頼したく、ご連絡させていただきました\n\nバーチャルアーティスト活動を予定しておりまして、CKZN様の作風にとても共感いたしました バーチャルアーティストのコンセプトは、『SIGNALIS』、『攻殻機動隊 (Ghost in the Shell)』、『弐瓶勉』先生の作品『BLAME!』のような世界観をイメージしており\n\n謎めいた放浪者が果てしなく広がる異世界を旅し、脱出する方法を探す中で、音楽配信やストリーミングができる装置を発見し、バーチャルDTMアーティスト・Vtuberとして活動していく、というものです\n\n今回依頼させていただくタイポグラフィは、「ILLUMINERIS」という英字（ローマ字は大文字希望）を使用し、配信やブランディング、将来的にはインディペンデントなバーチャルアーティストとしての活動においても使用させていただく予定です\nもちろん、\n\nタイポグラフィの制作者としてCKZN様のお名前は常に明記させていただきます\nキャラクターデザインのイメージを合わせていただくため、下記リンクより資料を閲覧いただければ幸いです\n\n[リンク] https://drive.google.com/drive/folders/1xol63jZ24TEzy_HvsvIjJ1PTgMl-u2Gl?usp=drive_link\n\nタイポグラフィは、洗練されたデザインかつ、覚えやすいものにしていただければと思います\n\n何卒、ご検討のほど、よろしくお願い申し上げます", "created_at": "", "completed_at": ""}, {"path": "/@ckzn7/works/12", "thumbnail_src": "https://si.imgix.net/1e901abc/uploads/origins/cf841d12-c660-47f3-ac92-348decc13305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=998ae0afe18b7fd6fbc8b29c08fef34f", "thumbnail_srcset": "https://si.imgix.net/1e901abc/uploads/origins/cf841d12-c660-47f3-ac92-348decc13305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=998ae0afe18b7fd6fbc8b29c08fef34f, https://si.imgix.net/1e901abc/uploads/origins/cf841d12-c660-47f3-ac92-348decc13305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac4995d7ea496a325115a231703e7d21 2x, https://si.imgix.net/1e901abc/uploads/origins/cf841d12-c660-47f3-ac92-348decc13305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69fda647a17c4628a1f0e49500506e7d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ckzn7/works/11", "thumbnail_src": "https://si.imgix.net/53b5e9ed/uploads/origins/f093eb2d-fc6e-40b3-9277-6107f0ccc984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385efa88efe323ca1b4a5b0ed666ffc5", "thumbnail_srcset": "https://si.imgix.net/53b5e9ed/uploads/origins/f093eb2d-fc6e-40b3-9277-6107f0ccc984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385efa88efe323ca1b4a5b0ed666ffc5, https://si.imgix.net/53b5e9ed/uploads/origins/f093eb2d-fc6e-40b3-9277-6107f0ccc984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=382d1