a1f61786f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df976e01634c6209ca7611c61050db9, https://si.imgix.net/c64a70db/uploads/origins/8b8cf446-ad02-44f9-aa10-a10a1f61786f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faac309ee66c84323faf35ad5d821b6b 2x, https://si.imgix.net/c64a70db/uploads/origins/8b8cf446-ad02-44f9-aa10-a10a1f61786f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e88a4a4e9d494189d8cd57e326580616 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n\nイヅナのイラストに惹かれたので\n神羅万象チョコのイラストをお願いしたいです\n\nキャラクター\n四代絶影クオン\nhttps://shinrabansho.com/archive/images/01charalist/card04/086.jpg\n\n構図はおまかせで\nイズナのイラストのような\n胸や太ももが強調されたポーズで\nお願いします。\n\n壁紙に使用したいので横長のイラストで\nお願いします\n\n値段の範囲内で可能であれば眼帯の\n有り無し差分が欲しいです\n(眼帯を外した場合、オッドアイになっているので下記URLを参考にしてください)\nhttps://shinrabansho.com/archive/images/another/card/1001_009.jpg\n\nまた、金額に見合わなければお手数ですが再送して頂けると助かります。\nご検討頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@ma_sakasama/works/856", "thumbnail_src": "https://si.imgix.net/433a3102/uploads/origins/37a31c67-11ac-4ea0-9c70-a8915a17f967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01e16983e2747af2e9aac807d31fd71b", "thumbnail_srcset": "https://si.imgix.net/433a3102/uploads/origins/37a31c67-11ac-4ea0-9c70-a8915a17f967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01e16983e2747af2e9aac807d31fd71b, https://si.imgix.net/433a3102/uploads/origins/37a31c67-11ac-4ea0-9c70-a8915a17f967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf0e2376922cb621993f5047adf3fcad 2x, https://si.imgix.net/433a3102/uploads/origins/37a31c67-11ac-4ea0-9c70-a8915a17f967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2163919eef433c82a7a51ccafbd33f4 3x", "genre": "art", "nsfw": false, "body": "お初にお目にかかります。個人vtuberをしております白兎初羽と申します。\nまっさかさま様の素晴らしいイラストを以前から拝見させていただいておりました。\n\n今回、わたくしのイラストを描いて