fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=566c4b819c5b3408e0c610d5f94f6ce6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ma_sakasama/works/866", "thumbnail_src": "https://si.imgix.net/1396eef8/uploads/origins/c39aa85e-1e59-4e55-905f-8b642a3f6989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3168eccd72e402419f9e9a8d34e8535", "thumbnail_srcset": "https://si.imgix.net/1396eef8/uploads/origins/c39aa85e-1e59-4e55-905f-8b642a3f6989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3168eccd72e402419f9e9a8d34e8535, https://si.imgix.net/1396eef8/uploads/origins/c39aa85e-1e59-4e55-905f-8b642a3f6989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24d73e53af8ac2d9045544fa5a181bcf 2x, https://si.imgix.net/1396eef8/uploads/origins/c39aa85e-1e59-4e55-905f-8b642a3f6989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25099f6c446b9dfdac914dd57e8bbf2b 3x", "genre": "art", "nsfw": false, "body": "まっさかさま先生始めまして!\n先生の描くイラストに魅了されこの度は\nリクエストさせて頂きました!!\n\nリクエスト内容は、先生が過去描かれた\nhttps://skeb.jp/@ma_sakasama/works/829\n様のような等身でうちの子を描いて頂きたいのです!\n\n構図につきましては、上記クライアント様へ納品されたイラストのように「片腕を胸の下に置き、もう片手で懐中時計を持っている構図」をお願いしたいです!!\nそして表情は「上半分が青緑色で下半分が黄色のグラデーションな瞳でジト目」に描いて頂きたく思います!!!\nまた、余裕がありましたら幾つか表情差分or下着差分を描いて貰えますと大変嬉しいですっ\n\n使用用途は主にSNSやTRPGでの立ち絵使用を想定しています!\n\n拙い文章ではありますが、何卒…何卒ご検討頂けると嬉しく思いますっ!!!!\n\nhttps://x.com/ujisan_sky/status/2008703547354083768?s=46&t=6CQcOu45Ba2T9A6rvvC5jQ", "created_at": "", "completed_at": ""}, {"path": "/@ma_sakasama/works/865", "thumbnail_src": "https://si.imgix.net/93bba4d5/uploads/origins/7096527c-6cbf-4876-8f0c-b00a800a48e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1