r=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c28fdef9544df2f52cf1dd0f36870c3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KanahoshiKasane/works/66", "thumbnail_src": "https://si.imgix.net/273604dd/uploads/origins/3098482a-04a6-4ed8-92bc-3b2f9eb77e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1d0c4d339e478b53d7136a75db8b1d", "thumbnail_srcset": "https://si.imgix.net/273604dd/uploads/origins/3098482a-04a6-4ed8-92bc-3b2f9eb77e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1d0c4d339e478b53d7136a75db8b1d, https://si.imgix.net/273604dd/uploads/origins/3098482a-04a6-4ed8-92bc-3b2f9eb77e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4bd7ea1628d6ba96aec1af53d161db0 2x, https://si.imgix.net/273604dd/uploads/origins/3098482a-04a6-4ed8-92bc-3b2f9eb77e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=823f1ac57e491b8adcc37539e0a40b77 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\nTwitterのヘッダー用イラストをお願いしたいです。\n雑魚チワワさんの描く可愛いイラストが大好きなので全てお任せします！！", "created_at": "", "completed_at": ""}, {"path": "/@KanahoshiKasane/works/65", "thumbnail_src": "https://si.imgix.net/ef92c74f/uploads/origins/c288c8e2-6b58-4cd3-80bf-d6b7d44bb395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ce8a212f8fafac7b5fd5a8b2bff9972", "thumbnail_srcset": "https://si.imgix.net/ef92c74f/uploads/origins/c288c8e2-6b58-4cd3-80bf-d6b7d44bb395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ce8a212f8fafac7b5fd5a8b2bff9972, https://si.imgix.net/ef92c74f/uploads/origins/c288c8e2-6b58-4cd3-80bf-d6b7d44bb395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32b6d7c1e5f1594828a70514bda4c675 2x, https://si.imgix.net/ef92c74f/uploads/origins/c288c8e2-6b58-4cd3-80bf-d6b7d44bb395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1f9b2294254c871b0f1415c40c5c5d 3x", "genre": "art", "nsfw": true, "body": "エネマグラを持って言葉責めしてくる扇情的なざこちちゃんのセリフ付きイラストをお願いします…！\nシチュのイメージは、エネマグラを挿入する直前のメスイキ死刑宣告みたいな雰囲気でお願いします！\n\nセリフ例:「今からこの子が、お兄さんの中に入って、お兄さんの1番気持ちいいとこ、ぐいぐいって刺激して気持ちよくしてくれるんだよ〜♡だから、だらしない声いっぱい出して、沢山気持ちよくなってね？♡ザコお兄さ〜ん♡」\n（あくまで依頼内容やセリフの雰囲気がわからなかった時の為の例です！イラストの台詞は、できる限り雑魚チワワ先生の言葉でざこちちゃんのキャラ、表情、心情に合うセリフを考えて頂けたら嬉しい限りです！）", "created_at": "", "completed_at": ""}, {"path": "/@KanahoshiKasane/works/64", "thumbnail_src": "https://si.imgix.net/f677f370/uploads/origins/fff7b367-a4f6-44b8-94e5-4d54f7b76d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86a93a2a3eb77e680dbc93160f54054", "thumbnail_srcset": "https://si.imgix.net/f677f370/uploads/origins/fff7b367-a4f6-44b8-94e5-4d54f7b76d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86a93a2a3eb77e680dbc93160f54054, https://si.imgix.net/f677f370/uploads/origins/fff7b367-a4f6-44b8-94e5-4d54f7b76d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=852804d1203555d06e0706fe80456bf6 2x, https://si.imgix.net/f677f370/uploads/origins/fff7b367-a4f6-44b8-94e5-4d54f7b76d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=079e530395f21f9222e0f8e6e1095401 3x", "genre": "art", "nsfw": true, "body": "こんばんは\n足コキをしているざこちちゃんのイラストをお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@KanahoshiKasane/works/63", "thumbnail_src": "https://si.imgix.net/4722860e/requests/280139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15a6677761c0824179360fc63ca3a861", "thumbnail_srcset": "https://si.imgix.net/4722860e/requests/280139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15a6677761c0824179360fc63ca3a861, https://si.imgix.net/4722860e/requests/280139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=293266b9a