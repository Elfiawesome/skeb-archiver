%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2867359677fcd1b75229ad75bd68a19b", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "♡†🤍ྀི様†♡\n\n初めまして！リクエスト失礼致します。\nぜひ🤍ྀི様の可愛く儚げある絵柄で、私と友人のOC同士を描いて頂けましたら幸いです🎀\nお手数をお掛け致しますが詳細は以下をご確認お願い致します。\n\nཐིཋྀ------------------------------------------------ཐིཋྀ\n\nhttps://drive.google.com/drive/folders/1kWFR0CAFI5NhXcl7W6NHVwOT3QpRrJWU\n\nཐིཋྀ------------------------------------------------ཐིཋྀ\n\n服装などはご自由に描いていただければ嬉しいです†❤︎(詳細内のものでも大丈夫です♡)\n\nここまで目を通していただきありがとうございました🎀\n金額や詳細内での不備等ございましたら キャンセル・再送等よろしくお願い致します。\n\nご縁を祈っております✩.*", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/111", "thumbnail_src": "https://si.imgix.net/e9706226/uploads/origins/268e80dd-af8d-48c5-a18a-621e36718014?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b839348cb2063a540139d0c100d676", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、以前はとっても素敵なイラストをありがとうございました！よろしければ前回と別の創作百合OC2人の絵をリクエストさせてください…！\n\nこちらのリクエストの3人と同じ世界線にいる、OC2人になります！⬇️\nhttps://skeb.jp/@nneiro_/works/106\n\nメイドは愛情の感情を学習するパーツを失ったことにより現在はお嬢様を虐めて楽しむ残酷な子供のような性格になっており、お嬢様はそれを悲しんでいるといった関係のため、以前描いていただいた3人とは違い関係は良好とはいえません。しかしメイドは自分が可愛くあどけないように見せるためにあえてお嬢様に甘えた態度をとる時もあります。\n\n今回も雰囲気や構図等すべておまかせします！本当にNGないのでぜひご自由に描いてください♡ご縁がありましたらよろしくお願いいたします🙏🏻\n\nhttps://drive.google.com/drive/folders/1t3FJ0_rNun0JC5fdGXbbMYfcADEj1C3y", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/110", "thumbnail_src": "https://si.imgix.net/b92da0c7/uploads/origins/b841e69e-d9f3-40c0-b960-e9906f3e19ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03c814153bd28c49777bddd0f87ad42a", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/109", "thumbnail_src": "https://si.imgix.net/7a0d13e5/uploads/origins/cb05b8f7-bfe2-418f-b089-ff652d8e142e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42750bfec5919dd58c21c194e3caa90b", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちはヾ(＠⌒ー⌒＠)ノ💞💞💞💞💞💞💞\nイラストめっちゃ可愛くて綺麗でめっちゃ好きです！\n私のOCのイラストをお願いしたいのですが、冬服と夏服の2人のインタラクティブイラストです。冬服の方はちょっと活発で、夏服の方はちょっとおとなしくて、二人とも胸ぺったんこのかわいい女の子です。キャラクターのリンクはこちら↓。\nhttps://drive.google.com/drive/folders/1R9MoXVMTryhQ6dlAGSAcM4h3f29asg5l\nお読みいただきありがとうございました！🩵🤍🩷🥰", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/108", "thumbnail_src": "https://si.imgix.net/99dc7c21/uploads/origins/b3ea0c2c-cc3f-4679-b3eb-080ce89a2703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aaf851c43ae8871c7c0d9701bce114b", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/107", "thumbnail_src": "https://si.imgix.net/10616cb4/uploads/origins/a513314f-43fc-45f5-8734-24ab20998f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59961492b64b610f972398a6cea98f00", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/106", "thumbnail_src": "https://si.imgix.net/9075ee69/uploads/origins/68e4f72d-bac4-4a04-a3ae-dd29ab8440b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcfbee6485b26dfdc18271e3e5a5141", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、skebの再開ありがとうございます！よろしければ創作百合OC3人のイラストをリクエストさせてください🙌🏻\n\n人間のお嬢様とアンドロイドの双子メイドの3人cpになります！関係性は資料に詳しく記載がございますが、3人とも仲良しで、手網を握る大人が存在しないためみんなで好き勝手に楽しいことをするちょっとアングラめの3人交際感のあるお友達cpになります♡\n\nお洋服は資料内のものでも、アレンジいただいたりおまかせで描いていただいても何でも歓迎です◎雰囲気や構図等も全ておまかせいたします。NGないのでぜひ自由に描いてください！ご縁がありましたらよろしくお願いいたします🙏🏻\n\nhttps://drive.google.com/drive/folders/1t3FJ0