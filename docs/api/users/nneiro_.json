でも大丈夫です！お好きに解釈して描いてください！\n\n【2人のモチーフ】\n血、薔薇、花弁、薔薇の棘、蝶、リボン、レース、ゴシック、燭台、墓石、十字架、食器など\n\n金額等不足している場合は再送のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/101", "thumbnail_src": "https://si.imgix.net/119febf6/uploads/origins/e7f79684-f376-46bf-b97a-fa1f1b14b58d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c10adb62ae7a7f08e3d126b0728fbbba", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/100", "thumbnail_src": "https://si.imgix.net/d0042acb/uploads/origins/ba440b91-1231-4792-92f6-8449dbf3c472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f9446ff07d3bd92e01d9976fab414ae", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/99", "thumbnail_src": "https://si.imgix.net/76387f08/uploads/origins/8f4a7452-a2d0-49f1-ba1a-e2084d2cb49a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dde8a6a287376e11d69a0e611d324e2", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/98", "thumbnail_src": "https://si.imgix.net/bedda4cf/uploads/origins/17440d20-a0e2-41ec-8522-c151dbd42a96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37329e81fd29f63c685e500cac3fa020", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nneiro_/works/97", "thumbnail_src": "https://si.imgix.net/adbfea2d/uploads/