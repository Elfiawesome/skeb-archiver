e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21989fcd23b001cada5a4b4509c60ac4, https://si.imgix.net/27091e46/uploads/origins/32618fcb-6320-47eb-a45e-5179d0fb0e19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65d5731f2b90eb3aa1aeda9f40e5dedb 2x, https://si.imgix.net/27091e46/uploads/origins/32618fcb-6320-47eb-a45e-5179d0fb0e19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d12c5df5f93833e33ba800e4f7cd4f77 3x", "genre": "art", "nsfw": false, "body": "ぱらどっと様\n\n初めまして。いつもYouTubeやXでイラストを拝見したり音楽を聴かせてもらっています。特に最近では魔理沙ちゃんが登場する「ハイスピードケルベロス」に夢中になっています。\n\nさて、今回はカードゲームのプレイマット用のイラストを依頼したく、リクエストを送らせていただきました。詳細としては以下の通りです。\n\n構図：霧雨魔理沙（「東方Project」シリーズ）がカードゲームをする様子。その他、背景等はお任せします。\n比率：9753x5029ピクセル\n\nこのイラストは個人で使うものです。ぜひぱらどっとさんの世界にひとつだけのイラストを楽しみにしています。\n\nマリネス", "created_at": "", "completed_at": ""}, {"path": "/@zenerat/works/39", "thumbnail_src": "https://si.imgix.net/4dd1f587/uploads/origins/13c254f3-584d-4b0e-8c0d-a34a33074b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e720ba9ce4bc3ee9446bdaea6f6739ee", "thumbnail_srcset": "https://si.imgix.net/4dd1f587/uploads/origins/13c254f3-584d-4b0e-8c0d-a34a33074b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e720ba9ce4bc3ee9446bdaea6f6739ee, https://si.imgix.net/4dd1f587/uploads/origins/13c254f3-584d-4b0e-8c0d-a34a33074b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da9ebd84284da00db14d0c256687f4cc 2x, https://si.imgix.net/4dd1f587/uploads/origins/13c254f3-584d-4b0e-8c0d-a34a33074b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d2f5cf356a119d585e3dff8eebfd8dd 3x", "genre": "art", "nsfw": false, "body": "はじめまして！貴方のイラストやbgm アレンジが好きで前からリクエストをお願いしたかったので今回リクエストさせていただきました\nリクエストは東方projectの藤原妹紅とLimbus Companyと言うゲームの良秀をお願いします！\n\nxやLINEのアイコンとして使いたいので\nアスペクト比は1:1でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@zen