7-8a0b-e088bbbb01b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5411aaefd5c0114e5175e04f3c89ea3b, https://si.imgix.net/27ecfeff/uploads/origins/e72d5063-fa3c-4b07-8a0b-e088bbbb01b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5427a98c335a969a395d58abd736fa49 2x, https://si.imgix.net/27ecfeff/uploads/origins/e72d5063-fa3c-4b07-8a0b-e088bbbb01b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e47f4bb77020babbd7d922e9461cd63b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nいつも先生が描いているSDキャラを見て癒されており、\n是非先生に私の黒インナーのオリキャラの子を描いて頂きたいと思い、依頼をさせて頂きました。\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願い致します。\n\n＜依頼内容＞\n◆キャラ\nオリキャラ：黒ちゃん(仮名)\n※参考画像\nhttps://x.com/magunamu06060/status/1742122762226032658?s=20\nhttps://skeb.jp/@kamidan29/works/36\nhttps://skeb.jp/@one_emblem/works/58\nhttps://skeb.jp/@nukoleg/works/9\nhttps://skeb.jp/@nitikapo/works/5\n\n表情や雰囲気、シチュエーションなどは先生が思うこのキャラに合う内容で問題ございません。\n\n◆使用方法\nTwitterアイコンや動画や生放送のサムネなどを想定しております。\n\n◆その他\n可能であれば、人物と背景、宛名が分かれているPSDデータでの納品を頂けると助かります。\n\n上記内容でご検討を頂ければ嬉しいです。\n宜しくお願いいたします。\n\nhttps://x.com/magunamu06060/status/1742122762226032658?s=20", "created_at": "", "completed_at": ""}, {"path": "/@milkpanda0301/works/18", "thumbnail_src": "https://si.imgix.net/2972184c/uploads/origins/10319838-c416-433d-a70e-76d3544170c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a27413dbb644c047276d6b2ff4f9ba", "thumbnail_srcset": "https://si.imgix.net/2972184c/uploads/origins/10319838-c416-433d-a70e-76d3544170c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a27413dbb644c047276d6b2ff4f9ba, https://si.imgix.net/2972184c/uploads/origins/10319838-c416-433d-a70e-76d3544170c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d736eb5ef972e2ff210667299d8e7164 2x, https://si.imgix.net/2972184c/uploads/origins/10319838-c416-433d-a70e-76d3544170c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f