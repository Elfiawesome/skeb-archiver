g.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "いっしょに浜辺を歩いているボイスをお願いします。\n\nバイノーラルで、いろんな方向から話しかけてもらえないでしょうか。\n以下に希望する台本と、各セリフの音方向を記します。\n\n----------------------------------------------------------------------\n\n(左から)\n「まだ暗いね。ここ、砂浜が全体的にごつごつしてるから足元に気を付けてね」\n「すごく静か...波の音はあるのに、なんだかそう感じるよ」\n\n(後ろから)\n「世界に二人きりになったみたい」\n「ねえ、このまま旅にでない？全部投げ出してさ」\n\n(正面から)\n「...ふふ、大丈夫、冗談だよ。でもこの浜の終わりくらいまでは一緒に歩こう」\n「ねえ、見て、空が綺麗。夜が押し出されていくみたい」\n\n(右から)\n「ねえ、また来ようね、きっと」\n\n(右から近付いて)\n「約束だよ」\n\n----------------------------------------------------------------------\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/19", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "一緒にお出かけしているシチュエーションボイスをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/18", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "ガシガシ撫でるボイスをお願いします。\n\n先日配信にて「今日お仕事頑張ってこれた？よーしよしよしよし！えらいぞ！」というような趣旨のことを言いながらマイク(リスナー)をガシガシなでていたと思います。\nあれをバイノーラルマイクでやって欲しいです。\n雑に犬を撫でるくらいのテンションでお願いします。\n\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/17", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "ビアガーデンでバイトしているニア様を見たくてお店に行くシチュエーションのボイスをお願いします。\n以下、希望するボイス内容です。\n細かい指示をカッコ書き(---###---)で記入していますが、あくまで希望です。\n大変だと思いますので可能な範囲で結構です。余裕があればお願いします。\nバイノーラルマイクだと更に嬉しいです。\n\n************************************\n\n(---通常音量---)\nいらっしゃいませー！\nビアガーデンご来場の方はこちらでーす！\n\nさーさーこちらの席へどーぞー！\nとりあえず1杯お持ちしますねー！\n....え、2杯？いいですけど...\n\n(---ひそひそ声で---)\nねえ君、大丈夫？\n僕のディアンドルが見たくて来ただけでしょ？\nそんなに飛ばしたらベロベロに...\n大丈夫? ほんとに...?\nまあいいけどさぁ\n\n(---通常音量で---)\nはーい！では少々お待ちくださーい！\n\n(--- 2~3秒の間をとる ---)\n\n(---通常音量---)\nお待たせしましたー！ビール2杯！\n...え？1杯は僕の分？\n\n(---ひそひそ声---)\n...君、こっちは仕事だってば！\nだめだよそんなの！\nもう...迷惑な客だなぁ\nふふ、そんなにこのカッコの僕と飲みたかったの？\nしかたないなぁ\n(--- 2、3口ほど、水を飲む音 ---)\n丸々1杯はだめだから、残りは君が飲んでね\n\n(--- 通常音量に戻って ---)\nはーい、それでは料理のご注文どーぞー！\n\n************************************\n\nシチュエーションが大きく変わらない範囲でなら、内容を改変していただいて結構です。(短くするなど)\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/16", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "おかえりボイスお願いします。\n\n--------------------------------------------\n\nかったー、おかえり。\n今日はちょっと遅かったね。お腹減ったでしょ？\n\n僕も減ってる。晩御飯早く作って！！！\n今日は和食の気分！！！\nはっやく！はっやく！はーーやーーくーーー！！！\n\nえへ\n\n-------------------------------------------\n\n以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/15", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "2024/7/19の配信【生活音】の21:32頃にあげた悲鳴のボイスをお願いします。\n以下、ボイス案です。\n\n--------------------------------------------------------------------------------------\n\n「かったー？どこー？　....ひゃあぁあ！もう！おどろかすな馬鹿！！！！」\n\n--------------------------------------------------------------------------------------\n\n以上です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/14", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "お祈りボイスをお願いします。\n以下、希望するボイス内容の一案です。\n******************************\n\n先の見えない暗闇の中でもがく、君のために祈ろう。\n\n昨日までの研鑽を胸に、\n今日できることを行い、\n明日できることを増やそう。\n\nあっという間に追い抜かれても、\n誰かが嘲笑ったとしても、\n折れず、たゆまず、進む君に。\n傷だらけの君に、僕の祝福を。\n\n******************************\n内容は改変していただいても結構です。\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/13", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "一緒にダイエット頑張ろうって感じのボイスをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/12", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "にあちゃんがくまちゃんを食事に誘うシチュエーションボイスをお願いします。誘うシチュエーションはおまかせです。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/11", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "以下、希望するボイス内容です。\n******************************\n\nやっほ、久しぶり。元気だった？\n...うん、元気ではないね、そうだね。\nずいぶんと寂しかったみたいだね？\n\nいや待って、泣かないでよ、ちょっと空いただけじゃん。\nふふ、どういう表情なの、それ？\n\n君は脆いね。\nいつか僕が本当にいなくなったら、きっと死んじゃうんじゃない？\n\nずっと一緒に...かぁ。\n君は、永遠が好きだね。信じるだけ無駄なのに。\n永遠なんてないよ。というか、あっても関係ないよ。\n\n永遠に守られる約束があるとしたらそれは、いつか反故にされるかもしれないっていう、永遠の恐怖そのものだもの。\nそんなの、いずれ終わりが来るって諦める方が健全でしょ？\n\nだから、そんな先のことを心配するんじゃなくてさ、明日からの毎日を考えようよ。\n明日からまたいっぱいお話しよう。\nつらいことがあったら愚痴を聞いて。君のも少しは聞いてあげるからさ。\n雨が降ってたら、ちゃんと傘を持って出かけたか心配してあげる。\n気圧でダウンしたら静かになってると思うから、察して祈ってて。良くなるように。\n嬉しいことがあったら教えてあげるから一緒に喜んでね。\n面白いゲームがあったら教えてあげる。君ならいつかはやってみてくれるでしょ？\n\n\n悲しみも喜びも、大きいのも小さいのも、毎日ちょっとずつ分けてあげる。\n僕の毎日を積み重ねてあげる。\n僕がいなくなったら空っぽになっちゃうくらい、僕のことでいっぱいにしてあげる。\n\n君の毎日もちょっとずつもらうよ。\nもっとも、僕がいっぱいになることはないだろうけどね！\nふふ、残念だね。\n\n...そうやって、会える日も会えない日も、お互いの毎日を積み重ねて、分け合って...、\n本当のお別れになるその日まで、僕たちの日々に埋もれていよう。\n\nそしていつか、その時が訪れたら...\n\n僕がいなくなった毎日に、何度だって殺されてね。\n\nいいでしょ？\n\n******************************\n(6/7(金): リクを一旦キャンセル後、一人称など微修正しました。また匿名設定になっていたので解除しました。)\n\n以上、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/10", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "作業中に居眠りした私に話しかけるニア様のボイスをお願いします。バイノーラルを希望します。以下に妄想を書き散らすのでシチュエーションボイスとしてよろしくお願いいたします。\n\n「かったー...寝てる？起きろー」\n(後ろから耳をたたく)\n\n(後ろから抱きしめるような恰好で、頭越しに机のノートを手に取る)\n「作業進んだ？どれどれ...ノートはできてるね。後はTeX(テフ)に起こすだけか」\n\n「一度書いたことをまとめ直すのはだるいよねー。でも頑張ろうね。」\n\n「...ほら目をつむるな！気持ちよくなってるんじゃない！」\n(耳を抑えたり離したりする)\n\n「全然目が覚めてないね...仕方ない、少し休みな。ほら、膝枕してあげる！」(膝枕)\n\n「今日は風邪が気持ちいいね...穏やかな昼下がり、お昼寝にはちょうどいい」\n\n「ぼく？ぼくは...そうだな、君を観察してるよ。ふふ、無様に寝顔をさらすがいい」\n\n「時間になったらちゃんと起こしてあげる。だから...」(耳のあたりを撫でる)\n\n「ゆっくりおやすみ」\n\n\n以上、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Asthulm_info/works/9", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9360c65523345ea681042ed75d31e8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f2c30c21b5285831e459decb976660 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879469539815297025%2FqdPHUQwq.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bba5fcc470adee3c0642aaa93222280 3x", "genre": "voice", "nsfw": false, "body": "にあちゃんがめっちゃ甘えてくれるボイスお願いします", "created_at": "", "completed_at": ""}, {"path"