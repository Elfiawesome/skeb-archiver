4-c2a949eebca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cd3bfb91d5c4fa6b53d11e7096b42fe 3x", "genre": "art", "nsfw": false, "body": "こんばんは。しろめにゃと申します。\n︎自分のキャラを描いていただきたく、依頼させていただきます。\nイラストはTwitterやYouTubeのアイコンなどに使用予定です。\n以下細かい設定です。\n\n・目の色は青か水色でお願いします。(どっちが似合うのか正直分からないので︎しっくりきた方にしてほしいです、投げやりでごめんなさい)\n・背景やポーズ、配置はおまかせします。\n・表情も、目を開いた笑顔のものがあれば特に指定しません。\n・設定が男の娘なので、可能であればかわいい男の娘っぽく描いてほしいです。(同じ理由でまつげ不要です)\n・ボトムス部分の服を描く必要があれば、白色の短パンでお願いします。(天使界隈とかでググればどういうものか分かると思います)\n・服の色はデフォルメ調の方の資料(つまり白が基調)に準拠していただけると助かります。\n・猫耳付いてますがしっぽは不要です。\n\n以上よろしくお願いします。\n\n資料は一応正面から全身が見えるデフォルメ調のものも上げておきます。\n\nhttps://x.com/shiromenya/status/1940724820506989001?s=61", "created_at": "", "completed_at": ""}, {"path": "/@MikosibaAmane/works/18", "thumbnail_src": "https://si.imgix.net/44ef2718/uploads/origins/a3727430-ad7d-40bf-88c0-39ae40896aab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3789c831b4a92499b33557f6b152300a", "thumbnail_srcset": "https://si.imgix.net/44ef2718/uploads/origins/a3727430-ad7d-40bf-88c0-39ae40896aab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3789c831b4a92499b33557f6b152300a, https://si.imgix.net/44ef2718/uploads/origins/a3727430-ad7d-40bf-88c0-39ae40896aab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14dd19ef6b64818e5be317b3dbe2950a 2x, https://si.imgix.net/44ef2718/uploads/origins/a3727430-ad7d-40bf-88c0-39ae40896aab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=243573a4d7c0f3050fd80bc507f8f83f 3x", "genre": "art", "nsfw": false, "body": "初めまして。個人Vtuberでゲーム配信を中心に活動してます、雷々ヨウと申します。\n御子柴あまね様のとってもかわいいイラストに惹かれたので今回リクエストさせていただきました！  \n2つのイラストをお願いしたいと思います。\n\n♦キャラクター詳細➞ 参考画像のリンク先を記\n入してます。 \n\n♦構図 ➞1つ目は満面の笑みイラストをお願いします！洋服は参考画像のものでお願いします。\n2つ目は、可愛いジャージメイドを着せていただきたいです！その他は全てお任せでお願いします。\n\n\n\n♦使用用途 ➞Ｘの投稿、Twitch配信にて使用(収益化済 )\n\n ご検討よろしくお願いします！！\n\nhttps://drive.google.com/drive/folders/1V8eFiXTCf6jNsUeAHzsHS4X7MUDOot_q?dmr=1&ec=wgc-drive-globalnav-goto", "created_at": "", "completed_at": ""}, {"path": "/@MikosibaAmane/works/17", "thumbnail_src": "https://si.imgix.net/0bb87cb1/uploads/origins/cb4de96b-69e5-48c1-9fc3-d6742143ff0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e0d81ffe4277242b468813287aa14e", "thumbnail_srcset": "https://si.imgix.net/0bb87cb1/uploads/origins/cb4de96b-69e5-48c1-9fc3-d6742143ff0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e0d81ffe4277242b468813287aa14e, https://si.imgix.net/0bb87cb1/uploads/origins/cb4de96b-69e5-48c1-9fc3-d6742143ff0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07be53115baffbfc89b8df0f19f08a25 2x, https://si.imgix.net/0bb87cb1/uploads/origins/cb4de96b-69e5-48c1-9fc3-d6742143ff0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95525a93ff0118949425ebd9248aff70 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ATL(あとら)-セタです。\n今回は一枚絵を描いてもらいたくて依頼させていただきました。\n\n・上裸+短パン(水着)\n・浅瀬で水遊びしてる\n・構図はおまかせ\n・表情：笑顔、楽しそう\n・ポーズ：おまかせ\n・参考資料：https://lit.link/atlseta\n\n〇用途〇\n・Yotuubeのサムネイル\n・おはようVTuber等\n\n〇サイズ〇\nおまかせ\nサムネイル等に使用するため、髪の毛の先や耳、指の先等が切れていない構図を希望します。\n\n〇その他\n人物のみの背景透過もお願いします。\nファイル形式は、キャラクターと背景を分けたPSDファイルでいただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@MikosibaAmane/works/16", "thumbnail_src": "https://si.imgix.net/eb7fc0d5/uploads/origins/6bc5b0a2-a6b7-4863-86ac-696d82cb0218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aca3ff1e357bb5208c7e81f9a88f3af", "thumbnail_srcset": "https://si.imgix.net/eb7fc0d5/uploads/origins/6bc5b0a2-a6b7-4863-86ac-696d82cb0218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aca3ff1e357bb5208c7e81f9a88f3af, https://si.imgix.net/eb7fc0d5/uploads/origins/6bc5b0a2-a6b7-4863-86ac-696d82cb0218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4c9ecfe60a6fe4616adfe5519820186 2x, https://si.imgix.net/eb7fc0d5/uploads/origins/6bc5b0a2-a6b7-4863-86ac-696d82cb0218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b14dfbea32a6140f0ced13c3c6ee70e4 3x", "genre": "art", "nsfw": false, "body": "御子柴あまね様\n\n平素よりお世話になっております。\nあまね様の素敵もちもちかわいいイラストをどうか…どうか…！ということで依頼させて頂きたく思います。\n\n*リクエスト内容\nVtuber『まどいあきゅら』のイラストをお願いしたく思います。\n描画範囲はお任せいたします、ポジティブな表情(笑顔、ウインク等)をさせていただきたいです。\n\n*利用範囲、留意していただきたい点等\n『まどいあきゅら』のXアカウントで投稿する画像、Youtubeチャンネルにおける動画、配信のサムネイルに利用させていただきたいです。\n(現在収益化はしておりませんが、今後した際にも引き続き利用したいと考えております。)\nサムネイルとして使用させていただきたいため、キャラクターの頭部ユニット部分や髪の毛などが切れないように描いていただければ幸いです。\nまた、サインや背景とは別に透過された画像データをいただきたくお願いいたします。\nそちらご了承さえいただければ、フリー素材等と合成させて利用したいと考えておりますが、難しい場合はレイヤーなどにご指示いただければ従いますのでよろしくお願いいたします。\n\n依頼に不備等ありましたら申し訳ありません、言外の部分はあまね様の思うように描いていただければと思います。\nお忙しいとは存じますが、どうかよろしくお願いいたします。\n\nまどいあきゅら\n\nhttps://www.youtube.com/channel/UCg993QrYho4WlkmvtNLPvVQ", "created_at": "", "completed_at": ""}, {"path": "/@MikosibaAmane/works/15", "thumbnail_src": "https://si.imgix.net/c66dd4b5/uploads/origins/95408c00-e4e8-44f7-a52d-f0817bf7849e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30dd36228f4a9a4e1eff1c265ae469d8", "thumbnail_srcset": "https://si.imgix.net/c66dd4b5/uploads/origins/95408c00-e4e8-44f7-a52d-f0817bf7849e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30dd36228f4a9a4e1eff1c265ae469d8, https://si.imgix.net/c66dd4b5/uploads/origins/95408c00-e4e8-44f7-a52d-f0817bf7849e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c23551228bec61f7a4aa39e74bbc34a0 2x, https://si.imgix.net/c66dd4b5/uploads/origins/95408c00-e4e8-44f7-a52d-f0817bf7849e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9ba7b9a75acc2350f12f6142b148e73 3x", "genre": "art", "nsfw": false, "body": "こんばんは。海風いつきと申します。\ntwitterでイラストを見た時に気になったのでリクエストをさせていただきます。\n\n私の世界線に出てくる子の白宮インフィニティオートマタの1号機の白宮メロンをお願いします。\n特に構図とかは決めてないのでおまかせで大丈夫です。\nよろしくお願いいたします！\n\n\n詳細\n身長150cmの男の子モデル\nジト目気味\n左耳に∞の刻印がある\nズボンに印\nあほ毛がある\n戦闘もできるが主にお世話をすることが多い\n白宮隊統括\n\nhttps://drive.google.com/drive/folders/1knCJjii7v9Spl2lcwk35_fcWC2xz4FWn?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@MikosibaAmane/works/14", "thumbnail_src": "https://si.imgix.net/c5fd7afb/uploads/origins/d7d66297-5d73-4a7a-a0e2-1df33883a04f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7830da6987ae8d2a6a3f1e3cba573a", "thumbnail_srcset": "https://si.imgix.net/c5fd7afb/uploads/origins/d7d66297-5d73-4a7a-a0e2-1df33883a04f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7830da6987ae8d2a6a3f1e3cba573a, https://si.imgix.net/c5fd7afb/uploads/origins/d7d66297-5d73-4a7a-a0e2-1df33883a04f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d7e3f6565f22fa2e0143245bfabb7b8 2x, https://si.imgix.net/c5fd7afb/uploads/origins/d7d66297-5d73-4a7a-a0e2-1df33883a04f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34b4266016663272803bb6af1d850bc7 3x", "genre": "art", "nsfw": false, "body": "あまねさんこんばんは！羽柴利緒です。\nこの勢いでぜひ突撃させていただいたい…！と思いリスクエストしに参りました！\n\nぜひ、ジャージメイドを、あまねさんの手で着せていだけないでしょうか！\n構図や表情・ポーズなどすべてお任せ致します。\n好きに描いていただけたらとってもうれしいです！\n\nジャージの色は黒っぽいもの希望です！\n（黒をぜひ着てくれと意見をいただきました＾＾）\nその他のエプロンやフリル・装飾などもお任せしてもよろしいでしょうか…？\n\nイラストはYouTube配信でのサムネイルやSNSでの宣伝活動に使用させていただきたいです！\nまた、もし可能でしたら人物のみのデータもいただけるとうれしいです！\n\nお任せ部分が多いのですが、ぜひあまねさんのイメージする羽柴利緒のイラストを描いていただけたらと思っております！\n\nもしご都合合いましたらよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/er60kv0ds8vwkjsi994ci/h?rlkey=8ucjqjybxax9k8gde2ug638sc&st=61a72e44&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@MikosibaAmane/works/13", "thumbnail_src": "https://si.imgix.net/1685d2ea/uploads/origins/e3fed0a3-8b89-4230-ae2f-4eb756da1c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70afa33f198b674af2742964b67aa7c8", "thumbnail_srcset": "https://si.imgix.net/1685d2ea/uploads/origins/e3fed0a3-8b89-4230-ae2f-4eb756da1c12?bg=%23fff&auto=format%2C