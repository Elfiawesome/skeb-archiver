あります。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1wH3uIeIsFwn3pYq-TgpnLx-b7Xf8Qgsm/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@gohanysu/works/49", "thumbnail_src": "https://si.imgix.net/b72e95b9/uploads/origins/11fd3af7-f383-410b-9e43-61542c2ae325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9304a9ad3f4ce520da3c4b7343048785", "thumbnail_srcset": "https://si.imgix.net/b72e95b9/uploads/origins/11fd3af7-f383-410b-9e43-61542c2ae325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9304a9ad3f4ce520da3c4b7343048785, https://si.imgix.net/b72e95b9/uploads/origins/11fd3af7-f383-410b-9e43-61542c2ae325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91b2a7ff1cb995aa43d588ee7d662744 2x, https://si.imgix.net/b72e95b9/uploads/origins/11fd3af7-f383-410b-9e43-61542c2ae325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fb4a190dd767c575861f15b485ea915 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gohanysu/works/48", "thumbnail_src": "https://si.imgix.net/2f554b49/uploads/origins/51826d39-a375-4456-a49c-a7fbf2f7eb2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1765dbbd8c8538341ad367e3b10540a0", "thumbnail_srcset": "https://si.imgix.net/2f554b49/uploads/origins/51826d39-a375-4456-a49c-a7fbf2f7eb2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1765dbbd8c8538341ad367e3b10540a0, https://si.imgix.net/2f554b49/uploads/origins/51826d39-a375-4456-a49c-a7fbf2f7eb2b?bg