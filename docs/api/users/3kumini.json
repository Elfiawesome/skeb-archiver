ざいます\n\nお忙しいところ恐れ入りますが、ご検討のほど何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@3kumini/works/836", "thumbnail_src": "https://si.imgix.net/7b076eae/uploads/origins/c3fbba58-aaab-44de-a6d3-d601aa0a7179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2a524cb23261d23d62b6c572393b789", "thumbnail_srcset": "https://si.imgix.net/7b076eae/uploads/origins/c3fbba58-aaab-44de-a6d3-d601aa0a7179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2a524cb23261d23d62b6c572393b789, https://si.imgix.net/7b076eae/uploads/origins/c3fbba58-aaab-44de-a6d3-d601aa0a7179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf668798c7a60b9d390b44105cb7ac64 2x, https://si.imgix.net/7b076eae/uploads/origins/c3fbba58-aaab-44de-a6d3-d601aa0a7179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb3fd0c1678ecc75cdb4fffcf6c4a490 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3kumini/works/835", "thumbnail_src": "https://si.imgix.net/4f9eb1c1/uploads/origins/0a8cef9a-0c5a-4323-b69e-0c1ecc2f59f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23d72c0914dd57595bc58423360484f4", "thumbnail_srcset": "https://si.imgix.net/4f9eb1c1/uploads/origins/0a8cef9a-0c5a-4323-b69e-0c1ecc2f59f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23d72c0914dd57595bc58423360484f4, https://si.imgix.net/4f9eb1c1/uploads/origins/0a8cef9a-0c5a-4323-b69e-0c1ecc2f59f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2