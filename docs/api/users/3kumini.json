f8-1c8af99eef3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae3a9b461906b7be4d5cd9fb8dd17bc, https://si.imgix.net/1c85675c/uploads/origins/59db73ac-e296-4ca3-b8f8-1c8af99eef3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a91c6bdb41586e26593809fe0d903f75 2x, https://si.imgix.net/1c85675c/uploads/origins/59db73ac-e296-4ca3-b8f8-1c8af99eef3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31ad56737668793392bf055473633ece 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品本当に大好きです！すごく楽しくて可愛いです！私のVTuberドーキーのイラストを描いてください。彼は表情豊かで、得意げ、軽薄、面白く、いたずら好き、不器用でバカです。 カラフルで派手かつクールな美学を持っています。スタイル上、瞳孔が白い描写が多いです。都市ファンタジー設定の冥界冒険者ギルドのギルドマスターで、人間でありながら小悪魔のコスプレをしています。右目の下の美人のほくろを忘れずに。ピンクの瞳です。黒髪にピンクのハイライトが入っており、頬まで届く長いゆるい前髪が顔の前で何本も垂れています。\n\nポーズや表情は自由に決めてください！カラフルで奇抜、表情豊かなポーズが大好きです！YouTube動画、Discord、アイコンなどに使用します！ピカチュウ、声優活動、モンスターハンター、リーグ・オブ・レジェンド、お酒、コーヒー、そして怠けることが好きです。https://skeb.jp/@3kumini/works/787 の色彩使いと楽しいデザインが本当に好きです。\n\nhttps://drive.google.com/drive/folders/16LT2qnB29q6_b-uYNhlIFHlKMCPkf0Ul?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@3kumini/works/816", "thumbnail_src": "https://si.imgix.net/02d19dc9/uploads/origins/620af0b2-a0f5-47c3-84a2-feabb463b62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d18a81c44caa62222a44e880e9a7bf2", "thumbnail_srcset": "https://si.imgix.net/02d19dc9/uploads/origins/620af0b2-a0f5-47c3-84a2-feabb463b62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d18a81c44caa62222a44e880e9a7bf2, https://si.imgix.net/02d19dc9/uploads/origins/620af0b2-a0f5-47c3-84a2-feabb463b62a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aabd22d62633fea3cf5093f707f14c4d 2x, https://si.imgix.net/02d19dc9/uploads/origins/620af0b2-a0f5-47c3-84a2-feabb463b62a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de4077eead7f248d772dc82e60e40863 3x", "gen