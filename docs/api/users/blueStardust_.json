t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7dcc3f52fc158d50c4cca3121427c14", "thumbnail_srcset": "https://si.imgix.net/5338492c/uploads/origins/e17c8741-da5a-41c9-99f4-1857418b67ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7dcc3f52fc158d50c4cca3121427c14, https://si.imgix.net/5338492c/uploads/origins/e17c8741-da5a-41c9-99f4-1857418b67ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba525439c8e6528f6b4d758bd497c754 2x, https://si.imgix.net/5338492c/uploads/origins/e17c8741-da5a-41c9-99f4-1857418b67ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53388a778b637810fe58b08b5ef8b563 3x", "genre": "art", "nsfw": true, "body": "キャラクター\n・ドルフロ　AK-12（スムージー・エイジ）\n・少年(AK-12より低身長)\n\n少年が水着姿のAK-12に正面から抱き着いてイチャイチャするエッチなシチュエーションをお願いします。\n\n少年がAK-12と隙間がなくなるくらい密着して、水着越しに巨乳の谷間にグリグリと顔を深く埋め、両手を彼女の大きく重たそうな尻に持ってきて強く揉みしだき、感触を楽しんでいるのが見たいです。\n\nAK-12の胸は大きめで、少年にエッチな事をされるも抵抗せず、片目を開けて赤面して困っている表情といやらしい雰囲気で描いて頂けると嬉しいです。\n\nその他細かい部分はお任せします。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@blueStardust_/works/137", "thumbnail_src": "https://si.imgix.net/3bdb092d/uploads/origins/4a20b10b-7b19-4a7a-ab99-aebd6943bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4478575d45427f9e567f61c7dbc96ec6", "thumbnail_srcset": "https://si.imgix.net/3bdb092d/uploads/origins/4a20b10b-7b19-4a7a-ab99-aebd6943bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4478575d45427f9e567f61c7dbc96ec6, https://si.imgix.net/3bdb092d/uploads/origins/4a20b10b-7b19-4a7a-ab99-aebd6943bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=845534f279965d7cef19d8c3c3aa7500 2x, https://si.imgix.net/3bdb092d/uploads/origins/4a20b10b-7b19-4a7a-ab99-aebd6943bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0289c376bd5354e9c3870ca069f008c5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@blueStardust_/works/136", "thumbnail_src": "https://si.imgix.net/39dba1a3/uploads/origins/90f61bc7-9a30-4960-9175-930e466285e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdbcba66d035f1378978fc4ea7357a23", "thumbnail_srcset": "https://si.imgix.net/39dba1a3/uploads/origins/90f61bc7-9a30-4960-9175-930e466285e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdbcba66d035f1378978fc4ea7357a23, https://si.imgix.net/39dba1a3/uploads/origins/90f61bc7-9a30-4960-9175-930e466285e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f478935155e2be60fc26bb4f2b31e153 2x, https://si.imgix.net/39dba1a3/uploads/origins/90f61bc7-9a30-4960-9175-930e466285e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25b32d6a748f1af3dedd95ac7362a480 3x", "genre": "art", "nsfw": false, "body": "あらためて、グリズリーでリクエスト送らせて頂きます。\n\n■キャラクター\nグリズリー　星夜の舞踏会スキン(資料二枚目)\n\n◆構図\n資料一枚目の映画「ギルダ」(1946)のポスターのグリズリーバージョンを描いて頂きたいです\nポスターのように片手に紙タバコを持ち、もう片手に資料三枚目の通常スキンのジャケットを持たせてその場で佇んでいる様子\n\nポスター風に描いて頂きたいので可能であれば\nタイトルや文字類も入れて頂きたいです(題名をLAR GRIZZLY MK.Vにするなど)\n\n細かい部分や文字、背景の色等はおまかせで\n原稿でお忙しいタイミングかもしれませんがよろしくお願い致します。\n\nhttps://x.com/dacwtiiiam58829/status/1938467758838321235?s=46&t=gw2fdmP6R4QXQI_Cwo1mBw", "created_at": "", "completed_at": ""}, {"path": "/@blueStardust_/works/135", "thumbnail_src": "https://si.imgix.net/5ab05836/uploads/origins/a209c7df-97e0-4dec-bd1c-e8c5358184d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216514a2599d1e04a6ee005b1d7aeccd", "thumbnail_srcset": "https://si.imgix.net/5ab05836/uploads/origins/a209c7df-97e0-4dec-bd1c-e8c5358184d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216514a2599d1e04a6ee005b1d7aeccd, https://si.imgix.net/5ab05836/uploads/origins/a209c7df-97e0-4dec-bd1c-e8c5358184d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72de1b3690131caf4d8d5423b9b3beba 2x, https://si.imgix.net/5ab05836/uploads/origins/a209c7df-97e0-4dec-bd1c-e8c5358184d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1897301d4f9ee787f791d2b314bc7167 3x", "genre": "art", "nsfw": true, "body": "リクエスト再送いたします。\n\nキャラクター\nスケアクロウ（ドールズフロントライン）\n\nシチュエーション\n突風でスケアクロウのスカートがフワッと舞い上がってタイツ越しに彼女の太ももとパンツが丸見えになるイラストをお願いします。\n\nマスクを外した状態で、スカートの中が見えている事にハッと気づいて、恥ずかしがっているスケアクロウの表情が見たいです。\n\n黒の布地に、かわいい模様が施されたパンツが肌にピッタリと張り付き形をはっきりさせて、むちむちの太ももは触ったらすごく柔らかそうなのがタイツ越しでもわかる感じでお願いします。\n\nその他の細かいところはお任せします。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@blueStardust_/works/134", "thumbnail_src": "https://si.imgix.net/d5e062d5/uploads/origins/af6cb950-13e8-452c-9790-754346bde537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e7ac8903679bac1d151d598692e42e4", "thumbnail_srcset": "https://si.imgix.net/d5e062d5/uploads/origins/af6cb950-13e8-452c-9790-754346bde537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e7ac8903679bac1d151d598692e42e4, https://si.imgix.net/d5e062d5/uploads/origins/af6cb950-13e8-452c-9790-754346bde537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9632aeb6ded140eac8b8e0136500d69c 2x, https://si.imgix.net/d5e062d5/uploads/origins/af6cb950-13e8-452c-9790-754346bde537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e91207a75d5e38b597910315f3b1db6 3x", "genre": "art", "nsfw": true, "body": "キャラクター\nIWS2000（ドールズフロントライン）\n\nシチュエーション\n「ノーブラで制服着てほしい！」と彼女に頼んだら、混乱と恥ずかしそうな表情でいつもの白い制服をノーブラで着込んで制服越しに一回り大きく膨らんだ胸を片腕で下から支え大きさをアピールして、もう片方の手でスカートをめくって、黒いパンツを見せてくれる優しいIWS2000のイラストをお願いします。\n\n彼女の胸は制服の中ではちきれそうなくらい窮屈に大きくパンパンに膨らみ、重たさと柔らかさが伝わる感じで描いて頂けると嬉しいです。\n\n描かれているのは彼女一人でOKです。\nその他の細かいところはお任せします。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@blueStardust_/works/133", "thumbnail_src": "https://si.imgix.net/68fe500f/uploads/origins/646b209e-0cfb-40f2-941a-405bf8d49141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=336d3ce5e736eea74f8f21ade13e4384", "thumbnail_srcset": "https://si.imgix.net/68fe500f/uploads/origins/646b209e-0cfb-40f2-941a-405bf8d49141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=336d3ce5e736eea74f8f21ade13e4384, https://si.imgix.net/68fe500f/uploads/origins/646b209e-0cfb-40f2-941a-405bf8d49141?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a200d392ca13d33ca9db8059d4587dc4 2x, https://si.imgix.net/68fe500f/uploads/origins/646b209e-0cfb-40f2-941a-405bf8d49141?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8f2143d4ef82c102e2e06f942ab43db 3x", "genre": "art", "nsfw": true, "body": "リクエストを再送いたします。\n\nキャラクター\n・M1ガーランド(ドールズフロントライン)\n・少年(容姿お任せ)\n\nシチュエーション\n少年とM1ガーランドがイチャイチャしてるイラストをお願いいたします。\n\nM1ガーランドが少年に背後からシャツ越しに巨乳を揉まれて、スカートめくりされているイラストを希望します。\n\n胸は強く揉まれてむにゅっと柔らかく形を変える感じで、スカートはタイツ越しにむちっとした太ももと色気のある青いパンツがはっきり見えるくらいまでめくられる感じでお願いします。\n\nM1ガーランドの赤面しながら焦っている感じの表情も見たいです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@blueStardust_/works/132", "thumbnail_src": "https://si.imgix.net/e5dd2c29/uploads/origins/279fe6aa-9437-45cf-a1ce-91ae33a5ee0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b92cb0d640ea506537ce75cf326eab70", "thumbnail_srcset": "https://si.imgix.net/e5dd2c29/uploads/origins/279fe6aa-9437-45cf-a1ce-91ae33a5ee0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txts