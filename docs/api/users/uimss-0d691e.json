127-8a79-66b927da64b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08beae52e3276f12ea88ffa0963e3fc6, https://si.imgix.net/91ed14e3/uploads/origins/cfddb26b-222e-4127-8a79-66b927da64b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78e6a87e25e27307c99c69af3490c3e5 2x, https://si.imgix.net/91ed14e3/uploads/origins/cfddb26b-222e-4127-8a79-66b927da64b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=996b98756265090b1e11b0ee8318e81d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、あなたの絵がとても好きなので、私のocに個人的なリクエストを出したいと思います。\n\n構図：静かな荒唐無稽な終末のシーン（時間は夜で、二人はどこかから逃げてきたらしく、疲れたように裸足で浅い海に立っていた、その側に火の輝く海辺の村と、地面から抜け出したような巨大な怪物を見ている。）\n（参考：https://sta.sh/019w09ywdqmx）\n\n\nその他の詳細については、あなた次第です。もし、もっと良い解釈があれば、構図を変更することも可能です。お好きなように描いていただけたら、とても嬉しいです\nお忙しい中、ありがとうございました。スケジュールやお身体に負担がなければ、ご検討頂ければと思います。依頼内容が気に入らなければ、そのままキャンセルしていただいて結構です。問題ないですよー。\nそして、PSDファイルの署名は閉じておくのがベストです!それでは、良い一日をお過ごしください。\n\nリンク： https://sta.sh/22fkv8jzuavs", "created_at": "", "completed_at": ""}, {"path": "/@uimss/works/32", "thumbnail_src": "https://si.imgix.net/859100a0/uploads/origins/006383cb-f7b0-4ab8-83d3-1e090ecccf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da7e70c27c9665129e1b18de35b2848", "thumbnail_srcset": "https://si.imgix.net/859100a0/uploads/origins/006383cb-f7b0-4ab8-83d3-1e090ecccf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da7e70c27c9665129e1b18de35b2848, https://si.imgix.net/859100a0/uploads/origins/006383cb-f7b0-4ab8-83d3-1e090ecccf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b661863eea5987d55f541eeea3b4737 2x, https://si.imgix.net/859100a0/uploads/origins/006383cb-f7b0-4ab8-83d3-1e090ecccf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5359a2ad67f2b84c3b571e6ab1a7d3a 3x", "genre": "art", "nsfw": false, "body": "先生！こんにちは。\n友達が先生のイラストが大好きなんです！でもSkebのアカウントを持っていないので、自分のOCを描いてほしいそうです。その子たちのために絵を描いてくれませんか？\n\n喜んで描いてくれることを祈ってます\nもし、難しいようであれば、お断りしても構いません。\n\nhttps://drive.google.com/file/d/17pulcRLojm8TpARQeRXXYUTL2JO-FDTb/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@uimss/works/31", "thumbnail_src": "https://si.imgix.net/8f4f3fae/uploads/origins/4ea51137-81e5-4fa5-9896-3e3f1f4d4544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24eb9e626283f82ac1ac5d70891f6545", "thumbnail_srcset": "https://si.imgix.net/8f4f3fae/uploads/origins/4ea51137-81e5-4fa5-9896-3e3f1f4d4544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24eb9e626283f82ac1ac5d70891f6545, https://si.imgix.net/8f4f3fae/uploads/origins/4ea51137-81e5-4fa5-9896-3e3f1f4d4544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07f37e674497aa0e8af8e482847a59e6 2x, https://si.imgix.net/8f4f3fae/uploads/origins/4ea51137-81e5-4fa5-9896-3e3f1f4d4544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=519ab92372950e3263fec5aa7bb4b06f 3x", "genre": "art", "nsfw": false, "body": "宇野山むじ様初めまして！ 素敵なイラストを拝見しております！...自分もお願いしてみようと思いました。もし宜しければ、私のTRPGオリキャラのイラストを描いていただけたら幸せです！ \n\nキャラ設定や関係は全部ここにまとめてます https://imgur.com/a/WFNZBpO  \n\n構図やテーマは全部お任せしたいです！もし指定が必要な場合、雪の中で遊ぶ/散歩する二人が見てみたいです！リクエスト受けるだけでも嬉しいので。ご検討よろしくおねがいいたします！", "created_at": "", "completed_at": ""}, {"path": "/@uimss/works/30", "thumbnail_src": "https://si.imgix.net/37ac5320/uploads/origins/492ea99d-c25b-45a1-bbb9-61616a0cc383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344ae82a0d5860672eabbcb572eae13a", "thumbnail_srcset": "https://si.imgix.net/37ac5320/uploads/origins/492ea99d-c25b-45a1-bbb9-61616a0cc383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344ae82a0d5860672eabbcb572eae13a, https://si.imgix.net/37ac5320/uploads/origins/492ea99d-c25b-45a1-bbb9-61616a0cc383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14ec4ffda9f5f86