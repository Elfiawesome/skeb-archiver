0bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e0406997033fc5421aa2e481fc42913 2x, https://si.imgix.net/b6965b8e/uploads/origins/a3c6dad2-88c8-4a47-b4ec-889abdfe0bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51609593a6012188281dda7dbff59110 3x", "genre": "art", "nsfw": false, "body": "はじめまして。あなたの作品を尊敬しています！ファンタジージャパンのキャラクターを2人描いていただけると嬉しいです。\n\nキャラA。書道家。華族出身。昔話とオカルトが好き。ナイーブ。わがまま。目はいつもキラキラしている。\nモチーフ：巻物、インク、金魚、鯉\n\nhttps://toyhou.se/11289870.tamaki/gallery\n\nキャラB。使用人。働き者。慎重。運が悪い。いつも疲れた顔をしている。家事が多い。目の下にクマがある。悪魔に取り憑かれている。\nモチーフ：秋、キンモクセイ、たぬき\n\nhttps://toyhou.se/11289881.minato/gallery\n\n2人は幼なじみ。キャラAはキャラBをとても頼りにしている。キャラBはキャラAを助けなければならない。\n\n二人のシナリオは自由に考えてください。\n\nあとはお任せします。足りなければ再送してください。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/11", "thumbnail_src": "https://si.imgix.net/cbffae65/uploads/origins/e08c7b91-96fc-41d8-9f8f-367b96e2b813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2629b2166e16b48cf2754a152710963c", "thumbnail_srcset": "https://si.imgix.net/cbffae65/uploads/origins/e08c7b91-96fc-41d8-9f8f-367b96e2b813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2629b2166e16b48cf2754a152710963c, https://si.imgix.net/cbffae65/uploads/origins/e08c7b91-96fc-41d8-9f8f-367b96e2b813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b130090049148602ebe1e75bccad91a 2x, https://si.imgix.net/cbffae65/uploads/origins/e08c7b91-96fc-41d8-9f8f-367b96e2b813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c764d85963f3c1319b3c613ae07d667d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/10", "thumbnail_src": "https://si.imgix.net/8b81eaf2/uploads/origins/f448de1d-444a-485a-b904-0d761b4f2a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a058702d018ca89db892146f5940e83d", "thumbnail_srcset": "https://si.imgix.net/8b81eaf2/uploads/origins/f448de1d-444a-485a-b904-0d761b4f2a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a058702d018ca89db892146f5940e83d, https://si.imgix.net/8b81eaf2/uploads/origins/f448de1d-444a-485a-b904-0d761b4f2a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99b5f5571cfbac96855ad36a721889e3 2x, https://si.imgix.net/8b81eaf2/uploads/origins/f448de1d-444a-485a-b904-0d761b4f2a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a47d4c81f064c4e788abd627473224a 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nよければ私と友人の創作（TRPG）キャラクターを描いていただきたく思い、リクエストを送らせていただきます。\n\n以下、依頼内容になります。\n\n▼画像資料\nhttps://drive.google.com/drive/u/3/folders/1MWpujbNadjLJ1Rpc8FnWvwG-ZzTWotxA\n\n見えていない部分や装飾等描きやすいように自由にしていただいて構いません。\n\n▼キャラクター補足\n雲（赤髪）\n・20代前半/男\n・余裕な表情で笑っていたり、呆れるような表情をよくする\n・近所のちょっと信用できなさそうなお兄さんの雰囲気\n\n千鳥（緑髪）\n・17歳/女\n・明るく素直で人懐っこい、積極的、恋愛脳\n・雲さんが大好きで、会うたびに告白しては躱されている\n\n普段は千鳥が積極的に雲へアプローチをし、それをハイハイといったかたちで雲が躱しているような感じです。その態度に対し千鳥は怒らず、より好きになっていつかOKしてもらえる日を思って日々精進しています。\n逆に雲が珍しく千鳥に構うと千鳥は顔を真っ赤にし動揺して何もできなくなります。\n\n▼リクエスト\n物騒な二人ですが怖い雰囲気よりも、ほのぼのしていたりどちらかが積極的であったり、2人の仲が良さそうな雰囲気で描いていただけると嬉しいですが、描きやすいようにご自由にしてくださって構いません。\n過去に描かれているような一枚に敷き詰めるように描いていただきたいのですが、もし料金が不足している場合は再送要請していただければと思います。\n\n▼使用用途\n・個人鑑賞（友人への共有）\n・個人使用の範囲内でSNSのヘッダーやアイコンへの使用（使用の際はお名前を記載いたします）\n\n\n苦手な要素や内容があった場合は遠慮なくキャンセルしてください。\n\nここまで読んでいただきありがとうございます。\nご縁がありましたら何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/9", "thumbnail_src": "https://si.imgix.net/a17477ff/uploads/origins/8fc33954-b56f-4dd4-b80d-02e7d3ce87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dcdc309a383d00e0cd63337257a42ac", "thumbnail_srcset": "https://si.imgix.net/a17477ff/uploads/origins/8fc33954-b56f-4dd4-b80d-02e7d3ce87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dcdc309a383d00e0cd63337257a42ac, https://si.imgix.net/a17477ff/uploads/origins/8fc33954-b56f-4dd4-b80d-02e7d3ce87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad1f333b87c71005ad8f581287c97247 2x, https://si.imgix.net/a17477ff/uploads/origins/8fc33954-b56f-4dd4-b80d-02e7d3ce87a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95f2ae264c5dbe07d99458d3c025b477 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/8", "thumbnail_src": "https://si.imgix.net/6f5dd766/uploads/origins/f5137140-14d1-4326-90c5-300eaddfd31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9bcc7cef7b0efca3e821c84ef949f3", "thumbnail_srcset": "https://si.imgix.net/6f5dd766/uploads/origins/f5137140-14d1-4326-90c5-300eaddfd31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9bcc7cef7b0efca3e821c84ef949f3, https://si.imgix.net/6f5dd766/uploads/origins/f5137140-14d1-4326-90c5-300eaddfd31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62aa909199da9abdd3c5c37db66f142c 2x, https://si.imgix.net/6f5dd766/uploads/origins/f5137140-14d1-4326-90c5-300eaddfd31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=211a230f12bc1f0d19a505d781f7b7b6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！自キャラ二人のイラストをお願いできますか？ポーズと表情自由にお願いします！\n紫の子は警視庁捜査一課の警部、モテモテのイケメン。チョコレートバーが大好き！\n蒼の子は新人警察、小さな子供みたい。狂ったように先輩五十嵐を崇拝し、彼の写真を収集します。普段は無表情な顔ですが、先輩を見ると目がキラキラと輝いています\nお手数ですが、ご検討いただけますと幸いです。※金額が足りなければ金額変更のアピールをお願いします。\n本来の二人 ➡️\nhttps://drive.google.com/drive/folders/1-h44fiUupLRbSWWa1PFW6pokffbAt592\n別の世界観➡️ \nhttps://drive.google.com/drive/folders/1-zdQ12NqPL-B5YRklxy-eJyV6FsAWgdo", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/7", "thumbnail_src": "https://si.imgix.net/496630f1/uploads/origins/d1940762-e76a-4ee6-9918-045b63858eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c10a633b9acd5c21d093e9a79fb51cb", "thumbnail_srcset": "https://si.imgix.net/496630f1/uploads/origins/d1940762-e76a-4ee6-9918-045b63858eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c10a633b9acd5c21d093e9a79fb51cb, https://si.imgix.net/496630f1/uploads/origins/d1940762-e76a-4ee6-9918-045b63858eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6646e3d0dea732ca1bbde6d9ec59d3c5 2x, https://si.imgix.net/496630f1/uploads/origins/d1940762-e76a-4ee6-9918-045b63858eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=879b18ed6dcff727c9dddb9bfd161463 3x", "genre": "art", "nsfw": false, "body": "のん 様\n\nあなたの画風、色彩が大好きです！私のocの絵を依頼してもいいですか？\n\nオレンジの髪\n183cm/73kg 温厚でにこやかな男で。彼と黒髪の男はカップルなんだ、料理上手で冗談好き。\n\n黒髪\n172cm/58kg 新地区のギャングのボスで、無表情で冷たい。時折小さな癇癪を起こし、実はとても優しい人なんだ。コーヒーとワインが好きで、タバコも吸う。\n\nどんな服でも、どんなインテリアでも、あなたの絵の癖に合わせて描くことができる。\n\n気を悪くさせたのなら、本当に申し訳ない。\n\n値段やキャラクターについて質問があれば、再調整するよ！\n\nhttps://drive.google.com/drive/folders/1olapT-t7Mn4CFYTEyIfIBy47xLCO4l7x?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/6", "thumbnail_src": "https://si.imgix.net/3e145d7d/uploads/origins/4bcbbd8e-b583-4253-af5b-767b273a6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f389a14910b7485c2f15b0260e8254", "thumbnail_srcset": "https://si.imgix.net/3e145d7d/uploads/origins/4bcbbd8e-b583-4253-af5b-767b273a6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f389a14910b7485c2f15b0260e8254, https://si.imgix.net/3e145d7d/uploads/origins/4bcbbd8e-b583-4253-af5b-767b273a6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e75a9437b4685bd7b071ba94547964c 2x, https://si.imgix.net/3e145d7d/uploads/origins/4bcbbd8e-b583-4253-af5b-767b273a6d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4b3c419d7c4b71e8ac385c19a4c4c32 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Skebで拝見したのんさんのイラストが好きで、今回私と友人のTRPGキャラクター2人組を描いて頂きたくご依頼させて頂きました\n海外から送ります、文法的な間違いはご容赦ください。\nまた、金額や問題がありましたらお手数おかけしますが再送要望やキャンセルいただければと思います。\n\n▶怪盗 男 25歳 顔面偏差値が高い側\n・童顏、細身 173cm\n・楽観的で率直な人\n・新奇で面白いものが好き\n・甜いものが好き\n・派手で騒々しい怪盗\n・いたずらが得意\n\n▶贋作師 男 35歳 背が高い側\n・がっしり\n・ひねくれな人\n・迷惑される側、ツッコミ役\n・よく絵を描く\n・悪ふざけに怒ります\n\n▶二人は絵画を盗む怪盗のパートナーです。贋作家がダミーの絵画を描き、怪盗の方はそれと入れ替えて盗むといったような活動です。\n普段は、苦労人おじさんが20代の子供と遊んでいるように見えますが、彼らは互いを非常に信頼している相棒であり、兄弟のような雰囲気を与えます。\n\n構図やシチュエーションはお任せ致します。\nご検討のほど、よろしくお願いいたします。\n\n▶立ち絵と参考に使えそうな落書きなど\nhttps://drive.google.com/drive/folders/1oE-f0NXg0IjlXgmSV1sZFmrj7S0d4JZV", "created_at": "", "completed_at": ""}, {"path": "/@im2_non/works/5", "thumbnail_src": "https://si.imgix.net/7a21c307/uploads/origins/d851f900-806e-4797-bdfc-8d8697c1e0d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dccf62addb399b15e282fa029a247ea", "thumbnail_srcset": "https://si.imgix.net/7a21c307/uploads/origins/d851f900-806e-4797-bdfc-8d8697c1e0d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dccf62addb399b15e282fa029a247ea, https://si.imgix.net/7a21c30