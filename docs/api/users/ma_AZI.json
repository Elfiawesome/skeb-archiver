e2-45db-a2f6-78cd807a8b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfb3e0cf8cc2d4780c371463d1a50799 2x, https://si.imgix.net/cc53f2bc/uploads/origins/1624a534-02e2-45db-a2f6-78cd807a8b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d85c161a5019cc0442453f6f9bb2063c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ma_AZI/works/104", "thumbnail_src": "https://si.imgix.net/2c1488ef/uploads/origins/5db1aedb-7912-441d-96c3-5cef4b0b2024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dcadb060043d330eeeb9b66286ef72b", "thumbnail_srcset": "https://si.imgix.net/2c1488ef/uploads/origins/5db1aedb-7912-441d-96c3-5cef4b0b2024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dcadb060043d330eeeb9b66286ef72b, https://si.imgix.net/2c1488ef/uploads/origins/5db1aedb-7912-441d-96c3-5cef4b0b2024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=088359925893d0c91ac15c6ee3a6d572 2x, https://si.imgix.net/2c1488ef/uploads/origins/5db1aedb-7912-441d-96c3-5cef4b0b2024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d73eec90bc48a55254ac8f1b4818c529 3x", "genre": "art", "nsfw": true, "body": "スマホゲーム『ドールズフロントライン2』のチータという子をお願いします。\n\n・容姿等の参考〜\nhttps://dollsfrontline2.wikiru.jp/?%E3%83%81%E3%83%BC%E3%82%BF#q8463293\nの「立ち絵」を参照\n・後ろアングル、片膝をついてしゃがみ、遮蔽物のドラム缶越しに画面外の敵に射撃している（※姿勢の参考〜\nhttps://gamewith.jp/nikke/article/show/370982\nの「立ち絵」→「射撃中」のポーズを参考にしてもう少しローアングル、かつ左側を向かせ、横顔が見えるようにする）\n・スカートがめくれ、お尻が見えている、衣装やストッキングは軽めに所々破く、パンツは無傷、ストッキング越しのパンツの質感を大事に\nという感じでお願いします。\n・背景は屋外、時間帯は昼間\n・画面内の人物は本人のみ\nという感じでお願いします。\n\nNSFWはONにしていますが、露骨にエロくなくても大丈夫です。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""