3fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fe3046ddb3f7847d2656e206d8141f6 3x", "genre": "art", "nsfw": false, "body": "ゆう様\n\nいつも大変お世話になってます。\n四葉の１枚絵をリクエストしても宜しいでしょうか？\n\n ◇テーマ\n「勤労感謝の日」\n\n◇シチュ\n風太郎くんとデートをする当日朝。\n自宅で最後の身だしなみチェックをする四葉…的なイラストをお願いします。\n服装は少し意匠が難しいですが、ねぎ先生が描かれたGOTO AKIBA!(ニット+スカート)でお願いします。\n参考用に資料URLを添付します。\n\n表情はゆう先生にお任せします💡\nこちら、ご検討のほどよろしくお願い致します。\n\nhttps://au-coop.jp/pages/hny-goto-atre", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/31", "thumbnail_src": "https://si.imgix.net/892cdc44/uploads/origins/e1d6c2f9-37ef-48be-9202-3787ecc19bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=613c11620ba044f5a638b9ca95831fe0", "thumbnail_srcset": "https://si.imgix.net/892cdc44/uploads/origins/e1d6c2f9-37ef-48be-9202-3787ecc19bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=613c11620ba044f5a638b9ca95831fe0, https://si.imgix.net/892cdc44/uploads/origins/e1d6c2f9-37ef-48be-9202-3787ecc19bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a34f56154f7655a8e454b5704939f8f3 2x, https://si.imgix.net/892cdc44/uploads/origins/e1d6c2f9-37ef-48be-9202-3787ecc19bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e01ea26b9345cb358798d143be5b29eb 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/30", "thumbnail_src": "https://si.imgix.net/d3fa4762/uploads/origins/8b01e51b-89b3-443e-8d47-bdd6a5f77c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9c254cd3e0cfddcc104a37829a54412", "thumbnail_srcset": "https://si.imgix.net/d3fa4762/uploads/origins/8b01e51b-89b3-443e-8d47-bdd6a5f77c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9c254cd3e0cfddcc104a37829a54412, https://si.imgix.net/d3fa4762/uploads/origins/8b01e51b-89b3-443e-8d47-bdd6a5f77c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95de955fcdd3ba09be70c8bbddd05943 2x, https://si.imgix.net/d3fa4762/uploads/origins/8b01e51b-89b3-443e-8d47-bdd6a5f77c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65b2c7b457087b8d06f060a3ecbe8abf 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、ぐーふです。\n1枚絵の中で、大人四葉3人が様々なハートポーズをしているカラーイラストをお願いしたいです。\n\n大人四葉3人については以下を希望します。\n①新婚旅行編にて登場した三つ編み四葉が、顔の横で、人差し指と中指で作るハート\n②一番くじ五つ子ハネムーン！！での白ワンピース四葉が両手で作るハート🫶\n③新婚旅行編にて登場した水着を着た四葉が両手で指ハート‪🫰🏻\n\nゆうさんが新婚旅行編公開時にXにて投稿された四葉ちゃんのイラストをイメージしています。\n金額内で可能でしたら、1人ずつの1枚絵もお願いしたいです。\n\nお忙しい中恐縮ですが、よろしくお願いします。\n\nhttps://pin.it/7jgKJK9dB", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/29", "thumbnail_src": "https://si.imgix.net/de261df5/uploads/origins/06307f57-4b2b-4baf-8894-0639db08c651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c227ec5ab1d3460bbe4e8a52c7af44f", "thumbnail_srcset": "https://si.imgix.net/de261df5/uploads/origins/06307f57-4b2b-4baf-8894-0639db08c651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c227ec5ab1d3460bbe4e8a52c7af44f, https://si.imgix.net/de261df5/uploads/origins/06307f57-4b2b-4baf-8894-0639db08c651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcd78f3c36f511a21aa45ae4caf1c661 2x, https://si.imgix.net/de261df5/uploads/origins/06307f57-4b2b-4baf-8894-0639db08c651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7229b48204e8c352b1e6c3b73f49560a 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\n前回のリクエストでは素敵なイラストを描いて頂き、ありがとうございました。\n今回、別作品でリクエストがありますので、可能でしたら宜しくお願い致します。\n\n◼️キャラ\n八月のシンデレラナインの潮見凪沙\n◼️シチュエーション\n海の防波堤で人と待ち合わせしているシーンをお願いします。\n服装は制服でお願いします。\nポーズ・構図等は指定はないです。\n◼️参考URL\nhttps://hachinai.com/character/shiomi\nhttps://w.atwiki.jp/hachinai_nanj/pages/2829.html\n\n以上、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/28", "thumbnail_src": "https://si.imgix.net/ee966f08/uploads/origins/dc10d237-9c7e-4b03-8e74-c6cc5bac3959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29f34f87a7b97d1592ee9aa152e2c7b9", "thumbnail_srcset": "https://si.imgix.net/ee966f08/uploads/origins/dc10d237-9c7e-4b03-8e74-c6cc5bac3959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29f34f87a7b97d1592ee9aa152e2c7b9, https://si.imgix.net/ee966f08/uploads/origins/dc10d237-9c7e-4b03-8e74-c6cc5bac3959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98a2fdb75465ad30072f5a5b6f8ec0f1 2x, https://si.imgix.net/ee966f08/uploads/origins/dc10d237-9c7e-4b03-8e74-c6cc5bac3959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aad1243ad6c36973111ec9e937d1a779 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のオリジナルキャラクター「コハル」を、gnsnのスカラムーシュかディルックのどちらかと、かわいいシチュエーションでお願いしたいです。\nお好きなキャラクターを選んで描いてください。\nありがとうございました。\n\nhttps://imgur.com/a/FSFQ5tE\nhttps://imgur.com/a/CJXXrYX", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/27", "thumbnail_src": "https://si.imgix.net/836cd17d/uploads/origins/ef6b0322-dc7f-4461-a1f9-e8fc7b2125c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a128549f6a8f0e3f3a69585a2799061", "thumbnail_srcset": "https://si.imgix.net/836cd17d/uploads/origins/ef6b0322-dc7f-4461-a1f9-e8fc7b2125c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a128549f6a8f0e3f3a69585a2799061, https://si.imgix.net/836cd17d/uploads/origins/ef6b0322-dc7f-4461-a1f9-e8fc7b2125c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9babde9649b36ab9dbf5798008cb8264 2x, https://si.imgix.net/836cd17d/uploads/origins/ef6b0322-dc7f-4461-a1f9-e8fc7b2125c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33f7731c735c3d5ceabd24bad2550284 3x", "genre": "art", "nsfw": true, "body": "初めまして。五等分ヒロイン達の事故キスイラストが素晴らしかったので、リクエストさせていただきました！\n\n5人の総当たりキスシーンのカラーイラスト集をお願いしたいです！\n\nペアの2人が密着するように素肌の上から2人一緒にプレゼントリボン(リボンはペアごとに色を変えカラフルな感じ)でぐるぐる巻きにされている様子で、\n2人とも頬を染め驚いた表情でお互いを見つめ合いながら密着するようにキスをしてしまっている。(ぐるぐる巻きの為、キスした状態から離れられない)\n\n枚数も多く、現実的なシチュエーション無視の完全に私の願望的な構図ですが、ご採用いただけるととても嬉しいです。\n是非、よろしくお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/26", "thumbnail_src": "https://si.imgix.net/b379fa59/uploads/origins/c9b368c2-f654-419f-9927-1d34fdb4bc72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147595b138895a8518454fec0dae3de4", "thumbnail_srcset": "https://si.imgix.net/b379fa59/uploads/origins/c9b368c2-f654-419f-9927-1d34fdb4bc72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147595b138895a8518454fec0dae3de4, https://si.imgix.net/b379fa59/uploads/origins/c9b368c2-f654-419f-9927-1d34fdb4bc72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84f42d286ad58e03825153d45547823b 2x, https://si.imgix.net/b379fa59/uploads/origins/c9b368c2-f654-419f-9927-1d34fdb4bc72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a364e69e07ce9ea615a5d4ea4b04ad2c 3x", "genre": "comic", "nsfw": false, "body": "お世話になってます。\n京都旅行の続きをお願いしても宜しいでしょうか？\n\n◇シチュ\n神社でお祈りする風四\n↓\n目を開けると何故か風太郎が金髪の金太郎に、四葉も昔の髪型に！？\n↓\n混乱する四葉を抱きしめる金太郎。普段の風太郎よりも積極的ではわわ…\n↓\n夢オチ\n↓\nホッとするも束の間。すぐ隣に裸で眠る風太郎の寝顔が\n↓\n暫くフリーズした後、昨夜のホテルでの出来事を一気に思い出し一人赤面する四葉\n\nといった夢オチ→朝チュンです。\n※非NSF Wのつもりですが、センシティブすぎるとご判断された場合は断って頂いてOKです。\nその際は健全シチュを改めてご依頼させて頂きます。\nご検討のほど宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/25", "thumbnail_src": "https://si.imgix.net/59824fdd/uploads/origins/894792f7-ba86-4d12-b153-90381d1bbfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8015108f943db45c75c7221ef43db60f", "thumbnail_srcset": "https://si.imgix.net/59824fdd/uploads/origins/894792f7-ba86-4d12-b153-90381d1bbfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8015108f943db45c75c7221ef43db60f, https://si.imgix.net/59824fdd/uploads/origins/894792f7-ba86-4d12-b153-90381d1bbfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7b492d85aa4cfdb538625ea83dc5bb9 2x, https://si.imgix.net/59824fdd/uploads/origins/894792f7-ba86-4d12-b153-90381d1bbfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c1523b58d3c708ce19f579ffae818ff 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n参考の二人のアニメキャラが「デートしている」テーマのカラー漫画をリクエストしてもよろしいでしょうか？知らないキャラかもしれないので難しいならキャンセルしても構いません。\n\n男性キャラは非常にシャイで、女は大胆でリードするタイプ。\n内容は自由ですが、最後はキスシーンが欲しいです。男性は最初躊躇したが、勇気を出してキスしようとし➡女性が受け入れてキス➡女性が男性の行動に嬉しい描写。\n\nページ数や指定していない詳細はお任せします。\nご検討よろしくお願いいたします。\n\nhttps://imgur.com/a/j9BSKHX", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/24", "thumbnail_src": "https://si.imgix.net/19653e1e/uploads/origins/aed0c511-69c6-44c8-813e-c01240a20ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d64b205438f8aa915fba8bc98e571506", "thumbnail_srcset": "https://si.imgix.net/19653e1e/uploads/origins/aed0c511-69c6-44c8-813e-c01240a20ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d64b205438f8aa915fba8bc98e571506, https://si.imgix.net/19653e1e/uploads/origins/aed0c511-69c6-44c8-813e-c01240a20ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbb2bb8f210e301aa39584317ec352bf 2x, https://si.imgix.net/19653e1e/uploads/origins/aed0c511-69c6-44c8-813e-c01240a20ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19f8dc9fbef8905faff2d47b7a22e5ed 3x", "genre": "art", "nsfw": false, "body": "ゆう様\n\nいつも大変お世話になってます。\n風四イラストをリクエストしても宜しいでしょうか？\n\n◇シチュ\n大学卒業前の二人が京都旅行に行くシチュです。\n秋冬〜冬春をイメージしてます。\n(四葉が京都の子だと気付いてない頃です)\n\n・京都駅周辺を手を引っ張って歩く\n・神社で家族＋上杉家のお守りを大量に買う\n・携帯のカメラで写真を撮ってる時ににっこりピースをする\n\nなど、原作88話の京都の子を彷彿させるようなシチュエーションをお願いします。\n服装は季節が季節なので、冬の温泉旅行時のようなコートでお願いします。\n\n以上となります。\nご検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/23", "thumbnail_src": "https://si.imgix.net/38720354/uploads/origins/586874c1-6781-4d30-ab4b-4c4b15a9afdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f43e8b29dd2c890c889f96199d61acf", "thumbnail_srcset": "https://si.imgix.net/38720354/uploads/origins/586874c1-6781-4d30-ab4b-4c4b15a9afdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f43e8b29dd2c890c889f96199d61acf, https://si.imgix.net/38720354/uploads/origins/586874c1-6781-4d30-ab4b-4c4b15a9afdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e75d6b0b7ef479ad7935c91187e6530 2x, https://si.imgix.net/38720354/uploads/origins/586874c1-6781-4d30-ab4b-4c4b15a9afdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60145ff1c7b15cdba739aadd9a7c04e2 3x", "genre": "art", "nsfw": false, "body": "モノクロペン画の五等分ヒロインズが好みでしたので、以下のようなイラストをお願いしたいです。\n\n\n●制服姿のヒロインの5人がそれぞれ総当たりで事故キスしているイラスト（10種）\n・お互い大きく目を見開いて驚いた表情で勢いよくキスしてしまっている状態のイラスト\n・①一花と二乃が事故キス、②一花と三玖が事故キス、……⑤二乃と三玖が事故キス、……⑩四葉と五月が事故キス\n・モノクロペン画、普通等身、描画範囲：バストアップ程度\n\n●⑪顔を赤くして気まずそうに照れる5人のイラスト\n\n\nとてつもなく数があるのですが…（5人の総当たり＋1枚なので全11枚）、\nご検討いただけると幸いです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/22", "thumbnail_src": "https://si.imgix.net/ab2fe89a/uploads/origins/312741e2-94d8-463e-95b3-c529eca40fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef0e4c94833241803f6651607221395", "thumbnail_srcset": "https://si.imgix.net/ab2fe89a/uploads/origins/312741e2-94d8-463e-95b3-c529eca40fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef0e4c94833241803f6651607221395, https://si.imgix.net/ab2fe89a/uploads/origins/312741e2-94d8-463e-95b3-c529eca40fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a75ced70f5b2fa42388a91e5891e30db 2x, https://si.imgix.net/ab2fe89a/uploads/origins/312741e2-94d8-463e-95b3-c529eca40fa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f0c3694f3c2ff5929727f6752d0f5d2 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です😖\nまた風四をお願いしても宜しいでしょうか…？\n\n◇シチュ\nクリスマスの続きです。\n寒空のなか外で遊びたい四葉が風太郎をスパに誘い、持参した水着に着替えて一緒にサウナを楽しむ…といった感じです。\n\n◇依頼\n四葉が楽しそうにロウリュ(熱石に水を掛ける)で蒸気を出す中、腰掛けた風太郎はふと四葉を見る。\n水着姿に慣れてたものの、狭い空間で彼女と二人きりという特殊な状況も相まってドキドキする内に風太郎からも蒸気が出てしまいます。\n「大丈夫ですか！？」と風太郎の肩を支えてサウナから出る四葉。\nのぼせたと思い心配する四葉と、「マジか俺…」と不覚にものぼせる風太郎を描いて頂けたらと思います。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/21", "thumbnail_src": "https://si.imgix.net/6c0492a4/uploads/origins/5224ea46-16a0-412b-bb77-98ac9d169626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b1edbe401abcf57cfcd50ef207f5998", "thumbnail_srcset": "https://si.imgix.net/6c0492a4/uploads/origins/5224ea46-16a0-412b-bb77-98ac9d169626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b1edbe401abcf57cfcd50ef207f5998, https://si.imgix.net/6c0492a4/uploads/origins/5224ea46-16a0-412b-bb77-98ac9d169626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6abc6ee1e373fd8bf7d5534f0926ae51 2x, https://si.imgix.net/6c0492a4/uploads/origins/5224ea46-16a0-412b-bb77-98ac9d169626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a054ea3b933082e69b3583532a0ab8bf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/20", "thumbnail_src": "https://si.imgix.net/7c8d6c13/uploads/origins/21925848-8041-4e0a-97aa-c2b770a419aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81df29abbf91b9851a45a00f6ea1e322", "thumbnail_srcset": "https://si.imgix.net/7c8d6c13/uploads/origins/21925848-8041-4e0a-97aa-c2b770a419aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81df29abbf91b9851a45a00f6ea1e322, https://si.imgix.net/7c8d6c13/uploads/origins/21925848-8041-4e0a-97aa-c2b770a419aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b696281db0ea268b5bc79b09141c980 2x, https://si.imgix.net/7c8d6c13/uploads/origins/21925848-8041-4e0a-97aa-c2b770a419aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23e85d898dede2c4984e2dcf52e570d0 3x", "genre": "art", "nsfw": false, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)と恒一(168cm)をカップルらしく描いてください。\n詳細はお任せします。資料を参考にご自由にお描きください。\nなお作品の舞台は98年の北陸の田舎町(モデルは富山県)です。\n絵柄はなるべく公式に寄せてください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/19", "thumbnail_src": "https://si.imgix.net/2158cd92/uploads/origins/09e5bb4c-03db-4bd6-943b-4e7e6df602a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=158bf0ec4b73a17c46289adfa0869f35", "thumbnail_srcset": "https://si.imgix.net/2158cd92/uploads/origins/09e5bb4c-03db-4bd6-943b-4e7e6df602a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=158bf0ec4b73a17c46289adfa0869f35, https://si.imgix.net/2158cd92/uploads/origins/09e5bb4c-03db-4bd6-943b-4e7e6df602a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c65ac019c88d8fe47ee43cf8d26348c 2x, https://si.imgix.net/2158cd92/uploads/origins/09e5bb4c-03db-4bd6-943b-4e7e6df602a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be034c457e067f0a6d04fb3ecb60ff30 3x", "genre": "art", "nsfw": false, "body": "今回はオリジナルキャクターアイコンイラスト（デカヌチャン、リキキリンver.）各種と、あの花キャクターのメンマのオリジナルイラスト(いずれも透過素材あり)をお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/18", "thumbnail_src": "https://si.imgix.net/d8339f2c/uploads/origins/ff732307-8ffe-4846-aa4e-12688d6b4a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c732c67df07e2a1d5351cc43203bca0e", "thumbnail_srcset": "https://si.imgix.net/d8339f2c/uploads/origins/ff732307-8ffe-4846-aa4e-12688d6b4a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c732c67df07e2a1d5351cc43203bca0e, https://si.imgix.net/d8339f2c/uploads/origins/ff732307-8ffe-4846-aa4e-12688d6b4a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=880c0c2404167c4a038e919458e8b658 2x, https://si.imgix.net/d8339f2c/uploads/origins/ff732307-8ffe-4846-aa4e-12688d6b4a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f387d47d9e5d9100cac36491dd1fb7d 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰してます\n今回も四葉ちゃんと五鈴ちゃんのコラボ作品をお願いいたします\n\n設定\n四葉ちゃんが夏休みに\n風太郎に何かしらのプレゼントor旅行へいくにあたり金欠で青ざめているところ五鈴ちゃんが色々な短期アルバイトを紹介してそれを二人でこなして解決する\nという最近skebでみるイラスト漫画形式でお願いいたします\n\nバイト案\n★海の家\n↑絶対ほしいです\n理由としては下記の資料の水着風の姿の五鈴ちゃんがみたいからです\n\n屋台\n\nウェイトレス(可愛い制服やメイド服系)\n\n野球ビールの売り子\n\n・その他お待たせ\n\nシュール枠\n工場のライン作業(真顔で\n↓\n給料片手に風太郎を想う四葉ちゃん\nと五鈴ちゃん\n\nhttps://www.dropbox.com/sh/cg0deaebqa4uzj2/AACpIfCtyle3jDhryffhUcW7a?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/17", "thumbnail_src": "https://si.imgix.net/8fe08f08/uploads/origins/c173c366-466a-4033-94fd-25f8925de9d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a56943e485d9f4f718748e60eb607d", "thumbnail_srcset": "https://si.imgix.net/8fe08f08/uploads/origins/c173c366-466a-4033-94fd-25f8925de9d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a56943e485d9f4f718748e60eb607d, https://si.imgix.net/8fe08f08/uploads/origins/c173c366-466a-4033-94fd-25f8925de9d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a2c53b5aceaa4055a792801daf26362 2x, https://si.imgix.net/8fe08f08/uploads/origins/c173c366-466a-4033-94fd-25f8925de9d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbcee747a1c0590db6a8c243d9f30200 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。\n前回はかなり攻めたお題でしたので、今回はほのぼのイラストを希望致します。\n\n［内容］\n帰省した風太郎君、５つ子＆らいはちゃんの７人が中野家でXmasパーティーをするイラストをお願いします🎄\n\n［シチュ］\n例)ケーキを食べる\n例)人生ゲームや映画を楽しむ\n例)プレゼント交換\n例)風四を姉妹がいじる\n\n※大学３年生を想定してます(らいはちゃんは高校生)\n\n例を出しましたがなんでもOKです！\nゆうさんが楽しく描いて頂けるよう、衣装や補完は全てお任せします。\n登場キャラも多いため、納品の方は少なめで大丈夫です🙂\n\n(依頼の再送申し訳ございません)\nご検討のほど宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/16", "thumbnail_src": "https://si.imgix.net/d4142e01/uploads/origins/422155c2-4f46-4d4c-86df-fe20dbcf1a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffbbb2ca7151f35fb034ad4fa3000a6", "thumbnail_srcset": "https://si.imgix.net/d4142e01/uploads/origins/422155c2-4f46-4d4c-86df-fe20dbcf1a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffbbb2ca7151f35fb034ad4fa3000a6, https://si.imgix.net/d4142e01/uploads/origins/422155c2-4f46-4d4c-86df-fe20dbcf1a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36eb1478a2e9abfe73a2609b4f3dedaa 2x, https://si.imgix.net/d4142e01/uploads/origins/422155c2-4f46-4d4c-86df-fe20dbcf1a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6897e1619410cc1ed855492a1369d4f 3x", "genre": "art", "nsfw": false, "body": "玉川です。ヘッダーとアイコンの件、引き続きよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/15", "thumbnail_src": "https://si.imgix.net/7b4b69e1/uploads/origins/3b0540eb-cfde-43cd-a7eb-b2ff2a599f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fe8e6c20b59cce95e73a39fbacf1249", "thumbnail_srcset": "https://si.imgix.net/7b4b69e1/uploads/origins/3b0540eb-cfde-43cd-a7eb-b2ff2a599f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fe8e6c20b59cce95e73a39fbacf1249, https://si.imgix.net/7b4b69e1/uploads/origins/3b0540eb-cfde-43cd-a7eb-b2ff2a599f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0efd1bac4b10f8c36cf8ffc3e3dc8c9 2x, https://si.imgix.net/7b4b69e1/uploads/origins/3b0540eb-cfde-43cd-a7eb-b2ff2a599f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3d15fed0ad611fefb8c6855cf0d1f8d 3x", "genre": "art", "nsfw": false, "body": "ゆうさんお疲れ様です。\nまたリクエストを希望します。\n\n［内容］\nお泊まりに行った風太郎君の家で、大人の下着を履いて(履かされて)モジモジしてるルームウェアの四葉ちゃんをお願いします。\n\n［シチュ］\n大学生時代。\n勤労感謝デートをしていた二人だったが、帰りに突然の大雨に見舞われる。\nびしょ濡れになりながらも家に着き、風太郎がタオルを渡し先に風呂に行かせます。\n脱衣所で着替えを確認する四葉だったが、なぜか鞄には大人の下着しか入っておらず…\n(途中で実家に立ち寄った際に姉達に仕込まれた)\nルームウェアに着替えるもその後下をずっと気にし続ける…という感じです。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/14", "thumbnail_src": "https://si.imgix.net/cccf9bb8/uploads/origins/a18d0655-cee1-4584-ae17-7b729f9e0a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8dd3953210e3448571dd92b4fa57edac", "thumbnail_srcset": "https://si.imgix.net/cccf9bb8/uploads/origins/a18d0655-cee1-4584-ae17-7b729f9e0a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8dd3953210e3448571dd92b4fa57edac, https://si.imgix.net/cccf9bb8/uploads/origins/a18d0655-cee1-4584-ae17-7b729f9e0a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffff6225bf5be250bea5ac7b681b456a 2x, https://si.imgix.net/cccf9bb8/uploads/origins/a18d0655-cee1-4584-ae17-7b729f9e0a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=855a678c25f07dcf710a0f2ab2fd323d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/13", "thumbnail_src": "https://si.imgix.net/874f7aea/uploads/origins/a4beb8b2-1f89-4adf-aff8-32d44ec1b4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93c0f309462e9f767a469729a3a7209e", "thumbnail_srcset": "https://si.imgix.net/874f7aea/uploads/origins/a4beb8b2-1f89-4adf-aff8-32d44ec1b4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93c0f309462e9f767a469729a3a7209e, https://si.imgix.net/874f7aea/uploads/origins/a4beb8b2-1f89-4adf-aff8-32d44ec1b4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0993c8699707f1c9aad095afe5c64da 2x, https://si.imgix.net/874f7aea/uploads/origins/a4beb8b2-1f89-4adf-aff8-32d44ec1b4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a912d8d7c5065be5c6a0144d2981925 3x", "genre": "art", "nsfw": false, "body": "こんにちは、下の中野よつ葉の漫画はとても素敵でした。\nhttps://skeb.jp/@FlowerBird3830/works/8\n双子の中で一番好きなキャラは中野ニノちゃんです。\n上の絵のようなニノちゃんの可愛い漫画を描いてくれませんか？\n2期のショートヘアのニノちゃんを描いてください〜。\nニノちゃんの正面からのショットの絵があればいいなぁ～～。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/12", "thumbnail_src": "https://si.imgix.net/5e05cb63/uploads/origins/1f5acddf-28ab-44dd-87b8-75dd3e4bf384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1ddb810a718c6205143ca6274fcd225", "thumbnail_srcset": "https://si.imgix.net/5e05cb63/uploads/origins/1f5acddf-28ab-44dd-87b8-75dd3e4bf384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1ddb810a718c6205143ca6274fcd225, https://si.imgix.net/5e05cb63/uploads/origins/1f5acddf-28ab-44dd-87b8-75dd3e4bf384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18d00158f88f9c304e5ed58c98671ef6 2x, https://si.imgix.net/5e05cb63/uploads/origins/1f5acddf-28ab-44dd-87b8-75dd3e4bf384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7642d2ec91fd9d1a2790de495dafef2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/11", "thumbnail_src": "https://si.imgix.net/cc1ce7a3/uploads/origins/f5d37387-b10e-4b63-9729-870798963b17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ff797740a6006917ce0ce1bcfbf265", "thumbnail_srcset": "https://si.imgix.net/cc1ce7a3/uploads/origins/f5d37387-b10e-4b63-9729-870798963b17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ff797740a6006917ce0ce1bcfbf265, https://si.imgix.net/cc1ce7a3/uploads/origins/f5d37387-b10e-4b63-9729-870798963b17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcb177375df205bd9b562ff138b8cc2c 2x, https://si.imgix.net/cc1ce7a3/uploads/origins/f5d37387-b10e-4b63-9729-870798963b17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84b92c4b82adcfb27a3901797806b0b6 3x", "genre": "art", "nsfw": false, "body": "ゆうさん\nお世話になってます。\nまたまた風四絵をリクエスト願います。\n\n［内容］\nほろ酔いした浴衣姿の四葉ちゃんが就寝時に風太郎君に甘えて抱きつくイラストをお願いします。\n\n［シチュ］\n前回の続きです。\n旅館で夕食を済ませた二人。\n20歳を超えてる事もあり晩酌をするが、四葉がかなり出来上がってしまう。\n明日に備えて早めに床に就こうとするも、酔いがまだ完全に醒めぬ四葉は夢見心地で風太郎に甘える。\n普段見ない彼女の一面を見て意識する風太郎と、無意識に身体を密着させて眠る四葉。\n悶々としたまま夜が更けていきます。\n※過去作『お泊まり風四』が少し進展した感じです。\n\nご検討のほど宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/10", "thumbnail_src": "https://si.imgix.net/714d0535/uploads/origins/676e767e-efe6-4254-bda7-a3f6759c46a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8c464bd486282f4fe31c85d6bd52029", "thumbnail_srcset": "https://si.imgix.net/714d0535/uploads/origins/676e767e-efe6-4254-bda7-a3f6759c46a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8c464bd486282f4fe31c85d6bd52029, https://si.imgix.net/714d0535/uploads/origins/676e767e-efe6-4254-bda7-a3f6759c46a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0072093a1e73ea7c77a3e2203fbccb80 2x, https://si.imgix.net/714d0535/uploads/origins/676e767e-efe6-4254-bda7-a3f6759c46a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e07a4589caa97223b7896a5400662dff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/9", "thumbnail_src": "https://si.imgix.net/aeaf3214/uploads/origins/23140a3c-4e3c-4ba5-bc8e-ada6e076c449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fc4cf8087c2c6d0786860f7f44d42d", "thumbnail_srcset": "https://si.imgix.net/aeaf3214/uploads/origins/23140a3c-4e3c-4ba5-bc8e-ada6e076c449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fc4cf8087c2c6d0786860f7f44d42d, https://si.imgix.net/aeaf3214/uploads/origins/23140a3c-4e3c-4ba5-bc8e-ada6e076c449?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bf3a6d5cd801b0fc501e2b242ab2199 2x, https://si.imgix.net/aeaf3214/uploads/origins/23140a3c-4e3c-4ba5-bc8e-ada6e076c449?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7ce59f41ba1ab69dc346bab8ea0eea3 3x", "genre": "art", "nsfw": false, "body": "初めまして\nｖtuber『箱庭言羽』が好きで、その子が大好きな四葉を探してゆうさんの作品に出会いました。綺麗な絵もデフォルメもお子様を四葉に置き換えた絵も全部素敵で可愛い！\n四葉と推しが一緒の絵をプレゼントしたいです。\nただイラストはSNS・youtube等にて紹介。場合により一部トリミングすることも踏まえて引き受けていただけると幸いです。\nhttps://pbs.twimg.com/media/FRRIEfRUcAAyDY2?format=jpg&name=large\n四葉・三玖の花嫁姿\n三玖の顔部分を推しに置換え　\ntwitter.com/kotohalibrary　の髪型はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/8", "thumbnail_src": "https://si.imgix.net/b069f7d5/uploads/origins/3d16cf3e-7b4a-42aa-ba6b-5de48ea797f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=525191ec2a18117cd498d3f4028632fb", "thumbnail_srcset": "https://si.imgix.net/b069f7d5/uploads/origins/3d16cf3e-7b4a-42aa-ba6b-5de48ea797f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=525191ec2a18117cd498d3f4028632fb, https://si.imgix.net/b069f7d5/uploads/origins/3d16cf3e-7b4a-42aa-ba6b-5de48ea797f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90177870e94c2f8ec67c93798a0132ef 2x, https://si.imgix.net/b069f7d5/uploads/origins/3d16cf3e-7b4a-42aa-ba6b-5de48ea797f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ba588171bf3d9e5945ee428bc70ab46 3x", "genre": "art", "nsfw": false, "body": "ゆうさん\nお世話になってます。\n風四絵を再度お願いしても宜しいでしょうか？\n\n［内容］\n雪見露天風呂で内心ウキウキで寛ぐ風太郎君＆それを見て隣で微笑む四葉ちゃんをお願いします。(健全絵)\n\n［シチュ］\n大学生の風四が二人で水入らずの温泉旅行へ。\n厚手のバスタオルを巻いて客室備え付けの露天風呂に入って疲れを取る…という感じです。\n\n［描写］\n・頭のリボン(タオル製)の有無はお任せします。\n・ゲーム「ごとぱず」のように、四葉ちゃんがお湯におもちゃのアヒルを浮かばせて下さい。\n(参考用に公式様TwitterのURLを添付致します)\n\n以上となります。\nご検討のほどよろしくお願いします。\n\nhttps://twitter.com/5hanayome_pzl/status/1481491214327496710?s=21", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/7", "thumbnail_src": "https://si.imgix.net/633a0300/uploads/origins/837986f8-fdb9-48af-a9c6-a5a59e0ece59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d2ccef3a86f9f53b02d2371b0af55ce", "thumbnail_srcset": "https://si.imgix.net/633a0300/uploads/origins/837986f8-fdb9-48af-a9c6-a5a59e0ece59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d2ccef3a86f9f53b02d2371b0af55ce, https://si.imgix.net/633a0300/uploads/origins/837986f8-fdb9-48af-a9c6-a5a59e0ece59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1c6bb0829c63d806c2b5b7b8bbd65d7 2x, https://si.imgix.net/633a0300/uploads/origins/837986f8-fdb9-48af-a9c6-a5a59e0ece59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3baf269380f9b03ce2d9bf961c02ac9a 3x", "genre": "art", "nsfw": false, "body": "ゆうさん\n前回は素敵な五等分イラストを納品して下さり、本当にありがとうございます！\n今回も風四絵を希望します。\n\n［依頼］\n水着でウォータースライダーを一緒にボートで滑る風太郎くんと四葉ちゃんをお願いします。\n［シチュ］\n夏休みに東京から帰省した風太郎が、五つ子５人と原作92話で行ったプールへ。\nウォータースライダーで姉妹達が気を利かせて風太郎と四葉を一緒に組ませたものの、当の２人はどっちが前・後になるかで悩んだ末に…という感じです。\n［最後に］\n・四葉の髪型はコラボレーションアパレル2022のウェーブ掛かったものだと嬉しいです。\n・どちらを前・後にするかはゆうさんにお任せします！\n\nhttps://ugcircus.official.ec", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/6", "thumbnail_src": "https://si.imgix.net/e2719231/uploads/origins/3e4045bd-04ae-4bc7-88fa-18ea88c845a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0d5e65c482d67541f9195a083b9d817", "thumbnail_srcset": "https://si.imgix.net/e2719231/uploads/origins/3e4045bd-04ae-4bc7-88fa-18ea88c845a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0d5e65c482d67541f9195a083b9d817, https://si.imgix.net/e2719231/uploads/origins/3e4045bd-04ae-4bc7-88fa-18ea88c845a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4bbbfc3e5e0d91e4366df7dcdfa01c6 2x, https://si.imgix.net/e2719231/uploads/origins/3e4045bd-04ae-4bc7-88fa-18ea88c845a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e084a9dfb6f67b918661a6a650e523d 3x", "genre": "art", "nsfw": false, "body": "玉川です！ご丁寧な対応ありがとうございます！五等分の花嫁イラスト制作、よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/5", "thumbnail_src": "https://si.imgix.net/b5281454/uploads/origins/e085002f-68b5-48ac-93b4-351e8f369d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bccd05702440a811e485a29a798db3c9", "thumbnail_srcset": "https://si.imgix.net/b5281454/uploads/origins/e085002f-68b5-48ac-93b4-351e8f369d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bccd05702440a811e485a29a798db3c9, https://si.imgix.net/b5281454/uploads/origins/e085002f-68b5-48ac-93b4-351e8f369d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64ae6bfeae87214c4596f4506942a77e 2x, https://si.imgix.net/b5281454/uploads/origins/e085002f-68b5-48ac-93b4-351e8f369d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5525b1984a10691ef29f62207afd234 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/4", "thumbnail_src": "https://si.imgix.net/846f7bf9/uploads/origins/3d440d96-6464-424c-a14b-1e650f0e4790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca22b1f502acab4d225ae2bb11d2c3d9", "thumbnail_srcset": "https://si.imgix.net/846f7bf9/uploads/origins/3d440d96-6464-424c-a14b-1e650f0e4790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca22b1f502acab4d225ae2bb11d2c3d9, https://si.imgix.net/846f7bf9/uploads/origins/3d440d96-6464-424c-a14b-1e650f0e4790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5b4d3a0827a400d051966b843e6423e 2x, https://si.imgix.net/846f7bf9/uploads/origins/3d440d96-6464-424c-a14b-1e650f0e4790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebbd59c9f86fa9fada5ffa62e02317a3 3x", "genre": "art", "nsfw": false, "body": "ゆうさん初めまして。\nいつも五等分の花嫁のイラストを拝見させて頂いてます！\n\n東京にいる風太郎くんの家にお泊まりに来た大学生四葉ちゃんが、夜にパジャマで一緒のベッドで寝るイラストを希望します。\nお互いがすごく意識してる感じで、初々しさがあると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@FlowerBird3830/works/3", "thumbnail_src": "https://si.imgix.net/381ad606/requests/225504_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1e9355da27874a1b259d49e2cd82979", "thumbnail_srcset": "https://si.imgix.net/381ad606/requests/225504_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1e9355da27874a1b259d49e2cd82979, https://si.imgix.net/381ad606/requests/225504_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5281d4337b691fe7c4890f09b0e3e96c 2x, https://si.imgix.net/381ad606/requests/225504_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e36e0b9fed76c44d9f80592e55b76154 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}