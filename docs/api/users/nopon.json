ebp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acff3b29a16adc7ad6b69d571d482b80", "thumbnail_srcset": "https://si.imgix.net/219713cc/uploads/origins/d674709c-5897-4577-aa8f-39bdc8a3348b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acff3b29a16adc7ad6b69d571d482b80, https://si.imgix.net/219713cc/uploads/origins/d674709c-5897-4577-aa8f-39bdc8a3348b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3ab0d92e3efdfdc3f5c0868e7571a90 2x, https://si.imgix.net/219713cc/uploads/origins/d674709c-5897-4577-aa8f-39bdc8a3348b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9a9e80fcbcb5bc367863cd3f9ec3692 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/84", "thumbnail_src": "https://si.imgix.net/41cefdda/uploads/origins/8a113d72-710e-4620-bda9-dd0d392abfeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85d85f4bc11ffa5ae23da2162da7ab4e", "thumbnail_srcset": "https://si.imgix.net/41cefdda/uploads/origins/8a113d72-710e-4620-bda9-dd0d392abfeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85d85f4bc11ffa5ae23da2162da7ab4e, https://si.imgix.net/41cefdda/uploads/origins/8a113d72-710e-4620-bda9-dd0d392abfeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eb46957ddc8879b1aac5a838c0d38cf 2x, https://si.imgix.net/41cefdda/uploads/origins/8a113d72-710e-4620-bda9-dd0d392abfeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8519962cec02cb97dd0c82a9e469c42 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/83", "thumbnail_src": "https://si.imgix.net/1b75210f/uploads/origins/6257de78-56a7-41da-881b-d386b83e1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1094b737d1a7cff029a7ff780fbd1d95", "thumbnail_srcset": "https://si.imgix.net/1b75210f/uploads/origins/6257de78-56a7-41da-881b-d386b83e1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1094b737d1a7cff029a7ff780fbd1d95, https://si.imgix.net/1b75210f/uploads/origins/6257de78-56a7-41da-881b-d386b83e1129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1076ded3776558101241ecf1c3337604 2x, https://si.imgix.net/1b75210f/uploads/origins/6257de78-56a7-41da-881b-d386b83e1129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dda81bbb2d127071c9522f82212c2482 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！また別のOCのアートをお願いしたいです！\n\nOCは参考の最初の画像であるSDに一番似ています！他の2枚は彼女の昔のデザインです。\n\nヘアスタイルはそのセクションの最初の画像に似ています。しかし、ヘアアクセサリーは2番目の画像です！\n\n彼女の武器はそのセクションの最初の画像です。武器に2枚目の画像のタッセルをつけてください！\n\n彼女の衣装は最後のセクションです！ピンクではなく青にしてください！彼女の靴は最後の画像にあるブーツですが、他の衣装に合わせてください！\n\n彼女はエレメンタルキャスターですが、光属性の攻撃を好みます！\n\nたくさんあると思いますが、よろしくお願いします！\n\nhttps://melon-scent-ea1.notion.site/Ignia-GBF-45d38700f54f4c0aa74cde2acc31fc93?pvs=4", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/82", "thumbnail_src": "https://si.imgix.net/1c40c8b1/uploads/origins/563459cb-545c-4b65-a1f9-dc0c74897719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4776abe93c1feea0deb7cf49b4eb1e66", "thumbnail_srcset": "https://si.imgix.net/1c40c8b1/uploads/origins/563459cb-545c-4b65-a1f9-dc0c74897719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4776abe93c1feea0deb7cf49b4eb1e66, https://si.imgix.net/1c40c8b1/uploads/origins/563459cb-545c-4b65-a1f9-dc0c74897719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d84d00ceb1137aab50032f9fd1ad342 2x, https://si.imgix.net/1c40c8b1/uploads/origins/563459cb-545c-4b65-a1f9-dc0c74897719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20ae2da1f348b3a41daf6655fde7e0d9 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！前回のリクエストに応えていただきありがとうございました。今回もよろしくお願いします。\n\n今回は、FFXIVとエルデンリングという2つのゲームのキャラクターの組み合わせです。\n\n金髪の三つ編みのポニーテールで、腕章のついた古い白いローブを着て、両手にロングソードを振り回しています。顔はFFXIVのキャラクターがベースで、青い目、赤い唇、唇の横にマークがある。爪と足の爪は赤い。\n\n彼女は戦女神かヴァルキリータイプのキャラクターだと思われる。彼女は強くて自信に満ちている。\n\nhttps://drive.google.com/drive/folders/1xkQSilGwc-z-ylkGT-Gzj2yBLebmtlck?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/81", "thumbnail_src": "https://si.imgix.net/0723605b/uploads/origins/af3e73e1-f770-453a-b94e-1a36684b6a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b408a50d9e836e81cea66d80efd814df", "thumbnail_srcset": "https://si.imgix.net/0723605b/uploads/origins/af3e73e1-f770-453a-b94e-1a36684b6a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b408a50d9e836e81cea66d80efd814df, https://si.imgix.net/0723605b/uploads/origins/af3e73e1-f770-453a-b94e-1a36684b6a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b247a985b061dc63a984b5af8fc2968 2x, https://si.imgix.net/0723605b/uploads/origins/af3e73e1-f770-453a-b94e-1a36684b6a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03a082e913256af5150cc5d762e95f50 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！ダイアナのもう一人の娘を投稿しに来ました！先生の「アルティメットオメガ」の武器の描き方は本当に楽しいです。\n\n彼女は生意気でいたずら好き。占星術師として、地球儀とタロットカードを使って呪文を唱えます。マントと袖の間の肌の隙間が見えるようなポーズがいいな。\n\n上2枚の写真から、いずれかのカラーを選んでください。\n\nありがとうございました！\n\nhttps://melon-scent-ea1.notion.site/nopon-or-simanoko-Cynthia-0c3659d2692c4773bfd18dd63fe8309f?pvs=4", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/80", "thumbnail_src": "https://si.imgix.net/cf420693/uploads/origins/e5783af0-8a79-4058-862c-4089196bde57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39386d5caa9fbc68f51d889788fa6d7e", "thumbnail_srcset": "https://si.imgix.net/cf420693/uploads/origins/e5783af0-8a79-4058-862c-4089196bde57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39386d5caa9fbc68f51d889788fa6d7e, https://si.imgix.net/cf420693/uploads/origins/e5783af0-8a79-4058-862c-4089196bde57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1652812a30072b9db6983a2cd857ff6 2x, https://si.imgix.net/cf420693/uploads/origins/e5783af0-8a79-4058-862c-4089196bde57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f09f300809127fd3d10abb22a8e52d3 3x", "genre": "art", "nsfw": false, "body": "初めまして！のっぽさん描くイラストの作風が好きでリクエストを送ってみました。\n\nもしよろしければ、うちの子を描いて頂きたいです。\nイメージカラーは青、クールな一面も持ちつつ、基本うるさくて不器用なおてんばお姉さんです。\nhttps://imgur.com/a/DrHRCPD\n右ツノにカボチャのイヤリング（https://jp.finalfantasyxiv.com/lodestone/playguide/db/item/8931cefcffd/）を付けています。\n帽子も２種類ありますが、お好きな方でなしverもあると嬉しいです。\n\nドヤ顔もしくは勝ち気な感じで、ポーズ構図はお任せします。\n武器と資料①②③④のハウスのようなスチームパンクな感じ、連れているミニオン「忍犬シロマル」も一緒に描いてください。\n\nSNSアイコンにも使用したいので、PSDで宛名やキャラ単体、背景を別レイヤーでON/OFFできると助かります。\nPSD閲覧可能な環境ですので、下書きやラフ（可能であれば入れて頂けると嬉しいです）もあれば入れていただけると嬉しいです。\n\n細かい要望のリクエストになってしまいましたが、ご検討のほどよろしくお願い致します！\n\nhttps://imgur.com/a/DrHRCPD", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/79", "thumbnail_src": "https://si.imgix.net/3f0254cf/uploads/origins/6d1dfc36-f115-43f9-9d4d-17599f9d2c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58c7d31d41bc699a9e102b2417d78023", "thumbnail_srcset": "https://si.imgix.net/3f0254cf/uploads/origins/6d1dfc36-f115-43f9-9d4d-17599f9d2c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58c7d31d41bc699a9e102b2417d78023, https://si.imgix.net/3f0254cf/uploads/origins/6d1dfc36-f115-43f9-9d4d-17599f9d2c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e86af8ed6c7a0a3394548aac14068f30 2x, https://si.imgix.net/3f0254cf/uploads/origins/6d1dfc36-f115-43f9-9d4d-17599f9d2c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1bec97409877f950330581bb86e074e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私もこの娘のセカンドバージョンを送りたいと思っていました。今回は髪にリボンをつけています。\n\nお願いしてよかったのですが、髪と目の色の違う3つのバージョンを全部入れてもらっても大丈夫でしょうか？(金髪バージョン、白髪と日焼けバージョン、ピンク髪バージョン）。\nそうでなければ、白髪バージョンが望ましいです。\nこの武器は \"アスフォデロス・ロングソード \"と \"アスフォデロス・シールド\"\nできれば盾よりも衣装と剣に重点を置いてほしい。\n\nありがとうございます！\n\nhttps://melon-scent-ea1.notion.site/Diantha-PLD-fc210aa4f6a74e90843c9bffc6d2a6da?pvs=4", "created_at": "", "completed_at": ""}, {"path": "/@nopon/works/78", "thumbnail_src": "https://si.imgix.net/5591898d/uploads/origins/bf71cf0b-b468-41ab-a080-5876fa44f798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1163099d33a1c0dfc947d0c05a92b603", "thumbnail_srcset": "https://si.imgix.net/5591898d/uploads/origins/bf71cf0b-b468-41ab-a080-5876fa44f798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1163099d33a1c0dfc947d0c05a92b603, https://si.imgix.net/5591898d/uploads/origins/bf71cf0b-b468-41ab-a080-5876fa44f798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8c403bd4a13bf7832c7e4ec745c90cd 2x, https://si.imgix.net/5591898d/uploads/origins/bf71cf0b-b468-41ab-a080-5876fa44f798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6292a90f069b6c3af431d93b4d42eb 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは！私のOCを描いてください。ハーフエルフなので、耳がやや尖っています。\n真面目な表情の女騎士です。でも心は乙女。\n使用武器は「アスフォデロス・クレイモア」。\nピンクのリボンが肌の中で目