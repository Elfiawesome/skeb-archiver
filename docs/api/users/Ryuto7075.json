8-4f1d-8357-560b3d19272f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82ff30e008a9ca09b2018dcad732fcb9", "thumbnail_srcset": "https://si.imgix.net/f94392e1/uploads/origins/d04f2d8c-a2f8-4f1d-8357-560b3d19272f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82ff30e008a9ca09b2018dcad732fcb9, https://si.imgix.net/f94392e1/uploads/origins/d04f2d8c-a2f8-4f1d-8357-560b3d19272f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce2bdaf4eafbf6f20f73ad5d8461f1cc 2x, https://si.imgix.net/f94392e1/uploads/origins/d04f2d8c-a2f8-4f1d-8357-560b3d19272f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee486b75990ae582ceaac30316f0e949 3x", "genre": "art", "nsfw": true, "body": "先ほどニムエの依頼を送った者です。もう一件ニムエの依頼を送らせて頂きます\n\n・構図\n個室トイレで、ニムエが両手で下乳を押さえながらのパイズリ。おっぱいは見栄えが悪くならない限界まで大きくした爆乳で、乳首は陥没していない状態でお願いします。ちんちんは谷間から亀頭がはみ出るくらいのサイズで\nニムエの服装は資料と同じ全裸で、首輪は残して下さい。おっぱいとニムエの顔に寄せたアングルで、竿役は立った状態で下乳からちんちんを挿入、ニムエはガニ股の状態で谷間からはみ出た亀頭が目の前にくるようにお願いします。また、乳首が隠れない程度に2人が密着するようにして下さい\n\n・差分\n全編通して湯気がムワムワと立っていて、ニムエの顔の周りにハートマークが沢山あり、ハート目になっていて発情しているようにして下さい\n①パイズリ開始前\nちんちんをおっぱいで挟んだだけの状態をお願いします。ちんちんはビクビクと震えていて我慢汁を漏らしているようにして頂けると\nニムエはニマニマした表情で舌なめずりをしており、「ふー…❤ふー…❤」と興奮しながら「おちんぽ硬くてくっさぁい…❤そんなにえっちなおしっこしたいんですねぇ…❤」のような台詞を\n\n②激しくパイズリ\nおっぱいで激しくおちんちんをズッて下さい。竿役の腰はガクガクしており、我慢汁の量も増やしていただけると嬉しいです\n愉しげな表情を浮かべながら「ほら❤ザーメン専用おっぱい便器の中で❤白いおしっこしーしー漏らせ❤」のような台詞を\n\n③射精\nドロドロの濃ゆい精液がたくさん勢いよく吹き出てくる大量射精を希望します。竿役の腰のガクつきも激しくして下さい\n1枚目のような舌なめずりしながらニヤついた表情を浮かべ「びゅーびゅー白くてくさ～いおしっこたっくさぁん…❤そんなにおっぱいトイレ気持ちいいんだぁ…❤」のような台詞を\n\n④追撃連続射精(可能であれば\n射精中に激しく追撃パイズリを行い、3枚目よりも大量の精液が吹き出るようにして下さい\n愉しげかつ強気な表情を浮かべながら「おしっこ気持ちいいでちゅね～❤白くてくっさ～いのがじょろろろ～って溢れてきまちゅよ～❤」のような台詞を\n\n⑤事後\nニムエにべっとりとした精液がたくさん付着し、表情は舌なめずりしながらトロ顔だと嬉しいです\n「ザーメン臭が辺りに充満して…❤次使う人に白いおしっこ射精してたのバレちゃいますねぇ❤」のような台詞を\n\nhttps://image01.seesaawiki.jp/k/a/kssma/e5df2895b596c8bf.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Ryuto7075/works/61", "thumbnail_src": "https://si.imgix.net/e832a603/uploads/origins/9fc106e3-7181-4e20-8098-07cd62aa6e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffeb89f4745f4622553ba84681944559", "thumbnail_srcset": "https://si.imgix.net/e832a603/uploads/origins/9fc106e3-7181-4e20-8098-07cd62aa6e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffeb89f4745f4622553ba84681944559, https://si.imgix.net/e832a603/uploads/origins/9fc106e3-7181-4e20-8098-07cd62aa6e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd7c26f9cda42010550076e4e17b6738 2x, https://si.imgix.net/e832a603/uploads/origins/9fc106e3-7181-4e20-8098-07cd62aa6e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ca65119c18a6b7ceddfc2d7eacfd2ce 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n\nマイナーなキャラで申し訳ありませんが、他ガ為のアルケミストというゲームのラミアでお願いします。\n公式立ち絵: https://image01.seesaawiki.jp/t/u/tagatamekouryaku/1fe062b98c53102e.png\n正面イラスト: https://image01.seesaawiki.jp/t/u/tagatamekouryaku/5175c1e0bf39f8b3.jpeg\n\n真正面を向き、背面駅弁やフルネルソンなど持ち上げられた状態で犯されている内容でお願いします。服装はキャラクターが分かるような程度にアクセサリーが残っていればおまかせします。\n\n差分は、\n①挿入前、見せつけるように男性器を股に擦り付けられている。ラミアは「くっ…」と抵抗する様子を見せる。\n②快楽に抗えず、おほ顔を下品に喘ぎ絶頂。\n③快楽堕ちの表示。蕩けた笑顔でメロメロな様子。\n\n竿役はオークやミノタウロスのイメージですが、好みでなければ、人間の男でも構いません。\n\n以上になります。検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ryuto7075/works/60", "thumbnail_src": "https://si.imgix.net/cff1f0df/uploads/origins/5809119f-00fa-4ac1-9e92-f6d8e217f9ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4b16d5bf25fe288b227f59c37a429c", "thumbnail_srcset": "https://si.imgix.net/cff1f0df/uploads/origins/5809119f-00fa-4ac1-9e92-f6d8e217f9ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4b16d5bf25fe288b227f59c37a429c, https://si.imgix.net/cff1f0df/uploads/origins/5809119f-00fa-4ac1-9e92-f6d8e217f9ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c139f1a1bef93cd68718de3797980a20 2x, https://si.imgix.net/cff1f0df/uploads/origins/5809119f-00fa-4ac1-9e92-f6d8e217f9ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0870d61bb21471133c2c73b12c6b697f 3x", "genre": "art", "nsfw": true, "body": "こんにちは、初めて依頼を送らせて頂きます\n\n・キャラ\nミリオンアーサーのニムエ\n\n・構図\nアングルは正面からで、ニムエが両手で下乳を押さえながらの膝上パイズリ。おっぱいは見栄えが悪くならない限界まで大きくした爆乳で、乳首は陥没していない乳頭が出ている状態だと嬉しいです。ちんちんは谷間から亀頭がはみ出るくらいのサイズを\nニムエの衣装はおっぱいの周りだけ服をはだけさせた状態で、それ以外の箇所は何も着ていない状態。腕は手袋だけ脱がすようにして頂けると。首輪と帽子は残すようにして頂いて、できるだけ帽子でニムエの顔が隠れないようにして下さい\n\n・差分\n全編通して湯気がムワムワ～と立っていて、ニムエの顔の周りにハートマークが沢山あり、ハート目になっていて発情しているようにして下さい\n①ちんちんをおっぱいで包囲する\nまだちんちんは挟まずに、膝上におっぱいを乗せた状態でおっぱいの間にちんちんがあるのを見せつけてください。ちんちんはビクビクと震えていて我慢汁を漏らしているようにして頂けると嬉しいです\nニムエはニマニマした表情で舌なめずりをしており、「ふー…❤ふー…❤」と興奮しながら「くさ～いちんぽ…❤おっぱいで食べちゃいますねぇ…❤」といったような台詞を言っているようにして下さい\n\n②おっぱいを思いっきり挟む\nパチュン！と音が出るような勢いでおっぱいでおちんちんを挟んでください。竿役のちんちんや腰がビクンと震えるようにして頂けると嬉しいです\nニムエの表情は1枚目と変わらずニマニマしながら舌なめずりするようにして下さい。同じように興奮しながら、「激臭ちんぽいっただきま～す…❤」のような台詞を\n\n③激しくパイズリ\nおっぱいで激しくおちんちんをズッて下さい。竿役の腰やちんちんはガクガクしており、我慢汁の量も増やして頂けると嬉しいです\nニムエの表情は少しオホりながら、「おっ❤濃厚ちんぽくっさ❤ザーメンっ❤くっさいザーメン漏らせっ❤」のような台詞を\n\n④射精\n精液がたくさん勢いよく吹き出てくる射精を希望します\nニムエは3枚目の時よりもオホりながら、「おおっ❤特濃ザーメンくっさぁっ❤もっと❤もっと臭いの漏らせっ❤」のような台詞を\n\n⑤事後\nニムエにべっとりした精液がたくさん付着し、表情は舌なめずりしながらトロ顔だと嬉しいです\n台詞は「は～…❤ザーメンくっさ…❤頭クラクラします…❤」のような台詞を\n\nhttps://image01.seesaawiki.jp/k/a/kssma/baf94b20b2e6da4b.PNG", "created_at": "", "completed_at": ""}, {"path": "/@Ryuto7075/works/59", "thumbnail_src": "https://si.imgix.net/64ecc467/uploads/origins/e55316fb-0ad5-4382-903c-f1028da93db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e877effeb76a54370e50ba4deb368bd2", "thumbnail_srcset": "https://si.imgix.net/64ecc467/uploads/origins/e55316fb-0ad5-4382-903c-f1028da93db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e877effeb76a54370e50ba4deb