すりつけおねだりする大鳳（ニマニマした表情、舌なめずり、ハート目）\n\n②挿入\nデカチンを「ぬぷぬぷぬぷぅ～……♥」とゆっくり挿入され、オホる大鳳\n\n③ピストン\n激しいピストン、牛の鳴き声で喘ぎまくる大鳳\n\n④射精\n舌を出し牛の鳴き声でイキまくる大鳳（断面図有り）\n\n⑤\n指揮官の方に目線を送りつつトロ顔の大鳳（受精吹き出し有り）\n\n全編通してハート目で、顔の周りにハートマークいっぱい、イチャラブな感じでお願いします。\n\n------------\n\nリクエストは以上です\n長々と大量に要望を書いてしまいましたが、もしよろしければご検討いただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Ryuto7075/works/50", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/4234c463/uploads/origins/8a677fe3-24fe-4523-b485-fa6b4d57ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d6a719694accdce55bd81319cb3096d", "thumbnail_srcset": "https://si.imgix.net/4234c463/uploads/origins/8a677fe3-24fe-4523-b485-fa6b4d57ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d6a719694accdce55bd81319cb3096d, https://si.imgix.net/4234c463/uploads/origins/8a677fe3-24fe-4523-b485-fa6b4d57ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c01e02fad204090df924e354094b5032 2x, https://si.imgix.net/4234c463/uploads/origins/8a677fe3-24fe-4523-b485-fa6b4d57ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eff0b86907c8ccfb3c1edfc79c6f91f3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ryuto7075/works/49", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/42845d0f/uploads/origins/8d68e070-b3be-4d2f-bf7f-69df2b54bf9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecba2e0170e30d913db48fad59bfe352", "thumbnail_sr