.net/1a3ebd0c/uploads/origins/8525e524-53ce-4fb9-89fb-b27c99491df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d689ee781056d6727e84c507f5e65034", "thumbnail_srcset": "https://si.imgix.net/1a3ebd0c/uploads/origins/8525e524-53ce-4fb9-89fb-b27c99491df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d689ee781056d6727e84c507f5e65034, https://si.imgix.net/1a3ebd0c/uploads/origins/8525e524-53ce-4fb9-89fb-b27c99491df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=031a2af062f1346116ac2503a1251bc8 2x, https://si.imgix.net/1a3ebd0c/uploads/origins/8525e524-53ce-4fb9-89fb-b27c99491df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a41ba3fd9fbed6b1006f9dca8ae2ff07 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nイザナワレ🏮さんのFGOキャラのイラストを見て知り、とても素敵だったので、今回依頼させていただきました。\n描いて頂きたいものですが、私（新人VTuberとして活動してます、名前は神楽雫です。）とFGOのギルガメッシュ第二再臨の一枚絵をお願いしたいです。二人で一枚絵という形です。\n構図や背景はお任せ致します。納品サイズはサイズは特に決まっていませんが、ツイートするときに見やすいサイズだと嬉しいです。縦、横もお任せ致します。\n私（神楽雫）は資料URLを参考にしてください。\n使用用途ですが、VTuberとして1周年を迎えるときに、記念配信のカウントダウンツイートで、グランド鯖と私のイラストをツイートしたいと思っています。また、記念配信の方でもイラストと一緒に紹介したいと思います。\nぜひ、引き受けていただけたら嬉しいです。\n\nhttps://x.com/kagura_shizuku/status/1775618270659502149?t=Btt4p7tB9AzuoM8CvhRaDw&s=19\n\nhttps://x.com/kagura_shizuku/status/1775618270659502149?t=Btt4p7tB9AzuoM8CvhRaDw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@izanaware_game/works/4", "thumbnail_src": "https://si.imgix.net/f033b874/uploads/origins/b9a3058b-7b85-4026-8f06-a4c502b18536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20900ebdbc077309d52507421b174c8f", "thumbnail_srcset": "https://si.imgix.net/f033b874/uploads/origins/b9a3058b-7b85-4026-8f06-a4c502b18536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20900ebdbc077309d52507421b174c8f, https://si.imgix.net/f033b874/uploads/origins/b9a3058b-7b85-4026-8f06-a4c502b18536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4ddc9a52e7834f8087757cefa1a470c 2x, https://si.imgix.net/f033b874/uploads/origins/b9a3058b-7b85-4026-8f06-a4c502b18536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=249dffed96c3f5aa6a2b69adeb849244 3x", "genre": "art", "nsfw": false, "body": "こんにちは。キャミソールを着て、デニムショーツを着て、ジャケットを着た酒呑童子を描いてください。\nhttps://www.pixiv.net/artworks/74563178\nhttps://pbs.twimg.com/media/D0Aq0vbUUAUenm-?format=jpg&name=medium\n\nベルトはしておらず、ショートパンツの一番上のボタンは外しています。全体のデザインと色はお任せします。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@izanaware_game/works/3", "thumbnail_src": "https://si.imgix.net/2131405f/uploads/origins/e0f39a35-2928-44bc-af58-90c466168bba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385d5b646db402ec6fb3ac59ad05f01e", "thumbnail_srcset": "https://si.imgix.net/2131405f/uploads/origins/e0f39a35-2928-44bc-af58-90c466168bba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385d5b646db402ec6fb3ac59ad05f01e, https://si.imgix.net/2131405f/uploads/origins/e0f39a35-2928-44bc-af58-90c466168bba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=725e8c3d9456dfea8e4cb845f995806e 2x, https://si.imgix.net/2131405f/uploads/origins/e0f39a35-2928-44bc-af58-90c466168bba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddb0dc2ec5b1696eb533651215a9bfa1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、イザナワレ！\n\ntwitterでイザナワレさんの絵を拝見し、酒呑童子の描き方に魅了されました！私のVtuberのイラストをお願いしたいです！\n\n彼女は日焼けした肌の鬼で、ハイテクウェアや近未来的なスタイルの服を着ています。普段は無表情ですが、すぐに感情的になります。そばかすが目立ちにくく、尖った耳が髪の後ろに隠れている。\n\nポーズや表情など、その他のディテールはお任せします！\n\nイラストは温泉をイメージしています。温泉で湯上りに着るようなゆたかな格好でお願いしたいです。肩が出るように少しゆったりめでお願いしたいです。また、日本酒をサカズキで飲むようにお願いしたいです。\n\nその他はご自由にお選びください。\n\nhttps://imgur.com/a/zoiteki-references-y6eiahM", "created_at": "", "completed_at": ""}, {"path": "/@izanaware_game/works/2", "thumbnail_src": "https://si.imgix.net/c09af11d/uploads/origins/a6db31bb-2c75-45f3-930b-68ffc1abe854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99a1e931fa3c14f2b6bb72af4e73500", "thumbnail_srcset": "https://si.imgix.net/c09af11d/uploads/origins/a6db31bb-2c75-45f3-930b-68ffc1abe854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99a1e931fa3c14f2b6bb72af4e73500, https://si.imgix.net/c09af11d/uploads/origins/a6db31bb-2c75-45f3-930b-68ffc1abe854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5efa09359ba10c946fba816d9f37826 2x, https://si.imgix.net/c09af11d/uploads/origins/a6db31bb-2c75-45f3-930b-68ffc1abe854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdb6c38156b9b28e6fc46eced927afce 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\nクロエの新しい夏のアヴェンジャーの公式コスチュームがとても気に入っています。\nhttps://static.wikia.nocookie.net/typemoon/images/1/1c/AvengerChloevonEinzbernCostume1.jpg/revision/latest?cb=20230811155914\n\n同じような衣装で酒呑童子を描いていただけませんか？\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@izanaware_game/works/1", "thumbnail_src": "https://si.imgix.net/280e22eb/uploads/origins/3f69b34b-e900-41e5-a74a-b32eab1cbfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a0e69b4ead242e69dfb9497d9828a7", "thumbnail_srcset": "https://si.imgix.net/280e22eb/uploads/origins/3f69b34b-e900-41e5-a74a-b32eab1cbfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a0e69b4ead242e69dfb9497d9828a7, https://si.imgix.net/280e22eb/uploads/origins/3f69b34b-e900-41e5-a74a-b32eab1cbfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b1431421f4e695b7726e2721c65db51 2x, https://si.imgix.net/280e22eb/uploads/origins/3f69b34b-e900-41e5-a74a-b32eab1cbfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be08f4c092998d08f0deead2d1792a0d 3x", "genre": "art", "nsfw": false, "body": "Hello!!\nYour art is so gorgeous, I love how you draw Shuten-Douji!!\n\nI'd love to get a piece of my Vtuber character in something like this work of yours:\nhttps://twitter.com/izanaware_game/status/1493148023341273090?s=20&t=kssYlTorJS-rWYOEI49DRw\nA school uniform sitting on a desk with a similar pose/expression would be great! I leave all the details to you, I'd love to see how you design it ^^\n\nShe's a tomboy guitarist that loves cars and motorcycles!\n\nThank you so much!! I'd like to use this on SNS and Twitch if that's okay~\n\nhttps://drive.google.com/drive/folders/1DBmYwOGoRlnEKC2qpgA8W4Fs3EQA2qVs", "created_at": "", "completed_at": ""}]}