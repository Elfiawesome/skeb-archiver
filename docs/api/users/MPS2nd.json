px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45449890c07d84b50cffe933b7bd006d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MPS2nd/works/9", "thumbnail_src": "https://si.imgix.net/34c5d6c3/uploads/origins/478e034f-c12c-449c-b895-2681b754abbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9850f0b48ef12af765b7e6f5c529e4f5", "thumbnail_srcset": "https://si.imgix.net/34c5d6c3/uploads/origins/478e034f-c12c-449c-b895-2681b754abbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9850f0b48ef12af765b7e6f5c529e4f5, https://si.imgix.net/34c5d6c3/uploads/origins/478e034f-c12c-449c-b895-2681b754abbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=252433522004d4c3af13acd8d2cae97f 2x, https://si.imgix.net/34c5d6c3/uploads/origins/478e034f-c12c-449c-b895-2681b754abbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48b11427ad6f9bb9eeb924206baab0e6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お気に召さないようでしたら、お断りいただいても結構です！\n\n 私はあなたの芸術をとても崇拝しています！^^\n\nもしよろしければ、これに似たものをリクエストしてもよろしいでしょうか！: https://x.com/mps2nd/status/1757528835804008870?s=46&t=SVOMKPLPL1c68cVX9UD3AQ\n\nそれでも、あなたが一番好きなものを描いてください〜！\n\n私のオリジナルベアガールのレスリー(159cm、Dカップ)と赤毛のボーイフレンドのクロウ(165cm)をお願いしてもいいですか？  \n\nテーマはレスリーの誕生日です！レスリーは春生まれなので、レスリーの誕生日をお祝いする楽しいラブコメのシナリオがあれば完璧です！\n\n登場人物の情報\n\nレスリー：優しくて、明るくて、思いやりのある女の子。地味で普通の外見だが、まぶしいアイドルになりたいと願っている。いつも笑顔で頑張っている！でも、不器用でおバカな一面もある。カラスと一緒にいると、おっちょこちょいでちょっとイライラすることもあるけれど、レスリーは良いガールフレンドで、カラスを赤面させる言葉をいつも知っている。\n\n Crow: 大声で、大胆で、自己中心的な男で、自分が世界一だと信じて疑わない。しかし、カラスは子供っぽく、議論好きでバカなところがある。粗野な態度とは裏腹に、心の底では友だちやレスリーを大切に思っている。(クロウはちょっとツンデレ！）。クロウはヴィジュアル系ミュージシャンで、ギターとボーカルを担当している！  \n\nプレゼントのアイデアとしては、クロウはレスリーの誕生日に牛乳（彼の家族は酪農家で、彼はそれを誇りに思っている！）とネックレスのようなファンシーなジュエリーを贈るだろう。彼はレスリーにキスもするだろう...。\n\nレスリーとカラスはコメディのような楽しいロマンチックな関係だ。二人ともバカで、ちょっと喧嘩っ早い。でも、2人とも相手なしでは生きていけないし、愛し合っている。   \n\nポーズや表情など、私が見逃したものはすべてあなたの自由です！  \n\n読んでくれてありがとう参考文献はグーグルリンクからどうぞ！\n\nhttps://drive.google.com/drive/folders/115EmGT0omc6TNe9tLXTdjk52DJNoiLWZ", "created_at": "", "completed_at": ""}, {"path": "/@MPS2nd/works/8", "thumbnail_src": "https://si.imgix.net/0b65e799/uploads/origins/7fe0b338-4c78-4bed-898b-0ff4bfd78b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5080f07c167bdaf343fd847cb06d06c", "thumbnail_srcset": "https://si.imgix.net/0b65e799/uploads/origins/7fe0b338-4c78-4bed-898b-0ff4bfd78b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5080f07c167bdaf343fd847cb06d06c, https://si.imgix.net/0b65e799/uploads/origins/7fe0b338-4c78-4bed-898b-0ff4bfd78b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2283aa4ac7c61a0864d5be7b28898f7 2x, https://si.imgix.net/0b65e799/uploads/origins/7fe0b338-4c78-4bed-898b-0ff4bfd78b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=398e78553d9571491d377119f36f8a01 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MPS2nd/works/7", "thumbnail_src": "https://si.imgix.net/3901875c/uploads/origins/3455a1f1-58a3-4b9c-b888-7ec390b27099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9078c543600e8b4f1bb1f01288eb4d5a", "thumbnail_srcset": "https://si.imgix.net/3901875c/uploads/origins/3455a1f1-58a3-4b9c-b888-7ec390b27099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txts