.net/fbf8b118/uploads/origins/8a0a20a5-bd75-48d2-95dd-54b0a3b87954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a76e879ecc5a9c009685d8f1c16395", "thumbnail_srcset": "https://si.imgix.net/fbf8b118/uploads/origins/8a0a20a5-bd75-48d2-95dd-54b0a3b87954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5a76e879ecc5a9c009685d8f1c16395, https://si.imgix.net/fbf8b118/uploads/origins/8a0a20a5-bd75-48d2-95dd-54b0a3b87954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=718001ff0006e2ae7f02221d1719c173 2x, https://si.imgix.net/fbf8b118/uploads/origins/8a0a20a5-bd75-48d2-95dd-54b0a3b87954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3570eb56a6092a9ec657ecbd7a12391 3x", "genre": "art", "nsfw": false, "body": "大ファンです！\n是非何か依頼させて頂きたいと思い、\n我が最最推しVtuberの「透乃おと」さんを描いて頂きたく。\n透明感がありクールでありながら癒しのオーラを撒き散らしつつ斬れ味鋭いツッコミも出きる機械仕掛けの女の子です。\n\n上着なしverでお願いします。\nアイコンなどに使用させていただくかもしれません。\n(上着なしver三面図)\nhttps://x.com/toonooto/status/1803188187147411499\n\nその他構図などはおまかせしたいと思いま\nすが、神聖な感じで歌っている図だと助かります。\n(その他参考)\nhttps://youtube.com/@toonooto\nhttps://x.com/toonooto/status/1799743247993962708", "created_at": "", "completed_at": ""}, {"path": "/@okamura3220/works/2", "thumbnail_src": "https://si.imgix.net/59896f06/uploads/origins/d9711637-58f8-4ab3-8c05-371ab973cd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f20e6081852e37c4e088d47d434be06a", "thumbnail_srcset": "https://si.imgix.net/59896f06/uploads/origins/d9711637-58f8-4ab3-8c05-371ab973cd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f20e6081852e37c4e088d47d434be06a, https://si.imgix.net/59896f06/uploads/origins/d9711637-58f8-4ab3-8c05-371ab973cd01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce73743b9582534b394d5a29803d7216 2x, https://si.imgix.net/59896f06/uploads/origins/d9711637-58f8-4ab3-8c05-371ab973cd01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8b89e12ecc55528e698f29de7a32a5f 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nいつも漫画楽しみに読ませてもらっています。\n依頼したいものは、私がVRCHATというゲームで使用しているアバターを描いていただきたいです。\n眼鏡を掛けていて緑の目に小さなグルグルが入っているのが特徴のお姉さんで、泣きぼくろが有り黒い髪を肩あたりで纏めています。\n微笑みながらこちらに軽く片手を振っている絵だと嬉しいです。（なにかピンとくる構図やポーズが有ればそちらでお願いします。）\n資料用の画像がGoogleドライブにありますのでご覧ください。\n分かりづらい部分や描きにくい部分はどんどんアレンジや省略をしてください。\n個人的な鑑賞及びSNSでのアイコン画像として使用するつもりです。\nそれが大丈夫ならどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1L-UWxHDjQXjApB-_Qe4Teef5XF_d8HXb?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@okamura3220/works/1", "thumbnail_src": "https://si.imgix.net/226e75d1/uploads/origins/2b348ccf-19c7-4acd-92b9-f508c32bcb59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ff5c54e8ae586d41aa761170e19b6f", "thumbnail_srcset": "https://si.imgix.net/226e75d1/uploads/origins/2b348ccf-19c7-4acd-92b9-f508c32bcb59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ff5c54e8ae586d41aa761170e19b6f, https://si.imgix.net/226e75d1/uploads/origins/2b348ccf-19c7-4acd-92b9-f508c32bcb59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d3773bb9637443ee7652887c3ea3bf4 2x, https://si.imgix.net/226e75d1/uploads/origins/2b348ccf-19c7-4acd-92b9-f508c32bcb59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=747894fefebd20ecdd80eef1160fdf91 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n二次創作のリクエストが可能ならば、派生ボーカロイドキャラの弱音ハクがホラーな目に遭ったり何かを見つけて驚き涙目になっているところを描いていただけないでしょうか。\nよろしくお願いします。\n\nhttps://dic.pixiv.net/a/%E5%BC%B1%E9%9F%B3%E3%83%8F%E3%82%AF", "created_at": "", "completed_at": ""}]}