ins/4222b3f6-bee9-4747-bb1b-87578b6af529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=843558692793034c1973f55ae380b034", "thumbnail_srcset": "https://si.imgix.net/cb980ed2/uploads/origins/4222b3f6-bee9-4747-bb1b-87578b6af529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=843558692793034c1973f55ae380b034, https://si.imgix.net/cb980ed2/uploads/origins/4222b3f6-bee9-4747-bb1b-87578b6af529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7033316220bef05c9d021a1064172f45 2x, https://si.imgix.net/cb980ed2/uploads/origins/4222b3f6-bee9-4747-bb1b-87578b6af529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1431495fa5c90b0f1eddff2508021a00 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のゲーム作品である「今も昔も恋している」の翔(かける)と莉桜(りお)をお願いします！\n翔はクールなのに莉桜を溺愛する義兄で、莉桜は素直で勉強も家事も得意なできた義妹です。\nシチュエーションはお任せします。\n翔の瞳の色は青、莉桜は緑です。\n\n資料→https://x.com/sousakusaki/status/2032631742763512094", "created_at": "", "completed_at": ""}, {"path": "/@misonikomi01/works/540", "thumbnail_src": "https://si.imgix.net/cd8aa231/uploads/origins/c14cef8b-538c-4b41-95e3-d94f4a1dab70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdf86f6e2950a583e89aced2ae88cc3e", "thumbnail_srcset": "https://si.imgix.net/cd8aa231/uploads/origins/c14cef8b-538c-4b41-95e3-d94f4a1dab70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdf86f6e2950a583e89aced2ae88cc3e, https://si.imgix.net/cd8aa231/uploads/origins/c14cef8b-538c-4b41-95e3-d94f4a1dab70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc9e0078ce8453afe246eb802f1831d1 2x, https://si.imgix.net/cd8aa231/uploads/origins/c14cef8b-538c-4b41-95e3-d94f4a1dab70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69c2a8a97c9ac1cd6c86442813b1eedb 3x", "genre": "art", "nsfw": false, "body": "『どうせ僕らはインモラル』の仲村さんとメルくんのプロフィールお願いします。", "created_at": "", "completed_at": 