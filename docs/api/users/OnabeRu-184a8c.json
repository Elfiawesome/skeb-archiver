x=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d2712015ed21581af5d263cb3b8eb6e", "thumbnail_srcset": "https://si.imgix.net/78e9c582/uploads/origins/74b45a86-9e46-4c2c-b206-97c17e2fa148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d2712015ed21581af5d263cb3b8eb6e, https://si.imgix.net/78e9c582/uploads/origins/74b45a86-9e46-4c2c-b206-97c17e2fa148?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e548dd3b5043ad8f534cc1410cf7f7c1 2x, https://si.imgix.net/78e9c582/uploads/origins/74b45a86-9e46-4c2c-b206-97c17e2fa148?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81a2bf91ba06acfff5830bab6e157f7d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/39", "thumbnail_src": "https://si.imgix.net/4706b05f/uploads/origins/e9c65ad4-5fa6-40d3-a043-8cf492d2d8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f8a2f6dd82d50da5381faf918b59b55", "thumbnail_srcset": "https://si.imgix.net/4706b05f/uploads/origins/e9c65ad4-5fa6-40d3-a043-8cf492d2d8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f8a2f6dd82d50da5381faf918b59b55, https://si.imgix.net/4706b05f/uploads/origins/e9c65ad4-5fa6-40d3-a043-8cf492d2d8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4301a6c3fb4b9d7ecc78850bb3888a3f 2x, https://si.imgix.net/4706b05f/uploads/origins/e9c65ad4-5fa6-40d3-a043-8cf492d2d8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ea8947e88b6daeef68f38252bd6dd46 3x", "genre": "art", "nsfw": true, "body": "手数料無料なのでリクエストさせていただきます\n\nキャラ　ジュリエット（グランブルーファンタジー）\n\nシチュ　彼女の国に恨みを持つテロリストに馬車が爆破されるテロに遭い、ほとんどバラバラで瀕死な所を復活薬・エリクシールで四肢切断状態で蘇生・誘拐監禁され、地下牢で全裸で意識を取り戻すが、性欲を暴走させる淫紋が刻まれ四肢がないので自慰することもできず油汗と愛液を撒き散らしながら悶え苦しんでいるところをお願いします。\n四肢以外も爆破で負った火傷跡と打撲は治りきっておらず全身に広がっている設定です。（傷跡の痛みやかゆみ等でも苦しめられる）\n\nロミオやグラン君のようなヒーロー不在の世界の絶望的なイメージでお願いします。\n\nhttps://gbf-wiki.com/index.php?plugin=attach&refer=img&openfile=3040096000_01_full.png", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/38", "thumbnail_src": "https://si.imgix.net/3f6ce763/uploads/origins/800690a1-66d8-4a19-8e01-87b6ee4427ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491c99c36152d3649d9c09fa96f60240", "thumbnail_srcset": "https://si.imgix.net/3f6ce763/uploads/origins/800690a1-66d8-4a19-8e01-87b6ee4427ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491c99c36152d3649d9c09fa96f60240, https://si.imgix.net/3f6ce763/uploads/origins/800690a1-66d8-4a19-8e01-87b6ee4427ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26b036ce94fd9b633d180f8beda74731 2x, https://si.imgix.net/3f6ce763/uploads/origins/800690a1-66d8-4a19-8e01-87b6ee4427ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09cb150f13a515746cc2c5f70b1e65a7 3x", "genre": "art", "nsfw": true, "body": "作品『ブラック・ブレット』\nキャラクター『布施翠』\nシチュエーション『戦死し、他の少女達の死体と一緒に並べられている』\n姿は全裸\n地面に布を敷いただけの簡易の死体集積場に無造作に置かれている\n表情は虚ろで眼が開いたままで、筋肉が緩み尿漏れが起きている\n欠損なんかの描写はお任せいたします（面倒そうならなしでいいです）\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/37", "thumbnail_src": "https://si.imgix.net/a7d985e1/uploads/origins/db66d95b-1bba-4fc7-aff7-fbb15b0dde09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f2280fd4056b58ce8deae1483a5731f", "thumbnail_srcset": "https://si.imgix.net/a7d985e1/uploads/origins/db66d95b-1bba-4fc7-aff7-fbb15b0dde09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f2280fd4056b58ce8deae1483a5731f, https://si.imgix.net/a7d985e1/uploads/origins/db66d95b-1bba-4fc7-aff7-fbb15b0dde09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b17cad92aa7a1eed57cb92e1fa3c65dc 2x, https://si.imgix.net/a7d985e1/uploads/origins/db66d95b-1bba-4fc7-aff7-fbb15b0dde09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd490fcec8024f118202c298344768cb 3x", "genre": "art", "nsfw": true, "body": "【キャラクター】\n宮下愛(ラブライブ！虹ヶ咲学園スクールアイドル同好会)\n\n【シチュエーション】\n先日リクエストした(https://skeb.jp/@OnabeRu/works/15)作品のIFとして、妊娠した愛さんが首を斬られることなく、無事に出産を終えるまでの過程を希望します。\n\n愛さんは明るい部屋の中、白いシーツの上であお向けになっています。\n服装、胸や臨月のお腹の大きさは過去作と同じくらいを希望します。\n\n以下の感じで出産の過程を希望します。\n①基本形。不安そうな表情。\n②破水。驚き戸惑う。\n③秘部から赤ちゃんの頭頂部が出てくる。陣痛の痛みに葉を食いしばり堪える。目尻には涙。黒くなった乳首から母乳が軽く吹き出る。\n④赤ちゃんの全身が勢いよく出てくる。目を大きく見開き絶叫。母乳が勢いよく吹き出る。\n⑤出産を終え、放心状態。母乳が弱々しく垂れている。お腹が中身の抜けた風船のようにだるんと萎む。秘部がぽっかり開き、へその緒が伸びている。赤ちゃんが泣いている。\n\nリクエストは以上です。\n過去作のIFという形になりますが、問題がなければよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/36", "thumbnail_src": "https://si.imgix.net/83d3ae0c/uploads/origins/45d7607c-2a03-40f8-b087-2c7aae5c0ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31660ae48887bab91e0cc7791af8419b", "thumbnail_srcset": "https://si.imgix.net/83d3ae0c/uploads/origins/45d7607c-2a03-40f8-b087-2c7aae5c0ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31660ae48887bab91e0cc7791af8419b, https://si.imgix.net/83d3ae0c/uploads/origins/45d7607c-2a03-40f8-b087-2c7aae5c0ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daedb7f05d3f47d251e17f0f433b7b9f 2x, https://si.imgix.net/83d3ae0c/uploads/origins/45d7607c-2a03-40f8-b087-2c7aae5c0ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad7b879f412fe83f1eb1b72b4aa922b3 3x", "genre": "art", "nsfw": true, "body": "おなべーる様、お疲れ様です。\nリクエストが再開されたので、以前依頼した\nhttps://skeb.jp/@OnabeRu/works/30\nの追加差分をお願いします。\n\n参照用データは\nhttps://drive.google.com/drive/folders/1n_KZSRNNy_5V-d9HMrrSwr3BpDFsTp06?usp=drive_link\nにアップロードしております。\n\nキャラ：\n倉田ましろ（BanG Dream!）\n\nシチュ：\n前回依頼の2枚目の差分として\n\nカマキリに致命傷を負わされた倉田ましろ（メスのモルフォ蝶の擬人化）が最後の力を振り絞って出産するも、枝の下の食虫植物に我が子を産み落としてしまう。\n（1枚目：蝶ましろ出産.png）\n↓\n産み終わった後、ましろは（我が子の運命を知ることなく）子宮口を垂らしたまま息絶える。\n（2枚目：蝶ましろ絶命.png）\n\nをお願いします。\n\n備考：\n*予算的に厳しいなら1枚目優先でお願いします。\n*あとは前回依頼と同様でお願いします。\n\nhttps://skeb.jp/@OnabeRu/works/30", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/35", "thumbnail_src": "https://si.imgix.net/1ed1e1b4/uploads/origins/de8ae8ae-0fa5-456b-a634-9a316f7ea76a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af520d1070469a2edee523a1f55cc115", "thumbnail_srcset": "https://si.imgix.net/1ed1e1b4/uploads/origins/de8ae8ae-0fa5-456b-a634-9a316f7ea76a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af520d1070469a2edee523a1f55cc115, https://si.imgix.net/1ed1e1b4/uploads/origins/de8ae8ae-0fa5-456b-a634-9a316f7ea76a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91b3024951a409f36ac7d76d85f77db8 2x, https://si.imgix.net/1ed1e1b4/uploads/origins/de8ae8ae-0fa5-456b-a634-9a316f7ea76a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d7337b968bc25ef0a9b077fa5847f12 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品堪能させて頂いております。\n\n今回は\nhttps://skeb.jp/@OnabeRu/works/4\nこちらの状況に持ち込まれる前のシチュエーションとしまして同じコウテイペンギンが強引に拉致される瞬間の画をお願いします。\n\n今回と前回への流れの設定背景としましてはレ〇プされて望まぬ妊娠をしてしまいどうするか悩んで過ごしているうちの妊娠三か月目くらいに妊娠を察した犯人一味に拉致された後に脅迫用に撮影されながら処置されるいうシチュで。\n\n構図としましては風呂上りで尿意を催している時に後ろから男に片手で口を塞がれ驚いた拍子に体に巻いたタオルをハラリと落として前が丸出しになり、それから胸あたりにナイフ突きつけられて恐怖でオシッコを立ったまま勢いよく盛大に漏らして噴き出していくらか、いくらか内腿に伝ったり床からの跳ね返りで足先から内股にまで派手にグッショリ濡らして床に水たまりを作ってしまう状態で。\n妊娠時には子宮が大きくなって膀胱が圧迫されたり刺激されるので、それが尿意の原因（補足説明的で小さな３か月時の胎児入り子宮と尿が溜まった膀胱を透過か余白に断面図で表現して頂けるとありがたいですが無くても結構です）。\n\nコウテイの体型は上記の直前ということでつながりが不自然にならない同じようなので（胸、乳輪は大きめで股間は陰毛あり、ムチムチの大人化風の作風で妊娠初期、２～３か月位でお腹がわずかに出ているのを希望します）、犯人の方はシルエットとか簡略化でＯＫです。\n\nあとオマケのコマが可能でしたら眠らされたまま上記参考過去作品のイチイバル衣装に着せかえされて分娩台に乗せられたばかりでまだ膣拡張器つけられていない真正面アングルの手術直前の状態の１コマもあれば幸いです（無理でしたら無しで）。\n\n\n多い注文すみませんが出来ましたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/34", "thumbnail_src": "https://si.imgix.net/f00b5b14/uploads/origins/0c3080e9-43fe-4276-a872-8f7ceeb67e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e4440993d67df29ca6d04790afe7e1d", "thumbnail_srcset": "https://si.imgix.net/f00b5b14/uploads/origins/0c3080e9-43fe-4276-a872-8f7ceeb67e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e4440993d67df29ca6d04790afe7e1d, https://si.imgix.net/f00b5b14/uploads/origins/0c3080e9-43fe-4276-a872-8f7ceeb67e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e3cc9372215bd80c3a7a84524765400 2x, https://si.imgix.net/f00b5b14/uploads/origins/0c3080e9-43fe-4276-a872-8f7ceeb67e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c9deb08b235375fdb17a67287124ec3 3x", "genre": "art", "nsfw": true, "body": "始めまして、R18Gの作品をリクエストしたいと思います。\n\nキャラクター\n「Diesirae」のマリィ\nシチュエーション\nマリィが強制発情効果の淫紋・着衣不可デバフを掛けられ迷宮の地下深くに召喚され魔王アパオシャ（漆黒の馬）と戦わされ敗北し四肢と舌を切断され繁殖用苗床兼サンドバッグにされている。（その迷宮では死ぬことも狂うこともできないという設定）\nhttps://skeb.jp/@OnabeRu/works/11\nこちらの作品のようなイメージで、全身蹂躙痕と打撲・噛み痕・引きずられた擦り傷等の壮絶な拷問・陵辱後に放置され淫紋が発光し発動、手足がないので自慰も出来ず血と愛液を噴出しながら悶えに苦しんでいるところをお願いします。\n\n裏設定として迷宮作成者は悪の異次元研究者（ブレスオブファイア４のユンナのイメージ）で偶然手に入ったアイオーン（ソシャゲーで予定されていたゲ－ムシステム）の力で神座システムの研究・他世界侵略の戦力造りとダンジョン作成・召喚者の陵辱鑑賞を行い趣味と実益を兼ねているイメージです。\n\n以上をよろしくお願いします。\n【画像資料】\nhttp://www.light.gr.jp/light/products/diesirae_switch/character/chara02.html\nhttps://twitter.com/diesirae_anime/status/964055036408967168\nアニメ版\nhttps://archive.genco.co.jp/diesirae-anime/chara/marie.html\nアパオシャの設定\nhttps://w.atwiki.jp/god14/pages/1530.html", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/33", "thumbnail_src": "https://si.imgix.net/550a9456/uploads/origins/cc8ea8ff-392e-4394-b81b-405d58fc0fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52502f0e67149385524f0d3646e1fce0", "thumbnail_srcset": "https://si.imgix.net/550a9456/uploads/origins/cc8ea8ff-392e-4394-b81b-405d58fc0fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52502f0e67149385524f0d3646e1fce0, https://si.imgix.net/550a9456/uploads/origins/cc8ea8ff-392e-4394-b81b-405d58fc0fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e961a452adb6775cb45b01f23f60dc9 2x, https://si.imgix.net/550a9456/uploads/origins/cc8ea8ff-392e-4394-b81b-405d58fc0fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8c1d5dbcd3d510cef3a08bb6efd8404 3x", "genre": "art", "nsfw": true, "body": "初めまして。ニジエで描かれていたセパレート型磔拷問具に感銘を受けまして是非イラストをお願いしたいです\nキャラクターはインフィニット・ストラトスの更識簪。磔拷問具に取り付けられて膣から入ったディルドが腹を突き破って絶命。顔には涙が流れた跡と吐血している描写。乳房が片方切り落とされていると嬉しいです。\n料金の範囲で可能でしたらディルドが腹を突き破る前の苦痛で泣き叫んでいる差分もお願いしたいです。ご検討よろしくお願いします\nhttps://www.tbs.co.jp/anime/is2/chara/# \nhttps://hokkaido.hs-tamtam.co.jp/product/detail/221564/", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/32", "thumbnail_src": "https://si.imgix.net/87bf0d71/uploads/origins/ff2e44a9-6f70-4e34-9283-e6a3398adf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d9c73d691d88d20311be6a3c2aa749", "thumbnail_srcset": "https://si.imgix.net/87bf0d71/uploads/origins/ff2e44a9-6f70-4e34-9283-e6a3398adf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d9c73d691d88d20311be6a3c2aa749, https://si.imgix.net/87bf0d71/uploads/origins/ff2e44a9-6f70-4e34-9283-e6a3398adf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3acf74ef3d924991c40bf8235b046827 2x, https://si.imgix.net/87bf0d71/uploads/origins/ff2e44a9-6f70-4e34-9283-e6a3398adf6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67430245555af6e2a1ee2252e30f44b8 3x", "genre": "art", "nsfw": true, "body": "・キャラクター：ミスティ(スーパードール★リカちゃん）\n肌は参考画像のように白めでお願いします。\n\n・シチュエーション：妊娠して臨月を迎えたミスティが、陣痛が始まって痛むお腹を前かがみになって押さえているシーン。\nミスティは全身汗だくで、大きく見開かれた目には涙が滲んでいます。\nこちら(https://i.imgur.com/7sbppEl.jpeg)のような感じを希望します。\n\n昔のアニメのキャラのマニアックなシチュエーションになりますが、問題が無ければよろしくお願いします。\n\nhttps://i.imgur.com/Ly1ByJP.png", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/31", "thumbnail_src": "https://si.imgix.net/2b2b97fb/uploads/origins/d5887acf-4214-4781-bee7-16737ef99a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2625fc73175e0dbb5adc5f97336bd2a9", "thumbnail_srcset": "https://si.imgix.net/2b2b97fb/uploads/origins/d5887acf-4214-4781-bee7-16737ef99a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2625fc73175e0dbb5adc5f97336bd2a9, https://si.imgix.net/2b2b97fb/uploads/origins/d5887acf-4214-4781-bee7-16737ef99a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a1cf4d8ac97fa521fa0570603c40e7b 2x, https://si.imgix.net/2b2b97fb/uploads/origins/d5887acf-4214-4781-bee7-16737ef99a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38472cfaff92b0f2b99430e6e6712c06 3x", "genre": "art", "nsfw": true, "body": "おなべる先生、こんにちは！先生のスタイルが大好きで、お願いがあります。\n\nを参照してください。\nhttps://drive.google.com/file/d/1iiWenPz6KDmloi998dJSnEGvW9wuvZt_/view?usp=sharing\n\nキャラクター\nhttps://elwiki.net/w/Asura\n(通常モード)\n\n参考資料の何か違う。\nヒロインは妊娠中ではありません。\n\n何か必要なもの\nを、木製の棒で固定する。\n泣き顔のアヘ顔、参考と同じ。\nゴブリンは全員不要。しかし、誰かが必要です： ナイフを摘んでいる上の人、オナニーをしている人の左右の人。下はゴブリン一匹だけにして、足でアソコを踏んでいるだけでレイプはしない、ゴブリンの足だけ見せてもOK。他は削除してもOKです。\nヒロインがゴブリンに負けるとは思っていないことを想像してください。そして、ゴブリンは性的虐待で怒りを発散しているのです。", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/30", "thumbnail_src": "https://si.imgix.net/b93e6157/uploads/origins/27b882b7-f9d7-45f2-b3f9-48cb4c1b97db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bfa403b28c1a62060e9ddd036aaa249", "thumbnail_srcset": "https://si.imgix.net/b93e6157/uploads/origins/27b882b7-f9d7-45f2-b3f9-48cb4c1b97db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bfa403b28c1a62060e9ddd036aaa249, https://si.imgix.net/b93e6157/uploads/origins/27b882b7-f9d7-45f2-b3f9-48cb4c1b97db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e901f0c7ddaa953c2c96f2e19ed91e1c 2x, https://si.imgix.net/b93e6157/uploads/origins/27b882b7-f9d7-45f2-b3f9-48cb4c1b97db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bcfae2ef8cb02a9a7200e0a66b19c12 3x", "genre": "art", "nsfw": true, "body": "おなべーる様、初めまして\n初リクエストお願いします。\n別構図の連作になりますので、2回分の値段となります。\n\n参照用データは\nhttps://imgur.com/a/FJQgTFx\nにアップロードしております\n\nキャラ：\n倉田ましろ（BanG Dream!）\n\nシチュ：\nバンドの練習場になってるアトリエの庭。\nそこでも様々な生命が生存競争を繰り広げていた。\n無論、繁殖行為も例外ではない。\n\nしかし、捕食者に捕まり貪られるメスの昆虫の前に同族のオスが現れ、生殖本能のままに交尾し、運命を共にする。\n結局、遺伝子を繋ぐどころか、逆に絶やしてしまう…\n知恵のある生き物ならまだしも、昆虫に「運命の王子様に救われるお姫様」な展開など、期待するだけ無意味である…\n\nそれを見た倉田ましろは、こんな妄想をしていた…\n\n（1枚目）\n蜘蛛の糸に引っ掛かり、頭を喰われても尚蠢くオスの蝶を見つけたましろ（メスのモルフォ蝶の擬人化）。\n生殖本能のままにオス蝶に跨がり、性器を繋げ、断末魔の如き吐き出される精を貪るように交尾を始める。\n\nしかし、交尾に夢中になり過ぎたのか、気づいたときにはカマキリの鎌に身体を拘束され、牙が眼前に近づいていた…\n\n（2枚目）\n辛うじてカマキリから逃げ出せたましろ。\n\n全身はカマキリの鎌と牙で刻まれ、右目は潰され、右腕はぶら下がるだけの無用の長物に、美しかった羽は無惨に引き裂かれていた。\nしかし、その代償として胎内には新たな生命が宿っていた…\n\n自分の最期を悟ったましろは、どうにか見つけた枝に腰掛けると、最後の力を振り絞り、仔を産み始める。\nそして産み終わると同時に、ましろは（子宮口を露出させたまま）息絶えた…\n\nが、彼女は知らなかった…枝の下に食虫植物があったのだ。\n二匹の哀れな蝶が繋ごうとした生命は、その中で産声を上げる事なく溶かされた…\n\n余談だが、その妄想をメンバーに話したところ、最大限にドン引きされたのは言うまでもなかった…\n\n備考：\n＊前述の通り2回分の料金設定ですが、可能なら差分は1枚目は2枚、2枚目は4枚お願いします。\n　無理なら、上記資料の「構図案：1枚目-2」「構図案：2枚目-2a/2bの好きな方」でお願いします。\n＊表情や背景は資料から適当にアレンジしても構いません。\n　また、涙・よだれ・（2枚目のみ）母乳・羊水を垂れ流すよう願います。\n\nhttps://imgur.com/a/FJQgTFx", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/29", "thumbnail_src": "https://si.imgix.net/ff498029/uploads/origins/5a6f588a-4e31-47c2-aad1-e7cb0705be2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dd1d71f6fb975e04c2ca2dfc1b21672", "thumbnail_srcset": "https://si.imgix.net/ff498029/uploads/origins/5a6f588a-4e31-47c2-aad1-e7cb0705be2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dd1d71f6fb975e04c2ca2dfc1b21672, https://si.imgix.net/ff498029/uploads/origins/5a6f588a-4e31-47c2-aad1-e7cb0705be2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9b24c9fc055a8ee35e8fd29d7137931 2x, https://si.imgix.net/ff498029/uploads/origins/5a6f588a-4e31-47c2-aad1-e7cb0705be2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e56546913c536b726b3721bfec0a11c 3x", "genre": "art", "nsfw": true, "body": "日頃作品楽しませていただいております。\n\n「艦これ」シリーズ浜風乙改が臨月になった出産直前の状態で恥ずかしいコスプレ状態でプロレス技のロメロスペシャル（釣り天井固め）をかけられて破水する画をリクエストさせていただきます。\n\nシチュエーション、構図はこれみたいに\nhttps://skeb.jp/@OnabeRu/works/8\n闇の闘技に恥ずかしいコスプレで強制参加させられて\n・試合前、入場時で恥ずかしい格好での羞恥と恐怖で前を手で隠しながらの立ち絵。\n・メインの敗北のロメロスペシャル場面。\nの構成を希望しますが料金、手間に見合わなければ入場時はカットでＯＫです。\n\n浜風乙改は３５歳ぐらいの熟女人妻化して程よく肉が付いている状態で、かつ臨月の状態に合わせた乳房の膨らみ、乳首、性器の色で陰毛アリ身体的特徴でお願いします。\n\n衣装は「ひみつ戦隊メタモルＶ」のメタモルブラック衣装で\nhttps://f.hatena.ne.jp/mattsun01/20220815224613\n髪は元の浜風のままで、ハミ肉やハミ乳輪したり臨月のお腹にあわせて股間のレオタードだけ無しで腰回りのベルトもずらしたり伸びきったイメージで。\n\nただロメロスペシャル受けてるときは体中のベルトが膨らんだお腹と技の体勢で限界迎えてちぎれて完全に胴体の衣装が脱げ落ちて（帽子や手足の衣装はそのまま着用）丸裸になって乳房や股間が開脚気味で手足で隠すことできないのを希望します。\n激しい運動と技で産気づいた瞬間ということで破水表現だけでまだ赤子は出てきてない状態で、表情は技の羞恥苦痛と陣痛が始まったのと合いそうなの（歯を食いしばって目をぎゅっとつぶるか、眼を見開いて叫ぶかで、眼を開くなら黒目、瞳は大きい方が好みです）をお任せします。\n\n技をかける攻め役はモブ的な簡略化で構いません。\n\n\n\n長文すみませんが検討して頂けましたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/28", "thumbnail_src": "https://si.imgix.net/3e0b4d4c/uploads/origins/58aeb182-8499-4bd7-b645-b9e11c1676db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7d1fc30f769fffdf9d621978127c6f", "thumbnail_srcset": "https://si.imgix.net/3e0b4d4c/uploads/origins/58aeb182-8499-4bd7-b645-b9e11c1676db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7d1fc30f769fffdf9d621978127c6f, https://si.imgix.net/3e0b4d4c/uploads/origins/58aeb182-8499-4bd7-b645-b9e11c1676db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dac38b68b57708c858e569af82e149dd 2x, https://si.imgix.net/3e0b4d4c/uploads/origins/58aeb182-8499-4bd7-b645-b9e11c1676db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdfa4addfc73f91952b1d70165385684 3x", "genre": "art", "nsfw": true, "body": "先生、こんにちは。\n\n遊女戦記のメアリー・スーの作品をまたお願いしたいです。\n\nこの作品は1作目の前に設定されているはずです。(前日譚)\n\nメアリーの制服が引き裂かれ、アソコと片方のオッパイと腕が自由になっています。\n\n帝国軍兵士は彼女に強い媚薬を飲ませ、レイプし始める。\n\n可能であれば、いくつかの相違点があれば最高です。\n\n一人目のメアリーは怒った顔をしていて、嫌悪感を抱いています。\n二人目のメアリーは怖がるが、薬のせいでだんだん心が麻痺してくる。\n最終的にはレイプされるのを楽しんでいる。\n\n前回同様、暗くて残酷な描写を自由にしてください。\n精液や小便、糞もいいですね。\nまた、メアリーの指や手足が折れていたら最高です。\n\nリクエスト読んでくれてありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@OnabeRu/works/27", "thumbnail_src": "https://si.imgix.net/0139ccca/uploads/origins/098aac7a-f574-4ecc-9306-07c8764bfae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbb6b55f05005d6265f4f0297d5ad0ee", "thumbnail_srcset": "https://si.imgix.net/0139ccca/uploads/origins/098aac7a-f574-4ecc-9306-07c8764bfae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbb6b55f05005d6265f4f0297d5ad0ee, https://si.imgix.net/0139ccca/uploads/origins/098aac7a-f574-4ecc-9306-07c8764bfae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a697057e978b16af0c9d47c19f8412 2x, https://si.imgix.net/0139ccca/uploads/origins/098aac7a-f574-4ecc-9306-07c8764bfae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad8eee13e046fa30733564e743d75f98 3x", "genre": "art", "nsfw": true, "body": "ロリキャラのリクエストをしても大丈夫でしょうか\n逃げ上手の若君の雫をお願いします\n\n・四肢切断されて額縁に飾られている\n・額縁の四隅から伸びる鎖についたフックで四肢の末端を貫かれた形で固定されている\n・アナルには一升瓶ほどのバイブを挿入され括約筋が切れて血が滴っている\n・膣は限界まで拡張され、広げられた状態で中身が丸見え\n・舌、乳首、クリトリスにはピアスが取り付けられていて引きちぎれんばかりに引っ張られている\n・切断された四肢は関節で折られいくつかの指が切断され爪が剥がされた状態で周りに吊り下げてある\n・胸の膨らみはなくぺったんこ\n・可能なら苦痛に歪んだ表情と放心状態の差分をお願いします\n\n以上になりますが検討よろしくお願いします", "created_at": "", "completed_at": ""}]}