a37cdf5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1159b995317c19ccaf0b349b883d7987, https://si.imgix.net/ae08ceb8/uploads/origins/76827dfe-8fb2-43ec-8923-1d1a37cdf5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0ceeb0704f0fafe02779efefa58f91e 2x, https://si.imgix.net/ae08ceb8/uploads/origins/76827dfe-8fb2-43ec-8923-1d1a37cdf5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad783c723681e2c25b280ca4cd2a9b1d 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回依頼をさせてもらいます！\n\n\n◆【キャラクター】\n　ファイアーエムブレム 烈火の剣に登場するリンをリクエストさせてもらいます。\n　https://drive.google.com/file/d/1uL9mRoea7Bn4Clk6jmDqjJz7WNbUb68m/view?usp=sharing\n\n◆【シチュエーション】\n　山賊たちに敗北し凌辱されてすっかり快楽堕ちしてしまったリン。\n　チンコ大好きになったリンは街の風俗店に売り飛ばされてラッキーホールで稼ぐことになる…というシチュエーションでお願いします。\n　(リンの容姿的に本来はもっといい娼館に売れそうだが完全にチンコ狂いになってしまいラッキーホールぐらいでしか働けないというイメージです)\n　また今回2枚組の作品でリクエストさせてもらいます。\n　\n\n◆【体位や構図】\n　こちらのとてちてたさんの過去作品のような感じでお願いします。\n　https://skeb.jp/@totetiteta/works/30\n　①1枚目でラッキーホールから突き出されたチンコを咥えながらオナニーしているリンをお願いします。\n　②2枚目でラッキーホールから突き出されたチンコに自分から立ちバックで挿入して腰を振っているリンをお願いします。\n　③世界観的にラッキーホールに写真などは無しでお願いします。\n　④お金は紙のお金ではなく金貨でお願いします。\n\n◆【表情】\n　完全に快楽堕ちしており気持ちよさそうにチンコに奉仕しているという風にお願いします。\n\n◆【服装】\n　i衣装あり版と全裸版差分をお願いします。\n\n◆【擬音や台詞】\n　上記の過去作品のようにエッチな擬音をお願いします。\n\n\n長々となりましたがどうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@totetiteta/works/39", "thumbnail_src": "https://si.imgix.net/cdd6ed74/uploads/origins/a5e501ad-597d-4769-8302-f650ff1de76b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1605f9ba7f2adb010c574511e32d15", "thumbnail_srcset": "https://si.imgix.net/cdd6ed74/uploads/origins/a5e501ad-597d-4769-8302-f650ff1de76b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1605f9ba7f2adb010c574511e32d15, https://si.imgix.net/cdd6ed74/uploads/origins/a5e501ad-597d-4769-8302-f650ff1de76b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4306c38