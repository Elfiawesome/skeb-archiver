b57-448c-bba9-be8b437e5ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe754c045f72baaf274754154317eb8", "thumbnail_srcset": "https://si.imgix.net/0af6a757/uploads/origins/7f8edfa7-6b57-448c-bba9-be8b437e5ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe754c045f72baaf274754154317eb8, https://si.imgix.net/0af6a757/uploads/origins/7f8edfa7-6b57-448c-bba9-be8b437e5ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=666d476360023f83bd8b5b1da2cbf6f3 2x, https://si.imgix.net/0af6a757/uploads/origins/7f8edfa7-6b57-448c-bba9-be8b437e5ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7eb6eee45e522790ca409214b896fa79 3x", "genre": "art", "nsfw": false, "body": "こんにちは！こんにちは夏ミクの絵、かわいいですね！私の女の子に夏の浴衣を着せてください。彼女は盲目で、目は乳白色の灰色です。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1cTxLXMe00KF57Z0uM2VKNChm0dP1XaN7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@noah_ark38/works/27", "thumbnail_src": "https://si.imgix.net/51389360/uploads/origins/74c13721-ccd3-419f-aabf-1ee189fa3f43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a350b4fd0c43604db91ba584b0880197", "thumbnail_srcset": "https://si.imgix.net/51389360/uploads/origins/74c13721-ccd3-419f-aabf-1ee189fa3f43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a350b4fd0c43604db91ba584b0880197, https://si.imgix.net/51389360/uploads/origins/74c13721-ccd3-419f-aabf-1ee189fa3f43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=056b8016e016d7a046216f2220cab4e5 2x, https://si.imgix.net/51389360/uploads/origins/74c13721-ccd3-419f-aabf-1ee189fa3f43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4b280e6c7372a21aa3f907e41be6505 3x", "genre": "art", "nsfw": true, "body": "前回は初音ミクのイラストを描いていただきありがとうございました。\n再度「初音ミク」のNSFWイラストをリクエストします。\n\n◆概要\nヌードでポーズをとる初音ミクのイラストをお願いします。\n格好は服や下着を着ていない裸の状態（ヘッドホン等アクセサリの有無は任意） 。\n\n◆イメージ\n顔の横に、「いいね」の手を逆さにした手でハートをつくるポーズをしています。\n楽曲MV「ダイダイダイダイダイキライ - 初音ミク VS 重音テト」のサビ（\"大体 アナタのコト アタシ\nダイダイダイダイダイキライ\"）の振付のイメージでお願いします。\n悪い、いじわるな感じの笑みを浮かべています。\n\n◆その他\n胸やおへそが手などオブジェクトで隠れないようにお願いします。\n\n（参考画像・楽曲MV「ダイダイダイダイダイキライ - 初音ミク VS 重音テト」）\n\nhttps://imgur.com/a/MXqJFxx", "created_at": "", "completed_at": ""}, {"path": "/@noah_ark38/works/26", "thumbnail_src": "https://si.imgix.net/0351f1f4/uploads/origins/42c376be-744b-46f4-a2d3-739edb2c2319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6519bb2b231a62e2ce66573b5b2d32b", "thumbnail_srcset": "https://si.imgix.net/0351f1f4/uploads/origins/42c376be-744b-46f4-a2d3-739edb2c2319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6519bb2b231a62e2ce66573b5b2d32b, https://si.imgix.net/0351f1f4/uploads/origins/42c376be-744b-46f4-a2d3-739edb2c2319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6be7adc6fdb7d3cb4908bdfd0077254 2x, https://si.imgix.net/0351f1f4/uploads/origins/42c376be-744b-46f4-a2d3-739edb2c2319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4f340a32a0d6c4ad3886af5636ec774 3x", "genre": "art", "nsfw": false, "body": "はじめましてるなさん。イラスト１枚を頼みたいと思います。\n\n【キャラクター】\n・室笠アカネ（ブルアカ）\n\n【服装】\n・制服\n\n【シチュエーション】\n・通学路を歩き、スマホを見つめながらヘッドホンを付けていて音楽を聴いている\n\n【構図】\n・アカネの正面\n\n【ポーズ】\n・夢中で歩きスマホをしていて顔がちょっと下がっている\n\n【その他】\n・ヘッドホンは色々種類があるので参考資料内容は人気モデルを添付しました。その姿を使うか、またはミレニアムモチーフでもよいです\n・できれば横髪を分けて耳のちょうど上にヘッドホンのハウジングがきている構図 \n・もしおまけを描いて頂けるなら先生に気づいて、少し顔を伏せてヘッドホンを首に掛けなおし（髪の上からヘッドホンを首に掛けた状態で）、先生に優しく挨拶をする\n\n以上よろしくお願いします。\n\nhttps://imgur.com/a/bNPbnAj", "created_at": "", "completed_at": ""}, {"path": "/@noah_ark38/works/25", "thumbnail_src": "https://si.imgix.net/4bbe4e53/uploads/origins/fe60d654-050b-4bbf-9f92-0d25fe8b107c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae8ebf6ad619986440dea134669e33b9", "thumbnail_srcset": "https://si.imgix.net/4bbe4e53/uploads/origins/fe60d654-050b-4bbf-9f92-0d25fe8b107c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae8ebf6ad619986440dea134669e33b9, https://si.imgix.net/4bbe4e53/uploads/origins/fe60d654-050b-4bbf-9f92-0d25fe8b107c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeeec0c7ca7504b36055e7c094df0839 2x, https://si.imgix.net/4bbe4e53/uploads/origins/fe60d654-050b-4bbf-9f92-0d25fe8b107c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97abeb5727144ffcf8c351740b412796 3x", "genre": "art", "nsfw": false, "body": "初音ミクのマジカルミライ2020夏まつりちゃんのイラストをお願いしたいです！\nそのイラスト内にその夏まつりちゃんのふわふわぬいぐるみ持ってるようなイラストが理想です！\nあとの構図は完全おまかせでお願いします！\n背景も簡単にお願いしたいです！", "created_at": "", "completed_at": ""}, {"path": "/@noah_ark38/works/24", "thumbnail_src": "https://si.imgix.net/fc5c9023/uploads/origins/14f32cd1-4b19-491d-b32a-e272cce30891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9b221fd95111c6da85bfa850cfd266b", "thumbnail_srcset": "https://si.imgix.net/fc5c9023/uploads/origins/14f32cd1-4b19-491d-b32a-e272cce30891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9b221fd95111c6da85bfa850cfd266b, https://si.imgix.net/fc5c9023/uploads/origins/14f32cd1-4b19-491d-b32a-e272cce30891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29c4411cb4bae441ee6ee85e08f98b27 2x, https://si.imgix.net/fc5c9023/uploads/origins/14f32cd1-4b19-491d-b32a-e272cce30891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6546781ca12a3f64fe50e4621792abbe 3x", "genre": "art", "nsfw": false, "body": "いつも投稿楽しみにしてます。\nおはようミクさんの絵柄でHEROちゃんを描いて頂きたいです。\n凄く元気いっぱいな感じだと嬉しいです。よろしくお願いします。(背景とかに関して特に指定はございません)\nPCの壁紙用に使いたいと思っており出来ればカラーでお願いしたいです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@noah_ark38/works/23", "thumbnail_src": "https://si.imgix.net/2bd7d19e/uploads/origins/1dee3803-6077-4e18-92af-8dd832bcb9ea?bg=%23fff&auto=format%2Ccompress&fm=we