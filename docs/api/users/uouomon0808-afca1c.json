ix.net/9c3de6e1/uploads/origins/0c3d3e48-ed4d-486d-9146-821dce2ddcb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=556b27abd4154fbe47d1bf17e952a3e5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@uouomon0808/works/10", "thumbnail_src": "https://si.imgix.net/56b9a742/uploads/origins/9c0cfce8-3071-4064-ad2c-ebd29a620d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f778a8fca70389e903bdb76554fd05fa", "thumbnail_srcset": "https://si.imgix.net/56b9a742/uploads/origins/9c0cfce8-3071-4064-ad2c-ebd29a620d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f778a8fca70389e903bdb76554fd05fa, https://si.imgix.net/56b9a742/uploads/origins/9c0cfce8-3071-4064-ad2c-ebd29a620d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b60bc9c29d7a9c12c23b8b4023a45dee 2x, https://si.imgix.net/56b9a742/uploads/origins/9c0cfce8-3071-4064-ad2c-ebd29a620d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3661db6a7017598d3329b2e6b1bcc38d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、魚月さんご先生のイラストが大好きでいつも癒されています。\n\n以前描かれていたアロナちゃんとプラナちゃんのデフォルメイラストが特に素敵だったので、今回は同じような感じで僕の理想のキャラクターのイラストをお願いしたいと思いました。\n\n以下、依頼の詳細です。\n\n【キャラクターの要素】\nナチュラルで派手じゃない自然な色合いの明るくて淡い髪色を希望します。\n優しくて癒されるようなゆるふわな性格を持ちながら、中には芯のある一面もある、そんなキャラクターの表現をお願いします。\n\n【参考キャラクター】 以下のキャラクターを参考にしていただければと思います。\n\n参考キャラクター1: [櫻木真乃]（[アイドルマスターシャイニーカラーズ])\n参考キャラクター2: [ヒシミラクル]（ウマ娘）\n参考キャラクター3:[紬ヴェンダース]（Summer Pockets）\n【利用予定】 このイラストは、SNS等のアイコンとして使用する予定です。自分自身を表現するためのイメージとして活用したいと考えています。\n\n内容が合わなければキャンセルしていただいて大丈夫です。 お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@uouomon0808/works/9", "thumbnail_src": "https://si.imgix.net/34ce5640/uploads/origins/1ed9d0e6-d110-424c-9106-7a8ad058e154?bg=%23fff&auto=format%2Ccompress&fm=webp&