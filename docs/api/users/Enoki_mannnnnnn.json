2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06ed1eef710b229d520fb6bbd0603c0", "thumbnail_srcset": "https://si.imgix.net/3af6ede1/uploads/origins/e07e028b-f416-4612-a98f-1677f68b9006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06ed1eef710b229d520fb6bbd0603c0, https://si.imgix.net/3af6ede1/uploads/origins/e07e028b-f416-4612-a98f-1677f68b9006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f003db7311f4d76b6f3b633e5ae24fc1 2x, https://si.imgix.net/3af6ede1/uploads/origins/e07e028b-f416-4612-a98f-1677f68b9006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f229b871dff4f77dd21f2e0e684d5694 3x", "genre": "art", "nsfw": true, "body": "OCのユキにこのクリスマス衣装を着てほしい https://www.amazon.com/Christmas-Camisole-Dresses-Snowflake-Cocktail/dp/B0DLGM3P4S?th=1&psc=1 でも、https://www.pixiv.net/en/artworks/103134112 このようにもっと胸の谷間を見せてほしい。あと、背景はクリスマス仕様で、オーナメントやクリスマスツリー、プレゼントなど。表情やポーズはお任せします。あと、僕のOCのユキもカウガールの尻尾を持っていることを忘れないでね。あと、君が僕の依頼を受けているのは知っているんだけど、Skebが今OCボーナスを出していて、OCの依頼を受けるとアーティストにボーナスが入るらしいから、また君に依頼することにしたんだ。すみません、キャンセルしてしまいました。肩のないドレスにしたいので、肩にストラップはつけないでください。あと、できればヌードもお願いします。\n\n参考文献参考文献私のOCユキ: https://x.com/Skirby200/status/1845554959581950141\nhttps://x.com/Skirby200/status/1886197791091040361", "created_at": "", "completed_at": ""}, {"path": "/@Enoki_mannnnnnn/works/57", "thumbnail_src": "https://si.imgix.net/d2d4d73f/uploads/origins/62b3e06d-33d8-4bc5-8aec-007467f27486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66a64be40073669f92c37cafc69fd0c6", "thumbnail_srcset": "https://si.imgix.net/d2d4d73f/uploads/origins/62b3e06d-33d8-4bc5-8aec-007467f27486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66a64be40073669f92c37cafc69fd0c6, https://si.imgix.net/d2d4d73f/uploads/origins/62b3e06d-33d8-4bc5-8aec-007467f27486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa598eaf8eb08a897bc0522e488e7637 2x, https://si.imgix.net/d2d4d73f/uploads/origins/62b3e06d-33d8-4bc5-8aec-007467f27486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c79c391474ba552750da1865e0677a4d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Enoki_mannnnnnn/works/56", "thumbnail_src": "https://si.imgix.net/8a1c6c6b/uploads/origins/5998ac0a-897d-412b-b856-773bf550a936?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab54c0019831cdc0a5e8a9c29760f434", "thumbnail_srcset": "https://si.imgix.net/8a1c6c6b/uploads/origins/5998ac0a-897d-412b-b856-773bf550a936?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab54c0019831cdc0a5e8a9c29760f434, https://si.imgix.net/8a1c6c6b/uploads/origins/5998ac0a-897d-412b-b856-773bf550a936?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce4f54f1770d075ee587f3d126b68545 2x, https://si.imgix.net/8a1c6c6b/uploads/origins/5998ac0a-897d-412b-b856-773bf550a936?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9d03b222c0d071df66ebf8c704297e0 3x", "genre": "art", "nsfw": true, "body": "私のOC、Azur laneのBrestとIsekai MaouのShera L Greenwoodにそれぞれマイクロビキニを着て、私のOCが持っているのはElves、Brestが持っているのはare、Sheraが持っているのはLewdというサインを掲げて欲しいです。この看板は、以前あなたが作ってくれた https://skeb.jp/@Enoki_mannnnn/works/44 のように半透明にしてほしいです。メイン作品では、乳首や乳輪、アソコの部分は見えないようにしてほしいのですが、バリアント作品ではヌードにして、全部見えるようにしてほしいです。マイクロビキニのボトムは見えるけど、実際のヴァギナは見えないみたいな。ヴァリアント用に言ったように、乳首、乳輪、ヴァギナが見えるようにしてほしい。また、背景をビーチにしてもらえるとありがたいです。\n\n参考文献\n私のOCユキ: https://x.com/Skirby200/status/1845554959581950141\n\n私のOCに少なくとも似たようなビキニを着てほしいマイクロビキニ : https://www.pixiv.net/en/artworks/97189585\n肩にあるものはこのアートワークにはないようにしてほしい。また、このカウガールの首にあるものも私のOCにはつけてほしくない。ただ、私のOCがいつも首につけているものはカウベルだ。\n\nBrest: https://twitter.com/azurlane_staff/status/1545966114282213376\n\nブレストに着てほしいマイクロビキニ：https://www.pixiv.net/en/artworks/70445415\nこの作品を見て、ブレストにマイクロビキニを着せたいけど、この作品のようにドイツの国旗の代わりにフランスの国旗をマイクロビキニの色にしたら完璧だと思った。\n\nシェラL・グリーンウッド: https://isekai-maou.fandom.com/wiki/Shera_L._Greenwood?file=Isekai_Maou_Character_elf.PNG\n\nシェラに着て欲しいマイクロビキニ：https://www.pixiv.net/en/artworks/117894959 このアートワークの女の子が着ているものではなく、彼女の色に合ったシンプルなグリーンでいい。\n\nあなたが以前素晴らしい仕事をしてくれたことを受け入れてくれるなら、本当にありがたい。", "created_at": "", "completed_at": ""}, {"path": "/@Enoki_mannnnnnn/works/55", "thumbnail_src": "https://si.imgix.net/ed89f967/uploads/origins/ec201d42-7750-4b2d-8198-07a4388f4f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f45a7d557ff12488847240890727157b", "thumbnail_srcset": "https://si.imgix.net/ed89f967/uploads/origins/ec201d42-7750-4b2d-8198-07a4388f4f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f45a7d557ff12488847240890727157b, https://si.imgix.net/ed89f967/uploads/origins/ec201d42-7750-4b2d-8198-07a4388f4f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a54fba7591d383cf4dc8eb6ac02797f 2x, https://si.imgix.net/ed89f967/uploads/origins/ec201d42-7750-4b2d-8198-07a4388f4f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0df960eb9a7145cccd3e8c2952d57bd 3x", "genre": "art", "nsfw": false, "body": "エノキ、久しぶりだね！お元気でしたか？また僕と相方のOCを描いていただけたらと思います！\n\nゲーム「百戦錬磨の最終防衛学園」のクラスアーマーで描いてください。黒いユニフォームに白いハイライト、ハートの上に白いエネルギー、そして二人とも赤いアイシャドウをお願いします。\n\nヒドゥンは、リファレンス・フォルダにある赤毛のキャラクターと同じ服を着ているはずですが、彼の帽子も服の色に合わせてください。白い帽子に赤い目の黒いクジラ。\n\nミミは青い髪のキャラクターと同じような服装だが、足には黒いタイツを履き、スカートは少し裂けていて少し短くなっている。  \n\nヒドゥンは真剣な表情で見る者を睨みつけ、ミミは邪悪な笑みを浮かべているはずだ。2人のポーズはお任せします！\n\n読んでくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1g2Phuy79FICYJ55-TPzfPkhaNeNJuO