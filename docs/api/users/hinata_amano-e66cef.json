{"screen_name": "hinata_amano", "file": "hinata_amano-e66cef", "name": "雨野ひなた＠絵描きVtuber", "avatar_url": "https://pbs.twimg.com/profile_images/1494701680998322177/1wHW6_XN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1117086923565047808/1664017468/1500x500", "description": "オリジナル＆二次創作イラストを投稿しています。YouTubeでも活動中！ご質問やご相談は、下記のメールアドレスで受け付けております。 ✉→amanohinataillust@gmail.com, Skeb：http://skeb.jp/@hinata_amano, Pixiv：http://pixiv.net/use", "total_works": 26, "scraped_works": 26, "first_seen": "2026-03-20T12:06:05.670594+00:00", "last_updated": "2026-03-20T12:06:05.670594+00:00", "price_history": {"art": [{"amount": 20000, "recorded_at": "2026-03-20T12:06:05.670594+00:00"}], "correction": [{"amount": 1000, "recorded_at": "2026-03-20T12:06:05.670594+00:00"}]}, "current_prices": {"art": 20000, "correction": 1000}, "price_range": {"art": {"min": 20000, "max": 20000}, "correction": {"min": 1000, "max": 1000}}, "links": [{"label": "Twitter", "url": "https://x.com/hinata_amano", "name": "hinata_amano"}, {"label": "Website", "url": "http://pixiv.net/use", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/38624961", "name": "38624961"}, {"label": "Fanbox", "url": "https://amanohinata.fanbox.cc", "name": "amanohinata"}, {"label": "YouTube", "url": "https://youtube.com/channel/UCoDrrnCyMgJlOPd7AQGIiSA", "name": "UCoDrrnCyMgJlOPd7AQGIiSA"}], "flags": {}, "acceptable": true, "works": [{"path": "/@hinata_amano/works/26", "thumbnail_src": "https://si.imgix.net/b99650da/uploads/origins/a9398397-e872-459c-b7ba-0a65203b90ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33590e315e464111857b5d4740b6332", "thumbnail_srcset": "https://si.imgix.net/b99650da/uploads/origins/a9398397-e872-459c-b7ba-0a65203b90ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33590e315e464111857b5d4740b6332, https://si.imgix.net/b99650da/uploads/origins/a9398397-e872-459c-b7ba-0a65203b90ac?bg=%23fff&auto=format%2Ccompress&fm=webp&d