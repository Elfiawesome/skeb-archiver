%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=785253deb8a74537188dd5d29f69aa27 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e4333b6b4462294882d7e0cef648dc5 3x", "genre": "voice", "nsfw": false, "body": "こんにちは！いつもお世話になっております、殺虫剤です！\n兎桜さんにこう、「絵がうまいね～ここ好きだよ～」のような感じで絵について何となく褒めて頂けたら嬉しいなと思い、リクエストを送らせていただきます。\n作業が辛かったり心が折れそうなときに聞くので、SNSやその他のサイトへの転載は致しませんのでご安心ください。\nお時間があればで結構ですので、お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Tozakura_Kou/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d29c4d8207619646290f4b8f760c9c5", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d29c4d8207619646290f4b8f760c9c5, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=785253deb8a74537188dd5d29f69aa27 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e4333b6b4462294882d7e0cef648dc5 3x", "genre": "voice", "nsfw": false, "body": "【やる気出すボイス】\nやる気を出したいときに聞きたいのでやることをやらない自分を罵ったのちに最後にやればできるこ的なことを言ってくれる励ます的なボイス（抽象）を是非お願いしたいです！\n作業効率が2億倍とかになるのでよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Tozakura_Kou/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d29c4d8207619646290f4b8f760c9c5", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d29c4d8207619646290f4b8f760c9c5, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=785253deb8a74537188dd5d29f69aa27 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e4333b6b4462294882d7e0cef648dc5 3x", "genre": "voice", "nsfw": false, "body": "数を数えていただきたいです。\n1〜10までの数を「1、2、3…」という風にカウントアップしていただけると助かります。\nもし余裕がありましたら「10、9、8…」という風にカウントダウンもしていただけるとさらに助かります。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tozakura_Kou/works/4", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3fb5b819d7dc712a9cc328217fd252e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3fb5b819d7dc712a9cc328217fd252e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946208914552274945%2FXpNFzwqw.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&