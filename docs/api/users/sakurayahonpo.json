tclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0aef5ba57987b4e1d71515a8645c932, https://si.imgix.net/bda2289d/uploads/origins/bae2758a-70f3-48d6-9943-c888660c88f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=868119b504bbddf18f4a8b2ba72edbab 2x, https://si.imgix.net/bda2289d/uploads/origins/bae2758a-70f3-48d6-9943-c888660c88f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85bfa87adb270092dc05d9b832a83cb4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakurayahonpo/works/10", "thumbnail_src": "https://si.imgix.net/02f0cdad/uploads/origins/73144f7b-5f3e-4e56-bd81-4f5eff10618a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8d2c4da6360033fbc57baceccd98d63", "thumbnail_srcset": "https://si.imgix.net/02f0cdad/uploads/origins/73144f7b-5f3e-4e56-bd81-4f5eff10618a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8d2c4da6360033fbc57baceccd98d63, https://si.imgix.net/02f0cdad/uploads/origins/73144f7b-5f3e-4e56-bd81-4f5eff10618a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98367d57694e7d6de13f558bc5ed22ae 2x, https://si.imgix.net/02f0cdad/uploads/origins/73144f7b-5f3e-4e56-bd81-4f5eff10618a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba5fbab9fe3c386c4fafafabce8f00c2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakurayahonpo/works/9", "thumbnail_src": "https://si.imgix.net/a5a53c01/uploads/origins/96f5d0af-057c-4002-97e6-4f5c6543fcaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1f1582b9729e1450fbc1d0b67785b89", "thumbnail_srcset": "https://si.imgix.net/a5a53c01/uploads/origins/96f5d0af-057c-4002-97e6-4f5c6543fcaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1f1582b9729e1450fbc1d0b67785b89, https://si.imgix.net/a5a53c01/uploads/origins/96f5d0af-057c-4002-97e6-4f5c6543fcaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55918a10e3d4eafaca83eaae781b181a 2x, https://si.imgix.net/a5a53c01/uploads/origins/96f5d0af-057c-4002-97e6-4f5c6543fcaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=423f3b56985ac2f86895e6cad2f59c19 3x", "genre": "art", "nsfw": true, "body": "こんにちは、桜屋さん\nいつも素敵なイラストを楽しく拝見しております。Twitterでお見受けしたオピオーンやハイドール達の表情やハードな内容に大変惹かれてしまったので、リクエストを送らせていただきます。\n\n今回はレジェンズ 甦る竜王伝説から、リンドヴルム(ジャバウォックの分身体 可能であれば複数)×カネルドウィンドラゴンの敗北IF陵辱R-18イラストを依頼させて頂きます。\n\nシチュエーションとしましては、レジェンズウォー開戦後、思いもよらぬネクロム達の反撃によって膠着状態にあるなかカネルドがリンドヴルムに背後から羽交締めにされてしまい敵に囲まれ、相手の四本の腕で腕や翼を封じられ身動きが取れないところへ、仇敵に対する悪意や暴力、歪んだ欲望の限りをその身ひとつに受ける事となる…といった内容で、以下の場面の差分イラストをお願い致します。大まかなリクエストになりますので、細部や枚数の増減つきましては予算に合わせて桜屋さんにお任せしたいと思います。また、リンドヴルムにつきましては部分的な描写で大丈夫です。\n\n①動けぬ状況を良いことに、立ちはだかるもう一体のネクロム(リンドヴルム,もしくはその他大型の敵性レジェンズ)にいたぶられ、ゴーグルもひび割れ、衣装も破れ胸元や腹筋が露わになり、ボロボロの状態になり、息を乱しながらも忌々しげな視線を送るカネルド。\n\n②傷付きながらも未だ屈服する気配を見せないカネルドに対し、ネクロム達が凶器のような肉槍を突き付け、カネルドもまた「自らを獣じみた欲求の捌け口にしようとしている」事に驚きの表情を見せる。\n\n③前後からの挿入。(の二穴責め、もしくは二本挿し) 身体が軋むようなピストンの圧迫感と汚辱感に目元を歪めながらも、抵抗することも出来ず身体を許してしまう。(可能であれば一発出された後のまだ抵抗の意思がある場面もお願いしたいです。)\n\n④時間経過+事後。息も絶え絶えになり、目も虚ろのままぐったりと身を預けるカネルド。身体中は薄黄ばんだ汚らわしい精液に塗れ、散々に弄り、穿り犯された孔からは泡混じりに精液が逆流しており、無惨かつ無様な敗北の姿を晒す…。\n\n過去に「裏 風ノ伝説 弐」で桜屋さんが描かれていたカネルドの捕縛姿やジャバウォックと共に堕ちゆく姿がたまらないほど大好きでしたので、お受けしていただけますと嬉しいです！\n\nhttps://www.dropbox.com/scl/fo/gi06x609ds854ir1jkmfd/AFTPoruvrXnDQfGaN4-z3f8?rlkey=uz19vzliapjwwrzvbuqfwrrqu&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sakurayahonpo/works/8", "thumbnail_src": "https://si.imgix.net/c4358b9a/uploads/origins/d495a929-05f3-400f-ad4d-08c0a094cd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65763cea5dc42cfb49eaea6bab86c31b", "thumbnail_srcset": "https://si.imgix.net/c4358b9a/uploads/origins/d495a929-05f3-400f-ad4d-08c0a094cd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65763cea5dc42cfb49eaea6bab86c31b, https://si.imgix.net/c4358b9a/uploads/origins/d495a929-05f3-400f-ad4d-08c0a094cd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e90397ff8dba22de0db47968eb91dceb 2x, https://si.imgix.net/c4358b9a/uploads/origins/d495a929-05f3-400f-ad4d-08c0a094cd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccb3cdb053a955763fa87ba3f95c8d6d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakurayahonpo/works/7", "thumbnail_src": "https://si.imgix.net/de1ff8d8/uploads/origins/43c2a6e3-e30b-4dc1-a753-97ce166b5721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65cfeb8e7ca5545dfd07ba7a21625c1d", "thumbnail_srcset": "https://si.imgix.net/de1ff8d8/uploads/origins/43c2a6e3-e30b-4dc1-a753-97ce166b5721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65cfeb8e7ca5545dfd07ba7a21625c1d, https://si.imgix.net/de1ff8d8/uploads/origins/43c2a6e3-e30b-4dc1-a753-97ce166b5721?bg=%23fff&auto=format%2Cco