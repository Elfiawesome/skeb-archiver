71fafc-4111-4504-9a2e-233b24125957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28fe9df8c355f90dc9c33238862349ba", "thumbnail_srcset": "https://si.imgix.net/6c80c700/uploads/origins/9871fafc-4111-4504-9a2e-233b24125957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28fe9df8c355f90dc9c33238862349ba, https://si.imgix.net/6c80c700/uploads/origins/9871fafc-4111-4504-9a2e-233b24125957?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a0f3a0a926bc1a7aceaf7e069ce1207 2x, https://si.imgix.net/6c80c700/uploads/origins/9871fafc-4111-4504-9a2e-233b24125957?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a6820420940ec98a2fa07aac28f889c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NiRo26_/works/15", "thumbnail_src": "https://si.imgix.net/ddbc0539/uploads/origins/ccc49541-f9c8-4f96-88a9-0d097db455f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918427eb9a320eb4a7fb1ccf3d70eed8", "thumbnail_srcset": "https://si.imgix.net/ddbc0539/uploads/origins/ccc49541-f9c8-4f96-88a9-0d097db455f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918427eb9a320eb4a7fb1ccf3d70eed8, https://si.imgix.net/ddbc0539/uploads/origins/ccc49541-f9c8-4f96-88a9-0d097db455f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5c73051b98cfbb0ef409516ce69dfb9 2x, https://si.imgix.net/ddbc0539/uploads/origins/ccc49541-f9c8-4f96-88a9-0d097db455f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=511b9364dac9c200c5628a19025f2b8f 3x", "genre": "art", "nsfw": false, "body": "はじめまして、当方Vライバー活動をしております陽世鳥あねはと申します。 \nイラストを見させて頂きまして、女性らしい可愛らしくて華やかなイラストでとても良くてぜひリクエストさせて頂きたいと思いました！ \n【リクエスト内容\n夏なので海で(もしくはリゾート地)はしゃいでる私(陽世鳥あねは)をリクエストします！  \n水着は大人っぽいものを想像してますが雰囲気にあっていればどんなものでも構いません！表情差分とかあれば嬉しいですがなくても大丈夫です！\n\n全身が見えていなくてもいいですが太もも辺りまではあると嬉しいです！  \n\n使用用途としてはサムネイル、SNSの投稿、返礼品としてのグッズ化などを考えてます。(商用利用込)\n\n【キャラクターの特徴】\n長いロングのゆるふわウェーブ髪で毛先に向けて緑と青のグラデがかかっています。 身長は高く175＋ヒールほど。 細身ですが胸は大きめです。肌の色は白いよりも少し健康的な肌の色です。 \nイラストは人物・背景等がレイヤー分け出来るPSDまたはPNGデータで頂けるとありがたいです。\n【キャラクター参考資料】 https://drive.google.com/file/d/1nehe2CI-_wdoSBpCvmaCEQyHhVp4TW68 \n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。 どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1nehe2CI-_wdoSBpCvmaCEQyHhVp4TW68", "created_at": "", "completed_at": ""}, {"path": "/@NiRo26_/works/14", "thumbnail_src": "https://si.imgix.net/e4a14bd8/uploads/origins/ab11196d-775a-4ae7-bc04-aca3a2906f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e230768b8b3fa9ea43c6ec1b6977448e", "thumbnail_srcset": "https://si.imgix.net/e4a14bd8/uploads/origins/ab11196d-775a-4ae7-bc04-aca3a2906f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e230768b8b3fa9ea43c6ec1b6977448e, https://si.imgix.net/e4a14bd8/uploads/origins/ab11196d-775a-4ae7-bc04-aca3a2906f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62aea0994ffe27bdea36d809ca517cca 2x, https://si.imgix.net/e4a14bd8/uploads/origins/ab11196d-775a-4ae7-bc04-aca3a2906f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ada85cd15bff813dd2aced1d277162bc 3x", "genre": "art", "nsfw": false, "body": "初めまして。IRIAMライバーとして活動しております、逆巻るいです。\nNiRo様のとても可愛らしく艶のある素敵な作品を拝見し、ぜひご依頼させていただきたいと思いリクエスト送らせていただきます。\n\n【依頼内容】\n2025年8月上旬の活動1周年で使用するイラストをご依頼したいです。\n\n・青薔薇モチーフのキャラクター\n・参考資料の部屋着衣装\n・瞳のきらきら具合、青光りの白髪、胸元/お腹/太ももがこだわり箇所\n・背景は部屋で、窓や室内の雰囲気から夜だということが分かるような感じ\n・身体のラインが綺麗に出ていて、大人っぽくえちかわな雰囲気/ポーズ\n・レイヤー分けでネグリジェありverと、脱いでいるverをいただきたいです\n・ネグリジェありverは胸元の水色のリボンで谷間が隠れるようにしていただきたいです\n・もし可能であれば、ハートうる目の表情差分をいただきたいです\n\n背景あり、背景なし透過版の2つをいただきたいです。また、頭部や指先、衣装(横側)が見切れていない状態だと嬉しいです。\n\n【使用用途】\n・SNSへの投稿\n・サムネイルへの使用(収益化済み)\n・デジタル返礼品やグッズ化等の商用利用\n\nキャラクターの瞳の輝き方、髪の毛や身体のラインがとても綺麗で繊細な作品の数々を手がけていらっしゃるNiRo様にぜひご依頼したいと思っております…！\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14oc_L_TwvVAJ0kZufctthLgV-cw8O64Z", "created_at": "", "completed_at": ""}, {"path": "/@NiRo26_/works/13", "thumbnail_src": "https://si.imgix.net/8da06259/uploads/origins/914eb183-47e7-48b4-884d-17e6a6e5f91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ad0d4046d5fc5b0241d011253f2173", "thumbnail_srcset": "https://si.imgix.net/8da06259/uploads/origins/914eb183-47e7-48b4-884d-17e6a6e5f91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ad0d4046d5fc5b0241d011253f2173, https://si.imgix.net/8da06259/uploads/origins/914eb183-47e7-48b4-884d-17e6a6e5f91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bc9f413e34de6646456ce42219710a2 2x, https://si.imgix.net/8da06259/uploads/origins/914eb183-47e7-48b4-884d-17e6a6e5f91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc83ed4e936cde5b750f145da36364dc 3x", "genre": "art", "nsfw": false, "body": "初めまして、VTuberのほしよりと申します。\n普段はゲーム実況の配信を中心に活動を行っています。\n\nXで偶然お見掛けしたイラストがかわいくて勢いのままリクエスト失礼いたします！\n以下の内容でよろしければお願いいたします。\n------------------------------------------\n★用途\n・SNS発信や、Youtubeなどの配信媒体のサムネに使用予定\n\n★内容\n・私ほしよりの立ち絵で、構図、ポーズ、ジャケットの有無、髪型等はおまかせいたします\n　（顔周りが見切れないと助かります）\n\n★納品\n・形式はPSD\n・人物や背景、他に何かありましたらレイヤー分けをしていただけると嬉しいです。\n\n★他\n・収益済みのチャンネルにて使用します\n・サムネで使用する際、若干の加工（色味、明るさ等）をする場合があります\n\n★設定資料\nhttps://x.com/hoooshiyori/status/1884519395223036033", "created_at": "", "completed_at": ""}, {"path": "/@NiRo26_/works/12", "thumbnail_src": "https://si.imgix.net/caaa6bcf/uploads/origins/66a9de71-b7d7-4608-a0e6-e7870f03cedf?bg=%23fff&auto=format%2Ccompress&fm=we