t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e67e204ee50dc119a3e01f0ec1372588 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/9", "thumbnail_src": "https://si.imgix.net/022eaeee/uploads/origins/c5ede904-e7e4-4611-a9fa-e89c3b319575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9440f144b8411e65f6920564d60ef55a", "thumbnail_srcset": "https://si.imgix.net/022eaeee/uploads/origins/c5ede904-e7e4-4611-a9fa-e89c3b319575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9440f144b8411e65f6920564d60ef55a, https://si.imgix.net/022eaeee/uploads/origins/c5ede904-e7e4-4611-a9fa-e89c3b319575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e646b73cafc2c0d25f79994662785c05 2x, https://si.imgix.net/022eaeee/uploads/origins/c5ede904-e7e4-4611-a9fa-e89c3b319575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5b08b598b5ef98e418d5fcea4ad6ecb 3x", "genre": "art", "nsfw": false, "body": "自分と友人のキャラクターを描いていただきたいと思いリクエストを送らせてもらいました！\n\n■キャラの外見\n◾︎資料\nhttps://drive.google.com/drive/folders/13E3NolqZx2ErotkVjBNf2M8E-DKiD84L\n\n🌹…少し黒めの肌、八重歯、右目に涙ボクロがある、元気な感じのキャラクター\n\n🍎…インテーク、つり目でタレ眉、エルフ耳、優しい雰囲気のキャラクター\n\n・構図やポーズ、表情などはお任せします！\n(距離感近め、仲の良さそうな雰囲気だと嬉しいです！)\n\n・キャラクターのみの透過イラストもいただけると助かります\n\n金額不足等ありましたらお手数お掛けしますが再送よろしくお願いします、\n長文になってしまい申し訳ありません\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/13E3NolqZx2ErotkVjBNf2M8E-DKiD84L", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/8", "thumbnail_src": "https://si.imgix.net/820df276/uploads/origins/1b8c5ee0-5dfa-4490-8791-314dd68ddf62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6db84bcad5dfb60d9b24ae495fc491", "thumbnail_srcset": "https://si.imgix.net/820df276/uploads/origins/1b8c5ee0-5dfa-4490-8791-314dd68ddf62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6db84bcad5dfb60d9b24ae495fc491, https://si.imgix.net/820df276/uploads/origins/1b8c5ee0-5dfa-4490-8791-314dd68ddf62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=135ed4731514cb17eecaa1ca879fd84a 2x, https://si.imgix.net/820df276/uploads/origins/1b8c5ee0-5dfa-4490-8791-314dd68ddf62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42110a11a11f9c72c864b0f546a6b232 3x", "genre": "art", "nsfw": false, "body": "鯨岡先生初めまして。\n新着で拝見した作品がとても可愛くて、もしよろしければ下記のOCをお願いできましたら嬉しいです。\n\n▼脚が人外の竜娘\n※年齢制限のある創作男女のキャラクターです。\nhttps://x.com/eqnz_i/status/1951748992762822939\n\n【可能性がある使用用途】\n・他SNS等を含む活動場所で紹介\n・SNS等のアイコンやヘッダーに使用\n・個人的な印刷物や自分用グッズへの使用\n\n元が年齢制限のある漫画のキャラクターですので先生のご活動にそぐわなかったり、ご都合が合わない場合など、お気兼ねなくキャンセル頂ければと思います。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/7", "thumbnail_src": "https://si.imgix.net/c109251a/uploads/origins/bf4ebbb0-9d74-48fb-809a-fb896fd1df39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93ae8f9116aff0bc90208075db47517b", "thumbnail_srcset": "https://si.imgix.net/c109251a/uploads/origins/bf4ebbb0-9d74-48fb-809a-fb896fd1df39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93ae8f9116aff0bc90208075db47517b, https://si.imgix.net/c109251a/uploads/origins/bf4ebbb0-9d74-48fb-809a-fb896fd1df39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d10443beee2d78e19ea96aa8cc1e0e5 2x, https://si.imgix.net/c109251a/uploads/origins/bf4ebbb0-9d74-48fb-809a-fb896fd1df39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd6f3ac379b49efdac149c06dfc10ecb 3x", "genre": "art", "nsfw": false, "body": "初めまして、千百てふと申します。\n\n鯨岡さんのドゥ絵をお見かけし、鯨岡さんの優しく華やかで艶やかな素敵な絵柄に惹かれ、是非自創作のキャラクターをお願い出来ればとリクエストお送りさせていただきました。\n\n【使用用途】\n主に個人の観賞用です。\n\n【内容】\n資料URL先のキャラクターのイラストをお願いします。\n\nTwitterリンク↓\nhttps://x.com/tehutehu_sizimi/status/1926597222382047560?s=46&t=NgZ2vE8X7XuWbvzlDbN0Mw\n\nMisskeyリンク↓\nhttps://misskey.design/notes/9kc05lfz4u\n\nポーズや構図はおまかせでよろしくお願いします。\n可愛い雰囲気も怖い雰囲気もよくするキャラクターなので、お好きな雰囲気、構図で描いていただければ幸いです。\nNG等も特にございません。\n\n以下、キャラクターの見た目や雰囲気の詳細です。ご不要であれば読み飛ばしていただいて構いません。\n\nキャラの外観：黒髪青眼で見た目年齢は12〜13くらいです。\n美少年設定です。つり目気味です。頭のてっぺんの触覚は蝶の口吻イメージでくるんとしています。目隠れしている髪の毛だけ先っぽがパッツンです。その他はやわらかくくるくるしている毛質です。\n\n服装は基本はURLの先の服装ですが、サスペンダーや上着はよく変わるのでお好きに描いてくださると幸いです。\n\n以下はさらに細かいキャラ設定になります。\n\nお名前はディエレイといいます。\n蝶々モチーフで、主食は血液です。捉えどころがないようなくるくるふわふわした態度で人を弄んだりからかったり慈しんだり嘲笑ったり…というキャラクターです。結構ノリがいいので純粋に楽しそうにしている時もあります。\n\n出し入れ自在の人外パーツがありますが、普段しまっているのでなくても問題ありません。基本形は蝶々の片翼の形をしていますが、黒いドロドロの流動体で、違う形にもなります。\n↓参考資料です。\nhttps://x.com/tehutehu_sizimi/status/1664240993749831681?s=46&t=NgZ2vE8X7XuWbvzlDbN0Mw\n\n長文失礼しました、読んでくださってありがとうございます！\nご縁がございましたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/6", "thumbnail_src": "https://si.imgix.net/5dd872be/uploads/origins/ebed7752-d194-4a20-88b6-68f54f08b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86fcfd4ad6d036aa52263318c9e0e8f2", "thumbnail_srcset": "https://si.imgix.net/5dd872be/uploads/origins/ebed7752-d194-4a20-88b6-68f54f08b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86fcfd4ad6d036aa52263318c9e0e8f2, https://si.imgix.net/5dd872be/uploads/origins/ebed7752-d194-4a20-88b6-68f54f08b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e59f7fde55cedd1c6366d78a9bf97fba 2x, https://si.imgix.net/5dd872be/uploads/origins/ebed7752-d194-4a20-88b6-68f54f08b2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fae175f3c28460348374526c698f7d9e 3x", "genre": "art", "nsfw": false, "body": "オレンジ色のビキニを着た私のオリジナルキャラクターを描いてください。セクシーなポーズで。\n目の色：グレー\n\n身長: 5'9 \"\n\n年齢: 20\n\n犬耳\n\nアクセサリー：赤い首輪\n\n背景: ビーチ\n\nポーズ: セクシー\n\n表情：浮気\n\n私のオリジナルキャラクターの参考文献はこちら: https://www.deviantart.com/citrusanime/art/My-Offical-DA-Mascot-290687270\n\n他のアーティスト 1. https://sta.sh/023ht6z36vqf 2. https://sta.sh/0278r2mg6ixd 3. https://sta.sh/0k1ja8v3adq\n\nポーズの参考文献 1. https://sta.sh/0ufsyy8di0d 2. https://sta.sh/0sozjsty4p7 3. https://sta.sh/01hzsy3ciyyy\n\nセクシーに描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/5", "thumbnail_src": "https://si.imgix.net/4a174bc6/uploads/origins/93d809c4-64bc-4bac-98b5-f74debae22a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aecfdc470e962583c5d33e62fa1481b2", "thumbnail_srcset": "https://si.imgix.net/4a174bc6/uploads/origins/93d809c4-64bc-4bac-98b5-f74debae22a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aecfdc470e962583c5d33e62fa1481b2, https://si.imgix.net/4a174bc6/uploads/origins/93d809c4-64bc-4bac-98b5-f74debae22a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc5baccf59b3e2b1365425117c50c305 2x, https://si.imgix.net/4a174bc6/uploads/origins/93d809c4-64bc-4bac-98b5-f74debae22a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3020885899962ed91f7366b4115e6a3a 3x", "genre": "art", "nsfw": false, "body": "鯨岡先生初めまして、絵柄に一目惚れして依頼させて頂きました。\n\n私の友人と私のオリジナルキャラクターを書いて頂きたいです。\n\n緑髪の少女は引っ込み思案でおどおどしている性格、体を植物に蝕まれる病に罹っています。\nオッドアイの少年は穏やかで優しい性格。\n2人とも年齢は17歳です。\n\n2人が少し不格好な花かんむりをかぶり、幸せそうに微笑んでいる写真のようなイラストをお願いします。\n\n場所は大きな木か1本生えていて穏やかな日が差している庭です。\n\nhttps://drive.google.com/drive/folders/1-8Q7mosS2Fg1TEFXv_kd8jtOvxvSl3I0", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/4", "thumbnail_src": "https://si.imgix.net/af520a74/uploads/origins/18ffb1c7-82bd-4405-937e-7bb8c49d4063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f4889d98586d1b027fa316f927dbbb0", "thumbnail_srcset": "https://si.imgix.net/af520a74/uploads/origins/18ffb1c7-82bd-4405-937e-7bb8c49d4063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f4889d98586d1b027fa316f927dbbb0, https://si.imgix.net/af520a74/uploads/origins/18ffb1c7-82bd-4405-937e-7bb8c49d4063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ae26db702a0a3b9ddeb210cecfdbc21 2x, https://si.imgix.net/af520a74/uploads/origins/18ffb1c7-82bd-4405-937e-7bb8c49d4063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bf7539b09c2aeb222eebd67147230d3 3x", "genre": "art", "nsfw": false, "body": "私の絵はかなり下手なので、私が求めているものを理解してもらえると嬉しいです\n\n今回は前作キャラのヤンデレ恋人です。性別不問なので、男らしくも女の子らしくも描けます。\n青白い顔に満面の笑みを貼り付けた狂信者です。ハロウィン(?)感のある絵でも構いません。\n背景は先ほどの女の子と合わせて金色か赤色でお願いします\n\nhttps://drive.google.com/file/d/1wot-NnB5-BwkYKwAtPsbX9Pe-MVBqwG0/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/3", "thumbnail_src": "https://si.imgix.net/f0978fc0/uploads/origins/fb00b397-f257-4fb8-b128-15c0d831724d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41ea3c6d754a2fc460be52a33421dff", "thumbnail_srcset": "https://si.imgix.net/f0978fc0/uploads/origins/fb00b397-f257-4fb8-b128-15c0d831724d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41ea3c6d754a2fc460be52a33421dff, https://si.imgix.net/f0978fc0/uploads/origins/fb00b397-f257-4fb8-b128-15c0d831724d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=447121b27687a29cace5316e67efdade 2x, https://si.imgix.net/f0978fc0/uploads/origins/fb00b397-f257-4fb8-b128-15c0d831724d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd7b0bfe61de08463bf98a6cedeaf083 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私は本当にあなたのアートスタイルが大好きです。\n\n私のオリジナルキャラクター、デイジーを描いていただけませんか？ちょっとぽっちゃりした女の子で、お花屋さんをしています。エプロンの下をさげて花束を持ち、頭には花のリングを付けて欲しいです。そして、満面の笑みでこちらを向いている。また、胸の大きさはもっと小さくてもかまいません。\n\nその他はお好みでどうぞ。お読みいただきありがとうございました。\n\nhttps://imgur.com/a/2Z092Rc", "created_at": "", "completed_at": ""}, {"path": "/@osayo_3434/works/2", "thumbnail_src": "https://si.imgix.net/d2d78cc1/uploads/origins/f9b370ad-328a-479d-9f99-39c22cbd38ce?bg=%23fff&auto=forma