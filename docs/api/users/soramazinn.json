37d/uploads/origins/7d09a68d-21d8-4256-8f10-6dab0eb834ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c79a25d1b039aa8744c93278eaf06e7", "thumbnail_srcset": "https://si.imgix.net/213a637d/uploads/origins/7d09a68d-21d8-4256-8f10-6dab0eb834ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c79a25d1b039aa8744c93278eaf06e7, https://si.imgix.net/213a637d/uploads/origins/7d09a68d-21d8-4256-8f10-6dab0eb834ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b006c612c5c0cf816a95743726e7c12 2x, https://si.imgix.net/213a637d/uploads/origins/7d09a68d-21d8-4256-8f10-6dab0eb834ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffbcccd3a0a726bc99471d282bc3e33b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！久々に剣ユーを依頼をさせて頂きます！\n以前に自分が描いたような構図(資料URLあり)で、デンジャー発情態になっているシチュでお願いします！\nデンジャーの顔は発情していてまだまだヤラれ足りない！って雰囲気だと嬉しいです！\n\nhttps://x.com/uraguregure/status/1977562638390608094", "created_at": "", "completed_at": ""}, {"path": "/@soramazinn/works/44", "thumbnail_src": "https://si.imgix.net/fc8a7e7d/uploads/origins/5d50fbed-f04b-4dbd-ab4c-b3f4f1caa6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1059880c9086b3cbdd2a8dda409f6220", "thumbnail_srcset": "https://si.imgix.net/fc8a7e7d/uploads/origins/5d50fbed-f04b-4dbd-ab4c-b3f4f1caa6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1059880c9086b3cbdd2a8dda409f6220, https://si.imgix.net/fc8a7e7d/uploads/origins/5d50fbed-f04b-4dbd-ab4c-b3f4f1caa6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e1a1296ef8f30714f8f2a3fdbea291c 2x, https://si.imgix.net/fc8a7e7d/uploads/origins/5d50fbed-f04b-4dbd-ab4c-b3f4f1caa6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f7110cf2d6edc9d6e7f20eb961ab0a8 3x", "genre": "art", "nsfw": true, "body": "またまた依頼させて頂きます！\n以前に依頼させて頂いたブラスターヴェノミィ姿になったムルーマちゃんとホロヴィルスちゃんと剣さんの濃厚新年スケベ絵の続きをお願いしたいです！\n構図は以下でお願いします。\n・剣さんが二人に挟まれて手コキされている。\n・彼女たちの胸を揉んでいる。\n・彼女たちの首元の触腕パイプが剣さんの体を愛撫するように這っている。(難しい場合は不要です)\n宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@soramazinn/works/43", "thumbnail_src": "https://si.imgix.net/9c3a2734/uploads/origins/728f42fe-19b3-430a-8214-9a5f0115114e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f171fd30b59cf8020dbcc374a7f29b60", "thumbnail_srcset": "https://si.imgix.net/9c3a2734/uploads/origins/728f42fe-19b3-430a-8214-9a5f0115114e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f171fd30b59cf8020dbcc374a7f29b60, https://si.imgix.net/9c3a2734/uploads/origins/728f42fe-19b3-430a-8214-9a5f0115114e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e540a22971c6f272366737ad075a0e00 2x, https://si.imgix.net/9c3a2734/uploads/origins/728f42fe-19b3-430a-8214-9a5f0115114e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b16a4869ce9015e6c374ff659a645c51 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回も例の剣ムル学パロシチュの別バージョンで、水泳部のホロヴィルス先輩をお願いします！\nロッカーに閉じ込められた状態で剣さんと汗だくで交わっているシチュで、ホロヴィルスちゃんは競泳水着を着用していて乳吸いされていると嬉しいです！\n宜しくお願いします〜！", "created_at": "", "completed_at": ""}, {"path": "/@soramazinn/works/42", "thumbnail_src": "https://si.imgix.net/6a57a83d/uploads/origins/68ac1b26-683b-4c95-b961-48bd272ee5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0bc684856ffb343e1c0e6e32cd334ad", "thumbnail_srcset": "https://si.imgix.net/6a57a83d/uploads/origins/68ac1b26-683b-4c95-b961-48bd272ee5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0bc684856ffb343e1c0e6e32cd334ad, https://si.imgix.net/6a57a83d/uploads/origins/68ac1b26-683b-4c95-b961-48bd272ee5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc03cb95835842b715ec35ae58032017 2x, https://si.imgix.net/6a57a83d/uploads/origins/68ac1b26-683b-4c95-b961-48bd272ee5f4?bg=%23fff&auto=format%2Ccompress