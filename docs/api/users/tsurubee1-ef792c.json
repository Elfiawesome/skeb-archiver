s/origins/0653e1d2-b6de-47e3-b493-f4e5df68db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3753a99d4873976d330d9e9e1f995b7", "thumbnail_srcset": "https://si.imgix.net/1266be01/uploads/origins/0653e1d2-b6de-47e3-b493-f4e5df68db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3753a99d4873976d330d9e9e1f995b7, https://si.imgix.net/1266be01/uploads/origins/0653e1d2-b6de-47e3-b493-f4e5df68db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27cd1ed2a5d9332e66ad535e87d43af9 2x, https://si.imgix.net/1266be01/uploads/origins/0653e1d2-b6de-47e3-b493-f4e5df68db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5865f5be484b8acc4fdd5c977180f67 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のFFXIVのキャラクターの絵をお願いしたいです。彼女は赤と黒の髪と茶色の目を持っています。リファレンスにあるドレスを着て描いていただけませんか？色は濃い紫です。ポーズや構図はお任せします。ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1lHD4TcdgrmqX_hstSQ6-f7WHqCrqGTYm?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tsurubee1/works/3", "thumbnail_src": "https://si.imgix.net/de751272/uploads/origins/b36b7f8c-44af-4c0e-8423-6c657271eca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a985e4eab3562070872e2e533018405", "thumbnail_srcset": "https://si.imgix.net/de751272/uploads/origins/b36b7f8c-44af-4c0e-8423-6c657271eca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a985e4eab3562070872e2e533018405, https://si.imgix.net/de751272/uploads/origins/b36b7f8c-44af-4c0e-8423-6c657271eca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8a7d9c2aa4d38f8f083f72812843530 2x, https://si.imgix.net/de751272/uploads/origins/b36b7f8c-44af-4c0e-8423-6c657271eca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0e140297525eb70f56cc4dac721c4a9 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nあなたのアートスタイルとskebのプロフィールにあるFFXIVのキャラクター画が大好きです!\nFFXIVのキャラクターをぜひ依頼したいです。\nポーズは自由に選んでください。\nキャラクターには少し微笑みを与え、画像にある服を使用してください。\n\nありがとうございます!\n\nhttps://imgur.com/a/aVEq3ZW", "created_at": "", "completed_at": ""}, {"path": "/@tsurubee1/works/2", "thumbnail_src": "https://si.imgix.net/d76eadb0/uploads/origins/d279ba7f-f273-4383-9bcd-df4c1172068a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d19047fa7afe37956e02ac9319b70bb", "thumbnail_srcset": "https://si.imgix.net/d76eadb0/uploads/origins/d279ba7f-f273-4383-9bcd-df4c1172068a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d19047fa7afe37956e02ac9319b70bb, https://si.imgix.net/d76eadb0/uploads/origins/d279ba7f-f273-4383-9bcd-df4c1172068a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cccdf445344c0fc927397cd67c32a71b 2x, https://si.imgix.net/d76eadb0/uploads/origins/d279ba7f-f273-4383-9bcd-df4c1172068a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec3dd14e1be61cb9b08a0bb63f6000e 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私の名前はリンです。あなたのアートは素晴らしく、ゴージャスです。私と私の友人AzのVtuberモデル/キャラクターを（彼女の許可を得て）描いていただけませんか？\n\n参考(私): https://i.imgur.com/wZGiIKS.png\n参考(Az): https://imgur.com/7IxIgnI\n\nポーズや背景はご自由にどうぞ。お忙しい中、本当にありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@tsurubee1/works/1", "thumbnail_src": "https://si.imgix.net/e179bb68/uploads/origins/ebf785ac-7eb3-4c5e-bdde-6e5dba2ee573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3efa661f6be1d86b4d0f74d83a0d6d93", "thumbnail_srcset": "https://si.imgix.net/e179bb68/uploads/origins/ebf785ac-7eb3-4c5e-bdde-6e5dba2ee573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3efa661f6be1d86b4d0f74d83a0d6d93, https://si.imgix.net/e179bb68/uploads/origins/ebf785ac-7eb3-4c5e-bdde-6e5dba2ee573?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7231d71e1734422b985c67579c3a676 2x, https://si.imgix.net/e179bb68/uploads/origins/ebf785