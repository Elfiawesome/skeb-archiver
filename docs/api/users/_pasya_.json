fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2056faac37a9ed533d6ad4066f803c4", "thumbnail_srcset": "https://si.imgix.net/5cc798bd/uploads/origins/41e593f8-16d6-4a07-8e9e-98524d75991c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2056faac37a9ed533d6ad4066f803c4, https://si.imgix.net/5cc798bd/uploads/origins/41e593f8-16d6-4a07-8e9e-98524d75991c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff767bb1aa16e12f0587d47cbc9e88b3 2x, https://si.imgix.net/5cc798bd/uploads/origins/41e593f8-16d6-4a07-8e9e-98524d75991c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=024a979874bc5adf211634d813ac33af 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_pasya_/works/41", "thumbnail_src": "https://si.imgix.net/ca114780/uploads/origins/30875b9c-cd03-4b24-8d71-d524867cec2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6574015bf2d0e3615a08b2c5fef40ea9", "thumbnail_srcset": "https://si.imgix.net/ca114780/uploads/origins/30875b9c-cd03-4b24-8d71-d524867cec2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6574015bf2d0e3615a08b2c5fef40ea9, https://si.imgix.net/ca114780/uploads/origins/30875b9c-cd03-4b24-8d71-d524867cec2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c05492685ece093eefd593d4ebf8451e 2x, https://si.imgix.net/ca114780/uploads/origins/30875b9c-cd03-4b24-8d71-d524867cec2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d67851f852326ece05e6215a9f2bd05 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_pasya_/works/40", "thumbnail_src": "https://si.imgix.net/24d78ce7/uploads/origins/6799234b-fd9c-4a4b-b5ba-89a6ab7202b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=606a4553bd8cf3f92255c64c16ef3225", "thumbnail_srcset": "https://si.imgix.net/24d78ce7/uploads/origins/6799234b-fd9c-4a4b-b5ba-89a6ab7202b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=606a4553bd8cf3f92255c64c16ef3225, https://si.imgix.net/24d78ce7/uploads/origins/6799234b-fd9c-4a4b-b5ba-89a6ab7202b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f89f481337f946c352730c454ffeee4 2x, https://si.imgix.net/24d78ce7/uploads/origins/6799234b-fd9c-4a4b-b5ba-89a6ab7202b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b79a20f135adfb57e59c44f8d2c86c5 3x", "genre": "art", "nsfw": true, "body": "こんにちは、本海スターレールのスパークルをモチーフにした玉入れ作品をお願いします：\nhttps://www.youtube.com/watch?v=-FrbSYzlqdU\nhttps://www.pixiv.net/en/artworks/116875084\nhttps://www.pixiv.net/en/artworks/132885721\n\n以下の参考資料のようなシナリオを希望します：\nhttps://www.pixiv.net/en/artworks/39940825\n\n全裸の男性が両足を広げて宙に浮いている。その男性の睾丸は大きく垂れ下がり、ペニスは大きく勃起していること。スパークルもヘアアクセサリーを除いてヌードであること。スパークルは男性の睾丸をパンチングバッグとして使い、強力なパンチで殴ること。スパークルは素手で、あざ笑うような表情をしていること。男性はとても痛がっているはずだ。\n\nありがとう", "created_at": "", "completed_at": ""}, {"path": "/@_pasya_/works/39", "thumbnail_src": "https://si.imgix.net/d7cd3e06/uploads/origins/75a50e64-e8bd-4bef-948a-f8340c8e6136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f03b514eb5557046cd9e893a33c29e0a", "thumbnail_srcset": "https://si.imgix.net/d7cd3e06/uploads/origins/75a50e64-e8bd-4bef-948a-f8340c8e6136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f03b514eb5557046cd9e893a33c29e0a, https://si.imgix.net/d7cd3e06/uploads/origins/75a50e64-e8bd-4bef-948a-f8340c8e6136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba42d5359f3b89cc5988461b5efc169d 2x, https://si.imgix.net/d7cd3e06/uploads/origins/75a50e64-e8bd-4bef-948a-f8340c8e6136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=763c26ddc117134d122c8e21eee96bb8 3x", "genre": "art", "nsfw": true, "body": "ぱしゃ/pasyaさん！こんにちは！らっぱです！\nシャルロットのイラストがめちゃくちゃ好きです！リクエストお願いします！\n\nシャルロットが触手に襲われてるイラストをお願いします。\nシチュエーションは、後ろから抱きつかれるように絡みつかれて、触手に乳首とクリを弄られて絶頂。\n\nシャルロット＋水スライムで表情と体の反応の変化がすごいエロくて良かったので、そちらもお願いします。\n拘束されて困惑\n↓\n責めの手が向かってきて青ざめる\n↓\n乳首とクリを責められて喘ぎ悶える\n↓\n責めが激しくなって今にも絶頂しそうなのを必死に耐える(シャルロット＋水スライム③の3枚目ような感じ)\n前のめりになったり、俯いたりしてる感じでお願いします。\n↓\n耐え切れず絶頂(体は仰け反るように跳ねながら、表情は歯を食いしばったまま絶頂)\n↓\n絶頂させられて息も絶え絶えになりながらも、まだ軽く責めが続いて体がビクビク跳ねてる。\nみたいな流れでお願いします。\n\n他にも入れて欲しい要素としまして\n足の拘束:足はガッツリ開いて拘束ではなく、触手が入れる程度の隙間を、閉じたくても閉じれない感じで開かされてる状態\n台詞:喘ぎ声はもちろん、クリを責められてる感じてる時に(シャルロット＋水スライム③の1枚目)や絶頂する直前に今にもイきそうでヤバい、マズいと焦ってる感じの心の声\n擬音や体の反応:ぱしゃ/pasyaさんのビクビクとか震えてたり跳ねてたり、乳首やクリが勃起してたり、愛液が溢れてる描写が凄い好きなのでお願いします！\n\n下着とかの有無はお任せします。クリ責めがはっきり分かれば大丈夫です。", "created_at": "", "completed_at": ""}, {"path": "/@_pasya_/works/38", "thumbnail_src": "https://si.imgix.net/3522b396/uploads/origins/7a1342b2-d71f-4f68-a3a7-e8aec3bd8020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10938e2f361f4fa3a1f10e36173f13c2", "thumbnail_srcset": "https://si.imgix.net/3522b396/uploads/origins/7a1342b2-d71f-4f68-a3a7-e8aec3bd8020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10938e2f361f4fa3a1f10e36173f13c2, https://si.imgix.net/3522b396/uploads/origins/7a1342b2-d71f-4f68-a3a7-e8aec3bd8020?bg=%23fff&auto=format%2Ccompress&