2a5-ce63-4671-8d0f-752b5ebd2d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afe16dfffdb93191853ab3385591f0d8 2x, https://si.imgix.net/134b6258/uploads/origins/ba2042a5-ce63-4671-8d0f-752b5ebd2d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d183a12c58c68de95020d29bba20f7d 3x", "genre": "art", "nsfw": false, "body": "割烹着ゆかりさんと和メイドマキさん、吉原ラメント衣装をテトさんから借りたあかりちゃんお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kusaikire_iki/works/8", "thumbnail_src": "https://si.imgix.net/0089b9ac/uploads/origins/f3bfc3b5-a86b-4f91-9a23-86d78415616a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1038f210e89006cccfc7b5bf44f793", "thumbnail_srcset": "https://si.imgix.net/0089b9ac/uploads/origins/f3bfc3b5-a86b-4f91-9a23-86d78415616a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1038f210e89006cccfc7b5bf44f793, https://si.imgix.net/0089b9ac/uploads/origins/f3bfc3b5-a86b-4f91-9a23-86d78415616a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db115007d3e8f30eac43f0a2bdf55d88 2x, https://si.imgix.net/0089b9ac/uploads/origins/f3bfc3b5-a86b-4f91-9a23-86d78415616a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6c6fbc523c6c94455709383edb76cab 3x", "genre": "art", "nsfw": false, "body": "こんにちは、もしよろしければCCD-0500　フィーちゃんをお願いします。\nシチュとしましてはフィーちゃんがメロンパンを食べながらお家でまったりしている感じだと嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kusaikire_iki/works/7", "thumbnail_src": "https://si.imgix.net/d38700ff/uploads/origins/4275ad5c-a1eb-43ac-a916-823b4191c0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a67031b90d3bffbd0e9a67b9f89aa85", "thumbnail_srcset": "https://si.imgix.net/d38700ff/uploads/origins/4275ad5c-a1eb-43ac-a916-823b4191c0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a67031b90d3bffbd0e9a67b9f89aa85, https://si.imgix.net/d38700f