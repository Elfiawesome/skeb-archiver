8-4c6d-ae1f-b0419b984d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c00894fd144bd76523cf766fbdc7cd6 2x, https://si.imgix.net/ed0b7314/uploads/origins/76d522a2-2ea8-4c6d-ae1f-b0419b984d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0ca480da946a44a6f55d2a1000cfe21 3x", "genre": "art", "nsfw": false, "body": "官女メフの顔アップイラストをお願い致します。\n表情は柔和で雅やかなほほ笑みを浮かべていて、９０年代〜００年代のアニメやゲームのような感じの絵柄で描写して下さいましたら、幸いです。\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tori_san/works/8", "thumbnail_src": "https://si.imgix.net/9003f0e3/uploads/origins/1d803906-80c0-4dc6-bd8f-4f64402a5e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14a5c5554d279602cf92014466628c2", "thumbnail_srcset": "https://si.imgix.net/9003f0e3/uploads/origins/1d803906-80c0-4dc6-bd8f-4f64402a5e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14a5c5554d279602cf92014466628c2, https://si.imgix.net/9003f0e3/uploads/origins/1d803906-80c0-4dc6-bd8f-4f64402a5e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0147196824ee8c793db5285c411d8a18 2x, https://si.imgix.net/9003f0e3/uploads/origins/1d803906-80c0-4dc6-bd8f-4f64402a5e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a7f3c75a2ea1af421c5f2d8c2b92663 3x", "genre": "art", "nsfw": false, "body": "いつも大変お世話になっております。\nイラストをお願い致します。\n今回は私の最推しである、官女メフの顔アップイラストをリクエスト致します。\n官女メフの顔アップを、サイコでホラーに描写してみて下さい。\n官女メフの真っ白な白塗り風の肌や、地毛の眉毛がなく額に麻呂眉を描いている独自の化粧など、再現下さいましたら、幸いです。\n何卒よろしくお願い致します。\n応援しております！", "created_at": "", "completed_at": ""}, {"path": "/@tori_san/works/7", "thumbnail_src": "https://si.imgix.net/2454d149/uploads/origins/3fc9d85b-7ac7-4f48-8d5e-c0efdd7e39ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=645ad196dfbde8c3375f6cd555b7afef", "thumbnail_srcset": "https://si.imgix.net/2454d149/uploads/origins/3fc9d85b-7ac7-4f48-8d5e-c0efdd7e39ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=645ad196dfbde8c3375f6cd555b7afef, https://si.imgix.net/2454d149/uploads/origins/3fc9d85b-7ac7-4f48-8d5e-c0efdd7e39ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f0f91323cf73d5c7eac39e0ba16942a 2x, https://si.imgix.net/2454d149/uploads/origins/3fc9d85b-7ac7-4f48-8d5e-c0efdd7e39ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15a77fddb5263488b938b6d5ea24099d 3x", "genre": "art", "nsfw": false, "body": "いつも大変お世話になっております！\n鶏さんが今お描きになりたいイラスト作品をお願い致します！\n鶏さんの好みと感性で、イラストを作成してみて下さい(^o^)v", "created_at": "", "completed_at": ""}, {"path": "/@tori_san/works/6", "thumbnail_src": "https://si.imgix.net/4be22698/uploads/origins/8c30e038-7a4f-427c-ba06-a6aa53fde7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d49090a3eff3293e087666b899b0ea3", "thumbnail_srcset": "https://si.imgix.net/4be22698/uploads/origins/8c30e038-7a4f-427c-ba06-a6aa53fde7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d49090a3eff3293e087666b899b0ea3, https://si.imgix.net/4be22698/uploads/origins/8c30e038-7a4f-427c-ba06-a6aa53fde7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07b946f097fb0a76a9ee224a180d33cd 2x, https://si.imgix.net/4be22698/uploads/origins/8c30e038-7a4f-427c-ba06-a6aa53fde7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3cc5321a71044927997c3cf74eff614 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております！\nお好きなキャラを、お好きなようにお描きになられて下さい！\n応援しております！", "created_at": "", "completed_at": ""}, {"path": "/@tori_san/works/5", "thumbnail_src": "https://si.imgix.net/2a37b720/uploads/origins/9a947eb4-713a-43f9-977f-6315cb4bc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d0de15717936d7a127968b813668bbe", "thumbnail_srcset": "https://si.imgix.net/2a37b720/uploads/origins/9a947eb4-713a-43f9-977f-6315cb4bc1ec?bg=%23