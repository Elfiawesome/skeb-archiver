43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4735e3fa83a1318c937b4cfe4149acfe, https://si.imgix.net/1d2a9928/uploads/origins/475686d3-3ff6-4f19-92c5-93a4e1197043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=050b442b05bda7e5c989f1b698abfe23 2x, https://si.imgix.net/1d2a9928/uploads/origins/475686d3-3ff6-4f19-92c5-93a4e1197043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac50ac09557050a87324274211bc7060 3x", "genre": "correction", "nsfw": false, "body": "猫の治療費にお使いください。絵は描かないのでアドバイスは不要です。", "created_at": "", "completed_at": ""}, {"path": "/@megannaperle/works/34", "thumbnail_src": "https://si.imgix.net/1328ed6d/uploads/origins/0df65452-b781-40fa-93b2-68aa256fe683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83d6a683dfe12d09becb2b0181ca6fb", "thumbnail_srcset": "https://si.imgix.net/1328ed6d/uploads/origins/0df65452-b781-40fa-93b2-68aa256fe683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83d6a683dfe12d09becb2b0181ca6fb, https://si.imgix.net/1328ed6d/uploads/origins/0df65452-b781-40fa-93b2-68aa256fe683?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a53dabd418d512a4e7fbe844569eeb45 2x, https://si.imgix.net/1328ed6d/uploads/origins/0df65452-b781-40fa-93b2-68aa256fe683?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62f57237325c31b1414d023a58669cdb 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております！\n\n可能でしたら、モノクロのラフっぽいかんじで、東京リベンジャーズの柴大寿くんを描いていただけませんでしょうか。\n柴大寿くんのお顔が大好きなので、上半身メインだと嬉しいです！\nskebリクエストするのが初めてなので、なにか間違いや失礼があったら申し訳ございません…！\n何卒ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@megannaperle/works/33", "thumbnail_src": "https://si.imgix.net/f2e9c9f5/uploads/origins/3ca4966f-471a-4e6a-89b0-bc9d79ddad8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=midd