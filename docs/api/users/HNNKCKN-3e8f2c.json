op&crop=top&w=200&h=200&s=07a3ffe63bd22d83f6db9d2e9bdd0ab5, https://si.imgix.net/ba085752/uploads/origins/35313546-eede-46c0-b0a8-2252a00e4bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70888d39f581285f0beb9ec206555cee 2x, https://si.imgix.net/ba085752/uploads/origins/35313546-eede-46c0-b0a8-2252a00e4bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd818a7de4e757d11e2bdca0c8728c61 3x", "genre": "art", "nsfw": false, "body": "有間都古", "created_at": "", "completed_at": ""}, {"path": "/@HNNKCKN/works/1", "thumbnail_src": "https://si.imgix.net/5a9c41c4/requests/148326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2bac4ec4a01b10898bce5cf81ff9147", "thumbnail_srcset": "https://si.imgix.net/5a9c41c4/requests/148326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2bac4ec4a01b10898bce5cf81ff9147, https://si.imgix.net/5a9c41c4/requests/148326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=922e04a252d7212615dd5f750e1688b0 2x, https://si.imgix.net/5a9c41c4/requests/148326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95d3721008a569885133d76f044f0837 3x", "genre": "art", "nsfw": false, "body": "マギレコNAが終了するので、アシュレイ・テイラーに捧げるZINEを作っているのですが、そのZINEに参加してみませんか？\n\nアシュリー・テイラーをフィーチャーした作品であれば、何を描いても構いません。\n\n千秋理子さんのかわいい芸風を考えると、千秋理子さんや里見とうかさん、柊ねむさんのような子供キャラの作品もいいかもしれませんね。\n\nアシュリーに巨大な熊之助を見せびらかしながら遊んでもらうとか。\n\n他のアイデアとしては、ネット上の荒らしやイジメに対処するために、アシュリーに双葉さなさんを助けてもらうのもいいかもしれませんね。\n\nアシュリーはストリーマーとして多くのことを扱っているだろうし、サナのハラスメントへの対処法も知っているだろう。サナを描くなら是非ともサナのぬいぐるみを背景にして欲しいな\n\nこれらは提案に過ぎません。アシュリー・テイラーを特徴とし、本誌のルールに従っている限り、自由に描いてください。\n\n参考URLを見ていただければわかると思います。\n\nhttps://twitter.com/leafbladie/status/1301631037425016832?s=19", "created_at": "", "completed_at": ""}]}