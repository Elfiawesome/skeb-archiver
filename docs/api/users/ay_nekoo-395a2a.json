cfd-071a9d0ced40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ca431b1b1d74185c3c64e459b207893, https://si.imgix.net/bab2a979/uploads/origins/f2a08ecb-c203-4370-8cfd-071a9d0ced40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=150fee26cb8488b4a0faf8947c84b5bf 2x, https://si.imgix.net/bab2a979/uploads/origins/f2a08ecb-c203-4370-8cfd-071a9d0ced40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9df4f43cc5c0f0a977e2b272e554189e 3x", "genre": "art", "nsfw": false, "body": "綾猫/ayaneko様、初めまして。\n\n先生の絵柄はとても可愛くて、好きです。私の大好きなVLiverのプレゼント用にイラストをお願いしに来ました。\n\n●イラスト詳細\n- 参考4の写真を使ってください\n- 表情・構図・背景はお任せします\n- 小さな幽霊の元素も描ければ嬉しいです（fanのキャラ）\n\n●使用用途\n- 配信や動画のサムネイル\n- SNSでの宣伝活動\n- チャンネル会員のプレゼント用\n（不可のものがあれば納品物の別レイヤーに記載の上、お知らせいただけますと幸いです）\n\npsdが可能でしたら是非お願いしたいです。\n\n●参考資料\nhttps://drive.google.com/drive/folders/1EUmCM5ksybaAmGp7izBWKN3pIh8JdXU6?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ay_nekoo/works/7", "thumbnail_src": "https://si.imgix.net/db78347d/uploads/origins/18333eed-54d8-45d6-8d72-79db15d188a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae9edf6a13bfdb8e70656c909f6a2355", "thumbnail_srcset": "https://si.imgix.net/db78347d/uploads/origins/18333eed-54d8-45d6-8d72-79db15d188a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae9edf6a13bfdb8e70656c909f6a2355, https://si.imgix.net/db78347d/uploads/origins/18333eed-54d8-45d6-8d72-79db15d188a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13c0b39de406ae4584406c69372c10d8 2x, https://si.imgix.net/db78347d/uploads/origins/18333eed-54d8-45d6-8d72-79db15d188a1?bg=%23f