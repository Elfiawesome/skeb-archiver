4452-4ea6-bb8c-12a0dba38966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8212d05847c0922d19dbc51f29b7607 2x, https://si.imgix.net/803e6242/uploads/origins/7cb8acbc-4452-4ea6-bb8c-12a0dba38966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=764171f1a8143f496fc2d55b3bdf10f9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hakoniwatsuka3/works/59", "thumbnail_src": "https://si.imgix.net/fbe1d4e0/uploads/origins/56574f86-5104-4848-bb8c-2ef0084d380b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfeed98a6ff032548069a5011e8076e0", "thumbnail_srcset": "https://si.imgix.net/fbe1d4e0/uploads/origins/56574f86-5104-4848-bb8c-2ef0084d380b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfeed98a6ff032548069a5011e8076e0, https://si.imgix.net/fbe1d4e0/uploads/origins/56574f86-5104-4848-bb8c-2ef0084d380b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=233eb8a381e5c28e2d5186c43c83596c 2x, https://si.imgix.net/fbe1d4e0/uploads/origins/56574f86-5104-4848-bb8c-2ef0084d380b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3e501166c8661a86c704c5dcad72bda 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nつかさんちのナっちゃんセっちゃんが水着姿の恰好でエッチな事してくれる絵をお願いしたいです。\n\nどちらかが本番以上してくれるシチュを希望しますが、構図的に難しいようでしたら水着をずらしてエッチな格好でお誘いしてくれてるようなシチュエーションでも嬉しいです。\n\nご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hakoniwatsuka3/works/58", "thumbnail_src": "https://si.imgix.net/8be290f4/uploads/origins/4944a326-bc68-47af-8021-7b1bb65c5971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c738b29e78427e7a0da1e1d6e788946d", "thumbnail_srcset": "https://si.imgix.net/8be290f4/uploads/origins/4944a326-bc68-47af-8021-7b1bb65c5971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c738b29e78427e7a0da1e1d6e788946d, https://si.imgix.net/8be290f4/uploads/origins/4944a326-bc68-47af-8021-7b1bb65c5971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=426da8125186bebac50e9827cbf3f80c 2x, https://si.imgix.net/8be290f4/uploads/origins/4944a326-bc68-47af-8021-7b1bb65c5971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d919c4d4a486381118c76cda64b3d536 3x", "genre": "art", "nsfw": true, "body": "気長にお待ちできますので改めて再送でお願いします（ｘ・；\n\n水色のぽにてと爆乳が特徴の黒い鎧を来たエルフをお願いできないでしょうか\n\n参照画像の剣士が夜大きな満月を背に崖の端に立って、絵の外にいる敵を見下ろしているような絵を見てみたいです\n\nポーズは右手に大剣を片手で持ち、左手は腰に手を当てて片足を前に出して立っていて\n表情は目が猫目のようになって口は閉じていて少しへの字な感じで\n\n補足\n身長は175cmで胸は110cm位です\n剣の全長は130～140cm位？\n胸の金属はカウベルです\n鎧の上に一番したの画像の腰ベルトとポーチと鞘に収まった剣を追加してください\n\nもし可能でしたらつかさんの少し前のリクエストにあったような設定画もお願いできないでしょうか？\n\n是非よろしくお願いいたします（x＜\n\n\n\n\n参照画像\n全体画像と胸元のカウベル\nhttps://twitter.com/arsisuponite/status/1752687965082624165?t=T7ZzXosY1xhHDe1AiaCbgg&s=19\n\n両手 持ち大剣\nhttps://twitter.com/arsisuponite/status/1638523236916015104?t=uDjTuIrhbZMO87INwcGPVw&s=19\n\n腰ベルトと予備武器参照\nhttps://twitter.com/arsisuponite/status/1695242772612354212?t=gI8Y-ah8ytLjHbaLLNAMug&s=19", "created_at": "", "completed_at": ""}, {"path": "/@hakoniwatsuka3/works/57", "thumbnail_src": "https://si.imgix.net/cba35c36/uploads/origins/c7a394d4-9b8e-40b1-a5f9-42ad35ec3697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c7a9399282315d3c89435311bfac4f", "thumbnail_srcset": "https://si.imgix.net/cba35c36/uploads/origins/c7a394d4-9b8e-40b1-a5f9-42ad35ec3697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c7a9399282315d3c89435311bfac4f, https://si.imgix.net/cba35c36/uploads/origins/c7a394d4-9b8e-40b1-a5f9-42ad35ec3697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49964b1e02492d89f2890e700c18d37e 2x, https://si.imgix.net/cba35c36/uploads/origins/c7a394d4-9b8e-40b1-a5f9-42ad35ec3697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=550bdfea522bc3afbee937c0a22b63e2 3x", "genre": "art", "nsfw": false, "body": "ロゼさん描いて欲しいです！\nもしよければうちのヤツデとツーショットにしていただけると本編中こき使ってしまった彼女へのご褒美になって嬉しいんですが…おまかせで！\n\nhttps://www.pixiv.net/artworks/103239700", "created_at": "", "completed_at": ""}, {"path": "/@hakoniwatsuka3/works/56", "thumbnail_src": "https://si.imgix.net/0950fb4f/uploads/origins/adf95f46-b3e3-44bc-8af1-1cd6f4fc5396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf9a21433ebb430a5b6b57b86e175379", "thumbnail_srcset": "https://si.imgix.net/0950fb4f/uploads/origins/adf95f46-b3e3-44bc-8af1-1cd6f4fc5396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf9a21433ebb430a5b6b57b86e175379, https://si.imgix.net/0950fb4f/uploads/origins/adf95f46-b3e3-44bc-8af1-1cd6f4fc5396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6a2025e99dd62eead9de3d4e05c559e 2x, https://si.imgix.net/0950fb4f/uploads/origins/adf95f46-b3e3-44bc-8af1-1cd6f4fc5396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a59d2418d94a1ea80fbbcc125e49fddb 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nデンノコです。\n久しぶりのリクエストとなりますが、うちのオリキャラ、コクリュウで以下のようなイラストをお願いしたいです。\n\n------\n\n▼内容\nつかさんの手でアレンジされた衣装・武器を身に纏った、コクリュウの1枚絵をお願いしたいです。\n\n衣装は中世・西洋的でダークなファンタジー風、武器はギミックや飾り気の少ないシンプルなもの、ふとももの露出は可能であればオリジナルと同程度であると嬉しいです。\n\n又、可能であれば衣装・武器の設定画もいただけたらと存じます。\n\n▼補足\n・本件にてデザインしていただいた衣装を、デフォルトの衣装として今後使用していきたいと考えております。\n・尻尾はあってもなくても全く問題ありません。\n・胸は大きめでお願いします(重点)\n\n▼参照資料\nhttps://twitter.com/Den_noko46/status/1520704246466834432/photo/1\n\nhttps://twitter.com/Den_noko46/status/1448302180599877634/photo/\n\n上記ご検討の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hakoniwatsuka3/works/55", "thumbnail_src": "https://si.imgix.net/1bb0b713/uploads/origins/c0f0a5cf-e2bd-4f77-aa2c-54b85eea1798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874a38e5cce065de429a0f1955a359b9", "thumbnail_srcset": "https://si.imgix.net/1bb0b713/uploads/origins/c0f0a5cf-e2bd-4f77-aa2c-54b85eea1798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874a38e5cce065de429a0f1955a359b9, https://si.imgix.net/1bb0b713/uploads/origins/c0f0a5cf-e2bd-4f77-aa2c-54b85eea1798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eb1ef2b29a28cc4ba89ed5b87f0c4f3 2x, https://si.imgix.net/1bb0b713/uploads/origins/c0f0a5cf-e2bd-4f77-aa2c-54b85eea1798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a7e1cea5dd503199f35b07490fd8597 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストの数々、拝見しております。\nつか様の絵のタッチが大好きです。またオリジナルキャラクターもどれも魅力的で、特にノアが昔から大好きです。\n宜しければ、ノアを描いて頂けませんでしょうか。\n\n●要望\n最初は海洋生物がモチーフと仰っていたと思いますので、海面や水飛沫、流動的なエネルギー流体などを纏わせたヴィネットイラストをお願います。\n\n●ポージング、全体像\nポージングは重力を振り切って海面から飛び立つエネルギッシュなイメージでお願いします。\n全体像としては青基調の涼し気な雰囲気でお願いします。\n\n●衣装\n衣装は戦闘用ボディのマーク3をお願いします。\nもし仮に表現したい衣装のアイデアが御座いましたら、思うままに筆を走らせて頂けると幸いです。\n\n●表情\n下記URLの1つ目の1枚目や、2つ目のような少々勇ましい表情でお願いします。\n\nhttps://www.pixiv.net/artworks/75070774\nhttps://www.pixiv.net/artworks/80432922\n\nもし余裕御座いましたら、以前バレンタイン的な絵として挙げていた下記URLのような優しい微笑みをこちらに向けているような表情差分をお願いします。\nhttps://x.com/hakoniwatsuka3/status/1095993667901243392?s=20\n\n表情差分はpsdレイヤーで変更出来ると嬉しいです。\n\n●用途\n個人の観賞用のみに用います。\n\n以上、もしお気に召しましたらご検討お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hakoniwatsuka3/works/54", "thumbnail_src": "https://si.imgix.net/21d9c969/uploads/origins/ffc02c80-d01d-4be2-bb21-abb877703ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71cfb23961011d469a2ae6ef9a2087af", "thumbnail_srcset": "https://si.imgix.net/21d9c969/uploads/origins/ffc02c80-d01d-4be2-bb21-abb877703ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71cfb23961011d469a2ae6ef9a2087af, https://si.imgix.net/21d9c969/uploa