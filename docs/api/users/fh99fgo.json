2Ccenter&txtsize=30&txt=PRIVATE&s=dc16ec42207e5d302f8fe75c7260db81 2x, https://si.imgix.net/04f9d30d/uploads/origins/6349d458-eeff-4ecf-a61e-5819e35228eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6394c360a0ce3d7009408f2806be4ad8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fh99fgo/works/92", "thumbnail_src": "https://si.imgix.net/184492d5/uploads/origins/12dc8622-c5f6-45d4-beca-dca787200437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1eb312750a0f6d718ad0b51ac9739257", "thumbnail_srcset": "https://si.imgix.net/184492d5/uploads/origins/12dc8622-c5f6-45d4-beca-dca787200437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1eb312750a0f6d718ad0b51ac9739257, https://si.imgix.net/184492d5/uploads/origins/12dc8622-c5f6-45d4-beca-dca787200437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb98b6bc39c55f5629ff070c104e3764 2x, https://si.imgix.net/184492d5/uploads/origins/12dc8622-c5f6-45d4-beca-dca787200437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6055ba43156b4e5f855581c72a8ff430 3x", "genre": "comic", "nsfw": true, "body": "こんにちわ。\n世界樹の迷宮の女ビーストキングを漫画形式でお願いします。\n(以下参考画像内の、槍を持ったワンピースの女の子)\nhttps://x.com/blmdisk/status/2010035518629916868\n\nシチュエーションは冒険中、ローパーによる触手攻撃で敗北するもので\n①小さめのコマで、背後から近づいていたローパーに、触手で両手を拘束されてしまう。しまった！という表情。\n\n②両手を頭上で拘束され宙に持ち上げられ、ワンピースを胸元まで捲り上げられている状態。\n　露出した飾り気のない白パンツと控えめな胸に吸盤状の触手が貼り付き、エナジードレインされている。\n　「んぁっ！」「あぁんっ！」切なげに喘いでいる表情。\n\n③エナジーを吸い尽くされうつ伏せでぐったりと地面に倒れている状態。\n　気を付けのような四肢をまっすぐ伸ばした体勢で、ワンピースの後ろが捲れて白パンツのお尻が丸見えに。\n　目元は前髪の影で隠れており、絶頂の余韻のように紅潮した頬と涎を垂らしてハァ…ハァ…と荒い吐息を繰り返している。\n\n上記のような３コマ構成で、②と③のコマを大きくメインでお願いします。\nお手数をおかけしますが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@fh99fgo/works/91", "thumbnail_src": "https://si.imgix.net/2af51976/uploads/origins/c8c11fb3-55f7-4ff8-8731-bf5de5cbabc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9785ac6d5f24daf2d6743723abc9ae20", "thumbnail_srcset": "https://si.imgix.net/2af51976/uploads/origins/c8c11fb3-55f7-4ff8-8731-bf5de5cbabc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9785ac6d5f24daf2d6743723abc9ae20, https://si.imgix.net/2af51976/uploads/origins/c8c11fb3-55f7-4ff8-8731-bf5de5cbabc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a89fb7b3f8f383c674051d31eee5bdb4 2x, https://si.imgix.net/2af51976/uploads/origins/c8c11fb3-55f7-4ff8-8731-bf5de5cbabc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f92068958139c40982af87f85064e1d1 3x", "genre": "comic", "nsfw": true, "body": "반갑습니다! 이번에도 더 신청하고자합니다.\n부디 고려해주세요.\n#1\nサシャの分隊と、護衛対象であるプラチナム級の超重要VVIPが初対面する場面。\n分隊長が「そしてこちらが、今回の護衛任務中、あなたをお世話する医務官になります。よろしくお願いいたします」と紹介する。\n退屈そうにタブレットPCを眺めていたVVIPがサシャを見て、\n「そちらの医務官は、俺と同じ車両で移動させろ」と指示する。\n#2\n移動中の車内。最初は太ももに手を置き、軽いタッチで徐々にいやらしい触り方をする。\nサシャは反抗的な、鋭い目つきでVVIPを睨みつけている。\n#3\n車内の狭い空間で、サシャがドア側（窓側または車体側）に強く押し付けられ、後ろから挿入されている構図。\n彼女の体がドアに密着し、VVIPが背後から激しく腰を打ち付ける様子。\nサシャは両手でドアや窓を押さえながら耐え、顔は苦痛と屈辱で歪んでいる。\n抵抗の姿勢が残っているが、力で完全に抑え込まれている状態。\n#4\n目的地到着。サシャが車のドアを開け、よろめきながら降りてくる。\n服装の状態：\nジャケットが片方の肩からずり落ち、肩と鎖骨が大きく露出している。\nシャツは胸元がはだけ、首元から顎にかけて白く粘つく液体（フェラチオ後の精液の痕跡）が垂れた跡がはっきりと残っている。\nスパッツ（またはレギンス・タイツ）は股間部分が大きく濡れて色が変わっており、太もも内側まで液体が垂れた跡が見える（膣内射精後の痕跡）。\n全体的に服が乱れ、髪も大きく崩れ、頬は赤く腫れ気味。\nVVIP：\n「そこの医務官、実に有能だったな。おかげで疲れがすっかり取れたよ。ははっ」", "created_at": "", "completed_at": ""}, {"path": "/@fh99fgo/works/90", "thumbnail_src": "https://si.imgix.net/eb63c001/uploads/origins/4f0bf661-0937-4603-8c57-0debcfc8e35c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=968d0e328084cc78f7d7f92e4cf9d534", "thumbnail_srcset": "https://si.imgix.net/eb63c001/uploads/origins/4f0bf661-0937-4603-8c57-0debcfc8e35c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=968d0e328084cc78f7d7f92e4cf9d534, https://si.imgix.net/eb63c001/uploads/origins/4f0bf661-0937-4603-8c57-0debcfc8e35c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e079a123e8e00fefe066a903b5c04b4 2x, https://si.imgix.net/eb63c001/uploads/origins/4f0bf661-0937-4603-8c57-0debcfc8e35c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d034eda7fa51cb20e8ba54fe13793f62 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fh99fgo/works/89", "thumbnail_src": "https://si.imgix.net/7c76b999/uploads/origins/8e457907-38a0-406a-99d3-f2cd0a3a0c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6027b64ac356ff0b9eaa3740d738327", "thumbnail_srcset": "https://si.imgix.net/7c76b999/uploads/origins/8e457907-38a0-406a-99d3-f2cd0a3a0c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6027b64ac356ff0b9eaa3740d738327, https://si.imgix.net/7c76b999/uploads/origins/8e457907-38a0-406a-99d3-f2cd0a3a0c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f5b8f04c84e0d87dbb276f4e094b09e 2x, https://si.imgix.net/7c76b999/uploads/origins/8e457907-38a0-406a-99d3-f2cd0a3a0c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c1deca51b30565b9788c4480a019bbc 3x", "genre": "art", "nsfw": true, "body": "先日、ウルトラレディ・ジェニスのイラストを依頼した者です。\n素敵な作品をありがとうございました。\n\nもしよろしければ、今回もウルトラレディ・ジェニスのピンチイラストを依頼したいと思います。\n\n○キャラ\n\n・ウルトラレディ・ジェニス\n\n・帰ってきたウルトラマンに登場する、暗殺宇宙人ナックル星人の女体化キャラである、レディ・ナックル(このキャラはシルエットかつ体の一部のみの描写でよいです。一応資料です→\n\nhttps://www.pixiv.net/artworks/107931434)\n\n・用心棒怪獣ブラックキング(こちらもレディ・ナックルと同様にシルエットかつ一部描画で構いません)\n\n\n○シチュ\n\n・こちらの作品\n\nhttps://skeb.jp/@fh99fgo/works/24\n\nのように、背後からブラックキングにM字開脚の体勢で抱え上げられて股を大きく開かされるウルトラレディ・ジェニス。その無防備なジェニスの股間にレディ・ナックルが膝蹴りを叩き込んでいる。\n\n・ジェニスは胸についたカラータイマーが赤く点灯し、ブラとパンツとニーソが破損し穴が空いた状態。表情は涙目で赤面し、痛みと羞恥で悲鳴をあげている。\n\n・背景は前回と同様に、夕暮れ時のイメージで。\n\n以上です。\n是非よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@fh99fgo/works/88", "thumbnail_src": "https://si.imgix.net/bc636653/uploads/origins/51b744e8-2ba0-4a2f-b9a5-36d74c80d589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c94d93e7d587d9362456e75df9883ca2", "thumbnail_srcset": "https://si.imgix.net/bc636653/uploads/origins/51b744e8-2ba0-4a2f-b9a5-36d74c80d589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c94d93e7d587d9362456e75df9883ca2, https://si.imgix.net/bc636653/uploads/origins/51b744e8-2ba0-4a2f-b9a5-36d74c80d589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3c446c74fb84116f9260a6371609bd 2x, https://si.imgix.net/bc636653/uploads/origins/51b744e8-2ba0-4a2f-b9a5-36d74c80d589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b98dd8bc979c7ae90e1ab3324c34e90 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fh99fgo/works/87", "thumbnail_src": "https://si.imgix.net/dac86a6c/uploads/origins/74419f50-ee10-453e-a9fc-cea738849536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbfa5eb4281ee9d3f55985798bcc02bb", "thumbnail_srcset": "https://si.imgix.net/dac86a6c/uploads/