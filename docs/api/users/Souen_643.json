eb3a4-eade-4638-a3f3-a008501ffa57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adfc026835942b5569ff047030a2094c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n戦場のフーガ」のメルローのアートをお願いしたいのですが。\n\nありがとうございます。\n\nメルロの参考文献：https://static.wikia.nocookie.net/forlittletail/images/c/c5/Merlot.png/revision/latest?cb=20210810073542\nhttps://imgur.com/a/DiqTunA", "created_at": "", "completed_at": ""}, {"path": "/@Souen_643/works/8", "thumbnail_src": "https://si.imgix.net/eaaf9f9e/uploads/origins/484a3309-64b2-44f4-a0fd-d32e33efec2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f33278fe059427579c46811070ccd3fd", "thumbnail_srcset": "https://si.imgix.net/eaaf9f9e/uploads/origins/484a3309-64b2-44f4-a0fd-d32e33efec2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f33278fe059427579c46811070ccd3fd, https://si.imgix.net/eaaf9f9e/uploads/origins/484a3309-64b2-44f4-a0fd-d32e33efec2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=074fd5e1749a929af18cdada31f11b8a 2x, https://si.imgix.net/eaaf9f9e/uploads/origins/484a3309-64b2-44f4-a0fd-d32e33efec2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83bb8f8435d053486e0dfc832e1a97f4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n戦場のフーガ」のプレッツェルの絵をお願いします。彼はパジャマを着ています。ちょっと眠そうです。\n\nありがとうございました。\n\n彼のスタンダードなイメージ：\nhttps://static.wikia.nocookie.net/forlittletail/images/1/12/Pretzel.png/revision/latest?cb=20210810072932\n\n参考\nhttps://pbs.twimg.com/media/FvvD7xkacAEdFVz?format=jpg&name=medium\nhttps://pbs.twimg.com/media/FvvD8fbacAE3J2X?format=jpg&name=medium", "created_at": "", "completed_at": ""}, {"path": "/@Souen_643/works/7", "thumbnail_src": "https://si.imgix.net/773a2eff/uploads/origins/6540047b-c680-4b62-92a1-8f90f01c4823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2aecfa50d1cfca9c3a0c0fd2e6893703", "thumbnail_srcset": "https://si.imgix.net/773a2eff/uploads/origins/6540047b-c680-4b62-92a1-8f90f01c4823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2aecfa50d1cfca9c3a0c0fd2e6893703, https://si.imgix.net/773a2eff/uploads/origins/6540047b-c680-4b62-92a1-8f90f01c4823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ce8ac3516aa400f321be9fa7a919178 2x, https://si.imgix.net/773a2eff/uploads/origins/6540047b-c680-4b62-92a1-8f90f01c4823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f22d3aa73a3ddd6e45e7963b2a240b9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Souen_643/works/6", "thumbnail_src": "https://si.imgix.net/fc476189/uploads/origins/e92f363e-1717-46bc-9597-9d76ed8b584c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3187c6f9121c7dc3b75be0ec448b456", "thumbnail_srcset": "https://si.imgix.net/fc476189/uploads/origins/e92f363e-1717-46bc-9597-9d76ed8b584c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3187c6f9121c7dc3b75be0ec448b456, https://si.imgix.net/fc476189/uploads/origins/e92f363e-1717-46bc-9597-9d76ed8b584c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=015e7c46fe1fe858c0857fac8f11b011 2x, https://si.imgix.net/fc476189/uploads/origins/e92f363e-1717-46bc-9597-9d76ed8b584c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23abf48f676e8a319a77b6622e42e8c2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのシルビオンの描き方が大好きです！\n\nこのため、私は彼女のリボンに包まれた彼女のスターリーフィアンセミッズと私のシルベオンドルシを含むリクエストをしたいと思いますルシは愛情を込めて小鳥の顔を舐める？\n\nルシが小鳥の顔を舐めるとき、ミディ自身は可愛らしくもふもふしていて、舐められるのを少し怖がっているような、どこかお腹を空かせたような態度で舐めるのです！\n\nルシの参考文献：https://www.deviantart.com/stash/0eohcttjpv9\n\nミディ参照：https://www.deviantart.com/stash/0104gav69b22\n\nもしできるのであれば、それは素晴らしいことです！ありがとうございます！<3", "created_at": "", "completed_at": ""}, {"path": "/@Souen_643/works/5", "thumbnail_src": "https://si.imgix.net/7cddf25f/uploads/origins/3877034a-ad92-4362-a8db-c8a56a057b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f3e16eccf1b4e74bffd7be937a866f", "thumbnail_srcset": "https://si.imgix.net/7cddf25f/uploads/origins/3877034a-ad92-4362-a8db-c8a56a057b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f3e16eccf1b4e74bffd7be937a866f, https://si.imgix.net/7cddf25f/uploads/origins/3877034a-ad92-4362-a8db-c8a56a057b82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1bf7e1a777051260ce7e36fb9dadfb6 2x, https://si.imgix.net/7cddf25f/uploads/origins/3877034a-ad92-4362-a8db-c8a56a057b82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26017def3737c75088de1c1019c28024 3x", "genre": "art", "nsfw": false, "body": "こんにちは^^また依頼したいです^^。\n\n私のアイデアは、私のダークルギグアのキャラクターが作ったシャドーボールの上で、私の小さなキャラクター、ライチュウがサーカスの芸をするというものです＾＾。\nダークルギガはそれを面白そうに見ていて、こう言うんだ：「シャドーボールは面白い動きだって言っただろ？\nライチュウはシャドーボールをとても楽しんでいるようだ。\n私の2人のキャラクターのサイズ差はかなり大きいので、ダークルギアは床に寝そべっているように描くことができます^^。\nhttps://imgur.com/a/Nv8ZC6Z。\nまた、シャドーボールはこんな感じです。https://imgur.com/a/fmwnEvQ\n\nありがとうございました！^^", "created_at": "", "completed_at": ""}, {"path": "/@Souen_643/works/4", "thumbnail_src": "https://si.imgix.net/524e7491/uploads/origins/a0b93f5d-16e7-4f18-b7ac-41c5cdc1d5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a97dc23e5d927a699c314a0a15f3f9", "thumbnail_srcset": "https://si.imgix.net/524e7491/uploads/origins/a0b93f5d-16e7-4f18-b7ac-41c5cdc1d5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a97dc23e5d927a699c314a0a15f