completed_at": ""}, {"path": "/@Souen_643/works/12", "thumbnail_src": "https://si.imgix.net/e7f413ee/uploads/origins/4b35d039-14e8-4262-a36b-618f514f54c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943272afc05715d624015fb4c916a061", "thumbnail_srcset": "https://si.imgix.net/e7f413ee/uploads/origins/4b35d039-14e8-4262-a36b-618f514f54c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943272afc05715d624015fb4c916a061, https://si.imgix.net/e7f413ee/uploads/origins/4b35d039-14e8-4262-a36b-618f514f54c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c50d50f2143436e7a52ccfe77e281d45 2x, https://si.imgix.net/e7f413ee/uploads/origins/4b35d039-14e8-4262-a36b-618f514f54c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=065d03bca1c97737d88748ae183c4e24 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nもしよろしければ、この子を描いていただけませんか？\n構図、表情、ポーズなどは好きに描いていただければと思います！\n※毛は頭の後ろ(角などでほぼ見えない時もあります)から背中～尻尾までも繋がっています\n※翼は背から離れて空中に浮いています\n\nhttps://drive.google.com/drive/folders/1ounb-XskAMGAX7XYe1L-6mnu8-HnNfyR?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Souen_643/works/11", "thumbnail_src": "https://si.imgix.net/6f4587cb/uploads/origins/2de3de5e-f4a7-473e-b76e-b211cf0cc237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52da05fc63bbba41dcc119418a49f050", "thumbnail_srcset": "https://si.imgix.net/6f4587cb/uploads/origins/2de3de5e-f4a7-473e-b76e-b211cf0cc237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52da05fc63bbba41dcc119418a49f050, https://si.imgix.net/6f4587cb/uploads/origins/2de3de5e-f4a7-473e-b76e-b211cf0cc237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faf2f8eb34ba6b55460c0f17c5251654 2x, https://si.imgix.net/6f4587cb/uploads/origins/2de3de5e-f4a7-473e-b76e-b211cf0cc237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50177d603373