人です🐰🐰\n冬なので、\n雪が降っている中、手を繋いでいる二人を描いていただけないでしょうか？\n表情、構図、お任せします！\nイラストにはありませんが、女性のほうに黄色のマフラー、男性のほうに緑色のマフラーを着用させてくれると嬉しいです。（資料参照）\n白い方は男性で、身長が173cm、褐色のほうが女性で、身長が192cmです！\nどうぞよろしくお願いします！\n\nhttps://www.dropbox.com/scl/fo/knxh7e87ljwzdewotb5nr/h?dl=0&rlkey=hp5k18mzi6jmrcho7gzm61kza", "created_at": "", "completed_at": ""}, {"path": "/@misosirukk/works/13", "thumbnail_src": "https://si.imgix.net/c4543166/uploads/origins/ed8f3958-5e91-40ac-9b17-d69822995377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53d1365337f149b7a04c3278614c96b1", "thumbnail_srcset": "https://si.imgix.net/c4543166/uploads/origins/ed8f3958-5e91-40ac-9b17-d69822995377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53d1365337f149b7a04c3278614c96b1, https://si.imgix.net/c4543166/uploads/origins/ed8f3958-5e91-40ac-9b17-d69822995377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad25c21863cd6736ff8262b834db97ad 2x, https://si.imgix.net/c4543166/uploads/origins/ed8f3958-5e91-40ac-9b17-d69822995377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86c64b9d571dc7df642cbfd33ce0d1df 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@misosirukk/works/12", "thumbnail_src": "https://si.imgix.net/23d59bd1/uploads/origins/5d71d3e7-e530-4027-b7da-83836e6ffc14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ad91e3ebadacbc19e36d62232fcc39", "thumbnail_srcset": "https://si.imgix.net/23d59bd1/uploads/origins/5d71d3e7-e530-4027-b7da-83836e6ffc14?bg=%23fff&auto=format%2Cco