るようになるという設定でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sweetZAKE/works/3", "thumbnail_src": "https://si.imgix.net/bec8d673/uploads/origins/deabd279-004c-4f5a-9c02-cfff3bb3ed47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19c49fae8bd0db1bc26bce72ab83ddae", "thumbnail_srcset": "https://si.imgix.net/bec8d673/uploads/origins/deabd279-004c-4f5a-9c02-cfff3bb3ed47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19c49fae8bd0db1bc26bce72ab83ddae, https://si.imgix.net/bec8d673/uploads/origins/deabd279-004c-4f5a-9c02-cfff3bb3ed47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f53c8f10ff3e290e15b8d8e7b15e210 2x, https://si.imgix.net/bec8d673/uploads/origins/deabd279-004c-4f5a-9c02-cfff3bb3ed47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24e780157de38346a5761f0f4aa988a8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sweetZAKE/works/2", "thumbnail_src": "https://si.imgix.net/4afe3aa8/uploads/origins/aaccb44f-a250-422d-8307-281c3ba6ec1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef60275b4a7b660d7ec433c70f28a89c", "thumbnail_srcset": "https://si.imgix.net/4afe3aa8/uploads/origins/aaccb44f-a250-422d-8307-281c3ba6ec1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef60275b4a7b660d7ec433c70f28a8