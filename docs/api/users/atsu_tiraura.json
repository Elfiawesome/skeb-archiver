ix.net/4fcc9daa/uploads/origins/73c7faa0-f877-49b9-b133-2d205da821bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d814cac7541b50816cd9ad9bd9d0010f, https://si.imgix.net/4fcc9daa/uploads/origins/73c7faa0-f877-49b9-b133-2d205da821bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90fdc38a30d75892fe2233ef41245a70 2x, https://si.imgix.net/4fcc9daa/uploads/origins/73c7faa0-f877-49b9-b133-2d205da821bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7327d3eca09fdff554843de032c30d7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@atsu_tiraura/works/14", "thumbnail_src": "https://si.imgix.net/11191b05/uploads/origins/083f8d76-b22c-4d28-9d25-a09972d7692d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d76f677e8c28053cb04d530529c1a4ff", "thumbnail_srcset": "https://si.imgix.net/11191b05/uploads/origins/083f8d76-b22c-4d28-9d25-a09972d7692d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d76f677e8c28053cb04d530529c1a4ff, https://si.imgix.net/11191b05/uploads/origins/083f8d76-b22c-4d28-9d25-a09972d7692d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=038252a6fbd280f8d37f676324261254 2x, https://si.imgix.net/11191b05/uploads/origins/083f8d76-b22c-4d28-9d25-a09972d7692d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f517b75862be696af269cc10631988b0 3x", "genre": "art", "nsfw": false, "body": "あなたの完璧な仕事ぶりを見て、できればもう一回、私のOCゲームで細部を変更したCGの依頼をお願いしたいと思っています。\n\nサイズ:4000×1984(参考までにもっと大きくてもOKです。また、この参考サイズは前回描いていただいたものと同じです。)\n\n温室(ガラスハウス)の草原が舞台です。\n\nキャラクター：シャン・シアン\nキャラクター詳細\n黒髪に土色のハイライト\n口を閉じると片側の虎歯が見える。\n左耳から顔にかけて傷がある。\nノースリーブのジャンパーを肌身離さず着ている。\n手首から腕にかけて黒い刺青、右手の甲に赤い目の刺青。\n血のように赤い渦巻きの目（丸い目）と赤いアイシャドー。\n左の耳垂...肩まで垂れる立方体の耳垂。\n手の甲のタトゥーは目、腕のタトゥーは麒麟。\n\n山仙は魔力を抜くために、何者かに茎蔓と麒麟に絡め取られる。\n彼は従うしかない。\n小さな蔓が無理やり彼の口に入り、口を開けさせ、コートは半脱ぎにされ、絹糸に体を支配される。\n誰かの手が彼の顎に触れ、彼を翻弄する。\n\n変化\n釣られて動揺するシャンシャン。\n汗をかいて痛がる。\n目のピントが合いにくくなり、ハイライトがなくなる。\n\nわかりにくかったら、レイヤーを変えて描いてみてください。\nその他の参考資料や解説はURLの中にあります。ご確認ください！\nリクエストありがとうございました！\n\nhttps://drive.google.com/drive/u/0/folders/1BRsmuOILZTq0IYN1s68YeQlke0N3Sfp3", "created_at": "", "completed_at": ""}, {"path": "/@atsu_tiraura/works/13", "thumbnail_src": "https://si.imgix.net/eb996405/uploads/origins/d646e5d2-a2f1-4f2a-9e6d-723df4cd8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d51311e2a3d3dcf236777951f00f6d4", "thumbnail_srcset": "https://si.imgix.net/eb996405/uploads/origins/d646e5d2-a2f1-4f2a-9e6d-723df4cd8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d51311e2a3d3dcf236777951f00f6d4, https://si.imgix.net/eb996405/uploads/origins/d646e5d2-a2f1-4f2a-9e6d-723df4cd8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=545c9170951fb4893e3f2931e3a338e3 2x, https://si.imgix.net/eb996405/uploads/origins/d646e5d2-a2f1-4f2a-9e6d-723df4cd8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=979df8db3f49f9dfb2d58c13f7ab0e43 3x", "genre": "art", "nsfw": false, "body": "OCゲームで細部を変更したCGの依頼をしたいと思っています。\n必要サイズ：2048×1412(参考までにもっと大きくてもOKです。)\n水晶で覆われた洞窟が舞台です。\nキャラクター：XUAN\nキャラクター詳細：①髪：上半火红色短发+下半橙红色短发+拖长长几缕不过腰橙色头发，发尾ؐ变冰蓝色\nXUANは油断していたので、邪悪な煙の中でアザミやイバラに巻き込まれてしまった。CGで彼の奮闘ぶりを表現している。\n変化：①あざみといばらに巻き込まれ、驚く玄瑛②あざみといばらに火の魔法を使うが、効かない③あざみといばらにどんどん支配され、心や思考まで支配される④あざみといばらに支配され、目も当てられない玄瑛。\nわかりにくければ、このような表現をレイヤーを変えて描けばいい。\nその他の参考資料はURLにあります。\nリクエストありがとうございました！\n\nhttps://drive.google.com/drive/u/0/folders/1BRsmuOILZTq0IYN1s68YeQlke0N3Sfp3", "created_at": "", "completed_at": ""}, {"path": "/@atsu_tiraura/works/12", "thumbnai