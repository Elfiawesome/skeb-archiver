t": ""}, {"path": "/@oniku_ucha/works/1", "thumbnail_src": "https://si.imgix.net/0fb2babc/uploads/origins/0f6cb93d-df7c-40af-82de-66a8cc439e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b87d8da98b5bd78b33d6f2ec7ea8e3a", "thumbnail_srcset": "https://si.imgix.net/0fb2babc/uploads/origins/0f6cb93d-df7c-40af-82de-66a8cc439e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b87d8da98b5bd78b33d6f2ec7ea8e3a, https://si.imgix.net/0fb2babc/uploads/origins/0f6cb93d-df7c-40af-82de-66a8cc439e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2dcbff851064af2a4c388c97f9f3039 2x, https://si.imgix.net/0fb2babc/uploads/origins/0f6cb93d-df7c-40af-82de-66a8cc439e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13e81daf42ae8bbf0c21dba503fc89bc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵はとてもかわいくて好きです。ポケモン関連の絵しか描かないのかわかりませんが、もしそうなら遠慮なくリクエストを拒否してください。\n\nルカのコスプレをしているルキナの絵が欲しいです。\nポーズは自由で、太ももが見えるようにしてください。\nルキナの左目にはエンブレムがあるので、それを意識してください。\n\n読んでくれてありがとう\nhttps://drive.google.com/drive/folders/1Z9Di7Kuz5GgrS4vh_cDQg3S90EqoVXYg", "created_at": "", "completed_at": ""}]}