ix.net/60c6dcaf/uploads/origins/23eb09b0-0fd8-4ebf-8001-5492d7ed2022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684c511a9659ef170ac1ef3e278d1609", "thumbnail_srcset": "https://si.imgix.net/60c6dcaf/uploads/origins/23eb09b0-0fd8-4ebf-8001-5492d7ed2022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684c511a9659ef170ac1ef3e278d1609, https://si.imgix.net/60c6dcaf/uploads/origins/23eb09b0-0fd8-4ebf-8001-5492d7ed2022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82959414d9fccc8c6fa57823aa2cb520 2x, https://si.imgix.net/60c6dcaf/uploads/origins/23eb09b0-0fd8-4ebf-8001-5492d7ed2022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd7455edfefeeecc8ad580e66759d857 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私のVTuberキャラクターの絵をお願いしたいのですが。\n彼女は人間の耳を持っていて、サキュバスの角、翼、尾を持っています。\n\nどんなポーズ、服装、表情でも自由に描いてください。\nセクシーでも生意気でも何でも。\n\nDiscordやBlueskyなどのSNSで使いたい。\n参考画像はURLにて！\n\nhttps://drive.google.com/file/d/1yEW9cGqXvnV6CtpQ13xpwU858gkmAzon/view", "created_at": "", "completed_at": ""}, {"path": "/@daeyama/works/66", "thumbnail_src": "https://si.imgix.net/65cee95a/uploads/origins/61386e65-805c-4bd4-9595-a13ca56933ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c27d18a1db222c53044239082e8313d0", "thumbnail_srcset": "https://si.imgix.net/65cee95a/uploads/origins/61386e65-805c-4bd4-9595-a13ca56933ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c27d18a1db222c53044239082e8313d0, https://si.imgix.net/65cee95a/uploads/origins/61386e65-805c-4bd4-9595-a13ca56933ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bde72a96d0bbf649b87514d7d42ef6fc 2x, https://si.imgix.net/65cee95a/uploads/origins/61386e65-805c-4bd4-9595-a13ca56933ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7325614335ee6d81b36612684a0c412 3x", "genre": "art", "nsfw": true, "body": "だえ先生、こんばんは！！\nいつも可愛いらしいイラストを描いていただき本当にありがとうございます！！\n麻奈ちゃんのこちらのイラスト(https://skeb.jp/@daeyama/works/64)が本当に良すぎるので、さらなる追加差分をお願いしたいです！！\n\n追加の要望はこちらを参考にお願いします「参考:https://drive.google.com/drive/folders/1BtYDYQNO_vOdaU2UBvnyqLD1bZL6cHwG?usp=drive_link」\n前回のpsdの中身で使える部分はそのまま残した状態で追加分の新規構図をレイヤーわけでまとめてpsdを希望します\n※構図的に追加差分が難しければ新規構図又はキャンセルしていただいて構いません\n\n完成したイラストは個人観賞用として楽しみたいと思っています\nご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/141A8oZVGXXQBYCPKpyr4by4h5WYP-bEm?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@daeyama/works/65", "thumbnail_src": "https://si.imgix.net/c76934f2/uploads/origins/3d65be21-02d6-4e7c-87d0-9bd1c2f4fe28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea571b8a27e2cbcf3a0600709ee71439", "thumbnail_srcset": "https://si.imgix.net/c76934f2/uploads/origins/3d65be21-02d6-4e7c-87d0-9bd1c2f4fe28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea571b8a27e2cbcf3a0600709ee71439, https://si.imgix.net/c76934f2/uploads/origins/3d65be21-02d6-4e7c-87d0-9bd1c2f4fe28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbff7f38e4ee889c053f2cf698c6aff7 2x, https://si.imgix.net/c76934f2/uploads/origins/3d65be21-02d6-4e7c-87d0-9bd1c2f4fe28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e91937c35b9e50f2bd959ea48da8354 3x", "genre": "art", "nsfw": true, "body": "だえ先生、こんにちは\nいつも可愛らしいイラストをありがとうございます！！\nせっかくのリクエスト手数料無料期間中なので追加リクエストをお願いしたいと思いました\n\n今回リクエストしたいお題は「うちの子と毎晩の日課」です\n\nキャラクター参考(参考:https://drive.google.com/drive/folders/1y4WLEO_nf9o8rg-Kny8Uh7ROAiEszNnU?usp=drive_link)\n\nイラストの構図はこちらを参考にお願いします(参考:https://drive.google.com/drive/folders/1YAV6cZcMYZA_4m4oMjzNYhzAFMrMlI0W?usp=drive_link)\nイラストはいつものようにエロゲ風な横向きで１枚のpsdに差分描写をレイヤー分けでまとめていただきたく思います\n※汁は前回描いていただいたような感じの描写で希望\n\nシチュエーションの補足として、帰宅してお風呂や夕食も済ませて２人だけの時間を過ごすという何気ない日常の流れというシチュエーションです\n\n完成したイラストは個人観賞用として楽しみたいと思っています\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@daeyama/wor