る。\n\n射精直前のキスが特に好きなので、ポーズが許せばそれも入れてください。\n\n差し支えないかわかりませんが、追加で3つの配慮をお願いしたいです！無理なら無視してください！\n\nもしペニスが隠れるようなポーズを選んだ場合は、ペニスの位置がわかるようなアウトラインを入れてください！\n\nどっちがフタナリでも睾丸を隠せるようにしてほしい！\n\n卵子が精細胞に囲まれているところを見たい！\n\n(卵子が精子に囲まれているところを見てみたい！（卵子が女の子の心配そうな顔をしていたら、なおいい）。\n\nご検討ありがとうございました！また、何かありましたら調整してください！", "created_at": "", "completed_at": ""}, {"path": "/@yuuno2010/works/36", "thumbnail_src": "https://si.imgix.net/8c929ba5/uploads/origins/d695e5f9-3cee-41aa-9bc5-d31159a2ea03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37e5f1d03c592f610bf60dd7c5345eef", "thumbnail_srcset": "https://si.imgix.net/8c929ba5/uploads/origins/d695e5f9-3cee-41aa-9bc5-d31159a2ea03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37e5f1d03c592f610bf60dd7c5345eef, https://si.imgix.net/8c929ba5/uploads/origins/d695e5f9-3cee-41aa-9bc5-d31159a2ea03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8dd76ad06bb6e2b78cb98186a0f9665 2x, https://si.imgix.net/8c929ba5/uploads/origins/d695e5f9-3cee-41aa-9bc5-d31159a2ea03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=615d8acd4729345d16959bfc95f8be1c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuuno2010/works/35", "thumbnail_src": "https://si.imgix.net/d4d17adc/uploads/origins/db3bd3b1-c1c9-4c96-a294-d822fc5bffa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2b5724a94ce4ec5285b3a9f7d829bf", "thumbnail_srcset": "https://si.imgix.net/d4d17adc/uploads/origins/db3bd3b1-c1c9-4c96-a294-d822fc5bffa9?bg=%23fff&auto