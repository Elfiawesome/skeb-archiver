fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db06c73606fad06630b9d53891ec7604", "thumbnail_srcset": "https://si.imgix.net/825f4ceb/uploads/origins/1e07ba21-f049-464a-8763-58ec815f875d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db06c73606fad06630b9d53891ec7604, https://si.imgix.net/825f4ceb/uploads/origins/1e07ba21-f049-464a-8763-58ec815f875d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=984649e6da41f62f670d9a405d551819 2x, https://si.imgix.net/825f4ceb/uploads/origins/1e07ba21-f049-464a-8763-58ec815f875d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0853b3a0cbae0a68c4a582bfa677cc6f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@harusamex_/works/2", "thumbnail_src": "https://si.imgix.net/5ac6fd8b/uploads/origins/9a98798b-e76b-4cab-8251-68b54d5bd151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a77f96d4b7ad4b5eaa97c3279d9c026", "thumbnail_srcset": "https://si.imgix.net/5ac6fd8b/uploads/origins/9a98798b-e76b-4cab-8251-68b54d5bd151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a77f96d4b7ad4b5eaa97c3279d9c026, https://si.imgix.net/5ac6fd8b/uploads/origins/9a98798b-e76b-4cab-8251-68b54d5bd151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e621c46fb8e9d212bab65f162b428be 2x, https://si.imgix.net/5ac6fd8b/uploads/origins/9a98798b-e76b-4cab-8251-68b54d5bd151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ec624818528d1c7a849d91c9691fc75 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n素敵なアピールをいただきありがとうございます。\n青日晴様の絵柄がとても好みですので、\n是非うちの子を描いてもらえると嬉しいです。\n\n◆使用用途\ntwitter等SNSでの使用\n\n◆三面図・キャラ参考資料\nhttps://x.com/silas_012/status/1624678045637550083?s=20\n\n表情やポージングなどは基本的にすべてお任せします！\n（どちらかというと頭身高めの方が見てみたいです）\n服装もご自由にお任せしますので、お好みのアレンジを頂けると嬉しいです。\n\n◆納品\nPSDとPNG形式\n（PSDを扱うソフトがないため、PNG形式も併せて納品頂けると助かります）\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://x.com/silas_012/status/1624678045637550083?s=20", "created_at": "", "completed_at": ""}, {"path": "/@harusamex_/works/1", "thumbnail_src": "https://si.imgix.net/eb3d3344/uploads/origins/399048f3-6509-44da-828b-dedd0671b4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd5f81749c1504118cd721b7c7b334b", "thumbnail_srcset": "https://si.imgix.net/eb3d3344/uploads/origins/399048f3-6509-44da-828b-dedd0671b4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd5f81749c1504118cd721b7c7b334b, https://si.imgix.net/eb3d3344/uploads/origins/399048f3-6509-44da-828b-dedd0671b4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13dcb18802ea3397dad8fe16cf092033 2x, https://si.imgix.net/eb3d3344/uploads/origins/399048f3-6509-44da-828b-dedd0671b4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce6bc620485f91c992cc8ae1e73a1ea8 3x", "genre": "correction", "nsfw": false, "body": "はじめまして、天天と申します。 \n　以前、別サイトにてイラスト制作をお願いし、今回はアドバイスと言う形で依頼をお願いしました。\n　小説同人誌の表紙のアドバイスをお願いします。\n\n【小説同人誌】\n・刀剣乱舞…創作男審神者とnot審神者女性\n【キャラ関係】\n・男性(右上/着物)…審神者。女性の実兄。常に和服で歌仙兼定に育てられる。審神者としては優秀だけど、お兄ちゃん経験が皆無。\n・女性(左下/洋服)…一般人。男性の妹。兄とは生まれて一度も会った事がない。休日に本丸の手伝いに来てくれる。しっかり者だけど天然。\n【悩み】\n・構図がありきたり。二人は審神者と一般人で対照的な存在、という構図が表現できない。\n・タイトル位置に迷う。Pixivの講座を参考にしているが、しっくりこない。\n・塗り(黒髪の影の付け方に毎度四苦八苦する。レイヤーを無駄に使ってしまう)\n\n　支部やTwitterでの青日晴先生の作品に毎度癒され、以前の作品も私の宝物です。自分ももっと自身の作品を表現したいと思い、今回スケブをお送りさせていただきました。\n　初めてのSkebということで、拙い点もございますが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1Ka1jW7IT91nrtV3RecaN_TIN3EubMriu/view?usp=sharing", "created_at": "", "completed_at": ""}]}