4d94-a2d5-35bbe48b5475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75741833dde82e5673abd3a2ce44abb8", "thumbnail_srcset": "https://si.imgix.net/5b0bc902/uploads/origins/dd7acb48-0ba9-4d94-a2d5-35bbe48b5475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75741833dde82e5673abd3a2ce44abb8, https://si.imgix.net/5b0bc902/uploads/origins/dd7acb48-0ba9-4d94-a2d5-35bbe48b5475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82f26c9bbf6bdba67d71aa914f712947 2x, https://si.imgix.net/5b0bc902/uploads/origins/dd7acb48-0ba9-4d94-a2d5-35bbe48b5475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a162829d546067e9c671a40bdfdff0f 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n\nうちのメルルートちゃんを描いていただきたくてご依頼しました！\nポーズ＆構図の指定はないので、可愛く描いて貰えれば嬉しいです！\n\n↓参考資料\nhttps://twitter.com/_meruruto_/status/1567473177647026176?s=20&t=9wUOHq_ADrjs3CGIrN4F-g", "created_at": "", "completed_at": ""}, {"path": "/@sake_cyan/works/3", "thumbnail_src": "https://si.imgix.net/081e973a/uploads/origins/cdfa7ce0-5451-46f7-9740-6f8273e1d4f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59c83f48478fb9ae6c45ca173084bc4", "thumbnail_srcset": "https://si.imgix.net/081e973a/uploads/origins/cdfa7ce0-5451-46f7-9740-6f8273e1d4f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59c83f48478fb9ae6c45ca173084bc4, https://si.imgix.net/081e973a/uploads/origins/cdfa7ce0-5451-46f7-9740-6f8273e1d4f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bc7da587145b506bef5896099b4a041 2x, https://si.imgix.net/081e973a/uploads/origins/cdfa7ce0-5451-46f7-9740-6f8273e1d4f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa3b67cc13ec40155c38b8eb2909176e 3x", "genre": "art", "nsfw": false, "body": "鮭の孫様、はじめまして。Twitter上のイラスト拝見させていただき、とても素敵だったので、リクエストした次第です。\nオリキャラを描いていただきたく存じます。キャラ設定は趣味で女装しているメイド（男の娘）です。\n\n■外見\n・15～18歳くらい\n・青緑髪のメカクレ\n・身長150後半\n・体格は「ほぼ女の子」\n\n■衣装\n・メイド服（肌が出ているのは肩のみ、メイドカチューシャ有、エプロン部分はスカート前方のみ）\n・ランガードありの黒パンスト（20デニールくらいの薄め）\n・白の長手袋（シルクやサテンのスベスベした生地）\n・靴はハイヒール\n・上記の点を抑えていただければ元デザインからアレンジいただいて構いません\n\n■ポーズ・シチュエーション\n・鮭の孫様にお任せします\n\nどうぞご検討宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/v4qljmp4jsoljl4givk71/h?dl=0&rlkey=wqwsx72crvkal4l9m8aog9at7", "created_at": "", "completed_at": ""}, {"path": "/@sake_cyan/works/2", "thumbnail_src": "https://si.imgix.net/a5e2db18/uploads/origins/8a60a22a-4b43-40ac-b9fb-bf43a38d605d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa47e967441037283d667e7f866fc7ee", "thumbnail_srcset": "https://si.imgix.net/a5e2db18/uploads/origins/8a60a22a-4b43-40ac-b9fb-bf43a38d605d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa47e967441037283d667e7f866fc7ee, https://si.imgix.net/a5e2db18/uploads/origins/8a60a22a-4b43-40ac-b9fb-bf43a38d605d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a144691c35538d12a8c9cd8b0307f630 2x, https://si.imgix.net/a5e2db18/uploads/origins/8a60a22a-4b43-40ac-b9fb-bf43a38d605d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b981f6f35fe2607740be588516a2ee6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の2つのキャラクターを描くことをお願いしたいです。\nディー: https://toyhou.se/13942451.dee/gallery\nとFelix: https://toyhou.se/16472212.felix/gallery\n彼らはボーイフレンドです。ディーは自信満々で、軽薄で自惚れ屋。フェリックスはやわらかく、すぐに照れてしまう。ポーズはお任せします!\n\nリクエストに応えていただき、ありがとうございました。<3", "created_at": "", "completed_at": ""}, {"path": "/@sake_cyan/works/1", "thumbnail_src": "https://si.imgix.net/9e6877c6/uploads/origins/db27cdd5-c422-4b01-bac0-61df822ba390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f472a393cf5b00f707001b7d73b28e", "thumbnail_srcset": "https://si.imgix.net/9e6877c6/uploads/origins/db27cdd5-c422-4b01-bac0-61df822ba390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f472a393cf5b00f707001b7d73b28e, https://si.imgix.net/9e6877c6/uploads/origins/db27cdd5-c422-4b01-bac0-61df822ba390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e04d2a3ec22494a15d1efb6c266b0bb7 2x, https://si.imgix.net/9e6877c6/uploads/origins/db27cdd5-c422-4b01-bac0-61df822ba390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bf5a420869ef29c57876a50386d9a7e 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n\n新着から先生のち〇かわアイコンに惹かれて見つけました！\nうちの子を描いていただきたくてリクエストさせていただきました。\nTwitterのアイコン/ヘッダー、Twitchの画面等に使用したいと思っています。\n主にゲーム配信をしています。\n\n▶キャラクター：\n個性：だらしない、やる気が出ない、いつもつかれてる・眠たさそうだけど一生懸命がんばってるふんわりの女の子です\nヘア：ピンク、ぱっつん、姫カット、長め。\n髪型（お団子、ツインテール、ハーフアップ、巻き髪などなど）はおまかせします。\n可能であれば寝ぐせがついてる/ボサ髪な感じでお願いします！\n衣装：ピンクｘ黒メインで、\nゆるゆる/かわいい/地雷系のどれかだと嬉しいです！（おまかせします）\nもし靴が入っている場合、厚底でお願いします！\n靴下はレース、網タイツ、なしでも大丈夫です、おまかせします。\nアクセ、ピアス、ネイル、目の色なども自由です、おまかせします。\n特徴：特にございません。タピオカ、リボンや薔薇が好きですが、必須ではありません。\n可能であれば何かしらの形でうちマスコットちゃんも入れてもらえると嬉しいです。\n（マスコット風/アクセ風/そのまま等はおまかせします。アルバムをご参照ください。）\n\n▶構図・背景：\nおまかせします！かわいいふわふわ感じだと嬉しいです。\n\n▶納品形式：\nPSDでサイン、背景・キャラ等は別レイヤーと\nPNG背景ありと透過版どっちもいただけると大変助かります！\n\n▶参考になるかわかりませんが、好みはこんな感じです！\n地雷系、かわいい系にする場合：https://twitter.com/me_ch4_/status/1264173488752877568\nhttps://twitter.com/me_ch4_/status/1208025363139289088?s=19\n\nゆるゆるにする場合、肩出しセーターでお願いします。\n\nどうかご検討のほどよろしくお願いいたします...！\n\nhttps://drive.google.com/drive/folders/1yB_RzfqxQXy6TmoZECOInnDnRG_XUNx_?usp=sharing", "created_at": "", "completed_at": ""}]}