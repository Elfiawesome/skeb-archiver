334-4738-be16-2cb002c6cb8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f68daecec2cf54e5883d88274d17348c 2x, https://si.imgix.net/bebc22a2/uploads/origins/e9ccdd5e-b334-4738-be16-2cb002c6cb8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1bd60448dc506c8149bfee06f6aa0f5 3x", "genre": "art", "nsfw": false, "body": "シャムさん、こんにちは。\n\n今回もエセフィアの作品をお願いします。\n今回は、マイクを持って元気に歌っているエセフィアを希望します。\n\nこのポーズに似ているのはこちら\n(1) https://drive.google.com/file/d/1yujcDcuqp2czl5dXETKgS0NOJjWQwVzk/view?usp=sharing\n\nこのドライブの中には、私が実現したいヘアスタイルのヘアリファレンスが含まれており、ヘア01、ヘア02、ヘア03と記されています。リファレンスシートのヘアはもう正確ではないので、短いヘアスタイルはぜひ残しておきたいですね。\n(2) https://drive.google.com/drive/folders/17BWVpp3xniYfezdoE7ZBpuF4NYO8TAMB?usp=sharing\n\nできれば全身でお願いします\nこのポーズとは逆のポーズにしたいので、二人が後ろに立っているのもかっこよく見えるかもしれません。\n(3) https://drive.google.com/file/d/1-cKiWxRxVsIq9pagea6X6BAkPZT-BRIr/view?usp=sharing\n\nありがとうございました。頑張ってください!\n\nhttps://drive.google.com/drive/folders/17BWVpp3xniYfezdoE7ZBpuF4NYO8TAMB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Shamu_0520/works/45", "thumbnail_src": "https://si.imgix.net/c52cfd07/uploads/origins/d0e7268f-b219-4f35-a43f-252b7d443ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3442ba653925951d47661f752294cbd9", "thumbnail_srcset": "https://si.imgix.net/c52cfd07/uploads/origins/d0e7268f-b219-4f35-a43f-252b7d443ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3442ba653925951d47661f752294cbd9, https://si.imgix.net/c52cfd07/uploads/origins/d0e7268f-b219-4f35-a43f-252b7d443ced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92035b225de86c59644d9f5672069041 2x, https://si.imgix.net/c52cfd07/uploads/origins/d0e7268f-b219-4f35-a43f-252b7d443ced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f0e372767c957507dab48069ce2751b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。絵がとても素敵だと思いご連絡させていただきました。\nこの度NijisanjiENのLuxiem「Jazz on the clock」のカバーをしたいと考えているのですが、ドライブに格納している５人のOCをそれぞれ jazz on the clock 1&2の衣装に着せて描いて頂けないでしょうか。\nそれぞれ５人のOCの立ち絵を格納していますが、Vbloomグループ衣装の特徴を元に描いて頂ければ幸いです（髪型やタトゥー等）\n動きのあるポーズで描いて頂けますか？（参考と同じでも別でも大丈夫です！）\n\n人物や背景をレイヤー分けしていただけますと幸いでございます。\n\n＊なるべく文字のレイヤーを分けてください\n\n※イラストはSNSへの掲載・YouTube&Twitch配信サムネイルでの利用を考えています。\n\nお忙しい中大変恐縮ですが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nVMVfS1c-kjngt9mqI55nyYnq_OSSXtK?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Shamu_0520/works/44", "thumbnail_src": "https://si.imgix.net/889933d0/uploads/origins/f04a253b-e39d-46aa-811a-e74a2a120244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6716a969447bc3871c95dfb732d042e", "thumbnail_srcset": "https://si.imgix.net/889933d0/uploads/origins/f04a253b-e39d-46aa-811a-e74a2a120244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6716a969447bc3871c95dfb732d042e, https://si.imgix.net/889933d0/uploads/origins/f04a253b-e39d-46aa-811a-e74a2a120244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bc83a75682912766f6d5b956337a35d 2x, https://si.imgix.net/889933d0/uploads/origins/f04a253b-e39d-46aa-811a-e74a2a120244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1334887e87a0b033e64ab1eeaa2d865b 3x", "genre": "art", "nsfw": false, "body": "この前はリクエスト受けて頂きありがとうございました。\n今回は前回のイラストの裏面を描いてもらいたくリクエストさせて頂きました。\n\n服装はランジェリーを着させて頂きたいです。https://drive.google.com/file/d/1sGulzexBLe6hbzRYe8oDHn84y15_VftY/view?usp=drivesdk\nこのような感じので、色味は大人っぽさを出したいので青から水色のグラデーションにしてもらいたいです。\nhttps://drive.google.com/file/d/1kzC0br2QLvnKhHPMxYDVvkNVP2_ijDDa/view?usp=drivesdk\n画像の下の方の色味が1番近いので、雰囲気とか見ながら変えていただいても大丈夫です。\nアクセサリーとして、月とか星など元立ち絵イメージの物を入れてもらえると嬉しいです。\nまた、リボン要素を入れてもらいたいのですが出来れば手首をリボンで縛ってもらえると嬉しいですが難しければアクセサリーの位置づけで付けで描いていただくか体に絡まってるくらいで大丈夫です。\nhttps://drive.google.com/file/d/15XLxFR4xuJKL6VbcrnVAUE4dJsmZMDEL/view?usp=drivesdk\n画像のようにガッツリでなくていいのでお願いします。\n\n表情ですが、涙目で恥ずかしがってる感じの「こっち見るな！」みたいな感じでよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Shamu_0520/works/43", "thumbnail_src": "https://si.imgix.net/07874f92/uploads/origins/9d85529d-7dc3-4431-8527-b70a90b03475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29e75bd2c055fd090b1630296c448cc4", "thumbnail_srcset": "https://si.imgix.net/07874f92/uploads/origins/9d85529d-7dc3-4431-8527-b70a90b03475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29e75bd2c055fd090b1630296c448cc4, https://si.imgix.net/07874f92/uploads/origins/9d85529d-7dc3-4431-8527-b70a90b03475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=637516987892fcd029e2ec8ea8d68626 2x, https://si.imgix.net/07874f92/uploads/origins/9d85529d-7dc3-4431-8527-b70a90b03475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd679d222b575b9aa954bf86956e7e58 3x", "genre": "art", "nsfw": false, "body": "Shamuさん、こんにちは。\n\nいつも芸術的な才能をありがとうございます。今日のリクエストのテーマは \"イチゴのデザートと一緒にエセフィアのデート\"\n\nリンク先の資料を参考に、カジュアルな服装で登場予定です。「服装01はジャンパースカート、服装02は首に巻いたシルクのスカーフがモチーフです。スカーフの色は同じでピンクですが、参考文献の柄は不要です。  \n\n色は全てキャラクター参考書と同じにし、スピーカーのヘアクリップはそのままにしてください。服装は、もっと素敵に見えると思えば、細部を追加したり変更したりしても大丈夫です！ =)\n\n参考ポーズを載せておきます。テーブルの上にあるイチゴパフェのデザートも入れてください表情は、目を開けた柔らかい笑顔と、目を閉じた幸せそうな笑顔の2種類をお願いします。\n\nPSDファイルではキャラクターのレイヤーも分けてください :)\n\nShamuさん、ありがとうございました。いつも通り、よろしくお願いします✊✨\n\nhttps://drive.google.com/drive/folders/11UWYOYU_Qto9p-YEPSqdztJ4WNwRQfJv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Shamu_0520/works/42", "thumbnail_src": "https://si.imgix.net/450e1339/uploads/origins/cbd902ca-cbfc-4e4c-98fc-7d25876dd656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e50246c0b2269cbf5433ad641aa7ee6", "thumbnail_srcset": "https://si.imgix.net/450e1339/uploads/origins/cbd902ca-cbfc-4e4c-98fc-7d25876dd656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e50246c0b2269cbf5433ad641aa7ee6, ht