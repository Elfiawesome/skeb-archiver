01-50996beecd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d315a22d60b71724182c07906fb56d6a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sakyuu/works/4", "thumbnail_src": "https://si.imgix.net/88fb388e/uploads/origins/e83cb7da-c05a-4f12-8138-e645c388c682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb601c22068542bdde17326d3f8476b", "thumbnail_srcset": "https://si.imgix.net/88fb388e/uploads/origins/e83cb7da-c05a-4f12-8138-e645c388c682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb601c22068542bdde17326d3f8476b, https://si.imgix.net/88fb388e/uploads/origins/e83cb7da-c05a-4f12-8138-e645c388c682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbb79d683130bb7cc67949e2ad2a9686 2x, https://si.imgix.net/88fb388e/uploads/origins/e83cb7da-c05a-4f12-8138-e645c388c682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=024c971faadc1c15e9a0642b4a391074 3x", "genre": "art", "nsfw": true, "body": "育ちゃん依頼者です！\nくすぐりシーン、めちゃくちゃ良かったです！\nありがとうございます！！\n素晴らしかったので追加でご依頼させてください！\nファーストIVが好評で、２作目の撮影時にさらに過激なことをされてしまうという内容でお願いします。\n最初の撮影がちゃんと出来ていたから安心したプロデューサーが、今回も撮影スタッフに任せてしまい、内緒でイタズラされてしまうという感じ。\n今回は、スタッフのお兄さんとプロレス遊びをすることに。\n「プロレスだから、パンツ一枚になってね」と言われて恥ずかしがりながらも下着姿に。\n体格の良いお兄さんと体を密着させてプロレスをすることに。\n擬似セックス的な撮影をされてしまう。\n股間に男性の股間を押し付けられ、また変な感覚がやってくる。\n怖がる育ちゃんに「好きな人のこと考えたら気持ちよくなるよ」とスタッフが言う。\n育ちゃんは、いつも頼りになるプロデューサーが大好きなので、プロデューサーのことを考えると、自分から腰を振ってしまい、イッてしまう。\nまたお漏らしをしてしまったと恥ずかしがる育ちゃんに、「お兄さんもオシッコするから大丈夫だよ」と言われ、お顔に射精される。\nというイメージでいかがでしょうか。\nあくまで案なので、変更していただいてもかまいません。", "created_at": "", "completed_at": ""}, {"path": "/@sakyuu/works/3", "thumbnail_src": "https://si.imgix.net/9bbb8d65/uploads/origins/f97f81bf-b85d-4326-8b5f-c8dbe2d95d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f434ea57da04cd127ec85a7174befd1", "thumbnail_srcset": "https://si.imgix.net/9bbb8d65/uploads/origins/f97f81bf-b85d-4326-8b5f-c8dbe2d95d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f434ea57da04cd127ec85a7174befd1, https://si.imgix.net/9bbb8d65/uploads/origins/f97f81bf-b85d-4326-8b5f-c8dbe2d95d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23b7735f4f391a75a2d3c236270b31d7 2x, https://si.imgix.net/9bbb8d65/uploads/origins/f97f81bf-b85d-4326-8b5f-c8dbe2d95d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8b8d45606258b8dea64d424844ab9e9 3x", "genre": "art", "nsfw": true, "body": "はじめまして。もし良ければ、デレマスの遊佐こずえが温泉上がりに浴衣に着替えているところを足の指先までの全身画で、出来れば髪は下ろした状態でお願いします。\n浴衣の下はパンツ1枚でお願いします。浴衣の柄は紅葉温泉(黄色い方の浴衣)と同じものでお願いします。パンツの色はおまかせします。\n\n※無理ならキャンセルしても構いません。", "created_at": "", "completed_at": ""}, {"path": "/@sakyuu/works/2", "thumbnail_src": "https://si.imgix.net/99396ba8/uploads/origins/5ec97483-2f33-4a1d-8717-8d9157ad5e10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2732700260bce4cdd4643f2d8ea2561c", "thumbnail_srcset": "https://si.imgix.net/99396ba8/uploads/origins/5ec97483-2f33-4a1d-8717-8d9157ad5e10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2732700260bce4cdd4643f2d8ea2561c, https://si.imgix.net/99396ba8/uploads/origins/5ec97483-2f33-4a1d-8717-8d9157ad5e10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb56cdc35e10c31e2c487f4b51ce20fb 2x, https://si.imgix.net/99396ba8/uploads/origins/5ec97483-2f33-4a1d-8717-8d9157ad5e10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac9b980eafaf785cac98033392c6a6fe 3x", "genre": "art", "nsfw": true, "body": "ミリマスの方でもよろしいでしか？\n中谷育ちゃんの、ちょっとエッチなイメージビデオというイメージで描いていただけませんか？\nPが他の仕事がバッティングして見守れなくて、Pが不在なのを良いことに予想以上に際どいイメージビデオに出演させられてしまった感じです。\nパンチラとかを無意識のうちに映されていて、クライマックスはくすぐりゲーム。\n男性スタッフさんにスカートをめくり上げられておパンツ越しにワレメまでこすられちゃったり、乳首をいじられちゃったり。\n育ちゃんも初めての絶頂をしちゃう。\nでも、絶頂したことが分かっていなくて、むしろお漏らししちゃったと思い健気にもスタッフさんに謝罪。\n良い子な育ちゃん。\nなお、後日発売されたイメージビデオからは、過激すぎるシーンはカットされていた模様（実はスタッフが自分で鑑賞するために撮った）。\nお漏らししたのは恥ずかしくてPに言えなかった育ちゃんはホッとしたのでした。\nというような内容で漫画で描いてくださると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@sakyuu/works/1", "thumbnail_src": "https://si.imgix.net/b053e372/uploads/origins/6905268a-519c-4d47-abd1-058af00fd57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff26ad8a481bd5641318ae008cfa2df8", "thumbnail_srcset": "https://si.imgix.net/b053e372/uploads/origins/6905268a-519c-4d47-abd1-058af00fd57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff26ad8a481bd5641318ae008cfa2df8, https://si.imgix.net/b053e372/uploads/origins/6905268a-519c-4d47-abd1-058af00fd57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=871497c74f9281b464ca0e7f923a3142 2x, https://si.imgix.net/b053e372/uploads/origins/6905268a-519c-4d47-abd1-058af00fd57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6293e650d93db97f07668854a25b2c2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}