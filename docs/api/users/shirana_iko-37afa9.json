=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38fd824d2aaf096a2caa56010e2ed174 2x, https://si.imgix.net/7839980d/uploads/origins/4196534d-b1b2-4c24-a56a-ec884a3eff96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e7514c0e52c642fa5cc5f3372f3b23b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のVtuberのアートをお願いしたいのですが、蛾の女の子です！同じキャラクターですが、蛾の耳と短い髪と羽があります！どんなポーズにするかはあなた次第です！サムネイルに使うので、pngでもお願いできますか？\n\nhttps://drive.google.com/drive/folders/1NtuK8gMmXkoNabQny2xf9h974xXNIYtZ?usp=drive_link\n参考資料のドライブリンクです！ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/212", "thumbnail_src": "https://si.imgix.net/35e47da7/uploads/origins/a41f4236-e0b4-4682-b0ef-5a9088963bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc4271534efb183b54285a7fa187723e", "thumbnail_srcset": "https://si.imgix.net/35e47da7/uploads/origins/a41f4236-e0b4-4682-b0ef-5a9088963bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc4271534efb183b54285a7fa187723e, https://si.imgix.net/35e47da7/uploads/origins/a41f4236-e0b4-4682-b0ef-5a9088963bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cd47335a775bff2dde34e4f52d09265 2x, https://si.imgix.net/35e47da7/uploads/origins/a41f4236-e0b4-4682-b0ef-5a9088963bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=934228b671c54eeea5253a38e1867d7e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクター \"アニス \"のリデザインをお願いしたいです。彼女はかつてスパイや暗殺者として働いていたが、ライバル組織のせいで所属していた組織が崩壊してしまった。復讐を果たした後、彼女は新しい主人に忠誠を誓った。\n\n彼女は西洋文化と東洋文化がシームレスに融合した世界に住んでいる。私は、彼女が現代的な服装の要素を取り入れたくノ一の服を着ているのではないかと考えていた。\n\nポーズと構図はあなた次第！\n\nご検討ありがとうございました！\n\nhttps://www.deviantart.com/stash/01pi2z7l47cu", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/211", "thumbnail_src": "https://si.imgix.net/a3779ad3/uploads/origins/09db55b0-a97f-4aaa-8968-2a00f57f6530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbc2e99f4702dc5e93c546a67c405813", "thumbnail_srcset": "https://si.imgix.net/a3779ad3/uploads/origins/09db55b0-a97f-4aaa-8968-2a00f57f6530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbc2e99f4702dc5e93c546a67c405813, https://si.imgix.net/a3779ad3/uploads/origins/09db55b0-a97f-4aaa-8968-2a00f57f6530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd814d8b7e12d6a0b614ba008475881 2x, https://si.imgix.net/a3779ad3/uploads/origins/09db55b0-a97f-4aaa-8968-2a00f57f6530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8f2c168a804116a7af1af2d949a73b8 3x", "genre": "art", "nsfw": false, "body": "あなたの素晴らしいアートを拝見し、ぜひドローイングをお願いしたいと思いました！私のVtuber \"Woodbruh \"のための絵です。彼は人間の木の男の子です。性格はフレンドリーでリラックスしています。ポーズや感情はお任せします^^。\nできれば透過ファイルもお願いします！  よろしくお願いします！\n\nhttps://www.dropbox.com/scl/fo/6tg6763lkhfyytt1ridn6/AO0mCuuc9LVwcMFJ_FTX3AU?rlkey=4yldxkrg5v2pbq7xp9afpcg08&st=s7movzrl&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/210", "thumbnail_src": "https://si.imgix.net/d261a36d/uploads/origins/e9c9c7d3-0e6f-4d37-b117-242fcb622f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=952afb010c2279a8bccb5b0e910533cd", "thumbnail_srcset": "https://si.imgix.net/d261a36d/uploads/origins/e9c9c7d3-0e6f-4d37-b117-242fcb622f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=952afb010c2279a8bccb5b0e910533cd, https://si.imgix.net/d261a36d/uploads/origins/e9c9c7d3-0e6f-4d37-b117-242fcb622f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=208b656d871463de0bc7377eb9ce9c68 2x, https://si.imgix.net/d261a36d/uploads/origins/e9c9c7d3-0e6f-4d37-b117-242fcb622f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bc423e912226bc07d73d49540dfc4cf 3x", "genre": "art", "nsfw": false, "body": "私のキャラクターを描いていただけませんか？ポーズにこだわりはありません。よろしくお願いします！\n\nhttps://imgur.com/a/8Rp07N4", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/209", "thumbnail_src": "https://si.imgix.net/59557849/uploads/origins/d22e60a0-a49c-4233-8c82-174591200705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa6320006b3177c90f1d6916fa3a84e", "thumbnail_srcset": "https://si.imgix.net/59557849/uploads/origins/d22e60a0-a49c-4233-8c82-174591200705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa6320006b3177c90f1d6916fa3a84e, https://si.imgix.net/59557849/uploads/origins/d22e60a0-a49c-4233-8c82-174591200705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53e6df16c0f6160605e3af0fb0ee054f 2x, https://si.imgix.net/59557849/uploads/origins/d22e60a0-a49c-4233-8c82-174591200705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0391d8a1a91db27c77cd4b389f67806a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！キャラクターをお願いしたいです！\nラフスケッチしかないんですが、大丈夫でしょうか？\n隠れ悪の有名アイドルです。彼女の全身像を描いていただけませんか？ポーズは自信と笑顔があればなんでもいいです。\nスケッチではわかりにくいかもしれませんが、彼女の爪とジュエリーは銀色に輝いています。お好みでジュエリーを追加することもできます。\n袖は薄いフィッシュネット。\n彼女の目にはわざと虹彩や瞳孔がありません。彼女の顔のドットは銀色の輝きで、おそらく彼女の体の他の部分にもあるはずだ。\n最後に、ドレスはシンプルですが、もっと面白くしたいのであれば、ご自由にどうぞ！\n長文になりましたが、よろしくお願いします！\n\nhttps://drive.google.com/file/d/16Pfiz4bx_csbNrukDuX2mLwxZ5MnueZm/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/208", "thumbnail_src": "https://si.imgix.net/8a7a2264/uploads/origins/369533b0-9954-4aa2-84dd-ade4bb68b0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a573a980c834e692d045fa47e9c8538", "thumbnail_srcset": "https://si.imgix.net/8a7a2264/uploads/origins/369533b0-9954-4aa2-84dd-ade4bb68b0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a573a980c834e692d045fa47e9c8538, https://si.imgix.net/8a7a2264/uploads/origins/369533b0-9954-4aa2-84dd-ade4bb68b0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22999d859bbe3fbe4864e0a301ac6bf8 2x, https://si.imgix.net/8a7a2264/uploads/origins/369533b0-9954-4aa2-84dd-ade4bb68b0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7726f4271b5245191b55df495264048e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またまた依頼の依頼です！\n\n僕のVtuberのSpidershiiと友達のキャラクターのNepを一緒に描いて欲しいです！https://www.deviantart.com/stash/0ylslbrt0wi。\n\n\nご検討ありがとうございました！この絵はTwitterやTwitchなどのSNSで使わせていただきます！\n\nスパイダーシイ：https://www.deviantart.com/stash/21swcwsdl1r0\nそしてネップ：https://www.deviantart.com/stash/21tglb00jran", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/207", "thumbnail_src": "https://si.imgix.net/c3d35b93/uploads/origins/3744d8a5-e75e-4135-84ab-b42a801d3402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea37a07a20fda69e3d1d77a2bc19a077", "thumbnail_srcset": "https://si.imgix.net/c3d35b93/uploads/origins/3744d8a5-e75e-4135-84ab-b42a801d3402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea37a07a20fda69e3d1d77a2bc19a077, https://si.imgix.net/c3d35b93/uploads/origins/3744d8a5-e75e-4135-84ab-b42a801d3402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5aa64018b95503a3477a5294d616e617 2x, https://si.imgix.net/c3d35b93/uploads/origins/3744d8a5-e75e-4135-84ab-b42a801d3402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ce55668e5c9f00fd8cd042c912fdc80 3x", "genre": "comic", "nsfw": false, "body": "また会ったね！\n\n四月馬鹿のために、君に短いマンガを描いてもらいたかったんだ！\n\nピンク色の液体が入ったビーカーを温めて、その液体が割れて自分の上で爆発し、その結果、自分がクレイジーな女性になってしまうというものです。\n\nもし彼女が添付のリンクのような髪型で、同じような笑顔だったら最高だ！胸は中くらいで、ジーンズではなくレギンスをはいている。目はなるべく隠して、黄色い目が少し覗く程度に。鋭い歯と狂気がポイント！\n\n\nありがとうございました！\n\n髪と笑顔\nhttps://imgur.com/a/GW0noFy\n\n参考資料\nhttps://drive.google.com/file/d/1CJOGvRf9w_6avLw9RJMlOQ1keiBkY7cK/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@shirana_iko/works/206", "thumbnail_src": "https://si.imgix.net/2