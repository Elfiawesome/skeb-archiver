-16T07:27:16.530542+00:00"}, {"amount": 34000, "recorded_at": "2026-02-23T21:41:18.746796+00:00"}, {"amount": 27000, "recorded_at": "2026-02-24T11:56:43.642042+00:00"}, {"amount": 13000, "recorded_at": "2026-02-25T05:35:01.758620+00:00"}, {"amount": 26000, "recorded_at": "2026-02-25T12:25:44.573447+00:00"}]}, "current_prices": {"art": 16000, "correction": 22000, "comic": 26000}, "price_range": {"art": {"min": 9000, "max": 21000}, "correction": {"min": 9000, "max": 22000}, "comic": {"min": 13000, "max": 34000}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@cerauniae", "name": "cerauniae"}, {"label": "Website", "url": "https://twipla.jp/events/552291", "name": ""}], "flags": {"from_archive": true}, "acceptable": false, "works": [{"path": "/@cerauniae/works/31", "thumbnail_src": "https://si.imgix.net/b355a553/uploads/origins/f9dc41b9-67e2-40a2-af24-debddc7bd849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ada2a16c5cd3244a93d492850ad4be97", "thumbnail_srcset": "https://si.imgix.net/b355a553/uploads/origins/f9dc41b9-67e2-40a2-af24-debddc7bd849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ada2a16c5cd3244a93d492850ad4be97, https://si.imgix.net/b355a553/uploads/origins/f9dc41b9-67e2-40a2-af24-debddc7bd849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87b5382954f0b979f6006340f3aa0d15 2x, https://si.imgix.net/b355a553/uploads/origins/f9dc41b9-67e2-40a2-af24-debddc7bd849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b44beca002c486313053398e2a0adcb 3x", "genre": "art", "nsfw": true, "body": "こんにちはリクエストいたします。\n\nキャラ：金潟 すぐみ（アリス・ギア・アイギス）\n服装：コンパニオン/AF\n体位：M字開脚またはエロ蹲踞でディルドをずらし挿入しダブルピース\n　　　　ファスナーをおろし胸を露出\n\nシチュエーション\nすぐみが自分で造形した極太ディルドを使用しながらノリノリで紹介している\n\n以上です、ご検討宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/30", "thumbnail_src": "https://si.imgix.net/ed07179e/uploads/origins/726950e5-f55e-4ec7-81a3-c31a4eb28ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b88b0133e809872c5b6d9a5260f2ef2", "thumbnail_srcset": "https://si.imgix.net/ed07179e/uploads/origins/726950e5-f55e-4ec7-81a3-c31a4eb28ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b88b0133e809872c5b6d9a5260f2ef2, https://si.imgix.net/ed07179e/uploads/origins/726950e5-f55e-4ec7-81a3-c31a4eb28ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26d30ee6c1faa4b0be5c9b28feef5617 2x, https://si.imgix.net/ed07179e/uploads/origins/726950e5-f55e-4ec7-81a3-c31a4eb28ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a37e0e97062336e9953a8a66c8612e5d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/29", "thumbnail_src": "https://si.imgix.net/9513887a/uploads/origins/fcd8b1b9-290c-41e1-8d99-59ed2803d79c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97df4111da8fa18eb305bec021f0848", "thumbnail_srcset": "https://si.imgix.net/9513887a/uploads/origins/fcd8b1b9-290c-41e1-8d99-59ed2803d79c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97df4111da8fa18eb305bec021f0848, https://si.imgix.net/9513887a/uploads/origins/fcd8b1b9-290c-41e1-8d99-59ed2803d79c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb03116584677b1b8955c5cb314044e5 2x, https://si.imgix.net/9513887a/uploads/origins/fcd8b1b9-290c-41e1-8d99-59ed2803d79c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2f798a80cfbaf60a02fac9686c5cf6 3x", "genre": "art", "nsfw": true, "body": "けらどん様\n\nアリスギアより九炉鉄 悠都をリクエストいたします\n\n●服装に特に指定はございません。ドスケベだと思う衣装がございましたらお願いいたします\n●気持ちよさそうな表情で馬との激しい交尾を楽しんでいます\n　馬は悠都ちゃんの膣穴を壊す勢いでピストンしています\n●https://skeb.jp/@cerauniae/works/19\n　上記のような体位で、真横からの視点で片足を上げて結合部をカメラに見せつけるようにしており、片手はピースサインをしています\n●乳首とクリにはピアスが付いています\n●もし差分が可能でしたらボテ腹状態での交尾差分をお願いしたいです\n　その際は乳首などが黒く色素沈着していると嬉しいです\n　※もし可能でしたら、標準サイズのボテ腹と三つ子でも入ってるかのような巨大なボテ腹の２種類を希望したいです\n\n以上でございます\n大変お忙しいかと思いますが、何卒ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/28", "thumbnail_src": "https://si.imgix.net/897ae8a7/uploads/origins/1f81ec94-a282-4c39-bfbf-74793e891e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6841bd064a3855f5691dd36d731306b3", "thumbnail_srcset": "https://si.imgix.net/897ae8a7/uploads/origins/1f81ec94-a282-4c39-bfbf-74793e891e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6841bd064a3855f5691dd36d731306b3, https://si.imgix.net/897ae8a7/uploads/origins/1f81ec94-a282-4c39-bfbf-74793e891e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa08e12ac047a72afd4e7a1bfbeb9c12 2x, https://si.imgix.net/897ae8a7/uploads/origins/1f81ec94-a282-4c39-bfbf-74793e891e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01cba6d6b1247b23e8c90be49db647db 3x", "genre": "art", "nsfw": true, "body": "籠目さん全裸乱交接待をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/27", "thumbnail_src": "https://si.imgix.net/7e38b66c/uploads/origins/239a4825-db98-4496-ab6f-92bb27e04a45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed98ccddd6787dbf7f2164890e56b2", "thumbnail_srcset": "https://si.imgix.net/7e38b66c/uploads/origins/239a4825-db98-4496-ab6f-92bb27e04a45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed98ccddd6787dbf7f2164890e56b2, https://si.imgix.net/7e38b66c/uploads/origins/239a4825-db98-4496-ab6f-92bb27e04a45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddc011b9fa4d4a5fb5f1ece85a6dedfc 2x, https://si.imgix.net/7e38b66c/uploads/origins/239a4825-db98-4496-ab6f-92bb27e04a45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5d52884d82d29e8ba45c6534d769f06 3x", "genre": "art", "nsfw": true, "body": "こんにちは初めてリクエストいたします。\n\nキャラ\n君影唯（アリス・ギア・アイギス）\n\nシチュエーション\n映画撮影で複数の戦闘員と屋外でセックスしている状況\n\n詳細\n・衣装：全裸またはアリアスーツ\n・体位：騎乗位\n・映画撮影が終わり群衆から「ハーモナイザーの映画楽しみにしてます」等の声援を受けて\n　騎乗位のまま笑顔でダブルピースして声援にこたえている。\n\n以上です、ご検討宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/26", "thumbnail_src": "https://si.imgix.net/343c83aa/uploads/origins/b464d941-2c47-4711-94f0-72e1dbaef760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56df458459b47172331e9ff5faf8af94", "thumbnail_srcset": "https://si.imgix.net/343c83aa/uploads/origins/b464d941-2c47-4711-94f0-72e1dbaef760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56df458459b47172331e9ff5faf8af94, https://si.imgix.net/343c83aa/uploads/origins/b464d941-2c47-4711-94f0-72e1dbaef760?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9deb9080e9046c99796546818ee8b6f 2x, https://si.imgix.net/343c83aa/uploads/origins/b464d941-2c47-4711-94f0-72e1dbaef760?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cad882cae9f84216027214b58bf67c2f 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。いつもと違う依頼で恐縮ですがぜひ描いて頂きたいシチュエーションがありますのでリクエストさせて頂きます\nキャラクター：ゲーム「ゴシックは魔法乙女」の「リリー（資料URL及び以下のリンク先も参考にしてください。https://gomaotsu.jp/index_character?otome%5B%5D=%E3%83%AA%E3%83%AA%E3%83%BC&otome_sub%5B%5D=&otome_sub%5B%5D=&otome_sub%5B%5D=&otome_sub%5B%5D=&radioSortmethod=character_id&radioOrder=desc）」\n衣装:ゲーム内イベントの甘ロリ水着（資料URL参照）。\nシチュエーション：主人公を悪魔の人質に取られ、要求としてセクシーな写真の被写体になる…というゲーム内のトンチキイベントがあったのですが、その時に「眼鏡を外したくなかったので、代わりに水着の肩紐をずらす」エピソードがあったようです。そのR-18版で「眼鏡を外す代わりに水着をずらして胸とアソコを見せつけながら撮影のためにポーズを取る」シーンをお願いします（ポーズ詳細はお任せします）。表情は事務的で、「眼鏡を外してと言われましたが勿論断りました。その代わりに水着をずらして○○○を見せましたよ」的な文面のメッセージウィンドウを入れて下さい。\nその他細かい点はお任せします。内容が多くて恐縮ですが、ご検討の程宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/115yEgkMwr05u12feRy7gjeKJJfG3mX23?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/25", "thumbnail_src": "https://si.imgix.net/c9afd833/uploads/origins/35521af8-6461-4a79-b890-b4c82d912ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90a21653460679fe0329b425b0bc6f8", "thumbnail_srcset": "https://si.imgix.net/c9afd833/uploads/origins/35521af8-6461-4a79-b890-b4c82d912ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90a21653460679fe0329b425b0bc6f8, https://si.imgix.net/c9afd833/uploads/origins/35521af8-6461-4a79-b890-b4c82d912ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1d4c471cb28bc07a96f7c3c35cdff44 2x, https://si.imgix.net/c9afd833/uploads/origins/35521af8-6461-4a79-b890-b4c82d912ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea953af0c0f47358d14c4830d346f797 3x", "genre": "art", "nsfw": true, "body": "けらどん様\n\nアリスギアより蛙坂 来弥をリクエストいたします\n\n●服装は★４ファクタースーツですが、少し改造されて乳と股間部が丸出しになるように切り取られています\n（腰や籠手、スネ当てなどのメカ部分は省略して構いません）\n●構図とポーズは正面からの視点で、エロ蹲踞で股間部を見せつけるように片手はピースサインをしています\n●「にひひっ」とした感じでエロいことに抵抗はありません\n●股間部は”くぱぁ”されています\n●乳首とクリにはピアスが付いています\n●もし差分が可能でしたら以下の差分もあると嬉しいです\n①膣穴に男性器の挿入差分＋別の男性器を舌先でチロチロ差分\n　※描写頂くのは男性器のみで、男の体自体は無しで大丈夫です\n②臨月のように大きくなったボテ腹差分\n\n以上でございます\nビッチに、それでいて来弥ちゃんらしく楽しそうな感じだと嬉しいです\n大変お忙しいかと思いますが、何卒ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/24", "thumbnail_src": "https://si.imgix.net/57df1ca9/uploads/origins/5eb8a655-a57c-4d8b-bcf0-2ebf1afafb59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a3c8ed205bd0648b0e02d22dbec0ad", "thumbnail_srcset": "https://si.imgix.net/57df1ca9/uploads/origins/5eb8a655-a57c-4d8b-bcf0-2ebf1afafb59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a3c8ed205bd0648b0e02d22dbec0ad, https://si.imgix.net/57df1ca9/uploads/origins/5eb8a655-a57c-4d8b-bcf0-2ebf1afafb59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e11bb500d155cfb67e75a10c4d78b018 2x, https://si.imgix.net/57df1ca9/uploads/origins/5eb8a655-a57c-4d8b-bcf0-2ebf1afafb59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3f2041e2e76b92eae6c5030945b9ea8 3x", "genre": "art", "nsfw": true, "body": "始めまして、アリスギアアイギスから相庭世那ちゃんをお願いします。\n【シチュエーション】\nノーブルガレルースを着用してたらコラボイベント的なゲートで異世界に飛ばされてしまい、\nゴブリンに捕まってしまい輪姦されている。\n鎖つき首輪を嵌められ、衣装は少しボロボロという感じで描いて頂ければ嬉しいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/23", "thumbnail_src": "https://si.imgix.net/5196ee47/uploads/origins/f297c475-2ed9-423d-85d7-0628685646d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592d311377c65a8a4e110ef2882dd132", "thumbnail_srcset": "https://si.imgix.net/5196ee47/uploads/origins/f297c475-2ed9-423d-85d7-0628685646d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592d311377c65a8a4e110ef2882dd132, https://si.imgix.net/5196ee47/uploads/origins/f297c475-2ed9-423d-85d7-0628685646d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba5b8a3abd8b41533c41de8d1d007af0 2x, https://si.imgix.net/5196ee47/uploads/origins/f297c475-2ed9-423d-85d7-0628685646d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b98bc5a521f6b49eb17e4c097686857 3x", "genre": "art", "nsfw": true, "body": "アリスギアアイギス、イア・レトナのnsfwイラストをお願いします\n通常時のショートヘアverで☆4衣装の股のところがラインに沿ってぱっくり開いている服装\n通常時の表情で簡易ベッドの上で竿役に足を広げられ正常位で犯されている構図で挿入前、挿入中、性器が抜かれ精液があふれている状態の3シーンをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@cerauniae/works/22", "thumbnail_src": "https://si.imgix.net/d562a10d/uploads/origins/b08c7ee9-5666-4f35-a8cb-dd98931bf063?bg=%23fff&auto=format%2Ccompres