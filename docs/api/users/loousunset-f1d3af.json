813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9952941b1aa5a98752013504caeddfd0 2x, https://si.imgix.net/8f60744b/uploads/origins/ff5a1cd9-fa15-402d-b813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d85332909c7ce4f91420d7cd958d8d26 3x", "genre": "art", "nsfw": false, "body": "素敵なイラスト拝見しリクエストさせていただきました\nTRPGに使用する等身の全身イラストをお願いできませんか？\n\n資料のイメージからどちらの顔、髪型、色を選んでいただいても構いませんし、お任せで好きな子をデザインしていただいても構いません！\nポーズもお任せします\n\n背景透過PNGまたはPSDをお願いします。\n\n使用用途\nTRPG立ち絵\n個人観賞用印刷\n\nどうぞご検討お願いします\n\nhttps://drive.google.com/drive/folders/1-Zhp6nGMIpBMyTqeorwF2W6qUM-S9BYi", "created_at": "", "completed_at": ""}, {"path": "/@loousunset/works/1", "thumbnail_src": "https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ff90e481a85ed3e092d3d0879b87013", "thumbnail_srcset": "https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ff90e481a85ed3e092d3d0879b87013, https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f99bc0ae875280728107090f1ca08e00 2x, https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1876397d235167096d891316ecd249db 3x", "genre": "comic", "nsfw": true, "body": "こんにちは！\n今回はわたしのオリジナルキャラクター「銀」と「白金」のボーイズラブ漫画をお願いしたいです。\nそれぞれのキャラクターについては銀はこちらのツイートリンクのぷらいべったー( https://twitter.com/elements_oo/status/1435798009501995013?s=46&t=wFe76gGQioGO2XC8GzHJzw )、白金はこちらのツイートリンクのぷらいべったー( https://twitter.com/elements_oo/status/1440683546465619976?s=46&t=wFe76gGQioGO2XC8GzHJzw )をご参照ください。\n内容は自分のアイディアにない銀と白金のボーイズラブストーリーが読みたいので、お任せします。カップリングの左右に関しましても、こだわりや苦手はないので描きたいと思ったものを描いてください。R表現のぬるさもそら様にお任せします。\nストーリーお任せが難しければ、拙作のボーイズラブ小説( https://twitter.com/elements_oo/status/1445004360132403210?s=46&t=wFe76gGQioGO2XC8GzHJzw )がございますので、この作品のどこか気に入ったシーンやよかったと思うシーンを漫画化してください。\n\n作画について、色はモノクロで大丈夫です。仮にカラーをつけるとしても、簡易なもので構いません。背景も簡易なものか、目立つコマのみでも構いません。ゆる〜くいちゃいちゃしてる二人が見たいです。明るいネタでも暗いネタでも大好きですので、どちらでもお好きな方を描いてください。\n\n他に解釈の資料となるものに関してこちら( https://twitter.com/elements_oo/status/1574691917526609921?s=46&t=wFe76gGQioGO2XC8GzHJzw )や、こちら( https://twitter.com/elements_oo/status/1588671755144802304?s=46&t=wFe76gGQioGO2XC8GzHJzw )をご参照ください。また、当方苦手な性癖は一切ないので、何をぶつけても大丈夫です。描きやすいように描いていただければと思います。", "created_at": "", "completed_at": ""}]}