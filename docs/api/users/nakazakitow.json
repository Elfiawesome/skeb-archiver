ャラクターと一緒というのはもしかしたら問題があるかもしれませんので\nダメな場合はそのままキャンセルしていただけたらと思います\n\nいしたにさんのポイントですが\n・私と同じ猫のVtuberです\n・私と違いしっぽがあります\n・髪型の特徴としてツインテールがウェーブして肩にかかっています\n・衣装は完全一致でなくて大丈夫です（参考画像が小さいので…）\n\nこの辺を気にかけてもらえると助かります\n\nどうぞよろしくお願いいたします\n\n参考画像\nhttps://1drv.ms/u/c/ab6a937718b0b65c/Ebo7ehEzT7xFioac8BmQiC8ByKvbIh9SGYQp2Aj_KRt0Lg\n\nhttps://1drv.ms/u/c/ab6a937718b0b65c/Ebo7ehEzT7xFioac8BmQiC8ByKvbIh9SGYQp2Aj_KRt0Lg", "created_at": "", "completed_at": ""}, {"path": "/@nakazakitow/works/207", "thumbnail_src": "https://si.imgix.net/8d0e5a46/uploads/origins/d7ab3db5-6675-4a77-8d35-5c4b84f2f7bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40c7c1ec1ccc9deb421ff6784e663297", "thumbnail_srcset": "https://si.imgix.net/8d0e5a46/uploads/origins/d7ab3db5-6675-4a77-8d35-5c4b84f2f7bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40c7c1ec1ccc9deb421ff6784e663297, https://si.imgix.net/8d0e5a46/uploads/origins/d7ab3db5-6675-4a77-8d35-5c4b84f2f7bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=454ae7e114edb25945eb635ec8f5bf01 2x, https://si.imgix.net/8d0e5a46/uploads/origins/d7ab3db5-6675-4a77-8d35-5c4b84f2f7bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6124b20bd6d626e99611bfb9a44ec99 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nakazakitow/works/206", "thumbnail_src": "https://si.imgix.net/2a1f4e9d/uploads/origins/09fceb90-71bb-49b4-ab2a-dfb8259bf058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=F