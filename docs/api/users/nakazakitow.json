が楽しくて仕方がないというような笑み\n上記の表現を入れていただければ構図等細かい部分はお任せします。\nPSDで可能でしたらキャラのみの透過差分もお願いしたいです。\n服へのダメージ表現があるので念の為NSFWを有効にしておきます。\n描いていただいたイラストはTwitterへの投稿等個人利用の範囲で使用させていただきたいと思います。\n\n上記の内容で何卒ご検討の程よろしくお願いいたします\n\nhttps://drive.google.com/file/d/1PQsIBur3pousfL17Na7Vt4oXPq5N2vlM/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@nakazakitow/works/200", "thumbnail_src": "https://si.imgix.net/1c93f16a/uploads/origins/36c1eb82-8ffb-49d1-bde8-fcfad71c9d00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=911368d90f9ae438d30b04670fdd1f3b", "thumbnail_srcset": "https://si.imgix.net/1c93f16a/uploads/origins/36c1eb82-8ffb-49d1-bde8-fcfad71c9d00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=911368d90f9ae438d30b04670fdd1f3b, https://si.imgix.net/1c93f16a/uploads/origins/36c1eb82-8ffb-49d1-bde8-fcfad71c9d00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87e18d28ed8fcaebe35ca31f867a2eb6 2x, https://si.imgix.net/1c93f16a/uploads/origins/36c1eb82-8ffb-49d1-bde8-fcfad71c9d00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f1949e16629f91fe7cbe1fa616df70b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nakazakitow/works/199", "thumbnail_src": "https://si.imgix.net/70db6686/uploads/origins/b9be71e1-6020-4af3-8633-ed0acea7a2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c319dd612334c4a38f987ab1ecf2ba4", "thumbnail_srcset": "https