1576/uploads/origins/a99f51da-07a1-4bc6-aa95-54c986f906ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3942889d2d43fa60d120ab7e8b6d8709", "thumbnail_srcset": "https://si.imgix.net/d0c21576/uploads/origins/a99f51da-07a1-4bc6-aa95-54c986f906ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3942889d2d43fa60d120ab7e8b6d8709, https://si.imgix.net/d0c21576/uploads/origins/a99f51da-07a1-4bc6-aa95-54c986f906ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b82c4c1c722576ddb482d4fe21ceb542 2x, https://si.imgix.net/d0c21576/uploads/origins/a99f51da-07a1-4bc6-aa95-54c986f906ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d7d583ef88c4f8de057dfddb16ef6b5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！～あなたの絵が大好きです。私のオリジナルキャラクターを描いていただきたいのですが、彼は猫と音楽を聴くのが好きな、内向的で親切な仲間はずれのキャットボーイです。\n\n秋の季節に木にもたれて座っている彼の横に2匹の猫がいるように描いてもらいたいのですが、猫の位置やポーズはあなたにお任せします。\n\n参考文献（キャラクター）。\n\nhttps://twitter.com/hisakihana/status/1442353178062704642?s=21\nhttps://twitter.com/09pic/status/1446680227262840832?s=21\n\nリファレンス（猫）。\nhttps://www.instagram.com/p/B52eq3KpwxF/?utm_medium=copy_link\nhttps://www.instagram.com/p/CU4rzivtWK8/?utm_medium=copy_link", "created_at": "", "completed_at": ""}, {"path": "/@hino_h/works/26", "thumbnail_src": "https://si.imgix.net/56f2dd5e/uploads/origins/c14aa2b0-f10d-4210-970e-8dc56c4ca08a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eec49df9b7d65de07e66310f8d65f709", "thumbnail_srcset": "https://si.imgix.net/56f2dd5e/uploads/origins/c14aa2b0-f10d-4210-970e-8dc56c4ca08a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eec49df9b7d65de07e66310f8d65f709, https://si.imgix.net/56f2dd5e/uploads/origins/c14aa2b0-f10d-4210-970e-8dc56c4ca08a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=330b414097cd2221c2c4a7f6aca647d3 2x, https://si.imgix.net/56f2dd5e/uploads/origins/c14aa2b0-f10d