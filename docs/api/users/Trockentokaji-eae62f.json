rop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1f5b9c7d96caad2600bc27e74cf41ed 2x, https://si.imgix.net/c22badcf/uploads/origins/4a41f9c2-1119-4a1d-ab93-fc04668cf45f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df76b5dc3a1e790b180935623b7d4dd9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Trockentokaji/works/42", "thumbnail_src": "https://si.imgix.net/4ffca8f3/uploads/origins/2020cb93-c20e-4151-9e03-f3f68c1c2e35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86875f87cba7ddc7ad1d2d3fefc19b5e", "thumbnail_srcset": "https://si.imgix.net/4ffca8f3/uploads/origins/2020cb93-c20e-4151-9e03-f3f68c1c2e35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86875f87cba7ddc7ad1d2d3fefc19b5e, https://si.imgix.net/4ffca8f3/uploads/origins/2020cb93-c20e-4151-9e03-f3f68c1c2e35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ee275ae46841360235bee225e21d74e 2x, https://si.imgix.net/4ffca8f3/uploads/origins/2020cb93-c20e-4151-9e03-f3f68c1c2e35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a5103c6267c69f7ff5df479daea51bf 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵が大好きです！\n\nキャラクターはルビーとジェイミーです。\n\nルビーとジェイミーは街の上に足を伸ばしています。シーンは下からで、ちっぽけな視点からのものです。\n\nhttps://drive.google.com/drive/folders/1HGp2oqGyvLZpcRc4uURYtzAeoeEPSuQg?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Trockentokaji/works/41", "thumbnail_src": "https://si.imgix.net/6a9e637f/uploads/origins/3c70feef-3802-4c88-862d-a945ce4752d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7efde609a9bcd0f817a8425d47d8fac", "thumbnail_srcset": "https://si.imgix.net/6a9e637f/uploads/origins/3c70feef-3802-4c88-862d-a945ce4752d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7efde609a9bcd0f817a8425d47d8fac, https://si.imgix.net/6a9e637f/uploads/origins/3c70feef-3802-4c88-862d-a945ce4752d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40404e65f60695928350c9265ba4cd56 2x, https://si.imgix.net/6a9e637f/uploads/origins/3c70feef-3802-4c88-862d-a945ce4752d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=715c987166df6046904981b3b84a69e7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Trockentokaji/works/40", "thumbnail_src": "https://si.imgix.net/41317bac/uploads/origins/085efc47-6449-4a01-913d-6a5db424bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c96906f21d2978353f91017ad6555aa", "thumbnail_srcset": "https://si.imgix.net/41317bac/uploads/origins/085efc47-6449-4a01-913d-6a5db424bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c96906f21d2978353f91017ad6555aa, https://si.imgix.net/41317bac/uploads/origins/085efc47-6449-4a01-913d-6a5db424bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2645c479f7a424dfff537bbe5f498732 2x, https://si.imgix.net/41317bac/uploads/origins/085efc47-6449-4a01-913d-6a5db424bca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15060da836abe3fca0f30ab3b2a3c5f9 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイブの中務キリノにシャーレの依頼で縮小都市を素足で徹底的に踏み潰して足跡だらけにした後先生に写真と併せてモモトークで報告するというものです。", "created_at": "", "completed_at": ""}, {"path": "/@Trockentokaji