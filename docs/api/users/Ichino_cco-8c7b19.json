bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c655b9588603e9e23d681aa240204fb1 2x, https://si.imgix.net/a8cff9bf/uploads/origins/3ec38fcf-b1a2-4060-a3ce-71b72d80cc57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a2eed2cb15283563cc10469acff7c12 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ichino_cco/works/9", "thumbnail_src": "https://si.imgix.net/29e65791/uploads/origins/9406c873-de36-4b51-9c2a-62d467b64ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995c37a76136b63a5de9ad8abc2099ed", "thumbnail_srcset": "https://si.imgix.net/29e65791/uploads/origins/9406c873-de36-4b51-9c2a-62d467b64ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995c37a76136b63a5de9ad8abc2099ed, https://si.imgix.net/29e65791/uploads/origins/9406c873-de36-4b51-9c2a-62d467b64ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e13406b68d3dba1c16d28927c762cd52 2x, https://si.imgix.net/29e65791/uploads/origins/9406c873-de36-4b51-9c2a-62d467b64ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e69fa20bc4e820f136389c653add4ec7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、前回の作品ありがとうございました。また画像をリクエストしてもいいですか？今回は、私のイーブイが友達にサプライズでハグをしているところです。イーブイが友達を後ろから抱きしめていて、友達は驚いています。\n\nイーブイです：\nhttps://cdn.discordapp.com/attachments/1189087343718699089/1189091207201181798/NoctTheVee.png\n\n友達\nhttps://x.com/giyuyuchan/status/1743168197061226889?s=20\n\n例\nhttps://commishes.io/image/6262436/never/u4bxFNtbWHwV8i3iVjMxvDJBHu7Cf2V2QZBAz?w=700&s=789d492362b9b4ad56089612c732f15d", "created_at": "", "completed_at": ""}, {"path": "/@Ichino_cco/works/8", "thumbnail_src": "https://si.imgix.net/f0ca0e88/uploads/origins/2607833a-5eed-4190-8fa8-18cd2245dfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f4b642e97f299570c7d8453c04a3af4", "thumbnail_srcset": "https://si.imgix.net/f0ca0e88/uploads/origins/2607833a-5eed-4190-8fa8-18cd2245dfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f4b642e97f299570c7d8453c04a3af4, https://si.imgix.net/f0ca0e88/uploads/origins/2607833a-5eed-4190-8fa8-18cd2245dfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd61fb53c586d7901f49fe0f66653200 2x, https://si.imgix.net/f0ca0e88/uploads/origins/2607833a-5eed-4190-8fa8-18cd2245dfa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98f4d29cc1529bc63bca14ca0b6d641f 3x", "genre": "art", "nsfw": false, "body": "Hi!\nYour artwork is super super cute~🥰💖\n\nCan you please draw a couple commission for these two characters?\n\nThis is 'Maya' :\nhttps://mayafurry.github.io/images/commissions/Maya_sheet_reference.jpg\n\nAnd this is 'Efi' :\nhttps://drive.google.com/drive/folders/13lUAvn3WaYXvMdDerJRdBCtZJFu2G7TQ\n\nPlease draw freely!\n\nThanks~💖", "created_at": "", "completed_at": ""}, {"path": "/@Ichino_cco/works/7", "thumbnail_src": "https://si.imgix.net/dfdd06fd/uploads/origins/d314b7e0-c201-4aab-b921-858a0fc8ef04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b5b30ca0c24bd6d952f1c18f3549617", "thumbnail_srcset": "https://si.imgix.net/dfdd06fd/uploads/origins/d314b7e0-c201-4aab-b921-858a0fc8ef04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b5b30ca0c24bd6d952f1c18f3549617, https://si.imgix.net/dfdd06fd/uploads/origins/d314b7e0-c201-4aab-b921-858a0fc8ef04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d1cd53144f8485e69616c2ff7c3a869 2x, https://si.imgix.net/dfdd06fd/uploads/origins/d314b7e0-c201-4aab-b921-858a0fc8ef04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s