のが好きで、彼の部族はみんなから隔離された山の頂上に住んでいる。\n夜間しか外出できない。\n\n彼らは親友で、(2)は(1)に恋をする。\n風景：夜、雪が積もった高い山、星やオーロラ。\n人間の男がエルフの男に恋をしていることに気づくシーンを描く必要がある。\n\nhttps://imgur.com/a/skeb-request-taroji-h9gsX6T", "created_at": "", "completed_at": ""}, {"path": "/@alpacatarojiro/works/13", "thumbnail_src": "https://si.imgix.net/0de5a3ce/uploads/origins/c6c1694e-890d-4667-b895-4fdb09a781f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b246d75c36647fa779c379bed70ac487", "thumbnail_srcset": "https://si.imgix.net/0de5a3ce/uploads/origins/c6c1694e-890d-4667-b895-4fdb09a781f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b246d75c36647fa779c379bed70ac487, https://si.imgix.net/0de5a3ce/uploads/origins/c6c1694e-890d-4667-b895-4fdb09a781f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53e00b51e194306c4fa588f088c20d29 2x, https://si.imgix.net/0de5a3ce/uploads/origins/c6c1694e-890d-4667-b895-4fdb09a781f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e8583e6ca9d73d34be95c8223160263 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@alpacatarojiro/works/12", "thumbnail_src": "https://si.imgix.net/1f717074/uploads/origins/8191dd72-e182-4a26-a2f4-c7e4ccdd4072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=189b0da8e1bc2c880da275ee29a26806", "thumbnail_srcset": "https://si.imgix.net/1f717074/uploads/origins/8191dd72-e182-4a26-a2f4-c7e4ccdd4072?bg=%23fff&auto=format%