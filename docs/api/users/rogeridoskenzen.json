e60-6c9c2ade20cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=990a101a602b33f3bd40f913f3035bf0 3x", "genre": "art", "nsfw": true, "body": "先生！リクエスト失礼します！\nチアコトリマッサージ本拝読しましてとてもお世話になりましたので、モエが同じようなシチュエーションですごいテクニックで手マンされて潮吹きさせられているイラストをお願いしたいです。\n希望の構図は9P目にある頭が手前にくる構図で、pixivにあるおかころっくす（https://www.pixiv.net/artworks/80528221）のような汗だく、乳首ビン勃ちで、連続イキしているような感じ方。幸せそうなとろっとろのイキ顔だと嬉しいです。\nカラーor白黒はお任せします。解釈違い等あれば気兼ねなくキャンセルなさってください。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rogeridoskenzen/works/4", "thumbnail_src": "https://si.imgix.net/dc988f08/uploads/origins/5e92feea-b3e7-4739-bcc1-b9e83a8de6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6505e91c2ee90d8bf15ce38f6f7e2c60", "thumbnail_srcset": "https://si.imgix.net/dc988f08/uploads/origins/5e92feea-b3e7-4739-bcc1-b9e83a8de6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6505e91c2ee90d8bf15ce38f6f7e2c60, https://si.imgix.net/dc988f08/uploads/origins/5e92feea-b3e7-4739-bcc1-b9e83a8de6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04cee720d0c6bec4a059a6e21615cd65 2x, https://si.imgix.net/dc988f08/uploads/origins/5e92feea-b3e7-4739-bcc1-b9e83a8de6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90025cb3a7b172b7b1c6ed4a2d9f42ed 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n個人Vtuberのあれぐろもるとと申します。\nむっちむちのぼくを描いていただきたくリクエストしました！\n\n■依頼概要\nむっちむちのえっちなあれぐろもるとをお願いします！おっぱいやふとももはどれだけ盛ってもかまいません！\n\n■想定している使用範囲\n- SNS投稿、アイコン\n- 動画・LIVE配信\n- 各種サムネイル\n※使用の際はクレジットを表記します\n※一部のみトリミングする場合があります\n\n■対象年齢\nR-18\n\n■ファイル形式\n納品物に、背景とキャラクターを別レイヤーに分けたPSDファイルを含めていただけると助かります。\n\nお手数をおかけしますが、ご検討の程よろしくお願いします！\n\nhttps://1drv.ms/f/s!AnNGKzbxk33_80J0gdrFYOTGML30", "created_at": "", "completed_at": ""}, {"path": "/@rogeridoskenzen/works/3", "thumbnail_src": "https://si.imgix.net/32a939b6/uploads/origins/f9012923-b84f-41a3-a4ba-e7c77908f185?bg=%23fff&auto=format%2Ccompress&fm=web