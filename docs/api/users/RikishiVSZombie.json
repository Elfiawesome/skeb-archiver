f48345ca12d8aa6c008 2x, https://si.imgix.net/5a39f657/uploads/origins/af862cbb-dfb9-482b-b798-ba2e92c9a8ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43821066a9c09094af1ae161ae60c9bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RikishiVSZombie/works/24", "thumbnail_src": "https://si.imgix.net/d1a810a4/uploads/origins/8e16dcef-7c4b-4432-a560-3e9a03aed5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd4d55164c9d463ac635b1c540b0a00", "thumbnail_srcset": "https://si.imgix.net/d1a810a4/uploads/origins/8e16dcef-7c4b-4432-a560-3e9a03aed5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd4d55164c9d463ac635b1c540b0a00, https://si.imgix.net/d1a810a4/uploads/origins/8e16dcef-7c4b-4432-a560-3e9a03aed5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7a988e446440b3a2a6fbbf2e930709c 2x, https://si.imgix.net/d1a810a4/uploads/origins/8e16dcef-7c4b-4432-a560-3e9a03aed5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54c70e2f6d6c49ca42e145b33c20c77d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RikishiVSZombie/works/23", "thumbnail_src": "https://si.imgix.net/1a15e111/uploads/origins/bfa6c875-c827-4505-bfc6-44d2da978b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3d902cf6013fdf83b23f2d9f1b79975", "thumbnail_srcset": "https://si.imgix.net/1a15e111/uploads/origins/bfa6c875-c827-4505-bfc6-44d2da978b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3d902cf6013fdf83b23f2d9f1b79975, https://si.imgix.net/1a15e111/uploads/origins/bfa6c875-c827-4505-bfc6-44d2da978b50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cb9e061d40649c16e3dd2007c6f5cd1 2x, https://si.imgix.net/1a15e111/uploads/origins/bfa6c875-c827-4505-bfc6-44d2da978b50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb741a29ca79a81cbd765beb9e39c306 3x", "genre": "art", "nsfw": true, "body": "いつもきょうりゅうのひみつさんのドスケベ剛毛女体にはお世話になっております…！もしよろしければ下品な依頼ですがご一考頂けると嬉しいです！\n\n『アークナイツよりチューバイ』の剛毛ふたなりもっこりイラストをお願いします！\n\nチューバイの身体は以前描かれていたデーゲンブレヒャー(https://www.pixiv.net/artworks/128602595)くらいのサイズ感のおっぱいで垂れ乳黒乳首の下品なおっぱい、腹肉はペナンス(https://www.pixiv.net/artworks/124131803)の様に弛んだお腹、腋毛や陰毛は黒毛の剛毛で是非ともきょうりゅうのひみつさんの可能な限り濃い目＋範囲も広めで是非臭そうな蒸れ蒸れ姿でお願いしたいです！\n\n(もし本当に盛れそうであれば腋毛は以前描かれていたこちら(https://skeb.jp/@RikishiVSZombie/works/20)の様に腋部分が完全に覆われてるレベルの範囲や濃さ、陰毛はこちら(https://x.com/urukio/status/1469285975100903424/photo/1)の様に鼠径部やへそまで広がるレベルの範囲や濃さ)\n\nふたなりちんぽ(玉有り)は直接見えず、パンツに納まっておりもっこりとした膨らみで表現してほしいのですがもっこりとした膨らみの大きさはこちら(https://www.pixiv.net/artworks/129337180)と同じか可能ならもう少し大きい、膨らみ越しでも明らかにデカイもの♂が収まってそうなデカめのもっこりでお願いします！\n\n衣装はこちら4枚目(https://x.com/urukio/status/1779844370625409440/photo/1)の様なメンズが履いてそうな赤無地のパンツ(もっこり部分以外は布面積少な目)なもっこりが目立ちやすい赤パンツ一丁姿でお願いします！\n\nそんなもっこり赤パンツ一丁の蒸れ蒸れ剛毛ボディのチューバイが下品な腋見せ蟹股ポージングでこちらに蒸れて臭そうな剛毛ボディやデッカいもっこりを見せつけてくれる姿を是非！表情は是非こちら(https://www.pixiv.net/artworks/134652580)の様に「こういうのが好きなのでしょう？……まったく、とんだ変態ですね…♥まあ、希望を叶える私も私ですが…♥」と言わんばかりの感じで…！\n\nもし可能であれば差分として\n・↑のふたなりリシュリューの様にもっこりから精液が染み出して滲んでいる\n・赤パンツにこちら(https://x.com/urukio/status/1753758978423873947/photo/1)の様なおジャマの花柄を入れる\nをお願いしたいです！\n\n以上大変長くなりましたがよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@RikishiVSZombie/works/22", "thumbnail_src": "https://si.imgix.net/0d7bba75/uploads/origins/b08f7eba-407f-4cb1-96f5-07289bfb5f78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3150aa7e28492f61d41292d963322174", "thumbnail_srcset": "https://si.imgix.net/0d7bba75/uploads/origins/b08f7eba-407f-4cb1-96f5-07289bfb5f78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3150aa7e28492f61d41292d963322174, https://si.imgix.net/0d7bba75/uploads/origins/b08f7eba-407f-4cb1-96f5-07289bfb5f78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a01960b8abe66eae509ccb832ae10dc7 2x, https://si.imgix.net/0d7bba75/uploads/origins/b08f7eba-407f-4cb1-96f5-07289bfb5f78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5733cf9eebe98b4138dfe527a3315a8a 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n以前描かれた以下の\n\nhttps://skeb.jp/@RikishiVSZombie/works/20\n\n依頼絵がとても素晴らしかったので同じ構図と範囲に\n\nアングルと両手を頭の後ろに組んだポーズでお願いします\n\nキャラ：艦これの愛宕（あたご 金髪）と高雄（たかお 黒髪ショート）の２人\n\nそれぞれ以下に指定する水着衣装と\n\n帽子と水着無しで首輪のみの全裸差分×２人分の\n\n合計４枚のサンプル納品とPSDファイルをお願いします\n\n\n〇服装・体など全体は\n以下のリンク先をベースに\n\nhttps://x.com/cilica_illust/status/1945015228061605964\n\nhttps://skeb.jp/@cilica_illust/works/66\n\n元の帽子を被った状態に\n以下リンク先のような\n乳輪がハミ出て乳首が隠れるくらいの\n細めなスリングショット水着と首輪のみ\n左右どちらかの水着が外側にずれて乳首が丸見え\nもう片方の胸はちゃんとつけているが乳首がくっきり浮いている\n\n水着参照\nhttps://x.com/_YuukiAi_/status/1894232621611454516\n\n水着の色は帽子と同じ水色で\n\n首輪参照(ヒモは無)\nhttps://m.media-amazon.com/images/I/41V7dna37ZL._AC_.jpg\n\n腋毛を腋を閉じてもハミ出るほど長く濃いめに\n陰毛を水着がハミ出るくらい、長く濃いめに\n愛宕の腋毛と陰毛は髪の毛の色と同じ金髪で\n\nまた陰毛は以下リンクのようにヘソまで繋げるギャランドゥ\n\n陰毛参照\nhttps://skeb.jp/@bnnn0508/works/11\n\nhttps://skeb.jp/@tyakabisu/works/39\n\n〇陰毛で隠れて不要かもしれませんが可能であればモザイクではなく黒海苔を希望\n\nご検討いただければ幸いです\nよろしくお願いします\n\nhttps://tsundora.com/193486", "created_at": "", "completed_at": ""}, {"path": "/@RikishiVSZombie/works/21", "thumbnail_src": "https://si.imgix.net/49403904/uploads/origins/15f56859-154b-4f97-abfd-41d9a156192f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txt