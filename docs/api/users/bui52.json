e=30&txt=PRIVATE&s=0610f442ec0ee9f494b5447afb1b3fdd 2x, https://si.imgix.net/4924ab72/uploads/origins/6ad09f66-ba57-4a17-a215-807d5597e993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d537a4b5466b468c2f62627de80b120b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bui52/works/64", "thumbnail_src": "https://si.imgix.net/576b3e0c/uploads/origins/88bd143a-6e70-476f-9d97-94be236b4101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e34c49269191476e8d05ad5c21053767", "thumbnail_srcset": "https://si.imgix.net/576b3e0c/uploads/origins/88bd143a-6e70-476f-9d97-94be236b4101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e34c49269191476e8d05ad5c21053767, https://si.imgix.net/576b3e0c/uploads/origins/88bd143a-6e70-476f-9d97-94be236b4101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7f534c71885fdebeaca44f3f8b0f4cd 2x, https://si.imgix.net/576b3e0c/uploads/origins/88bd143a-6e70-476f-9d97-94be236b4101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7308365ca46cfcfc3bab24346b46c193 3x", "genre": "art", "nsfw": true, "body": "本文\n\n羅ぶいさん\nお疲れ様です。いつもお世話になっております。\n依頼内容\n妊娠入れ替わりシチュをチェンソーマンのデンジとパワーで(ボテ・台詞差分で２×２で合計４差分)お願いします。\nプレイ内容　入れ替わった二人の孕ませボテ腹プレイ\n構図・アングル・体位・服装：お任せします。\nパワー\n胸：爆乳(乳首は太く長め)。\n腹ボテ：過去依頼同様大き目\n陰毛：ボサボサ\nデンジ：巨根　顔出しはなし。\n妊娠後は母乳追加\n台詞差分\n原作のような関係の雰囲気\n嬌声に濁点が付くレベルの下品な内容＋アヘ顔\nでそれぞれ妊娠前とボテ腹バージョンの2×2の4パターンでお願いします。\n下品側の台詞ですが、非下品台詞の単語を差し替えたり、語尾を伸ばす程度でなく、がっつりと別の内容にしていただきたいです。\n台詞量：以前の依頼と同じぐらい\n以上です。宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bui52/works/63", "thumbnail_src": "https://si.imgix.net/32a53b55/uploads/origins/172a5fcc-9218-42c6-bfba-d0ad71ce7153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53c50042f5142e9407acadb72df3b457", "thumbnail_srcset": "https://si.imgix.net/32a53b55/uploads/origins/172a5fcc-9218-42c6-bfba-d0ad71ce7153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53c50042f5142e9407acadb72df3b457, https://si.imgix.net/32a53b55/uploads/origins/172a5fcc-9218-42c6-bfba-d0ad71ce7153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be213752e6059c9e7787ff75cc533559 2x, https://si.imgix.net/32a53b55/uploads/origins/172a5fcc-9218-42c6-bfba-d0ad71ce7153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0120986843734e1b27e510242b16767 3x", "genre": "art", "nsfw": true, "body": "こんにちは！TSマンガ「TSカジノ～債務者達の末路～」の主人公ミミが輪姦するショートマンガをお願いします。\n\nミミは長い間カジノの客に奉仕してきた結果、セックスがとても上手になりました。今ではより高い快楽として、複数の客に同時に奉仕することを楽しんでいる。漫画のアフターイベントとして想像できる。\n\n長さなどはお任せします。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@bui52/works/62", "thumbnail_src": "https://si.imgix.net/a5a4e264/uploads/origins/415ac81d-b8d7-4b64-adc9-279e8509a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b689603b34eb4ef1b048707292dc420", "thumbnail_srcset": "https://si.imgix.net/a5a4e264/uploads/origins/415ac81d-b8d7-4b64-adc9-279e8509a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b689603b34eb4ef1b048707292dc420, https://si.imgix.net/a5a4e264/uploads/origins/415ac81d-b8d7-4b64-adc9-279e8509a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=223474fa12b3ae64677dc876f6e7f09f 2x, https://si.imgix.net/a5a4e264/uploads/origins/415ac81d-b8d7-4b64-adc9-279e8509a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be771213dd63995bc718f36eccd5301a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。初めてリクエストさせていただきます。\n\n皮ものTSFで、女子高生になった元男の子のイラストをお願いします。\n\nキャラ設定\n・元は男子高校生。一人称は俺\n・皮のお試しで1日だけ着て生活する予定だったが、背中にある皮の切れ目を何者かに焼き潰されて、皮が脱げなくなって不可逆に\n・変身後はロングヘアの美人\n・元に戻りたい\n\nイラストの構図\n・部屋で着替えているところ。全裸\n・姿見の前で絶望的な表情をしている、背中には縦に走る火傷の痕\n\nセリフや構図は基本的にはお任せします。よろしければお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@bui52/works/61", "thumbnail_src": "https://si.imgix.net/d4a764a6/uploads/origins/f1f9fc27-b13f-4a9d-b562-a2706069b373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa2c104a23789d3f6f7561dff19382f", "thumbnail_srcset": "https://si.imgix.net/d4a764a6/uploads/origins/f1f9fc27-b13f-4a9d-b562-a2706069b373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa2c104a23789d3f6f7561dff19382f, https://si.imgix.net/d4a764a6/uploads/origins/f1f9fc27-b13f-4a9d-b562-a2706069b373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92ca0e399c72be68cdcabce4260832fe 2x, https://si.imgix.net/d4a764a6/uploads/origins/f1f9fc27-b13f-4a9d-b562-a2706069b373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60ac4de329b097319aa79c53999e0795 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます。\n\n羅ぶい先生のFANBOXで拝見した皇千秋ちゃん（くん？）の立ち絵が普段着、バニー衣装共に\nムッチムチでとても好みだったので、彼女で短編漫画を描いていただきたいと思いました。\n\n彼女がバニー衣装に着替えるシーンをお願いします。\n\n①タイツを履いて下半身にピッチリ張り付く\n②タイツの上からレオタードを履いて股間に密着\n③レオタードを履いたお尻を強調\n④乳房をカップ部分？に収めて形を整える\n\n最後に乳房とお尻を強調した見返りポーズの立ち絵をお願いします。\n\n１Pでどこまで収められるかわからないので、\n全部入らない様でしたら③と④を優先で余裕があれば②→①を入れていただければ幸いです。\n\n台詞や表情などは、先生が設定しているイメージに沿った形の上で\nなるべく羞恥心を感じられるシチュエーションでお願い出来ると嬉しいです。\n\n以上の内容でご検討いただければ幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@bui52/works/60", "thumbnail_src": "https://si.imgix.net/3c4ff633/uploads/origins/50ee129d-9872-4daf-a850-4e94cf8ad62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6f24e873addd24cb1df4b2ed58b9bf2", "thumbnail_srcset": "https://si.imgix.net/3c4ff633/uploads/origins/50ee129d-9872-4daf-a850-4e94cf8ad62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6f24e873addd24cb1df4b2ed58b9bf2, https://si.imgix.net/3c4ff633/uploads/origins/50ee129d-9872-4daf-a850-4e94cf8ad62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=448893bd2592383558583989e715227f 2x, https://si.imgix.net/3c4ff633/uploads/origins/50ee129d-9872-4daf-a850-4e94cf8ad62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=372f6d869cb9eed530b55f8a68854f34 3x", "genre": "art", "nsfw": true, "body": "羅ぶいさん\nいつも作品楽しみにしています。\n前回もお世話になりました。\n依頼\n純情！？入れ替わりリングの双子のフタナリ化シークエンスの続編で相互挿入シチュを3P漫画の３P目\nストーリー:フタナリ化した二人が相互挿入でお互いを孕ませる\n服装:全裸\n1P：相互挿入し、お互い軽く絶頂\n2P：ストロークし、射精に近づいていく。\n3P：1枚絵(差分4枚/モノクロ)差分:ストローク・射精・ボテ腹ストローク・ボテ腹射精の４種類(台詞も別)\n台詞・効果音は多めかつ下品で、ボテ具合は大きめ、母乳も大量でお願いします。ボテ差分はアヘ顔でお願いします。\n台詞内容として、二人が近親関係にあることを強調する内容や今妊娠している子供が成長したら家族4人でSEXすることを望む内容でお願いします。\nまた、相互挿入による体位ですが今回はお任せします。\nまた、黒線(横線)修正でお願いします。\n以上です。何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bui52/works/59", "thumbnail_src": "https://si.imgix.net/107766e7/uploads/origins/84a4d8cb-eb77-4bc0-a812-bbfa0fd4e6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e91383ee63e6306bf34ec18dce728e7", "thumbnail_srcset": "https://si.imgix.net/107766e7/uploads/origins/84a4d8cb-eb77-4bc0-a812-bbfa0fd4e6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e91383ee63e6306bf34ec18dce728e7, https://si.imgix.net/107766e7/uploads/origins/84a4d8cb-eb77-4bc0-a812-bbfa0fd4e6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=defb5244a62b960270bf2d1dfdd23815 2x, https://si.imgix.net/107766e7/uploads/origins/84a4d8cb-eb77-4bc0-a812-bbfa0fd4e6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2041ffdfdddc6d8c3adecd5b607ea074 3x", "genre": "art", "