2c6-bc32-4aedd121fc0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a577232186a908c2a17a744b197c1ab, https://si.imgix.net/bc013c6c/uploads/origins/57c490d5-cf8b-42c6-bc32-4aedd121fc0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca4e2fdec78bb2cf94d59ede5e73696 2x, https://si.imgix.net/bc013c6c/uploads/origins/57c490d5-cf8b-42c6-bc32-4aedd121fc0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76c43d1d5ba57cbdb7ed1cbb8a55fe53 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのチビたちはかわいいので、リクエストさせてください。\n\n僕のVチューバーを描いてくれませんか？ポーズや構図はお任せします。性格的には、ストイックで無頓着なところもありますが、大抵はのんびりしています。物事を気にしないようにしています。表情はたいてい平坦か微妙です。\n\n彼らの爪を描くのは難しいと思うので、描きたくなければ描かなくてもいい！その方が描きやすいなら、人間の手やとても長い袖で描いてもいい。僕はどっちでもいいと思う。\n\n参考：https://drive.google.com/drive/folders/10YYFc6G0IEpxJmG2diDxd-g2TiFLMbCl?sort=13&direction=a\n\nどうぞ楽しんでください！", "created_at": "", "completed_at": ""}, {"path": "/@4d3h9/works/10", "thumbnail_src": "https://si.imgix.net/7a1e7929/uploads/origins/2823bca9-bb2c-4668-9ef5-fd5a914f4db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ad16032b4e5ed0b1ff1da09fb9a2290", "thumbnail_srcset": "https://si.imgix.net/7a1e7929/uploads/origins/2823bca9-bb2c-4668-9ef5-fd5a914f4db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ad16032b4e5ed0b1ff1da09fb9a2290, https://si.imgix.net/7a1e7929/uploads/origins/2823bca9-bb2c-4668-9ef5-fd5a914f4db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=137c1ad21cd365f02a9b8262f8402703 2x, https://si.imgix.net/7a1e7929/uploads/origins/2823bca9-bb2c-4668-9ef5-fd5a914f4db6?bg=%23fff&auto=format%2Ccompress&fm=web