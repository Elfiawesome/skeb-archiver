format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cb98e2c1a880d18308937a3d5561218 2x, https://si.imgix.net/bd8dbaaa/uploads/origins/3d447234-cc44-4345-aa18-28bb6407a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb62efc1467e276e5ff4335cd6bf1c9d 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nmisskey.ioでmjk(@mjk_chain)という名前でやっている者です。\n日頃よりTLにてイラスト等拝見させていただいており、今回リクエストをするに至りました。\n\nさて、今回はももじさんに私の代理キャラクタであるmjkちゃんを描いていただきたくリクエストを致しました。\nポーズ等の指定はありませんので、ももじさんのお好みでお願いいたします。\n\n●キャラクタ外観資料\nhttps://misskey.io/notes/9xo9yefqpmvq01ba\n\n●衣装資料\n①https://misskey.io/notes/afvw7hcfie7t04xy\n②https://misskey.io/notes/ag1ws62d0q3802hu\n・ボトムスにある柄は無くてもOKです。\n・資料①ではヘッドホンを着けていますが、無視してOKです。\n　一応ワイヤレスイヤホンを着けている想定なのですが、横髪で隠れると思います。\n　意図的に出す場合は描写お願いします。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@pinkkiji_trois/works/33", "thumbnail_src": "https://si.imgix.net/a32c8164/uploads/origins/1ab0f914-7d1c-435a-9a03-667d362b0b43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91068bd59147e0d100d8781111dd103f", "thumbnail_srcset": "https://si.imgix.net/a32c8164/uploads/origins/1ab0f914-7d1c-435a-9a03-667d362b0b43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91068bd59147e0d100d8781111dd103f, https://si.imgix.net/a32c8164/uploads/origins/1ab0f914-7d1c-435a-9a03-667d362b0b43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3675fcd62672622abff4c6af016f247e 2x, https://si.imgix.net/a32c8164/uploads/origins/1ab0f914-7d1c-435a-9a03-667d362b0b43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82ed5e564e68f7888559a683941a9dce 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nお忙しい所再度のリクエストで大変恐縮では御座いますが、もう1人のうちの子高月朱音ちゃんで、下記のような内容をご検討頂きたく存じます。\n\n色々な都合で度々お金持ちな紳士のおじさま方に抱かれていた朱音ちゃん。連休のある日、複数いるおじさま方全員を温泉旅館で一斉にお相手することに。渡されたエロ衣装に身を包み、お化粧まで決めた朱音ちゃんに魅了されたおじさま方は、ついやり過ぎなくらい抱いてしまうのでした。\n\nといった背景イメージを下敷きに、下記のようなイラストをお願い致します。\n\n旅館の一室でピースをして立つ朱音ちゃん。おじさま方に何十回もハメられ、全身汗だく、あそこからは収まりきらない精液が溢れています。まだ体力は残っていて、カメラ目線で紅潮したいやらしい顔でこちらを見ています。\n部屋は電気をつけて明るめでお願い致します。\n\n髪型は資料通り、乳尻陰毛太もも等は盛り盛りして頂いて大丈夫です。\n\n衣装は下品度高めのエロ衣装で、乳首にリングピアス、臍にもピアス、あとのデザインはおまかせでお願い致します。\n使用済ゴムを各所に括り付けていると嬉しいです。\n陰毛はそのままかハート型に整えてください。\n\nアイシャドウやリップを濃いめに追加して、セックスの為、男に媚びるための雰囲気を出してもらえれば幸いです。\n濃さの匙加減はお任せ致します。\n\n背後にテレビを置いて頂いて、そこに朱音ちゃんのお尻の辺りを写した映像が流れていると嬉しいです。大きなお尻と、アナルからぶぽっと出てしまった精液が見たいのです。\n\n以上です。\nもちろん上記に沿わずとも、ももじさんの好みややりやすい形で進めて頂ければ幸いで御座います。\nまた、ちょっとお下品度高めでむむむっとなりましたら、前回のレイラさんと同じような、おじさんとエロ衣装でエッチする、みたいな内容にしてしまっても大丈夫です。\n\nお忙しい所恐縮では御座いますが、何卒ご検討の程宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/133887324", "created_at": "", "completed_at": ""}, {"path": "/@pinkkiji_trois/works/32", "thumbnail_src": "https://si.imgix.net/b57f607a/uploads/origins/3f53248b-a8a3-42ed-a046-9fb7063e9fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4e43fb5d570df05ecba74dbb60c67b", "thumbnail_srcset": "https://si.imgix.net/b57f607a/uploads/origins/3f53248b-a8a3-42ed-a046-9fb7063e9fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4e43fb5d570df05ecba74dbb60c67b, https://si.imgix.net/b57f607a/uploads/origins/3f53248b-a8a3-42ed-a046-9fb7063e9fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=984279c09e657d48942f6775fbf62c9d 2x, https://si.imgix.net/b57f607a/uploads/origins/3f53248b-a8a3-42ed-a046-9fb7063e9fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78a90fb5077576e97f1f12ce0cce1a19 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\nお忙しい所恐縮では御座いますが、下記内容のリクエストをご検討頂きたく存じます。\n\n資料のうちの子、レイラ・ハリスのエッチなイラストを希望致します。\n詳細は下記の通りです。\n\n\n可愛くて地位も高いのに家柄が最底辺なレイラさんは、シスターさんと修道士が身体を重ねる時の常識等を知らず、悪い子達にあることないこと仕込まれています。\nそんな訳でレイラさんは、色んな修道士から玩具にされて、そういうものだと思い込みながら夜な夜なドスケベなプレイに興じています。\n\nというイメージの背景を下敷きに、下記のようなイラストが希望です。\n\nドスケベな格好でエッチに興じるレイラさん。体位は顔、胸、陰毛辺りがよく見える構図になればおまかせでお願い致します。立ちバックでも騎乗位でも、男が透けて結果的に見えるなら正常位でも大丈夫です。\n\n髪型は資料の通り、乳尻太もも等お肉は盛盛して頂いて大丈夫です。\n\n衣装はお下品なエロ衣装（デザインの負荷が大きければピンクのラバー質なグローブとハイソックスだけで大丈夫です）、乳首に金か銀のリングピアス、臍にも乳首ピアスと同じカラーのピアスをお願い致します。\n陰毛はそのままのもっさりか、もっさりを維持しつつハート型に整えているかどちらかが希望です。\n\nアイシャドウやリップを濃いめに追加して、セックスの為、男に媚びるための雰囲気を出してもらえれば幸いです。\n濃さの匙加減はお任せ致します。\n\nプレイしてる場所のイメージは教会内のプレイ用の一室ですが、ここは簡素な形で大丈夫です。竿役の男も同様に、修道士のイメージですが低コストな描き方で問題御座いません。\n\n以上です。\nもちろん上記に沿わずとも、ももじさんの好みややりやすい形で進めて頂ければ幸いで御座います。\n\nお忙しい所恐縮では御座いますが、何卒ご検討の程宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/136310351", "created_at": "", "completed_at": ""}, {"path": "/@pinkkiji_trois/works/31", "thumbnail_src": "https://si.imgix.net/f3c14e96/uploads/origins/26620130-259c-41be-87a2-3a0ad2d9eef4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2635584ae5e94caf7298b5d7202e9217", "thumbnail_srcset": "https://si.imgix.net/f3c14e96/uploads/origins/26620130-259c-41be-87a2-3a0ad2d9eef4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2635584ae5e94caf7298b5d7202e9217, https://si.imgix.net/f3c14e96/uploads/origins/26620130-259c-41be-87a2-3a0ad2d9eef4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2968c3816e885cc047951d8329a24176 2x, https://si.imgix.net/f3c14e96/uploads/origins/26620130-259c-41be-87a2-3a0ad2d9eef4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=67dfebab0d1762ef140b1a32401a8c4f 3x", "genre": "art", "nsfw": true, "body": "桃尻ももじ様、アピールありがとうございます！\n折角なのでぜひお願いいたします！\n\nシチュエーション自体は接合部が丸見えになっている中出しセックスが大好きなのですが、どのくらいお願いしていいものか悩ましいところですので、今回はほぼすべてお任せしようと思います。\n一応無理やりだとかリョナ系はNGということでお願いいたします。\n\nhttps://misskey.io/notes/a5n7g5v79rc004d8", "created_at": "", "completed_at": ""}, {"path": "/@pinkkiji_trois/works/30", "thumbnail_src": "https://si.imgix.net/21cf4401/uploads/origins/4ac8383c-0bc6-4ba0-a906-4079a744682d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f6438f5138d364b2a739188a0390bae", "thumbnail_srcset": "https://si.imgix.net/21cf4401/uploads/origins/4ac8383c-0bc6-4ba0-a906-4079a744682d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top