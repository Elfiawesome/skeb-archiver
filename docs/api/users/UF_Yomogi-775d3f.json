dpr=2&fit=crop&crop=top&w=200&h=200&s=4427a5549aefcb1f0f0c6ef88f1b30a5 2x, https://si.imgix.net/afea51b3/uploads/origins/1e737e45-7bf5-4896-941e-da5c5d23995b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7397dd44db9b35a9e2be06d6bac745d 3x", "genre": "art", "nsfw": false, "body": "よもぎさんこんばんは、にゃるです。度々の依頼失礼します…！\n今回は黒髪のうちの子を描いて頂きたくお願い致します。\n\n全体の構図、イメージとしては自身の領域に侵入してきた者を迎え入れると共に臨戦状態に入っているといったものをお願いしたいです。\nまた、ただ戦闘の意思を見せている訳ではなく迎え入れてもいるのでどこか妖艶な雰囲気を感じ取れると幸いです…！\n\n中々ぼんやりとした表現で恐縮ですが、描いていただけると嬉しいです…！\n\nhttps://photos.app.goo.gl/ZCsReoq72P56pgze8", "created_at": "", "completed_at": ""}, {"path": "/@UF_Yomogi/works/8", "thumbnail_src": "https://si.imgix.net/9f484b11/requests/245044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8d242fb9d52f17a1a24d1607bc9a03", "thumbnail_srcset": "https://si.imgix.net/9f484b11/requests/245044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8d242fb9d52f17a1a24d1607bc9a03, https://si.imgix.net/9f484b11/requests/245044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56938a8f8e8510bda9cb1861246a8f7c 2x, https://si.imgix.net/9f484b11/requests/245044_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f9af02984f801edf799dcfcb41baf95 3x", "genre": "art", "nsfw": false, "body": "よもぎさんこんばんは、以前リクエストさせていただいたnyarです…！\nいつかまたリクエストをしようと考えておりましたが折角なので手数料無料中にと思い早速リクエストさせていただきます。\n\n今回もまたうちの子を描いていただきたいのですが、今回は以前描いていただいたうちの子とその親友のペアでお願い致します。\n\n構図などはお任せ致しますが、PCかiPadの壁紙にしたいと考えているので16:9もしくは16:10のアスペクト比だとありがたいです。\n\n黒髪のキャラの設定などはTwitterにあげていないので、ざっくりとした設定を載せるので必要であれば参考ください。\n・性格はかなり荒っぽい\n・モチーフは空亡という妖怪\n・イメージカラーは真黒と赤\n・頭の黄色い物は髪飾りのように見える角\n\nその他分かりにくい部分や描きにくい所などありましたら描きやすいようにアレンジしていただいて構いません。\n\n以上、長くなってしまいましたが是非よろしくお願いいたします…！\n\nhttps://photos.app.goo.gl/ZCsReoq72P56pgze8", "created_at": "", "completed_at": ""}, {"path": "/@UF_Yomogi/works/7", "thumbnail_src": "https://si.imgix.net/ac990613/requests/232287_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c442265b2fd70f2b33769e179118e6", "thumbnail_srcset": "https://si.imgix.net/ac990613/requests/232287_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c442265b2fd70f2b33769e179118e6, https://si.imgix.net/ac990613/requests/232287_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48d882a1a4bf65fd4162ff1c4eb8720e 2x, https://si.imgix.net/ac990613/requests/232287_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a83f6e08608de53062af399968a05e0f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\nアークナイツのアートが大好きです私のキャラクターのミニーをArknights風に描いていただきたいと思いました。\n\nライン研の科学者風の格好がとても気に入っています。彼女の服を現代のライン・ラボに変えてアーナイツの世界にフィットしているように見えるようにしてほしいと思っていました。\n\n彼女は剣の代わりに赤いレールガンを持っているかもしれません、私は例のためにいくつかの参照を置きました。可能であれば、武器の側面に彼女の名前を書くことはできますか？\n\n私は廃墟と化した街並みか実験室の背景を考えていました。  でも、それはあなた次第です。\n\n雰囲気とポーズはお任せします!\n\nここにミニーと服についてのいくつかの参考文献があります： https://imgur.com/a/An4t6KK\n\nこのご依頼でよろしいでしょうか、是非ともお願いしたいです。最後まで読んでいただき、ありがとうございました", "created_at": "", "completed_at": ""}, {"path": "/@UF_Yomogi/works/6", "thumbnail_src": "https://si.imgix.net/c0312ca6/requests/228466_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8091d607f36c663be61d2ba9ec97cf71", "thumbnail_srcset": "https://si.imgix.net/c0312ca6/requests/228466_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8091d607f36c663be61d2ba9ec97cf71, https://si.imgix.net/c0312ca6/requests/228466_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98938df7a284a48af1b214d2b5513c5e 2x, https://si.imgix.net/c0312ca6/requests/228466_0?bg=%23fff&auto=