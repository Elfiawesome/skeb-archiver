4c17-bf88-e8dfc1153156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfa309a03c4781725d22b1dee99e5db8", "thumbnail_srcset": "https://si.imgix.net/92716429/uploads/origins/a069d0aa-9ff4-4c17-bf88-e8dfc1153156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfa309a03c4781725d22b1dee99e5db8, https://si.imgix.net/92716429/uploads/origins/a069d0aa-9ff4-4c17-bf88-e8dfc1153156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d135614deb35274304231d6a49fbb7f5 2x, https://si.imgix.net/92716429/uploads/origins/a069d0aa-9ff4-4c17-bf88-e8dfc1153156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d08fb37a91430d31fc4bbd8c966e7181 3x", "genre": "art", "nsfw": true, "body": "また会ったね！\n\n巨大なヴォアのお腹をした岩井洋人の写真をお願いします！(ヴォア腹の岩井洋人の写真です！このリクエストのために、彼らのOCを使用する許可を得ました！💖\n\nまた、私は本当にあなたのアートスタイルが大好きです！\n\nhttps://www.deviantart.com/nishin1610/art/Hiroto-912750291", "created_at": "", "completed_at": ""}, {"path": "/@bunbunzai/works/26", "thumbnail_src": "https://si.imgix.net/74b6aa78/uploads/origins/fcc1e6c1-77d3-4a7e-98fb-2a5583063f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418c4449815c1459c5e60e877a6b93ac", "thumbnail_srcset": "https://si.imgix.net/74b6aa78/uploads/origins/fcc1e6c1-77d3-4a7e-98fb-2a5583063f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418c4449815c1459c5e60e877a6b93ac, https://si.imgix.net/74b6aa78/uploads/origins/fcc1e6c1-77d3-4a7e-98fb-2a5583063f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=758805c5b1dad3aacd7547b4073164cb 2x, https://si.imgix.net/74b6aa78/uploads/origins/fcc1e6c1-77d3-4a7e-98fb-2a5583063f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adfe6ec94102d8d5d938dcfa061f3d20 3x", "genre": "art", "nsfw": true, "body": "ワルプルギスとマックスに二輪挿しされ、はしたなく喘ぐテスカートルを！\nワルプルギスは前で、マックスは後ろをお願いします！（2人でねちっこく言葉責めして、そんでもって最後に「俺の松茸（皇太子）が果て無き冒険心【マックスハート】！！」で決めて欲しいです）", "created_at": "", "completed_at": ""}, {"path": "/@bunbunzai/works/25", "thumbnail_src": "https://si.imgix.net/f9f99164/uploads/origins/f32d7c35-e3e2-4747-98d2-24baf225ce90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d55d21455a3d5ccfecc341f2585c4b8d", "thumbnail_srcset": "https://si.imgix.net/f9f99164/uploads/origins/f32d7c35-e3e2-4747-98d2-24baf225ce90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d55d21455a3d5ccfecc341f2585c4b8d, https://si.imgix.net/f9f99164/uploads/origins/f32d7c35-e3e2-4747-98d2-24baf225ce90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=145d2b4408c070776ed783acb92cd712 2x, https://si.imgix.net/f9f99164/uploads/origins/f32d7c35-e3e2-4747-98d2-24baf225ce90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86d3a6980ebd30f9fcbe2e79d82dad5c 3x", "genre": "art", "nsfw": true, "body": "ほんとにリクエストさせていただきますm(_ _)m\n\n不良の集団にカツアゲされた友達の報復に、宏人が集団ごとまとめて不良を呑み込んだところをお願いしたいです。\n(10人とか言ってましたが、人数は描ける範囲内でお任せいたしますm(_ _)m)\n腹は破裂しそうに膨らんでいるのですが、当の本人は苦しいながらもしてやった！という感じの表情だと嬉しいです。\nちょっとダークヒーロー(?)ぽい感じで、「1人では何もできないくせに、群れてイキがって人の金を巻き上げるような奴らだ。俺の腹の中で仲良く一つになれるんだから喜んでいるだろう」とか言っててもよいかもしれません(妄想)\n指令とかではなく、友達のために自ら手を下すということでいつも以上のポテンシャルを発揮する気がします。(正義感が暴走するというか...)\n\nこれだけでも大変だと思いますが、もし余裕があれば完全には消化しきれていない状態で次に登校したときに誤魔化している宏人とか見られると嬉しいですm(_ _)m\n(さすがに次の日は全然消化できていなくて休むかな...??それとも...??)\n\nVOREにまで理解がある絵師さん少ないので助かってます...(泣)\nもしよろしければお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@bunbunzai/works/24", "thumbnail_src": "https://si.imgix.net/d02a27a8/uploads/origins/e9d16d33-2393-40af-9816-d97be7fbb0e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6423d27affcd86c0eb839e4ce915fa0", "thumbnail_srcset": "https://si.imgix.net/d02a27a8/uploads/origins/e9d16d33-2393-40af-9816-d97be7fbb0e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6423d27affcd86c0eb839e4ce915fa0, https://si.imgix.net/d