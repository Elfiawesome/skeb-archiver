24f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a81a6283b52b392a8ab8c5d06e745096 3x", "genre": "art", "nsfw": false, "body": "賭けに負けた末にブレイブメンロードを渡るカヤのイラストが欲しいです\n面倒だったら適当に却下してください", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/18", "thumbnail_src": "https://si.imgix.net/068be35c/uploads/origins/36460474-7338-4146-af6d-c6b829c33427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6762c197986d0063cf7c161b7b66a22d", "thumbnail_srcset": "https://si.imgix.net/068be35c/uploads/origins/36460474-7338-4146-af6d-c6b829c33427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6762c197986d0063cf7c161b7b66a22d, https://si.imgix.net/068be35c/uploads/origins/36460474-7338-4146-af6d-c6b829c33427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=418dd7c0f5e81918a9030125badb68e1 2x, https://si.imgix.net/068be35c/uploads/origins/36460474-7338-4146-af6d-c6b829c33427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=135f68238322105002b9b3d84073fbe0 3x", "genre": "art", "nsfw": false, "body": "いつも面白い4コマとKAYAKIN TVをありがとうございます。\n\n陸八魔アルちゃんのイラストをお願いしたいです。\n\n下記、指定内容です。\n\nポーズ:玉座に鎮座し、肘掛けに頬杖をついて脚を組んでいる\n表情:悪事を企んでる時の顔   でお願いします。\n\n各SNSのアイコン、スマホのロック画面で使用を考えてます。\n\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/17", "thumbnail_src": "https://si.imgix.net/d915352e/uploads/origins/1bbdd159-0b72-472c-95e7-c7873cec96bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03fa83ae3155e2e40b7df086f04a1c0d", "thumbnail_srcset": "https://si.imgix.net/d915352e/uploads/origins/1bbdd159-0b72-472c-95e7-c7873cec96bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03fa83ae3155e2e40b7df086f04a1c0d, https://si.imgix.net/d915352e/uploads/origins/1bbdd159-0b72-472c-95e7-c7873cec96bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c0485c6fd75a13eea0206ee4a2475c3 2x, https://si.imgix.net/d915352e/uploads/origins/1bbdd159-0b72-472c-95e7-c7873cec96bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=822b11f20a1df4bbc8913721ff060386 3x", "genre": "art", "nsfw": false, "body": "いつも面白い漫画見させていただいています。見たい構図を思いついたので依頼させていただきます。\n\n<作品>\nブルーアーカイブ\n\n<キャラクター>\n尾刀カンナ\n\n<服装/表情など>\n・通常の衣装\n・うさみみポーズ\n・「先生…こんな格好をさせて楽しいですか？」という感じの嫌そうな顔(セリフ付きでも良いです)\n\n<形式>\n・1枚絵\n・カラー\n\n雑な指定で申し訳ないですが、ご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/16", "thumbnail_src": "https://si.imgix.net/e5175a11/uploads/origins/916b34ad-e863-4014-9b89-50f2e15f2057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7a041619f7c80a3e4819ba156e0fee9", "thumbnail_srcset": "https://si.imgix.net/e5175a11/uploads/origins/916b34ad-e863-4014-9b89-50f2e15f2057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7a041619f7c80a3e4819ba156e0fee9, https://si.imgix.net/e5175a11/uploads/origins/916b34ad-e863-4014-9b89-50f2e15f2057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0dff53e3ce246b650652e3f9a3dc4a13 2x, https://si.imgix.net/e5175a11/uploads/origins/916b34ad-e863-4014-9b89-50f2e15f2057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f175b194aa71bb0d1dceb805cca80d8 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイブの宇沢レイサちゃんを描いてほしいです。Misskey.io(@sears_02)のアイコンのみに使用します。\n構図としては、美しい花束やきらめきの花束を抱き抱えてこちらに笑いかけるレイサちゃんをお願いします。\n今後も応援しています。\n\n宇沢レイサ立ち絵(基本情報の画像より) \nhttps://bluearchive.wikiru.jp/?レイサ\n\n表情例(例示に限らず、笑顔であれば良いです)\nhttps://misskey.io/notes/9k9smwvcuq\n\n花束\nhttps://bluearchive.wikiru.jp/?贈り物#zaeeff28", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/15", "thumbnail_src": "https://si.imgix.net/bbaeec36/uploads/origins/d901cc6e-7c63-45fd-a2d3-b80d210cf5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b371743d93e5bfa5147317cae1b21f88", "thumbnail_srcset": "ht