b583-a4203eb16784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ce21745d4b48a79eec7b76da382565", "thumbnail_srcset": "https://si.imgix.net/ab14fcde/uploads/origins/1315c03e-4edb-4ae8-b583-a4203eb16784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ce21745d4b48a79eec7b76da382565, https://si.imgix.net/ab14fcde/uploads/origins/1315c03e-4edb-4ae8-b583-a4203eb16784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=956078df232ce238d4b2ad3b1fac0312 2x, https://si.imgix.net/ab14fcde/uploads/origins/1315c03e-4edb-4ae8-b583-a4203eb16784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19ea3aaf7c7b9e719f5da52f026c1a08 3x", "genre": "comic", "nsfw": false, "body": "以下のようなコミックの依頼をさせていただきたく思います。\n\n作品：ブルーアーカイブ\n\nストーリー(大まか)\nトリニティ大聖堂に来たハナコとコハル。\nハナコは静かに祈りを捧げていたマリーに近づき、いつもの調子でからかい始める。\nハナコはマリーの口から破廉恥なワードを言わせようとするが、\nマリーは戸惑いつつもなんとかはぐらかし続ける。\nしかし、最後の最後にそういうワードを口走りそうになったマリーをコハルがエ駄死する。\n\nストーリーについては描き進める中である程度変更していただいても構いません。\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/26", "thumbnail_src": "https://si.imgix.net/e55cc010/uploads/origins/0c97bfba-f329-4d31-94ba-17fa23231a70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=195427288167026d7faeeddb9f4ef38f", "thumbnail_srcset": "https://si.imgix.net/e55cc010/uploads/origins/0c97bfba-f329-4d31-94ba-17fa23231a70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=195427288167026d7faeeddb9f4ef38f, https://si.imgix.net/e55cc010/uploads/origins/0c97bfba-f329-4d31-94ba-17fa23231a70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0892f67b8003f1bc3ed2fd237a400119 2x, https://si.imgix.net/e55cc010/uploads/origins/0c97bfba-f329-4d31-94ba-17fa23231a70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1a7555db90ead2622503de36ad75745 3x", "genre": "art", "nsfw": false, "body": "初めまして、pixivとmisskey.ioにてとてもかわいく面白いイラスト見させて頂いております。\nそして少々遅れましたが誕生日おめでとうございます。\n\n誕生日プレゼントか依頼くださいとの事で、是非私の自キャラの絵を描いて頂けないでしょうか？\n自キャラのイメージは資料URLにお付けします（今設定しているアイコンはそれを元に別の絵師様に描いて頂いた物です）。\n\n金髪、緑パーカー、緑のヘッドホン（https://www.sony.jp/headphone/products/MDR-XB950N1/)が抑えられていれば構図含め他はくろいぬ様にお任せいたします。\n\n改めて誕生日おめでとうございます。\n\nhttps://misskey.io/notes/9jvelni13s", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/25", "thumbnail_src": "https://si.imgix.net/412a616d/uploads/origins/ca65810b-21a5-40c1-8c2d-c5744f57ad59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0de84d8e62717d0c3f93eab3449ea4c1", "thumbnail_srcset": "https://si.imgix.net/412a616d/uploads/origins/ca65810b-21a5-40c1-8c2d-c5744f57ad59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0de84d8e62717d0c3f93eab3449ea4c1, https://si.imgix.net/412a616d/uploads/origins/ca65810b-21a5-40c1-8c2d-c5744f57ad59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b87f5800bb9692aebdbc7eff1bb590ff 2x, https://si.imgix.net/412a616d/uploads/origins/ca65810b-21a5-40c1-8c2d-c5744f57ad59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b65802efb15c2d488aacc704b18b01d 3x", "genre": "art", "nsfw": false, "body": "ホロライブ所属Vtuberの雪花ラミィさんのイラストをお願いします。\n趣旨は友人の誕生日（2/17）のお祝いです。ラミィさんがその友人を祝ってくれてるような感じで描いてくださると嬉しいです。\n\n公式プロフィール：https://hololive.hololivepro.com/talents/yukihana-lamy/", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/24", "thumbnail_src": "https://si.imgix.net/a0065c56/uploads/origins/514fd34a-19d9-463e-9f89-3589ded6090f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=848fe22e7cd4eed8ce7bd4564b8f1aa8", "thumbnail_srcset": "https://si.imgix.net/a0065c56/uploads/origins/514fd34a-19d9-463e-9f89-3589ded6090f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=848fe22e7cd4eed8ce7bd4564b8f1aa8, https://si.imgix.net/a0065c56/uploads/origins/514fd34a-19d9-463e-9f89-3589ded6090f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e324a10778456ec7aa2abe75beff4409 2x, https://si.imgix.net/a0065c56/uploads/origins/514fd34a-19d9-463e-9f89-3589ded6090f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6262757ebee4737734f1e434a98ffc07 3x", "genre": "art", "nsfw": false, "body": "### 作品\nブルーアーカイブ\n\n### キャラクター\n白洲アズサ\n\n### 服装/表情など\n・通常衣装\n・ばにたす顔\n　・このようなジト目の表情です：　ᓀ‸ᓂ　\n\n### 形式\n・1枚絵\n・フルカラー\n\n### サイズ\n・SNSアイコン\n・デスクトップ背景(1920x1080)\n\n### 使途\n・各種SNSのアカウント画像\n　・misskey.io\n　・mstdn.mimikun.jp\n　・Discord\n・デスクトップ背景", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/23", "thumbnail_src": "https://si.imgix.net/99f77fe6/uploads/origins/9ca483d4-13e1-4910-a7f5-f5dd775f1e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7aea5e87949ca0c4a51d90bb755cfb7", "thumbnail_srcset": "https://si.imgix.net/99f77fe6/uploads/origins/9ca483d4-13e1-4910-a7f5-f5dd775f1e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7aea5e87949ca0c4a51d90bb755cfb7, https://si.imgix.net/99f77fe6/uploads/origins/9ca483d4-13e1-4910-a7f5-f5dd775f1e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b0ca59e00eaf224b2c5bdffba34b345 2x, https://si.imgix.net/99f77fe6/uploads/origins/9ca483d4-13e1-4910-a7f5-f5dd775f1e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2323bd1d0fcf4a926f2eb2ef448415e 3x", "genre": "art", "nsfw": false, "body": "あけましておめでとうございます🎍\n完全お任せでガミのイラストをお願いします！\n\nサイズ、構図、点数に加え、ポーズや表情、服装もご自由にお願いします！もし背景がある場合はオンオフ可能（背景透過イラストにできる）と嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@96ENU/works/22", "thumbnail_src": "https://si.imgix.net/98b59c74/uploads/origins/a5236611-f5a3-4d17-98f8-6338f59df757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54ae9ed6413e4d67ce5bb481d8866da5", "thumbnail_srcset": "https://si.imgix.net/98b59c74/uploads/origins/a5236611-f5a