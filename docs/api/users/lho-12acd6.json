fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5620c295122546a63ed2fa769ad00c22 3x", "genre": "art", "nsfw": true, "body": "牛柄ビキニの生塩ノアとエッチなことをしている絵をお願いしたいです！\n\n場所はラブホのような場所、竿役は先生、構図は主観中心でプレイはお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@lho/works/83", "thumbnail_src": "https://si.imgix.net/fec3f222/uploads/origins/b6aa998d-148e-4cd7-8697-e6e733308b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9bfbf8bc8170ed1f211b54f28b9dd56", "thumbnail_srcset": "https://si.imgix.net/fec3f222/uploads/origins/b6aa998d-148e-4cd7-8697-e6e733308b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9bfbf8bc8170ed1f211b54f28b9dd56, https://si.imgix.net/fec3f222/uploads/origins/b6aa998d-148e-4cd7-8697-e6e733308b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a1d65da70ac38ed2a0f7cda2e5f30ea 2x, https://si.imgix.net/fec3f222/uploads/origins/b6aa998d-148e-4cd7-8697-e6e733308b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ae1e5a713b81f8edc2f50ae04f314bc 3x", "genre": "art", "nsfw": true, "body": "https://x.com/kanon_hoshizono/status/1732672943967326641\n上記構図でおいで～してる全裸の緋乃あかねさんをお願いしたいです。\n@hino4kane\n表情は誘うような笑み\n髪型は三つ編み\n\n差分として\n・シースルー生地のフロントオープンネグリジェ\n・白のロング手袋+ハイソックス\n・陥没乳首\n・サルートのような花の刺繍が入った赤の下着姿\n\nご検討頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@lho/works/82", "thumbnail_src": "https://si.imgix.net/b861a8c1/uploads/origins/fa90834c-97fb-4ed8-9f42-790c98c03278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57c49587a486bd8563ecbb82aef0e0bf", "thumbnail_srcset": "https://si.imgix.net/b861a8c1/uploads/origins/fa90834c-97fb-4ed8-9f42-790c98c03278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57c49587a486bd8563ecbb82aef0e0bf, https://si.imgix.net/b861a8c1/uploads/origins/fa90834c-97fb-4ed8-9f42-790c98c03278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bec81095c0b28854b572efbbab977dad 2x, https://si.imgix.net/b861a8c1/uploads/origins/fa90834c-97fb-4ed8-9f42-790c98c03278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48a1fa6a16e84b4ebec7921f0fe9c055 3x", "genre": "art", "nsfw": true, "body": "おはこんばんにちは。\nいつも日頃よりお世話になっております。\n前回も最高の素晴らしい作品をありがとうございました。\n\n前回終わってからすぐのリクエストに申し訳ないですが、是非お願いしたいです。\nキャラ、シチュ、スケジュール等問題なければお願いしたいです。\n\n対象キャラ\nFE覚醒の大人チキ（FEH）\n↓（水着大人チキ）\nhttps://altema.jp/fe-heroes/chara/468#profile\n\nシチュ\nナンパ男に引っ掛けられて無責任種付けされて快楽に悦ぶ神竜様チキをお願いしたいです。\n体位等はお任せしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@lho/works/81", "thumbnail_src": "https://si.imgix.net/f48035b3/uploads/origins/a0ba52ab-b418-4a0e-a5a9-461896993cee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce9fbcc47c4cb58df160463774f49cb", "thumbnail_srcset": "https://si.imgix.net/f48035b3/uploads/origins/a0ba52ab-b418-4a0e-a5a9-461896993cee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce9fbcc47c4cb58df160463774f49cb, https://si.imgix.net/f48035b3/uploads/origins/a0ba52ab-b418-4a0e-a5a9-461896993cee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b4c97ed5e28fb206fa24245805c4f7e 2x, https://si.imgix.net/f48035b3/uploads/origins/a0ba52ab-b418-4a0e-a5a9-461896993cee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae57e213fbc39ec70d29db32cca91f75 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します！\n\nキャラ：矢車りね\n服装：全裸で、資料の靴、靴下、帽子、眼鏡のみ。\nまた、向かって右側の乳首には、縦に\n\n矢\n車\n\nと苗字が書かれた名札を安全ピンでつけています。\nシチュ：\n・事後に記念撮影させられているイメージで、この前に中出しや口内射精などされており、体のところどころに精液がかけられている。\n・また、膣内から溢れる精液は粘度が高く、膣からぶら下がったままぷらぷらしている。\n・片手でくぱぁ、片手でピースのポーズ\n・表情は顔を赤くした困り眉の笑顔で、恥ずかしがっているのに無理して笑ってる感じ。\n・足を少し広げて立った体勢で、足の間にフタを開けたランドセルがある。\n・ランドセルの色は衣装と同じようなラベンダー色か黄色\n・ランドセルに入るように勢いよくオシッコをして、ランドセルの中にちゃぷちゃぷしています。\n・吹き出しやカットインのような感じで、卵子に精子が受精しているところを描いていただきたいです。卵子が5個ほどあり、それぞれに3～4匹の精子が受精しています。\n\n受けていただけると幸いです。よろしくお願いします。\n\nhttps://pbs.twimg.com/media/FXopyQbaAAUrtIJ.png", "created_at": "", "completed_at": ""}, {"path": "/@lho/works/80", "thumbnail_src": "https://si.imgix.net/4d6354fc/uploads/origins/23152987-50dc-4de7-9cf1-dc78c294003b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7474179bd3715b7fd74e4e8e0e4fc6e8", "thumbnail_srcset": "https://si.imgix.net/4d6354fc/uploads/origins/23152987-50dc-4de7-9cf1-dc78c294003b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7474179bd3715b7fd74e4e8e0e4fc6e8, https://si.imgix.net/4d6354fc/uploads/origins/23152987-50dc-4de7-9cf1-dc78c294003b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bfb2104de192785c72f623d475d6938 2x, https://si.imgix.net/4d6354fc/uploads/origins/23152987-50dc-4de7-9cf1-dc78c294003b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e960380b926914a6d1b301d98a0cecc4 3x", "genre": "art", "nsfw": true, "body": ".さま\nはじめまして。クアルと申します。\nよければ私のVRCのアバターで一枚お願いします。\n\nリキッドな堕天使で、耳はエルフな感じです。\nキャラに反して明るめな雰囲気な子です。\n\nパイズリフェラであとはご自由にお願いしたいです。\nタトゥーは省略で構いません。\n良ければお願い致します！\n参考画像\nhttps://drive.google.com/file/d/1zKHGKRGJoHUaGAAlNXM17tIbR4P2cHde", "created_at": "", "completed_at": ""}, {"path": "/@lho/works/79", "thumbnail_src": "https://si.imgix.net/a72f211e/uploads/origins/1d0a25cb-6a2b-4962-8a6f-915180319381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=229993725be8ef42b93f7d4cf5446ab9", "thumbnail_srcset": "https://si.imgix.net/a72f211e/uploads/origins/1d0a25cb-6a2b-4962-8a6f-915180319381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=229993725be8ef42b93f7d4cf5446ab9, https://si.imgix.net/a72f211e/uploads/origins/1d0a25cb-6a2b-4962-8a6f-915180319381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97586553ee57c36869300e09fba2d761 2x, https://si.imgix.net/a72f211e/uploads/origins/1d0a25cb-6a2b-4962-8a6f-915180319381?bg=%23fff&auto=format%2Cco