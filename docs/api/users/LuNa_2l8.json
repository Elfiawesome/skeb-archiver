auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6341498014053ee5dd02ba9ef8c68982 2x, https://si.imgix.net/8da2e321/uploads/origins/6e489268-a6b2-4865-ab0d-e65dbf6ec8a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0010e7add4cd5ed05d57767b08746b2 3x", "genre": "art", "nsfw": true, "body": "はるちゃん、またまたこんにちは！\nまた作品をお願いしたいです！\n私のララフェル、ヒューマン、オーラーを一枚の絵にまとめて描いてほしいです。\n\n女性ララフェル（ドワーフ）、名前：キャリー\n91cm\n女性人間、名前：デリーナ\n166cm\n女 オー・ラー、名前：エリフィアン\n152 cm\nキャラクターの詳細は他の作品をご覧ください。\n\nこの服装で描いてください：\nhttps://drive.google.com/drive/folders/1b4vx0oMd-u8CDzhOHsYTpoS02DSkIpIR?usp=sharing\n1はキャリー、2はデリーナ、3はエリフィアン。\n黒い光沢のあるラテックスのスカート、手袋、ストッキング。半透明のシャツで胸と乳首を見せる。他の参考資料からネックレスとチョーカーを加える（クリスタルは彼らの目と一致する）。足が見える場合は、参考資料のヒールを使う。\n\n3つのバージョンを作る：1つは服を着たもの、1つは乳房が見えるラテックスのみ、1つはヌードで、ストッキングと手袋はそのまま。他のバージョンも自由に追加してください。\n\nポーズはお任せしますが、ストッキングで太ももを見せてください。\n背景付きも希望。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1jX5mrhdrS8jBkJjleXKM155FuLgUjDfm?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@LuNa_2l8/works/36", "thumbnail_src": "https://si.imgix.net/9d7dcdf9/uploads/origins/9cd6d7eb-ae1a-47b7-99d3-764739818748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f9460cc39f15dffaede7bff6dfc7a61", "thumbnail_srcset": "https://si.imgix.net/9d7dcdf9/uploads/origins/9cd6d7eb-ae1a-47b7-99d3-764739818748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f9460cc39f15dffaede7bff6dfc7a61, https://si.imgix.net/9d7dcdf9/uploads/origins/9cd6d7eb-ae1a-47b7-99d3-764739818748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=957df8f304d82e075526cd7cff11a167 2x, https://si.imgix.net/9d7dcdf9/uploads/origins/9cd6d7eb-ae1a-47b7-99d3-764739818748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a02bddd68d66d05025219fcfbaffbf61 3x", "genre": "art", "nsfw": false, "body": "はるちゃん様、先日は素晴らしい作品を誠に有難う御座いました。\n今一度リクエストさせて頂きたいと存じます。\n\nアニメ モンスターファーム伝説への道 第20話「ビーナスとの戦い」においてメタルナーに寄生され心を操られたビーナスのSFW立ち絵を描いて頂きたいと思います。\n\n瞳は紅一色に塗り潰された感じで御願い致します。\nそれ以外のシチュエーション等はご自由にお書きして構いません。\n\n報酬が割に合わないと思いましたら再送を御願い致します。\n不都合があれば完全キャンセルして構いません。\nどうか御検討御願い致します。\n\n資料\nビーナス\nhttps://imgur.com/a/2gRACzR\nメタルナー\nhttps://imgur.com/a/RKPNhsa\n寄生して心を支配\nhttps://imgur.com/a/CyU6e7o\nhttps://imgur.com/a/3zpoOMJ\n邪心に染めされられ敵の尖兵に\nhttps://imgur.com/a/qjMjvOa\nhttps://imgur.com/a/meBPl5b\nhttps://imgur.com/a/mlFQZtI\nhttps://imgur.com/a/jwB4w4s\nhttps://imgur.com/a/MbB9R5e\nhttps://imgur.com/a/AQj43bV\n支配に抗い切る時\nhttps://imgur.com/a/bRkYvz1\nhttps://imgur.com/a/zAyMwH6", "created_at": "", "completed_at": ""}, {"path": "/@LuNa_2l8/works/35", "thumbnail_src": "https://si.imgix.net/eab0c956/uploads/origins/a2f14157-e050-4de7-b738-3314bc91307c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fea9edb648e047950260c5918a16b3a", "thumbnail_srcset": "https://si.imgix.net/eab0c956/uploads/origins/a2f14157-e050-4de7-b738-3314bc91307c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fea9edb648e047950260c5918a16b3a, https://si.imgix.net/eab0c956/uploads/origins/a2f14157-e050-4de7-b738-3314bc91307c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44deb5e7616644ae4d20e41c1fc9d9b7 2x, https://si.imgix.net/eab0c956/uploads/origins/a2f14157-e050-4de7-b738-3314bc91307c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e5036b7d36fa6e7979fe55d4edad293 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@LuNa_2l8/works/34", "thumbnail_src": "https://si.imgix.