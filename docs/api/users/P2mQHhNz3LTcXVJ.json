m=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60a873b466857af52a9005bc61bdf6e2 2x, https://si.imgix.net/ad41cd98/uploads/origins/2b26510d-2b5c-4ec0-a5cb-6dcfcd61267f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e91bd4de33091157d16784edc59373c6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@P2mQHhNz3LTcXVJ/works/58", "thumbnail_src": "https://si.imgix.net/d49032a4/uploads/origins/89f9e0e3-9655-486c-ac7b-b3d548166f9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd9f16e04b46ea3436d1ae90f9bc95c6", "thumbnail_srcset": "https://si.imgix.net/d49032a4/uploads/origins/89f9e0e3-9655-486c-ac7b-b3d548166f9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd9f16e04b46ea3436d1ae90f9bc95c6, https://si.imgix.net/d49032a4/uploads/origins/89f9e0e3-9655-486c-ac7b-b3d548166f9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=583728434d9bc71b0985a446cdffa73a 2x, https://si.imgix.net/d49032a4/uploads/origins/89f9e0e3-9655-486c-ac7b-b3d548166f9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a99ed48d7023da0a638c98d90d54a9b 3x", "genre": "art", "nsfw": true, "body": "レインボー・ミカで下記URLのように結合部とミカのお尻片側半分が映る構図で２穴ファックされているシチュをお願いします。\nhttps://drive.google.com/file/d/10FssfKE-1X4P8fQRHVA5y-fHbxmIOfZk/view?usp=sharing\n\n・竿役は筋肉質で体が人間離れして太い緑肌のモンスターで、ミカのケツを大きく描いた上で更にデカいケツで蹂躙されている\n・ミカと竿役ともに激しいセックスで汗だく状態\n・ミカは絶頂して口からヨダレがこぼれている", "created_at": "", "completed_at": ""}, {"path": "/@P2mQHhNz3LTcXVJ/works/57", "thumbnail_src": "https://si.imgix.net/b8fe7ad6/uploads/origins/35e153b0-722b-47db-a2df-08e336867904?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8347707d65859400a736eb2a3484944e", "thumbnail_srcset": "https://si.imgix.net/b8fe7ad6/uploads/origins/35e153b0-722b-47db-a2df-08e336867904?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8347707d65859400a736eb2a3484944e, https://si.imgix.net/b8fe7ad6/uploads/origins/35e153b0-722b-47db-a2df-08e336867904?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c10620b3fcb9d25121fd170927db4ea 2x, https://si.imgix.net/b8fe7ad6/uploads/origins/35e153b0-722b-47db-a2df-08e336867904?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0402c75cfb5b60e19123630543d5857f 3x", "genre": "art", "nsfw": true, "body": "前回のサイバーウォリア春麗が素晴らしかったので今回もサイバーウォリア春麗でリクエストしてみます\n\nシチュエーションは前回と同じくサイバーウォリア春麗がDollsの下級ドールズを相手にしているシーン\n\n最後の一人を倒したサイバーウォリア春麗が自慢の脚で踏みつけトドメを刺す所をやられた下級ドールズ視点みたいな感じで描いてもらいたいと思います（下から見上げる感じ）\n\n踏みつける前の脚を上げた状態と振り下ろしてトドメを刺す2つがあると嬉しいです\n\n詳しい構図や展開、細かい部分はお任せしたいと思います、好きに描いてもらって大丈夫です。\nどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1z6VWwIcRB8S3-x9O5p82y8f8_8F0KoUu?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@P2mQHhNz3LTcXVJ/works/56", "thumbnail_src": "https://si.imgix.net/1b9e5201/uploads/origins/b6f8b919-dd60-4c9c-b669-932ed8ee1e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86421b388447d084940dfb54561e7a2f", "thumbnail_srcset": "https://si.imgix.net/1b9e5201/uploads/origins/b6f8b919-dd60-4c9c-b669-932ed8ee1e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86421b388447d084940dfb54561e7a2f, https://si.imgix.net/1b9e5201/uploads/origins/b6f8b919-dd60-4c9c-b669-932ed8ee1e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5632b5de6eac7e6613159d28e19794d4 2x, https://si.imgix.net/1b9e5201/uploads/origins/b6f8b919-dd60-4c9c-b669-932ed8ee1e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d13909acbcc74f6cdfb4c1859217bc50 3x", "genre": "art", "nsfw": true, "body": "はじめまして、吾と申します。\n他の方のご依頼で作成された邪鬼姫のイラストが素晴らしく、私も依頼させて頂きます。\n\nお願いしたい内容は、邪鬼姫が作中で使用した「Ｔバック幻術」というお尻に見とれさせることで幻術にかけるシーンのイラストになります。\n\n該当のシーンについて資料を用意しましたのでご確認ください。\n\n詳細な構図などはおまかせしますが、\nお尻を見せつけている邪鬼姫と、その周囲に幻術のお尻や桃がグルグル回っているようなイメージで作成して頂ければ幸いです。\n\n分かりにくい内容で申し訳ありませんが、ご検討のほどをよろしくお願いします。\n\nhttps://drive.google.com/file/d/1WAf_3-qZq5qT1Wmy81QzhzjtpxO39Yhd/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@P2mQHhNz3LTcXVJ/works/55", "thumbnail_src": "https://si.imgix.net/ea44dd9a/uploads/origins/dbf4a31f-8b7d-4a92-b183-ac02ad31e161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=314f5bc774e6c7b49f8d41a8e651ed4f", "thumbnail_srcset": "https://si.imgix.net/ea44dd9a/uploads/origins/dbf4a31f-8b7d-4a92-b183-ac02ad31e161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=314f5bc774e6c7b49f8d41a8e651ed4f, https://si.imgix.net/ea44dd9a/uploads/origins/dbf4a31f-8b7d-4a92-b183-ac02ad31e161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=265eed1347a478ae0b161be54d698b40 2x, https://si.imgix.net/ea44dd9a/uploads/origins/dbf4a31f-8b7d-4a92-b183-ac02ad31e161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7884a9d177e83bf3206b296874368b72 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエストしたいと思います\n超重神グラヴィオンのミヅキ・立花が触手でパイロットスーツをビリビリに破かれたイラストをお願いします(大まかなイメージは資料URLにある左胸を隠した図)\n以下、個人的イメージです\n・破かれた瞬間の困り眉な表情\n・触手はおまけ\n・赤い暗転は不要\n・左胸は隠せずに乳首丸見え\n・スーツの破損は資料より多めにアレンジ可能\n・右胸はスーツ越しに乳首の形が分かり、丸見えでなければ破損はお任せ\n\nリクエストを承認していただけたら幸いです、ご検討よろしくお願いします\n\nhttp://blog.livedoor.jp/ryonamoon/archives/1067144493.html", "created_at": "", "completed_at": ""}, {"path": "/@P2mQHhNz3LTcXVJ/works/54", "thumbnail_src": "https://si.imgix.net/74c01670/uploads/origins/dd56026c-f2a1-4624-ae45-584bd387f02a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a030da0ec7b895c37759fe11daf98a4", "thumbnail_srcset": "https://si.imgix.net/74c01670/uploads/origins/dd56026c-f2a1-4624-ae45-584bd387f02a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a030da0ec7b895c37759fe11daf98a4, https://si.imgix.net/74c01670/uploads/origins/dd56026c-f2a1-4624-ae45-584bd387f02a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=604a9a2da97ed64e9fd83f03a25390c1 2x, https://si.imgix.net/74c01670/uploads/origins/dd56026c-f2a1-4624-ae45-584bd387f02a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebfae1cea6680b7dd2aaecdb984a105f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}