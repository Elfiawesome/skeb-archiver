compress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=468e3cef97cc5ffe6bdd174ffc49cb6a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@p59maz/works/12", "thumbnail_src": "https://si.imgix.net/8a3a5b50/uploads/origins/83b5fc1d-bf95-4386-b70a-3e586839b801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=853023d9bc49dc730db612f0a30d3665", "thumbnail_srcset": "https://si.imgix.net/8a3a5b50/uploads/origins/83b5fc1d-bf95-4386-b70a-3e586839b801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=853023d9bc49dc730db612f0a30d3665, https://si.imgix.net/8a3a5b50/uploads/origins/83b5fc1d-bf95-4386-b70a-3e586839b801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc5ba7b2dac431a8886b60c1abe649dd 2x, https://si.imgix.net/8a3a5b50/uploads/origins/83b5fc1d-bf95-4386-b70a-3e586839b801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=629173c32f22b341912177283d13a729 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@p59maz/works/11", "thumbnail_src": "https://si.imgix.net/57a1a846/uploads/origins/e1e92c5b-67b0-4f2a-b955-968e15bc5dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1160e461f1d4c0e2f58b7dd4ab90f2ef", "thumbnail_srcset": "https://si.imgix.net/57a1a846/uploads/origins/e1e92c5b-67b0-4f2a-b955-968e15bc5dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1160e461f1d4c0e2f58b7dd4ab90f2ef, https://si.imgix.net/57a1a846/uploads/origins/e1e92c5b-67b0-4f2a-b955-968e15bc5dae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2e3339c53b1e3e13c2cc89d98a0be2e 2x, https://si.imgix.net/57a1a846/uploads/origins/e1e92c5b-67b0-4f2a-b955-968e15bc5dae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=984edfc8ca437309e28f5e2f44a07d36 3x", "genre": "comic", "nsfw": true, "body": "初めてリクエストさせていただきます。\nもし宜しければラノベ原作のTVアニメ「やはり俺の青春ラブコメはまちがっている。」のキャラ「雪ノ下陽乃」で、モノクロコミック形式にて以下の内容をお願いいたします。\n\n６ページくらいでお願いしたいのですが、料金等不足あれば再送いただけますと幸いです。\n\n◇内容\n大学生の陽乃は休日に街へ繰り出しウインドウショッピングしていると、男からマッサージ屋の半額チケットをもらう（男はマッサージ屋の呼び子）\n半額だからとマッサージ屋に寄ってみる陽乃。\n※ページ数に余裕が無ければ、このシーンはモノローグ的な感じで描写して頂ければと思います。\n\nマッサージ用の服装として黒のマイクロビキニに着替えさせられ恥ずかしくなるも施術が始まる。\n鼠径部や下乳などきわどい箇所を愛撫のようなマッサージを受け次第に感じてくると、マッサージしていた３０歳前後の男の手がビキニの中に侵入してくる。\nおかしいと思い逃げようとするもいつの間にか男達が増えており、押さえつけられて逃げられず、輪姦が始まる。\nイヤイヤと抵抗する言葉を吐くも、身体は正直でどんどん気持ち良くなってしまい、自分から手コキやフェラ、腰を動かしたりし始める。\n騎乗位で手コキとフェラをしながら中出しでフィニッシュ。（手コキはぶっかけ。フェラは口内射精）\nまた来てね♡と言う男達の竿をお掃除フェラしながら「はぁい♡」と答える陽乃\n◇END\n\n\n以上となります。細かい描写などはお任せします。大筋さえ変更なければ書きやすいようアレンジ頂いても大丈夫です。\n竿役の男達はヤリチンみたいな感じで、竿が立派だと嬉しいです。\n快楽堕ちは無しでお願いしますが、イヤイヤ言っても身体は正直に感じてしまう感じでお願いします。\nまた白目を向いたり首を絞めたり、叩いたり等の描写は無しでお願いします。あくまで普通の輪姦でお願いしたいと思います。二穴ＯＫ。\nあと、男視点のバック体位など、おっぱいが見えない描写は無しでお願いしたいです（極力おっぱいが見える感じで）\nセリフはオホ声系などは無しでお願いします。♡マークはＯＫ。\nもし可能ではあればセリフや擬音の有／無verがあると嬉しいです。\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@p59maz/works/10", "thumbnail_src": "https://si.imgix.net/9390ce2f/uploads/origins/a1f8da9f-bcad-4834-8453-b91ea2cd6320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be954853f34748dfad671905e8170147", "thumbnail_srcset": "https://si.imgix.net/9390ce2f/uploads/origins/a1f8da9f-bcad-4834-8453-b91ea2cd6320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad