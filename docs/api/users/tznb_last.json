c77-4458-974e-ddf966386cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e90b03b0bf21f6c9f69de0c72223b4c", "thumbnail_srcset": "https://si.imgix.net/a49979b9/uploads/origins/efc98f1a-4c77-4458-974e-ddf966386cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e90b03b0bf21f6c9f69de0c72223b4c, https://si.imgix.net/a49979b9/uploads/origins/efc98f1a-4c77-4458-974e-ddf966386cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddb90d02feec7441baf47d1548009072 2x, https://si.imgix.net/a49979b9/uploads/origins/efc98f1a-4c77-4458-974e-ddf966386cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cc008979a50ef5f5746e7a6b55f6bd4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！\n\n私は先生の作品がとても好きです。私のOCにケーキの双子のペアがいます。この二人のデュオイラストを描いてみませんか？完成品は私用です。衣装は自由です。\n\n(わかりやすく説明するのが心配なので、今回は中国語で書いてみたので、翻訳に不備があったらご容赦ください！)\n\n登場人物\n設定は「ケーキ・ツインズ」。\nピンク髪が姉で、ブルーベリー＋イチゴジャム＋フロスティングケーキという設定。魔天使の属性。\n青い髪が姉で、ピーチ＋シーソルト味のケーキという設定。口属性のない白い悪魔。\n\nコスチュームの特徴\nピンクの髪：\n- テーマはブルーベリー＋ストロベリージャムのフロストケーキ。\n- エクカップ、ふわふわのケーキスカート、黒いシルクが特徴。\n- スカートの細かいラメ（フロスティングとクラッシュダイヤです）にはご注目ください。\n- マリコの頭にはリボン。\n- 左胸の脇の下のほくろ。\n- 黒い天使の羽と後光。\n青い髪：\n- テーマはピーチ＋シーソルトチーズケーキ。\n- カップ、フィッシュテールのスウィングスカート、白いシルクが特徴。\n- スカートのウェーブはシーソルトの塩味を思わせる。\n- スカートの背中のリボンとスカートの貝殻は要注意。\n- 結んだ髪にリボンが絡まっている。左太ももの内側のほくろ。\n- 白い悪魔の羽と後光。\n\nバックストーリー\nケーキの双子は、甘いバースデーケーキから生まれた双子。\n姉は祝福された魔法を持つ堕天使で、二重人格を持つ「スプリット・パーソナリティ」の属性を持っている。ケーキの双子はケーキのフロスティングとベリーから生まれる。星のようなアイシングは「星のような知恵」を象徴している。人付き合いは得意だが、人間が大嫌い。\n妹は呪われた魔法を持つ白魔だが、口のない表情の下には純粋で優しい心がある。海塩バタークリームと桃のケーキの中で生まれた。海塩バタークリームは「海のような広い心」を象徴している。彼女は人間が大好きだが、言葉はあまり得意ではない。\nどちらの妖精も身長は20センチだが、人間の女性の身長（約160センチ）になることができる。通常、子供たちは夢の中でしか妖精を見ることができない。そして、願い事をする方法は、寝る前にフルーツとシーソルト・ケーキを置くことである。妖精が子供たちの願いを聞くと、ケーキは消えてしまう。祝福された子供たちも願いが叶う。\nケーキの双子は、季節や行事、気分によってさまざまな服装に着替える。双子の好みはあまり一致しておらず、姉は甘いものを好み、妹はしょっぱいものを好む。姉は黒いものを好み、妹は白いものを好む。多くの違いがあるが、二人の妖精は同じ心を共有している。\n\n単純化できる複雑なディテールがあり、妻は自分の描き方、手つき、ニーズに合わせてある程度自由に遊ぶことができる。あなたの作品をとても楽しみにしています。\n\nお読みいただきありがとうございました！\n\nはるか\n\nhttps://imgur.com/a/8wSTyTm", "created_at": "", "completed_at": ""}, {"path": "/@tznb_last/works/328", "thumbnail_src": "https://si.imgix.net/1a78bd1c/uploads/origins/0ac176f4-c50e-419d-8963-e56b774ef86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27db384a6a80e09d50b635f63ac61f01", "thumbnail_srcset": "https://si.imgix.net/1a78bd1c/uploads/origins/0ac176f4-c50e-419d-8963-e56b774ef86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27db384a6a80e09d50b635f63ac61f01, https://si.imgix.net/1a78bd1c/uploads/origins/0ac176f4-c50e-419d-8963-e56b774ef86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af32a0384be1484bd80bb80ed3bfa450 2x, https://si.imgix.net/1a78bd1c/uploads/origins/0ac176f4-c50e-419d-8963-e56b774ef86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=168900004a9a3b8b485523352e84efaf 3x", "genre": "art", "nsfw": false, "body": "モロヘイヤさん、リクエスト再開ありがとうございます…！資料にいる自宅の男2人を描いて頂きたいです。\n\n2人は恋人です。ゲーム世界で出会い、後に現実で会って色々ありながらも付き合うことになった子達です。\n資料を見て感じ取ったように描いてください…！\n距離が近い感じだと嬉しいです！\n\n新堕は元々視力が弱いので、黒縁メガネをした姿がありますが、メガネをするかしないかはおまかせします。\n\n【注意点】\n2人にはアホ毛があります。\n新堕(白髪)には目の下に2連ホクロがあり、目にハイライトがありません(恋人の前で微笑む場合はハイライトが宿ります)\n\nこちらだけ気をつけて頂ければ幸いです🙇‍♀️\nご検討よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1u9cyMiXp_ARa96pcueSdHJAvNwY-gurz", "created_at": "", "completed_at": ""}, {"path": "/@tznb_last/works/327", "thumbnail_src": "https://si.imgix.net/f7ef105f/uploads/origins/a5c6b4d8-c203-4b17-af5e-2497775f4ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73e012829a82c91faa7899aed3821cd9", "thumbnail_srcset": "https://si.imgix.net/f7ef105f/uploads/origins/a5c6b4d8-c203-4b17-af5e-2497775f4ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&