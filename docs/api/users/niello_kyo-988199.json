mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7235ee2189fbffc39e5ddee4ec1b268 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@niello_kyo/works/25", "thumbnail_src": "https://si.imgix.net/88fd51c7/uploads/origins/a838940e-6a4e-4e58-babc-c32139873356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa1cc7f247efb08537605af28051350", "thumbnail_srcset": "https://si.imgix.net/88fd51c7/uploads/origins/a838940e-6a4e-4e58-babc-c32139873356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa1cc7f247efb08537605af28051350, https://si.imgix.net/88fd51c7/uploads/origins/a838940e-6a4e-4e58-babc-c32139873356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f16b01cf6412d13f43dbd3ed8f9fbb3f 2x, https://si.imgix.net/88fd51c7/uploads/origins/a838940e-6a4e-4e58-babc-c32139873356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a5082edf6a928be73f771852fe4ba11 3x", "genre": "comic", "nsfw": true, "body": "以前、不良ギャル2人にいじめられている男子高校生がメインで最初は暴行、パシリなどをさせられていたいじめられっ子ですが不良ギャルの興味本位で性的なイジメに変わっていく作品を作って頂いたものです！\nこの続きをお願いしたいのですが可能であれば引き続き付け乳はなし体の改造などもなし、あくまでいじめで女装させられていて主人公は逆らえず乗り気ではない感じ\n強制女装、陵辱、恥辱、的な要素を入れてもらえたら嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@niello_kyo/works/24", "thumbnail_src": "https://si.imgix.net/44750e70/uploads/origins/a3e40416-639d-4bbc-b890-b6d083912e76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca26fb7981c4d2381050c525bb73e9b7", "thumbnail_srcset": "https://si.imgix.net/44750e70/uploads/origins/a3e40416-639d-4bbc-b890-b6d083912e76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca26fb7981c4d2381050c525bb73e9b7, https://si.imgix.net/44750e70/uploads/origins/a3e40416-639d-4bbc-b890-b6d083912e76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=766b0035bda58f7aa02bd4d77cef9f46 2x, https://si.imgix.net/44750e70/uploads/origins/a3e40416-639d-4bbc-b890-b6d083912e76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70f60c5dcebea95cb764a9ab4c6d7695 3x", "genre": "comic", "nsfw": true, "body": "にえろさんの作品がとても好きで漫画制作をお願いしたいです\nストーリーは、不良ギャル2人にいじめられている男子高校生がメインで最初は暴行、パシリなどをさせられていたいじめられっ子ですが不良ギャルの興味本位で性的なイジメに変わっていき\n①全裸オナニー\n②地毛に化粧され女子制服を着せられアナルにバイブを入れられてオナニー\n③カツラを被され化粧され女性の下着を着させられ下着姿のまま不良ギャルにペニバンで犯される\n④女装させられ一日中アナルにおもちゃをいれられそのまま授業を受けさせられ放課後不良ギャルが男子生徒数人と待ち受けていてそのまま男子生徒に犯させる\nなど次第にエスカレートしていき毎日様々ないじめをうけ凌辱される感じでお願いします\n可能であればどこかにフェラの描写、舞台は学校、不良ギャルはドSで結構きつめ、主人公は気弱、つけ乳はなし、男子生徒に犯される時制服がはだけ下着が見えてる感じで描いてもらえたらうれしいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@niello_kyo/works/23", "thumbnail_src": "https://si.imgix.net/c03ab53d/uploads/origins/89c165f2-3929-4dec-a307-ab31392e7ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e823ede5095c4a5bdeab4ce61df8cbb", "thumbnail_srcset": "https://si.imgix.net/c03ab53d/uploads/origins/89c165f2-3929-4dec-a307-ab31392e7ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e823ede5095c4a5bdeab4ce61df8cbb, https://si.imgix.net/c03ab53d/uploads/origins/89c165f2-3929-4dec-a307-ab31392e7ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6064851e4faf147648152170b5debd55 2x, https://si.imgix.net/c03ab53d/uploads/origins/89c165f2-3929-4dec-a307-ab31392e7ae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3d0c9317a4f56d1613e5ff60e151543 3x", "genre": "comic", "nsfw": true, "body": "概要\n異世界にts転生した男装美少女がチート能力で無双し、レズハーレム(全員ふたなり娘)を築くが、ベッドの上じゃクソザコすぎてハーレムメンバー全員の性処理便器にされる話をお願いします。\n\n昼間、ts娘がハーレムメンバーを連れてギルドに依頼を受けに行くシーン。クールにかっこよく振る舞い、周囲の人間からキャーキャー言われる。\n\n夜、ベッドの上でハーレムメンバーに輪姦されながら絶頂しまくるシーン。何度も許しを請うても聞いてもらえず絶頂し続ける。ケツを何度も叩かれる。\n\nページ数に余裕があれば事後に全裸土下座でふたなり娘にお礼を言うシーンをお願いします。\n\n主人公の設定は以下でお願いします。\n金髪ツインテール(元々ショートヘアだったが、ハンドルとして便利なためツインテールの髪型にされている)、男装しても一目でメスだとわかる巨乳デカケツ。\n\nふたなりのハーレムメンバーの設定はおまかせします。", "created_at": "", "completed_at": ""}, {"path": "/@niello_kyo/works/22", "thumbnail_src": "https://si.imgix.net/1cbc1814/uploads/origins/9928c83d-bee5-4dee-8ff0-c73839a533c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909009f28bc5c9f4000e6b1d4932a5a8", "thumbnail_srcset": "https://si.imgix.net/1cbc1814/uploads/origins/9928c83d-bee5-4dee-8ff0-c73839a533c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909009f28bc5c9f4000e6b1d4932a5a8, https://si.imgix.net/1cbc1814/uploads/origins/9928c83d-bee5-4dee-8ff0-c73839a533c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7427a98c3e42717ca5f87b6916246e2 2x, https://si.imgix.net/1cbc1814/uploads/origins/9928c83d-bee5-4dee-8ff0-c73839a533c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ac84a9720beeec180dfbc731e51f167 3x", "genre": "comic", "nsfw": true, "body": "男の子が女性の反社会的組織に拉致され、身体をメス化させられた上で裏社会の秘密の夜の店で働かされてしまう、といった作品をお願いします。\n\n具体的なシチュエーションとしては、\n男の子が突然女の子の半グレ集団に問答無用で拉致され、お金目当てで女性の反社会的組織に売られてしまう\n男の子はそこでメス化の施術を受けさせられ、ナチュラルロングに伸ばされ整えられた頭髪、\nとても大きな胸、肉感的でむちむちにされたお尻やふともも、といった、\nそのままのペニスを除けば、男の子の元々の女顔も込みで、\n完全にかわいらしい女の子にしか見えない姿にされてしまい、\nさらに胸元や生脚を大きく露出したセクシーなバニーガールの衣装を着せられ、\nマスカラやチーク、リップなどのお化粧をバッチリとされて女装させられてしまう\n（なお、バニーガールの服の生地はピッチリと肌に密着する感じであり、\n　ペニスの形が（修正が掛からない程度に）ハッキリと現れてしまう）\n\nそして男の子は当該の反社会的組織は経営する女性専用の裏社会の秘密の夜のお店\n（イメージとしてはキャバレーとかそんな感じ）のホールスタッフとして働かされること、\nそのお店で一定の金額を稼いだら解放されること、\nただし男の子が稼いだお金にカウントされるのは、\nお客さんがホールスタッフのバニーガールである男の子に対しセクシー、可愛いと感じた時に\n胸の谷間に差し込むチップのみであることが告げられる\n\nそして男の子はお店でホールスタッフのバニーガールとしてしっかりと働かされ、\nお店の営業時間外もチップをしっかりと稼ぐためのセクシーで可愛い接客の指導を受けさせられてしまう\n\nといった感じでお願いします。\n\nなお、作品に登場する人物は、拉致されて色々とされる男の子を除いて、\nモブ（組織の構成員やクラブの客や従業員など）含めすべて女性でお願いします。\n\n色々と細かく指定して申し訳ありませんがよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@niello_kyo/works/21", "thumbnail_src": "https://si.imgix.net/20187a06/uploads/origins/2f32e079-9b1b-469b-8fef-0763c27b13c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35ab69942009aa5303f91d8897034b14", "thumbnail_srcset": "https://si.imgix.net/20187a06/uploads/origins/2f32e079-9b1b-469b-8fef-0763c27b13c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35ab69942009aa5303f91d8897034b14, https://si.imgix.net/20187a06/uploads/origins/2f32e079-9b1b-469b-8fef-0763c27b13c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=551def0bf73c58dcf0462ddb0a81f504 2x, https://si.imgix.net/20187a06/uploads/origins/2f32e079-9b1b-469b-8fef-0763c27b13c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0d617c05b08642e670849f4c11ab07a 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@niello_kyo/works/20", "thumbnail_src": "https://si.imgix.net/fd4fe0ff/uploads/origins/10fbc8e5-61c5-4bd5-89f0-101a6b0390cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e610a67b00176a6c2e57c689f7a58f53", "thumbnail_srcset": "https://si.imgix.net/fd4fe0ff/uploads/origins/10fbc8e5-61c5-4bd5-89f0-101a6b0390cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e610a67b00176a6c2e57c689f7a58f53, https://si.imgix.net/fd4fe0ff/uploads/origins/10fbc8e5-61c5-4bd5-89f0-101a6b0390cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=