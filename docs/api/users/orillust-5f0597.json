eaa-531a172e1cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c262a87eed5304ca52b40574922de506", "thumbnail_srcset": "https://si.imgix.net/dfa6e8f9/uploads/origins/70deec94-8f0a-41cf-9eaa-531a172e1cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c262a87eed5304ca52b40574922de506, https://si.imgix.net/dfa6e8f9/uploads/origins/70deec94-8f0a-41cf-9eaa-531a172e1cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31fc8f65c94892cee60951d105a9c1df 2x, https://si.imgix.net/dfa6e8f9/uploads/origins/70deec94-8f0a-41cf-9eaa-531a172e1cf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da21f956f141aab092900d7b84b0be13 3x", "genre": "art", "nsfw": false, "body": "vtuberエイトを描いてほしいです。\n\nお任せします！\nよろしくお願いします！\n\nhttps://twitter.com/etaeight/status/1671328065857933315", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/16", "thumbnail_src": "https://si.imgix.net/1c2e1895/uploads/origins/82602713-b842-4f05-9268-bd0b1d5c2ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=904eaa11ad4f62092f4aa050e62759e5", "thumbnail_srcset": "https://si.imgix.net/1c2e1895/uploads/origins/82602713-b842-4f05-9268-bd0b1d5c2ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=904eaa11ad4f62092f4aa050e62759e5, https://si.imgix.net/1c2e1895/uploads/origins/82602713-b842-4f05-9268-bd0b1d5c2ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52dd00fb7648c240bfe58c25cd986496 2x, https://si.imgix.net/1c2e1895/uploads/origins/82602713-b842-4f05-9268-bd0b1d5c2ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b99754fa4de4af8ce854808f6845ffdf 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n最近は厳しい暑さが続きますがお体にご自愛下さいませ。\n\n今回はサーレ・エル・アルバ君の腰から上のイラストをお願いしたく依頼送信させていただきました。\n使用用途としてはTwitterやYouTubeのサムネ等に使わせていただきたいと考えています。\n\n希望の構図は特にございませんが、サムネイルでは右側に置くことが多いため、顔や体の向きは正面または気持ち左側を向いているとありがたいです。\nまた、角や手等のパーツも見切れずに全て入っているととても助かります。\n可能であれば背景透過版でいただけますと大変ありがたいです。\n\n初めてのスケブ依頼の為、至らない点があれば申し訳ございません。\nお忙しいところ恐れ入りますがよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/15", "thumbnail_src": "https://si.imgix.net/51c904e1/uploads/origins/5d4cf783-d9a5-415c-a541-01eb2fca7a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2496cc3013bc1906b1f740b5829b8141", "thumbnail_srcset": "https://si.imgix.net/51c904e1/uploads/origins/5d4cf783-d9a5-415c-a541-01eb2fca7a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2496cc3013bc1906b1f740b5829b8141, https://si.imgix.net/51c904e1/uploads/origins/5d4cf783-d9a5-415c-a541-01eb2fca7a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b60ce36f9915e4d371c2d5d7af0f5e75 2x, https://si.imgix.net/51c904e1/uploads/origins/5d4cf783-d9a5-415c-a541-01eb2fca7a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e07c8bd27b405755658329d8c125a61c 3x", "genre": "art", "nsfw": false, "body": "夏！水着！古神子まる！\n可愛い彼女をよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/14", "thumbnail_src": "https://si.imgix.net/c2414042/uploads/origins/4bb51f32-2404-402c-8977-a747a7c3e2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7109bb0f8bb2f8e26a852512480c0318", "thumbnail_srcset": "https://si.imgix.net/c2414042/uploads/origins/4bb51f32-2404-402c-8977-a747a7c3e2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7109bb0f8bb2f8e26a852512480c0318, https://si.imgix.net/c2414042/uploads/origins/4bb51f32-2404-402c-8977-a747a7c3e2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d39ad44d807987b20b9320d5b73427b3 2x, https://si.imgix.net/c2414042/uploads/origins/4bb51f32-2404-402c-8977-a747a7c3e2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=400683cf649f6c8731c845d0a152edb6 3x", "genre": "art", "nsfw": false, "body": "夜八さん、お久しぶりです！\n以前、キャラデザしていただき、ありがとうございました！\nキャラデザしていただいた「ユーティミア・デュカキス」「フリッカ・リンナエウス」の2人をお好きなように描いていただけたらと思います。\n\nユーティミアはバリキャリタイプの財務官僚で、フリッカは土いじりや植物採取が好きな農務官僚。\n仕事は全然違いますが、王国の官僚同期で仲がよく、気心が知れた間柄です。仕事の愚痴を言い合ってたり、一緒にになって厄介な敵と交渉に臨んだり、と親友同士の付き合いです。\n参考シーンはお出しするものの、基本的にはデザインしてもらった夜八さんのインスピレーションに全部お任せします！\n参考シーンは、何か糸口がつかみたいときにお役立ていただければ、程度の扱いです。\n\n《参考》仕事の愚痴シーン\nhttps://kakuyomu.jp/works/1177354054896245637/episodes/16816452220617878182\n《参考》厄介な敵との交渉シーン\nhttps://kakuyomu.jp/works/1177354054896245637/episodes/16816927860620460681\n\n資料URLに以前いただいた3面図とキャラ設定が入っています。\n(資料URL間違えてたので、キャンセルして送りなおしました)\n\nhttps://drive.google.com/drive/folders/1BxbvKiYmzxn3DHzqGNEJBW_21rBohzJ5?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/13", "thumbnail_src": "https://si.imgix.net/8a4ee6e4/uploads/origins/b6409fb7-3821-46e2-a2cf-ff5d5ec5f89c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d404b26a18ac16a5a4f7dec2ca669c4", "thumbnail_srcset": "https://si.imgix.net/8a4ee6e4/uploads/origins/b6409fb7-3821-46e2-a2cf-ff5d5ec5f89c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d404b26a18ac16a5a4f7dec2ca669c4, https://si.imgix.net/8a4ee6e4/uploads/origins/b6409fb7-3821-46e2-a2cf-ff5d5ec5f89c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=927c0213a094406ca9a8619394b1f973 2x, https://si.imgix.net/8a4ee6e4/uploads/origins/b6409fb7-3821-46e2-a2cf-ff5d5ec5f89c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecc86ab90a5ebe3dfd4c9d4330a47517 3x", "genre": "art", "nsfw": false, "body": "有馬美樹と申します。\n先にリクエストしたユーティミアと同期だった官僚でもある、\nもう一人のうちの子をリクエストさせていただきました。\n\n【リクエスト】\n・キャラ：うちの子（フリッカ）\n\n私の書いているWeb小説「ルナティアーノ・サガ」の登場人物\n「フリッカ・リンナエウス」の三面図をお願いいたします。\n\nカスタムキャストで作った参考画像(1)をもとに三面図を描いてください。\n参考画像(2)をもとに以下を付けてください。\n1.胸元に付けた桜のブローチ→シロツメクサの意匠を取り入れたブローチ（着脱可能）\n2.悪魔のピッチフォーク→農具のピッチフォーク\n\n・参考画像(1)：\nカスタムキャストで作ったモデルのスクリーンショット\n→資料URLの「CC」フォルダ配下にあります\n\n・参考画像(2)：\nカスタムキャストで再現できないブローチ、ピッチフォーク、胸元のブローチ有無、頭の髪飾り有無の参考画像\n→資料URLの「accessories」フォルダ配下にあります\n\n・フリッカとユーティミアの体格差\n農務官僚のフリッカはアウトドア系、財務官僚のユーティミアはインドア系と差があります\n→資料URLの「CC」フォルダ配下にあります\n\n【容姿に言及した初登場シーン】\n第15話　果樹園と牧場(2)\nルナティアーノ・サガ～「異世界」を知らない騎士が言葉も通じない国で目覚めたら～／有馬美樹\nhttps://kakuyomu.jp/works/1177354054896245637/episodes/1177354054988885761\n\n＞二台の馬車が屋敷に着く頃、小柄でややふっくらとした体格の女性が待っていた。しかし、その身なりは村人にしては垢抜けており、王都出身のユーティミアにどこか雰囲気が似ている。\n＞しっかりと手を握ってわかった。ユーティミアよりも一回り手が大きく、ごつごつとしている。日常的に土をいじっているように彼には思われた。\n＞少し丸っこい顔に笑みを浮かべ、フリッカは元気よく応えたのであった。\n\nなにとぞ、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/xs37bg8340u0rle/AABj5Gz4a290jmqer8nWH14Ma?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/12", "thumbnail_src": "https://si.imgix.net/301fc7f3/uploads/origins/ed7f0705-be7d-4957-86ad-a0db97aef401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea84c115547348a82b6ca3e16e8d559", "thumbnail_srcset": "https://si.imgix.net/301fc7f3/uploads/origins/ed7f0705-be7d-4957-86ad-a0db97aef401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea84c115547348a82b6ca3e16e8d559, https://si.imgix.net/301fc7f3/uploads/origins/ed7f0705-be7d-4957-86ad-a0db97aef401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92d22d877980f53f527f2d134dcdfaa3 2x, https://si.imgix.net/301fc7f3/uploads/origins/ed7f0705-be7d-4957-86ad-a0db97aef401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a784e40bb73c3339148025f3020bb4e 3x", "genre": "art", "nsfw": false, "body": "有馬美樹と申します。\n以前よりマストドンやTwitterでイラストをお見かけしていて、\nご依頼をさせていただきたいと思いリクエストさせていただきました。\n\n【リクエスト】\n・キャラ：うちの子（ユーティミア）\n\n私の書いているWeb小説「ルナティアーノ・サガ」の登場人物\n「ユーティミア・デュカキス」の三面図をお願いいたします。\n\nカスタムキャストで作った参考画像(1)をもとに三面図を描いてください。\n髪型は「後ろ髪の長くないイクノディクタス（ウマ娘）」のような、\nやや横にボリュームのある前下がり気味にお願いします。\n\n・参考画像(1)：\nカスタムキャストで作ったモデルのスクリーンショット\n→資料URLの「CC」フォルダ配下にあります\n\n・参考画像(2)：\nカスタムキャストで再現できない髪型の参考画像\n→資料URLの「hairstyle」フォルダ配下にあります\n\n【容姿に言及した初登場シーン】\n第9話　イメルダからの使者(1)\nルナティアーノ・サガ～「異世界」を知らない騎士が言葉も通じない国で目覚めたら～／有馬美樹\nhttps://kakuyomu.jp/works/1177354054896245637/episodes/1177354054921719978\n\n＞キリっとした凛々しい顔立ちに横に細長い楕円形の眼鏡をかけており、深い青色をした黒髪を肩の上で斜めに切りそろえ、知的で近寄りがたい雰囲気を漂わせている。\n＞体格はラエティティアのような軍人の類ではなく、線が細い体躯だ。ただ、博物館やアルス・マグナの研究員たちのような学者然とした態度でもなかった。\n＞二十代半ばの比較的若い大蔵府の官僚であるが、財政や財務に関わる知識があり、帳簿の取り扱いに長けていたことから先般の徴税監察官の一人として抜擢された経緯があった。\n\nなにとぞ、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/jcjjkd9ld6r9d9b/AABLtIQ9GdXBRUOKZW_Zmb98a?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/11", "thumbnail_src": "https://si.imgix.net/a40adb7b/uploads/origins/5c3b1fa0-2bb4-44ae-95cf-648d2eca58a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f60f91992d3a5d6cabf07574ac3485c", "thumbnail_srcset": "https://si.imgix.net/a40adb7b/uploads/origins/5c3b1fa0-2bb4-44ae-95cf-648d2eca58a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f60f91992d3a5d6cabf07574ac3485c, https://si.imgix.net/a40adb7b/uploads/origins/5c3b1fa0-2bb4-44ae-95cf-648d2eca58a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41d6911d4f9ae4624906b7050deefa52 2x, https://si.imgix.net/a40adb7b/uploads/origins/5c3b1fa0-2bb4-44ae-95cf-648d2eca58a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c688efcc52f29081c4480d0fcb49e5b4 3x", "genre": "art", "nsfw": false, "body": "VRChatというゲームをやってます。\n有坂みと様のセフィラちゃんを改変して使用させて頂いてます。\nアバターのアートをよろしくお願いします。\n\n写真はクソガキ感が出てますが出来れば猫みたいな感じでドヤ顔をお願いしたいです。\nポーズは夜八さんにお任せします。\n乱雑なオーダーですがよろしくお願いします。\nhttps://drive.google.com/drive/folders/1WhLvjEfByB2gHFq3Gtylyr65ZSQw7SiB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/10", "thumbnail_src": "https://si.imgix.net/c5cf5bf3/uploads/origins/ee9f7cb3-ac11-4401-9e24-17620f10be3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c7c92eff669ae3e0610ced593f845b", "thumbnail_srcset": "https://si.imgix.net/c5cf5bf3/uploads/origins/ee9f7cb3-ac11-4401-9e24-17620f10be3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c7c92eff669ae3e0610ced593f845b, https://si.imgix.net/c5cf5bf3/uploads/origins/ee9f7cb3-ac11-4401-9e24-17620f10be3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=354e80dfe2498dbeb031405f50fc27f8 2x, https://si.imgix.net/c5cf5bf3/uploads/origins/ee9f7cb3-ac11-4401-9e24-17620f10be3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02aa43e217246b8b70c7a17924e7c153 3x", "genre": "art", "nsfw": false, "body": "Hello hello, I would like to request a drawing of my character please.\n\nできれば明るい表情のものがいいのですが、何でもいいです。\n\n引用元: https://drive.google.com/drive/folders/1pAj4qfS4TLHWnf5Lh0HsEShbrXC1cIfb?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/9", "thumbnail_src": "https://si.imgix.net/e47e4979/requests/170076_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c582023bb86c5ecd078c019299d0f5c5", "thumbnail_srcset": "https://si.imgix.net/e47e4979/requests/170076_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c582023bb86c5ecd078c019299d0f5c5, https://si.imgix.net/e47e4979/requests/170076_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de3bc6bdee936a6fe2fc50dcaa9cb0e6 2x, https://si.imgix.net/e47e4979/requests/170076_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=785ec5060c94bb4d5c9b689bf6781b19 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n男の娘VTuber「天ノ川けい」がメイド服を着るイラストをお願いします。\nスカートは短くて脚が見える事にしてください。\n元気なポーズと表情だったら嬉しいです。\n\n参考：\nhttps://drive.google.com/file/d/1KKDf4m3TeqP8VLq6mOxQtV264g2afBKb/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@orillust/works/8", "thumbnail_src": "https://si.imgix.net/ee18f879/requests/147179_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b64c5834769e27be8316a3a3