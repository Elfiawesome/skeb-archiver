9f55-58bae6bf605d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1e4ec904fcca02c0db575fd9027e81", "thumbnail_srcset": "https://si.imgix.net/1aee1838/uploads/origins/c4af7e0b-db76-422a-9f55-58bae6bf605d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1e4ec904fcca02c0db575fd9027e81, https://si.imgix.net/1aee1838/uploads/origins/c4af7e0b-db76-422a-9f55-58bae6bf605d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cdfd332e9a743bc0b9dc726f2bd01ac 2x, https://si.imgix.net/1aee1838/uploads/origins/c4af7e0b-db76-422a-9f55-58bae6bf605d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c11032981f7f70989c61c11698771ea3 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n私のVtuberモデルLink Vagarと私のVtuber友達朝比奈ユウトのNSFWアートワークを描いてほしいです。\n\nLink Vagarは黒とオレンジの毛の猫ボーイです。チョーカーとリストバンドはつけていますが、それ以外は全裸でお願いします。\n\n朝比奈ユウトは紫色の毛をした猫の男の子です。全裸で描いてください。\n\n参考URLにある参考ポーズに近いポーズで描いてください。\n\n朝比奈ユウトはウケになります。ロープで縛られて仰向けになる。\n\nリンク・ヴァガーがセメとなり、立って朝比奈ユウトを犯す。\n\n自分の顔に射精する朝比奈ユウトを描いてください！\n\n背景や表情はお任せします！\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1MizRf6uDn_v-Rgp1FXV2ZKjVlLkWRY4P?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@0141NITAMAGO/works/21", "thumbnail_src": "https://si.imgix.net/5917af3d/uploads/origins/e77333b9-ea66-4fcf-bc2a-766999ded3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2f25cf084843b86d560c9120b263bed", "thumbnail_srcset": "https://si.imgix.net/5917af3d/uploads/origins/e77333b9-ea66-4fcf-bc2a-766999ded3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2f25cf084843b86d560c9120b263bed, https://si.imgix.net/5917af3d/uploads/origins/e77333b9-ea66-4fcf-bc2a-766999ded3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e69028a1ff4c3ce8533fb83b9c6da138 2x, https://si.imgix.net/5917af3d/uploads/origins/e77333b9-ea66-4fcf-bc2a-766999ded3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aae8ccefb201c80602a502c567c475b1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！メッセージをありがとう！エリの描写がとてもお上手なので、あなたのスタイルにぴったりだと思います！修道女姿の彼を、お好きなシーンやポーズで描いてください。\n\nhttps://drive.google.com/drive/folders/1zSGx-hGex-5TvVfOq75E2BrBWAyIRL5p?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@0141NITAMAGO/works/20", "thumbnail_src": "https://si.imgix.net/340bc9ea/uploads/origins/0963cf48-ff93-403e-9002-73f138b261e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b733bcca2002d978e48c8a4b0bc3ddad", "thumbnail_srcset": "https://si.imgix.net/340bc9ea/uploads/origins/0963cf48-ff93-403e-9002-73f138b261e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b733bcca2002d978e48c8a4b0bc3ddad, https://si.imgix.net/340bc9ea/uploads/origins/0963cf48-ff93-403e-9002-73f138b261e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=422a6b8c3f2f92afb85d4390c6503852 2x, https://si.imgix.net/340bc9ea/uploads/origins/0963cf48-ff93-403e-9002-73f138b261e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7671e22b1c79b5c7e3230efa28b974d 3x", "genre": "art", "nsfw": true, "body": "彼に興味を持ってくれて光栄だし、ぜひ描いてほしい！\nあなたのアイデアを紙に書いて、何が起こるか見てみましょう。\nポーズや構図はお任せします！参考画像のアルバムはこちら：https://drive.google.com/drive/folders/1msyaAebNJybwW-j9YupVPuR85v7A_T_c?usp=drive_link\n\n彼の褐色の肌を正しく描いてください。\n\nhttps://drive.google.com/drive/folders/1msyaAebNJybwW-j9YupVPuR85v7A_T_c?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@0141NITAMAGO/works/19", "thumbnail_src": "https://si.imgix.net/ab177927/uploads/origins/04c1bd42-8a2d-415b-96b7-e3fede1e8dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72989d5c033c126ec46cfb27be62dc14", "thumbnail_srcset": "https://si.imgix.net/ab177927/uploads/origins/04c1bd42-8a2d-415b-96b7-e3fede1e8dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72989d5c033c126ec46cfb27be62dc14, https://si.imgix.net/ab177927/uploads/origins/04c1bd42-8a2d-415b-96b7-e3fede1e8dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cf6c524ef071b1f8df6b54ac9091736 2x, https://si.imgix.net/ab177927/uploads/origins/04c1bd42-8a2d-415b-96b7-e3fede1e8dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6092f219c26c1483c8119f113665e9e5 3x", "genre": "art", "nsfw": false, "body": "先日はアピールありがとうございます！\n大変熱量の感じられるアピールで思わずリクエストさせて頂きました！(フォリオ等も拝見しました…！)\n\n依頼したいのは自身と友人のOCの2人です。\n(正確にはTRPGというゲームシステムのうちの一つ、クトゥルフ神話TRPG出身の「探索者」です。)\nシチュエーションや構図などはお任せしたいです…！\n\n2人は探偵業を営んでおり、恋人同士です。\n\n探偵\n名前：神々廻千隼\n性別：男性\n身長：178cm(+7cmのヒール)\n年齢：24歳\n職業：探偵(社長)\nモチーフ：蝶、天使、傲慢\n誰に対しても傲慢不遜な態度を取る美人。対人コミュニケーションがかなり下手くそ。その為依頼人とのやり取りは助手に任せるなどして本人は事件解決のみを行う。推理もせず答えのみを言って帰るため、助手は毎度苦労している。動物に好かれやすい体質で、公園で座っていれば野良猫や野鳥に囲まれる。\n助手にはデレデレ。これでもかという程甘やかし、欲しいと言ったもの全てを与えようとする。常に「可愛い」と言われたい為、身だしなみには気を遣っている。\n\n助手\n名前：黒鉄一真\n性別：男性\n身長：184cm\n年齢：22歳\n職業：探偵助手/医大生\nモチーフ：蛇、嫉妬\n探偵の家に住み込んでいる大学生。他人のことを考えない探偵に振り回されつつもしっかりとサポートをする。よく生活が疎かになりがちな探偵の世話をしている。依頼人との交渉や仕事の後始末など全てを行う為に苦労をしているが、探偵にゾッコンな為嫌な顔をせず仕事をする。探偵が常に正しいと思っている。\n探偵とは反対に、あまり動物に好かれない性質。家で飼っている白猫には好かれないが、積極的に世話をしているサモエドの子犬にはとても懐かれている。\n金の使いが荒い探偵に比べ、倹約家。\n\n描くのに不必要な情報が多いかもしれませんが、よろしくお願いします…！\n\nhttps://drive.google.com/drive/folders/1-ZuDlfXsJtRX736PCf_tW9lOaeqaa0Q6", "created_at": "", "completed_at": ""}, {"path": "/@0141NITAMAGO/works/18", "thumbnail_src": "https://si.imgix.net/dbf4a246/uploads/origins/625c82c6-a57c-48b5-94a5-eb885f2259c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81192a188d51c17d96617bba1997c26e", "thumbnail_srcset": "https://si.imgix.net/dbf4a246/uploads/origins/625c82c6-a57c-48b5-94a5-eb885f2259c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81192a188d51c17d96617bba1997c26e, https://si.imgix.net/dbf4a246/uploads/origins/625c82c6-a57c-48b5-94a5-eb885f2259c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr