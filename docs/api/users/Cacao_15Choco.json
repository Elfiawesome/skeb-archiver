o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dc5acfee6c151d047265508516f0ae4 2x, https://si.imgix.net/c042c64f/uploads/origins/0ffb664e-8342-4292-8c41-01d504460438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a10c4b8b3b83c38ae3bd0b4d387067e 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nカカ尾様にうちのこを描いていただきたいです。\n\n資料には4人いますが、1人でも複数人でも自由に選んで構いません。\nシチュエーションや服装、髪型の変更等も全てお任せします。\n\n【使用用途】\n・Instagramストーリーにて、描いていただいた旨を添えて投稿。\n・個人観賞用に印刷\n\nご検討よろしくお願いします。\n\nhttps://note.com/preview/ndaacc93b30df?prev_access_key=44dd76b27a471b97808489339bb403f5", "created_at": "", "completed_at": ""}, {"path": "/@Cacao_15Choco/works/99", "thumbnail_src": "https://si.imgix.net/e6e0fb40/uploads/origins/0a9f7418-bc1f-4383-a34c-707c8cd4f562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0946fbda53a8274802823686fe24d074", "thumbnail_srcset": "https://si.imgix.net/e6e0fb40/uploads/origins/0a9f7418-bc1f-4383-a34c-707c8cd4f562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0946fbda53a8274802823686fe24d074, https://si.imgix.net/e6e0fb40/uploads/origins/0a9f7418-bc1f-4383-a34c-707c8cd4f562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a7a1bd7694063df9d5f61e5a8258949 2x, https://si.imgix.net/e6e0fb40/uploads/origins/0a9f7418-bc1f-4383-a34c-707c8cd4f562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9d62eb229d97c72396229a53b647a62 3x", "genre": "art", "nsfw": false, "body": "アピールを拝見しました。\nVR体mosquitoをリクエストします。\n\nVroid Hubから冬制服提案いただきましたので、\nコチラでお願いします。\n\nhttps://hub.vroid.com/characters/4665924910287486284/models/7676901895563647770", "created_at": "", "completed_at": ""}, {"path": "/@Cacao_15Choco/works/98", "thumbnail_src": "https://si.imgix.net/53887140/uploads/origins/68ea1733-70f5-452d-a3e0-98da7bda2b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67d8b0e2ea0e20adf4b70e9ac9a3856e", "thumbnail_srcset": "https://si.imgix.net/53887140/uploads/origins/68ea1733-70f5-452d-a3e0-98da7bda2b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67d8b0e2ea0e20adf4b70e9ac9a3856e, https://si.imgix.net/53887140/uploads/origins/68ea1733-70f5-452d-a3e0-98da7bda2b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2b9be3d3b1ef84d448bd9f3ff433d8d 2x, https://si.imgix.net/53887140/uploads/origins/68ea1733-70f5-452d-a3e0-98da7bda2b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77581bd13f0c121ce471857aa24fffc1 3x", "genre": "art", "nsfw": false, "body": "カカ尾様\nはじめまして。\nこの度はアピールしていただきありがとうございます！\nまた、私のオリジナルキャラクター達にご関心をお寄せいただき、大変光栄に思います。\nカカ尾様の作品を拝見いたしましたところ、絵柄や雰囲気がとても好みでございましたので、是非私のオリジナルキャラクター達を描いて頂きたく思い、リクエスト致しました。\n各キャラクターの外見・設定等につきましてはURLにまとめてありますのでご覧いただけますと幸いです。\n\n【要望】\n・イラストの内容につきましてはアピールでおっしゃっていた物でお願いいたします！\n・各キャラの衣装やデザイン、イラストの構図やキャラの表情等につきましてはご自由に描いていただければと存じます。\n\n【その他】\n今回のリクエストにつきまして、金額や資料の不足、条件が合わない等といった不都合な事がございましたらお気兼ねなくキャンセルしていただいて問題ございません。\n\nリクエスト内容は以上でございます。\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1zdxI8y2nCSz0PqgJ9AqtZpSRPj8Gviq0", "created_at": "", "completed_at": ""}, {"path": "/@Cacao_15Choco/works/97", "thumbnail_src": "https://si.imgix.net/95f5f462/uploads/origins/30357dfb-14d0-4835-9752-d2ea27ad87ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ca2991ecd6bef3a63d614b6ce84cd8f", "thumbnail_srcset": "https://si.imgix.net/95f5f462/uploads/origins/30357dfb-14d0-4835-9752-d2ea27ad87ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ca2991ecd6bef3a63d614b6ce84cd8f, https://si.imgix.net/95f5f462/uploads/origins/30357dfb-14d0-4835-9752-d2ea27ad87ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d84d9612ed57a0fc8dd63f2486e44432 2x, https://si.imgix.net/95f5f462/uploads/origins/30357dfb-14d0-4835-9752-d2ea27ad87ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c099e3538e75b764b39e42fc70ce031b 3x", "genre": "art", "nsfw": false, "body": "カカ尾さん、お返事が遅くなってすみません。\n\nスカーレットはカロスに住む16歳のお金持ちの女の子です。彼女は東宝のレミリア・スカーレットを一部モデルにしていて、高慢な態度が似ています。服装はポケモンX・Yのエリートトレーナーをベースに、薔薇のついた帽子を加えています。\n\nスカーレットは実は私のキャラクターではないので、彼女を作った友人と相談したかったんです。もう片方の手にはハイパーボールを持って、https://files.catbox.moe/js9vz3.jpg。\n\nさらに、スカーレットは小さい頃、吸血鬼のふりをしていた。ちびバージョンでは、両手を広げて口を開け、偽の吸血鬼の歯を見せてほしい。https://www.istockphoto.com/photo/man-in-halloween-costume-of-vampire-scaring-gm1391013335-447777424。\n\nご連絡ありがとうございました！\n\nhttps://www.dropbox.com/scl/fi/dol4wz1brnleuwsaf3pz4/Scarlette-Reference-Sheet.png?rlkey=6vrdj0rq8zg90z0jxqaqtzkyh&st=kyzrju2u&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Cacao_15Choco/works/96", "thumbnail_src": "https://si.imgix.net/3d789552/uploads/origins/b7e86e05-d6b7-422d-8640-615608bfac35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38137830bcd6f4fa69ca7f6fc7a46cf5", "thumbnail_srcset": "https://si.imgix.net/3d789552/uploads/origins/b7e86e05-d6b7-422d-8640-615608bfac35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38137830bcd6f4fa69ca7f6fc7a46cf5, https://si.imgix.net/3d789552/uploads/origins/b7e86e05-d6b7-422d-8640-615608bfac35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c33bc9f0309426be48487798ea965f39 2x, https://si.imgix.net/3d789552/uploads/origins/b7e86e05-d6b7-422d-8640-615608bfac35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=097c0810059912e96664d4281f89f46c 3x", "genre": "art", "nsfw": false, "body": "カカ尾様\n\nアピールありがとうございます。\n私の作品を読んだ上での、アピールたいへん感激致しました。\n\nよろしければカカ尾様のご提案通り、うちの子のレヴィーアを描いていただければと思います。\n絵柄や構成などはすべてご自由にお任せします。\n\nお返事おそくなってしまいましたが、よろしくお願いします。\n\nhttps://novelup.plus/story/483336383/633212495", "created_at": "", "completed_at": ""}, {"path": "/@Cacao_15Choco/works/95", "thumbnail_src": "https://si.imgix.net/a698993f/uploads/origins/cb0f45f5-4301-419e-b493-cfd12f5c