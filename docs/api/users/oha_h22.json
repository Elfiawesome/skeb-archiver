ox.com/scl/fo/azwfl22t8yshfcfcou0nb/APFg87PLpJmDmD5zsAejFgo?rlkey=5woci00fplx60lisv09wf332z&st=y12n0fry&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@oha_h22/works/69", "thumbnail_src": "https://si.imgix.net/d5b8f1bc/uploads/origins/ff9934c0-b327-4cfe-aabc-ecc0ef9c9cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fff00b56cbf7050a3b0fe3ae427b58", "thumbnail_srcset": "https://si.imgix.net/d5b8f1bc/uploads/origins/ff9934c0-b327-4cfe-aabc-ecc0ef9c9cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fff00b56cbf7050a3b0fe3ae427b58, https://si.imgix.net/d5b8f1bc/uploads/origins/ff9934c0-b327-4cfe-aabc-ecc0ef9c9cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09bb453d7ae7365c9a7114533c108100 2x, https://si.imgix.net/d5b8f1bc/uploads/origins/ff9934c0-b327-4cfe-aabc-ecc0ef9c9cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3758a2600a2e0fd201d7f7e9e4ab6b2 3x", "genre": "art", "nsfw": true, "body": "こんにちは。急に冷える季節いかがお過ごしでしょうか。\n\nウチの娘のクルスをお願いしたかったです。\nクルスの資料はこちらです(　https://sp.nijie.info/view.php?id=655146　)。\n\n構図はこちら(　https://sp.nijie.info/view.php?id=710926　)の三枚目の様な正常位でお願いしたかったです。断面図を入れるかどうかはお任せします。\n\nお手隙でこの条件でよろしければお願いします。\n\nhttps://sp.nijie.info/view.php?id=655146", "created_at": "", "completed_at": ""}, {"path": "/@oha_h22/works/68", "thumbnail_src": "https://si.imgix.net/cefe1381/uploads/origins/eae6850f-49f1-4aaf-9c55-b47a7315ce9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7cebbe542c9580dae2545c062f46b4", "thumbnail_srcset": "https://si.imgix.net/cefe1381/uploads/origins/eae6850f-49f1-4aaf-9c55-b47a7315ce9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7cebbe542c9580dae2545c062f46b4, https://si.imgix.net/cefe1381/uploads/origins/eae6850f-49f1-4aaf-9c55-b47a7315ce9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=143c61764c88a14e899ba332ef0fedd0