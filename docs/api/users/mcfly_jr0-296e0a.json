=200&h=200&s=a8986576d360176a223f2536bf23d927, https://si.imgix.net/9adedcfa/uploads/origins/aab3e288-6cf9-4d84-8505-2b140969f553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b45dfa77ae4f707a96e2d81ae2e6acc5 2x, https://si.imgix.net/9adedcfa/uploads/origins/aab3e288-6cf9-4d84-8505-2b140969f553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71ed681af3cc24781074e1d3b6529bc7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n前回は大変ありがとうございます！\n\nキャラクター\n久海菜々美\n\n服装\n前回のレオタード\n\nシチュエーション\n菜々美がヨボヨボ爺とお互いの足の裏を美味しいそうに舐め合う。\n菜々美の足裏は水虫臭いようにムワっと臭そうにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mcfly_jr0/works/49", "thumbnail_src": "https://si.imgix.net/6c0e5647/uploads/origins/6ad7941a-225f-42dc-b0f0-89645b70bbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1574837db70f0cc0e34e2a821d6c648", "thumbnail_srcset": "https://si.imgix.net/6c0e5647/uploads/origins/6ad7941a-225f-42dc-b0f0-89645b70bbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1574837db70f0cc0e34e2a821d6c648, https://si.imgix.net/6c0e5647/uploads/origins/6ad7941a-225f-42dc-b0f0-89645b70bbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f325535ba0a51e80ef1d21dd4ddfa83 2x, https://si.imgix.net/6c0e5647/uploads/origins/6ad7941a-225f-42dc-b0f0-89645b70bbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c8f1cfdb57c62e55e24de8540674e93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mcfly_jr0/works/48", "thumbnail_src": "https://si.imgix.net/ce4bd550/uploads/origins/831ada96-30df-4ab2-8292-8273311f6bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d963f0e71d7982049624637b8027791", "thumbnail_srcset": "https://si.imgix.net/ce4bd550/uploads/origins/831ada96-30df-4ab2-8292-8273311f6bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d963f0e71d7982049624637b8027791, https://si.imgix.net/ce4bd550/uploads/origins/831ada96-30df-4ab2-8292-8273311f6bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=156131ee4827f70df47a648b94f3f963 2x, https://si.imgix.net/ce4bd550/uploads/origins/831ada96-30df-4ab2-8292-8273311f6bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610c318fea1ac54cefdb64f032c26c52 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mcfly_jr0/works/47", "thumbnail_src": "https://si.imgix.net/8c3db7f6/uploads/origins/788e8218-b517-4e02-9331-90eb299d1565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44924a89c7d24ac1abac06d58bdad511", "thumbnail_srcset": "https://si.imgix.net/8c3db7f6/uploads/origins/788e8218-b517-4e02-9331-90eb299d1565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44924a89c7d24ac1abac06d58bdad511, https://si.imgix.net/8c3db7f6/uploads/origins/788e8218-b517-4e02-9331-90eb299d1565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c94bea71b6a973d022b226d8f2eb53d4 2x, https://si.imgix.net/8c3db7f6/uploads/origins/788e8218-b517-4e02-9331-90eb299d1565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6523543efba4e1614fe5929c69659a48 3x", "genre": "art", "nsfw": true, "body": "ユニコーンオーバーロードのベレンガリアをお願いします。\n\n・下記作品と同様の構図で尻コキ\nhttps://skeb.jp/@mcfly_jr0/works/27\n・右目（傷で閉じてる）は髪で隠すか、見えない構図で\n・衣装は赤いインナーは着用で、鎧は無し\n\n\n◆資料\nhttps://unicorn-overlord.com/character/berengaria/\nhttps://x.com/vanillaware_boy/status/1765573090157699183\n\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mcfly_jr0/works/46", "thumbnail_src": "https://si.imgix.net/f7a66cd3/uploads/origins/0c97822f-61f2-4c17-9cba-0a091b8e2ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29175e8220c6e48f0bd9fb289c3ae175", "thumbnail_srcset": "https://si.imgix.net/f7a66cd3/uploads/origins/0c97822f-61f2-4c17-9cba-0a091b8e2ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29175e8220c6e48f0bd9fb289c3ae175, https://si.imgix.net/f7a66cd3/uploads/origins/0c97822f-61f2-4c17-9cba-0a091b8e2ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=256596d7490b8b39200a25908da9fe91 2x, https://si.imgix.net/f7a66cd3/uploads/origins/0c97822f-61f2-4c17-9cba-0a091b8e2ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be5b37752615740e560ec61680607441 3x", "genre": "art", "nsfw": true, "body": "前回はエッチで素敵なミカヤのイラストをありがとうございました。着崩していく様子や騎乗位楽しんだり余裕なくなっていく様子を表情の変化を楽しめて嬉しかったです。\n今回は「ファイアーエムブレムEchoes」に登場する魔導士の女の子メイを、下記URLのバニー風衣装を元にお願いします。\nhttps://guide.fire-emblem-heroes.com/02002002001216-2/\nシチュは春祭りに参加していたメイ、可愛い衣装で祭りを盛り上げて楽しくなり、仲良くなった祭りの参加者の男性に可愛いと煽てられるまま普段なら乗らない誘いにのってお持ち帰りされ宿でコスプレエッチしてしまう…の様な今回もオフパコ的なイメージでセックスさせてください。相手は若い男性のイメージで、頭見える場合は髪はある様に描いて下さい。\n以前描いて頂いたワユの様な、ベッドに寝かされ足を開き後ろから抱かれながら挿入される側位の体位でセックスする様子をお願いします。資料URLのような女性器周辺がよく見えるアングルで、片方の胸を揉まれたりしながら激しくセックスしている様子を挿入前から事後まで描いて頂けたら嬉しいです。メイについては照れたりはしても嫌がらず楽しんでしまってる様子で、バニー衣装の金色の部分から開いて(お尻側まで繋がってるので大きく開けると思います)女性器やお尻の穴が丸出しにして照れながら誘ってる様子や、勃起した男性器に驚いたり挿入されてちょっと苦しそうにしたり余裕出てきて気持ち良くなってきてる様子、中出しされ絶頂してる様子や、事後男性器を抜かれ女性器から精液垂らしながら上気した顔で満足そうにしてる様子など、可能な範囲でお願いできればと思います。\n衣装については胸の部分捲って胸を露出させたり半脱ぎにさせて下さい。卵のバスケットはどこかに置くかなくても構いません。また可能であれば擬音や喘ぎ声など付けて頂けれたら嬉しいです。\n以上、よろしければお願いします。\n\nhttps://www.dropbox.com/scl/fi/xkxk0q6k5li4z7j25gzfl/6.jpg?rlkey=hprd00bduoew06yc7a9wywj89&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@mcfly_jr0/works/45", "thumbnail_src": "https://si.imgix.net/f492ae51/uploads/origins/c0723345-3f82-459e-a379-c54b7c956e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9fa2d9db24c3ed20f074cc37f23ce8c", "thumbnail_srcset": "https://si.imgix.net/f492ae51/uploads/origins/c0723345-3f82-459e-a379-c54b7c956e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9fa2d9db24c3ed20f074cc37f23ce8c, https://si.imgix.net/f492ae51/uploads/origins/c0723345-3f82-459e-a379-c54b7c956e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4957cb9097a94bb43c504f19b5e0b56 2x, https://si.imgix.net/f492ae51/uploads/origins/c0723345-3f82-459e-a379-c54b7c956e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c9f685d661c43e0a87e9beda80c3db3 3x", "genre": "art", "nsfw": false, "body": "お世話なっております。\n\n前回は素晴らしいイラストをありがとうございました。\n\n連続でのお願いとなりますが再度、\nエイシンフラッシュのイラストをお願いしてみたく思います。\n\n〇依頼内容\n\n・前回と同じ黒ビキニ＋ハイヒールのアメスク。\nなお今回は資料画像(https://images.app.goo.gl/jgWXmmpm8DSoXUgZ8)と同じ\n「黒いハイソックス」に加え「ハートマークの金具のガーターリング」\nの姿でお願いできればと思います。\n\n・立ち姿か軽く腰掛けた正面寄りのアングルで\n全身を収めていただけますと嬉しいです。\n\n・今回も胸の谷間を強調しつつ\n片方のビキニの紐に指を掛けて浮かせ気味にしながら\n悪戯っぽく微笑む。\n\n・可能でありましたらレイヤーを別にした差分として、\n\n「黒色のレース模様付きニーハイストッキング(下記参考URL)」\n\nを着用させたものを頂けますと嬉しく思います。\n\n今回も要望が多く恐縮ですが、ご検討のほどよろしくお願いいたします。\n\nhttps://www.google.com/imgres?imgurl=https%3A%2F%2Fimg.fril.jp%2Fimg%2F690273623%2Fl%2F2283393856.jpg%3F1717563516&tbnid=Uz1j", "created_at": "", "completed_at": ""}, {"path": "/@mcfly_jr0/works/44", "thumbnail_src": "https://si.imgix.net/abec67d5/uploads/origins/af5e3d96-6eee-4a36-b4cf-5c7cbd68349f?bg=