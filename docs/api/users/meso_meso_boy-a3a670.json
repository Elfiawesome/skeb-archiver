b1-f780c61b3da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29dee78ef9feaaa942a56d169924c003", "thumbnail_srcset": "https://si.imgix.net/d3c5220c/uploads/origins/d8ebc578-ebbb-412e-9ab1-f780c61b3da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29dee78ef9feaaa942a56d169924c003, https://si.imgix.net/d3c5220c/uploads/origins/d8ebc578-ebbb-412e-9ab1-f780c61b3da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e313b21e65c13c2c10c415cec436ce80 2x, https://si.imgix.net/d3c5220c/uploads/origins/d8ebc578-ebbb-412e-9ab1-f780c61b3da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3592823b294b59098555b64415ce8b16 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@meso_meso_boy/works/4", "thumbnail_src": "https://si.imgix.net/9381dd43/uploads/origins/2785b9f0-cd92-48d3-a521-efc67af55c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bd43953971be3a8f23b68220d7c5f1d", "thumbnail_srcset": "https://si.imgix.net/9381dd43/uploads/origins/2785b9f0-cd92-48d3-a521-efc67af55c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bd43953971be3a8f23b68220d7c5f1d, https://si.imgix.net/9381dd43/uploads/origins/2785b9f0-cd92-48d3-a521-efc67af55c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26591d4e018d3ce3fc579db2214d0485 2x, https://si.imgix.net/9381dd43/uploads/origins/2785b9f0-cd92-48d3-a521-efc67af55c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=083f0299c3049c9747569b945d0bbc78 3x", "genre": "art", "nsfw": false, "body": "お初にお目にかかります。\nデベ様の格好良さも可愛さも兼ね備えた絵柄や、描いたキャラクターの活き活きとした表情を見るのがとても好きです。\n今回TRPG探索者である二名をぜひお願いしたく、リクエストを送らせていただきました。\n\n黒髪の男：やや寡黙で心配性、真面目。白髪の少女を大事に思っている面倒見のいいちょっとダメなお兄さん。やや大人びた見た目とは裏腹に格好つけたがりでやや子どもっぽい一面が垣間見える。190㎝。\n白髪の少女：良くも悪くも素直、無垢。人に対しやや警戒心の高いあどけなさの残る少女。表情変化がやや乏しい。黒髪の男より寡黙だがかなりしっかりしており、どちらかといえばこちらが相手の事を守っている方。150~60cm代\n\n両名等帯刀しており、構図上見えづらくなっていますが男性の方は狐面を頭に付けています。\n\n二名、もしくは白髪の少女のイラストをお願いしたく思っております。こちらに関して、表情や構図などはすべてお任せしますので自由に描いていただければと思います。\n頂いたイラストに関しては観賞用として大切に楽しませていただきます。\n\n不備等ありましたら申し訳ございません。近頃暑さも増し、何かと大変な時期ではありますがご自身の都合に合わせご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1v8HlfEytKBg6j-9_Vo0SHNPyAvzPnqUf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@meso_meso_boy/works/3", "thumbnail_src": "https://si.imgix.net/a7570575/uploads/origins/8450dc78-743a-449f-bddf-baf27fa264ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=518a725a66c6191e9dfbd86c5a4d60ef", "thumbnail_srcset": "https://si.imgix.net/a7570575/uploads/origins/8450dc78-743a-449f-bddf-baf27fa264ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=518a725a66c6191e9dfbd86c5a4d60ef, https://si.imgix.net/a7570575/uploads/origins/8450dc78-743a-449f-bddf-baf27fa264ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c472cad5f6f65c0c21a185af8afb68c2 2x, https://si.imgix.net/a7570575/uploads/origins/8450dc78-743a-449f-bddf-baf27fa264ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f98de26911e3683fdd082e4d4090d431 3x", "genre": "art", "nsfw": false, "body": "デベチヨさん\n\nいつもお世話になっております。\n\nこの度TRPG探索者である二名をお願いしたくリクエストを送らせて頂きました。\n追記：ドライブのリンクに不備があったためキャンセルし再送しております。\n\n茶髪の男：仏頂面で神経質、気難しく目つきも多少悪い（瞳が小さい）男です。年齢は20代、身長は170cm代。表情筋が中々に動かず、また動いたとしても皮肉ったような笑みになります。\n\n黒髪の男の子：陽気で素直、距離感も近いフレンドリーな男性です。年齢身長共に茶髪の男と同じくらいです。こちらはいつも明るい表情をしており、愛嬌があるため人好きされやすいです。\n\n両名ともに演奏家であり、また演奏への情熱があります。お互いに放っておけば一日中練習をしかねないほどです。茶髪の男はヴァイオリンを、黒髪の男の子はヴィオラを弾いています。\n\n2人、或いは黒髪の男の子のイラストをお願いしたく思っております。\nシチュエーションや構図などは全てお任せします。頂いたイラストはSNSで紹介させていただく場合がありますが、あくまで他意は無く嬉しく見せびらかしたいだけですのでご了承ください。\nSkeb依頼に慣れていないため、不備がありましたら申し訳ございません。体調面や他作業など、ご自身の都合に合わせてご検討いただけますと幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Sdk0AFDf2tJXNpUMeB7c_5Mal_eIBdc0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@meso_meso_boy/works/2", "thumbnail_src": "https://si.imgix.net/ab49d48d/uploads/origins/d0b2aad4-ba39-42d9-99f8-daede5270fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c3ac84ef25235a3184e0ec04359349b", "thumbnail_srcset": "https://si.imgix.net/ab49d48d/uploads/origins/d0b2aad4-ba39-42d9-99f8-daede5270fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c3ac84ef25235a3184e0ec04359349b, https://si.imgix.net/ab49d48d/uploads/origins/d0b2aad4-ba39-42d9-99f8-daede5270fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f454cfbe0905b43ae08d80d4bcd014bd 2x, https://si.imgix.net/ab49d48d/uploads/origins/d0b2aad4-ba39-42d9-99f8-daede5270fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd8a7eb2074fb531ff4d0a414ab49c07 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nこの度は個人観賞用うちの子イラストをお願いしたく参りました。\n\n資料は以下のリンクにまとめさせていただきました。\nカノヨ街通過のため作成したキャラクターになります。リンク内にネタバレ要素を含むものはございません。\nhttps://drive.google.com/drive/folders/1iOWg46e5mqtFW2eIMj00T48qVlofhzLY?usp=sharing\n\n名前：鵺虎(ﾔｺ)\n性格：人の財布に集る悪ガキショタです。\n\nお魚咥えたどら猫しているところを描いて頂きたいです。\n他、細かい部分の構図等は全てお任せいたします。\n\nご多忙中大変申し訳ありませんがご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iOWg46e5mqtFW2eIMj00T48qVlofhzLY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@meso_meso_boy/works/1", "thumbnail_src": "https://si.imgix.net/fd43124f/uploads/origins/033c49e1-fa3d-465c-9591-68b762ab9ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cc058117724cfd20d1e0505e2cc6f65", "thumbnail_srcset": "https://si.imgix.net/fd43124f/uploads/origins/033c49e1-fa3d-465c-9591-68b762ab9ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cc058117724cfd20d1e0505e2cc6f65, https://si.imgix.net/fd43124f/uploads/origins/033c49e1-fa3d-465c-9591-68b762ab9ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=276beaa341bcde9ff5f65ce6cddd85fd 2x, https://si.imgix.net/fd43124f/uploads/origins/033c49e1-fa3d-465c-9591-68b762ab9ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91f5d9d7e1ff4a114cbfc87eab09b999 3x", "genre": "art", "nsfw": false, "body": "デベチヨさん\n\n初めまして、皮と申します。\n\nこの度はデベチヨさんがコミッションをされているのを見てまってまってまってお願いしますとお願いしたく思いメッセージを送らせていただいております。\n\nTRPG探索者である2人をお願いしたく、先に資料のリンクを失礼いたします。\n徒月さん（黒いの）と鳳仙（白いの）となります。\nhttps://www.dropbox.com/sh/tbq3pv0nd6a2s0d/AACHvg3a4KrLpKO1jACzCi2Ca?dl=0\n\n相場がわからず、2人は難しい場合、徒月さん（黒いの）だけでもお願いしたいです。\n\nそれぞれのステータスとしては\n【徒月】44歳、177cm\n【鳳仙】33歳、181歳\nとなります。\n\n関係性としては仕事上ではバディ、相棒、上司（徒月）部下（鳳仙）。\n私生活においては双方完全なる親愛の上で同じ家にいます。\n家事等の所謂妻的な役割は鳳仙（白いの）が担っており、相手方の徒月さん（黒いの）は休日にショッピングモールに行き家族の買い物をそこらへんのベンチみたいな椅子で煙草吸って待ってる感じの人です。お父さん\n鳳仙（白いの）は基本愛想はいいですが他者の作ったものは食べられず、本心をさらけ出すのは相棒にのみ、といったわかりやすいそういうあれです。\nクソデカ親愛です。\n\n2人、あるいは徒月さんの絵をお願いしたく思っております。\nシチュエーションなどは本当にどんなものでもよく、例えば仕事中だったり、家でのんびり過ごしていたり本当に なんでも ﾊｱｯ なんでも\nご検討いただけましたら幸いです、難しい場合はあまりにもこういったものを頼むのに慣れておらず乱文失礼いたしました。\n\n2022/10/1 皮", "created_at": "", "completed_at": ""}]}