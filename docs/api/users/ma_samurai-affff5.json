ングしているだろうなぁと思うので\nありえたかもしれないそんな姿が見たいです。\n脚はたっぷり見えると嬉しいですが、下着等の露出は無しでお願いします。\n\n最後になりますが、\n何分初めてこの手の依頼をするため\n衣装や構図などの説明で不足や難しい内容があるかもしれません。\nその場合は描きやすいように解釈・変更していただければと思います。\n\n是非ともよろしくお願いいたします。\n\n【参考】\n事務所の二次創作ガイドライン\nhttps://twitter.com/akatsukiuni/status/1037689096284434432\n\nhttps://camp-fire.jp/projects/view/594837?list=watched", "created_at": "", "completed_at": ""}, {"path": "/@ma_samurai/works/16", "thumbnail_src": "https://si.imgix.net/9e3caa45/uploads/origins/f3664250-cdc5-4d2e-812f-934cacf7b2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e925893b6394c2c87ce9f44320440381", "thumbnail_srcset": "https://si.imgix.net/9e3caa45/uploads/origins/f3664250-cdc5-4d2e-812f-934cacf7b2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e925893b6394c2c87ce9f44320440381, https://si.imgix.net/9e3caa45/uploads/origins/f3664250-cdc5-4d2e-812f-934cacf7b2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e6d2a471625339eb47d216d502eda24 2x, https://si.imgix.net/9e3caa45/uploads/origins/f3664250-cdc5-4d2e-812f-934cacf7b2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36f23c25c759bc50e82c1b364eea880a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ma_samurai/works/15", "thumbnail_src": "https://si.imgix.net/dff50526/uploads/origins/40f71a02-0028-405f-996f-ff8490653797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e505ce77bb563a062695fd8e6e8f813", "thumbnail_srcset": "https://si.imgix.net/dff50526/uploads/origins/40f71a