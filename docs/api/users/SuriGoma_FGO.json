ix.net/3d2bc103/uploads/origins/b9884e54-de01-4df8-8b15-0018d36f297c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f996d51386e68229d5f7d05a8d5dfef6", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SuriGoma_FGO/works/4", "thumbnail_src": "https://si.imgix.net/95067943/uploads/origins/5a2c012d-cb5f-4fc8-ad4d-c25dc30ff808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82d24fa420a186304dcb72f4c28c393c", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SuriGoma_FGO/works/3", "thumbnail_src": "https://si.imgix.net/2bb132e1/uploads/origins/275e1973-9c71-4829-ae80-3605ff862e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0322cecf5389952c01792d7bcefc15c3", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは。MHA の Uraraka の画像をリクエストします。\n\n参照: https://static.wikia.nocookie.net/bokunoheroacademia/images/f/f8/Ochaco_Uraraka_Action_5.png/revision/latest?cb=20240615220449\n\n悪党に残酷にレイプされ殺された後の彼女を描いてください。\n\n彼女には、あざや縫合など、かなりの暴力と虐待を与えてください。\n\nただし、切り傷や刺し傷よりも鈍的外傷の方が好きです。手足を切断しないでください。 （手足は描かない方が楽なら、フレームから外れても大丈夫です。）\n\n傷は腫れて壊死していて、ウジや汚物などが溜まっていると良いです。\n\n顔は腫れて醜く間抜けな表情をしていた方がいいです。舌は出ていて、精液が付いています。\n\n胸は殴られて変形しています。\n\nお腹は醜くぐちゃぐちゃです。妊娠してから激しく殴られたのでしょう。穴からは精液が大量に流れ出ています。\n\n基本的にヒロインの完全な破壊を見たいです。", "created_at": "", "completed_at": ""}, {"path": "/@SuriGoma_FGO/works/2", "thumbnail_src": "https://si.imgix.net/c3bf336e/uploads/origins/fc3d51b6-8aac-4192-a282-0c50f1406cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa088368d7d4b1d5a5b4e2fb2c18daca", "thum