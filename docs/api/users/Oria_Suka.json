。\nスカートが長すぎる場合は、適宜アレンジして短くしていただいて大丈夫です！\n\n表情は目がハート&上記URLにあるようなトロ顔でお願いします。\n\n\n塗りに関しては、\n\nhttps://skeb.jp/@Oria_Suka/works/48\n\nこちらのイラストのように陰影のはっきりしたアニメ塗りでお願い致します！\n\n\n\n背景はシンプル背景で大丈夫です。\n\n上記以外の些細はお任せ致します。\n以上、何卒ご検討をお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Oria_Suka/works/63", "thumbnail_src": "https://si.imgix.net/9eb8a211/uploads/origins/5ba01987-0ed1-4dee-9f8f-4c3a3fe3a11a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a685da5aee130043e7975aad8e556e3f", "thumbnail_srcset": "https://si.imgix.net/9eb8a211/uploads/origins/5ba01987-0ed1-4dee-9f8f-4c3a3fe3a11a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a685da5aee130043e7975aad8e556e3f, https://si.imgix.net/9eb8a211/uploads/origins/5ba01987-0ed1-4dee-9f8f-4c3a3fe3a11a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dead8e9e7fbddf1fba7e6268a6fce36 2x, https://si.imgix.net/9eb8a211/uploads/origins/5ba01987-0ed1-4dee-9f8f-4c3a3fe3a11a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=343c239a576f4831544610f67eebb027 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Oria_Suka/works/62", "thumbnail_src": "https://si.imgix.net/a1a5bb82/uploads/origins/0af56112-e089-4b4a-939c-7677ef7d739c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903b345cb268dc5f1734db5b99411682", "thumbnail_srcset": "https://si.imgix.net/a1a5bb82/uploads/origins/0af56112-e089-4b4a-939c-7677ef7d739c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903b