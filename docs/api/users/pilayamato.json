いので髪がある様に描いて下さい。\n\nその他はお任せ致します。\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pilayamato/works/206", "thumbnail_src": "https://si.imgix.net/1794fa30/uploads/origins/73729fc6-a418-4e67-b678-8b326ba60149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b141d1d189e456b68f513a780f976c2", "thumbnail_srcset": "https://si.imgix.net/1794fa30/uploads/origins/73729fc6-a418-4e67-b678-8b326ba60149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b141d1d189e456b68f513a780f976c2, https://si.imgix.net/1794fa30/uploads/origins/73729fc6-a418-4e67-b678-8b326ba60149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0165867fb6a77de2d1392905c49ef3e 2x, https://si.imgix.net/1794fa30/uploads/origins/73729fc6-a418-4e67-b678-8b326ba60149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc5a0704fe004f06ca66f20850eee41a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pilayamato/works/205", "thumbnail_src": "https://si.imgix.net/114034a8/uploads/origins/1051b584-344a-4b24-a973-315077927e4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bac02bd453c34f43ae108e8ff2da563d", "thumbnail_srcset": "https://si.imgix.net/114034a8/uploads/origins/1051b584-344a-4b24-a973-315077927e4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bac02bd453c34f43ae108e8ff2da563d, https://si.imgix.net/114034a8/uploads/origins/1051b584-344a-4b24-a973-315077927e4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&