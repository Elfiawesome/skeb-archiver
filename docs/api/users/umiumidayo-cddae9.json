dmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad37a56be69e72acb5ef36e71666e06b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad37a56be69e72acb5ef36e71666e06b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aab87cf95114606e3478ac9d5d99a650 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01c87d8fa1ce4c36375fc87b7297d6eb 3x", "genre": "novel", "nsfw": false, "body": "うみこさんのお姉さんみとシチュボがとても好きなので依頼させていただきました\n\n別の方にボイスのskebをお願いしたいので、そのための台本をお願いします！\n尺は大体ツイッター動画程度の長さ、\nシチュは同棲しているしおしおにくたびれたOLお姉さんにビールを勧められる……\nみたいな感じの台本をお願いします　その他詳細はお任せします\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/9", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "こんなま！パソコン復活おめでとうございます🎉\n\nさて、私事ですが今月が誕生日でして、ぜひうみこさんからお祝いボイス頂けないでしょうか？\nフランクな感じで貰えると嬉しいです😃", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/8", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "こんなまっ！ルイスと申します。いつも配信楽しく視聴させていただいてます。\n　最近は遊戯王大会の開催に向けて精力的に活動する一方、体調やメンタルの不調に見舞われている様子で、心配しつつも少しでも力になればと思い配信視聴・コメント投稿をしています。\n\n　さて、今回はうみこさんにぜひお願いしたいボイスがあるのですが、依頼は受け付けてらっしゃるでしょうか。可能でしたら次のようなボイスを作成いただければ幸いです。\n\n１．依頼内容\n（１）昇進を祝う内容のボイス×２パターン\n（２）文言例：「昇進おめでとう。これからも頑張ってね。」\n　　　・パターン１：しみじみと落ち着いた調子、極近しい関係性の想定で。\n　　　・パターン２：フランクに明るい調子、配信者と視聴者の今の関係性で。\n（３）文言例から数秒～長くても１０秒程度になろうかと思います。\n（４）以上、すべて個人的な希望ですので、可能な限りの対応でかまいません。\n\n\n　私事で恐縮ですが、このたび昇進が決まりました。昇進をほめてもらいたい、単純にいい声で褒められる経験がしたい。特にうみこさんに褒められたい！！！そうした思いから依頼させていただきました。\n　こうした依頼が初めての経験ですので、失礼な点がありましたらお許しください。\n　どうぞよろしくお願いいたします。\n\n　追伸\n　好きな気持ちが高じてうみこさんに迷惑かける言動をとっていることがあると思い、申し訳ない気持ちでおります。できる限り改善していきますので、なにとぞご容赦願います。", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/7", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "こんなまぁ🌊akikanです！\n今回は所謂「おはようボイス」をお願いしたいです！\n勤め始めてやっぱり朝起きるのが億劫なのです。\n\n「おはよう」と「起きろ」があれば多分起きれるのでお願いします！！\n\n色々てんてこ舞いな時期にぶち込んでしまいすみません。\n可能でしたら無理のない範囲でお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "配信を見てて時々聞けるふとしたうみこさんの好きな一言を好きな時に聞きたいと思ったので\nうみこさんの一言集が欲しいです\n\n要望する一言台詞を載せておくので出来そうなのをしてくれたら嬉しいです\n余り気合入れずに配信してるくらいの気分で取ってくれるのが希望\nあと何も知らずにこれを聞く人向けへの説明を冒頭に欲しいので最初に台詞で\n「これは配信中に私が言った一言台詞を改めて聞きたいと要望されたのでこの後は一言ずつのセリフを言うので聴いてくれると嬉しいな。気に入ってくれたら生配信で良く言うのでチャンネル登録して見てくれるともっと嬉しくなっちゃうぞ」\nと説明と宣伝を入れてくれると助かります\n\n・人が来た時の挨拶「ごゆるりと〜」\n・試合中にリスナーが挨拶したので軽く流す感じで返す「こんなまぁ」\n・何時もの「バレへんバレへん」\n・気づいてない相手を可愛く攻撃した時「えいっ☆」\n・コテンパンにされてガチモードになった時の「この野郎！絶対倒してやんかんな！」\n・頑張った感じで外人リクエストの「araara」\n・イケボで「悪い奴だ……」\n・･やられた時の「ふぁーーっ！」\n・予想外の出来事で「どーしてー↑？」\n・シチュボ終わって気が抜けた時「ウヴォァー」\n・「エイサイハラマスコイ」", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/4", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "相場が分からないのですが今出せる額です。お願いします！\n\n最近配信がほぼ毎日でエブリデーだからめちょめちょ幸せ気分だぞ！うみこさんお疲れ様だよほんと。ありがたやーありがたやーだ。ということで…\nサンプルとは違う感じの元気なお疲れ様ボイスが欲しいです！頑張ったようだから遊んでやるよ！！みたいな距離の近い感じ希望です。\n最近頑張ったので褒めてほしいのだ！なんてな！\n\n私はお話考えたりお話するの下手っぴなのであまり詳細に言えなくてごめん！\n暇な時にお願いしたいのだ！", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/3", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "目覚ましボイスをお願いします。\nシチュエーションとしては、戦いを前に寝ている自分を叱咤しつつ起こしていただきたいです。\n具体的に言うとグラブルの古戦場開始5分前に熟睡してる感じです(自分はグラブルやってないんであくまで『戦い』のイメージで)。\n〆は送り出す感じではなく\n「さあ行くぞ!」\nって手を引いてくれる感じでお願いします。\n\nあとできれば下の名前呼び捨てにして欲しいです!", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "「おやすみ、よい夢を」を優しい感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@umiumidayo/works/1", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d6f3c50aa4fd7ae26bc9642284feadc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e74693ac5df7456fa8fb66dbb636df39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2026599901661184000%2F_NYoxZmp.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2154ce221c92d28fe1a95d3c150f49c8 3x", "genre": "voice", "nsfw": false, "body": "「最近がんばりすぎてない？たまには休んだほうがいいよ、お疲れ様、ゆっくりおやすみ」って感じのボイスをお願いします！", "created_at": "", "completed_at": ""}]}