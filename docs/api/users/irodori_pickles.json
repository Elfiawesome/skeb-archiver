d943ff551216cbd4c43fe 2x, https://si.imgix.net/1b80d0fb/uploads/origins/5193cabf-a8fe-47f3-8ffa-37bbf7e2007a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34cfda8a813f882e277a611c0b451c0f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@irodori_pickles/works/3", "thumbnail_src": "https://si.imgix.net/f535ac18/uploads/origins/d34ffdb1-7123-4632-91a8-0b554b15eba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35fbc6f5f05f63f46a109a8c8caf4b5a", "thumbnail_srcset": "https://si.imgix.net/f535ac18/uploads/origins/d34ffdb1-7123-4632-91a8-0b554b15eba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35fbc6f5f05f63f46a109a8c8caf4b5a, https://si.imgix.net/f535ac18/uploads/origins/d34ffdb1-7123-4632-91a8-0b554b15eba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0e264134d7a62ff2fb6602e4ab60adc 2x, https://si.imgix.net/f535ac18/uploads/origins/d34ffdb1-7123-4632-91a8-0b554b15eba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f32596e1152bac3b4c6db50199d9e97 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@irodori_pickles/works/2", "thumbnail_src": "https://si.imgix.net/b6503716/uploads/origins/7922bcae-ff39-4f59-8d21-dd5ef469d470?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60bb803caf3b42545784ddcf77e82174", "thumbnail_srcset": "https://si.imgix.net/b6503716/uploads/origins/7922bcae-ff39-4f59-8d21-dd5ef469d470?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60bb803caf3b42545784ddcf77e82174, https://si.imgix.net/b6503716/uploads/origins/7922bcae-ff39-4f59-8d21-dd5ef469d470?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a7e63729066162119611017e671c762 2x, https://si.imgix.net/b6503716/uploads/origins/7922bcae-ff39-4f59-8d21-dd5ef469d470?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6808fd26538272ef59daccb5da199638 3x", "genre": "art", "nsfw": false, "body": "いろどりぴくるすさん、初めまして。\n\nストグラの「葉風邪ナイ」のイラストをリクエストします。\n\n葉風邪はよくこそっとお話しているイメージがあるので、正面を向いて右手を添えて耳打ちするような構図で、体全体かバストアップが映るように描いてほしいです\n服装は救急隊のピンクの隊服で、表情はここだけの話を嬉しそうに報告している感じ、可能であれば冷や汗をかいて深刻そうな話をしてる感じの差分なども描いてもらえたら嬉しいです。\n\n【使用用途】\n・ストグラwikiの二次創作ガイドラインの範囲での使用\nhttps://w.atwiki.jp/streamergta5/pages/382.html\n※描いていただいた作品は葉風邪役の天城てんさんにお渡しする可能性があります。\n\nご検討のほどよろしくお願いします。\n\nhttps://w.atwiki.jp/streamergta5/?cmd=word&word=%25E3%2583%258A%25E3%2582%25A4&pageid=830", "created_at": "", "completed_at": ""}, {"path": "/@irodori_pickles/works/1", "thumbnail_src": "https://si.imgix.net/0894f7b7/uploads/origins/3021dccf-eee2-4650-bf5d-52865aff1703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37a786d4213692a76bb31b952831ad29", "thumbnail_srcset": "https://si.imgix.net/0894f7b7/uploads/origins/3021dccf-eee2-4650-bf5d-52865aff1703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37a786d4213692a76bb31b952831ad29, https://si.imgix.net/0894f7b7/uploads/origins/3021dccf-eee2-4650-bf5d-52865aff1703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc2cae05828e94d012a68af9820987b5 2x, https://si.imgix.net/0894f7b7/uploads/origins/3021dccf-eee2-4650-bf5d-52865aff1703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c01353fb90852bb7e295bf82bb1fe301 3x", "genre": "art", "nsfw": false, "body": "いろどりぴくるすさん初めまして\nリクエスト失礼致します。\n\n\nリクエストしますのはうちの子作品です。\n\n構図など全てお任せしたく\nお手数ですが資料参照してなにか浮かびましたら幸いです。\n服装や、髪型など好きなようにアレンジいたいて構いません\n可能でしたらうちの子は2人と一匹いますので複数人可能でしたらお願いいたします。\n\n\n\nうちの子(メイン):柄葉五鈴(つかは いすず)ちゃん\nとても明るい元気な子\n喜怒哀楽の喜楽のみみたいな子\n肌の色などは資料内に褐色肌のものもありますが通常の肌色になります。\n身長167センチ\n\nhttps://www.dropbox.com/scl/fo/e8iu1cvikxaj8q57lf5jp/h?rlkey=tozw7ff7id1z7fvch02u38olv&dl=0\n\nうちの子②:悪鈴ちゃん\n\n五鈴ちゃんの別個体になります。\n性格はわかりやすくいうとツンデレに近く\n悪鈴ちゃんが別個体ということもあり五鈴ちゃんを少し敵視してイタズラなどを仕掛けるがいつも五鈴ちゃんが無意識ながらそれを躱し、無意識反撃や自滅などしてしまう。\n体型は五鈴ちゃんと同じで\n肌の色は資料通りで問題ありません\n\nhttps://www.dropbox.com/scl/fo/ze944cqnnlatlb5r711e1/h?rlkey=s8ng0tafa8a9ee9er8s3nbdn4&dl=0", "created_at": "", "completed_at": ""}]}