d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aaef2d7b9358b67bcdc44ce54a8cf27e, https://si.imgix.net/9727b28a/uploads/origins/e17c5dfa-2025-405a-8110-b1ee42d6f52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc428d39aa93d95231bf31be2220aff2 2x, https://si.imgix.net/9727b28a/uploads/origins/e17c5dfa-2025-405a-8110-b1ee42d6f52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98b8e2e0f0952a0ddd9d1751b1cfaae9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sushi_gnsn/works/22", "thumbnail_src": "https://si.imgix.net/5467037a/uploads/origins/6655f2d4-8236-42a0-8cfe-33b016250590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814ba810466623071cc1cda5ed46c6a1", "thumbnail_srcset": "https://si.imgix.net/5467037a/uploads/origins/6655f2d4-8236-42a0-8cfe-33b016250590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814ba810466623071cc1cda5ed46c6a1, https://si.imgix.net/5467037a/uploads/origins/6655f2d4-8236-42a0-8cfe-33b016250590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f797115983a5aa7c4b5e96789f95ad25 2x, https://si.imgix.net/5467037a/uploads/origins/6655f2d4-8236-42a0-8cfe-33b016250590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=034134bcbf8181eab601817336e91c53 3x", "genre": "art", "nsfw": false, "body": "こんにちは、す先生！\n\nあなたのアートギャラリーを拝見し、あなたのキャラクターワークと色使いがとても気に入りました！もしよければ、私のVtuberキャラクターにリクエストをして、Twitter、Twitch、ウェブサイトでアートを使いたいです！\n\n彼女は遊び好きで、よく笑い、きれいな風景を見るために旅行するのが好きです！花柄の袴を着てほしいです！具体的なデザインや柄はお任せしますが、デザインに興味がなければ、参考のものでも構いません！舞台は雪の降る昼下がりの喫茶店