77b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc3dd0f5250a9c2733877f969b358ff4 2x, https://si.imgix.net/74efe66a/uploads/origins/2d16646e-8140-4765-97f4-c66f6306077b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2dbe2b062cede0154a9371e55a5ca97 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nメインページでダイナミックアートを拝見しました。\n私のキャラクター「コハル」とgnsnの「ディルルック」を描いてください。\n一緒に並んで戦っているシチュエーションが希望です。\n表情やポーズは自由です。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Scg6zCrYlp3YeiHUls78RsfQZkR9bvj6?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/22", "thumbnail_src": "https://si.imgix.net/d37d59b4/uploads/origins/342ded3a-5099-4a7b-929b-3dfcdeddf033?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97e68b65227d68bdd69b2b48ddb61b15", "thumbnail_srcset": "https://si.imgix.net/d37d59b4/uploads/origins/342ded3a-5099-4a7b-929b-3dfcdeddf033?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97e68b65227d68bdd69b2b48ddb61b15, https://si.imgix.net/d37d59b4/uploads/origins/342ded3a-5099-4a7b-929b-3dfcdeddf033?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f62cf83d13b9bf63fecdc2c1b0ae74ce 2x, https://si.imgix.net/d37d59b4/uploads/origins/342ded3a-5099-4a7b-929b-3dfcdeddf033?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e9bb1956d3bb9494bba87fac5f891f0 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n素晴らしい作品拝見しまして、是非オリジナルキャラ二人のイラストをお願いしたくリクエスト送信いたしました。探偵助手の二人組で、アンティーク調や、夜の雰囲気が似合うキャラクター達です。\n\n▼キャラクター\n①金髪の男\n職業：探偵\n身長：179cm\n年齢：29歳\nイメージカラー：赤\n\n②銀髪の男\n職業：探偵助手\n身長:176cm\n年齢：20歳\nイメージカラー：翡翠\n\n似合うイメージ\n月・夜空・金髪が銀髪の手を引いて連れ出す・\n宝石・嫉妬・傲慢・額縁・アンティーク・見つめ合う\n\n金額不足しているようであればお手数おかけしますが再送頂けますと幸いです。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ppX91xkr5r8IdSycHpGuz7bF6SETxys1?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/21", "thumbnail_src": "https://si.imgix.net/5d5dcc1b/uploads/origins/510bde34-a52a-4472-91f8-6b5f3a16d391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0140e9fd54052b7f7602b8830ed688", "thumbnail_srcset": "https://si.imgix.net/5d5dcc1b/uploads/origins/510bde34-a52a-4472-91f8-6b5f3a16d391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0140e9fd54052b7f7602b8830ed688, https://si.imgix.net/5d5dcc1b/uploads/origins/510bde34-a52a-4472-91f8-6b5f3a16d391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f43f34728be7eee3f0afbae7e51e267b 2x, https://si.imgix.net/5d5dcc1b/uploads/origins/510bde34-a52a-4472-91f8-6b5f3a16d391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16e82d769ea1acb30de2f1ed4fda2625 3x", "genre": "art", "nsfw": false, "body": "こんばんは！\nシャハラムです。\n前回はありがとうございました！\nとっても素敵なイラストで大変気に入っております！\n\nフリーランスおめでとうございます！\nせっかくなのでぜひもう一度お願いしたいと思いましてリクエストさせていただきました。\n今回はアラビアン×パイレーツ衣装で上着なし、バンダナを巻いている状態でお願いさせいただきたいです！\n構図はお任せになってしまうのですが、帆船に乗って海を渡っているイメージで描いていただけると嬉しいです！\n三面図や資料は下のURLのツリーに置いてあります！\n\nキャラクターだけレイヤー分かれていると大変ありがたいです。\nご検討よろしくお願いいたします！\n\nhttps://x.com/shahramVT/status/1786355482040660395", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/20", "thumbnail_src": "https://si.imgix.net/58256ede/uploads/origins/6cf0f234-644f-4981-b18f-557ef686c222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ead6d58c8f61567c032d6885f8031916", "thumbnail_srcset": "https://si.imgix.net/58256ede/uploads/origins/6cf0f234-644f-4981-b18f-557ef686c222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ead6d58c8f61567c032d6885f8031916, https://si.imgix.net/58256ede/uploads/origins/6cf0f234-644f-4981-b18f-557ef686c222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7de4ea15e3a00b94fff880aa2bf4231d 2x, https://si.imgix.net/58256ede/uploads/origins/6cf0f234-644f-4981-b18f-557ef686c222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=883067f79e159b1dd94ff7ae8a3fc737 3x", "genre": "art", "nsfw": false, "body": "こんにちは、TLでお見かけしたイラストに一目惚れしました…！ご縁があれば資料先のキャラクターのイラストをお願いします。\n\n月/星/写真/夜のビル街/落下/花束/殺人事件/赤/青/対時/指輪/プロポーズなど、どれかの要素があると嬉しいです。\n\nどちらかをメインに描いて頂いても構いません。パーツの省略・着脱、構図・シチュエーションなどはお任せいたします。\n無理のない範囲でご検討&いつでも再送要請いただけたらと思います！\n\nhttps://www.dropbox.com/scl/fo/j7jnytxoq5y7v5mjn6ys6/h?dl=0&rlkey=53k8fyc4kmo42zekrf4qry10d", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/19", "thumbnail_src": "https://si.imgix.net/adeaf537/uploads/origins/943ecb60-1838-4227-8cea-79b5aa433a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9bc8d5c3c341971f7f01fb411bdc536", "thumbnail_srcset": "https://si.imgix.net/adeaf537/uploads/origins/943ecb60-1838-4227-8cea-79b5aa433a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9bc8d5c3c341971f7f01fb411bdc536, https://si.imgix.net/adeaf537/uploads/origins/943ecb60-1838-4227-8cea-79b5aa433a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=684d0041e9450b0cb464991da1bb1d25 2x, https://si.imgix.net/adeaf537/uploads/origins/943ecb60-1838-4227-8cea-79b5aa433a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2652574c582c5003a57317589a76bbe 3x", "genre": "art", "nsfw": false, "body": "ザビさんこんにちはです。今回はモンスターハンターワイルズで使用しているマイハンターをザビさんに描いて頂きたく依頼しました。\n年齢は24-25辺り、身長は158-160、体重は平均ですがウエストが少し細めな前回ご依頼した時と比べて成長したんだと思える。そんなイラストを希望します。\nこういった構図でという具体的なものは全てザビさんを信じておまかせします。ただデスヴェノムサーベルという片手剣を携え添付してある装備をつけたマイハンターを描いてくださることの2点だけ条件として提示します。\n最後に少し癖の話にはなりますが少しジト目気味で胸の大きさはC辺りだととても嬉しいです。\n\nhttps://x.com/Clearcloud_0193/status/1930448504423624843?t=srRJ5tJN-nd9eZrLPnGOQw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/18", "thumbnail_src": "https://si.imgix.net/d5516207/uploads/origins/40dd7705-daf1-444a-ad67-c26c1eb823e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24c347d6de0124a27984d3759950873a", "thumbnail_srcset": "https://si.imgix.net/d5516207/uploads/origins/40dd7705-daf1-444a-ad67-c26c1eb823e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24c347d6de0124a27984d3759950873a, https://si.imgix.net/d5516207/uploads/origins/40dd7705-daf1-444a-ad67-c26c1eb823e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=207a9d046087623b272171226e661a3a 2x, https://si.imgix.net/d5516207/uploads/origins/40dd7705-daf1-444a-ad67-c26c1eb823e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=093ce50aed4f6c6a18e3d8f72f06d3d0 3x", "genre": "art", "nsfw": false, "body": "ザビさんこんにちは！\n\nザビさんとなっちさんのイラストをリクエストします。お洒落にきめたザビさんと、いつもの飄々としたなっちさんが一緒に冒険の世界へ飛び出すイメージで描いて頂きたいです⚔️\nザビさんが後ろを振り返って、絵を見ている人に「一緒に行こう！」とカッコよく手を差し出しているイメージです。\nなっちさんはアルテミスの姿ではなくゆるふわな方のなっちさん希望です。\nそして絵の中のどこかに、翻弄されているウソッキーを入れていただきたいです。\n飛び出す先の世界のイメージはザビさんにお任せします！\nぜひよろしくお願いします🙇", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/17", "thumbnail_src": "https://si.imgix.net/6ef861f8/uploads/origins/24be01ea-7a55-4144-ab15-512fb25e3bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc8f00aeeb34267e0902a943d942545", "thumbnail_srcset": "https://si.imgix.net/6ef861f8/uploads/origins/24be01ea-7a55-4144-ab15-512fb25e3bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc8f00aeeb34267e0902a943d942545, https://si.imgix.net/6ef861f8/uploads/origins/24be01ea-7a55-4144-ab15-512fb25e3bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2a3a88c360fea139f1c09cf739997ac 2x, https://si.imgix.net/6ef861f8/uploads/origins/24be01ea-7a55-4144-ab15-512fb25e3bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d483e178c837a6cb89229e698bbc41e 3x", "genre": "art", "nsfw": false, "body": "ザビさんこんばんは！\nいつも素敵なイラスト拝見させてもらってます\n毎回躍動感溢れるザビさんのイラストは感動するばかりです\n\