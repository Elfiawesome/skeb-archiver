4c4-361b7ef68513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=626f083e62a8b94c667dc2381f0fce7b 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもザビ様のかっこいいイラストを楽しませて頂いてます。\n今回ご依頼させて頂きたいのは、村田先生がキャラデザインしたゲーム「バディミッションBOND」のメインキャラクターアーロンとルークのイラストです。\nこの二人は因縁深いバディです。ルーク（ドギー）は警察官、拳銃を使うキャラです。アーロン（ビースト）は宝石怪盗、爪を使うャラです。ルークの左手は腕時計と腕輪があります。この腕輪はルークの存在を証明する大切な証です。\n構図等はお任せ致します。ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1wExXBeUp8_X55Uhh7jfllkD21E2v6hKQ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/9", "thumbnail_src": "https://si.imgix.net/c35058d0/uploads/origins/c073007c-3db1-4e8c-bf71-2f5ff23a630a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=328fc14ee4c67118247418f8223db185", "thumbnail_srcset": "https://si.imgix.net/c35058d0/uploads/origins/c073007c-3db1-4e8c-bf71-2f5ff23a630a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=328fc14ee4c67118247418f8223db185, https://si.imgix.net/c35058d0/uploads/origins/c073007c-3db1-4e8c-bf71-2f5ff23a630a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a03ddad5e0d912560224264e2ec9938e 2x, https://si.imgix.net/c35058d0/uploads/origins/c073007c-3db1-4e8c-bf71-2f5ff23a630a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f7d6cf338a7041fa957fb2f50b21993 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のOCの絵を描いてほしいです。\n私のキャラクターが鬼の面をつけた影武者と戦っていて、高層ビルや夜の街が見渡せる屋上で戦っているような絵が希望です。また、敵は剣に反射して見える程度にしてほしいです。ありがとうございました。\n\nhttps://imgur.com/a/CkpsEM6", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/8", "thumbnail_src": "https://si.imgix.net/3391e6a9/uploads/origins/3cf7969d-5318-4644-bae9-84f4c0680660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78016adb092168c24bcc482c00da47dd", "thumbnail_srcset": "https://si.imgix.net/3391e6a9/uploads/origins/3cf7969d-5318-4644-bae9-84f4c0680660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78016adb092168c24bcc482c00da47dd, https://si.imgix.net/3391e6a9/uploads/origins/3cf7969d-5318-4644-bae9-84f4c0680660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35be35505743e921ace700ba0852c25d 2x, https://si.imgix.net/3391e6a9/uploads/origins/3cf7969d-5318-4644-bae9-84f4c0680660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62d6acb4a3cf8dc28743dd6d7b50b7f1 3x", "genre": "art", "nsfw": false, "body": "初めまして、Vtuberの奈々瀬ひかげと申します。\nTwitterにてイラストを拝見させていただき是非描いていただきたいと思いご依頼させていただきます。\n\n服装や構図などはお任せしますが、\n「リングから炎が出ている状態で匣兵器の開匣を行っている状態」を描いていただきたいです。\n炎の色及び属性諸々はお任せいたします。\n\n自身の観賞用ですが、Twitterや配信で描いていただいた旨のご報告だけしたいと考えてます。\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1JyvUPyAoNcOeYC-_26XL7RURdqmlF_aX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ossan_zabi_190/works/7", "thumbnail_src": "https://si.imgix.net/a9b2b91a/uploads/origins/5745e579-f318-4ff5-8c51-83e4f460641a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=506129f96bc2dad25fb7d2937c8b597c", "thumbnail_srcset": "https://si.imgix.net/a9b2b91a/uploads/origins/5745e579-f318-4ff5-8c51-83e4f460641a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=506129f96bc2dad25fb7d2937c8b597c, https://si.imgix.net/a9b2b91a/uploads/origins/5745e579-f318-4ff5-8c51-83e4f460641a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61af15041cc9af5026489ef222e2149f 2x, https://si.imgix.net/a9b2b91a/uploads/origins/5745e579-f318-4ff5-8c51-83e4f460641a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e15e97fdf1ce1c7d2d7b739cba75233a 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラスト拝見させていただいております！\nVTuber活動中の氷室カナデと申します。\n\n今回、氷室カナデのイラストを1枚描いていただきたいです。要望としては、\n\n･サイバーパンクな夜のネオン街を背景に。\n･メガホンを片手に力強い歌声で激唱している\n･ギラギラとした眼光\n･人物は画面中央に配置、なるべく人物の全身が写るように描いてください(アングルはおまかせ)\n･サイズは16:9で、背景と人物は