-40f8-baf6-a9c9f8ce0fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753337ee6a7c79130afd076ce8500f3f", "thumbnail_srcset": "https://si.imgix.net/c1d4088b/uploads/origins/db609c0a-6b2b-40f8-baf6-a9c9f8ce0fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753337ee6a7c79130afd076ce8500f3f, https://si.imgix.net/c1d4088b/uploads/origins/db609c0a-6b2b-40f8-baf6-a9c9f8ce0fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24f5395443a20d07b1ceb69d13890211 2x, https://si.imgix.net/c1d4088b/uploads/origins/db609c0a-6b2b-40f8-baf6-a9c9f8ce0fd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=710a425e6346ba9bf51df8aa931b7b14 3x", "genre": "art", "nsfw": false, "body": "私のOCであるキョウのメイド服のイラストをお願いしたいです。\n先生の描くメイド服はとても好きなので、デザインはお任せしたいです。\n\nキョウは黒の太ももハイソックスを履いてください。\nヒールは無しで。\n\nキャラクター黒木 京（くろき きょう\n年齢： 18歳\n身長：178cm\nカップサイズB\n\nキャラクター紹介\nhttps://i.imgur.com/4hcdnu4.png\nhttps://i.imgur.com/GeJwoFK.png\nhttps://i.imgur.com/JfzxbMb.png\nhttps://i.imgur.com/msBlTDD.jpg\n\nキョウは、2人の弟妹にとって頼もしいお姉さんだが、他の人に対してはとても冷淡。そのため、\"萌え \"と \"癒し \"の2つの要素を併せ持つ。しかし、一度打ち解けると、とても良い友人となる。\n\nケンカが好きで、中学、高校と不良だった。ケンカが大好きで、ワンパンで人をノックアウトしてしまうほど強い。\n\nメイド喫茶でアルバイトをしている。\n\nポーズや構図はお任せします。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@saisoumo_01/works/40", "thumbnail_src": "https://si.imgix.net/cbdd9266/uploads/origins/3250c391-ff17-4f92-9048-bfd0ccb70be4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54129b14bf0d1046eb1a9364f9d39257", "thumbnail_srcset": "https://si.imgix.net/cbdd9266/uploads/origins/3250c391-ff17-4f92-9048-bfd0ccb70be4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54129b14bf0d1046eb1a9364f9d39257, https://si.imgix.net/cbdd9266