景等別のレイヤーになっているPSDファイル。\n　もしくは背景と別になっているPNGだととても嬉しいです！\n\n【使用用途】\n・ライブ配信、SNSでの使用\n・非商用のネットプリントでの使用\n※グッズ販売などの商用利用には使用いたしません\n\n【資料】\nhttps://drive.google.com/drive/folders/19vkwwXKV_n-i5uZUZhl861O8BC-ZEGum?usp=sharing\n\n以上よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Woz03/works/109", "thumbnail_src": "https://si.imgix.net/e8992921/uploads/origins/ec333ffe-97c3-4585-bc9c-6d0a7279bd60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb4d74af2299af704fff70265b1fee68", "thumbnail_srcset": "https://si.imgix.net/e8992921/uploads/origins/ec333ffe-97c3-4585-bc9c-6d0a7279bd60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb4d74af2299af704fff70265b1fee68, https://si.imgix.net/e8992921/uploads/origins/ec333ffe-97c3-4585-bc9c-6d0a7279bd60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37e61b9faa15386494f7e57fc45c9e2f 2x, https://si.imgix.net/e8992921/uploads/origins/ec333ffe-97c3-4585-bc9c-6d0a7279bd60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36deafb7980f5b1a4d9d120ce2e782f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Woz03/works/108", "thumbnail_src": "https://si.imgix.net/143732c4/uploads/origins/fc144c06-4c6f-4676-9812-4c24262c7699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d552c98e5b03e9010aa62a7c1139a917", "thumbnail_srcset": "https://si.imgix.net/143732c4/uploads/origins/fc144c06-4c6f-4676-9812-4c24262c7699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d552