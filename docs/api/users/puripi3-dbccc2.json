b41f147c56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=764e54587fe0bab7891861daf8def03f", "thumbnail_srcset": "https://si.imgix.net/36db3d47/uploads/origins/e8580281-b40d-437f-a14b-80b41f147c56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=764e54587fe0bab7891861daf8def03f, https://si.imgix.net/36db3d47/uploads/origins/e8580281-b40d-437f-a14b-80b41f147c56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19635e233d0b02f31bd8a95363186e0f 2x, https://si.imgix.net/36db3d47/uploads/origins/e8580281-b40d-437f-a14b-80b41f147c56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df473fce122de6ccc4189f4b3b5cac3f 3x", "genre": "art", "nsfw": false, "body": "apexのR301を持ってる雪上ごまちゃんをお願いします(*^^*)", "created_at": "", "completed_at": ""}, {"path": "/@puripi3/works/40", "thumbnail_src": "https://si.imgix.net/736f8a19/uploads/origins/b406d9de-9cb4-4737-b260-b6dd2432e2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97504708795302df445b29d796f898f6", "thumbnail_srcset": "https://si.imgix.net/736f8a19/uploads/origins/b406d9de-9cb4-4737-b260-b6dd2432e2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97504708795302df445b29d796f898f6, https://si.imgix.net/736f8a19/uploads/origins/b406d9de-9cb4-4737-b260-b6dd2432e2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d13bec77ea5ff6d35d05fc10ef52d723 2x, https://si.imgix.net/736f8a19/uploads/origins/b406d9de-9cb4-4737-b260-b6dd2432e2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fe0cb3b1e33584037f333a4569ca287 3x", "genre": "art", "nsfw": false, "body": "初めまして！Vtuberの歌織（うたおり）たわしと申します！\nぷりぴちゃん様のイラストをXで拝見し一目ぼれしましたので今回リクエストさせていただきたいです！\n\n♦構図\n玉座に座って、人々を見下ろしているような表情でお願いします！！\n\n♦服装\n参考画像を添付しますが、先生のお好みの服装でお願いします！！\n\n♦使用用途\n配信のサムネイルや、X・Youtube配信等各種媒体で使用（主に格ゲーで使用したいと思います）\n商用利用する予定はありません。\n横や上が切れないよう、また人物透過ファイルをPNGで頂きたいです。\n通常のファイルとは別にイラストを拡大したものを16：9で頂けると嬉しいです！！\n\n\nお忙しいとは思いますが、どうぞよろしくお願い致します。\n\nhttps://x.com/TawashiUnite92/status/1701892806384701486", "created_at": "", "completed_at": ""}, {"path": "/@puripi3/works/39", "thumbnail_src": "https://si.imgix.net/91800abc/uploads/origins/7dc8a332-9867-4884-b921-f295743d2df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=942d1836eaaf0fb25d1bab58ba18eb16", "thumbnail_srcset": "https://si.imgix.net/91800abc/uploads/origins/7dc8a332-9867-4884-b921-f295743d2df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=942d1836eaaf0fb25d1bab58ba18eb16, https://si.imgix.net/91800abc/uploads/origins/7dc8a332-9867-4884-b921-f295743d2df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bf8ac4c5e9e78a7fdc39a3a8c036516 2x, https://si.imgix.net/91800abc/uploads/origins/7dc8a332-9867-4884-b921-f295743d2df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01ed8f30e0e6b256c01c037ef5b684dc 3x", "genre": "art", "nsfw": false, "body": "ぷりぴちゃん大先生こんにちは！！\n今日は推しの１人である怪盗モナさんのイラストを書いて欲しいと思いリクエストさせて頂きます。\nリクエストにあたり、事前に本人にSkeb依頼の許可を頂いております。\n\n怪盗モナさんのX\nhttps://x.com/miss15_luna\n\nキービジュアルのようなイメージで、全身が描かれている構図でお願いできればと思っております。\n\n衣装については、彼女のXの固定ツイートでツリーにあります、３面図を参考に公式衣装でお願いしたいです。\n\nポーズ・表情については彼女の快活・無邪気・怪盗といった要素が感じられる様なものでお願いできればと思います。\n細かくはお任せになってしまいますが、よろしくお願いいたします。\n\n可能であれば人物と背景をレイヤー分けした状態でいただけると大変嬉しいです。\n\n使用用途については\n・SNSでの投稿\n・アイコン等利用\n・本人へのプレゼント\nを想定しております。\n\n怪盗モナさんは、ぷりぴちゃんがデザインをいたしました天海てなさんの顔がすごい好きだ、美人、好き…等と言っており、ぜひぷりぴちゃんのイラストで彼女を描いて頂きたいと思いお願いいたしました。\nお忙しいところ大変恐縮ですが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@puripi3/works/38", "thumbnail_src": "https://si.imgix.net/7ab77b54/uploads/origins/87666454-5703-46f7-95f8-537ee8a1eeea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af38b972606c873a2b724afa1f74dcdb", "thumbnail_srcset": "https://si.imgix.net/7ab77b54/uploads/origins/87666454-5703-46f7-95