6e1-ab37-5ae6214b34f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5debb8f9f3fbaeef4e450c5030bdb6b8, https://si.imgix.net/4d0fec27/uploads/origins/8ae8f999-9744-46e1-ab37-5ae6214b34f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de89b7b4632e2d2cf24e3501f46f8384 2x, https://si.imgix.net/4d0fec27/uploads/origins/8ae8f999-9744-46e1-ab37-5ae6214b34f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7533db3cd4a0f876cd95d3a098d592b 3x", "genre": "art", "nsfw": true, "body": "ぼっち・ざ・ろっく!の「佐々木次子（さっつー）×喜多郁代（佐々喜多）」のカップリング及び百合の簡単な漫画を描いて頂けないでしょうか？\n\n内容\nさっつーと喜多がキスをする。\nその後、さっつーが喜多の服を脱がせ、その後さっつーが裸の喜多に愛撫する。喜多は顔を赤くしながら喘ぎ声を出しながら喘ぐ。\nそして、喜多がイッた後に、その後さっつーと喜多は見つめ合い、再びキスをする。\n\nといった内容及び流れで簡単な佐々喜多の百合漫画をお願いします。\n\nまた、上の内容の場面に合わせて、セリフなどもお願いします。\nちなみにセリフはお任せで。", "created_at": "", "completed_at": ""}, {"path": "/@qtaro999999/works/29", "thumbnail_src": "https://si.imgix.net/15119b5a/uploads/origins/2eaf1681-02f0-44ff-9cf2-4e0dc7a23fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d39369684a9d6d116dc0cf4f2d2a4c3", "thumbnail_srcset": "https://si.imgix.net/15119b5a/uploads/origins/2eaf1681-02f0-44ff-9cf2-4e0dc7a23fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d39369684a9d6d116dc0cf4f2d2a4c3, https://si.imgix.net/15119b5a/uploads/origins/2eaf1681-02f0-44ff-9cf2-4e0dc7a23fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1881546734adfc65aacafa5d82ad755 2x, https://si.imgix.net/15119b5a/uploads/origins/2eaf1681-02f0-44ff-9cf2-4e0dc7a23fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd85516ba2c9613802987194c9e63117 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\n\nこの二人の絵を元に、タエコ×マコのヌード百合をやってもいいでしょうか？\nhttps://cdn.donmai.us/original/c7/52/__reizei_mako_and_kondou_taeko_girls_und_panzer_drawn_by_amogan__c752645b0cb86f16df6bb096b7fdc046.png\n\nマコもタエコに母乳をあげるのが大好きです。\n\n妙子がこのポーズをとっている別の写真\nhttps://quickshare.samsungcloud.com/7PHXTae6FGs8\nタエ子の胸にはマコが母乳をあげた跡がある。\nマコが寝ていると、タエコがやってきてマコの唇にキスをする。", "created_at": "", "completed_at": ""}, {"path": "/@qtaro999999/works/28", "thumbnail_src": "https://si.imgix.net/f9fd37eb/uploads/origins/721b3be2-96c7-453e-ac91-75cd55b9abec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16ce52570bfa2d16c85f0495459c28d5", "thumbnail_srcset": "https://si.imgix.net/f9fd37eb/uploads/origins/721b3be2-96c7-453e-ac91-75cd55b9abec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16ce52570bfa2d16c85f0495459c28d5, https://si.imgix.net/f9fd37eb/uploads/origins/721b3be2-96c7-453e-ac91-75cd55b9abec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61c7d7b7710fb58bc4b7115df9b4ea4b 2x, https://si.imgix.net/f9fd37eb/uploads/origins/721b3be2-96c7-453e-ac91-75cd55b9abec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b96de541b1119828cb3f9b784672cad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@qtaro999999/works/27", "thumbnail_src": "https://si.imgix.net/08518b47/uploads/origins/480e3f08-b728-4a51-be06-0ded1ff84acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d54bee0062eeb77c9d6a394a7e19b73", "thumbnail_srcset": "https://si.imgix.net/08518b47/uploads/origins/480e3f08-b728-4a51-be06-0ded1ff84acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d54bee0062eeb77c9d6a394a7e19b73, https://si.imgix.net/08518b47/uploads/origins/480e3f08-b728-4a51-be06-0ded1ff84acb?