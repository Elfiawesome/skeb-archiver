e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e626da1ac7b98a794f43fbaa5afa92", "thumbnail_srcset": "https://si.imgix.net/7a9ebf4e/uploads/origins/6afd016e-d9c7-4c5d-a822-322f2d8be8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e626da1ac7b98a794f43fbaa5afa92, https://si.imgix.net/7a9ebf4e/uploads/origins/6afd016e-d9c7-4c5d-a822-322f2d8be8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e141dd13dadcb52d8881fb212f90247 2x, https://si.imgix.net/7a9ebf4e/uploads/origins/6afd016e-d9c7-4c5d-a822-322f2d8be8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d6ef28032c709eecd77a336d2c56373 3x", "genre": "art", "nsfw": false, "body": "アピール、有難うございました。是非、うちの子、山家をお願いしたく思います！\nアピール本文でご提案いただきました通り、デフォルメでゆる可愛く仕上げていただきたく思います。\nまた、「柴犬のぬいぐるみ」もしくは「柴犬のグッズ（なんでも）」を与えてくださると、とても嬉しいです。\n何卒、よろしくお願いいたします。\n\nhttp://iorinohashira.blog.fc2.com/img/16720270860.png/", "created_at": "", "completed_at": ""}, {"path": "/@you_sansousaku/works/3", "thumbnail_src": "https://si.imgix.net/6c64dbe0/uploads/origins/c0df8df6-a9da-4662-91c9-7daa9db4d1de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0798833cd1226d881c26c65cbcf45293", "thumbnail_srcset": "https://si.imgix.net/6c64dbe0/uploads/origins/c0df8df6-a9da-4662-91c9-7daa9db4d1de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0798833cd1226d881c26c65cbcf45293, https://si.imgix.net/6c64dbe0/uploads/origins/c0df8df6-a9da-4662-91c9-7daa9db4d1de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04ebda063addb4d0759b1f16d571501d 2x, https://si.imgix.net/6c64dbe0/uploads/origins/c0df8df6-a9da-4662-91c9-7daa9db4d1de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ef549a53b24f8d0b77b3fad7cc26d2a 3x", "genre": "art", "nsfw": false, "body": "先日は素敵なうちの娘イラストありがとうございました！\n大変可愛らしいかったので我慢できずリピートさせていただきます！\n\n内容\n当方のオリキャラと割れないシャボン玉の絡んだイラスト\n\nキャラ\n前回のリクエストではアピール内容とは違う娘だったので今回はアピール内容の娘を…とは指定しないのでお好きなキャラを選んでください\n\n衣装\n前回はデフォルトの衣装でしたが今回はデフォルトに限定しませんのでお好きな衣装を着せてあげてください\n\nシャボン玉\n弾力のある割れないシャボン玉\nをキャラと自由に絡めてください\nシチュエーション等はお任せいたします\n\n\n以上が内容となります\n立て続けのリクエストとなり申し訳ありません\nもしよろしければ何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@you_sansousaku/works/2", "thumbnail_src": "https://si.imgix.net/639876f4/uploads/origins/971c170d-9125-4f17-a4e3-7a4b7aead00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf0d08759df66531f70647bc16b579c", "thumbnail_srcset": "https://si.imgix.net/639876f4/uploads/origins/971c170d-9125-4f17-a4e3-7a4b7aead00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf0d08759df66531f70647bc16b579c, https://si.imgix.net/639876f4/uploads/origins/971c170d-9125-4f17-a4e3-7a4b7aead00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17e3290ee73006532b2860f2dcd5c655 2x, https://si.imgix.net/639876f4/uploads/origins/971c170d-9125-4f17-a4e3-7a4b7aead00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ff1106a8a9948c7f88c955d576933b4 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます！\n是非とも妖さんにうちの娘たちをむちむちに描いていただきたくリクエスト送らせていただきます\n\n内容\nアピール内容そのままでお好きなキャラを描いていただきたいです\n衣装はお好きな衣装を自由に着せてあげてください！\nシャボン玉も可能なら絡めたイラストにして欲しいですがそこは妖さんにお任せいたします！\n\n何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@you_sansousaku/works/1", "thumbnail_src": "https://si.imgix.net/ee9f824c/uploads/origins/b6ce5f75-b4c6-4798-b4a4-674b9471993d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8314e29848fad8fff2a9f85560f31a7", "thumbnail_srcset": "https://si.imgix.net/ee9f824c/uploads/origins/b6ce5f75-b4c6-4798-b4a4-674b9471993d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8314e29848fad8fff2a9f85560f31a7, https://si.imgix.net/ee9f824c/uploads/origins/b6ce5f75-b4c6-4798-b4a4-674b9471993d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2affcec49857da7a4ceb8d95565984b7 2x, https://si.imgix.net/ee9f824c/uploads/origins/b6ce5f75-b4c6-4798-b4a4-674b9471993d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aacb69f9a98cfd874e53bd1916be06c6 3x", "genre": "art", "nsfw": false, "body": "はじめまして！妖様。いつもTwitterで作品を閲覧しております。\n今回初のskebをリクエストさせていただきます！\n深夜、残業が終わり1人地下駐車場に下りる主。背後に視線を感じ振り向くが人は居らず。気のせいだと思い車に乗り込みバックミラーを合わせると夜崎桜くんが背後に座っていて助けを呼ぼうと叫ぼうとするが背後から首筋に刃物を当てられ「動かないで。もし動いたら君の首から真っ赤な血が溢れちゃうかもよ？」と耳元で囁く夜崎桜くん。\nをよろしくお願いいたします！", "created_at": "", "completed_at": ""}]}