ix.net/57ddd1d1/uploads/origins/631d0166-5d67-47bd-af79-0dcd9b83c54f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=519343bcac9d141aa1708c1ef4b7aaf2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tousei/works/28", "thumbnail_src": "https://si.imgix.net/21d4f2b9/uploads/origins/5f5b0e86-e9ac-4f64-b15d-b8be9a9f16d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=875ba9d0fb53bbedc742fb152bd545e7", "thumbnail_srcset": "https://si.imgix.net/21d4f2b9/uploads/origins/5f5b0e86-e9ac-4f64-b15d-b8be9a9f16d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=875ba9d0fb53bbedc742fb152bd545e7, https://si.imgix.net/21d4f2b9/uploads/origins/5f5b0e86-e9ac-4f64-b15d-b8be9a9f16d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3be3f373accc029edddf936db7417f61 2x, https://si.imgix.net/21d4f2b9/uploads/origins/5f5b0e86-e9ac-4f64-b15d-b8be9a9f16d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=173bf403c87a8818fa6fb6b86cd1c610 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！^^。\nキャラクターデザインをお願いしたいです。\n\n主に紫と黒を基調とした、男性の仮面をかぶったジェスターです。\n一見親しみやすく、それでいてお茶目でちょっと小悪魔的な感じ。\n\nこのアイデアの主なインスピレーションはこれらです：\nhttps://x.com/PESTRiCA_R/status/1872960660260438509\nhttps://static.zerochan.net/Jevil.full.2425500.png\nhttps://nights.fandom.com/wiki/NiGHTS_(キャラクター)\n\n可能であれば、最初の例の半袖ルックが欲しい。", "created_at": "", "completed_at": ""}, {"path": "/@tousei/works/27", "thumbnail_src": "https://si.imgix.net/72acf4ec/uploads/origins/29e1a70f-005d-4e41-9c69-0498f76867a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc23b7ba307dfd7d8b5e436ec030c3ea", "thumbnail_srcset": "https://si.imgix.net/72acf4ec/uploads/origins/29e1a70f-005d-4e41-9c69-0498f76867a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top