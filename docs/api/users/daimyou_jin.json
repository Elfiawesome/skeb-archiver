はありません。\n\n青白い触手の束に不意打ちされ、全身を撫で回され、口元にも触手がある状態でセックスして欲しいです。彼の腕は頭の上か背中で縛られています。彼の服はほとんど引き裂かれているか完全に脱がされていて、彼の眼鏡は顔から滑り落ちています。ポーズはお好みの体型で、表情は恥ずかしそうに、少し憤慨しながらも、少し楽しんでいるような感じです。可能であれば、ぐちゃぐちゃの液体も入れてください。オプションとして、内観も入れてもいいですし、可能であればイクところのバリエーションも必要ないでしょう。\n\nもし必要なら、彼の顔のマークを削除しても構いませんし、細部を変更してもかまいません。もし触手アートを描きたくなければ、リクエストを変更することも可能です。\n\nありがとうございました。\n\nhttps://toyhou.se/18120617.leyri", "created_at": "", "completed_at": ""}, {"path": "/@daimyou_jin/works/52", "thumbnail_src": "https://si.imgix.net/d98a8519/uploads/origins/9037da71-066c-444c-8881-3f920b6a5b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=209f37b1eb44b32023c30bfe34014de3", "thumbnail_srcset": "https://si.imgix.net/d98a8519/uploads/origins/9037da71-066c-444c-8881-3f920b6a5b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=209f37b1eb44b32023c30bfe34014de3, https://si.imgix.net/d98a8519/uploads/origins/9037da71-066c-444c-8881-3f920b6a5b84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=167f03d00bfdfeac625df24162065c7e 2x, https://si.imgix.net/d98a8519/uploads/origins/9037da71-066c-444c-8881-3f920b6a5b84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6deb099bbec11dcd840763b9ee86718e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@daimyou_jin/works/51", "thumbnail_src": "https://si.imgix.net/30551791/uploads/origins/a5b0e200-5589-4412-8044-242b8070fd28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb3761bbbdbed9ba093a65cf1e0bc394", "thumbnail_srcset": "http