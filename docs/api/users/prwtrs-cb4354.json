りして反撃する。\n包皮を噛む例：\nhttps://twitter.com/fuwakuyuu/status/1466851879020032000\nhttps://twitter.com/Satanya69/status/1380143396044468224\nhttps://www.pixiv.net/en/artworks/5337665\n\n私の要望をご検討いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@prwtrs/works/82", "thumbnail_src": "https://si.imgix.net/7cdbb5d8/uploads/origins/f75425c4-ec0d-4cb3-bdc6-484ad1afbeed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e951f959a2acce44afa6594745fa4fa7", "thumbnail_srcset": "https://si.imgix.net/7cdbb5d8/uploads/origins/f75425c4-ec0d-4cb3-bdc6-484ad1afbeed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e951f959a2acce44afa6594745fa4fa7, https://si.imgix.net/7cdbb5d8/uploads/origins/f75425c4-ec0d-4cb3-bdc6-484ad1afbeed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f865b622c3d7d70f9b863bc4a15568c8 2x, https://si.imgix.net/7cdbb5d8/uploads/origins/f75425c4-ec0d-4cb3-bdc6-484ad1afbeed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7581b8dbba2e17cbf5c84f74d369724 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@prwtrs/works/81", "thumbnail_src": "https://si.imgix.net/99899efc/uploads/origins/17cff62c-38e1-47f2-8a1b-5caa5f5baff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e782f293588c339733090091cb371059", "thumbnail_srcset": "https://si.imgix.net/99899efc/uploads/origins/17cff62c-38e1-47f2-8a1b-5caa5f5baff0?bg=%23fff&auto=forma