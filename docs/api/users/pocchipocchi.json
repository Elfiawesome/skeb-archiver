b9c-42b1-8548-944d983b8a59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84ab73225c7faf497f2862a9f0ea03a6, https://si.imgix.net/73bfbf25/uploads/origins/d6533a3e-1b9c-42b1-8548-944d983b8a59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c3cf0caf188de87eb442775c0c57efe 2x, https://si.imgix.net/73bfbf25/uploads/origins/d6533a3e-1b9c-42b1-8548-944d983b8a59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a584145fa954a71cb37bcd3aa61e85d9 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pocchipocchi/works/224", "thumbnail_src": "https://si.imgix.net/1d36cee9/uploads/origins/a0e7cf74-d4a7-40fd-8df9-f5aa4d08e7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0815c175620180a15b22a420020a23c7", "thumbnail_srcset": "https://si.imgix.net/1d36cee9/uploads/origins/a0e7cf74-d4a7-40fd-8df9-f5aa4d08e7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0815c175620180a15b22a420020a23c7, https://si.imgix.net/1d36cee9/uploads/origins/a0e7cf74-d4a7-40fd-8df9-f5aa4d08e7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d525788b2b425674ee1dfa6b0be8b158 2x, https://si.imgix.net/1d36cee9/uploads/origins/a0e7cf74-d4a7-40fd-8df9-f5aa4d08e7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed60cabf1bfa6b8cce1fe375da16a804 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私のOCのためにアートワークを依頼したいのですが。詳細は以下の通りです：\n  1.   前立腺オーガズムを知り、部屋で興味津々に試しているシーンを描いてほしい。\n  2.   2.顔を赤らめたり、くすぐったいような小さな快感を感じているような表情を描いてほしい。\n  3.   シーンは正面から見てほしい。\nこの情報が必要なら、彼は白いボクサーブリーフを履いている。\n私のOCの衣装は下のURLにあります。\n\nhttps://drive.google.com/file/d/1A6f4er2lE4rieNEYv4LmWYJbQaf9GA8n/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pocchipocchi/works/223", "thumbnail_src": "https://si.imgix.net/aa291433/uploads/origins/d6f07163-154d-4579-9374-5646eed2f821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eede8eac61e89e30576306ca6d03eedc", "thumbnail_srcset": "https://si.imgix.net/aa291433/uploads/origins/d6f07163-154d-4579-9374-5646eed2f821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eede8eac61e89e30576306ca6d03eedc, https://si.imgix.net/aa291433/uploads/origins/d6f07163-154d-4579-9374-5646eed2f821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a24ce7d16bd6bfbb3c313998194f4642 2x, https://si.imgix.net/aa291433/uploads/origins/d6f07163-154d-4579-9374-5646eed2f821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e4da89ba8409da4df6f8281b58fc4fd 3x", "genre": "art", "nsfw": true, "body": "男の子の絵柄が本当に大好きです！リクエストお願いします！\n\n☆シチュエーション\n・魔法少女アニメで主人公の女の子の良き理解者的ポジションだった幼馴染の少年が、敵組織に攫われ、操られた状態で敵として登場してしまった姿のイメージ一枚絵。\n\n・主人公が魔法少女に変身していることを偶然知って以降は色々と助けてくれていたが、敵組織に目をつけられ、魔法少女を追い詰めるために利用されてしまう…というイメージ。\n\n☆キャラ外見\n・操られているが目のハイライトが消えたり、肌の色が変わったりはしておらず、意地悪な笑みだけ浮かべている。\n\n・髪の長さは耳がやや隠れる程度。元々は明るく快活なサッカー少年。\n\n・敵衣装として、乳首からお腹、おちんちんまでが丸出しのスケベな衣装を着せられている。本人に恥ずかしい格好をしている自覚はない。おちんちんは大きめ。\n\n・その他についてはおまかせしたいのですが、一部苦手な外見的要素があるため避けていただけると助かります。\n☆NG要素: ほくろ、眼鏡、ピアス、刺青などの体の模様\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@pocchipocchi/works/222", "thumbnail_src": "https://si.imgix.net/9752ab66/uploads/origins/e9bed31c-be28-40a6-abd8-092eeca28b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ff71b78e1e49243f098b7cae941962f", "thumbnail_srcset": "https://si.imgix.net/9752ab66/uploads/origins/e9bed31c-be28-40a6-abd8-092eeca28b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ff71b78e1e49243f098b7cae941962f, https://si.imgix.net/9752ab66/uploads/origins/e9bed31c-be28-40a6-abd8-092eeca28b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5cdda9267efa611b76b56e185a1b087 2x, https://si.imgix.net/9752ab66/uploads/origins/e9bed31c-be28-40a6-abd8-092eeca28b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbae6b2cb72a688ce5e8410fbe54ce8b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pocchipocchi/works/221", "thumbnail_src": "https://si.imgix.net/547ab3fd/uploads/origins/55424f16-d4d5-464b-b449-7ecc67f11230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82046397356efb026aaf2c3065723e3d", "thumbnail_srcset": "https://si.imgix.net/547ab3fd/uploads/origins/55424f16-d4d5-464b-b449-7ecc67f11230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82046397356efb026aaf2c3065723e3d, https://si.imgix.net/547ab3fd/uploads/origins/55424f16-d4d5-464b-b449-7ecc67f11230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ba799b8105aa332314d3675366aa78a 2x, https://si.imgix.net/547ab3fd/uploads/origins/55424f16-d4d5-464b-b449-7ecc67f11230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=334697d71d104a3c91f6c528bd0e578e 3x", "genre": "art", "nsfw": true, "body": "こんにちは。すみませんがこの内容はいかがでしょうか。\n制服ブレザー半ズボンに白ハイソックスで太もも丸出しな男の子が卒業式の看板が立てられた校門前で円筒形の卒業証書入れを持って立っている全身イラストをお願いします。\n\n男の子\nhttps://skeb.jp/@pocchipocchi/works/197\n\n髪の色：茶髪\n\n表情：にっこりした笑顔\n\n服装詳細\nブレザー：紺色イートンダブルブレザー(襟がない)\nカッターシャツの袖が少しはみ出る、裾は半ズボンが半分以上見