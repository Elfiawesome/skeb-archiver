e-4773-a643-ec84d7ba02c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5909f907b0a1999caa687bc61d49ea", "thumbnail_srcset": "https://si.imgix.net/ada3692c/uploads/origins/61f92a9c-b48e-4773-a643-ec84d7ba02c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5909f907b0a1999caa687bc61d49ea, https://si.imgix.net/ada3692c/uploads/origins/61f92a9c-b48e-4773-a643-ec84d7ba02c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7201e8154d62ca490660530215760733 2x, https://si.imgix.net/ada3692c/uploads/origins/61f92a9c-b48e-4773-a643-ec84d7ba02c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b86c0b284a0166a9be35d400ca48bd5 3x", "genre": "art", "nsfw": true, "body": "艦これの平戸と提督の入れ替わり(https://skeb.jp/@gigokku/works/50)の続きのシチュエーションで、平戸(中身は提督)が恥ずかしがりつつ体格差にされるがままに提督(中身は平戸)に犯されるイラストをお願いします。\n構図や体位はhttps://www.pixiv.net/artworks/54900412 のようにお願いします。\n着衣のままメガネもつけたままでお願いします。\n平戸(中身は提督)の視線は結合部に向けるようにしてください。\n平戸と提督の「うふふ……行きますよ司令」、「俺の中に太くてデカいのが入ってる…！」的な台詞を入れていただけるとありがたいです。", "created_at": "", "completed_at": ""}, {"path": "/@gigokku/works/55", "thumbnail_src": "https://si.imgix.net/0512685c/uploads/origins/ba3c9a48-b937-47e7-a842-a2fd85e1e5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f5797e28e88362cfa19a0f60dc51b92", "thumbnail_srcset": "https://si.imgix.net/0512685c/uploads/origins/ba3c9a48-b937-47e7-a842-a2fd85e1e5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f5797e28e88362cfa19a0f60dc51b92, https://si.imgix.net/0512685c/uploads/origins/ba3c9a48-b937-47e7-a842-a2fd85e1e5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d811da3d3e690b9953dbe4dcd9746b4 2x, https://si.imgix.net/0512685c/uploads/origins/ba3c9a48-b937-47e7-a842-a2fd85e1e5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a489e3153897e159ff9d19915b85890 3x", "genre": "art", "nsfw": tru