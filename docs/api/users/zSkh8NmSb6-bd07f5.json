11d/uploads/origins/c348a5d9-b16f-44c3-a941-adf71b7b3f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9989b78c964c64ad9de1183566b86d18 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zSkh8NmSb6/works/10", "thumbnail_src": "https://si.imgix.net/3e08da43/uploads/origins/bcb112dd-247a-4c07-a4de-94d206cc2254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d4b5be906096c11f32c82664be0074", "thumbnail_srcset": "https://si.imgix.net/3e08da43/uploads/origins/bcb112dd-247a-4c07-a4de-94d206cc2254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d4b5be906096c11f32c82664be0074, https://si.imgix.net/3e08da43/uploads/origins/bcb112dd-247a-4c07-a4de-94d206cc2254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b59b8ed7159395a23e6256846e4b655f 2x, https://si.imgix.net/3e08da43/uploads/origins/bcb112dd-247a-4c07-a4de-94d206cc2254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d083787ff24112ec448fc4467cc6d011 3x", "genre": "art", "nsfw": false, "body": "Hello Naicha-san! \n\nYour chiikawa art is always so so cute, so I had to come back and request again!\nPlease draw my chiikawa with her 3 friends dancing like they are in an idol group! (similar to パジャマパーティーズ). The rest of the details are up to you!\n\nMinkawa: an orange mischevious mink\nch4ikawa: a hellhound with an eyepatch. She looks evil but is actually very genki!\nkikikawa: she is a very kind grey bunny.\nneppiekawa: she is a very shy pink bunny.\n\nthank you for your hard work!!!\n\nhttps://drive.google.com/drive/folders/1QK_vHFtlZbvJnB4haBncrXiVwIM67GYW?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@zSkh8NmSb6/works/9", "thumbnail_src": "https://si.imgix.net/8707c61f/uploads/origins/8af83c76-fc30-4bfb-8ff3-828694091642?b