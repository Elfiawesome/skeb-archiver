2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d5c8b488533f48e3ab02267f22ee395 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sotei06/works/32", "thumbnail_src": "https://si.imgix.net/f1ed8630/uploads/origins/c5d4a148-f078-4dfc-b5b2-62f025b7f63c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f150b1aeca791c5e166460f6dd92f514", "thumbnail_srcset": "https://si.imgix.net/f1ed8630/uploads/origins/c5d4a148-f078-4dfc-b5b2-62f025b7f63c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f150b1aeca791c5e166460f6dd92f514, https://si.imgix.net/f1ed8630/uploads/origins/c5d4a148-f078-4dfc-b5b2-62f025b7f63c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ec843034ecca32eaf05160f77560b7a 2x, https://si.imgix.net/f1ed8630/uploads/origins/c5d4a148-f078-4dfc-b5b2-62f025b7f63c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1c9c9e4ba6715b82158aa906fbb9768 3x", "genre": "art", "nsfw": true, "body": "エリアの騎士に登場する美島奈々がライバル校に捕まり主人公が試合に出られないよう人質として捕まり拘束され悪戯された姿が写された脅迫写真風イラストと差分をお願いします。\n\n詳しい希望は下記となります。\n\n①教室か部室を背景に証明写真の様に頭から胸下が写されたバストアップの状態\n②拘束は首から下はダクトテープでマミー、顔は覆面を被らされ輪郭と鼻筋がくっきり浮かび上がった状態\n③覆面の口に貼付した画素の様に舌を出している奈々の口元が描かれたらくがきテープが貼られている\n④髪の毛は覆面から出て肩口や鎖骨の辺りに掛かっている、そんな姿を撮られて不満そうな目付きをカメラに向けている\n⑤写真の隅か顔の横に「駆へ、試合には出ないでね？♡黒覆面テープミイラ女のセブンより♡」と言う送り主に向けての煽り文句が書かれている\n\n差分で覆面の上から被せ猿轡、煽り文なし、らくがきテープなし、覆面なし、猿轡なしをお願いします、無理そうなら大丈夫です。\n\nまた今回の覆面は資料の様な2ホールタイプの物でお願いします、此方も難しければ何時もの物で大丈夫です。\n\n美島奈々\nhttps://public.muragon.com/cg0fz9zb/ydoj8mu3.jpg.webp\n\nhttps://x.com/u_mo5s/status/1774776259144532011?t=gp5gHzvbvWTkle5hdXmCuA&s=19\n\nhttps://assets.st-note.com/img/1729519816-pIAUbBSXYkoMPw7K9JWHhLZT.png?width=4000&height=4000&fit=bounds&format=jpg&quality=90\n\n脅迫写真と煽り文&らくがきテープ&バストアップイメージ\nhttps://x.com/Thank_tuary93/status/1946878207082606822?t=ypXbPSa5XIK0zZTalhde9w&s=19\n\nhttps://www.deviantart.com/dwjones28/art/Drew-Barrymore-gagged-972913515\n\nhttps://www.pixiv.net/artworks/133086080\n\nhttps://livedoor.blogimg.jp/gaiamask0114/imgs/9/3/93f641b5.jpg", "created_at": "", "completed_at": ""}, {"path": "/@sotei06/works/31", "thumbnail_src": "https://si.imgix.net/33914a63/uploads/origins/e1d1aea0-b314-4f04-b352-454ee4aa0083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c9738bf429c6efa190d3ae89d5ad9db", "thumbnail_srcset": "https://si.imgix.net/33914a63/uploads/origins/e1d1aea0-b314-4f04-b352-454ee4aa0083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c9738bf429c6efa190d3ae89d5ad9db, https://si.imgix.net/33914a63/uploads/origins/e1d1aea0-b314-4f04-b352-454ee4aa0083?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84d33d55f459b4d9fc1878402a9aae28 2x, https://si.imgix.net/33914a63/uploads/origins/e1d1aea0-b314-4f04-b352-454ee4aa0083?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=327aeb50ba23b2e272074da17e949fd1 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nファイアーエムブレム風花雪月のヒルダとマリアンヌの拘束イラストをお願いします。\nヒルダ: https://guide.fire-emblem-heroes.com/12004007000409/\nマリアンヌ: https://guide.fire-emblem-heroes.com/12004006000636-2/\n拘束としては上半身はハイレグ型の拘束衣を着せられ下半身は身につけているタイツとニーハイと同じ色のタイツを履かせられベルトで厳重に拘束、展示台に固定され2人横並びに飾られいる感じでお願いします。\n展示台は過去に貴方が描いた収納ボックス風に描いて欲しいです。\n展示台のイメージ: https://skeb.jp/@sotei06/works/9\nできたらいいですがボールギャグと前頭マスク(空気穴しか空いてない)をつけられている差分もお願いします。\n分かりづらいところと料金について何かあればリクエストの再送信の方お願いします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sotei06/works/30", "thumbnail_src": "https://si.imgix.net/9d8f75c3/uploads/origins/3b48ff50-005d-4014-a2dc-8e70c8d41532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92927f7eccd7f53f9cce352d53096db8", "thumbnail_srcset": "http