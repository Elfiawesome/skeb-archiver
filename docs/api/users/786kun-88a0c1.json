s/6540003e-2b72-47f8-a8b6-3c0ccde844ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4dbf06efd5115fbd861b2797338ecf0 2x, https://si.imgix.net/b4c6b63a/uploads/origins/6540003e-2b72-47f8-a8b6-3c0ccde844ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a90409525523bb0ecb467aee631a2e75 3x", "genre": "art", "nsfw": false, "body": "Hello! Your art is beautiful. Could you please draw my vtuber? She is a sakura wolf spirit who loves ramen, sushi, desserts, cute things, and playing video games! She is very playful, affectionate, shy, and sweet with a bit of a mischevious and yandere side. She also has a wolf companion!\n\nYou can draw her however you like!\n\nhttps://imgur.com/a/Jb9SnCx", "created_at": "", "completed_at": ""}, {"path": "/@786kun/works/6", "thumbnail_src": "https://si.imgix.net/10d3bbba/uploads/origins/1f9381a6-db61-40ca-b58f-340450a32c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb190e7fee1213a740da1f9d5ef4ef4", "thumbnail_srcset": "https://si.imgix.net/10d3bbba/uploads/origins/1f9381a6-db61-40ca-b58f-340450a32c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb190e7fee1213a740da1f9d5ef4ef4, https://si.imgix.net/10d3bbba/uploads/origins/1f9381a6-db61-40ca-b58f-340450a32c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f754941f41acd504cdbebebe1a1aebca 2x, https://si.imgix.net/10d3bbba/uploads/origins/1f9381a6-db61-40ca-b58f-340450a32c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27d8993e474462d601dcbd477606da6f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今回の作品では、私のお気に入りのキャラクターが登場します。あなたはクールでキュートなスタイルをお持ちですが、私のキュートな王子様と私の友人のキャラクターが一緒に、王子様のお城でアフタヌーンティーをしているところを見てみたいです。王子はキャラクターシートの真ん中の服を着て、私の友達は以下の服のどれかを着てください。\nhttps://drive.google.com/file/d/1Dlin0tN31WXmIwEAqzIG8aCjv1q2C1Yj/view?usp=drivesdk\nそして、王子の髪、耳、尻尾の色を示す追加アートです。また、頬にあるハートのタトゥー/マークも表示されています。また、彼の両目の模様も表示されています。  \nhttps://drive.google.com/file/d/11SQbCVHZSDck8eMOU92TdgKnB5YETBOn/view?usp=drivesdk\nhttps://drive.google.com/file/d/1-CSuqI_5XH2ZNgoMSy3Axm0SJC-VdjDO/view?usp=drivesdk\nhttps://drive.google.com/file/d/1PMQdobNa_Fy0V8de5aFsMJ2cY2HKu5UK/view?usp=drivesdk\nhttps://drive.google.com/file/d/1Qgbt_ETd6IOuxennUot5Ha_j18ArQqA8/view?usp=drivesdk\nhttps://drive.google.com/file/d/1k5B5EzFQL2cxqNSCdKC5ZSolXOlhPZUt/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@786kun/works/5", "thumbnail_src": "https://si.imgix.net/f755db79/uploads/origins/7fbaff95-3dfd-48ae-bf5e-47a615d137a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44e26b06f020f754a749eeebd624af66", "thumbnail_srcset": "https://si.imgix.net/f755db79/uploads/origins/7fbaff95-3dfd-48ae-bf5e-47a615d137a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44e26b06f020f754a749eeebd624af66, https://si.imgix.net/f755db79/uploads/origins/7fbaff95-3dfd-48ae-bf5e-47a615d137a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ceee34f2354f744899e4e80a13364ebd 2x, https://si.imgix.net/f755db79/uploads/origins/7fbaff95-3dfd-48ae-bf5e-47a615d137a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c96eb0b676162d1c8d520b002e0503fd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@786kun/works/4", "thumbnail_src": "https://si.imgix.net/4ee08666/requests/258656_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d88a94328ede205d638c45d045c471df", "thumbnail_srcset"