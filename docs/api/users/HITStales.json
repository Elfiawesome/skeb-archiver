%2Ccenter&txtsize=30&txt=PRIVATE&s=d539e0f2185e48e717f444d0b761c91d 2x, https://si.imgix.net/94feaa50/uploads/origins/0708d8f9-b17a-494d-aea2-3f9f413ad123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a61e12d4dffa9787a399af870b75201 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@HITStales/works/13", "thumbnail_src": "https://si.imgix.net/d1b5b18e/uploads/origins/b070079e-39f0-42dd-bd7b-14c4b61a9164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f1f9d05722607f54c95e0fdbfa844c", "thumbnail_srcset": "https://si.imgix.net/d1b5b18e/uploads/origins/b070079e-39f0-42dd-bd7b-14c4b61a9164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f1f9d05722607f54c95e0fdbfa844c, https://si.imgix.net/d1b5b18e/uploads/origins/b070079e-39f0-42dd-bd7b-14c4b61a9164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba005eb18d2b08e96de14d2339600c4e 2x, https://si.imgix.net/d1b5b18e/uploads/origins/b070079e-39f0-42dd-bd7b-14c4b61a9164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8e7ecdb6eff586b1665b923c092745b 3x", "genre": "art", "nsfw": true, "body": "ひっつさん初めまして\n絵柄が好みでしたのでリクエストさせて頂きました\n\n【キャラ】\n東方Projectの九十九八橋\n\n【シチュ】\n九十九八橋が「和式トイレで限界放尿をしている姿」をお願いしたいです。\n\n【ポーズ】\n・両脚は大きく開いてしゃがみこんでいる\n・両手はスカートを捲り上げた状態\n・顔の向きは開放感でぼんやりと宙を眺めている\n\n【表情】\n・目は半開きの状態\n・口も同様に半開き\n・汗だくになっており、やや紅潮している\n\n【視点】\n・真正面からでお願いします。\n・頭頂部から足元まで映るようにしてください\n\n【その他指定】\n・パンツは「片足パンツ」の状態としてください\n・便器は別レイヤーに分けた上で半透明の状態としてください\n\n【差分について】\nもし余力がありましたらおしっこを出す前後の状態の差分がありますと嬉しいです。\n\n\n以上、ご都合が良ければご検討頂けると幸いです\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@HITStales/works/12", "thumbnail_src": "https://si.imgix.net/0ae078d7/uploads/origins/d2f96b77-e1d8-4ef7-96f3-bd7e7fceb026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99895c3c7be4ca781091be496a0cd70", "thumbnail_srcset": "https://si.imgix.net/0ae078d7/uploads/origins/d2f96b77-e1d8-4ef7-96f3-bd7e7fceb026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99895c3c7be4ca781091be496a0cd70, https://si.imgix.net/0ae078d7/uploads/origins/d2f96b77-e1d8-4ef7-96f3-bd7e7fceb026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3df8256d3ff4d80cfe83b5782627a88 2x, https://si.imgix.net/0ae078d7/uploads/origins/d2f96b77-e1d8-4ef7-96f3-bd7e7fceb026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f0c96108026a6eaf09932ccf4c4d252 3x", "genre": "art", "nsfw": true, "body": "前回は影狼のイラストありがとうございました。\n今回は東方Projectの犬走椛のR18絵をリクエストします。\n\n依頼したいシチュエーションとして\n発情期を迎えた椛が恋人(成人男性)の家を訪ねて\n布団(ベット)の上で激しく交尾するというもので\n体位は男性主観の正常位でお願いします。\n\n哨戒任務直後＆発情期のためフェロモンムンムンな椛は\n哨戒任務に支障が出るため中はダメです的な事を言っていますが\n既成事実が欲しいので、恋人に中出しされるのをドキドキと期待しています。\nその後、中出し絶頂した椛は中出しの余韻に浸りながら\nちゃんと責任取ってくださいねと嬉しそうです。\n\nといった内容のため、挿入中の絵を基本として\n中出しや中出し後の余韻中等の差分をお願いします。\nできれば表情の方の差分もお願いします。\n\n入れられれば擬音や喘ぎ声、台詞等もお願いします。\n\n服は全裸でＯＫです。\n\n今回も陰毛描写をお願いします。\n\n以上、ご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@HITStales/works/11", "thumbnail_src": "https://si.imgix.net/c6b531ed/uploads/origins/e54f9895-bcdf-45fe-a13d-bba934f31c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d801bcebfbc2a26d036eb5cf876b2fda", "thumbnail_srcset": "https://si.imgix.net/c6b531ed/uploads/origins/e54f9895-bcdf-45fe-a13d-bba934f31c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d801bcebfbc2a26d036eb5cf876b2fda, https://si.imgix.net/c6b531ed/uploads/origins/e54f9895-bcdf-45fe-a13d-bba934f31c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d482f58dd01c6fa2a9891bc8e73bfc9b 2x, https://si.imgix.net/c6b531ed/uploads/origins/e54f9895-bcdf-45fe-a13d-bba934f31c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe5598c062399533b685289ae6d60d9c 3x", "genre": "art", "nsfw": true, "body": "前回は慧音先生のイラストをありがとうございました！\n今回は、ギリシャ神話では産婆の守護神でもあるヘカーティア様の授乳シーンのイラストをお願いいたします。\n\nシチュエーションとしては、ヘカーティア様が取り上げた赤ん坊に、自分の豊満なおっぱいをしゃぶらせている内に、母性が溢れて、母乳が溢れ出したヘカーティア様です。\n\nヘカーティア様は、優しい雰囲気があるヘカーティア様です。\n\n表情や構図等の細かい部分はお任せいたします。\n\nイラストは足首から上の上半身でお願いいたします(足の裏が見えてるのが苦手なもので)。\n\n場所は幻想郷の人里で、慧音先生と同じく縁側に座っても良いですね。こちらのポーズもお任せいたします(立ちポーズも可です)。ひっつさんがイメージされた様にお願いいたします。\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@HITStales/works/10", "thumbnail_src": "https://si.imgix.net/75bc578c/uploads/origins/31fbb492-e925-4c3f-92a4-0819d50b8b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=160dfe059095f7baab398306898f18a9", "thumbnail_srcset": "https://si.imgix.net/75bc578c/uploads/origins/31fbb492-e925-4c3f-92a4-0819d50b8b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=160dfe059095f7baab398306898f18a9, https://si.imgix.net/75bc578c/uploads/origins/31fbb492-e925-4c3f-92a4-0819d50b8b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d3c7039e05130a44870cb5863b18ba7 2x, https://si.imgix.net/75bc578c/uploads/origins/31fbb492-e925-4c3f-92a4-0819d50b8b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=381f2235ab6a39ec60c50d9d30aa78c9 3x", "genre": "art", "nsfw": true, "body": "ラスベガスのゲーム大会EVOで@feil6さんがE'slaf++のジャンルで準優勝したためお祝いイラストを依頼します。\nメッセージは「feilさん世界2位おめでとうございます」\n資料URLのキャラがヤムチャがサイバイマンの自爆で死んだときのポーズ(feilさん了承済み)\n耳に細い触手を数本入れ耳の中で蠢いていると良いです。\nNSFW用に服が焼け焦げてほとんど残っていないというのも良いです。\n以上をお願いします。\n\nhttps://drive.google.com/drive/folders/19MVot-Rz5dfHf1n7N5sCwUMFls91Q_RU", "created_at": "", "completed_at": ""}, {"path": "/@HITStales/works/9", "thumbnail_src": "https://si.imgix.net/b652cabc/uploads/origins/12e6e30e-1b77-4568-90b5-678b78c29efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0ab8bebc5d5c99f53349f86fcea606", "thumbnail_srcset": "https://si.imgix.net/b652cabc/uploads/origins/12e6e30e-1b77-4568-90b5-678b78c29efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0ab8bebc5d5c99f53349f86fcea606, https://si.imgix.net/b652cabc/uploads/origins/12e6e30e-1b77-4568-90b5-678b78c29efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8e2772adb50c2ea46a2b828de26df0f 2x, https://si.imgix.net/b652cabc/uploads/origins/12e6e30e-1b77-4568-90b5-678b78c29efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a0913d040dd1c67eee8a036152fb10d 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n東方Projectの今泉影狼のR18絵をリクエストします。\n\n依頼したいシチュエーションとして\n発情期を迎えた影狼が恋人(成人男性)の家にお泊りして\n布団(ベット)の上で激しく交尾するというもので\n体位は男性主観の正常位でお願いします。\n\n発情期のため全身からフェロモンを漂わせる影狼は\n既成事実が欲しいため危険日だけどこのまま中に出すよう誘惑しており\n恋人に中出しされるのをドキドキと期待しています。\nその後、中出し絶頂した影狼は中出しの余韻に浸りながら\nこれであなたと番い(つがい)になれたと嬉しそうです。\n\nといった内容のため、挿入中の絵を基本として\n中出しや中出し後の余韻中等の差分をお願いします。\nできれば表情の方の差分もお願いします。\n\n入れられれば擬音や喘ぎ声、台詞等もお願いします。\n\n服は全裸でＯＫです。\n\n今年の春例大祭で頒布された同人誌と同じく\n濃い目の陰毛描写をお願いします。\n\n以上、ご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@HITStales/works/8", "thumbnail_src": "https://si.imgix.net/08486e03/uploads/origins/2e2132a9-5362-40d7-8c4d-9865270982fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a538669661605870605d8fde917ba208", "thumbnail_srcset": "https://si.imgix.net/08486e03/uploads/origins/2e2132a9-5362-40d7-8c4d-9865270982fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a538669661605870605d8fde917ba208, https://si.imgix.net/08486e03/uploads/origins/2e2132a9-5362-40d7-8c4d-9865270982fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c0a3c881d5131590e22a3818b6d5247 2x, https://si.imgix.net/08486e03/uploads/origins/2e2132a9-5362-40d7-8c4d-9865270982fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16363a4554decd013bd93a87c1997db3 3x", "genre": "art", "nsfw": true, "body": "いつも作品、楽しみにしています。\n