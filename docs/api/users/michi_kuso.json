_at": "2026-02-27T17:44:19.872226+00:00"}, {"amount": 12000, "recorded_at": "2026-02-28T06:50:48.069975+00:00"}, {"amount": 5000, "recorded_at": "2026-03-01T04:22:37.639693+00:00"}, {"amount": 8000, "recorded_at": "2026-03-01T10:19:47.825309+00:00"}, {"amount": 9000, "recorded_at": "2026-03-02T10:19:35.072752+00:00"}, {"amount": 12000, "recorded_at": "2026-03-02T23:49:04.147883+00:00"}, {"amount": 9000, "recorded_at": "2026-03-03T12:36:58.620761+00:00"}]}, "current_prices": {"art": 11000, "correction": 9000}, "price_range": {"art": {"min": 6000, "max": 11000}, "correction": {"min": 5000, "max": 12000}}, "links": [{"label": "Twitter", "url": "https://x.com/michi_kuso", "name": "michi_kuso"}, {"label": "Misskey_io", "url": "https://misskey.io/@michi_kuso", "name": "michi_kuso"}, {"label": "Website", "url": "https://ch.dlsite.com/pommu/profile/177337", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/24994377", "name": "24994377"}], "flags": {"from_archive": true}, "works": [{"path": "/@michi_kuso/works/512", "thumbnail_src": "https://si.imgix.net/df83cd7a/uploads/origins/751cbdfd-772f-4e57-acf1-bacc728920b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9e7508c852599e4ed5a6f69d28e114e", "thumbnail_srcset": "https://si.imgix.net/df83cd7a/uploads/origins/751cbdfd-772f-4e57-acf1-bacc728920b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9e7508c852599e4ed5a6f69d28e114e, https://si.imgix.net/df83cd7a/uploads/origins/751cbdfd-772f-4e57-acf1-bacc728920b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=923f3c4c626c6adb2976f3044cad4329 2x, https://si.imgix.net/df83cd7a/uploads/origins/751cbdfd-772f-4e57-acf1-bacc728920b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cc55c53d710291d563fa4b94ee40ae4 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nアーケードゲーム「機動戦士ガンダムエクストリームバーサス2」に登場するエクスプロージョンガンダムの擬人化をお願いします。\nこのMSは手から出る爆発を駆使して強襲、格闘を得意とする機体です。\n\n爆発を背景に籠手と大きめのブレードアンテナミニスカートとタイツの娘にしていただければと思います。\n\nよろしくお願いします。\n\n資料URL: https://ggame.jp/news/detail.php?id=4221", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/511", "thumbnail_src": "https://si.imgix.net/5a9c5863/uploads/origins/04338cba-6da6-4bb8-9fe3-4f0f18dec79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c9ad624d196ba2ff2e0e7bd5998cac9", "thumbnail_srcset": "https://si.imgix.net/5a9c5863/uploads/origins/04338cba-6da6-4bb8-9fe3-4f0f18dec79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c9ad624d196ba2ff2e0e7bd5998cac9, https://si.imgix.net/5a9c5863/uploads/origins/04338cba-6da6-4bb8-9fe3-4f0f18dec79f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eeccfa2fd5c58e076c962decda80af52 2x, https://si.imgix.net/5a9c5863/uploads/origins/04338cba-6da6-4bb8-9fe3-4f0f18dec79f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1db961968e3bab04243110cf307f1b0d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/510", "thumbnail_src": "https://si.imgix.net/16033eab/uploads/origins/d7767bb6-9e09-4240-940a-c6c01e71a81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a4fe069544dd8ac9e92fab247cc7e77", "thumbnail_srcset": "https://si.imgix.net/16033eab/uploads/origins/d7767bb6-9e09-4240-940a-c6c01e71a81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a4fe069544dd8ac9e92fab247cc7e77, https://si.imgix.net/16033eab/uploads/origins/d7767bb6-9e09-4240-940a-c6c01e71a81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2162b5fac7723786495259fe8b2c030 2x, https://si.imgix.net/16033eab/uploads/origins/d7767bb6-9e09-4240-940a-c6c01e71a81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c567d20746a148ef67b8cdd4473eab8 3x", "genre": "art", "nsfw": false, "body": "こちらのキャラクターを、彼女の鎧や装備をアレンジしたメカ装備を装着して戦う、スタイリッシュなメカ娘的外見の騎士となった姿を描いていただけないでしょうか。\nhttps://akuochi.com/vampire/character/knightvampirebeatriz2/\n\n彼女は真紅の全身鎧を身に着け、あらゆる攻撃から主たちを守る守護騎士として完成された姿を誇っていますが、現代にて超技術を駆使して攻めてくる強大な敵に立ち向かうため、騎士の力を現代技術と融合させて、メカ装備を全身に展開して戦うスタイルになったという設定を想定しています。\n\n敵の技術を取り入れて応用したという裏設定があるため、\n外見の方向性としては敵の技術から生まれた\nhttps://skeb.jp/@michi_kuso/works/314\nhttps://akuochi.com/vampire/character/shadowfenrirmia/\nや、以前描いていただいた敵のパワーアップした姿である\nhttps://akuochi.com/vampire/character/rebuildrecanasira/\nhttps://skeb.jp/@michi_kuso/works/305\nといったキャラクターたちが参考になるかと思います。\n\n元々の装備が全身鎧のため、同じように全身を覆うメカ装甲となっていると嬉しいのですが、胸を盛っていただくなど、全身鎧ではあるものの女性的なシルエットが映えるようなデザインになっていると大変ありがたいです。\nまた、可能であればバイザー差分もお願いできればと思います。\n\nイラストは公式サイトへの掲載や紹介画像作成のための加工、他の方へのコミッションでの引用などの用途で使用させていただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/509", "thumbnail_src": "https://si.imgix.net/48647e1a/uploads/origins/a0c334e7-43a1-41f6-b240-a1959126cff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68699d382dc5b1d7176ed8daccde464c", "thumbnail_srcset": "https://si.imgix.net/48647e1a/uploads/origins/a0c334e7-43a1-41f6-b240-a1959126cff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68699d382dc5b1d7176ed8daccde464c, https://si.imgix.net/48647e1a/uploads/origins/a0c334e7-43a1-41f6-b240-a1959126cff9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c47400d1b2a4b9fa52ff9eefbccc1441 2x, https://si.imgix.net/48647e1a/uploads/origins/a0c334e7-43a1-41f6-b240-a1959126cff9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ebd0e266c1760b025a7eeb6890685e9 3x", "genre": "art", "nsfw": false, "body": "デミギャリソン(水星の魔女)のMS少女化をお願いしたいです。\n・太い宇宙服風のアレンジ\n・頭部を模したヘルメットを手に持っている\n・首元はクッションで埋まってる(こんな感じ→https://skeb.jp/@kit_create/works/18)", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/508", "thumbnail_src": "https://si.imgix.net/e07a6ef1/uploads/origins/f798d9ac-9487-4545-bdfa-e77d8ac3b257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=230ccd3bc308007994667c712db5300d", "thumbnail_srcset": "https://si.imgix.net/e07a6ef1/uploads/origins/f798d9ac-9487-4545-bdfa-e77d8ac3b257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=230ccd3bc308007994667c712db5300d, https://si.imgix.net/e07a6ef1/uploads/origins/f798d9ac-9487-4545-bdfa-e77d8ac3b257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d28c44bf1113e89eafc99991f9363112 2x, https://si.imgix.net/e07a6ef1/uploads/origins/f798d9ac-9487-4545-bdfa-e77d8ac3b257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10b8d89532ea91d074b583dfb41d29d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/507", "thumbnail_src": "https://si.imgix.net/27f9a640/uploads/origins/25eb79a4-95fa-4b9e-97ea-b5ebb3e094e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecf6d445690733dc9c1d349c7250a7b9", "thumbnail_srcset": "https://si.imgix.net/27f9a640/uploads/origins/25eb79a4-95fa-4b9e-97ea-b5ebb3e094e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecf6d445690733dc9c1d349c7250a7b9, https://si.imgix.net/27f9a640/uploads/origins/25eb79a4-95fa-4b9e-97ea-b5ebb3e094e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8ecf2a0887e88d575833e3ba09c813b 2x, https://si.imgix.net/27f9a640/uploads/origins/25eb79a4-95fa-4b9e-97ea-b5ebb3e094e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c353d92bc8261d645b269d21d851f48d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/506", "thumbnail_src": "https://si.imgix.net/f960a7ce/uploads/origins/29250b78-24b7-49c2-bf67-299bc0d00660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03623f4ca985caa2098be8629b231c1f", "thumbnail_srcset": "https://si.imgix.net/f960a7ce/uploads/origins/29250b78-24b7-49c2-bf67-299bc0d00660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03623f4ca985caa2098be8629b231c1f, https://si.imgix.net/f960a7ce/uploads/origins/29250b78-24b7-49c2-bf67-299bc0d00660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c2203305ab0b7a64715e9c34c8963c 2x, https://si.imgix.net/f960a7ce/uploads/origins/29250b78-24b7-49c2-bf67-299bc0d00660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb2736fcb139b057c1d9308f07af3fe 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。前回は「組織」によって強制改造され戦闘用サイボーグにされてしまう少年くんを描いていただきありがとうございました。調整をされながら、「組織」の戦士として生まれ変わっていく少年くんがとても魅力的でした。\n今回は前回の少年くん(https://skeb.jp/@michi_kuso/works/435)のかっこいい姿を見たくなりしたので、ご依頼させていただきます。改造手術が完了し、主武装の大太刀を構えて、自らの改造された姿と新たに得たチカラを誇示しているような雰囲気でかっこよく描いていただければと思います。\nその他のシチュや構図、カラーリングの選択などはすべておまかせします。「組織」の戦士としてのダークネスな雰囲気をまとってかっこよく、しっかり「盛って」描いていただければ。いつもながらのマニアックな依頼になりますが、よろしくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/505", "thumbnail_src": "https://si.imgix.net/57e3bcf6/uploads/origins/2a9a8755-2464-48d2-b54b-4a958d7e8905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5509bcf4b2cf265aaf8451ac1ff8de83", "thumbnail_srcset": "https://si.imgix.net/57e3bcf6/uploads/origins/2a9a8755-2464-48d2-b54b-4a958d7e8905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5509bcf4b2cf265aaf8451ac1ff8de83, https://si.imgix.net/57e3bcf6/uploads/origins/2a9a8755-2464-48d2-b54b-4a958d7e8905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d169df28c575e624f5886d0da6b83a6c 2x, https://si.imgix.net/57e3bcf6/uploads/origins/2a9a8755-2464-48d2-b54b-4a958d7e8905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=197863770f7faa6394faab86b35009cf 3x", "genre": "art", "nsfw": true, "body": "こんばんわ。依頼させていただきます。\n\n以前描いていただいたリナ・インバース（https://skeb.jp/@michi_kuso/works/415）をまた描いていただきたいです。\n\n今回はバトル中なシチュエーションでお願いしたいです。\n魔法でも剣技でもお任せいたしますのでカッコいい感じに仕上げていただきたいです。\n\nデザインしていただいたスーツがとても素晴らしくもっと色んな表情を見たいと思い再度依頼をさせていただいています。\n内容が丸投げで申し訳ございませんがご検討いただけたら幸いです。\n\nhttps://drive.google.com/drive/u/0/folders/1J8BJ-kXDEBfRHt3RwTwxZTwtrCR0SGI7", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/504", "thumbnail_src": "https://si.imgix.net/f7d13952/uploads/origins/1721a051-1db9-4278-befa-7a2906c00803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3023bb6873be7ee95080d5d543aaae39", "thumbnail_srcset": "https://si.imgix.net/f7d13952/uploads/origins/1721a051-1db9-4278-befa-7a2906c00803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3023bb6873be7ee95080d5d543aaae39, https://si.imgix.net/f7d13952/uploads/origins/1721a051-1db9-4278-befa-7a2906c00803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a7c3074078604947cf5a45be6273386 2x, https://si.imgix.net/f7d13952/uploads/origins/1721a051-1db9-4278-befa-7a2906c00803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb7d2c36f79e18074e11b2013d97f068 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/503", "thumbnail_src": "https://si.imgix.net/582438b3/uploads/origins/9b49675c-cd7c-493b-a95a-dd87eec50806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5df15512bd27a42ca67577052764d60", "thumbnail_srcset": "https://si.imgix.net/582438b3/uploads/origins/9b49675c-cd7c-493b-a95a-dd87eec50806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5df15512bd27a42ca67577052764d60, https://si.imgix.net/582438b3/uploads/origins/9b49675c-cd7c-493b-a95a-dd87eec50806?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b7d7b6d85ba5e88567eebce95d3bd48 2x, https://si.imgix.net/582438b3/uploads/origins/9b49675c-cd7c-493b-a95a-dd87eec50806?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28b98c8f18a6d437e0979523ffca4bec 3x", "genre": "art", "nsfw": true, "body": "skebのショタサイボーグの作品が最高でしたので、デュエル・マスターズの男の娘キャラが悪堕ち改造される作品をお願いします\n\n◆キャラ\n【新世代龍覇 グレンタレット】というデュエマの男の娘キャラ\n\n◆シチュエーション\n侵略者という敵対勢力に捕まり、禁断の力に侵食くされながら肉体を改造される悪堕ちモノ\n\n◆内容\n・タレットはデュエプレの【ヴィヴィ】やボルバル8の金トレジャーのデザインを思わせる姿へと改造されながら性的な快楽洗脳をされている様子\n・タレットの意識が朦朧としていて、四肢を機械化されたり外された状態にされながら体には大小の無数のコードを繋げられて、快楽洗脳で小さく喘ぎ声を漏らしながら片目が金色に染まり、髪色も一部が変わり始めている。また改造されながら遺伝子情報を採取する為に搾精されていて、小さなペニスと金玉に機械やコードを装着されて、乳首を開発されながらアナルを機械姦されて射精を促されている\n\n◆差分\n・一際強い快楽パルスを流されて、呻くように絶頂している差分\n・洗脳の最終調整の連続で快楽パルスを流されて喘いでいる差分\n・ヴィヴィにある金色の鍵のようなものを胸に挿入されると同時に大きく絶頂している差分\n・全身に快楽エネルギーが行き渡り、更に深イキして両目が完全に金色に染まる差分\n・髪色も変わり、洗脳が完了して恍惚な表情を浮かべている差分\n・四肢も取り付けられ、ペニスとアナルには機械の貞操帯とプラグをつけられて完全な改造が完了した差分\n\n◆資料\n【https://twitter.com/M_hisashi/status/1591282722441658368】\n【https://x.com/dmps_info/status/1882722510128701667】\n【https://x.com/NkmR8/status/1603926531281387520】", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/502", "thumbnail_src": "https://si.imgix.net/efa0bc49/uploads/origins/3c2b27a1-15f1-40a3-9ee6-060bd76c2f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93f55d2de626f120b153b9723caab474", "thumbnail_srcset": "https://si.imgix.net/efa0bc49/uploads/origins/3c2b27a1-15f1-40a3-9ee6-060bd76c2f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93f55d2de626f120b153b9723caab474, https://si.imgix.net/efa0bc49/uploads/origins/3c2b27a1-15f1-40a3-9ee6-060bd76c2f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b52e962ecb449491705af5f67f4f6cb 2x, https://si.imgix.net/efa0bc49/uploads/origins/3c2b27a1-15f1-40a3-9ee6-060bd76c2f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c66553903aa05648d6155d722763a1c 3x", "genre": "art", "nsfw": true, "body": "はじめましてリクエスト失礼します\n【作品・キャラクター】\nFGO\n源頼光\nブーディカ\n【概要】\nドームに入り大きなクッションに乗って遊ぶ風船遊具（バルーンドーム）\nクッションの正体は数ｍ級に膨乳した二人のおっぱい\n体勢は乳合わせで固定。胸以外は遊具の外壁の中に埋め込まれている\n無垢な子供達に胸を玩具にされる羞恥と乳首同士がぶつかり合う快感を延々と与えられているため羞恥に悶えている表情\n\nよろしければ承認おねがいします", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/501", "thumbnail_src": "https://si.imgix.net/525a5708/uploads/origins/fc3d8001-63c9-499c-bb97-636145eaa7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce10ef6a0e0891a70eb5e85123304e4", "thumbnail_srcset": "https://si.imgix.net/525a5708/uploads/origins/fc3d8001-63c9-499c-bb97-636145eaa7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce10ef6a0e0891a70eb5e85123304e4, https://si.imgix.net/525a5708/uploads/origins/fc3d8001-63c9-499c-bb97-636145eaa7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d82b53765ebf7c0027b945a94a5bd050 2x, https://si.imgix.net/525a5708/uploads/origins/fc3d8001-63c9-499c-bb97-636145eaa7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54d6af0e943c253423d3ff743feb82e3 3x", "genre": "art", "nsfw": true, "body": "すみません二か所説明不足だったので再送させていただきます！\n\nいつも素敵なイラストをありがとうございます！\n今回もまたリクエストさせていただきます！\n\n今回は今まで描いていただいた子(https://skeb.jp/@michi_kuso/works/417)のパートナーをお願いしたいです！\n以下設定になります。\n\nピンク髪ハーフアップ\nピンクの細目（ハイライトは前の子みたいにしていただきたいです！）\n今までの子に比べ胸は大きく（大きさイメージ　https://skeb.jp/@michi_kuso/works/192）\nちんちんは小さく（大きさイメージ　https://skeb.jp/@michi_kuso/works/253）\n優しい笑顔で平気で人を犯しに来るイメージです。\nベースのぴちスーはこちらと似た紫色にしていただきたく、（https://skeb.jp/@michi_kuso/works/99　金色も混ざっていますが紫のみでお願いします！）\n胸だけ素肌でお願いします。（それかこのように乳首周りだけ透かしていただきたいです！　https://skeb.jp/@michi_kuso/works/367）\nパートナーお揃いの淫紋もつけていただきたいです！\n\n武装は最後に描いていただいた軽装modeをもとに、\n武装や自分の体（アナル）から出てくる機械触手のようなもので戦うイメージです（先っちょに爪がついているなど）\nサキュバスをモチーフに羽や角もアレンジしていただけたら幸いです！\n触手は自分の乳首やちんちん（尿道）も常に犯してる形でお願いします…！\n最後にこちらのようにちんちんも武装化に合わせて軽いスーツやアーマーをお願いします。\n\nポーズはお任せいたしますが、触手で戦っている以上手は空いてしまうので、\n優しく誘惑するような顔で指舐めてたり自分の触手からのニプルファックでがばがばになった乳首を遊んでるなどにしていただきたいです！\n\n以上になります！\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/500", "thumbnail_src": "https://si.imgix.net/ac7f7b95/uploads/origins/cef7f51f-9444-431d-8505-2667579abd77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=401096a350e50ad312f08896541023ea", "thumbnail_srcset": "https://si.imgix.net/ac7f7b95/uploads/origins/cef7f51f-9444-431d-8505-2667579abd77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=401096a350e50ad312f08896541023ea, https://si.imgix.net/ac7f7b95/uploads/origins/cef7f51f-9444-431d-8505-2667579abd77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=984ad4b7a3987cfee9aafc5a52b57eed 2x, https://si.imgix.net/ac7f7b95/uploads/origins/cef7f51f-9444-431d-8505-2667579abd77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64f3a0dbd0929d70390a3024addea307 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/499", "thumbnail_src": "https://si.imgix.net/8b60a523/uploads/origins/2a45cb6e-1fe5-4f5e-929e-86a17528386c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fa97c0faef32061a9a43bdfc00c6861", "thumbnail_srcset": "https://si.imgix.net/8b60a523/uploads/origins/2a45cb6e-1fe5-4f5e-929e-86a17528386c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fa97c0faef32061a9a43bdfc00c6861, https://si.imgix.net/8b60a523/uploads/origins/2a45cb6e-1fe5-4f5e-929e-86a17528386c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d16ff41f506ba430bb554caccff4f21d 2x, https://si.imgix.net/8b60a523/uploads/origins/2a45cb6e-1fe5-4f5e-929e-86a17528386c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c20304d80345fe3cff743f6c0c6b3861 3x", "genre": "art", "nsfw": true, "body": "待ちかねました！依頼させて頂きます！\nキャラ:ノーラ・フリュクバリ(ナイツ&マジック)\n内容:日課の乳首まんこオナニーで今日もアクメするのであった\n体型: 全体的に非常に筋肉質かつ爆乳(顔より大きい程度、)かつ太乳首&巨乳輪、なおかつ爆腿(最低でも腰より太い)、\nポーズ:上半身は自らの左乳首に手で張形らしきもの(形状はほど良く太そうであればなんでも構いません)を抽挿させている(ニプルファック)、下半身はエロ蹲踞or蟹股ポーズ\n表情:無表情のように見えるが頬が紅潮している\n衣装: 銀鳳騎士団員制服のコート(以下参考資料立ち絵も参照)+黒っぽいロンググローブとニーソックス(ラバー素材みたいなぴっちり質感だと嬉しいです)を着用\n差分もお願いしたいです！\n衣装:上記のコート無し版(ぴっちりグローブとニーソだけになった状態)\n表情:気持ち良くアクメに浸っているトロ顔、口から涎だらだら。\nその他:右乳首は母乳が勢いよく噴き出し、左乳首はぽっかりと空いた穴から母乳がドロドロと垂れ流されている。まんこからは勢い良く潮を噴いている。\n\n参考資料:https://drive.google.com/drive/folders/1-MHi0zBQaThSzqivXFF19xesAG6bDmz-\n\n上記内容の内矛盾や不明な箇所等があれば道糞さんの判断で自由に取捨選択して頂いて構いません。 可能ならば是非ともお願い致します！\n\nhttp://www.knights-magic.com/", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/498", "thumbnail_src": "https://si.imgix.net/3de4a3a1/uploads/origins/f0a01a75-3913-4673-ab44-e81501c534cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acc2a52aa789735357e714b4d6e5cd87", "thumbnail_srcset": "https://si.imgix.net/3de4a3a1/uploads/origins/f0a01a75-3913-4673-ab44-e81501c534cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acc2a52aa789735357e714b4d6e5cd87, https://si.imgix.net/3de4a3a1/uploads/origins/f0a01a75-3913-4673-ab44-e81501c534cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e11867214815c68d768b1725422f1f25 2x, https://si.imgix.net/3de4a3a1/uploads/origins/f0a01a75-3913-4673-ab44-e81501c534cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c34752c10be76eb0d7883c72d2e2703 3x", "genre": "art", "nsfw": true, "body": "こんにちは。マイ・バレンタインが腕を掴まれたり、足を掴まれたりして捕獲され、攻撃される作品を希望します。衝撃はもっと刺激的な波のような感覚でもいいです。マイはバトルシティの衣装で、大きな胸と豊かな胸の谷間が欲しいです。よりエッチにするために、好きなディテールを自由に追加してください。\n\nhttps://skeb.jp/@Kta_osushi/works/160\n\nhttps://skeb.jp/@rekka46/works/9\n\nhttps://skeb.jp/@DaiHuKu12130/works/138", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/497", "thumbnail_src": "https://si.imgix.net/c622f0a8/uploads/origins/36202f72-3a84-465e-b664-ad729fd6ecdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83196433fb7a66948bc5e9ffe1bf5b33", "thumbnail_srcset": "https://si.imgix.net/c622f0a8/uploads/origins/36202f72-3a84-465e-b664-ad729fd6ecdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83196433fb7a66948bc5e9ffe1bf5b33, https://si.imgix.net/c622f0a8/uploads/origins/36202f72-3a84-465e-b664-ad729fd6ecdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de975bdd0ebcf50c1dc720a8510b1142 2x, https://si.imgix.net/c622f0a8/uploads/origins/36202f72-3a84-465e-b664-ad729fd6ecdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f665425b037f6a804f052e24e6ad2bfc 3x", "genre": "art", "nsfw": true, "body": "前回のグシオン娘\nhttps://skeb.jp/@michi_kuso/works/449\nが、\n頭部と股だけ装甲を外し、\nグシオン側のでかい腕で巨大なpenisをしごき、大量射精しているイラストが見たいので、検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/496", "thumbnail_src": "https://si.imgix.net/0a18c92a/uploads/origins/095f33d0-25a0-4b3a-805f-745e4eb6825f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49af0349cfd20050d4120b4936a9a87c", "thumbnail_srcset": "https://si.imgix.net/0a18c92a/uploads/origins/095f33d0-25a0-4b3a-805f-745e4eb6825f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49af0349cfd20050d4120b4936a9a87c, https://si.imgix.net/0a18c92a/uploads/origins/095f33d0-25a0-4b3a-805f-745e4eb6825f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a65ba198b7145ad903127c2a2ce17f1 2x, https://si.imgix.net/0a18c92a/uploads/origins/095f33d0-25a0-4b3a-805f-745e4eb6825f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=396688a34d6f1b43f40b51b67e8d06e5 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回はスーパーロボット大戦OGよりリョウト・ヒカワをお願いします。\nリョウト本人は全裸で正面を向き、\n胸元に抱えたリオのパイロットスーツ尻をモデルにした臀部型の大型オナホ(前回以来の三穴オナホでなくリオ単独のもの)を宣伝しているといったイメージです。\nリオ尻オナホの肛門が上、マンコが下で穴の方を正面に向け、左右の尻肉部分を両手で掴んで広げ、本物そっくりに作ってありますと前後の穴を見せているといった感じです。\n実際使うと具合が良くてこんなにたっぷり出せます、と使って見せた直後の様子といった感じで、照れ顔のリョウトと、オナホの前後の穴から精液が流れ落ちる差分もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/495", "thumbnail_src": "https://si.imgix.net/f54dbe66/uploads/origins/08fdb6d8-1650-4c13-954e-6d0c6251fc70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ece0abee676357c8e610d543badca38", "thumbnail_srcset": "https://si.imgix.net/f54dbe66/uploads/origins/08fdb6d8-1650-4c13-954e-6d0c6251fc70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ece0abee676357c8e610d543badca38, https://si.imgix.net/f54dbe66/uploads/origins/08fdb6d8-1650-4c13-954e-6d0c6251fc70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=189b15ee0462364d2459dff9c5892ccb 2x, https://si.imgix.net/f54dbe66/uploads/origins/08fdb6d8-1650-4c13-954e-6d0c6251fc70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0786a2ca4ca11170d023ca9869a551d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/494", "thumbnail_src": "https://si.imgix.net/f95ce2e2/uploads/origins/0884b8f8-d628-4fb9-ae85-e3a745131517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2368405db342ac8fc1dec377633c3287", "thumbnail_srcset": "https://si.imgix.net/f95ce2e2/uploads/origins/0884b8f8-d628-4fb9-ae85-e3a745131517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2368405db342ac8fc1dec377633c3287, https://si.imgix.net/f95ce2e2/uploads/origins/0884b8f8-d628-4fb9-ae85-e3a745131517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b27ebf58427890b544aa1a7700071c59 2x, https://si.imgix.net/f95ce2e2/uploads/origins/0884b8f8-d628-4fb9-ae85-e3a745131517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dec2fd7f79e8c1fb922cfdfff9627dc 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\n【キャラクター】\n・クライ(プリコネR)\n　片目が隠れて傷が見えていますが失明しているとかいう訳ではなくメカクレキャラで隠れている部分はまぶたあたりまで縦に線状の傷が入っている感じです。\n　\n　原作だとスレンダーな体系ですが胸やお尻は盛っていただきたいです\n　乳輪の形が浮いて見える感じで、股間部分には穴が開いている感じ\n　原作の資料が立ち絵しかないので独自解釈やアレンジ、簡略化をお願いすることになるかもしれません\n　両目が見えても大丈夫です\n\n【内容】\n・ユウキ(プリコネR主人公)とのバックでのイチャラブセックス\n中出しされてアヘ顔、その後余韻に浸ってる差分をお願いします\n\n【その他】\nユウキの顔は描写しなくても大丈夫です\n\n【資料】\n公式Xより\nhttps://x.com/priconne_redive/status/1906949743487644091\n\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/493", "thumbnail_src": "https://si.imgix.net/1981282f/uploads/origins/5977a739-bf22-4dba-9abe-cf74d2ffcd65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c61aad6e8048a2dbe0e94803d60925c6", "thumbnail_srcset": "https://si.imgix.net/1981282f/uploads/origins/5977a739-bf22-4dba-9abe-cf74d2ffcd65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c61aad6e8048a2dbe0e94803d60925c6, https://si.imgix.net/1981282f/uploads/origins/5977a739-bf22-4dba-9abe-cf74d2ffcd65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c500c24d3e1b83f919710fa38e5ddbf4 2x, https://si.imgix.net/1981282f/uploads/origins/5977a739-bf22-4dba-9abe-cf74d2ffcd65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e8115a98e656b4216de9aa1e73216a4 3x", "genre": "art", "nsfw": false, "body": "前回のゲシュペンスト＋ルサルカは本当にありがとうございました。\n\n今回はスパロボのゲシュペンストと『Dies irae』のルサルカ・シュヴェーゲリンをSD機体＋美少女パイロットにアレンジして頂けないでしょうか。（最初の作品タイプでお願いします。）\nhttps://si.imgix.net/14121e1c/uploads/origins/aaaef827-8269-46e9-8c7d-ac9057920d35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f896f57403d8c73986cbf3286073ddff\n不明な点がありましたら、変更やアレンジして頂いて構いません。\n（SD体系版は次回お願いしたく思います。）", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/492", "thumbnail_src": "https://si.imgix.net/584ed651/uploads/origins/bf04d331-9a06-40c2-a767-3ee3d58b56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71cc0c2906e0499d8537080f99f073b0", "thumbnail_srcset": "https://si.imgix.net/584ed651/uploads/origins/bf04d331-9a06-40c2-a767-3ee3d58b56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71cc0c2906e0499d8537080f99f073b0, https://si.imgix.net/584ed651/uploads/origins/bf04d331-9a06-40c2-a767-3ee3d58b56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf411969fbb84a1f88235dd3cf87479f 2x, https://si.imgix.net/584ed651/uploads/origins/bf04d331-9a06-40c2-a767-3ee3d58b56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a123e7c5eb05385aa9bae0499853fee 3x", "genre": "art", "nsfw": true, "body": "先日は桃祈イラストをありがとうございましたー！\n実はもう一体考えているのですがそれはまた後々…！\n\n今回はエクスティアのＮＦモノで勝負させて頂きたいです！\n「超乳エクスティア」×「巨竿＆巨玉男の子ズ」×「ＮＦ」で\n【キャラ】\n光翼戦姫エクスティアよりエクスティア（葛城真理奈）\nＮＦ慰安用牛娘エクスティアとして、超乳化が済んでおりコスチュームも8割がたそちら寄りに。\n「牛ツノ」「カウベル」「牛柄ビキニ（参考有）」\nこの辺りを道糞さんのアレンジを加えて変化希望\n\n【おっぱい＆乳首、大体の体位】優先順になります\nhttps://cdn.imgchest.com/files/y8xcnk55894.png\nhttps://cdn.imgchest.com/files/yrgcnzp8pg4.png\nhttps://cdn.imgchest.com/files/7bwckdz9rg7.png\n【牛柄ビキニ】\nhttps://cdn.imgchest.com/files/46acqbppbp7.jpg\n乳首だけ露出したタイプ\n\n【ＮF時の乳首の広がり具合】\nhttps://cdn.imgchest.com/files/yvdcwd595ay.png\n\n【シチュエーション】\n超乳牛娘エクスティアへの調教最後の一手として\nちんぽと金玉に同じく改造を施された純真無垢な男の子達（小学生未満）と\n同じ部屋に放り込まれたエクスティア。（お互い未拘束）\nその歳ではありえないほどのカリ太で長いちんぽ竿とスイカをぶら下げた様な\nたっぷりとした金玉を持て余している男の子達を自分の口や乳首へと誘い\n巨玉を撫でながらの上目遣い吸い出しフェラやＮF性処理で応える内、吐き出される精で調教が完成し牛娘堕ち。\n媚びた様子で浅ましく乳首にちんぽを強請っていくエクスティア。\n以上でお願い致します！\n\n\n【その他お願いしたい事】\n・ＮF回数や射精数をなるべく多くして欲しい為、断面図などカットで構いません！\n・今回も是非膨乳お願いしたく最大140％までたっぷり乳内射精をかまして欲しいです！\n・堕ち後もプレイを入れて頂きたく100％楽しみながら耽る様子を希望させて下さい。\n・不明瞭な点などありましたら道糞さんのご随意にて補完お任せ致します！\n\n依頼にお付き合い頂けたら幸いです、ご一考宜しくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/491", "thumbnail_src": "https://si.imgix.net/14788717/uploads/origins/2f7f6194-a957-463b-9581-6eae5a192034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6917204d465423f810b5f3cf8dc87a97", "thumbnail_srcset": "https://si.imgix.net/14788717/uploads/origins/2f7f6194-a957-463b-9581-6eae5a192034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6917204d465423f810b5f3cf8dc87a97, https://si.imgix.net/14788717/uploads/origins/2f7f6194-a957-463b-9581-6eae5a192034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4be1550c9f653d4bc4f19d5572f270ca 2x, https://si.imgix.net/14788717/uploads/origins/2f7f6194-a957-463b-9581-6eae5a192034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dac5e80dc2af344a9993bc2a108a7bf7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/490", "thumbnail_src": "https://si.imgix.net/8acd3de9/uploads/origins/41e5cd92-fdb0-4f7a-b1cd-8139556775c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c8f8ebe4d88f6dc27283c9bd2daca28", "thumbnail_srcset": "https://si.imgix.net/8acd3de9/uploads/origins/41e5cd92-fdb0-4f7a-b1cd-8139556775c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c8f8ebe4d88f6dc27283c9bd2daca28, https://si.imgix.net/8acd3de9/uploads/origins/41e5cd92-fdb0-4f7a-b1cd-8139556775c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b258d5ebfbcc1b4a2cbd9c32be9754dc 2x, https://si.imgix.net/8acd3de9/uploads/origins/41e5cd92-fdb0-4f7a-b1cd-8139556775c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12fd2f30984015504e7f54e67166b9a0 3x", "genre": "art", "nsfw": true, "body": "こんばんは、道糞さん。skebの再開したことなので、再びリクエストを送らせていただきました　　\n\n・キャラは前回キャラデザをいただいた神咲　祈里(https://skeb.jp/@michi_kuso/works/450)と私宅のオリジナルキャラのリンゴ(https://skeb.jp/@binelu01/works/33)\n・内容は、『リンゴがカードゲームで祈里を召喚している設定で、リンゴと祈里が闇のカードゲーム的なモノで敵と戦っている』というのをお願いします\n・具体的な構図はお任せしますが、闇のカードゲーム中のワンシーンのようなイメージで、敵が召喚した機械の触手群相手に戦いを繰り広げている風にお願いします\n・差分希望で、追い詰められているイメージで祈里とリンゴが苦悶の表情を浮かべながらボロボロ(コスチュームも破けて胸がエロチックに露出していて、可能であれば流血表現もお願いします)になっている差分をお願いします\n\n以上が内容になります。ご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/489", "thumbnail_src": "https://si.imgix.net/aa0ed2c3/uploads/origins/31f959bb-022b-49b3-9384-26ab47874878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42af5140ce096895629b98679b4d0b46", "thumbnail_srcset": "https://si.imgix.net/aa0ed2c3/uploads/origins/31f959bb-022b-49b3-9384-26ab47874878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42af5140ce096895629b98679b4d0b46, https://si.imgix.net/aa0ed2c3/uploads/origins/31f959bb-022b-49b3-9384-26ab47874878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=633e2523e5a2c288a8416649d3aa3e84 2x, https://si.imgix.net/aa0ed2c3/uploads/origins/31f959bb-022b-49b3-9384-26ab47874878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f252313942028191d2e9e22e1a0fdcf2 3x", "genre": "art", "nsfw": true, "body": "リクエストが再開されるのをお待ちにしておりました！ ご都合がよろしければまた受けていただけますと幸いです！  \n今回は前回依頼した『最底辺雑魚触手モンスターのクリ責めに敗北してしまうヒカリちゃん』イラストの追加差分の作成をお願いしたいと思います。\nヒカリのクリをしゃぶり尽くし、濃密なエーテルエネルギー含有の愛液を大量に接種したことでユニークモンスターとして覚醒した最低辺雑魚触手モンスターが、周りの肉壁から様々な触手を呼び出して、ヒカリを更なる快楽地獄へ引き摺り堕としていくイメージです。\n\n ■ポーズ及び構図\n覚醒した最低辺雑魚触手モンスターの見た目は変わらず、矮小なままで抵抗出来ないヒカリを虐め抜いてください。\n・足元の肉塊から、びっしりと触手イボがあるマンコ虐めに特化した極太長触手\n・背後の肉壁から、細長い乳首虐めに特化した触手。勃起した乳首をペチペチ♡と往復ビンタを繰り返す。媚薬針も携えている。\n等々を追加していただければ嬉しいです。\n■衣装\nもし可能であれば、全体的にツヤや光沢感を追加加筆していただけると嬉しいです。\n■差分 擬音、エフェクト等のレイヤー分け \n・凶悪な触手達に囲まれて顔を青ざめさせてガクガクと身体を振るわせる。\n・「あづいィッ♡燃えでる゛ッッ゛♡」媚薬針によって媚薬注入。感度を数十倍にまで引き上げられる乳首とクリ。乳首は指の第一関節程に長勃起(乳輪や乳首の太さは変わらない)。クリはほんの少し長さが伸び、ビキビキに限界フル勃起。歯を食いしばったアヘ顔を晒すヒカリ。\n・周りの触手が一斉に責めたてられる\n・【48時間後】白目を剥いたアヘ顔を晒して、完全無力化されたヒカリ。限界フル勃起が永続し、風が当たるだけでアクメするドスケベクリトリスと乳首をピクピク振るわせている。\n\n今回も、提示した金額に見合う範囲での作成で構いませんのでどうかよろしくお願い致します。 不都合があり変更や省略が必要な点は裁量をお任せ致します。", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/488", "thumbnail_src": "https://si.imgix.net/76b5084c/uploads/origins/aa0bc4c0-cdb9-4277-a9df-cfd7214c2173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c772bf3cfa5609bf0688c794c601f6f", "thumbnail_srcset": "https://si.imgix.net/76b5084c/uploads/origins/aa0bc4c0-cdb9-4277-a9df-cfd7214c2173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c772bf3cfa5609bf0688c794c601f6f, https://si.imgix.net/76b5084c/uploads/origins/aa0bc4c0-cdb9-4277-a9df-cfd7214c2173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23863533e0f2fedff9c285f345d5f3c8 2x, https://si.imgix.net/76b5084c/uploads/origins/aa0bc4c0-cdb9-4277-a9df-cfd7214c2173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b03c91db7b2cc4467d32cd514dc27cf 3x", "genre": "art", "nsfw": true, "body": "対魔忍RPGの冬月くるりをお願いします\n\n・シチュエーションは、 \n①卑猥な肉体改造を施されながらも気丈な表情を見せるくるり。\n\n②しかし両乳首と股間とアナルに極太チンコ型バイブを挿入されて、金玉をアームでがっちりと掴まれ、チンポは機械のオナホールのピストンによってイカされてしまう。 \n\n③さらにバイブが激しく振動し始め、アームからは電流責め、オナホールの動きが更に激しくなり、母乳と愛液と精液を噴き出しながら絶頂。\n無様にも舌出しアヘ顔を晒してしまう。\n\n④ その後、バイブが抜けてもぽっかりと開きっぱなしの乳首と股間の穴。チンポからはお漏らしが……。\nくるりは涙と鼻水や涎を垂れ流し、白目を剥き、魂の抜けたような虚ろな表情を見せるのだった・・・\nといった感じでお願いします。\n\n \n・肉体改造は主に…\n腋毛、ギャランドゥ、陰毛、ケツ毛、超乳化、ムチムチボディ、ふたなり、血管がびっしり浮かび上がったドス黒いイボ付きグロチンポ状態、チンポと睾丸はエグめに肥大、金玉も黒ずんでいる状態\n\n・湯気立って体臭濃そうな感じでお願いします\n\n・格好は全裸でお願いします。\n\n ・構図とポージングは、こちらのイラストのようにお願いします。⬇\n https://skeb.jp/@michi_kuso/works/180  \n\n・ふたなりチンポは①の時は真性包茎状態で②以降はズル剥け状態でお願いします\n\n\n我儘な注文になりましたが、要望の採用は可能な限りのみで良いのでご検討お願いします", "created_at": "", "completed_at": ""}, {"path": "/@michi_kuso/works/487", "thumbnail_src": "https://si.imgix.