-4545-a293-009e25b63c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbc121cfc67c2985940ba3d4377ae66f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/9", "thumbnail_src": "https://si.imgix.net/98520b6b/uploads/origins/08e2f2e0-6f36-41ca-a8fd-139e123f7e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be3320b651611835dc77ab28868be4c5", "thumbnail_srcset": "https://si.imgix.net/98520b6b/uploads/origins/08e2f2e0-6f36-41ca-a8fd-139e123f7e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be3320b651611835dc77ab28868be4c5, https://si.imgix.net/98520b6b/uploads/origins/08e2f2e0-6f36-41ca-a8fd-139e123f7e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9d72001948cec4acf0394dc8e24990f 2x, https://si.imgix.net/98520b6b/uploads/origins/08e2f2e0-6f36-41ca-a8fd-139e123f7e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fdcf6a5c3321b2bd7558f8dff9a6e0b 3x", "genre": "art", "nsfw": true, "body": "「帰省した実家で数年ぶりに会った近所のおじいさんと成り行きでの恥じらいセッセでメス堕ち受精する安土桃さん」をお願いします。\n\n成り行きは省いてもらって結構です。\n流れとしてはニッコニコのタンクトップジジイと対面する全裸桃さん(恥じらいながら片手で胸、片手で秘部を隠すも片陥没乳首みえてる、パイパン)\n前戯開始、ジジイのテクで乳首勃起、乳首とクリで絶頂。\n安土桃(M字開脚)、恥じらいながら濡れた秘部をクパァ\n本番開始、正常位でラブラブキッス(肉棒と子宮口もキッス)\n騎乗位で自分から腰を振り快楽に浸る安土桃(この時点で快楽堕ち、ジジイは揺れる桃の片乳首を指でイジる)\nうつ伏せで動けない安土桃にジジイがバックで中出し(オホ声最高)。\n最後に立ちながら水を飲むジジイの肉棒に女の子座りした安土桃が服従のチンキッスをして終わり(受精描写はここで)\n上記のことは参考程度で大丈夫です。書くの大変でしたらヤッて受精してればOKです。\n\n安土さんのエチ絵をみて、あなたなら…と思って依頼しました。竿役書くの大変だと思いますが、是非ともお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/8", "thumbnail_src": "https://si.imgix.net/587282ce/uploads/origins/d767808d-759d-4f57-bc26-98e27a53268b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85b22b6e393e947ce2f2351540049841", "thumbnail_srcset": "https://si.imgix.net/587282ce/uploads/origins/d767808d-759d-4f57-bc26-98e27a53268b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85b22b6e393e947ce2f2351540049841, https://si.imgix.net/587282ce/uploads/origins/d767808d-759d-4f57-bc26-98e27a53268b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cb78ad39d6abd0be642baf1a784e3f2 2x, https://si.imgix.net/587282ce/uploads/origins/d767808d-759d-4f57-bc26-98e27a53268b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b9e7cd98cb9e25a06076fed1ed5e4d9 3x", "genre": "art", "nsfw": true, "body": "体験型電脳ダイブゲームをプレイする夜桜たまをお願いいたします。\n\n｢たまさんこう言うの得意だから♪｣と意気込みながらHMD装着する夜桜たま。暗転から即堕ち二コマで触手の肉壁に囚われてしまっている。\n\n・全裸に剥かれて両手両足、頭部全体を触手に絡み取られ全身ガクビク痙攣しているがそれ以上は全く身動きは出来ない\n・膣には腕程もあるイボイボ触手が子宮口まで届き、お腹がうっすらと光りポッコリしている\n・乳首には触手が吸い付き、膣に挿入された触手と同じく吸い口の内側が怪しく光っている\n・胸は肥大化しており、元の3倍ぐらい膨れ上がっている\n・SE等は好きに入れて下さい\n・画面左にログが流れて夜桜たまと触手の行動と結果が表示されている。以下ログ\n『夜桜たまは連続で絶頂している』\n『エラー:ログアウト出来ません』\n『エラー:ログアウト出来ません』\n『媚薬注入！体力回復し感度が上がった！』\n『エラー:ログアウト出来ません』\n『エラー:ログアウト出来ません』\n『触手が激しく腟内をかきまわす！』\n『夜桜たまは７回絶頂した！』\n『触手は乳首を吸い上げた！』\n『夜桜たまは４回絶頂した！』\n『エラー:ログアウト出来ません』\n『触手は子宮口をこねまわす…』\n『夜桜たまは７回絶頂した！』\n『触手は子宮に絶頂パルスを流し込む！』\n『夜桜たまは21回絶頂した！』\n『エラー:ログアウト出来ません』\n『エラー:ログアウト出来ません』\n『媚薬注入！体力回復し感度が上がった！』\n『エラー:ログアウト出来ません』\n『触手は絶頂パルスを撒き散らしながら膣内で暴れまわる！』\n『夜桜たまは44回絶頂した！』\n『触手は乳首に絶頂パルスを叩き込む！』\n『夜桜たまは11回絶頂した！』\n『エラー:ログアウト出来ません』\n\n\n\n可能なら最後にログアウト成功してよだれと涙と鼻水と汗でぐちゃぐちゃななにがなんだか分からず混乱してアクメで脳ミソをパチパチさせながら焦点の合わない表情をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/7", "thumbnail_src": "https://si.imgix.net/691d4845/uploads/origins/5d000715-9b1d-451b-bed1-1b1b33de8fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5d8ddfa4705e2203b085e756a93a539", "thumbnail_srcset": "https://si.imgix.net/691d4845/uploads/origins/5d000715-9b1d-451b-bed1-1b1b33de8fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5d8ddfa4705e2203b085e756a93a539, https://si.imgix.net/691d4845/uploads/origins/5d000715-9b1d-451b-bed1-1b1b33de8fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d698477cca3cd7fc17e6102db6382a1c 2x, https://si.imgix.net/691d4845/uploads/origins/5d000715-9b1d-451b-bed1-1b1b33de8fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5015205c5ddd77b5305528fb860c169 3x", "genre": "art", "nsfw": true, "body": "以前はこちら(https://skeb.jp/@hicha_wynn/works/6)をありがとうございました。今回も責められるたまちゃんが見たくてリクエストさせて頂きます。あとなんか手数料無料らしいので。\n\n『手足を固定されアクメビームで絶頂に絶頂を重ねる夜桜たま』をお願いいたします。\n\n前回の続きって感じで、いつの間にか3D衣装を着せられ(難しいなら前回同様全裸で結構です)、気絶から回復したが両手両足の肘と膝まで壁に固定(暴れても痛くないようにクッション材が有る)されていて焦りつつ悪態をつくたまちゃん。\n\n説明もなくサム・ライミ版Dr.オクトパスの触手みたいなの(イメージなので簡略化して貰って結構です)が四本、チキチキと音を鳴らしながらたまちゃんの回りに寄ってくる。\n\n少しの恐怖と強がりから口汚く見えない首謀者を罵った次の瞬間、触手の先からビームが左右の乳首、子宮、クリトリスに一瞬(0.5秒ぐらい？)照射され、理解できない内に絶頂させられ腰が痙攣しびくびくとさせている。「はっ？えっ？」と状況を理解する間もなく次のビームが照射され、しばらく照射が続き深イキに深イキを重ねてしまう。動ける範囲でうずくまりビームが途切れた後にもアクメを重ているが、情けない姿を見せれば思う壷と考えて歯を食いしばり耐えていた所(鼻水と涙と汗で美人が台無し)を触手にこめかみを撃ち抜かれる。一呼吸後、今までの最大級のアクメに仰け反り絶頂、大声でアクメ声を上げて気絶してしまう。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/6", "thumbnail_src": "https://si.imgix.net/042ab046/uploads/origins/ed7cad2e-872f-4b5c-ac7c-7ec534bc4e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25041823999112a59fe26d1aecf6b3e2", "thumbnail_srcset": "https://si.imgix.net/042ab046/uploads/origins/ed7cad2e-872f-4b5c-ac7c-7ec534bc4e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25041823999112a59fe26d1aecf6b3e2, https://si.imgix.net/042ab046/uploads/origins/ed7cad2e-872f-4b5c-ac7c-7ec534bc4e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f41a366f5cf2eb5c2fce87887184eda2 2x, https://si.imgix.net/042ab046/uploads/origins/ed7cad2e-872f-4b5c-ac7c-7ec534bc4e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c26b79c617f97de305d4eda5f397dc9 3x", "genre": "art", "nsfw": true, "body": "足を開いて拘束する椅子に座らされて乳首に挟まれたクリップ、下乳とお腹の子宮付近に貼られた電極パット、ディルドから電流を流されてアヘ顔になって失禁アクメする夜桜たまをお願いします。\n\n最初夜桜たまは配信画面に全裸で動けないように固定されている姿が撮されており、画面右にコメント欄、左側にルール説明が書かれている。\nルール欄には\n『夜桜たまは笑顔を絶やしてはならない』\n『スーパーチャットの額によって装着された器具が起動する』\n『最後まで笑顔を崩すこと無く居られればゲームクリア』\n\n\n最初はピリピリとした低周波とゆるーい振動とゆるーいピストンをするバイブに余裕の表情だったが、突然の高額スーパーチャット(通称赤スパ)が来て高速ピストンと電流が流れる。数分耐えていたがやがて耐えられず、ギブアップと喚くもそんなルールは無いので赤スパが連続で投入されてマシンと電流が常にマックスで起動し、やがて気絶する夜桜たま。\nディルド挿入→ゆるピストン→強ピストン&電流責め→アクメ事後放心のイメージでお願いします。\n\n\n無駄毛は無し。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/5", "thumbnail_src": "https://si.imgix.net/52746d33/uploads/origins/32cf51b4-6d2a-434a-8063-354dba3ecec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f87a972c7ff90631fb2a594f2af623", "thumbnail_srcset": "https://si.imgix.net/52746d33/uploads/origins/32cf51b4-6d2a-434a-8063-354dba3ecec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f87a972c7ff90631fb2a594f2af623, https://si.imgix.net/52746d33/uploads/origins/32cf51b4-6d2a-434a-8063-354dba3ecec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c93f2357b439736fb59eecab2c8da84 2x, https://si.imgix.net/52746d33/uploads/origins/32cf51b4-6d2a-434a-8063-354dba3ecec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee2dc41da3c8f66c91d8cacde71fee9f 3x", "genre": "art", "nsfw": true, "body": "以前はイラストありがとうございました。\nまた\nアナルを突かれてわからされているピノ様をお願いしたいです。\n\n・正面から見た状態。\n・背面駅弁で周りに見せつけられているような感じ。\n・悔しいけど感じている風の顔。\n・全裸\n・セリフなどはお任せします。\n・　可能であれば射精絶頂と引き抜き後の差分をお願いします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/4", "thumbnail_src": "https://si.imgix.net/9951f27e/uploads/origins/8de9ed97-38c9-459f-a1f5-f8078af7631f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a22fc68d3d64cffcb8589f56b31310d", "thumbnail_srcset": "https://si.imgix.net/9951f27e/uploads/origins/8de9ed97-38c9-459f-a1f5-f8078af7631f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a22fc68d3d64cffcb8589f56b31310d, https://si.imgix.net/9951f27e/uploads/origins/8de9ed97-38c9-459f-a1f5-f8078af7631f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3355ccb05506419551be47841a24c60f 2x, https://si.imgix.net/9951f27e/uploads/origins/8de9ed97-38c9-459f-a1f5-f8078af7631f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58aa886447c8f2fb69c367f23d1c13b2 3x", "genre": "art", "nsfw": true, "body": "ぶいぱいの斜落せつなのイラストをお願いします(再送申し訳ない)\n・リード付きの首輪＋アナル尻尾＋露出系の恰好\n・(画面外の)誰かにリードを持たれた状態で犬の片足上げポーズで放尿", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/3", "thumbnail_src": "https://si.imgix.net/a3ab4b6b/uploads/origins/0830a7f9-70b6-457b-8bb4-2f286d48a003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfdaedf619671d2727c92384f5c7eb10", "thumbnail_srcset": "https://si.imgix.net/a3ab4b6b/uploads/origins/0830a7f9-70b6-457b-8bb4-2f286d48a003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfdaedf619671d2727c92384f5c7eb10, https://si.imgix.net/a3ab4b6b/uploads/origins/0830a7f9-70b6-457b-8bb4-2f286d48a003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ac16a4f32134459f30c2298d24767fe 2x, https://si.imgix.net/a3ab4b6b/uploads/origins/0830a7f9-70b6-457b-8bb4-2f286d48a003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c82c2291183c8ab4a7327581707faf0 3x", "genre": "art", "nsfw": true, "body": "こんばんは。\n前回のpn様のイラストが最高でしたのでもう一度お願い出来ますでしょうか。\n顔面騎乗位をするpn様をお願いします。\n\nシチュエーション…前回のイラストでpn様が我慢できなくなって押し倒した\n全裸になり顔面にアソコを押し付け強制的に舐めさせている\n構図は主観視点で、ドアップのアソコとpn様のおっぱい、顔が見える\nSっ気のあるセリフでお願いします\n\n可能であればイキ差分もお願いしたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/2", "thumbnail_src": "https://si.imgix.net/fc8a8e80/uploads/origins/3f1bf6c0-b2a4-444e-ad46-24c52623e7a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909581804d3fe7fab09cfe4f24e7f63a", "thumbnail_srcset": "https://si.imgix.net/fc8a8e80/uploads/origins/3f1bf6c0-b2a4-444e-ad46-24c52623e7a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909581804d3fe7fab09cfe4f24e7f63a, https://si.imgix.net/fc8a8e80/uploads/origins/3f1bf6c0-b2a4-444e-ad46-24c52623e7a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2640415cfb8a271a993fc6226e7fe35 2x, https://si.imgix.net/fc8a8e80/uploads/origins/3f1bf6c0-b2a4-444e-ad46-24c52623e7a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63b3b2dd1961bb46bbdb4bd8c05c5f91 3x", "genre": "art", "nsfw": true, "body": "ピノ様のイラストを依頼させていただけないでしょうか。\nスケスケベビードールで誘惑するピノ様をお願いします。\n\nベッドの前に立ってチロッと舌を出しながら、こちらを見ていたずらっぽい笑顔で微笑んでいる。\n両手でベビードールの裾を摘み、少しだけ捲り上げている。\n\n構図は真正面を向いていてカメラ目線。\nベビードールのデザインは以下のイメージでお願いします。\nキャミソール…紫色系で乳首が見えるくらいスケスケ、胸元に小さいリボンがある。\nショーツ…スケスケの紐パンで肌と陰毛が透けて見える。陰毛がはみ出さない程度に際どいもの。\n細かいレースなどは省略していただいて構いません。\nセリフなどはお任せします。\n\nまた可能であればキャミソールのみショーツなし差分と全裸差分をお願いします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hicha_wynn/works/1", "thumbnail_src": "https://si.imgix.net/c53e546e/uploads/origins/f06c3b11-d3b8-49cc-a36c-99c05ffd5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36acc71f2b812f8bbd5ef100f951ad6", "thumbnail_srcset": "https://si.imgix.net/c53e546e/uploads/origins/f06c3b11-d3b8-49cc-a36c-99c05ffd5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36acc71f2b812f8bbd5ef100f951ad6, https://si.imgix.net/c53e546e/uploads/origins/f06c3b11-d3b8-49cc-a36c-99c05ffd5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1837a7e576b356051c0f68f1c934208c 2x, https://si.imgix.net/c53e546e/uploads/origins/f06c3b11-d3b8-49cc-a36c-99c05ffd5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b002165157895b00c6f442e025206c97 3x", "genre": "art", "nsfw": true, "body": "局部が露出している水着か下着の姿で、アナル尻尾を付けているpn様のイラストをお願いします", "created_at": "", "completed_at": ""}]}