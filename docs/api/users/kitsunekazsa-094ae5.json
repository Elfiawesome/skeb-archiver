/uploads/origins/df6e836e-2ff2-40a0-a95e-00b9d0bd5d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29e925346723edd78ddd20944896860a", "thumbnail_srcset": "https://si.imgix.net/70bbfa54/uploads/origins/df6e836e-2ff2-40a0-a95e-00b9d0bd5d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29e925346723edd78ddd20944896860a, https://si.imgix.net/70bbfa54/uploads/origins/df6e836e-2ff2-40a0-a95e-00b9d0bd5d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42fc44d4190e6cad4774cc3223695b0f 2x, https://si.imgix.net/70bbfa54/uploads/origins/df6e836e-2ff2-40a0-a95e-00b9d0bd5d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca67b1cb37f4385fc9df519a2013ff56 3x", "genre": "art", "nsfw": false, "body": "私服シュヴァルグランが海釣りしてるところを描いて欲しいです。\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kitsunekazsa/works/12", "thumbnail_src": "https://si.imgix.net/35840d3b/uploads/origins/2ab1189d-4dd8-4d00-b02a-8d82369448ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b916149055211c342731ed320c9b5e27", "thumbnail_srcset": "https://si.imgix.net/35840d3b/uploads/origins/2ab1189d-4dd8-4d00-b02a-8d82369448ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b916149055211c342731ed320c9b5e27, https://si.imgix.net/35840d3b/uploads/origins/2ab1189d-4dd8-4d00-b02a-8d82369448ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80c6a15f7f4748315c9b417a41aafb99 2x, https://si.imgix.net/35840d3b/uploads/origins/2ab1189d-4dd8-4d00-b02a-8d82369448ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aea7a390feef03d6c1d3c4b42adfbb0f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！  ウマ娘のサイレンススズカの画像をお願いしたいのですが、以前描いていただいたブルボン美穂乃の画像のようなポーズでお願いします。水着を着て、サロンを結んだり、引き上げたりしながら、身を乗り出しているようなポーズでお願いします。見る人に見られるのが恥ずかしいという表情でお願いします。ありがとうございました。https://ibb.co/album/ZHHQfy\n\nhttps://ibb.co/albu