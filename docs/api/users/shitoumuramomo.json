0e-bc4b-1c214d30ea21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e68028d9a74e76408b5be00aa662c950 2x, https://si.imgix.net/622928d5/uploads/origins/f2a3fa6d-95ba-430e-bc4b-1c214d30ea21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a911c601aaf578d18c99f0fc3da8eaaa 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nしとうさんの絵柄でうちの猫をマスコット風に描いてほしくてリクエストを送らせていただきました！\n\n描いてほしい猫の写真はこちら↓をご覧ください（グーグルドライブ）\nhttps://drive.google.com/drive/folders/1e4_dcRlDh1EERSwfnVrGH_wVT28ozgfx?usp=sharing\n\n一応三毛猫の女の子で、名前はくまです。勇敢な性格ですが警戒心は少し強めです。ほかの猫に対しては世話焼きなところもあります。\n同じような写真多めですみません。お腹は白が多いです。\n一枚だけほかの猫がうつっている写真があると思いますが、子供の頃から兄弟のように育っていて仲のいい黒猫のくのちゃん(女の子)です。クールでツンデレなところがある子です。実際には兄弟ではありません。この子は描かなくて大丈夫ですが、もし余力があれば描いていただけると嬉しいです。\n\n構図やサイズなどはおまかせしますが、正方形のキャンバスに描いていただけるとありがたいです。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/25", "thumbnail_src": "https://si.imgix.net/26594067/uploads/origins/bfbc6036-3cc0-4d45-9007-f7f5489fe510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13dc05fd15c557fd41058a6132902b83", "thumbnail_srcset": "https://si.imgix.net/26594067/uploads/origins/bfbc6036-3cc0-4d45-9007-f7f5489fe510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13dc05fd15c557fd41058a6132902b83, https://si.imgix.net/26594067/uploads/origins/bfbc6036-3cc0-4d45-9007-f7f5489fe510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5f921819986897d70cc720335d82c41 2x, https://si.imgix.net/26594067/uploads/origins/bfbc6036-3cc0-4d45-9007-f7f5489fe510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49e6413b1a5e0ee947384d1a897a0f20 3x", "genre": "art", "nsfw": false, "body": "しとう様\n\nこんにちは！いつもお世話になっております、むぎと申します。\nしとう様の描かれる人外マスコットのイラストのタッチが大変好みですので、依頼させていただきました！\n\n【依頼内容】\n私の一次創作『ステこっと！』のキャラクター、「レド」と「ラビュア」のイラストを描いていただけますでしょうか？\n具体的な構図といたしましては、レドくんが笑顔でラビュアちゃんの手を取って、それに若干戸惑いつつも、照れている表情のラビュアちゃんを希望します。なお、レドくんは体が黒鉛のように黒いため、握られたラビュアちゃんの手先は若干汚れているように描いていただけるとありがたいです…！表情の差分の有無や背景等はしとう様にお任せします。\n\n【キャラクター資料】\nレド：https://x.com/barelybarley615/status/1775097406218256632?s=61\nラビュア：https://x.com/barelybarley615/status/1775097536472387933?s=61\n(資料URL欄には、キャラクター全体の資料を貼付しております。)\n\n以上です！何卒ご検討いただけますと幸いです。\n\nむぎ\n\nhttps://x.com/barelybarley615/status/1774995226333188349?s=61", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/24", "thumbnail_src": "https://si.imgix.net/a2174853/uploads/origins/2d3cca20-9811-4b4c-b2d9-6eea1931bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3ca5c8e9c8e402b35952fb6e8f28ea", "thumbnail_srcset": "https://si.imgix.net/a2174853/uploads/origins/2d3cca20-9811-4b4c-b2d9-6eea1931bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3ca5c8e9c8e402b35952fb6e8f28ea, https://si.imgix.net/a2174853/uploads/origins/2d3cca20-9811-4b4c-b2d9-6eea1931bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a2d88d6b0c5bda494b1654f9c5c351d 2x, https://si.imgix.net/a2174853/uploads/origins/2d3cca20-9811-4b4c-b2d9-6eea1931bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f0d6e6529045b5bf1aec20fd956ddd7 3x", "genre": "art", "nsfw": false, "body": "すたでび平和ifの妄想リク失礼します！穏やかな表情をしているしろめるとくらびーにサンドイッチみたいにくっついて挟まれて少し照れているくろるの3匹のイラストを見てみたいです。\n何卒ご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/23", "thumbnail_src": "https://si.imgix.net/b2cb873a/uploads/origins/bd85760c-1d97-4cf8-9fdc-9da69800e91f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50e8b4ece2262220e6504a35e4ffc961", "thumbnail_srcset": "https://si.imgix.net/b2cb873a/uploads/origins/bd85760c-1d97-4cf8-9fdc-9da69800e91f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50e8b4ece2262220e6504a35e4ffc961, https://si.imgix.net/b2cb873a/uploads/origins/bd85760c-1d97-4cf8-9fdc-9da69800e91f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a6c194f05c3d7ddf39be9f82d703e65 2x, https://si.imgix.net/b2cb873a/uploads/origins/bd85760c-1d97-4cf8-9fdc-9da69800e91f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e89899c58a63f23465b59c5ef6c1c70b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/22", "thumbnail_src": "https://si.imgix.net/07f68d8c/uploads/origins/40cb65e0-0827-4fde-bc4f-a2cc54d65e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=333dd33b457eb87e06ec7e936e0a6fdf", "thumbnail_srcset": "https://si.imgix.net/07f68d8c/uploads/origins/40cb65e0-0827-4fde-bc4f-a2cc54d65e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=333dd33b457eb87e06ec7e936e0a6fdf, https://si.imgix.net/07f68d8c/uploads/origins/40cb65e0-0827-4fde-bc4f-a2cc54d65e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3596b8dc9258a30cf6b3f1046e0c997c 2x, https://si.imgix.net/07f68d8c/uploads/origins/40cb65e0-0827-4fde-bc4f-a2cc54d65e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a75c10a2c9a24ecff13f74fdfda1881 3x", "genre": "art", "nsfw": false, "body": "初めまして、いきなりで不躾なのですがリクエスト失礼いたします。\n\nしとう様のキャラクターであるどらったさんのデフォルメマスコット形態(=変身していない通常時の姿)を背中を向けている構図で描いていただきたいです。\n\nそのままだと髪で隠れてしまいそうな翼の付け根もしっかり見えているととても助かりますけれど、こちらはあくまでも希望にすぎないのでこの要望については気にせずに描いていただいてOKです。\n\nそれ以外の細かい部分につきましては全てしとう様にお任せしますのでリクエストを引き受けていただけるようでしたら何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/21", "thumbnail_src": "https://si.imgix.net/c607bf08/uploads/origins/c1e5cec6-0983-450b-b9ea-41208881d0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98577c2c0049bc9c2dabd472d470440", "thumbnail_srcset": "https://si.imgix.net/c607bf08/uploads/origins/c1e5cec6-0983-450b-b9ea-41208881d0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98577c2c0049bc9c2dabd472d470440, https://si.imgix.net/c607bf08/uploads/origins/c1e5cec6-0983-450b-b9ea-41208881d0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89bebebfa4804b6bda6bbb02da834039 2x, https://si.imgix.net/c607bf08/uploads/origins/c1e5cec6-0983-450b-b9ea-41208881d0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d537f804a920b3a3f737bb9919271d39 3x", "genre": "art", "nsfw": false, "body": "リピートリクエスト失礼します。しとう様の描いてくださったイラストがとても素晴らしかったのでまた見てみたいと思い以下の通りリクエストさせていただきます。\nすた☆でびのばいこんのいわゆる病みかわいいと呼ばれるようなイラストを希望します。人間形態(生前の姿か覚醒した姿かは問いません)とマスコット形態両方描かれていたらなおありがたいです。構図やポーズはお任せします。何卒検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/20", "thumbnail_src": "https://si.imgix.net/ee9fdaaa/uploads/origins/67d5494c-027b-4c0b-b2bc-d2e2b9291210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e02471ad613300d29eb095ea01a83f5", "thumbnail_srcset": "https://si.imgix.net/ee9fdaaa/uploads/origins/67d5494c-027b-4c0b-b2bc-d2e2b9291210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e02471ad613300d29eb095ea01a83f5, https://si.imgix.net/ee9fdaaa/uploads/origins/67d5494c-027b-4c0b-b2bc-d2e2b9291210?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3022b4bb1ce1c2339d87d920f175d59 2x, https://si.imgix.net/ee9fdaaa/uploads/origins/67d5494c-027b-4c0b-b2bc-d2e2b9291210?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96d8f255691471182438be764500f5f7 3x", "genre": "art", "nsfw": false, "body": "初めての依頼をさせていただきます。\n紫雲しゅしゅさんと私のキャラ「キューブマン」が一緒にいる場面のイラストを希望します。\n\n●キューブマンについて\n\n白い箱でできた人形の様なキャラです。\n「NPC」と書かれた盾を持っている他、肩の部分には01や02といったナンバーがあります。(数字はどちらでもOKです)\n頭身や各パーツの寸法といった細かな点は描きやすい様にアレンジして差し支えありません。\n\n●シチュエーションと詳細\n\n・仕事帰りのしゅしゅさんが美味しいエナジードリンクっぽいものを飲み元気いっぱいの様子。\n無敵モードとなり、はしゃぐしゅしゅさんが盾を構えたキューブマンを体当たりでふっとばしている。\n\n・無敵モードの演出は自由に描いていただければと思います。\n・背景や細かな構図などもお任せします。\n\nお時間のある時の制作で問題ありません。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AzBB5jQHofa48xU4N_3X45Pq-1azxLMB?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/19", "thumbnail_src": "https://si.imgix.net/dc844e67/uploads/origins/8ac2f816-085f-4cbf-84dc-933e4969c024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2959b2c8851913ccd43b4646bff199c", "thumbnail_srcset": "https://si.imgix.net/dc844e67/uploads/origins/8ac2f816-085f-4cbf-84dc-933e4969c024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2959b2c8851913ccd43b4646bff199c, https://si.imgix.net/dc844e67/uploads/origins/8ac2f816-085f-4cbf-84dc-933e4969c024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e31220cd0befc1f8b75c601a37027dad 2x, https://si.imgix.net/dc844e67/uploads/origins/8ac2f816-085f-4cbf-84dc-933e4969c024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca5936de3c58abebca0f9c05a550ec41 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ゲーム楽しかったです...！\n\nこの事実とは別に、私のキャラクターがしとうさんの絵柄で描かれたらどんな雰囲気になるのか期待して応募します。\n\nアトリア - https://postimg.cc/v4h5ZS0k\nトゥロモス - https://postimg.cc/hJ8jDYvp\n\nアトリアとトゥロモスは恋人同士です。\nこの設定を参考に自由に描いてください...！", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/18", "thumbnail_src": "https://si.imgix.net/a94f167a/uploads/origins/60fa3603-89e1-432f-abfa-8c3ec6d9beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf40fd147ac132dbaa972922ae4cd0dd", "thumbnail_srcset": "https://si.imgix.net/a94f167a/uploads/origins/60fa3603-89e1-432f-abfa-8c3ec6d9beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf40fd147ac132dbaa972922ae4cd0dd, https://si.imgix.net/a94f167a/uploads/origins/60fa3603-89e1-432f-abfa-8c3ec6d9beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f39f4663a461ca2780bb0ecb98bcd4b 2x, https://si.imgix.net/a94f167a/uploads/origins/60fa3603-89e1-432f-abfa-8c3ec6d9beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2ddbd1ef4c351485df8560574363037 3x", "genre": "art", "nsfw": false, "body": "初めまして、グルテンと申します。\nしとう様の制作されたすた⭐︎でびやのろいの森をプレイして可愛さとその見た目とは裏腹な過酷な世界観に惹かれました。早速ですがしとう様の描かれたキャラクターの中で特に気に入ったキャラクターがおりましたので下記の通りに依頼させていただきます。\nのろいの森のぱいだーちゃんがはにびぃちゃんにお揃いのアイドル服を着せられて恥ずかしそうにかつドキドキしているイラストを希望します。\n何卒ご検討のほどをよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/17", "thumbnail_src": "https://si.imgix.net/681465f1/uploads/origins/625074a2-5844-4f9a-97df-74bf61344e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f504ae740dcd37f7af2c54bf8f9ef2e9", "thumbnail_srcset": "https://si.imgix.net/681465f1/uploads/origins/625074a2-5844-4f9a-97df-74bf61344e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f504ae740dcd37f7af2c54bf8f9ef2e9, https://si.imgix.net/681465f1/uploads/origins/625074a2-5844-4f9a-97df-74bf61344e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3f6f706d655d8302c29648c90e31c4c 2x, https://si.imgix.net/681465f1/uploads/origins/625074a2-5844-4f9a-97df-74bf61344e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6b4f64b1fc5e7352fb2ce9ff8f24fe7 3x", "genre": "art", "nsfw": false, "body": "しとう様\n\n初めまして！め～と申します。しとう様が制作したすたでびのゲームの世界観や可愛いマスコットキャラクターに惹かれ、可愛らしい擬獣化のイラストを描いているしとう様に是非この二人の擬獣化を描いて頂きたいと思い、依頼させて頂きました！\n\n2人は仲が悪いのですが喧嘩しているように見えてじゃれあってる感じにお願いしたいです><具体的な構図はお任せします！(紫の方が茶色を煽ってるような表情にしていただけると幸いです！)\n衣装は分かりにくいと思うので、アレンジして頂いても全然大丈夫です！\n\n参考資料はこちらになります\nhttps://drive.google.com/drive/folders/1AqpxWn0IoUdxOB3nolI8jzozEd3VUlFO\n\n何卒ご検討の程よろしくお願いいたします＞＜", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/16", "thumbnail_src": "https://si.imgix.net/ef1ba10a/uploads/origins/65ee66a3-1380-480a-af93-72a20c714499?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915394bb9ffde75b64cd3d35466042d7", "thumbnail_srcset": "https://si.imgix.net/ef1ba10a/uploads/origins/65ee66a3-1380-480a-af93-72a20c714499?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915394bb9ffde75b64cd3d35466042d7, https://si.imgix.net/ef1ba10a/uploads/origins/65ee66a3-1380-480a-af93-72a20c714499?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62f9465ea954f5da7ee31edf2cc0500d 2x, https://si.imgix.net/ef1ba10a/uploads/origins/65ee66a3-1380-480a-af93-72a20c714499?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf13c575d5fe33790c2b6873c92d9974 3x", "genre": "art", "nsfw": false, "body": "こんにちは！また私です。前回描いていただいた作品がとても気に入ったので、また描いていただけたらと思っていました。今回は、爪を出して怖がるように両手を上げているのがとてもかわいいと思いました。モンスターの真似をして！また、もし可能であれば、最後に描いた作品のコピーを文字なしで添付していただけませんか？とてもありがたいです。それが無理なら、今回の新作の依頼を引き受けてください。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/15", "thumbnail_src": "https://si.imgix.net/19fb28f6/uploads/origins/4758dba1-4890-462f-85fa-23085c908872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b60985e2b14d3f7b7ff341e8234d9d", "thumbnail_srcset": "https://si.imgix.net/19fb28f6/uploads/origins/4758dba1-4890-462f-85fa-23085c908872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b60985e2b14d3f7b7ff341e8234d9d, https://si.imgix.net/19fb28f6/uploads/origins/4758dba1-4890-462f-85fa-23085c908872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=822ead9897e6bca7031cf2eded3f4ccc 2x, https://si.imgix.net/19fb28f6/uploads/origins/4758dba1-4890-462f-85fa-23085c908872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7972560a2db7b9096c2f2fc6b44dbe9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はジャンゴという名前の毛皮をまとったオオカミの絵を描きたいと思っています。彼は巨大な赤いオオカミで、自分の行動をコントロールするのが苦手なんだ。彼は良い子でいるためにベストを尽くしているし、根は優しい人なんだ。あなたのスタイルで、好きなポーズで彼を描いてください。体操服や短パンで隠れるように描いてください。\n\nhttps://imgur.com/a/BeUplnB", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/14", "thumbnail_src": "https://si.imgix.net/4ea27b63/uploads/origins/37fe4738-2565-4e66-8795-c1b3c763f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2296751baffe2957f25c4263ba57818", "thumbnail_srcset": "https://si.imgix.net/4ea27b63/uploads/origins/37fe4738-2565-4e66-8795-c1b3c763f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2296751baffe2957f25c4263ba57818, https://si.imgix.net/4ea27b63/uploads/origins/37fe4738-2565-4e66-8795-c1b3c763f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a7ec50e3e2b3808f2baafabffea8a81 2x, https://si.imgix.net/4ea27b63/uploads/origins/37fe4738-2565-4e66-8795-c1b3c763f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a26eff63af5119ea90d5b05f2fdc249 3x", "genre": "art", "nsfw": false, "body": "僕のキャラクターを描いてくれない？\n\nhttps://drive.google.com/drive/folders/12viDee3TlE_45whIT6dMJumsDEgsvZDh?usp=sharing\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/13", "thumbnail_src": "https://si.imgix.net/c920ef80/uploads/origins/86616756-a784-4a95-b3fc-8a50b225af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=153f9dc45856d3d12bd69aea6fb2e040", "thumbnail_srcset": "https://si.imgix.net/c920ef80/uploads/origins/86616756-a784-4a95-b3fc-8a50b225af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=153f9dc45856d3d12bd69aea6fb2e040, https://si.imgix.net/c920ef80/uploads/origins/86616756-a784-4a95-b3fc-8a50b225af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44d123dcd7c741dfab9c2e3dc651c393 2x, https://si.imgix.net/c920ef80/uploads/origins/86616756-a784-4a95-b3fc-8a50b225af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=825908ed2dba1b14ce7e4b0ae6ef94d2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターをあなたの他のチビスタイルのように描いていただけませんか？  彼はちょっとドヤ顔で生意気です。  好きなように描いてください。\n\nその他の参考資料 https://mnchino.github.io/refsite/ https://imgur.com/a/LJRPDDb\n\nhttps://imgur.com/a/O1RpV3n", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/12", "thumbnail_src": "https://si.imgix.net/940c5d8c/uploads/origins/ad4c09e0-d473-4e0a-a874-a2c283feb189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815406da2762b473e341f4d1660d78cd", "thumbnail_srcset": "https://si.imgix.net/940c5d8c/uploads/origins/ad4c09e0-d473-4e0a-a874-a2c283feb189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815406da2762b473e341f4d1660d78cd, https://si.imgix.net/940c5d8c/uploads/origins/ad4c09e0-d473-4e0a-a874-a2c283feb189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=241c0051882a3d55ef07efcf8645dfb3 2x, https://si.imgix.net/940c5d8c/uploads/origins/ad4c09e0-d473-4e0a-a874-a2c283feb189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=054689f2aeae365b5ebc0087cd617c9f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！廃水シロップです。突然のご依頼、ご容赦ください。\n\n下記今回の依頼内容に着いてになります。\n私の代理キャラクター 「シアン」の1枚絵をお願いしたいと考えています。\nタバコを口に咥えてカッターを持ち、嫌そうな顔の表情のイラストをお願いしたいなと考えています。\n代理の資料はこちらになります。\n\n下記リンク\nhttps://drive.google.com/drive/folders/1-8eWz0h4lkKO5zyBEH9e_C3M_mTf6SMF\n\n描画の雰囲気はしとうさんのこちらのTwitterにアップされています1枚絵のような雰囲気(タッチ？)でお願いします。 \nフワフワな毛並みが強調されていると嬉しいです...！\n\n下記 しとうさんのイラストリンク\nhttps://x.com/stardevilll/status/1790731944583680073?s=61&t=JUW6ZedlLcpuMjDi-hppgg\n\nふわふわしたようなしとうさんのイラストで、自分の代理が見てみたいので、是非ご検討の程、お願い致します。イラスト活動、私生活共々お身体に気をつけてご活動くださいませ...！いつも応援しています。", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/11", "thumbnail_src": "https://si.imgix.net/6db4538a/uploads/origins/1629e4ad-9057-44d9-89bc-2744272d5e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee93ed7aa34eddc3250493aeea4cb0c6", "thumbnail_srcset": "https://si.imgix.net/6db4538a/uploads/origins/1629e4ad-9057-44d9-89bc-2744272d5e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee93ed7aa34eddc3250493aeea4cb0c6, https://si.imgix.net/6db4538a/uploads/origins/1629e4ad-9057-44d9-89bc-2744272d5e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=872a5f44e3de4ca1a3abf97becafc96d 2x, https://si.imgix.net/6db4538a/uploads/origins/1629e4ad-9057-44d9-89bc-2744272d5e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8554cdf4e965edc547118f3705248eb 3x", "genre": "art", "nsfw": false, "body": "しとう様、こんにちは！ いつもイラストを拝見しております。\n\n友人の創作キャラ兼、私の代理キャラクターのイラストをリクエストさせていただきます。\n（友人の許可を得ています。）\n\nうさぎのキャラクターの「チマ」で、特徴は丸目です。\nポーズ等はお任せしますが、プロフィール画像への使用を考えています。\n\n参考:\nhttps://www.pixiv.net/artworks/80884386\nhttps://skeb.jp/@Pepoyo/works/2\n\nよろしくお願いします🙇🏻‍♀", "created_at": "", "completed_at": ""}, {"path": "/@shitoumuramomo/works/10", "thumbnail_src": "https://si.imgix.net/203cd04f/uploads/origins/da7ab223-9c0d-411f-96bf-aa39ecf39cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2959dbc3b72ce72d126a9b48ebd8209", "thumbnail_srcset": "https://si.imgix.net/203cd04f/uploads/origins/da7ab223-9c0d-411f-96bf-aa39ecf39cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2959dbc3b72ce72d126a9b48ebd8209, https://si.imgix.net/203cd04f/uploads/origins/da7ab223-9c0d-411f-96bf-aa39ecf39cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f41b5cc2f35293e92bd976e9e554569 2x, https://si.imgix.net/203cd04f/uploads/origins/da7ab223-9c0d-411f-96bf-aa39ecf39cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=851346290333791c761e85f897bc4236 3x", "genre": "art", "nsfw": false, "body": "以前相棒のマスコットのナディアを描いて頂きました。誠に可愛く、画面がとっても映えるのでお気に入りの一枚です。誠にありがとうございます！\n\nよければ今回は　VTuberの鯨野アイカのケモノバージョンを描いていただければ嬉しいです。\n\n以下リクエスト内容をまとめさせて頂きます。  \n・VTuber鯨野アイカのケモノバージョン\n\n元々クジラモチーフなんですが全く無視してくださったら嬉しいなとワクワクしております！\n\n利用用途は \n・無料配布のポストカードへの使用 \n・Youtubeなどでサムネイルへの使用 \n・現在予定はございせんが、有償販売でマグカップなどグッズの柄への使用 \n\n透過の関係上、.pngかPSDデータで頂けたら大変嬉しいです。 お願いばかりで大変申し訳ございません。 何卒ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13L6kIoEm34tUrUV9AVL6Lxf6iysXPj1r", "created_at": "", "completed_at": ""}]}