4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f651f9d23c75a9e5cf8fd0d6acfd8466, https://si.imgix.net/7da271c1/uploads/origins/21039c40-ac1d-471a-846c-2e01082814b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c2a47873e200b19b55d91770272fdb2 2x, https://si.imgix.net/7da271c1/uploads/origins/21039c40-ac1d-471a-846c-2e01082814b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0de50af8a2451dbf4face78692f01321 3x", "genre": "art", "nsfw": false, "body": "はじめまして！  あなたのアートワークがとても素敵だったので、自分でも依頼したいと思いました！\n私のVtuberはエルフのVtuberで、カエルの仲間がいます！\n\n説明\n彼女は優しい女の子で、奇抜で創造的でとても遊び好きな魔法の守護者です。緑とカエルが大好き。ちょっと軽薄！\n\nまた、可能であれば、背景とキャラクターの間にレイヤーが入ったデータ（PSDなど）をいただけるとありがたいです。\n\nイラストの使用用途は以下の通りです。\nSNS投稿・プロモーション\nSNSアイコン、ヘッダー\nYouTube / Twitch\n\nご迷惑をおかけしていなければ幸いです。\nお忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1APh9z8jZxYAQuBpr9s-h_a8yh-uN24G2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/12", "thumbnail_src": "https://si.imgix.net/bd92ff3b/uploads/origins/220ac7a5-7175-42cb-99ee-95434f77ae84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4b4641bc6fd4819bf128b867bb3da5", "thumbnail_srcset": "https://si.imgix.net/bd92ff3b/uploads/origins/220ac7a5-7175-42cb-99ee-95434f77ae84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4b4641bc6fd4819bf128b867bb3da5, https://si.imgix.net/bd92ff3b/uploads/origins/220ac7a5-7175-42cb-99ee-95434f77ae84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6e40e4e0a71ee09f98d134a5113b3bb 2x, https://si.imgix.net/bd92ff3b/uploads/origins/220ac7a5-7175-42cb-99ee-95434f77ae84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17a39c4d7dd4e023cbefd58bcbee4cc9 3x", "genre": "art", "nsfw": false, "body": "ゆいな様\n\n初めまして、VTuberをしております、\n白餅（しらもち）だんごと申します。\n\nXにて大変可愛らしいイラストを拝見し、是非私白餅だんごのイラストのご依頼をさせていただきたくご連絡差し上げました。\n\n【使用目的】\nSNS投稿、YouTubeサムネイル、ファンクラブ会員向けに配布壁紙。（難しいものがあれば、psdデータのどこかにご記載頂けますと幸いです）\n\n【イラスト希望】\n白餅だんごが和メイド風の衣装で3色団子を食べている様子でお願いいたします。\n衣装デザインなどはおまかせいたします。\n（シンデレラナイト衣装には王冠がついていますが、王冠はなしで問題ございません。）\n髪型は通常のままでも、結んだり巻いたりなどアレンジはおまかせいたします！\n\n白餅だんごから見て左上に八重歯がありますので、そちらも記載頂けますとありがたいです。\n狐の尻尾もよろしくおねがいいたします。\n\nまた可能であれば頭（狐耳）、手などが切れないように頂けますと、大変ありがたいです。\n\n納品いただく際は大変お手数ではございますが、ゆいな様サインと人物などを切り分けた各種レイヤーorPSDで頂けますと幸いです。\n\n【白餅だんご参考資料】\nhttps://drive.google.com/drive/folders/1ympYCXkFgb5ROe8REFN3Y6XcttaYSrc8?usp=drive_link\n\n以上となります。\nとっても可愛らしいイラストでしたので、ぜひお願いできますと幸いです。\n\nご検討のほどよろしくお願いいたします。\n\n白餅だんご", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/11", "thumbnail_src": "https://si.imgix.net/def0cdc6/uploads/origins/a8857716-6485-4e8b-b285-4c3bd6cfca4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=594eb66efcc23272e910c313ecfdd78a", "thumbnail_srcset": "https://si.imgix.net/def0cdc6/uploads/origins/a8857716-6485-4e8b-b285-4c3bd6cfca4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=594eb66efcc23272e910c313ecfdd78a, https://si.imgix.net/def0cdc6/uploads/origins/a8857716-6485-4e8b-b285-4c3bd6cfca4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cc138b54032e7d62fbaeb15d80c9822 2x, https://si.imgix.net/def0cdc6/uploads/origins/a8857716-6485-4e8b-b285-4c3bd6cfca4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b795ade3eecf8bb997cba38623a158c8 3x", "genre": "art", "nsfw": false, "body": "はじめまして、素敵な絵に惹かれてリクエスト失礼します！\n\n■使用用途\n活動全般において使用いたします。\n配信サムネイル、Twitter画像投稿、アイコン等\n\n■サイズ\n縦幅が1500pxほどあれば、自由にサイズ設定していただいて構いません！\n解像度は72dpiで大丈夫です。\n\n■資料\nURLに資料をまとめています。\nこちら参考にしてください。\nhttps://drive.google.com/drive/folders/1--q-OqrpdPqiFNOl1D3HANAIuRvUTtd2?usp=drive_link\n※キャラクターデザインで間違われがちなポイントの画像あるのでご確認いただきたいです。\n頬のタトゥーは描いてほしいです。\n\n■絵の内容\nポーズはお任せします！\n性格は明るく元気なイメージです。\n髪の毛や手先、頭頂部などが画面端で見切れない構図だと嬉しいです。(URL内の構図参考)\n可能でしたら背景なしの透過pngデータもいただけると幸いです。\n\n■キャラクターデザインについて\n穴の位置が合っていればピアスのデザインは変更可能です。\n服装もご自由に変更していただいて構いません。\nイメージを守るためセクシーすぎるもの（水着ではない露骨な下着、露出の過度な衣服など）はお控えください。\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/10", "thumbnail_src": "https://si.imgix.net/7e03908e/uploads/origins/7d72e33c-b152-4346-bd94-aba855e0e42c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c655c23e63b8a7e80b4d8584dac9a0", "thumbnail_srcset": "https://si.imgix.net/7e03908e/uploads/origins/7d72e33c-b152-4346-bd94-aba855e0e42c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c655c23e63b8a7e80b4d8584dac9a0, https://si.imgix.net/7e03908e/uploads/origins/7d72e33c-b152-4346-bd94-aba855e0e42c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e621a6647c0ad60569f453fdc7a9ef8 2x, https://si.imgix.net/7e03908e/uploads/origins/7d72e33c-b152-4346-bd94-aba855e0e42c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=119305103d034c525498617c2ca7468f 3x", "genre": "art", "nsfw": false, "body": "I love your work and would love to have you draw my character! I really like your recent works with poses! My character is cute looking but a bit shy and tsundere.\n\n——————\n\nあなたの作品が大好きなので、ぜひ私のキャラクターを描いてもらいたいです！ポーズ付きの最近の作品が本当に好きです！ 私のキャラクターは、見た目はかわいいのに、ちょっと恥ずかしがり屋でツンデレです。\n\nhttps://drive.google.com/drive/folders/1s-iIaK91m33HwoSU0-eIsV8-Q_tGxW0J", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/9", "thumbnail_src": "https://si.imgix.net/cb1a59a6/uploads/origins/13cbc417-4e8a-4b34-922d-9f862555d21e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=816d457a4d4ec27e5ed7aca3ac98ddf1", "thumbnail_srcset": "https://si.imgix.net/cb1a59a6/uploads/origins/13cbc417-4e8a-4b34-922d-9f862555d21e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=816d457a4d4ec27e5ed7aca3ac98ddf1, https://si.imgix.net/cb1a59a6/uploads/origins/13cbc417-4e8a-4b34-922d-9f862555d21e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34d1c5924fdea3ee2f17deb31522d83e 2x, https://si.imgix.net/cb1a59a6/uploads/origins/13cbc417-4e8a-4b34-922d-9f862555d21e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=807acdefb26247b6defd7635ef052a59 3x", "genre": "art", "nsfw": false, "body": "初めまして！Twitterにてイラストを拝見しまして、可愛らしいブルアカキャラに惹かれました。\nよろしければ、下記のような内容でリクエストできますでしょうか？\n\nキャラはモモイもしくはミドリで、魔法少女のような格好。攻撃対象を指差しして、指先からレーザー光線のようなビームを発射しながら魔法攻撃中なイメージ(光線が指先から伸びているのが分かるような構図ですと嬉しいです)。その他、シチュエーション等についてはご自由にしていただいて大丈夫です(例えばVRゲーム内の出来事だったり、エンジニア部の怪しげな発明で変身してしまった…だったり)\n\nもし可能でしたらよろしくお願いいたします…！", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/8", "thumbnail_src": "https://si.imgix.net/73a54fef/uploads/origins/895f6580-9379-455c-a019-bfcd7d845ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092e091f662007556994d28d794cf5fb", "thumbnail_srcset": "https://si.imgix.net/73a54fef/uploads/origins/895f6580-9379-455c-a019-bfcd7d845ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092e091f662007556994d28d794cf5fb, https://si.imgix.net/73a54fef/uploads/origins/895f6580-9379-455c-a019-bfcd7d845ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc78f468f5149b529ef418682ade3dd8 2x, https://si.imgix.net/73a54fef/uploads/origins/895f6580-9379-455c-a019-bfcd7d845ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b98bddcbdae211023f39dcb7b67faf37 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n\n突然のご連絡失礼いたします。\n拝見した先生のイラストの可愛らしさに深く感銘を受け、\n是非とも『魔女の泉3』エルディの作画をご依頼したくご連絡差し上げました。\n\n▼ご依頼詳細▼\n・衣装デザイン選定用ツイートを別途ご案内（後述URL）\n・「小黑うさぎ」との交流シーンを自然に取り入れていただければ幸いです\n・その他の創作要素は先生のご判断にお任せいたします\n\n【参考資料】\n🔗衣装選択用投稿：\nhttps://twitter.com/minerminer111/status/1898722678061817875?s=19\n\n🔗小黑うさぎ設定：\nhttps://twitter.com/minerminer111/status/1898726345896775933?s=19\n\nお忙しいところ誠に恐縮ではございますが、\nご検討の程何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/7", "thumbnail_src": "https://si.imgix.net/543aba22/uploads/origins/00d151eb-9906-4682-b4ae-5957a2b07640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31fbadfd5665566bb506f0ee25c81454", "thumbnail_srcset": "https://si.imgix.net/543aba22/uploads/origins/00d151eb-9906-4682-b4ae-5957a2b07640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31fbadfd5665566bb506f0ee25c81454, https://si.imgix.net/543aba22/uploads/origins/00d151eb-9906-4682-b4ae-5957a2b07640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81b872283798a09cd71fcbaf4bad39b5 2x, https://si.imgix.net/543aba22/uploads/origins/00d151eb-9906-4682-b4ae-5957a2b07640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8b02c06d5db1818439e88df0997cf21 3x", "genre": "art", "nsfw": false, "body": "ゆいな様こんにちは、以前は素敵な作品をありがとうございます。\nゆいな様に描いていただいたイラストが気に入った為私の2体目のオリジナルキャラクターを描いていただきたく、リクエストをお送りさせていただきました。\n\n◎希望\n可能であればたい焼きを持たせて欲しいです。\n\nお手数ですが対応可否含めご確認の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-C1qPgkgU_1X4lwrijFgml_Baiu05Amn", "created_at": "", "completed_at": ""}, {"path": "/@dekanya28/works/6", "thumbnail_src": "https://si.imgix.net/79fedca5/uploads/origins/d0e156e3-0242-47ce-bd04-51f049145b93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd1bfe9cc3a85fac72859f4dd284fb8", "thumbnail_srcset": "https://si.imgix.net/79fedca5/uploads/origins/d0e156e3-0242-47ce-bd04-51f049145b93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd1bfe9cc3a85fac72859f4dd284fb8, https://si.imgix.net/79fedca5/uploads/origins/d0e156e3-0242-47ce-bd04-51f049145b93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=598480d61aab5aa7de396ceb074996cc 2x, https://si.imgix.net/79fedca5/uploads/origins/d0e156e3-0242-47ce-bd04-51f049145b93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=20