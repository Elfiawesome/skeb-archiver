leted_at": ""}, {"path": "/@ha_mo_fr/works/5", "thumbnail_src": "https://si.imgix.net/a94100ca/uploads/origins/7d0dbeaf-6083-4e7d-b226-0d34d594deb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caea72a29c397fa938288e840c862e39", "thumbnail_srcset": "https://si.imgix.net/a94100ca/uploads/origins/7d0dbeaf-6083-4e7d-b226-0d34d594deb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caea72a29c397fa938288e840c862e39, https://si.imgix.net/a94100ca/uploads/origins/7d0dbeaf-6083-4e7d-b226-0d34d594deb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d06bcb3f1f5670350d8079f249843c2c 2x, https://si.imgix.net/a94100ca/uploads/origins/7d0dbeaf-6083-4e7d-b226-0d34d594deb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67443d64a5f0ef1b9110270ef61fee31 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します！\nハナミヤさんのイラストがとても素敵だったので依頼させて頂きました！！！\nTwitterやインスタ等で使えるアイコンを描いて頂きたいです。\n\nイラストのイメージとしては、ヘアカラーは明るめのブラウンで髪型はふわふわ系でお願いしたいです。\n服装は黒色でお願いします(長袖か半袖などはお任せします)\nネイルも黒色で指はメロイックサインで人差し指と小指にのぜ君とニルズってブランドのマークがありまして、その家紋マークをさりげなく入れて頂けたらとっても嬉しいです(≧∀≦)\n\n注文が多くて申し訳ないですが、宜しくお願い致します！！！！！", "created_at": "", "completed_at": ""}, {"path": "/@ha_mo_fr/works/4", "thumbnail_src": "https://si.imgix.net/87c30676/uploads/origins/b308b01a-4ea1-4d72-bf17-a9543bae2488?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c23c84e1443ef69ae03411dd0c3f99", "thumbnail_srcset": "https://si.imgix.net/87c30676/uploads/origins/b308b01a-4ea1-4d72-bf17-a9543bae2488?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c23c84e1443ef69ae03411dd0c3f99, https://si.imgix.net/87c30676/uploads/origins/b308b01a-4ea1-4d72-bf17-a9543bae2488?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aae00c2b49267467f41b1018b92695a0 2x, https://si.imgix.net/87c30676/uploads/origins/b308b01a-4ea1-4d72-bf17-a9543bae2488?bg=%23fff&auto=format%2Ccompress&fm=