c38-70423d51ca8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=208587be905b8fae3465fde95e6bb32a, https://si.imgix.net/42de2185/uploads/origins/fab8849d-689e-4b5a-ac38-70423d51ca8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab47bdeacbbd633ed661f744e3b57c71 2x, https://si.imgix.net/42de2185/uploads/origins/fab8849d-689e-4b5a-ac38-70423d51ca8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f612f643bcf65b8d02e1ace36328744c 3x", "genre": "art", "nsfw": false, "body": "そうさんです。初めての依頼なのでなにか不備があったら申し訳ありません。\n\nFF14の自キャラを描いてほしいです。SNSのアイコンに使わせてほしいのでお顔がよく見えるバストアップくらいの大きさでおねがいします。それ以外の構図などは思いつかないのでおまかせします。\n資料はGoogle Driveです。\n\nhttps://drive.google.com/drive/folders/1TKSHnhbPBdVH6ojPEvjf4U9sVXjJPBzS?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/17", "thumbnail_src": "https://si.imgix.net/3f30698a/uploads/origins/f8b38bb9-ac52-4bba-b4ca-30bc81e3570c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3affac5d28509535ee43d82501a228b", "thumbnail_srcset": "https://si.imgix.net/3f30698a/uploads/origins/f8b38bb9-ac52-4bba-b4ca-30bc81e3570c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3affac5d28509535ee43d82501a228b, https://si.imgix.net/3f30698a/uploads/origins/f8b38bb9-ac52-4bba-b4ca-30bc81e3570c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2d531aaeadb0573c181a7ea6337286b 2x, https://si.imgix.net/3f30698a/uploads/origins/f8b38bb9-ac52-4bba-b4ca-30bc81e3570c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0a21adc0b390e773022efb9d253ec69 3x", "genre": "correction", "nsfw": false, "body": "こんにちは！げむすきのさんごです。\nいつもげむすきで色々絵の話に乗ってくださってありがとうございます！\n\n以前ちょろっと話していた、自分の絵柄ってなんだろう…客観的にどう見えるかな…と漠然とした悩みを抱えています。\n客観的にどう見えるか、もう少しここをこうしたら…や、絵柄の振れ幅についてどう見えるか、一色さんが絵を描いているときに意識していることなど、アドバイスいただきたいです。\n\nhttps://xfolio.jp/portfolio/_noah_craft/works/177299\nhttps://xfolio.jp/portfolio/_noah_craft/works/296828\n\nふんわりした相談ですみませんが、どうぞよろしくおねがいします！", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/16", "thumbnail_src": "https://si.imgix.net/02fff011/uploads/origins/64d97b7e-8a5f-4953-a1d0-01055d95d0a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0106c562e38f8db2150bf5496d3b1083", "thumbnail_srcset": "https://si.imgix.net/02fff011/uploads/origins/64d97b7e-8a5f-4953-a1d0-01055d95d0a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0106c562e38f8db2150bf5496d3b1083, https://si.imgix.net/02fff011/uploads/origins/64d97b7e-8a5f-4953-a1d0-01055d95d0a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48c3c0afa93adbc98463f0ccca9d2e59 2x, https://si.imgix.net/02fff011/uploads/origins/64d97b7e-8a5f-4953-a1d0-01055d95d0a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33b19f0810bc97f2c300a6e0e6073181 3x", "genre": "correction", "nsfw": false, "body": "一色ハルキ先生初めまして、先生のイラストの色感がとても好きです！　過去の添削を見ていて、とても分かりやすく、参考になるものばかりでしたので機会があればぜひ私も添削を受けてみたいと思っており、この度依頼をさせて頂きました。\n\nブルーアーカイブというゲームの猫塚ヒビキちゃんのイベント衣装イラストを描いたのですが、最終的にハッキリしない印象になってしまいました。\n\n◆特に気になっている部分\n元々色使いに苦手意識があり、絵を汚くしがちです。\n今回は色選びに加え、影と光のコントラストが弱くぼやっとしてしまいました。空気感を表現したくて奥になっている部分に青系色をスクリーンで載せたのですが、どっちつかずな印象を持たせてしまったのかなと自分なりに反省しています。\nまた、顔が描いているうちに可愛くなくなってしまうので苦手です。。。致命的\n\nグリザイユ→厚塗りで描いているため、情報量を多くしがちで自分でも収拾がつかなくなってしまい、汚い色になってしまったり\n絵の見せたい部分が調整しているうちに目立たなくなってしまうのが悩みです。\n\n色以外にも客観視して気になる点等教えていただけますと幸いです。\n\n以上、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/111621828", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/15", "thumbnail_src": "https://si.imgix.net/80450ae7/uploads/origins/51f053b5-b4e6-4009-b08f-e979fd067d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99d066a0abc68168fd0a822da71066c", "thumbnail_srcset": "https://si.imgix.net/80450ae7/uploads/origins/51f053b5-b4e6-4009-b08f-e979fd067d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99d066a0abc68168fd0a822da71066c, https://si.imgix.net/80450ae7/uploads/origins/51f053b5-b4e6-4009-b08f-e979fd067d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ed47fa0e81f391827e2a7f03092d72f 2x, https://si.imgix.net/80450ae7/uploads/origins/51f053b5-b4e6-4009-b08f-e979fd067d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38f4e778e251f17a8c45a073bb54835e 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。げむすきのぺこちゃんです\nチャイナor通常衣装のペコチャン（アバター）をお願いいたします！（資料はチャイナの方を載せております）\n可能であれば以前描いていただいたテンチャンと同じ画風であると嬉しいです！！\n\nhttps://misskey.gamelore.fun/clips/9htmhlibg3", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/14", "thumbnail_src": "https://si.imgix.net/7a431a0e/uploads/origins/507c1d1d-54a9-4b54-9d29-b0c4a25851d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=724f5d8b6f01611ace69d7e75c553ab9", "thumbnail_srcset": "https://si.imgix.net/7a431a0e/uploads/origins/507c1d1d-54a9-4b54-9d29-b0c4a25851d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=724f5d8b6f01611ace69d7e75c553ab9, https://si.imgix.net/7a431a0e/uploads/origins/507c1d1d-54a9-4b54-9d29-b0c4a25851d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b81f54cf444418202cd2f77eca8d3db 2x, https://si.imgix.net/7a431a0e/uploads/origins/507c1d1d-54a9-4b54-9d29-b0c4a25851d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23fe170bd87b6e7bb99cbac2a1b86f0e 3x", "genre": "art", "nsfw": false, "body": "SNSのアイコンに使用するキャラクターを描いて頂きたいです（バストアップでお願いします）。\n元画像のないキャラとなりますので、イメージの説明が文章のみとなります事をご容赦ください。\n髪型と眼鏡に関してはイメージ資料がございますのでURLを添付いたします。\nご参考になれば幸いです。\nhttps://drive.google.com/drive/folders/1Q5KlP5DpgByDDvihtEQFY_dpOiUVN1x0\n\n性別：男\n年齢：30歳程度\n体型：細身、少し筋肉がついてるくらい\n肌の色：色白寄りの黄色系\n髪型：おでこ出しの後ろで一つ結び（解いた場合ボブ程度の長さ）\n髪色：白寄りの銀髪\n目の形：疲れたくたびれ感のあるたれ目\n瞳の色：赤\n服装：白Tシャツに濃いベージュのカーディガン\n装飾：四角いレンズの黒縁アンダーリム眼鏡\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Q5KlP5DpgByDDvihtEQFY_dpOiUVN1x0", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/13", "thumbnail_src": "https://si.imgix.net/78f78652/uploads/origins/425cbcd7-cdfe-4dfa-8cf8-d90c2c2fd7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa52fd2d7321835a4d0c82f99aa6b7b5", "thumbnail_srcset": "https://si.imgix.net/78f78652/uploads/origins/425cbcd7-cdfe-4dfa-8cf8-d90c2c2fd7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa52fd2d7321835a4d0c82f99aa6b7b5, https://si.imgix.net/78f78652/uploads/origins/425cbcd7-cdfe-4dfa-8cf8-d90c2c2fd7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28071485804d2354b73a1851ca363d0e 2x, https://si.imgix.net/78f78652/uploads/origins/425cbcd7-cdfe-4dfa-8cf8-d90c2c2fd7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a39c315e7849cf9e2a4b537e896f4b43 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/12", "thumbnail_src": "https://si.imgix.net/afb60ba9/uploads/origins/3d736bf7-50da-4b1d-9999-c3073ae6c8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33aa4f7bd9fc207e268f6d7feeaf5dcd", "thumbnail_srcset": "https://si.imgix.net/afb60ba9/uploads/origins/3d736bf7-50da-4b1d-9999-c3073ae6c8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33aa4f7bd9fc207e268f6d7feeaf5dcd, https://si.imgix.net/afb60ba9/uploads/origins/3d736bf7-50da-4b1d-9999-c3073ae6c8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bba6380b061613e88a07c2eb559ddb1 2x, https://si.imgix.net/afb60ba9/uploads/origins/3d736bf7-50da-4b1d-9999-c3073ae6c8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8246d324dbdaa5e3baf6a99942f20692 3x", "genre": "correction", "nsfw": false, "body": "こんにちは、私はこの絵をもう少し自然なポーズで描いてみたいのでアドバイスをお願いします。 いくら絵を変えても不自然な気がして！ 男性と女性にもう少し柔らかく自然なポーズを取らせたいのですが、どうしたらいいでしょうか？ お願いします！\n\nhttps://drive.google.com/file/d/1Qj1pGJAGwgKdOX-ALnyluTp79p55tRyN/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/11", "thumbnail_src": "https://si.imgix.net/c453e76b/uploads/origins/1d1815f4-ee84-44da-9805-05550139b648?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7670dbf25386eba084f045eef07c1e5e", "thumbnail_srcset": "https://si.imgix.net/c453e76b/uploads/origins/1d1815f4-ee84-44da-9805-05550139b648?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7670dbf25386eba084f045eef07c1e5e, https://si.imgix.net/c453e76b/uploads/origins/1d1815f4-ee84-44da-9805-05550139b648?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfc01065824650fff5c164a7d1504001 2x, https://si.imgix.net/c453e76b/uploads/origins/1d1815f4-ee84-44da-9805-05550139b648?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=000a6fc6e62c0dece854fb537dfd8365 3x", "genre": "correction", "nsfw": false, "body": "こんばんは！いつもお世話になっております。\nもし可能であれば、私のイラストの良い点と、より良くするために直せそうな点を教えて頂きたいです。\nイラストは以下になります。\nhttps://necotemari.witchserver.jp/wordpress/wp-content/uploads/2023/07/%E3%82%BB%E3%83%83%E3%81%A1%E3%82%83%E3%82%9321.png\nhttps://necotemari.witchserver.jp/wordpress/wp-content/uploads/2023/07/%E3%82%BB%E3%83%83%E3%81%A1%E3%82%83%E3%82%9318.png\nhttps://necotemari.witchserver.jp/wordpress/wp-content/uploads/2023/07/%E4%B8%BB%E3%82%BB%E3%83%83%E3%81%A1%E3%82%83%E3%82%93.png\n\n参考までに、悩んでいる点としては、\n・頬がぷにっとした絵柄が好きだが、顔のバランスが崩れやすい・顔が大きく見える。\n・鼻の光を描きたいが、鼻の形に沿って描くとなんだか違和感がある。\n・目の形を、１枚目のような上睫毛厚め・円形に近い瞳の形にしたいがバランスが難しい…\nです。上記の点に関しては、アドバイスの際には触れなくても大丈夫です。\n\n何卒ご検討の程宜しくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/10", "thumbnail_src": "https://si.imgix.net/c7c92656/uploads/origins/34aec853-2b5d-4114-ba02-ed373c7dc55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b54171dfc7ec13f21a0f119b24c5381", "thumbnail_srcset": "https://si.imgix.net/c7c92656/uploads/origins/34aec853-2b5d-4114-ba02-ed373c7dc55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b54171dfc7ec13f21a0f119b24c5381, https://si.imgix.net/c7c92656/uploads/origins/34aec853-2b5d-4114-ba02-ed373c7dc55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a481f370ff9f1ac71b6e8361a39eec24 2x, https://si.imgix.net/c7c92656/uploads/origins/34aec853-2b5d-4114-ba02-ed373c7dc55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e68fe49c79cb8d6865eafc2649163dea 3x", "genre": "art", "nsfw": false, "body": "先ほどは資料不足でお手数をお掛けしました。Googleドライブから画像の乗せ方が分からなかった為、Twitterの方に画像を載せましたのでそちらのURLを貼らせて頂きました。\n\nヘッダーかアイコンか悩みましたが、今回はヘッダーをお願いしたいと思います。\nサーモンランが好きなので、背景がアラマキ砦でオオモノシャケが海側に1-2体(タワーか肩パッドか鉄球)、イクラコンテナ付近にイカちゃんを描いて頂けると嬉しいです。イカちゃんの作業着はオレンジでお願いします。シキハルさんの負担になってしまいますが、どうぞよろしくお願いします。\n\n(オオモノシャケ・イカちゃん・アラマキ砦の画像をTwitterのほうに載せさせて頂きました)\n\nhttps://twitter.com/poepoepoe_n/status/1666356354255302656?s=46&t=6lC75MjrXJw3PVXWWeQUXQ", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/9", "thumbnail_src": "https://si.imgix.net/c7ffa1c1/uploads/origins/540b2582-0b08-4d6a-9e9e-d397d396894f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc453133327c337efdb2ee55ce47f453", "thumbnail_srcset": "https://si.imgix.net/c7ffa1c1/uploads/origins/540b2582-0b08-4d6a-9e9e-d397d396894f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc453133327c337efdb2ee55ce47f453, https://si.imgix.net/c7ffa1c1/uploads/origins/540b2582-0b08-4d6a-9e9e-d397d396894f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d3632f8c312767082284b92fed53604 2x, https://si.imgix.net/c7ffa1c1/uploads/origins/540b2582-0b08-4d6a-9e9e-d397d396894f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=636dfc78fc42730752699b0f0bdbda60 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、HalHALです。\nいつも素敵なイラスト拝見させて頂いております。\n\n是非依頼させて頂きたいと思いましたので、\nリクエストの方送信させて頂きます。\n\n【依頼内容】\n私のオリジナルキャラクター「アルト」を描いて頂けないでしょうか。\n\n以下に、資料の方を纏めさせて頂いております。\nhttps://drive.google.com/drive/folders/1ebIr-2GhJwJjJoo3L1_IZgptvt0Nj7xR?usp=sharing\n\n構図等に関しましては、お任せいたします。\n全身が入っていなくとも問題ございません。\n\nまた、拙い資料しか用意できておりませんので、\n描き辛い部分等ありましたら、簡略化やアレンジ等行っていただいて問題ございません。\n\n描いて頂いたイラストに関しましては、\n可能であれば、SNS等で利用させて頂きたいと考えております。\n\nご検討のほど、よろしくお願い致します…！\n\nhttps://drive.google.com/drive/folders/1ebIr-2GhJwJjJoo3L1_IZgptvt0Nj7xR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shikiharu/works/8", "thumbnail_src": "https://si.imgix.net/5589227f/uploads/origins/5f7abadc-af81-42e3-85a3-7ad4d9d783f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1766e4d91fabff02ee2538ab44010ab5", "thumbnail_srcset": "https://si.imgix.net/5589227f/uploads/origins/5f7abadc-af81-42e3-85a3-7ad4d9d783f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1766e4d91fabff02ee2538ab44010ab5, https://si.imgix.net/5589227f/uploads/origins/5f7abadc-af81-42e3-85a3-7ad4d9d783f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03e129bf38be6cc2599e9fb45ae8dd3d 2x, https://si.imgix.net/5589227f/uploads/origins/5f7abadc-af81-42e3-85a3-7ad4d9d783f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=216c892f740eb52f50439f23b4b07d67 3x", "genre": "art", "nsfw": false, "body": "初めまして、よろしければFF14の自機を描いて頂きたいです。\n表情はおっとり系な感じで全体の構図やポーズ等はお任せで宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders