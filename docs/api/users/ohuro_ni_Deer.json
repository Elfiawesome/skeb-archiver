b106-3a7e23c5d56d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0114562a4c39e97201099a4263611ccd", "thumbnail_srcset": "https://si.imgix.net/b548bfff/uploads/origins/c9a8795f-149d-4924-b106-3a7e23c5d56d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0114562a4c39e97201099a4263611ccd, https://si.imgix.net/b548bfff/uploads/origins/c9a8795f-149d-4924-b106-3a7e23c5d56d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=923011b710fdf658b6f1cf5dfc20fdf4 2x, https://si.imgix.net/b548bfff/uploads/origins/c9a8795f-149d-4924-b106-3a7e23c5d56d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4ef1d98d7584e7f24f12d02976c29ae 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nAVパッケージ風イラストがものすごく刺さったので、依頼させてください。\n\nブルアカのマリー（アイドル）をお願いします。\n\nAVの概要：\n清純派アイドルのAVデビュー＋処女喪失をテーマにした内容。\n\n\n【表面】\n背景はラブホテルの一室。\nアイドル衣装のマリーがベッドに腰かけていて、赤面しながら微笑んでいる。\n\n[入れてほしいキャッチフレーズ]\n『あの清純派アイドルがまさかのAVデビューで処女喪失』\nのようなAV概要がわかるものと、トリニティの現役シスターであることがわかるようなワード。\n\n\n【裏面】\n処女喪失で痛がっている、ぎこちない笑顔でフェラ、快楽に負けてすごく気持ちよさそうに喘いでいる、のシーンをお願いします。\n\n[入れてほしいキャッチフレーズ]\n『処女喪失で初アクメ』『清純なあの娘も最後は性欲の虜に』\nといった、上記の流れがわかるようなものや、普段の清楚さから一転して強い性欲を持っていることがわかるようなワード。\n（文字、キャッチフレーズを多めに入れてくれると嬉しいです。）\n\n差分要望（提示金額で可能であれば）\n・表面、マリーがスカートをたくし上げてパンツが見える状態\n・裏面、3シーンの射精差分\n\n\n\n以上になります。\nどうかよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ohuro_ni_Deer/works/46", "thumbnail_src": "https://si.imgix.net/a3fed1f3/uploads/origins/d21d1ce4-ee14-428e-af42-6408ac9aef0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f482ee9dd6502057b31d4f3a6e37dc4", "thumbnail_srcset": "https://si.imgix.net/a3fed1f3/uploads/origins/d21d1ce4-ee14-428e-af42-6408ac9aef0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE