-b2b4-dc93c9f0e869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4863be9148a48436ab100e02a20e3ca9", "thumbnail_srcset": "https://si.imgix.net/d8bb529c/uploads/origins/742484cd-9b0b-47f9-b2b4-dc93c9f0e869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4863be9148a48436ab100e02a20e3ca9, https://si.imgix.net/d8bb529c/uploads/origins/742484cd-9b0b-47f9-b2b4-dc93c9f0e869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=584331bbc1a211f25e750740a69b8efd 2x, https://si.imgix.net/d8bb529c/uploads/origins/742484cd-9b0b-47f9-b2b4-dc93c9f0e869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aab9661a28d20f4bdf6bbfde2990a307 3x", "genre": "art", "nsfw": false, "body": "参考写真のようなポーズ\nキュートでありながら、とても魅惑的なモデルにしたい。\n髪は今のツインテールではなく、ルーズにしてほしい。\n腕と手はもっと細くてもいい。\n背景は私の部屋のステンドグラス。\nモデルへの照明をもう少し暗くして、彼女をもっと目立たせる。\n\nhttps://drive.google.com/drive/folders/15dF32iy9Fw2_jeVujbDOLRqf5xZVKjMq?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@melaton_tw/works/280", "thumbnail_src": "https://si.imgix.net/49eb3e89/uploads/origins/1a9cee6a-62db-4f33-ab56-8a8d55e957ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e8b0e94f086113113657ed01549646b", "thumbnail_srcset": "https://si.imgix.net/49eb3e89/uploads/origins/1a9cee6a-62db-4f33-ab56-8a8d55e957ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e8b0e94f086113113657ed01549646b, https://si.imgix.net/49eb3e89/uploads/origins/1a9cee6a-62db-4f33-ab56-8a8d55e957ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8105b5b69769a70b7a47916073dbc43 2x, https://si.imgix.net/49eb3e89/uploads/origins/1a9cee6a-62db-4f33-ab56-8a8d55e957ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02fd1ddca0ea16da724d24b52e547b22 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@melaton_tw/works/279", "thumbnail_src": "https://si.imgix.net/2fab89c5/uploads/origins/93394541-2902-4c78-8142-56dffff22114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f174534ae871117d4f3d3e1536180ca1", "thumbnail_srcset": "https://si.imgix.net/2fab89c5/uploads/origins/93394541-2902-4c78-8142-56dffff22114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f174534ae871117d4f3d3e1536180ca1, https://si.imgix.net/2fab89c5/uploads/origins/93394541-2902-4c78-8142-56dffff22114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51adf465ec41081d132c52e3a6e86d99 2x, https://si.imgix.net/2fab89c5/uploads/origins/93394541-2902-4c78-8142-56dffff22114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb5d0498e49fefce355600154865f3a0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私の2人のOCをもう一度描いていただけませんか？\nLyviaはDanyalと違う口紅を試している。\nDanyalは彼女の隣にいて、彼女の顔や首には口紅のキス跡がたくさんあり、彼女の頭の周りにはハートがある。\nリヴィアは別の口紅を塗り、跡が残らない口紅を探そうとしている。\n背景や服装は自由です！\n\nhttps://drive.google.com/drive/folders/1a3po-IERk6MuK_XjxrMbswTwXDuPWo8J", "created_at": "", "completed_at": ""}, {"path": "/@melaton_tw/works/278", "thumbnail_src": "https://si.imgix.net/9cd9631d/uploads/origins/9cb9bee0-3de4-471f-a2f4-31f40b75767e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad715236658416cfa028f21425946c0e", "thumbnail_srcset": "https://si.imgix.net/9cd9631d/uploads/origins/9cb9bee0-3de4-471f-a2f4-31f40b75767e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad715236658416cfa028f21425946c0e, https://si.imgix.net/9cd9631d/uploads/origins/9cb9bee0-3de4-471f-a2f4-31f40b75767e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d1a9d69570924f2d213cb5aea475a91 2x, https://si.imgix.net/9cd9631d/uploads/origins/9cb9bee0-3de4-471f-a2f4-31f40b75767e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7958b1ec6a650610ca65366f46d10cf1 3x", "genre": "art", "nsfw": false, "body": "前回の作品、本当にありがとうございました！\n\n今回は『けものフレンズ』のハシビロコウをテーマに、静かなバーで頬杖をつき、横向きでこちらを見る姿をお願いしたいです。\n\n衣装はゲーム内のインドブラックバック★6衣装で、靴は黒か茶に変更し、黒ストッキングを履かせてください。眼鏡やピアスはそのままでも、自由に調整いただいても構いません。\n\n前回のようなダークグレー×紫の落ち着いた配色も希望です。目にはほんのり薄緑を加えていただけると嬉しいです。\n\nその他の構図や背景はお任せします。また、眼鏡あり・なしの2パターンをご用意いただけると大変ありがたいです。\n\nhttps://drive.google.com/drive/folders/1hV7HC9iwpsPc8qSsnHnRSuaZkX05HZVP", "created_at": "", "completed_at": ""}, {"path": "/@melaton_tw/works/277", "thumbnail_src": "https://si.imgix.net/70287924/uploads/origins/562e60bd-f7e3-4acc-9343-0b2f1499944f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0ed6c511fb7e74eadbc93774db519de", "thumbnail_srcset": "https://si.imgix.net/70287924/uploads/origins/562e60bd-f7e3-4acc-9343-0b2f1499944f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0ed6c511fb7e74eadbc93774db519de, https://si.imgix.net/70287924/uploads/origins/562e60bd-f7e3-4acc-9343-0b2f1499944f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=453ba312f121fd7e07afc0c7afba386b 2x, https://si.imgix.net/70287924/uploads/origins/562e60bd-f7e3-4acc-9343-0b2f1499944f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=669733ba91d042e791d8f6e100b6060b 3x", "genre": "art", "nsfw": false, "body": "メラトンさん、こんにちは！もずみちゃんが、日焼けした肌、黒髪、オレンジ色の瞳の新バージョンのモデルを作りました。あなたの熟練したアートスタイルで、クラシックな洞窟の少女／原始の少女のヒョウ柄の上下のバージョンを描いてほしいです！16:9のアスペクトでお願いします。その他の詳細はすべてお任せします！ありがとうございました！\n\nhttps://imgchest.com/p/md7oqkqnd4p", "created_at": "", "completed_at": ""}, {"path": "/@melaton_tw/works/276", "thumbnail_src": "