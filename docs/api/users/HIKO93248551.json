c81/uploads/origins/ff45eb6f-557d-4baa-9750-9be15417cad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89826d96948453d6b154edd6d3f221c6", "thumbnail_srcset": "https://si.imgix.net/881e4c81/uploads/origins/ff45eb6f-557d-4baa-9750-9be15417cad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89826d96948453d6b154edd6d3f221c6, https://si.imgix.net/881e4c81/uploads/origins/ff45eb6f-557d-4baa-9750-9be15417cad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6306a3a3ab2ccf2929e4ef99f6d81378 2x, https://si.imgix.net/881e4c81/uploads/origins/ff45eb6f-557d-4baa-9750-9be15417cad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=017c4c0af7fc877ebc2f50c0dee8d3f2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が大好きです。Vtuberのここねゆりかごさんの絵をお願いしたいです。https://twitter.com/YurikagoKokone\n\nGガンダムのコックピットの中で、Gガンダム風のパイロットスーツを着ている彼女を描いてほしいです。\n\nポーズや服のデザインはお任せします。\n\n衣装とコックピットの参考：https://drive.google.com/drive/folders/1TygisXLCfZ6gdKcW5wwOmNe_HIM7iVKv?usp=sharing\n\nキャラクター：https://drive.google.com/drive/folders/1c9SgIS4X0H_mpYhLSxnkhlWyW7GnUbJY?usp=sharing\n\n髪型はKokone_Swimsuit.jpgの参考画像のようにポニーテールにしてください。\n\n背景を透明にしたバージョンもお願いします。\n\n\n用途YouTubeアカウント/ストリーム、Twitterアカウント、動画に使用できます。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/32", "thumbnail_src": "https://si.imgix.net/3b2b8001/uploads/origins/0cca5ba0-16cc-48b1-b8b9-223e55b6ff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e08353730f61456d170f77581260aada", "thumbnail_srcset": "https://si.imgix.net/3b2b8001/uploads/origins/0cca5ba0-16cc-48b1-b8b9-223e55b6ff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e08353730f61456d170f77581260aada, https://si.imgix.net/3b2b8001/uploads/origins/0cca5ba0-16cc-48b1-b8b9-223e55b6ff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9d6539231a862f848ee273298753aa 2x, https://si.imgix.net/3b2b8001/uploads/origins/0cca5ba0-16cc-48b1-b8b9-223e55b6ff9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05e6ea510065365eeec0ed96465d671e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエスト失礼します。\n\n機動戦士ガンダムSEED DESTINYのルナマリア・ホークを描いていただきたいです。\n\nhttps://www.gundam-seed.net/destiny/character/detail.php?id=3\n\n内容\nパイロットスーツ装備でコックピットにいて、操縦しているシーンを描いてください。\n\nhttp://file5.ebbs.jp/img/14430/40147/4210649/99891429_1653227382_3.jpeg\n\nかっこいいルナマリアを描いていただき、差分でヘルメットあり、なしにしてください。\n\nご検討いただけると幸いです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/31", "thumbnail_src": "https://si.imgix.net/f8fe6889/uploads/origins/fee14c1f-89db-4c82-ac7b-9e5d0bc4e70c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a37e117e13d903623feb49184751e34", "thumbnail_srcset": "https://si.imgix.net/f8fe6889/uploads/origins/fee14c1f-89db-4c82-ac7b-9e5d0bc4e70c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a37e117e13d903623feb49184751e34, https://si.imgix.net/f8fe6889/uploads/origins/fee14c1f-89db-4c82-ac7b-9e5d0bc4e70c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd17bb8638927534db5cc6bf279df93a 2x, https://si.imgix.net/f8fe6889/uploads/origins/fee14c1f-89db-4c82-ac7b-9e5d0bc4e70c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eaea39ae85ac8519d99eb7e7463471a9 3x", "genre": "art", "nsfw": false, "body": "初めましてツインと申します。\n私のVRチャットアバターが搭乗しているの陸戦型ガンダムのコックピットイラストをお願いします。\nhttps://skeb.jp/@HIKO93248551/works/19のようなカットイン風でお願いします。\n出来れば背景別とキャラのみのグリーンバックと差分でヘルメットは無しでお願いします。\nTwichとYouTubeにて使用を検討しております。\nご検討をよろしくお願いします\n\n資料\nhttps://twitter.com/404Twin/status/1652757267429613569?s=20\n\nhttps://twitter.com/Twin404VRC/status/1530476093719068672?s=20&t=2m62CVPXDyMo76u5X7lhUw\n\nhttps://x.com/Twin404VRC/status/1709968226757775813?s=20", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/30", "thumbnail_src": "https://si.imgix.net/304e3168/uploads/origins/f9ac3e67-97a5-476f-acad-3ad223a336b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=155fafcb5c0b277420c607f1d3b42e1e", "thumbnail_srcset": "https://si.imgix.net/304e3168/uploads/origins/f9ac3e67-97a5-476f-acad-3ad223a336b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=155fafcb5c0b277420c607f1d3b42e1e, https://si.imgix.net/304e3168/uploads/origins/f9ac3e67-97a5-476f-acad-3ad223a336b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9ff65af2f6462dfedf2442f686921e0 2x, https://si.imgix.net/304e3168/uploads/origins/f9ac3e67-97a5-476f-acad-3ad223a336b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1075b21d5720a1909ea161d890f355a1 3x", "genre": "art", "nsfw": false, "body": "匿名で失礼します。\nとあるシリーズの五和でガンダムseedのザフト軍一般兵用の緑のパイロットスーツを着せてください。\n状況としてはMSで戦闘中のコックピットでお願いします。コックピットの内装に関しては簡略化してもらって大丈夫です。\n可能であればヘルメット有り無しの差分をお願いします。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/29", "thumbnail_src": "https://si.imgix.net/2e38809b/uploads/origins/a39a177d-895f-45eb-9333-3c2622711d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1884affc3e79a7f5b97ea6e2cd71ed", "thumbnail_srcset": "https://si.imgix.net/2e38809b/uploads/origins/a39a177d-895f-45eb-9333-3c2622711d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1884affc3e79a7f5b97ea6e2cd71ed, https://si.imgix.net/2e38809b/uploads/origins/a39a177d-895f-45eb-9333-3c2622711d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=657e5086d5480a61804829a8f9074da8 2x, https://si.imgix.net/2e38809b/uploads/origins/a39a177d-895f-45eb-9333-3c2622711d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5206c8dbf29fe694cac9dd61c6514cb9 3x", "genre": "art", "nsfw": false, "body": "今日、Skebでシェアしてくれたこのアートワークがとても気に入っている。https://skeb.jp/@HIKO93248551/works/24\n\n私のオリジナルキャラクター「サイモポーリアちゃん」（参考画像：https://rebrand.ly/nep-reference）を描いていただけませんか？胸ぺったんこのオオヤマネコケモノミミの女の子で、オオヤマネコ耳・オオヤマネコ尻尾が特徴で、見た目は若々しいです。\n\nパステルカラーの紫と白を基調に、水中ラバー／メカドラゴン（先ほどのリクエストと同様）かマーメイドの衣装で描いてください。潜水訓練の後、回復し、手を伸ばしてヘルメットのロックを外そうとしているところ。\n\n前回のリクエストと似たようなものをリクエストして申し訳ないのですが、とてもうまくできたので、私のOCで同じようなものを描いてもらえたら光栄です。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/28", "thumbnail_src": "https://si.imgix.net/0003af92/uploads/origins/4e211079-5b7a-4c94-978c-95a35d14e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1436a2049692b880ef0e54e7d7ce4d5e", "thumbnail_srcset": "https://si.imgix.net/0003af92/uploads/origins/4e211079-5b7a-4c94-978c-95a35d14e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1436a2049692b880ef0e54e7d7ce4d5e, https://si.imgix.net/0003af92/uploads/origins/4e211079-5b7a-4c94-978c-95a35d14e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e75e23ebc2f58da2c7770509b450ee6a 2x, https://si.imgix.net/0003af92/uploads/origins/4e211079-5b7a-4c94-978c-95a35d14e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10977ceca3a8ce75a6a2ecb05d623665 3x", "genre": "art", "nsfw": false, "body": "彼女はフロントジッパーのスプリングスーツを着ていて、ダークブラウンのショートヘアに紫の目をしている。\n\n下のリンクにある最初の画像を外見に使い、最初の画像と残りの画像の両方を彼女の装備に使ってください。\nhttps://www.dropbox.com/sh/tpovvkaunoh65q9/AAAKfd0ECKGWKPe7Tss5c4Cka?dl=0\n\nまた、可能であれば、ジッパーを外したバージョンか、フィンとマスクだけのフリーダイビングバージョン、またはその両方が欲しいです。\n\nクールな女の子の表情もつけて、場所は海でもいい。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/27", "thumbnail_src": "https://si.imgix.net/6dd5bfad/uploads/origins/057aac3d-31fb-4493-a623-1e3dab984690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db4bc48af84716b1028a042c03f12019", "thumbnail_srcset": "https://si.imgix.net/6dd5bfad/uploads/origins/057aac3d-31fb-4493-a623-1e3dab984690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db4bc48af84716b1028a042c03f12019, https://si.imgix.net/6dd5bfad/uploads/origins/057aac3d-31fb-4493-a623-1e3dab984690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36f8d221316cd5c41f48c4b613fd686c 2x, https://si.imgix.net/6dd5bfad/uploads/origins/057aac3d-31fb-4493-a623-1e3dab984690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=465e93c47ff395a5efb4b7469ac3eaac 3x", "genre": "art", "nsfw": false, "body": "ぶらっさむです、いつも依頼をお願いしてすみません…… うちの娘と敵対するアンドロイド少女のイラストをお願いいたします。\n\n設定\n世界観…はるか遠い未来\n性別…女性\n年齢…18歳から20歳くらい\n性格…明るいが残虐的\n役割…諜報と戦闘を兼ねたアンドロイド\n眼…黒のカメラレンズ(ただしバイザーで隠れてる)\n眉…黒の細長\n鼻…少しとがり気味\n唇…少し濃い桜色\n髪…肩くらいまでの長さで黒色のツインテール\n耳…インカムで隠れてる、インカムは航時機に接続できる\n肌色…褐色\n身長…160cmくらい\n服装…光沢のある黒色ベースのぴっちりとしたパイロットスーツタイプ、可動部分は灰色ないしメカ機構丸出し\n好き嫌い…戦争を好み、平和を嫌う\n駆動方法…うちの娘と同様、水素エネルギーを充填する\n武器…ビームダガー、両方の太ももの外脇に格納\nイラストの構図として未来の世界を改変するうちの娘を破壊すべく戦闘する様子で、うちの娘のバイザーから見た視点でお願いいたします。\n\n色々とお願いの多いリクエストになりますが、ご検討のほどよろしくお願いいたします……", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/26", "thumbnail_src": "https://si.imgix.net/c62ba887/uploads/origins/1084a883-7875-49c8-9076-f79f102bb43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73e30020789482cd6d40805a62d00f6b", "thumbnail_srcset": "https://si.imgix.net/c62ba887/uploads/origins/1084a883-7875-49c8-9076-f79f102bb43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73e30020789482cd6d40805a62d00f6b, https://si.imgix.net/c62ba887/uploads/origins/1084a883-7875-49c8-9076-f79f102bb43c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd5608b6d46bcc3364b117491a915f92 2x, https://si.imgix.net/c62ba887/uploads/origins/1084a883-7875-49c8-9076-f79f102bb43c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f45ee7753a5e1a1f443296a698af51c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/25", "thumbnail_src": "https://si.imgix.net/dc588fc2/uploads/origins/3e20c271-d6d5-4d58-8e17-51880d4c0f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcbb9a0d043a0083525b714cb83234e", "thumbnail_srcset": "https://si.imgix.net/dc588fc2/uploads/origins/3e20c271-d6d5-4d58-8e17-51880d4c0f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcbb9a0d043a0083525b714cb83234e, https://si.imgix.net/dc588fc2/uploads/origins/3e20c271-d6d5-4d58-8e17-51880d4c0f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83f6755ed9fae2ed5c7c1b3273be3f6a 2x, https://si.imgix.net/dc588fc2/uploads/origins/3e20c271-d6d5-4d58-8e17-51880d4c0f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d36b6176801bd02ae4ce65f23b12aef 3x", "genre": "art", "nsfw": false, "body": "手数料無料中のため、イラストのリクエスト失礼します。\n\n・内容\n「ダーリン・イン・ザ・フランキス」のゼロツーのパラサイトスーツのイラストを描いてください。\n\n・シチュエーション\nこんな感じの通路を歩いている場面にしてください。\n\nhttps://livedoor.blogimg.jp/anico_bin/imgs/c/f/cf2b7052.jpg\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/24", "thumbnail_src": "https://si.imgix.net/ddfd9e27/uploads/origins/1c4e67c9-f8b2-461e-b884-e278756a28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de320de07b3b5120426ec08a7d3010f5", "thumbnail_srcset": "https://si.imgix.net/ddfd9e27/uploads/origins/1c4e67c9-f8b2-461e-b884-e278756a28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de320de07b3b5120426ec08a7d3010f5, https://si.imgix.net/ddfd9e27/uploads/origins/1c4e67c9-f8b2-461e-b884-e278756a28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=218d2f90173a53c1665d1ed84fd7cbbc 2x, https://si.imgix.net/ddfd9e27/uploads/origins/1c4e67c9-f8b2-461e-b884-e278756a28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d3ea6b0d8a8b9344ec8e23cfd6c317d 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\nよければぴっちり海竜スウツを着たうちの子のイラストをお願いします。\n\n\nキャラ：うちの子ですが、下記URLのものよりも幼く、中学１～２年生くらいの年頃にアレンジしたうちの子をお願いします。\nうちの子：https://twitter.com/qualialibrary/status/1335490102768766983?s=20\n\n衣装：下記URLのぴっちり海竜スウツを着せてください。\nマスク部分は、口のところが開きいてそこから顔が覗くといった形でお願いします。イメージとしては下記参考URLのような構造です。\n海竜スーツ：https://imgur.com/a/5Y2vUkZ\n海竜スーツ：https://skeb.jp/@tubasa9940/works/30\nマスク構造参考：https://www.pixiv.net/artworks/104846074\n\nシチュ：特殊任務のための潜水訓練を受けているまだ未熟な頃のうちの子をお願いします。\n訓練施設内の大型プールで、訓練が終わって水中から上半身だけプールサイドに上げて仰向けになって休んでいる体勢でお願いします。\nほとんど初めて着るような慣れない装備と、過酷な訓練でグロッキー状態になっているシーンで、なんとか上半身だけプールサイドに上げてマスクの口を開け、肩で息をしながら泣きながら酸素を貪っているというシチュでお願いします。\n\n\nよければご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/23", "thumbnail_src": "https://si.imgix.net/7622e363/uploads/origins/794bd6f7-3b4f-4e8a-b9bb-f7efcc8ef91f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57286225a8927191c6a06e515712a4a6", "thumbnail_srcset": "https://si.imgix.net/7622e363/uploads/origins/794bd6f7-3b4f-4e8a-b9bb-f7efcc8ef91f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57286225a8927191c6a06e515712a4a6, https://si.imgix.net/7622e363/uploads/origins/794bd6f7-3b4f-4e8a-b9bb-f7efcc8ef91f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=748fcd949cfd4d60bf8d1034b49b2ddc 2x, https://si.imgix.net/7622e363/uploads/origins/794bd6f7-3b4f-4e8a-b9bb-f7efcc8ef91f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9863a1a9ca99ed929f417d38963f920 3x", "genre": "art", "nsfw": false, "body": "リクエストよろしくお願いします。\n\n「マクロスΔ」のミラージュ・ファリーナ・ジーナスのパイロットスーツを描いてください。\nコックピットの中にいて、操縦している場面を描いてください。\n差分でヘルメットある/なしにしてください。\n\nhttp://file9.ebbs.jp/img/14430/40147/14780887/67207022_1460978335_1.jpg", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/22", "thumbnail_src": "https://si.imgix.net/eeb573dd/uploads/origins/1866fd9b-3a62-414d-b018-4902521bce73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=272af9f29061157472cd9739317c55e1", "thumbnail_srcset": "https://si.imgix.net/eeb573dd/uploads/origins/1866fd9b-3a62-414d-b018-4902521bce73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=272af9f29061157472cd9739317c55e1, https://si.imgix.net/eeb573dd/uploads/origins/1866fd9b-3a62-414d-b018-4902521bce73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4f31dd9d80d8c95207ffe18549e82dd 2x, https://si.imgix.net/eeb573dd/uploads/origins/1866fd9b-3a62-414d-b018-4902521bce73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9072d7af7624bd335b705ba23d058696 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵はとてもかわいいです！私のオリジナルキャラクターをリンク先のポーズで描いてもらうことは可能でしょうか？私は私のキャラクターが超バフに見えるようにしたいです(笑)。私のキャラクターがあまりにもバフバフに見えても、それは私が目指しているものなので大丈夫です(笑)。背景のレイアウトはお好みで選んでください。ありがとうございます!!!今日も一日よろしくお願いします!\n\nhttps://imgur.com/a/Rq9ikBq", "created_at": "", "completed_at": ""}, {"path": "/@HIKO93248551/works/21", "thumbnail_src": "https://si.imgix.net/6d85192d/uploads/origins/4bfe2c36-6188-4131-86e8-de3b44748f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af33a07d9785d875a4bb89bcd2ec5a41", "thumbnail_srcset": "https://si.imgix.net/6d85192d/uploads/origins/4bfe2c36-6188-4131-86e8-de3b44748f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af33a07d9785d875a4bb89bcd2ec5a41, https://si.imgix.net/6d85192d/uploads/origins/4bfe2c36-6188-4131-86e8-de3b44748f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bb324c1e27ef8625d4c5e68a12f8ab9 2x, https:/