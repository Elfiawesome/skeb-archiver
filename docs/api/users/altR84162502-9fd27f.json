合全く関係なくても大丈夫ですのでおまかせで自由に描いて頂けるとありがたいです\nもし金額的に大丈夫なら数ページの漫画のような形で描いて頂けないでしょうか", "created_at": "", "completed_at": ""}, {"path": "/@altR84162502/works/7", "thumbnail_src": "https://si.imgix.net/550f8376/uploads/origins/5edd1d06-9755-48af-9c4e-750f88a197b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e6bc91d6429254064d5da68bf112a7f", "thumbnail_srcset": "https://si.imgix.net/550f8376/uploads/origins/5edd1d06-9755-48af-9c4e-750f88a197b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e6bc91d6429254064d5da68bf112a7f, https://si.imgix.net/550f8376/uploads/origins/5edd1d06-9755-48af-9c4e-750f88a197b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc81890ec40ad931209d5bb4de616134 2x, https://si.imgix.net/550f8376/uploads/origins/5edd1d06-9755-48af-9c4e-750f88a197b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f236c308b5ae3b58e0b11584a3532b70 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@altR84162502/works/6", "thumbnail_src": "https://si.imgix.net/309f2584/uploads/origins/5232be91-063a-43cc-99ae-14aa517fd729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31738ad7d453f1cb5e8d55867792dba4", "thumbnail_srcset": "https://si.imgix.net/309f2584/uploads/origins/5232be91-063a-43cc-99ae-14aa517fd729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31738ad7d453f1cb5e8d55867792dba4, https://si.imgix.net/309f2584/uploads/origins/5232be91-063a-43cc-99ae-14aa517fd729?bg=%23fff&auto=format%2Ccompress&fm=