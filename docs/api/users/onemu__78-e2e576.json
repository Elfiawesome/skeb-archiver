8fde-a9b4-4adb-99b0-21f0f9f2f0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6687bd60740210a2f847dab2ab1539c 2x, https://si.imgix.net/63a0fd16/uploads/origins/8d468fde-a9b4-4adb-99b0-21f0f9f2f0af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3610cd57a08c674960ffff12bcf6735 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のOCのイラストを描いていただきたく、リクエストを送らせて頂きました！\n\n2人の女の子の画像のリンクを貼りましたので、ONEMUさんが描きやすい方のイラストを描いてください！\n\nSNSのアイコンに使用させて頂きたいです。\n\n表情や構図はONEMUさんにお任せ致します。\nご検討頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1qFS-58SMyOExjtEcVAEwBh6J4Y07SUjt", "created_at": "", "completed_at": ""}, {"path": "/@onemu__78/works/16", "thumbnail_src": "https://si.imgix.net/1b5b2e68/uploads/origins/4e21a2ed-4819-4b12-a26b-495d089257ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=447e57a8f581f06e7eb2fed107e85681", "thumbnail_srcset": "https://si.imgix.net/1b5b2e68/uploads/origins/4e21a2ed-4819-4b12-a26b-495d089257ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=447e57a8f581f06e7eb2fed107e85681, https://si.imgix.net/1b5b2e68/uploads/origins/4e21a2ed-4819-4b12-a26b-495d089257ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d11466b120ee35da405445ae0de6685a 2x, https://si.imgix.net/1b5b2e68/uploads/origins/4e21a2ed-4819-4b12-a26b-495d089257ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1292cd0d8eff6512a582d7549becad2c 3x", "genre": "art", "nsfw": true, "body": "https://x.com/AAPAYYYY/status/1899314113794511009\nこの子を描いて欲しいですぅ！！！！！！", "created_at": "", "completed_at": ""}, {"path": "/@onemu__78/works/15", "thumbnail_src": "https://si.imgix.net/f051ea0b/uploads/origins/052c69c6-58ee-46dc-915d-5e14821eb7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2193db57e9affaf2212b69e8122d254", "thumbnail_srcset": "https://si.imgix.net/f051ea0b/uploads/origins/052c69c6-58ee-46dc-915d-5e14821eb7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2193db57e9affaf2212b69e8122d254, https://si.imgix.net/f051ea0b/uploads/origins/052c69c6-58ee-46dc-915d-5e14821eb7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53a2c9f5720c78f30d317af9375fc862 2x, https://si.imgix.net/f051ea0b/uploads/origins/052c69c6-58ee-46dc-915d-5e14821eb7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bf209e21d2a044d41a640761a33ba66 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n\nONEMU様の作品の独特な雰囲気とふわふわなタッチがとても素敵で大好きです。\n\nもしよければ、うちのOCのミルを描いていただけないでしょうか？\n\nーーーーーーーーー\n○OCの説明について\n　\n落ち着いた雰囲気で話しかけると優しいけれど、どこか近寄りがたい。\n絶対にミルからは歩み寄ってこないのに、不思議とどんどん彼の魅力に嵌ってしまう危うさがあります！\n\n詳細はドライブの基本情報に書いてあります\n（拝見していただかなくても結構です！）\n\nーーーーーーーーー\n\n○製作していただきたい作品の雰囲気\n\n・薄暗く、ホラーな雰囲気だと嬉しいです！（どんな表現でも大丈夫です◎）\n\n・森の中、動物たちと一緒にこちらを指差していてほしいです！動物と、ミルの冷たい目線が全部こちら側に集まるイメージです！\n\n・ミルの服装、触手や羽等は描きやすいようにアレンジしてください！\n（⚠︎左目、口がないので、描かないでいただけると嬉しいです！）\n\nーーーーーーーーー\n\n○製作していただいた作品の使用目的について\n・個人鑑賞\n・個人で楽しむためのグッズ製作\n・SNSへの投稿（クレジット明記をさせていただきます）\n等を予定しております。\n\nーーーーーーーーー\n資料、金額不足がありましたらお気軽に再送してください。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-1CRrRYpaTV1l7PZ07gUV47OaUi9jBwC", "created_at": "", "completed_at": ""}, {"path": "/@onemu__78/works/14", "thumbnail_src": "https://si.imgix.net/3ce35a4d/uploads/origins/91981cb8-0a9f-4251-82e5-12a10a31009c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc2497e24b0c46707c30fe422498a0af", "thumbnail_srcset": "https://si.imgix.net/3ce35a4d/uploads/origins/91981cb8-0a9f-4251-82e5-12a10a31009c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc2497e24b0c46707c30fe422498a0af, https://si.imgix.net/3ce35a4d/uploads/origins/91981cb8-0a9f-4251-82e5-12a10a31009c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3f090704a7318b3623bd2de7cf86d55 2x, https://si.imgix.net/3ce35a4d/uploads/origins/91981cb8-0a9f-4251-82e5-12a10a31009c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f6d99b5dbfad9bb1f85742d8b2ad6fb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアートスタイルはとても素敵ですね！柔らかくて夢のような感じが大好きです...。もしよければ、私のキャラクターの作品をお願いしたいです！\n名前はペスカド、ペンギンの飼育員です。勤勉でぶっきらぼう、物事を単刀直入に言うことを好むが、本心から言っている。ペンギンはよく彼の後をついて回る。\n構図はお任せします。ご検討、本当にありがとうございました！\n\nhttps://toyhou.se/24535118.pescado/gallery", "created_at": "", "completed_at": ""}, {"path": "/@onemu__78/works/13", "thumbnail_src": "https://si.imgix.net/02813ff4/uploads/origins/0d1fe56e-640e-4f7d-b000-b494e9776956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ee257621d9db931a3292703c3783a27", "thumbnail_srcset": "https://si.imgix.net/02813ff4/uploads/origins/0d1fe56e-640e-4f7d-b000-b494e9776956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ee257621d9db931a3292703c3783a27, https://si.imgix.net/02813ff4/uploads/origins/0d1fe56e-640e-4f7d-b000-b494e9776956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7844d25de158a3b4111bccb5f781eec5 2x, https://si.imgix.net/02813ff4/uploads/origins/0d1fe56e-640e-4f7d-b000-b494e9776956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f460e8d923895ab51cde97f0ed95a0c 3x", "genre": "art", "nsfw": false, "body": "ONEMU様、初めまして、リクエスト失礼いたします。\nONEMU様のイラストがとても好きです。特に絵柄のどろどろの不穏感に惹かれています。\n\nよろしければ、オリキャラのイラストを頼みたいです。\n依頼したいのは紺色だけです。可能であれば、複数のＸの練習絵のような線画のみの落書きを１ページに入れると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1ULhGmdUv0nWLAzr4xGi41Kgq6JTIMwzM?usp=drive_link\n\nキャラの本体は液体の怪物（補充urlの「人外化」参照）なので、自由にどろどろや溶ける状態を捏造してもOKです。\n構図等はお任せ致したいです。何卒ご検討お願いいたします。\n\n補充：https://drive.google.com/drive/folders/1GkPov2pDDHufGXKqBcIqwH1_uhG_eKtA?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@onemu__78/works/12", "thumbnail_src": "https://si.imgix.net/8ae00c2a/uploads/origins/c7f06351-b666-4e6a-b5e4-9fdc6032caeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr