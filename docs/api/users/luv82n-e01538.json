い？格好をしていることが多いのですが、ちゃんとお付き合いするようになってデートに行く「お姉さんぽくも年相応のおしゃれ」な雰囲気の服装をお願いしたいです。\n可愛いより綺麗めかな……と思っていますが、お好きな服を着せていただいて大丈夫です！（はとりさんを全面的に信じてます）\n\n用途は鍵垢内での自慢と個人鑑賞の予定ですが、もしよろしければX本垢のアイコンにもさせてください。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1M0mcLUmUWh2i9UELwXRPiKcUDKzlQI9p/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@luv82n/works/11", "thumbnail_src": "https://si.imgix.net/dd067e10/uploads/origins/fa6c7983-0207-4395-9c55-8fa2ea0d2370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c7c2473492bb77663211f7442a0674f", "thumbnail_srcset": "https://si.imgix.net/dd067e10/uploads/origins/fa6c7983-0207-4395-9c55-8fa2ea0d2370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c7c2473492bb77663211f7442a0674f, https://si.imgix.net/dd067e10/uploads/origins/fa6c7983-0207-4395-9c55-8fa2ea0d2370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6cc1f3405146e650b388e1490fb2bedc 2x, https://si.imgix.net/dd067e10/uploads/origins/fa6c7983-0207-4395-9c55-8fa2ea0d2370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92f56ec00d5fea29cc02a70297c0aef2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@luv82n/works/10", "thumbnail_src": "https://si.imgix.net/830cd66d/uploads/origins/df63f51d-b991-4390-ae92-5375aa56cbc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50da09e98877f21411cf7ea226fd177a", "thumbnail_srcset": "https://s