e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21a339204ef9ef2a82081934f369fc69", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/105", "thumbnail_src": "https://si.imgix.net/06294cf0/uploads/origins/5cf0b09d-82e0-4954-844f-76f612263fdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d522b36ddfe0ec2b049a601e792fb05e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/104", "thumbnail_src": "https://si.imgix.net/cb9ff119/uploads/origins/721a5b25-1485-44cf-8078-242b03d1602a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6256298054d3f2d9bed2593b44c4dfb1", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのウマ娘の仕事が好きです。\n\n琵琶はやひでと成田ブライアンの姉妹がお互いのレーシング服を着ているイラストをお願いします。\n\nお引き受けいただけるようでしたら、よろしくお願いします。\n\nhttps://imgur.com/a/iYAZrNK", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/103", "thumbnail_src": "https://si.imgix.net/7421cb89/uploads/origins/271e79d9-221d-4549-82b2-d692c4117eff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae2b521174b3ea09b62138eeecccebb5", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/102", "thumbnail_src": "https://si.imgix.net/b8707f9d/uploads/origins/476012df-c1dc-4dbf-86d8-135f3cfc1f02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1394ed4cfb6de1faca13f4a3afac7bc8", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "よろしくお願いします。 この度は以下の内容でリクエストさせて頂きます。\nオリジナルウマ娘のセシリアレイニーデをお願いしたいのですが、ご検討いただけますでしょうか。\n\n↓で描かれていたキョンシーダイワスカーレットが大変素晴らしかったので、こちらようなキョンシーコスを着せてください。\nhttps://skeb.jp/@smoke_klll/works/93\n髪型や服の色は自由にしていただいて構いません。\n表情やポーズはご自由に描いていただきたく思います。\n胸のサイズは性癖に任せします。\n\nhttps://i.imgur.com/JC5gSBw.jpg", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/101", "thumbnail_src": "https://si.imgix.net/0a124d76/uploads/origins/4777078b-c0ae-4c08-bbea-22b7002322fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=600c6e57ae4d3166c569dbb4e4fdef96", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、先生。私は、ジョッキーメイデンのダイヤモンドアマゾンの魔法少女の服https://drive.google.com/file/d/1-5IrDN3fb8icusBuyqyYfg3KAhUmxHTG/view?usp=drivesdk。\nアバターのユキヒョウ\nhttps://drive.google.com/file/d/1-9_gO030hHR7H1DcLpIB_k8aI2HD2Fye/view?usp=drivesdk\nポーズはこちらを参考にしてください。\nhttps://drive.google.com/file/d/1-9EHd27f2LLjVUoFAKJEuAZiw8VULsLt/view?usp=drivesdk\nどちらも魔法少女の服を着ています先生よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/100", "thumbnail_src": "https://si.imgix.net/cd93f776/uploads/origins/3ce713fc-4636-4272-a602-d89168a01d69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=375a2db2d9cedbd7bc3ead32d4bce504", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "前回はありがとうございました。\n今回も「宿儺サンデー」を描いていただけたらと思います。\n前は腕だったので、今回は目をフィーチャーしてほしいです。\n\nロッカー等に隠れているところを見つかって、4つ目を見開いて覗き込んでくる、というシチュエーションです。(青鬼でタンスに隠れているのを見つかって開けられるシーンが一番近いかと。)\n構造は顔をアップで、セリフは「みーつけた」「それで隠れたつもり？」など何でも構いません。また、差分が大丈夫でしたら、「どーよ？ホラゲーっぽいだろ？」とからかう感じもお願いします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/99", "thumbnail_src": "https://si.imgix.net/ce94620a/uploads/origins/4efd6564-0575-4f09-bdb1-f41e02d93fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7d3a6b160804c82392d5f7a54b78b2", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "煙管様へ。\nキョンシーダスカを依頼した者です。\n素晴らしい作品大変ありがとうございました！\nセクシーかつ可愛らしく、勝気な笑顔がダスカらしい可愛さで大変よかったです。\nキョンシー衣装もちょっと背伸びしつつ似合うのを選んだ感じがとてもよかったです。\n\n早速の追加依頼、不躾で申し訳ないのですが煙管様のキョンシー衣装の描き方が大変刺さったのでお願いしたく再度リクエスト送らせて頂きました。\n先のダスカにアグネスデジタルの勝負服「愛麗♡キョンシー」をダスカ風にしたものバージョンもお願い出来ますでしょうか。\n具体的な変更点としてはカラーをダスカカラーに、「推」の文字を「先」に変更して、先のキョンシー衣装くらいにスカート前後の布を伸ばしてください。\n\n何度も依頼して申し訳ないのですが御検討頂けますと幸いです。\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/98", "thumbnail_src": "https://si.imgix.net/dc8c0aa3/uploads/origins/58ecc1fd-de65-472a-bdc7-c94e128912cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=663123b883724651896f196bdad55910", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/97", "thumbnail_src": "https://si.imgix.net/8033896c/uploads/origins/db98c75c-20ea-4a84-86c0-1e2bdb31873d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=051b4908acc2868ac1f3fe3a48bfd25b", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/96", "thumbnail_src": "https://si.imgix.net/a3d629a2/uploads/origins/6acdde65-9512-42a4-b430-04ba8427dd57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=250607d64cdf0c0687b2d05429f97517", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@smoke_klll/works/95", "thumbnail_src": "https://si.imgix.net/a154cf59/uploads/origins/15859d68-25db-4926-842c-b277aec15280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a4