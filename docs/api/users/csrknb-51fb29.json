c537e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68da00ba77ace26374bce7ec50abd0f7, https://si.imgix.net/658d9a54/uploads/origins/7185b1b6-e0b7-43f2-8d8c-096e31fc537e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=033d4653bba7e9d62719df78bdff3bb0 2x, https://si.imgix.net/658d9a54/uploads/origins/7185b1b6-e0b7-43f2-8d8c-096e31fc537e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b41913ab2088fbecaf2fb2e1ea3b3198 3x", "genre": "art", "nsfw": false, "body": "Chisaraさん、こんにちは！\nメッセージ失礼いたしますね！\n\nヨナキイヌくんのイラストを見て一目惚れしちゃいました…！ということで…\n私が色改変したヨナキイヌくんを描いていただけないでしょうか？\n\n最低限の守ってもらいたいポイントとしましては…\n■目がオッドアイであるため、ウインクや笑顔などの目を閉じる表情でないこと\n■また左右の目の色を間違えないようにしていただきたいこと\n以上です。\n後は全てお任せいたします！\nポーズなども特に要望ありません！\n\n願いとしましては、とびっきりかわいらしくデザインいただけたらな…と思います。\n強制ではないので、難しそうであれば大丈夫ですので……！\n\n全然ゆっくりで構いません！\n気長にお待ちしております🐾✨\n\nhttps://x.com/3cIa0r_maca1on5/status/1892787128020717705?t=xiIsHi4svqUvbvzNkwgq2g&s=19", "created_at": "", "completed_at": ""}, {"path": "/@csrknb/works/16", "thumbnail_src": "https://si.imgix.net/f5e037b8/uploads/origins/33f0f08d-f348-4ace-ae90-fa5ea172c90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca662fa2b3ea2d3c642e3b5460223360", "thumbnail_srcset": "https://si.imgix.net/f5e037b8/uploads/origins/33f0f08d-f348-4ace-ae90-fa5ea172c90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca662fa2b3ea2d3c642e3b5460223360, https://si.imgix.net/f5e037b8/uploads/origins/33f0f08d-f348-4ace-ae90-fa5ea172c90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14f401aef3cb4bfa8b4b3aca6438909b 2x, https://si.imgix.net/f5e037b8/uploads/origins/33f0f08d-f348-4ace-ae90-fa5ea172c90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c42d4084aa9f19e4038535d2b893060e 3x", "genre": "art", "nsfw": true, "body": "Chisara様\nお疲れ様です！星ブドウです！\nうちのこのドルにぇちゃんが、ヤブ医者のベルにぇちゃんにギザ歯を悲惨なくらいボロボロにされちゃうイラストが見たいです。💚💙🦷\nhttps://x.com/grapebudou/status/1586734705298182144?s=19\nドルにぇのキャラシになります。性格はとにかく食いしん坊で単純な女の子です。かわいい吸血鬼です🍇\nhttps://x.com/grapebudou/status/1767761084491186193?s=19\n歯の資料になります。前歯から大臼歯まで生え揃っていて、ニンゲンの歯に似ています🦷\nドルにぇの自慢のギザ歯を、悪魔の槍で傷つけてムシ歯にしたり、抜歯したり、銀歯で適当に詰め物したりして、\nムシ歯抜歯痕銀歯まみれの悲惨なお口にして欲しいです。\n限界依頼ですが、もし良ければお願いします🍇", "created_at": "", "completed_at": ""}, {"path": "/@csrknb/works/15", "thumbnail_src": "https://si.imgix.net/bbcdf3f9/uploads/origins/a4a6ae3b-d9ba-4c89-86ad-8fb332a97989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0841a994eb02a7851bed1688a9de1bea", "thumbnail_srcset": "https://si.imgix.net/bbcdf3f9/uploads/origins/a4a6ae3b-d9ba-4c89-86ad-8fb332a97989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0841a994eb02a7851bed1688a9de1bea, https://si.imgix.net/bbcdf3f9/uploads/origins/a4a6ae3b-d9ba-4c89-86ad-8fb332a97989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2340b6ffa8714c48dbf23d02c5e4f1b3 2x, https://si.imgix.net/bbcdf3f9/uploads/origins/a4a6ae3b-d9ba-4c89-86ad-8fb332a97989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e39f287b7efb9156fab4aab5a83e567 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のソナをあなたのスタイルで描いてほしいです！髪型だけはちゃんと描いてください！かわいくしてください <3\n\nhttps://drive.google.com/drive/folders/18eI6gm-ubMhteEtrMa_zJAHWnKDGLTv8?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@csrknb/works/14", "thumbnail_src": "https://si.imgix.net/02f7db23/uploads/origins/ecfacdd0-1cff-4bfa-b2b8-71d7e4677f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753f5d56b583faefeb9b4d3e5d1005bc", "thumbnail_srcset": "https://si.imgix.net/02f7db23/uploads/origins/ecfacdd0-1cff-4bfa-b2b8-71d7e4677f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753f5d56b583faefeb9b4d3e5d1005bc, https://si.imgix.net/02f7db23/uploads/origins/ecfacdd0-1cff-4bfa-b2b8-71d7e4677f86?bg=%23fff&auto=format%2Ccompress&fm