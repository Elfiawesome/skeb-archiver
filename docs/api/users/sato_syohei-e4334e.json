yohei.bsky.social"}, {"label": "Website", "url": "http://marshmallow-qa.com/sato_syohei", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/1385529", "name": "1385529"}, {"label": "BOOTH", "url": "https://sato-syohei.booth.pm", "name": "sato-syohei"}, {"label": "Fanbox", "url": "https://sato-syohei.fanbox.cc", "name": "sato-syohei"}], "flags": {}, "acceptable": true, "works": [{"path": "/@sato_syohei/works/106", "thumbnail_src": "https://si.imgix.net/947ce610/uploads/origins/175efe6c-fdb7-467b-b0cb-74cacd46c681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8430cdcbd8d0ef732117305134640c64", "thumbnail_srcset": "https://si.imgix.net/947ce610/uploads/origins/175efe6c-fdb7-467b-b0cb-74cacd46c681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8430cdcbd8d0ef732117305134640c64, https://si.imgix.net/947ce610/uploads/origins/175efe6c-fdb7-467b-b0cb-74cacd46c681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab058a5cbf0cfd204484cacfb7ea968e 2x, https://si.imgix.net/947ce610/uploads/origins/175efe6c-fdb7-467b-b0cb-74cacd46c681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=338bb8ee30497ea70a41c8765f5214d9 3x", "genre": "art", "nsfw": true, "body": "ラブヒロのキョウイチのヒーローやられをリクエストさせたいただきます！\nヒーロースーツは通常ver.の緑のやつで、敵のアジトで機械に拘束されて、性感帯を分析実験されているようなイメージでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/105", "thumbnail_src": "https://si.imgix.net/2c1c8b36/uploads/origins/350f6c59-909c-4823-9a5b-0dfced503d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59e6c7838ab01c86e5baa40048a6e325", "thumbnail_srcset": "https://si.imgix.net/2c1c8b36/uploads/origins/350f6c59-909c-4823-9a5b-0dfced503d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59e6c7838ab01c86e5baa40048a6e325, https://si.imgix.net/2c1c8b36/uploads/origins/350f6c59-909c-4823-9a5b-0dfced503d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ad598da1d837c3ef50ddba60b1331cb 2x, https://si.imgix.net/2c1c8b36/uploads/origins/350f6c59-909c-4823-9a5b-0dfced503d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cdda99a6fd5836b656f10ecb9539a0c 3x", "genre": "comic", "nsfw": true, "body": "再送となります！\nザハルとの戦闘をするレッド。戦闘前に実は幻覚を見せる香を嗅いでおり、周りには市民がいると錯覚してしまう。\nザハルの鎖の鞭による攻撃を避けると市民に当たるため、市民を守るためには攻撃を受けるしかなく、また明らかに市民に向けた攻撃もあり、身をていして庇うことしかできない。\n体力を削られ動けなくなったレッドは鎖によって後ろ手に縛られ、鍛え上げた胸筋や乳首、股間が目立つ格好となり、市民はそれを揶揄する。(そんな市民に対してもレッドはヒーローらしく振る舞い、敵であるザハルを睨み付ける)\n\nザハルはそのまま屈辱の敗北を味わわせるため、後ろからレッドの耳元でレッドのふがいなさを囁きながら乳首責めを行い、そのまま射精敗北させる。\nレッドは快楽に顔を歪めながら耐えようとするも「すまねぇ…！」「くそっ…いっちまう！」など台詞をいいながら、幻影の市民に自身のエネルギーをぶっかけてしまう。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/104", "thumbnail_src": "https://si.imgix.net/8c96bae3/uploads/origins/d906f303-0b38-4b5d-99bb-0d39a509f13a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=784858552adee6be0208c5408a336ddd", "thumbnail_srcset": "https://si.imgix.net/8c96bae3/uploads/origins/d906f303-0b38-4b5d-99bb-0d39a509f13a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=784858552adee6be0208c5408a336ddd, https://si.imgix.net/8c96bae3/uploads/origins/d906f303-0b38-4b5d-99bb-0d39a509f13a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3a1a9fe1f338cbf820205994efa0f2f 2x, https://si.imgix.net/8c96bae3/uploads/origins/d906f303-0b38-4b5d-99bb-0d39a509f13a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fd1c1fccc07a39e9c32aaf045796898 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの過去の作品を見てお願いしたいと思います。\n\nもしよければ、私の友人のOCを描いてほしいです。\n友人の許可は得ているので、出来上がったら友人と共有したいです。\nで、出来上がったら、個人的な鑑賞用に彼と共有したいです。\n\n友達のOC、アンソニー\nhttps://x.com/Super_Nicho/status/1057566919643955200?t=lbgLpB9IMjmSYJx_grynSQ&s=19\n\nあなたのスタイルでアンソニーを見てみたい。\nポーズも表情も完全にあなたのものです。\nプロフィールに書いてあるように、彼はちゃんと脂肪があって強いんだ。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/103", "thumbnail_src": "https://si.imgix.net/d0832c90/uploads/origins/8e912953-8790-4150-97c0-1f59d20edc95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ead4c1fe4770213c8f076004973a3e0", "thumbnail_srcset": "https://si.imgix.net/d0832c90/uploads/origins/8e912953-8790-4150-97c0-1f59d20edc95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ead4c1fe4770213c8f076004973a3e0, https://si.imgix.net/d0832c90/uploads/origins/8e912953-8790-4150-97c0-1f59d20edc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e23e3636cd72a5ede32d634c5fa9f37a 2x, https://si.imgix.net/d0832c90/uploads/origins/8e912953-8790-4150-97c0-1f59d20edc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bf27a447f1edd62885f6fff3f50759b 3x", "genre": "comic", "nsfw": true, "body": "市民のリビドスを搾取している工場に単身乗り込んだレッドは自身が身代わりになることを申し出る。\nレッドはまずはじめに、精力をあげるビームを全身に浴びせられると、過去の敗北した際の記憶もちらつき、ぎんぎんになってしまう。\nそんなレッドに巨大オナホ型拘束器に入れと敵は要求し、レッドは市民のためならとその中に入り、気を付けの姿勢で首より下を巨大オナホに拘束されてしまう。\nスイッチが押されるとオナホは振動とぜん動運動を始め、レッドはイってしまうが、オナホの動きは止まらない。自身のリビドスがローションのようになり、ヒーロースーツが濡れて筋肉に張り付くことでさらに気持ちよくなってしまい、何度もいかされてしまう。\n数分後、オナホのスイッチを止めオナホを開くと、ヒーロースーツが吸いきれなかったリビドスがオナホからドロドロと流れ落ちる。拘束から解放されたレッドは崩れ落ちるように立て膝の体勢になる。自身のリビドスでヒーロースーツ全体を汚している屈辱に、拳を握りながら耐えることしかできない。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/102", "thumbnail_src": "https://si.imgix.net/b2b325de/uploads/origins/28b4cd24-66f5-46b2-85c9-b086b6bf51df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9799339759bac12df44164b2ba8198c3", "thumbnail_srcset": "https://si.imgix.net/b2b325de/uploads/origins/28b4cd24-66f5-46b2-85c9-b086b6bf51df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9799339759bac12df44164b2ba8198c3, https://si.imgix.net/b2b325de/uploads/origins/28b4cd24-66f5-46b2-85c9-b086b6bf51df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e26c7552a9497e8a51192ef8e26d4e6 2x, https://si.imgix.net/b2b325de/uploads/origins/28b4cd24-66f5-46b2-85c9-b086b6bf51df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc9c479bd551a49405acb3c587d42851 3x", "genre": "art", "nsfw": false, "body": "リギル・ケンタウルスという狼獣人を描いてください。\nカフェのマスターをやっている、旅行が好き、などの細かい設定は資料URLに記載があります。\n構図やポーズ、シチュエーションなどはお任せします！\nイラストからアイディアをもらって歌を作るかもしれないので、お色気要素は少なめでお願いします。\n\nhttps://www.nicovideo.jp/watch/sm43669373", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/101", "thumbnail_src": "https://si.imgix.net/77f46173/uploads/origins/15ffaff1-b842-46e1-b3b0-33be1aaf4252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab9a0f19819eb942defbfd8638ea363", "thumbnail_srcset": "https://si.imgix.net/77f46173/uploads/origins/15ffaff1-b842-46e1-b3b0-33be1aaf4252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab9a0f19819eb942defbfd8638ea363, https://si.imgix.net/77f46173/uploads/origins/15ffaff1-b842-46e1-b3b0-33be1aaf4252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46e4ffbbc1678944f39c868aebd012ed 2x, https://si.imgix.net/77f46173/uploads/origins/15ffaff1-b842-46e1-b3b0-33be1aaf4252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c880eeca4657b81a68dd650b1a1360a 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nいつも先生の作品を拝見しております。\n\nもしよろしければクレサガというゲームのクトネシリカを描いてもらえませんでしょうか。\n\n元気でいたずらっ子な感じだと嬉しいです。\n\n何卒ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/100", "thumbnail_src": "https://si.imgix.net/fb8e923a/uploads/origins/cdc77942-1fe0-4bf2-8121-9499a50aadc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1593d477dd5833123c6af3e2f20ac1", "thumbnail_srcset": "https://si.imgix.net/fb8e923a/uploads/origins/cdc77942-1fe0-4bf2-8121-9499a50aadc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1593d477dd5833123c6af3e2f20ac1, https://si.imgix.net/fb8e923a/uploads/origins/cdc77942-1fe0-4bf2-8121-9499a50aadc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b556531ef84027a934b09b7156c88da 2x, https://si.imgix.net/fb8e923a/uploads/origins/cdc77942-1fe0-4bf2-8121-9499a50aadc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69d9a48b7368c57956f977443380ce58 3x", "genre": "art", "nsfw": false, "body": "将兵さんこんばんはです。\n早速リクエストなのですが、うちの代理君である狼獣人がビルの屋上で上着をはためかせながら腕組み&ウインクをしているイラストをお願いしたいです！\n(代理君の姿はこちら→https://x.com/fograin22521/status/1898329060985720907?t=RP9EwgnOHO5Mu5tYZX6uBw&s=19)", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/99", "thumbnail_src": "https://si.imgix.net/1d136d4b/uploads/origins/f5d4885d-ffee-458d-99c4-6eb9271f50d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13d560bdb7a6e0b6d6d946b8be0de971", "thumbnail_srcset": "https://si.imgix.net/1d136d4b/uploads/origins/f5d4885d-ffee-458d-99c4-6eb9271f50d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13d560bdb7a6e0b6d6d946b8be0de971, https://si.imgix.net/1d136d4b/uploads/origins/f5d4885d-ffee-458d-99c4-6eb9271f50d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb6be97f3d9f9fad8c24ef6bfdb94d51 2x, https://si.imgix.net/1d136d4b/uploads/origins/f5d4885d-ffee-458d-99c4-6eb9271f50d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8512cc335c8926bd3f842761204e0531 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n私はレッドと申します。\n\n今回のリクエストでは、\n- うちの子 狼獣人Vesper、\nをあなたの戦隊の一員として描いていただきたいです。\n戦隊の制服を着せてください。色やコードネームなどはおまかせします。\n彼は肉体派のアサシンタイプという設定です。\n\n- できれば、体格は筋肉質で、胸筋がはっきりしている感じでお願いします。\n\n- そして\n彼が戦いに敗れて、敵の策略によって洗腦する、\n自身が「自分は下級戦闘員だ」と思い込まされて他のヒーローを襲う\nような展開を描いていただけると嬉しいです。\n\n- 内容と構図や背景など全部おまかせですが、「格好よくにすればうれしいです。」と言われました。 \n\n- 宛名とサインがあれば、別レイヤでお願いしたいです。  \nどうぞよろしくお願いいたします。  \nありがとうございました\n\nhttps://www.dropbox.com/scl/fo/1fk0kh3dst2pzvln6wkfk/AAtLyDT8ai3GMvrK3myFOG8?rlkey=9yxk71vlugujxn4b4lhntjz06&st=t69atpht&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/98", "thumbnail_src": "https://si.imgix.net/018bdb98/uploads/origins/484687e8-e28b-4dd0-816d-c309ee847a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ead9b1a1180c232dac3209164909845", "thumbnail_srcset": "https://si.imgix.net/018bdb98/uploads/origins/484687e8-e28b-4dd0-816d-c309ee847a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ead9b1a1180c232dac3209164909845, https://si.imgix.net/018bdb98/uploads/origins/484687e8-e28b-4dd0-816d-c309ee847a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c271614a3273d5d58a376fcf69bf1d57 2x, https://si.imgix.net/018bdb98/uploads/origins/484687e8-e28b-4dd0-816d-c309ee847a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf114317cfbb8f93b38c73b2e524141a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/97", "thumbnail_src": "https://si.imgix.net/826666ef/uploads/origins/79057ee0-d6cf-4fc1-8f56-6430a52c8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=836d70f3c34a430691db715c27b8231d", "thumbnail_srcset": "https://si.imgix.net/826666ef/uploads/origins/79057ee0-d6cf-4fc1-8f56-6430a52c8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=836d70f3c34a430691db715c27b8231d, https://si.imgix.net/826666ef/uploads/origins/79057ee0-d6cf-4fc1-8f56-6430a52c8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7839d1681064d82c8851b31632ad1802 2x, https://si.imgix.net/826666ef/uploads/origins/79057ee0-d6cf-4fc1-8f56-6430a52c8b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c70c98dfc62d16b4f8e0dce0d1c1a6e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/96", "thumbnail_src": "https://si.imgix.net/e7bc60f8/uploads/origins/2463bd06-d0f3-4765-a206-ceff53ef3a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b32ccf1f46996d205313fb53cb130b44", "thumbnail_srcset": "https://si.imgix.net/e7bc60f8/uploads/origins/2463bd06-d0f3-4765-a206-ceff53ef3a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b32ccf1f46996d205313fb53cb130b44, https://si.imgix.net/e7bc60f8/uploads/origins/2463bd06-d0f3-4765-a206-ceff53ef3a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02189cd082b810b27e3befd7cc5dbe81 2x, https://si.imgix.net/e7bc60f8/uploads/origins/2463bd06-d0f3-4765-a206-ceff53ef3a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43a8ef83c03a0e918d0664ce24aa5d24 3x", "genre": "art", "nsfw": false, "body": "初めて依頼させていただきますが４コマ漫画みたいなのでも大丈夫ですかな。東京放課後サモナーズにて\n１コマ目でダイコクが\n「子どもを誘拐して怖がらせるのが得意だなんて教職員としてあるまじき行為だねぇ」\n２コマ目でブギーマンが\n「反社会的勢力なんて子どもたちへの悪影響ですので近付かないでいただけます？」\n３コマ目でシームルグが\n「警察署長が闇マーケットに携わってるとは世も末だなぁ！」\nと、三人とも笑顔だが吹き出し台詞がおどろおどろしくなっていて、４コマ目で一同がテーブルを挟んで椅子に座っていて和やかに見せかけ背景に雷火花が走っていて、その間にサモナー（主１）とその膝に座ったシュクユウ（大人たちの腹黒罵り合いがよく分かってないので「？」としている）くんが黙々とお茶とお菓子を食べているというのをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/95", "thumbnail_src": "https://si.imgix.net/f104efca/uploads/origins/ff5de947-8492-47d2-9795-db78b45580f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5edeef77549ad4e4693088a14afdf5f7", "thumbnail_srcset": "https://si.imgix.net/f104efca/uploads/origins/ff5de947-8492-47d2-9795-db78b45580f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5edeef77549ad4e4693088a14afdf5f7, https://si.imgix.net/f104efca/uploads/origins/ff5de947-8492-47d2-9795-db78b45580f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91f29a76cf3a59974015408cf193c783 2x, https://si.imgix.net/f104efca/uploads/origins/ff5de947-8492-47d2-9795-db78b45580f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7311dc759549ea0b03aa0b9d44c3c657 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\n私のオリジナルキャラクターを描いていただけたら嬉しいです。(https://cdn.imgchest.com/files/7lxcpjql897.png) キャラクターは鬼虎です。\n\nキャラクターの情報\n\n- 年齢：50~60歳\n- 筋肉質で幅のある体 (https://cdn.imgchest.com/files/y2pck3glv27.png)\n- 計算された礼儀正しい態度だが、不吉な意図を持っている。\n- 光沢のある黒い毛皮を持ち、服装は完璧に保たれている。\n\nできればラテックスのバイクスーツを描いてほしい。\n\n他の衣装のような追加バージョンはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@sato_syohei/works/94", "thumbnail_src": "https://si.imgix.net/97aa9a8c/uploads/origins/2c35cfee-0bcd-4bb5-a04a-2a7a5861d92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfda81c5e3edb29aee15cb2b10e9702c", "thumbnail_srcset": "https://si.imgix.net/97aa9a8c/uploads/origins/2c35cfee-0bcd-4bb5-a04a-2a7a5861d92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfda81c5e3edb29aee15cb2b10e9702c, https://si.imgix.net/97aa9a8c/uploads/origins/2c35cfee-0bcd-4bb5-a04a-2a7a5861d92f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7dc144eddd1af39f4ff330c38b13ab6 2x, https://si.imgix.net/97aa9a8c/up