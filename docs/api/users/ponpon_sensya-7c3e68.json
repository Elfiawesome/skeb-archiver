めてのセックスで情けなく腰をヘコヘコ振っている。周りには挿入に至るまで手間取り、装着に失敗したコンドーム。うちの子はセックスすることになるとは思っていなかったため、下着は普段使いの安っぽいもの。腋毛やアンダーヘアも未処理。\n\nそれではご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1AnUDlxbmtGQHS43VPrjG9z7yX_Qcb8gx?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ponpon_sensya/works/26", "thumbnail_src": "https://si.imgix.net/4daeec95/uploads/origins/ea30d2c3-7013-4849-bcb1-7ccf2c7a5e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45a127573344954baf6624eba630df4c", "thumbnail_srcset": "https://si.imgix.net/4daeec95/uploads/origins/ea30d2c3-7013-4849-bcb1-7ccf2c7a5e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45a127573344954baf6624eba630df4c, https://si.imgix.net/4daeec95/uploads/origins/ea30d2c3-7013-4849-bcb1-7ccf2c7a5e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d71a995dfd039961832a7eb87792501 2x, https://si.imgix.net/4daeec95/uploads/origins/ea30d2c3-7013-4849-bcb1-7ccf2c7a5e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18f20a19e97c7b3468a2bc749361691e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ponpon_sensya/works/25", "thumbnail_src": "https://si.imgix.net/afc181a3/uploads/origins/5e8e78aa-c871-4966-9c7b-a48fd92520aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e92531771c03fce8e8b25187ef4d530e", "thumbnail_srcset": "https://si.imgix.net/afc181a3/uploads/origins/5e8e78aa-c871-4966-9c7b-a48fd92520aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e