2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=329035791f94de0a2871355484153724 2x, https://si.imgix.net/48f1ef7e/uploads/origins/19c38df7-dc4a-448c-85a4-392638c8b1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db0c64aa76b0c661d41c717d870ca313 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n私のオリキャラのイラストをお願いしたいです。\nhttps://imgur.com/a/42d4SoV\n\n彼女は自分を \"冒険者F \"と名乗り、遠い王国からやってきて極東っぽい国を冒険している。過去を語らないが貴族育ちだったようである。正義感が強い（まるでヒーローのよう）で戦闘力が高いが、よくトラブルに巻き込まれる。\nRPGで言えば、クラスはファイター/ローグ（忍者とスワッシュバックラーを混ぜたイメージ）。戦い方は真・三國無双7の徐庶に似ているが、左利きので武器を逆の手に持っている。\n\n構図や表情についてはお任せします。髪型や服装についても好きにアレンジしていただいて構いません。\nご検討よろしくお願いします。\n\nhttps://twitter.com/Velahka/status/1799792166916837768", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/11", "thumbnail_src": "https://si.imgix.net/40f736f0/uploads/origins/64e98780-111b-4be0-a4ef-1e22439fb570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=852cd9980495892dd02c772466e11ae8", "thumbnail_srcset": "https://si.imgix.net/40f736f0/uploads/origins/64e98780-111b-4be0-a4ef-1e22439fb570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=852cd9980495892dd02c772466e11ae8, https://si.imgix.net/40f736f0/uploads/origins/64e98780-111b-4be0-a4ef-1e22439fb570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e981c885080b5181f8a2f0ae9a2df9b9 2x, https://si.imgix.net/40f736f0/uploads/origins/64e98780-111b-4be0-a4ef-1e22439fb570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db7ba15a7dfc4f3c6c135338cbfd6e9f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が大好きなので、レフシートを作っていただけないでしょうか。女性のキャラクターが欲しいです。彼女たちは背景キャラクターか低レベルのユニットで、制服は同じですが髪型が違います。彼女たちは司令官（男性キャラクター）の指揮下にあり、船の修理、負傷したユニットのケア、夕食の準備など、司令官のために仕事をします。\nユニフォームは司令官のユニフォームと同じような色にしたい。彼のレフシートのリンクを貼っておこう。\nレフシートは、twitterで作ってくれたのと同じようなもので、前、後ろ、横、髪の種類と色が違う表情を1つずつ、ブルーアーカイブガールズと同じようなものにしてほしい。髪型と体型のサンプルをリンクに載せます。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1qQIZKSBU46R7M6IHGr9DiHwykJvyJPI6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/10", "thumbnail_src": "https://si.imgix.net/ed385e50/uploads/origins/0d0b7fde-e087-4e60-b1dd-93520401f743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfc22674946d4484a3f86db2fd87c75e", "thumbnail_srcset": "https://si.imgix.net/ed385e50/uploads/origins/0d0b7fde-e087-4e60-b1dd-93520401f743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfc22674946d4484a3f86db2fd87c75e, https://si.imgix.net/ed385e50/uploads/origins/0d0b7fde-e087-4e60-b1dd-93520401f743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72a0806dce6ed381371602e8f0afc04b 2x, https://si.imgix.net/ed385e50/uploads/origins/0d0b7fde-e087-4e60-b1dd-93520401f743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19ce2b8bff188506b29bfaba598701c4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/9", "thumbnail_src": "https://si.imgix.net/f8da96b8/uploads/origins/0f21b8d0-4cf8-4c28-aad4-111ac64ec3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10f01b261c11ff827777503a353ff016", "thumbnail_srcset": "https://si.imgix.net/f8da96b8/uploads/origins/0f21b8d0-4cf8-4c28-aad4-111ac64ec3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10f01b261c11ff827777503a353ff016, https://si.imgix.net/f8da96b8/uploads/origins/0f21b8d0-4cf8-4c28-aad4-111ac64ec3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17dcd3afa4f5ac0d7a2bec9877b57035 2x, https://si.imgix.net/f8da96b8/uploads/origins/0f21b8d0-4cf8-4c28-aad4-111ac64ec3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9faae81fe86d41a1f180c5474c983730 3x", "genre": "art", "nsfw": false, "body": "うちよその子の\"レアスペア-EX-マキネ\"、通称\"REX\"を描いてほしいです。\n以下の要素を踏まえて下さい。\n・以前描いていたアクリルキーホルダー風味の絵でお願いします。\n・以下の構図の内いずれかをお願いします。\n→ガトリングをこちらに向けて構えてるポーズ\n→ナイフをもってこちらを覗き込んる風\n→無表情で小悪魔系妹っぽいポーズ\n→浮かばせたバックパックに座ってるポーズ\n・型番つきのものもあると嬉しいです。\n以下参考\n立ち絵\nhttps://x.com/rokuyon64dx/status/1601064450089684992?s=46&t=YUuILeB0C5XFb1C2wLMazA\n\n画像を使用したグッズ制作はskebの規約に則ってご使用下さい。\n\nよろしくお願いします。\n\nhttps://x.com/rokuyon64dx/status/1583842032149499904?s=46&t=YUuILeB0C5XFb1C2wLMazA", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/8", "thumbnail_src": "https://si.imgix.net/c1fcd533/uploads/origins/f221a448-c17a-4001-a5fc-59ca18dd54ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e90e174c89632f76e2be2242c992bbe", "thumbnail_srcset": "https://si.imgix.net/c1fcd533/uploads/origins/f221a448-c17a-4001-a5fc-59ca18dd54ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e90e174c89632f76e2be2242c992bbe, https://si.imgix.net/c1fcd533/uploads/origins/f221a448-c17a-4001-a5fc-59ca18dd54ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=292369da11b08c3a9cb5246e9b29561d 2x, https://si.imgix.net/c1fcd533/uploads/origins/f221a448-c17a-4001-a5fc-59ca18dd54ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c689fbc28b8a132eda40581699b0034d 3x", "genre": "art", "nsfw": false, "body": "うちよその子の\"レアスペア-EX-マキネ\"、通称\"REX\"を描いてほしいです。\n以下の要素を踏まえて下さい。\n・某プラモデルのボックスアート風に仕上げて下さい。フォントはBlackOpsOne-Regularです。題字には\n「Fontana 7th Branch \n2.5 Generation EX-MACHINA\nLMRS-F705EX\nRHEASPARE-EX-MACHINE」と表記してください\n形式は下記リンクをご参考に\n→https://x.com/rokuyon64dx/status/1743156814110494729?s=46&t=YUuILeB0C5XFb1C2wLMazA\n・市街地戦、戦闘中のワンカット、武器を構えながら土煙をあげつつホバー移動しているシチュエーション、でお願いします。\n・武器はガトリング、ナイフ、両方、片方ずつ等いずれかを構えた構図にして下さい。どのように描くかはお任せします。\n・他のエクスマキナも背景にいると嬉しいです。\n・衣装等にマーキングを追加してもらえると助かります(オプション、任意)\n・iPhone13用(1242×2688)、PCモニター壁紙用(1920×1080)の画像を用意してくださると助かります。(オプション、任意)\n\n以下参考\n立ち絵\nhttps://x.com/rokuyon64dx/status/1601064450089684992?s=46&t=YUuILeB0C5XFb1C2wLMazA\n\nhttps://x.com/rokuyon64dx/status/1583842032149499904?s=46&t=YUuILeB0C5XFb1C2wLMazA", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/7", "thumbnail_src": "https://si.imgix.net/7a9b29ac/uploads/origins/741c1c33-7347-4f40-a8ce-fee5110e38fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c608f67124d145f1f40674d66974b4c", "thumbnail_srcset": "https://si.imgix.net/7a9b29ac/uploads/origins/741c1c33-7347-4f40-a8ce-fee5110e38fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c608f67124d145f1f40674d66974b4c, https://si.imgix.net/7a9b29ac/uploads/origins/741c1c33-7347-4f40-a8ce-fee5110e38fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68a3cf373e6d8ea603f924fd86c42811 2x, https://si.imgix.net/7a9b29ac/uploads/origins/741c1c33-7347-4f40-a8ce-fee5110e38fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21940df914aba8fc7433fd81e341f40f 3x", "genre": "art", "nsfw": true, "body": "以前のリベルタちゃんテティアちゃんの触手絵ありがとうございました\n再びあなたのオリキャラでエロ絵を描いてほしいです\n独自設定妄想沢山ですがよろしくお願いします\n\n*キャラ\nhttps://www.pixiv.net/artworks/88305676\n↑この娘\n\n*エロ設定\n少年の姿の敵に油断してしまう\n強力な催眠をかけられ恋人と誤認させられる\nフェラを仕込まれて少年のフェラ奴隷としておもちゃにされる\n\n*構図\nhttps://skeb.jp/@Hyoshiki0416/works/1\n1.　眼帯ありでぎこちないフェラ、↑の絵のように頭を撫でられながらフェラしている\n撫でている手には不思議な力をまとっている\n少年はショタだがペニスは立派、玉無し、陰毛は生えていない\n大きなペニスを咥えてぎこちないながらも必死にフェラしている、顔は真っ赤\n「ど、どうだ・・・気持ちいいか」「お姉ちゃんもっと舌を動かして」「わ、わかった」\n2.　口内射精、初めての射精に驚いた表情\n「んんっ・・・にがっ」\n3.　時間経過\n髪の毛や服まで精液でどろどろ、眼帯が外れて天使の力がばれている\n率先してペニスを咥えている、1の時より深く咥えている\n「ん・・・じゅるる」「うっ、お姉ちゃん、上手くなったね」「そ、そうか・・・♡」\n\n以上です\n\n効果音多めでエロい感じを表現してほしい\n汁表現が好きなのでどろどろにしてほしい\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/6", "thumbnail_src": "https://si.imgix.net/937338e8/uploads/origins/7cc87df0-3a8b-4047-bb3c-9c8f4bbd4c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335bf71a3899e00f59c1788a471b7224", "thumbnail_srcset": "https://si.imgix.net/937338e8/uploads/origins/7cc87df0-3a8b-4047-bb3c-9c8f4bbd4c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335bf71a3899e00f59c1788a471b7224, https://si.imgix.net/937338e8/uploads/origins/7cc87df0-3a8b-4047-bb3c-9c8f4bbd4c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d318c50d8dbde3ea06dbc6ff43f0a684 2x, https://si.imgix.net/937338e8/uploads/origins/7cc87df0-3a8b-4047-bb3c-9c8f4bbd4c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4126f8d63f01866a77446e6ddc0ad7d8 3x", "genre": "art", "nsfw": false, "body": "こんにちは。このキャラクターを描いていただけませんか？\n\nhttps://skeb.jp/@gengerv3/works/35\nhttps://skeb.jp/@gengerv3/works/36\n\n詳細は自由に決めてください。ご配慮ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/5", "thumbnail_src": "https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47431dd55f33a4db5f37be44a2d9d17d", "thumbnail_srcset": "https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47431dd55f33a4db5f37be44a2d9d17d, https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d70075ba92cbc7154396239290a84318 2x, https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8b07f4697913813afedbb78ab268b2 3x", "genre": "art", "nsfw": true, "body": "彼女達のエッチな世界観がびびっときました\n彼女達のエッチな絵を描いてほしいです\n\n*キャラ\nリベルタ・モルテ＝メルク\nテティア・モルテ＝メルク\n\n*エロ設定\n異種姦（触手）\n種付け前に子宮に開発用のスライムを流し込む\nhttps://skeb.jp/@atsu_kake/works/10\n↑この絵みたいに\n子宮からポルチオ・膣を逆に犯され孕み袋に堕とされる\n\n*構図\n1.触手に捕まって犯され中出しされた直後\n二人ともまだ諦めておらず抵抗強めの表情\n「1回やられたぐらいで屈すると思うな！」\n\n子宮内にスライムが流し込まれている、子宮断面図\n\n2.子宮内でスライムが暴れる\n子宮からも飛び出してポルチオを入念にいじられている\n\nリベルタはすでに快感に翻弄され声がこぼれてしまっている\nテティアも感じているが我慢できている、リベルタに頑張れと鼓舞している\n\n3.　堕ちた二人\n快感に飲まれた二人、迫ってくる無数の触手に早く犯してくれと懇願している\n\n以上です\n\n服はあまり脱がさない感じでお願いします\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/4", "thumbnail_src": "https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8c0eb8fb0139fe2359487552df8c232", "thumbnail_srcset": "https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8c0eb8fb0139fe2359487552df8c232, https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=101623c57e6baa9057bc4fc947fffaf6 2x, https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b453bb0bf2d3d1a84fa9efb42cd7fd36 3x", "genre": "art", "nsfw": false, "body": "式白38さん\nはじめまして\n私のオリジナルキャラクターのイラストをお願いしたいです。\n以下、他の方に描いていただいた物ですがキャラクターの資料のURLです。\nhttps://drive.google.com/drive/folders/10j-i2ENmqyFrXx0j7H4_NiwfTXpxwig6\n\n2枚の衣装資料がありますが、2枚目の肩章の付いた方の衣装でお願いします。\n(シャツや蝶ネクタイ等、2枚目の資料に詳細書いていないものは1枚目の資料に詳細あります)\n蝶ネクタイは大きめにお願いします\n\nお嬢様口調で喋る怪盗の女の子のキャラクターです。\n性格はナルシストで自信満々ですが、ポンコツなアホの子です。\nカッコ付けながら悪い事をしますが、よくドジを踏んで失敗してしまいます。\n\n構図等はお任せします。\n長くなりましたが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/3", "thumbnail_src": "https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7baf879126628919fbfe5719a8cb397", "thumbnail_srcset": "https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7baf879126628919fbfe5719a8cb397, https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=478d84d89cae6c22c3b49104e35ae9db 2x, https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42b074a115eed416fa6f263eab64b050 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のキャラクター、ターニャをあなたのスタイルで描いてほしいです。彼女は船の整備士です。表現と構図の選択はあなたにお任せします。\nhttps://imgur.com/a/7bZ886k\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/2", "thumbnail_src": "https://si.imgix.net/fb489d4d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faffceaf5bc8df81f5a3d7494a3a95b6", "thumbnail_srcset": "https://si.imgix.net/fb489d4d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faffceaf5bc8df81f5a3d7494a3a95b6, https://si.imgix.net/fb489d4d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf1664c89ccbc48cf0250994f082a6a2 2x, https://si.imgix.net/fb489d4d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d251abd98b12671edae67a4af7792ad 3x", "genre": "art", "nsfw": false, "body": "初めて依頼させていただきます。音割れくろとです。\n今回は式白38.先生に一枚絵を依頼したくリクエストをしました。\n\n依頼内容ですが、うちの子のノラコさん（大人の方）を描いてほしいです。\nサイズは『縦1200×横600』か『縦2400×横1200』の式白38.先生の描きやすい方でお願いします。\n\n構図についてですが、太ももまで描くアップでお願いします。顔の向きは正面で、まっすぐ立つようにしてください。\n背景は白で、ノラコさんを逆光で描いてください。空気感が欲しいので式白38.先生の裁量で塵などを描き足してください。\n向かって右手で剣を持ち、向かって左の顔を隠すようにノラコさんに構えさせてください。\nできればでいいのですが顔を隠した剣にクロエちゃんの顔が移りこむ演出があると嬉しいです。\n\n言葉で伝えるのが難しいので構図イメージ合致の助けになる資料URLも貼っておきます。\n\n長く細かくなってしまいましたが、今回の依頼を受けていただければ幸いです。\nよろしくお願いします。\n\nhttps://twitter.com/gw6leuD9RpzhAb9/status/1423533783261663234?s=20", "created_at": "", "completed_at": ""}, {"path": "/@shiki_ne_/works/1", "thumbnail_src": "https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f968e9229793abe41c0b1554836baf12", "thumbnail_srcset": "https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f968e9229793abe41c0b1554836baf12, https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=691e5c0a76265aaeb2303dbf937151f2 2x, https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f955adacb4bbc3929dcd8cb78e572af 3x", "genre": "art", "nsfw": false, "body": "うちの子のレエちゃん描いてほしいです。\n以下の要素を踏まえて下さい。\n・カッコよく、戦闘のワンカットのイメージ\n・”キャラクター”と”武器”を画面内に収めてください。\n・人物は下記URLの設定に準拠して下さい。\n→https://twitter.com/Rokuyon64DX/status/1297337372435087360?s=20\n・下記画像を使用してください、そのまま使うとあれなので加工してください。（ただし縮尺はそのままで）\n→https://twitter.com/Rokuyon64DX/status/1107293244835024896?s=20\n・画像サイズは横長（1920ｘ1080）にして下さい。\n・上記を踏まえた上で構図、背景は自由（ただし、世界観はポストアポカリプス的なものから逸脱しない程度に）\n・流血表現があると喜びます（オプション）", "created_at": "", "completed_at": ""}]}