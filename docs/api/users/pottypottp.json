ab8-6058-44e5-8ad2-f7d0f2468b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44933b822391d13d4a552eca937a1ffb 2x, https://si.imgix.net/8482a2ea/uploads/origins/dd585ab8-6058-44e5-8ad2-f7d0f2468b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=319d9666983345555704db1ffad8c508 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pottypottp/works/59", "thumbnail_src": "https://si.imgix.net/24f5ed3f/uploads/origins/80c180ba-a8b8-4354-927e-643befe43f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b088072e367afacec8b71ea843960e", "thumbnail_srcset": "https://si.imgix.net/24f5ed3f/uploads/origins/80c180ba-a8b8-4354-927e-643befe43f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b088072e367afacec8b71ea843960e, https://si.imgix.net/24f5ed3f/uploads/origins/80c180ba-a8b8-4354-927e-643befe43f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66390970cd68f69228f67cea89ac0a2f 2x, https://si.imgix.net/24f5ed3f/uploads/origins/80c180ba-a8b8-4354-927e-643befe43f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7572971716a1ab0239b8456089fe15da 3x", "genre": "art", "nsfw": false, "body": "oさん、こんにちは。\noさんの絵柄がとても好きで、今回私のOCのモノクロイラストを依頼したいです。\n衣装と構図は全てお任せします！\n\n【OC設定】 https://drive.google.com/drive/folders/1W3ntXmnQbOSwJva803Ou4ZGpQexlQESq  \n1990年代香港ノスタルジア × 裏世界怪談譚  \n \nピンク髪：年下の電波系男子高校生  \n黒髪：明るい重い男社畜。角を持つ種族 ，本体は龍（東洋龍／西洋ドラゴン、いずれも可）  \n関係性：黒髪はピンク髪を世話し溺愛する傾向があり、ピンク髪は黒髪に依存しつつも、過干渉になると苛立ちを見せる  \n\n金額が不足する場合は再送してください。 \nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pottypottp/works/58", "thumbnail_src": "https://si.imgix.net/4765e15f/uploads/origins/0497060f