749524/uploads/origins/a703fca3-b6c1-46ab-9925-c3bc3001e902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5acf0231d08f56a8ace138522ee24f4c 2x, https://si.imgix.net/68749524/uploads/origins/a703fca3-b6c1-46ab-9925-c3bc3001e902?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67ef4097ed8c957b4c458e35f844324a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DCUVd0ZfkhG574Z/works/52", "thumbnail_src": "https://si.imgix.net/97da9b65/uploads/origins/7e7c58d4-583d-4371-b4c2-5e5a50a6c220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=259267a50f59632bb3ff1476afa64a67", "thumbnail_srcset": "https://si.imgix.net/97da9b65/uploads/origins/7e7c58d4-583d-4371-b4c2-5e5a50a6c220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=259267a50f59632bb3ff1476afa64a67, https://si.imgix.net/97da9b65/uploads/origins/7e7c58d4-583d-4371-b4c2-5e5a50a6c220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48a83940c4ab766cbe349d3dd583ecfa 2x, https://si.imgix.net/97da9b65/uploads/origins/7e7c58d4-583d-4371-b4c2-5e5a50a6c220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2830e9b9eaa7543ed3a3d707ce263e3 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生、\n\nお元気でお過ごしでしょうか。\n次回のGenshinxHilichurlの作品をお願いしたいと思います。\n\n今度の女の子は◯◯です：\n\n- アルレッキーノ\n- 風の工作員\n- コロンビーナ\n- サンドローン\n\n場所はまたあなた次第。\n女の子はみんな、また大きなお腹で妊娠しています。\nBBC/Hilichurlのボディペインティングを追加してください。\n\nシーンのストーリー\nヒリチュールたちは、ついにファトゥイの高位の女の子たちを捕らえることができた。\nヒリチュールたちは一日中彼女たちをレイプする。\nヒリチュール族はファトゥイ族を殺した彼女たちを憎んでいる。\nヒリチュール族はファトゥイ族を繁殖奴隷としか見ていない。\n\nシーンの詳細はあなたにお任せします。\nもしお好きなら、残酷で暗いシーンとして描いてください。少女たちはすべての希望を失い、すべての人権を剥奪されている。\n彼女たちはヒリチュールに飼育されるためだけに生きている。\n\n参考文献\n\n風の工作員\nhttps://static.wikia.nocookie.net/gensin-impact/images/b/be/Enemy_Wind_Operative.png/revision/latest?cb=20230927021116\n\nコロンビーナ\nhttps://images4.alphacoders.com/126/1260155.jpg\n\nhttps://www.ggrecon.com/media/44yk4l3k/genshin-impact-columbina.jpg?&format=webp&quality=50\n\nサンドローン\nhttps://static.wikia.nocookie.net/villains/images/1/13/FatuiSandrone.png/revision/latest?cb=20220711070101\n\nhttps://cdn.donmai.us/original/e7/ac/e7ac1637205d079b1b8802a112bdc4a9.png", "created_at": "", "completed_at": ""}, {"path": "/@DCUVd0ZfkhG574Z/works/51", "thumbnail_src": "https://si.imgix.net/99b57dca/uploads/origins/6dc947c8-862b-4f73-9dbe-3872eac350ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb57920e313579149534083b0e232e83", "thumbnail_srcset": "https://si.imgix.net/99b57dca/uploads/origins/6dc947c8-862b-4f73-9dbe-3872eac350ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb57920e313579149534083b0e232e83, https://si.imgix.net/99b57dca/uploads/origins/6dc947c8-862b-4f73-9dbe-3872eac350ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd63966f94696bc56daa2a6bb82bd562 2x, https://si.imgix.net/99b57dca/uploads/origins/6dc947c8-862b-4f73-9dbe-3872eac350ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=324b1780413cd3d48d72d0e90d032770 3x", "genre": "art", "nsfw": true, "body": "また先生、こんにちは、\n\n先日、とても楽しかったショーのアートワークをお願いしたいと思います：リンククリック（时光代理人）。\n\n登場人物は\n- 李天晨と\n- 李天璽\n\nシーン\n\n二人は性奴隷として黒人グループに売られた。\n\n李天晨は男の子ですが、妹のような格好をさせられています（参考文献のように）。彼をフェイスマスクで描いてください。\n\n違いがあれば最高です：\n\nシーン1：\n双子は黒人に犯されている。\n二人とも怖がり、嫌がっている。李天熙は泣いている。\n\nシーン2\n双子は新しい主人とのセックスを楽しみ始める。犯されながら顔を赤らめる。\n\nシーン3\n双子は今や堕落し、黒人男たちの欲望の奴隷でしかない。\n\nシーン4\n李天熙は妊娠しているはずだ。\n李天晨のペニスにはピアスがついているはずだ。彼は犯されながら射精しているはずだ。\n双子にはBBCとQOSのタトゥーがある。\n\nあなたはセックスの体位を選ぶことができますが、李天熙の妊娠したお腹と李天晨のペニスがよく見える体位を選んでください。\n\n参考文献\n\n李天晨\nhttps://static.wikia.nocookie.net/shiguang-dailiren/images/6/69/LTXDisguise.jpg/revision/latest/scale-to-width-down/1000?cb=20230827073023\n\n李天熙：\nhttps://static.wikia.nocookie.net/shiguang-dailiren/images/0/0a/LiTianxiProfile.jpg/revision/latest/scale-to-width-down/1000?cb=20230827040157", "created_at": "", "completed_at": ""}, {"path": "/@DCUVd0ZfkhG574Z/works/50", "thumbnail_src": "https://si.imgix.net/1eed5fc0/uploads/origins/a8728e58-7359-4c85-ba7f-810fd70f414d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db43915168d12e50f0d31b2a29ce89c3", "thumbnail_srcset": "https://si.imgix.net/1eed5fc0/uploads/origins/a8728e58-7359-4c85-ba7f-810fd70f414d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db43915168d12e50f0d31b2a29ce89c3, https://si.imgix.net/1eed5fc0/uploads/origins/a8728e58-7359-4c85-ba7f-810fd70f414d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a26b9d3d459253634a0f273453465f5e 2x, https://si.imgix.net/1eed5fc0/uploads/origins/a8728e58-7359-4c85-ba7f-810fd70f414d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a86af1e8e4e0f81257a298e4b6bf3b2 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生、\n\nお元気でお過ごしでしょうか。\nもしよろしければ、次回の源信の作品をお願いしたいのですが。\n\n今回の女の子は\n\n- 北斗\n- 寧光\n- ガンユー\n- イェンフェイ\n\n彼女たちは皆、大きなお腹で妊娠しているはずだ。もし気に入ったら：彼女たちの体にBBC/Hilichurlのペイントを追加してください。\n\n場所はまたあなた次第です。\n\nシーン：\nNingguangとBeidouが後ろからHilichurlに犯される。ヒリチュールは頭を前に押し出し、女の子たちにキスを強要する。\n\nヤンフェイはオッパイを弄びながらヒリチュールのBBCに乗る。\n\n私はガニュのファンではありません。\n彼女はヒリチュールたちに精液の捨て場として使われるだけという描き方でお願いします。彼女の主人は繁殖のために彼女をレイプするだけだ。愛はなく、ただ繁殖のためのレイプ。\n\nあとはあなたにお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@DCUVd0ZfkhG574Z/works/49", "thumbnail_src": "https://si.imgix.net/2a588cfb/uploads/origins/250c1408-19fa-41f0-9545-7fe774a1c8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28da0cef5044a911e822e265cd8f1640", "thumbnail_srcset": "https://si.imgix.net/2a588cfb/uploads/origins/250c1408-19fa-41f0-9545-7fe774a1c8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28da0cef5044a911e822e265cd8f1640, https://si.imgix.net/2a588cfb/uploads/origins/250c1408-19fa-41f0-9545-7fe774a1c8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15d331cfe31231e948e07752f2e14378 2x, https://si.imgix.net/2a588cfb/uploads/origins/250c1408-19fa-41f0-9545-7fe774a1c8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b4c028d50f7477aad622a71cb416a55 3x", "genre": "art", "nsfw": true, "body": "こんにちは、先生、\n\n今回は「幻神」から少し間が空きましたが、「ウチの弟マジでデカイんだけど見にこない？\n今回のシリーズは「ウチの弟マジでデカイんだけど見にこない？\n\nこのシリーズに登場する3人の女の子は皆、妊娠率が高い。\n男の主人公はナオ（シリーズのショタ、チアキの弟）。とてつもない巨根の持ち主。\n\nこのシーンは、千秋のボーイフレンドからの視点であるべきだ。\n彼は、千秋が兄の巨根に乗っている寝室に入っていく。\n彼女はボーイフレンドと向かい合っている。\n\n渚と雪子は千秋と奈緒の後ろのベッドに横たわっており、完全に疲れ切っている。\n\n千秋は兄の巨根に跨りながら、彼氏にこんなことを言っている：\n「情けない。私の中の子供はあなたの子じゃない！あなたの小さなペニスでは、私を孕ませることはできない\"\n\nもっと詳細や文章を追加することができます。\n女の子とナオの裸を描いてください。妊娠した少女たち\n\n千秋\nhttps://cdn.myanimelist.net/images/characters/4/441221.jpg\n\n渚\nhttps://cdn.myanimelist.net/images/characters/5/441219.jpg\n\n雪子\nhttps://cdn.myanimelist.net/images/characters/8/441220.jpg\n\nナオ\nhttps://cdn.myanimelist.net/images/characters/6/441217.jpg\n\nその他の参考文献\nhttps://m5.hentaiera.com/016/nafzj9otxp/12.jpg\n\nhttps://cdn.hentaiworld.tv/wp-content/uploads/2022/07/Uchi-no-Otouto-Maji-de-Dekain-dakedo-Mi-ni-Konai2.jpg.webp\n\nhttps://zhentube.com/wp-content/uploads/2021/03/Uchi-no-Otouto-Maji-de-Dekain-Dakedo-Mi-ni-Konai-Episode-2.jpg\n\nハードコアなNTRにしたり、このシーンで意味があると思うものを自由に追加してください。", "created_at": "", "completed_at": ""}]}