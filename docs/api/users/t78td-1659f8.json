ちらを見るような集合写真のような絵をお願いします。\n\n猫が真ん中で、その周りにくっつくようにうんた達がいるのが理想です。\n\nうんたねこは実物の猫より小さいかと思いますので、周りでキャッキャしててもいいかもしれません笑\n\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@t78td/works/8", "thumbnail_src": "https://si.imgix.net/9aa0924f/uploads/origins/e6531651-5a67-41cd-a613-cc1637cae506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1036e3bd5ad0d6ff7826783117d3075", "thumbnail_srcset": "https://si.imgix.net/9aa0924f/uploads/origins/e6531651-5a67-41cd-a613-cc1637cae506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1036e3bd5ad0d6ff7826783117d3075, https://si.imgix.net/9aa0924f/uploads/origins/e6531651-5a67-41cd-a613-cc1637cae506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5768965929c2d503641d6b85471a1f69 2x, https://si.imgix.net/9aa0924f/uploads/origins/e6531651-5a67-41cd-a613-cc1637cae506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71f1cae5bfb7f077b1225f2b8ba2cbd9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@t78td/works/7", "thumbnail_src": "https://si.imgix.net/3eb663ca/uploads/origins/61255172-ef40-4863-9aee-a03ee679dffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43a51b9073686efd8ed067f0e78937d6", "thumbnail_srcset": "https://si.imgix.net/3eb663ca/uploads/origins/61255172-ef40-4863-9aee-a03ee679dffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43a51b9073686efd8ed067f0e78937d6, https://si.imgix.net/3eb663ca/uploads/origins/61255172-ef40-4863-9aee-a03ee679d