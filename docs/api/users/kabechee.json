-4f09-8ebd-2145e2170efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e08f7e7becc9851253cc279fc615166b", "thumbnail_srcset": "https://si.imgix.net/159664e7/uploads/origins/267749b0-e900-4f09-8ebd-2145e2170efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e08f7e7becc9851253cc279fc615166b, https://si.imgix.net/159664e7/uploads/origins/267749b0-e900-4f09-8ebd-2145e2170efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecf6c18070616cdb455f7db830b23812 2x, https://si.imgix.net/159664e7/uploads/origins/267749b0-e900-4f09-8ebd-2145e2170efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08fa7b45d88690b64585bb3526db5c20 3x", "genre": "art", "nsfw": false, "body": "はじめまして、あかつきと申します。\nいつもチーズ壁さんのイラストを楽しく見させていただいております。\nさて、本題の依頼内容なのですがスティルインラブのシナリオに脳を焼かれたので冬 コミにてスティルインラブハッピーエンドシナリオの小説を 出したいと考えております。\n両表紙のようなスタイルで考えておりまして、もう片方の表紙は別の絵師様に依頼させていただいております。\nもう1つの表紙にチーズ壁さんのイラストを使用出来ればと思いリクエストさせていただきました。\nスティルインラブが幸せそうな表情を向けてくれている、そんなイラストを頂ければ大変嬉しいです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kabechee/works/3", "thumbnail_src": "https://si.imgix.net/398dcbd5/uploads/origins/e04085ed-7670-49cc-9bec-5654a1f9ee19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f69b82279c8c5b9a16f94ec616a2007", "thumbnail_srcset": "https://si.imgix.net/398dcbd5/uploads/origins/e04085ed-7670-49cc-9bec-5654a1f9ee19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f69b82279c8c5b9a16f94ec616a2007, https://si.imgix.net/398dcbd5/uploads/origins/e04085ed-7670-49cc-9bec-5654a1f9ee19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=526b74d786a7c0a296d80fc583489789 2x, https://si.imgix.net/398dcbd5/uploads/origins/e04085ed-7670-49cc-9bec-5654a1f9ee19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e57516f9e0a3b85e343636a74075d23 3x", "genre": "art", "nsfw": false, "