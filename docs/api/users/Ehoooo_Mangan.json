dad6-45c1-9e54-e8683a7e7e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=232194484dd8cdad148a6c398bb8affe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/56", "thumbnail_src": "https://si.imgix.net/b5fca26d/uploads/origins/b4ee3f9e-08c8-49b0-9c3a-d49125a03d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23558c8f4f520a12a67a7f8fd1074a62", "thumbnail_srcset": "https://si.imgix.net/b5fca26d/uploads/origins/b4ee3f9e-08c8-49b0-9c3a-d49125a03d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23558c8f4f520a12a67a7f8fd1074a62, https://si.imgix.net/b5fca26d/uploads/origins/b4ee3f9e-08c8-49b0-9c3a-d49125a03d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20b1a7e80743a780ebe1c03b82ced89e 2x, https://si.imgix.net/b5fca26d/uploads/origins/b4ee3f9e-08c8-49b0-9c3a-d49125a03d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ec0215e3fd21ed5c6eaa64ee0155949 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/55", "thumbnail_src": "https://si.imgix.net/299e6ca4/uploads/origins/5745a8dd-78cd-4d34-a446-a6daed61ccc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211b82b3e140e8f29c94fd0d5748a495", "thumbnail_srcset": "https://si.imgix.net/299e6ca4/uploads/origins/5745a8dd-78cd-4d34-a446-a6daed61ccc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211b82b3e140e8f29c94fd0d5748a495, https://si.imgix.net/299e6ca4/uploads/origins/5745a8dd-78cd-4d34-a446-a6daed61ccc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42c84411be4c7e4d6709daf91615061d 2x, https://si.imgix.net/299e6ca4/uploads/origins/5745a8dd-78cd-4d34-a446-a6daed61ccc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52f71b4c52b54c0c7630388a66b6ee85 3x", "genre": "art", "nsfw": false, "body": "こんにちは。恵方満貫@Skeb募集中(現在1件)さんが描いた金光聖母、美人で大好きです。リクエストで、その金光聖母をもう一度描いて欲しいです。シチュエーションは、「握手して下さい」と頼まれ浮かぶ手袋を差し出して握手させてくれる所（画面の奥側に金光聖母がいて、そのマントがふわりと魔力でたくし上げ、マントの中の虚空から手袋（大きめ）がニュッと飛び出す感じ）を描いて欲しいです。手袋をメインに縫い目有りで、お願いします。もし描ければ手袋を脱いで中の手を見せてくれる所もお願いします（脱いだ手袋は空中を漂う感じでお願いします）。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/54", "thumbnail_src": "https://si.imgix.net/f60a66fc/uploads/origins/aa2dd19b-0daa-4cac-89e2-a951dda838a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68b9323424263bfc3b25d35a6622ef01", "thumbnail_srcset": "https://si.imgix.net/f60a66fc/uploads/origins/aa2dd19b-0daa-4cac-89e2-a951dda838a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68b9323424263bfc3b25d35a6622ef01, https://si.imgix.net/f60a66fc/uploads/origins/aa2dd19b-0daa-4cac-89e2-a951dda838a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b28e43c78f48e3198d7913945aa6dba7 2x, https://si.imgix.net/f60a66fc/uploads/origins/aa2dd19b-0daa-4cac-89e2-a951dda838a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=932cb0bed59f203d512ff56381a80ec2 3x", "genre": "art", "nsfw": true, "body": "こんにちは、初めてリクエストします。\nガンダム00のスメラギ・李・ノリエガとカティ・マネキンをお願いします。\nアングルは正面から見た感じで右にマネキン、左はスメラギで、お互い、腰に手を当てて、描いてください。表情はお互い、久しぶりに会えたのを喜んでいる感じの笑顔にしてください。マネキンは髪をお団子状にまとめ、メガネをかけて描いてください。胸は二人とも大きく、スメラギは特に大きくしてください。二人の衣装は下着です。下着はセクシー系のブラとTバックで、色はスメラギは黒、マネキンは白にしてください。\n後、差分の方もお願いします。差分はトップレスと全裸です。背景の方はお任せします。\n長くなりましたが、リクエストが無理なら、キャンセルしても構いません。もし、リクエストを受けてもらえたら、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/53", "thumbnail_src": "https://si.imgix.net/33da2574/uploads/origins/b52681a3-ec32-4476-be18-2c1781ecb732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d9e59c3ac97e63d483a73e51c716bb6", "thumbnail_srcset": "https://si.imgix.net/33da2574/uploads/origins/b52681a3-ec32-4476-be18-2c1781ecb732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d9e59c3ac97e63d483a73e51c716bb6, https://si.imgix.net/33da2574/uploads/origins/b52681a3-ec32-4476-be18-2c1781ecb732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a039e61851e6afb82f812672c946176 2x, https://si.imgix.net/33da2574/uploads/origins/b52681a3-ec32-4476-be18-2c1781ecb732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbc754e8eb1916c06df471674788792b 3x", "genre": "art", "nsfw": false, "body": "恵方満貫様こんにちは！\n前回は素敵なイラストをありがとうございます。\nまたイラストをお願いしたくリクエストを送らせていただきます。\n\n今回描いていただきたいのは香倉玲衣の水着イラストです。\n水着のデザインなどについてはお任せしますので\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/52", "thumbnail_src": "https://si.imgix.net/7b6fbeaa/uploads/origins/deeca738-2617-4359-a3c9-fe79aa60656d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab6d78e0fa3e8c755baa15b0e82bca7", "thumbnail_srcset": "https://si.imgix.net/7b6fbeaa/uploads/origins/deeca738-2617-4359-a3c9-fe79aa60656d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab6d78e0fa3e8c755baa15b0e82bca7, https://si.imgix.net/7b6fbeaa/uploads/origins/deeca738-2617-4359-a3c9-fe79aa60656d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11df9c5edf99ebb49ff06390f19ac1ff 2x, https://si.imgix.net/7b6fbeaa/uploads/origins/deeca738-2617-4359-a3c9-fe79aa60656d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c672f0fe886a474aa3c13397781c9f68 3x", "genre": "art", "nsfw": true, "body": "こんばんは。お世話になります。今回は以下の内容でリクエストをさせていただければと思いましたので、よろしければお願いいたします。\n\n●キャラクター\nミーア・キャンベル(ガンダムSEED DESTINY)\n\n●状況\nライブの本番直前になって、胸部などコスチュームの一部の破損が発覚。\n応急措置として、破損した箇所にあたる身体の部分にボディペイントを実施して出演強行。\n\n●表情\nバレたら一大事のため、冷や汗をかきながらも笑顔を見せている。\n\n●その他\n・上記以外の指定はなく(小道具、背景など)、加筆や調整、アレンジをしていただいて問題ございません。\n\n・胸部以外のコスチュームの破損箇所についての指定はございません。他にも破れているかもしれませんが…。\n\n描きやすさ、イメージのしやすさを最優先していただけますと幸いです。\n\n以上となります。ご都合がよろしければご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/51", "thumbnail_src": "https://si.imgix.net/996871c0/uploads/origins/6f63baf4-6e17-47f4-aa77-4f298798b69c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c31824bfe39461d8a9ef452d1f9fe3d", "thumbnail_srcset": "https://si.imgix.net/996871c0/uploads/origins/6f63baf4-6e17-47f4-aa77-4f298798b69c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c31824bfe39461d8a9ef452d1f9fe3d, https://si.imgix.net/996871c0/uploads/origins/6f63baf4-6e17-47f4-aa77-4f298798b69c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d559f20b42e98af633685752a50f059 2x, https://si.imgix.net/996871c0/uploads/origins/6f63baf4-6e17-47f4-aa77-4f298798b69c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=074de7e421b51d14b1259221c9f44d12 3x", "genre": "art", "nsfw": true, "body": "このリクエストには, ファンタジー世界の女冒険パーティー(オリジナル娘)が2人の巨人(男)に捕らわれます. 巨人は野蛮人に扮していますが、モンスターではなく、巨大な人間の戦士のように見えます. 巨人は身長が１５〜２０メートルです。イクイップメントは腰布とベルト巨大な武器と小さなポーチです. 巨人は簡単にパーティーを倒して、いま女達を持ち帰りのために拘束して誘拐しています。\n\n女冒険パーティーはすべてのイクイップメントとほとんどの服が剥ぎ取られました。イクイップメントと服は地面に散在しています。すべての女達は起きていますが弱くて疲れ果てています。女達はすべて猿轡をされて無駄に絆と戦ています. 巨人は運ぶのためにすべての女達をしまい込みています。巨人ごとに一人の女の子が腰布の内部に大の字で縛られていて鼠径部の隣です。一人の巨人は既に腰布を着ていて他の巨人が腰布を拾っています。他の女達はホグタイされてベルトから吊り下げています。表情が恐れや怒りや屈辱表しています。数人の女達は少しあざですが実際の怪我がありません, 二人の巨人は早くに素手でパーティーを圧伏しました.", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/50", "thumbnail_src": "https://si.imgix.net/e8652e67/uploads/origins/79a4aa57-9242-42ee-a416-6e2b134d80e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5b078cf991c1bb6a305ee688d649bf", "thumbnail_srcset": "https://si.imgix.net/e8652e67/uploads/origins/79a4aa57-9242-42ee-a416-6e2b134d80e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5b078cf991c1bb6a305ee688d649bf, https://si.imgix.net/e8652e67/uploads/origins/79a4aa57-9242-42ee-a416-6e2b134d80e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6eb2ec41e17bc7f3d1ff672c7d4aad1c 2x, https://si.imgix.net/e8652e67/uploads/origins/79a4aa57-9242-42ee-a416-6e2b134d80e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d6c45412dc94c7f627defb37f652dbf 3x", "genre": "art", "nsfw": true, "body": "お世話になります。今回は以下の内容でリクエストをさせていただければと思いましたので、よろしければお願いいたします。\n\n●キャラクター\nミレイナ・ヴァスティ(劇場版)\n\n●状況\n(古いネタで恐縮ですが…)タピオカチャレンジに挑戦中。少し悪戦苦闘の様子。\n\n●その他\n・ドリンクについては、他の飲料…例えば紙パック牛乳などでも問題ございません。\n\n・上記以外の指定はなく(小道具、背景など)、加筆や調整、アレンジをしていただいて問題ございません。\n描きやすさ、イメージのしやすさを最優先していただけますと幸いです。\n\n以上となります。ご都合がよろしければご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/49", "thumbnail_src": "https://si.imgix.net/f915a892/uploads/origins/e7db443a-da24-4c85-a9d6-aeaf01f453b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac0aa92d8d6c3791f11f7feb179569a2", "thumbnail_srcset": "https://si.imgix.net/f915a892/uploads/origins/e7db443a-da24-4c85-a9d6-aeaf01f453b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac0aa92d8d6c3791f11f7feb179569a2, https://si.imgix.net/f915a892/uploads/origins/e7db443a-da24-4c85-a9d6-aeaf01f453b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5df6eba81dc4748cfb6d765483adbfce 2x, https://si.imgix.net/f915a892/uploads/origins/e7db443a-da24-4c85-a9d6-aeaf01f453b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce9256d8fffa39936d3bdf11867c9d68 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\nリクエストで藤崎竜の封神演義に出てくる金光聖母を描いて欲しいです。シチュエーションは、浮かんでる手袋を魔力で風船のように膨らませてこちらを脅かそうとしてくる所をで右手は膨らみかけで、左手は丸々と大きく膨らんでる感じでお願いします。左手は大きく膨らんだことにより手袋が透け中の手がうっすら見える状態でお願いします。表情は少し不気味な微笑みで目は妖怪みたいな感じで、手袋には縫い目ありで描いて下さい。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/48", "thumbnail_src": "https://si.imgix.net/08b25cf7/uploads/origins/f7dddc5d-8cda-469d-ac36-664c99ee8f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f6ddd51de8a924c3861403ed3aa4e2", "thumbnail_srcset": "https://si.imgix.net/08b25cf7/uploads/origins/f7dddc5d-8cda-469d-ac36-664c99ee8f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f6ddd51de8a924c3861403ed3aa4e2, https://si.imgix.net/08b25cf7/uploads/origins/f7dddc5d-8cda-469d-ac36-664c99ee8f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8d4f2af128161583e8ec1807273ea7d 2x, https://si.imgix.net/08b25cf7/uploads/origins/f7dddc5d-8cda-469d-ac36-664c99ee8f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9fb6b83a7f85a843a7cdc87f63ff9fc 3x", "genre": "art", "nsfw": true, "body": "はじめまして。あなたのアピールを見て、リクエストすることにしました。斎藤楓さんの絵がとても気に入ったので、またお願いしたいと思います。\n\nその絵では、楓が太ったおじさんと情熱的なセックスをしています。二人は木造の小屋のベッドの上にいる。楓はおじさんの上に乗って、彼のペニスを彼女のアソコに入れている。彼女の手は彼の手を握っている。彼女もおじさんも全裸だが、彼女は眼鏡をかけたままだ。楓はそれを楽しんでいるようで、顔を赤くして喘いでいる。\n \nもし可能なら、受精差のあるナカダシが欲しい。\n\nありがとうございます。\n\nhttps://imgchest.com/p/lqye3wxkk4d", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/47", "thumbnail_src": "https://si.imgix.net/e9099764/uploads/origins/7c69213f-4ab4-4b28-a9a9-a49e7eed0e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110a0bf9e35710bf8a425f1dcb152b80", "thumbnail_srcset": "https://si.imgix.net/e9099764/uploads/origins/7c69213f-4ab4-4b28-a9a9-a49e7eed0e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110a0bf9e35710bf8a425f1dcb152b80, https://si.imgix.net/e9099764/uploads/origins/7c69213f-4ab4-4b28-a9a9-a49e7eed0e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=325eebbefa7240532bc39b8b028d1b04 2x, https://si.imgix.net/e9099764/uploads/origins/7c69213f-4ab4-4b28-a9a9-a49e7eed0e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5660d22e77e47ec572f6814b37d88c55 3x", "genre": "art", "nsfw": false, "body": "恵方満貫様、アピールいただきありがとうございます。\n\n描いていただきたいのは香倉玲衣で構図についてはお任せいたします。\n\n配信のサムネなどに使用させていただきたく透過もいただけると助かります。\n\nご検討よろしくお願いいたします。\n\nhttps://x.com/gray_zone02/status/1623683441907884033", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/46", "thumbnail_src": "https://si.imgix.net/1de0e732/uploads/origins/5a8eb278-7e9e-439a-85e3-55a270b6357e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3953cd473e96c6875d34887b94f1cfc4", "thumbnail_srcset": "https://si.imgix.net/1de0e732/uploads/origins/5a8eb278-7e9e-439a-85e3-55a270b6357e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3953cd473e96c6875d34887b94f1cfc4, https://si.imgix.net/1de0e732/uploads/origins/5a8eb278-7e9e-439a-85e3-55a270b6357e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11c57e5372f52892cac07f8b15c50df6 2x, https://si.imgix.net/1de0e732/uploads/origins/5a8eb278-7e9e-439a-85e3-55a270b6357e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3a42276328e8c37b54461f2d46bfe5a 3x", "genre": "art", "nsfw": true, "body": "資料の故・黒岩よしひろさんの作品『鬼神童子ZENKI』の、服を破られて泣いているお姉さんの絵をリクエストします。\n資料と同じように服をビリビリに破かれて壁際に追い詰められて、両目を見開いて悲鳴をあげている感じでお願いします。白のハイヒールまで見える全身を描いてほしいです。\nポーズはお任せしますが、破れた服からのぞく下着が隠れない位置に手を置いてください。\n\nhttps://drive.google.com/drive/folders/1ibjkf6_DRuUgz1CRq1vrSV0nFyZ5sL3T", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/45", "thumbnail_src": "https://si.imgix.net/7652b55f/uploads/origins/f586bf2f-9e10-4f62-992c-91de701062b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d34bc339e287faea2880b4e280d0a3e", "thumbnail_srcset": "https://si.imgix.net/7652b55f/uploads/origins/f586bf2f-9e10-4f62-992c-91de701062b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d34bc339e287faea2880b4e280d0a3e, https://si.imgix.net/7652b55f/uploads/origins/f586bf2f-9e10-4f62-992c-91de701062b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12cab9f716f239345854c861935fe54c 2x, https://si.imgix.net/7652b55f/uploads/origins/f586bf2f-9e10-4f62-992c-91de701062b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22545793b42eb02e16caf4ec6e4f7781 3x", "genre": "art", "nsfw": true, "body": "こんにちは、お元気ですか。はい、「XV観客少女」の作品が欲しいです。\n\nhttps://drive.google.com/drive/folders/1f57HhhCVd3jEwpxK8w-4Lgu6D8peefm6\n\nスマートフォンで鏡に映った自分を撮ってほしい。\n\nこんな服を着せてみたい：\n\nhttps://skeb.jp/ 藤川大地/works/13\n\nいろんなバージョンが欲しい。\n\nあの服を着たバージョン。\n下着だけのバージョン。\n全裸バージョン。\n\n正確な表情、体のポーズ、服の色は、あなたの芸術的解釈にお任せします。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/44", "thumbnail_src": "https://si.imgix.net/8c29fcc9/uploads/origins/c4c96f44-4e5f-4deb-8c32-d268789be212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cda65d6ae3939a8bcd84e08b001e51c", "thumbnail_srcset": "https://si.imgix.net/8c29fcc9/uploads/origins/c4c96f44-4e5f-4deb-8c32-d268789be212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cda65d6ae3939a8bcd84e08b001e51c, https://si.imgix.net/8c29fcc9/uploads/origins/c4c96f44-4e5f-4deb-8c32-d268789be212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97b31e143f694b324e55b98295342dc8 2x, https://si.imgix.net/8c29fcc9/uploads/origins/c4c96f44-4e5f-4deb-8c32-d268789be212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d55044987917eb5bdb3d43e95216e82d 3x", "genre": "art", "nsfw": true, "body": "先生はじめまして。早速リクエストですが、インゴシマのスピンオフのような感じで1980年代の女子大生が遭難及びインゴの島に漂着し、シマビトに囚われた後に選別で生贄として捧げられるイラストをお願いいたします。\n\n詳細\n①衣装は裸エプロンのような格好（前だけを隠した薄い一枚布)で、しめ縄を付けた大岩に赤色の縄で縛り付けられています。\n②衣装からは、大きな胸があふれピンクの乳首が見えかけています。\n③頭のてっぺんから足のつま先まで全体的に描いてください。\n④表情は縛られている状況に理解出来ず困惑してる感じです。\n⑤参考画像の両脇の男と吹き出し等ははなしでお願いします。\n⑥髪色は黒で、髪型は当時流行りだった聖子ちゃんカットでお願いします。\n\n構図及び衣装参考画像https://photos.app.goo.gl/S1CafaykisFkYCSw6\n髪型参考画像https://photos.app.goo.gl/tHnVdpZMwEzuH9229\n\nご多忙を承知の上でのリクエストですが、ご検討の程宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/43", "thumbnail_src": "https://si.imgix.net/3ff24663/uploads/origins/268a042a-0166-4d78-8049-d44c87e6aa28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=158ae8c2ff2e02ff33972e4ba4e5c81b", "thumbnail_srcset": "https://si.imgix.net/3ff24663/uploads/origins/268a042a-0166-4d78-8049-d44c87e6aa28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=158ae8c2ff2e02ff33972e4ba4e5c81b, https://si.imgix.net/3ff24663/uploads/origins/268a042a-0166-4d78-8049-d44c87e6aa28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b554cb2f48fd4e068510715f0a7fc0f 2x, https://si.imgix.net/3ff24663/uploads/origins/268a042a-0166-4d78-8049-d44c87e6aa28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8b44bbfe2ce1be4a5dbfe6f4ed39dc6 3x", "genre": "art", "nsfw": true, "body": "お世話になります。今回は以下の内容でリクエストをさせていただければと思いましたので、よろしければお願いいたします。\n\n●キャラクター\nスメラギ・李・ノリエガ(ガンダム00)\n\n●状況\n脱衣所で服を脱いでいる最中の姿を、隠しカメラに撮られている設定。当人は全く気づいていない。\n\n●衣類\n1stシーズン時のもの。\n上着は胸元が全開。ズボンは既に畳んであり、ショーツに手をかけている。\n下着のカラーやデザインの指定はございません。\n\n●その他\n・録画の描写方法は、ご判断にお任せいたします。\n例：「REC」の文字、バッテリーの残量など\n\n・その他、加筆や調整、アレンジをしていただいて問題ございません。\n描きやすさ、イメージのしやすさを最優先していただけますと幸いです。\n\n以上となります。ご都合がよろしければご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@Ehoooo_Mangan/works/42", "thumbnail_src": "https://si.imgix.net/d1b0e94c/uploads/origins/7d5f34b9-00bd-4197-8c31-4bb53f3