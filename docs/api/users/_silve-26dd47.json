-a6ab-c16b3fecd3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31dbf43bbd099ce818c65bf1a141f2f2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_silve/works/30", "thumbnail_src": "https://si.imgix.net/0ea28af8/uploads/origins/fc6fa054-4274-4b37-9def-0d82aed29967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ef2825dab4b68f065dd11839a05a94f", "thumbnail_srcset": "https://si.imgix.net/0ea28af8/uploads/origins/fc6fa054-4274-4b37-9def-0d82aed29967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ef2825dab4b68f065dd11839a05a94f, https://si.imgix.net/0ea28af8/uploads/origins/fc6fa054-4274-4b37-9def-0d82aed29967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e2919c1bcc37bd954ae354bed4bd917 2x, https://si.imgix.net/0ea28af8/uploads/origins/fc6fa054-4274-4b37-9def-0d82aed29967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a0be99ccf85b59c7ab35dab04ca9292 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させて頂きます。\n「ファイアーエムブレム蒼炎の軌跡」の傭兵の女の子ワユを依頼させてください。10代後半の子です。\nhttps://guide.fire-emblem-heroes.com/08001011000189-2\n\nシチュは傭兵として雇われた彼女、遠征先の駐屯地で性欲溜まった他の傭兵達に金出すから頼むとせがまれ、悩んだ末に丁度金欠だったし仕方ないなぁと応じて…の様なイメージで、男性達と乱交セックスする様子を描いてください。\n服装は上記URLのものから捲ったり外したり脱がせていったり等して胸や女性器周辺を露出させて頂ければと思います。\n寝そべって足を開いた状態で、正常位で受け入れて挿入されたりしながら手コキもしくはフェラしたりする様子をお願いします。構図はお任せします。\n内容についてはお金もらってるのとワユ自身そこそこ経験あってセックス自体は嫌いじゃないイメージで、照れたり困ったりはしても極力嫌がらず受け入れている、久々のセックスで気持ちよくなったりする様子をお願いします。\nまた、気持ち良くなって盛り上がって中出しされてしまい妊娠したらどうすんのと怒ったりまだ余裕ありそうな様子や、代わる代わる何度もイカされて快楽に惚けたり事後荒い呼吸してる様子など可能な範囲でお願いします。\nその他はお任せします。上記もあくまでイメージなのでエッチに描きやすい形でアレンジして頂いても構いません。\n以上、よろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_silve/works/29", "thumbnail_src": "https://si.imgix.net/455ef920/uploads/origins/897e143d-986d-4771-bdd0-be4d5e5d71a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28698f39ad15ac2f6260165e6ecfdfe8", "thumbnail_srcset": "https://si.imgix.net/455ef920/uploads/origins/897e143d-986d-4771-bdd0-be4d5e5d71a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28698f39ad15ac2f6260165e6ecfdfe8, https://si.imgix.net/455ef920/uploads/origins/897e143d-986d-4771-bdd0-be4d5e5d71a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a39a1fc0843fd22a32bb559a990121b 2x, https://si.imgix.net/455ef920/uploads/origins/897e143d-986d-4771-bdd0-be4d5e5d71a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2daba9e97ac6e175eb40db72747ab21 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回依頼をさせてもらいます。\n\n\n◆【キャラクター】\n　ファイアーエムブレム 烈火の剣に登場するリン。\n　https://drive.google.com/file/d/1uL9mRoea7Bn4Clk6jmDqjJz7WNbUb68m/view?usp=sharing\n　今回はこちらの水着衣装でリクエストさせてもらいます。\n　https://drive.google.com/file/d/1Uo29qrKTTogYSLRI-Ei7PSLKQZKrC6ps/view?usp=sharing\n　公式英雄紹介(ミニキャラですが背中資料あり)\n　https://guide.fire-emblem-heroes.com/06001002000396/\n\n◆【シチュエーション】\n　女性が発情してしまうエッチな地形効果があるビーチとは知らずにバカンスに来たリン。\n　地形効果ですっかりエッチな気分になっているところに異界のヤリチン男たちがナンパしてくる。\n　普段は相手にもしないような雰囲気の男たちの誘いにのってしまい乱交エッチをしてしまう…というシチュエーションでお願いします。\n\n◆【体位や構図】\n　体位や構図はおまかせします。\n　①竿役の人数は2～3人でお願いします。\n　②竿役たちの射精差分をお願いします。\n\n◆【表情】\n　ビーチの地形効果ですっかり淫乱状態になって気持ちよさそうに乱交しているという風にお願いします。\n　中出しされとろけ顔になっている表情差分などお願いします。\n\n◆【服装】\n　水着は着たままずらし挿入。\n　水着がズレて豊満なオッパイが見えている差分をお願いします。\n\n◆【台詞や擬音】\n　リンの感じている声を小さめの描き文字でお願いします。\n　「あっ」「んっ」みたいな感じの控えめな感じでお願いします。\n　エッチな擬音もお願いします。\n　\n◆【NG要素】\n　個人的な好みで\n　・過度なアヘ顔\n　・口をすぼめたひょっとこフェラやバキュームフェラ 　\n　・スカ要素 　\n　・乳首やクリトリスへのピアス\n　・抜け陰毛\n　などはNGでお願いします。\n\n◆【その他】\n　竿役のモブ男たちは全身写さずこちらの3Dモデルぐらいの写り込みでお願いします。\n　https://x.com/0141robin/status/1873976226848940355", "created_at": "", "completed_at": ""}, {"path": "/@_silve/works/28", "thumbnail_src": "https://si.imgix.net/0a13ee7c/uploads/origins/28817a4c-7737-4c78-9a9a-c0022ea7f739?bg=%23fff&auto=format%2Ccomp