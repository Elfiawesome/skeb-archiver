ded_at": "2026-03-08T01:29:36.227542+00:00"}, {"amount": 25000, "recorded_at": "2026-03-21T03:07:35.566503+00:00"}, {"amount": 15000, "recorded_at": "2026-03-21T12:11:02.002367+00:00"}, {"amount": 11000, "recorded_at": "2026-03-22T07:11:07.137685+00:00"}, {"amount": 12000, "recorded_at": "2026-03-22T07:51:06.012611+00:00"}]}, "current_prices": {"art": 12000}, "price_range": {"art": {"min": 8000, "max": 28000}}, "links": [{"label": "Twitter", "url": "https://x.com/Tomo_Eokaiteru", "name": "Tomo_Eokaiteru"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/88827777", "name": "88827777"}], "flags": {"from_archive": true}, "acceptable": false, "works": [{"path": "/@Tomo_Eokaiteru/works/92", "thumbnail_src": "https://si.imgix.net/af9dc26d/uploads/origins/6c0452af-f10a-4d7d-b595-6713194b8962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27550deea99bb29b246a246157402e2b", "thumbnail_srcset": "https://si.imgix.net/af9dc26d/uploads/origins/6c0452af-f10a-4d7d-b595-6713194b8962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27550deea99bb29b246a246157402e2b, https://si.imgix.net/af9dc26d/uploads/origins/6c0452af-f10a-4d7d-b595-6713194b8962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21892f80f571b9a502f750954e4d7d63 2x, https://si.imgix.net/af9dc26d/uploads/origins/6c0452af-f10a-4d7d-b595-6713194b8962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea28ecaf0ad7436c11b49d78cf784b8f 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nイラストを拝見し、リクエストを送らせていただきました。\n\n私のOC、サトルを描いていただきたいです。\nhttps://x.com/i/status/2008933838156968325\n\nリンク先の資料の服装で、セクシーショットをお願いしたいです。\n恥じらったりせず、自然体な表情でお願いします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tomo_Eokaiteru/works/91", "thumbnail_src": "https://si.imgix.net/25a8961e/uploads/origins/ce5183f0-a563-4da6-a4f5-10440d2fdfd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d6f4d598ea51e268861aece0d43b87", "thumbnail_srcset": "https://si.imgix.net/25a8961e/uploads/origins/ce5183f0-a563-4da6-a4f5-10440d2fdfd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d6f4d598ea51e268861aece0d43b87, https://si.imgix.net/25a8961e/uploads/origins/ce5183f0-a563-4da6-a4f5-10440d2fdfd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7b7a6663fbdbec0fd1290490da22dc0 2x, https://si.imgix.net/25a8961e/uploads/origins/ce5183f0-a563-4da6-a4f5-10440d2fdfd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd4ce2014cc2452d1da2150ac8e5c923 3x", "genre": "art", "nsfw": true, "body": "・キャラ\n葉隠透(僕のヒーローアカデミア)　ヒーロー名:インビジブルガール\nhttps://heroaca.com/character/chara_group01/01-18/\n\n\n・シチュ\n街で敵(ヴィラン)が出現したとの通報がありすぐに駆け付け、少し苦戦するも勝利し、市民の前でピースサインを決める葉隠透\n\n・詳細\n葉隠は本来透明ですが今回は透明化が解除されて全裸の状態でお願いします。葉隠は少し汗をかいている状態です。\n葉隠のポーズは左手を腰に当てて右手を前に出してピースもしくは両手でピースしている状態です。\n\n・表情\n敵を鎮圧し市民を安心させるために、「もう大丈夫だよっ！」と歯を見せてニカッと笑ってる感じです。\n\n・背景\n都会の街中で葉隠の足元で敵が気を失っている状態です。\n敵のデザインなどは適当で構いません。R18絵によく出てくる全裸の男ぐらいでも全然OKです。\n葉隠の後ろではついさっきまで葉隠と敵を大勢の市民が見守っていたような感じです。\n\n・差分\n可能であれば以下の差分をお願いします。\n○自分の透明化が解除されてることに気づいて赤面してる表情(目線は自分の身体の方)\n○以下のイラスト(https://www.pixiv.net/artworks/128876270)のような半透明バージョン\n無理な場合は無くても構いません。\n\n可能であればどうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tomo_Eokaiteru/works/90", "thumbnail_src": "https://si.imgix.net/3f6e3aae/uploads/origins/87f83706-c063-4c92-b5bf-40cb8ef1a8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c411459a1f235177e7c4bfafa62987b3", "thumbnail_srcset": "https://si.imgix.net/3f6e3aae/uploads/origins/87f83706-c063-4c92-b5bf-40cb8ef1a8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c411459a1f235177e7c4bfafa62987b3, https://si.imgix.net/3f6e3aae/uploads/origins/87f83706-c063-4c92-b5bf-40cb8ef1a8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9ba6a0a3469ca1cf4b00eb2968990cc 2x, h