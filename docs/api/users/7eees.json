0&txt=PRIVATE&s=673fa12565fad4aababd696f734aca76 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@7eees/works/17", "thumbnail_src": "https://si.imgix.net/69254e80/uploads/origins/8247f73a-d7bd-409b-b2d5-3966608d383a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf5ec5ad1e02cdef252eac02c092b581", "thumbnail_srcset": "https://si.imgix.net/69254e80/uploads/origins/8247f73a-d7bd-409b-b2d5-3966608d383a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf5ec5ad1e02cdef252eac02c092b581, https://si.imgix.net/69254e80/uploads/origins/8247f73a-d7bd-409b-b2d5-3966608d383a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03cd88758113fa77368421889e1a0098 2x, https://si.imgix.net/69254e80/uploads/origins/8247f73a-d7bd-409b-b2d5-3966608d383a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05b5c2dd7fca2b4fddc9999e4d6e45f0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回の配送とプレゼント、本当にありがとうございました！友人へのプレゼントとしてリクエストさせていただきます。このリクエストからエドナ、アイゼンゼンを描いてください。\n\nhttps://skeb.jp/@7eees/works/9\n\n唇にキスしているところが見たいです。身長差を強調したポーズでお願いします。幸せそうな二人を描いてください。\n\nいつもありがとうございます！\n\nhttps://drive.google.com/drive/folders/1WCe27mI7T7WK5wJPXwXwEFg9XhHWR0RR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@7eees/works/16", "thumbnail_src": "https://si.imgix.net/a6e1a8df/uploads/origins/55e77115-3ccb-4619-abf8-6c4662f3fb72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73a48d2daeab9250e4ed17494ace202c", "thumbnail_srcset": "https://si.imgix.net/a6e1a8df/uploads/origins/55e77115-3ccb-4619-abf8-6c4662f3fb72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73a48d2daeab9250e4ed17494ace202c, https://si.imgix.net/a6e1a8df/uploads/origins/55e77115-3ccb-4619-abf8-6c4662f3fb72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff83f5f42b4ad2370f46c4e3d6ea2b5d 2x, https://si.imgix.net/a6e1a8df/uploads/origins/55e77115-3ccb-4619-abf8-6c4662f3fb72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61199606006154195109a848dfb67af7 3x", "genre": "art", "nsfw": false, "body": "再リクエストしてもよろしいでしょうか？もしダメなら、このリクエストをキャンセルしてください。\n\nこのリクエストのツインテールの女の子を見たいです。\n\nhttps://skeb.jp/@7eees/works/6\nhttps://skeb.jp/@7eees/works/14\nhttps://skeb.jp/@7eees/works/13\n\nクールな黒のスーツを着た彼女を描いてください！パンツにハイヒールではない靴を履いてほしい。ボーイッシュな感じ。全てお任せします！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1f_CdeZQl2bV8pruaL8Z-FYSEjmudfLkr?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@7eees/works/15", "thumbnail_src": "https://si.imgix.net/612eefc1/uploads/origins/e9eab941-8cdc-4f6d-99c7-d68ce9a67ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a5f7cbf3431ec8a8b0b324691594c1c", "thumbnail_srcset": "https://si.imgix.net/612eefc1/uploads/origins/e9eab941-8cdc-4f6d-99c7-d68ce9a67ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a5f7cbf3431ec8a8b0b324691594c1c, https://si.imgix.net/612eefc1/uploads/origins/e9eab941-8cdc-4f6d-99c7-d68ce9a67ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5351b4fd1c46d69d07f5bd3c6e9c9cf4 2x, https://si.imgix.net/612eefc1/uploads/origins/e9eab941-8cdc-4f6d-99c7-d68ce9a67ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=caeaf1f12184361a2543de862d0bf897 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@7eees/works/14", "thumbnail_src": "https://si.imgix.net/885959b2/uploads/origins/b5fe6a97-638e-4eb6-9d44-0124922c902b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d5a56bb8ad9510500a115009708899", "thumbnail_srcset": "https://si.imgix.net/885959b2/uploads/origins/b5fe6a97-638e-4eb6-9d44-0124922c902b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d5a56bb8ad9510500a115009708899, https://si.imgix.net/885959b2/uploads/origins/b5fe6a97-638e-4eb6-9d44-0124922c902b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=385c5ffe9e917810dd965b98e4485af5 2x, https://si.imgix.net/885959b2/uploads/origins/b5fe6a97-638e-4eb6-9d44-0124922c902b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4b5a2d3b94c3691fe62675f17fc970a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、えすさん！お元気ですか？\nhttps://skeb.jp/@7eees/works/6 をリクエストした者です。\n\n友人へのプレゼントに、同じキャラクターで新しいリクエストを送ることにしました。\n\n参考文献 https://imgchest.com/p/na7kebp9q78\n\n選ばれたポーズについて\n(リンク先に参考画像があります。）\n\n左側がエル、右側がヴィクトル。\nエルの唇の口紅は、ヴィクトルにキスをしたためににじんでいる。\n\nエルのみ紫色のマニキュアを塗っている。彼女の服はヴィクトルの服に合わせて変更されたもの（この公式カラーバリエーションには参考文献がある）。\n\nビクターはマスクをしていない。顔に口紅でキスをした跡がある。\n傷跡と赤い目もお忘れなく。\n\nありがとうございました。\n\nhttps://imgchest.com/p/na7kebp9q78", "created_at": "", "completed_at": ""}, {"path": "/@7eees/works/13", "thumbnail_src": "https://si.imgix.net/a355a9e2/uploads/origins/2b5432ad-f549-443f-9250-e021655a55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6939ba5cef1063783ef2cf919d0a93a1", "thumbnail_srcset": "https://si.imgix.net/a355a9e2/uploads/origins/2b5432ad-f549-443f-9250-e021655a55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6939ba5cef1063783ef2cf919d0a93a1, https://si.imgix.net/a355a9e2/uploads/origins/2b5432ad-f549-443f-9250-e021655a55ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10a2bc052ba6665b10d63ce1c7e21791 2x, https://si.imgix.net/a355a9e2/uploads/origins/2b5432ad-f549-443f-9250-e021655a55ba