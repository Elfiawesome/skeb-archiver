f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1063f2159f8b4eddfd24e4a3612edf3d", "thumbnail_srcset": "https://si.imgix.net/6e8b9682/uploads/origins/11362c2b-06d3-4e47-bf79-98aeb03d0f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1063f2159f8b4eddfd24e4a3612edf3d, https://si.imgix.net/6e8b9682/uploads/origins/11362c2b-06d3-4e47-bf79-98aeb03d0f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae04b32616ae8b4d7a88c4a085b4a944 2x, https://si.imgix.net/6e8b9682/uploads/origins/11362c2b-06d3-4e47-bf79-98aeb03d0f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3d344dd0d4caf8e4c2172a45a6befd 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ryou_Tani/works/25", "thumbnail_src": "https://si.imgix.net/3e409521/uploads/origins/2b5eb8c8-5734-4a9b-b0bb-e91858426c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87fc70c76345d6b997b0fa7278217d1b", "thumbnail_srcset": "https://si.imgix.net/3e409521/uploads/origins/2b5eb8c8-5734-4a9b-b0bb-e91858426c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87fc70c76345d6b997b0fa7278217d1b, https://si.imgix.net/3e409521/uploads/origins/2b5eb8c8-5734-4a9b-b0bb-e91858426c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7a9489f39702b8b9cd5a016e2a209d0 2x, https://si.imgix.net/3e409521/uploads/origins/2b5eb8c8-5734-4a9b-b0bb-e91858426c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad12120b36efc0165bb86cfa04f6f222 3x", "genre": "art", "nsfw": false, "body": "ミミロップ♂とミミロップ♀のラブラブイラストをリクエストします！\n\nリクエスト内容♡\n三日月の夜を背景にミミロップ♂がミミロップ♀をお姫様抱っこしてキスし合う\n\nミミロップの詳細\nミミロップ♂♀は共に通常色\n可能であればミミロップ♂♀が見つめ合ってキスVer 共に目を閉じてキスVerと描いてほしいです\n\n両谷さんの以前に描いたミミロップが可愛かったので、また更に美しいミミロップが見たいのでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Ryou_Tani/works/24", "thumbnail_src": "https://si.imgix.net/542deb47/uploads/origins/7d29351f-bb55-40b0-99d8-11a5c1f6b6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d95befbaeed5beec41dc29833927b7b1", "thumbnail_srcset": "https://si.imgix.net/542deb47/uploads/origins/7d29351f-bb55-40b0-99d8-11a5c1f6b6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d95befbaeed5beec41dc29833927b7b1, https://si.imgix.net/542deb47/uploads/origins/7d29351f-bb55-40b0-99d8-11a5c1f6b6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12341d231fc0b6e165162f0025cf1380 2x, https://si.imgix.net/542deb47/uploads/origins/7d29351f-bb55-40b0-99d8-11a5c1f6b6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c22e4d276a5e268c3d9b1238ffd95900 3x", "genre": "comic", "nsfw": true, "body": "サフデカのカミちゃんでフェチい漫画を描いて頂きたいです！\n探索してたらクモの巣に引っかかっちゃって、抜け出そうともがいてもみるみるネバネバ絡みついて逆に動けなくなる\nそうこうしてるうちに巣の主のアリアドスがやってきて糸を吐かれて巣に捕まっちゃう！\nただでさえ動けなくなってるのに追い打ちで更にネバネバ蜘蛛糸かけられて、全身糸巻き付いたりくっついたりでネバネバまみれにされてしまった…\n\nトレジャーハンターだしきっとこういう危ない目にも遭ったことあるのでは…と勝手に想像しちゃった内容なんですが、受けて頂けると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@Ryou_Tani/works/23", "thumbnail_src": "https://si.imgix.net/4e4729d6/uploads/origins/c39242ed-996f-477c-a241-8ba0593d726f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee94b79bf60ac8bb76198b053f69038", "thumbnail_srcset": "https://si.imgix.net/4e4729d6/uploads/origins/c39242ed-996f-477c-a241-8ba0593d726f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee94b79bf60ac8bb76198b053f69038, https://si.imgix.net/4e4729d6/uploads/origins/c39242ed-996f-477c-a241-8ba0593d726f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ff5c2c99047aad88a08b00c275b9a7b 2x, https://si.imgix.net/4e4729d6/uploads/origins/c39242ed-996f-477c-a241-8ba0593d726f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cef9f22252d69b690ebb16e685c20fe 3x", "genre": "comic", "nsfw": true, "body": "以下の流れのコジョフー♀とブイゼル♂の漫画をお願いしたいです。\n・奥手で一歩踏み出せないブイゼルに、業を煮やしたコジョフーがメロメロでブイゼルを誘惑\n・ブイゼルが困惑してるなか、コジョフーが胸(公式通りほぼないか、サフデカのデカヌチャンくらいの控えめなサイズにしてほしいです)を押し付けたり、アソコを擦り付けたりしてどんどんブイゼルの理性を削る\n・理性が切れたブイゼルがコジョフーを押し倒して交尾する\n・交尾後思い通りになってニヤリとしているコジョフー\n\n大まかな流れなので、描きにくい部分等あれば一部設定を削ってもらっても大丈夫です。", "created_at": "", "completed_at": ""}, {"path": "/@Ryou_Tani/works/22", "thumbnail_src": "https://si.imgix.net/e617d304/uploads/origins/b8f4d98b-c684-4802-a95a-82c800c67a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=040fb6b6a1bb281b310ad2c449bc0d80", "thumbnail_srcset": "https://si.imgix.net/e617d304/uploads/origins/b8f4d98b-c684-4802-a95a-82c800c67a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=040fb6b6a1bb281b310ad2c449bc0d80, https://si.imgix.net/e617d304/uploads/origins/b8f4d98b-c684-4802-a95a-82c800c67a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f36e12405d20f229648aebf636f9340 2x, https://si.imgix.net/e617d304/uploads/origins/b8f4d98b-c684-4802-a95a-82c800c67a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87247d0f9e621235ca9c2581cc344336 3x", "genre": "comic", "nsfw": true, "body": "TF ポケモン　少年→デンリュウ♀ \n\n［リクエスト］相棒のデンリュウと戯れていたら突然少年がデンリュウ♀になって相棒が発情して卵作りをしてしまう\n\n［シチュ］相棒と戯れている時に突然デンリュウ♀になってしまい相棒が発情。相棒の言葉が聴き取れるようになり相棒が元少年にすごく可愛いと言いながら卵作りをして元少年は抵抗してても(服が破れるか電気で焦げる)服が破損、相棒の力が強かった為なす術もなく受け入れちゃって気づけば事後の表情で周りに産卵していたシチュ\n\n元少年デンリュウ♀のエッチな場面の色々なエッチな表情が見たいです！", "created_at": "", "completed_at": ""}, {"path": "/@Ryou_Tani/works/21", "thumbnail_src": "https://si.imgix.net/722d