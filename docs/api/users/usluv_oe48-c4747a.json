7f603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47966bdf489d54bbde321bedfc49eab, https://si.imgix.net/000b62c3/uploads/origins/7d10135e-5769-42ea-842d-20319547f603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdfb87fe2454edbc14127af8fc727ec4 2x, https://si.imgix.net/000b62c3/uploads/origins/7d10135e-5769-42ea-842d-20319547f603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6880868fb45895583848bd85b8e660d0 3x", "genre": "art", "nsfw": true, "body": "※諸事情によりリクエスト再送致しました。\n\nhttps://skeb.jp/@usluv_oe48/works/11\n以前こちらの作品をリクエストした者です。その節はお世話になりました。\nまたリクエストをお願いしたいです。もしNGな点がありましたら、遠慮なくキャンセルしてください。\nどうかよろしくお願いします。\n\n【作品】麻雀物語\n\n【キャラ】マシロ\nhttps://www.heiwanet.co.jp/sozai/cr_mahjong/pics/chara05.jpg\nhttps://www.heiwanet.co.jp/latest/cr_mahjong/chara05.html\n\n【シチュ】\n雀王決定戦に負けてしまった代償として、竿役にエッチなことをされる感じでお願いします。\n\n以下の要素を入れて欲しいですが、その他は好きなように、描きやすいように描いて頂ければと思います。\n・ニラマレ\n・着衣(胸の服だけ、はだけておっぱいが出ている)\n・両手拘束\n・口に大きめのガムテープで猿轡\n\nまた、前回のような台詞類を入れて頂きたいです。\n\n【金額の範囲内で可能であればお願いしたいシチュ】\nhttps://skeb.jp/@usluv_oe48/works/10\nこちらの作品のように、画面2分割で、片方のコマは上記のシチュを、もう片方は布に染み込んだ媚薬を背後から嗅がされてしまうというコマを描いて頂きたいです。\n金額的に難しい、もしくはNGなシチュでしたら、こちらは見なかったことにしてください。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@usluv_oe48/works/15", "thumbnail_src": "https://si.imgix.net/e1ebc009/uploads/origins/b8ff27df-080e-4198-a00a-82d3da02ef0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9b636eec2ce8cb3caf645eeaa72214", "thumbnail_srcset": "https://si.imgix.net/e1ebc009/uploads/origins/b8ff27df-080e-4198-a00a-82d3da02ef0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9b636eec2ce8cb3caf645eeaa72214, https://si.imgix.net/e1ebc009/uploads/origins/b8ff27df-080e-4198-a00a-82d3da02ef0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a59a4f30a2d004070b0a3a088b332d3 2x, https://si.imgix.net/e1ebc009/uploads/origins/b8ff27df-08