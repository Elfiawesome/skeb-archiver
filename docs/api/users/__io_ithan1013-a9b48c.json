か？\n\n男は女にとても愛情深いのですが、からかうのも好きです。女の子は愛情表現が苦手で無表情なことが多いのですが、内心では恋人に甘えられるのが好き。ちょっと \"老夫婦 \"のような関係ですね。\n\n描き方は自由！元の服装で描いてもいいし、好きなように着替えてもいい。できれば二人の仲の良さが伝わるようなシチュエーションを希望します！詳細はお任せします。ありがとうございました！\n\nhttps://drive.google.com/drive/u/1/folders/12CFRqB0PS9HWkiQ6J-93EzVBfwrjxGcX", "created_at": "", "completed_at": ""}, {"path": "/@__io_ithan1013/works/240", "thumbnail_src": "https://si.imgix.net/99a3cc5c/uploads/origins/be0de8e8-5b4f-4d0e-a97a-15ff072a6203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c603af1f0284cbbe44d30ab7f4dc9ba", "thumbnail_srcset": "https://si.imgix.net/99a3cc5c/uploads/origins/be0de8e8-5b4f-4d0e-a97a-15ff072a6203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c603af1f0284cbbe44d30ab7f4dc9ba, https://si.imgix.net/99a3cc5c/uploads/origins/be0de8e8-5b4f-4d0e-a97a-15ff072a6203?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=676e064845e1c99441ee8c78b9226ad4 2x, https://si.imgix.net/99a3cc5c/uploads/origins/be0de8e8-5b4f-4d0e-a97a-15ff072a6203?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10b316b2f0e6eaa8f1594f2efd998118 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@__io_ithan1013/works/239", "thumbnail_src": "https://si.imgix.net/40486883/uploads/origins/f469dcb2-5a7d-4e6c-8695-237192fb3b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a3b8fd5d9fd174b3ced286a14f66f4c", "thumbnail_srcset": "https://si.imgix.net/40486883/uploads/origins/f469dcb2-5a7d-4e6c-8695-237192fb3b73?bg=%23fff&auto=format%