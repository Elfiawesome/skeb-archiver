21b-4e9c5f2b17e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be08db33e40d860c693ed720ca440ac5", "thumbnail_srcset": "https://si.imgix.net/1e5cc6ac/uploads/origins/493048c9-4581-4cd4-b21b-4e9c5f2b17e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be08db33e40d860c693ed720ca440ac5, https://si.imgix.net/1e5cc6ac/uploads/origins/493048c9-4581-4cd4-b21b-4e9c5f2b17e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8918a4c7e19b1031dd7361a007edba9 2x, https://si.imgix.net/1e5cc6ac/uploads/origins/493048c9-4581-4cd4-b21b-4e9c5f2b17e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b7e936d84cf0b0a1e67b3e8fb312e6e 3x", "genre": "art", "nsfw": true, "body": "ろくろさん、絵がかっこよくて萌えます...。今回は、@tado_vtという、切ないロリロボット猫娘の絵をお願いしたいです。普通ロボットには見えないけど、ロボットなんです！どんな理由であれ、傷ついたり擦れたりしている彼女を、修理するために開けてほしい。ロボットガールの中に何が入っているか想像してくれたら、何でもいいよ！パイプとかオイルとか？\n\nかわいくて、描いていて楽しいものなら何でもOKです！\n\nご検討ありがとうございました：\n\nhttps://imgur.com/a/niZApLI", "created_at": "", "completed_at": ""}, {"path": "/@nXGkR6l2yiEPD4o/works/48", "thumbnail_src": "https://si.imgix.net/1f93b2fc/uploads/origins/f70922c8-4ffd-4414-b65e-572e8f26e0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cda5fcafc09c2b40ad6fdbabb40f1e3", "thumbnail_srcset": "https://si.imgix.net/1f93b2fc/uploads/origins/f70922c8-4ffd-4414-b65e-572e8f26e0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cda5fcafc09c2b40ad6fdbabb40f1e3, https://si.imgix.net/1f93b2fc/uploads/origins/f70922c8-4ffd-4414-b65e-572e8f26e0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b8d3b917020182a7de2b1c30e47cb4 2x, https://si.imgix.net/1f93b2fc/uploads/origins/f70922c8-4ffd-4414-b65e-572e8f26e0a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b9e3b046ee5c63e1dd3a18ff596e445 3x", "genre": "art", "nsfw": false, "body": "こんにちは。2人のイラストが欲しいのですが、1人は高い位置でポニーテールをしている女性の服を着た男性で、もう1人は女性です。お気軽に描いてください❤️服はどれでもいいですし、複雑だったら自由に描いてもいいです。\n\n服1\nhttps://x.com/yukorarano/status/1889133832244523495?s=46\n服2\nhttps://x.com/yukorarano/status/1958895421645828147?s=46", "created_at": "", "completed_at": ""}, {"path": "/@nXGkR6l2yiEPD4o/works/47", "thumbnail_src": "https://si.imgix.net/ac9b7d9d/uploads/origins/c1bec5fa-9fea-4c3d-8874-1edf8fb2f557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db02f45394cfab6ddb5328422be16c5", "thumbnail_srcset": "https://si.imgix.net/ac9b7d9d/uploads/origins/c1bec5fa-9fea-4c3d-8874-1edf8fb2f557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db02f45394cfab6ddb5328422be16c5, https://si.imgix.net/ac9b7d9d/uploads/origins/c1bec5fa-9fea-4c3d-8874-1edf8fb2f557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e92e698543bad5130b5ac6843d519395 2x, https://si.imgix.net/ac9b7d9d/uploads/origins/c1bec5fa-9fea-4c3d-8874-1edf8fb2f557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b66046cd6b0293f33a37b331e7f76f9 3x", "genre": "art", "nsfw": false, "body": "はじめまして、メロンフィッシュと申します。\n\n数月前にミスキーであなたのイラストを拝見し、特に「Vaporwave」と「Windows XP」っぽいなかわいい絵柄好きから、最近に新しいリクエストを送りさせていただくことを考えていました。\n\nよろしければ、私のオリキャラ「ヒイデット」のイラストをお願いいたします。\n\nヒイデットちゃんは、瑠璃鶇みたいなキメラの要素があるの145センチ(角を除く)の恥ずかしがり屋な夢渡りです。スケッチブックで自然な場所を描くこと、一本気が必要状況に遭うことを好き。\n\n【リクエスト内容】\n\nシチュエーションは、ヒイデットちゃんは「Windows Vista」と「Frutiger Aero」みたいな環境にいって「ペイント」のウィンドウの上に座っていて、楽しみな気持ちで壁紙の環境にスケッチブックで写生しているながら、ウィンドウの中のイメージがスケッチブックの現在の絵を映し出しています。\n\n作品にヒイデットちゃんの主な衣装を含まれて欲しいですが、ポーズ、構図、他の詳細はだいたいあなた次第。\n\n【キャラ参考資料】\n\nhttps://imgur.com/a/14FRaAg\n\nhttps://skeb.jp/@_kirinoha_/works/91\n\n【環境参考資料】\n\nhttps://officejapan.one/200/\n\nhttps://never-obsolete.tumblr.com/post/629993315199221760/windows-vista-paint\n\n依頼の料金が不足場合は、再送要請を送ってくれるのが大丈夫です。ヒイデットちゃんのデザインがちょっと複雑かもしれませんが、ご検討のほど何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nXGkR6l2yiEPD4o/works/46", "thumbnail_src": 