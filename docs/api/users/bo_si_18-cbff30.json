e=30&txt=PRIVATE&s=13dd4fad34ae2a69d4ab6785be06c7fa 2x, https://si.imgix.net/ac662c26/uploads/origins/d1cd3541-8ba8-49ca-9300-ab415df5abb1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6edce91a5088d31f19669cc042dee4fb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bo_si_18/works/20", "thumbnail_src": "https://si.imgix.net/77d4bd59/uploads/origins/de93a6d4-e044-485d-a13e-6cac8a18c168?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=25303ccd2efd240a23f3a2fdcaa22f5e", "thumbnail_srcset": "https://si.imgix.net/77d4bd59/uploads/origins/de93a6d4-e044-485d-a13e-6cac8a18c168?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=25303ccd2efd240a23f3a2fdcaa22f5e, https://si.imgix.net/77d4bd59/uploads/origins/de93a6d4-e044-485d-a13e-6cac8a18c168?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f9e6e71806fe6107d6cf318096822c5 2x, https://si.imgix.net/77d4bd59/uploads/origins/de93a6d4-e044-485d-a13e-6cac8a18c168?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=2410d38c630c5c3a6bf5e38b0e9af410 3x", "genre": "art", "nsfw": true, "body": "ぼし先生に初めてリクエストさせていただきます。妊娠した美遊・エーデルフェルトちゃんをお願いします！\nhttps://bo-si-18.fanbox.cc/posts/3523129\nこちらの素晴らしい３人のように全身のイラストで拝見できると嬉しいです。\nいつもの魔法少女コスで妊娠した姿（お腹の大きさは臨月だと嬉しいです）と\n可能なら裸差分、悪堕ち差分などあると大変助かります。\n「しょうがないな・・・」困り顔で頬を赤らめている、洗脳ハイライト無しの目も見たいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bo_si_18/works/19", "thumbnail_src": "https://si.imgix.net/fb7cbefd/uploads/origins/f0c9c082-7bf2-4e25-983e-59fec95f9295?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=abc3a236aa0365434bf1b029dd273710", "thumbnail_srcset": "https://si.imgix.net/fb7cbefd/uploads/origins/f0c9c082-7bf2-4e25-983e-59fec95f9295?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=abc3a236aa0365434bf1b029dd273710, https://si.imgix.net/fb7cbefd/uploads/origins/f0c9c082-7bf2-4e25-983e-59fec95f9295?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=728a080c7d80443519cfb0633673c654 2x, https://si.imgix.net/fb7cbefd/uploads/origins/f0c9c082-7bf2-4e25-983e-59fec95f9295?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=aad1b9158a0c891f2f68000ea650578f 3x", "genre": "art", "nsfw": true, "body": "ぼし先生初めまして。\nTwitterで先生の絵をお見かけして以来、是非依頼したいと思っておりました。\n版権絵やその他でＮＧがありましたら申し訳ありません、その際は却下してください。\n\n●依頼キャラについて\n　〇ＦＧＯ　茨木童子　第１再臨カードイラストの立ちポーズ\n　　https://drive.google.com/drive/folders/16tA4k9CTxsQqbpzdWnl7FQHugxPZxArb?usp=share_link\n　　上記グーグルドライブ内フォルダに資料一式を入れております。\n　　一部資料で武器を持っていますが、描かなくて大丈夫です。\n\n●アングル、構図など\n　〇前記の状態で右斜め前ローアングルから見上げ、下着（ふんどし）がチラ見えするような構図。\n　　ふんどしの前垂れ部分は長さが短め。\n　　布の横幅も全体に短めの設定で。\n　　着物の裾の部分でふんどしの前部分は見えないが、股間からお尻の方くらいまでは見えている感じです。\n　　ふんどしの参考ＵＲＬ\n　　http://hundoshitahusagi.web.fc2.com/basis.html\n　　六尺か越中の描きやすい方で描いてください。\n\n　　下着の見え方はぼし先生の作品の\n　　https://skeb.jp/@bo_si_18/works/15\n　　立っている方の子に近いですが、距離はもっと近くからの描写でお願いします。\n　　\n　　アングルはこの方の作品がイメージに近い感じです。\n　　https://skeb.jp/@sou_mikagami/works/24\n　\n　〇実際のふんどしは長方形の布が股間でクシャっと潰れている感じだと思いますが、形状は現代のパンツ風にアレンジしたり、ハイレグのレオタード風に描写してください。\n　　若干しわが出て布感がある様にお願いします。\n　\n　〇左脚は膝下からは描かなくても大丈夫ですが、先生の描きやすさを優先してください、足先から全部描いていただいても大丈夫です。\n\n●絵のイメージ\n　〇茨木ちゃんの立ち姿をマスターが右斜め前下から見上げており、茨木ちゃんもそれに気付いて顔と視線をそちらへ向けている（仏頂面で）。\n　〇見られている事に気づいて怒る、恥ずかしがる、その後脱がされて色々されてしまう、という状況。\n　　背景は特に無くて構いません、真っ白でも大丈夫です。\n●希望差分等\n　〇表情\n　　基本は仏頂面。怒っている、にんまり笑っている、恥ずかしくて困っている。ドライブ内に資料があります。\n　　恥ずかしくて涙目、恍惚としてよだれが垂れている等→こちらは先生のイメージでお願いします。\n\n　〇下着\n　　ふんどし　はいたままでエッチな染みが出来ている。\n　　　　　　　お股の部分を横にずらして局部が全部見えている\n　　　　　　　お股の部分が下に緩んで局部が見えてしまっている。\n　　　　　　　緩んだ布が完全に外れてしまった直後で丸見え。ふんどしにおしっこの染みを付けてそれがこちらに見えてる様にお願いします。\n　　\n　　パンツ（現代風のパンツで白、ワンポイントのリボンあり）　はいたままでエッチな染みが出来ている。　　　　　クロッチ部分を横にずらして局部が全部見えている。\n　　　　　左脚は完全に脱げて右太腿にパンツがかかっている（逆に左の太腿部分でも大丈夫です、絵の描きやすさに合わせて下さい）クロッチが外側でおしっこの染みが見えているようにお願いします。　\n\n　〇着物\n　　立ちポーズの右手がちょうど腰のところにあるので、右手で裾をたくし上げて下着がほぼ丸見えになっている状態（右手がグーなのでそこに裾部分を握っているように見えるようにしていただければと思います）。\n　　胸の白い布部分を下にめくって下して、胸が見えている状態。\n\n　〇局部描写（消しは承知のうえで依頼します）　スジ、くぱぁ（クリ描写あり）、半透明の棒を挿入状態（男性の体の描写は無しで）。他、ぼし先生の表現で。\n　　　　　　　愛液、潮吹き、おしっこ。\n　　　　　　　陰毛は無しと、スジの上の方に若干ちょろっと生えかけ（髪の色に合わせて下さい）。\n\n●その他備考　\n　〇体形描写　華奢な感じで、脂肪少なめ、胸は先生の描かれているクロエくらいのささやかなサイズでお願いします。\n\n　〇着物の柄、手足の刺青など　茨木ちゃんの立体物が出ないのはこの辺りの難しさ、コストがあるからとの考察も目にします。振袖の部分など難しい所は描写範囲から外したり、模様の一部は必要に応じて省略して下さい。\n\n　〇目　可愛いだけじゃなく強気なかっこよさもある子だと思うので難しいと思いますが、先生のイメージで描いてください。\n\n依頼内容は以上ですが、全体として先生のやりやすさを優先でお願いします。\nツイートでは指定が細かい方がやりやすいとの事でしたので、書いていたらいつの間にかこんな文章になってしまいました・・・\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/16tA4k9CTxsQqbpzdWnl7FQHugxPZxArb?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@bo_si_18/works/18", "thumbnail_src": "https://si.imgix.net/d2618272/uploads/origins/477c2821-1dbb-4b30-a6d8-114f6869c903?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dbd7a9fb926f94b65a3fd09b6068f8a", "thumbnail_srcset": "https://si.imgix.net/d2618272/uploads/origins/477c2821-1dbb-4b30-a6d8-114f6869c903?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dbd7a9fb926f94b65a3fd09b6068f8a, https://si.imgix.net/d2618272/uploads/origins/477c2821-1dbb-4b30-a6d8-114f6869c903?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e9acb04fecdc7bf96b3efc96885936e 2x, https://si.imgix.net/d2618272/uploads/origins/477c2821-1dbb-4b30-a6d8-114f6869c903?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cee256e63eb2d5fc78cc6a0f4c65409 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bo_si_18/works/17", "thu