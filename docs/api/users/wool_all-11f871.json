53d4/uploads/origins/0e57267a-7ecb-490e-ac16-a42359bfb32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=481e9c1f20d0d0be1d617a86055adce3", "thumbnail_srcset": "https://si.imgix.net/458553d4/uploads/origins/0e57267a-7ecb-490e-ac16-a42359bfb32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=481e9c1f20d0d0be1d617a86055adce3, https://si.imgix.net/458553d4/uploads/origins/0e57267a-7ecb-490e-ac16-a42359bfb32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b980402fecaee18ef8432268afd02cd 2x, https://si.imgix.net/458553d4/uploads/origins/0e57267a-7ecb-490e-ac16-a42359bfb32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d8662afc8689052a2f7ec94c2b51576 3x", "genre": "art", "nsfw": false, "body": "エチェ先生、はじめまして！\n先生の描いたけもみみがとても好きです！私のOCをぜひ描いていただきたく今回ご依頼させていただきました。\n\n「詳細」\n原型はホッキョクギツネで、目が黄色と青色です。\nもふもふの耳と尻尾も描いていただけると嬉しいです！\n\n資料内の衣装は、先生が自由に描いて大丈夫です♪ かわいらしさを出すのが一番です！\nPSDファイルを提供していただけると嬉しいです。\n\n「参考資料」\nhttps://drive.google.com/drive/folders/1DVbWSybIpOEdO2oM83IkS_9BAfqLkdJ_?usp=sharing\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@wool_all/works/1", "thumbnail_src": "https://si.imgix.net/8a27d7da/uploads/origins/ab9cc1c0-abe4-418c-b216-7dfaf45c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd965a87b9bc9ea53c06d8a0663b1509", "thumbnail_srcset": "https://si.imgix.net/8a27d7da/uploads/origins/ab9cc1c0-abe4-418c-b216-7dfaf45c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd965a87b9bc9ea53c06d8a0663b1509, https://si.imgix.net/8a27d7da/uploads/origins/ab9cc1c0-abe4-418c-b216-7dfaf45c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d343a649dd76182842e91167aa4ebaa 2x, https://si.imgix.net/8a27d7da/uploads/origins/ab9cc1c0-abe4-418c-b216-7dfaf45c9f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4e9ac95c1706e472e9e2bd98982e761 3x", "genre": "art", "nsfw": false, "body": "はじめまして！ずっと温かくて可愛い雰囲気の絵柄が大好きで、今回ぜひお願いしたくリクエストに来ました。\n\n二人のキャラクターを描いていただきたいのですが、まずはこちらの依頼で私のOCをお願いしたいです。三無系ロリの子です。\n\nデザインについては、私の頭がからっぽなので……全部お任せしたいです！  \nもし可能でしたら、シンプルなワンピースに少し可愛いアレンジを加えて、全体が単調にならないようにしていただけるととても嬉しいです。\n\nもう一人のキャラクターは、別のリクエストで改めて送らせていただきます。\n\nどうぞよろしくお願いします！\n\nhttps://drive.google.com/file/d/1zfI_FTYHr1pi6GgbCKI-r-q5091nlxdA/view?usp=drivesdk", "created_at": "", "completed_at": ""}]}