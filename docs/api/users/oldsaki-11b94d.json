0921/uploads/origins/50f176c0-735d-4edf-a743-9232f7ba8569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e7855723a87e285b5fc631d28a84ada", "thumbnail_srcset": "https://si.imgix.net/45ad0921/uploads/origins/50f176c0-735d-4edf-a743-9232f7ba8569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e7855723a87e285b5fc631d28a84ada, https://si.imgix.net/45ad0921/uploads/origins/50f176c0-735d-4edf-a743-9232f7ba8569?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41ca53387d25038812e26dc1ba36f4f4 2x, https://si.imgix.net/45ad0921/uploads/origins/50f176c0-735d-4edf-a743-9232f7ba8569?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21ca81d17a8d6f036915d2602e045b5b 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。湯由ゆのみです。\n私のVRChatのアバターのしなのちゃんを描いていただきたいです。\nボディストッキング+ビキニの組み合わせで、おなか周りが見えるような構図でお願いします。\nご検討を宜しくお願いします！\n\n髪型\nhttps://booth.pm/ja/items/6141043\n\n衣装\nジャケット+ビキニ+サンバイザー+サンダル\nhttps://booth.pm/ja/items/5963998\nハーフパンツ\nhttps://booth.pm/ja/items/6111870\nボディストッキング\nhttps://booth.pm/ja/items/6262686\n\nhttps://drive.google.com/drive/folders/1eOnE7gvMhVBYrcHRW1qI2jMQBsHs-phU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oldsaki/works/22", "thumbnail_src": "https://si.imgix.net/718f9cef/uploads/origins/46c7c8a2-e284-441f-9c1c-c26e51324f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99c19e3aaf2af98367ba7386e93bdc46", "thumbnail_srcset": "https://si.imgix.net/718f9cef/uploads/origins/46c7c8a2-e284-441f-9c1c-c26e51324f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99c19e3aaf2af98367ba7386e93bdc46, https://si.imgix.net/718f9cef/uploads/origins/46c7c8a2-e284-441f-9c1c-c26e51324f38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f0ca2f9a4c16524054fdd493bcada27 2x, https://si.imgix.net/718f9cef/uploads/origins/46c7c8a2-e284-441f-9c1c-c26e51324f38?bg=%23fff&a