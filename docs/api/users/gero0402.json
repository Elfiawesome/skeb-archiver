ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea73c189130876c86bdb9a504a3fea98 2x, https://si.imgix.net/302fd639/uploads/origins/93abf13d-1bf7-4bc5-ad50-73b414afc803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f899b32fc75a6ccdf031c51b542e10ca 3x", "genre": "art", "nsfw": false, "body": "みきさんお世話になります！\n今回は、僕自身「葛飾みーわん」の、「必殺技を放っている姿」を描いて欲しいと思いご依頼させていただきます！\nパンチ、キック、ビームなどどれでもいいので、みきさんが想像する僕が必殺技を撃つ姿を描いてもらえればありがたいです。\n背景ありバージョンと、アイコンやサムネイル等に使える透過バージョンがあれば助かります！\nぜひ、みきさんの好きな絵柄で楽しく僕を描いてくれると嬉しいです！\nよろしくお願いします！🐙✨\n\nhttps://twitter.com/mi_wan_Me_One", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/13", "thumbnail_src": "https://si.imgix.net/0fdc3a0e/uploads/origins/360bc466-20fd-4f5f-84b9-7842149bacf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed9d50c35b1b664ea8c14eb1394cdf3e", "thumbnail_srcset": "https://si.imgix.net/0fdc3a0e/uploads/origins/360bc466-20fd-4f5f-84b9-7842149bacf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed9d50c35b1b664ea8c14eb1394cdf3e, https://si.imgix.net/0fdc3a0e/uploads/origins/360bc466-20fd-4f5f-84b9-7842149bacf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5368bf0c4fea72b333e63409d883ca46 2x, https://si.imgix.net/0fdc3a0e/uploads/origins/360bc466-20fd-4f5f-84b9-7842149bacf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38b15d4bcef9a92aff748762371f99f1 3x", "genre": "art", "nsfw": false, "body": "あの超絶ボーイッシュ美少女スーツアクターフェチの弐下呂未来さんに私、Ninomaeの立ち絵をぜひお願いしたく思いリクエストを送りました！\n\n\nかっこよくしていただければなんでもお好きなようにお願いします🙏", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/12", "thumbnail_src": "https://si.imgix.net/9961e525/uploads/origins/0daaa869-64b3-4993-8fdb-5dda54646aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78e5e0a9e3c55c951bf341fe431dea4", "thumbnail_srcset": "https://si.imgix.net/9961e525/uploads/origins/0daaa869-64b3-4993-8fdb-5dda54646aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78e5e0a9e3c55c951bf341fe431dea4, https://si.imgix.net/9961e525/uploads/origins/0daaa869-64b3-4993-8fdb-5dda54646aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3a23398942972d28d15b251f051323f 2x, https://si.imgix.net/9961e525/uploads/origins/0daaa869-64b3-4993-8fdb-5dda54646aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bc93423bfe2c6c06379a1f15fbfd6ff 3x", "genre": "art", "nsfw": false, "body": "初めまして！Vtuberとして活動している霧嶋毒兎(きりしまどくと)と言います！\n弐下呂未来様の描くキャラのイラストが可愛くて、お声かけさていただきました！\nイラストの依頼をお願いしたいです。\n\n↓以下依頼概要↓\n服装：通常の服装\nポーズ：お任せします！(ギザギザの歯を見えるようにして描いて下さるとありがたいです)\n雰囲気：いたずら好きなかわいい幼女みたいな雰囲気で描いてくれるとありがたいです！\nイラスト形式：psd(キャラ透過を使用したいのでキャラと背景は別レイヤーにしていただけると幸いです)\nイラスト利用範囲予定：配信画面に掲載、配信や動画などのサムネ画像などに使用、ツイッターなどSNSへの投稿。\n\n↓以下プロフ↓\n別次元の魔界からやってきた、毒を操る兎の魔物です！かわいい幼女です(´◉ᾥ◉`)ノ\n何卒よろしくお願いいたします！\n\nhttps://twitter.com/dokutokudokuto/status/1514429561303625728?s=20&t=aFs6UX8waq4gmbJXFQ7tkw\n\nhttps://x.com/dokutokudokuto/status/1694669102563082600?s=20", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/11", "thumbnail_src": "https://si.imgix.net/f2ed2104/uploads/origins/849ba3e8-b121-41ed-a901-1885e8598f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=864d13e1b545e4af9f83a3aa08dff2e3", "thumbnail_srcset": "https://si.imgix.net/f2ed2104/uploads/origins/849ba3e8-b121-41ed-a901-1885e8598f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=864d13e1b545e4af9f83a3aa08dff2e3, https://si.imgix.net/f2ed2104/uploads/origins/849ba3e8-b121-41ed-a901-1885e8598f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a3cef01ebb7922e0b740413da57b597 2x, https://si.imgix.net/f2ed2104/uploads/origins/849ba3e8-b121-41ed-a901-1885e8598f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e8d5664640e50685dac11fc4c9ab42e 3x", "genre": "art", "nsfw": false, "body": "お世話になります！\n今回、私自身である「葛飾みーわん」のイラスト描いて欲しいと思い依頼させていただきました！\nゲームコントローラーを持ってゲームを楽しんでいる僕の姿を描いてくれると嬉しいです。\nYouTubeのサムネイルに使える背景を透過したものがあれば幸いです。\n資料URLの固定コメントに僕の姿の資料があるのでご参照ください。\nよろしくお願いします！\n\nhttps://twitter.com/mi_wan_Me_One", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/10", "thumbnail_src": "https://si.imgix.net/c684003d/uploads/origins/02d0cd50-8329-42ce-9675-b0adf0771239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e1dd162ad00df34927e4445e533fa9", "thumbnail_srcset": "https://si.imgix.net/c684003d/uploads/origins/02d0cd50-8329-42ce-9675-b0adf0771239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e1dd162ad00df34927e4445e533fa9, https://si.imgix.net/c684003d/uploads/origins/02d0cd50-8329-42ce-9675-b0adf0771239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4882d2c60e82a9ca41771aa882d1eb82 2x, https://si.imgix.net/c684003d/uploads/origins/02d0cd50-8329-42ce-9675-b0adf0771239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99e3138be56a797dd357a84faed2830f 3x", "genre": "art", "nsfw": false, "body": "以前、アイコンを描いて頂きましたが登山帽子をかぶっているヤマパンダのアイコンも描いて頂きたい。\n\n①登山帽子はハットがいいかなと思っております。形のサンプルは資料URLに\n②背景は山っぽく茶色系がいいかなと思いますが、色のバランスが悪かったら変更して頂いて構いません。\n\nhttps://www.ac-illust.com/main/detail.php?id=1499380", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/9", "thumbnail_src": "https://si.imgix.net/ede7709d/uploads/outputs/4ab4bccd-c92e-4a97-a438-d5d4b6385209?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b3ddcd19b4ec1cfe8d938047ef70a933", "thumbnail_srcset": "https://si.imgix.net/ede7709d/uploads/outputs/4ab4bccd-c92e-4a97-a438-d5d4b6385209?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b3ddcd19b4ec1cfe8d938047ef70a933, https://si.imgix.net/ede7709d/uploads/outputs/4ab4bccd-c92e-4a97-a438-d5d4b6385209?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=53c3267391bb27f50338ffef79bcef44 2x, https://si.imgix.net/ede7709d/uploads/outputs/4ab4bccd-c92e-4a97-a438-d5d4b6385209?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d063db14591ee4919673d084d68fb28 3x", "genre": "video", "nsfw": false, "body": "ボブ前髪あり\n髪:薄いピンク\n目:紫\n首輪付ける\n黒白メイド服\n胸から上のアイコン風\nあざと可愛いポーズ\nでよろしくお願いします😊", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/8", "thumbnail_src": "https://si.imgix.net/e4bf5dbf/uploads/origins/cb91c807-ad15-44b4-a7f0-4364cc10fdcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=678626f71a9f75bb3b90a38ce8d2b506", "thumbnail_srcset": "https://si.imgix.net/e4bf5dbf/uploads/origins/cb91c807-ad15-44b4-a7f0-4364cc10fdcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=678626f71a9f75bb3b90a38ce8d2b506, https://si.imgix.net/e4bf5dbf/uploads/origins/cb91c807-ad15-44b4-a7f0-4364cc10fdcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af304f620785ceee8c52eb3ae8c9e25f 2x, https://si.imgix.net/e4bf5dbf/uploads/origins/cb91c807-ad15-44b4-a7f0-4364cc10fdcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f5c76990e26cf21711de79b444340a2 3x", "genre": "art", "nsfw": false, "body": "・以下２点のイラストを依頼させて頂きたい\n①Twitterのヘッダー\n②アイコン\n・絵のイメージ\n①Twitterのヘッダー：趣味が登山なので、リュックを背負ったパンダ(生茶パンダに似た感じ)が、山へ向かって進んでるイメージです。(凄い雑で描いたのですが、Twitterで　@yamapan_r　みたいな・・・山は槍ヶ岳をイメージしてます)\n②アイコン：以前配信で描いて頂きましたが、左向き(Twitterで　@yamapan03　みたいな)\n※資料URLは好きな山の写真が載っているサイトです。\n\nhttps://www.yamareco.com/modules/yamainfo/ptinfo.php?ptid=68", "created_at": "", "completed_at": ""}, {"path": "/@gero0402/works/7", "thumbnail_src": "https://si.imgix.net/8bf1dfb8/uploads/origins/bd90083e-a9d8-4ef3-831b-4d040a7d6bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1504a9ef452c758c4755dcab66baf08", "thumbnail_srcset": "https://si.imgix.net/8bf1dfb8/uploads/origins/bd90083e-a9d8-4ef3-831b-4d040a7d6