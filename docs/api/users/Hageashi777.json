fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e65cb078201f9c8a59e05c9313c0f031 3x", "genre": "art", "nsfw": true, "body": "6Pのモノクロ作品。5Pはブルーアーカイブの木崎と馬、1Pはブルーアーカイブの俊と馬。", "created_at": "", "completed_at": ""}, {"path": "/@Hageashi777/works/14", "thumbnail_src": "https://si.imgix.net/947f1876/uploads/origins/c4a4be0e-2305-4d4c-a684-66059d5105af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05958c2d68a174d164b5cf2b2cd20216", "thumbnail_srcset": "https://si.imgix.net/947f1876/uploads/origins/c4a4be0e-2305-4d4c-a684-66059d5105af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05958c2d68a174d164b5cf2b2cd20216, https://si.imgix.net/947f1876/uploads/origins/c4a4be0e-2305-4d4c-a684-66059d5105af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b173e50c171b8002466707519d62b885 2x, https://si.imgix.net/947f1876/uploads/origins/c4a4be0e-2305-4d4c-a684-66059d5105af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79e049315596fe7682f06272f7607ce5 3x", "genre": "art", "nsfw": true, "body": "ハケアシ先生、こんにちは。キサキの動物なかよしを見るので、先生に依頼させて欲しいです。\n①キャラ\nキャラはブルアカの空崎ヒナと小鳥遊ホシノです。二人は全裸で名前付けた首輪が付いてはいいと思います。でもホシノの白い靴下はそのまましておいてください。\n②構図\nhttps://www.pixiv.net/artworks/70764281のような四つん這いの姿勢で交尾結合で膣内射精を受け止めている構図でお願いします。でも場所とか表情とか違います、シチュの部分に説明します。\n③シチュ\nある路地裏で二人は楽しそうに異なった犬と交尾結合して精液溢れてというシーンです（アヘ顔なし）。また、交尾断面図と受精表現図もついてください。\n④差分\nボテ腹差分もお願いします。二人のボテ腹の上に複数のヘイローがついて乳首先に母乳垂れ表現を描いてください（黒乳首なし）。\n⑤シチュ以外の要望\nもし良かったら、https://www.pixiv.net/artworks/124245178のような授乳差分もお願いします。でも忙しいならなしでも大丈夫です。\n以上、どうかよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Hageashi777/works/13", "thumbnail_src": "https://si.imgix.net/cf5b052f/uploads/origins/bd82bfd2-31a1-4155-8c33-1070dd13efac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=221a25d788e2c97ff1a3f28cf34e28a