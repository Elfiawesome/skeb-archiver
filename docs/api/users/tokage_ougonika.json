8778-882cf3eb742c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f0f9810dd34ef15da5a1d7492b43303 2x, https://si.imgix.net/67135ec1/uploads/origins/701d262c-1595-42ed-8778-882cf3eb742c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d2a7fb34d761dff178bb2c5dfb784ef 3x", "genre": "art", "nsfw": false, "body": "僕のキャラクター、ロロを描いてくれないか\n\nインフレータブルな悪魔の女の子です。\n身長は143cmで、鋭い歯を持っています。\nおへそのところに空気弁がついています。\n\n好きなように、好きな格好で描いてください。プロポーションは、体内の空気の入れ替えで変化します。\n\n性格はやんちゃで、悪ふざけで笑い、ちょっとツンデレ。\n\nhttps://x.com/RorotteRotte/status/1507015845964263425", "created_at": "", "completed_at": ""}, {"path": "/@tokage_ougonika/works/13", "thumbnail_src": "https://si.imgix.net/76544394/uploads/origins/ae660312-7198-4ab4-9fd6-571b855847da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a02da6afcd1386dea8570236627d28f", "thumbnail_srcset": "https://si.imgix.net/76544394/uploads/origins/ae660312-7198-4ab4-9fd6-571b855847da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a02da6afcd1386dea8570236627d28f, https://si.imgix.net/76544394/uploads/origins/ae660312-7198-4ab4-9fd6-571b855847da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b37b8339ed61f008d228023c8a84520 2x, https://si.imgix.net/76544394/uploads/origins/ae660312-7198-4ab4-9fd6-571b855847da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=def004130917aba37ec76c4cfca3ffc8 3x", "genre": "art", "nsfw": false, "body": "𓆈𓆈𓆈先生初めてまして。𓆈𓆈𓆈先生の素敵なイラストをにて拝見しております。\n今回は私のOC描いていただきたく、リクエストを送信させていただきました\n\n本件のイラストには、先生が気楽に画く限り、簡単的な背景を描ければ幸いです。\n構図、服装、シチュエーション表情、その他、全てお任せします。\n※公式の衣装や髪型でなくて自由に描いていただいて大丈夫です！！\n\n納品形式\n可能であれば背景と人物を分けた透過データ、PSDデータにて納品いただけましたら幸いです。\n\n使用用途\n主にアイコン、 壁紙 などに個人使用させて頂く事があります\n\n他の参考資料は以下URLでご参照ください。\nhttps://flowus.cn/share/6ebc1108-10b2-4ace-8e7e-1dc287ec1c63\n\nオリジナル曲へのリンク\nhttps://www.notion.so/2025-6-4-208b90b0026d8096a1cac7c1dbae750f?source=copy_link\n\nお忙しい中恐縮ですが、ご検討の程どうぞよろしくお願いいたします。\n※金額や条件に不手際ありましたら再送リクエストをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tokage_ougonika/works/12", "thumbnail_src": "https://si.imgix.net/284038de/uploads/origins/978b3704-2e90-4909-adea-aee81e84967c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a449890aaf05d7566cf55aa8aac186d", "thumbnail_srcset": "https://si.imgix.net/284038de/uploads/origins/978b3704-2e90-4909-adea-aee81e84967c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a449890aaf05d7566cf55aa8aac186d, https://si.imgix.net/284038de/uploads/origins/978b3704-2e90-4909-adea-aee81e84967c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82fe534adb7892d2f3c2ffda21669e01 2x, https://si.imgix.net/284038de/uploads/origins/978b3704-2e90-4909-adea-aee81e84967c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ddf82988a7d19da62e35f71e3c5df09 3x", "genre": "art", "nsfw": false, "body": "初めまして、素敵な絵柄に惹かれリクエストさせて頂きました！私のオリジナルキャラクターを書いて欲しいです…！\n\n────────────────────────\n\n【キャラクターの詳細】\nモデルであり殺人鬼でもある美しい女性です。人々を魅了しマイペースな性格で自由に生き、アルコールとタバコをよく好みます。モチーフとして天使、また、天使の堕落が含まれます。\n\n【資料】\n■Googleドライブ\n【 https://drive.google.com/drive/folders/14daYBi9PRFAPSylUCeRM4yBXDUfFpbRP 】\n\n【その他】\n構図やポーズはお任せします！また、服装などに関しても資料の通りでなくとも問題ありません。是非お好みで自由に描いて頂ければと思います…！\n\n────────────────────────\n\n上記の内容で問題がなければご検討いただけますと幸いです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tokage_ougonika/works/11", "thumbnail_src": "https://si.imgix.net/d105bc8a/uploads/origins/4d3e8e38-cbc1-400e-9d54-f62a0ee28185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11492e98f76e4b6398d3f25787c1044", "thumbnail_srcset": "https://si.imgix.net/d105bc8a/uploads/origins/4d3e8e38-cbc1-400e-9d54-f62a0ee28185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11492e98f76e4b6398d3f25787c1044, https://si.imgix.net/d105bc8a/uploads/origins/4d3e8e38-cbc1-400