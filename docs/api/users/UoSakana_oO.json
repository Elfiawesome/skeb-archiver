32-9bf7-7a76b920419b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83afb6e0d96ae0ee019036c0356d4a0f, https://si.imgix.net/eaac61f6/uploads/origins/5d4c1935-ee69-4a32-9bf7-7a76b920419b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62265b812f8699c76805f4d54786bd37 2x, https://si.imgix.net/eaac61f6/uploads/origins/5d4c1935-ee69-4a32-9bf7-7a76b920419b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b192b9b856624d6235064d86cdb4dcb3 3x", "genre": "art", "nsfw": false, "body": "ゆゅ。○様 初めまして！Vtuberとして活動中のルナードと申します。先日はアピールありがとうございました。作品を拝見し、とっても可愛いケモ耳・ケモノ達がいっぱいで見ていてとても楽しかったです✨\nぜひ私のモデルも描いて頂きたいです！\n以下希望になります。ご検討宜しくお願い致します。\n\n୨୧ モデル：銀色の狐の女の子。ふわふわな尻尾と大きな耳が特徴です🫧\n୨୧ 構図・表情：ぜひお任せしたいです！\n୨୧ 衣装・髪型：添付資料に衣装が２着、髪型が３種類あります。良ければ選んでいただくか、アレンジを加えていただいても嬉しいです。\n୨୧ 色合い：もし背景や小物を描いて頂けるなら、赤色以外を使用して描いて頂きたいです！\n୨୧ 使用用途：SNS（X）、配信サイト（TwitchアラートとYoutubeサムネイル）での使用を考えています。\n୨୧ 納品形式：お任せします。背景がある場合は人物別の透過データを頂きたいです！\n\nhttps://drive.google.com/drive/folders/1iXkiq2f3gU8b22bA5dRkegDFOZMN189J?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@UoSakana_oO/works/132", "thumbnail_src": "https://si.imgix.net/3e8b1ca7/uploads/origins/59704c8f-6f24-461c-8210-f6a078e0167a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04dc56187cdf33e1b165ef5883e31811", "thumbnail_srcset": "https://si.imgix.net/3e8b1ca7/uploads/origins/59704c8f-6f24-461c-8210-f6a078e0167a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04dc56187cdf33e1b165ef5883e31811, https://si.imgix.net/3e8b1ca7/uploads/origins/59704c8f-6f24-461c-8210-f6a078e0167a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10026282d6c37e59fb77bf444276f1aa 2x, https://si.imgix.net/3e8b1ca7/uploads/origins/59704c8f-6f24-461c-8210-f6a078e0167a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08b6210daa0b790a8be56fd64063c6f1 3x", "genre": "art", "nsfw": true, "body": "はじめまして、アピールありがとうございます。\nうちの子雪を描いてください。\n\n両手でハートを作り、胸に押し当てている。\n尾を腹の上で交差させて、もう一つのハートを作っている。\n\n可能であれば、服を着たバージョン、包帯と絆創膏だけのバージョン、そして絆創膏だけのバージョンの3種類を希望します。\n\nhttps://x.com/TsurugiKuro/status/1882104730983522792", "created_at": "", "completed_at": ""}, {"path": "/@UoSakana_oO/works/131", "thumbnail_src": "https://si.imgix.net/9c29c610/uploads/origins/838f5919-a0d0-4205-97fc-8efe68fa4614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90e1fbb6fc228dc8c0795f46c49eeb73", "thumbnail_srcset": "https://si.imgix.net/9c29c610/uploads/origins/838f5919-a0d0-4205-97fc-8efe68fa4614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90e1fbb6fc228dc8c0795f46c49eeb73, https://si.imgix.net/9c29c610/uploads/origins/838f5919-a0d0-4205-97fc-8efe68fa4614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04d82521874c45e0d5f2f59a476de6f7 2x, https://si.imgix.net/9c29c610/uploads/origins/838f5919-a0d0-4205-97fc-8efe68fa4614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bb53c2273a9b31c102808eb9ffca7ae 3x", "genre": "art", "nsfw": false, "body": "このメッセージがあなたに届くことを願っています！最近、あなたのポートフォリオを拝見し、その鮮やかな色使いとダイナミックなキャラクター表現に魅了されたので、私のOCである、いつも未知の世界を探検する準備ができているキュートで好奇心旺盛な少年のマンガを依頼したいと思っています。\n\n以下のリンクが私のOCのキャラクター設定です。\nhttps://drive.google.com/file/d/12MiWChFZFcLACF6AdzA8FpjliTy00D8e/view?usp=sharing\n\n参考までに過去の作品です：\nhttps://drive.google.com/file/d/19iKaSiI7ZPyhWXVipK0ZO3zpM1wQzi79/view?usp=sharing\nhttps://drive.google.com/file/d/1YocvsV_ubVjM0Vs72YDdmjpSE1UbxMAd/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@UoSakana_oO/works/130", "thumbnail_src": "https://si.imgix.net/6754b544/uploads/origins/99cd3bc6-7392-4d20-8469-60a0db8c63c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09ee734713b188e9dc371912446e549a", "thumbnail_srcset": "https://si.imgix.net/6754b544/uploads/origins/99cd3bc6-7392-4d20-8469-60a0db8c63c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09ee734713b188e9dc371912446e549a, https://si.imgix.net/6754b544/uploads/origins/99cd3bc6-7392-4d20-8469-60a0db8c63c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dffdae436004dc108ff31b2f96dac7d6 2x, https://si.imgix.net/6754b544/uploads/origins/99cd3bc6-7392-4d20-8469-60a0db8c63c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e3ebe5df2839b34d6df5861e907bdf8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の猫のキャラクターを描いてほしいのですが、鼻に包帯を巻いています。\n\nポーズや表情は自由です。\n\nhttps://drive.google.com/drive/folders/1rA0CiQuHlOqXubpfmitX1qCU20fdnP-B?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@UoSakana_oO/works/129", "thumbnail_src": "https://si.imgix.net/87a2576c/uploads/origins/a39bba41-1872-4825-8c7d-e215a0bc8fba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c3a8abda4a04deb921174abc0e2e046", "thumbnail_srcset": "https://si.imgix.net/87a2576c/uploads/origins/a39bba41-1872-4825-8c7d-e215a0bc8fba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c3a8abda4a04deb921174abc0e2e046, https://si.imgix.net/87a2576c/uploads/origins/a39bba41-1872-4825-8c7d-e215a0bc8fba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f74d2b7c164476b6bf96da8f16f1f16 2x, https://si.imgix.net/87a2576c/uploads/origins/a39bba41-1872-4825-8c7d-e215a0bc8fba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ff6b47934aeee2dda55a87146f24620 3x", "genre": "art", "nsfw": false, "body": "はじめまして！アピール読ませて頂きました！\nうちのS-2をお褒め頂きありがとうございます！とても嬉しいです！\n私もゆゅ。様の絵柄でうちのS-2をどのように描いてくださるか気になりますので是非こちらからもご依頼させて頂きたいです！\n構図、ポージング、背景などゆゅ。様に全てお任せいたします！(グッズ制作に利用したいのでR-18以外でお願いします、また、衣装等はプラモデルがモチーフの為整合性が取れていない部分がありますので多少ゆゅ。様の方で補完、アレンジしてもらっても構いません)\n\n(補足として左耳のピアスの数、形状だけお間違えのないようにお願い致します。上の物がシルバー、下の物が黒、シルバー、黒で全てリング状の物になります)\n\nhttps://x.com/kiyosi9999/status/1870608148413010019?t=6Zj8py44BnFLbvvXsJ