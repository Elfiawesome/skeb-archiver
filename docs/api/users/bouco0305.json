t": "", "completed_at": ""}, {"path": "/@bouco0305/works/10", "thumbnail_src": "https://si.imgix.net/7013d4bd/uploads/origins/d01fff84-3387-4b18-aae1-5e4030922467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb318fe475ba97bb18b2a4885c6c7e1c", "thumbnail_srcset": "https://si.imgix.net/7013d4bd/uploads/origins/d01fff84-3387-4b18-aae1-5e4030922467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb318fe475ba97bb18b2a4885c6c7e1c, https://si.imgix.net/7013d4bd/uploads/origins/d01fff84-3387-4b18-aae1-5e4030922467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b48f791860911bdca79272154392a35c 2x, https://si.imgix.net/7013d4bd/uploads/origins/d01fff84-3387-4b18-aae1-5e4030922467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ca6a1920b74b54abf3b6ebefa7daa43 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたが描いてくれた作品をとても気に入りました。また、同じカップルがソファに座って抱き合ってテレビを見ているような絵をお願いします。本当にありがとうございました。この後、2枚ほど入れようかと思っています。全部まとめてプレゼントにしたいですね。本当にありがとうございました。\n\nhttps://twitter.com/shrike_exe/status/1420927120751034376?s=19", "created_at": "", "completed_at": ""}, {"path": "/@bouco0305/works/9", "thumbnail_src": "https://si.imgix.net/854b3454/uploads/origins/ff26e593-c42b-4cb2-b4aa-c849d77829a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9718fbcb4a8bfbe9b5497b05745a2b6", "thumbnail_srcset": "https://si.imgix.net/854b3454/uploads/origins/ff26e593-c42b-4cb2-b4aa-c849d77829a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9718fbcb4a8bfbe9b5497b05745a2b6, https://si.imgix.net/854b3454/uploads/origins/ff26e593-c42b-4cb2-b4aa-c849d77829a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b940f31cacead8f3329abf783e19200 2x, https://si.imgix.net/854b3454/uploads/origins/ff26e593-c42b-4cb2-b4aa-c849d77829a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10ffc2b757c0e6