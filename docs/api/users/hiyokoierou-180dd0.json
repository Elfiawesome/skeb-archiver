to=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faaee38bd548dd3de05aaec6d9c9a12b 2x, https://si.imgix.net/903757f3/uploads/origins/1029009a-ec15-4781-9c8b-7398df99540f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17ea2ce5fb3fa1898a7d87fcd405b4fe 3x", "genre": "art", "nsfw": false, "body": "余裕が出来たのでリクエストさせていただきます。\n今回は相撲の場所中にアイコンとして使用させていただく絵の依頼になります。\nこれまで通り身体の大部分が入るサイズでお願いします。\n\n内容としては、相撲の行司の格好をしたりみの絵を描いていただきたいです。\n下記のURLに行司の姿が載っていますが、行司の服装は探せば結構出てくるので、色々なところを参考にした方がいいがもしれません。\n十両格以上の足袋を履いた行司の衣装を希望します。\n是非よろしくお願いします。\n\nhttps://osumo-3.com/?page_id=456", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/17", "thumbnail_src": "https://si.imgix.net/30610c74/uploads/origins/902aa274-741b-499d-b482-d6af73d78c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6668ecb729b45a48c44f49714a7c02a9", "thumbnail_srcset": "https://si.imgix.net/30610c74/uploads/origins/902aa274-741b-499d-b482-d6af73d78c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6668ecb729b45a48c44f49714a7c02a9, https://si.imgix.net/30610c74/uploads/origins/902aa274-741b-499d-b482-d6af73d78c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e3650ec9126755ff42cfc4c068480e0 2x, https://si.imgix.net/30610c74/uploads/origins/902aa274-741b-499d-b482-d6af73d78c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fdf881376eef612450aadf1c9a4317c 3x", "genre": "art", "nsfw": false, "body": "駅メモのファンアートを１枚依頼したいです。\n\n信楽くろがねのイラストを１枚自由に描いて頂けないでしょうか。ラッピングや構図は全て自由でお任せします。\n\nもし引き受けて頂ける場合でも、無理なく楽しく描ける範囲でお願いしたいです。\n\n以上、宜しくご検討ください。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/16", "thumbnail_src": "https://si.imgix.net/64cd4693/uploads/origins/419d0f56-8549-465c-829c-48bdacac8fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8f36185a91a779e4bb2a54579a769d", "thumbnail_srcset": "https://si.imgix.net/64cd4693/uploads/origins/419d0f56-8549-465c-829c-48bdacac8fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8f36185a91a779e4bb2a54579a769d, https://si.imgix.net/64cd4693/uploads/origins/419d0f56-8549-465c-829c-48bdacac8fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=116e188b7de7a7febb121f0421bba2f9 2x, https://si.imgix.net/64cd4693/uploads/origins/419d0f56-8549-465c-829c-48bdacac8fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc72bbb92dc4ed525500d15bf036b8f9 3x", "genre": "art", "nsfw": false, "body": "依頼の本文など、初で何を頼んで良いのやらですが、クリエイターにおまかせで「ましつく」をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/15", "thumbnail_src": "https://si.imgix.net/10753e9d/uploads/origins/ab2cab12-5a0d-438d-b176-1936ebf3af63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73492d832fed0f94aa2cfe30ecff88c9", "thumbnail_srcset": "https://si.imgix.net/10753e9d/uploads/origins/ab2cab12-5a0d-438d-b176-1936ebf3af63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73492d832fed0f94aa2cfe30ecff88c9, https://si.imgix.net/10753e9d/uploads/origins/ab2cab12-5a0d-438d-b176-1936ebf3af63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff471b78af15091df78336e01f5540fc 2x, https://si.imgix.net/10753e9d/uploads/origins/ab2cab12-5a0d-438d-b176-1936ebf3af63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4774bf574a7493038f7cef800ca3a6b2 3x", "genre": "art", "nsfw": false, "body": "あかさま、アピールありがとうございます。\n早速リクエストさせていただきたくございます。\n駅メモ！から新居浜ありすの全身マント姿の全身立ち絵をお願いしたいです。\n\n【詳細】\n・マントのデザインはでんこの普段着交換会ラッピングの「いずななありす」のいずな、ありすが着ているマント(ショール？)で全身を包む感じにして、丈は足元まで隠れるくらいの長さでお願いしたいです。\n・マントは全身が足元まですっぽりと完全に覆われて首から下にストンと滝のように流れ落ちるような感じのスタイルで、前が閉じられて手足も含めて中身が全く分からない、地面に裾がゆったりドレープが広がった状態で立っている姿でお願いします。\n・マントは床に広がった裾も含めて画面内に収まる範囲でお願いします。\n・背中のパンタグラフは不要です。\n・表情等はお任せいたします。\n\nいずななありす (Wiki)↓ https://newekimemo.wiki.fc2.com/upload_dir/n/newekimemo/1721b9453749f95114099e067592355b.jpeg\n駅メモ公式\nhttps://ekimemo.com/about\n\n以上、よろしくお願いします。\n\nhttps://newekimemo.wiki.fc2.com/upload_dir/n/newekimemo/1721b9453749f95114099e067592355b.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/14", "thumbnail_src": "https://si.imgix.net/cfbd25c9/uploads/origins/6cb4d051-f3f5-4a19-8b7f-1e80f6474bce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7640e8523305f34032983c9e571c46f", "thumbnail_srcset": "https://si.imgix.net/cfbd25c9/uploads/origins/6cb4d051-f3f5-4a19-8b7f-1e80f6474bce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7640e8523305f34032983c9e571c46f, https://si.imgix.net/cfbd25c9/uploads/origins/6cb4d051-f3f5-4a19-8b7f-1e80f6474bce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=721d5c8f01ecdcc55f3bb1a36e1fc2c8 2x, https://si.imgix.net/cfbd25c9/uploads/origins/6cb4d051-f3f5-4a19-8b7f-1e80f6474bce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37911bb6306ca8b778c4fc789bfdc9eb 3x", "genre": "comic", "nsfw": false, "body": "久しぶりだね！\n\n市ヶ谷有咲と戸山明日香についてのリクエストですが、描いていただけないでしょうか？\nガルパピコ16の出来事の後ですね。\n明日香は香澄が友達と遊びに出かけた後、新曲の歌詞を届けるために有咲を訪れている。\n有咲はお姉ちゃんの仕事を引き継ぐために来たのだからとお茶を出す。\nしばらくして、明日香は有咲と二人きりになるのは、有咲の家を訪れて頬ずりをして以来だと気づく。有咲はもちろんそんなことは覚えていないが、お姉ちゃんの機嫌をとるために、一緒に遊ぶことにした。頬ずりをしているうちに、有咲は自分の優しさや、自分が本当に香澄の妹なのかどうかを考え始める。有咲は彼女のことをかわいいと思い始める。しばらくして明日香は現実に戻り、深々と頭を下げて謝り、外に飛び出した。\n5分後、混乱した有咲は、また会えないかというメールを受け取る。有咲は笑いながら「もちろん」と答える。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/13", "thumbnail_src": "https://si.imgix.net/c70da721/uploads/origins/de1a923e-644e-4751-8851-9e0ba68367ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168b71275dce07f460f998369bd23ee9", "thumbnail_srcset": "https://si.imgix.net/c70da721/uploads/origins/de1a923e-644e-4751-8851-9e0ba68367ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168b71275dce07f460f998369bd23ee9, https://si.imgix.net/c70da721/uploads/origins/de1a923e-644e-4751-8851-9e0ba68367ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b33d151196afded7707f0da11c1cf8fd 2x, https://si.imgix.net/c70da721/uploads/origins/de1a923e-644e-4751-8851-9e0ba68367ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a496800b1cda4f781984682c397f649d 3x", "genre": "art", "nsfw": false, "body": "あかさん、はじめまして。\n先日のアピールありがとうございました。\n今回はバンドリキャラのイラストをリクエストします。\n\nキャラクター\n・宇田川 あこ（カード「いざ、波に乗って」、特訓前)\n\nシチュエーション\n・特にありませんので、ポーズと他の所は全てあかさんにお任せします。\n\nよろしくお願いします。\n\nhttps://bangdream.gamedbs.jp/chara/show/1/2135", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/12", "thumbnail_src": "https://si.imgix.net/22e0787c/uploads/origins/53442372-a837-4531-8e4b-633c184a4263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0e3cca6d2bc9bb7063072d7933a1a3", "thumbnail_srcset": "https://si.imgix.net/22e0787c/uploads/origins/53442372-a837-4531-8e4b-633c184a4263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0e3cca6d2bc9bb7063072d7933a1a3, https://si.imgix.net/22e0787c/uploads/origins/53442372-a837-4531-8e4b-633c184a4263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=517872172d0b068876e8339b6fb2c192 2x, https://si.imgix.net/22e0787c/uploads/origins/53442372-a837-4531-8e4b-633c184a4263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5ed470bb1b7008fe15fbad7f5e25251 3x", "genre": "art", "nsfw": false, "body": "手が空いたという事で、色々考えた中でまたリクエストを送らせていただきます。\n前回依頼と似たような内容（服装）になってしまいますが、「まいばすけっと」という関東にあるイオン系列のスーパーマーケットで働いているりみの絵を今回はお願いしたいです。\n下記URLを参考、もしくは「まいばすけっと」と調べると制服のデザインや仕事しているシーンが案外たくさん出てきます。\nURLは後ろや横の姿も出てきて結構参考になると思います。\n是非よろしくお願いします。\n\nhttps://www.baitoru.com/contents/list/detail/id=3955", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/11", "thumbnail_src": "https://si.imgix.net/ee50c2ae/uploads/origins/a00a7d96-2c4a-4078-9eff-3ba41b319427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7943ae5b280a961bcc6548c169ba3a78", "thumbnail_srcset": "https://si.imgix.net/ee50c2ae/uploads/origins/a00a7d96-2c4a-4078-9eff-3ba41b319427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7943ae5b280a961bcc6548c169ba3a78, https://si.imgix.net/ee50c2ae/uploads/origins/a00a7d96-2c4a-4078-9eff-3ba41b319427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c623be6b2790242ef2a74d03dfbb4df 2x, https://si.imgix.net/ee50c2ae/uploads/origins/a00a7d96-2c4a-4078-9eff-3ba41b319427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=564dff33448d412cc7a0de7f3f5265ef 3x", "genre": "art", "nsfw": false, "body": "先日は素敵なりみを描いていただきまして、ありがとうございました。\n今回の依頼も、りみです。\n羽沢珈琲店でアルバイト中で、接客しているシチュエーションで、りみの絵をお願いしたいです。\n羽沢珈琲店の服装に加え、エプロンと同じ色の三角巾を頭に被せて欲しいと思います。\nイメージ的には、一番最初の依頼でハロウィンのお菓子作っているものと似た感じになると思います（色やエプロンの形こそ若干違うもののエプロンに三角巾という描写が同じになりますし）\n是非よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/10", "thumbnail_src": "https://si.imgix.net/2a38ee3a/uploads/origins/5e66b954-dc40-4471-9d3b-fe1dcb1d662f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7d6ac2d68219d5b819888b1dbd8bcf", "thumbnail_srcset": "https://si.imgix.net/2a38ee3a/uploads/origins/5e66b954-dc40-4471-9d3b-fe1dcb1d662f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7d6ac2d68219d5b819888b1dbd8bcf, https://si.imgix.net/2a38ee3a/uploads/origins/5e66b954-dc40-4471-9d3b-fe1dcb1d662f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab0aa0c38dadf2179f0054861ede223f 2x, https://si.imgix.net/2a38ee3a/uploads/origins/5e66b954-dc40-4471-9d3b-fe1dcb1d662f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8e947eef688366d5ec59bc75cf07cf 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\n最近お姿見かけないので募集打ち切っちゃったのか心配で、忙しいと思い依頼出すのを我慢していました。\nあか様に是非描いて欲しいネタがあります。\n\nHPにて香澄が髪を短く切った絵を見掛けたので、今回それと同じ断髪ネタで、りみの髪を現行のボブショートからベリーショートに更に短くしていただこうと思ってます。\nりみ独特のハネてる髪型をそのまま維持しつつ、後ろと横はバッサリと短くベリーショートに。\n前髪もぱっつん状態を維持しつつ少し短く。\nキャラの向きは前向き、服は私服の春服で。\n\n絵の依頼というより散髪の依頼みたいな内容になってしまい申し訳ありませんが、このネタあか様の絵で見てみたいので、是非よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/9", "thumbnail_src": "https://si.imgix.net/352f2ca7/uploads/origins/782b9b5a-31a0-405c-85f9-571e485c5fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04428f7c9fa1b97e8776c40854191b33", "thumbnail_srcset": "https://si.imgix.net/352f2ca7/uploads/origins/782b9b5a-31a0-405c-85f9-571e485c5fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04428f7c9fa1b97e8776c40854191b33, https://si.imgix.net/352f2ca7/uploads/origins/782b9b5a-31a0-405c-85f9-571e485c5fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2c28485d36cac2691ff449e8eb36854 2x, https://si.imgix.net/352f2ca7/uploads/origins/782b9b5a-31a0-405c-85f9-571e485c5fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=424f2aef744b5c1373158a65685b1043 3x", "genre": "comic", "nsfw": false, "body": "久しぶりだね！\n\n前回のリクエストの続編をお願いします。\n彩ちゃんは、また別のイベントでパレオにお礼を言いたいらしい。せーのっ」の後に頬にキスをしようと提案するのだが、今度は2人が偶然同じ方向に動いてしまい、パレオの唇にキスをしてしまう。二人は静かなひとときを楽しんでいるように見えたが、パレオは何が起こったのか完全に理解すると、自然にまた気を失ってしまう。今度は彩もかなり慌てる。\n\n前回同様、日本語はOK！\n\n\nご配慮ありがとうございました。\n\nhttps://skeb.jp/@hiyokoierou/works/6", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/8", "thumbnail_src": "https://si.imgix.net/9a875e2d/uploads/origins/4dfa18ee-ac92-42bc-a2fb-a689bde23e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e62760a8032838bb7c3b8e2df9781521", "thumbnail_srcset": "https://si.imgix.net/9a875e2d/uploads/origins/4dfa18ee-ac92-42bc-a2fb-a689bde23e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e62760a8032838bb7c3b8e2df9781521, https://si.imgix.net/9a875e2d/uploads/origins/4dfa18ee-ac92-42bc-a2fb-a689bde23e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07179251046baac9c95686e1c5778c0c 2x, https://si.imgix.net/9a875e2d/uploads/origins/4dfa18ee-ac92-42bc-a2fb-a689bde23e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86465ca8c8225d5b8fe69117e8dfb0c9 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。\n以前素晴らしい絵をいただいたので、リクエストしたくなりました。\n設定が色々オリジナルですが、よろしくお願いします。\n\nキャラ→牛込りみ\n\n服装→羽丘の夏服\n（羽丘の夏服が性癖でりみに着て貰いたいものでして）\n\nシチュ\n（りみが羽丘学生だった世界線で）朝の登校最中、時間がなくご飯食べた後すぐ家を出たため、朝食に食べた量多めの納豆の影響で口の中ネバネバベタベタが気になってる様子を描いていただきたいです。\n\n是非ご検討いただけたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/7", "thumbnail_src": "https://si.imgix.net/787b6e00/uploads/origins/1438d588-7e86-4791-adff-7baa4579b951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e01ff2752c11351c6ede22a74217c388", "thumbnail_srcset": "https://si.imgix.net/787b6e00/uploads/origins/1438d588-7e86-4791-adff-7baa4579b951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e01ff2752c11351c6ede22a74217c388, https://si.imgix.net/787b6e00/uploads/origins/1438d588-7e86-4791-adff-7baa4579b951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a05c717f31407e4271eaa154e0a78f7 2x, https://si.imgix.net/787b6e00/uploads/origins/1438d588-7e86-4791-adff-7baa4579b951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39ed1eed2731afe71289fecafe26ed58 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\nよくRTで絵を見掛ける方からのアピール光栄に思い、リクエストさせていただきます。\n\n制服の上からエプロンに、頭には三角巾を被って、調理実習の授業でハロウィンのお菓子作りをするりみりんの絵を描いていただく事は可能でしょうか？\nエプロンと三角巾は共に無地で、りみりんのイメージカラーであるピンク色のものをお願いします。\nエプロンや三角巾は、スーパーの店員さんが着用している至って普通の…シンプルなもので描いていただければと思います。\n\n描いていただけたら大変光栄です。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/6", "thumbnail_src": "https://si.imgix.net/bef98041/uploads/origins/f496b2c0-25e7-45db-ac39-8d43798b3545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68b055fa671418ecc99f4719e7f3f7cf", "thumbnail_srcset": "https://si.imgix.net/bef98041/uploads/origins/f496b2c0-25e7-45db-ac39-8d43798b3545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68b055fa671418ecc99f4719e7f3f7cf, https://si.imgix.net/bef98041/uploads/origins/f496b2c0-25e7-45db-ac39-8d43798b3545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f68540892451f3c14bbc3cc2611db77e 2x, https://si.imgix.net/bef98041/uploads/origins/f496b2c0-25e7-45db-ac39-8d43798b3545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be4eb8c409825f322604c5c59882ff0b 3x", "genre": "art", "nsfw": false, "body": "お待たせしました。\nあなたの絵が好きなので、何か描いていただけないでしょうか？\n\nあるイベントで、彩ちゃんがパレオが列の最後尾に並んでいることに気づき、誰も見ていないところで頬に軽くキスをして、忠実で忍耐強いファンであることを感謝しようとするシチュエーションを考えていました。しかし、パレオは大喜びですぐに気を失ってしまう。もちろん、彩は少しパニックになる。\n\n日本語で大丈夫です！\n\nご配慮ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/5", "thumbnail_src": "https://si.imgix.net/4d1fbac0/uploads/origins/89e7bdac-01e0-40d7-857c-9445aaa15b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36313560190121ce7a619fdeb4fda07b", "thumbnail_srcset": "https://si.imgix.net/4d1fbac0/uploads/origins/89e7bdac-01e0-40d7-857c-9445aaa15b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36313560190121ce7a619fdeb4fda07b, https://si.imgix.net/4d1fbac0/uploads/origins/89e7bdac-01e0-40d7-857c-9445aaa15b89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f713e3fa54cae8bf9d8512a177481706 2x, https://si.imgix.net/4d1fbac0/uploads/origins/89e7bdac-01e0-40d7-857c-9445aaa15b89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80a4264d223fe7f7355468cdb395ea8f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ 透子はバングドリームの中で一番好きなキャラクターなので、描いてみたいと言われた時は嬉しかったです。1～2ページの短いマンガをお願いしたいです。\n\n透子は紗夜にレストランで特別な味のフライドポテトを教えて、それを食べに来るように説得する。\n二人はフライドポテトを食べ過ぎてお腹を壊してしまう。\n瑠唯は二人のそばを通りかかり、なぜ他の女の子たちがお腹を膨らましてテーブルで寝ているのか混乱する。\n\n台詞が不要だと感じたら、台詞を加える必要はない。台詞を追加する場合は、日本語であれば問題ありません。リクエストにお答えいただき、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/4", "thumbnail_src": "https://si.imgix.net/9b1fa0fb/uploads/origins/979b00cc-faa8-4662-baeb-c3e09c7003e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12cd1e1d3202a2e36179cce8f3bddca4", "thumbnail_srcset": "https://si.imgix.net/9b1fa0fb/uploads/origins/979b00cc-faa8-4662-baeb-c3e09c7003e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12cd1e1d3202a2e36179cce8f3bddca4, https://si.imgix.net/9b1fa0fb/uploads/origins/979b00cc-faa8-4662-baeb-c3e09c7003e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0400f2332b9ca0f29a8aa9e7138857a6 2x, https://si.imgix.net/9b1fa0fb/uploads/origins/979b00cc-faa8-4662-baeb-c3e09c7003e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=452e1c21dbfcc0085f21fd88f801f5d9 3x", "genre": "art", "nsfw": false, "body": "名前打ちミスしていたので、再送します！\n\nあかさん、こんにちは。\n原稿のお話もお伺いしていますが、余力があれば以下相談をさせてください。\n\nキャラ：\n宇田川あこちゃん、朝日六花ちゃん、倉田ましろちゃん\n\nシチュエーション：\n・3人主催のクリスマスパーティが見たい(もしくは招待されたい)です！\n・ましろちゃんの幻想な世界にあこちゃんの闇の力が加わって、「ひぃぃ」としつつなんとか形にする六花ちゃんによって出来たクリスマスツリー…てっぺんに星が無事付いているのか気になります。そこはあかさんのみが知るでお願いします。\n・衣装はせっかくなのでサンタコスでお願いします。\n　ただあこちゃんは衣装にも凝って悪魔の羽根とか生えててほしいです。\n　ましろちゃん、六花ちゃんは普通かな？そこもお任せにさせてください。\n・その他クリスマス加減はあこさんのお任せにさせてください。\n\nPsdファイルであれば、レイヤーON／OFFなど出来ます。\nお忙しいところ申し訳ありませんがご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/3", "thumbnail_src": "https://si.imgix.net/a55cd2b7/uploads/origins/1c7c045b-1917-4f3f-8b74-84b6e21d5252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e1e5322b3b97f8816e870594b60b9f1", "thumbnail_srcset": "https://si.imgix.net/a55cd2b7/uploads/origins/1c7c045b-1917-4f3f-8b74-84b6e21d5252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e1e5322b3b97f8816e870594b60b9f1, https://si.imgix.net/a55cd2b7/uploads/origins/1c7c045b-1917-4f3f-8b74-84b6e21d5252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86c39ba57ff595aa71155068444694df 2x, https://si.imgix.net/a55cd2b7/uploads/origins/1c7c045b-1917-4f3f-8b74-84b6e21d5252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b7e33ff53437a5b8b2dae3538a1c96b 3x", "genre": "art", "nsfw": false, "body": "あかさんこんにちは。\nまたよろしければ、リクエストさせてください！\n\n仕事で疲れて笑顔がない自分を笑顔にするライブをしてくれるこころちゃんと香澄ちゃんが見たいです！\n可能であればライブ衣装でお願いしたいです。\n\nしばらく仕事が山続きなので、見てまた明日も頑張ろうって気持ちになりたくて。\nよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/2", "thumbnail_src": "https://si.imgix.net/8f05730e/uploads/origins/78067859-ada3-45c1-a745-1e6e27b6fada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89e669acdc79bc4fbf6384e7bb7de31", "thumbnail_srcset": "https://si.imgix.net/8f05730e/uploads/origins/78067859-ada3-45c1-a745-1e6e27b6fada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89e669acdc79bc4fbf6384e7bb7de31, https://si.imgix.net/8f05730e/uploads/origins/78067859-ada3-45c1-a745-1e6e27b6fada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec6a48cff5749f312ad1c7c8fc10e970 2x, https://si.imgix.net/8f05730e/uploads/origins/78067859-ada3-45c1-a745-1e6e27b6fada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f8597bbaa9bf0a98655dab1d143679c 3x", "genre": "art", "nsfw": false, "body": "あかさん、こんにちは。\n前回はバレンタインのイラストありがとうございました！\n\n今回は、私の誕生日を祝ってくれている1枚がほしいなと思い依頼させていただきます。\n\n誕生日5月2日なので、間に合えばそこに、難しければ過ぎても大丈夫です！\n\n内容としては、朝日六花が誕生日プレゼント決めかねているところに弦巻こころと氷川日菜が居合わせ、なんかすごいこと大事になった…みたいなのだと嬉しいです。\nただ、キャラが多いや内容難しいであれば、朝日六花の元に八潮瑠唯が居合わせ、見かねてビシッと決めてくれる！みたいなのをお願いしたいです。\n\n大変むずかしいのお伝えして申し訳ありませんがご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hiyokoierou/works/1", "thumbnail_src": "https://si.imgix.net/bd68412d/requests/220053_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba7c2ecfce2e61bec4c5f0b59c7c5096", "thumbnail_srcset": "https://si.imgix.net/bd68412d/requests/220053_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba7c2ecfce2e61bec4c5f0b59c7c5096, https://si.imgix.net/bd68412d/requests/220053_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0d06d552357c1bf7512f415f5856980 2x, https://si.imgix.net/bd68412d/requests/220053_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0db3adb346d73df30935d9ad079f12cb 3x", "genre": "art", "nsfw": false, "body": "あかさん、こんにちは！\nリクエストさせてください。\n\n【キャラクター】\nバンドリ！\n今井リサ\nチュチュ\n\n【シチュエーション】\nチュチュからのお願いでRASメンバーへのバレンタインチョコを一緒に作っている１場面が見たいです！\n\nゲームではまだ絡みないですがアニメではGBP決勝に向けてリサさんのお菓子たくさん奮われてそうなので、それを受けてこっそり相談しにいった…みたいなのからイメージです！\n\n【要望】\nぜひエプロンはつけてほしいです！\nそれ以外は基本お任せにさせてください！\nよろしくお願い致します！", "created_at": "", "completed_at": ""}]}