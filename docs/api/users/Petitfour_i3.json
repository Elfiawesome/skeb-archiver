954-bb26-635ce3480fe5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7b8faf6add0933a89d934bd8a52ac72c", "thumbnail_srcset": "https://si.imgix.net/57a2b5b1/uploads/origins/335c036d-8f04-4954-bb26-635ce3480fe5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7b8faf6add0933a89d934bd8a52ac72c, https://si.imgix.net/57a2b5b1/uploads/origins/335c036d-8f04-4954-bb26-635ce3480fe5?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=94381877cac2a53ed02b8d80b376da80 2x, https://si.imgix.net/57a2b5b1/uploads/origins/335c036d-8f04-4954-bb26-635ce3480fe5?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0ae834b8efc4a14df1d07070bcd76fc 3x", "genre": "art", "nsfw": true, "body": "アーボックに巻き付かれているアズールレーンの吹雪をお願いします。\n\nアーボックの締め付けがとても強く、とても気持ち良いという噂を聞いた吹雪がアーボックに巻き付いてもらっている設定です。\n\n構図は３〜４巻で全体を隙間なく巻き付け、吹雪の頭の上から口を閉じて下を出してください。よろしければ尻尾で首を締め付けていたり、色違いのもお願いします。\n\n吹雪の表情は\n①全身をまきつかれて「おー」と初めての体験に少し驚いている。\n②しかし、締め付けが思ったより強くなく「なーんだ！強くなくてぷにぷにして気持ちいいじゃん！」と満面の笑みを見せる（吹雪は煽ってるつもりはない）\n③しかし、アーボックの締め付けが開始。急な締め付けに「ちょっとまって！」と慌てる吹雪。\n④息ができなくて「く、苦しい・・・！」と苦しむ。\n⑤アーボックの締め付けは弱まる事がなく、吹雪は泣きながら「ごめんなさい・・・！」と謝るが現状は変わらない。\n⑥締め付けは長く続き、吹雪の目からハイライトが消え「いつまで続くんだろうなあ・・・」という感じでぼーっとしている。\n\n①⑤⑥は目を開け、②③④は目を閉じて頂きたいのですが、②の笑顔は目を開けた方が書きやすいようでしたら開けても大丈夫です。", "created_at": "", "completed_at": ""}, {"path": "/@Petitfour_i3/works/86", "thumbnail_src": "https://si.imgix.net/66e1ef23/uploads/origins/a6cede00-5240-4017-9542-e9c2b67599d6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d0df3ca4709515ee42149ee5fd91cb89", "thumbnail_srcset": "https://si.imgix.net/66e1ef23/uploads/origins/a6cede00-5240-4017-9542-e9c2b67599d6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d0df3ca4709515ee42149ee5fd91cb89, https://si.imgix.net/66e1ef23/uploads/origins/a6cede00-5240-4017-9542-e9c2b67599d6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6473407f0764dff7aaeaacd5e9060c4b 2x, https://si.imgix.net/66e1ef23/uploads/origins/a6ce