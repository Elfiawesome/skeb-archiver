8a9-4c27-8a77-176db1f8eca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6021aafb582b6d2e5bf8514ebdcef0cf 3x", "genre": "art", "nsfw": true, "body": "はーちゃんのイラストが見たいのでリクエストさせて頂きます。\nシチュエーションは海水浴の最中にブラが流されてビキニパンツ一丁姿になってしまったはーちゃん(ビキニの色は去年と同じ水色)が\n1枚目:ブラが流されたことに気付き、両腕でおっぱいを隠そうとする\n2枚目:自分のトップレス姿に惹かれるよう男が近寄ってくる\n3枚目:泣き声混じりの悲鳴と共に腕をどかされおっぱいが丸見えになる\n4枚目:丸出しになったおっぱいを揉まれる\n5枚目:起ってきた乳首を弄られる\n6枚目:泣き声を上げると共に乳首から母乳が噴き出る\n7枚目:溢れ出る母乳を吸われる\n8枚目:目や乳首からそれぞれ涙や母乳を流しながらビキニパンツ一丁姿を眺められる\n…といった感じにしてほしいです。\n上記の通常ver.に台詞ありのver.を入れた16枚セットでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Deego8/works/207", "thumbnail_src": "https://si.imgix.net/c1265ad2/uploads/origins/96ec1326-e07f-430b-b6d0-043732b0b845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1886743eaeffc7827c828ef4ded4e0d2", "thumbnail_srcset": "https://si.imgix.net/c1265ad2/uploads/origins/96ec1326-e07f-430b-b6d0-043732b0b845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1886743eaeffc7827c828ef4ded4e0d2, https://si.imgix.net/c1265ad2/uploads/origins/96ec1326-e07f-430b-b6d0-043732b0b845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faa80d8a9e78d3e7b1cdfbe5d1561d24 2x, https://si.imgix.net/c1265ad2/uploads/origins/96ec1326-e07f-430b-b6d0-043732b0b845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3451e701d884c53e62b5379f342e42d4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Deego8/works/206", "thumbnail_src": "https://si.imgix.net/1cca737c/uploads/origins/a2a57244-ff0d-4a05-ae0e-6767a7b8f275?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbe4a18a653020d001f9ca1226dbde0f", "thumbnail_srcset": "https://si.imgix.net/1cca737c/uploads/origins/a2a57244-ff0d-4a05-ae0e-6767a7b8f275?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbe4a18a653020d001f9ca1226dbde0f, https://si.imgix.net/1cca737c/uploads/origins/a2a57244-ff0d-4a05-ae0e-6767a7b8f275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9102a27899423200b3a1821e4c48951d 2x, https://si.imgix.net/1cca737c/uploads/origins/a2a57244-ff0d-4a05-ae0e-6767a7b8f275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=156aa266680ce156ffcba690e282fd07 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nよろしければリクエストさせてください。\n\n◇キャラ\nサムライスピリッツのナコルル\n\n◇シチュエーション\n敗北しモブに無理矢理される感じでお願いします\n竿役は一人でお願いします。\n服装は半脱ぎで胸元露出\n体位は後背位か背面座位\n悔しさと羞恥心が入り交じった表情\n竿役は後ろから乳首or乳房を弄っている構図でお願いします。\nよろしければ射精と絶頂母乳噴出の差分もお願いします\n喘ぎ声、擬音など入れていただけますと幸いです\n\n以上、何卒ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Deego8/works/205", "thumbnail_src": "https://si.imgix.net/2482f4fb/uploads/origins/c7794726-0295-47d1-9dc0-9450196fee0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=634a1fead5515d61a6ed2dd1b72f116d", "thumbnail_srcset": "https://si.imgix.net/2482f4fb/uploads/origins/c7794726-0295-47d1-9dc0-9450196fee0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=634a1fead5515d61a6ed2dd1b72f116d, https://si.imgix.net/2482f4fb/uploads/origins/c7794726-0295-47d1-9dc0-9450196fee0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f06d4dfccce8a0c78229935c67e9492 2x, https://si.imgix.net/2482f4fb/uploads/origins/c7794726-0295-47d1-9dc0-9450196fee0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3001bcb2ab3812c8278699196a51116 3x", "genre": "art", "nsfw": true, "body": "初めまして。べるs氏の東方project二次創作『魔理沙とアリスと不思議の国の魔獣』に登場する黒アリスのNSFWフルカラー漫画3ページを描いていただけないでしょうか。\nシチュエーションとしては以下のようなものになります。\n\n○黒アリス自身の企画によるテスト環境での実験\n○レギオン人形群により、下記の実験機材を実験室内へ搬入\n○触手群、男性型無頭ダミー人形群を全てシーカードールズ人形が遠隔制御\n○シーカードールズ人形によるビットを周囲に展開、\n視覚リンクにより黒アリスが第三者視点で自身を視姦する\n○シーカードールズ人形は微妙に呆れて赤面しながら操作を行っている\n\n○黒アリスのディティールは2009.5手袋型\n○胸のサイズは構図参考と同じぐらい\n○母乳差分\n\nその他、詳細な背景・構図やキャラのポーズは全てお任せします。\n\n構図参考:\nhttps://drive.google.com/file/d/1k0xtZHVLyDQD5_qS4xBXq07OhqW28UKH/view?usp=sharing\nhttps://drive.google.com/file/d/1W7DwC477TIEFlxVmFD9Bs0p_6bHMsBg9/view?usp=sharing\nhttps://drive.google.com/file/d/1JzWw73NhjF_4E3XSkruzjWJ5secsYC8Y/view?usp=sharing\n\n黒アリスディティール参考:\nhttps://www.pixiv.net/artworks/7913511\n\n偵符「シーカードールズ人形」参考:\nhttps://x.com/berusyarion/status/1736950714579181758\n\nレギオン人形参考:\nhttps://x.com/berusyarion/status/1606329882228686848\n\n実験室ディティール参考(上から2つ目のイラスト):\nhttps://skeb.jp/@berusyarion/works/49", "created_at": "", "completed_at": ""}, {"path": "/@Deego8/works/204", "thumbnail_src": "https://si.imgix.net/7db24824/uploads/origins/89167260-7cdd-473f-9926-f44799c47988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc14f60699a67cd744054833c6dd3de5", "thumbnail_srcset": "https://si.imgix.net/7db24824/uploads/origins/89167260-7cdd-473f-9926-f44799c47988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc14f60699a67cd744054833c6dd3de5, https://si.imgix.net/7db24824/uploads/origins/89167260-7cdd-473f-9926-f44799c47988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e70646aa837aeca31a6eecdfb588e2a4 2x, https://si.imgix.net/7db24824/uploads/origins/89167260-7cdd-473f-9926-f44799c47988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&