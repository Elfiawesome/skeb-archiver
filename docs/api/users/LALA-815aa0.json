1/uploads/origins/067f42bb-26d5-4d0f-93b1-41f16807bdee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be926a62276ed47aa5fe7d22126b468f 2x, https://si.imgix.net/9987c7c1/uploads/origins/067f42bb-26d5-4d0f-93b1-41f16807bdee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf774fb00e51764552a3d47d22d125e8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が本当に大好きで、もしあなたが私のキャラクターを描いてくれたら光栄です！\n\nhttps://twitter.com/FinlyKai/status/1639021052637622273/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@LALA/works/19", "thumbnail_src": "https://si.imgix.net/62337681/uploads/origins/255f755a-986f-4f0c-b2f7-8a93ea80a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c0db4ca92679b72b82e904c9bba31d", "thumbnail_srcset": "https://si.imgix.net/62337681/uploads/origins/255f755a-986f-4f0c-b2f7-8a93ea80a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c0db4ca92679b72b82e904c9bba31d, https://si.imgix.net/62337681/uploads/origins/255f755a-986f-4f0c-b2f7-8a93ea80a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a515f6fb2dac8ea6b2ef007cd78fddc6 2x, https://si.imgix.net/62337681/uploads/origins/255f755a-986f-4f0c-b2f7-8a93ea80a19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd030fa076c5c986b0257ea3004288dc 3x", "genre": "art", "nsfw": false, "body": "Hello. I'm really happy you opened skeb again! I like your art and would like to make a request. \n\nI would like to request Ishtar from fire emblem (References: https://imgur.com/a/qNhQK6U) \n\nSome Details:\n\nIshtar has a complex character, but she is elegant, dignified, and compassionate. \n\nShe is wearing the clothes of Yae Miko from [原神] (Yae references: https://imgur.com/a/FI3mzlD) Pose and expression are up to teacher. Be creative and have fun!", "created_at": "", "completed_at": ""}, {"path": "/@LALA/works/18", "thumbnail_src": 