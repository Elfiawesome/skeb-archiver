-4125-857a-c9f354f5d336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf180f6600206347c90f79acf592c157", "thumbnail_srcset": "https://si.imgix.net/3183e60f/uploads/origins/06704e3f-44cb-4125-857a-c9f354f5d336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf180f6600206347c90f79acf592c157, https://si.imgix.net/3183e60f/uploads/origins/06704e3f-44cb-4125-857a-c9f354f5d336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96291f3f720b18cf640102afae4420dd 2x, https://si.imgix.net/3183e60f/uploads/origins/06704e3f-44cb-4125-857a-c9f354f5d336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e031f87d4262ef4c0333026a4266a4da 3x", "genre": "art", "nsfw": true, "body": "にょもけさんこんにちは\nいつも素敵なボイロキャラ達のイラスト楽しく見させてもらっています\nたびたび描かれる露出・羞恥系シチュが大変癖に刺さりましたのでリクエストさせていただきます\n※説明文に差分が必要と読める部分があったため訂正して再送させていただきました\n\n■キャラクター\n　さとうささら\n■服装\n　Cevio CS版の私服風白ワンピース\n■シチュエーション\n濡れ透け全裸ワンピース姿で羞恥をこらえて散歩する ささらちゃん\n※補足\n下着を付けずにバレない露出散歩を楽しんでいたところ突然の雨で服が透けてしまうが、堂々としていればあまりバレない筈、と冷静に（冷静ではない）判断して平静を装いそのまま散歩を続行するイメージです\nそのほか詳細はお任せします\n\nもしよろしければご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/180", "thumbnail_src": "https://si.imgix.net/00713f68/uploads/origins/0cdda22b-eae6-4424-9d31-5dfa8d70b665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dee9c89a07f8d0c32d00e5621619022", "thumbnail_srcset": "https://si.imgix.net/00713f68/uploads/origins/0cdda22b-eae6-4424-9d31-5dfa8d70b665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dee9c89a07f8d0c32d00e5621619022, https://si.imgix.net/00713f68/uploads/origins/0cdda22b-eae6-4424-9d31-5dfa8d70b665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f92c01296cd0dc42e667fd03c99460d6 2x, https://si.imgix.net/00713f68/uploads/origins/0cdda22b-eae6-4424-9d31-5dfa8d70b665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f05fe19c0887fe2d11bf3794e3fc1ac7 3x", "genre": "art", "nsfw": true, "body": "いつも魅力的肉感と衣装のボイロ・ボカロ絵をありがとうございます！！\nVMBつむぎちゃん、サキュバスコスつむぎちゃんに続きまた依頼させてください！\n\n梅雨の蒸し暑い雨が降る中で、全裸に半透明なレインコートを着ている\n春日部つむぎちゃんでお願いします！\n汗でビニールが張り付いているような湿度を感じる絵が欲しいです！\n\nお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/179", "thumbnail_src": "https://si.imgix.net/22c0f1d1/uploads/origins/5a19f4bd-00b5-4cb2-b052-edc1386105d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=100e3223307d46eab791b60711e5e06e", "thumbnail_srcset": "https://si.imgix.net/22c0f1d1/uploads/origins/5a19f4bd-00b5-4cb2-b052-edc1386105d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=100e3223307d46eab791b60711e5e06e, https://si.imgix.net/22c0f1d1/uploads/origins/5a19f4bd-00b5-4cb2-b052-edc1386105d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ba5e9033e499929dfa7c1d39ee5d826 2x, https://si.imgix.net/22c0f1d1/uploads/origins/5a19f4bd-00b5-4cb2-b052-edc1386105d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3691f804564860fd2c30300ba34123d 3x", "genre": "art", "nsfw": true, "body": "前回は納品ありがとうございました、また続けてリクエスト失礼いたします。\n\nシチュエーション\n踊り子マキちゃん（25/9/26投稿分）に騎乗位でいっぱい搾り取ってもらう\n\nその他\n・男主観視点\n・サービス精神旺盛な明るい笑顔\n・可能であれば以下差分をいただけると嬉しいです\n　・射精差分（1回目、2回目、大量）\n　・胸の衣装のオンオフ差分\n　・縦に動いているエフェクト\n　・ひねるように動いているエフェクト\n　・表情差分（舌なめずりして獲物を捕らえたような笑顔）\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/178", "thumbnail_src": "https://si.imgix.net/90a3ffb8/uploads/origins/454e1dd4-c7b4-4e85-88ca-f26af81109d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d18281144b00be071629732a12d112f", "thumbnail_srcset": "https://si.imgix.net/90a3ffb8/uploads/origins/454e1dd4-c7b4-4e85-88ca-f26af81109d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d18281144b00be071629732a12d112f, https://si.imgix.net/90a3ffb8/uploads/origins/454e1dd4-c7b4-4e85-88ca-f26af81109d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6260a2b8df6e287b5d630b6748eda1b3 2x, https://si.imgix.net/90a3ffb8/uploads/origins/454e1dd4-c7b4-4e85-88ca-f26af81109d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=391a9ee08b6b3590580b09642bf989f3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/177", "thumbnail_src": "https://si.imgix.net/148a62ab/uploads/origins/6e42a2c3-729d-465c-a048-714f2762017a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f405c9f1bf4d4330cbdd89e6550f6934", "thumbnail_srcset": "https://si.imgix.net/148a62ab/uploads/origins/6e42a2c3-729d-465c-a048-714f2762017a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f405c9f1bf4d4330cbdd89e6550f6934, https://si.imgix.net/148a62ab/uploads/origins/6e42a2c3-729d-465c-a048-714f2762017a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e84d7b30cdc7f6f5d6b0e7db7183c0d 2x, https://si.imgix.net/148a62ab/uploads/origins/6e42a2c3-729d-465c-a048-714f2762017a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=199724ada46ee8b18b10c3ecc35a1ad6 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます。\n現在「うちの子リクエスト手数料無料キャンペーン」がやっているとのことで、\n改めて先生に私のOC、いわゆる「うちの子」を描いて頂きたいと考え、依頼をさせて頂きました。\n\n前回描いて頂いた、乳しぼりのシチュエーションがとても素敵でしたので、\nもう一度おっぱいに関する構図を依頼させて頂ければと思います。\n是非ご検討宜しくお願い致します。\n\n＜依頼内容＞\n◆キャラ\nうちの子：黒ちゃん(仮名)\n※参考画像\nhttps://x.com/magunamu06060/status/1949293676397789334\n\n◆コスチューム\n資料の衣装でお願い致します。\n細かい部分は描きやすいように自由にアレンジして頂いて構いません。\n\n◆シチュエーション\n身動きが取れない状況で、おっぱいを揉んだり、乳首を引っ張ったりほじったり、吸ったりと、執拗に弄られる差分をお願い致します(弄る内容は先生のお好きなシチュでも大丈夫です)\nおっぱいの形が変わるんじゃないかと思うくらい、ガッツリ弄ってもらえると嬉しいです。\n\n◆使用方法\nTwitterアイコンや動画、生放送のサムネなどでの使用を想定しております。\n\n◆その他\n可能であれば、人物と背景、宛名が分かれているPSDデータでの納品を頂けると助かります。\n\nhttps://x.com/magunamu06060/status/1949293676397789334", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/176", "thumbnail_src": "https://si.imgix.net/5f686993/uploads/origins/87fdd0c5-9afa-47fd-ac9f-f0eca91e39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf4b2476d9239e002f3999e1f8811cb", "thumbnail_srcset": "https://si.imgix.net/5f686993/uploads/origins/87fdd0c5-9afa-47fd-ac9f-f0eca91e39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf4b2476d9239e002f3999e1f8811cb, https://si.imgix.net/5f686993/uploads/origins/87fdd0c5-9afa-47fd-ac9f-f0eca91e39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffa97f415a8f32b0b82aab38a3fc4c17 2x, https://si.imgix.net/5f686993/uploads/origins/87fdd0c5-9afa-47fd-ac9f-f0eca91e39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98438e0eb19659f36b4bc5532dfaa5a7 3x", "genre": "art", "nsfw": true, "body": "セイカさんのパイズリをお願いします\n・構図、体位はこのついなちゃん（https://skeb.jp/@monyomoke/works/144）イメージ（こちらが理想的なので）\n・挟み方も同じように手で支えて挟む形でお願いします\n・竿は、これも上記と同じように谷間から先端が少し覗くくらいで\n・セイカさんは白のビキニ（マイクロではない）を着た着衣パイズリ\n・雰囲気はセイカさん優位で\n・可能であれば挟射や事後の差分を\n\n以上、ご検討よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/175", "thumbnail_src": "https://si.imgix.net/f9426f60/uploads/origins/bf5b39b5-e92e-41fd-91d1-653b1d9ea6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d342753a8d4b83c846c905718d9181ae", "thumbnail_srcset": "https://si.imgix.net/f9426f60/uploads/origins/bf5b39b5-e92e-41fd-91d1-653b1d9ea6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d342753a8d4b83c846c905718d9181ae, https://si.imgix.net/f9426f60/uploads/origins/bf5b39b5-e92e-41fd-91d1-653b1d9ea6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=258a587acac6b07a886ca2ae3018a60c 2x, https://si.imgix.net/f9426f60/uploads/origins/bf5b39b5-e92e-41fd-91d1-653b1d9ea6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52c574799ddb215fd0e928b447b22a3c 3x", "genre": "art", "nsfw": true, "body": "前回は納品ありがとうございました、また続けてリクエスト失礼いたします。\n\nシチュエーション\n踊り子ウナちゃん（25/10/02投稿分）にいっぱいエッチなことをしてもらう\n\nその他\n・男が仰向けで寝ている状態で、その上にウナちゃんが半身を密着させて乳首舐め+手コキ\n・男主観視点\n・サービス精神旺盛な明るい笑顔\n・胸の部分の衣装だけ外した状態（胸の部分が映らない場合はスルーしていただいて大丈夫です）\n・オタマン帽髪飾りは一応無しでお願いします\n・可能であれば以下差分をいただけると嬉しいです\n　・射精差分（出る瞬間、出た後1回目、2回目、大量）\n　・手を動かしているエフェクト\n　・舌を動かしているエフェクト\n　・表情差分（ちょっと嗜虐的な笑顔）\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@monyomoke/works/174", "thumbnail_src": "https://si.imgix.net/12ae2b39/uploads/origins/8f28af39-0cc8-4d97-8548-5ba0e9da3fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=545e29c5d3328149111974385d4220da", "thumbnail_srcset": "https://si.imgix.net/12ae2b39/uploads/origins/8f28af39-0cc8-4d97-8548-5ba0e9da3fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=545e29c5d3328149111974385d4220da, https://si.imgix.net/12ae2b39/uploads/origins/8f28af39-0cc8-4d97-8548-5ba0e9da3fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=178288fcebc9dcc56fa956c3b938f4a3 2x, https://si.imgix.net/12ae2b39/uploads/origins/8f28af39-0cc8-4d97-8548-5ba0e9da3fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&t