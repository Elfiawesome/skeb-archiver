imgix.net/b3c998e6/uploads/origins/e4b644fa-92b3-4197-8a6f-992c85b47acf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dd174f2ea23db4a10a73ed6e5e5480a 2x, https://si.imgix.net/b3c998e6/uploads/origins/e4b644fa-92b3-4197-8a6f-992c85b47acf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9065633b6c2ad1178f6c0a320afff745 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Tps9g/works/262", "thumbnail_src": "https://si.imgix.net/cbff1082/uploads/origins/980e6855-b320-42c6-a680-f8eef59577a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3f626ad9a63496e3cea5e205ed743bf", "thumbnail_srcset": "https://si.imgix.net/cbff1082/uploads/origins/980e6855-b320-42c6-a680-f8eef59577a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3f626ad9a63496e3cea5e205ed743bf, https://si.imgix.net/cbff1082/uploads/origins/980e6855-b320-42c6-a680-f8eef59577a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5f42b332a99b53476744160663bcba0 2x, https://si.imgix.net/cbff1082/uploads/origins/980e6855-b320-42c6-a680-f8eef59577a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb84b65086295f97d0778383508636db 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして。あなたのイラストが大好きです！ポーズや表情は、あなたの自由な発想にお任せしますので、彼女のエネルギーと個性を汲み取ってください！\n\n私のキャラクターは宇宙から来た女の子です。リチャードソンリス」（小さな丸い耳、短い毛皮の尻尾）をモチーフにした動物の耳と尻尾を持っています。グレムリン／クゾガキのエネルギーを持つ、いたずら好きで、興奮しやすい、かわいい女の子だ！エネルギッシュで陽気な女の子です。大きなハート型のアホ毛と顔のタトゥーにご注目ください！\n\nクレジットを入れてSNSで使う予定です。ご了承ください！ありがとうございました\n\nhttps://drive.google.com/drive/folders/1G-f4KDxvblPeegXCUa174hta1tm7KSML?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Tps9g/works/261", "thumbnail_src": "https://si.imgix.net/f126a783/uploads/origins/c2eb6867-4933-4697-a74e-2ee21a2dbcf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88d4772bb179ff55da32deb8fc22909f", "thumbnail_srcset": "https://si.imgix.net/f126a783/uploads/origins/c2eb6867-4933-4697-a74e-2ee21a2dbcf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88d4772bb179ff55da32deb8fc22909f, https://si.imgix.net/f126a783/uploads/origins/c2eb6867-4933-4697-a74e-2ee21a2dbcf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ca8ef174de9b13fb56627dc79f77512 2x, https://si.imgix.net/f126a783/uploads/origins/c2eb6867-4933-4697-a74e-2ee21a2dbcf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66ac7e5127d99f1095f92399d1eaffe6 3x", "genre": "art", "nsfw": true, "body": "初めまして様\nYouTubeにて配信活動をしております\nVTuberのひみつのえみると申します。\nskeb不慣れな為拙いかもしれませんがご理解いただけるとありがたいです。\nメンバーシップ限定のシチュエーションボイスで使用させていただくお酒を飲んで酔っぱらってるルームウェア姿のイラストを描いていただきたいと思いご連絡させていただきました。\n\n基本お任せで髪形などもおまかせしたいと思っています。\n･ギャルなのでギャル感強めで描いていただけたら嬉しいです！\n\n固定キャラは下記URLを参考にしていただき\n入れて欲しいポイントは目の蝶々と蝶の入れ墨です！\n\n設定はギャルでスパイ秘密結社の幹部でとっても元気でちょっぴりおバカな女の子です！\n使用用途は動画のサムネイル(収益化済み)やメンバー限定で壁紙配布、グッズ製作(できたら)動画にも使用させていただければなと思っております。\nサインありなし人物透過などいただけるとありがたいです。\n注文が多くて申し訳ありません\nもしよろしければ\nよろしくお願いいたします！\n\nhttps://x.com/himitu_emil/status/1711320185687470520\n\nhttps://x.com/himitu_emil/status/1711320185687470520", "created_at": "", "completed_at": ""}, {"path": "/@Tps9g/works/260", "thumbnail_src": "https://si.imgix.net/920735e9/uploads/origins/5b02a7ec-b7cb-4fda-a843-875b94e13d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29496d2d9b404cb963d59363896d4f9b", "thumbnail_srcset": "https://si.imgix.net/920735e9/uploads/origins/5b02a7ec-b7cb-4fda-a843-875b94e13d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29496d2d9b404cb963d59363896d4f9b, https://si.imgix.net/920735e9/uploads/origins/5b02a7ec-b7cb-4fda-a843-875b94e13d4