%2Ccenter&txtsize=30&txt=PRIVATE&s=7eb8a36235af846679b2db3e043b24d3 2x, https://si.imgix.net/bc9b2b88/uploads/origins/57808dca-7a1d-46a3-a031-458c53ad2b31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa6a446207b866f18edd62ee1f085778 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/65", "thumbnail_src": "https://si.imgix.net/ddc24f48/uploads/origins/8bef1dd8-3ed4-4830-8d41-28fa72d5dbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902ec28eb9ecaac8608478baa38cf799", "thumbnail_srcset": "https://si.imgix.net/ddc24f48/uploads/origins/8bef1dd8-3ed4-4830-8d41-28fa72d5dbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902ec28eb9ecaac8608478baa38cf799, https://si.imgix.net/ddc24f48/uploads/origins/8bef1dd8-3ed4-4830-8d41-28fa72d5dbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bd6f93d08708825c734f194b2ebae7a 2x, https://si.imgix.net/ddc24f48/uploads/origins/8bef1dd8-3ed4-4830-8d41-28fa72d5dbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f53fe31a7f6bac16e5e17e263d397209 3x", "genre": "art", "nsfw": false, "body": "隠れみの様\n\n初めまして！\ntomaと申します。\n\n隠れみの様の描かれる絵が好きでして、いつもTwitterを拝見させていただいております。\nイラスト集も拝見いたしまして、特に「歳々年々」の統一感のあるテーマと華やかな色使い、そしてそれぞれのキャラクターの可愛さが最高でした！\n\nこの度は、隠れみの様に私がTRPGで遊んでいるキャラクターの絵を描いていただきたく連絡差し上げました。\n依頼本文および資料URLにキャラクターの参考資料が閲覧できるURLを貼付します。( https://drive.google.com/drive/folders/1QKjY-tkRrMvMX60VtTJ-MTsOtGxJw_-e?usp=sharing )\nキャラクターの原案は私で、デザイン・イラストはきや助さまです。(イラストレーターさま： https://x.com/kiyasuke_my )\n\nキャラクターの情報は次のとおりです。\n・遠国 柊翔、17歳、高校2年生、身長160cm、体重55kg\n・農林学科在籍、バスケットボール部所属\n・白髪で短髪、橙色の瞳\n・実習による日焼けが目立つ\n・明るくておしゃべり\n・集中力があまり続かない。ボールがあればボールをいじっていたり、ペンがあればペンまわしをしているようなタイプ\n\nもし可能であれば次のようなイメージを汲んでいただけるととても嬉しいです。\n・和風または中華の服装\nこのイメージに関わらず、隠れみの様の自由なイメージで描いていただけたら嬉しいです。\nよろしければご一考ください！よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1QKjY-tkRrMvMX60VtTJ-MTsOtGxJw_-e?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/64", "thumbnail_src": "https://si.imgix.net/40dade72/uploads/origins/cc04d315-d400-4a38-8b42-b527ebc66aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af3cfc332d9110745a72430838a02b2e", "thumbnail_srcset": "https://si.imgix.net/40dade72/uploads/origins/cc04d315-d400-4a38-8b42-b527ebc66aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af3cfc332d9110745a72430838a02b2e, https://si.imgix.net/40dade72/uploads/origins/cc04d315-d400-4a38-8b42-b527ebc66aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50747aec8d674dccee152e19578aa9f6 2x, https://si.imgix.net/40dade72/uploads/origins/cc04d315-d400-4a38-8b42-b527ebc66aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c07bc1cb86b71902a4d2901f7c74f4d 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！\n先生の絵が絶対好きで、キャラクターが2人いる漫画をお願いしたいです!\n幼い頃は仲良しだった二人ですが、とある事情で離れ離れになってしまいました。 今はパートナーとして曖昧な関係ですが、二人の関係のストーリーを自由に演じてください。\n具体的にはURL参照してください。\n\n無理あれば条件を何かしら省いていただいて大丈夫です。\n何卒ご検討を宜しくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1jMcF3Lm9HJ5DY7tlYp3LPUPEPShqMiii?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/63", "thumbnail_src": "https://si.imgix.net/68db0ce0/uploads/origins/25d2ffcf-c783-47a0-9428-2564eca117b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb49a0aec62e5fc84789eb766dd1be3c", "thumbnail_srcset": "https://si.imgix.net/68db0ce0/uploads/origins/25d2ffcf-c783-47a0-9428-2564eca117b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb49a0aec62e5fc84789eb766dd1be3c, https://si.imgix.net/68db0ce0/uploads/origins/25d2ffcf-c783-47a0-9428-2564eca117b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d794756c2cd8253f06bcd342abe693bf 2x, https://si.imgix.net/68db0ce0/uploads/origins/25d2ffcf-c783-47a0-9428-2564eca117b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfaa0404b7a6d9ef515898614e623a88 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お願いがあります！\n\nキャラA\nhttps://toyhou.se/707.seth/gallery\nhttps://toyhou.se/707.seth/1624478.design-notes\n\nキャラB\nhttps://toyhou.se/293.mordan/gallery\n\n夫婦です。\n\nAはミュージシャンで、とても愛情深い。  \n\nBもまた悪魔で、猫のような瞳孔と牙を持っている。\n\n詳細はあなたにお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/62", "thumbnail_src": "https://si.imgix.net/698b234c/uploads/origins/922789d7-4d32-4996-9bb2-477170df673a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752e8362fb85c9d9afb86bde9349b69c", "thumbnail_srcset": "https://si.imgix.net/698b234c/uploads/origins/922789d7-4d32-4996-9bb2-477170df673a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752e8362fb85c9d9afb86bde9349b69c, https://si.imgix.net/698b234c/uploads/origins/922789d7-4d32-4996-9bb2-477170df673a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78565862307b5c9ce18ed447d07604b5 2x, https://si.imgix.net/698b234c/uploads/origins/922789d7-4d32-4996-9bb2-477170df673a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68a131e764c863ed7a580b15336c7fe1 3x", "genre": "art", "nsfw": false, "body": "隠れみの様のイラストを拝見して以来、とても可愛くてコミッション再会をお待ちしてました。\n\n\n\n【キャラ】 キィ\n17歳の貧乏没落貴族の娘で食べる為に軍人を目指している\n黒髪ショートの髪型とオッドアイの瞳が特徴です\n仏頂面で表情が乏しく、身のこなしが機敏\nとにかく潰しのきく知識を集めるのが趣味\n\n外見イメージは下記のリンクを参考にしてください\nhttps://www.dropbox.com/scl/fi/q2jn30ommooibthtkw1n0/2025-04-30-20-04-36.jpg?rlkey=cp7sr9e79cxpfxzlmd09vsikg&st=p96lsqdq&dl=0\n\n依頼のイメージとしては過去のこちらの依頼のような感じでお願いします\n\nhttps://skeb.jp/@Mino_llm/works/52\nhttps://skeb.jp/@Mino_llm/works/57\n\nモチーフはハードカバーの本と花（お任せ）でお願いします\n衣装は洋風なクラシカルな感じで隠れみの様のお好きなように描いてください\nポーズや構図もおまかせしますができたら参考にさせていただきました依頼の全身の構図みたいな感じでお願いします\n可能でしたら背景透過のデータもいただけると幸いです\n\n【用途】  \n●個人と友人で楽しむ印刷物のアクスタやカードの作成（可能であれば）", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/61", "thumbnail_src": "https://si.imgix.net/bef444b1/uploads/origins/9833efd3-a6b5-48f8-9fd4-c11ea233c22c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9db1628e72fcb3f49ac761bef6fb4dd", "thumbnail_srcset": "https://si.imgix.net/bef444b1/uploads/origins/9833efd3-a6b5-48f8-9fd4-c11ea233c22c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9db1628e72fcb3f49ac761bef6fb4dd, https://si.imgix.net/bef444b1/uploads/origins/9833efd3-a6b5-48f8-9fd4-c11ea233c22c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070cc4bf8d17ccd3fc10bbe22ed68af5 2x, https://si.imgix.net/bef444b1/uploads/origins/9833efd3-a6b5-48f8-9fd4-c11ea233c22c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4aa77f5d0cabad25dbd8e29fa0c2b75b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートワークがとても好きなので、私の2人のOC、ウィリアムとイルのために絵をお願いできないかしら。二人はかつて恋人同士であり、生徒であり、指導者であり、世界で最も有名な歌手とその秘密のマネージャーでした。  ウィリアムの性格はソフトで優しく、少し不安定だが夢を追い求める決心が固い。イルの性格はエレガントでやや茶目っ気があるが、時に個人的な葛藤にとらわれる。要するに、2人の関係は、分裂した異なる魂がお互いを癒そうとしているようなものだが、結局は半分忘れられた夢のように消えてしまった。\n\n好きな衣装を選んでください。二人のやりとりをメインにした作品になればと思います。ファッションショー、コンサート、パパラッチのいる雑踏、レポーターのインタビューを受けているところなど。大規模な背景は必要ありません。  自由な発想で描いてください！お支払いの金額が合わない場合は、お気軽にキャンセルしてください。\n\n可能であれば、あなたのこの作品のような全体的なスタイルを希望します。https://skeb.jp/@Mino_llm/works/57\n\nhttps://drive.google.com/drive/folders/1-8dSTlKrRY5ba0yuRKXgFrt679MSqg6i?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/60", "thumbnail_src": "https://si.imgix.net/00c79849/uploads/origins/5547e0ab-5098-4190-b3c6-c6176cf5de8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d97031aecdf9e193e7c395642871e6bc", "thumbnail_srcset": "https://si.imgix.net/00c79849/uploads/origins/5547e0ab-5098-4190-b3c6-c6176cf5de8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d97031aecdf9e193e7c395642871e6bc, https://si.imgix.net/00c79849/uploads/origins/5547e0ab-5098-4190-b3c6-c6176cf5de8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f39e0b0d26e029489c0e7288467745fe 2x, https://si.imgix.net/00c79849/uploads/origins/5547e0ab-5098-4190-b3c6-c6176cf5de8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c1f3619e57c4295aad31e30bf2d5321 3x", "genre": "art", "nsfw": false, "body": "親愛なる隠れみの\n\nお元気ですか？前回、私のOCのために素晴らしいモダンなデザインを作成してくださったことに、まずお礼を申し上げたいと思います。創造性と細部へのこだわりが、本当にキャラクターに命を吹き込んでくれました！\n\n夏が近づくにつれ、あなたの新しいデザインで、でも新鮮な夏のひねりを加えた新しい全身イラストを依頼したいと思っています。シンプルにお願いしたいのですが、キャラクターの核となるモダンな美意識を保ちつつ、夏の要素を作品に取り入れてください。服のディテール、アクセサリー、背景のモチーフ、色の選択など、あなた独自のスタイルで自由に「夏」を解釈してください。\n\n\n夏が近づいているので、オプションとしてサングラスを加えてもいいですか？もしよろしければ、サングラスをかけた状態と、襟に引っ掛けたり手に持ったりした状態の2種類を用意したいです。あなたの構図に最も合う掛け方を自由に選んでください！\n\nお忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1RTy0lYJThY91U3_G-Qfro0hH8-et70wn?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mino_llm/works/59", "thumbnail_src": "https://si.imgix.net/1b5204f3/uploads/origins/5a4b3356-9bae-458e-b7dd-0269b5926ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5d7b4e7bdb2fa79b2d07fbbf09667fe", "thumbnail_srcset": "https://si.imgix.net/1b5204f3/uploads/origins/5a4b3356-9bae-458e-b7dd-0269b5926ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5d7b4e7bdb2fa79b2d07fbbf09667fe, https://si.imgix.net/1b5204f3/uploads/origins/5a4b3356-9bae-458e-b7dd-0269b5926ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95df0af2cf6bf9090baa519262979511 2x, https://si.