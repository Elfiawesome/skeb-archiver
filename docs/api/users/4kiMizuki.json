ac-8d4d-406d-81f1-c83514a24a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9abf5a597de33cbf4b2449f41c09f0d 2x, https://si.imgix.net/19559a48/uploads/origins/211c87ac-8d4d-406d-81f1-c83514a24a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b6fafafec2e5b6d188e17eced0a80ad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@4kiMizuki/works/205", "thumbnail_src": "https://si.imgix.net/de32a54a/uploads/origins/305dc596-eb45-4764-a3eb-823f54fed7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89ba5fc6d156cf0612b0564706b96bc6", "thumbnail_srcset": "https://si.imgix.net/de32a54a/uploads/origins/305dc596-eb45-4764-a3eb-823f54fed7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89ba5fc6d156cf0612b0564706b96bc6, https://si.imgix.net/de32a54a/uploads/origins/305dc596-eb45-4764-a3eb-823f54fed7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=071a12ab7f3ea2908a37125491b366ba 2x, https://si.imgix.net/de32a54a/uploads/origins/305dc596-eb45-4764-a3eb-823f54fed7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58f511e8433ac698b9e9d613767731eb 3x", "genre": "art", "nsfw": false, "body": "サンリオ作品のキャラクター「シナモロール」のケモノ耳バージョンイラストを依頼します。簡易参考図を添付しましたが、ちびキャラではなくフルサイズのアニメキャラクタープロポーションで描いてください。キャラクターは「男の娘」、つまり男性でありながら主に女性的な外見を持つ設定で描いてください。正面からの上半身ショットが望ましく、両目を開けて微笑んでいる姿でお願いします。背景はテーマに沿ったもの（水色と白のデザイン）でお願いします。背景には水玉模様が好ましく、青から白へと変化するデザインが望ましい。\n\n参考画像（Twitter @sharpycharot 作成）：https://files.catbox.moe/2tighe.webp\nポーズ参考（彼はこのようなコーヒーカップを持っています）：https://www.pixiv.net/en/artworks/113872599\n\nhttps://files.catbox.moe/2tighe.webp", "created_at": "", "completed_at": ""}, {"path": "/@4kiMizu