ea2-42cd-9e6c-b6d902e10ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b79bded1707262882a841b5881a220, https://si.imgix.net/dcf54111/uploads/origins/742a28e9-cea2-42cd-9e6c-b6d902e10ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5347f0104a683cc85d7b180f219ccb21 2x, https://si.imgix.net/dcf54111/uploads/origins/742a28e9-cea2-42cd-9e6c-b6d902e10ea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=086778a3cdcbdb836e4c4f39124de263 3x", "genre": "art", "nsfw": false, "body": "うちの着物ナユさんを資料URLの同じような構図でお願いしたいです。\n構図以外の表情等は指定はないので、お任せでお願いします。\n\nイラストはアイコンで利用する予定です。\nまた、資料URLは全身ですが、描きづらい等あれば上半身のみでも可です。\n\nよろしくお願いします。\n\n<着物ナユさん参考SS>\nhttps://x.com/shgr_vrc/status/1959305721658650749/photo/1\nhttps://x.com/shgr_vrc/status/1933965033597518042/photo/1\n\nhttps://www.nyacos.jp/images/path-products/image-CGI203RD.jpg/&width=600&height=880&original=77s8AgZSGN6A", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/8", "thumbnail_src": "https://si.imgix.net/1897e34a/uploads/origins/9ba12e96-67aa-4343-912a-a0164f66d75d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b3f299a3a047ed52f2b62721435bf1", "thumbnail_srcset": "https://si.imgix.net/1897e34a/uploads/origins/9ba12e96-67aa-4343-912a-a0164f66d75d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b3f299a3a047ed52f2b62721435bf1, https://si.imgix.net/1897e34a/uploads/origins/9ba12e96-67aa-4343-912a-a0164f66d75d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04999b6158ce97e5ca46531529e94398 2x, https://si.imgix.net/1897e34a/uploads/origins/9ba12e96-67aa-4343-912a-a0164f66d75d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14fe1007840d107be0b94d073492a505 3x", "genre": "art", "nsfw": false, "body": "たね。さん、はじめまして！\nわたくしバ美肉おじさんとしてYoutubeやニコニコで活動しているかなめあおいと申します。\n今回たね。さんにデフォルメしたかなめあおいちゃんを描いていただきたいと思いリクエストさせていただきました！\n衣装がデフォルトであればポーズや構図は指定ありません\n資料URLにはかなめあおいの全体がわかるものを添付させていただきます。\nたね。さんがかわいいと思うように描いていただければ幸いです！\n\nhttps://x.com/kana2525aoiB/status/1893550174133461466", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/7", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7991110f832b3e42bdfb20120d1faec", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7991110f832b3e42bdfb20120d1faec, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1127b4a0bd782e9a80fc255ecf9be85 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df8214f4466161340143ec33eeaa5641 3x", "genre": "voice", "nsfw": false, "body": "認知シャッフル睡眠法に使えるボイスをお願いします。\n\n無理のない長さで大丈夫です、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7991110f832b3e42bdfb20120d1faec", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7991110f832b3e42bdfb20120d1faec, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1127b4a0bd782e9a80fc255ecf9be85 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1994028023738454016%2Fz5Loh9SH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df8214f4466161340143ec33eeaa5641 3x", "genre": "voice", "nsfw": false, "body": "勤務後、悲しい日、頑張った日など、疲れた時に聞ける労いや癒しのボイスを頂きたいです！\n長さやセリフ、シチュエーションなどは全てお任せします！\n名前が聞けたら嬉しいな、くらいのことしか考えてません、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/5", "thumbnail_src": "https://si.imgix.net/0d9cc7ce/uploads/origins/837c6397-8cde-42c2-9944-98376d201993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e329d856b5b22167f503b301f8c35ac9", "thumbnail_srcset": "https://si.imgix.net/0d9cc7ce/uploads/origins/837c6397-8cde-42c2-9944-98376d201993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e329d856b5b22167f503b301f8c35ac9, https://si.imgix.net/0d9cc7ce/uploads/origins/837c6397-8cde-42c2-9944-98376d201993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc46674e629fad79ce82eba521b1ddba 2x, https://si.imgix.net/0d9cc7ce/uploads/origins/837c6397-8cde-42c2-9944-98376d201993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=511a289bc2717c0c6210ebc5f025e72e 3x", "genre": "art", "nsfw": false, "body": "たねまるさんのイサナイと自分のキプフェルのツーショ風イラストをお願いしたいです！\n構図やら、詳細は全てお任せします！\n宜しくお願いします！\n\nキプフェルのデザインはこちらで！\nhttps://drive.google.com/file/d/1cqOzF5x1tbKnTxt1xQ7CSuKJ0sfNkhci/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/4", "thumbnail_src": "https://si.imgix.net/68fb58ba/uploads/origins/dbfa91fa-8dbe-4b64-a334-f094c400ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69d66b0496f3c0a0986674a9d102fe6", "thumbnail_srcset": "https://si.imgix.net/68fb58ba/uploads/origins/dbfa91fa-8dbe-4b64-a334-f094c400ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69d66b0496f3c0a0986674a9d102fe6, https://si.imgix.net/68fb58ba/uploads/origins/dbfa91fa-8dbe-4b64-a334-f094c400ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0616fba20d20c4c28188bcd676b3cb0 2x, https://si.imgix.net/68fb58ba/uploads/origins/dbfa91fa-8dbe-4b64-a334-f094c400ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=932054c506dd75588c89310d43fe2834 3x", "genre": "art", "nsfw": false, "body": "たね。🌱先生\n\n初めまして\nやじょと申します。\n\n初めに今回の依頼につきまして、「ずんだもん」のイラストをお願いしたく思います。\n二次創作になりますので難しいようでしたら断っていただけますと幸いです。\n\n細かなシチュエーションにつきまして、画風はSDキャラ風でずんだもんに初心者とわかる”何か”\nを身に着けていただいて元気よく「はーい！」と返事をするような感じでお願いいたします。\n\n”何か”につきましてはクッションのようなものを持たせる、胸にバッチのようなものをつける、髪留めなど\nぱっと見で初心者とわかるものでしたらなんでもいいです。\n\n構図につきまして、上記の事柄もございますので胸下辺りから上でお願いいたします。\n（全身絵でしたらとてもうれしいですが金額的にできる範囲でお願いいたします）\n\nまた、背景につきましては、透過して頂けますと幸いです。\n\nその他、細かな点につきましては、たね。🌱先生にお任せいたします。\n\n使用用途\n今回の依頼につきまして、Youtubeの当方チャンネルにて\nサムネイルとして使用させていただきたく思います。\n使用する際はサムネイルのillustratorとして、たね。🌱先生の名前を\n概要欄に記載させていただきたく思います。\n\n何卒ご許可願います。\n\nご不明な点がございましたら申し訳ございません。\n可能な限りで構いませんので何卒ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/3", "thumbnail_src": "https://si.imgix.net/22fe7bff/uploads/origins/0866f496-f657-4b50-8799-a55cdae2311c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e7d85cd36e61ac0eeec16bedc26b2b8", "thumbnail_srcset": "https://si.imgix.net/22fe7bff/uploads/origins/0866f496-f657-4b50-8799-a55cdae2311c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e7d85cd36e61ac0eeec16bedc26b2b8, https://si.imgix.net/22fe7bff/uploads/origins/0866f496-f657-4b50-8799-a55cdae2311c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=650476228267d311ea6cd0bd0d69ceb2 2x, https://si.imgix.net/22fe7bff/uploads/origins/0866f496-f657-4b50-8799-a55cdae2311c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb3794e7c15dc6b729804ca9b5754652 3x", "genre": "art", "nsfw": false, "body": "以下のboothで販売されている３Dアバターのティグリなすちゃんを描いていただけますでしょうか。\nhttps://booth.pm/ja/items/1771588\nSteamのアイコン、Discordのアイコンで利用させていただく予定です。\n\nポニーテイルの髪型があるのでそちらでお願いします。\n可能であればそのポニーテイルが見えるような形で描いていただけますと幸甚です。\nその他構図はお任せいたします。\n\n荒くて申し込ありませんが３面図を以下私の別のXのアカウントで載せました。こちらもご参考ください。\nhttps://x.com/hayato8325/status/1867453836673396952\n\n不足ありましたら申し訳ありません。\n無理のないように描いていただければと思います。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/2", "thumbnail_src": "https://si.imgix.net/759e00d8/uploads/origins/f6f2cac3-48b6-4cd9-b2ac-9c50d8e2d753?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e05176a2ade6327a10ea59ed083bcff", "thumbnail_srcset": "https://si.imgix.net/759e00d8/uploads/origins/f6f2cac3-48b6-4cd9-b2ac-9c50d8e2d753?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e05176a2ade6327a10ea59ed083bcff, https://si.imgix.net/759e00d8/uploads/origins/f6f2cac3-48b6-4cd9-b2ac-9c50d8e2d753?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dd7d29ab370f120e51313b32fe96489 2x, https://si.imgix.net/759e00d8/uploads/origins/f6f2cac3-48b6-4cd9-b2ac-9c50d8e2d753?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c5f254f18f71370d8df6b96d840c1e7 3x", "genre": "art", "nsfw": false, "body": "うちのキププのイラスト描いてほしい～！！\n天才的な感じで！！\n\n(Skeb初めてで依頼のやりかた間違えてたらごめんなさい)\n\nhttps://drive.google.com/file/d/1Vf_3sPTJjD-VNJDY6k1Gp9b73-MgS6fs/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Tane_Vt0/works/1", "thumbnail_src": "https://si.imgix.net/a78a6d19/uploads/origins/4aa23207-ec81-46c0-813e-5488b9fe76dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62b5594fb7738cbe40ae316420bd213d", "thumbnail_srcset": "https://si.imgix.net/a78a6d19/uploads/origins/4aa23207-ec81-46c0-813e-5488b9fe76dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62b5594fb7738cbe40ae316420bd213d, https://si.imgix.net/a78a6d19/