e8ec8595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5c2f9d69407b993c2049ce4b573aa6b", "thumbnail_srcset": "https://si.imgix.net/aa320b4c/uploads/origins/917365c3-2139-4322-bea3-b5e2e8ec8595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5c2f9d69407b993c2049ce4b573aa6b, https://si.imgix.net/aa320b4c/uploads/origins/917365c3-2139-4322-bea3-b5e2e8ec8595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80b8a2dc44a3b7aaf05188a7ed73a01e 2x, https://si.imgix.net/aa320b4c/uploads/origins/917365c3-2139-4322-bea3-b5e2e8ec8595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9859f5ba9866e07c81ee1f868dc1884 3x", "genre": "art", "nsfw": false, "body": "Hello\nI love your artwork\nI really like that song 彗星になれたなら by はるまきごはん\nand I would like to ask you to draw a scene similar to the one in the music video where a comet is seen from inside the car.it's beautiful\n\nthat song : \nhttps://youtu.be/8jVXc6N4muc?si=V9Zw3kJH9cZrqhre\n\nthat sence :\nhttps://drive.google.com/file/d/1MBsRm1VHXTm-2em7LZqv3taOGaeH5qV0/view?usp=sharing\n\nand here is my ref \nhttps://drive.google.com/drive/folders/16Zw5sDYk9_4lwKX4qNorrx-8TQcWZ8IL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Ama_imakuma/works/5", "thumbnail_src": "https://si.imgix.net/58b3bda8/uploads/origins/12e6e0d3-ff31-44b0-afa9-c3fd9febe3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14409b3691427f88651bdadc7687de4", "thumbnail_srcset": "https://si.imgix.net/58b3bda8/uploads/origins/12e6e0d3-ff31-44b0-afa9-c3fd9febe3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14409b3691427f88651bdadc7687de4, https://si.imgix.net/58b3bda8/uploads/origins/12e6e0d3-ff31-44b0-afa9-c3fd9febe3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f61e317586cad536518adfe228323f6a 2x, https://si.imgix.net/58b3bda8/uploads/origins/12e6e0