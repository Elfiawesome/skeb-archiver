f-4339-bcb0-7093084727a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd936e9b548e51a4b87d6937f6914b3", "thumbnail_srcset": "https://si.imgix.net/5a48da98/uploads/origins/13059270-bc1f-4339-bcb0-7093084727a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd936e9b548e51a4b87d6937f6914b3, https://si.imgix.net/5a48da98/uploads/origins/13059270-bc1f-4339-bcb0-7093084727a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2581c3434e2f56cfab0b836fe9ab76f6 2x, https://si.imgix.net/5a48da98/uploads/origins/13059270-bc1f-4339-bcb0-7093084727a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4396535b0b6e430cbed100521c2df902 3x", "genre": "art", "nsfw": false, "body": "坂輝彦ともうします。先生がskebを募集されるとのことで参加する次第です。\n「ヤンキー君と科学ごはん」の猿渡さんがインナーカラーを入れてみた仮想の姿をいただけないでしょうか。\n\nよろしくおねがいいたします。", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/9", "thumbnail_src": "https://si.imgix.net/676db6ad/uploads/origins/4fe3606c-b25e-479a-bf6e-5f4dea7d1492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb201799bbfb05d8ee71a8511f66ac6", "thumbnail_srcset": "https://si.imgix.net/676db6ad/uploads/origins/4fe3606c-b25e-479a-bf6e-5f4dea7d1492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb201799bbfb05d8ee71a8511f66ac6, https://si.imgix.net/676db6ad/uploads/origins/4fe3606c-b25e-479a-bf6e-5f4dea7d1492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c0971b5540bdc49c198e11d28938029 2x, https://si.imgix.net/676db6ad/uploads/origins/4fe3606c-b25e-479a-bf6e-5f4dea7d1492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dab86309c96bdfa149acaaa6d1959f1a 3x", "genre": "art", "nsfw": false, "body": "はじめまして、ひひひと申します\n岡叶様のイラストやヤンキー君と科学ごはんなどの漫画いつも楽しく読ませていただいております\nもしよろしければ私のTRPGのOCをリクエストさせていただきたいです\n\n構図、表情などの希望は特になく衣装類なども描きやすい様に変更を加えていただいて構いません\n\n使用用途としては観賞用や個人使用(アイコン、ヘッダーなど)の範疇で考えております\n\n何卒ご検討いただけますと幸いです\n\nhttps://drive.google.com/file/d/1yB7oS_tf5FlTUpedbOPDj7SheA958yCQ/view?usp=sharing\n\nhttps://iachara.com/view/5405282", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/8", "thumbnail_src": "https://si.imgix.net/997475c9/uploads/origins/d1671b90-d3d7-49d9-b78e-f155607ce558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a350e981dd5b862281a2093e194b4ae6", "thumbnail_srcset": "https://si.imgix.net/997475c9/uploads/origins/d1671b90-d3d7-49d9-b78e-f155607ce558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a350e981dd5b862281a2093e194b4ae6, https://si.imgix.net/997475c9/uploads/origins/d1671b90-d3d7-49d9-b78e-f155607ce558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=711f70ccf099bec725962a71e226c340 2x, https://si.imgix.net/997475c9/uploads/origins/d1671b90-d3d7-49d9-b78e-f155607ce558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0253248310d90436b243b6bb8e21658b 3x", "genre": "art", "nsfw": false, "body": "岡先生キャラで宜しければ、デイズオンユースストーリーズのヒメちゃんを描いて頂きたいと思っております！\n衣装を希望して宜しければ、執事服を希望です！", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/7", "thumbnail_src": "https://si.imgix.net/0ea1e98b/uploads/origins/be56de38-a144-42ae-99bb-49563abd1f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3170f112b584884a500810f84b4a49f7", "thumbnail_srcset": "https://si.imgix.net/0ea1e98b/uploads/origins/be56de38-a144-42ae-99bb-49563abd1f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3170f112b584884a500810f84b4a49f7, https://si.imgix.net/0ea1e98b/uploads/origins/be56de38-a144-42ae-99bb-49563abd1f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83126867768c634bd7de591fdf034599 2x, https://si.imgix.net/0ea1e98b/uploads/origins/be56de38-a144-42ae-99bb-49563abd1f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9783f5a43f274c6645122fefb27b8072 3x", "genre": "art", "nsfw": false, "body": "岡先生、\nいつも素敵な作品を拝見しております！\nどの漫画もとても面白くて大好きです！\n\n今回は私のOCを描いていただきたく、メッセージいたしました。\n\n【キャラクターについて】\n名前：サーリヤ\n・女性\n・149cm\n・灰色の目（吊り目）\n・八重歯\n・左目の下にほくろ\n・青髪で三つ編み\n・魔術を扱える賢者\n・おじいちゃん口調（〜じゃ）\n・いたずら好き\n・月や星が好き\nhttps://drive.google.com/drive/folders/10iWjOMiYj44qOqGj84Nb5QwLrbh3hjaJ?usp=sharing\n\n衣装や構図等お好きに描いてください！\n金額や資料等に不備があれば遠慮なく再送申請、キャンセルいただいて構いません。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10iWjOMiYj44qOqGj84Nb5QwLrbh3hjaJ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/6", "thumbnail_src": "https://si.imgix.net/04217da0/uploads/origins/677d2681-c57b-44fe-9b65-7f3b0cdff2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=437e8ba9d59971cf80e03f6e9926527a", "thumbnail_srcset": "https://si.imgix.net/04217da0/uploads/origins/677d2681-c57b-44fe-9b65-7f3b0cdff2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=437e8ba9d59971cf80e03f6e9926527a, https://si.imgix.net/04217da0/uploads/origins/677d2681-c57b-44fe-9b65-7f3b0cdff2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef27132f2320138f786e5fa6cfe56a1e 2x, https://si.imgix.net/04217da0/uploads/origins/677d2681-c57b-44fe-9b65-7f3b0cdff2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3b9994d60c3425f7d2c792fd82e4d68 3x", "genre": "art", "nsfw": false, "body": "初めまして。岡先生の作品全て大好きです。宜しければ、だんしんをお願いいたします。先生の作品たちの中で1番好きなキャラです。", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/5", "thumbnail_src": "https://si.imgix.net/df1485fd/uploads/origins/68f183b9-c14c-4aec-a35c-36b48548877e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9d97997d3a2d01e94d7fc7a22d2289", "thumbnail_srcset": "https://si.imgix.net/df1485fd/uploads/origins/68f183b9-c14c-4aec-a35c-36b48548877e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9d97997d3a2d01e94d7fc7a22d2289, https://si.imgix.net/df1485fd/uploads/origins/68f183b9-c14c-4aec-a35c-36b48548877e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f0641c8958de8ce7bbf14bcd9ff01ca 2x, https://si.imgix.net/df1485fd/uploads/origins/68f183b9-c14c-4aec-a35c-36b48548877e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66b91dd314cc906d6547c2892ec239b4 3x", "genre": "art", "nsfw": false, "body": "岡叶先生、いつも面白い漫画をありがとうございます！\n科学ごはん大好きでレシピもよく作らせていただいています～！\n\nskeb開設おめでとうございます！\nいつぞや企画で描いていただきました殺人鬼のギャル、\n改めてお願いできればとリクエストに参りました。\n\n雰囲気やシチュエーションなど全てお任せいたします。\nお好きに描いていただければ嬉しいです！\n\nご縁がございましたら是非、よろしくお願いいたします！\n\n\n●資料\nhttps://drive.google.com/drive/folders/1MC7nINO4jEa4DIKnKdlkimG37D4D05h-?usp=sharing\nイラストは全て 佐藤水様（@310mz）に作成していただいたものです\n\nhttps://drive.google.com/drive/folders/1MC7nINO4jEa4DIKnKdlkimG37D4D05h-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/4", "thumbnail_src": "https://si.imgix.net/52841c7b/uploads/origins/8fe3db94-d258-499f-a433-ce9851467ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1954e82b2b7a9f1f71565f9f95712702", "thumbnail_srcset": "https://si.imgix.net/52841c7b/uploads/origins/8fe3db94-d258-499f-a433-ce9851467ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1954e82b2b7a9f1f71565f9f95712702, https://si.imgix.net/52841c7b/uploads/origins/8fe3db94-d258-499f-a433-ce9851467ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=582c0e10347005390dadef650622e011 2x, https://si.imgix.net/52841c7b/uploads/origins/8fe3db94-d258-499f-a433-ce9851467ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af9e3cf49e0c98550282ff010f1bc6a6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いいんちょうと申します。\n「デイズ・オン・フェス」の時から岡先生の描かれる漫画のファンで、この度skebを開かれるとのこと心待ちにしておりました。岡先生の漫画の登場人物の、繊細な心象風景が伝わってくるキャラクターデザインがとても好きです。\n\n今回ご依頼させて頂きたい内容は、\nTRPGにて作成した私のオリジナルキャラクターのイラスト（単体）となります。 \n\n●キャラクター詳細\n名前：白磁（はくじ）\n性別・種族：男性型アンドロイド\n身長：178cm\n好きなこと：人と関わること\nイメージカラー：白\n見た目の特徴：白髪に黒いヘアバンドが特徴。左の膝部分だけ水色の球体状の関節になっている。首元に桔梗のタトゥー、肩に近い二の腕にハート型の刻印がある。\n性格：明るく、天真爛漫で表情豊か。スポーツ万能で足が速い。パートナーとなる人間にはよく懐き忠誠心が強いが、反面嫉妬深く子供っぽい一面もある。\n\n●キャラクター外見情報\n下記に外見資料をアップしております。 依頼内容にも資料内にもTRPGシナリオに関するネタバレは一切含まれておりません。\nhttps://drive.google.com/drive/folders/14WwxTSoz3GNj0oFYU-Gz8Gp8GraMdQAR?usp=sharing\n\n●使用用途\n私的に楽しませて頂きたいと考えております。どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/3", "thumbnail_src": "https://si.imgix.net/5d48f371/uploads/origins/9fb49726-046e-49f6-bb73-a2b81f510d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034d66d8ec48088ad7b6e45eafd0cba8", "thumbnail_srcset": "https://si.imgix.net/5d48f371/uploads/origins/9fb49726-046e-49f6-bb73-a2b81f510d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034d66d8ec48088ad7b6e45eafd0cba8, https://si.imgix.net/5d48f371/uploads/origins/9fb49726-046e-49f6-bb73-a2b81f510d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa866716d5f543ba2bea90dcc2f89737 2x, https://si.imgix.net/5d48f371/uploads/origins/9fb49726-046e-49f6-bb73-a2b81f510d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7a4ea43dbb20232705ee12b3c763598 3x", "genre": "art", "nsfw": false, "body": "はじめまして、ヤン飯からファンになりました。\nこのたびskebを実施されるとのことで、辛抱たまらず飛び込ませていただきました。\nもしご都合がよければご検討いただけたら嬉しいです。\n\n待っていればいつか拝める機会があるかもしれませんが、どうか「ハイネック姿の猫村蘭先生」を描いていただけないでしょうか。\n蘭先生の大ファンです、あらゆるお話がツボです。先生の普段とか、過去とか、やる気ないない言いながら結局いろんな子の面倒を見ちゃうところとかが全部最高です。早く海里くんに味噌汁教えてあげたこと千秋くんにバレてほしいです。素敵なキャラに出会わせてくださりありがとうございます。\n今後も千秋くんといろんな料理に挑戦（の、見守り）をしていく姿を楽しみにしています。\n\n\n日々の楽しみをありがとうございます。これからも陰ながら活動を応援しております。", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/2", "thumbnail_src": "https://si.imgix.net/b1aa9367/uploads/origins/59e1ea0f-0225-4ae7-9fa4-cb51729025fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb63c80e8faaf4fce681e582ddbdc7e", "thumbnail_srcset": "https://si.imgix.net/b1aa9367/uploads/origins/59e1ea0f-0225-4ae7-9fa4-cb51729025fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb63c80e8faaf4fce681e582ddbdc7e, https://si.imgix.net/b1aa9367/uploads/origins/59e1ea0f-0225-4ae7-9fa4-cb51729025fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6b0b931816f13fa898d95371e0fd721 2x, https://si.imgix.net/b1aa9367/uploads/origins/59e1ea0f-0225-4ae7-9fa4-cb51729025fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70b8c0ff9f71671e4624b6902d8a9ec6 3x", "genre": "art", "nsfw": false, "body": "岡先生のSkeb試運転と聞いて！\nうちの子OKでしたら、下記URLのキャラクターのイラストをお願いします！\nhttps://twitter.com/gx_segnus/status/1632369805780205570\nhttps://skeb.jp/@tsushima_u/works/3\n20代男性、魔法使いや精霊使いに類するキャラクターです。\n\nポーズ、具体的なシチュエーションや背景有無などはお任せします。\nハリネズミっぽい生き物（使い魔・精霊のような存在です）の描写有無はお任せします。\n服装はアレンジや小物追加、まったく別の服装もOKです。\nその他不明な点などもお好きに描いていただいてOKです。", "created_at": "", "completed_at": ""}, {"path": "/@3knt28/works/1", "thumbnail_src": "https://si.imgix.net/c762bc77/uploads/origins/59817de5-fec6-4f7d-a6dc-0aab476d10fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27597502e4e8249f5c469f4cc9e398c3", "thumbnail_srcset": "https://si.imgix.net/c762bc77/uploads/origins/59817de5-fec6-4f7d-a6dc-0aab476d10fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27597502e4e8249f5c469f4cc9e398c3, https://si.imgix.net/c762bc77/uploads/origins/59817de5-fec6-4f7d-a6dc-0aab476d10fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b4133730d3649413318a5b575a28ba0 2x, https://si.imgix.net/c762bc77/uploads/origins/59817de5-fec6-4f7d-a6dc-0aab476d10fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d07a17363151a12e9094408b4703f6e 3x", "genre": "art", "nsfw": false, "body": "初めまして！Skebの方が開設されたと聞きまして……\n\nもしよければ創作/TRPGで使用しているキャラを描いて頂けないでしょうか？\n外見は資料URLの方からご覧頂けたらなと思います。\n\n・薄紫の髪に、紫と緑のオッドアイ\n・黒縁メガネに花モチーフのピアスをつけている\n・甘い物が大好きな不思議系お兄さん、実際は好奇心旺盛がすぎる人。\n・正体は植物を操る魔法使いの人\n・お菓子か花どちらか持たせて頂けると嬉しいです\n\n不明部分などありましたら、お好きに描いたりアレンジしてくださって構いません！ 宜しくお願いいたします！！\n\nhttps://twitter.com/muginantoka/status/1304084561526104065?s=21", "created_at": "", "completed_at": ""}]}