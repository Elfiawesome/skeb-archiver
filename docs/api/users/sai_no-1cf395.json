6f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6e973ee597198efa37e22904769026b 2x, https://si.imgix.net/70148818/uploads/origins/b6b0650a-8222-4ea5-9321-e6ff388f6f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54340c7bbdbc6571e2de4f8f2eba9874 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの女の子メルシナが本当に大好きです。\n\n\nできれば、メルちゃんと私のドラゴンガールのシエナを会わせたいと思っています。二人とも力強いポーズをとってほしいです。チームメイトで、シーンに登場しない敵とも戦えるような。私のシエナには特殊能力はなく、筋肉だけです。\n\n全身でも半身でも構わないので、ふさわしい構図を選んでください。  \n\n私のアイデアを表現した画像をいくつか掲載しました。全身、半身、問いませんので、お好きな構図でお願いします。\n\nこのメルの画像はとても力強く、このアイデアのインスピレーションを与えてくれました https://twitter.com/sai_no/status/1378014806809014275\n\nhttps://imgur.com/a/qDu9hyl", "created_at": "", "completed_at": ""}, {"path": "/@sai_no/works/34", "thumbnail_src": "https://si.imgix.net/c544f1fd/uploads/origins/08c3fe2b-b158-41be-888f-7159ac9ffebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdda5e84319073e471adc611907e227b", "thumbnail_srcset": "https://si.imgix.net/c544f1fd/uploads/origins/08c3fe2b-b158-41be-888f-7159ac9ffebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdda5e84319073e471adc611907e227b, https://si.imgix.net/c544f1fd/uploads/origins/08c3fe2b-b158-41be-888f-7159ac9ffebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2acb4515d5188eb6f7ac826a1c3dcd30 2x, https://si.imgix.net/c544f1fd/uploads/origins/08c3fe2b-b158-41be-888f-7159ac9ffebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2844aca20c630da3dc26daa6214f800e 3x", "genre": "a