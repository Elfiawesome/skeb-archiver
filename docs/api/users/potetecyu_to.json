//twitter.com/potetecyu_to/status/1493490978405351427 https://twitter.com/potetecyu_to/status/1566028855134937096\n\nhttps://drive.google.com/file/d/1FZ1We4J2B0gR-5y5P5FxJAP4H9pB5SVk/view?usp=drive_link\nhttps://drive.google.com/file/d/1QSwPFR4Jf9uoa-HoRPGi0ZFDFlmtIaxF/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@potetecyu_to/works/32", "thumbnail_src": "https://si.imgix.net/1410e639/uploads/origins/97fea98b-bf88-44ee-929a-d15a09a4017b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b217c0839421b82290b3699fdbde2be", "thumbnail_srcset": "https://si.imgix.net/1410e639/uploads/origins/97fea98b-bf88-44ee-929a-d15a09a4017b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b217c0839421b82290b3699fdbde2be, https://si.imgix.net/1410e639/uploads/origins/97fea98b-bf88-44ee-929a-d15a09a4017b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fbd396c73bd019660b3300c1876d31a 2x, https://si.imgix.net/1410e639/uploads/origins/97fea98b-bf88-44ee-929a-d15a09a4017b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03ef5ba0dde1343d9c637a44af213936 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのスタイルはとてもキュートですね！かわいい表情のペガサスをお願いします。緑のスカーフを巻いているところをお願いします。ポーズなどはお任せします！\n\nhttps://imgur.com/a/npoEdwm", "created_at": "", "completed_at": ""}, {"path": "/@potetecyu_to/works/31", "thumbnail_src": "https://si.imgix.net/bb35157d/uploads/origins/c95cf134-54e9-4c76-b7ba-5acee21c0d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2964e0e593ba946a1ae102a73e92407", "thumbnail_srcset": "https://si.imgix.net/bb35157d/uploads/origins/c95cf134-54e9-4c76-b7ba-5acee21c0d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2964e0e593ba946a1ae102a73e92407, https://si.imgix.net/bb35157d/uploads/origins/c95cf134-54e9-4c76-b7ba-5acee21c0d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c681