ix.net/07f68ef5/uploads/origins/86b92650-c441-4189-bc35-aeba10d1f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71bb306e83c1d2844f9736f76e7fc920", "thumbnail_srcset": "https://si.imgix.net/07f68ef5/uploads/origins/86b92650-c441-4189-bc35-aeba10d1f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71bb306e83c1d2844f9736f76e7fc920, https://si.imgix.net/07f68ef5/uploads/origins/86b92650-c441-4189-bc35-aeba10d1f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0978fdf4c3df1159101ce07fa3c82819 2x, https://si.imgix.net/07f68ef5/uploads/origins/86b92650-c441-4189-bc35-aeba10d1f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61eba3dac7968dd40ee97d867a9f932d 3x", "genre": "art", "nsfw": false, "body": "雪月かなめさん　先日は悩ましいブラッドベリーのイラストありがとうございました。\nそこでまた別の衣装体操服にブルマーでイラストをお願いできませんでしょうか？\nあと前回のイラストのファイルが説明と少し違っていたのでそこもリメイクいただければと思います。\nあと予算不足の場合は一度再送してください。\n以上ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yukizukikaname/works/10", "thumbnail_src": "https://si.imgix.net/3b5ca7b1/uploads/origins/982a86b6-6f98-45e6-b50d-9ca14420c71f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e6b518c85df64611bedf1d22d7a0b0e", "thumbnail_srcset": "https://si.imgix.net/3b5ca7b1/uploads/origins/982a86b6-6f98-45e6-b50d-9ca14420c71f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e6b518c85df64611bedf1d22d7a0b0e, https://si.imgix.net/3b5ca7b1/uploads/origins/982a86b6-6f98-45e6-b50d-9ca14420c71f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37b384b14380cd6e91919f29204e306e 2x, https://si.imgix.net/3b5ca7b1/uploads/origins/982a86b6-6f98-45e6-b50d-9ca14420c71f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15a2a997ddd76968c7d31a46a2a516ee 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！私のVtuberのアバターをバニースーツで描いてくれたのがとても気に入ったので、他のキャラクターもお願いしたいです！私のサイレンのOC、レイラニを緑のバニースーツで描いてください。緑と青の宝石がついたシルバーのネックレスと、参考画像で彼女が持っているものと同じ形と色の宝石がついたシルバーのブレスレットをお願いします。\n\nhttps://imgur.com/huDki9j", "created_at": "", "completed_at": ""}, {"path": "/@yukizukikaname/works/9", "thumbnail_src": "https://si.imgix.net/4c4ec383/uploads/origins/fb0e5ed9-f26f-4701-a21a-4af272349b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a53e103db42c7f9ab40806b1a48ee3b", "thumbnail_srcset": "https://si.imgix.net/4c4ec383/uploads/origins/fb0e5ed9-f26f-4701-a21a-4af272349b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a53e103db42c7f9ab40806b1a48ee3b, https://si.imgix.net/4c4ec383/uploads/origins/fb0e5ed9-f26f-4701-a21a-4af272349b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8d21bc12e47279552f03911a4e59da0 2x, https://si.imgix.net/4c4ec383/uploads/origins/fb0e5ed9-f26f-4701-a21a-4af272349b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef97fd2a0119b511c89853e581995197 3x", "genre": "art", "nsfw": false, "body": "セイバーマリオネットJのブラッドベリーのイラストをお願いいたします。\n彼女がバニースーツまたはジャージにブルマーなど魅力たっぷりに描いて頂きたいです。ファイル形式はpsd形式が希望です。予算の範囲で差分等があると嬉しいです。以上御検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yukizukikaname/works/8", "thumbnail_src": "https://si.imgix.net/42a5e30f/uploads/origins/283bbdbe-2d62-4a7f-a241-641723da2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=577ad71f5c2b75bad52beea4fc05ea5e", "thumbnail_srcset": "https://si.imgix.net/42a5e30f/uploads/origins/283bbdbe-2d62-4a7f-a241-641723da2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=577ad71f5c2b75bad52beea4fc05ea5e, https://si.imgix.net/42a5e30f/uploads/origins/283bbdbe-2d62-4a7f-a241-641723da2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6373222d0c2dc9b9f758cac9f34b808 2x, https://si.imgix.net/42a5e30f/uploads/origins/283bbdbe-2d62-4a7f-a241-641723da2be3?bg=%23fff&auto=form