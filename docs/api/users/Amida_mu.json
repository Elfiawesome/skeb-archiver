af105-9230-47e0-b7aa-0ddcac65bd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0566194426f4f291c5080389f7f2d46", "thumbnail_srcset": "https://si.imgix.net/eadf73f4/uploads/origins/efcaf105-9230-47e0-b7aa-0ddcac65bd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0566194426f4f291c5080389f7f2d46, https://si.imgix.net/eadf73f4/uploads/origins/efcaf105-9230-47e0-b7aa-0ddcac65bd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c151838b4917f9dd7a42974e2dd47e7 2x, https://si.imgix.net/eadf73f4/uploads/origins/efcaf105-9230-47e0-b7aa-0ddcac65bd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1757ff573aba49fca233cb352f85d12 3x", "genre": "art", "nsfw": false, "body": "こんにちは \nはじめてSkebでの依頼をします\n\n【リクエスト内容】\nボンバーガール オレンを描いて欲しいです\n構図は、しゃがみの状態\n口を開いて 口の中(のどちんこも見える)を\n見せて貰っている図です\n※舌や頬の内側がねっとり感やオレン特有の\nギザ歯もお願いします\nそして指で口の中を指しているポーズにしてください\nセリフとして『これでいいのか？相棒』\n『変わった趣味なんだぜ』 と言ってほしいです\n\n\n以上になります。\nよろしくお願いいたします\n\nhttps://www.pixiv.net/artworks/130759112", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/65", "thumbnail_src": "https://si.imgix.net/89e3041d/uploads/origins/213ca8a1-beaf-4e9c-9cdb-10d65be871ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1abfdf0faf51e273e9f4d61494c105c4", "thumbnail_srcset": "https://si.imgix.net/89e3041d/uploads/origins/213ca8a1-beaf-4e9c-9cdb-10d65be871ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1abfdf0faf51e273e9f4d61494c105c4, https://si.imgix.net/89e3041d/uploads/origins/213ca8a1-beaf-4e9c-9cdb-10d65be871ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4fda859864b676431825f336fea5fee 2x, https://si.imgix.net/89e3041d/uploads/origins/213ca8a1-beaf-4e9c-9cdb-10d65be871ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c84c8db377c86d21053375a113e6eab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/64", "thumbnail_src": "https://si.imgix.net/b91aa2b2/uploads/origins/29991503-042c-47d5-922a-d7aceac89164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=677dfb9543e74108e345f4a92b50c5ce", "thumbnail_srcset": "https://si.imgix.net/b91aa2b2/uploads/origins/29991503-042c-47d5-922a-d7aceac89164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=677dfb9543e74108e345f4a92b50c5ce, https://si.imgix.net/b91aa2b2/uploads/origins/29991503-042c-47d5-922a-d7aceac89164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b099c720a600f5a53251795322ccd23 2x, https://si.imgix.net/b91aa2b2/uploads/origins/29991503-042c-47d5-922a-d7aceac89164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=451632b2b72205dfab00b874a958b13e 3x", "genre": "art", "nsfw": true, "body": "ボンバーガールのパインをお願いします\n着衣のまま下着は履いてままずらして、可能なら胸元を開けて下さい\n\n正常位でアナルセックスしているところを\nパインは顔を赤らめながらこんなの余裕なんですけど、自信満々\n口からは精液と涎をこぼしながら\n挿れられている男性器は大きめで\n可能な範囲で構わないので挿れられるとこから中出しされて抜かれるまでの差分をお願いします\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/63", "thumbnail_src": "https://si.imgix.net/15751a7f/uploads/origins/33d6bbd5-19c5-4372-a461-95b2348069cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb3eee8260184d71009f35aaf07ee7a1", "thumbnail_srcset": "https://si.imgix.net/15751a7f/uploads/origins/33d6bbd5-19c5-4372-a461-95b2348069cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb3eee8260184d71009f35aaf07ee7a1, https://si.imgix.net/15751a7f/uploads/origins/33d6bbd5-19c5-4372-a461-95b2348069cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b94cd4a73bb8dcd48b7cbb048bc8b48 2x, https://si.imgix.net/15751a7f/uploads/origins/33d6bbd5-19c5-4372-a461-95b2348069cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fe531e2e5b5169e5e6dd5ab9f0f8d15 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n前回のリクエストで描いていただいた精液採取の内容で色々と妄想が掻き立てられましたので、またリクエスト失礼致します。\n\n今回は、ドラゴン娘ちゃんとお友達が対面座でセックスしているイラストをお願いします。\nお友達はドラゴン娘ちゃんの大きなふたなりちんぽに快楽に浸って愉しみ、ドラゴン娘ちゃんは本当に実験なのか？と内心疑いながらも、手でする時と比べ物にならないくらいの気持ち良さに我慢が出来ず、お友達の膣内にいっぱい出してしまいます。\nそれに対してお友達は怒るなどのネガティブな感情は抱きません。むしろ「いっぱい出たねぇ」ってヨシヨシする感じの反応をします。\n\n【詳細】\n行為中の二人ですが、前回と同じくお友達が優位な状態でなら、何をしてても構いません。\nキスをしてたり、お友達の言われるがままドラゴン娘ちゃんが抱きしめてたり、逆にお友達がドラゴン娘ちゃんの胸をいじったりなど色々な情景が浮かびましたが、ちょっと決められませんので、その辺りはお任せします……\nただ、ながらエッチ(援交モノとかにありがちな、本を読んだり、誰かとメッセージのやりとりをしたり…みたいに行為に意識が向いてない感じの行動)はNGで！\n\nそれと場所ですが、学生寮内にあるお友達の部屋とかだったら良いなーと考えてます。\n色々な実験器材や標本とか、友達同士で撮った写真とか、そういうのがある部屋だったらなぁと…\n\nあと思いっきり膣内に出す流れになりますが、デキるかどうかの判断もお任せします。\n避妊魔法とか種族や性別の関係で出来なかったとか、逆に学生なのにデキたとかになっても面白いかも…？\n\n【以前の絵を見て思い付いた二人の事や、心境的なの】\n・ドラゴン娘ちゃん\nお友達の口車に乗せられて、なし崩しにお友達とセックスする事に。\n本人はお友達が話した魔法実験の一環と信じておりセックスしているとは理解していないが、「な、なぁ…これ本当に魔法実験なのか…？」ってちょっと疑ってる。\nただ、それはそれとしてお友達からのエッチな行為の後はちゃんと勉強もしっかり教えてもらっており、本人は気付いていないが頭がスッキリした状態で勉強した影響で、成績はちょっとずつだけど上がっているので、それに関してはお友達に感謝している。\n\n・お友達\nドラゴン娘ちゃんの勉強を教える代わりに魔法実験関連のお手伝いをしてもらっているお友達。\n以前の精液採取で味を占めたか或いは何かに火が着いたのか、最近では実験とはあまり関係ないのに、ドラゴン娘ちゃんを実験だ何だと色々言いくるめて度々エッチなことをするようになった。その後ちゃんと勉強も教えてる。\nあとふたなりではない。\n…この子多分放課後ドラゴン娘ちゃんの席でオナニーとかしてそうだな……\n\nまた長くなりましたが、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/62", "thumbnail_src": "https://si.imgix.net/857a6dc8/uploads/origins/ed6a5842-bf6d-4545-a67e-53eaf3c9c051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aaa1f0c2586bb813f31f82f96422b10", "thumbnail_srcset": "https://si.imgix.net/857a6dc8/uploads/origins/ed6a5842-bf6d-4545-a67e-53eaf3c9c051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aaa1f0c2586bb813f31f82f96422b10, https://si.imgix.net/857a6dc8/uploads/origins/ed6a5842-bf6d-4545-a67e-53eaf3c9c051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed7ff505eff702627343e98588d817c3 2x, https://si.imgix.net/857a6dc8/uploads/origins/ed6a5842-bf6d-4545-a67e-53eaf3c9c051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=239305141348e6f2b36daecb233a8de4 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/61", "thumbnail_src": "https://si.imgix.net/9548bb6c/uploads/origins/70562acd-76fb-4701-beed-815a388006a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5878f5c1397fd69c6378b9942ed570c3", "thumbnail_srcset": "https://si.imgix.net/9548bb6c/uploads/origins/70562acd-76fb-4701-beed-815a388006a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5878f5c1397fd69c6378b9942ed570c3, https://si.imgix.net/9548bb6c/uploads/origins/70562acd-76fb-4701-beed-815a388006a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8db3d8045f66470501649565f5c6c25c 2x, https://si.imgix.net/9548bb6c/uploads/origins/70562acd-76fb-4701-beed-815a388006a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ea766b8b9179661b96ce12f1d34cbfe 3x", "genre": "art", "nsfw": false, "body": "こんにちは!「Hahzel」と「Song」を一緒に描き、不機嫌な顔や邪悪な顔で観客を見つめてください!衣装など、描きたい鮮やかな表情は何でも構いません! \n\nhttps://www.dropbox.com/sh/k49y11h9q99asrg/AACioS2Vqk8gnN1hlxEGxZlVa?dl=0\n\nhttps://www.dropbox.com/sh/2rcuixhg9bw824b/AABi4DtkRK3EQDRWmzfeTDJja?dl=0\n\nhttps://www.dropbox.com/sh/z7uz7rkv7hsp1fs/AACxqIlesJvPyKxC3tsMHfRBa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/60", "thumbnail_src": "https://si.imgix.net/2bab6d5e/uploads/origins/8939b53c-46c8-4131-9b5f-93c923a612b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c8b8721d0ac64f964d8747f5d9f889", "thumbnail_srcset": "https://si.imgix.net/2bab6d5e/uploads/origins/8939b53c-46c8-4131-9b5f-93c923a612b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c8b8721d0ac64f964d8747f5d9f889, https://si.imgix.net/2bab6d5e/uploads/origins/8939b53c-46c8-4131-9b5f-93c923a612b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7606bc1f118d3b6d95976a9ad149f92a 2x, https://si.imgix.net/2bab6d5e/uploads/origins/8939b53c-46c8-4131-9b5f-93c923a612b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=265cda6faee3d44d6c436c84f0590d77 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します！\n\n魔法学校に通うふたなりのドラゴン娘が、誰もいない校舎裏にて、立ちバックで自分の勃起ちんぽをクラスの女友達に扱かれて、射精させられるイラストをお願いします。\n\nドラゴン娘は半ば無理矢理射精させられますが、後日友達の研究結果を見せてもらったドラゴン娘はそんな事を気にせず「すげぇーっ！」って目を輝かせます。\n\n【詳細】\n友達はその精液を魔法の研究の材料に使う為、射精された精液をビーカーか試験管かに直接注ぐように採取しようとしています。\nしかし具体的な魔法の研究ですが、魔法薬関連か魔法生物関連かは特に考えていません…\n無理矢理射精させる為、魔法による身体の拘束をするかどうかはお任せします。\n\n【ドラゴン娘ちゃんの容姿の特徴】\n・資料はあくまでイメージです。見た通りでなく、あみださんのお好みでアレンジして頂いて構いません。\n・身体はヒト要素強めですが、尻尾とツノはしっかりあるタイプです。資料の子は翼が生えていますが、構図的に邪魔になる場合翼がなくても構いません。\n・赤系統の色の髪でお願いします。髪型はお任せしますが、運動するのが得意な元気っ子みたいな感じで…\n・ちょっと吊り目気味な割とアホっぽい感じの顔立ちだと良いですね…実際アホの子を考えてます。\n・シチュエーションにもある通りふたなりです。通常サイズは普通か小さめですが、勃起するとスカートで隠せないくらいの長さになると考えてます。形状は人系でも爬虫類系でもどちらでも…\n・おっぱいはそこそこあると良いなって思ってます。\n\n【設定】\n魔法学校に通うドラゴン娘。内に秘めた魔力は凄まじく高かった事を見出され、見事推薦入学する事が出来ましたが、頭脳はアホなので上手く魔法を扱えず、そのせいか成績はそんなに良いほうではありません。\nしかし割と明るく元気な性格なので友達はそこそこいて、教室では仲の良い女友達に勉強を教えてもらっている姿をよく目撃されています。\n性知識は、自分の性器を弄ると凄く気持ち良くなる事と、その様子を誰かに見られるのがすごく恥ずかしいので見られたくない事以外皆無です。裸自体は別に見られても平気ですが。\n\n長くなってしまいましたが、よろしくお願いします！\n\nhttps://x.com/ctmnlibrary/status/1882452661859176568?s=46&t=dhj0Siytu2RTK2M14WH1-A", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/59", "thumbnail_src": "https://si.imgix.net/b8201c3f/uploads/origins/a27c941d-ed72-422b-834e-911677689425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619c9ad458bef02dbc287420d6894c8b", "thumbnail_srcset": "https://si.imgix.net/b8201c3f/uploads/origins/a27c941d-ed72-422b-834e-911677689425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619c9ad458bef02dbc287420d6894c8b, https://si.imgix.net/b8201c3f/uploads/origins/a27c941d-ed72-422b-834e-911677689425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec6bffa73b2a8e2a53d04e4acb684e35 2x, https://si.imgix.net/b8201c3f/uploads/origins/a27c941d-ed72-422b-834e-911677689425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6efd045858814f671d33d2c3617ea08d 3x", "genre": "art", "nsfw": false, "body": "初めまして。KOHAK_1114（こはく）と申します。\nボンバーガールの配信のサムネに使うイラストをお願いします。\n\n内容は、チグサと僕のアイコンやヘッダーに使われてるオリキャラを描いていただきたいです。\nチグサは通常衣装で剣を構えている姿でお願いします。構え方はお任せします。\nオリキャラの方は片手にボムを抱えている姿でお願いします。衣装はアイコンやヘッダーのものと同じものでお願いします。\n立ち位置はチグサが左、オリキャラが右で背中を合わせて顔は二人ともこちらを向いているもの。表情はチグサが企んでそうな感じ（いつもしている顔）でオリキャラの方は歯を出して笑っているものでお願いします。\nアングルは少し下からのもの、雰囲気はカッコイイのもでお願いします。背景はお任せします。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Amida_mu/works/58", "thumbnail_src": "https://si.imgix.net/40fc3c62/uploads/origins/bbb41992-5fa9-4a09-8dd2-d05a39d5a1df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=295d2389aee165bfa0cbb67b23374d37", "thumbnail_srcset": "https://si.imgix.net/40fc3c62/uploads/origins/bbb41992-5fa9-4a09-8dd2-d05a39d5a1df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top