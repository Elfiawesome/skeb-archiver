/origins/bd82fcda-7c40-4dec-87eb-74a9a5193f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=005fb963c50a565b9b2a56f74efe4ddc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kusatsumirei/works/126", "thumbnail_src": "https://si.imgix.net/bd193ec2/uploads/origins/99c8cb65-a861-4167-abe3-19b827b4b91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7383a609851bc9e67ff2b37ec7b3eafe", "thumbnail_srcset": "https://si.imgix.net/bd193ec2/uploads/origins/99c8cb65-a861-4167-abe3-19b827b4b91e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7383a609851bc9e67ff2b37ec7b3eafe, https://si.imgix.net/bd193ec2/uploads/origins/99c8cb65-a861-4167-abe3-19b827b4b91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7f317eb2827aeabcc0a431980afdd4a 2x, https://si.imgix.net/bd193ec2/uploads/origins/99c8cb65-a861-4167-abe3-19b827b4b91e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b21ef2dc98df189572e7a76ac1afc1e 3x", "genre": "art", "nsfw": true, "body": "キミとアイドルプリキュアの紫雨こころと紫雨愛の母娘連縛をリクエストさせてください。2人は下着姿にされた後、猿轡として口にテープを貼られて胸の上下と手足を縛られている。お互いに心配をしつつ、もがきながら呻き声を上げている様子をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kusatsumirei/works/125", "thumbnail_src": "https://si.imgix.net/6e904449/uploads/origins/051b7236-9bb8-4872-a690-854b00a3f625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=300183bc7f6ae19f634f6446a87f2e73", "thumbnail_srcset": "https://si.imgix.net/6e904449/uploads/origins/051b7236-9bb8-4872-a690-854b00a3f625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=300183bc7f6ae19f634f6446a87f2e73, https://si.imgix.net/6e904449/uploads/origins/051b7236-9bb8-4872-a690-854b00a3f625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2777361ce722b6ec911867287e0daa5 2x, https://si.imgix.net/6e904449/uploads/origins/051b7236-9bb8-4872-a690-854b00a3f625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a6f8998616447fb91a699668d696b82 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。またリクエストをさせていただきます。\n「政宗くんのリベンジ」より安達垣愛姫、小岩井吉乃、藤ノ宮寧子、双葉妙、早瀬千夏の５人が下着姿にされてダクトテープで猿轡＆後ろ手＆胸の上下＆太もも＆足首を縛られており、構図的に正面を向いている状態で、テープを解こうと一生懸命もがいている様子をお願いいたします。\n※文章に抜けがありましてキャンセル＆再申請しました。申し訳ございません。", "created_at": "", "completed_at": ""}, {"path": "/@kusatsumirei/works/124", "thumbnail_src": "https://si.imgix.net/3203d10f/uploads/origins/1096be4b-b3e8-4313-898a-4363f6caefa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4f703aad6f02dfa3667fb41db1ac5ad", "thumbnail_srcset": "https://si.imgix.net/3203d10f/uploads/origins/1096be4b-b3e8-4313-898a-4363f6caefa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4f703aad6f02dfa3667fb41db1ac5ad, https://si.imgix.net/3203d10f/uploads/origins/1096be4b-b3e8-4313-898a-4363f6caefa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49ddf1d8720ca927ca70dc97300790e0 2x, https://si.imgix.net/3203d10f/uploads/origins/1096be4b-b3e8-4313-898a-4363f6caefa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c76212373afe0270271dd3c94ca6e8b6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kusatsumirei/works/123", "thumbnail_src": "https://si.imgix.net/df1c9af0/uploads/origins/98548461-131f-4365-9082-3c6e17a3c092?bg=%23fff&auto=format%