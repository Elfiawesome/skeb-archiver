8-4f8b-a5bc-41e0c11b5ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4089de3fa8ff1b78a8472bf2c730cac 2x, https://si.imgix.net/a998d5a0/uploads/origins/2a5aacac-77c8-4f8b-a5bc-41e0c11b5ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5612637648f51a520066a1bca5e7a13 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nつくにょ先生の絵を拝見し、とても好きなので、イラストのリクエストをさせて頂きたいです。\n\nVtuber「花咲くれは」(@_KRHana) さんを描いてお願いしたいです\n(ご本人からもファンアート依頼の許可はいただいております。)\n構図やシチュエーションなど、他の要素については全てお任せします。\n\nもし可能であれば、顔まわりの髪、髪の毛は画角内に収めていただけると幸いです。\n\n使用用途は花咲くれはさんへのプレゼントとして、\nご本人に限りの配信活動での使用許可を頂きたいです。\n（配信内や、配信のサムネ、X(旧Twitter)等で使用する可能性があります。）\n\nまた、宛名・人物・背景でレイヤー分けされたPSDで頂けますと幸いです。\n\nお忙しいところ申し訳ございませんが、ご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\n\n参考資料：\nhttps://x.com/_KRHana\nhttps://x.com/_KRHana/status/1879550528163901488", "created_at": "", "completed_at": ""}, {"path": "/@biscuit___cake/works/44", "thumbnail_src": "https://si.imgix.net/a2c6fd18/uploads/origins/fb33fa29-4878-4a13-8c9e-f1d9b30af7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e60bfdbf12733f7acb1c4b5d2c335b", "thumbnail_srcset": "https://si.imgix.net/a2c6fd18/uploads/origins/fb33fa29-4878-4a13-8c9e-f1d9b30af7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e60bfdbf12733f7acb1c4b5d2c335b, https://si.imgix.net/a2c6fd18/uploads/origins/fb33fa29-4878-4a13-8c9e-f1d9b30af7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e70d215cee1db03a115c15e55d3bfd94 2x, https://si.imgix.net/a2c6fd18/uploads/origins/fb33fa29-4878-4a13-8c9e-f1d9b30af7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7607f9140a90ee8e5a590301a2d9a91 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品に出会い、かわいいイラストに一目惚れしました！私のパン屋VtuberのOC、ミントマイの絵をお願いしたいです。黒髪黒目の元気なパン屋さんです。パンが大好きです！パンやパン屋さんのモチーフをたくさん入れて、うさぎのお友達も描いていただけると嬉しいです。\n\n過去の作品のように、Twitterのバナーとして描いていただけませんか？→ https://skeb.jp/@biscuit___cake/works/2\n\n[参考URL］\nみんまい：\nhttps://drive.google.com/file/d/1ZX6bxG5x96gnnwI2pjXBRtc_Hp_ech3Y/view?usp=drive_link\nhttps://drive.google.com/file/d/1KXRwicuPD_c_PC9O0DHCffebtjLT4WYa/view?usp=drive_link\nうさ友：\nhttps://drive.google.com/file/d/1E3w6cY1jV-ViC-X0zHQScU35rKYsf3dT/view?usp=drive_link\nhttps://drive.google.com/file/d/1Gx7vdmkqs6xR9vk-Kit1_ePqRa2YZ2V2/view?usp=drive_link\n\n[使用について］\nSNS、YouTube等で使用、共有させていただく場合があります。\n\nご検討の程よろしくお願い致します！(♡ˊ͈ ꒳ ˋ͈)", "created_at": "", "completed_at": ""}, {"path": "/@biscuit___cake/works/43", "thumbnail_src": "https://si.imgix.net/edcbe06e/uploads/origins/3c708081-f61c-479d-8941-3c1c4af2ab8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7dedac0cfb85f268188e3bf83dcfa0", "thumbnail_srcset": "https://si.imgix.net/edcbe06e/uploads/origins/3c708081-f61c-479d-8941-3c1c4af2ab8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7dedac0cfb85f268188e3bf83dcfa0, https://si.imgix.net/edcbe06e/uploads/origins/3c708081-f61c-479d-8941-3c1c4af2ab8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b677c2f1314ba0df6c43bd79cd52c790 2x, https://si.imgix.net/edcbe06e/uploads/origins/3c708081-f61c-479d-8941-3c1c4af2ab8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bf66129a0a45203edbf4050a54d4744 3x", "genre": "art", "nsfw": false, "body": "九十三ビス様初めまして\nTwitterで拝見させて頂いてるスイーツとケモミミさんのイラストがすごくかわいらしくてステキで、もしよろしければ私のCOのリビを描いていただけたら嬉しいなと思いリクエストさせて頂きました。\n\nリビは機械弄りと探検の好きな冒険者の女の子です。\n性格は好奇心旺盛で末っ子気質。\n隠れている左目は濃いグリーンでオッドアイになっています。\nやわらかな大きなミミがチャームポイントなので大きめに描いていただけると嬉しいです。\n衣装や構図は九十三ビス様にお任せ致します、ご自由にお描きください！！\n\n作品は個人観賞にて楽しませていただきます。\n何卒ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1a_9_Rpdy60SCqEuaEMjAbfGYrxZH_yMn?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@biscuit___cake/works/42", "thumbnail_src": "https://si.imgix.net/fea3d9e3/uploads/origins/b9af7ed8-3cc9-4141-bc2b-8b2dedfa46cc?bg=%23fff&auto=format%2