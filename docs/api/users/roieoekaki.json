f00b-433d-a235-6d6f85b7748f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15e6b2bf4ac5787d984460232f531ac, https://si.imgix.net/ae3eac41/uploads/origins/6a1fac3f-f00b-433d-a235-6d6f85b7748f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70f3ad5c813d6326565a2e10c1aa187d 2x, https://si.imgix.net/ae3eac41/uploads/origins/6a1fac3f-f00b-433d-a235-6d6f85b7748f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26474a43fe398a66d864052963ea71d2 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nskeb作品を拝見しました。\n絵柄がとても可愛らしくて好みでした◎\n\nもしも差し支えなければ、わたしのOCのイラストを描いていただけないでしょうか。\n\n描いていただいたイラストはXやpixivのアイコンに設定したいです。また可能であれば、趣味で発行している同人誌の後書きページ(作者アイコン画像)や、同人イベント参加時に配布する名刺などにも利用できたら嬉しいです。\n\nお忙しい中大変恐れ入りますが、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1khVuFrgagy-HConi5Gvzw_SsthDxjPyK\n\nhttps://drive.google.com/drive/folders/1khVuFrgagy-HConi5Gvzw_SsthDxjPyK", "created_at": "", "completed_at": ""}, {"path": "/@roieoekaki/works/1313", "thumbnail_src": "https://si.imgix.net/bfd0fccd/uploads/origins/51d87e96-bf79-4652-8d7c-1747e79e6482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536c210268050d7105640ab6c687d90e", "thumbnail_srcset": "https://si.imgix.net/bfd0fccd/uploads/origins/51d87e96-bf79-4652-8d7c-1747e79e6482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536c210268050d7105640ab6c687d90e, https://si.imgix.net/bfd0fccd/uploads/origins/51d87e96-bf79-4652-8d7c-1747e79e6482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57f7e25e49648caa6c14db89012f9f9f 2x, https://si.imgix.net/bfd0fccd/uploads/origins/51d87e96-bf79-4652-8d7c-1747e79e6482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cef17eed39fa01d3e80275e686d1394 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のオリジナルキャラクターのイラストを描いてほしいです。彼は若いサテュロスの少年（半人半山羊）です。内気だけどタフで、不機嫌で短気。よく喧嘩を売ってくるトラブルメーカーです！ポーズは何でも構いません。