4b7607f0 2x, https://si.imgix.net/77e064e9/uploads/origins/dc9715bd-0eec-4652-9b77-65e198f818d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15bad707c0e300261c2df8bafa0c0e0b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/17", "thumbnail_src": "https://si.imgix.net/0e39276d/uploads/origins/6099733d-5385-4ebb-9dfe-761570901268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a1e8e97c9705bdd5c91e3de06985dd", "thumbnail_srcset": "https://si.imgix.net/0e39276d/uploads/origins/6099733d-5385-4ebb-9dfe-761570901268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a1e8e97c9705bdd5c91e3de06985dd, https://si.imgix.net/0e39276d/uploads/origins/6099733d-5385-4ebb-9dfe-761570901268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee48fcf7bf7a975e2d757430656458ac 2x, https://si.imgix.net/0e39276d/uploads/origins/6099733d-5385-4ebb-9dfe-761570901268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=235a4f80996f6e8ffeade71df5938d4f 3x", "genre": "art", "nsfw": false, "body": "初代ウルトラマンの衣装を着用してポーズをとってくれているウマ娘のトランセンドをお願いしたいです。\n\nポーズはウルトラマンが良くしている拳を握って腕を高く上げるポーズでアングルは少し斜めからでお願いします。(リンク①参照)右の腋の面とカラータイマーが隠れることはなくしっかり見えるようにお願いします。\n\n全身が写っている感じでお願いします。\n\n頭や顔は完全に出ている状態でお願いします(リンク②参照)眼鏡は無しで(可能であれば有りの差分もお願いします)耳飾りやカチューシャ、髪飾り等は勝負服のものと同じでお願いします。尻尾も出してください。\nウルトラマンのスーツはウェットスーツのような質感で全身を覆っていて繋ぎ目なしでお願いします。スーツはピッチリとしていて食い込み具合は身体のラインが出ている感じでお願いします。(リンク②参照)スーツは光沢感があってシワは控えめでお願いします。(リンク②参照)\nスーツの色は赤と白ではなく赤と銀色です。\nカラータイマーの形状や大きさは実際のウルトラマン準拠でお願いします。\n\n表情は笑顔でポーズを決めているものと、少し恥ずかしくなってきているバージョンの表情差分をお願いします。(リンク③参照。可能であれば開口、閉口verをお願いします)\n\nまた、カラータイマーは青色とピンチな赤色、そして消灯している状態(少し明るめの黒色系)の3種類の差分をお願いします。\n\nそしてスーツは凄く蒸れやすいので湯気が出るほど激しく蒸れ蒸れになって汗をかいてしまっている差分をお願いします。\n\n各種差分はpsdのレイヤーで切り替えられるようにしていただけると幸いです。\n\n可能であればセリフ付きの差分があれば幸いです。\n\n長文になりましたが何卒よろしくお願いします！\n\nリンク①ポーズ、カラータイマー参照\n\nhttps://x.com/yj3wdretp2famor/status/1828359115783184844?s=46&t=OHT3sHUZJOnUAN-eythDgA\n\nリンク②スーツが覆う範囲や光沢、食い込み具合等参照\n\nhttps://x.com/yj3wdretp2famor/status/1828360525660696652?s=46&t=OHT3sHUZJOnUAN-eythDgA\n\nリンク③表情参照\n\nhttps://www.pixiv.net/artworks/116855443", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/16", "thumbnail_src": "https://si.imgix.net/52a08c81/uploads/origins/5d8a0514-e569-463f-93b7-1a7d8cfb1226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11eba8bb1b148ccf468892fc38a7510c", "thumbnail_srcset": "https://si.imgix.net/52a08c81/uploads/origins/5d8a0514-e569-463f-93b7-1a7d8cfb1226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11eba8bb1b148ccf468892fc38a7510c, https://si.imgix.net/52a08c81/uploads/origins/5d8a0514-e569-463f-93b7-1a7d8cfb1226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fd9f9e5b69e730e6ac0d3c19a58754b 2x, https://si.imgix.net/52a08c81/uploads/origins/5d8a0514-e569-463f-93b7-1a7d8cfb1226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=618a87e3ba2e9b12f5d664fd6d5eb270 3x", "genre": "art", "nsfw": true, "body": "こんにちは。はじめてリクエストします。\n題名は爆乳のオイナリサマとアカギツネが全裸でエロ蹲踞で両手でくぱぁしてる全身絵をお願いします。内容はオイナリサマとアカギツネが発情して全裸になって、エロ蹲踞になって、手でくぱぁしてます。二人の容姿は爆乳でスタイルが良いです。オイナリサマとアカギツネは全裸ですが、オイナリサマは足袋、草履、片足パンツ、脚に付けてる紐、しっぽの金色の輪っかはそのままで、アカギツネは靴下、靴、片足パンツ、蝶ネクタイマフラー、長手袋はそのままでお願いします。アカギツネだけブラを着けて、ブラをずらして乳首両方出してる。差分はおまかせします。床にはオイナリサマのブラジャーや二人の服が脱ぎ散らかしてるのもお願いします。長文失礼しました。実写ですがブラジャーずらした参考の画像です。\nhttp://img.b-pep.com/wp/wp-content/uploads/2015/12/130815b_0001.jpg", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/15", "thumbnail_src": "https://si.imgix.net/169a059f/uploads/origins/836cdf63-e402-41b2-a844-38e22053d39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97d92c72314a2f429a0083434ba9ab53", "thumbnail_srcset": "https://si.imgix.net/169a059f/uploads/origins/836cdf63-e402-41b2-a844-38e22053d39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97d92c72314a2f429a0083434ba9ab53, https://si.imgix.net/169a059f/uploads/origins/836cdf63-e402-41b2-a844-38e22053d39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=862a3cc76f81406739e8446a35866685 2x, https://si.imgix.net/169a059f/uploads/origins/836cdf63-e402-41b2-a844-38e22053d39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b881f6c4b0a10b27035bdf62dfb347f 3x", "genre": "art", "nsfw": false, "body": "初リクエストです。\nけものフレンズからタスマニアタイガーちゃんをお願いしたいです\n\n服装：ウマ娘『トランセンド』(https://umamusume.jp/character/transcend)の勝負服\n(細かい指定ですが、正面のポーチについてる缶バッジのデザインは蹄鉄から『の』のマークに、ニンジンの缶バッジはサツマイモのデザインに変えていただけるとありがたいです)\nまた、トランセンドの右耳の耳飾りの有無やポーズはお任せします。\n差分として赤縁のメガネ(トランセンドが制服着用時にかけているもの)をかけている差分もあると嬉しいです\n\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/14", "thumbnail_src": "https://si.imgix.net/abcb29eb/uploads/origins/1b33f847-6126-4a34-96d4-1e4621d46817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7fc0c1ba516d9ca1829210b56ee8fa", "thumbnail_srcset": "https://si.imgix.net/abcb29eb/uploads/origins/1b33f847-6126-4a34-96d4-1e4621d46817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7fc0c1ba516d9ca1829210b56ee8fa, https://si.imgix.net/abcb29eb/uploads/origins/1b33f847-6126-4a34-96d4-1e4621d46817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b0258cfee575a2719afd44cff45f54b 2x, https://si.imgix.net/abcb29eb/uploads/origins/1b33f847-6126-4a34-96d4-1e4621d46817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=335b25c70447f08c6a88412311b3e468 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\n世界はもっと鍵山雛のパンチラショットを必要としている。(鍵山雛 パンチラ)\n可愛くて綺麗な鍵山雛ちゃんの作品を描いていただけませんか？\nよろしくお願いします！\n\nバブルのお尻を見せて、かわいいピンクのパンティをはいてほしいです。その他は自由にデザインしてください！", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/13", "thumbnail_src": "https://si.imgix.net/2a6a6702/uploads/origins/d08e4216-538a-497d-96f9-134dd5679c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c90389aaaa177bb8c45ecaedf68a7ab1", "thumbnail_srcset": "https://si.imgix.net/2a6a6702/uploads/origins/d08e4216-538a-497d-96f9-134dd5679c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c90389aaaa177bb8c45ecaedf68a7ab1, https://si.imgix.net/2a6a6702/uploads/origins/d08e4216-538a-497d-96f9-134dd5679c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59b6bc22b02c82901650bea780106821 2x, https://si.imgix.net/2a6a6702/uploads/origins/d08e4216-538a-497d-96f9-134dd5679c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3274a2bb7110f63effe166d837c3adc2 3x", "genre": "art", "nsfw": true, "body": "けものフレンズのオオセンザンコウのパンチラをお願いします。尻尾を横に振るいつつパンツ見えてる構図でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/12", "thumbnail_src": "https://si.imgix.net/4c5376a4/uploads/origins/8f104ef9-1245-404b-a074-a3e4f4133fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f2a483a1ecfb4b7067facc104701d6c", "thumbnail_srcset": "https://si.imgix.net/4c5376a4/uploads/origins/8f104ef9-1245-404b-a074-a3e4f4133fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f2a483a1ecfb4b7067facc104701d6c, https://si.imgix.net/4c5376a4/uploads/origins/8f104ef9-1245-404b-a074-a3e4f4133fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f9e630b7b69d14f4babdf5dfab17446 2x, https://si.imgix.net/4c5376a4/uploads/origins/8f104ef9-1245-404b-a074-a3e4f4133fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3eaf54dc3086866af2009ababf0b071 3x", "genre": "art", "nsfw": true, "body": "こんにちは初めてリクエストします。\n題名は爆乳のサーカル（サーバルとカラカル）が全裸でエロ蹲踞で両手で指オナニーしてる全身絵をお願いします。内容はサーバルとカラカルがシャツとスカートを脱ぎ散らかして、全裸になり、エロ蹲踞で両手で指オナニーして気持ちよくなってます。2人は爆乳でスタイルが良く、ムチムチです。二人共全裸ですがニーハイソックス、靴、蝶ネクタイマフラー、長手袋、片足パンツはそのまま残したままでお願いします。ブラジャーを着けて、ブラをずらして乳首両方出しているのもお願いします。差分はおまかせします。床には二人のシャツ、スカートが脱ぎ散らかしてるのもお願いします。長文失礼しました。", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/11", "thumbnail_src": "https://si.imgix.net/4d6adde6/uploads/origins/d035432c-592a-4b60-a6fb-2bddb04569c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75442c149e92cbc4d4c8aaaa55b7c68c", "thumbnail_srcset": "https://si.imgix.net/4d6adde6/uploads/origins/d035432c-592a-4b60-a6fb-2bddb04569c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75442c149e92cbc4d4c8aaaa55b7c68c, https://si.imgix.net/4d6adde6/uploads/origins/d035432c-592a-4b60-a6fb-2bddb04569c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ad329dbc78c991d5cd9cdecefcd9df1 2x, https://si.imgix.net/4d6adde6/uploads/origins/d035432c-592a-4b60-a6fb-2bddb04569c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=469305987c593bedc4cd8b57d0058ff5 3x", "genre": "art", "nsfw": true, "body": "はじめまして！twitterに投稿されたイラストを拝見して依頼をさせて頂きました。\nリクエストなのですが、触手に絡まれて拘束されているけものフレンズ3のはなまるチェンジ版コモドドラゴンさんをお願いいたします\nシチュエーションとしましては、足を広げられ腕を持ち上げられ腋を見せた状態のコモモの胸（巨乳）を触手セルリアンや人型セルリアン達（単色等で簡略しても大丈夫です）に揉まれていてください。服装は所々破れ、胸元の部分も片方が破られ方胸の乳房が露出している状態で揉まれていてください。スカートやサイハイニーソも所々破かれてパンチラしていてください（下着の色はお任せします）。手の指先や足の指先には青色のマニキュアやペディキュアを塗っていただけると幸いです\n表情は痛さと気持ちよさに耐えながらも涙目で嫌がっている表情でお願いします。\nもしよろしければ他に嫌がってる表情の差分もお願い致します…！\nはなまるチェンジコモドドラゴンの資料です\nhttps://twitter.com/not_beaver/status/1742503299335766208?t=rM9boMqm8j0APbmyowT38A&s=19\nhttps://twitter.com/not_beaver/status/1742369774196445416?t=xWcXCm1TDmk7WDnngrm5TQ&s=19\nhttps://twitter.com/not_beaver/status/1741620966197960753?t=nAKDXZY9rDBpGgy51PuGbQ&s=19\n長文失礼しました。どうぞよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/10", "thumbnail_src": "https://si.imgix.net/0f28d686/uploads/origins/4691fe5b-aa05-44eb-9ef0-1314a5233198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85ce74372d8e0807fcf9ab6d53faac19", "thumbnail_srcset": "https://si.imgix.net/0f28d686/uploads/origins/4691fe5b-aa05-44eb-9ef0-1314a5233198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85ce74372d8e0807fcf9ab6d53faac19, https://si.imgix.net/0f28d686/uploads/origins/4691fe5b-aa05-44eb-9ef0-1314a5233198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d100e479b639df3f4e557e8b4214cf87 2x, https://si.imgix.net/0f28d686/uploads/origins/4691fe5b-aa05-44eb-9ef0-1314a5233198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e753eff4b1d48f3a7479b6c87c06584b 3x", "genre": "art", "nsfw": true, "body": "リクエスト致します！\n\nけものフレンズ3よりケルベロスのエッチなイラストをお願い致します！\n\nチューブトップがズレておっぱいが丸見えになっているも気付いておらず、キョトンとした表情をしているシチュエーションでお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@bentAK8/works/9", "thumbnail_src": "https://si.imgix.net/8efd6b98/uploads/origins/14f193f0-97c9-43c0-9d79-1867f5e7b1c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b2f01afd530f739198a44bccf0525e8", "thumbnail_srcset": "https://si.imgix.net/8efd6b98/uploads/origins/14f193f0-97c9-43c0-9d79-1867f5e7b1c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b2f01afd530f739198a44bccf0525e8, https://si.imgix.net/8efd6b98/uploads/origins/14f193f0-97c9-43c0-9d79-1867f5e7b1c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7832167223dd58a640f56e7d6849f13 2x, https://si.imgix.net/8efd6b98/uploads/origins/14f193f0-97c9-43c0-9d79-1867f5e7b1c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=