=200&h=200&s=0441de054928553aff456225e7a57eef, https://si.imgix.net/78854648/uploads/origins/b1067677-86b1-4c76-970c-0258935bc145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a661d5204f34104d967e509fae50a8b0 2x, https://si.imgix.net/78854648/uploads/origins/b1067677-86b1-4c76-970c-0258935bc145?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb5eb084f98f42a86f0f9b6c56c515e9 3x", "genre": "art", "nsfw": false, "body": "お狐な亞北ネルをお願いします🦊", "created_at": "", "completed_at": ""}, {"path": "/@danbounokigu/works/32", "thumbnail_src": "https://si.imgix.net/5c4a6845/uploads/origins/5182a072-b249-481e-b837-387e7a85cee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=690713fa876a7ebbb7c5994247be72a6", "thumbnail_srcset": "https://si.imgix.net/5c4a6845/uploads/origins/5182a072-b249-481e-b837-387e7a85cee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=690713fa876a7ebbb7c5994247be72a6, https://si.imgix.net/5c4a6845/uploads/origins/5182a072-b249-481e-b837-387e7a85cee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3700a80284e1f42dcd99ffadf47da181 2x, https://si.imgix.net/5c4a6845/uploads/origins/5182a072-b249-481e-b837-387e7a85cee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a57193d003df685bbffd095606f67aba 3x", "genre": "art", "nsfw": true, "body": "いつもイラスト拝見しております、暖房器具先生の描かれる狐娘が大好きです。\n先生の趣味に合えば、是非こちらのキャラクターのイラストを描いていただけないでしょうか？\n\n[妖艶で強い妖力を持つが人間大好きな九尾の妖狐]\n普段は社やお屋敷で暮らし、人間が遊びにくると歓迎してくれる狐の神様。\n妖艶で色っぽい立ち振る舞いで、傾国の美女を思わせるような神様だが…その実、人間の事は好きで、\n気に入った人間には尻尾に触れさせたり尻尾で包み込んだりして可愛がる…。\n\n一般・R-15・R-18、どの程度の描写でも構いません。\n1枚絵・1ページのモノクロマンガ、どちらでも結構です。\n暖房器具先生が良いと思われるシチュエーションで描いていただけないでしょうか？(特にシチュが思いつかない場合は、ベッドに横になり「おいで、旦那はん…♡今宵はうちが添い寝してあげる…♡」と、胸元をはだけさせて誘惑する…など如何でしょう？)\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yI12akVIp0KStL8Fg4NLwdszzd_9WSkj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@danbounokigu/works/31", "thumbnail_src": "https://si.imgix.net/989cb69d/uploads/origins/8c8591a2-4290-45d4-b45c-2eeded5f0261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c20e002f42e905f49bef3effa008097e", "thumbnail_srcset": "https://si.imgix.net/989cb69d/uploads/origins/8c8591a2-4290-45d4-b45c-2eeded5f0261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c20e002f42e905f49bef3effa008097e, https://si.imgix.net/989cb69d/uploads/origins/8c8591a2-4290-45d4-b45c-2eeded5f0261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb74b29472634f4840639582257914a0 2x, https://si.imgix.net/989cb69d/uploads/origins/8c8591a2-4290-45d4-b45c-2eeded5f0261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd52e393f4cd785656d8479a9bc333b6 3x", "genre": "art", "nsfw": true, "body": "はじめまして、イラストを依頼させて頂きます。\n\nお願いしたいのは疾風ウルトラ忍法帖という作品に登場する「邪鬼姫」のイラストになります。\n\n古い作品ですので、資料を用意しましたのでご確認ください。\n\n邪鬼姫が作中で使用した「Ｔバック幻術」というお尻に見とれさせることで幻術にかける技のシーンを暖房器具さんのタッチで作成して頂けないでしょうか。\n\n詳細な構図などはおまかせしますが、邪鬼姫がこちらに向けてお尻を揺らすとその周囲に幻のお尻や桃がグルグル回っているようなイメージで作成して頂ければ幸いです。\n\n分かりにくい依頼で申し訳ございませんが、ご検討のほどをよろしくお願いします。\n\nhttps://drive.google.com/file/d/1zuVIc7p52y60XyG3KKof0OYA-oilH8oQ/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@danbounokigu/works/30", "thumbnail_src": "https://si.imgix.net/98f83f42/uploads/origins/8a67f452-2ef3-4a88-af0d-c70f7c95759f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a034783dfc604a677856cc8b6884ce29", "thumbnail_srcset": "https://si.imgix.net/98f83f42/uploads/origins/8a67f452-2ef3-4a88-af0d-c70f7c95759f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a034783dfc604a677856cc8b6884ce29, https://si.imgix.net/98f83f42/uploads