-8668-b7cbc2cd9c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0a19df7fa1989bb252913fa7cf4bfe9 2x, https://si.imgix.net/19e49475/uploads/origins/55388fcb-76d8-470c-8668-b7cbc2cd9c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=505faf3000ef595ae6f4fababd6db4e4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@himeyamayuri/works/122", "thumbnail_src": "https://si.imgix.net/4ed635d0/uploads/origins/7c63822e-0c20-4baf-934a-02da6ea8fa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=883a57d7762d021b9b70f89d9c89733f", "thumbnail_srcset": "https://si.imgix.net/4ed635d0/uploads/origins/7c63822e-0c20-4baf-934a-02da6ea8fa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=883a57d7762d021b9b70f89d9c89733f, https://si.imgix.net/4ed635d0/uploads/origins/7c63822e-0c20-4baf-934a-02da6ea8fa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbe241afe0262c1441a723fca36b8903 2x, https://si.imgix.net/4ed635d0/uploads/origins/7c63822e-0c20-4baf-934a-02da6ea8fa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd3148356de4677e70c27043e6031798 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n以下キャラにてイラストを依頼させていただきます\n\n\n■キャラ\n妖花システィローラ\n\nこちらの衣装でお願いします\nhttps://twitter.com/moryotton/status/1718581735993339979/\n\n\n〇参考/過去skebで依頼してきたもの\nhttps://skeb.jp/@emanon123_78m/works/49\n\n\n〇キャラ設定\n・街で薬局兼道具屋を営む錬金術師/薬師さん\n・薬草や毒草の研究、調合により、回復効果の高いポーションを製造、販売している、また植物を取り込み体内で中和してから効果の高いエキスを抽出してポーションを製造している\n・毒草なども取り込んで中和しているので毒々しい肌になっている。取り込む素材によって目、肌などの見た目が変わる\n・色気/怪しい雰囲気のある、優しいお姉さん(母性)\n\n〇キャライメージ、モチーフなど\n・毒々しい肌(紫/青肌系)、片目隠し、太ももの刺青、蔦に巻き付かれた太ももなど怪しい/妖艶な感じの雰囲気を出しつつ、色々と優しくしてくれるお姉さんをイメージ\n・魔女ま