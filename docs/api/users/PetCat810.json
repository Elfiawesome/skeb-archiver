4f4e-8f70-b728a32d3604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e29656fb9e34f5e2f294d5074b050f0", "thumbnail_srcset": "https://si.imgix.net/d92cc2d4/uploads/origins/d9c8a142-0b0c-4f4e-8f70-b728a32d3604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e29656fb9e34f5e2f294d5074b050f0, https://si.imgix.net/d92cc2d4/uploads/origins/d9c8a142-0b0c-4f4e-8f70-b728a32d3604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=356f41a05408f888655a78abcf8f9d5a 2x, https://si.imgix.net/d92cc2d4/uploads/origins/d9c8a142-0b0c-4f4e-8f70-b728a32d3604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8eab7d052f66a8de10623284bbf9423 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@PetCat810/works/16\nこのイラストがとても好みなので依頼します。\n\n[シチュエーション]\n私が経営する肛門科に来た幼女たちの写真を纏めた診察表を作ってください。1枚目にクリップボードに幼女の診察表(肛門の皺の数や絶頂経験等)と立ち絵。2枚目に診察表の上に写真を張っているという設定です。以下の内容で描けそうな物があればお願いします。\n・服を脱いで笑顔でアナルを丸出しにしている写真。若しくはアナルの接写。\n・治療だと騙してアナルセックスしている写真。性知識が無く肛門期の年頃なので嫌がってはおらず不思議そうにしているか気持ちよさそうな表情で受け入れている。\n・資料にするからと言われ自分でぽっかり開いたアナルを見せつけている写真。最後まで治療だと思っており感謝のセリフを述べている感じ。\n・トイレの盗撮画像。\n\n女の子は幼稚園児と小学生の2人でお願いします。以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PetCat810/works/24", "thumbnail_src": "https://si.imgix.net/f9dac8ed/uploads/origins/87f2004d-7367-4e1f-babc-e3421d143d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4ac28d3c753db2300aeff965363a52", "thumbnail_srcset": "https://si.imgix.net/f9dac8ed/uploads/origins/87f2004d-7367-4e1f-babc-e3421d143d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4ac28d3c753db2300aeff965363a52, https://si.imgix.net/f9dac8ed/uploads/origins/87f2004d-7367-4e1f-babc-e3421d143d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15074ebae21cd087e1b515b521686a1f 2x, https://si.imgix.net/f9dac8ed/uploads/origins/87f2004d-7367-4e1f-babc-e3421d143d41?bg=%23fff&auto=