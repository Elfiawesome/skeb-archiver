da/uploads/origins/3b3a3ff6-635b-4bb1-8966-6968296cc916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ca99c4dc2559eab2f2365b1e79297bc 3x", "genre": "art", "nsfw": false, "body": "はじめまして、いつも素敵なイラストを拝見させて頂いております！\nぜひゆじゅぴー様に創作のキャラクターを描いていただきたいと思い、リクエストを送信させて頂きました。\n\nもし可能でしたらゆじゅぴー様の現在のアイコンのようなもちっとしたデフォルメイラストで、服装や髪型など、描きやすい形がありましたらお好きなようにアレンジして描いていただきたいです。\n\nご縁がありましたら、何卒よろしくお願い致します。\n\nhttps://twitter.com/v4_nae/status/1596780622143721472?s=46&t=h97pk8Tsu1Mbwk4YncUS7w", "created_at": "", "completed_at": ""}, {"path": "/@YuJuP/works/29", "thumbnail_src": "https://si.imgix.net/263bb91b/uploads/origins/89677dff-9b81-463d-b668-d5c3dbea4cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57f3143c5ecf1676ed5b0c6cc1b2ca96", "thumbnail_srcset": "https://si.imgix.net/263bb91b/uploads/origins/89677dff-9b81-463d-b668-d5c3dbea4cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57f3143c5ecf1676ed5b0c6cc1b2ca96, https://si.imgix.net/263bb91b/uploads/origins/89677dff-9b81-463d-b668-d5c3dbea4cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a21365269618b3fc8dbb4835438ef79 2x, https://si.imgix.net/263bb91b/uploads/origins/89677dff-9b81-463d-b668-d5c3dbea4cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b907346ffedfb6a6daa25fa859c4b2c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@YuJuP/works/28", "thumbnail_src": "https://si.imgix.net/d308571e/uploads/origins/8ae64b18-a3b7-4282-8275-27d532afdfe2?bg=%23fff&auto=format%2