o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33c60ad75b6c8d1738d3c895f8ffe805 2x, https://si.imgix.net/dfd6811e/uploads/origins/1e2bd49a-d729-438f-b7ec-85831701ca3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=683a0ff5122db9237f4eaf1d1161d3f0 3x", "genre": "art", "nsfw": true, "body": "久川颯が大きすぎてブラが入らないことを発見するところを見てみたい。彼女のサイズを誇張するのも自由です！", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/9", "thumbnail_src": "https://si.imgix.net/cf1c6739/uploads/origins/a55c019c-c554-4ca2-aa94-5dbb6c7da1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=009dfc626bb25fd176abc8bd09a150ba", "thumbnail_srcset": "https://si.imgix.net/cf1c6739/uploads/origins/a55c019c-c554-4ca2-aa94-5dbb6c7da1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=009dfc626bb25fd176abc8bd09a150ba, https://si.imgix.net/cf1c6739/uploads/origins/a55c019c-c554-4ca2-aa94-5dbb6c7da1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6634936dfe60e12732aeca17d48a451a 2x, https://si.imgix.net/cf1c6739/uploads/origins/a55c019c-c554-4ca2-aa94-5dbb6c7da1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c18c18d1b3ec62234a573fa9ee4677a 3x", "genre": "art", "nsfw": true, "body": "skeb受付再開ということでリクエストお願いします！\n\n◆キャラクター\n藤原肇 (シンデレラガールズ)\n\n◆服装・シチュエーション\n資料URLに添付した公式イラストの制服姿でお願いします。\n「Pのことを思い浮かべながら、事務所のPのデスクの角に股を擦り付けて角オナしてる肇ちゃん」というシチュでお願いします。\n\n\nリクエスト内容は以上です。\nどうかご検討よろしくお願いいたします。\n\nhttps://imas.gamedbs.jp/cgss/images/CBi2MiXlyE1AjN8oiK_W7iGvqpdgtoRGe-sAmiqshCg.jpg?1447915675", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/8", "thumbnail_src": "https://si.imgix.net/f2596890/uploads/origins/f568a2ab-60bd-45e3-86a6-459939564af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876cdb063164b72d9d0d90109337d86b", "thumbnail_srcset": "https://si.imgix.net/f2596890/uploads/origins/f568a2ab-60bd-45e3-86a6-459939564af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876cdb063164b72d9d0d90109337d86b, https://si.imgix.net/f2596890/uploads/origins/f568a2ab-60bd-45e3-86a6-459939564af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cef52eab2e955d921c71bd64e7cef7cb 2x, https://si.imgix.net/f2596890/uploads/origins/f568a2ab-60bd-45e3-86a6-459939564af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7755860469c92c8fd8cfea42a26c830 3x", "genre": "art", "nsfw": true, "body": "こんばんは。\n以前の依頼でもありがとうございました。\nプロデューサーさんとエッチする紗枝はんをお願いします！\n構図などはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/7", "thumbnail_src": "https://si.imgix.net/101a77f5/uploads/origins/2da1809d-a1b4-4b8e-b596-1415b9fe0b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a638d5194905d15dc5a51d07e2826a26", "thumbnail_srcset": "https://si.imgix.net/101a77f5/uploads/origins/2da1809d-a1b4-4b8e-b596-1415b9fe0b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a638d5194905d15dc5a51d07e2826a26, https://si.imgix.net/101a77f5/uploads/origins/2da1809d-a1b4-4b8e-b596-1415b9fe0b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e3d10c5b93487af3eeeb3a4ff1b3ced 2x, https://si.imgix.net/101a77f5/uploads/origins/2da1809d-a1b4-4b8e-b596-1415b9fe0b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfcc047299b80d27a0ceae46bdea5ef3 3x", "genre": "art", "nsfw": true, "body": "はじめまして、pixivで見かけたイラストが素敵でしたのでリクエストさせて下さい。\n\nキャラクターは久川颯で馬乗りパイズリのイラストをお願いします。\n\n射精はありで顔に多めにかかっていると嬉しいです。\n服装はお任せしますが胸は完全に露出しているのを希望します。\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/6", "thumbnail_src": "https://si.imgix.net/0471476a/uploads/origins/f2245aa9-cc94-4230-b49c-17aa8b4c8841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0109b4ad997419c4a89bc13633227311", "thumbnail_srcset": "https://si.imgix.net/0471476a/uploads/origins/f2245aa9-cc94-4230-b49c-17aa8b4c8841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0109b4ad997419c4a89bc13633227311, https://si.imgix.net/0471476a/uploads/origins/f2245aa9-cc94-4230-b49c-17aa8b4c8841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c004fd1bbe5e48b8202a46ff3a4cfc15 2x, https://si.imgix.net/0471476a/uploads/origins/f2245aa9-cc94-4230-b49c-17aa8b4c8841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72a06364afb3429e60f7063e2910595d 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n白雪千夜が制服姿で乳首オナニーしているイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/5", "thumbnail_src": "https://si.imgix.net/dd34fc3c/uploads/origins/d20d7fbb-4a0f-40ed-a7f8-e073ed9934d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68dbc341bb1b56d4369ba38fc2270940", "thumbnail_srcset": "https://si.imgix.net/dd34fc3c/uploads/origins/d20d7fbb-4a0f-40ed-a7f8-e073ed9934d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68dbc341bb1b56d4369ba38fc2270940, https://si.imgix.net/dd34fc3c/uploads/origins/d20d7fbb-4a0f-40ed-a7f8-e073ed9934d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6116271242b7b8831425944b1e868dfa 2x, https://si.imgix.net/dd34fc3c/uploads/origins/d20d7fbb-4a0f-40ed-a7f8-e073ed9934d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82aed898b9bb600e93958a903903a535 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/4", "thumbnail_src": "https://si.imgix.net/38dc35c4/uploads/origins/b5bdcfbd-f992-46eb-a589-d382e1fd92a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f541c9e7b3ddfb24edbb5b3f2379b61", "thumbnail_srcset": "https://si.imgix.net/38dc35c4/uploads/origins/b5bdcfbd-f992-46eb-a589-d382e1fd92a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f541c9e7b3ddfb24edbb5b3f2379b61, https://si.imgix.net/38dc35c4/uploads/origins/b5bdcfbd-f992-46eb-a589-d382e1fd92a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e43feb041fe3668f687abcb1028629f1 2x, https://si.imgix.net/38dc35c4/uploads/origins/b5bdcfbd-f992-46eb-a589-d382e1fd92a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=877e2bb89dd12ecd756fd4fea82db73b 3x", "genre": "art", "nsfw": true, "body": "ドローイングセンタさん、こちらではお久しぶりです！\n前回の素敵な藍子ちゃんありがとうございます。\nTwitter、pixivの肇ちゃんが素晴らしすぎましたのでぜひまたこの少し余裕があると言われているタイミングで依頼したいです。\nデレマス、藤原肇ちゃんをお願いいたします！\nプロデューサーさんとのいちゃラブエッチという形、可能なら今回の肇ちゃんのセクシーボディが素晴らしすぎたので騎乗位などどうでしょう？(体位、構図など最終的な詳細はお任せします) \nよかったらご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/3", "thumbnail_src": "https://si.imgix.net/2c271149/uploads/origins/4f35b6c5-34bc-4f83-95d7-3a24747b63d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4ab7d555fb80c5e106ca36a45a577ee", "thumbnail_srcset": "https://si.imgix.net/2c271149/uploads/origins/4f35b6c5-34bc-4f83-95d7-3a24747b63d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4ab7d555fb80c5e106ca36a45a577ee, https://si.imgix.net/2c271149/uploads/origins/4f35b6c5-34bc-4f83-95d7-3a24747b63d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aca07f95d331353d7a8ffff2c37e9662 2x, https://si.imgix.net/2c271149/uploads/origins/4f35b6c5-34bc-4f83-95d7-3a24747b63d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa1414aae4c5e42b162fb85c55c5c110 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n\nリクエストさせて頂きます。\n\npixivなどで魅力的だったのでキャラは久川颯でお願いいたします。\nはーちゃんとエッチしてるイラストをお願いしたいです。\n\n先日はこちらからキャンセルしてしまいましたが\nよろしければ催眠状態のはーちゃんとエッチしてるイラストでお願いしたいです。\nはーちゃんはぼーっとした状態です。\n\n衣装は下記でお願いしたいです\nオンタイム・ハーモニー\nhttps://imas.gamedbs.jp/cg/idol/detail/211?h=imcgss-c1915\n\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/2", "thumbnail_src": "https://si.imgix.net/23a0b538/uploads/origins/dd20ff74-ec55-49aa-86ec-ecad48b51155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54910f1c5cb803bb39f0264c1105a9e2", "thumbnail_srcset": "https://si.imgix.net/23a0b538/uploads/origins/dd20ff74-ec55-49aa-86ec-ecad48b51155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54910f1c5cb803bb39f0264c1105a9e2, https://si.imgix.net/23a0b538/uploads/origins/dd20ff74-ec55-49aa-86ec-ecad48b51155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=848ed2322976dde6f4be420d810e1495 2x, https://si.imgix.net/23a0b538/uploads/origins/dd20ff74-ec55-49aa-86ec-ecad48b51155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d3cf475d00e04bfff76efbb267beda2 3x", "genre": "art", "nsfw": true, "body": "ドローイングセンタさんこんばんは。\n最近Twitterでお見かけして過去作品も拝見しました。\nどれも素晴らしかったですが直近のだと栗原ネネちゃんのイラスト、水着の質感・表情・スタイル・背景含めた部屋の明暗・濃淡などどれも素晴らしかったです。\nよろしかったらご依頼を提案させて頂きますのでお気が向きましたらお願いできないでしょうか。\nアイドルマスターシンデレラガールズから高森藍子ちゃんをお願いできないでしょうか。\nはーちゃんや真乃ちゃん、美穂ちゃんなどのNSFW絵も素敵だったので藍子ちゃんのスク水エッチ絵でお願いします。\n個人的にはずらし挿入での正常位、もしくはバック絵が見たいですがドローイングセンタさんの得意分野・構図などもあるでしょうし、最終的なことはお任せいたします。\nおまかせ予算の範囲や、ドローイングセンタさんのお時間・お手間などで可能ならスク水じゃない、全裸差分もあれば嬉しいです。\n長々と申し訳ありません。\nよかったらご検討ください。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oekaki_machine/works/1", "thumbnail_src": "https://si.imgix.net/99bd3ac7/requests/283769_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&