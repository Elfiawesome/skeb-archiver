2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b26f963018a8bb6e686a90e19c56dcaf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cd19927f5e0a1c87416e4973f699aa5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0937c7ed4729a0072740b9974a4eee4 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/92", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは。いつも活動お疲れ様です。\n\nこちらでおまけとして付けていただいた、\n口と鼻をタオルで塞いで呼吸する音と、手で口と鼻を覆って呼吸する音を、\nそれぞれ30分ほどお願いすることはできますでしょうか。\nhttps://skeb.jp/@Murase_Tomoe/works/90\n\nお忙しいとは思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/91", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは！いつもお疲れ様です。\nシチュエーション付きの耳かきボイスをお願いしたいと思います。\n\n仕事で疲れ切った帰り、いつもの帰路で隠れ家的な耳かき専門店に初めて気付き、吸い寄せられるように入店する。\nしかし、最初は穏やかだったが次第に様子がおかしくなり…という感じで、ホラーとまでは言わないですが非日常的で少し危険な香りのするシチュエーションとなります。\nその耳かき専門店の店員を巴さんに演じて頂きたいと思います。基本的には、いつものライブ配信のような丁寧で優しい雰囲気でお願いしたいです。\n\n\n店員は飛び込みの入店でも快く受け入れ、施術前の会話だけでも客の心は癒されていく。\n客は溜め込んでいたものを話すようになり、「もうどうにでもなってしまえばいい」という自暴自棄な心情まで吐露する。\n店員はその吐露も真っ直ぐに受け止めて客の疲れを労い、施術に移る。\n\n最初は耳マッサージや竹耳かきでゆったりと進めていく。\n世間話も交えながら、しばらく耳掃除していなかった客の耳垢を丁寧に取っていく。\nしかし、耳垢を綺麗にした辺りから店員の様子に異変が表れる。\n「痒いところを掻いていく」と客に伝え、最初はゆっくりカリカリするが、なかなか終わらず、次第にスピードが上がっていく。\n店員の「カリカリ」という声も耳かきに合わせて早くなっていく。\n(不思議と激痛には至らず、マッサージに例えると\"痛気持ちいい\"ぐらいの感覚)\n客も驚くが、店員は「せっかく当店に来て頂いたのですから、ここでしかできない体験をして頂きます」とだけ伝え、耳かきは高速になる。\n\n客が遂に制止を求めるが(\"これ以上はどうにかなってしまう\"等の訴え)、\n店員は客の耳元で「どうにかなっちゃえば良いじゃないですか」と囁き、息を吹きかける。\nそして高速耳かきが続行され、しばらくして音がフェードアウトする。\n\nその後、店員の優しい声かけで客は目を覚ます。\n耳に痛みはなく、それどころか体の疲れもすっかり抜けているようだった。\n仕上げに梵天と耳ふーで元通りのゆったりとした雰囲気に。\n施術を終えて、店員から「ちょっと荒療治になってしまいましたが」と苦笑いされながら、入店時よりもすっきりした表情になっていることを伝えられる。\n「お疲れの時は、あなたの傍で待っています」という言葉で、店員に優しく見送られながら店を後にする。\n\n\n長くなりましたが、以上がシチュエーションの内容となります。\n時間としては合計で一時間ぐらいお願いしたいです。\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/90", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは。いつもお疲れ様です。\n\n片耳ずつで左右に行ったり来たりする感じの、耳ほーをリクエストさせていただきます。\n長さは一時間ほどお願いできますでしょうか。\n\nお忙しいとは思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/89", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "いつも配信癒されています。\n初めてのリクエストですが、ガスマスクを使用しての呼吸音が好きなのでその他にもガムテープやタオルで口を塞いでの呼吸音や耳元での囁きなどをお願いしたいのですが可能でしょうか。検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/88", "thumbnail_src": "https://si.imgix.net/ca7153c9/uploads/origins/c8153d90-b94f-477c-8a9b-15226933ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b825b5d0e8eaf13bb0f97845c2dfe5", "thumbnail_srcset": "https://si.imgix.net/ca7153c9/uploads/origins/c8153d90-b94f-477c-8a9b-15226933ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b825b5d0e8eaf13bb0f97845c2dfe5, https://si.imgix.net/ca7153c9/uploads/origins/c8153d90-b94f-477c-8a9b-15226933ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a9aa9cce4074b49c54f8a573a8f845e 2x, https://si.imgix.net/ca7153c9/uploads/origins/c8153d90-b94f-477c-8a9b-15226933ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac15a5419b343caf32bf0682338a1ba1 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。あなたの声が好きだったので、作品をお願いすることにしました。\n\n以前のSkebのリクエストに共通する金色の目をした赤毛のラナが、いつものトモエの背伸びしたポニーテールの自分にくすぐられているところを描いてもらえませんか？ラナには2つの姿というかライフステージがある。130cm、30kgの10代の自分と、198cm、90kgの29歳の自分。どちらもバスローブや巫女服を着ているので、ラナもトモエも自由に描いてください！\n\n表情やポーズ、セリフは自由です！お任せで結構です！\n\n楽しみにしています！よろしくお願いします！", "created_at": "", "completed_at": ""}]}