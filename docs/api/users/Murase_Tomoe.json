797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは。いつもお疲れ様です。\n\n梵天耳かきとふわふわとオノマトペを囁く音をリクエストさせていただきます。\n耳ふぅと耳はーをオノマトペと一緒に入れてほしいです。\n長さは一時間ほどお願いできますでしょうか。\n\nお忙しいとは思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/98", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは。いつも活動お疲れ様です。\n\nゼロ距離でたまに左右を行き来する耳はーをリクエストすることはできますでしょうか？\n耳はー事態が音が広がりやすいと思うので、そもそも通常の耳はーでも距離が近いような気がしますが、違いが出るようなものであればリクエスト受けていただきたいです。\n長さは一時間ほどを希望します。\n\nいつも大変だと思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/97", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53cdf3a88674e5376ed67c18ec3492d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726e59c261050103efe9e1fb99a4251f 3x", "genre": "voice", "nsfw": false, "body": "こんにちは。いつもお疲れ様です。\n\nワセリンとラップを使ったリップケア風の音声と、マウスポッピングサウンドをお願いできますでしょうか？\n収録してほしい音声は以下のようになります。\n\n①適量のワセリンを指に取り、唇全体に塗る。\n②綿棒やリップブラシなどを使い、口角など隅々までワセリンを馴染ませる。\n③小さくカットしたラップを唇に貼り付け、指で優しくマッサージする。最後にラップをゆっくりと剥がす。\n④リップケア後にマウスポッピングサウンドを鳴らす。\n\n時間の目安としては①②を合わせて5分、③を10分、④を10分程度でお願いしたいです。\n\nご検討お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Murase_Tomoe/works/96", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1510158070260797450%2F1ymnVGHZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=474ab35f59328c51041e6a32f629d92b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_im