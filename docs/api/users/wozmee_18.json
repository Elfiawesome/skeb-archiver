.imgix.net/62524a77/uploads/origins/bfcd20d1-f863-4483-b525-dc21a4e9728a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1048da6716c57bdc23fdc59fe4a0c6f", "thumbnail_srcset": "https://si.imgix.net/62524a77/uploads/origins/bfcd20d1-f863-4483-b525-dc21a4e9728a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1048da6716c57bdc23fdc59fe4a0c6f, https://si.imgix.net/62524a77/uploads/origins/bfcd20d1-f863-4483-b525-dc21a4e9728a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16d3f3e88ac478954c20eb8f0f4697cb 2x, https://si.imgix.net/62524a77/uploads/origins/bfcd20d1-f863-4483-b525-dc21a4e9728a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bef47aebb98ccb0fe924415221444d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/253", "thumbnail_src": "https://si.imgix.net/6569d1eb/uploads/origins/3327895b-9a47-47d6-a387-918831a345d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=397c8fe6675295a5599602fef012a8ab", "thumbnail_srcset": "https://si.imgix.net/6569d1eb/uploads/origins/3327895b-9a47-47d6-a387-918831a345d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=397c8fe6675295a5599602fef012a8ab, https://si.imgix.net/6569d1eb/uploads/origins/3327895b-9a47-47d6-a387-918831a345d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6811ac7309d510d0cabc8324fe7c39f0 2x, https://si.imgix.net/6569d1eb/uploads/origins/3327895b-9a47-47d6-a387-918831a345d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=decf6ac017b8870d2c10bd7980bcb94d 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nキャラクター\nポケモンBWのフウロとカミツレをお願いします。\n\n衣装\nフウロは22アニバーサリーの衣装を、カミツレはマジコスアナザーの衣装をお願いします。\n\nフウロの参考資料\nhttps://pokemonmasters.pokemongo-raku.com/wp-content/uploads/image/trainer/trainer_04103.png\n\nカミツレの参考資料\nhttps://pokemonmasters.pokemongo-raku.com/wp-content/uploads/image/trainer/trainer_06906.png\n\nシチュエーション\nスリーパー達に催眠術をかけられたフウロとカミツレが、スリーパー達とドスケベ交尾セックスで犯されまくっちゃうシチュエーションをお願いします。\n\n構図や台詞や表情やセックスの体位などの細かい内容はお任せしますので、どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/252", "thumbnail_src": "https://si.imgix.net/5b73b289/uploads/origins/ddcb2200-b543-4688-859f-2dc1aff59b99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39ff222486682f51a99b23b87dea585d", "thumbnail_srcset": "https://si.imgix.net/5b73b289/uploads/origins/ddcb2200-b543-4688-859f-2dc1aff59b99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39ff222486682f51a99b23b87dea585d, https://si.imgix.net/5b73b289/uploads/origins/ddcb2200-b543-4688-859f-2dc1aff59b99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06760ce1082c9ef7cc0c9c9652f1cf95 2x, https://si.imgix.net/5b73b289/uploads/origins/ddcb2200-b543-4688-859f-2dc1aff59b99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fd37c0456918a90be5999f47114de38 3x", "genre": "art", "nsfw": true, "body": "「FAIRY TAIL」よりタウロスのハーレムイラストを依頼させていただきます\n真ん中にルーシィ・ハートフィリア、左にブランディッシュμ、右にソラノ・アグリアが全裸で並んでいて後ろからタウロスがルーシィに挿入しながら左右の二人の爆乳を揉んでいるという構図です\n全体の差分は交尾中と事後(左右の2人も中出し済みで3人とも母乳を出している)の2種でお願いします\nまた「超たねづけるハイルオールワリオLL」のような左右のキャラに差分を頂きたいです\n左にジュビア・ロクサーと右にフレア・コロナ\n左にカグラ・ミカヅチと右にエルザ・スカーレット\n左にミラジェーン・ストラウスと右にジェニー・リアライト\nの3パターンとなります\nブランディッシュの魔法で全員最上位レベルの爆乳(FEのゴルドマリー並のイメージ)になっている設定なので全員同じ体型で大丈夫です\nルーシィの髪型はタウロスフォームのお団子ヘアーでソラノ・アグリアは原作最終決戦時の長髪でお願いします\n全員ギルドマークは金牛宮のマークになっていて、構図の都合見えないキャラは無理に見せなくてOKです\n差分量が多い内容となりますがご検討宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/251", "thumbnail_src": "https://si.imgix.net/c99a3bb6/uploads/origins/7d80007f-448e-4144-a538-0756ba8ec4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a42c32b79cff6803e8af7b88212c692", "thumbnail_srcset": "https://si.imgix.net/c99a3bb6/uploads/origins/7d80007f-448e-4144-a538-0756ba8ec4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a42c32b79cff6803e8af7b88212c692, https://si.imgix.net/c99a3bb6/uploads/origins/7d80007f-448e-4144-a538-0756ba8ec4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8006a09d68c9db575146e1c90d4db632 2x, https://si.imgix.net/c99a3bb6/uploads/origins/7d80007f-448e-4144-a538-0756ba8ec4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f81519a600be4343d06f6c876468ac3e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/250", "thumbnail_src": "https://si.imgix.net/be8fd045/uploads/origins/15f2c841-5e93-4881-b640-f9e21f1fdae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15a56c931dd95a2550727f32e2ab611", "thumbnail_srcset": "https://si.imgix.net/be8fd045/uploads/origins/15f2c841-5e93-4881-b640-f9e21f1fdae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15a56c931dd95a2550727f32e2ab611, https://si.imgix.net/be8fd045/uploads/origins/15f2c841-5e93-4881-b640-f9e21f1fdae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcaa12da1ede814f2f99a4ac7678b2a5 2x, https://si.imgix.net/be8fd045/uploads/origins/15f2c841-5e93-4881-b640-f9e21f1fdae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2ee0d1a91dbc92e6c9fa65ab70d6dad 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回もポケモンのミツル竿役のイラストを見たく依頼をさせていただきます。\n\nキャラ:カガリ\n 竿役:ミツル\n\nシチュ:エピソードデルタにてキーストーンの奪いに来たカガリを乱交中故の多対一か様々なメスを手にした結果ついた自信による超パワーアップかによりミツルが返り討ちにしてしまう。\n以前より狙ってたがなかなか機会に恵まれなかったカガリを手篭めにすべく即交尾ではじめてを奪うミツルにカガリは敵意を剥き出しにするも、あまりの快楽に身体は抵抗できない。\nせめて唇のはじめては守ろうとするも圧倒的アルファオスのミツルの交尾に身も心も陥落し、ミツルが愛するのはただ1人であり最優先事項となってしまい熱烈なキスも許してしまう。\nその後愛するミツルに四六時中ベッタリついてまわり隙があればミツルの性欲解消をしていたカガリは、交尾数も雌内ヒエラルキーも上位になり身分から遠征先にもついていく最も都合のいいメスになるみたいな感じで。\n\n補足:いつもながら爆乳巨尻の抱き心地揉み心地のよい感じでお願いしたいです。\n落差を高めるために堕ち後はミツルをとても持ち上げてくれると嬉しいです。\n\n夏の盛り、ご健勝とご多幸をお祈り申し上げます。\nご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/249", "thumbnail_src": "https://si.imgix.net/e990a869/uploads/origins/720aa909-865a-4900-a508-326bce3ece86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e61c61e97ef343845036351ddb547571", "thumbnail_srcset": "https://si.imgix.net/e990a869/uploads/origins/720aa909-865a-4900-a508-326bce3ece86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e61c61e97ef343845036351ddb547571, https://si.imgix.net/e990a869/uploads/origins/720aa909-865a-4900-a508-326bce3ece86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8029b6e678eea1e2513e1cf5b15dfaf 2x, https://si.imgix.net/e990a869/uploads/origins/720aa909-865a-4900-a508-326bce3ece86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9b32391cb39b4b98404589c837e79b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/248", "thumbnail_src": "https://si.imgix.net/a3727e53/uploads/origins/71047b11-0aef-48a7-a52f-dc2a025e248f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4efeaa1a81d063b9948fead25f72f2ad", "thumbnail_srcset": "https://si.imgix.net/a3727e53/uploads/origins/71047b11-0aef-48a7-a52f-dc2a025e248f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4efeaa1a81d063b9948fead25f72f2ad, https://si.imgix.net/a3727e53/uploads/origins/71047b11-0aef-48a7-a52f-dc2a025e248f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cec1e33c845338e453d007c6e5ffb3ea 2x, https://si.imgix.net/a3727e53/uploads/origins/71047b11-0aef-48a7-a52f-dc2a025e248f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61c3218df34f7992db5dfac35bdaf373 3x", "genre": "art", "nsfw": true, "body": "どうもです、以前DKのお嫁さんになったFEifのサクラちゃんをリクエストさせてもらった者です。\n\n今回またサクラちゃんのリクエストを送らせていただきます！\n\nサクラちゃんが暗夜軍に囚われガンズの肉奴隷にされるというシチュエーションでお願いします。\n前半は無理矢理犯されていて、後半はマクベスの催眠魔法的なものでガンズにメロメロになってるという感じでお願いします。\n体位や構図はセックスさえしてれば後はお任せします、もし金額的によろしければボテ腹差分もあると嬉しいです。\n以上です、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/247", "thumbnail_src": "https://si.imgix.net/7bac4e8e/uploads/origins/95aa52dc-bb36-4728-b355-238d0fba5639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205a6871fe13692a6b88f010a8a324c8", "thumbnail_srcset": "https://si.imgix.net/7bac4e8e/uploads/origins/95aa52dc-bb36-4728-b355-238d0fba5639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205a6871fe13692a6b88f010a8a324c8, https://si.imgix.net/7bac4e8e/uploads/origins/95aa52dc-bb36-4728-b355-238d0fba5639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61c912112f53d4f097a5ed4bc06947a4 2x, https://si.imgix.net/7bac4e8e/uploads/origins/95aa52dc-bb36-4728-b355-238d0fba5639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3ae973d9581ccfa37db76d6556ba1dd 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。 \n時期的なものとしてポケモンのシキミさんのハロウィンイラストを依頼したく思います。\n\n キャラ:シキミ\n竿役:スリーパー\n\n シチュ:スリーパーにより支配され尽くした世界によりハロウィンの時期、スリーパーのものとなったメス達は主の格好をするコンテストがひとしれず開催されていた。\n人間の中でも上位の美貌を持つものが同族のように振る舞う完全なる媚びと表の世界で何も気づかずに生きるもの達への優越感を煽る催しに主たるスリーパーも興奮する。\n中でも服の下に黄色タイツを着ることで人前でも隠匿できるポテンシャルと、元からの格好により完成度の高い仮装媚びのできるシキミは気に入られ褒美としてスリーパーから特別なトリック&トリート(交尾と褒美)を賜り、夜の催眠の催しはさらに盛り上がるみたいな感じで。\n\n 補足:いつもながらシキミさんは爆乳爆尻で、今回はスリーパー風の黄色タイツを着て耳付きマフラーもスリーパー風になっているという感じでお願いしたいです。\n\n身体にこたえる猛暑が続きますが、くれぐれもご自愛ください\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/246", "thumbnail_src": "https://si.imgix.net/d34248a6/uploads/origins/a3a64fef-f493-443f-9367-13dcc21837b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aca9be888f6a6d3d2d13b92d5a84bb30", "thumbnail_srcset": "https://si.imgix.net/d34248a6/uploads/origins/a3a64fef-f493-443f-9367-13dcc21837b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aca9be888f6a6d3d2d13b92d5a84bb30, https://si.imgix.net/d34248a6/uploads/origins/a3a64fef-f493-443f-9367-13dcc21837b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc7a00d6f20cef2e624bc56f6413841b 2x, https://si.imgix.net/d34248a6/uploads/origins/a3a64fef-f493-443f-9367-13dcc21837b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a5b10d9af757ebbbd32ed9f7774e5a3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/245", "thumbnail_src": "https://si.imgix.net/0d7d193a/uploads/origins/fb1889ce-f751-4f1a-9b14-6e954faaafab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98899a4a7019698095ca435fe9cd96d9", "thumbnail_srcset": "https://si.imgix.net/0d7d193a/uploads/origins/fb1889ce-f751-4f1a-9b14-6e954faaafab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98899a4a7019698095ca435fe9cd96d9, https://si.imgix.net/0d7d193a/uploads/origins/fb1889ce-f751-4f1a-9b14-6e954faaafab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a625174023ce2a12972c35d02eca56b8 2x, https://si.imgix.net/0d7d193a/uploads/origins/fb1889ce-f751-4f1a-9b14-6e954faaafab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b8f0767f98db238061e92a379dd4538 3x", "genre": "art", "nsfw": true, "body": "こんにちは！もし可能なら、また別の作品を依頼したいんだ。\n題材は、少し前に依頼したDKの作品の続編のようなものです。\n\nDKのトップ3（ゼルダ、デイジー、ルキナ）が交尾をしながら王様を褒め称えているシーンをお願いしました。この作品では、同じ3人の女の子を描いてほしいのですが、デイジーの番が表示されています。\n\n構図はこの作品に描かれているエーデルガルドの位置と似ているが、いくつかの違いがある。https://fantia.jp/posts/2325069\n\n-ゼルダはDKとのターンから回復しており、できればすでにザーメンで示されている。\n-DKはルキナ（期待してオナニーしている）に片腕を回している。\n-この作品では、3人の女性が全員ネクタイをしている。\n\nイヤリングやティアラ、ルキナのブランドなど、ジャングルの影響が彼女たちの私物に及んでいる細かい描写は、個人的に先生の作品で好きな要素なので、ぜひ入れてほしいです！\n\n今回、台詞を入れるか入れないかはあなた次第です。\nぜひご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/244", "thumbnail_src": "https://si.imgix.net/e05dc125/uploads/origins/cc32b030-8f22-46ec-b3dd-56957ad2fe95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc8e4a2279d81099684fa821172c331", "thumbnail_srcset": "https://si.imgix.net/e05dc125/uploads/origins/cc32b030-8f22-46ec-b3dd-56957ad2fe95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc8e4a2279d81099684fa821172c331, https://si.imgix.net/e05dc125/uploads/origins/cc32b030-8f22-46ec-b3dd-56957ad2fe95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52591b62275ff9daedbf5a7fb8fe73eb 2x, https://si.imgix.net/e05dc125/uploads/origins/cc32b030-8f22-46ec-b3dd-56957ad2fe95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82d3750316f72748e27a1fd7b4a08b5f 3x", "genre": "art", "nsfw": true, "body": "お世話になっています！久しぶりに依頼のほうをしようと思います！\nキャラ：ブルーエンジェル\n竿役：龍亞\n衣装等の設定は以前から依頼させてもらっているものでお願いします！\nシチュエーションはいろいろな女性モンスターやデュエリストと性行為をするうちに思うように射精することができなくなり睾丸に精液が貯まりまくってどうしようもなくなってしまう龍亞。それを見かねたブルーエンジェルが授乳手コキですっきりさせようとする。あと一歩のところで射精できなくて苦しそうにしているところに不意打ちのディープキスをしてうどんのような精液が大量射精する。また貯まって苦しくならないように連続で手コキを再開し足をガクガクさせまた大量射精しお互いの体が精液でドロドロになる。こんな感じでお願いします！\n補足：龍亞くんのセリフは甘えマゾみたいな感じでお願いします！また射精する瞬間はアへ顔でお願いします！\n\nhttps://www.pixiv.net/artworks/51836316", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/243", "thumbnail_src": "https://si.imgix.net/d0cf4946/uploads/origins/acbf8148-b151-469c-9edb-a53771e83abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d654ab60670cd787c355837fababa35d", "thumbnail_srcset": "https://si.imgix.net/d0cf4946/uploads/origins/acbf8148-b151-469c-9edb-a53771e83abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d654ab60670cd787c355837fababa35d, https://si.imgix.net/d0cf4946/uploads/origins/acbf8148-b151-469c-9edb-a53771e83abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8ab3d7c210ee19979b6cc43abe9c0c0 2x, https://si.imgix.net/d0cf4946/uploads/origins/acbf8148-b151-469c-9edb-a53771e83abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdcc89cde8dfb07d82eb5c116aeda88d 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムヒーローズ』のバルドルとホズル（以前にもやっていましたねhttps://fantia.jp/posts/3464494）が、妊娠してミルクを出しながらセックスしているところを見てみたいです。https://skeb.jp/@wozmee_18/works/105のような絵で、二人とも召喚獣と一緒にいるか（その場合、召喚獣のペニスを取っているのはバルドルであるべきです）、あるいはドンキーコングとディディーコングと一緒にいるか（その場合、どの女の子がどの猿・猿とパートナーになるかはお任せします）を決めることができます。適切な台詞をお願いします。\n\nどのようなシチュエーションであっても、2人の女の子は楽しそうな笑顔を浮かべ、子供を産むことを楽しんでいるはずだ。\n\n概要BaldrとHöðrは妊娠しながらセックスしている。召喚獣と。あるいはドンキーコングとディディーコングと。乳房からはミルクが出ており、彼らは目に見えてセックスを楽しんでいる。できれば状況に適した台詞を。\n\n翻訳に大きな問題がないことを祈ります。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/242", "thumbnail_src": "https://si.imgix.net/717ad911/uploads/origins/c82fc18c-daf0-4ae7-9e3f-a4eff5cacfb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb0a55b4e73b829e599feb346da494d", "thumbnail_srcset": "https://si.imgix.net/717ad911/uploads/origins/c82fc18c-daf0-4ae7-9e3f-a4eff5cacfb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb0a55b4e73b829e599feb346da494d, https://si.imgix.net/717ad911/uploads/origins/c82fc18c-daf0-4ae7-9e3f-a4eff5cacfb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0d096052e7c73c6559f4124f44e6031 2x, https://si.imgix.net/717ad911/uploads/origins/c82fc18c-daf0-4ae7-9e3f-a4eff5cacfb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94a57b0005ecf065e07b986ece1bef36 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n「悪魔城ドラキュラ黙示録」の「キャリー・ヴェルナンデス」ちゃんのイラストをリクエストさせていただきたく、ご検討よろしくお願いいたします。\n\nこちらのイラスト（https://www.pixiv.net/artworks/72715204）のキャリーちゃんが、もしもドゲザーの代わりにファットスローターに犯されていたらというシチュが希望です。サディスティックなうえに、しかも、小柄な体躯の少女が好みのファットスローターに目を付けられてしまった設定で、ドSでハードなプレイで強引に犯されている雰囲気があると嬉しいです。\n\n・背面駅弁のような体位で、ほぼ正面～やや斜め前からのアングル、下記のシャーロットちゃんのような雰囲気でお願いいたします。\nhttps://www.pixiv.net/artworks/72715204\nhttps://skeb.jp/@wozmee_18/works/205\n片手で細い腰付近を掴まれ、もう片手でちっちゃな胸を愛撫されて、小柄なキャリーちゃんが片腕だけでモノのように簡単に持ち上げられて、上下に激しくピストンされている雰囲気だと嬉しいです。\n\n・服装は、前回ご納品いただいたキャリーちゃん（https://skeb.jp/@wozmee_18/works/214）とだいたい同じような感じでお願いいたします。黒ストも前回同様、着用したまま何か所か破かれているようにお願いいたします。\n\n・キャリーちゃんは小柄な感じで、ファットスローターと体格差が感じられると嬉しいです。\n\n・もし差し支えなければ、敗けちゃったときにつけられたか、サディスティックなプレイ中に付けられたような感じで、擦り傷や打撲痕をお願いします。\n\n・下記のように表情やぶっかけの差分をお願いいたします。\n（１）嗜虐的なファットスローターに恐怖して、怯えて泣いてしまっている表情\n（２）髪や顔、身体に大量にぶっかけられ大量中出しもされて、ハードなプレイでぐったりしており、心折れて屈服している表情\n（３）ダメ押しで、既に堕ちていた仲間の魔術、もしくは、ドゲザーの瞳術などでマゾ的な悦びを増幅され、乱暴にされているのに快楽を感じ始めている表情\n（４）奴隷堕ち宣言＆もっと激しくしてほしいと懇願している、完全に堕ちてしまった表情\n以上です。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/241", "thumbnail_src": "https://si.imgix.net/6dc91d98/uploads/origins/770457a7-69c9-4e1c-8cac-a59c4fe20807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1399fd48989246206ba63cc2a2eec91a", "thumbnail_srcset": "https://si.imgix.net/6dc91d98/uploads/origins/770457a7-69c9-4e1c-8cac-a59c4fe20807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1399fd48989246206ba63cc2a2eec91a, https://si.imgix.net/6dc91d98/uploads/origins/770457a7-69c9-4e1c-8cac-a59c4fe20807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b64673d455f31d4b5b5adef161782012 2x, https://si.imgix.net/6dc91d98/uploads/origins/770457a7-69c9-4e1c-8cac-a59c4fe20807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45c29f3351e30d0691641b1868ca817a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n価格が低すぎる場合は、再送をお願いします。\n\nサムス・アランとドンキーコングのリクエストです。\n\nドンキーコングは巨大で太くていやらしいペニスを持っています。サムスには、頭よりもはるかに大きな胸、曲線美のある体、そして肉厚なお尻、そしてピンクの乳首が欲しいです。\n\nサムスの参考画像：https://is.gd/JoLxBk\n\nサムスは腕と脚以外は裸です：https://is.gd/hkWosI\n\nサムスのお腹はとんでもなく大きく、数フィート突き出ているようにしたいです。お腹にはたくさんの赤ちゃんゴリラがいるからです。\n\nポーズは同じです。サムスは表情を変えるだけで、後で妊娠します。ビフォーアフターのフォルダはこちらです：https://is.gd/TiDU4o\n\n1. ドンキーコングはサムスの足首をつかんで拘束します。勃起したペニスは、剃られた陰唇のすぐ下にあります。サムスは精液が滴る巨大なゴリラのペニスに興奮する。\n\n2. 彼はそれをサムスのきつい人間の膣の奥深くまで突き刺す。サムスの人間のDNAをゴリラの精子で上書きするつもりだ。\n\n2- バリエーション。ドンキーコングは彼女の子宮に射精し、サムスは絶頂を迎える。彼女の人間の卵子は受精し、彼女はたくさんのゴリラの赤ちゃんを妊娠する。\n\nパート2：\n\n妊娠中のお腹の大きさの例：https://is.gd/tfPuag\n\n3. これが未来だ。彼女の妊娠中のお腹は通常の妊娠の5倍の大きさで、歩くには大きすぎる。ドンキーコングのペニスは彼女の太ったお腹の下に隠れている。\n\n4. 彼は再びペニスを彼女の妊娠中の膣に突き刺し、激しく犯す。彼女はドンキーコングのオナホになる。ドンキーコングは彼女の膣を好き勝手に使い、ゴリラの赤ちゃんを産む。 DKが再び彼女の膣内に射精すると、彼女は舌を突き出し、快感に首を反らせます。彼女の子宮は精子と赤ちゃんでいっぱいです。\n\n^ - 可能であれば、射精なしの代替案もお願いします。\n\n5. 彼女は子宮から巨大なゴリラの赤ちゃんを出産します。臍の緒はまだ彼女の膣に付いています。出産後も、彼女のお腹は大きく、赤ちゃんでいっぱいです。彼女は欲情した表情を浮かべています。\n\n背景はあなた次第です。\nサムスがDKのオナホになりたがるシーンにテキストを追加することもできます。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/240", "thumbnail_src": "https://si.imgix.net/3e2cd994/uploads/origins/c0a842d5-7b4b-4016-ab76-c57af21d9ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9898aa228d2c1e9fd391a3d03bd4bf6b", "thumbnail_srcset": "https://si.imgix.net/3e2cd994/uploads/origins/c0a842d5-7b4b-4016-ab76-c57af21d9ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9898aa228d2c1e9fd391a3d03bd4bf6b, https://si.imgix.net/3e2cd994/uploads/origins/c0a842d5-7b4b-4016-ab76-c57af21d9ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d1a8bf8fccb61ad4ca439e0aa0c5a3 2x, https://si.imgix.net/3e2cd994/uploads/origins/c0a842d5-7b4b-4016-ab76-c57af21d9ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b596184311b964b9b775486ddde0ebe5 3x", "genre": "art", "nsfw": true, "body": "「ファイアーエムブレムエンゲージ」よりイルシオン姉妹Wパイズリイラストを依頼させていただきます\n前回のセックスパーティ後にオルテンシアをハーレムに迎え入れたロサードがアイビーを交えてWパイズリを堪能しているというシチュエーションです\nパイズリメインでロサードは画面内に映っていなくても大丈夫です\n恰好は前回同様全員全裸で、オルテンシアの胸のサイズは最近大きくなってるという感じでFEHのクリスマス仕様のように盛り気味にしていただきたいです\n可能であればロサードが姉妹それぞれとセックスしてるシーンのワイプもいただけると嬉しいです\n今回も盛った依頼ですがご検討宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/239", "thumbnail_src": "https://si.imgix.net/dd266a34/uploads/origins/1bc12c86-f65d-4a82-8ded-e5d96d519894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd8da9b59c07b97e6d98c580b90d4eb2", "thumbnail_srcset": "https://si.imgix.net/dd266a34/uploads/origins/1bc12c86-f65d-4a82-8ded-e5d96d519894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd8da9b59c07b97e6d98c580b90d4eb2, https://si.imgix.net/dd266a34/uploads/origins/1bc12c86-f65d-4a82-8ded-e5d96d519894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa1f5f64f027e2f18dac4e88d3b4d537 2x, https://si.imgix.net/dd266a34/uploads/origins/1bc12c86-f65d-4a82-8ded-e5d96d519894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7cdd68def42446f41cecde85b0106c8 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。  \n今回は沼地の魔神王同族化イラストの氷水のエジルの姿のエジルメインのハーレムをみたく依頼を出させていただきます。   \n\nキャラ:氷水のエジル(地霊媒師アウス,閃刀姫ロゼ )\n 竿役:沼地の魔神王  \n\nシチュ:アウスの領域支配地泥術により昼も夜もなく交尾し続ける三魔臣姫。趣向を変えて覚醒する以前の姿にて魔神王の相手をするエジル、無垢なる姿に不釣り合いなほどの泥による爆乳と巨尻を貪り壊れるほど自分本意に扱っても喜びを覚え億年もの恋慕を深める都合の良い存在に特濃の魔泥を注ぎ当然着床直ぐにアウスの術により懐妊する。\n此度賜ったのは数千数万に一体宿る氷水の子女帝たるエジルの子ともなればとてつもない力と次代の女帝たる資質を秘めた子になるやもしれないが、氷水の駒は既にクレイドルより出でるもの達により足りているといいすぐさまボテ腹交尾に移行、いまの姿と魔神王との激しい交尾に耐えきれずに宿ってすぐにその氷水は\"ダメに\"なってしまうそのことにエジルは氷水という種族に何度かもわからぬ落胆をするが魔神王が胎に出した超特濃の魔泥によりドロゴンへとなったことで主の子を産める喜びと沼地への畏敬を深める。\nクレイドルに還ることなく次代を成し得ない狂った循環により君臨し続ける氷水の女帝とそれを支配する王の宴は続いていくみたいな感じで。\n\n補足: \n依頼文にもあるように胸尻は大きくして欲しいです。\nまたセリフでは強めに氷水の種族ディスと沼地の持ち上げをしていただけると嬉しいです。\n流れとしては擬態エジル状態交尾→射泥→ボテ腹化擬態解除→ボテ交尾→射泥\nのような感じでお願いしたいです。\n\n長文失礼しました。\n梅雨冷えの厳しき折、お風邪など召されませぬようご自愛ください。\n ご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/238", "thumbnail_src": "https://si.imgix.net/59df6a8b/uploads/origins/1a9c1d4f-6435-4d20-82ce-fa2bc597ec36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5fb4d36fa3db195c3529e4df1b50d7", "thumbnail_srcset": "https://si.imgix.net/59df6a8b/uploads/origins/1a9c1d4f-6435-4d20-82ce-fa2bc597ec36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5fb4d36fa3db195c3529e4df1b50d7, https://si.imgix.net/59df6a8b/uploads/origins/1a9c1d4f-6435-4d20-82ce-fa2bc597ec36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4e082fcc5081bd5e1e4b49e3b7f9254 2x, https://si.imgix.net/59df6a8b/uploads/origins/1a9c1d4f-6435-4d20-82ce-fa2bc597ec36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3fc96e9748183fc979fba83853d8ab4 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\nリクエスト - チェンソーマンのマキマと醜い犬。\n\nシーン：マキマはセクシーなレースの下着を身につけ、ベッドに横たわり、大きな胸を露わにしています。その様子をビデオレコーダーで撮影しています。彼女の後ろのベッドでは、大きくて汚くて醜い犬が前足をベッドに突っ込んでいます。巨大な犬の精液が滴り落ちています。\n\n彼女はデンジに見せびらかし、彼を寝取るためにこの動画を撮影しています。\n\n背景はシンプルな暗い部屋でもベッドでも構いません。テキストはセクシーなものなら何でも構いません。\n\n彼女の体は曲線美でセクシーであること。信じられないほど大きく、豊満で、丸い胸。巨乳でお願いします。\n\n参考フォルダリンク：https://is.gd/9pJdRv\nフォルダは4つあります。それぞれ用途に合わせて名前を付けました。\n\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/237", "thumbnail_src": "https://si.imgix.net/81dea7ea/uploads/origins/e2bf1018-1acf-44d8-9639-464bc46a8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb3782f64a80fb6d050fccc02e6ffad", "thumbnail_srcset": "https://si.imgix.net/81dea7ea/uploads/origins/e2bf1018-1acf-44d8-9639-464bc46a8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb3782f64a80fb6d050fccc02e6ffad, https://si.imgix.net/81dea7ea/uploads/origins/e2bf1018-1acf-44d8-9639-464bc46a8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b48747de6ac86853efd99892decdd0 2x, https://si.imgix.net/81dea7ea/uploads/origins/e2bf1018-1acf-44d8-9639-464bc46a8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5628ed66aa14dcfb92aa3b8b57335304 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/236", "thumbnail_src": "https://si.imgix.net/7972b8c2/uploads/origins/9c0b49ac-90d7-46ae-adc6-6ddaf548674e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec14a035eefd4732a968b1399c958326", "thumbnail_srcset": "https://si.imgix.net/7972b8c2/uploads/origins/9c0b49ac-90d7-46ae-adc6-6ddaf548674e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec14a035eefd4732a968b1399c958326, https://si.imgix.net/7972b8c2/uploads/origins/9c0b49ac-90d7-46ae-adc6-6ddaf548674e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8c5694a436d69e82fe5b39958cd4980 2x, https://si.imgix.net/7972b8c2/uploads/origins/9c0b49ac-90d7-46ae-adc6-6ddaf548674e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=959d4b060024b6370fd6c0ed4963394b 3x", "genre": "art", "nsfw": true, "body": "越境依頼失礼します。\n\nFAIRYTAIL女子がゴリラ達に堕とされるイラストをお願い致します。\nキャラはルーシィ、ジュビア、エルザ、ウェンディ、リサーナ、ミラから2,３名をお願い致します。\n\n構図やシチュは先生にお任せ致します。\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/235", "thumbnail_src": "https://si.imgix.net/590ac47f/uploads/origins/abb88ad3-94c3-41ab-888b-97f42cfed3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=532cc8f634bbac2fcb3d688c2e8e394c", "thumbnail_srcset": "https://si.imgix.net/590ac47f/uploads/origins/abb88ad3-94c3-41ab-888b-97f42cfed3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=532cc8f634bbac2fcb3d688c2e8e394c, https://si.imgix.net/590ac47f/uploads/origins/abb88ad3-94c3-41ab-888b-97f42cfed3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faefad0e2bb4fdb125c77ab3d0009ac4 2x, https://si.imgix.net/590ac47f/uploads/origins/abb88ad3-94c3-41ab-888b-97f42cfed3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c742166b605d45a34a02a70318e3a2 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n 三度、蒼き雷霆ガンヴォルト鎖環のきりんの馬セックスイラストを依頼したく出させていただきます。  \n\nキャラ:きりん(トライアングルエディションのゲーマーズ特典風衣装)\n 竿役:馬 \n\n シチュ:運命の黒馬様によって世界のほとんどの雌能力者が纏められそれによって恒久的な平和が実現した世界線、その馬主人様の1番のお気に入りの正妻であるきりんとの公開結婚契約式が執り行われる。能力者として戦巫女としてそして女の子として最大限にめかしこみ数多の異性が欲しがり数多の同性が羨む姿で式に望み、自身の鎖環や他能力者の力で紙面、男根そして唇への誓いのキスで死すらも2人を別てない超不平等馬主人様優遇契約を締結する。そして行われる超暴力的な交尾による快楽で完全に命の灯火が消えるものの愛の契約と電子の踊精などの効果により馬主人に都合の良すぎる専用妻として存在そのものを書き換えられ復活する。そんな奇跡さえ必然となった生まれ変わりに雌達はさらに心酔し世界は崇拝される馬主人を中心に平和にされていくみたいな感じでお願いします。\n\n  補足:胸尻はいつもながら大きく。\n姿はトライアングルエディションのゲーマーズ特典の衣装を馬媚びや\n交尾しやすい感じにして本来はやってませんが元のアイシャドウや体のライン他全力でエロい感じでお願いしたいです。\n構図は以前描かれてたゼロスーツサムスとスリーパーイラストみたいな立ち絵&背面アングルの背中のマーク剥き出しバックだと嬉しいですが難しければ別の構図で問題ないです。\n後馬主人のやりたい放題感のために過去作や外伝キャラぽいガヤセリフなどもお願いしたいです。\n\n長文になってしまい申し訳ありません。\n季節の変わり目ですが、くれぐれもご自愛ください。\n ご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/234", "thumbnail_src": "https://si.imgix.net/209f8350/uploads/origins/7017c390-b246-4cd8-abfb-c913e17b0e27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72a4fd83ec8b9f546a63c50ac3389da", "thumbnail_srcset": "https://si.imgix.net/209f8350/uploads/origins/7017c390-b246-4cd8-abfb-c913e17b0e27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72a4fd83ec8b9f546a63c50ac3389da, https://si.imgix.net/209f8350/uploads/origins/7017c390-b246-4cd8-abfb-c913e17b0e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=853d19d032f6089a11a91108be1314ce 2x, https://si.imgix.net/209f8350/uploads/origins/7017c390-b246-4cd8-abfb-c913e17b0e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9a47650c671afee72b9b9fb91237e18 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回はポケモンの性豪なミツル竿役のイラストを見たく依頼をさせていただきます。\n\nキャラ:アスナ\n 竿役:ミツル\n\nシチュ:試行錯誤の一環で、自分に勝った若きトレーナーと裸の付き合いとして温泉に混浴で入りバトルについての語らいをしようとアスナと連れられたミツル。\nしかしアスナの実り切った身体に理性のたがが外れ身体を流すという名目で近づきそのまま交尾に持ち込む。\n言葉で宥めていたアスナだが、ミツルの見た目からは考えられない剛直と巨大な睾丸に裏打ちされた絶倫そしてうちに眠っていた性行為(バトル)の才能が完全に開花し拙く自分本位の動きにもかかわらずツボ洗いに完全に陥落する。\nその後旅の中でホウエン中の名のある性行為に適したメス達と関係を持ったミツルは温泉ハーレム行為を行い、旅で絶倫さと技量が増したさらなる性豪へと進化しミツルはアスナ以外のハーレムメンバー全員の意識を飛ばした後覚醒したあの日を思い出すようにアスナと行為に及ぶみたいな感じで。\n\n補足:今回も胸尻を大きく、特に胸は屈指の大きさみたいな感じで頼みたいです。\nまたユウキや他の雄は手を出せなかったのに男らしいみたいな感じの優越感を煽るセリフがほしいです。(堕ち後には混浴はミツル以外しない感じで)\n堕ち後の時系列はエピソードデルタ前で、ストーリー内の襲撃で堕とされる想定のカガリ以外のめぼしいトレーナー全てがミツルと関係を持ってる感じでお願いしたいです。\n\n春と共に幸多からんことをお祈りいたしております。\nご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/233", "thumbnail_src": "https://si.imgix.net/3cf27a7b/uploads/origins/7dd7bad3-1bfe-48d8-a6f8-da2d67de1a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09a272c40a9374cdfdd399eb960167e7", "thumbnail_srcset": "https://si.imgix.net/3cf27a7b/uploads/origins/7dd7bad3-1bfe-48d8-a6f8-da2d67de1a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09a272c40a9374cdfdd399eb960167e7, https://si.imgix.net/3cf27a7b/uploads/origins/7dd7bad3-1bfe-48d8-a6f8-da2d67de1a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef48bfeb137adee56303f26661792f25 2x, https://si.imgix.net/3cf27a7b/uploads/origins/7dd7bad3-1bfe-48d8-a6f8-da2d67de1a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8a2bcf338fb06005e7434428a87f62d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wozmee_18/works/232", "thumbnail_src": "https://si.imgix.net/dcdb0800/uploads/origins/7218e68f-ac14-47a4-98d6-59a52b00a215?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb1ba664a8914d2558cbdc5dbd279509", "thumbnail_srcset": "https://si.imgix.net/dcdb0800/uploads/origins/7218e68f-ac14-47a4-98d6-59a52b00a215?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtf