2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=242146611be3146de181fd452f536228 2x, https://si.imgix.net/9d97ddf8/uploads/origins/11e75075-3c4f-466a-b0dd-af173a32362a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6ff70c45ed2fbd63b82a58c027801b 3x", "genre": "art", "nsfw": false, "body": "please draw my original caracter in a orange colored bikini. Have her in sexy pose\nEye color: gray\n\nHeight: 5'9 \"\n\nAge: 20\n\nShe has dog ears\n\nAccessory: red collar\n\nBackground: beach\n\nPose: sexy\n\nExpression: Flirt\n\nhere are references of my original caracter: https://www.deviantart.com/citrusanime/art/My-Offical-DA-Mascot-290687270\n\nother artists 1. https://sta.sh/023ht6z36vqf 2. https://sta.sh/0278r2mg6ixd 3. https://sta.sh/0k1ja8v3adq\n\nreferences for pose 1. https://sta.sh/0ufsyy8di0d 2. https://sta.sh/0sozjsty4p7 3. https://sta.sh/01hzsy3ciyyy\n\nplease make drawing sexy. thank you.", "created_at": "", "completed_at": ""}, {"path": "/@tukinaki/works/14", "thumbnail_src": "https://si.imgix.net/5f1296f6/uploads/origins/797cafd7-6830-420d-a461-e80920262971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9041858f00e5479612a71ad9a80b237", "thumbnail_srcset": "https://si.imgix.net/5f1296f6/uploads/origins/797cafd7-6830-420d-a461-e80920262971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9041858f00e5479612a71ad9a80b237, https://si.imgix.net/5f1296f6/uploads/origins/797cafd7-6830-420d-a461-e80920262971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bd96d1fa4558ede9131daf53df012da 2x, https://si.imgix.net/5f1296f6/uploads/origins/797cafd7-6830-420d-a461-e80920262971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=469a93abd72d15189fdd394ae5dc986d 3x", "genre": "art", "nsfw": false, "body": "こんばんは、今回もイラストをリクエストしたく打ち込みました。\n\nフラワーナイトガールのニレで衣装は通常\nサーカス団の一員なので何かしらのパフォーマンスをしてる\nスカートをたっぷりなびかせるような感じでお願いします\n一輪車を持ってるのですが、使うかどうかはお任せします", "created_at": "", "completed_at": ""}, {"path": "/@tukinaki/works/13", "thumbnail_src": "https://si.imgix.net/7776e90f/uploads/origins/6a9b5ab5-3018-4d10-95d4-d54d531ca29f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e7c2ef74b4c4e0910bef206afae55b5", "thumbnail_srcset": "https://si.imgix.net/7776e90f/uploads/origins/6a9b5ab5-3018-4d10-95d4-d54d531ca29f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e7c2ef74b4c4e0910bef206afae55b5, https://si.imgix.net/7776e90f/uploads/origins/6a9b5ab5-3018-4d10-95d4-d54d531ca29f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=371f684a7e5f22a413285f2378abf185 2x, https://si.imgix.net/7776e90f/uploads/origins/6a9b5ab5-3018-4d10-95d4-d54d531ca29f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ce2a6bdf9156047fb2819b961eb8209 3x", "genre": "art", "nsfw": false, "body": "こんにちは。前回は素敵なイラストを描いていただいてありがとうございました。\n今回もリクエストをしたく打ち込みました。\n\nF～ファナティック～のカレン\n濃淡のはっきりしたブラウンベースのドレスを着た、カールのかかったロングヘアーの女の子です。\n\nhttps://game.watch.impress.co.jp/docs/20040311/f02.htm\nhttps://game.watch.impress.co.jp/docs/20040311/f.htm\nhttp://hoshi3zora.free.fr/fanatic/fanatic.php\nhttp://anatanohohoemi.holy.jp/entrance/teleca/fanatic/fanatic.html\n\nドレスのスカートを柔らかくふんわりボリュームたっぷりなびせるような感じ。\nドレスのデザインが気に入って無邪気さも入ってるイメージ。\n特にスカート本体を覆ってる部分はフリフリたっぷりでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tukinaki/works/12", "thumbnail_src": "https://si.imgix.net/75934216/uploads/origins/3e65934e-9033-46f1-95e6-71b3716a919e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113999daf0e4a17cba42d51d6c00ca73", "thumbnail_srcset": "https://si.imgix.net/75934216/uploads/origins/3e65934e-9033-46f1-95e6-71b3716a919e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113999daf0e4a17cba42d51d6c00ca73, https://si.imgix.net/75934216/uploads/origins/3e65934e-9033-46f1-95e6-71b3716a919e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8230196a5df964d83bf02850b7c38ab8 2x, https://si.imgix.net/75934216/uploads/origins/3e65934e-9033-46f1-95e6-71b3716a919e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=becd6ef5f75f8bd6f06b5c0532bcdc71 3x", "genre": "art", "nsfw": false, "body": "フラワーナイトガールのラバテラで衣装は通常\nフリフリスカートをボリュームたっぷりになびかせてシェイカーを振るような感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tukinaki/works/11", "thumbnail_src": "https://si.imgix.net/a15609dc/uploads/origins/dab2e530-9493-40ba-9c78-c5e72ac84bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e855924701c926d8cf384cd18107664f", "thumbnail_srcset": "https://si.imgix.net/a15609dc/uploads/origins/dab2e530-9493-40ba-9c78-c5e72ac84bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e855924701c926d8cf384cd18107664f, https://si.imgix.net/a15609dc/uploads/origins/dab2e530-9493-40ba-9c78-c5e72ac84bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c341ee78f4aab9423cc2f98a5b74890 2x, https://si.imgix.net/a15609dc/uploads/origins/dab2e530-9493-40ba-9c78-c5e72ac84bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d57dd302678539f7c8e7876f17f56f2b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n検索から、とても良いなと思いましたので依頼させていただきます。\n大変申し訳ないのですが、名前を出すのが恥ずかしいので匿名でお願いします。\n\n花騎士のミズキちゃんをお願いします。\n依頼内容の詳細は下記のとおりです。\n\n・衣装は、開花後の衣装でお願いします。\n・戦闘中（もしくは戦闘後）で汗だくになっている。\n・背景は簡単でいいのであると嬉しいです。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tukinaki/works/10", "thumbnail_src": "https://si.imgix.net/08311287/uploads/origins/4fd29586-4dfd-4274-b8ab-2c1abbd1bec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e5d48cc857476be19d970d63902f213", "thumbnail_srcset": "https://si.imgix.net/08311287/uploads/origins/4fd29586-4dfd-4274-b8ab-2c1abbd1bec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&