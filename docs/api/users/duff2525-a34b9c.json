7b19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0faa947daf9dfca305c45ab848cbd62 3x", "genre": "art", "nsfw": false, "body": "こんばんは。次のリクエストをお願いします。\nキャラクター：\n[歓びのアティチュード]綾瀬穂乃香＋\n[清澄のエッセンス]一ノ瀬志希＋\n\nシチュエーション（イメージ）：\nバルコニーでイケメン風の志希が穂乃香の腰に手を回して抱き寄せていて、穂乃香が恥ずかしがっている\n\nそのほかはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@duff2525/works/164", "thumbnail_src": "https://si.imgix.net/e7c7419e/uploads/origins/1c3cba8c-ace9-4a78-a01a-2681bc933e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a10eb457f9f8aa0fc793e7a7e4037b19", "thumbnail_srcset": "https://si.imgix.net/e7c7419e/uploads/origins/1c3cba8c-ace9-4a78-a01a-2681bc933e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a10eb457f9f8aa0fc793e7a7e4037b19, https://si.imgix.net/e7c7419e/uploads/origins/1c3cba8c-ace9-4a78-a01a-2681bc933e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd3e5779f7121c6ea61a62a3daebfd77 2x, https://si.imgix.net/e7c7419e/uploads/origins/1c3cba8c-ace9-4a78-a01a-2681bc933e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c3e60dcfacce8ae2594c40c79c2e8a0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@duff2525/works/163", "thumbnail_src": "https://si.imgix.net/26d4eb29/uploads/origins/95ca8dd0-6378-43ec-9d71-bf9ad68b7b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc4368aadc166b0f977119926938d4b3", "thumbnail_srcset": "https://si.imgix.net/26d4eb29/uploads/origins/95ca8dd0-6378-43ec-9d71-bf9ad