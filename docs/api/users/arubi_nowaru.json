という要素があればとても嬉しいです。\n\n完成したイラストはSNSのアイコンや自キャラの資料に載せて使用させていただく予定です。\nもしよろしければ承認していただけたら嬉しいです…！よろしくお願いいたします。\n\nhttps://x.com/memekyun_o/status/2009935416796078561?s=46&t=A1tLnNIja9V3RGwZl4KOEQ", "created_at": "", "completed_at": ""}, {"path": "/@arubi_nowaru/works/18", "thumbnail_src": "https://si.imgix.net/18cc91e8/uploads/origins/5b417dd4-8339-46f7-9631-632c70ff51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79a56f16357df2c8ef62535412318e94", "thumbnail_srcset": "https://si.imgix.net/18cc91e8/uploads/origins/5b417dd4-8339-46f7-9631-632c70ff51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79a56f16357df2c8ef62535412318e94, https://si.imgix.net/18cc91e8/uploads/origins/5b417dd4-8339-46f7-9631-632c70ff51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7a56593cd13607dcbed2710ce2eac0d 2x, https://si.imgix.net/18cc91e8/uploads/origins/5b417dd4-8339-46f7-9631-632c70ff51a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0f15f9e5d2b4eb39ae8884fcfce8121 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arubi_nowaru/works/17", "thumbnail_src": "https://si.imgix.net/c4414047/uploads/origins/a0fd3ff8-db6e-45b1-96c5-d9239a5520be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b8c82e6b64cc9d0ffe34da59f535df1", "thumbnail_srcset": "https://si.imgix.net/c4414047/uploads/origins/a0fd3ff8-db6e-45b1-96c5-d9239a5520be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b8c82e6b64cc9d0ffe34da59f535df1, htt