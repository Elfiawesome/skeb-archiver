ix.net/a965724e/uploads/origins/deefd5d4-539f-4a02-b602-7aa75f2cb71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a2c55fd111aaacca74a90a9c60d499", "thumbnail_srcset": "https://si.imgix.net/a965724e/uploads/origins/deefd5d4-539f-4a02-b602-7aa75f2cb71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a2c55fd111aaacca74a90a9c60d499, https://si.imgix.net/a965724e/uploads/origins/deefd5d4-539f-4a02-b602-7aa75f2cb71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf16475618b744d3a92deaba28222b09 2x, https://si.imgix.net/a965724e/uploads/origins/deefd5d4-539f-4a02-b602-7aa75f2cb71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78225ddc213d80e4381fe3770de88783 3x", "genre": "art", "nsfw": false, "body": "すいみそ様\n\nはじめまして。以前からすいみそ様の描かれる少女たちの瞳の瞬きと、どこか静謐な絵柄と雰囲気がとても好きで、ぜひ依頼させていただきたいです。\n\nフォルダのキャラにあるような黒髪の少女を描いて頂きたいです。\nモノクロだと嬉しいですが、全体のイメージの方を優先させていただければと思います。\n※また、これに加えharuka nakamuraさんの『arne』のMVに出てくる女性の雰囲気が近いのですが、こちらの視聴はお任せします。\n\nまた更に、\n・白いヴェールを頭にかぶっている\n・素足（もし足が入らない構図でしたら無視していただいて大丈夫です）\n・歯を見せない微笑み方\nもお願いさせていただきたいです。\n構図や少女の服装などは自由にしていただいて大丈夫です。\n\n使用用途はIDかお名前を記載させていただいた上でTwitterのアイコンとして使わせていただきたいと思っております。\n\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/19SPbbjJkUpal5aCFvDnQcUw3uMymXgI5?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@swimmie25/works/10", "thumbnail_src": "https://si.imgix.net/bccd8e1d/uploads/origins/e37b3220-771e-4068-8ca8-06597b06f857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=655a214b35393404ce7032311f5b64d9", "thumbnail_srcset": "https://si.imgix.net/bccd8e1d/uploads/origins/e37b3220-771e-4068-8ca8-06597b06f857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&