-b476-1295d217ecdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=affdc3780ee758561268ee3e3504ce80 2x, https://si.imgix.net/16993220/uploads/origins/af89b6d4-1edc-449f-b476-1295d217ecdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aec3d2e3e8b5eaac3490661420ba6992 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n以前も依頼させていただきました者です。\n普段VTuberとして活動をしており、私自身のイラストを描いていただけませんでしょうか。\n何卒よろしくお願いいたします。\n\nポーズ、構図、背景、サイズ等については特段の指定はございません。\n可能であれば、大人っぽいテイストにしていただけますと嬉しいです。\n利用範囲は下記を想定しています。\n不可のものがございましたらリクエスト拒否をお願いいたします。\n\n【使用用途】\n1.Twitterへの投稿\n→Vtuber活動の一環として納品された次の平日にSNSへ投稿させていただきます。投稿の際は(#TwitterID)のように、タグ化し、通知の邪魔にならないようにする予定です。\n2.YouTube配信での使用\n→エンドカード等で使用させていただけますと幸甚です。\n　お手数ですが、背景やサイン等を入れられる際にはレイヤーを分けてPSDファイルでいただけますと助かります。\n\n【資料】\nTwitterに立ち絵他を載せておりますので、よろしければご参考にご覧ください。\nよろしくお願いいたします。\n\nhttps://twitter.com/Fuwa_Aruto\n\nhttps://twitter.com/Fuwa_Aruto/status/1541022517246119938?s=20", "created_at": "", "completed_at": ""}, {"path": "/@syu_raii/works/118", "thumbnail_src": "https://si.imgix.net/11a68dfb/uploads/origins/4460af0a-9c79-4c53-a67f-212751bcf8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc8bf2d4900bc00acfbcf9bf6e329a6", "thumbnail_srcset": "https://si.imgix.net/11a68dfb/uploads/origins/4460af0a-9c79-4c53-a67f-212751bcf8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc8bf2d4900bc00acfbcf9bf6e329a6, https://si.imgix.net/11a68dfb/uploads/origins/4460af0a-9c79-4c53-a67f-212751bcf8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09654843fa9ef8806b2f9e9ef7bb6156 2x, https://si.imgix.net/11a68dfb/uploads/origins/4460af0a-9c79-4c53-a67f-212751bcf8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51b2565fd97cf204c3c46d4b4445950c 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nイラストをひとめ見た時から素敵な画風に心奪われました。\n\n依頼したいのはオリジナルキャラクターで男の姿の私です。\n声をボイスチェンジして男になって配信することもあります。\n\n衣装は参考URLをもとにお好きに描いていただいて構いません。\n表情、構図やポーズはすべてお任せいたします。\n\n可能であればキャラクター（腰から上のイラスト見切れる所のない）\n透過PNGデータがほしいです。背景の有無はお任せします。\n\n～使用用途～\n・アイコン、ヘッダー、サムネイル等\n・配信画面に立ち絵として\n\n～OC詳細～\n・水色の髪の毛とケモミミあり、目はグリーン\n・尻尾はありません\n・けんかっぱやい性格で、夜バーテンをしています\n・左側に装飾あり（耳にピアス、三つ編み、Xのヘアピン）\n・首には一周縫い痕があります\n・いつもクマをつくっています\n・犬歯が少しとがっている\n\nお忙しいと思いますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/12FefyOq5FfNJkiTrqL_VG4yKoRsSTEWU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@syu_raii/works/117", "thumbnail_src": "https://si.imgix.net/84f6d9f9/uploads/origins/fb01c772-8988-4803-b60e-17b68b7921c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c6ce0797f2d0c0c1f577f9f48cdf932", "thumbnail_srcset": "https://si.imgix.net/84f6d9f9/uploads/origins/fb01c772-8988-4803-b60e-17b68b7921c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c6ce0797f2d0c0c1f577f9f48cdf932, https://si.imgix.net/84f6d9f9/uploads/origins/fb01c772-8988-4803-b60e-17b68b7921c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5049a8292706d24d11ba329f8332d54e 2x, https://si.imgix.net/84f6d9f9/uploads/origins/fb01c772-8988-4803-b60e-17b68b7921c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ced7cd63f271e6415d0423256c87d85a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生 先生の作品を拝見し、先生の絵が大好きなので、私のキャラクター（女の子3人です）の絵をお願いしたいです。\nトリオなのですが、ちょっと人数が多いので、リンク先に設定を載せておきます。https://drive.google.com/drive/folders/1QcIJkRFfYPdfEY3tnjeTs2zq89ZuaJlT\n\nhttps://drive.google.com/drive/folders/1QcIJkRFfYPdfEY3tnjeTs2zq89ZuaJlT", "created_at": "", "completed_at": ""}, {"path": "/@syu_raii/works/116", "thumbnail_src": "https://si.imgix.net/04dc04af/uploads/origins/1a038c33-bccf-41ca-8c66-6177c2763887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3015574431dba31016f94cf0aeb28f15", "thumbnail_srcset": "https://si.imgix.net/04dc04af/uploads/origins/1a038c33-bccf-41ca-8c66-6177c2763887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3015574431dba31016f94cf0aeb28f15, https://si.imgix.net/04dc04af/uploads/origins/1a038c33-bccf-41ca-8c66-6177c2763887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb610990d988d59876647686549077e4 2x, https://si.imgix.net/04dc04af/uploads/origins/1a038c33-bccf-41ca-8c66-6177c2763887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb91d1f7d7a300d82aee049ec2cb4155 3x", "genre": "art", "nsfw": false, "body": "個人Vtuberのメラ・アカルと申します。\n\n素敵なイラストを拝見しぜひご依頼したくリクエストさせていただきます。\n詳細は添付資料とTwitterををご覧くださいませ。\nTwitterID @mela_akaru\n\n私のデフォルト衣装でのイラストをぜひご依頼いたします。\nファイルの中のウルフカットがデフォルトになります。\nかっこよさの中にほんの少しのかわいさがあるようなイラストにしていただけるとうれしいです。\nよく歌ったり雑談をしております。\n\nまた舌ピアスが忘れられやすいので描いていただけるとうれしいです。\n\nSNSの宣伝や配信のサムネイル等に使わせていただきます。\nそのため、特に頭や肩など左右上下が切れない構図だと大変ありがたいです…！\nまたFANBOXやでも利用予定です。よろしくお願いいたします。\n\n簡易的な背景があればうれしいですが、そこはお任せいたします。\n\nPNGデータで人物と背景別で納品いただけますと幸いです。\nPSDデータでもかまいません。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_5pUiR-nwXWA9_caobOKoyID20I02-7D?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@syu_raii/works/115", "thumbnail_src": "https://si.imgix.net/406327ce/uploads/origins/03a5933f-1d0a-4e1a-bd1b-e51786a39ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4372bb666159576cb55a200a18dd41fb", "thumbnail_srcset": "https://si.imgix.net/406327ce/uploads/origins/03a5933f-1d0a-4e1a-bd1b-e51786a39ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4372bb666159576cb55a200a18dd41fb, https://si.imgix.net/406327ce/uploads/origins/03a5933f-1d0a-4e1a-bd1b-e51786a39ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&t