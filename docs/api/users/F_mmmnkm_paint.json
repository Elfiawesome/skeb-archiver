": "art", "nsfw": false, "body": "本文\n\nれお先生\nいつもお世話になっています\nIRIAMライバー\n花宮ゆりねさんのイラストをお願いできますでしょうか？\n\n黒ゴスロリチックな衣装で\n髪型は縦ロール　小物にリボン/レース付の傘等\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@F_mmmnkm_paint/works/14", "thumbnail_src": "https://si.imgix.net/8486c351/uploads/origins/ea64316c-26cc-4547-a247-59db33da1601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45e5c482fa68f066ba13b9ad693077c1", "thumbnail_srcset": "https://si.imgix.net/8486c351/uploads/origins/ea64316c-26cc-4547-a247-59db33da1601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45e5c482fa68f066ba13b9ad693077c1, https://si.imgix.net/8486c351/uploads/origins/ea64316c-26cc-4547-a247-59db33da1601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b388bc46d81de2dab97fbb4ea0b7338 2x, https://si.imgix.net/8486c351/uploads/origins/ea64316c-26cc-4547-a247-59db33da1601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9c5673041740577af942a88da3a0151 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@F_mmmnkm_paint/works/13", "thumbnail_src": "https://si.imgix.net/406903a8/uploads/origins/c18c8dc1-3bd5-4f65-a2de-52b8947590f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c70f1f22f4d9f0a45e058e50d3150815", "thumbnail_srcset": "https://si.imgix.net/406903a8/uploads/origins/c18c8dc1-3bd5-4f65-a2de-52b8947590f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c70f1f22f4d9f0a45e058e50d3150815, https://si.imgix.net/406903a8/upload