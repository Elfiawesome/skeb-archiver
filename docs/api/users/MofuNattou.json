9e7-8de0-e2581ae2a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02d7bcf2860fd48a9c241cace7da057", "thumbnail_srcset": "https://si.imgix.net/635acd72/uploads/origins/b4030436-96f7-49e7-8de0-e2581ae2a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02d7bcf2860fd48a9c241cace7da057, https://si.imgix.net/635acd72/uploads/origins/b4030436-96f7-49e7-8de0-e2581ae2a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56497b684e573afea988c1e8e94f02bf 2x, https://si.imgix.net/635acd72/uploads/origins/b4030436-96f7-49e7-8de0-e2581ae2a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84c80fc7992f9e74fab0a1b3e8fbe88a 3x", "genre": "art", "nsfw": false, "body": "はじめまして！なとぅーさんの絵柄が大好きでリクエストさせていただきます！\n\n描いて頂きたいのは私が以前Vライバーとして活動していた時のキャラクターです。\n\n年齢は17歳ぐらいで、北斗七星がモチーフの、天体観測をしながら旅をしている魔法使いです！属性は決まっていませんが青系\nや白系の魔法を使うと思います。\n\n等身や構図、衣装等はおまかせします！\n(立ち絵以外の服装も○）\n明るいイラストが見たいです！\n\n背景なしのデータもいただけると嬉しいです！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1actXknZwyK8vFzr_NTjxfOmBixHBPnuI", "created_at": "", "completed_at": ""}, {"path": "/@MofuNattou/works/20", "thumbnail_src": "https://si.imgix.net/819373ab/uploads/origins/0f42a22e-a986-4738-b3ad-50a41893bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9fde24857951eb7a0a0e297db6d44f", "thumbnail_srcset": "https://si.imgix.net/819373ab/uploads/origins/0f42a22e-a986-4738-b3ad-50a41893bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9fde24857951eb7a0a0e297db6d44f, https://si.imgix.net/819373ab/uploads/origins/0f42a22e-a986-4738-b3ad-50a41893bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=933759b4c6db7f100764c6cb946ab426 2x, https://si.imgix.net/819373ab/uploads/origins/0f42a22e-a986-4738-b3ad-50a41893bc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b81affa579537df8b4d4d27b5e1918d1 3x", "g