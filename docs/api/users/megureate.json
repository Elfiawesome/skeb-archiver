3590/uploads/origins/ffc7e48b-2b48-4e78-87dd-aa5b4fd7c5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b831a489faaf2be2f8ee231dcfbcfe6", "thumbnail_srcset": "https://si.imgix.net/193f3590/uploads/origins/ffc7e48b-2b48-4e78-87dd-aa5b4fd7c5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b831a489faaf2be2f8ee231dcfbcfe6, https://si.imgix.net/193f3590/uploads/origins/ffc7e48b-2b48-4e78-87dd-aa5b4fd7c5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19c41503cdb70ff874901c56b081f736 2x, https://si.imgix.net/193f3590/uploads/origins/ffc7e48b-2b48-4e78-87dd-aa5b4fd7c5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c48cba81f6f1a64d02f062c623ebd6d1 3x", "genre": "art", "nsfw": true, "body": "触手がでてくるRPGを手掛けている月の水企画さんというサークルをご存じでしょうか？\n同サークルさんのRPGのキャラクターと触手が出てくるイラストをお願いしたいのですが…。（同サークルさん、二次創作はOKだったと思います）\n\n良ければ、次の条件でお願いします。\n・メインの女の子は同サークルさんのRPGから、現代編ではないキャラで\n・触手は肉色の魔触か、触手系女の子モンスターで\n・サークルさんの作風のように、触手がいて普通といった世界観で\n・女の子はいろいろな部分を触手に責められて気持ちいい思いをさせられていて、表情はお任せしますが、少なくとも苦痛の表情ではない感じで\n\n条件合わなければキャンセルしていただいて構いません！", "created_at": "", "completed_at": ""}, {"path": "/@megureate/works/5", "thumbnail_src": "https://si.imgix.net/f5604ea4/uploads/origins/19947f98-f34d-487f-82d0-19f6cce4544b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e5cf76813a85e256e570c64650344c7", "thumbnail_srcset": "https://si.imgix.net/f5604ea4/uploads/origins/19947f98-f34d-487f-82d0-19f6cce4544b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e5cf76813a85e256e570c64650344c7, https://si.imgix.net/f5604ea4/uploads/origins/19947f98-f34d-487f-82d0-19f6cce4544b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=015a858038681b320d2ae5a61f064c75 2x, https://si.imgix.net/f5604ea4/uploads/origins/19947f98-f34d-487f-82d0-19f6cce4544b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a90e907049a52af48a509f1d6528fcaa 3x", "genre": "art", "nsfw": true, "body": "こんにちは。触手が好きな者です。\n最近描かれているスパイ少女の触手絵が好みでしたので、リクエストしてみます。\n\n触手で満ちている架空の世界と、そこで暮らす女の子を自由な発想でお願いします。\n\n女の子は触手に責められていても共存していてもよいです。複数でもよいです。\n空と地平線が見えて、地面は肉色で触手に満ちているイメージでお願いします。\n\nよろしければご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@megureate/works/4", "thumbnail_src": "https://si.imgix.net/71670eab/uploads/origins/8d879a40-3fe2-42c5-8fe8-a756555459c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b1c4e800f41d60fd18ae75f706eec12", "thumbnail_srcset": "https://si.imgix.net/71670eab/uploads/origins/8d879a40-3fe2-42c5-8fe8-a756555459c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b1c4e800f41d60fd18ae75f706eec12, https://si.imgix.net/71670eab/uploads/origins/8d879a40-3fe2-42c5-8fe8-a756555459c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90b379cb860729c6c1fd4ebaad359892 2x, https://si.imgix.net/71670eab/uploads/origins/8d879a40-3fe2-42c5-8fe8-a756555459c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3231a39f07e4bb4dac9f951e81c28abb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@megureate/works/3", "thumbnail_src": "https://si.imgix.net/049b055b/uploads/origins/78c53361-cab2-4ca1-9c6b-741da4a2ba99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89bd437d99cd65112618be2179d78d61", "thumbnail_srcset": "https://si.imgix.net/049b055b/uploads/origins/78c53361-cab2-4ca1-9c6b-741da4a2ba99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c