fa-4bd8-a50d-d508763f1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33c87dc778dabc7f505f0342f7a74e1c 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n\n・資料URL先の作品の色味\n・脚の出ている少年ともうひとり大人びた少年(可能であれば「やさしくおしえて」のさちおくんと聖くんをお願いします)\n・夏 汗をかいている\n・片方は麦わら帽子をかぶっている\n\n上記でお願いいたします。\n\nこうせいさんのファンです。別名義で恐縮ですが、「やさしくおしえて」が大好きで、以降の作品も読ませていただいています。(さちおくんと聖くんのぽわぽわしながら成長していく姿が大好きです。。)\n暑い日が続きますのでお身体に気をつけてお過ごしください。\n\nhttps://twitter.com/idogih/status/725266774371880960?s=46&t=bMvj3-d-XLPNNd6n4m0Ksw", "created_at": "", "completed_at": ""}, {"path": "/@https_w/works/41", "thumbnail_src": "https://si.imgix.net/068ad009/uploads/origins/3190a1e6-cda1-4b47-87eb-be432d03e804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f147bb33c2e5d6b7e78c2854a9948860", "thumbnail_srcset": "https://si.imgix.net/068ad009/uploads/origins/3190a1e6-cda1-4b47-87eb-be432d03e804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f147bb33c2e5d6b7e78c2854a9948860, https://si.imgix.net/068ad009/uploads/origins/3190a1e6-cda1-4b47-87eb-be432d03e804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30b415939631d047d0cb729ee6145c33 2x, https://si.imgix.net/068ad009/uploads/origins/3190a1e6-cda1-4b47-87eb-be432d03e804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2696aeebd6d571a7b2ccbdf121005804 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@https_w/works/40", "thumbnail_src": "https://si.imgix.net/29d22785/uploads/origins/ff44f12e-e458-423a-b4a9-f31d496518ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa3915a551768f754b746dd91fcd9ad", "thumbnail_srcset": "https://si.imgix.net/29d22785/uploads/origins/ff44f12e-e458-423a-b4a9-f31d496518ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa3915a551768f754b746dd91fcd9ad, https://si.imgix.net/29d22785/uploads/origins/ff44f12e-e458-423a-b4a9-f31d496518ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=779298f28b4d0205945f1817a6d74626 2x, https://si.imgix.net/29d22785/uploads/origins/ff44f12e-e458-423a-b4a9-f31d496518ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ab008c9c79f554ac3d0ab891930488a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。公正さんのファンの者です。\n初めてのskeb依頼は公正さんにお願いしたい！と思い、この度勇気を振り絞り依頼させて頂きました。不手際ありましたら申し訳ありません。\n\n描いて頂きたいのは、私と相方がTRPGで作った探索者です。Dropboxに設定やビジュアルを置かせて頂きます。\n恐れ多いのですが、構図や表情等は公正さんにお任せしたいです…！\n\nお忙しいとは思いますが、検討して頂けると幸いです。\n\nhttps://www.dropbox.com/sh/r8n01fmos0jfxzz/AACGN5B3QBah2IHn8db2n_19a?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@https_w/works/39", "thumbnail_src": "https://si.imgix.net/87471e67/uploads/origins/004ec037-3a50-4784-8179-7af1a8b5f2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3dc83248e8d7315d2260d4536c9a55a", "thumbnail_srcset": "https://si.imgix.net/87471e67/uploads/origins/004ec037-3a50-4784-8179-7af1a8b5f2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3dc83248e8d7315d2260d4536c9a55a, https://si.imgix.net/87471e67/uploads/origins/004ec037-3a50-4784-8179-7af1a8b5f2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06b956959b7cb4438e85224c1fc5acd0 2x, https://si.imgix.net/87471e67/uploads/origins/004ec037-3a50-4784-8179-7af1a8b5f2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18113b1ad38754e56b4fcec463a3d3d7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@https_w/works/38", "thumbnail_src": "https://si.imgix.net/c09bc0c2/uploads/origins/f6820ac8-4b2a-4975-bbf0-91de3792144f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e9504edbaca1ce74d05b57f4acaf8c", "thumbnail_srcset": "https://si.imgix.net/c09bc0c2/uploads/origins/f6820ac8-4b2a-4975-bbf0-91de3792144f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e9504edbaca1ce74d05b57f4acaf8c, https://si.imgix.net/c09bc0c2/uploads/origins/f6820ac8-4b2a-4975-bbf0-91de3792144f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b81cbf78932622caded27164296a4a1d 2x, https://si.imgix.net/c09bc0c2/uploads/origins/f6820ac8-4b2a-4975-bbf0-91de3792144f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e243b81f95fdd26cbbd7e3c6095cd5c8 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nもしよろしければ以下の内容でご検討のほどよろしくお願いいたします。\n\n・黒髪の男の子2人(19歳くらい)\n・2人とも猫と人間のハーフで、1人は猫要素強め、もう1人は人間要素強め\n・メイド服orどてらを着ている\n\n正さんのイラスト大好きです！\nぜひよろしくお願いいたします🙇", "created_at": "", "completed_at": ""}, {"path": "/@https_w/works/37", "thumbnail_src": "https://si.imgix.net/0f62bffd/uploads/origins/e3221fee-892d-4fdd-8116-ea1fbcd3ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f14ff91644ed2aa75e38e9f80732853", "thumbnail_srcset": "https://si.imgix.net/0f62bffd/uploads/origins/e3221fee-892d-4fdd-8116-ea1fbcd3ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f14ff91644ed2aa75e38e9f80732853, https://si.imgix.net/0f62bffd/uploads/origins/e3221fee-892d-4fdd-8116-ea1fb