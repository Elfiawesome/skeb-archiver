-a971-5b714d4fa53f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6406e51a9d4fd395e05ff5e81c1d68be, https://si.imgix.net/be7389f9/uploads/origins/b45e7a47-5037-4089-a971-5b714d4fa53f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ebf1fc5f76a3dde9a8ae50904cd8d71 2x, https://si.imgix.net/be7389f9/uploads/origins/b45e7a47-5037-4089-a971-5b714d4fa53f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b46c5cb2a6a029a1be6676e46e6e4c1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/74", "thumbnail_src": "https://si.imgix.net/5bcb9886/uploads/origins/5d5bc379-9fb3-4040-ba75-e5114493bd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73f27605bbca060c33fe2db908bb476", "thumbnail_srcset": "https://si.imgix.net/5bcb9886/uploads/origins/5d5bc379-9fb3-4040-ba75-e5114493bd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73f27605bbca060c33fe2db908bb476, https://si.imgix.net/5bcb9886/uploads/origins/5d5bc379-9fb3-4040-ba75-e5114493bd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=999e1f06ed2a0938fdc4888701773ccb 2x, https://si.imgix.net/5bcb9886/uploads/origins/5d5bc379-9fb3-4040-ba75-e5114493bd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=318ff648133a7812f70573403233b0b6 3x", "genre": "art", "nsfw": false, "body": "初めまして、素敵なイラストを拝見したので、下記ご依頼をさせていただきます。\n\n〇キャラクター\n・桜坂しずく、優木せつ菜(ラブライブ！虹ヶ咲学園スクールアイドル同好会)\n\n〇服装\n・黒セーラー服\n\n〇シチュエーション\n①：苦しそうな表情で服をたくしあげて、水を飲んでパンパンに膨れたお腹を見せる(スカートのたくし上げは無しでお願いします)\n\n②：お腹が鳴って顔を赤くしている差分をお願いします。\n\nセーラー服の上をあげる時、ブラジャーが見えないようにお願いします。\n\nお忙しいところ、御手数ですが、ご検討いただけますと幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/73", "thumbnail_src": "https://si.imgix.net/1f366d89/uploads/origins/cda49eb3-84a7-4334-8818-2ad476bfc19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85852c1b8425deec3752f02fb0194bd3", "thumbnail_srcset": "https://si.imgix.net/1f366d89/uploads/origins/cda49eb3-84a7-4334-8818-2ad476bfc19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85852c1b8425deec3752f02fb0194bd3, https://si.imgix.net/1f366d89/uploads/origins/cda49eb3-84a7-4334-8818-2ad476bfc19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b39a9163cda7a10acbf8ed4226d151b 2x, https://si.imgix.net/1f366d89/uploads/origins/cda49eb3-84a7-4334-8818-2ad476bfc19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db59f1439e7ec16222fb00e7c79d7d61 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。前回のりんまる（https://skeb.jp/@suouLLaka/works/65）が素晴らしかったので、続けて投下したいと思います。\n\n今度はかのんとエマで、同様なキスシーンをお願いしたいのです。\n\n前回同様、お互いに抱き寄せあい、おっぱいも押し当て合いながらキスしてる様子で。構図は全身に近いところまで同じでお願いしたいです。\nエマは幸せそうに目を閉じて、顔を赤らめて、かのんは困り眉で目を閉じて、エマよりさらに顔が赤くなって、身体も所々震えてる感じで。\nまた、エマの方がよりかのんを深く抱き寄せてる感じでお願いします。\n衣装は、キュアメイドカフェのもの、といいますか、「Wonder zone」をはじめとした、スクスタでもエマが着ていたあの半袖ロングメイド服で。カチューシャも忘れずお願いします。\n背景も、場所ではなく、ラブラブなエフェクトというか雰囲気が見える感じのもので。想像つかなかろうが、構わずお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/72", "thumbnail_src": "https://si.imgix.net/d0418f24/uploads/origins/1a960811-8d56-49e6-8ed0-84b51a7f5776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a3a424ad41c7076647bb1349881492", "thumbnail_srcset": "https://si.imgix.net/d0418f24/uploads/origins/1a960811-8d56-49e6-8ed0-84b51a7f5776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a3a424ad41c7076647bb1349881492, https://si.imgix.net/d0418f24/uploads/origins/1a960811-8d56-49e6-8ed0-84b51a7f5776?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c897ec4557c5c19acb407c1862c17b53 2x, https://si.imgix.net/d0418f24/uploads/origins/1a960811-8d56-49e6-8ed0-84b51a7f5776?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83f22bf63b66066a797691fc7700cedd 3x", "genre": "art", "nsfw": false, "body": "リクエストですが、もし可能であればちょっと嫉妬深めな天王寺璃奈ちゃんが見たいです！\n\n・シチュ\n制服姿でソファーにうつ伏せで寝転がり、ゲームをしているりなりー。その後ろで宮下愛ちゃんが他の女の子と楽しそうに喋っており、りなりーは愛ちゃんのお尻を踵で蹴り上げる。\n\nご検討の程、何卒よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/71", "thumbnail_src": "https://si.imgix.net/6c50afd9/uploads/origins/9a40ab72-f017-4c90-af56-ef184b783032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a53cd544d714490d5e5c77b0e3543888", "thumbnail_srcset": "https://si.imgix.net/6c50afd9/uploads/origins/9a40ab72-f017-4c90-af56-ef184b783032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a53cd544d714490d5e5c77b0e3543888, https://si.imgix.net/6c50afd9/uploads/origins/9a40ab72-f017-4c90-af56-ef184b783032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99c0225472cf79f20276ebd3489776f2 2x, https://si.imgix.net/6c50afd9/uploads/origins/9a40ab72-f017-4c90-af56-ef184b783032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=549d0d246eeed64eca5e176f797f98c8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/70", "thumbnail_src": "https://si.imgix.net/ebe523eb/uploads/origins/b5c28aaa-93bb-4289-b8db-65abe3a9a