TE&s=acb69dfbb7e503d01ba3af891668ed48", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/82", "thumbnail_src": "https://si.imgix.net/3cc02eaa/uploads/origins/fc9cc918-2a26-4aef-896a-f5e24892e18f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49d9cd7c0ae47199bc58d22f5838a9ba", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/81", "thumbnail_src": "https://si.imgix.net/150bf14b/uploads/origins/65ae36cc-428e-43a6-a5f3-279ff41c53e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cffc858726a9885e1efb39c864b8e540", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/80", "thumbnail_src": "https://si.imgix.net/217455f0/uploads/origins/76f10fc6-aecb-4014-8b14-f4d82b43430a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af1fc73b5ff20bed083a6d6949e4b135", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/79", "thumbnail_src": "https://si.imgix.net/473a5229/uploads/origins/6831eb74-fdc4-426f-b40f-1e19df13c7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf2cd0a0f50fa0664d388b145d4d8e63", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/78", "thumbnail_src": "https://si.imgix.net/502c5101/uploads/origins/4b21c54f-8e77-45bf-b10a-566e824ffb98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03b95cb224a91f141f673e5bab4045ae", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/77", "thumbnail_src": "https://si.imgix.net/1e13cdf8/uploads/origins/8796969e-1f23-427d-98ef-16af6b55c0d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6b587799e9370c3d892510d9dba4599", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/76", "thumbnail_src": "https://si.imgix.net/a2a62981/uploads/origins/98c8428b-4275-4380-97da-9a82848b1a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8ad709581a2dc123f06581acd012cb4", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/75", "thumbnail_src": "https://si.imgix.net/be7389f9/uploads/origins/b45e7a47-5037-4089-a971-5b714d4fa53f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6406e51a9d4fd395e05ff5e81c1d68be", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/74", "thumbnail_src": "https://si.imgix.net/5bcb9886/uploads/origins/5d5bc379-9fb3-4040-ba75-e5114493bd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73f27605bbca060c33fe2db908bb476", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "初めまして、素敵なイラストを拝見したので、下記ご依頼をさせていただきます。\n\n〇キャラクター\n・桜坂しずく、優木せつ菜(ラブライブ！虹ヶ咲学園スクールアイドル同好会)\n\n〇服装\n・黒セーラー服\n\n〇シチュエーション\n①：苦しそうな表情で服をたくしあげて、水を飲んでパンパンに膨れたお腹を見せる(スカートのたくし上げは無しでお願いします)\n\n②：お腹が鳴って顔を赤くしている差分をお願いします。\n\nセーラー服の上をあげる時、ブラジャーが見えないようにお願いします。\n\nお忙しいところ、御手数ですが、ご検討いただけますと幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/73", "thumbnail_src": "https://si.imgix.net/1f366d89/uploads/origins/cda49eb3-84a7-4334-8818-2ad476bfc19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85852c1b8425deec3752f02fb0194bd3", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "お久しぶりです。前回のりんまる（https://skeb.jp/@suouLLaka/works/65）が素晴らしかったので、続けて投下したいと思います。\n\n今度はかのんとエマで、同様なキスシーンをお願いしたいのです。\n\n前回同様、お互いに抱き寄せあい、おっぱいも押し当て合いながらキスしてる様子で。構図は全身に近いところまで同じでお願いしたいです。\nエマは幸せそうに目を閉じて、顔を赤らめて、かのんは困り眉で目を閉じて、エマよりさらに顔が赤くなって、身体も所々震えてる感じで。\nまた、エマの方がよりかのんを深く抱き寄せてる感じでお願いします。\n衣装は、キュアメイドカフェのもの、といいますか、「Wonder zone」をはじめとした、スクスタでもエマが着ていたあの半袖ロングメイド服で。カチューシャも忘れずお願いします。\n背景も、場所ではなく、ラブラブなエフェクトというか雰囲気が見える感じのもので。想像つかなかろうが、構わずお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/72", "thumbnail_src": "https://si.imgix.net/d0418f24/uploads/origins/1a960811-8d56-49e6-8ed0-84b51a7f5776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71a3a424ad41c7076647bb1349881492", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "リクエストですが、もし可能であればちょっと嫉妬深めな天王寺璃奈ちゃんが見たいです！\n\n・シチュ\n制服姿でソファーにうつ伏せで寝転がり、ゲームをしているりなりー。その後ろで宮下愛ちゃんが他の女の子と楽しそうに喋っており、りなりーは愛ちゃんのお尻を踵で蹴り上げる。\n\nご検討の程、何卒よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/71", "thumbnail_src": "https://si.imgix.net/6c50afd9/uploads/origins/9a40ab72-f017-4c90-af56-ef184b783032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a53cd544d714490d5e5c77b0e3543888", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/70", "thumbnail_src": "https://si.imgix.net/ebe523eb/uploads/origins/b5c28aaa-93bb-4289-b8db-65abe3a9a171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fab38ea7d8a667b8e9ed1383e673dcc", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/69", "thumbnail_src": "https://si.imgix.net/1b34357b/uploads/origins/8d59ddad-91ad-40bf-857f-ba69c0bac488?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ae25439d81c480f2e5da762adc94691", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/68", "thumbnail_src": "https://si.imgix.net/ef13cced/uploads/origins/5c8005fb-f51b-473f-b9e4-3ddbb53a963c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b81572fb71423a0e8fb4ce9886f778ad", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/67", "thumbnail_src": "https://si.imgix.net/7b3bd9b3/uploads/origins/716516e8-2083-4d55-ae86-f1d3ee471119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98620f866b11990aa536bbc17cddbc66", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは。先生の絵が気に入ってリクエストしようと思います。 夏祭りという感じで、三船栞子が上着は制服、下衣はふんどしで視察している様子をお願いします。 栞子のぷりぷりしたお尻がよく見える構図だといいですね。", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/66", "thumbnail_src": "https://si.imgix.net/e30f82d7/uploads/origins/e694d4f1-1f51-4543-9139-61a4b45204bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a3349c4ff5c5397ce74459a385ea98", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "はじめまして。\n園田海未が、夏色えがおで1,2,Jump!の2番のサビで跳んでいる姿（下記の資料URLの動画の3:03を参照）をイラストに描いて欲しいです。\nアングルは正面、描写範囲は右足から上をお願いいたします。\n\nhttps://youtu.be/1j-u11dHWnI?si=dTNWTe7UFi7Y9Vll", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/65", "thumbnail_src": "https://si.imgix.net/f435f89f/uploads/origins/6e93a334-8e83-4791-a739-a7cbcad52a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1300d7eab1ab2ce7497fa412b7f1b75d", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "はじめまして。ＣＰは雑食との事ですが、越境ＣＰもなんでもいけるクチでしたら・・・\n\n「お姫様ドレスを着た凛と花丸の百合キス」をお願いしたいです！\n\n文字通り、凛と花丸の、抱き合ってキスをしている様子になります。二人共困り眉で顔を赤らめ、キスで感じちゃってる様子で。\nドレスのデザインは、二人共黄色のロングドレスを着ています。お揃いでお願いします！ デザインに困った時にといいますか、一例を添えておきます（https://dress.weddingpark.net/articles/22603）\n\n背景は・・場所というよりエフェクトで。もう、ラブラブな感じを表現してもらえたらと思います！", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/64", "thumbnail_src": "https://si.imgix.net/bfbb7925/uploads/origins/0ecf0a48-14a4-4ad8-84a8-05a8363e03b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3b3c956069688e6aa5f2142600a16fe", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/63", "thumbnail_src": "https://si.imgix.net/747ef57d/uploads/origins/e914bf25-6510-470e-90c1-3091e2d160dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0952ac06d87c4b3d802392c79bb3812", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "いつもありがとうございます、今度も栞子ちゃんにコスプレします。\n\n栞子ちゃんに各務チヒロ(ブルアカ、かがみちひろ)のコスプレをお願いします！\n>>キャラクターは公式イラスト基準で緑色のメガネとヘアピンがあります。 設定のままでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/62", "thumbnail_src": "https://si.imgix.net/3e0495e5/uploads/origins/fb3410aa-e084-49ec-b4f9-4dd65f575cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f0710219fb9a27ae433c9c1fb660a0", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "いつもお世話になっております、百合リクエストを申請します、キャラは栞子、リオです。\n\n栞子ちゃんと調月リオちゃん(ブルアカ)かキスしあう。「栞子はリオの胸の左手にあげる」\n\nスタンディングはこういう(https://skeb.jp/@suouLLaka/works/39)構図でお願いします、 衣装はリオと同じ服にします。\n\nよろしくお願いします🙇", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/61", "thumbnail_src": "https://si.imgix.net/d71f5108/uploads/origins/5a078870-cbdc-4d25-ad72-cf4a7c01ad6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45884f752a1597b455282426109a05ca", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/60", "thumbnail_src": "https://si.imgix.net/67debec0/uploads/origins/0656f5f6-fb97-49a5-95d2-6348c6fc5afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27c855fd77af81a1e4fdba216588c36e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suouLLaka/works/59", "thumbnail_src": "https://si.imgix.net/1d648cd1/uploads/origins/758e9c45-a604-407c-b99e-75e5af3ac7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=272076ec3e0a7263e050e47a6dbb94eb", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}