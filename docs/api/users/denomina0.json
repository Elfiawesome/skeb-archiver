.imgix.net/706a6151/uploads/origins/3feb629b-416c-481f-b9e1-cef4b205c485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67dcc10234c8969472bf97419d29cf84, https://si.imgix.net/706a6151/uploads/origins/3feb629b-416c-481f-b9e1-cef4b205c485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ae3ca6b7c7dd551dbf6f0089e4a08ac 2x, https://si.imgix.net/706a6151/uploads/origins/3feb629b-416c-481f-b9e1-cef4b205c485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e160dbd38522b82b0ee8e9509e41b81a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/37", "thumbnail_src": "https://si.imgix.net/10e29510/uploads/origins/582e5bb3-c7c2-4668-85e3-49f459e2b9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193747c51a6546192a89fb381a647611", "thumbnail_srcset": "https://si.imgix.net/10e29510/uploads/origins/582e5bb3-c7c2-4668-85e3-49f459e2b9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193747c51a6546192a89fb381a647611, https://si.imgix.net/10e29510/uploads/origins/582e5bb3-c7c2-4668-85e3-49f459e2b9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b76acb805a7dd3bc5a1769a33de65baa 2x, https://si.imgix.net/10e29510/uploads/origins/582e5bb3-c7c2-4668-85e3-49f459e2b9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7edb8529f4ce42e253e69f5211d2a36 3x", "genre": "art", "nsfw": false, "body": "DENOさん初めまして。\n予てよりアルダンさん描きの方と認知して、Xに流れてくる作品を楽しませて頂いてました。\nその中にクシャトリヤやアーダンや騎士な格好のアルダンさんもあったことから、「もしやアルダンさんに武装させてもOKな方では？」と見受けましたため、私の願望する武装アルダンさんも叶えて頂ければとご依頼させて頂きます。\n\nよろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか。\n\n・衣装参考：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯として、ゲーム内のイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングだったり、身を削る固有スキルと宝具同士……などなど、こじつけるに足る理由に個人的に盛り上がって、そしてハマってしまったためです……。\nFGOはご存じないとは存じますが、綺麗なだけじゃない、戦う乙女なアルダンさんも許容されるDENOさんならばと期待を抱き、この無茶をご依頼させて頂ければと思います。\n\n表情や構図・ポーズついては、DENOさんが思うアルダンさんのイメージのまま描いて頂けましたらOKです。あくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（……というか衣装元ネタ寄せられると、アルダンさんが暗く病んじゃう感じになり、それは本意ではないです……ｗ）\nお茶目だったりお淑やかだったり、時々カッコつけたがったり等、DENOさんの解釈するアルダンさんの「らしい」振る舞いとリアクション描いて頂ければと思います！　一応、コスプレ（衣装）がメインなので、なるべくなら全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います……！\n\nジャンル違いは承知の上ですが、それでもよろしければ、何卒お願いいたします！\n\nhttps://www.pixiv.net/artworks/115999216", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/36", "thumbnail_src": "https://si.imgix.net/592a08c4/uploads/origins/0ed8df81-aa12-4c70-bedc-32a3be4d982d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27c61d7eb264391713a466eaf0242c9a", "thumbnail_srcset": "https://si.imgix.net/592a08c4/uploads/origins/0ed8df81-aa12-4c70-bedc-32a3be4d982d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27c61d7eb264391713a466eaf0242c9a, https://si.imgix.net/592a08c4/uploads/origins/0ed8df81-aa12-4c70-bedc-32a3be4d982d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d828d0e7d998077a2b3ee840266e6f7f 2x, https://si.imgix.net/592a08c4/uploads/origins/0ed8df81-aa12-4c70-bedc-32a3be4d982d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5aac34144413be1fea951aa4bcc068e 3x", "genre": "art", "nsfw": false, "body": "初めまして、モントブレチアと申します\n今回ご依頼したいのはオリジナルウマ娘を描いて頂きたいです\n名前は「アスターヴァイス」と言います\nウマ娘の「メジロアルダン」を元に創作したオリウマ娘になります\n以前からDENOさんの絵柄で見てみたい思っていました\n構図などはお任せします\n細かな設定や外見はお手数ですが下のURLからご確認をお願い致します\n姉の「アスターグリュー」と同じページになりますので紛らわしいと思いますがしっかりとご確認をお願い致します(アスターヴァイスは下の方になります)\nご都合が悪ければご辞退なさっても構いません\nどうぞご検討をよろしくお願いします\n\nhttps://www.pixiv.net/novel/show.php?id=19434392#44", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/35", "thumbnail_src": "https://si.imgix.net/08d602ac/uploads/origins/7505f1d3-0f72-4bc0-8cd5-3590b4dae940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64bb67e6d73769c4005b4800502b06e1", "thumbnail_srcset": "https://si.imgix.net/08d602ac/uploads/origins/7505f1d3-0f72-4bc0-8cd5-3590b4dae940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64bb67e6d73769c4005b4800502b06e1, https://si.imgix.net/08d602ac/uploads/origins/7505f1d3-0f72-4bc0-8cd5-3590b4dae940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b159ee6c857193be41e5514b3482dbe 2x, https://si.imgix.net/08d602ac/uploads/origins/7505f1d3-0f72-4bc0-8cd5-3590b4dae940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f87f723429eaf4636eea3e2a371a5fc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/34", "thumbnail_src": "https://si.imgix.net/69e33e51/uploads/origins/6f38058e-b8b0-4e63-80ba-7dc75c7657a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eda116d0f0095a26b8d582edb77329f6", "thumbnail_srcset": "https://si.imgix.net/69e33e51/uploads/origins/6f38058e-b8b0-4e63-80ba-7dc75c7657a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc