766868）\n・配色はサトノクラウン×シナモロールの時のようなパステルカラー\n・髪もリボンやイチゴ、ハートといった女児趣味の髪飾りを盛ってほしいです\nサトノクラウンは中等部であることやサンリオコラボの時の衣装での表情から、普段が女児趣味だったらという想像でお願いします。\n作中の大人びているサトノクラウンとDENOさんの女児水着のイラストのギャップをぜひ拝見したいので、ご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/42", "thumbnail_src": "https://si.imgix.net/2b2c6975/uploads/origins/8eebd1cd-9e25-473b-b7b7-fed5f0f82157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f212982dcf50dfcfd781cde91301bccf", "thumbnail_srcset": "https://si.imgix.net/2b2c6975/uploads/origins/8eebd1cd-9e25-473b-b7b7-fed5f0f82157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f212982dcf50dfcfd781cde91301bccf, https://si.imgix.net/2b2c6975/uploads/origins/8eebd1cd-9e25-473b-b7b7-fed5f0f82157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d2b75088dd77c7cdca42e4e28fbedab 2x, https://si.imgix.net/2b2c6975/uploads/origins/8eebd1cd-9e25-473b-b7b7-fed5f0f82157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aca16321bc324494eb2a859f8509311a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/41", "thumbnail_src": "https://si.imgix.net/87603322/uploads/origins/5f8e477e-b1f1-4f35-bb28-f07a921208c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9bfcffb3ac357969de88d21beae6814", "thumbnail_srcset": "https://si.imgix.net/87603322/uploads/origins/5f8e477e-b1f1-4f35-bb28-f07a921208c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9bfcffb3ac357969de88d21beae6814,