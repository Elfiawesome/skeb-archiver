ea5cf03142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460a4e870e7bfdc0070a4f27018b07d8", "thumbnail_srcset": "https://si.imgix.net/ab5ed56a/uploads/origins/7b97806e-bed8-4742-b3f3-bfea5cf03142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460a4e870e7bfdc0070a4f27018b07d8, https://si.imgix.net/ab5ed56a/uploads/origins/7b97806e-bed8-4742-b3f3-bfea5cf03142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56ef6008ae2b245a5b936b2d1b852b08 2x, https://si.imgix.net/ab5ed56a/uploads/origins/7b97806e-bed8-4742-b3f3-bfea5cf03142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f125e9e31df180af549238df001f6983 3x", "genre": "art", "nsfw": false, "body": "突然の依頼失礼します。\nDENO様の絵を拝見して依頼したいと考えリクエストを送らせて頂きました。\n確認お願い致します。\n\n・キャラクター\nウマ娘プリティダービー登場人物メジロアルダン\n衣装は同アプリ登場人物ジェンティルドンナの勝負服Regina dei fioriをメジロカラーで。\nバスト大盛でお願いします。\n\n\n・ポーズ、表情\nジェンティルの勝負服を着ての全身立ち絵風をお願いします。\n\n\nお忙しい中恐れ入りますが検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/31", "thumbnail_src": "https://si.imgix.net/0c8b8b65/uploads/origins/1c9e11de-1abf-4473-a388-8a91b7ff8e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e29368c548c07ebc7e27651879dfb562", "thumbnail_srcset": "https://si.imgix.net/0c8b8b65/uploads/origins/1c9e11de-1abf-4473-a388-8a91b7ff8e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e29368c548c07ebc7e27651879dfb562, https://si.imgix.net/0c8b8b65/uploads/origins/1c9e11de-1abf-4473-a388-8a91b7ff8e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5f066eeb79033ebc1e1ceae05aa55aa 2x, https://si.imgix.net/0c8b8b65/uploads/origins/1c9e11de-1abf-4473-a388-8a91b7ff8e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=517e9d759ce0fb8b06cf1d268258cfcc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/30", "thumbnail_src": "https://si.imgix.net/8a44d789/uploads/origins/d3ff09f7-6e08-4bff-896c-049bfe20a9fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f01a57ededb4b40b51dff6d05aadfd9", "thumbnail_srcset": "https://si.imgix.net/8a44d789/uploads/origins/d3ff09f7-6e08-4bff-896c-049bfe20a9fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f01a57ededb4b40b51dff6d05aadfd9, https://si.imgix.net/8a44d789/uploads/origins/d3ff09f7-6e08-4bff-896c-049bfe20a9fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73a94f1cd1182a0535f50abd75bcbf85 2x, https://si.imgix.net/8a44d789/uploads/origins/d3ff09f7-6e08-4bff-896c-049bfe20a9fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055da1241c37f312370295cb75b63d17 3x", "genre": "art", "nsfw": false, "body": "こんばんは、DENO様のむちむちっとしたイラストが大変大好きです！\n\n少し変わったシチュエーションの依頼になりますが、極寒の南極で“人間の観測した世界で一番寒い気温”にチャレンジする、毛皮の防寒着でモッフモフに着膨れしたダイワスカーレットちゃんをお願いします\n指定や情報量等、難しい場合は遠慮なくキャンセルして頂いて大丈夫です。\n\n世界一寒い気温を計測しようと猛吹雪の中、ひたすらに分厚い防寒着を何枚も着込みながら、吹雪の中で寒さに耐え続けている。\nと言うシチュエーションをお願いしたいです\n\n服装はモフモフした毛皮の防寒着、毛皮のケープやモフモフの大きなファーマフラー等を着込み、分厚いミトンの手袋やブーツなど、北国風の防寒着を頭から足まで露出無く着込んでいるイメージです\n\nとにかく寒さから身を守るためにモフモフに着込みまくったような、着込ませ過ぎだと思うその8割増しくらいのモフモフ着膨れ加減でお願いしたいです\n\n呼気は凍って顔周りはガチガチに凍り、髪の毛やマフラー、まつ毛等にも霜やつららが出来、防寒着も霜とつららでガチガチになっています\n想像以上の寒さにガタガタと震えるも、防寒着を抱き締めて耐え、リアイアを促されるも、口からマフラーに染み込む程につららを垂らしながら、雪だるまのようになりながらガチガチに凍える様子をお願いしたいです\n\n最終的に足元の気温計は−89.4°Cを示し、防寒着はガチガチに凍って震え、見るからに限界なほど寒そうな様子をお願いします。\n\nまた、“地球で一番低い気温”を狙ってさらに延長し、さらに気温が下がり、防寒着は完全に真っ白な霜やつららに包まれ、マフラーを鼻まで覆い、目以外の露出無しでつららや霜でガチガチになっている姿もお願いできると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/29", "thumbnail_src": "https://si.imgix.net/5688ef8e/uploads/origins/9cf8e646-5625-47d2-9779-2cc713ca77f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d165b0bde3146cebde73e35b8f0a97", "thumbnail_srcset": "https://si.imgix.net/5688ef8e/uploads/origins/9cf8e646-5625-47d2-9779-2cc713ca77f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d165b0bde3146cebde73e35b8f0a97, https://si.imgix.net/5688ef8e/uploads/origins/9cf8e646-5625-47d2-9779-2cc713ca77f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afa8a814964540b9274f7fa7f210d0d1 2x, https://si.imgix.net/5688ef8e/uploads/origins/9cf8e646-5625-47d2-9779-2cc713ca77f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5155c22dd76eefa7759c21e23d89ce52 3x", "genre": "art", "nsfw": false, "body": "DENOさん\n\nライスシャワーとカレンチャンの大食いイラストでお世話になった者です。\n\n今回はハチャウマの大食いで、イーターとして1位を取ったセイウンスカイのイラストを2枚ほどお願いしたいです。\n\n①模擬戦で1位になるも、まだまだ余裕があり、これなら本戦も大丈夫だと思っている様子\n②本線はレベルが上がったため、死闘の末1位になり、かなり無理をしている様子\n\n①はハチャウマの勝利画面に近い感じで、お腹は膨れているものの笑顔で余裕そうな感じでお願いします。また、構図も勝利画面に近い感じでお願いします。\n②は背景や構図は①のものと同じで構いません(ただ設定上、手の位置とかは変えていただきたいです)。しかし、①よりパンパンなお腹と限界まで食べて満身創痍な様子を描いていただきたいです。\n\nセリフや心の声などはおまかせします。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/28", "thumbnail_src": "https://si.imgix.net/9ad63c6a/uploads/origins/dfe1d140-2bb6-47ce-94bf-40cf740a48a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2e4cae9b9076045e5d3aed883640e3d", "thumbnail_srcset": "https://si.imgix.net/9ad63c6a/uploads/origins/dfe1d140-2bb6-47ce-94bf-40cf740a48a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2e4cae9b9076045e5d3aed883640e3d, https://si.imgix.net/9ad63c6a/uploads/origins/dfe1d140-2bb6-47ce-94bf-40cf740a48a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b3de04d71290dc76c336d3c27d7a4f1 2x, https://si.imgix.net/9ad63c6a/uploads/origins/dfe1d140-2bb6-47ce-94bf-40cf740a48a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e107058a8f77891dec4fa8ff8ae4ec1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/27", "thumbnail_src": "https://si.imgix.net/3102eba5/uploads/origins/98a70d8f-47f6-4d61-b856-797ba647d670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82d42975363becf31d3a396364a28fed", "thumbnail_srcset": "https://si.imgix.net/3102eba5/uploads/origins/98a70d8f-47f6-4d61-b856-797ba647d670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82d42975363becf31d3a396364a28fed, https://si.imgix.net/3102eba5/uploads/origins/98a70d8f-47f6-4d61-b856-797ba647d670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62d9ff9577e7dfa1d9929d6d207baf83 2x, https://si.imgix.net/3102eba5/uploads/origins/98a70d8f-47f6-4d61-b856-797ba647d670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26a00a818bb746acb8a2d4ceef1ef24e 3x", "genre": "art", "nsfw": false, "body": "はじめましてDENOさん。リクエストです。\n牛柄の眼帯ビキニとニーソ、長手袋のビワハヤヒデをお願いします。\nニーソと長手袋、下(ボトム)は眼帯ビキニと同じ牛柄で、構図はhttps://skeb.jp/@denomina0/works/22のような感じですが、胸は横からも下からもはみ出ているサイズにして下さい。背景の指定はなし。\n胸を盛ってくれると嬉しいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/26", "thumbnail_src": "https://si.imgix.net/a6ab2379/uploads/origins/43e71d2d-c80b-4fdb-ab13-d563337a6ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9d6b733c83ef9e948da38c47cf1a538", "thumbnail_srcset": "https://si.imgix.net/a6ab2379/uploads/origins/43e71d2d-c80b-4fdb-ab13-d563337a6ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9d6b733c83ef9e948da38c47cf1a538, https://si.imgix.net/a6ab2379/uploads/origins/43e71d2d-c80b-4fdb-ab13-d563337a6ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b659445682adb90f184cec8a0d102b87 2x, https://si.imgix.net/a6ab2379/uploads/origins/43e71d2d-c80b-4fdb-ab13-d563337a6ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82184fb332c86a759fed4bb94fe56b37 3x", "genre": "art", "nsfw": false, "body": "リクエストお願いします。\n爆乳メジロアルダンがサイズの合ってないパツパツのチャイルドスモックのコスプレをする絵をお願いします。\nお時間ありましたらお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/25", "thumbnail_src": "https://si.imgix.net/0deb3bf6/uploads/origins/17aba0b8-c24a-471f-b482-12a7e81ef469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b6660383d5e58bedd55f77f7468ac9", "thumbnail_srcset": "https://si.imgix.net/0deb3bf6/uploads/origins/17aba0b8-c24a-471f-b482-12a7e81ef469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b6660383d5e58bedd55f77f7468ac9, https://si.imgix.net/0deb3bf6/uploads/origins/17aba0b8-c24a-471f-b482-12a7e81ef469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=958e19472953eba8ff8613788a5f6fd9 2x, https://si.imgix.net/0deb3bf6/uploads/origins/17aba0b8-c24a-471f-b482-12a7e81ef469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13428a3c9aff82eee60c2e3f80f687e0 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます。よろしくお願いします。\n\nキャラクター：メジロアルダン\n\nシチュエーション：場所はトレーナーの家の玄関。帰宅したトレーナーをメイド服？姿で出迎えるメジロアルダン。「お帰りなさいませ、トレーナーさん──いえ、ご主人様♪」というセリフも入れていただきたいです。\n\nメイド服：某美少女ゲームのファンデミナージュ・メイド学園の制服。資料（https://x.com/Type896/status/1804454243673456734）。\n\nその他：前回のリクエストと同様におっぱいは大きくお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/24", "thumbnail_src": "https://si.imgix.net/3761d34b/uploads/origins/b3bd4cad-3ab5-47be-87b6-b4d75d7553d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75c2ddc3a577bde03a93fc0b064c10c", "thumbnail_srcset": "https://si.imgix.net/3761d34b/uploads/origins/b3bd4cad-3ab5-47be-87b6-b4d75d7553d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75c2ddc3a577bde03a93fc0b064c10c, https://si.imgix.net/3761d34b/uploads/origins/b3bd4cad-3ab5-47be-87b6-b4d75d7553d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ced4918bfa3d1dc7d459b525f07725f 2x, https://si.imgix.net/3761d34b/uploads/origins/b3bd4cad-3ab5-47be-87b6-b4d75d7553d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ed76871b26f2ead9e411e70be6c029f 3x", "genre": "art", "nsfw": false, "body": "初めまして！下記の内容でイラストのご検討お願い致します！\n登場キャラ:キタサンブラック(ウマ娘)\n                        サトノダイヤモンド(ウマ娘)\n内容:太り気味なったキタちゃんのお腹をダイヤちゃんがメジャーで測ってるイラスト。\n服装:二人ともトレセン学園のジャージ長袖長ズボン\nキタちゃんの太り気味のお腹は、DENOさんが描いていた、スク水アヤベさんくらいのお腹で！(程よい感じのポヨン腹)キタちゃんが自分ジャージの袖をまくって測られている。ジャーすそは胸の下くらいお腹にきもちメジャーが食い込む感じで！\nキタちゃんの表情は、嫌な予感しそうな顔で\n吹き出しは、ダイヤちゃん何かやばいこと絶対考えてる的な\nダイヤちゃんの目線はキタちゃんのおへそくらいで、表情は、少しかかり気味。吹き出しは、かわいいキタちゃんのお腹的な。\nダイヤちゃんは、しゃがんでいる感じで！\n太り気味とかから気味の吹き出しもお願いします。\n\n以上になります。\nいろいろとお伝えしてしまいましたがご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/23", "thumbnail_src": "https://si.imgix.net/823bdabd/uploads/origins/797545f1-db01-490b-b2f7-ebbe9b1d8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f30e59a016f415d0cfc46296fa35576", "thumbnail_srcset": "https://si.imgix.net/823bdabd/uploads/origins/797545f1-db01-490b-b2f7-ebbe9b1d8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f30e59a016f415d0cfc46296fa35576, https://si.imgix.net/823bdabd/uploads/origins/797545f1-db01-490b-b2f7-ebbe9b1d8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f0c6aaf9a9fa0620dbe8307da933a6c 2x, https://si.imgix.net/823bdabd/uploads/origins/797545f1-db01-490b-b2f7-ebbe9b1d8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fae356c32fa9403d95c7659123d714f6 3x", "genre": "art", "nsfw": false, "body": "連続でのリクエスト申し訳ありません。どうしても願望を抑えきれず、リクエストをさせていただきます。\n\nキャラクター：メジロアルダン\n\nシチュエーション：ビキニアーマー姿のメジロアルダンが、ちょっと恥ずかしそうな表情で頬を赤らめながらファンタジー系の街中を歩いている。\n\n衣装：銀色のビキニアーマー（以前に描かれたビキニアーマーマチタンhttps://www.pixiv.net/artworks/100410646の色違い。ブーツは色・デザイン共に変更なし）。ブラ部分のサイズは出来るだけ小さめで、横や下からはみ出ているおっぱいの面積が広いと最高です。上半身にはビキニアーマー以外の装備は無し。腰のベルトに付けられた鞘には騎士風衣装アルダン（https://www.pixiv.net/artworks/116566266）が持っているような長剣が収められている。\n\n体つき：むっちむちで特におっぱいは大きくお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/22", "thumbnail_src": "https://si.imgix.net/0aa42004/uploads/origins/e0ec8539-8e6c-499d-982b-17fcfc7cd808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a42a062c43c7d91f974d5b3e3664256", "thumbnail_srcset": "https://si.imgix.net/0aa42004/uploads/origins/e0ec8539-8e6c-499d-982b-17fcfc7cd808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a42a062c43c7d91f974d5b3e3664256, https://si.imgix.net/0aa42004/uploads/origins/e0ec8539-8e6c-499d-982b-17fcfc7cd808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f267cf566b7614f76c95247757c9b1cf 2x, https://si.imgix.net/0aa42004/uploads/origins/e0ec8539-8e6c-499d-982b-17fcfc7cd808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9397362ef137b05812a000c6cfa929c 3x", "genre": "art", "nsfw": false, "body": "初めてご依頼させていただきます。よろしくお願いします。\n\n黒いビキニ姿で砂浜に立っているメジロアルダンをリクエストします。\nビキニの色や形は先生が描かれたこちらの作品（https://www.pixiv.net/artworks/111390490）をベースに、上（トップ）は肩紐の緑色のフリルと真ん中の赤いリボンは無くして、こちらの方の作品（https://www.pixiv.net/artworks/113843992）のようにおっぱいが横からも下からもはみ出ているサイズにしてください。下（ボトム）は横の紐を１本にしてハイレグな感じでお願いします。\n顔はベールなどで隠さず、帽子や手袋は無し。表情はスク水ニーソ長手袋アルダン（https://www.pixiv.net/artworks/115348904）のような感じで、ポーズはおまかせします。おっぱいも盛ってくれると嬉しいです。\n\n\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/21", "thumbnail_src": "https://si.imgix.net/f490e41d/uploads/origins/e2f78aa4-c0b6-4019-b69d-846e75f4f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62ef4fd8bc811f9bc7771875d32e7b01", "thumbnail_srcset": "https://si.imgix.net/f490e41d/uploads/origins/e2f78aa4-c0b6-4019-b69d-846e75f4f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62ef4fd8bc811f9bc7771875d32e7b01, https://si.imgix.net/f490e41d/uploads/origins/e2f78aa4-c0b6-4019-b69d-846e75f4f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1b248e153fd4e451d9297f60a708d5e 2x, https://si.imgix.net/f490e41d/uploads/origins/e2f78aa4-c0b6-4019-b69d-846e75f4f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16134cf40c580746da688ec4ad88a5d5 3x", "genre": "art", "nsfw": false, "body": "DENOさん\n\n以前大食いするライスシャワーのイラストを依頼させていただいた者です。\n\n今回はカレンチャンの太り気味イベントの「いっしょに、食べよ？」のイラストをお願いしたいです。\n\n本イベントは、家族連れのファンを対象とした交流イベントのお弁当タイムの際に、イベントに来た大勢の子供と親からお弁当を丸ごともらうことになってしまうというものです。そして、カレンちゃんの提案で子供がカレンチャンにあーんしてるところを親に撮ってもらうことになりました。\n\nそこで、最後の一人のお弁当を食べさせてもらう、もとい写真を撮るシーンを描いていただきたいです。\nもし、可能であれば、\n【セリフ+お腹いっぱいで限界だけど悟られないように取り繕ってなんとか笑顔でいるカレンチャン】と、\n【心の声+お腹いっぱいで限界な顔のカレンチャン】\nの2枚で差分を作っていただきたいです。\n\nまた要件としては、\n・服装は制服\n・限界まで食べてパンパンのお腹(直近のご依頼にあったカレンチャンは余裕そうだったのでそれよりは大きめで)(また、見えやすい角度、構図でお願いします)\n・セリフや心の声はお任せしますが、余裕がない限界な感じでお願いします。\n\n長文の依頼になってしまいましたが、\nご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/20", "thumbnail_src": "https://si.imgix.net/8b75cfc9/uploads/origins/c3e3cc00-a220-43e6-a103-1288695f0a59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5626e1ab2691e969f4e8fda36276598", "thumbnail_srcset": "https://si.imgix.net/8b75cfc9/uploads/origins/c3e3cc00-a220-43e6-a103-1288695f0a59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5626e1ab2691e969f4e8fda36276598, https://si.imgix.net/8b75cfc9/uploads/origins/c3e3cc00-a220-43e6-a103-1288695f0a59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa5a50e120cd31d3bf89461298fe6a19 2x, https://si.imgix.net/8b75cfc9/uploads/origins/c3e3cc00-a220-43e6-a103-1288695f0a59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c67ffc3dea4f382b8d45e54e61c7bfd 3x", "genre": "art", "nsfw": false, "body": "私のOCの絵をお願いしたいのですが。  彼女はバイコーン娘です。\n\nぴったりした赤いドレスを着ていたらいいな。  武器は炎の棒斧。\n\n性格...自信家で魅惑的。  やはりバイコーンは不純だ。\n\nhttps://drive.google.com/drive/folders/1Clh1-XOjjL_yIlN_h77jat0TSwziYees?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/19", "thumbnail_src": "https://si.imgix.net/db253100/uploads/origins/508d9585-0157-4df6-a178-8f14f858a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b135bdac9e60a1e504dc8e79410b6951", "thumbnail_srcset": "https://si.imgix.net/db253100/uploads/origins/508d9585-0157-4df6-a178-8f14f858a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b135bdac9e60a1e504dc8e79410b6951, https://si.imgix.net/db253100/uploads/origins/508d9585-0157-4df6-a178-8f14f858a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b26552ea898c357131dafb663e58c21d 2x, https://si.imgix.net/db253100/uploads/origins/508d9585-0157-4df6-a178-8f14f858a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00d9e23cbd2505c8f1aa58cfedf5f546 3x", "genre": "art", "nsfw": false, "body": "ウマ娘からアドマイヤベガとカレンチャンをお願いします。\n\n二人とも太り気味になっており、まん丸に突き出たお腹を合わせている状態をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@denomina0/works/18", "thumbnail_src": "https://si.imgix.net/57c3d538/uploads/origins/930cf57f-6195-4e88-817a-a0a61b6daf5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b8146353375ca5ca09c65125aa1bb37", "thumbnail_srcset": "https://si.imgix.net/57c3d538/uploads/origins/930cf57f-6195-4e88-817a-a0a61b6daf5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b8146353375ca5ca09c65125aa1bb37, https://si.imgix.net/57c3d538/uploads/origins/930cf57f-6195-4e88-817a-a0a61b6daf5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e47ee03524e02738d13f9b4a83824f4d 2x, https://si.imgix.net/57c3d538/uploads/origins/930cf57f-6195-4e88-817a-a0a61b6daf5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=737d7f81cad9d05c50c4b9dccbe30e7e 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\nDENO先生の作品をTwitter等で拝見し、リクエストさせていただきました。\nキャラクターはメジロアルダンで、先生が描かれたこちらの作品(https://www.pixiv.net/artworks/95791620)のような感じでスク水、ニーソ、手袋3点盛りイラストをお願いします。\nむっちむちにしてください(直球)\n(もし可能であれば表情差分もお願い致します。)\nご検討の程、よろしくお願い致します。", "created_at": "", "completed_at": ""}]}