.net/8db0cac5/uploads/origins/3eff3630-9c82-4815-abd1-db3a325119b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7964f1b2275de1e13e6d729fbfe73ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/75", "thumbnail_src": "https://si.imgix.net/ff2a5594/uploads/origins/b6dc3cce-32ee-47d6-9d0e-d3ec7e114627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8312b8e9923e36a7b0394af67335cbeb", "thumbnail_srcset": "https://si.imgix.net/ff2a5594/uploads/origins/b6dc3cce-32ee-47d6-9d0e-d3ec7e114627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8312b8e9923e36a7b0394af67335cbeb, https://si.imgix.net/ff2a5594/uploads/origins/b6dc3cce-32ee-47d6-9d0e-d3ec7e114627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82c2b01c9bda0d813ada8745282714b3 2x, https://si.imgix.net/ff2a5594/uploads/origins/b6dc3cce-32ee-47d6-9d0e-d3ec7e114627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fc133ab6b30e1be064c6d2e78dddb01 3x", "genre": "comic", "nsfw": true, "body": "失礼します、コナンさん！あなたの皮シチュが素晴らしく、フォローさせて頂きました！\n\nキャラ：アルメリア・シャーロット(私のオリキャラ)\n容姿：資料URLの金髪シスターで、身長は165くらいで胸は巨乳です。\n設定：「聖女」とまで崇められた程の神力を持つシスターです。悪魔や悪霊を簡単に祓うことができますが、アメコミヒーローのような「カッコ良いこと」に憧れており、敵と戦う前にカッコ良いポーズを取ったりとかなり自意識過剰です。基本的には敬語ですが、倫理観はあまりなく、敵だとみなせばすぐに倒しにいきます。↓URLの武器はシャーロットが持つ武器で、1枚目のロンギヌスは、「術式の中和」ができ、突き刺せば、術式を解除することができます。\nそしてシャーロットの体内にはある理由で悪魔が巣食っており、瀕死の重傷を負っても悪魔の力で治癒できます。\nhttps://www.pixiv.net/artworks/130985381\n\n\n希望シチュ：以前描かれた↓URLのような、皮シチュをお願いします！\nhttps://skeb.jp/@inuyamakonann/works/67\n\nシャーロットの背中から男が近寄り、皮剥の道具？でシャーロットの背中を切りつけ、シャーロットが離れる\n「おわ！？な、何ですか貴方！」\n↓\nベコって凹み始めるシャーロット\n「私に奇襲をかけるとはやりますね！悪党め…あれ？」\n↓\n勝ち誇る男だが、シャーロットは凹み切る前にロンギヌスを握り、腹に突き刺す。これにより、皮になる術式は解除されました。\nロンギヌスはシャーロットが使おうと思えばパッと手の中に現れるので、次の場面では握っていれば大丈夫です！\n「ふふふ、お前はもう皮になるしか…」\n「ロンギネス！！」\nズボォ！！ブシャァ！！\n「は…？」\n↓\n背中の空間がなくなり、元の体に戻るシャーロット。ロンギヌスを引き抜き、血まみれで男に近寄る\n「残念でした〜♡さて、こんな悪いことする貴方はお仕置きしてあげます！」\n↓\n次の場面で、男の死体に目もくれず、傷もなくなったシャーロットがるんるんと立ち去る姿\n\nシャーロットの漫画を描いてくださるのはコナンさんが初めてで、こんな特殊シチュを描けるのはコナンさんだけだと思い、まいりました！\nよろしくお願いします！🙇\n\nhttps://www.pixiv.net/artworks/121837753", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/74", "thumbnail_src": "https://si.imgix.net/1cbc0c8a/uploads/origins/e7aaf4c9-bdfc-45ca-9215-813094c0602e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed0d7c78e198c31548f9be7d6355c8cb", "thumbnail_srcset": "https://si.imgix.net/1cbc0c8a/uploads/origins/e7aaf4c9-bdfc-45ca-9215-813094c0602e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed0d7c78e198c31548f9be7d6355c8cb, https://si.imgix.net/1cbc0c8a/uploads/origins/e7aaf4c9-bdfc-45ca-9215-813094c0602e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb89d16d835494738c8e9ce340c3adce 2x, https://si.imgix.net/1cbc0c8a/uploads/origins/e7aaf4c9-bdfc-45ca-9215-813094c0602e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3703f4b8a1b55638ee00e581a19a12ad 3x", "genre": "comic", "nsfw": true, "body": "続けてリクエスト失礼いたします。\n次もうちのリサさんのコミックをお願いします。\n\nhttps://x.com/s_sbhr27/status/1595148239342534659/photo/1\n↑\nこちらのイラストをまたコナンさんの作風にして、内容を引き延ばして漫画にしてください。\n最後にサラマンダーくんたちがスカートの中で消化されるシーンも追加してください。\nカラーでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/73", "thumbnail_src": "https://si.imgix.net/1d7af5b2/uploads/origins/f3d5e4e4-ec63-4d99-abd0-6f09eb311766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2234152ca5270b46ae349c3a6c3f1ecb", "thumbnail_srcset": "https://si.imgix.net/1d7af5b2/uploads/origins/f3d5e4e4-ec63-4d99-abd0-6f09eb311766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2234152ca5270b46ae349c3a6c3f1ecb, https://si.imgix.net/1d7af5b2/uploads/origins/f3d5e4e4-ec63-4d99-abd0-6f09eb311766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f6cdba569d219edf9a48204ea7a3f82 2x, https://si.imgix.net/1d7af5b2/uploads/origins/f3d5e4e4-ec63-4d99-abd0-6f09eb311766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24c9c3aee56294b8594184c829aac3a8 3x", "genre": "comic", "nsfw": true, "body": "コナンさんこんにちは、前回美鈴のスケブありがとうございます！\n素敵な足フェチ描写でとても気になります！\n納品したばかりで申し訳ないが、早速再度リクエストさせていただきます。\n第二弾は神子ちゃんでお願いいたします！\n\n基本の流れや要望は美鈴の時（https://skeb.jp/@inuyamakonann/works/66）と同じで問題ないので、\n今回は神子の設定を少し頼んでから、残りはコナンさんにお任せします！\nよろしくお願い致します！\n\n神子設定：\n—————\n・よく他人にかっこいい男性扱いされている神子が、女性としてAV撮影に誘われたため、\n美鈴と比べて、比較的に喜んで積極的に制作を参加している（嫌がる・ネガティブな気持ちはほぼない）。\n・神子の外見や振る舞いもメス感が通常よりなっている\n・足サイズは美鈴より小さめですが、チャームポイントは足指が長く、\n幅広く足指が広げられる上、いやらしく動ける\n―――――", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/72", "thumbnail_src": "https://si.imgix.net/6e5546f2/uploads/origins/c23d79ec-fb19-4e8d-963f-fffabbe554fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b03b90a2bc1b62f7b599f5c4b12f59ee", "thumbnail_srcset": "https://si.imgix.net/6e5546f2/uploads/origins/c23d79ec-fb19-4e8d-963f-fffabbe554fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b03b90a2bc1b62f7b599f5c4b12f59ee, https://si.imgix.net/6e5546f2/uploads/origins/c23d79ec-fb19-4e8d-963f-fffabbe554fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90da304c4c04847e23e28b681c6dc4de 2x, https://si.imgix.net/6e5546f2/uploads/origins/c23d79ec-fb19-4e8d-963f-fffabbe554fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e6eb98297a1587ad63ce3b9cd2bcb6a 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、前回までストーカー化させる催眠をリクエストした者です。今回も似たようなものですが別の内容の催眠シチュをお願いしたいです。\nキャラクターは依神女苑です。催眠内容はほとんど同じで強制的に惚れさせるといったものです。盲目的な好意を抱かされた女苑が男の気を引こうと貢いだり必死に口説いたり媚びたりします。催眠をかけた男から適当にあしらわれたり無視されて、最終的には男を押し倒します。本番行為の描写は無しで押し倒すまでです。\n\nまた、できればお願いしたいのですが、以下の一枚目、三枚目のイラストの女苑のように身長は小さめで、顔の印象も近い感じで描いていただきたいです。\nhttps://www.pixiv.net/artworks/84068731", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/71", "thumbnail_src": "https://si.imgix.net/51326151/uploads/origins/586b01d9-b7fb-4b33-be21-65c0d101b8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88784c7920c8393e47cfdfbf18fec18b", "thumbnail_srcset": "https://si.imgix.net/51326151/uploads/origins/586b01d9-b7fb-4b33-be21-65c0d101b8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88784c7920c8393e47cfdfbf18fec18b, https://si.imgix.net/51326151/uploads/origins/586b01d9-b7fb-4b33-be21-65c0d101b8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f0a7af0f1f036ca0795600bd159c398 2x, https://si.imgix.net/51326151/uploads/origins/586b01d9-b7fb-4b33-be21-65c0d101b8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a6464ed35db7e1075c44479c7ae7c49 3x", "genre": "comic", "nsfw": true, "body": "初めまして。うちのオリジナルキャラのリサさんのコミックをリクエストさせてください。\n少年をドレスのロングスカートの中に閉じ込めて消化して捕食してしまう妖怪です。\n\nhttps://x.com/s_sbhr27/status/1312556865562107904/photo/1\nhttps://x.com/s_sbhr27/status/1312923183553548288/photo/1\n↑この２枚のストーリーをコナンさんの作風で、カラーで漫画にしていただきたいです。\n\n↓その他リサさんの参考\nhttps://x.com/s_sbhr27/status/1446523476156698634/photo/1\nhttps://x.com/s_sbhr27/status/1446673738259333124/photo/1\nhttps://x.com/s_sbhr27/status/1261045231270506497/photo/1\nhttps://x.com/s_sbhr27/status/845857145010597890/photo/1\nhttps://x.com/s_sbhr27/status/1398410570731163648/photo/1\nhttps://x.com/s_sbhr27/status/1821763631924883954/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/70", "thumbnail_src": "https://si.imgix.net/d68739ad/uploads/origins/cdc27bfc-f328-4ab4-a45d-4122d096c313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bf48dbf75f64a8152525feca02298be", "thumbnail_srcset": "https://si.imgix.net/d68739ad/uploads/origins/cdc27bfc-f328-4ab4-a45d-4122d096c313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bf48dbf75f64a8152525feca02298be, https://si.imgix.net/d68739ad/uploads/origins/cdc27bfc-f328-4ab4-a45d-4122d096c313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c4635567d950295edddc35007d496a 2x, https://si.imgix.net/d68739ad/uploads/origins/cdc27bfc-f328-4ab4-a45d-4122d096c313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4316001784fc6d02e303b23ef920ba9 3x", "genre": "comic", "nsfw": true, "body": "匿名ですが、過去に何度かリクエストさせて頂いたことのある者になります。モノクロのコミック形式でアナル遊びをする洩矢諏訪子をお願い出来ませんでしょうか。最初は指でほぐしていき、やがてディルドを使っての騎乗位やバック、セルフでの浣腸・噴射、アナルビーズ等を利用して楽しみ、最後はうつ伏せで尻を突き出した格好で、ぽっかりアナルのまま気持ち良くなっている、といった感じでお願いしたいです。\nご検討のほど宜しくお願い致します。\nもし、金額的に不釣合ありましたら再送要請願います。\n\nスイカ本拝見させて頂きましたが、とてもエロ可愛く、萃香の圧倒的上位っぷりが良かったです。", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/69", "thumbnail_src": "https://si.imgix.net/543c5ac8/uploads/origins/70d316c1-9d88-4423-a294-57a314f11d30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f50c289efaedc5f03967ae654ac059", "thumbnail_srcset": "https://si.imgix.net/543c5ac8/uploads/origins/70d316c1-9d88-4423-a294-57a314f11d30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f50c289efaedc5f03967ae654ac059, https://si.imgix.net/543c5ac8/uploads/origins/70d316c1-9d88-4423-a294-57a314f11d30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d32658e64a8e67d82c88be8ceb357499 2x, https://si.imgix.net/543c5ac8/uploads/origins/70d316c1-9d88-4423-a294-57a314f11d30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c5a9c691d1d6766e81403ce41d8e920 3x", "genre": "comic", "nsfw": true, "body": "こんにちは。今回の皮モノヤマメもとても良かったです。ありがとうございました\nまた皮モノでリクエストさせてください。\n今回はこいしでお願いします。イメージとしてはできれば以前描かれていた以下のような頭身や表情の感じでお願いしたいです。\nhttps://www.pixiv.net/artworks/108117952#big_0\n今回は皮への変化は特殊で、こいしはまず動けなくなります。こいしは皮を脱がされ、中身は人のようにも見える形の石になっています。その前で男がこいしの皮を着る感じでお願いしたいです。\n皮の質感は以前までと同じです", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/68", "thumbnail_src": "https://si.imgix.net/fc3336f1/uploads/origins/b58de47e-bcd8-4b87-8cc6-92a91624af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2a000c27809dc9d00cfeae7482e6818", "thumbnail_srcset": "https://si.imgix.net/fc3336f1/uploads/origins/b58de47e-bcd8-4b87-8cc6-92a91624af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2a000c27809dc9d00cfeae7482e6818, https://si.imgix.net/fc3336f1/uploads/origins/b58de47e-bcd8-4b87-8cc6-92a91624af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11f77bc1a09a39e1b8673ac6ac327eeb 2x, https://si.imgix.net/fc3336f1/uploads/origins/b58de47e-bcd8-4b87-8cc6-92a91624af3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a2992a069dc613fcbba32f8a9798354 3x", "genre": "art", "nsfw": true, "body": "こんにちは。厳しい拘束衣を着たこのキャラクターのイラストをお願いしたいです。舞台は深夜、彼女のパッド入りの部屋です。彼女は自傷行為を止めるため、ベッドに縛りつけられました。彼女は恐怖にのたうち回り、狂ったような怯えた表情を浮かべている。彼女は頭の中で数え切れないほどの声を聞いているので、部屋は視界の端で多少歪んで見えるかもしれない。彼女の目は薄明かりの中で光っている。もしかしたら、マンスクギャグを着た別バージョンがあるかもしれない？\n\nhttps://drive.google.com/file/d/1h1EIS1g6Pa3VoxTamHYFDL9iRPucAq29/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/67", "thumbnail_src": "https://si.imgix.net/11f56b0c/uploads/origins/30994523-0355-45f7-9cdd-d9d1c2845218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2755128cace2c2678454c6274c960b03", "thumbnail_srcset": "https://si.imgix.net/11f56b0c/uploads/origins/30994523-0355-45f7-9cdd-d9d1c2845218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2755128cace2c2678454c6274c960b03, https://si.imgix.net/11f56b0c/uploads/origins/30994523-0355-45f7-9cdd-d9d1c2845218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c07d02ca4750477ed5ee21806ba98e8b 2x, https://si.imgix.net/11f56b0c/uploads/origins/30994523-0355-45f7-9cdd-d9d1c2845218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b1f357ac92d9abb0eaf4e75f3287877 3x", "genre": "comic", "nsfw": true, "body": "はじめまして！諏訪子の皮モノ絵がとても良かったのでリクエストしたいと思います！\n\nシチュは大妖精（を着て成り済ましている男）からチルノへと皮化からの着替えになります（皮の質感は諏訪子の時と同様で）\n\n\n\n「チルノちゃん、ゴミついてるから取ってあげるね」的な感じにチルノと一緒にいる大妖精が笑顔でチルノの背中に指をズブリと刺すと（大妖精の手から皮化能力の怪しいオーラが出ている）\n\n大妖精の指が入ったチルノは皮化してしまう（※皮を脱ぐ、皮を着る過程を重視して欲しいのでページ数が足りなければ指が入った後に皮化していく過程を省いてチルノが既に皮になった姿でもOKです、もしくは手から怪しいオーラを浮かべている笑顔の大妖精の前でチルノが既に餌食になり皮化した状態でスタートでもOKです）\n\n\n\nそして怪しい笑みを見せた大妖精が皮を脱ぐと（皮を脱ぐ時に大妖精の表情が失われる）中から謎の男が現れる…（名探偵コナンの犯人みたいな全身真っ黒の怪しい人物）\n\n大妖精の皮を脱いだ男はチルノを皮を着るとグイグイと両手でチルノの顔面を伸ばして弄りシワを無くす調整した後にニカッとチルノに成りきってる感じの元気な笑顔を最後に見せる…と言う感じの漫画をお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/66", "thumbnail_src": "https://si.imgix.net/d126e837/uploads/origins/d05f07a3-0117-4283-9546-e68ade4b639d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5b31c1af0f2189f19a4a84ce60aed35", "thumbnail_srcset": "https://si.imgix.net/d126e837/uploads/origins/d05f07a3-0117-4283-9546-e68ade4b639d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5b31c1af0f2189f19a4a84ce60aed35, https://si.imgix.net/d126e837/uploads/origins/d05f07a3-0117-4283-9546-e68ade4b639d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=777e15fca05f1854317e19acd4fff937 2x, https://si.imgix.net/d126e837/uploads/origins/d05f07a3-0117-4283-9546-e68ade4b639d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3a438fe625034e3b2c3e4eac79f4e66 3x", "genre": "comic", "nsfw": true, "body": "コナンさんこんにちは、あなたが描いた東方のイラスト漫画がとても癖に刺さっていて、特に足裏の絵が気になっているので、もし宜しければぜひ依頼させていただきます。\n依頼内容は足フェチ特化のAVビデオ漫画でお願いします。\n今後複数回依頼するかもしれないので、第一弾は美鈴でお願いいたします！\n—————\n本文：\n①全裸で自己紹介（名前、歳、どこに所属・出身、AVを撮る理由）\n②足裏を見せながら、足のサイズを説明\n③足の匂いを説明＋匂いチェック（自分の足を嗅ぐ）\n④足の味を味わいながらオナニーする＋食レポ（自分の足の味を詳しく説明）\n⑤潮吹き＋最後に自分は足フェチになったので、ぜひ皆も足フェチの一員になってくださいと笑顔で宣伝（最後もう一度ドロドロになった足裏をみせる）\n―――――\n個人的には重度の足＆匂いフェチなので、ぜひ汗だくの足＆匂い要素を重んじて描いていただければ嬉しいです。\n構図は一人称視点（AV撮る側）で、セリフや、キャラの性格・表情などはコナンさんにお任せしたいです。\n女の子が自分の足のサイズは大きめで、匂い・味はキツめと言うようにお願いしたいです。\n最後にできればの話ですが、AVのように、AVパッケージも描いていただきたいです（無理であれば本文だけでも十分です）。\nよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/65", "thumbnail_src": "https://si.imgix.net/3bcbce63/uploads/origins/9a3a0be8-ec58-4fa4-89d0-4d580c2a9484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b116c022ae95887e9bb53fed8bb312", "thumbnail_srcset": "https://si.imgix.net/3bcbce63/uploads/origins/9a3a0be8-ec58-4fa4-89d0-4d580c2a9484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b116c022ae95887e9bb53fed8bb312, https://si.imgix.net/3bcbce63/uploads/origins/9a3a0be8-ec58-4fa4-89d0-4d580c2a9484?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca38db193071ea896492a45201d6e3cf 2x, https://si.imgix.net/3bcbce63/uploads/origins/9a3a0be8-ec58-4fa4-89d0-4d580c2a9484?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=274497968933cb90b46bfd1d6bbc58f5 3x", "genre": "comic", "nsfw": true, "body": "諏訪子皮モノとても良かったです。\n納品当日ですが、早速またお願いしたいです。\n同じく皮モノシチュで、\nキャラクターは黒谷ヤマメ（普段描かれているように多眼）でお願いしたいです。\n前回と同じようにして男がヤマメを皮にして着る感じです\n指定はほとんど前回と同じですが、今回は絵柄の指定はないです。", "created_at": "", "completed_at": ""}, {"path": "/@inuyamakonann/works/64", "thumbnail_src": "https://si.imgix.net/50a32fbd/uploads/origins/df14bc34-7e8a-4f8c-af1e-eef4fa1f880f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5254df508b5560cdaf7ea9de706c5c3", "thumbnail_srcset": "https://si.imgix.net/50a32fbd/uploads/origins/df14bc34-7e8a-4f8c-af1e-eef4fa1f880f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=