d0f1-4243-938d-bf3e8f847280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b72a7983daf53ceab3f796d2900cef1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tatuki_atu/works/18", "thumbnail_src": "https://si.imgix.net/a8c23971/uploads/origins/c7a2f1a5-55e2-49bd-a524-798fb7bdbcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7afffbfa5e599f8dffa63d3a1b084ee6", "thumbnail_srcset": "https://si.imgix.net/a8c23971/uploads/origins/c7a2f1a5-55e2-49bd-a524-798fb7bdbcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7afffbfa5e599f8dffa63d3a1b084ee6, https://si.imgix.net/a8c23971/uploads/origins/c7a2f1a5-55e2-49bd-a524-798fb7bdbcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97ad4b0d70b7e28a16d100898812a1b5 2x, https://si.imgix.net/a8c23971/uploads/origins/c7a2f1a5-55e2-49bd-a524-798fb7bdbcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=566c29a129d53581e68626a682e667dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの絵が大好きで、私のffxivのキャラクターの絵をお願いしたいです!また、このような絵が好きで、私のffxivのキャラクターをリクエストしたいです！戦闘やクールなポーズで、真剣な表情でお願いします。頼もしくて、真面目で、強いキャラクターですまた、顔に傷があり、アイシャドウが赤いのが特徴です。あと、筋肉質な感じでお願いします。ありがとうございました。\n\nhttps://imgur.com/a/SlbMWei", "created_at": "", "completed_at": ""}, {"path": "/@tatuki_atu/works/17", "thumbnail_src": "https://si.imgix.net/d35af971/uploads/origins/ad14e58d-9f4d-42ac-b1dc-902073eded4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a96592f4b93308c94275d1be2bc2b317", "thumbnail_srcset": "https://si.imgix.net/d35af971/uploads/origins/ad14e58d-9f4d-42ac-b1dc-902073eded4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a96592f4b93308c94275d1be2bc2b317, https://si.imgix.net/d35af971/uploads/origins/ad14e58d-9f4d-42ac-b1dc-902073eded4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8469bde5f9239e819a376ea467a8f80c 2x, https://si.imgix.net/d35af971/uploads/origins/ad14e58d-9f4d-42ac-b1dc-902073eded4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aa2a1f90a4400ec6595a7fabed7bc1f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tatuki_atu/works/16", "thumbnail_src": "https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=182c1cdab98be4d27c179dcdad6502ba", "thumbnail_srcset": "https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=182c1cdab98be4d27c179dcdad6502ba, https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87ea5f91ce6da45a97e70c2d78ac2cea 2x, https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47668be61d8afe0b9b5203a1bd1fb471 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n先日のtwitterで見かけた鹿子田くんがタイプすぎて、是非エロいイラストも見たく依頼させていただきます。柔道部のがっしりした体格に、豪快な性格。黒色短髪も鼻バンも全部最高です。\n個人的に夜這いモノが大好きなので、こんなシチュエーションは可能でしょうか。\n※木羽さんの設定と合わない部分は削って構いません。\n\n前提\n○柔道部の合宿中。オナ禁で溜まった鹿子田くんは、夜中こっそり布団の中でシコろうとするも、練習疲れで途中で寝落ちしてしまう。朝起きて来ないので牛島主将が部屋に入ると…。\n\n希望\n○服装はお任せします。\n○布団からはみ出るくらい寝相が悪いと嬉しいです（一人部屋、雑魚寝部屋どちらでも構いませ\nん。）。\n○スヤスヤ寝ているというよりは、大いびきかいて爆睡している感じでお願いします。よだれ垂らしてたり、枕によだれの跡があると最高です。\n○ずり下げたパンツからギンギンの朝勃ちが直立。サイズ感やかぶっているかどうかはお任せします。\n○手元に使うはずだったティッシュがあると嬉しいです。\n\n今後の柔道部やクラスメートなどの展開も楽しみにしています（あと養護教諭なのに赤ジャージの工口先生も大好きです。）。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tatuki_atu/works/15", "thumbnail_src": "https://si.imgix.net/b7eee5ee/uploads/origins/bc403719-a6e2-47c3-bd8f-b7ae65c09f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e3ad27974f1225d61332955740efb18", "thumbnail_srcset": "https://si.imgix.net/b7eee5ee/uploads/origins/bc403719-a6e2-47c3-bd8f-b7ae65c09f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e3ad27974f1225d61332955740efb18, https://si.imgix.net/b7eee5ee/uploads/origins/bc403719-a6e2-47c3-bd8f-b7ae65c09f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ea005f28755838101214ecb2582b5f4 2x, https://si.imgix.net/b7eee5ee/uploads/origins/bc403719-a6e2-47c3-bd8f-b7ae65c09f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dfb403f9cacb669a5673c28a3069669 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tatuki_atu/works/14", "thumbnail_src": "https://si.imgix.net/0dd08a6e/uploads/origins/33fd66e1-bbc4-4046-9901-c717f88a3860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58fb126d46331b28ccaf66462a156286", "thumbnail_srcset": "https://si.imgix.net/0dd08a6e/uploads/origins/33fd66e1-bbc4-4046-9901-c717f88a3