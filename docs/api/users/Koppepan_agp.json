2e-965e-990f66440c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901889054d0cadc547ce3cc1a8889aaa, https://si.imgix.net/2cecd838/uploads/origins/31e5a4b0-12c4-402e-965e-990f66440c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cf36b52347968c6ebd7a44b2e303c42 2x, https://si.imgix.net/2cecd838/uploads/origins/31e5a4b0-12c4-402e-965e-990f66440c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b1a9500800d115930b0d381897d54b2 3x", "genre": "art", "nsfw": false, "body": "はじめまして。今回うちの子のアクリスを描いていただきたくご依頼させて頂きました。\nちょっと抜けた所のある優しい鹿の上位種のお姉さん(180cm)になります。\n瞳の色はターコイズブルーになります。\n服装は資料のType-A,Bのどちらかお好きな方をお願いします。\nポーズや表情もおまかせいたします。\n\n以上になります。\nお忙しい所恐縮ですが、ご一考よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1sAtEwb2X3dK9LecXcmqkOQXXMmUZbeGl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/21", "thumbnail_src": "https://si.imgix.net/eb76b6e9/uploads/origins/55f8714d-f041-46cb-baa2-73beefbc1c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0b590e478d231fe863fb66e6f92a2d", "thumbnail_srcset": "https://si.imgix.net/eb76b6e9/uploads/origins/55f8714d-f041-46cb-baa2-73beefbc1c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0b590e478d231fe863fb66e6f92a2d, https://si.imgix.net/eb76b6e9/uploads/origins/55f8714d-f041-46cb-baa2-73beefbc1c48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90cb40e7b06835bebfab45f7b8ba38ce 2x, https://si.imgix.net/eb76b6e9/uploads/origins/55f8714d-f041-46cb-baa2-73beefbc1c48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26dfcf3200892557a2cc667bfdf9d2d5 3x", "genre": "art", "nsfw": false, "body": "はじめまして！あなたのアートスタイルが好きです。アークナイツのWのアートワークをお願いしたいです。\n\n彼女はクレイジーな目をした傭兵です。彼女は笑顔で爆弾を使うのが好きなキャラクターです。彼女の重要な特徴は、輝く目、スキンタイトレギンス、大きな胸です。ポーズと構図はお任せします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ONL_dK33-GzM26sQsjlOT0r90Dnq5AHu", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/20", "thumbnail_src": "https://si.imgix.net/061f56e4/uploads/origins/73c42be8-80ba-400b-84ac-85fed7bb31b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6584c16348d049b33d52f53b94e062de", "thumbnail_srcset": "https://si.imgix.net/061f56e4/uploads/origins/73c42be8-80ba-400b-84ac-85fed7bb31b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6584c16348d049b33d52f53b94e062de, https://si.imgix.net/061f56e4/uploads/origins/73c42be8-80ba-400b-84ac-85fed7bb31b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6eb32097d082c46443389b8457de4f50 2x, https://si.imgix.net/061f56e4/uploads/origins/73c42be8-80ba-400b-84ac-85fed7bb31b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=970395cdbea309794b739ec3c7f2c9d7 3x", "genre": "art", "nsfw": false, "body": "コッペパンさん、おはようございます！またリンゴちゃんを依頼します！\n\n先のイラストがすごく好きだった！またいっぱい横乳が見たいです！大丈夫だったら、赤いアイライナーを描いてください！\n\nポーズや構図はコッペパンさんにお任せします！\n\nhttps://drive.google.com/drive/u/3/folders/1HHGXHxWMslSX0zW7W5od2t-6_v0vKTVJ\nhttps://drive.google.com/drive/u/3/folders/1TZYEFbumfPxXmUb6K5bkDB2DRk58nUlT\nhttps://drive.google.com/file/d/14GhpYbi1bAqCBVEJG4fGi9a5ZHmCTuD-/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/19", "thumbnail_src": "https://si.imgix.net/5f0b024e/uploads/origins/167da128-99df-4a72-a528-57c939ab23a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afc54ea27eb7131d74909c7aff479fa", "thumbnail_srcset": "https://si.imgix.net/5f0b024e/uploads/origins/167da128-99df-4a72-a528-57c939ab23a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afc54ea27eb7131d74909c7aff479fa, https://si.imgix.net/5f0b024e/uploads/origins/167da128-99df-4a72-a528-57c939ab23a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0771ecf6437c35d4ec51f0234f342a2b 2x, https://si.imgix.net/5f0b024e/uploads/origins/167da128-99df-4a72-a528-57c939ab23a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f92a5e05aa5edcbb712dd05d7f0e174 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n描いてほしいのは自キャラです：https://drive.google.com/drive/folders/13AxGKW1t-afm8Daj0K5mD26Ee0k2iYQi?usp=drive_link\n服装は資料内のセーターで\n構図はお任せしますが太ももが好きなので膝くらいまで写っているものでお願いします。\n\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13AxGKW1t-afm8Daj0K5mD26Ee0k2iYQi?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/18", "thumbnail_src": "https://si.imgix.net/d09bd673/uploads/origins/0e010bbf-db80-450f-94a2-0c5d3f1c5587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afec0458aaace0aeb8ccd8390b97653f", "thumbnail_srcset": "https://si.imgix.net/d09bd673/uploads/origins/0e010bbf-db80-450f-94a2-0c5d3f1c5587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afec0458aaace0aeb8ccd8390b97653f, https://si.imgix.net/d09bd673/uploads/origins/0e010bbf-db80-450f-94a2-0c5d3f1c5587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e59f705f087f8501965c7191fc52b46 2x, https://si.imgix.net/d09bd673/uploads/origins/0e010bbf-db80-450f-94a2-0c5d3f1c5587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccc294de7a7b615c69ea1be3d9e6f33d 3x", "genre": "art", "nsfw": false, "body": "資料URL先のオリジナルキャラクター、「景山霞」をリクエストします。\n設定を以下に簡単に記述します。\n\n・現代日本の学生だが、代々伝わる呪術的な異能を持つ。呪術マニア。\n・普段は地味めで内気、清楚な文学少女的な雰囲気。戦闘用の装束を身に纏うと堂々とした振る舞いになる。\n・身長162cm程度。着痩せするタイプ。\n・異能を発動すると、タトゥーが浮かび上がる。\n\n2パターンのシチュエーションのうち、どちらかを選んでください。\n\n【案A】\n・普段の姿(立ち絵制服の状態。衣服はオリジナルの私服でもOK)。\n・呪術的な内容の書かれた怪しげな本(本格的っぽいもの)を、ひかえめに勧めてくる。\n\n【案B】\n・戦闘用の装束。仮面は有り(もしくは、有無の差分)\n・杖を手に、妖艶な微笑み。ポーズ等はおまかせ。\n\n以上、よろしければお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/f2k4qlbq2y18o10aev04p/AAIYFG48E9AVOGZHK37K6PA?rlkey=albercckziwkvu4l03fsddis5&st=0gmr98eu&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/17", "thumbnail_src": "https://si.imgix.net/64a46f02/uploads/origins/0990b2c4-c7ff-442b-81a4-222e48c518e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0256d273256c2031b8eb0e51c880aad8", "thumbnail_srcset": "https://si.imgix.net/64a46f02/uploads/origins/0990b2c4-c7ff-442b-81a4-222e48c518e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0256d273256c2031b8eb0e51c880aad8, https://si.imgix.net/64a46f02/uploads/origins/0990b2c4-c7ff-442b-81a4-222e48c518e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=644a338ef562cb8e0bb3bb09452767ff 2x, https://si.imgix.net/64a46f02/uploads/origins/0990b2c4-c7ff-442b-81a4-222e48c518e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3da27ccd6abe033d1f138cf8838b792c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、コッペパンさま！\n\n私のキャラクター「マサさま」のイラストをお願いします。マサさまは強力な霊力を持つ古代のキツネ妖怪です。とても大人で賢いですが、短気で浮気性でもあります。\n\nマサは身長248センチで、先が白い9本の尻尾を持っています。バストも大きく、カーヴィーです。バストアップやヒップアップはご自由にどうぞ！\n\nお読みいただきありがとうございました！\n\nマサ：https://imgur.com/a/masa-MBXe0Fi", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/16", "thumbnail_src": "https://si.imgix.net/a57fbccc/uploads/origins/fc1fbee6-2de1-4384-b476-e1f9aa95fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73a1680961b908916ed6dd57d09a6b6", "thumbnail_srcset": "https://si.imgix.net/a57fbccc/uploads/origins/fc1fbee6-2de1-4384-b476-e1f9aa95fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73a1680961b908916ed6dd57d09a6b6, https://si.imgix.net/a57fbccc/uploads/origins/fc1fbee6-2de1-4384-b476-e1f9aa95fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97c8c88c5b51b1f73549a88dd74a37af 2x, https://si.imgix.net/a57fbccc/uploads/origins/fc1fbee6-2de1-4384-b476-e1f9aa95fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be1c7f32d716e60aee735fb1a905de54 3x", "genre": "art", "nsfw": false, "body": "はじめまして、歪んだむと申します。\nX（旧Twitter）に上げられていたイラストを拝見し、今回リクエストを送りました。\n\nうちの子の探索者「シア」をリクエストします。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n\nリクエスト内容ですが、\nhttps://x.com/Koppepan_agp/status/1889956836201341319?t=o4O8P4-OW3ESuQtkvMdc1w&s=19\nこちらのネルのイラストのように、シアが銃を持っている状態でお願いします。\n\nシアの衣装:ライトニング・チェシャー（最大稼働モード）\nhttps://x.com/gn0083/status/1911390126732632277?t=KzjSsPwaTY1VhgUCEf1RnA&s=19\n資料画像1枚目\nバイザーが下り、猫耳型ホログラムアンテナやビームのマフラーが出ている。浮遊ブースターが開く。\n全身の黄色いラインやパーツが発光する（ヘッドギア、手首、肘、踵とブースター含む膝から下の装備の黄色部分）\n\n銃:ブレードリボルバー\nhttps://x.com/gn0083/status/1838758882270941365?t=udMqjj11NIszY5JGugZ6dw&s=19\n\n表情参考\nhttps://skeb.jp/@Hidanegi/works/109\nhttps://skeb.jp/@irohazeTH/works/7（右側半分）\n\n\n\nその他、構図や背景の有無などはお任せします。\n\n\n宛名やサイン、背景につきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインonで投稿）\n\n\nご検討よろしくお願いします。 \n\n\n●簡易な設定など\n黒髪に、先端に行くほど濃くなる山吹色のグラデーションインナーカラー。\n顔はいいが基本的にぶっきらぼうで、口調も乱暴。目付きも鋭い。別に悪人ではないが第一印象で勘違いされやすいタイプ。\nスタイルは引き締まっているが、お尻はデカい。\n・キャラデザ\nhttps://x.com/gn0083/status/1794173475369980214?t=5OdbIcbc-JVDwMe0RB0y6Q&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/15", "thumbnail_src": "https://si.imgix.net/35fae6c9/uploads/origins/4da61215-e3fb-4369-ac01-868fad961d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b84de30cbcdc2cb1e20f3f5641d32360", "thumbnail_srcset": "https://si.imgix.net/35fae6c9/uploads/origins/4da61215-e3fb-4369-ac01-868fad961d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b84de30cbcdc2cb1e20f3f5641d32360, https://si.imgix.net/35fae6c9/uploads/origins/4da61215-e3fb-4369-ac01-868fad961d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a02d4bfef8d506d24cd9bb3252f7d4d 2x, https://si.imgix.net/35fae6c9/uploads/origins/4da61215-e3fb-4369-ac01-868fad961d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d75415804907349030f9a56b818ac0e9 3x", "genre": "art", "nsfw": false, "body": "コッペパン信者 先生、こんにちは。 私はあなたのユニークなアートスタイルが好きで!お忙しいならお手数ですが、もしあなたに時間があればボルトのイラストをお願いしたいです。ボルトが彼のおいろけの術を使って男性を誘惑するシーンがあります。この形でボルトを描いていただけますか、ポーズと構図はあなたにお任せします。体つきはムチムチでお願いします. 胸の谷間が強調されていると嬉しいです. 私はそのシーンのビデオへのリンクを投稿します。 ご検討のほど、どうぞよろしくお願いいたします ！\n\nhttps://m.youtube.com/watch?v=jcjez5abGkc", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/14", "thumbnail_src": "https://si.imgix.net/ae9b14ff/uploads/origins/cc3f0444-3d30-430b-8588-2ec8af449454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b7769a693d4fee579d4a741a5ed9694", "thumbnail_srcset": "https://si.imgix.net/ae9b14ff/uploads/origins/cc3f0444-3d30-430b-8588-2ec8af449454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b7769a693d4fee579d4a741a5ed9694, https://si.imgix.net/ae9b14ff/uploads/origins/cc3f0444-3d30-430b-8588-2ec8af449454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=982f8d94dbfb650d3654a9dbdafe47e0 2x, https://si.imgix.net/ae9b14ff/uploads/origins/cc3f0444-3d30-430b-8588-2ec8af449454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32004c0fcd3992519675b146c2b3e361 3x", "genre": "art", "nsfw": false, "body": "コッペパンさん、おはようございます！うちのリンゴちゃんを依頼します！\n\nリンゴちゃんはお茶目で能天気な爆乳狐娘です！青い羽織と白い着物を着ています！羽織は肘の下にかけてほしいです！いっぱい横乳が見えます！\n\nhttps://x.com/dosukebe_pan/status/1896091603443597492?s=19\nコッペパンポさんのエイミイラストのような感じをお願いします！\nポーズや構図はコッペパンさんにお任せします！\n\nhttps://drive.google.com/drive/u/3/folders/1HHGXHxWMslSX0zW7W5od2t-6_v0vKTVJ\nhttps://drive.google.com/drive/u/3/folders/1TZYEFbumfPxXmUb6K5bkDB2DRk58nUlT\nhttps://drive.google.com/file/d/14GhpYbi1bAqCBVEJG4fGi9a5ZHmCTuD-/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Koppepan_agp/works/13", "thumbnail_src": "https://si.imgix.net/3fb96954/uploads/origins/0bef393b-57cf-4894-920f-d960a89e7c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0b4e0eb585e257dd7d5a7c949b0