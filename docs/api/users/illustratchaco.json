7Wbp4r0Uq.png?ex=65cf0a70&is=65bc9570&hm=e4c5e31dbd50b81ea71be1e39451e68e8917e8f3b84b4aa48e4856a7253e6f77&\nhttps://media.discordapp.net/attachments/1058173087335583795/1180147147333718067/stravii_fullbody-hoshi.png?ex=65cf6b2d&is=65bcf62d&hm=ef9190b3cb60c6ef8970773251a6fb8382e9ddc5b93d29557e6045dd3e760667&\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@illustratchaco/works/13", "thumbnail_src": "https://si.imgix.net/ba6b6e55/uploads/origins/225ebe32-8f3e-4dda-8358-f478b1bbbc8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83f892b264ce0d8bfe466fe3c1fdc940", "thumbnail_srcset": "https://si.imgix.net/ba6b6e55/uploads/origins/225ebe32-8f3e-4dda-8358-f478b1bbbc8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83f892b264ce0d8bfe466fe3c1fdc940, https://si.imgix.net/ba6b6e55/uploads/origins/225ebe32-8f3e-4dda-8358-f478b1bbbc8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b04ca4495f057b74f63920a5b389f5cd 2x, https://si.imgix.net/ba6b6e55/uploads/origins/225ebe32-8f3e-4dda-8358-f478b1bbbc8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f815ffd40eb63e3ac616268ad2544e2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風はとてもかわいいですね！私のうさぎのキャラクター「ヴィヴィ」を描いていただくことは可能でしょうか？ありがとうございます！キャラクターのポーズを楽しんでください。\n\nhttps://pbs.twimg.com/media/F-Nd9coWAAAo8ri?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@illustratchaco/works/12", "thumbnail_src": "https://si.imgix.net/b92a9210/uploads/origins/25a41a29-ab5f-4c01-8a83-571b75a08300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232e17792f3eaeaeafbb2d44a8249071", "thumbnail_srcset": "https://si.imgix.net/b92a9210/uploads/origins/25a41a29-ab5f-4c01-8a83-571b75a08300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232e17792f3eaeaeafbb2d44a8249071, https://si.imgix.net/b92a9210/uploads/origins/25a41a29-ab5f-4c01-8a83-571b75a08300?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bcac5cc171806e37e7f2d5fdecefca6 2x, https://si.imgix.net/b92a9210/uploads/origins/25a41a29-ab5f-4c01-8a83-571b75a08300?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c0b769e4ab42b0bfe7d011087f6ce9a 3x", "genre": "art", "nsfw": false, "body": "足が40本ある多脚ケモノタウルを見てみたい！(昆虫じゃないけど）\n\n解剖学的には、2本の腕、2本の前脚、38本の後脚があり、それぞれの脚の間にフルサイズの胴体があるようなキャラクターにしたい。詳しくは以下のドキュメントをご覧ください。\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1104320790406627458/Taurtrain_anatomy_reference.doc\n\n以下の点を重視します：\n- 適切な解剖学（例えば、前脚と後脚の違いなど）\n- 胴体全体を見せること。\n- 蹄など他の種類の脚ではなく、肉球を見せること。\n\n上記をすべて満たせば、以下のどれでもかまわない：\n- クリーチャー\n- デザイン\n- ポーズ", "created_at": "", "completed_at": ""}]}