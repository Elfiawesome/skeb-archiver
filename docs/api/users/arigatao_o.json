%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b82b4b553532970ee70adb5bd0df5744 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arigatao_o/works/22", "thumbnail_src": "https://si.imgix.net/7a85dd86/uploads/origins/a7b53b9f-bdee-4766-a3e3-58c8ed8129e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d1815181e58e718f3daf91d00eda2c1", "thumbnail_srcset": "https://si.imgix.net/7a85dd86/uploads/origins/a7b53b9f-bdee-4766-a3e3-58c8ed8129e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d1815181e58e718f3daf91d00eda2c1, https://si.imgix.net/7a85dd86/uploads/origins/a7b53b9f-bdee-4766-a3e3-58c8ed8129e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec277a23e37774dc8e88de7a28a77f87 2x, https://si.imgix.net/7a85dd86/uploads/origins/a7b53b9f-bdee-4766-a3e3-58c8ed8129e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fd1739cb5ac2d635efc2f93666c84bd 3x", "genre": "art", "nsfw": false, "body": "Hello! I'd love to get a piece of my three dogs in 16:9/wallpaper size please :)\n\nMaya: Schnauzer mix, biggest of the three. I'd like her to have a purple collar. She is friendly but bold. She has a mohawk going down her back.\n\nDipper: Jack russell terrier. He is the middle size, he is also missing a leg (his back left leg). I'd like him to have a blue collar. He is very high energy.\n\nMabel: Chihuahua. She is the smallest, she has a very bossy/queen like personality. I'd like her to have a pink collar. \n\nFeel free to do whatever you'd like for the theme!\n\nhttps://sta.sh/212p7se2qux2?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@arigatao_o/works/21", "thumbnail_src": "https://si.imgix.net/af4b1f8e/uploads/origins/6a62b2bf-613a-4366-afc8-88bf42a64732?bg=%23fff&auto=format%2Ccompress&fm