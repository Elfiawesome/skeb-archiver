6e-1ee0-4c88-a170-7a93a3fb3cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79add866d7c55ca1b7f37d389ed1c2d8 2x, https://si.imgix.net/f93acdb2/uploads/origins/cb01086e-1ee0-4c88-a170-7a93a3fb3cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd84dd2f902f283ca5e775f09965e720 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの愛らしい画風がとても気に入ったので、私のキャラクターの絵をあなたに依頼してみたいと思います！小柄でやんちゃな性格の小さなドラゴンです。ポーズや服装、表情は自由に決めていただいて構いません！\n\nhttps://drive.google.com/drive/folders/1R714_Gb4lFWpNxaT9bZXhrRUbshBT7Z5", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/18", "thumbnail_src": "https://si.imgix.net/530f212f/uploads/origins/fce7e019-960d-4281-8ddb-17762d381db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a513a1fd49051aa740a36464c06229e3", "thumbnail_srcset": "https://si.imgix.net/530f212f/uploads/origins/fce7e019-960d-4281-8ddb-17762d381db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a513a1fd49051aa740a36464c06229e3, https://si.imgix.net/530f212f/uploads/origins/fce7e019-960d-4281-8ddb-17762d381db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=756312754090b96d8d725389291ef5db 2x, https://si.imgix.net/530f212f/uploads/origins/fce7e019-960d-4281-8ddb-17762d381db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca9ef847096592496bbd3fc06c5c37eb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きです！\n私のキャラクターを描いてほしいのですが、参考にしたい服を着せて、四角い腕時計をつけて、角縁のメガネをかけてほしいです。表情は冷たく見えて、手の中に四角いチョコレートミルクのパックを持っていて、ストローを挿んで飲んでいます。他に言っていないことはあなたに任せます!\n\nhttps://drive.google.com/drive/folders/1OAJVkBIQDc_oVy2qZzM8QRSm2TWOF0H3", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/17", "thumbnail_src": "https://si.imgix.net/bd47403d/uploads/origins/a0fb657c-8b4b-4f78-86e1-4cf4b921afbc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=55bf3a364823b2681da25520d6aec8e1", "thumbnail_srcset": "https://si.imgix.net/bd47403d/uploads/origins/a0fb657c-8b4b-4f78-86e1-4cf4b921afbc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=55bf3a364823b2681da25520d6aec8e1, https://si.imgix.net/bd47403d/uploads/origins/a0fb657c-8b4b-4f78-86e1-4cf4b921afbc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c69962d5a4a1cd98260e8fd094f1bcf0 2x, https://si.imgix.net/bd47403d/uploads/origins/a0fb657c-8b4b-4f78-86e1-4cf4b921afbc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=42d16c2ad93270c32225a921a59e223e 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは。どうぞご自由に僕の子猫を描いてください。\n腹掛けに関連するテーマだと嬉しいです。ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1ll4BraQaxZ42Sxu2p_UJ2zLnDJ_yb2uu", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/16", "thumbnail_src": "https://si.imgix.net/01e4f585/uploads/origins/5f641782-f5bd-4e83-8c23-e764589f8261?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=675616e6d8f882b20ffad96369668ced", "thumbnail_srcset": "https://si.imgix.net/01e4f585/uploads/origins/5f641782-f5bd-4e83-8c23-e764589f8261?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=675616e6d8f882b20ffad96369668ced, https://si.imgix.net/01e4f585/uploads/origins/5f641782-f5bd-4e83-8c23-e764589f8261?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e697853f5a07985937755a882aab262d 2x, https://si.imgix.net/01e4f585/uploads/origins/5f641782-f5bd-4e83-8c23-e764589f8261?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=83d890c0dd2a85a8cd7af6644ca99c49 3x", "genre": "art", "nsfw": false, "body": "こんばんは、 まめのさぶさん。\nテーマとか内容はすべておまかせでお願いしたいです。\nよろしくお願いします\n\n▽キャラクター資料\nリユ\n指は4本、足の指は3本でお願いします。\nうちの子かかけている手錠とか首輪は描かなくてもいいです。\n(状況によって自由に描いてください。構図やスタイルによっては翼を簡単に描いても大丈夫です。)\nhttps://drive.google.com/drive/folders/143cDiocWfSb0dbFLZjLVluX1rKrOOMqi?usp=drive_link\n\n▽使用用途\n個人鑑賞および友人への共有\nSNSへの投稿やヘッダー・アイコンとしての使用（使用時には作家様のお名前やIDを記載いたします）\n個人使用の範囲内でのグッズ制作（商用利用は絶対に行いません）", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/15", "thumbnail_src": "https://si.imgix.net/022a4a95/uploads/outputs/26e1273f-3d93-4602-9a16-11f76156731e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9f8ef29e2d1defc423c9b94bed72ac9", "thumbnail_srcset": "https://si.imgix.net/022a4a95/uploads/outputs/26e1273f-3d93-4602-9a16-11f76156731e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9f8ef29e2d1defc423c9b94bed72ac9, https://si.imgix.net/022a4a95/uploads/outputs/26e1273f-3d93-4602-9a16-11f76156731e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d8e7c83f9e3d177c78080e350adab53 2x, https://si.imgix.net/022a4a95/uploads/outputs/26e1273f-3d93-4602-9a16-11f76156731e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ef902789029aa79998ca3df554d7c9e 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/14", "thumbnail_src": "https://si.imgix.net/7c884846/uploads/origins/3cd79b60-ddc1-4e8a-a17a-f2027abf4348?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dd3653aa9677d5f286c26b0de6dafbef", "thumbnail_srcset": "https://si.imgix.net/7c884846/uploads/origins/3cd79b60-ddc1-4e8a-a17a-f2027abf4348?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dd3653aa9677d5f286c26b0de6dafbef, https://si.imgix.net/7c884846/uploads/origins/3cd79b60-ddc1-4e8a-a17a-f2027abf4348?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3277a4e492d0806bd108bec4a7817488 2x, https://si.imgix.net/7c884846/uploads/origins/3cd79b60-ddc1-4e8a-a17a-f2027abf4348?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=11b7f0d98e0ad46b0e5d3ff7a1d61536 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n先生のイラストの雰囲気と作画スタイルがとても好きで、ぜひ新しくイラストをお願いしたいと思っています。\n私のOCはオオカミのキャラクターで、可愛くて少しツンデレな表情を描いていただけると嬉しいです。\nご検討いただけましたら幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aC6zaOBKbN6BnFYnwVioMwxRwT4eSajb", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/13", "thumbnail_src": "https://si.imgix.net/4ff14856/uploads/origins/5e989d2e-7c65-4dde-815b-049affb098d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b5e6078debb9903ee71e1b29998f806", "thumbnail_srcset": "https://si.imgix.net/4ff14856/uploads/origins/5e989d2e-7c65-4dde-815b-049affb098d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b5e6078debb9903ee71e1b29998f806, https://si.imgix.net/4ff14856/uploads/origins/5e989d2e-7c65-4dde-815b-049affb098d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b70aae83f2debde4c69971866c74bddb 2x, https://si.imgix.net/4ff14856/uploads/origins/5e989d2e-7c65-4dde-815b-049affb098d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebd01a70c3080bb0f939393a2c8a8ce8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きなので、コミッションに応募することにしました！私のOCである2ipという名のアジェンダー・マシン・ゴーストを主人公にした作品をお願いしたいのですが、小さなネズミのゴーストを伴っています。片方の目は閉じたままで、もう片方は涙を流し続けています。あとは、あなたのクリエイティブな解釈にお任せしたいです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/11lIcGxW28BTDzsT8EYpxfe6jME5vDohT?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mnpkpkpk/works/12", "thumbnail_src": "https://si.imgix.net/421686df/uploads/outputs/3817bfbd-3fb6-484b-9922-72c9444772d8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a70b6c319c523aa6e4ea9867e85d6179", "thumbnail_srcset": "https://si.imgix.net/421686df/uploads/outputs/3817bfbd-3fb6-484b-9922-72c9444772d8?bg=%23ff