58cfdbdc1ce841eae 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1280143100472512512%2FNtPcAtBF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f6979f4187c70b40d77c26fc77eb044 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@callasoiled/works/35", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1280143100472512512%2FNtPcAtBF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc313bd5b7db56e4c4a7f6f3181451b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1280143100472512512%2FNtPcAtBF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc313bd5b7db56e4c4a7f6f3181451b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1280143100472512512%2FNtPcAtBF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63b2589c821e978787128fbf3964825d 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1280143100472512512%2FNtPcAtBF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7318b469edcadc6c54efa61be9ae973d 3x", "genre": "music", "nsfw": false, "body": "はじめまして、こんにちは！\n今回は、TRPGのオリジナルキャラクターに関する音楽を作って頂きたく、リクエストを送信します。\n【青色の子、赤色の子、二人のペアの曲の”３曲”】をお願いしたいです。\n\n【キャラクター詳細】\n■ディリ（青色）\n男性/175cmほど/27歳\n\n終末世界で、唯一生き残った最後の人類。\n世界を奪還するための軍にて、指揮官を務めている。\n生真面目で、律儀な性格。大きな使命感と責任を背負う孤独な人。\n大切なもの・大切な人を作らないようにしているだけで、実は優しくされるのに弱い。\n制御不能な部下のスカーの扱いに困りつつも、スカーのあらゆる強さに何度も救われている。\n\nイメージ曲\nhttps://www.youtube.com/watch?v=9xbT8OZcDJQ　\n\nーーーーーーーーーーーーーーー\n\n■スカー（赤色）\n男性/188cm/年齢不詳\n\nベルギー製のライフルが擬人化し、人間の姿形をしている存在。\n世界を奪還するための軍において、名実ともに最強の戦士である。\n快楽と娯楽のために生きている戦闘狂。制御不能な気分屋。\n人間のような感受性は薄く、あくまで武器としての振る舞いを重視する。\n最初は指揮官のディリに背いてばかりだったが、今で