%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ba9c63a8e63141b034757c3b5658756 2x, https://si.imgix.net/bcc868b6/uploads/origins/c21d7552-687d-4d1e-b7c2-92757699a4cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b39bc9ba71233fa80d7a6c737eeab758 3x", "genre": "art", "nsfw": false, "body": "初めまして、こんばんは！\nいつも青里みんと様のイラストを楽しみにしてます！\n\n・武器は無くて構いません。\n・背景、ポーズ等はみんとさんのお好きなように描いて頂けたらと思います！\n是非うちの子も可愛く描いていただけないでしょうか。\n\n各参考画像やSSです\nhttps://drive.google.com/drive/folders/1ka-PqIBHF-GW85lGEFtj-LzECO0fDX2R?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mito_sooooosu/works/95", "thumbnail_src": "https://si.imgix.net/26900ca1/uploads/origins/c22a9d3d-c4d9-4dc4-a8d5-566f2584f2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439d8aee93d14f164b8811da7ea35a45", "thumbnail_srcset": "https://si.imgix.net/26900ca1/uploads/origins/c22a9d3d-c4d9-4dc4-a8d5-566f2584f2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439d8aee93d14f164b8811da7ea35a45, https://si.imgix.net/26900ca1/uploads/origins/c22a9d3d-c4d9-4dc4-a8d5-566f2584f2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3715fd587d2cdaa8f0c5af953f93730 2x, https://si.imgix.net/26900ca1/uploads/origins/c22a9d3d-c4d9-4dc4-a8d5-566f2584f2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b26705571ffb0be1ba3f4a65caff080e 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの絵が好きです！\n\n私もオリジナルキャラクターを描いてみたいです。(https://postimg.cc/bZBYjgs5)\n\n衣装黒いランジェリー (https://postimg.cc/Wq49bFNT)\n\nその他の詳細はお任せします。\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@mito_sooooosu/works/94", "thumbnail_src": "https://si.imgix.net/9e978445/uploads/origins/74498552-3860-499f-858b-c4c7ff9765b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bab7edbb747f6e134f83de095cdba78", "thumbnail_srcset": "https://si.imgix.net/9e978445/uploads/origins/744985