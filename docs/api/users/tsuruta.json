5d-53d4-4996-9234-8aeedf6c5e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e40452201c871437cd1b9356d83d6a41 2x, https://si.imgix.net/9eba6312/uploads/origins/2b64c05d-53d4-4996-9234-8aeedf6c5e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b699e1fbfd41d8d81d3dc6cd4e2c7ec0 3x", "genre": "art", "nsfw": true, "body": "つるたさん！\n資料にあります三面図の子のイラストを描いてほしいです\n\n自撮り写真は雰囲気のために入れてます、服装は三面図のものでお願いします\n\n構図：枕を抱っこして眠そう、胸元の服がはだけて大胆に胸が見える感じ\nあとはつるたさんの好きなように欲望をぶつけていただきたいです、だいぶえっちにしてください\nいただいたイラストはSNSのアイコンやヘッダーで使用します\n\nhttps://drive.google.com/drive/folders/1FRIbKbJ-mZDcpDsS4dp6rgmdk5oaF03b?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/51", "thumbnail_src": "https://si.imgix.net/26e6500b/uploads/origins/9687c5d7-2b1c-48c6-9cf9-42db4e964039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66d17ec9fe5d71282a6960dab49f5caa", "thumbnail_srcset": "https://si.imgix.net/26e6500b/uploads/origins/9687c5d7-2b1c-48c6-9cf9-42db4e964039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66d17ec9fe5d71282a6960dab49f5caa, https://si.imgix.net/26e6500b/uploads/origins/9687c5d7-2b1c-48c6-9cf9-42db4e964039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c925377824e8da6132b1d44be009be4f 2x, https://si.imgix.net/26e6500b/uploads/origins/9687c5d7-2b1c-48c6-9cf9-42db4e964039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=952d0f793d18d6a09128e2dde3e77438 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/50", "thumbnail_src": "https://si.imgix.net/78d6e442/uploads/origins/8c633b13-5e3f-49e1-bd14-d16a4c7e62cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c807b679cc943b896506e08ad3fa2f1c", "thumbnail_srcset": "https://si.imgix.net/78d6e442/uploads/origins/8c633b13-5e3f-49e1-bd14-d16a4c7e62cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c807b679cc943b896506e08ad3fa2f1c, https://si.imgix.net/78d6e442/uploads/origins/8c633b13-5e3f-49e1-bd14-d16a4c7e62cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b590256e53ea151113abe209c19cff14 2x, https://si.imgix.net/78d6e442/uploads/origins/8c633b13-5e3f-49e1-bd14-d16a4c7e62cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0e484dffc1c0e3aa05ccf964b4cc461 3x", "genre": "art", "nsfw": false, "body": "「櫻花さん(@mana_ouka)」を描いていただきたいです。\n彼女は\nFesti-Bar 「Do Now」(@festibar_donow)\nで歌を披露するシンガーさんです。\n歌謡曲、アニメソング、民謡、ロック、メタルなどなど、ジャンルは幅広いです。\n\n性格はおっとり穏やかです。\n\n\n普段はお着物を着ていらっしゃいますが\n今回は、資料の金魚をモチーフとしたドレス姿をお願いします。\n\n構図としては、こちらを向いて歌を歌う様子をお願いします。\nもしくは\n衣装が金魚モチーフですので、水中でドレスをふわふわさせながら浮いている姿も良いと思います。\nその他、これに囚われず自由に描いて頂いても問題ありません。\n\nSNSへの投稿\nSNSでのアイコン利用\nVRCでのアイコン使用\nVRCのワールドへの展示\n所属イベントの告知への利用\nの許可を\n私鈴蘭と櫻花さんに欲しいです\n\n\n資料\nhttps://drive.google.com/drive/folders/16jjtsBendL8Mqk34KV6xVRZU2Tha5mj0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/49", "thumbnail_src": "https://si.imgix.net/f182b275/uploads/origins/d271d9ce-7acb-41ad-ae56-6733a17cd56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3073eb011c550d30c2e4559f9eb5c854", "thumbnail_srcset": "https://si.imgix.net/f182b275/uploads/origins/d271d9ce-7acb-41ad-ae56-6733a17cd56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3073eb011c550d30c2e4559f9eb5c854, https://si.imgix.net/f182b275/uploads/origins/d271d9ce-7acb-41ad-ae56-6733a17cd56c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be97db0e846f00bfb6bcda2c0a105e61 2x, https://si.imgix.net/f182b275/uploads/origins/d271d9ce-7acb-41ad-ae56-6733a17cd56c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72bc91bd9b164becd7d7a2f45f993560 3x", "genre": "art", "nsfw": false, "body": "（再送リクエスト、ありがとうございます！）\n\n鶴田文学先生\n\nいつもお世話になっております。\nやくもと申します。\n\n今回はVRChatのフレンドのneika2さんのイラスト作成をご依頼させていただきたく、\nご連絡させていただきました。\n\n資料の画像のアバターと服（うさぎさんるーむうぇあの姿、猫耳はレイヤー分けしていただけると助かります！！）\nで、笑顔でピースをしているイラストと、\n可能であれば中指を立てている差分（指先にモザイクがかかっていると嬉しいです…！）を\nお願いできますでしょうか。\n\nまた、いただいたイラストは、twitterやDiscordヘッダやアイコンなどに使用することを、\n自分とご本人（neika2さん）に対して許可していただけますと幸いです。\n\nお忙しいところ恐れ入りますが、ご確認とご検討をよろしくお願いいたします。\n\n資料URL：\nhttps://drive.google.com/drive/folders/1JrwwweGBX8qy0Cp6vU8hjGiy_KhHVo6J?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/48", "thumbnail_src": "https://si.imgix.net/00ae42d8/uploads/origins/7d3b3ab2-eec4-4659-81de-2d0005d92019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87ab2debffa0e92d5ab4241491173a27", "thumbnail_srcset": "https://si.imgix.net/00ae42d8/uploads/origins/7d3b3ab2-eec4-4659-81de-2d0005d92019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87ab2debffa0e92d5ab4241491173a27, https://si.imgix.net/00ae42d8/uploads/origins/7d3b3ab2-eec4-4659-81de-2d0005d92019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e47b8a371477e0235fdd732958ab5bc 2x, https://si.imgix.net/00ae42d8/uploads/origins/7d3b3ab2-eec4-4659-81de-2d0005d92019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c22b3855bbbba12d4f7f98ae8eadfb2d 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nVRChatにて私が使用しているアバターのイラストをお願いしたいです。\n\n【内容】\nポーズ、構図はおまかせします。\n扇情的な雰囲気で色気が出ていると嬉しいです。\n背景、宛名等はレイヤー分けしてPSDファイルで納品いただけると助かります。\n\n使用用途はSNS掲載、VRChatのワールド内に展示等個人利用する可能性があります。\nよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/kcws3d42j2rf2ka4ngb8h/AHqqk0U_E2jvG5lZdQky84Y?rlkey=cw6b0sptp88xq7094ilishdvt&st=dqdcdjmw&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/47", "thumbnail_src": "https://si.imgix.net/76ea0aad/uploads/origins/d31590a4-45e9-4321-a730-15996f953010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c51668c6e9ae0ab618086fe54f6dceaf", "thumbnail_srcset": "https://si.imgix.net/76ea0aad/uploads/origins/d31590a4-45e9-4321-a730-15996f953010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c51668c6e9ae0ab618086fe54f6dceaf, https://si.imgix.net/76ea0aad/uploads/origins/d31590a4-45e9-4321-a730-15996f953010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ced965343adcfc4eaaad07c1d5886f67 2x, https://si.imgix.net/76ea0aad/uploads/origins/d31590a4-45e9-4321-a730-15996f953010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c55482cc505383371480c7da12d41a1b 3x", "genre": "art", "nsfw": true, "body": "こんにちは\nゼブラココと申します。\n\nVRchatの僕のフレンドのMALOSIONさん(https://x.com/06_2788?s=21)のアバターを描いていただきたいです\n\n身長は2.4mで、髪色が非常に綺麗なのと、お顔が本当に良いです。\n身体つきはむちむち！ではなく、すらっと高身長といった感じです。\n上位存在感というか、少し人間離れしたような、少し怪しげな雰囲気というか、油断すると食べられてしまうような、向こうにとっての遊びで一般人は死にかけるような、そんな雰囲気をそこはかとなく漂わせています。\n\n表情は笑顔でお願いします！\n髪色に力を入れていただけると嬉しいです！！\n\nSNSへの投稿 SNSでのアイコン利用 VRCでのアイコン使用 VRCのワールドへの展示 の許可を私ゼブラココとMALOSIONさん双方に欲しいです\n\nhttps://drive.google.com/drive/folders/1OrJdAlv1B1hWgplgiPp5OC1R2r9QZ3rK?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/46", "thumbnail_src": "https://si.imgix.net/47f7e495/uploads/origins/2c999f9c-bb11-4da7-8bb7-b5e646b7eaa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d775c2896ddb557a09434f076bfa81e5", "thumbnail_srcset": "https://si.imgix.net/47f7e495/uploads/origins/2c999f9c-bb11-4da7-8bb7-b5e646b7eaa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d775c2896ddb557a09434f076bfa81e5, https://si.imgix.net/47f7e495/uploads/origins/2c999f9c-bb11-4da7-8bb7-b5e646b7eaa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fb4ed4db624f6401e74c3b4c09c6a56 2x, https://si.imgix.net/47f7e495/uploads/origins/2c999f9c-bb11-4da7-8bb7-b5e646b7eaa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c9ac20fbce1705e3addbc89164f94c3 3x", "genre": "art", "nsfw": false, "body": "鶴田文学先生、こんにちは。\n\nManononnと申します。\nこのたび、私がVRChatで使用しているアバターのイラスト作成をお願いしたく、ご依頼させていただきました。\n\n構図やシチュエーションは、もし可能であれば以下の通りでお願いしたく存じます。\n\nシチュエーション：おうちデートで、ベッドの上でお話しをしている場面\n構図：クッションを背にベッドに足を伸ばして座り、こちらを見て微笑んでいる\n\nまた、いただいたイラストはSNSのアイコンやヘッダーなどに使用させていただきたく、\nその際の使用許可をいただけますと幸いです。\n\nお忙しいところ恐れ入りますが、ご検討のほど、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gkk7Fxh1p1ZvbR-LtwAozCey4uGmRnmG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tsuruta/works/45", "thumbnail_src": "https://si.imgix.net/5bb1f28d/uploads/origins/0b5bc385-f97b-4197-a95d-9d750c648b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8591d396c3300fe0d26a1fc2b5fddbd3", "thumbnail_srcset": "https://si.imgix.net/5bb1f28d/uploads/origins/0b5bc385-f97b-4197-a95d-9d750c648b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8591d396c3300fe0d26a1fc2b5fddbd3, https://si.imgix.net/5bb1f28d/uploads/origins/0b5bc385-f97b-4197-a95d-9d750c648b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dd63eb358e9469723b7475880daf6e2 2x, https://si.imgix.net/5bb1f28d/uploads/origins/0b5bc385-f97b-4197-a95d-9d750c648b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5385375606ef5ff168b53dbd557b9216 3x", "genre": "art", "nsfw": false, "body": "こんにちは。なっつと申します。\n\nいつも可愛らしいイラスト拝見させていただいております。\nこの度は、私のVRchatで使用しているアバターのイラストを描いていただきたくリクエストを送らせていただきました。\n\n～依頼内容～\n・URLの資料にあるアバターを描いていただきたいです。\n・資料にも入れましたが胸にホクロがあります。\n・構図、背景はお任せしますが、少しお姉さん感が出ていると尚良いです。\n\n頂いたイラストは自作ホームワールドへの展示、X（旧Twitter）への投稿、アイコン、ヘッダー、VRCのア