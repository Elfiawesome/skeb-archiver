aaa21e53/uploads/origins/b4847f73-95af-4d21-bb13-58fecfcde114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9bddb8b3cb5b959f95accbf5792fdcd", "thumbnail_srcset": "https://si.imgix.net/aaa21e53/uploads/origins/b4847f73-95af-4d21-bb13-58fecfcde114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9bddb8b3cb5b959f95accbf5792fdcd, https://si.imgix.net/aaa21e53/uploads/origins/b4847f73-95af-4d21-bb13-58fecfcde114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=957a344e658ad2c7c544665e60615675 2x, https://si.imgix.net/aaa21e53/uploads/origins/b4847f73-95af-4d21-bb13-58fecfcde114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0b0020624ff4dc421795bb7e75ad3b6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mr_Bidarudo/works/19", "thumbnail_src": "https://si.imgix.net/d79194c1/uploads/origins/aa2a30bf-7177-4fb2-95f7-53d6dc201f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79e88347e901fa6c281fea0d63381478", "thumbnail_srcset": "https://si.imgix.net/d79194c1/uploads/origins/aa2a30bf-7177-4fb2-95f7-53d6dc201f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79e88347e901fa6c281fea0d63381478, https://si.imgix.net/d79194c1/uploads/origins/aa2a30bf-7177-4fb2-95f7-53d6dc201f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a54fe76bd2d06486128603c7905afb01 2x, https://si.imgix.net/d79194c1/uploads/origins/aa2a30bf-7177-4fb2-95f7-53d6dc201f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=462ab6dec3a8e28c66cde40b87f42c9f 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしいおねショタイラストをありがとうございました！\nぜひまた描いていただきたく、依頼させていただきます。\n\n依頼の内容ですが、今回もまたポケモンのクララのおねショタを描いていただきたいです。ショタは可愛い系のモブショタで、前回頂いたイラストとは別のキャラっぽい見た目でお願いしたいです。\n\n雰囲気としてはエリートっぽいショタに唾つけとこうとお誘いしたクララがショタの無尽蔵の性欲にへろへろになるまで付き合わされる、みたいな感じでお願いしたいです。ショタが上位になっているのではなく、あくまでクララのことが好きすぎて歯止めがきかなくなっているみたいな感じでお願いします。\n\n構図については、また他の絵師様の作品で申し訳ありませんが（https://www.pixiv.net/artworks/73830383）のような形でお願いしたいです。ショタは参考作品のように快感で腰が止まらない感じで、クララは「こいつまだ満足しないのかよ……」って心の中で思いながらも、自分もしっかり感じていて、ショタの事を好きになってきているみたいな感じで、台詞を入れていただけると嬉しいです。\n\n可能でしたらショタの顔や体に赤い口紅（クララがしているもの）のキスマークを付けて頂きたいです。背景も、二人の周りにティッシュや使用済みのコンドームが散乱していて、ゴムがなくなったので生でしている、みたいな雰囲気を出していただけると嬉しいです。\n\n今回も可能であれば前回（https://skeb.jp/@Mr_Bidarudo/works/14）のような形でコマ割りしていただき、事後にキスを求めてくるショタを受け入れて完全に恋に落ちてしまうクララみたいなシーンもお願いしたいです。\n\n前回にも増して注文が多く申し訳ありませんが、どうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Mr_Bidarudo/works/18", "thumbnail_src": "https://si.imgix.net/5057bbd7/uploads/origins/559776ec-7320-46e5-a8de-81e79c968cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc11c2b5dc6ff58a798ca39ddee73b8", "thumbnail_srcset": "https://si.imgix.net/5057bbd7/uploads/origins/559776ec-7320-46e5-a8de-81e79c968cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc11c2b5dc6ff58a798ca39ddee73b8, https://si.imgix.net/5057bbd7/uploads/origins/559776ec-7320-46e5-a8de-81e79c968cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4342f9dcbf587a5d329d0ad62def05c7 2x, https://si.imgix.net/5057bbd7/uploads/origins/559776ec-7320-46e5-a8de-81e79c968cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9a2a98e1337a83f950ddfd610839a3b 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品を見させて頂いております。以前、ヒラリの依頼をさせて頂いた者です。\n\n今回の依頼なのですが、\n\nキャラ\nイナズマイレブンGO2のベータ\n\nシチュエーション\nプロトコルオメガ2.0戦にて、マインドコントロール機能を使用され、観衆の目の前で天馬を化身アームド中のベータがガニ股騎乗位で搾り取る。\n(前回と似たような感じですみません。)\n\n※もし宜しければ、押し倒して挑発、挿入前、挿入後、ピストン中、中出しフィニッシュとお手数をお掛けいたしますが差分シーン分けをお願いします。\n\n※最初から気性粗めベータでお願いします。\n\n※可能ならば、カットインでひょっとこフェラ(目より下)を描いて頂きたいです。\n\n※各シーンに台詞と擬音を書いて頂きたいです。\n\n※「押し倒して挑発」の時まで、股間はアームド衣装で覆われており、(アソコは透け透け)、「挿入前」の時はアソコの部分だけが露出して見せつける感じでお願いします。(可能なら台詞で「試合中、ずっとココが疼きまくってたんだぜぇ…」みたいな台詞を入れて欲しいです。)\n\n※ベータの衣装は全体的にピチピチな感じでお願いします。(可能な範囲で)\n\n※天馬のユニフォームは殆ど脱がされている感じでお願いします。\n\n※天馬の顔は特に描かなくても宜しいです。\n\n※ベータの胸はかなり巨乳めで乳首透けでお願いします。\n\n※可能ならば、アームド衣装と裸の差分をお願いします。\n\n※断面図と着床表現(卵子の中に精子が入り込んでしまう感じ)をお願いします。\n\n今回も多めの要望となってしまいましたが、こちらの内容で宜しければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Mr_Bidarudo/works/17", "thumbnail_src": "https://si.imgix.net/ca80c45f/uploads/origins/de829131-269b-4b4a-bb74-114fb0c7c695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a329b6b63a49523045bbd37010deda2", "thumbnail_srcset": "https://si.imgix.net/ca80c45f/uploads/origins/de829131-269b-4b4a-bb74-114fb0c7c695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a329b6b63a49523045bbd37010deda2, https://si.imgix.net/ca80c45f/uploads/origins/de829131-269b-4b4a-bb74-114fb0c7c695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03d1d122abfa7c6c264ceaccb95dda1a 2x, https://si.imgix.net/ca80c45f/uploads/origins/de829131-269b-4b4a-bb74-114fb0c7c695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a5c4a1011bd5de4b98217cabade25d0 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n好んでいたアプリにサ終の通告がきましたのでご存じないとは思いますがリクさせていただきたいです。\n\nキャラ名.作品名 アンジュ・ヴィエルジュ.アクエリア\n\nキャラ説明.とある博士に作られたアンドロイド、ある理由で捨てられてしまい孤独の身で主人公たちと出会い居場所(風紀委員会)を見つけるという感じの生い立ちです。\n(巨乳は設計者の趣味)\n\nシチュエーション.捨てられてすぐにショタに見つかり助けられてエッチなお願いをされてしまう。\nアクエリアは自分が必要とされることが嬉しくて喜んでご奉仕するという関係が続いていたが…拾ってくれたショタが虐められており、その子を守るためクソガキたちに身体を差し出すことに…\n\n\n台詞イメージ(ショタにご奉仕)\n\nシ.ア、アクエリアお姉ちゃん…きもちいいよぉ…///\n\nア.喜んでいただけたようで良かったです。これでご主人さまは私のことを捨てないでいただけますか…？\n\nシ.アクエリアお姉ちゃんを捨てるわけないよ！！\n…だってぼくアクエリアお姉ちゃんのこと大好きだもん\n\nア.…ありがとうございます。これからも私、全身全霊でご主人様に尽くします…♡\n\nシ.お姉ちゃん…つ、次はおっぱいもんでもいい？\n\nア.はい♪それでご主人さまが満足してくれるなら…♡\n\nクソガキ輪姦\n\nク.うお…！！このアンドロイドおっぱいでっか！！○○のくせに生意気だ！\n\nシ.や、やめてよ…アクエリアお姉ちゃんをいじめないで…\n\nク.ほらほら、アクエリアさんはお前がいじめられないためにやられてんだぜ？ちゃんと見ないとダメだろw\n\nア.あっ…ああん…♡ご主人さまぁ…♡見ないでください…////\n\nク.次はおれの番だぞ！早く使わせろよ〜\n\nク.おっぱいもんでるだけでもちんちんいたくなってくる…w\n\nシ.(アクエリアお姉ちゃん‥ぼくがしてる時と違う顔してる…どうして…？)\n\nア.(私を拾ってくださった…ご主人さまの前なのに…このままでは…私…堕とされてしまいます…♡♡♡)\n\n台詞はイメージですのでビダルド様のやりやすいよう改変等していただいて大丈夫です。\n\n自分を拾ってくれたショタへの奉仕で喜ぶアクエリアと守るために無理矢理され…悔しいけども乱暴な攻めに感じてしまうアクエリアの対比をイメージしております。\n\n詳細\nアンドロイド娘ですが膣内とかおっぱいとかをそれらしくする必要はないです。\n\n輪姦されてるところでぶっかけられてるとこがあれば嬉しいです。\n\n服装は可能であれば資料内の制服を適度に脱がされたものでお願いしたいです。(胸部分についてる赤いマークは無いものとして見てください)\n\n金額的に難しいようでしたらクソガキに輪姦されてるパターンだけで大丈夫です。\n\nhttps://livedoor.blogcms.jp/lite/blog/agurin3/\n↑はアクエリアちゃんの口調等のデータをまとめてるファイルなので性格等の把握によろしければご覧ください。\n\n存じ上げない作品のため難しいとは思いますが彼女の肉感がビダルド様の絵にピッタリだと感じ投げさせていただきました。\nご検討のほどよろしくお願いいたします。\n\nhttps://mobile.twitter.com/angevierge_pr/status/746266808827715584", "created_at": "", "completed_at": ""}, {"path": "/@Mr_Bidarudo/works/16", "thumbnail_src": "https://si.imgix.net/b9f58a0a/uploads/origins/e7457a88-be64-4b31-ae57-1c4657c3053e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b37d150bac64ba4c85b6e006188abc9", "thumbnail_srcset": "https://si.imgix.net/b9f58a0a/uploads/origins/e7457a88-be64-4b31-ae57-1c4657c3053e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b37d150bac64ba4c85b6e006188abc9, https://si.imgix.net/b9f58a0a/uploads/origins/e7457a88-be64-4b31-ae57-1c4657c3053e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a0cc827afa4e93e0810d445d70672c1 2x, https://si.imgix.net/b9f58a0a/uploads/origins/e7457a88-be