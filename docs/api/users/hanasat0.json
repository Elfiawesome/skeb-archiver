2ec-07caf18a365e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c9851a6f3c52bec67bc6c32b5ffcb63, https://si.imgix.net/4b3eb492/uploads/origins/8f04a9ad-a2e3-4080-82ec-07caf18a365e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4c9885542f01d3272eefc7f1ccfcc16 2x, https://si.imgix.net/4b3eb492/uploads/origins/8f04a9ad-a2e3-4080-82ec-07caf18a365e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6730f8b02a774a5c8b0ee60c2a06d8f7 3x", "genre": "art", "nsfw": false, "body": "花郷様、初めまして！Duskitarと言います。\n貴方のイラストがとても好みでしたので、メッセージに来ました。\n突然で申し訳ないのですが、私のオリジナルキャラを描いていただけないでしょうか？\nもし宜しければ、【部屋にいる二人は、男性キャラは楽しそうに飲んでいるのに、女性キャラは泣いている、】その様子をお願いしたい。\nキャラクター設定や参考は、【そこのgoogledrive: https://drive.google.com/drive/folders/1hvhP0PfHRtDp0J_-Aqes1F6J_vwCSFqT?usp=sharing】にあります。お役に立ててのはなによりです。\n特に、こちらのイラストがとっても好きなので、近い雰囲気だと嬉しいです:https://twitter.com/hanasat0/status/1538855120187707392\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hanasat0/works/18", "thumbnail_src": "https://si.imgix.net/6cedae0d/uploads/origins/41392c63-9ce6-4f7e-956e-e4091363cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3052a51bf6ea6bc2cd4f120a5cb7ae20", "thumbnail_srcset": "https://si.imgix.net/6cedae0d/uploads/origins/41392c63-9ce6-4f7e-956e-e4091363cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3052a51bf6ea6bc2cd4f120a5cb7ae20, https://si.imgix.net/6cedae0d/uploads/origins/41392c63-9ce6-4f7e-956e-e4091363cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57d894a6fd5485390714e7ecfd3c4d03 2x, https://si.imgix.net/6cedae0d/uploads/origins/41392c63-9ce6-4f7e-956e-e4091363cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05d4c6e871f9038a3e452c021c5e7554 3x", "genre": "art", "nsfw": false, "body": "こんにちは。以前からあなたの絵に憧れていました!\n私の友人と私のオリジナルキャラクターの絵をお願いしたいです。\n\nこの2人はカップルです！\n男性は:\n=174cm\n=クーデレや温かいな性格で、紳士な人。コーヒーをよく飲む。イメージ色は赤\n\n女性は:\n=156cm\n=ふわふわやデレデレな女、プリンと花が大好き！イメージ色はピンク。\n\nキャラシ：https://sta.sh/21ekw2i00jo8\n\nポーズはご自由にお選びください～　ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@hanasat0/works/17", "thumbnail_src": "https://si.imgix.net/b57a6b55/uploads/origins/83afc8a1-a3cb-405b-a08a-92f5d0aecb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ceb58a47f210b8a3184a8f246053c07", "thumbnail_srcset": "https://si.imgix.net/b57a6b55/uploads/origins/83afc8a1-a3cb-405b-a08a-92f5d0aecb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ceb58a47f210b8a3184a8f246053c07, https://si.imgix.net/b57a6b55/uploads/origins/83afc8a1-a3cb-405b-a08a-92f5d0aecb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00666dedc7baccc70ff1d52dda59fdd8 2x, https://si.imgix.net/b57a6b55/uploads/origins/83afc8a1-a3cb-405b-a08a-92f5d0aecb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a674f0f4612678c97b59c7f4afcb9a3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hanasat0/works/16", "thumbnail_src": "https://si.imgix.net/4a94c14b/uploads/origins/f88feaf3-ca5a-43de-ac4a-95c4486fe164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b344cf3c5e7296bc45b1672e1261da84", "thumbnail_srcset": "https://si.imgix.net/4a94c14b/uploads/origins/f88feaf3-ca5a-43de-ac4a-95c4486fe164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200