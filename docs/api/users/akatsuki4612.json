ins/4c9773a1-45d4-4a88-bf3d-f01fc6eeb131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42757096cc091ea0618751675f61effa", "thumbnail_srcset": "https://si.imgix.net/2e8cd605/uploads/origins/4c9773a1-45d4-4a88-bf3d-f01fc6eeb131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42757096cc091ea0618751675f61effa, https://si.imgix.net/2e8cd605/uploads/origins/4c9773a1-45d4-4a88-bf3d-f01fc6eeb131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a67b10dfa17430e37fb2dc30dccf8f3 2x, https://si.imgix.net/2e8cd605/uploads/origins/4c9773a1-45d4-4a88-bf3d-f01fc6eeb131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8bae426ee3e423ae92459df9bd5d96e 3x", "genre": "art", "nsfw": false, "body": "以下のような感じの服装、モノクルで描いてほしいです。\nhttps://drive.google.com/file/d/1tLj4CWZ1-boxz5Ru4Za8xRbqR_ucT0YG/view?usp=drive_link\n\n以下補足です。\n・目の色は青色系\n・帽子の歯車などは、スチームパンク系でいい感じに\n・パイプは、ワンピースのサボが持っている感じに\n・ポーズなどはお任せします。\n\nサイズ\n・3840x2160（px）\n\nその他\n・背景無しの透過png or psdファイルをいただけるならいただきたいです。.\n\nhttps://drive.google.com/file/d/1tLj4CWZ1-boxz5Ru4Za8xRbqR_ucT0YG/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@akatsuki4612/works/8", "thumbnail_src": "https://si.imgix.net/2c5b4cfb/uploads/origins/355438e5-c4fb-4b22-aae6-8670d04d3789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7616018c844ebbcd17e87fe3f4754080", "thumbnail_srcset": "https://si.imgix.net/2c5b4cfb/uploads/origins/355438e5-c4fb-4b22-aae6-8670d04d3789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7616018c844ebbcd17e87fe3f4754080, https://si.imgix.net/2c5b4cfb/uploads/origins/355438e5-c4fb-4b22-aae6-8670d04d3789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae1010bc920269f31aadfd31ce25a1f5 2x, https://si.imgix.net/2c5b4cfb/uploads/origins/355438e5-c4fb-4b22-aae6-8670d04d3789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop