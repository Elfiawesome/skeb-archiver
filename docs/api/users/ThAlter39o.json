xtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e689737c1202720b540be9e44b3e6ba5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/681", "thumbnail_src": "https://si.imgix.net/82da5b6e/uploads/origins/8026833e-d264-4cfe-8d9d-d3d8aedaa31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962ad4d0f46ced80a3aa3d1f715f6a12", "thumbnail_srcset": "https://si.imgix.net/82da5b6e/uploads/origins/8026833e-d264-4cfe-8d9d-d3d8aedaa31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962ad4d0f46ced80a3aa3d1f715f6a12, https://si.imgix.net/82da5b6e/uploads/origins/8026833e-d264-4cfe-8d9d-d3d8aedaa31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33c8ad64985296e734b5c3ae13a268bb 2x, https://si.imgix.net/82da5b6e/uploads/origins/8026833e-d264-4cfe-8d9d-d3d8aedaa31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9c053a81d4208a97d5daa08967f580d 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします！\nToLOVEるのヤミというキャラが戦闘に負けて拘束されるというシチュのリクエストとなります。\n流れとしては、\nhttps://x.com/haimei1980/status/1868457342360330241?s=46&t=FtimtErh6ACQATSqoAa2_w\nこちらのイラストと同じ様に台に拘束されて、ボールギャグを噛まされているヤミが『ん…ここは…』みたいな形で目を覚ます。服装はなんでも構いませんので普段の服装で足は裸足。→拘束されている現状を把握して、回想に入る→油断している隙をつかれて無力化されてしまう。→全身を拘束されて口枷と目隠しをされて施設に運ばれる。→回想が終わり拘束を解こうとしているところで敵の女科学者が入ってくる→ヤミが敵意丸出しで敵を睨むが科学者はそんな様子も可愛らしく感じている様子でヤミの剥き出しの足裏や乳首を優しく愛撫していく→屈辱で恥ずかしがるネメシスに更なる屈辱を与えるために別の拘束がされることに→\n以前先生が描かれていたこちら\nhttps://skeb.jp/@ThAlter39o/works/363\nのように拘束台に縛り付けられる。口にはボールギャグを装着したまま。→科学者に情けない体制を指摘されて、赤面しながら怒る。→カメラを設置されて今の状態を録画されることになり、赤面しながらボールギャグ 越しにもごもごと抗議する。\n\nといった内容です。\nよければよろしくお願いいたします🙇", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/680", "thumbnail_src": "https://si.imgix.net/a354072d/uploads/origins/0b9b7368-941e-48d4-9375-c3905ebef55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06454c681d50e71c9328d38a50e6326d", "thumbnail_srcset": "https://si.imgix.net/a354072d/uploads/origins/0b9b7368-941e-48d4-9375-c3905ebef55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06454c681d50e71c9328d38a50e6326d, https://si.imgix.net/a354072d/uploads/origins/0b9b7368-941e-48d4-9375-c3905ebef55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74fc3213d4ccb3dc300f564cb2e6de30 2x, https://si.imgix.net/a354072d/uploads/origins/0b9b7368-941e-48d4-9375-c3905ebef55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5a985156e9f4716a915f9173bb04c7a 3x", "genre": "art", "nsfw": true, "body": "前回のマミーごっこのリクエストをお引き受けいただきあｒがとうございました！今度は東方Projectの十六夜咲夜、パチュリー・ノーレッジ、紅美鈴と、小悪魔をお願いしたいです。\n\nシチュはこちら（https://x.com/IMBsengirls/status/2002399492247568864/photo/1）のようだ。「全身被った者を見て自分がこうなるのか思ってる」のコンセプトだ。\n\n拘束は口までテープマミフィケーションで、スリープサックと全頭マスクに被ってる。もう完全にスリープサックとマスクを被ってるのは小悪魔だけだから、ワイプとか名札のようなものを入れてくださると嬉しい。他の全員はまだマスク被ってないで、もがいてる小悪魔を不安げに見つめる。スリープサック被ってない２人は開いてるスリープサックに横たわっていて、１人はもうスリープサックに完全に被ってる。\n\n差分としては顔を覆うマミーでお願いします。\n\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/679", "thumbnail_src": "https://si.imgix.net/3ad0aa68/uploads/origins/24130a1c-9f54-468c-98ca-5a3bb9c3aa17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dc89fc73d0dcb531902d66733169237", "thumbnail_srcset": "https://si.imgix.net/3ad0aa68/uploads/origins/24130a1c-9f54-468c-98ca-5a3bb9c3aa17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dc89fc73d0dcb531902d66733169237, https://si.imgix.net/3ad0aa68/uploads/origins/24130a1c-9f54-468c-98ca-5a3bb9c3aa17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=187662e1197375fa7f2795f75d6e50fd 2x, https://si.imgix.net/3ad0aa68/uploads/origins/24130a1c-9f54-468c-98ca-5a3bb9c3aa17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d1cdf86315aaa08211dac7393858049 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/678", "thumbnail_src": "https://si.imgix.net/c39cd2ba/uploads/origins/b0c0129c-e543-4383-93ff-9455bd552453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9d842756bb039bf0349c210f8beca5", "thumbnail_srcset": "https://si.imgix.net/c39cd2ba/uploads/origins/b0c0129c-e543-4383-93ff-9455bd552453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9d842756bb039bf0349c210f8beca5, https://si.imgix.net/c39cd2ba/uploads/origins/b0c0129c-e543-4383-93ff-9455bd552453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=631e35615c7ee594dc29a5c1907e2960 2x, https://si.imgix.net/c39cd2ba/uploads/origins/b0c0129c-e543-4383-93ff-9455bd552453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=199e278678b55e338aaf2a5186820d82 3x", "genre": "art", "nsfw": true, "body": "東方Projectの藤原妹紅のラバー拘束衣化をお願いします。\n衣装は原作の衣装でお願いします。\n口も塞いでください。\n出来るなら全頭差分もお願いします。(最悪無くてもいいです)\n立っている状態でお願いします。\n背景は竹林にしてください。\n\nhttps://www.pixiv.net/artworks/108500916", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/677", "thumbnail_src": "https://si.imgix.net/68135c0c/uploads/origins/379d8c9c-1049-4f2c-b66d-6644baf29869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69270dbf2f3d46e30c580dc06ce4b537", "thumbnail_srcset": "https://si.imgix.net/68135c0c/uploads/origins/379d8c9c-1049-4f2c-b66d-6644baf29869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69270dbf2f3d46e30c580dc06ce4b537, https://si.imgix.net/68135c0c/uploads/origins/379d8c9c-1049-4f2c-b66d-6644baf29869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24de116bd358e65a60b1c97bacfd85c9 2x, https://si.imgix.net/68135c0c/uploads/origins/379d8c9c-1049-4f2c-b66d-6644baf29869?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bc74120cde4292c3e101ce578ec3a1f 3x", "genre": "art", "nsfw": true, "body": "リクエストをお願いします。\nONEPIECEのハンコックとマーガレットが蜘蛛糸で縛られマミフィケーションされるイラストです。口から下をぎっちりと縛られた2人がもがく姿を描いてもらえればと思います。\n\n縛られた2人はクモの巣の上に座ってもがく様子にしてほしいです。\n\nまた、スリラーバーク編の小さなクモ(スパイダーマウス)が、身動きできない2人を見て、笑ったり挑発してるような素振りを描いてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/676", "thumbnail_src": "https://si.imgix.net/589567b1/uploads/origins/44f16a9e-30bf-4abe-8887-4abfa2702ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4e29578a4af45b59600ed4be5b45f1", "thumbnail_srcset": "https://si.imgix.net/589567b1/uploads/origins/44f16a9e-30bf-4abe-8887-4abfa2702ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4e29578a4af45b59600ed4be5b45f1, https://si.imgix.net/589567b1/uploads/origins/44f16a9e-30bf-4abe-8887-4abfa2702ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2352872d507ce0f9e3343e94d349dc23 2x, https://si.imgix.net/589567b1/uploads/origins/44f16a9e-30bf-4abe-8887-4abfa2702ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b627d1412e441011d8b6073666c53b9 3x", "genre": "art", "nsfw": true, "body": "リクエストをさせて頂きます。キャラクターは、ドラゴンクエストのマーニャとゼシカとセティアで、蜘蛛糸で口から足先までをぐるぐる巻きにされるシチュエーションを希望します。\n\n3人とも蜘蛛糸で別々に縛られて座ったままもがく描写でお願いします。\n\n\nゼシカは後ろ手にされた指先が自由で、セティアの糸をほどこうとしている様子。\nセティアはゼシカに助けられながらもがく様子。\nマーニャはイライラして単独で力ずくにもがく様子でお願いします。\n\nよろしくお願いします。\n※リクエストを再送できなかったため、送り直しをさせて頂きます。", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/675", "thumbnail_src": "https://si.imgix.net/c35c7153/uploads/origins/0e494fd1-8ac2-43d8-9d18-357804d164d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=169861f908cad1be5ece25538b22c4eb", "thumbnail_srcset": "https://si.imgix.net/c35c7153/uploads/origins/0e494fd1-8ac2-43d8-9d18-357804d164d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=169861f908cad1be5ece25538b22c4eb, https://si.imgix.net/c35c7153/uploads/origins/0e494fd1-8ac2-43d8-9d18-357804d164d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1dae9a840abda43da03004f69058833 2x, https://si.imgix.net/c35c7153/uploads/origins/0e494fd1-8ac2-43d8-9d18-357804d164d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b6103c0c24e82c482baece08e412356 3x", "genre": "art", "nsfw": true, "body": "今回は『AMBITIOUS MISSION』の有瀬かぐやをお願いします。衣装は怪盗服。\nhttps://drive.google.com/drive/folders/1czXb7czxEa0JrI1qZORujEJEv4Iu7fbX?usp=sharing\nhttps://sagapla.net/works/ambitious/img/chara01_fashion1.jpg?20220224\n\n怪盗が捕らえられた後、拘束された状態で展示されているという設定。\n\n構図・ポーズ\n（https://www.pixiv.net/artworks/137618804）のようなポーズで、フレームバインダー拘束されている。\n\n希望差分\n・着衣・全裸・全身ラバー拘束\n・ブーツ・帽子・目隠しの有無差分\n\n詳しい部分はおまかせします。ご検討のほど、よろしくお願いいたします。\n\nhttps://sagapla.net/works/ambitious/", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/674", "thumbnail_src": "https://si.imgix.net/22dfa7ea/uploads/origins/47370785-f732-4eac-8c3f-5f13c850fe2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c03fab4101ac17633eb079c4a0e61dbd", "thumbnail_srcset": "https://si.imgix.net/22dfa7ea/uploads/origins/47370785-f732-4eac-8c3f-5f13c850fe2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c03fab4101ac17633eb079c4a0e61dbd, https://si.imgix.net/22dfa7ea/uploads/origins/47370785-f732-4eac-8c3f-5f13c850fe2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41f3bebded6c5ee977f84c3db5a141ac 2x, https://si.imgix.net/22dfa7ea/uploads/origins/47370785-f732-4eac-8c3f-5f13c850fe2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d8f6e5e2352751431bc85846cd0d956 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ恐縮ですがリクエストさせていただきます。原神の蛍にジェイド(https://www.pixiv.net/artworks/102190927)をマミフィケーションされるイラストをお願いしたいです。 https://skeb.jp/@ThAlter 39 o/works/435の続きです。材料はまだ白の包带です、でも今回は蛍の手が後ろに「コ」のように巻かれてす。そして足から口まで包带に巻かれているいるところです。足や体を曲げることが出来ないくらい何重も包带を巻かれて厚みがあるで、脚の隙間や身体の凹みが見えない感じでお願いします（包帯の幅はhttps://www.pixiv.net/artworks/125678339#mangaのP23-凝光と鏡流のイラストのような幅お願いしたいです）。两人は狭い棺に入ってくださいました（棺は閉じていますので、よろしければ透視効果を加えてください）。ジェイドは蛍を体の下に押しつけ、抱き枕のようにB蛍抱いています（https://www.pixiv.net/artworks/59321850ように、違のは足の部分もありますくださ）。てしでジェイドは蛍の顔にキスをしています。蛍は涙目で、セリフは「んッ///んぐぅぅ/////んんっ////」お願いします。よろしくをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/673", "thumbnail_src": "https://si.imgix.net/12a972bd/uploads/origins/fc0b966c-46b1-4641-a15c-da0262b5e98d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8b9d6dfccc51a9924e8cc61d5bb1fe5", "thumbnail_srcset": "https://si.imgix.net/12a972bd/uploads/origins/fc0b966c-46b1-4641-a15c-da0262b5e98d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8b9d6dfccc51a9924e8cc61d5bb1fe5, https://si.imgix.net/12a972bd/uploads/origins/fc0b966c-46b1-4641-a15c-da0262b5e98d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92fedded0efd912da9979b0a66029bf3 2x, https://si.imgix.net/12a972bd/uploads/origins/fc0b966c-46b1-4641-a15c-da0262b5e98d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d45e4bdc26acd2d84c4ebdd1aae9d975 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/672", "thumbnail_src": "https://si.imgix.net/d2609755/uploads/origins/52ccbfe6-a498-46a5-99a7-a6fb838648bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8498c5cb4ce9ebc1e135de3fb16fdf9e", "thumbnail_srcset": "https://si.imgix.net/d2609755/uploads/origins/52ccbfe6-a498-46a5-99a7-a6fb838648bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8498c5cb4ce9ebc1e135de3fb16fdf9e, https://si.imgix.net/d2609755/uploads/origins/52ccbfe6-a498-46a5-99a7-a6fb838648bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df1ca1a7e1e89fa22cf99de083570f38 2x, https://si.imgix.net/d2609755/uploads/origins/52ccbfe6-a498-46a5-99a7-a6fb838648bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab51f7a9e004a55a000c30bd19a184f3 3x", "genre": "art", "nsfw": true, "body": "アイドルマスターシャイニーカラーズの新しいユニット「I'm_a_Cutie_Finder」をお願いします。\n立ち位置的に左から、七草にちか、園田智代子、黛冬優子、鈴木羽那、\t大崎甜花の５人です。\n\n裏社会に誘拐され、客を楽しませるショーでテープマミーとしてステージに立たされている５人は鼻の下から全身をテープでぐるぐる巻き、また外観では全く分からないが乳首や股間に遠隔操作できる小型ローターをつけられている。一部のVIP客によって自由に振動を操作できるようになっており、強制的にもがく様子を楽しまされているという状況。\n５人のテープの色はユニット衣装に準じたもの（薄紫、薄緑、青緑、ピンク、薄橙）、横一列に並んでいて体は正面を向いている構図。\n髪飾りやフェイスペイントなど細部のアクセサリーの有無はお任せします。\n５人の表情は誘拐犯や大勢の客を睨んでいる、テープの締めつけに苦しんでいる、解こうと一生懸命にもがいている、不定期にくるローターの振動に怯えている、助けてほしいと求めているなど。\n加えて各々ローターを発動されて皆泣き顔になり嫌々に苦しんでいる、ごまかそうと全力でもがいている、絶頂しないように耐えている、耐えられず絶頂してしまうなど。\n\n１番の希望としてローター発動前後の５人の様子や表情を描いてほしいです。\nご都合よろしければ承認または金額の査定をお願い致します。\n\nhttps://pbs.twimg.com/media/G6LTFfBacAcC1DB?format=jpg&name=large", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/671", "thumbnail_src": "https://si.imgix.net/fbac27f5/uploads/origins/0021677c-50d3-40c8-afe7-c0962bd0eb44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49f77c552c3911ed8030fb9a42c749e1", "thumbnail_srcset": "https://si.imgix.net/fbac27f5/uploads/origins/0021677c-50d3-40c8-afe7-c0962bd0eb44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49f77c552c3911ed8030fb9a42c749e1, https://si.imgix.net/fbac27f5/uploads/origins/0021677c-50d3-40c8-afe7-c0962bd0eb44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10c6851ce6c74e0f2777d42fbe8dac38 2x, https://si.imgix.net/fbac27f5/uploads/origins/0021677c-50d3-40c8-afe7-c0962bd0eb44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b93570cb9a7b1ebccb8152e3ca2f718f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/670", "thumbnail_src": "https://si.imgix.net/021fa3f6/uploads/origins/3e6142a9-4e1a-48c3-857e-0096e6fb7ce3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4efb29004b5aec32ca34095fc7bbf731", "thumbnail_srcset": "https://si.imgix.net/021fa3f6/uploads/origins/3e6142a9-4e1a-48c3-857e-0096e6fb7ce3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4efb29004b5aec32ca34095fc7bbf731, https://si.imgix.net/021fa3f6/uploads/origins/3e6142a9-4e1a-48c3-857e-0096e6fb7ce3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=757bc5395ead54fd837884cf000da89e 2x, https://si.imgix.net/021fa3f6/uploads/origins/3e6142a9-4e1a-48c3-857e-0096e6fb7ce3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b076f94aa01847d4fee34f965cb38c29 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/669", "thumbnail_src": "https://si.imgix.net/348fa1e4/uploads/origins/2201b7a8-c894-4870-840c-1d33ccea1f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf16842b5efe15c2b3ef896eacb160c", "thumbnail_srcset": "https://si.imgix.net/348fa1e4/uploads/origins/2201b7a8-c894-4870-840c-1d33ccea1f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf16842b5efe15c2b3ef896eacb160c, https://si.imgix.net/348fa1e4/uploads/origins/2201b7a8-c894-4870-840c-1d33ccea1f86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aac53a3f18eab2bc7f670fb5f6ced31f 2x, https://si.imgix.net/348fa1e4/uploads/origins/2201b7a8-c894-4870-840c-1d33ccea1f86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26522584e225a72e2fb7c1710d2763a6 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n先日書いていただいたうちの子の御堂沙羅ちゃんでネタが浮かんだので再度依頼させてもらいます。\n\n演じたドラマの配役に見立ててピンチな目に遭うというコンセプトになります。\n\nドラマの設定\nタイトル（仮）：無国籍探偵エレナ\n内容：映画「ターミナル」をパクり…もといモチーフにしたドラマ作品。東西冷戦終結後、日本よりはるかに荒れた東欧の某国で探偵として活躍しているエレナ（演：御堂沙羅）が所用があって日本を訪れたところ、祖国でクーデターが発生。無国籍になってしまったため、やむを得ず日本の空港を拠点にして失せ物探しや迷子の捜索をメインの仕事としながらも、時にはハイジャックを未然に阻止したり、空港を舞台に繰り広げられる陰謀を阻止したりしていくアクション活劇。\nただし、無国籍という設定から悪役に捕まった時はわりと容赦なく亡き者にされそうになるため、ヒロピンシーンが何度か組み込まれている。そのシーンで「目覚めた」少年少女は多いとかなんとか。\n\n余談だが、東欧の某国出身というわりに沙羅がネイティブレベルに話せる外国語は英語のみのため、1話目のあいさつくらいでしかスラブ系の言語が出てこず、３話もすると設定を忘れたかのように流暢に喋るわ、漢字仮名交じりの掲示を読むなどしたため、放映当時はツッコミを呼びまくったという逸話を持つ。\n\nなお、沙羅（当時高校生）は企画段階で複数のヒロピンシーンがあることに惹かれて出演をほぼ即断。業界内では沙羅ちゃんなんかだして制作費回収できるのかよ…と訝しがられたが破格の条件で出ていたともっぱらの噂である。\n\n上記のドラマで性癖に目覚めた犯人がいろいろと拗らせた挙句、本当に沙羅を誘拐し、自宅で死にそうな目に遭わせているシーンを描いていただきたいです。\n\n服装は作中のエレナのコスプレをさせているという設定でお願いしたいですが、お任せしたいと思います。\n迷われるようでしたら、ドラマにも温泉回（水着回）があり、そこで来ていた水着でも着せていただければと思います。\n（ちなみに温泉がある空港は複数あるみたいです）\n\nベッドに大の字拘束か、SMルームにあるX字の磔台っぽいやつで立って拘束でお願いします。\n弱めの電マでじっくり責められていて顔を赤めながらも感じちゃってる表情にしてほしいです。\n背後や周囲にはドラマから抜粋したワンシーンやピンチシーンなどの画像を張り付けている感じにしてほしいです。\n\n差分として玩具を全開にしてビニール袋を被せた場面。\n上記から時間が過ぎて気絶しそうになっている場面をお願いします。\n\n特殊な依頼になりますがご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/668", "thumbnail_src": "https://si.imgix.net/1349a85b/uploads/origins/9715f49e-0ab1-4f9f-96a4-26edfb48ff04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aba3ad7e1d9294c6023d580140e45c94", "thumbnail_srcset": "https://si.imgix.net/1349a85b/uploads/origins/9715f49e-0ab1-4f9f-96a4-26edfb48ff04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aba3ad7e1d9294c6023d580140e45c94, https://si.imgix.net/1349a85b/uploads/origins/9715f49e-0ab1-4f9f-96a4-26edfb48ff04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=492496c58e7acd6f1c491941e5eb672d 2x, https://si.imgix.net/1349a85b/uploads/origins/9715f49e-0ab1-4f9f-96a4-26edfb48ff04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7372cb33e697ca5ea24a0ec7c00809e7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/667", "thumbnail_src": "https://si.imgix.net/8e41d0bd/uploads/origins/5d43e064-80e1-4a41-8f1a-84862682fdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75f544bdba6c2ac414ef745d190f0c8b", "thumbnail_srcset": "https://si.imgix.net/8e41d0bd/uploads/origins/5d43e064-80e1-4a41-8f1a-84862682fdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75f544bdba6c2ac414ef745d190f0c8b, https://si.imgix.net/8e41d0bd/uploads/origins/5d43e064-80e1-4a41-8f1a-84862682fdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81198b1375fcaac1cc34afa50bd48971 2x, https://si.imgix.net/8e41d0bd/uploads/origins/5d43e064-80e1-4a41-8f1a-84862682fdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07296af35465e9d231a7ce13b057fa85 3x", "genre": "art", "nsfw": true, "body": "服を奪われ成り代わられ、下着姿で緊縛監禁されるボア·ハンコック様の姿をお願いします！\n\n　 黒ひげ海賊団のカタリーナ·デボンに捕らわれた蛇姫様。\n　デボンのイヌイヌの実モデル九尾の狐の能力により、自分の姿に変身されてしまう 本来デボンの能力は衣服もコピーできるが嗅覚の鋭い蛇達を誤魔化す為に、蛇姫の匂いがある衣服を奪い取り成り代わる \n　そして下着姿にされた本物のハンコック様は厳重に緊縛され猿轡を噛まされ監禁される事になる \n　まず海楼石の手枷を後ろ手に填められ、そのまま縄で後ろ手亀甲縛り。両足は胡座をかかされそのまま海楼石の枷と縄で緊縛。\n　股間も股縄が施されている上、女のデリケートな部分に小さな海楼石の欠片を結んだ部分を当てられ固定\n　猿轡はOTN。鼻まで布が覆われ、呼吸さえも制限される　\n　しかも彼女の強さを警戒された為か、周りに海楼石の鎖や、特大ボールギャグ等の拘束具、更に何に使われたのか想像したくないような不潔そうな布が置かれ、蛇姫が暴れだしたら即座に緊縛と猿轡を強化するつもりなのがわかる\n\n　下着姿にされた上、大股を開いた胡座姿で縛られ猿轡まで噛まされるという女として屈辱的な扱いを受けた上、自身に成り代わった敵が好き放題にする事が許せず、海楼石で脱力しつつも汗を流して必死に藻掻き呻きをあげるが、ハンコックの姿になったデボンは意に返さない\n\n　蛇姫様の下着は、公式の商品の水着のデザインに似せたものをお願いします\n\nhttps://livedoor.blogimg.jp/mugiwara_store/imgs/a/5/a5608b4c.jpg", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/666", "thumbnail_src": "https://si.imgix.net/7eef1120/uploads/origins/dc2b31e3-877c-4d52-9c5b-b069f2b1b256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad67ace800590ec792ca5ba087e47263", "thumbnail_srcset": "https://si.imgix.net/7eef1120/uploads/origins/dc2b31e3-877c-4d52-9c5b-b069f2b1b256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad67ace800590ec792ca5ba087e47263, https://si.imgix.net/7eef1120/uploads/origins/dc2b31e3-877c-4d52-9c5b-b069f2b1b256?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfef037f89e67fba416db4ae7bc4a030 2x, https://si.imgix.net/7eef1120/uploads/origins/dc2b31e3-877c-4d52-9c5b-b069f2b1b256?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25ef4eb19404506bdecb81ff3ab15d8b 3x", "genre": "art", "nsfw": true, "body": "「のうりん」\nhttp://no-rin.tv/\n木下林檎、中沢農、良田胡蝶でマミフィケーション拘束をお願いします。\nシチュエーションは畑の見回り中に畑荒らしを発見したが逆に拘束されるという感じです。\n３人は放置され、誰かに見つけてもらえるまでテープを解こうともがいている様子をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/665", "thumbnail_src": "https://si.imgix.net/40036999/uploads/origins/b795f4fd-1c9c-4a86-99f0-57c64eafed48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53823f947d2e8a04e77c33f1c5ccabf2", "thumbnail_srcset": "https://si.imgix.net/40036999/uploads/origins/b795f4fd-1c9c-4a86-99f0-57c64eafed48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53823f947d2e8a04e77c33f1c5ccabf2, https://si.imgix.net/40036999/uploads/origins/b795f4fd-1c9c-4a86-99f0-57c64eafed48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e261c5049acc7422eeb62b2c0aa7049 2x, https://si.imgix.net/40036999/uploads/origins/b795f4fd-1c9c-4a86-99f0-57c64eafed48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f7272e3aba4e2ff2b3e5b3ff736b365 3x", "genre": "art", "nsfw": false, "body": "サンクさんこんにちは。\n今回の依頼内容はTLで募集したお題で依頼するというもので他人のOCと私OCとのコラボ企画となりますが借りる許可は取ってますのでよろしくお願いします。今回はそうはくさんちのさんちの貝ちゃん(仮名)うちのハイン、フォビア、イェン・ロンとのイラストになります。\n\n貝ちゃんの家で宝石化した私のOC3人が飾られているという内容です。\n海底っぽい雰囲気の家の中でそれぞれハインが嬉しそうな様子で、フォビアが不意を突かれて驚いた様子で、イェン・ロンが回し蹴りを繰り出している最中に宝石化しています。\nそれぞれハイン:ルビー\nフォビア:トパーズ\nイェン・ロン:エメラルド\nに変化させられています。着衣有で服ごと宝石化しています。貝ちゃんは3人を眺めながら笑顔で満足そうな顔をしています。以上ですよろしくお願いします。\n\n貝ちゃん\n\nhttps://www.dropbox.com/scl/fo/qpy6hehe59phbcbjj75s4/AJ0OyEkM5SF3y4wxp5brlVw?rlkey=7ymxjkm0hxopg1svt720gn3fy&st=57ed8iqh&dl=0\n\nハイン\n\nhttps://www.dropbox.com/scl/fo/sc9tn04n0o989duxrh4wt/AKN7Xc99yGDRD5yPU9ISdSo?rlkey=6me1sl29dzjhfsfes7yef66yb&st=wdjz238j&dl=0\n\nフォビア\n\nhttps://www.dropbox.com/scl/fo/ew1dvxje1zoniplaz8jcx/h?rlkey=vwavpl9633oal4s3z9vuxmvl8&st=5jho401w&dl=0\n\nイェン・ロン\n\nhttps://www.dropbox.com/scl/fo/f9jnsi62tq22xlqsfwpx7/AJ0ZeK1tnNRKJls4rctTxgE?rlkey=soa59gns15om0t9s5zuc6a0e5&st=ybfllffo&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/664", "thumbnail_src": "https://si.imgix.net/58522333/uploads/origins/1cad8a6f-d883-490f-9795-c704304f7aab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11dd14b618445d09dce3d9b684c3d636", "thumbnail_srcset": "https://si.imgix.net/58522333/uploads/origins/1cad8a6f-d883-490f-9795-c704304f7aab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11dd14b618445d09dce3d9b684c3d636, https://si.imgix.net/58522333/uploads/origins/1cad8a6f-d883-490f-9795-c704304f7aab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ec9844b59f902480bc59f07691551b9 2x, https://si.imgix.net/58522333/uploads/origins/1cad8a6f-d883-490f-9795-c704304f7aab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26e78380fc44aaf7f6fdad04ffb44299 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/663", "thumbnail_src": "https://si.imgix.net/9969d194/uploads/origins/65a9a701-ea4f-4d13-b5c8-08f930f8cde0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa1fc2d7027763aa4f70d65dc9cc267b", "thumbnail_srcset": "https://si.imgix.net/9969d194/uploads/origins/65a9a701-ea4f-4d13-b5c8-08f930f8cde0?bg=%23fff&