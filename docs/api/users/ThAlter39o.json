at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07d29bebc7f58803572b124fbfba1d4a 2x, https://si.imgix.net/0e3b5eaf/uploads/origins/efd3d84f-1917-4b63-8b13-e5c5bf970034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1511e611b3e0e45a37de5a00a79870d4 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n差し支えなければえとたまのうまたんがマミフィケーション拘束され、頑張ってもがいているイラストをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/691", "thumbnail_src": "https://si.imgix.net/e99d9ab8/uploads/origins/557fc7df-c454-4fe6-86c7-34f5e6555329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d82ea5e4fa59794824530f373f37779a", "thumbnail_srcset": "https://si.imgix.net/e99d9ab8/uploads/origins/557fc7df-c454-4fe6-86c7-34f5e6555329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d82ea5e4fa59794824530f373f37779a, https://si.imgix.net/e99d9ab8/uploads/origins/557fc7df-c454-4fe6-86c7-34f5e6555329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f85806d0e3e159886663502532081b4 2x, https://si.imgix.net/e99d9ab8/uploads/origins/557fc7df-c454-4fe6-86c7-34f5e6555329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=938289386c7006400e8efa936cf399b1 3x", "genre": "art", "nsfw": true, "body": "こんにちは！2026年、明けましておめでとうございます！漫画風のイラストを2人のキャラクターで依頼したいです。世界観は原神（Genshin Impact）に似た設定です。JRPGのゲーム画面のような見た目にしたいです。つまり、キャラクターのレベル、HP、MP、ステータスなどの描かれたUIがある状態です。\n\nキャラクターは：ダニエル：砂漠の王国の王女。剣で戦う（剣の参考画像はなし。典型的なJRPGのファンタジー剣で構いません）サイーブ：西洋風の巫女。味方の回復や状態異常解除が可能。武器は参考画像の通り。ストーリー：山林を旅する2人が山賊に遭遇する。\n盗賊はレベルが非常に低い一方、主人公たちは高レベル（約レベル35）であるため、戦闘に自信を持っている。しかし盗賊はMODハイテク兵器（エネルギーガン？）を所持しており、それを使ってダニエルに即座に厳重な拘束状態を付与する。この状態は解除不可能である。\n拘束具は黒のラテックススーツ、ボールギャグ、アームバインダー、ベルト、ローターを含む。サイーブは恐怖に震える。攻撃能力を持たない彼女は跪き、盗賊の命令に従ってスカートとパンティストッキングを膝まで下ろし（白い下着を露出）、両手を頭の後ろに組んで降伏する。\n最終的に2人のキャラクターは拘束され、金属製の檻（おそらく盗賊の拠点内）に閉じ込められる。両者とも目隠しと口枷を装着。サイーブは裸で、手錠や鎖などの金属拘束具で縛られ、ローターも追加される。キャラクターのアバター、HP、レベル、ステータスなどを表示する偽のUI画面を作成してください。\nダニエルのステータスUIには、手縛り・足縛り・口枷・ローターなど多数のステータス効果を表示可能。サイーブのUIには降伏・敗北・首輪装着などを表示。最終状態では手足拘束・口枷・ローター・目隠し・監禁状態を同時に表示。\n\n1ページに収めるには多すぎると思うので、2ページ以上でも構いません。テキストや台詞についてクリエイティブなアイデアがあれば、ぜひ追加してください（日本語で）。また、あなたがこれまで見た中で最も創造的なDIDシナリオアーティストだと思うので、何かクリエイティブなアイデアが浮かんだら、ほぼ何でも自由に追加して構いません（もちろん必須ではありません）。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1h1qc8kN19Kq5NMUWIaPR4YgKE-eqVi0X?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/690", "thumbnail_src": "https://si.imgix.net/584cb1e1/uploads/origins/2402127b-2a35-4f25-8ee2-9ed1320a26b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b1ea8818e365f677b65ac3b6d434502", "thumbnail_srcset": "https://si.imgix.net/584cb1e1/uploads/origins/2402127b-2a35-4f25-8ee2-9ed1320a26b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b1ea8818e365f677b65ac3b6d434502, https://si.imgix.net/584cb1e1/uploads/origins/2402127b-2a35-4f25-8ee2-9ed1320a26b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4b11db60125b5d4e25a61eb8d1427d4 2x, https://si.imgix.net/584cb1e1/uploads/origins/2402127b-2a35-4f25-8ee2-9ed1320a26b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2c7cb9d9bb5da293f2e94ca4795fabb 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。\nこの度リクエストを送らせていただきます。\n\nキャラ:『少女☆歌劇レヴュースタァライト』の星見純那\nhttps://revuestarlight.com/animation/character/?id=junna\n\nシチュ:菌糸に覆われて巨大なキノコにされて必死に揺れてる\n\n構図:ステージ上がキノコで覆われ、その中で必死に脱出しようと揺れている\nキノコのカサの色は赤色\n\n衣装:全裸\n\n備考\n目はそのまま出した状態で、ラバー拘束のようにボディラインが浮き出ているようにお願い致します。\n髪型は菌糸に包まれているものの形が分かるようお願い致します。\n以前私が描いたものを参考にしていただけるとありがたいです。\n差分等希望無し\n\n以上になります。\nご検討よろしくお願い致します。\n\nhttps://www.pixiv.net/artworks/133360892", "created_at": "", "completed_at": ""}, {"path": "/@ThAlter39o/works/689", "thumbnail_src": "https://si.imgix.net/ec62258a/uploads/origins/2c594341-6427-4206-a6d2-ca322cd458b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=20