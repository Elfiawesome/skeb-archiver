霊衣のエースである『メタトロンの影霊衣』を描いて頂きたいと思い今回リクエストをさせていただきました。\n\n構図などは先生にお任せいたしますが、原作より胸を大きく描いて頂けたら嬉しいです。\n露出などもあればより嬉しいですが、元が結構鎧を着込んでいるためできればで問題ございません。\n\n何卒ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@memento_vivi/works/61", "thumbnail_src": "https://si.imgix.net/98722a4a/uploads/origins/d8c8e664-42bb-48e9-9adb-ef825936dba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c32c646cc6e72fb72b6d1114f4fc967", "thumbnail_srcset": "https://si.imgix.net/98722a4a/uploads/origins/d8c8e664-42bb-48e9-9adb-ef825936dba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c32c646cc6e72fb72b6d1114f4fc967, https://si.imgix.net/98722a4a/uploads/origins/d8c8e664-42bb-48e9-9adb-ef825936dba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d370d6d84b58eb171907eea8802dc3a9 2x, https://si.imgix.net/98722a4a/uploads/origins/d8c8e664-42bb-48e9-9adb-ef825936dba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f13b41f8acee700b89c6bc4a30195de6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@memento_vivi/works/60", "thumbnail_src": "https://si.imgix.net/73227639/uploads/origins/fcdd6dce-e3ea-4b3f-8201-d521edc0ab73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3863e1aa5e5ca90d310c9328722fda2c", "thumbnail_srcset": "https://si.imgix.net/73227639/uploads/origins/fcdd6dce-e3ea-4b3f-8201-d521edc0ab73?bg=%23fff&auto=format%2Ccompress&fm=webp&f