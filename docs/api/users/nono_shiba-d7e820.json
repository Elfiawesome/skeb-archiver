9c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b372ecf36e619938111a5a947ce6a9a8 2x, https://si.imgix.net/613e0a02/uploads/origins/544eb78d-22f8-4215-8a2b-8741c1679c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e04b590f806821102529291f53f34199 3x", "genre": "art", "nsfw": false, "body": "のの様\n\n突然のご依頼失礼します。\n\n\n\n【元アバターの見た目や権利等】\n色改変前の元となるアバターの詳細を下記にリンクを貼っておきます\nどちらも二次創作は問題ないと記載あるので念の為に\nAユエ\nhttps://booth.pm/ja/items/7112028\n\n\n\n【依頼内容】\n下記の資料にアバターの見た目を置いております。\nユエが自身が使っているアバターの見た目と構図をいれております。\nイメージとしては、少しぼーっとしてる所を前から見られて見ないでって\n少し照れながら隠しているイメージでお願いできると嬉しいです\n構図通りの見た目ではなくとも、見られて恥ずかしがっている内容で描いて頂ければ幸いです！\n\nhttps://drive.google.com/drive/folders/1QncLAJfwfipGJ-8YvPVs43SWDTnU7rCq?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nono_shiba/works/4", "thumbnail_src": "https://si.imgix.net/4b6e54ba/uploads/origins/d1de2d87-e4be-4577-ba57-921ad9f41ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f42f54f58e2570832d4d4bdd2168e203", "thumbnail_srcset": "https://si.imgix.net/4b6e54ba/uploads/origins/d1de2d87-e4be-4577-ba57-921ad9f41ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f42f54f58e2570832d4d4bdd2168e203, https://si.imgix.net/4b6e54ba/uploads/origins/d1de2d87-e4be-4577-ba57-921ad9f41ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=450e1633e69b565810fb37e4926a596e 2x, https://si.imgix.net/4b6e54ba/uploads/origins/d1de2d87-e4be-4577-ba57-921ad9f41ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a25fe726c97b19da351422fba5ed4b1d 3x", "genre": "art", "nsfw": true, "body": "最近、あなたがこの( https://x.com/nono_shiba/status/1944338003939500398?s=61&t=sZD5y6T2U6DONkHDtsDoXA )作品を投稿しているのを見たのですが、同じようなユニフォームや衣装を着た自分のキャラクターを描いてほしいです。\n\nhttps://x.com/moonstruckmist/status/1944809520510984708?s=61&t=sZD5y6T2U6DONkHDtsDoXA", "created_at": "", "completed_at": ""}, {"path": "/@nono_shiba/works/3", "thumbnail_src": "https://si.imgix.net/e4b6b9b7/uploads/origins/94e02f94-d708-4eee-ae21-44a2b2fcc160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5618b4f2fd070fc74e4ce8c40e8951", "thumbnail_srcset": "https://si.imgix.net/e4b6b9b7/uploads/origins/94e02f94-d708-4eee-ae21-44a2b2fcc160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5618b4f2fd070fc74e4ce8c40e8951, https://si.imgix.net/e4b6b9b7/uploads/origins/94e02f94-d708-4eee-ae21-44a2b2fcc160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60c0dda3f8553071d079893f48732eca 2x, https://si.imgix.net/e4b6b9b7/uploads/origins/94e02f94-d708-4eee-ae21-44a2b2fcc160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56207aff17f819751b09917947a060cd 3x", "genre": "art", "nsfw": false, "body": "こんにちは、TwitchでRTA等の配信しているえかはすと申します。 \n今回、配信中に自身の代わりに画面に映っている犬獣人をのの様に描いていただきたいと思いリクエストさせていただきました。\n\n ◆内容\n構図や表情はのの様の裁量でお願いできればと存じます。\n\n ◆用途 \n・SNS(X等)へのポスト \n・配信活動での利用(サムネイルの作成等の為にデータを受け渡す可能性があります)\n\n◆備考\n可能でしたら透過バージョンも作成いただけますと幸いです。\n\n簡潔になりますが何卒よろしくお願いいたします。\n\nhttps://x.com/Ekahs_r/status/1823305804688282039", "created_at": "", "completed_at": ""}, {"path": "/@nono_shiba/works/2", "thumbnail_src": "https://si.imgix.net/05aa2bcd/uploads/origins/5a7f188a-38f1-4bbf-acd5-246b8be4fc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df5a3129c2cbd2cfdb3633874314a948", "thumbnail_srcset": "https://si.imgix.net/05aa2bcd/uploads/origins/5a7f188a-38f1-4bbf-acd5-246b8be4fc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df5a3129c2cbd2cfdb3633874314a948, https://si.imgix.net/05aa2bcd/uploads/origins/5a7f188a-38f1-4bbf-acd5-246b8be4fc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991fe325e66b86efd06df16b0a521462 2x, https://si.imgix.net/05aa2bcd/uploads/origins/5a7f188a-38f1-4bbf-acd5-246b8be4fc2f?bg=%23fff&auto=format%2Ccompress&