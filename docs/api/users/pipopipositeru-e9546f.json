プはより深い愛情へと発展していく。呪いは決して解けないが、二人はとにかく一緒に幸せを見つける。\n\n参考文献\nhttps://drive.google.com/drive/folders/1P2lPRU_jHE9syN7vMKvqBiaTwSk9Ozj8?usp=sharing\n\nティズム！！🫶（笑", "created_at": "", "completed_at": ""}, {"path": "/@pipopipositeru/works/2", "thumbnail_src": "https://si.imgix.net/13876fb6/uploads/origins/8e34fb39-ac50-46ca-82b7-60235931de65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f856816d2c780ed6b2df101baccb43b6", "thumbnail_srcset": "https://si.imgix.net/13876fb6/uploads/origins/8e34fb39-ac50-46ca-82b7-60235931de65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f856816d2c780ed6b2df101baccb43b6, https://si.imgix.net/13876fb6/uploads/origins/8e34fb39-ac50-46ca-82b7-60235931de65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7763131f82f135270810aa0a0a1f263 2x, https://si.imgix.net/13876fb6/uploads/origins/8e34fb39-ac50-46ca-82b7-60235931de65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de45610ad3f51b2ebfb851651b42ca57 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pipopipositeru/works/1", "thumbnail_src": "https://si.imgix.net/7315a3c8/uploads/origins/1d9b648a-f743-4038-adf0-abc27c319a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31c71e4e05297b0fc22f153e1bd0b3f3", "thumbnail_srcset": "https://si.imgix.net/7315a3c8/uploads/origins/1d9b648a-f743-4038-adf0-abc27c319a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31c71e4e05297b0fc22f153e1bd0b3f3, https://si.imgix.net/7315a3c8/uploads