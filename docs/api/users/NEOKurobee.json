-b0f0-b7c3a6a0834f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9803975c42fa3f14b1d4493fadc0e5c", "thumbnail_srcset": "https://si.imgix.net/0a064e37/uploads/origins/fa98b1c8-1c8a-4187-b0f0-b7c3a6a0834f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9803975c42fa3f14b1d4493fadc0e5c, https://si.imgix.net/0a064e37/uploads/origins/fa98b1c8-1c8a-4187-b0f0-b7c3a6a0834f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5be2ee84bb903baee2ba0a428b65a502 2x, https://si.imgix.net/0a064e37/uploads/origins/fa98b1c8-1c8a-4187-b0f0-b7c3a6a0834f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f356a5793a8bcaf9b28f2517f041cbba 3x", "genre": "comic", "nsfw": true, "body": "お世話になります。いつも作品楽しみにしています。\n\nキャラクター：武者巫女トモエ（クイーンズブレイド）　より\nトモエさんの柔軟化→平面化シチュエーションをリクエストします。\n\n①柔軟化されて体がプルプル揺れるトモエ\n\n②参考の2ページ目の様に、柔軟化した体をグニャグニャくねらせる\nhttps://www.pixiv.net/artworks/90358511\n\n③柔らかくなった体を潰されて、参考のような脇が見える形式の平面化\nhttps://www.fanbox.cc/@kuro-bee/posts/10161927\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NEOKurobee/works/27", "thumbnail_src": "https://si.imgix.net/58ccc59d/uploads/origins/b88a7034-a981-4c45-963c-f333097e78cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=548f844f791ea08b3c9dee45c8974a75", "thumbnail_srcset": "https://si.imgix.net/58ccc59d/uploads/origins/b88a7034-a981-4c45-963c-f333097e78cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=548f844f791ea08b3c9dee45c8974a75, https://si.imgix.net/58ccc59d/uploads/origins/b88a7034-a981-4c45-963c-f333097e78cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43b862dee75cccaa297f19fdac54abfa 2x, https://si.imgix.net/58ccc59d/uploads/origins/b88a7034-a981-4c45-963c-f333097e78cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e15ad1528b17b528985813db5cc2ea3 3x", "genre": "art", "nsfw": true, "body