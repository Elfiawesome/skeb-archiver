=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9a783caf70616ed2979998a1c866c08 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/191", "thumbnail_src": "https://si.imgix.net/1370b8ee/uploads/origins/2cdb796e-970b-45bb-a942-77b2fbd47b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9547cdea6f5c07c5f06f0113824d10", "thumbnail_srcset": "https://si.imgix.net/1370b8ee/uploads/origins/2cdb796e-970b-45bb-a942-77b2fbd47b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9547cdea6f5c07c5f06f0113824d10, https://si.imgix.net/1370b8ee/uploads/origins/2cdb796e-970b-45bb-a942-77b2fbd47b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58371672ea313f5396ad7132d3cc8548 2x, https://si.imgix.net/1370b8ee/uploads/origins/2cdb796e-970b-45bb-a942-77b2fbd47b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81996d101f7face0b30747f0316d5b04 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になってます\n\n今回は久しぶりに大きい方のリクエストで「栗原ネネ」２４歳くらいをお願いします\n衣装などはお任せします\n\nいかがでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/190", "thumbnail_src": "https://si.imgix.net/f582c3db/uploads/origins/0cc1c388-daed-40ef-8eb7-4b7a368176d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a73bce03803c4cb2b426e520efadd2f6", "thumbnail_srcset": "https://si.imgix.net/f582c3db/uploads/origins/0cc1c388-daed-40ef-8eb7-4b7a368176d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a73bce03803c4cb2b426e520efadd2f6, https://si.imgix.net/f582c3db/uploads/origins/0cc1c388-daed-40ef-8eb7-4b7a368176d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dec533d1513c99f2c99fe37b82df92c 2x, https://si.imgix.net/f582c3db/uploads/origins/0cc1c388-daed-40ef-8eb7-4b7a368176d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4671c04fb88b93ab05ecd3e05a61cfc3 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。以前に柳瀬美由紀のおむつ絵をリクエストさせていただいたのですが、また同じようなテーマで一つお願いしたいです。\n\nキャラはデレステの久川姉妹で、大きい子でも安心の夜用オムツのパッケージやCMモデルに抜擢され撮影中、みたいなテーマになります。一人は前向きで、もう一人はお尻側を向けてポーズをとっています。格好は上半身パジャマか普段着に下半身はオムツを穿いてアピールしている想定です。\n\nオムツデザインはいくつか資料を添付しましたのでよければご参照ください。\n\nまたニッチな内容でお願いすることになりますがいかがでしょうか..？\n\nhttps://drive.google.com/drive/folders/1jtuvPh4Jfoc3KXnvuDCiLGUbLrub03C-?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/189", "thumbnail_src": "https://si.imgix.net/a5622794/uploads/origins/1846b969-d95d-4b61-b943-274783e9d78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a59aa0a8eba8416799ab408c2c5d9a54", "thumbnail_srcset": "https://si.imgix.net/a5622794/uploads/origins/1846b969-d95d-4b61-b943-274783e9d78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a59aa0a8eba8416799ab408c2c5d9a54, https://si.imgix.net/a5622794/uploads/origins/1846b969-d95d-4b61-b943-274783e9d78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74fde581e9a219f1dc476d4ca986d12e 2x, https://si.imgix.net/a5622794/uploads/origins/1846b969-d95d-4b61-b943-274783e9d78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0271f88d05f42367bd686e455956acca 3x", "genre": "art", "nsfw": true, "body": "6歳くらいのとてもキュートな女の子が、3cmくらいの小人さんをつまみ上げてお口の中に入れようとしているイラストをお願いします！\n\nイラストは2コマ構成で、コマの大きさはそれぞれ同じでお願いします。\n\n1コマ目\n女の子が大きなお口を開けながら、口元に小人さんを持っていく様子。\n描く範囲は上半身から上で、小人さんの視線は女の子のお口の中に向いているようにお願いします！\n\n2コマ目\n超至近距離の女の子のお口。 \n喉の奥がはっきり見えるほど大きく開いた女の子のお口をコマいっぱいに描いてほしいです！\n\nかなりフェチ要素の強いイラストですが、 よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/188", "thumbnail_src": "https://si.imgix.net/a966a9b7/uploads/origins/a5d2ec3b-715a-4f76-bb9a-29ecb57feba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcd7348bd7590c74bcf9ecaa2b3975a", "thumbnail_srcset": "https://si.imgix.net/a966a9b7/uploads/origins/a5d2ec3b-715a-4f76-bb9a-29ecb57feba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcd7348bd7590c74bcf9ecaa2b3975a, https://si.imgix.net/a966a9b7/uploads/origins/a5d2ec3b-715a-4f76-bb9a-29ecb57feba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af6bb3a2d14bd42b9026912bcd939245 2x, https://si.imgix.net/a966a9b7/uploads/origins/a5d2ec3b-715a-4f76-bb9a-29ecb57feba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d69e2042ac71fc0023440f831965c038 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます！\nデュエル・マスターズの黄昏ミミちゃんをお願いします！\n服がはだけ胸を出して、ペニスを握り自分のアソコに導き悪戯っぽく笑う\nという構想でお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/187", "thumbnail_src": "https://si.imgix.net/829a0cca/uploads/origins/02d7fdac-643d-4c04-8739-2505ef81512a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b00f9a65264d3cf707a2ab6e466a6744", "thumbnail_srcset": "https://si.imgix.net/829a0cca/uploads/origins/02d7fdac-643d-4c04-8739-2505ef81512a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b00f9a65264d3cf707a2ab6e466a6744, https://si.imgix.net/829a0cca/uploads/origins/02d7fdac-643d-4c04-8739-2505ef81512a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68d52105231df11b56ee9cab51c15466 2x, https://si.imgix.net/829a0cca/uploads/origins/02d7fdac-643d-4c04-8739-2505ef81512a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85f06c6792c62d5f0c6fff91d1fae045 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています\n\n今回は「クラリス」さん１２歳をお願いします\n音葉さんとディヴァイニア、加奈ちゃんと雪乃さんでキュートサンタとかできます\n\nいかがでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/186", "thumbnail_src": "https://si.imgix.net/a48d377b/uploads/origins/4ecd1ec7-93ea-4b08-b06b-8e683c769923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eb4c176b2bb0248241365563b1cac6e", "thumbnail_srcset": "https://si.imgix.net/a48d377b/uploads/origins/4ecd1ec7-93ea-4b08-b06b-8e683c769923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eb4c176b2bb0248241365563b1cac6e, https://si.imgix.net/a48d377b/uploads/origins/4ecd1ec7-93ea-4b08-b06b-8e683c769923?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31963a4adc8a750c6a4a2af9b4d17776 2x, https://si.imgix.net/a48d377b/uploads/origins/4ecd1ec7-93ea-4b08-b06b-8e683c769923?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24d997a6b0bb59c5b544e13acec33c7a 3x", "genre": "art", "nsfw": true, "body": "初めまして、いつもXにて素敵なイラスト拝見させて頂いております。\n\n特に、ここ近頃上げておられる少し年長のアイドルの幼少期姿なんかは素敵なアレンジだなぁ…と天を仰いでおります。\n\nさて、そんなアレンジ力の素晴らしさから、今回お願いしたいのが……\n\n『ねこランジェリー姿のひじゆめ(成宮由愛ちゃんと望月聖ちゃん』です！\n\n\nねこランジェリーは白色と黒色がありますが、聖ちゃんは白色で、由愛ちゃんは黒色でお願いいたします。\n\nまた、差分でブラが胸の北半球の方にズレて、二人の胸が露わになってる姿もお願いしたく存じます…。", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/185", "thumbnail_src": "https://si.imgix.net/68e79372/uploads/origins/5b53936c-3ae2-4a01-a149-2ccd35b31089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34528688b89f93a57e5734c9e126dfcf", "thumbnail_srcset": "https://si.imgix.net/68e79372/uploads/origins/5b53936c-3ae2-4a01-a149-2ccd35b31089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34528688b89f93a57e5734c9e126dfcf, https://si.imgix.net/68e79372/uploads/origins/5b53936c-3ae2-4a01-a149-2ccd35b31089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9494b97c52b71c31b862b78747082b10 2x, https://si.imgix.net/68e79372/uploads/origins/5b53936c-3ae2-4a01-a149-2ccd35b31089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c7565123a6a5477d34a6d8775b199f6 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています\n\n今回は「川島瑞樹」１２歳をお願いします\nすこし年齢差が大きいですが、いかがでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/184", "thumbnail_src": "https://si.imgix.net/ccdfbf65/uploads/origins/10e6a741-348e-4d2c-ad59-e48598698dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fd311534c848de197d6509617855ab9", "thumbnail_srcset": "https://si.imgix.net/ccdfbf65/uploads/origins/10e6a741-348e-4d2c-ad59-e48598698dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fd311534c848de197d6509617855ab9, https://si.imgix.net/ccdfbf65/uploads/origins/10e6a741-348e-4d2c-ad59-e48598698dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e1eee4ee545abf8416a00dc50cba9e1 2x, https://si.imgix.net/ccdfbf65/uploads/origins/10e6a741-348e-4d2c-ad59-e48598698dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a68a263c5819c85ebc414f717983ba4 3x", "genre": "art", "nsfw": true, "body": "艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\nアーボックは時津風の４巻程で(首から下は足元まで隙間なく)巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい\n全身巻き付かれている事を強調する為、時津風の全身をお願い致します\n差分が大丈夫ならアーボックは通常色と色違いを、尻尾で首を巻き付けているのといないのをお願いします\n時津風の表情ですが、できれば複数（①と④を優先）お願いします\n①涙目で苦しんでいる\n②苦しんでいるけど若干感じていて赤面になっている\n③苦しいけど若干気持ちよくて恥ずかしがっている\n④嬉しくて笑っている\n①②は目を閉じ③④は目を開けて下さい", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/183", "thumbnail_src": "https://si.imgix.net/b550873a/uploads/origins/fdb512a0-619b-4363-a727-11c4d09aacda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c7c1dd869312b66f12264899d4c655d", "thumbnail_srcset": "https://si.imgix.net/b550873a/uploads/origins/fdb512a0-619b-4363-a727-11c4d09aacda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c7c1dd869312b66f12264899d4c655d, https://si.imgix.net/b550873a/uploads/origins/fdb512a0-619b-4363-a727-11c4d09aacda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1961afe815acf92cc85ea1966b5fa8b3 2x, https://si.imgix.net/b550873a/uploads/origins/fdb512a0-619b-4363-a727-11c4d09aacda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5a1d20d1fe205887258f5e145b53ae5 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしい優美ちゃんのイラストありがとうございました。\nまたリクエストさせて頂きます。\n\n\n『ときめきメモリアル』の早乙女優美のお尻パンチライラストをお願いします。\n衣装は冬制服姿です。\n風か何かでスカートがまくれ上がり、プリッとしたお尻とパンツが丸見えになります。\n優美ちゃんはこちらを振り向いていて、表情は「やん♡」という感じであまり恥ずかしがっていません。\nパンツはイチゴ柄、差分が可能なら動物のバックプリントなど可愛らしい柄の差分があると嬉しいです。\n\n\n以上です。\n検討頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/1jzdnBT3D4SM4sI7zYT_VEbRiKBkYcZq0?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/182", "thumbnail_src": "https://si.imgix.net/d8e9305e/uploads/origins/833d423b-d02c-47d0-af9f-a731b20172de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a9038ad98fa316bfe7b12ba01db4f5a", "thumbnail_srcset": "https://si.imgix.net/d8e9305e/uploads/origins/833d423b-d02c-47d0-af9f-a731b20172de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a9038ad98fa316bfe7b12ba01db4f5a, https://si.imgix.net/d8e9305e/uploads/origins/833d423b-d02c-47d0-af9f-a731b20172de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48ab771fed53a7e1b77bb9914dc651b4 2x, https://si.imgix.net/d8e9305e/uploads/origins/833d423b-d02c-47d0-af9f-a731b20172de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6f6d65c727dc44aec8682d1734964f8 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています\n\n今回は「宮本フレデリカ」１２歳をお願いします\nセレクテッドやアミマネラなどが出来たりします\n\nいかがでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/181", "thumbnail_src": "https://si.imgix.net/36c3c486/uploads/origins/c3a1d4a5-905d-4a63-a8bb-c07558c49029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42a5b585a9bfa35000a2b9bed2e81a20", "thumbnail_srcset": "https://si.imgix.net/36c3c486/uploads/origins/c3a1d4a5-905d-4a63-a8bb-c07558c49029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42a5b585a9bfa35000a2b9bed2e81a20, https://si.imgix.net/36c3c486/uploads/origins/c3a1d4a5-905d-4a63-a8bb-c07558c49029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1912ecf54694f1035288728a9ab238ec 2x, https://si.imgix.net/36c3c486/uploads/origins/c3a1d4a5-905d-4a63-a8bb-c07558c49029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d4cd003cc63db2316819e7d960d8326 3x", "genre": "art", "nsfw": false, "body": "初めまして。wgm様の描く女の子が可愛いのでリクエストいたします。\n\nHuGっと！プリキュアの輝木ほまれちゃんを描いていただきたいです。\n・表情はクールな笑顔で、なるべく爪先の目立つポーズで、背景はお任せします。\n・衣装は画像と同じ私服ですが、靴のみ黒いスポサンに変更し、真っ赤なペディキュアもお願いします。\nスポサン（色はブラック一色で、スポサンの形はリアルに再現してくださいませ。）\nhttps://jp.teva.com/women-sandals-sports/hurricane-terra-dactyl/1169431.html?dwvar_1169431_color=BLK\n\nhttps://static.wikia.nocookie.net/prettycure/images/9/93/Profile_of_Kagayaki_Homare_in_her_casual_outfit.png/revision/latest?cb=20200527234423", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/180", "thumbnail_src": "https://si.imgix.net/86880d70/uploads/origins/9d6363b7-d0b6-4071-b486-dd26c7f155c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3bb91db8ca74c52dc9aa060110bf22b", "thumbnail_srcset": "https://si.imgix.net/86880d70/uploads/origins/9d6363b7-d0b6-4071-b486-dd26c7f155c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3bb91db8ca74c52dc9aa060110bf22b, https://si.imgix.net/86880d70/uploads/origins/9d6363b7-d0b6-4071-b486-dd26c7f155c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22b819a1de8c12e79a1fc0e497ed7601 2x, https://si.imgix.net/86880d70/uploads/origins/9d6363b7-d0b6-4071-b486-dd26c7f155c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd63e333405d4bc03f75af134f18d19 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n絵柄やシチュエーションに惹かれたのでリクエストさせて頂きます。\n\n\n『ときめきメモリアル』の早乙女優美のパンチライラストをお願いします。\n衣装は冬制服姿です。\n無防備にしゃがみ込んでパンツ丸見えになっているイメージです。\nパンツはイチゴ柄です。\n\n\n以上です。\n検討頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/1jzdnBT3D4SM4sI7zYT_VEbRiKBkYcZq0?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/179", "thumbnail_src": "https://si.imgix.net/d409b9c9/uploads/origins/f057bd5a-7722-43a1-81ef-4c565da50b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e602a558d20069a02a45a2e0c814d622", "thumbnail_srcset": "https://si.imgix.net/d409b9c9/uploads/origins/f057bd5a-7722-43a1-81ef-4c565da50b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e602a558d20069a02a45a2e0c814d622, https://si.imgix.net/d409b9c9/uploads/origins/f057bd5a-7722-43a1-81ef-4c565da50b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fecef463f263becf1fc4a088fddb2c42 2x, https://si.imgix.net/d409b9c9/uploads/origins/f057bd5a-7722-43a1-81ef-4c565da50b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=497b9c719e103542234d316ddde9b068 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっています\n\n今回は「藤居朋」１２歳をお願いします\nミス・ラッキー・テリングやフォーチュン・ドリーマーズがあったりします\n\nいかがでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/178", "thumbnail_src": "https://si.imgix.net/6126418a/uploads/origins/729c296d-b303-4524-be99-3f5fdfe97a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b10ad23ee73c9bc9e1bbd5f914ad2695", "thumbnail_srcset": "https://si.imgix.net/6126418a/uploads/origins/729c296d-b303-4524-be99-3f5fdfe97a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b10ad23ee73c9bc9e1bbd5f914ad2695, https://si.imgix.net/6126418a/uploads/origins/729c296d-b303-4524-be99-3f5fdfe97a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8c60eb7746a611e8508329d651752bb 2x, https://si.imgix.net/6126418a/uploads/origins/729c296d-b303-4524-be99-3f5fdfe97a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=350e0bdf83d0e90ce050bee886e50756 3x", "genre": "art", "nsfw": false, "body": "琴歌、つかさ、唯の3人の3ショットのイラストをお願いします。\nこの3人にはユニットがあり、先日の沖縄公演で夏恋を歌ったので夏らしい爽やかな軽装の私服姿で描いていただきたいです。\n横長のイラストで配置はセンターが琴歌、左右に唯とつかさです。\nPが3人の視線の先でカメラを持っていて撮った写真という体でお願いします。\nポージングは全員がピースをしていますがつかさと唯は手慣れた感じのギャルピース、琴歌は控えめで可愛らしいピースをしています。3人が仲良い雰囲気があるようにお願いしたいです。\n\nイラストはSNSのアイコン、ヘッダーやアイマスの現場で配布するP名刺に使います。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/177", "thumbnail_src": "https://si.imgix.net/ced1a7b6/uploads/origins/4dec4d0f-5fba-4b8a-afe8-811603a8efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b60425c5f411bf31a3731a9a8198cc", "thumbnail_srcset": "https://si.imgix.net/ced1a7b6/uploads/origins/4dec4d0f-5fba-4b8a-afe8-811603a8efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b60425c5f411bf31a3731a9a8198cc, https://si.imgix.net/ced1a7b6/uploads/origins/4dec4d0f-5fba-4b8a-afe8-811603a8efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15ca928ab4aa690603f3d8015578736d 2x, https://si.imgix.net/ced1a7b6/uploads/origins/4dec4d0f-5fba-4b8a-afe8-811603a8efeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=711c8b91064dc90fe2ecccdcedbe94f9 3x", "genre": "art", "nsfw": true, "body": "格ゲーのヴァンパイアシリーズの、モリガンを依頼します。\n容姿は幼め、胸は大きい\n胸元ははだけて、ペニスに息を吹きかけて反応を楽しむ、というイタズラをしている…という内容で宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@wgm_oekaki/works/176", "thumbnail_src": "https://si.imgix.net/5a7793b3/uploads/origins/e9a21330-50ac-42e3-b2e2-e208fc9d59ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be3f0b7685f2de544890243643b65772", "thumbnail_srcset": "https://si.imgix.net/5a7793b3/uploads/origins/e9a21330-50ac-42e3-b2e2-e208fc9d59ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be3f0b7685f2de544890243643b65772, https://si.imgix.net/5a7793b3/uploads/origins/e9a21330-50ac-42e3-b2e2-e208fc9d59ef?bg=%2