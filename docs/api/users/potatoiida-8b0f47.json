i.imgix.net/c6de5b6d/uploads/origins/58d91f1f-03d9-4614-bc7d-b30711bc66e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0418ca46fae6b078c7cc18698e562907 2x, https://si.imgix.net/c6de5b6d/uploads/origins/58d91f1f-03d9-4614-bc7d-b30711bc66e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72da568d4423a045b79b314ef3a579bf 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/40", "thumbnail_src": "https://si.imgix.net/204f4808/uploads/origins/43a348c3-512f-44f8-9e12-8c4b5a21e861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76110c75120e512ec452fb40a285adb0", "thumbnail_srcset": "https://si.imgix.net/204f4808/uploads/origins/43a348c3-512f-44f8-9e12-8c4b5a21e861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76110c75120e512ec452fb40a285adb0, https://si.imgix.net/204f4808/uploads/origins/43a348c3-512f-44f8-9e12-8c4b5a21e861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2121ba4bf878c9005296388b7b84122c 2x, https://si.imgix.net/204f4808/uploads/origins/43a348c3-512f-44f8-9e12-8c4b5a21e861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=554df2a7bd7e5fc96397a184499cec39 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/39", "thumbnail_src": "https://si.imgix.net/8f1763f6/uploads/origins/c2ee059d-a9f9-4c3d-a31a-d3bd7e31d17d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c07f949027c3eed17b541bbd9b8205f", "thumbnail_srcset": "https://si.imgix.net/8f1763f6/uploads/origins/c2ee059d-a9f9-4c3d-a31a-d3bd7e31d17d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c07f949027c3eed17b541bbd9b8205f, https://si.imgix.net/8f1763f6/uploads/origins/c2ee059d-a9f9-4c3d-a31a-d3bd7e31d17d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dd01edca4bbd7ca537393094523e00d 2x, https://si.imgix.net/8f1763f6/uploads/origins/c2ee059d-a9f9-4c3d-a31a-d3bd7e31d17d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53557dd9827a2ca864585b93dc93c54d 3x", "genre": "art", "nsfw": true, "body": "YYDAP先生、こんにちは、\n\n今回はゆあちゃんとゆいこ先生のシーンもお願いします。授業が終わり、教員室でのことです。ゆあは机の下で男性教師にフェラチオをしている。実は机の下に誰かが隠れていることに気づいていたのだが（もしかしたらそれがゆあだと知っていたのかもしれないし、知らなかったのかもしれない）、ゆあは欲望にまみれてその男と普通に話し、何も言わずにその場を立ち去った。事務所に2人しかいなくなった後、ゆあは足コキ（この先生はパンストフェチらしい）やユイコ先生の話で彼を翻弄し始める。最後に先生は激しいセックスでユアを満足させ、ユイコは2人のセックスを覗き見している。セックスの体位は、私は彼が彼女の足を犯したり舐めたりするのが好きだけど、あなたが気になるところやアイデアがあれば、変えても全然構わないよ。  \n\nいつもあなたの作品に感謝しています！ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/38", "thumbnail_src": "https://si.imgix.net/db671081/uploads/origins/9e88b616-dd9a-41f2-af4d-1f96102508eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15426ab84a27ffc2a1b63e34cc9556b0", "thumbnail_srcset": "https://si.imgix.net/db671081/uploads/origins/9e88b616-dd9a-41f2-af4d-1f96102508eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15426ab84a27ffc2a1b63e34cc9556b0, https://si.imgix.net/db671081/uploads/origins/9e88b616-dd9a-41f2-af4d-1f96102508eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40a1cfa7b0fb073547814e7c52cd6884 2x, https://si.imgix.net/db671081/uploads/origins/9e88b616-dd9a-41f2-af4d-1f96102508eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b675a540b43437fd189f7294a200eda 3x", "genre": "comic", "nsfw": true, "body": "こんにちわ、\n\nあなたの絵がとても好きです。\n婦警さんのお話を作ってください。\n\n以下のようなテーマでストーリーを作ってください。\nクールで有能な女性が、自分より社会的地位の低い男たちに脅迫され、服従させられる。\n女性警察官への言葉責めもたくさん入れてください。\n\n下記の参考で使用されている暗めの配色と背景がとても気に入っています。\nそれはネオンスタイルで活気と賑やかな通りを感じさせます。\nできれば、同じようなシーンを再現してほしい。\n参考 https://drive.google.com/file/d/1Vfe6yGlBggu6yP7tosD-iNw_IzfZQsLZ\n\nある婦人警官が、自分より社会的地位の低い人物（例えばチンピラ）に脅迫され、意に反して強要された。\n仕事中も休日も、加害者の性的欲求とフェチな命令を満足させるために、バレないように、職を失わないように、彼女は尽くしているのだ。\n警官が制服を着たまま性的暴行を受けるシーンを入れてください。\n婦人警官の制服は、ズボンを履くなど、できるだけリアルに表現してください。また、通常のパトロール用アクセサリーも、できるだけ詳細に描写してください。\n(あるいは、アニメ『ハコヅメ』の警察官の制服のデザインでもいい。)", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/37", "thumbnail_src": "https://si.imgix.net/505be1c5/uploads/origins/3f6fbb90-9fab-48e4-b6be-932eb0ad9832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94256f7599be42bb1f31eb52d04d7040", "thumbnail_srcset": "https://si.imgix.net/505be1c5/uploads/origins/3f6fbb90-9fab-48e4-b6be-932eb0ad9832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94256f7599be42bb1f31eb52d04d7040, https://si.imgix.net/505be1c5/uploads/origins/3f6fbb90-9fab-48e4-b6be-932eb0ad9832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d8cb33e1324a29d76d40b39bdaa472d 2x, https://si.imgix.net/505be1c5/uploads/origins/3f6fbb90-9fab-48e4-b6be-932eb0ad9832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4de85723de623f6c9159496dd691e091 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\nリクエストに応えてくれてありがとう。\n\n大森さんの作品が大好きです:\nhttps://fantia.jp/posts/2053703\n彼女のことをもっと知りたいので、また彼女を絡めたイラストをお願いします。\n18禁でも年齢制限なしでも構いません。\nそれ以外はすべてお任せします。\n\n万が一、今回の依頼で大森さんの作品を描きたくない場合は、この女の子に関するイラスト（18禁）をお願いします：\nhttps://x.com/potatoyyda/status/1674708358664978433/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/36", "thumbnail_src": "https://si.imgix.net/ab44342b/uploads/origins/98afd226-35c1-4f27-bc6f-ff61d28f2b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2afb97a64fab05e9936e2e3b1fdc95d0", "thumbnail_srcset": "https://si.imgix.net/ab44342b/uploads/origins/98afd226-35c1-4f27-bc6f-ff61d28f2b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2afb97a64fab05e9936e2e3b1fdc95d0, https://si.imgix.net/ab44342b/uploads/origins/98afd226-35c1-4f27-bc6f-ff61d28f2b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd836c368c39f97e6b61242e5e2bf8f8 2x, https://si.imgix.net/ab44342b/uploads/origins/98afd226-35c1-4f27-bc6f-ff61d28f2b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5456cfcdac1a4a06c36188ca6f8d364a 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\nあなたのこの作品がとても大好きです。https://fantia.jp/posts/2053703\nクールで有能な女性が、劣った男性によって人生をめちゃくちゃにされるのを見るのが大好きです。\n続編を作ってほしいです。\n\n[ストーリー]\nその後、彼と彼女の立場は一変した。\nその恥ずかしさは記録され、彼女は脅迫された。\n彼女は仕事でもプライベートでも、自分の家でさえも密かに彼に支配されていた。\n\n可能であれば以下も含めてください。\n1. どんなに嫌がっても、彼にマンコや乳首を愛撫されると簡単に潮を吹いてしまう。\n2. 職場でスーツを着たまま、密かに性的暴行を受けた。\n3. 彼による言葉の屈辱。例：以前と現在の彼女の態度の対比、エリートの能力とゴミのようなマンコの対比。\n4. 彼は彼女を家まで尾行した。その後、彼女は自分の家で彼に奉仕することを強要された。例：彼のために料理を作り、その後に犯された。\n5. そのたった一度の過ちで、彼女の人生は永遠に変わってしまった。", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/35", "thumbnail_src": "https://si.imgix.net/8e1ed511/uploads/origins/a48fb7b3-1f49-4254-b454-5ae133c5d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=048a00bfcc2bc0e6788f7a4c5c92a23e", "thumbnail_srcset": "https://si.imgix.net/8e1ed511/uploads/origins/a48fb7b3-1f49-4254-b454-5ae133c5d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=048a00bfcc2bc0e6788f7a4c5c92a23e, https://si.imgix.net/8e1ed511/uploads/origins/a48fb7b3-1f49-4254-b454-5ae133c5d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34fcf96d1934afd6bb938686701af6e1 2x, https://si.imgix.net/8e1ed511/uploads/origins/a48fb7b3-1f49-4254-b454-5ae133c5d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=727ab955267ed724c0e17811c1dbb7fa 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/34", "thumbnail_src": "https://si.imgix.net/77460222/uploads/origins/483f5952-fe6f-4f15-8196-af20da75074e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769a5982769dae8c417de9781f5c09d4", "thumbnail_srcset": "https://si.imgix.net/77460222/uploads/origins/483f5952-fe6f-4f15-8196-af20da75074e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769a5982769dae8c417de9781f5c09d4, https://si.imgix.net/77460222/uploads/origins/483f5952-fe6f-4f15-8196-af20da75074e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ade6580af2ce7a69a5b4d0e5ce99eb5 2x, https://si.imgix.net/77460222/uploads/origins/483f5952-fe6f-4f15-8196-af20da75074e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f6e15893f35552cdfa6f5e8e84db749 3x", "genre": "art", "nsfw": true, "body": "匿名でのリクエスト失礼いたします。\n飯田ポテト様の描かれる絵柄、漫画大好きです。\n\n以下のようなシチュエーションのオリジナルの漫画を描いていただきたいです。\nテーマは「常識改変」です。\n\n●キャラクター\n1、女子高生\n　バレーボール部\n　髪型は以下のイラストの女の子ぐらい\n　https://fantia.jp/posts/2073626\n　体形は全体的に肉付き良くむっちりした感じでお願いいたします\n\n2、バレーボール部の顧問\n　太った中年のおじさん\n　いつもお気に入りの女子生徒にいやらしい目線を向けており、生徒からは嫌われている\n\n●シチュエーション\n顧問はある日手に入れた能力で、以下のような催眠を生徒にかけています。\n・一部の女子生徒は、顧問に朝の挨拶をする際に舌を絡めたキスをしなければならない\n・また朝の挨拶の際に、服装検査として着用している下着を詳細に報告しなければならない\n上記以外にも自分に都合の良い催眠をかけており、学校に関係する人間はその異常さに気づけないでいます。\n\n①部活の朝練のため登校する女の子。\n　登校時に顧問に出くわしてしまい、嫌悪感を抱きながらも「挨拶」をする。\n　調子に乗った顧問から「昨日はオナニーしたのか」みたいなことを聞かれ\n　内心毒づきながら「それ、セクハラですよ」と釘を刺す。\n　下着の報告をしたら顧問から別の下着の入った袋を渡される。\n\n②顧問との嫌な時間が終わり更衣室で着替えをする。\n　渡された袋には顧問の趣味の卑猥な下着が入っており、内心引きながらもそれに着替える。\n　また部活のユニフォームも明らかに通常より布面積が少なく、サイズも小さくて体のラインが丸わかりだが\n　（最近変わったユニフォーム動きづらい）とか考えながら普通に着替えを済ませてしまう。\n\n以上になります。\n細かい点や、記載している内容でも飯田ポテト様の好みでアレンジしていただければと思います。", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/33", "thumbnail_src": "https://si.imgix.net/e16e24c3/uploads/origins/97d82ea4-bc62-464e-aaa2-16a0fe14368c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1909f0b6f1656bd45a2584d93a136b36", "thumbnail_srcset": "https://si.imgix.net/e16e24c3/uploads/origins/97d82ea4-bc62-464e-aaa2-16a0fe14368c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1909f0b6f1656bd45a2584d93a136b36, https://si.imgix.net/e16e24c3/uploads/origins/97d82ea4-bc62-464e-aaa2-16a0fe14368c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35476f5c668893ebbe3416bfe9ff67c5 2x, https://si.imgix.net/e16e24c3/uploads/origins/97d82ea4-bc62-464e-aaa2-16a0fe14368c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7bcd44b2c2fcf984f63fecb3a5cb0c7 3x", "genre": "art", "nsfw": true, "body": "YYDAP先生、またお会いできて嬉しいです！\n\n新しいアイデアが浮かんだので、もう一度リクエストを送ることを許してください。ユアちゃんの漫画のNSFシーンです。今回のメイントピックは、ユアが学校でパンティをはいていないこと、アソコに卵バイブがあることをクラスメートに見つかってしまったことです。それで彼女は彼を誘い、放課後にセックスをした。このアイデアは、前回描いてくれたゆあちゃんのキャラクターがとても気に入ったからです(笑)。制服を着ているのは間違いないので、不便に感じたら夏の制服を描いてもいいと思います。シーンやセックスの体位、細かいプロットも、前回のリクエストのように自由に選んでください。パンストと足のディテールも前回のリクエストと同じです！  あなたのペースでやってください！よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/32", "thumbnail_src": "https://si.imgix.net/8d71800a/uploads/origins/f6d92216-f75c-407e-83f2-624190c4705a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7f687201c7eadc458412540a93f3a59", "thumbnail_srcset": "https://si.imgix.net/8d71800a/uploads/origins/f6d92216-f75c-407e-83f2-624190c4705a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7f687201c7eadc458412540a93f3a59, https://si.imgix.net/8d71800a/uploads/origins/f6d92216-f75c-407e-83f2-624190c4705a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9329a2db486d0b2727797112f5b79609 2x, https://si.imgix.net/8d71800a/uploads/origins/f6d92216-f75c-407e-83f2-624190c4705a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=527f44f4390d9fe580ef422b178e0900 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/31", "thumbnail_src": "https://si.imgix.net/c3a40f34/uploads/origins/a5c88d86-67a6-48fd-af24-d2633b1ef36d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9879f0ec8b9c92525e4999076856b138", "thumbnail_srcset": "https://si.imgix.net/c3a40f34/uploads/origins/a5c88d86-67a6-48fd-af24-d2633b1ef36d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9879f0ec8b9c92525e4999076856b138, https://si.imgix.net/c3a40f34/uploads/origins/a5c88d86-67a6-48fd-af24-d2633b1ef36d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fb0c63f288a1da51bc85df25e9099cf 2x, https://si.imgix.net/c3a40f34/uploads/origins/a5c88d86-67a6-48fd-af24-d2633b1ef36d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77d9f6cf9e98da35e00281ab15cf83ef 3x", "genre": "art", "nsfw": true, "body": "飯田ポテト先生、初めまして。\n\nこの間Twitterで先生が描いた漫画を見て、めっちゃ好きです。\nhttps://twitter.com/potatoyyda/status/1520024243182129152\n\nこちらは自分のリクエストです。\n\n▶ キャラクター\n・Lucia（ https://www.youtube.com/c/Luciaaa_Sings ）\n\n▶ シチュ\nLuciaさんの、おねショタのカラーマンガをお願いできますでしょうか？\nお姉さんとして、落ち込んでるショタくんを慰めたいですが、ショタくんのおちんちんが想像よりも大きいため、すぐに快感に敗北してしまったというテーマです。\n\n衣装はどちらでも大丈夫です。詳細なデザインや改変は、先生にお任せします。\n「Pinball」の衣装の場合は、右ふともものガーターリングは残していただきたいです。\n\n竿役の表現は最小限で、陰毛は無毛でお願いします。できれば全身が見たいです。\n\n詳細と調整は先生にお任せします。\n\n完成された作品は是非Twitterとpixivに共有して大勢の方に見せてあげてください。\n\nお忙しいところ恐縮ですが、何卒よろしくお願いします。\n\nApologize for my poor Japanese, I hope you can understand the text. Thank you!\n\n▶ 参考資料\nhttps://imgur.com/a/3HIohXY \nhttps://imgur.com/a/PxC1YzK", "created_at": "", "completed_at": ""}, {"path": "/@potatoiida/works/30", "thumbnail_src": "https://si.imgix.net/f75e1d01/uploads/origins/d1469994-e1ee-47f2-ad74-a69e03136012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6afca0d9cf4e8d0b0c602bb0b7705262", "thumbnail_srcset": "https://si.imgix.net/f75e1d01/uploads/origins/d1469994-e1ee-47f2-ad74-a69e03136012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6afca0d9cf4e8d0b0c602bb0b7705262, https://si.imgix.net/f75e1d01/uploads/origins/d1469994-e1ee-47f2-ad74-a69e03136012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53ef6c3af6f46dd82e66f8cd4ce3f06b 2x, https://si.imgix.net/f75e1d01/uploads/origins/d1469994-e1ee-47f2-ad74-a69e03136012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=deb889d97278270ec9f9c88c224caddc 3x", "genre": "art", "nsfw": true, "body": "再度リクエストさせて頂きます\n\n暁の護衛の宮川清美を先生に描いていただきたいです\n\n↓公式サイト（キャラページ主要キャラ欄の右から三番目にいるキャラになります）\nhttp://www.akabeesoft3.com/products/goei2/mannaka.html\n\n↓完全版サイト（↑より少しアップになった立ち絵と別CGが見れます）\nhttp://www.akabeesoft3.com/products/goei_complete/index.html\n\n\n◆服装\n\n・眼鏡着用（レイヤーでオンオフ可能だと嬉しいです）\n\n・立ち絵のスーツ（パンストはなしで）\n\n・胸は大きめに描いて頂きたいです\n\n\n◆ポーズ等\n\n・嫌そうな感じでタイトスカートをたくし上げてパンツを見せている姿でお願い致します（下着は派手目なデザインにして頂けると嬉しいです）\n\n・可能な場合は