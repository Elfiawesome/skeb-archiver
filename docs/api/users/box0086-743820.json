bef-64a3-466a-baf2-25e55c2ac2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c68e9adcad34c3703be82940365f6ed 3x", "genre": "art", "nsfw": false, "body": "素敵なイラストを描かれているのでリクエスト致しました。\nイナズマイレブンGOの音無春奈と雷門夏未がダークエンペラーズのユニフォームを着ているイラストをお願いします。\n設定として、2人がサッカー部旧部室の荷物整理をしているとダークエンペラーズのユニフォームを見つけて興味本位で着てみたという感じです。\n表情は春奈がウキウキしていて、夏未は少し恥ずかしそうにしてほしいです。\n\n以上です。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/9", "thumbnail_src": "https://si.imgix.net/8de2abb1/uploads/origins/07f232aa-550f-4f96-9a74-497506cb65d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4fc835db1d1f4b234a2704d6ce8ff12", "thumbnail_srcset": "https://si.imgix.net/8de2abb1/uploads/origins/07f232aa-550f-4f96-9a74-497506cb65d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4fc835db1d1f4b234a2704d6ce8ff12, https://si.imgix.net/8de2abb1/uploads/origins/07f232aa-550f-4f96-9a74-497506cb65d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2063384cdb3740c1d2f156e2b261d20 2x, https://si.imgix.net/8de2abb1/uploads/origins/07f232aa-550f-4f96-9a74-497506cb65d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d420b41a57f284cd0bb92f73645060d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/8", "thumbnail_src": "https://si.imgix.net/e73ef258/uploads/origins/737459cd-d7cb-492c-adff-29328dd9deef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220d637389d191c8cccb5961481de5ad", "thumbnail_srcset": "https://si.imgix.net/e73ef258/uploads/origins/737459cd-d7cb-492c-adff-29328dd9deef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220d637389d191c8cccb5961481de5ad, https://si.imgix.net/e73ef258/uploads/origins/737459cd-d7cb-492c-adff-29328dd9deef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6baee1a86475f137df69f008d3caf079 2x, https://si.imgix.net/e73ef258/uploads/origins/737459cd-d7cb-492c-adff-29328dd9deef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33d1a7b937c9cd3b747884cd75c4d0ee 3x", "genre": "art", "nsfw": true, "body": "おはようございます。\n『ゼルダの伝説 知恵のかりそめのもの』のファルファ(https://files.catbox.moe/mys8dj.png)がハイラル牧場(https://files.catbox.moe/mr4t0d.png)で、ゼルダ姫が作ったタートナックLv.3のつくりだす(https://files.catbox.moe/nj19ng.png)と騎乗位か後背位でセックスしている画像をリクエストしてもいいですか？彼女はトリィ(https://files.catbox.moe/3t5bzy.png)と一緒に近くでこっそり見ていて、ムードを盛り上げるためにアイゾルのカラクリ(https://files.catbox.moe/9npgfu.png)が音楽を流しています。", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/7", "thumbnail_src": "https://si.imgix.net/b572bcf2/uploads/origins/e9b43e1b-6c89-4a40-b983-f7825dd36ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16b32d05ff51bcf880716565777a7c4c", "thumbnail_srcset": "https://si.imgix.net/b572bcf2/uploads/origins/e9b43e1b-6c89-4a40-b983-f7825dd36ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16b32d05ff51bcf880716565777a7c4c, https://si.imgix.net/b572bcf2/uploads/origins/e9b43e1b-6c89-4a40-b983-f7825dd36ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58d1b1f8c22a15fc24f8763c25fe853f 2x, https://si.imgix.net/b572bcf2/uploads/origins/e9b43e1b-6c89-4a40-b983-f7825dd36ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80e925ccd71d9ab2a3888e5d049b7ba2 3x", "genre": "art", "nsfw": true, "body": "こんばんは！\n以前、ゲーム「ファイアーエムブレム エンゲージ」のキャラクター「ヴェイユ」のイラストをお願いしたのですが、その時は本当にありがとうございました。\n次のイラストは、エーティエとクランネです。\nクラネはカジュアルなソラネルの服を着ますが、エーティエは彼女の配色に合わせたマージカノンの鎧を着ます（このクラスの見た目がとても好きなんです）。\nエーティエはソラネルのどこかのアルコーブに隠れていて、ベンチに座って脚を広げ、片手を脚の間に入れてマージカノンのスカートをめくります。\n偶然エーティエの隠れ家を見つけたクランネは、エーティエが彼に頼んで作ってもらった長くて太いピクルスでオナニーしているのを見て驚きの表情を浮かべます（ピクルスがエーティエの膣口の中に入っている様子もクローズアップされ、その上には陰毛が生えています）。\n\n※　このイラストのリクエストは、あなたが以前作ったゴルドマリーとフランをフィーチャーした画像とパラレルな対になるものだと想像してください（笑）\n\nhttps://files.catbox.moe/rw74ws.jpg", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/6", "thumbnail_src": "https://si.imgix.net/17331845/uploads/origins/9d1f2bfc-f93f-4b49-83c7-37352f02ca8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9311d15bee35c9f74ef24f30a8b09f4a", "thumbnail_srcset": "https://si.imgix.net/17331845/uploads/origins/9d1f2bfc-f93f-4b49-83c7-37352f02ca8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9311d15bee35c9f74ef24f30a8b09f4a, https://si.imgix.net/17331845/uploads/origins/9d1f2bfc-f93f-4b49-83c7-37352f02ca8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e56240abb9217e0c90ecd9b20d39356c 2x, https://si.imgix.net/17331845/uploads/origins/9d1f2bfc-f93f-4b49-83c7-37352f02ca8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=caaab0d1328c5b22d81a9df100f46a71 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/5", "thumbnail_src": "https://si.imgix.net/1e6f98a9/uploads/origins/1ebd82fa-a007-4e36-aa6b-a6a72e803109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b81196547628016060da518ce1e90dcc", "thumbnail_srcset": "https://si.imgix.net/1e6f98a9/uploads/origins/1ebd82fa-a007-4e36-aa6b-a6a72e803109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b81196547628016060da518ce1e90dcc, https://si.imgix.net/1e6f98a9/uploads/origins/1ebd82fa-a007-4e36-aa6b-a6a72e803109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32a83c5ca63031d0093a55c8c50efd72 2x, https://si.imgix.net/1e6f98a9/uploads/origins/1ebd82fa-a007-4e36-aa6b-a6a72e803109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0679dacf7f4ba7d3c891140e8442375 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/4", "thumbnail_src": "https://si.imgix.net/b58d2601/uploads/origins/567d4a22-2232-4f4a-9aeb-8a2075ac8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659822b3719da45eb15b8f8998ff1bdd", "thumbnail_srcset": "https://si.imgix.net/b58d2601/uploads/origins/567d4a22-2232-4f4a-9aeb-8a2075ac8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659822b3719da45eb15b8f8998ff1bdd, https://si.imgix.net/b58d2601/uploads/origins/567d4a22-2232-4f4a-9aeb-8a2075ac8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4a100f5934e6739cb90c4e6732f266f 2x, https://si.imgix.net/b58d2601/uploads/origins/567d4a22-2232-4f4a-9aeb-8a2075ac8a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfa5f2e8ff6244039b2b38d72394f3ee 3x", "genre": "art", "nsfw": true, "body": "こんばんは。\n私はアメリカ在住ですが、よろしければイラストの依頼をしたいと思います。\n依頼したいイラストは、ビデオゲーム『ファイアーエムブレム エンゲージ』に登場するフェルドラゴン族のキャラクター“ヴェイル”です。ヴェイルはセピアの魔法の影響下にあり、その魔法はヴェイルの父であるソンブルがセピアに与えた呪いの兜によって強化されています。 父親であるソンブルがセピアに与えた呪いの兜によって強化されたセピアの魔法の影響を受け、彼女の持つドラゴンの破壊本能を基盤として引き出された第二の人格によって邪悪なフェルドラゴンの娘となります（その過程で、彼女はいつもの白いドレスではなく、新しい黒いドレスを着用します）。\nイラストでは、ヴェイルは仰向けに寝そべり、両脚を広げ、両手を太ももに置いて、顔が描かれていない男性と膣性交を行っています。目を閉じ、眉を寄せ、口を大きく開けて快楽の声を上げていることから、ヴェイルは性交を楽しんでいるようです。\nできれば、イラストの枠内にヴェイルの裸足も見えるようにしていただきたいです。\n\nhttps://files.catbox.moe/2gocgk.png", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/3", "thumbnail_src": "https://si.imgix.net/29a88660/uploads/origins/745f4595-98ce-491f-ad84-5e20a39eb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46ecbe7991269ab851aadf5052631bd2", "thumbnail_srcset": "https://si.imgix.net/29a88660/uploads/origins/745f4595-98ce-491f-ad84-5e20a39eb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46ecbe7991269ab851aadf5052631bd2, https://si.imgix.net/29a88660/uploads/origins/745f4595-98ce-491f-ad84-5e20a39eb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df2c6d03b0896ea0642d30603bb1d88f 2x, https://si.imgix.net/29a88660/uploads/origins/745f4595-98ce-491f-ad84-5e20a39eb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9116844f8c4f53d2f54c16c7979f2deb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@box0086/works/2", "thumbnail_src": "https://si.imgix.net/20011b4a/uploads/origins/1a91faa2-b0b5-45a1-b1b9-db0bfc765bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsh