e=30&txt=PRIVATE&s=67b14fa0b765c5a7dff641f1aa2720b4", "thumbnail_srcset": "https://si.imgix.net/c520d552/uploads/origins/809f9ec4-5170-40b5-a9f7-37dd0c71a9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67b14fa0b765c5a7dff641f1aa2720b4, https://si.imgix.net/c520d552/uploads/origins/809f9ec4-5170-40b5-a9f7-37dd0c71a9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cba7c6b7a89dc85a7db11cfe563a4b49 2x, https://si.imgix.net/c520d552/uploads/origins/809f9ec4-5170-40b5-a9f7-37dd0c71a9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e6ebf130d6ec2c77226ae3d7c532b6b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/27", "thumbnail_src": "https://si.imgix.net/c0d4a554/uploads/origins/a141d2d0-2f58-4ec5-bda6-9ffa0ce5c5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53069fdb1152541bb735e4420c39066", "thumbnail_srcset": "https://si.imgix.net/c0d4a554/uploads/origins/a141d2d0-2f58-4ec5-bda6-9ffa0ce5c5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53069fdb1152541bb735e4420c39066, https://si.imgix.net/c0d4a554/uploads/origins/a141d2d0-2f58-4ec5-bda6-9ffa0ce5c5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c13eca9bd24f7991b0dc23864325f6f3 2x, https://si.imgix.net/c0d4a554/uploads/origins/a141d2d0-2f58-4ec5-bda6-9ffa0ce5c5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70eb3a0c50542ff687a36702cb1c16c3 3x", "genre": "art", "nsfw": true, "body": "リベサガから宮廷魔術師女（エメラルド）と帝国軽装歩兵女（ライーザ）を惨たらしく葬ってください。\n\nエメラルドが「魔物退治を兼ねて訓練を一緒に行いましょう」と下水道一緒に移動。待ち伏せしていたライーザと共に本性を現し、敵に寝返る事を伝えて襲いかかるも返り討ちにされる。\n共に寝返るはずだったテレーズとアンドロマケーが消えた事を悟った2人は焦り、身ぐるみ全て剥がされてみっともなく命乞いをするが、容赦なく殺されて死体になる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/26", "thumbnail_src": "https://si.imgix.net/24ee00af/uploads/origins/b7256654-2366-4ce7-b9f4-af33e68aa819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dc82a604b4b6ce334424af325cf4298", "thumbnail_srcset": "https://si.imgix.net/24ee00af/uploads/origins/b7256654-2366-4ce7-b9f4-af33e68aa819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dc82a604b4b6ce334424af325cf4298, https://si.imgix.net/24ee00af/uploads/origins/b7256654-2366-4ce7-b9f4-af33e68aa819?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9672d599f1d6166d6788809aa8d19728 2x, https://si.imgix.net/24ee00af/uploads/origins/b7256654-2366-4ce7-b9f4-af33e68aa819?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35af40a608f4c75552594519e34ba987 3x", "genre": "art", "nsfw": true, "body": "グラブルのシルヴァの縦真っ二つをお願いします。\n狙撃銃でターゲットを狙い、引き金を弾く瞬間にターゲット方面から斬撃が飛んで直撃。\n困惑の声を上げた後、自身がズレていることに気づいてみっともなく喚き散らした後死亡。という流れで。\n衣装は光属性をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/25", "thumbnail_src": "https://si.imgix.net/bac2161d/uploads/origins/666805fa-b2d9-41a0-9f8e-7bfb0719ebc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f924461483f4c9cf3edc0932f34c1259", "thumbnail_srcset": "https://si.imgix.net/bac2161d/uploads/origins/666805fa-b2d9-41a0-9f8e-7bfb0719ebc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f924461483f4c9cf3edc0932f34c1259, https://si.imgix.net/bac2161d/uploads/origins/666805fa-b2d9-41a0-9f8e-7bfb0719ebc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e201ad7a042fcbcc0474065a21aa7b21 2x, https://si.imgix.net/bac2161d/uploads/origins/666805fa-b2d9-41a0-9f8e-7bfb0719ebc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b7d43636f088e7400586e701aeff668 3x", "genre": "art", "nsfw": true, "body": "リベサガのキャットを縦真っ二つにしてください。\n盗みが見つかりったことで証拠隠滅とばかりに攻撃を仕掛けるが、一瞬で真っ二つに。徐々にズレていく身体を感じながら命乞いをするように喚き、絶叫して死亡。といったふうにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/24", "thumbnail_src": "https://si.imgix.net/49cbb6fe/uploads/origins/8fde5a29-3992-45f5-83a8-647412afa9e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=585a4d7a7f345e974e5c819f17eca34b", "thumbnail_srcset": "https://si.imgix.net/49cbb6fe/uploads/origins/8fde5a29-3992-45f5-83a8-647412afa9e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=585a4d7a7f345e974e5c819f17eca34b, https://si.imgix.net/49cbb6fe/uploads/origins/8fde5a29-3992-45f5-83a8-647412afa9e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bf7b5e1bb81967d99741ca2bc0bfca7 2x, https://si.imgix.net/49cbb6fe/uploads/origins/8fde5a29-3992-45f5-83a8-647412afa9e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8573504b4c70b2b7a0b417e446ad1586 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/23", "thumbnail_src": "https://si.imgix.net/30f7a3f2/uploads/origins/0cc0645a-0106-4030-aeac-9d4a0449e43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aecb3fc9b85f5d546bde1e5db38c9aa1", "thumbnail_srcset": "https://si.imgix.net/30f7a3f2/uploads/origins/0cc0645a-0106-4030-aeac-9d4a0449e43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aecb3fc9b85f5d546bde1e5db38c9aa1, https://si.imgix.net/30f7a3f2/uploads/origins/0cc0645a-0106-4030-aeac-9d4a0449e43f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc100af7e2b9d831d55ee5a4bcd68cdc 2x, https://si.imgix.net/30f7a3f2/uploads/origins/0cc0645a-0106-4030-aeac-9d4a0449e43f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29ea050f8fd4207a4b2e72c9aa078f84 3x", "genre": "art", "nsfw": true, "body": "スパロボの如月千歳のリョナをお願いします。\n\n敵に寝返り、敵に信用してもらうためにまず元味方の基地を制圧しようと単身乗り込んで侵攻していく。\nしかし裏方と雑用していなかった千歳に出来るはずもなく、その場に居た兵に四肢を撃ち抜かれて無力化され、命乞いも虚しく豊満な乳房と股間を撃たれた後、首にナイフを刺されて苦しんで死亡。といった流れをイメージしています。\n\n身体付きはムチムチでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/22", "thumbnail_src": "https://si.imgix.net/9b1c0a85/uploads/origins/7faf029c-bfae-4a14-9553-020062a44fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff60c3bcef5004ed9d17373adaeaf074", "thumbnail_srcset": "https://si.imgix.net/9b1c0a85/uploads/origins/7faf029c-bfae-4a14-9553-020062a44fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff60c3bcef5004ed9d17373adaeaf074, https://si.imgix.net/9b1c0a85/uploads/origins/7faf029c-bfae-4a14-9553-020062a44fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=371653a960fac1ded88b779b5d998a20 2x, https://si.imgix.net/9b1c0a85/uploads/origins/7faf029c-bfae-4a14-9553-020062a44fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13e5879638eb8d65eaad8be770a7cf61 3x", "genre": "art", "nsfw": true, "body": "ロマニーとクリミアありがとうございました。めっちゃ好きです。\n今回はリベサガからフリーファイター女(アンドロマケー)と帝国猟兵女(テレーズ)を惨たらしく葬ってください。\n\n「内密な話があります」とテレーズに言われ、下水道まで案内し、アンドロマケーと共に敵に寝返る事を伝えられて襲いかかるが、思いっきり返り討ちに会う。\n思っていたより強かった相手に戸惑い、身ぐるみを剥がされてみっともなく命乞いをするものの、聞き入れて貰えず呆気なく殺されて惨たらしい死体になる感じでお願いします。可能であれば字幕ポイント的な描写もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@CBqsHbF3cI/works/21", "thumbnail_src": "https://si.i