://drive.google.com/file/d/1zdsPH24uu4-sgen3NuACUveVuTaq55Of/view?usp=share_link\n彼は剣を一本だけ持っています。このような場合、剣を持ったアクションポーズをお願いできますか？傭兵の中でも特に真面目で、勝つためなら手段を選ばない。また、一部の人間以外とはあまり仲が良くなく、一部の人間をとても大切にしています。\nお忙しい中、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@AKASA523/works/11", "thumbnail_src": "https://si.imgix.net/cd4ea7c4/uploads/origins/078e3637-2061-4722-b174-2aa0c4ffff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=446e8369999cd3623f19b9fc855bcc18", "thumbnail_srcset": "https://si.imgix.net/cd4ea7c4/uploads/origins/078e3637-2061-4722-b174-2aa0c4ffff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=446e8369999cd3623f19b9fc855bcc18, https://si.imgix.net/cd4ea7c4/uploads/origins/078e3637-2061-4722-b174-2aa0c4ffff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c43789adac6224f1f26c9342f2d475b9 2x, https://si.imgix.net/cd4ea7c4/uploads/origins/078e3637-2061-4722-b174-2aa0c4ffff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41263608f5a81a63bd45ba96dca1cb39 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@AKASA523/works/10", "thumbnail_src": "https://si.imgix.net/fadfe5d6/uploads/origins/7bfb865b-c197-41ac-bf3f-a1618e73006d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b990622736d3332f40cc9fcd838b60", "thumbnail_srcset": "https://si.imgix.net/fadfe5d6/uploads/origins/7bfb865b-c197-41ac-bf3f-a1618e73006d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b990622736d3332f40