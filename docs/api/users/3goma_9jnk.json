c2b60adcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ecb9b8055ff6ea90680d222bd00492, https://si.imgix.net/8edd0f16/uploads/origins/dffb422d-45ec-45e0-87ad-b7c2b60adcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4272ff961eb032869ebdbf900a51268a 2x, https://si.imgix.net/8edd0f16/uploads/origins/dffb422d-45ec-45e0-87ad-b7c2b60adcf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44971b0f00afd170995c50676f571c3a 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nキャラクター\n下記URL作品の使用人さん\nhttps://www.pixiv.net/artworks/125599444\n\n内容\n盗撮された脱糞動画を見ながら悔しそうに乳首オナニーしているイラスト。\n服は着たまま、片手はスマホで動画を見ながら、片手は服に浮き出るほど勃起した乳首を爪でカリカリしている様子をお願いします。\nオホ顔オホ声アクメしながら股間を濡らしている差分もお願いします。\n可能であればアクメ時に服の中に脱糞してしまう様子もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@3goma_9jnk/works/13", "thumbnail_src": "https://si.imgix.net/6d917e48/uploads/origins/e970aa15-b2f4-4791-a4ae-e3529d05bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd67b07133899daa692144d18449fa1", "thumbnail_srcset": "https://si.imgix.net/6d917e48/uploads/origins/e970aa15-b2f4-4791-a4ae-e3529d05bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd67b07133899daa692144d18449fa1, https://si.imgix.net/6d917e48/uploads/origins/e970aa15-b2f4-4791-a4ae-e3529d05bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9eeff8ea475649ce597a88b3d1898b68 2x, https://si.imgix.net/6d917e48/uploads/origins/e970aa15-b2f4-4791-a4ae-e3529d05bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c43223a6589f3e1d3f87b3babe6ee37 3x", "genre": "art", "nsfw": true, "body": "初めまして！今回、自分のオリキャラでの依頼になりますがよろしいでしょうか？キャラ名は「ミスティ」で以前に他の絵師さんに創作してもらいました。最後の方に資料のURLを貼っていますのでご参考になさってください \n\n【キャラについて大まかに説明】\n架空のロボットアニメに登場するエースパイロットの女の子という設定。年齢は12〜13歳くらいだがそれに対して身体の方は大人顔負けなモデル体型の爆乳でIカップ。ツンデレ気質で密かに主人公である「託人（タクト）」という少年に想いを寄せている。\n\n【依頼枚数】\n2〜3枚くらい？\n\n 【依頼内容】 \n上記のミスティが自分と同世代のエロガキ（ミスティと違いこちらは年相応の身体付きだがチンポだけは大人顔負けに立派）に何らかの弱みを握られ屈辱感の中でパイズリ奉仕させられている…といった内容になります。\n※イメージとしてはゴマさんが以前描かれた着衣ズリのようなシチュに近いかと思います（https://www.pixiv.net/artworks/132276733）\n\nエロガキは下乳部にズリ穴を開けたパイロットスーツをミスティに着せて着衣パイズリで爆乳を堪能。ミスティは想い人である託人にこの状況を気付かれてしまう事を気にしつつ奉仕。そしてパイロットスーツの胸元が盛り上がる程に思いっきり射精する。\n\nエロガキはパイロットスーツの胸元を露出させザーメンブリッジを見せるよう指示しミスティはそれに従う。その射精量と濃さにはミスティも思わず賞賛する言葉が出てしまうがすぐに否定する。\n\n最後にお掃除フェラ（フェラをしてるミスティの後ろ姿とフェラ音だけが響く）をさせるエロガキだったが、フェラの知識が皆無な状態から徹底的に仕込んだミスティの極上のフェラテクの成長に驚き快楽に悶えるエロガキの姿が写りフィニッシュ。\n\nミスティとエロガキとの会話と効果音をお願いします  \n\n※キャラ資料URL（https://www.pixiv.net/artworks/128489149）このURL先の10、21ページ目のキャラです\n\n上記内容でお引き受け下さるとありがたいですが、難しいようでしたらお手数ですが再送orキャンセル願います。", "created_at": "", "completed_at": ""}, {"path": "/@3goma_9jnk/works/12", "thumbnail_src": "https://si.imgix.net/d880f22b/uploads/origins/087ac562-d2bb-4a5f-8d13-9c38df5e9bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f53d1f5d8f053ffabf08883c6c8e9f0d", "thumbnail_srcset": "https://si.imgix.net/d880f22b/uploads/origins/087ac562-d2bb-4a5f-8d13-9c38df5e9bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f53d1f5d8f053ffabf08883c6c8e9f0d, https://si.imgix.net/d880f22b/uploads/origins/087ac562-d2bb-4a5f-8d13-9c38df5e9bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04495b856583b89097b5af437d617c6a 2x, https://si.imgix.net/d880f22b/uploads/origins/087ac562-d2bb-4a5f-8d13-9c38df5e9bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eaddf416cc86ba5250f27311439d664 3x", "genre": "art", "nsfw": true, "body": "ゴま。様　はじめまして。\npixivに投稿されていた「ままシ○タ」を見ましてとても好きでリクエストしました！\n\n特にキャラクターの肉付きが好きで「ままシ○タ」のままのお腹、下着から少し溢れる胸、太ももやお尻などとても質感がわかるほど表現されていると感じます！\n\n今回この「ままシ○タ」のままを描いて欲しいことと、もう1人奥様キャラ描いていただき2人のままが登場するイラストを描いて欲しいです。\n\nカラーイラスト2枚描いていただけないでしょうか。\n\nイラストのテーマは催○にかけられたまま2人がエロいダイエットをするというものです。\n\n構図や説明などで不明点があればゴま様の裁量でご変更いただければ幸いです。\n\n一枚目\nイラスト上部\nままたちが「催〇術で激痩せ！」というチラシを見て談笑する様子\n\nイラスト下部（こちらの方を大きく描いて欲しいです）\nチラシ主の元へと訪れた奥様たちが催〇術にかけられている様子を描いて欲しいです。\n\n構図ですが\n奥様2人はベットに座っています。\nとろんとした表情とぼーっとした様子\nチラシ主から催○術を現在進行中でかけられているという様子です。\n（チラシ主は姿なしでお願いします。）\n\nまた操られている雰囲気を出して欲しいので奥様2人の目のハイライトを消して描いて欲しいです！\n\n奥様2人はブラジャーとパンツの下着姿てお願いします！\n\n「ままシ○タ」のままの下着ですが、作品中の赤色の下着姿も素敵でしたが、下着の色とデザインはまた違ったものをみたいです！\n\n2枚目\n催〇にかかったままたちがエロ運動をしている姿を描いて欲しいです！\n\n「ままシ○タ」のままは腰ヘコスクワットポーズをお願いします。\n\nこのようなポーズです。\nhttps://www.pixiv.net/artworks/128039706\n\nもう1人のままはディルドを使って屈伸運動をしている様子を描いて欲しいです。\n\nまたどちらもブルンブルン胸を揺らしている様子を描いていただきたいです。\n「ままシ○タ」でもありましたが\nhttps://www.pixiv.net/artworks/132525036\nこのような感じで胸の残像を描いていただき揺れているという感じをお願いします！\n\nまた2枚目の表情は快楽に溺れている表情をお願いします！\n\nご検討いただけましたら幸いです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@3goma_9jnk/works/11", "thumbnail_src": "https://si.imgix.net/002ad0e1/uploads/origins/8a5d7c4f-f9b4-465e-af75-a3de7b11ef09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0b54c3bd5fdb8af3633a81cde4eb0c", "thumbnail_srcset": "https://si.imgix.net/002ad0e1/uploads/origins/8a5d7c4f-f9b4-465e-af75-a3de7b11ef09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0b54c3bd5fdb8af3633a81cde4eb0c, https://si.imgix.net/002ad0e1/uploads/origins/8a5d7c4f-f9b4-465e-af75-a3de7b11ef09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f26270368ea5bb3fb71142eff690b40b 2x, https://si.imgix.net/002ad0e1/uploads/origins/8a5d7c4f-f9b4-465e-af75-a3de7b11ef09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=127f6ca768db6d8cbd77eb5dbfa1901f 3x", "genre": "art", "nsfw": true, "body": "使用人さんが馬乗りパイズリで顔射されてる所を描いて欲しいです。", "created_at": "", "completed_at": ""}, {"path": "/@3goma_9jnk/works/10", "thumbnail_src": "https://si.imgix.net/f4854757/uploads/origins/98a70673-0ea5-49a5-81ff-4d776c794575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b6412c4ce17f0d1b8d78f68c74f86cd", "thumbnail_srcset": "https://si.imgix.net/f4854757/uploads/origins/98a70673-0ea