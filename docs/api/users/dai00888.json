%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15bbab4b8e109f20d1686714e11edab", "thumbnail_srcset": "https://si.imgix.net/698bb0ef/uploads/origins/645e0275-9998-434e-adfe-686560884d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15bbab4b8e109f20d1686714e11edab, https://si.imgix.net/698bb0ef/uploads/origins/645e0275-9998-434e-adfe-686560884d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbb847e1fc8fa976fe7a4864642efe9c 2x, https://si.imgix.net/698bb0ef/uploads/origins/645e0275-9998-434e-adfe-686560884d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9493536edb53fc1117f8dcceafd56b73 3x", "genre": "art", "nsfw": true, "body": "はじめまして、イラストのリクエスト失礼します。\n\n◇キャラクター\nオンゲキの高瀬梨緒\n◇内容\nシュータードレス姿(資料参照)のイラスト\n構図等はお任せいたします\n※衣装が際どいので念のためNSFW指定してますが、特に気にしなくても大丈夫です。\n\n資料\nhttps://twitter.com/in_spica/status/1847305333238276191\n公式キャラページ\nhttps://ongeki.sega.jp/character/1040/\n\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@dai00888/works/395", "thumbnail_src": "https://si.imgix.net/04f6f7d9/uploads/origins/abe5f491-0d36-4a28-8655-80a813154baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e25da00a6695307b36944efdc4c66263", "thumbnail_srcset": "https://si.imgix.net/04f6f7d9/uploads/origins/abe5f491-0d36-4a28-8655-80a813154baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e25da00a6695307b36944efdc4c66263, https://si.imgix.net/04f6f7d9/uploads/origins/abe5f491-0d36-4a28-8655-80a813154baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1e74f6f058bce634539f6f439747bc7 2x, https://si.imgix.net/04f6f7d9/uploads/origins/abe5f491-0d36-4a28-8655-80a813154baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bed6cd161bbaa6b16c5bad6d4d5de82 3x", "genre": "art", "nsfw": false, "body": "eV様。\n初めまして個人で配信活動をしている、AliceIVIX(ありすいぶいくす)と申します。\n\n今回、私自身のイラストをお願いしたくリク