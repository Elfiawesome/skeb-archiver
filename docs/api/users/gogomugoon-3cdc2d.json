middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fab70a5f19caa9d861359a82ef02336", "thumbnail_srcset": "https://si.imgix.net/d3587a84/uploads/origins/d7330419-9e6d-46fc-b537-9e0edd434984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fab70a5f19caa9d861359a82ef02336, https://si.imgix.net/d3587a84/uploads/origins/d7330419-9e6d-46fc-b537-9e0edd434984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bc13d89a2203d314f442af57a6b7c23 2x, https://si.imgix.net/d3587a84/uploads/origins/d7330419-9e6d-46fc-b537-9e0edd434984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=550c8befc47cbc50002ed6459b3dcdd6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gogomugoon/works/75", "thumbnail_src": "https://si.imgix.net/5a7bb7bd/uploads/origins/d4f5e96f-c718-45b7-9e5d-5d26fd4356d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03303b9c0e9fc55cab5fef98b289b0c1", "thumbnail_srcset": "https://si.imgix.net/5a7bb7bd/uploads/origins/d4f5e96f-c718-45b7-9e5d-5d26fd4356d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03303b9c0e9fc55cab5fef98b289b0c1, https://si.imgix.net/5a7bb7bd/uploads/origins/d4f5e96f-c718-45b7-9e5d-5d26fd4356d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e662df1a6e8ba38ccebbad4f9b0a1d5 2x, https://si.imgix.net/5a7bb7bd/uploads/origins/d4f5e96f-c718-45b7-9e5d-5d26fd4356d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6631e48a13f71e634fd8270cffe13361 3x", "genre": "art", "nsfw": true, "body": "こんにちは。いつも素晴らしいイラストをありがとうございます！\n以下の内容でお願いいたします。\n\n【概要】\n博麗霊夢＆八雲紫（東方Project）が蟲に敗北し、蟲の巣に捕らえられて何匹もの巨大な蟲に群がられて犯され、苗床にされる。\n\n【キャラクター】\n二人とも巨乳で、衣装は破れたキャラクター衣装をまとった状態。おっぱいは露出している。\n紫の方が霊夢より長身で、おっぱいも大き目でお願いします。\n\n容姿、衣装は下記のリンクを参照。\n（霊夢）https://img.altema.jp/lostword/chara/stand/11.jpg\n（紫）https://img.altema.jp/lostword/chara/stand/9.jpg\n\n【背景】\n大量の蟲が蠢く蟲の巣の内部。薄暗く、汚い粘液がそこらじゅうにこびり付いており、臭そうな感じ。\n\n【詳細】\n何匹もの蟲（ゴキブリ、蠅、カマドウマ等）が、何度も付いたり離れたりしながら代わる代わるレイプ＆射精を繰り返し、その度に二人の身体が精液で汚されていく様を描いてほしいです。その他、汚い粘液に塗れたコウガイビルやミミズ、ナメクジが体に絡みついて二人の肌を汚している。二人に群がる蟲はとにかく多ければ多いほど嬉しいです！\n\n内容は、二人の意思や尊厳を無視するように、おまんこを犯す他、イラマチオ、ディープキス、強制パイズリ、ニプルファック、アナルファックなど乱暴に穴という穴を犯す。\n口内射精表現は特に好きなので、汚い精液でドロドロのプールのようになった口内から、うげぇ…と精液が吐き出される描写を入れていただきたいです！\n\n二人の表情は、初めのうちは反抗的に蟲達を睨み付ける→何度も犯されるうちに、嫌悪感に塗り潰されていく感じでお願いします。\n\nキャラクターが汚されていく過程がとても好きなので、何度も犯されるにつれて衣服や身体、髪などが蟲の黄ばんだ精液でべとべとに汚されていく様が見てみたいです！\nラストは見るも無残に全身を蟲の精液でドロドロに汚され、無様な醜態を晒す感じでお願いします。\n何度もパイズリされたおっぱいには精液が大量にこびりついて、乳房の間には精液が何本も糸を言いている。乳首やおまんこから精液を噴出させたり、幼虫をブリブリと産み落としたりなど、蟲の共有肉便器といったような、最底辺に堕ちてしまったとても無様な様子を強調していただけると非常に嬉しいです。\n\n【蟲】\n蟲は巨大で、造形はデフォルメ・ファンタジー要素のない可能な限りリアルな感じでお願いします。\n蟲のペニスは、汚くグロテスクで、臭そうな感じを強調していただきたいです。太くて逞しい、いかにも生殖器らしいものが好みです。表面のつるりとしたものや、先細りのものは好きでないです。\n精液も黄ばんだ、汚くて臭そうな感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gogomugoon/works/74", "thumbnail_src": "https://si.imgix.net/24b2f829/uploads/origins/6d8b9e9d-04a3-45a8-bf3e-66b204be26f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0379d56fc6119cc68301fd1716f326d4", "thumbnail_srcset": "https://si.imgix.net/24b2f829/uploads/origins/6d8b9e9d-04a3-45a8-bf3e-66b204be26f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0379d56fc6119cc68301fd1716f326d4, https://si.imgix.net/24b2f829/uploads/origins/6d8b9e9d-04a3-45a8-bf3e-66b204be26f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b660d5e5608f4c472712664e3672203 2x, https://si.imgix.net/24b2f829/uploads/origins/6d8b9e9d-04a3-45a8-bf3e-66b204be26f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6fa23b820e2bfc4fed0c94f2586994a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gogomugoon/works/73", "thumbnail_src": "https://si.imgix.net/da78ffc7/uploads/origins/793fdbaa-039f-4cf7-be07-f3c849ea94f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ab08d1e6d48f4e4ccb93f9b51884d2", "thumbnail_srcset": "https://si.imgix.net/da78ffc7/uploads/origins/793fdbaa-039f-4cf7-be07-f3c849ea94f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ab08d1e6d48f4e4ccb93f9b51884d2, https://si.imgix.net/da78ffc7/uploads/origins/793fdbaa-039f-4cf7-be07-f3c849ea94f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09d796e39e92f3e9e49ff4ecc8cbea46 2x, https://si.imgix.net/da78ffc7/uploads/origins/793fdbaa-039f-4cf7-be07-f3c849ea94f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0ee3e3f47677fea83a1f8707bc06230 3x", "genre": "art", "nsfw": true, "body": "こんにちは。いつも素晴らしいイラストをありがとうございます！\n以下の内容でお願いいたします。\n\n【概要】\n八意永琳＆蓬莱山輝夜（東方Project）が蟲に敗北し、蟲の巣に捕らえられて何匹もの巨大な蟲に群がられて犯される。\n\n【キャラクター】\n二人とも長身・巨乳でグラマラスな体つき。衣装は破れたキャラクター衣装をまとった状態。おっぱいは露出している。\n容姿は下記のリンクを参照。\n（永琳）https://img.altema.jp/lostword/chara/stand/55.jpg\n（輝夜）https://img.altema.jp/lostword/chara/stand/56.jpg\n\n【背景】\n大量の蟲が蠢く蟲の巣の内部。薄暗く、汚い粘液がそこらじゅうにこびり付いており、臭そうな感じ。\n\n【詳細】\n何匹もの蟲（ゴキブリ、蠅、カマドウマ等）が、何度も付いたり離れたりしながら代わる代わるレイプ＆射精を繰り返し、その度に二人の身体が精液で汚されていく様を描いてほしいです。その他、汚い粘液に塗れたコウガイビルやミミズ、ナメクジが体に絡みついて二人の肌を汚している。二人に群がる蟲はとにかく多ければ多いほど嬉しいです！\n\n内容は、二人の意思や尊厳を無視するように、おまんこを犯す他、イラマチオ、ディープキス、強制パイズリ、ニプルファック、アナルファックなど乱暴に穴という穴を犯す。\n口内射精表現は特に好きなので、汚い精液でドロドロのプールのようになった口内から、うげぇ…と精液が吐き出される描写を入れていただきたいです！\n\n二人の表情は、青ざめた顔で涙を流し、汚い蟲に身体を好き放題犯される嫌悪感に満ちた表情でお願いします。\n\n高貴なキャラクターが汚される様子がとても好きなので、ラストは見るも無残に全身を蟲の精液でドロドロに汚され、無様な醜態を晒す。\n二人の長い髪が蟲の黄ばんだ精液でべとべとに汚されたり、衣服も精液でシミだらけになる様が見てみたいです！\n何度もパイズリされたおっぱいには精液が大量にこびりついて、乳房の間には精液が何本も糸を言いている。乳首やおまんこから精液を噴出させたり、幼虫をブリブリと産み落としたりなど、蟲の共有肉便器といったような、最底辺に堕ちてしまったとても無様な様子を強調していただけると非常に嬉しいです。\n\n【蟲】\n蟲は巨大で、造形はデフォルメ・ファンタジー要素のない可能な限りリアルな感じでお願いします。\n蟲のペニスは、汚くグロテスクで、臭そうな感じを強調していただきたいです。太くて逞しい、いかにも生殖器らしいものが好みです。表面のつるりとしたものや、先細りのものは好きでないです。\n精液も黄ばんだ、汚くて臭そうな感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@gogomugoon/works/72", "thumbnail_src": "https://si.imgix.net/61a6327e/uploads/origins/d82f0288-8ce5-4463-8be2-ab97325944f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc07d879651632f49e8abcf9c0a2cba", "thumbnail_srcset": "https://si.imgix.net/61a6327e/uploads/origins/d82f0288-8ce5-4463-8be2-ab97325944f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc07d879651632f49e8abcf9c0a2cba, https://si.imgix.net/61a6327e/uploads/origins/d82f0288-8ce5-4463-8be2-ab97325944f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c558a3a72627a74b1c158796643d700 2x, https://si.imgix.net/61a6327e/uploads/origins/d82f0288-8ce5-4463-8be2-ab97325944f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7653c81669235db2229d67066b692439 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gogomugoon/works/71", "thumbnail_src": "https://si.imgix.net/f1dc6374/uploa