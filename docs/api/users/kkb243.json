ee-b1c7-5e78c35eb5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4d09d4c6b2c0a4d19fcbd36fba58f5d", "thumbnail_srcset": "https://si.imgix.net/66c3c53a/uploads/origins/ffa66c0b-f282-4eee-b1c7-5e78c35eb5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4d09d4c6b2c0a4d19fcbd36fba58f5d, https://si.imgix.net/66c3c53a/uploads/origins/ffa66c0b-f282-4eee-b1c7-5e78c35eb5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1c61f9d8c07b7057c1e3cb7201a0202 2x, https://si.imgix.net/66c3c53a/uploads/origins/ffa66c0b-f282-4eee-b1c7-5e78c35eb5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfd3f85fb7e590921a4645688925c56b 3x", "genre": "art", "nsfw": false, "body": "黒紅梅/Kurokoubai🎨さん、初めまして。\n趣味で配信活動をしているちえると申します。\n\n今回は私のアバター、マフィアくんのイラストを描いていただきたくリクエストさせていただきました。\nドライフラワー ／ 優里の歌ってみた動画のイラストを描いていただきたいです。\nhttps://www.youtube.com/watch?v=kzZ6KXDM1RI\n\n構図・表情等はすべてお任せさせてください！衣装についてもお任せします。\nいくつか表情差分をつけていただけると助かります。\n画像サイズは配信・動画で使えるように16:9のワイドサイズで描いていただけると嬉しいです。  \n\n▷マフィアくん\n性別：男 \n身長：192cm \n髪型・髪色：灰色～白っぽい感じ\n目の色：赤\n爪は触ったら傷つきそうなくらい鋭い\n中華マフィアのボスで、性格としては邪智暴虐。無邪気で傲慢な性格です。\n人当たりがよく、人懐っこい。これは愛想がいいと物事が円滑に進むことを理解しているため。 人に取り入り利用することに長けている。幼い頃スラムで皇帝に拾われた。\n\n以下は参考資料です。\n参考資料\n世界観：https://lit.link/GreatChieru\nキャラ資料：https://drive.google.com/drive/folders/1XFhOFWwMdwETA6DuhIsDH3Rj8EhkE5-8?usp=drive_link\n可能な限り背景・個々で人物のレイヤーを分けていただきたく、PSDデータ、難しいようであればPNGデータで差分を分けていただきたいです。\n\n◇主な使用場所\nyoutubeやCAS(動画素材・サムネイルとして)、SNS(X、Instagram)等\n\nまたグッズ制作をさせていただき、ネットプリントやbooth等で販売することになるかもしれません。\n商用利用が不可であれば、お手数ですがどこかのレイヤーに商用利用不可の旨をかいていただきたいです。\n\n何か不都合等があればキャンセルしていただいて結構です。\n以上です。長々とお読みいただきありがとうございました。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kkb243/works/6", "thumbnail_src": "https://si.imgix.net/15224668/uploads/origins/0e8ca178-f456-4301-aea1-e401a96af6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6734c8a7e7bb639027b3628a0815bc3", "th