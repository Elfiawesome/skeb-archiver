aece-aafd0d4faef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33c468dadcbd012595b23b0104513477 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/28", "thumbnail_src": "https://si.imgix.net/db18ec13/uploads/origins/ef987d77-bd33-4914-aafe-a3053dc8351f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40cac43168d4d17c6175bbaaf26d04cd", "thumbnail_srcset": "https://si.imgix.net/db18ec13/uploads/origins/ef987d77-bd33-4914-aafe-a3053dc8351f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40cac43168d4d17c6175bbaaf26d04cd, https://si.imgix.net/db18ec13/uploads/origins/ef987d77-bd33-4914-aafe-a3053dc8351f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd2520df4bc346dafe0e2c75cb9a3001 2x, https://si.imgix.net/db18ec13/uploads/origins/ef987d77-bd33-4914-aafe-a3053dc8351f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53650350cbe02adc0ebf78cc91564776 3x", "genre": "art", "nsfw": true, "body": "こんにちはぬるたりり先生\n以前はガルパンのケイなどのリクエストありがとうございました。\n\nまたリクエストをお願いします。\n\nキャラ：葉月いずな（地獄先生ぬーべー）\nhttps://x.com/keisaiyou/status/1921198413443396002\nhttps://neoapo.com/characters/10565\n漫画とアニメで差がありますが、お好きな方でOKです。\n\nシチュエーション：電車に妖怪が出るという噂を聞きつけ、電車に乗り、吊革につかまって立っていたいずな。だが、背後に立った痴漢が突然スカートを捲り、パンツを下し、ペニスを挿入してレイプを始めてしまう。抵抗して騒ぎを起こすと標的の妖怪に自分の存在がバレてしまうため、いずなは無抵抗・無表情で耐える。\n\n構図：\nhttps://x.com/keisaiyou/status/1798964433684959567\nこの構図でお願いします。\n\n要望：竿役が腰を振っているレイプ中の様子をイラストにしてください。\nお尻に髪の毛がかからないようにお願いします。\n\n以上よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/27", "thumbnail_src": "https://si.imgix.net/cbf8a5c2/uploads/origins/ef44502f-f06b-49e2-9873-5b31e9f73cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b9853ad2a720232d8fe2ca7b4a1a621", "thumbnail_srcset": "https://si.imgix.net/cbf8a5c2/uploads/origins/ef44502f-f06b-49e2-9873-5b31e9f73cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b9853ad2a720232d8fe2ca7b4a1a621, https://si.imgix.net/cbf8a5c2/uploads/origins/ef44502f-f06b-49e2-9873-5b31e9f73cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6874f267500e174c6982263ae8702dc8 2x, https://si.imgix.net/cbf8a5c2/uploads/origins/ef44502f-f06b-49e2-9873-5b31e9f73cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed742a0af9628c233bceee081e694776 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/26", "thumbnail_src": "https://si.imgix.net/690909ca/uploads/origins/2c7e1dec-f49c-4712-8694-5a9817a5f69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a3bce9c9b9c50bb86319261268be92b", "thumbnail_srcset": "https://si.imgix.net/690909ca/uploads/origins/2c7e1dec-f49c-4712-8694-5a9817a5f69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a3bce9c9b9c50bb86319261268be92b, https://si.imgix.net/690909ca/uploads/origins/2c7e1dec-f49c-4712-8694-5a9817a5f69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3bd7870316bcace1c94dac0f73cf742 2x, https://si.imgix.net/690909ca/uploads/origins/2c7e1dec-f49c-4712-8694-5a9817a5f69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c32eed820a25b7530d40b5bccc95536 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです、以前御坂のイラストを依頼した者です。\n\n今回は同じくとあるシリーズより、白井黒子のイラストをお願いしたいです。\n\n服装は御坂の時と同じく冬制服。\n・胸元はだけ(資料のようにノーブラorブラごとたくし上げスタイル)\n・ローファー着用\n\n体位は密着騎乗位。\n※資料URLを参照下さい。(約2カ月で自動削除されます)\n\n前回の様に透過断面図と、連続中出し差分を頂ければと思います。\n\nそれと可能であればですが、竿役をふたなりの御坂美琴にしてもらえると嬉しいです。\n※顔自体は資料のように見切れてても大丈夫です。\n\n\nよろしくお願いします。\n\nhttps://ibb.co/C3hX4NKr", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/25", "thumbnail_src": "https://si.imgix.net/7570bb85/uploads/origins/98281e6b-6214-427f-9b82-583006e452fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbde056e0dfcc206541b0440c71a5c9b", "thumbnail_srcset": "https://si.imgix.net/7570bb85/uploads/origins/98281e6b-6214-427f-9b82-583006e452fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbde056e0dfcc206541b0440c71a5c9b, https://si.imgix.net/7570bb85/uploads/origins/98281e6b-6214-427f-9b82-583006e452fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d870bb958f0fcb644922e93f4500dcc5 2x, https://si.imgix.net/7570bb85/uploads/origins/98281e6b-6214-427f-9b82-583006e452fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5770b10afd2aee6aa431e552251ddab3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/24", "thumbnail_src": "https://si.imgix.net/8ea220fd/uploads/origins/1514b368-a6ba-4212-8b96-41bdbe0f1242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=328856f1347fa4051e4fd7c4fe5860f8", "thumbnail_srcset": "https://si.imgix.net/8ea220fd/uploads/origins/1514b368-a6ba-4212-8b96-41bdbe0f1242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=328856f1347fa4051e4fd7c4fe5860f8, https://si.imgix.net/8ea220fd/uploads/origins/1514b368-a6ba-4212-8b96-41bdbe0f1242?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=322b090f3989cf39bd633968f8e425d6 2x, https://si.imgix.net/8ea220fd/uploads/origins/1514b368-a6ba-4212-8b96-41bdbe0f1242?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=947c551707a55a1804a1d0c0510b9537 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。前回は素晴らしいイラストをありがとうございました！！本日は以下のような内容で絵を描いて欲しく思い、依頼をお出ししました。何卒よろしくお願いします。\n\n【キャラクター】\n「ぼくたちは勉強ができない」より古橋文乃\n\n【シチュエーション】\nいわゆる「手の込んだ自殺」というシチュエーションを書いて欲しいです\n女の子が恥ずかしい姿を学生証や免許などの個人情報とと共にカメラに収められてしまうという状況です\n具体的には\n・両手でピースさせられている\n・イかされまくってみっともない顔を晒している\n・カメラに目が合っていない\n・胸と股間をさらしている、靴下あり\n・天花大学理学部天文学科の学生証が置いてある\n・男はカメラに写っていない\n\n【設定】\n大学に入った古橋文乃がヤリサーで酔わされ、ホテルに連れ込まれ犯されるという設定\n\n可能であれば体に落書きされた差分をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/23", "thumbnail_src": "https://si.imgix.net/17522780/uploads/origins/0b35ddb3-9e36-42c4-ba41-ce1c88c4e358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faf9c137833ada081e60d7635aaef1b3", "thumbnail_srcset": "https://si.imgix.net/17522780/uploads/origins/0b35ddb3-9e36-42c4-ba41-ce1c88c4e358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faf9c137833ada081e60d7635aaef1b3, https://si.imgix.net/17522780/uploads/origins/0b35ddb3-9e36-42c4-ba41-ce1c88c4e358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb195c742aba228f19fb0ee3d005fa2 2x, https://si.imgix.net/17522780/uploads/origins/0b35ddb3-9e36-42c4-ba41-ce1c88c4e358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b85a926410c36a588648b61c54c1856 3x", "genre": "art", "nsfw": true, "body": "前回御坂を依頼した者です。\n\n是非続きを描いて頂きたいと思い、再びリクエストさせて頂きました。\n\n服装は前回と同様ですが、時系列的に矛盾もあるもののローファーが好きなのでローファー有でお願いします。\n\nシチュは前回の続きで、そのまま御坂が男を押し倒して杭打ち騎乗位になった状態。\n体位は資料URLの左側を参考願います。視点も資料のような正面から。\n\n断面図も前回同様にお願いします。\n\n差分についてですが、子宮内挿入の表現があるので、どうしても不可であればキャンセル頂くか、子宮内挿入無しの表現に変えて頂く形でお願いします。\n表現しにくければ男根を前回より大きめに描いて頂いたりしても構いませんので(子宮挿入で興奮してさらに勃起した的な設定に)適宜調整してもらえればと思います。\n\n\n1、前回の続きで抜かずにさらに奥に挿入し、子宮口に少し亀頭が入っているところ。\n2、子宮内に挿入して直接射精させる。カリを子宮口に引っ掛けたような状態なので栓になっていて精子が殆ど漏れず、子宮が少し膨らむ。\n3、そのまま(ぬちっぬちゅっと)ゆっくり腰を振っているところ。\n4、もう一度子宮内で直接射精されながら絶頂。さらに子宮が膨らむ。\n(可能であれば5、余韻シーン。まだまだ出してもらうわよと言わんばかりの雰囲気)\n\n\n以上、よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/116417145", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/22", "thumbnail_src": "https://si.imgix.net/57cacb72/uploads/origins/1c527f47-d7c0-4627-91b2-3b96ce764d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc35232ba6fa151f6c2558eab8093b45", "thumbnail_srcset": "https://si.imgix.net/57cacb72/uploads/origins/1c527f47-d7c0-4627-91b2-3b96ce764d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc35232ba6fa151f6c2558eab8093b45, https://si.imgix.net/57cacb72/uploads/origins/1c527f47-d7c0-4627-91b2-3b96ce764d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=541ae5c7084f04308b97f57768525f75 2x, https://si.imgix.net/57cacb72/uploads/origins/1c527f47-d7c0-4627-91b2-3b96ce764d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c29a8988d0dcedf31c2736d44ff84f87 3x", "genre": "art", "nsfw": true, "body": "初めまして！いつもぬるたりり様の絵を楽しませて頂いています。特に武本うるかの絵がお気に入りです！！今回は以下のような絵を描いていただきたく思い、依頼を出しました。何卒ご検討のほどよろしくお願いします。\n\n【キャラクター】\n「ぼくたちは勉強ができない」より古橋文乃\n\n【シチュエーション】\n武本うるかの絵と全く同じ\n更衣室で着替えてるところを盗撮される\n特にあのうるかの羞恥の表情が好きなので、よろしくお願いします\nセリフも前回と同様に\n「うっわ...エッロ...！早く撮れって！」\n「え！？」「誰...！？カ、カメラ...！？」\n「やべっ...！！」「撮れた！！逃げるぞ！！」\nという感じでお願いします\n「うるかさん　下、整えてるんだ...」という部分は文乃に合わせて変えていただけると嬉しいです\n\n他の依頼もある中お忙しいかもしれず恐縮なのですが、お引き受けいただけると嬉しいです。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/21", "thumbnail_src": "https://si.imgix.net/984e993e/uploads/origins/c1aa0b18-6a3d-428e-a92f-98bffd664efc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eae8aae07d32a11e77d7d0d55e8a679", "thumbnail_srcset": "https://si.imgix.net/984e993e/uploads/origins/c1aa0b18-6a3d-428e-a92f-98bffd664efc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eae8aae07d32a11e77d7d0d55e8a679, https://si.imgix.net/984e993e/uploads/origins/c1aa0b18-6a3d-428e-a92f-98bffd664efc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cb2f0c07dfc950db65a337d5cc5ed91 2x, https://si.imgix.net/984e993e/uploads/origins/c1aa0b18-6a3d-428e-a92f-98bffd664efc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df176b397ca6271a4005b9e969c9bad6 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nとある科学の超電磁砲の御坂美琴のイラストをお願いしたいです。\n\n・体位\n資料URLのような対面座位(キスはしてなくてOK)\n\n・服装等\n冬服(下記参照)\nhttps://tsundora.com/image/2020/05/to_aru_majutsu_no_index_281-721x1024.jpg\n※可能であれば基本着衣で、胸元はだけ。\n\n・その他、差分など\nカットインではなく透過の断面図を付けて頂きたいです。\nまた、下記の差分をお願いしたいです。\n①(御坂が)腰を振っているところ\n②膣内射精させているところ\n③抜かずにそのまま腰を振っているところ\n④さらに膣内射精させているところ\n\n\nよろしくお願いします。\n\nhttps://ibb.co/XfPVqxS", "created_at": "", "completed_at": ""}, {"path": "/@NullTaLily/works/20", "thumbnail_src": "https://si.imgix.net/45a86859/uploads/origins/a3e4d0fb-a7e6-4bc0-8e30-692db9712534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39e8dc37e1cc9d756719668d5e19a7eb", "thumbnail_srcset": "https://si.imgix.net/45a86859/uploads/origins/a3e4d0fb-a7e6-4bc0-8e30-692db9712534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39e8dc37e1cc9d756719668d5e19a7eb, https://si.imgix.net/45a86859/uploads/origins/a3e4d0fb-a7e6-4bc0-8e30-692db9712534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txt