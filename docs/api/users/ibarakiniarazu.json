dle%2Ccenter&txtsize=30&txt=PRIVATE&s=38c991b579d38a0e789c82e8d43960ab", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/68", "thumbnail_src": "https://si.imgix.net/f2931739/uploads/origins/ee58cce9-4be2-401a-aac7-5c64f55ea75d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=006b838e31801648ac21587eb9e254b1", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/67", "thumbnail_src": "https://si.imgix.net/bf63c433/uploads/origins/d60fefc6-0423-472c-981f-4bfcf5d06913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9edbcd13209e91e4e9a342be2d71f522", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/66", "thumbnail_src": "https://si.imgix.net/4b0b080b/uploads/origins/e0e62720-5986-4ebb-9490-6dbb06f7e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b2fb506363c34364603cc71b40a4845", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "みとしさん、お久しぶりです。前回は大変ありがとうございました。\n\nもしよければ、まだ名づけていないシャム猫娘のうちのこの絵をお願いしたいです。\nhttps://toyhou.se/30474719.name-tbd\n\n最近は、明治時代・大正時代に流行った、和服と洋服をちょっと混ざったファッシオンがとても魅力的に思い、その時代の服またはそれからインスパイアされた服を着ているところを描いてもらえると嬉しいです。特に、着物とブーツのコンビ、そして羽織と帽子のコンビが好きです。インバネスコートも好きです。（男装しても構いません）\n\nどんな服が好きかを示すためいくつかの画像を集めてみました。これっぽい衣装を着せてくださると嬉しいです。\nhttps://imgur.com/a/VlWDy7m\n\nシチュエーションは、写真のポーズをとっているでいいと思います。絵を二枚お願いしてもよろしければ、一枚目は昔の写真のシリアスな雰囲気で、二枚目は写真を撮った直後、楽しそうに笑っている、または現在な写真のポーズをとっているような雰囲気で描いてもらえるととても嬉しいです。無理なら是非みとしさんが描きたいほうだけを描いてください。\n\nあと、みとしさんは語感がよくわかる方の印象がしますが、名前について相談してもよろしいですか・・・？\n斑目嵐のデザインを作ってくれた時、名前のフィクションさの評価はとても助かりました。イタい名前、または普通過ぎて一般人っぽい名前にしたくありませんです。\n\n検討中名前はこの五つ：\n藤樹悠（ふじき　はるか）\n冬季春花（とうき　はるか）\n権守蘭花（ごんもり　らんか）\n白沢萌波（しらさわ　もなみ）\n尾上咲（おのうえ　さく）\n\nおかしかったら容赦なく本音をいってください。\n\n複雑な依頼ですみません。ご検討ありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/65", "thumbnail_src": "https://si.imgix.net/87d9f589/uploads/origins/9b9db0ca-d460-4af6-861c-3f77a8065941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19052b46599592dca119333f4704c742", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/64", "thumbnail_src": "https://si.imgix.net/78e3c807/uploads/origins/4506be7f-3f32-4f11-a523-4e7e9d59129a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf8cc3b71db2f28ffe5b8023415e5f61", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、みとしさん！はじめまして。私はあなたのアートをかなり長い間追いかけていて、あなたの服のデザインの大ファンです！そして、デザインの過程やちょっとしたディテールを説明してくれる注釈を読むのがとても楽しいです！私のキャラクターの衣装をデザインしていただけませんか？\n\nエロイサはヴィクトリア朝の貴族の家系で、2人兄弟の妹です。性格的には、とても社交的で活発。宮廷の人々は彼女のカリスマ性に惹かれ、貴族であるにもかかわらず、謙虚で実直な性格だ。ルールはあまり好きではなく、従うことが苦手。エチケットを守り、人前で決まった振る舞いをしなければならない社交の場は、彼女にとって個人的な悪夢だ。ちょっと頑固で生意気なところもある。\n\n社交ダンスが得意で、ダンスは彼女の人生における情熱のひとつだ。長く、派手で、装飾過多なドレスを着て動き回るのは難しいので、彼女は丈が短く、どちらかというとシンプルなドレスを着て踊る。そのため、ときどき不愉快な視線を浴びるが、エロイサはまったく気にしない。\n\nヴィクトリア朝ファッションにインスパイアされたエロイサの新しい衣装をリクエストしたい。具体的には、\"ウォーキング・ドレス \"と呼ばれるようなドレスです。参考になるような写真をいくつか用意しました。エロイサのファッションの好みから、この衣装は過度に堅苦しくなく、シンプルな方だが、エレガンスを醸し出している。このドレスは、エロイサの両親が正しいドレスコードに従わなかったとしても、彼女をあまり叱らないような洗練されたものです😂私はこのドレスにフリルのついた袖をつけてほしいのですが、それは長くても短くても構いません。もし差し支えなければ、エロイサの日傘のデザインもお願いします！\n\nいつもは緑と白を基調にした服を着せたいのですが、今回は全体の色調をみとしさんにお任せしたいと思います。他の色がこの服のデザインに合うと思ったら、自由に使ってください！ただ、エロイサのイヤリングだけは元のデザインから残しておいてください。もしよろしければ、髪型も変えてみてください。髪をルーズにしたり、ポニーテールにしたり。リボンや帽子で髪や頭を飾るのも素敵です。その他、ご希望はみとしさんにお任せします。\n\nここまで読んでくださり、また私のリクエストを考慮してくださり、本当にありがとうございました！💚\n\nhttps://drive.google.com/drive/u/2/folders/1O6KpmekcrRxqXvbKJQnfLkqH-VDq4kuN", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/63", "thumbnail_src": "https://si.imgix.net/c54ef667/uploads/origins/f91e18c8-d478-4676-b110-75a6e429f4cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad818c29420f4861ae5ca4b73eba7e1c", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/62", "thumbnail_src": "https://si.imgix.net/61fad3bf/uploads/origins/820d5ddb-1a1a-4442-9c2f-0c110ef91dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c8e78a414d2fc6d72b26ccb7c7f594e", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibarakiniarazu/works/61", "thumbnail_src": "https://si.imgix.net/8b5dbe48/uploads/origins/f3a3af19-a797-4384-b795-dbcb47f0ce54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0833a30cf3cfbeb4b03505c713ffe909", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}