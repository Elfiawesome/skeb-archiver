8fc-4cb6-bd68-048e91dbfdd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde89f02eb5b8e4e117632f7ae6046ad, https://si.imgix.net/19624d54/uploads/origins/bf5435c7-b8fc-4cb6-bd68-048e91dbfdd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ba0a85a415ff96a3e1194e5e8e2bbd1 2x, https://si.imgix.net/19624d54/uploads/origins/bf5435c7-b8fc-4cb6-bd68-048e91dbfdd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34688e2d013696095098a1f61d5f880e 3x", "genre": "art", "nsfw": false, "body": "小太郎さん、こんにちは！\n\n小太郎さんの漫画はとてもかわいいと思います！私はストレルカちゃんが大好きです。小太郎さん風に描いてくれませんか？ポーズは自由ですが、幸せそうな表情がいいです！\n\nhttps://drive.google.com/drive/folders/15_-abPX7YskrGWazOsfysqJ3dqJTFguk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@DaiYuusha/works/1", "thumbnail_src": "https://si.imgix.net/bc29c02b/uploads/origins/9c289876-0eea-46e1-8752-53fcb691d8b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a459c4525afdff697f168ab4397c481", "thumbnail_srcset": "https://si.imgix.net/bc29c02b/uploads/origins/9c289876-0eea-46e1-8752-53fcb691d8b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a459c4525afdff697f168ab4397c481, https://si.imgix.net/bc29c02b/uploads/origins/9c289876-0eea-46e1-8752-53fcb691d8b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5111e18ed49dfcd70cb688103a4e8ef0 2x, https://si.imgix.net/bc29c02b/uploads/origins/9c289876-0eea-46e1-8752-53fcb691d8b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ee7a10c4302b14cc8d98f32e64900ff 3x", "genre": "art", "nsfw": false, "body": "アイコンの子の立ち絵を描いていただきたいです。\n基本的に目はジト目（半開き）でお願いします。\n猫目に円が付いているような瞳になっています。（イメージは資料URLにあります。）\n跳ねてる髪はアイコンよりも少し寝かせてもらえると嬉しいです（構図は資料URLにあります。）\n\nヘッドセットの表示で喜怒哀楽の4パターン【(^^,｀´, T T, ・・)表示の例です】と、\n目の開閉の2パターン、口パクのための開閉2パターンを\n背景は透過している状態でpsd形式でいただけますでしょうか。\n用途としては、ライブ配信などでアイコンとして使用する予定です。\n\nパターン数が多くて申し訳ありませんが、以上よろしくお願い