b6e-14bb-4fdd-b094-836a84a119e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f820119622af4728bccac4465ebec5b 2x, https://si.imgix.net/be5a953d/uploads/origins/625c4b6e-14bb-4fdd-b094-836a84a119e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fadf7fa1e393335f29804ec6e00fe3c1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたのアートスタイルがとても好きなので、もうひとつお願いがあります！\n\nブルーアーカイヴの野々上伊佐弥のウェストアップをお願いしたいのですが、ウェディングドレスを着て、黄色と白の花束を持っています。元気な笑顔もお願いします。できれば、目を開けたバージョンと閉じたバージョンもお願いします。\n\n野々美の参考資料＆表情（デフォルトと1箱目のような笑顔が希望）：https://x.com/Blue_ArchiveJP/status/1537993561572261888\n\nポーズ・衣装の参考：https://x.com/MauveSR/status/1807355154422980811\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@yowapoo/works/15", "thumbnail_src": "https://si.imgix.net/7cf00578/uploads/origins/75c343f2-af6b-47f8-959d-70ea213e5dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7ee7c47c19254497ac395eb52e06f73", "thumbnail_srcset": "https://si.imgix.net/7cf00578/uploads/origins/75c343f2-af6b-47f8-959d-70ea213e5dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7ee7c47c19254497ac395eb52e06f73, https://si.imgix.net/7cf00578/uploads/origins/75c343f2-af6b-47f8-959d-70ea213e5dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f21144924a733dc1afdd917539abc0eb 2x, https://si.imgix.net/7cf00578/uploads/origins/75c343f2-af6b-47f8-959d-70ea213e5dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4615cf370494fd60c5610cca95683292 3x", "genre": "art", "nsfw": false, "body": "こんにちは！パンドラ・ピークス（スレンダーボディに巨乳の90年代グラマーモデル）の絵を、あなたの素晴らしい画風でお願いしたいのですが。彼女は下のURLのビデオと同じドレスを着ているはずです。\n\n胸の大きさを強調するような自信に満ちたポーズで描いてください。その他はお任せします。\n\nありがとうございました！\n\nhttps://youtu.be/9N8jZM5RQUU?t=122", "created_at": "", "completed_at": ""}, {"path": "/@yowapoo/works/14", "thumbnail_src": "https://si.imgix.net/0e0e6e76/uploads/origins/6a1180fb-0b48-461d-88ba-e2a220d06b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20e8fe1975dcc546d1c99172d604188d", "thumbnail_srcset": "https://si.imgix.net/0e0e6e76/uploads/origins/6a1180fb-0b48-461d-88ba-e2a220d06b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20e8fe1975dcc546d1c99172d604188d, https://si.imgix.net/0e0e6e76/uploads/origins/6a1180fb-0b48-461d-88ba-e2a220d06b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1bba8499cbfae6366d13c25693929d3 2x, https://si.imgix.net/0e0e6e76/uploads/origins/6a1180fb-0b48-461d-88ba-e2a220d06b4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85c3d17a24f32b7e4ab1438e83728beb 3x", "genre": "art", "nsfw": false, "body": "僕のキャラクターを描いてほしい！名前はデカ。https://toyhou.se/18006891.deca\nしっぽの長いシャチの女の子なんだけど、しっぽを全部描く必要はないんだ。\n\n表情：\nデカは傲慢な女の子なので、そのように描いてほしいです。笑顔で歯をむき出している感じとか。\n\n服装：\n普段着で描いてほしい（URLの最初の3枚の画像にあります）。\n- ベレー帽\n- ラテックススーツ\n- 太ももまであるブーツ\n- 特注トップス\n- フィンガーレスグローブ\n- 十字のヘアクリップ\n彼女の服装に戸惑うなら、ラテックス・スーツ単体で十分だ。\nまた、いつもの髪型で描いてほしい（最初の画像にある）。\n\n背景：\n背景は冷たいものがいい！雪のような、氷のような？\n\nこれで十分だと思います！読んでくれてありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@yowapoo/works/13", "thumbnail_src": "https://si.imgix.net/8a51046c/uploads/origins/81688747-6e06-492f-812e-03448cf5f322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b099b2ffa3447bc94b0c08b09dfcfd3", "thumbnail_srcset": "https://si.imgix.net/8a51046c/uploads/origins/81688747-6e06-492f-812e-03448cf5f322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b099b2ffa3447bc94b0c08b09dfcfd3, https://si.imgix.net/8a51046c/uploads/origins/81688747-6e06-492f-812e-03448cf5f322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e91fe245f23007256b10798984405dd4 2x, https://si.imgix.net/8a51046c/uploads/origins/81688747-6e06-492f-812e-03448cf5f322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=20