leted_at": ""}, {"path": "/@yowapoo/works/11", "thumbnail_src": "https://si.imgix.net/fc71aa0f/uploads/origins/8bf33dcb-ce3e-449d-8c30-b01b20de88fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0c3f828ee882c43e51f869ac80324d", "thumbnail_srcset": "https://si.imgix.net/fc71aa0f/uploads/origins/8bf33dcb-ce3e-449d-8c30-b01b20de88fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0c3f828ee882c43e51f869ac80324d, https://si.imgix.net/fc71aa0f/uploads/origins/8bf33dcb-ce3e-449d-8c30-b01b20de88fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61679473a2cd334311269282ca7e6ac7 2x, https://si.imgix.net/fc71aa0f/uploads/origins/8bf33dcb-ce3e-449d-8c30-b01b20de88fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b006fc147f890a97350b0b54bb19b3e6 3x", "genre": "art", "nsfw": false, "body": "はじめまして、カチューシャと申します。\nyowa.さんのOC創作がとても可愛くて大好きなので今回リクエストさせていただきました！\n\nオリジナルキャラクターの花宙(かちゅう)シヤのイラストを描いていただきたいです。参考画像はTwitterのハッシュタグ「#画チューシャ」で検索頂くか、下記リンクを確認お願いします。\nhttps://x.com/Kachu_Shiya/status/1770041244594368526?s=20\n\nイラスト内容については、yowa.さんのOCイラストのテイストや色使いがとても可愛くて凄く好きだったので可能であればお任せしたいです。\n\n大変お手数ですが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yowapoo/works/10", "thumbnail_src": "https://si.imgix.net/46319158/uploads/origins/37660d4f-cdb9-4d8f-a702-001509671a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daec07c2d052a78824b8799a493103f9", "thumbnail_srcset": "https://si.imgix.net/46319158/uploads/origins/37660d4f-cdb9-4d8f-a702-001509671a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daec07c2d052a78824b8799a493103f9, https://si.imgix.net/46319158/uploads/origins/37660d4f-cdb9-4d8f-a702-001509671a52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=355cf1ee3b8f2b4291b852ad21069dee 2x, https://si.imgix.net/46319158/uploads/origins/37660d4f-cdb9-4d8f-a702-001509671a52?bg=%23