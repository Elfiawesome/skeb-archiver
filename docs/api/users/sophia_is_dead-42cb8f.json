965489be/uploads/origins/194137fb-5158-4b8c-88ff-b9c2e783d048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abdcf8acbbc09f419ee5851d00c09498", "thumbnail_srcset": "https://si.imgix.net/965489be/uploads/origins/194137fb-5158-4b8c-88ff-b9c2e783d048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abdcf8acbbc09f419ee5851d00c09498, https://si.imgix.net/965489be/uploads/origins/194137fb-5158-4b8c-88ff-b9c2e783d048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a47a3a6c968172788f0cdae060486c3 2x, https://si.imgix.net/965489be/uploads/origins/194137fb-5158-4b8c-88ff-b9c2e783d048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c9d70f2d24404dcc99d6d50437839d1 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの作風がとても好きです！ 私の2人のオリジナルキャラクターを描いてほしいです。\n\n-黒い肌とウェーブのかかった髪のキャラクターは178cm。科学者のアシスタントで、上司の日常生活を助けている。 とても陽気でのんびりしているが、心配性。\n\n-乱れた黒髪とメガネのキャラクターは148cm。\n薬と手術で助手の命を救ったマッドサイエンティスト。頭脳明晰だが変わり者。実験が雑になることもあるが、いつも助手を生かしている。\n\n二人の関係は普通ではない。思いつくままに描いてください！ありがとうございました。\n\n使用方法\n-印刷物、物理的メディア\n-今後のコミッションアートの参考\n\n可能であれば高解像度のPSDデータをお送りください。\n\nhttps://drive.google.com/drive/folders/18yzbteRavKmZrQjBEdQVFnMwD2TTYcWl?usp=sharing\n\nhttps://drive.google.com/drive/folders/18yzbteRavKmZrQjBEdQVFnMwD2TTYcWl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sophia_is_dead/works/15", "thumbnail_src": "https://si.imgix.net/d6b524f1/uploads/origins/8d0cb178-2cda-408c-897c-2cfcd7320931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4845f169614c5feb9c9a4dedbc962a23", "thumbnail_srcset": "https://si.imgix.net/d6b524f1/uploads/origins/8d0cb178-2cda-408c-897c-2cfcd7320931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4845f169614c5feb9c9a4dedbc962a23, https://si.imgix.net/d6b524f1/uploads/origins/8d0cb178-2cda-408c-897c-2cfcd7320931?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df3