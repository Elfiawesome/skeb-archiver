bb-417a-9d5c-b0f6fd513bc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c0ff4348ad3bcc0fa9320c49986b504 2x, https://si.imgix.net/bc48a972/uploads/origins/474efdbc-c8bb-417a-9d5c-b0f6fd513bc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55d9accd6c50023c5af1e2ca730adec6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yomotake081/works/73", "thumbnail_src": "https://si.imgix.net/a081fcaa/uploads/origins/086eadf0-b87d-470b-9a8b-596eaf6e02c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d68c57b58ab1e1072e98591de45975df", "thumbnail_srcset": "https://si.imgix.net/a081fcaa/uploads/origins/086eadf0-b87d-470b-9a8b-596eaf6e02c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d68c57b58ab1e1072e98591de45975df, https://si.imgix.net/a081fcaa/uploads/origins/086eadf0-b87d-470b-9a8b-596eaf6e02c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83194ac0b7d41eb08c0511aa957fe952 2x, https://si.imgix.net/a081fcaa/uploads/origins/086eadf0-b87d-470b-9a8b-596eaf6e02c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b765664f192a86ed1db2a09670752d1e 3x", "genre": "art", "nsfw": true, "body": "同じキャラの依頼で申し訳ないですが\nクミルちゃんでお願いします\n\n相手はキモイおっさん\n人でありながらクリーチャーの僕として情報を流している\n見返りにクリーチャーの餌食となった女の子を\n美味しく頂いているゲスなキャラです\n以前より狙っていたロリ巨乳のクミルちゃんが今回のご褒美\nクミルちゃんはクリーチャーに眠らされていて\nオッサンに好き放題されちゃうという・・\n今回は睡姦でクミルちゃんは終始無意識・無反応\n睡姦なので目は閉じていて\n口元が僅かに開いている表情でお願いします\n\n1・道端ですれ違うクミルちゃんとオッサン\n　　クミルちゃんはオッサンに挨拶\n　　オッサンもそれに応える\n　　が、その目はクミルちゃんの揺れる巨乳に・・\n　　構図としては\n　　クミルちゃんの姿はこちら向きで\n　　オッサンは後ろ姿で全身入れなくてOKです\n　　カットインで\n　　1・横目でクミルちゃんのオッパイをエロい目で凝視のオッサン\n　　2・クミルちゃんの揺れる巨乳\n　　3・舌なめずりするオッサンの口元\n　　の３カットを入れてほしいです\n\n2・クミルちゃんは\n　「壁に追い詰められて」の姿勢で\n　カメラアングルは横方向から\n　シャツをたくし上げお預けを食っていた犬のように\n　オッパイに夢中でむしゃぶりつくオッサン\n　片手をパンティに忍び込ませクチュクチュ\n\n　横方向からなら\n　オッパイのボリュームと\n　それにむしゃぶりつくオッサンの表情が\n　わかりやすいかと思ったのですが\n　この感じを重点にしたいなら\n　もっと良い構図があるよということであれば\n　お任せいたします\n\n3・姿勢はおまかせしますが\n　　後ろから挿入される絵でお願いします\n　　顔をオッサンの方に向けさせ\n　　口を吸う・またはベロチュー\n　　オッパイを揉み上げながら\n　　クミルちゃんに密着して腰を振るオッサン\n　　\n4・トライレイバー編で\n　　以前より私の一番のお気に入りとさせてもらっている\n　　「うっ」中出しの構図でお願いしたいです\n　　大きなオッパイに吸い付きながら\n　　パンティをずらして挿入\n　　\n5・中出し差分\n\n今回も着衣で挿入はパンティずらしでパンティは装飾なしの白で\nおっぱいに吸い付く・挿入して腰を振ってる擬音も適度に入れてほしいです\nクミルちゃんの顔を表情（眠らされてますが）\nが見える描写でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@yomotake081/works/72", "thumbnail_src": "https://si.imgix.net/a6ceecc4/uploads/origins/1ba22071-ac65-496c-8a9f-eda61e5d9c14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edd218f2e4f25cbe83bcbaaea874acd3", "thumbnail_srcset": "https://si.imgix.net/a6ceecc4/uploads/origins/1ba22071-ac65-496c-8a9f-eda61e5d9c14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edd218f2e4f25cbe83bcbaaea874acd3, https://si.imgix.net/a6ceecc4/uploads/origins/1ba22071-ac65-496c-8a9f-eda61e5d9c14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=315f2a8deac5312c8de43dff09da85b3 2x, https://si.imgix.net/a6ceecc4/uploads/origins/1ba22071-ac65-496c-8a9f-eda61e5d9c14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a251c56dc22e9e85ce3c8d9e9085f6a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yomotake081/works/71", "thumbnail_src": "https://si.imgix.net/4fa7b483/uploads/origins/