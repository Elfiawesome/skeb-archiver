時間と予算が許すようであれば、膣内に入れる前に竿役がイチモツをカミムスビの秘部に擦り付けて、竿役のイチモツを見て「フー♡、フー♡」とカミムスビがエッチな顔で今から犯される興奮と期待でいっぱいになっている様子と、膣内に思い切り射精されて恍惚な表情(ハート目)で「～～～ッ!!♥」のような声にならない声を出して絶頂してしまう差分をお願いしたいです。(擬音や効果音などのセリフを入れてくださると幸いです。)\n\n前回のリクエストよりも要求が多くなってしまい申し訳ありません。\n\nhttps://skeb.jp/requests/3034348", "created_at": "", "completed_at": ""}, {"path": "/@hamachi_oekaki/works/104", "thumbnail_src": "https://si.imgix.net/ed38010f/uploads/origins/02641e2e-7457-4959-ba7e-32208adf80df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b166010afd1dc0a5f2844ad0a32aac95", "thumbnail_srcset": "https://si.imgix.net/ed38010f/uploads/origins/02641e2e-7457-4959-ba7e-32208adf80df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b166010afd1dc0a5f2844ad0a32aac95, https://si.imgix.net/ed38010f/uploads/origins/02641e2e-7457-4959-ba7e-32208adf80df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0adaaf1733f727e38a93f232c75d9b94 2x, https://si.imgix.net/ed38010f/uploads/origins/02641e2e-7457-4959-ba7e-32208adf80df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7da10b4bc0236abb70d1293a70e85067 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hamachi_oekaki/works/103", "thumbnail_src": "https://si.imgix.net/b93ecd72/uploads/origins/7b81d3a3-093c-4e49-ba59-0a15b7bb9903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49a448597d3f5735e0c11151399072e2", "thumbnail_srcset": "https://si.im