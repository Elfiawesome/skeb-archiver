01c-833a-9dbe54da8c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db2c4a71bb63daa94775685446384b86, https://si.imgix.net/2ee71cf1/uploads/origins/361caab4-4c70-401c-833a-9dbe54da8c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1bbdf5865f3557ff2ea9797f10a1d99 2x, https://si.imgix.net/2ee71cf1/uploads/origins/361caab4-4c70-401c-833a-9dbe54da8c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f63677dcfef23002b98e1b40d53be3e6 3x", "genre": "art", "nsfw": true, "body": "一切ショタに無関心の葵ちゃんの上履きの日常(射精地獄)  \n\n_______ \n今回は葵ちゃんが上履きの中のショタを一切気にすることなく朝学校に登校しているイラスト  \n\n_______\n\n 今回も1.2.3が上履きアップのミニイラストの4が葵ちゃんの全体像という形を想定しております。\n\n  1.毎朝のルーティーンで当たり前の様に、上履きの中にピッタリ収まっているショタのちんちんをつま先で触れるだけで射精(ピッタリ過ぎて身動きが取れない )\n\n\n\n2.上履きの中に葵ちゃんのつま先が突っ込まれるイラスト※ショタ射精  \n\n3.ただでさえキツイのに葵ちゃんのソックス足が容赦なく上履きに収まるイラスト(上履きから射精した精子が漏れ出ている)  \n\n4.友達(描かなくていい)と挨拶を交わす葵ちゃんの全体像\n _______\n  ※最後の葵ちゃんの全体像のところでカットイン的な吹き出し？でショタが上履きの中で射精している演出をお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/23", "thumbnail_src": "https://si.imgix.net/f2f79300/uploads/origins/460eb28d-6246-4bda-8a20-adbb705e3a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4c897e660a03b07c7de3e17441f65e9", "thumbnail_srcset": "https://si.imgix.net/f2f79300/uploads/origins/460eb28d-6246-4bda-8a20-adbb705e3a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4c897e660a03b07c7de3e17441f65e9, https://si.imgix.net/f2f79300/uploads/origins/460eb28d-6246-4bda-8a20-adbb705e3a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e949c6c7369cd6ac81a7e8e5efc9ca51 2x, https://si.imgix.net/f2f79300/uploads/origins/460eb28d-6246-4bda-8a20-adbb705e3a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcd13ad8f00a77126d2bdf8eb8c45cc5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/22", "thumbnail_src": "https://si.imgix.net/62c20ef3/uploads/origins/d99381cc-dee4-400d-90ee-7220e06fd501?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e48afb70d73ac66da3ceaf4e2fd263", "thumbnail_srcset": "https://si.imgix.net/62c20ef3/uploads/origins/d99381cc-dee4-400d-90ee-7220e06fd501?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e48afb70d73ac66da3ceaf4e2fd263, https://si.imgix.net/62c20ef3/uploads/origins/d99381cc-dee4-400d-90ee-7220e06fd501?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89d23c22c4bc3ce2de9c51bb8b70f032 2x, https://si.imgix.net/62c20ef3/uploads/origins/d99381cc-dee4-400d-90ee-7220e06fd501?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12923293263047f2e8f981520ed51cf2 3x", "genre": "art", "nsfw": true, "body": "はじめまして、絵柄が好みでリクエストさせていただきました。\n特にM男向け、女性上位のシチュではなく好みではないかもしれませんが是非ご一考いただければ幸いです。\n\n私のオリキャラの銀髪ママのイラストをお願いします。\n\n■OC設定\n・参考画像\nhttps://imgur.com/A9moyoA\nhttps://www.pixiv.net/artworks/111830643の左\nhttps://www.pixiv.net/artworks/113750847\n・母親キャラ\n・銀髪青目の巨乳 眼鏡\n・乳輪は綺麗なピンク色で大きい。乳首も大きい\n・陰毛、脇毛の体毛が濃い\n\n■シチュエーション\n子ども会の引率をしてるイメージで広い浴場にミニタオル片手に\n「汗かいちゃったからおばさんも入っていいかしら」と入ってきたシーン\n自分が性の対象と見られるとは思っておらず普通の笑顔\n\n差分形式で子どもたちに凝視されて\n「ちょっと……そんな見られたら恥ずかしいわよ」\nと赤面の困った笑顔でタオルで乳や局部を隠そうとするもミニタオルなので全然隠れてない\n\nという風にお願いしたです\n・子ども達は画面外にいるイメージで省略していただいて大丈夫です\n・二枚ともメガネ有り無しの差分をお願いします\n・毛が性癖でして陰毛は濃いめ、普段描かれていないところ申し訳ないのですが脇毛もお願いします\n\n以上内容で可能でしたら何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/21", "thumbnail_src": "https://si.imgix.net/e6b229ed/uploads/origins/40775083-497c-4947-838c-f7c2077eb02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174efef0c7629a9514142e9c2f2c97d9", "thumbnail_srcset": "https://si.imgix.net/e6b229ed/uploads/origins/40775083-497c-4947-838c-f7c2077eb02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174efef0c7629a9514142e9c2f2c97d9, https://si.imgix.net/e6b229ed/uploads/origins/40775083-497c-4947-838c-f7c2077eb02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07c3997f7d6d7c89be39b30ab3cec116 2x, https://si.imgix.net/e6b229ed/uploads/origins/40775083-497c-4947-838c-f7c2077eb02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09d2f32bb79c0aae79da7f4966bf4744 3x", "genre": "art", "nsfw": true, "body": "連続リク失礼します。\n\n題名。ちんこ銃(火縄銃的な作り)\n\n________\n今回も3つのミニイラストと1つの全体画像の4イラスト構成でリクエストです！\n\n1.2.3イラストは今回面の上半分に横並びで小学生が描くような簡素的なイラストで描いてもらって\n最後の全体像(リアル)を下半分横長に使う感じがいいかなと思っております。\n\n________\n1.尿道に靴下を入れ込んだ程で靴下入り尿道から素足を抜いてるミニイラスト\n\n2.その靴下尿道の中に目掛けてうんちを中に落としているミニイラスト\n\n3最後にその中にもう片方の靴下を絞り靴下の汗を靴下尿道うんこいりに入れているミニイラスト\n\n4.その入れられたちんこショタを後ろから舞いちゃんが金蹴りしてうんこと精子などが弾丸の様に前方に飛び出ているイラスト", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/20", "thumbnail_src": "https://si.imgix.net/48617516/uploads/origins/a5962378-2d8a-4235-adc8-40ed3f8e8708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a16037b046791c2a79f8976859cabf5", "thumbnail_srcset": "https://si.imgix.net/48617516/uploads/origins/a5962378-2d8a-4235-adc8-40ed3f8e8708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a16037b046791c2a79f8976859cabf5, https://si.imgix.net/48617516/uploads/origins/a5962378-2d8a-4235-adc8-40ed3f8e8708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83aa2ebc8a8aa7bfc193f3bd6f61dfed 2x, https://si.imgix.net/48617516/uploads/origins/a5962378-2d8a-4235-adc8-40ed3f8e8708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce9ba6c093ebe1171b7ccc235f8bd8c1 3x", "genre": "art", "nsfw": true, "body": "題名 \n葵ちゃんの「人間消臭ソックス」\n\n__________\n1葵ちゃんに「尿道から体内に入り口からつま先がでてる状態までソックス足を突っ込まれ人間ソックスになる」\n\n2最後は上履きをその上から履かれる展開\n\n________\n・ちんちんの大きさは過去にオーダーした\n尿道に足を突っ込んだ時ソックスのロゴが見えるぐらいの大きさ\n\n・胴体は上履きと同じサイズ\n\n例えるとL字の縦棒がちんちんで横棒が胴体\n\n________\n上履きを履いた時見えている人間の情報として、ロゴの高さまでのちんちん。胴体は上履きを履かれると足がはみ出てる感じです\n\n________________\n上履きに収まった状態の全体像を見たいので\n\n1.尿道にソックスイン\n2.ショタの口からつま先が出てくる\n3.足全体のイラスト\n↑は小さく\n4上履きを履いた状態の全体像を大きく描いてください！\n\nいつもみたいに4イラスト構成でお願いしますm(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/19", "thumbnail_src": "https://si.imgix.net/ec28bbfd/uploads/origins/ebe97da8-aeb4-465b-a73b-58f5c541f2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcbf53b0bee4918d75f7ccc79ced2458", "thumbnail_srcset": "https://si.imgix.net/ec28bbfd/uploads/origins/ebe97da8-aeb4-465b-a73b-58f5c541f2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcbf53b0bee4918d75f7ccc79ced2458, https://si.imgix.net/ec28bbfd/uploads/origins/ebe97da8-aeb4-465b-a73b-58f5c541f2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44393cecfe07c89eff4c6dfa204586ea 2x, https://si.imgix.net/ec28bbfd/uploads/origins/ebe97da8-aeb4-465b-a73b-58f5c541f2b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69ec8c45107da73247f257ffa97a5a2a 3x", "genre": "art", "nsfw": true, "body": "前回のサンダルの女の子の続きリクです。\n\n今度はちんちんではなく、サンダルの長さと同じくらいの大きさに縮んだショタを入れてください\n\n\n仰向けのショタを足の向きから徐々にいれて最後はサンダルと靴下の間にすっぽりおさまる感じ", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/18", "thumbnail_src": "https://si.imgix.net/ed79ffbd/uploads/origins/be111383-b29f-4ca9-b007-dff398ab2a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19c839c8cc39a34e43f92364b9196be2", "thumbnail_srcset": "https://si.imgix.net/ed79ffbd/uploads/origins/be111383-b29f-4ca9-b007-dff398ab2a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19c839c8cc39a34e43f92364b9196be2, https://si.imgix.net/ed79ffbd/uploads/origins/be111383-b29f-4ca9-b007-dff398ab2a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=311d0438a2140a959066c4f092f86e00 2x, https://si.imgix.net/ed79ffbd/uploads/origins/be111383-b29f-4ca9-b007-dff398ab2a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22f7de227b944f76fe91712216075eba 3x", "genre": "art", "nsfw": true, "body": "こんにちは。pororocaさんの描くいろんな女の子たちがいろんなシチュエーションで性欲処理してくれる絵が好きで今回依頼しました。ただ特殊性癖の極みなので金額の割や自身の描きたいものに反する場合断られても大丈夫です。\n\n\n依頼がクラッシュもので、生物学部が活動の末未知の生命体を作ったのだが増えすぎてしまったので駆除してくれと生徒会に依頼がきて、舞ちゃんたちがクラッシュしまくるというものです。\n\n攻め役は舞ちゃんで乗馬服と乗馬ブーツ、（可能なら攻め役にもう一人同じぐらいの身長の女子バレー部主将兼エースもいて欲しいですが画面のリソースが足りなそうな場合省いても大丈夫です）\n\nやられ役は、生物学部が学校中のマゾな男子生徒や男性教師たちから精細胞を集め培養した結果できた生命体。見た目は完全にちん◯。進化した個体は60〜90cmほどのチビゴブリンのような生命体になる。知能や痛覚はないが元の細胞の持ち主たちに似てドMで、女子生徒たちからクレームが来ている。\n\n通常個体の大きさは普通のちん◯と同じ程度だが、集合合体するとサンドバッグほどの大きさになる。\n\n雑魚を複数体、またはボス個体をボコボコにクラッシュして欲しいです。\nクラッシュの仕方は踏み潰し、蹴り◯し、巨大な尿道に脚を突き刺し破裂させるなどはお任せします。とにかく舞ちゃんがはちゃめちゃにかっこよく活躍してくれれば。\nご考案のほどよろしくお願いします。\n\n参考資料\nhttps://www.pixiv.net/artworks/96374889\nhttps://www.pixiv.net/artworks/124702557\nhttps://www.pixiv.net/artworks/117833703", "created_at": "", "completed_at": ""}, {"path": "/@pororoca2529/works/17", "thumbnail_src": "https://si.imgix.net/2e67766e/uploads/origins/5df69783-ef39-4ee5-a6b0-7d2203860cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=001f475acbff0ad90bbe31ed9303d00b", "thumbnail_srcset": "https://si.imgix.net/2e67766e/uploads/origins/5df69783-ef39-4ee5-a6b0-7d2203860cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=001f475acbff0ad90bbe31ed9303d00b, htt