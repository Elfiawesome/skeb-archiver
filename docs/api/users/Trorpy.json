.net/676e3d20/uploads/origins/4c667186-f86f-4826-95e9-bbd0f0bb36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1f17ac684a313b753acd2b78dadb74", "thumbnail_srcset": "https://si.imgix.net/676e3d20/uploads/origins/4c667186-f86f-4826-95e9-bbd0f0bb36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1f17ac684a313b753acd2b78dadb74, https://si.imgix.net/676e3d20/uploads/origins/4c667186-f86f-4826-95e9-bbd0f0bb36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da0dc030f3054421b325d71f7cc14bcd 2x, https://si.imgix.net/676e3d20/uploads/origins/4c667186-f86f-4826-95e9-bbd0f0bb36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36cbe3b6fb73c12cff649487ae5f6bdc 3x", "genre": "art", "nsfw": false, "body": "初めまして、素敵な絵柄に惹かれ今回自身の代理キャラを描いていただきたくリクエストを送らせていただきました。\n\n○詳細\n男/182cm/25歳\n一見喋り方からは温厚そうな性格に見えるが自分に不都合な事が怒るとすぐに手が出る。\nお気に入りの人物が何人かおり彼らを犬と呼んで可愛がっている。\n\n構図や表情はおまかせいたしますのでお好きなように描いていただけますと幸いです！\nお忙しい中申し訳ありませんがよろしくお願い致します。\n\n資料 https://drive.google.com/drive/folders/1O_0xvlMH5M5e5BhMKsGX3GthdF1cZhj7", "created_at": "", "completed_at": ""}, {"path": "/@Trorpy/works/12", "thumbnail_src": "https://si.imgix.net/75aa58b0/uploads/origins/46401899-83e6-410a-b0bc-7f8ade396dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c91b850c36f41199b0406324d00a5c35", "thumbnail_srcset": "https://si.imgix.net/75aa58b0/uploads/origins/46401899-83e6-410a-b0bc-7f8ade396dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c91b850c36f41199b0406324d00a5c35, https://si.imgix.net/75aa58b0/uploads/origins/46401899-83e6-410a-b0bc-7f8ade396dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fd99ed77f77b899dd91b26e4500f714 2x, https://si.imgix.net/75aa58b0/uploads/origins/46401899-83e6-410a-b0bc-7f8ade396dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d58ca69a25d8c98fc0468fb5e934685d 3x", "genre": "art", "nsfw": false, "body": "はじめまして！あなたの個性的でクールな絵に出会い、私のキャラクターも描いていただきたくお願いしたvsingerです<3 リクエストの際、ポーズやコスチュームは特に考えていませんでしたので、ご自由にどうぞ！特に何かをいただくというよりは、先生の絵の中の娘を見るのが楽しみでした。ご配慮ありがとうございました <3\n\nhttps://drive.google.com/drive/folders/1tHpN4ZK9QHqK3gUVJQOEgZifdFEz71cx?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Trorpy/works/11", "thumbnail_src": "https://si.imgix.net/83e75813/uploads/origins/69098230-8567-470e-b84f-a607d644f804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e373325c2f1585301d79b2cb6af12ae4", "thumbnail_srcset": "https://si.imgix.net/83e75813/uploads/origins/69098230-8567-470e-b84f-a607d644f804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e373325c2f1585301d79b2cb6af12ae4, https://si.imgix.net/83e75813/uploads/origins/69098230-8567-470e-b84f-a607d644f804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c670531b41b67691c6b95c2b1c0a6f35 2x, https://si.imgix.net/83e75813/uploads/origins/69098230-8567-470e-b84f-a607d644f804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fd5b41c4e491960de2436afc2221bb9 3x", "genre": "art", "nsfw": false, "body": "＠様初めまして。\n心を掴まれるようなモノクロ絵に惹かれ、リクエストさせていただきました。\n\n今回描いていただきたいのは、OC(TRPGで使用している探索者)2人です。\n\n\n\n以下、詳細になります。\n\n人物①\n赤髪、青目の男性。27歳。\n\n英雄に憧れるあまり、自身の血を呪いながらも「正義のために死ぬことこそ本懐」と信じる熱血軍人。\n正義感が非常に強く、人を疑うことを知らないような印象。理想にまっすぐ突き進む。\nまるで英雄譚の主人公にでもなったつもりで、命を懸けて前線に立ち続けている。\n\n\n人物②\nオレンジ髪、紫目の男性。27歳。\n\n数年前に負傷し一度は退役した出戻りの軍人。\n気丈でおっとりとした兄のような存在。裏表がなく誰からも慕われる。愛情深いが執着は薄く、あっさりと人に接する。\nありふれた日常のなかに別れの言葉が含まれていることをよく知っているため、言動ひとつひとつが小さな祈りとして佇んでいるような印象。\n\n\n\n二人の関係性は「古くからの戦友」です。\nかつては背中合わせで戦っていたが、立場が変わり、時間が流れ、二度と昔のように隣で剣を振るうことはかなわなくなった。\n一人は己の正義のために前線へ、一人は生ける者の背中をあずかるために後方へ。\nお互いが唯一の相棒であることは変わらないが、望む未来も道も違えてしまったような印象。\n\n\n二人の衣装はシナリオ指定の制服に装飾を足したものになります。\n\n\n【希望など】\n\n場面や構図、雰囲気はお任せしたいです。\n感じ取ったものを自由な解釈で表現していただけますと幸いです！\n\n\n【使用目的】\n\nSNSのアイコンやヘッダーとしての使用。\nまた、個人鑑賞用のグッズ制作をさせていただく可能性がありま