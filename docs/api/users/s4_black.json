x.net/c27a68b2/uploads/origins/3c18ef00-09fc-490b-b6d4-2857f57f7487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cff3808b900e7ff0df7cc4e03641b9bc", "thumbnail_srcset": "https://si.imgix.net/c27a68b2/uploads/origins/3c18ef00-09fc-490b-b6d4-2857f57f7487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cff3808b900e7ff0df7cc4e03641b9bc, https://si.imgix.net/c27a68b2/uploads/origins/3c18ef00-09fc-490b-b6d4-2857f57f7487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ebc7b4658277af603dadaa25bcdcd7b 2x, https://si.imgix.net/c27a68b2/uploads/origins/3c18ef00-09fc-490b-b6d4-2857f57f7487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=576cf7ebb81a2d1fbe6d26fec13db424 3x", "genre": "art", "nsfw": false, "body": "ジングーさん２月です。バレンタインです。アリサが思いを込めてチョコを作り、その横で応援？つまみ食い？をしている兎さんのイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@s4_black/works/98", "thumbnail_src": "https://si.imgix.net/36600bd5/uploads/origins/00f24990-4b67-4170-a7e8-20de2503c3cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=797dc7d461c74d40664680b3ab4d858a", "thumbnail_srcset": "https://si.imgix.net/36600bd5/uploads/origins/00f24990-4b67-4170-a7e8-20de2503c3cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=797dc7d461c74d40664680b3ab4d858a, https://si.imgix.net/36600bd5/uploads/origins/00f24990-4b67-4170-a7e8-20de2503c3cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=342bf2a5f189882f26ce8e189d11e504 2x, https://si.imgix.net/36600bd5/uploads/origins/00f24990-4b67-4170-a7e8-20de2503c3cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62c93dea39101f590adac26c49ec4133 3x", "genre": "art", "nsfw": true, "body": "ガルパンのしほママと千代ママでイラストをお願いします\nエロコメディ的なシチュですが、受けていただけると幸いです\n\n大洗学園制服を着ている最中、突然の暴風に襲われ、紐パンとスカートが脱げてしまい、風にさらわれてしまうイラスト\n\n・大洗学園制服着用\n・資料のようなお尻を突き出して並んでいる構図\n・お尻がメインの構図で、肛門も映って