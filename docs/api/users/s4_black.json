: 500, "recorded_at": "2025-10-18T12:37:01.698633"}, {"amount": 2000, "recorded_at": "2026-02-16T08:17:08.242401+00:00"}, {"amount": 500, "recorded_at": "2026-03-01T04:22:37.639693+00:00"}, {"amount": 2000, "recorded_at": "2026-03-04T14:02:44.150042+00:00"}]}, "current_prices": {"art": 13000, "correction": 2000}, "price_range": {"art": {"min": 6000, "max": 13000}, "correction": {"min": 500, "max": 2000}}, "links": [{"label": "Twitter", "url": "https://x.com/s4_black", "name": "s4_black"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/1710680", "name": "1710680"}], "flags": {"from_archive": true}, "works": [{"path": "/@s4_black/works/106", "thumbnail_src": "https://si.imgix.net/f5cabb74/uploads/origins/3489ed00-71ca-4767-b8bd-7fd1da063c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c525a6d8280ce7b771daef248ca3dfc5", "thumbnail_srcset": "https://si.imgix.net/f5cabb74/uploads/origins/3489ed00-71ca-4767-b8bd-7fd1da063c49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c525a6d8280ce7b771daef248ca3dfc5, https://si.imgix.net/f5cabb74/uploads/origins/3489ed00-71ca-4767-b8bd-7fd1da063c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58da46380ebee3c5e1750c56a26a2236 2x, https://si.imgix.net/f5cabb74/uploads/origins/3489ed00-71ca-4767-b8bd-7fd1da063c49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42d85a0e41b86c212ab6741387848e7a 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nガルパンのみほが顔面騎乗しているイラストが見たいです！\n体制は下の男と向き合う向きではなく、反対向き（いわゆる背面側の、尻を押し付ける向きの顔面騎乗）、\nアングルはみほの尻が強調された感じ、\n服装は裸に黒靴下のみ、\nセリフは、みほが「もっと丁寧に」とか「んっ♡そこ！」とか、快感を感じながら積極的に命令をしている感じのものがあると嬉しいです\n\nもし可能ならですが、そのままおしっこを漏らしてしまう差分も見たいです（恥ずかしがって謝りながらも、どこか恍惚とした感じ）\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@s4_black/works/105", "thumbnail_src": "https://si.imgix.net/c9815e48/uploads/origins/9a1e1102-207d-4ebc-ac20-60b732898c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea0bbc05b8597e7816d1d3d090227a9c", "thumbnail_srcset": "https://si.imgix.net/c9815e48/uploads/origins/9a1e1102-207d-4ebc-ac20-60b732898c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea0bbc05b8597e7816d1d3d090227a9c, https://si.imgix.net/c9815e48/uploads/origins/9a1e1102-207d-4ebc-ac20-60b732898c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cfbf68607186b8f9ba07420a459f109 2x, https://si.imgix.net/c9815e48/uploads/origins/9a1e1102-207d-4ebc-ac20-60b732898c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d039b3f1ca2aec98270ae1e7849004b0 3x", "genre": "art", "nsfw": true, "body": "ガルパンのまほお姉ちゃんとエリカで依頼をお送りします\nシチュ的には、以前依頼した「暴風にスカートとパンツを攫われるしほ千代」の続きになります\n\nシチュ\n風で飛ばされたしほと千代のパンツを見つけた二人\n誰の物か気づかずに拾おうとかがんだ瞬間、突然の暴風により二人のパンツとスカートも脱げ、風に攫われてしまう…\n\n要点\n\n・二人とも黒森峰のパンツァージャケット着用\n・お尻を突き出すような姿勢\n・お尻を隠そうとしてお尻に両手をやり、結果的にお尻の穴を広げるような形になってしまっている\n・驚いて顔を赤くしている\n\nそんなイラストをお願いします\n\nhttps://skeb.jp/@s4_black/works/98", "created_at": "", "completed_at": ""}, {"path": "/@s4_black/works/104", "thumbnail_src": "https://si.imgix.net/7b93db68/uploads/origins/dc9bd14a-81b8-40a8-a7e7-29183e871821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185974622e5ec8aff4d91e9392d5dd9f", "thumbnail_srcset": "https://si.imgix.net/7b93db68/uploads/origins/dc9bd14a-81b8-40a8-a7e7-29183e871821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185974622e5ec8aff4d91e9392d5dd9f, https://si.imgix.net/7b93db68/uploads/origins/dc9bd14a-81b8-40a8-a7e7-29183e871821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe3af1810394893594a997555e8161b5 2x, https://si.imgix.net/7b93db68/uploads/origins/dc9bd14a-81b8-40a8-a7e7-29183e871821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be542efc03216d982c3b18babb6765c3 3x", "genre": "art", "nsfw": true, "body": "リクエストさせて頂きます。\nVOCALOIDの音街ウナちゃんが裸リボン姿で口に未開封のコンドームを咥えながらプレゼントは私♡とアピールしている所をお願いします。\n体勢は仰向けで表情は顔を真っ赤にして恥ずかしがりつつも目で早く食べてとおねだりしている感じでお願いします。\n以上の内容でご検討のほど宜しくお願い致します。\n\nhttps://www.ssw.co.jp/products/synth_v/otomachiuna/illust.html", "created_at": "", "completed_at": ""}, {"path": "/@s4_black/works/103", "thumbnail_src": "https://si.imgix.net/b6dfe093/uploads/origins/d919102f-33b2-4e03-85d3-3831c5242555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6651ca86c8c828eb771109f86b8ce31a", "thumbnail_srcset": "https://si.imgix.net/b6dfe093/uploads/origins/d919102f-33b2-4e03-85d3-3831c5242555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6651ca86c8c828eb771109f86b8ce31a, https://si.imgix.net/b6dfe093/uploads/origins/d919102f-33b2-4e03-85d3-3831c5242555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e4e6454b27c1ebed81ade0d7d4f0178 2x, https://si.imgix.net/b6dfe093/uploads/origins/d919102f-33b2-4e03-85d3-3831c5242555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6047975bb8194731ea56c0fde5858b9 3x", "genre": "art", "nsfw": true, "body": "アダルト絵を依頼します。\n\n【キャラ】\n鶴姫しずか：リボンの武者\n\n【内容】\n「鳥居強右衛門磔図」みたいに大の字で磔にされた鶴姫しずかのアダルト絵\nhttps://x.com/yamibun/status/1895827584539381872\n敵に捕まって味方が見ている状況で辱しめを受けても気丈に振る舞い、味方に自らの痴態をオカズとしてシコれと豪語しているイメージ\n\n【表情】\nお任せします。\n\n【衣装・小道具】※各衣装・小道具のオンオフ差分\n・胸丸出しのノーパン前垂れ（褌みたく見える感じ）\nhttps://www.pixiv.net/artworks/135212644\nhttps://www.pixiv.net/artworks/122777900\n透けイメージ\nhttps://www.pixiv.net/artworks/50809480\n\n・ぴっちりと閉じたワレメ\n\n・精液のぶっかけ\n頭部・顔・胸・股間\n\n・失禁放尿\n\n・陰毛\n※フサフサに生えている・剃って整えている２パターン\n\n・股間とアナルにバイブ二本挿し\nhttps://www.pixiv.net/artworks/94006998\n\n・乳首ローター\nhttps://www.pixiv.net/artworks/80451395\n\n・乳首リングに紐が付いているタイプ（ピアスタイプNG）\nhttps://www.pixiv.net/artworks/137321813\nhttps://www.pixiv.net/artworks/82329386\n\n・前垂れの腰紐部分と乳首リングの紐と乳首に使用済みコンドーム\nhttps://www.pixiv.net/artworks/89383135\nhttps://www.pixiv.net/artworks/99228539\n\n・両足にガーターリング(片方は使用済みコンドーム・もう片方は未使用品のコンドームの袋)\nhttps://www.pixiv.net/artworks/131205772\nhttps://www.pixiv.net/artworks/59114660\n\n【背景】\n単色か簡易的な物\n\n【その他】\nPSDデータ希望\n※差分レイヤーは、PSDデータに一つに纏める", "created_at": "", "completed_at": ""}, {"path": "/@s4_black/works/102", "thumbnail_src": "https://si.imgix.net/210a73fd/uploads/origins/1a86c6ca-4cfa-4244-bf77-b95daf0d1d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e90f72bab4e16ffae45da073b15625a1", "thumbnail_srcset": "https://si.imgix.net/210a73fd/uploads/origins/1a86c6ca-4cfa-4244-bf77-b95daf0d1d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e90f72bab4e16ffae45da073b15625a1, https://si.imgix.net/210a73fd/uploads/origins/1a86c6ca-4cfa-4244-bf77-b95daf0d1d31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=308f5905430656f7f68fc2d8940ff120 2x, https://si.imgix.net/210a73fd/uploads/origins/1a86c6ca-4cfa-4244-bf77-b95daf0d1d31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25048a757b2d3b8e153a4dcd185c46a8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@s4_black/works/101", "thumbnail_src": "https://si.imgix.net/4d8fadc5/uploads/origins/b6b319d3-0951-42cf-b554-b1eaab71d641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8fbaab4dc6a018f70cd1be2a42ffd3fa", "thumbnail_srcset": "https://si.imgix.net/4d8fadc5/uploads/origins/b6b319d3-0951-42cf-b554-b1eaab71d641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtf