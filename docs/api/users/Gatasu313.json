ルして頂いて構いません。\n（値上げに関しては金額次第で再送・降りるかの判断したいと思います）\n\n何かとお忙しい中大変恐縮ではございますが\n何卒御確認、御検討の程宜しくお願い致します。\n\nhttps://x.com/brave_akane/status/1865721892075905051", "created_at": "", "completed_at": ""}, {"path": "/@Gatasu313/works/48", "thumbnail_src": "https://si.imgix.net/4eb23071/uploads/origins/64646335-4600-42fe-a716-ebb65411ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25a14b7cce3a711e9e308055ddc07e01", "thumbnail_srcset": "https://si.imgix.net/4eb23071/uploads/origins/64646335-4600-42fe-a716-ebb65411ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25a14b7cce3a711e9e308055ddc07e01, https://si.imgix.net/4eb23071/uploads/origins/64646335-4600-42fe-a716-ebb65411ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6e21fde4a6dbca7875647668b65e050 2x, https://si.imgix.net/4eb23071/uploads/origins/64646335-4600-42fe-a716-ebb65411ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b1ef15194eab7957370383d952e7945 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gatasu313/works/47", "thumbnail_src": "https://si.imgix.net/6006e7ca/uploads/origins/bea075c1-b2ca-42e1-aacf-60bfd6c7a2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf935d9b02976eaff663329d857e8ee3", "thumbnail_srcset": "https://si.imgix.net/6006e7ca/uploads/origins/bea075c1-b2ca-42e1-aacf-60bfd6c7a2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf935d9b02976eaff663329d857e8ee3, https://si.imgix.net/6006e7ca/uploads/origins/