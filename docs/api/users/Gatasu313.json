-be24-5a940cc217c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6c3ff9cc7a5bdf621d5639f335b3a7f", "thumbnail_srcset": "https://si.imgix.net/baf436ae/uploads/origins/dbda5ba4-3429-407d-be24-5a940cc217c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6c3ff9cc7a5bdf621d5639f335b3a7f, https://si.imgix.net/baf436ae/uploads/origins/dbda5ba4-3429-407d-be24-5a940cc217c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a01f87c77d7ad86b3c541d03eb214e4 2x, https://si.imgix.net/baf436ae/uploads/origins/dbda5ba4-3429-407d-be24-5a940cc217c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc92d02ef132affce4b5a0ca16720c1b 3x", "genre": "art", "nsfw": false, "body": "私の代理キャラクターのユーマ=フリッツハマーと相棒メカのアーケオ=ウィンクルムを描いて頂きたいです。 下記URLが詳細な容姿になります。\nhttps://drive.google.com/drive/folders/1JZ0mlSEscXzgusU02yKhFvA4tp3ySuvb\n\n構図は、カッコイイ感じでお願いします。\n詳細はおまかせ致します。\n\n描画的に難しい箇所があると思われます為、少々のアレンジは問題ないです。 以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Gatasu313/works/61", "thumbnail_src": "https://si.imgix.net/501a29c4/uploads/origins/5a31c52b-7d7f-4e02-896e-89829d4ea102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30961ecb0071cfd0b9b4f2cbd796d871", "thumbnail_srcset": "https://si.imgix.net/501a29c4/uploads/origins/5a31c52b-7d7f-4e02-896e-89829d4ea102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30961ecb0071cfd0b9b4f2cbd796d871, https://si.imgix.net/501a29c4/uploads/origins/5a31c52b-7d7f-4e02-896e-89829d4ea102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a893054cbee6978bd33272f408d895bf 2x, https://si.imgix.net/501a29c4/uploads/origins/5a31c52b-7d7f-4e02-896e-89829d4ea102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=275388e61df2b647b1e861cf6bb2a776 3x", "genre": "art", "nsfw": true, "body": "ガタスさんこんにちは！\n先日はうちの子のカッコイイ必殺技シリーズを描いて頂きまして\n有難う御座いました。\nそれで、今度はこっちがちょっと思いついたのがありましたので\nリピートしたいと思います。\n\n◎【今回リクエスト内容】\n前回と同じ「ブレイブハート・アカネ」の\n必殺技シリーズ…というより\nちょっとサポート・緊急脱出系になります。\n\nキャラクター設定URL\n⇒https://xoh.dojin.com/character/akane/\n\n①ヒールスキル（属性は光・技名はお任せ）\n・対象一人に対して怪我や疲労。はたまた受けたデバフの解除をする事が出来る。\n（※エッチなやつとかのデバフも解除可）\n更にアカネが相手に対してエネルギー（ないし魔力）を譲渡ことも可。\n但し発動条件はアカネが近づいて相手の身体に触れなければならず\nまた、アカネ自身のエネルギーを使って治療および譲渡する為\n相手の怪我や消耗具合・デバフの重さがあるほど自身も力を消費してしまう\nデメリットがあるため注意。\n（対象相手はお任せ。うちの子でもガタスさんの子でもモブでもお好きなように\n　無しなら無しでも大丈夫です。アドリブでお任せします）\n\n②緊急脱出技（属性お任せ・複合〇・技名はお任せします）\n・アカネが敵に拘束、捕まってしまった（触手とか群れた敵とか）場合の緊急脱出技。\n　胸の宝石のエネルギーを放出して、範囲内の敵を倒す（もしくは吹き飛ばす）。\n　但し、エネルギーの調整ができない為消耗が激しく状況によっては\n　エネルギーが枯渇し倒れてしまう為注意。\n\n③バリア技（属性任せ・複合〇・技名はお任せします）\n・敵の強力な攻撃を防ぐ時、等身大のバリアを目の前で張る。\n　エネルギーをつぎ込めばさらにバリアは強固になるが\n　消耗が激しいので注意。\n　\n④近接・拳技（属性任せ・複合〇・技名お任せします）\n・完全にお任せします。いい感じのやつがあればそれで！\n\n\n・他余裕があればで構いません\n　何かアドリブで付け足す事があればそれもお任せします。\n（落書き・ラフでもOK）\n・台詞も付け足した方が迫力でるなと感じたら、それもアドリブにお任せします。\n・背景もお任せします。\n・説明文はあくまで「イメージ・こんな感じですよ」的な感じです。\n　ガダス様の方でこっちの方がわかりやすいな、とか描写はこっちの方がいいな\n　的なものがあればアドリブでどうぞ！\n・ＮＳＦＷもオンにしときます。エッチ系なシチュ入れちゃっても大丈夫です。\n\n♦【使用用途】\n　①今回納品予定のイラスト紹介（Twitter(X)掲載）\n　②絵師様へ紹介ツイート\n　③２次創作の資料、及び他リクエストする際に引用。\n　④参加しているPBW(https://xoh.dojin.com/）のＧＭ様に描写される際の\n　　ネタ、ないし自分で文章を書く際に必殺技を使用予定。\n　⑤必殺技を使うカットインイラスト他等の参考資料として引用。\n\n■以上になります。\nもし今回のリクエスト内容及び掲載理由で厳しい。\n作業量に対して金額が合わない！（値上げが必要）\n他等、何か理由が御座いましたら\n遠慮なくキャンセルして頂いて構いません。\n（値上げに関しては金額次第で再送・降りるかの判断したいと思います）\n\n何かとお忙しい中大変恐縮ではございますが\n何卒御確認、御検討の程宜しくお願い致します。\n\nhttps://x.com/brave_akane/status/1890851527469813806", "created_at": "", "completed_at": ""}, {"path": "/@Gatasu313/works/60", "thumbnail_src": "https://si.imgix.net/fb810598/uploads/origins/82018a7f-6651-462a-a253-7c75d173794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58314a85e896eef935c29edea2674620", "thumbnail_srcset": "https://si.imgix.net/fb810598/uploads/origins/82018a7f-6651-462a-a253-7c75d173794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58314a85e896eef935c29edea2674620, https://si.imgix.net/fb810598/uploads/origins/82018a7f-6651-462a-a253-7c75d173794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd743858b212e6fd7336e97b1950d028 2x, https://si.imgix.net/fb810598/uploads/origins/82018a7f-6651-462a-a253-7c75d173794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9dcaf6c1f70ab865d889c6160defc2c 3x", "genre": "art", "nsfw": false, "body": "前回間違えて以前手数料無料キャンペーン中にリクエストさせていただいた時の安くなっていた金額設定で送ってしまったのとシステムで返金が遅れている影響でかなり間が空いての再送になってしまいました。申し訳ありません……。\n\n前回は赤い子を描いていただきありがとうございました！\n今回は赤い子と対になる水属性の子、降神姫ティアの立ち絵をお願いしたいです\n不思議系よりの無表情な子で、身体の動きがうるさいタイプです\n衣装は赤い子のカラーリングを水色・青色にした感じで、武器はハンマーでお願いします\nポーズはお任せします\nお手数をおかけして申し訳ありませんがよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gatasu313/works/59", "thumbnail_src": "https://si.imgix.net/2db76a38/uploads/origins/ecf86ebb-55b9-4673-a830-5cfa1c830802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=324867ffbc8a7dfe16f0578d49b89089", "thumbnail_srcset": "https://si.imgix.net/2db76a38/uploads/origins/ecf86ebb-55b9-4673-a830-5cfa1c830802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=324867ffbc8a7dfe16f0578d49b89089, https://si.imgix.net/2db76a38/uploads/origins/ecf86ebb-55b9-4673-a830-5cfa1c830802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1011f7b481c06eef2bbd90f50efaef0 2x, https://si.imgix.net/2db76a38/uploads/origins/ecf86ebb-55b9-4673-a830-5cfa1c830802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af554dd2ff9b127ca81271d15e6bcb25 3x", "genre": "art", "nsfw": false, "bod