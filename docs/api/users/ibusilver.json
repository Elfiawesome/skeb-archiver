r=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40d22650667ca138239e5c79a4032007 2x, https://si.imgix.net/bafe8414/uploads/origins/6eb8ef77-4c2e-4bcd-8079-1da74a785515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=decbf59a44ebc8274b877f2ec2761fc8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/30", "thumbnail_src": "https://si.imgix.net/6cdd9ad3/uploads/origins/3a7c6f3e-2d76-45c3-9cbf-02092afa4575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63820838bc348e51323c80e75a31c1ea", "thumbnail_srcset": "https://si.imgix.net/6cdd9ad3/uploads/origins/3a7c6f3e-2d76-45c3-9cbf-02092afa4575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63820838bc348e51323c80e75a31c1ea, https://si.imgix.net/6cdd9ad3/uploads/origins/3a7c6f3e-2d76-45c3-9cbf-02092afa4575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92ef3b2c501db3618f577a177b90b9d8 2x, https://si.imgix.net/6cdd9ad3/uploads/origins/3a7c6f3e-2d76-45c3-9cbf-02092afa4575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff2f83f5fc0a53b48312b5d184304c2f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/29", "thumbnail_src": "https://si.imgix.net/8596f526/uploads/origins/9b86ef1a-d6f7-4b7d-a782-f435bfb1caf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd35605ec4e8cd3b6901f6ed72c2259", "thumbnail_srcset": "https://si.imgix.net/8596f526/uploads/origins/9b86ef1a-d6f7-4b7d-a782-f435bfb1caf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd35605ec4e8cd3b6901f6ed72c2259, https://si.imgix.net/8596f526/uploads/origins/9b86ef1a-d6f7-4b7d-a782-f435bfb1caf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9b17bb523685e7033109860ed4712a7 2x, https://si.imgix.net/8596f526/uploads/origins/9b86ef1a-d6f7-4b7d-a782-f435bfb1caf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcdf4ab1b86fc577741d21c4c71e383a 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n以下をリクエストさせていただけますでしょうか\n\n〈作品・キャラクター〉\nメギド72のアミー\n\n〈シチュエーション〉\nポイピクに上げられていたアリオクのような召喚上書きシチュエーション\n暴漢一人に立ち向かうもやられてしまい、犯されるという形でお願いします\n\n〈服装など〉\n星3バーストの衣装でお願いします\n\n〈構図〉\n立ち絵とエッチな絵が一緒になってるものでお願いします\nまた、ネチネチと虐められて絶頂してしまう感じだと嬉しいです\n\n〈その他〉\n以前フィロタヌスの依頼で書かれていたようなオホ顔（？）差分なども頂けると嬉しいです\n\n希望が多くて申し訳ないのですが、ご検討よろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/28", "thumbnail_src": "https://si.imgix.net/0f85bb45/uploads/origins/2e318c46-d742-428f-92be-69679a31dc8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c3932add5eeec34af5ddfb38f998fe3", "thumbnail_srcset": "https://si.imgix.net/0f85bb45/uploads/origins/2e318c46-d742-428f-92be-69679a31dc8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c3932add5eeec34af5ddfb38f998fe3, https://si.imgix.net/0f85bb45/uploads/origins/2e318c46-d742-428f-92be-69679a31dc8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25f5f1af6141e9b3586abd50d116ab1c 2x, https://si.imgix.net/0f85bb45/uploads/origins/2e318c46-d742-428f-92be-69679a31dc8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19224c3a7c4b62d10dcf8bee514e5324 3x", "genre": "art", "nsfw": true, "body": "またよろしくお願いします。\n以前描いて頂いたリヴァイアサンの続きを差分込みで描いて頂きたく依頼させていただきます。\n\n●1枚目\n・服装とポーズは前回のまま、正面向きの構図で。\n・胸に向かって触手が近づいてきており、それを怯えたような表情で見ているが、頬は紅潮し乳首が期待するようにむくむくと勃っている。\n\n●2枚目（差分）\n・片方の胸には触手が巻き付き搾り上げ、乳首から母乳が噴き出している。\n・もう片方の胸には、先端が蛇の口のように開いた触手が乳首にしゃぶりついて母乳を吸っている。\n・表情はただ快楽に喘いでいて、抵抗の意志はもう残っていない感じで。\n\nといった内容でよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/27", "thumbnail_src": "https://si.imgix.net/41e8b372/uploads/origins/8aafbe9d-6fda-4a6f-8232-fa2fb33f6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29aedfd9bee82acbc30c83e49d489ecb", "thumbnail_srcset": "https://si.imgix.net/41e8b372/uploads/origins/8aafbe9d-6fda-4a6f-8232-fa2fb33f6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29aedfd9bee82acbc30c83e49d489ecb, https://si.imgix.net/41e8b372/uploads/origins/8aafbe9d-6fda-4a6f-8232-fa2fb33f6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=590a644387ec8af1fa323f89803f86cf 2x, https://si.imgix.net/41e8b372/uploads/origins/8aafbe9d-6fda-4a6f-8232-fa2fb33f6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4764dcbe8fb260fc8309cb7e6511c625 3x", "genre": "art", "nsfw": true, "body": "メギド７２のフィロタヌスをお願いします\n\n生徒に催眠をかけられ成績優秀のご褒美としていつでも先生の母乳を御馳走するシチュエーション\n生徒に絶頂を見られ恥ずかしがる\nお乳吸うのお上手です～など褒めてくれる", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/26", "thumbnail_src": "https://si.imgix.net/d16f9671/uploads/origins/2d49b921-a713-40d1-974f-73d9ea0c08b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33537b2ffd7c40c3b0dfc04deabfff66", "thumbnail_srcset": "https://si.imgix.net/d16f9671/uploads/origins/2d49b921-a713-40d1-974f-73d9ea0c08b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33537b2ffd7c40c3b0dfc04deabfff66, https://si.imgix.net/d16f9671/uploads/origins/2d49b921-a713-40d1-974f-73d9ea0c08b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=988b1a57243593ec47c6ef2d2b45d9ba 2x, https://si.imgix.net/d16f9671/uploads/origins/2d49b921-a713-40d1-974f-73d9ea0c08b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cd5a392f78daabc3e5dfe51252a6094 3x", "genre": "art", "nsfw": true, "body": "メギド７２のバフォメットをお願いします\n\n村の子供（一人）に搾乳、授乳の悪戯を受け叱りながらも感じてしまい未知の感覚に絶頂して母乳を噴出してしまうシチュエーション\nセリフお任せします", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/25", "thumbnail_src": "https://si.imgix.net/c9f030f2/uploads/origins/4360a164-d7f1-4803-9af7-66561b232f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d229851fd9b241c4c9068e040779ce", "thumbnail_srcset": "https://si.imgix.net/c9f030f2/uploads/origins/4360a164-d7f1-4803-9af7-66561b232f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d229851fd9b241c4c9068e040779ce, https://si.imgix.net/c9f030f2/uploads/origins/4360a164-d7f1-4803-9af7-66561b232f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03024c3d67d4325a935a60eb1cde3b3b 2x, https://si.imgix.net/c9f030f2/uploads/origins/4360a164-d7f1-4803-9af7-66561b232f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a909c976099c75c7a805cdca1d010ff1 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nメギド72のリヴァイアサンを描いて頂きたく依頼させていただきます。\n\n●服装\n自由（裸でも可）\nただ、ペンダント着用と胸の露出はしてください\n\n●シチュ\n以前描かれていた触手絵のようなことがあった（どれという指定は無し）その後といった内容で。\nペンダントを細めの触手が首輪とリードのように引っ張っていて歩かされている（首輪とリードでも可）\n表情はうつむき気味だが頬が紅潮していて、\nもう逃げられない状況と快楽を受け入れつつあるといった様子で\n手足や胸に絡みついてくる触手も振り払おうとしていない。\n胸はたれ気味で乳首は少し長くなっていて母乳が漏れ落ちている\n好き放題されて胸全体がくたびれているような状態になっている。\n\nといった内容でよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/24", "thumbnail_src": "https://si.imgix.net/21512e21/uploads/origins/5a380f72-65c3-407a-8809-e640c08b4e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39ee4126dc38acc11a3100aa5d70098c", "thumbnail_srcset": "https://si.imgix.net/21512e21/uploads/origins/5a380f72-65c3-407a-8809-e640c08b4e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39ee4126dc38acc11a3100aa5d70098c, https://si.imgix.net/21512e21/uploads/origins/5a380f72-65c3-407a-8809-e640c08b4e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff74df433b21b6e807d5e6693db2cf05 2x, https://si.imgix.net/21512e21/uploads/origins/5a380f72-65c3-407a-8809-e640c08b4e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=479248cd66bb049901219657b7666f16 3x", "genre": "art", "nsfw": true, "body": "はじめまして、ユフィールとソロモンのカプで甘々えっちイラストをお願いしたいです。\nリンクのSSをご覧いただき、お好みのシーンを描いていただければ幸いです(作者様に御許可頂いてあります)\nよろしければお願いします…！\n\nhttps://www.pixiv.net/novel/show.php?id=15843732", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/23", "thumbnail_src": "https://si.imgix.net/5f401556/uploads/origins/2919c996-e2f0-405c-8ddf-18ff65702dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6bf88e8cb7adfe64c651e0e0fc0a1a", "thumbnail_srcset": "https://si.imgix.net/5f401556/uploads/origins/2919c996-e2f0-405c-8ddf-18ff65702dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6bf88e8cb7adfe64c651e0e0fc0a1a, https://si.imgix.net/5f401556/uploads/origins/2919c996-e2f0-405c-8ddf-18ff65702dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce5158274df9a0fe0b5f8f3a99d01b30 2x, https://si.imgix.net/5f401556/uploads/origins/2919c996-e2f0-405c-8ddf-18ff65702dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28212163fc4d997602aaaf2c87c967ff 3x", "genre": "art", "nsfw": true, "body": "はじめまして、お世話になります。\n\n以下の内容につき、作成をご検討いただけないでしょうか。\n(形式は差分付きの一枚絵、漫画形式どちらでも結構です。)\n\n作品：メギド72\nキャラクター：リヴァイアサン(通常衣装)\nシチュエーション：\n性行為の手ほどきをする、ということでセックスに臨むリヴァイアサン。\n相手は①ソロモン、②アガシオン、③少年モブのいずれか。全身が入っていなくとも構いません。\n最初は笑って「ホラホラ遠慮しないで」などリードするリヴァイアサンだが、徐々に余裕が無くなっていく。(相手は常に必死。)\n心の中で「ヤバい…！こいつおかーさんのことつがいにする気だ…！」「自分の女(メス)にするつもりなんだ…！」などと焦りながらピストンに対して声(「ん゛」など濁点混じり、ハート付きのもの)が漏れる。\n射精で自らが孕まされたことを確信し、「おかーさんおよめさんにされちゃったぁ…♡」と融けた表情になる。\n相手側の台詞は基本的に余裕が無い感じで名前連呼(ソロモン・モブ→リヴァイアサン、アガシオン→リヴァイアサン殿)で、アガシオンの場合は「小生の子を孕んでくだされっ」などを入れてください。\n体位・構図などはお任せいたします。\n\n以上、ご検討ください。\nよろしくお願いいたします。\n\n※モブデザインに特にこだわりはありません。アプリ準拠の容貌でなくとも結構です。\n※衣装について、いずれのキャラについても、部分的な意匠の把握が難しい(特にアガシオン)、複雑で描きづらいものがあれば省いていただいて構いません。(リヴァイアサンはある程度着衣だと嬉しいのですが、全裸でもOKです。)", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/22", "thumbnail_src": "https://si.imgix.net/55f35768/uploads/origins/0c9f6c96-dd2d-436a-9cdf-377c17fc2f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4665e85c7a9998b254db98dd4169c1c2", "thumbnail_srcset": "https://si.imgix.net/55f35768/uploads/origins/0c9f6c96-dd2d-436a-9cdf-377c17fc2f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4665e85c7a9998b254db98dd4169c1c2, https://si.imgix.net/55f35768/uploads/origins/0c9f6c96-dd2d-436a-9cdf-377c17fc2f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc3b66a310f2f0fbe3ab8ff922dbda54 2x, https://si.imgix.net/55f35768/uploads/origins/0c9f6c96-dd2d-436a-9cdf-377c17fc2f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7caedd4af5a693c3aac0cb910c31aef1 3x", "genre": "art", "nsfw": true, "body": "skeb再開お待ちしておりました。\n以前はプルフラスやゼパルの漫画を描いていただきありがとうございます。今回もまたご一読していただけると幸いです。\n\n今回はメギド72からゼパルをもう一度お願いしたいです。\nシチュエーションはしつこいのが嫌いなゼパルをしつこい胸責めで何度もイカせるというもので、大まかな流れとしては拘束されたゼパルを執拗に胸責めし、最初は反抗的な態度を示していたものの次第に口数が減り、薬や遺物、道具など（おまかせします）で更に責められ何度も絶頂し始める。という感じです。\n\n前回同様大まかな流れだけ踏まえて頂ければ細かい部分はいぶしシルヴァー様の描きやすい様に変更、無視していただいて大丈夫です。形式もモノクロで差分形式か漫画かはお任せします。\n\n毎度の事となりますが、細かい注文となりすみません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/21", "thumbnail_src": "https://si.imgix.net/7f7b6a9d/uploads/origins/f43b9346-e3d0-407f-9cde-5b8e659705a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df39fe610ceaa8f9e9f147377ca8219e", "thumbnail_srcset": "https://si.imgix.net/7f7b6a9d/uploads/origins/f43b9346-e3d0-407f-9cde-5b8e659705a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df39fe610ceaa8f9e9f147377ca8219e, https://si.imgix.net/7f7b6a9d/uploads/origins/f43b9346-e3d0-407f-9cde-5b8e659705a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=123c96a4abe833cc26509bd942a073ee 2x, https://si.imgix.net/7f7b6a9d/uploads/origins/f43b9346-e3d0-407f-9cde-5b8e659705a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84c8a21d3984d6d728d4b4b500a4d72b 3x", "genre": "art", "nsfw": true, "body": "ご無沙汰しております。\n\n以前描かれたバニークロケル、とても可愛かったです！\nというわけで、触手幻獣に捕まって爆乳（具体的なサイズはおまかせ）にされたバニークロケルがジズとグシオンに両乳首を吸われているイラストをお願いします。\n資料URLにある画像のように触手に手足を縛られ天井から吊るされたような状態で二人に下から乳首を吸われている感じの構図でお願いします（あくまで構図案なので、これそっくりに描いていただく必要はありません。衣装もこっちで勝手に設定したものなのであまり気にしなくて大丈夫です）。\n\n以上、ご検討のほどよろしくお願い致します。\n\nhttp://www.neogura.x0.com/koikatsu/skebsample.png", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/20", "thumbnail_src": "https://si.imgix.net/43d031ae/uploads/origins/32149a7f-1ab9-4edd-8766-db9a930bacd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fba71eba4a991b52d620731c1690ee8e", "thumbnail_srcset": "https://si.imgix.net/43d031ae/uploads/origins/32149a7f-1ab9-4edd-8766-db9a930bacd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fba71eba4a991b52d620731c1690ee8e, https://si.imgix.net/43d031ae/uploads/origins/32149a7f-1ab9-4edd-8766-db9a930bacd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59eaaef636b7edb15717d6054fd8e1fe 2x, https://si.imgix.net/43d031ae/uploads/origins/32149a7f-1ab9-4edd-8766-db9a930bacd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1415a96df8f0cd8b3576f9be370d342 3x", "genre": "art", "nsfw": true, "body": "メギド72のサキュバス(ラッシュ)とサキュバス(バースト)が、\nモンモンの立派なチンチンをWパイズリフェラしているイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/19", "thumbnail_src": "https://si.imgix.net/1c559849/uploads/origins/4e8dc83e-5734-4332-a9e8-5ef2d6e8bf88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d758f3af0e51a16e9e22bfe93ed11142", "thumbnail_srcset": "https://si.imgix.net/1c559849/uploads/origins/4e8dc83e-5734-4332-a9e8-5ef2d6e8bf88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d758f3af0e51a16e9e22bfe93ed11142, https://si.imgix.net/1c559849/uploads/origins/4e8dc83e-5734-4332-a9e8-5ef2d6e8bf88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f17801109fb0b0736a35d0e99479af8 2x, https://si.imgix.net/1c559849/uploads/origins/4e8dc83e-5734-4332-a9e8-5ef2d6e8bf88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bfa957cadb988036b36a0d80d718a13 3x", "genre": "art", "nsfw": true, "body": "メギド72のキマリスちゃんがねっとりと胸揉み&乳首責めされて訳が分からないままイかされてしまう作品をリクエストしたいです！\n\n以前の金ビキニ絵がとても刺さりましたので、リクエストさせていただきました。\n\n既存作品のようなモノクロ漫画形式だと嬉しいです。\n\n1．弱点当てゲームのようなノリでモブヴィータに胸をもまれ、乳首をすりすりされてくすぐったがる\n\n2．次第に感じてきて口数が少なくなる。乳首も立って、股間も濡れ始める。\n\n3．イケると思われたヴィータにそのまま乳首責め続けられて、初めての絶頂を味わい、その余韻で恍惚とする。\n\nみたいな流れだと嬉しいです。可能な限りで構いません！\n服装・背景などは簡易的なもので結構です。\n\nよろしければご検討ください。\n\nいぶしシルヴァー様の作品はロリ、ちっぱいも大変魅力的だと思っています。キマシコにご協力いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/18", "thumbnail_src": "https://si.imgix.net/720e7332/uploads/origins/1833a3a1-287e-4bf9-8e6f-42e979777ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ab99afe3e417a24fd666b5e360e68e", "thumbnail_srcset": "https://si.imgix.net/720e7332/uploads/origins/1833a3a1-287e-4bf9-8e6f-42e979777ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ab99afe3e417a24fd666b5e360e68e, https://si.imgix.net/720e7332/uploads/origins/1833a3a1-287e-4bf9-8e6f-42e979777ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ac1a55c0b0a05362f3519406aec3d29 2x, https://si.imgix.net/720e7332/uploads/origins/1833a3a1-287e-4bf9-8e6f-42e979777ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69f15bd15ffe052775e55fe3c56809ec 3x", "genre": "art", "nsfw": true, "body": "こんにちは、はじめまして\n描いて頂きたいのはメギド72のゼパルですhttps://megido72wiki.com/index.php?%E3%82%BC%E3%83%91%E3%83%AB\n\nシチュエーションですが、こちらの画像の様に胸を下から持ち上げられているというイラストをお願いしたいですhttps://twitter.com/Merufena/status/1596058894937509888?t=9Urk5ykUaaGriLFRmJRZhA&s=19\n服は着用していて表情は驚きながら赤面している様子で、腕の位置や胸の大きさ等はお任せしたいと考えております\n\n御検討の程宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/17", "thumbnail_src": "https://si.imgix.net/6d08b440/uploads/origins/45850523-6f76-45dc-80f4-c6db0951ffe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5638fe8170b8f16f676f30f9686a25", "thumbnail_srcset": "https://si.imgix.net/6d08b440/uploads/origins/45850523-6f76-45dc-80f4-c6db0951ffe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5638fe8170b8f16f676f30f9686a25, https://si.imgix.net/6d08b440/uploads/origins/45850523-6f76-45dc-80f4-c6db0951ffe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0ea0e52b67fb793f08c08f54553b5ac 2x, https://si.imgix.net/6d08b440/uploads/origins/45850523-6f76-45dc-80f4-c6db0951ffe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae53137e6660d830f920934263aba6f2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/16", "thumbnail_src": "https://si.imgix.net/adad1275/uploads/origins/f0f33faf-8998-43dd-a70a-5f1ab0576c30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=196a22cce39b3015e15ca91cc4f66efc", "thumbnail_srcset": "https://si.imgix.net/adad1275/uploads/origins/f0f33faf-8998-43dd-a70a-5f1ab0576c30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=196a22cce39b3015e15ca91cc4f66efc, https://si.imgix.net/adad1275/uploads/origins/f0f33faf-8998-43dd-a70a-5f1ab0576c30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=998bbcd0bb55d0322b904d63044f42d7 2x, https://si.imgix.net/adad1275/uploads/origins/f0f33faf-8998-43dd-a70a-5f1ab0576c30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=934ce7571767d2f27815dfe10ce47096 3x", "genre": "art", "nsfw": true, "body": "skeb再開お待ちしておりました。以前はゼパルの素晴らしい漫画をありがとうございます。\nここ最近描かれた乳揉み絵が大変すばらしかったので、今回はそちらのご依頼をお願いしたくリクエストさせていただきました。\n描いていただきたいのはプルフラスです。シチュエーションは「弱点当てゲームをするプルフラス」という感じで、いくつか差分も込みでお願いしたいです。\n\n内容は\n1.弱点当てゲームをしようと持ち掛けられ、快諾するプルフラス。プルフラスは自分には心眼があるので、ハンデとして先行は譲り、気のすむまで探して良いと言う。\n2.弱点を探す為に体を触る男。セクハラじみた行為でもゲームと思ってるプルフラスはニコニコしてる。\n3.乳を触ってここ？と聞く男。しかしそこは弱点じゃないようで、プルフラスは余裕な感じでギブアップするか聞いてくる。当然男はギブアップせずに続ける。\n4.数分後、相変わらず弱点を探す体で乳を揉む男。プルフラスも次第に余裕が無くなってきたのか赤面して感じてる\n5.更に数分後、無遠慮に乳を弄る男に遂にイかされて、自分の負けで良いとギブアップするプルフラス。しかし弱点を隠して嘘をついていたとイチャモンを付けられ、罰ゲームとして更に責められるプルフラス\n\nという感じです。\n差分の内容が細かく多いので、色塗りなどは無くて大丈夫です。\n大まかに内容が合っていれば、細かい部分などはいぶしさんの描きやすい様に変えて頂ければと思います。描きたくない部分などは飛ばしても大丈夫です。\nまた長々としたご依頼で申し訳ありませんが、もしよろしければご一考ください。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/15", "thumbnail_src": "https://si.imgix.net/30ab5e54/uploads/origins/d027167f-302a-473c-a367-265bfd4e63bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db9a40cb2fda196e16ed56f58ec5337", "thumbnail_srcset": "https://si.imgix.net/30ab5e54/uploads/origins/d027167f-302a-473c-a367-265bfd4e63bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db9a40cb2fda196e16ed56f58ec5337, https://si.imgix.net/30ab5e54/uploads/origins/d027167f-302a-473c-a367-265bfd4e63bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64cafa8bf0cf9009a1f28d59a509ad26 2x, https://si.imgix.net/30ab5e54/uploads/origins/d027167f-302a-473c-a367-265bfd4e63bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adbf6407da0d15b24d7bcdc9ef6e6eaa 3x", "genre": "art", "nsfw": true, "body": "トンチキとえっちの塩梅がいつも最高だと思っております。\nメギド72のリヴァイアサンの敗北えっちイラストを依頼したいです。\n\n触手型の幻獣に拘束されたリヴァイアサンが、最初は強気な態度で相手に抵抗しようとするものの、母乳フォトン的なモノで母乳を搾り出されてしまい、快感に情けない顔を晒してしまうところが見たいです。\nさらに性器も寸止めを繰り返されて、最後には自分から挿入を懇願して、みっともない喘ぎ声をあげながら絶頂するような展開だと嬉しいです。\n\nセリフ・擬音などありますと大変ありがたいです。\n\n服装・背景などはいぶしシルヴァー様の描きやすいもので結構です。\n\n予算内で可能な範囲でご検討いただけますと幸いです。\n\n荒っぽいヤンキーで強気だったのに、メスにされちゃうおかーさんが見たいです！よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/14", "thumbnail_src": "https://si.imgix.net/cac3084b/uploads/origins/22406d3d-27e3-45fe-a67e-79bc0588c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=024a911688cfc1c0c350ac762f335d7c", "thumbnail_srcset": "https://si.imgix.net/cac3084b/uploads/origins/22406d3d-27e3-45fe-a67e-79bc0588c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=024a911688cfc1c0c350ac762f335d7c, https://si.imgix.net/cac3084b/uploads/origins/22406d3d-27e3-45fe-a67e-79bc0588c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e9d8a5471a90ad2c9723332fa3d81e7 2x, https://si.imgix.net/cac3084b/uploads/origins/22406d3d-27e3-45fe-a67e-79bc0588c0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=385623da798defe1140204eca0614c1c 3x", "genre": "art", "nsfw": true, "body": "ドーモ、相互搾乳普及委員会の者です。\n願わくば、覚醒スキルの使用で二人に増えたネルガル（バースト）が、爆乳可した互いのおっぱいを吸い合って母乳を飲み合うイラストをお願いできますでしょうか？\nどうかよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/13", "thumbnail_src": "https://si.imgix.net/482099ba/uploads/origins/6f3f13cd-407c-4beb-ba7c-015e20316ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f480dd88e179a218f6dcc63ce9b0553", "thumbnail_srcset": "https://si.imgix.net/482099ba/uploads/origins/6f3f13cd-407c-4beb-ba7c-015e20316ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f480dd88e179a218f6dcc63ce9b0553, https://si.imgix.net/482099ba/uploads/origins/6f3f13cd-407c-4beb-ba7c-015e20316ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8937d232fef6cfd9759d70af7bebd3dc 2x, https://si.imgix.net/482099ba/uploads/origins/6f3f13cd-407c-4beb-ba7c-015e20316ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9654c9fef29467cad6d570874888aef 3x", "genre": "art", "nsfw": true, "body": "メギド72 サキュバス 妊娠ボテ腹部！？", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/12", "thumbnail_src": "https://si.imgix.net/e77f81e2/uploads/origins/4e436023-545f-42f0-9062-04ec8562f45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9f9e764623a5ed9d9c1af9153a171c", "thumbnail_srcset": "https://si.imgix.net/e77f81e2/uploads/origins/4e436023-545f-42f0-9062-04ec8562f45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9f9e764623a5ed9d9c1af9153a171c, https://si.imgix.net/e77f81e2/uploads/origins/4e436023-545f-42f0-9062-04ec8562f45a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8130c66e25edc4995366c036d447e580 2x, https://si.imgix.net/e77f81e2/uploads/origins/4e436023-545f-42f0-9062-04ec8562f45a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8ab5fb5e124426bd0a8e2216992e6c5 3x", "genre": "art", "nsfw": true, "body": "よろしければメギド72のシトリーさんがトンチキ、もとい凶悪な幻獣たちの攻撃を受けて敗北してしまうイラストをお願い致します。\n\n・先に普通の状態の立ち絵で「妙な幻獣が出た？　なら私に任せて」と敗北前の様子を並べて欲しいです。姿はカウンター・ラッシュ・クリスマススキンなど、どれでも描きやすいもので構いません。\n・以前描かれていた牛柄ビキニ催眠噴乳ブラスターによって一瞬で牛柄ビキニコスに姿を変えられてしまい、母乳を出せば元の格好に戻れると催眠されて自ら乳房を搾り快感を覚えながら噴乳してしまう。\n・さらにエノイル型の幻獣の混乱音波を受けて幻獣を敵でないと認識してしまい、身体に絡みつく触手も噴乳を手伝ってくれようとしていると誤認し、触手に身を委ねながらまた母乳を噴き出してしまう。\n・その後行方不明になったシトリーは幻獣の巣に連れ去られており牛コスのまま爆乳化した胸を搾られて、大量の母乳を出す快感に酔いしれてあられもない声を出す幻獣専用ミルクサーバーに堕ちていた……\n\n長くなりましたが以上が大まかな流れになります。いぶしシルヴァーさんの好みで展開はアレンジしてもらって構いません。\nご検討いただけると嬉しいです。よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/11", "thumbnail_src": "https://si.imgix.net/5d6df157/uploads/origins/ea7119b2-0920-433a-a4e8-684bfac46d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c1c7d77eddd751c810969b6302c2ef3", "thumbnail_srcset": "https://si.imgix.net/5d6df157/uploads/origins/ea7119b2-0920-433a-a4e8-684bfac46d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c1c7d77eddd751c810969b6302c2ef3, https://si.imgix.net/5d6df157/uploads/origins/ea7119b2-0920-433a-a4e8-684bfac46d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68c872f348842e90a673970f774dd425 2x, https://si.imgix.net/5d6df157/uploads/origins/ea7119b2-0920-433a-a4e8-684bfac46d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7b7dfe9a3cec509cc584d0362f96609 3x", "genre": "art", "nsfw": true, "body": "以前催眠ゼパル絵を依頼させていただいたものです。\nこの度はこちらの不手際により依頼をキャンセルしてしまい、申し訳ございませんでした。\n何度も申し訳ないのですが、再度同じ内容でご依頼させていただきますので、また再検討の程お願い致します\n下記にて前回と同じ内容の依頼分を掲載しておきますので、ご参考ください。\n\n―――――――――――\nはじめまして。いつも描かれた絵を楽しく拝見させていただいております。\nこの度は、いぶしシルヴァー様に是非描いてもらいたい内容があり、ご依頼させていただきました。\n私は昔描かれたプルフラスやゼパルの触手絵が好きで、過激な内容の中で描かれた女性たちの絶妙な表情が特にお気に入りのポイントです。\n今回の依頼内容もそういった過激なものであり、また、依頼の詳細も細かく多くなってしまっているのですが、もしよろしければご一考いただけると幸いです。\n\n・内容\nメギド72のゼパル（ラッシュ）の催眠凌辱絵を、数枚の差分かもしくは漫画形式で描いてもらいたいです。色塗りは大変でしたら無しでOKです。\n大まかな流れは、\n\n1.複数人の男に声を掛けられるもしつこいと怒り、あしらうゼパル\n2.こちらを向いた隙に催眠をかけられ、そのまま路地裏に連れられる（催眠方法は適当で良いです。遺物とかそういう技術とか･･････）\n3.何されてるかわかってない状態で複数人から体中を好き勝手弄られるも、催眠で無抵抗のゼパル（嫌悪感と快楽は感じるも、それを認識出ていない感じ）\n4.更に催眠を重ね掛けされ、感度を上げられた上あちこちの性感帯を勝手に開発され、ベロチューや手マンでイかされる\n5.数時間後、男達に好き勝手に遊ばれた跡（はだけたり破れたりしてる衣服、キスマーク、秘部からあふれる精液、精液を貯めた帽子や靴、手袋を被せられる、ぶっかけ等）のあるゼパルを掛けた催眠もそのままに街中で放置。ゼパルは処理しきれない快楽に痙攣している感じが良いです\n\nとなります。\nまた、もし可能でしたら、4～5の間として犯されてる絵もあるとうれしいです。ただ、既にかなり量の内容を要求しているため、割に合わないと感じたら無くてもOKです。\n\n長々と失礼しました。細かい依頼になりますが、大まかな流れさえ汲んでいただければ、いぶしシルヴァー様の描きやすい様にアレンジしてくださって構いません。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/10", "thumbnail_src": "https://si.imgix.net/9bd61d0c/uploads/origins/6e9165ff-41ed-489c-ae41-05dde9067584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc41f20bbe53295ba179eb7d0176601d", "thumbnail_srcset": "https://si.imgix.net/9bd61d0c/uploads/origins/6e9165ff-41ed-489c-ae41-05dde9067584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc41f20bbe53295ba179eb7d0176601d, https://si.imgix.net/9bd61d0c/uploads/origins/6e9165ff-41ed-489c-ae41-05dde9067584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7918075b902b4682ab9ed73fd472aff2 2x, https://si.imgix.net/9bd61d0c/uploads/origins/6e9165ff-41ed-489c-ae41-05dde9067584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7d765e0ab340b8d645e6432e74e25e1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/9", "thumbnail_src": "https://si.imgix.net/566e531f/uploads/origins/3da7f8b3-b174-4dea-88cc-f1bba112796f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9c625c002f173f05f3b43e3e81a20a", "thumbnail_srcset": "https://si.imgix.net/566e531f/uploads/origins/3da7f8b3-b174-4dea-88cc-f1bba112796f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9c625c002f173f05f3b43e3e81a20a, https://si.imgix.net/566e531f/uploads/origins/3da7f8b3-b174-4dea-88cc-f1bba112796f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21e125a03b0a375c949867cb3ba9861b 2x, https://si.imgix.net/566e531f/uploads/origins/3da7f8b3-b174-4dea-88cc-f1bba112796f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c8e0bc13e24eaf6935a70203a7fe568 3x", "genre": "art", "nsfw": true, "body": "プルフラスとウァサゴをお願いします。\n服装はどちらもバニーで、ノイエルの混乱を受けて二人とも胸の部分をポロリさせている状態でお願いしたいです。\nその際、乳首を大きめにしていただけると嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ibusilver/works/8", "thumbnail_src": "https://si.imgix.net/c9c4ef0f/uploads/origins/c3f52a8e-8d8a-4b6a-82b3-5d3407cd4246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03318d4f9ef8f6f8f6ee104d4828282c", "thumbnail_srcset": "https://si.imgix.net/c9c4ef0f/uploads/origins/c3f52a8e-8d8a-4b6a-82b3-5d3407cd4246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03318d4f9ef8f6f8f6ee104d4828282c, https://si.imgix.net/c9c4ef0f/uploads/origins/c3f52a8e-8d8a-4b6a-82b3-5d3407cd4246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6499fa0eb7b572f73734f74e4e3b62f8 2x, https://si.imgix.net/c9c4ef0f/uploads/origins/c3f52a8e-8d8a-4b6a-82b3-5d3407cd4246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ab38ed688dea0ca930d1a4b383146b0 3x", "genre": "art", "nsfw": true, "body": "メギド72のオリアスさんが縦セタ(クリスマス衣裳のです)着衣パイズリで乳内射精されてる1P漫画形式イラストお願いします！(アミーの奴みたいな形式)\n\nコートは脱いだ状態で縦セタ着て家に居たオリアスさんの所に近くの住人の一人が「予言者様！おっぱいをお貸しください！良いんですか、ありがとうございます！」と押し掛けてきて胸の谷間の下側にハサミで勝手にパイズリ穴を開けて着衣パイズリを始めちゃいます。\nオリアスは呆気に取られてる間にセーターに穴を開けられて「あーっ！！」と驚いているうちに挿乳されてます。困惑していてパイズリを強引にやめさせる発想に至らず、言葉でなんとかやめさせようとしますが無視されてしまいます。\n\n男はそのまま独り言気味に感想を言いながらパイズリを続け、気持ち良さそうにたっぷり乳内射精して谷間とセーターを精液まみれにしてから「ありがとうございます予言者様…」とちんちんを抜きます。\n\nオリアスは射精された時には「あーっバカバカバカー！」とおこり、パイズリが終わって抜かれたあとには「うう、お気に入りのセーターだったのにぃ…」とセーターがダメにされてしまってちょっと泣いちゃいそうになってます。\n\n・若干ギャグ気味で勢いまかせなノリです\n・セリフは変更していただいても構いません。\n\nよろしくお願いします！", "created_at": ""