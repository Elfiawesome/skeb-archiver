r=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68fdb71781ae5d0da9f56712d41eda34 2x, https://si.imgix.net/d8aac122/uploads/origins/42a301ea-07c3-403b-968e-a6a42ce6e5fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=184136f12e61158c659bc22bc1d078e0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tskbar/works/50", "thumbnail_src": "https://si.imgix.net/0c1ef74a/uploads/origins/3059f284-06c7-49c3-ba69-c282e65457a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09f49842f4a4fb99ccf57140f7fab865", "thumbnail_srcset": "https://si.imgix.net/0c1ef74a/uploads/origins/3059f284-06c7-49c3-ba69-c282e65457a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09f49842f4a4fb99ccf57140f7fab865, https://si.imgix.net/0c1ef74a/uploads/origins/3059f284-06c7-49c3-ba69-c282e65457a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a0e3c272876e4d2e345c167e5b94370 2x, https://si.imgix.net/0c1ef74a/uploads/origins/3059f284-06c7-49c3-ba69-c282e65457a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46aafa7f9ff10dbc7842725284dd9cbb 3x", "genre": "comic", "nsfw": true, "body": "初めまして。トグチマサヤさんの絵柄がとても好みでしたので今回リクエストお願いします。お題はコミック形式で「爆乳ママのエッチな日常風景」です。女性の外見は概ねお任せしますが衣装は胸元を大きく開けたブラウスと超ミニなタイトスカートでおねがいします。以下設定と内容の流れです。竿役の姿は写さないいわゆる主観視点です。\n・女性が「じゃあ坊や。コレあげるからイイ子にして待っててね♡」とブラを抜き取ってこちらへ渡す。渡されたブラには乳染みがついている。\n・おっぱいを揺らしながらテーブルを拭く。\n・「とうとう掃除機がダメになっちゃったわね・・・新しいの買わないと・・・」と言いながら床磨きしてる姿がしゃがみパンチラ。\n・四つん這いになり棚の隙間の何かを必死に取ろうとする姿がこちらに尻を振りながらがっつりパンツを見せつけてる。\n・「お待たせ～イイ子にして待っててエライエライ♡じゃあイイ子にはご褒美ね♡」と前かがみで谷間を見せつけながら頭を撫でてくれる。\n・正座をしおっぱいをさらけ出した女性が「さぁいらっしゃい♡おっぱいチュッチュッしながらシコシコする？それともパコパコする？」と片手は手コキのそぶりもう片方はスカートをずらし足を少し広げパンツを見せつける。以上の内容を３～４ページでお願いできますでしょうか？よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tskbar/works/49", "thumbnail_src": "https://si.imgix.net/64dace2e/uploads/origins/1080a477-6544-4956-aef0-2bf66083d557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f92663fd6b68459d1f031118cc4479c", "thumbnail_srcset": "https://si.imgix.net/64dace2e/uploads/origins/1080a477-6544-4956-aef0-2bf66083d557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f92663fd6b68459d1f031118cc4479c, https://si.imgix.net/64dace2e/uploads/origins/1080a477-6544-4956-aef0-2bf66083d557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4159f80b616c4275a7f99999d917e19 2x, https://si.imgix.net/64dace2e/uploads/origins/1080a477-6544-4956-aef0-2bf66083d557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=083584342ad83501c06a15cb9a075d6c 3x", "genre": "art", "nsfw": true, "body": "トグチマサヤ先生\nお疲れ様です。前回は本当にありがとうございました。\n(前回: https://skeb.jp/@tskbar/works/44)\n\nまた前回の爆乳美熟女を描いて頂きたいです。\n格好は踊り子風のコスプレでお願いします。乳首を露出させてください。脇毛陰毛、股間から垂れる愛液があれば幸いです。\nポーズはガニ股腰振りダンスでお願いします。\n表情は発情しながら挑発的に舌なめずりしている顔でお願いします。\nもし可能であれば差分を描いていただければ幸いです。その際は全裸でお願い致します。\n\nお忙しい中恐縮ですが、よろしくお願いいたします。\n\n髪型の参考:\nhttps://livedoor.blogimg.jp/anime_joho/imgs/b/c/bc078270.jpg\nhttps://i.imgur.com/nzTPRXB.jpeg\nhttps://i.imgur.com/iV514Q2.jpeg\n\n格好の参考: https://www.pixiv.net/artworks/37792909\n\n表情の参考: https://www.pixiv.net/artworks/43568533", "created_at": "", "completed_at": ""}, {"path": "/@tskbar/works/48", "thumbnail_src": "https://si.imgix.net/de7b97ef/uploads/origins/ee4590e8-81aa-4429-ae35-b8934bf35a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e3646f0d350ecdec916ac0a3631c11f", "thumbnail_srcset": "https://si.imgix.net/de7b97ef/uploads/origins/ee4590e8-81aa-4429-ae35-b8934bf35a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e3646f0d350ecdec916ac0a3631c11f, https://si.imgix.net/de7b97ef/uploads/origins/ee4590e8-81aa-4429-ae35-b8934bf35a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2565e72967e2508204fa4ddbf511e612 2x, https://si.imgix.net/de7b97ef/uploads/origins/ee4590e8-81aa-4429-ae35-b8934bf35a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fe3776a9b776979a546bdc81e48fa70 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tskbar/works/47", "thumbnail_src": "https://si.imgix.net/60176e97/uploads/origins/bd12fa30-e2db-4e7a-857f-70c3a99fd8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1d8189bddf5130ad1e0a4e214f62149", "thumbnail_srcset": "https://si.imgix.net/60176e97/uploads/origins/bd12fa30-e2db-4e7a-857f-70c3a99fd8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1d8189bddf5130ad1e0a4e214f62149, https://si.imgix.net/60176e97/uploads/origins/bd12fa30-e2db-4e7a-857f-70c3a99fd8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b46dbe3c73bb8a592a2c80327ff353aa 2x, https://si.imgix.net/60176e97/uploads/origins/bd12fa30-e2db-4e7a-857f-70c3a99fd8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7381ce762416049826083c7d3ce52f0 3x", "genre": "art", "nsfw": true, "body": "先生の大ファンです！同人誌や単行本も拝見させていただいています。一番好きなのは「艶女交妻」の温泉の乱交シーンです。skebを行なっているということで、初めて依頼させていただきます。\n二次創作依頼なので、無理なようでしたらキャンセルお願いします。\n\nキャラ:閃乱カグラの春花をお願いします。先生のタッチで見たいので、美熟女化して胸は特盛、腹・太ももなどもムッチムチにお願いしたいです。服装は忍転身衣装の白衣＋白のニーハイソックス＋白の長い手袋でそれ以外は裸でお願いします。\nポーズはガニ股で白衣を左右に大きく開いて裸体をさらけ出す(露出魔・露出狂のような？)イメージでお願いしたいです。恥じらうのではなく、自信をもってさらけ出すイメージです。\nこちらを挑発するようなニヤニヤ笑顔でお願いします。\n\nシチュエーション:美しい肉体・おっぱいをさらけ出し、周りに集めたショタをシコらせるシチュエーションでお願いします。春花はこちら正面に露出させ、周りのショタはそれを見ながらシコらせて下さい。ショタは後ろ姿等で大丈夫です。かわいい系で、できる限り幼く、ちいさな性器でお願いします。\n\n差分はできる限りで大丈夫ですが、全身ぶっかけ差分と卑猥な落書き(ショタに描かせたもの)があると非常に非常に嬉しいです。\n\n要望が盛り盛りで申し訳ございません。ご検討よろしくお願いします。再送などもお待ちしております。", "created_at": "", "completed_at": ""}, {"path": "/@tskbar/works/46", "thumbnail_src": "https://si.imgix.net/a2354682/uploads/origins/2b766c3d-71de-46d9-bb68-387c494ba213?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dcab61802fb48fd03d9b346972981cf", "thumbnail_srcset": "https://si.imgix.net/a2354682/uploads/origins/2b766c3d-71de-46d9-bb68-387c494ba213?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dcab61802fb48fd03d9b346972981cf, https://si.imgix.net/a2354682/uploads/origins/2b766c3d-71de-46d9-bb68-387c494ba213?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04d4a3ab61b1470467ca1ca892feb594 2x, https://si.imgix.net/a2354682/uploads/origins/2b766c3d-71de-46d9-bb68-387c494ba213?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b3c735a1b2c29589302e8d5cd46e303 3x", "genre": "art", "nsfw": true, "body": "イラストお願いします、らんま2/1シャンプー、全裸で膝立ち姿でおむつ着用(やや小さめのおむつにマジックテープ留め)姿でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tskbar/works/45", "thumbnail_src": "https://si.imgix.net/816d8679/uploads/origins/33c26aca-7d79-4794-bbe4-6d69ca958073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8691da6a7e753ae98af6af9ee896c08", "thumbnail_srcset": "https://si.imgix.net/816d8679/uploads/origins/33c26aca-7d79-4794-bbe4-6d69ca958073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8691da6a7e753ae98af6af9ee896c08, https://si.imgix.net/816d8679/uploads/origins/33c26aca-7d79-4794-bbe4-6d69ca958073?bg=%23fff&auto=forma