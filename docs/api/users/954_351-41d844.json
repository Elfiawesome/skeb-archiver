%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8d23c84f7b8e78db2a540e7243d842a 2x, https://si.imgix.net/6714e923/uploads/origins/5af5f072-a90e-464e-a3e0-c46cfad002ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67a773ceb6e14ab9ba21f91acf8f4a1a 3x", "genre": "art", "nsfw": true, "body": "前回は素敵なフーロンのイラストをありがとうございました。\nよろしければ再度のリクエストをお願いします。\n\n【キャラクター】\n魔戦団長イングリッド（千年戦争アイギス）\n\n【シチュエーション】\n・机の下で、王子にパイズリフェラかパイズリで奉仕をしているイラストをお願いします。\n・今回も甘めのシチュエーションで、執務室での行為に戸惑いながらも懸命に奉仕をし、たっぷり射精されたことに蕩けつつも満足げな様子を見せるというようなイメージです。\n・衣装についてはお好きなものを選んでください。また、衣装はずらすか、脱衣差分で乳首も見えるようにお願いします。\n・描き文字のハートマークや擬音をお願いします。\n差分として、表情差分や精液差分、母乳差分等をお願いします。\n\nご検討いただけましたら幸いです。\n\nhttps://www.dropbox.com/scl/fo/mbsszyv3h62151dffwuvk/AEsX06NYuV55pk1y0OnO45Q?rlkey=wn7sstdsuc8b0taqhu8txhcge&st=b6fx95os&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@954_351/works/3", "thumbnail_src": "https://si.imgix.net/fe92a4d8/uploads/origins/f1026c9b-399e-4df8-bc87-4f5cab65adfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3021c1fb15d54fab55def82aa7696dd", "thumbnail_srcset": "https://si.imgix.net/fe92a4d8/uploads/origins/f1026c9b-399e-4df8-bc87-4f5cab65adfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3021c1fb15d54fab55def82aa7696dd, https://si.imgix.net/fe92a4d8/uploads/origins/f1026c9b-399e-4df8-bc87-4f5cab65adfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adcd4155e43322f7d44e64d858bd6d27 2x, https://si.imgix.net/fe92a4d8/uploads/origins/f1026c9b-399e-4df8-bc87-4f5cab65adfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25fba7fe2ae99ba45a355e3c6249bb1 3x", "genre": "art", "nsfw": true, "body": "アークナイツのカッターを描いて頂けますか？スカートをたくしあげてパンツを全部見せてくれるイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@954_351/works/2", "thumbnail_src": "https://si.imgix.net/2fcdd179/uploads/origins/d60e480c-0ef3-4a57-beb5-2e9160484ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab605d49157ba913fa0e4283051e7c5e", "thumbnail_srcset": "https://si.imgix.net/2fcdd179/uploads/origins/d60e480c-0ef3-4a57-beb5-2e9160484ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab605d49157ba913fa0e4283051e7c5e, https://si.imgix.net/2fcdd179/uploads/origins/d60e480c-0ef3-4a57-beb5-2e9160484ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25869a4d4733b439043ba0bc72489a69 2x, https://si.imgix.net/2fcdd179/uploads/origins/d60e480c-0ef3-4a57-beb5-2e9160484ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ef0d5b4992f81980b985171eec48db0 3x", "genre": "art", "nsfw": true, "body": "リンネのイラストがとても可愛かったので、リクエストをさせていただきました。\nよろしければお願いします。\n\n【キャラクター】\n幽境道士フーロン（千年戦争アイギス）\nhttps://seesaawiki.jp/aigis/d/%cd%a9%b6%ad%c6%bb%bb%ce%a5%d5%a1%bc%a5%ed%a5%f3\nhttps://seesaawiki.jp/aigis/d/%cd%a9%b6%ad%bf%b7%c9%d8%a5%d5%a1%bc%a5%ed%a5%f3\n\n【シチュエーション】\n・背面座位か騎乗位で、結合部が見えるような形で子作りHをしているというイラストをお願いします。\nキョンシーでありながら、花嫁願望を秘めたフーロンを孕ませようと頑張る王子に呆れつつも、嬉しさが隠し切れないというようなイメージです。\n\n・衣装は花嫁verも含めて、胸は露出させた半脱ぎ状態にして頂ければ、お好きなものからお任せします。また、頭のお札は付けたままでお願いします。\n・描き文字のハートマークや擬音は有りで甘々な感じだと嬉しいです。\n・差分として、射精時の表情や精液差分と母乳差分等をお願いします。\n　また、金額や性癖的に問題なければ妊娠時の差分も頂ければ嬉しいです。\n\nご検討いただけましたら幸いです。\n\nhttps://twitter.com/chiri_atoranta/status/1480104200902410240/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@954_351/works/1", "thumbnail_src": "https://si.imgix.net/b9f912b2/uploads/origins/158f46f4-41ba-49ad-ab24-c71921983590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8baa6844f5031f48b3cb41ff7288a56a", "thumbnail_srcset": "https://si.imgix.net/b9f912b2/uploads/origins/158f46f4-41ba-49ad-ab24-c71921983590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8baa6844f5031f48b3cb41ff7288a56a, https://si.imgix.net/b9f912b2/uploads/origins/158f46f4-41ba-49ad-ab24-c71921983590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5692dab071f4eaeed535af7962fd722b 2x, https://si.imgix.net/b9f912b2/uploads/origins/158f46f4-41ba-49ad-ab24-c71921983590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59592978f80262337b87d4608c0b2c15 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}