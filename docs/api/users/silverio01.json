233-49cb-898c-ffb12d88ceab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c84c380bfd09f7b861dac6643e807f97, https://si.imgix.net/5baa6927/uploads/origins/f89b15a8-5233-49cb-898c-ffb12d88ceab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb48067ec8cac7dfccf4bb569c3824d5 2x, https://si.imgix.net/5baa6927/uploads/origins/f89b15a8-5233-49cb-898c-ffb12d88ceab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68d6d2ad06825ac90b0827a5380a7842 3x", "genre": "comic", "nsfw": true, "body": "銀ノ助さん！お疲れ様です！！以前は漫画を描いていただきありがとうございました！！！！！\n\n今回は生意気オスガキ狐勇者君がエロトラップダンジョンに挑戦して、敗北してしまい射精しまくってしまうイラストを描いてほしいです！乳首を弄られながら射精しているととても嬉しいです！\n\nエロトラップの種類は銀ノ助さんにお任せ致します！\nシチュエーションは触手でもミノタウロスでもオークでも巨根化でもなんでも大丈夫です！！\n\nよろしくお願い致します！！\n\nhttps://drive.google.com/drive/folders/1WAGww3WnhPcg4X8APh7tVvn2q9AFYxwF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/29", "thumbnail_src": "https://si.imgix.net/d2ab4e42/uploads/origins/0b5b300d-d4d6-444d-a8a6-2dbfcfdf9774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91c74bd4f2a199e498fd7a71455509f8", "thumbnail_srcset": "https://si.imgix.net/d2ab4e42/uploads/origins/0b5b300d-d4d6-444d-a8a6-2dbfcfdf9774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91c74bd4f2a199e498fd7a71455509f8, https://si.imgix.net/d2ab4e42/uploads/origins/0b5b300d-d4d6-444d-a8a6-2dbfcfdf9774?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74ddffb7c635791bd3a715dc11f5885e 2x, https://si.imgix.net/d2ab4e42/uploads/origins/0b5b300d-d4d6-444d-a8a6-2dbfcfdf9774?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a6f0af637108bdd4014d8419f1445c1 3x", "genre": "art", "nsfw": true, "body": "初恋運命論が発刊したころくらいからずっと銀ノ助さんのイラストのファンで憧れていて、初めて依頼をさせていただきます。\n\nOCの獣人「あおいいぬ」をお願いしたいです。\n同じポーズの差分でバスケットユニフォーム（背番号6番でお願いします）と学生服みたいなのワイシャツスラックスの2衣装のイラストをお願いしたいです。\n\nまた、お値段見合うようでしたらそれぞれの上裸（とこれもできたらですが全裸も）の差分もいただけると嬉しいです。\n\n毛皮の色と黄色い目、チャームポイントの赤いバンダナ以外にこだわりはなく、銀ノ助さんの絵柄で描いていただければ嬉しいです。\nまた、ピアスなどのアクセサリーも似合いそうなものをつけていただければと思います。\n\nスマホの壁紙などに個人的に使わせていただきたいと考えておりますので、背景は単色かなくて構いません。\n\n過去に自分が描いたもの、依頼などで描いていただいたものを資料URLに置いていますのでご参考ください。\n\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1e2h-CEfApEr6tljlO2VzjaQsRrgC-ZlT?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/28", "thumbnail_src": "https://si.imgix.net/39493520/uploads/origins/7d5e727a-3da1-4e4a-a40a-77a60a37441c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbae58b2eebdefeecd41129075d65dc3", "thumbnail_srcset": "https://si.imgix.net/39493520/uploads/origins/7d5e727a-3da1-4e4a-a40a-77a60a37441c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbae58b2eebdefeecd41129075d65dc3, https://si.imgix.net/39493520/uploads/origins/7d5e727a-3da1-4e4a-a40a-77a60a37441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0de4a723f52e94b5b86c42a1f70880f8 2x, https://si.imgix.net/39493520/uploads/origins/7d5e727a-3da1-4e4a-a40a-77a60a37441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c67a19ab9abc4a3f2b464dbb56fc3b4 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/27", "thumbnail_src": "https://si.imgix.net/22fd6579/uploads/origins/15f534f7-6c3b-44dc-b67e-6a8929dbfc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b9d76bca144fd8903a7a3d4ee591337", "thumbnail_srcset": "https://si.imgix.net/22fd6579/uploads/origins/15f534f7-6c3b-44dc-b67e-6a8929dbfc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b9d76bca144fd8903a7a3d4ee591337, https://si.imgix.net/22fd6579/uploads/origins/15f534f7-6c3b-44dc-b67e-6a8929dbfc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c745722eac963b45100fe337370daab9 2x, https://si.imgix.net/22fd6579/uploads/origins/15f534f7-6c3b-44dc-b67e-6a8929dbfc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a3755f76e9785059cf5483cf77b10d 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nファイナルファンタジー7のガリアンビースト(R-18)の全身像をお願いできますでしょうか。\n\n\nシチュエーションとしてはこちらのような色質感で段階的に徐々に石化していき、最終的には完全に石化した姿です。\nhttps://skeb.jp/@silverio01/works/19\n\nポージングやイメージは、徐々に石化していきあっけにとられたような表情でよろしいでしょうか。\nhttps://skeb.jp/@silverio01/works/19\n\n\nまた、もし差し支えなければ\n各差分毎に台詞パターンも可能でしょうか。（こちらは難しいようでしたらなしでも構いません）\n台詞内容は銀ノ助さんの好きな台詞や想像でOKです。\n\n\n[キャラクターイメージ]\nhttps://skeb.jp/@Tos_Tos_F_ski/works/74\nhttps://drive.google.com/file/d/17ax_OXvDMoPXbtaXTL3v_9-bJ8xbsvBV/view?usp=sharing\nhttps://drive.google.com/file/d/19xRvvyjkfMIUApIvqiftiE2wLxZOMQ1n/view?usp=sharing\nhttps://drive.google.com/file/d/1ndYVmzumG_zlm_cTq7mrca99eSTFLgz2/view?usp=sharing\nhttps://drive.google.com/file/d/1dwRUuLDPu3_8ianpLjLVWZUlvpflIOUU/view?usp=sharing\nhttps://skeb.jp/@Tos_Tos_F_ski/works/37\n\nhttps://drive.google.com/file/d/1JKpgJKmGMcmnNkNGMhRM948uoeBMxEeA/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/26", "thumbnail_src": "https://si.imgix.net/d0ec8232/uploads/origins/9fbc0512-22d7-4077-858c-81d0368ae0d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5f384e9b3225f83304b84a3d828d78b", "thumbnail_srcset": "https://si.imgix.net/d0ec8232/uploads/origins/9fbc0512-22d7-4077-858c-81d0368ae0d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5f384e9b3225f83304b84a3d828d78b, https://si.imgix.net/d0ec8232/uploads/origins/9fbc0512-22d7-4077-858c-81d0368ae0d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6a88d66a44d5552b4b5eaba9b0ba28b 2x, https://si.imgix.net/d0ec8232/uploads/origins/9fbc0512-22d7-4077-858c-81d0368ae0d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=def6ec74e7ba6dd758f0d6822f34e708 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/25", "thumbnail_src": "https://si.imgix.net/3929ddb5/uploads/origins/1dc51781-febc-4140-928b-a26827ac4cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c228b7b0f04980e564126187604830", "thumbnail_srcset": "https://si.imgix.net/3929ddb5/uploads/origins/1dc51781-febc-4140-928b-a26827ac4cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c228b7b0f04980e564126187604830, https://si.imgix.net/3929ddb5/uploads/origins/1dc51781-febc-4140-928b-a26827ac4cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=823b413167bc3185bbd71db7509aed8d 2x, https://si.imgix.net/3929ddb5/uploads/origins/1dc51781-febc-4140-928b-a26827ac4cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa9d6d65bd18c975213962a684738811 3x", "genre": "art", "nsfw": true, "body": "クレサガのハクマが、全裸フル勃起状態でオスケモガーゴイルに犯されて、足から徐々に石化していくシチュエーションをお願いします。\n石化はヒビ無しで毛色や模様に関わらず統一で、石化した後も意識と感覚は残ったままでお願いします。\n差分の一つに顔以外石化した状態をお願いします。\nガーゴイルの種族などは銀ノ助さんにお任せします。\n\nhttps://drive.google.com/file/d/12z-Q11FxdaVZrENJsg7phmvdHB6wcUUF/view?usp=drivesdk\nhttps://drive.google.com/file/d/13GzozJTUBRAsWBf8XnM1s-Sukh-GEpUo/view?usp=drivesdk\nhttps://drive.google.com/file/d/12qiMPt22sI6O4DpUTzC6kIGG0wVpjsis/view?usp=drivesdk\nhttps://drive.google.com/file/d/136TEJRDv2Q7EEZpzML1hgB8w6vSjRV4k/view?usp=drivesdk\n↑のリンクはゲーム内でのハクマのイラストです。\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/24", "thumbnail_src": "https://si.imgix.net/f327361d/uploads/origins/53f548ec-cca2-4dd3-a3ad-b80310003897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7cf1959be9d6a19ea1f00f68f8a33f", "thumbnail_srcset": "https://si.imgix.net/f327361d/uploads/origins/53f548ec-cca2-4dd3-a3ad-b80310003897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7cf1959be9d6a19ea1f00f68f8a33f, https://si.imgix.net/f327361d/uploads/origins/53f548ec-cca2-4dd3-a3ad-b80310003897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33a66db074794ef3169f5fe8ea0beb3c 2x, https://si.imgix.net/f327361d/uploads/origins/53f548ec-cca2-4dd3-a3ad-b80310003897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4795e7e89bef2ff824453c62bbbb089 3x", "genre": "art", "nsfw": true, "body": "あけましておめでとう、\nレッドと申します。 \n\n今回依頼していただきたい内容は： \n- うちの仔Vesperのイラストを描いていただきたいです。 \n-毛並みはふさふさにして、体はちょっと筋肉質にしていただきたいです。 \n-石化触手に四肢を拘束されて犯されながらアへ顔でフル勃起射精している\n-体は50%で石化していて\n-色は暗めの灰色で模様や体毛の色に関わらず同じ色で\n-差分は体は100%で石化していて\n- 他の内容と構図などはおまかせでございます。 \n- 宛名とサインやモザイクがあれば、別レイヤでお願いしたいです。\n\n よろしくおねがいします。\n\nhttps://www.dropbox.com/sh/23esint30x7hbaq/AADF214HVszcqc7gfccc09Bfa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/23", "thumbnail_src": "https://si.imgix.net/2ecd91b5/uploads/origins/4852301f-439f-4167-86cb-604ff6fd9d6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41c207f1ff0ee82343b1efc279b9581", "thumbnail_srcset": "https://si.imgix.net/2ecd91b5/uploads/origins/4852301f-439f-4167-86cb-604ff6fd9d6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41c207f1ff0ee82343b1efc279b9581, https://si.imgix.net/2ecd91b5/uploads/origins/4852301f-439f-4167-86cb-604ff6fd9d6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70cf67903f576527b120a7c98973927c 2x, https://si.imgix.net/2ecd91b5/uploads/origins/4852301f-439f-4167-86cb-604ff6fd9d6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438ef71c40d8dfab6081fe4c8907bece 3x", "genre": "art", "nsfw": true, "body": "銀之助さん、こんにちは\n\n私のリクエストとしては、この漫画のドラゴンの写真が欲しいのですが、もっと筋肉質なものです。シチュエーションとしては、子宮タトゥーの呪いで性器が大きくなり、性欲が増した状態で目覚める。彼はオナニーをして自分の上でオーガズムを感じるが、彼の精液は代わりに黒いゴムとなり、彼を覆ってスーツを形成し始める。彼は抵抗しようとするが止められず、ついには完全にスーツに支配されてしまう。\n\nこれはおそらく1ポーズの写真になると思うが、スーツが彼をどんどん覆っていくのでバリエーションがある。\n\nhttps://www.dropbox.com/sh/x9ijfcq9sewzvi1/AAA4cCiSkYciXAM5pbEe_d1va?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/22", "thumbnail_src": "https://si.imgix.net/3a14edae/uploads/origins/526de7fc-049e-4cf9-bbd4-b5f7feb53aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e34d6327eaec886e49069e55e0ee0119", "thumbnail_srcset": "https://si.imgix.net/3a14edae/uploads/origins/526de7fc-049e-4cf9-bbd4-b5f7feb53aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e34d6327eaec886e49069e55e0ee0119, https://si.imgix.net/3a14edae/uploads/origins/526de7fc-049e-4cf9-bbd4-b5f7feb53aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2b46847eef7277d3cdeb991ecf1c81c 2x, https://si.imgix.net/3a14edae/uploads/origins/526de7fc-049e-4cf9-bbd4-b5f7feb53aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=192764ad1bbc086efd2b189c4cf947a9 3x", "genre": "art", "nsfw": true, "body": "私の推測では、右手に寄生しているスライムが青猫を洗脳し、触手を使って青猫の姿勢を矯正し、青猫が従順で強い戦士になるようにしている。\n\nhttps://drive.google.com/file/d/1RDlAUVzqDaePxNDjv1vrcCWhvyIL1BxR/view?usp=drivesdk\n\nありがとう。\n\nhttps://drive.google.com/file/d/1RDlAUVzqDaePxNDjv1vrcCWhvyIL1BxR/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/21", "thumbnail_src": "https://si.imgix.net/93b80696/uploads/origins/aa94661f-8804-4841-b5a4-d12f85aaf1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=241ac72f04d89e6360de86de2e93cb5b", "thumbnail_srcset": "https://si.imgix.net/93b80696/uploads/origins/aa94661f-8804-4841-b5a4-d12f85aaf1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=241ac72f04d89e6360de86de2e93cb5b, https://si.imgix.net/93b80696/uploads/origins/aa94661f-8804-4841-b5a4-d12f85aaf1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e14cce3fdaf8f0759efc412331b6f7c 2x, https://si.imgix.net/93b80696/uploads/origins/aa94661f-8804-4841-b5a4-d12f85aaf1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b22eeeba6680d78d4e2adb0b55d6141 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます大丈夫ですかな？今年のお正月に投稿された緑色龍人さんが両手に扇子を持って裸踊りをしているというのを。酔っぱらっているのか催眠されてるのか締まりのないアヘ顔で、体に「二〇二四」「謹賀新年」「変態」「正（射精した回数）」など筆で悪戯書きをされており、スリットから飛び出た勃起肉棒の根本にはお正月の注連縄が巻かれていて鈴が提げられていたりとオメデタイ飾り付けがされているというのをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/20", "thumbnail_src": "https://si.imgix.net/a3616792/uploads/origins/a37a2e57-6924-4b5d-a049-eff82ef317c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=882a14e2c9858e994ef01b66c2f493b2", "thumbnail_srcset": "https://si.imgix.net/a3616792/uploads/origins/a37a2e57-6924-4b5d-a049-eff82ef317c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=882a14e2c9858e994ef01b66c2f493b2, https://si.imgix.net/a3616792/uploads/origins/a37a2e57-6924-4b5d-a049-eff82ef317c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa1aa7b62a14ad880ea38ef0af99fd7e 2x, https://si.imgix.net/a3616792/uploads/origins/a37a2e57-6924-4b5d-a049-eff82ef317c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=566e4dc67ba83b373219e30653e81138 3x", "genre": "art", "nsfw": false, "body": "はじめましてこんにちは。お休み中に失礼します。あけましておめでとうございますm。\nいつもあなたの素敵なイラストの数々を拝見しています。\n今回は自分の代理キャラを描いていただきたく依頼をしました。\n\nシチュエーション:代理君は「騎士」モチーフなので剣の丘で刀を突き刺しマントをたなびかせてこちらを見ているというシチュです(わかりにくくてすみません)\n表情はどこか優しさのあるような勇ましい(格好良いような)表情でお願いします\n\nhttps://twitter.com/REON_Braver/status/1657707451020627970?t=gmziTgTILu1a6_1WLVZHnw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/19", "thumbnail_src": "https://si.imgix.net/19421e6e/uploads/origins/ae2c45eb-72d8-41ef-8f51-8b13849cfa30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5571a3d47f10a515ad1400951bd5248", "thumbnail_srcset": "https://si.imgix.net/19421e6e/uploads/origins/ae2c45eb-72d8-41ef-8f51-8b13849cfa30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5571a3d47f10a515ad1400951bd5248, https://si.imgix.net/19421e6e/uploads/origins/ae2c45eb-72d8-41ef-8f51-8b13849cfa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdc06eefc937a9d9e80c64acd7cfb5f3 2x, https://si.imgix.net/19421e6e/uploads/origins/ae2c45eb-72d8-41ef-8f51-8b13849cfa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=891d9c1381437f78fa56918dcf027f4d 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n前回は素敵なガリアンビーストありがとうございます。\n\nもしよろしければブレスオブファイア3のガーランド(R-18)の全裸の全身像をお願いできますでしょうか。\n(体格や顔つきやイラストタッチなどは銀ノ助さんが描きやすいテイストにしていただいてOKです)\n\n[キャラクターイメージ]\nhttps://drive.google.com/file/d/1Sle_ol1BEbYcdzlv0oNQa3GuiN3_o3dU/view\nhttps://skeb.jp/@mabo9317/works/35\nhttps://www.dropbox.com/s/9h978oi28q36qj7/1.png?dl=0\nhttps://skeb.jp/@Tos_Tos_F_ski/works/111\n\nシチュエーションとしてはこちらのような色質感で段階的に徐々に石化していき、最終的には完全に石化した姿です。(描いていただくのはガーランドのみでOKです)\nまた、ところどころにヒビも入れていただけますか。\nhttps://twitter.com/silverio01/status/1605026069803073536?s=20&t=ZhhUH8HNrizNmOeUwu83ow\n\nポージングや構図はこちらに似たものでよろしいでしょうか。(背景はなしで白のままでOKです。また、参考画像のような石と足が合体した形でなくてOKです)\nこちらのようにやや手を上げてそれを眺めている姿です。\nhttps://skeb.jp/@Tatta75_/works/9\n\nまた、もし差し支えなければ\n各差分毎に台詞パターンも可能でしょうか。（こちらは難しいようでしたらなしでも構いません）\n台詞内容は銀ノ助さんの好きな台詞や想像でOKです。", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/18", "thumbnail_src": "https://si.imgix.net/67b9c06e/uploads/origins/fcc647ad-ffe4-49ac-9a84-6bc0f4d4449c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f94c017ae2d379db3bf0f153aa565eb0", "thumbnail_srcset": "https://si.imgix.net/67b9c06e/uploads/origins/fcc647ad-ffe4-49ac-9a84-6bc0f4d4449c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f94c017ae2d379db3bf0f153aa565eb0, https://si.imgix.net/67b9c06e/uploads/origins/fcc647ad-ffe4-49ac-9a84-6bc0f4d4449c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab16dc3e38d020ee4a3fa27cd27d3f16 2x, https://si.imgix.net/67b9c06e/uploads/origins/fcc647ad-ffe4-49ac-9a84-6bc0f4d4449c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=246cf45c4c18e0de1975bb1b7f759b55 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@silverio01/works/17", "thumbnail_src": "https://si.imgix.net/d700d039/uploads/origins/0ea74414-d5bb-48b6-9db9-996ec301b723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d57ad019520cb170b70262fd52e503ba", "thumbnail_srcset": "https://si.imgix.net/d700d039/uploads/origins/0ea74414-d5bb-48b6-9db9-996ec301b723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d57ad019520cb170b70262fd52e503ba, https://si.imgix.net/d700d039/uploads/origins/0ea74414-d5bb-48b6-9db9-996ec301b723?bg=%23fff&auto=format%2Ccompres