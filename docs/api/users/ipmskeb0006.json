5fe7/uploads/origins/8f259ef4-3f80-46ed-92c4-1eba606581b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c59446cb42d0ee58a63d1d85064807e", "thumbnail_srcset": "https://si.imgix.net/dbff5fe7/uploads/origins/8f259ef4-3f80-46ed-92c4-1eba606581b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c59446cb42d0ee58a63d1d85064807e, https://si.imgix.net/dbff5fe7/uploads/origins/8f259ef4-3f80-46ed-92c4-1eba606581b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=880cd813f38612e01089677aabdfd768 2x, https://si.imgix.net/dbff5fe7/uploads/origins/8f259ef4-3f80-46ed-92c4-1eba606581b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f436302244b019cfa67b3e1d40292adc 3x", "genre": "art", "nsfw": false, "body": "ibuさま、お久しぶりです〜！\n最近本当に暑い日が続いてますね……！そんな中で、見てるだけで涼しくなれそうなイラストが見たくなって、またご依頼させていただきました。\n\n今回お願いしたいのは、水着姿の山田リョウさまです！\n夏らしさと涼しさが感じられるような雰囲気で、スマホの壁紙として使えたら嬉しいなと思っています。\n\nまたお手数をおかけしてしまいますが、何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@ipmskeb0006/works/12", "thumbnail_src": "https://si.imgix.net/ac58583f/uploads/origins/e826742f-f9cb-404b-b4e2-c109f6d09bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb22007ddca1351b52df14e8f40dab3a", "thumbnail_srcset": "https://si.imgix.net/ac58583f/uploads/origins/e826742f-f9cb-404b-b4e2-c109f6d09bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb22007ddca1351b52df14e8f40dab3a, https://si.imgix.net/ac58583f/uploads/origins/e826742f-f9cb-404b-b4e2-c109f6d09bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcbb233a1b8dd8a7c18669d647e52387 2x, https://si.imgix.net/ac58583f/uploads/origins/e826742f-f9cb-404b-b4e2-c109f6d09bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fdef04addda6cacdc131832247038da 3x", "genre": "art", "nsfw": false, "body": "ドラゴンクエスト10というゲームに登場する\n「リンベリィ」というキャラクターのイラストをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ipmskeb0006/works/11", "thumbnail_src": "https://si.imgix.net/e5576a40/uploads/origins/d96e74c4-1920-4b28-8d35-1283da38020d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f6a53e74e9915fbfcc84fdeb18facfd", "thumbnail_srcset": "https://si.imgix.net/e5576a40/uploads/origins/d96e74c4-1920-4b28-8d35-1283da38020d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f6a53e74e9915fbfcc84fdeb18facfd, https://si.imgix.net/e5576a40/uploads/origins/d96e74c4-1920-4b28-8d35-1283da38020d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9db4b0df5337022e475229ff01e30c83 2x, https://si.imgix.net/e5576a40/uploads/origins/d96e74c4-1920-4b28-8d35-1283da38020d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f49eea8751c4ba7c4df31fb8f3dba07 3x", "genre": "art", "nsfw": false, "body": "ibu様\n\nいつも素晴らしいリョウさんのイラストを描いてくださり、本当にありがとうございます！\n\n3月といえば桜の季節であり、春の訪れを感じる時期ですね。そして同時に、卒業や別れの季節でもあります。\n今回のご依頼ですが、「卒業シーズンの山田リョウ」をテーマに描いていただければと思います。\n\n桜に包まれるような色彩と雰囲気の中で、リョウさんが卒業証書の筒を手に持ち、微笑みを浮かべながらも、どこか寂しさや名残惜しさを感じさせる表情をお願いできればと思います。\n\n拙い説明になってしまい申し訳ありません。私の拙い表現を超えて、ibu様の素敵なアイデアで自由に描いていただければ嬉しいです！\n\n改めて、今回もご検討いただき誠にありがとうございます。どうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@ipmskeb0006/works/10", "thumbnail_src": "https://si.imgix.net/f94ec74e/uploads/origins/e9e0cde7-6f01-4199-a16d-81362f0cc53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901134ece9824470ecdbc24cfe3e446c", "thumbnail_srcset": "https://si.imgix.net/f94ec74e/uploads/origins/e9e0cde7-6f01-4199-a16d-81362f0cc53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901134ece9824470ecdbc24cfe3e446c, https://si.imgix.net/f94ec74e/uploads/origins/e9e0cde7-6f01-4199-a16d-81362f0cc53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f2e71f5d8afb273f1752a9056674bff 2x, https://si.imgix.net/f94ec74e/uploads/origins/e9e0cde7-6f01-4199-a16d-81362f0cc53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5560a2aaceec3dfcba888d5290041073 3x", "genre": "art", "nsfw": false, "body": "ibu様\n\nいつもお世話になっております。\nこの度、新たにイラストのご依頼をさせていただきたいと思います。\n\nテーマは「通勤ラッシュの山田リョウ」です。\nリョウさんが口に草をくわえ、少し寝不足気味でどこか気だるい雰囲気を出しつつも、同時に少しカッコよさも感じられるような表情やポーズをお願いできればと思います。\n\n衣装については、スポーティーな普段着のイメージでお願いいたします。\nその他の部分については、ibu様の素敵な発想にお任せいたします！\n\nご検討いただけますと幸いです。どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ipmskeb0006/works/9", "thumbnail_src": "https://si.imgix.net/3b85e5e7/uploads/origins/742621f0-e69e-410f-94d8-e9f499628a11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e293d625946631e81fdee64d3b95f8e", "thumbnail_srcset": "https://si.imgix.net/3b85e5e7/uploads/origins/742621f0-e69e-410f-94d8-e9f499628a11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e293d625946631e81fdee64d3b95f8e, https://si.imgix.net/3b85e5e7/uploads/origins/742621f0-e69e-410f-94d8-e9f499628a11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89ce87d815aafee0120d04f0029a447e 2x, https://si.imgix.net/3b85e5e7/uploads/origins/742621f0-e69e-410f-94d8-e9f499628a11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3062401a287523e4d4c35df92917bd7 3x", "genre": "art", "nsfw": false, "body": "ibu様\n\nいつも素晴らしい作品をありがとうございます。これまでの合作に大変満足しており、心より感謝申し上げます。\n\nクリスマスも近づいてまいりましたので、この度新たに縦長構図のスマホ壁紙をお願いしたいと考えております。テーマは「クリスマスの雰囲気の中で山田リョウと伊地知虹夏が仲良くしている場面」です。リョウさんの優しさと虹夏ちゃんの可愛らしさが感じられるようなイラストをお願いできれば嬉しいです。具体的な内容については、ibu様の自由な発想にお任せします。\n\nお忙しい中とは存じますが、ご検討いただけますと幸いです。どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ipmskeb0006/works/8", "thumbnail_src": "https://si.imgix.net/3de6f667/uploads/origins/01cf8b96-3fb8-4a44-9a52-b766a70aeebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd7fbb57f11a12cea8e543fa23ff581", "thumbnai