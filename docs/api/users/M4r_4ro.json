33f-4861-8f0e-09e0aba35229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbee6bfb88f4cb50324da12e745202a0", "thumbnail_srcset": "https://si.imgix.net/d59dd879/uploads/origins/f13ecb3a-533f-4861-8f0e-09e0aba35229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbee6bfb88f4cb50324da12e745202a0, https://si.imgix.net/d59dd879/uploads/origins/f13ecb3a-533f-4861-8f0e-09e0aba35229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdcb5407d69afadcd5e0a529f514ece2 2x, https://si.imgix.net/d59dd879/uploads/origins/f13ecb3a-533f-4861-8f0e-09e0aba35229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f24625a750891f89c9abe6a2b8daad5 3x", "genre": "art", "nsfw": false, "body": "マシロシロ様\nはじめまして。\n新規VTuberプロジェクト「Secret Puffy」運営です。\n\n当事務所所属タレント眠音だららが、マシロシロ様に是非のイラストを描いて頂きたいと希望したため、リクエストさせていただきました。\n\n●希望構図\n衣装や構図などお任せいたします。\n\n●使用用途\nX/YouTube/TikTok/ライドリ 等 各SNSサイトでの使用\n\n●参考資料\nhttps://drive.google.com/drive/folders/1YGAmzC_490x3WF6CyNiCnaC5CSIG9eXX?usp=sharing\n\n●その他\nもし可能であれば、サムネイル使用を検討しているため、上半身部分が見切れていないデータ、人物のみ透過されているデータを頂けますと幸いです。\n\n以上となります。\nご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1YGAmzC_490x3WF6CyNiCnaC5CSIG9eXX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@M4r_4ro/works/42", "thumbnail_src": "https://si.imgix.net/f0929678/uploads/origins/fcda5428-9f48-40ab-b3f4-62c0c747bb66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bda72e578030b7e0f51f8df7fe57a431", "thumbnail_srcset": "https://si.imgix.net/f0929678/uploads/origins/fcda5428-9f48-40ab-b3f4-62c0c747bb66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bda72e578030b7e0f51f8df7fe57a431, https://si.imgix.net/f0929678/uploads/origins/fcda5428-9f48-40ab-b3f4-62c0c747bb66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0c32a2f14c8d0d098c546e4411b652b 2x, https://si.imgix.net/f0929678/uploads/origins/fcda5428-9f48-40ab-b3f4-62c0c747bb66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8af29a69261a444fe771f3073008222f 3x", "genre": "art", "nsfw": false, "body": "個人Vsinger活動をしているinashinoと申します。\nとても素敵なイラスト、拝見しました。\nマシロシロ様に私のイラストを描いていただきたく、リクエストを送らせていただきました。\n\n見た目の参考資料は添付URLをご確認ください。\n\n【利用用途について】\n・SNSでのプロモーション、アイコン等\n・収益化されているyoutubeのサムネイルや動画内等\n・お礼カードなどにイラストを使用\n・グッズなどの商用利用\n\n※不可な場合は使用いたしません。\n\npngデータでお願いいたします。\n\n【イラストについて】\n・サムネイル等にも使用の可能性もあるため人物の上部と左右が見切れないもの、また可能であれば背景と人物を分けたデータにしていただけると幸いです。\n・かわいくセクシーな感じで、ポーズはお任せいたします。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1s1XhZHp3AWdOo198C01i8MtlMsbkqvLs?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@M4r_4ro/works/41", "thumbnail_src": "https://si.imgix.net/2bee25b5/uploads/origins/fc779ec2-20c8-4145-b7a2-f82eb6ef0c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2158a41e3262a670de60784b2846fa", "thumbnail_srcset": "https://si.imgix.net/2bee25b5/uploads/origins/fc779ec2-20c8-4145-b7a2-f82eb6ef0c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2158a41e3262a670de60784b2846fa, https://si.imgix.net/2bee25b5/uploads/origins/fc779ec2-20c8-4145-b7a2-f82eb6ef0c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=748b7879d5a0a5b7b061f806495d1fec 2x, https://si.imgix.net/2bee25b5/uploads/origins/fc779ec2-20c8-4145-b7a2-f82eb6ef0c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7fff50c68caaf04581fba1ced703e8b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵のスタイルがとても好きです！私のキャラクター、モックの水着姿を描いてくれませんか？\n\n彼女のデザインの核となる特徴と特徴は以下の通りです；\n- 彼女は磁器人形を宿主とする生き物で、そのデザインにはウサギの特徴があります。\n- 細身で小柄。\n- 表情は無表情で、目は鋭いまなざしをしている。\n- 物事に興味津々だが、その探求の仕方は病的である。\n\nモックの構図やポーズはあなたの創造力にお任せします！\n\nキャラクターと背景は別レイヤー（PSD形式）にしていただけると助かります。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ADVUguWS4R9rszASmlwAmXgAk4Y25bw2?usp=sharing", "created_at": "", "c