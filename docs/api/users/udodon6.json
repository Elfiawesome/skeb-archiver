f62-415b-901b-425d07def3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a151b5c76b4457d188d6207cbcb2e3, https://si.imgix.net/d7dfba2f/uploads/origins/7d94607c-8f62-415b-901b-425d07def3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57db662954171274710a5a781d3ff9f7 2x, https://si.imgix.net/d7dfba2f/uploads/origins/7d94607c-8f62-415b-901b-425d07def3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01504be8b517276ca3503e436d6a303f 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ゲーム「ダンジョンズ&ドラゴンズ」の女性キャラクターを作成してほしいです。彼女はガンスリンガークラスで、カウボーイとパンクの融合をテーマにしたガンスリンガーです。https://www.pinterest.com/pin/4151824652366179/https://www.pinterest.com/pin/429953714\nhttps://www.pinterest.com/pin/325736985570502332/https://www.pinterest.com/pin/42995371468737864/https://www.pinterest.com/pin/563018699363448/\n\n\n彼女の武器選択は、2丁のデュアルショットガンピストルとライフルとなる。全ての武器にはカトルパンク風のデザインが施される。https://www.pinterest.com/pin/46373071158847804/ https://www.pinterest.com/pin/590816044908214962/\nhttps://www.pinterest.com/pin/227150374950175706/ https://www.pinterest.com/pin/14636767536311243/ 髪型は長い三つ編みです。\nhttps://www.pinterest.com/pin/511510470199952390/彼女は黒人女性なので、肌の色は濃いでしょう。https://www.pinterest.com/pin/27514247718913781/\nhttps://x.com/p12mies/status/1978101023219634438 https://www.pixiv.net/en/artworks/139977526 https://x.com/camtheartguy/status/2013994620250620209\n\n彼女の服装、髪の色、目の色、そして全体のデザインは、お好きなように設定してください。", "created_at": "", "completed_at": ""}, {"path": "/@udodon6/works/35", "thumbnail_src": "https://si.imgix.net/9fdc50bd/uploads/origins/51f9b1c7-f71f-470c-a620-aff3272a7376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e2b1b858830664a6c8f34666ab9987", "thumbnail_srcset": "https://si.imgix.net/9fdc50bd/uploads/origins/51f9b1c7-f71f-470c-a620-aff3272a7376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e2b1b858830664a6c8f34666ab9987, https://si.imgix.net/9fdc50bd/uploads/origins/51f9b1c7-f71f-470c-a620-aff3272a7376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3f92d5dcd379e7b6d503b8114cdf3e4 2x, https://si.imgix.net/9fdc50bd/uploads/origins/51f9b1c7-f71f-470c-a620-aff3272a7376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98e172930bb4dbd21187f426c8b65415 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ゲーム「ダンジョンズ&ドラゴンズ」の女性キャラクターを作成してほしいです。彼女はバーバリアンクラスで、デコラ風のバーバリアンになります。https://www.pinterest.com/pin/7670261862341903/https://www.pinterest.com/pin/567172765\nhttps://www.pinterest.com/pin/128774870592620558/https://www.pinterest.com/pin/56717276551763557/https://www.pinterest.com/pin/22518066880965560/\n\n彼女の武器は大型のウォーハンマーを選択します。そのウォーハンマーにはデコラ調のデザインが施されています。衣装、髪色、全体のデザインは自由にお決めください。目は閉じている状態です。宇崎ツキに非常に似ています。https://x.com/syokumutaiman/status/1083657364312547328\n\nまた、彼女の目を開いた状態の参考画像も作成してほしい。目を開くと、まるで糖分の過剰摂取によるハイ状態/シュガーラッシュのような見た目になる。目のデザインについては完全な創作の自由を認める。\nhttps://www.pinterest.com/pin/3166662233281516/https://www.pinterest.com/pin/259308891044265965/https://www.pinterest.com/pin/7810999349362916/", "created_at": "", "completed_at": ""}, {"path": "/@udodon6/works/34", "thumbnail_src": "https://si.imgix.net/51c12ad8/uploads/origins/97f09456-ead2-4417-8644-e5b8bb2ce770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1841f36a19977435b81e276524155902", "thumbnail_srcset": "https://si.imgix.net/51c12ad8/uploads/origins/97f09456-ead2-4417-8644-e5b8bb2ce770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1841f36a19977435b81e276524155902, https://si.imgix.net/51c12ad8/uploads/origins/97f09456-ead2-4417-8644-e5b8bb2ce770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91bb223c76c436645673416d87ac6b82 2x, https://si.imgix.net/51c12ad8/uploads/origins/97f09456-ead2-4417-8644-e5b8bb2ce770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28761ce5fd2b003ed4b37ddb35450abf 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ゲーム「ダンジョンズ＆ドラゴンズ」の女性キャラクターを作成してほしいです。彼女はローグクラスで、ゴシックロリータをテーマにしたローグです。https://www.pinterest.com/pin/1337074889769329/https://shigure-s.fanbox.cc/posts/10867\nhttps://x.com/horistarw/status/1175237484923387904https://shigure-s.fanbox.cc/posts/10867329https://x.com/donabe915/status/1955256175189975397\n\n彼女の武器は連射式クロスボウ、ロングダガー、そして多数の投擲ナイフとなる。全ての武器はゴシック・ヴィクトリア風のデザインを施す。衣装、髪色、瞳の色、全体のデザインは自由に設定可能。", "created_at": "", "completed_at": ""}, {"path": "/@udodon6/works/33", "thumbnail_src": "https://si.imgix.net/241b9dc3/uploads/origins/4712799f-c1db-467f-8f24-67e6161e3579?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=445b74f55294a95d84faa62ceda204f3", "thumbnail_srcset": "https://si.imgix.net/241b9dc3/uploads/origins/4712799f-c1db-467f-8f24-67e6161e3579?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=445b74f55294a95d84faa62ceda204f3, https://si.imgix.net/241b9dc3/uploads/origins/4712799f-c1db-467f-8f24-67e6161e3579?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=216431dc9f1a54379361d7f8f86828a9 2x, https://si.imgix.net/241b9dc3/uploads/origins/4712799f-c1db-467f-8f24-67e6161e3579?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b564744274ff0081719aae4d1bbf5e53 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ゲーム「ダンジョンズ&ドラゴンズ」の女性キャラクターを作成してほしいです。彼女はレンジャークラスで、森をテーマにした戦士です。https://www.pinterest.com/pin/14144186326225898/\nhttps://www.pinterest.com/pin/9710955443179536/武器はロングボウと矢、そして森/コテージコア風のデザインの投げ斧を選択します。衣装、髪色、瞳の色、全体のデザインはご自由に決めてください。", "created_at": "", "completed_at": ""}, {"path": "/@udodon6/works/32", "thumbnail_src": "https://si.imgix.net/d8972032/uploads/origins/3bd77513-1e2a-4d1d-8f08-8d99678f731c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07d8cf5f35e38bf407420400aad9e42c", "thumbnail_srcset": "https://si.imgix.net/d8972032/uploads/origins/3bd77513-1e2a-4d1d-8f08-8d99678f731c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07d8cf5f35e38bf407420400aad9e42c, https://si.imgix.net/d8972032/uploads/origins/3bd77513-1e2a-4d1d-8f08-8d99678f731c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32bf4e044c659f87a2c76135f3c1d3e2 2x, https://si.imgix.net/d8972032/uploads/origins/3bd77513-1e2a-4d1d-8f08-8d99678f731c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c446d880f2a10c146354c79f237115a5 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ゲーム「ダンジョンズ＆ドラゴンズ」の女性キャラクターを作成してほしいです。戦士クラスで、侍をテーマにした戦士です。着物は軽装の侍鎧を身に着けています。https://www.pixiv.net/en/artworks/138500806https://www.deviantart.com/angryangryasian/art/Momohime-1563\nhttps://www.pixiv.net/en/artworks/136997485https://www.deviantart.com/angryangryasian/art/Momohime-156350318https://x.com/mikamseizin/status/1876471000428376402\n\n戦士は様々な武器の扱いに非常に長けていることで知られています。お好きな複数の武器を彼女が装備したり携行したりする描写を自由に追加してください。彼女は魔法のリュックサックや魔法のポーチ（大量の物を収納できることで知られる）に武器を収納できます。https://www.pinterest.com/pin/5066618329195546/\nhttps://www.pinterest.com/pin/7881368077538069/ https://www.pinterest.com/pin/7881368070034495/ 衣装、髪色、瞳の色、全体のデザインは自由に設定してください。", "created_at": "", "completed_at": ""}, {"path": "/@udodon6/works/31", "thumbnail_src": "https://si.imgix.net/0a9d7143/uploads/origins/6364ddeb-7ec3-44a4-8c12-17c0737e5caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4080b058f56818b2ee5d351f1907dcd1", "thumbnail_srcset": "https://si.imgix.net/0a9d7143/uploads/origins/6364ddeb-7ec3-44a4-8c12-17c0737e5caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4080b058f56818b2ee5d351f1907dcd1, https://si.imgix.net/0a9d7143/uploads/origins/6364ddeb-7ec3-44a4-8c12-17c0737e5caf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=105d9390c6f6b60d5cdc45ef59a7dd43 2x, https://si.imgix.net/0a9d7143/uploads/origins/6364ddeb-7ec3-44a4-8c12-17c0737e5caf?bg=%23fff&auto=format%2