38"}], "flags": {"from_archive": true}, "works": [{"path": "/@miz_esc/works/73", "thumbnail_src": "https://si.imgix.net/dc819918/uploads/origins/e2e1219f-00fa-4e5d-9907-05a748c4b496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ab27238f80829d5911723718a106830", "thumbnail_srcset": "https://si.imgix.net/dc819918/uploads/origins/e2e1219f-00fa-4e5d-9907-05a748c4b496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ab27238f80829d5911723718a106830, https://si.imgix.net/dc819918/uploads/origins/e2e1219f-00fa-4e5d-9907-05a748c4b496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81a062db8d9d88e92f3a7b89fe09753c 2x, https://si.imgix.net/dc819918/uploads/origins/e2e1219f-00fa-4e5d-9907-05a748c4b496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c19601658a473ccc1c13204b3607082 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵がとても好きです！色彩がとても美しいです！ペアのキャラクターの絵をお願いしたいです！\n\nイーデン (179cm)\n明るく派手な性格。努力家だがいじられやすく、周囲に気を遣う。少し乱暴で激しいところがある。\n\nテーマ恋愛、花・自然、うさぎ\n\n🍀ディンゴ（183cm）\n元気一杯の暴れん坊！野良犬のように旅をして、たくさんの世界を見てきた。やりたい放題だが、忠実で、大切な人を愛している。自由人だ。\n\nテーマ幸運、四つ葉のクローバー、犬\n\n-\n\nロマンチックなカップルで、とても愛し合っています。愛情深くおバカで、お互いの存在に惹かれ合う。取っ組み合いやからかいが大好きだが、お互いに弱音を吐くこともある。お互いの髪にクローバーを編み込むことも多く、一緒に人生の冒険に出かけたいと思っている。\n\nどんな理由であれ、お断りすることは全く問題ありません！ご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1BzHCxgl0qpkc6sV4UrXwGo0WOiZfd62q?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@miz_esc/works/72", "thumbnail_src": "https://si.imgix.net/910eb129/uploads/origins/00640564-ad0f-435a-b343-d291aca0db85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76b548bd580c8870679c7406f3b87c49", "thumbnail_srcset": "https://si.imgix.net/910eb129/uploads/origins/00640564-ad0f-435a-b343-d291aca0db85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&