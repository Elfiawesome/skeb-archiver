3fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eb9232d2ac8a23b20eba91773203699 2x, https://si.imgix.net/19ebe29f/uploads/origins/f092438b-ac06-4b74-87b4-45406834ef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d752d248fd234d7fd3aa8135c7ccb8a2 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\n推しの個人Vtuberのイラストをお願いします。\n\n【使用用途】\nご本人様にプレゼント予定です。\nご本人様に限りが使用する許可をいただけると幸いです\n（YouTubeのサムネイルやED、動画内待ち受け、ツイッター、等）\n\nSNSアイコンやヘッダー・アクキーやアクリルスタンド、マグカップ等のグッズに商用使用\n\n高確率でサムネに使用される為、使いやすいようにキャラクターのみをレイヤーを分けて頂けると嬉しいです。\n\n\n【希望イラスト】\n特に指定はありません、おまかせでお願いします。\n唯一の指定は可愛いイラストです。\n\nサムネに使いやすいように髪の毛等、途切れてないと嬉しいですが、その限りではありません\n\n服装はオリジナルの服装でも良いので、可愛く描いてください。\nその他ポーズや構図、背景などもお任せ致します。\n\n何卒、ご検討のほどよろしくお願いいたします。\n\nデザイン内容は資料URLでご確認お願い致します。\nhttps://drive.google.com/drive/folders/1BvA_2ziy6C5WibLzdZLOctzFyI8Dleev\n\n別URLになりますが下記に三面図等のデータもありますのでご参照ください\n\nhttps://drive.google.com/drive/folders/1fIc6GFU0E56umhC4TeRCaSzj7d2CtQwr\n\nhttps://drive.google.com/drive/folders/1fIc6GFU0E56umhC4TeRCaSzj7d2CtQwr", "created_at": "", "completed_at": ""}, {"path": "/@Co8Li/works/4", "thumbnail_src": "https://si.imgix.net/a6e4e674/uploads/origins/80dfacc6-8f0d-4d0d-bf93-13ae5e3592e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e9fd450883a1566db09b34202c30bf", "thumbnail_srcset": "https://si.imgix.net/a6e4e674/uploads/origins/80dfacc6-8f0d-4d0d-bf93-13ae5e3592e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e9fd450883a1566db09b34202c30bf, https://si.imgix.net/a6e4e674/uploads/origins/80dfacc6-8f0d-4d0d-bf93-13ae5e3592e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43e930b699f5ce78543b49d03a7ebb16 2x, https://si.imgix.net/a6e4e674/uploads/origins/80dfacc6-8f0d-4d0d-bf93-13ae5e3592e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bda4bd536e6ca7a577391e514f21084 3x", "genre": "art", "nsfw": false, "body": "こんにちは、初めま