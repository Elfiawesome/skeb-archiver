ックにきつく絡みつき、口でゴルダックの頭にかぶりついている。\n表情は無表情。\n\nゴルダック の状態:\n汗だく。\n体型はガチムチ（ややポッチャリ）体型。\nバトル中であるため体がところどころ土色に汚れている。\n頭はマスキッパの口の中にすっぽりおさまっている。\n口から脱出しようと手足・しっぽをバタバタさせている。\n仮性包茎ちんぽ。ちんぽから水色の水鉄砲を発射している。バタバタしているため水鉄砲が方々に飛び散っている。\n金玉は巨大（膝に届くぐらいの大きさ）でブルンブルンと揺れている。\n\n以上になります。\nお願いできれば嬉しいです。\n\n参考URL\nhttps://youtu.be/-WM7zfiQqFY?si=9vhPsmdbH9ejvF1G", "created_at": "", "completed_at": ""}, {"path": "/@magyo6/works/67", "thumbnail_src": "https://si.imgix.net/0be397f4/uploads/origins/9870d7f0-b5c9-47d1-bb7f-be13a1eb6595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf37079d172a52551be1f50ff9c97818", "thumbnail_srcset": "https://si.imgix.net/0be397f4/uploads/origins/9870d7f0-b5c9-47d1-bb7f-be13a1eb6595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf37079d172a52551be1f50ff9c97818, https://si.imgix.net/0be397f4/uploads/origins/9870d7f0-b5c9-47d1-bb7f-be13a1eb6595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0490d1c194e261cdcd3e72482658090c 2x, https://si.imgix.net/0be397f4/uploads/origins/9870d7f0-b5c9-47d1-bb7f-be13a1eb6595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba07575c64d77ba6eebfb35ef0c96375 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@magyo6/works/66", "thumbnail_src": "https://si.imgix.net/a0df2dd0/uploads/origins/f7a048e7-6dd1-4152-b8a8-309071dd9ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e8217a8d80afffcb38e37f73ff8881b", "thumbnail_srcset": "https://si.imgix.net/a0df2dd0/uploads/origins/f7a048e7-6dd1