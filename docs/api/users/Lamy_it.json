3-8110-ea305dc2c5a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6d9d4a780dcb4e6f75f7116f64f9c25 2x, https://si.imgix.net/c784735c/uploads/origins/971db3ac-f721-4043-8110-ea305dc2c5a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e37a99f7294413020ea84a05043b15de 3x", "genre": "art", "nsfw": false, "body": "手数料無料期間に託つけて依頼を出させていただきました\n依頼内容、色々と悩んだのですが、以下の感じでお願いできればと⋯\n\n◯キャラクター\nアザミ(花騎士)\n\n◯シチュエーション\n団長とパパ(ハリネズミのぬいぐるみ)と3人でお花見の光景をお願いします\n最近は落ち着いてきたみたいですが、幼い頃の習慣で食べれる時に食い貯める癖があるのでお弁当を口いっぱいに頬張ってるところを描いていただければなと\n(⁠*⁠´⁠ω⁠｀⁠*⁠)\n\n◯衣装\n通常衣装進化前でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/80", "thumbnail_src": "https://si.imgix.net/91f9ccff/uploads/origins/9ae5763b-5998-44f0-9450-d42eb475d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2e830a3a011c2b3e648625f2aec4635", "thumbnail_srcset": "https://si.imgix.net/91f9ccff/uploads/origins/9ae5763b-5998-44f0-9450-d42eb475d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2e830a3a011c2b3e648625f2aec4635, https://si.imgix.net/91f9ccff/uploads/origins/9ae5763b-5998-44f0-9450-d42eb475d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56eb824332f6d79bea7279f8c3579aa7 2x, https://si.imgix.net/91f9ccff/uploads/origins/9ae5763b-5998-44f0-9450-d42eb475d98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d320b19b81b0f5ffa20a5918b351b78 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、牛王子でち＠86kです。\n今回もリクエストを御一考いただけますと幸いです。\n\n【作品】フラワーナイトガール\n【人物】ハツユキソウ（花騎士）\n【衣装】精華の王女衣装（進化前）\nhttps://i.imgur.com/xTQtxAu.png\n【参考】\nキャラクターの体型はこちらの方がわかりやすいと存じます\nhttps://i.imgur.com/ketEKFQ.png\n腰まである白髪ストレートロングでやや小ぶりのおっぱいに大きめのお尻の子です\n【性格参考】\nhttps://imgur.com/VIYGRN9\n【内容】\n先生の絵柄で上記衣装のハツユキソウを描いてください、お願いいたします。\nキュートでお姫様的な感じですと嬉しいです。\n可能でございましたら笑顔とドヤ顔の表情差分をいただけますと嬉しいです。（可能でしたらで結構です）\nその他詳細は先生にお任せいたします。\n\n以上が私の要望ですが、わかりにくい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\n\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6%28%E7%B2%BE%E8%8F%AF%E3%81%AE%E7%8E%8B%E5%A5%B3%29", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/79", "thumbnail_src": "https://si.imgix.net/466c1a75/uploads/origins/162caeb9-23e0-48da-8833-14552f32930f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23df8d618df4fa56f4ab89a518527ee", "thumbnail_srcset": "https://si.imgix.net/466c1a75/uploads/origins/162caeb9-23e0-48da-8833-14552f32930f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23df8d618df4fa56f4ab89a518527ee, https://si.imgix.net/466c1a75/uploads/origins/162caeb9-23e0-48da-8833-14552f32930f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bceaaaa95d7adceebfae08a0a31cfbb 2x, https://si.imgix.net/466c1a75/uploads/origins/162caeb9-23e0-48da-8833-14552f32930f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e13e78529b62701a40d4636c5b226469 3x", "genre": "art", "nsfw": false, "body": "こんにちは～\n\n2人の魔法少女のイラストをお願いしたいです。2人は親友です。\n\n(1) ユエ\nユエはメンヘラ中二病の魔法猫少女です。可愛くエレガントに見えますが、実は妄想癖があります。\n身長は140cmで、ロリまたは小柄な体型です。シンボルは三日月・包帯・リボン・鈴・宝石です。普段はロリータドレスを着ています。\nカラースキームは赤・黒・白を基調とし、ゴールドのアクセントがあります。\n今回は 「魔法少女まどか☆マギカ」の暁美ほむらの衣装 を着せてください。\nまた、左手首に包帯を必ず描き、さらに ほむらのピストルも持たせてください。\n\n(2) ミミ\nミミはパステルピンクを基調とした、癒しの魔法を使う魔法少女です。\n今回は 「東京ミュウミュウ」の桃宮いちごの衣装 を着せてください。\n\n2人とも、可愛いポーズで、背景・シチュエーションはおまかせで描いていただけると嬉しいです。\nまた、PC用壁紙として使用したいので、背景は描き込みのあるものをお願いしたいです。\n\nイラストはSNSや配信のグラフィックとして使用したいです。\n解像度は 16:9、最低1920×1080px を希望します。\n透明背景バージョンもご提供いただけると助かります。\n\nありがとうございます！\n\nhttps://drive.google.com/file/d/1pIOByevKH48yVBSfK8Hjw_IC3WUDaiWV/view?usp=sharing\n\nhttps://drive.google.com/file/d/1pIOByevKH48yVBSfK8Hjw_IC3WUDaiWV/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/78", "thumbnail_src": "https://si.imgix.net/b29e5fde/uploads/origins/3c6b7a00-9a2e-4979-82fb-239724f5b393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88a64e8a80ad0136d459b8d9e34db3a", "thumbnail_srcset": "https://si.imgix.net/b29e5fde/uploads/origins/3c6b7a00-9a2e-4979-82fb-239724f5b393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88a64e8a80ad0136d459b8d9e34db3a, https://si.imgix.net/b29e5fde/uploads/origins/3c6b7a00-9a2e-4979-82fb-239724f5b393?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6092ce8467efc584efd5df2ac2793d24 2x, https://si.imgix.net/b29e5fde/uploads/origins/3c6b7a00-9a2e-4979-82fb-239724f5b393?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97783ac3e83628723f08406eb7248332 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。\nプルモンはいいぞ……ということで、フラワーナイトガールより、プルモナリアをお願いします。\n\n「スイーツバイキングを堪能するプルモンとオトモのオバケたち」というお題でひとつお願いします。\n\nたとえばお皿一杯に一口スイーツをぎっしり盛っていたり、\nなんなら熟練ウェイトレスよろしくしれっとお皿2枚持ちでそれだったり、\nスイーツをオトモのオバケたちにも分け与えていたり、\n分けてもらって嬉しそうに飛び回るオバケがいたり、\nあるいは逆にどこからかスイーツを確保してくるオバケがいたり、\n……などなど、いろんな要素が思い浮かぶと思いますので、\n適宜取捨選択しつつ、スイーツを中心に幸せそうな様子を描いていただければと思います。\n\nその他、衣装や季節、スイーツの種類や、例示した要素をどこまで拾うか等、仔細についてはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/77", "thumbnail_src": "https://si.imgix.net/5705f1ee/uploads/origins/22ec606b-f991-429f-a1b3-89f62ab36a67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca1b0086ba7ef76d1d018f5b6586427e", "thumbnail_srcset": "https://si.imgix.net/5705f1ee/uploads/origins/22ec606b-f991-429f-a1b3-89f62ab36a67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca1b0086ba7ef76d1d018f5b6586427e, https://si.imgix.net/5705f1ee/uploads/origins/22ec606b-f991-429f-a1b3-89f62ab36a67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba84e459757f0e93920e3048bd564c1c 2x, https://si.imgix.net/5705f1ee/uploads/origins/22ec606b-f991-429f-a1b3-89f62ab36a67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b2786ace28c3f6ee4cbce7b830f5d3d 3x", "genre": "art", "nsfw": false, "body": "どうもー匿名者ですが初リクを申し込みます。\n\nフラワーナイトガールからウサギゴケとイソギクで〜2人が手を繋いで仲良く散歩している微笑ましいイラストを依頼します。(SD絵でも構いません)\n\n補足として〜両名の仲は姉妹もしくは母娘のような親しい感じで(公式での絡みは不明ですが〜イソギクはウーちゃん(ウサギゴケ)を妹の様に接して、ウーちゃんはイソギクを母親の様に懐いている感じで)", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/76", "thumbnail_src": "https://si.imgix.net/42a309b5/uploads/origins/00922560-79ca-4154-a3c4-c49255275ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=763e6f27e99cc4665b7ddddd6418cc6a", "thumbnail_srcset": "https://si.imgix.net/42a309b5/uploads/origins/00922560-79ca-4154-a3c4-c49255275ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=763e6f27e99cc4665b7ddddd6418cc6a, https://si.imgix.net/42a309b5/uploads/origins/00922560-79ca-4154-a3c4-c49255275ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a92f0f72662c1ab469e5b065ed1da053 2x, https://si.imgix.net/42a309b5/uploads/origins/00922560-79ca-4154-a3c4-c49255275ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d988f08991d7d93c037a3034ce44d90 3x", "genre": "art", "nsfw": false, "body": "こちらでは初めまして\n今回はイラストの依頼をしたくリクエストさせていただきました。\n【作品名】フラワーナイトガール\n【キャラクター】オシロイバナ\n【衣装】アレンジバニー※進化後の浴衣をベースにアレンジしていただきたいです。\n【シチュエーション】夜の街に手持ち看板を掲げながら夜風に震える姿でお願いします。\n看板の内容や背景はお任せしますが、無しでも構いません。\n\nそれではよろしくお願いします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%AA%E3%82%B7%E3%83%AD%E3%82%A4%E3%83%90%E3%83%8A", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/75", "thumbnail_src": "https://si.imgix.net/bb14bf83/uploads/origins/1d369e53-4bb7-4cf1-897a-40e176d6dae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ba7028133b4e50a50850bd10492c666", "thumbnail_srcset": "https://si.imgix.net/bb14bf83/uploads/origins/1d369e53-4bb7-4cf1-897a-40e176d6dae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ba7028133b4e50a50850bd10492c666, https://si.imgix.net/bb14bf83/uploads/origins/1d369e53-4bb7-4cf1-897a-40e176d6dae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bc5e3c50195affbf40b9bf999dba765 2x, https://si.imgix.net/bb14bf83/uploads/origins/1d369e53-4bb7-4cf1-897a-40e176d6dae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e800f42d79e22547e0635c1cc8ee848 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートが大好きです！このアートであなたが描いたMiqo'teが大好きです。https://skeb.jp/@Lamy_it/works/73\n\n私のMiqo'te（FFXIVのキャラクター）にも同じようなものが欲しいです。写真には4種類の衣装があります。ポーズもサプライズでお願いします。\n\n私のMiqo'teは猫カフェを経営しています。太った猫のミニオンが大好き。好きな色はパステルピンク、イエロー、ブルー、グリーン。気立てがよくて明るい性格です。ありがとう！\n\nhttps://drive.google.com/drive/folders/1CO6KQ4eGRh2YKKkFKaCcYldIdMoIvLSt?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Lamy_it/works/74", "thumbnail_src": "https://si.imgix.net/8e4aaa18/uploads/origins/9e4459dc-5f9f-4a86-99b3-332d1db3d8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc135b1d7048953f6fd46ea89d59675", "thumbnail_srcset": "https://si.imgix.net/8e4aaa18/uploads/origins/9e4459dc-5f9f-4a86-99b3-332d1db3d8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc135b1d7048953f6fd46ea89d59675, https://si.imgix.net/8e4aaa18/uploads/origins/9e4459dc-5f9f-4a86-99b3-332d1db3d8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00abd59f4eb5ad152dcebb98e7023461 2x, https://si.imgix.net/8e4aaa18/uploads/origins/9e4459dc-5f9f-4a86-99b3-332d1db3d8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d7a24591e2736564236e80ff9b54edc 3x", "genre": "art", "nsfw": false, "body": "らみ様はじめまして。くまくまかーにばるでお見受けし、絵柄に惹かれましたのでリクエストをお送りいたします。\n【作品名】フラワーナイトガール\n【キャラクター】ヒガンバナ\n【シチュエーション】ディアンドル姿でこちらと乾杯をしているシチュエーションでお願いします。ディアンドル姿の服装はFF14のディアンドル・コスチュームセット【https://store.finalfantasyxiv.com/ffxivstore/ja-jp/product/661】で衣装の緑