"2025-10-06T11:56:56.671216"}, {"amount": 2000, "recorded_at": "2025-10-10T18:58:27.770505"}, {"amount": 500, "recorded_at": "2026-02-20T11:14:12.509420+00:00"}, {"amount": 2000, "recorded_at": "2026-02-22T15:53:43.717326+00:00"}]}, "current_prices": {"art": 15000, "correction": 2000}, "price_range": {"art": {"min": 7000, "max": 18000}, "correction": {"min": 500, "max": 2000}}, "links": [{"label": "Twitter", "url": "https://x.com/Mink_rii", "name": "Mink_rii"}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/649823", "name": "649823"}], "flags": {"from_archive": true}, "works": [{"path": "/@Mink_rii/works/54", "thumbnail_src": "https://si.imgix.net/63810398/uploads/origins/6d83a32a-c604-431e-9d5c-d2ea67f57df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b11962ddfe3513141fa9a28d35b7f09", "thumbnail_srcset": "https://si.imgix.net/63810398/uploads/origins/6d83a32a-c604-431e-9d5c-d2ea67f57df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b11962ddfe3513141fa9a28d35b7f09, https://si.imgix.net/63810398/uploads/origins/6d83a32a-c604-431e-9d5c-d2ea67f57df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d98c2c70c057fd44288eb8a52b8b02ad 2x, https://si.imgix.net/63810398/uploads/origins/6d83a32a-c604-431e-9d5c-d2ea67f57df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7292cdcf092fb42a06fd032e73986b2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n連続のご依頼で恐縮ですがよろしければお願いしますmm\n\n今回は、カフェの屋根の雨樋（屋根の水を受けるレール部分　軒樋）が少し壊れたので\nとりあえずどんな仕事でもやらされるミズダコちゃんが修理するシーンをお願いしたいです\n工具や部品（トンカチ、ドライバー、取り替えパーツ等？こだわりはないです）を持って、ハシゴをかけて登っているところ、\n海沿いのカフェの屋根はカモメの縄張りなので、触手の先をついばまれたりされ、なんとか振り払っているようなイメージです！\n\nご検討よろしくお願いしますmm", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/53", "thumbnail_src": "https://si.imgix.net/e38c9c7b/uploads/origins/5470a4d3-7af9-4aec-99ac-f5a4c1899c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a5a0d2058040a23a92183308273d75", "thumbnail_srcset": "https://si.imgix.net/e38c9c7b/uploads/origins/5470a4d3-7af9-4aec-99ac-f5a4c1899c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a5a0d2058040a23a92183308273d75, https://si.imgix.net/e38c9c7b/uploads/origins/5470a4d3-7af9-4aec-99ac-f5a4c1899c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4376b71d84eb88cb15a469f3a04812b2 2x, https://si.imgix.net/e38c9c7b/uploads/origins/5470a4d3-7af9-4aec-99ac-f5a4c1899c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccab4c92df121331bf49088939d0e14d 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nもしよろしければ資料のOCをお願いできますでしょうか。\n現代社会の裏側で雑貨屋を営んでいる、背の高い竜人の女性です。\n魔術関係の商品などを取り扱ってます。\n構図やポーズなどは全てお任せします。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13PmfTreH4a_twognOetVKk_r5Fnw2ffK", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/52", "thumbnail_src": "https://si.imgix.net/f7a95a1a/uploads/origins/70676b25-467e-4eaf-be29-9c6ff6dc361d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9813af67a975a7470f29c4f5621df972", "thumbnail_srcset": "https://si.imgix.net/f7a95a1a/uploads/origins/70676b25-467e-4eaf-be29-9c6ff6dc361d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9813af67a975a7470f29c4f5621df972, https://si.imgix.net/f7a95a1a/uploads/origins/70676b25-467e-4eaf-be29-9c6ff6dc361d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1778dea59a76c444f8390fbdcbc2553 2x, https://si.imgix.net/f7a95a1a/uploads/origins/70676b25-467e-4eaf-be29-9c6ff6dc361d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03b262a1acac55227476a866ce3ea9c6 3x", "genre": "art", "nsfw": false, "body": "いつも素晴らしい作品をありがとうございます！\nまた前回と同じミズダコちゃんのご依頼となりますがよければお願いしますmm\n\nいつものカフェの、室内席の客席テーブルや床を掃除させられているシーンをお願いしたいです\n前回のキッチンシーンと同じで、テーブルに登らないとテーブルの掃除ができないので、椅子やテーブルにはりついて雑巾で拭き掃除をしている\n他の足で床掃除用のホウキかブラシを持たせてほしいですが、なくても大丈夫です！\n\n自分の手足と接触した床やテーブルが濡れているので掃除が無駄になっているのを見て、自分がやっていることの意味に違和感を感じつつも、気にしないように掃除を続けている感じの表情\n\n衣装は今回もナシでお願いします！\n\n以上です！\nよろしくお願いしますmm", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/51", "thumbnail_src": "https://si.imgix.net/1b7b1776/uploads/origins/292bf9e0-025b-454a-8f37-9f1c0aba91cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0dd038ed904f32d2c1030d5156ae739", "thumbnail_srcset": "https://si.imgix.net/1b7b1776/uploads/origins/292bf9e0-025b-454a-8f37-9f1c0aba91cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0dd038ed904f32d2c1030d5156ae739, https://si.imgix.net/1b7b1776/uploads/origins/292bf9e0-025b-454a-8f37-9f1c0aba91cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7bbf80a40e39d3b0c6d984b1933483f 2x, https://si.imgix.net/1b7b1776/uploads/origins/292bf9e0-025b-454a-8f37-9f1c0aba91cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a879e7fbd0b82d96716bc37f7b6c22a3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/50", "thumbnail_src": "https://si.imgix.net/22422fd9/uploads/origins/938129ba-9427-4493-bf01-4823e65b794b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1679637aa86643a58edb7b229cfaf25", "thumbnail_srcset": "https://si.imgix.net/22422fd9/uploads/origins/938129ba-9427-4493-bf01-4823e65b794b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1679637aa86643a58edb7b229cfaf25, https://si.imgix.net/22422fd9/uploads/origins/938129ba-9427-4493-bf01-4823e65b794b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48823d060058d68285abc0a7bf37e486 2x, https://si.imgix.net/22422fd9/uploads/origins/938129ba-9427-4493-bf01-4823e65b794b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=613367b1fb2535b0b2019f53d57411e5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのモンスターガール作品、大好きです！私のオリジナルキャラクターを描いてくれませんか？\n\nhttps://drive.google.com/file/d/1XoVsMflozeukuOStZkOQajmSEKfxTuki/view?usp=drive_link https://drive.google.com/file/d/1LcF2pUoKIVw_ZbFQT3pYH9lmNA7OtCqx/view?usp=drive_link\n\n彼女の名前はエステル！高慢なケンタウロスの貴族の令嬢です。特に大型のケンタウロス種（身長約230cm）で、魅惑的な容姿と高貴な血筋を非常に誇りに思っています。ケンタウロスの貴族の令嬢にふさわしいポーズで描いていただけませんか？エステルは主に家族の豪華な邸宅や、それを囲む美しい庭園で見かけられます。\n\n代替衣装：https://drive.google.com/file/d/1Ty_yJpoVns4dDCDd5hHZGR7567iHZirc/view?usp=drive_linkhttps://drive.google.com/file/d/1XoVsMflozeukuOStZkOQajmSEKfxTuki/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/49", "thumbnail_src": "https://si.imgix.net/dfd59e13/uploads/origins/4cd92393-eeda-4c70-8114-47e8eb12855d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da1b3f91624d668ad92588bb6043d5f8", "thumbnail_srcset": "https://si.imgix.net/dfd59e13/uploads/origins/4cd92393-eeda-4c70-8114-47e8eb12855d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da1b3f91624d668ad92588bb6043d5f8, https://si.imgix.net/dfd59e13/uploads/origins/4cd92393-eeda-4c70-8114-47e8eb12855d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1b10e350df64d547026419db7bfa212 2x, https://si.imgix.net/dfd59e13/uploads/origins/4cd92393-eeda-4c70-8114-47e8eb12855d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f54f64f4d621fe023c08d74dc3fc63eb 3x", "genre": "art", "nsfw": false, "body": "ミンク先生、こんにちは。knight.pngバージョンもお願いできますか？ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1BD58-IoKwHcJy5CGWOPE2sxJ3FPDpjlx?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1BD58-IoKwHcJy5CGWOPE2sxJ3FPDpjlx\n\nhttps://drive.google.com/drive/folders/1BD58-IoKwHcJy5CGWOPE2sxJ3FPDpjlx", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/48", "thumbnail_src": "https://si.imgix.net/6f863aa3/uploads/origins/02e93980-4899-4ccd-a3f1-0e4ea5c8e0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460585b0b1f0d41c9ad26e9594b3ccac", "thumbnail_srcset": "https://si.imgix.net/6f863aa3/uploads/origins/02e93980-4899-4ccd-a3f1-0e4ea5c8e0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460585b0b1f0d41c9ad26e9594b3ccac, https://si.imgix.net/6f863aa3/uploads/origins/02e93980-4899-4ccd-a3f1-0e4ea5c8e0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f389b49fb68f8baecef6295d2b36c78 2x, https://si.imgix.net/6f863aa3/uploads/origins/02e93980-4899-4ccd-a3f1-0e4ea5c8e0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1352dec6065f0895a9dde349a7f8273d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！昨年は素晴らしいイラストをありがとうございました！\nまたいつものミズダコちゃんを依頼させてください！\n\n海沿いのカフェの裏方として、キッチンで調理役をさせられているシーンでお願いしたいです！\n足の吸盤で調理台に貼り付いて調理をしており、余っている手足でフライパンや包丁を使ったり盛り付けをする等、色々なメニューを同時に作っている感じです\nもともと手足が器用なこともあり、表情は落ち着いた慣れた感じで作業をしているイメージ\n衣装はナシでお願いしたいです\n\n吸盤貼りつきイメージについて、\nタコちゃんは平時は、人間がペタン座りしているような体勢になっており、調理台の高さに頭が届くくらいです\n歩いたり立ち上がるときは人間と同じくらいの高さになりますが、長時間立ち上がっているのは疲れるので、調理台に貼り付いているほうが作業しやすいというイメージです\n\n今回も楽しみにしております！\nご検討宜しくお願いしますmm\n\nhttps://drive.google.com/file/d/1-OjD6GWb0rEE9fQZ_g1WHmbd1YGNNZtz/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/47", "thumbnail_src": "https://si.imgix.net/af1be2f8/uploads/origins/ff27363c-dfca-421c-83e1-b95350138135?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf25708547ddf8d4683607cd2371304", "thumbnail_srcset": "https://si.imgix.net/af1be2f8/uploads/origins/ff27363c-dfca-421c-83e1-b95350138135?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf25708547ddf8d4683607cd2371304, https://si.imgix.net/af1be2f8/uploads/origins/ff27363c-dfca-421c-83e1-b95350138135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=677b29aaf2cf3e512ec343db73e17370 2x, https://si.imgix.net/af1be2f8/uploads/origins/ff27363c-dfca-421c-83e1-b95350138135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbefef02d5a1bc1c8f21d8b90ed081f3 3x", "genre": "art", "nsfw": false, "body": "はじめまして、Mink先生。先生の画風や雰囲気にとても惹かれています。\nキャラクターのアートワークをお願いしてもよろしいでしょうか？\nたくさんの中から選べますし、コスチュームの改造や変更も自由です、ありがとうございます^^。\n\nhttps://drive.google.com/drive/folders/1BD58-IoKwHcJy5CGWOPE2sxJ3FPDpjlx?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1BD58-IoKwHcJy5CGWOPE2sxJ3FPDpjlx", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/46", "thumbnail_src": "https://si.imgix.net/fa44af01/uploads/origins/ad5260d8-7f10-471d-a824-fb93f986bb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e385eec637fbe35bdd52f282ff45ae6", "thumbnail_srcset": "https://si.imgix.net/fa44af01/uploads/origins/ad5260d8-7f10-471d-a824-fb93f986bb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e385eec637fbe35bdd52f282ff45ae6, https://si.imgix.net/fa44af01/uploads/origins/ad5260d8-7f10-471d-a824-fb93f986bb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8831e22e1a2a7c52671aaba3ee2372bc 2x, https://si.imgix.net/fa44af01/uploads/origins/ad5260d8-7f10-471d-a824-fb93f986bb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1228eca251adf020f284b22921b9afd0 3x", "genre": "art", "nsfw": false, "body": "こんにちは。初めまして。\nモンスター娘の作品で幻想的で温かみのある画風に惹かれまして、ラミアをリクエストさせていただきたく…！\n\n⚫︎資料集\nhttps://drive.google.com/drive/folders/1sTOdHvOHvx4DxXfrEWzIAGwUKGDQHLV8\n※稚拙なラフ絵で恐縮ですがイメージが伝われば幸いです…！\n\n\n<希望ポイント>\n⚫︎巨乳\n\n⚫︎髪型は名称は分かりませんでしたが、髪で輪っかを作ったツインテールをお願いしたいです！(地面に届くくらいの髪の長さ)\n\n⚫︎衣装について\n→袖口にフリルがついており広がった袖\n→首から胸までの布はシースルーで透けている(ゲームキャラクター画像のような感じ)\n→衣装の裾もシースルーで透けている\n→スリットは腰まで大胆に開いている\n※自分の好きなポイントを詰め込んだものですのでおかしいところありましたらMink.先生に修正またはアレンジいただければ幸いです…！\n※衣装カラーはおまかせしたいと思います！\n\n●下半身の蛇体について\n→長大かつ肉厚感重視でお願いしたいです！\n\n\n<描いてほしいシチュエーション>\n\n和風ファンタジーチックな風景を眺めながらお酒を味わっているラミアのシチュエーションをお願いします！\n\n●とぐろを巻いた蛇体の上にだらんと寝転びながらお酒を飲んでいる様子\n︎●尻尾でお酒を注いでいる\n●とぐろを巻いている蛇体に衣装や長い髪が垂れている感じも描いていただけたら嬉しいです！\n※ポーズリファレンスはあくまでも参考にということですのでMink.先生が描きやすい形でお願いできればと思います…！\n\n長くなってしまいすみませんが、ご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/45", "thumbnail_src": "https://si.imgix.net/2442c696/uploads/origins/9cb70b3c-7cd1-4108-80ce-3fa34cdded7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afa84aa8a9ebf42727f2fb4b4e282f71", "thumbnail_srcset": "https://si.imgix.net/2442c696/uploads/origins/9cb70b3c-7cd1-4108-80ce-3fa34cdded7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afa84aa8a9ebf42727f2fb4b4e282f71, https://si.imgix.net/2442c696/uploads/origins/9cb70b3c-7cd1-4108-80ce-3fa34cdded7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=394a2e27cd1587993fbefe5275241606 2x, https://si.imgix.net/2442c696/uploads/origins/9cb70b3c-7cd1-4108-80ce-3fa34cdded7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=933974298980435afaef81f7c46a9073 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ミンク\n\n前回作っていただいたキャラクターを使って、いつものようにフルアートワークをお願いしたいと思います。名前はイリーヌにしました。\n前提として、彼女は自分の部屋にいて、自分の好きなメディア（ゲーム、漫画、番組、グッズなど）のキャラクターをパソコンで見て、興奮して変身し始める。\nそのキャラクターは特別に豊満で、一般的にイリーヌとは大きく異なる性格であるべきだ。真面目なリーダーや騎士とか、クレイジーで躁的な人とか。自分とはまったく違う人。そのキャラクターの外見と性格については、あなたに決めてもらう。\n変身については、左右非対称で、両方のキャラクターの断片が存在し、混ざり合いながら、より散らばった不規則な方法で彼女の体が変化するようにする。\n彼女の全身が見えるようにし、画面にはキャラクターを表示する。\nこの環境は、あなたのハロウィンのイメージ、ZZZ、そしてこのユーザー https://x.com/taresa46 からの環境アートをミックスしたものを思い出させます。\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/44", "thumbnail_src": "https://si.imgix.net/26a5b59d/uploads/origins/cc43c3e6-a80a-4bad-b4c8-af5fd883c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3467548f1512a7168a879f0b1668bee", "thumbnail_srcset": "https://si.imgix.net/26a5b59d/uploads/origins/cc43c3e6-a80a-4bad-b4c8-af5fd883c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3467548f1512a7168a879f0b1668bee, https://si.imgix.net/26a5b59d/uploads/origins/cc43c3e6-a80a-4bad-b4c8-af5fd883c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c9f746d0b5fd2264b0398fa5cb8c152 2x, https://si.imgix.net/26a5b59d/uploads/origins/cc43c3e6-a80a-4bad-b4c8-af5fd883c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e34727955ae2786c09fd96090d48b38 3x", "genre": "art", "nsfw": false, "body": "こんにちは！素晴らしいモンスターガールを描きますね！私の恋ラミアOCの「フライ」を描いてください！\n\n彼女はちょっと凶暴で、海賊になるのがとても好きなんだ。ほとんど見せかけだけどね。\n\nポーズとしては、バーやカフェのテーブルにもたれかかって、見る人にこんな表情を見せるとか？ https://drive.google.com/file/d/1K4oJKf4b9niT4cj-l6tH59uED08SyECZ/view?usp=sharing\nその他、描いてて楽しそうなポーズなら何でもOKです！服装は自由です！\n\n参考\nhttps://drive.google.com/drive/folders/1vH9Q5ACqC2MzgU0Je3fbDvbsljFFJoZV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/43", "thumbnail_src": "https://si.imgix.net/0a099430/uploads/origins/6e00ae3a-e919-4d74-ab3e-eda02f40b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcd725ab6e0d153012f6bcedc43a5ee7", "thumbnail_srcset": "https://si.imgix.net/0a099430/uploads/origins/6e00ae3a-e919-4d74-ab3e-eda02f40b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcd725ab6e0d153012f6bcedc43a5ee7, https://si.imgix.net/0a099430/uploads/origins/6e00ae3a-e919-4d74-ab3e-eda02f40b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97b8f303347224d920c7a7988eef37c5 2x, https://si.imgix.net/0a099430/uploads/origins/6e00ae3a-e919-4d74-ab3e-eda02f40b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0276f2bbff1f010726e8c164cae5c61c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n以前描いていただいたOCのミズダコちゃんをまたリクエストさせてください\n\n前回描いていただいた作品の続きで、\n結局市場から逃げられずに売られてしまったミズダコちゃんは海沿いのカフェに買われるが、\n手足が多いので食材としてではなくスタッフ要因になるかもしれないと思われて\n働かされることに…\nもう逃げられないのでしおらしく、されるがままに適当にメイド服を着せられるが、\nタコの下半身や手足は常に濡れているので服の布が体にまとわりついて、\n着心地が悪そうに身体をよじったり、動きづらそうにしたりしているイメージでお願いします！\n\nメイド服やカフェのデザインにはこだわりはありません\nいつもかわいいイラストをありがとうございます！\nよろしくお願いしますmm", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/42", "thumbnail_src": "https://si.imgix.net/ee9b1f92/uploads/origins/32b1205e-9413-4cd2-89fa-4560864a64ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eeb2b0041ff615ed1e6f3929e8e0668", "thumbnail_srcset": "https://si.imgix.net/ee9b1f92/uploads/origins/32b1205e-9413-4cd2-89fa-4560864a64ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eeb2b0041ff615ed1e6f3929e8e0668, https://si.imgix.net/ee9b1f92/uploads/origins/32b1205e-9413-4cd2-89fa-4560864a64ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=789d34b443d2ade5d6eed11147411070 2x, https://si.imgix.net/ee9b1f92/uploads/origins/32b1205e-9413-4cd2-89fa-4560864a64ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=932e0690e391145636b3b6fb661c8046 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のオリジナルキャラクターhttps://drive.google.com/file/d/1V5EmpRjdo9qW7B6zZWI1lCZQFOZwNi17/view?usp=sharing のアートを探しています。\n\nこの画像https://x.com/Mink_rii/status/1968630858450944442/photo/1 のスタイルで、彼女の若いバージョンを探していました。例のように、腕の羽とたくさんの羽、そして尾羽を持つ完全なハーピーにしたかったのです。\n\nシーンとしては、森の梢にある巣の中に彼女を置きたかった。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Mink_rii/works/41", "thumbnail_src": "https://si.imgix.net/90862772/uploads/origins/787483b9-424d-425b-ad12-ea105043a3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50