c47/uploads/origins/7388ef9f-994e-4a6b-8134-92f9f4eeb0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b81567de320bd9fd8212013ab1a0eee7 2x, https://si.imgix.net/8e415c47/uploads/origins/7388ef9f-994e-4a6b-8134-92f9f4eeb0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25c43bfdadd2ac19fc19e8eeee2775ad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kou_pochifu/works/3", "thumbnail_src": "https://si.imgix.net/27938109/uploads/origins/b9fdfd8c-bf99-4e2b-8e90-84c3e18b2dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66984ee95633b104db17e0df5952453e", "thumbnail_srcset": "https://si.imgix.net/27938109/uploads/origins/b9fdfd8c-bf99-4e2b-8e90-84c3e18b2dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66984ee95633b104db17e0df5952453e, https://si.imgix.net/27938109/uploads/origins/b9fdfd8c-bf99-4e2b-8e90-84c3e18b2dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f2eac0e290bb246cf717349d63e2657 2x, https://si.imgix.net/27938109/uploads/origins/b9fdfd8c-bf99-4e2b-8e90-84c3e18b2dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0c4e084e626821c6eeb2d8cf087f672 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nイナツルヒ コウ様のこちらのイラストを拝見し、大きくてだらしなく離れた胸と布地の喰い込んだ股間の描写に感銘を受け依頼させて頂きました。\nhttps://www.pixiv.net/artworks/115702770\n\n自分のオリジナルキャラクターを、先に挙げたイラストと同様にロボポン風に、肉付きが良くむっちりと強調された体形で、主に胸と乳首を責められながら陵辱されているようなシチュエーションでエロく卑猥に描いて頂けませんでしょうか。\n\n■キャラクター容姿■\n先端にかけて明るい緑髪、ビキニ状の日焼け跡のある褐色肌、猫耳\n顔より巨大な胸、巨大でふっくらと隆起した巨乳輪\n乳頭が肉に埋もれた陥没乳首（勃起すると巨乳首と乳首ピアス）\n牛柄の卑猥なコスチューム、バーコードのタトゥー\n\n■キャラクター設定■\nマーシャルのような性に無知で粗暴で男勝りな、刀を獲物とする18歳の若いファンタジーの女冒険者\n\n過去に悪漢に敗北して捕まり、体を薬物などで改造された経験がある\n両胸が規格外に大きく肥大化しており、肥大化した際に乳輪が隆起して乳首が肉に埋もれて陥没してしまっている\n乳首と乳輪の神経が異常なまでに発達してしまい、指で軽く触れられただけで強烈な快楽で腰砕けになる\n肥大化した巨大な胸と下品な大きさの乳輪に嫌悪感と強いコンプレックスを感じている\n\n■イラストの内容■\n非常に敏感な両胸と乳輪を手指などで徹底的に嬲り抜かれながら激しく犯されて、\n羞恥と嫌悪感に涙を流しながらも乳首の責め苦で襲い来る快楽に抗えず、\n何度も何度も繰り返し絶頂させらながら陵辱されているようなイラスト\n\nhttps://www.pixiv.net/artworks/115702770\nこちらのイラストの大きくて離れ気味の胸や布地が喰い込んでむっちりした股間の肉の表現が本当に好きなので\n出来る限り同じようなだらしなくて卑猥な体形に寄せて描いてもらえると嬉しいです。\n\nまた、乳首を「陥没乳首→責められて勃起」のような差分で描いて貰えると嬉しいです。\n\n細かい描写などは全てお任せします。\nエロければどんな酷い事をして頂いても構いません、陵辱シチュエーションや乳首(乳輪)責めが大好きなので、どうぞ遠慮なく卑猥に描いて下さい\n\n■備考■\n・胸と特に乳輪は出来る限り大きく巨大に描いて欲しいです。大きければ大きい程嬉しいです。\n・上半身のビキニは脱がすか着崩すかして欲しいです。\n・体形など全体的に出来ればロボポン風に、キャラクターの表情などは特徴が同じであれば似ている程度で構いません。\n\nもし条件的に厳しいなど何か問題があればキャンセルして頂いて構いませんので、何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1PAKq0B1nTS-fUd7wKcumwxBjwtVViArI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kou_pochifu/works/2", "thumbnail_src": "https://si.imgix.net/c794093e/uploads/origins/29a94e87-6d27-4db0-928e-f4aba99d9e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98a91c35d622dc0d0bbe56e3deeb34fc", "thumbnail_srcset": "https://si.imgix.net/c794093e/uploads/origins/29a94e87-6d27-4db0-928e-f4aba99d9e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98a91c35d622dc0d0bbe56e3deeb34fc, https://si.imgix.net/c794093e/uploads/origins/29a94e87-6d27-4db0-928e-f4aba99d9e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb5de2c3cf4e8fa9f0804b2c80c88486 2x, https://si.imgix.net/c794093e/uploads/origins/29a94e87-6d27-4db0-928e-f4aba99d9e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=691004ac373e6b467e1d98c95be4de4d 3x", "genre": "art", "nsfw": true, "body": "はじめましてイナツルヒ コウさん。\n液体大怪獣コスモリキッドをウルトラリフターで怪獣を軽く頭の上え持ち上げて片手は怪獣の短小チ●ポを握って手コキするイラストお願いします。\n\n真正面でウルトラの母と怪獣の全身が見えて\nウルトラの母昭和時代のマスク　爆乳　ムチムチ体　手袋、ブーツ　カラータイマー青色　無傷\n怪獣　短小チ●ポで小柄\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kou_pochifu/works/1", 