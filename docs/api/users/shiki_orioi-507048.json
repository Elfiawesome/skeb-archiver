gix.net/81c53861/uploads/origins/242a3f79-12da-47c7-bcbb-e1d23cc5c1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f618cd3bc04fdf708e2d151f69a76c93", "thumbnail_srcset": "https://si.imgix.net/81c53861/uploads/origins/242a3f79-12da-47c7-bcbb-e1d23cc5c1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f618cd3bc04fdf708e2d151f69a76c93, https://si.imgix.net/81c53861/uploads/origins/242a3f79-12da-47c7-bcbb-e1d23cc5c1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f70c5a60be68569fa1c245ec72286fe4 2x, https://si.imgix.net/81c53861/uploads/origins/242a3f79-12da-47c7-bcbb-e1d23cc5c1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72688faf01f38084ad627a6907f462e1 3x", "genre": "art", "nsfw": false, "body": "よく作業のお供に配信見させてもらってます！群青の透けない愛と申します。\n\n織さんのイメージで自分を描いて欲しく依頼しました！人型であれば他は何でもいいので自由に描いてもらえたらなと思います。描いていただいたものはついったーのアイコンに使おうと思ってます！よろしくお願いします。\n\n参考までに\n身長159cm\nmbti:ENFP-T\n好きなこと:ダンス、マルチゲーム、お喋り\n嫌いなこと:努力\n好きな食べ物:飴、おでん\n好きな色:群青色、レモンイエロー、なでしこ色", "created_at": "", "completed_at": ""}, {"path": "/@shiki_orioi/works/15", "thumbnail_src": "https://si.imgix.net/4a02f0c0/uploads/origins/262308f7-312e-4332-9c00-d1025a7a799f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e66aabfd5f519ca7aa13dbdfe47cddd", "thumbnail_srcset": "https://si.imgix.net/4a02f0c0/uploads/origins/262308f7-312e-4332-9c00-d1025a7a799f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e66aabfd5f519ca7aa13dbdfe47cddd, https://si.imgix.net/4a02f0c0/uploads/origins/262308f7-312e-4332-9c00-d1025a7a799f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b5606a54b009f1fbba6089c8e7f4bf5 2x, https://si.imgix.net/4a02f0c0/uploads/origins/262308f7-312e-4332-9c00-d1025a7a799f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c423bf03681c25d68e6aac86c131777 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！POPOPONTENと申します。\n素敵なイラスト拝見して、ぜひお願いしたくご連絡しました。\n\n私のアバターを描いていただきたいです。\nVRChat等で使用する「プロフィール画像」に使わせていただく予定です。\n\n参考画像：https://note.com/popoponten/n/nc1eb77d4e9cf\nをもとに、描いていただければ幸いです。\n\n普段は、VRChatでダンスなどを踊っています。\n\n服装やポーズなどは添付画像の雰囲気をベースに、\n貴方様のテイストで可愛く描いていただけたら嬉しいです！\n背景はシンプルor白で大丈夫です。\n\n2048×2048以上の大きさ\nPSD形式ファイルでお願いします。\n\nどうぞよろしくお願いいたします！\n\nhttps://note.com/popoponten/n/nc1eb77d4e9cf", "created_at": "", "completed_at": ""}, {"path": "/@shiki_orioi/works/14", "thumbnail_src": "https://si.imgix.net/8d04841b/uploads/origins/6a114d4f-e704-4bb3-a1c3-206cc9edbb08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd21967b3910c7f44bb6f2404f3987a2", "thumbnail_srcset": "https://si.imgix.net/8d04841b/uploads/origins/6a114d4f-e704-4bb3-a1c3-206cc9edbb08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd21967b3910c7f44bb6f2404f3987a2, https://si.imgix.net/8d04841b/uploads/origins/6a114d4f-e704-4bb3-a1c3-206cc9edbb08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7c73525029f59108da8353ebe87a724 2x, https://si.imgix.net/8d04841b/uploads/origins/6a114d4f-e704-4bb3-a1c3-206cc9edbb08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a272950f90c2ff280f434b72fe5d81fa 3x", "genre": "art", "nsfw": false, "body": "ハロウィンのコスプレしたメイド", "created_at": "", "completed_at": ""}, {"path": "/@shiki_orioi/works/13", "thumbnail_src": "https://si.imgix.net/daabafb9/uploads/origins/c0bb22e1-0249-4ceb-b7d2-3639ce896b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4102c0a6cb8dfa3bc7eeb2bd2321fee5", "thumbnail_srcset": "https://si.imgix.net/daabafb9/uploads/origins/c0bb22e1-0249-4ceb-b7d2-3639ce896b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4102c0a6cb8dfa3bc7eeb2bd2321fee5, https://si.imgix.net/daabafb9/uploads/origins/c0bb22e1-0249-4ceb-b7d2-3639ce896b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to