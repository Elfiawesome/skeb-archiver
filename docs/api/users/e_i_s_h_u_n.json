h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ebda3f0dc6bde6f9033692095c5bf52 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/193", "thumbnail_src": "https://si.imgix.net/7e00a3d6/uploads/origins/960291fd-e476-4265-8a48-3ce48a5ace2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a67e691457ddf24b1b3b97808bc55c4", "thumbnail_srcset": "https://si.imgix.net/7e00a3d6/uploads/origins/960291fd-e476-4265-8a48-3ce48a5ace2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a67e691457ddf24b1b3b97808bc55c4, https://si.imgix.net/7e00a3d6/uploads/origins/960291fd-e476-4265-8a48-3ce48a5ace2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a324bf8b0f8454da6769c563e9681184 2x, https://si.imgix.net/7e00a3d6/uploads/origins/960291fd-e476-4265-8a48-3ce48a5ace2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed2b03d306df78d7762403398f317eda 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/192", "thumbnail_src": "https://si.imgix.net/2902e65a/uploads/origins/3f27f906-ec41-45c5-b2a0-413e9867c70b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bc477180f7f676f4897b45f00cc463", "thumbnail_srcset": "https://si.imgix.net/2902e65a/uploads/origins/3f27f906-ec41-45c5-b2a0-413e9867c70b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bc477180f7f676f4897b45f00cc463, https://si.imgix.net/2902e65a/uploads/origins/3f27f906-ec41-45c5-b2a0-413e9867c70b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9aaf12a794ba83ef7b9fd6c921fd93c1 2x, https://si.imgix.net/2902e65a/uploads/origins/3f27f906-ec41-45c5-b2a0-413e9867c70b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67a0436a221f78b0cda74f37f08766dc 3x", "genre": "art", "nsfw": false, "body": "頼める余裕が出来たので可能でしたらリクエストお受けしていただけると幸いです…！\n「異世界転生おじさんは静かに暮らしたい」の西園寺今日介とサタリア(どちらの形態でもOK)、もしくは西園寺今日介単体をお願いしたいです。\n元ネタ(漫画掲載公式サイト)⇒https://youngchampion.jp/series/411c4bb2c4745?utm_source=twitter&utm_medium=share&utm_campaign=tw_sh_411c4bb2c4745 \n資料⇒https://x.com/umamiyusk/status/1834976765619716469\n\n一応外見的設定として\n西園寺今日介\n・細身で185cm(決定)の長身\n・少し目にクマあり。\nサタリア\n●成体時\n・身長160cm前後\n・巨乳、ふとももは太め。\n・スカートはボディラインが分かる感じ\n●幼女時\n・身長謎(今日介の膝くらいまで)2頭身\n・スカーッとはワンピース\n\nシチュエーションはなんでも大丈夫です。\n泣かされてるのも格好つけてるのもどちらでも大丈夫です。\nサタリアが大丈夫な場合は描きやすい方でお願いします。\n構図、解像度、差分、ファイル形式は自由で構いません。\n \n以前ゲスト原稿を描いていただいたお礼に正式にご依頼したいと思っていたので(自分が作品頂くだけなので御礼にもなってないような気もしますが…)、やっと行動に移せて嬉しく思います。\n当然余力があればのご依頼なのでスルーでも大丈夫です。\n\nここまで読んでくださりありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/191", "thumbnail_src": "https://si.imgix.net/7bb5cd3a/uploads/origins/8e8cd43f-1743-4741-b1f2-5fd2a11d99f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ecb4c48d04c8730547720098c6b36cd", "thumbnail_srcset": "https://si.imgix.net/7bb5cd3a/uploads/origins/8e8cd43f-1743-4741-b1f2-5fd2a11d99f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ecb4c48d04c8730547720098c6b36cd, https://si.imgix.net/7bb5cd3a/uploads/origins/8e8cd43f-1743-4741-b1f2-5fd2a11d99f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8397cda1ed30ccc2c423bf86cf2d4f80 2x, https://si.imgix.net/7bb5cd3a/uploads/origins/8e8cd43f-1743-4741-b1f2-5fd2a11d99f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ee7a3a2079ef777e3477c8b8a8cc2b2 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n以前描いていただいたヘリアの絵がとても気に入りました。https://skeb.jp/@e_i_s_h_u_n/works/173\nまたお願いしたいのですが、今回は違うシーンでお願いします。\n\nヘリア：https://files.catbox.moe/s2jgoc.png\n体のプロポーション：https://files.catbox.moe/5esirc.png\nヘビやドラゴンのような縦長の瞳孔で描いてください。\n\nポーズ：https://files.catbox.moe/mlyaa6.jpg\n参考画像と同じように、仰向けで描いてください。彼女の視線は、見る人ではなく、何か他のものを向いていてほしい。\n\n服装・アクセサリー：https://files.catbox.moe/wig2a7.png\n私のスケッチにあるような服装とアクセサリーを身につけた彼女を描いてほしい。服装は自由に調整してください。服のデザインに磨きをかけてほしい。ドレスは濃い赤に金の模様。彼女の名前は太陽という意味なので、太陽にちなんだアクセサリーや服の柄を描いてください。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/190", "thumbnail_src": "https://si.imgix.net/e3f1496e/uploads/origins/abe068d7-ff39-48d8-99e7-7c8f9f97ada1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe416339e5d8df4777b5731fbd2dc2c0", "thumbnail_srcset": "https://si.imgix.net/e3f1496e/uploads/origins/abe068d7-ff39-48d8-99e7-7c8f9f97ada1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe416339e5d8df4777b5731fbd2dc2c0, https://si.imgix.net/e3f1496e/uploads/origins/abe068d7-ff39-48d8-99e7-7c8f9f97ada1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29354e6f5581feecf36420ef520a77e5 2x, https://si.imgix.net/e3f1496e/uploads/origins/abe068d7-ff39-48d8-99e7-7c8f9f97ada1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=701170d738bd7d595320e0cff229b0d6 3x", "genre": "art", "nsfw": false, "body": "平素よりお世話になっております。T-BLADEです。\n先日は素晴らしいマイポーンのイラストを有難うございました。\n\n今回は、やはり『ドラゴンズドグマ２』のメインポーンにして愛妻であるレィオリシアさんを描いていただきたいと思います。\n\n【装備】\n以下の参考写真にある魔法職の装備で、\n頭：トワイライトスター\n胴：星見のメイデンクロス\n脚：宝珠編みのサンダル\nでお願いいたします。武器無しで結構です。\nなお、装備デザインは適宜アレンジしていただいても結構です。\n\n【参考写真】\n・顔アップ\nhttps://x.com/TH_BLADE/status/1850139002848067861\nhttps://x.com/TH_BLADE/status/1850139007222718562\n\n・バストショット\nhttps://x.com/TH_BLADE/status/1850139011194740747\n\n・半身\nhttps://x.com/TH_BLADE/status/1850139015338680811\n\n・全身\nhttps://x.com/TH_BLADE/status/1850139019637870614\n\n・ポーズ\nhttps://x.com/TH_BLADE/status/1850139023756710014\n\n・オマケ\nhttps://x.com/TH_BLADE/status/1850139027506389175\n\n【身長・体重】\n身長：200cm\n体重： 99kg\nあっちこっち規格外サイズです。\n\n【希望ポーズ】\n以前、藤井先生が描かれた以下のイラストのような、やや下からのアングルで、優しく艶っぽい表情で覚者様を誘っているかのようなポーズでお願いいたします。\nhttps://x.com/eiiiiiiishun/status/1712786775683555421\n\n【留意点】\nバストはカブラさんと同等かそれ以上の特盛りにしていただけると幸いです（笑）。\nhttps://x.com/e_i_s_h_u_n/status/1814573541125468258\n\n以上です。\nそれでは、何卒宜しくお願いいたします。\n\nhttps://x.com/TH_BLADE", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/189", "thumbnail_src": "https://si.imgix.net/e74b4c62/uploads/origins/0795740a-8619-471f-b5ce-4e999d9e3f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41b06597cc22a1f31944c1b5dcb94a2f", "thumbnail_srcset": "https://si.imgix.net/e74b4c62/uploads/origins/0795740a-8619-471f-b5ce-4e999d9e3f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41b06597cc22a1f31944c1b5dcb94a2f, https://si.imgix.net/e74b4c62/uploads/origins/0795740a-8619-471f-b5ce-4e999d9e3f58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d88eaff48c9ded2ecd8516d41ce156 2x, https://si.imgix.net/e74b4c62/uploads/origins/0795740a-8619-471f-b5ce-4e999d9e3f58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=191e2d11e87514ef4dd17e1c15d54f3d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！バルダーズゲート3の「The Dark Urge」と「Shadowheart」をリクエストしたいです。\n\n\"闇の衝動\" : https://imgchest.com/p/vj4jvbogx48\n\nシャドウハート：https://imgchest.com/p/m9yxv5jq34q\n\nShadowheartと \"The Dark Urge \"が一緒に戦っている。\n\nシャドウハートはこの服を着られるか: https://cdn.imgchest.com/files/wye3ckq9kj4.png\n\n「闇の衝動」はシャドウハートの腰に手を回し、守るような体勢をとること。\n闇の衝動」はドラゴンボールのフレイザの超新星攻撃のような、強力な火球攻撃をチャージすることができるか。 (https://static.wikia.nocookie.net/dragonball/images/3/30/Supernova.png/revision/latest?cb=20180906002322 )\n\nもしそれがやりすぎなら、普通の火球攻撃でも構わない。\n\nhttps://imgchest.com/p/vj4jvbogx48", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/188", "thumbnail_src": "https://si.imgix.net/cf5be9e1/uploads/origins/95823514-4b98-448d-bf84-913a1c6d2cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1091f1e9d72b7938919bb756e8b192a", "thumbnail_srcset": "https://si.imgix.net/cf5be9e1/uploads/origins/95823514-4b98-448d-bf84-913a1c6d2cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1091f1e9d72b7938919bb756e8b192a, https://si.imgix.net/cf5be9e1/uploads/origins/95823514-4b98-448d-bf84-913a1c6d2cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93b69f3a0a3f8f1ea0411028be57112b 2x, https://si.imgix.net/cf5be9e1/uploads/origins/95823514-4b98-448d-bf84-913a1c6d2cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f9558e5bff369dc2aeb952adbdafcf8 3x", "genre": "art", "nsfw": false, "body": "初めまして。藤井様の竜破斬のイラストに感化され参りました。\nリクエストテーマは私のオリキャラをお願いします。\nイラストテーマ性としてはオリキャラがデスボールを溜めて、ドス黒い魔力の流動が現れているイラストをお願いします。\n\n\n・オリキャラになります\nhttps://x.com/4Lx3NIDhg4XwECi/status/1798687071575605646\n衣装は鉄腕バーディーの生体皮膚をアレンジした物になります。\nオリキャラは黒白目のキャラです。\n特徴が爪が黒く、身長180cmを超える大柄なキャラです。イメージとして色んな悪女キャラを参考にして考えました。\n種族的には人造悪魔、鬼、生体兵器じみた側面を持ちます。\n\n\n･状況場面参考画像\nhttps://x.com/e_i_s_h_u_n/status/1832435827454153183\nポーズそのものの、細かな調整はお任せします。\n場面的には上記のイラストに近く、魔力球を生成している場面でお願いします。\nアングルは藤井様の描かれた上記のイラストの様なローアングルな角度で。\n両腕を空へかがげている様子でお願いします。\n\n･魔力エフェクト\nオリキャラの魔力の色は赤を中心に外側の縁（ふち）に太い黒いラインが入った物となります。\n\n魔力球の色は下の様な血のような赤色で縁は黒くなったイメージでお願いします。\nhttps://www.pixiv.net/artworks/91943434 (球体色)\n\nその魔力球から放出されている、炎や雷みたいなエフェクトの色は魔力球と異なり黒メインの赤い流動的なエフェクトでお願いします。\n\n･https://drive.google.com/file/d/1qppbRrEw1Ixbw7vjJCJcypG3VVvnsSAR/view?usp=drivesdk\n(色的にイメージはこれらに近い)\n･https://x.com/TEN0u0/status/1417536990233260035\nイメージ的に、上記BLEACHのエフェクトに近い配色となっています。\n\n・表情参考画像\nhttps://x.com/Clov_erD/status/1836348371117769154\nキャラの表情はこの画像の下のギョロ目になった“鬼方カヨコ”の表情になります。\nアクセラレーターみたいな顔芸しながらの戦闘スタイルになります。\n\n説明以上となります。\n 藤井英俊様の手掛ける作品のエフェクトがどれも綺麗で一目惚れのような形でお願いしたいと思いました。よろしくお願いします。\n\nhttps://postimg.cc/gallery/15QfrJx", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/187", "thumbnail_src": "https://si.imgix.net/d8be18d2/uploads/origins/c5bfb6eb-96ce-4361-a35c-a927113c00bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f311c90d5b42ac59ec25891c7112d052", "thumbnail_srcset": "https://si.imgix.net/d8be18d2/uploads/origins/c5bfb6eb-96ce-4361-a35c-a927113c00bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f311c90d5b42ac59ec25891c7112d052, https://si.imgix.net/d8be18d2/uploads/origins/c5bfb6eb-96ce-4361-a35c-a927113c00bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=657d350ed05142e946426589c0c4aa32 2x, https://si.imgix.net/d8be18d2/uploads/origins/c5bfb6eb-96ce-4361-a35c-a927113c00bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f65a86dd6430178dd5e802ba717eabc3 3x", "genre": "art", "nsfw": false, "body": "英俊さん、こんにちは！はじめまして！\n\nファンタジーTRPGで使っているOCのイラストをお願いしたいです。\n\n名前は「オーレリア・ルメリ」。\n身長210cm、30歳、聖王国の騎士姫です。\n\n特殊な血統のため、体は大きく、力強く、タフ。肌は白い。髪はボリュームがあり、長い。色はハニーブロンド。少しカールしている。\n右目は明るいワインレッド、左目は水色。\n\n参考：https://drive.google.com/drive/folders/1CuH68aYvDoqrzjFSQk2iZF9XnI4fbQNI?usp=sharing\n\nあなたの素晴らしい作品である久里浜明美のボディは、私がイメージするオーレリアとよく似ている。https://twitter.com/e_i_s_h_u_n/status/1819127395015971290\n\nオーレリアの気質は、ストイックで落ち着きがあり、しかし優しく、愛する人を命がけで守る。\n\n普段の服装は深い青と銀の高貴なドレスで、威厳と強靭な肉体の両方を表現している。ポーズや衣装はお任せします！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1CuH68aYvDoqrzjFSQk2iZF9XnI4fbQNI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/186", "thumbnail_src": "https://si.imgix.net/94bf7102/uploads/origins/dc1df6b7-8d64-4f58-8bf1-6f665504f370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e640bacc6d2b4ce3416965a04a835867", "thumbnail_srcset": "https://si.imgix.net/94bf7102/uploads/origins/dc1df6b7-8d64-4f58-8bf1-6f665504f370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e640bacc6d2b4ce3416965a04a835867, https://si.imgix.net/94bf7102/uploads/origins/dc1df6b7-8d64-4f58-8bf1-6f665504f370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ff0ef2b957f514f670b626ad273e57b 2x, https://si.imgix.net/94bf7102/uploads/origins/dc1df6b7-8d64-4f58-8bf1-6f665504f370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b2b1f2d78cb2213788801e65eb2527e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、栄春！\n\n私たちの2人のOC、EmaとDuahの友人と一緒にリクエストを出したいと思います。\n\nプロンプト絵麻とデュアは敵と激しい戦いを繰り広げている。\n\n絵麻\n\nキャラクター紹介：\nhttps://drive.google.com/drive/u/0/folders/1s0aucIrkv1dF2ktyIdQCk3-kpFiZ0pRL\n衣装\nhttps://drive.google.com/drive/u/0/folders/1dRZHiK9yqEXWKknUc4mZIAGet_EmYquN\n\n性格\n絵馬は明るく陽気な狐の女性で、気まぐれでいたずら好き。決闘や武術・魔法を試すのが好き。\n\nデュア\n\nキャラクター紹介：\nhttps://drive.google.com/drive/folders/1dbPOcm3bRylQz_rk1Gz5RcsBcp3hlMII?usp=drive_link\n衣装\nhttps://drive.google.com/drive/folders/1Bi_e2r-oApOadRse35bYM2tgA4iRwRhC?usp=drive_link\n\n性格\nドゥアは冒険を求める熱烈な猿人で、楽しくて思いやりのある性格をしている。トレーニング、探検、新しい経験を楽しんでいる。\n\nポーズ\nhttps://drive.google.com/drive/u/0/folders/16pBsCHLxsxpf2w-Fl3lV3kaPgXt1SzWv\n絵馬とドゥアは激しい表情で隣り合っています。参考にしたポーズを使用してください。\n-地面に立っていても、浮いていても構いません。\n-背景は谷間でも構いません。\n絵馬＝左\nドゥア＝右\n\nふたりは雷の魔法で形成された魔法の大剣の柄を握っている。\nデュアの雷＝緑\n絵麻の雷＝白\n-剣は両方の色を反射する。", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/185", "thumbnail_src": "https://si.imgix.net/60549886/uploads/origins/4f2a4c2e-d031-498c-badd-84d05854bff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e8a12e9db4061a41b7d1859456f5e70", "thumbnail_srcset": "https://si.imgix.net/60549886/uploads/origins/4f2a4c2e-d031-498c-badd-84d05854bff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e8a12e9db4061a41b7d1859456f5e70, https://si.imgix.net/60549886/uploads/origins/4f2a4c2e-d031-498c-badd-84d05854bff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ccd7d395b427149408614548863a618 2x, https://si.imgix.net/60549886/uploads/origins/4f2a4c2e-d031-498c-badd-84d05854bff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cb4a27073a3404fe884a27b102bccbc 3x", "genre": "art", "nsfw": false, "body": "改めてこんにちは！またお仕事をお願いしたいです。FFXIVの占星術師である私のキャラクターと、ララフェルの黒魔道士の男性である友人のキャラクターを、ゲームに登場するNPCキャラクターである黒猫とウィキッドサンダーと一緒にバトルポーズで描いていただけないでしょうか。ブラックキャットとウィキッドサンダーについては、こちらを参照してください：\nhttps://drive.google.com/drive/folders/1Pkn8l32l3kZNIdFDh83SymcMZTUgBIoi?usp=sharing\nその参考資料の中に、私が背景に使いたいと思っている闘技場もあります。黒猫とウィキッドサンダーは\n私のキャラクターは占星術師で、星座盤と占いデッキを武器にして味方を癒します。\n全員でポーズをとっているのか、戦闘中なのかは自由です。その他、キャラクターのポーズなど、詳細はお任せしたいと思います！\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/191QqPovCGvtXt8pLy5QhXBygxcfpGkOC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/184", "thumbnail_src": "https://si.imgix.net/3daa0eae/uploads/origins/002fa007-1209-4a33-aca9-ad03c4b97ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff8be367b902aff0766173efceebb64", "thumbnail_srcset": "https://si.imgix.net/3daa0eae/uploads/origins/002fa007-1209-4a33-aca9-ad03c4b97ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff8be367b902aff0766173efceebb64, https://si.imgix.net/3daa0eae/uploads/origins/002fa007-1209-4a33-aca9-ad03c4b97ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e63ab7e60667a8978aa60bcf042d9b92 2x, https://si.imgix.net/3daa0eae/uploads/origins/002fa007-1209-4a33-aca9-ad03c4b97ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1524fb9cbc35954b3785c550ee2c379a 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラスト拝見しております。\nウチの子（バーバリアンクイーン アマラ・レイナ）をリクエストさせて下さい。\n\nキャラクター参考画像： https://files.catbox.moe/pz64cu.png\n\n彼女のチャームポイントだと思うので、2つの艶ぼくろと切れ長の猫のような瞳孔を必ず描いてください。彼女のトライバルマークは、描写が面倒であれば、必要に応じて簡略化したり削除したりすることもある。彼女の鼻は鼻孔がないように描かれるべきである。\n\nキャラクター設定：\n中世ファンタジーの舞台で、小さな戦士の部族を支配する28歳の女性。自らを女王と称しているが、部外者から見れば、政治的な影響力も周辺諸国とのつながりもない、盗賊の酋長か部族のリーダーといったところ。彼女の領地は森と洞窟が広がる未開の地で。凶暴な性格だが、好みの男を見つけるとエロになり、服従するまで追いかける。\n\n可能であれば、 主観視点を利用して、彼女が戦闘で打ち負かした男の視点から彼女を描いてほしい。(もっとダイナミックな構図がお望みなら、思いのままに描いても問題はありませんが）。\n彼女の剣は肩にかけられ、空いた手は腰に当てられ、自信に満ちた と誘惑が同居したような態度だ。\nまるで 「あなたを殺すのは惜しいから、私と一緒に来て私の奴隷（夫）になりましょう 」とでも言っているかのような、見る者を誘うようなSっ気のある表情をしている。それは、かつての敵に対する脅しであると同時に、夫としてふさわしいと認められた相手に対するエッチな誘いでもある。\n\nそれ以外の詳細は、先生にお任せします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/183", "thumbnail_src": "https://si.imgix.net/85117ac2/uploads/origins/e465af6e-c500-4f8d-bb97-1fe3ad1a42f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c844c43f3713e506154a82da9b6888", "thumbnail_srcset": "https://si.imgix.net/85117ac2/uploads/origins/e465af6e-c500-4f8d-bb97-1fe3ad1a42f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c844c43f3713e506154a82da9b6888, https://si.imgix.net/85117ac2/uploads/origins/e465af6e-c500-4f8d-bb97-1fe3ad1a42f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc5288d008b0d4ebc93043e48ecc7b2d 2x, https://si.imgix.net/85117ac2/uploads/origins/e465af6e-c500-4f8d-bb97-1fe3ad1a42f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1acfa82344f78c889e8960bd133e4ba0 3x", "genre": "art", "nsfw": false, "body": "藤井英俊様。\n初めまして。\n\nぜひ英俊様に描いていただきたいイラストがあり、今回リクエスト送らせていただきました。\n\n私のV体を作って下さった\n「白亜ディラさんという方のイラストを描いていただきたい」\nという内容になるのですが、あとひと月ほどで出産されるのです。\n\nそこで英俊様に、資料URLのような構図で真ん中に子供を挟んでいるか、もしくは旦那様とディラさんで子供を2人で抱っこしてるようなイラストを依頼したく思っています。\n\n可能であれば依頼受諾していただけると幸いです。\n\nhttps://x.com/hakua_dira/status/1842379204530413692?t=IfyK_7F1jzdkwphGViQdDA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@e_i_s_h_u_n/works/182", "thumbnail_src": "https://si.imgix.net/6fc63554/uploads/origins/4f6c5f75-0d21-4202-bcc3-b31e4e584fb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=