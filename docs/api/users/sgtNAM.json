size=30&txt=PRIVATE&s=c4a4804e3470e980e4d274a43391d692", "thumbnail_srcset": "https://si.imgix.net/0172850b/uploads/origins/522b82aa-f3c0-4f67-af8c-5654d4e9c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4a4804e3470e980e4d274a43391d692, https://si.imgix.net/0172850b/uploads/origins/522b82aa-f3c0-4f67-af8c-5654d4e9c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55da1172bff537ef8228ef1cff9c7ab2 2x, https://si.imgix.net/0172850b/uploads/origins/522b82aa-f3c0-4f67-af8c-5654d4e9c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5460652ab17e3ef203382c8dad71053 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sgtNAM/works/36", "thumbnail_src": "https://si.imgix.net/2de617b5/uploads/origins/866cb91f-da8a-4ca0-821e-594681dc48af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=777f32ba31d40adfedac2c1b75f23efb", "thumbnail_srcset": "https://si.imgix.net/2de617b5/uploads/origins/866cb91f-da8a-4ca0-821e-594681dc48af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=777f32ba31d40adfedac2c1b75f23efb, https://si.imgix.net/2de617b5/uploads/origins/866cb91f-da8a-4ca0-821e-594681dc48af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f594d6574cc74e93e8601f8eb86f6a6 2x, https://si.imgix.net/2de617b5/uploads/origins/866cb91f-da8a-4ca0-821e-594681dc48af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b87aaf2187bf8b062d705602b9bdc76 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です！\n初めての依頼失礼します。\n櫻子ちゃんのイラストで現在の体型から大食いして更に肥満化してしまい横にも前にもでっぷりと突き出たお腹を叩きながらゲップしている姿をお願いします！\n差分でビキニと競泳水着の衣装もお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@sgtNAM/works/35", "thumbnail_src": "https://si.imgix.net/b3f373ad/uploads/origins/1ee5db70-0f9e-4b7d-ae3c-33f0d4008706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1979f5f0465707879ac6e86fb26f783f", "thumbnail_srcset": "https://si.imgix.net/b3f373ad/uploads/origins/1ee5db70-0f9e-4b7d-ae3c-33f0d4008706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1979f5f0465707879ac6e86fb26f783f, https://si.imgix.net/b3f373ad/uploads/origins/1ee5db70-0f9e-4b7d-ae3c-33f0d4008706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a64cb6597fa271d2c4bb5a3e4f1f605e 2x, https://si.imgix.net/b3f373ad/uploads/origins/1ee5db70-0f9e-4b7d-ae3c-33f0d4008706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=338fec8e0eb07a2a98c57f07f051fcf6 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。以前に描いて頂いた「ふたなりシスター」が姉妹ともに素晴らしく、また描いて頂きたい気持ちは強いのですが、センス溢れる新たなデザインのキャラクターを見てみたいと思い、今回は異なる方向性でリクエストを送りたいと思います。\n\nイメージとしては「露出した鉱物が放つ魔力の光に照らされ、大小様々な菌類が巨大な森を形成する洞窟世界。其処には、特殊な進化を遂げた菌類を身に纏い、その能力を活かしてサバイバルするエルフたちの社会があった」という感じで。自分の中での解像度が少し低く、言葉による描写が不足しそうだったので、まずイメージを提示させて貰いました。『風の谷のナウシカ』に登場する腐海のような環境で暮らすため、自身の身体に菌類を根付かせたエルフになります。\n\n・エルフ\n銀色の体毛に褐色の肌を備えた、所謂ダークエルフ的な容姿。頭髪はボリュームのある蓬髪で、不潔な感じにならない程度にモジャモジャさせて欲しいです。両目は伸びた前髪に覆われており（メカクレ）、体型は、彼女自身が、根付かせた菌類にとって好ましい肥沃な土壌である事を示すため、ムッチリと太くお願いします。表情は、口を結んで勇ましい感じ…の中に、快感に耐えているような艶めかしさがあれば言う事なしです。ポーズは、描きやすいよう自由にしてください。\n\n・菌類\nエルフと共生し、サバイバル生活を助ける菌類。体内に張り巡らせた菌糸から、膣や肛門を通して外部に武器や防具として機能する子実体（キノコ）を伸ばす。露出しているのは全てキノコの部分なので、ボディスーツというよりも、太い縄のような形状の柄が、身体にしっかり巻き付いているようにお願いしたいです。エルフとキノコは個別の存在で、一体化している訳では無いので、両者の間にメリハリがあるのが理想です。色と模様は、毒々しさが出ていれば、どのようなデザインでも構いません。また、武器として、キノコの特徴を分かり易く表わす形状をした鈍器を持たせて欲しいです。最後に、股間からは、大きなキノコを陰茎のように生やして頂けると嬉しいです。\n\n一応、念のためですが、背景は無地で構いません。\n\n長文失礼しました。\n相も変わらず尖った性癖の塊ですが、よろしければ、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sgtNAM/works/34", "thumb