b0ca9f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61269ae2029f54deddd55fb9c1a0959f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/22", "thumbnail_src": "https://si.imgix.net/c28d2406/uploads/origins/9cefcb8d-7dfa-4a4f-a795-53dd397dc282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3bbcea2effbf9951e38a60f4f6f328", "thumbnail_srcset": "https://si.imgix.net/c28d2406/uploads/origins/9cefcb8d-7dfa-4a4f-a795-53dd397dc282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3bbcea2effbf9951e38a60f4f6f328, https://si.imgix.net/c28d2406/uploads/origins/9cefcb8d-7dfa-4a4f-a795-53dd397dc282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9eff17d7c38b5d4420d6b1c1d28cdb95 2x, https://si.imgix.net/c28d2406/uploads/origins/9cefcb8d-7dfa-4a4f-a795-53dd397dc282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6a53cbb79237bd181523380b6c81eef 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nMATOBA様にお依頼したいのはTRPGで使用しているオリジナルキャラクターのイラストです。\n\n○キャラクターの説明  \n共通:イタリアから出発して世界中を旅している何でも屋の凸凹コンビの恋人\n仕事の内容は、パーティーへの潜入（暗殺や密偵)や人探しなど。\n基本的に喧嘩(一方的)をしていることが多い\n\n\n\n\n\n女性:ディウム\n天使の羽をもつ女性です。毒舌で人を煽ることが多い強かな性格。\n「あらあら困ったわねえ」「ノクちゃん、可愛いわね。遊んであげる」など飄々とした態度が多く、大人っぽくS気がある。男性によくイタズラや意地悪(だる絡み)をよくしている。\n強かな女。魔性の女。最近の趣味はおしゃれをすること。\n\n\n\n男性:ノクト\nヒットマン。短気でぶっきらぼうな苦労人。女性をウザがっていることが多いが、愛が大きいが恋人が「時々照れ隠しの類で強かな態度をとっている」ことを知っている。口が悪いが溺愛している。珍しく照れることがある恋人の反応に加虐心が煽られることがしばしば。\n最近の趣味は釣り。\n\n\n\n\n◾︎依頼内容\n自由に描いていただいて大丈夫です!\n衣装なども自由にして大丈夫です、好きに描いていただければと思います\n\n\n〇資料\nhttps://www.dropbox.com/scl/fo/03f4arxhcfpr34h90bmhp/AAVxD7UrYcK3jfCnyV8gdIY?rlkey=jze58zg6whi9cyi7723rz35o5&st=othfh7k1&dl=0\n\n\n内容等がよろしければ何卒お願いします", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/21", "thumbnail_src": "https://si.imgix.net/b155e9da/uploads/origins/ab6a58f8-1772-4ba4-9550-0f3aa954e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b877d7629a62530f33ca0ba59cf4f8", "thumbnail_srcset": "https://si.imgix.net/b155e9da/uploads/origins/ab6a58f8-1772-4ba4-9550-0f3aa954e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b877d7629a62530f33ca0ba59cf4f8, https://si.imgix.net/b155e9da/uploads/origins/ab6a58f8-1772-4ba4-9550-0f3aa954e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ed9d9356da9487dbea08bee3be28b16 2x, https://si.imgix.net/b155e9da/uploads/origins/ab6a58f8-1772-4ba4-9550-0f3aa954e7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6787c5aee3c0dbbee99a6835693ef82a 3x", "genre": "art", "nsfw": false, "body": "はじめまして、是非先生にOCを描いていただきたくリクエストをお送りします。\n(trpgのキャラクターですがシナリオ等のネタバレはありません)\n\n❖キャラについて\n2人は主従関係です\n\n茶髪の男性：大富豪、27歳\n器用では無い分、何事にも全力で取り組む自信家。大富豪ではあるがまだまだ上を目指しています。\n\n黒髪の男性：使用人兼番犬、28歳\n茶髪男性の身の回りの世話の他、ボディガードも熟す。手を抜くところは抜いて、要所要所で堅実な方法を選ぶタイプです。\n\n\n衣装簡略化や改変、場面や構図等は描きやすいようお好きにしていただいて問題ありません。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1vXf9uGxb43zlpECo61oN7BDBot_uUYMK", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/20", "thumbnail_src": "https://si.imgix.net/17c79628/uploads/origins/fd3ec32e-6988-4e50-b531-5daf3b5fda6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21a40cd7e442af531c54f453670f906c", "thumbnail_srcset": "https://si.imgix.net/17c79628/uploads/origins/fd3ec32e-6988-4e50-b531-5daf3b5fda6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21a40cd7e442af531c54f453670f906c, https://si.imgix.net/17c79628/uploads/origins/fd3ec32e-6988-4e50-b531-5daf3b5fda6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=200416252d0dd18914d7d46fb8977f9d 2x, https://si.imgix.net/17c79628/uploads/origins/fd3ec32e-6988-4e50-b531-5daf3b5fda6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=561f27cf13adfd0e021e334cee35e258 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私は本当にあなたの芸術が好きです。私のocのイラストを描いていただけますか?キャラクター設定とイラストは下記リンク先に添付します。\nメイド服を選ぶなら、喫茶店で二人が働いている映像を見たいです。\n普通の服を選ぶなら、男性が女性の背中の真珠を撫でているのを見たい。\n\nhttps://drive.google.com/drive/folders/1xCuw2CaEHKOl2l75pu9XeIVNsm5stG9A?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/19", "thumbnail_src": "https://si.imgix.net/91320518/uploads/origins/d27b2286-f157-4f6b-b5df-6710ea171207?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b912701b81e7443912c04b71f0861dd8", "thumbnail_srcset": "https://si.imgix.net/91320518/uploads/origins/d27b2286-f157-4f6b-b5df-6710ea171207?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b912701b81e7443912c04b71f0861dd8, https://si.imgix.net/91320518/uploads/origins/d27b2286-f157-4f6b-b5df-6710ea171207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7925a4a5ee7e59e1520284005386b5fe 2x, https://si.imgix.net/91320518/uploads/origins/d27b2286-f157-4f6b-b5df-6710ea171207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eed4401d5bda176df492436abf53c2e1 3x", "genre": "art", "nsfw": false, "body": "はじめてリクエストを送らせていただきます、色塩です。\nMATOBA様の描かれるイラストの光の表現や構図、表情・関係性の切り取り方がとても大好きで、是非とも自身と友人の探索者を描いていただきたく送らせていただきました。\n\n今回描いていただきたいのは【華村鈴秋・嗚子七々子】という幼馴染のキャラクター2人です。\nどちらもTRPGの探索者であり今回の内容にシナリオ等のネタバレは一切含まれておりません。\n以下に詳細をまとめておりますので、こちらの内容で依頼をお受けいただけるかご検討いただけますと幸いです。🙇‍♀️\n\n🔊情報や料金に不足がある場合はお気兼ねなく再送要請をお送りください。🔊\n\n\n\n【使用用途】\n壁紙など第三者の目に触れない個人の範囲での使用。\n第三者の目に触れるXやディスコードでの投稿・アイコンへの使用等。\n（MATOBA様が描いてくださった旨は記載）\n\n\n【イラストの構図・サイズ等について】\n基本的にMATOBA様の好きな構図・服装、好きな物量で描いていただいて大丈夫です！\n知らないキャラを指定なしですと難しい部分もあるかと思いますので、資料URL先に構図イメージをまとめております。\nイメージに沿って描いていただいてもアレンジや物量のカットを行って頂いてももちろん構いません。\n\nhttps://drive.google.com/drive/u/0/folders/1xXzIgOtK9wwoocx3dqSRyndJu1FlqJWO", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/18", "thumbnail_src": "https://si.imgix.net/d59102e9/uploads/origins/05e9d5e9-1bdb-4318-9fbe-8a697c5a1d2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff6157fe7328a350f084c3588d7268f0", "thumbnail_srcset": "https://si.imgix.net/d59102e9/uploads/origins/05e9d5e9-1bdb-4318-9fbe-8a697c5a1d2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff6157fe7328a350f084c3588d7268f0, https://si.imgix.net/d59102e9/uploads/origins/05e9d5e9-1bdb-4318-9fbe-8a697c5a1d2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32110b83000ab18aca1bc3def6450250 2x, https://si.imgix.net/d59102e9/uploads/origins/05e9d5e9-1bdb-4318-9fbe-8a697c5a1d2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e8a909831eef67e12e63d2403760879 3x", "genre": "art", "nsfw": false, "body": "matobaさん、初めまして、風花雪月の頃からmatobaさんの絵が好きてフォローしていた者です。\nよろしければオリキャラを描いていただけませんか\n二人は幼馴染で、また女神と女神の贄という関係です（本人は知らない）\n私的に、matobaさんが描かれた二人の台所の風景を見たいですが、このテーマが気に入らなかったらお任せします。構図、服装も自由に変わって構いません。リクエスト受け取ってくれるだけでも嬉しいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1XZ8lwvKTa_WJaNrq5jr50bzZklGvyvn5", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/17", "thumbnail_src": "https://si.imgix.net/90fbae0f/uploads/origins/5fecb7ca-9a9e-4b4d-81af-2a63a3e9696d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b736f033ed6ec53edb2f1a5dab7fd1cf", "thumbnail_srcset": "https://si.imgix.net/90fbae0f/uploads/origins/5fecb7ca-9a9e-4b4d-81af-2a63a3e9696d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b736f033ed6ec53edb2f1a5dab7fd1cf, https://si.imgix.net/90fbae0f/uploads/origins/5fecb7ca-9a9e-4b4d-81af-2a63a3e9696d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee169e845271c473ab2225e965369a77 2x, https://si.imgix.net/90fbae0f/uploads/origins/5fecb7ca-9a9e-4b4d-81af-2a63a3e9696d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49b73f195d05821cfae89becf23a5933 3x", "genre": "art", "nsfw": false, "body": "MATOBA様、初めまして。\nMATOBA様の風花雪月の作品にとても惹かれ、かねてより拝見させていただいてました。\n今回は私のオリジナルキャラクターの2人を描いていただきたく、リクエストさせていただきました。\n\n透（とおる）\n男、黒髪、蛇のような金目。40歳。化粧で若作り。身長170台。\n\n赤柊（あかひ）\n女、赤髪、猫のような青目。15歳。中性的。身長150台。\n（参考画像は20代の画像の為、少しだけ成長しています）\n\nhttps://drive.google.com/drive/folders/1CMqYRWRcWBLeWGXMizpN8XBtoeSCATlr\n\n二人は怪人二十面相をモチーフとした変装を得意とした怪盗として作成しました。\n幼い時に女が男に拾われる形で出会い、\n関係性は犬と飼い主のような主従関係であり、契約的な師弟関係でありながらも、相手に伝えない表面下では互いに親子のような愛情を淡く持っています。\n\n服装は私服で男性側はスーツ、女性側は簡素かつ清潔感のある服のイメージでお願いしたいと考えています。\n\n構図はおまかせしたいと考えてますが、少し仄暗い場所にいるような、二人の関係性が現れるようなイラストであると大変嬉しいです。\n\n使用用途：SNSなどのアイコン、ヘッダー、鑑賞、個人で楽しむためにグッズ作成(非商用) \nMATOBA様のお名前ありでの画像を載せたツイート。\n\n\nサイン入り、サインなしを分けて頂けると嬉しいです。 \nキャラクター2名でのお願いとなるため、金額が足りない等ございましたらお手数ですが再送を要請していただけると幸いです。 \nお忙しいところ恐縮ですが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1CMqYRWRcWBLeWGXMizpN8XBtoeSCATlr", "created_at": "", "completed_at": ""}, {"path": "/@ma10ba/works/16", "thumbnail_src": "https://si.imgix.net/0a0f30e8/uploads/origins/3bceb5b4-afc7-4ad9-be24-c023d871a84e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1156dd7ede485e868583b76d7b3fc884", "thumbnail_srcset": "https://si.imgix.net/0a0f30e8/uploads/origins/3bceb5b4-afc7-4ad9-be24-c023d871a84e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1156dd7ede485e868583b76d7b3fc884, https://si.imgix.net/0a0f30e8/uploads/origins/3bceb5b4-afc7-4ad9-be24-c023d871a84e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7acd5b5e72e1b289b81df87f88c162d4 2x, https://si.imgix.net/0a0f30e8/uploads/origins/3bceb5b4-afc7-4ad9-be24-c023d871a84e?bg=%23fff&auto=f