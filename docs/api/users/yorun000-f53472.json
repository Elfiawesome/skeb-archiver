ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de33040067bde1a4ed3bee5be3f58694", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907062465424474112%2FvZVtOoy8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de33040067bde1a4ed3bee5be3f58694, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907062465424474112%2FvZVtOoy8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=318fc037355e7d150804d66403b04c03 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907062465424474112%2FvZVtOoy8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6ea6d465043303c1f401aaf54d97e38 3x", "genre": "voice", "nsfw": false, "body": "こんにちは、私はあなたの声が大好きです。あなたが職場の先輩で、私に壁ドンして告白するシナリオを声優してほしいです。私のことをどれだけ尊敬しているか、私がどれだけ赤くなったかを指摘するような、自信に満ちた口調で話してほしいです。その後、今夜は日本酒を飲みに行きたいと言ってください。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yorun000/works/3", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907062465424474112%2FvZVtOoy8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a7a9eb67bcd73bb3160aff552180164", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907062465424474112%2FvZVtOoy8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a7a9eb67bcd73bb3160aff552180164, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907062465424474112%2FvZVtOoy8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=