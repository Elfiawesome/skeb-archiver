7bc3d53/uploads/origins/09df89ea-9cc5-4f79-81c0-67efaa63d44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e902dbbc95347daf774a7b3ae9d1d9d 2x, https://si.imgix.net/97bc3d53/uploads/origins/09df89ea-9cc5-4f79-81c0-67efaa63d44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49d7c71a5d1eb0cf6052f4323ea377f2 3x", "genre": "art", "nsfw": false, "body": "らたとさんこんにちは！\nらたとさんの描くドラゴンさんカッコいいですね！\nなのでうちの子ドラゴン化をお願いしたいです！\nどんな感じのドラゴンにするか、他にも衣装やポーズやシチュエーションなどは自由にしてください！\nよろしくお願いします！\n\n\nhttps://twitter.com/kohakusatera/status/1470411379861770240?s=20&t=M9N1i11Hnw9IobGN6jszLQ\n　\nhttps://drive.google.com/drive/folders/1hRt7_L2fU7WJJBvlnD1JiOBaSb99IHK8?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Kam_Unagi28/works/1", "thumbnail_src": "https://si.imgix.net/2d87d6ee/uploads/origins/abbacb85-c251-4259-8ea3-aceea5b3f154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff29b06c22c2e6bc2b4edd0fa4a5d316", "thumbnail_srcset": "https://si.imgix.net/2d87d6ee/uploads/origins/abbacb85-c251-4259-8ea3-aceea5b3f154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff29b06c22c2e6bc2b4edd0fa4a5d316, https://si.imgix.net/2d87d6ee/uploads/origins/abbacb85-c251-4259-8ea3-aceea5b3f154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5701d6294d4cbaa71371677adba3ad54 2x, https://si.imgix.net/2d87d6ee/uploads/origins/abbacb85-c251-4259-8ea3-aceea5b3f154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d96a301f50aa6dcd6e042110325cc72c 3x", "genre": "art", "nsfw": false, "body": "I would like to see your interpretation of my cat-succubus, Sedire, drawn as a dragon in your style. You have full freedom in how to draw her in that form!\n\nhttps://imgur.com/a/kjK9cVp", "created_at": "", "completed_at": ""}]}