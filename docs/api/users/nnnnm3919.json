M4Yd2lBK6RoEVqsX_eUdQSuPi6265Wkp\n\nポーズや構図はお任せします。\n\n那行様の素敵な絵柄で我が最推しOCであるシラヌイさんを見てみたく思います。\n\n良ければご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nnnnm3919/works/23", "thumbnail_src": "https://si.imgix.net/8ee6d08a/uploads/origins/a4dac621-4fa2-478b-b8fc-fc8d107b527c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9285400e805403d41abc9eaaacbee822", "thumbnail_srcset": "https://si.imgix.net/8ee6d08a/uploads/origins/a4dac621-4fa2-478b-b8fc-fc8d107b527c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9285400e805403d41abc9eaaacbee822, https://si.imgix.net/8ee6d08a/uploads/origins/a4dac621-4fa2-478b-b8fc-fc8d107b527c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fe4676fd046c2b0b78fd94519cfa73c 2x, https://si.imgix.net/8ee6d08a/uploads/origins/a4dac621-4fa2-478b-b8fc-fc8d107b527c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b375866a8d63c2c4aea5d5fc3c366887 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵、本当に可愛いです！私のオリジナルキャラクターを描いていただけませんか？どんなポーズでもお好きなように描いてください！よろしくお願いします。お断りされる場合も、どんな理由でも遠慮なくお申し付けください！\n\nhttps://drive.google.com/drive/folders/1-bGwJBodXwQmDPsDKM4lWIOSHIbfXW21", "created_at": "", "completed_at": ""}, {"path": "/@nnnnm3919/works/22", "thumbnail_src": "https://si.imgix.net/f99cd995/uploads/origins/253f9d57-59f8-4f6b-a19f-968a41d60ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b4a2d53bf62d5962817d1c1eccb7e6", "thumbnail_srcset": "https://si.imgix.net/f99cd995/uploads/origins/253f9d57-59f8-4f6b-a19f-968a41d60ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b4a2d53bf62d5962817d1c1eccb7e6, https://si.imgix.net/f99cd995/uploads/origins/253f9d57-59f8-4f6b-a19f-968a41d60ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93fc1c58474f1636ca993a99298dbb46 2x, https://si.imgix.net/f99cd995/uploads/origins/253f9d57-59f8-4f6b-a1