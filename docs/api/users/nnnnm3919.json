-6bbcc6073dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e7d3cb5b7f183bb7212697821dc656a", "thumbnail_srcset": "https://si.imgix.net/2f8fa213/uploads/origins/57e807c1-b1a0-4ea6-8c94-6bbcc6073dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e7d3cb5b7f183bb7212697821dc656a, https://si.imgix.net/2f8fa213/uploads/origins/57e807c1-b1a0-4ea6-8c94-6bbcc6073dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0505b9794b92cff641d565e02055ce2c 2x, https://si.imgix.net/2f8fa213/uploads/origins/57e807c1-b1a0-4ea6-8c94-6bbcc6073dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feac327d3af489b00bfc990b7e8f71fe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きです！\n私のキャラクターを描いてもらえませんか？\n彼女はビデオゲーム \"ROBLOX \"から抜け出せない少女の魂です。\n身長は128cmで、とても小さくて子供のようです！\n彼女はよく天使のように穏やかですが、彼女の意図や思考はいつも暴力的だったり、心配性だったりするようです。\n\nキャラクター\nhttps://drive.google.com/drive/folders/1HXPnbXJEvH6yD_TFvZC1GAprw6zFKDqB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nnnnm3919/works/14", "thumbnail_src": "https://si.imgix.net/8487f6c1/uploads/origins/1e3c8622-ef9f-42d4-97d0-116fcf5dc92d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bbd5ed5bbb38b0a395667158394ee60", "thumbnail_srcset": "https://si.imgix.net/8487f6c1/uploads/origins/1e3c8622-ef9f-42d4-97d0-116fcf5dc92d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bbd5ed5bbb38b0a395667158394ee60, https://si.imgix.net/8487f6c1/uploads/origins/1e3c8622-ef9f-42d4-97d0-116fcf5dc92d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb61a70e774bfcf3499e6680c9f9c569 2x, https://si.imgix.net/8487f6c1/uploads/origins/1e3c8622-ef9f-42d4-97d0-116fcf5dc92d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f46f2f525529480ae1503e0aae70da39 3x", "genre": "art", "nsfw": false, "body": "那行様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n那行様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "created_at": "", "completed_at": ""}, {"path": "/@nnnnm3919/works/13", "thumbnail_src": "https://si.imgix.net/1a54f397/uploads/origins/099087c2-c09b-463c-9c34-f5e64ffc10d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b29c5053b49a2d796bf92d7812773e4b", "thumbnail_srcset": "https://si.imgix.net/1a54f397/uploads/origins/099087c2-c09b-463c-9c34-f5e64ffc10d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b29c5053b49a2d796bf92d7812773e4b, https://si.imgix.net/1a54f397/uploads/origins/099087c2-c09b-463c-9c34-f5e64ffc10d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=221724bdeb636b6b5a2e3eddf64756a8 2x, https://si.imgix.net/1a54f397/uploads/origins/099087c2-c09b-463c-9c34-f5e64ffc10d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c61c8dde9b87370a98e194d1577cd7c 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n\n絵柄が可愛いなと思いまして、リクエスト失礼いたします。添付資料の女の子で一枚描いていただけないでしょうか？\n\n他につきましては指定はございませんので、お任せします。\n\n※資料のキャラクター(OC)については、skebのお題利用OKと許可を得た上でskimaにて購入したキャラクターです。\n\nhttps://drive.google.com/drive/folders/14eVT7xhKzwKyS17g7zuQKq2DfHSV07VL", "created_at": "", "completed_at": ""}, {"path": "/@nnnnm3919/works/12", "thumbnail_src": "https://si.imgix.net/d5ecfe61/uploads/origins/a84795ef-2502-4210-878c-f208aae5455e?bg=%23fff&auto=format%2Ccompress&f