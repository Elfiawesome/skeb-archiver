由の多彩な関節技を受けてかなり消耗している状態。\n真由のロメロスペシャルが完璧に決まり悶絶している結衣。技を決めながら余裕のある表情で結衣を煽る言葉を投げかける真由、という感じでお願いします。\n\n台詞\n真由｢結衣、オネンネするのはまだ早いんじゃないの？もっと考えて戦わないといつまでたっても私に勝てないよ！｣\n\n以上の内容となります。ご検討の方をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@112073N/works/64", "thumbnail_src": "https://si.imgix.net/f69c5418/uploads/origins/7a3ec12a-d160-4a19-9cb8-e3131c092665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59d3ee35e527e0778f9ab0f70426e1bc", "thumbnail_srcset": "https://si.imgix.net/f69c5418/uploads/origins/7a3ec12a-d160-4a19-9cb8-e3131c092665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59d3ee35e527e0778f9ab0f70426e1bc, https://si.imgix.net/f69c5418/uploads/origins/7a3ec12a-d160-4a19-9cb8-e3131c092665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd82b01475a33db993898a7a669f4b7c 2x, https://si.imgix.net/f69c5418/uploads/origins/7a3ec12a-d160-4a19-9cb8-e3131c092665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a8d822cecc41ac120de709087e3170e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@112073N/works/63", "thumbnail_src": "https://si.imgix.net/16560f16/uploads/origins/588b311f-0b34-44b9-836e-64ba8c1e98f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f3397e1212eff2afce556a05b0eb941", "thumbnail_srcset": "https://si.imgix.net/16560f16/uploads/origins/588b311f-0b34-44b9-836e-64ba8c1e98f0?bg=%23fff&auto=format%2Ccom