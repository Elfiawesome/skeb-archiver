%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51871b559c6ded0810b013a1eac0759f 3x", "genre": "art", "nsfw": true, "body": "キングスレイドのオペリア(ウェディングコス)をお願いします。\nhttps://pbs.twimg.com/media/E71d7xjVIA06Y8I?format=jpg&name=4096x4096\n\n竿役は全裸のショタで、丸坊主か同作のレオの髪型でお願いします。\nhttps://wikiwiki.jp/kings-raid/レオ\n\n・正常位でのおねショタセックスの事後で、結合部が繋がったままの状態になっている\n・スカートをめくり上げて股間が見えている状態\n・パンツは脱がすかずらした状態で恥部が露出、中出しで結合部から大量の精液が漏れている\n・股間以外は着衣の状態\n・ショタは巨乳の谷間に顔を埋めて、それぞれの手で両胸を鷲掴みにしている\n・オペリアはショタの身体に手を回して、口を閉じて恍惚な感じで微笑んでいる表情をしている\n\n以下差分は、可能であればお願いします。\n・両目を閉じて口元が垂れ下がり、力尽きてぐったりした感じの表情\n\n以上となります。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/32", "thumbnail_src": "https://si.imgix.net/952e7dd0/uploads/origins/833afefa-68c6-4388-99c7-5b935f78e927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c05924360f411d238eaf4d53fb26d24", "thumbnail_srcset": "https://si.imgix.net/952e7dd0/uploads/origins/833afefa-68c6-4388-99c7-5b935f78e927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c05924360f411d238eaf4d53fb26d24, https://si.imgix.net/952e7dd0/uploads/origins/833afefa-68c6-4388-99c7-5b935f78e927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebb356b8e5bd987b0cae8f922c40c90d 2x, https://si.imgix.net/952e7dd0/uploads/origins/833afefa-68c6-4388-99c7-5b935f78e927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e2b4ebc1ecc021019902d427ea0a99c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/31", "thumbnail_src": "https://si.imgix.net/51a94ecf/uploads/origins/1421511e-4524-41c5-b0e0-b8cc995c369c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8dd18d0c95bb9cccea376ba9f4593e", "thumbnail_srcset": "https://si.imgix.net/51a94ecf/uploads/origins/1421511e-4524-41c5-b0e0-b8cc995c369c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8dd18d0c95bb9cccea376ba9f4593e, https://si.imgix.net/51a94ecf/uploads/origins/1421511e-4524-41c5-b0e0-b8cc995c369c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a8448893afe9a2e9457da4352ba09fc 2x, https://si.imgix.net/51a94ecf/uploads/origins/1421511e-4524-41c5-b0e0-b8cc995c369c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93bf764e5935f042eabd338a4c826509 3x", "genre": "art", "nsfw": true, "body": "さらとが様、はじめまして\n絵柄に惹かれてリクエストいたします\n\n■キャラクター\nソシャゲ『放置少女』より周泰\n(格好は『電車内の風景』準拠で)\n\n■シチュエーション\n制服タイツ姿で凌辱される\n\n脚を抱えたまんぐり返しの体位で\n・恥じらいながら破れタイツで秘所を広げる\n・涙目でちんぽを受け入れる\n・レイプ目で中出しされた精子が滴り落ちる\nなどのシーンがあれば嬉しいです\n\n体位は以前お描きになられたシャオユウの\nこのような感じで\nhttps://www.pixiv.net/artworks/101251052\n竿役の描写は不要です\n\n以下資料です\n\nガチャ画面\nhttps://www.houti-wiki.com/index.php?plugin=attach&refer=副将画像保管庫&openfile=AAA98電車内の風景周泰.jpg\n\nムービー\nhttps://twitter.com/kLVWSpb0BueIkWA/status/1592502757445238784\n\n体付きは大人っぽいガチャ画面をベースに\n表情はムービーぽくして頂ければ幸いです\n\nもし興味を惹かれましたらご承認\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/30", "thumbnail_src": "https://si.imgix.net/b5366e68/uploads/origins/6346714f-cc89-4f36-9f9b-b4d2d7297007?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a937cb4d73be7a7209b017e1294d4230", "thumbnail_srcset": "https://si.imgix.net/b5366e68/uploads/origins/6346714f-cc89-4f36-9f9b-b4d2d7297007?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a937cb4d73be7a7209b017e1294d4230, https://si.imgix.net/b5366e68/uploads/origins/6346714f-cc89-4f36-9f9b-b4d2d7297007?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5d3b2c43aabc46eeb217205f7d1e1be 2x, https://si.imgix.net/b5366e68/uploads/origins/6346714f-cc89-4f36-9f9b-b4d2d7297007?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c29a62a7103631953b2adc5231f31c2 3x", "genre": "art", "nsfw": true, "body": "こんにちは！可愛くて小柄なエルフのお姫様が誘拐されているイラストをフルでお願いします！バリエーションは1種類でお願いします。\n\nシナリオは、灯りのついた人里離れた小屋で展開される。王女はフリルのついたドレスで可憐なポーズをとっているが、片方の腕は横から、もう片方は背中から盗賊に掴まれている。もう一人の盗賊がクロロホルムの布を彼女の顔に押し付けています。表情はあなた次第です。\n\n両腕を下げて背中に固定し、鼻と口から布を外す途中の、完全に眠った状態のものが変形版です。エルフのお姫様のデザインは、完全に自由にしてください。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/29", "thumbnail_src": "https://si.imgix.net/775c66e1/uploads/origins/742417f8-f314-4177-8888-a499a34ad9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb02556d0a60476dbbc8ea744b418e7d", "thumbnail_srcset": "https://si.imgix.net/775c66e1/uploads/origins/742417f8-f314-4177-8888-a499a34ad9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb02556d0a60476dbbc8ea744b418e7d, https://si.imgix.net/775c66e1/uploads/origins/742417f8-f314-4177-8888-a499a34ad9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19fad995a78d0044ff0778395186f79c 2x, https://si.imgix.net/775c66e1/uploads/origins/742417f8-f314-4177-8888-a499a34ad9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef3c9ab56c55e89d76db24af345b4a18 3x", "genre": "art", "nsfw": true, "body": "初めまして！\nリクエストよろしくお願いします！\n\nキャラクター：麻宮アテナ（KOFシリーズ）\nhttps://www.snk-corp.co.jp/official/kof-xv/characters/characters_athena.php（KOF15公式サイトから、ナンバリングによって見た目変わるのでこちらの姿でお願いします）\n\nシチュエーション：試合に敗北してそのまま犯されてしまうシチュエーションでお願いします。\n以前描かれていたシーダ（https://www.pixiv.net/artworks/100855764）のように腕を押さえつけられ、涙を流しながら必死に拒絶するも逃げられずに挿入→中出しで。\n\n以上です。\nご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/28", "thumbnail_src": "https://si.imgix.net/f515e349/uploads/origins/1ab3b1c2-5de5-47a6-bda0-3dcb5d5d40b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e922493bcb03452ca671d530d4a03aa", "thumbnail_srcset": "https://si.imgix.net/f515e349/uploads/origins/1ab3b1c2-5de5-47a6-bda0-3dcb5d5d40b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e922493bcb03452ca671d530d4a03aa, https://si.imgix.net/f515e349/uploads/origins/1ab3b1c2-5de5-47a6-bda0-3dcb5d5d40b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c181740f0c65d1f5dce14c616213241 2x, https://si.imgix.net/f515e349/uploads/origins/1ab3b1c2-5de5-47a6-bda0-3dcb5d5d40b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d17c0ec7fef8f6d71ba32a415458822d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/27", "thumbnail_src": "https://si.imgix.net/3174bde1/uploads/origins/729bdef7-a1ed-424c-a348-cd26990c9f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58bb9cf5a4df1f692b928fa9e1349f0f", "thumbnail_srcset": "https://si.imgix.net/3174bde1/uploads/origins/729bdef7-a1ed-424c-a348-cd26990c9f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58bb9cf5a4df1f692b928fa9e1349f0f, https://si.imgix.net/3174bde1/uploads/origins/729bdef7-a1ed-424c-a348-cd26990c9f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=805826f59212fa895aa90d35a878da64 2x, https://si.imgix.net/3174bde1/uploads/origins/729bdef7-a1ed-424c-a348-cd26990c9f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1d85e25f21abbd041de9cf19b154dda 3x", "genre": "art", "nsfw": true, "body": "初めまして、あなた様のシニシスタ絵を見てこの依頼を送りします\n\n内容はシニシスタ無印『聖職者の悪夢』ステージ冒頭、ラビアンは上位存在に肉繭に閉じ込められたシチュを、『ラビアンとシニシスタ2のリーリア2人同時肉繭にぎゅうぎゅう詰め込まれ、服は液体に所々溶かされ苦しく喘ぐの様子』を頼みたいです\n\n余力があれば、差分はラビアンとリーリアが裸になったり、口の中や膣に触手ぶち込まれたりのもお願いします\n\n以上の内容、宜しければどうぞよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/26", "thumbnail_src": "https://si.imgix.net/d4477ce4/uploads/origins/52e89486-0416-4b65-9478-363717ff8c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=505e04959f44f4796b5c3044991a32d0", "thumbnail_srcset": "https://si.imgix.net/d4477ce4/uploads/origins/52e89486-0416-4b65-9478-363717ff8c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=505e04959f44f4796b5c3044991a32d0, https://si.imgix.net/d4477ce4/uploads/origins/52e89486-0416-4b65-9478-363717ff8c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53c0f7976b32d4603be5efb524df7bb7 2x, https://si.imgix.net/d4477ce4/uploads/origins/52e89486-0416-4b65-9478-363717ff8c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c326152c35ae1308f28b753a71801b6b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/25", "thumbnail_src": "https://si.imgix.net/d79c03ec/uploads/origins/e5e7b2ce-2b71-43dc-8d93-1129bab0722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd89182cd92f529a539f7d9fc3a6989", "thumbnail_srcset": "https://si.imgix.n