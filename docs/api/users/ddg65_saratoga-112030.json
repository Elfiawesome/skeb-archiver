t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a374406f8660949a42f88ed0a00d4e3 2x, https://si.imgix.net/fcf5cce4/uploads/origins/17d68dfb-08ca-4c9e-b0c9-5d7273dbd330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1745a9186e2f771d9b19c75375a2923d 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n以前描かれたトトリ先生やよその子のイラストがとっても良かったので、\n依頼させていただければと思います。（金額調整可能です）\n\n①BLUE REFLECTIONより、白井日菜子（変身姿）のえっちイラスト\n　・拾い物ではありますが、参考資料に公式絵など配置しております\n②構図については、以前描かれたトトリ先生やよその子（参考資料）のような感じでお願いします\n　・体部分などは流用でも新規でもどちらでもOKです\n　・手で口を押える差分は無くても大丈夫です\n　・服は必要に応じて脱がすor破るなどしていただければと思います\n　・パンツはずらし挿入だと嬉しいです\n　・竿役はお任せいたします\n③表情については、以前描かれたトトリ先生とミミちゃん（参考資料）の\n　トトリ先生の各表情が凄く好みだったので似たような感じにしてもらえると嬉しいです\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1U9wm5zVNpihgfev5fTUnMHUyaaUeRNJ8", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/39", "thumbnail_src": "https://si.imgix.net/ee284861/uploads/origins/64eee2ce-79ee-462a-be63-9e3d4ee34a15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=accfd09cab9320ba5eba57aa7037f332", "thumbnail_srcset": "https://si.imgix.net/ee284861/uploads/origins/64eee2ce-79ee-462a-be63-9e3d4ee34a15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=accfd09cab9320ba5eba57aa7037f332, https://si.imgix.net/ee284861/uploads/origins/64eee2ce-79ee-462a-be63-9e3d4ee34a15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f17a1ea6b0f4e138e933802569efa5bc 2x, https://si.imgix.net/ee284861/uploads/origins/64eee2ce-79ee-462a-be63-9e3d4ee34a15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e4690b60260a7ebe64bb079ba38aede 3x", "genre": "art", "nsfw": true, "body": "こんにちは、始めまして。\n版権物ですが、もし可能でしたらリクエストさせてください。\nご都合が合わなかったり内容や作業量的に合わない際は気軽にキャンセル下さい。\n\nキャラクター：\n・[崩壊：スターレイル]より ゼーレ にてお願いします\n　https://wiki.hoyolab.com/pc/hsr/entry/15\n・可能でしたらポニーテールの髪型でお願いします\n\n描いて頂きたい衣装：\n・スターピースカンパニーの平社員が来ている様な服をお願いします\n　https://wiki.hoyolab.com/pc/hsr/entry/1590\n\n描いて頂きたいシチュエーション：\n・ゼーレが見世物にされてる様な形で、透明な壁に手を付きながら立ちバックで犯されてるシチュエーションをお願いします\n　※体位や構図は描きやすい様に変更頂いてもかまいません", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/38", "thumbnail_src": "https://si.imgix.net/c2b3cdcc/uploads/origins/7c9c7527-720a-4595-b7c9-007d1913f1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a97003e488096cce6f775ce80cefb79", "thumbnail_srcset": "https://si.imgix.net/c2b3cdcc/uploads/origins/7c9c7527-720a-4595-b7c9-007d1913f1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a97003e488096cce6f775ce80cefb79, https://si.imgix.net/c2b3cdcc/uploads/origins/7c9c7527-720a-4595-b7c9-007d1913f1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e14c0917c343ce55dc7287e415420f71 2x, https://si.imgix.net/c2b3cdcc/uploads/origins/7c9c7527-720a-4595-b7c9-007d1913f1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d54ddf0d5780770d18e588186f522f4 3x", "genre": "art", "nsfw": true, "body": "初めましてのリクエストになります。黎の軌跡からアニエス・クローデル嬢をお願い致します。\n　衣装は学園の制服。シチュエーションは「梯子を登る途中のパンモロ」です。\n　基本の構図は資料動画の通りです。 \n　これをもっと人物にズームアップし、かつパンツの刺繍（+リボン）が見える最大限まで拡大して貰えればと。\n　パンツは私服VER（水色の生地は変わらず、リボンのみが黒い）を穿かせて下さい\n　表情はこちらを「どうしました？」と若干キョトンとした感じで覗いている風に。\n　背景は原作通りで良いでしょう。\n　なおこちらの名前を含む文字の類は一切なし。\n　軌跡シリーズを近日見知った初心者のリクエスト　お聞き届け願えれば幸いです。\n\nhttps://youtu.be/liPfUvRt3rc?si=2ugf0guZSGMGuGqj", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/37", "thumbnail_src": "https://si.imgix.net/b43fe8f3/uploads/origins/43e9a9e5-f79e-4176-9bfd-cc843841c7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c15e0db059a6f0e303f22986551c7e", "thumbnail_srcset": "https://si.imgix.net/b43fe8f3/uploads/origins/43e9a9e5-f79e-4176-9bfd-cc843841c7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c15e0db059a6f0e303f22986551c7e, https://si.imgix.net/b43fe8f3/uploads/origins/43e9a9e5-f79e-4176-9bfd-cc843841c7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da14e4388bf94af5740138134abb1a51 2x, https://si.imgix.net/b43fe8f3/uploads/origins/43e9a9e5-f79e-4176-9bfd-cc843841c7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a58a3bcdaf87b78aaf5e4e3befa6e7b1 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させて頂きます。\n「ファイアーエムブレム聖魔の光石」のエイリークを下記URLのFEH総選挙の服装で依頼させてください。髪で見えにくいですが耳にピアス付けています。\nhttps://guide.fire-emblem-heroes.com/07001001000698-2/\n\n資料URLのような、壁や窓に手をついて上げた片足を持たれて挿入される立ち側位のような体位で男性とセックスさせてください。エイリークの顔は男性側が見えるように、足は上げすぎない様に曲げた膝が見えるくらいをお願いします。\nシチュは和姦でお願いします。探索任務の途中宿で同行してる男性とエッチな話題になり興味はありますと話して体験してみますかと迫られ、そのまま押し切られてしまう…のような、エイリークの気持ちが変わる前にと服着たままセックスしはじめてるイメージです。\n足を上げてミニスカート部分がめくれパンツが丸見えになった不安そうな様子から男性器を見せつけられ驚きつつ見つめてしまったりしてからパンツをずらして挿入される様子、最初は苦しかったけど気持ち良くなり絶頂＆射精している様子、精液垂らしてる事後の様子をお願いできればと思います。\n室内なので兜やマントは描きにくい様であれば外して頂いても構いません。髪型はポニテのまま描いてください。\nよろしければ以前描かれていたシーダのような、装備を付けたまま状態と装備品やパンツを外して露出させた半脱ぎ状態を希望させてください。鎧の下の資料がないですが、服の金色の線の部分から開けたり等して描いて頂けたらと思います\n以上、よろしければお願いします。\n\nhttps://www.dropbox.com/scl/fi/ty0kjqkvkbyrbsgw31cpp/2.JPG?rlkey=86bp1pcdnsl2ok4pu2htd28gk&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/36", "thumbnail_src": "https://si.imgix.net/e601334b/uploads/origins/68c43fa7-8d56-4c36-b31c-7cd5c3f85851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a4a2f4b023dd5de580152fe05651a8c", "thumbnail_srcset": "https://si.imgix.net/e601334b/uploads/origins/68c43fa7-8d56-4c36-b31c-7cd5c3f85851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a4a2f4b023dd5de580152fe05651a8c, https://si.imgix.net/e601334b/uploads/origins/68c43fa7-8d56-4c36-b31c-7cd5c3f85851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2be454e9490e7e854a5ed452b70662c7 2x, https://si.imgix.net/e601334b/uploads/origins/68c43fa7-8d56-4c36-b31c-7cd5c3f85851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=598121a4f346264f2ae2c61a8ccbc1f0 3x", "genre": "art", "nsfw": true, "body": "リクエストの方を送らせていただきます\n\nキャラ：ホロライブAdventのフワモコ（フワワ・アビスガード、モココ・アビスガード）の二人\nシチュエーション：胸を露出させた半脱ぎの状態（上着はありでお願いします）でファンに犯されてるところをお願いできればと思います。\nモココのホットパンツについては脱ぎ掛けのものが片足に残ってる感じでお願いできればと思います。\n表情としてはフワワは涙を流しながら怯えており、モココは涙目になりながら相手を睨んでる感じでお願いします。\n\nまた、金額内で可能であれば以下の差分もお願いできればと思います。\n・挿入前\n・挿入中\n・中出し\n・中出し後にペニスを抜かれて精液を垂らしている所\n\n資料：\nhttps://hololive.hololivepro.com/talents/fuwawa-abyssgard/\nhttps://hololive.hololivepro.com/talents/mococo-abyssgard/\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/35", "thumbnail_src": "https://si.imgix.net/a9f5873b/uploads/origins/09acfcd8-16c0-459b-a668-086a80ad0e26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2046adf919347f7d40604034b728e253", "thumbnail_srcset": "https://si.imgix.net/a9f5873b/uploads/origins/09acfcd8-16c0-459b-a668-086a80ad0e26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2046adf919347f7d40604034b728e253, https://si.imgix.net/a9f5873b/uploads/origins/09acfcd8-16c0-459b-a668-086a80ad0e26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=200f6ff8366f2f776ab1332c0778e51e 2x, https://si.imgix.net/a9f5873b/uploads/origins/09acfcd8-16c0-459b-a668-086a80ad0e26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ee19dc99159026c3f43891abcfa6308 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ddg65_saratoga/works/34", "thumbnail_src": "https://si.