0e/uploads/origins/48c0abe3-4318-476b-bf90-eda02267c4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e06ed28a7d27e6aaceeaf4d00cbfe4c3 2x, https://si.imgix.net/eb96d20e/uploads/origins/48c0abe3-4318-476b-bf90-eda02267c4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f2243e860552ea6d18637decce11cd4 3x", "genre": "art", "nsfw": false, "body": "はらいさんこんにちは！\n先日は素敵な絵をありがとうございました。イケメンオーラ満載のパイジェッロ先生が見れて最高でした！\nさて、今回のリクエストなんですが絶対帝国の法皇サリエルの世界に登場するロッシーニの漫画的なものをお願いできますでしょうか？\nお忙しいところ大変恐縮ですがお受けしていただけると嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@harai_kei/works/9", "thumbnail_src": "https://si.imgix.net/cc5932bd/uploads/origins/b1455e4e-1f79-4d9f-a58a-f21acf96e39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d077a0bfc886e5da29d4b7114851f079", "thumbnail_srcset": "https://si.imgix.net/cc5932bd/uploads/origins/b1455e4e-1f79-4d9f-a58a-f21acf96e39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d077a0bfc886e5da29d4b7114851f079, https://si.imgix.net/cc5932bd/uploads/origins/b1455e4e-1f79-4d9f-a58a-f21acf96e39d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06ef5d073d806667ba131ee952cd7b1e 2x, https://si.imgix.net/cc5932bd/uploads/origins/b1455e4e-1f79-4d9f-a58a-f21acf96e39d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dd8cf30d70c420154b5ba6c99f03dfb 3x", "genre": "art", "nsfw": false, "body": "宇宙をテーマにしたものを描いてください！思い思いのまま描いてください！！抽象画でもキャラクターでも背景でもなんでも大丈夫です！！貴方の宇宙が見てみたいです！", "created_at": "", "completed_at": ""}, {"path": "/@harai_kei/works/8", "thumbnail_src": "https://si.imgix.net/559f8cb6/uploads/origins/c7e5e7b7-5d24-45b9-b626-7fd10432cfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af846a8036479ea06b1151cae1a1caee", "thumbnail_srcset": "https://si.imgix.net/559f8cb6/uploads/origins/c7e5e7b7-5d24-45b9-b626-7fd10432cfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af846a8036479ea06b1151cae1a1caee, https://si.imgix.net/559f8cb6/uploads/origins/c7e5e7b7-5d24-45b9-b626-7fd10432cfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56dec4e538be7eaaf92ae8bb01e16c47 2x, https://si.imgix.net/559f8cb6/uploads/origins/c7e5e7b7-5d24-45b9-b626-7fd10432cfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b604f1ae714e141c6a58acf26d60067b 3x", "genre": "art", "nsfw": false, "body": "いつもこっそり拝見しております。\n中華風な絵が好きなので暗景さんの絵で中華な絵を見たいなと思い、リクエストお送りさせていただきました…！\n『男性』と『中華風』テーマでイラストを一枚お願いできますでしょうか？\n(Skeb利用初めてでいろいろよくわかっていないのですが大丈夫でしょうか…よろしくお願いいたします！)", "created_at": "", "completed_at": ""}, {"path": "/@harai_kei/works/7", "thumbnail_src": "https://si.imgix.net/cc54a49e/uploads/origins/b14ef1b1-a73e-4d30-8c21-fa6fa0abe697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a924452c3c4e656f83a554620a924b44", "thumbnail_srcset": "https://si.imgix.net/cc54a49e/uploads/origins/b14ef1b1-a73e-4d30-8c21-fa6fa0abe697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a924452c3c4e656f83a554620a924b44, https://si.imgix.net/cc54a49e/uploads/origins/b14ef1b1-a73e-4d30-8c21-fa6fa0abe697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d9cc52aca97c0359e2702f0070a4cc7 2x, https://si.imgix.net/cc54a49e/uploads/origins/b14ef1b1-a73e-4d30-8c21-fa6fa0abe697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d02b9ecdc3c6882c9cbba762c399f43e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！大戸はさみです！\nこの前は会話ありがとうございます😊\nさっそくドラゴンのイラストを依頼させてください！\nドラゴンと女性(20代くらい？)が仲良くしている場面でお願いします。\nドラゴンは黄色か金色系で、所々に赤、緑、青、等の宝石っぽい鱗がある感じです。用はゴージャス系です。体型はしなやかなイメージです。\nもし目が描写できるのならば、白味のある紫の目で描いてください。\n\n女性は桜色の髪をおさげにして、冒険家のような服を着ている感じです。\n背景はちゃそさんの得意な背景で大丈夫です！\n指定があった方がやりやすいならば、「大きな古い教会っぽい廃墟」もしくは「だだっ広い、採掘場っぽい何処か」でお願いします。\n\n絵の使用の用途としては、A3のサイズで印刷して壁に飾るつもりでいるので、高画質でお願いします🤲。", "created_at": "", "completed_at": ""}, {"path": "/@harai_kei/works/6", "thumbnail_src": "https://si.imgix.net/f8379523/uploads/origins/95311f6c-647c-4360-9604-64d2935fded4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df400f8c8c50acc68c4bf1ce8b4b48e", "thumbnail_srcset": "https://si.imgix.net/f8379523/uploads/origins/95311f6c-647c-4360-9604-64d2935fded4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df400f8c8c50acc68c4bf1ce8b4b48e, https://si.imgix.net/f8379523/uploads/origins/95311f6c-647c-4360-9604-64d2935fded4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ace736799dbc7c920987f18410a45a4d 2x, https://si.imgix.net/f8379523/uploads/origins/95311f6c-647c-4360-9604-64d2935fded4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36bc1f86c2789740b4340c049847653e 3x", "genre": "art", "nsfw": false, "body": "シンドラーがベートーヴェンに泣かされてる絵が見たいです！ちゃそさんちのフォーリナーベトすごいカッコいいので出来たらフォーリナーベトで…よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@harai_kei/works/5", "thumbnail_src": "https://si.imgix.net/c1b64b69/uploads/origins/4300fdce-2f72-4b20-b05d-8d986f9e03db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47295de8c1b33a117d86ec60893b179", "thumbnail_srcset": "https://si.imgix.net/c1b64b69/uploads/origins/4300fdce-2f72-4b20-b05d-8d986f9e03db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47295de8c1b33a117d86ec60893b179, https://si.imgix.net/c1b64b69/uploads/origins/4300fdce-2f72-4b20-b05d-8d986f9e03db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0990f2d19a3a16031abf83a2bbe16229 2x, https://si.imgix.net/c1b64b69/uploads/origins/4300fdce-2f72-4b20-b05d-8d986f9e03db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b30c4887c5462617ca9fb476fd49209 3x", "genre": "art", "nsfw": false, "body": "「スチームパンクなかぐや姫(性別は問いません)」というテーマで自由に描いていただけたら嬉しいです！", "created_at": "", "