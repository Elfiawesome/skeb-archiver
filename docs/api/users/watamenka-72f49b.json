ix.net/b36e7fa8/uploads/origins/8d3ae427-ad70-4d28-aaa4-94cb3065f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f118feabd567dd5ddbb65378957ccc", "thumbnail_srcset": "https://si.imgix.net/b36e7fa8/uploads/origins/8d3ae427-ad70-4d28-aaa4-94cb3065f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f118feabd567dd5ddbb65378957ccc, https://si.imgix.net/b36e7fa8/uploads/origins/8d3ae427-ad70-4d28-aaa4-94cb3065f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95a180fd5e13bbcf372dd1211ed9d77d 2x, https://si.imgix.net/b36e7fa8/uploads/origins/8d3ae427-ad70-4d28-aaa4-94cb3065f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b663e0ff42f258ff3d2f8b4f83c3509 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のvtuberキャラクター(https://imgur.com/a/9oMfij7)のイラストをお願いしたいと思います。性格は明るくて元気。歌うことが好きです。", "created_at": "", "completed_at": ""}, {"path": "/@watamenka/works/6", "thumbnail_src": "https://si.imgix.net/e21c2c08/uploads/origins/31f5af59-b90e-4089-b8d1-049dfec8b160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a7c6488e27e1afebb57f0cb87415ec", "thumbnail_srcset": "https://si.imgix.net/e21c2c08/uploads/origins/31f5af59-b90e-4089-b8d1-049dfec8b160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a7c6488e27e1afebb57f0cb87415ec, https://si.imgix.net/e21c2c08/uploads/origins/31f5af59-b90e-4089-b8d1-049dfec8b160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=768e2bde53d563b9dbd64660c90deafa 2x, https://si.imgix.net/e21c2c08/uploads/origins/31f5af59-b90e-4089-b8d1-049dfec8b160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb54252064ea2d56f13c011dcbf211df 3x", "genre": "art", "nsfw": false, "body": "Hi, I love your style! Could you draw my VTuber character? She's a kind, ojousama-type girl who loves books. I'd like her to look happy but otherwise you can choose the details yourself. I may use the image on Twitter, Twitch and Youtube. Thank you so much!\n\nhttps://drive.google.com/drive/folders/1HFnSsbTTElV9BBtRKVBo1OzS0YsJLUtO?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@watamenka/works/5", "thumbnail_src": "https://si.imgix.net/f7bc892d/uploads/origins/57a3e490-95d4-44be-8a3c-e76b9c9acc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da5a49cec8d6debfe061464515a98d04", "thumbnail_srcset": "https://si.imgix.net/f7bc892d/uploads/origins/57a3e490-95d4-44be-8a3c-e76b9c9acc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da5a49cec8d6debfe061464515a98d04, https://si.imgix.net/f7bc892d/uploads/origins/57a3e490-95d4-44be-8a3c-e76b9c9acc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74556a078894ec60947d84b9b5371488 2x, https://si.imgix.net/f7bc892d/uploads/origins/57a3e490-95d4-44be-8a3c-e76b9c9acc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=799d0e3d8cf6c1258b4c0e3fe319940d 3x", "genre": "art", "nsfw": false, "body": "It's a pleasure to meet you.\nI was scared by the look in your eyes here (https://skeb.jp/@watamenka/works/1).\n\nThis time, I would like to request you \"Mantangomu-chan\".\nI hope you will consider it.\n\nCharacter reference\n\"Mantangomu-chan\n(1) https://www.pixiv.net/artworks/77933600\n②https://twitter.com/superganglion/status/1221116225444438017?s=20\n\nThe main characteristics of the character are as follows.\nShe is thin and slender (her ribs seem to float a little, and her breasts are not so big).\nSlender, beautiful legs.\nSlender and beautiful legs\nHer eyes look unhealthy (a little dark circles)\nBeautiful legs\nIf you don't wear a hairpin, please wear a \"dangly beetle\" design somewhere in your coordination.\n\nIf you don't want to wear a hairpin, please put a \"Dango Mushi\" design somewhere on your coordination. Facial expressions, poses, and othe