9-b950-ab4072c55af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57bed742396622782d193e6ec85ede35, https://si.imgix.net/f686042b/uploads/origins/6e6b8032-76a6-4129-b950-ab4072c55af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b441f9abfc161bd22e672f61e6e3a23f 2x, https://si.imgix.net/f686042b/uploads/origins/6e6b8032-76a6-4129-b950-ab4072c55af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdaf083a9ab468b5f578385223d61c16 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵柄がすごく可愛いです！私のVTuberジャミーのイラストを依頼したいです。ジャミーはユニバン（ユニコーンとウサギのハーフ）で、人間になったキャラクターです。怠け者で心優しく、コーラと食べ物が大好きで遊び好きだけどおバカさん。アートと魔法の才能も抜群です。可愛い感じさえ出せれば、ポーズや表情は何でも構いません！ \n\nジャミーの特徴：・唇の上にほくろ・瞳のある目・一本の角・頭に耳・靴は履かず・ヘアクリップを二つ・どこに行くにも必ず靴下を履いています！https://drive.google.com/drive/folders/12JbFEQks5liM-RMdLy69qAZBZj9i1_3C?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/34", "thumbnail_src": "https://si.imgix.net/105f27cf/uploads/origins/907bd15e-f399-4a39-8557-6e5cc512aa67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3943fe6a2c7f09be03defe463d114fa2", "thumbnail_srcset": "https://si.imgix.net/105f27cf/uploads/origins/907bd15e-f399-4a39-8557-6e5cc512aa67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3943fe6a2c7f09be03defe463d114fa2, https://si.imgix.net/105f27cf/uploads/origins/907bd15e-f399-4a39-8557-6e5cc512aa67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d481732592f731979191c9047f35e664 2x, https://si.imgix.net/105f27cf/uploads/origins/907bd15e-f399-4a39-8557-6e5cc512aa67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f594e81e49b3c73b43839f212ecb6e1b 3x", "genre": "art", "nsfw": false, "body": "新しい衣装とムチムチ感見ました！\nとてもえっちです…\nうちのちゃんになも似たような衣装でムッチムチのω口にして欲しいです！髪留め₺ƾアクセサリーもお願いします！\nドヤ顔ダブルピースでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/33", "thumbnail_src": "https://si.imgix.net/72e798b7/uploads/origins/3e319856-6a9f-408d-9eb7-85891668e431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb2e1dd05f420d3b5a7e74bff1ab2510", "thumbnail_srcset": "https://si.imgix.net/72e798b7/uploads/origins/3e319856-6a9f-408d-9eb7-85891668e431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb2e1dd05f420d3b5a7e74bff1ab2510, https://si.imgix.net/72e798b7/uploads/origins/3e319856-6a9f-408d-9eb7-85891668e431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8cae165347401e255f70e0157aa48dc 2x, https://si.imgix.net/72e798b7/uploads/origins/3e319856-6a9f-408d-9eb7-85891668e431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d86de46c7c32a49276a7e21d4e17b423 3x", "genre": "art", "nsfw": false, "body": "元絵を参考に新年イラストみたいに、になちゃんをお願いします！\n幼女から少女風に！\n服装は小さのパーカー、ちょっと大きめなホットパンツ！\n服装の柄はおまかせで！\n太ももムチムチ系…育ち盛りだからね！\n目がキリッとしていてちょっとメス○キ風に！\n髪型は変わらず、前髪デコ出しで。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/32", "thumbnail_src": "https://si.imgix.net/11310382/uploads/origins/fafecc9d-0705-40e8-aa71-71969356fb11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c853320c158e3220e4554f994d440d71", "thumbnail_srcset": "https://si.imgix.net/11310382/uploads/origins/fafecc9d-0705-40e8-aa71-71969356fb11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c853320c158e3220e4554f994d440d71, https://si.imgix.net/11310382/uploads/origins/fafecc9d-0705-40e8-aa71-71969356fb11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b316ea264f6cdea2c4754a951107d29 2x, https://si.imgix.net/11310382/uploads/origins/fafecc9d-0705-40e8-aa71-71969356fb11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62bb2378370f5ca5c7f5069d6f3c07cd 3x", "genre": "art", "nsfw": false, "body": "最近暑くなってきたので水着イラストを2種類お願いします\n水着デザインおまかせになってしまうのですが水着なまろん栗子を描いてほしいです\n参考資料URL：https://twitter.com/kuriko_0929/status/1713436938592825421\n透過差分等PNG形式で納品お願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/31", "thumbnail_src": "https://si.imgix.net/b1423f32/uploads/origins/11b979d3-ad2f-4ca0-8c2b-629fa98ac8fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c478ccd93607d541e0175305d78c2e", "thumbnail_srcset": "https://si.imgix.net/b1423f32/uploads/origins/11b979d3-ad2f-4ca0-8c2b-629fa98ac8fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c478ccd93607d541e0175305d78c2e, https://si.imgix.net/b1423f32/uploads/origins/11b979d3-ad2f-4ca0-8c2b-629fa98ac8fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a3736678ad1351932260ad9bc3f0f35 2x, https://si.imgix.net/b1423f32/uploads/origins/11b979d3-ad2f-4ca0-8c2b-629fa98ac8fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98172140b3169d43d76b434e18e59bc9 3x", "genre": "art", "nsfw": false, "body": "個人Vtuberとして活動している恋小華れるといいます。\nくりこちゃんの絵を見て可愛い！と思い白餅あむこさんにぜひ、私の絵を描いていただきたいと思いリクエストさせていただきました。\n\n希望としましては、構図は全身で躍動感がありつつも可愛らしい感じで描いて欲しいです。\nまた髪型を、私のツインテールを1つに纏めてロングポニーテールの様にして欲しいです。\nサムネイル等でも使用する場合があるので背景の有無をPSDデータ上で分けていただけると助かります！\n\n参考資料はURLに添付させていただきますのでそちらから確認をお願いします。\n\nhttps://bsky.app/profile/koikogareru.bsky.social/post/3kov53cpchd23", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/30", "thumbnail_src": "https://si.imgix.net/d49f1d04/uploads/origins/d3f2665e-d66c-4b2b-92d7-8b5111888cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5033b21095f7932cc89434e4fe435b58", "thumbnail_srcset": "https://si.imgix.net/d49f1d04/uploads/origins/d3f2665e-d66c-4b2b-92d7-8b5111888cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5033b21095f7932cc89434e4fe435b58, https://si.imgix.net/d49f1d04/uploads/origins/d3f2665e-d66c-4b2b-92d7-8b5111888cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a789de23191ee847b0365deff9782191 2x, https://si.imgix.net/d49f1d04/uploads/origins/d3f2665e-d66c-4b2b-92d7-8b5111888cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f63d9f02d9f2b8670ec67e0c6cdfb143 3x", "genre": "art", "nsfw": false, "body": "元絵を参考に10歳くらいで！\n全身絵で、服装指定ありません！\n髪型はウマ娘のトランセンドみたいな感じで。\nがおーのポーズで。\nいつもの様に₺ƾさんの髪留めを(小物みたくてもOK)紛れ込ませてください！\n\nアイコンにもしたいのでアップでください。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/29", "thumbnail_src": "https://si.imgix.net/94c639b6/uploads/origins/ae8e2d80-edb0-4d21-84bf-7bbfb63cb4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d745b3582ef5e8cb6ac1d366830a782c", "thumbnail_srcset": "https://si.imgix.net/94c639b6/uploads/origins/ae8e2d80-edb0-4d21-84bf-7bbfb63cb4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d745b3582ef5e8cb6ac1d366830a782c, https://si.imgix.net/94c639b6/uploads/origins/ae8e2d80-edb0-4d21-84bf-7bbfb63cb4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=139fee4312d4abc30d7bda4b64fae269 2x, https://si.imgix.net/94c639b6/uploads/origins/ae8e2d80-edb0-4d21-84bf-7bbfb63cb4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6217125c3cd97f84d8d62922cc76b97 3x", "genre": "art", "nsfw": false, "body": "新衣装デザインができましたのでかっこかわいくサムネ等につかえる新衣装まろん栗子を描いてほしいです\n参考資料URL：https://twitter.com/kuriko_0929/status/1713436938592825421\n透過差分等PNG形式で納品お願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/28", "thumbnail_src": "https://si.imgix.net/066f74fd/uploads/origins/9467ef2b-973f-4449-8c09-12c3961b137d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbb356d625685c78cde894bac3e0d01", "thumbnail_srcset": "https://si.imgix.net/066f74fd/uploads/origins/9467ef2b-973f-4449-8c09-12c3961b137d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbb356d625685c78cde894bac3e0d01, https://si.imgix.net/066f74fd/uploads/origins/9467ef2b-973f-4449-8c09-12c3961b137d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9556486224bef334a30103f0433e6dd3 2x, https://si.imgix.net/066f74fd/uploads/origins/9467ef2b-973f-4449-8c09-12c3961b137d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=564a9155f076cce1f3ea96d2bc410cda 3x", "genre": "art", "nsfw": false, "body": "元絵を参考に、セクシーな感じの(ムチムチ増)二十歳位で。\n服装に指定はありません、コレ似合うかもっと思うのでお願いします！\n髪型はショートウルフ前髪斜めカット。\nもちさんが着けてる髪留めをアクセサリーとして紛れ込ませて欲しいです\nポーズ指定なし。\n表情指定なし。\n\nアイコンにもしたいのでアップでください。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/27", "thumbnail_src": "https://si.imgix.net/a8ded578/uploads/origins/20b6fb2f-5fd2-4faa-b60a-2857c6f254b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c3abd11ce8b4ce2cf7bd25edc14f82e", "thumbnail_srcset": "https://si.imgix.net/a8ded578/uploads/origins/20b6fb2f-5fd2-4faa-b60a-2857c6f254b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c3abd11ce8b4ce2cf7bd25edc14f82e, https://si.imgix.net/a8ded578/uploads/origins/20b6fb2f-5fd2-4faa-b60a-2857c6f254b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19072ea50e16b03a1c1ae29e4265a73b 2x, https://si.imgix.net/a8ded578/uploads/origins/20b6fb2f-5fd2-4faa-b60a-2857c6f254b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cec29876479cbb0c2a9265c0011b3cde 3x", "genre": "art", "nsfw": true, "body": "こんにちは！また、依頼させてください。\n【キャラクター】：赤井はあと\n【髪型】：資料1の髪型\n【衣装】：資料2のような服装（裸にオーバーオールという部分以外は、自由に変えてもらって構いません）\nひざ下からは、資料3のように、素足に運動靴でお願いします（靴も、運動靴っぽければなんでも構いません）\n【構図】：\n可能であれば、全身の入った立ち絵\n【その他】\n・いくつか表情差分を頂きたいです\n・背景を透過したものも頂きたいです\n・胸のサイズは、あなたの許容範囲内で可能な限り大きく盛ってください\n\n資料⇒https://www.dropbox.com/scl/fo/pxmgy1k0j42y98bk0y84c/h?rlkey=loeqworzx3yjofyuy4jazxxih&dl=0\n\n上記の内容以外は自由にお願いします。\nまた、可能であればPSDで納品をお願いします。\n以上でよろしければ、お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/26", "thumbnail_src": "https://si.imgix.net/3029fc59/uploads/origins/2a24d4c2-96bd-477b-819d-799fd183712c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d88239088e03980a61cc0485705c83", "thumbnail_srcset": "https://si.imgix.net/3029fc59/uploads/origins/2a24d4c2-96bd-477b-819d-799fd183712c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d88239088e03980a61cc0485705c83, https://si.imgix.net/3029fc59/uploads/origins/2a24d4c2-96bd-477b-819d-799fd183712c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b17285a19021b99852393562719c376 2x, https://si.imgix.net/3029fc59/uploads/origins/2a24d4c2-96bd-477b-819d-799fd183712c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c89aa4e3852f91898ce29fd5d4bd435c 3x", "genre": "art", "nsfw": true, "body": "先生のhttps://skeb.jp/@shiladango/works/20のエナドレシチュがツボすぎたので、同じようなシチュのリクエストお願いします。\n\n≪キャラクター≫\n月姫の遠野秋葉(髪は初め赤)\n\n≪シチュ≫\n黒セーラー服の秋葉が目玉の触手(紫に光る)に催眠をかけられ、ハイライト無しの虚ろ目で無抵抗なまま着衣の上から胸と陰部から触手にエナドレされる。\n※エナドレの光は黄色ではなく赤でお願いします。\n※右下に魔力ゲージが欲しいです。\n\n≪内容≫\n１枚目：目玉触手の催眠によりよだれをたらしながら胸と陰部に触手がつく。\n※魔力ゲージは満タンで色は緑\n２枚目：触手がエナドレを始め、表情は赤面して涙目になっている。\n※魔力ゲージは残り半分で色は黄色\n３枚目：触手のエナドレの光が激しくなり、表情は涙を流して絶頂。他の触手から白濁液が飛ぶ。\n※魔力ゲージは残り1/3で色は赤\n４枚目：触手が胸と陰部から糸を引いて離れる。胸は乳首がたっていて、陰部はショーツがぬるぬるになっていてクリがたっている。表情は涙、よだれをたらして放心。髪や体全体が触手の放った白濁液でべとべと。\n※魔力ゲージは空\n※魔力が空になったことで髪色が赤から黒へ\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/25", "thumbnail_src": "https://si.imgix.net/c577d8c4/uploads/origins/02396b88-cc8f-4b1e-8f53-68b9f23fdfc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077bbea6002da6a5d13c6186c30fa3c6", "thumbnail_srcset": "https://si.imgix.net/c577d8c4/uploads/origins/02396b88-cc8f-4b1e-8f53-68b9f23fdfc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077bbea6002da6a5d13c6186c30fa3c6, https://si.imgix.net/c577d8c4/uploads/origins/02396b88-cc8f-4b1e-8f53-68b9f23fdfc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2feeab7fde06195ce7b418870ef52431 2x, https://si.imgix.net/c577d8c4/uploads/origins/02396b88-cc8f-4b1e-8f53-68b9f23fdfc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51bfb9ee745ce0da7f2159bda34103e6 3x", "genre": "art", "nsfw": true, "body": "こんにちは！素敵な絵柄なので、依頼させてください。\n【キャラクター】：赤井はあと\n【髪型】：資料1の髪型\n【衣装】：資料2のような服装（アメスクという感じであれば構いません。細部は自由に変更してください）\nひざ下からは、資料3のような感じ\n【構図】：\n可能であれば、全身の入った立ち絵\n【その他】\n・いくつか表情差分を頂きたいです\n・背景を透過したものも頂きたいです\n・胸のサイズは、あなたの許容範囲内で可能な限り大きく盛ってください\n\n資料⇒https://www.dropbox.com/scl/fo/mat6wll8pyn35pm6q8tim/h?rlkey=64r7gwb1emkv32zngy2a3brk0&dl=0\n\n上記の内容以外は自由にお願いします。\nまた、可能であればPSDで納品をお願いします。\n以上でよろしければ、お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/24", "thumbnail_src": "https://si.imgix.net/836c6cfa/uploads/origins/eea458e4-ef90-42b7-8fec-bac4060b961b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=027c29d358883653c788e9ab739ab1b3", "thumbnail_srcset": "https://si.imgix.net/836c6cfa/uploads/origins/eea458e4-ef90-42b7-8fec-bac4060b961b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=027c29d358883653c788e9ab739ab1b3, https://si.imgix.net/836c6cfa/uploads/origins/eea458e4-ef90-42b7-8fec-bac4060b961b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3296da00a912e7e980534aa9d5ab2b03 2x, https://si.imgix.net/836c6cfa/uploads/origins/eea458e4-ef90-42b7-8fec-bac4060b961b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65657e7bc59ce8727e1a42619ab245ac 3x", "genre": "art", "nsfw": false, "body": "元絵を参考にして貰って、ちょっと大人っぽい20歳位イメージで描いて下さい！\n服装はいつものパーカー\n髪型はボサボサのウルフカット\nポーズ指定なし\n表情ニコニコ\n\nアイコンにもしたいです！", "created_at": "", "completed_at": ""}, {"path": "/@shiladango/works/23", "thumbnail_src": "https://si.imgix.net/76b872cf/uploads/origins/0d22b226-bf66-4a9b-ae14-e55e5842242f?bg=%23fff&auto=form