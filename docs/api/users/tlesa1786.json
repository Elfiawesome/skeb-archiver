}, {"path": "/@tlesa1786/works/4", "thumbnail_src": "https://si.imgix.net/032ee71d/uploads/origins/2a795891-3bea-42e3-afb2-12d4fd91e07b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a4c0d6df1677cce1f6ffdec436efd45", "thumbnail_srcset": "https://si.imgix.net/032ee71d/uploads/origins/2a795891-3bea-42e3-afb2-12d4fd91e07b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a4c0d6df1677cce1f6ffdec436efd45, https://si.imgix.net/032ee71d/uploads/origins/2a795891-3bea-42e3-afb2-12d4fd91e07b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b688f52cc04ed35fdcb79e1ec0dbe673 2x, https://si.imgix.net/032ee71d/uploads/origins/2a795891-3bea-42e3-afb2-12d4fd91e07b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=339ca416cf6012f1103f58e13c5d3893 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tlesa1786/works/3", "thumbnail_src": "https://si.imgix.net/5b13746b/uploads/origins/d419705f-107b-409b-8276-06b80308fb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=582d4338fedcde9c51e05b8e31b34c37", "thumbnail_srcset": "https://si.imgix.net/5b13746b/uploads/origins/d419705f-107b-409b-8276-06b80308fb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=582d4338fedcde9c51e05b8e31b34c37, https://si.imgix.net/5b13746b/uploads/origins/d419705f-107b-409b-8276-06b80308fb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2082288c9d1ab73887cbb01357d6c066 2x, https://si.imgix.net/5b13746b/uploads/origins/d419705f-107b-409b-8276-06b80308fb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03fbdff36bdeb2a1cc13db7d975d5e58 3x", "genre": "novel", "nsfw": false, "body": "テレサさん、いつもお世話になっております！\nテキストのリクエスト受付ていらっしゃるのを見て、久しぶりにテレサさんの裁花探偵事務所のお話が読みたいな……と思ってしまったので、よろしければ……おねがいいたします！\nテレサさんの小説の文章がとても好きなので……\n\n内容はどんなものでも構いません。ご都合よろしければ、ぜひお好きなように書いていただければと思います！\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@tlesa1786/works/2", "thumbnail_src": "https://si.imgix.net/ae552d85/uploads/origins/299df4f9-c9ae-41d1-9e85-a65bdb036bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=343315216dd12ce0d6dac85774e0675b", "thumbnail_srcset": "https://si.imgix.net/ae552d85/uploads/origins/299df4f9-c9ae-41d1-9e85-a65bdb036bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=343315216dd12ce0d6dac85774e0675b, https://si.imgix.net/ae552d85/uploads/origins/299df4f9-c9ae-41d1-9e85-a65bdb036bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb08561c193052fab4acabc3ac7ce2a0 2x, https://si.imgix.net/ae552d85/uploads/origins/299df4f9-c9ae-41d1-9e85-a65bdb036bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9d6c24b7fb950332d5ab3ad61fcd9fa 3x", "genre": "novel", "nsfw": false, "body": "こんにちは！あなたのファンです！\n以前書いてもらった自キャラが階段から降りてくる文章が忘れられません……5年前で驚きましたがたまに見返していて、とても気に入っています。読む度に「お゛！」みたいな声が出ます。\n\nリクエストです。私のキャラクターのアレイスターがNPCのように登場するシーンを書いて欲しいです。\n彼は魅力的なのですが、その魅力を自分だけではなかなか伝えられないのでお力をお借りしたいです。できれば少し舞台などを変えれば何度でも使用できるような、キャラクターの容姿や所作を中心とした文章を希望します（何度でも吸いたいので）ぜひあなたの文章で、パンの仔である彼の魅力に信憑性を持たせて欲しいです。\n\n想定しているのは立ち絵のシルクハットとマントを羽織っている姿で、どこかの建物からブーツを鳴らしてゆっくりと登場します。背が高く真っ黒なマントを着た彼はとても威圧感がありますが、顔立ちの美しさは美男子が美女の皮を被ったような究極的なものです。（私と私の友人による現時点で最高の表現は“叶姉妹とグッドルッキングガイのキメラ”です。そうなんですけど助けてください。）周囲の人々の反応は彼をゴーツウッド伯爵だと知っていれば色めき立ち、知らない者であればすくんでしまうような感じです。彼がふと微笑めば威圧感が和らぐか、妖艶な空気が漂うかのどちらか。しかし立ち姿は上品で凛々しく、周囲を勘違いさせるようなことはしません。最後には軽く帽子を上げる挨拶をして去って行くイメージです。（この時ツノがチラ見えして欲しいです。ツノの描写がほしい……）周囲がざわつく描写を入れて欲しいのですが、できればそこに男性のモブもいて欲しいです。\n\n以上はなんとなくの草案ですので、彼が魅力的に登場するシーンであれば自由に変更してください。また描写の全てを一連の流れにする必要はありません。漫画のコマのようにいくつかあったり、各描写が分かれていても構いません。\n\n資料は中間のライン以降を見ていただければ問題ないかと思います。それ以前は参考になりそうなところを、インスピレーションの手助けになればと思い記載しました。\n\nけだまちゃんの書いたカッコイイアレイスターが見たああ～～～～い！！見たいよー！うわーい！うわんうわんうわん……。もしよろしければめ〜っちゃ見たいです。お手すきの際にでも楽しく書いてくださったらうっれぴーです。ここまで読んでいただきありがとうございました。ご検討のほどよろしくお願いします……（ふかふか……）\n\nhttps://www.evernote.com/shard/s544/sh/02f35849-4027-2841-f4e6-93464c19e2f2/252b707e0ab650462d5df615296ad453", "created_at": "", "completed_at": ""}, {"path": "/@tlesa1786/works/1", "thumbnail_src": "https://si.imgix.net/b0b7cbc9/uploads/origins/8572cd7a-91af-4b20-bf37-9be54ffd4659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e1c3d588bb56561769d98e92258f93f", "thumbnail_srcset": "https://si.imgix.net/b0b7cbc9/uploads/origins/8572cd7a-91af-4b20-bf37-9be54ffd4659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e1c3d588bb56561769d98e92258f93f, https://si.imgix.net/b0b7cbc9/uploads/origins/8572cd7a-91af-4b20-bf37-9be54ffd4659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=125b8142bd1cc84e90e1ad0b70fbca6b 2x, https://si.imgix.net/b0b7cbc9/uploads/origins/8572cd7a-91af-4b20-bf37-9be54ffd4659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6b0b95d1a4288b2e4ba350fb3f909ec 3x", "genre": "novel", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}