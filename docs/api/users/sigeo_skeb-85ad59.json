6c6189/uploads/origins/28caedcc-2d9f-4dae-a7ab-d278d8f36dcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc137478ff61074ccc2d9f91811752d2", "thumbnail_srcset": "https://si.imgix.net/996c6189/uploads/origins/28caedcc-2d9f-4dae-a7ab-d278d8f36dcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc137478ff61074ccc2d9f91811752d2, https://si.imgix.net/996c6189/uploads/origins/28caedcc-2d9f-4dae-a7ab-d278d8f36dcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57b1bcc19e05e75414d2c4b1ac22955e 2x, https://si.imgix.net/996c6189/uploads/origins/28caedcc-2d9f-4dae-a7ab-d278d8f36dcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=807e47593bc5f3e9d7c856d7b4b67bb4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたからのアートを期待していました！\n私のOCは、スライムのような触手を尻尾に持つエルドリッチのキャットガールです！彼女はちょっとグレムリン／ヤンデレタイプで...ちょっとクレイジーなんだ！\n触手の尻尾は1本でも複数でもOK！好きなだけ描いてください！\n\n服装はドレスでもボディスーツでもOKです！\n\n今までの作品\nhttps://skeb.jp/@sigeo_skeb/works/7\nhttps://skeb.jp/@sigeo_skeb/works/20\nhttps://skeb.jp/@sigeo_skeb/works/17\n\n好きなように描いてくださいありがとうございます\n\nhttps://drive.google.com/drive/folders/13TBNvue4o6Y9n78zwaOchlqVYJdzqdFj?usp=drive_link\n\nhttps://drive.google.com/drive/folders/13TBNvue4o6Y9n78zwaOchlqVYJdzqdFj?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sigeo_skeb/works/23", "thumbnail_src": "https://si.imgix.net/1dd55468/uploads/origins/bd4ed0c9-7fa9-4799-82e6-09c4732c558c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64bdab89659547594cc029a7b4ed7e5f", "thumbnail_srcset": "https://si.imgix.net/1dd55468/uploads/origins/bd4ed0c9-7fa9-4799-82e6-09c4732c558c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64bdab89659547594cc029a7b4ed7e5f, https://si.imgix.net/1dd55468/uploads/origins/bd4ed0c9-7fa9-4799-82e6-09c4732c558c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0cd0154f530d87e315bf5d6250424ca 2x, https://si.imgix.net/1dd55468/uploads/origins/bd4ed0c9-7fa9-4799-82e6-09c4732c558c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e5bf45f98427555c05ac245a3eac0fc 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの素敵な絵が私の目に留まり、私のキャラクターであるフレイヤを描いてほしいという私の依頼を検討してもらえたら嬉しいです。\n\n以下は私のキャラクターの参考です： https://files.catbox.moe/8ppwej.PNG\nフレイアは、クールでミステリアスに見せることに執着している腕利きの剣士で、「中二病」にも似た、クールだと思う不吉なセリフをつぶやきます。\n\nこんな格好でクールでセクシーに見せようとしている彼女を想像していた：https://files.catbox.moe/tqbsi6.png\nグラスをクールに満たす姿とか？\n\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@sigeo_skeb/works/22", "thumbnail_src": "https://si.imgix.net/ced49d41/uploads/origins/7f1d24f1-689a-4fa0-9bf3-946ac19dc6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4ae0681424096625609be889c3b8c6", "thumbnail_srcset": "https://si.imgix.net/ced49d41/uploads/origins/7f1d24f1-689a-4fa0-9bf3-946ac19dc6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4ae0681424096625609be889c3b8c6, https://si.imgix.net/ced49d41/uploads/origins/7f1d24f1-689a-4fa0-9bf3-946ac19dc6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5625ae70f7e7f4de8540d8d2f49d01c 2x, https://si.imgix.net/ced49d41/uploads/origins/7f1d24f1-689a-4fa0-9bf3-946ac19dc6f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c933f2929661a5a7f9cbf0b592b9ca25 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私の名前はEbiです。あなたの作品が大好きで、ぜひあなたに描いていただきたいです。この絵のポーズと作品（https://skeb.jp/@sigeo_skeb/works/1）が大好きです。この絵のようにアップにしてほしいです。私のキャラクターは悪魔です。濃い青緑色の長い髪で、悪魔の角が生えています。全てはあなた次第です！\n\nよろしくお願いします！\n\n参考：https://drive.google.com/drive/folders/1QTGqRwwA3JVCliWCRO2YNnHndNpVFHZy?usp=sharing\n\nhttps://drive.google.com/drive/folders/1QTGqRwwA3JVCliWCRO2YNnHndNpVFHZy?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sigeo_skeb/works/21", "thumbnail_src": "https://si.imgix.net/a58bb9c8/uploads/origins/efb5698d-1576-48d9-b004-0db75f6f3506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2367d25543a6ef020e78a741714e6594", "thumbnail_srcset": "https://si.imgix.net/a58bb9c8/uploads/origins/efb5698d-1576-48d9-b004-0db75f6f3506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2367d25543a6ef020e78a741714e6594, https://si.imgix.net/a58bb9c8/uploads/origins/efb5698d-1576-48d9-b004-0db75f6f3506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e90a7626195a3fdabffb9c6251fd31ce 2x, https://si.imgix.net/a58bb9c8/uploads/origins/efb5698d-1576-48d9-b004-0db75f6f3506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e883b3b158c0c9d021b1fab86234362b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルはとても魅力的で、ぜひ私のキャラクターを描いてもらいたいわ。彼女はとても鋭い歯を持ったおてんばなドラゴンです。いつも眠そうにしています。それ以外はすべてお任せします！どうぞ楽しんで描いてください！\n\nhttps://gyugyu.booth.pm/items/3987778", "created_at": "", "completed_at": ""}, {"path": "/@sigeo_skeb/works/20", "thumbnail_src": "https://si.imgix.net/06c3068d/uploads/origins/3491effe-ca5a-4b3e-9ff0-c7770b2c1a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7a725a920ad4f2cadea31d21b60590", "thumbnail_srcset": "https://si.imgix.net/06c3068d/uploads/origins/3491effe-ca5a-4b3e-9ff0-c7770b2c1a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7a725a920ad4f2cadea31d21b60590, https://si.imgix.net/06c3068d/uploads/origins/3491effe-ca5a-4b3e-9ff0-c7770b2c1a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c89318cddbebb44c9d74fb1fa9e20a6a 2x, https://si.imgix.net/06c3068d/uploads/origins/3491effe-ca5a-4b3e-9ff0-c7770b2c1a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e15146009dfbcfba99b3dee19666707e 3x", "genre": "art", "nsfw": false, "body": "素晴らしい！私はあなたがここで作ったアートに恋しています：https://skeb.jp/@FaVCljtREh/works/8 ！私のオリジナルキャラクターVixenのために、同じようなアートスタイルで何か作ってほしいです。彼女は食べ物が大好きなキツネの女の子です。どんな風に描いても構いません！https://imgur.com/a/lB5iIdh\n\n注意点：異色症、肌の色、美容マーク。\n\nhttps://imgur.com/a/lB5iIdh", "created_at": "", "completed_at": ""}, {"path": "/@sigeo_skeb/works/19", "thumbnail_src": "https://si.imgix.net/92f70d33/uploads/origins/50650369-35de-4de4-b389-6af37b6c8e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c08af83a0e08d558b41eb8adf61463", "thumbnail_srcset": "https://si.imgix.net/92f70d33/uploads/origins/50650369-35de-4de4-b389-6af37b6c8e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c08af83a0e08d558b41eb8adf61463, https://si.imgix.net/92f70d33/uploads/origins/50650369-35de-4de4-b389-6af37b6c8e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e359a935555e097fbaa59750bb1fa5b0 2x, https://si.imgix.net/92f70d33/uploads/origins/50650369-35de-4de4-b389-6af37b6c8e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af2c8f29103754ab5366baa5fb114324 3x", "genre": "art", "nsfw": false, "body": "やあ^^君のスタイルで僕の友達のためにやってくれるかい？\n\nキャラクター\nhttps://x.com/hunikinn/status/1581439827949801473?s=20\n(胸はでかくてもいい!)", "created_at": "", "completed_at": ""}, {"path": "/@sigeo_skeb/works/18", "thumbnail_src": "https://si.imgix.net/ae82e982/uploads/origins/a5f02c76-6b68-4bb1-ab0a-897eb83eba65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50a033d05110891a88fa7032bf97e4be", "thumbnail_srcset": "https://si.imgix.net/ae82e982/uploads/origins/a5f02c76-6b68-4bb1-ab0a-897eb83eba65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50a033d05110891a88fa7032bf97e4be, https://si.imgix.net/ae82e982/uploads/origins/a5f02c76-6b68-4bb1-ab0a-897eb83eba65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5cb6327d8f7ca1c7a9c7472ff2e64fc 2x, https://si.imgix.net/ae82e982/uploads/origins/a5f02c76-6b68-4bb1-ab0a-897eb83eba65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200