1b5/uploads/origins/b79e9d40-f541-420a-b57f-3ec1af325198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7ce05436db3a8732517b6d7541980f8 2x, https://si.imgix.net/c64601b5/uploads/origins/b79e9d40-f541-420a-b57f-3ec1af325198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d9f63ee4bbfff8bb0f5e1f9e87ecd07 3x", "genre": "art", "nsfw": false, "body": "アピールをありがとうございます。\nイラスト、とても素敵です。描線のタッチが好きです。\nリクエスト失礼いたします。\n\n資料URLの創作キャラクターを描いていただきたいです。\nクリエイターの方から、イラストを資料として提出することの許可をいただいています。\n\n□キャラクター設定\n13歳の少年。おとなしいけれど、ひたむきでがんばりやな性格。\n氷や雪から生まれた妖怪のような種族。生まれは海外です。\n外見のモチーフはマヌルネコです。\nかわいらしい印象。\n\n詳細はすべてお任せいたします。\nご自由に、お好きなように描いていただけたら嬉しいです！\n\nhttps://x.com/yyyy_5530/status/1974839139653849459", "created_at": "", "completed_at": ""}, {"path": "/@tuyukino_uta/works/11", "thumbnail_src": "https://si.imgix.net/701d4af0/uploads/origins/f3100073-f980-4ce8-9953-98685b008c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d599c5997300d1933a1b156d7d28617", "thumbnail_srcset": "https://si.imgix.net/701d4af0/uploads/origins/f3100073-f980-4ce8-9953-98685b008c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d599c5997300d1933a1b156d7d28617, https://si.imgix.net/701d4af0/uploads/origins/f3100073-f980-4ce8-9953-98685b008c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e793435726d5e679d6af6100aa8200cc 2x, https://si.imgix.net/701d4af0/uploads/origins/f3100073-f980-4ce8-9953-98685b008c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30188404d54ac074cb46a3912a8f3e6c 3x", "genre": "art", "nsfw": false, "body": "ぱすもちかいて❣️❣️❣️❣️❣️❣️ください❣️❣️\nゆっくりでいいよ❣️❣️❣️❣️❣️❣️❣️❣️❣️❣️", "created_at": "", "completed_at": ""}, {"path": "/@tuyukino_uta/works/10", "thumbnail_src": "https://si.imgix.net/1ba500f8/uploads/origins/ee080912-9cc7-47bc-be31-67f67a42aa94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bad60