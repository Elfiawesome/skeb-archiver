5f9-4f71-941a-89b84c7bb75c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cacbe384ed489920d0fabd1a6c0127df 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/7", "thumbnail_src": "https://si.imgix.net/704a28b3/uploads/origins/5f0398c1-5338-4df0-b78e-502d682f8bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=704fca78a56a0aad191357cf8f4d0c30", "thumbnail_srcset": "https://si.imgix.net/704a28b3/uploads/origins/5f0398c1-5338-4df0-b78e-502d682f8bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=704fca78a56a0aad191357cf8f4d0c30, https://si.imgix.net/704a28b3/uploads/origins/5f0398c1-5338-4df0-b78e-502d682f8bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c26589305771bca3f52d989c2279d98b 2x, https://si.imgix.net/704a28b3/uploads/origins/5f0398c1-5338-4df0-b78e-502d682f8bcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d0c8a284882242b8d9372d9de20890a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/6", "thumbnail_src": "https://si.imgix.net/e154ddce/uploads/origins/e3ae6f48-2674-4c52-b97c-95f87e6ea7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=832d01b08e060bc8ae9694b835bee87d", "thumbnail_srcset": "https://si.imgix.net/e154ddce/uploads/origins/e3ae6f48-2674-4c52-b97c-95f87e6ea7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=832d01b08e060bc8ae9694b835bee87d, https://si.imgix.net/e154ddce/uploads/origins/e3ae6f48-2674-4c52-b97c-95f87e6ea7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fb3d002b8a610f21dd30ec2db407fc5 2x, https://si.imgix.net/e154ddce/uploads/origins/e3ae6f48-2674-4c52-b97c-95f87e6ea7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56e1eeba510d5ed9f86398ca9a17945d 3x", "genre": "art", "nsfw": true, "body": "お世話になります、いつも素晴らしい絵を供給してくださりありがとうございます。\n\nキャラはデュエプレのキリコでお願いします。デカか小さい方かはお任せします。お好きな方をお選びください。\n\n体型や服装は以前お描きになっておられた水着ラフラブやアダムスキー等を参考にしましてまるで隠せてないマイクロビキニの超乳体型でお願いします。\n\n流れとしましては、\n\nキリコが、隠れて付き合っている視点主を部屋に連れ込み、彼の趣味に合わせて改造した超乳の姿を見せつけてくる。\n\nいつもは押さえつけて隠してたデカパイを曝け出して、無表情でも顔を赤くして恥ずかしがりながら感想を聞いてくるので、似合ってると言うと、安心した様子で、無表情を少し緩めて嬉しがるキリコ。\nキリコは相手が勃起してるのを見つけて、し、仕方ないと言いつつも内心ウキウキでズボンをずり下ろさせた。\n立派なチンポを目の前に出され、キリコは表情の変化が少ないのに、明らかにすぐにハート目で視線が釘付けになってしまう。臭いにもクッサ🩷と口調を崩しながら、夢中で嗅いでしまっている。\n\nもう我慢ならないと言った様子でご奉仕の許可をと願ってくるキリコ。\nしてくれと許可を出すとすぐに夢中になってしゃぶりつき、エッグいバキュームフェラで逃がさないとばかりにガッチリと捕まえてくる。\n\nその後、相手の精子を根こそぎ絞り尽くして、ザーメン塗れで微笑むキリコ。次は何して欲しいかを問いかけてくる。\n\nと言ったシチュをお願いしたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/5", "thumbnail_src": "https://si.imgix.net/bb304b2c/uploads/origins/e8a577f5-c1bd-41cc-8c3c-100bb3718fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ed1eafda43a63f80273c3291df03b2", "thumbnail_srcset": "https://si.imgix.net/bb304b2c/uploads/origins/e8a577f5-c1bd-41cc-8c3c-100bb3718fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ed1eafda43a63f80273c3291df03b2, https://si.imgix.net/bb304b2c/uploads/origins/e8a577f5-c1bd-41cc-8c3c-100bb3718fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58d040658fcee9ebcbbcbc15b554f837 2x, https://si.imgix.net/bb304b2c/uploads/origins/e8a577f5-c1bd-41cc-8c3c-100bb3718fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c681f2ade6b3a149bfe73f900421f6c2 3x", "genre": "art", "nsfw": true, "body": "こんにちは！依頼させていただきます！\n\nシャニマスの杜野凛世を描いていただきたいです！\nPを赤ちゃん言葉で煽りながら、ガニ股でふたなりちんぽを見せつけからの、お下品なセルフパイズリオナニーで大量射精キメちゃう凛世が見たいです！\n・おっぱいはもうとにかく超でっっっっっっっかく！乳輪も乳首も全部超でっっっっっっっかく描いていただきたいです！過去一盛り盛りでお願いします！\n・ふたなりちんぽももちろん超でっっっっっっっかく！玉も超でっっっっっかくお願いします！\n・ケツは…お任せします！普通サイズでもいいですし、バカデカくてもいいです！\n\n可能であれば陰毛(剛毛)差分や母乳差分があると嬉しいです！オホ顔でお下品な感じだと嬉しい…\nあと……ケツからも太いのひり出してたりする差分とか…………どうですか………\n\n結構癖盛り盛りですし大変だと思うので無理な場合は無理で全然大丈夫ですので…！\nあと、適宜カットや改変等はしていただいて大丈夫です。\nお願いが多くなりましたが…もしよければお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/4", "thumbnail_src": "https://si.imgix.net/5edae65a/uploads/origins/0e9bc8e1-483c-4455-8362-d08ae71f7380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa6186ca629ab8448815eca3ef3467c1", "thumbnail_srcset": "https://si.imgix.net/5edae65a/uploads/origins/0e9bc8e1-483c-4455-8362-d08ae71f7380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa6186ca629ab8448815eca3ef3467c1, https://si.imgix.net/5edae65a/uploads/origins/0e9bc8e1-483c-4455-8362-d08ae71f7380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54dfd1628b52e0609e0ce3f080450dd8 2x, https://si.imgix.net/5edae65a/uploads/origins/0e9bc8e1-483c-4455-8362-d08ae71f7380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0d7b6864801711e8ced6bcc0e2e162c 3x", "genre": "art", "nsfw": true, "body": "超乳エルフナインをリクエストします。疲れた目で得意げな表情をしている姿が好きです。白衣の服装もいいですが、カジュアルな服装も楽しいです。\n\n接地系超乳/膨乳、おっぱいは体より大きくしてください、できるだけ大きくしてください。 授乳中の大量の牛乳と、たくさんの破れた服。\n\nまた、ふたなりバージョンも自由に作ってください。その点でも彼女を非常に大きくしてください。これまでよりも大きくしてください！\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/3", "thumbnail_src": "https://si.imgix.net/d48bff8c/uploads/origins/ca14e1b0-76ad-4e19-9646-26160e0607c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eab9f3249542d14d57e7383da94f2807", "thumbnail_srcset": "https://si.imgix.net/d48bff8c/uploads/origins/ca14e1b0-76ad-4e19-9646-26160e0607c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eab9f3249542d14d57e7383da94f2807, https://si.imgix.net/d48bff8c/uploads/origins/ca14e1b0-76ad-4e19-9646-26160e0607c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d1de1892eebf683e8eea5bafa081e46 2x, https://si.imgix.net/d48bff8c/uploads/origins/ca14e1b0-76ad-4e19-9646-26160e0607c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=106ba9662d33d6aa531edd1f32eeaddb 3x", "genre": "art", "nsfw": true, "body": "遊戯王のRAI-MEIとトリックスター・リリーベルのフタナリレズセックスをリクエストさせて頂きます\n\n竿役:リリーベル。ロリ体型かつ腹ボコ出来そうなサイズの巨根付。\n\n受け:RAI-MEI。生えてない。全身むちむちで乳のサイズは頭より大きくへそがギリギリ見えるくらいの爆乳(=腹から股間が見えるように)\n\n服装は2人とも元のカードのイラストで着ている物で、RAI-MEIは股間部のみ露出、リリーベルはドロワーに穴が開き陰茎がスカートを持ち上げて露出した状態です。体位は背面座位か、上半身を起こした状態でキャラの正面が良く見えるアングルでの立ちバックでお願いします。\n\n1枚目：挿入前。リリーベルがRAI-MEIに挿入しようとし、RAI-MEIがそれに対し抵抗or誘惑(お好きなシチュをお選び下さい)している。\n\n2枚目：挿入時。リリーベルがSッ気のある表情で一気に挿入し、RAI-MEIはその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n\n3枚目：挿入後。激しくピストンしながら二人とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n\n4枚目：膣内射精&絶頂。二人とも汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\n…という差分と、それぞれに二人のセリフをテキストで付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、リリーベルはドSでオラついたメスガキ、といったイメージをベースにそれぞれお好きなように設定して頂いて構いません。\n\nかなり細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/2", "thumbnail_src": "https://si.imgix.net/96d2f5fa/uploads/origins/53bb0d7c-befc-4214-9e58-f2727e7789b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af4e31f706eb1e317035f55c1b669137", "thumbnail_srcset": "https://si.imgix.net/96d2f5fa/uploads/origins/53bb0d7c-befc-4214-9e58-f2727e7789b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af4e31f706eb1e317035f55c1b669137, https://si.imgix.net/96d2f5fa/uploads/origins/53bb0d7c-befc-4214-9e58-f2727e7789b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=049d30b1d2cbef1c1506b81332188bc8 2x, https://si.imgix.net/96d2f5fa/uploads/origins/53bb0d7c-befc-4214-9e58-f2727e7789b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ff3669a81d9d28de3013b96c890c667 3x", "genre": "art", "nsfw": true, "body": "こんにちは！依頼させていただきます！\n\n依頼なのですが、ブルーアーカイブの百合園セイアちゃんを描いていただきたいです！\n「クソデカおっぱい」+「ふたなりでかちんぽ」が見たいので…ガニ股で下品にセルフパイズリフェラしちゃうセイアちゃんを描いていただきたいです！\n・おっぱいはめちゃくちゃでっかく！ふデさんが描ける最大級なおっぱいが見てみたいです！乳首と乳輪もとても大きいと嬉しいです！\n・ふたなりちんぽはセルフフェラするのででっかめだと嬉しいです！もちろん玉ありで！\n・セルフフェラなんですが下品なひょっとこフェラをしていると嬉しいです\n\nまた、可能であれば陰毛(剛毛)差分や母乳・射精差分があるととても嬉しいです\n結構癖盛り盛りですし大変だと思うので無理な場合は無理で全然大丈夫ですので…！\n\nお願いが多くなりましたが…もしよければお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@futaphogear/works/1", "thumbnail_src": "https://si.imgix.net/4c506ea5/uploads/origins/c5c6752d-eca3-4ce7-8e43-5814680ae320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21aae8b217ff75646296d97a09786069", "thumbnail_srcset": "https://si.imgix.net/4c506ea5/uploads/origins/c5c6752d-eca3-4ce7-8e43-5814680ae320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21aae8b217ff75646296d97a09786069, https://si.imgix.net/4c506ea5/uploads/origins/c5c6752d-eca3-4ce7-8e43-5814680ae320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbc9aa89597bcaa3ec7beca1828a0f8a 2x, https://si.imgix.net/4c506ea5/uploads/origins/c5c6752d-eca3-4ce7-8e43-5814680ae320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c6cf3aeabef859d42db7773edde3ce0 3x", "genre": "art", "nsfw": true, "body": "シンフォギアの美嘉を、描ける限りの巨乳でお願いします。そしてもちろん：マイクロビキニを着せてあげてください。", "created_at": "", "completed_at": ""}]}