ceeb50-d37b-4341-99da-01d8723f6954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e5866869af02a26c49f5c840546a7ac", "thumbnail_srcset": "https://si.imgix.net/42bee549/uploads/origins/a7ceeb50-d37b-4341-99da-01d8723f6954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e5866869af02a26c49f5c840546a7ac, https://si.imgix.net/42bee549/uploads/origins/a7ceeb50-d37b-4341-99da-01d8723f6954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0152c36b501c5226a3f497cbf18e2f8 2x, https://si.imgix.net/42bee549/uploads/origins/a7ceeb50-d37b-4341-99da-01d8723f6954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e23a710e6ff27803f79fe84e854d00b2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KenzenTamaki/works/20", "thumbnail_src": "https://si.imgix.net/ebb13568/uploads/origins/3a44ad16-6a4f-4318-b10f-1fa95680e738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e6b1e3932617b5ada7d4f8028e86ea3", "thumbnail_srcset": "https://si.imgix.net/ebb13568/uploads/origins/3a44ad16-6a4f-4318-b10f-1fa95680e738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e6b1e3932617b5ada7d4f8028e86ea3, https://si.imgix.net/ebb13568/uploads/origins/3a44ad16-6a4f-4318-b10f-1fa95680e738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=288002b5e8db5977728d9bfe41425709 2x, https://si.imgix.net/ebb13568/uploads/origins/3a44ad16-6a4f-4318-b10f-1fa95680e738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop