人物のみの透過等を分けたPSDデータをいただけますと幸いです。\n\nご多忙のことと思いますが、お手隙の際にご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hiragi_1014/works/6", "thumbnail_src": "https://si.imgix.net/6b7675f1/uploads/origins/c4cbaf60-aa00-445d-baa3-6f356c12a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0727745f50179c1349b1d2b2ed79e891", "thumbnail_srcset": "https://si.imgix.net/6b7675f1/uploads/origins/c4cbaf60-aa00-445d-baa3-6f356c12a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0727745f50179c1349b1d2b2ed79e891, https://si.imgix.net/6b7675f1/uploads/origins/c4cbaf60-aa00-445d-baa3-6f356c12a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=369317ba542666e8a70a23344ecb7b6d 2x, https://si.imgix.net/6b7675f1/uploads/origins/c4cbaf60-aa00-445d-baa3-6f356c12a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7cefad8351084f8125e751b0e4747891 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hiragi_1014/works/5", "thumbnail_src": "https://si.imgix.net/4802b26e/uploads/origins/bd2be2fa-9ed2-41f0-8fee-e77ee84a5d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5b3b5f3e0a1a164453d1afff4fb6ac", "thumbnail_srcset": "https://si.imgix.net/4802b26e/uploads/origins/bd2be2fa-9ed2-41f0-8fee-e77ee84a5d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5b3b5f3e0a1a164453d1afff4fb6ac, https://si.imgix.net/4802b26e/uploads/origins/bd2be2fa-9ed2-41f0-8fee-e77ee84a5d04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=