s=7bf99b46e3b3c1d8b0f6be7bed0a8089 2x, https://si.imgix.net/06d6711e/uploads/origins/e10155eb-3bcd-42b1-a3a4-08c219c29a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a4b7805af45d5c548a80bac1a5e1e2e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazaneWind/works/45", "thumbnail_src": "https://si.imgix.net/80e64d4b/uploads/origins/dd5e87df-b784-410b-9f21-9d5456600b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812a926fe242ff9e8fc1b2f4cbf33e48", "thumbnail_srcset": "https://si.imgix.net/80e64d4b/uploads/origins/dd5e87df-b784-410b-9f21-9d5456600b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812a926fe242ff9e8fc1b2f4cbf33e48, https://si.imgix.net/80e64d4b/uploads/origins/dd5e87df-b784-410b-9f21-9d5456600b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6c209114ffd5abe7f20af8a1d263c83 2x, https://si.imgix.net/80e64d4b/uploads/origins/dd5e87df-b784-410b-9f21-9d5456600b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6423bb642c31c725588ea6e60ee755c 3x", "genre": "art", "nsfw": true, "body": "こんにちは。私のOC、アリッサのイラストをお願いしたいのですが。\n\nアリッサはおちゃめでいじわるな性格。彼女はバストのある砂時計のような体型をしています。髪の色は青。目の色はシアン。衣装は競技用の水着で、カンナや白子の水着に似たスタイルだ。いくつかの参考資料が含まれていますが、衣装のデザインはあなた次第です。\n\nイラストは、濡れた体や汗ばんだ体など、セクシーというかエロティックな雰囲気のものを希望します。できれば水着の一部も透けていてほしいです。ポーズはお任せしますが、過去の環奈ちゃんや白子ちゃんのイラストのようなポーズでもOKです。\n\nファイル形式はPSDかCLIPが望ましいです。\n\nお手数をおかけしますが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nBjriVumhEJ6kU-JiOX1nO-UDSnEg0Jn?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kazaneWind/works/44", "thumbnail_src": "https://si.imgix.net/375a527c/uploads/origins/178c118d-43b9-4ecf-8579-a843f029c851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2525e7f61775438df45573c2437dc4b", "thumbnail_srcset": "https://si.imgix.net/375a527c/uploads/origins/178c118d-43b9-4ecf-8579-a843f029c851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2525e7f61775438df45573c2437dc4b, https://si.imgix.net/375a527c/uploads/origins/178c118d-43b9-4ecf-8579-a843f029c851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a00326f6204b9ceb5bce35c3ca5ff411 2x, https://si.imgix.net/375a527c/uploads/origins/178c118d-43b9-4ecf-8579-a843f029c851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc5ff21f69b9293d482880aeb534d062 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n前回のイラストが素晴らしかったのでリピートさせてください。\n前回描いていただいたこちらの作品と似たようなシチュエーションです。\nhttps://skeb.jp/requests/2227833\n\n今回描いていただきたいのは、うちの子が↑の蛇よりも巨大な蛇と戯れているイラストです。\n↓うちの子の資料になります。前回とは別の格好です。\nhttps://drive.google.com/drive/folders/1S0vHYFr9yfIZZklTa1Q-ep81kgHLbedr?usp=drive_link\nシチュエーションは\n仰向けのうちの子に巨大な蛇が足から登り、腰からお腹に巻き付き、胸の間を這いずり上がって首筋から両腕に巻き付いている。\n表情は前回のイラストの表情が性癖に突き刺さったのであのような感じでお願いします。\n\nアウターは邪魔だと感じたら脱がせても大丈夫です。\n蛇の太さはうちの子の首くらいでお願いします。\n今回もパソコンの壁紙にしようと考えています。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kazaneWind/works/43", "thumbnail_src": "https://si.imgix.net/8cb41fdb/uploads/origins/5b69758e-12f2-45d2-b7b0-0db24e4db196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf3b88128b91f93526666bb55290e1a", "thumbnail_srcset": "https://si.imgix.net/8cb41fdb/uploads/origins/5b69758e-12f2-45d2-b7b0-0db24e4db196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf3b88128b91f93526666bb55290e1a, https://si.imgix.net/8cb41fdb/uploads/origins/5b69758e-12f2-45d2-b7b0-0db24e4db196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=977f3e7c15710b228006df74d145ad24 2x, https://si.imgix.net/8cb41fdb/uploads/origins/5b69758e-12f2-45d2-b7b0-0db24e4db196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=861dd6baaa1868fc242d43fc6d22f907 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ブルーアーカイブスのアスナのイラストをお願いします！\nこの画像のようなスポーツウェア姿（できればポニーテールなし）でお願いします！ https://imgur.com/xfdmWvD\nアングルはベッド越しにアスナの体を見下ろす一人称視点でお願いします。この画像のように https://imgur.com/sirOJL3\nヌードは描かないでください。\n\nシナリオは、アスナがベッドに拘束され、両腕を頭上に上げられ、手首をロープで縛られている。フレーム外から2本の手が伸びてきて、アスナの露出したお腹の真ん中を直接指でくすぐります。できれば、指先を腹にこすりつけるように、腹の皮膚との接触をはっきりさせてほしい。アスナは涙を流しながら目を閉じて大笑いするはずだ。アスナはもがきながらロープを引っ張ろうとするが、うまくいかない。", "created_at": "", "completed_at": ""}, {"path": "/@kazaneWind/works/42", "thumbnail_src": "https://si.imgix.net/8d9b1bad/uploads/origins/e0a7cd1c-0faf-440e-833a-4885d82a19ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a22984567a19736e960794285aae7e0", "thumbnail_srcset": "https://si.imgix.net/8d9b1bad/uploads/origins/e0a7cd1c-0faf-440e-833a-4885d82a19ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a22984567a19736e960794285aae7e0, https://si.imgix.net/8d9b1bad/uploads/origins/e0a7cd1c-0faf-440e-833a-4885d82a19ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59ee3d7883da894d7a599531ecdc569d 2x, https://si.imgix.net/8d9b1bad/uploads/origins/e0a7cd1c-0faf-440e-833a-4885d82a19ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=647a75ed0adf64bd64a398b53cc33585 3x", "genre": "art", "nsfw": true, "body": "風音さん、お久しぶりです。また僕のキャラクター、ペルセポネを描いてほしいんだ：\n\nhttps://drive.google.com/file/d/1bUdSA2M7jntFTm0sEMsDW0aEnlNp8U8i/view?usp=sharing\n\nhttps://drive.google.com/file/d/1PgABBgPCymJ3KPru92KYHtKev3Cj2fbO/view?usp=sharing\n\nhttps://drive.google.com/file/d/1GXh-QeRRByN3OVFO1EIg6kZ9FxgJPZlC/view?usp=sharing\n\nhttps://drive.google.com/file/d/1K3hri1LSedo5-YEiVSXQYQEPla-mf_e5/view?usp=sharing\n\nこの衣装とポーズで彼女を描いてください：\n\nhttps://drive.google.com/file/d/1FI8S2cXPeHFOZ_BMZJKvGpippeMOjBfU/view?usp=sharing\n\nペルセポネの胸が大きくなるバリエーションをいくつか描いてください。そのバリエーションでは、彼女のおっぱいは絶対に巨大化します。ビキニトップからはみ出し、ミルクが漏れる。\n\nペルセポネはとてもアスレチックな体格をしています。彼女の腹筋のディテールを描いてもらえるとありがたい。\n\nそれ以外は、彼女の性格はとてもドヤ顔で自信家です。ご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@kazaneWind/works/41", "thumbnail_src": "https://si.imgix.net/a371d034/uploads/origins/4c1535a1-0df0-4230-9123-c5fce2023d4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8166824ace51a227d45ea3a7172eaec6", "thumbnail_srcset": "https://si.imgix.net/a371d034/uploads/origins/4c1535a1-0df0-4230-9123-c5fce2023d4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8166824ace51a227d45ea3a7172eaec6, https://si.imgix.net/a371d034/uploads/origins/4c1535a1-0df0-4230-9123-c5fce2023d4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad17302369638358ca9808741b9745d5 2x, https://si.imgix.net/a371d034/uploads/origins/4c1535a1-0df0-4230-9123-c5fce2023d4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a058c976d73653a0eaac1184d34d02c 3x", "genre": "art", "nsfw": true, "body": "風音先生\nツイッターでカンナ（水着ver）の絵を拝見したのですが、特に水着から見える乳輪の形が大きくて、とても良いですね（https://fxtwitter.com/kazaneWind/status/1852599966239457427）。\n私のキャラと同じような絵を依頼してもよろしいでしょうか？(G.driveのリンクからbase.png)\nSFW/NSFW切替希望！\n\nhttps://drive.google.com/drive/folders/1BD58-IoKwHcJy5CGWOPE2sxJ3FPDpjlx?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kazaneWind/works/40", "thumbnail_src": "https://si.imgix.net/d9a63bb4/uploads/origins/9f02064a-9203-4b28-87fb-330a1a05be0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1dcca095cd6d60879364d2edfab4572", "thumbnail_srcset": "https://si.imgix.net/d9a63bb4/uploads/origins/9f02064a-9203-4b28-87fb-330a1a05be0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1dcca095cd6d60879364d2edfab4572, https://si.imgix.net/d9a63bb4/uploads/origins/9f02064a-9203-4b28-87fb-330a1a05be0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34f7b42be58bbff2d5f3ad0ee7960e1b 2x, https://si.imgix.net/d9a63bb4/uploa