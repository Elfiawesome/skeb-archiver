ix.net/886c04d2/uploads/origins/dc03c78c-f27d-41b7-9b9a-d73bab2b7ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=607247becdd0c1b5943094683dd730cb", "thumbnail_srcset": "https://si.imgix.net/886c04d2/uploads/origins/dc03c78c-f27d-41b7-9b9a-d73bab2b7ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=607247becdd0c1b5943094683dd730cb, https://si.imgix.net/886c04d2/uploads/origins/dc03c78c-f27d-41b7-9b9a-d73bab2b7ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ba58be94ac465b4bd83a6982e9c0ce7 2x, https://si.imgix.net/886c04d2/uploads/origins/dc03c78c-f27d-41b7-9b9a-d73bab2b7ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db4c6c5af5c1cf20be07b3d2b3c5e0c3 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストを拝見させてもらっています。\n以下の内容のカラーイラストをリクエストいたします。\n\nキャラクター：敷波（艦これ）\nシチュエーション：屋内でのボテ腹マタニティヌード\n背景：資料URLのような窓と赤レンガの壁\n詳細部分\n・乳首は少なくとも片方が見えていて、陰部は隠れてモザイク・黒線が不要な構図（ポーズはお任せします）\n・衣装は無し（全裸）\n・乳首は少し濃いめの色合いで、母乳が滴っている\n・陰毛は無し、または薄めの直毛\n・ケッコン指輪をネックレスにして着けている\n・イラスト内の人物は敷波だけ\n・セリフや擬音等のマンガ表現なし\n\nまた、通常体型（ボテ腹なし、普段描かれている色の乳首、母乳なし、ネックレスなし）差分\nもお願いしたいです。\n\nニッチなシチュエーションで恐縮ですが、ご検討よろしくお願いいたします。\n\nhttps://pbs.twimg.com/media/GdGrLB7agAAnv5H?format=jpg&name=orig", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/20", "thumbnail_src": "https://si.imgix.net/80579106/uploads/origins/5baec622-0f6d-46ba-a627-458713b2ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7de1a60cb6e7aabf6b638b8ded5e99e", "thumbnail_srcset": "https://si.imgix.net/80579106/uploads/origins/5baec622-0f6d-46ba-a627-458713b2ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7de1a60cb6e7aabf6b638b8ded5e99e, https://si.imgix.net/80579106/uploads/origins/5baec622-0f6d-46ba-a627-458713b2ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68f97bfc82ba552eaf1cea2d3194d518 2x, https://si.imgix.net/80579106/uploads/origins/5baec622-0f6d-46ba-a627-458713b2ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e84a4541f8eafb7fbdc9bc6fee7e1b2 3x", "genre": "art", "nsfw": true, "body": "黒桐月紫さん、はじめまして！可愛くなりたいエルフの女の子、ルーです！\n\nTwitterで黒桐月紫さんの超かわいいイラストを見たので、イラストをお願いしたいです！\nhttps://x.com/_/status/1959532297134502324\n\n透け透けの白い布を一枚、金色のワイヤーで留めています。胸はあまり隠れていません。下は私の下半身にかかるが、もっと短く、大事な部分はかろうじて覆っている。私の服は私には小さすぎて、少し圧迫感がある。ゴールドの首輪にゴールドのチェーン、その他のゴールドのアクセサリーをつけている。背中と脇は完全に露出している。下着はなし。裸足。\n\n私は無邪気に、優しく見る人を見上げている。私の腕は脇にある（私の体がよく見えるように）。背景は金色に輝いている。\n\n重要な部分をすべてカバーした \"健全な \"バージョン（差分）、露出度の高いバージョン、裸のバージョンが欲しい。表情もいくつか欲しいし、鎖のあるバージョンとないバージョンも欲しい！\n\nありがとうございました！\n\nhttps://cdn.rue.moe/rue-ref-v1.3.2.jpg", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/19", "thumbnail_src": "https://si.imgix.net/6a738930/uploads/origins/c9752871-f0e9-40d7-a1dc-76c7bd6b44f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=501f68677af3f104d8ac455fc074a5e2", "thumbnail_srcset": "https://si.imgix.net/6a738930/uploads/origins/c9752871-f0e9-40d7-a1dc-76c7bd6b44f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=501f68677af3f104d8ac455fc074a5e2, https://si.imgix.net/6a738930/uploads/origins/c9752871-f0e9-40d7-a1dc-76c7bd6b44f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f2a8e322e745cd51a523cfc9ba0edd3 2x, https://si.imgix.net/6a738930/uploads/origins/c9752871-f0e9-40d7-a1dc-76c7bd6b44f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe53d85d7491eec30415725cc1e68b45 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/18", "thumbnail_src": "https://si.imgix.net/37af9fe3/uploads/origins/0016b345-d11a-4455-9edd-159b9d77518f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=369a43e7f45d1665c933d233160f50c2", "thumbnail_srcset": "https://si.imgix.net/37af9fe3/uploads/origins/0016b345-d11a-4455-9edd-159b9d77518f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=369a43e7f45d1665c933d233160f50c2, https://si.imgix.net/37af9fe3/uploads/origins/0016b345-d11a-4455-9edd-159b9d77518f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50c8eb0ca33b157bf912775cddb72dd7 2x, https://si.imgix.net/37af9fe3/uploads/origins/0016b345-d11a-4455-9edd-159b9d77518f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da9063597e6d5f0f90a3b251acde6630 3x", "genre": "art", "nsfw": true, "body": "艦これのFletcher(フレッチャー)に頭を撫でられながら膝枕で授乳手コキしてもらうところをお願いします。\n\nFletcherの表情は困り顔であやしているセリフを入れて欲しいです。\nセリフ例：「よしよし」「いいこいいこ」「しょうがないですねぇ」など\n上記の雰囲気に合っていれば、これ以外でも構いません。\n\n描きにくいところはアレンジしていただいても構いません。\n\n可能であれば、下記の差分を作成してほしいです。\n・射精\n・母乳の噴き出し\n・表情：母乳を吸われ感じている表情\n・表情：満足げな笑顔\n\n上記以外はお任せいたします。\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/17", "thumbnail_src": "https://si.imgix.net/69543348/uploads/origins/fa9b67a9-983d-4d5e-8d9b-c815db617cb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eff81765d7ddcbd44a0491515921aa8c", "thumbnail_srcset": "https://si.imgix.net/69543348/uploads/origins/fa9b67a9-983d-4d5e-8d9b-c815db617cb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eff81765d7ddcbd44a0491515921aa8c, https://si.imgix.net/69543348/uploads/origins/fa9b67a9-983d-4d5e-8d9b-c815db617cb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4a77152dd3cdd6086394a5a13023ea3 2x, https://si.imgix.net/69543348/uploads/origins/fa9b67a9-983d-4d5e-8d9b-c815db617cb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=118659f404e10b7fcd67b25a40b5e496 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/16", "thumbnail_src": "https://si.imgix.net/3bee5ceb/uploads/origins/c234e668-ece6-43cd-a9a9-6bd00c29915e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27ce02f6d9bc46a3241153b679225046", "thumbnail_srcset": "https://si.imgix.net/3bee5ceb/uploads/origins/c234e668-ece6-43cd-a9a9-6bd00c29915e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27ce02f6d9bc46a3241153b679225046, https://si.imgix.net/3bee5ceb/uploads/origins/c234e668-ece6-43cd-a9a9-6bd00c29915e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bda2a655f69bb4a7f182f0f57120219c 2x, https://si.imgix.net/3bee5ceb/uploads/origins/c234e668-ece6-43cd-a9a9-6bd00c29915e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=091f27f3d7b324fe1a1a3499ba137233 3x", "genre": "art", "nsfw": true, "body": "こんにちは！鹿ノ戸かおると申します。\nいつも黒桐様のイラスト拝見させて頂いてます。\n時雨ちゃんのイラストを見たときに一目惚れして依頼したいと思っていたので依頼させていただきます。\n\n依頼内容は以下になります。\n・下記URLのキャラクター（鹿ノ戸かおる）のイラストをお願いしたいです\n・使用用途としてはXや配信での使用、宣伝、投稿で使用させていただければと思います\n・縦イラスト（立ち絵）\n・表情差分でかわいい表情、ジト目で悪い笑顔（こちらは対応できる場合で結構です）\n・衣装は新モデル、旧モデルのどちらか　黒桐様の好みで結構です\n・ムチムチな絵が大好きなので盛りまくってもらって問題ないです　むしろ大歓迎です\n・ポーズやシチュエーション等は黒桐様が思う「鹿ノ戸かおる」をイメージで自由に描いていただければと思っています（胸が強調されているとありがたいです）\n\nよろしくお願いいたします！\n\nhttps://x.com/kanotochan_nel/status/1692153828618174518\nhttps://x.com/kanotochan_nel/status/1511263959529132040", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/15", "thumbnail_src": "https://si.imgix.net/c466379c/uploads/origins/b0dc7aa6-4a52-49f6-9d3d-2e1afe17beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09fb8de18673e2d0155b8a964cf4bf3", "thumbnail_srcset": "https://si.imgix.net/c466379c/uploads/origins/b0dc7aa6-4a52-49f6-9d3d-2e1afe17beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09fb8de18673e2d0155b8a964cf4bf3, https://si.imgix.net/c466379c/uploads/origins/b0dc7aa6-4a52-49f6-9d3d-2e1afe17beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=867ca93570681da4eb8b7e30741c99b1 2x, https://si.imgix.net/c466379c/uploads/origins/b0dc7aa6-4a52-49f6-9d3d-2e1afe17beeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50a5423320ea72b34152c67233c3a69f 3x", "genre": "art", "nsfw": true, "body": "前回の依頼で時雨さんの魅力をさらに味わうことができて、依頼して本当に良かったです\n依頼立て込んでいるかと思いますが、再び時雨さんのイラストお願いできれば幸いです\n\n改三の水着が大人気なので、ぜひ自分もお願いしたいです\n設定的に前回と同じく年下の提督候補生（画面外で描写なし）に水着姿を見せつけるようにしてほしいです\n構図はおまかせしたいです\nセリフをまたお願いしたいのですが「その様子だと、下着じゃなくて水着でもいいんだね～ふぅん」と入れて欲しいです（収まり悪ければアレンジお願いしたいです）\nお時間が合いましたら、なにとぞお引き受けいただけると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/14", "thumbnail_src": "https://si.imgix.net/35768632/uploads/origins/03fe87c0-c8a5-42fb-97fc-a19153b3b1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66469780c35d56ac8d24a678008ae343", "thumbnail_srcset": "https://si.imgix.net/35768632/uploads/origins/03fe87c0-c8a5-42fb-97fc-a19153b3b1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66469780c35d56ac8d24a678008ae343, https://si.imgix.net/35768632/uploads/origins/03fe87c0-c8a5-42fb-97fc-a19153b3b1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=204e987b04ea58f061a398d483228076 2x, https://si.imgix.net/35768632/uploads/origins/03fe87c0-c8a5-42fb-97fc-a19153b3b1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5e09f6c747c0e2818158587f2b921b6 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！\nうちの子で依頼したいのですが\n見た目は資料に置いておきますので、見ていただければ‥\n服装などはお任せしますが、何かしら上着羽織ってる事が多いイメージではあります\n出来れば酒瓶辺り持たせておいてくれたら良いかなーとかで基本はお任せです\nよろしければお願いします\n\nhttps://twitter.com/Solitude_bubble/status/1693865655181902286?t=98EUMjXX-U5hkQLhRUV9Wg&s=19", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/13", "thumbnail_src": "https://si.imgix.net/3bb99068/uploads/origins/e298f429-3042-481e-8755-1cea41f0feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227743bf98581af7951109adcd07c622", "thumbnail_srcset": "https://si.imgix.net/3bb99068/uploads/origins/e298f429-3042-481e-8755-1cea41f0feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227743bf98581af7951109adcd07c622, https://si.imgix.net/3bb99068/uploads/origins/e298f429-3042-481e-8755-1cea41f0feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=807ffb7f75c7e1e61be695d2a4dac245 2x, https://si.imgix.net/3bb99068/uploads/origins/e298f429-3042-481e-8755-1cea41f0feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e50163205f7f6dbad1fddda4dc370652 3x", "genre": "art", "nsfw": true, "body": "はじめまして、時雨ちゃんのイラスト依頼できますか？\n内容的には佐世保mode（https://thup.work/miniup/?mode=dl&id=15495）の服装で、スカートをたくし上げて下着（黒・赤・紫のいずれかで、デザインお任せしたいです）を見せつけている様子を描いて欲しいです\nもし可能でしたら「僕に興味なんてないんだよね？」というセリフもお願いしたいです\n本人が自分へ興味を持っている対象（年下の提督候補生）に、余裕のある笑みを浮かべている表情でお願いしたいです\nお引き受けいただけたら嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/12", "thumbnail_src": "https://si.imgix.net/07f2a5e7/uploads/origins/33ddc22e-667d-457c-997a-46dc6398f678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86995f4824cdfcdbbf8f788b5f2a840", "thumbnail_srcset": "https://si.imgix.net/07f2a5e7/uploads/origins/33ddc22e-667d-457c-997a-46dc6398f678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86995f4824cdfcdbbf8f788b5f2a840, https://si.imgix.net/07f2a5e7/uploads/origins/33ddc22e-667d-457c-997a-46dc6398f678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=676dc0ad859e2fa61cdfd03caad8bbec 2x, https://si.imgix.net/07f2a5e7/uploads/origins/33ddc22e-667d-457c-997a-46dc6398f678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8570da7bd48d37b7dec7a84a341a3dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。個人vtuberをしている七尾望と申します。\nTwitterのアイコンにされている子が非常にかわいかったため、ぜひお願いしたいなと思い依頼しました。\n\n依頼内容は以下になります。\n・下記URLの資料にあるキャラクター（私）のイラストをお願いしたいです。\n・縦イラストで立ち姿\n・可能であればかわいい表情とクールな表情の差分があれば嬉しいです。\n・衣装は資料先のチャイナ衣装かサイバー衣装のどちらか\n・他ポーズやシチュエーション等はお任せいたします。\n・twitterやFanbox等に投稿するかもしれません。\n以上になります。\nよろしくお願いします！\n\nn299892003.fanbox.cc/posts/4216931\nhttps://www.amazon.co.jp/clouddrive/share/O0EontWtFF3ggDTJD6KhZLi8Dn22DD9r3wTt8TQnQM9", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/11", "thumbnail_src": "https://si.imgix.net/539fa2c0/uploads/origins/15bfed0d-f0b3-4d31-9fe1-34fe6df2435a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41421e35df051995e0169e8e1527363d", "thumbnail_srcset": "https://si.imgix.net/539fa2c0/uploads/origins/15bfed0d-f0b3-4d31-9fe1-34fe6df2435a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41421e35df051995e0169e8e1527363d, https://si.imgix.net/539fa2c0/uploads/origins/15bfed0d-f0b3-4d31-9fe1-34fe6df2435a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e3e937403e4b89d560c9e3171aa7f39 2x, https://si.imgix.net/539fa2c0/uploads/origins/15bfed0d-f0b3-4d31-9fe1-34fe6df2435a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8a8f3b124887c0eabbb7a3450459a38 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はニラです!あなたの絵が大好きです!\n 私と友達のエバキの全身イラストを描いていただけませんか？\n服装を入れ替えて描いてほしいです（ニラがエバキの服装、エバキがニラの服装）。\n牙、翼、コウモリ耳、クリップなど、服の細部も含めてお願いします。\nまた、イラストの透明バージョンも用意していただけると嬉しいです\n\nキャラクターリファレンスとポーズリファレンスの両方を以下に添付します。\nhttps://drive.google.com/drive/folders/1AIHZNzvOGj207zGjc7pj4TaTST0lyTtv\n\nhttps://drive.google.com/drive/folders/1AIHZNzvOGj207zGjc7pj4TaTST0lyTtv", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/10", "thumbnail_src": "https://si.imgix.net/1d71884a/uploads/origins/02211cda-ff28-41c5-94cd-2d6048a97dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f32e13911254c2d361a09863b807e6", "thumbnail_srcset": "https://si.imgix.net/1d71884a/uploads/origins/02211cda-ff28-41c5-94cd-2d6048a97dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f32e13911254c2d361a09863b807e6, https://si.imgix.net/1d71884a/uploads/origins/02211cda-ff28-41c5-94cd-2d6048a97dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0355ae2521ac5749ac899daade0f6c16 2x, https://si.imgix.net/1d71884a/uploads/origins/02211cda-ff28-41c5-94cd-2d6048a97dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caaadb5f87a06c2c4e9c6fa3073bc184 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！\nイラストの依頼なのですが\n遊戯王のティアラメンツメイルゥを書いて頂きたいです\n構図諸々は書きやすいもので、お任せします\nもしよろしければアイコン等に使用したいですので、よしなにお願いします", "created_at": "", "completed_at": ""}, {"path": "/@goto123kokutoh/works/9", "thumbnail_src": "https://si.imgix.net/5f996613/uploads/origins/cf00c6f1-bfc6-44cd-a364-59d14372e533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=294338a361fc3ad5165074d9112e0674", "thumbnail_srcset": "https://si.imgix.net/5f996613/uploads/origins/cf00c6f1-bfc6-44cd-a364-59d14372e533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=294338a361fc3ad5165074d9112e0674, https://si.imgix.net/5f996613/uploads/origins/cf00c6f1-bfc6-44cd-a364-59d14372e533?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d210f8f66d712