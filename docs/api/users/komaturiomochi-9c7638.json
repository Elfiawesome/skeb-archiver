%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9af0e2b2636151e09f2275ed46cb6796 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/90", "thumbnail_src": "https://si.imgix.net/e3c8bdc1/uploads/origins/3e1c2652-2e45-4151-9ae1-58dd6780d534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee387e954ab78161eb7214d62e3897fc", "thumbnail_srcset": "https://si.imgix.net/e3c8bdc1/uploads/origins/3e1c2652-2e45-4151-9ae1-58dd6780d534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee387e954ab78161eb7214d62e3897fc, https://si.imgix.net/e3c8bdc1/uploads/origins/3e1c2652-2e45-4151-9ae1-58dd6780d534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=182066d462f82c2d49f8b14df626107d 2x, https://si.imgix.net/e3c8bdc1/uploads/origins/3e1c2652-2e45-4151-9ae1-58dd6780d534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e5385f0c92477dab00ad96dceb5afa7 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/89", "thumbnail_src": "https://si.imgix.net/803b5b12/uploads/origins/6e70102e-a9bb-4ee2-a529-c4221b40825e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f13a91edb986d7ad5c965d175764bf78", "thumbnail_srcset": "https://si.imgix.net/803b5b12/uploads/origins/6e70102e-a9bb-4ee2-a529-c4221b40825e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f13a91edb986d7ad5c965d175764bf78, https://si.imgix.net/803b5b12/uploads/origins/6e70102e-a9bb-4ee2-a529-c4221b40825e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=549658ce96fb29908abe2555682390df 2x, https://si.imgix.net/803b5b12/uploads/origins/6e70102e-a9bb-4ee2-a529-c4221b40825e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87c664f1f0d112490012b60da6d2373d 3x", "genre": "art", "nsfw": false, "body": "お世話になります\n\n最近暑い日が続いているので、かき氷を食べている水着の射命丸文と姫海棠はたてをお願いします。\n私の癖で申し訳ないですが、2人ともセパレートタイプの水着だと尚嬉しいです。\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/88", "thumbnail_src": "https://si.imgix.net/e84e6461/uploads/origins/0bf5f0f7-d859-47d3-9824-bad9aa4f37a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85543516c5d794dbd744930f9c36acc1", "thumbnail_srcset": "https://si.imgix.net/e84e6461/uploads/origins/0bf5f0f7-d859-47d3-9824-bad9aa4f37a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85543516c5d794dbd744930f9c36acc1, https://si.imgix.net/e84e6461/uploads/origins/0bf5f0f7-d859-47d3-9824-bad9aa4f37a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d57cebbfa49305ba5469e7e40c6aead 2x, https://si.imgix.net/e84e6461/uploads/origins/0bf5f0f7-d859-47d3-9824-bad9aa4f37a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b8441b8a6a6038e3f5a4fe826b7d8fe 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、先日はありがとうございました。\nまたご検討頂ければ幸いです。\n費用面などで問題があればキャンセルや再送依頼をお願い致します。\n\n◯キャラクター\nスマホゲーム「東方LostWord」より「華やぐ悪魔の妹　フランドール・スカーレット（桜フラン、C5>フラン）」「花咲く恋の瞳　古明地こいし（桜こいし、C5>こいし）」\n・二人とも元々のキャラクターよりも少し見た目も言動も幼いです（過剰なロリ体型である必要はありません、具体的な体型は良いようにお任せ致します）\n\nまた、髪の毛や瞳や衣服の色、膝上より更に上までの丈の健康的な太ももまで見えるスカートのような大きな変更点のほか、下記のような学校の生徒のような格好の細かい変更点が見られます\n・桜フラン：ピンクのリコーダー、赤いランドセル、帽子がフリルではなくなっている、腰には熊の飾りが付いたリボン、巻きスカート、サイドテールは先端が桜の花のような形状…など\n・桜こいし：ピンクの移植ゴテ（掬う部分の先端部半分は銀色）、ピンクのランドセルとサードアイの模様の給食袋、サードアイの見た目の防犯ブザーのようなキーホルダー…など\n\nhttps://touhoulostword.com/2024/12/20/220964/\nhttps://touhoulostword.com/2025/05/23/223200/\n\n◯シチュエーション\n・下記に記載致しますが、改変などは全てお任せ致します\n・16:9程度の横長だと幸いです\n・ゲーム内表記は「常春に酔う世界（C5>世界群）」、一年を通して春であり、桜を中心に植物などが異常増殖しているパラレルワールドです\n・全体的に桜色成分多めでお願い致します\n・花びらが舞う桜の木の下の芝生にピクニックマットを敷いて荷物を脇に置き、楽しそうにお弁当を食べている\n・こいしちゃんがお姉さんぶっており、食べるのに夢中なフランちゃんに次の食べ物を差し出している、もしくは口の周りを拭いてあげようとしている（より良い描写がありましたらお願い致します）\n・お弁当にもさくらんぼが入っていたり、その他小瓶などに赤や緑のドレンチェリーなどが入っていたりする（フランちゃんの好物）\n・二人が仲良くしているだけ、もしくは二人またはどちらかがこちらに気づいて目線を寄越している（お任せ致します）\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/87", "thumbnail_src": "https://si.imgix.net/f266055b/uploads/origins/59a4fce9-333c-4cdb-95e0-23002b4872d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dbf11819af632a4b7203e60a6eb54c1", "thumbnail_srcset": "https://si.imgix.net/f266055b/uploads/origins/59a4fce9-333c-4cdb-95e0-23002b4872d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dbf11819af632a4b7203e60a6eb54c1, https://si.imgix.net/f266055b/uploads/origins/59a4fce9-333c-4cdb-95e0-23002b4872d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=714bad6cc3b12c528249993a54fb11d9 2x, https://si.imgix.net/f266055b/uploads/origins/59a4fce9-333c-4cdb-95e0-23002b4872d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=803597c5654d1e8f69aa6c5fc48ffa6b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/86", "thumbnail_src": "https://si.imgix.net/0bba1e5e/uploads/origins/73c7c9db-1a28-45e8-ab98-7e8dd7ac324d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0995bf0c208af9f3bc5942da3aa88a0", "thumbnail_srcset": "https://si.imgix.net/0bba1e5e/uploads/origins/73c7c9db-1a28-45e8-ab98-7e8dd7ac324d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0995bf0c208af9f3bc5942da3aa88a0, https://si.imgix.net/0bba1e5e/uploads/origins/73c7c9db-1a28-45e8-ab98-7e8dd7ac324d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d876613f83f19012f30256ec09714ec8 2x, https://si.imgix.net/0bba1e5e/uploads/origins/73c7c9db-1a28-45e8-ab98-7e8dd7ac324d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28612a1376306c1377b8df046a7cab83 3x", "genre": "art", "nsfw": false, "body": "東方の九十九弁々、九十九八橋、少名針妙丸のイラストを一枚絵でお願いします。\n服装は弁々がワンピース姿、八橋が半袖の上衣にショートパンツ、針妙丸が浴衣姿、\n身長は弁々と八橋が同じ、針妙丸は二人の約半分の小ささ、\nシチュエーションは弁々と八橋が針妙丸を間に挟む形で\n三人手を繋いで夏の人里を楽しそうに散歩するシーン、\n構図は弁々と八橋がそれぞれのつないだ手を前に向けて振り、\n間の子供サイズの針妙丸がぴょんと地面を離れて嬉しそうに笑ってる、でお願いします。\nよろしくお願いします!", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/85", "thumbnail_src": "https://si.imgix.net/e0875284/uploads/origins/639541fc-f62d-4e30-ab9e-2fcafb98130a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b0f7d2f156e3c0e006dd91ed46dad44", "thumbnail_srcset": "https://si.imgix.net/e0875284/uploads/origins/639541fc-f62d-4e30-ab9e-2fcafb98130a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b0f7d2f156e3c0e006dd91ed46dad44, https://si.imgix.net/e0875284/uploads/origins/639541fc-f62d-4e30-ab9e-2fcafb98130a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f841e0fe49720a32d53e0b0cf10b2326 2x, https://si.imgix.net/e0875284/uploads/origins/639541fc-f62d-4e30-ab9e-2fcafb98130a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a6f3ee1913c0e0a1c3e6f5db944537c 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/84", "thumbnail_src": "https://si.imgix.net/64e082a6/uploads/origins/5435e56d-74d2-44ed-8cac-6904cba99bef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24c8714b95ac3f4d2e94075c0a12c24", "thumbnail_srcset": "https://si.imgix.net/64e082a6/uploads/origins/5435e56d-74d2-44ed-8cac-6904cba99bef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24c8714b95ac3f4d2e94075c0a12c24, https://si.imgix.net/64e082a6/uploads/origins/5435e56d-74d2-44ed-8cac-6904cba99bef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e41a30299821f1be0a7af93a3feda7aa 2x, https://si.imgix.net/64e082a6/uploads/origins/5435e56d-74d2-44ed-8cac-6904cba99bef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba6c2168e250c8de735519de623dafe1 3x", "genre": "art", "nsfw": true, "body": "お世話になってます。また私の性癖にお付き合い下さい。\n\n裸リボンに溶けかけのチョコがかかってるメルランと弁々をお願いします。\n2人ともベットの上に仰向けになっており、パートナーとえっちをした後の満足している表情でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/83", "thumbnail_src": "https://si.imgix.net/da091bd9/uploads/origins/56b30f4a-ab8e-484b-83c7-2b4651eda7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993ada235e5a6e32a2a2078f135e4443", "thumbnail_srcset": "https://si.imgix.net/da091bd9/uploads/origins/56b30f4a-ab8e-484b-83c7-2b4651eda7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993ada235e5a6e32a2a2078f135e4443, https://si.imgix.net/da091bd9/uploads/origins/56b30f4a-ab8e-484b-83c7-2b4651eda7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b76ad338fbd9a49bd81d05b0ab647161 2x, https://si.imgix.net/da091bd9/uploads/origins/56b30f4a-ab8e-484b-83c7-2b4651eda7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a57594ed8f8a5d13a93bfa2af6e360c1 3x", "genre": "art", "nsfw": false, "body": "昨年はお世話になりました。\nまたリクエストさせて頂きます。\n\n横長（16:9程度の壁紙サイズ）でお願い致します。\n\n◯キャラクター\nスマホゲーム「東方LostWord」より、「ハンター狩りの吸血鬼 フランドール・スカーレット（秘封フラン）」と「小さな悪魔令嬢 レミリア・スカーレット（秘封レミリア）」（下記URL）\n（厳密には東方Projectの三次創作という形になるかと思われますので、難しければ出直しますのでキャンセルをお願いします）\n二人ともパラレルワールドのフランとレミリアです（また二人はそれぞれ別のパラレルワールド出身ですが、実の姉妹のように仲良しです）\n秘封フラン：通常のフランより身体も精神も少し大人びている\n秘封レミリア：通常のレミリアよりも若く身体が少し小さい、精神的にはそこまで幼いわけではない\nそのため身体の大きさは頭一つ分程度の差があり、フラン＞レミリアとなるようにお願いします\n\nまた二人とも瞳孔の中心が少し白っぽく描写されています\n髪や服の色以外にも、レミリアの帽子のリボンやフランの羽根などにオリジナル（？）との微細な差があるため可能な範囲で再現して頂ければ幸いです\n\n○シチュエーション\nなるべく全身像で、二人ともベッド等に座ったり寝そべったりして抱き合いながらこちらを向いて微笑んでいる状態\n百合っぽい雰囲気というよりは、こちらを誘惑・挑発しているイメージ\nその他の細かい描写はお任せ致します\n\nhttps://www.youtube.com/watch?v=0x2itWZANNg\nhttps://dic.pixiv.net/a/%E3%83%8F%E3%83%B3%E3%82%BF%E3%83%BC%E7%8B%A9%E3%82%8A%E3%81%AE%E5%90%B8%E8%A1%80%E9%AC%BC\nhttps://www.youtube.com/watch?v=wB3g7PjReCU\nhttps://dic.pixiv.net/a/%E5%B0%8F%E3%81%95%E3%81%AA%E6%82%AA%E9%AD%94%E4%BB%A4%E5%AC%A2\n\nPSD形式で、宛名と先生のサインを別レイヤーでお願いします。\n\n費用面で問題があれば、キャンセルや再送依頼をお願いします。\nご検討のほど、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/82", "thumbnail_src": "https://si.imgix.net/09455bd1/uploads/origins/70c0d6d3-f90f-430e-a6dc-467f7ba2abc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=126a3c0154da7ce3c5da0810174e428d", "thumbnail_srcset": "https://si.imgix.net/09455bd1/uploads/origins/70c0d6d3-f90f-430e-a6dc-467f7ba2abc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=126a3c0154da7ce3c5da0810174e428d, https://si.imgix.net/09455bd1/uploads/origins/70c0d6d3-f90f-430e-a6dc-467f7ba2abc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99829522605ab229b2f50534537dcbf6 2x, https://si.imgix.net/09455bd1/uploads/origins/70c0d6d3-f90f-430e-a6dc-467f7ba2abc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d3817bdcdba422bfc34f52e92d36fc5 3x", "genre": "comic", "nsfw": true, "body": "また依頼させていただきます！\n水泳大会の騎馬戦で白蓮さん、こころちゃん、屠自古さん、青娥さんがポロリする以下の漫画をお願いします！\n\n【1ページ目】\n騎馬戦中に不意打ちで青娥が白蓮(ポニーテール)のビキニの首紐を解き、ポロリさせる。白蓮は突然の出来事に混乱しつつ、恥ずかしさで固まっている。\n続いて、青娥はこころのビキニのブラを剥ぎ取りポロリさせる。こころは驚きながら赤面している。\n\n【2ページ目】\n青娥は、この光景を見ていた屠自古に怒られるも、こころから奪ったブラをひらひらさせながら「みなさ～ん蘇我様のポロリが見たいですか～？」と悪びれもなく言う。\n次の標的が屠自古になったことで男性陣は盛り上がり、屠自古は「は、はぁ！？」と赤面して慌てる。\n屠自古に襲い掛かる青娥。青娥の手慣れた技に押される屠自古。\n\n【3ページ目】\nビキニのブラを剥ぎ取られポロリしてしまう屠自古。\n屠自古は悲鳴をあげながら胸を隠す。青娥は奪ったブラを周りの男性陣に投げ、男性陣は興奮しながらそれを取り合っている。屠自古のエッチな姿に、神子は心配するのも忘れて興奮している。\n\n【4ページ目】\n3ページ目のIFルート。\n青娥の背後に白蓮とこころが現れる。2人は片腕で自身の胸を隠しながらも、もう片方の腕で青娥の腕を掴む。\n両腕を封じられ焦る青娥。盛り上がる男性陣。屠自古が青娥のビキニの首紐を解いてポロリさせる。\n赤面し、ポロリを恥じらい悲鳴をあげる青娥。\n\n・白蓮、屠自古、青娥の胸は早苗くらいの大きさ。こころは彼女らより少し小さい。\n・騎馬戦用の鉢巻き等はつけていない(鑿等の頭飾りが代わり)。\n・白蓮はフリル付黒ビキニ。青娥、こころはフリル付ビキニで装飾多め。\n・ポロリ時はほどほどに胸が揺れている。\n・ポロリの度に周りの男性陣の歓喜する反応も描いてください。\n・キャラがポロリするコマは大きめ(ページの4割以上)で、ポロリしたキャラの表情や胸が斜め前から見える構図でお願いします。キャラの首と目線は自身の胸の方を向いており、表情は赤面＆驚き恥じらっている感じにしてください。なお、前回依頼(咲夜と早苗)よりも前々回依頼(文とアリス)のように高橋先生の描きやすい絵柄で描いていただく方が良いと思ったので、前回依頼の表情指定は忘れてください。\n・描きにくい箇所は高橋先生の描きやすいように適宜アレンジしてください。", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/81", "thumbnail_src": "https://si.imgix.net/8a9ff104/uploads/origins/90f21bb0-d15a-496a-b9be-11be53aab9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59dd3ad35cc03cd86c8bae1d503d4b90", "thumbnail_srcset": "https://si.imgix.net/8a9ff104/uploads/origins/90f21bb0-d15a-496a-b9be-11be53aab9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59dd3ad35cc03cd86c8bae1d503d4b90, https://si.imgix.net/8a9ff104/uploads/origins/90f21bb0-d15a-496a-b9be-11be53aab9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60f1707e237fc289d9f211601fe753bc 2x, https://si.imgix.net/8a9ff104/uploads/origins/90f21bb0-d15a-496a-b9be-11be53aab9f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a35615b3977cf22658516b495440854c 3x", "genre": "art", "nsfw": false, "body": "東方の九十九弁々と鬼人正邪のイラストを一枚絵でお願いします。\n服装は弁々がライトブルーのドレス(丈は膝が丁度隠れる長さ)、\n正邪が黒を基調にしたカジノのディーラー服(下はスカートで丈は膝が丁度見える長さ)、\nシチュエーションはカジノでテーブル越しに向かい合ってカード勝負をしている二人、\n劣勢に焦る気持ちが顔に出る弁々と余裕の微笑を浮かべる正邪、でお願いします。\nよろしくお願いします!", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/80", "thumbnail_src": "https://si.imgix.net/5680a444/uploads/origins/8ff844ad-ba15-49ec-b4a6-b8bc7e865c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4965f2b40f3ed9b7685070705709d15e", "thumbnail_srcset": "https://si.imgix.net/5680a444/uploads/origins/8ff844ad-ba15-49ec-b4a6-b8bc7e865c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4965f2b40f3ed9b7685070705709d15e, https://si.imgix.net/5680a444/uploads/origins/8ff844ad-ba15-49ec-b4a6-b8bc7e865c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc266886d353e28d6ece5a22357189cd 2x, https://si.imgix.net/5680a444/uploads/origins/8ff844ad-ba15-49ec-b4a6-b8bc7e865c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f02057755110528f3d0940a770241c5b 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/79", "thumbnail_src": "https://si.imgix.net/0820fdf5/uploads/origins/0182647a-062f-4a4c-ab77-21fb74237b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5b1ed3ad62cf039a14769310f01b39", "thumbnail_srcset": "https://si.imgix.net/0820fdf5/uploads/origins/0182647a-062f-4a4c-ab77-21fb74237b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5b1ed3ad62cf039a14769310f01b39, https://si.imgix.net/0820fdf5/uploads/origins/0182647a-062f-4a4c-ab77-21fb74237b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bffdbaf3140f9253d9f516f3e757df6b 2x, https://si.imgix.net/0820fdf5/uploads/origins/0182647a-062f-4a4c-ab77-21fb74237b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a51871427093b4d40d7520dce40036b 3x", "genre": "comic", "nsfw": true, "body": "はじめまして！咲夜さんと早苗さんの騎馬戦漫画が好みだったので依頼させていただきます！\n\n【1ページ目】\n『咲夜さんの休日』というタイトルを挿入。黒のビキニ姿で優雅にビーチを歩く咲夜(カチューシャあり、胸盛り気味)。歩くたびにたぷんと揺れる胸(可能ならばぷりんと揺れるお尻も)を見て、モブたちはだらしない表情で『おぉ…♡』という声。そんなことには気づかず、『たまにはこういうのも悪くないわね…』と内心でこぼす咲夜。\n\nと、そこで砂浜で遊んでいた青年が目の前で『わっ！』とすっ転び、リラックスしている咲夜の上の水着をがしっとつかんでしまう。\n\n【2ページ目】\n水着をずり下ろされ、大ゴマで盛大にポロリ。弾む胸、『ぶるる～んっ♡』という派手な擬音。咲夜はきょとんとした表情。背景には驚きとともに、赤面したり鼻血を出したりするモブたち。\n\n飛び出た余韻でたぷたぷと胸が揺れ、ビーチがざわめきに包まれる中ワンテンポ遅れて自分の状況を理解した咲夜は、顔を赤くして口元を引きつらせ、『……へ？』とつぶやく。\n\n【3ページ目】\n引きの構図となり(背景は晴天の青空)、咲夜が悲鳴を上げる(フキダシ内にコメディ調で恥ずかしがる咲夜の顔)。モブたちから大歓声。シャッター音や『撮っとけ撮っとけ！』、他興奮を表すヤジも。\n\n大き目のコマで咲夜のポロリ写真を描写(可能であれば二枚、無理なら一枚。自分の状況に気づいた瞬間のもの(優先度高)と、慌てて胸を隠そうとしているところ)。同じコマに『いやぁ眼福眼福』、『最高のラッキースケベだな～♡』というセリフ。\n\n次の横長い一コマで、それを見ながら『あのメイド服の下にはこんな凶器が…』『咲夜さんすげぇ…』『次見かけたとき想像しちゃうよ』などと興奮した様子で和気あいあいと話す三人のモブと、顔をかーっと赤くしながら彼らのそばを通り過ぎる咲夜の姿(場所は人里なのでメイド服着用。デフォルメ調にしてくれても大丈夫です)。同時に『あの後めちゃくちゃ流出した』というナレーションを入れてシメ。\n\n※モブは極簡素な造形で大丈夫です。\n\n以上です。ご検討のほど、何卒よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/78", "thumbnail_src": "https://si.imgix.net/90457e42/uploads/origins/95164cb6-2fa5-4fd4-b246-e493bcb0368f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307080bd20fd98e5d6047ef72184f2c7", "thumbnail_srcset": "https://si.imgix.net/90457e42/uploads/origins/95164cb6-2fa5-4fd4-b246-e493bcb0368f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307080bd20fd98e5d6047ef72184f2c7, https://si.imgix.net/90457e42/uploads/origins/95164cb6-2fa5-4fd4-b246-e493bcb0368f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=204bf10fd85444f89180f38480e59342 2x, https://si.imgix.net/90457e42/uploads/origins/95164cb6-2fa5-4fd4-b246-e493bcb0368f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d4d381e3102a1c8d34d4c1c6377c915 3x", "genre": "comic", "nsfw": true, "body": "お世話になっております。また我儘にお付き合い頂きたくお願いします。\n\nパートナーからタイツを履いてほしいと頼まれた弁々。それまでタイツ未経験だった弁々で、別の日試しにメルランから勧められた黒タイツを着用していたところを偶々パートナーに見られてしまう。早速トライしていたところを見られたことが恥ずかしくなってしまう弁々だったが、パートナーが勃っていることに気づき、逆にいじわるすることに。\nそれまで履いていたタイツでパートナーの性器をいじるが、あと少しで絶頂を迎えるところで我慢できなくなったパートナーが弁々を襲って最終的に中に出してしまう...という展開。\n\n中に出したあとは嬉しそうに「できちゃうじゃない...」というセリフをパートナーの耳元に囁いたところ、興奮したパートナーと2回戦に入ってしまう...というシメでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@komaturiomochi/works/77", "thumbnail_src": "https://si.imgix.net/9244dcef/uploads/origins/9d3b24e9-dcd6-4273-a20f-e3ebd8aaeccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1010b3a665a49771d397610230e77fa", "thumbnail_srcset": "https://si.imgix.net/9244dcef/uploads/origins/9d3b24e9-dcd6-4273-a20f-e3ebd8aaeccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1010b3a665a49771d397610230e77fa, https://si.imgix.net/9244dcef/uploads/origins/9d3b24e9-dcd6-4273-a20f-e3ebd8aaeccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f92233ca2128bcdbe5778e4c428a6944 2x, https://si.imgix.net/9244dcef/uploads/origins/9d3b24e9-dcd6-4