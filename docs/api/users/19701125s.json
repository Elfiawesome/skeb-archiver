d=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed417d5a2aaff80ae78e2b4f6f5e6474 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/56", "thumbnail_src": "https://si.imgix.net/04091601/uploads/origins/854467b1-6639-4381-9dbb-07c0d0f2ea01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec33f531b8e02f16da19a589cc64898", "thumbnail_srcset": "https://si.imgix.net/04091601/uploads/origins/854467b1-6639-4381-9dbb-07c0d0f2ea01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec33f531b8e02f16da19a589cc64898, https://si.imgix.net/04091601/uploads/origins/854467b1-6639-4381-9dbb-07c0d0f2ea01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ab803b3d3c7709d4dde5690dc231956 2x, https://si.imgix.net/04091601/uploads/origins/854467b1-6639-4381-9dbb-07c0d0f2ea01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be9903d63b4f86e9cdab6555cda71bb4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/55", "thumbnail_src": "https://si.imgix.net/ead06ee8/uploads/origins/9593d1ac-a46d-4c95-85f6-54cd4427000b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e692fd41e900da09f9e2a5ffdec4a9c4", "thumbnail_srcset": "https://si.imgix.net/ead06ee8/uploads/origins/9593d1ac-a46d-4c95-85f6-54cd4427000b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e692fd41e900da09f9e2a5ffdec4a9c4, https://si.imgix.net/ead06ee8/uploads/origins/9593d1ac-a46d-4c95-85f6-54cd4427000b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=def301bba5b2b3ddd58e121e13b2ad46 2x, https://si.imgix.net/ead06ee8/uploads/origins/9593d1ac-a46d-4c95-85f6-54cd4427000b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e54856f32fe0ceecd484e21acc5008e3 3x", "genre": "art", "nsfw": false, "body": "はじめまして。VTuberの牙城論莉と申します。\n新着一覧で目を引かれ、SkebやXのイラストを拝見し、ｽｼｻﾞﾜ様の絵柄と世界観で描かれた牙城論莉を見たいと思い、リクエストさせていただきました。\n下記ご確認いただき、大丈夫でしたらお引き受けいただけますと幸いです。\n\n○イラストについて\n牙城論莉を描いていただきたいです。\n設定は社会人162cmの女性です。\n服装と髪型はこちら(https://drive.google.com/drive/folders/1tutAlS8IbTdrlUaOFPT6KvF_mKwbaZ_y?usp=sharing)のお好きなものでお願いします。\n等身やポーズ、構図、描写範囲等はお任せしたく思います。\n\n○使用用途\nSNSでの告知や動画投稿サイトでの使用（サムネイル、動画・配信内）\n\n以上です。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tutAlS8IbTdrlUaOFPT6KvF_mKwbaZ_y?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/54", "thumbnail_src": "https://si.imgix.net/5a74520e/uploads/origins/0c0f17c2-eac5-46c5-bf53-d4a8bec602cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70bd346e8e491bbe1ba5c65349294836", "thumbnail_srcset": "https://si.imgix.net/5a74520e/uploads/origins/0c0f17c2-eac5-46c5-bf53-d4a8bec602cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70bd346e8e491bbe1ba5c65349294836, https://si.imgix.net/5a74520e/uploads/origins/0c0f17c2-eac5-46c5-bf53-d4a8bec602cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b78f3ef4bd53a4efaaf5da4185203102 2x, https://si.imgix.net/5a74520e/uploads/origins/0c0f17c2-eac5-46c5-bf53-d4a8bec602cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34abc4381f5d0fdf44db86c18da2a6e2 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは。\n突然のご連絡、失礼いたします。\n先生の作品が本当に大好きで、Instagramを拝見するたびにたくさんのインスピレーションをいただいております。\nこの度、私が近日リリース予定の楽曲のジャケットイラストを、ぜひ先生にお願いしたく、ご連絡差し上げました。\n添付のリンクが楽曲のデモ音源となります。 \n（https://drive.google.com/file/d/1VmUFHf7oDV8uTlOnVohOnkh-nMm7EKKa/view?usp=sharing）\n\nこの曲は「優しさ」をテーマにした楽曲です。 私にとって優しさとは、愛する人を無条件に受け入れることができる一方で、愛するがゆえに自分自身を底なしに傷つけてしまう、そんな両面を持つ言葉だと感じています。\n棘のある優しさで傷つけられたとしても、それでもなお、これからの人生を優しく生きていきたい—— そんな想いを込めて、この曲を作りました。\n今回のイラストのお願いですが、下記の画像のこのキャラクターをベースにしていただければと思います。 \n（https://x.com/19701125s/status/1995816244340277394?s=20） \n\nそれ以外の要素については、先生の感性を存分に発揮していただき、自由に創作していただければ幸いです。\n先生の作品にいつも心を動かされており、こうして直接お声がけできることをとても嬉しく思います。 お忙しいところ恐れ入りますが、ご検討いただけましたら幸いです。 どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1VmUFHf7oDV8uTlOnVohOnkh-nMm7EKKa/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/53", "thumbnail_src": "https://si.imgix.net/2d677e5f/uploads/origins/e01a54d6-50fe-4d9e-8d52-e1b6daf730ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=779276c5706016d03f898d6dac2954b3", "thumbnail_srcset": "https://si.imgix.net/2d677e5f/uploads/origins/e01a54d6-50fe-4d9e-8d52-e1b6daf730ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=779276c5706016d03f898d6dac2954b3, https://si.imgix.net/2d677e5f/uploads/origins/e01a54d6-50fe-4d9e-8d52-e1b6daf730ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6922f0d2b800fcb22b14a58bc6fdb9c6 2x, https://si.imgix.net/2d677e5f/uploads/origins/e01a54d6-50fe-4d9e-8d52-e1b6daf730ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61aaa2d3dc9fa77bfba0164ee31a7fa6 3x", "genre": "art", "nsfw": false, "body": "ノルウェーからこんにちは！\n\n私のステージ上のOC、ベティ・ベージュのアートワークを作っていただけませんか？ベティ・ベージュはノルウェーのドラァグクイーンで、きらびやかなあごひげ（無精ひげでふさふさではない）をたくわえ、周りの人への愛情にあふれ、1950年代や1960年代のかわいいピンナップドレスを着ています。\n\nこのリクエストはOKかしら？\n\nポーズ、表情、設定、すべてお任せします。服装も自由に変えてください。OCで本当に重要なのは、キラキラの無精ひげだけです。\n\n参考、情報、その他の依頼はGoogle Diskを参照してください。\n\n私の提案を読んでいただきありがとうございます。このアイデアに違和感を感じたら遠慮なく断ってください、変に聞こえるかもしれませんが。\n\n今週も素晴らしい一週間をお過ごしください！\n\nそれではまた、\nクリス\n\nhttps://drive.google.com/drive/folders/1cn-Cli83XP2h5aoHZB86Q4_wjYNbaDYM", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/52", "thumbnail_src": "https://si.imgix.net/ed3cfd10/uploads/origins/beed18cf-87f8-4938-ac2f-2b7927ea184e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28c626a7488105be17d1cd292d6dc289", "thumbnail_srcset": "https://si.imgix.net/ed3cfd10/uploads/origins/beed18cf-87f8-4938-ac2f-2b7927ea184e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28c626a7488105be17d1cd292d6dc289, https://si.imgix.net/ed3cfd10/uploads/origins/beed18cf-87f8-4938-ac2f-2b7927ea184e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db05d50f12f927b2fa4bcbd800f8b4fc 2x, https://si.imgix.net/ed3cfd10/uploads/origins/beed18cf-87f8-4938-ac2f-2b7927ea184e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39cfb9d0ba24b10947a083315bd84fed 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\nスレイヤーズ」のリナ・インバースを描けますか？", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/51", "thumbnail_src": "https://si.imgix.net/3ae1ee83/uploads/origins/9af1ce5c-438b-452d-8a19-8400d62ad43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4ad85e1a5d7ae4bf31149b250b4ecf", "thumbnail_srcset": "https://si.imgix.net/3ae1ee83/uploads/origins/9af1ce5c-438b-452d-8a19-8400d62ad43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4ad85e1a5d7ae4bf31149b250b4ecf, https://si.imgix.net/3ae1ee83/uploads/origins/9af1ce5c-438b-452d-8a19-8400d62ad43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce24404d71ee1a65719065f141c7e88d 2x, https://si.imgix.net/3ae1ee83/uploads/origins/9af1ce5c-438b-452d-8a19-8400d62ad43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd66db80cacfb738cdc339d16e1de75e 3x", "genre": "art", "nsfw": false, "body": "すみません、日本語はわかりません！\n\nあなたのアートスタイルが大好きです！今、ストリーミング用のキャラクターを作っているのですが、ぜひあなたの解釈で私のキャラクターを描いてもらいたいです！\n彼の名前はギアス（フェイとの契約のためのケルト語）です。\n彼は壊れたロボット／アンドロイドの体に閉じ込められたフェイ（https://ja.wikipedia.org/wiki/%E5%A6%96%E7%B2%BE）です。あなたのスタイルに合わせて服装やキャラクターデザインを変えてください。そのキャラクターにインスピレーションを与えるものは何でも！彼のデザインで重要な点は、壊れたロボットの殻と、咲き乱れる生き生きとした自然の魔法とのコントラストです。あなたがそれを使って何をするか、ぜひ見てみたい！\n\n参考リンクは私のムードボードで、そこには私自身のアートワークと一番下にある公式リファレンスシートを含む、私のコンセプトワークがすべて載っている。\n\nhttps://www.figma.com/design/Y7qwZ8l6rZUvzH3u42uwVJ/Geas-Machina--simple-?node-id=0-1&t=C6BwAVhZOTOdkNpB-1", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/50", "thumbnail_src": "https://si.imgix.net/1dc0e96f/uploads/origins/bba17495-310a-4dc9-85cc-48e83399a154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5e33350990c1f88caf22eea1f24f3f7", "thumbnail_srcset": "https://si.imgix.net/1dc0e96f/uploads/origins/bba17495-310a-4dc9-85cc-48e83399a154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5e33350990c1f88caf22eea1f24f3f7, https://si.imgix.net/1dc0e96f/uploads/origins/bba17495-310a-4dc9-85cc-48e83399a154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67f18693e9cb5e7a7cf094656163a5dc 2x, https://si.imgix.net/1dc0e96f/uploads/origins/bba17495-310a-4dc9-85cc-48e83399a154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=372893ce16c81adc751a125559d7d7c0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたはいつも私に大きなインスピレーションを与えてくれました。私のオリジナルキャラクターを描いてもらえたら光栄です。彼は長い耳のエルフで、青白い肌、長いけど結われた白髪に黒いハイライト、全身を包む傷跡があります。彼の武器は、魔術師または闇の魔術師なので、宝石やその他の装飾が施された杖です。彼はエルドリッチとダークマジックを扱い、武器の入れ物として機能する「エルダー・ツリー」と呼ばれる木を持っている。木には目や口があり、枝には手のついた腕がある。手のひらには目や口があり、武器を吐き出す。あなたのアートがこのアイデアのインスピレーションの1つだったので、あなたのスピンを見るのはとてもクールだろう！\n彼は長い間憑りつかれていた状態から抜け出して、どうやって生き返ったらいいのか、まだ考えているところなんだ。\n\n髪や耳や髪や傷跡やツリーなど、エルフの参考になる画像はこちらです https://imgur.com/a/FIOHOwd\n* 完成までに必要な時間はすべて取ってください。", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/49", "thumbnail_src": "https://si.imgix.net/d37878c1/uploads/origins/f0dafc86-3e0f-462b-8967-26c023f96969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90f728c27693ed49cfa6542d999d4803", "thumbnail_srcset": "https://si.imgix.net/d37878c1/uploads/origins/f0dafc86-3e0f-462b-8967-26c023f96969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90f728c27693ed49cfa6542d999d4803, https://si.imgix.net/d37878c1/uploads/origins/f0dafc86-3e0f-462b-8967-26c023f96969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62daae9bb7c9a9e2a399f67bb84b35df 2x, https://si.imgix.net/d37878c1/uploads/origins/f0dafc86-3e0f-462b-8967-26c023f96969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76718fe016ba3b45139153d4a60ca8ee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@19701125s/works/48", "thumbnail_src": "https://si.imgix.net/1b820b48/uploads/origins/500b77c7-b903-4af4-8fb7-7e188800a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4656d563f7e32f3eb8fde18b90d30c9", "thumbnail_srcset": "https://si.imgix.net/1b820b48/uploads/origins/500b77c7-b903-4af4-8fb7-7e188800a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4656d563f7e32f3eb8fde18b90d30c9, https://si.imgix.net/1b820b48/uploads/origins/500b77c7-b903-4af4-8fb7-7e188800a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc