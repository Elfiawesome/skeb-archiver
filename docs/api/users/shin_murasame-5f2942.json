f2c600ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6145a136518b0c1dc7419392da90369, https://si.imgix.net/ae82d1ce/uploads/origins/58856427-25b1-437d-918f-995f2c600ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13db4ca44314f2619adfecc03630faba 2x, https://si.imgix.net/ae82d1ce/uploads/origins/58856427-25b1-437d-918f-995f2c600ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f7fdaa7a013ce3a317b46424cd91907 3x", "genre": "art", "nsfw": false, "body": "ユニ・アルシアさんが部屋でくつろいでいるイラストをお願い致します。構図などは全てお任せさせて頂きます。使用用途は眺める様ですので、縦横比・解像度もお任せさせて頂きます。収益でカロリーメイトを購入して頂ければ幸いです。以上、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@shin_murasame/works/12", "thumbnail_src": "https://si.imgix.net/5ca6bdb2/uploads/origins/abb91984-fc53-4dcd-b680-f58ffb0e6e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdedab7e560b9aec9859a5484e7319a8", "thumbnail_srcset": "https://si.imgix.net/5ca6bdb2/uploads/origins/abb91984-fc53-4dcd-b680-f58ffb0e6e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdedab7e560b9aec9859a5484e7319a8, https://si.imgix.net/5ca6bdb2/uploads/origins/abb91984-fc53-4dcd-b680-f58ffb0e6e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39ecb805778cd05cf9e542207ffa1b7f 2x, https://si.imgix.net/5ca6bdb2/uploads/origins/abb91984-fc53-4dcd-b680-f58ffb0e6e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85fd74cc7848d3ca6aa0ffb2dae4da4b 3x", "genre": "art", "nsfw": false, "body": "・イラストリクエストについて\n駅で傘をなくしたことに気づいたところの茨むあん様となくしたことを気にしているむあん様を横で見ている戸鎖くくり様のシチュエーションをお願いいたします。\n\nhttps://youtu.be/bqkLy1jFNAU?t=4537\n発端はこちらの動画の内容よりご参照願います。\n\n動画より、お二人の関係性について許している間柄というところがとても伝わってきたのと、\n今回の旅路について大事にしていただけていると思ったシーンでしたので何か形として残しておきたいと思い、依頼に至りました。\n\n・服装について参考例\n当日は雨の予報でしたが、快晴でした。\nまだ冬空で気温も寒く、冬服で適切と思います。\nもし、想定できない場合は勝手ながら想定したもので以下をご参考願います。\n戸鎖くくり様：スカート（ワンピース）＋カジュアル系のコート＋ヒール付きブーツ\n茨むあん様：チノパン＋ダッフルコート＋スニーカー\n見た目寒そうなら厚めデニールのストッキングありです。", "created_at": "", "completed_at": ""}, {"path": "/@shin_murasame/works/11", "thumbnail_src": "https://si.imgix.net/b9fd19a0/uploads/origins/374afb19-89a2-4a01-9934-1c7a758c6379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f811e0828b2e93713c3037014e4288", "thumbnail_srcset": "https://si.imgix.net/b9fd19a0/uploads/origins/374afb19-89a2-4a01-9934-1c7a758c6379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f811e0828b2e93713c3037014e4288, https://si.imgix.net/b9fd19a0/uploads/origins/374afb19-89a2-4a01-9934-1c7a758c6379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c95a3d2bd23b657b8649232770870c2 2x, https://si.imgix.net/b9fd19a0/uploads/origins/374afb19-89a2-4a01-9934-1c7a758c6379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=697625cf04186fceccd8889ba3adea71 3x", "genre": "art", "nsfw": false, "body": "むらさめしん様\n\nいつも素敵なイラストやすぬぷろの運営をしていただき誠にありがとうございます。お陰様で、すごく楽しい日々を送る事が出来ています。\n\nさて、この度リクエストさせていただきたいイラストのテーマですが\n\n『戸鎖くくりちゃんがお祝いしてくれる誕生日』\n\nです。\nケーキを食べさせてくれていたり、プレゼントをくれたりと色々とシチュエーションを考えたのですが、どの様に文字にして依頼をすれば良いかわからないので、テーマ以外は全てお任せいたします。\n出来ればの希望ですが、いつもと違う髪型も見たいなとは思っています。しかし、イメージもあると思うのでそちらもお任せします。\n\nテーマ以外はお任せにしてしまい申し訳ありませんが、ぜひお受けいただけたらと思います。\nお忙しい中恐れ入りますが、よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@shin_murasame/works/10", "thumbnail_src": "https://si.imgix.net/242c9a42/uploads/origins/b39a6d42-092b-497b-84f5-0830cb6c89e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0b7e227c4c3e33f572e23c463d5022", "thumbnail_srcset": "https://si.imgix.net/242c9a42/uploads/origins/b39a6d42-092b-497b-84f5-0830cb6c89e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0b7e227c4c3e33f572e23c463d5022, https://si.imgix.net/242c9a42/uploads/origins/b39a6d42-092b-497b-84f5-0830cb6c89e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dp