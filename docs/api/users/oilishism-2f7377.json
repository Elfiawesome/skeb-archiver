a-4095-ac24-cfbd30f06e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a946d1122d7cd3065364acfdfed4215f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/13", "thumbnail_src": "https://si.imgix.net/8b624141/uploads/origins/bb855347-420a-4ae5-9ba3-010f8eab750b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6c276cfbc043f13b6d0cd4248c3a51", "thumbnail_srcset": "https://si.imgix.net/8b624141/uploads/origins/bb855347-420a-4ae5-9ba3-010f8eab750b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6c276cfbc043f13b6d0cd4248c3a51, https://si.imgix.net/8b624141/uploads/origins/bb855347-420a-4ae5-9ba3-010f8eab750b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9979bc3cf857d0350c470541731b109 2x, https://si.imgix.net/8b624141/uploads/origins/bb855347-420a-4ae5-9ba3-010f8eab750b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d8810ba6c0782f702688d14f29ff9f7 3x", "genre": "art", "nsfw": true, "body": "匿名にて失礼いたします\n自分のＯＣの踊り子でリクエストお願いできますでしょうか\n容姿イメージは資料URLをご参照ください\nhttps://drive.google.com/file/d/1hZKkUYG25Tmk-95yF0kB8W_itrCkHGK5/view?usp=drive_link\n\n楽器にもなる鞭のようなリボンを身に絡めながら踊る妖艶な舞姫のお姉さん\nイメージとしては新体操のリボンのような感じで、リボン先端部の錘は振るう事で音を奏でる風切り笛になっています\n\nＮＳＦＷはR-15くらい、動きに合わせて乳が見えちゃう（見せちゃう）みたいなセクシー、エロかわいい、エロかっこいい系の感じで\nできたら全身入ると嬉しいですが、構図やポーズはお任せします\n衣装の不明な所なども自由にしていただいて構いませんので、よろしくお願いします\n\nhttps://drive.google.com/file/d/1hZKkUYG25Tmk-95yF0kB8W_itrCkHGK5/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/12", "thumbnail_src": "https://si.imgix.net/a428e1d8/uploads/origins/51a84607-1ccc-4243-a197-8a0a815cf371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed5382b2e293aeef1522a9e49e0db8b", "thumbnail_srcset": "https://si.imgix.net/a428e1d8/uploads/origins/51a84607-1ccc-4243-a197-8a0a815cf371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed5382b2e293aeef1522a9e49e0db8b, https://si.imgix.net/a428e1d8/uploads/origins/51a84607-1ccc-4243-a197-8a0a815cf371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce43071de10e37086e37946fb3a9f1a3 2x, https://si.imgix.net/a428e1d8/uploads/origins/51a84607-1ccc-4243-a197-8a0a815cf371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df6c6238487a3def59fc36f176173b19 3x", "genre": "art", "nsfw": true, "body": "初めましてお世話になります。\nTwitterで素敵なイラストを拝見したので今回依頼させていただきます。\n\nお願いしたいキャラは自分のサイトのマスコットキャラの子で、緑のジャージに体操服、ブルマーというキャラになります。陰毛はありません。\nhttps://twitter.com/Funakiya/status/1444135179837054976\n\nシチュエーションは体操服をめくり胸が露出した状態で、ブルマーをずらし挿入で、男性とセックスしているところをお願い致します。\n差分で中だし汁がたくさん出ているところがあると嬉しいです。\n\nSNSの紹介およびtwitter凍結回避のため自分のサイトでの紹介の範囲で利用させていただければと思います。\nR-18絵がOKでしたら宜しくお願いします。\n\nhttps://twitter.com/Funakiya/status/1444135179837054976", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/11", "thumbnail_src": "https://si.imgix.net/0fb94f2e/uploads/origins/b7da034a-70f5-4d2c-bd2d-a12b053f8287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1b3c0f8ea3983e16db303f34ec84e4e", "thumbnail_srcset": "https://si.imgix.net/0fb94f2e/uploads/origins/b7da034a-70f5-4d2c-bd2d-a12b053f8287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1b3c0f8ea3983e16db303f34ec84e4e, https://si.imgix.net/0fb94f2e/uploads/origins/b7da034a-70f5-4d2c-bd2d-a12b053f8287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0415e40c404a9720f3a3f12584085716 2x, https://si.imgix.net/0fb94f2e/uploads/origins/b7da034a-70f5-4d2c-bd2d-a12b053f8287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1a6cbf6f7c47b5bafd0dead9e7ce44b 3x", "genre": "art", "nsfw": true, "body": "はじめまして、失礼します。\n好みの絵柄をご拝見いたしまして、リクお願いできますでしょうか。\n\n●キャラクター\n【神姫PROJECT】のヘルメス\nイラスト資料はURLをご参照ください。\nhttps://drive.google.com/file/d/1KTuBWMrTpxwq9kbushjI3J6-qE2mQf_H/view?usp=sharing\n\n●シチュエーション\nバトル敗北、陵辱事後。\nぶち割られた風船がとっちらかった無残な状態\n割れた風船の残骸は元が判るくらいで、その他はお任せします。\n（それぞれ意志ある使い魔的な存在で、破裂＝撃破、全滅というメタファー）\n本人も風船の残骸や糸が絡み付き、精液ぶっかけ、ボテ腹アヘ顔昇天。討伐完了！な感じで\n\nhttps://drive.google.com/file/d/1KTuBWMrTpxwq9kbushjI3J6-qE2mQf_H/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/10", "thumbnail_src": "https://si.imgix.net/a17a6031/uploads/origins/1f7116f8-a829-48ad-9e0e-67dd8d8822d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bbffe241eb05335506ba0b1bcb61e3d", "thumbnail_srcset": "https://si.imgix.net/a17a6031/uploads/origins/1f7116f8-a829-48ad-9e0e-67dd8d8822d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bbffe241eb05335506ba0b1bcb61e3d, https://si.imgix.net/a17a6031/uploads/origins/1f7116f8-a829-48ad-9e0e-67dd8d8822d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68805b79fe0d48cca34ca4e0a0cc036c 2x, https://si.imgix.net/a17a6031/uploads/origins/1f7116f8-a829-48ad-9e0e-67dd8d8822d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=975ce07ae20c341871e23f8933609097 3x", "genre": "art", "nsfw": true, "body": "あぶらい先生\n突然のリクエスト失礼致します。 忍者戦隊カクレンジャー」に登場する「花のくノ一組」が、敵のくノ一を犯し葬っているイラストをお願い致します。 \n ・くノ一組はアヤメ（青）。服装は変身後のバトルスーツ（ぴっちりスーツ）のマスクオフ。以下参考画像です（実写作品のため、あくまで雰囲気の参考のためであり、顔や髪型は自由に描いていただいて大丈夫です）。 https://twitter.com/vogts43267024/status/1223443835251875840?s=21 \n ・敵のくノ一は『妖艶くノ一 ヨミの三つの淫技』のくノ一ヨミです。以下、参考画像です。 https://twitter.com/vogts43267024/status/1333340501529956352?s=21  \n・構図は、アヤメが敵くノ一の背後から乳首をせめている状況で、獲物を仕留め満足げな表情を浮かべる。敵くノ一はすでに意識を失い、表情は儚げに眠るように目を閉じている。  ご多忙とは思いますが、ご検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/9", "thumbnail_src": "https://si.imgix.net/fce58aa5/uploads/origins/7ceae40c-957c-4b82-8e16-76b2804d6f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fed816c8edc4d65f2ad6d99c8b3869d6", "thumbnail_srcset": "https://si.imgix.net/fce58aa5/uploads/origins/7ceae40c-957c-4b82-8e16-76b2804d6f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fed816c8edc4d65f2ad6d99c8b3869d6, https://si.imgix.net/fce58aa5/uploads/origins/7ceae40c-957c-4b82-8e16-76b2804d6f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfe4790092436a1a7548becb56ab7122 2x, https://si.imgix.net/fce58aa5/uploads/origins/7ceae40c-957c-4b82-8e16-76b2804d6f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=584b5a62ec50b7985a414a373c635b35 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/8", "thumbnail_src": "https://si.imgix.net/aa419365/uploads/origins/e2bc0b3c-be1a-4877-9f79-55bb6214d2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e0104209f8726e9190bd94dce915fde", "thumbnail_srcset": "https://si.imgix.net/aa419365/uploads/origins/e2bc0b3c-be1a-4877-9f79-55bb6214d2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e0104209f8726e9190bd94dce915fde, https://si.imgix.net/aa419365/uploads/origins/e2bc0b3c-be1a-4877-9f79-55bb6214d2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee3262f30cabc755adb01f727d3d54a6 2x, https://si.imgix.net/aa419365/uploads/origins/e2bc0b3c-be1a-4877-9f79-55bb6214d2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f6e77d278e6b9b8b0977fa78060748a 3x", "genre": "art", "nsfw": true, "body": "あぶらいさんの艶のあるイラストが大好きなので\nリクエストさせていただきます。\n\nゼノギアスのミァンがカメラ目線で妖艶な笑みを浮かべながら、全裸で両手を広げている（または両手を前方に差し出している）ところを描いていただきたいです。こちらにいる人（ラムサスを想定）を受け入れるようなイメージです。\n背景はなしで構いません。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/7", "thumbnail_src": "https://si.imgix.net/49974d2d/uploads/origins/448c8047-aaca-4818-8a14-9ed62ed26918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1b1a45920054c8c70e2799374eb6693", "thumbnail_srcset": "https://si.imgix.net/49974d2d/uploads/origins/448c8047-aaca-4818-8a14-9ed62ed26918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1b1a45920054c8c70e2799374eb6693, https://si.imgix.net/49974d2d/uploads/origins/448c8047-aaca-4818-8a14-9ed62ed26918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8228dfb8dcf4343d60f1cbd7c811015f 2x, https://si.imgix.net/49974d2d/uploads/origins/448c8047-aaca-4818-8a14-9ed62ed26918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4de74a54412e4e9ed3c7fa43d113918 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/6", "thumbnail_src": "https://si.imgix.net/0885d53c/requests/151810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c279d0e9e96e67a94aabc8737c9d14", "thumbnail_srcset": "https://si.imgix.net/0885d53c/requests/151810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c279d0e9e96e67a94aabc8737c9d14, https://si.imgix.net/0885d53c/requests/151810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=139eb7c9f07e0b882787c2a777af19c0 2x, https://si.imgix.net/0885d53c/requests/151810_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d9c407b242a82a31ac3475e78164298 3x", "genre": "art", "nsfw": true, "body": "あぶらいさん初めまして\nイラストを描いて頂きたいのですがメギド72のマルバスが、友人のヴィネ様にそそのかされてえっちなクスリやらも盛られてという設定で民衆の前に連れ出されて\nhttps://www.pixiv.net/artworks/81192366\n上のイラストのような全裸同然の格好でイヤらしい踊り子のアクセサリー的な物だけつけて淫紋をお腹に浮かび上がらせながら恥ずかしいのにえっちなダンスを踊らされてお股は大洪水になっているイラストをお願いできないでしょうか\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/5", "thumbnail_src": "https://si.imgix.net/981e7dbc/requests/120052_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756ed6447f779ba1ea7feec7c79ccf05", "thumbnail_srcset": "https://si.imgix.net/981e7dbc/requests/120052_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756ed6447f779ba1ea7feec7c79ccf05, https://si.imgix.net/981e7dbc/requests/120052_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b211d2104cc1c9cfad9a1b8601503301 2x, https://si.imgix.net/981e7dbc/requests/120052_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a10ac9809be504dc95c23289f493461 3x", "genre": "art", "nsfw": true, "body": "メギド72のヴィネ(ラッシュ)が手コキでモブ男性を瞬殺しているイラストを依頼します。\n\n男の方はあまりの手コキの上手さに「無数の手に同時に愛撫されている」様な錯覚を起こし噴水のように射精してしまいます(ヴィネの奥義演出で手がいっぱい出るみたいなイメージです、実際に手をいっぱい出しているわけではありません)。", "created_at": "", "completed_at": ""}, {"path": "/@oilishism/works/4", "thumbnail_src": "https://si.imgix.net/d682aae1/requests/123669_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dabbeca1de9067dfef11b63a21f20b4", "thumbnail_srcset": "https://si.imgix.net/d682aae1/requests/123669_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dabbeca1de9067dfef11b63a21f20b4, https://si.imgix.net/d682aae1/requests/123669_0?bg=%23fff&auto=format%2Ccompress&fm=