ix.net/8f85be26/uploads/origins/fe5d5ab1-db2f-4358-8ee2-3bb1db1c1df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f296e1f9d511abf0ab28ae765057f425 3x", "genre": "art", "nsfw": false, "body": "れいさん　こんにちは～\n今回は私のレッサーパンダキャラクターのイラストを依頼したい！\n構図や背景は全部お任せします！\n\nキャラクターの参考：\n\nhttps://drive.google.com/drive/folders/1Jv9MyTRGWg8dYSLfqlnN39g8mDyisJVI?usp=drive_link\n\nありがとうございます~", "created_at": "", "completed_at": ""}, {"path": "/@Reiwolf/works/6", "thumbnail_src": "https://si.imgix.net/e5ca050a/uploads/origins/820d3123-28ff-4a9a-a4a1-f2a8f3451526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7040edc4accab345bb8aa876cd98c416", "thumbnail_srcset": "https://si.imgix.net/e5ca050a/uploads/origins/820d3123-28ff-4a9a-a4a1-f2a8f3451526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7040edc4accab345bb8aa876cd98c416, https://si.imgix.net/e5ca050a/uploads/origins/820d3123-28ff-4a9a-a4a1-f2a8f3451526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b491a7ffff506705b11fe575eca47ceb 2x, https://si.imgix.net/e5ca050a/uploads/origins/820d3123-28ff-4a9a-a4a1-f2a8f3451526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7abaeaad5f7e8aacd7e06fdc64900d39 3x", "genre": "art", "nsfw": false, "body": "れいちゃーん、こんにちは！\n今回れいくんに頼みたいイラストは、れいくんの衣服[尺赤帽子＋白Tシャツ＋紺色ズボン]を着た僕の代理くんをお願いしたいです！\nポーズなどはおまかせします！\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Reiwolf/works/5", "thumbnail_src": "https://si.imgix.net/aaf8152a/uploads/origins/9db89a7f-dfac-4124-a581-4357e0d1df4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e251dbba074b05a62dff5a4cf01ace7", "thumbnail_srcset": "https://si.imgix.net/aaf8152a/uploads/origins/9db89a7f-dfac-4124-a581-4357e0d1df4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e251dbba074b05a62dff5a4cf01ace7, https://si.imgix.net/aaf8152a/uploads/origins/9db89a7f-dfac-4124-a581-4357e0d1df4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d620f16fa55ca2bd49ac16cd36cbe6cf 2x, https://si.imgix.net/aaf8152a/uploads/origins/9db89a7f-dfac-4124-a581-4357e0d1df4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5636608ec98d279f37275a297f204cd5 3x", "genre": "art", "nsfw": false, "body": "れい先生、こんにちは！霜牙と申します。先生の絵が大好きで、ぜひ私のキャラクターを描いていただきたくてご連絡しました！\n私のキャラクターはアプリコット色のクマで、ぽっちゃりとした体格が特徴です。太い眉毛（超太いです！）が特徴です。赤いマフラーを巻き、腕には包帯を巻いていて、顔には少し恥ずかしそうな赤みが差しています。腰には小さなペンギンのチャームを下げています。\n保護欲があって温かくて頼もしい感じが好きです。少しだけ粗くて不器用なところもほしいです。具体的なシーンやポーズはお任せします！\n\nhttps://www.dropbox.com/scl/fo/yrcpgoealnevf4lafc3fu/AKLyC5AxBcE4nXwv-ZnlrNs?rlkey=die5ftxt57ckmp1cyv5wenlmk&st=mjw7t5pm&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Reiwolf/works/4", "thumbnail_src": "https://si.imgix.net/b3504ff8/uploads/origins/f4c48c7b-d364-4d74-9094-84087e6af293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf962f1419bcbda6d9eaad26f9e48e96", "thumbnail_srcset": "https://si.imgix.net/b3504ff8/uploads/origins/f4c48c7b-d364-4d74-9094-84087e6af293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf962f1419bcbda6d9eaad26f9e48e96, https://si.imgix.net/b3504ff8/uploads/origins/f4c48c7b-d364-4d74-9094-84087e6af293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8afdf1a1fdd23e7de28d1b100484ef25 2x, https://si.imgix.net/b3504ff8/uploads/origins/f4c48c7b-d364-4d74-9094-84087e6af293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9a995d7fdb33f1c87d4a3bff6c81ce2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nツイッターであなたの素晴らしいアートを見たので、私のオオヤマネコのキャラクター、メロのちょんまげバージョンを描いていただけませんか？\n\n以下が参考になります：\nhttps://drive.google.com/file/d/1V5xDRjOodWoRJg4ajQGgh_2gVEW_05uU/view?usp=sharing\nhttps://drive.google.com/file/d/15sca5SwGS_Gc0Zctlid3UoSLLbpPJbEr/view?usp=sharing\nhttps://drive.google.com/file/d/15sca5SwGS_Gc0Zctlid3UoSLLbpPJbEr/view?usp=sharing\nhttps://drive.google.com/file/d/1RhBx0vnOrCIuDJ2h1Y5ZPE8zEwCGV5UA/view?usp=sharing\n\nご自由に描いてください！\nご検討ありがとうございます^w^/", "created_at": "", "completed_at": ""}, {"path": "/@Reiwolf/works/3", "thumbnail_src": "https://si.imgix.net/f85d208c/uploads/origins/11377061-b633-4f00-ac5b-e565d4aa126c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bc5c2490c3a5d6adfcaf53de41c41ae", "thumbnail_srcset": "https://si.imgix.net/f85d208c/uploads/origins/11377061-b633-4f00-ac5b-e565d4aa126c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bc5c2490c3a5d6adfcaf53de41c41ae, https://si.imgix.net/f85d208c/uploads/origins/11377061-b633-4f00-ac5b-e565d4aa126c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c63b40b48ca8aa60a90d751634f825ed 2x, https://si.imgix.net/f85d208c/uploads/origins/11377061-b633-4f00-ac5b-e565d4aa126c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30cf36bbe1b73412600c41248cc07414 3x", "genre": "art", "nsfw": false, "body": "https://drive.google.com/drive/folders/1b-Ry-GCWKttZCkgXUPcAXakdUDBGvVnk\n\n\nこんにちは！こちらが私のキャラクター設定です。\n設定はトラとオオカミのハイブリッドのような感じになっています。\n設定資料のリンクはこちらです：\n\n依頼内容については、おまかせでも大丈夫です。\nもしテーマに迷った場合は、以下のような順番で好みがあります：\n\n日本のサラリーマン風の服装\n\n工事現場っぽい作業服スタイル\n\n先生の自由な発想で描いていただいても嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@Reiwolf/works/2", "thumbnail_src": "https://si.imgix.net/806d7404/uploads/origins/d3fecc00-fe79-4c07-9628-c281172b73ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb146166ee59db2b70077efcf7676f37", "thumbnail_srcset": "https://si.imgix.net/806d7404/uploads/origins/d3fecc00-fe79-4c07-9628-c281172b73ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb146166ee59db2b70077efcf7676f37, https://si.imgix.net/806d7404/uploads/origins/d3fecc00-fe79-4c07-9628-c281172b73ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ac445060e5e34eea70768f429ad3ed1 2x, https://si.imgix.net/806d7404/uploads/origins/d3fecc00-fe79-4c07-9628-c281172b73ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63e74c0e31d81984ed88174be13307ee 3x", "genre": "art", "nsfw": false, "body": "れいくんこんにちは！\n自分のサモエドの代理をヘッダーイラストとしてれい君に描いていただきたいです。\n\nゲームが好きなのでゲームを絡めた感じのイラストにでしてもらえたらうれしいです。\n表情などはれいくんにお任せしたいと思います。\n参考資料も併せて添付させていただきます。\nもしよろしければ描いていただいてくれると嬉しいです！\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1GA0kdAsH_1k-MVJDlBpOxVmyKikuuNGu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Reiwolf/works/1", "thumbnail_src": "https://si.imgix.net/133379da/uploads/origins/0d166b64-b844-41a1-9b49-0e3642cec965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f2652c2a8357dfa8c73a02940919df2", "thumbnail_srcset": "https://si.imgix.net/133379da/uploads/origins/0d166b64-b844-41a1-9b49-0e3642cec965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f2652c2a8357dfa8c73a02940919df2, https://si.imgix.net/133379da/uploads/origins/0d166b64-b844-41a1-9b49-0e3642cec965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c6e7859249422bf45d7a3735ca971ab 2x, https://si.imgix.net/133379da/uploads/origins/0d166b64-b844-41a1-9b49-0e3642cec965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cd7a250b685b8b6bc4e0843ab31188d 3x", "genre": "art", "nsfw": false, "body": "サムネなどでも使えるようなゲームしてる自分を描いて欲しいです。\n構図や服装などはおまかせします。", "created_at": "", "completed_at": ""}]}