Twitch等、各種配信サイトでのサムネイル・アイコン・ヘッダーへの使用\n◇ X(旧Twitter)でのポスト・アイコン・ヘッダーへの使用\n◇ネットプリント\n\n【納品形式について】\n人物・背景・文字等を別レイヤーにしたpsd形式での納品、または人物のみで背景が透過されているpng形式で納品していただけますと幸いです。\n\n以上となります。\nお忙しい中恐縮ですが、何卒ご検討のほどよろしくお願いいたします…！", "created_at": "", "completed_at": ""}, {"path": "/@str410r/works/11", "thumbnail_src": "https://si.imgix.net/b7e82e03/uploads/origins/86b2e6ec-73e0-4adb-ac68-0d6f02a9ecc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb46940ba94948fa0fa55dfb14e076b3", "thumbnail_srcset": "https://si.imgix.net/b7e82e03/uploads/origins/86b2e6ec-73e0-4adb-ac68-0d6f02a9ecc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb46940ba94948fa0fa55dfb14e076b3, https://si.imgix.net/b7e82e03/uploads/origins/86b2e6ec-73e0-4adb-ac68-0d6f02a9ecc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60306ee7f7f903d44005ad66ca048c30 2x, https://si.imgix.net/b7e82e03/uploads/origins/86b2e6ec-73e0-4adb-ac68-0d6f02a9ecc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f8bd093192523c83674e2aa633955ab 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@str410r/works/10", "thumbnail_src": "https://si.imgix.net/b03841bb/uploads/origins/c5c20fef-4aca-4f8b-8f12-d033156656f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c76f697982d8b29277cfa06e944ea78c", "thumbnail_srcset": "https://si.imgix.net/b03841bb/uploads/origins/c5c20fef-4aca-4f8b-8f12-d033156656f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c76f697982d8b29277cfa06e94