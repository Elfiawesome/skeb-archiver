rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37714819f1a3bbfb37d447b735a979c8 2x, https://si.imgix.net/108f71a6/uploads/origins/bb178bd6-efb9-4e93-8725-1f4249225e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de6ce5e5235c2c1f42424ef691c3d81b 3x", "genre": "art", "nsfw": false, "body": "客席に人間のいない寄席の高座でどや顔で高説を垂れる足立レイをください\nこのモチーフ以外の全てはおまかせします", "created_at": "", "completed_at": ""}, {"path": "/@kuma_suke0803/works/3", "thumbnail_src": "https://si.imgix.net/9eeb9c9b/uploads/origins/7332a7ed-4584-43e1-a0c9-b22a7d407e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bda9f9de884a946fee7fdd1a37918d9", "thumbnail_srcset": "https://si.imgix.net/9eeb9c9b/uploads/origins/7332a7ed-4584-43e1-a0c9-b22a7d407e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bda9f9de884a946fee7fdd1a37918d9, https://si.imgix.net/9eeb9c9b/uploads/origins/7332a7ed-4584-43e1-a0c9-b22a7d407e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7523ede66f57c7141cdd380cd1bb320 2x, https://si.imgix.net/9eeb9c9b/uploads/origins/7332a7ed-4584-43e1-a0c9-b22a7d407e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7409ffeec42b853277af3eaa7459aa0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、リクエストでVOCALOIDの重音テトお願いします。シチュエーションは、手の甲にテトの顔のお面を着けた状態で、ボカロ曲「ホントノ」にあやかり人差し指と中指でトコトコとハンドウォークをこちらに見せてくれるよう(こちらに向かって歩く感じ)に描いて欲しいです。テトの手は素手ではなく肌色の手袋をはめた状態で、縫い目ありでお願いします。もし描けたら、その手袋をはめるところも描いて欲しいです。", "created_at": "", "completed_at": ""}, {"path": "/@kuma_suke0803/works/2", "thumbnail_src": "https://si.imgix.net/fd47ef91/uploads/origins/9106a4b1-52c7-48a8-9f1a-1b6e5dcbd355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c69794d4a40fa615ecede16ff88142e", "thumbnail_srcset": "https://si.imgix.net/fd47ef91/uploads/origins/9106a4b1-52c7-48a8-9f1a-1b6e5dcbd355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c69794