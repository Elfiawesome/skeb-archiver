05df01/uploads/origins/a1c6013b-d4f8-42db-b83b-5875f4f687ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2825cd85c7953221983c7af8fe2bcd9", "thumbnail_srcset": "https://si.imgix.net/8105df01/uploads/origins/a1c6013b-d4f8-42db-b83b-5875f4f687ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2825cd85c7953221983c7af8fe2bcd9, https://si.imgix.net/8105df01/uploads/origins/a1c6013b-d4f8-42db-b83b-5875f4f687ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c77a5e7bf5fb4a74997f6f39a39bcd 2x, https://si.imgix.net/8105df01/uploads/origins/a1c6013b-d4f8-42db-b83b-5875f4f687ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ef7a7a7bc109a1e7af345a548cde4c3 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n新着でお見かけした絵に感銘を受けました。\nリクエストよろしいでしょうか？\n\nうちの子が机の上に乗せられて、大好きな人とセックスしている場面です。\n構図としては添付写真をご参考お願いします。\n\n①挿入されて感じている場面\n②中出しされイク表情\n③引き抜かれて精子が溢れ出てきて、とても満足している。\n\n順で頂けると嬉しいです。\n\nhttps://drive.google.com/drive/folders/10h0jhTvn-k5FApx99dTEwHSdlfDyAWS_", "created_at": "", "completed_at": ""}, {"path": "/@Makeoshimi001/works/3", "thumbnail_src": "https://si.imgix.net/300d5909/uploads/origins/f30c49fb-1a41-47c4-9aae-3cdf69f0dfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3689d3ee7f539643ef35c8ae9cf0288", "thumbnail_srcset": "https://si.imgix.net/300d5909/uploads/origins/f30c49fb-1a41-47c4-9aae-3cdf69f0dfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3689d3ee7f539643ef35c8ae9cf0288, https://si.imgix.net/300d5909/uploads/origins/f30c49fb-1a41-47c4-9aae-3cdf69f0dfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a35845b79365432f9eba9698c8b42f1 2x, https://si.imgix.net/300d5909/uploads/origins/f30c49fb-1a41-47c4-9aae-3cdf69f0dfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=057ab693a0855814e6ac522b28663cc0 3x", "genre": "art", "nsfw": true, "body": "お世話になっております、前回のイラストがとてもよかったためリピートさせていただきたく思います。\n\n依頼としましては、うちの子が足を開かれそこに複数の男性がぶっかけているイラストをお願いできたらと思います。\n\nうちの子は依頼文一番下のドライブに入っている好みの子の方を書いていただければと思います。\n\n構図・ポーズとしてはこのような感じでお願いします\nhttps://drive.google.com/file/d/1FcY1KMdtLMc3QXUI0dFVce92K2rhyf1X/view?usp=sharing\nイメージとしては足を広げられて大事な所が丸見えになっており、それを複数人の男が見抜きしてぶっかけてるような感じです\nぶっかける役の男は竿だけとかでも大丈夫です\n\nまた、可能であれば差分として以下をいただきたいです。\n①上記参考イラストの通り。まだ足を開かれているだけ\n②複数の男にぶっかけられているところ\n③かけられたあとで全身がドロドロになっている様子\n\n表情は上記展開に合わせておまかせで変えていただけたらと思います。\n以上です、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fMj_eu_eZl-h3Rsh0UrhZKnn9Y9UsFVe?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Makeoshimi001/works/2", "thumbnail_src": "https://si.imgix.net/7c561542/uploads/origins/314cdfd9-64fe-4cf5-961a-2906208aedca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c51e446055777bedbc6b4959f8da3ccf", "thumbnail_srcset": "https://si.imgix.net/7c561542/uploads/origins/314cdfd9-64fe-4cf5-961a-2906208aedca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c51e446055777bedbc6b4959f8da3ccf, https://si.imgix.net/7c561542/uploads/origins/314cdfd9-64fe-4cf5-961a-2906208aedca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b25cc909283b49b716934c065172829 2x, https://si.imgix.net/7c561542/uploads/origins/314cdfd9-64fe-4cf5-961a-2906208aedca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cf3bd8e3b005f6c1618dfdf6ccc4d71 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Makeoshimi001/works/1", "thumbnail