{"screen_name": "Ary_0330", "file": "Ary_0330-023d6a", "name": "Ary", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fb45d9711-94ff-41d5-b5c6-e5fdfe7a2ffd.gif?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/dd25ab62-8c64-41d5-9231-d264f13221de.gif", "description": "ありぃと読みます、ファンタジーな世界が好き。\nX→https://x.com/Ary_0330\nSkeb→https://skeb.jp/@Ary_0330 (OC only)\n無断転載、使用、AI学習禁止", "total_works": 10, "scraped_works": 10, "first_seen": "2026-03-20T21:46:05.760335+00:00", "last_updated": "2026-03-20T21:46:05.760335+00:00", "price_history": {"art": [{"amount": 3000, "recorded_at": "2026-03-20T21:46:05.760335+00:00"}], "video": [{"amount": 4000, "recorded_at": "2026-03-20T21:46:05.760335+00:00"}]}, "current_prices": {"art": 3000, "video": 4000}, "price_range": {"art": {"min": 3000, "max": 3000}, "video": {"min": 4000, "max": 4000}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@Ary0330", "name": "Ary0330"}, {"label": "Twitter", "url": "https://x.com/Ary_0330", "name": "Ary_0330"}, {"label": "Website", "url": "https://ary0330.booth.pm", "name": ""}], "flags": {}, "acceptable": false, "works": [{"path": "/@Ary_0330/works/10", "thumbnail_src": "https://si.imgix.net/df4cfc97/uploads/origins/65b3ee4d-451a-42c1-9518-a13abdf7d6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=633e83a0335f9f14615a90036b04200f", "thumbnail_srcset": "https://si.imgix.net/df4cfc97/uploads/origins/65b3ee4d-451a-42c1-9518-a13abdf7d6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=633e83a0335f9f14615a90036b04200f, https://si.imgix.net/df4cfc97/uploads/origins/65b3ee4d-451a-42c1-9518-a13abdf7d6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39f9e663563bec65e5a1105dd12bd2fa 2x, https://si.imgix.net/df4cfc97/uploads/origins/65b3ee4d-451a-42c1-9518-a13abdf7d6d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1b65ce7d02db