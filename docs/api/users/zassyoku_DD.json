4f13-ad0d-0ef6ec39b2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78fa400bc88051b325eeb41a1604431b", "thumbnail_srcset": "https://si.imgix.net/0cdfbd2a/uploads/origins/2451f9cd-18a5-4f13-ad0d-0ef6ec39b2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78fa400bc88051b325eeb41a1604431b, https://si.imgix.net/0cdfbd2a/uploads/origins/2451f9cd-18a5-4f13-ad0d-0ef6ec39b2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3097cba78f7c4a9fab48c73e13f45491 2x, https://si.imgix.net/0cdfbd2a/uploads/origins/2451f9cd-18a5-4f13-ad0d-0ef6ec39b2c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5887feaedb1e67f664014f2a82f20051 3x", "genre": "art", "nsfw": false, "body": "Hello! I fell in love with your illustration on X and wished to see my original characters in a similar composition as seen in this post!\nhttps://x.com/zassyoku_DD/status/1994125362239033728?s=20\nI'll leave the choice of the composition entirely up to you. It can be either the Male OC or Female OC holding the other as they fade away in their arms with a pained melancholic expression. Thank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1i8vUX4Zbe-q0MgdVwSpvxws5ObL1WI36?usp=sharing\nhttps://drive.google.com/drive/folders/1OUEPhK2WJ-urei8j2xCywzD1131XlgUk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@zassyoku_DD/works/110", "thumbnail_src": "https://si.imgix.net/0948dec5/uploads/origins/636a21fc-0715-4490-a306-9006c435fb29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5886978f4c68bbb08fc558bf39e276ef", "thumbnail_srcset": "https://si.imgix.net/0948dec5/uploads/origins/636a21fc-0715-4490-a306-9006c435fb29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccente