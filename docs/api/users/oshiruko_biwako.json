%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86f4db1ef3d727d2f464a74f0e46e673 3x", "genre": "art", "nsfw": false, "body": "久しぶりのリクエスト失礼します…！\nしぐれちゃんとレンちゃんをでんこ学園シリーズの中でちーこさんのお好きなラッピングで描いていただきたいです！2人が卒業を祝ってるというシチュエーションだと嬉しいです！\nTwitterのアイコンにも使用させていただこうかと考えていますのでよろしくお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/43", "thumbnail_src": "https://si.imgix.net/52911b33/uploads/origins/44dc7f50-7d85-4949-a3e1-a7c72a5d2934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57ea0894884afe4f239465a3feb21259", "thumbnail_srcset": "https://si.imgix.net/52911b33/uploads/origins/44dc7f50-7d85-4949-a3e1-a7c72a5d2934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57ea0894884afe4f239465a3feb21259, https://si.imgix.net/52911b33/uploads/origins/44dc7f50-7d85-4949-a3e1-a7c72a5d2934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d9954b4425978e511e6520fa2349b10 2x, https://si.imgix.net/52911b33/uploads/origins/44dc7f50-7d85-4949-a3e1-a7c72a5d2934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eb2b55f504c9419934b86bab881e68c 3x", "genre": "art", "nsfw": false, "body": "いつもかわいい絵を見させていただきありがとうございます\n\n今回は奏バーデン由布院ちゃんと有馬楓花ちゃんのパネルになってるチア衣装でお願いしたいです\n\n2人で両手で1つの大きなハートを作るような感じのポーズで描いていただけたらありがたいです\nあと、まひろウちゃんとけろけろ美月氏もぽんぽんを持って2人の頭の上で応援してる感じで描いていただけたら嬉しいです\n描きづらい時は何処か別のところにしてもらってもよいですし、無理ならばまひろウちゃんとけろけろ美月氏は抜きにしてもらっても構いません\n\nよろしければお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/42", "thumbnail_src": "https://si.imgix.net/1e71961e/uploads/origins/4175f1ae-6f27-4ee6-bfd4-4f8df9161189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0b3512c30ba9092ba2cf655ee88980", "thumbnail_srcset": "https://si.imgix.net/1e71961e/uploads/origins/4175f1ae-6f27-4ee6-bfd4-4f8df9161189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0b3512c30ba9092ba2cf655ee88980, https://si.imgix.net/1e71961e/uploads/origins/4175f1ae-6f27-4ee6-bfd4-4f8df9161189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e12ddb2b9bbf2b36107da16924b2bfbf 2x, https://si.imgix.net/1e71961e/uploads/origins/4175f1ae-6f27-4ee6-bfd4-4f8df9161189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c81d37f198e0f9830990df26b91a0ecc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ご無沙汰しております。\n今回は\n\n芦原温泉、芦原小梅ちゃんの十二単を借りてみたたまきさん\n\nをお願いいたします\n\nhttps://x.com/h_kamikawa_/status/1885861557613314367?t=hLAH91M0uQZLLyeMwtQWaw&s=19\n\n２月頭に行ってきまして、十二単に大層興味を持ったご様子。\n\n「ど、どうかな。マスター？」のような照れながらもおすまし顔でアピールする表情を。\n\n後ろで貸した小梅ちゃんもご満悦。\n\nという具合いでお願いいたします。\n\n資料URLに写真を添えておきました。\n\nhttps://photos.app.goo.gl/hJoaFjbRd9oLkWfRA", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/41", "thumbnail_src": "https://si.imgix.net/4040e5c7/uploads/origins/7558b93e-c9ae-42ee-bb9e-05ea302d6b14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8b59b0ce148ce7f0793503780798c7", "thumbnail_srcset": "https://si.imgix.net/4040e5c7/uploads/origins/7558b93e-c9ae-42ee-bb9e-05ea302d6b14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8b59b0ce148ce7f0793503780798c7, https://si.imgix.net/4040e5c7/uploads/origins/7558b93e-c9ae-42ee-bb9e-05ea302d6b14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30ca2f661934691621dfe067a01ea348 2x, https://si.imgix.net/4040e5c7/uploads/origins/7558b93e-c9ae-42ee-bb9e-05ea302d6b14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e981864956222d60830af70af0da794d 3x", "genre": "art", "nsfw": false, "body": "いつもかわいいイラストをありがとうございます。\n今回は温泉むすめの奥津かがみちゃんをお願いします。\n\n衣装は基本衣装で、\n構図とシチュエーションは先日描いていただいた砂和ちゃんと同様にお願いします。\n太ももが少し見えるぐらいのアングルで。\n背景はおまかせします。\n\nイラストはskebのビッグタペストリーにするのと、Xのポストで使用です。\nこれで、美作三姉妹を揃えられます。", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/40", "thumbnail_src": "https://si.imgix.net/51b14572/uploads/origins/523c90c2-7633-4e6f-8ac4-bc858dfae835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ff755ac64dd96d62348f2497ad2d04e", "thumbnail_srcset": "https://si.imgix.net/51b14572/uploads/origins/523c90c2-7633-4e6f-8ac4-bc858dfae835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ff755ac64dd96d62348f2497ad2d04e, https://si.imgix.net/51b14572/uploads/origins/523c90c2-7633-4e6f-8ac4-bc858dfae835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fcb95b6a00bc3b32ff5140c9c815af2 2x, https://si.imgix.net/51b14572/uploads/origins/523c90c2-7633-4e6f-8ac4-bc858dfae835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c4dce8ccc0541290190153a27f61d8e 3x", "genre": "art", "nsfw": false, "body": "翡翠みりゅうちゃんのローアングルのイラストをお願いします\n\nhttps://x.com/Miryu_h88/status/1863756714086195298?t=3X36-Vphdqzr4SP0vfkLNw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/39", "thumbnail_src": "https://si.imgix.net/807254c1/uploads/origins/d140a08a-7c19-4aa6-83fa-173f9b1e65f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff83f521d57081bfed8dc76b8f1617a", "thumbnail_srcset": "https://si.imgix.net/807254c1/uploads/origins/d140a08a-7c19-4aa6-83fa-173f9b1e65f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff83f521d57081bfed8dc76b8f1617a, https://si.imgix.net/807254c1/uploads/origins/d140a08a-7c19-4aa6-83fa-173f9b1e65f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76afb9def989aa158555cc6350eb0f58 2x, https://si.imgix.net/807254c1/uploads/origins/d140a08a-7c19-4aa6-83fa-173f9b1e65f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbaba4dfcaf078cef631f951dd0521f5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/38", "thumbnail_src": "https://si.imgix.net/46be9daa/uploads/origins/7a6861a2-0b56-42e2-92ba-92e34ff7b035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed19334c6bf41a29d4912fa0e1227aef", "thumbnail_srcset": "https://si.imgix.net/46be9daa/uploads/origins/7a6861a2-0b56-42e2-92ba-92e34ff7b035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed19334c6bf41a29d4912fa0e1227aef, https://si.imgix.net/46be9daa/uploads/origins/7a6861a2-0b56-42e2-92ba-92e34ff7b035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8159d4696e0ed4aa2946949eae1f834 2x, https://si.imgix.net/46be9daa/uploads/origins/7a6861a2-0b56-42e2-92ba-92e34ff7b035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3897258ef9d72495b1caef5f6ac4df8c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。度々素敵で可愛らしいイラストを描いていただきありがとうございます。\n今回もリクエストよろしければ、温泉むすめの三朝歌蓮ちゃんと城プロのヴェルサイユ宮殿さんの2人が一緒にいるイラストをお願いします。\n\n歌蓮ちゃんはデフォルトの衣装 https://onsen-musume.jp/character/misasa_karen 。\nヴェルサイユ宮殿さんはこちら https://drive.google.com/file/d/1r4agjsA9vaJz-55UDrwXH_jwaiBmJU_9/view の軽装で、おっぱいの大きさも先程の資料と同じ大きさでお願いします。\n\n\n三朝温泉のある三朝町と(ヴェルサイユ宮殿とは直接関係はありませんが)フランスの温泉地ラマルー・レ・バン町が\n姉妹都市という事で、三朝町の温泉むすめとフランスの城娘たるこの2人の並びを見てみたいと思い\n今回リクエストさせていただきましたが、無理がある内容でしたらすみません。条件付き再送要請か又は\nキャンセルしていただいて問題ありませんが、問題無いようでしたら改めてよろしくお願いします。\n\nhttps://scre.swiki.jp/index.php?%E3%83%B4%E3%82%A7%E3%83%AB%E3%82%B5%E3%82%A4%E3%83%A6%E5%AE%AE%E6%AE%BF", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/37", "thumbnail_src": "https://si.imgix.net/b60650b2/uploads/origins/b02cb01d-025d-4edc-aaf0-105cb89346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5a74c9406bc73645b86534364a4758", "thumbnail_srcset": "https://si.imgix.net/b60650b2/uploads/origins/b02cb01d-025d-4edc-aaf0-105cb89346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5a74c9406bc73645b86534364a4758, https://si.imgix.net/b60650b2/uploads/origins/b02cb01d-025d-4edc-aaf0-105cb89346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc9464e0d8322ca743f8fe46208f87b5 2x, https://si.imgix.net/b60650b2/uploads/origins/b02cb01d-025d-4edc-aaf0-105cb89346a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e028dccae4904b04096a3c0853964352 3x", "genre": "art", "nsfw": false, "body": "前回は、とても素敵な作品に仕上げて頂き\nありがとうございました！\n\n今回お願いしたいのは、なほさんへのサプライズなお祝いとして、なほさんのVU(バージョンアップ)の日（2022年９月８日）と初めてのラッピングが星座なでんこたち（おとめ座ななほ）がVU実装の日が丁度、星座が同じだったので、同じ星座ラッピングのルナさんといちほさんに協力して頂いて、最近流行りのハイタッチやハートで手合わせをVUの日の数字で手合わせしてる姿を、前回と同じ様にかわいい感じにして頂けたら有難いです。\n感じ的には、向かって左側にルナさん、中央になほさん、右側にいちほさんで、ルナさんの左手のひらを丸く輪にして、なほさんの右手のひら伸ばして重ね数字の９に見える感じに合して、なほさんの左手といちほさんの右手は手のひら丸く輪を重ねて数字の８に見える感じにして頂きたいです。\nこの時、ルナさんとなほさんが手に持っている麦穂は数字が作れなくなるので外して下さい。\n\n説明が下手で長文になってすみませんが宜しければ、ご検討宜しくお願い致します。\n\nhttps://ibb.co/RpVRVBC", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/36", "thumbnail_src": "https://si.imgix.net/9297e439/uploads/origins/c370b6e2-2bbe-42f7-bbaa-26fcc85ab725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8137fbc078eafd30f364b006aa0c65fd", "thumbnail_srcset": "https://si.imgix.net/9297e439/uploads/origins/c370b6e2-2bbe-42f7-bbaa-26fcc85ab725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8137fbc078eafd30f364b006aa0c65fd, https://si.imgix.net/9297e439/uploads/origins/c370b6e2-2bbe-42f7-bbaa-26fcc85ab725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18da29173dc48a8c0c8fbc17c6a43019 2x, https://si.imgix.net/9297e439/uploads/origins/c370b6e2-2bbe-42f7-bbaa-26fcc85ab725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07c574fbd47008325c01c072723e0f13 3x", "genre": "art", "nsfw": false, "body": "温泉むすめの湯原砂和ちゃんをお願いします。\n先日のデッキブラシ砂和ちゃんを見てお願いしたくなりました。\n\n衣装は基本衣装で、\n振り返った砂和ちゃんをお願いします。\n待ち合わせをしていたら背後から声をかけられ、\n振り返ったら待っていた人が現れて嬉しい顔をしている\nこんなシチュエーションでお願いします。\n太ももが少し見えるぐらいのアングルで。\n背景はおまかせします。\n\nイラストはskebのビッグタペストリーにするのと、Xのポストで使用、\n予算に都合がつけばアクリルプレートにしようかと考えています。", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/35", "thumbnail_src": "https://si.imgix.net/b9a4852c/uploads/origins/baf412d2-c7bb-4a7a-b238-ed5129601d18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65487a3bcbd4d91566371ecdcaff672b", "thumbnail_srcset": "https://si.imgix.net/b9a4852c/uploads/origins/baf412d2-c7bb-4a7a-b238-ed5129601d18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65487a3bcbd4d91566371ecdcaff672b, https://si.imgix.net/b9a4852c/uploads/origins/baf412d2-c7bb-4a7a-b238-ed5129601d18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3ee74e74785b3bb505450c9aa81924c 2x, https://si.imgix.net/b9a4852c/uploads/origins/baf412d2-c7bb-4a7a-b238-ed5129601d18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81f8795f6dec26a16b6757ab10017704 3x", "genre": "art", "nsfw": false, "body": "ちーこさん、いつもお世話になっております。\nまたぽかでリクエストさせてください\n今回は万座千斗星ちゃんをお願いしたいです。\n\n衣装はゆのこれで実装されていた水着をお願いしたいです\n構図としては万座ジュラクさんにある万座ビーチ（山）でアイドルっぽさを出しているな感じでお願いしたいです。\n時間帯は昼夜どちらでも\n一応wikiから資料リンクはしていますが全身ではないため、フォロワー氏よりいただいたゲームの画像をdriveで共有します。\nよろしくお願いいたします。\n\n以下、参考資料\nゆのこれ衣装：https://www.dopr.net/yunokore/c-manza-sr\n万座ビーチ（山）：https://x.com/CHITOSE_MANZA/status/1796730010319110173\n\nhttps://drive.google.com/drive/folders/1-GSdSgxwlM_s6oc9-2kiulSQv8XsqPU-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/34", "thumbnail_src": "https://si.imgix.net/6e26d2c8/uploads/origins/3e1afa20-a873-4e1b-85b5-13a0894eb8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c86f2986259e5d52d0f61eb5ad091121", "thumbnail_srcset": "https://si.imgix.net/6e26d2c8/uploads/origins/3e1afa20-a873-4e1b-85b5-13a0894eb8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c86f2986259e5d52d0f61eb5ad091121, https://si.imgix.net/6e26d2c8/uploads/origins/3e1afa20-a873-4e1b-85b5-13a0894eb8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40283bd46a3b5fa89999e39180391568 2x, https://si.imgix.net/6e26d2c8/uploads/origins/3e1afa20-a873-4e1b-85b5-13a0894eb8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7734fa33057c32df677947f3d192aa73 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/33", "thumbnail_src": "https://si.imgix.net/b6c3ba19/uploads/origins/0b55a477-b5d7-42e8-af83-7f71c576ad96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5f3c4297fa1ad91ce0e255cba501f7a", "thumbnail_srcset": "https://si.imgix.net/b6c3ba19/uploads/origins/0b55a477-b5d7-42e8-af83-7f71c576ad96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5f3c4297fa1ad91ce0e255cba501f7a, https://si.imgix.net/b6c3ba19/uploads/origins/0b55a477-b5d7-42e8-af83-7f71c576ad96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5d046e9a4ce83b002904327b373dc66 2x, https://si.imgix.net/b6c3ba19/uploads/origins/0b55a477-b5d7-42e8-af83-7f71c576ad96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a955bbd4db71b5857e1353d011633b4c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、日頃から温むすのイラストを拝見させていただいてます。\n私の好きな温泉地の人吉温泉の温泉むすめ「人吉青井」さんを描いていただけないでしょうか。\n希望のシチュエーションは居酒屋でお酒を飲んでほろ酔いな状態、あと飲んでいるのは球磨焼酎だと判るように「ガラ」と呼ばれる酒の入った容器がテーブルにあり「チョク」と呼ばれるお猪口を手にしていることを希望します。\n容器に関する資料は添付のURL　球磨焼酎酒造組合のホームページから確認をお願いします。\n\nhttps://kumashochu.or.jp/enjoy/culture/", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/32", "thumbnail_src": "https://si.imgix.net/3a44e674/uploads/origins/9ffc2689-1449-4f85-8a16-4d8a64847de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03096311a94c4d2cdcd0198e9e89fbcb", "thumbnail_srcset": "https://si.imgix.net/3a44e674/uploads/origins/9ffc2689-1449-4f85-8a16-4d8a64847de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03096311a94c4d2cdcd0198e9e89fbcb, https://si.imgix.net/3a44e674/uploads/origins/9ffc2689-1449-4f85-8a16-4d8a64847de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6679f3baa6caa6b66c2bc063b5d1adcd 2x, https://si.imgix.net/3a44e674/uploads/origins/9ffc2689-1449-4f85-8a16-4d8a64847de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1445f91378baf132be50c34ede3fa5f5 3x", "genre": "art", "nsfw": false, "body": "ガールズプラモデル30 MINUTES SISTERSのツキルナをリクエストします。\n\nイノセンテフォームと杵形の武器を装備して笑顔で決めポーズをお願いします。\n\n手脚等の関節は人体と同じでも構いません。\n\nよろしくお願いします。\n\nhttps://bandai-hobby.net/item/5943/", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/31", "thumbnail_src": "https://si.imgix.net/fcff860c/uploads/origins/005d2e86-a7a5-4a6f-bd0a-8e82be0e37d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae7b26f62644d5f652760fbd78631565", "thumbnail_srcset": "https://si.imgix.net/fcff860c/uploads/origins/005d2e86-a7a5-4a6f-bd0a-8e82be0e37d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae7b26f62644d5f652760fbd78631565, https://si.imgix.net/fcff860c/uploads/origins/005d2e86-a7a5-4a6f-bd0a-8e82be0e37d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02ded7927d6f919c778289bae6d0a52a 2x, https://si.imgix.net/fcff860c/uploads/origins/005d2e86-a7a5-4a6f-bd0a-8e82be0e37d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1b5d3701886367a8145b57cb87ab455 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト見させて頂いております\n城崎温泉の温泉むすめ、城崎亜莉咲ちゃんのイラストをお願いします\n\nシチュエーションが少し難しく、城崎温泉ゆかりの文豪、志賀直哉の「城崎にて」をモチーフに\n亜莉咲ちゃんがハチとネズミとイモリのぬいぐるみを抱えて強い表情で正面を見つめて立っているというものです\n城崎にては短編でネットでも読めるので読んでもらう方がわかりやすいですが\n生と死がテーマの作品で偶然生きた自分と死んでいく小動物の死から感じる事ポイントになります\n\nぬいぐるみ達は全て目を閉じて死んでいる\nハチは縮こまり\nネズミには串が刺さっている\nイモリは脱力して垂れている\n亜莉咲ちゃんの表情は無情の中で生きる意思を示す感じで\n旅館の浴衣で地味目で、籐の椅子に座って正面からで\n純文学の本表紙のイメージがいいかもしれません\n縦書きで城崎にての文字入りの差分があると嬉しいです\n\n得意のタイプと違って難しいかもしれませんがよければお願いします\n\n資料URLはゆかりの宿の三木屋さんのHPです\nイメージの参考までにお願いします\n\nhttps://www.google.com/imgres?imgurl=https%3A%2F%2Fkinosaki-mikiya.jp%2Fuploads%2Fmikiya_18-2-1440x960.jpg&tbnid=r-pJBKmEngrQYM&vet=1&imgrefurl=https%3A%2F%2Fkinosaki-mikiya.jp%2F&docid=ruUPmn8S04AM7M&w=1440&h=960&source=sh%2Fx%2Fim%2Fm4%2F2&kgs=d7426726f6", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/30", "thumbnail_src": "https://si.imgix.net/7663bed9/uploads/origins/8712d7e7-072c-4fcf-9e0d-ca5e3444f786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dc377ef34aee2b39e48cc46a4bfe187", "thumbnail_srcset": "https://si.imgix.net/7663bed9/uploads/origins/8712d7e7-072c-4fcf-9e0d-ca5e3444f786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dc377ef34aee2b39e48cc46a4bfe187, https://si.imgix.net/7663bed9/uploads/origins/8712d7e7-072c-4fcf-9e0d-ca5e3444f786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c931671f9e70d86701ab5516b277cf6 2x, https://si.imgix.net/7663bed9/uploads/origins/8712d7e7-072c-4fcf-9e0d-ca5e3444f786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=463a9c66775a257e1d28201a1560420b 3x", "genre": "art", "nsfw": false, "body": "ちーこさん、こんばんはです！\nふわっと思いついたリクエストをお願いしたいです。\n今回は駅メモの小浜まいちゃんと温泉むすめの小浜あまねちゃんをお願いしたいです。\nまいちゃんの衣装はスペシャルフィルムチェンジのほうでお願いします。\n今回の構図は単純明快に二人の小浜ちゃんに応援されたいという内容です。\nまいちゃんのほう手持ち何もないですが、あまねちゃんと合わせてなにかしらのポンポン持たせてください\n\nそんな感じでお願いできますでしょうか。", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/29", "thumbnail_src": "https://si.imgix.net/6c2f38b1/uploads/origins/1428e1bf-2519-42d3-9661-b346fd9ee046?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c0b01cf68fd446fe86dbf9c7728838e", "thumbnail_srcset": "https://si.imgix.net/6c2f38b1/uploads/origins/1428e1bf-2519-42d3-9661-b346fd9ee046?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c0b01cf68fd446fe86dbf9c7728838e, https://si.imgix.net/6c2f38b1/uploads/origins/1428e1bf-2519-42d3-9661-b346fd9ee046?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=457c94b6eed57e8e71887097e05f69d6 2x, https://si.imgix.net/6c2f38b1/uploads/origins/1428e1bf-2519-42d3-9661-b346fd9ee046?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a85ff6723d115e6682d6b274e6d7bca 3x", "genre": "art", "nsfw": false, "body": "こんにちは。度々素敵で可愛らしいイラストを描いていただきありがとうございます。\n今回もリクエストよろしければうちの子の優希さん(身長151cm。銀髪で童顔・巨乳、物静かな雰囲気)と、茜さん(身長160cm。茶髪でショートヘアのツーサイドアップ、おっぱいは普通サイズ、活発な雰囲気)が一緒にいるイラストをお願いします。\n\n服装はそれぞれのデフォルトの制服姿でお願いします。\n\nプロフィールにも記載されていますが、おっぱいの大きさは\n優希殿＞茜殿　でお願いします。\n\n無理がある内容でしたらすみません。条件付き再送要請か又はキャンセルしていただいて問題ありませんが、\n問題無いようでしたら改めてよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1IR13JIMOoqlwjPpThdHDD9HYE57mWxPj/view\n\nhttps://drive.google.com/file/d/1c6K0F0apG2NYDa3oR-92ObHxiIXDfO5W/view", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/28", "thumbnail_src": "https://si.imgix.net/27ba3c0e/uploads/origins/4082a628-11b7-4ddf-86da-2d7271c26816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aa02267aab899d39d1868543b11655b", "thumbnail_srcset": "https://si.imgix.net/27ba3c0e/uploads/origins/4082a628-11b7-4ddf-86da-2d7271c26816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aa02267aab899d39d1868543b11655b, https://si.imgix.net/27ba3c0e/uploads/origins/4082a628-11b7-4ddf-86da-2d7271c26816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56f7b81a2945481509e8936bdba9f41b 2x, https://si.imgix.net/27ba3c0e/uploads/origins/4082a628-11b7-4ddf-86da-2d7271c26816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c6dd966b8ed92355419ebb348a577ef 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/27", "thumbnail_src": "https://si.imgix.net/25866aab/uploads/origins/1f9c84b2-708e-4c85-86e9-db6e1ce4f89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdcde47725ff13904708162126ba9d5", "thumbnail_srcset": "https://si.imgix.net/25866aab/uploads/origins/1f9c84b2-708e-4c85-86e9-db6e1ce4f89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdcde47725ff13904708162126ba9d5, https://si.imgix.net/25866aab/uploads/origins/1f9c84b2-708e-4c85-86e9-db6e1ce4f89f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15ecc35cac709426f57c0332c7408cb5 2x, https://si.imgix.net/25866aab/uploads/origins/1f9c84b2-708e-4c85-86e9-db6e1ce4f89f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=060f93d25b69cbbb3192d9e564b92b8e 3x", "genre": "art", "nsfw": true, "body": "こんばんは。さっそくですがリクエスト致します。\n\n駅メモ!\n天王寺たまきさんで\n\n温泉むすめ、飯坂真尋ちゃんのフクロウパーカーを借りて着てみた。\n\nをお願いします。\n\n着てみたものの、真尋ちゃんサイズはたまきさんには小さく、丈が足りず下着が見えてしまうので、前側を下にひっぱってなんとか隠そうとしてる姿。(胸周りもちょっとキツイ)\n\nというシチュエーションで、よろしくお願いします。\n\n前フリ\nhttps://twitter.com/h_kamikawa_/status/1753596950149279822?t=d5LbHhM99vSiFf2xFLBo3A&s=19", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/26", "thumbnail_src": "https://si.imgix.net/cf0dd522/uploads/origins/99ad0a71-8e78-4b8e-9d9c-bc05517529f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d380f54a20a71b838de68e2ade61dbf7", "thumbnail_srcset": "https://si.imgix.net/cf0dd522/uploads/origins/99ad0a71-8e78-4b8e-9d9c-bc05517529f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d380f54a20a71b838de68e2ade61dbf7, https://si.imgix.net/cf0dd522/uploads/origins/99ad0a71-8e78-4b8e-9d9c-bc05517529f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8261a94da7e74420c878e38a30a2e699 2x, https://si.imgix.net/cf0dd522/uploads/origins/99ad0a71-8e78-4b8e-9d9c-bc05517529f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cce1dd74e8f81dd365f5a7857266eeb7 3x", "genre": "art", "nsfw": false, "body": "駅メモの粟生津しいらと花畑もえがスクール水着を着ているツーショットイラストをお願いします。\n\nスク水は紺色で肩ひもが白の競スクタイプで、名札は無しでハイレグにならない様お願いします。\n\n表情はしいらは少し恥じらっている感じの笑顔、もえは100%な笑顔でお願いします。\n\nポーズはお任せします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/25", "thumbnail_src": "https://si.imgix.net/2e637a4d/uploads/origins/7738a4d7-2a7f-4da6-be66-92f74abf57f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dec06b2cdcc9372f5bfac181d4932b3", "thumbnail_srcset": "https://si.imgix.net/2e637a4d/uploads/origins/7738a4d7-2a7f-4da6-be66-92f74abf57f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dec06b2cdcc9372f5bfac181d4932b3, https://si.imgix.net/2e637a4d/uploads/origins/7738a4d7-2a7f-4da6-be66-92f74abf57f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b73748327cf226eb00f890cc5e8588df 2x, https://si.imgix.net/2e637a4d/uploads/origins/7738a4d7-2a7f-4da6-be66-92f74abf57f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0554d3d210b28c23dd6b9992f97d2483 3x", "genre": "art", "nsfw": false, "body": "いよいよ18きっぷが余計に使い辛くなる 3月16日よりTwitterのヘッダー(横長の画像)に導入したくオファーしました\n\n窓口で出札補充券やら、見るからにただ事では無さげな乗車券類一式(以下URL 2件)を受取り「私からのプレゼント。これからも一緒だよ」😉と照れ笑いで差し出す那須一与を描いてほしいです\n\nhttps://twitter.com/kawashima_Fe/status/1657560163828760577?t=woyJBGzBSju90LnDpIqnFg&s=19\n\nhttps://twitter.com/kawashima_Fe/status/1661026698127892482?t=__v6pis0rZP23MdFeUSxkQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/24", "thumbnail_src": "https://si.imgix.net/00476387/uploads/origins/f1d2ff37-3c65-408d-bea7-89360ef9270f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1cdfa8b3c2ad102334b6b5b1c6da5a4", "thumbnail_srcset": "https://si.imgix.net/00476387/uploads/origins/f1d2ff37-3c65-408d-bea7-89360ef9270f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1cdfa8b3c2ad102334b6b5b1c6da5a4, https://si.imgix.net/00476387/uploads/origins/f1d2ff37-3c65-408d-bea7-89360ef9270f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cb7adf8e03efe55b775024475ddfd12 2x, https://si.imgix.net/00476387/uploads/origins/f1d2ff37-3c65-408d-bea7-89360ef9270f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4b096852bbbc96dccaeffd820fdbfad 3x", "genre": "art", "nsfw": false, "body": "いつもちーこさんのかわいい絵で癒されています、ありがとうございます\n今回も奏バーデン由布院ちゃんをお願いしたく思います\n\nバーデンとまひろウちゃん、けろけろ美月氏とほよほよかがみちゃん(ぬいぐるみ)と楽しそうにお出かけしてる感じのかわいい絵をお願いしたいです\n\nまひろウちゃんとけろ美月氏は腕に抱き抱えられてる感じで、ほよほよかがみちゃんはあたまとか肩にちょこんとのってる、引っ付いてるような感じで描いていただけたらありがたいです\nあくまで参考な感じですので配置が面倒だった時は適当に配置していただいて構いません\nバーデンの服もかわいい感じのよそ行きな服を着せていただいたらものすごく嬉しいです\n公式ではなかなか別衣装が見れないので、かわいい感じの違った衣装を着たバーデンが見たいので、よろしければお願いいたします\nなかなか面倒なリクエストですが、もしよろしければお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/23", "thumbnail_src": "https://si.imgix.net/f10e9b1d/uploads/origins/2b0cbfce-f5fb-460c-ab8c-ddc52cb6e4af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e1eadcc6f12bef2b46741ddbf22d6bc", "thumbnail_srcset": "https://si.imgix.net/f10e9b1d/uploads/origins/2b0cbfce-f5fb-460c-ab8c-ddc52cb6e4af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e1eadcc6f12bef2b46741ddbf22d6bc, https://si.imgix.net/f10e9b1d/uploads/origins/2b0cbfce-f5fb-460c-ab8c-ddc52cb6e4af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5952a3d391ad3ccb143d24e1aaf1d5fc 2x, https://si.imgix.net/f10e9b1d/uploads/origins/2b0cbfce-f5fb-460c-ab8c-ddc52cb6e4af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1af409b9c6288b70f18dbfe06837d221 3x", "genre": "art", "nsfw": false, "body": "昨年は素晴らしい水着おくるちゃんを描いていただきありがとうございました。\nまた、おくるちゃんを「スクールライフなおくる２０２３」で描いていただけないでしょうか。\nhttps://imepic.jp/20240110/849920\nただ髪型は三つ編みおさげじゃなくて下ろしたロングの状態希望です。\nまた、スカートがふわりと舞う感じがいいです。\nその他の表情やポーズなどはお任せで可愛く描いていただければ…！\nあと、私個人のみの利用の範囲で、アイコン・ヘッダーやポスター等に使用することをご了解いただけるとありがたいです。\nどうぞ、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/22", "thumbnail_src": "https://si.imgix.net/9dc65d57/uploads/origins/4ca123aa-c622-4d0f-8a2d-0d4a8f987cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a138a97af9f183896032318ad7e111d4", "thumbnail_srcset": "https://si.imgix.net/9dc65d57/uploads/origins/4ca123aa-c622-4d0f-8a2d-0d4a8f987cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a138a97af9f183896032318ad7e111d4, https://si.imgix.net/9dc65d57/uploads/origins/4ca123aa-c622-4d0f-8a2d-0d4a8f987cad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=691481ca97117069eb4c402caa50d7af 2x, https://si.imgix.net/9dc65d57/uploads/origins/4ca123aa-c622-4d0f-8a2d-0d4a8f987cad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37a0e87ac1a502f6afc1122333d0bfee 3x", "genre": "art", "nsfw": false, "body": "こんにちは。改めて前回は温泉むすめと城娘のペアイラストをありがとうございます。\n今回もリクエストよろしければ、城プロのイオラニ宮殿さん(城娘姿の服装。武器・背面部分は省略。)と、\n温泉むすめの白浜帆南美ちゃん(ルーラコインカードの服装)の2人が一緒にいるイラストをお願いします。\n\n白浜温泉のある白浜町とイオラニ宮殿があるホノルル市が友好都市同士という事で、\nこの2人の並びを見てみたいと思い今回リクエストさせていただきましたが、無理がある内容でしたらすみません。\n条件付き再送要請か又はキャンセルしていただいて問題ありませんが、問題無いようでしたら改めてよろしくお願いします。\n\nhttps://skeb.jp/@oshiruko_biwako/works/4\n\nhttps://scre.swiki.jp/index.php?%E3%82%A4%E3%82%AA%E3%83%A9%E3%83%8B%E5%AE%AE%E6%AE%BF", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/21", "thumbnail_src": "https://si.imgix.net/d94e5a48/uploads/origins/26bc37c8-ca07-4fcc-a52c-9f2e8921f2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=032a545c63fb3934b64d39543b3bd563", "thumbnail_srcset": "https://si.imgix.net/d94e5a48/uploads/origins/26bc37c8-ca07-4fcc-a52c-9f2e8921f2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=032a545c63fb3934b64d39543b3bd563, https://si.imgix.net/d94e5a48/uploads/origins/26bc37c8-ca07-4fcc-a52c-9f2e8921f2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f55c7b21b2a74ade084182cf753a6138 2x, https://si.imgix.net/d94e5a48/uploads/origins/26bc37c8-ca07-4fcc-a52c-9f2e8921f2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ff945ac4e1d85a5496aa2f596cf91c3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oshiruko_biwako/works/20", "thumbnail_src": "https://si.imgix.net/c1ea8a4a/uploads/origins/43ae6fbe-e5a8-4a22-8dbe-bdc7d7c8c8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=561140a5c7e061c8b343994d9b92fc9a", "thumbnail_srcset": "https://si.imgix.net/c1ea8a4a/uploads/origins/43ae6fbe-e5a8-4a22-8dbe-bdc7d7c8c8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=561140a5c7e061c8b343994d9b92fc9a, https://si.imgix.net/c1ea8a4a/uploads/origins/43ae6fbe-e5a8-4a22-8dbe-bdc7d7c8c8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82f89734e6e7bc6e242ba2ac4228e1eb 2x, https://si.imgix.net/c1ea8a4a/uploads/origins/43ae6fbe-e5a8-4a22-8dbe-bdc7d7c8c8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=740c2b558f7d9839e0ceecbcc5cc927e 3x", "genre": "art", "nsfw": false, "body": "はじめまして！先日Xにポストされていた栞ちゃん、とても可愛かったです！！\nまたskebを開けられる時を待っておりましたが、ぜひ私も描いていただきたく、リクエストさせていただきます。\nうちの子「ユウ」をお願いします。\n色々と至らないところが多いので、、モチーフくらいにしていただいて、ちーこさんワールドでかわいく描いていただけたら嬉しいです。\nご検討の程、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/13dEO_e0aH82VyzChm_Pak_rhJZWoWx18/view?usp=sharing", "created_at": "", "completed_at": ""}]}