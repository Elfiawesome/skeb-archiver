74-9a91-43d6-8b24-0c3382bf6ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fe7ad4add56ff4e0a6ddd3109474160 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/109", "thumbnail_src": "https://si.imgix.net/6ff05481/uploads/origins/0ffc119d-77ce-473d-b98c-924b1ab1d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4978b1f45fc282d683dfb4ba0e371d", "thumbnail_srcset": "https://si.imgix.net/6ff05481/uploads/origins/0ffc119d-77ce-473d-b98c-924b1ab1d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e4978b1f45fc282d683dfb4ba0e371d, https://si.imgix.net/6ff05481/uploads/origins/0ffc119d-77ce-473d-b98c-924b1ab1d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee98362914ef715494998cba36a83f93 2x, https://si.imgix.net/6ff05481/uploads/origins/0ffc119d-77ce-473d-b98c-924b1ab1d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=625d84e2cb926f1d34a45006a2f59f54 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n今回は、玉ありふたなりのこころちゃんと小傘ちゃんがエロトラップダンジョンに迷い込み、エロトラップに引っかかってアクメビームを大量に浴びながらブリブリと人格排泄して大量噴乳と大量射精して無様絶頂するイラストををお願いします！\n\nまたもしも可能な場合は最後に人格排泄の影響で小傘ちゃんは金色のモルゲッソヨ像化して、こころちゃんは無表情で敬礼している状態で2人とも母乳とザーメンを垂れ流してる差分もお願いしたいです…！\n\n要望が色々と多くて申し訳ありませんが余裕がある時などのタイミングがいい時で良いので是非こちらのリクエストの方、ご検討の方をよろしくお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/108", "thumbnail_src": "https://si.imgix.net/ba98209c/uploads/origins/4fdd65ab-1d6f-4974-8344-53ef2d920fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc7394a68673a44d55e155cc0833fd3c", "thumbnail_srcset": "https://si.imgix.net/ba98209c/uploads/origins/4fdd65ab-1d6f-4974-8344-53ef2d920fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc7394a68673a44d55e155cc0833fd3c, https://si.imgix.net/ba98209c/uploads/origins/4fdd65ab-1d6f-4974-8344-53ef2d920fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=926074aaecdc1920193aee0edeede500 2x, https://si.imgix.net/ba98209c/uploads/origins/4fdd65ab-1d6f-4974-8344-53ef2d920fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7260db2fc771475c7c7c3e1483f2a95c 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n遊戯王より、ふたなりブリッジ怪人化した閃刀姫ロゼのイラストをお願いします。\n彼女は裸姿で、天井にブリッジの姿勢で張り付いています。性格や口調もビッチな感じになっており、レイへの愛を滅茶苦茶拗らせています。\nそんな彼女の元に大好きなレイ(レイの絵はあってもなくても良い)が駆けつけてくれますが、ロゼはレイの前でエンゲージと唱え、爆乳で立派なフタナリチンポ(玉あり)が生えた体に変身し、その姿をレイに見せびらかします。\nそしてロゼは彼女に媚薬成分たっぷりの母乳をかけて弱らせた後、粘度が高い精液をぶっかけて捕縛します。\n以上、ご検討頂けると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/107", "thumbnail_src": "https://si.imgix.net/06553714/uploads/origins/751c3272-0843-4a2f-ba34-8b7062090dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93578a7fe972a0d787ff358d15545647", "thumbnail_srcset": "https://si.imgix.net/06553714/uploads/origins/751c3272-0843-4a2f-ba34-8b7062090dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93578a7fe972a0d787ff358d15545647, https://si.imgix.net/06553714/uploads/origins/751c3272-0843-4a2f-ba34-8b7062090dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae5217ccc148852e1947bde5a1766d15 2x, https://si.imgix.net/06553714/uploads/origins/751c3272-0843-4a2f-ba34-8b7062090dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40b746978e04c5c689b934fd969171e9 3x", "genre": "art", "nsfw": true, "body": "いつもどたぷんな素晴らしい作品をありがとうございます！\n\nキャラクター　藤原妹紅（東方project）\n\n＜設定＞\n迷いの竹林で妹紅が怪しい植物に捕らわれる。\n全身の穴という穴を犯し尽くされ死ぬほどの快楽を与えられるも、何度も復活して永遠に孕んでは出産してを繰り返す苗床になってしまう。\n\nボテ腹や膨乳、噴乳などで快楽に狂う様をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/106", "thumbnail_src": "https://si.imgix.net/43135867/uploads/origins/cd388066-bc2a-46ee-b9ef-63ffe0cbd32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592c77e494de01bd8f004e1db8b7952f", "thumbnail_srcset": "https://si.imgix.net/43135867/uploads/origins/cd388066-bc2a-46ee-b9ef-63ffe0cbd32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592c77e494de01bd8f004e1db8b7952f, https://si.imgix.net/43135867/uploads/origins/cd388066-bc2a-46ee-b9ef-63ffe0cbd32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feb101e7b1eb2815c0b277e7e355a193 2x, https://si.imgix.net/43135867/uploads/origins/cd388066-bc2a-46ee-b9ef-63ffe0cbd32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e35c5150f0347fe810353ede588d5e9 3x", "genre": "art", "nsfw": false, "body": "いつもりんどうさんの描く可愛い絵に癒やされています。\n今回は全年齢依頼で、ゆかりさんに凪衣装かVOCALOID6衣装を着せてポーズを決めていただきたいです。\nポーズはお任せで、かっこいいもしくは少年漫画っぽいポーズなら凪衣装、可愛いもしくはアイドルっぽいポーズならVOCALOID6衣装でお願いします。（指針なのでどちらかの衣装であれば大丈夫です）\n\n頭身は0.5～5頭身でデフォルメか美少女っぽくか自由です。\n背景などは簡素で構いません。\n服装や起こし方もお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/105", "thumbnail_src": "https://si.imgix.net/435f0a8b/uploads/origins/230a2e04-7083-472c-9db4-354659ae271f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57bbc356ca7a971a84bba18b9d8f808", "thumbnail_srcset": "https://si.imgix.net/435f0a8b/uploads/origins/230a2e04-7083-472c-9db4-354659ae271f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57bbc356ca7a971a84bba18b9d8f808, https://si.imgix.net/435f0a8b/uploads/origins/230a2e04-7083-472c-9db4-354659ae271f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb44e0fe0bc22062890bad3745a1fafd 2x, https://si.imgix.net/435f0a8b/uploads/origins/230a2e04-7083-472c-9db4-354659ae271f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=900811e354576b72deaf4063950ae365 3x", "genre": "art", "nsfw": true, "body": "はじめまして。りんどうさんのえっちな催眠東方同人で育った者です\n\n東方キャラのリリーブラックと黒てゐが交互にえっちされちゃう奴をお願いします　2人とも身体はどぱるん♡と盛り盛りで、両手を恋人繋ぎにしてそれぞれI字バランスをとったH字バランスという姿勢で、てゐは目隠れで\n両耳に催眠ピアスを下げて、首に黒い首輪をつけて、首輪どうしをもう一つの首輪で鎖のように繋いで、おへそを出してパンティは紐、といった格好でお願いします\nそれぞれえっちされて喘いでるのと、2人が堕ちてキスしてる奴をお願いします\n\nお値段が足りなければ出しますので何卒……絵柄が好きなので……", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/104", "thumbnail_src": "https://si.imgix.net/e3befb80/uploads/origins/e7ea332a-8ec9-4a86-ac8f-86f1a5861f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=244ca7b488f02af803cded5bdc7cf54e", "thumbnail_srcset": "https://si.imgix.net/e3befb80/uploads/origins/e7ea332a-8ec9-4a86-ac8f-86f1a5861f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=244ca7b488f02af803cded5bdc7cf54e, https://si.imgix.net/e3befb80/uploads/origins/e7ea332a-8ec9-4a86-ac8f-86f1a5861f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e65914278e51bb186eb0a49c6829e0f1 2x, https://si.imgix.net/e3befb80/uploads/origins/e7ea332a-8ec9-4a86-ac8f-86f1a5861f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=110c0ea855a9e8e2810a52687a4550a9 3x", "genre": "art", "nsfw": false, "body": "東方の風見幽香(旧作風のロングヘア)、ナイスバディで黒の軍服(将校風)とハイヒール着用でスマホの壁紙用の絵を非エロでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/103", "thumbnail_src": "https://si.imgix.net/8f142fac/uploads/origins/78ad83e8-4f7e-45f6-b6f6-84e73bb23eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cab17ae56a7076f1cbe7c390e7d86d4", "thumbnail_srcset": "https://si.imgix.net/8f142fac/uploads/origins/78ad83e8-4f7e-45f6-b6f6-84e73bb23eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cab17ae56a7076f1cbe7c390e7d86d4, https://si.imgix.net/8f142fac/uploads/origins/78ad83e8-4f7e-45f6-b6f6-84e73bb23eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77392108ce29b129293d86d2e94df1b6 2x, https://si.imgix.net/8f142fac/uploads/origins/78ad83e8-4f7e-45f6-b6f6-84e73bb23eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d384bebd1f87063454b0a1809b307a 3x", "genre": "art", "nsfw": true, "body": "始めまして、りんどうさんの描かれるおっぱいやシチュがとても好きなので、リクエストさせていただきました。キャラは藤原妹紅でシチュエーションは他の絵師さんのシチュになってしまうのですが、https://www.pixiv.net/artworks/124006489のような七人岬に襲われて夜に意識が戻って恥ずかしそうにふたなり射精徘徊するシチュでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/102", "thumbnail_src": "https://si.imgix.net/604f34f0/uploads/origins/7eca4936-4646-4774-b1d5-2522101a8403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d877e6377d0430eceb7100dd0d8882", "thumbnail_srcset": "https://si.imgix.net/604f34f0/uploads/origins/7eca4936-4646-4774-b1d5-2522101a8403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93d877e6377d0430eceb7100dd0d8882, https://si.imgix.net/604f34f0/uploads/origins/7eca4936-4646-4774-b1d5-2522101a8403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03e3bf4b4ac950078ceb82cb727ffb8f 2x, https://si.imgix.net/604f34f0/uploads/origins/7eca4936-4646-4774-b1d5-2522101a8403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6a7e8b9a22f696e4c3d11a033e9dec7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rindou_/works/101", "thumbnail_src": "https://si.imgix.net/953acb99/uploads/origins/0ef3fa65-1e38-4210-8078-198641a0678e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6dd4daf123d