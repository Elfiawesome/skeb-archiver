at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=840c315a746c4744e4a7900fcc685ccd 2x, https://si.imgix.net/407e84d3/uploads/origins/ca797571-c5da-4a52-a82f-1cde375b429f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94d575b6ef011bb4786e80ed83151f59 3x", "genre": "art", "nsfw": false, "body": "ビビアンを描く。いつものように平然と。マリオカートのように運転している。平らなので、風にあおられ、飛ばされまいとしている。\n\nhttps://mario.wiki.gallery/images/5/5f/PMTTYDNS_Vivian_Artwork_2.png\n\n角度はこれに似ている：\nhttps://skeb.jp/@Dlrow_Dog/works/188\n\nhttps://mario.wiki.gallery/images/7/7a/MKWorld_Kart_Pipe_Frame_Purple.png", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/193", "thumbnail_src": "https://si.imgix.net/16c86f4c/uploads/origins/54947d64-3f70-45f1-846f-62bfef2c5328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca4eff4e011c5d365238328cd9d3adee", "thumbnail_srcset": "https://si.imgix.net/16c86f4c/uploads/origins/54947d64-3f70-45f1-846f-62bfef2c5328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca4eff4e011c5d365238328cd9d3adee, https://si.imgix.net/16c86f4c/uploads/origins/54947d64-3f70-45f1-846f-62bfef2c5328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d44549f7a109ee36cf853f17f65a0f30 2x, https://si.imgix.net/16c86f4c/uploads/origins/54947d64-3f70-45f1-846f-62bfef2c5328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7252b84f3856ab27968b4d75073d71e 3x", "genre": "art", "nsfw": false, "body": "うちのこ代理君のドラ鍋君をトゥーンドラゴンの姿にして頂けますか？以下概要になります！\n\n・ドラ鍋君は青い上着に緑のレギンス、白のシャツを着た、茶色の竜人\n・体型は西洋竜をよりコミカルにした物で胸が分かる程度に肥えている\n・カバのような鼻腔と牙、ヨッシーの様な頬、小さい羽、白テープバッテン出ベソ、ナマズ髭\n・青いジャケットに緑のズボンに白のシャツを着ていて、追加でブーツを履いています\n・表情は不満げ、驚き、困惑等から（コミカルにする等もOKです）\n\nhttps://drive.google.com/drive/folders/1djMZpm65Qf5AGRhMlqnhVxDZjiQZkXZ7", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/192", "thumbnail_src": "https://si.imgix.net/667d1bce/uploads/origins/78c853a7-5f9c-4e61-b95c-f8169b27ffee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb1462d3542dc2dd5276aa297b4182b1", "thumbnail_srcset": "https://si.imgix.net/667d1bce/uploads/origins/78c853a7-5f9c-4e61-b95c-f8169b27ffee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb1462d3542dc2dd5276aa297b4182b1, https://si.imgix.net/667d1bce/uploads/origins/78c853a7-5f9c-4e61-b95c-f8169b27ffee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8ad5ca842fd8ecdad3caec74b319e69 2x, https://si.imgix.net/667d1bce/uploads/origins/78c853a7-5f9c-4e61-b95c-f8169b27ffee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6859e6deb44929f90391d49ed79a8ea7 3x", "genre": "art", "nsfw": false, "body": "こちらのキャラ（https://ibb.co/B5kVQh54）の横平面化をお願いします。\n\nシチュエーションとしては万歳がに股のようなポーズで平面化して\n壁に張り付いているという状況です。\n平面化時の鼻の表現は先生のこちらの作品（https://skeb.jp/@Dlrow_Dog/works/144）のイメージです。\n\nキャラの表情は驚き。胸のサイズは大きめでお願いします。\nまたキャラの衣装である上着（コート）は描写無しでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/191", "thumbnail_src": "https://si.imgix.net/e421dbe1/uploads/origins/deeb4777-1f09-4dd3-8210-96109e4cb4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f7fcf6248e1a980b9f02ef890aeff6", "thumbnail_srcset": "https://si.imgix.net/e421dbe1/uploads/origins/deeb4777-1f09-4dd3-8210-96109e4cb4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f7fcf6248e1a980b9f02ef890aeff6, https://si.imgix.net/e421dbe1/uploads/origins/deeb4777-1f09-4dd3-8210-96109e4cb4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5efc5a54792c55631d72893d6f51ddcc 2x, https://si.imgix.net/e421dbe1/uploads/origins/deeb4777-1f09-4dd3-8210-96109e4cb4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ad521ff3ebc5a131814ada6810c805b 3x", "genre": "art", "nsfw": false, "body": "先生の平面化イラストがとても癖でしたのでリクエストさせて頂きました！\n\n自キャラ（https://ibb.co/0VtfrchD）の横平面化をお願いします\n手は壁を抑えるように広げ、足はややガニ股気味に明けた状態で\n厚さ1mmほどの薄さまでペラペラになった状態で啞然とした様子でヒラヒラしているイメージです\n\n平面化したキャラの鼻の表現は\n先生のこちら（https://skeb.jp/@Dlrow_Dog/works/60）の作品のような感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/190", "thumbnail_src": "https://si.imgix.net/ed60d242/uploads/origins/37821ebc-ad54-43ce-9e8f-8eb7db5bc70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15aae7ef28538d308318fa2a4355d0da", "thumbnail_srcset": "https://si.imgix.net/ed60d242/uploads/origins/37821ebc-ad54-43ce-9e8f-8eb7db5bc70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15aae7ef28538d308318fa2a4355d0da, https://si.imgix.net/ed60d242/uploads/origins/37821ebc-ad54-43ce-9e8f-8eb7db5bc70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ecf03a8ca89393337bc66f321282273 2x, https://si.imgix.net/ed60d242/uploads/origins/37821ebc-ad54-43ce-9e8f-8eb7db5bc70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7c02ac121495ab606e2778ef3f74061 3x", "genre": "art", "nsfw": false, "body": "こんばんは！\n以前ブリガロンに着られたアルムをお願いしました。今回はその続きみたいな感じで、脱いだ後も形状記憶でブリガロン型のまま戻らなくなったアルムとニヤついてるブリガロンをお願いしたいです。\n\nアルムは前回の着ぐポケがベースになっていて、表情は目が白丸になっているような泣き顔で、スタイルでお願いします。\nブリガロンは、同族(？)ができて嬉しい感じでニヤつきながらアルムに手を回してる感じで描いてください。\n\nhttps://www.dropbox.com/scl/fi/zg91zxn3funrymqmxaig4/2758394-1-2.png?rlkey=naensxqn57dog7t8nhgwhygfs&st=ta8ppq12&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/189", "thumbnail_src": "https://si.imgix.net/31405f17/uploads/origins/dedf54a2-cfb1-4618-ad51-f3a502767198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b2f169d4e11179a74d4c9d161d3376", "thumbnail_srcset": "https://si.imgix.net/31405f17/uploads/origins/dedf54a2-cfb1-4618-ad51-f3a502767198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b2f169d4e11179a74d4c9d161d3376, https://si.imgix.net/31405f17/uploads/origins/dedf54a2-cfb1-4618-ad51-f3a502767198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79ce97e7d89d555d4903f26a14388fed 2x, https://si.imgix.net/31405f17/uploads/origins/dedf54a2-cfb1-4618-ad51-f3a502767198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc77bc363cd5250d668a99fdf24585df 3x", "genre": "art", "nsfw": false, "body": "この画像のように粘土のように平らにしたファーソナが欲しいです: https://www.furaffinity.net/view/21038305/\n追加ファーソナ参照：https://www.furaffinity.net/view/60803561/\n\nhttps://www.furaffinity.net/view/63035285/", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/188", "thumbnail_src": "https://si.imgix.net/c8dfc247/uploads/origins/8ee19f38-2b98-47f1-84e5-86e739df5778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc24a6e7cb5f9a00afbadc853472cf8", "thumbnail_srcset": "https://si.imgix.net/c8dfc247/uploads/origins/8ee19f38-2b98-47f1-84e5-86e739df5778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc24a6e7cb5f9a00afbadc853472cf8, https://si.imgix.net/c8dfc247/uploads/origins/8ee19f38-2b98-47f1-84e5-86e739df5778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ce8861c64bb0b4750b2d8832d0247d6 2x, https://si.imgix.net/c8dfc247/uploads/origins/8ee19f38-2b98-47f1-84e5-86e739df5778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ac4ad7e1f80254e47ee544d94ed683a 3x", "genre": "art", "nsfw": false, "body": "横平面化したアレクくんが、えっほえっほと一生懸命ペラペラな身体を揺らして走るイラストをお願いします。\n\nアレクくんは頭のてっぺんから足先まで完全にペッラペラに平面化しており、そんなペラペラな身体をさも動きづらそうに大きく手足を振りながら走っている。身体が平面化しているせいか、速度は早くないし、不必要に身体がヒラヒラ揺れて走りづらそう。\n\nポーズの参考→https://x.com/EnderTony02/status/1989144833764802866?s=20\n\n参考画像のように、少しオーバーなくらい全身と手足をしならせて身体がペッラペラになっている様がよくわかるようにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Dlrow_Dog/works/187", "thumbnail_src": "https://si.imgix.net/61210c85/uploads/origins/5ecbb2ca-7b63-428f-8c63-a84374370632?bg=%23fff&auto=format%2Ccompress&f