ive.google.com/drive/folders/1ofvu87vyHWbZZZ9U4g_vNmFvKzqaGpyM", "created_at": "", "completed_at": ""}, {"path": "/@kyomubiyori/works/3", "thumbnail_src": "https://si.imgix.net/6e56d3b8/uploads/origins/9fe1f782-6141-41b2-b0be-1be45892970d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a31cf9cddf833cdb4e094319962d8f1", "thumbnail_srcset": "https://si.imgix.net/6e56d3b8/uploads/origins/9fe1f782-6141-41b2-b0be-1be45892970d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a31cf9cddf833cdb4e094319962d8f1, https://si.imgix.net/6e56d3b8/uploads/origins/9fe1f782-6141-41b2-b0be-1be45892970d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01c450e06f29ca283c8481de59ee9e48 2x, https://si.imgix.net/6e56d3b8/uploads/origins/9fe1f782-6141-41b2-b0be-1be45892970d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a79e553bf6a97663a93ffd350d12ae9 3x", "genre": "art", "nsfw": false, "body": "このBloodhound Plague Doctorのスキンを着た私の友人@ArkaZelaphielを描けますか？ヘッドショットでもバストアップでもOK!彼のアイコンであるショールが見えるように。ありがとうございます。\n\nhttps://cdn.discordapp.com/attachments/850819050531717161/968761747542515722/skeb.jpg", "created_at": "", "completed_at": ""}, {"path": "/@kyomubiyori/works/2", "thumbnail_src": "https://si.imgix.net/841e4330/uploads/origins/f8a46e01-e0f0-4f77-abad-5bc5f7953a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18e67399f33a9dda73eb4cf210477253", "thumbnail_srcset": "https://si.imgix.net/841e4330/uploads/origins/f8a46e01-e0f0-4f77-abad-5bc5f7953a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18e67399f33a9dda73eb4cf210477253, https://si.imgix.net/841e4330/uploads/origins/f8a46e01-e0f0-4f77-abad-5bc5f7953a52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e556d2e724b890a7c10eb28e7049a4f 2x, https://si.imgix.net/841e4330/uploads/origins/f8a46e01-e0f0-4f77-abad-5bc5f7953a52?bg=%23fff&auto=format%2Cco