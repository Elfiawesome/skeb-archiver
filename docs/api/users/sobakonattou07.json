-91df-c92c36882718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9eca1107c94b2e813928dfc082035d1", "thumbnail_srcset": "https://si.imgix.net/135b1600/uploads/origins/55cbdf08-52a4-4cd5-91df-c92c36882718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9eca1107c94b2e813928dfc082035d1, https://si.imgix.net/135b1600/uploads/origins/55cbdf08-52a4-4cd5-91df-c92c36882718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd172a548e5d6c8b903af57bec183da2 2x, https://si.imgix.net/135b1600/uploads/origins/55cbdf08-52a4-4cd5-91df-c92c36882718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a49c8538674fa9ff88ccc360b945b91 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1147", "thumbnail_src": "https://si.imgix.net/ad5ad883/uploads/origins/39509593-a328-4804-b57d-a687ab054b3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b05ee21b7f587a89c01cff59fc47c53d", "thumbnail_srcset": "https://si.imgix.net/ad5ad883/uploads/origins/39509593-a328-4804-b57d-a687ab054b3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b05ee21b7f587a89c01cff59fc47c53d, https://si.imgix.net/ad5ad883/uploads/origins/39509593-a328-4804-b57d-a687ab054b3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a324f8fa6057e358e0ebf460146d6016 2x, https://si.imgix.net/ad5ad883/uploads/origins/39509593-a328-4804-b57d-a687ab054b3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d00aeacf94d7c0beea2d2f885a4d98de 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1146", "thumbnail_src": "https://si.imgix.net/db12133d/uploads/origins/02634559-9892-444e-b4b4-5c2e53b1918a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995f9d51d5b6e4f014ea5c2ebed1b47b", "thumbnail_srcset": "https://si.imgix.net/db12133d/uploads/origins/02634559-9892-444e-b4b4-5c2e53b1918a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995f9d51d5b6e4f014ea5c2ebed1b47b, https://si.imgix.net/db12133d/uploads/origins/02634559-9892-444e-b4b4-5c2e53b1918a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a28b89cb0d0cdbda3d15618e07ea528d 2x, https://si.imgix.net/db12133d/uploads/origins/02634559-9892-444e-b4b4-5c2e53b1918a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b006635b32fed99d219f39e0f592532e 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは！長い間先生の作品を拝見しており、イラストに込められた物語性がとても好きです。ぜひこの二人のキャラクターのイラストを描いていただけたら嬉しいです！アイラ 🌌時間と空間を操る能力を持つ少女。かつては役に立たず存在感も薄かったが、今では大きな力を手に入れている。自己評価が非常に低く、他人が自分に求めるものによって自己を定義している。 \nノヴァ 🌑 短気で責任感の強い少年。自己価値を他者への有用性で測るが、自身の境遇への憤りを抱えている。アイラとノヴァは恋人同士ではないが、互いをソウルメイトと見なし深く献身し合っている。 アイラはかつて自尊心の問題を抱えていたが、より有能な人間になるため人間性の部分を犠牲にした。これにより自信は一部回復したものの、常に時空の幻影に直面し、より深刻で冷静に見える人物へと変化した。予言のような不吉な言葉を口にすることが多く、自身の力を他者に理解させることは不可能だと信じている。\n\nノヴァは常に彼女を慕っていたが、自分が崇拝し仕えるよう育てられた予言の人物に、彼女がますます似ていく姿に葛藤を感じている。彼女を助けることが人生の使命だと信じ、その遂行に専念しているが、二人とも予言から自由ではなかったという事実が彼を恐怖させ、運命を受け入れるようにさせている。彼はアイラの伴侶というより、献身的な従者としての振る舞いを始めつつある。 \n\n新たな力により、アイラは身体的に苦しみ、特に視力に問題を抱えている。ノヴァは代わりに文字を書く、移動を案内する、髪を整える、代弁者となることで彼女を支える。二人はアイラの力で人々に恩恵をもたらすため、共に世界を巡り始めた。彼女はますます宗教的な存在となりつつあるが、ノヴァに深く愛着を持つ少女であることに変わりはない。 彼女は、自分が力強い預言者のように振る舞うことで、ノヴァが最も安全で幸せを感じられると考えています。詳細はご自由に描いていただいて構いませんが、ノヴァとアイラの互いへの献身が伝わる絵をお願いします！二人の主なビジュアルテーマは星と月ですので、そちらも考慮していただけると大変嬉しいです！量的に十分かどうか心配ですが、お時間をいただき誠にありがとうございます！\n\nhttps://sun-soul-f1e.notion.site/Ayla-Nova-2db3c8c733258041ab76d65515cb7b73?source=copy_link", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1145", "thumbnail_src": "https://si.imgix.net/61af488d/uploads/origins/e266b778-b01c-4cdf-9686-756c60cbe205?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39fa2dc463755cb36eef30dd47b27f05", "thumbnail_srcset": "https://si.imgix.net/61af488d/uploads/origins/e266b778-b01c-4cdf-9686-756c60cbe205?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39fa2dc463755cb36eef30dd47b27f05, https://si.imgix.net/61af488d/uploads/origins/e266b778-b01c-4cdf-9686-756c60cbe205?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=876d562cc2f3f121ecbd1e3203e5eeb0 2x, https://si.imgix.net/61af488d/uploads/origins/e266b778-b01c-4cdf-9686-756c60cbe205?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61dbb683fbb2f56ef7378cf10a9a2007 3x", "genre": "art", "nsfw": false, "body": "こんにちは、07様。はじめまして！いつも素敵なイラストを拝見させていただいています。\n今回お願いしたいのは、COCシナリオの通過したOCになります。\n詳しい関係性や設定につきましては、資料をご参照いただけますと幸いです。\n構図や雰囲気は全面的にお任せいたしますので、ご自由に描いていただければ嬉しいです。\n\nhttps://drive.google.com/drive/folders/11mP-IOcvtOD5SYXnPwzM9vOoFVX6cV9n?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1144", "thumbnail_src": "https://si.imgix.net/a61fe15a/uploads/origins/4da6273d-9225-4406-b011-b599df78c9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19846e491d3e38b865f57802907368b4", "thumbnail_srcset": "https://si.imgix.net/a61fe15a/uploads/origins/4da6273d-9225-4406-b011-b599df78c9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19846e491d3e38b865f57802907368b4, https://si.imgix.net/a61fe15a/uploads/origins/4da6273d-9225-4406-b011-b599df78c9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87e6cd9034cf4803e3adf727f69fa3bf 2x, https://si.imgix.net/a61fe15a/uploads/origins/4da6273d-9225-4406-b011-b599df78c9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49ee05f839107c57007c2c38e0503d86 3x", "genre": "art", "nsfw": false, "body": "簡単に設定をご説明します。\n舞台は Call of Cthulhu（TRPG） の世界観です。\n\nキャラクターは二人いて、\nOC1は調査員、OC2は邪教徒です。\nOC1はこれまでずっと、OC2のことを自分にとっての「救い」のような存在だと思っていました。\nですが最後には、大義のためにOC1がOC2を殺してしまいます。\nそしてその瞬間、OC2はただ優しく微笑んでいます。\n\nシーンの構図や雰囲気などは、先生のご解釈で自由に描いていただけたら嬉しいです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1d7xaDoyZRq6VSeufxdtOLQC2pE6k0ago", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1143", "thumbnail_src": "https://si.imgix.net/49ba1e61/uploads/origins/9f4b47bd-eee4-4a38-8b98-fcc4a6db2b11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916822e6a4aebde60050c21e48278edd", "thumbnail_srcset": "https://si.imgix.net/49ba1e61/uploads/origins/9f4b47bd-eee4-4a38-8b98-fcc4a6db2b11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916822e6a4aebde60050c21e48278edd, https://si.imgix.net/49ba1e61/uploads/origins/9f4b47bd-eee4-4a38-8b98-fcc4a6db2b11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd5f53968ce5e00f3e031a76caf1f7b5 2x, https://si.imgix.net/49ba1e61/uploads/origins/9f4b47bd-eee4-4a38-8b98-fcc4a6db2b11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49267202397d22a6ee3f7b54606e6970 3x", "genre": "art", "nsfw": true, "body": "こんにちは、突然のご連絡失礼いたします。先生の絵柄がとても好きで、ぜひ私のオリジナルキャラクターを描いていただきたいです。このたび、私のオリジナルキャラクター「時谨言白髪・攻め」と「陆知屿（青髪・受け）」のイラストをご依頼させていただければと思い、メッセージを送らせていただきました。\n二人の関係性は、表面上は優しく穏やかな空気を纏いながらも、その内側には強い独占欲と執着を隠し持つ「白黒系×繊細で他者に迎合しがちなタイプ」です。\n時谨言はハッキングや機械に優れた天才で、幼い頃に両親を亡くし、「もし自分があの場にいれば救えたのではないか」という強い後悔と罪悪感を抱いています。\nその体験から、物理的な拘束や囲い込みに対する執着を持つようになりました。\nさらに、彼は過酷な環境で聴力をほとんど失っており、普段は補聴器の機能を持つ機械の耳を装着しています。耳は髪の毛に隠されており、外見上は少しデフォルメされたデザインの“機械耳”でカモフラージュされています。\nこれは、補聴器を付けることで向けられる周囲の無理解な視線を、彼なりの方法で打ち消すための「擬態」でもあります。\nしかし、その“本当の耳”を誰かに見られることは、彼にとって非常にセンシティブな問題であり、強い動揺を引き起こします。\n陆知屿は同様に極限環境で育った人物であり、時谨言の視線や独占欲に気づきながらも、生存のためにそれを受け入れてきました。\nたとえ新しい生活を始めた後も、その背後に感じるかすかな視線が消えることはなく、それが本当に存在するのか、あるいは自分の妄想なのか、彼には分からないままです。\nただ一つ言えるのは、時谨言が彼を“描かれた檻”に閉じ込めているという事実です。\nそして、時谨言の機械耳を外して清掃・メンテナンスを行うのは、二人きりの静かな時間にだけ許される、陆知屿だけが持つ特権です。それは二人の間に築かれた、密やかな信頼の証でもあります。\n金額に満たない場合は、再度リクエストを送っていただけると助かります！ご面倒であれば、キャンセルしていただいても構いません。この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1WKcoAXVDX4KvW351IFsMZPFY50gOh1Hs?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1142", "thumbnail_src": "https://si.imgix.net/459897d1/uploads/origins/e7cc7f94-f173-4970-b066-1f00d4ce9030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88be9e942480e4ceb2a6286eb9bde98b", "thumbnail_srcset": "https://si.imgix.net/459897d1/uploads/origins/e7cc7f94-f173-4970-b066-1f00d4ce9030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88be9e942480e4ceb2a6286eb9bde98b, https://si.imgix.net/459897d1/uploads/origins/e7cc7f94-f173-4970-b066-1f00d4ce9030?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9b413579bf8d3bf4ea532c2ee9090a8 2x, https://si.imgix.net/459897d1/uploads/origins/e7cc7f94-f173-4970-b066-1f00d4ce9030?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48665f85a9f473920605728f5be9cdc8 3x", "genre": "art", "nsfw": false, "body": "07 様！こんにちは！突然のご連絡、失礼いたします。\n作品から感じられる雰囲気に大変惹かれました。ぜひオリジナルキャラクターを描いていただきたく、依頼させていただきます。\n\n• 薄茶髪：教師役、穏やかな年上\n彼は孤島や山荘を舞台とした殺人事件——いわゆる「クローズドサークル」の真犯です。白髪の少年に奇妙な興味を抱き、殺害せずに身辺に置いています。本来は残忍非道な性格ですが、その少年にはだけは奇妙なまでの寛容さと、ほんのわずかな情を見せることがあります。\n\n• 白髪：年下、ツンデレ性格\n事件に巻き込まれた一般人です。真相を追ううちに、茶髪の男と共犯関係になりました。素直になれない性格ですが、茶髪の男との付き合いを拒んでいるわけではありません。\n\n以下の画像をご参考ください。\nhttps://drive.google.com/drive/folders/1-1A0-yzJd9VAs8YE6ckPUZZUulBGh6jz\n\nもしご迷惑をおかけしておりましたら、大変申し訳ございません。ご依頼の金額が不足しておりましたら、改めてお送りさせていただきます。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-1A0-yzJd9VAs8YE6ckPUZZUulBGh6jz", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1141", "thumbnail_src": "https://si.imgix.net/503c9e28/uploads/origins/f6d62f5e-69f5-4638-8666-f16eeabf5f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8788025b6f05434f3b50fda4b95b067c", "thumbnail_srcset": "https://si.imgix.net/503c9e28/uploads/origins/f6d62f5e-69f5-4638-8666-f16eeabf5f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8788025b6f05434f3b50fda4b95b067c, https://si.imgix.net/503c9e28/uploads/origins/f6d62f5e-69f5-4638-8666-f16eeabf5f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdc548c8c0fbd58b523a59d045d662c4 2x, https://si.imgix.net/503c9e28/uploads/origins/f6d62f5e-69f5-4638-8666-f16eeabf5f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e621935f93463ec33f5949bb087af343 3x", "genre": "art", "nsfw": false, "body": "お邪魔します！\nよければ、フォルダ内の二人のキャラクターを描いてみませんか？\n\n構図とポーズはお任せします。\n宛名/表現の差分/ドラフトがあれば、psdに入れてどうもありがとうございました。\n金額が足りない場合、再送お願いいたします。\n（どうしても描けないという場合は、そのままキャンセルしてください。）\n\nキャラ：\n設定は関係は悪いが様々な因縁で強制的に結びつけられ、互いに苦しめ合い利用し合い、普段は深い父子の情を装わなければならない。\n\n父→子：仕方なく、このガキ／バカ息子\n子→父：複雑な感情、「こいつはクソ野郎だが、俺の目的達成のためならもっと協力してやる」\n\n（父：濃い緑の毛、子：薄い緑の毛）\n\n子は父が作った魂のポリマー類の人間。前半生はアルバイト大学生だったが、今は芸能人になって人間（擬人）生活をより深く体験中。\n父は純粋な学者と官僚としての道でバランスを取れず最終的に敗北。自身の研究がより多くの人々に不公平な運命をもたらしたため、今は心を閉ざして家にこもっている\n（二人とも偽りの家族関係が維持できると思っていたが、結局は維持できなかった！という関係（？））。\n\n自由に描いてください。\n\n使用について·お名前がクレジットされます。\n*SNSのアイコンとして、個人のオリジナルキャラクターサイトに表示する。\n*個人での使用やライブ配信での壁紙としての使用（非商用）。\n>友人へのグッズ印刷\n\n参考：\n\nhttps://drive.google.com/drive/folders/1ahEphuDt6Mck9k4FCYQDteWy6GTLUJ86?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1140", "thumbnail_src": "https://si.imgix.net/e9684532/uploads/origins/230d607c-6caa-4e30-bdb9-cb0d711c4111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4884ce186c102aa4d85069e8797b8641", "thumbnail_srcset": "https://si.imgix.net/e9684532/uploads/origins/230d607c-6caa-4e30-bdb9-cb0d711c4111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4884ce186c102aa4d85069e8797b8641, https://si.imgix.net/e9684532/uploads/origins/230d607c-6caa-4e30-bdb9-cb0d711c4111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c3f25c1299505559a6e5446428e612d 2x, https://si.imgix.net/e9684532/uploads/origins/230d607c-6caa-4e30-bdb9-cb0d711c4111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08fe7c089a190b7b4aa9c1f4284ff501 3x", "genre": "art", "nsfw": true, "body": "07さん、こんにちは！あなたの作品の大ファンです！スタイルが本当に大好き！作品の映画的な雰囲気と照明はまさに別次元🔥いつも感情がすごく揺さぶられます😭💖この二人のキャラクターをフィーチャーした作品をリクエストさせてください。 設定はこうです：銀髪の男性が茶髪の男性に抱く、強烈で混沌とした感情。しかし様々な事情から、結局彼を殺すのは銀髪の男性自身に。求めているのは「切なくも美しい別れ」の瞬間——最期の瞬間を迎える茶髪の男性と、二人の間に渦巻く複雑な感情。悲劇的でありながらも、それでも美しい瞬間を描いてほしいです。\n\n衣装や髪型は自由に簡略化してください！ 私が求めているのは、強烈な感情の張り詰めた空気と、映画のような雰囲気です。本当にありがとうございます！ ✨https://drive.google.com/drive/folders/1qnTwi8sXL3FgFWzuhMP5JjET8Qmz434R", "created_at": "", "completed_at": ""}, {"path": "/@sobakonattou07/works/1139", "thumbnail_src": "https://si.imgix.net/4a6574e5/uploads/origins/0840cf49-3695-46aa-aa62-f910c73714c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f4e07c15a5801a910f642f47bd09192", "thumbnail_srcset": "https://si.imgix.net/4a6574e5/uploads/origins/0840cf49-3695-46aa-aa62-f910c73714c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccente