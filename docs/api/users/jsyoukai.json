ix.net/d39dd482/uploads/origins/ff11a903-c1a5-4503-b07c-e9b4e0f0b04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59d86e48e98489d8a418ecfedd64f495 2x, https://si.imgix.net/d39dd482/uploads/origins/ff11a903-c1a5-4503-b07c-e9b4e0f0b04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd204a09552a0b6baf5f2ba91f2fa095 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jsyoukai/works/24", "thumbnail_src": "https://si.imgix.net/036e2e23/uploads/origins/5a8a1763-4c22-4236-8239-270cdb33b143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b46262c2b407a79b95a36467c7123f2f", "thumbnail_srcset": "https://si.imgix.net/036e2e23/uploads/origins/5a8a1763-4c22-4236-8239-270cdb33b143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b46262c2b407a79b95a36467c7123f2f, https://si.imgix.net/036e2e23/uploads/origins/5a8a1763-4c22-4236-8239-270cdb33b143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=918581ec66560054c7b80b660ae8bdbf 2x, https://si.imgix.net/036e2e23/uploads/origins/5a8a1763-4c22-4236-8239-270cdb33b143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86099eefdc3072af3816b4506699a58e 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n今回は原神のドリーのイラスト作成をお願いします。\n\nシチュエーション\n夜のスメールシティで商売をするドリー。妖艶な笑みを浮かべ、昼間は着ていなかったコートをめくると性具がずらり。\n\n備考\n・衣装について、頭部の帽子やグラサンはそのままで、口元はフェイスベールの追加をお願いします。身体はぶかぶかのマイクロビキニで、ズレて乳首が見えている感じでお願いします。\n・子宮部分に淫紋の追加をお願いします。\n・ドリーは他のロリキャラと同様に身体が小さいキャラだと思うので、コート内のディルドなどを少し大きめに描いて頂き、体格差を表現して頂けると嬉しいです。\n・ドリーの知名度及び人気度的に、他の方がこのイラストを拝見した際、なんのキャラだ？と疑問の思われる可能性があります。そのため、お手数ですがイラストの右上辺りに昼間の姿としてデフォルメのイラストを追加して頂き、上記のリクエストイラストにも(夜)と記載して頂けると助かります。", "created_at": "", "complete