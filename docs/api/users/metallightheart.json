d6d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=def2eff700d8790a116a48d1398b6a3b 3x", "genre": "art", "nsfw": false, "body": "あなたの画風がとても気に入っています。オリジナルキャラクターのイラストを描いていただけたら光栄です。彼女は異世界転送事故を生き延びた実験体で、明るく行動的で少しおてんば、悲劇的な要素はありません。自由を尊び、支配されることを嫌い、携帯端末で異世界を移動し、遊び心のあるサメのような歯を見せて笑います。作品は私の個人サイトとTwitterで使用し、クレジットを明記します。 構図は完全に自由にお任せします。お時間をいただきありがとうございます。https://edc5240.wixsite.com/the-one-beyond-the-g https://drive.google.com/drive/folders/1NiAzodxwQIvvMtPmYRiYcRVBjjQi6aFK?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@metallightheart/works/61", "thumbnail_src": "https://si.imgix.net/f2cbc5bb/uploads/origins/7c1de074-29ca-4f5e-be1a-b59eac3b5857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd96ca976cb0791ec82c98c2f9eff851", "thumbnail_srcset": "https://si.imgix.net/f2cbc5bb/uploads/origins/7c1de074-29ca-4f5e-be1a-b59eac3b5857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd96ca976cb0791ec82c98c2f9eff851, https://si.imgix.net/f2cbc5bb/uploads/origins/7c1de074-29ca-4f5e-be1a-b59eac3b5857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80c0085c6aa09d9e1e10b97eaeb1bb0e 2x, https://si.imgix.net/f2cbc5bb/uploads/origins/7c1de074-29ca-4f5e-be1a-b59eac3b5857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98fe8b1010dea80df9b135574c5255db 3x", "genre": "art", "nsfw": false, "body": "私のOC 「Vingt El Prier/ヴィント・エル・プリエ 」のアートをお願いしたい。Vingtはメカのパイロットでフリーの傭兵。彼女はかなり反抗的で、無政府主義的な理想を抱いている。にもかかわらず、彼女は身近な人々をとても大切に思っている。彼女の主な目標は、すべての人を専制政治から解放することだ。\n\nVingtの鼻は『進撃の巨人』のアニーのように平たく長い。Vingtの左目はケガのため永久に細い。Vingtは常に眼鏡をかけている。これらの詳細は変更できない。\n\n構図の詳細はお任せする。私はあなたのスタイルがとても好きだし、かっこよくなると信じている。彼女のメカを描く必要はない。\n\nあなたの作品のダイナミックなアクションがとても気に入っています。宇宙船内や未来のスラム街での戦闘シーンを描いていただけませんか？ヴァンは通常サブマシンガンで戦います。Googleドライブのリンク先サブフォルダに参考資料があります。\n\nもし別のアイデアがあれば、ぜひ驚かせてください。\n\nご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/u/0/folders/1eNGTKmWxtGQ4hEWC8B2PGqoPG07IHS17", "created_at": "", "completed_at": ""}, {"path": "/@metallightheart/works/60", "thumbnail_src": "https://si.imgix.net/8a777c7b/uploads/origins/6a833526-f6de-421d-88b3-047b5e76fa20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f67c5927240ed8c08789bc4eb54e8e", "thumbnail_srcset": "https://si.imgix.net/8a777c7b/uploads/origins/6a833526-f6de-421d-88b3-047b5e76fa20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f67c5927240ed8c08789bc4eb54e8e, https://si.imgix.net/8a777c7b/uploads/origins/6a833526-f6de-421d-88b3-047b5e76fa20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04baf93907821aa242ac3d74b6c49417 2x, https://si.imgix.net/8a777c7b/uploads/origins/6a833526-f6de-421d-88b3-047b5e76fa20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5268cfe1c485fcf9187650f1820fa09f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！以前、あなたのイラストをいくつか拝見し、とても気に入りました。もしよろしければ、私のオリジナルキャラクター（エジプトの巫女をテーマにしたOC）のイラストを依頼してもよろしいでしょうか？\n\nOC(ネフェルタリ): https://drive.google.com/drive/folders/1WWacUI-R6abda71rfNpwi7X1ehpW453F?usp=drive_link彼女はストイックで静かな巫女で、職務を少し過剰に真面目に受け止めるあまり、冷たく感情がないように見えてしまうことがあります。杖を使って古代の呪いをかけます。\n\nお好きなポーズやシチュエーションで描いてください！アクセサリーが多すぎる場合は、一部省略しても構いません。衣装：https://drive.google.com/drive/folders/1Qv1KKRzlgZYuJ1KJGxbXH38B937kNMRd?usp=drive_link ご覧いただきありがとうございます。良い一週間をお過ごしください！", "created_at": "", "completed_at": ""}, {"path": "/@metallightheart/works/59", "thumbnail_src": "https://si.imgix.net/fde6f488/uploads/origins/04676f5d-1a13-463e-88a3-bc2bc4308a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d41c53b015ec435aa96b723cc58c387e", "thumbnail_srcset": "https://si.imgix.net/fde6f488/uploads/origins/04676f5d-1a13-463e-88a3-bc2bc4308a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d41c53b015ec435aa96b723cc58c387e, https://si.imgix.net/fde6f488/uploads/origins/04676f5d-1a13-463e-88a3-bc2bc4308a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5014e2914b948849cea6fbfae0afc660 2x, https://si.imgix.net/fde6f488/uploads/origins/04676f5d-1a13-463e-88a3-bc2bc4308a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2abb4cb8bce7d4c5c891eada462837af 3x", "genre": "art", "nsfw": false, "body": "こんにちは。前回の依頼がとても良かったので、今回もお願いすることにしました。\n\n私の2人のOCのアートをお願いしたいのですが。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi\n\nDIAはMelodyより少し背が高い。DIAは「クールなお姉さん」っぽいのんびり女の子。常時は生意気だけど、いざって時に頼もしいプロになれる。彼女は意識的、行動前に徹底的な計画を立てるのが好きだ。怠惰な自然によると大体火器で戦って、非常しかないで変身能力を使う。趣味は探偵小説とフィルム・ノワールだ。彼女は甘いペストリーとブラックコーヒーが好きだ。ふっくらとした大きな胸と柔らかそうな体。\n\nMelodyはちょっとおてんば娘。とても自信家で、どんな状況にもすぐに適応できる。とても頼りになるが、気が短い。外向的で、人助けが好きな女の子だ。Melodyが使うのは、大きなレンチと剣、そして体力だ。彼女は他の道具や即席の武器も適当に使う。趣味は特撮番組と漫画。辛い食べ物と甘いコーヒーが好きだ。Melodyは控えめな胸とむっちりとした太もも、そしてキュートなお尻を持っている。引き締まった体つきをしている。肌は少し日焼けしている。\n\n廊下での接近戦を見てみたい。このリンクは私がイメージしている雰囲気や敵の参考資料ですが、お好きなように描いてください\nhttps://drive.google.com/drive/folders/15BStMcGi6J8LaWZi9HSvLbRxFzJZdkbc\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@metallightheart/works/58", "thumbnail_src": "https://si.imgix.net/94cca009/uploads/origins/b14b892c-8c4e-4bce-a48a-406feea77019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c22f0ea8146204ab66ec8c8e859d4b80", "thumbnail_srcset": "https://si.imgix.net/94cca009/uploads/origins/b14b892c-8c4e-4bce-a48a-406feea77019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c22f0ea8146204ab66ec8c8e859d4b80, https://si.imgix.net/94cca009/uploads/origins/b14b892c-8c4e-4bce-a48a-406feea77019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ee03e0227e59480b6fbe12e82acec2a 2x, https://si.imgix.net/94cca009/uploads/origins/b14b892c-8c4e-4bce-a48a-406feea77019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a63114583934e45d776f9eeef14df26f 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！僕のtrpgキャラクター、ファウストのイラストを描いてくれませんか？\n舞台はファンタジーで、テクノロジーも取り入れています。ファウストは吸血鬼と人間のハーフで、両方の弱点と長所を併せ持っています。ファウストは血液を操り、武器やアイテム、衣服に変化させる能力を持っていて、通常は銃を作るのに使う。たくさんの銃をね。\n\n注釈\n-ファウストはあらゆる意味でアンドロイドである。\n-銃は火縄銃に近いが、大げさで、スパイクや銃剣のようなものがついている。\n-ファウストのマント、ジャケット、コートは必要に応じて調整できる。\n-ファウストはメガネをかけて目を隠している。\n-日光は吸血鬼を傷つけるので、ファウストは屋内にいるか、夜間に活動する傾向がある。\n\nスタイリッシュでクールなアクションシーンを描いていただけませんか？詳細はあなた次第です。\n\nhttps://drive.google.com/drive/folders/1rLuZCTIJTxf4QbirKE7hu19FanADadOL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@metallightheart/works/57", "thumbnail_src": "https://si.imgix.net/67382934/uploads/origins/d7a7e832-3bdb-4f09-99dc-39c8b56059e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba7890801b05f3aad5e76cdfab0a2fa", "thumbnail_srcset": "https://si.imgix.net/67382934/uploads/origins/d7a7e832-3bdb-4f09-99dc-39c8b56059e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba7890801b05f3aad5e76cdfab0a2fa, https://si.imgix.net/67382934/uploads/origins/d7a7e832-3bdb-4f09-99dc-39c8b56059e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d59cb2c3796814a4e583d0e31cebb88e 2x, https://si.imgix.net/67382934/uploads/origins/d7a7e832-3bdb-4f09-99dc-39c8b56059e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a17f903b91da99acaf4c16b26f12220 3x", "genre": "art", "nsfw": false, "body": "友人の昆虫少女のアクションシーンを描いていただけませんか？ファンタジー風の設定で、彼女は火の魔法の使い手です。彼女はとても背が低くて、1メートル近くあります。\n\n\nhttps://drive.google.com/file/d/1aaoLoCQpmFiK_3IE1fywmBy_DiVqCtqr/view?usp=sharing\n\nマントと鎧を身にまとい、足から火の渦を巻きながら空中に飛び出し、手から火を放つ、こんな感じで描いてください。\n\nhttps://drive.google.com/file/d/1IQDWUbLNmh78iWr3swn083V4hHGv0x6V/view?usp=sharing\n\n背景は、ファンタジーをテーマとしたクールなものであれば、自由です。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1DrFLBsimPj5CRx808dr5cSq8Hd_qsuFz?usp=sharing", "created_at": "",