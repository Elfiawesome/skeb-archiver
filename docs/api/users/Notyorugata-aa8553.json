center&txtsize=30&txt=PRIVATE&s=3fadeed60db3e945a45b8973e638fd5f, https://si.imgix.net/fdf25dc5/uploads/origins/491d5758-b038-4625-b256-0a92fbfe7b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0999eccf8d549e5adc84b46b3a4adc79 2x, https://si.imgix.net/fdf25dc5/uploads/origins/491d5758-b038-4625-b256-0a92fbfe7b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=575269f640baaff85f65075f113eef96 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Notyorugata/works/36", "thumbnail_src": "https://si.imgix.net/21167569/uploads/origins/c5a2ce82-73d5-422b-94e1-930f8ae6e115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29340a895d602956d6bbf178cbd46288", "thumbnail_srcset": "https://si.imgix.net/21167569/uploads/origins/c5a2ce82-73d5-422b-94e1-930f8ae6e115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29340a895d602956d6bbf178cbd46288, https://si.imgix.net/21167569/uploads/origins/c5a2ce82-73d5-422b-94e1-930f8ae6e115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=412de440704266aeeeb14ca1b90d8deb 2x, https://si.imgix.net/21167569/uploads/origins/c5a2ce82-73d5-422b-94e1-930f8ae6e115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=518bd0dae2bbcddf6d303348c87b6509 3x", "genre": "art", "nsfw": false, "body": "よるね様初めまして、IRIAMにて活動中のVライバー 新巻鮭奈と申します！\n\nとても好きな絵柄・塗り方で\nぜひ描いていただきたく\nリクエストしました！\n\nSkebが初めての為、色々と書き逃していたらすみません。\n\n・要望\nお好きなシチュエーション、構図、ポーズ、衣装で描いて頂きたいです！\n\n・参考資料\nhttps://drive.google.com/drive/folders/1D3R3mYntwcb1kxtKTg41wXuC3w6cE79j?usp=share_link\n\n・使用用途\n頂いたイラストはSNSアイコンやIRIAMの返礼品、リアルグッズ(商業的用途)に使用したいと思ってます。\n\n何卒よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1D3R3mYntwcb1kxtKTg41wXuC3w6cE79j?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Notyorugata/works/35", "thumbnail_src": "https://si.imgix.net/9026b990/uploads/origins/7188bc93-7a47-43ae-ade9-c8d67e017000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04a325fd8c2dbbbb9bd573cedfc5fa9", "thumbnail_srcset": "https://si.imgix.net/9026b990/uploads/origins/7188bc93-7a47-43ae-ade9-c8d67e017000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04a325fd8c2dbbbb9bd573cedfc5fa9, https://si.imgix.net/9026b990/uploads/origins/7188bc93-7a47-43ae-ade9-c8d67e017000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c303e8ab11220efa2f64077625300dbe 2x, https://si.imgix.net/9026b990/uploads/origins/7188bc93-7a47-43ae-ade9-c8d67e017000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=877de09ded51c573d61d9f325a51731b 3x", "genre": "art", "nsfw": false, "body": "はじめまして、しおんと申します。\n新着一覧でよるね様のイラストを拝見し是非依頼させていただきたいと思いリクエストを送らせていただきました。\n\nTRPGで使用しているキャラクターをお願いしたいです。\n\n«キャラクター»\n1人目\n・性別：男(吸血鬼)\n・性格：ほわほわしている、間延びして喋る、感情の起伏は少ない(けどよくふにゃっと笑う)\n・身長：178cm\n・キャラクターデザイン：添付資料をご確認ください\n\n2人目\n・性別：女(人間)\n・性格：テキトーに流してる感じで話す。ダウナー系。あんまり元気では無い。\n・身長：165cm\n・キャラクターデザイン：添付資料をご確認ください\n\n«構図»\n夕暮れの空の下で二人並んでコンビニスナックを食べている様子\n男性はしゃがんでいて、女性は手すりとか柵とかにもたれかかっている様子だと嬉しいです。\nその他はおまかせできたらと思います。\n\n«使用用途»\n主には観賞用です。TRPGの同卓者にお渡しさせていただきたいのとSNS上でのアイコン等に使用させていただく可能性もあります。\n\n以上ご確認いただけますと幸いです。 \n金額や内容に不足がありましたら再送いただけますと幸いです。  \n\nお忙しいとは存じますがご検討の程よろしく願いいたします。\n\nhttps://drive.google.com/drive/folders/1PjjSEA0WW912bSaQ6KwKvIso08JCZil2", "created_at": "", "completed_at": ""}, {"path": "/@Notyorugata/works/34", "thumbnail_src": "https://si.imgix.net/5f1515ec/uploads/origins/4719cdfe-1538-4402-b162-b07ce7645149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54fe9909b49c442592bb8c5d67fadcbe", "thumbnail_srcset": "https://si.imgix.net/5f1515ec/uploads/origins/4719cdfe-1538-4402-b162-b07ce7645149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54fe9909b49c442592bb8c5d67fadcbe, https://si.imgix.net/5f1515ec/uploads/origins/4719cdfe-1538-4402-b162-b07ce7645149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95998f0f6a1d39bf90d3869a1130c769 2x, https://si.imgix.net/5f1515ec/uploads/origins/4719cdfe-1538-4402-b162-b07ce7645149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87f4dddfb13e084569b4893e962c0991 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Notyorugata/works/33", "thumbnail_src": "https://si.imgix.net/1e8e86cd/uploads/origins/f0023382-7358-414b-91f4-31c3373359fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8732c9068f08eed7e9b9afd1f4620c79", "thumbnail_srcset": "https://si.imgix.net/1e8e86cd/uploads/origins/f0023382-7358-414b-91f4-31c3373359fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8732c9068f08eed7e9b9afd1f4620c79, https://si.imgix.net/1e8e86cd/uploads/origins/f0023382-7358-414b-91f4-31c3373359fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0b7136ed37bf6c470b2940bf7154d80 2x, https://si.imgix.net/1e8e86cd/uploads/origins/f0023382-7358-414b-91f4-31c3373359fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc7dacdae3ed2add762e870ee16117f7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートは見事でかわいいですね。\n私の猫娘の女帝のアートをお願いしたいのですが、彼女はエレガントで威厳があります。優雅で従順なことで知られていますが、彼女は激しく保護することもできます！\n\nhttps://drive.google.com/file/d/1H5yF8gox0Ti4v-Y24JT2tN0Y9bQ4kF2B/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Notyorugata/works/32", "thumbnail_src": "https://si.imgix.net/087318af/uploads/origins/9c544495-25bb-4975-aca4-5420163fcc02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=561032c2c5b70153e8f0f94f846bb57e", "thumbnail_srcset": "https://si.imgix.net/087318af/uploads/origins/9c544495-25bb-4975-aca4-5420163fcc02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=561032c2c5b70153e8f0f94f846bb57e, https://si.imgix.net/087318af/uploads/origins/9c544495-25bb-4975-aca4-5420163fcc02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=684e8f38581e68669816f27891b47327 2x, https://si.imgix.net/087318af/uploads/origins/9c544495-25bb-4975-aca4-5420163fcc02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60b113894a4ca99bc92c209365cf8a42 3x", "genre": "art", "nsfw": false, "body": "よるね様、はじめまして。この度はアピールをいただきましてありがとうございます。\nうちの子にご興味を持っていただきありがとうございます。\n\nよるね様の作品を拝見しました。いくつかバニーやメイド服を描かれておられて、そのどれもが\n素晴らしい作品でありました。\n\nご覧いただきましたうちの子のバニーメイドもよるね様に描いていただけたらと思い、\nご依頼させていただければと思います。\n\nご提案の通り、「カジノを背景にちょっと挑発的な表情でカードゲームに誘うようなイラスト」で描いていただけますととても嬉しいです。\n\nアピールをいただいてからお時間が経ってしまってのご依頼で恐縮ですが、\nお引き受けいただけますと幸いです。\nどうぞよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Notyorugata/works/31", "thumbnail_src": "https://si.imgix.net/1226a84a/uploads/origins/b2b48202-0ba8-46f8-9e86-998d2424d71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38bb4758b2d2404a5f97446c80477c55", "thumbnail_srcset": "https://si.imgix.net/1226a84a/uploads/origins/b2b48202-0ba8-46f8-9e86-998d2424d71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38bb4758b2d2404a5f97446c80477c55, https://si.imgix.net/1226a84a/uploads/origins/b2b48202-0ba8-46f8-9e86-998d2424d71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5631a24