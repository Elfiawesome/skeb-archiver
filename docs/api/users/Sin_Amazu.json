si.imgix.net/ebe5b258/uploads/origins/3db96e5d-e2c1-4006-afe6-80a7c156efaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e55e436709061d15f8759ce6098d737", "thumbnail_srcset": "https://si.imgix.net/ebe5b258/uploads/origins/3db96e5d-e2c1-4006-afe6-80a7c156efaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e55e436709061d15f8759ce6098d737, https://si.imgix.net/ebe5b258/uploads/origins/3db96e5d-e2c1-4006-afe6-80a7c156efaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e84b89ee4d2f0132b5548e470b3c7f9 2x, https://si.imgix.net/ebe5b258/uploads/origins/3db96e5d-e2c1-4006-afe6-80a7c156efaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e27b19e6268962a849da38af46bb018e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、作家様、はじめまして。\nいつも素敵なイラストをありがとうございます。\n作家様の魅力的な作品に惹かれ、今回依頼させていただきます。\n私のオリジナルキャラクターである高橋夜奈（たかはし よな）のイラストをリクエストさせていただきます。\n\n高橋夜奈（たかはし よな）\nhttps://x.com/yellowfox1234/status/1825525552239067350\n\n高橋夜奈の躍動感あふれるイラストをお願いできれば幸いです。\nご依頼を受けていただければ感謝いたします！", "created_at": "", "completed_at": ""}, {"path": "/@Sin_Amazu/works/88", "thumbnail_src": "https://si.imgix.net/76d8c214/uploads/origins/6982abf0-307a-4076-b651-e676b9a82075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032a951e5b08e5d747687c75b2e623c1", "thumbnail_srcset": "https://si.imgix.net/76d8c214/uploads/origins/6982abf0-307a-4076-b651-e676b9a82075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032a951e5b08e5d747687c75b2e623c1, https://si.imgix.net/76d8c214/uploads/origins/6982abf0-307a-4076-b651-e676b9a82075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3288469daaa30e7c5025b952fd3299c6 2x, https://si.imgix.net/76d8c214/uploads/origins/6982abf0-307a-4076-b651-e676b9a82075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71a9438f4dfdeb2bb1d25e2f7e5cbef5 3x", "genre": "art", "nsf