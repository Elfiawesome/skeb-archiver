f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612bf913f522e3f05d7df3d6f92101ec, https://si.imgix.net/c3f074e0/uploads/origins/17c4e91f-c316-4000-bf27-bb786168df0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3437e89dec4b29b3c346169bfc5d108b 2x, https://si.imgix.net/c3f074e0/uploads/origins/17c4e91f-c316-4000-bf27-bb786168df0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca0f1f6dc663864e70ed88e542d7fe64 3x", "genre": "art", "nsfw": false, "body": "老师您好！初次见面！您的色彩和构图真的太美丽了一眼就被惊艳到了TT，很惊喜您开放了请求，非常喜欢您的作品！！如果有幸希望能够邀请您绘制我的TRPG OC！\n\n【人物设定】·新井典予\n         出身神社世家的民俗学家，对快节奏和冷漠的社会节奏怀有恐惧和厌恶感。高压的教育让他有些厌恶家人和社会。尽管家境优渥，但他决定拒绝继承家业，前去研究神秘学、民俗学和神秘学。他很喜欢观察人类，并由衷希望人类能够向着善良、无私的方向发展，但现代人和社会发展的方向让他有些失望，这打消了他对这个世界的信心。\n         在一次偶然的事件中，他得知了还有幻梦境的存在，显然幻梦境中人类的生活让他梦寐以求，尊重自然，充满着神秘的未解之谜，是人类想象中一切浪漫的具现化。他期待着能够进入这个如同童话一样的世界，决心将自己的一切投身于追寻幻梦境的研究，并着手收集魔导书与AF，希望能够找到通往梦境世界的方法。\n\n当然，一切由老师自由发挥，包括发型服装与构图！希望老师可以自由的创作！\n如果老师可以根据人物设定进行创作的话我会很开心，例如从书里飞出属于幻梦境的动植物！如果金额或是有其他任何的问题，请您发送再送，我会更改！感谢您的耐心阅读和考虑！\n\nhttps://drive.google.com/drive/folders/1hBPzNWMrg3D6p3ptyUu4hLyVjLqVra_p?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@NAZORA/works/3", "thumbnail_src": "https://si.imgix.net/9539492b/uploads/origins/29103153-a1b2-49cd-aaa5-1567bbceeb74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8cb431fc4ca00f861c28a10b2cbea6", "thumbnail_srcset": "https://si.imgix.net/9539492b/uploads/origins/29103153-a1b2-49cd-aaa5-1567bbceeb74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8cb431fc4ca00f861c28a10b2cbea6, https://si.imgix.net/9539492b/uploads/origins/29103153-a1b2-49cd-aaa5-1567bbceeb74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f90580ea4489e611047842040ae3048 2x, https://si.imgix.net/9539492b/uploads/origins/29103153-a1b2-49cd-aaa5-1567bbceeb74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c72cb60a923767a5445a797008ae210 3x", "genre": "art", "nsfw": false, "body": "NAZORA先生、こんにちは！先生の絵がとても好きで、私のOCのペアのイラストをお願いしたいです。もし量が足りなかったら、再送をお願いします＾＾。  \n「ブルボン白いカールのキャラクターは若いヴァンパイアの女の子で、機械工です。赤い目、淡い肌の色、かわいい小さな牙、右足は義足で、おてんば娘と小悪魔のミックスです。\n「アンゴスチュラ」：黒髪のキャラクターはアンデッドの司祭で外科医、黒い目、アイボリーの肌の色、しわがある。親しみやすく温厚そうに見えるが、威圧的で道徳心がまったくない。\n二人は1880年代のアメリカ南部ゴシックの舞台で超自然的な存在を扱うビジネス・パートナーでありエクソシストであり、娘と父親のような非ロマンチックな関係にある。少女は男をおもちゃや食料源として扱い、男は少女を人間ではなく貴重な資産として見ている。  \nリクエストについては、特にありません。このコンセプトで描けるところまで自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1U7uD9l4i3K2XXExYsZpChwFGQBo9tFei?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@NAZORA/works/2", "thumbnail_src": "https://si.imgix.net/3562def5/uploads/origins/b6e70718-9374-44c6-88db-0302fdf42a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df57e1e3acdc4efde4c63e7ab2955910", "thumbnail_srcset": "https://si.imgix.net/3562def5/uploads/origins/b6e70718-9374-44c6-88db-0302fdf42a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df57e1e3acdc4efde4c63e7ab2955910, https://si.imgix.net/3562def5/uploads/origins/b6e70718-9374-44c6-88db-0302fdf42a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc9733c05b1a3516b413de9eab5d2366 2x, https://si.imgix.net/3562def5/uploads/origins/b6e70718-9374-44c6-88db-0302fdf42a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2fb2b33e9a7177e0491eee326133aea 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは！\n先生が描いてるイラストの感じが大好きなので依頼入れることになりました！\n私のOCカップルでお願いしたいです\n\nhttps://drive.google.com/drive/folders/1-CCDPq-ianYwMgN_Aru9zsZXXlqWSsH1\n\n黒髪の少女: 怪談ベースの人外キャラ、瞳孔と眼光がありません。 自分勝手で分からない性格の持ち主\n緑の髪の少女:無愛想で落ち着いた性格の優等生。 黒髪の少女に惹かれます。\n真夏の夜の怪談のような、乾燥してわからない感じの関係です。\n\n構図や表情などお好きなように描いていただければ幸いです！\n衣装も変更をご希望でしたら、ご自由に描いていただいても構いません。\n どうかご検討いただければ幸いです。 今日も良い一日をお過ごしください !\n\nhttps://drive.google.com/drive/folders/1-CCDPq-ianYwMgN_Aru9zsZXXlqWSsH1", "created_at": "", "completed_at": ""}, {"path": "/@NAZORA/works/1", "thumbnail_src": "https://si.imgix.net/75fab5ee/uploads/origins/df718524-d0e4-4cb8-94d6-8690d3209cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b85dfd7c351f3695cacc004c7697620", "thumbnail_srcset": "https://si.imgix.net/75fab5ee/uploads/origins/df718524-d0e4-4cb8-94d6-8690d3209cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b85dfd7c351f3695cacc004c7697620, https://si.imgix.net/75fab5ee/uploads/origins/df718524-d0e4-4cb8-94d6-8690d3209cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44f50c606e794ab702d579b67fae1f3c 2x, https://si.imgix.net/75fab5ee/uploads/origins/df718524-d0e4-4cb8-94d6-8690d3209cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dc53476e948b189e2f740551fa48830 3x", "genre": "art", "nsfw": false, "body": "打扰了，我来尝试投递一下\n想请您绘制这两位，内容请自由发挥！服装可以随意简化和更改。\n\n参考：\n\nhttps://drive.google.com/drive/folders/198CNF21ZcgP6pP4K4nAKtYVIR5bW-FIn", "created_at": "", "completed_at": ""}]}