いです。", "created_at": "", "completed_at": ""}, {"path": "/@yamagama2000/works/23", "thumbnail_src": "https://si.imgix.net/ca0c1969/uploads/origins/227016c2-b862-4a4e-8755-bde52dc5ba52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d27871c628e0207133ce12abafd3917e", "thumbnail_srcset": "https://si.imgix.net/ca0c1969/uploads/origins/227016c2-b862-4a4e-8755-bde52dc5ba52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d27871c628e0207133ce12abafd3917e, https://si.imgix.net/ca0c1969/uploads/origins/227016c2-b862-4a4e-8755-bde52dc5ba52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a98d1634fe9232b5b40616706c6ef38 2x, https://si.imgix.net/ca0c1969/uploads/origins/227016c2-b862-4a4e-8755-bde52dc5ba52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e0272607c863ff82faa6dd396c1da5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yamagama2000/works/22", "thumbnail_src": "https://si.imgix.net/e479e0d1/uploads/origins/c641a343-1450-49c3-8341-8333c922b794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ff42f3dc47b681051b1651cc2e109e1", "thumbnail_srcset": "https://si.imgix.net/e479e0d1/uploads/origins/c641a343-1450-49c3-8341-8333c922b794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ff42f3dc47b681051b1651cc2e109e1, https://si.imgix.net/e479e0d1/uploads/origins/c641a343-1450-49c3-8341-8333c922b794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12022565756ec52351d285c27b0