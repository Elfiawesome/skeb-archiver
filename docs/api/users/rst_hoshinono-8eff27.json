4e53d49f968 2x, https://si.imgix.net/d3896d86/requests/238004_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a9931f8ca7b1ee984478021d2c00d54 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@rst_hoshinono/works/7", "thumbnail_src": "https://si.imgix.net/4889d7bb/requests/235914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77ac6fa415c635e911fcfe907021d3f", "thumbnail_srcset": "https://si.imgix.net/4889d7bb/requests/235914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77ac6fa415c635e911fcfe907021d3f, https://si.imgix.net/4889d7bb/requests/235914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d1abead46fdb4472b9200b0ab8beb15 2x, https://si.imgix.net/4889d7bb/requests/235914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d604d6bb68a3a1c9b38760530f683a5 3x", "genre": "art", "nsfw": false, "body": "☆さん、はじめまして！\nアピールしてありがとうございました！\n\nもしよかったら、クロスオーバー絵を描いてお願いしたいんです。\n\n「小女ラムネ」の「足立甜花」と「プリズマ☆イリヤ」の「イリヤ」がラブラブなセッティングでキスしている！\n\n他の詳細をお任せします。\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@rst_hoshinono/works/6", "thumbnail_src": "https://si.imgix.net/51b834d3/requests/235276_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e270b1d74d713701c1f80ece0f836326", "thumbnail_srcset": "https://si.imgix.net/51b834d3/requests/235276_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e270b1d74d713701c1f80ece0f836326, https://si.imgix.net/51b834d3/requests/235276_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34b1b350a785fba7e9b92f896319ed4c 2x, https://si.imgix.net/51b834d3/requests/235276_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b60588603c34631ad9300c08ea43d886 3x", "genre": "art", "nsfw": false, "body": "im@sの久川颯。\nはーちゃんの胸がまた大きくなりました。\nシャツは限界です。ボタンが危険な音を出している。爆発が差し迫っています。\nハちゃんは困惑した顔をしています。誰かが問題を指摘しているようですが、はーちゃんは気づいていません。\n胸を好きなだけ大きく描きます。\nありがとございます。", "created_at": "", "completed_at": ""}, {"path": "/@rst_hoshinono/works/5", "thumbnail_src": "https://si.imgix.net/4110ae0c/requests/225361_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa8d47e30e446d20f24519790fe408f", "thumbnail_srcset": "https://si.imgix.net/4110ae0c/requests/225361_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa8d47e30e446d20f24519790fe408f, https://si.imgix.net/4110ae0c/requests/225361_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0340eb7033efb7c11013e2cf44ab9c0 2x, https://si.imgix.net/4110ae0c/requests/225361_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06258e95491f32f75c0b68c192ba99a6 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。toberaと申します。\n「私に天使が舞い降りた！」より「種村小依」と「小之森夏音」をお願い致します。\n構図はチョコレート越しのキス\nポッキーゲームをもっと小さいチョコでやっているイメージです。\nチョコレートの形はお任せします。(♥、■、●など描きやすいもので)\n\n時期のイメージはバレンタイン。\n服装はコートにマフラーで手袋は無し、下の服は制服想定です。小依はトレンチコート、夏音はパステル調のダウンをイメージしていますが自由に変更して(あるいは外しても)大丈夫です。マフラーは個別でも二人マフラーでも。\n場所は冬の公園ですが背景は飛ばしてしまっても構いません。\n二人だけの世界を鮮烈に彩るような先生の逆光の使い方が好きなので後ろから光を当てて頂けたら嬉しいです。\n先生の感性を全面的に信頼していますので上記の指示に限らず”こう描きたい”を最優先にしてください。\n字数が余ったのでなんとなくのシチュエーションを文にしてみました。\n\nとりあえず座れるところ、と二人がたどり着いたのは小さな公園だった。\n「顔が赤いのは風邪とかじゃなくて、その、よりちゃんにわたしのチョコ食べて欲しくて」\n「もちろん食べるわよ、毎年そうしてるじゃない！　でもね、かの。たとえ風邪じゃなくたって体が冷えるのはよくないわ一度帰りましょう」\n腰を浮かせた小依はしかしその場から動けない。\n\n「待って！」\nコートの裾は夏音によって引き留められていた。\n「そうじゃない、そうじゃないの」\nいつになく熱っぽい瞳を向けられて、思わず小依は平衡感覚を失いそうになる。\n視線が、そらせない。\n「あのね、よりちゃん」\nそう言うと夏音は鞄から見覚えのある袋を取り出し、中のチョコレートを一粒つまんだ。昨日一緒に作ったものだ、小依の鞄にも同じものが入っている。\nそのまま夏音は口に運び――\n\nんっ\n\n溶かすことなく器用についばんだ。唇の先のチョコレートは小依に向かって突き出されている。\n\n目は口ほどにものを言うらしい。その意味を小依はよく理解した。\n決して寒さのせいではないだろう、いじらしくも小刻みに震える夏音にたまらなく愛おしさがこみ上げてくる。\n「かの」\n優しい吐息は右耳をくすぐり、やわらかな髪を撫でる。\n小依がそっと抱き寄せた瞬間、世界にはただ二人だけが存在していた。\nそして――\n――ハッピーバレンタイン", "created_at": "", "completed_at": ""}, {"path": "/@rst_hoshinono/works/4", "thumbnail_src": "https://si.imgix.net/b2c744d0/requests/223917_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb254f33963cd79a3ddefb5f0ebc8dfd", "thumbnail_srcset": "https://si.imgix.net/b2c744d0/requests/223917_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb254f33963cd79a3ddefb5f0ebc8dfd, https://si.imgix.net/b2c744d0/requests/223917_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ea3e1b37d1d7998164f7eda65684162 2x, https://si.imgix.net/b2c744d0/requests/223917_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dffd98c1b7b226fe8eb4a01404f7d32 3x", "genre": "art", "nsfw": true, "body": "前回いただいたイラストがとても良かったので、また依頼させていただきます\n\n白猫プロジェクトのティナ(6周年バージョン)が、無理矢理両穴を指で責められて悶絶してるイラストをお願いします\n\n・着衣\n\n・責められているところと、ティナの表情を大まかに2コマに分けた構図\n\n・1コマ目は下記URLの参考画像のように、足を広げられ両穴を指で責められているところのアップで\nhttps://twitter.com/xdh3knifepbwtpl/status/1353263398381731840?s=21\n・両穴にちょっとゴツめの指を挿れられているのがよく見えるように\n・スカートのひらひら具合がわかるように\n・左ふととものリングが見えるように\n・太ももをムチムチにしすぎないようにお願いします\n・激しく指を出し入れされて愛液が飛び散っている\n\n・2コマ目は下記URLの参考画像のような構図で、絶頂してのけぞっているところをお願いします\nhttps://twitter.com/xdh3knifepbwtpl/status/1353264346235760640?s=21\n・表情は参考画像に順守、仰け反って上を見上げて舌を突き出している\n・胸は盛らないようにお願いします\n・うなじが見えていると良いです\n・可愛い絵柄そのままでお願いします\n\n\n・陰毛NG\n・破瓜表現NG\n・責め手の描写は手だけ(むしろ長めの指だけ)で大丈夫です\n\n\n\n以下は可能なら差分で入れて欲しいもの\n・1コマ目に「じゅぷじゅぷ」と言った擬音\n・2コマ目に「ビクビクン！」と言った擬音\n・「あっあああ！」「いやぁぁぁ！！」と言ったティナの台詞\n・飛び散る愛液とは別の潮吹き表現\n\n以上です、よろしくお願いします\n\nhttps://twitter.com/xdh3knifepbwtpl/status/1353299720844677121?s=21", "created_at": "", "completed_at": ""}, {"path": "/@rst_hoshinono/works/3", "thumbnail_src": "https://si.imgix.net/fcdbc0f9/requests/215291_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83743995d73c5087dbfffbd73332e9fd", "thumbnail_srcset": "https://si.imgix.net/fcdbc0f9/requests/215291_