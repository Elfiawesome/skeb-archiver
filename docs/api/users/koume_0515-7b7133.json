59d-b5bd-464e13acbd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=664c6e6640440ec730d01221f5686edd", "thumbnail_srcset": "https://si.imgix.net/2de6a06a/uploads/origins/1aca02b6-c7e2-459d-b5bd-464e13acbd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=664c6e6640440ec730d01221f5686edd, https://si.imgix.net/2de6a06a/uploads/origins/1aca02b6-c7e2-459d-b5bd-464e13acbd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=352aad5126f0801ad0465186ad9ac9bf 2x, https://si.imgix.net/2de6a06a/uploads/origins/1aca02b6-c7e2-459d-b5bd-464e13acbd5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35ddca7b5e17e4139ba3ee9a7d93edf8 3x", "genre": "art", "nsfw": false, "body": "小梅さん、こんにちはネネはドラゴンエイジというゲームシリーズをやっている。彼女が好きなキャラクターにモリガンというのがいる。モリガンは大自然の中で育ったお嬢様なので、服装も自然をテーマにしていて、革のつなぎやゆったりとした布、羽のような動物のパーツを身につけています。モリガンはまた、金のネックレス、真珠、指輪、胸飾りなど、きれいな宝石も好む。モリガンは魔法を使って戦う。\n\nモリガンにインスパイアされた衣装を着たプロダクション・カワイイの天野寧々を描いていただけませんか？モリガンの参考アートはこちら：\nhttps://photos.app.goo.gl/L4ALQUw2xn6R9vNFA\n\nスパイシーな衣装でOKです！ポーズもかわいいと思うものでいいです。YouTubeのサムネイル用にネネに渡せるようにしたいです。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@koume_0515/works/104", "thumbnail_src": "https://si.imgix.net/9d8d6d3b/uploads/origins/b2294327-e0a9-453f-90fa-ece89fde777b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c17d4bfcc465d4d7a544dc2838f48642", "thumbnail_srcset": "https://si.imgix.net/9d8d6d3b/uploads/origins/b2294327-e0a9-453f-90fa-ece89fde777b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c17d4bfcc465d4d7a544dc2838f48642, https://si.imgix.net/9d8d6d3b/uploads/origins/b2294327-e0a9-453f-90fa-ece89fde777b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af5a29fada5b2768c8fe7e38acd30125 2x, https://si.imgix.net/9d8d6d3b/uploads/origins/b2294327-e0a9-453f-90fa-ece89fde777b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=to