ins/1fc4783a-48b5-4cbd-b54a-79f2c39c8ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f62a843a5a8d37b43b096b3b638f60", "thumbnail_srcset": "https://si.imgix.net/5ec47a46/uploads/origins/1fc4783a-48b5-4cbd-b54a-79f2c39c8ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f62a843a5a8d37b43b096b3b638f60, https://si.imgix.net/5ec47a46/uploads/origins/1fc4783a-48b5-4cbd-b54a-79f2c39c8ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e891ac1a105412912edab25015cd25f 2x, https://si.imgix.net/5ec47a46/uploads/origins/1fc4783a-48b5-4cbd-b54a-79f2c39c8ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eaaddfac8a84dab7db896aee9a350a12 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nネコパラのヴァニラの衣装を着たシャーロット・スズの全身アートをお願いしたいです。ポーズとしては、まるであなたに会えて嬉しそうな、はしゃいだような表情でこちらに向かって歩いてくるようなポーズをお願いします。舞台は雲ひとつない晴れた日の遊園地です。\n\n背景、ヘッドバンド、チョーカーネックレスは別レイヤーでお願いします。\n\nまた、このアートをCharlotteのTwitterのスケジュールやYoutubeのサムネイルに使わせていただきたいです。これがダメな場合は、依頼を受けないでください。\n\nお忙しい中、ご対応いただきありがとうございました。\n\n余談ですが、プロダクションのカワイイ女の子たちのために作ってくださったアートはどれも本当に大好きです。彼女たちを応援してくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1OZK12mVjvDWVQ6lVkCAATcE1fxZ4Wczr?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@koume_0515/works/101", "thumbnail_src": "https://si.imgix.net/5e7641b6/uploads/origins/5a431b41-8eb0-47ac-a842-a0276b6660f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc6214bc7621e8eadfa286c4bed1fe0", "thumbnail_srcset": "https://si.imgix.net/5e7641b6/uploads/origins/5a431b41-8eb0-47ac-a842-a0276b6660f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc6214bc7621e8eadfa286c4bed1fe0, https://si.imgix.net/5e7641b6/uploads/origins/5a431b41-8eb0-47ac-a842-a0276b6660f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4831d09c39fa1d2eeb6fb76ef5a7daac 2x, https://si.imgix.net/5e7641b6/uploads/origins/5a431b41-8eb0-47ac-a842-a0276b6660f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05446578c6a155a919190503c78d5a1c 3x", "genre": "art", "nsfw": false, "body": "小梅先生、はじめまして。プロダクションカワイイ最新世代のVtuberです。先生がこれまで弊社で描いてくださったイラストをとても尊敬しています。 \n\nVTuberの「魔女っ子めいみ」です。めいみは修行中の魔女です。大きな帽子をかぶると167cmですが、かぶっていないともっと低いです(~151cm)。明るくて、生意気で、やんちゃだけど、ちょっとツンデレ。水晶玉、タロットカード、アイドルが好き。\n\nファンの方からこのポーズでリクエストされたのですが、ちょっと恥ずかしいです。\nリクエストは、ベッドの真ん中で横になっている芽実ちゃんのめいみ。ルームウェアを着ているのですが、帽子で隠しているので露出は少ないです。慌てたような、恥ずかしそうな表情で上を見上げています。\nhttps://www.pixiv.net/en/artworks/117355014\n\nサムネイルなどにも使用させていただきたく、よろしければ頭頂部や髪の毛先・上半身などは先が切れないよう描いて頂けますと嬉しいです。\nキャラクターのみ透過でも利用できるよう、psd形式、もしくは透過PNGでキャラクターだけのものも頂けますと幸いです。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1zIp0LugO18GN3KN5U0lBCHHZp0SvEx_O?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@koume_0515/works/100", "thumbnail_src": "https://si.imgix.net/086f9bfc/uploads/origins/892f4c3c-d29d-4b2f-aaf8-8d74a41cd13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dadd9c303f6cab304e97685ed7ad03b3", "thumbnail_srcset": "https://si.imgix.net/086f9bfc/uploads/origins/892f4c3c-d29d-4b2f-aaf8-8d74a41cd13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dadd9c303f6cab304e97685ed7ad03b3, https://si.imgix.net/086f9bfc/uploads/origins/892f4c3c-d29d-4b2f-aaf8-8d74a41cd13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12c0aaabb5e12c4e1cf91f0859f09ae7 2x, https://si.imgix.net/086f9bfc/uploads/origins/892f4c3c-d29d-4b2f-aaf8-8d74a41cd13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe45ea9b97270245afe7a2f757db88ca 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アイラ・コールマンがクローマシンを操作しているクレーンゲーム機に摘まれるシャーロット・すずを描いてください。おそらくYouTubeのサムネイルかライブ配信のスケジュール配信グラフィックに使われると思いますので、ご了承の上お受け取りください。\n\nいつも作品をありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@koume_0515/works/99", "thumbnail_src": "https://si.imgix.net/977b0172/uploads/origins/4617bacf-f5f3-4f0c-bf5e-b52d84b3190d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6790da9adaabeac24bc8c2bdab7eb951", "thumbnail_srcset": "https://si.imgix.net/977b0172/uploads/origins/4617bacf-f5f3-4f0c-bf5e-b52d84b3190d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6790da9adaabeac24bc8c2bdab7eb951, https://si.imgix.net/977b0172/uploads/origins/4617bacf-f5f3-4f0c-bf5e-b52d84b3190d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03c312b469e07d089fa3378ea20149a 2x, https://si.imgix.net/977b0172/uploads/origins/4617bacf-f5f3-4f0c-bf5e-b52d84b3190d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca175599f70909dbe5f223aa4daf2995 3x", "genre": "art", "nsfw": false, "body": "こんにちは、小梅さん、\n\n本海スターレールのキャラクター、ホタルの服を着たルアのアートをお願いしたいです。ホタルはメカ変身をするので、ルアに変身ギアを持たせて変身ポーズをしてほしいです。もし採用されたら、ルアにあなたのアートをツイートしてリツイートしてもらい、Youtubeのサムネイルに使いたいと思います。\n\nよろしくお願いします！\n\nホタル\nhttps://imgur.com/a/qpuUbvK\nhttps://imgur.com/a/uV0TMDf", "created_at": "", "completed_at": ""}, {"path": "/@koume_0515/works/98", "thumbnail_src": "https://si.imgix.net/10e08f15/uploads/origins/fb210317-73d0-434c-9f06-a337a5a0b69a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d11ca35e8898711b77555bf4a5bb595", "thumbnail_srcset": "https://si.imgix.net/10e08f15/uploads/origins/fb210317-73d0-434c-9f06-a337a5a0b69a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d11ca35e8898711b77555bf4a5bb595, https://si.imgix.net/10e08f15/uploads/origins/fb210317-73d0-434c-9f06-a337a5a0b69a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b4e0a47b13ac2a4a2c923ef6c85e2d6 2x, https://si.imgix.net/10e08f15/uploads/origins/fb210317-73d0-434c-9f06-a337a5a0b69a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52fbd893ad27ffe06332ea1e36b921ca 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回のリ