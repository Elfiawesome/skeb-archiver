8e5-b35772ab5405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9f596211a5a1ea78274ca94026ff606 2x, https://si.imgix.net/7955afef/uploads/origins/9629d191-788b-4e4b-88e5-b35772ab5405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1527da5ce14dc2d9fc59efb20865db6a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品を見て、私のキャラクターを描いていただけないかと思いまして。キャラクター：半竜のギルド受付嬢で、初めてコスプレに挑戦しています。衣装：『マブラヴ オルタネイティヴ』シリーズのガード補強装備。九九式ガード補強装備を装着。スーツの輝きを強調したいです。\nポーズ・表情：顔を真っ赤にして、視聴者から目をそらしている様子でお願いします。可能であれば片腕を背中に回した姿勢にしたいです。背景：お任せします。以上です。\nご不便をおかけしますが、何卒よろしくお願いいたします。キャラクター：https://drive.google.com/drive/folders/1XecD2C-9XjYGj1anycoQYwVIDaziEpX5?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Nandarobium/works/39", "thumbnail_src": "https://si.imgix.net/59d89e9a/uploads/origins/24736dfe-fb35-431e-86b2-53a3c47f888f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81d4efb8e7c5f4f7c6c67ed64ce3d754", "thumbnail_srcset": "https://si.imgix.net/59d89e9a/uploads/origins/24736dfe-fb35-431e-86b2-53a3c47f888f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81d4efb8e7c5f4f7c6c67ed64ce3d754, https://si.imgix.net/59d89e9a/uploads/origins/24736dfe-fb35-431e-86b2-53a3c47f888f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3b5353c9195cbf5f7becc2d0d21f1fb 2x, https://si.imgix.net/59d89e9a/uploads/origins/24736dfe-fb35-431e-86b2-53a3c47f888f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6b82c0e118f8cb1d0bf79577561739e 3x", "genre": "art", "nsfw": true, "body": "初めまして！\nナンダロビウム先生のメカと女の子の掛け合わせたイラストが魅力的で依頼させていただきたく思います。\n\n今回はFF14で使用している自キャラのアウラにロボを武装していただきたくお願いいたします。\n参考資料\nhttps://drive.google.com/drive/folders/1j05jblmGq2WOjO1R_-tOjEtzyUrNybom?usp=drive_link\n・この子はクールなお姉さんキャラになります\n・目元はキリリとかっこよくお願いしたいです。\n・眼の色は赤色に金色の輪郭が入っております。\n\n\n今回掛け合わせていただきたいのはスーパーロボット大戦OGのアルトアイゼン・リーゼになります。\nhttps://hobby.dengeki.com/news/275563\n\n自キャラの衣装については、ハイレグとビキニアーマーを合わせた感じでお願いいたします。色合いは赤と黒にてお願いいたします。\n武装についてのモチーフについてはお任せいたしますが、バンカーだけは何卒お願いいたします。\n自由に描いていただけるようにNSFWはonにいたします。\n\nご検討の程、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Nandarobium/works/38", "thumbnail_src": "https://si.imgix.net/01f2ba63/uploads/origins/e05871ce-5214-4620-9002-4c581f6f36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c32ce61c02c556bc697111a3059079", "thumbnail_srcset": "https://si.imgix.net/01f2ba63/uploads/origins/e05871ce-5214-4620-9002-4c581f6f36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c32ce61c02c556bc697111a3059079, https://si.imgix.net/01f2ba63/uploads/origins/e05871ce-5214-4620-9002-4c581f6f36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e5ab741c7cb6b5ea21399335c356e3c 2x, https://si.imgix.net/01f2ba63/uploads/origins/e05871ce-5214-4620-9002-4c581f6f36ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c8df1fc9d8457ec831f980eb11f7bd0 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nもう一度リクエストさせていただきます。\n\n以前ココナラで描いて頂きましたメカアレンジのソニアの資料図をお願い致します。\n図としては前回のリクエストと同じようなイメージでお願いします。\n詳細はお任せ致します。\n\n以上、よろしくお願い致します。\n\nhttps://x.com/Nandarobium/status/1895754987504115956\n\nhttps://skeb.jp/@Nandarobium/works/36", "created_at": "", "completed_at": ""}, {"path": "/@Nandarobium/works/37", "thumbnail_src": "https://si.imgix.net/0815ed8d/uploads/origins/206f5aa2-9016-4aa4-9a60-ddbdef7bfbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92872839ad8a15e802281923da6b8b3d", "thumbnail_srcset": "https://si.imgix.net/0815ed8d/uploads/origins/206f5aa2-9016-4aa4-9a60-ddbdef7bfbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92872839ad8a15e802281923da6b8b3d, https://si.imgix.net/0815ed8d/uploads/origins/206f5aa2-9016-4aa4-9a60-ddbdef7bfbef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200