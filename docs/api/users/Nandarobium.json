d5-4698-a332-4afddb6fd199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b566c25cc639e6775ef1fdd138ad04", "thumbnail_srcset": "https://si.imgix.net/1c9f77f3/uploads/origins/be82d208-45d5-4698-a332-4afddb6fd199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b566c25cc639e6775ef1fdd138ad04, https://si.imgix.net/1c9f77f3/uploads/origins/be82d208-45d5-4698-a332-4afddb6fd199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b247da0cb82b54d5f672cf9b11c8f889 2x, https://si.imgix.net/1c9f77f3/uploads/origins/be82d208-45d5-4698-a332-4afddb6fd199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aea552e05877f3c9040df76975879d55 3x", "genre": "art", "nsfw": false, "body": "私が作成したメガミデバイスのF-14A/カミラ=プラウズを描いて頂きたいです。\nキャラクター詳細は、下記URLになります。\nhttps://x.com/igunaiter4423/status/1520355271847329794\n\n構図は、下記URLのような感じでお願いします。\nhttps://x.com/igunaiter4423/status/1829942185040756811\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Nandarobium/works/26", "thumbnail_src": "https://si.imgix.net/036ce9a2/uploads/origins/27e77072-c576-4737-8d52-70cd3d1a6ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed81b281ce12770cb77ed7671c58bdff", "thumbnail_srcset": "https://si.imgix.net/036ce9a2/uploads/origins/27e77072-c576-4737-8d52-70cd3d1a6ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed81b281ce12770cb77ed7671c58bdff, https://si.imgix.net/036ce9a2/uploads/origins/27e77072-c576-4737-8d52-70cd3d1a6ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c91390adb2594a698331099baae78a46 2x, https://si.imgix.net/036ce9a2/uploads/origins/27e77072-c576-4737-8d52-70cd3d1a6ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d8ea5186f75752878d1cb6a26123fa7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nリクエスト投げさせていただきます。\n\n[リクエスト内容]\nPSO2の登場キャラクター、「リュドミラ」の白衣inビギニのイラスト。\n\n[衣装]\n白衣はキャラクターが着てるアウターでお願いします。\nビキニはリュドミラが着てるベースウェアから切り抜いたようなデザインでお願いしたいです。(資料参考。)\n胸のクリアパーツは無しでお願いします。谷間が見たいので...!!\nアクセサリーの眼鏡は付けてください。首にかけてるヘッドホンは無しでお願いします。\n\n[構図、シチュエーション、表情]\n正面から見た構図でお願いします。軽く胸を張り両手を腰に当て、股を少し開いた感じです。決めポーズではなく、自然体で立っている感じです。\n<https://www.pixiv.net/artworks/97696889>←これの1枚目の様な感じでお願いします。(このイラストでは左に重心が寄ってますが、今回はずらさず、なるべく中心でお願いします。)\n元の衣装が着崩れてるデザインではありますが、多少隠れてしまっても構わないので袖から手は出して欲しいです。技術者のお手々からしか得られない栄養があるので...!!\n\nシチュエーションとしては、A.I.S.の危険な実験に100回付き合ったら何でも言う事聞いてあげると言われて真剣に実験に取り組んだ結果、白衣inビキニをお願いした感じです。リュドミラ側の好感度は49.5%くらいで顔見知りで信頼もあるけど仕事以上の関係性はないといった感じです。\n\nなので、表情は困惑してる顔でお願いします。冷めてるわけでもなく、デレてるわけでもなく、純粋に困惑してる感じです。えぇ...？これで良いの...？といったような。(見られてる事はあんまり気にしてない感じ。)最終的なさじ加減はお任せします。\n\n[背景]\n背景はこちらの作品<https://skeb.jp/@Nandarobium/works/18>の様な感じで軽く塗っていただけると幸いです。\n\n[その他要望、差分]\nやっぱり見られるのは恥ずかしかったIfシチュエーションとして照れてる表情差分をお願いしたいです。目線を外して頬を赤く染めてる顔でお願いします。\nまた、可能なら膝から上まで描いて頂きたいです。\n料金とご相談ください。\n\n要望が多くなりましたが、描きやすい範囲で構いません。良ければよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1qCFxkyotQMbmBLawNq50Vpa7Pk-YMo_H?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Nandarobium/works/25", "thumbnail_src": "https://si.imgix.net/5b8782a0/uploads/origins/ed3a0398-c342-49ae-a381-084e4c1c5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd3fd045c54611e2e63afe1401b3e6f", "thumbnail_srcset": "https://si.imgix.net/5b8782a0/uploads/origins/ed3a0398-c342-49ae-a381-084e4c1c5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd3fd045c54611e2e63afe1401b3e6f, https://si.imgix.net/5b8782a0/uploads/origins/ed3a0398-c342-49ae-a381-084e4c1c5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=117303c5fe5be92942ccdec558021bd2 2x, https://si.imgix.net/5b8782a0/uploads/origins/ed3a0398-c342-49ae-a381-084e4c1c5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47ea1045ebf26aaa7c31bbe2b6748831 3x", "genre": "art", "nsfw": true, "body": "お世話になっております、月影楼と申します。\n前回は素敵な作品をありがとうございました\n今回はうちの子狐のお姉さん「翠燐」をリク致します。\n\nキャラデザインは参考資料の通りです。\n資料で不明な点や分かりづらい点は先生の描きやすいように調整・アレンジして頂いて大丈夫です。\n\n衣装はXの固定ツイのような、先生が得意とされているビキニ+メカ装備でお願いいたします。\n衣装部分は大胆なビキニ+半透明の前垂れ＆スリットなドレスで、いわゆるシースルーチャイナドレス風のサイバー衣装でお願いします\nメカ部分はおまかせしますが、メイン装備は偃月刀or戟（げき）のような長物武器でお願いいたします\nその他部分の武装や装飾はすべてお任せ致します。\n\n表情やポーズ、いわゆる盛り具合や肉付きもお任せ致します。\n自由に描いて頂けますようにNFSWはonにしておりますがセンシティブ度はお任せします。\n\n宛名につきましてはPSDレイヤーでon/off出来ると嬉しいです。\nよろしくご検討お願い致します。\n\n\nキャラクター資料（立ち絵・３面図・注意事項含む\nURL：https://twitter.com/Tukikagerou/status/1586588803682119680\n※上記ツイのツリーに資料記載\n（耳と双尾先端の緑色のワンポイントは見落としやすいのでご注意ください）\n\n\nキャラ資料（予備URL）：https://min.togetter.com/VrQdsKr\nこれまでの納品一覧　 ：https://min.togetter.com/Gyo3MrY\nVRCスクショ（VRChatアバター）：https://min.togetter.com/pC5ggJd", "created_at": "", "completed_at": ""}, {"path": "/@Nandarobium/works/24", "thumbnail_src": "https://si.imgix.net/d63b63a4/uploads/origins/9aed8e7c-9dae-4f33-b32e-4f599820aad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6cecc99c600e575a365d2ee6755c88d", "thumbnail_srcset": "https://si.imgix.net/d63b63a4/uploads/origins/9aed8e7c-9dae-4f33-b32e-4f599820aad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6cecc99c600e575a365d2ee6755c88d, https://si.imgix.net/d63b63a4/uploads/origins/9aed8e7c-9dae-4f33-b32e-4f599820aad8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d10790652bc9ea661b7e67be1dac23b 2x, https://si.imgix.net/d63b63a4/uploads/origins/9aed8e7c-9dae-4f33-b32e-4f599820aad8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8608b519927908ff8fd17b50fc480a7a 3