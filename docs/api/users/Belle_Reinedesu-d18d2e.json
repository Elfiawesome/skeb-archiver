00&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6fb079f9ed1da7481e8d90c5fd70009 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/12", "thumbnail_src": "https://si.imgix.net/687e1a86/uploads/origins/478db299-88e5-44cf-b13a-999669a7575f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98046aa9d3717fe61abb9482af78eb48", "thumbnail_srcset": "https://si.imgix.net/687e1a86/uploads/origins/478db299-88e5-44cf-b13a-999669a7575f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98046aa9d3717fe61abb9482af78eb48, https://si.imgix.net/687e1a86/uploads/origins/478db299-88e5-44cf-b13a-999669a7575f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e947215dbb6e7af95f88e0d79443ca37 2x, https://si.imgix.net/687e1a86/uploads/origins/478db299-88e5-44cf-b13a-999669a7575f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b46ba9b1df5c3ab4495b5d673c9c11c2 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n以前Xの方でK.E.R.Oさんのシーザリオのイラストを拝見して以降ファンの者です。\n早速ですが今回ウマ娘のブエナビスタのイラストを描いていただきたくリクエストさせてもらいました！\n服装は勝負服で、K.E.R.Oさんの思う可愛いブエナビスタが見てみたいと思っているので構図や背景の指定はこちらからはありません！（逆に描き辛かったりしたらすみません💦）\n用途はSNS（X、Discord、Youtube）での使用になります（X、DiscordのプロフィールにはK.E.R.Oさんの名前を記載する予定です）\nハンドルネームがそのまま羊の絵文字なのでクライアント名も絵文字で描いていただけると嬉しいです💦\n\nもし都合よければお受けしていただけると幸いです。\n\nPS:私も天井までブエナビスタ出なかった人は仲間だと思っています笑", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/11", "thumbnail_src": "https://si.imgix.net/d9e0f80a/uploads/origins/384dde9b-b7a9-4e44-85e5-0b4ab20a2664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e236c958f10c6649acdbe735293fffb4", "thumbnail_srcset": "https://si.imgix.net/d9e0f80a/uploads/origins/384dde9b-b7a9-4e44-85e5-0b4ab20a2664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e236c958f10c6649acdbe735293fffb4, https://si.imgix.net/d9e0f80a/uploads/origins/384dde9b-b7a9-4e44-85e5-0b4ab20a2664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=341278152184ab76e108370118457369 2x, https://si.imgix.net/d9e0f80a/uploads/origins/384dde9b-b7a9-4e44-85e5-0b4ab20a2664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c62f6b8ed054598f946589bb2723300 3x", "genre": "art", "nsfw": true, "body": "先日は素晴らしいイラストをありがとうございました！また、ご依頼したく思います。\n\n今回ご依頼したいのは以下のとおり\n\n・キャラはウマ娘のメジロラモーヌ\n・衣装は下はドルフィンパ◯ツ、上や他の細かいところはおまかせします。\n・ポーズ、背景等はおまかせします。\n・表情は流し目で見る風にお願いします。\n・カラーでお願いしたいです！\n\n以上になります。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/10", "thumbnail_src": "https://si.imgix.net/853f2345/uploads/origins/660db57d-2a28-489d-a1db-4e04b3675212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5dfcb2c628b7817a0928508003c0968", "thumbnail_srcset": "https://si.imgix.net/853f2345/uploads/origins/660db57d-2a28-489d-a1db-4e04b3675212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5dfcb2c628b7817a0928508003c0968, https://si.imgix.net/853f2345/uploads/origins/660db57d-2a28-489d-a1db-4e04b3675212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fabdef9e68c96963d72d2445a4882329 2x, https://si.imgix.net/853f2345/uploads/origins/660db57d-2a28-489d-a1db-4e04b3675212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af937b8496f55dae4456e18884d3ce05 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nK.E.R.Oさんがツイッターに投稿されているウマ娘のキャラクターとスーパーGTをクロスオーバーさせたイラストを楽しみに見させて頂いております。\nどのキャラクターも可愛らしくて好きなのですがK.E.R.Oさんのマルゼンスキーさんをもっと見たいと思ったのでリクエストさせて頂きました。\n\n[依頼内容です]\n・キャラクターはウマ娘のマルゼンスキー\n\n・髪はゲーム内で通常衣装にした時のポニテにしていない後髪を下ろしてる状態\n　\n・衣装は過去にK.E.R.Oさんが投稿されていたカレンチャンやフラッシュに着せていたARTAのもの(K.E.R.Oさん的にARTAよりこっちのが似合いそうってのがあればそちらでも大丈夫です)\n\n・ポーズ、背景はお任せします。\n\n・お胸はめいいっぱい巨乳にして頂きたいです。\n\n・色ラフもしくはお時間が厳しいようでしたら白黒ラフでも大丈夫です。\n\n以上になります。\n条件に合致していましたら制作して頂けると嬉しいです。\nよろしくおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/9", "thumbnail_src": "https://si.imgix.net/24180fda/uploads/origins/435e17f2-efeb-4b49-b39a-1ea8ed686acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=519e7a021558ea24a6e33d67da11d921", "thumbnail_srcset": "https://si.imgix.net/24180fda/uploads/origins/435e17f2-efeb-4b49-b39a-1ea8ed686acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=519e7a021558ea24a6e33d67da11d921, https://si.imgix.net/24180fda/uploads/origins/435e17f2-efeb-4b49-b39a-1ea8ed686acc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1c2bcb314918048e02e9b80222986d6 2x, https://si.imgix.net/24180fda/uploads/origins/435e17f2-efeb-4b49-b39a-1ea8ed686acc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f666b5d3eda7295f8bac747f087fe30 3x", "genre": "art", "nsfw": false, "body": "素敵なイラスト拝見しております！\n\nウマ娘のメジロパーマーをお願いできないでしょうか？\nXで9月28日、29日に投稿されたライラック、アーモンドアイのように、革ジャン、ジーンズ、ヘソ出しで描いていただけたら幸いです。\n\nカラーorモノクロは可能な範囲で作成いただければと思います。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/8", "thumbnail_src": "https://si.imgix.net/a8062531/uploads/origins/ac835d87-15cc-47b3-8d37-17fb29cf981e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d37c9019b8c23f7425bec70aa2b5941f", "thumbnail_srcset": "https://si.imgix.net/a8062531/uploads/origins/ac835d87-15cc-47b3-8d37-17fb29cf981e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d37c9019b8c23f7425bec70aa2b5941f, https://si.imgix.net/a8062531/uploads/origins/ac835d87-15cc-47b3-8d37-17fb29cf981e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11a8865ed3a9c6ebac97457fc2a46b24 2x, https://si.imgix.net/a8062531/uploads/origins/ac835d87-15cc-47b3-8d37-17fb29cf981e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cc441b42ee979009c0910d7fd0c99a9 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nXで拝見したイラストがとても素敵だと思いました。\n\n今回は、カラーでこちらのイラストを依頼させていただきたいと考えています。\nもしカラーが難しい場合は、モノクロでも大丈夫です。\n\n・キャラクターはウマ娘のヴィブロスです。\n・衣装はドルフィンパンツに、ライトグレーのトップス。\n・表情は小さく優しい笑顔でお願いします。\n・構図やポーズはおまかせします。\n\n以上になります。\nご検討よろしくお願いいたします。\n必要に応じて、料金を調整していただいて構いません。", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/7", "thumbnail_src": "https://si.imgix.net/73eba12d/uploads/origins/cb76a60c-bf5e-4ba9-86a3-d5a49079f609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaaf5665cb200a1d4902920690a79dde", "thumbnail_srcset": "https://si.imgix.net/73eba12d/uploads/origins/cb76a60c-bf5e-4ba9-86a3-d5a49079f609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaaf5665cb200a1d4902920690a79dde, https://si.imgix.net/73eba12d/uploads/origins/cb76a60c-bf5e-4ba9-86a3-d5a49079f609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6437020721c87e41c2703e9dcf9a9ac7 2x, https://si.imgix.net/73eba12d/uploads/origins/cb76a60c-bf5e-4ba9-86a3-d5a49079f609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6009882c7f65dc57e0357cba7739504 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nいつもXにて素敵なイラストを拝見させていただいております。\n\n今回ご依頼したいのは以下のとおり\n\n・キャラはウマ娘のメジロアルダン\n・衣装は下はドルフィンパ◯ツ、上はおまかせします。\n・ポーズ、背景等はおまかせします。\n・表情は柔和な笑顔でお願いします。\n・カラーでお願いしたいですが、金額的に厳しいなら全然大丈夫です。\n\n以上になります。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Belle_Reinedesu/works/6", "thumbnail_src": "https://si.imgix.net/3b626b5d/uploads/origins/001251f8-aa85-49a6-8c84-bd3bfd532ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1305fe2e581e822ddd62492b19e03a1", "thumbnail_srcset": "https://si.imgix.net/3b626b5d/uploads/origins/001251f8-aa85-49a6-8c84-bd3bfd532ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit