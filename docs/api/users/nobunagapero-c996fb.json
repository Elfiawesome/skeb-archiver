gix.net/05726a60/uploads/origins/b00e6887-be73-4484-bd35-d8b99d12e152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6621fa295d0019bafd6cd63bdd3d656e", "thumbnail_srcset": "https://si.imgix.net/05726a60/uploads/origins/b00e6887-be73-4484-bd35-d8b99d12e152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6621fa295d0019bafd6cd63bdd3d656e, https://si.imgix.net/05726a60/uploads/origins/b00e6887-be73-4484-bd35-d8b99d12e152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c6cebdf1d26f4314922e97f84096e69 2x, https://si.imgix.net/05726a60/uploads/origins/b00e6887-be73-4484-bd35-d8b99d12e152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f13bf6d9811374a383ee427ffd923279 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回はインクリングクロニアの高画質な参考画像を募集しています。正面と背面、そしてできれば様々な表情の頭部のクローズアップ画像もお願いします。\n\n服装について：オレンジちゃんのタンクトップの露出度を抑えたような白いタンクトップ（胸の谷間が少なく、おへそも少し見える程度）に、グレーのデニムショートパンツ（太もも上半分くらいの長さ）を履かせてください。足は素足でも構いませんし、必要であればシンプルなサンダルを描いてください。\n\n髪型は最初のイラスト（下記参照）と同じですが、触手は2本です。\nhttps://drive.google.com/file/d/1zdycYFdFdR0l29ZakGXxeIhOGYO0YAmt/view?usp=drive_link\n\n体型は人間版参考画像（下記参照）とほぼ同じですが、胸のサイズと太ももを少し大きくしてください。\nhttps://drive.google.com/file/d/1dlW_z4xtflKLFyXbYfmQMhgh8pIxX3nD/view?usp=drive_link\n\n最後に、デザインをより個性的で認識しやすいものにするために、髪の毛に小さなシンプルなアクセサリーを一つ加えていただいても構いません。\n\nhttps://drive.google.com/file/d/1zdycYFdFdR0l29ZakGXxeIhOGYO0YAmt/view?usp=drive_link https://drive.google.com/file/d/1dlW_z4xtflKLFyXbYfmQMhgh8pIxX3nD/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/188", "thumbnail_src": "https://si.imgix.net/79a1a0a1/uploads/origins/818ec58f-dee8-42a7-a1ed-216644b85926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8629b3786371f2de6ef112e0d249f4f8", "thumbnail_srcset": "https://si.imgix.net/79a1a0a1/uploads/origins/818ec58f-dee8-42a7-a1ed-216644b85926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8629b3786371f2de6ef112e0d249f4f8, https://si.imgix.net/79a1a0a1/uploads/origins/818ec58f-dee8-42a7-a1ed-216644b85926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=263e1c8bb144958dfdbe5db358db83f6 2x, https://si.imgix.net/79a1a0a1/uploads/origins/818ec58f-dee8-42a7-a1ed-216644b85926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddf9b965d75ede993f89764694e6b2e5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/187", "thumbnail_src": "https://si.imgix.net/3a6d4698/uploads/origins/057b410c-15d4-42aa-8618-a2c079ace78e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e354d6954118ca6744371c4ee9bceadf", "thumbnail_srcset": "https://si.imgix.net/3a6d4698/uploads/origins/057b410c-15d4-42aa-8618-a2c079ace78e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e354d6954118ca6744371c4ee9bceadf, https://si.imgix.net/3a6d4698/uploads/origins/057b410c-15d4-42aa-8618-a2c079ace78e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=198397380b53417b8d865dd03d1cfc6c 2x, https://si.imgix.net/3a6d4698/uploads/origins/057b410c-15d4-42aa-8618-a2c079ace78e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f67ad7348ea7e37447d7cb94ab2a9c2 3x", "genre": "art", "nsfw": true, "body": "オレンジのインクリング娘が巨大なオレンジ色のガムを膨らませている絵が欲しい。オレンジは全裸。参考画像と同様のポーズで、跪いて大きな胸を弄ったり揉んだりしながら見せびらかす様子を描いてほしい。オレンジの周りにオレンジ色のガムが数個散らばっている様子も描いてほしい。\n\nバブルは巨大サイズで、底辺がオレンジの腹部/腰あたりに来るように。オレンジの胸がバブルに少し押し付けられている様子も表現してください。バブルが破裂した代替バージョンも用意し、オレンジが全身にべったり付いたオレンジ色のベタベタした状態に反応する様子を描いてください。\n\nガムパッケージ参考画像：https://drive.google.com/drive/folders/1-_jkqz3HOYOiPHVmGXwMaLTRINdomLXBhttps://drive.google.com/drive/folders/1-Adjja044RP4zRL9QyRCld0EpNslLI8U", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/186", "thumbnail_src": "https://si.imgix.net/a1edff1e/uploads/origins/69bc5ea1-0404-4971-ace1-a07f3cc1846c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56bc1cac50e76c30b63a5ab3d0c900cc", "thumbnail_srcset": "https://si.imgix.net/a1edff1e/uploads/origins/69bc5ea1-0404-4971-ace1-a07f3cc1846c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56bc1cac50e76c30b63a5ab3d0c900cc, https://si.imgix.net/a1edff1e/uploads/origins/69bc5ea1-0404-4971-ace1-a07f3cc1846c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a2b3a6cdcdadee8fa31d580b7def8eb 2x, https://si.imgix.net/a1edff1e/uploads/origins/69bc5ea1-0404-4971-ace1-a07f3cc1846c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b69dff19f624a8f8c306fd5880e1674e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、オクトリングがヘリウム風船の束を割るシーンをリクエストします。彼女は風船の根元をつまんで、今にも破裂させようとしている様子でいてください。視聴者に向けて怒った表情を浮かべてほしいです。背景には彼女が割ろうとしている風船と共に、他のヘリウム風船が浮かんでいるようにしてください。可能であれば大きな胸を付けてください。全ての風船が破裂するバージョンもお願いします。\n大変感謝いたしますキャラクター衣装参考: https://files.catbox.moe/8zu4nc.pngポーズとシナリオ: https://files.catbox.moe/ugu6ri.png", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/185", "thumbnail_src": "https://si.imgix.net/19d9c62d/uploads/origins/3614ba0b-e65d-4aba-8633-3c527fcee701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1393d52fd5ece05d400cfad815c04f3b", "thumbnail_srcset": "https://si.imgix.net/19d9c62d/uploads/origins/3614ba0b-e65d-4aba-8633-3c527fcee701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1393d52fd5ece05d400cfad815c04f3b, https://si.imgix.net/19d9c62d/uploads/origins/3614ba0b-e65d-4aba-8633-3c527fcee701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0038fc621b31dd46de29e4557b6ba638 2x, https://si.imgix.net/19d9c62d/uploads/origins/3614ba0b-e65d-4aba-8633-3c527fcee701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f38677ec4f7714ded77ca8708510e390 3x", "genre": "art", "nsfw": true, "body": "またこんにちは！前回のリクエストの出来栄えが気に入りました。今度はインクリングのセリカを同じようなシチュエーションで描いてほしいです。バニースーツを着て、舌を出して可愛らしくカメラを見つめながら、指でピースサインもしている姿をお願いします。 いくつかの代替画像もお願いします。2枚目では猫のランジェリーを着用し、カメラに向かってほのかに赤面しながらピースサインを出し、手の真上にハートマークを浮かべてカメラにウインクする姿。3枚目では再びバニースーツ姿ですが、衣装の上部が胸元を露わにし、それを手で押さえながら穏やかで愛情深い表情を浮かべる姿。 4枚目（最終）は完全なヌード。ポーズ・衣装・キャラクター設定：https://drive.google.com/drive/folders/14mrDJaEuha3WgIocqfT2L-QJj5kc9coj?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/184", "thumbnail_src": "https://si.imgix.net/9ac4f1ec/uploads/origins/4a1893e3-2702-4bfd-b653-2d5993bfc47b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=857f79c7b9547fe0969a3d78e6d655b6", "thumbnail_srcset": "https://si.imgix.net/9ac4f1ec/uploads/origins/4a1893e3-2702-4bfd-b653-2d5993bfc47b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=857f79c7b9547fe0969a3d78e6d655b6, https://si.imgix.net/9ac4f1ec/uploads/origins/4a1893e3-2702-4bfd-b653-2d5993bfc47b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a544a2ffd0769fbb05a54463e387e25f 2x, https://si.imgix.net/9ac4f1ec/uploads/origins/4a1893e3-2702-4bfd-b653-2d5993bfc47b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=566533fddd17ecc285a7dca18ee73608 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/183", "thumbnail_src": "https://si.imgix.net/8b40a3a2/uploads/origins/93388921-f142-470a-a619-ad3a5fb935e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57501a03b7fc547a3922b575c15a90a0", "thumbnail_srcset": "https://si.imgix.net/8b40a3a2/uploads/origins/93388921-f142-470a-a619-ad3a5fb935e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57501a03b7fc547a3922b575c15a90a0, https://si.imgix.net/8b40a3a2/uploads/origins/93388921-f142-470a-a619-ad3a5fb935e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f2a44d9a627579f3e3a49abc8789e40 2x, https://si.imgix.net/8b40a3a2/uploads/origins/93388921-f142-470a-a619-ad3a5fb935e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5865622dbd8b8b02e1fe7a1fe77a623 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/182", "thumbnail_src": "https://si.imgix.net/66011fa4/uploads/origins/ba936bca-c490-4bb3-b0d3-3b96f173c45e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac485dcc6369d62f18c0484fc8b9f04", "thumbnail_srcset": "https://si.imgix.net/66011fa4/uploads/origins/ba936bca-c490-4bb3-b0d3-3b96f173c45e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac485dcc6369d62f18c0484fc8b9f04, https://si.imgix.net/66011fa4/uploads/origins/ba936bca-c490-4bb3-b0d3-3b96f173c45e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=773ef597072b8a91730e91d618f3b69c 2x, https://si.imgix.net/66011fa4/uploads/origins/ba936bca-c490-4bb3-b0d3-3b96f173c45e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a6605fff9501c0ee04152034b8841b8 3x", "genre": "art", "nsfw": true, "body": "私のオリジナルキャラクターが小さな人を食べているイラストをお願いします。https://imgur.com/a/qQgMrhZ", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/181", "thumbnail_src": "https://si.imgix.net/d087d7eb/uploads/origins/c7229062-7009-4610-bf2a-e6c88a3f189f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04be5e181db942d6ed14e002a0e1d599", "thumbnail_srcset": "https://si.imgix.net/d087d7eb/uploads/origins/c7229062-7009-4610-bf2a-e6c88a3f189f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04be5e181db942d6ed14e002a0e1d599, https://si.imgix.net/d087d7eb/uploads/origins/c7229062-7009-4610-bf2a-e6c88a3f189f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba05964819f004747af876b8d57d7866 2x, https://si.imgix.net/d087d7eb/uploads/origins/c7229062-7009-4610-bf2a-e6c88a3f189f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31c4439f7cb236837967b0b03b2877dc 3x", "genre": "art", "nsfw": false, "body": "こんにちは。インクリング・クロニアの物語の続きを書きたいと思います。\n\nクロニアと彼女の友達（前回のリクエストと同じ「パステル」と「ブルーインクリング」）がハイカラシテのどこかのショッピングモールか通りを歩いているイラストをお願いします。\nクロニアは少し「きちんとした」服装になっていますが、このまま人前を歩くのはとても恥ずかしいようです。\nパステルはクロニアの肩に座り、ブルーインクリングはその前にいます。二人は街を案内しながら、彼女の体格の人に合う服を買える場所を探しています。\nその場にいる一般の人々（低密度）は、ぶらぶら歩く巨大イカをじっと見つめずにはいられません。\n\nそれと、「吸血鬼インクリング」の小さな漫画ページもお願いします。彼女は以前「緑のおやつ」を食べたようで、以前より背が高くなり、遠くからいたずらっぽい笑みを浮かべてグループを見ています。\n\nメインイラスト（クロニアと仲間たちが街を歩く）の参考資料：\nhttps://drive.google.com/file/d/1niERvE4c0yPKBuIs45wuBQyugj2alrTW/view?usp=drive_link\nマンガ小ページの参考資料（ヴァンパイアインクリング編ティーザー）：\nhttps://drive.google.com/file/d/1crzK4kPpPGnOOHQ30nDOL1HWenaTC2CU/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/180", "thumbnail_src": "https://si.imgix.net/fe0e2e6b/uploads/origins/d632d003-223c-43cd-8f72-452309ba7df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3201fabd7b1fa5d2f29d4a620c4fb567", "thumbnail_srcset": "https://si.imgix.net/fe0e2e6b/uploads/origins/d632d003-223c-43cd-8f72-452309ba7df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3201fabd7b1fa5d2f29d4a620c4fb567, https://si.imgix.net/fe0e2e6b/uploads/origins/d632d003-223c-43cd-8f72-452309ba7df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b75b78b4d2f98aa3ce900cf469bbc123 2x, https://si.imgix.net/fe0e2e6b/uploads/origins/d632d003-223c-43cd-8f72-452309ba7df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d9d219bf7f73b3f3e0f3bcb4162e3db 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/179", "thumbnail_src": "https://si.imgix.net/5c8fed51/uploads/origins/697eed06-2376-448f-b594-3dcf64aff985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e372a3787d0db0ade7cc641925ed4559", "thumbnail_srcset": "https://si.imgix.net/5c8fed51/uploads/origins/697eed06-2376-448f-b594-3dcf64aff985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e372a3787d0db0ade7cc641925ed4559, https://si.imgix.net/5c8fed51/uploads/origins/697eed06-2376-448f-b594-3dcf64aff985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eb64fbd5944c96a9f2db7f5681154f9 2x, https://si.imgix.net/5c8fed51/uploads/origins/697eed06-2376-448f-b594-3dcf64aff985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7feb2f60e86d241d6f451c339ef7fcd 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\nスプラトゥーンのキャラクター2人が風船を割るのをお願いしたいです。\nキャラクター1は風船を腕に抱えて割ろうと威嚇しているはずです。\nもう一人のキャラクターは、大きな胸とにやにや笑いを浮かべているはずです。\n彼女は風船を割るためにタバコを風船にかざします。\n\nキャラクター2は膝をついて風船を割らないように懇願しているはずだ。\n彼女もまた、大きな胸と怯えた表情をしているはずだ。\n可能であれば、背景に他の割れた風船と、破裂音もお願いします。\n風船の色は自由です。\nありがとうございました。\nキャラクター1の服装：https://files.catbox.moe/rhj6ch.png\nポーズとシナリオ: https://files.catbox.moe/120gbo.jpg\nhttps://files.catbox.moe/tzbax1.jpg\nキャラクター2の服装: https://files.catbox.moe/se3wzq.png", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/178", "thumbnail_src": "https://si.imgix.net/f695ac42/uploads/origins/a9f07e50-1dd0-4cf1-a90a-bfaa243e4056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8d63fe38a8e71881391284c1b1545e", "thumbnail_srcset": "https://si.imgix.net/f695ac42/uploads/origins/a9f07e50-1dd0-4cf1-a90a-bfaa243e4056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8d63fe38a8e71881391284c1b1545e, https://si.imgix.net/f695ac42/uploads/origins/a9f07e50-1dd0-4cf1-a90a-bfaa243e4056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3ad01a50b49a4b5b749869e9abb5fc1 2x, https://si.imgix.net/f695ac42/uploads/origins/a9f07e50-1dd0-4cf1-a90a-bfaa243e4056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1eab197ebce0d3a69c1619089596193 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n私のInkling boy OCと、提供されたInkling Schoolgirl OCとのリクエストが欲しいです！\n\nインクリング女子高生は完全に服を着ていますが、胸が露出していてパンティーは履いていません。インクリング少年OCが彼女とセックスしている間、彼女はまたテーブルの上に曲がっています。インクリングの少年も完全に服を着ていますが、インクリングの少女とセックスするためにズボンのファスナーを開けています。インクリング少年はまた、女子校生のオッパイをつかんでいて、女子校生は彼をドヤ顔で見ています。少年と少女のOCがセックスしている間、インクリング女生徒のアソコの中のX線画像も追加してください。インクリング女子校生に大きなお尻と大きなおっぱいを必ず与えてください！\n\nまた、インクリング少年が女子校生のオッパイを強く揉みしだき、女子校生がドヤ顔でアヘ顔をしているザーメン画像も追加してください。\n\n私のインクリング少年OCとインクリング女子校生OCのリファレンスはgoogle driveフォルダにあります。\n\n背景は自由です。\n\nありがとう！\n\nhttps://drive.google.com/drive/u/1/folders/196uGnTSBgQh4wnzblj1DFa9e-l0DTiiW", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/177", "thumbnail_src": "https://si.imgix.net/d726da5e/uploads/origins/abd61463-822a-4180-b555-88bc3132757b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ddb326f8c6c437a0ab52dfcfea7045d", "thumbnail_srcset": "https://si.imgix.net/d726da5e/uploads/origins/abd61463-822a-4180-b555-88bc3132757b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ddb326f8c6c437a0ab52dfcfea7045d, https://si.imgix.net/d726da5e/uploads/origins/abd61463-822a-4180-b555-88bc3132757b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb0a87e821ab008e72bc7ba49bfc9d16 2x, https://si.imgix.net/d726da5e/uploads/origins/abd61463-822a-4180-b555-88bc3132757b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a41674110deeba1b6277e444e838ede0 3x", "genre": "art", "nsfw": true, "body": "アオリちゃんとミズタの背景はおまかせのカラーイラストの依頼です。アオリちゃんの表情や構図は https://x.com/nobunagapero/status/1584900059971608578?t=QlctOeFltK6D0MGxWtt2lQ&s=19 を参考に。\n(胸のサイズ感)前回のアオリちゃんみたいなボリューミーな感じ\n(衣装)いつものアイドル衣装\n\n(2枚目)\n前からおっぱい両手で鷲掴みにされて\n(表情)恥ずかしそうに赤面して目をそらしててほしいです。\nミズタは\n以前に描かれた頼んだら揉ませてくれるミズタさんhttps://x.com/nobunagapero/status/1879260654697431365?t=R6frwA7b6ldvR2MliT1mSw&s=19を(腕の包帯はなし)夏で蒸れるミズタやもみもみミズタみたいな等身やアングル＋胸は少し盛ってもらうような感じで描いてほしいです。揉まれる前の頼まれて困ってる差分も描いてもらえるととてもありがたいです。アオリちゃんもミズタも揉まれ具合や胸のくい込み具合は(https://www.pixiv.net/artworks/115113371#big_0)のようながっつりくい込んでる感じでお願いします。\nあともしよかったら(https://x.com/nobunagapero/status/1556989127736033280?t=LE5SZi_jhS9Ig9i-PFly9A&s=19)のような構図で私服アオリちゃんが両手でお尻鷲掴みされて恥ずかしそうにしてる絵も描いてほしいです。長文失礼しました。", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/176", "thumbnail_src": "https://si.imgix.net/81fb0f7f/uploads/origins/c50781d0-6e66-4a75-9af3-4199af731d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dbeccb3ee11521070e4c47994c46041", "thumbnail_srcset": "https://si.imgix.net/81fb0f7f/uploads/origins/c50781d0-6e66-4a75-9af3-4199af731d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dbeccb3ee11521070e4c47994c46041, https://si.imgix.net/81fb0f7f/uploads/origins/c50781d0-6e66-4a75-9af3-4199af731d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b73e794da3def3c41454a1d456f327a5 2x, https://si.imgix.net/81fb0f7f/uploads/origins/c50781d0-6e66-4a75-9af3-4199af731d0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f29fc3e9bd70967ee6edc0fa1f8d930 3x", "genre": "art", "nsfw": true, "body": "カリー(アオリちゃん)がこのオクトリングの女の子とセックスしている絵が見たいです。どんな体位でも自由に選んでください。オクトリングは中くらいの大きさの胸で、カリーは大きめの胸がいいです。\nできればオクトリングとカリーの服が背景に見えるようにしてほしい。\n\nhttps://drive.google.com/drive/folders/14js_0A_Xwk0KopiUm_L-SUbcUo8GpK3K?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/175", "thumbnail_src": "https://si.imgix.net/bda7aec1/uploads/origins/16e3731d-1f0a-465d-be64-a03d07746c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0313c25b4a7e22ab0199a7edf75d68b4", "thumbnail_srcset": "https://si.imgix.net/bda7aec1/uploads/origins/16e3731d-1f0a-465d-be64-a03d07746c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0313c25b4a7e22ab0199a7edf75d68b4, https://si.imgix.net/bda7aec1/uploads/origins/16e3731d-1f0a-465d-be64-a03d07746c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a575ce19b86377963e3aa2857bdebe65 2x, https://si.imgix.net/bda7aec1/uploads/origins/16e3731d-1f0a-465d-be64-a03d07746c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f00f3655e4dd7509d86306800b6c0ba 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！僕のスライムバージョンのキャラクターの絵をお願いします！\n\nスライムの女の子は、植物をテーマにした家や花のある妖精の村を破壊するシナリオでお願いします。アングルは地上から彼女を見上げるような感じで。多くの妖精が怯えパニックになり、他の妖精はスライムの体の中に閉じ込められている。\n\nもう一枚、スライムが横たわっている写真をお願いしたい。彼女の周りはスライムでびしょびしょになり、ほとんどが破壊されている。すべての妖精が集められ、彼女の胃のあたりにかたまり、息苦しそうにしている。妖精が溶けている写真（あなたがそれを描きたいのでなければ、それはグラフィックである必要はありません）と、妖精が完全になくなり、少し質量を増している別のバージョン、この写真のバリエーションが欲しい。\n\nお読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1tjbrFKadP9JEomLo83szA2Rnb1IDgK2P?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/174", "thumbnail_src": "https://si.imgix.net/7b5c7c97/uploads/origins/24133491-e9c1-453d-b5c4-317084b71fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=333245a17d7cd0853d3a75169df1033e", "thumbnail_srcset": "https://si.imgix.net/7b5c7c97/uploads/origins/24133491-e9c1-453d-b5c4-317084b71fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=333245a17d7cd0853d3a75169df1033e, https://si.imgix.net/7b5c7c97/uploads/origins/24133491-e9c1-453d-b5c4-317084b71fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76a448569e77f6109b64303fb6561d5e 2x, https://si.imgix.net/7b5c7c97/uploads/origins/24133491-e9c1-453d-b5c4-317084b71fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e96dbe356d40e0baa4526e2b2b3a049e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nobunagapero/works/173", "thumbnail_src": "https://si.imgix.net/028aa4ee/uploads/origins/5c49bc57-1f68-4493-8685-bb4f66f99039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsi