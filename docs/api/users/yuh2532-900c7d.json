p&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3fd67a8da01a2d4a6611530596242f6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1875547569679691777%2FIIFU3QOW.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af322d0b779bd5572f06cf5b236babd8 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuh2532/works/1", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1875547569679691777%2FIIFU3QOW.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c0b80f4d108a76ae92a1fbd82fe9f3", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1875547569679691777%2FIIFU3QOW.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c0b80f4d108a76ae92a1fbd82fe9f3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1875547569679691777%2FIIFU3QOW.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ff8b6644675b8504a4f3404f088788c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1875547569679691777%2FIIFU3QOW.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=899894112bac2e83641e3a5fc6639247 3x", "genre": "music", "nsfw": false, "body": "あ！\ncolltさんだ。記念パピコです。\n\nいつも素敵な曲が素敵ですね。\n素敵な事は素敵なので素敵です。\nさらなる素敵を昇華しているようでなによりでございます。\nそう、語彙はありません。\n\nただし伝わる事があるでしょう。\nそれが素敵ということ。\nよろしいでしょうか。\n\nひとまずこちらのリクエストなどは、あくまで気分でどうぞの者であります。\nリクエスト弾くのもできるすけぶはいいところ。\nあとは日ごろ精力的に曲作成されていてすごいの念。\nそういうやつですのでよしなに。\n\nかしこぺろ", "created_at": "", "completed_at": ""}]}