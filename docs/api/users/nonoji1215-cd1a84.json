fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0402c2acb9e8df835effe63a906f6072 2x, https://si.imgix.net/b2e68127/uploads/origins/f436c27c-6951-430e-8a1a-678193221c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0091d66f9ea49141b679d75c8a62b03c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きです。\n私のキャラクターはアライグマです......彼女は元気でドジで、ヤンデレな雰囲気があります。\nポーズ、表情、服装はあなた次第です！テーマに沿って、よりカジュアルに。\nもしあなたがアイデアを求めているなら、血の袋と彼女の牙が口や牙に血が付いているのが見えるようなものがいいかもしれません。\n\n唯一のリクエストは、16：9でお願いします。\n\nhttps://drive.google.com/drive/folders/1aZPaHWlRXcsM3mZwZrZ02e81SLWYViy3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nonoji1215/works/18", "thumbnail_src": "https://si.imgix.net/6aa7b15c/uploads/origins/ceba8fe4-4ade-45a1-b6f7-3ee55f70bcf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00695d045bee5a89847c870cc2d07bc0", "thumbnail_srcset": "https://si.imgix.net/6aa7b15c/uploads/origins/ceba8fe4-4ade-45a1-b6f7-3ee55f70bcf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00695d045bee5a89847c870cc2d07bc0, https://si.imgix.net/6aa7b15c/uploads/origins/ceba8fe4-4ade-45a1-b6f7-3ee55f70bcf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe1418572f732ab345d1f7b9c3d6c872 2x, https://si.imgix.net/6aa7b15c/uploads/origins/ceba8fe4-4ade-45a1-b6f7-3ee55f70bcf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=022ec2610392afe0aa6cdf2cd9ef05d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nonoji121