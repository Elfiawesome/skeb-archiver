23-9901-432a28c3a0dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ffdccaef7b6f675138733d0c49b78b8 2x, https://si.imgix.net/2342a23a/uploads/origins/06babe4d-bea7-4523-9901-432a28c3a0dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd93bb7afba3db13763496f6fdd75a15 3x", "genre": "art", "nsfw": false, "body": "マルギット・エーベルバッハ（マルギット・エーベルバッハ）を描いていただきたいのですが、https://imgur.com/a/WzyBjXa\n普段は軍事的なキャラクターなので、もっと気楽な感じで見てみたいです。暗い色のパーカーを着て、カジュアルな格好をしているところを描いてください。表情はリラックスしていて楽しそうな感じでお願いします。\n\nポーズなどの詳細はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@nakonbu1/works/2", "thumbnail_src": "https://si.imgix.net/02770cce/uploads/origins/004bb442-96c7-4f47-9c75-7645aead0805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52de020405c08ab84de55ec58298419b", "thumbnail_srcset": "https://si.imgix.net/02770cce/uploads/origins/004bb442-96c7-4f47-9c75-7645aead0805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52de020405c08ab84de55ec58298419b, https://si.imgix.net/02770cce/uploads/origins/004bb442-96c7-4f47-9c75-7645aead0805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5995fd26d451c8aba4d2f8063787d694 2x, https://si.imgix.net/02770cce/uploads/origins/004bb442-96c7-4f47-9c75-7645aead0805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd047ede0b9785f0bb5870adf8f8fd6b 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n私のキャラクターを描いてくれませんか？\nhttps://toyhou.se/8126295.nora\n旅する魔女です。いたずら好きな性格ですが、自分の力を必要としている人を探しています。\nポーズや構図はお任せします。旅や発見などのアウトドアと、読書や実験などのインドアの両方が好きなキャラクターです。\n着せ替えは自由です。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@nakonbu1/works/1", "thumbnail_src": "https://si.imgix.net/6f5c929b/uploads/origins/2b05978e-6cd3-4f08-8f9c-02c1802bd582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=702a2d95d41a27a2b41563767d81de71", "thumbnail_srcset": "https://si.