=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ac8a49aac04abc7b651b0296a44b557 3x", "genre": "art", "nsfw": false, "body": "WHOZさま、初めまして。\nいつも素敵なイラスト拝見させていただいております！\n\n今回は私のオリジナルキャラクターの曲パロイラストを描いていただきたいと思い、リクエストをお送りしました！\n曲はてにをは様の「修羅薔薇」でお願いしたいです！( https://youtu.be/SkzHGOLdvsA?si=YrFpxZULTUmckRtv )\n構図や表情はMVのイラストの通りで、服装や髪型は添付の資料のデザインのまま描いていただけると嬉しいです！\n使用用途としては個人での鑑賞、印刷に使わせていただきたいと考えております。歌ってみたのMVなどでの利用は一切いたしません。\n資料は下記のURLより参照お願いします。\n\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Y1jpwJMR4ZLilgyuzbM6rGVNtuk0o7Jn", "created_at": "", "completed_at": ""}, {"path": "/@fujiko_fujita/works/160", "thumbnail_src": "https://si.imgix.net/4dbccda2/uploads/origins/a337ff5f-57a0-4a4e-b41d-c0b06d8d61a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45edbc61bc2036215cf20230c4ab4bb9", "thumbnail_srcset": "https://si.imgix.net/4dbccda2/uploads/origins/a337ff5f-57a0-4a4e-b41d-c0b06d8d61a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45edbc61bc2036215cf20230c4ab4bb9, https://si.imgix.net/4dbccda2/uploads/origins/a337ff5f-57a0-4a4e-b41d-c0b06d8d61a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95d9dd5ef5568089f4cdd608d8a9ea30 2x, https://si.imgix.net/4dbccda2/uploads/origins/a337ff5f-57a0-4a4e-b41d-c0b06d8d61a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2476cd3d5b8f155c69362b43fdd8e253 3x", "genre": "art", "nsfw": true, "body": "こんにちは。あなたの絵を見つけて、すぐに恋に落ちました!私のバニーボーイocのイラストをお願いしたいです。\n\n彼が網にかかった人魚のように描かれていて、ゴア要素も入っているのが見たいです。体に傷があるような感じで。\n\nありがとうございました。\n\nhttps://drive.google.com/file/d/1GtiL5eHtr_aNtqcRWfOTaFBThYxy9ckr/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@fujiko_fujita/works/159", "thumbnail_src": "https://si.imgix.net/6d124687/uploads/origins/fd9baa56-8e95-414f-84e2-3b6c0e1539df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4647631ab273d9a27d434ce6de1a4d89", "thumbnail_srcset": "https://si.imgix.net/6d124687/uploads/origins/fd9baa56-8e95-414f-84e2-3b6c0e1539df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4647631ab273d9a27d434ce6de1a4d89, https://si.imgix.net/6d124687/uploads/origins/fd9baa56-8e95-414f-84e2-3b6c0e1539df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdc77e100a6e2b7cbd4f3b4fcf2b988e 2x, https://si.imgix.net/6d124687/uploads/origins/fd9baa56-8e95-414f-84e2-3b6c0e1539df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4acf5db6d2008f568fcca07ed9e53379 3x", "genre": "art", "nsfw": true, "body": "VtuberのLayna Lazarのアートワークをリクエストしたい。彼女のモデルには血でできた手が何本か浮いていて、そのうちの2本は彼女の背中から出ている翼のような構造の点滴線の糸を持っています。アートワークの中に1匹か2匹のとても小さな青い蝶を入れてください。美しく魅力的なポーズを希望しますが、乳首や性器が見えるものは入れないでください。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/13G12LhGY55MhFItdJ9c81-EOB07mwJId", "created_at": "", "completed_at": ""}, {"path": "/@fujiko_fujita/works/158", "thumbnail_src": "https://si.imgix.net/b000289a/uploads/origins/a67a59e9-2e9a-44d4-a5e6-e05bf43d6930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f04d18b57b5aaa77337799ba147400", "thumbnail_srcset": "https://si.imgix.net/b000289a/uploads/origins/a67a59e9-2e9a-44d4-a5e6-e05bf43d6930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f04d18b57b5aaa77337799ba147400, https://si.imgix.net/b000289a/uploads/origins/a67a59e9-2e9a-44d4-a5e6-e05bf43d6930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efcb8bde5eb2c2b96f7191e536720952 2x, https://si.imgix.net/b000289a/uploads/origins/a67a59e9-2e9a-44d4-a5e6-e05bf43d6930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88414f09ecfa7d0a6c6869720b350525 3x", "genre": "art", "nsfw": false, "body": "こんにちは、whoz様。『神待ちイプくん』のeveにビジュアル系中華風の衣装を1点お願いしたいです。もし可能ならeveの髪を長くしていただけると嬉しいです。またのご依頼を楽しみにしております。ご自由にお作りください。\n\nhttps://drive.google.com/drive/folders/1uUy3t2KG9O2dcXRjhGjHvYuWjrU1oUT8", "created_at": "", "completed_at": ""}, {"path": "/@fujiko_fujita/works/157", "thumbnail_src": "https://si.imgix.net/28b6c9d4/uploads/origins/b5aed383-2386-4858-9dcb-6c239c4cbc23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22ded9342b9309514ed886bc4cf1fa5c", "thumbnail_srcset": "https://si.imgix.net/28b6c9d4/uploads/origins/b5aed383-2386-4858-9dcb-6c239c4cbc23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22ded9342b9309514ed886bc4cf1fa5c, https://si.imgix.net/28b6c9d4/uploads/origins/b5aed383-2386-4858-9dcb-6c239c4cbc23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7e33c2e78555f0d15bc493d6f2d50fb 2x, https://si.imgix.net/28b6c9d4/uploads/origins/b5aed383-2386-4858-9dcb-6c239c4cbc23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8a381bcb4e99817e0347fab43527bcb 3x", "genre": "art", "nsfw": false, "body": "初めましていつも素敵なイラスト拝見しております。今回WHOZ先生がイラストを担当されているこぐまクッキー様の「神待ちイブくん」のイブくんを描いていただきたいのですが、以前先生がFAとしてTwitterに載せていた大人イブくんの方でお願いしたいです。\n\n依頼内容\nイメージとしましては姫ちゃんとデートのためにおしゃれをしてきた(普段着の感じではなく少し張り切ったような服装)大人イブくんでお願いしたいです。抽象的で申し訳ないですが髪型はサイドに編み込みがあったら嬉しいですが先生にお任せします。表情は笑顔でお願いします。大変抽象的で申し訳ないです。\n細かい構図やシチュエーションもお任せでお願いします。\n\n用途\n個人鑑賞、個人利用(アイコンやスマホの\n背景等)\n\n依頼内容や金額等問題ございましたら再送お願いいたします。\n\nhttps://x.com/i/status/1927725742948843786", "created_at": "", "completed_at": ""}, {"path": "/@fujiko_fujita/works/156", "thumbnail_src": "https://si.imgix.net/da20a6b3/uploads/origins/bcfbfc52-b3cf-496e-b25a-820f3cf575d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e3f51dd30e2d54a77de2732086b06d0", "thumbnail_srcset": "https://si.imgix.net/da20a6b3/uploads/origins/bcfbfc52-b3cf-496e-b25a-820f3cf575d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e3f51dd30e2d54a77de2732086b06d0, https://si.imgix.net/da20a6b3/uploads/origins/bcfbfc52-b3cf-496e-b25a-820f3cf575d3?bg=%23fff&auto=format%2Cc