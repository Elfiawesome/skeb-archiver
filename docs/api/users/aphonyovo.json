0"}, {"amount": 7000, "recorded_at": "2026-03-07T13:44:19.663333+00:00"}]}, "current_prices": {"art": 16000, "correction": 7000}, "price_range": {"art": {"min": 10000, "max": 25000}, "correction": {"min": 6000, "max": 14000}}, "links": [{"label": "Misskey_io", "url": "https://misskey.io/@ahonobo", "name": "ahonobo"}, {"label": "Website", "url": "https://ahono.booth.pm", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/4647727", "name": "4647727"}, {"label": "YouTube", "url": "https://youtube.com/channel/UCcjfagRZ35AoT1aYKrISlDA", "name": "UCcjfagRZ35AoT1aYKrISlDA"}, {"label": "DLsite", "url": "https://www.dlsite.com/home/circle/profile/=/maker_id/40206", "name": "40206"}], "flags": {}, "acceptable": false, "works": [{"path": "/@aphonyovo/works/17", "thumbnail_src": "https://si.imgix.net/8beec733/uploads/origins/a2c7680a-ac4f-40dd-a244-6f6a9ff28e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d260dc68dfb222fa4c6ebe9aea7b616", "thumbnail_srcset": "https://si.imgix.net/8beec733/uploads/origins/a2c7680a-ac4f-40dd-a244-6f6a9ff28e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d260dc68dfb222fa4c6ebe9aea7b616, https://si.imgix.net/8beec733/uploads/origins/a2c7680a-ac4f-40dd-a244-6f6a9ff28e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4350e75371d9c3c6681e4bbfd1ddcf0b 2x, https://si.imgix.net/8beec733/uploads/origins/a2c7680a-ac4f-40dd-a244-6f6a9ff28e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3890e8d7155d75d5eb006001008672ba 3x", "genre": "art", "nsfw": true, "body": "こんにちは！かなり長い間、あなたのアートスタイルに憧れていました。そこで今回は、あなたに作品を依頼したいと思います。\n一般的には、私のOCがスポーツ用具室でオナニーしたり、ディルドを使ったり、乳首をもんだりしているところを見たいです。彼はサッカーを終えたばかりなので、サッカーソックスを履いています。あとはあなた次第。\n以下は私のOCの参考リンクです（'サッカー参考'ファイルは彼のサッカー衣装です）： https://drive.google.com/drive/folders/1xpC4f4EPNE-1DERxfm_DPJmSvmmkfdFu?usp=sharing\n機械翻訳で書いているので、不正確なところがあったらごめんなさい。\n\nhttps://drive.google.com/drive/folders/1xpC4f4EPNE-1DERxfm_DPJmSvmmkfdFu?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/16", "thumbnail_src": "https://si.imgix.net/5961118f/uploads/origins/f127a65e-cf23-4c6b-9091-4ccc1aacff45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde2ecfc4f21e4db2d070191c21e6d2f", "thumbnail_srcset": "https://si.imgix.net/5961118f/uploads/origins/f127a65e-cf23-4c6b-9091-4ccc1aacff45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde2ecfc4f21e4db2d070191c21e6d2f, https://si.imgix.net/5961118f/uploads/origins/f127a65e-cf23-4c6b-9091-4ccc1aacff45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdbcfd1cbcd38fad5821646f6ace692e 2x, https://si.imgix.net/5961118f/uploads/origins/f127a65e-cf23-4c6b-9091-4ccc1aacff45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6da7e36ebc14dcef00637387a1083d83 3x", "genre": "art", "nsfw": true, "body": "私の二人の忍者少年キャラクター、ミストとレイヴンを描いていただけませんか？以下に参考資料を添付します。\nオレンジのミスト（17歳）は比較的穏やかで口数が少なく、青のレイヴン（16歳）は外向的で少々やんちゃな性格です。彼らは幼い頃からバトルパートナーなのだ。\n二人の淫らでエロティックなやりとりや、からかったり、セックスしたりするところを描いてほしい。ピチピチの忍者スーツ姿でも、ふんどし一丁でも、全裸でもOK。\nシチュエーションはミスト×レイヴンでもレイヴン×ミストでも構いませんので、お好きな方をお選びください！\nバリエーションは自由です。他の関係ないキャラは入れないでください。\nまた、たくさんイッて体をぐちゃぐちゃにして、気持ちよく快感を味わってほしいです。二人の仲の良さが伝わると嬉しいです。\nその他、細かいリクエストはご遠慮ください。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/15", "thumbnail_src": "https://si.imgix.net/c8e2739e/uploads/origins/f8f4a067-548b-4c01-b176-46a14f4aca6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2087f0ca332fa9ee4588be94a12e206e", "thumbnail_srcset": "https://si.imgix.net/c8e2739e/uploads/origins/f8f4a067-548b-4c01-b176-46a14f4aca6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2087f0ca332fa9ee4588be94a12e206e, https://si.imgix.net/c8e2739e/uploads/origins/f8f4a067-548b-4c01-b176-46a14f4aca6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4f78536c2a5cbe3303d4a99ad069ddd 2x, https://si.imgix.net/c8e2739e/uploads/origins/f8f4a067-548b-4c01-b176-46a14f4aca6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b697e3c24c0d282f529d75f938e466be 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/14", "thumbnail_src": "https://si.imgix.net/e6d21804/uploads/origins/cef402d6-999f-486e-ac8e-13bee3dc0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e43dacc14125c31c08687a1394dab1", "thumbnail_srcset": "https://si.imgix.net/e6d21804/uploads/origins/cef402d6-999f-486e-ac8e-13bee3dc0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e43dacc14125c31c08687a1394dab1, https://si.imgix.net/e6d21804/uploads/origins/cef402d6-999f-486e-ac8e-13bee3dc0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08d8b1acdf9325cdd476250882e13821 2x, https://si.imgix.net/e6d21804/uploads/origins/cef402d6-999f-486e-ac8e-13bee3dc0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9462bbba76aadeb1223456f7a5065c7f 3x", "genre": "art", "nsfw": true, "body": "悠琴さん、こんにちは！以前依頼した巨大な吽のイラストを修正したいのですが、黄色い尿を白い精液に変更したいです～それから吽の巨根の長さを2倍に伸ばしてください。", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/13", "thumbnail_src": "https://si.imgix.net/79f00b9b/uploads/origins/d353c2b9-7918-4df0-8b0d-41a1805c517f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67828fbbf97b966f8c14b6d3c0dfbdec", "thumbnail_srcset": "https://si.imgix.net/79f00b9b/uploads/origins/d353c2b9-7918-4df0-8b0d-41a1805c517f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67828fbbf97b966f8c14b6d3c0dfbdec, https://si.imgix.net/79f00b9b/uploads/origins/d353c2b9-7918-4df0-8b0d-41a1805c517f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8001e411c1ba2f66dbde24c2f98fbb0f 2x, https://si.imgix.net/79f00b9b/uploads/origins/d353c2b9-7918-4df0-8b0d-41a1805c517f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb2b642f227804f1c295d28421b86840 3x", "genre": "art", "nsfw": true, "body": "悠琴你好！ 我想委托一张超~~~巨大吽和OC的NSFW委托，很喜欢您画的吽~\n背景是在野外，在仰望视角下，吽坐着靠在山（山不是角色）上（吽坐着比山高），背景中有一些房屋和树木的物品衬托出吽的巨大.\n吽穿着游戏初始立绘的衣服但是没有穿靴子，吽的视线游刃有余而且温柔的看着自己脚趾上的OC，另外一只脚在敌人的上空准备随时踩下去，敌人是日本故事里高大且邪恶的妖怪们（比如鬼）。\n吽一只手撑在地上，另一只手在抚摸自己的大♂根，射出了神圣之水淹没了另一部分的邪恶妖怪们，OC在吽的脚趾缝上给出一个特写画面，OC坐在吽的脚趾上给吽加油，头上的脚趾轻轻揉着OC的头发（吽的温柔调情），足部请画出一点汗和热气这样的美好画面x\n（请把OC也画的仔细一点，可以放大特写画面）\n\n大概就是作为巨大又强大的神圣的吽（狛犬），轻松退治强大的坏妖怪，保护OC且宠爱呵护着他的画面ww\nhttps://drive.google.com/drive/folders/1wlYndzPONqVEAT2nOdka9WXONK9IvThY?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1wlYndzPONqVEAT2nOdka9WXONK9IvThY?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/12", "thumbnail_src": "https://si.imgix.net/813a7bc2/uploads/origins/8197f9ff-e908-40ee-b291-b05b7c63feb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=504d774df77547d0a8de886f84055346", "thumbnail_srcset": "https://si.imgix.net/813a7bc2/uploads/origins/8197f9ff-e908-40ee-b291-b05b7c63feb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=504d774df77547d0a8de886f84055346, https://si.imgix.net/813a7bc2/uploads/origins/8197f9ff-e908-40ee-b291-b05b7c63feb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83c4f9eb6b157e30b293c7272a7d8fb7 2x, https://si.imgix.net/813a7bc2/uploads/origins/8197f9ff-e908-40ee-b291-b05b7c63feb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e269bc73fbb904fe5dfc864f6dc9235d 3x", "genre": "art", "nsfw": true, "body": "ahonobo先生、こんいちは！\nはじめまして、玖魔雪と申します。\n先生の絵は繊細で、いつも拝見させています。\n自分のOCについて、とびっきりエッチなやつをお願いしたいです！\n基本的にすべてお任せいたします。\nできれば軍手とゴーグルを残したいですが、邪魔だったらなしでも結構です。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1F8bfP3-58KhENJI84-JerSj4TP5FrYFK?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/11", "thumbnail_src": "https://si.imgix.net/780fade5/uploads/origins/50200cbf-fb48-4fbb-bc48-26f21a193b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70637b17d0a64ddf44da5809af87ff8d", "thumbnail_srcset": "https://si.imgix.net/780fade5/uploads/origins/50200cbf-fb48-4fbb-bc48-26f21a193b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70637b17d0a64ddf44da5809af87ff8d, https://si.imgix.net/780fade5/uploads/origins/50200cbf-fb48-4fbb-bc48-26f21a193b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=413425ff9cc441bff565c43f24aa25b9 2x, https://si.imgix.net/780fade5/uploads/origins/50200cbf-fb48-4fbb-bc48-26f21a193b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9f9658002d729d6e43e7108ef533d5a 3x", "genre": "art", "nsfw": true, "body": "こんにちは!最近、あなたの素晴らしいアートを見つけたので、リクエストをしたいと思っていました。\n\n2人のキャラクター。エルフと妖精。\nポーズと遠近法は2枚目の画像参考にして、ローアングルで後ろから見ています。\n妖精は妖精の上に横たわり、妖精は妖精の大きなお尻を両手で掴んでいます。\n妖精は大きく勃起していて、小柄な人がペニスの先端を掴んでいるだろう。妖精のペニスの先端は、小さな人をエルフの肛門に押し付けているでしょう。妖精の股間だけでなく、彼の足の間や地面の近くにも、他の小さな人がいるでしょう。\n妖精は興奮しているように見えますが、少し緊張しているようにも見えます。妖精は欲望にとらわれているように見えるでしょう。\n背景は森になるでしょう。\nそして、前にもあったように、妖精のペニスがエルフの肛門に小さな人を押し付けている横のどこかで、大きくクローズアップされた写真が撮れないだろうか？\n\nお忙しい中、ご検討いただきありがとうございましたm(_ _)m\n\nhttps://imgur.com/a/v39Ts9B", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/10", "thumbnail_src": "https://si.imgix.net/a76c100b/requests/256326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd693405e1f72a629b3580089ed49de4", "thumbnail_srcset": "https://si.imgix.net/a76c100b/requests/256326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd693405e1f72a629b3580089ed49de4, https://si.imgix.net/a76c100b/requests/256326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e921e14c863559b1364b65055ead6aab 2x, https://si.imgix.net/a76c100b/requests/256326_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cacea9d4f8504b9893974c17a933269 3x", "genre": "art", "nsfw": false, "body": "悠琴さんこんにちは、二人の男の子一緒にいるのイラストがお願いいします、用は最大限には自分用と限れます。姿勢と表情はうーるさん一番気楽のしてください。この上で人に幸せと快楽と感じれる絵なら一番素敵だと思います。\n具体的なキャラクターモデルはこちらです：\nhttps://weibo.com/5023532853/Jo9wFvua4?pcfrom=msgbox&type=comment#_rnd1602151909868\nこの中の 青いセーターを着ってる子　と　緑色スウェットを着ってる子、二人が一緒にいるの絵でお願いします。ありがとうございます。\n\nhttps://weibo.com/5023532853/Jo9wFvua4?pcfrom=msgbox&type=comment#_rnd1602151909868", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/9", "thumbnail_src": "https://si.imgix.net/fd6c1c4f/requests/208713_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=362930248f952ec3d53610b7f50cb848", "thumbnail_srcset": "https://si.imgix.net/fd6c1c4f/requests/208713_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=362930248f952ec3d53610b7f50cb848, https://si.imgix.net/fd6c1c4f/requests/208713_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d06ad038841e70af3e519828cb7e8954 2x, https://si.imgix.net/fd6c1c4f/requests/208713_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feced8e3745956f28a4695c5f84b39b1 3x", "genre": "art", "nsfw": true, "body": "ホーボー先生、こんにちは。\n\nあなたの幻想的な絵に興味を持ったので、XDに依頼しました。\n\n私のOC(URL付きですがラフスケッチのみ)をお願いしたいのですが、巨大な雪豹の毛皮です。アークナイツのワイフと同じ毛皮レベル。(人間のような手だが毛皮と爪があり、足は前足に置き換えられている)\n\n巨大な全裸になり、草むらの地面に膝をつき、性器を串刺しのように家の中に挿入し、その上に精液を滴らせる。その巨大な性器から2、3人の小さな人間が逃げ出している。\n\n彼の表情は絶対に \"悪戯 \"のためのものだ\n\nオプション：小さな人間をあざ笑う彼に言葉を添えていただけると非常に助かります～ JPは全く問題ありません!\n\nhttps://cdn.discordapp.com/attachments/690125402852950027/795505095537459250/qxlarge-dsc-FF2A4227F03444F4A9CBF42CCD55D7FE.png", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/7", "thumbnail_src": "https://si.imgix.net/485d45cc/requests/103314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9fe6ec161de23d56f7b7ef467731a1", "thumbnail_srcset": "https://si.imgix.net/485d45cc/requests/103314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9fe6ec161de23d56f7b7ef467731a1, https://si.imgix.net/485d45cc/requests/103314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01faf2c2cd2da34f48a766156ba451ed 2x, https://si.imgix.net/485d45cc/requests/103314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eedefb749bfbb1440ce629f74a0e3aa2 3x", "genre": "art", "nsfw": true, "body": "またかよ！\n\nお元気でお過ごしでしょうか!<3\n\nまたお願いしたいと思っていたのですが？^-^ 私は純粋にあなたの作品が大好きなので、我慢できません!お友達のワッフルも最後の作品が大好きでした！！(笑)\n\nアート自体については、アスターがまた下着姿で、彼の豊満な膨らみと汗で蒸れた体を見せつける作品ができないかと思っていたんです。彼の膨らみは、ガラスの壁のパースペクティブ（いわば「スクリーン」に押し付けられた膨らみ）に押し付けられているだろう。\n\nまたしても下着の中で、ワッフルは彼のズキズキとしたチンコとタマの中に押し込まれることになる。彼は、壁に押し付けられて、チンコの中に押し込まれたいのだ。\n\nあと、Photoshopのドキュメントの中に、個人的な使用のために検閲バーのオンオフを切り替えるレイヤーを追加できないかと思っていたのですが、どうでしょうか？^^\n\nジャイアント（アステール）。\nhttps://www.furaffinity.net/view/36511039/\nhttps://www.furaffinity.net/view/36511011/\n\nタイニー（ワッフル）。\n(ミドルフォーム) https://www.furaffinity.net/view/33771912/", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/6", "thumbnail_src": "https://si.imgix.net/8d278f56/requests/91392_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e0b47cbf6213bff850e48bf2404e36f", "thumbnail_srcset": "https://si.imgix.net/8d278f56/requests/91392_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e0b47cbf6213bff850e48bf2404e36f, https://si.imgix.net/8d278f56/requests/91392_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=033435f484b28f8a9727db9def765540 2x, https://si.imgix.net/8d278f56/requests/91392_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79422c1f9c8042913c025b9ae008fd86 3x", "genre": "art", "nsfw": false, "body": "またしてもこんにちは!\n\n私からの3つ目のリクエストを受けてくれないかな？私はそれが楽しいだろうと思ったし、私はあなたのアートスタイルを崇拝しています!\n\n前回のリクエストで、右上を拡大ズームインにしてくれたのが気に入ったので、今回も同じようなものが欲しいですね。\n\n私が考えていたリクエストは、アステールが靴下を履いて、ブーツを履いている（つま先が出ないように、ジッパーを開けてカバーしている）というものでした。アステールはどこかを歩いていますが、設定は自由です。\n\nサイドパネルには、汗まみれのソックスの底とブーツの中敷きの間に挟まれたトレースが表示されます。ブーツの中は、前回のアスターの下着の中の蒸れ方に似て、蒸れて汗ばんでいるでしょう。\n\nいつもながら、本当にありがとうございます！楽しんでくださいね。<3\n\n参考文献\n\nアスター（巨人）。\nhttps://www.furaffinity.net/view/36499797/\nhttps://www.furaffinity.net/view/36499768/\n\nトレース（タイニー）。\nhttps://drive.google.com/drive/folders/1-0SJfXmz2Pj4MahaLfFyOum1cWrkAMjE", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/5", "thumbnail_src": "https://si.imgix.net/b2f8ec38/requests/89405_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46636ef0d9fff673066239718bec4bef", "thumbnail_srcset": "https://si.imgix.net/b2f8ec38/requests/89405_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46636ef0d9fff673066239718bec4bef, https://si.imgix.net/b2f8ec38/requests/89405_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb1fc6d799c86b2e0429a0b07e164386 2x, https://si.imgix.net/b2f8ec38/requests/89405_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8324b2a94b0cab72b9c6ec3adbb1afc4 3x", "genre": "art", "nsfw": true, "body": "私は最近あなたのアートを見たので、すごいあなたのスタイルが大好きです！あなたはとても才能があります！キツネの少年のキャラクターと地雷の鹿のキャラクターの友達と一緒にコミッションを手に入れたいと思っていました。 ：3\n私のTwitterアカウント：https://twitter.com/TheColossalFox\n\n考え\n私の巨大なキツネの少年ローガンが小さな鹿の少年CallowClayの上に高さ1インチの高さのディックを持っているローアングルのローアングルの画像ディック。\nこの例のようなもの：https://i.imgur.com/ZUCctTk.png\n\n参照\nLoganGrey-ジャイアントフェムボーイフォックス\nhttps://i.imgur.com/Keg6vmz.png\nhttps://i.imgur.com/tTdANB8.png\nhttps://i.imgur.com/uymzDqL.png\nhttps://i.imgur.com/zocHYAN.png\n\nCallowClay-Tiny Micro Deer Boy（高さ1インチ）\nhttps://i.imgur.com/NeN10Dv.png\n\nよろしいですか？", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/4", "thumbnail_src": "https://si.imgix.net/9ed2280a/requests/89124_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1cfbf5442ca187bb801459a958d0d8f", "thumbnail_srcset": "https://si.imgix.net/9ed2280a/requests/89124_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1cfbf5442ca187bb801459a958d0d8f, https://si.imgix.net/9ed2280a/requests/89124_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=524dfc99f195e6cd0c283b96a6be8f10 2x, https://si.imgix.net/9ed2280a/requests/89124_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=948eba75fd504c4cbd873404ca9c9041 3x", "genre": "art", "nsfw": true, "body": "また会いましたね！ ^^\n\n私の最初の絵は本当に素晴らしかったと言いたかったので、どうもありがとう！それは私にとって世界を意味します！驚異的な仕事を続けてください！\n\n私はあなたから別の要求をすることができるかと思っていましたか？ ^^\n\nこの写真については、アスターがジムでエクササイズを終えてロッカールームのベンチに座っていたら良かったと思います。彼は下着だけに脱ぎ捨てられ、長いワークアウトから汗をかき、蒸し暑く、体を見せびらかします。\n\n彼の膨らみに対して固定されているのはワッフル（小さな）で、彼の銃口が十分に恵まれたユキヒョウの膨らみの奥深くに埋め込まれている間、非常に赤面して非常に波状になります。\n\nあなたは作品に望むだけの芸術的自由を持ち、これを検討してくれてありがとう！\n\n参照：\n\nアスター（巨人）\nhttps://www.furaffinity.net/view/36499768/\nhttps://www.furaffinity.net/view/36499797/\n\nワッフル（小さい）\nhttps://www.furaffinity.net/view/33771912/", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/3", "thumbnail_src": "https://si.imgix.net/98a9cc8a/requests/88013_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b384708e46195295ad319a5a3461254", "thumbnail_srcset": "https://si.imgix.net/98a9cc8a/requests/88013_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b384708e46195295ad319a5a3461254, https://si.imgix.net/98a9cc8a/requests/88013_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1f3ca35cd9ea70930411acabb6e0bad 2x, https://si.imgix.net/98a9cc8a/requests/88013_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a1643c195ac66d522677cd117a8274f 3x", "genre": "art", "nsfw": true, "body": "おい！ ^^\n\nジャイアントと小さなキューティーハニーで別の作品を描いて、あなたのアートスタイルを絶対に愛しているのを見ました！私に似たようなことができるかと思っていましたか？ ^^\n\n私はアスターが巨人であると考えていました、ズボンをはがし、下着を引き下げて、彼の露出された、恵まれたコックとボールを明らかにしました。ミナレスは小さく、その基部、高くそびえる胴回りの両側の足にまたがっています。\n\nアスターは独りぼっちで、ミナレスは赤面するでしょう。\n\nあなたは設定とすべてで好きなだけ楽しいことができます！私はあなたが何をするかを見てとても興奮しています！ ^^\n\n参考文献\n\nジャイアント（アスター）：\n脱衣-https://www.furaffinity.net/view/36511011/\n服を着た-https://www.furaffinity.net/view/36499797/\n\nタイニー（ミナレス）：\n脱衣-https://www.furaffinity.net/view/31916962/\n服を着た-https://www.furaffinity.net/view/31916972/", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/2", "thumbnail_src": "https://si.imgix.net/87a0ea75/requests/84314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c89ea2e6fe1a800fe5438dbf8e86278b", "thumbnail_srcset": "https://si.imgix.net/87a0ea75/requests/84314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c89ea2e6fe1a800fe5438dbf8e86278b, https://si.imgix.net/87a0ea75/requests/84314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=592e133f3732a548d70ea8c03a18ec2c 2x, https://si.imgix.net/87a0ea75/requests/84314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405df88f8baaeea8583556836df49ab7 3x", "genre": "art", "nsfw": true, "body": "巨大な男の子を描くことができますか？\n\n小さな狐の少年をいじめている巨大なマウス少年。キツネ少年は親指のサイズです。\n\nネズミの少年は足でフォックス少年をいじめています。ネズミの男の子はからかっていて独善的です。キツネの少年は赤面しています。\n\nどんな服装/状況でもOKです。マウスボーイは通常のサイズ、フォックスボーイは小さな/縮んだ\n\nケモノミ/動物の耳は大丈夫です。 https://www.dropbox.com/s/o0hc9lcdurml045/LuckyB%20kabedon.jpg\n\nhttps://www.dropbox.com/s/ii3wkjz4ymoav0l/references.png", "created_at": "", "completed_at": ""}, {"path": "/@aphonyovo/works/1", "thumbnail_src": "https://si.imgix.net/34741e20/requests/15570_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9b5f603ab7047d1b4dc8d504a5e539f", "thumbnail_srcset": "https://si.imgix.net/34741e20/requests/15570_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9b5f603ab7047d1b4dc8d504a5e539f, https://si.imgix.net/34741e20/requests/15570_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=578a279cc688d7b8a4f1967a74bc5654 2x, https://si.imgix.net/34741e20/requests/15570_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7090ce71b293b9992247238755ed18ab 3x", "genre": "art", "nsfw": true, "body": "おはようございます！キャラクターの絵をもらいたいです。彼はスペースエクスプローラーの猫で、非常に運動能力があり、Xiaoziという名前です。\n\nエクササイズ後にリラックスした彼の絵が欲しいのですが！\n\nhttps://imgur.com/a/kOOMOEk", "created_at": "", "completed_at": ""}]}