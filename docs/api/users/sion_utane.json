85c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b436f3862ef5c59f29c2d97f5fbef48c 3x", "genre": "art", "nsfw": true, "body": "連続リクエストは避けよう思ったのですが募集中とのことで手数料無料期間もありますのでご検討下さい。\n\nブルーアーカイブから春原シュンの輪姦モノをお願いします。\n\n胸が揉まれていてくれれば構図等は指定はありません。\nあとは特に言うことありません。\n\nかなり簡素な内容になりましたが可能ならお願いします。\n\nhttps://bluearchive.wikiru.jp/?HALO%E4%B8%80%E8%A6%A7#shanhaijing\n\nhttps://booth.pm/ja/items/4111846?srsltid=AfmBOord4Xl9ngEJ62iVjV6N2VWb1XNnoRu0NN6dTK4evFbrvvmm2z-K\n\nhttps://drive.google.com/drive/folders/10M5lyUleBHHqtcAd-v2PbrbEs1_eqQpp", "created_at": "", "completed_at": ""}, {"path": "/@sion_utane/works/20", "thumbnail_src": "https://si.imgix.net/4bef141a/uploads/origins/ed224d2b-9062-4a04-acbb-82c641942f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da1db6bf4053358b7198f5d93311b6d3", "thumbnail_srcset": "https://si.imgix.net/4bef141a/uploads/origins/ed224d2b-9062-4a04-acbb-82c641942f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da1db6bf4053358b7198f5d93311b6d3, https://si.imgix.net/4bef141a/uploads/origins/ed224d2b-9062-4a04-acbb-82c641942f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0225b83e3eef7ce29f186b8d388719ad 2x, https://si.imgix.net/4bef141a/uploads/origins/ed224d2b-9062-4a04-acbb-82c641942f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6f1c22a79534540ea3fd781491d5308 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sion_utane/works/19", "thumbnail_src": "https://si.imgix.net/18b2eb50/uploads/origins/3c5f52e0-8db1-4da2-b311-61ba15624840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=230e1840869bc0c22a6911511bdc0d73", "thumbnail_srcset": "https://si.imgix.net/18b2eb50/uploads/origins/3c5f52e0-8db1-4da2-b311-61ba15624840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=230e1840869bc0c22a6911511bdc0d73, https://si.imgix.net/18b2eb50/uploads/origins/3c5f52e0-8db1-4da2-b311-61ba15624840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a646c8ad3f3e65bbfe803018b261b40 2x, https://si.imgix.net/18b2eb50/uploads/origins/3c5f52e0-8db1-4da2-b311-61ba15624840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e8916e4ab22e92c1f99e17027fab5da 3x", "genre": "art", "nsfw": true, "body": "募集しているとのことだったので雑内容になりますがお願いします。\n\nかなり前に依頼したhttps://skeb.jp/@sion_utane/works/2\nの続き？別バージョン？をお願いします。\n\n妖怪に敗北したテンコが犯される～的な王道？な敗北シチュ\n\nテンコは大人姿の状態でお願いします。\n\n竿役に関しては前回の主人公のままでも構いませんし妖怪(異種姦的な)でも構いません。\n\nかなり雑な内容になりましたが可能ならお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sion_utane/works/18", "thumbnail_src": "https://si.imgix.net/d9495db4/uploads/origins/09007750-7b5b-42ad-bb68-a9051dc4625b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f5b27501d08ce07af32db05b4e2f6c4", "thumbnail_srcset": "https://si.imgix.net/d9495db4/uploads/origins/09007750-7b5b-42ad-bb68-a9051dc4625b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f5b27501d08ce07af32db05b4e2f6c4, https://si.imgix.net/d9495db4/uploads/origins/09007750-7b5b-42ad-bb68-a9051dc4625b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a06e5ff02f742e16e4bf26e9cae32c7d 2x, https://si.imgix.net/d9495db4/uploads/origins/09007750-7b5b-42ad-bb68-a9051dc4625b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75fdd8ee714f0ae53e34ace1cdb643c2 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nうちのこにてイラスト依頼させていただきます。\n\n\n■キャラ\n・金髪魔術師「サナ」\n\nこちらの衣装でお願いします。\nhttps://x.com/moryotton/status/1795469759733199246\n\n\n〇参考\n・過去skebで納品いただいたもの(別衣装版含む)\nhttps://skeb.jp/@munyamunyako/works/31\nhttps://skeb.jp/@ayuayu1192/works/398\nhttps://skeb.jp/@urute_/works/49\nhttps://skeb.jp/@wakatuki0508/works/15\nhttps://skeb.jp/@kujiran/works/125\nhttps://skeb.jp/@circussion/works/198\nhttps://skeb.jp/@circussion/works/201\n\n・セリフイメージ\nhttps://skeb.jp/@ushih_43/works/34\nhttps://skeb.jp/@sumari_r18/works/71\nhttps://skeb.jp/@sumari_r18/works/75\nhttps://skeb.jp/@ayuayu1192/works/398\nhttps://skeb.jp/@Agito_Teruya/works/37\n\n\n■シチュ、ポーズなど\n・竿役主観な交互ズリ\n\n・着衣状態はこれくらいな感じでお願いします\n(ドレス部分を脱がせ、装飾、長手袋、白ストールのみ)\nhttps://skeb.jp/@mozuya_m/works/26\n\n・女性優位シチュな雰囲気で、舌なめずり/ちょっとSな感じの表情\n\n・射精煽ってくる感じの意地悪な表情差分、乳内射精差分もお願いします\n\n\nその他記載のない部分はお任せいたします。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sion_utane/works/17", "thumbnail_src": "https://si.imgix.net/11e33723/uploads/origins/971fc54b-dd6f-454d-a99e-6e46b58b04e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7994f3c0552169489399f47c69f38efa", "thumbnail_srcset": "https://si.imgix.net/11e33723/uploads/origins/971fc54b-dd6f-454d-a99e-6e46b58b04e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7994f3c0552169489399f47c69f38efa, https://si.imgix.net/11e33723/uploads/origins/971fc54b-dd6f-454d-a99e-6e46b58b04e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1676b83f7aa1b5959b23f6aca13fd6c0 2x, https://si.imgix.net/11e33723/uploads/origins/971fc54b-dd6f-454d-a99e-6e46b58b04e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=111c8d94de2d3c07e02da476cbe1c8c2 3x", "genre": "art", "nsfw": true, "body": "ゆずソフトのPCゲームぶらばん！から雲雀丘由貴をお願いします。\n\n【シチュエーション】\n大河原 甚五郎という部活動顧問のおっさんと手下化したモブ竿部員達に2穴で挿されてチンポに囲まれて犯されている姿をお願いします。竿の顔は見切れていても大丈夫ですが、甚五郎が参加していると分かるように体格等の差別化をお願いします。可能であればチンポ等を黒海苔修正でお願いします。\n\n【衣装】\n乱れた制服姿でおっぱいが出ている状態。\n\n【差分】\n由貴の表情差分。\n中出しとぶっかけの射精差分をお願いします。\n\nご検討よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/ama95kb5t4hfc81ssphy9/AEe_2re91pZNNtEXDY9LMeM?rlkey=81rifdyswnum5mr2uwe91nkd3&st=smvx24ip&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@sion_utane/works/16", "thumbnail_src": "https://si.imgix.net/15fb82e2/uploads/origins/a14b83ec-fd4b-4175-bac4-c3f1f8958c16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b8ded5b925b1822c6b20371d3ff2c7c", "thumbnail_srcset": "https://si.imgix.net/15fb82e2/uploads/origins/a14b83ec-fd4b-4175-bac4-c3f1f8958c16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b8ded5b925b1822c6b20371d3ff2c7c, https://si.imgix.net/15fb82e2/uploads/origins/a14b83ec-fd4b-4175-bac4-c3f1f8958c16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65fc75452639a5c20adb3e3242fe36d7 2x, https://si.imgix.net/15fb82e2/uploads/origins/a14b83ec-fd4b-4175-bac4-c3f1f8958c16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ad424462dd3a1e5cd6294f13179579e 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\nあやかしランブル（あやらぶ）の夜叉丸さんのパイズリイラストをお願いしたいと思います\n構図：夜叉丸さんを正面からみた図\n服装：バニー衣装と胸が見えてるものの2種類\n差分：１挿乳２ズリズリ３乳内射精４ズリ事後\n　　　１～４の差分を服装分2種類お願いしたいです\n乳輪：お好きなサイズでお願いします!!!\n参考\nhttps://ul.h3z.jp/qljqqSIx.jpg\n\n差分が多くなりそうで申し訳ありません、その他細かいところはお任せいたしますよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sion_utane/works/15", "thumbnail_src": "https://si.imgix.net/44170bea/uploads/origins/102c276c-140d-4d51-829f-4fe59413105a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8641e8a709d8472ad7e55338e02050f9", "thumbnail_srcset": "https://si.imgix.net/44170bea/uploads/origins/102c276c-140d-4d51-829f-4fe59413105a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=