-a6b7-a6c32e7869e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc08f622b5cee72ba9637a8fe2927844 2x, https://si.imgix.net/f2a0a232/uploads/origins/278055fc-6932-4651-a6b7-a6c32e7869e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99c69e14127132e66da7c01a8da26d3d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、Luna様のポケモン×キャラクターのイラストに心惹かれました！\n\nこの度は、個人Vtuberの　甘狼このみ(@AmakamiKonomi)さん　と　このみさんの推しポケモンのサザンドラが一緒に写ってるイラストをリクエストいたします。\n\n使用用途は、\nご本人様へのプレゼント\nご本人様に限りの配信活動（配信内や、配信のサムネ、Twitter等で使用する可能性があります　※Youtube収益化済み）での使用許諾を頂きたいです。\n\n可能であれば、背景透過のデータもいただければと思います。\n\n構図イメージ\nポーズや表情、衣装などは、すべてお任せいたします。\n\n金額等の不備がございましたら、再送要求頂けると幸いです。\nどうかご検討のほど宜しくお願いいたします。\n\n参考資料\nhttps://lit.link/amakamikonomi\nhttps://twitter.com/AmakamiKonomi\nhttps://zukan.pokemon.co.jp/detail/0635", "created_at": "", "completed_at": ""}, {"path": "/@luna_mokamoka/works/14", "thumbnail_src": "https://si.imgix.net/910c1250/uploads/origins/aad6a176-e2f8-46f4-83d8-b85f32c38cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c2ba0ed6f9c8cb27a9609891377e51a", "thumbnail_srcset": "https://si.imgix.net/910c1250/uploads/origins/aad6a176-e2f8-46f4-83d8-b85f32c38cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c2ba0ed6f9c8cb27a9609891377e51a, https://si.imgix.net/910c1250/uploads/origins/aad6a176-e2f8-46f4-83d8-b85f32c38cad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cf8c4ac52caf14de8b85cd528af6bb1 2x, https://si.imgix.net/910c1250/uploads/origins/aad6a176-e2f8-46f4-83d8-b85f32c38cad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=457587ca79942de13d86d7f3b6b37464 3x", "genre": "art", "nsfw": false, "body": "美しいイラストの数々拝見させて頂いております。この度ポケモンのイラストをリクエストさせて頂きます。\n\n満月の夜空をバックに相思相愛のアーマーガアとラティアスのツーショットをお願いします。\n\nアーマーガアに頬擦りするラティアスと、ラティアスを大きな翼で抱き寄せるアーマーガア、という構図でお願いします。\n\nこの二匹のポケモンが大好きなのでぜひ描いて頂きたいです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@luna_mokamoka/works/13", "thumbnail_src": "https://si.imgix.net/391a1f68/uploads/origins/8f601509-f3bd-47b4-9015-c1498f4b5e15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1132f8e366b9e02dde20ad7326a0576f", "thumbnail_srcset": "https://si.imgix.net/391a1f68/uploads/origins/8f601509-f3bd-47b4-9015-c1498f4b5e15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1132f8e366b9e02dde20ad7326a0576f, https://si.imgix.net/391a1f68/uploads/origins/8f601509-f3bd-47b4-9015-c1498f4b5e15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d00bb67c1f32fba0c0c7fd2be1b4f8fc 2x, https://si.imgix.net/391a1f68/uploads/origins/8f601509-f3bd-47b4-9015-c1498f4b5e15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=704f430fa94f6fc481c9267f68d1a97b 3x", "genre": "art", "nsfw": false, "body": "はじめまして＊Luna＊様\n新着で拝見したポケモンとキャラクターイラストの雰囲気がとても好みでしたので依頼させていただきます。\n\n依頼内容は私の作成したOCとライボルトのイラストです。\n・キャラクター名：汐音（しおね）\n・年齢：22歳\n・身長：141ｃｍ\n・体重：39ｋｇ\n・職業：大学院生\n・デザインイメージ\nhttps://imgur.com/a/o9TXymc\n・キャラクター特徴\n　いつも研究室で何かしらの資料を見ていて目の下には軽いクマが常にある。\n目が悪いせいで目つきが悪くなり、本人のぶっきらぼうな言動も相まって周囲からはあまり良く見られていないが、反面面倒見が良く、実際に話した人からの評価は良い。\n子供舌でアルコールやたばこなどは苦手だが、棒つき飴を舐めたりノンアルの子供用ビールを常飲しているせいで周囲からまた誤解されている。\n\nシチュエーションはライボルトと並び立ちまさにパートナーというようなたたずまいの汐音とライボルトを描いていただきたいです。\n服装や表情に指定はありませんので＊Luna＊様がいいと思ったものがあれば好きに差し替えていただいて構いません。\n\n長々となりましたがどうぞよろしくお願いいたします。\n\nhttps://imgur.com/a/o9TXymc", "created_at": "", "completed_at": ""}, {"path": "/@luna_mokamoka/works/12", "thumbnail_src": "https://si.imgix.net/5758efe7/uploads/origins/64e4b12a-d16a-4478-aba0-68e920a73547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d88b1b4eccb81cfcd7adcbf250ffb8e5", "thumbnail_srcset": "https://si.imgix.net/5758efe7/uploads/origins/64e4b12a-d16a-4478-aba0-68e920a73547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d88b1b4eccb81cfcd7adcbf250ffb8e5, https://si.imgix.net/5758efe7/uploads/origins/64e4b12a-d16a-4478-aba0-68e920a73547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cd34f120299fb72672474bedab8d4e9 2x, https://si.imgix.net/5758efe7/uploads/origins/64e4b12a-d16a-4478-aba0-68e920a73547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1469b88ab635b38d2988df95abe46695 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きです！私の友人と私のキャラクターのイラストをお願いしたいと思っていました。二人が一緒に芝生の上で星を見上げているようなイラストを希望します。私は両方のキャラクターだけでなく、あなたのためのすべてのリファレンスアートを提供します。私のキャラクターは森の精霊で、友人は悪魔です。\n\n ご検討よろしくお願いします\n\nhttps://twitter.com/moonandstars120/status/1608495775335710721", "created_at": "", "completed_at": ""}]}