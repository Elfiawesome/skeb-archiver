aa7-4f79-9729-6c02686d9f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7246e5ccfd4d0331bee1c9c7dbe2a92, https://si.imgix.net/b1690333/uploads/origins/db620a4c-8aa7-4f79-9729-6c02686d9f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d22ac5d0cffdbb983c8ecc1ab50ac97 2x, https://si.imgix.net/b1690333/uploads/origins/db620a4c-8aa7-4f79-9729-6c02686d9f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d237199df047b59a23bf2b0a9065534 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Koye0cnGMa/works/3", "thumbnail_src": "https://si.imgix.net/9117e1c0/uploads/origins/f58e9804-c662-4afb-9004-b74c60ca7549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a8931e5ba7e3f686fb8b5e7208af871", "thumbnail_srcset": "https://si.imgix.net/9117e1c0/uploads/origins/f58e9804-c662-4afb-9004-b74c60ca7549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a8931e5ba7e3f686fb8b5e7208af871, https://si.imgix.net/9117e1c0/uploads/origins/f58e9804-c662-4afb-9004-b74c60ca7549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=008da6502624f301b6018641b18f93e8 2x, https://si.imgix.net/9117e1c0/uploads/origins/f58e9804-c662-4afb-9004-b74c60ca7549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0a749089a1c47cec95df9fc8943bd79 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nもしよければ下記をお願いします。\n\n■キャラ\nクリミアとロマニー(ゼルダの伝説ムジュラの仮面)\nクリミアはナイスボディなお姉さん体系で、\nロマニーはショタに近いくらいに胸が平らなペタンコ。\n(胸囲の格差みたいなのが好きなのでメリハリ効いていると嬉しいです)\n\n■シチュ\n特製のミルク(母乳)を作るためゴーマン兄弟に家畜のように犯される的なシチュ。\nざっくり下記のリンク先の絵のようなイメージで、\n二人並んで拘束されてバックで突かれているような感じです。\nなお、母乳や搾乳機の有無はおまかせですが、\n有りの場合はクリミア側は母乳が出るけど、\nマロン側は幼すぎて全く出ない形でお願いします。\nまた、表情はおまかせで快楽系もハードめで可哀そう系も大丈夫です。\nhttps://www.pixiv.net/artworks/115028340\nhttps://www.pixiv.net/artworks/116234480\nhttps://www.pixiv.net/artworks/86261963\n\nその他、全般おまかせします。\n内容の調整や、要素を付け加えるなど自由に描いていただけたらと思います。\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Koye0cnGMa/works/2", "thumbnail_src": "https://si.imgix.net/af30e93d/uploads/origins/85d5fffe-379c-44ae-8383-840b80367d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8f9ea93c5f25a20d2b3b1e087491d7", "thumbnail_srcset": "https://si.imgix.net/af30e93d/uploads/origins/85d5fffe-379c-44ae-8383-840b80367d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8f9ea93c5f25a20d2b3b1e087491d7, https://si.imgix.net/af30e93d/uploads/origins/85d5fffe-379c-44ae-8383-840b80367d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=449accf8fa00500f9f620885c8fa5225 2x, https://si.imgix.net/af30e93d/uploads/origins/85d5fffe-379c-44ae-8383-840b80367d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0a812a031b592b9d4d7acb197762058 3x", "genre": "art", "nsfw": true, "body": "書くかも程度ですがドM小説の挿絵に利用したいです\n作品名：ゼルダの伝説\nシチュ：\n着衣超魔乳&着衣ボテ腹姿のマロン(青年時代)に侮蔑されながら咥内触手挿入によるアナル・前立腺責めを、\n着衣超魔乳&着衣ボテ腹姿のクリミアに嫌悪されながら超魔乳パイズリでM男が大量搾精されるドMホイホイシチュ\n二人ともゴミを見る冷めた目(顔の上部や目元まで影がかかりハイライトなし)で、変態ドM男への嫌悪感を一切隠さない侮蔑の表情希望です\n女の子達の表情がわかる構図で、構図的に隠れてしまう子は表情別コマ形式でお願いします\n\n二人とも全身がどろどろの粘液で濡れて、服が肌にぴったりと張り付いており、置くだけで両手が沈む程柔らかく片乳だけでも両腕で抱え込めず、頭&胴体以上のサイズかつ服越しにピンク色勃起乳首がわかる超魔乳&特大着衣ボテ腹が衣装の中にギチギチに押し込まれ強調されており、\n超乳と着衣ボテ腹内部に粘液まみれの触手を孕み、内部で大量の触手で蠢き外から見ても歪に変形している描写と、腹部に怪しく光る妊娠淫紋が可能なら希望します\n\n男性はペニスをモザイク不要で丸呑みにするサイズのパイズリとアナルを責める触手（可能なら前立腺を責めるアナル断面図希望)の快感に必死で耐えようとするも、抵抗虚しく射精させられて腰をガクガクさせ、\n花のように開いたブラシor吸盤触手と超魔乳で股間とお尻を前後からがっちり固定(特にお尻の肉にエッチな風に食い込む感じで)され、男が絶対に快感から逃げられない描写希望です\nまたこの際M男には一切の苦痛なく純粋な快感のみ刻み込まれる設定希望です\n\nまた優先度最低で無視して頂いても構いませんので男性もマロンの咥内触手挿入により腸内で蠢く触手で淫紋付き特大ボテ腹に改造されており、\n内部で触手が蠢き特大ボテ腹が波打っている表現が可能なら希望します(ボテ腹部は断面図なし)\n\n背景は触手肉壁か禍々しい系、psd形式希望で高粘度の粘液まみれの肉塊&粘液まみれの触手が蠢く水音(効果音)の有無、瞳のハイライト&顔上部の影の有無差分希望\n優先度低で台詞等の詳細はお任せしますので異形の触手の前立腺責めで射精する変態マゾを「最低」「人間の屑」「気持ち悪い」等と罵倒・侮蔑台詞有無差分と、M男は老いも死も許されず永遠に彼女たちと共に触手繁殖のための苗床に改造されてしまうことを示唆する台詞希望です\n参考：\n\nhttps://drive.google.com/drive/folders/1fxuEgS9ePNFuRdtff864Az03XTR2RwLZ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Koye0cnGMa/works/1", "thumbnail_src": "https://si.imgix.net/a999a88c/uploads/origins/2b08fe78-8f30-415e-81c8-82b41aa817a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9085882e8e6ee67bcd96455d27e4f9a6", "thumbnail_srcset": "https://si.imgix.net/a999a88c/uploads/origins/2b08fe78-8f30-415e-81c8-82b41aa817a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9085882e8e6ee67bcd96455d27e4f9a6, https://si.imgix.net/a999a88c/uploads/origins/2b08fe78-8f30-415e-81c8-82b41aa817a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee2108044078da6b2a45d612593ac4db 2x, https://si.imgix.net/a999a88c/uploads/origins/2b08fe78-8f30-415e-81c8-82b41aa817a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a85165a1bfe1605b4d37eff2aa2fc137 3x", "genre": "art", "nsfw": true, "body": "書くかも程度ですがドM小説の挿絵に利用したいです\nキャラ名：フェンリース、リヴィア\nシチュ：\nリヴィアに嫌悪・侮蔑されながら、淫紋付き特大ボテ腹苗床に改造された男がアナルから全身が羊水で濡れたフェンリースを(スカートや太腿より上まで)出産するドMホイホイシチュ\n男性のボテ腹は女体一人が入っている特大サイズ&余裕があれば妊娠淫紋つきで、一切の苦痛なくただ出産の快楽に悦び絶頂に身を震わせている様子をお願いします\n二人ともゴミを見る冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし)で、変態マゾへの嫌悪を一切隠すことない侮蔑の表情希望です\n\n可能でしたら全員(特に産み落とされた直後のフェンリースは服が肌にぴったり貼りつく描写希望)全身や衣服が羊水で濡れている様子で、\n二人とも着衣超乳は服越しの(フェンリースはピンク色の透け)勃起乳首がわかる+両手が簡単に沈み、超乳片方だけでも両腕で抱え込めず、頭&胴体以上のサイズで、それら超乳と同じサイズの特大着衣ボテ腹(淫紋付き)希望です\n\nM男は女体一人入りの特大サイズ&妊娠淫紋つきボテ腹で出産時の一切の苦痛やダメージはなく前立腺への快感で(肉塊内に)大量射精し、\n男のペニスや玉袋など股間を卵の役割を果たす肉塊はモザイク不要レベルで完全に覆って内部でペニスを嫐り\n出産時の際に強烈な刺激での大量射精で、射精後のコンドームのようなイメージで肉塊卵の先端が膨らみ、超乳に負けないレベルの精子水風船ができている描写希望です\n\n背景は肉壁orダーク系、psd形式で各キャラの瞳のハイライト、顔上部の影の有無の切替差分、アナルから女体がずるっと這い出す効果音等差分と\n優先度低で出産途中として、M男のアナルからフェンリースの片腕だけ出ている切替可能差分及び射精の有無差分と\n更にキャラの性格や口調等お任せで、快楽のために擬態肉塊を孕む苗床として自らアナルを捧げ、妊娠・出産する変態マゾ男への嫌悪感MAXの罵倒・侮蔑と現在出産中の女性以外にもM男は何百人も美少女を妊娠・出産しており、\n老いも死も赦されずこれからもお望み通りの超乳&ボテ腹美少女ばかり永遠に孕まされアナル出産させられる設定でマゾ豚苗床と嫌悪・侮蔑する台詞希望です\nまた出産した女性キャラが外で同じように男を襲い苗床を増やしていくという説明に興奮するM男を侮蔑する様子も希望です\n\n参考：\n\nhttps://drive.google.com/drive/folders/1AEbaHAfTef7qfIBO5IDMY-M0eC3xD-Fs?usp=sharing", "created_at": "", "completed_at": ""}]}