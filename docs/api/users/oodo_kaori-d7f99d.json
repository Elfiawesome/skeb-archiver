e5f/uploads/origins/d2e95c25-5a8b-4f46-8e0b-75535e921d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18ca7895f9c3a29f51395604baf7fb11, https://si.imgix.net/335a4e5f/uploads/origins/d2e95c25-5a8b-4f46-8e0b-75535e921d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a37b9ea09c68a423e868f0c7dfaa2d00 2x, https://si.imgix.net/335a4e5f/uploads/origins/d2e95c25-5a8b-4f46-8e0b-75535e921d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2b37e376a0e30c8f5ccfbb4115526cb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/13", "thumbnail_src": "https://si.imgix.net/afefd4ee/uploads/origins/3f5b3636-9e3e-4247-a5b6-b942a96001be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f690e920ce907eddc586f53d5f671c", "thumbnail_srcset": "https://si.imgix.net/afefd4ee/uploads/origins/3f5b3636-9e3e-4247-a5b6-b942a96001be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f690e920ce907eddc586f53d5f671c, https://si.imgix.net/afefd4ee/uploads/origins/3f5b3636-9e3e-4247-a5b6-b942a96001be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=690294eb5d4c4ccbea6f2e260e983260 2x, https://si.imgix.net/afefd4ee/uploads/origins/3f5b3636-9e3e-4247-a5b6-b942a96001be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaa824dc1a996df19eb436cc7bd47c36 3x", "genre": "art", "nsfw": false, "body": "カオリちゃん！お疲れ様です！\nお誕生日キャンペーンありがとうございます、助かります、ご依頼させていただきます！\n\n今回もほぼお任せでぶん投げちゃいます…ｺﾞﾒﾝﾅｻｲ\nお洋服について通常衣装でもいいですし、着せてみたいお洋服とかあったら…それを着させてください🐰✨\n髪型も自由に改変してもらって良きですが、お耳(人間耳)の部分は髪で隠してください👀\n構図は…お任せでもいいですか…？\n\n◆使用用途\nSNSのアイコンやツイート、およびYoutube配信でのサムネイル等での利用\n(チャンネルの収益化済み)\n\n◆要望\nサムネイル等に使用予定の為、背景や文字等がある場合は、透過差分もいただけますとありがたいです…！\n\n是非是非、よろしくお願いいたします💞\n\nhttps://twitter.com/NorausagiUsagi/status/1642218411425157120", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/12", "thumbnail_src": "https://si.imgix.net/f006cab8/uploads/origins/3481ea50-0bc9-4c1b-b87f-3276af07e230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b341d59e5b9faf76856c5b02343109", "thumbnail_srcset": "https://si.imgix.net/f006cab8/uploads/origins/3481ea50-0bc9-4c1b-b87f-3276af07e230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b341d59e5b9faf76856c5b02343109, https://si.imgix.net/f006cab8/uploads/origins/3481ea50-0bc9-4c1b-b87f-3276af07e230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1352a8831b35b205c19e91571c46df4 2x, https://si.imgix.net/f006cab8/uploads/origins/3481ea50-0bc9-4c1b-b87f-3276af07e230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd04bb5ef0ff57dccb4fbd49201d3cfd 3x", "genre": "art", "nsfw": false, "body": "1枚目：バーでワイングラスをこちらにすすめてくれる、かなり大人っぽい大戸カオリ\n\n2枚目：1枚目のセリフありバージョン\nセリフ自由だが、必ず下記のセリフを入れること\n\n「やあ　ようこそ、バーボンハウスへ\nこのテキーラはサービスだから、まず飲んで落ち着いて欲しい」", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/11", "thumbnail_src": "https://si.imgix.net/1bed059d/uploads/origins/5ff1f5c3-dde4-49da-9366-35e34b5cb221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb208d9af7b3d969a0e0cb8d6175e695", "thumbnail_srcset": "https://si.imgix.net/1bed059d/uploads/origins/5ff1f5c3-dde4-49da-9366-35e34b5cb221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb208d9af7b3d969a0e0cb8d6175e695, https://si.imgix.net/1bed059d/uploads/origins/5ff1f5c3-dde4-49da-9366-35e34b5cb221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40f4726d86386e7cf7b768384cfdd225 2x, https://si.imgix.net/1bed059d/uploads/origins/5ff1f5c3-dde4-49da-9366-35e34b5cb221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f54378142bf73ed0164888e536ccca 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\n白峰 雪人です。\n\n今回は女体化の方の雪子を描いていただきたく、\nご依頼させていただきます。\n\nデザインについては以下です。\nhttps://drive.google.com/file/d/1RiQXvcSOy06yPTKveGOVl0lHgduIxdPq/view?usp=drive_link\n\n衣装については小悪魔系サキュバスっぽい衣装でお願いしたく存じます。\n肌の露出度合いについては遠慮無くしていただいて結構です。\n構図などもお任せいたします。帽子やギターなどはオミットしていただいても結構です。\n\n利用用途はTwitterやYoutubeのサムネイルで利用させていただきます。\n以上、何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/10", "thumbnail_src": "https://si.imgix.net/800efdb7/uploads/origins/c7a97d50-3490-4096-9695-a0b02a87c209?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7257e19803e2924069ec7062c019f2f", "thumbnail_srcset": "https://si.imgix.net/800efdb7/uploads/origins/c7a97d50-3490-4096-9695-a0b02a87c209?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7257e19803e2924069ec7062c019f2f, https://si.imgix.net/800efdb7/uploads/origins/c7a97d50-3490-4096-9695-a0b02a87c209?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd963c2b55cbd8495a24f19456fe7945 2x, https://si.imgix.net/800efdb7/uploads/origins/c7a97d50-3490-4096-9695-a0b02a87c209?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=688ad3e1c6ac76ee2deddb0baa8482d1 3x", "genre": "art", "nsfw": false, "body": "びっくりするほどユートピアをする大戸カオリ（服装自由・小道具（布団叩きや孫の手）自由）", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/9", "thumbnail_src": "https://si.imgix.net/b8e5be81/uploads/origins/f77fdf2e-072b-4260-9ce8-e0b354969e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b04c2503989b090eacde426df657f0e6", "thumbnail_srcset": "https://si.imgix.net/b8e5be81/uploads/origins/f77fdf2e-072b-4260-9ce8-e0b354969e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b04c2503989b090eacde426df657f0e6, https://si.imgix.net/b8e5be81/uploads/origins/f77fdf2e-072b-4260-9ce8-e0b354969e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa3cd00990e705c5e6ab76658e532c43 2x, https://si.imgix.net/b8e5be81/uploads/origins/f77fdf2e-072b-4260-9ce8-e0b354969e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34985b2cde34791103eaeb23bdd12caa 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です、栃宮シンです。\nいつもお世話になっております。\nこの度、カオリさんにskebの依頼をさせて頂きます。\n\n\n・使用用途\nイラストに合わせた配信(主に雑談)のサムネイル及び雑談配信中の立ち絵に使用。\nX(旧Twitter)での挨拶などの呟きに使用。\nなお、ご迷惑でなければ配信や動画での使用の際には必ずお名前を記載致します。\n\n・イラストの構図\n栃宮シンが相棒の４羽のペンギン達と一緒に逆転裁判と言うゲームの代名詞である「意義ありっ！」のようなポーズをしているイラストを希望します。\nペンギン達のデザインは資料URLからご確認お願いします。\n\n意義あり！のイラストイメージはこちらです(ページ上部のスーツを着た男性になります)。\nhttps://dic.nicovideo.jp/a/%E7%95%B0%E8%AD%B0%E3%81%82%E3%82%8A%21\n\n\n・イラストの詳細\n1.ペンギン達と一緒に写る為、栃宮シンはバストアップのイラストでお願い致します。\n\n2.ペンギン達は横並びに並んで全員が意義ありのポーズと同じ様に腕をビシッと突き出している構図です。\nなお、ペンギン達の並び順は特に気にしていないので描きやすい並び順で構いません。\nペンギン達の配置位置は脇腹から人差し指の先までをイメージしてます。\n\n3.背景は特に気にしていないので大丈夫です。\n\n4.栃宮シンとペンギン達の表情は題材のように、意義あり！と言っているような顔でお願いします。\nペンギンで表情がつけづらいのがあれば無理せず描きやすい表情にしても大丈夫です。\n\n5.ペンギン達をそれぞれレイヤーで分けて頂けると嬉しいです。\n\n6.サインを描く際レイヤーは文字ありと文字なしに分けて頂けると助かります。\n\n7.イラストに描く栃宮シンの衣装は青いパーカーの衣装ではなく黒いズボンを履いた方の衣装でお願い致します。\nお手数ですが、資料URLから確認よろしくお願いします。\n\n6.ファイル形式はJPG、サイズは2894px × 4093pxを希望しますが難しいようであればカオリさんの都合が良いサイズに変更しても大丈夫です。\n\n以上になります。\n判りづらく伝わり辛い部分もあるとは思いますが期間は特に気にしていないので、\n何卒宜しくお願い致します。\n\nhttps://twitter.com/tochimiya_shinn/status/1613715059578146818", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/8", "thumbnail_src": "https://si.imgix.net/38dc868e/uploads/origins/776ef3aa-06bb-4b75-9a0b-b40e5f633db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fe60b996f8bbbf95d1d89837095d99d", "thumbnail_srcset": "https://si.imgix.net/38dc868e/uploads/origins/776ef3aa-06bb-4b75-9a0b-b40e5f633db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fe60b996f8bbbf95d1d89837095d99d, https://si.imgix.net/38dc868e/uploads/origins/776ef3aa-06bb-4b75-9a0b-b40e5f633db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dba0dc57e0d5aed8b2fdad828ca8982 2x, https://si.imgix.net/38dc868e/uploads/origins/776ef3aa-06bb-4b75-9a0b-b40e5f633db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f0acf74d93b9d8fe274f420f3dd5a4e 3x", "genre": "art", "nsfw": false, "body": "姫蟻エイルのイラストをお願いします。\n通常の依頼優先とのことですので、間に合うのであれば季節を取り入れたハロウィンに合うようなイラストをお願いしたいです。\n先々になるのでしたら、その先のクリスマスイラストをお願いしたいです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/7", "thumbnail_src": "https://si.imgix.net/6cd9fa9b/uploads/origins/149d8efe-c337-4690-9a4f-bce14dd321b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f761adf7bafe76abae50ea0cbeb191", "thumbnail_srcset": "https://si.imgix.net/6cd9fa9b/uploads/origins/149d8efe-c337-4690-9a4f-bce14dd321b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f761adf7bafe76abae50ea0cbeb191, https://si.imgix.net/6cd9fa9b/uploads/origins/149d8efe-c337-4690-9a4f-bce14dd321b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a1bfb3f327834ac818f847e5dc94c98 2x, https://si.imgix.net/6cd9fa9b/uploads/origins/149d8efe-c337-4690-9a4f-bce14dd321b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5850cdf8ba3ee82018f941c0024be51 3x", "genre": "art", "nsfw": false, "body": "初めまして、個人Vtuberをやらせていただいております楽々園ナタリー・ポートピアと申します。\n今回は配信サムネ用のイラストの依頼をしたく依頼させていただきました。\n立ち絵が２種類あるのですがお好きな方を描いて頂けるとありがたいです。\n\nhttps://twitter.com/natalie_raku2/status/1606936666341789696", "created_at": "", "completed_at": ""}, {"path": "/@oodo_kaori/works/6", "thumbnail_src": "https://si.imgix.net/bca47c04/uploads/origins/979a76a5-77f4-4ed6-8107-cbf01abfc4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f108d146132bf