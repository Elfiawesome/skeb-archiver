://si.imgix.net/a0553dd3/uploads/origins/c606c5ab-beb6-4c7f-9354-d9389989bcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95522a71fe767ef10eeb02bf36abaeec", "thumbnail_srcset": "https://si.imgix.net/a0553dd3/uploads/origins/c606c5ab-beb6-4c7f-9354-d9389989bcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95522a71fe767ef10eeb02bf36abaeec, https://si.imgix.net/a0553dd3/uploads/origins/c606c5ab-beb6-4c7f-9354-d9389989bcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21eeeedfda31f52ad54d931aebe208c9 2x, https://si.imgix.net/a0553dd3/uploads/origins/c606c5ab-beb6-4c7f-9354-d9389989bcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03351e7d505dd1c98d211e6ab9ff4234 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートワークはとてもかわいいです！私のキャラクターを動物の姿で一緒に描いていただけたら嬉しいです！\n\nキューピッド：性別は問いません。ピンク、白黒、三毛猫。無表情なことが多い。風俗ビルを経営している。\nTu'er : 茶色のウサギのオス。とても紳士的で、しばしばプロフェッショナルな笑みを浮かべている。執事をしている。\nReign ：雄の黒いカラス。無表情か怒りっぽい。\nEricka : メスの子鹿。近距離近接格闘家。とても明るく元気。\n\nhttps://drive.google.com/drive/folders/1I2wtohJ1yhx2VU23t--50jhjHptnh33m?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@huyunosabu/works/2", "thumbnail_src": "https://si.imgix.net/ab6ec8e7/uploads/origins/d5f33358-dbe3-41c2-9546-0c726438c268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e19f557bb7c875c1567d73c3d2562fc", "thumbnail_srcset": "https://si.imgix.net/ab6ec8e7/uploads/origins/d5f33358-dbe3-41c2-9546-0c726438c268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e19f557bb7c875c1567d73c3d2562fc, https://si.imgix.net/ab6ec8e7/uploads/origins/d5f33358-dbe3-41c2-9546-0c726438c268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2068950505c6aa7da639734b4d8cbc9 2x, https://si.imgix.net/ab6ec8e7/uploads/origins/d5f33358-dbe3-41c2-9546-0c726438c268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&