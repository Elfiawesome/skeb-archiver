%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d47ab4391ded63edb899163e832eaef 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@laze0220/works/19", "thumbnail_src": "https://si.imgix.net/b39cf4a1/uploads/origins/dd6947ae-bd7d-407d-9de9-6bdd123d2aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13cfc4eb7cce1ff33f7efcb2c233ef51", "thumbnail_srcset": "https://si.imgix.net/b39cf4a1/uploads/origins/dd6947ae-bd7d-407d-9de9-6bdd123d2aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13cfc4eb7cce1ff33f7efcb2c233ef51, https://si.imgix.net/b39cf4a1/uploads/origins/dd6947ae-bd7d-407d-9de9-6bdd123d2aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9016761b7333085cf4d48ee1c2573193 2x, https://si.imgix.net/b39cf4a1/uploads/origins/dd6947ae-bd7d-407d-9de9-6bdd123d2aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4aab7656f90b69bf5bdd41561bb51ac9 3x", "genre": "art", "nsfw": false, "body": "初めまして。IRIAMでVライバーとして活動している電波みぃむと申します！\nレイズ様のskeb募集ツイートを拝見させて頂き、是非依頼したいなと思いリクエストを送らせて頂きました、ご検討よろしくお願いします！\n\n『お願いしたいイラスト』\n寝起きでぽわぽわしてる様なイラストをお願いしたいです！\n衣装で部屋着のものがありますので、そちらの衣装を着せて頂けると嬉しいです。\n少し肌色多めでお願いしたいです！\n\n『使用用途』\n・Xでのイラスト公開\n・リスナー様へのスマホ壁紙\n・収益化済み配信でのサムネイル使用\n\n『キャラクター概要』\n・赤髪おさげ三つ編み\n・稲妻型のアホ毛\n・貧乳\n\n【https://x.com/denpano_sub/status/1913287157089009815】\n\nskebにあまり慣れていない為、文章、金額などに問題がありましたら再送して頂けると幸いです。\nご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@laze0220/works/18", "thumbnail_src": "https://si.imgix.net/5c172aee/uploads/origins/d87acf1d-7068-4276-b25c-fdf88a1dc588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f591890010a14fd1757cda9d8592e8", "thumbnail_srcset": "https://si.imgix.net/5c172aee/uploads/origins/d87acf1d-7068-4276-b25c-fdf88a1dc588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f591890010a14fd1757cda9d8592e8, https://si.imgix.net/5c172aee/uploads/origins/d87acf1d-7068-4276-b25c-fdf88a1dc588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=908c1acae09a169da32174bb5b4397c0 2x, https://si.imgix.net/5c172aee/uploads/origins/d87acf1d-7068-4276-b25c-fdf88a1dc588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1931122b8b9f5ce9a87dc1a2a22e6167 3x", "genre": "art", "nsfw": false, "body": "宇佐見レイズ様\n\n初めまして、個人VTuberの夢兎のんと申します。\n宇佐見レイズ様のふんわりとした雰囲気の素敵なイラストを拝見し、ぜひ私自身を書いて頂きたくリクエストを送らせて頂きました！\n以下に詳細を記しますので、お手隙の際にご確認いただけますと幸いです。\n\n\n使用用途→Xでの利用、収益化済YouTubeでの利用、収益の入らないネットプリント\n\n詳細→1.5周年記念イラスト\n髪型→ツインテールの方\n構図→記念日感が伝わるような感じでお任せさせていただきたいです。可能でしたら、参考資料のうさちゃんをどこかに入れていただきたいです。\n\nキャラクター情報\n髪色→茶髪に薄紫のインナーカラー\n目→瞳孔に星、ハイライトに月や星など\n見えずらい部分のみ書かせて頂きました。詳しくは添付する三面図を参考にお願いいたします。\n性格→宇宙一のエンターテイナーになるために月からきたうさぎ。楽しいことと面白いことが大好きでよく笑う。\n\nお願い→サムネイルなどに利用するため、頭や洋服の端が見切れないようにして頂きたいです。\nまた、背景がある場合は背景透過の素材や、背景、サインなどレイヤー分けされたものをお願いしたいです。\n\n\nお忙しいところ恐れ入りますが、ご検討よろしくお願いいたします。\nhttps://drive.google.com/drive/folders/1-bB8MUzpR_17370uD1DJtN-iFfXTHn2I", "created_at": "", "completed_at": ""}, {"path": "/@laze0220/works/17", "thumbnail_src": "https://si.imgix.net/406dd607/uploads/origins/ec8bd832-c8b0-480c-b8f1-0560923b5b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c43ab349b86a5480263b594a2683be", "thumbnail_srcset": "https://si.imgix.net/406dd607/uploads/origins/ec8bd832-c8b0-480c-b8f1-0560923b5b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c43ab349b86a5480263b594a2683be, https://si.imgix.net/406dd607/uploads/origins/ec8bd832-c8b0-480c-b8f1-0560923b5b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c211c324779bd6c12c1eb86d960007fc 2x, https://si.imgix.net/406dd607/uploads/origins/ec8bd832-c8b0-480c-b8f1-0560923b5b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25a58b4ac7df42a273817f1fceab01c3 3x", "genre": "art", "nsfw": false, "body": "宇佐見レイズ様\n\nはじめまして。個人Vtuberとして活動している天羽空桜と申します。\n\n宇佐見レイズ様のイラストがとても素敵だったので\nぜひ私も描いていただければと思いリクエストお送りさせていただきました！\n\n◆概要\n恐れ入りますが構図やポーズお任せでお願いできますでしょうか。\n※サムネイルなどに使用したいので左右や頭部が見切れない構図だと嬉しいです。\n※服装/髪型アレンジいただいても大丈夫です。\n\n◆使用用途\nYouTubeでの使用（収益化済）\n各種SNSへの投稿\n\n◆データ形式\n人物と背景がレイヤー分けされたPSD\n又は人物のみ透過されたPNGなど差分形式でいただけると嬉しいです。\n\n◆ビジュアル資料\nhttps://drive.google.com/drive/u/1/folders/14yo8ZdsCWyaHE7BcdppByqblXI6x_5UI\n\n◆ビジュアル補足\n瞳：瞳孔はお花の形、右目下に泣きぼくろ\n髪：インナーカラー紺。毛先カール。顔横の髪が後のボブより長い\n参考モチーフ：桜、羽（必須ではありません）\n\nお忙しい中恐れ入りますがご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@laze0220/works/16", "thumbnail_src": "https://si.imgix.net/c81327f0/uploads/origins/9725474e-bcbf-4480-b893-451fd142430a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20bdbee9bb9b31388f3f3ba040dc2c55", "thumbnail_srcset": "https://si.imgix.net/c81327f0/uploads/origins/9725474e-bcbf-4480-b893-451fd142430a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20bdbee9bb9b31388f3f3ba040dc2c55, https://si.imgix.net/c81327f0/uploads/origins/9725474e-bcbf-4480-b893-451fd142430a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c3ca542c30842161d0fe58cfa36b14f 2x, https://si.imgix.net/c81327f0/uploads/origins/9725474e-bcbf-4480-b893-451fd142430a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6014cb1db7c33267392629283a51aaa 3x", "genre": "art", "nsfw": false, "body": "初めまして, 宇佐見レイズさん!\n私はあなたの絵が大好きです！それらはとてもかわいいので、私のOCのために絵を描いてほしいです！🥰 URLのキャラクター紹介をご覧ください～\n\nhttps://drive.google.com/drive/folders/11L28TnjMYP_4doLB4wm523hPL_5jPYeB", "created_at": "", "completed_at": ""}, {"path": "/@laze0220/works/15", "thumbnail_src": "https://si.imgix.net/7c6e00e1/uploads/origins/678d5e64-e259-4b9c-b763-ef88cc8cd3a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txts