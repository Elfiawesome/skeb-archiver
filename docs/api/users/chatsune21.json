=200&h=200&s=db56b69466962053e7b196514c014524 2x, https://si.imgix.net/f88a644f/uploads/origins/de4097a7-7c7f-47b4-af61-edc3002a642b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=740a7447b9a708d4d951edc989e5da83 3x", "genre": "art", "nsfw": true, "body": "ちゃつねさん初めまして\nリリーホワイトちゃんが博麗神社でふたなりの大妖精、レミリア・スカーレットとらぶらぶセックスしているイラストをお願いします\n\n大妖精はおまんこに、レミリアはアナルに挿入し、周囲には順番待ちのふたなりっ娘が大勢いる構図でお願いします\n\n順番待ちしている人数及びキャラはお任せしますが、ロリキャラ中心でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/29", "thumbnail_src": "https://si.imgix.net/1fd32d95/uploads/origins/84a27086-cc63-4764-802a-e022a1688a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ca597b0860ea17801d31601858e7d61", "thumbnail_srcset": "https://si.imgix.net/1fd32d95/uploads/origins/84a27086-cc63-4764-802a-e022a1688a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ca597b0860ea17801d31601858e7d61, https://si.imgix.net/1fd32d95/uploads/origins/84a27086-cc63-4764-802a-e022a1688a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d736be16e8f305497e873666bda2f42f 2x, https://si.imgix.net/1fd32d95/uploads/origins/84a27086-cc63-4764-802a-e022a1688a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49fc3c3b3085a1f1679850cd3f2aae34 3x", "genre": "art", "nsfw": true, "body": "こんにちは、いきなりで申し訳ないのですが、あなたの画風がとてもかわいいので、できればオキザリス（フラワーナイトガール）が縮こまった南ことり（ラブライブ！）を踏みつけているイラストをお願いしたいです。\n\nたぶんこんな感じ：\nhttps://skeb.jp/@kabao_gs/works/259\nhttps://skeb.jp/@__kuchinashi02/works/229\n\nオキザリスと南ことりの立ち絵と着物の装飾は、参考URLでチェックできる。英語と日本語のテキストの翻訳もあり、作品も見ることができる。\nhttps://arkhangrst.pixnet.net/blog/post/187308694\n\nお読みいただきありがとうございました！\n\nhttps://arkhangrst.pixnet.net/blog/post/187308694", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/28", "thumbnail_src": "https://si.imgix.net/8ae138dd/uploads/origins/2b60d350-f71c-4843-b1a6-b899644587ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3491b0a039bcb9f3321f44e69a4f7068", "thumbnail_srcset": "https://si.imgix.net/8ae138dd/uploads/origins/2b60d350-f71c-4843-b1a6-b899644587ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3491b0a039bcb9f3321f44e69a4f7068, https://si.imgix.net/8ae138dd/uploads/origins/2b60d350-f71c-4843-b1a6-b899644587ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c08207b17eadd58fee2379c3aef5db23 2x, https://si.imgix.net/8ae138dd/uploads/origins/2b60d350-f71c-4843-b1a6-b899644587ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddc3e6fd52627647168108c94326f74b 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ちゃつねさん。前回の莉玖ちゃんは可愛かったです！今回お願いしたいのは『ふゆから、くるる』のロリ会長・星都チエミです。細かい部分はおまかせします。\n\nhttps://drive.google.com/drive/folders/1VXoMeC7rU8y3JSSU9Xye4zg2sJ2CLVXI?usp=sharing\n\n今回もどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/27", "thumbnail_src": "https://si.imgix.net/fed497b9/uploads/origins/076a6190-daf0-46c2-99b5-7270239a7b17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=445bcbfa72764a332b0cf0c36db07917", "thumbnail_srcset": "https://si.imgix.net/fed497b9/uploads/origins/076a6190-daf0-46c2-99b5-7270239a7b17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=445bcbfa72764a332b0cf0c36db07917, https://si.imgix.net/fed497b9/uploads/origins/076a6190-daf0-46c2-99b5-7270239a7b17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1561b98710cb6dc2d3a7aef6fdfaeacd 2x, https://si.imgix.net/fed497b9/uploads/origins/076a6190-daf0-46c2-99b5-7270239a7b17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78e8ff0bb9022f4187d8f02f11309248 3x", "genre": "art", "nsfw": true, "body": "こんにちは！『フローラル・フローラブ』の斉須莉玖ちゃんをお願いします。構図や衣装はおまかせします。全年齢でも R18 でもおまかせ。\n\nキャラ：https://sagapla.net/works/floflo/img/character/img_ri_chara01.png\n他の参考：https://sagapla.net/works/floflo/\n\n楽しみにしています！", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/26", "thumbnail_src": "https://si.imgix.net/38afb083/uploads/origins/65d8be94-19a2-43b2-a195-7b3de1c94956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9610b3c704d4ee08e628d2bb82fc12e0", "thumbnail_srcset": "https://si.imgix.net/38afb083/uploads/origins/65d8be94-19a2-43b2-a195-7b3de1c94956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9610b3c704d4ee08e628d2bb82fc12e0, https://si.imgix.net/38afb083/uploads/origins/65d8be94-19a2-43b2-a195-7b3de1c94956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69d0925334fe453e0886f2f2e122a51a 2x, https://si.imgix.net/38afb083/uploads/origins/65d8be94-19a2-43b2-a195-7b3de1c94956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=868292475bea7c461a1391e3b9159f68 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nとても可愛らしいコハルちゃんのイラストと、とてもえっちなミミちゃんのイラストを拝見しイラストをお願いしたいと思いました。\n\n◯キャラクター\n　ブルアカのイブキちゃん\n\n◯シチュ\n　先生との初めてのえっちでいっぱい中出しされた後、開脚した状態からあそこを両指で拡げ、中出しされた精液(少し赤みが混ざっている)や愛液などが溢れてシーツに溜まりやシミを作っている様子のイラストをお願いします。\n\nまた、初めてのHで先生の子を宿す設定で、もし予算内で可能でしたら挿入前のくぱぁや中出し後に精子が卵子に刺さる描写や大きくなったお腹の描写などもあると嬉しいです。\n\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/25", "thumbnail_src": "https://si.imgix.net/0d418871/uploads/origins/5293f1cb-6a33-4644-a73d-b6bb07748ee2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc8ca42c4c54588bf47427767d3f72f", "thumbnail_srcset": "https://si.imgix.net/0d418871/uploads/origins/5293f1cb-6a33-4644-a73d-b6bb07748ee2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc8ca42c4c54588bf47427767d3f72f, https://si.imgix.net/0d418871/uploads/origins/5293f1cb-6a33-4644-a73d-b6bb07748ee2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd17195834b95c28c751f00ae943d108 2x, https://si.imgix.net/0d418871/uploads/origins/5293f1cb-6a33-4644-a73d-b6bb07748ee2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6223aed58b92a64032abdfa5ee202e0d 3x", "genre": "art", "nsfw": true, "body": "艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\nアーボックは時津風の４巻程で(首から下は足元まで隙間なく)巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい\n全身巻き付かれている事を強調する為、時津風の全身をお願い致します\n差分が大丈夫ならアーボックは通常色と色違いを、尻尾で首を巻き付けているのといないのをお願いします\n時津風の表情ですが、できれば複数（①と④を優先）お願いします\n①涙目で苦しんでいる\n②苦しんでいるけど若干感じていて赤面になっている\n③苦しいけど若干気持ちよくて恥ずかしがっている\n④嬉しくて笑っている\n①②は目を閉じ③④は目を開けて下さい", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/24", "thumbnail_src": "https://si.imgix.net/2d053353/uploads/origins/ffd0ae3a-cc5c-4f21-81e6-ab61dffe360e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a9bcac91778a966fa637f4757e6f6f", "thumbnail_srcset": "https://si.imgix.net/2d053353/uploads/origins/ffd0ae3a-cc5c-4f21-81e6-ab61dffe360e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a9bcac91778a966fa637f4757e6f6f, https://si.imgix.net/2d053353/uploads/origins/ffd0ae3a-cc5c-4f21-81e6-ab61dffe360e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df5ad791c2874d86252ba47ab2156c0 2x, https://si.imgix.net/2d053353/uploads/origins/ffd0ae3a-cc5c-4f21-81e6-ab61dffe360e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e4c4926913e0c3b6e98d36db09a4f39 3x", "genre": "art", "nsfw": false, "body": "ちゃつね🦋先生こんにちは\n\n以前はかわいいコハルちゃんを描いていただきありがとうございました\n今回も似た内容になりますが、リクエストしたいと思います\n\n内容\nスリッパを履いたまま畳の部屋を歩いているコハルちゃんを描いて頂きたいのですがよろしいでしょうか？\n\nキャラ\nブルーアーカイブ\n下江コハルちゃん\n\n服装\n制服\n足元ですが緑色の来客用スリッパを履いている状態でお願いします\n\n背景\n和室\n全身が写っている状態でお願いします\n\n以上、スリッパを履いている女の子が好きで今回も描いてもらえると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/23", "thumbnail_src": "https://si.imgix.net/173214a2/uploads/origins/c91c5155-4630-4965-89a1-74bc481f6e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f03306fcc7ebf43ccdcb0e02e6ff04", "thumbnail_srcset": "https://si.imgix.net/173214a2/uploads/origins/c91c5155-4630-4965-89a1-74bc481f6e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f03306fcc7ebf43ccdcb0e02e6ff04, https://si.imgix.net/173214a2/uploads/origins/c91c5155-4630-4965-89a1-74bc481f6e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c9a756a5b669c1f6fe984b86a2bddcd 2x, https://si.imgix.net/173214a2/uploads/origins/c91c5155-4630-4965-89a1-74bc481f6e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5916746ec6beb91246119a8171debdec 3x", "genre": "art", "nsfw": false, "body": "ちゃつね🦋先生こんにちは\n\n絵柄が素敵で依頼しました\n\nブルアカのコハルちゃんを描いて頂きたいのですがよろしいでしょうか？\n\n服装\n制服\n足元ですが学校や病院にある緑色の来客用スリッパを履いている状態でお願いします\n\n背景\n学校の教室や芝生、道路等\n\nポーズはおまかせしますが全身が見える状態でお願いしたいです\n\n以上になります\nスリッパを履いている女の子が好きで描いて頂けると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/22", "thumbnail_src": "https://si.imgix.net/b6648ea3/uploads/origins/bd06dabc-7b49-400b-bf62-42f31c366051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8090bfdc89ee77d177e3ad4e65c267b6", "thumbnail_srcset": "https://si.imgix.net/b6648ea3/uploads/origins/bd06dabc-7b49-400b-bf62-42f31c366051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8090bfdc89ee77d177e3ad4e65c267b6, https://si.imgix.net/b6648ea3/uploads/origins/bd06dabc-7b49-400b-bf62-42f31c366051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=287f94c2d0b9bb5b32319eaa5d2c6364 2x, https://si.imgix.net/b6648ea3/uploads/origins/bd06dabc-7b49-400b-bf62-42f31c366051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e513225d8f265f5d53be032e381e2439 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/21", "thumbnail_src": "https://si.imgix.net/6547ba54/uploads/origins/fc66a2b6-6126-4947-9510-0e30d7955786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2db9637a62e03a8181c1b1bb0675ee2", "thumbnail_srcset": "https://si.imgix.net/6547ba54/uploads/origins/fc66a2b6-6126-4947-9510-0e30d7955786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2db9637a62e03a8181c1b1bb0675ee2, https://si.imgix.net/6547ba54/uploads/origins/fc66a2b6-6126-4947-9510-0e30d7955786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30b0d2a9d1df10c288704624b413b608 2x, https://si.imgix.net/6547ba54/uploads/origins/fc66a2b6-6126-4947-9510-0e30d7955786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41e66fa53d7318027f8aea011d78e353 3x", "genre": "art", "nsfw": true, "body": "忙しい中、再送許可ありがとうございますー。\nプリコネの茜ミミちゃん（作中の緑ドレス着用）に種付けいちゃいちゃせっくすしちゃった 事後イラストをお願いします。\n種付け直後のおにんにん抜いて広がった膣口(にんにんが糸でつながってる)からたくさん精液がこぼれている描写と、ビクンビクン痙攣してる身体、愛されてダメになった顔、「お兄ちゃんの、赤ちゃん、欲しいな」とかえっちなこと言ってる孕ませ描写を、是非お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/20", "thumbnail_src": "https://si.imgix.net/4c0f749d/uploads/origins/67d4e9e0-b974-40be-9bda-a68c262379bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c15bc126f37fe62235c57e48482c60", "thumbnail_srcset": "https://si.imgix.net/4c0f749d/uploads/origins/67d4e9e0-b974-40be-9bda-a68c262379bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c15bc126f37fe62235c57e48482c60, https://si.imgix.net/4c0f749d/uploads/origins/67d4e9e0-b974-40be-9bda-a68c262379bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36e45bec611b7d64683a5a0caa3fe1e8 2x, https://si.imgix.net/4c0f749d/uploads/origins/67d4e9e0-b974-40be-9bda-a68c262379bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b6eee4225ea63a045f3df43b2e4196b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ちゃつねさんの描く女の子がとても可愛らしくて大好きです。\n特にごちうさのココアちゃんとチノちゃんが好きなので、この二人のイラストをお願いします。\nただ、私は幽霊娘が大好きで、原作やアニメの幽霊ココアちゃんがとっても好きです。なので、幽霊のココアちゃんとチノちゃんをお願いします。\n衣装は原作やアニメと同じ日本の幽霊の恰好で、下半身は本物の幽霊みたいにふわふわしたしっぽのような形にしてください。\n\n下半身のイメージ:https://imgur.com/YZkPNJb\n怖さ0で可愛らしさ全開な感じにしてください。\n\nちゃつねさんの描く可愛い幽霊ココチノを期待しています！", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/19", "thumbnail_src": "https://si.imgix.net/286ba3de/uploads/origins/04643676-7e65-4807-8efa-24d6e7e342eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a421ebd8c74a23d80768c2e1c12ac74c", "thumbnail_srcset": "https://si.imgix.net/286ba3de/uploads/origins/04643676-7e65-4807-8efa-24d6e7e342eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a421ebd8c74a23d80768c2e1c12ac74c, https://si.imgix.net/286ba3de/uploads/origins/04643676-7e65-4807-8efa-24d6e7e342eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9f69f1c08221a371b21eb40a359e97e 2x, https://si.imgix.net/286ba3de/uploads/origins/04643676-7e65-4807-8efa-24d6e7e342eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfb473a446cc019a2cf34a0aba8a1d50 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私の友人のJustinです。私の友人、Justinの誕生日をテーマにした作品をお願いしたいのですが\nマイテツのハチロクを描いてもらえませんか？\nポーズは自由ですが、可愛くて元気な感じでお願いします。上の部分に名前を書くときに、ハッピーバースデーと書いてもらえると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@chatsune21/works/18", "thumbnail_src": "https://si.imgix.net/c7ac1375/uploads/origins/0a862e42-0681-4532-a298-0d1709c9f34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79e975d59b0fe6a7963f6ebfe