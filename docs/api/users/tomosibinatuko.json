f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e1827da4be719597b9f66b5c07828a1 3x", "genre": "art", "nsfw": false, "body": "牙狼が「やったあ！GOD OF GARO7500だあ！」してる絵をください", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/35", "thumbnail_src": "https://si.imgix.net/8b6875a6/uploads/origins/c57f75f3-145f-4e2b-8cfa-2910b6c008a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e15076f4ff05e51fe8cbf1ec678d9cd7", "thumbnail_srcset": "https://si.imgix.net/8b6875a6/uploads/origins/c57f75f3-145f-4e2b-8cfa-2910b6c008a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e15076f4ff05e51fe8cbf1ec678d9cd7, https://si.imgix.net/8b6875a6/uploads/origins/c57f75f3-145f-4e2b-8cfa-2910b6c008a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56c79ea4aaaa7e6c1b35deb4936ea1b1 2x, https://si.imgix.net/8b6875a6/uploads/origins/c57f75f3-145f-4e2b-8cfa-2910b6c008a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0968edeeb10aa35bfb1b8a627c0f42f5 3x", "genre": "art", "nsfw": true, "body": "人数と金額を変更して再依頼させていただきます\n\n夏子さんいつも素敵なもめごとや癖シチュ楽しませて頂いてます！\n今までの作品も非常に良く、夏子さんに送って理想の癖シチュが来るのをワクテカしながら待つのがここ最近の楽しみです！\n\n前回と同じく戦国乙女の下記乙女武将が洗脳されてベガ親衛隊のスーツを着てこちらを向いて敬礼してるシチュをお願いできますでしょうか？\n表情差分も前回と同じで、元の衣装で頭に鉢巻・結びがある乙女にはそのままの髪型にしてベガ親衛隊帽子ありなしの差分があると嬉しいです。\n\n・織田ノブナガ\n・豊臣ヒデヨシ\n・前田トシイエ", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/34", "thumbnail_src": "https://si.imgix.net/359ce9a3/uploads/origins/35660c03-43ad-4f68-bdfa-d70f40f5d676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4ff62ba0bee2b193445d7d5c2892012", "thumbnail_srcset": "https://si.imgix.net/359ce9a3/uploads/origins/35660c03-43ad-4f68-bdfa-d70f40f5d676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4ff62ba0bee2b193445d7d5c2892012, https://si.imgix.net/359ce9a3/uploads/origins/35660c03-43ad-4f68-bdfa-d70f40f5d676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dca76e6964e2c5e4417d192de42f60a1 2x, https://si.imgix.net/359ce9a3/uploads/origins/35660c03-43ad-4f68-bdfa-d70f40f5d676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10b749ccf2e36475e78b7a887cd9a03e 3x", "genre": "art", "nsfw": true, "body": "麻雀物語の能海しいなちゃんをお願いします。\n\n搾乳機または搾精機で搾ってほしいのですが、乳を搾るかちんぽを搾るか両方搾るか本気で悩んでいるので夏子さんが決めてください。\n\n表情は気持ちよくて恍惚としている。\n他はおまかせします。\n巨大な乳やちんぽから機械やタンクをブチ壊す勢いの大量噴射をお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/33", "thumbnail_src": "https://si.imgix.net/72c76813/uploads/origins/798db46b-51b9-4b7e-a557-1ded7f871144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf376bca5a0f0b28459768feaf9666c2", "thumbnail_srcset": "https://si.imgix.net/72c76813/uploads/origins/798db46b-51b9-4b7e-a557-1ded7f871144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf376bca5a0f0b28459768feaf9666c2, https://si.imgix.net/72c76813/uploads/origins/798db46b-51b9-4b7e-a557-1ded7f871144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de2cff6e8fb0a57cfffa7e64ae90f9f1 2x, https://si.imgix.net/72c76813/uploads/origins/798db46b-51b9-4b7e-a557-1ded7f871144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca656219f3c8c0b158eff0f53c6305c9 3x", "genre": "art", "nsfw": true, "body": "夏子さんいつも素敵なもめごとや癖シチュ楽しませて頂いております！\n前回の作品も非常に良く、やはりパチ界隈性癖シチュなら夏子さんだなと感じました！\n\n前回と同じく戦国乙女の下記乙女武将が洗脳されてベガ親衛隊のスーツを着てこちらを向いて敬礼してるシチュをお願いできますでしょうか？\n表情差分も前回と同じものがあると助かります。また元の衣装で頭に帽子・フード・兜がある乙女には元のものとベガ親衛隊帽子差分があると嬉しいです。（キャラ判別がしやすく堕ちてる感が余計に増す為）\n\n・長宗我部モトチカ\n・毛利モトナリ\n・大友ソウリン\n・立花ドウセツ", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/32", "thumbnail_src": "https://si.imgix.net/34ffe921/uploads/origins/377486cb-cb69-488f-a9da-bb322d3c524a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9ee1f5ffdc715196a7bfd4342b20b8", "thumbnail_srcset": "https://si.imgix.net/34ffe921/uploads/origins/377486cb-cb69-488f-a9da-bb322d3c524a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9ee1f5ffdc715196a7bfd4342b20b8, https://si.imgix.net/34ffe921/uploads/origins/377486cb-cb69-488f-a9da-bb322d3c524a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c8c025751d7ed557ea3ceda442e24ea 2x, https://si.imgix.net/34ffe921/uploads/origins/377486cb-cb69-488f-a9da-bb322d3c524a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9ca04abedc7fcdc7df946ebeff7d08f 3x", "genre": "art", "nsfw": false, "body": "こんばんは\n今回はリコリスリコイルの錦木千束のまんじゅうを描いて頂きたいです\n前回と同じ差分もお願いします", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/31", "thumbnail_src": "https://si.imgix.net/39bc6b91/uploads/origins/4f84eb3f-044a-4b38-b216-b174e7c95c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6178f2bb1de8ff2ae6651a02929b34", "thumbnail_srcset": "https://si.imgix.net/39bc6b91/uploads/origins/4f84eb3f-044a-4b38-b216-b174e7c95c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6178f2bb1de8ff2ae6651a02929b34, https://si.imgix.net/39bc6b91/uploads/origins/4f84eb3f-044a-4b38-b216-b174e7c95c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cdf74dff8232f22d5c188745266ea8e 2x, https://si.imgix.net/39bc6b91/uploads/origins/4f84eb3f-044a-4b38-b216-b174e7c95c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b410d481b662e924c8a00551b08d684 3x", "genre": "art", "nsfw": true, "body": "夏子さんいつも素敵なもめごとや癖シチュ楽しませて頂いております！\nパチ界隈で性癖シチュ描ける絵師さんと言えば夏子さんだと思っているので特殊な依頼をさせていただきます！\n\n戦国乙女の徳川イエヤス・今川ヨシモト・千リキュウがストリートファイターのベガに洗脳されて\nストリートファイターZERO3のベガ親衛隊のスーツを着てこちらを向いて敬礼してるシチュをお願いできますでしょうか？\n以前描かれていたノブナガパイズリの無表情（ハイライトなし）、警戒（ハイライトなし）それとは別に邪悪な笑顔差分があると助かります。\nリキュウの目が開いている差分があるとより助かります！", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/30", "thumbnail_src": "https://si.imgix.net/ab47d9a8/uploads/origins/ea146e1c-acf6-4a1f-acee-e039ac7cc152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efcf54d0a97eb803a881301af7cc1b67", "thumbnail_srcset": "https://si.imgix.net/ab47d9a8/uploads/origins/ea146e1c-acf6-4a1f-acee-e039ac7cc152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efcf54d0a97eb803a881301af7cc1b67, https://si.imgix.net/ab47d9a8/uploads/origins/ea146e1c-acf6-4a1f-acee-e039ac7cc152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9947ee9590d69801e4eaa482080129f0 2x, https://si.imgix.net/ab47d9a8/uploads/origins/ea146e1c-acf6-4a1f-acee-e039ac7cc152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2746bebf9ccdee1e2171bed5caa9e26 3x", "genre": "art", "nsfw": true, "body": "スマスロToLOVEるダークネスのナナちゃんがぱいぱいアップくんを使用して胸が大きくならなかった所にまんじゅう顔のぱいぱいアップ君がスッと出てきて「やったぁ！」と叫ぶとナナちゃんが巨乳化して成功と出るがそれだけにとどまらず「やったぁ！！」と叫ぶ度にどんどん大きくなっていき爆乳化、超乳化する大成功と超成功の3段階膨乳をお願いします。\n衣装は元の演出通り制服姿で巨乳化段階でシャツのボタンを飛ばせる大きさにしてください。控える2段階のサイズはお任せします。\nおっぱいの変化と共に制服を着ていない状態での差分もお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/29", "thumbnail_src": "https://si.imgix.net/76777b3d/uploads/origins/3f4bd4ff-7bc2-4181-b33a-5fe6b7056625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1012fce9d0b24cda7b773633e8231ede", "thumbnail_srcset": "https://si.imgix.net/76777b3d/uploads/origins/3f4bd4ff-7bc2-4181-b33a-5fe6b7056625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1012fce9d0b24cda7b773633e8231ede, https://si.imgix.net/76777b3d/uploads/origins/3f4bd4ff-7bc2-4181-b33a-5fe6b7056625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ba7f44d97b26bf7b6f10b4ead70bf27 2x, https://si.imgix.net/76777b3d/uploads/origins/3f4bd4ff-7bc2-4181-b33a-5fe6b7056625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7f0bba083e0e89359b6bdb1ed878d8 3x", "genre": "art", "nsfw": true, "body": "戦国乙女、今川ヨシモトの玉付きふたなりをお願いします。\nズルムケフル勃起をしこしこして射精有無をつけてください。\nサイズは参考のを最小として、3〜5段階程度で大きくしてください。\n竿と玉はどこまで大きくなってもOKですが、竿が玉に負けないバランスでお願いします。\n景観を損ねるようなら玉サイズはそこそこでも大丈夫です。\n乳とか服の有無はおまかせします。\nでかいと嬉しいです。\n\n竿は身長超えてもいいですし、玉は以下リンクでも余裕です。\nhttps://x.com/maruchiro_/status/1870833277130731824?t=8ZE_PNCxMXRCPJHAVCUwIQ&s=19\n\nhttps://x.com/maruchiro_/status/1879128798601572687?t=Hfh_evsO0JQIimC8rS1q_Q&s=19", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/28", "thumbnail_src": "https://si.imgix.net/ad6ea2c3/uploads/origins/7061a9ec-ad84-4b64-8544-38f5a464f7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32d1ce39b7a547bbb2631e2528ff2e8d", "thumbnail_srcset": "https://si.imgix.net/ad6ea2c3/uploads/origins/7061a9ec-ad84-4b64-8544-38f5a464f7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32d1ce39b7a547bbb2631e2528ff2e8d, https://si.imgix.net/ad6ea2c3/uploads/origins/7061a9ec-ad84-4b64-8544-38f5a464f7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13a703387e21ec57651b74f3679979e6 2x, https://si.imgix.net/ad6ea2c3/uploads/origins/7061a9ec-ad84-4b64-8544-38f5a464f7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5661569e937fc5e5cb131c623e382e8 3x", "genre": "art", "nsfw": true, "body": "麻雀物語2の鳴岡みいなのおっぱい盛り(長乳、乳首大きめ、乳輪おまかせ)、噴乳有無をお願いします。\nみいな\nhttps://images.app.goo.gl/bEMy7sLBntApWbW88\n\n髪飾りのみの全裸で腰に手を当てドヤってる表情。頭は私服のもの。\n\nいくつか段階を踏んで乳を盛ってほしいのですが\n1.一般巨乳\n2.ヘソ下くらい\n3.接地して添付URLくらい\n4.接地して乳の高さが身長の2〜5倍くらい(おまかせ)\n\n3,4の乳は、最低ライン資料くらいで、接地させるためにこれより長くしても、乳房も乳首もどれだけでっかくなってもOKです。\n\nhttps://www.pixiv.net/artworks/116308235", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/27", "thumbnail_src": "https://si.imgix.net/6d35d0f9/uploads/origins/83e61746-1bfe-4095-8e37-1f2162fd1eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c96174e2db707354a44ed112b4717e", "thumbnail_srcset": "https://si.imgix.net/6d35d0f9/uploads/origins/83e61746-1bfe-4095-8e37-1f2162fd1eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c96174e2db707354a44ed112b4717e, https://si.imgix.net/6d35d0f9/uploads/origins/83e61746-1bfe-4095-8e37-1f2162fd1eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2ae46399a3c04bf73c8bf411964cc0e 2x, https://si.imgix.net/6d35d0f9/uploads/origins/83e61746-1bfe-4095-8e37-1f2162fd1eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2caa48402108c03364a8d462feab3f0f 3x", "genre": "art", "nsfw": true, "body": "参考のような見上げアングルで、麻雀物語のデカパイコが風上さやかを踏み潰しているイラストをお願いします。\nパイコはいいです。\nさやかを死ぬほど（死んでもいい）苦しめてやってください。\n\nhttps://gs-uploader.jinja-modoki.com/documents/Camel/fairy.jpg?dl=XEQTATz42QM&t=1720310424&c=1718580647&r=1f", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/26", "thumbnail_src": "https://si.imgix.net/efb24bfc/uploads/origins/b00735d8-01a8-4ac5-9a06-db809709156f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea64f6a48b7bff546f209797b2b8a42", "thumbnail_srcset": "https://si.imgix.net/efb24bfc/uploads/origins/b00735d8-01a8-4ac5-9a06-db809709156f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea64f6a48b7bff546f209797b2b8a42, https://si.imgix.net/efb24bfc/uploads/origins/b00735d8-01a8-4ac5-9a06-db809709156f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53bf822ec32246bddd6b0fbf80fa3777 2x, https://si.imgix.net/efb24bfc/uploads/origins/b00735d8-01a8-4ac5-9a06-db809709156f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91c65488e07324a97640375cd67a88f4 3x", "genre": "art", "nsfw": true, "body": "【依頼内容】\nパチンコ『麻雀物語2』の登場キャラである『れいな』、『しいな』、『みいな』の三人が片手で摘んだ使用済みゴムを見せているイラストをお願い致します。\n\n※イメージとしては枕営業してる三人\n※衣装の指定は特にありません。アイドル衣装でも私服姿でもどちらでもオッケーです。\n\n【要望】\n◎三人が摘んでいるゴムの色はそれぞれのイメージカラーに対応した色でお願いします。\n『れいな＝黄色系』『しいな＝水色系』『みいな＝ピンク系』\n\n◎もし可能なら三人が『はぁ❤️はぁ❤️』と甘い息づかいをしてるような台詞と、部屋中にムワァ…と甘いメスの匂いが充満してるような効果をつけて頂けるとありがたいです", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/25", "thumbnail_src": "https://si.imgix.net/044f7ec5/uploads/origins/b33af972-154f-4edd-bb47-2da39ba2c9db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cda20c2bf4fdaf5af6531477f1cb1d9", "thumbnail_srcset": "https://si.imgix.net/044f7ec5/uploads/origins/b33af972-154f-4edd-bb47-2da39ba2c9db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cda20c2bf4fdaf5af6531477f1cb1d9, https://si.imgix.net/044f7ec5/uploads/origins/b33af972-154f-4edd-bb47-2da39ba2c9db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a64b9ceb62e2e79f143cbb94cbfcc46 2x, https://si.imgix.net/044f7ec5/uploads/origins/b33af972-154f-4edd-bb47-2da39ba2c9db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a01d0efd8044e431b8aba6c11113babe 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nメズマライザーの初音ミクと重音テトに尻から入って口から出る奴をお願いしたいです。\n\nhttps://www.pixiv.net/artworks/119083932\nhttps://youtu.be/19y8YTbvri8?si=rc-ixsAmo8-aHZsx", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/24", "thumbnail_src": "https://si.imgix.net/9ad80249/uploads/origins/66cef6de-56e5-4aaa-81b9-77bf513b9c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581c68aa363a4f6a58ec85f16a091319", "thumbnail_srcset": "https://si.imgix.net/9ad80249/uploads/origins/66cef6de-56e5-4aaa-81b9-77bf513b9c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581c68aa363a4f6a58ec85f16a091319, https://si.imgix.net/9ad80249/uploads/origins/66cef6de-56e5-4aaa-81b9-77bf513b9c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e1f8f26276151fbca6a571c90c2c2ea 2x, https://si.imgix.net/9ad80249/uploads/origins/66cef6de-56e5-4aaa-81b9-77bf513b9c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=138f67930629c3a262447329fbcb6ef6 3x", "genre": "art", "nsfw": true, "body": "戦国乙女の織田ノブナガと戦国コレクションの小悪魔王織田信長の2人でWパイズリシチュをお願いします。  \n\n内容 \n・衣装は牛柄ビキニで牛ツノと牛耳をつけているイメージ。差分で水着含むアクセサリーを外した裸状態もいただきたいです。 \n・体勢、挟み方はお任せしますが2人が竿と挟んでいる竿役の顔(正面側)を見れる体勢でお願いします。 \n・表情差分で挟んでいる状態は竿、射精後は挟んでる竿役の顔(正面側)を向いて胸だけで射精させたりましたけどと自信とにやけが出ている表情の変化をお願いします。瞳にハートが入っているデレ要素もいただければと思います。 \nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/23", "thumbnail_src": "https://si.imgix.net/2be99ddb/uploads/origins/5e19e759-01a4-4436-a847-1e1c1f07f86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e367dfa16e317e33a7d40251a9570631", "thumbnail_srcset": "https://si.imgix.net/2be99ddb/uploads/origins/5e19e759-01a4-4436-a847-1e1c1f07f86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e367dfa16e317e33a7d40251a9570631, https://si.imgix.net/2be99ddb/uploads/origins/5e19e759-01a4-4436-a847-1e1c1f07f86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7779b00c7d6996e397726c41a1958642 2x, https://si.imgix.net/2be99ddb/uploads/origins/5e19e759-01a4-4436-a847-1e1c1f07f86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f57864b74af12d5841d750073385eab 3x", "genre": "art", "nsfw": false, "body": "しょーがないのでご祝儀ですｗ\n\n何も依頼せんのもアレなので僕に「ファミスタ」の\n打ち方を紹介する漫画を１ページお願いします。\n\nご祝儀なので適当で大丈夫ｗ絵もそんなにいりません。\n\n・通常どこ狙いか\n赤七狙いとか黒バー狙いとかファミスタ図柄狙いとか\n・何が来たら熱いのか\nチェリーが熱いとか茶目が熱いとか遅れが熱いとか\n・どうなったら「出る」のか\nボーナス中に７揃いすると、とか、特化ゾーンがあってとか。あんのか知らんけど。\nとか書いてくれるとそれっぽいかな。\n\n多分夏子さんはこういう紹介漫画とか実戦漫画向きだと思うので\n是非この機会にチャレンジしてみてくださいｗ\nテキトーでいいよｗホントにｗ", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/22", "thumbnail_src": "https://si.imgix.net/633a02e0/uploads/origins/89d03f18-6af7-4b80-832d-b6ee4432f09d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a124664980872c202c8eba18909f4fc6", "thumbnail_srcset": "https://si.imgix.net/633a02e0/uploads/origins/89d03f18-6af7-4b80-832d-b6ee4432f09d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a124664980872c202c8eba18909f4fc6, https://si.imgix.net/633a02e0/uploads/origins/89d03f18-6af7-4b80-832d-b6ee4432f09d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7f3b21f145969beceb67086433bf7b5 2x, https://si.imgix.net/633a02e0/uploads/origins/89d03f18-6af7-4b80-832d-b6ee4432f09d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=389a10fb71ae936f4c07545cf4a1b921 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n前回に引き続き僕のVアバター「乙羽衣 乃音」を描いていただきたくリクエストさせていただきます。\n\n今回は等身高めで「パイズリをする乙羽衣 乃音」でお願いしたいです。\n・構図や表情はお任せします。\n・基本着衣状態で胸だけ露出させてください。\n・胸は盛っていただいて大丈夫です。\n・金額内で可能であれば乳内射精後に胸を開いて見せる差分もお願いしたいです。\n・射精後の精液ぶっかけは多ければ多いほど嬉しいです。\n\n以上の内容でご検討の程よろしくお願いします。\n\nhttps://drive.google.com/file/d/1PQsIBur3pousfL17Na7Vt4oXPq5N2vlM/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/21", "thumbnail_src": "https://si.imgix.net/0f5bef4d/uploads/origins/48e8ab4f-986e-4502-b30f-c01fbaa1cc14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91eba56d3dd599502438162ff9a30e47", "thumbnail_srcset": "https://si.imgix.net/0f5bef4d/uploads/origins/48e8ab4f-986e-4502-b30f-c01fbaa1cc14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91eba56d3dd599502438162ff9a30e47, https://si.imgix.net/0f5bef4d/uploads/origins/48e8ab4f-986e-4502-b30f-c01fbaa1cc14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d905051f66049eb0718412fc46c7b79e 2x, https://si.imgix.net/0f5bef4d/uploads/origins/48e8ab4f-986e-4502-b30f-c01fbaa1cc14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30da5bfc7688e54fa6b8efebdf50285a 3x", "genre": "art", "nsfw": false, "body": "こんばんは\n今回は黒執事のグレル・サトクリフのまんじゅうを描いて頂きたいです\n出来たら前回と同じ差分もお願いします", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/20", "thumbnail_src": "https://si.imgix.net/c4647428/uploads/origins/d54f366f-6b3d-4abb-9b0a-680bbcec4a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78d0dcbe57857b3d7f6d556a82a484bc", "thumbnail_srcset": "https://si.imgix.net/c4647428/uploads/origins/d54f366f-6b3d-4abb-9b0a-680bbcec4a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78d0dcbe57857b3d7f6d556a82a484bc, https://si.imgix.net/c4647428/uploads/origins/d54f366f-6b3d-4abb-9b0a-680bbcec4a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f462bde15f87e40433dcf6d920ec7ed 2x, https://si.imgix.net/c4647428/uploads/origins/d54f366f-6b3d-4abb-9b0a-680bbcec4a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50bd9ded60132fb2fd45319ddea1db82 3x", "genre": "art", "nsfw": true, "body": "戦国乙女の前田トシイエちゃんが膨乳薬の効果でとんでもなく大きくなり衣装を弾き飛ばしてしまうシチュでお願いします。\n以下細かい内容です。\n・衣装は乙フェスのアニマるん衣装ベースで白い犬をモチーフにした衣装で膨乳時に胸にある布を弾き飛ばすイメージです。\n・瓶に入ったピンクの液体(膨乳薬)を飲む事で急激に盛っていただきたいです\n・基本1枚はぺったんこ状態で薬を持ちぐぬぬと言ってそうな表情、\nここから胸と表情変化差分で\n・薬を飲み急激に大きくなった胸がばるんと胸の衣装を弾き飛ばして乳首が露わになる状態。表情は大きすぎて困るという事はなく目を輝かせて大満足！と衣装の尻尾を振って喜ぶ笑顔でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/19", "thumbnail_src": "https://si.imgix.net/3c0e8b2c/uploads/origins/a5de8f8c-21fa-4ea5-acc5-b2af154ca634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0738d8f6a4513faf746e0cb9274d519c", "thumbnail_srcset": "https://si.imgix.net/3c0e8b2c/uploads/origins/a5de8f8c-21fa-4ea5-acc5-b2af154ca634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0738d8f6a4513faf746e0cb9274d519c, https://si.imgix.net/3c0e8b2c/uploads/origins/a5de8f8c-21fa-4ea5-acc5-b2af154ca634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c8a0f132446d2befd2d97068bc4f880 2x, https://si.imgix.net/3c0e8b2c/uploads/origins/a5de8f8c-21fa-4ea5-acc5-b2af154ca634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f9880b7ea55e2e5a312af71f36a2aec 3x", "genre": "art", "nsfw": false, "body": "描ける都合が立たなかったら、キャンセルをおねがいします。\n\nパチスロのマジカルハロウィンのアリス・ウィッシュハートの円柱化をお願いします。\n\n・ホウキで空を飛んでいたら誤って土管で突っ込んでしまい、ホウキにのったまま円柱状に成形され、土管の出口からそのまま排出されてしまうテイでお願いします。\n・表情は困惑してる感じでお願いします。\n・円柱状に成形されても帽子はそのままの形でお願いします。\n\n円柱化参考↓\nhttps://x.com/se7cond/status/1522879708727508993?s=20", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/18", "thumbnail_src": "https://si.imgix.net/45beb95e/uploads/origins/9eceab23-5ea2-4872-b811-aaf4fc921e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e324ffd6b18a0f2287da2bd9470a785d", "thumbnail_srcset": "https://si.imgix.net/45beb95e/uploads/origins/9eceab23-5ea2-4872-b811-aaf4fc921e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e324ffd6b18a0f2287da2bd9470a785d, https://si.imgix.net/45beb95e/uploads/origins/9eceab23-5ea2-4872-b811-aaf4fc921e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83ab191be5108008f7ffee0d2654da03 2x, https://si.imgix.net/45beb95e/uploads/origins/9eceab23-5ea2-4872-b811-aaf4fc921e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4f19db06ec5e0483e6115436d53f7f5 3x", "genre": "art", "nsfw": false, "body": "こちらは別タイプの球体化の依頼になりますがよろしいでしょうか。\n\nライザのアトリエのライザの球体化（手足付き）をお願いします。\n\n・脚はピッピ（ポケモン）みたいな感じで短く太い感じで、手も同じように太く短い感じでデフォルメチックな感じでお願いします。\n\n・丸くなっても胸の盛り上がりはある感じで\n\n・表情は楽しんでるような感じでお願いします。\n\n球体化参考↓\nhttps://www.pixiv.net/artworks/96556587\n\nhttps://www.pixiv.net/artworks/96723988", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/17", "thumbnail_src": "https://si.imgix.net/a4b2e418/uploads/origins/e6498471-c908-4870-8079-59b2acc50ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d11cfba1ca7092659d72dce852b6e4", "thumbnail_srcset": "https://si.imgix.net/a4b2e418/uploads/origins/e6498471-c908-4870-8079-59b2acc50ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d11cfba1ca7092659d72dce852b6e4, https://si.imgix.net/a4b2e418/uploads/origins/e6498471-c908-4870-8079-59b2acc50ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e922168660b18d5c3ab6fdb2626fb2d0 2x, https://si.imgix.net/a4b2e418/uploads/origins/e6498471-c908-4870-8079-59b2acc50ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca84989be5eb670ae5bbe1df1eb56390 3x", "genre": "art", "nsfw": false, "body": "以前はありがとうございます。\nとても可愛かったです。\n今回も同じような感じです。\n\n閃乱カグラの雅緋（忍転身後の姿）が球体化(スーパーマリオボール風)されてしまうイラストをお願いします。\n\n・丸い姿になっても胸の盛り上がりはそのままで。\n・表情は驚いてる感じで。\n\n球体化参考↓\n（https://youtu.be/7qLWPDdJQOw?si=MQxYEnKxyaArmETB）球体化3Dモデル\n\nhttps://twitter.com/se7cond/status/1326920910582984707?t=eGJM0xeaLv0DaEvH7DH9QQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/16", "thumbnail_src": "https://si.imgix.net/79abfb77/uploads/origins/54bc6140-fe43-44b1-8069-4ccbfbd59dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36374691a72e2a677c792e4597b0024", "thumbnail_srcset": "https://si.imgix.net/79abfb77/uploads/origins/54bc6140-fe43-44b1-8069-4ccbfbd59dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36374691a72e2a677c792e4597b0024, https://si.imgix.net/79abfb77/uploads/origins/54bc6140-fe43-44b1-8069-4ccbfbd59dae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5aefa005ed2642cfe62b34aee85c7757 2x, https://si.imgix.net/79abfb77/uploads/origins/54bc6140-fe43-44b1-8069-4ccbfbd59dae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=118e264cbc7b98889c670d50ae220c0b 3x", "genre": "art", "nsfw": false, "body": "球体化という特殊なジャンルになります。\n描きたくなかったらキャンセルを。\n\nリオパラダイス、メインヒロインのリオちゃんが球体化(スーパーマリオボール風)されてしまうイラストをお願いします。\n\n・丸い姿になっても胸の盛り上がりはそのままで。\n・表情は驚いてる感じで。\n\n球体化参考↓\n（https://youtu.be/7qLWPDdJQOw?si=MQxYEnKxyaArmETB）球体化3Dモデル\n\nhttps://twitter.com/se7cond/status/1326920910582984707?t=eGJM0xeaLv0DaEvH7DH9QQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/15", "thumbnail_src": "https://si.imgix.net/3cb1cd1c/uploads/origins/da1168e8-f2e7-4106-b70b-0612f5a087a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0048bc3ee9776e3e15afe10d8c97f4fa", "thumbnail_srcset": "https://si.imgix.net/3cb1cd1c/uploads/origins/da1168e8-f2e7-4106-b70b-0612f5a087a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0048bc3ee9776e3e15afe10d8c97f4fa, https://si.imgix.net/3cb1cd1c/uploads/origins/da1168e8-f2e7-4106-b70b-0612f5a087a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=706386238e52c9d6c7bdbc7bc03016eb 2x, https://si.imgix.net/3cb1cd1c/uploads/origins/da1168e8-f2e7-4106-b70b-0612f5a087a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c51a46b5d55aa9c1b7845728b2ae319 3x", "genre": "art", "nsfw": false, "body": "はじめまして、リクエストをお願いします。\n僕のVの姿である「乙羽衣 乃音(おっぱい のおと)」がせくしーポーズをしているものをまんじゅう絵でお願いしたいです。\n「うふーんあはーん」等のせくしーな台詞も入れてください。\nポーズや表情はお任せします。\n\n描いていただいたものはXへの投稿等個人利用の範疇で使用させていただきたいです。\n何卒ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/file/d/1PQsIBur3pousfL17Na7Vt4oXPq5N2vlM/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/14", "thumbnail_src": "https://si.imgix.net/d0fbb10d/uploads/origins/39c47489-2c04-48a1-ae00-b0dc11ed5494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce588794ad069c6f12bd6cb987c2797d", "thumbnail_srcset": "https://si.imgix.net/d0fbb10d/uploads/origins/39c47489-2c04-48a1-ae00-b0dc11ed5494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce588794ad069c6f12bd6cb987c2797d, https://si.imgix.net/d0fbb10d/uploads/origins/39c47489-2c04-48a1-ae00-b0dc11ed5494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b6d8f49d215c75c5ee75d6bf43796d 2x, https://si.imgix.net/d0fbb10d/uploads/origins/39c47489-2c04-48a1-ae00-b0dc11ed5494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ad4b43a790989c3a5c89f49e445f882 3x", "genre": "art", "nsfw": true, "body": "skebでは初めて挨拶します！\n\n可能であれば、私のオリジナルキャラクター「エルザイム」が灯夏子さんの過去作品の一つである「危険なモン娘」シリーズのうち「ふたなりスライム」編に登場したふたなりスライムに設定と同様に敗北後同族化される内容のイラストお願いします！\n変化後の見た目は、ヘアスタイルの形を除けば全てふたなりスライムの同族にふさわしい姿をお願いします！\n\nエルザイムの資料であり、できればよろしくお願いします！\nエルザイム：https://drive.google.com/drive/folders/1qKmFo7N5TpAV8_1Og5nbzgw9Z7JFiXsR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/13", "thumbnail_src": "https://si.imgix.net/783cdd9a/uploads/origins/05499c34-8d34-4736-b166-50427c1b7c23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3983eba7d8af4cb13dd44e46cb1310bd", "thumbnail_srcset": "https://si.imgix.net/783cdd9a/uploads/origins/05499c34-8d34-4736-b166-50427c1b7c23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3983eba7d8af4cb13dd44e46cb1310bd, https://si.imgix.net/783cdd9a/uploads/origins/05499c34-8d34-4736-b166-50427c1b7c23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2204ca134535c66a32c7e32961378e2c 2x, https://si.imgix.net/783cdd9a/uploads/origins/05499c34-8d34-4736-b166-50427c1b7c23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c1894396b9d6386513aba8eb151178f 3x", "genre": "art", "nsfw": true, "body": "夏子さんのカスミ幻湯流入浴技トルコ入浴絵に無限の可能性を感じましたので依頼しました。\nキサラギ三姉妹のカスミ・フブキ・ホムラが三人同時幻湯流入浴技トルコ入浴してるシチュをお願いできますでしょうか。\n三人とも表情は虚ろ目笑顔でこちらを向いている感じでお願いします。\n\nhttps://twitter.com/tomosibinatuko/status/1674436434470772736", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/12", "thumbnail_src": "https://si.imgix.net/efe8ce8b/uploads/origins/b84adeb2-9db5-4855-8cc4-be83c040c5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43753b6c207d43613fbee4be72568a56", "thumbnail_srcset": "https://si.imgix.net/efe8ce8b/uploads/origins/b84adeb2-9db5-4855-8cc4-be83c040c5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43753b6c207d43613fbee4be72568a56, https://si.imgix.net/efe8ce8b/uploads/origins/b84adeb2-9db5-4855-8cc4-be83c040c5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9670d5884f47f33c509a7d8e9a7e1bc 2x, https://si.imgix.net/efe8ce8b/uploads/origins/b84adeb2-9db5-4855-8cc4-be83c040c5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ed9f2ee5d7796c0a055257fd94f5cf5 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\n直近の爆乳イラストがとても素晴らしく、ぜひ描いていただきたいと思い、リクエストさせていただきます。\nオリジナルキャラクターでもよろしければ、うちの子の「リサリシア・オルプラッツ」のイラストをお願いします。\n資料URLに、外見や設定などを記載したスクリーンショットを格納してあります。\n衣装は資料内の「ファンタジー」で、健全版と、R18差分で胸を強調しているバージョンをお願いします。胸はどちらも盛りまくってください。\nそれ以外のポーズと構図はお任せします。\n健全版は個人観賞用にアクリルスタンドにしたいと思っているので、背景を別レイヤーでお願いします。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1qXBVnZgs-Qua6H6TBvYlqN05qSUhvPsV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/11", "thumbnail_src": "https://si.imgix.net/3e1cfcd3/uploads/origins/5075f315-fd74-4fb6-9744-49727a623aff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ab68df0ca9e3f389b585d793f00b5b4", "thumbnail_srcset": "https://si.imgix.net/3e1cfcd3/uploads/origins/5075f315-fd74-4fb6-9744-49727a623aff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ab68df0ca9e3f389b585d793f00b5b4, https://si.imgix.net/3e1cfcd3/uploads/origins/5075f315-fd74-4fb6-9744-49727a623aff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=164e00a496728bdf48fe31941cd35622 2x, https://si.imgix.net/3e1cfcd3/uploads/origins/5075f315-fd74-4fb6-9744-49727a623aff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd0ef4b9242186cc8b34552468b93c10 3x", "genre": "art", "nsfw": false, "body": "平素よりツイート楽しく拝見しております。\nこの度Twitter他のアイコンを変えたく思い依頼させていただきます。\n『原神』というゲーム作品の『雲菫』というキャラクターのまんじゅうイラストをお願いいたします。\nポーズは資料URLの45秒付近のような感じでお願いできればと思います。\n\nお忙しいなか恐れ入りますが、ご検討の程よろしくお願いいたします。\n\nhttps://youtu.be/XioUigM5BMQ", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/10", "thumbnail_src": "https://si.imgix.net/ed573797/uploads/origins/a4f5ab6d-ac98-4520-af64-8802c7270b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3008c3d654ab60afa63458b00ff9ac2f", "thumbnail_srcset": "https://si.imgix.net/ed573797/uploads/origins/a4f5ab6d-ac98-4520-af64-8802c7270b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3008c3d654ab60afa63458b00ff9ac2f, https://si.imgix.net/ed573797/uploads/origins/a4f5ab6d-ac98-4520-af64-8802c7270b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c0c3ed44bb83aabd683ed93bdae6448 2x, https://si.imgix.net/ed573797/uploads/origins/a4f5ab6d-ac98-4520-af64-8802c7270b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5d3c222f8e5385527fbef44ce776544 3x", "genre": "art", "nsfw": false, "body": "こんばんは\n初リクエスト出します\n物語シリーズの阿良々木火憐のまんじゅうを描いて頂きたいです\n出来れば夏子さんの代名詞の揉め事バージョンの差分等もお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/9", "thumbnail_src": "https://si.imgix.net/2fb938f7/uploads/origins/7dff4669-a97f-4c1b-8236-a3fbdab7738a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ddc00e30ff2587a2c95d910dd3b830", "thumbnail_srcset": "https://si.imgix.net/2fb938f7/uploads/origins/7dff4669-a97f-4c1b-8236-a3fbdab7738a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ddc00e30ff2587a2c95d910dd3b830, https://si.imgix.net/2fb938f7/uploads/origins/7dff4669-a97f-4c1b-8236-a3fbdab7738a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caa026da1b72ac6808474c09fc7e7c6d 2x, https://si.imgix.net/2fb938f7/uploads/origins/7dff4669-a97f-4c1b-8236-a3fbdab7738a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4182b279c55ea1b4b3a3d98c61b47b5f 3x", "genre": "art", "nsfw": true, "body": "麻雀物語の風上あやかちゃんの巨乳化が進んでいるので乙女フェスティバルのアニマるんの時のあやかちゃんの衣装で上も下もおっぱいがはみ出てしまうほど大きく盛られているシーンをお願いします。\n\nR18差分であの胸の布無しのサスペンダーのみでおっぱいを支えてる状態もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/8", "thumbnail_src": "https://si.imgix.net/649c97da/uploads/origins/be91ff3d-006d-4e60-9967-d96d99287343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2359a772f1c21c2514a3fe0acdb4394a", "thumbnail_srcset": "https://si.imgix.net/649c97da/uploads/origins/be91ff3d-006d-4e60-9967-d96d99287343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2359a772f1c21c2514a3fe0acdb4394a, https://si.imgix.net/649c97da/uploads/origins/be91ff3d-006d-4e60-9967-d96d99287343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=690009a5f3f5f4af12ae490cb0e4d79c 2x, https://si.imgix.net/649c97da/uploads/origins/be91ff3d-006d-4e60-9967-d96d99287343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c8c4d5d27c56ae7cfe3c70a8da22e45 3x", "genre": "art", "nsfw": true, "body": "えっちなパトランランをお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tomosibinatuko/works/7", "thumbnail_src": "https://si.imgix.net/ae4be9ee/uploads/origins/71714a8d-64de-4025-a088-817f02daf847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ac350ac7fd7300f4fbf571922adcae3", "thumbnail_srcset": "https://si.imgix.net/ae4be9ee/uploads/origins/71714a8d-64de-4025-a088-817f02daf847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ac350ac7fd7300f4fbf571922adcae3, https://si.imgix.net/ae4be9ee/uploads/origins/71714a8d-64de-4025-a088-817f02daf847?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6737acb129a565da01bf4897629ffd6c 2x, https://si.imgix.net/ae4be9ee/uploads/origins/71714a8d-64de-4025-a088-817f