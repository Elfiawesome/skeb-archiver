FF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fda65e56d9091048a05d47b54e6c73ef 2x, https://si.imgix.net/26c1afcf/uploads/origins/52f54520-d447-4c46-b96f-1beec86f962f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0558442e1344d2dfab73039352a956f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@910_ch/works/30", "thumbnail_src": "https://si.imgix.net/9b18c396/uploads/origins/f8a8c7c2-654f-4d70-9120-d27df85ca481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=348a5194bb0a5d3b7f77f7fb9ca9bc4b", "thumbnail_srcset": "https://si.imgix.net/9b18c396/uploads/origins/f8a8c7c2-654f-4d70-9120-d27df85ca481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=348a5194bb0a5d3b7f77f7fb9ca9bc4b, https://si.imgix.net/9b18c396/uploads/origins/f8a8c7c2-654f-4d70-9120-d27df85ca481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0d7475596803d6121cb1acfe9539ae5 2x, https://si.imgix.net/9b18c396/uploads/origins/f8a8c7c2-654f-4d70-9120-d27df85ca481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81eb3689d0b34fd8df0b3e5eb5c3eb90 3x", "genre": "art", "nsfw": false, "body": "はじめまして、くとう。くとうの描く全身イラストが大好きで\nhttps://skeb.jp/@910_ch/works/10\nhttps://skeb.jp/@910_ch/works/8\nhttps://skeb.jp/@910_ch/works/27\n自分も欲しくなりました。私のOCフローレンスを描いて欲しいです。\n\n彼らは感情をあまり感じないオンコールワーカーだ。顔の表情がかなり苦手なので、身振り手振りとボディランゲージを使う。自分を表現するために、ボディランゲージに付随する意志で操るたくさんの紙人形に頼っているのだ。平均より少し背が高い。白い手袋をはめさせる。リボンは鋭く尖っている。\n\nポーズと構図はお任せします。\n本やトランクケースのようなオブジェクトを描く必要はない。ポーズとジェスチャーに重点を置いてください。\n\n白い紙でできたいくつかの紙人形と黒い紙でできた紙人形がフローレンスの周りを漂っているのを見たい。ドライブ \"ef \"の画像は、紙人形とフローレンスの間に見てみたいエフェクトだ。添付した画像「eye」のような三角形のハイライトが欲しい、いろいろな角度で描く方法がわからない。\n\nご検討ありがとうございました。適切でなければ拒否する\n\nhttps://drive.google.com/drive/u/1/folders/1uTCB5so31shvDOJpAazYWTotIYmsYzxW", "created_at": "",