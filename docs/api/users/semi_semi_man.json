-47b2-8042-fc7f3abaacfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60fb415aaba362bbf5ac7a686ad22ee8 2x, https://si.imgix.net/1cd2764f/uploads/origins/aff68acc-d5e8-47b2-8042-fc7f3abaacfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=119126e3f2bbba371ef24f5468942578 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの画風とカジュアルな服装のイラストが大好きです！私のOC、ドウメキガンタイを描いてくれませんか？\n\nGantaiは未来の黙示録から来たソルジャーで、左目にタイムトラベルの能力を持っています。\n\n構図は、このイラストのようなカジュアルな服をデザインしてほしい：\nhttps://skeb.jp/@semi_semi_man/works/25\nhttps://skeb.jp/@semi_semi_man/works/29\nhttps://skeb.jp/@semi_semi_man/works/40。\n\n以下にガンタイの参考写真を添付する。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1KxhLtwAnnPxemDx3KdIilF7G3nmpSCiz/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@semi_semi_man/works/67", "thumbnail_src": "https://si.imgix.net/9b496f4c/uploads/origins/dae6f1d1-fc92-4c8f-befb-13a3d3ca2a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=860b0abb9b001fbed35ab87637c67253", "thumbnail_srcset": "https://si.imgix.net/9b496f4c/uploads/origins/dae6f1d1-fc92-4c8f-befb-13a3d3ca2a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=860b0abb9b001fbed35ab87637c67253, https://si.imgix.net/9b496f4c/uploads/origins/dae6f1d1-fc92-4c8f-befb-13a3d3ca2a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf986f31c42adc8ef7e56c4ae9f8fdb6 2x, https://si.imgix.net/9b496f4c/uploads/origins/dae6f1d1-fc92-4c8f-befb-13a3d3ca2a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d5684228005aaa0f3b469dea0cb65a7 3x", "genre": "art", "nsfw": false, "body": "こんにちは、セミコロン先生。私のOC二人のために服をデザインしていただけませんか？キャラクターは私のOCカップル、42歳の厳格で背の高いハンサムな教授と22歳の博士課程の女子学生です。キャラクターのルックスはリンクを参照してください。先生の好きなように描いてください\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/19cbjRpQnCriqqQL-wOcZLhPpfupXQRnZ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@semi_semi_man/works/66", "thumbnail_src": "https://si.imgix.net/5850637d/uploads/origins/11f37676-d39b-4037-9ddd-159d99720572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a11be387978456fceaffb69ae58ed9e3", "thumbnail_srcset": "https://si.imgix.net/5850637d/uploads/origins/11f37676-d39b-4037-9ddd-159d99720572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a11be387978456fceaffb69ae58ed9e3, https://si.imgix.net/5850637d/uploads/origins/11f37676-d39b-4037-9ddd-159d99720572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcfe3f22a9a6fc76c2d4dbb3a1677723 2x, https://si.imgix.net/5850637d/uploads/origins/11f37676-d39b-4037-9ddd-159d99720572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bc63fc29d546b6e70c4aa4f8408f6f3 3x", "genre": "art", "nsfw": false, "body": "semicolon様はじめまして！あめふり（※TRPG名義）と申します。\n素敵な衣装デザインの数々拝見し、ぜひともTRPGで使用しているOCの別衣装をお願いしたい…！と思いましたのでリクエストさせて頂きます。\n用途は個人観賞用＆キャラクター資料画像、もしかするとオンラインセッション時の立ち絵等、非営利かつ個人利用の範囲で利用させて頂ければ幸いです。\n可能であればキャラ単体の透過png画像をつけて頂くか、背景とは別にキャラ単体で表示可能なPSDデータで納品頂けると嬉しく思います…！\n\n■リクエスト内容：ギーゼルヘーア・エルフェンバイン\n・ドイツ系白人／男性／53歳／185㎝前後\n・招聘教授(国際政治学)として各国を渡り歩くインテリ\n・ほぼ眉なしの強面、深い眼窩、鋭い切れ長の眼、色白で長身痩躯等々、不気味な印象を与える風貌\n┗細腰ですらりとしてるのでスタイル(だけ)は良い\n・左耳に刃物による切り傷有(生活には特に支障なし)\n・打算的で飄々とした老獪な性格\n┗慇懃な敬語で喋るが、根は冷徹であり時々小声で暴言を吐くことも\n・基本はスーツ姿。派手ではないがブランド物で品が良さそう\n・好む服装は暗色系統でフォーマル寄りのイメージ\n┗ロングコートや中折れ帽等も似合うかも\n\n世界観は現代で、今は仕事で再会したかつての仲間（https://skeb.jp/@wvr_h/works/30）と行動を共にすることが多いです。\n一応イメージ等書いてはおりますが、容姿や雰囲気を元にsemicolon様のお好みでご自由にデザインして頂けると嬉しいです！\n\n不都合等ありましたら遠慮なくキャンセルや再送依頼くださいませ。\nお手数おかけしますが、ご検討だけでも宜しくお願い致します*ᴗ ᴗ)⁾⁾\n\nhttps://www.foriio.com/works/206114", "created_at": "", "completed_at": ""}, {"path": "/@semi_semi_man/works/65", "thumbnail_src": "https://si.imgix.net/42f845da/uploads/origins/fb64aae1-f8bf-451b-98df-c170fe8fadde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d863b1cd1cd89310246bd9ed2f9e531", "thumbnail_srcse