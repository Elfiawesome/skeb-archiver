下げている指輪は大切なものなので、他の服を着ていても残すようお願いします。\n-カルマ\n・シャツ＋ジャケットなど、少しだけかっちりした服装。着崩しや派手柄も可。\n・アクセサリーの変更や付け足しは自由です。\n\n○使用用途\n個人鑑賞、個人利用の範囲で印刷などのグッズ化、SNSや友人への共有、TRPG立ち絵としての使用、衣装を参考にした上での別のイラスト化\n\n以上になります。ご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dZjGSZrCXQxoHw_XmuxUCr3lfh-5rGv6", "created_at": "", "completed_at": ""}, {"path": "/@semi_semi_man/works/83", "thumbnail_src": "https://si.imgix.net/48702fdd/uploads/origins/883dfcba-42c2-40c9-9146-11e3cca2e665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0299c156d343bd8833ce1323a645e063", "thumbnail_srcset": "https://si.imgix.net/48702fdd/uploads/origins/883dfcba-42c2-40c9-9146-11e3cca2e665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0299c156d343bd8833ce1323a645e063, https://si.imgix.net/48702fdd/uploads/origins/883dfcba-42c2-40c9-9146-11e3cca2e665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77b24448a1ae49d7daa668c63b8b9e12 2x, https://si.imgix.net/48702fdd/uploads/origins/883dfcba-42c2-40c9-9146-11e3cca2e665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f88135c6b4ea9254a2513edf104c9d0e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@semi_semi_man/works/82", "thumbnail_src": "https://si.imgix.net/d62cca62/uploads/origins/1ffb9f16-33fc-402e-8aea-ac0ecb1fec62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7b8040bb6d99011c1d0326eedcd26e9", "thumbnail_srcset"