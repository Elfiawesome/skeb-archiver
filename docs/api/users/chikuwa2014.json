4cba-b408-bcf40b28f6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07d7e6c3db9cbb2bcfd35f866a571aa4 2x, https://si.imgix.net/17e35ca8/uploads/origins/ce3739af-80cc-4cba-b408-bcf40b28f6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55769448fad2357b93d7c167f9e0a9a6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/31", "thumbnail_src": "https://si.imgix.net/5d8fb92c/uploads/origins/27eb3eaa-a6e4-4d4b-82f3-3a1191795325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88d6681d11fac434a02220af86c84280", "thumbnail_srcset": "https://si.imgix.net/5d8fb92c/uploads/origins/27eb3eaa-a6e4-4d4b-82f3-3a1191795325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88d6681d11fac434a02220af86c84280, https://si.imgix.net/5d8fb92c/uploads/origins/27eb3eaa-a6e4-4d4b-82f3-3a1191795325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f2ca636cb9de03f5b4708124a8aea2b 2x, https://si.imgix.net/5d8fb92c/uploads/origins/27eb3eaa-a6e4-4d4b-82f3-3a1191795325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=493c27d2edcdeb344b2266d30b693a6b 3x", "genre": "comic", "nsfw": true, "body": "シチュ：シャニマスでＰが恋鐘、冬優子、果穂との大富豪中に色仕掛けされ大貧民になる\n　「〇〇を出してほしい」「パスしてほしい」といった言葉とともに恋鐘がブラチラ、冬優子がパンチラで誘惑し先抜けする。\n　向かいに座る果穂とＰが残る。恋鐘が背中に胸を押し当て耳元で囁き、冬優子がテーブルの下で亀頭への息吹きかけやキスで焦らし続けパスさせようとする（果穂は大富豪に集中していて気づいてない）\n　Ｐが誘惑に負けてパスし果穂が勝つ。恋鐘が果穂と話している間に冬優子のご褒美バキュームフェラで口内射精。\n　３人から楽しかったからまたやろうと誘われてＥＮＤ\n　内容が多くなりますが何卒宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/30", "thumbnail_src": "https://si.imgix.net/51780c20/uploads/origins/52c40b72-6eb2-4248-895a-737c0aa5f014?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fd39c67af83534ecf3e6582a97f5b38", "thumbnail_srcset": "https://si.imgix.net/51780c20/uploads/origins/52c40b72-6eb2-4248-895a-737c0aa5f014?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fd39c67af83534ecf3e6582a97f5b38, https://si.imgix.net/51780c20/uploads/origins/52c40b72-6eb2-4248-895a-737c0aa5f014?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bc7d7aca9383c6289c69294fcfd51ca 2x, https://si.imgix.net/51780c20/uploads/origins/52c40b72-6eb2-4248-895a-737c0aa5f014?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5ec2ae476326772e2d730fae9a18e4a 3x", "genre": "art", "nsfw": true, "body": "◇テーマ\nURL資料絵のコス、シチュエーションのデレマスの緒方智恵理のイラスト\n\n◇設定\n・シチュは性的な攻めだが大きさが違いすぎる敵にいつ殺されるやも分からないまま人形のように弄ばれる恐怖をメインの感情として描き、それでも性器や胸を弄られて性的に責められ感じる絶頂しそうになっている。\nという緒方智恵理の浮かべる表情は過去作の三コマ目に恐怖を足したような感じにしてほしい\n・着ぐるみ衣装は極力URLと同じに描きアレンジはしないでほしい\n・髪は前髪だけ着ぐるみから出し、ツインテールは外に出さないでほしい\n・衣装の汚れはOK、破れるのはNG\n・URLより全体的にダイナミックなイメージにして欲しい。\n\nhttps://skeb.jp/@hiyamgitune/works/28", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/29", "thumbnail_src": "https://si.imgix.net/a936683f/uploads/origins/0ded7cc1-e5c8-4c64-9c3d-3a49baa27e27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d8c090c74100b63f8efe87c382c559a", "thumbnail_srcset": "https://si.imgix.net/a936683f/uploads/origins/0ded7cc1-e5c8-4c64-9c3d-3a49baa27e27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d8c090c74100b63f8efe87c382c559a, https://si.imgix.net/a936683f/uploads/origins/0ded7cc1-e5c8-4c64-9c3d-3a49baa27e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ff22c05a63fb9cdb545e1a749527f95 2x, https://si.imgix.net/a936683f/uploads/origins/0ded7cc1-e5c8-4c64-9c3d-3a49baa27e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a252bdb2880cddd720d9288a0c364147 3x", "genre": "comic", "nsfw": true, "body": "えっちな千雪の漫画をお願いします。\n\n可能であれば2ページくらいで４場面くらい。\n\n千雪激似のソープ嬢を指名したら千雪本人だった。\nえっちな下着でお出迎えする千雪で１コマ。\n\nとりあえずパイズリしてもらった。\n「お客さんみんなが気持ち良いって言ってくれる評判のパイズリです♡」と結構ノリノリの千雪で１コマ。\n\n千雪の好きな騎乗位セックスで担当アイドルとの初めて。\n「Pさんのオチンポ、大き過ぎなくてちょうど良いです♡」と乳を揺らす千雪で１コマ。\n\n最後は「この後空いてるか？」「ごめんなさい、この後は常連のおじさまとラブラブ180分コースなんです♡」というオチで１コマ。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/28", "thumbnail_src": "https://si.imgix.net/6496dde5/uploads/origins/ba6c0615-67ad-4a1f-8d88-e07de34bbf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c540cdc72b1b1b5fd2cb4194ea30e961", "thumbnail_srcset": "https://si.imgix.net/6496dde5/uploads/origins/ba6c0615-67ad-4a1f-8d88-e07de34bbf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c540cdc72b1b1b5fd2cb4194ea30e961, https://si.imgix.net/6496dde5/uploads/origins/ba6c0615-67ad-4a1f-8d88-e07de34bbf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a61e095db4c25fe093231e4cc0c945b4 2x, https://si.imgix.net/6496dde5/uploads/origins/ba6c0615-67ad-4a1f-8d88-e07de34bbf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dc120cc42b28ddeacf84980e780c29f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/27", "thumbnail_src": "https://si.imgix.net/78659c43/uploads/origins/3f1d22f9-d646-4ea2-843d-1691fb9709ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1122f1f4fb18b174a808da47c5e4791a", "thumbnail_srcset": "https://si.imgix.net/78659c43/uploads/origins/3f1d22f9-d646-4ea2-843d-1691fb9709ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1122f1f4fb18b174a808da47c5e4791a, https://si.imgix.net/78659c43/uploads/origins/3f1d22f9-d646-4ea2-843d-1691fb9709ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a6a77f77187ed8543578a097f9ce782 2x, https://si.imgix.net/78659c43/uploads/origins/3f1d22f9-d646-4ea2-843d-1691fb9709ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01c3350baedd54e05ee8b401c1a82451 3x", "genre": "art", "nsfw": true, "body": "こんにちは竹輪先生。\n今回依頼したいのはブルーアーカイブの二次創作をリクエストさせていただきたいです。\n\nキャラクターは生塩ノアと先生\n\nうしお（牛尾）だけに牛コスをしたノアの乳を母乳も出ないのに絞ったり、ほんとに母乳が出るように種付けする感じでお願いします。\n\nできればやって欲しい事（ムリそうなら無視してもらって構いません）\n先生がハゲでない、かつちんちんが大きい\n負けノア風味で喘ぎ声は下品め\nあまり盛るペコしない\n隠れ牛尾さん（遊戯王5Ds）を隠す\n以上です\n\nご都合が合えば依頼を受けてくださると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/26", "thumbnail_src": "https://si.imgix.net/580bb327/uploads/origins/43f9ea0e-3460-493c-9b84-e7f055d54794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d403001ad633f6e449bef3895aa7ba9", "thumbnail_srcset": "https://si.imgix.net/580bb327/uploads/origins/43f9ea0e-3460-493c-9b84-e7f055d54794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d403001ad633f6e449bef3895aa7ba9, https://si.imgix.net/580bb327/uploads/origins/43f9ea0e-3460-493c-9b84-e7f055d54794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f21bc037d85382779a80e121dfc412e 2x, https://si.imgix.net/580bb327/uploads/origins/43f9ea0e-3460-493c-9b84-e7f055d54794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59ed5dc2e539e94b77b3be7c035e1688 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/25", "thumbnail_src": "https://si.imgix.net/132467eb/uploads/origins/c689225c-63ff-4767-9991-b02a277fbac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c7f4563717c6bb6f2a09fac1196224", "thumbnail_srcset": "https://si.imgix.net/132467eb/uploads/origins/c689225c-63ff-4767-9991-b02a277fbac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c7f4563717c6bb6f2a09fac1196224, https://si.imgix.net/132467eb/uploads/origins/c689225c-63ff-4767-9991-b02a277fbac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1de498a773aa88c1e52e847ce8dfb2ce 2x, https://si.imgix.net/132467eb/uploads/origins/c689225c-63ff-4767-9991-b02a277fbac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4e089481213a257063eb544a2ef0f1a 3x", "genre": "art", "nsfw": true, "body": "初めまして\n樋口円香がPを襲っているイラストをお願いします\n背景\n・貞操観念が逆転してる世界\n・Pは事務所の皆からセクハラされていて、襲われそうになったら「結婚を前提に付き合っている彼女」の存在を盾に凌いでいた\n・円香はほぼ唯一Pにセクハラをしてこず寧ろやんわりと助け船を出してくれる安全地帯だったのでPも信頼しており、つい彼女なんていないし童貞だという事を漏らしてしまう\n・流石に彼女に悪いと想いを抑えて混んでいたが、思いがはじける\n\n構図など\n・何度目かの中出しで、何か皮肉を言われながら搾り取られているシーン\n・円香の服装はお任せしますが、はだけた姿\n・Pの描写は不要です。映ってもシルエットで", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/24", "thumbnail_src": "https://si.imgix.net/502317ba/uploads/origins/fd2bb425-cbd6-43b2-b6e4-6a0b31c154cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=becee38a3245fd613b3558b06bbc81d8", "thumbnail_srcset": "https://si.imgix.net/502317ba/uploads/origins/fd2bb425-cbd6-43b2-b6e4-6a0b31c154cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=becee38a3245fd613b3558b06bbc81d8, https://si.imgix.net/502317ba/uploads/origins/fd2bb425-cbd6-43b2-b6e4-6a0b31c154cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7164a46ce4e5607640a9b7025d5fab62 2x, https://si.imgix.net/502317ba/uploads/origins/fd2bb425-cbd6-43b2-b6e4-6a0b31c154cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a06399d19f61745ad2e88cf4664bcb41 3x", "genre": "art", "nsfw": true, "body": "https://x.com/chikuwa2014/status/1850001265037803834?t=1XnRQfRHqSTG0tOi3fKK0g&s=19\n初めまして。\nTwitterにあげられていた円香さんの漫画のIFルートで、我慢できずにプロデューサーを襲って既成事実作ってしまう1ページR18漫画をお願いします。\nブラがズレて乳房が片方見えてると良いです。", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/23", "thumbnail_src": "https://si.imgix.net/9b24a278/uploads/origins/f8bbdfac-fd4e-4cb6-9d0c-884943489487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c382c000ca68abc54866c9ecd1856308", "thumbnail_srcset": "https://si.imgix.net/9b24a278/uploads/origins/f8bbdfac-fd4e-4cb6-9d0c-884943489487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c382c000ca68abc54866c9ecd1856308, https://si.imgix.net/9b24a278/uploads/origins/f8bbdfac-fd4e-4cb6-9d0c-884943489487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62c68daab6404cc6251eb17a802a3f83 2x, https://si.imgix.net/9b24a278/uploads/origins/f8bbdfac-fd4e-4cb6-9d0c-884943489487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba9fafdfd6d0a49616660a762d1b750b 3x", "genre": "art", "nsfw": true, "body": "衣装が入らなかった罰として全裸で体型チェックされる園田智代子をお願いします。\n\n体型はぽちゃ気味の爆乳で、乳輪をめちゃくちゃデカくお願いしたいです。\n全身汗だくのムワムワで、手を頭の後ろに回した腋見せの直立ポーズをキープさせられて顔真っ赤にしてる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@chikuwa2014/works/22", "thumbnail_src": "https://si.imgix.net/11cd529b/uploads/origins/0a13a5ee-f592-434e-8a66-9e0afaa202f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4aaac0507dc6b64f3472fbb252756662", "thumbnail_srcset"