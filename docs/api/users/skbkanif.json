0-fd72c6735f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388897733ff3a48b5f7af25a8fc87b6e", "thumbnail_srcset": "https://si.imgix.net/be3777f5/uploads/origins/db283a78-7298-42a6-8020-fd72c6735f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388897733ff3a48b5f7af25a8fc87b6e, https://si.imgix.net/be3777f5/uploads/origins/db283a78-7298-42a6-8020-fd72c6735f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64611493ceac55a4beb0b0092c443399 2x, https://si.imgix.net/be3777f5/uploads/origins/db283a78-7298-42a6-8020-fd72c6735f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cee99b3d3f47d4033199ff240c6020c6 3x", "genre": "art", "nsfw": true, "body": "こんにちは！人魚のメロディーのピチピチピッチの人魚のルキアを描いてもらえませんか？\nマグロのようにまな板の上で刺身になって生まれ変わった姿を描いてください。\nポーズや全身の表情はお好みでお願いします。\nhttps://www.pixiv.net/artworks/83105411\n\nhttps://www.pngwing.com/en/free-png-yrmog", "created_at": "", "completed_at": ""}, {"path": "/@skbkanif/works/117", "thumbnail_src": "https://si.imgix.net/028f3d30/uploads/origins/79fcbf73-33c8-4a55-97e9-755606a22b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bda845ae773a9c9a01e59b619ad146c", "thumbnail_srcset": "https://si.imgix.net/028f3d30/uploads/origins/79fcbf73-33c8-4a55-97e9-755606a22b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bda845ae773a9c9a01e59b619ad146c, https://si.imgix.net/028f3d30/uploads/origins/79fcbf73-33c8-4a55-97e9-755606a22b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ba547eb3446e41231946da8c09b1c43 2x, https://si.imgix.net/028f3d30/uploads/origins/79fcbf73-33c8-4a55-97