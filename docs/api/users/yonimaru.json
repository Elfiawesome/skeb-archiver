a7-4e8e-9662-2feae84f6ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a61662990f5c5a0b1a68ce5a186f44f", "thumbnail_srcset": "https://si.imgix.net/0a52ce5d/uploads/origins/45e4904f-d5a7-4e8e-9662-2feae84f6ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a61662990f5c5a0b1a68ce5a186f44f, https://si.imgix.net/0a52ce5d/uploads/origins/45e4904f-d5a7-4e8e-9662-2feae84f6ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e30cd9778c80b028f3e5817d9ce542f7 2x, https://si.imgix.net/0a52ce5d/uploads/origins/45e4904f-d5a7-4e8e-9662-2feae84f6ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5106542a74b8825240323545cbb845ae 3x", "genre": "art", "nsfw": false, "body": "ヨニマル先生お疲れ様です。\nこの度我が家の三兄弟を描いて頂きたくご依頼しました。\n資料にアイドル時の衣装と私服がありますが、忠実に描かなくても大丈夫です。どちらで描くかもヨニマル先生にお任せします。\n構図等も特に指定はありませんが、強いて言うなら 距離感がバグってる3人なので、距離が近いとありがたいです🙇‍♀️(雑誌の撮影みたいなイメージです)\nぜひご検討よろしくお願いします。\n\nこちらにも資料置きます↓\n(ツリーの資料は補足が手書きで描いてある画像になります)\nhttps://x.com/xcGXx_/status/1827631596146741293?t=6YGPqRdvLVCZ0VOcF7v-kA&s=19\n\nhttps://x.com/xcGXx_/status/1827631596146741293?t=gvfRiQsrDUYTo2q_pW3lZQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@yonimaru/works/127", "thumbnail_src": "https://si.imgix.net/60ab0eb1/uploads/origins/09f5e0a3-a0d8-4f04-9519-dcc07999da92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3088c4e24bc9be2580b446fdca4fefe5", "thumbnail_srcset": "https://si.imgix.net/60ab0eb1/uploads/origins/09f5e0a3-a0d8-4f04-9519-dcc07999da92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3088c4e24bc9be2580b446fdca4fefe5, https://si.imgix.net/60ab0eb1/uploads/origins/09f5e0a3-a0d8-4f04-9519-dcc07999da92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc980309ff50c7ea86e71dfde13a6175 2x, https://si.imgix.net/60ab0eb1/uploads/origins/09f5e0a3-a0d8-4f04-9519-dcc07999da92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56e68457f8f9e2431b2acfc194f671d5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、アピールをありがとうございます！私のオーク：インを描いてもらいたいです！彼はいつも笑っている怪しい感じのキャラクターです。\n\n白いロングヘアのポニーテール。\n\n両耳にピアスをしている。\n白いドレスシャツに濃紺のネクタイ。\n黒い毛皮のフードが付いた白いコートを着ている。\n黒い指なし手袋をしている。\n\nもしご迷惑でなければ、サングラスをかけたバージョンとかけてないバージョンが欲しいです。\n\n構図や雰囲気はあなた次第です！\n\nhttps://drive.google.com/drive/folders/1bMN4Tfp4DFCz3CsvzTvw22X2TMoyTFFd?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yonimaru/works/126", "thumbnail_src": "https://si.imgix.net/37188cdc/uploads/origins/e989bbf8-252b-4562-9b60-7a7792cf527e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c34d7d9a9ae9289785d203f04ec03035", "thumbnail_srcset": "https://si.imgix.net/37188cdc/uploads/origins/e989bbf8-252b-4562-9b60-7a7792cf527e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c34d7d9a9ae9289785d203f04ec03035, https://si.imgix.net/37188cdc/uploads/origins/e989bbf8-252b-4562-9b60-7a7792cf527e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d49d07c163919fedbf3b1c7ad5b17907 2x, https://si.imgix.net/37188cdc/uploads/origins/e989bbf8-252b-4562-9b60-7a7792cf527e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a3034f4e8d3f830e3f0009140e2d5ce 3x", "genre": "art", "nsfw": false, "body": "はじめまして。アピールありがとうございます。\n\nリクエスト内容\n当方オリジナルキャラのダナス(資料URLの「ダナス=アカティーク」の項をご参照ください)にダナスの反転キャラが絡んでいるような構図で仄暗い雰囲気のイラストをお願いいたします。\nふたりの関係性としては反転ダナスが一方的に執着的(加虐的)好意を寄せていて、ダナスは反転ダナスに対して拒否的な感じです。\n反転キャラについては資料等ありませんが、同じ顔だけど色も性格も逆で、反転目のイメージです。(ご参考までにダナスはおっとりめ事なかれ主義的、反転キャラは神経質めで攻撃的な感じです)\n\n利用目的\n個人的な鑑賞およびSNS(ioの当方アカウント)への掲載\n\n2人分のイラスト依頼になりますので、もし金額が見合わないようでしたら再送依頼いただけると助かります。\nふんわりとした依頼で申し訳ございませんが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://misskey.io/@kyoka_h/pages/1717201985095", "created_at": "", "completed_at": ""}, {"path": "/@yonimaru/works/125", "thumbnail_src": "https://si.imgix.net/19444297/uploads/origins/d0f1ff6c-b932-4dad-ab6c-edf0dffd5c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=426d1cdfc80335d1786476d80c17f42a", "thumbnail_srcset": "https://si.imgix.net/19444297/uploads/origins/d0f1ff6c-b932-4dad-ab6c-edf0dffd5c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=426d1cdfc80335d1786476d80c17f42a, https://si.imgix.net/19444297/uploads/origins/d0f1ff6c-b932-4dad-ab6c-edf0dffd5c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=652a8fc7e494d02cdb0b62d9f1fad4fe 2x, https://si.imgix.net/19444297/uploads/origins/d0f1ff6c-b932-4dad-ab6c-edf0dffd5c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aafa1a259991203b7592e89b0a72fd14 3x", "genre": "art", "nsfw": false, "body": "お世話になっております\n先日sdキャラを描いていただいた四樹恵です\n\nSdキャラとてもとてもかわいくてさらに描いていただきたく依頼させていただきます\nお値段が許す限り先日描いていただいたテイストでいろいろなわたしを描いていただきたいです\n衣装や髪型など変えていただいてもだいじょうぶです\n\n・髪の毛目の色は変えないでください\n・ミニキャラなので胸は描かれないかとは思いますが平ためでおねがいします\n\n上記以外はお任せでおねがいしたいです\n\nグッズ、動画、配信やツイートなどで使用させていただきたいです\n納品形式はpngだと嬉しいですがpsdでもヨニマル様が納品しやすい形式で大丈夫です\n透過データもいただけると嬉しいです！\n\nよろしくお願いします\n\nツイッターの固定のリンクです\nhttps://x.com/Shiki_Meg/status/1696134832114618480?t=D2mydEP9koTy99diJqd48Q&s=19\n\nhttps://x.com/Shiki_Meg/status/1696134832114618480?t=D2mydEP9koTy99diJqd48Q&s=19", "created_at": "", "completed_at": ""}, {"path": "/@yonimaru/works/124", "thumbnail_src": "https://si.imgix.net/646d865f/uploads/origins/34cf15c4-3101-448b-bf65-4f67ac57a570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a54176c46ad0e5038c84ed6cba2b86", "thumbnail_srcset": "https://si.imgix.net/646d865f/uploads/origins/34cf15c4-3101-448b-bf65-4f67ac57a570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a54176c46ad0e5038c84ed6cba2b86, https://si.imgix.net/646d865f/uploads/origins/34cf15c4-3101-448b-bf65-4f67ac57a570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cf21710bbeb8eab1984754a2d6844db 2x, https://si.imgix.net/646d865f/uploads/origins/34cf15c4-3101-448b-bf65-4f67ac57a570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=225780fbd55a37cce1aa088392519b4d 3x", "genre": "art", "nsfw": false, "body": "資料URLの作品と同じような雰囲気のイラストをお願いしたいです。\nイラストサイズは3:4でお願いしたいです。\n(ipad 第6世代の背景画面用に使用予定です。)\n\n※とても絵柄が好きで、応援したいと思いリクエストさせていただきました。雰囲気とサイズだけ指定させていただきましたが、自由に好きなように描いていただいて大丈夫です。\nまた、こういったリクエストも初めてで、金額帯がわからないので、とりあえずの金額で設定しましたが、必要あれば変更も全然可能ですので、何卒よろしくお願いします。\n\nhttps://x.com/yonimaru_4242/status/1775856093266313467?s=46&t=76LCgQ0CWXUCJTE6aS0pLw", "created_at": "", "completed_at": ""}, {"path": "/@yonimaru/works/123", "thumbnail_src": "https://si.imgix.net/c6110dcf/uploads/origins/7d8f159e-2418-43d0-b969-8c95cc82741f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4155532a93aba7a93179e56698310c4", "thumbnail_srcset": "https://si.imgix.net/c6110dcf/uploads/origins/7d8f159e-2418-43d0-b969-8c95cc82741f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4155532a93aba7a93179e56698310c4, https://si.imgix.net/c6110dcf/uploads/origins/7d8f159e-2418-43d0-b969-8c95cc82741f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e50028d246b3e1256ab0ed1b03214f0 2x, https://si.imgix.net/c6110dcf/uploads/origins/7d8f159e-2418-43d0-b969-8c95cc82741f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75808290e08e36e18a7ad42cea864510 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ハピ鬱さん！ご丁寧なアピールをありがとう！\n\n私のOCを気に入っていただけて嬉しいです！絵を拝見させていただきましたが、作風も色使いもとても好みです！もし可能であれば、ウルフパップとのOCのSDイラストをお願いしたいです。\n\nウルフパップ\nhttps://jp.finalfantasyxiv.com/lodestone/playguide/db/item/8cd606d74df/\n\n大きな心で人を助けようとする優しい冒険家です！美しい場所を見に冒険に出かけるのが大好きで、おいしい料理を作るのも大好き。\n\n自由に描いてください！✨\n\nhttps://imgur.com/a/pG4sf6W", "created_at": "", "completed_at": ""}, {"path": "/@yonimaru/works/122", "thumbnail_src": "https://si.imgix.net/02b61feb/uploads/outputs/af085376-b6c1-4836-8e6c-43b239213d18?bg=%23fff&fm=