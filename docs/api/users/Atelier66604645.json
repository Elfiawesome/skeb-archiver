t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17bc55b1f912dfe7b48cf770163a7c96 2x, https://si.imgix.net/82dcbec0/uploads/origins/4b518056-64f2-4e71-9c50-650107c74251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19fcc454cfa955d6cb9d216401ce1603 3x", "genre": "art", "nsfw": false, "body": "こんばんは、初めまして。\n絵柄に一目ぼれしてリクエストさせていただきました！\n\n私のオリジナルキャラクターであるvtuberの磊ムギ（koishi mugi）とモンキー125のイラストをお願いします。\n\n・服装は上はブラウンのダブルの革ジャン、下の指定はありません。\n・バイクのカラー、サイドバッグは資料のままでお願いします。\n・ポーズはお任せしますがバイクに乗せてほしいのと表情ははにかんだ笑顔がいいです。\n\n使用用途：Xのヘッダーやアイコン、動画のサムネ\n\nご検討のほどよろしくお願いします！\n資料のURLの添付を忘れてしまい再度リクエストさせていただきました、大変申し訳ございません…\n\nhttps://drive.google.com/drive/folders/1R9dJXVmxo-ZnEDGUTUeqvFrIQkxpCf0w?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Atelier66604645/works/17", "thumbnail_src": "https://si.imgix.net/1dd4bd4f/uploads/origins/033fed3b-97ce-4761-9135-5bd7ad13dd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=173f8e2606b27903e195bfc9366310cb", "thumbnail_srcset": "https://si.imgix.net/1dd4bd4f/uploads/origins/033fed3b-97ce-4761-9135-5bd7ad13dd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=173f8e2606b27903e195bfc9366310cb, https://si.imgix.net/1dd4bd4f/uploads/origins/033fed3b-97ce-4761-9135-5bd7ad13dd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bda6bc50e91155548883eb1a89dddf98 2x, https://si.imgix.net/1dd4bd4f/uploads/origins/033fed3b-97ce-4761-9135-5bd7ad13dd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03459e3fb72f867f8d53e264a511af3f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたのアートワークをとても楽しんでいます。私のOCターニャが2021年型ホンダCRF450RLに乗っている絵を描いていただけないでしょうか？もし可能であれば、スーパーモトの壁紙からバイクのペイントジョブを使用できれば最高です。また、Tanyaが着ている衣装については、提供されたリファレンスを参照してください。ポーズについては、あなたのYZF-R6の作品（参考のポーズA）と似たようなものが良いかと思いますが、提案も大歓迎です。もし彼女がヘルメットを持っていたり（ポーズB参照）、バイクの上に置いていたりしたら理想的です。背景はBのポーズのようなシンプルなものがいいと思います。ありがとうございました。\n\nhttps://sta.sh/2238kujslxt?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@Atelier66604645/works/16", "thumbnail_src": "https://si.imgix.net/eb92a7af/uploads/origins/41b5f598-1d72-4ba1-b16a-1f5030aa3d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4251921adfb91ed7b4a5b30cbbb9a602", "thumbnail_srcset": "https://si.imgix.net/eb92a7af/uploads/origins/41b5f598-1d72-4ba1-b16a-1f5030aa3d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4251921adfb91ed7b4a5b30cbbb9a602, https://si.imgix.net/eb92a7af/uploads/origins/41b5f598-1d72-4ba1-b16a-1f5030aa3d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50c4b9b36031f610b3c831d660e02d60 2x, https://si.imgix.net/eb92a7af/uploads/origins/41b5f598-1d72-4ba1-b16a-1f5030aa3d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bb2613587458430144e7e2db8d8c73c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても好きで、この作品を依頼できないかと思っていました！vtuberの名前はtimbiteoです。\n\n私の作品では軽トラックを希望していて、白いHonda Acty 1999を希望しています。参考までにgoogle driveに写真があります。可能であれば、トラックの荷台にだるまのカップルを追加してもらえますか？\n\nポーズはハンドルの後ろかトラックの横でお願いします！\n\nhttps://drive.google.com/drive/folders/1ja8rBUEmREh5K0gnA47-6ReONeypr5Zc?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Atelier66604645/works/15", "thumbnail_src": "https://si.imgix.net/5ae3dc73/uploads/origins/f3040935-eb70-4ebd-8d66-258f230f65fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=291b4efc6c74ce099c91496c2567a0ae", "thumbnail_srcset": "https://si.imgix.net/5ae3dc73/uploads/origins/f3040935-eb70-4ebd-8d66-258f230f65fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=291b4efc6c74ce099c91496c2567a0ae, https://si.imgix.net/5ae3dc73/uploads/origins/f3040935-eb70-4ebd-8d66-258f230f65fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7869e38c2d4ebeb47fa4e5c35a4bbf3e 2x, https://si.imgix.net/5ae3dc73/uploads/origins/f3040935-eb70-4ebd-8d66-258f230f65fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24941eeafbc0ef446986295723d8492d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのモーターの描き方が大好きです。\n\nお願いしたいのは、マットブラックのホンダCBRモーターに座っているラムというOCの絵です。\n 彼女の \"目のマスコット \"を、モーターのどこかにデカールとして貼ってほしいんだ。\n\nこの作品の描き方が好きなので、同じようなものが欲しいです：\nhttps://skeb.jp/@Atelier66604645/works/3\n\nもし構図やポーズについてもっといいアイデアがあれば、遠慮なくどうぞ。あなたの判断を信頼しています。\n\n用途YouTubeアカウント/ストリーム、Twitterアカウント、動画で使用することができます。\n\n参考\nhttps://1drv.ms/f/s!ArB9hx8odCgug2ouw6w4C67byyHQ?e=DOR14d", "created_at": "", "completed_at": ""}, {"path": "/@Atelier66604645/works/14", "thumbnail_src": "https://si.imgix.net/b5397577/uploads/origins/0bd4520f-06b3-4784-bd97-0ac31c138a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5117963f4986dd0d81278b91f0d0a5", "thumbnail_srcset": "https://si.imgix.net/b5397577/uploads/origins/0bd4520f-06b3-4784-bd97-0ac31c138a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5117963f4986dd0d81278b91f0d0a5, https://si.imgix.net/b5397577/uploads/origins/0bd4520f-06b3-4784-bd97-0ac31c138a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ecda2e27c58d6ee9d37bd8457a1b2f8 2x, https://si.imgix.net/b5397577/uploads/origins/0bd4520f-06b3-4784-bd97-0ac31c138a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74d2b0e4e4538f0c87cf67f8f32c12be 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nベスパに乗っているT-chamaというキャラクターが欲しいです。\n\nベスパの色はピンクと赤で、チェーンソーのようなハート柄にしたいです。  ヘルメットも自由につけてください。\n\nアイドルのような猫耳の元気な女の子。1950年代の食堂をテーマにしたメイド喫茶で働いており、悪い客には愛のチェーンソーを使う。ハンバーガーやフライドポテト、スイーツなど、さまざまな料理を提供している。\n\n参考文献はこちら：https://drive.google.com/drive/folders/1v0zxqZhcp-IBRyiDeifwlJY2P2t_QC8s?usp=sharing\n\n構図は自由です。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@Atelier66604645/works/13", "thumbnail_src": "https://si.imgix.net/851c2a80/uploads/origins/bc594731-e156-4e80-a396-2f0