 2x, https://si.imgix.net/3d55c49c/uploads/origins/84423afd-c08b-4d16-907e-3fbe849f18a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75cca037427279773daaffd7bbf28330 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shiro_gisu/works/173", "thumbnail_src": "https://si.imgix.net/359e9ab1/uploads/origins/ec3a450f-4e9b-4b05-925c-cd6d7d97e284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82b1c49f28cf1aac979748644d92e5ce", "thumbnail_srcset": "https://si.imgix.net/359e9ab1/uploads/origins/ec3a450f-4e9b-4b05-925c-cd6d7d97e284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82b1c49f28cf1aac979748644d92e5ce, https://si.imgix.net/359e9ab1/uploads/origins/ec3a450f-4e9b-4b05-925c-cd6d7d97e284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cf18a66b517089b5b8911cb9f41b899 2x, https://si.imgix.net/359e9ab1/uploads/origins/ec3a450f-4e9b-4b05-925c-cd6d7d97e284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dc926476028296164f9d311ea09f125 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shiro_gisu/works/172", "thumbnail_src": "https://si.imgix.net/a3bbb0a7/uploads/origins/93710d88-099e-4258-8ed7-ca5c707cb9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fb6dff18eb5cd6c78f11648036b8ff", "thumbnail_srcset": "https://si.imgix.net/a3bbb0a7/uploads/origins/93710d88-099e-4258-8ed7-ca5c707cb9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fb6dff18eb5cd6c78f11648036b8ff, https://si.imgix.net/a3bbb0a7/uploads/origins/93710d88-099e-4258-8ed7-ca5c707cb9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ee5ad62c9a74f03e3ab311a57e88c88 2x, https://si.imgix.net/a3bbb0a7/uploads/origins/93710d88-099e-4258-8ed7-ca5c707cb9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95ec470164e002f59af18859c27f5302 3x", "genre": "art", "nsfw": true, "body": "シロギス様、はじめまして！\n先生の描かれる女の子の可愛いお顔と圧倒的なおっぱい、そして表情にとても惹かれました。\nリクエスト失礼いたします。\n\n■キャラクター\nセリ・グロース（ライザのアトリエ2）\nhttps://www.gamecity.ne.jp/atelier/ryza2/serri.html\n\n植物の種を求めて旅をしている、異種族のお姉さんハーバリストです。\n種を一瞥するだけでその植物の特徴の全てを理解できる能力を持っています。\nおっぱいがデカくてむちむちで声もめちゃエロいです。\n\n■シチュエーション\n無知なせいでまんまと子種を仕込まれ種付けおじさんの所有物になっちゃうセリさん\n\n■シーン構成（CG集のような感じでお願いしたいです）\n①導入\nセリさん、種付けおじさんと邂逅\nおっぱいは片乳だけで頭より大きいくらいの爆乳にして、衣装は公式のものを着せてください。\n「私はセリ。植物の種を集める旅をしているの　あなたがこのあたりで有名な種付け？おじ様だと聞いたのだけど…　あなたの種、分けてもらえないかしら？」\n\n②セクハラパート\n見せ槍に対し「あなたはこの棒から種を出せるの？　…変わった体質ね」\n爆乳をめちゃくちゃに揉みしだかれるも無抵抗・無反応\n…だが、実はセリさんがマグロなだけで体はしっかり反応しており、この時点で排卵\n\n③本番\n正常位かつ竿役の主観視点\n「私の中に棒を入れる必要はあるのかしら　これでもっと種が熟成されるの？　そう…」\n「あなたに胸を触られているときからお腹のあたりが疼いていたの　満たされる感じがするわ」\n「私がお願いしている立場なのに、こんなに良くしてもらって悪いわね」\n\n④射精\n「もう出そうなの？　分かったわ、今袋を──」\n腰を押し付け思い切り中出し\n「……っ♡」\nわずかに嬌声を上げて体を震わせるセリさん。何分も続く長い射精\n\n⑤事後\n精液を一目見ることができれば能力で騙されていると分かったはずだが、\n種付けおじさんのつよつよザーメンはセリさんの子宮にみっちり収まり、全く垂れてこない\n「よほど強力な種なのね　私の中に出されても意味はないのだけれど…」\n精液で膨らんだお腹をさすった刺激で精子が卵子に滑り込み受精。それにより「種付け魅了」の効果が発動\n「──っ？♡」\n「…ええ、また来るわ　ご主人様♡」\n\n何卒ご検討の程、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/11NmWpGM9kf_lgYUE-lE7OHgzrEtCcXx6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shiro_gisu/works/171", "thumbnail_src": "https://si.imgix.net/79b570de/uploads/origins/19ada62e-707d-4908-84ca-d31e2398e8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=674239ed880209f3351f7dc2d08e5003", "thumbnail_srcset": "https://si.imgix.net/79b570de/uploads/origins/19ada62e-707d-4908-84ca-d31e2398e8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=674239ed880209f3351f7dc2d08e5003, https://si.imgix.net/79b570de/uploads/origins/19ada62e-707d-4908-84ca-d31e2398e8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c0ad1979ae70ccb49768cd889f8e296 2x, https://si.imgix.net/79b570de/uploads/origins/19ada62e-707d-4908-84ca-d31e2398e8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23f2160cb5d5d207e08234a45ff3aa69 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}