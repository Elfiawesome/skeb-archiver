%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09833c8e15d845d76d23a49217d22131, https://si.imgix.net/f51caee3/uploads/origins/31b7d605-47c8-44fd-8165-393dfb16e377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc3dd61a08d90d910aad8982a93bb806 2x, https://si.imgix.net/f51caee3/uploads/origins/31b7d605-47c8-44fd-8165-393dfb16e377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c4622b9d10d7c73a16683ca09bedb02 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Haduki_As/works/11", "thumbnail_src": "https://si.imgix.net/b40ca782/uploads/origins/00263a8a-fb4f-4b33-9daa-69f2d11ec4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d64acd898b3d48a120dae5fef47b9533", "thumbnail_srcset": "https://si.imgix.net/b40ca782/uploads/origins/00263a8a-fb4f-4b33-9daa-69f2d11ec4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d64acd898b3d48a120dae5fef47b9533, https://si.imgix.net/b40ca782/uploads/origins/00263a8a-fb4f-4b33-9daa-69f2d11ec4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c005e83f3ddd2a63a16d5b45bf7e07c 2x, https://si.imgix.net/b40ca782/uploads/origins/00263a8a-fb4f-4b33-9daa-69f2d11ec4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9228eb693fab4215afd76ebd22dc6d98 3x", "genre": "art", "nsfw": true, "body": "はづきんとん様、いつもとてもエッチで素敵なイラスト・漫画を楽しませていただいています。\n\n今回、はづきんとん様にご依頼したいのは個人Vtuberの楠陰ミクサ(くすかげ　みくさ)さんのR18イラストのリクエストになります。\n本人がR18の創作やファンアートも問題ないという事なのでご依頼させていただきます。\n\nシチュエーションとしましては、以前描かれていた [https://skeb.jp/@Haduki_As/works/6]\nの言葉攻め足コキのような形でお願いしたいです。\n\n個人VTberでお見かけしたことがなく難しいと思いますが\nこの推しのエッチな姿が見たいのでよろしくお願い致します。\n\nhttps://twitter.com/lost_myxa", "created_at": "", "completed_at": ""}, {"path": "/@Haduki_As/works/10", "thumbnail_src": "https://si.imgix.net/9c2bc187/uploads/origins/45bf5e45-2832-4b8e-91c2-b996f43a8378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2632ca2b94bfb2ceb8f5c9df20e888c", "thumbnail_srcset": "https://si.imgix.net/9c2bc187/uploads/origins/45bf5e45-2832-4b8e-91c2-b996f43a8378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2632ca2b94bfb2ceb8f5c9df20e888c, https://si.imgix.net/9c2bc187/uploads/origins/45bf5e45-2832-4b8e-91c2-b996f43a8378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2658ce09725080f96707e056c89893fe 2x, https://si.imgix.net/9c2bc187/uploads/origins/45bf5e45-2832-4b8e-91c2-b996f43a8378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66d31add3a22d21f0952152a125660c9 3x", "genre": "art", "nsfw": true, "body": "VTuberすあまちゃんの#すあま絵 or #激甘すあまちゃん で、notR-18の範囲でおぱんつ絵を描いて頂きたいです\n\n①突風で捲れる\n②ブーツで何かを踏んだり蹴るぐらいの勢いで片足を上げて見える\n③スカートたくし上げ\n\n上のどれかのシチュエーションから一つお好みで、やや下から煽り構図気味に全身を映す感じのパンチラというかパンモロをお願いします\nロングスカートが捲れて太ももとかおみ足がパンツごと露わになるのが好きなので・・・できればロングスカートが捲れた内側や股間周りの少し蒸れた空気感とか湯気？を表現してもらえるとフェチな感じで嬉しいです\n\nなんとなくですがご本人がパンチラぐらいでは慌てる感じがしないので、①の場合は軽く頬を染める程度、②や③も「ほれほれー」みたいに恥じらうというか余裕のある動じない感じで\n\nパンツ設定はないと思うので趣味を出させて頂き紐パンを指定させてください\n大人っぽいお洒落さ、えっちさとかわいさが混じった感じで、色とか柄はキャラに合わせてはづきんとんさんの解釈にお任せします\n\n最後に、コミケ新刊表紙のような画風も好きなのですがすあまちゃんの立ち絵のあの柔らかいパステル調な雰囲気がとても好きなので、再現可能でしたらあのタッチに寄せてもらえるととても嬉しいです\n\n※ハッシュタグ参考\nttps://twitter.com/syu_a_ma/status/1476484360396480512\nttps://twitter.com/syu_a_ma/status/1475239092648824836\n\n\nどうぞよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Haduki_As/works/9", "thumbnail_src": "https://si.imgix.net/2d868a3e/uploads/origins/5be82486-c282-464e-9fe9-42d2a200d455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4949745a493bff8005f673dbeeb2e575", "