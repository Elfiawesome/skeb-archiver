87d03f49d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94973d634fc408b670e16219d55cf36b, https://si.imgix.net/96677be1/uploads/origins/7157dc54-0314-4d3b-b4aa-a987d03f49d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7795cc5611b0ae667575c8f68cb788c 2x, https://si.imgix.net/96677be1/uploads/origins/7157dc54-0314-4d3b-b4aa-a987d03f49d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22617c14ac470e1b804f409225a54405 3x", "genre": "art", "nsfw": true, "body": "I absolutely love your draw!\nI would like to request a commission for my OC.\nFeel free to draw anything you want.\nas for any ideas or poses for the commission,\nI don't have any idea and I would like to leave it up to you if that is okay.\nIt could be SFW, NSFW, or suggestive.\nIf there has NSFW version,\nI would like a different version that with and without the Fundoshi (褌).\nhttps://drive.google.com/drive/folders/1PKasAHzTv4DGjXs3Ner8kmDH_qGC1kAg", "created_at": "", "completed_at": ""}, {"path": "/@tukuenomoto/works/51", "thumbnail_src": "https://si.imgix.net/33aeaed1/uploads/origins/da33629c-07b0-4e8a-8785-d9df23cc1df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92564f98de5d5d0544bd5d179ca43eb", "thumbnail_srcset": "https://si.imgix.net/33aeaed1/uploads/origins/da33629c-07b0-4e8a-8785-d9df23cc1df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92564f98de5d5d0544bd5d179ca43eb, https://si.imgix.net/33aeaed1/uploads/origins/da33629c-07b0-4e8a-8785-d9df23cc1df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20016214a7b7fef1702792502793f19d 2x, https://si.imgix.net/33aeaed1/uploads/origins/da33629c-07b0-4e8a-8785-d9df23cc1df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e48f1064ba38d873c81a1d09158c6cc6 3x", "genre": "art", "nsfw": false, "body": "こんにちは、tukuenomotoさん！僕はtukuenotoさんのアートスタイルが大好きなので、僕の友達と僕のキャラクターのアートワークをお願いしたいです！セクシーなポーズ（R15のような）と肉球を見せてほしいです。その他は特にありません。\n\nhttps://drive.google.com/drive/folders/1mb9AB4cTXnm5n1IsmNw488Iv-Lk1o01B?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tukuenomoto/works/50", "thumbnail_src": "https://si.imgix.net/1ab2e0a3/uploads/origins/8667d6ec-3a8d-4ebe-82c9-f495354b7cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ed0c54c2e3570ad21605db13cec9d9", "thumbnail_srcset": "https://si.imgix.net/1ab2e0a3/uploads/origins/8667d6ec-3a8d-4ebe-82c9-f495354b7cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ed0c54c2e3570ad21605db13cec9d9, https://si.imgix.net/1ab2e0a3/uploads/origins/8667d6ec-3a8d-4ebe-82c9-f495354b7cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc76c3bd0c1d4d8b1b6efd43f174cf3d 2x, https://si.imgix.net/1ab2e0a3/uploads/origins/8667d6ec-3a8d-4ebe-82c9-f495354b7cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fdffa50504e64b019edb20ff0bb93f2 3x", "genre": "art", "nsfw": true, "body": "机の下さん、いつもお世話になっております！\n募集を再開されていましたので、もし宜しければリピートでユキくんのリクエストをお願いします！\n\n今回は構図などは机の下さんのお任せで、資料のユキくんの壁紙用イラスト(画面解像度　2560×1440px アスペクト比　16:9)をお願いしても宜しいでしょうか？\n全体的に可愛らしいイメージで、お腹はそこそこ丸くポッコリとしており、シャツが少し捲れてポッコリしたお腹のおへそ辺りまで見えている様な構図だと嬉しいです！\n\nもしも大丈夫であれば、お菓子やスイーツなどを食べ過ぎたイメージで、お腹がパンパンに丸く膨らんでいる差分を、可能な場合お願いできると嬉しいです！\n\nいつも可愛くユキくんを描いていただいてありがとうございます、よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1-EsIkvcPWAaLpmHiFu4qEiBmSgxU9TKT", "created_at": "", "completed_at": ""}, {"path": "/@tukuenomoto/works/49", "thumbnail_src": "https://si.imgix.net/77442aea/uploads/origins/bdbacff9-70c8-45f6-8fa5-d31da0d013b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38a23b8b7b75081891c9bc642a07f804", "thumbnail_srcset": "https://si.imgix.net/77442aea/uploads/origins/bdbacff9-70c8-45f6-8fa5-d31da