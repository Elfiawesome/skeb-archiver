292_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0040f005f5bcea65d2ac2c512e1f91bb", "thumbnail_srcset": "https://si.imgix.net/2a23ece3/requests/18292_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0040f005f5bcea65d2ac2c512e1f91bb, https://si.imgix.net/2a23ece3/requests/18292_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85ac27bbce00c58ccf165045e746ce3f 2x, https://si.imgix.net/2a23ece3/requests/18292_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2c00ab20cb83f2114ff61d98e909b87 3x", "genre": "art", "nsfw": true, "body": "ポリニアンのユメが、メカ触手に拘束されながら犯されているイラストをお願いします！\n腕を持ち上げられ、挿入して暴れる触手を太ももで必死に抑えてるイメージです。", "created_at": "", "completed_at": ""}, {"path": "/@ButanekoAP/works/1", "thumbnail_src": "https://si.imgix.net/82f7156c/requests/14285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a908710981c389c2d8ca69330c18cc6e", "thumbnail_srcset": "https://si.imgix.net/82f7156c/requests/14285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a908710981c389c2d8ca69330c18cc6e, https://si.imgix.net/82f7156c/requests/14285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3adc7771170c4c4970a051e9f1367c4 2x, https://si.imgix.net/82f7156c/requests/14285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6f5e35c5d5e953e407b190c221f6568 3x", "genre": "art", "nsfw": true, "body": "『THE　モンスタートラップ』に登場する女冒険者ちゃんがいろんな形状の極細触手に代わる代わる尿道責めされる(待機中の触手が周囲で蠢いてる感じ)イラストをお願いします。\n許しや助けを求める女冒険者ちゃんの台詞や、残像が残るくらい激しくピストン責めされてるH擬音の他、\n『尿道感度+1』とか『尿道絶頂(173回目)』みたいな状態変化っぽいポップアップ表示を女の子の周りに大量に重複表示して欲しいです。", "created_at": "", "completed_at": ""}]}