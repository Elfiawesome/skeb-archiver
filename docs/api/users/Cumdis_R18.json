fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a6400d140710c2e9656a2b945e5d89e", "thumbnail_srcset": "https://si.imgix.net/bd9339b9/uploads/origins/e5c73c1b-3c5c-4125-8f10-ed46aa73a6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a6400d140710c2e9656a2b945e5d89e, https://si.imgix.net/bd9339b9/uploads/origins/e5c73c1b-3c5c-4125-8f10-ed46aa73a6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc6c832f0a0f8b91a8d9d7a9d47a3e42 2x, https://si.imgix.net/bd9339b9/uploads/origins/e5c73c1b-3c5c-4125-8f10-ed46aa73a6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80e8306cac2a16ae6b3cc372a19379ea 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Cumdis_R18/works/42", "thumbnail_src": "https://si.imgix.net/d183c1b7/uploads/origins/49cd2fd4-ddb8-4821-9cc9-2d004f8516bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610e508e9671a7d68c50fcde22431e47", "thumbnail_srcset": "https://si.imgix.net/d183c1b7/uploads/origins/49cd2fd4-ddb8-4821-9cc9-2d004f8516bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610e508e9671a7d68c50fcde22431e47, https://si.imgix.net/d183c1b7/uploads/origins/49cd2fd4-ddb8-4821-9cc9-2d004f8516bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0285526596e39d6953aae0dcf4084167 2x, https://si.imgix.net/d183c1b7/uploads/origins/49cd2fd4-ddb8-4821-9cc9-2d004f8516bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2acadce74bfeb12e6c58bfe9a546e341 3x", "genre": "art", "nsfw": true, "body": "Mudico様\n\n初めましてオリゼーと申します\nオリジナルキャラクターでの依頼が可能であればお願いできますでしょうか\n・大間忍\nキャラクターにつきましては資料用URLにてご参照ください\n\n【シチュエーション】\n大間忍が恵まれた体型のふたなり巨根女子レスラーによって追い込まれ挙句蹂躙セックスを受けるといったもので\n予算内で可能な枚数をお願いします\n\n【希望の流れ】\n大間忍が苦戦するなかキン肉バスターからマッスルリベンジャーを立て続けに決められ蹂躙セックスショーでアクメを晒しまくる\n\n【技資料】\n・キン肉バスター\nhttps://www.pixiv.net/artworks/92900769\n・マッスルリベンジャー\n下記URLの三枚目のイラスト\nhttps://www.pixiv.net/artworks/108390859\n\n【備考】\n・相手のふたなりレスラーのデザインに関しましてはMudico様にお任せいたします\n・蹂躙セックスショーの内容に関しましてもMudico様にお任せいたします\n\n以上が依頼内容となりますが\nご検討頂きそぐわないようであればキャンセルして頂けると幸いです。\n\nhttps://www.pixiv.net/artworks/90827916", "created_at": "", "completed_at": ""}, {"path": "/@Cumdis_R18/works/41", "thumbnail_src": "https://si.imgix.net/a5de0747/uploads/origins/aff32420-6151-4164-8e54-26ca135d8284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5b5d48c3bb4346a28a900382a3f931", "thumbnail_srcset": "https://si.imgix.net/a5de0747/uploads/origins/aff32420-6151-4164-8e54-26ca135d8284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5b5d48c3bb4346a28a900382a3f931, https://si.imgix.net/a5de0747/uploads/origins/aff32420-6151-4164-8e54-26ca135d8284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ca8de220601096a8f9a3478ac71de92 2x, https://si.imgix.net/a5de0747/uploads/origins/aff32420-6151-4164-8e54-26ca135d8284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a97831e491b8a04dc92efdce965bd07 3x", "genre": "art", "nsfw": true, "body": "前回素晴らしいイラストとパワーワードをありがとうございました！\n今回もぜひよろしくお願いしますm(_ _)m\n今回は３枚+差分でお願いします。\n\n\n【シチュエーション】\n１枚目はマンティーノくんの誕生日イラスト、2～3枚目はムディコさんと異世界のムディコさんの相撲の続き(前回のシチュで書いた信仰する像うんぬんかんぬんはなしでお願いします。このままの流れの方が作品的に素晴らしくなりそうなので)。\n\n【１枚目】\nマンティーノくんのお気に入りのアナル種付けプレスか相手の男と同じオナホールにチンポを入れての兜合わせをお願いします。衣装や背景はお任せします。\n\n【２枚目】\nムディコさんが異世界のムディコさんを土俵際まで追い込んで挿入しながらの中出し。異世界のムディコさんは大きくのけ反っていて本物のムディコさんに乳首を吸われており、アへ顔になりそうなのをギリギリ耐えてる感じでお願いします。\n\n【３枚目】\n異世界のムディコさんがうっちゃりで逆転したという流れでそのまま本物のムディコさんにのしかかって種付けプレスで激しくピストン。玉袋を激しく叩きつけるような感じでお願いします。また、異世界のムディコさんのまんこからは本物のムディコさんのザーメンが垂れてると嬉しいです。種付けプレスしている場所は土俵の上、土俵の下どちらでも構いません。\n\n【差分１枚目】\n種付けプレスによる大量中出しで異世界のムディコさんの勝利。\n\n【差分２枚目】\n異世界のムディコさんが本物のムディコさんのまんこからチンポをゆっくりと引き抜いているところ。本物のまんこは大きく開いたままで中から大量のザーメンが溢れてきている。異世界のムディコさんはチンポがバキバキのままで本物のムディコさんはチンポがへたれて倒れてる感じでお願いします。また、妊娠が分かるように受精拡大図もお願いします。\n\n\n依頼が遅くなったり、マニアックな内容だったりといつもながらお手数をおかけします(^^;\n今回も絶対に素晴らしい作品が見られると楽しみにしてます、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Cumdis_R18/works/40", "thumbnail_src": "https://si.imgix.net/4acb708e/uploads/origins/9cfb93cd-abda-4640-8e34-63a1389d25a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94324ca9be5ce539dffdc550e6506fdf", "thumbnail_srcset": "https://si.imgix.net/4acb708e/uploads/origins/9cfb93cd-abda-4640-8e34-63a1389d25a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94324ca9be5ce539dffdc550e6506fdf, https://si.imgix.net/4acb708e/uploads/origins/9cfb93cd-abda-4640-8e34-63a1389d25a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8391af04e6ec88621fefd7f4f123293 2x, https://si.imgix.net/4acb708e/uploads/origins/9cfb93cd-abda-4640-8e34-63a1389d25a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edc2e9de4c9ef23db0479478a7a001fe 3x", "genre": "art", "nsfw": true, "body": "手数料無料なのでショタを種搾りプレスでラブラブ逆レイプするカウシュナママをお願いします\n\n・体位は密着騎乗位、全身で抑え込むように\n・ママはラブラブに甘やかしてくるけど、本質的にはドSで獣のように貪るような感じ\n・犯すようなディープキスをするシーンが欲しい。体格的に種搾りプレスしながら難しいと思うので、カットインとかで\n・ショタは女性的なかわいい感じで、顔や体格はマンティーノくんを更に幼くした感じ", "created_at": "", "completed_at": ""}, {"path": "/@Cumdis_R18/works/39", "thumbnail_src": "https://si.imgix.net/088d2b0f/uploads/origins/8581b1d6-92c3-464c-b78c-9f95c1ff7270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c0f3eb24b4a720655efbe248071a3a1", "thumbnail_srcset": "https://si.imgix.net/088d2b0f/uploads/origins/8581b1d6-92c3-464c-b78c-9f95c1ff7270?bg=%23fff&auto=format%2Cco