かっていることに注目してください。\n細かい点：前述の通り、彼女の髪はポニーテールになっている。動画が参考になる。フープイヤリングもお忘れなく。\n\nhttps://catbox.moe/c/tjy1j5", "created_at": "", "completed_at": ""}, {"path": "/@KatakuMusou/works/81", "thumbnail_src": "https://si.imgix.net/ff3b08c0/uploads/origins/78478cc0-3ae3-4d03-99e4-0bc7f05c55dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=449e6f608924983a94403b4ed49bc05c", "thumbnail_srcset": "https://si.imgix.net/ff3b08c0/uploads/origins/78478cc0-3ae3-4d03-99e4-0bc7f05c55dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=449e6f608924983a94403b4ed49bc05c, https://si.imgix.net/ff3b08c0/uploads/origins/78478cc0-3ae3-4d03-99e4-0bc7f05c55dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9d95bdae06f5d36cad0b2a6b15df899 2x, https://si.imgix.net/ff3b08c0/uploads/origins/78478cc0-3ae3-4d03-99e4-0bc7f05c55dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b180e5d0a8b0d0dc9d482f75e550c252 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@KatakuMusou/works/80", "thumbnail_src": "https://si.imgix.net/d8d5c70c/uploads/origins/598ee344-3b4a-4d1b-849c-18e17782234e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d5bdcc3ea1675ed5da7516f106f7a10", "thumbnail_srcset": "https://si.imgix.net/d8d5c70c/uploads/origins/598ee344-3b4a-4d1b-849c-18e17782234e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc