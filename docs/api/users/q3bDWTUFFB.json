b813e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=588bfad86c60aab62af0efad1c744e6d, https://si.imgix.net/15976694/uploads/origins/e1263154-7d2f-4a2b-8fbc-cbf3535b813e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4abe1edcf14f06a2f26156e2f09e379 2x, https://si.imgix.net/15976694/uploads/origins/e1263154-7d2f-4a2b-8fbc-cbf3535b813e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77c9a2add272411e2188781e19441af3 3x", "genre": "art", "nsfw": true, "body": "ご依頼よろしくお願いいたします。\nいつも素敵なイラストを拝見させてもらっています。\n\n【キャラクター】\n界の軌跡よりエレイン・オークレール\n\n【シチュエーション】\n敵に敗北したエレインさん\n正面向きで全裸、手を頭の後ろで縛られてM字騎乗位させられている。\nうさださんの過去絵のこんな感じで\nhttps://www.pixiv.net/artworks/132188749\nhttps://www.pixiv.net/artworks/132728058\n【差分希望】\n挿入前(くっころ的な表情)\n挿入中(悔しがる表情)\n射精差分(絶頂)\n事後(アへ顔で男根が抜け白い液体が股からドロリ)\n的な感じのをお願いしたいです。\n差分は希望ですので金額的に厳しいとかあればキャンセルしてください\nご依頼よろしくお願いいたします\n\nhttps://www.falcom.co.jp/kai/character/elaine.html", "created_at": "", "completed_at": ""}, {"path": "/@q3bDWTUFFB/works/37", "thumbnail_src": "https://si.imgix.net/7a416e46/uploads/origins/1e6a96e9-d283-42c2-92b7-91a3e4eb26fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612c83f11e97cc0a3b824640bcde7549", "thumbnail_srcset": "https://si.imgix.net/7a416e46/uploads/origins/1e6a96e9-d283-42c2-92b7-91a3e4eb26fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612c83f11e97cc0a3b824640bcde7549, https://si.imgix.net/7a416e46/uploads/origins/1e6a96e9-d283-42c2-92b7-91a3e4eb26fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86273eeac4d7b3dd1f33ef4531eaac4b 2x, https://si.imgix.net/7a416e46/uploads/origins/1e6a96e9-d283-42c2-92b7-91a3e4eb26fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=379aa0e0ef8f875afd499b91864d0fbc 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n\nSAOの桐ヶ谷直葉を描いて頂けないでしょうか\n\n衣装\n牛柄ビキニがはだけている\n(可能であれば星条旗ビキニの差分があると嬉しいです)\n\nポーズ\nお任せしますが局部や胸が見えるポーズを希望します\n\n台詞や効果音\nあると嬉しいです\n(内容はお任せしますハートマーク付き)\n\n表情\nアヘ顔ハート目\n\n備考\n・可能であれば差分があると嬉しいです\n(内容はお任せします)\n・胸や乳輪のデカさはお任せします\n・使用済みゴムを衣装に括り付ける\n・使用済みゴムや大人の玩具が散乱そている\n・身体中に卑猥な落書き\n・性液ぶっかけ\n\n上記を踏まえて好きなように描いて頂けると幸いです", "created_at": "", "completed_at": ""}, {"path": "/@q3bDWTUFFB/works/36", "thumbnail_src": "https://si.imgix.net/469cafc2/uploads/origins/d096c046-f98e-407b-bb93-d8ae7171ff78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ed6b44a55a58a8292b3682c8a75966", "thumbnail_srcset": "https://si.imgix.net/469cafc2/uploads/origins/d096c046-f98e-407b-bb93-d8ae7171ff78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ed6b44a55a58a8292b3682c8a75966, https://si.imgix.net/469cafc2/uploads/origins/d096c046-f98e-407b-bb93-d8ae7171ff78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc7736f6c5c8f4a6c9245c3441f114fe 2x, https://si.imgix.net/469cafc2/uploads/origins/d096c046-f98e-407b-bb93-d8ae7171ff78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b6ecd0d49865f8b9e98ba96dfa2c5c3 3x", "genre": "art", "nsfw": true, "body": "御世話になります。\n「遊戯王の真崎杏子が男にクロロホルムを嗅がされて眠らされるシーン」をお願いします。\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「白目を向き、気絶寸前（こちらは余裕があれば、で大丈夫です）」「目を閉じ気絶」「ハンカチ無しで寝顔が見える」をお願いします。\n・犯人は腕など一部分やシルエットで大丈夫です。背景もこだわりません。\n・全裸で、おっぱいやスジ(陰毛)が見える構図でお願いいたします。\n・犯人に抱きしめられる感じで眠らされます。\n・よければ台詞や効果音の有無差分もよろしいでしょうか。", "created_at": "", "completed_at": ""}, {"path": "/@q3bDWTUFFB/works/35", "thumbnail_src": "https://si.imgix.net/79a142ee/uploads/origins/7cc389f7-b58a-4710-95cc-2424baf61d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=682ffa164d91d132b480fd4d99004afd", "thumbnail_srcset": "https://si.imgix.net/79a142ee/uploads/origins/7cc389f7-b58a-4710-95cc-2424baf61d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=682ffa164d91d132b480fd4d99004afd, https://si.imgix.net/79a142ee/uploads/origins/7cc389f7-b58a