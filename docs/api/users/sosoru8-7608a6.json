54-54f104eeba60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=033c223ed9daf57c0dbfee32144a38aa 2x, https://si.imgix.net/a21b70ef/uploads/origins/76e81717-50e2-4e62-9654-54f104eeba60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d4d52f47623a0c8a0001659c57de702 3x", "genre": "art", "nsfw": false, "body": "sosoru様\nはじめまして。あるぱかﾀｿと申します。\nsosoru様の描くひまちゃんのイラストが好きなのでリクエストをさせて頂きます。\n\n描いていただきたい作品\nlive2dモデラーVtuberの藍眠ちよこ(@aimin_chiyoko /@chiyokoaimin_v)様のファンアート\n\n資料詳細\nhttps://x.com/chiyokoaimin_v/status/1891863729941381278?s=46\n\n構図等の希望\n⚪︎第一希望\nカフェが似合いそうな私服で透明なグラスに入ったアイスコーヒーをストローで飲んでいるお姿(頭のアイスの飾りはそのまま)\n⚪︎第二希望\n同様の構図、シチュエーションで資料にある衣装でおねがいします。\n\n用途\nファンアートとしてのリクエスト。\nタグ(# ちよこあーと)をつけて、sosoru様に依頼して描いていただいたことを投稿します。\n\n備考として、配信のサムネイルなどに使用する可能性もありますので、サインの有り無しの差分の透過pngとpsdをお願いします。\n\n初めてのskeb依頼で文章が拙いとは思いますが、ぜひsosoru様に描いていただきたいので、ご検討のほどよろしくおねがいします。\n\nhttps://x.com/chiyokoaimin_v/status/1891863729941381278?s=46", "created_at": "", "completed_at": ""}, {"path": "/@sosoru8/works/148", "thumbnail_src": "https://si.imgix.net/add8993f/uploads/origins/ac1c7685-30fa-4da1-9910-10570c16d1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90439321f9608b44976877fec9b3e07", "thumbnail_srcset": "https://si.imgix.net/add8993f/uploads/origins/ac1c7685-30fa-4da1-9910-10570c16d1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90439321f9608b44976877fec9b3e07, https://si.imgix.net/add8993f/uploads/origins/ac1c7685-30fa-4da1-9910-10570c16d1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff415431c77e81bdfaa6d2b6fe7f6019 2x, https://si.imgix.net/add8993f/uploads/origins/ac1c7685-30fa-4da1-9910-10570c16d1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d67c0170820e2fbe9b898ed5d50ebb8 3x", "genre": "art", "nsfw": false, "body": "sosoru様　はじめまして！\nバーチャルライブチャット　にてライバーをしています　真白しろなと言います\nこちらのイラスト（https://skeb.jp/@sosoru