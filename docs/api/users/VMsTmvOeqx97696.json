ins/e3d55907-cdc6-43d1-8db8-427388ab49a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeaa57b7b6a103229a24aeb354b6f454", "thumbnail_srcset": "https://si.imgix.net/56bbb455/uploads/origins/e3d55907-cdc6-43d1-8db8-427388ab49a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeaa57b7b6a103229a24aeb354b6f454, https://si.imgix.net/56bbb455/uploads/origins/e3d55907-cdc6-43d1-8db8-427388ab49a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5f578331e8275078ae811183f88c5ea 2x, https://si.imgix.net/56bbb455/uploads/origins/e3d55907-cdc6-43d1-8db8-427388ab49a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e85f5bdcd99ea70003be7dcee6272659 3x", "genre": "art", "nsfw": true, "body": "日本の小学生JS3\n白無垢姿\n後ろ手に手錠、上半身はロープで縛られ、膝は赤いロープで縛られている。\n両足首は赤いロープできつく縛られている。\n片足は素足、もう片足は白い靴下とビーチサンダル。\n涙を流す顔\n白いガムテープで口を縛る\n背景は不要です。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@VMsTmvOeqx97696/works/177", "thumbnail_src": "https://si.imgix.net/6bb30811/uploads/origins/5f8ac78a-3f90-4bc5-bb65-7595f49a35e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14ceb79151479511220a11829d9ee94e", "thumbnail_srcset": "https://si.imgix.net/6bb30811/uploads/origins/5f8ac78a-3f90-4bc5-bb65-7595f49a35e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14ceb79151479511220a11829d9ee94e, https://si.imgix.net/6bb30811/uploads/origins/5f8ac78a-3f90-4bc5-bb65-7595f49a35e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b300b4db0fc22c58115bb736df4af7d 2x, https://si.imgix.net/6bb30811/uploads/origins/5f8ac78a-3f90-4bc5-bb65-7595f49a