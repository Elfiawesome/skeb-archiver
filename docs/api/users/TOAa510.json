-4eb8-9a80-11227fc3c4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=627af600436569b6bc96f73d9a0be7d3 2x, https://si.imgix.net/cc96a977/uploads/origins/bed50495-b059-4eb8-9a80-11227fc3c4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d247e74c5985d8cc36a5e4ca39e616 3x", "genre": "art", "nsfw": false, "body": "こんにちは、アバター用に私のキャラクターのイラストをお願いしたいのですが、あなたの目の描き方が大好きです\n彼女には少しいかつい笑顔をしてもらいたいのですが、あとはあなたにお任せします。\n\nhttps://filen.io/d/8136b39c-0641-4884-9ebd-afc3986e4b98#!J8P96gyzzyM5UxH4lUY3f7QLCY6isnxN", "created_at": "", "completed_at": ""}, {"path": "/@TOAa510/works/2", "thumbnail_src": "https://si.imgix.net/928b9d40/uploads/origins/87a1f022-ff2d-4087-98d0-7159a9f8e650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c14d376383d3bbe01361639c548b9df", "thumbnail_srcset": "https://si.imgix.net/928b9d40/uploads/origins/87a1f022-ff2d-4087-98d0-7159a9f8e650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c14d376383d3bbe01361639c548b9df, https://si.imgix.net/928b9d40/uploads/origins/87a1f022-ff2d-4087-98d0-7159a9f8e650?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c5c26a67b9d14c378ee1bf0582ebff7 2x, https://si.imgix.net/928b9d40/uploads/origins/87a1f022-ff2d-4087-98d0-7159a9f8e650?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b89b992a1c7606c6b1519cea190a0565 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します！とあぁーさんの描く絵が好きで最近作成したうちの子を描いてほしいと思いリクエストさせていただきました！ とあぁーさんの描いた下記の画像の様なポーズで、アイドル衣装を着たうちの子を見たいですが、うちの子のアイドル衣装というのが決まっていないので、とあぁーさんに衣装の見た目等は任せたいのですが大丈夫でしょうか？ スマホの壁紙等に使用したいので、2532mm×1170mmの比率のキャンバスで描いて頂いて、宛名は別レイヤーにしてもらえると嬉しいです！ 参考https://twitter.com/toaa510/status/1360953718041174020?s=21\n\nhttps://twitter.com/tokinon_/status/1442472332304416776?s=21", "created_at": "", "completed_at": ""}, {"path": "/@TOAa510/works/1", "thumbnail_src": "https://si.imgix.net/02f91df3/uploads/origins/ebc3a03f-eac9-4a44-89e0-b41994f6c646?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbf339522e97638078e44ccec00c1654", "thumbnail_srcset": "https://si.imgix.net/02f91df3/uploads/origins/ebc3a03f-eac9-4a44-89e0-b41994f6c646?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbf339522e97638078e44ccec00c1654, https://si.imgix.net/02f91df3/uploads/origins/ebc3a03f-eac9-4a44-89e0-b41994f6c646?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52b4c25f981e9ef81e2ec90673b2c465 2x, https://si.imgix.net/02f91df3/uploads/origins/ebc3a03f-eac9-4a44-89e0-b41994f6c646?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13c06bb1168fa18784f103c94614459a 3x", "genre": "art", "nsfw": false, "body": "こんばんわ！とあぁーさんの描く目力が強めの絵が好きで自分がVRChatというゲームで使用しているアバターを描いてほしいと思いリクエストさせていただきました！\nとあぁーさんのメディア欄にある下記の画像と同じ様な、不敵な笑みで首の「キリトリ線」が見える具合に首にロープ的な紐を巻いている絵を描いて頂きたいです。\n\nポスターにして部屋に飾りたいのでB2サイズ(515mm×728mm)の比率のキャンバスで描いて頂いて、宛名は別レイヤーにしてもらえると嬉しいです！\n服が複雑と思いますので、もしお手間でしたら黒かグレーのパーカーで簡略化してくださればと思います。\n\nご検討よろしくお願いします。\n\n参考画像\nhttps://twitter.com/TOAa510/status/1329401488611786752?s=20\n自アバター\nhttps://photos.app.goo.gl/qbv4jdT1f2XA4fCc9", "created_at": "", "completed_at": ""}]}