a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16944f89f36b4d26afb0fee2e32cafd5, https://si.imgix.net/5ee94d0d/uploads/origins/6de754ec-3951-46e5-bcaf-bec3562cacba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2aa7cb321377432cb7cc427ad43fd1b2 2x, https://si.imgix.net/5ee94d0d/uploads/origins/6de754ec-3951-46e5-bcaf-bec3562cacba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96d779c5871252d81be0ca40c1b7fdfd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/25", "thumbnail_src": "https://si.imgix.net/515f9763/uploads/origins/f2458c57-050f-4c59-a6f0-ee960a6bd824?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5f76bbfa1e735cc7dc58328f6dc881", "thumbnail_srcset": "https://si.imgix.net/515f9763/uploads/origins/f2458c57-050f-4c59-a6f0-ee960a6bd824?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5f76bbfa1e735cc7dc58328f6dc881, https://si.imgix.net/515f9763/uploads/origins/f2458c57-050f-4c59-a6f0-ee960a6bd824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92cd62335c9b1bb757125b21b5fff269 2x, https://si.imgix.net/515f9763/uploads/origins/f2458c57-050f-4c59-a6f0-ee960a6bd824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e859aafcf01d0a0459dbe32e1268b58 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたのアートはとてもかわいいです！うちの子のイラストをお願いしたいです！\n\nポーズやシチュエーションはお任せしたいです！恥ずかしがり屋で、下着が大好きな男の子です。ケモショタのプロポーションで描いていただけませんか？\n\n右の頬には小さな月、左の頬には小さな太陽、目には星。\n\nhttps://drive.google.com/file/d/1nKI_iT69_XqyrT6DDFbTm1kC3YOsA8Ps/view?usp=sharing", "cr