e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f78826a5acb3846df7c025ef04b9d944 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nふわふわでとっても可愛い絵柄に一目惚れして、お願いさせていただきました…！\nポーズはおまかせで、私の子を可愛く描いていただけたら嬉しいです。\nどうぞよろしくお願いいたします✨\n\nhttps://drive.google.com/drive/folders/1MtVYSQj17QphwLIyUmbLvouY9HoyywNa", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/43", "thumbnail_src": "https://si.imgix.net/a7f6c5d4/uploads/origins/be1fce9c-91da-474d-a5ec-91df225b8a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376bf890886681b903aa5c3999372bab", "thumbnail_srcset": "https://si.imgix.net/a7f6c5d4/uploads/origins/be1fce9c-91da-474d-a5ec-91df225b8a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376bf890886681b903aa5c3999372bab, https://si.imgix.net/a7f6c5d4/uploads/origins/be1fce9c-91da-474d-a5ec-91df225b8a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f8b97c4e8bd5607d6ce98cf32fa7f60 2x, https://si.imgix.net/a7f6c5d4/uploads/origins/be1fce9c-91da-474d-a5ec-91df225b8a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6a5d1798b5494082323524b6c5fc97e 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n私のキャラクターを描いてほしい。\nどんな風に描いてもいいよ。\n\nありがとうございます。\n\nhttps://drive.google.com/drive/folders/1h-VMD4Q1C3j5u0YS_FDxSQxjGQ9q_OAG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/42", "thumbnail_src": "https://si.imgix.net/d1d6f032/uploads/origins/634211eb-90ec-44bb-bc20-ca7556730938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8579445e916ad079cf7d94448bae50c3", "thumbnail_srcset": "https://si.imgix.net/d1d6f032/uploads/origins/634211eb-90ec-44bb-bc20-ca7556730938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8579445e916ad079cf7d94448bae50c3, https://si.imgix.net/d1d6f032/uploads/origins/634211eb-90ec-44bb-bc20-ca7556730938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ed732fcd902f686b48e837333502701 2x, https://si.imgix.net/d1d6f032/uploads/origins/634211eb-90ec-44bb-bc20-ca7556730938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b86ff477bde4f5a3da09e08ec48dbbe 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品がとても好きなので、私のキャラクターを描いてほしいです！\n彼女は活発な性格のふわふわした鯉のぼりです。頭の青い髪飾りは取り外しても構いません。\nまた、できれば彼女の爪をもっと見せてください！\n\nhttps://drive.google.com/drive/folders/1J128AM8Gm3_mjn0jnfVpt37CUq7QeKM2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/41", "thumbnail_src": "https://si.imgix.net/75abf684/uploads/origins/34fcf0bc-559d-4040-af78-ace9f2726312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a148df9f6944b50c5ef6603fde094732", "thumbnail_srcset": "https://si.imgix.net/75abf684/uploads/origins/34fcf0bc-559d-4040-af78-ace9f2726312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a148df9f6944b50c5ef6603fde094732, https://si.imgix.net/75abf684/uploads/origins/34fcf0bc-559d-4040-af78-ace9f2726312?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=355aae0dae3f351787219147a4f9d39d 2x, https://si.imgix.net/75abf684/uploads/origins/34fcf0bc-559d-4040-af78-ace9f2726312?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff0da2d5bc985b90c209a61c93b1aeb4 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのイラストがとても可愛いです。\nうちの子をあなたのスタイルで描いてほしいです！\nこの子が寝起きで星の形をした抱き枕を抱えている姿を描いていただけませんか。\n依頼経験が少なく、何か失礼がありましたら申し訳ございません。\n\n使用用途\n・自分のSNSにてクリエイター様を明記した上での掲載\n・個人利用の目的で、商用ではない印刷\n\nhttps://drive.google.com/drive/folders/1bLCn6geSi5vevz_YQdYeE0-OqWgeCiKy?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/40", "thumbnail_src": "https://si.imgix.net/1b6e35a3/uploads/origins/4f3af7be-a494-4f20-bd95-d3dd8b25606c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f173b2c55f42bd9a80aee1e164d0a943", "thumbnail_srcset": "https://si.imgix.net/1b6e35a3/uploads/origins/4f3af7be-a494-4f20-bd95-d3dd8b25606c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f173b2c55f42bd9a80aee1e164d0a943, https://si.imgix.net/1b6e35a3/uploads/origins/4f3af7be-a494-4f20-bd95-d3dd8b25606c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d306d779dff6972a67a44dcc739af6a8 2x, https://si.imgix.net/1b6e35a3/uploads/origins/4f3af7be-a494-4f20-bd95-d3dd8b25606c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a46ce1ee5cdbffb50ecf5b78e389aac 3x", "genre": "art", "nsfw": false, "body": "こんにちは！最近の作品を拝見し、とてもかわいいと思ったので、かわいいイラストをお願いしたいです！表情やポーズは自由ですが、片耳にオレンジ色のリリーをお願いしたいです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1BN1Kd2W6_n5mS1oolRDTfuoG5OU-t63e?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/39", "thumbnail_src": "https://si.imgix.net/611b34e8/uploads/origins/b605ea7b-d935-4309-b8f3-692d4b3ce331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdcad80c2ae161bb2782d2173c86c81f", "thumbnail_srcset": "https://si.imgix.net/611b34e8/uploads/origins/b605ea7b-d935-4309-b8f3-692d4b3ce331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdcad80c2ae161bb2782d2173c86c81f, https://si.imgix.net/611b34e8/uploads/origins/b605ea7b-d935-4309-b8f3-692d4b3ce331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a88d9c5655225a2513388910682788f 2x, https://si.imgix.net/611b34e8/uploads/origins/b605ea7b-d935-4309-b8f3-692d4b3ce331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4f34eccc5796f6c93d81f4de8e0f70e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートスタイルがとても気に入りました！私のキャラクターのイラストをお願いしたいです。星空のような銀河系の猫です。ポーズは自由ですが、できるだけ足が見える方が嬉しいです。星空や銀河のような夜空のような雰囲気の絵が良いですね。首の毛のシンボルはℵです。\n\nhttps://drive.google.com/drive/folders/1CgDcts1azLsoR7nL1EXDgcAnJd1HPirI", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/38", "thumbnail_src": "https://si.imgix.net/2826104c/uploads/origins/6e79719c-9ce2-47e3-82bc-fa57058dce1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09dc9d93bb5ea88d6b2838a42f029114", "thumbnail_srcset": "https://si.imgix.net/2826104c/uploads/origins/6e79719c-9ce2-47e3-82bc-fa57058dce1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09dc9d93bb5ea88d6b2838a42f029114, https://si.imgix.net/2826104c/uploads/origins/6e79719c-9ce2-47e3-82bc-fa57058dce1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d3f75d7c744aa4abe7da4e966375bc6 2x, https://si.imgix.net/2826104c/uploads/origins/6e79719c-9ce2-47e3-82bc-fa57058dce1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=687347a172beedd7fe5f5255744dfc7b 3x", "genre": "art", "nsfw": false, "body": "しゃるぺけさま。はじめまして。\n素敵なイラストを拝見していて、是非しゃるぺけさまのイラストでうちの子描いていただけないでしょうか？\nメンタル弱めの犬けもです。自由に解釈して自由に描いていただきたいです。\n\nご検討いただけたら嬉しいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1pShXaHWPCA6xt7lKfFbvYm2gReyCoynq", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/37", "thumbnail_src": "https://si.imgix.net/af65fcb7/uploads/origins/e91bdda3-3710-4eef-aa18-68ebb4214f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c2de1036b7e04496dcaf7b87be1b614", "thumbnail_srcset": "https://si.imgix.net/af65fcb7/uploads/origins/e91bdda3-3710-4eef-aa18-68ebb4214f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c2de1036b7e04496dcaf7b87be1b614, https://si.imgix.net/af65fcb7/uploads/origins/e91bdda3-3710-4eef-aa18-68ebb4214f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f867dae20c388591d9d6b94ce3587f9e 2x, https://si.imgix.net/af65fcb7/uploads/origins/e91bdda3-3710-4eef-aa18-68ebb4214f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6438797945b95ca6eae313726152f49c 3x", "genre": "art", "nsfw": true, "body": "先生、こんにちは。\n先日先生が描かれたブリーフのイラストがとても気に入りました。\nもしよろしければ、私の子にも一枚描いていただければ嬉しいです。\nその他の自由創作については、どうかご無理なく、先生にご負担のない範囲でお願いできればと思います。\nありがとうございます\n\nhttps://drive.google.com/file/d/1rGzJuPqh6R2WfJXUzD4_xppB0WSb1enV/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/36", "thumbnail_src": "https://si.imgix.net/f5adca11/uploads/origins/7ce51784-1a9e-4b54-b9bf-23c9a86eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e372244d8cf54719d60593a26b8c51b", "thumbnail_srcset": "https://si.imgix.net/f5adca11/uploads/origins/7ce51784-1a9e-4b54-b9bf-23c9a86eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e372244d8cf54719d60593a26b8c51b, https://si.imgix.net/f5adca11/uploads/origins/7ce51784-1a9e-4b54-b9bf-23c9a86eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f73953269b84ce19d950a4fb85c6f8ff 2x, https://si.imgix.net/f5adca11/uploads/origins/7ce51784-1a9e-4b54-b9bf-23c9a86eb02e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebcf027a4b8edca7483eddfd3e220b73 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Pekeさん！👋 初めまして。お元気でいらっしゃいますか？😄\n\nSkebでアーティストを探しているときに、あなたのことを知りました。\n\nぜひイラストのリクエストをさせてください！！あなたのとても可愛くて独特なスタイル、キャラクターをすごく愛らしく描くところにすっかり魅了されています。あなたのスタイルは本当に唯一無二です！🥰🥰🥰\n\n私のふわふわのドラゴンの男の子を描いてほしいです！！彼は元気で、カリスマ性があり、冒険好きで、とても幸せそうです。\n\n特に決まったイメージはないので、その他の部分はすべてお任せします。☺️\nあなたはとても才能のある方だと思うので、素晴らしい作品を描いてくださると確信しています😆\n\nリクエストをご検討いただけると大変嬉しいです。どうぞよろしくお願いします。素敵な一日をお過ごしください！！❤️💜\n\nhttps://drive.google.com/drive/folders/175SL7H91hYIrIsWqU6FdTguZo3Bag6aQ", "created_at": "", "completed_at": ""}, {"path": "/@peke_malu_/works/35", "thumbnail_src": "https://si.imgix.net/237cfb56/uploads/origins/c9fac5b1-4b5b-4b03-b7cd-bc6a70167235?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55f2d3a4ff479fb5bcb529e693443159", "thum