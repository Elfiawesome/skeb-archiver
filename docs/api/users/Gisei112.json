%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c692b3d3572340a50f4cec136f96e4", "thumbnail_srcset": "https://si.imgix.net/526b1e4e/uploads/origins/5087e8b0-caf8-4bd2-807a-70699c28847d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c692b3d3572340a50f4cec136f96e4, https://si.imgix.net/526b1e4e/uploads/origins/5087e8b0-caf8-4bd2-807a-70699c28847d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=332d01845d6a7f2ec61f2ed8642c40fb 2x, https://si.imgix.net/526b1e4e/uploads/origins/5087e8b0-caf8-4bd2-807a-70699c28847d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2eb1c94ddb8e8fcaff9f43da6cfb2c14 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nURLの女の子のイラマチオイラストをお願いできますでしょうか。\n\nhttps://www.pixiv.net/artworks/119719229\nhttps://www.pixiv.net/artworks/119820062\n\n画角は縦長、構図は女の子の正面からのプレイ（男主観）としてください。\n\n男は両手で女の子の頭を押さえて、赤面涙目イラマしていただきたいです。\n射精は口内で、口から溢れ出るような感じ、なんなら量が多すぎてぶっかけみたいになって、\n先生のこちらの作品のように\n\nhttps://www.pixiv.net/artworks/114783971\n\n顔も髪もベトベトにしてしまいたいです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Gisei112/works/196", "thumbnail_src": "https://si.imgix.net/02569da8/uploads/origins/01e49e01-0d0a-4b93-8674-5e14cca49e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb22fe4a3b28bd92ab8d823b4d9e4788", "thumbnail_srcset": "https://si.imgix.net/02569da8/uploads/origins/01e49e01-0d0a-4b93-8674-5e14cca49e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb22fe4a3b28bd92ab8d823b4d9e4788, https://si.imgix.net/02569da8/uploads/origins/01e49e01-0d0a-4b93-8674-5e14cca49e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=165d7e7fd98244c54953aa30fa2d27c8 2x, https://si.imgix.net/02569da8/uploads/origins/01e49e01-0d0a-4b93-8674-5e14cca49e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86af41924a12c51511d5f1036da15a13 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n\nhttps://skeb.jp/@Gisei112/works/141\nこちらのリクエストで描かれていた、ヘテロギガントに犯される転スラキャラたちのイラストがとても良かったので、こちらと同じシチュエーションのものを別のキャラで描いていただきたいです。\n\nキャラクターは、\n朱雀院紅葉（紅月ゆれる恋あかり）\nhttps://crystalia.amusecraft.com/yureaka/chara02.html\n\n朱雀院撫子（刹那にかける恋はなび）\nhttps://crystalia.amusecraft.com/kakehana/chara01.html\n\n朱雀院都子（絆きらめく恋いろは）\nhttps://crystalia.amusecraft.com/tsubaki/chara03.html\n\n朱雀院椿（同上）\nhttps://crystalia.amusecraft.com/mekuiro/chara02.html\n\n以上の四名です。\n\n服装は紅葉と都子が白のニーハイソックス、撫子と椿が黒タイツを残して全裸で、\nタイツは股間部分を破いてください。\n\n差分についても元のリクエストと同じでお願いしたいです。\n\nご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Gisei112/works/195", "thumbnail_src": "https://si.imgix.net/e82b3a26/uploads/origins/389b96ff-fae4-4e90-b8e9-805a82998a42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b27ab4a6cb305ab219bbf7df91dfea55", "thumbnail_srcset": "https://si.imgix.net/e82b3a26/uploads/origins/389b96ff-fae4-4e90-b8e9-805a82998a42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b27ab4a6cb305ab219bbf7df91dfea55, https://si.imgix.net/e82b3a26/uploads/origins/389b96ff-fae4-4e90-b8e9-805a82998a42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=734898d0f6bf09e1bf57f67c630ede14 2x, https://si.imgix.net/e82b3a26/uploads/origins/389b96ff-fae4-4e90-b8e9-805a82998a42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74cc9c78e5f40c85bd3ec6df8bff661 3x", "genre": "art", "nsfw": true, "body": "どうも、こんにちは。\n前回はグラーフ・ツェッペリンをありがとうございました。\n\n今回は艦隊これくしょんの龍驤をお願い致します。\nhttps://blog-imgs-112-origin.fc2.com/k/c/w/kcwiki/No030_0_CD.jpg\nhttps://blog-imgs-112-origin.fc2.com/k/c/w/kcwiki/No157_2_CD.jpg\n\n内容としては拘束状態で馬姦からの妊娠シチュエーションお願いします。\n拉致られからの馬妊娠実験体にされたイメージです。\n\n構図としては、お任せ致します（対面でも後ろからでも）。\nリョナチックになりますが肋骨が砕けていそうな（砕ける表現は無くて大丈夫です）くらい深々ねじ込まれる感じでお願いします。\n駆逐艦並の体格（下手すると駆逐艦より小柄）にねじ込まれる感じで。\n\n服装ですが、今回は全裸でお願いします。\nサンバイザーは有無はお任せ致します。\n\nシチュエーション\n１、抵抗表情からの挿入\n　『くッ！』と抵抗から無理やり挿入をお願いします。\n　挿入時の激痛に歯を食いしばりながら耐えている表情をして欲しいです。\n　犯されている最中からヨダレや涙で顔がグシャグシャ、母乳や愛液を吹き出て欲しいです。\n\n2、射精後に妊娠\n　射精で絶叫表情から息を整えてからの急速妊娠。\n　妊娠したことによる驚愕表情(瞳孔が開くタイプ）からの、限界を迎えて気絶する表情（瞳が少し見えるタイプの白目）をお願いします。\n\n龍驤はベテラン艦娘のイメージ（赤城加賀より年上）なので、妊娠まで耐えている感じでお願いします。\n\n普通（？）の馬姦妊娠シチュですが、どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Gisei112/works/194", "thumbnail_src": "https://si.imgix.net/9c541b47/uploads/origins/9c9c1c4f-96fd-4f18-bf89-475d3e334a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c27119d1a4c6e3d3950ac730bc248fdb", "thumbnail_srcset": "https://si.imgix.net/9c541b47/uploads/origins/9c9c1c4f-96fd-4f18-bf89-475d3e334a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c27119d1a4c6e3d3950ac730bc248fdb, https://si.imgix.net/9c541b47/uploads/origins/9c9c1c4f-96fd-4f18-bf89-475d3e334a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b2f3d088971c19e8e465f6871656690 2x, https://si.imgix.net/9c541b47/uploads/origins/9c9c1c4f-96fd-4f18-bf89-475d3e334a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49acd5fef0fb8e84779d356aeda17e1f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gisei112/works/193", "thumbnail_src": "https://si.imgix.net/3454670c/uploads/origins/af21e7b6-3260-4dc0-a555-5b53eecdbd4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=138814c56d8bad5d598c0ab36a468ad9", "thumbnail_srcset": "https://si.imgix.net/3454670c/uploads/o