_at": ""}, {"path": "/@usotuki_mannjyu/works/4", "thumbnail_src": "https://si.imgix.net/fb9a4347/uploads/origins/efca3a37-ccf7-4df5-8e57-fda271327d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4770f572aabe97aaedcaa9d070e6a51", "thumbnail_srcset": "https://si.imgix.net/fb9a4347/uploads/origins/efca3a37-ccf7-4df5-8e57-fda271327d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4770f572aabe97aaedcaa9d070e6a51, https://si.imgix.net/fb9a4347/uploads/origins/efca3a37-ccf7-4df5-8e57-fda271327d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=405dcba4745b93d80c38a18843f53dae 2x, https://si.imgix.net/fb9a4347/uploads/origins/efca3a37-ccf7-4df5-8e57-fda271327d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f02848c4eda1087a34889c5c71aff1dc 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nアイドルマスターシンデレラガールズの水木聖來さんのイラストをリクエストさせて頂きます。\n衣装はシンデレラガールズとアニメイトカフェのコラボ描き下ろしイラストで藤原肇ちゃんが着ているバニー衣装で、笑顔でウインクしている表情でお願いします。\n他、ポーズや構図等は全てお任せします。ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@usotuki_mannjyu/works/3", "thumbnail_src": "https://si.imgix.net/b8adcb65/uploads/origins/c24f4688-6917-450f-a8fd-223963d6d3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca1c385cde232afe8e6e8373e499abd", "thumbnail_srcset": "https://si.imgix.net/b8adcb65/uploads/origins/c24f4688-6917-450f-a8fd-223963d6d3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca1c385cde232afe8e6e8373e499abd, https://si.imgix.net/b8adcb65/uploads/origins/c24f4688-6917-450f-a8fd-223963d6d3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fd0ef0d3179f489382f72b9018ef3c5 2x, https://si.imgix.net/b8adcb65/uploads/origins/c24f4688-6917-450f-a8fd-223963d6d3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6dd716ffef18e98f3eab85ac58ffefa 3x", "genre": "art", "nsfw": fals