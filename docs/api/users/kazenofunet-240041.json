mgix.net/5642e532/uploads/origins/c94f9f92-9643-4007-93a8-82f2423840d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=019435ad6af52f04a55f45a95c2088d7 2x, https://si.imgix.net/5642e532/uploads/origins/c94f9f92-9643-4007-93a8-82f2423840d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe7805e5f904c7beb37e1c5cadfbe85b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/22", "thumbnail_src": "https://si.imgix.net/5916bd7e/uploads/origins/c72584d8-91e7-4fac-b845-53f14091e19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91255eb40f14356b91e0e19f638a1228", "thumbnail_srcset": "https://si.imgix.net/5916bd7e/uploads/origins/c72584d8-91e7-4fac-b845-53f14091e19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91255eb40f14356b91e0e19f638a1228, https://si.imgix.net/5916bd7e/uploads/origins/c72584d8-91e7-4fac-b845-53f14091e19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27b2f18941681649111274350db70374 2x, https://si.imgix.net/5916bd7e/uploads/origins/c72584d8-91e7-4fac-b845-53f14091e19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=779cc2d97b4ace16721587e0d555d7a2 3x", "genre": "art", "nsfw": true, "body": "初めまして　かぜのふねさんところの風香ちゃんが可愛くて好きなので一つリクエストさせて頂きます。\n風香ちゃんがヘリウム風船の束でちょっぴりエッチな遊びをしているところが見てみたいです。\n風船はネックが少し飛び出たくらいにしていただけると嬉しいです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/21", "thumbnail_src": "https://si.imgix.net/cfda61e7/uploads/origins/df955761-f53a-460c-b6e9-829af743ba3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e94407ec1d123ab8de30f30210e1078", "thumbnail_srcset": "https://si.imgix.net/cfda61e7/uploads/origins/df955761-f53a-460c-b6e9-829af743ba3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e94407ec1d123ab8de30f30210e1078, https://si.imgix.net/cfda61e7/uploads/origins/df955761-f53a-460c-b6e9-829af743ba3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6976102766ffb78d8c630153f5bebfb 2x, https://si.imgix.net/cfda61e7/uploads/origins/df955761-f53a-460c-b6e9-829af743ba3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f72c243889977ca7c1a122a38e5eab6b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/20", "thumbnail_src": "https://si.imgix.net/fa0c6cc7/uploads/origins/367ee9c6-0a58-44c6-98cf-c367a2fac500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3df992a7bd8da9f52cfb3bb83d657a7c", "thumbnail_srcset": "https://si.imgix.net/fa0c6cc7/uploads/origins/367ee9c6-0a58-44c6-98cf-c367a2fac500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3df992a7bd8da9f52cfb3bb83d657a7c, https://si.imgix.net/fa0c6cc7/uploads/origins/367ee9c6-0a58-44c6-98cf-c367a2fac500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0eae3e30ded731cf874727b057a156e1 2x, https://si.imgix.net/fa0c6cc7/uploads/origins/367ee9c6-0a58-44c6-98cf-c367a2fac500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b0be7c816bc3db7987db549b839f66c 3x", "genre": "art", "nsfw": false, "body": "前回は突然のリクエストにも関わらず受けていただきありがとうございました。風船と雪美ちゃん本当に可愛かったです \n\n さて今回ですが、かぜのふねさんのオリジナルキャラである風香ちゃんをお願いします。\n 少々人を選ぶシチュエーションかもしれませんが、女児服を着た小3くらいの風香ちゃんが、もらったヘリウム風船が割れてしまって、風船の破片のついた紐を持ったまま悲しくて涙ぐんでしまっている様子をよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/19", "thumbnail_src": "https://si.imgix.net/e6eb53b5/uploads/origins/104432b8-90f3-48c8-b5ff-19091558b11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d512a2457544f8a65da4908a7781f8", "thumbnail_srcset": "https://si.imgix.net/e6eb53b5/uploads/origins/104432b8-90f3-48c8-b5ff-19091558b11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d512a2457544f8a65da4908a7781f8, https://si.imgix.net/e6eb53b5/uploads/origins/104432b8-90f3-48c8-b5ff-19091558b11c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8adc14f44bd5133e0d65656a133f899d 2x, https://si.imgix.net/e6eb53b5/uploads/origins/104432b8-90f3-48c8-b5ff-19091558b11c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3eefea8414dd9f8a00ede03ce4888526 3x", "genre": "art", "nsfw": false, "body": "部屋のベッドか公園のベンチに座って赤いパンチバルーンを嬉しそうに抱きしめているデレマスの佐城雪美(モバマスNカードの普段着)をお願いします。イベントか何かでもらった風船を喜んで無邪気に愛でている感じで、手首に他にもらったヘリウム風船の紐が結んであると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/18", "thumbnail_src": "https://si.imgix.net/3d8b287f/uploads/origins/f99044da-6c1c-44a3-a7a6-1f4c2c614836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e1d3468ca5e6c889ac80ecc10ff4f8a", "thumbnail_srcset": "https://si.imgix.net/3d8b287f/uploads/origins/f99044da-6c1c-44a3-a7a6-1f4c2c614836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e1d3468ca5e6c889ac80ecc10ff4f8a, https://si.imgix.net/3d8b287f/uploads/origins/f99044da-6c1c-44a3-a7a6-1f4c2c614836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6889814722e4a80b7a20a85e48a62eaf 2x, https://si.imgix.net/3d8b287f/uploads/origins/f99044da-6c1c-44a3-a7a6-1f4c2c614836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77725d4818c711efe41bd8d54feb0ed8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/17", "thumbnail_src": "https://si.imgix.net/7b33bc61/uploads/origins/1f431f81-5f5f-4d21-aec1-4685444be95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3534b3cc4823713b582ae9e8eb4e9d0", "thumbnail_srcset": "https://si.imgix.net/7b33bc61/uploads/origins/1f431f81-5f5f-4d21-aec1-4685444be95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3534b3cc4823713b582ae9e8eb4e9d0, https://si.imgix.net/7b33bc61/uploads/origins/1f431f81-5f5f-4d21-aec1-4685444be95f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fd5a4c0e3536ea29ba99fd0173937ce 2x, https://si.imgix.net/7b33bc61/uploads/origins/1f431f81-5f5f-4d21-aec1-4685444be95f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8efc92faa0bfa8130bc4e360e2a7df4 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。4度目のオトメドメインの依頼です。\nオトメドメインの飛鳥湊くんが体操着で目の前で巨大風船を膨らされてる絵をお願いします。\n（体操着のデザインは公式で確認できます。湊くんはブルマじゃなくてハーフパンツなので注意してください）\n表情は可愛い感じの恐怖顔、ハーフパンツ越しで勃起してるのがはっきりとわかるテント\n\n風船は下からホースで膨らまされててネックが出て破裂寸前のラウンド型24～32くらい、色や透明度大きさは湊くんが見えやすいくらいでおまかせします\n腕は身体の上でペンシル風船で縛って拘束してください\n\nお手数ですが、以下の差分が欲しいです\n\n①全裸、おちんちんが見えてる\n②↑の全裸差分の巨大風船破裂後、レイプ目、射精済みで精液が周囲の風船にいっぱい飛び散っている", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/16", "thumbnail_src": "https://si.imgix.net/4a7da1f8/uploads/origins/c84315bd-e0b1-46e9-a67d-6ad1b1ecce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226cb76772da77b46fdae62b9437ec69", "thumbnail_srcset": "https://si.imgix.net/4a7da1f8/uploads/origins/c84315bd-e0b1-46e9-a67d-6ad1b1ecce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226cb76772da77b46fdae62b9437ec69, https://si.imgix.net/4a7da1f8/uploads/origins/c84315bd-e0b1-46e9-a67d-6ad1b1ecce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aeb513aac955bbffb5aba3f81eb0e0a9 2x, https://si.imgix.net/4a7da1f8/uploads/origins/c84315bd-e0b1-46e9-a67d-6ad1b1ecce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f27e8a7ad34dc0f7ea169dc85758227d 3x", "genre": "art", "nsfw": true, "body": "ミスしたため送り直します\nオトメドメインの大垣ひなたお嬢様が体操着ブルマで風船の上で弾んでいるイラストをお願いします\n（体操着のデザインは公式で閲覧できます）\n顔は少し恥ずかしそうだけど楽しそうに\n乗っている風船はクオラ24イメージ、ネックが前向きに飛び出てて破裂寸前の無地、手にも16インチ程度の風船を1~2個持っていて欲しいです\n風船の色はおまかせします\n\nもし可能ならば、全裸差分が欲しいです", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/15", "thumbnail_src": "https://si.imgix.net/be940983/uploads/origins/bbc98ebb-3e52-45b8-bc0b-edf6bdef81fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a342edfbf2e0e597b2d5f1cfbe64ed7", "thumbnail_srcset": "https://si.imgix.net/be940983/uploads/origins/bbc98ebb-3e52-45b8-bc0b-edf6bdef81fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a342edfbf2e0e597b2d5f1cfbe64ed7, https://si.imgix.net/be940983/uploads/origins/bbc98ebb-3e52-45b8-bc0b-edf6bdef81fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c1afcba440b709cecdfa2cc8a95ad01 2x, https://si.imgix.net/be940983/uploads/origins/bbc98ebb-3e52-45b8-bc0b-edf6bdef81fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1780d6f4fc272de0121c6b3ff7726b38 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/14", "thumbnail_src": "https://si.imgix.net/9e9f17b9/uploads/origins/58f29f41-102b-4c2b-a6a5-30349039c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4d656f11689a0213e9db6c937f8d9bd", "thumbnail_srcset": "https://si.imgix.net/9e9f17b9/uploads/origins/58f29f41-102b-4c2b-a6a5-30349039c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4d656f11689a0213e9db6c937f8d9bd, https://si.imgix.net/9e9f17b9/uploads/origins/58f29f41-102b-4c2b-a6a5-30349039c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e804ace59f8b4692c220e6f7270eb89f 2x, https://si.imgix.net/9e9f17b9/uploads/origins/58f29f41-102b-4c2b-a6a5-30349039c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a9f75e8a26033b7f6b3cd0666a928b 3x", "genre": "art", "nsfw": true, "body": "かぜのふねさん、コミケお疲れ様でした。久々にお会いできて嬉しかったです。お話していたら風香ちゃんの続きが見たくなってしまったので、風船陵辱の続編でお願いしたいです。\n\n・前回の状況から、ずっと風船陵辱を繰り返させられ、たゆんと大きくなった胸と敏感にされて風船無しでは耐えられない身体に改造され、カメラで風船陵辱をされて喜んでいる姿を撮影されてしまう。\n・両手の鎖は外されるも、両足の鎖は付けたままの状態。\n・着用していた、破れた制服を着せられ、制服をたくしあげられて大きくなった両胸がたゆんと露出。\n・片方の乳首に触手が吸い付き、ちゅっちゅっと音を立てながら更に媚薬を注入されてしまう。\n・破れたスカートを自分の両手でたくしあげ、露出した下着の中に入った触手の先端に付いた透明丸形媚薬風船を下着一杯に膨らまされ、風船が膨らんで両足を無理やり開脚されながら、アソコに擦れてぐちゅぐちゅと音が鳴り響く。\n・蕩けた表情で、喜びながら自ら下着の中で大きく膨らむ風船をカメラで見せつけ、腰を振って風船に擦り付ける様を、大きくなって揺れる胸と一緒に撮影され、呂律の回らぬ声で風船に陵辱されることを喜び、下着内でもっと風船を膨らまして欲しいとおねだりをしてしまい、身体をビクンビクンと震わせながら盛大に風船にイカされてしまう。\n・以上のシチュを、簡単なセリフと擬音付きでお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/13", "thumbnail_src": "https://si.imgix.net/f14fd199/uploads/origins/97d30e0f-2aa7-45a7-928c-1acd8c38fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94291741979199c2d2f9a6b8bf2f1d65", "thumbnail_srcset": "https://si.imgix.net/f14fd199/uploads/origins/97d30e0f-2aa7-45a7-928c-1acd8c38fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94291741979199c2d2f9a6b8bf2f1d65, https://si.imgix.net/f14fd199/uploads/origins/97d30e0f-2aa7-45a7-928c-1acd8c38fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=967993f3f06f8bc28f33977a9c3061a1 2x, https://si.imgix.net/f14fd199/uploads/origins/97d30e0f-2aa7-45a7-928c-1acd8c38fbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ec02119cbd4c79b70c8c06a1e72763b 3x", "genre": "art", "nsfw": false, "body": "抱き合って赤色の風船を割ろうとしている櫻井美羽ちゃんと笠原桃奈ちゃんを描いて欲しいです。3次元のアーティストさんなので難しいかも知れませんが、是非挑戦して欲しいです！衣装は動画内と同じ水色のジャージ姿です。\n\n・笠原桃奈ちゃん(1枚目です)\nhttps://x.com/produce101jp_/status/1730513479604539760?s=46&t=BDSWBaMSBLey0uNI-ZS4oA\n・櫻井美羽ちゃん\nhttps://produce101.jp/feature/046_sakuraimiu\n・風船割りシーン\nhttps://x.com/6xpcv/status/1727840611309703352?s=46&t=BDSWBaMSBLey0uNI-ZS4oA", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/12", "thumbnail_src": "https://si.imgix.net/29a4fd26/uploads/origins/09f5097a-8c5d-4ebf-a950-009f1b8c2451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f98ecd91f16b7d42f54be9fd2378e4d", "thumbnail_srcset": "https://si.imgix.net/29a4fd26/uploads/origins/09f5097a-8c5d-4ebf-a950-009f1b8c2451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f98ecd91f16b7d42f54be9fd2378e4d, https://si.imgix.net/29a4fd26/uploads/origins/09f5097a-8c5d-4ebf-a950-009f1b8c2451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a59b0da15349c7b6c7858250ac7616b8 2x, https://si.imgix.net/29a4fd26/uploads/origins/09f5097a-8c5d-4ebf-a950-009f1b8c2451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=502209452bf7b2729a05ceeb795be66d 3x", "genre": "art", "nsfw": true, "body": "学校の帰りにヘリウム風船をもらって（3〜5個くらい）家に着いたら我慢出来なくて貰った風船を使ってオナニーをして気持ちよくなってる風香ちゃんをお願いします。\nはだけた制服姿でお願いします。\n手にヘリウム風船を何個か持たしてくださ\nい。\nオナニーに使われてる風船に風香ちゃんの愛液が着いてる様に描いてもらいたいです。\n可能でしたら台詞付きでお願いします。\n可能でしたら恍惚とした表情の差分と全裸差分も可能でしたらお願いします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/11", "thumbnail_src": "https://si.imgix.net/14091ff3/uploads/origins/98e6c5a4-1b9a-40e7-bba2-0496b88ee8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=877fc252e298d350f265353a55b51d25", "thumbnail_srcset": "https://si.imgix.net/14091ff3/uploads/origins/98e6c5a4-1b9a-40e7-bba2-0496b88ee8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=877fc252e298d350f265353a55b51d25, https://si.imgix.net/14091ff3/uploads/origins/98e6c5a4-1b9a-40e7-bba2-0496b88ee8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e87c266f6a5301c8446e0d3eb4d9d716 2x, https://si.imgix.net/14091ff3/uploads/origins/98e6c5a4-1b9a-40e7-bba2-0496b88ee8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edff5c73b0fd8a3e21afe9faad8e2206 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kazenofunet/works/10", "thumbnail_src": "https://si.imgix.net/0189839c/uploads/origins/2898fc0a-5723-4b39-9774-33972150b2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a63cb12470ae973f8245fc8e0fbb7dc", "thumbnail_srcset": "https://si.imgix.net/0189839c/uploads/origins/2898fc0a-5723-4b39-9774-33972150b2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t