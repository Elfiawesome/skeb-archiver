4b35-b345-82cdf008dcbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6696f00e71b3208d8fd23c6f2612fd90 2x, https://si.imgix.net/22b83149/uploads/origins/949af5da-5698-4b35-b345-82cdf008dcbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=379a4a6bc59527dcc0316be3f0e49951 3x", "genre": "art", "nsfw": false, "body": "クリスマスセーターを着た大森のぽっちゃりしたマリをリクエストしたい。ツリーにオーナメントを付けるために腕を伸ばし、セーターがめくれ上がってお腹とおへそが丸見えになる。お腹とおへそは見る人の方を向き、ツリーはそれを覆わないようにしてください。\n\nまず、マリはヒーローという男の子に、クリスマスに星を飾ろうと話している。セーターは彼女のぽっちゃりした体に普通にフィットしている。\n\n次に、マリが手を伸ばすとセーターがせり上がる。マリはヒーローに「見つめすぎだよ」といちゃつき、顔を赤らめる。\n\n三番目、ヒーローは彼女のセーターが短すぎると言う。マリは戸惑い、手を伸ばしながら下を向く。\n\n四つ目、マリは顔を赤らめ、ストレッチをしながらお腹を吸い込み始める。お腹が膨らんでいるだけよ！まだ痩せてるんだよ、ほら」。\n\nファース、疲れたマリがあくびをしながら普通にストレッチをする。\n\nフルカラー。シーン追加で英訳。\n\nマリ：\nhttps://gelbooru.com/index.php?page=post&s=view&id=11988842&tags=mari_%28omori%29+sweater", "created_at": "", "completed_at": ""}, {"path": "/@adam1157POCHA/works/5", "thumbnail_src": "https://si.imgix.net/f4333d13/uploads/origins/653db228-33a2-4a38-aebb-42be4d4ba511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca5befa0f69174842d3918e0fa0b4810", "thumbnail_srcset": "https://si.imgix.net/f4333d13/uploads/origins/653db228-33a2-4a38-aebb-42be4d4ba511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca5befa0f69174842d3918e0fa0b4810, https://si.imgix.net/f4333d13/uploads/origins/653db228-33a2-4a38-aebb-42be4d4ba511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d559eadd100ce683a46618bb7a719aa0 2x, https://si.imgix.net/f4333d13/uploads/origins/653db228-33a2-4a38-aebb-42be4d4ba511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ab707d880cbbd6febb89ec3b687d28d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いいこなさん！\n\n以前から作品のファンだったのですが、スケブがオープンしていたので驚きました。\n私のぽっちゃりした女の子、マヤを描いてください！\n\nhttps://skeb.jp/@ebiebi_r/works/131\nhttps://www.dropbox.com/scl/fi/q9p2im33jgwo0esqzghoa/maya_fin_blue.png?rlkey=jzu27u8oy62d3h67ub9754tnz&dl=0\nhttps://imgur.com/rBnokkU\nhttps://skeb.jp/@mtp_assu0/works/14\n\n時々、ヤンデレになる。\nhttps://skeb.jp/@nekoyashiki_NOW/works/20\n\n唇にこんなピアスをしている。\nhttps://imgur.com/DJlQsGi\n\n東方Projectの伊左ヱ門のように豪快にナイフを振り回す。\nhttps://www.dropbox.com/scl/fi/i24onqtcmkf357908nrvj/sakuya_1199986.jpg?rlkey=tqzj8ilvzh27s5p0ezh0kkdjj&dl=0\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@adam1157POCHA/works/4", "thumbnail_src": "https://si.imgix.net/f5c4c865/uploads/origins/68ab2160-ce72-406f-96d5-cdbe2791de95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fd98aa840c367c8438aa90e08caefd4", "thumbnail_srcset": "https://si.imgix.net/f5c4c865/uploads/origins/68ab2160-ce72-406f-96d5-cdbe2791de95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fd98aa840c367c8438aa90e08caefd4, https://si.imgix.net/f5c4c865/uploads/origins/68ab2160-ce72-406f-96d5-cdbe2791de95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8896b54e9dcb0ff0eaf7f916375fc256 2x, https://si.imgix.net/f5c4c865/uploads/origins/68ab2160-ce72-406f-96d5-cdbe2791de95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a690c9211a399359b7f93d1930b728e 3x", "genre": "art", "nsfw": false, "body": "ぽっちゃりバレー部女子の試合中のイラストを是非とも見たいと思い、依頼させて頂きました！！基本的にはいいこなさんにお任せになりますが、\n\n・黒ニーハイ\n・赤い大きなリボン付きのカチューシャ\n・立派な太もも\n\nは、絶対に入れて欲しいです。ご検討の程何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@adam1157POCHA/works/3", "thumbnail_src": "https://si.imgix.net/ca7a3805/uploads/origins/03396e1c-38ac-4c6e-a8d2-38f54f9534ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eac5713baa73e54a2d1b3ee541b938a", "thumbnail_srcset": "https://si.imgix.net/ca7a3805/uploads/origins/03396e1c-38ac-4c6e-a8d2-38f54f9534ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eac5713baa73e54a2d1b3ee541b938a, https://si.imgix.net/ca7a3805/uploads/origins/03396e1c-38ac-4c6e-a8d2-38f54f9534ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02fa5dae6e626679bc85581513a3bac8 2x, https://si.imgix.net/ca7a3805/uploads/origins/03396e1c-38ac-4c6e-a8d2-38f54f9534ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6103a03f3acb8d931f528e4847bb98b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、大森からぽっちゃりしたオーブリーの一連の絵をお願いできますか？\nまず、オーブリーにお腹を吸わせてください。お腹が苦しんでるのに、体を冷やそうとしてる。\n\n次に、お腹を長く我慢していたために元気がなくなり始め、オーブリーのお腹が膨らみ始めています。\n\n第三に、オーブリーが息を吐くと、お腹が膨らんで服からはみ出る。\n\nオプション：オーブリーにお腹をつかんでもらい、お腹を持ち上げる。\nhttps://static.wikia.nocookie.net/omori/images/c/cb/RW_Aubrey_Fullbody_Profile.png/revision/latest?cb=20221031043959", "created_at": "", "completed_at": ""}, {"path": "/@adam1157POCHA/works/2", "thumbnail_src": "https://si.imgix.net/5314655a/uploads/origins/ebc732a9-19cc-4264-9bd9-8239b5952c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c983278f7ecc9c9e8a778dc8eeef5c4", "thumbnail_srcset": "https://si.imgix.net/5314655a/uploads/origins/ebc732a9-19cc-4264-9bd9-8239b5952c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c983278f7ecc9c9e8a778dc8eeef5c4, https://si.imgix.net/5314655a/uploads/origins/ebc732a9-19cc-4264-9bd9-8239b5952c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12e739e6492abe812de02384b975f94d 2x, https://si.imgix.net/5314655a/uploads/origins/ebc732a9-19cc-4264-9bd9-8239b5952c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=518f571bfec56f6c70eb1a2d105894eb 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイヴのぽっちゃりした沙織を、大きなお腹とおへそを強調して描いてほしい。マスクはしない。先生という視聴者が彼女を見ていて、彼女が必死に吸い込みながら会話を続けているような台詞を追加してください。\n\n最初の写真では、できるだけお腹をへこませ、痩せて見えるようにしてほしい。彼女は冷静で落ち着いている。\n\nその後、彼女は元気を失い始め、お腹が膨らみ始める。彼女は顔を赤らめながら奮闘している。\n\n第三に、彼女はそれを受け入れ、ベルトの上でお腹を膨らませながら息を吐く。\n\n最後の写真は、膨らんだお腹からベルトが飛び出しているところです。先生が見ている間、彼女は顔を赤らめ始める。\n\nフルカラー。\n\nさおり：\nhttps://gelbooru.com/index.php?page=post&s=view&id=7282167&tags=saori_%28blue_archive%29+official_art+\n\n参考\nhttps://x.com/adam1157POCHA/status/1902920709057417448\n\n参考文献2\nhttps://x.com/adam1157POCHA/status/1896321007339934136", "created_at": "", "completed_at": ""}, {"path": "/@adam1157POCHA/works/1", "thumbnail_src": "https://si.imgix.net/bda9f033/uploads/origins/da891e22-e8e2-491a-b004-f86a5417fd16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d06ade1c6aa381e355238482f2bc1fee", "thumbnail_srcset": "https://si.imgix.net/bda9f033/uploads/origins/da891e22-e8e2-491a-b004-f86a5417fd16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d06ade1c6aa381e355238482f2bc1fee, https://si.imgix.net/bda9f033/uploads/origins/da891e22-e8e2-491a-b004-f86a5417fd16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2197bfc8d4f6c1555726d3bdfbcfff9a 2x, https://si.imgix.net/bda9f033/uploads/origins/da891e22-e8e2-491a-b004-f86a5417fd16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29b31021dbc6baf59525cf14f4dfee4f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}