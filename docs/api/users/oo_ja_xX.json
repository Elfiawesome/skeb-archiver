_at": ""}, {"path": "/@oo_ja_xX/works/15", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f522616402067aa06a7b81d85d8600a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3587128bd84769bc667e5943dbea91c9 3x", "genre": "voice", "nsfw": false, "body": "Hello! Could I please request your best attempt to say two English phrases [Here Comes A New Rival!] and [A New Challenger Approaches!] like a fighting tournament announcer. Thank you for considering!", "created_at": "", "completed_at": ""}, {"path": "/@oo_ja_xX/works/14", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c34b2c8bf3df56810e96b9dd7231b71", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c34b2c8bf3df56810e96b9dd7231b71, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c75f2a78478d65aa1121911da56e925 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fa19544731a77e36f2893e4eb73683b 3x", "genre": "novel", "nsfw": false, "body": "なんかテキストください\n\n以前に依頼したテキストデータは、\n既に全てボイス依頼してしまったので…\n\n僕にシチュエーションを考える才があれば！\nくっ！！\nまぁ冗談はさておき、アオヰさんの考えた\nテキストにアオヰさんのお声を当てて頂く\n\nこれは人類が目指した永久機関なのですよ\nあ、テキスト及び音声データは個人利用（ry", "created_at": "", "completed_at": ""}, {"path": "/@oo_ja_xX/works/13", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f522616402067aa06a7b81d85d8600a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3587128bd84769bc667e5943dbea91c9 3x", "genre": "voice", "nsfw": false, "body": "どうも！今回の依頼でついに納品して頂いたテキストデータが\n最後になります。6回目？ですか…感慨深いですね…\n\n～以下、本文～\n\nおや… \nいや、こんばんは。 \nガキがこんな夜中になにしてんの。 \n危ないよ。 \nん？迷子？めんどくせ… \nんんん……ん……仕方がないな。 \n家、どこらへんかわかってんの？ \nそう。じゃあ目瞑って。 \n…………………………目開けていいよ。 \nだが振り向くなよ。 \nあと真下も見るな。 \nそれで、どこら辺かわかる？ \nあそこ？本当に？…そうかい。 \nまた数奇な事もあったもんだ。 \nはいはい、送ってくからもっかい目ぇ瞑って。 \nは？おまえ、何してんだ？！ \n探しに来たぁ？私を？？？？？ \n阿呆か、はよ帰れ親が心配しとるぞ。 \n友達んちぃ？ \nおまえなぁ…そんな嘘すぐバレんで。 \nはあ。わかったわかった泊まっていいから！ \n家…家……んぁー、作る！ちょっと待ってろ！", "created_at": "", "completed_at": ""}, {"path": "/@oo_ja_xX/works/12", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f522616402067aa06a7b81d85d8600a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3587128bd84769bc667e5943dbea91c9 3x", "genre": "voice", "nsfw": false, "body": "依頼募集中に急げ～～～💦\n\n～以下、本文～\n\nん、なにしてんですかご主人。\nん～？な～んで頭撫でるんですか。\nいい年して恥ずかしい。\n私子供じゃありませんよ。\nえ？\nまぁた馬鹿言ってら。\nメイド服にそんな執着あったんですかあんた。\nえ？え、まって買ってたんですか？\nはあ？！作った？！ご主人が？？\nそんな器用でしたっけ？\nあ～、あの頃か…私がいないうちに。\nなにが鬼の居ぬ間にだ。誰が鬼じゃ。\nでも、じゃあなんで言わなかったんです？\n私に着せたかったんでしょう？\nえぇ、逆に気持ち悪いんですが。\nふむ。そうですねぇ。\nそれっ。\n……いやなんか言ってもらえます？？\nせっかく着てやったんだからさぁ。\n心残りねぇ～そりゃ良かった。\n私のメイド服が最期の心残りって…\nてかまって、この服穴空いて…\n尻尾用…？いやいつも出してないじゃないですか私。\n仕事行くときも出さないですよ私。\nはいはい、ご主人の仰せのままに。\nそんなもふらんでください。くすぐったいから。\nええ、良かったですねぇ、晴れていて。\n湿気ってたら最期だろうと出しませんでしたよ尾っぽ。\nふふ、そうですね。いい天気だ。\n……おやすみなさい、ご主人。", "created_at": "", "completed_at": ""}, {"path": "/@oo_ja_xX/works/11", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d248328d3a5ea6f7e5aa8a7aa0d28afe, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f522616402067aa06a7b81d85d8600a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3587128bd84769bc667e5943dbea91c9 3x", "genre": "voice", "nsfw": false, "body": "筋トレ用のカウントアップボイスください！\n30回3セットくらいあると助かります！\n雑に、ほれほれちゃんとやれ〜！とか言ってもらえると助かります", "created_at": "", "completed_at": ""}, {"path": "/@oo_ja_xX/works/10", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c42fa30467fdd183abe4b61e580c43b", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c42fa30467fdd183abe4b61e580c43b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1971190340867719169%2FvS3hOxsf.jpg?bg=%23fff&auto=format%2Cc