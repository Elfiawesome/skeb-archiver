6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a8d0d57f715e5d67546ada7ebdb06f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hutagoma/works/16", "thumbnail_src": "https://si.imgix.net/dcb3f371/uploads/origins/0c8afc3f-3b86-41ab-baf7-81c8a1e85286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b03bbc40fb1a81d9f8cbbea9c51f04d", "thumbnail_srcset": "https://si.imgix.net/dcb3f371/uploads/origins/0c8afc3f-3b86-41ab-baf7-81c8a1e85286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b03bbc40fb1a81d9f8cbbea9c51f04d, https://si.imgix.net/dcb3f371/uploads/origins/0c8afc3f-3b86-41ab-baf7-81c8a1e85286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a8e5b971f5c01584f23453a9c3acd9e 2x, https://si.imgix.net/dcb3f371/uploads/origins/0c8afc3f-3b86-41ab-baf7-81c8a1e85286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7c66e6ce603db6fdb24e9a36c0aea07 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nスケブやSNSで双子麻先生のイラストを見つけてすごい好みだったので、\n今回イラストをお願いしようと思いました、\n今回お願いしたいのは、月雪ミヤコちゃんです。\n\n衣服はパーカー(ブルアカアプリ内の青いパーカー)で頭の装飾は黒いリボン、ヘイローでお願いいたします。\n\n背景や細かいポーズなどは全て、双子麻先生にお任せします。\n\n【使用用途】 \nSNSや動画配信アプリでのアイコン、\nケータイの壁紙にしたいと思ってます\n\n最後まで読んで下さりありがとうございます。\nどうかご検討の程よろしくお願いします。\n長文失礼しました。\n【参考資料】 (パーカー、リボン)\n\nhttps://x.com/ran0722kira/status/1754064853579489510?s=46&t=A8rDHjmIwRTtOGnN306-hQ", "created_at": "", "completed_at": ""}, {"path": "/@hutagoma/works/15", "thumbnail_src": "https://si.imgix.net/3affd53e/uploads/origins/4add4ab5-9e6b-4da8-922b-6fbdf32121a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9be3464cc3a2f482af2fd651fbb576ab", "thumbnail_srcset": "https://si.imgix.net/3affd53e/uploads/origins/4add4ab5-9e6b-4da8-922b-6fbdf32121a1?bg=%23fff&auto=format%2Ccompress&fm=webp&