り削除したりしてください。私のキャラクターと彼が使うカタナの参考シートを添付します。よろしくお願いします。\n\nhttps://drive.google.com/file/d/111o8BUlsDGBSCn8h0Qc2IRg2f-LfROXv/view?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Miyama_Mariru/works/63", "thumbnail_src": "https://si.imgix.net/d9b0d527/uploads/outputs/ebd110af-7a20-498e-b0d6-7e2214cc2148?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a34fbe95ee48d1d9ed959526f3c10f3", "thumbnail_srcset": "https://si.imgix.net/d9b0d527/uploads/outputs/ebd110af-7a20-498e-b0d6-7e2214cc2148?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a34fbe95ee48d1d9ed959526f3c10f3, https://si.imgix.net/d9b0d527/uploads/outputs/ebd110af-7a20-498e-b0d6-7e2214cc2148?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61f71d583188414a759690df76254b5f 2x, https://si.imgix.net/d9b0d527/uploads/outputs/ebd110af-7a20-498e-b0d6-7e2214cc2148?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=280e687f2bebb7dbc00ceabb1a3d1f40 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Miyama_Mariru/works/62", "thumbnail_src": "https://si.imgix.net/b640fefe/uploads/outputs/ba522cc1-fc2a-4290-8706-1d905d162a34?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f9e898393b34d5cf24bc64c2859430b8", "thumbnail_srcset": "https://si.imgix.net/b640fefe/uploads/outputs/ba522cc1-fc2a-4290-8706-1d905d162a34?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f9e898393b34d5cf24bc64c2859430b8, https://si.imgix.net/b640fefe/uploads/outputs/ba522cc1-fc2a-4290-8706-1d905d162a34?bg=%23fff&fm=webp&