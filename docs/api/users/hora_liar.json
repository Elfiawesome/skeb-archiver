f4-08d6a09d7002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3079c4bc1e0bc4473512986d8bd2436b, https://si.imgix.net/d250a99e/uploads/origins/2e53235f-d763-4b67-a5f4-08d6a09d7002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=889acb5e9b48bed95be917ea55af55a8 2x, https://si.imgix.net/d250a99e/uploads/origins/2e53235f-d763-4b67-a5f4-08d6a09d7002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5348e4df7db6f4e6998bdf808b801da2 3x", "genre": "art", "nsfw": true, "body": "良ければ下記内容が受理可能かご検討よろしくお願いします。\n\n◯概要\n下記URLの座ってパンチラしながら睡眠しているイラストがグッときましたので、同じシチュをウチの子で。\nhttps://si.imgix.net/9e803e14/uploads/origins/49c0e0ec-c6a4-4cd9-ba39-65ef39158fc7?bg=%23fff&auto=format&txtfont=bold&txtshad=70&txtclr=BFFFFFFF&txtalign=middle%2Ccenter&txtsize=150&txt=SAMPLE&fm=webp&w=800&s=e5d52331f13cecbbee20c870230a67f2\n\n◯キャラ\n下記URLのウチの子。\n魔法学校に通うフロラちゃん（10代）\nhttps://x.com/er114_k/status/1746845065715359941?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\nhttps://x.com/er114_k/status/1746843584522051981?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n◯イラスト\n魔法学校《アカデミー》のソファでパンチラしながら睡眠するフロラ。\n可能なら同級生によるぶっかけ差分お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hora_liar/works/30", "thumbnail_src": "https://si.imgix.net/2897265f/uploads/origins/1dccbe71-d8a8-40d5-b202-cec5c1b7f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=968b5ef3fda068692b7ba308ec3400c1", "thumbnail_srcset": "https://si.imgix.net/2897265f/uploads/origins/1dccbe71-d8a8-40d5-b202-cec5c1b7f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=968b5ef3fda068692b7ba308ec3400c1, https://si.imgix.net/2897265f/uploads/origins/1dccbe71-d8a8-40d5-b202-cec5c1b7f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03b7d3e613a92d941f770a3abfa952a0 2x, https://si.imgix.net/2897265f/uploads/origins/1dccbe71-d8a8-40d5-b202-cec5c1b7f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=