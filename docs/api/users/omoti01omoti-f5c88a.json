9-4f7f0ea7943a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e6d4b74c8385b7c5ae213bc4a3cf3d2 3x", "genre": "art", "nsfw": false, "body": "おもち様\nアピールいただきありがとうございます！\nまた、OCお褒めいただき、興味を持っていただいていたとのこと、とても嬉しいです！\nお返事遅くなり申し訳ありませんが、ぜひよろしくお願いいたします。\n\n下記URLに資料を添付いたします。\nどうぞよろしくお願いいたします！\n\nhttps://misskey.io/@ex_ao_akatsuki/pages/1725240743804", "created_at": "", "completed_at": ""}, {"path": "/@omoti01omoti/works/21", "thumbnail_src": "https://si.imgix.net/622e749f/uploads/origins/8638c5a7-0494-422a-9a13-6e6729ad9429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bae5bd4c5134dfef7ff8ff212f3f58f", "thumbnail_srcset": "https://si.imgix.net/622e749f/uploads/origins/8638c5a7-0494-422a-9a13-6e6729ad9429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bae5bd4c5134dfef7ff8ff212f3f58f, https://si.imgix.net/622e749f/uploads/origins/8638c5a7-0494-422a-9a13-6e6729ad9429?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cea667b7914fea0066b37228eb45192 2x, https://si.imgix.net/622e749f/uploads/origins/8638c5a7-0494-422a-9a13-6e6729ad9429?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=117864b18e698481577c94ce09fe5664 3x", "genre": "art", "nsfw": false, "body": "おもち🌷Skeb募集中様\n初めまして！\nVtuberの空瀬じゃがと申します\nこの度はアピールありがとうございました！\nおもち🌷Skeb募集中様のイラストがとても素敵でしたのでリクエストさせていただきます！\n\n【依頼内容】\n・人物\n私自身(空瀬じゃが)\n・服装\n添付したURLの3面図を参考にして下さい\n好きな服を着せていただくことや髪型を変更していただくことも問題ございません\n・構図\nおまかせします\n・使用用途\nサムネ/SNSでの宣伝活動で使用予定\n・その他お願い\n頭や髪の毛、耳、しっぽなどは見切れないように描写して頂けたらと思います。また、可能であれば背景透過したものもいただけますと幸いです。\n\n上記の内容でご検討よろしくお願い致します\n\nhttps://x.com/vt_karasejaga/status/1811986405553266990?s=46&t=nkc2N1gN_eAA_kzx05FwBA", "created_at": "", "completed_at": ""}, {"path": "/@omoti01omoti/works/20", "thumbnail_src": "https://si.imgix.net/3531f616/uploads/origins/b7fb87ea-4450-4981-87d1-3e192f5dea78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4cb8d750c7951d408546d0f960d197", "thumbnail_srcset": "https://si.imgix.net/3531f616/uploads/origins/b7fb87ea-4450-4981-87d1-3e192f5dea78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4cb8d750c7951d408546d0f960d197, https://si.imgix.net/3531f616/uploads/origins/b7fb87ea-4450-4981-87d1-3e192f5dea78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c189adb0c0abb6faa7d23e2c2286279c 2x, https://si.imgix.net/3531f616/uploads/origins/b7fb87ea-4450-4981-87d1-3e192f5dea78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e9f75380800244eccc8e0ba19a4e07a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールをありがとうございます！\n私のキャラクター「ポピー」のアートワークをお願いしたいです。\n彼女は若い女の子で、とても幸せです。\n優しくて親切。ピンクが大好きです！\n好きなポーズで描いてください！\n\nhttps://sta.sh/2x6d2jto9e0?edit=1\n\nありがとうございました！\n\nhttps://sta.sh/2x6d2jto9e0?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@omoti01omoti/works/19", "thumbnail_src": "https://si.imgix.net/aedd8661/uploads/origins/37881d4a-46d7-401a-aa6a-12e912ae0ac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf4986db217ac5102a0558e61637e95", "thumbnail_srcset": "https://si.imgix.net/aedd8661/uploads/origins/37881d4a-46d7-401a-aa6a-12e912ae0ac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf4986db217ac5102a0558e61637e95, https://si.imgix.net/aedd8661/uploads/origins/37881d4a-46d7-401a-aa6a-12e912ae0ac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f8c669b5f89e7c0e24acc73b86be516 2x, https://si.imgix.net/aedd8661/uploads/origins/37881d4a-46d7-401a-aa6a-12e912ae0ac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7ab7b67f55de0b8eba0ff7331b7285e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールをありがとう！\n\n私のOC「フォーレ」を描いていただいてもよろしいでしょうか？彼は「ツイステッドワンダーランド」のためにデザインされました。\n「フォーレ」は頼もしくて、フレンドリーで、ちょっとナイーブなキャラクターです。友だちをからかうことはあるが、決して意地悪ではない。「フォーレ」はクールでチャーミングに見せようとするが、それは彼にとっては自然なことではない。クラシック音楽に興味がある。\n\n好きなように彼を描いてください！あなたのアイデアを見るのが楽しみです。\n\nhttps://imgur.com/a/cpkSCLv", "created_at": "", "completed_at": ""}, {"path": "/@omoti01omoti/works/18", "thumbnail_src": "https://si.imgix.net/4a02b794/uploads/origins/f80ce733-5df9-497b-8a3e-69ec3380952d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2785d69815a394a94176e059601dad05", "thumbnail_srcset": "https://si.imgix.net/4a02b794/uploads/origins/f80ce733-5df9-497b-8a3e-69ec3380952d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2785d69815a394a94176e059601dad05, https://si.imgix.net/4a02b794/uploads/origins/f80ce733-5df9-497b-8a3e-69ec3380952d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cb720e3d37daa8c62ea3cd51857471d 2x, https://si.imgix.net/4a02b794/uploads/origins/f80ce733-5df9-497b-8a3e-69ec3380952d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c59bd2dd6cf749fbf9e6150bec7f2466 3x", "genre": "art", "nsfw": false, "body": "おもち様\n初めまして！アピールありがとうございました！！\nうちの子のことも褒めてくださってとても嬉しく思っております！\n\nぜひおもち様にイラストを描いていただきたくリクエストを送らせて頂きました。\nアピールに記載してくださった子をぜひお願いします！！\n構図やシチュエーションに特にこだわりはありませんので、おもち様に自由に楽しんで描いてもらえたらとても嬉しいです！\n\n描いて頂いたイラストの利用目的は\n・Xでの描いて頂きました報告\n・個人鑑賞\nです。\n\nどうぞよろしくお願いいたします！\n\nhttps://xfolio.jp/portfolio/ats_lily", "created_at": "", "completed_at": ""}, {"path": "/@omoti01omoti/works/17", "thumbnail_src": "https://si.imgix.net/b33116bc/uploads/origins/aa51d195-ebe8-40dc-873e-ae58de76b2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=795f5cb0427d7b312d1369ace1adbae9", "thumbnail_srcset": "https://si.imgix.net/b33116bc/uploads/origins/aa51d195-ebe8-40dc-873e-ae58de76b2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=795f5cb0427d7b312d1369ace1adbae9, https://si.imgix.net/b33116bc/uploads/origins/aa51d195-ebe8-40dc-873e-ae58de76b2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d47141af16004662f