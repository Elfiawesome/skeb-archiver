2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8267959004f5e95e59de747450c03fa", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "Twitterのヘッダー用に「ユメホシ」or「ボカロ広義」のキャラを使ったイラストを描いてほしいです。\nデザインの指定はとくにありません、ちゃちゃちゃさんのセンスに全てを任せました。\nマジで何も思いつかなかったら断ってもらって大丈夫です。", "created_at": "", "completed_at": ""}, {"path": "/@champon_skeb/works/1", "thumbnail_src": "https://si.imgix.net/ec2214cd/uploads/origins/397fd0e5-a066-485f-aa3e-ff4fd701781f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1bde5d72e375f5f5aac00be00630569", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "もしよろしければ、ニ年後if三年セリカのスク水（アビドス）姿をお願いいたします！", "created_at": "", "completed_at": ""}]}