9b25717f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=203a867966971d2de998f1046116db71", "thumbnail_srcset": "https://si.imgix.net/9afedbc1/uploads/origins/09c574f2-0507-402f-98d8-919b25717f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=203a867966971d2de998f1046116db71, https://si.imgix.net/9afedbc1/uploads/origins/09c574f2-0507-402f-98d8-919b25717f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3580ce2f9ff419f5824aea2bce674c5a 2x, https://si.imgix.net/9afedbc1/uploads/origins/09c574f2-0507-402f-98d8-919b25717f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84d4b4c71c0b1db97ab4bc5d605ead49 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品をありがとうございます。\n今回は、紲星あかりちゃんと、結月ゆかりさんでリクエストしたいと思います。\n\n突如始まった、ゆかり服チャレンジ\n全裸のあかりちゃんが、ゆかりさんの服を着ようと、スカートをはくように足から服に入れていき\nそして、おっぱいを服の中に仕舞おうと奮闘する\n\n何とか気合いで押し込み、あかりちゃんがほっとした瞬間、胸の部分が思いきり破れた\n\nこういう感じでお願いします\n細かいところは、お任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/148", "thumbnail_src": "https://si.imgix.net/7ed44515/uploads/origins/e013eca6-a26a-4b71-bfce-196cb1af4b38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c963e6db802412126b3b1c262c3b419d", "thumbnail_srcset": "https://si.imgix.net/7ed44515/uploads/origins/e013eca6-a26a-4b71-bfce-196cb1af4b38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c963e6db802412126b3b1c262c3b419d, https://si.imgix.net/7ed44515/uploads/origins/e013eca6-a26a-4b71-bfce-196cb1af4b38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=565e722ef0722d6cbfb9934cd1c95d3c 2x, https://si.imgix.net/7ed44515/uploads/origins/e013eca6-a26a-4b71-bfce-196cb1af4b38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83c09058e73a32f4ce412a1de5e61b8f 3x", "genre": "art", "nsfw": true, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n一枚でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/147", "thumbnail_src": "https://si.imgix.net/a1afb57d/uploads/origins/047bdc98-9b07-499b-bfc3-2ab9ea3789b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0cf36011647112337d2e9a4f4c76b71", "thumbnail_srcset": "https://si.imgix.net/a1afb57d/uploads/origins/047bdc98-9b07-499b-bfc3-2ab9ea3789b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0cf36011647112337d2e9a4f4c76b71, https://si.imgix.net/a1afb57d/uploads/origins/047bdc98-9b07-499b-bfc3-2ab9ea3789b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=840cd19bead58c6310e5d39a6201a21e 2x, https://si.imgix.net/a1afb57d/uploads/origins/047bdc98-9b07-499b-bfc3-2ab9ea3789b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ec6eff9caa50646f1d3819b46b01bf8 3x", "genre": "art", "nsfw": false, "body": "大好きな茜ちゃんの可愛いお嫁さんをしている\n幸せそうな琴葉葵のイラストをお願いします！\n\n【シチュエーション】\n菓色さんが思い浮かばれる「これが可愛いお嫁さんをしてる葵ちゃんだ！！」っという内容にお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/146", "thumbnail_src": "https://si.imgix.net/47868a7f/uploads/origins/49de793f-ef0d-4f9c-b57d-fcc762611163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b8ffa417676b095e425e81384a442fe", "thumbnail_srcset": "https://si.imgix.net/47868a7f/uploads/origins/49de793f-ef0d-4f9c-b57d-fcc762611163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b8ffa417676b095e425e81384a442fe, https://si.imgix.net/47868a7f/uploads/origins/49de793f-ef0d-4f9c-b57d-fcc762611163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=548d0a498c7e788a5f4d96526745bfe3 2x, https://si.imgix.net/47868a7f/uploads/origins/49de793f-ef0d-4f9c-b57d-fcc762611163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34edd1f2f6f64f032727bde53a6a1b1f 3x", "genre": "comic", "nsfw": true, "body": "先日は、琴葉姉妹の素晴らしい作品をありがとうございます。\n\n今回は、この続きをリクエストしたいと思います。\n琴葉姉妹におもちゃにされる、ゆかりさんという感じでお願いします\n\nニーソだけ残した格好でくつろぐ琴葉姉妹\n「葵ー、ちゃんを水分を補給せんとあかんで。ほんで、その後、続きをしよ」\n「いいけど。お姉ちゃん、本当にスケベやな」\n「たまには、ええやん。今夜は寝かせへんでー」\nと、他愛のない会話をしていると\n\n「こんにちは」\nゆかりさんが部屋に入ってきた\n「おもちゃが来たでー、葵」\n「獲物やで、お姉ちゃん」\n二人は、一瞬でゆかりさんに近づくと、素早くニーソだけ残して服とパンツを脱がした。\n「えっ、えっ？」\n戸惑うゆかりさんを無視して、そのまま部屋の真ん中に寝かすと、ゆかりさんの頭を茜のお腹に乗せ、ゆかりさんの両足をM字で開くと、茜は自分の両足で動かないように固定した。\n\n「今や、葵。ゆかりさんのおま○この写真を撮るんや」\n「任せて」\n茜はゆかりさんのおっぱいを揉みながら乳首を摘まみ\n葵は、ゆかりさんのお○んこを広げて、スマホを構えた\n「葵、うちのスマホでも撮影してな」\n「お姉ちゃん、ゆかりさんのおまん○、ぐっちょぐっちょや。ほら、これ見て」\nそう言うと葵は、ゆかりさんの○まんこに指を三本入れると、そのまま膣壁を指の腹で撫で上げた\n「んっ……。はぁ……」\n抵抗しないどころか、葵の手マンを受け入れるゆかりさん\n\n「ほら、これ。」\nそう言いながら葵は、ゆかりさんのおまん○から指を抜くと、茜とゆかりさんの目の前で指を広げて見せる\nそこには、ゆかりさんの愛液が橋を作っている\n\n「なんやゆかりさん。覗いてたんか。うちらのエッチ」\n「それなら、話が早い」\n茜の言葉に赤くなるゆかりさん。\nすると葵は、部屋の隅から、デカいバイブを取り出した。\nゆかりさんの腕よりも太く、そして膣奥まで差し込んでも尚、長さがあまりそう\nそして、イボがついているので、膣内の全てを気持ちよくしてくれそうだ\n\n「雫ちゃんから、ゆかりさんがこんな感じのバイブでオナニーしてるって聞いたんや」\n「というわけで、これで気持ちよくしてあげるな」\nそう言うと、問答無用でバイブを差し込むと、そのままスイッチを最強にして、ゆかりさんをイカせた。\n\nという感じでお願いします\n細かいところは、お任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/145", "thumbnail_src": "https://si.imgix.net/82e0a7b2/uploads/origins/71231309-86e5-4fca-bb17-5f3285b90d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e507a7b7249fb14028b7cec83e5a8a1e", "thumbnail_srcset": "https://si.imgix.net/82e0a7b2/uploads/origins/71231309-86e5-4fca-bb17-5f3285b90d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e507a7b7249fb14028b7cec83e5a8a1e, https://si.imgix.net/82e0a7b2/uploads/origins/71231309-86e5-4fca-bb17-5f3285b90d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5490eb8fae550badfc40ac480bf6cfe 2x, https://si.imgix.net/82e0a7b2/uploads/origins/71231309-86e5-4fca-bb17-5f3285b90d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f05a21bf36a97a107bee900cca4b7829 3x", "genre": "art", "nsfw": true, "body": "以前はついなちゃんのイラストありがとうございました。\n再びリクエストさせて頂きます。\n\n今回もついなちゃんをお願いいたします。\n\n夏の暑い日に全裸でアイスを食べているイラストです。\nイメージとしては暑いということで、人目も気にせず全裸で過ごしている感じでお願いします。\nポーズ・表情などの詳細はお任せします。\n\n以上、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/144", "thumbnail_src": "https://si.imgix.net/84c069d7/uploads/origins/f4489de6-e026-475b-9ec1-38b804d4f8eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e7881252a504ae77659f3c93f7e4a4e", "thumbnail_srcset": "https://si.imgix.net/84c069d7/uploads/origins/f4489de6-e026-475b-9ec1-38b804d4f8eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e7881252a504ae77659f3c93f7e4a4e, https://si.imgix.net/84c069d7/uploads/origins/f4489de6-e026-475b-9ec1-38b804d4f8eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3103ab36287fcefa04782d20d74aa3f0 2x, https://si.imgix.net/84c069d7/uploads/origins/f4489de6-e026-475b-9ec1-38b804d4f8eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ad75b2ea0032b512ff349ff4facb09 3x", "genre": "art", "nsfw": true, "body": "先日は、素晴らしい作品をありがとうございました。\nhttps://skeb.jp/@kashiki_main/works/142\n\n今回は、こちらのオマケで描かれた双頭バイブのシーンを、カラー化でリクエストしたいと思います。\n細かいところは、お任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/143", "thumbnail_src": "https://si.imgix.net/b433538e/uploads/origins/906ef4a6-7c2b-4ad6-a668-2aefea4c3355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daeab88beeb64c9eae355a0497373665", "thumbnail_srcset": "https://si.imgix.net/b433538e/uploads/origins/906ef4a6-7c2b-4ad6-a668-2aefea4c3355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daeab88beeb64c9eae355a0497373665, https://si.imgix.net/b433538e/uploads/origins/906ef4a6-7c2b-4ad6-a668-2aefea4c3355?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16d964e399ffd625288cff56eb41f646 2x, https://si.imgix.net/b433538e/uploads/origins/906ef4a6-7c2b-4ad6-a668-2aefea4c3355?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7be1f0b0144bdd32a27eba20c808e2c3 3x", "genre": "art", "nsfw": true, "body": "参考URL[1][2]のような人間と動物の入れ替わりシチュを、宮舞モカちゃんと飼い猫のワトソンくんで描いていただきたいです。\n\n外出先で突然入れ替わってしまい、公衆の面前で猫っぽい仕草をしてスカートの中が見えてしまうモカちゃん（中身はワトソンくん）と、それを見て慌てるワトソンくん（中身はモカちゃん）をお願いします。\n\nモカちゃん（中身はワトソンくん）は知能が猫なので、人間の言葉を話せません。\nワトソンくん（中身はモカちゃん）は知能は人間ですが体が猫なので、猫の鳴き声しか出せません。\n\nワトソンくんのビジュアルは参考URL[3]～[7]などを参考にしてください。\n\n参考URL\n[1]　https://www.pixiv.net/artworks/60164937\n[2]　https://www.pixiv.net/artworks/123533679\n[3]　https://x.com/miyamaimoca/status/1900879654686216368\n[4]　https://x.com/miyamaimoca/status/1871526236045922363\n[5]　https://x.com/miyamaimoca/status/1899732093120229631\n[6]　https://x.com/miyamaimoca/status/1898021248279711955\n[7]　https://x.com/miyamaimoca/status/1852627844603728251", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/142", "thumbnail_src": "https://si.imgix.net/fa87cd3d/uploads/origins/c56f0114-e8cd-4f87-9e84-54cd14c3c3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703972ccaa00be2eba1f9ed720615c3b", "thumbnail_srcset": "https://si.imgix.net/fa87cd3d/uploads/origins/c56f0114-e8cd-4f87-9e84-54cd14c3c3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703972ccaa00be2eba1f9ed720615c3b, https://si.imgix.net/fa87cd3d/uploads/origins/c56f0114-e8cd-4f87-9e84-54cd14c3c3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03b6a31d7e14e71dd3fa7a61182b88ea 2x, https://si.imgix.net/fa87cd3d/uploads/origins/c56f0114-e8cd-4f87-9e84-54cd14c3c3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24c79e21be07560c97ee0cc3794936f1 3x", "genre": "comic", "nsfw": true, "body": "いつも素晴らしい作品をありがとうございます。\n今回は、琴葉姉妹でリクエストしたいと思います。\n\nシチュエーションは、琴葉 茜ちゃんが、葵ちゃんに電気アンマをしているところをお願いします\n\n部屋で茜ちゃんが、葵ちゃんの両足を掴んで電気アンマをしながら\n「どうや、葵。参ったか。どうや。」\n「あっはははは。止めて、お姉ちゃん」\nしかし、電気アンマを止めない\n「ここか、ここがええのんか！」\nエスカレートする茜\n茜の足が、葵の股間の気持ち良いところに当たるため、次第に声を我慢する葵\n\nそのまま、続けていくと、突然、痙攣する葵\n「ど、どうしたんや？」\n心配そうに覗き込む茜\n息を荒げる葵\n\nそこで、足の裏が濡れ始めた事に気づいた茜は、足を股間から離すと、葵の粘っこい愛液がついており、股間から足の裏にかけて、葵の愛液が橋を作っていた\n\nこういう感じでお願いします\n細かいところは、お任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/141", "thumbnail_src": "https://si.imgix.net/77f53b0e/uploads/origins/12e6ac5a-43fe-4287-bd90-c205e57c9ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d76dfa6ac491bd4bdca0c741dd53e670", "thumbnail_srcset": "https://si.imgix.net/77f53b0e/uploads/origins/12e6ac5a-43fe-4287-bd90-c205e57c9ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d76dfa6ac491bd4bdca0c741dd53e670, https://si.imgix.net/77f53b0e/uploads/origins/12e6ac5a-43fe-4287-bd90-c205e57c9ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b3d3018918a66ff714406fa65b1cc32 2x, https://si.imgix.net/77f53b0e/uploads/origins/12e6ac5a-43fe-4287-bd90-c205e57c9ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3db0ebd7d43681323f61805be1b3aa9c 3x", "genre": "art", "nsfw": true, "body": "リクエストになります！\nしゃがみパンチラしている蕾の琴葉姉妹をお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/140", "thumbnail_src": "https://si.imgix.net/fa3b176f/uploads/origins/7961f753-d576-4e1f-b3f4-99c06c40f5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a00e5dc7b00398558589ad0a039f950d", "thumbnail_srcset": "https://si.imgix.net/fa3b176f/uploads/origins/7961f753-d576-4e1f-b3f4-99c06c40f5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a00e5dc7b00398558589ad0a039f950d, https://si.imgix.net/fa3b176f/uploads/origins/7961f753-d576-4e1f-b3f4-99c06c40f5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f7b2026e07d0dc5f1e7063bb3df5e32 2x, https://si.imgix.net/fa3b176f/uploads/origins/7961f753-d576-4e1f-b3f4-99c06c40f5c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed55b80bffbb137a846122bd97ebc63a 3x", "genre": "art", "nsfw": false, "body": "以前は素敵な絵をありがとうございました｡\n今回もサムネなどに使う絵をお願いしたくて依頼を出しました\n【概要】超変身するあかりちゃん\n【キャラクター】紲星あかり\n【シチュエーション】仮面ライダークウガ2話「変身」での教会での変身をイメージした感じでお願いします\n(資料URL1:50のシーン)サムネ用に少し右側に寄せるので､バストアップな感じにアレンジしてもらえると助かります\n【他】サムネに使う予定なので1920×1080アス比でお願いします｡\nよろしくお願いします\n\nhttps://youtu.be/Dlef7YtGc-I?si=X3IN2ZPJoxrHnrQR", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/139", "thumbnail_src": "https://si.imgix.net/3ea15633/uploads/origins/cb0e0ac3-151e-4cbd-ac69-c31d6f779122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e89d7115cd57dac599e977a776eae6ce", "thumbnail_srcset": "https://si.imgix.net/3ea15633/uploads/origins/cb0e0ac3-151e-4cbd-ac69-c31d6f779122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e89d7115cd57dac599e977a776eae6ce, https://si.imgix.net/3ea15633/uploads/origins/cb0e0ac3-151e-4cbd-ac69-c31d6f779122?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=233c0e0642a8cfb31f3a3cc8c8c6ba85 2x, https://si.imgix.net/3ea15633/uploads/origins/cb0e0ac3-151e-4cbd-ac69-c31d6f779122?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebd1ed3722143d8cf6662c0e9792eecd 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\n早速ですが、私の好きなキャラの一人である模型娘のもち子さんのちょっぴりセクシーな下着姿をリクエストいたします。\n\n●もち子さん\n公式紹介：https://vtubermochio.wixsite.com/mochizora/%E3%82%82%E3%81%A1%E5%AD%90%E3%81%95%E3%82%93%E3%81%A8%E3%81%AF-%E8%A8%AD%E5%AE%9A%E8%B3%87%E6%96%99\n低身長(142cm)・巨乳～爆乳・引き締まったおなか・安産型の大きめのお尻とふともも\n●下着\n布地が大きめでセクシーな雰囲気のブラジャー(デカブラ)・お揃いのデザインで布地は逆に狭めなショーツ\n他装飾(ガーターベルト・ストッキング等)の有無はお任せいたします\n●場所・シチュ\nもち子さん以外の第三者がいない場所・シチュ\n●他\n下着の色や装飾、ポーズ、表情などの指定していない項目はお任せします\n●ｺｯｼｮﾘ\n・成年向け二次創作はｺｯｼｮﾘすれば可とのことです(https://vtubermochio.wixsite.com/mochizora/%E5%88%A9%E7%94%A8%E8%A6%8F%E7%B4%84)\n・NSFW用タグは「もちｺｯｼｮﾘ」です(https://twitter.com/V_Mochiko/status/1691753735742271750)\n\nよろしくお願いいたします。\n\nhttps://vtubermochio.wixsite.com/mochizora/%E3%82%82%E3%81%A1%E5%AD%90%E3%81%95%E3%82%93%E3%81%A8%E3%81%AF-%E8%A8%AD%E5%AE%9A%E8%B3%87%E6%96%99", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/138", "thumbnail_src": "https://si.imgix.net/06ee08cf/uploads/origins/055456a8-cf79-4657-8a22-6c0286338350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8c4eb87f201b6efe162128b9ebf4b3", "thumbnail_srcset": "https://si.imgix.net/06ee08cf/uploads/origins/055456a8-cf79-4657-8a22-6c0286338350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8c4eb87f201b6efe162128b9ebf4b3, https://si.imgix.net/06ee08cf/uploads/origins/055456a8-cf79-4657-8a22-6c0286338350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3779bd8f2d293b8e2b9807d75b67ba0a 2x, https://si.imgix.net/06ee08cf/uploads/origins/055456a8-cf79-4657-8a22-6c0286338350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=141d850c7782931dcd2fce05fb18cdb0 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。手数料無料キャンペーンが来るのを待つつもりでいたらちょうど来たので依頼させていただきます。\nワンダーランドウォーズが2025年2月19日をもちまして稼働開始から10周年となりアーケードゲームとしては数少ない長寿タイトルとなりました。\n今回は10周年記念イラストを描いていただきたく参りました、10周年記念という事でそれなりの金額を提示しますが趣味絵を描く時間やコスパを加味してご検討していただければと思ってます。\n\n作品名:ワンダーランドウォーズ\n\nキャラクター:キャラと人数は完全におまかせします(描きたいキャラクターを好きなように描いていただければ大丈夫です)\n\n服装:水着・トップレス・ヌード\n\nシチュエーション:皆でプールもしくはビーチに遊びに来ている\n\n構図:全ておまかせします\n\nアスペクト比:ディスクトップ画面に使いたいので可能であれば16:9でお願いします。\n\n使用用途:Skebの印刷してお届け機能、PCディスクトップ画面\n\nキャラの参考資料はお手数ですが公式サイトや動画などを参考にしてください。\n色々希望してますが無理なく描いていただければと思っています。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/137", "thumbnail_src": "https://si.imgix.net/31951f5b/uploads/origins/8bfe4feb-e691-4b52-815b-d5c85d07fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e5ab386286516b86b46d14d766548f", "thumbnail_srcset": "https://si.imgix.net/31951f5b/uploads/origins/8bfe4feb-e691-4b52-815b-d5c85d07fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e5ab386286516b86b46d14d766548f, https://si.imgix.net/31951f5b/uploads/origins/8bfe4feb-e691-4b52-815b-d5c85d07fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f47292eba13940b3fc62906765e35ec 2x, https://si.imgix.net/31951f5b/uploads/origins/8bfe4feb-e691-4b52-815b-d5c85d07fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cd02a30e868ef5fc22cc0230bf22dd8 3x", "genre": "art", "nsfw": true, "body": "遅くなりましたがアピールをありがとうございます。\n\nかなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします。\n\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\n\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じてください。\n全身巻き付かれている事を強調する為、時津風の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n時津風の表情ですが、大丈夫でしたら以下の通り（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/136", "thumbnail_src": "https://si.imgix.net/e83993b0/uploads/origins/e906f35b-f7d9-41e1-8f0f-1561bcb226d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1373feeaccbd146c0fd1f15898ecad6c", "thumbnail_srcset": "https://si.imgix.net/e83993b0/uploads/origins/e906f35b-f7d9-41e1-8f0f-1561bcb226d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1373feeaccbd146c0fd1f15898ecad6c, https://si.imgix.net/e83993b0/uploads/origins/e906f35b-f7d9-41e1-8f0f-1561bcb226d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e1058fef7a6433bac49b0c02fcc6c4b 2x, https://si.imgix.net/e83993b0/uploads/origins/e906f35b-f7d9-41e1-8f0f-1561bcb226d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a768efdd5d9612dc9fe5ce4bbc9fb06 3x", "genre": "art", "nsfw": true, "body": "以前はついなちゃんのイラストありがとうございました。\n再びリクエストさせて頂きます。\n\n今回もついなちゃんをお願いいたします。\n\n雨が降る中、全裸にレインコートを着ていて、傘をさしているイラストです。\nレインコートは半透明で、フードが付いていないものをお願いします。\nポーズ・表情などの詳細はお任せします。\n\n以上、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@kashiki_main/works/135", "thumbnail_src": "https://si.imgix.net/1bebb5b7/uploads/origins/738bb28b-a44d-4d7f-b29c-e4b778622c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30aeee39f4b41a04129d8739dbb06f14", "thumbnail_srcset": "https://si.imgix.net/1bebb5b7/uploads/origins/738bb28b-a44d-4d7f-b29c-e4b778622c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30aeee39f4b41a04129d8739dbb06f14, https://si.imgix.net/1bebb5b7/uploads/origins/738bb28b-a44d-4d7f-b29c-e4b778622c43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81ac61546617cc5fb3a0b399edbf29ad 2x, https://si.imgix.net/1bebb5b7/uploads/origins/738bb28b-a44d-4d7f-b29c-e4b778622c43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9d6880cff48a01bfdb1b1692dde2345 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ka