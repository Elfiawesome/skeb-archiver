0&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38995697dffacb54919e9514d16c3307, https://si.imgix.net/31d025c4/uploads/origins/b3f8c892-41f3-4fc7-8a7d-a61db663b718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=333bd6a1c9842dc539e3b8a45ccd5f03 2x, https://si.imgix.net/31d025c4/uploads/origins/b3f8c892-41f3-4fc7-8a7d-a61db663b718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=032ae9a86dff50154d69ed2736255de7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/39", "thumbnail_src": "https://si.imgix.net/a51572ed/uploads/origins/70220ecc-bd0d-4984-ac57-41c94cd1b138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0cdee385cfcb9ea0fcd6d70324cdfe", "thumbnail_srcset": "https://si.imgix.net/a51572ed/uploads/origins/70220ecc-bd0d-4984-ac57-41c94cd1b138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0cdee385cfcb9ea0fcd6d70324cdfe, https://si.imgix.net/a51572ed/uploads/origins/70220ecc-bd0d-4984-ac57-41c94cd1b138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05f01b62e9133a834ad2e5e686bb08ba 2x, https://si.imgix.net/a51572ed/uploads/origins/70220ecc-bd0d-4984-ac57-41c94cd1b138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b7528dc1561fa2b20d82a292a9113cb 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの作品の大ファンで、特に筋肉と目の描き方が好きです。あなたの作品を見て、私も同じようなものを手に入れたいと思いました。\n\n私のVtuberの北上シローを描いていただけませんか？シロウは遊び好きでいじわるなスノーフォックスで、服の下は筋肉質です。両手を縛られ、ベッドに寝そべるシロウを描けたらと思っています。両手を縛られ、ベッドに寝かされたシロウの顔は、戯れるようなエロティックな表情を浮かべ、両足は上げて見せる。尻尾は彼の膨らみが見えるところを隠す予定だ。最終的なポーズや表情はアーティストの表現次第。\n\nこの作品はSNSへの投稿や、ストリームでの使用も考えています。お読みいただきありがとうございました。\n\nhttps://drive.google.com/file/d/19eOh4uAtHPeaTmvo37c29r48ejVf-jXB/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/38", "thumbnail_src": "https://si.imgix.net/0a6f350e/uploads/origins/af3a1636-a21b-4bcd-9837-b0667dd2d4d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fe7b3310470bfce5d1108fb8280f651", "thumbnail_srcset": "https://si.imgix.net/0a6f350e/uploads/origins/af3a1636-a21b-4bcd-9837-b0667dd2d4d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fe7b3310470bfce5d1108fb8280f651, https://si.imgix.net/0a6f350e/uploads/origins/af3a1636-a21b-4bcd-9837-b0667dd2d4d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6887ffbd355fbfd7496bcf6e8d1bb76a 2x, https://si.imgix.net/0a6f350e/uploads/origins/af3a1636-a21b-4bcd-9837-b0667dd2d4d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a428636079102ea52eb3b87563c5b7b2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/37", "thumbnail_src": "https://si.imgix.net/b5576cae/uploads/origins/992b09b7-b3eb-43e3-9ff2-0adf58e1cea5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c10d749c79a07d488fda3d2024f6bf06", "thumbnail_srcset": "https://si.imgix.net/b5576cae/uploads/origins/992b09b7-b3eb-43e3-9ff2-0adf58e1cea5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c10d749c79a07d488fda3d2024f6bf06, https://si.imgix.net/b5576cae/uploads/origins/992b09b7-b3eb-43e3-9ff2-0adf58e1cea5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ab416685496d5ed066bdf5d77ac9171 2x, https://si.imgix.net/b5576cae/uploads/origins/992b09b7-b3eb-43e3-9ff2-0adf58e1cea5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aff8de17104a7ecea5d86434d20bbd63 3x", "genre": "art", "nsfw": true, "body": "向島ワタル様初めまして！\n貴方の描かれる男性の肉体や肌の塗りが好きです！\nocを描いていただきたく失礼します。\n\n【世界観】\n https://k-n-gon.booth.pm/items/5835751\nぱっと見では人間と変わらないような見た目のサイボーグ\nオイルも赤く血を模している\n戦闘用サイボーグはメカメカしさが強くても大丈夫です\n\n\n【キャラクター】\n資料の男性-黒鉄鋼太\n堅物ド真面目\n強化サイボーグを使っている戦闘員\n脚の作りはかなりメカメカしいですがもっと人間によっている状態でも大丈夫です(何タイプがパーツを持っていると思います)\n髪や顔パーツ以外に体毛はありません\nその他は人間の作りとほぼ同じです\n筋肉があります\n見ため年齢は25〜30です\n無口ですが感情が表情に出やすいです\n資料上着の下はハイネックノースリーブです\n\n自分の意思で撮影モードに目を変えることができる差分がありますが今回反映するかしないかはお任せします\n戦闘中に使うことはほぼないです\n\n【依頼内容】\n戦いの最中四肢や腹部など(どこでも可)が負傷、欠損して敵に見つからない位置で修復している様子をお願いしたいです！\n酷い怪我で興奮状態に近かったり服が破れて(or溶けて)いたりサイボーグらしい内部が見えていたり...ガッツリ見る側がえっちなものを感じれると嬉しいです！\n本人は必死、一生懸命だと思います\n他、構図等はお任せします！\n\n【使用用途】 SNS等のアイコン/ヘッダー、グッズ作成(非商用)、鑑賞 \n\npsdデータでレイヤー分けしていただけると嬉しいです\n\nご検討よろしくお願い致します！\n\nhttps://drive.google.com/drive/mobile/folders/1tuMovep3w9aixM6ThRTtJOj8fYLnMwRH?pli=1&sort=13&direction=a", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/36", "thumbnail_src": "https://si.imgix.net/0edaf23d/uploads/origins/ba5e3eb3-5a64-4e30-b94f-4aa3452cf9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9d9f333ab47d5eed053088ba861603d", "thumbnail_srcset": "https://si.imgix.net/0edaf23d/uploads/origins/ba5e3eb3-5a64-4e30-b94f-4aa3452cf9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9d9f333ab47d5eed053088ba861603d, https://si.imgix.net/0edaf23d/uploads/origins/ba5e3eb3-5a64-4e30-b94f-4aa3452cf9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d70d97856d105816360ecea6170363f6 2x, https://si.imgix.net/0edaf23d/uploads/origins/ba5e3eb3-5a64-4e30-b94f-4aa3452cf9e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=501c6a8e80c97240a1e8a1974c5f3036 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/35", "thumbnail_src": "https://si.imgix.net/3682a22f/uploads/origins/3a2fb547-26a2-425a-9ef6-7c798b95ac72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e72a39d414bb5cd295b2308cf377b1", "thumbnail_srcset": "https://si.imgix.net/3682a22f/uploads/origins/3a2fb547-26a2-425a-9ef6-7c798b95ac72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e72a39d414bb5cd295b2308cf377b1, https://si.imgix.net/3682a22f/uploads/origins/3a2fb547-26a2-425a-9ef6-7c798b95ac72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8921db2f64a066c1731e0a71e7c7f56f 2x, https://si.imgix.net/3682a22f/uploads/origins/3a2fb547-26a2-425a-9ef6-7c798b95ac72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1511549dba94ac6c9f46ee0414c2f6db 3x", "genre": "art", "nsfw": true, "body": "こんにちは、向島さん！\n\n以前描いていただいた僕のキャラクターの素晴らしいイラスト、本当にありがとうございました！今回は、僕のOCだけでなく、友人のOC（リイク）も一緒に描いていただきたく、リクエストさせていただきます！\n\nネコ「Neko」はプロレスラーで、特に強敵を倒して支配し、様々な関節技で相手を降参させることに非常に興奮します。彼は自信に満ちたレスラーで、新たな強敵と戦い、リング上で自分の優位性を確立することを楽しんでいます。彼にとって最大の喜びは、相手が「ギブアップ！」と叫ぶ瞬間です。\n\n彼の胸筋と強い腕は非常に発達しており、筋肉質な体格は、浮き出る血管でさらに強調されています。猫の特徴（微笑むと見える小さな牙）を持っていますが、瞳は人間のようです。彼の際立った特徴は、光を美しく反射し、暗闇で輝く青い目と、特にウエストにあるV字のアポロベルト（下腹部のライン）です。\n\n衣装については、「Neko」＞「Attire」というフォルダを参考にしてください （サングラスは省略してください）。他のフォルダにも補足情報が含まれています。できる限り彼の筋肉質でアスレチックな体格と鋭い青い目がよく見える構図にしていただけると嬉しいです。\n\nリイク「Riiku」についてですが、彼はまだプロレスラーとしての経験が浅いものの、ネコとの試合やスパーリング、トレーニングを通じて、最近大きく自信をつけてきました！ そのため、まだフレッシュな雰囲気を持ちながらも、意志が強く自信に満ちており、実は心優しい巨漢でありながらも迫力のある存在感を放っています！彼の体格は筋肉質で、特に大きな胸筋と太くたくましい太ももが特徴です。また、瞳の虹彩は黒色です\n\nなお、リイクはネコよりも少し背が高く、体格もやや大きめですが、ネコの方がより引き締まっていて筋肉のカットが際立っています。（比較フォルダの画像をご参照ください）\n\n今回のシナリオですが、ネコはプロレスラーであり、今回はタッグチームパートナーであるリイクと共に試合に勝利した直後のシーンをお願いしたいです！ 二人には長い因縁があり、かつては激しいライバル同士でした。しかし、長い闘争を経て互いの実力を認め合い、タッグチームトーナメントに出場することに。 そして数々の過酷な試合を勝ち抜き、ついに決勝戦を制し、今や堂々たるタッグチームとして優勝を果たした、という場面を描いていただきたいです！\n\nポーズや表情はおまかせしますが、二人の力強い筋肉質な肉体が汗と打撲痕に覆われ、試合の激しさが伝わるようにしていただけると嬉しいです。\n\n今回もリクエストを検討していただき、ありがとうございます！^^\n\nhttps://www.dropbox.com/scl/fo/21fbeiud43qqmtze7iyh6/AMhwp3wWzE3p-4or64sEglg?rlkey=yfvyk659updfn9zoanrohv797&st=a7452irq&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/34", "thumbnail_src": "https://si.imgix.net/5c7b2434/uploads/origins/3100cfc5-b8f2-43ed-bbcc-b0c36721146c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aefd9c1d35fe6ccfed2e96551144baeb", "thumbnail_srcset": "https://si.imgix.net/5c7b2434/uploads/origins/3100cfc5-b8f2-43ed-bbcc-b0c36721146c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aefd9c1d35fe6ccfed2e96551144baeb, https://si.imgix.net/5c7b2434/uploads/origins/3100cfc5-b8f2-43ed-bbcc-b0c36721146c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9012a674bf6efdbc1f6ae6583c3a554 2x, https://si.imgix.net/5c7b2434/uploads/origins/3100cfc5-b8f2-43ed-bbcc-b0c36721146c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=330c82457d2873e7c3f9e0afb17cd0c5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/33", "thumbnail_src": "https://si.imgix.net/8b41db54/uploads/origins/cd4a8094-0dfb-444e-9a80-2cb0c1038639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2374e12dd3859cc632e891af0c4fa3c9", "thumbnail_srcset": "https://si.imgix.net/8b41db54/uploads/origins/cd4a8094-0dfb-444e-9a80-2cb0c1038639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2374e12dd3859cc632e891af0c4fa3c9, https://si.imgix.net/8b41db54/uploads/origins/cd4a8094-0dfb-444e-9a80-2cb0c1038639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=020aad29c67586121edfa8a310c40ded 2x, https://si.imgix.net/8b41db54/uploads/origins/cd4a8094-0dfb-444e-9a80-2cb0c1038639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3108e8b89e17113c8c2ac9ce8631c06d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kkpa1726/works/32", "thumbnail_src": "https://si.imgix.net/bc77e0cb/uploads/origins/1a788de3-0cda-44ea-96c4-177d8d8b433e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f4de9afdd27d6d1fa6b8c0177f4cebd", "thumbnail_srcset": "https://si.imgix.net/bc77e0cb/uploads/origins/1a788de3-0cda-44ea-96c4-177d8d8b433e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f4de9afdd27d6d1fa6b8c0177f4cebd, https://si.imgix.net/bc77e0cb/uploads/origins/1a788de3-0cda-44ea-96c4-177d8d8b433e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3500a065375a425db06009a966000b3 2x, https://si.imgix.net/bc77e0cb/uploads/origins/1a788de3-0cda-