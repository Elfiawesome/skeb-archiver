b296-759dfef1e49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6341ee433fd1d4874fd61e43c81697d4", "thumbnail_srcset": "https://si.imgix.net/526e6384/uploads/origins/78f8383b-70e4-46c9-b296-759dfef1e49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6341ee433fd1d4874fd61e43c81697d4, https://si.imgix.net/526e6384/uploads/origins/78f8383b-70e4-46c9-b296-759dfef1e49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e2607c095a3ad102796a785d40d9d3d 2x, https://si.imgix.net/526e6384/uploads/origins/78f8383b-70e4-46c9-b296-759dfef1e49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=088118f596b4a88bc1b8aa2df31695b6 3x", "genre": "art", "nsfw": false, "body": "はじめまして。いつも素敵なイラストを拝見させていただいております。\n可能であればウマ娘 プリティーダービーのサトノダイヤモンドの勝負服イラストをご依頼したく存じます。\n\n構図などはお任せできればと思います。\n\n大変恐縮ではございますが、ご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kazu_166/works/17", "thumbnail_src": "https://si.imgix.net/38fae35f/uploads/origins/3ccc961c-385e-4da1-a8f2-55beec95a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12993a111c7c8bc6a8723bc64d6ad01", "thumbnail_srcset": "https://si.imgix.net/38fae35f/uploads/origins/3ccc961c-385e-4da1-a8f2-55beec95a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12993a111c7c8bc6a8723bc64d6ad01, https://si.imgix.net/38fae35f/uploads/origins/3ccc961c-385e-4da1-a8f2-55beec95a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c76d77d9e63d833f36da43cea8da116 2x, https://si.imgix.net/38fae35f/uploads/origins/3ccc961c-385e-4da1-a8f2-55beec95a7ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce0e1666e7569fc7fff6a0e9bda50e4c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Kazu先生！前回の作品がとても気に入ったので、また作品をお願いしたいです！(✯ᴗ✯)\n今回は私のキャラクター2人の作品をお願いしたいです：レイとイヴです。レイは前回もお願いしたキャラクターです。\n\n- レイ\n物静かで、時々近寄りがたい雰囲気を漂わせる。少し憂鬱そうに見えるけど、心の中は優しくて柔らかい。争いごとはなるべく避けたい。\n\n- イヴ\n他人からは威圧的に見える。無口で礼儀正しいが、ほとんど笑わない。アイシャドウが特徴。少しサディスティックで、争いを好む。\n\nレイアウトや姿勢はあなたが決めていい。しかし、私は2人がある程度の距離感を持っている方がいいと思う。\n可能であれば、ガラスの破片のエフェクトや、周りに花を添えていただけるとうれしいです！\nありがとうございました！\n\nキャラクターリファレンス\nhttps://drive.google.com/drive/folders/1wvOpTtvmggsrbCb4AZdlquB83PrWfOLr\n\nhttps://drive.google.com/drive/folders/1mhZz4wpQLXxKMKvn53vI-2HzJgp8jMy-", "created_at": "", "completed_at": ""}, {"path": "/@kazu_166/works/16", "thumbnail_src": "https://si.imgix.net/533fc0ca/uploads/origins/6ab5bdae-f247-406b-9a47-c7b1d797136f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87447f67a0c38c00c4d65eec35a1353", "thumbnail_srcset": "https://si.imgix.net/533fc0ca/uploads/origins/6ab5bdae-f247-406b-9a47-c7b1d797136f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87447f67a0c38c00c4d65eec35a1353, https://si.imgix.net/533fc0ca/uploads/origins/6ab5bdae-f247-406b-9a47-c7b1d797136f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30364ae7b651f8426732c8276be7bc77 2x, https://si.imgix.net/533fc0ca/uploads/origins/6ab5bdae-f247-406b-9a47-c7b1d797136f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c784991c5f6f5b8c55b99b01d4921b0 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n世界はもっと鍵山雛を必要としている\n東方projectのキャラクター、鍵山雛を描いてくれませんか？\n他の要望は特にありません。お好きなデザインでお願いします。\nお引き受けいただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kazu_166/works/15", "thumbnail_src": "https://si.imgix.net/5849d553/uploads/origins/ea958906-178b-470b-b99d-a336c73fd89d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=712bb0f8bb445e79465727e75e1f3e7c", "thumbnail_srcset": "https://si.imgix.net/5849d553/uploads/origins/ea958906-178b-470b-b99d-a336c73fd89d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtcl