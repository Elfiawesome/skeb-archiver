ない飼い主』といった関係性に近しい一面も。\n\n▼リクエストについて\nXにてお見かけしましたデフォルメイラストがとってもすっっごく可愛かったため、是非デフォルメにてお願いしたいです。構図などお好きなように描いてくださいませ。\n\nなお、いただいた作品は個人観賞を主な利用目的としております。\n\n以上、ご検討いただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-dA_95ucafxOqAcpMwYjzbSr28NDOM0m", "created_at": "", "completed_at": ""}, {"path": "/@tsug2g/works/3", "thumbnail_src": "https://si.imgix.net/f42af419/uploads/origins/7bd4e6ea-a9f4-48d3-a8cb-fc9a467ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5782b4683115a85994e6988c6683be2c", "thumbnail_srcset": "https://si.imgix.net/f42af419/uploads/origins/7bd4e6ea-a9f4-48d3-a8cb-fc9a467ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5782b4683115a85994e6988c6683be2c, https://si.imgix.net/f42af419/uploads/origins/7bd4e6ea-a9f4-48d3-a8cb-fc9a467ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c8c3afd3b3e2282d8f7c65318f232e2 2x, https://si.imgix.net/f42af419/uploads/origins/7bd4e6ea-a9f4-48d3-a8cb-fc9a467ea2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a71c5405da70af3a24e181b9ded77a4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tsug2g/works/2", "thumbnail_src": "https://si.imgix.net/08c0f2b2/uploads/origins/190f098f-d779-4ca4-a1d4-4834e886e92d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04682fe363900f0789be174095f8a03d", "thumbnail_srcset": "https://si.imgix.net/08c0f2b2/uploads/origi