270a45-8a3d-49e4-b11f-6bc3d43b96de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2dc2632540ee6aeafcc6779fafbf038", "thumbnail_srcset": "https://si.imgix.net/73b9cb38/uploads/origins/68270a45-8a3d-49e4-b11f-6bc3d43b96de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2dc2632540ee6aeafcc6779fafbf038, https://si.imgix.net/73b9cb38/uploads/origins/68270a45-8a3d-49e4-b11f-6bc3d43b96de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cb71ba87fe6fa12e90f55262b72d2ff 2x, https://si.imgix.net/73b9cb38/uploads/origins/68270a45-8a3d-49e4-b11f-6bc3d43b96de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f73e8ce0f56d7c1988bb3ed57c826e1b 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n\nかそさんの代理くんが巨大化（100mぐらい）して欲望と破壊欲のままに怪獣のように暴れまわるイラストをもしよろしければ描いていただけませんでしょうか…！", "created_at": "", "completed_at": ""}, {"path": "/@cursor_nemui/works/3", "thumbnail_src": "https://si.imgix.net/1b9e23b1/uploads/origins/4eebb152-1bbd-4b3a-9146-0e0bbd1cb48c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a91071ed00eeb0a6917d27a6970671", "thumbnail_srcset": "https://si.imgix.net/1b9e23b1/uploads/origins/4eebb152-1bbd-4b3a-9146-0e0bbd1cb48c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a91071ed00eeb0a6917d27a6970671, https://si.imgix.net/1b9e23b1/uploads/origins/4eebb152-1bbd-4b3a-9146-0e0bbd1cb48c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0e38c85207ba16a7899d737f3bffdb4 2x, https://si.imgix.net/1b9e23b1/uploads/origins/4eebb152-1bbd-4b3a-9146-0e0bbd1cb48c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ea6f325698b61c0f9c55b291d5c75be 3x", "genre": "art", "nsfw": true, "body": "以前お題箱で蹂躙ノートちゃんや他にいくつかの絵を描いてもらってとても嬉しかったです！\n今回やっとかそさんに納税できるので嬉々と依頼させていただきます。\n\n今回依頼させていただくのはやっぱり激推しのノートちゃんなんですが、アイリスちゃんとの百合えっちを描いていただければと思います。\nノートちゃんの実験（）に巻き込まれて一緒に巨大化したアイリスちゃんがいつもの仕返しにノートちゃんを攻めるようなシチュエーションになります。\nノートちゃんは抵抗の意思こそあるが満更でもない感じだと嬉しいです。\n\nサイズは怪獣サイズのメガ程度で、街を壊しながら電車やバスをおもちゃ代わりに使ったりとしています。\n\n破壊された街並みや2人に巻き込まれて蹴散らされた車とかも書き込んでくれると最高です。\n背景の書き込みは大変だと思いますので、練習がてら時間はたくさんかけていただければと思います。\n宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@cursor_nemui/works/2", "thumbnail_src": "https://si.imgix.net/041f1b5d/uploads/origins/cb865c4b-b548-429c-a828-db7ae82a3d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e249afd098162f2534baa08c951706", "thumbnail_srcset": "https://si.imgix.net/041f1b5d/uploads/origins/cb865c4b-b548-429c-a828-db7ae82a3d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e249afd098162f2534baa08c951706, https://si.imgix.net/041f1b5d/uploads/origins/cb865c4b-b548-429c-a828-db7ae82a3d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c83663833c40d8b45016a5ada254f908 2x, https://si.imgix.net/041f1b5d/uploads/origins/cb865c4b-b548-429c-a828-db7ae82a3d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2383d01695cced6cff5320366f9cfcc8 3x", "genre": "art", "nsfw": true, "body": "シチュ：アイリスちゃんと彼氏くんがイチャラブセックスして都市を蹂躙しちゃうのをお願いします！\nサイズ：ギガサイズぐらい\n体位：特に指定なし\n構図：おまかせ（吹き出しのような形のコマで2人の愛液と精液で建物や乗り物とかがグチャグチャになってる感じの描写があると嬉しいです）", "created_at": "", "completed_at": ""}, {"path": "/@cursor_nemui/works/1", "thumbnail_src": "https://si.imgix.net/f5032bf5/uploads/origins/950a4f13-5e7b-4b2b-8dec-72316478a9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49472ecb27be9ee5fb0b5085549e2ca8", "thumbnail_srcset": "https://si.imgix.net/f5032bf5/uploads/origins/950a4f13-5e7b-4b2b-8dec-72316478a9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49472ecb27be9ee5fb0b5085549e2ca8, https://si.imgix.net/f5032bf5/uploads/origins/950a4f13-5e7b-4b2b-8dec-72316478a9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=833ebbf8253136d813dae6cf28b7d833 2x, h