-43cd-880e-97da01accb9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077900c5ea8b5d79bca7bc62b25ff8ac", "thumbnail_srcset": "https://si.imgix.net/73fb5626/uploads/origins/ac4c0bda-6178-43cd-880e-97da01accb9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077900c5ea8b5d79bca7bc62b25ff8ac, https://si.imgix.net/73fb5626/uploads/origins/ac4c0bda-6178-43cd-880e-97da01accb9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6a36b0f119f113e755b5b6b7d8cad0f 2x, https://si.imgix.net/73fb5626/uploads/origins/ac4c0bda-6178-43cd-880e-97da01accb9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e553b7ca16f8a87e58e824dbbfe8705f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵が大好きです。\n\n以下の6人の冒険者グループです。ポーズはあなた次第です！\n\nエイリン - エレメンタリスト\nオフィーリア - ブレードマスター\nケトゥス：ヴァンガード\nジェスカ モンク\nHeinkel - アサシン\nReonel - インクメイジ\n\nhttps://sta.sh/2255g1z2f1yh", "created_at": "", "completed_at": ""}, {"path": "/@sesuji07/works/94", "thumbnail_src": "https://si.imgix.net/31472653/uploads/origins/792bec4a-f69a-4b5e-a35c-85fa663a3c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=378a1a5c5f41f4123a1308f774a8d87e", "thumbnail_srcset": "https://si.imgix.net/31472653/uploads/origins/792bec4a-f69a-4b5e-a35c-85fa663a3c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=378a1a5c5f41f4123a1308f774a8d87e, https://si.imgix.net/31472653/uploads/origins/792bec4a-f69a-4b5e-a35c-85fa663a3c40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=327e8c01fbe503b024a86110d81d53cf 2x, https://si.imgix.net/31472653/uploads/origins/792bec4a-f69a-4b5e-a35c-85fa663a3c40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9510815db540e213e088b7fd1b21734 3x", "genre": "art", "nsfw": false, "body": "こんにちは！最近、あなたの作品に出会いました！Rufen pixel ref \"というタイトルのフォルダにある参照作品と同じような作品を作ってもらおうと考えています。\n\nあなたのスタイルで、デンゲンというキャラクターを使って、同じような作品を作っていただきたいです！彼のポーズは、アクションでも立っているだけでも構いませんし、可愛くても構いません！ルーフェンのポーズは真似しないでください！画素数が低いので参考にするなら、それもかわいいです。それでも満足です。\n\nまた、完成した作品を使って、一緒に写真を撮ったり、ネットで共有したりするためだけのアクリルスタンディを作らせていただけないでしょうか。もしそれが許されないのであれば、私の依頼を断ってください。自分の作品だと主張するつもりはありませんし、アクリルスタンディを制作して販売するつもりもありません。\n\nこのような機会を与えていただき、ありがとうございました。❤️😊🙏\n\nhttps://drive.google.com/drive/folders/1RsrtVeRIZnve8GV5nmgY-YmOLN0iN93l", "created_at": "", "completed_at": ""}, {"path": "/@sesuji07/works/93", "thumbnail_src": "https://si.imgix.net/f6884886/uploads/origins/4ed6ed58-f327-424d-ab53-12c2e91495e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baea58802c4cd3ca1298490d92d30b16", "thumbnail_srcset": "https://si.imgix.net/f6884886/uploads/origins/4ed6ed58-f327-424d-ab53-12c2e91495e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baea58802c4cd3ca1298490d92d30b16, https://si.imgix.net/f6884886/uploads/origins/4ed6ed58-f327-424d-ab53-12c2e91495e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac3bc77b69140dfb2a03a22f7f355c4b 2x, https://si.imgix.net/f6884886/uploads/origins/4ed6ed58-f327-424d-ab53-12c2e91495e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bd8c83e82c9fffe3e1e163fae019782 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの素敵な絵が私の目に留まり、私のキャラクターであるフレイヤを描いてほしいという私の依頼を検討してもらえたら嬉しいです。\n\n以下は私のキャラクターの参考です： https://files.catbox.moe/8ppwej.PNG\nフレイアは、クールでミステリアスに見せることに執着している腕利きの剣士で、「中二病」にも似た、クールだと思う不吉なセリフをつぶやきます。\n\n剣を持ったクールなポーズとか、中二病っぽいポーズもいいかもしれませんが、お任せします＾＾。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sesuji07/works/92", "thumbnail_src": "https://si.imgix.net/4d267b37/uploads/origins/82b2505f-923e-4eeb-8141-b287b559547a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc7e51ace32824aefe20b3bfda45801c", "thumbnail_srcset": "https://si.imgix.net/4d267b37/uploads/origins/82b2505f-923e-4eeb-8141-b287b559547a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc7e51ace32824aefe20b3bfda45801c, https://si.imgix.net/4d267b37/uploads/origins/82b2505f-923e-4eeb-8141-b287b559547a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07819c1ff0fc0826593716d7a954a455 2x, https://si.imgix.net/4d267b37/uploads/origins/82b2505f-923e-4eeb-8141-b287b559547a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96035eef7d53c5d034e533aac425b471 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\nモカという名前のOCを描いてほしい。\n\n構図やポーズはお任せします。\n\n用途YouTubeアカウント/ストリーム、Twitterアカウント、動画などで使用する可能性があります。\n\n参考\nhttps://1drv.ms/f/s!ArB9hx8odCgug21bNls_n8lDZLv5?e=VlEz6z", "created_at": "", "completed_at": ""}, {"path": "/@sesuji07/works/91", "thumbnail_src": "https://si.imgix.net/3ccdf5d5/uploads/outputs/9a60c1fb-cb5f-4ab8-8b6b-9140a55f1a83?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6b6549c7f9d470659f7f68c6c052c8a7", "thumbnail_srcset": "https://si.imgix.net/3ccdf5d5/uploads/outputs/9a60c1fb-cb5f-4ab8-8b6b-9140a55f1a83?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6b6549c7f9d470659f7f68c6c052c8a7, https://si.imgix.net/3ccdf5d5/uploads/outputs/9a60c1fb-cb5f-4ab8-8b6b-9140a55f1a83?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b07987bcdff10ebd699c65f3df247d66 2x, https://si.imgix.net/3ccdf5d5/uploads/outputs/9a60c1fb-cb5f-4ab8-8b6b-9140a55f1a83?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=85cc3e3d97abf72b8ddeacafcccb78c7 3x", "genre": "video", "nsfw": false, "body": "こんにちは！\n\n私の虫のキャラクターが踊るループアニメーションをお願いしたいです。デザインリファレンスとポーズアニメーションリファレンスは以下のURLにあります。彼女の服のリファレンスを選択してください。\n\nhttps://imgur.com/a/xI3jNrN\n\n私のキャラクターは陽気で元気です。体は分節されていて、目は4つある。耳と鼻はありません。\n\nダンス中、前腕は上下に交互に動く。腰は左右に動く。前後に動くことはない。口は常に笑っていて、腰が左右に1回ずつ動いた後に開閉する。口の開閉時に牙が見えるようにしてください！アニメーションがループするとき、彼女はまばたきをします。", "created_at": "", "completed_at": ""}, {"path": "/@sesuji07/works/90", "thumbnail_src": "https://si.imgix.net/44d10c5c/u