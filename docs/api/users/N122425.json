ng magical experiments (potions, herbs, alchemy) or she reads books in bookstores or libraries; shopping for magical supplies at the bazaar; afternoon tea (she doesn't like overly sweet or foods with a lot of cream, so maybe cookies would be better for her! She favors herbal teas)\n\nThank you for reading!\n\nhttps://drive.google.com/drive/folders/133gMJY3xJ9ZQlwEliK7aV_i--LEtJlS7", "created_at": "", "completed_at": ""}, {"path": "/@N122425/works/12", "thumbnail_src": "https://si.imgix.net/ed6fc3be/uploads/origins/f79fd0b0-5209-493c-897f-08082ea1188f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdec22d22811fba1aa9f3c58ddc8a1e3", "thumbnail_srcset": "https://si.imgix.net/ed6fc3be/uploads/origins/f79fd0b0-5209-493c-897f-08082ea1188f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdec22d22811fba1aa9f3c58ddc8a1e3, https://si.imgix.net/ed6fc3be/uploads/origins/f79fd0b0-5209-493c-897f-08082ea1188f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c087e57161013fa5c28ca1da82e723d 2x, https://si.imgix.net/ed6fc3be/uploads/origins/f79fd0b0-5209-493c-897f-08082ea1188f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=717453258610bf39f1b430382a7b3a86 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@N122425/works/11", "thumbnail_src": "https://si.imgix.net/9e707310/uploads/origins/31039bcd-f3c5-40bc-9306-7c8ad04cee2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccente