e%2Ccenter&txtsize=30&txt=PRIVATE&s=5c8c848c6432200a472b00d0666374cb 2x, https://si.imgix.net/0d5e6e3e/uploads/origins/85042467-4142-4937-a479-616ece505af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16b70a6bead92e26b858761d86f68f0f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kozuka_docoro/works/6", "thumbnail_src": "https://si.imgix.net/74b38f70/uploads/origins/e54be1f3-924a-4c16-bc90-b2fdeb3f4a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ae0ab3acd09a3feab38e4d5316b7db", "thumbnail_srcset": "https://si.imgix.net/74b38f70/uploads/origins/e54be1f3-924a-4c16-bc90-b2fdeb3f4a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ae0ab3acd09a3feab38e4d5316b7db, https://si.imgix.net/74b38f70/uploads/origins/e54be1f3-924a-4c16-bc90-b2fdeb3f4a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f1944441079893cd68f04af060e1605 2x, https://si.imgix.net/74b38f70/uploads/origins/e54be1f3-924a-4c16-bc90-b2fdeb3f4a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07c8a8e27c5f25f1e179a103887027a7 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nイラストを見せていただき、お願いをできれば、と思いました。\nテーマがかぶって申し訳ないのですが「アスラ斬魔伝の羅刹」コスチュームのリムルルの「素手格闘シーン」です。\n相手は緋雨閑丸でお願いします。衣装は最新作または斬紅郎無双剣、どちらでも大丈夫です。\n二人とも１Pカラーでお願いします。\n\n2コマ漫画風にお願いって出来ますでしょうか？\n1コマ目\nリムルルのとどめの一撃（ひじ打ちか膝蹴りか蹴り）が閑丸のみぞおちに決まるシーン。\nリムルル「えいっ！」\n閑丸「うっ！うぅ…。」\n\n2コマ目\n倒れている、または崩れ落ちている閑丸の目の前で勝ちポーズのリムルル。\n閑丸「負けられないのに…」\nリムルル「えへへっ♪あたしの勝ち！」\n\nという感じでお願いできればと思います。\n真剣勝負というよりはちょっとした鍛錬のような平和な空気でお願いできればと思います。\n以上、ご検討いただけますと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@kozuka_docoro/works/5", "thumbnail_src": "https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfab781913cc610731a6509236061357", "thumbnail_srcset": "https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfab781913cc610731a6509236061357, https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bad21cae192ceee22d882ddc38d624a 2x, https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c9931c11840eb9832ab4ad329c55a70 3x", "genre": "art", "nsfw": false, "body": "先月はありがとうございました\n『徒手で格闘するリムルル』をリクエストします\n\n◯リムルル\n技:武器ではなくひじ打ち、回し蹴り、跳び蹴り等の技でお願いします。技はお任せいたします\n衣装:アスラ斬魔伝羅刹リム又は零サムリム(どちらの衣装でも構いません)\n\n◯対戦相手\nお任せします。描かれていても、いなくても構いません。\n\nご検討の程宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@kozuka_docoro/works/4", "thumbnail_src": "https://si.imgix.net/6b772fd4/uploads/origins/3b6c16e7-9a03-4e50-9f14-2c115038a3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f722f538ba805d77131e08dd2388b2dd", "thumbnail_srcset": "https://si.imgix.net/6b772fd4/uploads/origins/3b6c16e7-9a03-4e50-9f14-2c115038a3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f722f538ba805d77131e08dd2388b2dd, https://si.imgix.net/6b772fd4/uploads/origins/3b6c16e7-9a03-4e50-9f14-2c115038a3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f42ff9cc6e159c9ab1dd1ddb6b872f1 2x, https://si.imgix.net/6b772fd4/uploads/origins/3b6c16e7-9a03-4e50-9f14-2c115038a3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=900639cb136f19397183a8c918fd447e 3x", "genre": "art", "nsfw": false, "body": "先日はありがとうございました\n零サムのリムルルEDの『これからは姉様が一緒』の場面をリクエストします\nキャラは2名、零サムEDで一人ぼっちだと泣くリムルルにナコルルが声をかける場面です\n\n◯リムルル\n衣装等お任せ致します\n◯ナコルル\n衣装等お任せ致します\n\nご検討の程宜しくお願い致します", "created_at": "", "comp