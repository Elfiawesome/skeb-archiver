2700-4e2a-bf39-62e3d2b9ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aef4759a2b4cfcc5db9f2228a996a078", "thumbnail_srcset": "https://si.imgix.net/7f6bb435/uploads/origins/5807f48a-2700-4e2a-bf39-62e3d2b9ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aef4759a2b4cfcc5db9f2228a996a078, https://si.imgix.net/7f6bb435/uploads/origins/5807f48a-2700-4e2a-bf39-62e3d2b9ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d938ad1bd0871e5f9189495214c746c5 2x, https://si.imgix.net/7f6bb435/uploads/origins/5807f48a-2700-4e2a-bf39-62e3d2b9ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96ad4ed6c355d8e3676fde756e65579b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/116", "thumbnail_src": "https://si.imgix.net/6186037e/uploads/origins/3874531f-ba6f-4128-8272-641dae8371ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2cca199fffdace9d2e063ac001debef", "thumbnail_srcset": "https://si.imgix.net/6186037e/uploads/origins/3874531f-ba6f-4128-8272-641dae8371ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2cca199fffdace9d2e063ac001debef, https://si.imgix.net/6186037e/uploads/origins/3874531f-ba6f-4128-8272-641dae8371ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05e87122b198689fe2057beda121addd 2x, https://si.imgix.net/6186037e/uploads/origins/3874531f-ba6f-4128-8272-641dae8371ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca144b9b1ddb149c28629a20ea54f3d5 3x", "genre": "comic", "nsfw": true, "body": "以前のリクエストした魔女の旅々のイレイナの話がとても満足のいく出来でしたのでまた同じようなリクエストさせて頂きます。\n十字架のネックレスにされたイレイナをお願いします。\n呪い・魔法の類いでネックレスになったイレイナは雑貨屋の売り物から時には聖職者の正統なアクセサリーとして、時には譲った年頃の男子に変な意味で使用されたりなどいろんな人に魔女としてではなくただの物として扱われる。（人ではなく物としてだが）いろんな人と交流し旅を続けられているので当分この姿のままでいようかと考え始めている。\n要するに金属化と縮小化です宜しくお願いします。\n\nhttps://www.amazon.co.jp/dp/B0BN7WGKCH?ref=cm_sw_r_ud_dp_QZQT713H5ZGR0B3922WX&ref_=cm_sw_r_ud_dp_QZQT713H5ZGR0B3922WX&social_share=cm_sw_r_ud_dp_QZQT713H5ZGR0B3922WX&language=ja-JP", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/115", "thumbnail_src": "https://si.imgix.net/8b224400/uploads/origins/3a9e6639-9168-4a56-b8d0-5db5d3970b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35fa6aded443d1f40afc46658b1e4b60", "thumbnail_srcset": "https://si.imgix.net/8b224400/uploads/origins/3a9e6639-9168-4a56-b8d0-5db5d3970b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35fa6aded443d1f40afc46658b1e4b60, https://si.imgix.net/8b224400/uploads/origins/3a9e6639-9168-4a56-b8d0-5db5d3970b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e2b9c59122ea1aeaa8df01c19005819 2x, https://si.imgix.net/8b224400/uploads/origins/3a9e6639-9168-4a56-b8d0-5db5d3970b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c36d9679748e56fc37b49f5f127135e 3x", "genre": "art", "nsfw": true, "body": "マイ・キャラは盗賊の一団と戦うために出向くが、簡単に打ち負かされ、全ての装備を剥ぎ取られてしまう。\n彼女が虐待されながら（彼らは彼女を弄び、「お前は戦士ではなく性奴隷だ」と、手を楽々と彼女の中に入れることができると語る）、別の盗賊が彼女の装備を身に着けた。\n\n\n盗賊は賞金を集めるため、彼女になりすましながら、さまざまなポーズで彼女をさまざまな町や村に連れて行\n彼女を馬や犬に縛り付け、その肉の袖として利用する。\n\nhttps://drive.google.com/file/d/1w1V3VPmXfHyglELI4TSewAlydxjrjopY/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/114", "thumbnail_src": "https://si.imgix.net/7941fbe8/uploads/origins/e93adaa3-acf9-43e8-b5cc-c500a69bf722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fa0121a6bb290d15d7ce7a1387108e9", "thumbnail_srcset": "https://si.imgix.net/7941fbe8/uploads/origins/e93adaa3-acf9-43e8-b5cc-c500a69bf722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fa0121a6bb290d15d7ce7a1387108e9, https://si.imgix.net/7941fbe8/uploads/origins/e93adaa3-acf9-43e8-b5cc-c500a69bf722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5ad25bef28c228d282fbef7a909f210 2x, https://si.imgix.net/7941fbe8/uploads/origins/e93adaa3-acf9-43e8-b5cc-c500a69bf722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=158b6b8c94d2f716b372d6afae383e06 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/113", "thumbnail_src": "https://si.imgix.net/f875bae2/uploads/origins/cd28586f-4c88-4e67-b296-143bb1db7230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=717169d22a9591a308a3f5256ccb0ce3", "thumbnail_srcset": "https://si.imgix.net/f875bae2/uploads/origins/cd28586f-4c88-4e67-b296-143bb1db7230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=717169d22a9591a308a3f5256ccb0ce3, https://si.imgix.net/f875bae2/uploads/origins/cd28586f-4c88-4e67-b296-143bb1db7230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8e9a5fa2543716cbc435b0aec6f1858 2x, https://si.imgix.net/f875bae2/uploads/origins/cd28586f-4c88-4e67-b296-143bb1db7230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a3d31cb5d187acd3e1487cc79db496e 3x", "genre": "comic", "nsfw": true, "body": "以前の魔女の旅々のイレイナの石化の話が好みでしたので同じようなリクエストさせて頂きます。 \n 優勝トロフィーの飾り(金の像)に変化したイレイナ (黄金化 ＆縮小化)をお願いします \n 変化後は施設内の他のトロフィーとかが置かれてる棚に一緒に飾られて 掃除に来る生徒or掃除のおばちゃんに丁重に扱われている。 \n 通りがかりの人に自身の身体をみられ恥ずかしい気持ちもあるが今の状態も満更ではないとおもっている。 という感じでお願いします  \n\n・縮小化されているシチュなので誰かの手に持ち上げられているなどサイズ感がわかる表現がほしいです  \n色々書きましたがご検討していただけるならストーリー設定など自由にアレンジして貰っても構いません  ご検討宜しくお願いします\n\n  参考資料 トロフィー (ポーズ指定はないです) https://item.rakuten.co.jp/zm-mart/zym111/  https://amzn.asia/d/hbUKNwN", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/112", "thumbnail_src": "https://si.imgix.net/4a24054f/uploads/origins/011e7891-09c9-4fd3-8cbe-672bfea7106f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b35ac43c1ed3f64deb9c4ae062b41708", "thumbnail_srcset": "https://si.imgix.net/4a24054f/uploads/origins/011e7891-09c9-4fd3-8cbe-672bfea7106f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b35ac43c1ed3f64deb9c4ae062b41708, https://si.imgix.net/4a24054f/uploads/origins/011e7891-09c9-4fd3-8cbe-672bfea7106f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2feefbe23bcb09e70ff0bb6af9f92fb 2x, https://si.imgix.net/4a24054f/uploads/origins/011e7891-09c9-4fd3-8cbe-672bfea7106f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=798378fb8fb9f72a1cce7fb5446ca6fa 3x", "genre": "art", "nsfw": true, "body": "ブルーアーカイブより宇沢レイサ、柚鳥ナツ、そして杏山カズサが凍結する内容のコミックを依頼させていただきます！\n凍ってる間も意識なしとしたいので、凍った状態の時はヘイローなしでお願いします。\n\nシチュエーション:\n(1)好事家の生徒(変態)に誘拐され、そして全裸で凍らされたレイサとナツが、冷凍室兼コレクションルームにて飾られている。\n(2)好事家がレイサとナツを愛撫し、小さなお尻に発達途上の胸などかわいらしい部分を褒め、それが凍りついたことを素敵だと言う。\n(3)「あなたもそうは思わない？」と好事家が、全裸で設置型の拘束器具に囚われたカズサ(まだ凍ってない)に語りかける。(拘束器具は捕らえた対象を使用者の好きなポーズで固定できる器具で、特定のポーズの氷像を作りたい時に使われる)\n(4)「助けにきて返り討ち。とても私の好みのシチュエーションよ」と好事家は言い放ち。2人と比べるとやや大人なカズサの色香や、引き締まったお腹などを愛撫しつつ褒め、そして「2人のお友達に凍る姿を見せてあげなさい」とカズサに液体窒素か冷凍ガスを浴びせる。\n(5)冷凍室にレイサ、ナツ、カズサの氷像が並べて展示されている。カズサが凍りついた後、彼女は拘束器具から取り外され、そしてレイサやナツと同じように台座に据え付けられ、コレクションルームを彩るオブジェに仕立てられたのだ。\n\n以上の内容でよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/111", "thumbnail_src": "https://si.imgix.net/c776bd72/uploads/origins/2d2f3f96-c66f-45dd-b131-60f64bc8eef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=583eb1ec4a8abd96af995b5bbcd3a87d", "thumbnail_srcset": "https://si.imgix.net/c776bd72/uploads/origins/2d2f3f96-c66f-45dd-b131-60f64bc8eef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=583eb1ec4a8abd96af995b5bbcd3a87d, https://si.imgix.net/c776bd72/uploads/origins/2d2f3f96-c66f-45dd-b131-60f64bc8eef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6ea26ba141e23c8e9f7d32c1a60fbf2 2x, https://si.imgix.net/c776bd72/uploads/origins/2d2f3f96-c66f-45dd-b131-60f64bc8eef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0857357baf8c88a98ed7266c6aca4455 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/110", "thumbnail_src": "https://si.imgix.net/2a73ab43/uploads/origins/46d856c4-3105-475c-b78b-1835f58e764c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfd343a68ba9425226244fb0873cfe65", "thumbnail_srcset": "https://si.imgix.net/2a73ab43/uploads/origins/46d856c4-3105-475c-b78b-1835f58e764c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfd343a68ba9425226244fb0873cfe65, https://si.imgix.net/2a73ab43/uploads/origins/46d856c4-3105-475c-b78b-1835f58e764c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=561b477694a866b232a2927438ad816d 2x, https://si.imgix.net/2a73ab43/uploads/origins/46d856c4-3105-475c-b78b-1835f58e764c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d25bf4d2a62cc80a91ba4a14ffd915d9 3x", "genre": "comic", "nsfw": true, "body": "以前、「タノシミ」の名城さん数年後のシーン、を描いていただきました。\nかなり久々ですが、リクエストさせていただきます。\n今回も先生の商業作品「ナイフリモドキ」の多治見さんをお願い致します。\nこちらも、本編から数年後（ＪＫ３～ＪＤくらい）の姿で、アンダーヘアありでお願いします。\n彼氏の瑞浪くんとは本編後もお付き合い中。今日はとうとう「大きい方」を見てもらうというシーンです。\n\n「色々してきたけど・・・こっちを見せてもらうの初めてだね・・・」\n「あぁ・・・我慢してたからお腹痛いです・・・すぐ出そう・・・待ってて下さい」\n下を脱ぎ、パンツも脱いで下半身丸出しでしゃがみ込む多治見さん。\n「ぁ・・・出る・・・我慢してたからいっぱい・・・ごめんね瑞浪くん・・・」\nペットシートめがけてブリブリとウンチを山盛りにする多治見さん。\nアナルから出ているところが見えるカットがほしいです。\n\nたっぷりと排泄し終わった後、瑞浪くんとキスをする。\n「もうこれでもう全部見せちゃいました・・・後はもう、「受精」しかないですよね。大好きですよ、瑞浪くん・・・」\nきっとこの後めちゃめちゃＨする！んだろうなというところで終了。\n\nよろしければ、お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Circle_Shirando/works/109", "thumbnail_src": "https://si.imgix.net/189895bb/uploads/origins/194a075c-7d58-4ce4-bd1e-9b2dd3b84c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=313eb8e8ddb9d68847000c59529e7d5d", "thumbnail_srcset": "https://si.imgix.net/189895bb/uploads/origins/194a075c-7d58-4ce4-bd1e-9b2dd3b84c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=313eb8e8ddb9d68847000c59529e7d5d, https://si.imgix.net/189895bb/uploads/origins/194a075c-7d58-4ce4-bd1e-9b2dd3b84c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8105f137d95933f432b470304fb3ccfb 2x, https://si.imgix.net/189895bb/uploads/origins/194a075c-7d58-4ce4-bd1e-9b2dd3b84c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&t