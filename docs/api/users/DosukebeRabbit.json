gins/ce77f58a-2e46-4f7c-b263-b6f50a8830ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66d904734ceaa163f9f5d9d4ca7f31e8", "thumbnail_srcset": "https://si.imgix.net/04aba9c1/uploads/origins/ce77f58a-2e46-4f7c-b263-b6f50a8830ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66d904734ceaa163f9f5d9d4ca7f31e8, https://si.imgix.net/04aba9c1/uploads/origins/ce77f58a-2e46-4f7c-b263-b6f50a8830ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=217f3464aa1478417bd07544edf34b50 2x, https://si.imgix.net/04aba9c1/uploads/origins/ce77f58a-2e46-4f7c-b263-b6f50a8830ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=927235a3b472414695035e8d43968a30 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DosukebeRabbit/works/81", "thumbnail_src": "https://si.imgix.net/db200496/uploads/origins/8c85a09f-c34c-40d3-92b5-f77cf29083b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52bee2c3349985acd3506ce3e24b25c6", "thumbnail_srcset": "https://si.imgix.net/db200496/uploads/origins/8c85a09f-c34c-40d3-92b5-f77cf29083b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52bee2c3349985acd3506ce3e24b25c6, https://si.imgix.net/db200496/uploads/origins/8c85a09f-c34c-40d3-92b5-f77cf29083b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4a329a040baaef5e161f0a69211b242 2x, https://si.imgix.net/db200496/uploads/origins/8c85a09f-c34c-40d3-92b5-f77cf29083b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e67394179e8e2c85b0cbf45240f55c92 3x", "genre": "art", "nsfw": true, "body": "初めまして！、\n大変素敵なイラスト拝見させていただき、是非にと依頼をお送りさせていただきました。\n依頼内容は下記になります。\n\n依頼するキャラクター：私のOC、エステラ・ヴェルガス\n\n依頼するシチュエーション：犬のような化け物（多少グロテスクでも構いません）に無理やり犯されている図、表情は屈辱と恐怖にまみれて、結合部からは血が滴る。\n衣服や帽子は可能な限りそのままで、スカートはたくしあげられて、胸元だけ破られている感じで、タイツも破られてる感じでお願いします。\nまた、敗北した後なので頬に擦り傷などもあると嬉しいです。\n構図は　https://skeb.jp/@DosukebeRabbit/works/72　こちらの構図がとても良かったのでお願いしたいです。\nまた、表情の資料、雰囲気も資料用のURLに記載しております、参考になれば幸いです。\n\nそれでは、宜しくお願いします！。\n\nhttps://imgur.com/a/mOLN8Qi", "created_at": "", "completed_at": ""}, {"path": "/@DosukebeRabbit/works/80", "thumbnail_src": "https://si.imgix.net/af86ec16/uploads/origins/7d0c230f-12d4-4f48-9061-452d2c478dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d48aa189f3d49f78c50d6e2e835130", "thumbnail_srcset": "https://si.imgix.net/af86ec16/uploads/origins/7d0c230f-12d4-4f48-9061-452d2c478dab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d48aa189f3d49f78c50d6e2e835130, https://si.imgix.net/af86ec16/uploads/origins/7d0c230f-12d4-4f48-9061-452d2c478dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2975d4cb8f4611f48404d61fc6b6c84c 2x, https://si.imgix.net/af86ec16/uploads/origins/7d0c230f-12d4-4f48-9061-452d2c478dab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0edc6ff3d09a441342374cfd93a73c63 3x", "genre": "art", "nsfw": true, "body": "Xでいつもえっちな動物仲良しありがとうございます\nうちの子の八重櫻楓のいちゃらぶ犬なかよしをお願いしたいです。\nシチュとして\n・犬の姿になってしまった竿役くんとえっち\n・犬種的にはかっこいい(オオカミ系)で色は銀系でお願いしたいです\n・亀頭球がはまり込んでる断面図\n・妊娠して子犬が見えてる断面図\nの差分\nもいただけたら嬉しいです\n\nhttps://x.com/amasakura_/status/1844706140598477125?s=46&t=pffGfh-GvV3KGaaB38vsog", "created_at": "", "completed_at": ""}, {"path": "/@DosukebeRabbit/works/79", "thumbnail_src": "https://si.imgix.net/5fcf32d4/uploads/origins/c9d26641-7271-4f1a-ab5b-4d718e2f8225?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72c631a54d7c9db18dc635f42d50c693", "thumbnail_srcset": "https://si.imgix.net/5fcf32d4/uploads/origins/c9d26641-7271-4f1a-ab5b-4d718e2f8225?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72c631a54d7c9db18dc635f42d50c693, https://si.imgix.net/5fcf32d4/uploads/origins/c9d26641-7271-4f1a-ab5b-4d718e2f8225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c97d4cd007659872ce6bf8a0fc70c793 2x, https://si.imgix.net/5fcf32d4/uploads/origins/c9d26641-7271-4f1a-ab5b-4d718e2f8225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8a82ceb732760268f9368d6c6bcacf1 3x", "genre": "art", "nsfw": true, "body": "こんにちは、友人のために画像を依頼したいのですが。\n\nリトルウィッチ・ノベタ」のノベタが下のような制服を着て、ブタに乱暴されているところを描いてください。\n\n[https://cdn.imgchest.com/files/ac011114b85e.png]\n\n彼女は、後背位で、顔を床につけ、尻を上げ、豚が彼女に馬乗りになっているはずです。彼女は豚に孕まされているはずです。\n\n可能であれば、ビデオ録画を通して誰かが見ているように見えるバリエーションを追加していただけるとありがたいのですが、必須ではありません。", "created_at": "", "completed_at": ""}, {"path": "/@DosukebeRabbit/works/78", "thumbnail_src": "https://si.imgix.net/d65bdce6/uploads/origins/055f5199-08b2-4819-81fc-788aa0cd6a15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454a189c52c71604a18bcb1149022f42", "thumbnail_srcset": "https://si.imgix.net/d65bdce6/uploads/origins/055f5199-08b2-4819-81fc-788aa0cd6a15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454a189c52c71604a18bcb1149022f42, https://si.imgix.net/d65bdce6/uploads/origins/055f5199-08b2-4819-81fc-788aa0cd6a15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db0a48ae3450879e74e91e9cf70a3504 2x, https://si.imgix.net/d65bdce6/uploads/origins/055f5199-08b2-4819-81fc-788aa0cd6a15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5488a8e9e9fa2ff971358496474c2e0b 3x", "genre": "comic", "nsfw": true, "body": "前回、都合悪くなって再送できなかったのでお願いします。\n描いて欲しいキャラ: 雪尾紺(資料のロングヘアの方でスカート部分は無し)\n\n犬のリードを付けて犬と一緒にお散歩(紺は歩き)させられてる時にモジモジし始めたため、パンツを脱いで、電柱に犬みたいに四つん這いで片足あげておしっこをさせる。\n\n出し終わると犬がまんこの匂いを嗅いで、興奮してのしかかってきて腰を振り始め、犬ちんぽを挿入されてズポズポ腰を振られ(腰振られるうちにおっぱいがボロンする)て子宮に大量に中出し(受精完了♡断面図有)されて絶頂する。\n\nまだ収まらない犬がヘタってる紺に、まだ犬がちんぽを擦り付けているとおしりの穴に挿入されてピストンされてしまい「そっちの穴はっ♡ダメっ♡お゛っイグっ♡イ゛っちゃう♡」と喘いでも止まらず射精されてしまう。\n\n犬ちんぽを抜かれるとおしっこ漏らしながらおしりの穴から無様に精液が溢れている(紺の表情は快楽で蕩けている)。\n\nhttps://x.com/yukiokon/status/1744757704344977608?s=46&t=JCR7XEqAMlN4hWJG6IvLTg", "created_at": "", "completed_at": ""}, {"path": "/@DosukebeRabbit/works/77", "thumbnail_src": "https://si.imgix.net/4c82da17/uploads/origins/60374ecb-632c-4924-994b-e01e0b45c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1ab41e7ed7c610626aecb7d0578f0c3", "thumbnail_srcset": "https://si.imgix.net/4c82da17/uploads/origins/60374ecb-632c-4924-994b-e01e0b45c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1ab41e7ed7c610626aecb7d0578f0c3, https://si.imgix.net/4c82da17/uploads/origins/60374ecb-632c-4924-994b-e01e0b45c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a52c084c643ba360c4a776f51ba99cb 2x, https://si.imgix.net/4c82da17/uploads/origins/60374ecb-632c-4924-994b-e01e0b45c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dae71966ba576d2f2de7aef396841d94 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DosukebeRabbit/works/76", "thumbnail_src": "https://si.imgix.net/18cc625c/uploads/origins/1e81008f-3924-4e74-aa57-80d38ab3dcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalig