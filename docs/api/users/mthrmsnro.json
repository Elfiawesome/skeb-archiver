cd-8b2a-b6398b6d60bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a5364712b0ecde26c83796fbb5c3773, https://si.imgix.net/d38e531d/uploads/origins/63216982-da17-4acd-8b2a-b6398b6d60bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5e2b2d68c0e360b459f131261200800 2x, https://si.imgix.net/d38e531d/uploads/origins/63216982-da17-4acd-8b2a-b6398b6d60bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=446cd366f3895bf9b369af2fe0ee5f8f 3x", "genre": "art", "nsfw": false, "body": "ミツヒロム様 はじめまして。快刀乱魔をHO2で通過した者です。とても楽しく通過でき、シナリオも購入させていただきました…！素敵なシナリオをありがとうございました。\n今回はNPC  六栄守理のイラストを描いていただきたく、リクエストをお送りいたしました。\nご検討いただけますと幸いです。\n\n【リクエスト】\nもし服装指定が可能であればスーツ（正装）姿の守理さんが見てみたいです。\nその他構図やサイズなどの希望はございません。\n個人観賞用として使用いたします。\n\n私事で恐縮ですが、今回初めてskebを利用しています。不慣れなため、至らぬ点もあるかと存じますがどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mthrmsnro/works/69", "thumbnail_src": "https://si.imgix.net/f4561b39/uploads/origins/5291b28f-15b2-45ac-9fcb-2e444aaa27e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=381d8483947e6160d32b32051cc814c1", "thumbnail_srcset": "https://si.imgix.net/f4561b39/uploads/origins/5291b28f-15b2-45ac-9fcb-2e444aaa27e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=381d8483947e6160d32b32051cc814c1, https://si.imgix.net/f4561b39/uploads/origins/5291b28f-15b2-45ac-9fcb-2e444aaa27e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62544db223d1c487424809fd242d1616 2x, https://si.imgix.net/f4561b39/uploads/origins/5291b28f-15b2-45ac-9fcb-2e444aaa27e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f73d9a52027354976c9b3837e1ea025a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mthrmsnro/works/68", "thumbnail_src": "https://si.imgix.net/992c5be3/uploads/origins/5f0bf614-7161-4452-a2f8-e6c1f3d74457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ac9f877d18d26866bbb8847e481d69", "thumbnail_srcset": "https://si.imgix.net/992c5be3/uploads/origins/5f0bf614-7161-4452-a2f8-e6c1f3d74457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ac9f877d18d26866bbb8847e481d69, https://si.imgix.net/992c5be3/uploads/origins/5f0bf614-7161-4452-a2f8-e6c1f3d74457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1aec07a064d7af03b1a5b9be379b1c7c 2x, https://si.imgix.net/992c5be3/uploads/origins/5f0bf614-7161-4452-a2f8-e6c1f3d74457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f88cd1d7acc7d87f7aade1263e9093d 3x", "genre": "art", "nsfw": false, "body": "ROM様、🐟と申します。再度リクエスト失礼します🙇‍♀️(内容は以前と変わっておりません)\nNonagramのNPCであるベルホルトと自探索者(弊HO3)のイラストをお願いしたく依頼させて頂きます。\n\n以下、依頼内容です。\n\n\n▼キャラクター補足\nアイリーン\n・白髪で右眼が隠れている片目隠れ\n・左眼は赤、右眼は反転眼、瞳の色が紫色に変化している(滅多に他人に見せることは無い)\n・足首に達するほどの長髪。ある程度整えられているが所々大きな跳ね有\n\n細かなところは自探索者のキャラシを添付させて頂いておりますので、確認頂ければ幸いです。\n\n服装に関して、見えないところはROM様の好きなように描いて頂いて構いません。\n構図に関してもROM様の描きやすい構図で大丈夫です。もし指定が必要であれば、弊HO3がベルホルトをかなり好いているので、仲の良い友人・大切な人同士と捉えられるような表情や構図だと嬉しいです。\n\n\n▼使用用途\n・個人観賞(友人への共有)\n・SNSでのアイコン・ヘッダーに使用する可能性\n\n\nよろしくお願い致します🙇‍♂️\n\nhttps://iachara.com/view/7676163", "created_at": "", "completed_at": ""}, {"path": "/@mthrmsnro/works/67", "thumbnail_src": "https://si.imgix.net/ce7c7526/uploads/origins/f2ac3cd3-5b10-4cba-aacb-d3623ab3cc9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55a708ddd8b2ee06dbd9cda653835e93", "thumbnail_srcset": "https://si.imgix.net/ce7c7526/uploads/origins/f2ac3cd3-5b10-4cba-aacb-d3623ab3cc9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55a708ddd8b2ee06dbd9cda653835e93, https://si.imgix.net/ce7c7526/uploads/origins/f2ac3cd3-5b10-4cba-aacb-d3623ab3cc9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0fdd38e60e437123d0a492c475f05d2 2x, https://si.imgix.net/ce7c7526/uploads/origins/f2ac3cd3-5b10-4cba-aacb-d3623ab3cc9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf6e45088430e4628305773144268880 3x", "genre": "art", "nsfw": false, "body": "はじめまして、もんごと申します。\n今年の8月にNUMERALSをHO3で通過しました。感動し、熱くなった素晴らしい時間でした。本当にありがとうございます。\n現在も月に1回以上自陣で集まって継続シナリオに行っています。\n\n今回リクエストさせていただきたいのは、NUMERALS自探索者HO3のチェシャとチェレステが一緒にいるイラストが見たいです。\n構図などはshop《ROM》様にお任せしますが、チェシャはチェレステのことが大好きな元気っ子なので、チェレステのすぐ傍にいる構図ですと嬉しいです。\nチェシャのキャラクターシートや立ち絵のディスプレイが載った私のツイートのリンクを送らせていただきます。\n\nご縁がありましたら何卒よろしくお願いいたします。\n改めまして、NUMERALSという素晴らしい物語を本当にありがとうございます😭\n\nキャラクターシート↓\n資料URLに載せさせていただきます。\n\n立ち絵ディスプレイツイート↓\nhttps://x.com/tstr12cha/status/1820859918469218678?s=46&t=vemtJvs80mmqk_xKhFLBTg\n\nhttps://iachara.com/view/9435598", "created_at": "", "completed_at": ""}, {"path": "/@mthrmsnro/works/66", "thumbnail_src": "https://si.imgix.net/cb0d8a0b/uploads/origins/682836af-fa0d-4f7c-ac7b-ae7f784f6e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=580a12b11ec6a8cc6560cde7c87546f6", "thumbnail_srcset": "https://si.imgix.net/cb0d8a0b/uploads/origins/682836af-fa0d-4f7c-ac7b-ae7f784f6e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=580a12b11ec6a8cc6560cde7c87546f6, https://si.imgix.net/cb0d8a0b/uploads/origins/682836af-fa0d-4f7c-ac7b-ae7f784f6e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&tx