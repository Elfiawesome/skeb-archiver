df23bda8476cb0a60ac45cab8a250, https://si.imgix.net/1e006ef2/uploads/origins/3820a225-a204-440d-8283-0941455b6c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f38931dc85fc658d94bb08c0d54820a9 2x, https://si.imgix.net/1e006ef2/uploads/origins/3820a225-a204-440d-8283-0941455b6c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2d782a804296a12dc43755c5b73f2bd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/25", "thumbnail_src": "https://si.imgix.net/a655567a/uploads/origins/946e03d9-7b69-4e35-8201-9502404de9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316243d1881bfbd8cd33b28bbb901ffc", "thumbnail_srcset": "https://si.imgix.net/a655567a/uploads/origins/946e03d9-7b69-4e35-8201-9502404de9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316243d1881bfbd8cd33b28bbb901ffc, https://si.imgix.net/a655567a/uploads/origins/946e03d9-7b69-4e35-8201-9502404de9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89737b64b88753d5e84335129e20e13f 2x, https://si.imgix.net/a655567a/uploads/origins/946e03d9-7b69-4e35-8201-9502404de9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=970e2dffa7a3055ac791cf6617d1b446 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/24", "thumbnail_src": "https://si.imgix.net/d225a0a5/uploads/origins/0ec25f4e-964d-411d-a91a-9ade6f2c0840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc81d11758f636744bd4981245837d8b", "thumbnail_srcset": "https://si.imgix.net/d225a0a5/uploads/origins/0ec25f4e-964d-411d-a91a-9ade6f2c0840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc81d11758f636744bd4981245837d8b, https://si.imgix.net/d225a0a5/uploads/origins/0ec25f4e-964d-411d-a91a-9ade6f2c0840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb54c32700156ab8798ef7d8d6afe0a3 2x, https://si.imgix.net/d225a0a5/uploads/origins/0ec25f4e-964d-411d-a91a-9ade6f2c0840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8414b93286dbb819ecf3a76a5fcad26 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました。\nefの主人公勢で京介はまだ漫画に登場していないと思いましたので、景と京介でH漫画をお願いします。\nノリとしては後期minori作品に封入されているおまけ漫画ようなコメディ寄りの内容で、\n題材がR18ですがイチャイチャが見たいので実際の絡み自体はなくても構いません。\n\n下記に題材を示しますが好みの題材でなければ自由に描いてもOKです。\n\n～内容～先日1P漫画だとどうしてもコマ割りが決まってしまうと仰ってましたのと、この話は長くなりそうなので2P分の金額にしています～\n・小説版であくまで冗談として部室に『泉部長(元カノ)隠し撮り集』を回収しにきたと発言するシーン(実際は過去の普通のフィルムを回収しにきただけ)があるのですが、\nそれに類する元カノと撮影したHなビデオが実際に存在したということで、\n京介は処分しようと思っていたけどその隠し場所を忘れて処分をし損ね、それが景にバレ怒られるのですが、\n頭の回転の良さは京介の方が上なので、半ば騙される形で逆に言いくるめられてHなビデオを撮る事になってしまう。みたいな流れ\n\n・前半…(以前Xにおいてこの例えを出しておりましたので引用しますが、あまり気持ちのいいものではなかったとしましたら申し訳ありません)\n所謂AVの自己紹介シーン。(本人が気にしている)スリーサイズを言わせたり、初体験の思い出を(その相手の前で)語らせる羞恥プレイ\n\n・後半…事後シーンもしくは絡みからの事後シーン\n\n私としましては、景は純粋にデレているよりも「怒っているけどその中身が好意の現れ」な点が好きなので、\n頭の回転が鈍くなっている最中、及び事後では「何故私で撮ろうと思わなかったのか」ですとか、\n「彼女いるのに元カノのビデオなんて取っておくな」ですとか\n「ビデオでオナニーするんじゃなくて本人としろ」などといった具合に好意ダダ漏れに怒っている感じでお願いします。\n\n・景の服は制服で、「着衣Hで着衣を脱がす事は許されない」ということで、脱がす場合も「https://skeb.jp/@synonymtan/works/1」のように服のパーツを一切取らないで胸だけを露出したまま、最後まで脱がしきらないでください。\n・京介がいい思いだけするのは癪なので景ちゃんは京介を殴ってしまってOKです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/23", "thumbnail_src": "https://si.imgix.net/9edee7c9/uploads/origins/2725e49b-6ce2-49f2-ba64-83a4bdfa12fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31a59f19743c2f092c247eead44e76d9", "thumbnail_srcset": "https://si.imgix.net/9edee7c9/uploads/origins/2725e49b-6ce2-49f2-ba64-83a4bdfa12fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31a59f19743c2f092c247eead44e76d9, https://si.imgix.net/9edee7c9/uploads/origins/2725e49b-6ce2-49f2-ba64-83a4bdfa12fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40be3a04849de2c647fbc71d7f8fac06 2x, https://si.imgix.net/9edee7c9/uploads/origins/2725e49b-6ce2-49f2-ba64-83a4bdfa12fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edeb5f5a583aae9b2292cec664d0940c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/22", "thumbnail_src": "https://si.imgix.net/8415ca47/uploads/origins/1240bd89-9da0-47d0-a149-69c47f08d5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2cf524d75b2a0d6fcd8813936509289", "thumbnail_srcset": "https://si.imgix.net/8415ca47/uploads/origins/1240bd89-9da0-47d0-a149-69c47f08d5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2cf524d75b2a0d6fcd8813936509289, https://si.imgix.net/8415ca47/uploads/origins/1240bd89-9da0-47d0-a149-69c47f08d5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=337762188072dda8fea391bcfdd002ab 2x, https://si.imgix.net/8415ca47/uploads/origins/1240bd89-9da0-47d0-a149-69c47f08d5f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=816311504f625bddbbc091a51f391bfb 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nいつも素敵なイラスト拝見させていただいてます。\n\n今回はefの雨宮優子と火村夕の1P漫画を依頼したいです。\n時間軸は「天使の日曜日」の「君といる未来」のさらにその少し先でお願いします。\n\n優子がみやこからプレゼントされたベビードールを着て夕に二人目をつくろうと誘惑するシチュエーションで、ちょっとエッチな感じの内容でお願いします。\n全体的な雰囲気は優子のよくやるいたずらっぽい感じでお願いします。\n\nよろしくお願いいたします。\n\n↓ベビードールはこんな感じをイメージしていただけると助かります（アマゾンの商品ページリンクです）\n\nwww.amazon.co.jp/dp/B0BX3MY4QW\n\nwww.amazon.co.jp/dp/B079TKPRYC", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/21", "thumbnail_src": "https://si.imgix.net/c9ac2585/uploads/origins/63b98b66-500b-45bf-ae1f-b89057f17ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b218c04bd86d81d56a725f6a89094ba9", "thumbnail_srcset": "https://si.imgix.net/c9ac2585/uploads/origins/63b98b66-500b-45bf-ae1f-b89057f17ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b218c04bd86d81d56a725f6a89094ba9, https://si.imgix.net/c9ac2585/uploads/origins/63b98b66-500b-45bf-ae1f-b89057f17ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07cc63f3353e4d973c21ca221b149857 2x, https://si.imgix.net/c9ac2585/uploads/origins/63b98b66-500b-45bf-ae1f-b89057f17ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c31da631739996c2578b211f4920ecc 3x", "genre": "art", "nsfw": true, "body": "都合が付けばでかまわないので、\nもし可能であればefを題材にR-18で1P漫画を描いて頂けますか。\n所謂温泉回のようなちょっとえっちな内容でも\n絡み有の結構いやらしい内容でも可です。\n\n内容は下記の条件で誰を出すかを含めお任せします。\n・絡み有の場合原作カップリング且つ基本的に女性陣に主導権を握られた状態\n　但し天使の日曜日でのカップリングを含めた3Pは可で、夕×明里は優子込の3Pないし凪込の4PならOK\n・温泉回のラッキースケベ的な内容の場合、他の異性の相手に裸を見られるのは自身の相手と同伴であればOK\n\nよろしくお願い致します。\n\n↓キャラクターの背丈や呼称の早見表といった参考資料です。よろしければご利用ください。\n\nhttps://imgur.com/a/ytmL4M0", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/20", "thumbnail_src": "https://si.imgix.net/afdb9c74/uploads/origins/43cd5cbd-ff67-455c-a34a-c7b2843ef0f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1434c45cb9563261deec4fb2be9678c4", "thumbnail_srcset": "https://si.imgix.net/afdb9c74/uploads/origins/43cd5cbd-ff67-455c-a34a-c7b2843ef0f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1434c45cb9563261deec4fb2be9678c4, https://si.imgix.net/afdb9c74/uploads/origins/43cd5cbd-ff67-455c-a34a-c7b2843ef0f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee598a501eb3ad2b936d9ccdbf8f902d 2x, https://si.imgix.net/afdb9c74/uploads/origins/43cd5cbd-ff67-455c-a34a-c7b2843ef0f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad69fe49cdd9bbcbaa900923beda5580 3x", "genre": "art", "nsfw": false, "body": "いつもありがとうございます。\n先日の誕生日漫画凪Verは実によかったです。\n私は凪の「ブラコンだけど恋愛的に好きな人は別にいる。(おそらく)純粋な家族愛としてのブラコン」という点が大好きでして、弟の彼女の行動に対するブラコンお姉ちゃんの反応というのはとても見たい要素でしたので大変満足でした。\nさて、今回のリクエストですが、昔はお姉ちゃん呼びしてたよねということで、子供の頃の紘が学生時代の凪に絡まれている回想と、その話を聞いたみやこが今回は逆にジェラシー(といっても本編のようなガチ修羅場ではなく)を感じて(しょうもないことで)張り合おうとする感じの内容の漫画をお願い致します。\n(折角紘はアニメで子供の頃の姿が見れる一方、学生時代の凪との絡みはないので)\n\n描きにくい内容でしたら他の題材でも構いません。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/19", "thumbnail_src": "https://si.imgix.net/7f627ffa/uploads/origins/cd5db8b1-56c6-421f-b990-e08010166ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d936d24fb7a9ca8d0a8a3a9f2f65f2", "thumbnail_srcset": "https://si.imgix.net/7f627ffa/uploads/origins/cd5db8b1-56c6-421f-b990-e08010166ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d936d24fb7a9ca8d0a8a3a9f2f65f2, https://si.imgix.net/7f627ffa/uploads/origins/cd5db8b1-56c6-421f-b990-e08010166ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24db01a3bd4b108a5d1b19b0fdf61177 2x, https://si.imgix.net/7f627ffa/uploads/origins/cd5db8b1-56c6-421f-b990-e08010166ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=377060b2d23867e8db6224f3067e688f 3x", "genre": "art", "nsfw": false, "body": "★弥様さんサク刻クリアツイートをお見かけいたしまして\n前回のリベンジをさせていただければと思います！\n\n依頼しますのはサクラノ刻の恩田寧ちゃんと本間心鈴ちゃんとうちの子である柄葉五鈴(つかは いすず)ちゃんとのコラボ作品です！\n\n世界線としてはサク刻の3章(心鈴ルート)の次元でお願いできればと\n\n3人の格好は制服で\n五鈴ちゃんの格好はノノ未ちゃんや前作品サクラノ詩の氷川里奈ちゃんのような弓張の制服に黒のパンスト着用でお願いできればと思います！\n\n構図としては\nザッパに言うと\n3人が絵を描いているというのでお願いします！\n\n\n\n資料\n\nhttps://www.dropbox.com/sh/n25k8h7d0p15i3k/AABHwRn8lapnDSQT9iIQbTKPa?dl=0\n\n\n五鈴ちゃん\n\nhttps://www.dropbox.com/sh/ry67ocwtc20fgy8/AACve8MF2Y9B5RILo_RFvaeKa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/18", "thumbnail_src": "https://si.imgix.net/0e83b583/uploads/origins/64f0e027-839c-4542-84df-848e5c81fdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1749c711034e1eb0b88915d11d84c1b", "thumbnail_srcset": "https://si.imgix.net/0e83b583/uploads/origins/64f0e027-839c-4542-84df-848e5c81fdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1749c711034e1eb0b88915d11d84c1b, https://si.imgix.net/0e83b583/uploads/origins/64f0e027-839c-4542-84df-848e5c81fdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d09c5b1eb408869ff1cb053d829f2e0 2x, https://si.imgix.net/0e83b583/uploads/origins/64f0e027-839c-4542-84df-848e5c81fdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c2ff58a521bfd4ac6a482113f771db0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hoshi_wataru/works/17", "thumbnail_src": "https://si.imgix.net/da52faef/uploads/origins/659c04c0-4a2b-4cea-9a3f-a322b306e2b5?bg=%23fff&