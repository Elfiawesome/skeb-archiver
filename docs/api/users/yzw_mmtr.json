=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14306eaaf384f6d0ec5ff9bc31f976d3 2x, https://si.imgix.net/dd59233e/uploads/origins/e47e1f6c-4c5c-4678-8a91-9d8d1cf9cd22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a358d854a5a487daf468d0a493da1f2b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yzw_mmtr/works/473", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/551ac7bc/uploads/origins/c19ec8ec-7a8b-4cf1-9d69-177739d49714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c3fb06ac56f6057e1886293f41c973", "thumbnail_srcset": "https://si.imgix.net/551ac7bc/uploads/origins/c19ec8ec-7a8b-4cf1-9d69-177739d49714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c3fb06ac56f6057e1886293f41c973, https://si.imgix.net/551ac7bc/uploads/origins/c19ec8ec-7a8b-4cf1-9d69-177739d49714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66a74d6612d7be0e4164456556c4dbe3 2x, https://si.imgix.net/551ac7bc/uploads/origins/c19ec8ec-7a8b-4cf1-9d69-177739d49714?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25b099ce78262b9d51eb240cbe1fa987 3x", "genre": "art", "nsfw": false, "body": "ff14の猫の女の子を描いてほしいです！彼女は青みがかったグレーの肌をしています！手のひらと指先の内側にピンクのチークが入っています。彼女はエレガントだけど、内心は生意気なんだ！\n\nhttps://imgur.com/a/ZdmIz2Q", "created_at": "", "completed_at": ""}, {"path": "/@yzw_mmtr/works/472", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/9b7610d4/uploads/origins/f5e9f73a-4f3b-4b27-a539-326b59ce4d62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57110f22a4d0910042841968aa497015", "thumbnail_srcset": "https://si.im