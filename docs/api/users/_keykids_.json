imgix.net/0f7b3826/uploads/origins/4b3ee37b-f27d-4105-85b7-262739af960a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad160c25300780039343ce207e426506 2x, https://si.imgix.net/0f7b3826/uploads/origins/4b3ee37b-f27d-4105-85b7-262739af960a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af6935eeed46bb830d4af43b08631239 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n最近投稿された作品が気に入りました：\nhttps://x.com/_keykids_/status/1888535824863809871?t=zspXUGEe68S2i6YWnPHu5A&s=19\n\n\n私のキツネのOCを同じか似たようなポーズとシチュエーションで描いていただけませんか？\n\nアクセサリーと靴下以外は服なし。\nとてもふわふわした胸！\n髪は下ろして（ポニーテールはほどいて）描いてください。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1FP48ZcNt25X-weZ5iSkOZYMqXc-86uBj", "created_at": "", "completed_at": ""}, {"path": "/@_keykids_/works/79", "thumbnail_src": "https://si.imgix.net/2eb90c11/uploads/origins/9e60656f-ac77-4ae5-8961-4bc7b22382e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1cae73a870501411d801f0962bc8dd5", "thumbnail_srcset": "https://si.imgix.net/2eb90c11/uploads/origins/9e60656f-ac77-4ae5-8961-4bc7b22382e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1cae73a870501411d801f0962bc8dd5, https://si.imgix.net/2eb90c11/uploads/origins/9e60656f-ac77-4ae5-8961-4bc7b22382e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50f39f5c512940e8e5bf635607738725 2x, https://si.imgix.net/2eb90c11/uploads/origins/9e60656f-ac77-4ae5-8961-4bc7b22382e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6232aa57b2ade7a51cf0344eba3ffd11 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのスタイルは本当にクールでキュートですね！あなたのスタイルで私のドラゴンのキャラクターを見てみたいです！座っているか、尻尾の上に寝ているか、遊び心のある表情で描いていただけませんか？また、おなかが少し見えるようなかわいい服を着せてもいいかもしれません！ありがとうございました！\n\nhttps://drive.google.com/file/d/1S0YIkVAaddohT7zLL0mF7vJ9lMw4VkFz/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@_keykids_/works/78", "thumbnail_src": "https://si.imgix.net/e6eb519d/uploads/origins/c553b800-29c0-4aef-86de-e8304f904e76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca109ca411b5c403e9e3eb322995f12", "thumbnail_srcset": "https://si.imgix.net/e6eb519d/uploads/origins/c553b800-29c0-4aef-86de-e8304f904e76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca109ca411b5c403e9e3eb322995f12, https://si.imgix.net/e6eb519d/uploads/origins/c553b800-29c0-4aef-86de-e8304f904e76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4bea0dc5eb4144bd715ff033114154f 2x, https://si.imgix.net/e6eb519d/uploads/origins/c553b800-29c0-4aef-86de-e8304f904e76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71bc0e5785a7fc0213c15f78c4f5e16b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回依頼してからしばらく経ちますが、私のオス猫のキャラクターとメスのキツネ猫のキャラクターの2キャラのフルボディを依頼したいです。彼らはカップルで、とても愛し合っています。雄猫のザイラーは、紫狐猫のノーリーに憧れられるようにしたいです。ザイラーはたくましく健康的なキャラクターなので、たくましく引き締まった腕を見せつけてほしいです。彼は運動神経がいいので、もう片方の腕でノリーを包み込むように抱きながら、腕を曲げるポーズをとってほしいです。ザイラーの表情は自信と愛の表情で、ノリーの表情は称賛と愛です。ノリーの胸は平らで、瞳の色はリファレンスシートと同じです。背景は、寝室で一緒にいる二人です。\nhttps://drive.google.com/file/d/1M1-VxY2ZkzOCOesio8WYTpg_NvWELOUp/view?usp=sharing\n\nhttps://drive.google.com/file/d/1Q4i2TYvOBt1bv9CRaxXUfrY9aU5Wn6ns/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@_keykids_/works/77", "thumbnail_src": "https://si.imgix.net/ec5796ec/uploads/origins/96b9d7fd-81a2-438a-9eb1-a78d93018b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46bcdfe9edc97ec392e0551ba34f376a", "thumbnail_srcset": "https://si.imgix.net/ec5796ec/uploads/origins/96b9d7fd-81a2-438a-9eb1-a78d93018b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46bcdfe9edc97ec392e0551ba34f376a, https://si.imgix.net/ec5796ec/uploads/origins/96b9d7fd-81a2-438a-9eb1-a78d93018b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e8831051d576375d8efc6dfb95