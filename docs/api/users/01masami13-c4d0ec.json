145-a788-4a7c-96b6-77e0b06cd6a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac4cb8fac5e14e30b3c156dc47c50ac", "thumbnail_srcset": "https://si.imgix.net/64d6d94a/uploads/origins/0a775145-a788-4a7c-96b6-77e0b06cd6a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac4cb8fac5e14e30b3c156dc47c50ac, https://si.imgix.net/64d6d94a/uploads/origins/0a775145-a788-4a7c-96b6-77e0b06cd6a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4893772791ba58bfafacecbcc94601d2 2x, https://si.imgix.net/64d6d94a/uploads/origins/0a775145-a788-4a7c-96b6-77e0b06cd6a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a08d8db9602a585959d357bfe4549fad 3x", "genre": "art", "nsfw": false, "body": "可能であればギルティクラウンの楪いのりっぽさがあって、髪色は明楽レイさんやせやなせやさんに近い色、服装は上はオフショルダーニット（白色）だとありがたいです。\n初めてのリクエストなのでなにか不都合があれば自由に変更してもらって構いません！よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@01masami13/works/2", "thumbnail_src": "https://si.imgix.net/d88d9717/uploads/origins/c2b37494-e324-44f1-876a-be8714d7d4da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03b287c5e76bba81915f71763a006dfb", "thumbnail_srcset": "https://si.imgix.net/d88d9717/uploads/origins/c2b37494-e324-44f1-876a-be8714d7d4da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03b287c5e76bba81915f71763a006dfb, https://si.imgix.net/d88d9717/uploads/origins/c2b37494-e324-44f1-876a-be8714d7d4da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1777ee9b352e240592c055b8ddc09a15 2x, https://si.imgix.net/d88d9717/uploads/origins/c2b37494-e324-44f1-876a-be8714d7d4da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9942bfe36679667d8cd00d23fe717958 3x", "genre": "art", "nsfw": false, "body": "JKせやな(セーラー服ではなく、スカート短め、黒か紺のハイソックス(膝下)。こちらももし全身を描いていただけるならの話ですが、靴は履いてない状態でこちらは爪先まであると嬉しいです。素足でなければ全部好きなので。こちらも背景はなくても大丈夫です。あとはお任せでよろしくお願い致します。何度も本当