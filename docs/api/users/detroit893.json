から竿を出して、その竿にはリードの持ち手の部分が根本までかかっている状態\n\n大体こんな感じの構想ですね…\nそこから…\n\n①頭を撫でられながらチンポを嗅がされ絶頂\n\n②次にイボイボのドリルバイブで尿道を処刑\n(ドリルバイブを持っている手はえぐるように揺らす)\n\n③激しく絶頂\n\n④ドリルバイブを引き抜き、開きっぱなしになった穴からおしっこや潮が垂れ流し\n\nで終わりです\n陰毛は無しでお願いします。\n\n色は出来れば塗ってほしいですが気分でお願いします。\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@detroit893/works/12", "thumbnail_src": "https://si.imgix.net/c1662977/uploads/origins/c48ac5ad-9913-4e45-a17b-de06582d0129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21fdfb6c74b8d83aa5796157596133f6", "thumbnail_srcset": "https://si.imgix.net/c1662977/uploads/origins/c48ac5ad-9913-4e45-a17b-de06582d0129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21fdfb6c74b8d83aa5796157596133f6, https://si.imgix.net/c1662977/uploads/origins/c48ac5ad-9913-4e45-a17b-de06582d0129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ef38131d94e83bbfd0dd3e30cbce5f4 2x, https://si.imgix.net/c1662977/uploads/origins/c48ac5ad-9913-4e45-a17b-de06582d0129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1deb5ca456fea6015141f18dbaf3b92 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@detroit893/works/11", "thumbnail_src": "https://si.imgix.net/2ae3123e/uploads/origins/b702c3d0-1ec0-49f1-851d-b527e3b5d854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c5de4f98c56003ccf6db90094069b65", "thumbnail_srcset": "https://si.imgix.net/2ae3123e/uploads/origins/b702c3d0-1ec0-49f1-851d-b527e3b5d854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro