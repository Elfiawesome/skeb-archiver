は断っていただいて構いません…！ \n\nこれからももなここあさんのイラストや活動を応援しております！\nお読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/mobile/folders/1ZLWYymyhiC5Eypo48jTRxliV9AtlVHSm?sort=13&direction=a", "created_at": "", "completed_at": ""}, {"path": "/@Monakocoa/works/39", "thumbnail_src": "https://si.imgix.net/affccb4e/uploads/origins/055b74f0-4b00-454a-a2a8-dfed300c586a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99d0ea000c1841d00535af8c7f2a6338", "thumbnail_srcset": "https://si.imgix.net/affccb4e/uploads/origins/055b74f0-4b00-454a-a2a8-dfed300c586a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99d0ea000c1841d00535af8c7f2a6338, https://si.imgix.net/affccb4e/uploads/origins/055b74f0-4b00-454a-a2a8-dfed300c586a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17664bd75f4465f6e6d418da2055fc57 2x, https://si.imgix.net/affccb4e/uploads/origins/055b74f0-4b00-454a-a2a8-dfed300c586a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=742fd3c3c32e8dcc2f9ef0ea584506bc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Monakocoa/works/38", "thumbnail_src": "https://si.imgix.net/16901a6e/uploads/origins/c7cc76a3-1693-47eb-a2fc-93029b7e5bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e259d10126272eea7642249db931846", "thumbnail_srcset": "https://si.imgix.net/16901a6e/uploads/origins/c7cc76a3-1693-47eb-a2fc-93029b7e5bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e259d10126272eea7642249db931846, https://si.imgix.net/169