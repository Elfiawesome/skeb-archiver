したのでご確認ください！\n（衣装が2パターンありますが、今回は「通常衣装」にてお願いできれば幸いです。)\n\nhttps://drive.google.com/drive/folders/1UU-mk3HV_m5M7K4BliEh9udYsXoLxmk4\n\nhttps://drive.google.com/drive/folders/1UU-mk3HV_m5M7K4BliEh9udYsXoLxmk4", "created_at": "", "completed_at": ""}, {"path": "/@yoshina0001/works/25", "thumbnail_src": "https://si.imgix.net/d91dfd3b/uploads/origins/2d2ef9b7-d049-4a06-aca2-c1832cb27a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b69cda81f6f3ee3cf7fa6a290f0d236", "thumbnail_srcset": "https://si.imgix.net/d91dfd3b/uploads/origins/2d2ef9b7-d049-4a06-aca2-c1832cb27a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b69cda81f6f3ee3cf7fa6a290f0d236, https://si.imgix.net/d91dfd3b/uploads/origins/2d2ef9b7-d049-4a06-aca2-c1832cb27a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60ee624d1e445c9276074decceb94eb1 2x, https://si.imgix.net/d91dfd3b/uploads/origins/2d2ef9b7-d049-4a06-aca2-c1832cb27a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be7f9dffcd1636b11145c4c32602a224 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yoshina0001/works/24", "thumbnail_src": "https://si.imgix.net/6b66e4cb/uploads/origins/f858fc68-0515-4fa9-aa5d-8724345b7f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d22636089781989ee89871fac7216a7", "thumbnail_srcset": "https://si.imgix.net/6b66e4cb/uploads/origins/f858fc68-0515-4fa9-aa5d-8724345b7f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d22636089781989ee89871f