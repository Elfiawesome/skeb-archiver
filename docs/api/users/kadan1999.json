2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a353900a2d0e783d5435fbd74242590 2x, https://si.imgix.net/824aa040/uploads/origins/0dff900e-fc74-484c-882d-b7ddfae5e274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4952a56e066e1acf4beec427b8177328 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼します。\n\n私の小説のキャラでイラストを描いて欲しいです。\n黒髪ロングでおっぱい長くて乳輪黒い、おまんこびらびら、アナルともに使い込まれててグロい以外特にデザイン固まっておりませんが、母子相姦腹ボテアナルセックスが見てみたいです。\nご検討のほどよろしくお願いします。\n\nhttps://www.pixiv.net/novel/show.php?id=24199999", "created_at": "", "completed_at": ""}, {"path": "/@kadan1999/works/4", "thumbnail_src": "https://si.imgix.net/ca0f0ba0/uploads/origins/78865452-e0e8-4c0e-8b5d-1edbde6fc436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=071af7b1573c1af63424884912ac6839", "thumbnail_srcset": "https://si.imgix.net/ca0f0ba0/uploads/origins/78865452-e0e8-4c0e-8b5d-1edbde6fc436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=071af7b1573c1af63424884912ac6839, https://si.imgix.net/ca0f0ba0/uploads/origins/78865452-e0e8-4c0e-8b5d-1edbde6fc436?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e9779ce74fd0ab1f64bd1fd8a833c16 2x, https://si.imgix.net/ca0f0ba0/uploads/origins/78865452-e0e8-4c0e-8b5d-1edbde6fc436?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4ba64f17f3339301ff100eb9597364d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kadan1999/works/3", "thumbnail_src": "https://si.imgix.net/c773979f/uploads/origins/67fee3d7-5ab1-464e-8655-55462141fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95a031a5447c29b3aa6cd56dbc3ec9a", "thumbnail_srcset": "https://si.imgix.net/c773979f/uploads/origins/67fee3d7-5ab1-464e-8655-55462141fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95a031a5447c29b3aa6cd56dbc3ec9a, https://si.imgix.net/c773979f/uploads/origins/67fee3d7-5ab1-464e-8655-55462141fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfb50b846a3fe5370e3dc289345f5370 2x, https://si.imgix.net/c773979f/uploads/origins/67fee3d7-5ab1-464e-8655-55462141fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b360b4aaeab78d731188c6a910402a7 3x", "genre": "art", "nsfw": true, "body": "カダンさんが昔投稿したイラスト（pixiv 43296911）の小うるさい女教師を描いていただきたいです。\n好奇心任せに好き放題され続けた結果、犯乳首は黒ずみ、マンコもビラビラになったうえ、乳首周りやマンコ周りをピアスだらけにされて絶望しきった女教師が、だらしのない身体を記念撮影されて喜ぶという感じです。\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kadan1999/works/2", "thumbnail_src": "https://si.imgix.net/5057e68c/uploads/origins/5dc93385-038a-4713-aa06-e51d300e1318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597b18a079e1e7a8e87960733930cf93", "thumbnail_srcset": "https://si.imgix.net/5057e68c/uploads/origins/5dc93385-038a-4713-aa06-e51d300e1318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597b18a079e1e7a8e87960733930cf93, https://si.imgix.net/5057e68c/uploads/origins/5dc93385-038a-4713-aa06-e51d300e1318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8681bc236d1af2ca0eaacf26538f83b4 2x, https://si.imgix.net/5057e68c/uploads/origins/5dc93385-038a-4713-aa06-e51d300e1318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=794b1101c04a943b131294533cefdbdb 3x", "genre": "art", "nsfw": true, "body": "以下内容でよろしければ、\nお受け頂ければと思います。\n\n【キャラクター/設定】\nhttps://www.pixiv.net/artworks/108942540\n↑の親子\n\n【シチュエーション】\n催眠状態の母に口内射精\n\n・親子ともの全裸\n・母の口からは精液が零れ落ち胸にもかかっている\n・息子は、いつもガミガミ言葉を吐く母の口に精液を流し込む背徳感に酔いしれている。\n　・母に射精するのは今回が初めて。母の巨乳に欲情しており前々からヤりたいと思っていた。\n・適当にセリフを付けてもらえれば", "created_at": "", "completed_at": ""}, {"path": "/@kadan1999/works/1", "thumbnail_src": "https://si.imgix.net/230999a6/uploads/origins/dfb7c77b-9cb1-4add-8d62-baeade243d77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c3376070d2b8388db3d874aee615a94", "thumbnail_srcset": "https://si.imgix.net/230999a6/uploads/origins/dfb7c77b-9cb1-4add-8d62-baeade243d77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c3376070d2b8388db3d874aee615a94, https://si.imgix.net/230999a6/uploads/origins/dfb7c77b-9cb1-4add-8d62-baeade243d77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=813390bff94b8eb6605bfe3777ced0ab 2x, https://si.imgix.net/230999a6/uploads/origins/dfb7c77b-9cb1-4add-8d62-baeade243d77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1e6f3510992f0e9cc4ca6dcf7ba1007 3x", "genre": "art", "nsfw": true, "body": "私はあなたの仕事が大好きです！\n\n提案からの変更は問題ありません！\n\nキャラクター\n息子\n-翔太\n母\n-背が高い\n-痩せ型（胸が小さい＋お尻がある）\n-お団子ヘア？\n両方\n-同じ髪色＋目の色（ブロンドではない）\n\n家事をしている母親\n息子がタブレットでファンタジー・デート・ゲームをしているのに気づく母親\nスクリーンに映し出された金髪のエルフの美少女\n母親は、この種のゲームは不健康だと言う\n本物の女の子と話すべきだ\n息子は「考えてみる」と言う\n\n30分後：\n息子が新しいアプリの機能を起動\nバストアップしたエルフに変身したママはショックを受ける。\nとても大きな胸とお尻、広いヒップ（ウエストは細いまま）\nエルフの耳\nママは元の髪の色のままだが、お団子がほどける（髪の長さが丸見えになる）\n新しいスケスケのエルフの衣装（ビキニの鎧、チョーカー、太もものブーツ、指なしの肘の手袋）\n息子は、これで本当の彼女ができたと嬉しそうに言う。\n母親は抗議し、こんなつもりじゃなかったと言う。\n\n最終ページ\n息子は新しいエルフのママを精力的に犯す（後背位？）\nママは怒る（でも興奮もする）\n母親はまだ服を着ている（ビキニ以外）\n陰毛なし", "created_at": "", "completed_at": ""}]}