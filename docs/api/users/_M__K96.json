4860-a28c-5cb4fa94b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b6fe9cc84c077f1a37a23d3e1c2df3f", "thumbnail_srcset": "https://si.imgix.net/86907d24/uploads/origins/903c1ea7-de32-4860-a28c-5cb4fa94b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b6fe9cc84c077f1a37a23d3e1c2df3f, https://si.imgix.net/86907d24/uploads/origins/903c1ea7-de32-4860-a28c-5cb4fa94b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=095adf3b78167d62000d28c54ed1b9c7 2x, https://si.imgix.net/86907d24/uploads/origins/903c1ea7-de32-4860-a28c-5cb4fa94b7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=748e7cb3fde637ca307e9f01c872da92 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_M__K96/works/19", "thumbnail_src": "https://si.imgix.net/9bbfed18/uploads/origins/dd6ef015-e542-4da0-b5c6-22481c2d3d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b11f2c2f221d2a8ed601cc5419ad8081", "thumbnail_srcset": "https://si.imgix.net/9bbfed18/uploads/origins/dd6ef015-e542-4da0-b5c6-22481c2d3d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b11f2c2f221d2a8ed601cc5419ad8081, https://si.imgix.net/9bbfed18/uploads/origins/dd6ef015-e542-4da0-b5c6-22481c2d3d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adb42f221add16464f65d785708fc1ee 2x, https://si.imgix.net/9bbfed18/uploads/origins/dd6ef015-e542-4da0-b5c6-22481c2d3d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fee71c2e769231a189c0e89cab36489c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！柏木ﾏﾒさんの素敵な作品に惹かれまして、TRPGキャラクターをお願いしたいです！\n\n二人は共に捜査一課の刑事です。\n一人目(太刀川 靖之)身長178cm 白練の色の長髪で、目は紫味の冴えた青です。正義感の強い人として仕事に熱心に組み取り、優しくて信頼できるようなイメージです。正義の味方である自分も好きですが、実は犯罪者を必ず殺すとのような殺人癖を持っているゆえ、要注意人物として公安である八重間に監視されていた。\n\n二人目(八重間 信咫)身長189cm 深青色の髪、目は灰色です。黒い手袋が特徴です。誰にでも冷たい態度、クールで無表情ですが、頼りになる人です。彼は仕事の鬼、濃縮コーヒーを沢山用意しています。歪んだ信念を持つ太刀川に同情し、特別扱いをしています。表には出さないが、相手を大切にしています。\n八重間はいざという時に太刀川を始末する役割を担うが、相手が怪我をしても心配するようになっていた。太刀川を殺しそうになった自分は合わせる顔がないことになった。太刀川はそれを知っています。\n\n午後に二人はフラペチーノ(太)/ブラックコーヒー(八)を持って暇そうに見えるシーンが見たいです。具体的な構図などはお任せいたします。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-2fVVB3gyCV3FYeJwzP8mIY3vc0Q4W21", "created_at": "", "completed_at": ""}, {"path": "/@_M__K96/works/18", "thumbnail_src": "https://si.imgix.net/34140e65/uploads/origins/07a62a9a-e2d7-4885-9324-8014c430f974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6917154c923505f47a208657bbcf5088", "thumbnail_srcset": "https://si.imgix.net/34140e65/uploads/origins/07a62a9a-e2d7-4885-9324-8014c430f974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6917154c923505f47a208657bbcf5088, https://si.imgix.net/34140e65/uploads/origins/07a62a9a-e2d7-4885-9324-8014c430f974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3646d84ff03a6d6fccd9984c42a4416b 2x, https://si.imgix.net/34140e65/uploads/origins/07a62a9a-e2d7-4885-9324-8014c430f974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6ff8568ee9a0355b0668ae960426ed6 3x", "genre": "art", "nsfw": false, "body": "初めまして、絵柄に一目惚れしてリクエストを送信させていただきます。\n私と友人の探索者を描いて頂きたいです。\n\n刑事の2人で、黒と赤髪の方が班長、黒髪の髪が長い方が班のブレインです。\n\n雨のが降る中、人のいないバス停で2人会話している構図でお願いします。\n班長は混乱したような、焦ったような表情、ブレインは真顔で淡々としている表情。どちらもここではタバコを吸っていません。\n\nURLに参考画像があります。\n\nhttps://drive.google.com/drive/folders/1-7kx2ue4M0UnwzCPLXn81a6S7NMMxKt1", "created_at": "", "completed_at": ""}, {"path": "/@_M__K96/works/17", "th