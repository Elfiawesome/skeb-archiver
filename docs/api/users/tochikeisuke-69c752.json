81e-a5c7-2784d3ec6990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c07043cd77eb7594a89832a315319e53 2x, https://si.imgix.net/70f608d0/uploads/origins/33dfe1f1-26db-481e-a5c7-2784d3ec6990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a9a490e807eb11d8c209ba550f42558 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tochikeisuke/works/175", "thumbnail_src": "https://si.imgix.net/9a1696b8/uploads/origins/f6a4a21e-4a3e-48d6-92cb-9ca159d883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61acfd34aae6ee6a08a01f612e1fd1a6", "thumbnail_srcset": "https://si.imgix.net/9a1696b8/uploads/origins/f6a4a21e-4a3e-48d6-92cb-9ca159d883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61acfd34aae6ee6a08a01f612e1fd1a6, https://si.imgix.net/9a1696b8/uploads/origins/f6a4a21e-4a3e-48d6-92cb-9ca159d883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=059eb070ff3c5df786a62571c5848f87 2x, https://si.imgix.net/9a1696b8/uploads/origins/f6a4a21e-4a3e-48d6-92cb-9ca159d883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e5b1b959d1b071841281240b4299380 3x", "genre": "art", "nsfw": false, "body": "前回はありがとうございました。手が飛び出してくるような迫力がお気に入りです。ポーズもちょっと命令者ちゃんみたいで好きだったりします。髪の裏が紫でグラデーションかかってるのも映えてます。\n\nというわけでまたボーダーブレイクのクゥ・ラルツァを依頼します。\n構図とシチュエーションはお任せします。前回と差別化を図りつつ、前回みたいなかっこいいイラストが嬉しいです。あんなかっこよくなるアイデアを阻害したくないのでお題が出せないです。お任せします。\n\n使用用途はスマホとiPadとパソコンの壁紙にして喜びます。感想を言語化する能力が復活したらTwitterでも喜びます。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tochikeisuke/works/174", "thumbnail_src": "https://si.imgix.net/b093dbb8/uploads/origins/c5d87118-2468-41f9-8146-7d38d84e32ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd49448cdaf02a1242eaa8d1ecea12e", "thumbnail_srcset": "https://si.imgix.net/b093dbb8/uploads/origins/c5d87118-2468-41f9-8146-7d38d84e32ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd49448cdaf02a1242eaa8d1ecea12e, https://si.imgix.net/b093dbb8/uploads/origins/c5d87118-2468-41f9-8146-7d38d84e32ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fe9bb2fe8dbb54e0b95226d24660975 2x, https://si.imgix.net/b093dbb8/uploads/origins/c5d87118-2468-41f9-8146-7d38d84e32ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6b9c22d38cb2f42e5deb39eec95a39c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！元気でやってるかな？僕のOCの一人のために、ちゃんとしたアートを手に入れたいと思っていたんだ！自由にしていいよ！\n\nAvonleahメインリファレンス[衣装]: https://drive.google.com/file/d/12UbZ8l_YXBVLkZkih0naPcIJ0Aof-krn/view?usp=drive_link\n完全参考ギャラリー：https://drive.google.com/drive/folders/10ZxZ9-6kgatM88bDGLAVqFEufg-_Ox9F?usp=drive_link\n衣装の特徴体にフィットした服と儀式用/装飾用の服の組み合わせ。スタイルがミスマッチな長袖。片方の袖は上部が少し \"羽のよう \"で、もう片方の袖は上部がよりゴールド/メタリック。太ももが見えるハイブーツ。色は黒と薄いブルーの組み合わせで、鎖骨のあたりに濃いブルーの要素があり、ゴールドも混ざっている。青い髪留めは省くが、リボンは残す。\nその他の特徴ストーム・キネシス（鋭い風として現れるが、接触すると感電することもある）。\n性格断固とした態度、慇懃無礼、野心家\n\nポーズやフレーミングは何でもいい。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@tochikeisuke/works/173", "thumbnail_src": "https://si.imgix.net/507c19e8/uploads/origins/3204a9f7-c561-4fdc-b296-14a6a1565d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc3d089f7ca23b6ac51409e2c9afa85a", "thumbnail_srcset": "https://si.imgix.net/507c19e8/uploads/origins/3204a9f7-c561-4fdc-b296-14a6a1565d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc3d089f7ca23b6ac51409e2c9afa85a, https://si.imgix.net/507c19e8/u