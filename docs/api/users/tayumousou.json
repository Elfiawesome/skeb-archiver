9994\n\n以下は希望のシチュエーションです。(可能な部分でだけ大丈夫です)\n・どろどろに精液を注がれる徹ちゃん。\n・勢いよく腰を叩きつけてる描写。\n・男の子が発情しきっていて、がっついてる雰囲気。\n・猫耳男子君のお尻がよく見える構図。\n\n以上になります、よろしくお願いいたします。\n\nhttps://misskey.io/notes/9iirtt3qsy", "created_at": "", "completed_at": ""}, {"path": "/@tayumousou/works/43", "thumbnail_src": "https://si.imgix.net/33a8906d/uploads/origins/d5a7aefc-e7a0-435d-a76f-09dfb77c1e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b84b8c917ecab1ceea5025e346c6b34", "thumbnail_srcset": "https://si.imgix.net/33a8906d/uploads/origins/d5a7aefc-e7a0-435d-a76f-09dfb77c1e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b84b8c917ecab1ceea5025e346c6b34, https://si.imgix.net/33a8906d/uploads/origins/d5a7aefc-e7a0-435d-a76f-09dfb77c1e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abc1a5595fef99a841f410232e19a01f 2x, https://si.imgix.net/33a8906d/uploads/origins/d5a7aefc-e7a0-435d-a76f-09dfb77c1e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e4ab1aa9b37ffd057211ec9c9c75a93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tayumousou/works/42", "thumbnail_src": "https://si.imgix.net/1d605707/uploads/origins/dcd98efa-062b-4d76-8979-37eb7ec7eb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1e0029b7c64897a49209510fd88255", "thumbnail_srcset": "https://si.imgix.net/1d605707/uploads/origins/dcd98efa-062b-4d76-8979-37eb7ec7eb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1e0029b7c64897a49209510fd88255, https://s