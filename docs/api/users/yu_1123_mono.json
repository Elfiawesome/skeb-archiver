選択は自由です。ご自身が最適と感じる表現をどうぞお選びください。完成を楽しみにしています！ https://imgur.com/a/nelverra-ref-fOoNya7", "created_at": "", "completed_at": ""}, {"path": "/@yu_1123_mono/works/198", "thumbnail_src": "https://si.imgix.net/7e8d2ef0/uploads/origins/25bad25c-01d1-4024-8657-40f110f813df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662215123d744e2f533ecda8357b035d", "thumbnail_srcset": "https://si.imgix.net/7e8d2ef0/uploads/origins/25bad25c-01d1-4024-8657-40f110f813df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662215123d744e2f533ecda8357b035d, https://si.imgix.net/7e8d2ef0/uploads/origins/25bad25c-01d1-4024-8657-40f110f813df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0405ea95927ed506e22df60b7f332cf 2x, https://si.imgix.net/7e8d2ef0/uploads/origins/25bad25c-01d1-4024-8657-40f110f813df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55cec8c1bed3d03b2b843e2258fa0148 3x", "genre": "art", "nsfw": false, "body": "Hello! Could I request art of my oc?\n\nhttps://drive.google.com/drive/folders/1KOecpH5JJjzf0KtzGF7EqgBWGarsUaKp", "created_at": "", "completed_at": ""}, {"path": "/@yu_1123_mono/works/197", "thumbnail_src": "https://si.imgix.net/84cd3051/uploads/origins/45ce3105-db72-4ca9-827f-6cd6a1605d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01c35d3551b320ac1cbb9198546eb4e7", "thumbnail_srcset": "https://si.imgix.net/84cd3051/uploads/origins/45ce3105-db72-4ca9-827f-6cd6a1605d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01c35d3551b320ac1cbb9198546eb4e7, https://si.imgix.net/84cd3051/uploads/origins/45ce3105-db72-4ca9-827f-6cd6a1605d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75c26ca2c01db68c1b0b3301d8e8aaa7 2x, https://si.imgix.net/84cd3051/uploads/origins/45ce3105-db72-4ca9-827f-6cd6a1605d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b508