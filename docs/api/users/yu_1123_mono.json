e90948f0548eb071c6d 2x, https://si.imgix.net/e31fdfcd/uploads/origins/47deed9a-8d3b-4906-b57c-780d15cc3262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f31ce9d1f7eb69a44c6d81344af42ec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yu_1123_mono/works/189", "thumbnail_src": "https://si.imgix.net/9a70f4a2/uploads/origins/e22d6b48-a637-4113-a464-707c2a33c24f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1bda015f462ed0dda775ff25354db7", "thumbnail_srcset": "https://si.imgix.net/9a70f4a2/uploads/origins/e22d6b48-a637-4113-a464-707c2a33c24f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1bda015f462ed0dda775ff25354db7, https://si.imgix.net/9a70f4a2/uploads/origins/e22d6b48-a637-4113-a464-707c2a33c24f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd880997cf562c69a8d6882d3307997c 2x, https://si.imgix.net/9a70f4a2/uploads/origins/e22d6b48-a637-4113-a464-707c2a33c24f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f324d232ff1eeaa1d6bef8ce9adb3c5b 3x", "genre": "art", "nsfw": false, "body": "この悪役の衣装を着たコギャル娘を描いていただけますか？\n\n女の子：https://www.deviantart.com/stash/2294n3l4fx1v\n\n悪役の衣装：https://www.deviantart.com/stash/01s1z4pmquiv\n\nこの少女は肩まで届く茶色の髪を、シュシュでまとめたサイドポニーテールにしています。\n\n身長と体重は平均的で、バストはミディアムです。", "created_at": "", "completed_at": ""}, {"path": "/@yu_1123_mono/works/188", "thumbnail_src": "https://si.imgix.net/b4aec3cb/uploads/origins/238acb35-2df3-4c63-8ca9-500fbb13e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ce417142e6c4a8ad86e7d1f3be0e44", "thumbnail_srcset": "https://si.imgix.net/b4aec3cb/uploads/origins/238acb35-2df3-4c63-8ca9-500fbb13e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ce417142e6c4a8ad86e7d1f3be0e44, https://si.imgix.net/b4aec3cb/uploads/origins/238acb35-2df3-4c63-8ca9-500fbb13e555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b342c9edae5a5ddb699581ee41e178a6 2x, https://si.imgix.net/b4aec3cb/uploads/origins/238acb35-2df3-4c63-8ca9-500fbb13e555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06ba19b152aaf42c2977fda99030f525 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n友人のキャラクター、柔術海戦の七海健人のイラストをお願いしたいです。\n\n友人のキャラクターの参考資料\n\nhttps://storage.ko-fi.com/cdn/useruploads/display/51bf66d3-63c0-4011-90bd-e56cf1d01f00_export121.png\n\nhttps://pbs.twimg.com/media/GyFepYjbIAAzWnY?format=jpg&name=large\n\nhttps://pbs.twimg.com/media/Gu3cA5sWQAk7HvR?format=jpg&name=large\n\n七海健人の参考文献\n\nhttps://static.wikia.nocookie.net/versus-connections/images/3/32/Dgo25yz-2fbaca54-7de9-49c0-b399-1e4b67a6a002.png/revision/latest/scale-to-width-down/692?cb=20240108063725\n\nhttps://i.pinimg.com/736x/91/b6/40/91b640c6436fe9caa4f59d1c1b98c977.jpg\n\nロマンチックなポーズをとってほしいです。例えば、菜々緒が友達のキャラクターを抱きしめて持ち上げたり、雨の中で二人で傘をさしたり。\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@yu_1123_mono/works/187", "thumbnail_src": "https://si.imgix.net/0ea1619d/uploads/origins/1658c1e9-7c3c-4398-b4f8-078d63a36252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c634cc6371e95b8297ce58cd70494027", "thumbnail_srcset": "https://si.imgix.net/0ea1619d/uploads/origins/1658c1e9-7c3c-4398-b4f8-078d63a36252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c634cc6371e95b8297ce58cd70494027, https://si.imgix.net/0ea1619d/uploads/origins/1658c1e9-7c3c-4398-b4f8-078d63a36252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6f6041bb4ce018037a3b653b152d198 2x, https://si.imgix.net/0ea1619d/uploads/origins/1658c1e9-7c3c-4398-b4f8-078d63a36252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8c73ad00d82b6398c85f99f878e6ec 3x", "genre": "art", "nsfw": false, "body": "Please draw my OCs?\nA:\"https://drive.google.com/drive/folders/1D7-ZRSejcyCHLr-rsMH5SeF-96xOdlfy\"\nB:\"https://drive.google.com/drive/folders/1rUENhktpBwV3wW0taxNdJlxXB5k29V-Y\"\n「A」は上司である。年上で、より落ち着きがあり、行動が定まっている。彼は「B」を有能な部下と見なし、その立場を十分に果たすと信頼している。能力と人柄の両方に対する信頼がある。「A」と「B」は似たような世界観を共有しているが、それを表現する方法は異なる。\n「A」は「B」に対する自身の感情をあまり自覚していない。意識的には彼女を風変わりだが有能な存在と見なし、生存を感謝しているが、世界観・道徳観・性格の相性ゆえに、無意識のうちに自覚以上の強い感情を抱いている。こうした感情は他の感情同様、疲労時や酩酊時に突然激しく表面化することがある。彼は「B」の執着的な欲望に気づいていない。\n「B」は間接的な部下である。戦闘能力はあるものの、「A」ほど戦闘に長けていないことを自覚しており、通常は支援役を務める。時折「A」の意見に異議を唱えることもあるが、常に「A」の命令に従う。「A」を強く不動のリーダーとして非常に好意的に見ている。他に繋がりはなく、「A」こそが彼女が価値を認め道徳的に善と考える唯一の人物である。このため「A」に不健康なほど執着し、自らにどんな犠牲を払おうとも「A」の肯定的な関心を獲得したいと願っている。常に「A」の近くにいたいと願い、その承認を渇望するあまり、身体的支配や愛情に関する思考が次第に過激かつ不適切にエスカレートしている。ヤンデレ的な思考様式を持つが、その発現は相対的な立場や力の差、結果への自覚によってしばしば抑制される。\n「A」は「B」よりも戦闘や武器操作において明らかに熟練しており、戦闘技術や武器操作、関連する教訓を「B」に教えようとする。機械類への共通の関心から、時には作業を分担することもあるが、通常「A」は自身の装備の整備に専念する。任務中は信頼関係と役割分担が明確なため、良好に連携する。二人は同じ小規模な前哨基地に駐留しており、業務上の理由と物理的な近接性から、日常的な生活でも頻繁に交流している。", "created_at": "", "completed_at": ""}, {"path": "/@yu_1123_mono/works/186", "thumbnail_src": "https://si.imgix.net/ddb643b3/uploads/origins/15c79211-eb02-4e95-81c8-331155ec564d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67d1cb41d1a1638ab4b67a44b4083407", "thumbnail_srcset": "https://si.imgix.net/ddb643b3/uploads/origins/15c79211-eb02-4e95-81c8-331155ec564d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67d1cb41d1a1638ab4b67a44b4083407, https://si.imgix.net/ddb643b3/uploads/origins/15c79211-eb02-4e95-81c8-331155ec564d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=266280e4074aaf74a62bfb25b9802b6d 2x, https://si.imgix.net/ddb643b3/uploads/origins/15c79211-eb02-4e95-81c8-331155ec564d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a19a00fa0fbc5c9855601851bd07849a 3x", "genre": "art", "nsfw": false, "body": "エラーが発生し、ブーストが送信されませんでした… なので、