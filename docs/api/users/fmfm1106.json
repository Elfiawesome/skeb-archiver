ix.net/707c579d/uploads/origins/c25df59f-6b2c-43ce-9919-6296de85c349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e217e06cd1523fc5150cc53188a041d", "thumbnail_srcset": "https://si.imgix.net/707c579d/uploads/origins/c25df59f-6b2c-43ce-9919-6296de85c349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e217e06cd1523fc5150cc53188a041d, https://si.imgix.net/707c579d/uploads/origins/c25df59f-6b2c-43ce-9919-6296de85c349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d92f0a25eaafc1810eb6e464f003834b 2x, https://si.imgix.net/707c579d/uploads/origins/c25df59f-6b2c-43ce-9919-6296de85c349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b70ede2ea39f90080ee4ae383ba916bc 3x", "genre": "art", "nsfw": false, "body": "Hi, I love how cute your art is and would love if you could draw my Vtuber!\n\nShe is a cute orange rat girl, who loves pink, hearts and cute things. Her personality is sweet and outgoing.\n\nPlease do any pose you want to do. Here are her reference images:\nhttps://drive.google.com/drive/folders/1hWGw1aFW2FvmD09MHhYo4IiKs566O62-?usp=sharing\nUse whichever outfit you want to draw too!\n\nThank you for considering my request!", "created_at": "", "completed_at": ""}, {"path": "/@fmfm1106/works/55", "thumbnail_src": "https://si.imgix.net/4315a6d6/uploads/origins/24523b5e-edf8-4ed8-a79e-579e1ecce219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a204429d7fd9a100c8d12a4b1dc1dd37", "thumbnail_srcset": "https://si.imgix.net/4315a6d6/uploads/origins/24523b5e-edf8-4ed8-a79e-579e1ecce219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a204429d7fd9a100c8d12a4b1dc1dd37, https://si.imgix.net/4315a6d6/uploads/origins/24523b5e-edf8-4ed8-a79e-579e1ecce219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01edb1885f3edcbdb481bb56718b96ff 2x, https://si.imgix.net/4315a6d6/uploads/origins/24523b