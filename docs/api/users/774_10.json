94192d0d-393b-4193-92e6-11b4c9e852d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bc393cabd6e278ba8c4dc1638a2a59", "thumbnail_srcset": "https://si.imgix.net/500ea5a4/uploads/origins/94192d0d-393b-4193-92e6-11b4c9e852d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bc393cabd6e278ba8c4dc1638a2a59, https://si.imgix.net/500ea5a4/uploads/origins/94192d0d-393b-4193-92e6-11b4c9e852d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8554187346749a65f35d2b39c907dab4 2x, https://si.imgix.net/500ea5a4/uploads/origins/94192d0d-393b-4193-92e6-11b4c9e852d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c2ef2d380a0adf06a672e4d62b38e6d 3x", "genre": "art", "nsfw": false, "body": "ししとう様\n\nはじめまして。Vtuber活動をしているジトメ宙と申します。\n\n淡く可愛いタッチの等身とクッキリして可愛いSDのイラストが素敵で依頼を送りました。\n\n等身大のイラストとSDのイラストを描いて頂きたいです。\n\n〇希望\n・等身大：通常衣装のツインテール\n・SD:通常衣装でもパジャマでもなんでもOKです\n\n・人物に見切れがないように描いて頂きたいです。\n・psd形式で人物レイヤーがそれぞれ別だと大変助かります。\n\n〇使用用途\n・YouTube、twitch等の配信媒体のヘッダー・サムネ・アイコン\n・X等のSNSのヘッダー・サムネ・アイコン\n　※上記は収益化する可能性があります。\n　※イラストの一部切り取っての使用や上に文字が入る事があります。\n\n〇好きなイラスト\nhttps://skeb.jp/@774_10/works/16\nhttps://skeb.jp/@774_10/works/17\nhttps://skeb.jp/@774_10/works/18\n\nhttps://drive.google.com/drive/folders/1l_nbuBRB9rsk7szsw7vZJMTgII0hjDYC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@774_10/works/20", "thumbnail_src": "https://si.imgix.net/48edb28e/uploads/origins/ba9ab992-d8ce-40a9-bdc7-339034e2bb43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b92a93a0bcadf84c57d0fc43a21c19", "thumbnail_srcset": "https://si.imgix.net/48edb28e/uploads/origins/ba9ab992-d8ce-40a9-bdc7-339034e2bb43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b92a93a0bcadf84c57d0fc43a21c19, https://si.imgix.net/48edb28e/uploads/origins/ba9ab992-d8ce-40a9-bdc7-339034e2bb43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9