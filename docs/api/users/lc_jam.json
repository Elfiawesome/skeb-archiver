0b-48cd-b1e2-e276b8bb8de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cd04cb450fa061363562841b0a49818 2x, https://si.imgix.net/071ddc13/uploads/origins/a8dbb805-eb0b-48cd-b1e2-e276b8bb8de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf222ca3402ed61c472de37ff829f52f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ジャム！お久しぶりです。お元気ですか？\nまた私とキットの写真をお願いしたいです！\n\nhttps://drive.google.com/drive/folders/13t3y6EsAPgfWyRtRFMAuztFvLwapvj5p?usp=sharing\n\n参考フォルダにもPicture Ideaを入れてみました！雪ときれいなライトを追加できますか？\n冬やクリスマスをテーマにした写真にしましょう！着心地のいい冬服を着て、マフラーを共有したりするとかわいいかも！\n\nキットのペルソナは今、しっぽが2本あって、ポニーの横に小さな三つ編みがあります！新しいリファレンスシートで見ることができます！彼らのルックスもとてもノンバイナリーです！\n\n私のアイデアの一部を取り入れることはできますが、すべてあなたの創造的な自由に任せています！🧡\nポーズや表情はあなた次第です。私が追加したスケッチページで大まかな雰囲気を見ることができます！\n\nあなたの心が望むものを自由に描いてください！\n全てお任せします！٩(＾◡＾)۶\n依頼内容に問題がある場合はキャンセル、金額が低すぎる場合は再送も可能です！🧡\nありがとうございました＆素敵な1日をジャム！ ☺️", "created_at": "", "completed_at": ""}, {"path": "/@lc_jam/works/131", "thumbnail_src": "https://si.imgix.net/b5da57d5/uploads/origins/0d839843-e113-4ea8-a3c9-a0a4eb714bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95cd9d1b02e0452d8f6ba07180ad77ed", "thumbnail_srcset": "https://si.imgix.net/b5da57d5/uploads/origins/0d839843-e113-4ea8-a3c9-a0a4eb714bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95cd9d1b02e0452d8f6ba07180ad77ed, https://si.imgix.net/b5da57d5/uploads/origins/0d839843-e113-4ea8-a3c9-a0a4eb714bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1b364653eed78709fc173fe30cf1997 2x, https://si.imgix.net/b5da57d5/uploads/origins/0d839843-e113-4ea8-a3c9-a0a4eb714bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e152c7a2f336c3d2170e37c4ad573f1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ジャム！お元気でお過ごしでしょうか。僕のVtuberペルソナのアクションショットのアートワークをお願いしたいんだ。武器は剣でも槍でも構いません。武器は剣でも槍でも構いません。また、満月の夜景もお願いしたいです。  \n\nポーズ案を載せましたが、お好きなポーズでお願いします！アニメーションにしたいので、キャラクターと背景を分けてもらっていいですか？  ご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/19Z5NmLlVDfmN1lMPQ7KBnaEsYf0uhjfh?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@lc_jam/works/130", "thumbnail_src": "https://si.imgix.net/4217b499/uploads/origins/289b4b28-0dd3-402a-836d-801b4e2d8ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8180fbcfbae40183f244ecc1e2a29ed3", "thumbnail_srcset": "https://si.imgix.net/4217b499/uploads/origins/289b4b28-0dd3-402a-836d-801b4e2d8ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8180fbcfbae40183f244ecc1e2a29ed3, https://si.imgix.net/4217b499/uploads/origins/289b4b28-0dd3-402a-836d-801b4e2d8ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d484eec3bc3f70184732de42daf9ab22 2x, https://si.imgix.net/4217b499/uploads/origins/289b4b28-0dd3-402a-836d-801b4e2d8ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea456b06e6321203aa6741221f5a95ec 3x", "genre": "art", "nsfw": true, "body": "以前はとても素晴らしい自キャラを描いて頂き、ありがとうございました\n水着のデザインもとても可愛く、今もお気に入りのイラストです\nそろそろ夏も近づいてきたので是非また水着を描いて頂きたく思います\n新しいデザインをお願いしようかとても迷ったのですが、描いて頂いたものもとても気に入っているのでこちらをベースにお願いします\n\n前回依頼した際、胸を大きめにお願いしましたがとても素晴らしい水着と相まってすっかり魅了されてしまいました\nうっかりこぼれてしまいそうな素晴らしいナイスバデー・・・(*´Д｀)\nむしろこぼれて欲しい、そんな邪念が捨て切れなくなってしまったため「ラッキースケベ」的なシチュエーションをお願いできないでしょうか\n構図などは全てお任せさせて頂きますが分かりづらければイメージ的な資料を一緒にアップしておりますのでご参考下さい\n\n今回もPCの壁紙で使用したく思いますので大き目サイズですと助かります\nご検討の程よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1Vh57IfiVGQ_O8OFqS7R_DHTrCWudF8bi?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@lc_jam/works/129", "thumbnail_src": "https://si.imgix.net/9d0bbcb0/uploads/origins/2c1d8ab0-d6e0-409f-b192-8fcb83f64dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=897aad12cad8158b799f177c08bdc905", "thumbnail_srcset": "https://si.imgix.net/9d0bbcb0/uploads/origins/2c1d8ab0-d6e0-409f-b192-8fcb83f64dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=897aad12cad8158b799f177c08bdc905, https://si.imgix.net/9d0bbcb0/uploads/origins/2c1d8ab0-d6e0-409f-b192-8fcb83f64dac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fed8d5cd2d379a1006695da3141d4ba9 2x, https://si.imgix.net/9d0bbcb0/uploads/origins/2c1d8ab0-d6e0-409f-b192-8fcb83f64dac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b989c7642146bf561ea4d09df28de6a2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！とてもかわいいスタイルですね！できればリクエストさせてください。\n\nOCのすみれをお願いしたいです。元々は人間の貴族で騎士でした。しかし、ゴブリンの女王に敗れ、自らもゴブリンになってしまった。彼女の特徴は、牙と体を覆う傷跡、そして耳のわずかな切り欠き。雷の魔法を使う。身長は120センチしかない。構図としては、戦いの後、包帯を巻いている姿がいいと思います。リクエストにお答えいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1bl97uppq95VrDykLMHp_3EubZBuFqoqU", "created_at": "", "completed_at": ""}, {"path": "/@lc_jam/works/128", "thumbnail_src": "https://si.imgix.net/dd426558/uploads/origins/3ecfa359-74cb-444a-b410-6c988cf95d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36686d2cfabb2a180b9ca6099f47c416", "thumbnail_srcset": "https://si.imgix.net/dd426558/uploads/origins/3ecfa359-74cb-444a-b410-6c988cf95d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36686d2cfabb2a180b9ca6099f47c416, https://si.imgix.net/dd426558/uploads/origins/3ecfa359-74cb-444a-b410-6c988cf95d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d860e71e24da1c7e35dec4e4ff7af78c 2x, https://si.imgix.net/dd426558/uploads/origins/3ecfa359-74cb-444a-b410-6c988cf95d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19f26f7314ac5ddbc15412bb51b86f6a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、前回の絵に感謝します！\n\n新バージョンの \"魔竜レッドグレイブ \"と \"ニドホグ鬼フォン\"\n特別なものです。\n\nレドグレイブは黒と赤の着物、フォンは黒と紫の着物。二人は夜、外で花火を見て、素敵なキスをしている。\n\n新年のアートです。\n\nフォンは前回のアートと同じように黒髪のままです^^。\n\nそして、2人ともドラゴンの尻尾を触れ合っています！\n\nそして、年内に完成させることができればいいのですが^^。\n\nありがたいです。\n\nhttps://drive.google.com/drive/folders/1-5DhfwjdGEQW7bYNPeQ8HCe8_t8Zc3ys?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@lc_jam/works/127", "thumbnail_src": "https://si.imgix.net/c68dcdb9/uploads/origins/e560d84a-8a47-40ba-b75a-eadae1c80ade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c489b05c6577b5a4f384400e67ebfa4a", "thumbnail_srcset": "https://si.imgix.net/c68dcdb9/uploads/origins/e560d84a-8a47-40ba-b75a-eadae1c80ade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c489b05c6577b5a4f384400e67ebfa4a, https://si.imgix.net/c68dcdb9/uploads/origins/e560d84a-8a47-40ba-b75a-eadae1c80ade?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b76a5e441877f61766652ff7f00037a6 2x, https://si.imgix.net/c68dcdb9/uploads/origins/e560d84a-8a47-40ba-b75a-eadae1c80ade?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e47e280daefba7f274358361c868b3c5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、前回のアートに感謝します！\n\n悪魔のレッドグレイブを、「波乱万丈」のモルテフィのようなスタイルと外見にしたい（色は黒のジャケットと赤のベスト）。髪の毛は『阿修羅の怒り』の夜叉のように（赤毛で少し長め）。彼のメガネはレッドグレイブが持っているもののままでもいいし、もっといいアイデアがあれば自由に変えてもいい。また、ドラグーンの武器である槍、ファイナルファンタジー14のゲー・ボルグ（黒と赤）を装備している。\n\n背景は、赤い彼岸花を囲むことができます。他にも何かアイデアがあれば、喜んで追加してください！\n\n私はあなたの芸術が大好きなので、私はあなたに非常に感謝します！\n\nhttps://drive.google.com/drive/folders/17Rvxv-MGELVUMYe-EWENqa3KPj20LfR7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@lc_jam/works/126", "thumbnail_src": "https://si.imgix.net/47cb28c4/uploads/origins/26d8f3de-6a86-4362-a1bf-29af67198326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b7fb64585ec93dc6b8f173f97c2bd53", "thumbnail_srcset": "https://si.imgix.net/47cb28c4/uploads/origins/26d8f3de-6a86-4362-a1bf-29af67198326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle