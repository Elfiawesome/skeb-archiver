0"}, {"amount": 18000, "recorded_at": "2026-03-08T01:29:36.227542+00:00"}]}, "current_prices": {"art": 22000, "comic": 18000}, "price_range": {"art": {"min": 12000, "max": 32000}, "comic": {"min": 9000, "max": 21000}}, "links": [{"label": "Twitter", "url": "https://x.com/koto_kao", "name": "koto_kao"}, {"label": "Website", "url": "https://piku.page/@kotokao", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/21282", "name": "21282"}], "flags": {"from_archive": true}, "works": [{"path": "/@koto_kao/works/33", "thumbnail_src": "https://si.imgix.net/efbb1078/uploads/origins/375e8ab5-862e-4979-a0d4-0c309426de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a9a06b284443b390c59060a48cdd646", "thumbnail_srcset": "https://si.imgix.net/efbb1078/uploads/origins/375e8ab5-862e-4979-a0d4-0c309426de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a9a06b284443b390c59060a48cdd646, https://si.imgix.net/efbb1078/uploads/origins/375e8ab5-862e-4979-a0d4-0c309426de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bd1b36d268a860b3bab9deba3c72363 2x, https://si.imgix.net/efbb1078/uploads/origins/375e8ab5-862e-4979-a0d4-0c309426de0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8a89546c79a191a62733144ddcf23a8 3x", "genre": "art", "nsfw": false, "body": "花央さん、お世話になっております。\n以前MÚSECAのメリリィ様のイラストを依頼させていただいた有明月です。\nその節は素敵な作品をありがとうございました！\n\n今回はまたイラストをお願いしたく思いご連絡をいたしました。\n\n【キャラクターについて】\n今回描いていただきたいのは、自分が過去に描いたOCたちです。\n詳細はそれぞれのURLにて自分のXに再掲したイラストを提示しておきましたのでご確認ください。\n\n1.精霊の女の子\n\nhttps://x.com/_Skylove_02/status/1920821540007932181\nファンタジー系の世界にあるカフェで働いている精霊さんです。\n身長は150cm前後のイメージです。\nカフェの制服はストライプのワンピースで、髪は長く、後ろで山吹色のシュシュで結んであります。\n（なお、掲載されたイラストではインナーを着用していないように見えると思いますが、気にしなくて大丈夫です）\n\n2.亀\n\nhttps://x.com/_Skylove_02/status/1926483899640586467\n資料URLに掲載しているイラストのうちの、亀の方です。\nリクガメをモデルにした体型と大きさで、甲羅の中央に取っ手があります。\n\n\n【イラスト内容】\n「1.の精霊さんと2.の亀のツーショット」をお願いします。\n\nシチュエーションとしては、2人（？）がおでかけ（散歩やピクニック）している様子を描いていただきたいと思います。\n\n大まかな構図などはお任せします。\n構図の都合上必要であれば、亀は体を浮遊させる等していただいても大丈夫です。\nまた、精霊さんの制服についてですが、不明瞭な部分の補完や細部のアレンジなどは必要であれば自由に行っていただいて問題ありません。\n\n乱文で恐縮ですが、説明については以上となります。\nそれでは、何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/32", "thumbnail_src": "https://si.imgix.net/411cac1a/uploads/origins/14fdaf2f-c230-4a92-aed0-8770bfafa698?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbbc26c2c326a870b8dc3ac1d477988a", "thumbnail_srcset": "https://si.imgix.net/411cac1a/uploads/origins/14fdaf2f-c230-4a92-aed0-8770bfafa698?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbbc26c2c326a870b8dc3ac1d477988a, https://si.imgix.net/411cac1a/uploads/origins/14fdaf2f-c230-4a92-aed0-8770bfafa698?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=543dc868715df7e656a5f82b3f15f13d 2x, https://si.imgix.net/411cac1a/uploads/origins/14fdaf2f-c230-4a92-aed0-8770bfafa698?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5a83dfe397a5b89e94726387e3812e2 3x", "genre": "art", "nsfw": false, "body": "以下のオリジナルキャラクター（うちの子）達を描写可能な範囲で\n描いて頂きたいです。\n\n【男の子】\n●髪瞳色・髪型\n　・髪：赤茶色（#b05438）\nさらさらのストレートを首の後ろでくくている。\n\n【男の子の髪型参考図】\n（異世界Verのイメージ\nなので髪型だけ参照希望）\nhttps://x.com/SmallPigeon/status/1832018669259616354?t=_3uLFyCw86sv3U2d5fTq4A&s=19\n\n　・瞳：髪と同じ色\n\n●服装\n・上着：緑色（#007E66）の服。\n（参考図のバンダナ不要）\n\n●見た目：女の子と同い年の少年です。\n（参考図よりも年上っぽい描写希望）\n\n\n【女の子】\n●髪瞳色・髪型\n　・髪：濃い蜂蜜のような黄金色（#FFD700）猫っ毛\n　・瞳：エヴァーグリーン（#00984f）\n\n●服装\n　・向かって右側に星とパンダの髪飾り（基本装備）\n\n・山吹色の服。\n\n\n全体イメージ：\n男の子が作った甘味（ケーキ等）か\n料理（オムライス等）を\n女の子が美味しそうにもぐもぐしている。\n\nそれを男の子も一緒に食べている もしくは、微笑みながら見守っているイメージ。\n\n（男の子目線的に「いっぱい食べる君が好き」のような雰囲気です）\n\n衣装デザイン（難しい場合はTシャツやパーカーのような家着を希望）や構図など、\nその他おまかせいたします。\n\nまた可能なら表情差分があると嬉しいです。\nよろしくお願いいたします。\n\n女の子の参考図\nhttps://twitter.com/SmallPigeon/status/1278569091750649857?s=19", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/31", "thumbnail_src": "https://si.imgix.net/b30c27a1/uploads/origins/73536c3f-f51d-4568-bfb0-10dae606942c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b961b697f054667b04499017124e342b", "thumbnail_srcset": "https://si.imgix.net/b30c27a1/uploads/origins/73536c3f-f51d-4568-bfb0-10dae606942c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b961b697f054667b04499017124e342b, https://si.imgix.net/b30c27a1/uploads/origins/73536c3f-f51d-4568-bfb0-10dae606942c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d083ada149a2ea37a0e0a046791a82e4 2x, https://si.imgix.net/b30c27a1/uploads/origins/73536c3f-f51d-4568-bfb0-10dae606942c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01c827572b2e2854749d5924a0f066fa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつも花央さんの描くかわいいケモミミちゃんたちに癒されております！\n今回、私の創作キャラクターのハルとユキを描いていただきたく依頼させていただきました。\nこの2人が仲良く過ごしている日常シーンを描いていただきたいです！構図や細かい設定などはおまかせとなってしまいますが、どうぞよろしくお願いします…！！\n\nキャラクターイラストのURLをつけていますのでご参照ください。\n\nhttps://drive.google.com/drive/folders/15ffrCjFxi0ioKBleLPABGDI6fsKhYymy", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/30", "thumbnail_src": "https://si.imgix.net/ee9ab311/uploads/origins/5551333a-dcb7-43e8-9651-acfa0feecfef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3128306675d5a8a55c474be13f261886", "thumbnail_srcset": "https://si.imgix.net/ee9ab311/uploads/origins/5551333a-dcb7-43e8-9651-acfa0feecfef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3128306675d5a8a55c474be13f261886, https://si.imgix.net/ee9ab311/uploads/origins/5551333a-dcb7-43e8-9651-acfa0feecfef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=299d469d73b558ab32d567cabb3ca0b3 2x, https://si.imgix.net/ee9ab311/uploads/origins/5551333a-dcb7-43e8-9651-acfa0feecfef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba6ac5191f30c6dd7e0c682dc1bc6948 3x", "genre": "art", "nsfw": false, "body": "天使代行ラングドシャ（@langue_de_104）を、ＣＶ担当している「その許嫁（よめ）は初恋を知らない」の堤香雪蘭の衣装＋眼鏡差分ありでお願いいたします。\n※Skeb可能かどうかは事前に確認済みですが、ご本人のインフォメーションリンクから確認できます\n\nhttps://x.com/sonokoi_horyu/status/1961262534738248166?t=xnbFY18dtdzoijIfgMM6_w&s=19", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/29", "thumbnail_src": "https://si.imgix.net/5c20007b/uploads/origins/ab89513c-a310-4b5d-81ea-737f8863272b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42317bc7d490dedc7c40fdb47a2c6cbf", "thumbnail_srcset": "https://si.imgix.net/5c20007b/uploads/origins/ab89513c-a310-4b5d-81ea-737f8863272b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42317bc7d490dedc7c40fdb47a2c6cbf, https://si.imgix.net/5c20007b/uploads/origins/ab89513c-a310-4b5d-81ea-737f8863272b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=657111f5ec7917f4cd1345b01c9db0cb 2x, https://si.imgix.net/5c20007b/uploads/origins/ab89513c-a310-4b5d-81ea-737f8863272b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e7dfa77e129ebda9cbd05a21b8b8546 3x", "genre": "art", "nsfw": false, "body": "大噛がるる（@Ookami_Garuru）を眼鏡差分ありでお願いいたします。\n構図等はお任せします。\n\n※Skebでのリクエスト許可は得ております", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/28", "thumbnail_src": "https://si.imgix.net/5f6186b8/uploads/origins/3bad0df5-4409-4f72-9dee-f4ded12b9cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498b5acd484cd7e24ee20be98816c35f", "thumbnail_srcset": "https://si.imgix.net/5f6186b8/uploads/origins/3bad0df5-4409-4f72-9dee-f4ded12b9cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498b5acd484cd7e24ee20be98816c35f, https://si.imgix.net/5f6186b8/uploads/origins/3bad0df5-4409-4f72-9dee-f4ded12b9cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=286a7c470339688e1556c5ee0fbc9d62 2x, https://si.imgix.net/5f6186b8/uploads/origins/3bad0df5-4409-4f72-9dee-f4ded12b9cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9144bcac0a4ac483d878386a6a79ed7 3x", "genre": "art", "nsfw": false, "body": "星ノ樹コフレさん（@star_coffret）を眼鏡差分ありでお願いいたします。\n構図等はお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/27", "thumbnail_src": "https://si.imgix.net/6b270e04/uploads/origins/4d7bf7f2-8a42-44db-87df-4f3cd6e0eaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae724fa6edae71d9839d4e441b0666b", "thumbnail_srcset": "https://si.imgix.net/6b270e04/uploads/origins/4d7bf7f2-8a42-44db-87df-4f3cd6e0eaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae724fa6edae71d9839d4e441b0666b, https://si.imgix.net/6b270e04/uploads/origins/4d7bf7f2-8a42-44db-87df-4f3cd6e0eaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc83da068d28c58245da6378d8825fb4 2x, https://si.imgix.net/6b270e04/uploads/origins/4d7bf7f2-8a42-44db-87df-4f3cd6e0eaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f96a5c32d7657ce6b8192246abb47363 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\nいつもかわいいイラストを描いていただきありがとうございます～\n\n今回は「ゼンレスゾーンゼロ」より橘福福（チー・フーフー）ちゃんをお願いできますでしょうか。\nネコっぽい（虎なんですが）、寝ころびながらじゃれてる感じのポーズを希望いたします。\nご検討よろしくお願いいたします～\n\n参考まで、キャラ紹介等のリンクは以下のとおりです。\nhttps://zenless.hoyoverse.com/ja-jp/news/155648\nhttps://zenless.hoyoverse.com/ja-jp/news/157209", "created_at": "", "completed_at": ""}, {"path": "/@koto_kao/works/26", "thumbnail_src": "https://si.imgix.net/2bf59052/uploads/origins/16c8d267-40a3-4638-a637-5c3917dc5660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b14084e747ee0404f3ae6be57744616", "thumbnail_srcset": "https://si.imgix.net/2bf59052/uploads/origins/16c8d267-40a3-4638-a637-5c3917dc5660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b14084e747ee0404f3ae6be57744616, https://si.imgix.net/2bf59052/uploads/ori