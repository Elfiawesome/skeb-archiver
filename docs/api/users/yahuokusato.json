ceafe2ed76f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24bb03838d188d75895bdd784513f3db, https://si.imgix.net/6d8ea83d/uploads/origins/28a6f769-8f98-4198-9435-3ceafe2ed76f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca1ac6ef3f431a6ffa2e60e48aa4993c 2x, https://si.imgix.net/6d8ea83d/uploads/origins/28a6f769-8f98-4198-9435-3ceafe2ed76f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b0d54f26ce70eb128f28cb3a99f200a 3x", "genre": "art", "nsfw": true, "body": "八奈見杏菜と中野五月のWパイズリをお願いします。構図は画像と同じ、体型は以前のI字バランスの由比鶴乃と同じで。\n\nまた可能ならパイズリの構図は同じで寝そべった状態、挟んでるがわの腕を上げて脇を見せるというのもお願いします。脇から湯気のエフェクトもお願いします。\n\n他のエフェクトは谷間から大量射精、精液が体へかかる、ウインク、口を開く、半目開きが可能であればよろしくお願いします\n\nhttps://skeb.jp/@yahuokusato/works/181\n\nhttps://skeb.jp/@go_gomada_re/works/20", "created_at": "", "completed_at": ""}, {"path": "/@yahuokusato/works/215", "thumbnail_src": "https://si.imgix.net/f7da782e/uploads/origins/37a301e4-3f18-45d9-b52b-1f6ef34450cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1c6bc5487ba5f9a0022dee60bd34e83", "thumbnail_srcset": "https://si.imgix.net/f7da782e/uploads/origins/37a301e4-3f18-45d9-b52b-1f6ef34450cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1c6bc5487ba5f9a0022dee60bd34e83, https://si.imgix.net/f7da782e/uploads/origins/37a301e4-3f18-45d9-b52b-1f6ef34450cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=891d02f1420a42ff928fc908e2d55463 2x, https://si.imgix.net/f7da782e/uploads/origins/37a301e4-3f18-45d9-b52b-1f6ef34450cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7ca1edb46e313624e34e183f61c134b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nファイアーエムブレム4のディアドラの絵を描いてほしいんだけど、このデザインでお願いします！ https://static.wikia.nocookie.net/fireemblem/images/5/5c/Deidre_Heroes.png/revision/latest?cb=20171016045553\n全裸で、ふくよかで、乳首が膨らんでいて、大きな胸が欲しいです！できれば、母乳が漏れるような乳房にしてほしい。参考URLのように、パイズリをしてもらいたい！\nhttps://x.com/IzuriPai/status/1898817322800017711?t=pmV4gUBJZa3vcN5Z19MLFA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@yahuokusato/works/214", "thumbnail_src": "https://si.imgix.net/8db0af9a/uploads/origins/325a668f-1109-4eac-ba40-5a39ed8faf93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77bb01a14de9758d4f693fbadbab34e4", "thumbnail_srcset": "https://si.imgix.net/8db0af9a/uploads/origins/325a668f-1109-4eac-ba40-5a39ed8faf93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77bb01a14de9758d4f693fbadbab34e4, https://si.imgix.net/8db0af9a/uploads/origins/325a668f-1109-4eac-ba40-5a39ed8faf93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d621e841cada5bc3d09ae65f00d7c84 2x, https://si.imgix.net/8db0af9a/uploads/origins/325a668f-1109-4eac-ba40-5a39ed8faf93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab43ae9b3aa95d604444bf32c7595a5e 3x", "genre": "art", "nsfw": true, "body": "遊戯王の真崎杏子が原作漫画版に登場する狐蔵乃（こくらの）に催眠で常識改変されおっぱいちゅーちゅーさせちゃう絵をお願いします\nhttps://www.dropbox.com/scl/fi/owpj9umygmvqx89tdf1is/yuugiou6-1-1.jpg?rlkey=y03w983xa3nng63yasyh1bm4z&st=bz4dyi0w&dl=1\n\n制服姿で前ボタンを外した状態で巨乳おっぱいを露出して\n「杏子ちゃんっ杏子ちゃんっ」とおっぱいをひっぱるように無我夢中で吸う狐蔵乃に\n催眠で常識改変させられた杏子は「あんっ♡もう狐蔵乃くんったら♡続きはホテルで♡んんっ♡」とビクンビクン感じさせてください", "created_at": "", "completed_at": ""}, {"path": "/@yahuokusato/works/213", "thumbnail_src": "https://si.imgix.net/d13b05e8/uploads/origins/79772a57-8618-404e-a994-8c2f6bf317ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c002fd3b25962047d1d62529362d3bf9", "thumbnail_srcset": "https://si.imgix.net/d13b05e8/uploads/origins/79772a57-8618-404e-a994-8c2f6bf317ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c002fd3b25962047d1d62529362d3bf9, https://si.imgix.net/d13b05e8/uploads/origins/79772a57-8618-404e-a994-8c2f6bf317ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adf684ab9ad388fe4faa524925c11ddd 2x, https://si.imgix.net/d13b05e8/uploads/origins/79772a57-8618-404e-a994-8c2f6bf317ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2495807dbc900d0060e7cd46bcc087d9 3x", "genre": "art", "nsfw": true, "body": "https://img4.gelbooru.com/images/c7/ac/c7ac2237a989e7813d60cab812acb1f2.jpeg\nゼロとアイリスの写真をお願いします。\n>幸せそうなアイリス\n>ゼロのペニスが極端に大きく深くなっている（子宮の中でイク）\n\nできれば、ゼロの体とペニスは別レイヤーにしていただけないでしょうか？  アナルセックスの別バージョンのために、彼の位置が変えられることを期待しています。  アイリスの表情が変わる http://i.imgur.com/Txn76NV.png\n\nhttps://img4.gelbooru.com/images/c7/ac/c7ac2237a989e7813d60cab812acb1f2.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@yahuokusato/works/212", "thumbnail_src": "https://si.imgix.net/39e36d6e/uploads/origins/7af8540c-8d52-4e49-8310-9f15ac377a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a4873dbb074d34746d6cab395e45961", "thumbnail_srcset": "https://si.imgix.net/39e36d6e/uploads/origins/7af8540c-8d52-4e49-8310-9f15ac377a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a4873dbb074d34746d6cab395e45961, https://si.imgix.net/39e36d6e/uploads/origins/7af8540c-8d52-4e49-8310-9f15ac377a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f9d38ef41a52e89435d2d9882fd0f38 2x, https://si.imgix.net/39e36d6e/uploads/origins/7af8540c-8d52-4e49-8310-9f15ac377a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=812ad3e8f2c12d1ab26b6132942da6e2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yahuokusato/work