bf-465c-b495-eae557260a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d8b72785366dc14987f3ef181519dc7 2x, https://si.imgix.net/5a0b7460/uploads/origins/30987731-42bf-465c-b495-eae557260a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=435500de445108d2db29e872521862a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@noko12yayoi/works/125", "thumbnail_src": "https://si.imgix.net/d24ef996/uploads/origins/d7c2b370-dfe0-488c-8c5c-d01b805824c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439f300632778656e2ac7c520e64a6cc", "thumbnail_srcset": "https://si.imgix.net/d24ef996/uploads/origins/d7c2b370-dfe0-488c-8c5c-d01b805824c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439f300632778656e2ac7c520e64a6cc, https://si.imgix.net/d24ef996/uploads/origins/d7c2b370-dfe0-488c-8c5c-d01b805824c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38f95e7482a9cf17667c1ea10ca1a8d0 2x, https://si.imgix.net/d24ef996/uploads/origins/d7c2b370-dfe0-488c-8c5c-d01b805824c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3521ef240b1d56f99ca0026a9b63f3e6 3x", "genre": "art", "nsfw": false, "body": "のこさん、いつもありがとうございます！別のリクエストをお送りしたいと思います。\n\n胸の谷間に焦点を当てたセクシーなバレンタインをテーマにした作品を描いていただければ幸いです。作曲はお任せします！\n\nキャラクターはソル、マルタ、牛若丸（FGO）からお選びください。メルトリリスなど、以前に描いたキャラクターをお選びいただけます。この場合、胸が小さいので構図を変えてもかまいません。\n\nバレンタインデーまでにこの作品を完成させなければならないような気がしないでください！必要に応じて時間をかけてください-あなたの健康が最も重要です！", "created_at": "", "completed_at": ""}, {"path": "/@noko12yayoi/works/124", "thumbnail_src": "https://si.imgix.net/6f685a9f/uploads/origins/94747c09-585a-492e-989c-9a3691d0b028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa5b81c65b7ad8759aa6ca37ac26bbd", "thumbnail_srcset": "https://si.imgix.net/6f685a9f/uploads/origins/94747c09-585a-492e-989c-9a3691d0b028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa5b81c65b7ad8759aa6ca37ac26bbd, https://si.imgix.net/6f685a9f/uploads/origins/94747c09-585a-492e-989c-9a3691d0b028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7cecb430c36de62047f650c717b2a92 2x, https://si.imgix.net/6f685a9f/uploads/origins/94747c09-585a-492e-989c-9a3691d0b028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc6dcb7a1e172ccfec2beb2d90de26a1 3x", "genre": "art", "nsfw": true, "body": "こんにちは。私と友人と一緒にやった前のスケブが大好きで、また別のスケブをやってもらいたいと思っています!\n\n今回は、私(https://twitter.com/RingMyCybele/status/1486178698080358404)と友人のAngel Steps(https://imgur.com/a/hyaRsau)が一緒にセックスしているスケブを作ってもらいたいと思います。私はどちらかというと上で、Angelはどちらかというと下です。私たちをどのように描くかについては、あなたに創造的な自由を与えるでしょう\n\nありがとうございます <3", "created_at": "", "completed_at": ""}, {"path": "/@noko12yayoi/works/123", "thumbnail_src": "https://si.imgix.net/04f914d5/uploads/origins/948d0395-ed16-4a5b-bbea-442ba97c6dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3f7d982c5782ebfffbcf4725027218", "thumbnail_srcset": "https://si.imgix.net/04f914d5/uploads/origins/948d0395-ed16-4a5b-bbea-442ba97c6dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3f7d982c5782ebfffbcf4725027218, https://si.imgix.net/04f914d5/uploads/origins/948d0395-ed16-4a5b-bbea-442ba97c6dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95a80e8e9596fd88e188af3d9f5eb985 2x, https://si.imgix.net/04f914d5/uploads/origins/948d0395-ed16-4a5b-bbea-442ba97c6dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40a3e4e10f462abb20ce6153e39096f2 3x", "genre": "art", "nsfw": false, "body": "のこさん、前作ありがとうございました！リクエストをお送りできれば幸いです。\n\n「ソル」の簡単なキャラクターシートを作っていただければと思います。 「92m」の近視姉に似た服を着た「ソル」を描いてください。履物はハイヒールを履いた「ソル」を描いてください。ハイヒールの参考画像がいくつか提供されますが、この衣装のデザインはあなた次第です。\n\nあなたがそれが合うと思うならば、どんなヘアアクセサリーあるいは眼鏡さえもオプションです。このリクエストを拒否することを躊躇しないでください。\n\nあきらめないでください！\n\nhttps://twitter.com/92M/status/1405844945164914691\n\nhttps://twitter.com/92M/status/1410923186435231745\n\nhttps://twitter.com/applekun_u/status/1478905777108963328\n\nhttps://twitter.com/ydh2101/status/1473317696179961857", "created_at": "", "completed_at": ""}]}