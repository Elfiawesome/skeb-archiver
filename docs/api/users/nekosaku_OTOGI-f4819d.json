7c2-7e6b8a714ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8573143cc155af4ac8f4876dcab5fc67, https://si.imgix.net/cff8f600/uploads/origins/c8fabb48-c059-4a87-b7c2-7e6b8a714ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f199b2001670a7de7c356cc9fd511b49 2x, https://si.imgix.net/cff8f600/uploads/origins/c8fabb48-c059-4a87-b7c2-7e6b8a714ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35e09a307725a033c6d59e62cf6951f6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Skebがオープンしたのを見ました。\nこのZenless Zone ZeroのNPCが座って本を読んでいるところを描いてもらえませんか？\n\nhttps://drive.google.com/drive/folders/1deLoLHykTgyHdVtYXn7_qSsMp5k_Bqm5", "created_at": "", "completed_at": ""}, {"path": "/@nekosaku_OTOGI/works/5", "thumbnail_src": "https://si.imgix.net/0e941aba/uploads/origins/5f05de5f-6eeb-406c-8b09-e7139320f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40d0d7e55b78879ddea57d6c8b1ba4c1", "thumbnail_srcset": "https://si.imgix.net/0e941aba/uploads/origins/5f05de5f-6eeb-406c-8b09-e7139320f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40d0d7e55b78879ddea57d6c8b1ba4c1, https://si.imgix.net/0e941aba/uploads/origins/5f05de5f-6eeb-406c-8b09-e7139320f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccb0c82c6d930e1e38a6c89701251fba 2x, https://si.imgix.net/0e941aba/uploads/origins/5f05de5f-6eeb-406c-8b09-e7139320f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93c585f632d87659cb9ec7d8e40cb39e 3x", "genre": "art", "nsfw": true, "body": "ねこさくさん、以前よりskeb待ってました。ありがとうございます。NSFWのリクエストをお願いしたいと思い送らせて頂きました。\n\n◾︎シチュエーション\n学園祭のメイドカフェ\n目の前でコーヒーに射精してミルクコーヒーをつくるふたなり\n\nこの子は嫌々ながらメイドとして働いています。嫌そうにしながらも射精で顔が紅潮してるエチな顔でお願いします。\n\nぬきぬき→射精→「ご注文の品の…」\nの流れがわかるようにして下さるとありがたいです。\n\n◾︎構図\nもし注文客が見えるようならば、なるべく見えないよう、シルエットにしてくださると有難いです。\nその子とおちんちんに集中したいので\n\n◾︎キャラクター\n下記に示すキャラ一覧の、ねこさくさんの創作キャラのどれか一人でお願い致します。\nもし解釈違いとかがあれば、他の子や新しくキャラクターを作るなどしても構いません\n\n【ちんちんに来たキャラ一覧】\n栗後はなﾁｬﾝ、木谷めるﾁｬﾝ、片栗雛子ﾁｬﾝ、芦築紀香ﾁｬﾝ\n\n◾︎最後に\n長すぎてあまりにも読みづらいと思いますがよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nekosaku_OTOGI/works/4", "thumbnail_src": "https://si.imgix.net/7c8539a7/uploads/origins/619cb176-bf30-476c-96f9-fecf493ed55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cc27123ecd8ecaa67a02f88174d445f", "thumbnail_srcset": "https://si.imgix.net/7c8539a7/uploads/origins/619cb176-bf30-476c-96f9-fecf493ed55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cc27123ecd8ecaa67a02f88174d445f, https://si.imgix.net/7c8539a7/uploads/origins/619cb176-bf30-476c-96f9-fecf493ed55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e9f2660ea0506a5e78cde3200f987ce 2x, https://si.imgix.net/7c8539a7/uploads/origins/619cb176-bf30-476c-96f9-fecf493ed55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77d8b1043d980c54d63cf340cfaf8b62 3x", "genre": "art", "nsfw": false, "body": "はじめまして、ねこさくさん。\n私の推しである、プリンセスコネクトのアオイを描いていただきたいです。\n構図、衣装等はおまかせします。\n参考までに、この子は赤面させるとかわいいです。", "created_at": "", "completed_at": ""}, {"path": "/@nekosaku_OTOGI/works/3", "thumbnail_src": "https://si.imgix.net/eb0c4cbc/uploads/origins/302d47bc-4959-4269-928b-51ae1208f962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e5371f959d481983f24666db290f8e", "thumbnail_srcset": "https://si.imgix.net/eb0c4cbc/uploads/origins/302d47bc-4959-4269-928b-51ae1208f962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e5371f959d481983f24666db290f8e, https://si.imgix.net/eb0c4cbc/uploads/origins/302d47bc-4959-4269-928b-51ae1208f962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfc5345e555efb2ceae597abba107158 2x, https://si.imgix.net/eb0c4cbc/uploads/origins/302d47bc-4959-4269-928b-51ae1208f962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3653deaacff142e476a9ae28707b36c7 3x", "genre": "art", "nsfw": false, "body": "ねこさくさん、こんにちは。\nポートフォリオ等を見て、「完全人外(ヒトでない顔)が描ける方だ」と見込み、リクエストしたく思いました。\nそのリクエストというのは、私のオリキャラである「クロ」＆「灯篭さん」です。\n\n\n【キャラ特徴】\n［クロ］\n影のような顔をした存在。影のような顔から丸く光る目をしているのが特徴。\n※資料URLには通常姿と成長姿の２パターンがありますが、今回は「通常姿(背が低い子)」をお願いします\n\n［灯篭さん］\n名前の通り。陰からの光が目になっている。\n炎が両手の役割をしている(物は持てない)。\n※灯篭ではありますが、アニメーションの如くほんの少しなら曲がっても構いません(これは下記の希望構図に関わるため)\n\n\n【希望構図】\nクロが釣りをして、灯篭さんがそれを眺める図。場所は川を希望します。\n(余力があれば、でっかい魚が釣れて2人(?)がびっくり仰天する図の方を希望します)\n(普通に釣りをするか、でっかい魚を釣ったか、どちらの構図にするかはねこさくさんにお任せします)\n\n\n人の顔をしていない人外キャラなので、もし難しかったらキャンセルしても構いません。\nよろしくお願いします。\n\nhttps://twitter.com/wmamiya_talk21/status/1760099532623519805?s=46&t=pwfHEEwQSmYZNn8vZP1E2Q", "created_at": "", "completed_at": ""}, {"path": "/@nekosaku_OTOGI/works/2", "thumbnail_src": "https://si.imgix.net/59785ede/uploads/origins/d25bf8ac-da64-4dba-b983-1cb4088c46ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4722a396942d2afc9b3ddd6eecc43c", "thumbnail_srcset": "https://si.imgix.net/59785ede/uploads/origins/d25bf8ac-da64-4dba-b983-1cb4088c46ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4722a396942d2afc9b3ddd6eecc43c, https://si.imgix.net/59785ede/uploads/origins/d25bf8ac-da64-4dba-b983-1cb4088c46ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c6ef2f6bf8f9bf610df02d8f8b3e87d 2x, https://si.imgix.net/59785ede/uploads/origins/d25bf8ac-da64-4dba-b983-1cb4088c46ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85db986c64edca4981b2d4ecf5c83e24 3x", "genre": "art", "nsfw": true, "body": "親愛なる絵師　ねこさくさんへ\n\nかねてよりお願いしたい依頼があります。\nもしよろしければ、うちの麓美さんの大人なイラストを描いていただけると嬉しいです！\n\n相手やシチュエーション・構図などは自由に描いていただいて構いません。首を絡めてきたり、舌でなめなめしたりして誘惑するような感じで描いていただけると最高です！\n\nよろしくお願いします…！\n\nhttps://www.pixiv.net/artworks/108769749", "created_at": "", "completed_at": ""}, {"path": "/@nekosaku_OTOGI/works/1", "thumbnail_src": "https://si.imgix.net/73db2cb0/uploads/origins/c06bb7ea-878d-412f-bd82-f49bcf0c7003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79475018d0d7059e4347b1e4333af188", "thumbnail_srcset": "https://si.imgix.net/73db2cb0/uploads/origins/c06bb7ea-878d-412f-bd82-f49bcf0c7003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79475018d0d7059e4347b1e4333af188, https://si.imgix.net/73db2cb0/uploads/origins/c06bb7ea-878d-412f-bd82-f49bcf0c7003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d35ea7b4f66c43c0242d61d501f5e54 2x, https://si.imgix.net/73db2cb0/uploads/origins/c06bb7ea-878d-412f-bd82-f49bcf0c7003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e89eaab735b4ad8d7563646206d8cbf7 3x", "genre": "art", "nsfw": true, "body": "あなたの作品のオリジナルキャラクターが大好きです！かぐや姫がとてもかわいいです。僭越ながら、彼女との大人な作品をお願いしたいです。\n\n振り子に催眠術をかけられて、何種類かの催眠術をかけられた表情や目のエフェクトが欲しいです。そして、彼女の髪に巻き付いたペニスに囲まれてマスターベーションをし、いつもと同じように髪を太く滑らかに保ちながら終わらせてほしい。彼女の髪にザーメンがかかっているバージョンもあれば最高です。彼女に流れるようなロングドレスを着せてくれたら最高だ！\n\nhttps://www.pixiv.net/en/artworks/98545728", "created_at": "", "completed_at": ""}]}