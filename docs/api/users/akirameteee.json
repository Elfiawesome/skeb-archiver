fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=559ffafbe3860f927eee04b18bf3dfc4", "thumbnail_srcset": "https://si.imgix.net/5cc29e5f/uploads/origins/40579fa1-94ea-4769-abe6-9a255180a8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=559ffafbe3860f927eee04b18bf3dfc4, https://si.imgix.net/5cc29e5f/uploads/origins/40579fa1-94ea-4769-abe6-9a255180a8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=619d6f949e775c6d69648d882be50e43 2x, https://si.imgix.net/5cc29e5f/uploads/origins/40579fa1-94ea-4769-abe6-9a255180a8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af6c3230ee347041a435f4b72c58f903 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akirameteee/works/23", "thumbnail_src": "https://si.imgix.net/3a7e45b4/uploads/origins/d0f68b71-8b41-4c59-9e7c-5ea53cce4bff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f06cb127fd20e4b8b7c3d22415b8e481", "thumbnail_srcset": "https://si.imgix.net/3a7e45b4/uploads/origins/d0f68b71-8b41-4c59-9e7c-5ea53cce4bff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f06cb127fd20e4b8b7c3d22415b8e481, https://si.imgix.net/3a7e45b4/uploads/origins/d0f68b71-8b41-4c59-9e7c-5ea53cce4bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29a8c7fef054603170e9951211bc1d27 2x, https://si.imgix.net/3a7e45b4/uploads/origins/d0f68b71-8b41-4c59-9e7c-5ea53cce4bff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c95c9b862efd7a8f5