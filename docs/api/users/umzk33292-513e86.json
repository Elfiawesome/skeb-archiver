f7f-4252-8369-00c68ba85308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88bf31f18bb2d2ae3fa087f2ec7fcf27, https://si.imgix.net/defd36e9/uploads/origins/9efdd696-7f7f-4252-8369-00c68ba85308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f488f535b62891462a0a2c024378534 2x, https://si.imgix.net/defd36e9/uploads/origins/9efdd696-7f7f-4252-8369-00c68ba85308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15fca10bd636485a8ad02273a8d489ca 3x", "genre": "art", "nsfw": true, "body": "UMZK様、ご多忙の中すいません\n\n実はもう一つリクエストを思いつきましたので\n\nメッセージを送らせていただきました。\n\n\nリクエストの内容なのですが、\n\n刀剣乱舞のキャラクターである源清麿が、性奴隷に落とされた同田貫正国に対して、\n\n足コキ、ちくび責め、言葉責め、臭い責めを行うといったイラストを描いていただきたく存じます。\n\n源清麿は資料URLの服装でお願いできたらというのと、裸足にトレンカを履いているという設定で\n\nお願いします。臭い責めに関しては紫色のシューズの履き口を同田貫の鼻に押し当てる感じでお願いします。\n\n足は大きめに描いてくれると嬉しいです。\n\n足のサイズの大きさに目安\n（大）　　　　　　　　　　　（小）\n源清麿＞山姥切国広（極）＞加州清光\n\nhttps://tadaup.jp/38a09e0d4.png", "created_at": "", "completed_at": ""}, {"path": "/@umzk33292/works/8", "thumbnail_src": "https://si.imgix.net/6e8395b3/uploads/origins/bba490d9-0a51-495e-a8bf-16845c9416d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcbe84703e44d64af35f80915fbe9c91", "thumbnail_srcset": "https://si.imgix.net/6e8395b3/uploads/origins/bba490d9-0a51-495e-a8bf-16845c9416d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcbe84703e44d64af35f80915fbe9c91, https://si.imgix.net/6e8395b3/uploads/origins/bba490d9-0a51-495e-a8bf-16845c9416d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deff2b2f0ecfd55d2849b199137ce213 2x, https://si.imgix.net/6e8395b3/uploads/origins/bba490d9-0a51-495e-a8bf-16845c9416d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c21d73a1b24bf060241614687e6686aa 3x", "genre": "art", "nsfw": true, "body": "度々すいません、UMZK様\n\n今回の依頼が二つ目の依頼となります。\n\n刀剣乱舞の加州清光（極）が山姥切国広（極）によって性奴隷に落とされた同田貫正国に対して、\n足コキ、言葉責め、乳首責め、臭い責め、中出しを一緒に行うといった内容の絵を描いて頂きたいのですが。\n\n加州清光は裸足にトレンカ的なものを身に着けているという設定でお願いします。\nそして、山姥切国広（極）は同田貫のケツを犯すという感じでお願いします。\n加州清光（極）は同田貫に対して足コキ、ちくび責め、臭い責め、言葉責めを行うという内容でお願い出来たらと思います。あとは、言葉責めに関しては、加州はオラオラ系（ヤンキー系）でお願いします。山姥切は蔑むような感じでお願いできたらと思います。\n\n\n\n一件目と同じく、双方足を大きめに描いてくれると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@umzk33292/works/7", "thumbnail_src": "https://si.imgix.net/80fbd623/uploads/origins/65eb806b-fd05-4780-aec4-e271d0fed941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610ef13b3c58c45f2a6f7038a3d531f3", "thumbnail_srcset": "https://si.imgix.net/80fbd623/uploads/origins/65eb806b-fd05-4780-aec4-e271d0fed941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610ef13b3c58c45f2a6f7038a3d531f3, https://si.imgix.net/80fbd623/uploads/origins/65eb806b-fd05-4780-aec4-e271d0fed941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43261abc68cc86d05d24d37954cd2f77 2x, https://si.imgix.net/80fbd623/uploads/origins/65eb806b-fd05-4780-aec4-e271d0fed941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=584ad5937b4a6605e137afc21f8db8f7 3x", "genre": "art", "nsfw": true, "body": "UMZK様\n\n初めまして、こたつと申します。\nいつも作品を楽しく拝見させていただいております。\n\nこの度、イラストのリクエストを２つお送りできたらと思っております。\nそのうちの一つが今回の依頼となります。\n\n\nさてリクエスト内容なのですが、\n刀剣乱舞のキャラクターである山姥切国広（極）が同じく\n刀剣乱舞のキャラクターである同田貫正国に対して、\n乳首責め、足コキ、言葉責め、臭い責めを行うといった内容の絵を描いて頂きたいのですが・・・。\n\n山姥切国広（極）は足に脚絆（トレンカ？）的なものを履いているという設定でお願いします。\n同田貫は上半身の服をはぎ取られて、乳首が勃っているような感じでお願いします。\n\nそして言葉責めでは、蔑むような感じでお願いできたらと思います。\n\nご多忙かとは思われますが、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@umzk33292/works/6", "thumbnail_src": "https://si.imgix.net/bfc1077c/uploads/origins/cad4cdea-91c6-4b5f-8271-2f6c7abdb610?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=833617231fc340a53c622233babc1d68", "thumbnail_srcset": "https://si.imgix.net/bfc10