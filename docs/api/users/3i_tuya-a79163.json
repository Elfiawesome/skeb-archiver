資料通りにお願いします。\n\n【使用用途】\nOC資料として他コミッションに使用\n一次創作(小説)の挿絵として使用\n\n【その他】\n金額が足りない、または描きたくないと思われる場合はお気軽にキャンセルして頂いて構いません。\nその場合は、また別のリクエストを再送させて頂きます。\n\nhttps://drive.google.com/drive/folders/12rJF2mrty7j4TKCSBGt9uuiOaW2lswiK", "created_at": "", "completed_at": ""}, {"path": "/@3i_tuya/works/18", "thumbnail_src": "https://si.imgix.net/ba42237e/uploads/origins/343c9b96-aa86-4bca-a7b9-8f79c1c10c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df3d2c2e1828e9f6fe096a6bce8707fd", "thumbnail_srcset": "https://si.imgix.net/ba42237e/uploads/origins/343c9b96-aa86-4bca-a7b9-8f79c1c10c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df3d2c2e1828e9f6fe096a6bce8707fd, https://si.imgix.net/ba42237e/uploads/origins/343c9b96-aa86-4bca-a7b9-8f79c1c10c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83f3c2d32d13ca1a9872637ae6b6284b 2x, https://si.imgix.net/ba42237e/uploads/origins/343c9b96-aa86-4bca-a7b9-8f79c1c10c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=baad0b8e44b636c7249c88b04092792e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3i_tuya/works/17", "thumbnail_src": "https://si.imgix.net/075ea3da/uploads/origins/9021ead8-2a1b-4552-8046-17574e5c86f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f511c9d98a472ab68885fcc37150120c", "thumbnail_srcset": "https://si.imgix.net/075ea3da/uploads/origins/9021ead8-2a1b-4552-8046-17574e5c86f