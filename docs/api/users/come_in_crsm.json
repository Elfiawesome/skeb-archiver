b5b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daba074e833cef7495a0d8478c35309a, https://si.imgix.net/1fc8c91a/uploads/origins/eebb63cb-2cd8-4833-a733-f87d9ee5b5b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51fa285bf73388ea024801db6eb1d7dd 2x, https://si.imgix.net/1fc8c91a/uploads/origins/eebb63cb-2cd8-4833-a733-f87d9ee5b5b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a37d29a1c542bd2cc7f68764472814 3x", "genre": "art", "nsfw": false, "body": "先生はじめまして！突然のメッセージ失礼致します。絵がとても好きなのでリクエストを送らせていただきました。もしよければ私の創作キャラーを描いてくれませんか？˃˂\nキャラは下記URLに：\nhttps://1drv.ms/f/s!AtkR3GfAIb2fmCWQq087LVMNy8Do?e=SPcaMW\nの三人をお願いいたします。\nネイービ色髪の男子校生（16）は生徒会長だけど、天然でいつも笑顔で。\nピンク色の男子校生（16）はクールなイメージで、非常に理性な人です。\n黒髪の子（14）はツンデレな後輩のイメージです。\nピンク髪と黒髪は仲が悪く、仲直りさせるのはいつもネイービ髪の子です。\n先生のキャラクターに対する解釈が好きなので。自由に描いて頂けると嬉しいです。\n複数人になってしまい申し訳ありません、ご検討いただけると嬉しいです…！ 不備や金額不足がありましたら、ぜひ再送要請していただきたいです。 もしご不便な点がございましたら、キャンセルしていただいても構いませんので、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@come_in_crsm/works/5", "thumbnail_src": "https://si.imgix.net/f7d11bc5/uploads/origins/a70cef96-064b-4fb5-9532-0673323b5381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9926b782f3d664b36111954c5ed5bd28", "thumbnail_srcset": "https://si.imgix.net/f7d11bc5/uploads/origins/a70cef96-064b-4fb5-9532-0673323b5381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9926b782f3d664b36111954c5ed5bd28, https://si.imgix.net/f7d11bc5/uploads/origins/a70cef96-064b-4fb5-9532-0673323b5381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a377535ec235a80720b1e114f3b23ecc 2x, https://si.imgix.net/f7d11bc5/uploads/origins/a70cef96-064b-4fb5-9532-0673323b5381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b7b7a30f4d83f41ccf21089241a1031 3x", "genre": "art", "nsfw": false, "body": "かもまいる様、初めまして。\nいつも素敵なイラストを拝見させていただいております。\nかもまいる様の繊細なタッチや色遣いから様々な表現を通してキャラクターの個性や魅力が丁寧に描かれていてとてもクールな作風だと感じ、強く惹かれていました。\n\nよろしければ、私のオリジナルキャラクター二名を描いていただきたいと思いこの度リクエストを送らせていただくことにいたしました。\n以下が詳細です。\n\nキャラクター\n\n福永 友哉(ふくなが ゆうや)\n16歳の高校1年生。身長は172cm。\n非の打ち所のない男子生徒。\n普段は温厚で心優しいが、それに反して色々な場面で物騒な想像をしてしまうことが多くそれに悩まされている。(加害恐怖のようなもの)\n\n品川 聡(しながわ さとし)\n福永の同級生。身長178㎝。\n生まれつき目が見えない男子高校生。\n好奇心旺盛で底抜けにポジティブ。福永をよく励ましたりからかったり褒めたりとそのときどきで気まぐれに接してくる。\n\nこちらが参考資料です。\nhttps://drive.google.com/drive/folders/1ozPPKBJZg6qOqN9bCAFl6MbdACk7K44V?usp=drive_link\n\nシチュエーションや構図等はお任せいたします。\nデザインはご自由に変えていただいて大丈夫です。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@come_in_crsm/works/4", "thumbnail_src": "https://si.imgix.net/2c8ad9f0/uploads/origins/fc04c93c-d030-45d0-b5c7-9581d9a86159?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=374353416463de6f2f1678a6f04bbd3f", "thumbnail_srcset": "https://si.imgix.net/2c8ad9f0/uploads/origins/fc04c93c-d030-45d0-b5c7-9581d9a86159?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=374353416463de6f2f1678a6f04bbd3f, https://si.imgix.net/2c8ad9f0/uploads/origins/fc04c93c-d030-45d0-b5c7-9581d9a86159?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf6ebf1b2e8ea550ee111be1514f4866 2x, https://si.imgix.net/2c8ad9f0/uploads/origins/fc04c93c-d030-45d0-b5c7-9581d9a86159?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec88c8c82638fa431014784b44c18c01 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nskebの新着にてかもまいる様の作品を拝見し、作品がどれも大変好みでしたので、ぜひうちの子を描いていただきたいと思いリクエストをお送りしております！\n柔らかな雰囲気や塗りと、人物の儚げな表情が特に好きです…！🥲\nご縁がありましたら、どうぞよろしくお願いします🙇‍♂️\n\n今回依頼をしたいのは、私のOC2人になります。\n資料は下記の通りです。\nhttps://drive.google.com/drive/folders/1-CC_KeJukJWaEZmyGhlfKIHKHSpQEFdh\n不明瞭な部分については捏造、簡略化等していただいて構いません。\n\n男は雷、女は煙にまつわる異能を持っており、東京がモチーフの街で怪異と戦う仕事をしています。\n\n構図等の指定は特にございませんので、かもまいる様の描きやすいように描いていただければ幸いです。\n\n依頼文は以上となります。\nここまでお読みいただきありがとうございました！\n金額や内容等がそぐわなければ、遠慮なくキャンセルしていただいて構いません…！🙇‍♂️\nご縁があることをお祈りしつつ、今後ともかもまいる様のご活躍を陰ながら応援しております💐\nそれでは、失礼いたします。", "created_at": "", "completed_at": ""}, {"path": "/@come_in_crsm/works/3", "thumbnail_src": "https://si.imgix.net/b6ceb851/uploads/origins/e9c307e6-162e-426e-8032-18011435ac79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce2de4a5605e90f2f23aaa74a16c319a", "thumbnail_srcset": "https://si.imgix.net/b6ceb851/uploads/origins/e9c307e6-162e-426e-8032-18011435ac79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce2de4a5605e90f2f23aaa74a16c319a, https://si.imgix.net/b6ceb851/uploads/origins/e9c307e6-162e-426e-8032-18011435ac79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96626ee8d3adfca8c46ca266267334f8 2x, https://si.imgix.net/b6ceb851/uploads/origins/e9c307e6-162e-426e-8032-18011435ac79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e8a7e634830ea4c9454f17a4833731b 3x", "genre": "art", "nsfw": false, "body": "はじめまして！絵柄のタッチと人物の表情に一目惚れをしました。\n私と友人のOC（TRPGの自キャラ）でイラストをお願いできますでしょうか……！\n（お相手様よりOCの使用許可はいただいております。）\n\n\n▍使用用途（※すべて個人利用範囲です）\n・お相手との作品物共有\n\n▍キャラクターについて\n　男が亡くなり、死別した2人です。ドライブに詳細があります。\n\n▍構図、シチュエーション\n・手を伸ばしあっているのに何か（鏡や境界線など）で隔たれている（生者と死者の示唆）\n・噛み合わない視線\n・背景はあの世とこの世の境目のような、幻想的なもの\n\n\nもし金額不足などがあれば対応いたしますので、ご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1frXAwEE2nbcKkuFjjvcl5qNjUOPHg2y7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@come_in_crsm/works/2", "thumbnail_src": "https://si.imgix.net/c988d675/uploads/origins/371aa3cc-05d9-4bd9-8b73-628b7c65fa12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fda9ad381ff80cb03bee58eee70861c", "thumbnail_srcset": "https://si.imgix.net/c988d675/uploads/origins/371aa3cc-05d9-4bd9-8b73-628b7c65fa12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fda9ad381ff80cb03bee58eee70861c, https://si.imgix.net/c988d675/uploads/origins/371aa3cc-05d9-4bd9-8b73-628b7c65fa12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2b8c928e2f1c67ebfd77bebfa102c50 2x, https://si.imgix.net/c988d675/uploads/origins/371aa3cc-05d9-4bd9-8b73-628b7c65fa12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d73d9c6b57228fca75086ff1718a1cd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n君の絵は本当にクールだね！僕のキャラクターで何かやってほしいな :)\nデザインを変更するのもご自由にどうぞ！ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1gNVRFdrkf_3QRgdzB4ly5OCRRg6O67oS?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@come_in_crsm/works/1", "thumbnail_src": "https://si.imgix.net/e34a3288/uploads/origins/f56f4f98-a480-45ec-adc1-3c99db97c850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94d69967100ddbb3e51c0f5a92ba845f", "thumbnail_srcset": "https://si.imgix.net/e34a3288/uploads/origins/f56f4f98-a480-45ec-adc1-3c99db97c850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94d69967100ddbb3e51c0f5a92ba845f, https://si.imgix.net/e34a3288/uploads/origins/f56f4f98-a480-45ec-adc1-3c99db97c850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa06fd8c423b12b4577ab04a18ec1cb5 2x, https://si.imgix.net/e34a3288/uploads/origins/f56f4f98-a480-45ec-adc1-3c99db97c850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2c51cd80c843f5d2dc94bde138e9b30 3x", "genre": "art", "nsfw": false, "body": "リクエスト再送させていただきます！\nかもまいる様、はじめまして。\n先日、SNSで二次創作のイラストをお見かけした際にかもまいる様のことを知り、作品の数々に一目惚れしました。絵柄や色使いが可愛らしかったり綺麗だったりするだけでなく、キャラクターの個性や魅力を大事に描かれているように感じました。\n\nもし宜しければ、私と友人のCoC探索者たちのイラストを描いていただきたく思います。依頼内容の詳細は下記に記載しております。\nご検討いただけますと幸いです。\n\n∞ ----- ∞\n以下２名は、楽曲動画投稿者とバーチャルシンガーです。\n\n▼キャラクター情報①\n名前／恩賀 奏千(おんが たいち)\nプロフィール／楽曲動画投稿者\n21歳、男性、身長165cm。卑屈で人間嫌い。自信は無いが変なところでプライドがある。好きなものは明太子ご飯。\nNATUに対して／呼称「NATU」\n声を聴くと安心する。彼女の対応にいつも困らせられている。自分が誰よりも彼女を上手く歌わせられると思っている。彼女の容姿や服装には普通に照れている。\n▼キャラ①参考画像\n※CoCシナリオのネタバレになる資料はありません。\nhttps://drive.google.com/drive/folders/1-kJ1a-oHFhRHKaSSXgGYQ2NLhe63nDYj\n\n\n▼キャラクター情報②\n名前／NATU(なつ)\nプロフィール／バーチャルシンガー\n26歳、女性、身長177cm。狡知に長けている。穏やかな人柄だがその実、歌うことのために人を騙すことを厭わない。好きなものは歌とかき氷。歌うこと以外に熱意がない。\n恩賀奏千に対して／呼称「ボク」\n幼い子を扱うように「ボク」と呼ぶ。自分の声を最大限に活かす曲を作る作曲家だと認めている。しかし、対応は冷ややか。\n▼キャラ②参考画像\n※CoCシナリオのネタバレになる資料はありません。\nhttps://drive.google.com/drive/folders/1QFQloIDr6IvVCJBU0pxEB1NIRqEZ_jor?usp=drive_link\n\n∞ ----- ∞\n▼こちらからの指定\nサイズ、シチュエーション、表情、構成など全てお任せ致します。\n\n▼使用用途\n個人鑑賞用です。", "created_at": "", "completed_at": ""}]}