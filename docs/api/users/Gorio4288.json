b587-16b0220ca72c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1881976f0b487b74ae4e5c4cce786439 3x", "genre": "art", "nsfw": true, "body": "いつも大変お世話になっております。\n今回もコイカツで作成したオリキャラの立ち絵のイラストをお願いします。\n使用内容も前回と同じで個人的使用、他の絵師さんに依頼の際の資料として使用させていただきます。\n\n差分も前回と同様に普段着、戦闘服、裸をお願いできればと思います\n\n〇キャラ詳細\n名前：琥瑚理（ここり）\n一人称：うち\n呼ばれ方：琥珀理様、こっこさま(幼い子供から)\n種族：狸神（たぬきがみ）\n\n〇容姿\n髪型：ふわっとしたくせ毛のロング\n身体： 170cm（猫背気味なので見た目はもう少し低く感じる）　ぽっちゃり体型で少し足が短め\n髪色：全体の髪色は薄い栗色で毛先が山吹色になっている\n瞳： 栗色\n服装：山吹色と黒を基調とした服装中にレオタード。他二人よりも着こんでいる\n宝玉が付いた首輪を付けている。(精神状態や神力によって変色する)\n参考画像(https://drive.google.com/drive/folders/1LmQwmXeNttmdN0gMgQunds1rdUKZnq-a?usp=drive_link）\n\n\n〇背景設定や性格\nこちらのURLに詳しく書いているので確認お願いします。\nhttps://www.pixiv.net/artworks/139142065\n\n書きにく所などがあったら改変していただいて大丈夫です。\n料金不足等の場合は再送要請をしていただければと思います。\n検討の方をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/147", "thumbnail_src": "https://si.imgix.net/262c327d/uploads/origins/0275905f-247b-42fc-a52a-2c36424c2e5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90db47572e06c6c07069d920bbf9b169", "thumbnail_srcset": "https://si.imgix.net/262c327d/uploads/origins/0275905f-247b-42fc-a52a-2c36424c2e5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90db47572e06c6c07069d920bbf9b169, https://si.imgix.net/262c327d/uploads/origins/0275905f-247b-42fc-a52a-2c36424c2e5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e177e475f81d026218995bba6977c8bf 2x, https://si.imgix.net/262c327d/uploads/origins/0275905f-247b-42fc-a52a-2c36424c2e5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1aafc8c1370d21a62a553b30f207683b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/146", "thumbnail_src": "https://si.imgix.net/ac0132ac/uploads/origins/85fe5d51-324b-4917-b7db-ede9344fa696?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c79f4a5f053fc2487e148571c39709", "thumbnail_srcset": "https://si.imgix.net/ac0132ac/uploads/origins/85fe5d51-324b-4917-b7db-ede9344fa696?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c79f4a5f053fc2487e148571c39709, https://si.imgix.net/ac0132ac/uploads/origins/85fe5d51-324b-4917-b7db-ede9344fa696?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca71913f6f8023605e7e0f61b6fbe12a 2x, https://si.imgix.net/ac0132ac/uploads/origins/85fe5d51-324b-4917-b7db-ede9344fa696?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d99ae972a27d9a7571ca14558db0234f 3x", "genre": "art", "nsfw": true, "body": "こんにちは。素敵なクリスマス/ホリデーシーズンをお過ごしでしょうか。\n\nこのリクエストの続編の漫画1ページをお願いしたいです。 https://is.gd/mbN4oP\n\nその他のキャラクター紹介： https://is.gd/IH3kqP\n\nレイアウトは自由ですが、もし送っていただいた量が足りない場合は再送をお願いいたします。\n\n彼女のトップスはこのように捲り上げられ、胸が露わになっています。 https://is.gd/2C0MON\n\n少年（ハルト）はズボンを脱ぎ、ベッドに仰向けに寝ています。女性（セラ）の大きな胸がトップスからこぼれ落ち、豊満な胸が彼の太ももに重く押し付けられています。セラはハルトに、彼女（アイコ）と彼女のどちらが好きか尋ねます。セラはハルトのペニスにローションを塗りますが、ハルトは言葉を失います。世良は、別れなければ「家庭教師」の仕事を辞めさせられると告げる。ハルトが別れられないと言いかけたその時、世良は大きな胸を彼のペニスに巻き付け、ハルトはうめき声をあげる。\n\n最後の胸揉みポーズの参考：https://is.gd/WYVkfe\nペニスの先端だけが見える、あるいは完全に隠れているのが理想だ。彼女の大きな胸に、まるで天にも昇るような力で包み込まれるような、そんな風に感じて欲しい。", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/145", "thumbnail_src": "https://si.imgix.net/bdf4bbd9/uploads/origins/ee1d56f6-8eab-409b-b262-56c3e10a7453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f4c1d3378694546ec0e580a5aab0e7", "thumbnail_srcset": "https://si.imgix.net/bdf4bbd9/uploads/origins/ee1d56f6-8eab-409b-b262-56c3e10a7453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f4c1d3378694546ec0e580a5aab0e7, https://si.imgix.net/bdf4bbd9/uploads/origins/ee1d56f6-8eab-409b-b262-56c3e10a7453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d70ba1185e5bbc7c556e5a5bed8b47ac 2x, https://si.imgix.net/bdf4bbd9/uploads/origins/ee1d56f6-8eab-409b-b262-56c3e10a7453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43650d3c1bca8d751d7ddc583558666e 3x", "genre": "art", "nsfw": true, "body": "今回描かせていただくのはHUNTER×HUNTERに登場するキャラクター、[パクノダ]です。   ストーリー：ゴンとキルアは、旅団の居場所を突き止めるため に、うっかり捕まってしまった。彼らの目的を聞き 出すために、旅団は情報収集能力を持つパクを担当 させた。パクは巨大な胸と念能力「正直な母乳」を 使ってゴンとキルアを屈服  \n\n構図：車内で、パークが真ん中に座って、両側にいるゴンとキルアに授乳している様子を描いてください。   \n\nその他の補足：\n 1.パークの服は胸が見えるように描いてください。 \n\n2ゴンとキルアの服はリンクを参照してください。  \n\n3.パークの顔の表情は、「気持ちよくて白目をむいている」のと「興奮して唇を噛んでいる」の2種類で描き分けてください。 \n\n4.先生に今度パクノダの胸をいつもより大きく描いていただきたいと思います  \n\n参照：\nhttps://drive.google.com/file/d/1uirWj8wPSRyppTRXu8w4tImNhvq0HzAF/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/144", "thumbnail_src": "https://si.imgix.net/d22f988a/uploads/origins/2316cb51-ff4d-4db9-b397-e81bc921573d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e38a727801b6da17c4e81d8b489df91", "thumbnail_srcset": "https://si.imgix.net/d22f988a/uploads/origins/2316cb51-ff4d-4db9-b397-e81bc921573d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e38a727801b6da17c4e81d8b489df91, https://si.imgix.net/d22f988a/uploads/origins/2316cb51-ff4d-4db9-b397-e81bc921573d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7580b0b7ca92fd265e79c7f6a3d19f6c 2x, https://si.imgix.net/d22f988a/uploads/origins/2316cb51-ff4d-4db9-b397-e81bc921573d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0daa9d65f78e887a44f2bf5bda64796c 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nオリジナルキャラクターのキャラデザをリクエストさせていただきます。\n※個人鑑賞、依頼時の参考資料としての利用を考えています。ご了承ください。\n\nコンセプト\n『無愛想な賞金稼ぎ』\n\n容姿\n・女性\n・筋肉質\n・褐色肌\n・高身長\n・巨乳\n・白い髪\n・金色の瞳\n・ガンマン風の衣装(FGOのビリー・ザ・キッドのイメージです。)\n\n簡単な設定\n私情を挟まず淡々と仕事をこなす、雇われの賞金稼ぎ。\nその振る舞いから無愛想に見られるが、実際はただ恥ずかしがっているだけ。\n\nまた、可能であれば全裸差分をお願いします。\n\n不明な点はゴリオ先生にお任せします。ゴリオ先生の描きやすいようにしていただいて構いません。\n\n以上、ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/143", "thumbnail_src": "https://si.imgix.net/86ff05d5/uploads/origins/f93b4b81-7ae2-41d9-9b90-e2bfb9b07073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffb0468a6af26c7ed742c97b9ce9d6f", "thumbnail_srcset": "https://si.imgix.net/86ff05d5/uploads/origins/f93b4b81-7ae2-41d9-9b90-e2bfb9b07073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffb0468a6af26c7ed742c97b9ce9d6f, https://si.imgix.net/86ff05d5/uploads/origins/f93b4b81-7ae2-41d9-9b90-e2bfb9b07073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=122e4c69b8155370f39fbc6d575de74a 2x, https://si.imgix.net/86ff05d5/uploads/origins/f93b4b81-7ae2-41d9-9b90-e2bfb9b07073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=049db77adf1f5da18bce8130cd2969fc 3x", "genre": "art", "nsfw": true, "body": "新しいワンピースのリクエストがある。バッキンガム・ステューシーは \"白ひげ \"エドワード・ニューゲートに騎乗位し、彼の子供を妊娠しようとしている。ニューゲートのチンコは二人の体格差からステューシーには大きすぎるが、彼女は十分に強い。\n2人とも全盛期。神谷事件の時の姿と衣装を使う。シーンはニューゲートの視点から。\n動きのあるサインを入れてください。ステューシーはニューゲートの巨根の上で上下に跳ねている。", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/142", "thumbnail_src": "https://si.imgix.net/0dd8a121/uploads/origins/1f5ecc01-e4fd-4794-8399-4bfdc18ca174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8ef019f1f56a9dc999ad5f530ec9c7", "thumbnail_srcset": "https://si.imgix.net/0dd8a121/uploads/origins/1f5ecc01-e4fd-4794-8399-4bfdc18ca174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8ef019f1f56a9dc999ad5f530ec9c7, https://si.imgix.net/0dd8a121/uploads/origins/1f5ecc01-e4fd-4794-8399-4bfdc18ca174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6ce9284c730a868e424e5040f6d7e24 2x, https://si.imgix.net/0dd8a121/uploads/origins/1f5ecc01-e4fd-4794-8399-4bfdc18ca174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67713f58b8eb9d3ec0f680f3efa34501 3x", "genre": "art", "nsfw": true, "body": "こんにちは！マイ・バレンタインがいつものコスチュームで壁にはまり、上半身を脱がされ、触手に嬲られ、絶頂を迎えてミルクを噴き出すのを楽しむというのはどうでしょう？触手で口も使わせるとか？これを参考にして、自由にディテールを変えて、自分だけのものにしてみては？\n\nhttps://skeb.jp/@IerouYellow/works/20\n\nhttps://skeb.jp/@honotomo7/works/51\n\nhttps://skeb.jp/@ればすと102702/works/712\n\nhttps://skeb.jp/@yagamiTSR/works/208", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/141", "thumbnail_src": "https://si.imgix.net/3d6a7c93/uploads/origins/27c9e3aa-1420-4fa2-8c2d-af4f084acfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad8186d4150bd2c264c8f48db4414ed7", "thumbnail_srcset": "https://si.imgix.net/3d6a7c93/uploads/origins/27c9e3aa-1420-4fa2-8c2d-af4f084acfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad8186d4150bd2c264c8f48db4414ed7, https://si.imgix.net/3d6a7c93/uploads/origins/27c9e3aa-1420-4fa2-8c2d-af4f084acfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a236f87647d4e56800ccdbaf160d51b 2x, https://si.imgix.net/3d6a7c93/uploads/origins/27c9e3aa-1420-4fa2-8c2d-af4f084acfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ad7304e6d7af1e9df6ff69b3ee52b27 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/140", "thumbnail_src": "https://si.imgix.net/8e519a0f/uploads/origins/106d0cb0-306f-4417-93f6-b5a568165b27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9afb8eb4b2fb408c0c4af3b2c28b5e34", "thumbnail_srcset": "https://si.imgix.net/8e519a0f/uploads/origins/106d0cb0-306f-4417-93f6-b5a568165b27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9afb8eb4b2fb408c0c4af3b2c28b5e34, https://si.imgix.net/8e519a0f/uploads/origins/106d0cb0-306f-4417-93f6-b5a568165b27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65042dd9e545a2774467a4b0c5c520cf 2x, https://si.imgix.net/8e519a0f/uploads/origins/106d0cb0-306f-4417-93f6-b5a568165b27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c36b3e26be144b1e9f2f5dc68f28708 3x", "genre": "art", "nsfw": true, "body": "よろしければまつもとかつや氏のOC「クーデルカ・オースティン」という子でえっちな漫画をお願いできますでしょうか？\nhttps://www.pixiv.net/artworks/45198116\n\n構図は先生が以前描いていたこちらのような感じで、クーデルカさんより体格の良い男性に羽交い絞めされながらの後背位の構図で、おっぱいをぶるんぶるん揺らしながらの激しいセックスの様子をお願いします。\nhttps://www.pixiv.net/artworks/125151594\n\n衣装はほぼ全裸で問題ありません。\nおっぱいがとても大きく、全身むちむちのため出来る限り豊満な感じにしてもらえると嬉しいです。\nまた彼女は陥没乳首ですがこちらはフル勃起で大丈夫です。\n表情はイカされてる様子で、これくらい無様なアヘオホ顔を晒していて欲しいです。\nhttps://www.pixiv.net/artworks/40943776\nよろしければご検討お願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/139", "thumbnail_src": "https://si.imgix.net/70953ddd/uploads/origins/47633d8c-9e3d-4bf3-b5d3-5e8286fc6611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea5a59df5b8903749954f790d83553d", "thumbnail_srcset": "https://si.imgix.net/70953ddd/uploads/origins/47633d8c-9e3d-4bf3-b5d3-5e8286fc6611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea5a59df5b8903749954f790d83553d, https://si.imgix.net/70953ddd/uploads/origins/47633d8c-9e3d-4bf3-b5d3-5e8286fc6611?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=723b9e1a5b801ac6fcb7d6f2428769d1 2x, https://si.imgix.net/70953ddd/uploads/origins/47633d8c-9e3d-4bf3-b5d3-5e8286fc6611?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a93ac665f1287b5acf3245bf61a47604 3x", "genre": "art", "nsfw": true, "body": "バイザー・デスとバイザー・ショックに捕らえられたマイ・バレンタインが、バトル・シティのユニフォーム（白のチューブトップに紫の紐付きコルセット、紫のジャケットとスカート、手のひらから中腕までの白い腕の長さの袖）を着ているところを映してもらえますか？以下参考資料！\nhttps://skeb.jp/@Kta_osushi/works/192\nhttps://skeb.jp/@rakuraku_kmczk/works/134。\n\nhttps://www.pixiv.net/en/artworks/131598448\n\nhttps://www.pixiv.net/en/artworks/129479985\n\nマイは大きな胸と豊かな谷間を持つことができる。マイのコスチュームは、白いチューブトップと部分的な腕の袖、紫のジャケットとスカート。\n\n\nhttps://skeb.jp/@rakuraku_kmczk/works/134\n\nhttps://skeb.jp/@ればすと102702/works/516\n\nhttps://www.pixiv.net/en/artworks/117125253\n\nhttps://skeb.jp/@notogoro/works/23\nhttps://www.pixiv.net/en/artworks/122785397#manga\n\nhttps://skeb.jp/@chibotakun/works/64", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/138", "thumbnail_src": "https://si.imgix.net/5d6a866a/uploads/origins/a5752d3c-1978-4e65-9cf1-cff9a6667af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a09c90d93b6738599e872326e496da", "thumbnail_srcset": "https://si.imgix.net/5d6a866a/uploads/origins/a5752d3c-1978-4e65-9cf1-cff9a6667af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a09c90d93b6738599e872326e496da, https://si.imgix.net/5d6a866a/uploads/origins/a5752d3c-1978-4e65-9cf1-cff9a6667af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c6c57de944a2bd266ce0c37b25bb6fa 2x, https://si.imgix.net/5d6a866a/uploads/origins/a5752d3c-1978-4e65-9cf1-cff9a6667af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa0cdf58f2a95fa241403725abb95c9b 3x", "genre": "art", "nsfw": true, "body": "ゴリオ先生、こんにちは！私の新しいリクエストを受け入れてもらえると嬉しいです！\n\n私のキャラクター、アドリアナが筋肉質な黒人男性と激しいアナルセックスをしているカラーイラストです。\nアドリアナが巨尻巨乳の豊満ボディであることを確認してください。\n彼女は後ろから挿入され、近未来的なコントロールパネルにもたれています。彼女の大きなお尻がよく見えるようにしてください。\n彼女は黒と白の破れた宇宙ジャンプスーツを着ることができる。https://skeb.jp/requests/2864833\nアドリアナは、怒ったような照れたような表情でも構いません。アナルクライマックスの時のアヘ顔表現もお願いしたいです。\n舞台はSFの宇宙船でお願いします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1pCTpRdOkoeUumCVPpwcGqyX8e2ExKiFf?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/137", "thumbnail_src": "https://si.imgix.net/66e186ff/uploads/origins/9b917e5e-51f6-4d7c-b69b-437598b756f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d47af512f5c1c37c88a69c8f61bb59b6", "thumbnail_srcset": "https://si.imgix.net/66e186ff/uploads/origins/9b917e5e-51f6-4d7c-b69b-437598b756f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d47af512f5c1c37c88a69c8f61bb59b6, https://si.imgix.net/66e186ff/uploads/origins/9b917e5e-51f6-4d7c-b69b-437598b756f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c87300622b68f9171d1222bb45219cc 2x, https://si.imgix.net/66e186ff/uploads/origins/9b917e5e-51f6-4d7c-b69b-437598b756f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5fc1da22510746b73645b2d72ca7f35 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gorio4288/works/136", "thumbnail_src": "https://si.imgix.net/b6969048/uploads/origins/4463b4a2-b7e1-40fa-ba35-f0e60715b024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63c806091d8158dc545c9f0b132b194c", "thumbnail_srcset": "https://si.imgix.net/b6969048/uploads/origins/4463b4a2-b7e1-40fa-ba35-f0