30&txt=PRIVATE&s=a95db2562afd958af2dfaa44336d9126 2x, https://si.imgix.net/b3ca2871/uploads/origins/6b49c52c-576b-47af-a52a-0922ceab10cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d8ecffe79117fd2650f3cd40e429e54 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/12", "thumbnail_src": "https://si.imgix.net/97a7d561/uploads/origins/8a8ce9c6-4473-4d15-b590-c7b169cbbdfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd88276aebd9c03f1a7cebc0e2c93e0b", "thumbnail_srcset": "https://si.imgix.net/97a7d561/uploads/origins/8a8ce9c6-4473-4d15-b590-c7b169cbbdfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd88276aebd9c03f1a7cebc0e2c93e0b, https://si.imgix.net/97a7d561/uploads/origins/8a8ce9c6-4473-4d15-b590-c7b169cbbdfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=873d016d8b2e5d827d95c1e6e3c6d9ef 2x, https://si.imgix.net/97a7d561/uploads/origins/8a8ce9c6-4473-4d15-b590-c7b169cbbdfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f38c5c200f8b40488373441f62db6aa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/11", "thumbnail_src": "https://si.imgix.net/7542fe66/uploads/origins/2cbcb59d-77f8-40e6-b8f5-be3018339d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0cca5d1c558169c3b3dd2a6e20580e6", "thumbnail_srcset": "https://si.imgix.net/7542fe66/uploads/origins/2cbcb59d-77f8-40e6-b8f5-be3018339d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0cca5d1c558169c3b3dd2a6e20580e6, https://si.imgix.net/7542fe66/uploads/origins/2cbcb59d-77f8-40e6-b8f5-be3018339d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32d57f454488ea3dbd9dfdc5a9fd44d2 2x, https://si.imgix.net/7542fe66/uploads/origins/2cbcb59d-77f8-40e6-b8f5-be3018339d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf0c15ac1277784bfd99cdb5187dcb41 3x", "genre": "art", "nsfw": true, "body": "いつもuutさんの作品を大変楽しませていただいております。以前Pixiv等で拝見した法被姿のシリーズが大変気に入っており、他の艦娘たちでも見たいと思いリクエストさせて頂きました。\n今回は、参考URLと同じ格好でお祭りを楽しむJ級姉妹を描いていただけないでしょうか。シチュエーションは、ウキウキした様子のジャーヴィスが少し恥ずかしがってるジェーナスに「次はあっちの方に行こう」といった感じに声をかけている、という内容でお願いします。また、前作のようにお祭りっぽい食べ物や小物を手にしているとありがたいです。差分については、法被なしとふんどし一枚の2種類があると助かります。\nご検討宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/87206737", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/10", "thumbnail_src": "https://si.imgix.net/23c64659/uploads/origins/cbfb27ae-2e33-4017-8f0e-506eedc1fb78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe2b83933207e5e81a18aa188da4dec", "thumbnail_srcset": "https://si.imgix.net/23c64659/uploads/origins/cbfb27ae-2e33-4017-8f0e-506eedc1fb78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe2b83933207e5e81a18aa188da4dec, https://si.imgix.net/23c64659/uploads/origins/cbfb27ae-2e33-4017-8f0e-506eedc1fb78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bb0b8883b441bc8ef4a071a44d18efb 2x, https://si.imgix.net/23c64659/uploads/origins/cbfb27ae-2e33-4017-8f0e-506eedc1fb78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5de54c55eff3f0513728cff13a20b12d 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラスト拝見させていただいています。\nUut.さんの描かれる夕張さんが可愛いので、前回に引き続き再度リクエストをさせていただきました。\n今回のリクエストは夕張さんのNSFWなイラストになるのですが、よろしいでしょうか…？よろしければご検討お願いします。\n\nシチュエーション：またケッコン前、提督の彼女面していた夕張さん。しかし提督に言い寄るライバルの出現に焦ってしまい、混乱していつもの制服の下にマイクロビキニ（白）を装備して提督に色仕掛けで迫ってしまうというもの。（結局提督を困惑させただけで、未遂のままなだめられて終わります）\n\n詳細ですが\n・夕張さんは改二制服。顔を赤らめて焦った表情、瞳にはぐるぐる目の描写あり。上着を胸上までまくり上げ、スカートはホックを外して膝近くまで下がっており、服の下に着用しているマイクロビキニ姿を見せつけている構図。\n・前回リクエストしたうちのオリキャラ提督（https://skeb.jp/@PVA_vinylon/works/9）の肩～手付近が画面の手前端付近に映っていて、夕張の突然の行動に慌てふためいている。（今回顔付近は無理に画面内に映らなくても慌てている様子がわかれば大丈夫です）まだケッコン前という事で互いにケッコン指輪は未装着。\n\n・差分として、「上着＆スカート」の有無・「マイクロビキニ」の有無差分で「全裸描写あり（陰部モザイク修正）」、また「提督描写on/off」が出来るようになっていればと思います。\n\n注文が多くて申し訳ありませんが、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/9", "thumbnail_src": "https://si.imgix.net/6b8ba907/uploads/origins/e861e343-4a8e-4437-9424-ec7b75ca76d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f5ea34f80acf88409a99534f0c6f460", "thumbnail_srcset": "https://si.imgix.net/6b8ba907/uploads/origins/e861e343-4a8e-4437-9424-ec7b75ca76d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f5ea34f80acf88409a99534f0c6f460, https://si.imgix.net/6b8ba907/uploads/origins/e861e343-4a8e-4437-9424-ec7b75ca76d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3e9902cea96c2b35719cb302587dfd3 2x, https://si.imgix.net/6b8ba907/uploads/origins/e861e343-4a8e-4437-9424-ec7b75ca76d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7736a97624c90260e2ad049dfde46db5 3x", "genre": "art", "nsfw": false, "body": "いつも可愛いイラストを拝見させていただいております。\nこの度どうしてもUut.さんに描いてほしいという気持ちが募り、「うちの夕張（艦これ）さんとオリキャラ提督」のイラストをリクエストいたしました。\n\n「うちの夕張さん」は少し衣装にアレンジ加えており、イメージは以前Uut氏が描かれておりました\nこちら(https://www.pixiv.net/artworks/84695593)のイラストのカーディガンが公式夕張制服上着の布地色になったもの。制服下アンダーに首元が隠れる黒のタートルネックを着ている設定です。\n\n「うちの提督」はこのような容姿は資料URLに添付したイメージのもので中性的な容姿。身長は夕張さんより少しだけ高いくらい。衣装はよくある提督白制服＋ズボンなのですが、容姿服装含め描きやすいようにアレンジして頂いて大丈夫です。\n\n夕張さんも提督も、左薬指にケッコン指輪をはめています。\n\n絵のイメージとしては、夕張さんと提督がふたり並んでいて、夕張が提督の片腕に抱き着くようにしがみついていたずらっぽい笑みを浮かべている。提督は困ったようなそれでいて嬉しそうに照れた表情といった具合です。\n\nオリキャラ混じりで大変かと思いますが、よろしくお願いします。\n\nhttps://imgur.com/q24X9aF", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/8", "thumbnail_src": "https://si.imgix.net/305c726f/uploads/origins/6a1448a3-c973-4665-a6b4-75f6b638ae15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f82fb84806bcd5e56facced324143dfe", "thumbnail_srcset": "https://si.imgix.net/305c726f/uploads/origins/6a1448a3-c973-4665-a6b4-75f6b638ae15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f82fb84806bcd5e56facced324143dfe, https://si.imgix.net/305c726f/uploads/origins/6a1448a3-c973-4665-a6b4-75f6b638ae15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47ea4d48b334be21547ea53c989de431 2x, https://si.imgix.net/305c726f/uploads/origins/6a1448a3-c973-4665-a6b4-75f6b638ae15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96a2479f26da06a752fd49593569404b 3x", "genre": "art", "nsfw": true, "body": "前回の沖波・岸波絵、ありがとうございました。\n昨日アップされた夕張さんの梅雨水着モードがとてもよかったので、艦これの鳥海と熊野の組み合わせで同じように水着+透明レインコートの絵をお願いしたいと思います。\n\n水着については、ビキニと、スクール水着の2種類をお願いしたいです。\n・ビキニは、できれば鳥海は公式カレンダーで着用していたもので。熊野は公式水着絵がなかったと思うので、Uut.さんにお任せします。\n・スク水は、肩紐が白のパイピングになっていて、腰の水抜き穴がないもの（いわゆる競スク）\n「ビキニ」「スク水」「全裸」+レインコート有り無し。\n股間は前回と同じくモザイク処理・陰毛なし。\n\n背景はなしでいいですが、想定しているシチュは、提督と公園で待ち合わせをして、これから町を散歩にいく、というような感じ。梅雨水着モードで（または全裸で…）町を歩くのは一般的なことであるかのように自然体な笑顔でお願いします。\n傘の有無はお任せします。\n\n非常に差分が多くなってしまって申し訳ないのですが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/7", "thumbnail_src": "https://si.imgix.net/51d6cf05/uploads/origins/21a7fbc8-f8b2-47fa-b075-407dfbbb5ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9988e312c7f99932659ae1d3e9c12883", "thumbnail_srcset": "https://si.imgix.net/51d6cf05/uploads/origins/21a7fbc8-f8b2-47fa-b075-407dfbbb5ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9988e312c7f99932659ae1d3e9c12883, https://si.imgix.net/51d6cf05/uploads/origins/21a7fbc8-f8b2-47fa-b075-407dfbbb5ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5bd3a434fc3d76a6a652c710aedb5e5 2x, https://si.imgix.net/51d6cf05/uploads/origins/21a7fbc8-f8b2-47fa-b075-407dfbbb5ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bba096c4acfc843fd090eac98610eff 3x", "genre": "art", "nsfw": true, "body": "はじめてリクエストさせていただきます。\nいつもあなたのイラストを楽しく拝見しており、その中でも特に法被姿の沖波と岸波のイラスト(https://www.pixiv.net/artworks/87206737)がとても可愛らしく、印象に残っております。\n今回は艦これの北上さんと阿武隈さんの2人で同じような格好のイラストを描いていただけないしょうか。構図はこれまでのイラストと同様で、阿武隈さんのほうが若干距離を取ろうとしている感じでお願いします。また、今回はりんご飴やうちわ、太鼓のバチなどお祭りを連想させるアイテム１つをどちらかに持たせてください。\n余裕がございましたら、サラシ無しと法被なし、褌一丁の3通りの差分を描いていただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/6", "thumbnail_src": "https://si.imgix.net/d5b2d4ef/uploads/origins/f1d2ceb5-7988-49d7-baeb-f74b440c5e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=737f14c5062b96f2497357faf36f5bd7", "thumbnail_srcset": "https://si.imgix.net/d5b2d4ef/uploads/origins/f1d2ceb5-7988-49d7-baeb-f74b440c5e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=737f14c5062b96f2497357faf36f5bd7, https://si.imgix.net/d5b2d4ef/uploads/origins/f1d2ceb5-7988-49d7-baeb-f74b440c5e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=218ff0d9f4980a0748d58d117f39613c 2x, https://si.imgix.net/d5b2d4ef/uploads/origins/f1d2ceb5-7988-49d7-baeb-f74b440c5e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=223c585989f0d0524b130e6f2a510a0c 3x", "genre": "art", "nsfw": true, "body": "前回は秋月と風雲の絵を描いて頂きありがとうございました。ファイルについても本当に助かりました。\n連続以来になりますが、またお願いしようと思います。\nキャラは今回は1人ですが、再度、艦これの秋月でお願いします。\n服装はいわゆる「ビキニのマイクロ水着」で、恰好は以前Uutさんが描かれたスク水夕張さんとほぼ同様のポーズ。全裸差分ありでお願いしたく思います。\nいわゆる局部表現は前回同様の海苔修正で、お尻の穴は隠さずに見えてしまってる(*ﾉωﾉ)でお願いします。\n前回のお礼も兼ねて少し多い金額に致します。\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/5", "thumbnail_src": "https://si.imgix.net/9b3b6d2a/uploads/origins/55d4a405-5076-4458-afe7-37b900ffff86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7871bdce01d53c7b365d9456d3467f56", "thumbnail_srcset": "https://si.imgix.net/9b3b6d2a/uploads/origins/55d4a405-5076-4458-afe7-37b900ffff86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7871bdce01d53c7b365d9456d3467f56, https://si.imgix.net/9b3b6d2a/uploads/origins/55d4a405-5076-4458-afe7-37b900ffff86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b8a914223a67461228d1c52736b443a 2x, https://si.imgix.net/9b3b6d2a/uploads/origins/55d4a405-5076-4458-afe7-37b900ffff86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49530e5e0ee7f792b9ff9ad09b8b6eb0 3x", "genre": "art", "nsfw": true, "body": "以前PixivやこちらのSAMPLEで見た夕張さんや沖波さん岸波さんの法被絵がすごくかわいかったので、同じような絵をお願いしたく思います。\nキャラは艦これの秋月さんと風雲さんの2人で、SAMPLEの沖波さん岸波さんのような感じのカップリング絵で、さらしとふんどし無し、全裸の差分込みでお願いします。\n局部表現についてはお任せしますが、修正が必要な場合はモザイクではなくいわゆる海苔消しで、修正がいらない程度なら無しが嬉しいですがその辺はお任せします。\n陰毛描写が可能なら2人とも薄目で、無理なら陰毛は無しでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/4", "thumbnail_src": "https://si.imgix.net/443cb9be/requests/212865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5638fcaf5a15bb1d77081f52cab347ce", "thumbnail_srcset": "https://si.imgix.net/443cb9be/requests/212865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5638fcaf5a15bb1d77081f52cab347ce, https://si.imgix.net/443cb9be/requests/212865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e51e3a3f64d122eb4b205434f1f015d 2x, https://si.imgix.net/443cb9be/requests/212865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc0263fda52763135a1b514cc0726843 3x", "genre": "art", "nsfw": true, "body": "こんにちは。以前描かれていた法被の夕張さんの絵がとても好きでして。\nこちらの絵です。　→　https://www.pixiv.net/artworks/75860073\n\n艦これの沖波と岸波を同じような格好で描いていただけないでしょうか。\nサラシ無し・褌無し・裸の差分も作っていただけると、とても嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/2", "thumbnail_src": "https://si.imgix.net/42a8e463/requests/122303_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b9201323e91d5b42add6545b392a42", "thumbnail_srcset": "https://si.imgix.net/42a8e463/requests/122303_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b9201323e91d5b42add6545b392a42, https://si.imgix.net/42a8e463/requests/122303_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9c780d562e8c6c2e2fa3f0be79db67c 2x, https://si.imgix.net/42a8e463/requests/122303_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cbbd2ed825cc8cbda9f3d72d7dfb04d 3x", "genre": "art", "nsfw": false, "body": "うちの子イラストを依頼したいです。服装は水着で。\n参考URL：\nhttps://twitter.com/nanatuki07/status/1295012657330679808", "created_at": "", "completed_at": ""}, {"path": "/@PVA_vinylon/works/1", "thumbnail_src": "https://si.imgix.net/1b7010bc/requests/118054_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0afbd20e2c2e913e5ed01556f9a955", "thumbnail_srcset": "https://si.imgix.net/1b7010bc/requests/118054_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0afbd20e2c2e913e5ed01556f9a955, https://si.imgix.net/1b7010bc/requests/118054_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74fbfe47ca180300257cac9eed45e804 2x, https://si.imgix.net/1b7010bc/requests/118054_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=995321c4401525b42ae38a113d3f8059 3x", "genre": "art", "nsfw": false, "body": "艦これの夕張さんで、艤装を持ってるところの絵を描いてほしいです。\n両腕広げて、新しい艤装を見せびらかして自慢してるようなドヤ顔をお願いします。\nパソコンの壁紙に使いたいので、縦横比が16：9かそれに近いサイズにしてほしいです。\nご検討よろしくおねがいします。", "created_at": "", "completed_at": ""}]}