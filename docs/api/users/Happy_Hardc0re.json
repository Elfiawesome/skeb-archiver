/uploads/origins/2f0168aa-8d0d-49b7-afed-31e6bd87d172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09a28dbfec374f2bc10703c199169014, https://si.imgix.net/cec59a94/uploads/origins/2f0168aa-8d0d-49b7-afed-31e6bd87d172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=348ac7ca1fd614279c044fb47a4318e7 2x, https://si.imgix.net/cec59a94/uploads/origins/2f0168aa-8d0d-49b7-afed-31e6bd87d172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a342b7a45e52af11554252ddee8f6463 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Happy_Hardc0re/works/69", "thumbnail_src": "https://si.imgix.net/c43776f9/uploads/origins/86a611dd-998a-4472-b354-901fd9c8290f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df2fcd356a3b42092530d2aaba4f5d29", "thumbnail_srcset": "https://si.imgix.net/c43776f9/uploads/origins/86a611dd-998a-4472-b354-901fd9c8290f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df2fcd356a3b42092530d2aaba4f5d29, https://si.imgix.net/c43776f9/uploads/origins/86a611dd-998a-4472-b354-901fd9c8290f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=993e24eb75e9d2dfda869114e9c8b411 2x, https://si.imgix.net/c43776f9/uploads/origins/86a611dd-998a-4472-b354-901fd9c8290f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0709cb34becee2ea6ad78db10dc48351 3x", "genre": "art", "nsfw": true, "body": "キャラクター\nハッカドール3号くん\n\nシチュエーション\nハッカドール3号くんは、いつもの格好を模した魅力的なボーイポットになっていた。彼のチンコ、タマ、会陰、ケツの穴は、ポットの前面にある一つの穴から露出している。そんな卑猥で不便な姿にされて、彼は迷惑そうだ。\n\n差分：\n尻の穴にバイブが挿入された。少年らしからぬ淫らな顔をしている。\n\n台詞を入れ