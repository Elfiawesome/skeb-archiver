f8e642-d61d-4c7f-a516-3b3030a318a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17f010248bf09fbd1635076a58716f98 2x, https://si.imgix.net/2721ecb5/uploads/origins/1cf8e642-d61d-4c7f-a516-3b3030a318a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ccc6af53a5c745d08a1d2755f4c347c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@irutamikazako22/works/36", "thumbnail_src": "https://si.imgix.net/668c9024/uploads/origins/08d3625f-fd67-49b8-8476-3e20261aa4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4842e10596dd619cfb800f9722ecf498", "thumbnail_srcset": "https://si.imgix.net/668c9024/uploads/origins/08d3625f-fd67-49b8-8476-3e20261aa4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4842e10596dd619cfb800f9722ecf498, https://si.imgix.net/668c9024/uploads/origins/08d3625f-fd67-49b8-8476-3e20261aa4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bc75a4c1ef0c3dc861c9286f903ac8f 2x, https://si.imgix.net/668c9024/uploads/origins/08d3625f-fd67-49b8-8476-3e20261aa4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12c7120c6ec373b63ad2fe13b9a4187d 3x", "genre": "art", "nsfw": true, "body": "◯キャラクター\nアニラ(グランブルーファンタジー)\n\n◯シチュエーション\nエルステ帝国に捕まって兵士の性処理便所として犯されているBADEND的なシチュエーションをお願いします。\n・枷や首輪のようなもので拘束されて(詳細おまかせ)長期間犯され続けて、白濁液まみれの状態でなおも犯されている\n・精神的に壊れ、レイプ目で涙を流してほぼ無反応な感じになった様子の表情\n・服装はおまかせ(スキンや通常ver以外の服装でもOK)、肌露出多めを希望(全裸でもOK)\n・可能であれば、精神的に壊れた結果無反応ではなく快楽狂いのようになり、悦んでいる様子の表情差分と、ボテ腹状態の腹の差分", "created_at": "", "completed_at": ""}, {"path": "/@irutamikazako22/works/35", "thumbnail_src": "https://si.imgix.net/2751962a/uploads/origins/1cc573d7-061d-4006-9fc8-b3b514c8a2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a18c2cbae664fd19f620afaeeaf74ded", "thumbnail_srcset": "https://si.imgix.net/2751962a/uploads/origins/1cc573d7-061d-4006-9fc8-b3b514c8a2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a18c2cbae664fd19f620afaeeaf74ded, https://si.imgix.net/2751962a/uploads/origins/1cc573d7-061d-4006-9fc8-b3b514c8a2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc5fffb03528b1fafe0593bbc66277cb 2x, https://si.imgix.net/2751962a/uploads/origins/1cc573d7-061d-4006-9fc8-b3b514c8a2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25548826d1c00a9a7e4c574020303e0b 3x", "genre": "art", "nsfw": true, "body": "いつも大変お世話になっております。skeb募集再開をお待ちしていました。宜しければ下記のシチュエーションでイラストをお願いしたいと思います。\n\nキャラクター\nソーン&サラーサ（水着ver）\n\n\nシチュエーション\n\n「Deep in the eyes」がとても好きで未だに何度も使わせて頂いています。もし可能なら同人誌の続きなイメージでソーンがサラーサを巻き込んで快楽に堕ちていくシチュエーションでお願いします。\n\nイラストの構図\n\n前回描いて頂いたアニラがとても良かったのであのような構図で二人並んで正常位で犯されているところをお願いします。乱交感が欲しいので二人それぞれ自分の顔に向けて片手で手コキをしている状態。※ドラフとヒューマンの体格差は特に気にしません。\n\n・竿役は太ったおっさん（毛深め）犯している男2人と手コキされてる男2人の計4人。前回くらいの描写でお願いします。\n\n差分①見せ槍状態。※予算上難しいようならこちらは削除してください。\n差分②ピストン中。\n差分③中出し。\n差分④.③をベースに下記要素を追加。\n・体に正の字や卑猥な落書き。\n・使用済みコンドームで飾り付け。サラーサは角にも括ってくださると嬉しいです。\n（ワカメ様の体の落書きや使用済みコンドームの描写が最高に好きです！）\n・手コキから射精事後、チンポから糸引く粘度の高いザーメンがべっとり顔に張り付いている。\n・口の中にも舌に絡みつくザーメン＋抜けた陰毛\n\nいろいろ細かく書いてしまいましたが前回のアニラが最高に良かったのであのような感じでお願いします。台詞も前回のように入れて頂けたらと思います。\n\n修正は黒海苔修正でお願いします。\n\n構図に二人並んでとは書いてしまいましたが前回のアニラの構図が最高良かったので、それぞれ分けて2ページで描いて頂いても大丈夫です。（作業的にどちらが大変なのか分からないので…）そもそも予算や時間的に2キャラは難しいようでしたら遠慮なくキャンセルをお願いします。1キャラに絞って再考させて頂きます。\n\n\nマキマさん本もとても良く色々と我慢できなくなり無茶な依頼を送ってしまいました。ご多忙とは思いますがご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@irutamikazako22/works/34", "thumbnail_src": "https://si.imgix.net/3c1c31f2/uploads/origins/b5d8eaaf-c5d7-4adf-8ccf-521f8fb39ce3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFF