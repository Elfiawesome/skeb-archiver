等いただけますと嬉しいです！\n\n◆レイヤーについて\n可能でしたら、350dpiで透過素材と背景素材ありの物を頂きたいです。\nできれば描いていただく範囲で一部が見切れないように描いていただけますと幸いです。\n※頭の先や髪の毛の先など\n\nご縁がありましたらよろしくお願いいたします！\n\nここにねむる資料▶\n　資料1枚目の悪魔の羽根、角、尻尾のあるここにねむるになります。\n　記載はしていませんが、身長125㎝になります。\n　●Twitter固定ツイート\n　https://twitter.com/nemuxre/status/1547576611259949056?s=21&t=QFIYiwUS1aiFZ1lVS4s05w", "created_at": "", "completed_at": ""}, {"path": "/@k_a_r_o_r_u_r_a/works/11", "thumbnail_src": "https://si.imgix.net/f87354f6/uploads/origins/2afa31ee-d543-49e1-9bf5-82c78dc791a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86df3c4a46f0e3caffb18fec151ea71f", "thumbnail_srcset": "https://si.imgix.net/f87354f6/uploads/origins/2afa31ee-d543-49e1-9bf5-82c78dc791a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86df3c4a46f0e3caffb18fec151ea71f, https://si.imgix.net/f87354f6/uploads/origins/2afa31ee-d543-49e1-9bf5-82c78dc791a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=194b358f3ec1147e988a79a201c5fe76 2x, https://si.imgix.net/f87354f6/uploads/origins/2afa31ee-d543-49e1-9bf5-82c78dc791a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d814d8cd5b81106121d2fff67352ca7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@k_a_r_o_r_u_r_a/works/10", "thumbnail_src": "https://si.imgix.net/1e9e1d8a/uploads/origins/b8995e4d-af23-482e-b2a7-0dc00c3bb31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=377cabbdf6d447cc1