[{"path": "/@t_dsbwiv/works/18", "thumbnail_src": "https://si.imgix.net/e2d64235/uploads/origins/bf8c9ee8-c276-4b98-a423-599b6df5b1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22f76baa9e7cc94ec79f13ede7de0083", "thumbnail_srcset": "https://si.imgix.net/e2d64235/uploads/origins/bf8c9ee8-c276-4b98-a423-599b6df5b1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22f76baa9e7cc94ec79f13ede7de0083, https://si.imgix.net/e2d64235/uploads/origins/bf8c9ee8-c276-4b98-a423-599b6df5b1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=258eb4f96047e27ec6777abd4b597f6b 2x, https://si.imgix.net/e2d64235/uploads/origins/bf8c9ee8-c276-4b98-a423-599b6df5b1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ab92ec83c7f67951bdc30c79e259287 3x", "genre": "art", "nsfw": false, "body": "こんにちは、いつもお世話になっておりました!!今回は私のTRPGキャラのイラストをお願いしたいです!!\n\n彼の名前は十文字世空（じゅうもんじ よそら）、世界中を旅したいと思っている旅人です。活発で社交的で、いつも他人を助けようとします。ビールとアウトドア活動が好きですが、ビールは苦手です。彼にもクールな一面がある、そして人の話を見るのが好きでした。\n\n服装やポーズはお任せしますので、似合いそうなものを描いてください！使用用途は、お友達へのプレゼント、個人観賞用、SNSでのアイコンやヘッダーに使いたいです。\nよろしくお願いします!!\n\nhttps://drive.google.com/drive/folders/11Hvsy6-dzo3LpoxiHCdYLGW__ca5r7Ar?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@t_dsbwiv/works/17", "thumbnail_src": "https://si.imgix.net/2ca80820/uploads/origins/b0e278ae-841e-4bea-85f1-980370d92ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=346d81910552dff6048785ef46cb9b06", "thumbnail_srcset": "https://si.imgix.net/2ca80820/uploads/origins/b0e278ae-841e-4bea-85f1-980370d92ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=346d81910552dff6048785ef46cb9b06, https://si.imgix.net/2ca80820/uploads/origins/b0e278ae-841e-4bea-85