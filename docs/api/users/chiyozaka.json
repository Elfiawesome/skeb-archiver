8f2-e19ec12e7952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b667b3ba16d11f5e0066e736534331a 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chiyozaka/works/12", "thumbnail_src": "https://si.imgix.net/c0febc6d/uploads/origins/df8605c9-95bc-4129-8f5d-e986db9088ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56facfce1c6034c8d1a231933629e7fb", "thumbnail_srcset": "https://si.imgix.net/c0febc6d/uploads/origins/df8605c9-95bc-4129-8f5d-e986db9088ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56facfce1c6034c8d1a231933629e7fb, https://si.imgix.net/c0febc6d/uploads/origins/df8605c9-95bc-4129-8f5d-e986db9088ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa21a9ffffc6e5be1cfcbd3a5da7471 2x, https://si.imgix.net/c0febc6d/uploads/origins/df8605c9-95bc-4129-8f5d-e986db9088ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c278b7c4ccd7247d25faca6946412e0 3x", "genre": "comic", "nsfw": true, "body": "今回も納品していただいたばかりで恐縮ですが、チア異種姦の続編のリクエストをさせていただきます\n\nhttps://skeb.jp/@chiyozaka/works/8\nhttps://skeb.jp/@chiyozaka/works/9\nhttps://skeb.jp/@chiyozaka/works/10\n\n・女の子\n前回と同じチアちゃん\n都合のいい展開で助かった世界線\n化け物を産みまくったせいで子宮結界が張れなくなっている&母乳が出る体質に\nやっぱり化け物相手に感じまくるも絶対に堕ちない\n\n・衣装\n前回と同じ状態のチア衣装\n\n・相手\n前回のゴリラ怪人の更に改良型\n\n・シチュ\n怪人に腹パンとか食らって敗北した後、駅弁レイプ\nアンスコと白パンツのクロッチに空けた穴からペニスを挿入されてかはっと息を詰まらせる\n妊娠を結界でガードできないので挿入前からかなり怯えている\nアンスコの上からお尻を揉みしだかれて感触を楽しまれる\nディープキスで催淫成分入り唾液を飲まされまくり、解放後は唾液の橋ができている\n中出し時に妊娠の恐怖に目を見開きながら「いやあああああ」的に号泣絶叫するも、特濃熱々精子で子宮を満たされて絶頂\n射精一発で受精したことを感じてレイプ目ボロ泣きしながらうわ言の様に絶望の言葉を呟く\n\nhttps://www.dropbox.com/scl/fo/ma93e1xzfc799mwz1uh3t/ADVOfFY3SjIoPJomnyFHAO8?rlkey=085h8bkz6e9m25wtf55ra6np2&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@chiyozaka/works/11", "thumbnail_src": "https://si.imgix.net/78451344/uploads/origins/d43d95cc-50a0-4b38-aacb-a15238d21c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a3275459c92baae3640e25630866fb", "thumbnail_srcset": "https://si.imgix.net/78451344/uploads/origins/d43d95cc-50a0-4b38-aacb-a15238d21c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a3275459c92baae3640e25630866fb, https://si.imgix.net/78451344/uploads/origins/d43d95cc-50a0-4b38-aacb-a15238d21c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ea2523672ef0e558160a7122906f69d 2x, https://si.imgix.net/78451344/uploads/origins/d43d95cc-50a0-4b38-aacb-a15238d21c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=243a4bb18d2ca51e3a6407e258956355 3x", "genre": "comic", "nsfw": true, "body": "今回もチア異種姦コミックの執筆ありがとうございました\nやっぱりフリルの描き込みがすごくてエロいです…\n\n続きのページもぜひ拝見したいので、新規リクエストとして今回入れ忘れてしまったページの納品を依頼させていただきます", "created_at": "", "completed_at": ""}, {"path": "/@chiyozaka/works/10", "thumbnail_src": "https://si.imgix.net/951e2ae3/uploads/origins/7bbb775d-d715-4072-ab50-ff7e0c9772d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c0a010b43f0d464e24325bfb1f834d", "thumbnail_srcset": "https://si.imgix.net/951e2ae3/uploads/origins/7bbb775d-d715-4072-ab50-ff7e0c9772d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c0a010b43f0d464e24325bfb1f834d, https://si.imgix.net/951e2ae3/uploads/origins/7bbb775d-d715-4072-ab50-ff7e0c9772d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b1678b019d8930328e2e37ba97dc2df 2x, https://si.imgix.net/951e2ae3/uploads/origins/7bbb775d-d715-4072-ab50-ff7e0c9772d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8631a4a61a67d3bfcf82268962831420 3x", "genre": "comic", "nsfw": true, "body": "素晴らしい異種姦コミックの納品ありがとうございました\n納品していただいたばかりで恐縮ですが、続編？(時系列・世界線はお任せします)のリクエストをさせていただきます\n\n・女の子\n前回と同じチアちゃん\nやっぱり化け物相手に感じまくるも絶対に堕ちない\n\n・衣装\n前回と同じ状態のチア衣装\n\n・相手\n前回のゴリラ怪人に高い戦闘能力が付加されたもの\n\n・シチュ\n怪人に敗北後、正常位レイプ(腋が見えるように腕を頭の方に上げる感じ+靴裏が見える感じ+太ももやラブハンドル掴み)\nアンスコと白パンツのクロッチに空けた穴からペニスを挿入されてかはっと息を詰まらせる\n中出し時に目を見開きながら「赤ちゃん」「妊娠」「もう産みたくない」等のワード込みで号泣絶叫するも、特濃熱々精子で子宮を満たされて絶頂\nその後退魔士の力で受精を感じながらレイプ目ボロ泣き\n\nhttps://www.dropbox.com/scl/fo/ma93e1xzfc799mwz1uh3t/ADVOfFY3SjIoPJomnyFHAO8?rlkey=085h8bkz6e9m25wtf55ra6np2&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@chiyozaka/works/9", "thumbnail_src": "https://si.imgix.net/142baeef/uploads/origins/8d57e6e7-5c6d-4fdb-96e6-1145c3ab542c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1397cccb1b50d23cd47f5c48217f09e6", "thumbnail_srcset": "https://si.imgix.net/142baeef/uploads/origins/8d57e6e7-5c6d-4fdb-96e6-1145c3ab542c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1397cccb1b50d23cd47f5c48217f09e6, https://si.imgix.net/142baeef/uploads/origins/8d57e6e7-5c6d-4fdb-96e6-1145c3ab542c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f95a53a34ec8bd0c3b25b0100a78231c 2x, https://si.imgix.net/142baeef/uploads/origins/8d57e6e7-5c6d-4fdb-96e6-1145c3ab542c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3c60d19690a4716cff88baf8f17b063 3x", "genre": "art", "nsfw": true, "body": "先ほどは納品ありがとうございました！\nまたまたまたご依頼させていただきます。もし可能であればで大丈夫です。\n\n・キャラクター\n千坂きゅうり様のオリジナルキャラクター　佐戸野さん\n\n・シチュエーション\nこの依頼で佐戸野さんと、男女✕SMの依頼が最後になります！\n佐戸野さんがM、職場の女性がSの組み合わせをお願いいたします。大まかなシチュエーションは上記の様に指定いたしますが、細かなシチュエーションはお任せいたします。\n\n・衣服\nお任せいたします。シチュエーションにあっていれば大丈夫です。\n\nご検討のほど、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@chiyozaka/works/8", "thumbnail_src": "https://si.imgix.net/15b31bcd/uploads/origins/870f46cc-835a-49eb-9a9d-f6592197d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=842068e47baf799649682535da3337a7", "thumbnail_srcset": "https://si.imgix.net/15b31bcd/uploads/origins/870f46cc-835a-49eb-9a9d-f6592197d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=842068e47baf799649682535da3337a7, https://si.imgix.net/15b31bcd/uploads/origins/870f46cc-835a-49eb-9a9d-f6592197d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12a3fd69fec5d1b8f892e4423005652d 2x, https://si.imgix.net/15b31bcd/uploads/origins/870f46cc-835a-49eb-9a9d-f6592197d2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f7dce181f3a2eb3bd207fc8ea933d7b 3x", "genre": "comic", "nsfw": true, "body": "チアガールの異種姦絵をお願いします。\n\n・女の子\n黒髪セミロング～ショートボブの巨乳美少女\n二次元ドリームノベルス的なチア衣装退魔士\n真面目で正義感の強い性格\n過去に異種姦レイプ孕ませ経験あり\n化け物相手に感じまくるも絶対に堕ちない\n一人称は「私」\n\n・衣装\n資料URLのかなり昔のチア衣装\n白ショート手袋&白ショート靴下&白スニーカー着用\nアンスコは前面背面共にフリフリ＆お腹まで覆うブルマ位の布面積タイプ\n企業ロゴは削除\n衣装破れはクロッチ部分のみ\n\n・相手\nゴツい類人猿的な亜人型の怪物\n\n・シチュ\n正常位でレイプ(腋が見えるように腕を頭の方に上げる感じで)\nアンスコと白パンツのクロッチに空けた穴からペニス挿入\n中出しで妊娠させられる恐怖・嫌悪感に目を見開きながら号泣絶叫するも、特濃熱々精子で子宮を満たされて絶頂\n\nhttps://www.dropbox.com/scl/fo/ma93e1xzfc799mwz1uh3t/ADVOfFY3SjIoPJomnyFHAO8?rlkey=085h8bkz6e9m25wtf55ra6np2&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@chiyozaka/works/7", "thumbnail_src": "https://si.imgix.net/5f083909/uploads/origins/3cdc13ba-47d0-43a1-98e0-41e8cff8f2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b8ae5a465193475672885e2076644b0", "thumbnail_srcset": "https://si.imgix.net/5f083909/uploads/origins/3cdc13ba-47d0-43a1-98e0-41e8cff8f2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b8ae5a465193475672885e2076644b0, https://si.imgix.net/5f083909/uploads/origins/3cdc13ba-47d0-43a1-98e0-41e8cff8f2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92acce9fb64d8156c9c74aa472ade0f 2x, http