middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b13e3d4ddbe6a79565af4851ecb59d4 2x, https://si.imgix.net/2e876935/uploads/origins/9292d0ea-e878-4bf0-9315-83ba06f26f02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f18246f251d9134f1e87f7cba8f2000 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@l603201/works/89", "thumbnail_src": "https://si.imgix.net/533fac2a/uploads/origins/54683b78-60b9-4b33-a4b4-7a35e6b87528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd412f17d6641d2a7b233733a55fa1ec", "thumbnail_srcset": "https://si.imgix.net/533fac2a/uploads/origins/54683b78-60b9-4b33-a4b4-7a35e6b87528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd412f17d6641d2a7b233733a55fa1ec, https://si.imgix.net/533fac2a/uploads/origins/54683b78-60b9-4b33-a4b4-7a35e6b87528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a68128babefe0435b1b1e78e0b67e1fc 2x, https://si.imgix.net/533fac2a/uploads/origins/54683b78-60b9-4b33-a4b4-7a35e6b87528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=daec9fd5018209a4585e359719db269a 3x", "genre": "art", "nsfw": false, "body": "初めまして！先生の魅力的な作品がとても大好きです。\n私のOCを描いていただけたら、すごく嬉しいです。\nご検討よろしくお願いいたします。\n\n簡単な関係の説明は以下の通りです>>>\n女性は男性をからかうのが好きで、男性の反応が面白いと思っています。男性は女性の行動を嫌っていますが、彼女の支配から逃れることができません。二人の間には片方だけの好意があり、恋愛感情が発展する可能性はありませんが、親密なスキンシップが存在します。\n希望するシーンは教会での結婚式で、二人はタキシードとウェディングドレスを着ています。女性が男性を強引に結婚させるような雰囲気でお願いします。\n\nhttps://drive.google.com/drive/folders/1lYQnqbTQhf5b5ZG5ka7cEvB3CW1NxosV", "created_at": "", "completed_at": ""}, {"path": "/@l603201/works/88", "thumbnail_src": "https://si.imgix.net/c174f0fd/uploads/origins/7facfb04-8dd6-426c-827a-ea9fdb194f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4120bea61d30930e383650a965341ea", "thumbnail_srcset": "https://si.imgix.net/c174f0fd/uploads/origins/7facfb04-8dd6-426c-827a-ea9fdb194f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4120bea61d30930e383650a965341ea, https://si.imgix.net/c174f0fd/uploads/origins/7facfb04-8dd6-426c-827a-ea9fdb194f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=300ae5ea259c41f1073bf200d35a863f 2x, https://si.imgix.net/c174f0fd/uploads/origins/7facfb04-8dd6-426c-827a-ea9fdb194f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc400f66b1c90625db5ec8a9b46fc33e 3x", "genre": "art", "nsfw": false, "body": "クマ先生\n\n前回は素敵なイラストをありがとうございました。\n梅北あかりと申します。\n再び私のイラストをお願いしたくリクエスト致します。\n\n【キャラクター】\n梅北あかり（Vライバー）\n同内容にはなりますが、虎モチーフのギャルライバーです。\n三面図はございませんので、見えない部分についてはご想像にお任せいたします。\nわかりにくい部分ですが、髪色は金髪から紫へのグラデーションになっており、インナーカラーも黒から濃い紫のグラデーションになっております。\n虎のしっぽは装飾です。\n\n【リクエスト内容】\nシャンティ(https://youtu.be/POy0RvJeaqM?si=g_U_tqM06F6kPUmS)風の怪しい中華マフィア風の雰囲気でお願いします。\n構図などはMV通りではなく、クマ先生のご自由にお描き下されば幸いです。\n今回の資料には男体化した時のイメージ(顔だけになります)も添付しておりますので、男体化の方でお描き頂いても構いません。\n可能であれば背景と人物が分かれたレイヤー形式であれば嬉しいです。\n\n【使用目的】\n・各種SNSでの宣伝活動やアイコン、ヘッダー等\n・収益化予定の配信媒体サムネイルや景品、イベントでの返礼品等\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/12rYpHfPqF_DXr_wiYk-k-0zdq22umxP1", "created_at": "", "completed_at": ""}, {"path": "/@l603201/works/87", "thumbnail_src": "https://si.imgix.net/fe444c81/uploads/origins/5c168823-c285-4817-bd71-68aa4daacad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a9e327873ea83b3cd46d0210052c3b", "thumbnail_srcset": "https://si.imgix.net/fe444c81/uploads/origins/5c168823-c285-4817-bd71-68aa4daacad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a9e327873ea83b3cd46d0210052c3b, https://si.imgix.net/fe444c81/uploads/origins/5c168823-c285-4817-bd71-68aa4daacad7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=068d2dbf1b3aac3f0b0ea776d25591e1 2x, https://