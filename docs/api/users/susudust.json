dle%2Ccenter&txtsize=30&txt=PRIVATE&s=4014312b8e2decb061456780a33a1c71 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@susudust/works/116", "thumbnail_src": "https://si.imgix.net/70ee598d/uploads/origins/09e60dfb-22e6-476b-844b-c7e5e0139163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acc8e113b1b31c784b43173037e30f4f", "thumbnail_srcset": "https://si.imgix.net/70ee598d/uploads/origins/09e60dfb-22e6-476b-844b-c7e5e0139163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acc8e113b1b31c784b43173037e30f4f, https://si.imgix.net/70ee598d/uploads/origins/09e60dfb-22e6-476b-844b-c7e5e0139163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b49311ab03d06b0fc121b67bfdcc4d8 2x, https://si.imgix.net/70ee598d/uploads/origins/09e60dfb-22e6-476b-844b-c7e5e0139163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d01153c249ae5b9d2164dee7b96c05f 3x", "genre": "art", "nsfw": false, "body": "煤と埃様\n初めまして、煤と埃様のイラストをXを通していつも楽しませていただいております。\n先生の作品のデザインや世界観が非常に素敵で、私のキャラクターをデザインして頂きたく送らせていただきました。\n\n受理可能かご検討お願いいたします。\n\n〇概要\nXをはじめ動画・配信活動で使用するキャラクターの新規デザイン。\n過去の動画・配信切り抜きの一例(過去名義)\n\nhttps://youtu.be/LkIi188PQao?si=cFCY40zhGxfhJHsM\n\nhttps://youtu.be/QpA_reGC90U?si=VGE0zKaDbST1w1Tt\n\n〇設定\n名前:天瀬 見ロ(アマセ ミロ)\n性別:男性\n近未来の崩壊した都市で便利屋をやっています。\n人口の心臓(透明なキューブに炎が入ったような)をリアクターとしており、小柄なまま成長が止まっています。\n明るくおしゃべりが好きで、便利屋コミュニティの分隊長をしています。\n出身は伊賀。普段と対照的に隠密活動が得意です。\n簡単な忍術と機械的な弓を使用して戦闘、過酷な環境を生き抜きます。\n胸の傷は都市崩壊の際にできたもので、仲間を失った暗い過去がバックボーンにあります。\n\n〇外見\n体形:身長160cmの細身、弓を引くため細い筋肉があります。\n中世的な顔つき、白髪の天然パーマ（もしくはウルフ）、首周りのあるma-1のような形状のジャケットを着用しています。\nスリッドの入ったハーフパンツ、インナーはピタッとしたものを着用しています。\nテーマやキーワードとしては、動きやすさと隠密、近未来や機械的なデザインのベースに置いています。\nポイントでビビットな水色とピンクを取り入れたいと考えています。\n全体の色のバランスは先生にお任せいたします。\n仮資料\nhttps://drive.google.com/file/d/14S1Gjrz1c9_5_GIqaa5aohMautNqsut3/view?usp=sharing\n\n〇補足\nあくまで外見は仮の設定としております。\n先生のセンスが大好きなので改良していただけると幸いです。\n仮資料につきましても初心者ながら、最低限の設定を、と作成させていただいた次第です。\n重ねてになりますが、よろしければぜひ先生好みに仕上げていただけるととても嬉しいです。\n良ければよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@susudust/works/115", "thumbnail_src": "https://si.imgix.net/7250926e/uploads/origins/afff1fd8-2d85-48c3-b12f-d16c1065e0ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57cf99217750c4854b1282307ffa8d12", "thumbnail_srcset": "https://si.imgix.net/7250926e/uploads/origins/afff1fd8-2d85-48c3-b12f-d16c1065e0ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57cf99217750c4854b1282307ffa8d12, https://si.imgix.net/7250926e/uploads/origins/afff1fd8-2d85-48c3-b12f-d16c1065e0ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6ce85608b5ca8849c61f0152715b895 2x, https://si.imgix.net/7250926e/uploads/origins/afff1fd8-2d85-48c3-b12f-d16c1065e0ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58a57fade74722e92303943bf55c39a1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@susudust/works/114", "thumbnail_src": "https://si.imgix.net/946652ac/uploads/origins/d1203345-c740-418d-9e46-e393419e4b19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6212c4ae525e2b2a8b0e6ae198dbcea5", "thumbnail_srcset": "https://si.imgix.net/946652ac/uploads/origins/d1203345-c740-418d-9e46-e393419e4b19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2