-4ada-8144-2b975f0add23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1637f62a196e65f0dbad1ab1ab565118", "thumbnail_srcset": "https://si.imgix.net/8bda6438/uploads/origins/c23ee8e9-f4eb-4ada-8144-2b975f0add23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1637f62a196e65f0dbad1ab1ab565118, https://si.imgix.net/8bda6438/uploads/origins/c23ee8e9-f4eb-4ada-8144-2b975f0add23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08cac8daa8f9043d4e9b88eb3b07fc23 2x, https://si.imgix.net/8bda6438/uploads/origins/c23ee8e9-f4eb-4ada-8144-2b975f0add23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=295c59a3ae77fdb8c9645811fb5be5cd 3x", "genre": "art", "nsfw": false, "body": "小丸さんと小丸さんのイラスト大好きなので、今回是非私の友人のオリキャラを描いて頂きたくリクエスト失礼します。\n\n・使用用途・使用範囲：\n個人SNSのアイコン\n\n〇構図、サイズ、雰囲気につきまして： \nアイコンサイズでお願いします\n\n▽キャラクター詳細 \n・ピンク色のツインテール\n・髪飾りはリボンでお願いします\n・服装だけは二枚目の画像の制服を参考してください。\n\n\n金額、内容など不適切な場合は、お手数をおかけしますが再送要求してもらえると助かります！ご検討の程、よろしくお願いいたします。\n\n永遠にBIGLOVE♡\n\nhttps://drive.google.com/drive/folders/1WMNz36h1Msd5_cydQWpXwMXUd1tbCryf", "created_at": "", "completed_at": ""}, {"path": "/@comaru_san/works/20", "thumbnail_src": "https://si.imgix.net/1a58f7c9/uploads/origins/56bb3391-efe6-48a4-bdb3-e42ead9ed62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22df2c62d1bdc46a36f57f999fc9a98f", "thumbnail_srcset": "https://si.imgix.net/1a58f7c9/uploads/origins/56bb3391-efe6-48a4-bdb3-e42ead9ed62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22df2c62d1bdc46a36f57f999fc9a98f, https://si.imgix.net/1a58f7c9/uploads/origins/56bb3391-efe6-48a4-bdb3-e42ead9ed62a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsh