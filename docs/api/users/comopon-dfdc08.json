ad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=615f21a248c9fe76f487c1f93fcc3762, https://si.imgix.net/37267fd2/uploads/origins/5eb06cd1-9ffc-4477-b82f-f2d1c03d18c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b41cd035a524ff241c2c0ed88491ea5 2x, https://si.imgix.net/37267fd2/uploads/origins/5eb06cd1-9ffc-4477-b82f-f2d1c03d18c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf619ce159172be279a2057e1be7ec93 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@comopon/works/15", "thumbnail_src": "https://si.imgix.net/53bac05c/uploads/origins/4a4f2470-2609-4ad3-901e-4533aec86018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4da8cbfa78d89cad8282cb26c59e003", "thumbnail_srcset": "https://si.imgix.net/53bac05c/uploads/origins/4a4f2470-2609-4ad3-901e-4533aec86018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4da8cbfa78d89cad8282cb26c59e003, https://si.imgix.net/53bac05c/uploads/origins/4a4f2470-2609-4ad3-901e-4533aec86018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2aceacf423f4188869787098230f872 2x, https://si.imgix.net/53bac05c/uploads/origins/4a4f2470-2609-4ad3-901e-4533aec86018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72b6d6ebdac68685f2b442573cc9c0e2 3x", "genre": "art", "nsfw": false, "body": "小宮様\n\n立て続けのリクエストになってしまい申し訳ございません。恐縮ではございますが、この度もリクエストを失礼いたします。当リクエストが難しいようでしたり、気乗りしないようであれば、どうかご遠慮なくキャンセルや金額の再送等のご対応をしてくださればと思います。\n\n可能であれば、拙作『融国』でお願いしてしまい大変申し訳ありませんが、下記の内容を先生の絵柄でお願いさせて頂けないでしょうか？以下、失礼いたします。\n\n●キャラ：桐島紘一(黒軍服)\n→帽子有無差分\n(可能であれば、帽子を被っている場合は画面内に僅かにでも映っていれば幸いです)\n●特徴:目にハイライトなし/下まつ毛あり/真ん中分けの髪型/筋肉質\n●設定：昭和時代の青年将校\n●イメージ：表情は口元の違いに、嘲笑と無表情気味(お任せ)のものがあると嬉しいです。\n昭和、日本感が強いものですと幸甚です。高潔でありながらも、一目で底知れぬ闇と歪みを抱えた男性と伝わるようなイメージですと幸いです。そのほか、お手数をおかけしてしまいますが、先生にお任せさせて頂きたいです\n●仕様：PSD納品/宛名や人物などが分離できると嬉しいです\n\nhttps://www.yuu-koku.com/", "created_at": "", "completed_at": ""}, {"path": "/@comopon/works/14", "thumbnail_src": "https://si.imgix.net/6066b563/uploads/origins/e27bd520-10db-4e10-ae01-41660d9aca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be60279b71f78eda9ca27fafb70dbdab", "thumbnail_srcset": "https://si.imgix.net/6066b563/uploads/origins/e27bd520-10db-4e10-ae01-41660d9aca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be60279b71f78eda9ca27fafb70dbdab, https://si.imgix.net/6066b563/uploads/origins/e27bd520-10db-4e10-ae01-41660d9aca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57581e63af2820c8bcc2fec7bf588c9f 2x, https://si.imgix.net/6066b563/uploads/origins/e27bd520-10db-4e10-ae01-41660d9aca3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d312612bd3a1f56af4974fd9a6d0339 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生。 尊敬します.\nよかったら私のocを描いてください。\nすべては先生に一任します。\n- 先生を死ぬほど尊敬する海外のあるファンが -\n-焦ってメッセージが短いです。 すいません.-\n- できればサングラスをかけたのと、脱いだのと 2バージョンでPSDをもらえたらいいと思います。 -\n\nhttps://drive.google.com/drive/folders/1ozKstrqiMt9ojS208a9y2qm_gFJsNI3C?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@comopon/works/13", "thumbnail_src": "https://si.imgix.net/f12fca67/uploads/origins/da876adf-bb01-43c2-adf9-d75e819f5e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=575b47bb44fb2439030f8141437f43eb", "thumbnail_srcset": "https://si.imgix.net/f12fca67/uploads/origins/da876adf-bb01-43c2-adf9-d75e819f5e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=575b47bb44fb2439030f8141437f43eb, https://si.imgix.net/f12fca67/uploads/origins/da876adf-bb01-43c2-adf9-d75e819f5e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&