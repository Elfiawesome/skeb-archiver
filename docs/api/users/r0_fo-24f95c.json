あるということです。私のocは窓際の窓に座って泣いていて、涙が止まらなくて、彼女は片手で涙を拭いています。\n言及していない部分や画面の背景はご自由にお楽しみください\n\n③ほか：\n可能でしたら宛名と人物はPSDレイヤーでON/OFFでき ると嬉しいです。宛名は「kurone」でお願いします! もし価格や依頼内容に問題がある場合は、修正請求をお 願い致します。\nご検討のほどよろしくお願いします。ありがとうござい ます!\nhttps://drive.google.com/file/d/1TYsaO2ZM4p5wWbvmDipBBOO9eXOLX7XG\nhttps://drive.google.com/file/d/17hSr-COCIpH3ahmpyqQRBrF34WCTso2f\nhttps://drive.google.com/file/d/1ZzCoXu-nQ08jiJ8TcwXtwsXTxm0j_-S3\n\nhttps://drive.google.com/file/d/1TYsaO2ZM4p5wWbvmDipBBOO9eXOLX7XG\n\nhttps://drive.google.com/file/d/1TYsaO2ZM4p5wWbvmDipBBOO9eXOLX7XG", "created_at": "", "completed_at": ""}, {"path": "/@r0_fo/works/29", "thumbnail_src": "https://si.imgix.net/4bd1eedf/uploads/origins/c7ee317e-8be3-4445-931f-20ee3a67c62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7007ea00fc62e2b73b3f8b1efc67825a", "thumbnail_srcset": "https://si.imgix.net/4bd1eedf/uploads/origins/c7ee317e-8be3-4445-931f-20ee3a67c62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7007ea00fc62e2b73b3f8b1efc67825a, https://si.imgix.net/4bd1eedf/uploads/origins/c7ee317e-8be3-4445-931f-20ee3a67c62a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c222355c6f2ea4cdb9dd56316f297d3b 2x, https://si.imgix.net/4bd1eedf/uploads/origins/c7ee317e-8be3-4445-931f-20ee3a67c62a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66b356ad2c38c7a98e51b896f324c4a4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@r0_fo/works/28", "thumbnail_src": "https://si.imgix.net/bc03a0af/uploads/origins/2f6d4f65-d