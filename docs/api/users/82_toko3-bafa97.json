1-41e3-a156-e111d5b0d95a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1783434e889567467cbeb5669b209331, https://si.imgix.net/43bb7d10/uploads/origins/7e6196f7-ece1-41e3-a156-e111d5b0d95a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a51523d810c783bb493c1478eed6584 2x, https://si.imgix.net/43bb7d10/uploads/origins/7e6196f7-ece1-41e3-a156-e111d5b0d95a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52d506e1b0a0131f951c1ae236af1c64 3x", "genre": "art", "nsfw": true, "body": "こんにちは、以前ボンデージアートを手がけられていたのを見ました。友人のキャラクターであるカツがテーブルに縛られ、弄ばれようとしている様子を描いていただけませんか？可能であれば、口を塞ぐギャグをふわふわのタオルのような質感で表現し、叫び声を抑えられるようにしていただけると嬉しいです！詳細はご自由にお任せします！ 本当にありがとうございます https://drive.google.com/drive/folders/1FGCqUwQdUJU4MdGYIWR2J-cvcmXd7qCG?usp=sharing https://drive.google.com/drive/folders/1FGCqUwQdUJU4MdGYIWR2J-cvcmXd7qCG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/8", "thumbnail_src": "https://si.imgix.net/c33fc6fe/uploads/origins/e6e1c762-9a20-476a-9307-02c62ed70f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=177d83a40e7acf32e93274b718fa2f6b", "thumbnail_srcset": "https://si.imgix.net/c33fc6fe/uploads/origins/e6e1c762-9a20-476a-9307-02c62ed70f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=177d83a40e7acf32e93274b718fa2f6b, https://si.imgix.net/c33fc6fe/uploads/origins/e6e1c762-9a20-476a-9307-02c62ed70f21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d3d31672fa1f29e8a764d6305497037 2x, https://si.imgix.net/c33fc6fe/uploads/origins/e6e1c762-9a20-476a-9307-02c62ed70f21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1ff88576005e63fd7a3bbc12fd6a769 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの可愛いボンデージ作品（https://skeb.jp/@82_toko3/works/6）を見て、似たような作品をリクエストしたくなりました！これは私のオリジナルキャラクター、風野杏里（かざのあんり）のためのものです！複数の衣装があるので、お好きなものを選んでください！ https://drive.google.com/drive/folders/1lRKQ0xEvEYz-JF8zfFGgyYe3rnEdFAE3設定は、彼女がこっそり探っていたところを悪者に捕まったというもの。できれば胸の上下（または胸の縛り）と膝の上下を縛り、足首も一緒に縛ってほしいです。\nポーズの参考として以下のようなものが理想的です：https://drive.google.com/drive/folders/1whOz2kgHkzdgF_sLYfypWS33IJRZSIhv?usp=sharing 口枷もお願いします。以前の作品（https://skeb.jp/@82_toko3/works/6）のような口枷が完璧です！\n\nご要望をお聞きいただきありがとうございます https://drive.google.com/drive/folders/1lRKQ0xEvEYz-JF8zfFGgyYe3rnEdFAE3", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/7", "thumbnail_src": "https://si.imgix.net/e4b70e92/uploads/origins/3f84df33-357f-4733-ac9a-0f4a855e1034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e373a5c6434f0ad395a53e6f4db7d9f4", "thumbnail_srcset": "https://si.imgix.net/e4b70e92/uploads/origins/3f84df33-357f-4733-ac9a-0f4a855e1034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e373a5c6434f0ad395a53e6f4db7d9f4, https://si.imgix.net/e4b70e92/uploads/origins/3f84df33-357f-4733-ac9a-0f4a855e1034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7b7cf8518552989efbd0ce4354da08a 2x, https://si.imgix.net/e4b70e92/uploads/origins/3f84df33-357f-4733-ac9a-0f4a855e1034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc248ddf561ea24f2b3e2467ab99cf40 3x", "genre": "art", "nsfw": true, "body": "ぷよぷよのルルーが逆立ちをして、脚をまっすぐT字のように広げている。\n\n衣装:\nhttps://x.com/82_toko3/status/1726445266549846393\nhttps://x.com/82_toko3/status/1699263931649585386\n\nポーズの参考画像。ただし、脚と体の関係がT字形になるよう、より正面を向いた姿勢にしてください。ルルーの髪と服は重力の影響を受けるため、下着が見えるようにしてください。両手の間隔は自由に決めて構いません。必要に応じて体を少し傾けても構いませんので、必ずしも完全に正面を向く必要はありません。\nhttps://www.pixiv.net/artworks/97881159", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/6", "thumbnail_src": "https://si.imgix.net/ad5eb2ba/uploads/origins/da0169da-8501-4d31-934e-17e9c437666e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e52b5d183ba54e6e90542fc094cdd3c2", "thumbnail_srcset": "https://si.imgix.net/ad5eb2ba/uploads/origins/da0169da-8501-4d31-934e-17e9c437666e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e52b5d183ba54e6e90542fc094cdd3c2, https://si.imgix.net/ad5eb2ba/uploads/origins/da0169da-8501-4d31-934e-17e9c437666e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9c8ac4b08b4c1999ffe8bb70f8045f7 2x, https://si.imgix.net/ad5eb2ba/uploads/origins/da0169da-8501-4d31-934e-17e9c437666e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6792dca4cc4566519b6c9c6dfd644aad 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nXにて投稿されていたイラストを拝見し、リクエストさせていただきました。\n絵柄やリンクのような縛りのシチュエーションが非常に好みで、ぜひお願いしたく思っております。\nhttps://x.com/82_toko3/status/1870801338776560023/photo/1\n縄で手足を縛られたウィッチのイラストを描いていただけないでしょうか。\n\n服装は半袖のブラウス制服をお願いできますでしょうか。\nとーこさまが描かれるひらひらした半袖の二の腕が露出したデザインが特に好みですので、その雰囲気でお願いいたします。\n全体の雰囲気はシリアス寄りやR18ではなく、ぷよぷよシリーズのようなコミカルさを維持していただけると嬉しいです。\n\n【構図・描写の希望】\n・縛られた状態でもぞもぞしている様子\n・下記参考画像のように、吹き出し等を用いて背中側で縛られている手首が分かる構図\n・足首も縄で縛られている描写\n・縛り方と縛る位置は以下リンク先イラストのような形\n・可能であれば猿轡の差分もお願いできれば幸いです\n参考画像：\nhttps://prnt.sc/1bblSnFC-qXW\n構図については、あくまで参考程度として捉えていただければと思います。\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/5", "thumbnail_src": "https://si.imgix.net/6b96ec16/uploads/origins/7b21d897-56f6-48d5-9c33-937b694c3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4003a1a80de752a29b60fd0246165a57", "thumbnail_srcset": "https://si.imgix.net/6b96ec16/uploads/origins/7b21d897-56f6-48d5-9c33-937b694c3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4003a1a80de752a29b60fd0246165a57, https://si.imgix.net/6b96ec16/uploads/origins/7b21d897-56f6-48d5-9c33-937b694c3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b474f832058a0a14055d0559d8a9cfd9 2x, https://si.imgix.net/6b96ec16/uploads/origins/7b21d897-56f6-48d5-9c33-937b694c3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e68d600bf3b91222f4f4aeda76a137b7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/4", "thumbnail_src": "https://si.imgix.net/5accc838/uploads/origins/a7aa5303-b326-4075-8bfb-fbeb9a00fd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f57770d94f64fa41175d24a9384ec4d", "thumbnail_srcset": "https://si.imgix.net/5accc838/uploads/origins/a7aa5303-b326-4075-8bfb-fbeb9a00fd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f57770d94f64fa41175d24a9384ec4d, https://si.imgix.net/5accc838/uploads/origins/a7aa5303-b326-4075-8bfb-fbeb9a00fd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fefee59da9a45182215d61ab92e11e42 2x, https://si.imgix.net/5accc838/uploads/origins/a7aa5303-b326-4075-8bfb-fbeb9a00fd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4683d51df6f2d8e07463f51c4aa4e2c 3x", "genre": "art", "nsfw": true, "body": "こんにちはです！\nぷよぷよシリーズのハーピーちゃんを希望させてください！\n\n衣装はいつものワンピース\nどのシリーズのもの(白orピンク)にするかはお好みでどうぞ！\n\nポーズはこちらのような感じで↓\nhttps://x.com/82_toko3/status/1995923824261693530/photo/1\n出来れば足裏が見えてるようにしてもらえると嬉しいです\n表情はちょっと照れたかんじの笑顔が見たいです\n\nいちおうNSFW設定してますが表現の幅を広げるためで、えちくなくてもいいです！\nぜひご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/3", "thumbnail_src": "https://si.imgix.net/153bc6cb/uploads/origins/7e22103e-1eff-41e6-941c-90d7642afa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02a57a63621169a5173f0c2190546572", "thumbnail_srcset": "https://si.imgix.net/153bc6cb/uploads/origins/7e22103e-1eff-41e6-941c-90d7642afa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02a57a63621169a5173f0c2190546572, https://si.imgix.net/153bc6cb/uploads/origins/7e22103e-1eff-41e6-941c-90d7642afa79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0821f7f3f3976ad626b291d1877797fc 2x, https://si.imgix.net/153bc6cb/uploads/origins/7e22103e-1eff-41e6-941c-90d7642afa79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d8de4e9b7ac9c0559934a33aae01620 3x", "genre": "art", "nsfw": true, "body": "こんにちはで！\nセンシティブOKとのことなので、えっっっちなのを希望させてください！\nキャラクターは魔導/ぷよシリーズのウィッチちゃんで\n可能な限りの範囲でのどすけべティックなイラストをお願いしたいです！\n内容はひとまず丸投げさせていただいても大丈夫でしょうか？\n相手がいる場合は、キャラはご自由にどうぞ！\n\n衣装は、ぷよクエ含むどのシリーズのものでもOKです。お気に入りのをどぞ！\nほかに要望を上げると、着衣状態ながら出来るだけ胸や局部が見えるようにしてほしいです！\nそれとリョナ・出血はNGとさせてください！\nぜひご検討ください！", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/2", "thumbnail_src": "https://si.imgix.net/0401d7ca/uploads/origins/fe63c8f4-4a0b-475a-8ea7-78527f74cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b21e953a9707f618590789ebe1213d7", "thumbnail_srcset": "https://si.imgix.net/0401d7ca/uploads/origins/fe63c8f4-4a0b-475a-8ea7-78527f74cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b21e953a9707f618590789ebe1213d7, https://si.imgix.net/0401d7ca/uploads/origins/fe63c8f4-4a0b-475a-8ea7-78527f74cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33488335ccece3a2f847db9c5fb8a753 2x, https://si.imgix.net/0401d7ca/uploads/origins/fe63c8f4-4a0b-475a-8ea7-78527f74cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91f98626463cc510791a5e3f50a8b62d 3x", "genre": "comic", "nsfw": true, "body": "前回描いていただいた石化アルルの石像になってしまったあとの表情が見たくなってしまったため再度リクエスト送らせていただきたいです。\n前回石化したアルルをシェゾが発見し、心配そうに顔に触れるシチュを描いていただきたいです。\n連続のリクエスト申し訳ありません。", "created_at": "", "completed_at": ""}, {"path": "/@82_toko3/works/1", "thumbnail_src": "https://si.imgix.net/67a119e6/uploads/origins/eac01a6c-84e8-40db-b5ab-2081c77ebbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd118586e9934a3370b3bff6c8ff0b4", "thumbnail_srcset": "https://si.imgix.net/67a119e6/uploads/origins/eac01a6c-84e8-40db-b5ab-2081c77ebbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd118586e9934a3370b3bff6c8ff0b4, https://si.imgix.net/67a119e6/uploads/origins/eac01a6c-84e8-40db-b5ab-2081c77ebbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=669965b26238386753f09b9f13eac99e 2x, https://si.imgix.net/67a119e6/uploads/origins/eac01a6c-84e8-40db-b5ab-2081c77ebbd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85a14934d1daa1ce877da75afb54543b 3x", "genre": "comic", "nsfw": true, "body": "Xに投稿されているアルルの作品をみてリクエストしたくなりました。\nニッチなリクエストになってしまうのですが、アルル・ナジャが敵の攻撃でじわじわ石化していき、完全に石像にされダンジョンなどに飾られてしまう漫画を描いていただきたいです。", "created_at": "", "completed_at": ""}]}