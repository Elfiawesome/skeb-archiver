le.com/drive/folders/1-u3bbeJcLCU2nIzMozAU0DV0X0O4gy5u\n\n呂力光（鹿 礼光）：\n- 181cm\n- 力強く威圧的だが、動物に対しては優しく穏やかなオーラを放つ。シンヤンとは、時に衝突することもあるが、とても献身的で彼女を愛している。\n- https://drive.google.com/drive/folders/1-uVAV7QLOFCF8j5JhA1y03HJeC7U5UA_\n\nここまでお読みいただき、ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@S2469q/works/53", "thumbnail_src": "https://si.imgix.net/362fe804/uploads/origins/9f543a53-c16e-4e16-a230-490d5598f398?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a3cecb582bc3219a2a156b056d2dac7", "thumbnail_srcset": "https://si.imgix.net/362fe804/uploads/origins/9f543a53-c16e-4e16-a230-490d5598f398?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a3cecb582bc3219a2a156b056d2dac7, https://si.imgix.net/362fe804/uploads/origins/9f543a53-c16e-4e16-a230-490d5598f398?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f63b12fea363e0925f4299c4e1f3ef64 2x, https://si.imgix.net/362fe804/uploads/origins/9f543a53-c16e-4e16-a230-490d5598f398?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=444c61b570eb3b5dc7666f8b76ecb80b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@S2469q/works/52", "thumbnail_src": "https://si.imgix.net/526401b8/uploads/origins/a5b3649c-9f7d-4146-ab47-28b0acd06789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3165cc662a0c1d14967005fece80fa9f", "thumbnail_srcset": "https://si.imgix.net/526401b8/uploads/origins/a5b3649c-9f7d-4146-ab47-28b0acd06789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=