-a25a-5be4bba5e2de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd6c345c0b48de43f8d835113c7ad4d4", "thumbnail_srcset": "https://si.imgix.net/69877a92/uploads/origins/4a9e965a-6c7a-4937-a25a-5be4bba5e2de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd6c345c0b48de43f8d835113c7ad4d4, https://si.imgix.net/69877a92/uploads/origins/4a9e965a-6c7a-4937-a25a-5be4bba5e2de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbe9c4ccf91df3147059095d858cba53 2x, https://si.imgix.net/69877a92/uploads/origins/4a9e965a-6c7a-4937-a25a-5be4bba5e2de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adc40900f538b9b996ed7666e1946593 3x", "genre": "art", "nsfw": false, "body": "柊 ましろ様\n\n初めまして。\n淡い色遣いとやわらかいタッチ、可愛い表情などとても素敵で、是非依頼したいと思いskeb送らせて頂きました。\n\n 私のVTuberとしての姿を描いていただければと思います。  \n\n【キャラ】 時ツ風ふーり(ときつかぜふーり)  \n\n【イラストイメージ】 \n・可愛いキャミソール、ホットパンツにもふもふの上着を羽織っているような部屋着のイメージ\n ・相棒のもふを一緒にお願いします\n・髪型、構図などはお任せします。\n\n  【使用用途】\n ・YouTubeのサムネイル等の画像素材。\n ・Xなど、配信サイトやSNS活動に使用させていただきたいです。  \n・イラストはネップリやグッズ制作等に使用したいと考えております。\n ・商用利用について許可を頂ければ幸いです。  \n\n【データについて】 \n・ネップリ利用を考えているので、3:4か3:2のサイズでお願いしたいです。\n・可能であれば人物の透過データをお願いいたします。  \n\n【参考資料】\nXのURLなどを貼らせていただきます。\n御検討の程よろしくお願いいたします。\n\nhttps://x.com/tokitsukazefuri?s=21&t=cpQHYyOehRck0yrRrKvw2Q", "created_at": "", "completed_at": ""}, {"path": "/@mashiro_v_046/works/633", "thumbnail_src": "https://si.imgix.net/6fa14e05/uploads/origins/089c8256-4c1c-4586-86be-5580ce734617?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a21a78163b622f8e5c9e59b69198d7ad", "thumbnail_srcset": "https://si.imgix.net/6fa14e05/uploads/origins/089c8256-4c1c-4586-86be-5580ce734617?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a21a78163b622f8e5c9e59b69198d7ad, https://si.imgix.net/6fa14e05/uploads/origins/089c8256-4c1c-4586-86be-5580ce734617?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92d38859624d9dea46829ec88ae070bd 2x, https://si.imgix.net/6fa14e05/uploads/origins/089c8256-4c1c-4586-86be-5580ce734617?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7891107e1742ee165d0d16542f7ba81 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mashiro_v_046/works/632", "thumbnail_src": "https://si.imgix.net/9c5103ad/uploads/origins/e1ad14e3-7fef-4c2f-8ebd-dfe6f33dab83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd50122c531f475c08cce019ed9d4a78", "thumbnail_srcset": "https://si.imgix.net/9c5103ad/uploads/origins/e1ad14e3-7fef-4c2f-8ebd-dfe6f33dab83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd50122c531f475c08cce019ed9d4a78, https://si.imgix.net/9c5103ad/uploads/origins/e1ad14e3-7fef-4c2f-8ebd-dfe6f33dab83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53649e947578eb0b5f51791e02937866 2x, https://si.imgix.net/9c5103ad/uploads/origins/e1ad14e3-7fef-4c2f-8ebd-dfe6f33dab83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2544977315d71bd75822833f15d96702 3x", "genre": "art", "nsfw": false, "body": "初めまして、YouTubeでVTuberとして活動している春鮫もかと申します。\n素敵なイラストをXで拝見し、リクエストをさせて頂きました！\n犬亥ぽちとRafiNicoというユニットを組んでおり、ユニットのイラストをお願いしたいと思っています。\n\n▼使用用途\n配信サムネイル、アイコン、のグッズや返礼品など、商用利用有りでお願いしたいです\n\n▼依頼内容\n手と頭が切れないようにして頂きたいです！\nポーズ自体はお任せします\n\nファイル形式は個別でも使いたいので、PSDだと嬉しいです、、！\n\n検討よろしくお願いします！\n\n▼資料\n\nhttps://drive.google.com/file/d/1qEcIAiJ-R1CAOmnS6zybb1x6F-Di8-b1/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mashiro_v_046/works/631", "thumbnail_src": "https://si.imgix.net/1ebffd89/uploads/origins/b887950a-ea56-4b33-8ab2-d0dfacb8b9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4de8665868731e90cfaea84b294a5e04", "thumbnail_srcset": "https://si.imgix.net/1ebffd89/uploads/origins/b887950a-ea56-4b33-8ab2-d0dfacb8b9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4de8665868731e90cfaea84b294a5e04, https://si.imgix.net/1ebffd89/uploads/origins/b887950a-ea56-4b33-8ab2-d0dfacb8b9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed359f89bcba091d06f07f9012aff3b3 2x, https://si.imgix.net/1ebffd89/uploads/origins/b887950a-ea56-4b33-8ab2-d0dfacb8b9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10dc39f53995d61a101e2cd012964ea6 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n \n個人勢で活動している、Vtuberの桐綱ひより（キリツナヒヨリ）と申します。\n\nふわふわしていてとても可愛くて好きな雰囲気のイラストでしたので、ぜひ描いていただきたいと思いリクエストさせていただきました。   \n\n\n◯描いていただきたいもの\n衣装はリンクにある、私服をお願いしたいです。ポーズなどその他はお任せします。\n\n○キャラクター設定など\n・見習いカフェ店員\n・垂れ耳のうさぎ\n・面白いことが好きでのんびり\n・ポンコツ\n・身長148cm\n・イメージカラー  ピンク\n・ゆるめの三つ編み\n・ピンクのリボンで結んでおります\n\n 〇使用用途・使用範囲  \n・Xでのツイート  \n・配信サイトでのサムネイル  \n・配信サイトでの使用\n※収益化した時の使用も想定しています。\n 許可をいただける場合はリクエスト承認いただければと思います。  \n\n 〇以下のURLから資料をダウンロードできます。  \nhttps://drive.google.com/drive/folders/1--DTplOi-HKtYMzkdk6GSvdHEM1m_EOa\n\n〇サイズ・構図等  \n透過された画像を別で納品いただくか、透過済みのものとレイヤーを分けての納品をしていただけると嬉しいです。  ご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mashiro_v_046/works/630", "thumbnail_src": "https://si.imgix.net/ca83a21a/uploads/origins/b5f04b50-a3c8-4df3-9a31-20aaf880f7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93462e5011df7f39d139aec0f4d4b38f", "thumbnail_srcset": "https://si.imgix.net/ca83a21a/uploads/origins/b5f04b50-a3c8-4df3-9a31-20aaf880f7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93462e5011df7f39d139aec0f4d4b38f, https://si.imgix.