m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ee26160bf3e11ae06f5944c7e9e1c50 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hasumusi005/works/29", "thumbnail_src": "https://si.imgix.net/865fc762/uploads/origins/580063f1-1626-4294-818e-074711dcc895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b50a3c5ce583c6882940d7b615568d5", "thumbnail_srcset": "https://si.imgix.net/865fc762/uploads/origins/580063f1-1626-4294-818e-074711dcc895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b50a3c5ce583c6882940d7b615568d5, https://si.imgix.net/865fc762/uploads/origins/580063f1-1626-4294-818e-074711dcc895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4097e11d62e017df6871f8d727eb9df 2x, https://si.imgix.net/865fc762/uploads/origins/580063f1-1626-4294-818e-074711dcc895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20df2d79d87d7d6b59f035abe28d11c6 3x", "genre": "art", "nsfw": true, "body": "初めまして！\nマリアちゃんのパイズリイラストに心を射抜かれて来ました。\n私からもマリアちゃんのエッチなイラストをリクエストできれば幸いです。\n\n内容は「誰かにお願いされて(それが誰かは男か女かも含めて明かされません)、トップレスなビキニ姿でビーチに来たマリアちゃん。その誰かに対して全く恥じらうことなく淡々と状況を解説し、『変態さんですね』と結論付けるのでした」というものです。\n\nマリアちゃんのビキニは、以前斜蟲様が描かれたマリアちゃんのビキニイラストが望ましいです(資料URL参照)。このビキニボトムのウエストを地面に対して完全に水平にアレンジして頂けると嬉しいです。\n\n構図はマリアちゃんを正面から見たもので(その誰かからの主観視点です)、マリアちゃんの乳首・おへそ・ビキニが同時に全てはっきり見えることで、トップレス姿であることを強調します。\nマリアちゃんは全く恥じらっておらず、怒った様子もなくクールな表情をしています。\n恥ずかしくないため性的興奮は感じておらず、乳首は陥没したままです。\n\n以下にマリアちゃんの台詞を記載しますが、語尾などを彼女らしい言葉遣いに変えて頂くのは全く問題ありません。\n・「私にビキニのボトムだけ履かせ、私の乳首とおへそを衆目に晒したい。」\n・「だから私にトップレスになってとお願いしたと。」\n・「とんだ変態ですね。」\n\nどうかよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/70932387", "created_at": "", "completed_at": ""}, {"path": "/@hasumusi005/works/28", "thumbnail_src": "https://si.imgix.net/b4a4b435/uploads/origins/35193301-4e80-49f4-808e-a8a7bfae76b5?bg=%23fff&auto=fo