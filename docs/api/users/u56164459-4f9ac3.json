%2Ccenter&txtsize=30&txt=PRIVATE&s=0cf2852cf3a8c3aff1ec3a24fda01181, https://si.imgix.net/b423188d/uploads/origins/6d036aba-361b-410e-860e-f14d81488b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c36e2c17094dc54450f210fa83aa838b 2x, https://si.imgix.net/b423188d/uploads/origins/6d036aba-361b-410e-860e-f14d81488b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a4e4173f3b01b62931c9de05783b50c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@u56164459/works/113", "thumbnail_src": "https://si.imgix.net/bdc88ef0/uploads/origins/f904a745-cb43-46b2-ba78-72f0d07fbaba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe8a1588f4d9638786a72fe5b0b2ef6c", "thumbnail_srcset": "https://si.imgix.net/bdc88ef0/uploads/origins/f904a745-cb43-46b2-ba78-72f0d07fbaba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe8a1588f4d9638786a72fe5b0b2ef6c, https://si.imgix.net/bdc88ef0/uploads/origins/f904a745-cb43-46b2-ba78-72f0d07fbaba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91a88b03a09bf87fcb6882ed294a6ac5 2x, https://si.imgix.net/bdc88ef0/uploads/origins/f904a745-cb43-46b2-ba78-72f0d07fbaba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30300042c997853d20a0216801bdfbc1 3x", "genre": "art", "nsfw": false, "body": "うごむいさま  前回はお世話になりました！もし可能でしたら、またお願いできないかと思い、リクエストさせていただきました。今回は、私のOC二人に絵を描いていただきたいです。イラストでも、衣装デザインでも、何を描いていただいても大丈夫です、すべてお任せします！\nご検討いただけますと幸いです。\n【イラストの用途】 \nSNSのアイコンもしくはヘッダー、 デスクトップの壁紙\n【キャラクター設定】。\n▶男（柊　脩斗）：22歳  184cm\n性格はやや軽薄なところもあるが、本質的には優しい病弱青年。家は代々霊能力者の家系で、幼い頃は高い才能を期待されていたが、ある事故により霊力が暴走し、それ以降霊が一切見えなくなってしまった。その事故をきっかけに一族から見捨てられた。なお、幼い頃の霊力暴走事故により左腕を失っており、現在は関節部分に金属構造が見える仮義手を使用しています。見た目はほぼ本物の腕のように作られていますが、細部に人工的な要素が残っています。\n▶女（黒鳥　愈)：18歳  164cm\n無表情で口数の少ない女子高生の幽霊。身体に包帯を巻いている。脩斗の霊力暴走事故に巻き込まれ、命を落としたが、生前の生活はあまりうまくいっておらず、元々死にたいという思いを抱えていたため、脩斗を恨んではいない。\n\n【関係性】\n・幽霊である彼女は、彼の周囲に現れる唯一の霊存在で、彼だけが“見る”ことができる。\n・彼女の方が彼に対して強い依存を抱いており、彼はその依存を嬉しく思っている。\n・静かで不思議な雰囲気の中に、どこかあたたかく切ない関係性です。\n\n資料 URLに画像を添付したので参考にして下さい。  \n可能であればすべてお任せでお願いしたく思います。自由に絵きてください！  \n長文をここまで読んで頂き、ありがとうございました。 文法が悪くて申し訳ありません。  \nご検討よろしくお願い致します！NGでしたら遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/18zf5b27eFnvQ1JUXZsw6S2YhzDLx31Gn", "created_at": "", "completed_at": ""}, {"path": "/@u56164459/works/112", "thumbnail_src": "https://si.imgix.net/d75d1c84/uploads/origins/0fbc3617-dacb-4df9-9199-788941820f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2e35908786ac0b5d72a404fda4c248c", "thumbnail_srcset": "https://si.imgix.net/d75d1c84/uploads/origins/0fbc3617-dacb-4df9-9199-788941820f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2e35908786ac0b5d72a404fda4c248c, https://si.imgix.net/d75d1c84/uploads/origins/0fbc3617-dacb-4df9-9199-788941820f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2b3f624f5baa4dfb37bbe0357bd4a29 2x, https://si.imgix.net/d75d1c84/uploads/origins/0fbc3617-dacb-4df9-9199-788941820f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b79eac4faeb08344d568f9ade231060 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！\nいつもうごむい先生の素敵な作品を拝見しております。\n先生の絵柄とセンスが大好きで、もしご縁がありましたら、ぜひとも創作キャラクターたちの衣装デザインをお願いしたいと思い、リクエストを送らせていただきました。 \n\nキャラクター設定とこちらの要望は以下のようにまとめました。\n===== \n\n>>月上/25歳、179cm、一人称：あたし \n容姿端麗な女装男子、常にほほ笑みで、穏やかな口調を使っている、ふわふわ系な人に見えるが中身はシンプルにヤバい。 \nよく自分の幼馴染をからかっているが、裏側では相手のことについて何だかんだの過保護傾向が見られる。 \n\n>>小鳥遊/25歳、171cm、一人称：僕\n真面目な新米刑事、一見愛想悪そうだが実は人に流されやすい普通ないい奴。ただのツンデレ。 \n可愛いものが大好物。自分はまともな人間としてのプライドを持ちながら、幼馴染の好き勝手の生き方にちょっとだけ羨ましいと思う。 \n\n>>関係性\n長年の付き合いで相手という存在はもう仕方なく慣れてきて、幼馴染と書く腐れ縁。本人たちはそう思っていないが他の人から見れば結構仲良し。\nふたりとも自分こそ相手の世話係だと思っているがふたりともただのバカです。 \n\n【キャラクター設定図・他の参考画像など↓】\nhttps://drive.google.com/drive/folders/1-Aw9n-lIsSdWT4aJ_X2E2amQ7WoYOigc \n\n===== \n\nもしご指定が必要とされる場合、①エレガント・大人かわいい普段着やデート服、②部屋着、③和洋折衷コーデ、④ストリートスタイルなどのテーマから、お二人にいろいろな衣装を着替えていただければと思います。\nもちろん、もしほかにもっと描きたい考案がありましたらそちらにご優先していただいて大丈夫ですので、ご自由に描いていただければと思います。\n小物・髪型のアレンジも先生にお任せします。\n\n===== \n\n金額・依頼内容について問題がございましたら気軽にキャンセルし、または再送要請していただけると幸いです。\nご検討のほど、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@u56164459/works/111", "thumbnail_src": "https://si.imgix.net/25834527/uploads/origins/4e2a0540-1d4b-4458-903e-59528918009f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d987aeb120ba994b0e67bc7457164cc0", "thumbnail_srcset": "https://si.imgix.net/25834527/uploads/origins/4e2a0540-1d4b-4458-903e-59528918009f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d987aeb120ba994b0e67bc7457164cc0, https://si.imgix.net/25834527/uploads/origins/4e2a0540-1d4b-4458-903e-59528918009f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=341539e83b23dab277a52bc6a4e78148 2x, https://si.imgix.net/25834527/uploads/origins/4e2a0540-1d4b-4458-903e-59528918009f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c93dbb91bd70581b796c6cdc9cde81cf 3x", "genre": "art", "nsfw": false, "body": "うごむい様はじめまして。\nかわいい衣装デザインに惹かれてリクエストをお送りさせていただきます。\n下記のキャラクター二名をお描きいただくことは可能でしょうか？\n\n既存衣装でも、うごむい様のデザインされた衣装でも嬉しいです。\nご縁がありましたらどうぞよろしくお願いいたします。\n\nhttps://husky-crown-68c.notion.site/skeb-1f3cc4018b5580b2adfac2d8762b91d2", "created_at": "", "completed_at": ""}, {"path": "/@u56164459/works/110", "thumbnail_src": "https://si.imgix.net/e2b01e26/uploads/origins/735e06c8-e3a6-44bd-9840-53f3c428002d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0120815d3428d94a776617a377ec470d", "thumbnail_srcset": "https://si.imgix.net/e2b01e26/uploads/origins/735e06c8-e3a6-44bd-9840-53f3c428002d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=