eb2-49b4-bbd7-77da588198f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf835c8459365018e74a1116abb2134", "thumbnail_srcset": "https://si.imgix.net/87f4087c/uploads/origins/a388ae62-1eb2-49b4-bbd7-77da588198f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cf835c8459365018e74a1116abb2134, https://si.imgix.net/87f4087c/uploads/origins/a388ae62-1eb2-49b4-bbd7-77da588198f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44ed7d0bdc7299a66d86683c0c34804d 2x, https://si.imgix.net/87f4087c/uploads/origins/a388ae62-1eb2-49b4-bbd7-77da588198f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a47f5cc726c1581e60ae55947e12c06b 3x", "genre": "comic", "nsfw": true, "body": "お初に御目にかかります。お見かけしたショタドクターとオペレーターのおねショタイラストがたいへん好みなのでリクエストさせていただきます。\n\n■概要\nショタドクターとアブサントで完全着衣パイズリ\n■詳細\n・謎のアーツによりウタゲ並みの爆乳になり発情してしまったアブサントと、同じく謎のアーツにやり常に勃起した状態になってしまったショタドクターを一緒に部屋に隔離している。\n(この時、アブサントの服装は通常衣装で、シャツがギチギチになっている)\n・ドクターがチラチラと自分の胸をみていることに気付いたアブサントが我慢できずドクターを押し倒し着衣状態のままパイズリを始める(シャツの隙間から挿入しているイメージ)\n・押し倒されたドクターはなす術もなくパイズリされそのまま乳内射精\n・乳内でまだ勃起したままであることに気付いたアブサントが、「今度はドクターが動いて良いよ」と胸をギュっと寄せて受け入れる体制になる\n・ドクターもたまらず挿入し爆乳を左右から鷲掴みして縦パイズリを開始する\n・すぐ射精してしまうが腰が止まることはなく、射精しながら縦パイズリを継続する\n・アブサントもだんだんと感じてきてしまい、最後の射精にあわせて絶頂する\n・爆乳から男性器を引き出すと、まだ勃起したままで、\n・アブサントの目にハートが浮かび、「まだまだいけるよね？」と良いながらシャツの隙間を広げ精液でどろどろになった谷間を見せつけて終了\n■捕捉\n・アブサントは通常衣装ですが、装備などは省いて問題ありませんが、ちゃくいのままでお願いします\n・アブサントはドクターに優しく射精を促すように囁きかけています\n・ドクターはアブサントのことをお姉ちゃんと呼び、アブサントも「お姉ちゃんが気持ちよくしてあげるね」とそう呼ばれることを受け入れています", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/24", "thumbnail_src": "https://si.imgix.net/7b0d477b/uploads/origins/4cb921e4-5798-4168-a605-fd292a1c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de2b5d5da1eeb7578c5d11543a4b47eb", "thumbnail_srcset": "https://si.imgix.net/7b0d477b/uploads/origins/4cb921e4-5798-4168-a605-fd292a1c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de2b5d5da1eeb7578c5d11543a4b47eb, https://si.imgix.net/7b0d477b/uploads/origins/4cb921e4-5798-4168-a605-fd292a1c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f342a147a0fc80900865dd9d2c4b2884 2x, https://si.imgix.net/7b0d477b/uploads/origins/4cb921e4-5798-4168-a605-fd292a1c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b9eb258b6b2ce42382c035f666775f2 3x", "genre": "comic", "nsfw": true, "body": "はじめまして！\nあなたの描かれるとてもエロい女体と、楽しそうに行為をするアークナイツのキャラたちがとても魅力的でした。\nリクエスト送るのでご検討ください。\n\nアークナイツのホシグマと、ショタではない男ドクターの性行為を描いてください。\nシチュエーションとしては\nホシグマがドクターに奉仕したり、抱かれて感じまくっているようなイチャラブセックスをお願いします。\nホシグマの胸の大きさは盛ってデッカくしてください。\n具体的な対位や行為中のセリフなどはお任せします。\n\n以上になります。\n是非よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/23", "thumbnail_src": "https://si.imgix.net/0f0d4b41/uploads/origins/bbbf0b30-9508-4f2c-9db1-5be66e3496ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f9a8bbbf1f5a1aa8c861df0efd2bc8", "thumbnail_srcset": "https://si.imgix.net/0f0d4b41/uploads/origins/bbbf0b30-9508-4f2c-9db1-5be66e3496ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f9a8bbbf1f5a1aa8c861df0efd2bc8, https://si.imgix.net/0f0d4b41/uploads/origins/bbbf0b30-9508-4f2c-9db1-5be66e3496ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c9a5e4c5bfc52c27ddc5ac4ad1190e5 2x, https://si.imgix.net/0f0d4b41/uploads/origins/bbbf0b30-9508-4f2c-9db1-5be66e3496ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=943087909b0ca898180d06cc52538e7a 3x", "genre": "comic", "nsfw": true, "body": "アークナイツより顔が見えるショタドクターがスノーデビル小隊に搾られる話の続きをお願い致します。\n 逃げようとするショタドクターにスノーデビル小隊(女性のみ)のモブ姉さん達(目元は見えないが口元は見える)に捕まり片方がキスしながら乳首責め、片方がフェラをして寸止めされ続けて、そこにフロストノヴァがきて全員胸を出してドクターにお仕置きだと言い気持ちよくさせてくる\nモブ達に見られながらフロストノヴァがベロチュー手コキをし射精後、背後から乙女の祈り手コキで男の潮吹きを何度もされる\nベロチューしながらパイズリで男性器を大きく戻して、対面座位でお互いに名前を呼びながら気持ちよくなりキスしながら何度も中出しする\nモブ姉さん達に背後から押されてフロストノヴァと強制バックで射精され続けて終わる。\nフロストノヴァ含め全員に言葉責めされ、ショタドクターは抵抗するも気持ちいいと言ってしまう\n3枚以上でお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/22", "thumbnail_src": "https://si.imgix.net/c0dc4ff5/uploads/origins/9978efe1-46a3-47cf-b8ae-037eb0526333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aa082d514b2614b2ad160c8c7725bed", "thumbnail_srcset": "https://si.imgix.net/c0dc4ff5/uploads/origins/9978efe1-46a3-47cf-b8ae-037eb0526333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aa082d514b2614b2ad160c8c7725bed, https://si.imgix.net/c0dc4ff5/uploads/origins/9978efe1-46a3-47cf-b8ae-037eb0526333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95a6f9498a65af6467ae29624425180c 2x, https://si.imgix.net/c0dc4ff5/uploads/origins/9978efe1-46a3-47cf-b8ae-037eb0526333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92f2f6476561248e875d0f143b9a71c6 3x", "genre": "comic", "nsfw": true, "body": "アークナイツよりドクターがウルスラに捕まり快楽に堕とされるのをお願いします。\n ・危機契約と乳契約により以下の契約がつけられる\n⚪︎ウルスラの乳契約でウタゲ以上に胸が大きくなる\n⚪︎ドクターがショタになる\n⚪︎男性器が大きくなる\n⚪︎ウルスラとキスするたびにウルスラが好きになる\n・ドクターはショタになり慌てるがウルスラが乳契約で大きくなった胸を出しながらドクターを気持ちよくさせると言い犯してくる\n・パイズリしながらキスしてきてドクターは抵抗するが自然と腰を動かしてしまいウルスラに何度も射精させられる\n・騎乗位でキスハメしてきてドクターはウルスラが好きになってしまいキスしながら何度も中出しする\n・その後授乳手コキで何度も搾られ、ウルスラはドクターを自分のものにできて満足してドクターとキスを重ねて終わる\n\n2ページ以上でお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/21", "thumbnail_src": "https://si.imgix.net/a83e3a28/uploads/origins/7218efda-d98c-4abe-9f72-77846df20d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=931c8062924963d66d7364dd84ee4d93", "thumbnail_srcset": "https://si.imgix.net/a83e3a28/uploads/origins/7218efda-d98c-4abe-9f72-77846df20d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=931c8062924963d66d7364dd84ee4d93, https://si.imgix.net/a83e3a28/uploads/origins/7218efda-d98c-4abe-9f72-77846df20d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbba2f2785f02004be4c27dfa960ec50 2x, https://si.imgix.net/a83e3a28/uploads/origins/7218efda-d98c-4abe-9f72-77846df20d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2597c7612db44c665b3a09eec0745ad4 3x", "genre": "comic", "nsfw": true, "body": "前回Wのリクエストをしたものですが、アークナイツよりドクターがレユニオンのWに捕まったまま逆レイプの続きをお願いします。\n ・小さくなったドクターは寝てると男性器が気持ちいいことに気づき起きると音律聯覚2023の格好(白黒のアイマスク的なのはつけてない)のWにフェラされておりドクターはWがエロい格好なのもあり恋人繋ぎされながらすぐに射精\n ・Wは自分が怪盗みたいな格好なのもありシチュエーションプレイを始めて胸を出してパイズリでたいへ〜ん、ドクターくんのおチンチンが悪〜い怪盗Wのおっぱいに捕まっちゃった❤️的なセリフで言葉責めしドクターは感じてしまいこんなの気持ち良すぎて逃げられないと心の中で思ってしまい、Wにまたフェラして飲んでとおねだりしWは受け入れてパイズリフェラで射精\n ・騎乗位で乳首舐めしながら一度射精後、授乳もされ顔がとろけたドクターはWにキスをねだり、Wは怪盗らしくあんたの精液もたっぷりいただいちゃうわ❤️中に出しなさい❤️と言い唇と唇をくっつけるキスしながら大量に中出し。\n・その後Wはドクターの後ろに回り睾丸 を揉みながら手コキし、あんたはずっと私のものよ❤️イケ❤️イケ❤️と言いながらベロチューして責めまくり、ドクターはWからの快楽に抗えずWの手コキを受けて、あっ❤️Wそこ気持ちいい❤️いく❤️いっちゃう❤️と言いながら何度も手コキで射精してWの手を汚して終わる\nお互い半脱ぎで2ページ以上でお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/20", "thumbnail_src": "https://si.imgix.net/38f8f36f/uploads/origins/30f00f5f-e4ba-403a-bfec-df24b67b8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32a9bbaa4f25e416f4850eac935f1185", "thumbnail_srcset": "https://si.imgix.net/38f8f36f/uploads/origins/30f00f5f-e4ba-403a-bfec-df24b67b8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32a9bbaa4f25e416f4850eac935f1185, https://si.imgix.net/38f8f36f/uploads/origins/30f00f5f-e4ba-403a-bfec-df24b67b8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6c5fd9304da62c8c9c9321e52b33afd 2x, https://si.imgix.net/38f8f36f/uploads/origins/30f00f5f-e4ba-403a-bfec-df24b67b8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1986b64f063576c6b41a9054d9466a34 3x", "genre": "art", "nsfw": true, "body": "いつもイラストを楽しませていただいております。\n\nブルーアーカイブから、椅子に座った〇ョタ先生（たぶん顔が写る構図ですので細かいデザインはお任せします。特にこだわりない場合アイコンの先生でお願いします）を\n左右から赤バニーの池倉マリナと白バニーの佐城トモエが胸に顔が埋まるくらいの高さで挟み込んでいるイラストをお願いします。\nマリナは若干困惑気味、トモエは余裕の笑みを浮かべていると良いです。\n\nコミケでskebどころでなかったらまた追って依頼します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/19", "thumbnail_src": "https://si.imgix.net/51e98295/uploads/origins/401767b1-7cf4-48ca-b2d8-cd19ebbfeb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8957831664a109af1bebce9dcc8560e", "thumbnail_srcset": "https://si.imgix.net/51e98295/uploads/origins/401767b1-7cf4-48ca-b2d8-cd19ebbfeb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8957831664a109af1bebce9dcc8560e, https://si.imgix.net/51e98295/uploads/origins/401767b1-7cf4-48ca-b2d8-cd19ebbfeb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e3e47bf41bf882c358b7401c8705239 2x, https://si.imgix.net/51e98295/uploads/origins/401767b1-7cf4-48ca-b2d8-cd19ebbfeb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b211ff91b82cb548dde2c3f5b374b08 3x", "genre": "comic", "nsfw": true, "body": "アークナイツより顔が見えるショタドクターがアスカロン(大陸版実装)に搾られるのをお願いします\n ・アスカロンは紫色(角や尻尾の先のような色)のカラーリップをしており胸を出して半脱ぎ\n ・ドクターがアスカロンの名前で1人自慰しているとアスカロンが現れてショタドクターを手伝ってくれる\n ・ドクターの男性器にキスして紫色(角や尻尾の先のような色)のカラーリップを大量につけて、アスカロンはこのカラーリップをつけたところは敏感になり気持ちよくなれ一度の射精で大量に精液が出ることを説明する \n・アスカロンはそのままパイズリしてショタドクターはカラーリップの効果で自慰の時より断然気持ちよくなり、アスカロンにイケ❤️イッテしまえ❤️と言われながら高速で動かして一度の射精で大量射精してアスカロンの顔や胸を汚す \n・アスカロンは軽く拭き舌舐めずりして、射精した罰としてショタドクターを休ませず両方の乳首にキスしてカラーリップをつけてから片方の乳首を舐め続け、もう片方の乳首を尻尾でいじめながら高速で手コキする\n ・ショタドクターは快楽で喘ぎ、アスカロンは男の潮吹きは普通の射精よりも何倍も気持ちいいことを説明しながらベロチュー手コキして男の潮吹きを何度もする \n・アスカロンはショタドクターとキスしながら騎乗位をして何度も中出ししてしまう (できれば断面図もお願い致します)\n・アスカロンは優しく言葉責めしてきてショタドクターを気持ちよくさせ、ショタドクターはカラーリップやアスカロンのテクニックで気持ちよくなってしまう", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/18", "thumbnail_src": "https://si.imgix.net/d7e1b77b/uploads/origins/07cc763f-65ed-4260-8d99-9c980d269407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3d3ebaacfa809ffbf47c9b7160e7c87", "thumbnail_srcset": "https://si.imgix.net/d7e1b77b/uploads/origins/07cc763f-65ed-4260-8d99-9c980d269407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3d3ebaacfa809ffbf47c9b7160e7c87, https://si.imgix.net/d7e1b77b/uploads/origins/07cc763f-65ed-4260-8d99-9c980d269407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58fe1c62b0ae64b8731f34c7a5556a94 2x, https://si.imgix.net/d7e1b77b/uploads/origins/07cc763f-65ed-4260-8d99-9c980d269407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc3f1c4229eaf50bfaffaf88e0172baf 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/17", "thumbnail_src": "https://si.imgix.net/332380d1/uploads/origins/af45c629-aeae-44a5-a37d-4f6ac8dda37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c4e165e99e27a69e28da28add36475", "thumbnail_srcset": "https://si.imgix.net/332380d1/uploads/origins/af45c629-aeae-44a5-a37d-4f6ac8dda37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c4e165e99e27a69e28da28add36475, https://si.imgix.net/332380d1/uploads/origins/af45c629-aeae-44a5-a37d-4f6ac8dda37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=638e270029fce58bd82ac0b9156a7473 2x, https://si.imgix.net/332380d1/uploads/origins/af45c629-aeae-44a5-a37d-4f6ac8dda37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=351474d1ede5444420ce14bd5abad86e 3x", "genre": "art", "nsfw": false, "body": "こちらでは初めまして！（Misskeyの方でお世話になっております）\n\n塗りなどが好みで、凄く気になったのでリクエストします！\n\nキャラクター…聖園ミカ（ブルーアーカイブ）\n\n構図や衣装…まさる先生の良さげだなと思うものでお任せ致します（健全寄り）\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/16", "thumbnail_src": "https://si.imgix.net/526e24be/uploads/origins/9ebca171-e740-45f2-8e59-8ecf08d322ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ad9ec40a20a3789f086a7bfbc4ef31f", "thumbnail_srcset": "https://si.imgix.net/526e24be/uploads/origins/9ebca171-e740-45f2-8e59-8ecf08d322ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ad9ec40a20a3789f086a7bfbc4ef31f, https://si.imgix.net/526e24be/uploads/origins/9ebca171-e740-45f2-8e59-8ecf08d322ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e248ff514d22e0d5c851ad13478a7505 2x, https://si.imgix.net/526e24be/uploads/origins/9ebca171-e740-45f2-8e59-8ecf08d322ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5883fadf2912d3fdbe03e836c5f8ff7d 3x", "genre": "comic", "nsfw": true, "body": "アークナイツより顔が見えるショタドクターがスノーデビル小隊に搾られるのをお願い致します。\nスノーデビル小隊(女性のみ)のとこに連れてかれモブ姉さん達(目元は見えないが口元は見える)のアーツによりショタになり、フロストノヴァ含め全員が胸を出してドクターに迫る。モブ達に見られながらフロストノヴァがベロチュー手コキをし射精、恋人繋ぎフェラをし射精、ベロチューしながら騎乗位で射精後フロストノヴァとキスしながらモブ姉さん達にトリプルフェラで射精されて終わる。フロストノヴァ含め全員に言葉責めされ、ショタドクターは抵抗するも気持ちいいや本番でエレーナと名前を言い快楽に堕ちる。3枚以上でお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/15", "thumbnail_src": "https://si.imgix.net/c3e3de46/uploads/origins/d32d0336-5c7c-45e1-94e0-b2795e1ae3fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=712e66dfac873d220f80472f50ab5968", "thumbnail_srcset": "https://si.imgix.net/c3e3de46/uploads/origins/d32d0336-5c7c-45e1-94e0-b2795e1ae3fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=712e66dfac873d220f80472f50ab5968, https://si.imgix.net/c3e3de46/uploads/origins/d32d0336-5c7c-45e1-94e0-b2795e1ae3fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4736b07538898a4b171e8bd6054376a3 2x, https://si.imgix.net/c3e3de46/uploads/origins/d32d0336-5c7c-45e1-94e0-b2795e1ae3fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c94888a8a906d0cd21bc7b297c24ca2 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます！\nブルーアーカイブ 陸八魔アル(ドレス)をお願いしたいです。乳は公式より盛ってくれると嬉しいです！\n\nポーズは指定無しで、健全差分+R18差分(乳がまろびでてる差分)をお願いします！\n\n宛名は健全差分のみに書いて欲しいです！", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/14", "thumbnail_src": "https://si.imgix.net/fe680560/uploads/origins/c00abb4d-907b-4edb-8a82-3ff973e104a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d34adb613cc111afeb0ed9f8622d74", "thumbnail_srcset": "https://si.imgix.net/fe680560/uploads/origins/c00abb4d-907b-4edb-8a82-3ff973e104a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d34adb613cc111afeb0ed9f8622d74, https://si.imgix.net/fe680560/uploads/origins/c00abb4d-907b-4edb-8a82-3ff973e104a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f21375a4047cf84ad77581bcf176ae1f 2x, https://si.imgix.net/fe680560/uploads/origins/c00abb4d-907b-4edb-8a82-3ff973e104a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ddedc6708dd263f28c6ca82ec2ebcac 3x", "genre": "art", "nsfw": true, "body": "アークナイツより顔が見えるショタドクターがリンに搾られるのをお願いします。ドクターのことが好きでチェンよりも早く自分のものにしたい通常衣装のリンはドクターに濃厚なキスをしてその後胸を出してドクターに近づく。激しくパイズリしてきてドクターは耐えるがリンは耐えるドクターを可愛く思い、パイズリしながらベロチューもしてきて遂には射精。その後騎乗位(可能なら断面図あり)でベロチューしながら動き中に出してと何度も言われ気持ちよくなり射精。最後はベロチュー手コキされドクターは折れなかったが、リンがこれから毎日来て自分のものになるまで犯してあげると言い終わる。リンは的確に言葉責めし、2枚以上でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/13", "thumbnail_src": "https://si.imgix.net/779427a2/uploads/origins/2ba3cdce-b2b8-419b-bbd5-3829851a6cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b21b2abefe6d484379b22c37855add9", "thumbnail_srcset": "https://si.imgix.net/779427a2/uploads/origins/2ba3cdce-b2b8-419b-bbd5-3829851a6cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b21b2abefe6d484379b22c37855add9, https://si.imgix.net/779427a2/uploads/origins/2ba3cdce-b2b8-419b-bbd5-3829851a6cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f50eded73b49c63af97bfefd5a4d8f 2x, https://si.imgix.net/779427a2/uploads/origins/2ba3cdce-b2b8-419b-bbd5-3829851a6cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=225b8dad13f0c769daa21e075d797f80 3x", "genre": "art", "nsfw": true, "body": "アークナイツより男ドクターがホルハイヤに搾られるのをお願い致します。\nホルハイヤは尻尾でドクターを拘束し長舌を使った濃厚なキスでドクターの肉棒を大きくさせる。2人とも半脱ぎになりホルハイヤはURLのような長舌でフェラをしてドクターは何度も射精してしまう。ホルハイヤは何度も見てきた胸を強調させパイズリでドクターは腰を動かしてしまいホルハイヤはパイズリフェラしてきてまた射精してしまう。その後ベロチュー手コキで優しく搾られ続けて終わる。ホルハイヤは言葉責めをしてきてドクターは何とか抵抗するセリフを言う。\nhttps://www.pixiv.net/artworks/107118505#big_0", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/12", "thumbnail_src": "https://si.imgix.net/0ec95f4a/uploads/origins/f5e902a9-c0b0-4167-86e7-a979814bde92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e94143ff3c080a4e6ebcf5128957dc6b", "thumbnail_srcset": "https://si.imgix.net/0ec95f4a/uploads/origins/f5e902a9-c0b0-4167-86e7-a979814bde92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e94143ff3c080a4e6ebcf5128957dc6b, https://si.imgix.net/0ec95f4a/uploads/origins/f5e902a9-c0b0-4167-86e7-a979814bde92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00056dcbbc241fb65d2aac4661bb4859 2x, https://si.imgix.net/0ec95f4a/uploads/origins/f5e902a9-c0b0-4167-86e7-a979814bde92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38000ac93f86c475467f7f2d43b55276 3x", "genre": "art", "nsfw": true, "body": "前回Wのリクエストをしたものですが、アークナイツよりドクターがレユニオンのWに再び捕まり逆レイプの続きをお願いします。\n  ・小さくなったドクターはWの隙を見て逃げようとするがWに見つかる\n・逃げた罰でWは濃厚なベロチュー手コキで射精させ、ドクターの後ろに回り両手で手コキして男の潮吹きをさせる\n・ドクターの男性器が小さくなりWは男性器にキスしまくり大きくしてくる\n・そのまま騎乗位をし両手で乳首責めもしてきて一度射精し、Wは連続で動いてベロチューもしてきてドクターも舌を絡めまた射精\n・Wに授乳手コキされて終わる\n前回のような言葉責めでお互い半脱ぎで2ページ以上でお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/11", "thumbnail_src": "https://si.imgix.net/aa21b479/uploads/origins/b00cfc04-549c-4eae-873a-201922bf4068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=650fb6ea1998caa60bea9252d2f4d9f0", "thumbnail_srcset": "https://si.imgix.net/aa21b479/uploads/origins/b00cfc04-549c-4eae-873a-201922bf4068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=650fb6ea1998caa60bea9252d2f4d9f0, https://si.imgix.net/aa21b479/uploads/origins/b00cfc04-549c-4eae-873a-201922bf4068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=182f280cb32e18391ed2dbd1b171d54a 2x, https://si.imgix.net/aa21b479/uploads/origins/b00cfc04-549c-4eae-873a-201922bf4068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f032340d3e71c3aaf279146ff78e2ff9 3x", "genre": "art", "nsfw": true, "body": "アークナイツより顔が見えるショタドクターが敵に操られたフランカとリスカムに搾られるのをお願いします。\nドクターは2人に捕まってしまい半脱ぎにされ、2人も半脱ぎで胸を見せてフランカはドクターの後ろから竿を手コキしリスカムは亀頭をフェラをして射精。\nドクターは必死に耐えるが2人からの言葉責めやテクニックにより次第に気持ちいいと言う。\nその後は2人から交互にベロチューしながら騎乗位で犯され中出ししてしまう。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/10", "thumbnail_src": "https://si.imgix.net/3f342366/uploads/origins/2e54998a-e38c-4bfa-b153-c7b6c52b95d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971ac7ed5b43e8001ea8a96e5dd997ee", "thumbnail_srcset": "https://si.imgix.net/3f342366/uploads/origins/2e54998a-e38c-4bfa-b153-c7b6c52b95d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971ac7ed5b43e8001ea8a96e5dd997ee, https://si.imgix.net/3f342366/uploads/origins/2e54998a-e38c-4bfa-b153-c7b6c52b95d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb6975526fa8dfa2bbab58046c2e824c 2x, https://si.imgix.net/3f342366/uploads/origins/2e54998a-e38c-4bfa-b153-c7b6c52b95d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c50f3dc03cb1c077766859d585ab75c4 3x", "genre": "art", "nsfw": true, "body": "アークナイツよりショタのドクターがコーデのニェンとシーにW手コキされるのをお願いします。\nドクターは顔が見えシーとニェンは半脱ぎで胸が露出して、ニェンがベロチューして竿を激しく動かしシーが乳首舐めして亀頭を優しく撫でて射精。\nその後今度はシーとニェンが恋人繋ぎのW手コキで、シーがベロチューしてニェンが乳首舐めしてまた射精してしまう。\nドクターは気持ちよく喘ぎ、シーとニェンは交互に相反囁きをする感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/9", "thumbnail_src": "https://si.imgix.net/afb5c256/uploads/origins/9e60be31-259a-4379-8aaf-27b8418609ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e538c436fcf443e06ac5924aa589222", "thumbnail_srcset": "https://si.imgix.net/afb5c256/uploads/origins/9e60be31-259a-4379-8aaf-27b8418609ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e538c436fcf443e06ac5924aa589222, https://si.imgix.net/afb5c256/uploads/origins/9e60be31-259a-4379-8aaf-27b8418609ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=935820acb4795ad84974c669e07c7245 2x, https://si.imgix.net/afb5c256/uploads/origins/9e60be31-259a-4379-8aaf-27b8418609ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94676bfc8daf2b1f6c725c46cffb02cb 3x", "genre": "art", "nsfw": true, "body": "顔がでてるショタドクターと遊龍チェンと水着ブレイズでイチャラブをお願いします。\n水着オペたちを見て男性器が大きくなってるドクターを見て二人はドクターを連れて男性器を舐めたりキスしたりして気持ちよくする。\nその後二人は胸を見せてブレイズがバックで待ちチェンがドクターの後ろから押してバックさせて射精させる。\n今度はチェンがバックで待ちブレイズがドクターの後ろから押してバックさせてまた射精させる。その後二人からお掃除フェラされて終わる形でお願いします。\n\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/8", "thumbnail_src": "https://si.imgix.net/dee684fa/uploads/origins/3a1e7450-1077-4889-93d8-138feb1b3811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27624f303f9ef898620725769e5b979c", "thumbnail_srcset": "https://si.imgix.net/dee684fa/uploads/origins/3a1e7450-1077-4889-93d8-138feb1b3811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27624f303f9ef898620725769e5b979c, https://si.imgix.net/dee684fa/uploads/origins/3a1e7450-1077-4889-93d8-138feb1b3811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a661b59c6057bf7f2e5772a8d3169fc1 2x, https://si.imgix.net/dee684fa/uploads/origins/3a1e7450-1077-4889-93d8-138feb1b3811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a96e3a2613321fdb867d7b6f05e3e57 3x", "genre": "art", "nsfw": true, "body": "アークナイツよりリリアが生きていた世界線でショタドクターが搾り取られるのをお願いします。\n ・ドクターは部屋で一人自慰しておりリリアはたまたま居合わせてしまいリリアが性処理をしてくれるようになった\n・リリアはケルシーのイベントのときの服装でお互い半脱ぎになる\n・過去のインドラのイラストのような濃厚なベロチュー手コキで優しく搾ってきて射精\n・リリアはフェラに回復アーツをこめて男性器を敏感にさせドクターは気持ちよく喘ぎ、射精\n・リリアは言葉責めしたりシコシコと音を言ったりなどしてくる", "created_at": "", "completed_at": ""}, {"path": "/@masaru_________/works/7", "thumbnail_src": "https://si.imgix.net/494d873a/uploads/origins/1c695039-9b00-4f53-9d9b-2a4a009d7a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6daf4fa012ff06cffeb6c92d89a2d99", "thumbnail_srcset": "https://si.imgix.net/494d873a/uploads/origins/1c695039-9b00-4f53-9d9b-2a4a009d7a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6daf4fa012ff06cffeb6c92d89a2d99, https://si.imgix.net/494d873a/uploads/origins/1c695039-9b00-4f53-9d9b-2a4a009d7a52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f156c191ee27203ecf18d8a3d0eca20a 2x, https://si.imgix.net/494d873a/uploads/origins/1c695039-9b00-4f53-9d9b-2a4a009d7a52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b88bbe396c8ff57cbe91dd3ca574c761 3x", "genre": "art", "nsfw": true, "body": "前回Wのリクエストをしたものですが、アークナイツよりドクターがレユニオンのWに捕まり逆レイプの続きをお願いします。 \n・ドクターはWに薬を口移しされ、ショタになっている。(背の大きさなどは前回と同じでお願いします)(精神面は大人の時のまま)\n・薬の副作用で男性器は大きくなりWも発情しお互い半脱ぎ(胸は露出させる)で行う\n・Wはドクターの男性器を握り騎乗位をしてドクターは気持