a87-4039-be45-bb0d2990b5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909e8017143f53562e8cdf7776ca0fe3", "thumbnail_srcset": "https://si.imgix.net/b3b88565/uploads/origins/db3db73f-4a87-4039-be45-bb0d2990b5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909e8017143f53562e8cdf7776ca0fe3, https://si.imgix.net/b3b88565/uploads/origins/db3db73f-4a87-4039-be45-bb0d2990b5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb1e28480b380d2c5e7bdb81b8a2f075 2x, https://si.imgix.net/b3b88565/uploads/origins/db3db73f-4a87-4039-be45-bb0d2990b5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0845493095b5b2c9e787f2132e2db516 3x", "genre": "art", "nsfw": false, "body": "白（女）：毒婦、狡猾な笑み虎。鷹を調教し、白鳶を飼っている（描画は任意）。黒（男）：凶犬、武芸に長ける。仕事は忠実だが、口が毒を帯びている。\n ステレオタイプ：対抗路の相棒／異性嫌いの同僚／仲の悪いライバルボスに忠実な有能な手下×2。拷問と暗殺を得意とし、連携は完璧だが性格は水と油。会うたびに口論や挑発、皮肉を言い合い、上司の寵愛を得るため表裏で競い合う。 鋭く対立することもあれば、親密な行動（喧嘩・傷の手当て・共同作戦・わざと曖昧な行動で相手を苛立たせる）も見せる。小学生の喧嘩でも問題なし。完全なる利害関係に基づく協力で、愛情も友情もない。しかし、同じ忠誠心ゆえに、望まぬながらも互いを理解してしまう…！いわゆる「ライバル」も同軛（どうぎょ）である。 \n二人は同年代の若者で、黒が白より少し背が高い。人物でも動物でも描けて、先生は自由に選択できる。\n\nhttps://drive.google.com/drive/folders/1ZKdbIat1_05ytEfMV5_rayNXvyWvk6e4", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1573", "thumbnail_src": "https://si.imgix.net/dc03fcea/uploads/origins/2da4aa41-8f60-4b55-8e45-d70e97872d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307920a2b66ffe5d3c2a994233bbfaa6", "thumbnail_srcset": "https://si.imgix.net/dc03fcea/uploads/origins/2da4aa41-8f60-4b55-8e45-d70e97872d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307920a2b66ffe5d3c2a994233bbfaa6, https://si.imgix.net/dc03fcea/uploads/origins/2da4aa41-8f60-4b55-8e45-d70e97872d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e7044dfa2e81541302d36e1a34c29b7 2x, https://si.imgix.net/dc03fcea/uploads/origins/2da4aa41-8f60-4b55-