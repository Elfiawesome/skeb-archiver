d-453d-aa8a-dcb9f6fd6ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e62e0855b88e7f4fd1e308a7c6af9320", "thumbnail_srcset": "https://si.imgix.net/6ef0096a/uploads/origins/8424c843-b64d-453d-aa8a-dcb9f6fd6ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e62e0855b88e7f4fd1e308a7c6af9320, https://si.imgix.net/6ef0096a/uploads/origins/8424c843-b64d-453d-aa8a-dcb9f6fd6ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47c3f93bc3e07495c0875b510418ebe2 2x, https://si.imgix.net/6ef0096a/uploads/origins/8424c843-b64d-453d-aa8a-dcb9f6fd6ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5418d79de8a48f5fbfb0abd8b81e69e0 3x", "genre": "art", "nsfw": false, "body": "Hello again!\nMy friend was wondering if you could draw his character again.\nHe was looking for something he could potentially use as a profile picture and just more art in general.\nPose/Expression is up to you!\n\nHe is an effeminate, bratty, and spoiled cat prince.\n\nhttps://imgur.com/a/9z12zvp", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1578", "thumbnail_src": "https://si.imgix.net/b1276d30/uploads/origins/ad631c61-c05d-4504-a29d-bcf4d66c253c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=639f510c426a3f8da22b46aa05529a5c", "thumbnail_srcset": "https://si.imgix.net/b1276d30/uploads/origins/ad631c61-c05d-4504-a29d-bcf4d66c253c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=639f510c426a3f8da22b46aa05529a5c, https://si.imgix.net/b1276d30/uploads/origins/ad631c61-c05d-4504-a29d-bcf4d66c253c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e61658fad86305dfa7c418b16e18905e 2x, https://si.imgix.net/b1276d30/uploads/origins/ad631c61-c05d-4504-a29d-bcf4d66c253c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ad561f7801db3ea59221251a540fa65 3x", "genre": "art", "nsfw":