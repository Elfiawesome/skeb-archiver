7/uploads/origins/0af02bf9-b823-4d6b-aabc-e1c2df8eca4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c357523bef324a2936775d166b3d20d9", "thumbnail_srcset": "https://si.imgix.net/b1e25207/uploads/origins/0af02bf9-b823-4d6b-aabc-e1c2df8eca4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c357523bef324a2936775d166b3d20d9, https://si.imgix.net/b1e25207/uploads/origins/0af02bf9-b823-4d6b-aabc-e1c2df8eca4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=834bfeff2f869fc6cedb98752e7e0439 2x, https://si.imgix.net/b1e25207/uploads/origins/0af02bf9-b823-4d6b-aabc-e1c2df8eca4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e7704c23819df3904abd5ed8c50ebe6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風、本当に大好きです！！\n\n私のオリジナルキャラクター（OC）のコミッションをお願いできませんか？\n1人目は「Rathal」。皮肉屋で元気いっぱいの王子です。\n2人目は「Maidos」。人間から悪魔に変身した、内気で控えめなキャラクターです。\n\n「Maidos」には2種類のデザインがあるので、お好きな方を選んで描いてください。\n\nお時間をいただき、ご検討ありがとうございます！！ ^_^\n\nhttps://drive.google.com/drive/folders/1M8RqKujXMxqwICuPDst64QKUMKk3kBL9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1586", "thumbnail_src": "https://si.imgix.net/9cabe50f/uploads/origins/2089cbe4-8c81-4433-bd32-cb371a8359e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e25e7a6bf325743f63c58c2290c823b", "thumbnail_srcset": "https://si.imgix.net/9cabe50f/uploads/origins/2089cbe4-8c81-4433-bd32-cb371a8359e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e25e7a6bf325743f63c58c2290c823b, https://si.imgix.net/9cabe50f/uploads/origins/2089cbe4-8c81-4433-bd32-cb371a8359e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4abe393ebfa19e0865bee5b616b06027 2x, https://si.imgix.net/9cabe50f/uploads/origins/2089cbe4-8c81-4433-bd32-cb371a8359e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e352e0c12ec7a72fdf103ce899780b6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1585", "thumbnail_src": "https://si.imgix.net/9cde35d8/uploads/origins/bafe964f-6719-42b1-ad36-c462625b29a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6710f73fb7f87bc0fdd93883d09d8f1", "thumbnail_srcset": "https://si.imgix.net/9cde35d8/uploads/origins/bafe964f-6719-42b1-ad36-c462625b29a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6710f73fb7f87bc0fdd93883d09d8f1, https://si.imgix.net/9cde35d8/uploads/origins/bafe964f-6719-42b1-ad36-c462625b29a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c29e16376c842f2dac1597ac752f3fa 2x, https://si.imgix.net/9cde35d8/uploads/origins/bafe964f-6719-42b1-ad36-c462625b29a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b775d37a83ff4b560bdba853fb387ecb 3x", "genre": "art", "nsfw": false, "body": "「ラスボス系の味方」。\n\n炎も、水も、運命さえも――\nすべてを踏み越えて君を救い出す。\nだが、その災厄の出処を問うな。答えはいつも、舞台の裏側にある。\n\n危険があるときは最も安全で、危険がないときは最も危険な存在。\n\n狡猾で神出鬼没。\nあらゆる出来事を悪戯や「遊戯（ゲーム）」として扱い、誇張された芝居がかった言動で場を支配する。時に論理すら置き去りにする。\n\n帽子と髪型で右目を隠し、髪の先は羽根状。\n青白いリボンやストリーマー、マジック道具を纏い、常に杖を携えている。\n顔にはフルフェイスの仮面を着用。\n\n「肌を一切見せない」というコンセプトで、全身は衣服と仮面によって完全に覆われている。\n\nhttps://drive.google.com/drive/folders/16BHmmxTr9YT8dc-iu3GlOz7icrsNHNse", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1584", "thumbnail_src": "https://si.imgix.net/53ee2c6b/uploads/origins/549f4f5c-f403-4df6-b637-099bc1a26e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9858104ceff771e3c1a7dba35eb3369b", "thumbnail_srcset": "https://si.imgix.net/53ee2c6b/uploads/origins/549f4f5c-f403-4df6-b637-099bc1a26e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9858104ceff771e3c1a7dba35eb3369b, https://si.imgix.net/53ee2c6b/uploads/origins/549f4f5c-f403-4df6-b637-099bc1a26e42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a17d4e6e7bf8c2ef415f527b865706 2x, https://si.imgix.net/53ee2c6b/uploads/origins/549f4f5c-f403-4df6-b637-099bc1a26e42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa22c64d385e7f8c629149c423e88e7a 3x", "genre": "art", "nsfw": false, "body": "先生！私のキャラクター、アドロとノスを描いていただけますか？アドロ：おバカな狐の魔法使い（性別なし）ノス：真面目なツンデレウサギの少年（狙撃銃を使う）二人はよくふざけてケンカします！\n\nキャラクター、参考画像、作品はこちらhttps://eggshelly.notion.site/AdlNos-2d0df7af961280b7ace4ef517d27148d", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1583", "thumbnail_src": "https://si.imgix.net/dd87d73b/uploads/origins/304ee7f4-7736-48f8-84c3-7a5ae55daaff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c38cdb9e570b49e7224c07f7407f6a4d", "thumbnail_srcset": "https://si.imgix.net/dd87d73b/uploads/origins/304ee7f4-7736-48f8-84c3-7a5ae55daaff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c38cdb9e570b49e7224c07f7407f6a4d, https://si.imgix.net/dd87d73b/uploads/origins/304ee7f4-7736-48f8-84c3-7a5ae55daaff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=617e42f1eb30196490396078a2e6c558 2x, https://si.imgix.net/dd87d73b/uploads/origins/304ee7f4-7736-48f8-84c3-7a5ae55daaff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9168ede87aeb606ca89e017f6857a140 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のオリジナルキャラクター（OC）の最近のスケッチのようなものを希望します。落書き付きで。シン：内向的、疲れている、自己破壊的、曲作りとギターで対処 *左利き：腕のスリーブで傷跡を隠している。ストレス時、手が痛み物を握れないユン：無頓着、幽霊のような追加可能：水、音楽、陰鬱、睡眠のディテール、リンク内の動物\n\nhttps://drive.google.com/drive/folders/1aAPwPjgtqVmIulM1cGdSMDDsf68C6lLG", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1582", "thumbnail_src": "https://si.imgix.net/f14acab6/uploads/origins/14f60ce7-15b0-495e-999f-1a0b129369b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad14337076a6cdaf2d040a276fd97931", "thumbnail_srcset": "https://si.imgix.net/f14acab6/uploads/origins/14f60ce7-15b0-495e-999f-1a0b129369b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad14337076a6cdaf2d040a276fd97931, https://si.imgix.net/f14acab6/uploads/origins/14f60ce7-15b0-495e-999f-1a0b129369b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb5d2396537ce44cbc75d5a0f3354ec4 2x, https://si.imgix.net/f14acab6/uploads/origins/14f60ce7-15b0-495e-999f-1a0b129369b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01d7e1afdbdd2c7768ca70356b564b4a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@scomsio/works/1581", "thumbnail_src": "https://si.imgix.net/50f85521/uploads/origins/10aacb73-16ef-49e0-93d5-9a728dae5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4d1b0373f5616dad215f3cc31bf4f99", "thumbnail_srcset": "https://si.imgix.net/50f85521/uploads/origins/10aacb73-16ef-49e0-93d5-9a728dae5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4d1b0373f5616dad215f3cc31bf4f99, https://si.imgix.net/50f85521/uploads/origins/10aacb73-16ef-49e0-93d5-9a728dae5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21a6bedd0