eated_at": "", "completed_at": ""}, {"path": "/@okomegaokazu00/works/2", "thumbnail_src": "https://si.imgix.net/dfcd9658/uploads/origins/5b7d3f0e-8bfb-46af-b9f7-828ef67d3835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f4ad8e35dbe6592e4e40b0d594d5dc3", "thumbnail_srcset": "https://si.imgix.net/dfcd9658/uploads/origins/5b7d3f0e-8bfb-46af-b9f7-828ef67d3835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f4ad8e35dbe6592e4e40b0d594d5dc3, https://si.imgix.net/dfcd9658/uploads/origins/5b7d3f0e-8bfb-46af-b9f7-828ef67d3835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5812e638c53a0e69bc9b2eaea5cc688 2x, https://si.imgix.net/dfcd9658/uploads/origins/5b7d3f0e-8bfb-46af-b9f7-828ef67d3835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5579cb1ba9624607a1fe460667fde22 3x", "genre": "art", "nsfw": true, "body": "こんにちは！！\n\nこちらのイラスト（ https://twitter.com/okomegaokazu00/status/1404432994010501126?s=21 ）の仕上げをお願いします！\n好きなイラストなので着色されたものがぜひ見てみたいです！！\n\nトイレにもっと汚い感じがほしいので、壁の落書きを増やしていただいたり、木片やゴミ袋などを床にいくつか置いたりして汚して下さい！\nですが、うんちは苦手なのでそれ以外でお願いします\n\n余力があれば表情差分も1枚お願いしたいです！\n虚ろな瞳のまま、ワの形の笑顔の表情でお願いします！\nこちらも同様によだれを口から垂らして下さい\n\n以上です！\nよろしければぜひお願いいたします！！", "created_at": "", "completed_at": ""}, {"path": "/@okomegaokazu00/works/1", "thumbnail_src": "https://si.imgix.net/e8b9f800/requests/199865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ae0448aadeef4376e310754648bb1c", "thumbnail_srcset": "https://si.imgix.net/e8b9f800/requests/199865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ae0448aadeef4376e310754648bb1c, https://si.imgix.net/e8b9f800/requests/199865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=122ab22b8352e4b61fb8f8a5422b10a5 2x, https://si.imgix.net/e8b9f800/requests/199865_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e08931c10ff487e285