t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ef443258c04a224a0975ba9f0d72a89 3x", "genre": "art", "nsfw": false, "body": "以前描いて頂いたスイカモーニングスターの姫騎士オカシニアン美影ちゃんの詳しいディティールを知りたいので三面図をお願いします。「〇〇さんへ」の表記は右上に小さくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/59", "thumbnail_src": "https://si.imgix.net/2588f58c/uploads/origins/420b2d4e-335b-4eba-9cfb-fa6934b40d27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa3b7d20a7ec9cf8a83b245811f2da22", "thumbnail_srcset": "https://si.imgix.net/2588f58c/uploads/origins/420b2d4e-335b-4eba-9cfb-fa6934b40d27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa3b7d20a7ec9cf8a83b245811f2da22, https://si.imgix.net/2588f58c/uploads/origins/420b2d4e-335b-4eba-9cfb-fa6934b40d27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf76f3bf4a8b0e0decbef41fb521e206 2x, https://si.imgix.net/2588f58c/uploads/origins/420b2d4e-335b-4eba-9cfb-fa6934b40d27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ec852cffa529f61666e516301fcad20 3x", "genre": "art", "nsfw": false, "body": "パフェオカシニアンになった美影ちゃんをお願いします。\n\nhttps://www.pixiv.net/artworks/114183987", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/58", "thumbnail_src": "https://si.imgix.net/8b95b3c0/uploads/origins/b08fff72-202e-4a1b-a69d-886b6409f513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b262ad8a7bdc2612195fb48fefc70fe5", "thumbnail_srcset": "https://si.imgix.net/8b95b3c0/uploads/origins/b08fff72-202e-4a1b-a69d-886b6409f513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b262ad8a7bdc2612195fb48fefc70fe5, https://si.imgix.net/8b95b3c0/uploads/origins/b08fff72-202e-4a1b-a69d-886b6409f513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bdfd775bda8ce89b383ff9dd7ac8dc5 2x, https://si.imgix.net/8b95b3c0/uploads/origins/b08fff72-202e-4a1b-a69d-886b6409f513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7351edcb0af500c9d84936f423dad760 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n私のOC「レィルム」の饅頭バ怪人チャイナーン化イラストを依頼しております。\nチャイナーンに料理勝負を負けたレィルムが同じ饅頭バ怪人にされて、チャイナーンの妹っぽいなイメージになってます。\n髪型が三つ編みお団子ツインと化したレィルムはチャイナーンのついてに饅頭も持っていきます。\nレィルムの参考はこちら:https://www.pixiv.net/artworks/118889997\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/57", "thumbnail_src": "https://si.imgix.net/e3fa1e37/uploads/origins/5b47a34a-d7c9-46b9-8141-8d100cf314b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf64f2410451391ec4b63725099eb3e", "thumbnail_srcset": "https://si.imgix.net/e3fa1e37/uploads/origins/5b47a34a-d7c9-46b9-8141-8d100cf314b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf64f2410451391ec4b63725099eb3e, https://si.imgix.net/e3fa1e37/uploads/origins/5b47a34a-d7c9-46b9-8141-8d100cf314b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f7b8f81b41ecd4788a7f5786e97ae9e 2x, https://si.imgix.net/e3fa1e37/uploads/origins/5b47a34a-d7c9-46b9-8141-8d100cf314b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7867b655c0e22a90c72d1520ca1c035d 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております、たんがんです。\n今回はいつもと異なり、1からデザインを構築していただくのを依頼させていただきます。\n\n依頼させていただきたいのは、『これから舞踏会に出る熟女の貴婦人スカンク』です。\n\n基本は、黒と白の体毛のスカンクな熟女メスケモが、真紅のドレスを身にまとっているエレガントな姿を想像しております。\nスカンクさんの顔には紫色のアイシャドウとリップが塗られていて、大人の女性らしい優雅な表情を浮かべているイメージです。\n髪は銀色に近い白色で、緩くカールしているのを想定しております。\nまた、ドレスは赤を基調として黒を差し色にした形で、ドレス以外には赤い帽子と紫色のバラを頭に乗せており、肩には黒いファーのストールを乗せています。\nまた、首元には金色のチェーンで出来たネックレスを下げていて欲しいのですが、この時ネックレスの先端にはよくあるダイアモンドみたいな宝石ではなく宝石型の香水瓶をつけて欲しいです。\nそれに加えて彼女の片方の手には、長細いキセルを持たせて欲しいです。\n\n上記の内容の内、「ドレスの全体図」「帽子とストール」「紫色のアイシャドウとリップ」「髪型と髪色」「香水瓶」「煙管」に関しては、たんがんの脳内イメージを資料に載せてあります。しかしこれはあくまで素人であるたんがんのイメージに過ぎないので、『こうした方が良い』と彗嵐さんが感じられた時は是非ともそちらを優先していただければと思います。強いて言うなら「真紅のドレス」「紫色のアイシャドウにリップ」「熟女」の辺りは残してもらえると嬉しいです。\nまた、構図やポーズ、表情につきましては、今回の依頼では彗嵐さんにお任せしたいと思います。\n\n\n最後に、ここから先の内容は、これまでの要項と矛盾しかねないので、仮に依頼を受けるとしても無理に採用しなくて構わないのですが……熟女スカンクさんを、「ややぽっちゃり体型」にしていただけないでしょうか。完全にむっちりというわけではなくやや肉付きが良いぐらいの、『熟れた女』感を出して欲しいと言いますか……ハイ。「高貴」「エレガント」辺りと矛盾しかねないので、この辺は入ってなくても全然大丈夫ですm(_ _)m\n\n\n\n依頼の内容としては、以上になります。\nご依頼、ご検討いただけると嬉しいです。\n\nhttps://imgur.com/a/qwy3xqh", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/56", "thumbnail_src": "https://si.imgix.net/0acf347d/uploads/origins/d2494770-ceeb-4d2d-8a79-ddb39f8f000d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8682ae4eedbee35bcc756c469d7895ab", "thumbnail_srcset": "https://si.imgix.net/0acf347d/uploads/origins/d2494770-ceeb-4d2d-8a79-ddb39f8f000d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8682ae4eedbee35bcc756c469d7895ab, https://si.imgix.net/0acf347d/uploads/origins/d2494770-ceeb-4d2d-8a79-ddb39f8f000d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5496e1d57048ed1dfb3b533e7ec60b99 2x, https://si.imgix.net/0acf347d/uploads/origins/d2494770-ceeb-4d2d-8a79-ddb39f8f000d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d5e8dff17f97ea8f39d59980a081df4 3x", "genre": "art", "nsfw": true, "body": "前回はサイボーグメタルヒロインとなった沙雪さんをありがとうございました！\n今回も続けてサイボーグメタルヒロインとなった鈴華沙雪さんの依頼となります。\n\n今回は前回のエージェント姿の沙雪さんからメタルスーツに変身していくいわゆる変身バンクをお願いします。\nエージェントの状態から服が無くなって裸の様なボディ→素体姿→アーマー装着→ヘルメット装着までのイメージです！途中でカットシーンとかがあると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/55", "thumbnail_src": "https://si.imgix.net/f52e4d73/uploads/origins/e0778a95-036d-4a6b-9976-d86edf75687c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d16d70f01bedc399699213076ab871be", "thumbnail_srcset": "https://si.imgix.net/f52e4d73/uploads/origins/e0778a95-036d-4a6b-9976-d86edf75687c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d16d70f01bedc399699213076ab871be, https://si.imgix.net/f52e4d73/uploads/origins/e0778a95-036d-4a6b-9976-d86edf75687c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2effec4a218e09daf1b2f24e5dfd7530 2x, https://si.imgix.net/f52e4d73/uploads/origins/e0778a95-036d-4a6b-9976-d86edf75687c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a144fcaef403c6eace28183760246968 3x", "genre": "art", "nsfw": false, "body": "美影ちゃんがチョコのチェストアーマー（デカい肩アーマー付き）とフルーツケーキのドレスに身を包んだ姫騎士オカシニアンとなった姿をお願いします。後今は夏なのでスイカのモーニングスター（大玉スイカ丸ごとにシンプルなソーダアイスの棘が生えてる感じ）を持たせてください", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/54", "thumbnail_src": "https://si.imgix.net/11b308f6/uploads/origins/d89fd453-aa30-4bc6-8013-f9e4e69f10d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3bed6c32a7669414e536efdd52d21e1", "thumbnail_srcset": "https://si.imgix.net/11b308f6/uploads/origins/d89fd453-aa30-4bc6-8013-f9e4e69f10d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3bed6c32a7669414e536efdd52d21e1, https://si.imgix.net/11b308f6/uploads/origins/d89fd453-aa30-4bc6-8013-f9e4e69f10d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c73649c96edd7d40a1a5b11419b7bd86 2x, https://si.imgix.net/11b308f6/uploads/origins/d89fd453-aa30-4bc6-8013-f9e4e69f10d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7e1fbc1db69aff8db9242ac4fbd6a5d 3x", "genre": "art", "nsfw": true, "body": "サイボーグメタルヒロインとなった鈴華沙雪さんの全身立ち絵を描いてください。\n\n見た目のイメージはメタルヒーローのジバンを女体化した様な感じです。\n脳以外機械化しており関節部などはジョイント機構が見えておりよりロボットっぽい見た目です。また口元も含めて頭部を覆うフルヘルメットを装着しています。\n\n武器は拳銃とスタンバトン（警棒）でそれぞれ太ももに収納している設定です。\n可能でしたら頭部を覆っているヘルメットを取った姿と人間の容姿に偽装した姿もお願いします。\nメタルボディが本来の姿となっておりサイボーグ捜査官として活動しているイメージです。", "created_at": "", "completed_at": ""}, {"path": "/@Suiran19XX/works/53", "thumbnail_src": "https://si.imgix.net/56750025/uploads/origins/6c2936cf-0d26-428e-9083-2113c3de9640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c320a38f