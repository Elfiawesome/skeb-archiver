F&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dce37a709eac9a1eeb09b0d5275ebb1 2x, https://si.imgix.net/a0cbeab0/uploads/origins/82d9d573-917c-4c93-a0d6-78210b7ff669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46a4ce4c159010fe713d3f83d0b9c3d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@senri_tori/works/8", "thumbnail_src": "https://si.imgix.net/2f4ea4cd/uploads/origins/855071e3-7c41-4674-98a0-322ef2f9c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47584f5d55326bca4a514b09bd043709", "thumbnail_srcset": "https://si.imgix.net/2f4ea4cd/uploads/origins/855071e3-7c41-4674-98a0-322ef2f9c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47584f5d55326bca4a514b09bd043709, https://si.imgix.net/2f4ea4cd/uploads/origins/855071e3-7c41-4674-98a0-322ef2f9c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83e5340c15f6acb996906262af2bb7a0 2x, https://si.imgix.net/2f4ea4cd/uploads/origins/855071e3-7c41-4674-98a0-322ef2f9c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa0ec0d9adc6fa023a9b48a2f0ba7e25 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@senri_tori/works/7", "thumbnail_src": "https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2ce4a7e2d1437acdd51da5b49552ad", "thumbnail_srcset": "https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2ce4a7e2d1437acdd51da5b49552ad, https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=324fd510509a0383ef50b6735c58defa 2x, https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c97e780ff06fe7de24b9c446febb6c9d 3x", "genre": "art", "nsfw": false, "body": "せんり様こんにちは。\n自創作二人のイラストを描いて頂きたくリクエストを送らせていただきました。\n※BL要素があるため苦手な場合はこのまま読まずにキャンセルしてください。\n\n\n【二人の関係】\n魔法使いと魔族(魔王の子)。\n師匠と師弟で育ての親と子のような関係。\n\n【キャラクター】\n★魔法使い★\n◾︎名前:セリオ・ラディアス\n◾︎種族:人間\n◾︎性別:男\n◾︎年齢:120くらい(容姿は20代で止まっている)\n◾︎身長:178\n◾︎概要\n穏やかで大人びた雰囲気の不老不死の呪いをかけられた天才魔法使い。\n解呪方法を探しつつ森の奥深くの小屋でまったり暮らしている。\n長命ゆえに達観しており、飄々とした性格。\n基本的には気まぐれで自由奔放だが、魔王に対しては保護者のような姿勢を見せている。\n私生活は意外とだらしなく現在は世話を焼かれている側かもしれない…\nダルヴァンの気持ちに気づきつつも上手くかわしている。\n\n\n★魔王(魔王の子)★\n◾︎名前:ダルヴァン・ノクタリア\n◾︎種族:魔族\n◾︎性別:男\n◾︎年前:60くらい(長命種)\n◾︎身長:188\n◾︎概要\n魔族の生き残り(魔王の子)\n幼少期セリオに拾われ、魔力制御や魔法を教わりつつセリオのもとで暮らす。\n魔族の血を引いているため潜在的な力は非常に強い。成長とともに欲望や魔力の制御が難しくなっている。基本大人しめで聞き分けがいい。\nセリオに片想いしている。\n\n【その他】\n■どの姿でも大丈夫です。(時系列)\n■衣装デザインがまだ決まっていないため自由に描いていただけると嬉しいです。\n\n【使用用途】\n▪️個人鑑賞\n\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請をお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/169c_DP6rxl3ZRVEZ9h-qNxI3QFyFzKYQ", "created_at": "", "completed_at": ""}, {"path": "/@senri_tori/works/6", "thumbnail_src": "https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3669b122435e8f874bea9c48374b475f", "thumbnail_srcset": "https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3669b122435e8f874bea9c48374b475f, https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cf8e438c25bb1006b169c0b4d850c8b 2x, https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf057665c6cd64bcfeb304d9f9f137a8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きで、私のOCであるツクヨミの絵をお願いしたいです。\n\n彼女は背が高く、浅黒い肌をした戦士の女性で、長い黒髪とエルフのような耳を持ち、強くも静かな美貌の持ち主です。\n\n主な特徴：異色症（左目が青、右目が茶）、左目の傷、唇の下の小さなほくろ、金のフープイヤリング。どうか、これらのディテールを忘れないでください。\n\n普段は冷静で威厳があるが、戦いになると血の渇きと悲しみの恍惚状態に陥ることがある。彼女の強さと痛みの両方が重要なのです。彼女は悲劇的で、力強く、魅惑的です。\n\nあなたの解釈で自由に描いてください。\n彼女の鎧姿も見てみたいし、あなたの創作した衣装を入れるのも自由です。\n\nhttps://drive.google.com/drive/folders/1fCpLt0rW3YFUbHznk05333xJhGdlakB8?usp=sharing\n\n参考資料\n3D: https://drive.google.com/drive/folders/14S2MQrGYF4BLMorOL0su9lQovLcgw1Ac?usp=sharing\n\n2D: https://drive.google.com/drive/folders/1FxGcwUULjznekFj9ROHM8tzqU_pcAA9c?usp=sharing\n\nhttps://drive.google.com/drive/folders/14S2MQrGYF4BLMorOL0su9lQovLcgw1Ac?ths=true", "created_at": "", "completed_at": ""}, {"path": "/@senri_tori/works/5", "thumbnail_src": "https://si.imgix.net/799b7ea5/uploads/origins/67d7b572-aaad-4a9b-9e37-247e1c55356a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=750f69a803b72aa8c137206912905f4c", "thumbnail_srcset": "https://si.imgix.net/799b7ea5/uploads/origins/67d7b572-aaad-4a9b-9e37-247e1c55356a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=750f69a803b72aa8c137206912905f4c, https://si.imgix.net/799b7ea5/uploads/origins/67d7b572-aaad-4a9b-9e37-247e1c55356a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200