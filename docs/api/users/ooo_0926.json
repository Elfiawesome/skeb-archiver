orrection": {"min": 1000, "max": 1000}}, "links": [{"label": "Twitter", "url": "https://x.com/ooo_0926", "name": "ooo_0926"}, {"label": "Misskey_io", "url": "https://misskey.io/@memeoonon", "name": "memeoonon"}, {"label": "Website", "url": "https://wavebox.me/wave/4or39o4sb05vb1qu/", "name": ""}], "flags": {}, "works": [{"path": "/@ooo_0926/works/791", "thumbnail_src": "https://si.imgix.net/f056b61d/uploads/origins/f9d2bc14-d3b7-43db-b4c6-879eb17ac5bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f21fee1724a09cd70ac40f4f663d0cac", "thumbnail_srcset": "https://si.imgix.net/f056b61d/uploads/origins/f9d2bc14-d3b7-43db-b4c6-879eb17ac5bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f21fee1724a09cd70ac40f4f663d0cac, https://si.imgix.net/f056b61d/uploads/origins/f9d2bc14-d3b7-43db-b4c6-879eb17ac5bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feb30f8817e86bad744de37d8fbcb55b 2x, https://si.imgix.net/f056b61d/uploads/origins/f9d2bc14-d3b7-43db-b4c6-879eb17ac5bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2f2de7f4dae74f3cf93ae312a318cf8 3x", "genre": "art", "nsfw": false, "body": "Hi sensei!  \nI really like your illustrations and these are sooooooo cute!!! I really wanna to get an illustration of my character.  She's a puppy who came to Earth from an alien planet to do human research.  feel free to pick/design any clothing you like, and any gestrues and postures are good for me! \nhttps://drive.google.com/drive/folders/1PwQEup2sPcPEEQCdGNxoNOuh8cXqBa3w?q=parent:1PwQEup2sPcPEEQCdGNxoNOuh8cXqBa3w", "created_at": "", "completed_at": ""}, {"path": "/@ooo_0926/works/790", "thumbnail_src": "https://si.imgix.net/4ce5f1cd/uploads/origins/9b2592ca-bde7-4374-a377-1e9db2af6df9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e68f39d98011e92ecd83673c12aa2d0", "thumbnail_srcset": "https://si.imgix.net/4ce5f1cd/uploads/origins/9b2592ca-bde7-4374-a377-1e9db2af6df9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e68f39d98011e92ecd83673c12aa2d0, https://si.imgix.net/4ce5f1cd/uploads/origins/9b2592ca-bde7-4374-a377-1e9db2af6df9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bd74a5413cf2a7a7cb9e1a776cad2da 2x, https://si.imgix.net/4ce5f1cd/uploads/origins/9b2592ca-bde7-4374-a377-1e9db2af6df9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef794a6dd6faa42757cfce412a049414 3x", "genre": "art", "nsfw": false, "body": "はじめまして。先生のイラストの鮮やかな色使いと絵柄、躍動感のある構図がとても好きです！是非私のOCも描いていただきたく思い、リクエスト失礼いたします。\n\n【キャラクターについて】\nOCの男2人を描いていただきたいです。\n\n〇瀬尾新(白髪)\n寡黙で大人びている。なんでも完璧にこなせる優等生。実は殺し屋の仕事をしており、人を殺すことを躊躇わない非情な面がある。六花のことをとても大事に思っており、罪を犯してでも守りたいと感じている。甘いものと猫が好き。\n※目にハイライトを入れないようにしていただけると幸いです...！\n\n〇佐倉六花(ピンク髪)\n毒舌で強気な態度。ツンデレ気味。弱い自分を隠すために強気な言動をしている。しかし新に対しては別人のように甘く優しくなり、彼の前では純粋な笑顔を見せる。\n\n☆彼らは中学生のときに出会い、当時気が弱くていじめられていた六花を新が救ったことで、六花は新に特別な感情を抱くようになりました。新の方も、自分を必要としてくれている六花に、愛、そして独占欲に近い感情を抱くようになります。(共依存関係)2人は常に一緒に行動するカップルのような関係で、カフェに行ったりお互いの家に泊まりに行ったりします。\n\n↓資料です！\nhttps://drive.google.com/drive/folders/1-LSVp8S5iX-kwZ-hGrFYotW2DND43gMP\n\n【要望など】\n構図、シチュエーション、衣装など、全てお任せします。自由に解釈して描いていただけると嬉しいです。\n\n【使用用途】\n個人鑑賞用、SNSのアイコンヘッダーなどでの使用、Xの鍵垢での共有、個人利用の範囲でのグッズ制作 等\n\n金額や資料に不足などあればお手数ですが再送申請をお願いします。お忙しい中すみませんが、是非ともご検討よろしくお願い致します。体調に気を付けてお過ごしください！ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@ooo_0926/works/789", "thumbnail_src": "https://si.imgix.net/aa0f1623/uploads/origins/18ef0479-4f75-406e-ad7d-ea3984ffa5c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac571c0c61ed3db03be812b426060de", "thumbnail_srcset": "https://si.imgix.net/aa0f1623/uploads/origins/18ef0479-4f75-406e-ad7d-ea3984ffa5c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac571c0c61ed3db03be812b426060de, https://si.imgix.net/aa0f1623/uploads/origins/18ef0479-4f75-406e-ad7d-ea3984ffa5c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84f016f4d8dbe455486c667089b2d2b4 2x, https://si.imgix.net/aa0f1623/uploads/origins/18ef0479-4f75-406e-ad7d-ea3984ffa5c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c08840c36d1126b75877305b34cf4f9b 3x", "genre": "art", "nsfw": false, "body": "初めまして。いつも素敵なイラストを拝見しております。\nもしよければ、うちの子も描いて頂けないでしょうか？\n\n構図などはお任せします、猫耳つきフードを被って、可愛感じでお願いいたします！\n（足フェチですので、足の部分が含まれたら、裸足にしていただければ嬉しいです！）\n\nhttps://drive.google.com/drive/folders/1WMiXYzVixGeFfI53mI5jQgJL_r0qrLNj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ooo_0926/works/788", "thumbnail_src": "https://si.imgix.net/0faec62a/uploads/origins/846a1637-edd3-4a25-803a-bd101bfc4985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af3b00bf10d449d6cdc79dc7b3d45654", "thumbnail_srcset": "https://si.imgix.net/0faec62a/uploads/origins/846a1637-edd3-4a25-803a-bd101bfc4985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af3b00bf10d449d6cdc79dc7b3d45654, https://si.imgix.net/0faec62a/uploads/origins/846a1637-edd3-4a25-803a-bd101bfc4985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=660ef7d92745dbc9de837405ded3656f 2x, https://si.imgix.net/0faec62a/uploads/origins/846a1637-edd3-4a25-803a-bd101bfc4985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=813ad4d8ef5c76790768b7d01a3cf1e1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ooo_0926/works/787", "thumbnail_src": "https://si.imgix.net/ff5875d5/uploads/origin