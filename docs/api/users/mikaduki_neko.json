b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d9e3729671cf5a03cc70fc5db690b1f", "thumbnail_srcset": "https://si.imgix.net/b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d9e3729671cf5a03cc70fc5db690b1f, https://si.imgix.net/b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19eb9ffaf49555eb76cd4c2e1fd6a648 2x, https://si.imgix.net/b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e032d8ba293c7d1d2cc96468f6ab8819 3x", "genre": "art", "nsfw": false, "body": "はじめまして☺️ひらなつと申します。\nポケモンのイラストが素敵でぜひ私もお願いしたいです♡\n\n【描いてほしいキャラ】アニポケ\n⚪︎アメジオ(メガボルテージ版)\n⚪︎リコ　(可愛い雰囲気なら後はお任せします)\n\n2人が恋人設定でラブラブなイメージで描いてほしいです。(密着はok、センシティブなのはNG)\n\nポーズ、背景はお任せします🌟\n表情は目開けて笑顔でお願いします。\n余裕があれば差分があると嬉しいです。\n\nイラストはSNSアイコンかスマホ待ち受けに使用予定です。\n\n読んでいただきありがとうございました🥰\n\nhttps://drive.google.com/drive/folders/15vwGkRQvIBnfQifzDVchDUPz4p_4Oc0g", "created_at": "", "completed_at": ""}, {"path": "/@mikaduki_neko/works/284", "thumbnail_src": "https://si.imgix.net/4dcef3fc/uploads/origins/be512c3b-6a59-454f-ba6c-366973236498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5173f015570b3fe94c6772f179bfe06b", "thumbnail_srcset": "https://si.imgix.net/4dcef3fc/uploads/origins/be512c3b-6a59-454f-ba6c-366973236498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5173f015570b3fe94c6772f179bfe06b, https://si.imgix.net/4dcef3fc/uploads/origins/be512c3b-6a59-454f-ba6c-366973236498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&