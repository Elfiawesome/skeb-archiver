/origins/d9af2760-12f8-47e9-8028-b1a000a429b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=058bb6122be33bcb21322efe3307a175 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mikaduki_neko/works/288", "thumbnail_src": "https://si.imgix.net/44632734/uploads/origins/e05584fc-ad03-4c7d-b421-376ba3f0fd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f1125f64e700b1f31ef7bfc6afb4d14", "thumbnail_srcset": "https://si.imgix.net/44632734/uploads/origins/e05584fc-ad03-4c7d-b421-376ba3f0fd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f1125f64e700b1f31ef7bfc6afb4d14, https://si.imgix.net/44632734/uploads/origins/e05584fc-ad03-4c7d-b421-376ba3f0fd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b01b794d9d4a3380138201f80a0f388c 2x, https://si.imgix.net/44632734/uploads/origins/e05584fc-ad03-4c7d-b421-376ba3f0fd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e826256c13994b4df06f459ca66756f6 3x", "genre": "art", "nsfw": false, "body": "前回はありがとうございました　またリクエストをお願いします\n\n原神　蛍　パイモン\n\nクレしん　しんのすけとシロ\n\nしんのすけの服装はぶりぶりざえもんの冒険覚醒編の格好でお願いします\n\n原神のプロローグみたいに蛍としんのすけが一緒にパイモンを釣り上げているイラストをお願いします\nシロはしんのすけの服を引っ張る感じで\n\n場所は川で原作の釣り上げているところの砂浜でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@mikaduki_neko/works/287", "thumbnail_src": "https://si.imgix.net/b77a0525/uploads/origins/79dfed74-91a6-429b-8273-d1956e62cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c60fd71f15f1474a025310ba47991ca", "thumbnail_srcset": "https://si.imgix.net/b77a0525/uploads/origins/79dfed74-91a6-429b-8273-d1956e62cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c60fd71f15f1474a025310ba47991ca, https://si.imgix.net/b77a0525/uploads/origins/79dfed74-91a6-429b-