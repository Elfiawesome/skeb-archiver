んのすけの横でお座り\n\nしんのすけとシロを見た蛍はキョトンとしたような感じで\n場所は林で蛍は大きな木に身体を預けてた感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mikaduki_neko/works/286", "thumbnail_src": "https://si.imgix.net/c2a99256/uploads/origins/f1fcaf57-b880-4756-8ccb-8d2257fcdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d24f48bb41f8b04c113c13cc31ec711", "thumbnail_srcset": "https://si.imgix.net/c2a99256/uploads/origins/f1fcaf57-b880-4756-8ccb-8d2257fcdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d24f48bb41f8b04c113c13cc31ec711, https://si.imgix.net/c2a99256/uploads/origins/f1fcaf57-b880-4756-8ccb-8d2257fcdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4671e7ad6dbd431699ee9c575fd3cf09 2x, https://si.imgix.net/c2a99256/uploads/origins/f1fcaf57-b880-4756-8ccb-8d2257fcdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8472c3d496144eb26f8dac13141f2e6 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mikaduki_neko/works/285", "thumbnail_src": "https://si.imgix.net/b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d9e3729671cf5a03cc70fc5db690b1f", "thumbnail_srcset": "https://si.imgix.net/b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d9e3729671cf5a03cc70fc5db690b1f, https://si.imgix.net/b7ad0ca3/uploads/origins/5484c078-26f1-45d4-9e81-7840e3c2f44c?bg=%23fff&auto=format%2Ccompress&