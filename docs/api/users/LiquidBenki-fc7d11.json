rmat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0a96c876b61cf5c101581965754f6da 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/134", "thumbnail_src": "https://si.imgix.net/937a685f/uploads/origins/bde41500-8ce2-45df-bf02-3fa76e3aca7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815b1995ad562475f6c41c29a3f36f07", "thumbnail_srcset": "https://si.imgix.net/937a685f/uploads/origins/bde41500-8ce2-45df-bf02-3fa76e3aca7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815b1995ad562475f6c41c29a3f36f07, https://si.imgix.net/937a685f/uploads/origins/bde41500-8ce2-45df-bf02-3fa76e3aca7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6cddf1264b73420224d72188dc6114d 2x, https://si.imgix.net/937a685f/uploads/origins/bde41500-8ce2-45df-bf02-3fa76e3aca7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e8c4e09a5046a525c2144e962c4e636 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしい作品をありがとうございました。\n改めてリクエストさせて頂きたく思います。\n\n●キャラ\n「beatmaniaIIDX」の「シア」\n　・眉毛は太目で色は黒\n　・衣装は華錬学園中等科の制服\n　・パンツは子供っぽいポップな柄\n●シチュエーション\n「パンチラ姿を覗いているのに気が付いて見せてくれるシリーズ」が凄く好きなので是非私の推しキャラで描いて頂きたく思います。星奈ひかる版のようなだらしなく無防備な雰囲気で、これまでの流れに加えてパンツを片足首に残した状態で脱ぎ、興奮で濡れそぼる女性器を広げたうえに皮を剥いてクリを見せつけるという、更にもう一段興奮した段階を加えて頂きたいです。", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/133", "thumbnail_src": "https://si.imgix.net/3246c394/uploads/origins/10ec2a9f-4ce3-44ed-84fb-3202088b0185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2187c72a5c2fe37f462e8bbfaf720453", "thumbnail_srcset": "https://si.imgix.net/3246c394/uploads/origins/10ec2a9f-4ce3-44ed-84fb-3202088b0185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2187c72a5c2fe37f462e8bbfaf720453, https://si.imgix.net/3246c394/uploads/origins/10ec2a9f-4ce3-44ed-84fb-3202088b0185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fb6fc0c14d5188cde2de9c7a1d98573 2x, https://si.imgix.net/3246c394/uploads/origins/10ec2a9f-4ce3-44ed-84fb-3202088b0185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9cf7728efa86c21bea2028510494813 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/132", "thumbnail_src": "https://si.imgix.net/2c4c585a/uploads/origins/62d53ddf-5ef0-4535-a318-d576d118c2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e24ad1391d1f3e9e2224aef54d7dafc", "thumbnail_srcset": "https://si.imgix.net/2c4c585a/uploads/origins/62d53ddf-5ef0-4535-a318-d576d118c2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e24ad1391d1f3e9e2224aef54d7dafc, https://si.imgix.net/2c4c585a/uploads/origins/62d53ddf-5ef0-4535-a318-d576d118c2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58e28eb1bab466ffcaeee5ea73b2b71f 2x, https://si.imgix.net/2c4c585a/uploads/origins/62d53ddf-5ef0-4535-a318-d576d118c2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=913e75d13ed011f0d928be695fd4c437 3x", "genre": "art", "nsfw": true, "body": "前回ありがとうございました。再び、僕だけがいない街の雛月加代のリクエストをお願いしたいです。今回は前回の事前&事後のような内容、即堕ち二コマ的な感じで。\n1．赤いコートとランドセル姿の普段の加代\n2.中出し後の事後、全裸でぐったりとして横たわっている加代\n周りには衣服などが散らばっている\nという感じでお願いしたいです。\n台詞周りは1.声をかけてきたおじさんに「バカなの？」と一蹴する加代\n2.「ガキが出来てもお前は虐待するんじゃねえぞ」って感じに偉そうに説教するおじさん\n\n流体さんの描く可愛らしい女の子が好きで普段の姿とのギャップも見たいという欲が出たのでお願いしたいです。\n\nhttps://drive.google.com/drive/folders/1tcl0g5SQWy-VyMfnouJQPAjHkvYOjW5W", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/131", "thumbnail_src": "https://si.imgix.net/97138ef1/uploads/origins/fa5ca878-6b8f-4db0-ab2a-3d422568b3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9fc9920fb5aeb0659ebc7295723c88e", "thumbnail_srcset": "https://si.imgix.net/97138ef1/uploads/origins/fa5ca878-6b8f-4db0-ab2a-3d422568b3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9fc9920fb5aeb0659ebc7295723c88e, https://si.imgix.net/97138ef1/uploads/origins/fa5ca878-6b8f-4db0-ab2a-3d422568b3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96f2728b092011316dc4811d8dfc7a65 2x, https://si.imgix.net/97138ef1/uploads/origins/fa5ca878-6b8f-4db0-ab2a-3d422568b3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=048c994f2959adcba1bb1eb41301d242 3x", "genre": "art", "nsfw": true, "body": "拘束された不知火カヤ(ブルーアーカイブ)が苦悩の梨で拷問を受けているイラストをお願いします！\n\n分娩台で足を開脚した状態で拘束されている感じでお願いします！\n\nまだ比較的余裕のある糸目の表情と恐怖と苦痛で目を大きく見開いた表情をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/130", "thumbnail_src": "https://si.imgix.net/a84a1b75/uploads/origins/99ce209a-d4e5-47b7-89fa-721a6fb88b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65dd66c30078d71cf4acf2cddf129769", "thumbnail_srcset": "https://si.imgix.net/a84a1b75/uploads/origins/99ce209a-d4e5-47b7-89fa-721a6fb88b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65dd66c30078d71cf4acf2cddf129769, https://si.imgix.net/a84a1b75/uploads/origins/99ce209a-d4e5-47b7-89fa-721a6fb88b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95955572dc3b02d7d5f04c27ca17464d 2x, https://si.imgix.net/a84a1b75/uploads/origins/99ce209a-d4e5-47b7-89fa-721a6fb88b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ddb25b76e522e1fc358ef0d6e73fbb3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/129", "thumbnail_src": "https://si.imgix.net/71d42a72/uploads/origins/495d8c2b-8c20-445d-80d3-043b59621af8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9b7971690d61657cf4aa08c2906ba83", "thumbnail_srcset": "https://si.imgix.net/71d42a72/uploads/origins/495d8c2b-8c20-445d-80d3-043b59621af8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9b7971690d61657cf4aa08c2906ba83, https://si.imgix.net/71d42a72/uploads/origins/495d8c2b-8c20-445d-80d3-043b59621af8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e86b382942198bd9cc8b5883a7c15dcd 2x, https://si.imgix.net/71d42a72/uploads/origins/495d8c2b-8c20-445d-80d3-043b59621af8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=457b656fb21625bc5ffacab7d7b7b730 3x", "genre": "art", "nsfw": true, "body": "こちらの投稿（https://onl.sc/STib9wB）の一枚目が最高でしたので同じ構図でご依頼させて頂きたいです。\nキャラはポップンミュージック ラピストリアのミミ（https://onl.sc/JxU9wjn）で、椅子に腰かけ談笑→ボトムの隙間からショーツを見られていることに気付く→小さくピースサインを作りながらにたっと笑みを浮かべ、もう片方の手でボトムをずらしこちらに下着を見せつけてくる…という内容でお願いします。\nまた、可能であれば下着ごとずらし中身を見せてくれる差分をお願いします（陰毛濃いめ＆汗ばみ恥ずかしがりながらの笑顔だと大変捗ります）\nご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@LiquidBenki/works/128", "thumbnail_src": "https://si.imgix.net/ea169029/uploads/origins/2eeca7c7-ef41-4688-8a2d-f024906093f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txta