FF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acc34fdc8aff37a0f7f1c0dacd34c0ce", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/243", "thumbnail_src": "https://si.imgix.net/f0c5f90b/uploads/origins/4447c8e4-ae04-4604-a00e-616fdbd7fbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f610c9187b5f46371b0b38ce0c630663", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/242", "thumbnail_src": "https://si.imgix.net/db0e2fe6/uploads/origins/32975fe6-09e3-4f3e-b1cb-ade24451659b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d477d4597cd6ba98b9e7b096ce8b096c", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/241", "thumbnail_src": "https://si.imgix.net/f82b9b03/uploads/origins/53bd9d31-4c45-40f1-8086-a03fa0f97e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df11a93b16154288c6ba7e77119af7cd", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/240", "thumbnail_src": "https://si.imgix.net/589f0f58/uploads/origins/a0e42b35-8164-4069-ad68-6f05c9960c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71c8cdc6ffbfb0321b8b49635f4f2786", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/239", "thumbnail_src": "https://si.imgix.net/0cccf132/uploads/origins/f2cf0dea-621c-4f8c-a3e5-b509d7bfd131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=157065941b043a97d897b8375d1c1ef3", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nプリコネRからイノリの和式排泄をお願いします。\n\nhttps://img.gamewith.jp/img/b5b252abb5f9f63aaeeebfd087ef6366.jpg\n\n久々に催して限界状態で和式トイレに駆け込み\n立ったまま沢山限界排便するというものをお願いします。\n\nうんちをする前におならとうんちは排泄する度に太いものへと変わっていくようにして欲しいです\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/238", "thumbnail_src": "https://si.imgix.net/1132280a/uploads/origins/99693070-2c2d-4a9d-b5ad-523fe0ba9613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2441237f07f8097e9a8fc5f8adeff704", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "こんにちは。いつもお世話になっています。\n今年も是非ともICO先生にえっちイラストをお願いしたく、リクエストをお出しします。\n\nキャラクターはひめきしちゃんと、先生に創作って頂いたちびサキュバスのこひつじちゃんでお願いします。\n※ひめきしちゃん\nhttps://skeb.jp/@Honokitiliver/works/39\nhttps://skeb.jp/@Honokitiliver/works/47\n\n※こしつじちゃん\nhttps://skeb.jp/@GreenBullt7/works/205\n\nひめきしちゃんが、こしつじちゃんにポニーガール調教されて完オチしてしまうシーンをお願いします。\n\n設定・あらすじとしては――\nこしつじちゃんの親（父？）であるしつじちゃんが、ひめきしちゃんからのお使いで留守にしているある日のこと。\nパパ（しつじちゃん）がいなくて暇だとグズるこしつじちゃんを、ご主人様であるひめきしちゃんが自らあやしてあげとようと、『お馬さんごっこ』をしてあげるのですが、だんだん力関係が逆転して、いつの間にかこしつじちゃんに調教プレイを施され、完オチしてすっかり家畜になりきってしまう……\nというお話です。\n\n絵としては、ひめきしちゃんが四つんばいになって、背中にこひつじちゃんを跨らせて『お馬さんごっこ』であやしている場面をベースに、差分で服を剥かれたり、お尻をペチペチ叩かれたりしているうちに段々エスカレートして、家畜用の鞭で打たれたり、アナルに馬尻尾プラグを差し込まれたりして、最後はマゾ落ちしてしまう……という流れを差分で展開させて欲しいです。\n\n微笑ましく遊んでいたはずが、こしつじちゃんのサキュバスの血によって、ひめきしちゃんがBUZAMAに家畜化されてしまう様をICO先生の作風で描いて欲しいです。\n\n\n※セリフイメージ\n\nこしつじ「パパがいなくて退屈ー」\nひめ「あの子がいない間はわたくしが遊んであげますわ♡」\nひめ「ほうら、お馬さんですわよー」\n\nこしつじ「わー　お嬢様ありがとう！　さすが、パパの正妻！」\nひめ「特別ですわよ♡　わたくしの従者になるからには、馬の引き方もいずれ覚えて貰いますから」\n\nこしつじ「あ、知ってる。お馬さんはお尻を叩くと、走るんだよねー」\nひめ「あん♡　もう、わんぱくですわね。本物のお馬さんにはもっと優しく……」\n\nこしつじ「そうだ！お馬さんにはちゃんと鞭を使わなきゃ！ほら」\nひめ「ひぐっ！？ちょ、そんなものどこから！？あ、ぁあん♡」\n\nこしつじ「よぅし。このままお嬢様を馬らしく飾ってあそぼーと♡」\n\nこしつじ「ほらっ！ちゃんと走れ！」\nひめ「おほっぉ♡　ぶ、ブヒヒーーん！！」\nこしつじ「ははは！馬じゃなくて豚さんみたい」\n\nこしつじ「そうだ、パパが帰ってきたら、このお馬さんに乗ってお迎えしようっと♡　楽しみだね、駄姫号♡」\n\nひめ「ぶ、ぶひひぃん♡」", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/237", "thumbnail_src": "https://si.imgix.net/8f1b7101/uploads/origins/a565ee8d-f98e-48a8-9556-13c356ff4820?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f802a0628710ac3f45fffd04f424bf7", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "いつもお世話になっています！\n以前描いて貰いました、こちら原神のリネットhttps://skeb.jp/@GreenBullt7/works/232\nの衣装が脱ぎきれず、決壊してしまったverをお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/236", "thumbnail_src": "https://si.imgix.net/caafba2d/uploads/origins/a9097aa5-9b37-44ef-9fb0-3bf5c5202146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c45ba034fe414e64991fcf793ae85124", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/235", "thumbnail_src": "https://si.imgix.net/35b920c7/uploads/origins/d267323d-8874-4ace-8cc4-dae6cbaac932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad8c403a0fa7ec0016ac4dc4fa230372", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@GreenBullt7/works/234", "thumbnail_src": "https://si.imgix.net/0643ee5b/uploads/origins/3b0f06e5-8bd6-4331-9f89-b65ea3866f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d2363c6742c61d9ab51701730e6f862", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "お世話になっております\nこの度またイラストのリクエストをさせていただきたく...\n\n今回お願いさせていただきたいのはうちの子クレールのイラストとなります。\n\nシチュとしては捕虜となり牢獄のようなところでアナル肉便器にされちゃってるシチュをお願いしたいです\n既になんども使われた後のようにハード目な感じにしていただきたく\n服装は全裸で陰毛大目でお願いします\n\n以前お描きになられていたイラスト(https://www.pixiv.net/artworks/96124310)イメージで\n\nすでにアナルゼリーを入れられ、ディルドで栓をされている\n↓\n引き抜かれゼリー排泄\n↓\nぽっかりアナルをデカチンで激しく犯され、大量射精\n↓\nアナルから精液逆流と一緒におもらし\n↓\n最後はうんちまでもらしてしまう\n\n初めは必死に耐えるも、のちのちオホ声をあげてしまう...\n\nというシチュでお願いしたいです。\n\n\n\n大変細かいご依頼になり申し訳ありませんが\n\nご検討宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/86057203", "created_at": "", "completed_at": ""}]}