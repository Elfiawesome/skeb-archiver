t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0a19bca4505d73a54a64d615adfd985 2x, https://si.imgix.net/376e42a0/uploads/origins/851fd3e5-c9cb-459b-8a35-bf182838f9c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=644af5e17762da46d88249f6cb6fe650 3x", "genre": "art", "nsfw": false, "body": "爆速スライディング！魂麺！の竹割半蔵×風間遊切のカップリングイラストをお願いします。\nちょっとエッチな感じにしていただけますと嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@Zn51397825/works/17", "thumbnail_src": "https://si.imgix.net/f68a37b8/uploads/origins/ab29d8cf-af62-45a8-908f-13fc544026d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a89b4c19d16fc9c60cb96a498aa308", "thumbnail_srcset": "https://si.imgix.net/f68a37b8/uploads/origins/ab29d8cf-af62-45a8-908f-13fc544026d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a89b4c19d16fc9c60cb96a498aa308, https://si.imgix.net/f68a37b8/uploads/origins/ab29d8cf-af62-45a8-908f-13fc544026d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96dc33260dab91bb621c275309f00e78 2x, https://si.imgix.net/f68a37b8/uploads/origins/ab29d8cf-af62-45a8-908f-13fc544026d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd6148257eac3c2d946c882a9f249c70 3x", "genre": "art", "nsfw": false, "body": "初めての依頼失礼いたします。\n\n今回私の探索者と他プレイヤーの探索者のイラストを描いてほしくて依頼しました。\n\n・依頼内容\n二人の頭身の高いイラストと、ＳＤキャラのイラストと２種類見たいと思っています。\n\nどうか検討していただけると幸いです。\n\nhttps://drive.google.com/drive/folders/1pJvWZ7S-wI8-lhhSZ0TJrzXwvX3Ad_wz?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Zn51397825/works/16", "thumbnail_src": "https://si.imgix.net/9075a2b4/uploads/origins/7580ab9f-4245-43e2-a063-2d826e4bc37b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93de7f53a4d896c5c8467058ce3cfbcf", "thumbnail_srcset": "https://si.imgix.net/9075a2b4/uploads/origins/7580ab9f-4245-43e2-a063-2d826e4bc37b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93de7f53a4d896c5c8467058ce3cfbcf, https://si.imgix.net/9075a2b4/uploads/origins/7580ab9f-4245-43e2-a063-2d826e4bc37b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eccb5964d438983f9488193fb46b3b2 2x, https://si.imgix.net/9075a2b4/uploads/origins/7580ab9f-4245-43e2-a063-2d826e4bc37b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d3d9b7614cd710e08638b9d301b5a0c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵がとても好きなので、私のオリジナルキャラクター、ルゥとユライの絵をお願いしたいです。\n\nキャラクター情報\n\nルゥ：勇者の物語では悪役だった。世界を救うために主人公の友人を殺そうとした落ちこぼれの騎士。地獄への道は善意で舗装されている」という名言に由来する。主人公に敗れ牢獄に送られた後、ユライは彼の魂と代金を奪いに来るが、彼の魂を食べるのをやめ、代わりに彼を元の世界に連れ帰ることにした。その後、2人は一緒に暮らすことになる。\n\n服装：白の無地のシャツ、黒のパンツ（現代世界の服装でもOK ^^)\n\n外見茶色の髪、茶色の目。\n\n\nユライ：異次元から来た願いを叶える神。ほとんど無感情。善人でも悪人でもないので、たとえ世界を滅ぼすような願いでも、代償が正しければ叶えてくれる。  \n\n布：彼の布の詳細は正確である必要はない。\n\nhttps://drive.google.com/drive/folders/1M3BjM12g4mOoFUdPT7xgeZCMlfnXoj8C?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Zn51397825/works/15", "thumbnail_src": "https://si.imgix.net/8fee4574/uploads/origins/12b24bed-0c88-4602-b42f-7631c439cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a983e748ef5b86aab3360243193bb66e", "thumbnail_srcset": "https://si.imgix.net/8fee4574/uploads/origins/12b24bed-0c88-4602-b42f-7631c439cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a983e748ef5b86aab3360243193bb66e, https://si.imgix.net/8fee4574/uploads/origins/12b24bed-0c88-4602-b42f-7631c439cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abf12a58b898fb5dea4f071df5144cd2 2x, https://si.imgix.net/8fee4574/uploads/origins/12b24bed-0c88-4602-b42f-7631c439cd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b184c3ee005df72c9821fafdbb667783 3x", "genre": "art", "nsfw": false, "body": "空飛ぶレタス様。初めまして。初めてご依頼させていただきます。\n\nこの度は「爆速スライディング魂麺」に登場いたしますキャラクターの\nBLイラストをご依頼したくご連絡させていただきました。\n\n・依頼内容\n　\n　刑事（おさかず）×三國　愁（みくにしゅう）のカップリングイラスト\n　構図、内容等はお任せいたしますが、分かりやすくラブラブいちゃいちゃしていると大変助かります。\n\n・資料\n\n　こちらのリンクにてキャラのビジュアルを用意しております。\n　https://drive.google.com/drive/folders/1GFa5YwFM7mjSIfYs619TkhCTXGT3dRtV?usp=sharing\n　\nカラーかモノクロかも完全にお任せいたします。空飛ぶレタス様の描きやすいように描いていただけたらと思います。\nお忙しい事と存じますが、ご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Zn51397825/works/14", "thumbnail_src": "https://si.imgix.net/abeb5912/uploads/origins/f0e018ee-6338-441e-9032-0548e97e7bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=856a8db5c62a29af71ed66961c5fb94f", "thumbnail_srcset": "https://si.imgix.net/abeb5912/uploads/origins/f0e018ee-6338-441e-9032-0548e97e7bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=856a8db5c62a29af71ed66961c5fb94f, https://si.imgix.net/abeb5912/uploads/origins/f0e018ee-6338-441e-9032-0548e97e7bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44f0dcb714b2afb2ac810ad96c4f7212 2x, https://si.imgix.net/abeb5912/uploads/origins/f0e018ee-6338-441e-9032-0548e97e7bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91210d531dde68561716720e9aeb3f94 3x", "genre": "art", "nsfw": false, "body": "こんにちは。初めてご依頼させていただきます。\n\nこの度は「爆速スライディング魂麺」に登場するキャラクターの\nBLカップリングイラストをお願いしたくご連絡を差し上げました。\n\n・ご依頼内容\nアンドリュー×グンカンドリのイラスト\n構図等はお任せいたします。\n(服のカラーリングがわかると個人的に非常に助かります……)\n\n他のご依頼等もあると思いますし、私自身依頼も初めてで相場等もよくわからないため、\nダメであればお断りいただいて大丈夫です。\n何卒ご検討いただければ幸いです。\n\nhttps://speedysliding.wixsite.com/soul-men", "created_at": "", "completed_at": ""}, {"path": "/@Zn51397825/works/13", "thumbnail_src": "https://si.imgix.net/a33a1fc9/uploads/origins/915fb8ad-214e-4c89-8c20-2491bbc72bef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cddf1f5cce3c6a86b65b76156d9769a2", "thumbnail_srcset": "https://si.imgix.net/a33a1fc9/uploads/origins/915fb8ad-214e-4c89-8c