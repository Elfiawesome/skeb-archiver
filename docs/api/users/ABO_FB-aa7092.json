om/drive/folders/1lXL7NdpUm-p7dS4Fhyqp9v3d2XSt0qdh", "created_at": "", "completed_at": ""}, {"path": "/@ABO_FB/works/57", "thumbnail_src": "https://si.imgix.net/6bf683f8/uploads/origins/48a9dece-baab-4aa6-acdf-e21858608438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24b89ee6fd063519198affc8e10e2c52", "thumbnail_srcset": "https://si.imgix.net/6bf683f8/uploads/origins/48a9dece-baab-4aa6-acdf-e21858608438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24b89ee6fd063519198affc8e10e2c52, https://si.imgix.net/6bf683f8/uploads/origins/48a9dece-baab-4aa6-acdf-e21858608438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6398ce37acf3feb9b18566e0d5bb4b47 2x, https://si.imgix.net/6bf683f8/uploads/origins/48a9dece-baab-4aa6-acdf-e21858608438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51cf9a8e23399900e754a9a3e0fe3c58 3x", "genre": "art", "nsfw": false, "body": "はじめまして！私のFF14のキャラクターのイラストをお願いします！\n構図：\n・ポージングはお任せしますが、表情はドヤってる感じでお願いします\n・かけている眼鏡をスクエア型アンダーリムの眼鏡にしていただければ幸いです\n以上になります\n\nご検討の程よろしくお願いします\n\nキャラクター資料：\nhttps://i.gyazo.com/55015042ebbc5659a010918c4147ca67.jpg\nhttps://i.gyazo.com/211bf9e246d975092b9cebbccfa0af8b.jpg\nhttps://i.gyazo.com/3839c118cc64aab81b4aa1b001b24f70.jpg\nhttps://i.gyazo.com/0d30bda9705dfe91c823e632e9eeffd1.jpg\nhttps://i.gyazo.com/5ffa05c737afb15987f19a57fd6fc0c0.jpg", "created_at": "", "completed_at": ""}, {"path": "/@ABO_FB/works/56", "thumbnail_src": "https://si.imgix.net/9aa29b1e/uploads/origins/0a7a3abd-6646-411e-bfe1-8df1b98b9530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d07e563e134d340099740118cbf78696", "thumbnail_srcset": "https://si.imgix.net/9aa29b1e/uploads/origins/0a7a3abd-6646-411e-bfe1-8df1b98b9530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d07e563e134d340099740118cbf78696, https://si.imgix.net/9aa29b1e/uploads/origins/0a7a3abd-6646-411e-bfe1-8df1b98b9530?bg=